[2640.538196, "o", "\u001b[?2004h> "]
[2640.538531, "o", "        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r"]
[2640.538589, "o", "\u001b[?2004h> "]
[2640.538754, "o", "            int j = m->col_idx[idx];\r\n\u001b[?2004l\r"]
[2640.538819, "o", "\u001b[?2004h> "]
[2640.538943, "o", "            if (j >= i) {\r\n\u001b[?2004l\r"]
[2640.539002, "o", "\u001b[?2004h> "]
[2640.539254, "o", "                int pos = row_ptr[i] + next[i]++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.53931, "o", "> "]
[2640.539403, "o", "                col_idx[pos] = j;\r\n\u001b[?2004l\r"]
[2640.539458, "o", "\u001b[?2004h> "]
[2640.539583, "o", "                vals[pos] = m->vals[idx];\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.539648, "o", ">             }\r\n\u001b[?2004l\r"]
[2640.539703, "o", "\u001b[?2004h> "]
[2640.539761, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.539816, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.53987, "o", "    free(next);\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.539929, "o", "> \r\n\u001b[?2004l\r-\u001b[?2004h> "]
[2640.540085, "o", "    TriMatrix *t = xmalloc(sizeof(TriMatrix));\r\n\u001b[?2004l\r"]
[2640.540141, "o", "\u001b[?2004h> "]
[2640.540208, "o", "    t->n = n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.540277, "o", "    t->row_ptr = row_ptr;\r\n\u001b[?2004l\r"]
[2640.540332, "o", "\u001b[?2004h> "]
[2640.540394, "o", "    t->col_idx = col_idx;\r\n\u001b[?2004l\r"]
[2640.54045, "o", "\u001b[?2004h> "]
[2640.540504, "o", "    t->vals = vals;\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.54056, "o", "> "]
[2640.540614, "o", "    return t;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2640.540679, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.540838, "o", "static void free_tri_matrix(TriMatrix *t) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.540894, "o", "> "]
[2640.540953, "o", "    if (!t) return;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.541041, "o", "    free(t->row_ptr);\r\n\u001b[?2004l\r"]
[2640.541096, "o", "\u001b[?2004h> "]
[2640.541155, "o", "    free(t->col_idx);\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.541209, "o", "> "]
[2640.541272, "o", "    free(t->vals);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.541332, "o", "    free(t);\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.541386, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r "]
[2640.54144, "o", "\u001b[?2004h> "]
[2640.541595, "o", "static ICFactor *ic0_factorize(const CSRMatrix *m) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.541659, "o", "> "]
[2640.541719, "o", "    int n = m->n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.541914, "o", "    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n\u001b[?2004l\r"]
[2640.541969, "o", "\u001b[?2004h> "]
[2640.542067, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[2640.542123, "o", "\u001b[?2004h> "]
[2640.542345, "o", "        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r"]
[2640.542401, "o", "\u001b[?2004h> "]
[2640.54256, "o", "            if (m->col_idx[idx] < i) row_ptr[i + 1]++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.542616, "o", ">         }\r\n\u001b[?2004l\r"]
[2640.542684, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[2640.542739, "o", "\u001b[?2004h> "]
[2640.542931, "o", "    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.542987, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.543199, "o", "    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n\u001b[?2004l\r \u001b[?2004h"]
[2640.543255, "o", "> "]
[2640.543453, "o", "    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.543508, "o", "> "]
[2640.54365, "o", "    int *next = xcalloc((size_t)n, sizeof(int));\r\n\u001b[?2004l\r"]
[2640.543712, "o", "\u001b[?2004h> "]
[2640.543792, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[2640.543847, "o", "\u001b[?2004h> "]
[2640.544089, "o", "        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.544232, "o", "            int j = m->col_idx[idx];\r\n\u001b[?2004l\r)\u001b[?2004h"]
[2640.544288, "o", "> "]
[2640.544458, "o", "            if (j < i) col_idx[row_ptr[i] + next[i]++] = j;\r\n\u001b[?2004l\r"]
[2640.544518, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\rp"]
[2640.544574, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.544628, "o", "> "]
[2640.544705, "o", "    free(next);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r_\u001b[?2004h> "]
[2640.544908, "o", "    double *diag = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.544962, "o", "> "]
[2640.545054, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.545109, "o", "> "]
[2640.545177, "o", "        double aii = 0.0;\r\n\u001b[?2004l\r-\u001b[?2004h> "]
[2640.545449, "o", "        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.545671, "o", "            if (m->col_idx[idx] == i) aii += m->vals[idx];\r\n\u001b[?2004l\r(i\u001b[?2004h> "]
[2640.545731, "o", "        }\r\n\u001b[?2004l\r"]
[2640.545796, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[2640.54591, "o", "        double sum = aii;\r\n\u001b[?2004l\r"]
[2640.545979, "o", "\u001b[?2004h> "]
[2640.546152, "o", "        for (int k = row_ptr[i]; k < row_ptr[i + 1]; k++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.546296, "o", "            int j = col_idx[k];\r\n\u001b[?2004l\r"]
[2640.546364, "o", "\u001b[?2004h> "]
[2640.546425, "o", "            double aij = 0.0;\r\n\u001b[?2004l\r"]
[2640.546489, "o", "\u001b[?2004h> "]
[2640.546733, "o", "            for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.546922, "o", "                if (m->col_idx[idx] == j) {\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[2640.547091, "o", "                    aij += m->vals[idx];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.547213, "o", "                    break;\r\n\u001b[?2004l\r"]
[2640.547289, "o", "\u001b[?2004h> "]
[2640.547363, "o", "                }\r\n\u001b[?2004l\r>\u001b[?2004h> "]
[2640.54744, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.547548, "o", "            double s = aij;\r\n\u001b[?2004l\r"]
[2640.547603, "o", "\u001b[?2004h> "]
[2640.547699, "o", "            int pi = row_ptr[i];\r\n\u001b[?2004l\r"]
[2640.547756, "o", "\u001b[?2004h> "]
[2640.54785, "o", "            int pj = row_ptr[j];\r\n\u001b[?2004l\rr\u001b[?2004h"]
[2640.547905, "o", "> "]
[2640.548063, "o", "            while (pi < k && pj < row_ptr[j + 1]) {\r\n\u001b[?2004l\re\u001b[?2004h"]
[2640.548118, "o", "> "]
[2640.548324, "o", "                int ci = col_idx[pi];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.548441, "o", "                int cj = col_idx[pj];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.548531, "o", "                if (ci == cj) {\r\n\u001b[?2004l\r"]
[2640.548556, "o", "\u001b[?2004h> "]
[2640.548699, "o", "                    s -= vals[pi] * vals[pj];\r\n\u001b[?2004l\r"]
[2640.548798, "o", "\u001b[?2004h> "]
[2640.548888, "o", "                    pi++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.548976, "o", "                    pj++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.549094, "o", "                } else if (ci < cj) {\r\n\u001b[?2004l\r"]
[2640.549188, "o", "\u001b[?2004h> "]
[2640.549275, "o", "                    pi++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.549361, "o", "                } else {\r\n\u001b[?2004l\rl\u001b[?2004h> "]
[2640.549453, "o", "                    pj++;\r\n\u001b[?2004l\r"]
[2640.549543, "o", "\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n"]
[2640.549652, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2640.549743, "o", " \u001b[?2004h> "]
[2640.549851, "o", "            if (diag[j] == 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.549976, "o", "            double l = s / diag[j];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.550062, "o", "            vals[k] = l;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.550156, "o", "            sum -= l * l;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.550243, "o", "        }\r\n\u001b[?2004l\rn * \u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[2640.550455, "o", "        if (sum <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n\u001b[?2004l\r"]
[2640.550547, "o", "\u001b[?2004h> "]
[2640.550654, "o", "        diag[i] = sqrt(sum);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.550773, "o", "    ICFactor *ic = xmalloc(sizeof(ICFactor));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.550861, "o", "    ic->n = n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.550941, "o", "    ic->l_row_ptr = row_ptr;\r\n\u001b[?2004l\r   \u001b[?2004h> "]
[2640.551039, "o", "    ic->l_col_idx = col_idx;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.551121, "o", "    ic->l_vals = vals;\r\n\u001b[?2004l\r"]
[2640.551208, "o", "\u001b[?2004h> "]
[2640.551297, "o", "    ic->diag = diag;\r\n\u001b[?2004l\r\u001b[?2004h>     ic->u_row_ptr = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.551395, "o", "    ic->u_col_idx = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.551479, "o", "    ic->u_vals = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.551565, "o", "    return ic;\r\n\u001b[?2004l\rv\u001b[?2004h> }\r\n\u001b[?2004l\rec\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2640.551657, "o", "\u001b[?2004h> "]
[2640.551781, "o", "static Precond *precond_setup(CSRMatrix *m, int type, double omega) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.55191, "o", "    Precond *p = xmalloc(sizeof(Precond));\r\n\u001b[?2004l\r"]
[2640.552002, "o", "\u001b[?2004h>     p->type = type;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.552091, "o", "    p->A = m;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.55218, "o", "    p->diag = NULL;\r\n\u001b[?2004l\ri\u001b[?2004h> "]
[2640.552271, "o", "    p->lower = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.552361, "o", "    p->upper = NULL;\r\n\u001b[?2004l\r\u001b[?2004h>     p->omega = omega;\r\n\u001b[?2004l\r"]
[2640.552457, "o", "\u001b[?2004h> "]
[2640.552545, "o", "    p->ic = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.552652, "o", "    if (type == PRECOND_JACOBI) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.552744, "o", "        p->diag = compute_diag(m);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.552838, "o", "        for (int i = 0; i < m->n; i++) {\r\n\u001b[?2004l\rno\u001b[?2004h> "]
[2640.553031, "o", "            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n\u001b[?2004l\r"]
[2640.553119, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.553216, "o", "    } else if (type == PRECOND_SSOR) {\r\n\u001b[?2004l\r"]
[2640.553305, "o", "\u001b[?2004h> "]
[2640.55344, "o", "        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.553537, "o", "        p->diag = compute_diag(m);\r\n\u001b[?2004l\r"]
[2640.553625, "o", "\u001b[?2004h> "]
[2640.553732, "o", "        for (int i = 0; i < m->n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.553904, "o", "            if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.554011, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.554088, "o", "        p->lower = build_lower_triangular(m);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.554217, "o", "        p->upper = build_upper_triangular(m);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.554342, "o", "    } else if (type == PRECOND_IC0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.554532, "o", "        if (!m->symmetric) die(\"IC(0) requires symmetric matrix\");\r\n\u001b[?2004l\r"]
[2640.554621, "o", "\u001b[?2004h> "]
[2640.554717, "o", "        p->ic = ic0_factorize(m);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.554816, "o", "    return p;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.555004, "o", "static void precond_apply(Precond *p, const double *r, double *z) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.555077, "o", "    int n = p->A->n;\r\n\u001b[?2004l\r"]
[2640.55517, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.555234, "o", "    if (p->type == PRECOND_NONE) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.55532, "o", "        dcopy(n, r, z);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.555387, "o", "        return;\r\n\u001b[?2004l\r(\u001b[?2004h> "]
[2640.555472, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.555547, "o", "    if (p->type == PRECOND_JACOBI) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.555665, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.555895, "o", "            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.556013, "o", "            z[i] = r[i] / p->diag[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.5561, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.556133, "o", "        return;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.620845, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (p->type == PRECOND_SSOR) {\r\n\u001b[?2004l\r\u001b[?2004h>         dcopy(n, r, z);\r\n\u001b[?2004l\r\u001b[?2004h>         for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>             for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r\u001b[?2004h>                 int j = p->lower->col_idx[idx];\r\n\u001b[?2004l\r\u001b[?2004h>                 if (j < i) z[i] -= p->lower->vals[idx] * z[j];\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\r\n\u001b[?2004l\r\u001b[?2004h>             z[i] /= p->diag[i];\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         for (int i = n - 1; i >= 0; i--) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.621403, "o", "            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r"]
[2640.62153, "o", "\u001b[?2004h> "]
[2640.621874, "o", "                int j = p->upper->col_idx[idx];\r\n\u001b[?2004l\r"]
[2640.621965, "o", "\u001b[?2004h> "]
[2640.622363, "o", "                if (j > i) z[i] -= p->upper->vals[idx] * z[j];\r\n\u001b[?2004l\r"]
[2640.622456, "o", "\u001b[?2004h> "]
[2640.622545, "o", "            }\r\n\u001b[?2004l\r"]
[2640.622648, "o", "\u001b[?2004h> "]
[2640.623126, "o", "            if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\r\n\u001b[?2004l\r"]
[2640.62322, "o", "\u001b[?2004h"]
[2640.623309, "o", "> "]
[2640.62341, "o", "            z[i] /= p->diag[i];\r\n\u001b[?2004l\r"]
[2640.623498, "o", "\u001b[?2004h> "]
[2640.623586, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.623719, "o", ">         return;\r\n"]
[2640.623807, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[2640.623894, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2640.623983, "o", "\u001b[?2004h> "]
[2640.624213, "o", "    if (p->type == PRECOND_IC0) {\r\n\u001b[?2004l\r"]
[2640.624302, "o", "\u001b[?2004h> "]
[2640.624483, "o", "        ICFactor *ic = p->ic;\r\n\u001b[?2004l\r"]
[2640.624568, "o", "\u001b[?2004h> "]
[2640.624812, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[2640.6249, "o", "\u001b[?2004h> "]
[2640.625072, "o", "            double s = r[i];\r\n\u001b[?2004l\r"]
[2640.625162, "o", "\u001b[?2004h> "]
[2640.625693, "o", "            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r"]
[2640.625786, "o", "\u001b[?2004h> "]
[2640.626165, "o", "                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];\r\n\u001b[?2004l\r"]
[2640.626254, "o", "\u001b[?2004h> "]
[2640.626341, "o", "            }\r\n\u001b[?2004l\r"]
[2640.626434, "o", "\u001b[?2004h> "]
[2640.626991, "o", "            if (ic->diag[i] == 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n\u001b[?2004l\r"]
[2640.627081, "o", "\u001b[?2004h> "]
[2640.627294, "o", "            z[i] = s / ic->diag[i];\r\n\u001b[?2004l\r"]
[2640.627383, "o", "\u001b[?2004h> "]
[2640.627482, "o", "        }\r\n\u001b[?2004l\r"]
[2640.627574, "o", "\u001b[?2004h> "]
[2640.62779, "o", "        for (int i = n - 1; i >= 0; i--) {\r\n\u001b[?2004l\r"]
[2640.627882, "o", "\u001b[?2004h"]
[2640.62797, "o", "> "]
[2640.628073, "o", "            z[i] /= ic->diag[i];\r\n\u001b[?2004l\r"]
[2640.628159, "o", "\u001b[?2004h> "]
[2640.628692, "o", "            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r"]
[2640.628776, "o", "\u001b[?2004h> "]
[2640.629183, "o", "                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];\r\n\u001b[?2004l\r"]
[2640.629267, "o", "\u001b[?2004h> "]
[2640.629347, "o", "            }\r\n\u001b[?2004l\r"]
[2640.629437, "o", "\u001b[?2004h> "]
[2640.629524, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.62962, "o", "> "]
[2640.629735, "o", "        return;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.629822, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[2640.62991, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[2640.630142, "o", "    die(\"unknown preconditioner\");\r\n\u001b[?2004l\r"]
[2640.63023, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2640.630316, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.630411, "o", "> "]
[2640.630602, "o", "static void free_precond(Precond *p) {\r\n\u001b[?2004l\r"]
[2640.630704, "o", "\u001b[?2004h> "]
[2640.63081, "o", "    if (!p) return;\r\n\u001b[?2004l\r"]
[2640.630894, "o", "\u001b[?2004h> "]
[2640.630999, "o", "    free(p->diag);\r\n\u001b[?2004l\r"]
[2640.631086, "o", "\u001b[?2004h> "]
[2640.63128, "o", "    free_tri_matrix(p->lower);\r\n\u001b[?2004l\r"]
[2640.631363, "o", "\u001b[?2004h"]
[2640.631455, "o", "> "]
[2640.631565, "o", "    free_tri_matrix(p->upper);\r\n\u001b[?2004l\r"]
[2640.631667, "o", "\u001b[?2004h> "]
[2640.631759, "o", "    if (p->ic) {\r\n\u001b[?2004l\r"]
[2640.631842, "o", "\u001b[?2004h> "]
[2640.632043, "o", "        free(p->ic->l_row_ptr);\r\n\u001b[?2004l\r"]
[2640.632132, "o", "\u001b[?2004h> "]
[2640.632319, "o", "        free(p->ic->l_col_idx);\r\n\u001b[?2004l\r"]
[2640.632404, "o", "\u001b[?2004h> "]
[2640.632574, "o", "        free(p->ic->l_vals);\r\n\u001b[?2004l\r"]
[2640.632673, "o", "\u001b[?2004h> "]
[2640.632813, "o", "        free(p->ic->diag);\r\n\u001b[?2004l\r"]
[2640.632899, "o", "\u001b[?2004h> "]
[2640.633025, "o", "        free(p->ic->u_row_ptr);\r\n\u001b[?2004l\r"]
[2640.633112, "o", "\u001b[?2004h> "]
[2640.633239, "o", "        free(p->ic->u_col_idx);\r\n\u001b[?2004l\r"]
[2640.633326, "o", "\u001b[?2004h> "]
[2640.633451, "o", "        free(p->ic->u_vals);\r\n\u001b[?2004l\r"]
[2640.633538, "o", "\u001b[?2004h> "]
[2640.633622, "o", "        free(p->ic);\r\n\u001b[?2004l\r"]
[2640.633655, "o", "\u001b[?2004h> "]
[2640.633773, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.633862, "o", "    free(p);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2640.63395, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.634474, "o", "static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol) {\r\n\u001b[?2004l\r"]
[2640.634563, "o", "\u001b[?2004h> "]
[2640.634666, "o", "    int n = A->n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.634983, "o", "    double *x = xcalloc((size_t)n, sizeof(double));\r\n\u001b[?2004l\r"]
[2640.635071, "o", "\u001b[?2004h> "]
[2640.635366, "o", "    double *r = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[2640.635452, "o", "\u001b[?2004h> "]
[2640.635684, "o", "    double *z = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[2640.635776, "o", "\u001b[?2004h> "]
[2640.636036, "o", "    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[2640.636127, "o", "\u001b[?2004h> "]
[2640.636413, "o", "    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[2640.6365, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[2640.636602, "o", "    spmv(A, x, r);\r\n\u001b[?2004l\r"]
[2640.636706, "o", "\u001b[?2004h> "]
[2640.636922, "o", "    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n\u001b[?2004l\r"]
[2640.637009, "o", "\u001b[?2004h> "]
[2640.637198, "o", "    double bnorm = vec_norm2(n, b);\r\n\u001b[?2004l\r"]
[2640.637284, "o", "\u001b[?2004h> "]
[2640.637365, "o", "    if (bnorm == 0.0) {\r\n\u001b[?2004l\r"]
[2640.637451, "o", "\u001b[?2004h> "]
[2640.63768, "o", "        free(r); free(z); free(pvec); free(Ap);\r\n\u001b[?2004l\r"]
[2640.637774, "o", "\u001b[?2004h> "]
[2640.637871, "o", "        return x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.637966, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.63805, "o", "> "]
[2640.638144, "o", "    precond_apply(p, r, z);\r\n\u001b[?2004l\r"]
[2640.638228, "o", "\u001b[?2004h> "]
[2640.638306, "o", "    dcopy(n, z, pvec);\r\n\u001b[?2004l\r"]
[2640.638397, "o", "\u001b[?2004h> "]
[2640.638552, "o", "    double rz_old = dot(n, r, z);\r\n\u001b[?2004l\r"]
[2640.638644, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[2640.63887, "o", "    for (int it = 0; it < max_it; it++) {\r\n\u001b[?2004l\r"]
[2640.638958, "o", "\u001b[?2004h> "]
[2640.639054, "o", "        spmv(A, pvec, Ap);\r\n\u001b[?2004l\r"]
[2640.639142, "o", "\u001b[?2004h> "]
[2640.639315, "o", "        double pAp = dot(n, pvec, Ap);\r\n\u001b[?2004l\r"]
[2640.639407, "o", "\u001b[?2004h> "]
[2640.639512, "o", "        if (pAp <= 0.0) {\r\n\u001b[?2004l\r"]
[2640.639591, "o", "\u001b[?2004h> "]
[2640.639842, "o", "            free(r); free(z); free(pvec); free(Ap);\r\n\u001b[?2004l\r"]
[2640.639929, "o", "\u001b[?2004h> "]
[2640.640158, "o", "            die(\"matrix is not positive definite\");\r\n\u001b[?2004l\r"]
[2640.640246, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[2640.640337, "o", "\u001b[?2004h> "]
[2640.640509, "o", "        double alpha = rz_old / pAp;\r\n\u001b[?2004l\r"]
[2640.640596, "o", "\u001b[?2004h> "]
[2640.640784, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[2640.640876, "o", "\u001b[?2004h> "]
[2640.641018, "o", "            x[i] += alpha * pvec[i];\r\n\u001b[?2004l\r"]
[2640.641105, "o", "\u001b[?2004h> "]
[2640.641248, "o", "            r[i] -= alpha * Ap[i];\r\n\u001b[?2004l\r"]
[2640.641334, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[2640.641422, "o", "\u001b[?2004h> "]
[2640.641672, "o", "        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n\u001b[?2004l\r"]
[2640.641763, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[2640.641931, "o", "        precond_apply(p, r, z);\r\n\u001b[?2004l\r"]
[2640.642022, "o", "\u001b[?2004h> "]
[2640.642191, "o", "        double rz_new = dot(n, r, z);\r\n\u001b[?2004l\r"]
[2640.642285, "o", "\u001b[?2004h> "]
[2640.642406, "o", "        if (rz_old == 0.0) {\r\n\u001b[?2004l\r"]
[2640.642493, "o", "\u001b[?2004h> "]
[2640.642744, "o", "            free(r); free(z); free(pvec); free(Ap);\r\n\u001b[?2004l\r"]
[2640.642776, "o", "\u001b[?2004h> "]
[2640.642968, "o", "            die(\"CG numerical breakdown\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.643059, "o", "> "]
[2640.643149, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.643241, "o", "        double beta = rz_new / rz_old;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.643496, "o", "        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n\u001b[?2004l\r"]
[2640.643587, "o", "\u001b[?2004h> "]
[2640.643694, "o", "        rz_old = rz_new;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.643785, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.643918, "o", "    free(r); free(z); free(pvec); free(Ap);\r\n\u001b[?2004l\r"]
[2640.644017, "o", "\u001b[?2004h>     return x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.644108, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.644462, "o", "static double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol) {\r\n\u001b[?2004l\r"]
[2640.644552, "o", "\u001b[?2004h>     int n = A->n;\r\n\u001b[?2004l\r"]
[2640.64466, "o", "\u001b[?2004h> "]
[2640.644804, "o", "    double *x = xcalloc((size_t)n, sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.644893, "o", "> "]
[2640.645026, "o", "    double *r = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[2640.645056, "o", "\u001b[?2004h> "]
[2640.645288, "o", "    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[2640.645377, "o", "\u001b[?2004h> "]
[2640.645529, "o", "    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[2640.645617, "o", "\u001b[?2004h> "]
[2640.645769, "o", "    double *v = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[2640.645859, "o", "\u001b[?2004h> "]
[2640.646002, "o", "    double *s = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[2640.646094, "o", "\u001b[?2004h> "]
[2640.646221, "o", "    double *t = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[2640.646306, "o", "\u001b[?2004h> "]
[2640.646467, "o", "    double *z = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[2640.646558, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[2640.646584, "o", "    spmv(A, x, r);\r\n\u001b[?2004l\r"]
[2640.64672, "o", "\u001b[?2004h> "]
[2640.646842, "o", "    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.64693, "o", "> "]
[2640.647017, "o", "    double bnorm = vec_norm2(n, b);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.647131, "o", "    if (bnorm == 0.0) {\r\n\u001b[?2004l\r"]
[2640.647218, "o", "\u001b[?2004h> "]
[2640.647446, "o", "        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r"]
[2640.647534, "o", "\u001b[?2004h>         return x;\r\n\u001b[?2004l\ra"]
[2640.647622, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r]\u001b[?2004h> \r\n\u001b[?2004l\r;"]
[2640.647742, "o", "\u001b[?2004h>     dcopy(n, r, r0);\r\n\u001b[?2004l\rs"]
[2640.647769, "o", "\u001b[?2004h> "]
[2640.647928, "o", "    double rho_old = dot(n, r0, r);\r\n\u001b[?2004l\r"]
[2640.648017, "o", "\u001b[?2004h> "]
[2640.648103, "o", "    if (rho_old == 0.0) {\r\n\u001b[?2004l\rd\u001b[?2004h> "]
[2640.64838, "o", "        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r"]
[2640.648468, "o", "\u001b[?2004h> "]
[2640.648589, "o", "        die(\"BiCGSTAB numerical breakdown\");\r\n\u001b[?2004l\r"]
[2640.648696, "o", "\u001b[?2004h> "]
[2640.648785, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     dcopy(n, r, pvec);\r\n\u001b[?2004l\ri\u001b[?2004h"]
[2640.648872, "o", "> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[2640.649004, "o", "    for (int it = 0; it < max_it; it++) {\r\n\u001b[?2004l\r"]
[2640.649091, "o", "\u001b[?2004h> "]
[2640.649178, "o", "        precond_apply(p, pvec, z);\r\n\u001b[?2004l\r"]
[2640.649269, "o", "\u001b[?2004h> "]
[2640.649355, "o", "        spmv(A, z, v);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.649469, "o", "        double r0v = dot(n, r0, v);\r\n\u001b[?2004l\r"]
[2640.649559, "o", "\u001b[?2004h> "]
[2640.649677, "o", "        if (r0v == 0.0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.649949, "o", "            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r"]
[2640.650037, "o", "\u001b[?2004h> "]
[2640.650177, "o", "            die(\"BiCGSTAB numerical breakdown\");\r\n\u001b[?2004l\r"]
[2640.650265, "o", "\u001b[?2004h> "]
[2640.650352, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.650434, "o", "        double alpha = rho_old / r0v;\r\n\u001b[?2004l\r"]
[2640.65052, "o", "\u001b[?2004h> "]
[2640.650705, "o", "        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n\u001b[?2004l\r"]
[2640.6508, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2640.650889, "o", "\u001b[?2004h> "]
[2640.650977, "o", "        if (vec_norm2(n, s) <= tol * bnorm) {\r\n\u001b[?2004l\r"]
[2640.651006, "o", "\u001b[?2004h> "]
[2640.651222, "o", "            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n\u001b[?2004l\r"]
[2640.651311, "o", "\u001b[?2004h> "]
[2640.651399, "o", "            break;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r "]
[2640.651485, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.651598, "o", "        precond_apply(p, s, z);\r\n\u001b[?2004l\r"]
[2640.651698, "o", "\u001b[?2004h> "]
[2640.651792, "o", "        spmv(A, z, t);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.651902, "o", "        double ts = dot(n, t, s);\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.651989, "o", "> "]
[2640.652072, "o", "        double tt = dot(n, t, t);\r\n\u001b[?2004l\ri"]
[2640.652158, "o", "\u001b[?2004h>         if (tt == 0.0) {\r\n\u001b[?2004l\r"]
[2640.652246, "o", "\u001b[?2004h> "]
[2640.652511, "o", "            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r"]
[2640.6526, "o", "\u001b[?2004h> "]
[2640.652733, "o", "            die(\"BiCGSTAB numerical breakdown\");\r\n\u001b[?2004l\r"]
[2640.652821, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.652917, "o", "> "]
[2640.653005, "o", "        double omega = ts / tt;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.653195, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[2640.65328, "o", "\u001b[?2004h> "]
[2640.65342, "o", "            x[i] += alpha * z[i] + omega * s[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.653549, "o", "            r[i] = s[i] - omega * t[i];\r\n\u001b[?2004l\r"]
[2640.653644, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[2640.653809, "o", "        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.653899, "o", "\r\n\u001b[?2004l\re\u001b[?2004h> "]
[2640.653991, "o", "        double rho_new = dot(n, r0, r);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.654074, "o", "        if (rho_new == 0.0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.654291, "o", "            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r"]
[2640.654379, "o", "\u001b[?2004h> "]
[2640.654469, "o", "            die(\"BiCGSTAB numerical breakdown\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.654557, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.654718, "o", "        double beta = (rho_new / rho_old) * (alpha / omega);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.654927, "o", "        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.655025, "o", "        rho_old = rho_new;\r\n\u001b[?2004l\r"]
[2640.655115, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.655341, "o", "    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.655423, "o", "    return x;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2640.655518, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[2640.655674, "o", "static void write_vector(const char *filename, int n, const double *x) {\r\n\u001b[?2004l\r"]
[2640.655767, "o", "\u001b[?2004h>     FILE *f = stdout;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.655855, "o", "    if (filename) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.655953, "o", "        f = fopen(filename, \"w\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.656135, "o", "        if (!f) die(\"cannot open output vector file\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.656222, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rf\u001b[?2004h> "]
[2640.656322, "o", "    if (fprintf(f, \"%d\\\\n\", n) < 0) {\r\n\u001b[?2004l\r"]
[2640.656408, "o", "\u001b[?2004h> "]
[2640.656477, "o", "        if (filename) fclose(f);\r\n\u001b[?2004l\r"]
[2640.656545, "o", "\u001b[?2004h> "]
[2640.656598, "o", "        die(\"failed to write vector\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.656671, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.721058, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[2640.72125, "o", "\u001b[?2004h> "]
[2640.721456, "o", "        if (fprintf(f, \"%.15g\\\\n\", x[i]) < 0) {\r\n\u001b[?2004l\r"]
[2640.721546, "o", "\u001b[?2004h> "]
[2640.721809, "o", "            if (filename) fclose(f);\r\n\u001b[?2004l\r"]
[2640.7219, "o", "\u001b[?2004h> "]
[2640.722168, "o", "            die(\"failed to write vector\");\r\n\u001b[?2004l\r"]
[2640.722261, "o", "\u001b[?2004h> "]
[2640.722347, "o", "        }\r\n"]
[2640.722439, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[2640.722528, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.722739, "o", "    if (filename) fclose(f);\r\n\u001b[?2004l\r"]
[2640.722832, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2640.722925, "o", "\u001b[?2004h> "]
[2640.722951, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.723233, "o", "static int parse_int_arg(const char *s) {\r\n\u001b[?2004l\r"]
[2640.723316, "o", "\u001b[?2004h> "]
[2640.723595, "o", "    if (!s || !*s) die(\"missing argument\");\r\n\u001b[?2004l\r"]
[2640.723699, "o", "\u001b[?2004h> "]
[2640.723796, "o", "    errno = 0;\r\n\u001b[?2004l\r"]
[2640.723884, "o", "\u001b[?2004h> "]
[2640.723976, "o", "    char *end;\r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.724064, "o", "> "]
[2640.724242, "o", "    long val = strtol(s, &end, 10);\r\n\u001b[?2004l\r"]
[2640.724327, "o", "\u001b[?2004h> "]
[2640.724854, "o", "    if (errno != 0 || end == s || *end != '\\\\0') die(\"invalid integer argument\");\r\n\u001b[?2004l\r"]
[2640.724946, "o", "\u001b[?2004h> "]
[2640.725449, "o", "    if (val < INT_MIN || val > INT_MAX) die(\"integer argument out of range\");\r\n\u001b[?2004l\r"]
[2640.725536, "o", "\u001b[?2004h> "]
[2640.72566, "o", "    return (int)val;\r\n\u001b[?2004l\r"]
[2640.725748, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2640.725775, "o", "\u001b[?2004h"]
[2640.725902, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.726188, "o", "static double parse_double_arg(const char *s) {\r\n\u001b[?2004l\r"]
[2640.726274, "o", "\u001b[?2004h> "]
[2640.726546, "o", "    if (!s || !*s) die(\"missing argument\");\r\n\u001b[?2004l\r"]
[2640.726639, "o", "\u001b[?2004h> "]
[2640.72672, "o", "    errno = 0;\r\n\u001b[?2004l\r"]
[2640.726809, "o", "\u001b[?2004h> "]
[2640.726891, "o", "    char *end;\r\n\u001b[?2004l\r"]
[2640.726976, "o", "\u001b[?2004h> "]
[2640.727187, "o", "    double val = strtod(s, &end);\r\n\u001b[?2004l\r"]
[2640.727273, "o", "\u001b[?2004h> "]
[2640.727811, "o", "    if (errno != 0 || end == s || *end != '\\\\0') die(\"invalid numeric argument\");\r\n\u001b[?2004l\r"]
[2640.7279, "o", "\u001b[?2004h> "]
[2640.727987, "o", "    return val;\r\n\u001b[?2004l\r"]
[2640.728076, "o", "\u001b[?2004h"]
[2640.728163, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[2640.72825, "o", "> "]
[2640.728612, "o", "static void die_unknown(const char *kind, const char *value) {\r\n\u001b[?2004l\r"]
[2640.728712, "o", "\u001b[?2004h> "]
[2640.728817, "o", "    char msg[256];\r\n\u001b[?2004l\r"]
[2640.728901, "o", "\u001b[?2004h> "]
[2640.729304, "o", "    snprintf(msg, sizeof(msg), \"unknown %s: %s\", kind, value);\r\n\u001b[?2004l\r"]
[2640.729389, "o", "\u001b[?2004h> "]
[2640.729475, "o", "    die(msg);\r\n\u001b[?2004l\r"]
[2640.729565, "o", "\u001b[?2004h"]
[2640.729662, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.729907, "o", "int main(int argc, char **argv) {\r\n\u001b[?2004l\r"]
[2640.729995, "o", "\u001b[?2004h> "]
[2640.730182, "o", "    const char *input = NULL;\r\n\u001b[?2004l\r"]
[2640.730268, "o", "\u001b[?2004h> "]
[2640.730437, "o", "    const char *rhs = NULL;\r\n\u001b[?2004l\r"]
[2640.730522, "o", "\u001b[?2004h> "]
[2640.730761, "o", "    const char *solver_name = NULL;\r\n\u001b[?2004l\r"]
[2640.730852, "o", "\u001b[?2004h"]
[2640.730941, "o", "> "]
[2640.731076, "o", "    const char *precond_name = NULL;\r\n\u001b[?2004l\r"]
[2640.731163, "o", "\u001b[?2004h> "]
[2640.731392, "o", "    const char *reorder_name = NULL;\r\n\u001b[?2004l\r"]
[2640.731479, "o", "\u001b[?2004h> "]
[2640.731675, "o", "    const char *output = NULL;\r\n\u001b[?2004l\r"]
[2640.731766, "o", "\u001b[?2004h> "]
[2640.731937, "o", "    const char *gen2d = NULL;\r\n\u001b[?2004l\r"]
[2640.732022, "o", "\u001b[?2004h> "]
[2640.732202, "o", "    const char *gen3d = NULL;\r\n\u001b[?2004l\r"]
[2640.732291, "o", "\u001b[?2004h> "]
[2640.732477, "o", "    const char *genrhs = NULL;\r\n\u001b[?2004l\r"]
[2640.732567, "o", "\u001b[?2004h> "]
[2640.732703, "o", "    int analyze = 0;\r\n\u001b[?2004l\r"]
[2640.732792, "o", "\u001b[?2004h> "]
[2640.732919, "o", "    int max_it = 1000;\r\n\u001b[?2004l\r"]
[2640.733004, "o", "\u001b[?2004h> "]
[2640.733139, "o", "    double tol = 1e-8;\r\n\u001b[?2004l\r"]
[2640.733223, "o", "\u001b[?2004h> "]
[2640.733369, "o", "    double omega = 1.0;\r\n\u001b[?2004l\r"]
[2640.733455, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2640.733544, "o", "\u001b[?2004h> "]
[2640.733803, "o", "    for (int i = 1; i < argc; i++) {\r\n\u001b[?2004l\r"]
[2640.733896, "o", "\u001b[?2004h> "]
[2640.734125, "o", "        const char *arg = argv[i];\r\n\u001b[?2004l\r"]
[2640.734215, "o", "\u001b[?2004h> "]
[2640.734479, "o", "        if (strcmp(arg, \"--input\") == 0) {\r\n\u001b[?2004l\r"]
[2640.734568, "o", "\u001b[?2004h"]
[2640.734647, "o", "> "]
[2640.73502, "o", "            if (++i >= argc) die(\"missing argument for --input\");\r\n\u001b[?2004l\r"]
[2640.735109, "o", "\u001b[?2004h> "]
[2640.735281, "o", "            input = argv[i];\r\n\u001b[?2004l\r"]
[2640.735369, "o", "\u001b[?2004h> "]
[2640.735673, "o", "        } else if (strcmp(arg, \"--rhs\") == 0) {\r\n\u001b[?2004l\r"]
[2640.735763, "o", "\u001b[?2004h> "]
[2640.73616, "o", "            if (++i >= argc) die(\"missing argument for --rhs\");\r\n\u001b[?2004l\r"]
[2640.736247, "o", "\u001b[?2004h> "]
[2640.736407, "o", "            rhs = argv[i];\r\n\u001b[?2004l\r"]
[2640.73649, "o", "\u001b[?2004h> "]
[2640.736819, "o", "        } else if (strcmp(arg, \"--solver\") == 0) {\r\n\u001b[?2004l\r"]
[2640.736907, "o", "\u001b[?2004h> "]
[2640.73726, "o", "            if (++i >= argc) die(\"missing solver name\");\r\n\u001b[?2004l\r"]
[2640.737348, "o", "\u001b[?2004h> "]
[2640.737554, "o", "            solver_name = argv[i];\r\n\u001b[?2004l\r"]
[2640.737649, "o", "\u001b[?2004h> "]
[2640.737942, "o", "        } else if (strcmp(arg, \"--precond\") == 0) {\r\n\u001b[?2004l\r"]
[2640.738034, "o", "\u001b[?2004h> "]
[2640.738334, "o", "            if (++i >= argc) die(\"missing preconditioner name\");\r\n\u001b[?2004l\r"]
[2640.738366, "o", "\u001b[?2004h> "]
[2640.738561, "o", "            precond_name = argv[i];\r\n\u001b[?2004l\r"]
[2640.738656, "o", "\u001b[?2004h> "]
[2640.738896, "o", "        } else if (strcmp(arg, \"--reorder\") == 0) {\r\n\u001b[?2004l\r"]
[2640.738984, "o", "\u001b[?2004h> "]
[2640.739302, "o", "            if (++i >= argc) die(\"missing reordering name\");\r\n\u001b[?2004l\r"]
[2640.73939, "o", "\u001b[?2004h> "]
[2640.739528, "o", "            reorder_name = argv[i];\r\n\u001b[?2004l\r"]
[2640.739616, "o", "\u001b[?2004h> "]
[2640.73984, "o", "        } else if (strcmp(arg, \"--output\") == 0) {\r\n\u001b[?2004l\r"]
[2640.739926, "o", "\u001b[?2004h> "]
[2640.740282, "o", "            if (++i >= argc) die(\"missing argument for --output\");\r\n\u001b[?2004l\r"]
[2640.740367, "o", "\u001b[?2004h> "]
[2640.740478, "o", "            output = argv[i];\r\n\u001b[?2004l\r"]
[2640.740565, "o", "\u001b[?2004h> "]
[2640.740818, "o", "        } else if (strcmp(arg, \"--analyze\") == 0) {\r\n\u001b[?2004l\r"]
[2640.740907, "o", "\u001b[?2004h"]
[2640.741002, "o", "> "]
[2640.741088, "o", "            analyze = 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.741395, "o", "        } else if (strcmp(arg, \"--generate-laplacian\") == 0) {\r\n\u001b[?2004l\r"]
[2640.741482, "o", "\u001b[?2004h> "]
[2640.741849, "o", "            if (++i >= argc) die(\"missing argument for --generate-laplacian\");\r\n\u001b[?2004l\r"]
[2640.74194, "o", "\u001b[?2004h> "]
[2640.742055, "o", "            gen2d = argv[i];\r\n\u001b[?2004l\r"]
[2640.742147, "o", "\u001b[?2004h> "]
[2640.742451, "o", "        } else if (strcmp(arg, \"--generate-laplacian3d\") == 0) {\r\n\u001b[?2004l\r"]
[2640.742539, "o", "\u001b[?2004h> "]
[2640.742949, "o", "            if (++i >= argc) die(\"missing argument for --generate-laplacian3d\");\r\n\u001b[?2004l\r"]
[2640.742983, "o", "\u001b[?2004h> "]
[2640.743137, "o", "            gen3d = argv[i];\r\n\u001b[?2004l\r"]
[2640.743226, "o", "\u001b[?2004h> "]
[2640.74352, "o", "        } else if (strcmp(arg, \"--generate-rhs\") == 0) {\r\n\u001b[?2004l\r"]
[2640.743607, "o", "\u001b[?2004h> "]
[2640.74394, "o", "            if (++i >= argc) die(\"missing argument for --generate-rhs\");\r\n\u001b[?2004l\r"]
[2640.744027, "o", "\u001b[?2004h> "]
[2640.744151, "o", "            genrhs = argv[i];\r\n\u001b[?2004l\r"]
[2640.744238, "o", "\u001b[?2004h> "]
[2640.744657, "o", "        } else if (strcmp(arg, \"--max-it\") == 0 || strcmp(arg, \"--max-iter\") == 0) {\r\n\u001b[?2004l\r"]
[2640.744752, "o", "\u001b[?2004h> "]
[2640.745073, "o", "            if (++i >= argc) die(\"missing argument for max iterations\");\r\n\u001b[?2004l\r"]
[2640.745158, "o", "\u001b[?2004h> "]
[2640.745365, "o", "            max_it = parse_int_arg(argv[i]);\r\n\u001b[?2004l\r"]
[2640.745453, "o", "\u001b[?2004h> "]
[2640.745682, "o", "        } else if (strcmp(arg, \"--tol\") == 0) {\r\n\u001b[?2004l\r"]
[2640.745715, "o", "\u001b[?2004h> "]
[2640.746075, "o", "            if (++i >= argc) die(\"missing argument for tolerance\");\r\n\u001b[?2004l\r"]
[2640.746164, "o", "\u001b[?2004h> "]
[2640.746364, "o", "            tol = parse_double_arg(argv[i]);\r\n\u001b[?2004l\r"]
[2640.746456, "o", "\u001b[?2004h> "]
[2640.74668, "o", "        } else if (strcmp(arg, \"--omega\") == 0) {\r\n\u001b[?2004l\r"]
[2640.74677, "o", "\u001b[?2004h> "]
[2640.74709, "o", "            if (++i >= argc) die(\"missing argument for omega\");\r\n\u001b[?2004l\r"]
[2640.747178, "o", "\u001b[?2004h> "]
[2640.747339, "o", "            omega = parse_double_arg(argv[i]);\r\n\u001b[?2004l\r"]
[2640.747426, "o", "\u001b[?2004h> "]
[2640.747514, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.74763, "o", "            char msg[256];\r\n\u001b[?2004l\r"]
[2640.747726, "o", "\u001b[?2004h> "]
[2640.74784, "o", "            snprintf(msg, sizeof(msg), \"unknown option: %s\", arg);\r\n\u001b[?2004l\r"]
[2640.747928, "o", "\u001b[?2004h>             die(msg);\r\n\u001b[?2004l\r"]
[2640.748015, "o", "\u001b[?2004h> "]
[2640.748049, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2640.748172, "o", "\u001b[?2004h>     int modes = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.748241, "o", "    if (analyze) modes++;\r\n\u001b[?2004l\r"]
[2640.748332, "o", "\u001b[?2004h> "]
[2640.748416, "o", "    if (solver_name) modes++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
