[6442.100657, "o", "   755\t    free(t->row_ptr);\r\n   756\t    free(t->col_idx);\r\n   757\t    free(t->vals);\r\n   758"]
[6442.100756, "o", "\t    free(t);\r\n   759\t}\r\n   760\t\r\n   761\tstatic ICFactor *ic0_factorize(const CSRMatrix *m) {\r\n   762\t    int n = m->n;\r\n   763\t    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n   764\t    for (int i = 0; i < n; i++) {\r\n   765\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   766\t            if (m->col_idx[idx] < i) row_ptr[i + 1]++;\r\n   767\t        }\r\n   768\t    }\r\n   769\t    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];\r\n   770\t\r\n   771\t    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n   772\t    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));\r\n   773"]
[6442.100844, "o", "\t    int *next = xcalloc((size_t)n, sizeof(int));\r\n   774\t    for (int i = 0; i < n; i++) {\r\n   775\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   776\t            int j = m->col_idx[idx];\r\n   777\t            if (j < i) col_idx[row_ptr[i] + next[i]++] = j;\r\n   778\t        }\r\n   779\t    }\r\n   780\t    free(next);\r\n   781\t\r\n   782\t    double *diag = xmalloc((size_t)n * sizeof(double));\r\n   783\t    for (int i = 0; i < n; i++) {\r\n   784\t        double aii = 0.0;\r\n   785\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   786\t"]
[6442.100916, "o", "            if (m->col_idx[idx] == i) aii += m->vals[idx];\r\n   787\t        }\r\n   788\t\r\n   789\t        double sum = aii;\r\n   790\t        for (int k = row_ptr[i]; k < row_ptr[i + 1]; k++) {\r\n   791\t            int j = col_idx[k];\r\n   792\t            double aij = 0.0;\r\n   793\t            for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   794\t                if (m->col_idx[idx] == j) {\r\n   795\t                    aij += m->vals[idx];\r\n   796\t                    break;\r\n"]
[6442.100996, "o", "   797\t                }\r\n   798\t            }\r\n   799\t\r\n   800\t            double s = aij;\r\n   801\t            int pi = row_ptr[i];\r\n   802\t            int pj = row_ptr[j];\r\n   803\t            while (pi < k && pj < row_ptr[j + 1]) {\r\n   804\t                int ci = col_idx[pi];\r\n   805\t                int cj = col_idx[pj];\r\n   806\t                if (ci == cj) {\r\n   807\t                    s -= vals[pi] * vals[pj];\r\n   808\t                    pi++;\r\n"]
[6442.101065, "o", "   809\t                    pj++;\r\n   810\t                } else if (ci < cj) {\r\n   811\t                    pi++;\r\n   812\t                } else {\r\n   813\t                    pj++;\r\n   814\t                }\r\n   815\t            }\r\n   816\t\r\n   817\t            if (diag[j] <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   818\t            double l = s / diag[j];\r\n"]
[6442.101142, "o", "   819\t            vals[k] = l;\r\n   820\t            sum -= l * l;\r\n   821\t        }\r\n   822\t\r\n   823\t        if (sum <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   824\t        diag[i] = sqrt(sum);\r\n"]
[6442.101217, "o", "   825\t    }\r\n   826\t\r\n   827\t    ICFactor *ic = xmalloc(sizeof(ICFactor));\r\n   828\t    ic->n = n;\r\n   829\t    ic->l_row_ptr = row_ptr;\r\n   830\t    ic->l_col_idx = col_idx;\r\n   831\t    ic->l_vals = vals;\r\n   832\t    ic->diag = diag;\r\n   833\t    ic->u_row_ptr = NULL;\r\n   834\t    ic->u_col_idx = NULL;\r\n   835\t    ic->u_vals = NULL;\r\n   836\t    return ic;\r\n   837\t}\r\n   838\t\r\n   839\tstatic Precond *precond_setup(CSRMatrix *m, int type, double omega) {\r\n   840\t    Precond *p = xmalloc(sizeof(Precond));\r\n   841\t    p->type = type;\r\n   842"]
[6442.101286, "o", "\t    p->A = m;\r\n   843\t    p->diag = NULL;\r\n   844\t    p->lower = NULL;\r\n   845\t    p->upper = NULL;\r\n"]
[6442.101944, "o", "\u001b[?2004h"]
[6442.102013, "o", "root@n30009:/app# "]
[6442.364917, "i", "nl -ba nlsolve.c | sed -n '845,945p'\n"]
[6442.365225, "o", "nl -ba nlsolve.c | sed -n '845,945p'\r\n\u001b[?2004l\r"]
[6442.369175, "o", "   845\t    p->upper = NULL;\r\n   846\t    p->omega = omega;\r\n   847\t    p->ic = NULL;\r\n   848\t\r\n   849\t    if (type == PRECOND_JACOBI) {\r\n   850\t        p->diag = compute_diag(m);\r\n"]
[6442.369281, "o", "   851\t        for (int i = 0; i < m->n; i++) {\r\n   852\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   853\t        }\r\n   854\t    } else if (type == PRECOND_SSOR) {\r\n   855\t        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n   856\t        p->diag = compute_diag(m);\r\n   857\t        p->lower = build_lower_triangular(m);\r\n   858\t        p->upper = build_upper_triangular(m);\r\n   859\t    } else if (type == PRECOND_IC0) {\r\n   860\t        if (!m->symmetric) die(\"IC(0) requires symmetric matrix\");\r\n   861\t        p->ic = ic0_factorize(m);\r\n   862\t    }\r\n   863\t\r\n   864\t    return p;\r\n   865\t}\r\n   866\t\r\n"]
[6442.369371, "o", "   867\tstatic void precond_apply(Precond *p, const double *r, double *z) {\r\n   868\t    int n = p->A->n;\r\n   869\t\r\n   870\t    if (p->type == PRECOND_NONE) {\r\n   871\t        dcopy(n, r, z);\r\n   872\t        return;\r\n   873\t    }\r\n   874\t\r\n   875\t    if (p->type == PRECOND_JACOBI) {\r\n   876\t        for (int i = 0; i < n; i++) {\r\n   877\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   878\t            z[i] = r[i] / p->diag[i];\r\n   879\t        }\r\n   880\t"]
[6442.369446, "o", "        return;\r\n   881\t    }\r\n   882\t\r\n   883\t    if (p->type == PRECOND_SSOR) {\r\n   884\t        dcopy(n, r, z);\r\n   885\t        for (int i = 0; i < n; i++) {\r\n   886\t            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\r\n   887\t                int j = p->lower->col_idx[idx];\r\n   888\t                if (j < i) z[i] -= p->lower->vals[idx] * z[j];\r\n   889\t            }\r\n   890\t"]
[6442.369578, "o", "            if (p->diag[i] == 0.0) {\r\n   891\t                z[i] = 0.0;\r\n   892\t                continue;\r\n   893\t            }\r\n   894\t            z[i] /= p->diag[i];\r\n   895\t        }\r\n   896\t        for (int i = n - 1; i >= 0; i--) {\r\n   897\t            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\r\n   898\t                int j = p->upper->col_idx[idx];\r\n   899\t                if (j > i) z[i] -= p->upper->vals[idx] * z[j];\r\n   900\t            }\r\n   901\t            if (p->diag[i] == 0.0) {\r\n   902\t                z[i] = 0.0;\r\n   903\t                continue;\r\n   904\t            }\r\n   905\t            z[i] /= p->diag[i];\r\n   906\t        }\r\n   907\t        return;\r\n   908\t    }\r\n   909\t\r\n"]
[6442.369686, "o", "   910\t    if (p->type == PRECOND_IC0) {\r\n   911\t        ICFactor *ic = p->ic;\r\n   912\t        for (int i = 0; i < n; i++) {\r\n   913\t            double s = r[i];\r\n   914\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   915\t                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];\r\n   916\t            }\r\n   917\t            if (ic->diag[i] == 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   918\t            z[i] = s / ic->diag[i];\r\n   919\t        }\r\n   920\t        for (int i = n - 1; i >= 0; i--) {\r\n"]
[6442.369759, "o", "   921\t            z[i] /= ic->diag[i];\r\n   922\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   923\t                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];\r\n   924\t            }\r\n   925\t        }\r\n   926\t        return;\r\n   927\t    }\r\n   928\t\r\n   929\t    die(\"unknown preconditioner\");\r\n   930\t}\r\n   931\t\r\n   932\tstatic void free_precond(Precond *p) {\r\n"]
[6442.369828, "o", "   933\t    if (!p) return;\r\n   934\t    free(p->diag);\r\n   935\t    free_tri_matrix(p->lower);\r\n   936\t    free_tri_matrix(p->upper);\r\n   937\t    if (p->ic) {\r\n   938\t        free(p->ic->l_row_ptr);\r\n   939\t        free(p->ic->l_col_idx);\r\n   940\t        free(p->ic->l_vals);\r\n   941\t        free(p->ic->diag);\r\n   942\t        free(p->ic->u_row_ptr);\r\n   943\t        free(p->ic->u_col_idx);\r\n   944"]
[6442.369892, "o", "\t        free(p->ic->u_vals);\r\n   945\t        free(p->ic);\r\n"]
