[3504.294815, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('nlsolve.c')\nlines = p.read_text().split('\\n')\nout = []\nskip = False\nfor i, line in enumerate(lines):\n    if skip:\n        skip = False\n        continue\n    if line == '    if (fprintf(f, \"%d':\n        out.append('    if (fprintf(f, \"%d\\\\n\", n) < 0) {')\n        skip = True\n        continue\n    if line == '        if (fprintf(f, \"%.15g':\n        out.append('        if (fprintf(f, \"%.15g\\\\n\", x[i]) < 0) {')\n        skip = True\n        continue\n    out.append(line)\np.write_text('\\n'.join(out))\nPY\n"]
