[4446.270158, "o", "\u001b[32m\u001b[K435\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic double \u001b[01;31m\u001b[Kcompute_true_residual\u001b[m\u001b[K(CSRMatrix *A, const double *b, const double *x) {\r\n"]
[4446.270317, "o", "\u001b[32m\u001b[K807\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else if (type == PRECOND_\u001b[01;31m\u001b[KSSOR\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K808\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (omega <= 0.0 || omega >= 2.0) die(\"invalid \u001b[01;31m\u001b[KSSOR\u001b[m\u001b[K parameter\");\r\n"]
[4446.270378, "o", "\u001b[32m\u001b[K836\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (p->type == PRECOND_\u001b[01;31m\u001b[KSSOR\u001b[m\u001b[K) {\r\n"]
[4446.270473, "o", "\u001b[32m\u001b[K903\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic double *\u001b[01;31m\u001b[Ksolve_cg\u001b[m\u001b[K(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n"]
[4446.270659, "o", "\u001b[32m\u001b[K954\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic double *\u001b[01;31m\u001b[Ksolve_bicgstab\u001b[m\u001b[K(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n"]
[4446.27079, "o", "\u001b[32m\u001b[K1202\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        else if (strcmp(precond_name, \"ssor\") == 0) precond = PRECOND_\u001b[01;31m\u001b[KSSOR\u001b[m\u001b[K;\r\n"]
[4446.270834, "o", "\u001b[32m\u001b[K1231\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        printf(\"\u001b[01;31m\u001b[Kiterations:\u001b[m\u001b[K 0\\n\");\r\n"]
[4446.270962, "o", "\u001b[32m\u001b[K1232\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        printf(\"\u001b[01;31m\u001b[Kresidual_norm:\u001b[m\u001b[K 0.000000e+00\\n\");\r\n"]
[4446.271024, "o", "\u001b[32m\u001b[K1233\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        printf(\"\u001b[01;31m\u001b[Kconverged:\u001b[m\u001b[K yes\\n\");\r\n\u001b[32m\u001b[K1257\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (solver == SOLVER_CG) x2 = \u001b[01;31m\u001b[Ksolve_cg\u001b[m\u001b[K(A, bwork, p, max_it, tol, history, &iterations);\r\n\u001b[32m\u001b[K1258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    else x2 = \u001b[01;31m\u001b[Ksolve_bicgstab\u001b[m\u001b[K(A, bwork, p, max_it, tol, history, &iterations);\r\n\u001b[32m\u001b[K1260\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    double true_res = \u001b[01;31m\u001b[Kcompute_true_residual\u001b[m\u001b[K(A, bwork, x2);\r\n"]
[4446.271099, "o", "\u001b[32m\u001b[K1275\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    printf(\"\u001b[01;31m\u001b[Kiterations:\u001b[m\u001b[K %d\\n\", iterations);\r\n\u001b[32m\u001b[K1276\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    printf(\"\u001b[01;31m\u001b[Kresidual_norm:\u001b[m\u001b[K %.6e\\n\", true_res);\r\n\u001b[32m\u001b[K1277\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    printf(\"\u001b[01;31m\u001b[Kconverged:\u001b[m\u001b[K %s\\n\", (true_res <= tol) ? \"yes\" : \"no\");\r\n"]
