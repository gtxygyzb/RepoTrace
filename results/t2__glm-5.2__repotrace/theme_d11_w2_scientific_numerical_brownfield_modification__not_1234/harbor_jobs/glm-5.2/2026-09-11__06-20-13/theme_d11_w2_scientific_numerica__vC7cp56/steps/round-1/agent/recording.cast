[6575.102725, "o", "\u001b[32m\u001b[K852\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi \u001b[01;31m\u001b[Kpreconditioner\u001b[m\u001b[K\");\r\n\u001b[32m\u001b[K854\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else if (type == \u001b[01;31m\u001b[KPRECOND_SSOR\u001b[m\u001b[K) {\r\n"]
[6575.102793, "o", "\u001b[32m\u001b[K859\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else if (type == \u001b[01;31m\u001b[KPRECOND_IC0\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K870\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (p->type == \u001b[01;31m\u001b[KPRECOND_NONE\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K875\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (p->type == \u001b[01;31m\u001b[KPRECOND_JACOBI\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K877\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi \u001b[01;31m\u001b[Kpreconditioner\u001b[m\u001b[K\");\r\n\u001b[32m\u001b[K883\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (p->type == \u001b[01;31m\u001b[KPRECOND_SSOR\u001b[m\u001b[K) {\r\n"]
