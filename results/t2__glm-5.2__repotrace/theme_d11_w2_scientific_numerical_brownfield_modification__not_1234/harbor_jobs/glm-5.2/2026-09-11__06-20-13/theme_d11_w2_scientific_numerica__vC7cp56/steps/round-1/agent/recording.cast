[3658.407918, "o", "\u001b[32m\u001b[K898\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    double \u001b[01;31m\u001b[Kbnorm\u001b[m\u001b[K = vec_norm2(n, b);\r\n\u001b[32m\u001b[K899\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kbnorm\u001b[m\u001b[K == 0.0) {\r\n\u001b[32m\u001b[K904\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(p, r, z);\r\n"]
[3658.407986, "o", "\u001b[32m\u001b[K920\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (vec_norm2(n, r) <= tol * \u001b[01;31m\u001b[Kbnorm\u001b[m\u001b[K) break;\r\n\u001b[32m\u001b[K922\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kprecond_apply\u001b[m\u001b[K(p, r, z);\r\n"]
