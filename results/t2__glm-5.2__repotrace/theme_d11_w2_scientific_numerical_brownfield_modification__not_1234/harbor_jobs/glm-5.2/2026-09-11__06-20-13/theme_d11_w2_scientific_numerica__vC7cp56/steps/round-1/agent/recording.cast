[5978.003726, "o", "   265\t            add_entry(&entries, &count, &cap, r, c, v);\r\n   266\t        }\r\n   267\t    }\r\n   268\t\r\n   269\t    if (has_trailing_data(f)) {\r\n   270\t        free(entries);\r\n   271\t        fclose(f);\r\n   272\t        die(\"extra trailing data in matrix file\");\r\n   273\t    }\r\n   274\t\r\n   275\t    fclose(f);\r\n   276\t\r\n   277\t    CSRMatrix *m = build_csr(rows, entries, count, symmetric);\r\n   278\t    free(entries);\r\n   279\t    return m;\r\n   280\t}\r\n"]
