[5478.711889, "o", "  1215\t    if (strcmp(solver_name, \"cg\") == 0) solver = SOLVER_CG;\r\n  1216\t    else if (strcmp(solver_name, \"bicgstab\") == 0) solver = SOLVER_BICGSTAB;\r\n  1217\t    else die_unknown(\"solver\", solver_name);\r\n  1218\t\r\n  1219\t    int precond = PRECOND_NONE;\r\n  1220\t    if (precond_name) {\r\n  1221\t        if (strcmp(precond_name, \"none\") == 0) precond = PRECOND_NONE;\r\n  1222\t        else if (strcmp(precond_name, \"jacobi\") == 0) precond = PRECOND_JACOBI;\r\n  1223\t        else if (strcmp(precond_name, \"ssor\") == 0) precond = PRECOND_SSOR;\r\n  1224\t        else if (strcmp(precond_name, \"ic0\") == 0) precond = PRECOND_IC0;\r\n  1225\t        else die_unknown(\"preconditioner\", precond_name);\r\n  1226\t    }\r\n  1227\t\r\n  1228\t    int reorder = 0;\r\n  1229\t    if (reorder_name) {\r\n  1230\t        if (strcmp(reorder_name, \"none\") == 0) reorder = 0;\r\n"]
