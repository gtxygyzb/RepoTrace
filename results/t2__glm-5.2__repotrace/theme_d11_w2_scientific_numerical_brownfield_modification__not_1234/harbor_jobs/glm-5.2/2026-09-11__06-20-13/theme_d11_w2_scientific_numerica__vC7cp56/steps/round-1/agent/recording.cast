[6882.457258, "o", "./nlsolve --input /tmp/sing2.mtx --rhs /tmp/rhs_null.txt --solver bicgstab --max-it 5 --tol 1e-6 --history 2>/tmp/bi_err.txt; echo \"EXIT:$?\"; echo \"STDERR:\"; cat /tmp/bi_err.txt\r\n\u001b[?2004l\r"]
[6882.459969, "o", "solver: bicgstab\r\npreconditioner: none\r\ndimension: 2\r\nreordering: none\r\n"]
[6882.460429, "o", "EXIT:1\r\nSTDERR:\r\n"]
[6882.462572, "o", "error: BiCGSTAB numerical breakdown\r\n"]
[6882.462991, "o", "\u001b[?2004h"]
[6882.463063, "o", "root@n30009:/app# "]
[6892.557109, "i", "nl -ba nlsolve.c | sed -n '1000,1080p'\n"]
[6892.557442, "o", "nl -ba nlsolve.c | sed -n '1000,1080p'\r\n"]
[6892.557503, "o", "\u001b[?2004l\r"]
[6892.561766, "o", "  1000\t        rz_old = rz_new;\r\n  1001\t    }\r\n"]
[6892.561781, "o", "  1002\t\r\n  1003\t    if (iterations_out) *iterations_out = it_count;\r\n"]
[6892.561867, "o", "  1004\t    free(r); free(z); free(pvec); free(Ap);\r\n  1005\t    return x;\r\n  1006\t}\r\n  1007\t\r\n  1008\tstatic double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n  1009\t    int n = A->n;\r\n  1010\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n  1011\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n  1012\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n  1013\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n  1014\t    double *v = xmalloc((size_t)n * sizeof(double));\r\n  1015\t    double *s = xmalloc((size_t)n * sizeof(double));\r\n"]
[6892.561906, "o", "  1016\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n  1017\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n  1018\t\r\n  1019\t    spmv(A, x, r);\r\n  1020\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n  1021\t    double bnorm = vec_norm2(n, b);\r\n"]
[6892.561939, "o", "  1022\t    int it_count = 0;\r\n  1023\t\r\n  1024\t    dcopy(n, r, r0);\r\n  1025\t    double rho_old = dot(n, r0, r);\r\n"]
[6892.561971, "o", "  1026\t    if (rho_old == 0.0) {\r\n  1027\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1028\t        die(\"BiCGSTAB numerical breakdown\");\r\n  1029\t    }\r\n  1030\t    dcopy(n, r, pvec);\r\n"]
[6892.562, "o", "  1031\t\r\n  1032\t    for (int it = 0; it < max_it; it++) {\r\n  1033\t        precond_apply(p, pvec, z);\r\n  1034\t"]
[6892.562031, "o", "        spmv(A, z, v);\r\n  1035\t        double r0v = dot(n, r0, v);\r\n  1036\t        if (r0v == 0.0) {\r\n  1037\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1038\t"]
[6892.56206, "o", "            die(\"BiCGSTAB numerical breakdown\");\r\n  1039\t        }\r\n  1040\t        double alpha = rho_old / r0v;\r\n  1041\t        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n  1042\t"]
[6892.562088, "o", "\r\n  1043\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n  1044\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n  1045\t            it_count = it + 1;\r\n  1046"]
[6892.562118, "o", "\t            if (history) {\r\n  1047\t                printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, s));\r\n  1048\t            }\r\n  1049\t            break;\r\n  1050\t        }\r\n"]
[6892.562146, "o", "  1051\t\r\n  1052\t        precond_apply(p, s, z);\r\n  1053\t        spmv(A, z, t);\r\n  1054\t        double ts = dot(n, t, s);\r\n  1055\t"]
[6892.562174, "o", "        double tt = dot(n, t, t);\r\n  1056\t        if (fabs(tt) <= 1e-300) {\r\n  1057\t            break;\r\n  1058\t"]
[6892.562202, "o", "        }\r\n  1059\t        double omega = ts / tt;\r\n  1060\t        for (int i = 0; i < n; i++) {\r\n  1061\t            x[i] += alpha * z[i] + omega * s[i];\r\n  1062\t"]
[6892.562232, "o", "            r[i] = s[i] - omega * t[i];\r\n  1063\t        }\r\n  1064\t        it_count = it + 1;\r\n  1065\t        if (history) {\r\n  1066\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n  1067"]
[6892.562267, "o", "\t        }\r\n  1068\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n  1069\t\r\n"]
[6892.562294, "o", "  1070\t        double rho_new = dot(n, r0, r);\r\n  1071\t        if (fabs(rho_new) <= 1e-300) {\r\n  1072\t            break;\r\n  1073\t        }\r\n  1074\t        double beta = (rho_new / rho_old) * (alpha / omega);\r\n"]
[6892.562325, "o", "  1075\t        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n  1076\t        rho_old = rho_new;\r\n  1077\t    }\r\n  1078\t\r\n"]
[6892.562352, "o", "  1079\t    if (iterations_out) *iterations_out = it_count;\r\n  1080\t    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n"]
[6892.562958, "o", "\u001b[?2004h"]
[6892.563027, "o", "root@n30009:/app# "]
[6892.825275, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\np = Path('nlsolve.c')\ns = p.read_text()\ns = re.sub(r'if \\(tt == 0\\.0\\) \\{\\s*free\\([^)]*\\);\\s*die\\(\"BiCGSTAB numerical breakdown\"\\);\\s*\\}', 'if (fabs(tt) <= 1e-300) {\\n            break;\\n        }', s)\ns = re.sub(r'if \\(rho_new == 0\\.0\\) \\{\\s*free\\([^)]*\\);\\s*die\\(\"BiCGSTAB numerical breakdown\"\\);\\s*\\}', 'if (fabs(rho_new) <= 1e-300) {\\n            break;\\n        }', s)\ns = re.sub(r'if \\(fabs\\(tt\\) <= 1e-300\\) \\{\\s*free\\([^)]*\\);\\s*die\\(\"BiCGSTAB numerical breakdown\"\\);\\s*\\}', 'if (fabs(tt) <= 1e-300) {\\n            break;\\n        }', s)\ns = re.sub(r'if \\(fabs\\(rho_new\\) <= 1e-300\\) \\{\\s*free\\([^)]*\\);\\s*die\\(\"BiCGSTAB numerical breakdown\"\\);\\s*\\}', 'if (fabs(rho_new) <= 1e-300) {\\n            break;\\n        }', s)\np.write_text(s)\nPY\n"]
