[6947.400274, "o", "\u001b[32m\u001b[K1308\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        } else if (strcmp(arg, \"\u001b[01;31m\u001b[K--gen\u001b[m\u001b[Kerate-laplacian\") == 0) {\r\n\u001b[32m\u001b[K1309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) die(\"missing argument for \u001b[01;31m\u001b[K--gen\u001b[m\u001b[Kerate-laplacian\");\r\n\u001b[32m\u001b[K1310\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kgen2d\u001b[m\u001b[K = argv[i];\r\n\u001b[32m\u001b[K1311\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        } else if (strcmp(arg, \"\u001b[01;31m\u001b[K--gen\u001b[m\u001b[Kerate-laplacian3d\") == 0) {\r\n\u001b[32m\u001b[K1312\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) die(\"missing argument for \u001b[01;31m\u001b[K--gen\u001b[m\u001b[Kerate-laplacian3d\");\r\n\u001b[32m\u001b[K1313\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kgen3d\u001b[m\u001b[K = argv[i];\r\n"]
[6947.400357, "o", "\u001b[32m\u001b[K1314\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        } else if (strcmp(arg, \"\u001b[01;31m\u001b[K--gen\u001b[m\u001b[Kerate-rhs\") == 0) {\r\n\u001b[32m\u001b[K1315\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) die(\"missing argument for \u001b[01;31m\u001b[K--gen\u001b[m\u001b[Kerate-rhs\");\r\n\u001b[32m\u001b[K1316\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kgenrhs\u001b[m\u001b[K = argv[i];\r\n\u001b[32m\u001b[K1345\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kgen2d\u001b[m\u001b[K) modes++;\r\n\u001b[32m\u001b[K1346\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kgen3d\u001b[m\u001b[K) modes++;\r\n\u001b[32m\u001b[K1347\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kgenrhs\u001b[m\u001b[K) modes++;\r\n\u001b[32m\u001b[K1351\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (\u001b[01;31m\u001b[Kgen2d\u001b[m\u001b[K || \u001b[01;31m\u001b[Kgen3d\u001b[m\u001b[K || \u001b[01;31m\u001b[Kgenrhs\u001b[m\u001b[K) {\r\n"]
[6947.400428, "o", "\u001b[32m\u001b[K1355\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!output) die(\"missing output file for \u001b[01;31m\u001b[Kgenerator\u001b[m\u001b[K\");\r\n\u001b[32m\u001b[K1357\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[Kgen2d\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K1358\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            int n = parse_int_arg(\u001b[01;31m\u001b[Kgen2d\u001b[m\u001b[K);\r\n\u001b[32m\u001b[K1359\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (n <= 0) die(\"invalid \u001b[01;31m\u001b[Kgenerator\u001b[m\u001b[K size\");\r\n\u001b[32m\u001b[K1361\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N > INT_MAX / 3) die(\"\u001b[01;31m\u001b[Kgenerator\u001b[m\u001b[K size too large\");\r\n"]
[6947.400493, "o", "\u001b[32m\u001b[K1363\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        } else if (\u001b[01;31m\u001b[Kgen3d\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K1364\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            int n = parse_int_arg(\u001b[01;31m\u001b[Kgen3d\u001b[m\u001b[K);\r\n\u001b[32m\u001b[K1365\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (n <= 0) die(\"invalid \u001b[01;31m\u001b[Kgenerator\u001b[m\u001b[K size\");\r\n\u001b[32m\u001b[K1367\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N > INT_MAX / 4) die(\"\u001b[01;31m\u001b[Kgenerator\u001b[m\u001b[K size too large\");\r\n\u001b[32m\u001b[K1370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            int N = parse_int_arg(\u001b[01;31m\u001b[Kgenrhs\u001b[m\u001b[K);\r\n\u001b[32m\u001b[K1371\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N <= 0) die(\"invalid \u001b[01;31m\u001b[Kgenerator\u001b[m\u001b[K size\");\r\n"]
