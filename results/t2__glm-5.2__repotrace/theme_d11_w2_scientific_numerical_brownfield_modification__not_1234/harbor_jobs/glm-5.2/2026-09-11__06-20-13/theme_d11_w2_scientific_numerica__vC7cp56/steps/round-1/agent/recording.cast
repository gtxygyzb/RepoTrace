[3007.897099, "o", "        int r, c;\r\n        double v;\r\n        if (fscanf(f, \"%d %d %lf\", &r, &c, &v) != 3) {\r\n            fclose(f);\r\n            free(entries);\r\n            die(\"failed to read matrix entry\");\r\n        }\r\n        if (r < 1 || r > rows || c < 1 || c > cols) {\r\n            fclose(f);\r\n"]
[3007.897146, "o", "            free(entries);\r\n            die(\"matrix entry index out of range\");\r\n        }\r\n        r--;\r\n        c--;\r\n        if (symmetric) {\r\n            if (r < c) {\r\n"]
[3007.897282, "o", "                int t = r; r = c; c = t;\r\n            }\r\n            add_entry(&entries, &count, &cap, r, c, v);\r\n            if (r != c) add_entry(&entries, &count, &cap, c, r, v);\r\n        } else {\r\n            add_entry(&entries, &count, &cap, r, c, v);\r\n        }\r\n    }\r\n\r\n    char extra_matrix;\r\n    if (fscanf(f, \" %c\", &extra_matrix) == 1) {\r\n        free(entries);\r\n        fclose(f);\r\n        die(\"extra trailing data in matrix file\");\r\n    }\r\n\r\n    fclose(f);\r\n\r\n    CSRMatrix *m = build_csr(rows, entries, count, symmetric);\r\n    free(entries);\r\n    return m;\r\n}\r\n\r\nstatic double *read_vector(const char *filename, int *n_out) {\r\n    FILE *f = fopen(filename, \"r\");\r\n    if (!f) die(\"cannot open rhs file\");\r\n    int n;\r\n    if (fscanf(f, \"%d\", &n) != 1) {\r\n        fclose(f);\r\n        die(\"failed to read vector dimension\");\r\n"]
[3007.89735, "o", "    }\r\n    if (n <= 0) die(\"invalid vector dimension\");\r\n    double *x = xmalloc((size_t)n * sizeof(double));\r\n    for (int i = 0; i < n; i++) {\r\n        if (fscanf(f, \"%lf\", &x[i]) != 1) {\r\n            fclose(f);\r\n            free(x);\r\n            die(\"failed to read vector entry\");\r\n        }\r\n    }\r\n\r\n    char extra_vector;\r\n    if (fscanf(f, \" %c\", &extra_vector) == 1) {\r\n        fclose(f);\r\n        free(x);\r\n        die(\"extra trailing data in vector file\");\r\n    }\r\n\r\n"]
[3007.897435, "o", "    fclose(f);\r\n    *n_out = n;\r\n    return x;\r\n}\r\n\r\nstatic void write_matrix_market(const char *filename, int n, int nnz, Entry *entries) {\r\n    FILE *f = fopen(filename, \"w\");\r\n    if (!f) die(\"cannot open output matrix file\");\r\n    fprintf(f, \"%%%%MatrixMarket matrix coordinate real symmetric\\n\");\r\n    fprintf(f, \"%d %d %d\\n\", n, n, nnz);\r\n    for (int k = 0; k < nnz; k++) {\r\n        fprintf(f, \"%d %d %.15g\\n\", entries[k].r + 1, entries[k].c + 1, entries[k].v);\r\n    }\r\n    fclose(f);\r\n}\r\n\r\nstatic int cmp_entry_rc(const void *a, const void *b) {\r\n    const Entry *ea = (const Entry *)a;\r\n"]
[3007.897497, "o", "    const Entry *eb = (const Entry *)b;\r\n    if (ea->r != eb->r) return ea->r - eb->r;\r\n    return ea->c - eb->c;\r\n}\r\n\r\nstatic void generate_laplacian2d(int n, const char *output) {\r\n    int N = n * n;\r\n    int cap = N * 3;\r\n    Entry *entries = xmalloc((size_t)cap * sizeof(Entry));\r\n"]
