[3188.899178, "o", "ver cg --input /tmp/lap2d.mtx\r\nrun_test \"no operation\"\r\nrun_test \"unknown option\" --bad-option\r\nrun_test \"analyze with output\" --analyze --input /tmp/lap2d.mtx --"]
