[6421.708568, "o", "\u001b[32m\u001b[K1311\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --generate-rhs\");\r\n\u001b[32m\u001b[K1314\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for max iterations\");\r\n\u001b[32m\u001b[K1317\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for tolerance\");\r\n\u001b[32m\u001b[K1320\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for omega\");\r\n\u001b[32m\u001b[K1323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --restart\");\r\n\u001b[32m\u001b[K1329\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[Kmsg);\r\n"]
[6421.708665, "o", "\u001b[32m\u001b[K1334\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (restart < 1) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid restart value\");\r\n\u001b[32m\u001b[K1335\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!(solver_name && strcmp(solver_name, \"gmres\") == 0)) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"--restart requires --solver gmres\");\r\n\u001b[32m\u001b[K1344\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (modes == 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"no operation specified\");\r\n"]
[6421.708738, "o", "\u001b[32m\u001b[K1345\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (modes > 1) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting operation modes specified\");\r\n\u001b[32m\u001b[K1349\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting command-line arguments\");\r\n\u001b[32m\u001b[K1351\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!output) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing output file for generator\");\r\n\u001b[32m\u001b[K1355\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1357\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N > INT_MAX / 3) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"generator size too large\");\r\n\u001b[32m\u001b[K1361\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1363\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N > INT_MAX / 4) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"generator size too large\");\r\n\u001b[32m\u001b[K1367\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1374\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!input) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing input file for analyze\");\r\n"]
[6421.708813, "o", "\u001b[32m\u001b[K1376\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting command-line arguments\");\r\n\u001b[32m\u001b[K1384\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!input) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing input file for solver\");\r\n\u001b[32m\u001b[K1385\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!rhs) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing rhs file for solver\");\r\n\u001b[32m\u001b[K1386\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!solver_name) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing solver name\");\r\n\u001b[32m\u001b[K1390\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    else if (strcmp(solver_name, \"bicgstab\") == 0) solver = SOLVER_B\u001b[01;31m\u001b[KIC\u001b[m\u001b[KGSTAB;\r\n"]
[6421.708883, "o", "\u001b[32m\u001b[K1399\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        else if (strcmp(precond_name, \"ic0\") == 0) precond = PRECOND_\u001b[01;31m\u001b[KIC\u001b[m\u001b[K0;\r\n\u001b[32m\u001b[K1410\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (max_it <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid max iterations\");\r\n\u001b[32m\u001b[K1411\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (tol < 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid tolerance\");\r\n\u001b[32m\u001b[K1419\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix and RHS dimensions do not match\");\r\n"]
[6421.708997, "o", "\u001b[32m\u001b[K1452\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    else if (solver == SOLVER_B\u001b[01;31m\u001b[KIC\u001b[m\u001b[KGSTAB) x2 = solve_bicgstab(A, bwork, p, max_it, tol, history, &iterations);\r\n"]
[6421.709491, "o", "\u001b[?2004h"]
[6421.709558, "o", "root@n30009:/app# "]
[6421.979564, "i", "nl -ba nlsolve.c | sed -n '760,860p'\n"]
[6421.979908, "o", "nl -ba nlsolve.c | sed -n '760,860p'\r\n\u001b[?2004l\r"]
[6421.983822, "o", "   760\t\r\n   761\tstatic ICFactor *ic0_factorize(const CSRMatrix *m) {\r\n   762\t    int n = m->n;\r\n   763\t    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n   764\t    for (int i = 0; i < n; i++) {\r\n   765\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   766\t            if (m->col_idx[idx] < i) row_ptr[i + 1]++;\r\n   767\t        }\r\n   768\t    }\r\n"]
[6421.983967, "o", "   769\t    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];\r\n   770\t\r\n   771\t    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n   772\t    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));\r\n   773\t    int *next = xcalloc((size_t)n, sizeof(int));\r\n   774\t    for (int i = 0; i < n; i++) {\r\n   775\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   776\t            int j = m->col_idx[idx];\r\n   777\t            if (j < i) col_idx[row_ptr[i] + next[i]++] = j;\r\n"]
[6421.984051, "o", "   778\t        }\r\n   779\t    }\r\n   780\t    free(next);\r\n   781\t\r\n   782\t    double *diag = xmalloc((size_t)n * sizeof(double));\r\n   783\t    for (int i = 0; i < n; i++) {\r\n   784\t        double aii = 0.0;\r\n   785\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   786\t            if (m->col_idx[idx] == i) aii += m->vals[idx];\r\n   787\t        }\r\n   788\t\r\n   789\t        double sum = aii;\r\n   790\t        for (int k = row_ptr[i]; k < row_ptr[i + 1]; k++) {\r\n   791\t            int j = col_idx[k];\r\n   792\t            double aij = 0.0;\r\n   793\t            for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   794\t                if (m->col_idx[idx] == j) {\r\n   795\t                    aij += m->vals[idx];\r\n   796\t                    break;\r\n   797\t                }\r\n   798\t            }\r\n   799\t\r\n   800\t            double s = aij;\r\n   801\t            int pi = row_ptr[i];\r\n"]
[6421.984135, "o", "   802\t            int pj = row_ptr[j];\r\n   803\t            while (pi < k && pj < row_ptr[j + 1]) {\r\n   804\t                int ci = col_idx[pi];\r\n   805\t                int cj = col_idx[pj];\r\n   806\t                if (ci == cj) {\r\n   807\t                    s -= vals[pi] * vals[pj];\r\n   808\t                    pi++;\r\n   809\t                    pj++;\r\n   810\t                } else if (ci < cj) {\r\n   811\t                    pi++;\r\n   812\t                } else {\r\n   813\t                    pj++;\r\n   814\t"]
[6421.984207, "o", "                }\r\n   815\t            }\r\n   816\t\r\n   817\t            if (diag[j] <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   818\t            double l = s / diag[j];\r\n   819\t            vals[k] = l;\r\n   820\t            sum -= l * l;\r\n   821\t        }\r\n   822\t\r\n   823\t        if (sum <= 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n   824\t        diag[i] = sqrt(sum);\r\n   825\t    }\r\n   826\t"]
[6421.984277, "o", "\r\n   827\t    ICFactor *ic = xmalloc(sizeof(ICFactor));\r\n   828\t    ic->n = n;\r\n   829\t    ic->l_row_ptr = row_ptr;\r\n   830\t    ic->l_col_idx = col_idx;\r\n   831\t    ic->l_vals = vals;\r\n   832\t    ic->diag = diag;\r\n   833\t    ic->u_row_ptr = NULL;\r\n   834\t    ic->u_col_idx = NULL;\r\n   835\t    ic->u_vals = NULL;\r\n   836\t    return ic;\r\n"]
[6421.98435, "o", "   837\t}\r\n   838\t\r\n   839\tstatic Precond *precond_setup(CSRMatrix *m, int type, double omega) {\r\n   840\t    Precond *p = xmalloc(sizeof(Precond));\r\n   841\t    p->type = type;\r\n   842\t    p->A = m;\r\n   843\t    p->diag = NULL;\r\n   844\t    p->lower = NULL;\r\n   845\t    p->upper = NULL;\r\n   846\t    p->omega = omega;\r\n   847\t    p->ic = NULL;\r\n   848\t\r\n"]
[6421.984421, "o", "   849\t    if (type == PRECOND_JACOBI) {\r\n   850\t        p->diag = compute_diag(m);\r\n   851\t        for (int i = 0; i < m->n; i++) {\r\n   852\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   853\t        }\r\n   854\t    } else if (type == PRECOND_SSOR) {\r\n   855\t        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n   856\t        p->diag = compute_diag(m);\r\n   857\t        p->lower = build_lower_triangular(m);\r\n   858\t        p->upper = build_upper_triangular(m);\r\n   859\t    } else if (type == PRECOND_IC0) {\r\n   860\t        if (!m->symmetric) die(\"IC(0) requires symmetric matrix\");\r\n"]
[6421.985152, "o", "\u001b[?2004h"]
[6421.985225, "o", "root@n30009:/app# "]
[6422.261133, "i", "nl -ba nlsolve.c | sed -n '950,1090p'\n"]
[6422.26145, "o", "nl -ba nlsolve.c | sed -n '950,1090p'\r\n\u001b[?2004l\r"]
[6422.265242, "o", "   950\tstatic double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n   951\t    int n = A->n;\r\n   952\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n   953\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n   954\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   955\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n   956\t    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n   957\t\r\n"]
[6422.265368, "o", "   958\t    spmv(A, x, r);\r\n   959\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   960\t    double bnorm = vec_norm2(n, b);\r\n   961\t    int it_count = 0;\r\n   962\t\r\n   963\t    precond_apply(p, r, z);\r\n   964\t    dcopy(n, z, pvec);\r\n   965\t    double rz_old = dot(n, r, z);\r\n   966\t\r\n   967\t    for (int it = 0; it < max_it; it++) {\r\n   968\t        spmv(A, pvec, Ap);\r\n   969\t        double pAp = dot(n, pvec, Ap);\r\n   970\t        if (pAp <= 0.0) {\r\n   971\t            free(r); free(z); free(pvec); free(Ap);\r\n   972\t            die(\"matrix is not positive definite\");\r\n   973\t        }\r\n   974\t        double alpha = rz_old / pAp;\r\n   975\t        for (int i = 0; i < n; i++) {\r\n"]
[6422.265451, "o", "   976\t            x[i] += alpha * pvec[i];\r\n   977\t            r[i] -= alpha * Ap[i];\r\n   978\t        }\r\n   979\t        it_count = it + 1;\r\n   980\t        if (history) {\r\n   981\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n   982\t        }\r\n   983\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n   984\t\r\n   985\t        precond_apply(p, r, z);\r\n   986\t        double rz_new = dot(n, r, z);\r\n   987"]
[6422.265528, "o", "\t        if (rz_old == 0.0) {\r\n   988\t            free(r); free(z); free(pvec); free(Ap);\r\n   989\t            die(\"CG numerical breakdown\");\r\n   990\t        }\r\n   991\t        double beta = rz_new / rz_old;\r\n   992\t        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n   993\t        rz_old = rz_new;\r\n   994\t    }\r\n   995\t\r\n   996\t    if (iterations_out) *iterations_out = it_count;\r\n   997\t    free(r); free(z); free(pvec); free(Ap);\r\n   998\t    return x;\r\n"]
[6422.2656, "o", "   999\t}\r\n  1000\t\r\n  1001\tstatic double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n  1002\t    int n = A->n;\r\n  1003\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n  1004\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n  1005\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n  1006\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n  1007\t    double *v = xmalloc((size_t)n * sizeof(double));\r\n  1008\t"]
[6422.265717, "o", "    double *s = xmalloc((size_t)n * sizeof(double));\r\n  1009\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n  1010\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n  1011\t\r\n  1012\t    spmv(A, x, r);\r\n  1013\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n  1014\t    double bnorm = vec_norm2(n, b);\r\n  1015\t    int it_count = 0;\r\n  1016\t\r\n  1017\t    dcopy(n, r, r0);\r\n  1018\t    double rho_old = dot(n, r0, r);\r\n  1019\t    if (rho_old == 0.0) {\r\n  1020\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1021\t        die(\"BiCGSTAB numerical breakdown\");\r\n  1022\t    }\r\n  1023\t"]
[6422.265787, "o", "    dcopy(n, r, pvec);\r\n  1024\t\r\n  1025\t    for (int it = 0; it < max_it; it++) {\r\n  1026\t        precond_apply(p, pvec, z);\r\n  1027\t        spmv(A, z, v);\r\n  1028\t        double r0v = dot(n, r0, v);\r\n  1029\t        if (r0v == 0.0) {\r\n  1030\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1031\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1032\t        }\r\n"]
[6422.265859, "o", "  1033\t        double alpha = rho_old / r0v;\r\n  1034\t        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n  1035\t\r\n  1036\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n  1037\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n  1038\t            it_count = it + 1;\r\n  1039\t            if (history) {\r\n  1040\t                printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, s));\r\n  1041\t            }\r\n  1042\t            break;"]
[6422.265929, "o", "\r\n  1043\t        }\r\n  1044\t\r\n  1045\t        precond_apply(p, s, z);\r\n  1046\t        spmv(A, z, t);\r\n  1047\t        double ts = dot(n, t, s);\r\n  1048\t        double tt = dot(n, t, t);\r\n  1049\t        if (tt == 0.0) {\r\n  1050\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1051\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1052\t        }\r\n  1053\t        double omega = ts / tt;\r\n"]
[6422.26601, "o", "  1054\t        for (int i = 0; i < n; i++) {\r\n  1055\t            x[i] += alpha * z[i] + omega * s[i];\r\n  1056\t            r[i] = s[i] - omega * t[i];\r\n  1057\t        }\r\n  1058\t        it_count = it + 1;\r\n  1059\t        if (history) {\r\n  1060\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n  1061\t        }\r\n  1062\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n  1063\t\r\n  1064\t        double rho_new = dot(n, r0, r);"]
[6422.266083, "o", "\r\n  1065\t        if (rho_new == 0.0) {\r\n  1066\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1067\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1068\t        }\r\n  1069\t        double beta = (rho_new / rho_old) * (alpha / omega);\r\n  1070\t        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n  1071\t        rho_old = rho_new;\r\n  1072\t    }\r\n  1073\t\r\n  1074\t    if (iterations_out) *iterations_out = it_count;\r\n  1075\t"]
[6422.266158, "o", "    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1076\t    return x;\r\n  1077\t}\r\n  1078\t\r\n  1079\tstatic double *solve_gmres(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int restart, int *iterations_out) {\r\n  1080\t    int n = A->n;\r\n  1081\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n  1082\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n  1083\t    double *w = xmalloc((size_t)n * sizeof(double));\r\n  1084\t    double *V = xmalloc((size_t)(restart + 1) * n * sizeof(double));\r\n  1085"]
[6422.266227, "o", "\t    double *Z = xmalloc((size_t)restart * n * sizeof(double));\r\n  1086\t    double *H = xmalloc((size_t)(restart + 1) * restart * sizeof(double));\r\n  1087\t    double *g = xmalloc((size_t)(restart + 1) * sizeof(double));\r\n  1088\t    double *cs = xmalloc((size_t)restart * sizeof(double));\r\n  1089\t    double *sn = xmalloc((size_t)restart * sizeof(double));\r\n  1090\t    double *y = xmalloc((size_t)restart * sizeof(double));\r\n"]
