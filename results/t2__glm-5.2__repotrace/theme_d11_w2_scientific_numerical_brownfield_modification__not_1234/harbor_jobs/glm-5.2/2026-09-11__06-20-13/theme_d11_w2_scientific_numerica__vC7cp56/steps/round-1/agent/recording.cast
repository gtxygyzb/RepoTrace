[6410.204012, "o", "  1005\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n  1006\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n  1007\t    double *v = xmalloc((size_t)n * sizeof(double));\r\n  1008\t    double *s = xmalloc((size_t)n * sizeof(double));\r\n  1009\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n  1010\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n  1011\t\r\n  1012\t    spmv(A, x, r);\r\n  1013\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n  1014\t    double bnorm = vec_norm2(n, b);\r\n  1015\t    int it_count = 0;\r\n  1016\t\r\n  1017\t    dcopy(n, r, r0);\r\n  1018"]
[6410.204174, "o", "\t    double rho_old = dot(n, r0, r);\r\n  1019\t    if (rho_old == 0.0) {\r\n  1020\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1021\t        die(\"BiCGSTAB numerical breakdown\");\r\n  1022\t    }\r\n  1023\t    dcopy(n, r, pvec);\r\n  1024\t\r\n  1025\t    for (int it = 0; it < max_it; it++) {\r\n  1026\t        precond_apply(p, pvec, z);\r\n  1027\t        spmv(A, z, v);\r\n  1028\t        double r0v = dot(n, r0, v);\r\n  1029\t        if (r0v == 0.0) {\r\n  1030\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1031\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1032\t        }\r\n  1033\t        double alpha = rho_old / r0v;\r\n  1034\t        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n  1035\t\r\n  1036\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n  1037\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n  1038\t            it_count = it + 1;\r\n  1039\t            if (history) {\r\n  1040\t                printf(\"iteration %d residual %.6e\\n\", it_count, v"]
[6410.204266, "o", "ec_norm2(n, s));\r\n  1041\t            }\r\n  1042\t            break;\r\n  1043\t        }\r\n  1044\t\r\n  1045\t        precond_apply(p, s, z);\r\n  1046\t        spmv(A, z, t);\r\n  1047\t        double ts = dot(n, t, s);\r\n  1048\t        double tt = dot(n, t, t);\r\n  1049\t        if (tt == 0.0) {\r\n  1050\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n"]
[6410.20434, "o", "  1051\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1052\t        }\r\n  1053\t        double omega = ts / tt;\r\n  1054\t        for (int i = 0; i < n; i++) {\r\n  1055\t            x[i] += alpha * z[i] + omega * s[i];\r\n  1056\t            r[i] = s[i] - omega * t[i];\r\n  1057\t        }\r\n  1058\t        it_count = it + 1;\r\n  1059\t        if (history) {\r\n  1060\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n  1061\t        }\r\n  1062\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n  1063\t\r\n  1064\t        double rho_new = dot(n, r0, r);\r\n  1065\t        if (rho_new == 0.0) {\r\n  1066\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1067\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1068"]
[6410.204411, "o", "\t        }\r\n  1069\t        double beta = (rho_new / rho_old) * (alpha / omega);\r\n  1070\t        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n  1071\t        rho_old = rho_new;\r\n  1072\t    }\r\n  1073\t\r\n  1074\t    if (iterations_out) *iterations_out = it_count;\r\n  1075\t    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1076\t    return x;\r\n  1077\t}\r\n  1078\t\r\n"]
[6410.204482, "o", "  1079\tstatic double *solve_gmres(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int restart, int *iterations_out) {\r\n  1080\t    int n = A->n;\r\n  1081\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n  1082\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n  1083\t    double *w = xmalloc((size_t)n * sizeof(double));\r\n  1084\t    double *V = xmalloc((size_t)(restart + 1) * n * sizeof(double));\r\n  1085\t    double *Z = xmalloc((size_t)restart * n * sizeof(double));\r\n  1086\t    double *H = xmalloc((size_t)(restart + 1) * restart * sizeof(double));\r\n  1087\t    double *g = xmalloc((size_t)(restart + 1) * sizeof(double));\r\n"]
[6410.204559, "o", "  1088\t    double *cs = xmalloc((size_t)restart * sizeof(double));\r\n  1089\t    double *sn = xmalloc((size_t)restart * sizeof(double));\r\n  1090\t    double *y = xmalloc((size_t)restart * sizeof(double));\r\n  1091\t    double bnorm = vec_norm2(n, b);\r\n  1092\t    int it_count = 0;\r\n  1093\t    int converged = 0;\r\n  1094\t\r\n  1095\t    for (int cycle = 0; it_count < max_it && !converged; cycle++) {\r\n  1096\t        spmv(A, x, r);\r\n  1097\t        for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n  1098\t        double beta = vec_norm2(n, r);\r\n"]
[6410.204652, "o", "  1099\t        if (beta <= tol * bnorm) {\r\n  1100\t            converged = 1;\r\n  1101\t            break;\r\n  1102\t        }\r\n  1103\t\r\n  1104\t        for (int i = 0; i <= restart; i++) g[i] = 0.0;\r\n  1105\t        g[0] = beta;\r\n  1106\t        double inv_beta = 1.0 / beta;\r\n  1107\t        for (int i = 0; i < n; i++) V[i] = r[i] * inv_beta;\r\n  1108\t\r\n  1109\t"]
[6410.204744, "o", "        int steps = 0;\r\n  1110\t        for (int j = 0; j < restart && it_count < max_it; j++) {\r\n  1111\t            precond_apply(p, V + j * n, Z + j * n);\r\n  1112\t            spmv(A, Z + j * n, w);\r\n  1113\t\r\n  1114\t            for (int i = 0; i <= j; i++) {\r\n  1115\t                double h = dot(n, w, V + i * n);\r\n  1116\t                H[i * restart + j] = h;\r\n  1117\t                for (int k = 0; k < n; k++) w[k] -= h * V[i * n + k];\r\n  1118\t            }\r\n  1119\t            double hnext = vec_norm2(n, w);\r\n  1120\t            H[(j + 1) * restart + j] = hnext;\r\n  1121\t            if (hnext > 0.0) {\r\n  1122\t                double inv_h = 1.0 / hnext;\r\n  1123\t                for (int k = 0; k < n; k++) V[(j + 1) * n + k] = w[k] * inv_h;\r\n  1124"]
[6410.204814, "o", "\t            } else {\r\n  1125\t                for (int k = 0; k < n; k++) V[(j + 1) * n + k] = 0.0;\r\n  1126\t            }\r\n  1127\t\r\n  1128\t            for (int i = 0; i < j; i++) {\r\n  1129\t                double temp = cs[i] * H[i * restart + j] + sn[i] * H[(i + 1) * restart + j];\r\n  1130\t                H[(i + 1) * restart + j] = -sn[i] * H[i * restart + j] + cs[i] * H[(i + 1) * restart + j];\r\n  1131\t                H[i * restart + j] = temp;\r\n  1132\t            }\r\n  1133\t\r\n"]
[6410.204883, "o", "  1134\t            double hjj = H[j * restart + j];\r\n  1135\t            double hj1j = H[(j + 1) * restart + j];\r\n  1136\t            double rot = sqrt(hjj * hjj + hj1j * hj1j);\r\n  1137\t            if (rot == 0.0) {\r\n  1138\t                cs[j] = 1.0;\r\n  1139\t                sn[j] = 0.0;\r\n  1140\t            } else {\r\n  1141\t                cs[j] = hjj / rot;\r\n  1142\t                sn[j] = hj1j / rot;\r\n  1143\t            }\r\n  1144\t            H[j * restart + j] = rot;\r\n  1145\t"]
[6410.204966, "o", "            H[(j + 1) * restart + j] = 0.0;\r\n  1146\t\r\n  1147\t            double gtemp = cs[j] * g[j] + sn[j] * g[j + 1];\r\n  1148\t            g[j + 1] = -sn[j] * g[j] + cs[j] * g[j + 1];\r\n  1149\t            g[j] = gtemp;\r\n  1150\t\r\n  1151\t            it_count++;\r\n  1152\t            steps = j + 1;\r\n  1153\t\r\n  1154\t            double res = 0.0;\r\n  1155\t            for (int k = j + 1; k <= restart; k++) res += g[k] * g[k];\r\n  1156\t            res = sqrt(res);\r\n  1157\t            if (history) {\r\n  1158\t                printf(\"iteration %d residual %.6e\\n\", it_count, res);"]
[6410.205082, "o", "\r\n  1159\t            }\r\n  1160\t            if (res <= tol * bnorm) {\r\n  1161\t                converged = 1;\r\n  1162\t                break;\r\n  1163\t            }\r\n  1164\t            if (hnext == 0.0) {\r\n  1165\t                break;\r\n  1166\t            }\r\n  1167\t        }\r\n  1168\t\r\n  1169\t        if (steps > 0) {\r\n  1170\t            for (int i = steps - 1; i >= 0; i--) {\r\n  1171\t                double sum = g[i];\r\n  1172\t                for (int k = i + 1; k < steps; k++) {\r\n  1173\t                    sum -= H[i * restart + k] * y[k];\r\n  1174\t                }\r\n  1175\t"]
[6410.205152, "o", "                if (H[i * restart + i] == 0.0) {\r\n  1176\t                    free(r); free(w); free(V); free(Z); free(H); free(g); free(cs); free(sn); free(y);\r\n  1177\t                    die(\"GMRES numerical breakdown\");\r\n  1178\t                }\r\n  1179\t                y[i] = sum / H[i * restart + i];\r\n  1180\t            }\r\n  1181\t            for (int i = 0; i < steps; i++) {\r\n  1182\t                double yi = y[i];\r\n  1183\t                for (int k = 0; k < n; k++) {\r\n  1184\t                    x[k] += Z[i * n + k] * yi;\r\n  1185\t                }\r\n"]
