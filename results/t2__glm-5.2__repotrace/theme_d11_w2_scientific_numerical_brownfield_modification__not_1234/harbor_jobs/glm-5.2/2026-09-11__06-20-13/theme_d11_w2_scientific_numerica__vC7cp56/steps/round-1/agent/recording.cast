[5978.002997, "o", "   182\t\r\n   183\tstatic CSRMatrix *read_matrix(const char *filename) {\r\n   184\t    FILE *f = fopen(filename, \"r\");\r\n   185\t    if (!f) die(\"cannot open matrix file\");\r\n   186\t\r\n   187\t    char line[1024];\r\n   188\t"]
[5978.003143, "o", "    if (!fgets(line, sizeof(line), f)) {\r\n   189\t        fclose(f);\r\n   190\t        die(\"empty matrix file\");\r\n   191\t    }\r\n   192\t    if (strncmp(line, \"%%MatrixMarket\", 14) != 0) {\r\n   193\t        fclose(f);\r\n   194\t        die(\"matrix file is not Matrix Market format\");\r\n   195\t    }\r\n   196\t\r\n   197\t    char obj[64], fmt[64], field[64], sym[64];\r\n   198\t    if (sscanf(line, \"%*s %63s %63s %63s %63s\", obj, fmt, field, sym) != 4) {\r\n   199\t        fclose(f);\r\n   200\t        die(\"invalid Matrix Market header\");\r\n   201\t    }\r\n   202\t    if (strcmp(obj, \"matrix\") != 0 || strcmp(fmt, \"coordinate\") != 0 || strcmp(field, \"real\") != 0) {\r\n   203\t        fclose(f);\r\n   204\t        die(\"only real coordinate matrices are supported\");\r\n   205\t    }\r\n   206\t\r\n   207\t    int symmetric;\r\n   208\t    if (strcmp(sym, \"symmetric\") == 0) symmetric = 1;\r\n"]
[5978.003238, "o", "   209\t    else if (strcmp(sym, \"general\") == 0) symmetric = 0;\r\n   210\t    else {\r\n   211\t        fclose(f);\r\n   212\t        die(\"only symmetric or general matrices are supported\");\r\n   213\t    }\r\n   214\t\r\n   215\t    while (fgets(line, sizeof(line), f)) {\r\n   216\t        char *p = line;\r\n   217\t        while (isspace((unsigned char)*p)) p++;\r\n   218\t        if (*p == '%') continue;\r\n   219\t        if (*p == '\\0') continue;\r\n   220\t        break;\r\n   221\t    }\r\n"]
[5978.003308, "o", "   222\t\r\n   223\t    int rows, cols, nnz;\r\n   224\t    if (sscanf(line, \"%d %d %d\", &rows, &cols, &nnz) != 3) {\r\n   225\t        fclose(f);\r\n   226\t        die(\"failed to read matrix dimensions\");\r\n   227\t    }\r\n"]
[5978.003378, "o", "   228\t    if (rows <= 0 || cols <= 0) {\r\n   229\t        fclose(f);\r\n   230\t        die(\"invalid matrix dimensions\");\r\n   231\t    }\r\n   232\t    if (rows != cols) {\r\n   233\t        fclose(f);\r\n   234\t        die(\"matrix must be square\");\r\n"]
[5978.003443, "o", "   235\t    }\r\n   236\t    if (nnz < 0) {\r\n   237\t        fclose(f);\r\n   238\t        die(\"invalid nnz\");\r\n   239\t    }\r\n   240\t\r\n   241\t    Entry *entries = NULL;\r\n   242\t    int count = 0, cap = 0;\r\n   243\t    for (int k = 0; k < nnz; k++) {\r\n   244\t        int r, c;\r\n   245\t        double v;\r\n   246\t        if (fscanf(f, \"%d %d %lf\", &r, &c, &v) != 3) {\r\n   247\t"]
