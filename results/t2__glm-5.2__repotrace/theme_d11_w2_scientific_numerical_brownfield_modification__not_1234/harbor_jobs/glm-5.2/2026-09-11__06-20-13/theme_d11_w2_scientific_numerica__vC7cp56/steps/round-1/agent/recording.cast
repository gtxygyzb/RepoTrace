[5341.094104, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path(\"nlsolve.c\")\ns = path.read_text()\n\nold = '''static void write_vector(const char *filename, int n, const double *x) {\n    FILE *f = stdout;\n    if (filename) {\n        f = fopen(filename, \"w\");\n        if (!f) die(\"cannot open output vector file\");\n    }\n\n    if (fprintf(f, \"%d\\\\n\", n) < 0) {\n        if (filename) fclose(f);\n        die(\"failed to write vector\");\n    }\n    for (int i = 0; i < n; i++) {\n        if (fprintf(f, \"%.15g\\\\n\", x[i]) < 0) {\n            if (filename) fclose(f);\n            die(\"failed to write vector\");\n        }\n    }\n\n    if (filename) fclose(f);\n}\n\nstatic int parse_int_arg(const char *s) {'''\nnew = '''static void write_vector(const char *filename, int n, const double *x) {\n    FILE *f = stdout;\n    if (filename) {\n        f = fopen(filename, \"w\");\n        if (!f) die(\"cannot open output vector file\");\n    }\n\n    if (fprintf(f, \"%d\\\\n\", n) < 0) {\n        if (filename) fclose(f);\n        die(\"failed to write vector\");\n    }\n    for"]
[5341.094325, "i", " (int i = 0; i < n; i++) {\n        if (fprintf(f, \"%.15g\\\\n\", x[i]) < 0) {\n            if (filename) fclose(f);\n            die(\"failed to write vector\");\n        }\n    }\n\n    if (filename) fclose(f);\n}\n\nstatic void write_zero_vector(const char *filename, int n) {\n    FILE *f = stdout;\n    if (filename) {\n        f = fopen(filename, \"w\");\n        if (!f) die(\"cannot open output vector file\");\n    }\n\n    if (fprintf(f, \"%d\\\\n\", n) < 0) {\n        if (filename) fclose(f);\n        die(\"failed to write vector\");\n    }\n    for (int i = 0; i < n; i++) {\n        if (fprintf(f, \"0.000000e+00\\\\n\") < 0) {\n            if (filename) fclose(f);\n            die(\"failed to write vector\");\n        }\n    }\n\n    if (filename) fclose(f);\n}\n\nstatic int parse_int_arg(const char *s) {'''\nif old not in s:\n    raise SystemExit(\"write_vector block not found\")\ns = s.replace(old, new, 1)\n\nold = '''        double *x = xcalloc((size_t)n, sizeof(double));\n        write_vector(output, n, x);\n        printf(\"iterations: 0\\\\n\");'''\nnew = ''' "]
[5341.09443, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[5341.09451, "i", "       double *x = xcalloc((size_t)n, sizeof(double));\n        write_zero_vector(output, n, x);\n        printf(\"iterations: 0\\\\n\");'''\nif old not in s:\n    raise SystemExit(\"zero RHS call not found\")\ns = s.replace(old, new, 1)\n\npath.write_text(s)\nprint(\"Patched zero-RHS vector output format\")\nPY\n"]
