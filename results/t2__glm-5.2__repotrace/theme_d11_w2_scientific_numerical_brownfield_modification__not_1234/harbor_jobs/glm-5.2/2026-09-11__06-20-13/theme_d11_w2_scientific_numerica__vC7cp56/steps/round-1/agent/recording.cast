[2640.820995, "o", "d_name, \"ssor\") == 0) precond = PRECOND_SSOR;\r\n\u001b[?2004l\r\u001b[?2004h>         else if (strcmp(precond_name, \"ic0\") == 0) precond = PRECOND_IC0;\r\n\u001b[?2004l\r\u001b[?2004h>         else die_unknown(\"preconditioner\", precond_name);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     int reorder = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     if (reorder_name) {\r\n\u001b[?2004l\r\u001b[?2004h>         if (strcmp(reorder_name, \"none\") == 0) reorder = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2640.8211, "o", "        else if (strcmp(reorder_name, \"rcm\") == 0) reorder = 1;\r\n\u001b[?2004l\r"]
[2640.821195, "o", "\u001b[?2004h> "]
