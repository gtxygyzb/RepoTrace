[6479.957083, "o", "\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[Kconst char *msg) {\r\n"]
[6479.957194, "o", "\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kfprintf(stderr\u001b[m\u001b[K, \"error: %s\\n\", msg);\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!p) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"out of memory\");\r\n"]
[6479.957265, "o", "\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!p) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"out of memory\");\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!*arr) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"out of memory\");\r\n"]
[6479.957335, "o", "\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open matrix file\");\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"empty matrix file\");\r\n\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix file is not Matrix Market format\");\r\n\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid Matrix Market header\");\r\n"]
[6479.957419, "o", "\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"only real coordinate matrices are supported\");\r\n\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"only symmetric or general matrices are supported\");\r\n\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read matrix dimensions\");\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid matrix dimensions\");\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix must be square\");\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid nnz\");\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read matrix entry\");\r\n"]
[6479.957493, "o", "\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix entry index out of range\");\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"extra trailing data in matrix file\");\r\n\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open rhs file\");\r\n\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read vector dimension\");\r\n\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid vector dimension\");\r\n\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to read vector entry\");\r\n"]
[6479.957567, "o", "\u001b[32m\u001b[K303\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"extra trailing data in vector file\");\r\n\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output matrix file\");\r\n\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%%%%MatrixMarket matrix coordinate real symmetric\\n\");\r\n\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%d %d %d\\n\", n, n, nnz);\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%d %d %.15g\\n\", entries[k].r + 1, entries[k].c + 1, entries[k].v);\r\n"]
[6479.957667, "o", "\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output rhs file\");\r\n\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%d\\n\", N);\r\n\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%.15g\\n\", sin((double)i * M_PI / (double)(N + 1)));\r\n"]
[6479.957771, "o", "\u001b[32m\u001b[K491\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"dimension: %d\\n\", m->n);\r\n\u001b[32m\u001b[K492\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"nonzeros: %d\\n\", m->nnz);\r\n"]
[6479.957842, "o", "\u001b[32m\u001b[K493\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"symmetric: %s\\n\", m->symmetric ? \"yes\" : \"no\");\r\n\u001b[32m\u001b[K494\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"bandwidth: %d\\n\", bandwidth);\r\n\u001b[32m\u001b[K495\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"profile: %ld\\n\", profile);\r\n\u001b[32m\u001b[K496\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"diag_dominant: %s\\n\", dominance);\r\n"]
[6479.957959, "o", "\u001b[32m\u001b[K817\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (diag[j] <= 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero or negative pivot in IC(0) factorization\");\r\n\u001b[32m\u001b[K823\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (sum <= 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero or negative pivot in IC(0) factorization\");\r\n"]
[6479.958073, "o", "\u001b[32m\u001b[K852\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in Jacobi preconditioner\");\r\n\u001b[32m\u001b[K855\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (omega <= 0.0 || omega >= 2.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid SSOR parameter\");\r\n"]
[6479.958141, "o", "\u001b[32m\u001b[K860\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!m->symmetric) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"IC(0) requires symmetric matrix\");\r\n\u001b[32m\u001b[K877\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (p->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero diagonal in Jacobi preconditioner\");\r\n\u001b[32m\u001b[K917\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (ic->diag[i] == 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"zero or negative pivot in IC(0) factorization\");\r\n\u001b[32m\u001b[K929\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"unknown preconditioner\");\r\n"]
[6479.958206, "o", "\u001b[32m\u001b[K969\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        double \u001b[01;31m\u001b[KpAp\u001b[m\u001b[K = dot(n, pvec, Ap);\r\n\u001b[32m\u001b[K970\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[KpAp\u001b[m\u001b[K <= 0.0) {\r\n\u001b[32m\u001b[K972\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix is not positive definite\");\r\n"]
[6479.958283, "o", "\u001b[32m\u001b[K974\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        double alpha = rz_old / \u001b[01;31m\u001b[KpAp\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K981\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n\u001b[32m\u001b[K989\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"CG numerical breakdown\");\r\n\u001b[32m\u001b[K1021\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n"]
[6479.95835, "o", "\u001b[32m\u001b[K1031\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K1040\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, s));\r\n"]
[6479.958423, "o", "\u001b[32m\u001b[K1049\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[Ktt ==\u001b[m\u001b[K 0.0) {\r\n\u001b[32m\u001b[K1051\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K1060\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n"]
[6479.958492, "o", "\u001b[32m\u001b[K1064\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        double \u001b[01;31m\u001b[Krho_new\u001b[m\u001b[K = dot(n, r0, r);\r\n\u001b[32m\u001b[K1065\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[Krho_new\u001b[m\u001b[K == 0.0) {\r\n\u001b[32m\u001b[K1067\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"BiCGSTAB numerical breakdown\");\r\n\u001b[32m\u001b[K1069\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        double beta = (\u001b[01;31m\u001b[Krho_new\u001b[m\u001b[K / rho_old) * (alpha / omega);\r\n\u001b[32m\u001b[K1071\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        rho_old = \u001b[01;31m\u001b[Krho_new\u001b[m\u001b[K;\r\n"]
[6479.958549, "o", "\u001b[32m\u001b[K1158\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"iteration %d residual %.6e\\n\", it_count, res);\r\n\u001b[32m\u001b[K1177\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"GMRES numerical breakdown\");\r\n"]
[6479.958621, "o", "\u001b[32m\u001b[K1199\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output vector file\");\r\n\u001b[32m\u001b[K1202\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%d\\n\", n) < 0) {\r\n\u001b[32m\u001b[K1204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%.15g\\n\", x[i]) < 0) {\r\n\u001b[32m\u001b[K1209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1220\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!f) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"cannot open output vector file\");\r\n"]
[6479.958696, "o", "\u001b[32m\u001b[K1223\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%d\\n\", n) < 0) {\r\n\u001b[32m\u001b[K1225\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n\u001b[32m\u001b[K1228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"0.000000e+00\\n\") < 0) {\r\n\u001b[32m\u001b[K1230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"failed to write vector\");\r\n"]
[6479.958768, "o", "\u001b[32m\u001b[K1238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!s || !*s) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument\");\r\n\u001b[32m\u001b[K1242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (errno != 0 || end == s || *end != '\\0') \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid integer argument\");\r\n\u001b[32m\u001b[K1243\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (val < INT_MIN || val > INT_MAX) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"integer argument out of range\");\r\n\u001b[32m\u001b[K1248\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!s || !*s) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument\");\r\n\u001b[32m\u001b[K1252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (errno != 0 || end == s || *end != '\\0') \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid numeric argument\");\r\n\u001b[32m\u001b[K1258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    sn\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kmsg, sizeof(msg), \"unknown %s: %s\", kind, value);\r\n\u001b[32m\u001b[K1259\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[Kmsg);\r\n"]
[6479.958838, "o", "\u001b[32m\u001b[K1283\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --input\");\r\n\u001b[32m\u001b[K1286\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --rhs\");\r\n\u001b[32m\u001b[K1289\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing solver name\");\r\n\u001b[32m\u001b[K1292\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing preconditioner name\");\r\n\u001b[32m\u001b[K1295\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing reordering name\");\r\n\u001b[32m\u001b[K1298\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --output\");\r\n"]
[6479.958909, "o", "\u001b[32m\u001b[K1305\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --generate-laplacian\");\r\n\u001b[32m\u001b[K1308\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --generate-laplacian3d\");\r\n\u001b[32m\u001b[K1311\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --generate-rhs\");\r\n\u001b[32m\u001b[K1314\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for max iterations\");\r\n\u001b[32m\u001b[K1317\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for tolerance\");\r\n\u001b[32m\u001b[K1320\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for omega\");\r\n"]
[6479.958979, "o", "\u001b[32m\u001b[K1323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (++i >= argc) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing argument for --restart\");\r\n\u001b[32m\u001b[K1328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            sn\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kmsg, sizeof(msg), \"unknown option: %s\", arg);\r\n\u001b[32m\u001b[K1329\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[Kmsg);\r\n\u001b[32m\u001b[K1334\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (restart < 1) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid restart value\");\r\n\u001b[32m\u001b[K1335\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!(solver_name && strcmp(solver_name, \"gmres\") == 0)) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"--restart requires --solver gmres\");\r\n\u001b[32m\u001b[K1344\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (modes == 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"no operation specified\");\r\n"]
[6479.959049, "o", "\u001b[32m\u001b[K1345\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (modes > 1) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting operation modes specified\");\r\n\u001b[32m\u001b[K1349\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting command-line arguments\");\r\n\u001b[32m\u001b[K1351\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!output) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing output file for generator\");\r\n\u001b[32m\u001b[K1355\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1357\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N > INT_MAX / 3) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"generator size too large\");\r\n\u001b[32m\u001b[K1361\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (n <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n"]
[6479.959121, "o", "\u001b[32m\u001b[K1363\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N > INT_MAX / 4) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"generator size too large\");\r\n\u001b[32m\u001b[K1367\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if (N <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid generator size\");\r\n\u001b[32m\u001b[K1374\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!input) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing input file for analyze\");\r\n\u001b[32m\u001b[K1376\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"conflicting command-line arguments\");\r\n\u001b[32m\u001b[K1384\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!input) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing input file for solver\");\r\n\u001b[32m\u001b[K1385\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!rhs) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing rhs file for solver\");\r\n\u001b[32m\u001b[K1386\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!solver_name) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"missing solver name\");\r\n"]
[6479.959218, "o", "\u001b[32m\u001b[K1410\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (max_it <= 0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid max iterations\");\r\n\u001b[32m\u001b[K1411\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (tol < 0.0) \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"invalid tolerance\");\r\n"]
[6479.959289, "o", "\u001b[32m\u001b[K1419\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdie(\u001b[m\u001b[K\"matrix and RHS dimensions do not match\");\r\n\u001b[32m\u001b[K1426\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"iterations: 0\\n\");\r\n\u001b[32m\u001b[K1427\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"residual_norm: 0.000000e+00\\n\");\r\n\u001b[32m\u001b[K1428\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"converged: yes\\n\");\r\n\u001b[32m\u001b[K1470\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"iterations: %d\\n\", iterations);\r\n\u001b[32m\u001b[K1471\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"residual_norm: %.6e\\n\", true_res);\r\n"]
[6479.959356, "o", "\u001b[32m\u001b[K1472\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"converged: %s\\n\", (true_res <= tol) ? \"yes\" : \"no\");\r\n"]
[6479.959865, "o", "\u001b[?2004h"]
[6479.959937, "o", "root@n30009:/app# "]
[6480.220153, "i", "sed -n '1262,1479p' nlsolve.c\n"]
[6480.220423, "o", "sed -n '1262,1479p' nlsolve.c\r\n\u001b[?2004l\r"]
[6480.223674, "o", "int main(int argc, char **argv) {\r\n    const char *input = NULL;\r\n    const char *rhs = NULL;\r\n    const char *solver_name = NULL;\r\n    const char *precond_name = NULL;\r\n    const char *reorder_name = NULL;\r\n    const char *output = NULL;\r\n    const char *gen2d = NULL;\r\n    const char *gen3d = NULL;\r\n"]
[6480.223783, "o", "    const char *genrhs = NULL;\r\n    int analyze = 0;\r\n    int history = 0;\r\n    int max_it = 1000;\r\n    double tol = 1e-8;\r\n    double omega = 1.0;\r\n    int restart = 30;\r\n    int restart_given = 0;\r\n\r\n    for (int i = 1; i < argc; i++) {\r\n        const char *arg = argv[i];\r\n        if (strcmp(arg, \"--input\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --input\");\r\n            input = argv[i];\r\n        } else if (strcmp(arg, \"--rhs\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --rhs\");\r\n            rhs = argv[i];\r\n        } else if (strcmp(arg, \"--solver\") == 0) {\r\n            if (++i >= argc) die(\"missing solver name\");\r\n            solver_name = argv[i];\r\n        } else if (strcmp(arg, \"--precond\") == 0) {\r\n            if (++i >= argc) die(\"missing preconditioner name\");\r\n            precond_name = argv[i];\r\n        } else if (strcmp(arg, \"--reorder\") == 0) {\r\n            if (++i >= argc) die(\"missing reordering name\");\r\n            reorder_name = argv[i];\r\n        } e"]
[6480.223889, "o", "lse if (strcmp(arg, \"--output\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --output\");\r\n            output = argv[i];\r\n        } else if (strcmp(arg, \"--analyze\") == 0) {\r\n            analyze = 1;\r\n        } else if (strcmp(arg, \"--history\") == 0) {\r\n            history = 1;\r\n        } else if (strcmp(arg, \"--generate-laplacian\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --generate-laplacian\");\r\n            gen2d = argv[i];\r\n        } else if (strcmp(arg, \"--generate-laplacian3d\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --generate-laplacian3d\");\r\n            gen3d = argv[i];\r\n        } else if (strcmp(arg, \"--generate-rhs\") == 0) {\r\n"]
[6480.223971, "o", "            if (++i >= argc) die(\"missing argument for --generate-rhs\");\r\n            genrhs = argv[i];\r\n        } else if (strcmp(arg, \"--max-it\") == 0 || strcmp(arg, \"--max-iter\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for max iterations\");\r\n            max_it = parse_int_arg(argv[i]);\r\n        } else if (strcmp(arg, \"--tol\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for tolerance\");\r\n            tol = parse_double_arg(argv[i]);\r\n        } else if (strcmp(arg, \"--omega\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for omega\");\r\n            omega = parse_double_arg(argv[i]);\r\n        } else if (strcmp(arg, \"--restart\") == 0) {\r\n            if (++i >= argc) die(\"missing argument for --restart\");\r\n            restart = parse_int_arg(argv[i]);\r\n            restart_given = 1;\r\n        } else {\r\n            char msg[256];\r\n            snprintf(msg, sizeof(msg), \"unknown option: %s\", arg);\r\n            die(msg);\r\n        }\r\n    }\r\n\r\n"]
[6480.224043, "o", "    if (restart_given) {\r\n        if (restart < 1) die(\"invalid restart value\");\r\n        if (!(solver_name && strcmp(solver_name, \"gmres\") == 0)) die(\"--restart requires --solver gmres\");\r\n    }\r\n\r\n    int modes = 0;\r\n    if (analyze) modes++;\r\n    if (solver_name) modes++;\r\n    if (gen2d) modes++;\r\n    if (gen3d) modes++;\r\n    if (genrhs) modes++;\r\n    if (modes == 0) die(\"no operation specified\");\r\n    if (modes > 1) die(\"conflicting operation modes specified\");\r\n"]
[6480.224117, "o", "\r\n    if (gen2d || gen3d || genrhs) {\r\n        if (input || rhs || solver_name || precond_name || reorder_name) {\r\n            die(\"conflicting command-line arguments\");\r\n        }\r\n        if (!output) die(\"missing output file for generator\");\r\n\r\n        if (gen2d) {\r\n            int n = parse_int_arg(gen2d);\r\n            if (n <= 0) die(\"invalid generator size\");\r\n            long N = (long)n * (long)n;\r\n            if (N > INT_MAX / 3) die(\"generator size too large\");\r\n            generate_laplacian2d(n, output);\r\n        } else if (gen3d) {\r\n            int n = parse_int_arg(gen3d);\r\n            if (n <= 0) die(\"invalid generator size\");\r\n            long N = (long)n * (long)n * (long)n;\r\n"]
[6480.224195, "o", "            if (N > INT_MAX / 4) die(\"generator size too large\");\r\n            generate_laplacian3d(n, output);\r\n        } else {\r\n            int N = parse_int_arg(genrhs);\r\n            if (N <= 0) die(\"invalid generator size\");\r\n            generate_rhs(N, output);\r\n        }\r\n        return 0;\r\n    }\r\n\r\n    if (analyze) {\r\n        if (!input) die(\"missing input file for analyze\");\r\n        if (rhs || solver_name || precond_name || reorder_name || output) {\r\n            die(\"conflicting command-line arguments\");\r\n        }\r\n"]
[6480.224267, "o", "        CSRMatrix *m = read_matrix(input);\r\n        analyze_matrix(m);\r\n        free_csr(m);\r\n        return 0;\r\n    }\r\n\r\n    if (!input) die(\"missing input file for solver\");\r\n    if (!rhs) die(\"missing rhs file for solver\");\r\n    if (!solver_name) die(\"missing solver name\");\r\n\r\n    int solver;\r\n    if (strcmp(solver_name, \"cg\") == 0) solver = SOLVER_CG;\r\n    else if (strcmp(solver_name, \"bicgstab\") == 0) solver = SOLVER_BICGSTAB;\r\n    else if (strcmp(solver_name, \"gmres\") == 0) solver = SOLVER_GMRES;\r\n"]
[6480.224336, "o", "    else die_unknown(\"solver\", solver_name);\r\n\r\n    int precond = PRECOND_NONE;\r\n    if (precond_name) {\r\n        if (strcmp(precond_name, \"none\") == 0) precond = PRECOND_NONE;\r\n        else if (strcmp(precond_name, \"jacobi\") == 0) precond = PRECOND_JACOBI;\r\n        else if (strcmp(precond_name, \"ssor\") == 0) precond = PRECOND_SSOR;\r\n        else if (strcmp(precond_name, \"ic0\") == 0) precond = PRECOND_IC0;\r\n        else die_unknown(\"preconditioner\", precond_name);\r\n    }\r\n\r\n    int reorder = 0;\r\n"]
[6480.224409, "o", "    if (reorder_name) {\r\n        if (strcmp(reorder_name, \"none\") == 0) reorder = 0;\r\n        else if (strcmp(reorder_name, \"rcm\") == 0) reorder = 1;\r\n        else die_unknown(\"reordering\", reorder_name);\r\n    }\r\n\r\n    if (max_it <= 0) die(\"invalid max iterations\");\r\n    if (tol < 0.0) die(\"invalid tolerance\");\r\n\r\n    CSRMatrix *m = read_matrix(input);\r\n    int rhs_n;\r\n    double *b = read_vector(rhs, &rhs_n);\r\n    if (m->n != rhs_n) {\r\n"]
[6480.224481, "o", "        free_csr(m);\r\n        free(b);\r\n        die(\"matrix and RHS dimensions do not match\");\r\n    }\r\n\r\n    int n = m->n;\r\n\r\n    if (vec_norm2(n, b) == 0.0) {\r\n        write_zero_vector(output, n);\r\n        printf(\"iterations: 0\\n\");\r\n        printf(\"residual_norm: 0.000000e+00\\n\");\r\n        printf(\"converged: yes\\n\");\r\n"]
[6480.224551, "o", "        free_csr(m);\r\n        free(b);\r\n        return 0;\r\n    }\r\n\r\n    CSRMatrix *A = m;\r\n    double *bwork = b;\r\n    int *perm = NULL;\r\n\r\n    if (reorder) {\r\n        perm = xmalloc((size_t)n * sizeof(int));\r\n        rcm_ordering(m, perm);\r\n        A = permute_csr(m, perm);\r\n        bwork = xmalloc((size_t)n * sizeof(double));\r\n        for (int i = 0; i < n; i++) bwork[perm[i]] = b[i];\r\n        free_csr(m);\r\n"]
[6480.224626, "o", "        m = A;\r\n    }\r\n\r\n    Precond *p = precond_setup(A, precond, omega);\r\n    int iterations = 0;\r\n    double *x2;\r\n    if (solver == SOLVER_CG) x2 = solve_cg(A, bwork, p, max_it, tol, history, &iterations);\r\n    else if (solver == SOLVER_BICGSTAB) x2 = solve_bicgstab(A, bwork, p, max_it, tol, history, &iterations);\r\n    else x2 = solve_gmres(A, bwork, p, max_it, tol, history, restart, &iterations);\r\n\r\n    double true_res = compute_true_residual(A, bwork, x2);\r\n\r\n    double *x;\r\n    if (perm) {\r\n"]
[6480.224713, "o", "        x = xmalloc((size_t)n * sizeof(double));\r\n        for (int i = 0; i < n; i++) x[i] = x2[perm[i]];\r\n        free(x2);\r\n        free(bwork);\r\n        free(perm);\r\n    } else {\r\n        x = x2;\r\n    }\r\n\r\n    write_vector(output, n, x);\r\n\r\n    printf(\"iterations: %d\\n\", iterations);\r\n    printf(\"residual_norm: %.6e\\n\", true_res);\r\n    printf(\"converged: %s\\n\", (true_res <= tol) ? \"yes\" : \"no\");\r\n\r\n    free(x);\r\n    free_precond(p);\r\n"]
[6480.224779, "o", "    free_csr(A);\r\n    free(b);\r\n    return 0;\r\n}\r\n"]
[6480.225221, "o", "\u001b[?2004h"]
[6480.225289, "o", "root@n30009:/app# "]
[6519.227986, "i", "grep -n \"printf(\\|write_vector\\|fputs\\|fputc\" nlsolve.c\n"]
[6519.228418, "o", "grep -n \"printf(\\|write_vector\\|fputs\\|fputc\" nlsolve.c\r\n"]
[6519.22852, "o", "\u001b[?2004l\r"]
[6519.231511, "o", "\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kstderr, \"error: %s\\n\", msg);\r\n"]
[6519.231628, "o", "\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%%%%MatrixMarket matrix coordinate real symmetric\\n\");\r\n\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%d %d %d\\n\", n, n, nnz);\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%d %d %.15g\\n\", entries[k].r + 1, entries[k].c + 1, entries[k].v);\r\n"]
[6519.231739, "o", "\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%d\\n\", N);\r\n\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%.15g\\n\", sin((double)i * M_PI / (double)(N + 1)));\r\n\u001b[32m\u001b[K491\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"dimension: %d\\n\", m->n);\r\n\u001b[32m\u001b[K492\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"nonzeros: %d\\n\", m->nnz);\r\n"]
[6519.231817, "o", "\u001b[32m\u001b[K493\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"symmetric: %s\\n\", m->symmetric ? \"yes\" : \"no\");\r\n\u001b[32m\u001b[K494\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"bandwidth: %d\\n\", bandwidth);\r\n\u001b[32m\u001b[K495\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"profile: %ld\\n\", profile);\r\n\u001b[32m\u001b[K496\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"diag_dominant: %s\\n\", dominance);\r\n"]
[6519.231937, "o", "\u001b[32m\u001b[K981\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n"]
[6519.232008, "o", "\u001b[32m\u001b[K1040\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, s));\r\n\u001b[32m\u001b[K1060\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n\u001b[32m\u001b[K1158\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"iteration %d residual %.6e\\n\", it_count, res);\r\n"]
[6519.232111, "o", "\u001b[32m\u001b[K1195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void \u001b[01;31m\u001b[Kwrite_vector\u001b[m\u001b[K(const char *filename, int n, const double *x) {\r\n\u001b[32m\u001b[K1202\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%d\\n\", n) < 0) {\r\n"]
[6519.232181, "o", "\u001b[32m\u001b[K1207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%.15g\\n\", x[i]) < 0) {\r\n\u001b[32m\u001b[K1223\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"%d\\n\", n) < 0) {\r\n\u001b[32m\u001b[K1228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (f\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kf, \"0.000000e+00\\n\") < 0) {\r\n\u001b[32m\u001b[K1258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    sn\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kmsg, sizeof(msg), \"unknown %s: %s\", kind, value);\r\n"]
[6519.23225, "o", "\u001b[32m\u001b[K1328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            sn\u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[Kmsg, sizeof(msg), \"unknown option: %s\", arg);\r\n\u001b[32m\u001b[K1426\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"iterations: 0\\n\");\r\n\u001b[32m\u001b[K1427\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"residual_norm: 0.000000e+00\\n\");\r\n\u001b[32m\u001b[K1428\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"converged: yes\\n\");\r\n"]
[6519.232325, "o", "\u001b[32m\u001b[K1468\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kwrite_vector\u001b[m\u001b[K(output, n, x);\r\n\u001b[32m\u001b[K1470\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"iterations: %d\\n\", iterations);\r\n\u001b[32m\u001b[K1471\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"residual_norm: %.6e\\n\", true_res);\r\n\u001b[32m\u001b[K1472\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kprintf(\u001b[m\u001b[K\"converged: %s\\n\", (true_res <= tol) ? \"yes\" : \"no\");\r\n"]
[6519.232805, "o", "\u001b[?2004h"]
