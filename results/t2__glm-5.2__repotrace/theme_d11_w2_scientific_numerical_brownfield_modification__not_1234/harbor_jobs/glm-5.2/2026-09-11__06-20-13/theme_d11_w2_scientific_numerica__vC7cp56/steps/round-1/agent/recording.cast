[5493.831864, "o", "   576\t    int *visited = xcalloc((size_t)n, sizeof(int));\r\n   577\t    int *order = xmalloc((size_t)n * sizeof(int));\r\n   578\t    int order_count = 0;\r\n   579\t    int *queue = xmalloc((size_t)n * sizeof(int));\r\n"]
[5493.831936, "o", "   580\t    int qhead = 0, qtail = 0;\r\n   581\t\r\n   582\t    while (order_count < n) {\r\n   583\t        int start = -1;\r\n   584\t        for (int i = 0; i < n; i++) {\r\n   585\t            if (!visited[i]) {\r\n   586\t                if (start == -1 || degree[i] < degree[start] ||\r\n   587\t                    (degree[i] == degree[start] && i < start)) {\r\n   588\t                    start = i;\r\n   589\t                }\r\n   590\t            }\r\n"]
[5493.832005, "o", "   591\t        }\r\n   592\t        if (start == -1) break;\r\n   593\t        visited[start] = 1;\r\n   594\t        queue[qtail++] = start;\r\n   595\t        while (qhead < qtail) {\r\n   596\t            int v = queue[qhead++];\r\n   597\t            order[order_count++] = v;"]
[5493.832072, "o", "\r\n   598\t            int base = adj_ptr[v];\r\n   599\t            int deg = adj_ptr[v + 1] - base;\r\n   600\t            int *nbrs = xmalloc((size_t)(deg ? deg : 1) * sizeof(int));\r\n   601\t            int cnt = 0;\r\n   602\t            for (int idx = 0; idx < deg; idx++) {\r\n   603\t                int u = adj[base + idx];\r\n"]
[5493.832132, "o", "   604\t                if (!visited[u]) nbrs[cnt++] = u;\r\n   605\t            }\r\n   606\t            // deterministic sort by degree then original index\r\n   607\t            for (int a = 1; a < cnt; a++) {\r\n   608\t                int key = nbrs[a];\r\n   609\t                int b = a - 1;\r\n"]
[5493.832193, "o", "   610\t                while (b >= 0) {\r\n   611\t                    if (degree[nbrs[b]] < degree[key] ||\r\n   612\t                        (degree[nbrs[b]] == degree[key] && nbrs[b] < key)) break;\r\n   613\t                    nbrs[b + 1] = nbrs[b];\r\n   614\t                    b--;\r\n   615\t                }\r\n"]
[5493.832261, "o", "   616\t                nbrs[b + 1] = key;\r\n   617\t            }\r\n   618\t            for (int idx = 0; idx < cnt; idx++) {\r\n   619\t                int u = nbrs[idx];\r\n   620\t                if (!visited[u]) {\r\n   621\t                    visited[u] = 1;\r\n   622\t                    queue[qtail++] = u;\r\n"]
[5493.832318, "o", "   623\t                }\r\n   624\t            }\r\n   625\t            free(nbrs);\r\n   626\t        }\r\n   627\t    }\r\n"]
[5493.832377, "o", "   628\t\r\n   629\t    for (int i = 0; i < n; i++) perm[order[n - 1 - i]] = i;\r\n   630\t\r\n   631\t    free(adj_ptr);\r\n   632\t    free(adj_count);\r\n   633\t    free(adj);\r\n"]
[5493.832433, "o", "   634\t    free(degree);\r\n   635\t    free(visited);\r\n   636\t    free(order);\r\n   637\t    free(queue);\r\n   638\t}\r\n   639\t"]
