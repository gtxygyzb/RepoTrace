[5493.556524, "o", "\r\n   556\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   557\t            int j = m->col_idx[idx];\r\n   558\t            if (j != i) adj[row_ptr[i] + next[i]++] = j;\r\n   559\t        }\r\n   560\t    }\r\n   561\t    free(next);\r\n   562\t    free(degree);\r\n   563\t    *adj_ptr = row_ptr;\r\n   564\t    *adj_count = xcalloc((size_t)n, sizeof(int));\r\n   565\t    *adj_data = adj;\r\n   566\t}\r\n   567\t\r\n   568\tstatic void rcm_ordering(const CSRMatrix *m, int *perm) {\r\n   569\t    int n = m->n;\r\n   570\t    int *adj_ptr, *adj_count, *adj;\r\n   571\t    build_adjacency(m, &adj_ptr, &adj_count, &adj);\r\n   572\t\r\n   573\t    int *degree = xcalloc((size_t)n, sizeof(int));\r\n   574\t    for (int i = 0; i < n; i++) degree[i] = adj_ptr[i + 1] - adj_ptr[i];\r\n"]
