[3663.862723, "o", "sed -n '1,180p' nlsolve.c\r\n\u001b[?2004l\r"]
[3663.865722, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <math.h>\r\n#include <ctype.h>\r\n#include <errno.h>\r\n#include <limits.h>\r\n\r\n"]
[3663.865826, "o", "#ifndef M_PI\r\n#define M_PI 3.14159265358979323846\r\n#endif\r\n\r\n#define SOLVER_CG 0\r\n#define SOLVER_BICGSTAB 1\r\n\r\n#define PRECOND_NONE 0\r\n#define PRECOND_JACOBI 1\r\n#define PRECOND_SSOR 2\r\n#define PRECOND_IC0 3\r\n\r\ntypedef struct {\r\n    int n;\r\n    int nnz;\r\n    int *row_ptr;\r\n    int *col_idx;\r\n    double *vals;\r\n    int symmetric;\r\n} CSRMatrix;\r\n\r\ntypedef struct {\r\n"]
[3663.865915, "o", "    int r;\r\n    int c;\r\n    double v;\r\n} Entry;\r\n\r\ntypedef struct {\r\n    int n;\r\n"]
[3663.865989, "o", "    int *row_ptr;\r\n    int *col_idx;\r\n    double *vals;\r\n} TriMatrix;\r\n\r\ntypedef struct {\r\n    int n;\r\n    int *l_row_ptr;\r\n    int *l_col_idx;\r\n    double *l_vals;\r\n    double *diag;\r\n    int *u_row_ptr;\r\n    int *u_col_idx;\r\n    double *u_vals;\r\n} ICFactor;\r\n\r\ntypedef struct {\r\n    int type;\r\n    CSRMatrix *A;\r\n    double *diag;\r\n    TriMatrix *lower;\r\n    TriMatrix *upper;\r\n    double omega;\r\n    ICFactor *ic;\r\n} Precond;\r\n\r\nstatic void die(const char *msg) {\r\n    fprintf(stderr, \"error: %s\\n\", msg);\r\n"]
[3663.866062, "o", "    exit(1);\r\n}\r\n\r\nstatic void *xmalloc(size_t s) {\r\n    if (s == 0) s = 1;\r\n    void *p = malloc(s);\r\n    if (!p) die(\"out of memory\");\r\n    return p;\r\n}\r\n\r\nstatic void *xcalloc(size_t n, size_t s) {\r\n    if (n == 0) n = 1;\r\n    void *p = calloc(n, s);\r\n    if (!p) die(\"out of memory\");\r\n"]
[3663.866135, "o", "    return p;\r\n}\r\n\r\nstatic double dot(int n, const double *a, const double *b) {\r\n    double s = 0.0;\r\n    for (int i = 0; i < n; i++) s += a[i] * b[i];\r\n    return s;\r\n}\r\n\r\nstatic void dcopy(int n, const double *src, double *dst) {\r\n    for (int i = 0; i < n; i++) dst[i] = src[i];\r\n}\r\n\r\nstatic int cmp_entry(const void *a, const void *b) {"]
[3663.866205, "o", "\r\n    const Entry *ea = (const Entry *)a;\r\n    const Entry *eb = (const Entry *)b;\r\n    if (ea->r != eb->r) return ea->r - eb->r;\r\n    return ea->c - eb->c;\r\n}\r\n\r\nstatic void add_entry(Entry **arr, int *count, int *cap, int r, int c, double v) {\r\n    if (*count == *cap) {\r\n        *cap = (*cap ? *cap * 2 : 16);\r\n        *arr = realloc(*arr, (size_t)*cap * sizeof(Entry));\r\n        if (!*arr) die(\"out of memory\");\r\n"]
[3663.866281, "o", "    }\r\n    (*arr)[*count].r = r;\r\n    (*arr)[*count].c = c;\r\n    (*arr)[*count].v = v;\r\n    (*count)++;\r\n}\r\n\r\nstatic CSRMatrix *build_csr(int n, Entry *entries, int count, int symmetric) {\r\n    if (count > 0) qsort(entries, (size_t)count, sizeof(Entry), cmp_entry);\r\n"]
[3663.866363, "o", "\r\n    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n    int *tmp_count = xcalloc((size_t)n, sizeof(int));\r\n\r\n    int unique = 0;\r\n    for (int i = 0; i < count; ) {\r\n        int r = entries[i].r;\r\n        int c = entries[i].c;\r\n        double sum = 0.0;\r\n        while (i < count && entries[i].r == r && entries[i].c == c) {\r\n            sum += entries[i].v;\r\n            i++;\r\n        }\r\n        entries[unique].r = r;\r\n        entries[unique].c = c;\r\n        entries[unique].v = sum;\r\n        unique++;\r\n        tmp_count[r]++;\r\n    }\r\n\r\n    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + tmp_count[i];\r\n    free(tmp_count);\r\n\r\n    int *col_idx = xmalloc((size_t)unique * sizeof(int));\r\n    double *vals = xmalloc((size_t)unique * sizeof(double));\r\n"]
[3663.866452, "o", "    int *next = xcalloc((size_t)n, sizeof(int));\r\n\r\n    for (int i = 0; i < unique; i++) {\r\n        int r = entries[i].r;\r\n        int pos = row_ptr[r] + next[r]++;\r\n        col_idx[pos] = entries[i].c;\r\n        vals[pos] = entries[i].v;\r\n"]
[3663.866522, "o", "    }\r\n    free(next);\r\n\r\n    CSRMatrix *m = xmalloc(sizeof(CSRMatrix));\r\n    m->n = n;\r\n    m->nnz = unique;\r\n    m->row_ptr = row_ptr;\r\n    m->col_idx = col_idx;\r\n    m->vals = vals;\r\n    m->symmetric = symmetric;\r\n    return m;\r\n}\r\n\r\nstatic double *compute_diag(CSRMatrix *m) {\r\n    double *diag = xcalloc((size_t)m->n, sizeof(double));\r\n    for (int i = 0; i < m->n; i++) {\r\n        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n            if (m->col_idx[idx] == i) diag[i] += m->vals[idx];\r\n        }\r\n    }\r\n    return diag;\r\n}\r\n\r\nstatic int has_trailing_data(FILE *f) {\r\n"]
[3663.866589, "o", "    int c;\r\n    while ((c = fgetc(f)) != EOF) {\r\n        if (isspace((unsigned char)c)) continue;\r\n        if (c == '%') {\r\n            while ((c = fgetc(f)) != EOF && c != '\\n');\r\n            continue;\r\n        }\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n"]
[3663.867277, "o", "\u001b[?2004h"]
[3663.867343, "o", "root@n30009:/app# "]
[3664.119263, "i", "sed -n '180,300p' nlsolve.c\n"]
[3664.119524, "o", "sed -n '180,300p' nlsolve.c\r\n\u001b[?2004l\r"]
[3664.12287, "o", "}\r\n\r\nstatic CSRMatrix *read_matrix(const char *filename) {\r\n    FILE *f = fopen(filename, \"r\");\r\n    if (!f) die(\"cannot open matrix file\");\r\n\r\n    char line[1024];\r\n"]
[3664.122957, "o", "    if (!fgets(line, sizeof(line), f)) {\r\n        fclose(f);\r\n        die(\"empty matrix file\");\r\n    }\r\n    if (strncmp(line, \"%%MatrixMarket\", 14) != 0) {\r\n        fclose(f);\r\n        die(\"matrix file is not Matrix Market format\");\r\n    }\r\n\r\n    char obj[64], fmt[64], field[64], sym[64];\r\n    if (sscanf(line, \"%*s %63s %63s %63s %63s\", obj, fmt, field, sym) != 4) {\r\n        fclose(f);\r\n        die(\"invalid Matrix Market header\");\r\n    }\r\n    if (strcmp(obj, \"matrix\") != 0 || strcmp(fmt, \"coordinate\") != 0 || strcmp(field, \"real\") != 0) {\r\n        fclose(f);\r\n        die(\"only real coordinate matrices are supported\");\r\n"]
[3664.123054, "o", "    }\r\n\r\n    int symmetric;\r\n    if (strcmp(sym, \"symmetric\") == 0) symmetric = 1;\r\n    else if (strcmp(sym, \"general\") == 0) symmetric = 0;\r\n    else {\r\n        fclose(f);\r\n        die(\"only symmetric or general matrices are supported\");\r\n    }\r\n\r\n    while (fgets(line, sizeof(line), f)) {\r\n        char *p = line;\r\n"]
[3664.123126, "o", "        while (isspace((unsigned char)*p)) p++;\r\n        if (*p == '%') continue;\r\n        if (*p == '\\0') continue;\r\n        break;\r\n    }\r\n\r\n    int rows, cols, nnz;\r\n    if (sscanf(line, \"%d %d %d\", &rows, &cols, &nnz) != 3) {\r\n        fclose(f);\r\n        die(\"failed to read matrix dimensions\");\r\n    }\r\n    if (rows <= 0 || cols <= 0) {\r\n        fclose(f);\r\n        die(\"invalid matrix dimensions\");\r\n    }\r\n    if (rows != cols) {\r\n        fclose(f);\r\n        die(\"matrix must be square\");\r\n    }\r\n    if (nnz < 0) {\r\n        fclose(f);\r\n        die(\"invalid nnz\");\r\n    }\r\n\r\n    Entry *entries = NULL;\r\n    int count = 0, cap = 0;\r\n    for (int k = 0; k < nnz; k++) {\r\n"]
[3664.123194, "o", "        int r, c;\r\n        double v;\r\n        if (fscanf(f, \"%d %d %lf\", &r, &c, &v) != 3) {\r\n            fclose(f);\r\n            free(entries);\r\n            die(\"failed to read matrix entry\");\r\n        }\r\n        if (r < 1 || r > rows || c < 1 || c > cols) {\r\n            fclose(f);\r\n            free(entries);\r\n            die(\"matrix entry index out of range\");\r\n        }\r\n        r--;\r\n        c--;\r\n        if (symmetric) {\r\n"]
[3664.123264, "o", "            if (r < c) {\r\n                int t = r; r = c; c = t;\r\n            }\r\n            add_entry(&entries, &count, &cap, r, c, v);\r\n            if (r != c) add_entry(&entries, &count, &cap, c, r, v);\r\n        } else {\r\n            add_entry(&entries, &count, &cap, r, c, v);\r\n        }\r\n    }\r\n\r\n    if (has_trailing_data(f)) {\r\n        free(entries);\r\n        fclose(f);\r\n"]
[3664.123334, "o", "        die(\"extra trailing data in matrix file\");\r\n    }\r\n\r\n    fclose(f);\r\n\r\n    CSRMatrix *m = build_csr(rows, entries, count, symmetric);\r\n    free(entries);\r\n    return m;\r\n}\r\n\r\nstatic double *read_vector(const char *filename, int *n_out) {\r\n    FILE *f = fopen(filename, \"r\");\r\n    if (!f) die(\"cannot open rhs file\");\r\n    int n;\r\n    if (fscanf(f, \"%d\", &n) != 1) {\r\n        fclose(f);\r\n        die(\"failed to read vector dimension\");\r\n    }\r\n    if (n <= 0) die(\"invalid vector dimension\");\r\n"]
[3664.123421, "o", "    double *x = xmalloc((size_t)n * sizeof(double));\r\n    for (int i = 0; i < n; i++) {\r\n        if (fscanf(f, \"%lf\", &x[i]) != 1) {\r\n            fclose(f);\r\n            free(x);\r\n            die(\"failed to read vector entry\");\r\n        }\r\n    }\r\n\r\n    if (has_trailing_data(f)) {\r\n        fclose(f);\r\n"]
[3664.124075, "o", "\u001b[?2004h"]
