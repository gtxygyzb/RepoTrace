[5515.876859, "o", "   714\tstatic ICFactor *ic0_factorize(const CSRMatrix *m) {\r\n   715\t    int n = m->n;\r\n   716\t    int *row_ptr = xcalloc((size_t)n + 1, sizeof(int));\r\n   717\t    for (int i = 0; i < n; i++) {\r\n   718\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n"]
[5515.877011, "o", "   719\t            if (m->col_idx[idx] < i) row_ptr[i + 1]++;\r\n   720\t        }\r\n   721\t    }\r\n   722\t    for (int i = 0; i < n; i++) row_ptr[i + 1] += row_ptr[i];\r\n   723\t\r\n   724\t    int *col_idx = xmalloc((size_t)row_ptr[n] * sizeof(int));\r\n   725\t    double *vals = xmalloc((size_t)row_ptr[n] * sizeof(double));\r\n   726\t    int *next = xcalloc((size_t)n, sizeof(int));\r\n   727\t    for (int i = 0; i < n; i++) {\r\n   728\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   729\t            int j = m->col_idx[idx];\r\n   730\t            if (j < i) col_idx[row_ptr[i] + next[i]++] = j;\r\n   731\t        }\r\n   732\t    }\r\n   733\t    free(next);\r\n   734\t\r\n   735\t    double *diag = xmalloc((size_t)n * sizeof(double));\r\n   736\t    for (int i = 0; i < n; i++) {\r\n   737\t        double aii = 0.0;\r\n   738\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   739\t            if (m->col_idx[idx] == i) aii += m->vals[idx];\r\n   740\t"]
[5515.877095, "o", "        }\r\n   741\t\r\n   742\t        double sum = aii;\r\n   743\t        for (int k = row_ptr[i]; k < row_ptr[i + 1]; k++) {\r\n   744\t            int j = col_idx[k];\r\n   745\t            double aij = 0.0;\r\n   746\t            for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   747\t                if (m->col_idx[idx] == j) {\r\n   748\t                    aij += m->vals[idx];\r\n   749\t                    break;\r\n   750\t                }\r\n   751\t            }\r\n   752\t"]
[5515.877161, "o", "\r\n   753\t            double s = aij;\r\n   754\t            int pi = row_ptr[i];\r\n   755\t            int pj = row_ptr[j];\r\n   756\t            while (pi < k && pj < row_ptr[j + 1]) {\r\n   757\t                int ci = col_idx[pi];\r\n   758\t                int cj = col_idx[pj];\r\n   759\t                if (ci == cj) {\r\n   760\t                    s -= vals[pi] * vals[pj];\r\n"]
