[6433.554244, "o", "   855\t        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n   856\t        p->diag = compute_diag(m);\r\n   857\t        p->lower = build_lower_triangular(m);\r\n   858\t        p->upper = build_upper_triangular(m);\r\n   859\t    } else if (type == PRECOND_IC0) {\r\n   860\t        if (!m->symmetric) die(\"IC(0) requires symmetric matrix\");\r\n   861\t        p->ic = ic0_factorize(m);\r\n   862\t    }\r\n   863\t\r\n   864\t    return p;\r\n   865\t}\r\n   866\t\r\n   867\tstatic void precond_apply(Precond *p, const double *r, double *z) {\r\n   868\t    int n = p->A->n;\r\n   869\t\r\n   870\t    if (p->type == PRECOND_NONE) {\r\n   871\t        dcopy(n, r, z);\r\n"]
[6433.554322, "o", "   872\t        return;\r\n   873\t    }\r\n   874\t\r\n   875\t    if (p->type == PRECOND_JACOBI) {\r\n   876\t        for (int i = 0; i < n; i++) {\r\n   877\t            if (p->diag[i] == 0.0) die(\"zero diagonal in Jacobi preconditioner\");\r\n   878\t            z[i] = r[i] / p->diag[i];\r\n   879\t        }\r\n   880\t        return;\r\n   881\t    }\r\n   882\t\r\n   883\t    if (p->type == PRECOND_SSOR) {\r\n   884\t        dcopy(n, r, z);\r\n   885\t        for (int i = 0; i < n; i++) {\r\n   886\t            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\r\n"]
[6433.554397, "o", "   887\t                int j = p->lower->col_idx[idx];\r\n   888\t                if (j < i) z[i] -= p->lower->vals[idx] * z[j];\r\n   889\t            }\r\n   890\t            if (p->diag[i] == 0.0) {\r\n   891\t                z[i] = 0.0;\r\n   892\t                continue;\r\n   893\t            }\r\n   894\t            z[i] /= p->diag[i];\r\n   895\t        }\r\n   896\t        for (int i = n - 1; i >= 0; i--) {\r\n   897\t            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\r\n   898\t                int j = p->upper->col_idx[idx];\r\n   899\t                if (j > i) z[i] -= p->upper->vals[idx] * z[j];\r\n"]
[6433.554466, "o", "   900\t            }\r\n   901\t            if (p->diag[i] == 0.0) {\r\n   902\t                z[i] = 0.0;\r\n   903\t                continue;\r\n   904\t            }\r\n   905\t            z[i] /= p->diag[i];\r\n   906\t        }\r\n   907\t        return;\r\n   908\t    }\r\n   909\t\r\n   910\t    if (p->type == PRECOND_IC0) {\r\n   911\t        ICFactor *ic = p->ic;\r\n"]
[6433.554498, "o", "   912\t        for (int i = 0; i < n; i++) {\r\n   913\t            double s = r[i];\r\n   914\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   915\t                s -= ic->l_vals[idx] * z[ic->l_col_idx[idx]];\r\n   916\t            }\r\n   917\t            if (ic->diag[i] == 0.0) die(\"zero or negative pivot in IC(0) factorization\");\r\n"]
[6433.554596, "o", "   918\t            z[i] = s / ic->diag[i];\r\n   919\t        }\r\n   920\t        for (int i = n - 1; i >= 0; i--) {\r\n   921\t            z[i] /= ic->diag[i];\r\n   922\t            for (int idx = ic->l_row_ptr[i]; idx < ic->l_row_ptr[i + 1]; idx++) {\r\n   923\t                z[ic->l_col_idx[idx]] -= ic->l_vals[idx] * z[i];\r\n   924\t            }\r\n   925\t        }\r\n   926\t        return;\r\n   927\t    }\r\n   928\t\r\n   929\t    die(\"unknown preconditioner\");\r\n   930\t}\r\n   931\t\r\n"]
[6433.5547, "o", "   932\tstatic void free_precond(Precond *p) {\r\n   933\t    if (!p) return;\r\n   934\t    free(p->diag);\r\n   935\t    free_tri_matrix(p->lower);\r\n   936\t    free_tri_matrix(p->upper);\r\n   937\t    if (p->ic) {\r\n   938\t        free(p->ic->l_row_ptr);\r\n   939\t        free(p->ic->l_col_idx);\r\n   940\t        free(p->ic->l_vals);\r\n   941\t        free(p->ic->diag);\r\n   942\t        free(p->ic->u_row_ptr);\r\n   943\t        free(p->ic->u_col_idx);\r\n   944\t        free(p->ic->u_vals);\r\n   945\t"]
[6433.554769, "o", "        free(p->ic);\r\n   946\t    }\r\n   947\t    free(p);\r\n   948\t}\r\n   949\t\r\n   950\tstatic double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n   951\t    int n = A->n;\r\n   952\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n   953\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n   954\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   955\t    double *pvec = xmalloc((size_t)n * sizeof(double));"]
[6433.554837, "o", "\r\n   956\t    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n   957\t\r\n   958\t    spmv(A, x, r);\r\n   959\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   960\t    double bnorm = vec_norm2(n, b);\r\n   961\t    int it_count = 0;\r\n   962\t\r\n   963\t    precond_apply(p, r, z);\r\n   964\t    dcopy(n, z, pvec);\r\n   965\t    double rz_old = dot(n, r, z);\r\n"]
[6433.554913, "o", "   966\t\r\n   967\t    for (int it = 0; it < max_it; it++) {\r\n   968\t        spmv(A, pvec, Ap);\r\n   969\t        double pAp = dot(n, pvec, Ap);\r\n   970\t        if (pAp <= 0.0) {\r\n   971\t            free(r); free(z); free(pvec); free(Ap);\r\n   972\t            die(\"matrix is not positive definite\");\r\n   973\t        }\r\n   974\t        double alpha = rz_old / pAp;\r\n   975\t        for (int i = 0; i < n; i++) {\r\n"]
[6433.554991, "o", "   976\t            x[i] += alpha * pvec[i];\r\n   977\t            r[i] -= alpha * Ap[i];\r\n   978\t        }\r\n   979\t        it_count = it + 1;\r\n   980\t        if (history) {\r\n   981\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n   982\t        }\r\n   983\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n   984\t\r\n   985\t        precond_apply(p, r, z);\r\n   986\t        double rz_new = dot(n, r, z);\r\n   987\t        if (rz_old == 0.0) {\r\n   988\t            free(r); free(z); free(pvec); free(Ap);\r\n"]
[6433.555061, "o", "   989\t            die(\"CG numerical breakdown\");\r\n   990\t        }\r\n   991\t        double beta = rz_new / rz_old;\r\n   992\t        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n   993\t        rz_old = rz_new;\r\n   994\t    }\r\n   995\t\r\n   996\t    if (iterations_out) *iterations_out = it_count;\r\n   997\t    free(r); free(z); free(pvec); free(Ap);\r\n   998\t    return x;\r\n   999\t}\r\n  1000\t\r\n"]
[6433.555128, "o", "  1001\tstatic double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n  1002\t    int n = A->n;\r\n  1003\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n  1004\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n  1005\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n"]
[6433.555764, "o", "\u001b[?2004h"]
[6433.555832, "o", "root@n30009:/app# "]
[6433.829981, "i", "nl -ba nlsolve.c | sed -n '1005,1085p'\n"]
[6433.830313, "o", "nl -ba nlsolve.c | sed -n '1005,1085p'\r\n"]
[6433.830404, "o", "\u001b[?2004l\r"]
[6433.834106, "o", "  1005\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n  1006\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n  1007\t    double *v = xmalloc((size_t)n * sizeof(double));\r\n  1008\t    double *s = xmalloc((size_t)n * sizeof(double));\r\n  1009\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n  1010\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n  1011\t\r\n"]
[6433.83421, "o", "  1012\t    spmv(A, x, r);\r\n  1013\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n  1014\t    double bnorm = vec_norm2(n, b);\r\n  1015\t    int it_count = 0;\r\n  1016\t\r\n  1017\t    dcopy(n, r, r0);\r\n  1018\t    double rho_old = dot(n, r0, r);\r\n  1019\t    if (rho_old == 0.0) {\r\n  1020\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1021\t        die(\"BiCGSTAB numerical breakdown\");\r\n  1022\t    }\r\n  1023\t    dcopy(n, r, pvec);\r\n  1024\t\r\n  1025\t    for (int it = 0; it < max_it; it++) {\r\n  1026\t        precond_apply(p, pvec, z);\r\n"]
[6433.834285, "o", "  1027\t        spmv(A, z, v);\r\n  1028\t        double r0v = dot(n, r0, v);\r\n  1029\t        if (r0v == 0.0) {\r\n  1030\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1031\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1032\t        }\r\n  1033\t        double alpha = rho_old / r0v;\r\n  1034\t        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n  1035\t\r\n  1036\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n  1037\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n  1038\t            it_count = it + 1;\r\n  1039"]
[6433.834358, "o", "\t            if (history) {\r\n  1040\t                printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, s));\r\n  1041\t            }\r\n  1042\t            break;\r\n  1043\t        }\r\n  1044\t\r\n  1045\t        precond_apply(p, s, z);\r\n  1046\t        spmv(A, z, t);\r\n  1047\t        double ts = dot(n, t, s);\r\n  1048\t        double tt = dot(n, t, t);\r\n  1049\t"]
[6433.834434, "o", "        if (tt == 0.0) {\r\n  1050\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1051\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1052\t        }\r\n  1053\t        double omega = ts / tt;\r\n  1054\t        for (int i = 0; i < n; i++) {\r\n  1055\t            x[i] += alpha * z[i] + omega * s[i];\r\n  1056\t            r[i] = s[i] - omega * t[i];\r\n  1057\t        }\r\n  1058\t        it_count = it + 1;\r\n  1059\t        if (history) {\r\n  1060\t"]
[6433.834507, "o", "            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n  1061\t        }\r\n  1062\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n  1063\t\r\n  1064\t        double rho_new = dot(n, r0, r);\r\n  1065\t        if (rho_new == 0.0) {\r\n  1066\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1067\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1068\t        }\r\n  1069\t        double beta = (rho_new / rho_old) * (alpha / omega);\r\n  1070\t        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n"]
[6433.834579, "o", "  1071\t        rho_old = rho_new;\r\n  1072\t    }\r\n  1073\t\r\n  1074\t    if (iterations_out) *iterations_out = it_count;\r\n  1075\t    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1076\t    return x;\r\n  1077\t}\r\n  1078\t\r\n  1079\tstatic double *solve_gmres(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int restart, int *iterations_out) {\r\n  1080\t    int n = A->n;\r\n  1081\t"]
[6433.83469, "o", "    double *x = xcalloc((size_t)n, sizeof(double));\r\n  1082\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n  1083\t    double *w = xmalloc((size_t)n * sizeof(double));\r\n  1084\t    double *V = xmalloc((size_t)(restart + 1) * n * sizeof(double));\r\n  1085\t    double *Z = xmalloc((size_t)restart * n * sizeof(double));\r\n"]
