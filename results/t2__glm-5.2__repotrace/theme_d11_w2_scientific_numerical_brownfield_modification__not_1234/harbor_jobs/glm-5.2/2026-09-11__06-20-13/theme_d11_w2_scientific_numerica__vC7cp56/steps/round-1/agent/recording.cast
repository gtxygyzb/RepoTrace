[6526.821507, "o", "   950\tstatic double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n   951\t    int n = A->n;\r\n"]
[6526.821526, "o", "   952\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n   953\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n   954\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n   955\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n"]
[6526.821609, "o", "   956\t    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n   957\t\r\n   958\t    spmv(A, x, r);\r\n   959\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n   960\t    double bnorm = vec_norm2(n, b);\r\n   961\t    int it_count = 0;\r\n   962\t\r\n   963\t    precond_apply(p, r, z);\r\n   964\t    dcopy(n, z, pvec);\r\n   965\t    double rz_old = dot(n, r, z);\r\n   966\t\r\n   967\t"]
[6526.821627, "o", "    for (int it = 0; it < max_it; it++) {\r\n   968\t        spmv(A, pvec, Ap);\r\n"]
[6526.821655, "o", "   969\t        double pAp = dot(n, pvec, Ap);\r\n   970\t        if (pAp <= 0.0) {\r\n"]
[6526.821755, "o", "   971\t            free(r); free(z); free(pvec); free(Ap);\r\n   972\t            die(\"matrix is not positive definite\");\r\n   973\t        }\r\n   974\t        double alpha = rz_old / pAp;\r\n   975\t        for (int i = 0; i < n; i++) {\r\n   976\t            x[i] += alpha * pvec[i];\r\n   977\t            r[i] -= alpha * Ap[i];\r\n   978\t        }\r\n   979\t        it_count = it + 1;\r\n   980\t        if (history) {\r\n   981\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n   982\t        }\r\n   983\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n   984\t\r\n   985\t        precond_apply(p, r, z);\r\n   986\t        double rz_new = dot(n, r, z);\r\n   987\t        if (rz_old == 0.0) {\r\n   988"]
[6526.821772, "o", "\t            free(r); free(z); free(pvec); free(Ap);\r\n   989\t            die(\"CG numerical breakdown\");\r\n"]
[6526.821851, "o", "   990\t        }\r\n   991\t        double beta = rz_new / rz_old;\r\n   992\t        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n   993\t        rz_old = rz_new;\r\n   994\t    }\r\n   995\t\r\n   996\t    if (iterations_out) *iterations_out = it_count;\r\n   997\t    free(r); free(z); free(pvec); free(Ap);\r\n   998\t    return x;\r\n   999\t}\r\n  1000"]
[6526.821867, "o", "\t\r\n  1001\tstatic double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n  1002\t    int n = A->n;\r\n"]
[6526.82194, "o", "  1003\t    double *x = xcalloc((size_t)n, sizeof(double));\r\n  1004\t    double *r = xmalloc((size_t)n * sizeof(double));\r\n  1005\t    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n  1006\t    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n  1007\t    double *v = xmalloc((size_t)n * sizeof(double));\r\n  1008\t    double *s = xmalloc((size_t)n * sizeof(double));\r\n  1009\t    double *t = xmalloc((size_t)n * sizeof(double));\r\n  1010\t    double *z = xmalloc((size_t)n * sizeof(double));\r\n  1011\t\r\n  1012\t    spmv(A, x, r);\r\n  1013"]
[6526.821958, "o", "\t    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n  1014\t    double bnorm = vec_norm2(n, b);\r\n  1015\t    int it_count = 0;\r\n"]
[6526.821971, "o", "  1016\t\r\n  1017\t    dcopy(n, r, r0);\r\n  1018\t"]
[6526.82207, "o", "    double rho_old = dot(n, r0, r);\r\n  1019\t    if (rho_old == 0.0) {\r\n  1020\t        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1021\t        die(\"BiCGSTAB numerical breakdown\");\r\n  1022\t    }\r\n  1023\t    dcopy(n, r, pvec);\r\n  1024\t\r\n  1025\t    for (int it = 0; it < max_it; it++) {\r\n  1026\t        precond_apply(p, pvec, z);\r\n  1027\t        spmv(A, z, v);\r\n  1028\t        double r0v = dot(n, r0, v);\r\n  1029\t        if (r0v == 0.0) {\r\n  1030\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1031\t            die(\"BiCGSTAB numerical breakdown\");\r\n"]
[6526.822085, "o", "  1032\t        }\r\n  1033\t        double alpha = rho_old / r0v;\r\n  1034\t"]
[6526.822161, "o", "        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n  1035\t\r\n  1036\t        if (vec_norm2(n, s) <= tol * bnorm) {\r\n  1037\t            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n  1038\t            it_count = it + 1;\r\n  1039\t            if (history) {\r\n  1040\t                printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, s));\r\n  1041\t            }\r\n  1042\t            break;\r\n  1043\t        }\r\n  1044\t\r\n"]
[6526.822179, "o", "  1045\t        precond_apply(p, s, z);\r\n  1046\t        spmv(A, z, t);\r\n  1047\t"]
[6526.822192, "o", "        double ts = dot(n, t, s);\r\n  1048\t        double tt = dot(n, t, t);\r\n"]
[6526.822301, "o", "  1049\t        if (tt == 0.0) {\r\n  1050\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1051\t            die(\"BiCGSTAB numerical breakdown\");\r\n  1052\t        }\r\n  1053\t        double omega = ts / tt;\r\n  1054\t        for (int i = 0; i < n; i++) {\r\n  1055\t            x[i] += alpha * z[i] + omega * s[i];\r\n"]
[6526.822362, "o", "  1056\t            r[i] = s[i] - omega * t[i];\r\n  1057\t        }\r\n  1058\t        it_count = it + 1;\r\n  1059\t        if (history) {\r\n  1060\t            printf(\"iteration %d residual %.6e\\n\", it_count, vec_norm2(n, r));\r\n  1061\t        }\r\n  1062\t        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n  1063\t\r\n  1064\t        double rho_new = dot(n, r0, r);\r\n  1065\t        if (rho_new == 0.0) {\r\n  1066\t            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n  1067\t            die(\"BiCGSTAB numerical breakdown\");\r\n"]
[6526.822422, "o", "  1068\t        }\r\n  1069\t        double beta = (rho_new / rho_old) * (alpha / omega);\r\n  1070\t        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n  1071\t        rho_old = rho_new;\r\n  1072\t    }\r\n  1073\t\r\n  1074\t    if (iterations_out) *iterations_out = it_count;\r\n  1075\t    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n"]
[6526.82244, "o", "  1076\t    return x;\r\n  1077\t}\r\n"]
