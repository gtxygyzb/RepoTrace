[3674.361464, "o", "   117\t\r\n   118\t    int unique = 0;\r\n   119\t    for (int i = 0; i < count; ) {\r\n   120\t        int r = entries[i].r;\r\n   121\t        int c = entries[i].c;\r\n   122\t        double sum = 0.0;\r\n   123\t        while (i < count && entries[i].r == r && entries[i].c == c) {\r\n   124\t            sum += entries[i].v;\r\n   125\t            i++;\r\n   126\t        }\r\n   127\t        entries[unique].r = r;\r\n   128\t        entries[unique].c = c;\r\n   129\t        entries[unique].v = sum;\r\n   130\t        unique++;\r\n   131\t        tmp_count[r]++;\r\n   132\t    }\r\n"]
[3674.36156, "o", "   133\t\r\n   134\t    for (int i = 0; i < n; i++) row_ptr[i + 1] = row_ptr[i] + tmp_count[i];\r\n   135\t    free(tmp_count);\r\n   136\t\r\n   137\t    int *col_idx = xmalloc((size_t)unique * sizeof(int));\r\n   138"]
[3674.361655, "o", "\t    double *vals = xmalloc((size_t)unique * sizeof(double));\r\n   139\t    int *next = xcalloc((size_t)n, sizeof(int));\r\n   140\t\r\n   141\t    for (int i = 0; i < unique; i++) {\r\n   142\t        int r = entries[i].r;\r\n   143\t        int pos = row_ptr[r] + next[r]++;\r\n   144\t        col_idx[pos] = entries[i].c;\r\n   145\t        vals[pos] = entries[i].v;\r\n   146\t    }\r\n   147\t    free(next);\r\n   148\t\r\n   149\t    CSRMatrix *m = xmalloc(sizeof(CSRMatrix));\r\n   150\t    m->n = n;\r\n   151\t    m->nnz = unique;\r\n   152\t    m->row_ptr = row_ptr;\r\n   153\t    m->col_idx = col_idx;\r\n   154\t    m->vals = vals;\r\n   155\t    m->symmetric = symmetric;\r\n   156\t    return m;\r\n   157\t}\r\n   158\t\r\n"]
[3674.361738, "o", "   159\tstatic double *compute_diag(CSRMatrix *m) {\r\n   160\t    double *diag = xcalloc((size_t)m->n, sizeof(double));\r\n   161\t    for (int i = 0; i < m->n; i++) {\r\n   162\t        for (int idx = m->row_ptr[i]; idx < m->row_ptr[i + 1]; idx++) {\r\n   163\t            if (m->col_idx[idx] == i) diag[i] += m->vals[idx];\r\n   164\t        }\r\n   165\t    }\r\n   166\t    return diag;\r\n   167\t}\r\n   168\t\r\n   169\tstatic int has_trailing_data(FILE *f) {\r\n   170\t    int c;\r\n"]
[3674.361815, "o", "   171\t    while ((c = fgetc(f)) != EOF) {\r\n   172\t        if (isspace((unsigned char)c)) continue;\r\n   173\t        if (c == '%') {\r\n   174\t            while ((c = fgetc(f)) != EOF && c != '\\n');\r\n   175\t            continue;\r\n   176\t        }\r\n   177\t        return 1;\r\n   178\t    }\r\n   179\t    return 0;\r\n   180\t}\r\n"]
