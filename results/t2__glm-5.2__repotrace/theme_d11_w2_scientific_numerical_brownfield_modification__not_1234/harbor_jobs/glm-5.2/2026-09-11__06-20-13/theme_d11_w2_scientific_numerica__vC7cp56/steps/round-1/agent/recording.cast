[4242.479434, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.479493, "o", "\u001b[?2004h> "]
[4242.479867, "o", "# 1. Add compute_true_residual helper after vec_norm2\r\n\u001b[?2004l\r"]
[4242.47993, "o", "\u001b[?2004h> "]
[4242.480321, "o", "old = '''static double vec_norm2(int n, const double *x) {\r\n\u001b[?2004l\r"]
[4242.480378, "o", "\u001b[?2004h> "]
[4242.480591, "o", "    return sqrt(dot(n, x, x));\r\n\u001b[?2004l\r"]
[4242.480654, "o", "\u001b[?2004h> }\r\n"]
[4242.480713, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4242.480767, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.480829, "o", "> "]
[4242.481107, "o", "static void analyze_matrix(CSRMatrix *m) {'''\r\n\u001b[?2004l\r"]
[4242.481171, "o", "\u001b[?2004h> "]
[4242.481561, "o", "new = '''static double vec_norm2(int n, const double *x) {\r\n\u001b[?2004l\r"]
[4242.481626, "o", "\u001b[?2004h> "]
[4242.481843, "o", "    return sqrt(dot(n, x, x));\r\n\u001b[?2004l\r"]
[4242.481899, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4242.481964, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.482024, "o", "\u001b[?2004h> "]
[4242.482599, "o", "static double compute_true_residual(CSRMatrix *A, const double *b, const double *x) {\r\n\u001b[?2004l\r"]
[4242.48267, "o", "\u001b[?2004h> "]
[4242.482793, "o", "    int n = A->n;\r\n\u001b[?2004l\r"]
[4242.482849, "o", "\u001b[?2004h> "]
[4242.483212, "o", "    double *Ax = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.483276, "o", "\u001b[?2004h> "]
[4242.483413, "o", "    spmv(A, x, Ax);\r\n\u001b[?2004l\r"]
[4242.483467, "o", "\u001b[?2004h> "]
[4242.483844, "o", "    for (int i = 0; i < n; i++) Ax[i] = b[i] - Ax[i];\r\n\u001b[?2004l\r"]
[4242.483902, "o", "\u001b[?2004h> "]
[4242.484141, "o", "    double res = vec_norm2(n, Ax);\r\n\u001b[?2004l\r"]
[4242.484197, "o", "\u001b[?2004h> "]
[4242.484443, "o", "    double bnorm = vec_norm2(n, b);\r\n\u001b[?2004l\r"]
[4242.484501, "o", "\u001b[?2004h> "]
[4242.484602, "o", "    free(Ax);\r\n\u001b[?2004l\r"]
[4242.484675, "o", "\u001b[?2004h> "]
[4242.484908, "o", "    if (bnorm == 0.0) return 0.0;\r\n\u001b[?2004l\r"]
[4242.484966, "o", "\u001b[?2004h> "]
[4242.485134, "o", "    return res / bnorm;\r\n\u001b[?2004l\r"]
[4242.48519, "o", "\u001b[?2004h> }"]
[4242.485245, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.485301, "o", "> \r\n\u001b[?2004l\r"]
[4242.485355, "o", "\u001b[?2004h> "]
[4242.485656, "o", "static void analyze_matrix(CSRMatrix *m) {'''\r\n\u001b[?2004l\r"]
[4242.485717, "o", "\u001b[?2004h> "]
[4242.486069, "o", "replace(old, new, \"add compute_true_residual helper\")\r\n\u001b[?2004l\r"]
[4242.486129, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.486196, "o", "\u001b[?2004h> "]
[4242.486542, "o", "# 2. Remove SSOR zero diagonal fatal check in setup\r\n\u001b[?2004l\r"]
[4242.486598, "o", "\u001b[?2004h> "]
[4242.48692, "o", "old = '''    } else if (type == PRECOND_SSOR) {\r\n\u001b[?2004l\r"]
[4242.486976, "o", "\u001b[?2004h> "]
[4242.487424, "o", "        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n\u001b[?2004l\r"]
[4242.487479, "o", "\u001b[?2004h> "]
[4242.487696, "o", "        p->diag = compute_diag(m);\r\n\u001b[?2004l\r"]
[4242.487753, "o", "\u001b[?2004h> "]
[4242.488014, "o", "        for (int i = 0; i < m->n; i++) {\r\n\u001b[?2004l\r"]
[4242.48807, "o", "\u001b[?2004h> "]
[4242.488557, "o", "            if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\r\n\u001b[?2004l\r"]
[4242.488614, "o", "\u001b[?2004h> "]
[4242.488679, "o", "        }\r\n\u001b[?2004l\r"]
[4242.488736, "o", "\u001b[?2004h> "]
[4242.489008, "o", "        p->lower = build_lower_triangular(m);\r\n\u001b[?2004l\r"]
[4242.489063, "o", "\u001b[?2004h> "]
[4242.489338, "o", "        p->upper = build_upper_triangular(m);\r\n\u001b[?2004l\r"]
[4242.489394, "o", "\u001b[?2004h> "]
[4242.489646, "o", "    } else if (type == PRECOND_IC0) {'''\r\n\u001b[?2004l\r"]
[4242.489703, "o", "\u001b[?2004h> "]
[4242.48999, "o", "new = '''    } else if (type == PRECOND_SSOR) {\r\n\u001b[?2004l\r"]
[4242.490047, "o", "\u001b[?2004h> "]
[4242.490486, "o", "        if (omega <= 0.0 || omega >= 2.0) die(\"invalid SSOR parameter\");\r\n\u001b[?2004l\r"]
[4242.490542, "o", "\u001b[?2004h> "]
[4242.490729, "o", "        p->diag = compute_diag(m);\r\n\u001b[?2004l\r"]
[4242.490786, "o", "\u001b[?2004h> "]
[4242.491066, "o", "        p->lower = build_lower_triangular(m);\r\n\u001b[?2004l\r"]
[4242.491126, "o", "\u001b[?2004h> "]
[4242.491377, "o", "        p->upper = build_upper_triangular(m);\r\n\u001b[?2004l\r"]
[4242.491433, "o", "\u001b[?2004h> "]
[4242.49166, "o", "    } else if (type == PRECOND_IC0) {'''\r\n\u001b[?2004l\r"]
[4242.491717, "o", "\u001b[?2004h> "]
[4242.492064, "o", "replace(old, new, \"remove SSOR setup zero diagonal die\")\r\n\u001b[?2004l\r"]
[4242.492121, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rp\u001b[?2004h"]
[4242.492179, "o", "> "]
[4242.492421, "o", "# 3. Make SSOR apply safe for zero diagonals\r\n\u001b[?2004l\r"]
[4242.492479, "o", "\u001b[?2004h> "]
[4242.492746, "o", "old = '''    if (p->type == PRECOND_SSOR) {\r\n\u001b[?2004l\r"]
[4242.492802, "o", "\u001b[?2004h> "]
[4242.492936, "o", "        dcopy(n, r, z);\r\n\u001b[?2004l\r"]
[4242.492993, "o", "\u001b[?2004h> "]
[4242.493214, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[4242.493269, "o", "\u001b[?2004h> "]
[4242.493813, "o", "            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r"]
[4242.493871, "o", "\u001b[?2004h> "]
[4242.494169, "o", "                int j = p->lower->col_idx[idx];\r\n\u001b[?2004l\r"]
[4242.494226, "o", "\u001b[?2004h> "]
[4242.494596, "o", "                if (j < i) z[i] -= p->lower->vals[idx] * z[j];\r\n\u001b[?2004l\r"]
[4242.494662, "o", "\u001b[?2004h> "]
[4242.494727, "o", "            }\r\n\u001b[?2004l\r"]
[4242.494783, "o", "\u001b[?2004h> "]
[4242.49527, "o", "            if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\r\n\u001b[?2004l\r"]
[4242.495327, "o", "\u001b[?2004h> "]
[4242.49552, "o", "            z[i] /= p->diag[i];\r\n\u001b[?2004l\r"]
[4242.495576, "o", "\u001b[?2004h> "]
[4242.495622, "o", "        }\r\n\u001b[?2004l\r"]
[4242.495687, "o", "\u001b[?2004h> "]
[4242.495945, "o", "        for (int i = n - 1; i >= 0; i--) {\r\n\u001b[?2004l\r"]
[4242.496001, "o", "\u001b[?2004h> "]
[4242.496542, "o", "            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r"]
[4242.496599, "o", "\u001b[?2004h> "]
[4242.520788, "o", "                int j = p->upper->col_idx[idx];\r\n\u001b[?2004l\r\u001b[?2004h>                 if (j > i) z[i] -= p->upper->vals[idx] * z[j];\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             if (p->diag[i] == 0.0) die(\"zero diagonal in SSOR preconditioner\");\r\n\u001b[?2004l\r\u001b[?2004h>             z[i] /= p->diag[i];\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         return;\r\n\u001b[?2004l\r\u001b[?2004h>     }'''\r\n\u001b[?2004l\re\u001b[?2004h> new = '''    if (p->type == PRECOND_SSOR) {\r\n\u001b[?2004l\r\u001b[?2004h>         dcopy(n, r, z);\r\n\u001b[?2004l\r\u001b[?2004h>         for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>             for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r\u001b[?2004h>                 int j = p->lower->col_idx[idx];\r\n\u001b[?2004l\r\u001b[?2004h>                 if (j < i) z[i] -= p->lower->vals[idx] * z[j];\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             if (p->diag[i] == 0.0) {\r\n\u001b[?2004l\r\u001b[?2004h>                 z[i] = 0.0;\r\n\u001b[?2004l\r\u001b[?2004h>                 continue;"]
[4242.520861, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             z[i] /= p->diag[i];\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4242.520918, "o", "\u001b[?2004h> "]
[4242.521221, "o", "        for (int i = n - 1; i >= 0; i--) {\r\n\u001b[?2004l\r"]
[4242.521277, "o", "\u001b[?2004h> "]
[4242.521891, "o", "            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\r\n\u001b[?2004l\r"]
[4242.521946, "o", "\u001b[?2004h> "]
[4242.522259, "o", "                int j = p->upper->col_idx[idx];\r\n\u001b[?2004l\r"]
[4242.522322, "o", "\u001b[?2004h> "]
[4242.522749, "o", "                if (j > i) z[i] -= p->upper->vals[idx] * z[j];\r\n\u001b[?2004l\r"]
[4242.522805, "o", "\u001b[?2004h> "]
[4242.522904, "o", "            }\r\n\u001b[?2004l\r"]
[4242.522965, "o", "\u001b[?2004h> "]
[4242.523214, "o", "            if (p->diag[i] == 0.0) {\r\n\u001b[?2004l\r"]
[4242.523269, "o", "\u001b[?2004h> "]
[4242.52346, "o", "                z[i] = 0.0;\r\n\u001b[?2004l\r"]
[4242.523669, "o", "\u001b[?2004h> "]
[4242.523758, "o", "                continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.523869, "o", "            }\r\n\u001b[?2004l\r"]
[4242.52393, "o", "\u001b[?2004h> "]
[4242.524141, "o", "            z[i] /= p->diag[i];\r\n\u001b[?2004l\r"]
[4242.524199, "o", "\u001b[?2004h> "]
[4242.524279, "o", "        }\r\n\u001b[?2004l\r"]
[4242.524336, "o", "\u001b[?2004h> "]
[4242.524441, "o", "        return;\r\n\u001b[?2004l\r"]
[4242.524497, "o", "\u001b[?2004h> "]
[4242.524567, "o", "    }'''\r\n\u001b[?2004l\r"]
[4242.524622, "o", "\u001b[?2004h> "]
[4242.52497, "o", "replace(old, new, \"SSOR apply zero diagonal safe\")\r\n\u001b[?2004l\r"]
[4242.525027, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.525093, "o", "\u001b[?2004h> "]
[4242.52525, "o", "# 4. Replace CG solver\r\n\u001b[?2004l\r"]
[4242.525305, "o", "\u001b[?2004h> "]
[4242.525947, "o", "old = '''static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol) {\r\n\u001b[?2004l\r"]
[4242.526004, "o", "\u001b[?2004h> "]
[4242.526131, "o", "    int n = A->n;\r\n\u001b[?2004l\r"]
[4242.526198, "o", "\u001b[?2004h> "]
[4242.526536, "o", "    double *x = xcalloc((size_t)n, sizeof(double));\r\n\u001b[?2004l\r"]
[4242.526592, "o", "\u001b[?2004h> "]
[4242.526958, "o", "    double *r = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.527015, "o", "\u001b[?2004h> "]
[4242.527367, "o", "    double *z = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.527424, "o", "\u001b[?2004h> "]
[4242.527803, "o", "    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.52786, "o", "\u001b[?2004h> "]
[4242.528222, "o", "    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.528279, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.528335, "o", "\u001b[?2004h> "]
[4242.528467, "o", "    spmv(A, x, r);\r\n\u001b[?2004l\r"]
[4242.528532, "o", "\u001b[?2004h> "]
[4242.528884, "o", "    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n\u001b[?2004l\r"]
[4242.528943, "o", "\u001b[?2004h> "]
[4242.529188, "o", "    double bnorm = vec_norm2(n, b);\r\n\u001b[?2004l\r"]
[4242.529244, "o", "\u001b[?2004h> "]
[4242.529404, "o", "    if (bnorm == 0.0) {\r\n\u001b[?2004l\r"]
[4242.529469, "o", "\u001b[?2004h> "]
[4242.529798, "o", "        free(r); free(z); free(pvec); free(Ap);\r\n\u001b[?2004l\r"]
[4242.529855, "o", "\u001b[?2004h> "]
[4242.529978, "o", "        return x;\r\n\u001b[?2004l\r"]
[4242.530043, "o", "\u001b[?2004h> "]
[4242.530098, "o", "    }\r\n\u001b[?2004l\r"]
[4242.530154, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.530211, "o", "\u001b[?2004h> "]
[4242.530399, "o", "    precond_apply(p, r, z);\r\n\u001b[?2004l\r"]
[4242.530456, "o", "\u001b[?2004h> "]
[4242.530612, "o", "    dcopy(n, z, pvec);\r\n\u001b[?2004l\r"]
[4242.530684, "o", "\u001b[?2004h> "]
[4242.530913, "o", "    double rz_old = dot(n, r, z);\r\n\u001b[?2004l\r"]
[4242.530968, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.531032, "o", "\u001b[?2004h> "]
[4242.531317, "o", "    for (int it = 0; it < max_it; it++) {\r\n\u001b[?2004l\r"]
[4242.531374, "o", "\u001b[?2004h> "]
[4242.531554, "o", "        spmv(A, pvec, Ap);\r\n\u001b[?2004l\r"]
[4242.531609, "o", "\u001b[?2004h> "]
[4242.531887, "o", "        double pAp = dot(n, pvec, Ap);\r\n\u001b[?2004l\r"]
[4242.531943, "o", "\u001b[?2004h> "]
[4242.532122, "o", "        if (pAp <= 0.0) {\r\n\u001b[?2004l\r"]
[4242.532183, "o", "\u001b[?2004h> "]
[4242.532522, "o", "            free(r); free(z); free(pvec); free(Ap);\r\n\u001b[?2004l\r"]
[4242.532578, "o", "\u001b[?2004h> "]
[4242.532934, "o", "            die(\"matrix is not positive definite\");\r\n\u001b[?2004l\r"]
[4242.532992, "o", "\u001b[?2004h> "]
[4242.533065, "o", "        }\r\n\u001b[?2004l\r"]
[4242.53312, "o", "\u001b[?2004h> "]
[4242.533372, "o", "        double alpha = rz_old / pAp;\r\n\u001b[?2004l\r"]
[4242.533428, "o", "\u001b[?2004h> "]
[4242.533697, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[4242.533753, "o", "\u001b[?2004h> "]
[4242.534007, "o", "            x[i] += alpha * pvec[i];\r\n\u001b[?2004l\r"]
[4242.534064, "o", "\u001b[?2004h> "]
[4242.5343, "o", "            r[i] -= alpha * Ap[i];\r\n\u001b[?2004l\r"]
[4242.534356, "o", "\u001b[?2004h> "]
[4242.534429, "o", "        }\r\n\u001b[?2004l\r"]
[4242.534493, "o", "\u001b[?2004h> "]
[4242.534841, "o", "        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n\u001b[?2004l\r"]
[4242.534898, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.534955, "o", "\u001b[?2004h> "]
[4242.535179, "o", "        precond_apply(p, r, z);\r\n\u001b[?2004l\r"]
[4242.535235, "o", "\u001b[?2004h> "]
[4242.535502, "o", "        double rz_new = dot(n, r, z);\r\n\u001b[?2004l\r"]
[4242.535573, "o", "\u001b[?2004h> "]
[4242.535748, "o", "        if (rz_old == 0.0) {\r\n\u001b[?2004l\r"]
[4242.535804, "o", "\u001b[?2004h> "]
[4242.536154, "o", "            free(r); free(z); free(pvec); free(Ap);\r\n\u001b[?2004l\r"]
[4242.536211, "o", "\u001b[?2004h> "]
[4242.536501, "o", "            die(\"CG numerical breakdown\");\r\n\u001b[?2004l\r"]
[4242.536557, "o", "\u001b[?2004h> "]
[4242.53663, "o", "        }\r\n\u001b[?2004l\r"]
[4242.536694, "o", "\u001b[?2004h> "]
[4242.536954, "o", "        double beta = rz_new / rz_old;\r\n\u001b[?2004l\r"]
[4242.537009, "o", "\u001b[?2004h> "]
[4242.53752, "o", "        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.537706, "o", "        rz_old = rz_new;\r\n\u001b[?2004l\r"]
[4242.537781, "o", "\u001b[?2004h> "]
[4242.537841, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.5379, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.537958, "o", "> "]
[4242.538231, "o", "    free(r); free(z); free(pvec); free(Ap);\r\n\u001b[?2004l\r"]
[4242.53829, "o", "\u001b[?2004h> "]
[4242.538391, "o", "    return x;\r\n\u001b[?2004l\r"]
[4242.538448, "o", "\u001b[?2004h> "]
[4242.538514, "o", "}'''\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.538553, "o", "> "]
[4242.539405, "o", "new = '''static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n\u001b[?2004l\r"]
[4242.539468, "o", "\u001b[?2004h> "]
[4242.539593, "o", "    int n = A->n;\r\n\u001b[?2004l\r"]
[4242.539662, "o", "\u001b[?2004h> "]
[4242.539953, "o", "    double *x = xcalloc((size_t)n, sizeof(double));\r\n\u001b[?2004l\r"]
[4242.54001, "o", "\u001b[?2004h> "]
[4242.540255, "o", "    double *r = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.540311, "o", "\u001b[?2004h> "]
[4242.540561, "o", "    double *z = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.54062, "o", "\u001b[?2004h> "]
[4242.540885, "o", "    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.540942, "o", "\u001b[?2004h> "]
[4242.541199, "o", "    double *Ap = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.541255, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.541323, "o", "> "]
[4242.541386, "o", "    spmv(A, x, r);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.541442, "o", "> "]
[4242.541682, "o", "    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n\u001b[?2004l\r"]
[4242.54174, "o", "\u001b[?2004h> "]
[4242.541883, "o", "    double bnorm = vec_norm2(n, b);\r\n\u001b[?2004l\r"]
[4242.541939, "o", "\u001b[?2004h> "]
[4242.542021, "o", "    int it_count = 0;\r\n\u001b[?2004l\r"]
[4242.542077, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.542135, "o", "> "]
[4242.542229, "o", "    precond_apply(p, r, z);\r\n\u001b[?2004l\r"]
[4242.542285, "o", "\u001b[?2004h> "]
[4242.542376, "o", "    dcopy(n, z, pvec);\r\n\u001b[?2004l\r"]
[4242.542431, "o", "\u001b[?2004h> "]
[4242.54259, "o", "    double rz_old = dot(n, r, z);\r\n\u001b[?2004l\r"]
[4242.542665, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.542905, "o", "    for (int it = 0; it < max_it; it++) {\r\n\u001b[?2004l\r"]
[4242.542961, "o", "\u001b[?2004h> "]
[4242.543081, "o", "        spmv(A, pvec, Ap);\r\n\u001b[?2004l\r"]
[4242.543136, "o", "\u001b[?2004h> "]
[4242.543326, "o", "        double pAp = dot(n, pvec, Ap);\r\n\u001b[?2004l\r"]
[4242.543386, "o", "\u001b[?2004h> "]
[4242.543514, "o", "        if (pAp <= 0.0) {\r\n\u001b[?2004l\r"]
[4242.54357, "o", "\u001b[?2004h> "]
[4242.543828, "o", "            free(r); free(z); free(pvec); free(Ap);\r\n\u001b[?2004l\r"]
[4242.543885, "o", "\u001b[?2004h> "]
[4242.544122, "o", "            die(\"matrix is not positive definite\");\r\n\u001b[?2004l\r"]
[4242.544178, "o", "\u001b[?2004h> "]
[4242.544235, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.54444, "o", "        double alpha = rz_old / pAp;\r\n\u001b[?2004l\r"]
[4242.544497, "o", "\u001b[?2004h> "]
[4242.544696, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[4242.544754, "o", "\u001b[?2004h> "]
[4242.544927, "o", "            x[i] += alpha * pvec[i];\r\n\u001b[?2004l\r"]
[4242.544983, "o", "\u001b[?2004h> "]
[4242.545132, "o", "            r[i] -= alpha * Ap[i];\r\n\u001b[?2004l\r"]
[4242.545188, "o", "\u001b[?2004h> "]
[4242.545244, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.5453, "o", "> "]
[4242.545396, "o", "        it_count = it + 1;\r\n\u001b[?2004l\r"]
[4242.545451, "o", "\u001b[?2004h> "]
[4242.545557, "o", "        if (history) {\r\n\u001b[?2004l\r"]
[4242.545612, "o", "\u001b[?2004h> "]
[4242.546018, "o", "            printf(\"iteration %d residual %.6e\\\\n\", it_count, vec_norm2(n, r));\r\n\u001b[?2004l\r"]
[4242.546076, "o", "\u001b[?2004h> "]
[4242.546135, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.546422, "o", "        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n\u001b[?2004l\r"]
[4242.546477, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r;\u001b[?2004h"]
[4242.546532, "o", "> "]
[4242.546684, "o", "        precond_apply(p, r, z);\r\n\u001b[?2004l\r"]
[4242.546741, "o", "\u001b[?2004h> "]
[4242.54691, "o", "        double rz_new = dot(n, r, z);\r\n\u001b[?2004l\r"]
[4242.546965, "o", "\u001b[?2004h> "]
[4242.547112, "o", "        if (rz_old == 0.0) {\r\n\u001b[?2004l\r"]
[4242.547168, "o", "\u001b[?2004h> "]
[4242.547413, "o", "            free(r); free(z); free(pvec); free(Ap);\r\n\u001b[?2004l\r"]
[4242.547469, "o", "\u001b[?2004h> "]
[4242.547675, "o", "            die(\"CG numerical breakdown\");\r\n\u001b[?2004l\r"]
[4242.547732, "o", "\u001b[?2004h> "]
[4242.5478, "o", "        }\r\n\u001b[?2004l\r"]
[4242.547857, "o", "\u001b[?2004h> "]
[4242.548013, "o", "        double beta = rz_new / rz_old;\r\n\u001b[?2004l\r"]
[4242.548069, "o", "\u001b[?2004h> "]
[4242.548414, "o", "        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\r\n\u001b[?2004l\r"]
[4242.54847, "o", "\u001b[?2004h> "]
[4242.548579, "o", "        rz_old = rz_new;\r\n\u001b[?2004l\r"]
[4242.548641, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4242.548699, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.548756, "o", "\u001b[?2004h> "]
[4242.548998, "o", "    if (iterations_out) *iterations_out = it_count;\r\n\u001b[?2004l\r"]
[4242.549054, "o", "\u001b[?2004h> "]
[4242.549264, "o", "    free(r); free(z); free(pvec); free(Ap);\r\n\u001b[?2004l\r"]
[4242.549321, "o", "\u001b[?2004h> "]
[4242.549376, "o", "    return x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.549432, "o", "}'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.549586, "o", "replace(old, new, \"replace CG solver\")\r\n\u001b[?2004l\rr\u001b[?2004h"]
[4242.54965, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.549739, "o", "# 5. Replace BiCGSTAB solver\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.549795, "o", "> "]
[4242.550086, "o", "old = '''static double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.550143, "o", "> "]
[4242.550198, "o", "    int n = A->n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.550381, "o", "    double *x = xcalloc((size_t)n, sizeof(double));\r\n\u001b[?2004l\rl\u001b[?2004h"]
[4242.550436, "o", "> "]
[4242.550582, "o", "    double *r = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.550645, "o", "\u001b[?2004h> "]
[4242.550792, "o", "    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.550848, "o", "\u001b[?2004h> "]
[4242.55101, "o", "    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.551074, "o", "> "]
[4242.551212, "o", "    double *v = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.55127, "o", "> "]
[4242.551409, "o", "    double *s = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.551464, "o", "\u001b[?2004h> "]
[4242.551623, "o", "    double *t = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.551689, "o", "\u001b[?2004h> "]
[4242.551818, "o", "    double *z = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.551874, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.551941, "o", "    spmv(A, x, r);\r\n\u001b[?2004l\r"]
[4242.551995, "o", "\u001b[?2004h> "]
[4242.552147, "o", "    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.552211, "o", "> "]
[4242.552292, "o", "    double bnorm = vec_norm2(n, b);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.552396, "o", "    if (bnorm == 0.0) {\r\n\u001b[?2004l\r"]
[4242.552451, "o", "\u001b[?2004h> "]
[4242.552688, "o", "        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.552745, "o", "> "]
[4242.5528, "o", "        return x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.552857, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r="]
[4242.552912, "o", "\u001b[?2004h> "]
[4242.552973, "o", "    dcopy(n, r, r0);\r\n\u001b[?2004l\rf\u001b[?2004h"]
[4242.553028, "o", "> "]
[4242.553123, "o", "    double rho_old = dot(n, r0, r);\r\n\u001b[?2004l\r"]
[4242.553179, "o", "\u001b[?2004h> "]
[4242.553241, "o", "    if (rho_old == 0.0) {\r\n\u001b[?2004l\r"]
[4242.553302, "o", "\u001b[?2004h> "]
[4242.553513, "o", "        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.553568, "o", "> "]
[4242.553696, "o", "        die(\"BiCGSTAB numerical breakdown\");\r\n\u001b[?2004l\r"]
[4242.553751, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.553812, "o", "> "]
[4242.553868, "o", "    dcopy(n, r, pvec);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.553923, "o", "\u001b[?2004h> "]
[4242.554047, "o", "    for (int it = 0; it < max_it; it++) {\r\n\u001b[?2004l\r;"]
[4242.554103, "o", "\u001b[?2004h> "]
[4242.554194, "o", "        precond_apply(p, pvec, z);\r\n\u001b[?2004l\r"]
[4242.55425, "o", "\u001b[?2004h> "]
[4242.554308, "o", "        spmv(A, z, v);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.554435, "o", "        double r0v = dot(n, r0, v);\r\n\u001b[?2004l\r"]
[4242.55449, "o", "\u001b[?2004h> "]
[4242.554557, "o", "        if (r0v == 0.0) {\r\n\u001b[?2004l\r)\u001b[?2004h"]
[4242.554611, "o", "> "]
[4242.554851, "o", "            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.554906, "o", "> "]
[4242.555047, "o", "            die(\"BiCGSTAB numerical breakdown\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.555103, "o", ">         }\r\n\u001b[?2004l\r"]
[4242.555162, "o", "\u001b[?2004h> "]
[4242.555274, "o", "        double alpha = rho_old / r0v;\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.555329, "o", "> "]
[4242.555527, "o", "        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n\u001b[?2004l\r"]
[4242.555583, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.555747, "o", "        if (vec_norm2(n, s) <= tol * bnorm) {\r\n\u001b[?2004l\r"]
[4242.555804, "o", "\u001b[?2004h> "]
[4242.555998, "o", "            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.556053, "o", "> "]
[4242.556112, "o", "            break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.556172, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.556231, "o", ",\u001b[?2004h> "]
[4242.556311, "o", "        precond_apply(p, s, z);\r\n\u001b[?2004l\r"]
[4242.556366, "o", "\u001b[?2004h> "]
[4242.556419, "o", "        spmv(A, z, t);\r\n\u001b[?2004l\r"]
[4242.556474, "o", "\u001b[?2004h> "]
[4242.556564, "o", "        double ts = dot(n, t, s);\r\n\u001b[?2004l\r"]
[4242.556619, "o", "\u001b[?2004h> "]
[4242.556726, "o", "        double tt = dot(n, t, t);\r\n\u001b[?2004l\r \u001b[?2004h"]
[4242.556781, "o", "> "]
[4242.556843, "o", "        if (tt == 0.0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.556897, "o", "> "]
[4242.557123, "o", "            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r"]
[4242.557179, "o", "\u001b[?2004h> "]
[4242.557308, "o", "            die(\"BiCGSTAB numerical breakdown\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.557363, "o", ">         }\r\n\u001b[?2004l\r"]
[4242.557419, "o", "\u001b[?2004h> "]
[4242.5575, "o", "        double omega = ts / tt;\r\n\u001b[?2004l\r"]
[4242.557556, "o", "\u001b[?2004h> "]
[4242.557673, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[4242.55773, "o", "\u001b[?2004h> "]
[4242.557863, "o", "            x[i] += alpha * z[i] + omega * s[i];\r\n\u001b[?2004l\r"]
[4242.557919, "o", "\u001b[?2004h> "]
[4242.558029, "o", "            r[i] = s[i] - omega * t[i];\r\n\u001b[?2004l\r"]
[4242.558084, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4242.55814, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[4242.558318, "o", "        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n\u001b[?2004l\r"]
[4242.558375, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.558517, "o", "        double rho_new = dot(n, r0, r);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.558573, "o", "> "]
[4242.558645, "o", "        if (rho_new == 0.0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.558702, "o", "> "]
[4242.558938, "o", "            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.558994, "o", "> "]
[4242.559124, "o", "            die(\"BiCGSTAB numerical breakdown\");\r\n\u001b[?2004l\r"]
[4242.55918, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[4242.559206, "o", "\u001b[?2004h> "]
[4242.559417, "o", "        double beta = (rho_new / rho_old) * (alpha / omega);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.55961, "o", "        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.559698, "o", "        rho_old = rho_new;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.559733, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.559755, "o", "\r\n\u001b[?2004l\r"]
[4242.559774, "o", "\u001b[?2004h> "]
[4242.559956, "o", "    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.560019, "o", "    return x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.560051, "o", "}'''\r\n\u001b[?2004l\r"]
[4242.560072, "o", "\u001b[?2004h> "]
[4242.560427, "o", "new = '''static double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.560488, "o", "    int n = A->n;\r\n\u001b[?2004l\r"]
[4242.560512, "o", "\u001b[?2004h> "]
[4242.560663, "o", "    double *x = xcalloc((size_t)n, sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.560817, "o", "    double *r = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.560964, "o", "    double *r0 = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.561127, "o", "    double *pvec = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.561291, "o", "    double *v = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.561311, "o", "\u001b[?2004h> "]
[4242.561454, "o", "    double *s = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.561618, "o", "    double *t = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.621219, "o", "    double *z = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.621281, "o", "> "]
[4242.621381, "o", "    spmv(A, x, r);\r\n\u001b[?2004l\r"]
[4242.621442, "o", "\u001b[?2004h> "]
[4242.621817, "o", "    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\r\n\u001b[?2004l\r"]
[4242.621882, "o", "\u001b[?2004h> "]
[4242.622119, "o", "    double bnorm = vec_norm2(n, b);\r\n\u001b[?2004l\r"]
[4242.62218, "o", "\u001b[?2004h> "]
[4242.622333, "o", "    int it_count = 0;\r\n\u001b[?2004l\r"]
[4242.622393, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.622459, "o", "\u001b[?2004h"]
[4242.622516, "o", "> "]
[4242.622602, "o", "    dcopy(n, r, r0);\r\n\u001b[?2004l\r"]
[4242.622688, "o", "\u001b[?2004h> "]
[4242.622919, "o", "    double rho_old = dot(n, r0, r);\r\n\u001b[?2004l\r"]
[4242.622975, "o", "\u001b[?2004h> "]
[4242.62315, "o", "    if (rho_old == 0.0) {\r\n\u001b[?2004l\r"]
[4242.623206, "o", "\u001b[?2004h> "]
[4242.623716, "o", "        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r"]
[4242.623773, "o", "\u001b[?2004h> "]
[4242.624076, "o", "        die(\"BiCGSTAB numerical breakdown\");\r\n\u001b[?2004l\r"]
[4242.624131, "o", "\u001b[?2004h> "]
[4242.624186, "o", "    }\r\n\u001b[?2004l\r"]
[4242.624241, "o", "\u001b[?2004h> "]
[4242.624397, "o", "    dcopy(n, r, pvec);\r\n\u001b[?2004l\r"]
[4242.624454, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.62452, "o", "\u001b[?2004h> "]
[4242.624804, "o", "    for (int it = 0; it < max_it; it++) {\r\n\u001b[?2004l\r"]
[4242.624861, "o", "\u001b[?2004h> "]
[4242.625099, "o", "        precond_apply(p, pvec, z);\r\n\u001b[?2004l\r"]
[4242.625159, "o", "\u001b[?2004h> "]
[4242.625317, "o", "        spmv(A, z, v);\r\n\u001b[?2004l\r"]
[4242.625378, "o", "\u001b[?2004h> "]
[4242.625628, "o", "        double r0v = dot(n, r0, v);\r\n\u001b[?2004l\r"]
[4242.625693, "o", "\u001b[?2004h> "]
[4242.625863, "o", "        if (r0v == 0.0) {\r\n\u001b[?2004l\r"]
[4242.625921, "o", "\u001b[?2004h> "]
[4242.626443, "o", "            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r"]
[4242.6265, "o", "\u001b[?2004h> "]
[4242.62684, "o", "            die(\"BiCGSTAB numerical breakdown\");\r\n\u001b[?2004l\r"]
[4242.626897, "o", "\u001b[?2004h> "]
[4242.626974, "o", "        }\r\n\u001b[?2004l\r"]
[4242.627031, "o", "\u001b[?2004h> "]
[4242.627287, "o", "        double alpha = rho_old / r0v;\r\n\u001b[?2004l\r"]
[4242.627342, "o", "\u001b[?2004h> "]
[4242.62777, "o", "        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\r\n\u001b[?2004l\r"]
[4242.627826, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.627887, "o", "\u001b[?2004h> "]
[4242.628195, "o", "        if (vec_norm2(n, s) <= tol * bnorm) {\r\n\u001b[?2004l\r"]
[4242.628252, "o", "\u001b[?2004h> "]
[4242.628665, "o", "            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\r\n\u001b[?2004l\r"]
[4242.628723, "o", "\u001b[?2004h> "]
[4242.628942, "o", "            it_count = it + 1;\r\n\u001b[?2004l\r"]
[4242.628998, "o", "\u001b[?2004h> "]
[4242.62918, "o", "            if (history) {\r\n\u001b[?2004l\r"]
[4242.629236, "o", "\u001b[?2004h> "]
[4242.629801, "o", "                printf(\"iteration %d residual %.6e\\\\n\", it_count, vec_norm2(n, s));\r\n\u001b[?2004l\r"]
[4242.629858, "o", "\u001b[?2004h> "]
[4242.629958, "o", "            }\r\n\u001b[?2004l\r"]
[4242.630019, "o", "\u001b[?2004h> "]
[4242.63015, "o", "            break;\r\n\u001b[?2004l\r"]
[4242.630209, "o", "\u001b[?2004h> "]
[4242.630286, "o", "        }\r\n\u001b[?2004l\r"]
[4242.630349, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.630405, "o", "\u001b[?2004h> "]
[4242.630628, "o", "        precond_apply(p, s, z);\r\n\u001b[?2004l\r"]
[4242.630686, "o", "\u001b[?2004h> "]
[4242.630854, "o", "        spmv(A, z, t);\r\n\u001b[?2004l\r"]
[4242.630912, "o", "\u001b[?2004h> "]
[4242.631137, "o", "        double ts = dot(n, t, s);\r\n\u001b[?2004l\r"]
[4242.631199, "o", "\u001b[?2004h> "]
[4242.631427, "o", "        double tt = dot(n, t, t);\r\n\u001b[?2004l\r"]
[4242.631476, "o", "\u001b[?2004h> "]
[4242.63167, "o", "        if (tt == 0.0) {\r\n\u001b[?2004l\r"]
[4242.631726, "o", "\u001b[?2004h> "]
[4242.63223, "o", "            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r"]
[4242.632286, "o", "\u001b[?2004h> "]
[4242.632561, "o", "            die(\"BiCGSTAB numerical breakdown\");\r\n\u001b[?2004l\r"]
[4242.632624, "o", "\u001b[?2004h> "]
[4242.632684, "o", "        }\r\n\u001b[?2004l\r"]
[4242.63274, "o", "\u001b[?2004h> "]
[4242.632859, "o", "        double omega = ts / tt;\r\n\u001b[?2004l\r"]
[4242.632914, "o", "\u001b[?2004h> "]
[4242.633054, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[4242.633109, "o", "\u001b[?2004h> "]
[4242.633296, "o", "            x[i] += alpha * z[i] + omega * s[i];\r\n\u001b[?2004l\r"]
[4242.633351, "o", "\u001b[?2004h> "]
[4242.6335, "o", "            r[i] = s[i] - omega * t[i];\r\n\u001b[?2004l\r"]
[4242.633556, "o", "\u001b[?2004h> "]
[4242.633615, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.633746, "o", "        it_count = it + 1;\r\n\u001b[?2004l\r"]
[4242.633809, "o", "\u001b[?2004h> "]
[4242.633884, "o", "        if (history) {\r\n\u001b[?2004l\r"]
[4242.633944, "o", "\u001b[?2004h> "]
[4242.634246, "o", "            printf(\"iteration %d residual %.6e\\\\n\", it_count, vec_norm2(n, r));\r\n\u001b[?2004l\r"]
[4242.634303, "o", "\u001b[?2004h> "]
[4242.634358, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.634578, "o", "        if (vec_norm2(n, r) <= tol * bnorm) break;\r\n\u001b[?2004l\r"]
[4242.63464, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.634697, "o", "> "]
[4242.634831, "o", "        double rho_new = dot(n, r0, r);\r\n\u001b[?2004l\r"]
[4242.634887, "o", "\u001b[?2004h> "]
[4242.635, "o", "        if (rho_new == 0.0) {\r\n\u001b[?2004l\r"]
[4242.635057, "o", "\u001b[?2004h> "]
[4242.635357, "o", "            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r"]
[4242.635413, "o", "\u001b[?2004h> "]
[4242.635599, "o", "            die(\"BiCGSTAB numerical breakdown\");\r\n\u001b[?2004l\r"]
[4242.63567, "o", "\u001b[?2004h> "]
[4242.635727, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.635782, "o", "> "]
[4242.635998, "o", "        double beta = (rho_new / rho_old) * (alpha / omega);\r\n\u001b[?2004l\r"]
[4242.636054, "o", "\u001b[?2004h> "]
[4242.636318, "o", "        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\r\n\u001b[?2004l\r"]
[4242.636375, "o", "\u001b[?2004h> "]
[4242.636472, "o", "        rho_old = rho_new;\r\n\u001b[?2004l\r"]
[4242.636526, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[4242.636584, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.636647, "o", "\u001b[?2004h> "]
[4242.636842, "o", "    if (iterations_out) *iterations_out = it_count;\r\n\u001b[?2004l\r"]
[4242.636898, "o", "\u001b[?2004h> "]
[4242.637172, "o", "    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\r\n\u001b[?2004l\r"]
[4242.637226, "o", "\u001b[?2004h> "]
[4242.637294, "o", "    return x;\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.637349, "o", "> }'''\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.637407, "o", "> "]
[4242.637562, "o", "replace(old, new, \"replace BiCGSTAB solver\")\r\n\u001b[?2004l\r"]
[4242.637615, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.637691, "o", "> "]
[4242.637791, "o", "# 6. Add history variable in main\r\n\u001b[?2004l\r"]
[4242.637846, "o", "\u001b[?2004h> "]
[4242.637959, "o", "old = '''    int analyze = 0;\r\n\u001b[?2004l\r"]
[4242.638015, "o", "\u001b[?2004h> "]
[4242.638108, "o", "    int max_it = 1000;'''\r\n\u001b[?2004l\r"]
[4242.638162, "o", "\u001b[?2004h> "]
[4242.638272, "o", "new = '''    int analyze = 0;\r\n\u001b[?2004l\r"]
[4242.638327, "o", "\u001b[?2004h> "]
[4242.6384, "o", "    int history = 0;\r\n\u001b[?2004l\r"]
[4242.638455, "o", "\u001b[?2004h> "]
[4242.63855, "o", "    int max_it = 1000;'''\r\n\u001b[?2004l\r"]
[4242.638605, "o", "\u001b[?2004h> "]
[4242.638768, "o", "replace(old, new, \"add history variable\")\r\n\u001b[?2004l\r"]
[4242.638823, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.638882, "o", "> "]
[4242.638965, "o", "# 7. Add --history parsing\r\n\u001b[?2004l\r"]
[4242.63902, "o", "\u001b[?2004h> "]
[4242.639256, "o", "old = '''        } else if (strcmp(arg, \"--analyze\") == 0) {\r\n\u001b[?2004l\r"]
[4242.639311, "o", "\u001b[?2004h> "]
[4242.6394, "o", "            analyze = 1;\r\n\u001b[?2004l\r"]
[4242.639455, "o", "\u001b[?2004h> "]
[4242.639715, "o", "        } else if (strcmp(arg, \"--generate-laplacian\") == 0) {'''\r\n\u001b[?2004l\r"]
[4242.639771, "o", "\u001b[?2004h> "]
[4242.640005, "o", "new = '''        } else if (strcmp(arg, \"--analyze\") == 0) {\r\n\u001b[?2004l\r"]
[4242.640061, "o", "\u001b[?2004h> "]
[4242.64015, "o", "            analyze = 1;\r\n\u001b[?2004l\r"]
[4242.640206, "o", "\u001b[?2004h> "]
[4242.640401, "o", "        } else if (strcmp(arg, \"--history\") == 0) {\r\n\u001b[?2004l\r"]
[4242.640457, "o", "\u001b[?2004h> "]
[4242.640544, "o", "            history = 1;\r\n\u001b[?2004l\r"]
[4242.6406, "o", "\u001b[?2004h> "]
[4242.640865, "o", "        } else if (strcmp(arg, \"--generate-laplacian\") == 0) {'''\r\n\u001b[?2004l\r"]
[4242.640945, "o", "\u001b[?2004h> "]
[4242.64109, "o", "replace(old, new, \"add --history option\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.641169, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.641312, "o", "# 8. Add zero RHS handling in main\r\n\u001b[?2004l\r"]
[4242.641389, "o", "\u001b[?2004h> "]
[4242.641496, "o", "old = '''    if (m->n != rhs_n) {\r\n\u001b[?2004l\r"]
[4242.641573, "o", "\u001b[?2004h> "]
[4242.641663, "o", "        free_csr(m);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.641757, "o", "        free(b);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.642034, "o", "        die(\"matrix and RHS dimensions do not match\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.642126, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.642201, "o", "> "]
[4242.642273, "o", "    int n = m->n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.64237, "o", "    CSRMatrix *A = m;\r\n\u001b[?2004l\r"]
[4242.642446, "o", "\u001b[?2004h> "]
[4242.64252, "o", "    double *bwork = b;\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.642595, "o", "> "]
[4242.642676, "o", "    int *perm = NULL;'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.642838, "o", "new = '''    if (m->n != rhs_n) {\r\n\u001b[?2004l\r"]
[4242.642913, "o", "\u001b[?2004h> "]
[4242.642994, "o", "        free_csr(m);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.643069, "o", "        free(b);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.643141, "o", "> "]
[4242.643254, "o", "        die(\"matrix and RHS dimensions do not match\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.64333, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.643401, "o", "    int n = m->n;\r\n\u001b[?2004l\r"]
[4242.643479, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.643573, "o", "    if (vec_norm2(n, b) == 0.0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.643769, "o", "        double *x = xcalloc((size_t)n, sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.64389, "o", "        write_vector(output, n, x);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.643977, "o", "> "]
[4242.644073, "o", "        printf(\"iterations: 0\\\\n\");\r\n\u001b[?2004l\r"]
[4242.644172, "o", "\u001b[?2004h> "]
[4242.644224, "o", "        printf(\"residual_norm: 0.000000e+00\\\\n\");\r\n\u001b[?2004l\r"]
[4242.644374, "o", "\u001b[?2004h> "]
[4242.64448, "o", "        printf(\"converged: yes\\\\n\");\r\n\u001b[?2004l\r"]
[4242.64459, "o", "\u001b[?2004h> "]
[4242.644687, "o", "        free(x);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.644819, "o", "        free_csr(m);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.644918, "o", "        free(b);\r\n\u001b[?2004l\r"]
[4242.64503, "o", "\u001b[?2004h> "]
[4242.645176, "o", "        return 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.645298, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.645447, "o", "\u001b[?2004h> "]
[4242.645571, "o", "    CSRMatrix *A = m;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.645727, "o", "    double *bwork = b;\r\n\u001b[?2004l\r"]
[4242.645852, "o", "\u001b[?2004h> "]
[4242.645995, "o", "    int *perm = NULL;'''\r\n\u001b[?2004l\r"]
[4242.646171, "o", "\u001b[?2004h> "]
[4242.646327, "o", "replace(old, new, \"add zero RHS handling\")\r\n\u001b[?2004l\r"]
[4242.646425, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.646527, "o", "\u001b[?2004h> "]
[4242.646691, "o", "# 9. Update solver calls and reporting in main\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.64693, "o", "old = '''    Precond *p = precond_setup(A, precond, omega);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.647019, "o", ">     double *x2;\r\n\u001b[?2004l\r"]
[4242.647064, "o", "\u001b[?2004h> "]
[4242.647285, "o", "    if (solver == SOLVER_CG) x2 = solve_cg(A, bwork, p, max_it, tol);\r\n\u001b[?2004l\r"]
[4242.647357, "o", "\u001b[?2004h"]
[4242.647431, "o", "> "]
[4242.647498, "o", "    else x2 = solve_bicgstab(A, bwork, p, max_it, tol);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.647553, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.647615, "o", "    double *x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.647696, "o", "    if (perm) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.647847, "o", "        x = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.647903, "o", "\u001b[?2004h> "]
[4242.648034, "o", "        for (int i = 0; i < n; i++) x[i] = x2[perm[i]];\r\n\u001b[?2004l\r"]
[4242.648089, "o", "\u001b[?2004h> "]
[4242.648143, "o", "        free(x2);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.648207, "o", "        free(bwork);\r\n\u001b[?2004l\r"]
[4242.648269, "o", "\u001b[?2004h> "]
[4242.648325, "o", "        free(perm);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.648388, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.64844, "o", "        x = x2;\r\n\u001b[?2004l\r"]
[4242.648501, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.648561, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.648659, "o", "    write_vector(output, n, x);\r\n\u001b[?2004l\r\u001b[?2004h"]
[4242.648715, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.648774, "o", "    free(x);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.648849, "o", "    free_precond(p);\r\n\u001b[?2004l\r"]
[4242.648903, "o", "\u001b[?2004h> "]
[4242.648957, "o", "    free_csr(A);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.649013, "o", "    free(b);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.649078, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.649132, "o", "}'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.649312, "o", "new = '''    Precond *p = precond_setup(A, precond, omega);\r\n\u001b[?2004l\r"]
[4242.649366, "o", "\u001b[?2004h> "]
[4242.649426, "o", "    int iterations = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.649487, "o", "    double *x2;\r\n\u001b[?2004l\r"]
[4242.649541, "o", "\u001b[?2004h> "]
[4242.649781, "o", "    if (solver == SOLVER_CG) x2 = solve_cg(A, bwork, p, max_it, tol, history, &iterations);\r\n\u001b[?2004l\r"]
[4242.649836, "o", "\u001b[?2004h> "]
[4242.65003, "o", "    else x2 = solve_bicgstab(A, bwork, p, max_it, tol, history, &iterations);\r\n\u001b[?2004l\r"]
[4242.650085, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.650259, "o", "    double true_res = compute_true_residual(A, bwork, x2);\r\n\u001b[?2004l\r"]
[4242.650314, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.650378, "o", "    double *x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.650442, "o", "    if (perm) {\r\n\u001b[?2004l\r"]
[4242.650497, "o", "\u001b[?2004h> "]
[4242.65061, "o", "        x = xmalloc((size_t)n * sizeof(double));\r\n\u001b[?2004l\r"]
[4242.650673, "o", "\u001b[?2004h> "]
[4242.650806, "o", "        for (int i = 0; i < n; i++) x[i] = x2[perm[i]];\r\n\u001b[?2004l\r"]
[4242.650861, "o", "\u001b[?2004h> "]
[4242.650915, "o", "        free(x2);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.65098, "o", "        free(bwork);\r\n\u001b[?2004l\r"]
[4242.651046, "o", "\u001b[?2004h> "]
[4242.6511, "o", "        free(perm);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.651167, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.651231, "o", "        x = x2;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.651286, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.651346, "o", "\u001b[?2004h> "]
[4242.651414, "o", "    write_vector(output, n, x);\r\n\u001b[?2004l\r"]
[4242.65148, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4242.651544, "o", "\u001b[?2004h> "]
[4242.651605, "o", "    printf(\"iterations: %d\\\\n\", iterations);\r\n\u001b[?2004l\r"]
[4242.651665, "o", "\u001b[?2004h> "]
[4242.651776, "o", "    printf(\"residual_norm: %.6e\\\\n\", true_res);\r\n\u001b[?2004l\r"]
[4242.651831, "o", "\u001b[?2004h> "]
[4242.651993, "o", "    printf(\"converged: %s\\\\n\", (true_res <= tol) ? \"yes\" : \"no\");\r\n\u001b[?2004l\r"]
[4242.652049, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.652107, "o", "    free(x);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.652183, "o", "    free_precond(p);\r\n\u001b[?2004l\r"]
[4242.652238, "o", "\u001b[?2004h> "]
[4242.652296, "o", "    free_csr(A);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.652356, "o", "    free(b);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.652414, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.652468, "o", "}'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4242.652642, "o", "replace(old, new, \"update solver calls and reporting\")\r\n\u001b[?2004l\r\u001b[?2004h"]
