[5464.866762, "o", "   178\t    }\r\n   179\t    return 0;\r\n   180\t}\r\n   181\t\r\n   182\tstatic CSRMatrix *read_matrix(const char *filename) {\r\n   183\t    FILE *f = fopen(filename, \"r\");\r\n"]
[5464.86682, "o", "   184\t    if (!f) die(\"cannot open matrix file\");\r\n   185\t\r\n   186\t    char line[1024];\r\n   187\t    if (!fgets(line, sizeof(line), f)) {\r\n   188\t        fclose(f);\r\n   189\t        die(\"empty matrix file\");\r\n   190\t    }\r\n   191\t    if (strncmp(line, \"%%MatrixMarket\", 14) != 0) {\r\n   192\t        fclose(f);\r\n   193\t        die(\"matrix file is not Matrix Market format\");\r\n   194\t    }\r\n   195\t\r\n"]
