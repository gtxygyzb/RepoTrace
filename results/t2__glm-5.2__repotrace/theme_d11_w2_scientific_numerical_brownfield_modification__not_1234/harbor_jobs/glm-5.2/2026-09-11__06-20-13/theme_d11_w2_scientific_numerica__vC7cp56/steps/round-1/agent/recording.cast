[1866.37183, "o", "\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    write_matrix_market(\u001b[01;31m\u001b[Koutput\u001b[m\u001b[K, N, count, entries);\r\n\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void \u001b[01;31m\u001b[Kgenerate\u001b[m\u001b[K_laplacian3d(int n, const char *\u001b[01;31m\u001b[Koutput\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    write_matrix_market(\u001b[01;31m\u001b[Koutput\u001b[m\u001b[K, N, count, entries);\r\n\u001b[32m\u001b[K374\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void \u001b[01;31m\u001b[Kgenerate\u001b[m\u001b[K_rhs(int N, const char *\u001b[01;31m\u001b[Koutput\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K375\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    FILE *f = fopen(\u001b[01;31m\u001b[Koutput\u001b[m\u001b[K, \"w\");\r\n"]
[1866.371911, "o", "\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!f) die(\"cannot open \u001b[01;31m\u001b[Koutput\u001b[m\u001b[K rhs file\");\r\n\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void \u001b[01;31m\u001b[Kanalyze\u001b[m\u001b[K_matrix(CSRMatrix *m) {\r\n"]
