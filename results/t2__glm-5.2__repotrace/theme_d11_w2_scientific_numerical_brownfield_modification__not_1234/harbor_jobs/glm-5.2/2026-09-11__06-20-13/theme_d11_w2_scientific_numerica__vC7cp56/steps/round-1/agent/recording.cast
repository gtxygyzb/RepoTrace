[6915.145212, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('nlsolve.c')\ns = p.read_text()\ns = s.replace(\n'''    if (rho_old == 0.0) {\n        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n        die(\"BiCGSTAB numerical breakdown\");\n    }\n    dcopy(n, r, pvec);''',\n'''    if (fabs(rho_old) <= 1e-300) {\n        goto bicgstab_cleanup;\n    }\n    dcopy(n, r, pvec);'''\n)\ns = s.replace(\n'''        if (r0v == 0.0) {\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n            die(\"BiCGSTAB numerical breakdown\");\n        }''',\n'''        if (fabs(r0v) <= 1e-300) {\n            break;\n        }'''\n)\ns = s.replace(\n'''    if (iterations_out) *iterations_out = it_count;\n    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);''',\n'''bicgstab_cleanup:\n    if (iterations_out) *iterations_out = it_count;\n    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);'''\n)\np.write_text(s)\nPY\n"]
