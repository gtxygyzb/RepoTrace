Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\n\npath = Path("nlsolve.c")\ns = path.read_text()\n\nreplacements = []\n\ndef replace(old, new, desc):\n    global s\n    if old not in s:\n        raise SystemExit(f"pattern not found: {desc}")\n    s = s.replace(old, new, 1)\n    replacements.append(desc)\n\n# 1. Add compute_true_residual helper after vec_norm2\nold = \'\'\'static double vec_norm2(int n, const double *x) {\n    return sqrt(dot(n, x, x));\n}\n\nstatic void analyze_matrix(CSRMatrix *m) {\'\'\'\nnew = \'\'\'static double vec_norm2(int n, const double *x) {\n    return sqrt(dot(n, x, x));\n}\n\nstatic double compute_true_residual(CSRMatrix *A, const double *b, const double *x) {\n    int n = A->n;\n    double *Ax = xmalloc((size_t)n * sizeof(double));\n    spmv(A, x, Ax);\n    for (int i = 0; i < n; i++) Ax[i] = b[i] - Ax[i];\n    double res = vec_norm2(n, Ax);\n    double bnorm = vec_norm2(n, b);\n    free(Ax);\n    if (bnorm == 0.0) return 0.0;\n    return res / bnorm;\n}\n\nstatic void analyze_matrix(CSRMatrix *m) {\'\'\'\nreplace(old, new, "add compute_true_residual helper")\n\n# 2. Remove SSOR zero diagonal fatal check in setup\nold = \'\'\'    } else if (type == PRECOND_SSOR) {\n        if (omega <= 0.0 || omega >= 2.0) die("invalid SSOR parameter");\n        p->diag = compute_diag(m);\n        for (int i = 0; i < m->n; i++) {\n            if (p->diag[i] == 0.0) die("zero diagonal in SSOR preconditioner");\n        }\n        p->lower = build_lower_triangular(m);\n        p->upper = build_upper_triangular(m);\n    } else if (type == PRECOND_IC0) {\'\'\'\nnew = \'\'\'    } else if (type == PRECOND_SSOR) {\n        if (omega <= 0.0 || omega >= 2.0) die("invalid SSOR parameter");\n        p->diag = compute_diag(m);\n        p->lower = build_lower_triangular(m);\n        p->upper = build_upper_triangular(m);\n    } else if (type == PRECOND_IC0) {\'\'\'\nreplace(old, new, "remove SSOR setup zero diagonal die")\n\n# 3. Make SSOR apply safe for zero diagonals\nold = \'\'\'    if (p->type == PRECOND_SSOR) {\n        dcopy(n, r, z);\n        for (int i = 0; i < n; i++) {\n            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\n                int j = p->lower->col_idx[idx];\n                if (j < i) z[i] -= p->lower->vals[idx] * z[j];\n            }\n            if (p->diag[i] == 0.0) die("zero diagonal in SSOR preconditioner");\n            z[i] /= p->diag[i];\n        }\n        for (int i = n - 1; i >= 0; i--) {\n            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\n                int j = p->upper->col_idx[idx];\n                if (j > i) z[i] -= p->upper->vals[idx] * z[j];\n            }\n            if (p->diag[i] == 0.0) die("zero diagonal in SSOR preconditioner");\n            z[i] /= p->diag[i];\n        }\n        return;\n    }\'\'\'\nnew = \'\'\'    if (p->type == PRECOND_SSOR) {\n        dcopy(n, r, z);\n        for (int i = 0; i < n; i++) {\n            for (int idx = p->lower->row_ptr[i]; idx < p->lower->row_ptr[i + 1]; idx++) {\n                int j = p->lower->col_idx[idx];\n                if (j < i) z[i] -= p->lower->vals[idx] * z[j];\n            }\n            if (p->diag[i] == 0.0) {\n                z[i] = 0.0;\n                continue;\n            }\n            z[i] /= p->diag[i];\n        }\n        for (int i = n - 1; i >= 0; i--) {\n            for (int idx = p->upper->row_ptr[i]; idx < p->upper->row_ptr[i + 1]; idx++) {\n                int j = p->upper->col_idx[idx];\n                if (j > i) z[i] -= p->upper->vals[idx] * z[j];\n            }\n            if (p->diag[i] == 0.0) {\n                z[i] = 0.0;\n                continue;\n            }\n            z[i] /= p->diag[i];\n        }\n        return;\n    }\'\'\'\nreplace(old, new, "SSOR apply zero diagonal safe")\n\n# 4. Replace CG solver\nold = \'\'\'static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol) {\n    int n = A->n;\n    double *x = xcalloc((size_t)n, sizeof(double));\n    double *r = xmalloc((size_t)n * sizeof(double));\n    double *z = xmalloc((size_t)n * sizeof(double));\n    double *pvec = xmalloc((size_t)n * sizeof(double));\n    double *Ap = xmalloc((size_t)n * sizeof(double));\n\n    spmv(A, x, r);\n    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\n    double bnorm = vec_norm2(n, b);\n    if (bnorm == 0.0) {\n        free(r); free(z); free(pvec); free(Ap);\n        return x;\n    }\n\n    precond_apply(p, r, z);\n    dcopy(n, z, pvec);\n    double rz_old = dot(n, r, z);\n\n    for (int it = 0; it < max_it; it++) {\n        spmv(A, pvec, Ap);\n        double pAp = dot(n, pvec, Ap);\n        if (pAp <= 0.0) {\n            free(r); free(z); free(pvec); free(Ap);\n            die("matrix is not positive definite");\n        }\n        double alpha = rz_old / pAp;\n        for (int i = 0; i < n; i++) {\n            x[i] += alpha * pvec[i];\n            r[i] -= alpha * Ap[i];\n        }\n        if (vec_norm2(n, r) <= tol * bnorm) break;\n\n        precond_apply(p, r, z);\n        double rz_new = dot(n, r, z);\n        if (rz_old == 0.0) {\n            free(r); free(z); free(pvec); free(Ap);\n            die("CG numerical breakdown");\n        }\n        double beta = rz_new / rz_old;\n        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\n        rz_old = rz_new;\n    }\n\n    free(r); free(z); free(pvec); free(Ap);\n    return x;\n}\'\'\'\nnew = \'\'\'static double *solve_cg(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\n    int n = A->n;\n    double *x = xcalloc((size_t)n, sizeof(double));\n    double *r = xmalloc((size_t)n * sizeof(double));\n    double *z = xmalloc((size_t)n * sizeof(double));\n    double *pvec = xmalloc((size_t)n * sizeof(double));\n    double *Ap = xmalloc((size_t)n * sizeof(double));\n\n    spmv(A, x, r);\n    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\n    double bnorm = vec_norm2(n, b);\n    int it_count = 0;\n\n    precond_apply(p, r, z);\n    dcopy(n, z, pvec);\n    double rz_old = dot(n, r, z);\n\n    for (int it = 0; it < max_it; it++) {\n        spmv(A, pvec, Ap);\n        double pAp = dot(n, pvec, Ap);\n        if (pAp <= 0.0) {\n            free(r); free(z); free(pvec); free(Ap);\n            die("matrix is not positive definite");\n        }\n        double alpha = rz_old / pAp;\n        for (int i = 0; i < n; i++) {\n            x[i] += alpha * pvec[i];\n            r[i] -= alpha * Ap[i];\n        }\n        it_count = it + 1;\n        if (history) {\n            printf("iteration %d residual %.6e\\\\n", it_count, vec_norm2(n, r));\n        }\n        if (vec_norm2(n, r) <= tol * bnorm) break;\n\n        precond_apply(p, r, z);\n        double rz_new = dot(n, r, z);\n        if (rz_old == 0.0) {\n            free(r); free(z); free(pvec); free(Ap);\n            die("CG numerical breakdown");\n        }\n        double beta = rz_new / rz_old;\n        for (int i = 0; i < n; i++) pvec[i] = z[i] + beta * pvec[i];\n        rz_old = rz_new;\n    }\n\n    if (iterations_out) *iterations_out = it_count;\n    free(r); free(z); free(pvec); free(Ap);\n    return x;\n}\'\'\'\nreplace(old, new, "replace CG solver")\n\n# 5. Replace BiCGSTAB solver\nold = \'\'\'static double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol) {\n    int n = A->n;\n    double *x = xcalloc((size_t)n, sizeof(double));\n    double *r = xmalloc((size_t)n * sizeof(double));\n    double *r0 = xmalloc((size_t)n * sizeof(double));\n    double *pvec = xmalloc((size_t)n * sizeof(double));\n    double *v = xmalloc((size_t)n * sizeof(double));\n    double *s = xmalloc((size_t)n * sizeof(double));\n    double *t = xmalloc((size_t)n * sizeof(double));\n    double *z = xmalloc((size_t)n * sizeof(double));\n\n    spmv(A, x, r);\n    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\n    double bnorm = vec_norm2(n, b);\n    if (bnorm == 0.0) {\n        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n        return x;\n    }\n\n    dcopy(n, r, r0);\n    double rho_old = dot(n, r0, r);\n    if (rho_old == 0.0) {\n        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n        die("BiCGSTAB numerical breakdown");\n    }\n    dcopy(n, r, pvec);\n\n    for (int it = 0; it < max_it; it++) {\n        precond_apply(p, pvec, z);\n        spmv(A, z, v);\n        double r0v = dot(n, r0, v);\n        if (r0v == 0.0) {\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n            die("BiCGSTAB numerical breakdown");\n        }\n        double alpha = rho_old / r0v;\n        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\n\n        if (vec_norm2(n, s) <= tol * bnorm) {\n            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\n            break;\n        }\n\n        precond_apply(p, s, z);\n        spmv(A, z, t);\n        double ts = dot(n, t, s);\n        double tt = dot(n, t, t);\n        if (tt == 0.0) {\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n            die("BiCGSTAB numerical breakdown");\n        }\n        double omega = ts / tt;\n        for (int i = 0; i < n; i++) {\n            x[i] += alpha * z[i] + omega * s[i];\n            r[i] = s[i] - omega * t[i];\n        }\n\n        if (vec_norm2(n, r) <= tol * bnorm) break;\n\n        double rho_new = dot(n, r0, r);\n        if (rho_new == 0.0) {\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n            die("BiCGSTAB numerical breakdown");\n        }\n        double beta = (rho_new / rho_old) * (alpha / omega);\n        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\n        rho_old = rho_new;\n    }\n\n    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n    return x;\n}\'\'\'\nnew = \'\'\'static double *solve_bicgstab(CSRMatrix *A, double *b, Precond *p, int max_it, double tol, int history, int *iterations_out) {\n    int n = A->n;\n    double *x = xcalloc((size_t)n, sizeof(double));\n    double *r = xmalloc((size_t)n * sizeof(double));\n    double *r0 = xmalloc((size_t)n * sizeof(double));\n    double *pvec = xmalloc((size_t)n * sizeof(double));\n    double *v = xmalloc((size_t)n * sizeof(double));\n    double *s = xmalloc((size_t)n * sizeof(double));\n    double *t = xmalloc((size_t)n * sizeof(double));\n    double *z = xmalloc((size_t)n * sizeof(double));\n\n    spmv(A, x, r);\n    for (int i = 0; i < n; i++) r[i] = b[i] - r[i];\n    double bnorm = vec_norm2(n, b);\n    int it_count = 0;\n\n    dcopy(n, r, r0);\n    double rho_old = dot(n, r0, r);\n    if (rho_old == 0.0) {\n        free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n        die("BiCGSTAB numerical breakdown");\n    }\n    dcopy(n, r, pvec);\n\n    for (int it = 0; it < max_it; it++) {\n        precond_apply(p, pvec, z);\n        spmv(A, z, v);\n        double r0v = dot(n, r0, v);\n        if (r0v == 0.0) {\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n            die("BiCGSTAB numerical breakdown");\n        }\n        double alpha = rho_old / r0v;\n        for (int i = 0; i < n; i++) s[i] = r[i] - alpha * v[i];\n\n        if (vec_norm2(n, s) <= tol * bnorm) {\n            for (int i = 0; i < n; i++) x[i] += alpha * z[i];\n            it_count = it + 1;\n            if (history) {\n                printf("iteration %d residual %.6e\\\\n", it_count, vec_norm2(n, s));\n            }\n            break;\n        }\n\n        precond_apply(p, s, z);\n        spmv(A, z, t);\n        double ts = dot(n, t, s);\n        double tt = dot(n, t, t);\n        if (tt == 0.0) {\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n            die("BiCGSTAB numerical breakdown");\n        }\n        double omega = ts / tt;\n        for (int i = 0; i < n; i++) {\n            x[i] += alpha * z[i] + omega * s[i];\n            r[i] = s[i] - omega * t[i];\n        }\n        it_count = it + 1;\n        if (history) {\n            printf("iteration %d residual %.6e\\\\n", it_count, vec_norm2(n, r));\n        }\n        if (vec_norm2(n, r) <= tol * bnorm) break;\n\n        double rho_new = dot(n, r0, r);\n        if (rho_new == 0.0) {\n            free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n            die("BiCGSTAB numerical breakdown");\n        }\n        double beta = (rho_new / rho_old) * (alpha / omega);\n        for (int i = 0; i < n; i++) pvec[i] = r[i] + beta * pvec[i];\n        rho_old = rho_new;\n    }\n\n    if (iterations_out) *iterations_out = it_count;\n    free(r); free(r0); free(pvec); free(v); free(s); free(t); free(z);\n    return x;\n}\'\'\'\nreplace(old, new, "replace BiCGSTAB solver")\n\n# 6. Add history variable in main\nold = \'\'\'    int analyze = 0;\n    int max_it = 1000;\'\'\'\nnew = \'\'\'    int analyze = 0;\n    int history = 0;\n    int max_it = 1000;\'\'\'\nreplace(old, new, "add history variable")\n\n# 7. Add --history parsing\nold = \'\'\'        } else if (strcmp(arg, "--analyze") == 0) {\n            analyze = 1;\n        } else if (strcmp(arg, "--generate-laplacian") == 0) {\'\'\'\nnew = \'\'\'        } else if (strcmp(arg, "--analyze") == 0) {\n            analyze = 1;\n        } else if (strcmp(arg, "--history") == 0) {\n            history = 1;\n        } else if (strcmp(arg, "--generate-laplacian") == 0) {\'\'\'\nreplace(old, new, "add --history option")\n\n# 8. Add zero RHS handling in main\nold = \'\'\'    if (m->n != rhs_n) {\n        free_csr(m);\n        free(b);\n        die("matrix and RHS dimensions do not match");\n    }\n\n    int n = m->n;\n    CSRMatrix *A = m;\n    double *bwork = b;\n    int *perm = NULL;\'\'\'\nnew = \'\'\'    if (m->n != rhs_n) {\n        free_csr(m);\n        free(b);\n        die("matrix and RHS dimensions do not match");\n    }\n\n    int n = m->n;\n\n    if (vec_norm2(n, b) == 0.0) {\n        double *x = xcalloc((size_t)n, sizeof(double));\n        write_vector(output, n, x);\n        printf("iterations: 0\\\\n");\n        printf("residual_norm: 0.000000e+00\\\\n");\n        printf("converged: yes\\\\n");\n        free(x);\n        free_csr(m);\n        free(b);\n        return 0;\n    }\n\n    CSRMatrix *A = m;\n    double *bwork = b;\n    int *perm = NULL;\'\'\'\nreplace(old, new, "add zero RHS handling")\n\n# 9. Update solver calls and reporting in main\nold = \'\'\'    Precond *p = precond_setup(A, precond, omega);\n    double *x2;\n    if (solver == SOLVER_CG) x2 = solve_cg(A, bwork, p, max_it, tol);\n    else x2 = solve_bicgstab(A, bwork, p, max_it, tol);\n\n    double *x;\n    if (perm) {\n        x = xmalloc((size_t)n * sizeof(double));\n        for (int i = 0; i < n; i++) x[i] = x2[perm[i]];\n        free(x2);\n        free(bwork);\n        free(perm);\n    } else {\n        x = x2;\n    }\n\n    write_vector(output, n, x);\n\n    free(x);\n    free_precond(p);\n    free_csr(A);\n    free(b);\n    return 0;\n}\'\'\'\nnew = \'\'\'    Precond *p = precond_setup(A, precond, omega);\n    int iterations = 0;\n    double *x2;\n    if (solver == SOLVER_CG) x2 = solve_cg(A, bwork, p, max_it, tol, history, &iterations);\n    else x2 = solve_bicgstab(A, bwork, p, max_it, tol, history, &iterations);\n\n    double true_res = compute_true_residual(A, bwork, x2);\n\n    double *x;\n    if (perm) {\n        x = xmalloc((size_t)n * sizeof(double));\n        for (int i = 0; i < n; i++) x[i] = x2[perm[i]];\n        free(x2);\n        free(bwork);\n        free(perm);\n    } else {\n        x = x2;\n    }\n\n    write_vector(output, n, x);\n\n    printf("iterations: %d\\\\n", iterations);\n    printf("residual_norm: %.6e\\\\n", true_res);\n    printf("converged: %s\\\\n", (true_res <= tol) ? "yes" : "no");\n\n    free(x);\n    free_precond(p);\n    free_csr(A);\n    free(b);\n    return 0;\n}\'\'\'\nreplace(old, new, "update solv