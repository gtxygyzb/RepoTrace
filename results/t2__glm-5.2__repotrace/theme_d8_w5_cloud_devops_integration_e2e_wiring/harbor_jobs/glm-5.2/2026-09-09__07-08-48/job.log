        })\n    return events\n\ndef find_rollback_target(env, service, current_version, to_version=None):\n    events = load_events(env)\n\n    if to_version is not None:\n        for ev in reversed(events):\n            if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] == to_version:\n                return to_version\n        fail(f"version not found in history for {service}")\n\n    current_indices = [\n        idx for idx, ev in enumerate(events)\n        if ev["service"] == service\n        and ev["version"] == current_version\n        and not (ev["action"] == "ROLLBACK" and ev["version"] == "-")\n    ]\n    if not current_indices:\n        return None\n    current_idx = current_indices[-1]\n\n    for ev in reversed(events[:current_idx]):\n        if ev["service"] == service and ev["action"] != "ROLLBACK":\n            return ev["version"]\n    return None\n\'\'\'\nif old_append not in s:\n    raise SystemExit(\'append_event block not found\')\ns = s.replace(old_append, new_append)\n\nold_rollback = \'\'\'def cmd_rollback(args):\n    if len(args) != 2:\n        fail("rollback requires <environment> <service_name>")\n\n    env, service = args\n    data = load_manifest()\n    _, envs = get_services(data)\n    if env not in envs:\n        fail(f"environment not found: {env}")\n    ensure_state()\n    state = load_deployment_state(env)\n\n    if service not in state:\n        print(f"ROLLBACK {service} from {env} FAIL: not deployed")\n        sys.exit(1)\n\n    del state[service]\n    save_deployment_state(env, state)\n    append_event(env, "ROLLBACK", service, "-")\n    print(f"ROLLBACK {service} from {env} OK")\n\'\'\'\nnew_rollback = \'\'\'def cmd_rollback(args):\n    values, flags, positionals = parse_opts(args, {"--to-version"}, set())\n    if len(positionals) != 2:\n        fail("rollback requires <environment> <service_name>")\n\n    env, service = positionals\n    data = load_manifest()\n    _, envs = get_services(data)\n    if env not in envs:\n        fail(f"environment not found: {env}")\n    ensure_state()\n    state = load_deployment_state(env)\n\n    if service not in state:\n        print(f"ROLLBACK {service} from {env} FAIL: not deployed")\n        sys.exit(1)\n\n    current_version = state[service].get("version")\n    if not current_version:\n        print(f"ROLLBACK {service} from {env} FAIL: not deployed")\n        sys.exit(1)\n\n    to_version = values.get("--to-version")\n    target_version = find_rollback_target(env, service, current_version, to_version)\n\n    if target_version is None:\n        del state[service]\n        save_deployment_state(env, state)\n        append_event(env, "ROLLBACK", service, "-")\n        print(f"ROLLBACK {service} from {env}: {current_version} -> (removed)")\n    else:\n        state[service] = {"version": target_version, "deployed_at": now_iso()}\n        save_deployment_state(env, state)\n        append_event(env, "ROLLBACK", service, target_version)\n        print(f"ROLLBACK {service} from {env}: {current_version} -> {target_version}")\n\'\'\'\nif old_rollback not in s:\n    raise SystemExit(\'rollback block not found\')\ns = s.replace(old_rollback, new_rollback)\n\nold_main = \'\'\'    print(f"BUMP {service} {old} -> {new}")\n\ndef main():\n\'\'\'\nnew_main = \'\'\'    print(f"BUMP {service} {old} -> {new}")\n\ndef snapshot_file(env):\n    return os.path.join(SNAPSHOTS_DIR, f"{env}.json")\n\ndef load_snapshots(env):\n    return load_json(snapshot_file(env), [])\n\ndef save_snapshots(env, snapshots):\n    save_json(snapshot_file(env), snapshots)\n\ndef cmd_snapshot(args):\n    values, flags, positionals = parse_opts(args, set(), {"--list"})\n    if len(positionals) != 1:\n        fail("snapshot requires an environment")\n\n    env = positionals[0]\n    data = load_manifest()\n    _, envs = get_services(data)\n    if env not in envs:\n        fail(f"environment not found: {env}")\n    ensure_state()\n\n    if "--list" in flags:\n        snapshots = load_snapshots(env)\n        for snap in snapshots:\n            services = snap.get("services", {})\n            print(f"#{snap.get(\'id\', \'?\')} {snap.get(\'timestamp\', \'\')} ({len(services)} services)")\n        return\n\n    state = load_deployment_state(env)\n    snapshots = load_snapshots(env)\n    next_id = 1\n    for snap in snapshots:\n        if isinstance(snap.get("id"), int) and snap["id"] >= next_id:\n            next_id = snap["id"] + 1\n    timestamp = now_iso()\n    snapshot = {"id": next_id, "timestamp": timestamp, "services": state}\n    snapshots.append(snapshot)\n    save_snapshots(env, snapshots)\n    print(f"SNAPSHOT {env} #{next_id} ({len(state)} services)")\n\ndef cmd_restore(args):\n    values, flags, positionals = parse_opts(args, set(), set())\n    if len(positionals) != 2:\n        fail("restore requires <environment> <snapshot_id>")\n\n    env, snapshot_id_str = positionals\n    data = load_manifest()\n    _, envs = get_services(data)\n    if env not in envs:\n        fail(f"environment not found: {env}")\n    ensure_state()\n\n    try:\n        snapshot_id = int(snapshot_id_str)\n    except ValueError:\n        fail("snapshot id must be an integer")\n\n    snapshots = load_snapshots(env)\n    snapshot = None\n    for snap in snapshots:\n        if snap.get("id") == snapshot_id:\n            snapshot = snap\n            break\n    if snapshot is None:\n        fail(f"snapshot not found: #{snapshot_id}")\n\n    recorded = snapshot.get("services", {})\n    state = {}\n    for svc, rec in recorded.items():\n        state[svc] = dict(rec)\n    save_deployment_state(env, state)\n\n    for svc in sorted(state):\n        version = state[svc].get("version", "")\n        append_event(env, "RESTORE", svc, version, snapshot_id=snapshot_id)\n        print(f"RESTORE {svc} -> {env} ({version})")\n    print(f"Restored {len(state)} services from snapshot #{snapshot_id}")\n\ndef main():\n\'\'\'\nif old_main not in s:\n    raise SystemExit(\'main block not found\')\ns = s.replace(old_main, new_main)\n\nold_dispatch = \'\'\'    elif cmd == \'bump\':\n        cmd_bump(args)\n    else:\n        fail(f"unknown command: {cmd}")\n\'\'\'\nnew_dispatch = \'\'\'    elif cmd == \'bump\':\n        cmd_bump(args)\n    elif cmd == \'snapshot\':\n        cmd_snapshot(args)\n    elif cmd == \'restore\':\n        cmd_restore(args)\n    else:\n        fail(f"unknown command: {cmd}")\n\'\'\'\nif old_dispatch not in s:\n    raise SystemExit(\'dispatch block not found\')\ns = s.replace(old_dispatch, new_dispatch)\n\np.write_text(s)\nPY\npython3 /tmp/edit_pipeline.py\nbash -n pipeline.sh\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
