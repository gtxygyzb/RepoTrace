k_target(env, service, current_version, to_version)\n\n    if target_version is None:\n        del state[service]\n        save_deployment_state(env, state)\n        append_event(env, "ROLLBACK", service, "-")\n        print(f"ROLLBACK {service} from {env}: {current_version} -> (removed)")\n    else:\n        state[service] = {"version": target_version, "deployed_at": now_iso()}\n        save_deployment_state(env, state)\n        append_event(env, "ROLLBACK", service, target_version)\n        print(f"ROLLBACK {service} from {env}: {current_version} -> {target_version}")\n\n\'\'\'\n)\n\n# snapshot/restore before main\nreplace_once(\n    \'    print(f"BUMP {service} {old} -> {new}")\\n\\ndef main():\\n\',\n\'\'\'    print(f"BUMP {service} {old} -> {new}")\n\ndef snapshot_file(env):\n    return os.path.join(SNAPSHOTS_DIR, f"{env}.json")\n\ndef load_snapshots(env):\n    return load_json(snapshot_file(env), [])\n\ndef save_snapshots(env, snapshots):\n    save_json(snapshot_file(env), snapshots)\n\ndef cmd_snapshot(args):\n    values, flags, positionals = parse_opts(args, set(), {"--list"})\n    if len(positionals) != 1:\n        fail("snapshot requires an environment")\n\n    env = positionals[0]\n    data = load_manifest()\n    _, envs = get_services(data)\n    if env not in envs:\n        fail(f"environment not found: {env}")\n    ensure_state()\n\n    if "--list" in flags:\n        snapshots = load_snapshots(env)\n        for snap in snapshots:\n            services = snap.get("services", {})\n            print(f"#{snap.get(\'id\', \'?\')} {snap.get(\'timestamp\', \'\')} ({len(services)} services)")\n        return\n\n    state = load_deployment_state(env)\n    snapshots = load_snapshots(env)\n    next_id = 1\n    for snap in snapshots:\n        if isinstance(snap.get("id"), int) and snap["id"] >= next_id:\n            next_id = snap["id"] + 1\n    timestamp = now_iso()\n    snapshot = {"id": next_id, "timestamp": timestamp, "services": state}\n    snapshots.append(snapshot)\n    save_snapshots(env, snapshots)\n    print(f"SNAPSHOT {env} #{next_id} ({len(state)} services)")\n\ndef cmd_restore(args):\n    values, flags, positionals = parse_opts(args, set(), set())\n    if len(positionals) != 2:\n        fail("restore requires <environment> <snapshot_id>")\n\n    env, snapshot_id_str = positionals\n    data = load_manifest()\n    _, envs = get_services(data)\n    if env not in envs:\n        fail(f"environment not found: {env}")\n    ensure_state()\n\n    try:\n        snapshot_id = int(snapshot_id_str)\n    except ValueError:\n        fail("snapshot id must be an integer")\n\n    snapshots = load_snapshots(env)\n    snapshot = None\n    for snap in snapshots:\n        if snap.get("id") == snapshot_id:\n            snapshot = snap\n            break\n    if snapshot is None:\n        fail(f"snapshot not found: #{snapshot_id}")\n\n    recorded = snapshot.get("services", {})\n    state = {}\n    for svc, rec in recorded.items():\n        state[svc] = dict(rec)\n    save_deployment_state(env, state)\n\n    for svc in sorted(state):\n        version = state[svc].get("version", "")\n        append_event(env, "RESTORE", svc, version, snapshot_id=snapshot_id)\n        print(f"RESTORE {svc} -> {env} ({version})")\n    print(f"Restored {len(state)} services from snapshot #{snapshot_id}")\n\ndef main():\n\'\'\'\n)\n\n# dispatch\nreplace_once(\n\'\'\'    elif cmd == \'bump\':\n        cmd_bump(args)\n    else:\n        fail(f"unknown command: {cmd}")\n\'\'\',\n\'\'\'    elif cmd == \'bump\':\n        cmd_bump(args)\n    elif cmd == \'snapshot\':\n        cmd_snapshot(args)\n    elif cmd == \'restore\':\n        cmd_restore(args)\n    else:\n        fail(f"unknown command: {cmd}")\n\'\'\'\n)\n\np.write_text(s)\nPY\npython3 /tmp/edit_pipeline2.py\nbash -n pipeline.sh\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
