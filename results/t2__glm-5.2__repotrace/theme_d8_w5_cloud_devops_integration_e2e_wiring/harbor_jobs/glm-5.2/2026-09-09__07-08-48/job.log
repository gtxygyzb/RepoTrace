Sending keys: ['python3 - <<\'PYMOD\'\nfrom pathlib import Path\np = Path(\'pipeline.sh\')\ns = p.read_text()\ninsert = r\'\'\'def audit_event_entries(env):\n    ensure_state()\n    try:\n        with open(event_file(env)) as f:\n            raw_lines = [line.rstrip("\\n") for line in f if line.strip()]\n    except FileNotFoundError:\n        raw_lines = []\n\n    entries = []\n    for line in raw_lines:\n        if line.startswith(\'{\'):\n            try:\n                ev = json.loads(line)\n            except json.JSONDecodeError:\n                continue\n            action = ev.get("action")\n            iso = ev.get("iso_timestamp", "")\n            svc = ev.get("service", "-")\n            if action == "LOCK":\n                details = ev.get("reason", "")\n                display = f"{iso} LOCK {details}" if details else f"{iso} LOCK"\n            elif action == "UNLOCK":\n                details = ""\n                display = f"{iso} UNLOCK"\n            elif action == "CONFIG_SET":\n                details = f"{ev.get(\'key\', \'\')}={ev.get(\'value\', \'\')}"\n                display = f"{iso} CONFIG_SET {details}"\n            elif action == "CONFIG_DELETE":\n                details = ev.get("key", "")\n                display = f"{iso} CONFIG_DELETE {details}"\n            elif action == "SCALE":\n                details = f"{svc} from {ev.get(\'previous\', \'-\')} to {ev.get(\'replicas\', \'-\')} replicas"\n                display = f"{iso} SCALE {details}"\n            elif action == "HEALTH":\n                details = f"{svc} {ev.get(\'previous_state\', \'-\')} -> {ev.get(\'state\', \'-\')}"\n                display = f"{iso} HEALTH {details}"\n            elif action == "QUOTA_SET":\n                details = f"{ev.get(\'resource\', \'-\')}={ev.get(\'limit\', \'-\')}"\n                display = f"{iso} QUOTA_SET {details}"\n            elif action == "QUOTA_REMOVE":\n                details = ev.get("resource", "-")\n                display = f"{iso} QUOTA_REMOVE {details}"\n            elif action == "CLONE":\n                details = f"from {ev.get(\'source\', \'-\')}"\n                display = f"{iso} CLONE {details}"\n            else:\n                action = ev.get("action", "")\n                parts = line.split(None, 2)\n                details = parts[2] if len(parts) > 2 else ""\n                display = line\n        else:\n            parts = line.split(None, 2)\n            iso = parts[0] if parts else ""\n            action = parts[1] if len(parts) > 1 else ""\n            details = parts[2] if len(parts) > 2 else ""\n            display = line\n\n        entries.append({\n            "timestamp": iso,\n            "action": action,\n            "details": details,\n            "display": display,\n        })\n\n    entries.reverse()\n    return entries[:10]\n\ndef cmd_audit(args):\n    values, flags, positionals = parse_opts(args, {"--section"}, {"--json"})\n    if len(positionals) != 1:\n        fail("audit requires an environment")\n\n    env = positionals[0]\n    assert_env_exists(env)\n\n    section = values.get("--section")\n    valid_sections = {\n        "deployment": "Deployment Summary",\n        "replicas": "Replica Summary",\n        "health": "Health Summary",\n        "quotas": "Quota Status",\n        "config": "Config Variables",\n        "lock": "Lock Status",\n        "activity": "Recent Activity",\n    }\n    if section is not None and section not in valid_sections:\n        fail(f"unknown section \'{section}\' (valid: deployment, replicas, health, quotas, config, lock, activity)")\n    if "--json" in flags and section is not None:\n        fail("--json and --section cannot be combined")\n\n    state = load_deployment_state(env)\n    services = sorted(state)\n    deployment = {}\n    replicas = {}\n    health = {}\n    for s in services:\n        rec = state[s]\n        deployment[s] = {\n            "version": rec.get("version", ""),\n            "timestamp": rec.get("deployed_at", ""),\n        }\n        replicas[s] = get_replica_count(env, s)\n        health[s] = get_health_state(env, s)\n\n    quota_data = load_quotas(env)\n    quotas = {}\n    for resource in sorted(quota_data):\n        limit = quota_data[resource]\n        usage = quota_current_usage(env, resource)\n        status = "OK" if usage <= limit else "EXCEEDED"\n        quotas[resource] = {\n            "limit": limit,\n            "current": usage,\n            "status": status,\n        }\n\n    config_keys = sorted(load_config(env).keys())\n    lock = load_lock(env)\n    activity = audit_event_entries(env)\n\n    if "--json" in flags:\n        report = {\n            "environment": env,\n            "deployment": deployment,\n            "replicas": replicas,\n            "health": health,\n            "quotas": quotas,\n            "config": config_keys,\n            "lock": {\n                "locked": lock is not None,\n                "reason": lock.get("reason", "manual lock") if lock is not None else None,\n            },\n            "activity": [\n                {\n                    "timestamp": e["timestamp"],\n                    "action": e["action"],\n                    "details": e["details"],\n                }\n                for e in activity\n            ],\n        }\n        print(json.dumps(report, separators=(",", ":"), sort_keys=True))\n        return\n\n    def deployment_lines():\n        if not services:\n            return ["  (no services deployed)"]\n        return [\n            f"  {s}: {deployment[s][\'version\']} (deployed {deployment[s][\'timestamp\']})"\n            for s in services\n        ]\n\n    def replica_lines():\n        if not services:\n            return ["  (no services deployed)"]\n        return [f"  {s}: {replicas[s]} replicas" for s in services]\n\n    def health_lines():\n        if not services:\n            return ["  (no services deployed)"]\n        return [f"  {s}: {health[s]}" for s in services]\n\n    def quota_lines():\n        if not quotas:\n            return ["  (no quotas set)"]\n        return [\n            f"  {resource}: {quotas[resource][\'limit\']} (current: {quotas[resource][\'current\']}) [{quotas[resource][\'status\']}]"\n            for resource in sorted(quotas)\n        ]\n\n    def config_lines():\n        if not config_keys:\n            return ["  (no config variables)"]\n        return [f"  {key}" for key in config_keys]\n\n    def lock_lines():\n        if lock is not None:\n            return [f"  Locked: {lock.get(\'reason\', \'manual lock\')}"]\n        return ["  Unlocked"]\n\n    def activity_lines():\n        if not activity:\n            return ["  (no events)"]\n        return [f"  {e[\'display\']}" for e in activity]\n\n    section_order = ["deployment", "replicas", "health", "quotas", "config", "lock", "activity"]\n    section_funcs = {\n        "deployment": deployment_lines,\n        "replicas": replica_lines,\n        "health": health_lines,\n        "quotas": quota_lines,\n        "config": config_lines,\n        "lock": lock_lines,\n        "activity": activity_lines,\n    }\n\n    print(f"=== Audit Report: {env} ===")\n    if section is not None:\n        print(f"--- {valid_sections[section]} ---")\n        for line in section_funcs[section]():\n            print(line)\n    else:\n        for key in section_order:\n            print(f"--- {valid_sections[key]} ---")\n            for line in section_funcs[key]():\n                print(line)\n    print("=== End Audit Report ===")\n\n\'\'\'\nif \'def cmd_audit(args):\' not in s:\n    s = s.replace(\'\\ndef main():\', insert + \'\\ndef main():\', 1)\nif "elif cmd == \'audit\':" not in s:\n    s = s.replace("    elif cmd == \'clone\':\\n        cmd_clone(args)\\n", "    elif cmd == \'clone\':\\n        cmd_clone(args)\\n    elif cmd == \'audit\':\\n        cmd_audit(args)\\n", 1)\np.write_text(s)\nPYMOD\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
