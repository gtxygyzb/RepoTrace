def cmd_build(args):
    values, flags, positionals = parse_opts(args, {'--service'}, {'--parallel'})
    if positionals:
        fail("build does not accept positional arguments")

    service = values.get('--service')
    parallel = '--parallel' in flags

    data = load_manifest()
    services, _ = get_services(data)

    if service:
        subset = transitive_deps(services, service)
    else:
        subset = set(services.keys())

    if parallel:
        for wave in build_waves(services, subset):
            print(",".join(wave))
        return

    order = topo_order(services, subset)
    any_fail = False
    for s in order:
        svc = services[s]
        path = service_path(svc)
        if not os.path.isdir(path):
            print(f"BUILD {s} FAIL: service path does not exist")
            any_fail = True
            continue
        version = svc.get('version')
        if not valid_version(version):
            print(f"BUILD {s} FAIL: invalid version")
            any_fail = True
            continue
        try:
            os.makedirs(os.path.join(path, 'build'), exist_ok=True)
            with open(os.path.join(path, 'build', 'artifact.txt'), 'w') as f:
                f.write(f"{s}:{version}+build.{int(time.time())}")
            print(f"BUILD {s} OK")
        except Exception as e:
            print(f"BUILD {s} FAIL: {e}")
            any_fail = True

    if any_fail:
        sys.exit(1)

def cmd_test(args):
    values, flags, positionals = parse_opts(args, {'--service'}, {'--fail-fast'})
    if positionals:
        fail("test does not accept positional arguments")

    service = values.get('--service')
    fail_fast = '--fail-fast' in flags

    data = load_manifest()
    services, _ = get_services(data)

    if service:
        if service not in services:
            fail(f"service not found: {service}")
        order = [service]
    else:
        order = topo_order(services)

    ensure_state()
    results = load_json(TEST_RESULTS_PATH, {})
    any_fail = False

    for s in order:
        if os.path.exists(artifact_path(services[s])):
            results[s] = {"pass": True, "timestamp": now_iso()}
            print(f"TEST {s} PASS")
        else:
            results[s] = {"pass": False, "timestamp": now_iso()}
            print(f"TEST {s} FAIL: not built")
            any_fail = True
            if fail_fast:
                break

    save_json(TEST_RESULTS_PATH, results)
    if any_fail:
        sys.exit(1)

def cmd_deploy(args):
    values, flags, positionals = parse_opts(args, {'--service'}, {'--dry-run'})
    if len(positionals) != 1:
        fail("deploy requires an environment")

    env = positionals[0]
    service = values.get('--service')
    dry_run = '--dry-run' in flags

    data = load_manifest()
    services, envs = get_services(data)

    if env not in envs:
        fail(f"environment not found: {env}")

    assert_not_locked(env)

    if service:
        subset = transitive_deps(services, service)
    else:
        subset = set(services.keys())

    order = topo_order(services, subset)
    ensure_state()

    if dry_run:
        print(f"DRY-RUN deploy to {env}:")
        for s in order:
            print(f"  Would deploy {s}")
        return

    test_results = load_json(TEST_RESULTS_PATH, {})
    state = load_deployment_state(env)
    any_fail = False
    deployed_events = []

    for s in order:
        rec = test_results.get(s)
        if not rec or not rec.get("pass"):
            print(f"DEPLOY {s} -> {env} FAIL: tests not passing")
            any_fail = True
            break

        version = read_artifact(services[s])
        if version is None:
            print(f"DEPLOY {s} -> {env} FAIL: tests not passing")
            any_fail = True
            break

        state[s] = {"version": version, "deployed_at": now_iso()}
        deployed_events.append((s, version))
        print(f"DEPLOY {s} -> {env} OK")

    save_deployment_state(env, state)
    for s, version in deployed_events:
        append_event(env, "DEPLOY", s, version)
    if any_fail:
        sys.exit(1)

def cmd_status(args):
    if len(args) > 1:
        fail("status takes at most one environment argument")

    data = load_manifest()
    _, envs = get_services(data)

    if args:
        env = args[0]
        if env not in envs:
            fail(f"environment not found: {env}")
        lock = load_lock(env)
        if lock is not None:
            print(f"[LOCKED: {lock.get('reason', 'manual lock')}]")
        cfg = load_config(env)
        if cfg:
            print(f"Config: {len(cfg)} variables")
        state = load_deployment_state(env)
        for s in sorted(state):
            rec = state[s]
            print(f"{s}: {rec.get('version', '')} (deployed at {rec.get('deployed_at', '')})")
    else:
        for env in sorted(envs):
            state = load_deployment_state(env)
            print(f"{env}: {len(state)} services deployed")

def cmd_rollback(args):
    values, flags, positionals = parse_opts(args, {"--to-version"}, set())
    if len(positionals) != 2:
        fail("rollback requires <environment> <service_name>")

    env, service = positionals
    data = load_manifest()
    _, envs = get_services(data)
    if env not in envs:
        fail(f"environment not found: {env}")
    assert_not_locked(env)
    ensure_state()
    state = load_deployment_state(env)

    if service not in state:
        print(f"ROLLBACK {service} from {env} FAIL: not deployed")
        sys.exit(1)

    current_version = state[service].get("version")
    if not current_version:
        print(f"ROLLBACK {service} from {env} FAIL: not deployed")
        sys.exit(1)

    to_version = values.get("--to-version")
    target_version = find_rollback_target(env, service, current_version, to_version)

    if target_version is None:
        del state[service]
        save_deployment_state(env, state)
        append_event(env, "ROLLBACK", service, "-")
        print(f"ROLLBACK {service} from {env}: {current_version} -> (removed)")
    else:
        state[service] = {"version": target_version, "deployed_at": now_iso()}
        save_deployment_state(env, state)
        append_event(env, "ROLLBACK", service, target_version)
        print(f"ROLLBACK {service} from {env}: {current_version} -> {target_version}")

def valid_version(v):
    if not isinstance(v, str):
        return False
    parts = v.split('.')
    if len(parts) != 3:
        return False
    for part in parts:
        if not part.isdigit() or (part != '0' and part.startswith('0')):
            return False
    return True

def parse_semver(v):
    if not valid_version(v):
        return None
    return tuple(int(x) for x in v.split('.'))

def extract_semver(version):
    if not isinstance(version, str):
        return None
    semver = version.split(':', 1)[1] if ':' in version else version
    if '+build.' in semver:
        semver = semver.split('+build.', 1)[0]
    return parse_semver(semver)

def semver_string(version):
    sv = extract_semver(version)
    if sv is None:
        return None
    return f"{sv[0]}.{sv[1]}.{sv[2]}"

def version_build_timestamp(version):
    if not isinstance(version, str) or '+build.' not in version:
        return None
    after = version.split('+build.', 1)[1]
    try:
        return int(after)
    except ValueError:
        return None

def compare_versions(a, b):
    sa = extract_semver(a)
    sb = extract_semver(b)
    if sa is not None and sb is not None:
        if sa != sb:
            return 1 if sa > sb else -1
        ta = version_build_timestamp(a)
        tb = version_build_timestamp(b)
        if ta is not None and tb is not None and ta != tb:
            return 1 if ta > tb else -1
        return 0
    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)
def cmd_promote(args):
    values, flags, positionals = parse_opts(args, {"--service"}, {"--dry-run", "--force"})
    if len(positionals) != 2:
        fail("promote requires <source-env> <target-env>")

    source, target = positionals
    service = values.get("--service")
    dry_run = "--dry-run" in flags
    force = "--force" in flags

    data = load_manifest()
    services, envs = get_services(data)
[?2004hroot@n30009:/app# sed -n '720,1040p' pipeline.sh
[?2004l    services, envs = get_services(data)

    if source not in envs:
        fail(f"environment not found: {source}")
    if target not in envs:
        fail(f"environment not found: {target}")

    assert_not_locked(target)

    if service:
        subset = transitive_deps(services, service)
    else:
        subset = set(services.keys())

    ensure_state()
    source_state = load_deployment_state(source)
    target_state = load_deployment_state(target)

    candidates = {s for s in source_state if s in subset and s in services}
    order = topo_order(services, candidates)

    if dry_run:
        print(f"DRY-RUN promote from {source} to {target}:")
        for s in order:
            src_version = source_state[s].get("version")
            tgt_version = target_state.get(s, {}).get("version")
            if src_version == tgt_version:
                continue
            src_sv = extract_semver(src_version)
            tgt_sv = extract_semver(tgt_version)
            if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:
                print(f"  Would conflict {s} (downgrade)")
            else:
                print(f"  Would promote {s}")
        return

    promoted = 0
    skipped = 0
    conflicts = 0
    promote_events = []

    for s in order:
        src_rec = source_state[s]
        src_version = src_rec.get("version")
        if target_state.get(s, {}).get("version") == src_version:
            print(f"PROMOTE {s} -> {target}: SKIP (same version)")
            skipped += 1
            continue

        src_sv = extract_semver(src_version)
        tgt_sv = extract_semver(target_state.get(s, {}).get("version"))
        if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:
            if force:
                target_state[s] = src_rec
                print(f"PROMOTE {s} -> {target} OK (forced)")
                promoted += 1
                promote_events.append((s, src_version, True))
            else:
                print(f"CONFLICT: {s} -> {target}: downgrade ({src_sv[0]}.{src_sv[1]}.{src_sv[2]} < {tgt_sv[0]}.{tgt_sv[1]}.{tgt_sv[2]})")
                conflicts += 1
            continue

        target_state[s] = src_rec
        print(f"PROMOTE {s} -> {target} OK")
        promoted += 1
        promote_events.append((s, src_version, False))

    save_deployment_state(target, target_state)
    for s, version, forced in promote_events:
        append_event(target, "PROMOTE", s, version, source, forced=forced)
    print(f"Promoted {promoted}, skipped {skipped}, conflicts {conflicts}")
def cmd_diff(args):
    if len(args) != 2:
        fail("diff requires <env1> <env2>")

    env1, env2 = args
    data = load_manifest()
    _, envs = get_services(data)

    if env1 not in envs:
        fail(f"environment not found: {env1}")
    if env2 not in envs:
        fail(f"environment not found: {env2}")

    ensure_state()
    state1 = load_deployment_state(env1)
    state2 = load_deployment_state(env2)

    all_services = sorted(set(state1) | set(state2))
    if not all_services:
        return

    for s in all_services:
        v1 = state1.get(s, {}).get("version")
        v2 = state2.get(s, {}).get("version")

        if v1 and not v2:
            print(f"ONLY_IN {env1}: {s} ({v1})")
        elif v2 and not v1:
            print(f"ONLY_IN {env2}: {s} ({v2})")
        elif v1 == v2:
            print(f"SAME: {s} ({v1})")
        else:
            cmp = compare_versions(v1, v2)
            if cmp == 0:
                print(f"SAME: {s} ({v1})")
            else:
                newer = env1 if cmp > 0 else env2
                print(f"DIFFERS: {s} {v1} vs {v2} ({newer} newer)")

def cmd_history(args):
    values, flags, positionals = parse_opts(args, {"--service", "--limit"}, set())
    if len(positionals) != 1:
        fail("history requires an environment")

    env = positionals[0]
    service = values.get("--service")
    limit = 10
    if "--limit" in values:
        try:
            limit = int(values["--limit"])
        except ValueError:
            fail("--limit requires an integer")
        if limit < 0:
            fail("--limit must be non-negative")

    data = load_manifest()
    _, envs = get_services(data)
    if env not in envs:
        fail(f"environment not found: {env}")

    ensure_state()
    try:
        with open(event_file(env)) as f:
            raw_lines = [line.rstrip("\n") for line in f if line.strip()]
    except FileNotFoundError:
        raw_lines = []

    entries = []
    for line in raw_lines:
        if line.startswith('{'):
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            action = ev.get("action")
            iso = ev.get("iso_timestamp", "")
            svc = ev.get("service", "-")
            if action == "LOCK":
                entries.append((iso, svc, f"{iso} LOCK {ev.get('reason', '')}"))
            elif action == "UNLOCK":
                entries.append((iso, svc, f"{iso} UNLOCK"))
            elif action == "CONFIG_SET":
                entries.append((iso, svc, f"{iso} CONFIG_SET {ev.get('key', '')}={ev.get('value', '')}"))
            elif action == "CONFIG_DELETE":
                entries.append((iso, svc, f"{iso} CONFIG_DELETE {ev.get('key', '')}"))
            else:
                entries.append((iso, svc, line))
        else:
            parts = line.split()
            svc = parts[2] if len(parts) >= 3 else ""
            iso = parts[0] if parts else ""
            entries.append((iso, svc, line))

    if service:
        entries = [e for e in entries if e[1] == service]

    entries.reverse()
    entries = entries[:limit]
    for iso, svc, line in entries:
        print(line)

def print_tree(node, services, path, depth):
    print("  " * depth + node)
    if node in path:
        return
    path = path | {node}
    children = sorted([s for s in services if node in services[s].get('depends_on', [])])
    for child in children:
        print_tree(child, services, path, depth + 1)

def cmd_graph(args):
    values, flags, positionals = parse_opts(args, {'--format'}, set())
    if positionals:
        fail("graph does not accept positional arguments")

    fmt = values.get('--format', 'text')
    if fmt not in ('dot', 'text'):
        fail("graph format must be dot or text")

    data = load_manifest()
    services, _ = get_services(data)

    if fmt == 'dot':
        print("digraph pipeline {")
        for dep in sorted(services):
            dependents = sorted([s for s in services if dep in services[s].get('depends_on', [])])
            for dependent in dependents:
                print(f'  "{dep}" -> "{dependent}";')
        print("}")
    else:
        roots = sorted([s for s in services if not services[s].get('depends_on')])
        for root in roots:
            print_tree(root, services, set(), 0)

def cmd_bump(args):
    if len(args) != 2:
        fail("bump requires <service> <major|minor|patch>")

    service, level = args
    if level not in ('major', 'minor', 'patch'):
        fail("bump level must be major, minor, or patch")

    data = load_manifest()
    services = data.get('services')
    if not isinstance(services, dict) or service not in services:
        fail(f"service not found: {service}")

    old = services[service].get('version')
    sv = parse_semver(old)
    if sv is None:
        fail(f"service {service} has invalid version: {old}")

    major, minor, patch = sv
    if level == 'major':
        new = f"{major + 1}.0.0"
    elif level == 'minor':
        new = f"{major}.{minor + 1}.0"
    else:
        new = f"{major}.{minor}.{patch + 1}"

    services[service]['version'] = new
    with open(MANIFEST_PATH, 'w') as f:
        yaml.safe_dump(data, f, sort_keys=False)
    print(f"BUMP {service} {old} -> {new}")

def snapshot_file(env):
    return os.path.join(SNAPSHOTS_DIR, f"{env}.json")

def load_snapshots(env):
    return load_json(snapshot_file(env), [])

def save_snapshots(env, snapshots):
    save_json(snapshot_file(env), snapshots)

def cmd_snapshot(args):
    values, flags, positionals = parse_opts(args, set(), {"--list"})
    if len(positionals) != 1:
        fail("snapshot requires an environment")

    env = positionals[0]
    data = load_manifest()
    _, envs = get_services(data)
    if env not in envs:
        fail(f"environment not found: {env}")
    ensure_state()

    if "--list" in flags:
        snapshots = load_snapshots(env)
        for snap in snapshots:
            services = snap.get("services", {})
            print(f"#{snap.get('id', '?')} {snap.get('timestamp', '')} ({len(services)} services)")
        return

    state = load_deployment_state(env)
    snapshots = load_snapshots(env)
    next_id = 1
    for snap in snapshots:
        if isinstance(snap.get("id"), int) and snap["id"] >= next_id:
            next_id = snap["id"] + 1
    timestamp = now_iso()
    snapshot = {"id": next_id, "timestamp": timestamp, "services": state}
    snapshots.append(snapshot)
    save_snapshots(env, snapshots)
    print(f"SNAPSHOT {env} #{next_id} ({len(state)} services)")

def cmd_restore(args):
    values, flags, positionals = parse_opts(args, set(), set())
    if len(positionals) != 2:
        fail("restore requires <environment> <snapshot_id>")

    env, snapshot_id_str = positionals
    data = load_manifest()
    _, envs = get_services(data)
    if env not in envs:
        fail(f"environment not found: {env}")
    assert_not_locked(env)
    ensure_state()

    try:
        snapshot_id = int(snapshot_id_str)
    except ValueError:
        fail("snapshot id must be an integer")

    snapshots = load_snapshots(env)
    snapshot = None
    for snap in snapshots:
        if snap.get("id") == snapshot_id:
            snapshot = snap
            break
    if snapshot is None:
        fail(f"snapshot not found: #{snapshot_id}")

    recorded = snapshot.get("services", {})
    state = {}
    for svc, rec in recorded.items():
        state[svc] = dict(rec)
    save_deployment_state(env, state)

    for svc in sorted(state):
        version = state[svc].get("version", "")
        append_event(env, "RESTORE", svc, version, snapshot_id=snapshot_id)
        print(f"RESTORE {svc} -> {env} ({version})")
    print(f"Restored {len(state)} services from snapshot #{snapshot_id}")

def cmd_lock(args):
    values, flags, positionals = parse_opts(args, {'--reason'}, {'--list'})
    if '--list' in flags:
        data = load_manifest()
        _, envs = get_services(data)
        ensure_state()
[?2004hroot@n30009:/app# sed -n '1040,1260p' pipeline.sh
[?2004l        ensure_state()
        locked = []
        for env in envs:
            lock = load_lock(env)
            if lock is not None:
                locked.append((env, lock.get('reason', 'manual lock'), lock.get('locked_since', '')))
        for env, reason, since in sorted(locked):
            print(f"{env}: {reason} (locked since {since})")
        return
    if len(positionals) != 1:
        fail("lock requires <environment> [--reason REASON] or --list")
    env = positionals[0]
    reason = values.get('--reason', 'manual lock')
    data = load_manifest()
    _, envs = get_services(data)
    if env not in envs:
        fail(f"unknown environment {env}")
    ensure_state()
    save_lock(env, reason)
    append_lock_event(env, reason)
    print(f"LOCKED {env}: {reason}")

def cmd_unlock(args):
    values, flags, positionals = parse_opts(args, set(), set())
    if len(positionals) != 1:
        fail("unlock requires <environment>")
    env = positionals[0]
    data = load_manifest()
    _, envs = get_services(data)
    if env not in envs:
        fail(f"unknown environment {env}")
    ensure_state()
    remove_lock(env)
    append_unlock_event(env)
    print(f"UNLOCKED {env}")

def cmd_config(args):
    if not args:
        fail("config requires a subcommand")
    sub = args[0]
    rest = args[1:]
    if sub == 'set':
        cmd_config_set(rest)
    elif sub == 'get':
        cmd_config_get(rest)
    elif sub == 'list':
        cmd_config_list(rest)
    elif sub == 'diff':
        cmd_config_diff(rest)
    elif sub == 'delete':
        cmd_config_delete(rest)
    elif sub == 'export':
        cmd_config_export(rest)
    elif sub == 'import':
        cmd_config_import(rest)
    else:
        fail(f"unknown config subcommand: {sub}")

def cmd_config_set(args):
    if len(args) != 3:
        fail("config set requires <environment> <KEY> <VALUE>")
    env, key, value = args
    validate_config_key(key)
    assert_env_exists(env)
    assert_not_locked(env)
    cfg = load_config(env)
    cfg[key] = value
    save_config(env, cfg)
    append_config_set_event(env, key, value)
    print(f"CONFIG {env}: {key}={value}")

def cmd_config_get(args):
    if len(args) != 2:
        fail("config get requires <environment> <KEY>")
    env, key = args
    assert_env_exists(env)
    cfg = load_config(env)
    if key not in cfg:
        fail(f"key '{key}' not found in {env}")
    print(cfg[key])

def cmd_config_list(args):
    if len(args) != 1:
        fail("config list requires <environment>")
    env = args[0]
    assert_env_exists(env)
    cfg = load_config(env)
    for key in sorted(cfg):
        print(f"{key}={cfg[key]}")

def cmd_config_diff(args):
    if len(args) != 2:
        fail("config diff requires <env1> <env2>")
    env1, env2 = args
    assert_env_exists(env1)
    assert_env_exists(env2)
    cfg1 = load_config(env1)
    cfg2 = load_config(env2)
    for key in sorted(set(cfg1) | set(cfg2)):
        if key in cfg1 and key not in cfg2:
            print(f"+ {key}={cfg1[key]} (only in {env1})")
        elif key in cfg2 and key not in cfg1:
            print(f"- {key}={cfg2[key]} (only in {env2})")
        elif cfg1[key] != cfg2[key]:
            print(f"~ {key}: {cfg1[key]} -> {cfg2[key]}")

def cmd_config_delete(args):
    if len(args) != 2:
        fail("config delete requires <environment> <KEY>")
    env, key = args
    validate_config_key(key)
    assert_env_exists(env)
    assert_not_locked(env)
    cfg = load_config(env)
    if key not in cfg:
        fail(f"key '{key}' not found in {env}")
    del cfg[key]
    save_config(env, cfg)
    append_config_delete_event(env, key)
    print(f"CONFIG {env}: deleted {key}")

def cmd_config_export(args):
    if len(args) != 1:
        fail("config export requires <environment>")
    env = args[0]
    assert_env_exists(env)
    cfg = load_config(env)
    print(json.dumps(cfg, sort_keys=True, separators=(',', ':')))

def cmd_config_import(args):
    if len(args) != 1:
        fail("config import requires <environment>")
    env = args[0]
    raw = sys.stdin.read()
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        fail(f"invalid JSON: {e}")
    if not isinstance(data, dict):
        fail("invalid JSON input: expected an object")
    for key, value in data.items():
        if not isinstance(key, str):
            fail("invalid JSON input: keys must be strings")
        if not isinstance(value, str):
            fail("invalid JSON input: values must be strings")
        validate_config_key(key)
    assert_env_exists(env)
    assert_not_locked(env)
    if not data:
        return
    cfg = load_config(env)
    for key in sorted(data):
        cfg[key] = data[key]
    save_config(env, cfg)
    for key in sorted(data):
        append_config_set_event(env, key, data[key])
        print(f"CONFIG {env}: {key}={data[key]}")

def main():
    if len(sys.argv) < 2:
        fail("no command given")

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd == 'validate':
        cmd_validate(args)
    elif cmd == 'order':
        cmd_order(args)
    elif cmd == 'build':
        cmd_build(args)
    elif cmd == 'test':
        cmd_test(args)
    elif cmd == 'deploy':
        cmd_deploy(args)
    elif cmd == 'status':
        cmd_status(args)
    elif cmd == 'rollback':
        cmd_rollback(args)
    elif cmd == 'promote':
        cmd_promote(args)
    elif cmd == 'diff':
        cmd_diff(args)
    elif cmd == 'history':
        cmd_history(args)
    elif cmd == 'graph':
        cmd_graph(args)
    elif cmd == 'bump':
        cmd_bump(args)
    elif cmd == 'snapshot':
        cmd_snapshot(args)
    elif cmd == 'restore':
        cmd_restore(args)
    elif cmd == 'lock':
        cmd_lock(args)
    elif cmd == 'unlock':
        cmd_unlock(args)
    elif cmd == 'config':
        cmd_config(args)
    else:
        fail(f"unknown command: {cmd}")

if __name__ == '__main__':
    main()
