   120	def find_cycle(services):
   121	    visited = {}
   122	    stack = []
   123	
   124	    def dfs(node):
   125	        visited[node] = 1
   126	        stack.append(node)
   127	        for dep in services[node].get('depends_on', []):
   128	            if dep not in services:
   129	                continue
   130	            if visited.get(dep) == 1:
   131	                idx = stack.index(dep)
   132	                return stack[idx:] + [dep]
   133	            if visited.get(dep) is None:
   134	                res = dfs(dep)
   135	                if res:
   136	                    return res
   137	        stack.pop()
   138	        visited[node] = 2
   139	        return None
   140	
   141	    for n in sorted(services):
   142	        if visited.get(n) is None:
   143	            res = dfs(n)
   144	            if res:
   145	                return res
   146	    return None
