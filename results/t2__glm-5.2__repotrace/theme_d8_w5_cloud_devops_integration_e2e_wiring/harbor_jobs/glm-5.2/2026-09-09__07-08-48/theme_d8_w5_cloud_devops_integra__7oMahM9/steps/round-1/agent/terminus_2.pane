[?2004ldef cmd_deploy(args):
    values, flags, positionals = parse_opts(args, {'--service'}, {'--dry-run'})
    if len(positionals) != 1:
        fail("deploy requires an environment")

    env = positionals[0]
    service = values.get('--service')
    dry_run = '--dry-run' in flags

    data = load_manifest()
    services, envs = get_services(data)

    if env not in envs:
        fail(f"environment not found: {env}")

    assert_not_locked(env)

    if service:
        subset = transitive_deps(services, service)
    else:
        subset = set(services.keys())

    order = topo_order(services, subset)
    ensure_state()

    if dry_run:
        print(f"DRY-RUN deploy to {env}:")
        for s in order:
            print(f"  Would deploy {s}")
        return

    test_results = load_json(TEST_RESULTS_PATH, {})
    state = load_deployment_state(env)
    any_fail = False
    deployed_events = []

    for s in order:
        rec = test_results.get(s)
        if not rec or not rec.get("pass"):
            print(f"DEPLOY {s} -> {env} FAIL: tests not passing")
            any_fail = True
            break

        version = read_artifact(services[s])
        if version is None:
            print(f"DEPLOY {s} -> {env} FAIL: tests not passing")
            any_fail = True
            break

        state[s] = {"version": version, "deployed_at": now_iso()}
        deployed_events.append((s, version))
        print(f"DEPLOY {s} -> {env} OK")

    save_deployment_state(env, state)
    for s, version in deployed_events:
        append_event(env, "DEPLOY", s, version)
    if any_fail:
        sys.exit(1)

def cmd_status(args):
    if len(args) > 1:
        fail("status takes at most one environment argument")

    data = load_manifest()
    _, envs = get_services(data)

    if args:
        env = args[0]
        if env not in envs:
            fail(f"environment not found: {env}")
        lock = load_lock(env)
        if lock is not None:
            print(f"[LOCKED: {lock.get('reason', 'manual lock')}]")
        cfg = load_config(env)
        if cfg:
            print(f"Config: {len(cfg)} variables")
        state = load_deployment_state(env)
        for s in sorted(state):
            rec = state[s]
            print(f"{s}: {rec.get('version', '')} (deployed at {rec.get('deployed_at', '')})")
    else:
        for env in sorted(envs):
            state = load_deployment_state(env)
            print(f"{env}: {len(state)} services deployed")

def cmd_rollback(args):
    values, flags, positionals = parse_opts(args, {"--to-version"}, set())
    if len(positionals) != 2:
        fail("rollback requires <environment> <service_name>")

    env, service = positionals
    data = load_manifest()
    _, envs = get_services(data)
    if env not in envs:
        fail(f"environment not found: {env}")
    assert_not_locked(env)
    ensure_state()
    state = load_deployment_state(env)

    if service not in state:
        print(f"ROLLBACK {service} from {env} FAIL: not deployed")
        sys.exit(1)

    current_version = state[service].get("version")
    if not current_version:
        print(f"ROLLBACK {service} from {env} FAIL: not deployed")
        sys.exit(1)

    to_version = values.get("--to-version")
    target_version = find_rollback_target(env, service, current_version, to_version)

    if target_version is None:
        del state[service]
        save_deployment_state(env, state)
        append_event(env, "ROLLBACK", service, "-")
        print(f"ROLLBACK {service} from {env}: {current_version} -> (removed)")
    else:
        state[service] = {"version": target_version, "deployed_at": now_iso()}
        save_deployment_state(env, state)
        append_event(env, "ROLLBACK", service, target_version)
        print(f"ROLLBACK {service} from {env}: {current_version} -> {target_version}")

def valid_version(v):
    if not isinstance(v, str):
        return False
