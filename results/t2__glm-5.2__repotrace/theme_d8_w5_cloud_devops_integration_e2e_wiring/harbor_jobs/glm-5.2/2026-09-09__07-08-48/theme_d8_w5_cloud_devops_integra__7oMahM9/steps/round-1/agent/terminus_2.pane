   215	def transitive_deps(services, name):
   216	    if name not in services:
   217	        fail(f"service not found: {name}")
   218	    result = set()
   219	    stack = [name]
   220	    while stack:
   221	        s = stack.pop()
   222	        if s not in result:
   223	            result.add(s)
   224	            for dep in services[s].get('depends_on', []):
   225	                if dep not in services:
   226	                    fail(f"service {s} depends on undefined service: {dep}")
   227	                stack.append(dep)
   228	    return result
