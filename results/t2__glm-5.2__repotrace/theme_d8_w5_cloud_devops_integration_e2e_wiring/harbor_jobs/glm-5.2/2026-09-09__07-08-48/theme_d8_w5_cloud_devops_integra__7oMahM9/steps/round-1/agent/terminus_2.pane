   474	def valid_version(v):
   475	    if not isinstance(v, str):
   476	        return False
   477	    parts = v.split('.')
   478	    if len(parts) != 3:
   479	        return False
   480	    for part in parts:
   481	        if not part.isdigit() or (part != '0' and part.startswith('0')):
   482	            return False
   483	    return True
   484	
   485	def parse_semver(v):
   486	    if not valid_version(v):
   487	        return None
   488	    return tuple(int(x) for x in v.split('.'))
   489	
   490	def extract_semver(version):
   491	    if not isinstance(version, str):
   492	        return None
   493	    semver = version.split(':', 1)[1] if ':' in version else version
   494	    if '+build.' in semver:
   495	        semver = semver.split('+build.', 1)[0]
   496	    return parse_semver(semver)
   497	
   498	def semver_string(version):
   499	    sv = extract_semver(version)
   500	    if sv is None:
   501	        return None
   502	    return f"{sv[0]}.{sv[1]}.{sv[2]}"
   503	
   504	def version_build_timestamp(version):
   505	    if not isinstance(version, str) or '+build.' not in version:
   506	        return None
   507	    after = version.split('+build.', 1)[1]
   508	    try:
   509	        return int(after)
   510	    except ValueError:
   511	        return None
   512	
   513	def compare_versions(a, b):
   514	    sa = extract_semver(a)
   515	    sb = extract_semver(b)
   516	    if sa is not None and sb is not None:
   517	        if sa != sb:
   518	            return 1 if sa > sb else -1
   519	        ta = version_build_timestamp(a)
   520	        tb = version_build_timestamp(b)
   521	        if ta is not None and tb is not None and ta != tb:
   522	            return 1 if ta > tb else -1
   523	        return 0
   524	    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)
