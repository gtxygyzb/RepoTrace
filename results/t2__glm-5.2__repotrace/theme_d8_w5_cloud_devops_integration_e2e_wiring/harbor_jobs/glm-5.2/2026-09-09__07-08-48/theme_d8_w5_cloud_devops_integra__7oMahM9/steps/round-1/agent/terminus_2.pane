   107	def find_cycle(services):
   108	    visited = {}
   109	    stack = []
   110	
   111	    def dfs(node):
   112	        visited[node] = 1
   113	        stack.append(node)
   114	        for dep in services[node].get('depends_on', []):
   115	            if dep not in services:
   116	                continue
   117	            if visited.get(dep) == 1:
   118	                idx = stack.index(dep)
   119	                return stack[idx:] + [dep]
   120	            if visited.get(dep) is None:
   121	                res = dfs(dep)
   122	                if res:
   123	                    return res
   124	        stack.pop()
   125	        visited[node] = 2
   126	        return None
   127	
   128	    for n in sorted(services):
   129	        if visited.get(n) is None:
   130	            res = dfs(n)
   131	            if res:
   132	                return res
   133	    return None
