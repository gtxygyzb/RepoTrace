  1148	        reset_health(target, s)
  1149	    for s, version, forced in promote_events:
  1150	        append_event(target, "PROMOTE", s, version, source, forced=forced)
  1151	    print(f"Promoted {promoted}, skipped {skipped}, conflicts {conflicts}")
