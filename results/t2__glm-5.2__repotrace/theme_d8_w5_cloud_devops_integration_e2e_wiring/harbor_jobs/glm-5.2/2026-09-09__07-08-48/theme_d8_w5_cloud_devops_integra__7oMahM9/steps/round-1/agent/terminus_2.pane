   478	    values, flags, positionals = parse_opts(args, {"--service"}, {"--dry-run"})
   479	    if len(positionals) != 2:
   480	        fail("promote requires <source-env> <target-env>")
   481	
   482	    source, target = positionals
   483	    service = values.get("--service")
   484	    dry_run = "--dry-run" in flags
   485	
   486	    data = load_manifest()
   487	    services, envs = get_services(data)
   488	
   489	    if source not in envs:
   490	        fail(f"environment not found: {source}")
   491	    if target not in envs:
   492	        fail(f"environment not found: {target}")
   493	
   494	    if service:
   495	        subset = transitive_deps(services, service)
   496	    else:
   497	        subset = set(services.keys())
   498	
   499	    ensure_state()
   500	    source_state = load_deployment_state(source)
   501	    target_state = load_deployment_state(target)
   502	
   503	    candidates = {s for s in source_state if s in subset and s in services}
   504	    order = topo_order(services, candidates)
   505	
   506	    if dry_run:
   507	        print(f"DRY-RUN promote from {source} to {target}:")
   508	        for s in order:
   509	            if source_state[s].get("version") == target_state.get(s, {}).get("version"):
   510	                continue
   511	            print(f"  Would promote {s}")
   512	        return
   513	
   514	    promoted = 0
   515	    skipped = 0
   516	    promote_events = []
   517	
   518	    for s in order:
   519	        src_rec = source_state[s]
   520	        src_version = src_rec.get("version")
   521	        if target_state.get(s, {}).get("version") == src_version:
   522	            print(f"PROMOTE {s} -> {target}: SKIP (same version)")
   523	            skipped += 1
   524	            continue
   525	
   526	        target_state[s] = src_rec
   527	        print(f"PROMOTE {s} -> {target} OK")
   528	        promoted += 1
   529	        promote_events.append((s, src_version))
