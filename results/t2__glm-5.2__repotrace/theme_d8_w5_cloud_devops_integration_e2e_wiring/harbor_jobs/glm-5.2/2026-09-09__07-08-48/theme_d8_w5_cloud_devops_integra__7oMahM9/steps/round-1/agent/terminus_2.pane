   620	    candidates = {s for s in source_state if s in subset and s in services}
   621	    order = topo_order(services, candidates)
   622	
   623	    if dry_run:
   624	        print(f"DRY-RUN promote from {source} to {target}:")
   625	        for s in order:
   626	            src_version = source_state[s].get("version")
   627	            tgt_version = target_state.get(s, {}).get("version")
   628	            if src_version == tgt_version:
   629	                continue
   630	            src_sv = extract_semver(src_version)
   631	            tgt_sv = extract_semver(tgt_version)
   632	            if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:
   633	                print(f"  Would conflict {s} (downgrade)")
   634	            else:
   635	                print(f"  Would promote {s}")
   636	        return
   637	
   638	    promoted = 0
   639	    skipped = 0
   640	    conflicts = 0
   641	    promote_events = []
   642	
   643	    for s in order:
   644	        src_rec = source_state[s]
   645	        src_version = src_rec.get("version")
   646	        if target_state.get(s, {}).get("version") == src_version:
   647	            print(f"PROMOTE {s} -> {target}: SKIP (same version)")
   648	            skipped += 1
   649	            continue
   650	
   651	        src_sv = extract_semver(src_version)
   652	        tgt_sv = extract_semver(target_state.get(s, {}).get("version"))
   653	        if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:
   654	            if force:
   655	                target_state[s] = src_rec
   656	                print(f"PROMOTE {s} -> {target} OK (forced)")
   657	                promoted += 1
   658	                promote_events.append((s, src_version, True))
   659	            else:
   660	                print(f"CONFLICT: {s} -> {target}: downgrade ({src_sv[0]}.{src_sv[1]}.{src_sv[2]} < {tgt_sv[0]}.{tgt_sv[1]}.{tgt_sv[2]})")
   661	                conflicts += 1
   662	            continue
   663	
   664	        target_state[s] = src_rec
   665	        print(f"PROMOTE {s} -> {target} OK")
   666	        promoted += 1
   667	        promote_events.append((s, src_version, False))
   668	
   669	    save_deployment_state(target, target_state)
   670	    for s, version, forced in promote_events:
   671	        append_event(target, "PROMOTE", s, version, source, forced=forced)
   672	    print(f"Promoted {promoted}, skipped {skipped}, conflicts {conflicts}")
   673	def cmd_diff(args):
