   334	def parse_positive_int(s):
   335	    if not isinstance(s, str):
   336	        return None
   337	    if not re.fullmatch('[0-9]+', s):
   338	        return None
   339	    val = int(s)
   340	    if val < 1:
   341	        return None
   342	    return val
