   594	    values, flags, positionals = parse_opts(args, {"--service"}, {"--dry-run", "--force"})
   595	    if len(positionals) != 2:
   596	        fail("promote requires <source-env> <target-env>")
   597	
   598	    source, target = positionals
   599	    service = values.get("--service")
   600	    dry_run = "--dry-run" in flags
   601	    force = "--force" in flags
   602	
   603	    data = load_manifest()
   604	    services, envs = get_services(data)
   605	
   606	    if source not in envs:
   607	        fail(f"environment not found: {source}")
   608	    if target not in envs:
   609	        fail(f"environment not found: {target}")
   610	
   611	    if service:
   612	        subset = transitive_deps(services, service)
   613	    else:
   614	        subset = set(services.keys())
   615	
   616	    ensure_state()
   617	    source_state = load_deployment_state(source)
   618	    target_state = load_deployment_state(target)
   619	
   620	    candidates = {s for s in source_state if s in subset and s in services}
   621	    order = topo_order(services, candidates)
   622	
   623	    if dry_run:
   624	        print(f"DRY-RUN promote from {source} to {target}:")
   625	        for s in order:
   626	            src_version = source_state[s].get("version")
   627	            tgt_version = target_state.get(s, {}).get("version")
   628	            if src_version == tgt_version:
   629	                continue
   630	            src_sv = extract_semver(src_version)
   631	            tgt_sv = extract_semver(tgt_version)
   632	            if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:
   633	                print(f"  Would conflict {s} (downgrade)")
   634	            else:
   635	                print(f"  Would promote {s}")
   636	        return
   637	
   638	    promoted = 0
   639	    skipped = 0
   640	    conflicts = 0
   641	    promote_events = []
   642	
   643	    for s in order:
