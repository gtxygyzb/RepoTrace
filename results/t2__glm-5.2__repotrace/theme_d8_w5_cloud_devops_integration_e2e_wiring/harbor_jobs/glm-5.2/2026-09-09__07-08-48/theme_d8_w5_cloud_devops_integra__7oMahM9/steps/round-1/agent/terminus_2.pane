 794:         fail(f"environment not found: {target}")
 795: 
 796:     assert_not_locked(target)
 797: 
 798:     if service:
 799:         subset = transitive_deps(services, service)
 800:     else:
 801:         subset = set(services.keys())
 802: 
 803:     ensure_state()
