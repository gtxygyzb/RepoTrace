   541	
   542	def valid_version(v):
   543	    if not isinstance(v, str):
   544	        return False
   545	    parts = v.split('.')
   546	    if len(parts) != 3:
   547	        return False
   548	    for part in parts:
   549	        if not part.isdigit() or (part != '0' and part.startswith('0')):
   550	            return False
   551	    return True
   552	
   553	def parse_semver(v):
   554	    if not valid_version(v):
   555	        return None
   556	    return tuple(int(x) for x in v.split('.'))
   557	
   558	def extract_semver(version):
   559	    if not isinstance(version, str):
   560	        return None
   561	    semver = version.split(':', 1)[1] if ':' in version else version
   562	    if '+build.' in semver:
   563	        semver = semver.split('+build.', 1)[0]
   564	    return parse_semver(semver)
   565	
   566	def semver_string(version):
   567	    sv = extract_semver(version)
   568	    if sv is None:
   569	        return None
   570	    return f"{sv[0]}.{sv[1]}.{sv[2]}"
   571	
   572	def version_build_timestamp(version):
   573	    if not isinstance(version, str) or '+build.' not in version:
   574	        return None
   575	    after = version.split('+build.', 1)[1]
   576	    try:
   577	        return int(after)
   578	    except ValueError:
   579	        return None
   580	
   581	def compare_versions(a, b):
   582	    sa = extract_semver(a)
   583	    sb = extract_semver(b)
   584	    if sa is not None and sb is not None:
   585	        if sa != sb:
   586	            return 1 if sa > sb else -1
   587	        ta = version_build_timestamp(a)
   588	        tb = version_build_timestamp(b)
   589	        if ta is not None and tb is not None and ta != tb:
   590	            return 1 if ta > tb else -1
   591	        return 0
   592	    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)
