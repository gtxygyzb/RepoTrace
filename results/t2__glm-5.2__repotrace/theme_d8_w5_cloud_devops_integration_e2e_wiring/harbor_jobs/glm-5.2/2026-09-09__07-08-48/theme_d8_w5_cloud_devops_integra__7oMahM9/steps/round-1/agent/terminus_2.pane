   680	def print_tree(node, services, path, depth):
[?2004hroot@n30009:/app# nl -ba pipeline.sh | sed -n '680,780p'
[?2004l   680	def print_tree(node, services, path, depth):
   681	    print("  " * depth + node)
   682	    if node in path:
   683	        return
   684	    path = path | {node}
   685	    children = sorted([s for s in services if node in services[s].get('depends_on', [])])
   686	    for child in children:
   687	        print_tree(child, services, path, depth + 1)
   688	
   689	def cmd_graph(args):
   690	    values, flags, positionals = parse_opts(args, {'--format'}, set())
   691	    if positionals:
   692	        fail("graph does not accept positional arguments")
   693	
   694	    fmt = values.get('--format', 'text')
   695	    if fmt not in ('dot', 'text'):
   696	        fail("graph format must be dot or text")
   697	
   698	    data = load_manifest()
   699	    services, _ = get_services(data)
   700	
   701	    if fmt == 'dot':
   702	        print("digraph pipeline {")
   703	        for dep in sorted(services):
   704	            dependents = sorted([s for s in services if dep in services[s].get('depends_on', [])])
   705	            for dependent in dependents:
   706	                print(f'  "{dep}" -> "{dependent}";')
   707	        print("}")
   708	    else:
   709	        roots = sorted([s for s in services if not services[s].get('depends_on')])
   710	        for root in roots:
   711	            print_tree(root, services, set(), 0)
   712	
   713	def cmd_bump(args):
   714	    if len(args) != 2:
   715	        fail("bump requires <service> <major|minor|patch>")
   716	
   717	    service, level = args
   718	    if level not in ('major', 'minor', 'patch'):
   719	        fail("bump level must be major, minor, or patch")
   720	
   721	    data = load_manifest()
   722	    services = data.get('services')
   723	    if not isinstance(services, dict) or service not in services:
   724	        fail(f"service not found: {service}")
   725	
   726	    old = services[service].get('version')
   727	    sv = parse_semver(old)
   728	    if sv is None:
   729	        fail(f"service {service} has invalid version: {old}")
   730	
   731	    major, minor, patch = sv
   732	    if level == 'major':
   733	        new = f"{major + 1}.0.0"
   734	    elif level == 'minor':
   735	        new = f"{major}.{minor + 1}.0"
   736	    else:
   737	        new = f"{major}.{minor}.{patch + 1}"
   738	
   739	    services[service]['version'] = new
   740	    with open(MANIFEST_PATH, 'w') as f:
   741	        yaml.safe_dump(data, f, sort_keys=False)
   742	    print(f"BUMP {service} {old} -> {new}")
