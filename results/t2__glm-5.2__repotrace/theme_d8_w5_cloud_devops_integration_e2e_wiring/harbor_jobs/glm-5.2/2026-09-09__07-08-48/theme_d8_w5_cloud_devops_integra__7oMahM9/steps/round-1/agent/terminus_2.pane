   149	def topo_order(services, subset=None):
   150	    if subset is None:
   151	        subset = set(services.keys())
   152	    subset = set(subset)
   153	
   154	    in_degree = {s: 0 for s in subset}
   155	    adj = {s: [] for s in subset}
   156	
   157	    for s in subset:
   158	        for dep in services[s].get('depends_on', []):
   159	            if dep in subset:
   160	                adj[dep].append(s)
   161	                in_degree[s] += 1
   162	
   163	    order = []
   164	    available = sorted([s for s in subset if in_degree[s] == 0])
   165	    while available:
   166	        next_available = []
   167	        for s in available:
   168	            order.append(s)
   169	            for dependent in sorted(adj[s]):
   170	                in_degree[dependent] -= 1
   171	                if in_degree[dependent] == 0:
   172	                    next_available.append(dependent)
   173	        available = sorted(next_available)
   174	
   175	    if len(order) != len(subset):
   176	        fail("circular dependency detected")
   177	    return order
   178	
   179	def build_waves(services, subset):
   180	    subset = set(subset)
   181	
   182	    in_degree = {s: 0 for s in subset}
   183	    adj = {s: [] for s in subset}
   184	
   185	    for s in subset:
   186	        for dep in services[s].get('depends_on', []):
   187	            if dep in subset:
   188	                adj[dep].append(s)
   189	                in_degree[s] += 1
   190	
   191	    waves = []
   192	    available = sorted([s for s in subset if in_degree[s] == 0])
   193	    while available:
   194	        waves.append(available)
   195	        next_available = []
   196	        for s in available:
   197	            for dependent in sorted(adj[s]):
   198	                in_degree[dependent] -= 1
   199	                if in_degree[dependent] == 0:
   200	                    next_available.append(dependent)
   201	        available = sorted(next_available)
   202	
   203	    if sum(len(w) for w in waves) != len(subset):
   204	        fail("circular dependency detected")
   205	    return waves
   206	
   207	def transitive_deps(services, name):
   208	    if name not in services:
   209	        fail(f"service not found: {name}")
   210	    result = set()
   211	    stack = [name]
   212	    while stack:
   213	        s = stack.pop()
   214	        if s not in result:
   215	            result.add(s)
   216	            for dep in services[s].get('depends_on', []):
   217	                if dep not in services:
   218	                    fail(f"service {s} depends on undefined service: {dep}")
   219	                stack.append(dep)
   220	    return result
