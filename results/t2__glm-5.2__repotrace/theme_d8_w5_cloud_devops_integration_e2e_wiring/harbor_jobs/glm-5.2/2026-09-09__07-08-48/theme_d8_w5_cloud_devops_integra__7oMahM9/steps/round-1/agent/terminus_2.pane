   200	def transitive_deps(services, name):
   201	    if name not in services:
   202	        fail(f"service not found: {name}")
   203	    result = set()
   204	    stack = [name]
   205	    while stack:
   206	        s = stack.pop()
   207	        if s not in result:
   208	            result.add(s)
   209	            for dep in services[s].get('depends_on', []):
   210	                if dep not in services:
   211	                    fail(f"service {s} depends on undefined service: {dep}")
   212	                stack.append(dep)
   213	    return result
