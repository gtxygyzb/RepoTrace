    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\\n")

def assert_env_exists(env):
    data = load_manifest()
    _, envs = get_services(data)
    if env not in envs:
        fail(f"unknown environment '{env}'")

def config_file(env):
    return os.path.join(CONFIG_DIR, f"{env}.json")

def load_config(env):
    return load_json(config_file(env), {})

def save_config(env, cfg):
    save_json(config_file(env), cfg)

def validate_config_key(key):
    if not isinstance(key, str) or not re.match(r'^[A-Za-z_][A-Za-z0-9_]*$', key):
        fail(f"invalid key '{key}'")

def append_config_set_event(env, key, value):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "CONFIG_SET",
        "service": "-",
        "version": "-",
        "key": key,
        "value": value,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\\n")

def append_config_delete_event(env, key):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "CONFIG_DELETE",
        "service": "-",
        "version": "-",
        "key": key,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\\n")
