[?2004ldef append_event(env, action, service, version, source_env=None, forced=False):$
    ensure_state()$
    ts = now_iso()$
    line = f"{ts} {action} {service} {version}"$
    if action == "PROMOTE" and source_env is not None:$
        line += f" from {source_env}"$
        if forced:$
            line += " (forced)"$
    line += "\n"$
    with open(event_file(env), "a") as f:$
        f.write(line)$
def parse_opts(args, value_opts, flag_opts):$
    values = {}$
    flags = set()$
    positionals = []$
    i = 0$
    while i < len(args):$
        a = args[i]$
        if a in value_opts:$
            i += 1$
            if i >= len(args):$
                fail(f"{a} requires a value")$
            values[a] = args[i]$
        elif a in flag_opts:$
            flags.add(a)$
        elif a.startswith('--'):$
            fail(f"unknown option: {a}")$
        else:$
            positionals.append(a)$
        i += 1$
    return values, flags, positionals$
