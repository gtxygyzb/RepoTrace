    if "--limit" in values:
        try:
            limit = int(values["--limit"])
        except ValueError:
            fail("--limit requires an integer")
        if limit < 0:
            fail("--limit must be non-negative")

    data = load_manifest()
    _, envs = get_services(data)
    if env not in envs:
        fail(f"environment not found: {env}")

    ensure_state()
    try:
        with open(event_file(env)) as f:
            raw_lines = [line.rstrip("\n") for line in f if line.strip()]
    except FileNotFoundError:
        raw_lines = []

    entries = []
    for line in raw_lines:
        if line.startswith('{'):
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            action = ev.get("action")
            iso = ev.get("iso_timestamp", "")
            svc = ev.get("service", "-")
            if action == "LOCK":
                entries.append((iso, svc, f"{iso} LOCK {ev.get('reason', '')}"))
            elif action == "UNLOCK":
                entries.append((iso, svc, f"{iso} UNLOCK"))
            else:
                entries.append((iso, svc, line))
        else:
            parts = line.split()
            svc = parts[2] if len(parts) >= 3 else ""
            iso = parts[0] if parts else ""
            entries.append((iso, svc, line))

    if service:
        entries = [e for e in entries if e[1] == service]

    entries.reverse()
    entries = entries[:limit]
    for iso, svc, line in entries:
        print(line)

def print_tree(node, services, path, depth):
    print("  " * depth + node)
    if node in path:
        return
    path = path | {node}
    children = sorted([s for s in services if node in services[s].get('depends_on', [])])
    for child in children:
        print_tree(child, services, path, depth + 1)

def cmd_graph(args):
    values, flags, positionals = parse_opts(args, {'--format'}, set())
    if positionals:
        fail("graph does not accept positional arguments")

    fmt = values.get('--format', 'text')
    if fmt not in ('dot', 'text'):
        fail("graph format must be dot or text")

    data = load_manifest()
    services, _ = get_services(data)

    if fmt == 'dot':
        print("digraph pipeline {")
        for dep in sorted(services):
            dependents = sorted([s for s in services if dep in services[s].get('depends_on', [])])
            for dependent in dependents:
                print(f'  "{dep}" -> "{dependent}";')
        print("}")
    else:
        roots = sorted([s for s in services if not services[s].get('depends_on')])
        for root in roots:
            print_tree(root, services, set(), 0)

def cmd_bump(args):
    if len(args) != 2:
        fail("bump requires <service> <major|minor|patch>")

    service, level = args
    if level not in ('major', 'minor', 'patch'):
        fail("bump level must be major, minor, or patch")

    data = load_manifest()
    services = data.get('services')
    if not isinstance(services, dict) or service not in services:
        fail(f"service not found: {service}")

    old = services[service].get('version')
    sv = parse_semver(old)
    if sv is None:
        fail(f"service {service} has invalid version: {old}")

    major, minor, patch = sv
    if level == 'major':
        new = f"{major + 1}.0.0"
    elif level == 'minor':
        new = f"{major}.{minor + 1}.0"
    else:
        new = f"{major}.{minor}.{patch + 1}"

    services[service]['version'] = new
    with open(MANIFEST_PATH, 'w') as f:
        yaml.safe_dump(data, f, sort_keys=False)
    print(f"BUMP {service} {old} -> {new}")

def snapshot_file(env):
    return os.path.join(SNAPSHOTS_DIR, f"{env}.json")

def load_snapshots(env):
