 810: 
 811:     if dry_run:
 812:         print(f"DRY-RUN promote from {source} to {target}:")
 813:         for s in order:
 814:             src_version = source_state[s].get("version")
 815:             tgt_version = target_state.get(s, {}).get("version")
 816:             if src_version == tgt_version:
 817:                 continue
 818:             src_sv = extract_semver(src_version)
 819:             tgt_sv = extract_semver(tgt_version)
 820:             if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:
 821:                 print(f"  Would conflict {s} (downgrade)")
 822:             else:
 823:                 print(f"  Would promote {s}")
 824:         return
 825: 
 826:     promoted = 0
 827:     skipped = 0
 828:     conflicts = 0
 829:     promote_events = []
 830: 
 831:     for s in order:
 832:         src_rec = source_state[s]
 833:         src_version = src_rec.get("version")
 834:         if target_state.get(s, {}).get("version") == src_version:
 835:             print(f"PROMOTE {s} -> {target}: SKIP (same version)")
 836:             skipped += 1
 837:             continue
 838: 
 839:         src_sv = extract_semver(src_version)
 840:         tgt_sv = extract_semver(target_state.get(s, {}).get("version"))
 841:         if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:
 842:             if force:
 843:                 target_state[s] = src_rec
 844:                 target_replicas[s] = 1
 845:                 print(f"PROMOTE {s} -> {target} OK (forced)")
 846:                 promoted += 1
 847:                 promote_events.append((s, src_version, True))
 848:             else:
 849:                 print(f"CONFLICT: {s} -> {target}: downgrade ({src_sv[0]}.{src_sv[1]}.{src_sv[2]} < {tgt_sv[0]}.{tgt_sv[1]}.{tgt_sv[2]})")
 850:                 conflicts += 1
 851:             continue
 852: 
 853:         target_state[s] = src_rec
 854:         target_replicas[s] = 1
 855:         print(f"PROMOTE {s} -> {target} OK")
 856:         promoted += 1
 857:         promote_events.append((s, src_version, False))
 858: 
 859:     save_deployment_state(target, target_state)
 860:     save_replicas(target, target_replicas)
