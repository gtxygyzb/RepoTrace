def find_rollback_target(env, service, current_version, to_version=None):
    events = load_events(env)

    if to_version is not None:
        for ev in reversed(events):
            if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] == to_version:
                return to_version
        fail(f"version not found in history for {service}")

    current_idx = None
    for idx, ev in enumerate(events):
        if ev["service"] != service:
            continue
        if ev["version"] != current_version:
            continue
        if ev["action"] == "ROLLBACK" and ev["version"] == "-":
            continue
        current_idx = idx

    if current_idx is None:
        return None

    for ev in reversed(events[:current_idx]):
        if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] != current_version:
            return ev["version"]
    return None
