  1006	def valid_version(v):
  1007	    if not isinstance(v, str):
  1008	        return False
  1009	    parts = v.split('.')
  1010	    if len(parts) != 3:
  1011	        return False
  1012	    for part in parts:
  1013	        if not part.isdigit() or (part != '0' and part.startswith('0')):
  1014	            return False
  1015	    return True
  1016	
  1017	def parse_semver(v):
  1018	    if not valid_version(v):
  1019	        return None
  1020	    return tuple(int(x) for x in v.split('.'))
  1021	
  1022	def extract_semver(version):
  1023	    if not isinstance(version, str):
  1024	        return None
  1025	    semver = version.split(':', 1)[1] if ':' in version else version
  1026	    if '+build.' in semver:
  1027	        semver = semver.split('+build.', 1)[0]
  1028	    return parse_semver(semver)
  1029	
  1030	def semver_string(version):
  1031	    sv = extract_semver(version)
  1032	    if sv is None:
  1033	        return None
  1034	    return f"{sv[0]}.{sv[1]}.{sv[2]}"
  1035	
  1036	def version_build_timestamp(version):
  1037	    if not isinstance(version, str) or '+build.' not in version:
  1038	        return None
  1039	    after = version.split('+build.', 1)[1]
  1040	    try:
  1041	        return int(after)
  1042	    except ValueError:
  1043	        return None
  1044	
  1045	def compare_versions(a, b):
  1046	    sa = extract_semver(a)
  1047	    sb = extract_semver(b)
  1048	    if sa is not None and sb is not None:
  1049	        if sa != sb:
  1050	            return 1 if sa > sb else -1
  1051	        ta = version_build_timestamp(a)
  1052	        tb = version_build_timestamp(b)
  1053	        if ta is not None and tb is not None and ta != tb:
  1054	            return 1 if ta > tb else -1
  1055	        return 0
  1056	    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)
