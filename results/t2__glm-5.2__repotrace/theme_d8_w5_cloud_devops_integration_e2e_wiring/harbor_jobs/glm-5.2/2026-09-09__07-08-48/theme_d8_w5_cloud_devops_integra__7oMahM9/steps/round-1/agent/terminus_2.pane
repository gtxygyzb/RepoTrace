    76	def validate_manifest(data):
    77	    if not isinstance(data, dict):
    78	        raise ValueError("manifest must be a mapping")
    79	
    80	    services = data.get('services')
    81	    if not isinstance(services, dict) or not services:
    82	        raise ValueError("manifest missing services")
    83	
    84	    environments = data.get('environments')
    85	    if not isinstance(environments, dict) or not environments:
    86	        raise ValueError("manifest missing environments")
    87	
    88	    for env_name, env in environments.items():
    89	        if not isinstance(env, dict):
    90	            raise ValueError(f"environment {env_name} must be a mapping")
    91	        for field in ENV_FIELDS:
    92	            if field not in env:
    93	                raise ValueError(f"environment {env_name} missing required field: {field}")
    94	
    95	    for name, svc in services.items():
    96	        if not isinstance(svc, dict):
    97	            raise ValueError(f"service {name} must be a mapping")
    98	        for field in SERVICE_FIELDS:
    99	            if field not in svc:
   100	                raise ValueError(f"service {name} missing required field: {field}")
   101	        if not isinstance(svc['depends_on'], list):
   102	            raise ValueError(f"service {name} has invalid depends_on: must be a list")
   103	        for dep in svc['depends_on']:
   104	            if dep not in services:
   105	                raise ValueError(f"service {name} depends on undefined service: {dep}")
   106	        if not valid_version(svc.get('version')):
   107	            raise ValueError(f"service {name} has invalid version: expected N.N.N")
   108	
   109	    port_map = {}
   110	    for name, svc in services.items():
   111	        port = svc['port']
   112	        if port in port_map:
   113	            raise ValueError(f"duplicate port assignment: {port}")
   114	        port_map[port] = name
   115	
   116	    cycle = find_cycle(services)
   117	    if cycle:
   118	        raise ValueError(f"circular dependency detected: {' -> '.join(cycle)}")
   119	
   120	    return True
   121	
   122	def find_cycle(services):
   123	    visited = {}
   124	    stack = []
   125	
   126	    def dfs(node):
   127	        visited[node] = 1
   128	        stack.append(node)
   129	        for dep in services[node].get('depends_on', []):
   130	            if dep not in services:
   131	                continue
   132	            if visited.get(dep) == 1:
   133	                idx = stack.index(dep)
   134	                return stack[idx:] + [dep]
   135	            if visited.get(dep) is None:
   136	                res = dfs(dep)
   137	                if res:
   138	                    return res
   139	        stack.pop()
   140	        visited[node] = 2
   141	        return None
   142	
   143	    for n in sorted(services):
   144	        if visited.get(n) is None:
   145	            res = dfs(n)
   146	            if res:
   147	                return res
   148	    return None
