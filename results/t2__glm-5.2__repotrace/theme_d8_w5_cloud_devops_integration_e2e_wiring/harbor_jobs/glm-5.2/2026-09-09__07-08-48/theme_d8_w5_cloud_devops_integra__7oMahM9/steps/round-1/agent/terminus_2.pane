   213	def transitive_deps(services, name):
   214	    if name not in services:
   215	        fail(f"service not found: {name}")
   216	    result = set()
   217	    stack = [name]
   218	    while stack:
   219	        s = stack.pop()
   220	        if s not in result:
   221	            result.add(s)
   222	            for dep in services[s].get('depends_on', []):
   223	                if dep not in services:
   224	                    fail(f"service {s} depends on undefined service: {dep}")
   225	                stack.append(dep)
   226	    return result
