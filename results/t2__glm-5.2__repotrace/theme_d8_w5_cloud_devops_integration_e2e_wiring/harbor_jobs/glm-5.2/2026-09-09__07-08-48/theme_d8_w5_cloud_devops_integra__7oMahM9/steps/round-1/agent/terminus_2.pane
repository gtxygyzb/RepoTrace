   470	def validate_quota_resource(resource):
   471	    if resource not in quota_supported_resources():
   472	        fail(f"unknown quota resource '{resource}' (must be max_services or max_total_replicas)")
   473	
   474	def quota_current_usage(env, resource):
   475	    state = load_deployment_state(env)
   476	    replicas = load_replicas(env)
   477	    if resource == 'max_services':
   478	        return len(state)
   479	    if resource == 'max_total_replicas':
   480	        return sum(replicas.get(svc, 1) for svc in state)
   481	    fail(f"unknown quota resource '{resource}' (must be max_services or max_total_replicas)")
