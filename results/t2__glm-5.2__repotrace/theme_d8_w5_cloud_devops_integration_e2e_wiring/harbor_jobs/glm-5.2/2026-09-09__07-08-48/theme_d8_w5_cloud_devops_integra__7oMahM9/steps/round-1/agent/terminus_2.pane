   376	def load_events(env):
   377	    ensure_state()
   378	    try:
   379	        with open(event_file(env)) as f:
   380	            lines = [line.rstrip("\n") for line in f if line.strip()]
   381	    except FileNotFoundError:
   382	        return []
   383	    events = []
   384	    for line in lines:
   385	        if line.startswith('{'):
   386	            continue
   387	        parts = line.split()
   388	        if len(parts) < 4:
   389	            continue
   390	        events.append({
   391	            "timestamp": parts[0],
   392	            "action": parts[1],
   393	            "service": parts[2],
   394	            "version": parts[3],
   395	            "line": line,
   396	        })
   397	    return events
