   144	def topo_order(services, subset=None):
   145	    if subset is None:
   146	        subset = set(services.keys())
   147	    subset = set(subset)
   148	
   149	    in_degree = {s: 0 for s in subset}
   150	    adj = {s: [] for s in subset}
   151	
   152	    for s in subset:
   153	        for dep in services[s].get('depends_on', []):
   154	            if dep in subset:
   155	                adj[dep].append(s)
   156	                in_degree[s] += 1
   157	
   158	    order = []
   159	    available = sorted([s for s in subset if in_degree[s] == 0])
   160	    while available:
   161	        next_available = []
   162	        for s in available:
   163	            order.append(s)
   164	            for dependent in sorted(adj[s]):
   165	                in_degree[dependent] -= 1
   166	                if in_degree[dependent] == 0:
   167	                    next_available.append(dependent)
   168	        available = sorted(next_available)
   169	
   170	    if len(order) != len(subset):
   171	        fail("circular dependency detected")
   172	    return order
   173	
   174	def build_waves(services, subset):
   175	    subset = set(subset)
   176	
   177	    in_degree = {s: 0 for s in subset}
   178	    adj = {s: [] for s in subset}
   179	
   180	    for s in subset:
   181	        for dep in services[s].get('depends_on', []):
   182	            if dep in subset:
   183	                adj[dep].append(s)
   184	                in_degree[s] += 1
   185	
   186	    waves = []
   187	    available = sorted([s for s in subset if in_degree[s] == 0])
   188	    while available:
   189	        waves.append(available)
   190	        next_available = []
   191	        for s in available:
   192	            for dependent in sorted(adj[s]):
   193	                in_degree[dependent] -= 1
   194	                if in_degree[dependent] == 0:
   195	                    next_available.append(dependent)
   196	        available = sorted(next_available)
   197	
   198	    if sum(len(w) for w in waves) != len(subset):
   199	        fail("circular dependency detected")
   200	    return waves
   201	
   202	def transitive_deps(services, name):
   203	    if name not in services:
   204	        fail(f"service not found: {name}")
   205	    result = set()
   206	    stack = [name]
   207	    while stack:
   208	        s = stack.pop()
   209	        if s not in result:
   210	            result.add(s)
   211	            for dep in services[s].get('depends_on', []):
   212	                if dep not in services:
   213	                    fail(f"service {s} depends on undefined service: {dep}")
   214	                stack.append(dep)
   215	    return result
