   892	def print_tree(node, services, path, depth):
   893	    print("  " * depth + node)
   894	    if node in path:
   895	        return
   896	    path = path | {node}
   897	    children = sorted([s for s in services if node in services[s].get('depends_on', [])])
   898	    for child in children:
   899	        print_tree(child, services, path, depth + 1)
