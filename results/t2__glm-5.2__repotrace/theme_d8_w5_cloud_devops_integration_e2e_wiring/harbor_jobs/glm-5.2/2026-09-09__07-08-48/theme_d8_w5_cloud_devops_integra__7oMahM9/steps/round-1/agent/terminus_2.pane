   412	def parse_opts(args, value_opts, flag_opts):
   413	    values = {}
   414	    flags = set()
   415	    positionals = []
   416	    i = 0
   417	    while i < len(args):
   418	        a = args[i]
   419	        if a in value_opts:
   420	            i += 1
   421	            if i >= len(args):
   422	                fail(f"{a} requires a value")
   423	            values[a] = args[i]
   424	        elif a in flag_opts:
   425	            flags.add(a)
   426	        elif a.startswith('--'):
   427	            fail(f"unknown option: {a}")
   428	        else:
   429	            positionals.append(a)
   430	        i += 1
   431	    return values, flags, positionals
