   278	def find_rollback_target(env, service, current_version, to_version=None):
   279	    events = load_events(env)
   280	
   281	    if to_version is not None:
   282	        for ev in reversed(events):
   283	            if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] == to_version:
   284	                return to_version
   285	        fail(f"version not found in history for {service}")
   286	
   287	    current_idx = None
   288	    for idx, ev in enumerate(events):
   289	        if ev["service"] != service:
   290	            continue
   291	        if ev["version"] != current_version:
   292	            continue
   293	        if ev["action"] == "ROLLBACK" and ev["version"] == "-":
   294	            continue
   295	        current_idx = idx
   296	
   297	    if current_idx is None:
   298	        return None
   299	
   300	    for ev in reversed(events[:current_idx]):
   301	        if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] != current_version:
   302	            return ev["version"]
   303	    return None
