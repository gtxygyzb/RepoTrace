   105	def find_cycle(services):
   106	    visited = {}
   107	    stack = []
   108	
   109	    def dfs(node):
   110	        visited[node] = 1
   111	        stack.append(node)
   112	        for dep in services[node].get('depends_on', []):
   113	            if dep not in services:
   114	                continue
   115	            if visited.get(dep) == 1:
   116	                idx = stack.index(dep)
   117	                return stack[idx:] + [dep]
   118	            if visited.get(dep) is None:
   119	                res = dfs(dep)
   120	                if res:
   121	                    return res
   122	        stack.pop()
   123	        visited[node] = 2
   124	        return None
   125	
   126	    for n in sorted(services):
   127	        if visited.get(n) is None:
   128	            res = dfs(n)
   129	            if res:
   130	                return res
   131	    return None
