   243	def append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):
   244	    ensure_state()
   245	    ts = now_iso()
   246	    line = f"{ts} {action} {service} {version}"
   247	    if action == "PROMOTE" and source_env is not None:
   248	        line += f" from {source_env}"
   249	        if forced:
   250	            line += " (forced)"
   251	    if action == "RESTORE" and snapshot_id is not None:
   252	        line += f" from snapshot #{snapshot_id}"
   253	    line += "\n"
   254	    with open(event_file(env), "a") as f:
   255	        f.write(line)
   256	
   257	def load_events(env):
   258	    ensure_state()
   259	    try:
   260	        with open(event_file(env)) as f:
   261	            lines = [line.rstrip("\n") for line in f if line.strip()]
   262	    except FileNotFoundError:
   263	        return []
   264	    events = []
   265	    for line in lines:
   266	        parts = line.split()
   267	        if len(parts) < 4:
   268	            continue
   269	        events.append({
   270	            "timestamp": parts[0],
   271	            "action": parts[1],
   272	            "service": parts[2],
   273	            "version": parts[3],
   274	            "line": line,
   275	        })
   276	    return events
   277	
   278	def find_rollback_target(env, service, current_version, to_version=None):
   279	    events = load_events(env)
   280	
   281	    if to_version is not None:
   282	        for ev in reversed(events):
   283	            if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] == to_version:
   284	                return to_version
   285	        fail(f"version not found in history for {service}")
   286	
   287	    current_idx = None
   288	    for idx, ev in enumerate(events):
   289	        if ev["service"] != service:
   290	            continue
   291	        if ev["version"] != current_version:
   292	            continue
   293	        if ev["action"] == "ROLLBACK" and ev["version"] == "-":
   294	            continue
   295	        current_idx = idx
   296	
   297	    if current_idx is None:
   298	        return None
   299	
   300	    for ev in reversed(events[:current_idx]):
   301	        if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] != current_version:
   302	            return ev["version"]
   303	    return None
