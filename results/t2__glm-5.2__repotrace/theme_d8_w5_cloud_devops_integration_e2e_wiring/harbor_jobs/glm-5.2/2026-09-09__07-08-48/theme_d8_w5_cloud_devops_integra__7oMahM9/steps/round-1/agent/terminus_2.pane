   334	def find_rollback_target(env, service, current_version, to_version=None):
   335	    events = load_events(env)
   336	
   337	    if to_version is not None:
   338	        for ev in reversed(events):
   339	            if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] == to_version:
   340	                return to_version
   341	        fail(f"version not found in history for {service}")
   342	
   343	    current_idx = None
   344	    for idx, ev in enumerate(events):
   345	        if ev["service"] != service:
   346	            continue
   347	        if ev["version"] != current_version:
   348	            continue
   349	        if ev["action"] == "ROLLBACK" and ev["version"] == "-":
   350	            continue
   351	        current_idx = idx
   352	
   353	    if current_idx is None:
   354	        return None
   355	
   356	    for ev in reversed(events[:current_idx]):
   357	        if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] != current_version:
   358	            return ev["version"]
   359	    return None
