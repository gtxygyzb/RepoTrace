def append_scale_event(env, service, count, previous):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "SCALE",
        "service": service,
        "version": "-",
        "replicas": count,
        "previous": previous,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + chr(10))

def load_events(env):
    ensure_state()
    try:
        with open(event_file(env)) as f:
            lines = [line.rstrip("\n") for line in f if line.strip()]
    except FileNotFoundError:
        return []
    events = []
    for line in lines:
        if line.startswith('{'):
            continue
        parts = line.split()
        if len(parts) < 4:
            continue
        events.append({
            "timestamp": parts[0],
            "action": parts[1],
            "service": parts[2],
            "version": parts[3],
            "line": line,
        })
    return events

def lock_file(env):
    return os.path.join(LOCK_DIR, f"{env}.json")

def load_lock(env):
    return load_json(lock_file(env), None)

def save_lock(env, reason):
    ensure_state()
    existing = load_lock(env)
    locked_since = existing.get('locked_since', now_iso()) if existing else now_iso()
    lock = {"reason": reason, "locked_since": locked_since}
    save_json(lock_file(env), lock)

def remove_lock(env):
    try:
        os.remove(lock_file(env))
    except FileNotFoundError:
        pass

def is_locked(env):
    return load_lock(env) is not None

def assert_not_locked(env):
    lock = load_lock(env)
    if lock is not None:
        fail(f"{env} is locked ({lock.get('reason', 'manual lock')})")

def append_lock_event(env, reason):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "LOCK",
        "service": "-",
        "version": "-",
        "reason": reason,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\n")

def append_unlock_event(env):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "UNLOCK",
        "service": "-",
        "version": "-",
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\n")

def assert_env_exists(env):
    data = load_manifest()
    _, envs = get_services(data)
    if env not in envs:
        fail(f"unknown environment '{env}'")

def config_file(env):
    return os.path.join(CONFIG_DIR, f"{env}.json")

def load_config(env):
    return load_json(config_file(env), {})

def save_config(env, cfg):
    save_json(config_file(env), cfg)

def validate_config_key(key):
    if not isinstance(key, str) or not re.match(r'^[A-Za-z_][A-Za-z0-9_]*$', key):
        fail(f"invalid key '{key}'")

def append_config_set_event(env, key, value):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "CONFIG_SET",
        "service": "-",
        "version": "-",
        "key": key,
        "value": value,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\n")

def append_config_delete_event(env, key):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "CONFIG_DELETE",
        "service": "-",
        "version": "-",
        "key": key,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\n")

def find_rollback_target(env, service, current_version, to_version=None):
    events = load_events(env)

    if to_version is not None:
        for ev in reversed(events):
            if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] == to_version:
                return to_version
        fail(f"version not found in history for {service}")

    current_idx = None
    for idx, ev in enumerate(events):
        if ev["service"] != service:
            continue
        if ev["version"] != current_version:
            continue
        if ev["action"] == "ROLLBACK" and ev["version"] == "-":
            continue
        current_idx = idx

    if current_idx is None:
        return None

    for ev in reversed(events[:current_idx]):
        if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] != current_version:
            return ev["version"]
    return None

def parse_opts(args, value_opts, flag_opts):
    values = {}
    flags = set()
    positionals = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in value_opts:
            i += 1
            if i >= len(args):
                fail(f"{a} requires a value")
            values[a] = args[i]
        elif a in flag_opts:
            flags.add(a)
        elif a.startswith('--'):
            fail(f"unknown option: {a}")
        else:
            positionals.append(a)
        i += 1
    return values, flags, positionals

def cmd_validate(args):
    if args:
        fail("validate takes no arguments")
    data = load_manifest()
    try:
        validate_manifest(data)
    except ValueError as e:
        print(f"ERROR: {e}")
        sys.exit(1)
    print("VALID")

def cmd_order(args):
    if args:
        fail("order takes no arguments")
    data = load_manifest()
    services, _ = get_services(data)
    for s in topo_order(services):
        print(s)

def cmd_build(args):
    values, flags, positionals = parse_opts(args, {'--service'}, {'--parallel'})
    if positionals:
        fail("build does not accept positional arguments")

    service = values.get('--service')
    parallel = '--parallel' in flags

    data = load_manifest()
[?2004hroot@n30009:/app# sed -n '520,760p' pipeline.sh
[?2004l    data = load_manifest()
    services, _ = get_services(data)

    if service:
        subset = transitive_deps(services, service)
    else:
        subset = set(services.keys())

