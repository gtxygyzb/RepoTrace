   296	def append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):
   297	    ensure_state()
   298	    ts = now_iso()
   299	    line = f"{ts} {action} {service} {version}"
   300	    if action == "PROMOTE" and source_env is not None:
   301	        line += f" from {source_env}"
   302	        if forced:
   303	            line += " (forced)"
   304	    if action == "RESTORE" and snapshot_id is not None:
   305	        line += f" from snapshot #{snapshot_id}"
   306	    line += "\n"
   307	    with open(event_file(env), "a") as f:
   308	        f.write(line)
   309	
   310	def append_scale_event(env, service, count, previous):
   311	    ensure_state()
   312	    event = {
   313	        "timestamp": int(time.time()),
   314	        "iso_timestamp": now_iso(),
   315	        "action": "SCALE",
   316	        "service": service,
   317	        "version": "-",
   318	        "replicas": count,
   319	        "previous": previous,
   320	    }
   321	    with open(event_file(env), "a") as f:
   322	        f.write(json.dumps(event) + chr(10))
