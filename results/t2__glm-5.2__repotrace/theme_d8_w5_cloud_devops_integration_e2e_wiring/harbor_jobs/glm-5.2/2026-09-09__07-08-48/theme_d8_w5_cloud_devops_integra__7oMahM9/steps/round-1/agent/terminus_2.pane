   804	def valid_version(v):
   805	    if not isinstance(v, str):
   806	        return False
   807	    parts = v.split('.')
   808	    if len(parts) != 3:
   809	        return False
   810	    for part in parts:
   811	        if not part.isdigit() or (part != '0' and part.startswith('0')):
   812	            return False
   813	    return True
   814	
   815	def parse_semver(v):
   816	    if not valid_version(v):
   817	        return None
   818	    return tuple(int(x) for x in v.split('.'))
   819	
   820	def extract_semver(version):
   821	    if not isinstance(version, str):
   822	        return None
   823	    semver = version.split(':', 1)[1] if ':' in version else version
   824	    if '+build.' in semver:
   825	        semver = semver.split('+build.', 1)[0]
   826	    return parse_semver(semver)
   827	
   828	def semver_string(version):
   829	    sv = extract_semver(version)
   830	    if sv is None:
   831	        return None
   832	    return f"{sv[0]}.{sv[1]}.{sv[2]}"
   833	
   834	def version_build_timestamp(version):
   835	    if not isinstance(version, str) or '+build.' not in version:
   836	        return None
   837	    after = version.split('+build.', 1)[1]
   838	    try:
   839	        return int(after)
   840	    except ValueError:
   841	        return None
   842	
   843	def compare_versions(a, b):
   844	    sa = extract_semver(a)
   845	    sb = extract_semver(b)
   846	    if sa is not None and sb is not None:
   847	        if sa != sb:
   848	            return 1 if sa > sb else -1
   849	        ta = version_build_timestamp(a)
   850	        tb = version_build_timestamp(b)
   851	        if ta is not None and tb is not None and ta != tb:
   852	            return 1 if ta > tb else -1
   853	        return 0
   854	    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)
   855	def cmd_promote(args):
   856	    values, flags, positionals = parse_opts(args, {"--service"}, {"--dry-run", "--force"})
   857	    if len(positionals) != 2:
   858	        fail("promote requires <source-env> <target-env>")
   859	
