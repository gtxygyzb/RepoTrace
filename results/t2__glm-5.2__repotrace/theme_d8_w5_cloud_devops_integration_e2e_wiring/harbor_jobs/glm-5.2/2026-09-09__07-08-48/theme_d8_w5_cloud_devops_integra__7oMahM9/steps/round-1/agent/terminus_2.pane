[?2004l    if not parts:
        return None
    return "Quotas: " + ", ".join(parts)

def cmd_quota(args):
    if not args:
        fail("quota requires <environment> <set|get|list|remove|--check> [args]")
    env = args[0]
    if len(args) < 2:
        fail("quota requires <environment> <set|get|list|remove|--check> [args]")
    sub = args[1]
    rest = args[2:]

    assert_env_exists(env)

    if sub == 'set':
        if len(rest) != 2:
            fail("quota <environment> set <resource> <limit>")
        resource, limit_str = rest
        validate_quota_resource(resource)
        limit = parse_positive_int(limit_str)
        if limit is None:
            fail(f"invalid quota limit '{limit_str}'")
        assert_not_locked(env)
        quotas = load_quotas(env)
        quotas[resource] = limit
        save_quotas(env, quotas)
        append_quota_set_event(env, resource, limit)
        print(f"QUOTA {env}: {resource}={limit}")
    elif sub == 'get':
        if len(rest) != 1:
            fail("quota <environment> get <resource>")
        resource = rest[0]
        validate_quota_resource(resource)
        quotas = load_quotas(env)
        usage = quota_current_usage(env, resource)
        if resource in quotas:
            print(f"{resource}: {quotas[resource]} (current: {usage})")
        else:
            print(f"{resource}: not set (current: {usage})")
    elif sub == 'list':
        quotas = load_quotas(env)
        for resource in quota_supported_resources():
            if resource in quotas:
                usage = quota_current_usage(env, resource)
                print(f"{resource}: {quotas[resource]} (current: {usage})")
    elif sub == 'remove':
        if len(rest) != 1:
            fail("quota <environment> remove <resource>")
        resource = rest[0]
        validate_quota_resource(resource)
        assert_not_locked(env)
        quotas = load_quotas(env)
        if resource not in quotas:
            fail(f"quota '{resource}' not set in {env}")
        del quotas[resource]
        save_quotas(env, quotas)
        append_quota_remove_event(env, resource)
        print(f"QUOTA {env}: removed {resource}")
    elif sub == '--check':
        quotas = load_quotas(env)
        exceeded = 0
        for resource in quota_supported_resources():
            if resource in quotas:
                limit = quotas[resource]
                usage = quota_current_usage(env, resource)
                if usage > limit:
                    print(f"{resource}: EXCEEDED ({usage}/{limit})")
                    exceeded += 1
                else:
                    print(f"{resource}: OK ({usage}/{limit})")
        if exceeded:
            print(f"{exceeded} quota(s) exceeded")
        else:
            print("All quotas OK")
    else:
        fail("quota requires <environment> <set|get|list|remove|--check> [args]")

def config_file(env):
