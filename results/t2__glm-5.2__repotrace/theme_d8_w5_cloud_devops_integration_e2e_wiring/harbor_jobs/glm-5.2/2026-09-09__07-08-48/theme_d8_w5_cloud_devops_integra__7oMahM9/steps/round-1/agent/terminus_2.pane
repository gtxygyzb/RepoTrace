        cmd_history(args)
    elif cmd == 'graph':
        cmd_graph(args)
    elif cmd == 'bump':
        cmd_bump(args)
    elif cmd == 'snapshot':
        cmd_snapshot(args)
    elif cmd == 'restore':
        cmd_restore(args)
    elif cmd == 'lock':
        cmd_lock(args)
    elif cmd == 'unlock':
        cmd_unlock(args)
    else:
        fail(f"unknown command: {cmd}")

if __name__ == '__main__':
    main()
