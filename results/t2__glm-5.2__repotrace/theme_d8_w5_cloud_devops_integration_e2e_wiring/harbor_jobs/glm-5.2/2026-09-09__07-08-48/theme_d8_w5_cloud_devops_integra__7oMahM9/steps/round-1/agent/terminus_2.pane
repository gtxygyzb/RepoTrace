   308	    positionals = []
   309	    i = 0
   310	    while i < len(args):
   311	        a = args[i]
   312	        if a in value_opts:
   313	            i += 1
   314	            if i >= len(args):
   315	                fail(f"{a} requires a value")
   316	            values[a] = args[i]
   317	        elif a in flag_opts:
   318	            flags.add(a)
   319	        elif a.startswith('--'):
   320	            fail(f"unknown option: {a}")
   321	        else:
   322	            positionals.append(a)
   323	        i += 1
   324	    return values, flags, positionals
