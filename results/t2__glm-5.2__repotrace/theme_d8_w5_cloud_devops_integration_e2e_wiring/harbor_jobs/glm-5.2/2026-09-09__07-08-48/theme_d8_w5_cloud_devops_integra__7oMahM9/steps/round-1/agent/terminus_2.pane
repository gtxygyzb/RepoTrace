   967	def print_tree(node, services, path, depth):
   968	    print("  " * depth + node)
   969	    if node in path:
   970	        return
   971	    path = path | {node}
   972	    children = sorted([s for s in services if node in services[s].get('depends_on', [])])
   973	    for child in children:
   974	        print_tree(child, services, path, depth + 1)
