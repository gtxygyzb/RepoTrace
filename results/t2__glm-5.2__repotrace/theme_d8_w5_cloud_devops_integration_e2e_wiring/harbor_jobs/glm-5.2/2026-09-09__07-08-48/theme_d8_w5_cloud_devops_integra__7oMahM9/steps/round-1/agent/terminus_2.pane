   510	def quota_status_line(env):
   511	    quotas = load_quotas(env)
   512	    if not quotas:
   513	        return None
   514	    parts = []
   515	    for resource in quota_supported_resources():
   516	        if resource in quotas:
   517	            limit = quotas[resource]
   518	            usage = quota_current_usage(env, resource)
   519	            parts.append(f"{resource}={limit} ({usage}/{limit})")
   520	    if not parts:
   521	        return None
   522	    return "Quotas: " + ", ".join(parts)
   523	
   524	def cmd_quota(args):
   525	    if not args:
   526	        fail("quota requires <environment> <set|get|list|remove|--check> [args]")
   527	    env = args[0]
   528	    if len(args) < 2:
   529	        fail("quota requires <environment> <set|get|list|remove|--check> [args]")
   530	    sub = args[1]
   531	    rest = args[2:]
   532	
   533	    assert_env_exists(env)
   534	
   535	    if sub == 'set':
