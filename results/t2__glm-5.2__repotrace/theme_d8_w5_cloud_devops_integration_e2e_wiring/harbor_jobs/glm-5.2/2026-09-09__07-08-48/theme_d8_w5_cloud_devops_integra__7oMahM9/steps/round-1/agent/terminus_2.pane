   615	def print_tree(node, services, path, depth):
   616	    print("  " * depth + node)
   617	    if node in path:
   618	        return
   619	    path = path | {node}
   620	    children = sorted([s for s in services if node in services[s].get('depends_on', [])])
   621	    for child in children:
   622	        print_tree(child, services, path, depth + 1)
   623	
   624	def cmd_graph(args):
   625	    values, flags, positionals = parse_opts(args, {'--format'}, set())
   626	    if positionals:
   627	        fail("graph does not accept positional arguments")
   628	
   629	    fmt = values.get('--format', 'text')
   630	    if fmt not in ('dot', 'text'):
   631	        fail("graph format must be dot or text")
   632	
   633	    data = load_manifest()
   634	    services, _ = get_services(data)
   635	
   636	    if fmt == 'dot':
   637	        print("digraph pipeline {")
   638	        for dep in sorted(services):
   639	            dependents = sorted([s for s in services if dep in services[s].get('depends_on', [])])
   640	            for dependent in dependents:
   641	                print(f'  "{dep}" -> "{dependent}";')
   642	        print("}")
   643	    else:
   644	        roots = sorted([s for s in services if not services[s].get('depends_on')])
   645	        for root in roots:
   646	            print_tree(root, services, set(), 0)
