   361	def parse_opts(args, value_opts, flag_opts):
   362	    values = {}
   363	    flags = set()
   364	    positionals = []
   365	    i = 0
   366	    while i < len(args):
   367	        a = args[i]
   368	        if a in value_opts:
   369	            i += 1
   370	            if i >= len(args):
   371	                fail(f"{a} requires a value")
   372	            values[a] = args[i]
   373	        elif a in flag_opts:
   374	            flags.add(a)
   375	        elif a.startswith('--'):
   376	            fail(f"unknown option: {a}")
   377	        else:
   378	            positionals.append(a)
   379	        i += 1
   380	    return values, flags, positionals
