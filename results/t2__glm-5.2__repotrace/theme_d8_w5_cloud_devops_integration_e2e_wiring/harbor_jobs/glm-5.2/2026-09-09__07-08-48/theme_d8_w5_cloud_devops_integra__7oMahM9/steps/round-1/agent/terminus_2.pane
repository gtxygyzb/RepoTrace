   155	def topo_order(services, subset=None):
   156	    if subset is None:
   157	        subset = set(services.keys())
   158	    subset = set(subset)
   159	
   160	    in_degree = {s: 0 for s in subset}
   161	    adj = {s: [] for s in subset}
   162	
   163	    for s in subset:
   164	        for dep in services[s].get('depends_on', []):
   165	            if dep in subset:
   166	                adj[dep].append(s)
   167	                in_degree[s] += 1
   168	
   169	    order = []
   170	    available = sorted([s for s in subset if in_degree[s] == 0])
   171	    while available:
   172	        next_available = []
   173	        for s in available:
   174	            order.append(s)
   175	            for dependent in sorted(adj[s]):
   176	                in_degree[dependent] -= 1
   177	                if in_degree[dependent] == 0:
   178	                    next_available.append(dependent)
   179	        available = sorted(next_available)
   180	
   181	    if len(order) != len(subset):
   182	        fail("circular dependency detected")
   183	    return order
