   157	def topo_order(services, subset=None):
   158	    if subset is None:
   159	        subset = set(services.keys())
   160	    subset = set(subset)
   161	
   162	    in_degree = {s: 0 for s in subset}
   163	    adj = {s: [] for s in subset}
   164	
   165	    for s in subset:
   166	        for dep in services[s].get('depends_on', []):
   167	            if dep in subset:
   168	                adj[dep].append(s)
   169	                in_degree[s] += 1
   170	
   171	    order = []
   172	    available = sorted([s for s in subset if in_degree[s] == 0])
   173	    while available:
   174	        next_available = []
   175	        for s in available:
   176	            order.append(s)
   177	            for dependent in sorted(adj[s]):
   178	                in_degree[dependent] -= 1
   179	                if in_degree[dependent] == 0:
   180	                    next_available.append(dependent)
   181	        available = sorted(next_available)
   182	
   183	    if len(order) != len(subset):
   184	        fail("circular dependency detected")
   185	    return order
   186	
   187	def build_waves(services, subset):
   188	    subset = set(subset)
   189	
   190	    in_degree = {s: 0 for s in subset}
   191	    adj = {s: [] for s in subset}
   192	
   193	    for s in subset:
   194	        for dep in services[s].get('depends_on', []):
   195	            if dep in subset:
   196	                adj[dep].append(s)
   197	                in_degree[s] += 1
   198	
   199	    waves = []
   200	    available = sorted([s for s in subset if in_degree[s] == 0])
   201	    while available:
   202	        waves.append(available)
   203	        next_available = []
   204	        for s in available:
   205	            for dependent in sorted(adj[s]):
   206	                in_degree[dependent] -= 1
   207	                if in_degree[dependent] == 0:
   208	                    next_available.append(dependent)
   209	        available = sorted(next_available)
   210	
   211	    if sum(len(w) for w in waves) != len(subset):
   212	        fail("circular dependency detected")
   213	    return waves
