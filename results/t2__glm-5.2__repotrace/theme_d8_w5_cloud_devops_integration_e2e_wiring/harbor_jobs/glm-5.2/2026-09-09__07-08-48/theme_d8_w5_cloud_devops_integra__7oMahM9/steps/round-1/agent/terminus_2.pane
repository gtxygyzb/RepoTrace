environments:
  staging:
    deploy_target: /deployments/staging
    health_check_port: 8080
    max_replicas: 2
  production:
    deploy_target: /deployments/production
    health_check_port: 8080
    max_replicas: 4
services:
  api-gateway:
    version: 2.1.0
    path: services/api-gateway
    build_cmd: make build
    test_cmd: make test
    port: 8080
    depends_on: []
    health_endpoint: /health
  user-service:
    version: 1.4.0
    path: services/user-service
    build_cmd: make build
    test_cmd: make test
    port: 8081
    depends_on:
    - api-gateway
    health_endpoint: /health
  order-service:
    version: 1.0.0
    path: services/order-service
    build_cmd: make build
    test_cmd: make test
    port: 8082
    depends_on:
    - user-service
    - api-gateway
    health_endpoint: /health
  notification-service:
    version: 0.8.0
    path: services/notification-service
    build_cmd: make build
    test_cmd: make test
    port: 8083
    depends_on:
    - order-service
    health_endpoint: /health
  analytics-service:
    version: 1.10.0
    path: services/analytics-service
    build_cmd: make build
    test_cmd: make test
    port: 8084
    depends_on:
    - user-service
    - order-service
    health_endpoint: /health
