    68	def validate_manifest(data):
    69	    if not isinstance(data, dict):
    70	        raise ValueError("manifest must be a mapping")
    71	
    72	    services = data.get('services')
    73	    if not isinstance(services, dict) or not services:
    74	        raise ValueError("manifest missing services")
    75	
    76	    environments = data.get('environments')
    77	    if not isinstance(environments, dict) or not environments:
    78	        raise ValueError("manifest missing environments")
    79	
    80	    for env_name, env in environments.items():
    81	        if not isinstance(env, dict):
    82	            raise ValueError(f"environment {env_name} must be a mapping")
    83	        for field in ENV_FIELDS:
    84	            if field not in env:
    85	                raise ValueError(f"environment {env_name} missing required field: {field}")
    86	
    87	    for name, svc in services.items():
    88	        if not isinstance(svc, dict):
    89	            raise ValueError(f"service {name} must be a mapping")
    90	        for field in SERVICE_FIELDS:
    91	            if field not in svc:
    92	                raise ValueError(f"service {name} missing required field: {field}")
    93	        if not isinstance(svc['depends_on'], list):
    94	            raise ValueError(f"service {name} has invalid depends_on: must be a list")
    95	        for dep in svc['depends_on']:
    96	            if dep not in services:
    97	                raise ValueError(f"service {name} depends on undefined service: {dep}")
    98	        if not valid_version(svc.get('version')):
    99	            raise ValueError(f"service {name} has invalid version: expected N.N.N")
   100	
   101	    port_map = {}
   102	    for name, svc in services.items():
   103	        port = svc['port']
   104	        if port in port_map:
   105	            raise ValueError(f"duplicate port assignment: {port}")
   106	        port_map[port] = name
   107	
   108	    cycle = find_cycle(services)
   109	    if cycle:
   110	        raise ValueError(f"circular dependency detected: {' -> '.join(cycle)}")
   111	
   112	    return True
   113	
   114	def find_cycle(services):
   115	    visited = {}
   116	    stack = []
   117	
   118	    def dfs(node):
   119	        visited[node] = 1
   120	        stack.append(node)
   121	        for dep in services[node].get('depends_on', []):
   122	            if dep not in services:
   123	                continue
   124	            if visited.get(dep) == 1:
   125	                idx = stack.index(dep)
   126	                return stack[idx:] + [dep]
   127	            if visited.get(dep) is None:
   128	                res = dfs(dep)
   129	                if res:
   130	                    return res
   131	        stack.pop()
   132	        visited[node] = 2
   133	        return None
   134	
   135	    for n in sorted(services):
   136	        if visited.get(n) is None:
   137	            res = dfs(n)
   138	            if res:
   139	                return res
   140	    return None
   141	
   142	def get_services(data):
   143	    try:
   144	        validate_manifest(data)
   145	    except ValueError as e:
   146	        fail(str(e))
   147	    return data['services'], data['environments']
