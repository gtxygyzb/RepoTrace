   250	def append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):
   251	    ensure_state()
   252	    ts = now_iso()
   253	    line = f"{ts} {action} {service} {version}"
   254	    if action == "PROMOTE" and source_env is not None:
   255	        line += f" from {source_env}"
   256	        if forced:
   257	            line += " (forced)"
   258	    if action == "RESTORE" and snapshot_id is not None:
   259	        line += f" from snapshot #{snapshot_id}"
   260	    line += "\n"
   261	    with open(event_file(env), "a") as f:
   262	        f.write(line)
