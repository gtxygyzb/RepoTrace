   362	def append_scale_event(env, service, count, previous):
   363	    ensure_state()
   364	    event = {
   365	        "timestamp": int(time.time()),
   366	        "iso_timestamp": now_iso(),
   367	        "action": "SCALE",
   368	        "service": service,
   369	        "version": "-",
   370	        "replicas": count,
   371	        "previous": previous,
