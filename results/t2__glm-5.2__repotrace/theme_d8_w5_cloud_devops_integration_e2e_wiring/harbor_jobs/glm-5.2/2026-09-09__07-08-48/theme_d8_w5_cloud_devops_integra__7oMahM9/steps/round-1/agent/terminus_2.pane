   495	def find_rollback_target(env, service, current_version, to_version=None):
   496	    events = load_events(env)
   497	
   498	    if to_version is not None:
   499	        for ev in reversed(events):
   500	            if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] == to_version:
   501	                return to_version
   502	        fail(f"version not found in history for {service}")
   503	
   504	    current_idx = None
   505	    for idx, ev in enumerate(events):
   506	        if ev["service"] != service:
   507	            continue
   508	        if ev["version"] != current_version:
   509	            continue
   510	        if ev["action"] == "ROLLBACK" and ev["version"] == "-":
   511	            continue
   512	        current_idx = idx
   513	
   514	    if current_idx is None:
   515	        return None
   516	
   517	    for ev in reversed(events[:current_idx]):
   518	        if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] != current_version:
   519	            return ev["version"]
   520	    return None
