   830	def cmd_history(args):
   831	    values, flags, positionals = parse_opts(args, {"--service", "--limit"}, set())
   832	    if len(positionals) != 1:
   833	        fail("history requires an environment")
   834	
   835	    env = positionals[0]
   836	    service = values.get("--service")
   837	    limit = 10
   838	    if "--limit" in values:
   839	        try:
   840	            limit = int(values["--limit"])
   841	        except ValueError:
   842	            fail("--limit requires an integer")
   843	        if limit < 0:
   844	            fail("--limit must be non-negative")
   845	
   846	    data = load_manifest()
   847	    _, envs = get_services(data)
   848	    if env not in envs:
   849	        fail(f"environment not found: {env}")
   850	
   851	    ensure_state()
   852	    try:
   853	        with open(event_file(env)) as f:
   854	            raw_lines = [line.rstrip("\n") for line in f if line.strip()]
   855	    except FileNotFoundError:
   856	        raw_lines = []
   857	
   858	    entries = []
   859	    for line in raw_lines:
   860	        if line.startswith('{'):
   861	            try:
   862	                ev = json.loads(line)
   863	            except json.JSONDecodeError:
   864	                continue
   865	            action = ev.get("action")
   866	            iso = ev.get("iso_timestamp", "")
   867	            svc = ev.get("service", "-")
   868	            if action == "LOCK":
   869	                entries.append((iso, svc, f"{iso} LOCK {ev.get('reason', '')}"))
   870	            elif action == "UNLOCK":
   871	                entries.append((iso, svc, f"{iso} UNLOCK"))
   872	            elif action == "CONFIG_SET":
   873	                entries.append((iso, svc, f"{iso} CONFIG_SET {ev.get('key', '')}={ev.get('value', '')}"))
   874	            elif action == "CONFIG_DELETE":
   875	                entries.append((iso, svc, f"{iso} CONFIG_DELETE {ev.get('key', '')}"))
   876	            else:
   877	                entries.append((iso, svc, line))
   878	        else:
   879	            parts = line.split()
   880	            svc = parts[2] if len(parts) >= 3 else ""
   881	            iso = parts[0] if parts else ""
   882	            entries.append((iso, svc, line))
   883	
   884	    if service:
   885	        entries = [e for e in entries if e[1] == service]
   886	
   887	    entries.reverse()
   888	    entries = entries[:limit]
   889	    for iso, svc, line in entries:
   890	        print(line)
