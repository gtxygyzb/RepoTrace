   748	def print_tree(node, services, path, depth):
   749	    print("  " * depth + node)
   750	    if node in path:
   751	        return
   752	    path = path | {node}
   753	    children = sorted([s for s in services if node in services[s].get('depends_on', [])])
   754	    for child in children:
   755	        print_tree(child, services, path, depth + 1)
