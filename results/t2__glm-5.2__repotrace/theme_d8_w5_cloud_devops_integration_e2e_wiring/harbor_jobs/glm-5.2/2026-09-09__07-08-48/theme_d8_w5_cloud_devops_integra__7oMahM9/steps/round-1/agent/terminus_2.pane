   142	def topo_order(services, subset=None):
   143	    if subset is None:
   144	        subset = set(services.keys())
   145	    subset = set(subset)
   146	
   147	    in_degree = {s: 0 for s in subset}
   148	    adj = {s: [] for s in subset}
   149	
   150	    for s in subset:
   151	        for dep in services[s].get('depends_on', []):
   152	            if dep in subset:
   153	                adj[dep].append(s)
   154	                in_degree[s] += 1
   155	
   156	    order = []
   157	    available = sorted([s for s in subset if in_degree[s] == 0])
   158	    while available:
   159	        next_available = []
   160	        for s in available:
   161	            order.append(s)
   162	            for dependent in sorted(adj[s]):
   163	                in_degree[dependent] -= 1
   164	                if in_degree[dependent] == 0:
   165	                    next_available.append(dependent)
   166	        available = sorted(next_available)
   167	
   168	    if len(order) != len(subset):
   169	        fail("circular dependency detected")
   170	    return order
   171	
   172	def build_waves(services, subset):
   173	    subset = set(subset)
   174	
   175	    in_degree = {s: 0 for s in subset}
   176	    adj = {s: [] for s in subset}
   177	
   178	    for s in subset:
   179	        for dep in services[s].get('depends_on', []):
   180	            if dep in subset:
   181	                adj[dep].append(s)
   182	                in_degree[s] += 1
   183	
   184	    waves = []
   185	    available = sorted([s for s in subset if in_degree[s] == 0])
   186	    while available:
   187	        waves.append(available)
   188	        next_available = []
   189	        for s in available:
   190	            for dependent in sorted(adj[s]):
   191	                in_degree[dependent] -= 1
   192	                if in_degree[dependent] == 0:
   193	                    next_available.append(dependent)
   194	        available = sorted(next_available)
   195	
   196	    if sum(len(w) for w in waves) != len(subset):
   197	        fail("circular dependency detected")
   198	    return waves
   199	
   200	def transitive_deps(services, name):
   201	    if name not in services:
   202	        fail(f"service not found: {name}")
   203	    result = set()
   204	    stack = [name]
   205	    while stack:
   206	        s = stack.pop()
   207	        if s not in result:
   208	            result.add(s)
   209	            for dep in services[s].get('depends_on', []):
   210	                if dep not in services:
   211	                    fail(f"service {s} depends on undefined service: {dep}")
   212	                stack.append(dep)
   213	    return result
