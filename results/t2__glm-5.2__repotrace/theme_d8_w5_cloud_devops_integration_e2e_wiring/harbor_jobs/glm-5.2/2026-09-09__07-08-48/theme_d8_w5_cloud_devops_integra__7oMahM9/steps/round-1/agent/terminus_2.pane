   658	def valid_version(v):
   659	    if not isinstance(v, str):
   660	        return False
   661	    parts = v.split('.')
   662	    if len(parts) != 3:
   663	        return False
   664	    for part in parts:
   665	        if not part.isdigit() or (part != '0' and part.startswith('0')):
   666	            return False
   667	    return True
   668	
   669	def parse_semver(v):
   670	    if not valid_version(v):
   671	        return None
   672	    return tuple(int(x) for x in v.split('.'))
   673	
   674	def extract_semver(version):
   675	    if not isinstance(version, str):
   676	        return None
   677	    semver = version.split(':', 1)[1] if ':' in version else version
   678	    if '+build.' in semver:
   679	        semver = semver.split('+build.', 1)[0]
   680	    return parse_semver(semver)
   681	
   682	def semver_string(version):
   683	    sv = extract_semver(version)
   684	    if sv is None:
   685	        return None
   686	    return f"{sv[0]}.{sv[1]}.{sv[2]}"
   687	
   688	def version_build_timestamp(version):
   689	    if not isinstance(version, str) or '+build.' not in version:
   690	        return None
   691	    after = version.split('+build.', 1)[1]
   692	    try:
   693	        return int(after)
   694	    except ValueError:
   695	        return None
   696	
   697	def compare_versions(a, b):
   698	    sa = extract_semver(a)
   699	    sb = extract_semver(b)
   700	    if sa is not None and sb is not None:
   701	        if sa != sb:
   702	            return 1 if sa > sb else -1
   703	        ta = version_build_timestamp(a)
   704	        tb = version_build_timestamp(b)
   705	        if ta is not None and tb is not None and ta != tb:
   706	            return 1 if ta > tb else -1
   707	        return 0
   708	    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)
   709	def cmd_promote(args):
   710	    values, flags, positionals = parse_opts(args, {"--service"}, {"--dry-run", "--force"})
   711	    if len(positionals) != 2:
   712	        fail("promote requires <source-env> <target-env>")
   713	
   714	    source, target = positionals
   715	    service = values.get("--service")
   716	    dry_run = "--dry-run" in flags
   717	    force = "--force" in flags
   718	
   719	    data = load_manifest()
   720	    services, envs = get_services(data)
   721	
   722	    if source not in envs:
   723	        fail(f"environment not found: {source}")
   724	    if target not in envs:
   725	        fail(f"environment not found: {target}")
   726	
   727	    assert_not_locked(target)
   728	
   729	    if service:
   730	        subset = transitive_deps(services, service)
   731	    else:
   732	        subset = set(services.keys())
   733	
   734	    ensure_state()
   735	    source_state = load_deployment_state(source)
   736	    target_state = load_deployment_state(target)
   737	
   738	    candidates = {s for s in source_state if s in subset and s in services}
   739	    order = topo_order(services, candidates)
   740	
   741	    if dry_run:
   742	        print(f"DRY-RUN promote from {source} to {target}:")
   743	        for s in order:
   744	            src_version = source_state[s].get("version")
   745	            tgt_version = target_state.get(s, {}).get("version")
   746	            if src_version == tgt_version:
   747	                continue
   748	            src_sv = extract_semver(src_version)
   749	            tgt_sv = extract_semver(tgt_version)
   750	            if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:
   751	                print(f"  Would conflict {s} (downgrade)")
   752	            else:
   753	                print(f"  Would promote {s}")
   754	        return
   755	
   756	    promoted = 0
   757	    skipped = 0
   758	    conflicts = 0
   759	    promote_events = []
   760	
   761	    for s in order:
   762	        src_rec = source_state[s]
   763	        src_version = src_rec.get("version")
   764	        if target_state.get(s, {}).get("version") == src_version:
   765	            print(f"PROMOTE {s} -> {target}: SKIP (same version)")
   766	            skipped += 1
   767	            continue
   768	
   769	        src_sv = extract_semver(src_version)
   770	        tgt_sv = extract_semver(target_state.get(s, {}).get("version"))
   771	        if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:
   772	            if force:
   773	                target_state[s] = src_rec
   774	                print(f"PROMOTE {s} -> {target} OK (forced)")
   775	                promoted += 1
   776	                promote_events.append((s, src_version, True))
   777	            else:
   778	                print(f"CONFLICT: {s} -> {target}: downgrade ({src_sv[0]}.{src_sv[1]}.{src_sv[2]} < {tgt_sv[0]}.{tgt_sv[1]}.{tgt_sv[2]})")
   779	                conflicts += 1
   780	            continue
   781	
   782	        target_state[s] = src_rec
   783	        print(f"PROMOTE {s} -> {target} OK")
   784	        promoted += 1
   785	        promote_events.append((s, src_version, False))
   786	
   787	    save_deployment_state(target, target_state)
   788	    for s, version, forced in promote_events:
   789	        append_event(target, "PROMOTE", s, version, source, forced=forced)
   790	    print(f"Promoted {promoted}, skipped {skipped}, conflicts {conflicts}")
