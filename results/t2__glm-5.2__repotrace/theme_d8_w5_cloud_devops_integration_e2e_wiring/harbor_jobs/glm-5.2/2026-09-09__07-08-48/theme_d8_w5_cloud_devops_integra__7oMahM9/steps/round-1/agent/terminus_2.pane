  1103	def print_tree(node, services, path, depth):
  1104	    print("  " * depth + node)
  1105	    if node in path:
  1106	        return
  1107	    path = path | {node}
  1108	    children = sorted([s for s in services if node in services[s].get('depends_on', [])])
  1109	    for child in children:
  1110	        print_tree(child, services, path, depth + 1)
