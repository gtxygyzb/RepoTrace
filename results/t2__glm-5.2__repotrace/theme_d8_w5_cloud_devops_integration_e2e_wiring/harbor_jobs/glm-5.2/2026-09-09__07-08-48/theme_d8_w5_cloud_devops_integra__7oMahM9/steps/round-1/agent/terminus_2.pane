   285	def get_health_state(env, service):
   286	    health = load_health(env)
   287	    rec = health.get(service)
   288	    if not rec or rec.get("state") not in ("healthy", "unhealthy", "degraded"):
   289	        return "healthy"
   290	    state = load_deployment_state(env)
   291	    snapshot = rec.get("state_snapshot")
   292	    if not snapshot or state.get(service) != snapshot:
   293	        return "healthy"
   294	    return rec["state"]
   295	
   296	def reset_health(env, service):
   297	    health = load_health(env)
   298	    if service in health:
   299	        del health[service]
   300	        save_health(env, health)
   301	
   302	def reset_all_health(env):
   303	    health = load_health(env)
   304	    if health:
   305	        save_health(env, {})
