   250	        line += f" from {source_env}"
   251	        if forced:
   252	            line += " (forced)"
   253	    if action == "RESTORE" and snapshot_id is not None:
   254	        line += f" from snapshot #{snapshot_id}"
   255	    line += "\n"
   256	    with open(event_file(env), "a") as f:
   257	        f.write(line)
