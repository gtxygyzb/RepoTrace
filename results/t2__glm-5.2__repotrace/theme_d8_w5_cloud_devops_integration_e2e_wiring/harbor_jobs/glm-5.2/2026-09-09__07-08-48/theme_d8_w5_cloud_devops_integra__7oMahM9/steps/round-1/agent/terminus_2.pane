   671	    elif cmd == 'diff':
   672	        cmd_diff(args)
   673	    elif cmd == 'history':
   674	        cmd_history(args)
   675	    elif cmd == 'graph':
   676	        cmd_graph(args)
   677	    else:
   678	        fail(f"unknown command: {cmd}")
   679	
