   261	            if i >= len(args):
   262	                fail(f"{a} requires a value")
   263	            values[a] = args[i]
   264	        elif a in flag_opts:
   265	            flags.add(a)
   266	        elif a.startswith('--'):
   267	            fail(f"unknown option: {a}")
   268	        else:
   269	            positionals.append(a)
   270	        i += 1
   271	    return values, flags, positionals
