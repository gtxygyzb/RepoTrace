   142	def topo_order(services, subset=None):
   143	    if subset is None:
   144	        subset = set(services.keys())
   145	    subset = set(subset)
   146	
   147	    in_degree = {s: 0 for s in subset}
   148	    adj = {s: [] for s in subset}
   149	
   150	    for s in subset:
   151	        for dep in services[s].get('depends_on', []):
   152	            if dep in subset:
   153	                adj[dep].append(s)
   154	                in_degree[s] += 1
   155	
   156	    order = []
   157	    available = sorted([s for s in subset if in_degree[s] == 0])
   158	    while available:
   159	        next_available = []
   160	        for s in available:
   161	            order.append(s)
   162	            for dependent in sorted(adj[s]):
   163	                in_degree[dependent] -= 1
   164	                if in_degree[dependent] == 0:
   165	                    next_available.append(dependent)
   166	        available = sorted(next_available)
   167	
   168	    if len(order) != len(subset):
   169	        fail("circular dependency detected")
   170	    return order
