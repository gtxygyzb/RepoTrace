   908	        fail("graph format must be dot or text")
   909	
   910	    data = load_manifest()
   911	    services, _ = get_services(data)
   912	
   913	    if fmt == 'dot':
   914	        print("digraph pipeline {")
   915	        for dep in sorted(services):
   916	            dependents = sorted([s for s in services if dep in services[s].get('depends_on', [])])
   917	            for dependent in dependents:
   918	                print(f'  "{dep}" -> "{dependent}";')
   919	        print("}")
   920	    else:
   921	        roots = sorted([s for s in services if not services[s].get('depends_on')])
   922	        for root in roots:
   923	            print_tree(root, services, set(), 0)
