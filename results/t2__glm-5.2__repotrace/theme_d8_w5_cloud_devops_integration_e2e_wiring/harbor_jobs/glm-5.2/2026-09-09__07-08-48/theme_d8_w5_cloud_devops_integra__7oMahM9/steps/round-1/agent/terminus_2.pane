def main():
    if len(sys.argv) < 2:
        fail("no command given")

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd == 'validate':
        cmd_validate(args)
    elif cmd == 'order':
        cmd_order(args)
    elif cmd == 'build':
        cmd_build(args)
    elif cmd == 'test':
        cmd_test(args)
    elif cmd == 'deploy':
        cmd_deploy(args)
    elif cmd == 'status':
        cmd_status(args)
    elif cmd == 'rollback':
        cmd_rollback(args)
    elif cmd == 'promote':
        cmd_promote(args)
    elif cmd == 'diff':
        cmd_diff(args)
    elif cmd == 'history':
        cmd_history(args)
    elif cmd == 'graph':
        cmd_graph(args)
    elif cmd == 'bump':
        cmd_bump(args)
    elif cmd == 'snapshot':
        cmd_snapshot(args)
    elif cmd == 'restore':
        cmd_restore(args)
    elif cmd == 'lock':
        cmd_lock(args)
    elif cmd == 'unlock':
        cmd_unlock(args)
    elif cmd == 'health':
        cmd_health(args)
    elif cmd == 'config':
        cmd_config(args)
    elif cmd == 'scale':
        cmd_scale(args)
    else:
        fail(f"unknown command: {cmd}")

if __name__ == '__main__':
    main()
