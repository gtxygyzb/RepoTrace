   638	def find_rollback_target(env, service, current_version, to_version=None):
   639	    events = load_events(env)
   640	
   641	    if to_version is not None:
   642	        for ev in reversed(events):
   643	            if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] == to_version:
   644	                return to_version
   645	        fail(f"version not found in history for {service}")
   646	
   647	    current_idx = None
   648	    for idx, ev in enumerate(events):
   649	        if ev["service"] != service:
   650	            continue
   651	        if ev["version"] != current_version:
   652	            continue
   653	        if ev["action"] == "ROLLBACK" and ev["version"] == "-":
   654	            continue
   655	        current_idx = idx
   656	
   657	    if current_idx is None:
   658	        return None
   659	
   660	    for ev in reversed(events[:current_idx]):
   661	        if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] != current_version:
   662	            return ev["version"]
   663	    return None
