   348	def append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):
   349	    ensure_state()
   350	    ts = now_iso()
   351	    line = f"{ts} {action} {service} {version}"
   352	    if action == "PROMOTE" and source_env is not None:
   353	        line += f" from {source_env}"
   354	        if forced:
   355	            line += " (forced)"
   356	    if action == "RESTORE" and snapshot_id is not None:
   357	        line += f" from snapshot #{snapshot_id}"
   358	    line += "\n"
   359	    with open(event_file(env), "a") as f:
   360	        f.write(line)
   361	
   362	def append_scale_event(env, service, count, previous):
   363	    ensure_state()
   364	    event = {
   365	        "timestamp": int(time.time()),
   366	        "iso_timestamp": now_iso(),
   367	        "action": "SCALE",
   368	        "service": service,
   369	        "version": "-",
   370	        "replicas": count,
   371	        "previous": previous,
   372	    }
   373	    with open(event_file(env), "a") as f:
   374	        f.write(json.dumps(event) + chr(10))
   375	
   376	def load_events(env):
   377	    ensure_state()
   378	    try:
   379	        with open(event_file(env)) as f:
   380	            lines = [line.rstrip("\n") for line in f if line.strip()]
   381	    except FileNotFoundError:
   382	        return []
   383	    events = []
   384	    for line in lines:
   385	        if line.startswith('{'):
   386	            continue
   387	        parts = line.split()
   388	        if len(parts) < 4:
   389	            continue
   390	        events.append({
   391	            "timestamp": parts[0],
   392	            "action": parts[1],
   393	            "service": parts[2],
   394	            "version": parts[3],
   395	            "line": line,
   396	        })
   397	    return events
