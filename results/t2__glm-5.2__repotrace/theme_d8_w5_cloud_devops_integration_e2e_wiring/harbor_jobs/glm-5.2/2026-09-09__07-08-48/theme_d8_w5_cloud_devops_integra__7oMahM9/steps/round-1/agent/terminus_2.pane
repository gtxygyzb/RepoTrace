def parse_opts(args, value_opts, flag_opts):
    values = {}
    flags = set()
    positionals = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in value_opts:
            i += 1
            if i >= len(args):
                fail(f"{a} requires a value")
            values[a] = args[i]
        elif a in flag_opts:
            flags.add(a)
        elif a.startswith('--'):
            fail(f"unknown option: {a}")
        else:
            positionals.append(a)
        i += 1
    return values, flags, positionals

def cmd_validate(args):
    if args:
        fail("validate takes no arguments")
    data = load_manifest()
    try:
        validate_manifest(data)
    except ValueError as e:
        print(f"ERROR: {e}")
        sys.exit(1)
    print("VALID")

def cmd_order(args):
    if args:
        fail("order takes no arguments")
    data = load_manifest()
    services, _ = get_services(data)
    for s in topo_order(services):
        print(s)

def cmd_build(args):
    values, flags, positionals = parse_opts(args, {'--service'}, {'--parallel'})
    if positionals:
        fail("build does not accept positional arguments")

    service = values.get('--service')
    parallel = '--parallel' in flags

    data = load_manifest()
    services, _ = get_services(data)

    if service:
        subset = transitive_deps(services, service)
    else:
        subset = set(services.keys())

    if parallel:
        for wave in build_waves(services, subset):
            print(",".join(wave))
        return

    order = topo_order(services, subset)
    any_fail = False
    for s in order:
        svc = services[s]
        path = service_path(svc)
        if not os.path.isdir(path):
            print(f"BUILD {s} FAIL: service path does not exist")
            any_fail = True
            continue
        version = svc.get('version')
        if not valid_version(version):
            print(f"BUILD {s} FAIL: invalid version")
            any_fail = True
            continue
        try:
            os.makedirs(os.path.join(path, 'build'), exist_ok=True)
            with open(os.path.join(path, 'build', 'artifact.txt'), 'w') as f:
                f.write(f"{s}:{version}+build.{int(time.time())}")
            print(f"BUILD {s} OK")
        except Exception as e:
            print(f"BUILD {s} FAIL: {e}")
            any_fail = True

    if any_fail:
        sys.exit(1)

def cmd_test(args):
    values, flags, positionals = parse_opts(args, {'--service'}, {'--fail-fast'})
    if positionals:
        fail("test does not accept positional arguments")

    service = values.get('--service')
    fail_fast = '--fail-fast' in flags

    data = load_manifest()
    services, _ = get_services(data)

    if service:
        if service not in services:
            fail(f"service not found: {service}")
        order = [service]
    else:
        order = topo_order(services)

    ensure_state()
    results = load_json(TEST_RESULTS_PATH, {})
    any_fail = False

    for s in order:
        if os.path.exists(artifact_path(services[s])):
            results[s] = {"pass": True, "timestamp": now_iso()}
            print(f"TEST {s} PASS")
        else:
            results[s] = {"pass": False, "timestamp": now_iso()}
            print(f"TEST {s} FAIL: not built")
            any_fail = True
            if fail_fast:
                break

    save_json(TEST_RESULTS_PATH, results)
    if any_fail:
        sys.exit(1)

def cmd_deploy(args):
    values, flags, positionals = parse_opts(args, {'--service'}, {'--dry-run'})
    if len(positionals) != 1:
        fail("deploy requires an environment")

    env = positionals[0]
    service = values.get('--service')
    dry_run = '--dry-run' in flags

    data = load_manifest()
    services, envs = get_services(data)

    if env not in envs:
        fail(f"environment not found: {env}")

    assert_not_locked(env)

    if service:
        subset = transitive_deps(services, service)
    else:
        subset = set(services.keys())

    order = topo_order(services, subset)
    ensure_state()

    if dry_run:
        print(f"DRY-RUN deploy to {env}:")
        for s in order:
            print(f"  Would deploy {s}")
        return

    test_results = load_json(TEST_RESULTS_PATH, {})
    state = load_deployment_state(env)
    replicas = load_replicas(env)
    any_fail = False
    deployed_events = []

    for s in order:
        rec = test_results.get(s)
        if not rec or not rec.get("pass"):
            print(f"DEPLOY {s} -> {env} FAIL: tests not passing")
            any_fail = True
            break

        version = read_artifact(services[s])
        if version is None:
            print(f"DEPLOY {s} -> {env} FAIL: tests not passing")
            any_fail = True
            break

        state[s] = {"version": version, "deployed_at": now_iso()}
        replicas[s] = 1
        deployed_events.append((s, version))
        print(f"DEPLOY {s} -> {env} OK")

    save_deployment_state(env, state)
    save_replicas(env, replicas)
    for s, version in deployed_events:
        reset_health(env, s)
    for s, version in deployed_events:
        append_event(env, "DEPLOY", s, version)
    if any_fail:
        sys.exit(1)

def cmd_status(args):
    if len(args) > 1:
        fail("status takes at most one environment argument")

    data = load_manifest()
    _, envs = get_services(data)

    if args:
        env = args[0]
        if env not in envs:
            fail(f"environment not found: {env}")
        lock = load_lock(env)
        if lock is not None:
            print(f"[LOCKED: {lock.get('reason', 'manual lock')}]")
        cfg = load_config(env)
        if cfg:
            print(f"Config: {len(cfg)} variables")
        state = load_deployment_state(env)
        for s in sorted(state):
            rec = state[s]
            print(f"{s}: {rec.get('version', '')} (deployed at {rec.get('deployed_at', '')}) [{get_replica_count(env, s)} replicas] [{get_health_state(env, s).upper()}]")
    else:
        for env in sorted(envs):
            state = load_deployment_state(env)
            print(f"{env}: {len(state)} services deployed")

def cmd_rollback(args):
    values, flags, positionals = parse_opts(args, {"--to-version"}, set())
    if len(positionals) != 2:
        fail("rollback requires <environment> <service_name>")

    env, service = positionals
    data = load_manifest()
    _, envs = get_services(data)
    if env not in envs:
        fail(f"environment not found: {env}")
    assert_not_locked(env)
    ensure_state()
    state = load_deployment_state(env)
    replicas = load_replicas(env)

    if service not in state:
        print(f"ROLLBACK {service} from {env} FAIL: not deployed")
        sys.exit(1)

    current_version = state[service].get("version")
    if not current_version:
        print(f"ROLLBACK {service} from {env} FAIL: not deployed")
        sys.exit(1)

    to_version = values.get("--to-version")
    target_version = find_rollback_target(env, service, current_version, to_version)

    if target_version is None:
        del state[service]
        if service in replicas:
            del replicas[service]
        save_deployment_state(env, state)
        save_replicas(env, replicas)
        reset_health(env, service)
        append_event(env, "ROLLBACK", service, "-")
        print(f"ROLLBACK {service} from {env}: {current_version} -> (removed)")
    else:
        state[service] = {"version": target_version, "deployed_at": now_iso()}
        replicas[service] = 1
        save_deployment_state(env, state)
        save_replicas(env, replicas)
        reset_health(env, service)
        append_event(env, "ROLLBACK", service, target_version)
        print(f"ROLLBACK {service} from {env}: {current_version} -> {target_version}")

def cmd_health(args):
    if not args:
        fail("health requires <environment>")

    env = args[0]
    data = load_manifest()
    services, envs = get_services(data)
    if env not in envs:
        fail(f"unknown environment '{env}'")

    if len(args) == 1:
        ensure_state()
        state = load_deployment_state(env)
        for s in sorted(state):
            print(f"{s}: {get_health_state(env, s)}")
        return

    if len(args) >= 3 and args[1] == "--filter":
        if len(args) != 3:
            fail("health <environment> --filter <state>")
        state = args[2]
        if not is_valid_health_state(state):
            fail(f"invalid health state '{state}' (must be healthy, unhealthy, or degraded)")
        ensure_state()
        dep_state = load_deployment_state(env)
        for s in sorted(dep_state):
            hs = get_health_state(env, s)
            if hs == state:
                print(f"{s}: {hs}")
        return

    if len(args) < 2:
        fail("health requires <environment> <service>")

    service = args[1]
    if service not in services:
        fail(f"unknown service '{service}'")

    if len(args) == 2:
        ensure_state()
        state = load_deployment_state(env)
        if service not in state:
            fail(f"{service} is not deployed to {env}")
        print(f"{service}: {get_health_state(env, service)}")
        return

    if len(args) < 4 or args[2] != "set":
        fail("invalid health arguments")

    if len(args) != 4:
        fail("health <environment> <service> set <state>")

    new_state = args[3]
    if not is_valid_health_state(new_state):
        fail(f"invalid health state '{new_state}' (must be healthy, unhealthy, or degraded)")

    ensure_state()
    state = load_deployment_state(env)
    if service not in state:
        fail(f"{service} is not deployed to {env}")
    assert_not_locked(env)
    previous = get_health_state(env, service)
    health = load_health(env)
    health[service] = {
        "state": new_state,
        "state_snapshot": state.get(service),
    }
    save_health(env, health)
    append_health_event(env, service, new_state, previous)
    print(f"HEALTH {env}/{service} set to {new_state} (was {previous})")

def valid_version(v):
    if not isinstance(v, str):
        return False
    parts = v.split('.')
    if len(parts) != 3:
        return False
    for part in parts:
        if not part.isdigit() or (part != '0' and part.startswith('0')):
            return False
    return True

def parse_semver(v):
    if not valid_version(v):
        return None
    return tuple(int(x) for x in v.split('.'))

def extract_semver(version):
    if not isinstance(version, str):
        return None
    semver = version.split(':', 1)[1] if ':' in version else version
    if '+build.' in semver:
        semver = semver.split('+build.', 1)[0]
    return parse_semver(semver)

def semver_string(version):
    sv = extract_semver(version)
    if sv is None:
        return None
    return f"{sv[0]}.{sv[1]}.{sv[2]}"

def version_build_timestamp(version):
    if not isinstance(version, str) or '+build.' not in version:
        return None
    after = version.split('+build.', 1)[1]
    try:
        return int(after)
    except ValueError:
        return None

def compare_versions(a, b):
    sa = extract_semver(a)
    sb = extract_semver(b)
    if sa is not None and sb is not None:
        if sa != sb:
            return 1 if sa > sb else -1
        ta = version_build_timestamp(a)
        tb = version_build_timestamp(b)
        if ta is not None and tb is not None and ta != tb:
            return 1 if ta > tb else -1
