   185	def build_waves(services, subset):
   186	    subset = set(subset)
   187	
   188	    in_degree = {s: 0 for s in subset}
   189	    adj = {s: [] for s in subset}
   190	
   191	    for s in subset:
   192	        for dep in services[s].get('depends_on', []):
   193	            if dep in subset:
   194	                adj[dep].append(s)
   195	                in_degree[s] += 1
   196	
   197	    waves = []
   198	    available = sorted([s for s in subset if in_degree[s] == 0])
   199	    while available:
   200	        waves.append(available)
   201	        next_available = []
   202	        for s in available:
   203	            for dependent in sorted(adj[s]):
   204	                in_degree[dependent] -= 1
   205	                if in_degree[dependent] == 0:
   206	                    next_available.append(dependent)
   207	        available = sorted(next_available)
   208	
   209	    if sum(len(w) for w in waves) != len(subset):
   210	        fail("circular dependency detected")
   211	    return waves
