 903: def cmd_history(args):
 904:     values, flags, positionals = parse_opts(args, {"--service", "--limit"}, set())
 905:     if len(positionals) != 1:
 906:         fail("history requires an environment")
 907: 
 908:     env = positionals[0]
 909:     service = values.get("--service")
 910:     limit = 10
 911:     if "--limit" in values:
 912:         try:
 913:             limit = int(values["--limit"])
 914:         except ValueError:
 915:             fail("--limit requires an integer")
 916:         if limit < 0:
 917:             fail("--limit must be non-negative")
 918: 
 919:     data = load_manifest()
 920:     _, envs = get_services(data)
 921:     if env not in envs:
 922:         fail(f"environment not found: {env}")
 923: 
 924:     ensure_state()
 925:     try:
 926:         with open(event_file(env)) as f:
 927:             raw_lines = [line.rstrip("\n") for line in f if line.strip()]
 928:     except FileNotFoundError:
 929:         raw_lines = []
 930: 
 931:     entries = []
 932:     for line in raw_lines:
 933:         if line.startswith('{'):
 934:             try:
 935:                 ev = json.loads(line)
 936:             except json.JSONDecodeError:
 937:                 continue
 938:             action = ev.get("action")
 939:             iso = ev.get("iso_timestamp", "")
 940:             svc = ev.get("service", "-")
 941:             if action == "LOCK":
 942:                 entries.append((iso, svc, f"{iso} LOCK {ev.get('reason', '')}"))
 943:             elif action == "UNLOCK":
 944:                 entries.append((iso, svc, f"{iso} UNLOCK"))
 945:             elif action == "CONFIG_SET":
 946:                 entries.append((iso, svc, f"{iso} CONFIG_SET {ev.get('key', '')}={ev.get('value', '')}"))
 947:             elif action == "CONFIG_DELETE":
 948:                 entries.append((iso, svc, f"{iso} CONFIG_DELETE {ev.get('key', '')}"))
 949:             elif action == "SCALE":
 950:                 entries.append((iso, svc, f"{iso} SCALE {svc} from {ev.get('previous', '-')} to {ev.get('replicas', '-')} replicas"))
 951:             else:
 952:                 entries.append((iso, svc, line))
 953:         else:
 954:             parts = line.split()
 955:             svc = parts[2] if len(parts) >= 3 else ""
 956:             iso = parts[0] if parts else ""
 957:             entries.append((iso, svc, line))
 958: 
 959:     if service:
 960:         entries = [e for e in entries if e[1] == service]
 961: 
 962:     entries.reverse()
 963:     entries = entries[:limit]
 964:     for iso, svc, line in entries:
 965:         print(line)
