   834	def print_tree(node, services, path, depth):
   835	    print("  " * depth + node)
   836	    if node in path:
   837	        return
   838	    path = path | {node}
   839	    children = sorted([s for s in services if node in services[s].get('depends_on', [])])
   840	    for child in children:
   841	        print_tree(child, services, path, depth + 1)
