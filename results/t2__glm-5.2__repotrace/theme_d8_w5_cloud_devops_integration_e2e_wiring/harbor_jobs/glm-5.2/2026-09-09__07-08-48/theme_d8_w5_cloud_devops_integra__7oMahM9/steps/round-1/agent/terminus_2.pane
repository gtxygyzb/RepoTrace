def load_events(env):
    ensure_state()
    try:
        with open(event_file(env)) as f:
            lines = [line.rstrip("\n") for line in f if line.strip()]
    except FileNotFoundError:
        return []
    events = []
    for line in lines:
        if line.startswith('{'):
            continue
        parts = line.split()
        if len(parts) < 4:
            continue
        events.append({
            "timestamp": parts[0],
            "action": parts[1],
            "service": parts[2],
            "version": parts[3],
            "line": line,
        })
    return events

def lock_file(env):
    return os.path.join(LOCK_DIR, f"{env}.json")

def load_lock(env):
    return load_json(lock_file(env), None)

def save_lock(env, reason):
    ensure_state()
    existing = load_lock(env)
    locked_since = existing.get('locked_since', now_iso()) if existing else now_iso()
    lock = {"reason": reason, "locked_since": locked_since}
    save_json(lock_file(env), lock)

def remove_lock(env):
    try:
        os.remove(lock_file(env))
    except FileNotFoundError:
        pass

def is_locked(env):
    return load_lock(env) is not None

def assert_not_locked(env):
    lock = load_lock(env)
    if lock is not None:
        fail(f"{env} is locked ({lock.get('reason', 'manual lock')})")

def append_lock_event(env, reason):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "LOCK",
        "service": "-",
        "version": "-",
        "reason": reason,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\n")

def append_unlock_event(env):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "UNLOCK",
        "service": "-",
        "version": "-",
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\n")

def assert_env_exists(env):
    data = load_manifest()
    _, envs = get_services(data)
    if env not in envs:
        fail(f"unknown environment '{env}'")


def quota_file(env):
    return os.path.join(QUOTA_DIR, f"{env}.json")

def load_quotas(env):
    return load_json(quota_file(env), {})

def save_quotas(env, quotas):
    save_json(quota_file(env), quotas)

def quota_supported_resources():
    return ['max_services', 'max_total_replicas']

def validate_quota_resource(resource):
    if resource not in quota_supported_resources():
        fail(f"unknown quota resource '{resource}' (must be max_services or max_total_replicas)")

def quota_current_usage(env, resource):
    state = load_deployment_state(env)
    replicas = load_replicas(env)
    if resource == 'max_services':
        return len(state)
    if resource == 'max_total_replicas':
        return sum(replicas.get(svc, 1) for svc in state)
    fail(f"unknown quota resource '{resource}' (must be max_services or max_total_replicas)")

def append_quota_set_event(env, resource, limit):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "QUOTA_SET",
        "service": "-",
        "version": "-",
        "resource": resource,
        "limit": limit,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\n")

def append_quota_remove_event(env, resource):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "QUOTA_REMOVE",
        "service": "-",
        "version": "-",
        "resource": resource,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\n")

def quota_status_line(env):
    quotas = load_quotas(env)
    if not quotas:
        return None
    parts = []
    for resource in quota_supported_resources():
        if resource in quotas:
            limit = quotas[resource]
            usage = quota_current_usage(env, resource)
            parts.append(f"{resource}={limit} ({usage}/{limit})")
    if not parts:
        return None
    return "Quotas: " + ", ".join(parts)

def cmd_quota(args):
    if not args:
        fail("quota requires <environment> <set|get|list|remove|--check> [args]")
    env = args[0]
    if len(args) < 2:
        fail("quota requires <environment> <set|get|list|remove|--check> [args]")
    sub = args[1]
    rest = args[2:]

    assert_env_exists(env)

    if sub == 'set':
