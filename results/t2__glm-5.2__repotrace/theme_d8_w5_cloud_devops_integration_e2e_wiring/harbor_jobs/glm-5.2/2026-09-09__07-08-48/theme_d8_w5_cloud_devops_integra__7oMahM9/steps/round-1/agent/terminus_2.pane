   307	def append_health_event(env, service, new_state, previous_state):
   308	    ensure_state()
   309	    event = {
   310	        "timestamp": int(time.time()),
   311	        "iso_timestamp": now_iso(),
   312	        "action": "HEALTH",
   313	        "service": service,
   314	        "version": "-",
   315	        "state": new_state,
   316	        "previous_state": previous_state,
   317	    }
   318	    with open(event_file(env), "a") as f:
   319	        f.write(json.dumps(event) + "\n")
