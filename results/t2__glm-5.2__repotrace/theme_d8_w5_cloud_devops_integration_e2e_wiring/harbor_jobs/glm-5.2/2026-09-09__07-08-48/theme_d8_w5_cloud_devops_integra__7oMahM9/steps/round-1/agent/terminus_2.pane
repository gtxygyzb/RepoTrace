[?2004l   520	        tb = version_build_timestamp(b)
   521	        if ta is not None and tb is not None and ta != tb:
   522	            return 1 if ta > tb else -1
   523	        return 0
   524	    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)
   525	def cmd_promote(args):
   526	    values, flags, positionals = parse_opts(args, {"--service"}, {"--dry-run", "--force"})
   527	    if len(positionals) != 2:
   528	        fail("promote requires <source-env> <target-env>")
   529	
   530	    source, target = positionals
