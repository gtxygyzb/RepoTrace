   665	def parse_opts(args, value_opts, flag_opts):
   666	    values = {}
   667	    flags = set()
   668	    positionals = []
   669	    i = 0
   670	    while i < len(args):
   671	        a = args[i]
   672	        if a in value_opts:
   673	            i += 1
   674	            if i >= len(args):
   675	                fail(f"{a} requires a value")
   676	            values[a] = args[i]
   677	        elif a in flag_opts:
   678	            flags.add(a)
   679	        elif a.startswith('--'):
   680	            fail(f"unknown option: {a}")
   681	        else:
   682	            positionals.append(a)
   683	        i += 1
   684	    return values, flags, positionals
