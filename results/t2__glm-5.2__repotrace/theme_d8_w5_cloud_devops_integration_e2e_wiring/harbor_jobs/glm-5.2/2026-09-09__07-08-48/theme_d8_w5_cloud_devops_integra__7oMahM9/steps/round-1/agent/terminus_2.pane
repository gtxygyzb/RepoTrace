def quota_file(env):
    return os.path.join(QUOTA_DIR, f"{env}.json")

def load_quotas(env):
    return load_json(quota_file(env), {})

def save_quotas(env, quotas):
    save_json(quota_file(env), quotas)

def quota_supported_resources():
    return ['max_services', 'max_total_replicas']

def validate_quota_resource(resource):
    if resource not in quota_supported_resources():
        fail(f"unknown quota resource '{resource}' (must be max_services or max_total_replicas)")

def quota_current_usage(env, resource):
    state = load_deployment_state(env)
    replicas = load_replicas(env)
    if resource == 'max_services':
        return len(state)
    if resource == 'max_total_replicas':
        return sum(replicas.get(svc, 1) for svc in state)
    fail(f"unknown quota resource '{resource}' (must be max_services or max_total_replicas)")

def append_quota_set_event(env, resource, limit):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "QUOTA_SET",
        "service": "-",
        "version": "-",
        "resource": resource,
        "limit": limit,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\n")

def append_quota_remove_event(env, resource):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "QUOTA_REMOVE",
        "service": "-",
        "version": "-",
        "resource": resource,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\n")

def quota_status_line(env):
    quotas = load_quotas(env)
    if not quotas:
        return None
    parts = []
    for resource in quota_supported_resources():
        if resource in quotas:
            limit = quotas[resource]
            usage = quota_current_usage(env, resource)
            parts.append(f"{resource}={limit} ({usage}/{limit})")
    if not parts:
