   296	def append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):
   297	    ensure_state()
   298	    ts = now_iso()
   299	    line = f"{ts} {action} {service} {version}"
   300	    if action == "PROMOTE" and source_env is not None:
   301	        line += f" from {source_env}"
   302	        if forced:
   303	            line += " (forced)"
   304	    if action == "RESTORE" and snapshot_id is not None:
   305	        line += f" from snapshot #{snapshot_id}"
   306	    line += "\n"
   307	    with open(event_file(env), "a") as f:
   308	        f.write(line)
