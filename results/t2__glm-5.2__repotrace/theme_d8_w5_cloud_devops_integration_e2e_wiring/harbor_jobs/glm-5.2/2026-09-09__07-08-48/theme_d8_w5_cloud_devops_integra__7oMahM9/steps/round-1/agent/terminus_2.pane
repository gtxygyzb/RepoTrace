   632	        elif v2 and not v1:
   633	            print(f"ONLY_IN {env2}: {s} ({v2})")
   634	        elif v1 == v2:
   635	            print(f"SAME: {s} ({v1})")
   636	        else:
   637	            cmp = compare_versions(v1, v2)
   638	            if cmp == 0:
   639	                print(f"SAME: {s} ({v1})")
   640	            else:
   641	                newer = env1 if cmp > 0 else env2
   642	                print(f"DIFFERS: {s} {v1} vs {v2} ({newer} newer)")
