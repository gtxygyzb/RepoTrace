   111	            if dep not in services:
   112	                continue
   113	            if visited.get(dep) == 1:
   114	                idx = stack.index(dep)
   115	                return stack[idx:] + [dep]
   116	            if visited.get(dep) is None:
   117	                res = dfs(dep)
   118	                if res:
   119	                    return res
   120	        stack.pop()
