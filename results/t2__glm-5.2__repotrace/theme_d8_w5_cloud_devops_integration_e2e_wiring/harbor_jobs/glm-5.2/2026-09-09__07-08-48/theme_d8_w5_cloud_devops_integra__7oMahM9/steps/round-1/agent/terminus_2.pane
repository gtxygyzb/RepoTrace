   264	def load_events(env):
   265	    ensure_state()
   266	    try:
   267	        with open(event_file(env)) as f:
   268	            lines = [line.rstrip("\n") for line in f if line.strip()]
   269	    except FileNotFoundError:
   270	        return []
   271	    events = []
   272	    for line in lines:
   273	        if line.startswith('{'):
   274	            continue
   275	        parts = line.split()
   276	        if len(parts) < 4:
   277	            continue
   278	        events.append({
   279	            "timestamp": parts[0],
   280	            "action": parts[1],
   281	            "service": parts[2],
   282	            "version": parts[3],
   283	            "line": line,
   284	        })
   285	    return events
