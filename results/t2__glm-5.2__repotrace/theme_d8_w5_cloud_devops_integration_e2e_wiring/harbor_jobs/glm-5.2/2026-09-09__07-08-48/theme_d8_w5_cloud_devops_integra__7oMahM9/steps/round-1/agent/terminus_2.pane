    service = rest[0]
    if service not in services:
        fail(f"unknown service '{service}'")

    if len(rest) >= 2 and rest[1] == '--bounds':
        if len(rest) == 2:
            ensure_state()
            state = load_deployment_state(env)
            if service not in state:
                fail(f"{service} is not deployed to {env}")
            bounds = load_bounds(env)
            svc_bounds = bounds.get(service)
            if svc_bounds:
                bmin, bmax = svc_bounds
                print(f"{service}: bounds [{bmin}..{bmax}]")
            else:
                print(f"{service}: no bounds set")
            return
        elif len(rest) == 4:
            min_str = rest[2]
            max_str = rest[3]
            ensure_state()
            state = load_deployment_state(env)
            if service not in state:
                fail(f"{service} is not deployed to {env}")
            bmin = parse_positive_int(min_str)
            if bmin is None:
                fail("invalid bounds: min must be >= 1")
            bmax = parse_positive_int(max_str)
            if bmax is None or bmax < bmin:
                fail("invalid bounds: max must be >= min")
            env_max = get_env_max(envs, env)
            if env_max is not None and bmax > env_max:
                fail(f"invalid bounds: max ({bmax}) exceeds max_replicas ({env_max}) for {env}")
            assert_not_locked(env)
            bounds = load_bounds(env)
            bounds[service] = [bmin, bmax]
            save_bounds(env, bounds)
            print(f"BOUNDS {env}/{service} set to [{bmin}..{bmax}]")
            replicas = load_replicas(env)
            current = replicas.get(service, 1)
            if current < bmin:
                previous = current
                replicas[service] = bmin
                save_replicas(env, replicas)
                append_scale_event(env, service, bmin, previous)
                print(f"SCALED {env}/{service} to {bmin} replicas (was {previous})")
            elif current > bmax:
                previous = current
                replicas[service] = bmax
                save_replicas(env, replicas)
                append_scale_event(env, service, bmax, previous)
                print(f"SCALED {env}/{service} to {bmax} replicas (was {previous})")
            return
        else:
            fail("scale <environment> <service> --bounds [<min> <max>]")

    if len(rest) == 2:
        count_str = rest[1]
        count = parse_positive_int(count_str)
        if count is None:
            fail(f"invalid replica count '{count_str}'")
        ensure_state()
        state = load_deployment_state(env)
        if service not in state:
            fail(f"{service} is not deployed to {env}")
        env_max = get_env_max(envs, env)
        if env_max is not None and count > env_max:
            fail(f"{count} exceeds max_replicas ({env_max}) for {env}")
        bounds = load_bounds(env)
        svc_bounds = bounds.get(service)
        if svc_bounds:
            bmin, bmax = svc_bounds
            if count < bmin or count > bmax:
                fail(f"{count} violates bounds [{bmin}..{bmax}] for {service} in {env}")
        assert_not_locked(env)
        replicas = load_replicas(env)
        previous = replicas.get(service, 1)
        replicas[service] = count
        save_replicas(env, replicas)
        append_scale_event(env, service, count, previous)
        print(f"SCALED {env}/{service} to {count} replicas (was {previous})")
        return

    if len(rest) == 1:
        ensure_state()
        state = load_deployment_state(env)
        if service not in state:
            fail(f"{service} is not deployed to {env}")
        replicas = load_replicas(env)
        count = replicas.get(service, 1)
        print(f"{service}: {count} replicas")
        return

    fail("scale: invalid arguments")

def main():
    if len(sys.argv) < 2:
        fail("no command given")

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd == 'validate':
        cmd_validate(args)
    elif cmd == 'order':
        cmd_order(args)
    elif cmd == 'build':
        cmd_build(args)
    elif cmd == 'test':
        cmd_test(args)
    elif cmd == 'deploy':
        cmd_deploy(args)
    elif cmd == 'status':
        cmd_status(args)
    elif cmd == 'rollback':
        cmd_rollback(args)
    elif cmd == 'promote':
        cmd_promote(args)
    elif cmd == 'diff':
        cmd_diff(args)
    elif cmd == 'history':
        cmd_history(args)
    elif cmd == 'graph':
        cmd_graph(args)
    elif cmd == 'bump':
        cmd_bump(args)
    elif cmd == 'snapshot':
        cmd_snapshot(args)
    elif cmd == 'restore':
        cmd_restore(args)
    elif cmd == 'lock':
        cmd_lock(args)
    elif cmd == 'unlock':
        cmd_unlock(args)
    elif cmd == 'config':
        cmd_config(args)
    elif cmd == 'scale':
        cmd_scale(args)
    else:
        fail(f"unknown command: {cmd}")

if __name__ == '__main__':
    main()
