   257	def load_events(env):
   258	    ensure_state()
   259	    try:
   260	        with open(event_file(env)) as f:
   261	            lines = [line.rstrip("\n") for line in f if line.strip()]
   262	    except FileNotFoundError:
   263	        return []
   264	    events = []
   265	    for line in lines:
   266	        parts = line.split()
   267	        if len(parts) < 4:
   268	            continue
   269	        events.append({
   270	            "timestamp": parts[0],
   271	            "action": parts[1],
   272	            "service": parts[2],
   273	            "version": parts[3],
   274	            "line": line,
   275	        })
   276	    return events
