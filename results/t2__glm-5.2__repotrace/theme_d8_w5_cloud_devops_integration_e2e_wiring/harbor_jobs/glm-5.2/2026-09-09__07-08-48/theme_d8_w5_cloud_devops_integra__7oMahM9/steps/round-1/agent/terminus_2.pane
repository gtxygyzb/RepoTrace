   172	def build_waves(services, subset):
   173	    subset = set(subset)
   174	
   175	    in_degree = {s: 0 for s in subset}
   176	    adj = {s: [] for s in subset}
   177	
   178	    for s in subset:
   179	        for dep in services[s].get('depends_on', []):
   180	            if dep in subset:
   181	                adj[dep].append(s)
   182	                in_degree[s] += 1
   183	
   184	    waves = []
   185	    available = sorted([s for s in subset if in_degree[s] == 0])
   186	    while available:
   187	        waves.append(available)
   188	        next_available = []
   189	        for s in available:
   190	            for dependent in sorted(adj[s]):
   191	                in_degree[dependent] -= 1
   192	                if in_degree[dependent] == 0:
   193	                    next_available.append(dependent)
   194	        available = sorted(next_available)
   195	
   196	    if sum(len(w) for w in waves) != len(subset):
   197	        fail("circular dependency detected")
   198	    return waves
