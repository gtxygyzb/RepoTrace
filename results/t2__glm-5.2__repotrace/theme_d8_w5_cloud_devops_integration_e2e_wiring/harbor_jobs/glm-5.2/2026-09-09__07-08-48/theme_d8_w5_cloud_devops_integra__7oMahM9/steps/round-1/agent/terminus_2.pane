   236	def load_deployment_state(env):
   237	    return load_json(deployment_file(env), {})
   238	
   239	def save_deployment_state(env, state):
   240	    save_json(deployment_file(env), state)
   241	
   242	def event_file(env):
   243	    return os.path.join(EVENTS_DIR, f"{env}.log")
