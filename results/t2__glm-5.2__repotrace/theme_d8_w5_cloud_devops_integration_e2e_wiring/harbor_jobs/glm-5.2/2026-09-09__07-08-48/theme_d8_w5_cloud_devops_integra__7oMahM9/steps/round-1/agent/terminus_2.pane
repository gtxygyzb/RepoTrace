   385	def find_rollback_target(env, service, current_version, to_version=None):
   386	    events = load_events(env)
   387	
   388	    if to_version is not None:
   389	        for ev in reversed(events):
   390	            if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] == to_version:
   391	                return to_version
   392	        fail(f"version not found in history for {service}")
   393	
   394	    current_idx = None
   395	    for idx, ev in enumerate(events):
   396	        if ev["service"] != service:
   397	            continue
   398	        if ev["version"] != current_version:
   399	            continue
   400	        if ev["action"] == "ROLLBACK" and ev["version"] == "-":
   401	            continue
   402	        current_idx = idx
   403	
   404	    if current_idx is None:
   405	        return None
   406	
   407	    for ev in reversed(events[:current_idx]):
   408	        if ev["service"] == service and ev["action"] != "ROLLBACK" and ev["version"] != current_version:
   409	            return ev["version"]
   410	    return None
