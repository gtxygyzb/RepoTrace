    64	def load_manifest():
    65	    try:
    66	        with open(MANIFEST_PATH) as f:
    67	            data = yaml.safe_load(f)
    68	    except FileNotFoundError:
    69	        fail("manifest not found")
    70	    except yaml.YAMLError as e:
    71	        fail(f"YAML syntax error: {e}")
    72	    if not isinstance(data, dict):
    73	        fail("manifest must be a mapping")
