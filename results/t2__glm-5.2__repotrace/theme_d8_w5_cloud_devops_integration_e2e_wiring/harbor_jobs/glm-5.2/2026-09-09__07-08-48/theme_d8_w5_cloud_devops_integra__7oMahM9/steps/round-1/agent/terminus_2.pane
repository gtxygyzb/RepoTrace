[?2004l#!/usr/bin/env bash
set -euo pipefail
tmp_script="$(mktemp)"
trap 'rm -f "$tmp_script"' EXIT
cat > "$tmp_script" <<'PY'
import sys
import os
import json
import time
import yaml
import re
from datetime import datetime, timezone

APP_DIR = '/app'
MANIFEST_PATH = '/app/pipeline.yaml'
STATE_DIR = '/app/.pipeline'
TEST_RESULTS_PATH = os.path.join(STATE_DIR, 'test_results.json')
DEPLOYMENTS_DIR = os.path.join(STATE_DIR, 'deployments')
EVENTS_DIR = os.path.join(STATE_DIR, 'events')
SNAPSHOTS_DIR = os.path.join(STATE_DIR, 'snapshots')
LOCK_DIR = os.path.join(STATE_DIR, 'locks')
CONFIG_DIR = os.path.join(STATE_DIR, 'config')
REPLICAS_DIR = os.path.join(STATE_DIR, 'replicas')
BOUNDS_DIR = os.path.join(STATE_DIR, 'bounds')
HEALTH_DIR = os.path.join(STATE_DIR, 'health')

SERVICE_FIELDS = ['version', 'path', 'build_cmd', 'test_cmd', 'port', 'depends_on', 'health_endpoint']
ENV_FIELDS = ['deploy_target', 'health_check_port', 'max_replicas']

def ensure_state():
    os.makedirs(STATE_DIR, exist_ok=True)
    os.makedirs(DEPLOYMENTS_DIR, exist_ok=True)
    os.makedirs(EVENTS_DIR, exist_ok=True)
    os.makedirs(SNAPSHOTS_DIR, exist_ok=True)
    os.makedirs(LOCK_DIR, exist_ok=True)
    os.makedirs(CONFIG_DIR, exist_ok=True)
    os.makedirs(REPLICAS_DIR, exist_ok=True)
    os.makedirs(BOUNDS_DIR, exist_ok=True)
    os.makedirs(HEALTH_DIR, exist_ok=True)

def fail(msg, code=1):
    print(f"ERROR: {msg}")
    sys.exit(code)

def now_iso():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return default
    except json.JSONDecodeError as e:
        fail(f"state error in {path}: {e}")

def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        json.dump(data, f, indent=2, sort_keys=True)

def load_manifest():
    try:
        with open(MANIFEST_PATH) as f:
            data = yaml.safe_load(f)
    except FileNotFoundError:
        fail("manifest not found")
    except yaml.YAMLError as e:
        fail(f"YAML syntax error: {e}")
    if not isinstance(data, dict):
        fail("manifest must be a mapping")
    return data

def validate_manifest(data):
    if not isinstance(data, dict):
        raise ValueError("manifest must be a mapping")

    services = data.get('services')
    if not isinstance(services, dict) or not services:
        raise ValueError("manifest missing services")

    environments = data.get('environments')
    if not isinstance(environments, dict) or not environments:
        raise ValueError("manifest missing environments")

    for env_name, env in environments.items():
        if not isinstance(env, dict):
            raise ValueError(f"environment {env_name} must be a mapping")
        for field in ENV_FIELDS:
            if field not in env:
                raise ValueError(f"environment {env_name} missing required field: {field}")

    for name, svc in services.items():
        if not isinstance(svc, dict):
            raise ValueError(f"service {name} must be a mapping")
        for field in SERVICE_FIELDS:
            if field not in svc:
                raise ValueError(f"service {name} missing required field: {field}")
        if not isinstance(svc['depends_on'], list):
            raise ValueError(f"service {name} has invalid depends_on: must be a list")
        for dep in svc['depends_on']:
            if dep not in services:
                raise ValueError(f"service {name} depends on undefined service: {dep}")
        if not valid_version(svc.get('version')):
            raise ValueError(f"service {name} has invalid version: expected N.N.N")

    port_map = {}
    for name, svc in services.items():
        port = svc['port']
        if port in port_map:
            raise ValueError(f"duplicate port assignment: {port}")
        port_map[port] = name

    cycle = find_cycle(services)
    if cycle:
        raise ValueError(f"circular dependency detected: {' -> '.join(cycle)}")

    return True

def find_cycle(services):
    visited = {}
    stack = []

    def dfs(node):
        visited[node] = 1
        stack.append(node)
        for dep in services[node].get('depends_on', []):
            if dep not in services:
                continue
            if visited.get(dep) == 1:
                idx = stack.index(dep)
                return stack[idx:] + [dep]
            if visited.get(dep) is None:
                res = dfs(dep)
                if res:
                    return res
        stack.pop()
        visited[node] = 2
        return None

    for n in sorted(services):
        if visited.get(n) is None:
            res = dfs(n)
            if res:
                return res
    return None

def get_services(data):
    try:
        validate_manifest(data)
    except ValueError as e:
        fail(str(e))
    return data['services'], data['environments']

def topo_order(services, subset=None):
    if subset is None:
        subset = set(services.keys())
    subset = set(subset)

    in_degree = {s: 0 for s in subset}
    adj = {s: [] for s in subset}

    for s in subset:
        for dep in services[s].get('depends_on', []):
            if dep in subset:
                adj[dep].append(s)
                in_degree[s] += 1

    order = []
    available = sorted([s for s in subset if in_degree[s] == 0])
    while available:
        next_available = []
        for s in available:
            order.append(s)
            for dependent in sorted(adj[s]):
                in_degree[dependent] -= 1
                if in_degree[dependent] == 0:
                    next_available.append(dependent)
        available = sorted(next_available)

[?2004hroot@n30009:/app# sed -n '180,420p' pipeline.sh
[?2004l
    if len(order) != len(subset):
        fail("circular dependency detected")
    return order

def build_waves(services, subset):
    subset = set(subset)

    in_degree = {s: 0 for s in subset}
    adj = {s: [] for s in subset}

    for s in subset:
        for dep in services[s].get('depends_on', []):
            if dep in subset:
                adj[dep].append(s)
                in_degree[s] += 1

    waves = []
    available = sorted([s for s in subset if in_degree[s] == 0])
    while available:
        waves.append(available)
        next_available = []
        for s in available:
            for dependent in sorted(adj[s]):
                in_degree[dependent] -= 1
                if in_degree[dependent] == 0:
                    next_available.append(dependent)
        available = sorted(next_available)

    if sum(len(w) for w in waves) != len(subset):
        fail("circular dependency detected")
    return waves

def transitive_deps(services, name):
    if name not in services:
        fail(f"service not found: {name}")
    result = set()
    stack = [name]
    while stack:
        s = stack.pop()
        if s not in result:
            result.add(s)
            for dep in services[s].get('depends_on', []):
                if dep not in services:
                    fail(f"service {s} depends on undefined service: {dep}")
                stack.append(dep)
    return result

def service_path(svc):
    p = svc.get('path', '')
    if os.path.isabs(p):
        return p
    return os.path.join(APP_DIR, p)

def artifact_path(svc):
    return os.path.join(service_path(svc), 'build', 'artifact.txt')

def read_artifact(svc):
    try:
        with open(artifact_path(svc)) as f:
            return f.read().strip()
    except FileNotFoundError:
        return None

def deployment_file(env):
    return os.path.join(DEPLOYMENTS_DIR, f"{env}.json")

def load_deployment_state(env):
    return load_json(deployment_file(env), {})

def save_deployment_state(env, state):
    save_json(deployment_file(env), state)

def replica_file(env):
    return os.path.join(REPLICAS_DIR, f"{env}.json")

def load_replicas(env):
    return load_json(replica_file(env), {})

def save_replicas(env, replicas):
    save_json(replica_file(env), replicas)

def bounds_file(env):
    return os.path.join(BOUNDS_DIR, f"{env}.json")

def load_bounds(env):
    return load_json(bounds_file(env), {})

def save_bounds(env, bounds):
    save_json(bounds_file(env), bounds)

def health_file(env):
    return os.path.join(HEALTH_DIR, f"{env}.json")

def load_health(env):
    return load_json(health_file(env), {})

def save_health(env, data):
    save_json(health_file(env), data)

def is_valid_health_state(state):
    return state in ("healthy", "unhealthy", "degraded")

def get_health_state(env, service):
    health = load_health(env)
    rec = health.get(service)
    if not rec or rec.get("state") not in ("healthy", "unhealthy", "degraded"):
        return "healthy"
    state = load_deployment_state(env)
    snapshot = rec.get("state_snapshot")
    if not snapshot or state.get(service) != snapshot:
        return "healthy"
    return rec["state"]

def reset_health(env, service):
    health = load_health(env)
    if service in health:
        del health[service]
        save_health(env, health)

def reset_all_health(env):
    health = load_health(env)
    if health:
        save_health(env, {})

def append_health_event(env, service, new_state, previous_state):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "HEALTH",
        "service": service,
        "version": "-",
        "state": new_state,
        "previous_state": previous_state,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + "\n")

def get_replica_count(env, service):
    replicas = load_replicas(env)
    return replicas.get(service, 1)

def get_env_max(envs, env):
    env_max = envs[env].get('max_replicas')
    if env_max is None:
        return None
    try:
        return int(env_max)
    except (ValueError, TypeError):
        return None

def parse_positive_int(s):
    if not isinstance(s, str):
        return None
    if not re.fullmatch('[0-9]+', s):
        return None
    val = int(s)
    if val < 1:
        return None
    return val


def event_file(env):
    return os.path.join(EVENTS_DIR, f"{env}.log")

def append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):
    ensure_state()
    ts = now_iso()
    line = f"{ts} {action} {service} {version}"
    if action == "PROMOTE" and source_env is not None:
        line += f" from {source_env}"
        if forced:
            line += " (forced)"
    if action == "RESTORE" and snapshot_id is not None:
        line += f" from snapshot #{snapshot_id}"
    line += "\n"
    with open(event_file(env), "a") as f:
        f.write(line)

def append_scale_event(env, service, count, previous):
    ensure_state()
    event = {
        "timestamp": int(time.time()),
        "iso_timestamp": now_iso(),
        "action": "SCALE",
        "service": service,
        "version": "-",
        "replicas": count,
        "previous": previous,
    }
    with open(event_file(env), "a") as f:
        f.write(json.dumps(event) + chr(10))

def load_events(env):
    ensure_state()
    try:
        with open(event_file(env)) as f:
            lines = [line.rstrip("\n") for line in f if line.strip()]
    except FileNotFoundError:
        return []
    events = []
    for line in lines:
        if line.startswith('{'):
            continue
        parts = line.split()
        if len(parts) < 4:
            continue
        events.append({
            "timestamp": parts[0],
            "action": parts[1],
            "service": parts[2],
            "version": parts[3],
            "line": line,
        })
    return events

def lock_file(env):
    return os.path.join(LOCK_DIR, f"{env}.json")

def load_lock(env):
    return load_json(lock_file(env), None)

def save_lock(env, reason):
    ensure_state()
    existing = load_lock(env)
    locked_since = existing.get('locked_since', now_iso()) if existing else now_iso()
    lock = {"reason": reason, "locked_since": locked_since}
    save_json(lock_file(env), lock)

