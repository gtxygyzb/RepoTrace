   103	def find_cycle(services):
   104	    visited = {}
   105	    stack = []
   106	
   107	    def dfs(node):
   108	        visited[node] = 1
   109	        stack.append(node)
   110	        for dep in services[node].get('depends_on', []):
   111	            if dep not in services:
   112	                continue
   113	            if visited.get(dep) == 1:
   114	                idx = stack.index(dep)
   115	                return stack[idx:] + [dep]
   116	            if visited.get(dep) is None:
   117	                res = dfs(dep)
   118	                if res:
   119	                    return res
   120	        stack.pop()
   121	        visited[node] = 2
   122	        return None
   123	
   124	    for n in sorted(services):
   125	        if visited.get(n) is None:
   126	            res = dfs(n)
   127	            if res:
   128	                return res
   129	    return None
