   122	def find_cycle(services):
   123	    visited = {}
   124	    stack = []
   125	
   126	    def dfs(node):
   127	        visited[node] = 1
   128	        stack.append(node)
   129	        for dep in services[node].get('depends_on', []):
   130	            if dep not in services:
   131	                continue
   132	            if visited.get(dep) == 1:
   133	                idx = stack.index(dep)
   134	                return stack[idx:] + [dep]
   135	            if visited.get(dep) is None:
   136	                res = dfs(dep)
   137	                if res:
   138	                    return res
   139	        stack.pop()
   140	        visited[node] = 2
   141	        return None
   142	
   143	    for n in sorted(services):
   144	        if visited.get(n) is None:
   145	            res = dfs(n)
   146	            if res:
   147	                return res
   148	    return None
