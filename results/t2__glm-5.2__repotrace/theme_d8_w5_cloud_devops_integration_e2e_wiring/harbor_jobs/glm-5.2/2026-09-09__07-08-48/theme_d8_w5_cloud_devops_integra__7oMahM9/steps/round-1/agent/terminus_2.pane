   243	def append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):
   244	    ensure_state()
   245	    ts = now_iso()
   246	    line = f"{ts} {action} {service} {version}"
   247	    if action == "PROMOTE" and source_env is not None:
   248	        line += f" from {source_env}"
   249	        if forced:
   250	            line += " (forced)"
   251	    if action == "RESTORE" and snapshot_id is not None:
   252	        line += f" from snapshot #{snapshot_id}"
   253	    line += "\n"
   254	    with open(event_file(env), "a") as f:
   255	        f.write(line)
