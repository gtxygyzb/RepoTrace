   524	def cmd_quota(args):
   525	    if not args:
   526	        fail("quota requires <environment> <set|get|list|remove|--check> [args]")
   527	    env = args[0]
   528	    if len(args) < 2:
   529	        fail("quota requires <environment> <set|get|list|remove|--check> [args]")
   530	    sub = args[1]
   531	    rest = args[2:]
   532	
   533	    assert_env_exists(env)
   534	
   535	    if sub == 'set':
   536	        if len(rest) != 2:
   537	            fail("quota <environment> set <resource> <limit>")
   538	        resource, limit_str = rest
   539	        validate_quota_resource(resource)
   540	        limit = parse_positive_int(limit_str)
   541	        if limit is None:
   542	            fail(f"invalid quota limit '{limit_str}'")
   543	        assert_not_locked(env)
   544	        quotas = load_quotas(env)
   545	        quotas[resource] = limit
   546	        save_quotas(env, quotas)
   547	        append_quota_set_event(env, resource, limit)
   548	        print(f"QUOTA {env}: {resource}={limit}")
   549	    elif sub == 'get':
   550	        if len(rest) != 1:
   551	            fail("quota <environment> get <resource>")
   552	        resource = rest[0]
   553	        validate_quota_resource(resource)
   554	        quotas = load_quotas(env)
   555	        usage = quota_current_usage(env, resource)
   556	        if resource in quotas:
   557	            print(f"{resource}: {quotas[resource]} (current: {usage})")
   558	        else:
   559	            print(f"{resource}: not set (current: {usage})")
   560	    elif sub == 'list':
   561	        quotas = load_quotas(env)
   562	        for resource in quota_supported_resources():
   563	            if resource in quotas:
   564	                usage = quota_current_usage(env, resource)
   565	                print(f"{resource}: {quotas[resource]} (current: {usage})")
   566	    elif sub == 'remove':
   567	        if len(rest) != 1:
   568	            fail("quota <environment> remove <resource>")
   569	        resource = rest[0]
   570	        validate_quota_resource(resource)
   571	        assert_not_locked(env)
   572	        quotas = load_quotas(env)
   573	        if resource not in quotas:
   574	            fail(f"quota '{resource}' not set in {env}")
   575	        del quotas[resource]
   576	        save_quotas(env, quotas)
   577	        append_quota_remove_event(env, resource)
   578	        print(f"QUOTA {env}: removed {resource}")
   579	    elif sub == '--check':
   580	        quotas = load_quotas(env)
   581	        exceeded = 0
   582	        for resource in quota_supported_resources():
   583	            if resource in quotas:
   584	                limit = quotas[resource]
   585	                usage = quota_current_usage(env, resource)
   586	                if usage > limit:
   587	                    print(f"{resource}: EXCEEDED ({usage}/{limit})")
   588	                    exceeded += 1
   589	                else:
   590	                    print(f"{resource}: OK ({usage}/{limit})")
   591	        if exceeded:
   592	            print(f"{exceeded} quota(s) exceeded")
   593	        else:
   594	            print("All quotas OK")
   595	    else:
   596	        fail("quota requires <environment> <set|get|list|remove|--check> [args]")
