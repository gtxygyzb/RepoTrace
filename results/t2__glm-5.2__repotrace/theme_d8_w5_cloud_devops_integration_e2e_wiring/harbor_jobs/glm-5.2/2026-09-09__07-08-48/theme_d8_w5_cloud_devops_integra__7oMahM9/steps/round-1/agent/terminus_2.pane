   538	    if source not in envs:
   539	        fail(f"environment not found: {source}")
   540	    if target not in envs:
   541	        fail(f"environment not found: {target}")
   542	
   543	    if service:
   544	        subset = transitive_deps(services, service)
   545	    else:
   546	        subset = set(services.keys())
   547	
   548	    ensure_state()
   549	    source_state = load_deployment_state(source)
   550	    target_state = load_deployment_state(target)
   551	
   552	    candidates = {s for s in source_state if s in subset and s in services}
   553	    order = topo_order(services, candidates)
   554	
   555	    if dry_run:
   556	        print(f"DRY-RUN promote from {source} to {target}:")
   557	        for s in order:
   558	            src_version = source_state[s].get("version")
   559	            tgt_version = target_state.get(s, {}).get("version")
   560	            if src_version == tgt_version:
   561	                continue
   562	            src_sv = extract_semver(src_version)
   563	            tgt_sv = extract_semver(tgt_version)
   564	            if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:
   565	                print(f"  Would conflict {s} (downgrade)")
   566	            else:
   567	                print(f"  Would promote {s}")
   568	        return
   569	
   570	    promoted = 0
   571	    skipped = 0
   572	    conflicts = 0
   573	    promote_events = []
   574	
   575	    for s in order:
   576	        src_rec = source_state[s]
   577	        src_version = src_rec.get("version")
   578	        if target_state.get(s, {}).get("version") == src_version:
   579	            print(f"PROMOTE {s} -> {target}: SKIP (same version)")
   580	            skipped += 1
   581	            continue
   582	
   583	        src_sv = extract_semver(src_version)
   584	        tgt_sv = extract_semver(target_state.get(s, {}).get("version"))
   585	        if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:
   586	            if force:
   587	                target_state[s] = src_rec
   588	                print(f"PROMOTE {s} -> {target} OK (forced)")
   589	                promoted += 1
   590	                promote_events.append((s, src_version, True))
   591	            else:
   592	                print(f"CONFLICT: {s} -> {target}: downgrade ({src_sv[0]}.{src_sv[1]}.{src_sv[2]} < {tgt_sv[0]}.{tgt_sv[1]}.{tgt_sv[2]})")
   593	                conflicts += 1
   594	            continue
   595	
   596	        target_state[s] = src_rec
   597	        print(f"PROMOTE {s} -> {target} OK")
   598	        promoted += 1
   599	        promote_events.append((s, src_version, False))
   600	
   601	    save_deployment_state(target, target_state)
   602	    for s, version, forced in promote_events:
   603	        append_event(target, "PROMOTE", s, version, source, forced=forced)
   604	    print(f"Promoted {promoted}, skipped {skipped}, conflicts {conflicts}")
   605	def cmd_diff(args):
