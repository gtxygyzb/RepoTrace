   522	def parse_opts(args, value_opts, flag_opts):
   523	    values = {}
   524	    flags = set()
   525	    positionals = []
   526	    i = 0
   527	    while i < len(args):
   528	        a = args[i]
   529	        if a in value_opts:
   530	            i += 1
   531	            if i >= len(args):
   532	                fail(f"{a} requires a value")
   533	            values[a] = args[i]
   534	        elif a in flag_opts:
   535	            flags.add(a)
   536	        elif a.startswith('--'):
   537	            fail(f"unknown option: {a}")
   538	        else:
   539	            positionals.append(a)
   540	        i += 1
   541	    return values, flags, positionals
