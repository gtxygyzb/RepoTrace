[3878.9858, "o", "\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd_\u001b[m\u001b[Kvalidate(args):\r\n\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd_\u001b[m\u001b[Korder(args):\r\n\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd_\u001b[m\u001b[Kbuild(args):\r\n\u001b[32m\u001b[K339\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd_\u001b[m\u001b[Ktest(args):\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd_\u001b[m\u001b[K\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[K(args):\r\n\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fail(\"\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[K requires an environment\")\r\n"]
[3878.985862, "o", "\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        print(f\"DRY-RUN \u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[K to {env}:\")\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            print(f\"  Would \u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[K {s}\")\r\n\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    state = load_\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Kment_state(env)\r\n\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Ked_events = []\r\n\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        state[s] = {\"version\": version, \"\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Ked_at\": now_iso()}\r\n"]
[3878.98593, "o", "\u001b[32m\u001b[K424\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Ked_events.append((s, version))\r\n\u001b[32m\u001b[K427\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    save_\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Kment_state(env, state)\r\n\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    for s, version in \u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Ked_events:\r\n"]
[3878.985993, "o", "\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd_\u001b[m\u001b[Kstatus(args):\r\n\u001b[32m\u001b[K444\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        state = load_\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Kment_state(env)\r\n\u001b[32m\u001b[K447\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            print(f\"{s}: {rec.get('version', '')} (\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Ked at {rec.get('\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Ked_at', '')})\")\r\n\u001b[32m\u001b[K450\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            state = load_\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Kment_state(env)\r\n\u001b[32m\u001b[K451\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            print(f\"{env}: {len(state)} services \u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Ked\")\r\n"]
