[3484.44795, "o", "def version_build_timestamp(version):\r\n\u001b[?2004l\r"]
[3484.447994, "o", "\u001b[?2004h> "]
[3484.448332, "o", "    if not isinstance(version, str) or '+build.' not in version:\r\n\u001b[?2004l\r"]
[3484.448377, "o", "\u001b[?2004h> "]
[3484.448461, "o", "        return None\r\n\u001b[?2004l\r"]
[3484.448507, "o", "\u001b[?2004h> "]
[3484.448721, "o", "    after = version.split('+build.', 1)[1]\r\n\u001b[?2004l\r"]
[3484.448766, "o", "\u001b[?2004h> "]
[3484.448811, "o", "    try:\r\n\u001b[?2004l\r"]
[3484.448855, "o", "\u001b[?2004h> "]
[3484.448993, "o", "        return int(after)\r\n\u001b[?2004l\r"]
[3484.449037, "o", "\u001b[?2004h> "]
[3484.449152, "o", "    except ValueError:\r\n\u001b[?2004l\r"]
[3484.449196, "o", "\u001b[?2004h> "]
[3484.486553, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def compare_versions(a, b):\r\n\u001b[?2004l\r\u001b[?2004h>     sa = extract_semver(a)\r\n\u001b[?2004l\r\u001b[?2004h>     sb = extract_semver(b)\r\n\u001b[?2004l\r\u001b[?2004h>     if sa is not None and sb is not None:\r\n\u001b[?2004l\r\u001b[?2004h>         if sa != sb:\r\n\u001b[?2004l\r\u001b[?2004h>             return 1 if sa > sb else -1\r\n\u001b[?2004l\r\u001b[?2004h>         ta = version_build_timestamp(a)\r\n\u001b[?2004l\r\u001b[?2004h>         tb = version_build_timestamp(b)\r\n\u001b[?2004l\r\u001b[?2004h>         if ta is not None and tb is not None and ta != tb:\r\n\u001b[?2004l\r\u001b[?2004h>             return 1 if ta > tb else -1\r\n\u001b[?2004l\ru\u001b[?2004h>         return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.486959, "o", "    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)\r\n\u001b[?2004l\r"]
[3484.487016, "o", "\u001b[?2004h"]
[3484.487079, "o", "> \"\"\")\r\n\u001b[?2004l\r"]
[3484.487135, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3484.487188, "o", "\u001b[?2004h> "]
[3484.487373, "o", "# Replace cmd_promote\r\n\u001b[?2004l\r"]
[3484.487436, "o", "\u001b[?2004h> "]
[3484.487816, "o", "replace_func('cmd_promote', \"\"\"def cmd_promote(args):\r\n\u001b[?2004l\r"]
[3484.487875, "o", "\u001b[?2004h> "]
[3484.48849, "o", "    values, flags, positionals = parse_opts(args, {\"--service\"}, {\"--dry-run\", \"--force\"})\r\n\u001b[?2004l\r"]
[3484.488556, "o", "\u001b[?2004h> "]
[3484.488756, "o", "    if len(positionals) != 2:\r\n\u001b[?2004l\r"]
[3484.488812, "o", "\u001b[?2004h> "]
[3484.489228, "o", "        fail(\"promote requires <source-env> <target-env>\")\r\n\u001b[?2004l\r"]
[3484.489299, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3484.489355, "o", "\u001b[?2004h> "]
[3484.489581, "o", "    source, target = positionals\r\n\u001b[?2004l\r"]
[3484.489645, "o", "\u001b[?2004h> "]
[3484.489903, "o", "    service = values.get(\"--service\")\r\n\u001b[?2004l\r"]
[3484.489958, "o", "\u001b[?2004h> "]
[3484.490197, "o", "    dry_run = \"--dry-run\" in flags\r\n\u001b[?2004l\r"]
[3484.490253, "o", "\u001b[?2004h> "]
[3484.490496, "o", "    force = \"--force\" in flags\r\n\u001b[?2004l\r"]
[3484.490544, "o", "\u001b[?2004h> \r\n"]
[3484.490603, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3484.490802, "o", "    data = load_manifest()\r\n\u001b[?2004l\r"]
[3484.49086, "o", "\u001b[?2004h> "]
[3484.491149, "o", "    services, envs = get_services(data)\r\n\u001b[?2004l\r"]
[3484.491212, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3484.491268, "o", "\u001b[?2004h> "]
[3484.491465, "o", "    if source not in envs:\r\n\u001b[?2004l\r"]
[3484.491522, "o", "\u001b[?2004h> "]
[3484.491874, "o", "        fail(f\"environment not found: {source}\")\r\n\u001b[?2004l\r"]
[3484.49193, "o", "\u001b[?2004h> "]
[3484.492111, "o", "    if target not in envs:\r\n"]
[3484.492166, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3484.492545, "o", "        fail(f\"environment not found: {target}\")\r\n\u001b[?2004l\r"]
[3484.492615, "o", "\u001b[?2004h> "]
[3484.49267, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[3484.492723, "o", "> "]
[3484.492812, "o", "    if service:\r\n\u001b[?2004l\r"]
[3484.492877, "o", "\u001b[?2004h> "]
[3484.493225, "o", "        subset = transitive_deps(services, service)\r\n\u001b[?2004l\r"]
[3484.49328, "o", "\u001b[?2004h> "]
[3484.493365, "o", "    else:\r\n\u001b[?2004l\r"]
[3484.49343, "o", "\u001b[?2004h> "]
[3484.493687, "o", "        subset = set(services.keys())\r\n\u001b[?2004l\r"]
[3484.49381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.493958, "o", "    ensure_state()\r\n\u001b[?2004l\r"]
[3484.494065, "o", "\u001b[?2004h> "]
[3484.494384, "o", "    source_state = load_deployment_state(source)\r\n\u001b[?2004l\r"]
[3484.494474, "o", "\u001b[?2004h> "]
[3484.494789, "o", "    target_state = load_deployment_state(target)\r\n\u001b[?2004l\r"]
[3484.494877, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3484.494978, "o", "> "]
[3484.495469, "o", "    candidates = {s for s in source_state if s in subset and s in services}\r\n\u001b[?2004l\r"]
[3484.495565, "o", "\u001b[?2004h> "]
[3484.495858, "o", "    order = topo_order(services, candidates)\r\n\u001b[?2004l\r"]
[3484.495944, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3484.496035, "o", "> "]
[3484.496135, "o", "    if dry_run:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.496557, "o", "        print(f\"DRY-RUN promote from {source} to {target}:\")\r\n\u001b[?2004l\r"]
[3484.496646, "o", "\u001b[?2004h> "]
[3484.496787, "o", "        for s in order:\r\n\u001b[?2004l\r"]
[3484.496874, "o", "\u001b[?2004h> "]
[3484.497266, "o", "            src_version = source_state[s].get(\"version\")\r\n\u001b[?2004l\r"]
[3484.497365, "o", "\u001b[?2004h> "]
[3484.497801, "o", "            tgt_version = target_state.get(s, {}).get(\"version\")\r\n\u001b[?2004l\r"]
[3484.497887, "o", "\u001b[?2004h> "]
[3484.498157, "o", "            if src_version == tgt_version:\r\n\u001b[?2004l\r"]
[3484.498244, "o", "\u001b[?2004h> "]
[3484.498412, "o", "                continue\r\n\u001b[?2004l\r"]
[3484.498499, "o", "\u001b[?2004h> "]
[3484.4988, "o", "            src_sv = extract_semver(src_version)\r\n\u001b[?2004l\r"]
[3484.498884, "o", "\u001b[?2004h> "]
[3484.49921, "o", "            tgt_sv = extract_semver(tgt_version)\r\n\u001b[?2004l\r"]
[3484.499308, "o", "\u001b[?2004h> "]
[3484.499796, "o", "            if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:\r\n\u001b[?2004l\r"]
[3484.499887, "o", "\u001b[?2004h> "]
[3484.500267, "o", "                print(f\"  Would conflict {s} (downgrade)\")\r\n\u001b[?2004l\r"]
[3484.500371, "o", "\u001b[?2004h> "]
[3484.500481, "o", "            else:\r\n\u001b[?2004l\r"]
[3484.500589, "o", "\u001b[?2004h> "]
[3484.500863, "o", "                print(f\"  Would promote {s}\")\r\n\u001b[?2004l\r"]
[3484.500952, "o", "\u001b[?2004h> "]
[3484.501038, "o", "        return\r\n\u001b[?2004l\r"]
[3484.501135, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3484.501176, "o", "> "]
[3484.501318, "o", "    promoted = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[3484.501415, "o", "> "]
[3484.501514, "o", "    skipped = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.50165, "o", "    conflicts = 0\r\n\u001b[?2004l\r"]
[3484.501753, "o", "\u001b[?2004h> "]
[3484.501873, "o", "    promote_events = []\r\n\u001b[?2004l\r"]
[3484.501966, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3484.502062, "o", "> "]
[3484.502158, "o", "    for s in order:\r\n"]
[3484.502263, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3484.502429, "o", "        src_rec = source_state[s]\r\n\u001b[?2004l\r"]
[3484.502517, "o", "\u001b[?2004h> "]
[3484.502728, "o", "        src_version = src_rec.get(\"version\")\r\n\u001b[?2004l\r"]
[3484.502818, "o", "\u001b[?2004h> "]
[3484.503122, "o", "        if target_state.get(s, {}).get(\"version\") == src_version:\r\n\u001b[?2004l\r"]
[3484.503209, "o", "\u001b[?2004h> "]
[3484.503554, "o", "            print(f\"PROMOTE {s} -> {target}: SKIP (same version)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[3484.503646, "o", "> "]
[3484.503738, "o", "            skipped += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[3484.503837, "o", "> "]
[3484.503942, "o", "            continue\r\n\u001b[?2004l\r"]
[3484.504045, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.504142, "o", "        src_sv = extract_semver(src_version)\r\n\u001b[?2004l\r"]
[3484.50424, "o", "\u001b[?2004h"]
[3484.504367, "o", "> "]
[3484.504491, "o", "        tgt_sv = extract_semver(target_state.get(s, {}).get(\"version\"))\r\n\u001b[?2004l\r"]
[3484.504582, "o", "\u001b[?2004h> "]
[3484.504845, "o", "        if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:\r\n\u001b[?2004l\r"]
[3484.504931, "o", "\u001b[?2004h> "]
[3484.505028, "o", "            if force:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.505212, "o", "                target_state[s] = src_rec\r\n\u001b[?2004l\r"]
[3484.505306, "o", "\u001b[?2004h> "]
[3484.505518, "o", "                print(f\"PROMOTE {s} -> {target} OK (forced)\")\r\n\u001b[?2004l\r"]
[3484.505604, "o", "\u001b[?2004h> "]
[3484.505684, "o", "                promoted += 1\r\n\u001b[?2004l\r"]
[3484.505779, "o", "\u001b[?2004h> "]
[3484.505993, "o", "                promote_events.append((s, src_version, True))\r\n\u001b[?2004l\r"]
[3484.506079, "o", "\u001b[?2004h> "]
[3484.506184, "o", "            else:\r\n\u001b[?2004l\r"]
[3484.506285, "o", "\u001b[?2004h> "]
[3484.506719, "o", "                print(f\"CONFLICT: {s} -> {target}: downgrade ({src_sv[0]}.{src_sv[1]}.{src_sv[2]} < {tgt_sv[0]}.{tgt_sv[1]}.{tgt_sv[2]})\")\r\n\u001b[?2004l\r"]
[3484.506809, "o", "\u001b[?2004h> "]
[3484.506906, "o", "                conflicts += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[3484.506999, "o", "> "]
[3484.507104, "o", "            continue\r\n\u001b[?2004l\r"]
[3484.507201, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.507311, "o", "        target_state[s] = src_rec\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.507498, "o", "        print(f\"PROMOTE {s} -> {target} OK\")\r\n\u001b[?2004l\r"]
[3484.507586, "o", "\u001b[?2004h> "]
[3484.507685, "o", "        promoted += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.507909, "o", "        promote_events.append((s, src_version, False))\r\n\u001b[?2004l\r"]
[3484.507996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.508188, "o", "    save_deployment_state(target, target_state)\r\n\u001b[?2004l\r"]
[3484.508275, "o", "\u001b[?2004h> "]
[3484.508426, "o", "    for s, version, forced in promote_events:\r\n\u001b[?2004l\r"]
[3484.50851, "o", "\u001b[?2004h> "]
[3484.508772, "o", "        append_event(target, \"PROMOTE\", s, version, source, forced=forced)\r\n\u001b[?2004l\r"]
[3484.508857, "o", "\u001b[?2004h> "]
[3484.509133, "o", "    print(f\"Promoted {promoted}, skipped {skipped}, conflicts {conflicts}\")\r\n\u001b[?2004l\r"]
[3484.509219, "o", "\u001b[?2004h> \"\"\")\r\n\u001b[?2004l\r\u001b[?2004h"]
