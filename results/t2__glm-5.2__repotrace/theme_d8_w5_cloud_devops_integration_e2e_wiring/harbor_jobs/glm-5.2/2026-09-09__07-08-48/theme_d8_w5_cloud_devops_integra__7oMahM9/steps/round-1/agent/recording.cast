[1131.615357, "o", "\r\n\u001b[?2004l\rr\u001b[?2004h"]
[1131.615426, "o", "> "]
[1131.615494, "o", "def load_deployment_state(env):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.615587, "o", "    return load_json(deployment_file(env), {})\r\n\u001b[?2004l\r"]
