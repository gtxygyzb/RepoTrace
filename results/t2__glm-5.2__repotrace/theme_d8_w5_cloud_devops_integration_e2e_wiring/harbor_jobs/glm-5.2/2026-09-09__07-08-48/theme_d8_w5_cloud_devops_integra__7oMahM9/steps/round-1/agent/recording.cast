[11411.618337, "o", "    if rest and rest[0] == '--all':\r\n        if len(rest) != 2:\r\n            fail(\"scale <environment> --all <count>\")\r\n        count_str = rest[1]\r\n        count = parse_positive_int(count_str)\r\n        if count is None:\r\n            fail(f\"invalid replica count '{count_str}'\")\r\n        ensure_state()\r\n        state = load_deployment_state(env)\r\n        if not state:\r\n            fail(f\"no services deployed in {env}\")\r\n        env_max = get_env_max(envs, env)\r\n        if env_max is not None and count > env_max:\r\n"]
[11411.618406, "o", "            fail(f\"{count} exceeds max_replicas ({env_max}) for {env}\")\r\n        bounds = load_bounds(env)\r\n        replicas = load_replicas(env)\r\n        for s in sorted(state):\r\n            svc_bounds = bounds.get(s)\r\n            if svc_bounds:\r\n                bmin, bmax = svc_bounds\r\n                if count < bmin or count > bmax:\r\n                    fail(f\"{count} violates bounds [{bmin}..{bmax}] for {s} in {env}\")\r\n        for s in sorted(state):\r\n            if get_health_state(env, s) == \"unhealthy\" and count > replicas.get(s, 1):\r\n                fail(f\"cannot scale up unhealthy service '{s}' in {env}\")\r\n        assert_not_locked(env)\r\n        for s in sorted(state):\r\n"]
[11411.618471, "o", "            previous = replicas.get(s, 1)\r\n            replicas[s] = count\r\n            append_scale_event(env, s, count, previous)\r\n            print(f\"SCALED {env}/{s} to {count} replicas (was {previous})\")\r\n        save_replicas(env, replicas)\r\n        print(f\"Scaled {len(state)} services to {count} replicas\")\r\n        return\r\n\r\n    if not rest:\r\n        ensure_state()\r\n        state = load_deployment_state(env)\r\n"]
[11411.618536, "o", "        replicas = load_replicas(env)\r\n        for s in sorted(state):\r\n            print(f\"{s}: {replicas.get(s, 1)} replicas\")\r\n        return\r\n\r\n    service = rest[0]\r\n    if service not in services:\r\n        fail(f\"unknown service '{service}'\")\r\n\r\n    if len(rest) >= 2 and rest[1] == '--bounds':\r\n        if len(rest) == 2:\r\n            ensure_state()\r\n            state = load_deployment_state(env)\r\n            if service not in state:\r\n                fail(f\"{service} is not deployed to {env}\")\r\n            bounds = load_bounds(env)\r\n"]
[11411.618618, "o", "            svc_bounds = bounds.get(service)\r\n            if svc_bounds:\r\n                bmin, bmax = svc_bounds\r\n                print(f\"{service}: bounds [{bmin}..{bmax}]\")\r\n            else:\r\n                print(f\"{service}: no bounds set\")\r\n            return\r\n        elif len(rest) == 4:\r\n            min_str = rest[2]\r\n            max_str = rest[3]\r\n            ensure_state()\r\n            state = load_deployment_state(env)\r\n            if service not in state:\r\n                fail(f\"{service} is not deployed to {env}\")\r\n            bmin = parse_positive_int(min_str)\r\n            if bmin is None:\r\n                fail(\"invalid bounds: min must be >= 1\")\r\n"]
[11411.61868, "o", "            bmax = parse_positive_int(max_str)\r\n            if bmax is None or bmax < bmin:\r\n                fail(\"invalid bounds: max must be >= min\")\r\n            env_max = get_env_max(envs, env)\r\n            if env_max is not None and bmax > env_max:\r\n                fail(f\"invalid bounds: max ({bmax}) exceeds max_replicas ({env_max}) for {env}\")\r\n            assert_not_locked(env)\r\n            bounds = load_bounds(env)\r\n            bounds[service] = [bmin, bmax]\r\n            save_bounds(env, bounds)\r\n            print(f\"BOUNDS {env}/{service} set to [{bmin}..{bmax}]\")\r\n            replicas = load_replicas(env)\r\n"]
[11411.618746, "o", "            current = replicas.get(service, 1)\r\n            if current < bmin:\r\n                previous = current\r\n                replicas[service] = bmin\r\n                save_replicas(env, replicas)\r\n                append_scale_event(env, service, bmin, previous)\r\n                print(f\"SCALED {env}/{service} to {bmin} replicas (was {previous})\")\r\n            elif current > bmax:\r\n                previous = current\r\n                replicas[service] = bmax\r\n                save_replicas(env, replicas)\r\n                append_scale_event(env, service, bmax, previous)\r\n                print(f\"SCALED {env}/{service} to {bmax} replicas (was {previous})\")\r\n            return"]
