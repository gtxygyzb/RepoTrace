[7531.593089, "o", "   536\tdef cmd_deploy(args):\r\n   537\t    values, flags, positionals = parse_opts(args, {'--service'}, {'--dry-run'})\r\n   538\t    if len(positionals) != 1:\r\n   539\t        fail(\"deploy requires an environment\")\r\n   540\t\r\n   541\t    env = positionals[0]\r\n   542\t    service = values.get('--service')\r\n   543\t    dry_run = '--dry-run' in flags\r\n   544\t\r\n   545\t    data = load_manifest()\r\n"]
[7531.593257, "o", "   546\t    services, envs = get_services(data)\r\n   547\t\r\n   548\t    if env not in envs:\r\n   549\t        fail(f\"environment not found: {env}\")\r\n   550\t\r\n   551\t    assert_not_locked(env)\r\n   552\t\r\n   553\t    if service:\r\n   554\t        subset = transitive_deps(services, service)\r\n   555\t    else:\r\n   556\t        subset = set(services.keys())\r\n   557\t\r\n   558\t    order = topo_order(services, subset)\r\n   559\t    ensure_state()\r\n   560\t\r\n   561\t    if dry_run:\r\n   562\t        print(f\"DRY-RUN deploy to {env}:\")\r\n   563\t        for s in order:\r\n   564\t            print(f\"  Would deploy {s}\")\r\n   565\t        return\r\n   566\t\r\n   567\t    test_results = load_json(TEST_RESULTS_PATH, {})\r\n   568\t    state = load_deployment_state(env)\r\n   569\t    any_fail = False\r\n   570\t    deployed_events = []\r\n   571\t\r\n"]
[7531.593427, "o", "   572\t    for s in order:\r\n   573\t        rec = test_results.get(s)\r\n   574\t        if not rec or not rec.get(\"pass\"):\r\n   575\t            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n   576\t            any_fail = True\r\n   577\t            break\r\n   578\t\r\n   579\t        version = read_artifact(services[s])\r\n   580\t        if version is None:\r\n   581\t            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n   582\t            any_fail = True\r\n   583\t            break\r\n   584\t\r\n   585\t        state[s] = {\"version\": version, \"deployed_at\": now_iso()}\r\n   586\t        deployed_events.append((s, version))\r\n   587\t        print(f\"DEPLOY {s} -> {env} OK\")\r\n   588\t\r\n   589\t    save_deployment_state(env, state)\r\n   590\t    for s, version in deployed_events:\r\n   591\t        append_event(env, \"DEPLOY\", s, version)\r\n   592\t    if any_fail:\r\n   593\t        sys.exit(1)\r\n   594\t\r\n   595\tdef cmd_status(args):\r\n"]
