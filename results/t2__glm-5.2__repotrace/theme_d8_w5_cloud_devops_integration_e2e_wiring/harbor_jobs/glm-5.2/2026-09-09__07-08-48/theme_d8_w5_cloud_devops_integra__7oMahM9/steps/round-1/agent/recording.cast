[1131.618841, "o", "\u001b[?2004h> "]
[1131.618908, "o", "    data = load_manifest()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.618986, "o", "    services, _ = get_services(data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.619009, "o", "    for s in topo_order(services):\r\n\u001b[?2004l\r"]
[1131.619098, "o", "\u001b[?2004h>         print(s)\r\n\u001b[?2004l\rat\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.61912, "o", "def cmd_build(args):\r\n\u001b[?2004l\r"]
[1131.619133, "o", "\u001b[?2004h> "]
[1131.619305, "o", "    values, flags, positionals = parse_opts(args, {'--service'}, {'--parallel'})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.619366, "o", "    if positionals:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.619428, "o", "> "]
[1131.619493, "o", "        fail(\"build does not accept positional arguments\")\r\n\u001b[?2004l\r"]
[1131.619513, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt"]
[1131.619528, "o", "\u001b[?2004h> "]
[1131.619617, "o", "    service = values.get('--service')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.619689, "o", "    parallel = '--parallel' in flags\r\n\u001b[?2004l\r"]
[1131.619713, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r_\u001b[?2004h> "]
[1131.619873, "o", "    data = load_manifest()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.619898, "o", "    services, _ = get_services(data)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rq\u001b[?2004h> "]
[1131.619984, "o", "    if service:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.620065, "o", "        subset = transitive_deps(services, service)\r\n\u001b[?2004l\r"]
[1131.620087, "o", "\u001b[?2004h> "]
[1131.620157, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.686569, "o", "        subset = set(services.keys())\r\n\u001b[?2004l\r(e\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h>     if parallel:\r\n\u001b[?2004l\r\u001b[?2004h>         for wave in build_waves(services, subset):\r\n\u001b[?2004l\r\u001b[?2004h>             print(\",\".join(wave))\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r1\u001b[?2004h>     order = topo_order(services, subset)\r\n\u001b[?2004l\r\u001b[?2004h>     any_fail = False\r\n\u001b[?2004l\r\u001b[?2004h>     for s in order:\r\n\u001b[?2004l\r\u001b[?2004h>         svc = services[s]\r\n\u001b[?2004l\r\u001b[?2004h>         path = service_path(svc)\r\n\u001b[?2004l\r\u001b[?2004h>         if not os.path.isdir(path):\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"BUILD {s} FAIL: service path does not exist\")\r\n\u001b[?2004l\r\u001b[?2004h>             any_fail = True\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r \u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             os.makedirs(os.path.join(path, 'build'), exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h>             with open(os.path.join(path, 'build', 'artifact.txt'), 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>                 f.write(f\"{s}:{"]
[1131.686757, "o", "int(time.time())}:built\")\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"BUILD {s} OK\")\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"BUILD {s} FAIL: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h>             any_fail = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h>     if any_fail:\r\n\u001b[?2004l\r\u001b[?2004h>         sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rg\u001b[?2004h> def cmd_test(args):\r\n\u001b[?2004l\r\u001b[?2004h>     values, flags, positionals = parse_opts(args, {'--service'}, {'--fail-fast'})\r\n\u001b[?2004l\r\u001b[?2004h>     if positionals:\r\n\u001b[?2004l\r\u001b[?2004h>         fail(\"test does not accept positional arguments\")\r\n\u001b[?2004l\rt\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h>     service = values.get('--service')\r\n\u001b[?2004l\rs = \u001b[?2004h>     fail_fast = '--fail-fast' in flags\r\n\u001b[?2004l\r s\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h>     data = load_manifest()\r\n\u001b[?2004l\r\u001b[?2004h>     services, _ = get_services(data)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h>     if service:\r\n\u001b[?2004l\r\u001b[?2004h>         if service not in services:\r\n\u001b[?2004l\r\u001b[?20"]
