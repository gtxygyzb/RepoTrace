[9444.768611, "o", "        return None\r\n\r\ndef deployment_file(env):\r\n    return os.path.join(DEPLOYMENTS_DIR, f\"{env}.json\")\r\n\r\ndef load_deployment_state(env):\r\n    return load_json(deployment_file(env), {})\r\n\r\ndef save_deployment_state(env, state):\r\n"]
[9444.768734, "o", "    save_json(deployment_file(env), state)\r\n\r\ndef replica_file(env):\r\n    return os.path.join(REPLICAS_DIR, f\"{env}.json\")\r\n\r\ndef load_replicas(env):\r\n    return load_json(replica_file(env), {})\r\n\r\ndef save_replicas(env, replicas):\r\n    save_json(replica_file(env), replicas)\r\n\r\ndef bounds_file(env):\r\n    return os.path.join(BOUNDS_DIR, f\"{env}.json\")\r\n\r\ndef load_bounds(env):\r\n    return load_json(bounds_file(env), {})\r\n\r\ndef save_bounds(env, bounds):\r\n    save_json(bounds_file(env), bounds)\r\n\r\ndef get_replica_count(env, service):\r\n    replicas = load_replicas(env)\r\n    return replicas.get(service, 1)\r\n\r\ndef get_env_max(envs, env):\r\n    env_max = envs[env].get('max_replicas')\r\n"]
[9444.76883, "o", "    if env_max is None:\r\n        return None\r\n    try:\r\n        return int(env_max)\r\n    except (ValueError, TypeError):\r\n        return None\r\n\r\ndef parse_positive_int(s):\r\n    if not isinstance(s, str):\r\n        return None\r\n    if not re.fullmatch('[0-9]+', s):\r\n        return None\r\n    val = int(s)\r\n    if val < 1:\r\n        return None\r\n    return val\r\n\r\n\r\ndef event_file(env):\r\n"]
[9444.76892, "o", "    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n\r\ndef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n    ensure_state()\r\n    ts = now_iso()\r\n    line = f\"{ts} {action} {service} {version}\"\r\n    if action == \"PROMOTE\" and source_env is not None:\r\n        line += f\" from {source_env}\"\r\n        if forced:\r\n            line += \" (forced)\"\r\n    if action == \"RESTORE\" and snapshot_id is not None:\r\n        line += f\" from snapshot #{snapshot_id}\"\r\n    line += \"\\n\"\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(line)\r\n\r\ndef append_scale_event(env, service, count, previous):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n"]
[9444.768991, "o", "        \"action\": \"SCALE\",\r\n        \"service\": service,\r\n        \"version\": \"-\",\r\n        \"replicas\": count,\r\n        \"previous\": previous,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + chr(10))\r\n\r\ndef load_events(env):\r\n    ensure_state()\r\n    try:\r\n        with open(event_file(env)) as f:\r\n            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n"]
[9444.769058, "o", "    except FileNotFoundError:\r\n        return []\r\n"]
