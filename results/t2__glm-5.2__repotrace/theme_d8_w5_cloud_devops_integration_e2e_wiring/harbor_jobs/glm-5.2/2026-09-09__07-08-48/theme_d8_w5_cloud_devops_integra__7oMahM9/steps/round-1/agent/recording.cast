[8271.574147, "i", "<![CDATA[python3 - <<'PY'\nwith open('pipeline.sh', 'r') as f:\n    content = f.read()\n\nif 'def cmd_scale' in content:\n    print('already patched')\n    raise SystemExit(0)\n\nreplacements = [\n    (\n        \"CONFIG_DIR = os.path.join(STATE_DIR, 'config')\",\n        \"CONFIG_DIR = os.path.join(STATE_DIR, 'config')\\nREPLICAS_DIR = os.path.join(STATE_DIR, 'replicas')\\nBOUNDS_DIR = os.path.join(STATE_DIR, 'bounds')\"\n    ),\n    (\n        \"    os.makedirs(CONFIG_DIR, exist_ok=True)\",\n        \"    os.makedirs(CONFIG_DIR, exist_ok=True)\\n    os.makedirs(REPLICAS_DIR, exist_ok=True)\\n    os.makedirs(BOUNDS_DIR, exist_ok=True)\"\n    ),\n    (\n        r'''def save_deployment_state(env, state):\n    save_json(deployment_file(env), state)\n''',\n        r'''def save_deployment_state(env, state):\n    save_json(deployment_file(env), state)\n\ndef replica_file(env):\n    return os.path.join(REPLICAS_DIR, f\"{env}.json\")\n\ndef load_replicas(env):\n    return load_json(replica_file(env), {})\n\ndef save_replicas(env, replicas):\n    save_json(repl"]
