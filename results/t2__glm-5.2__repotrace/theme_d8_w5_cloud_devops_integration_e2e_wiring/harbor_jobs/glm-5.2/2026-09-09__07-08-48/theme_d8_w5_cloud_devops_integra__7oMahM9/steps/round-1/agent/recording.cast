[8521.310814, "o", "\u001b[?2004h> "]
[8521.310906, "o", "            ensure_state()\r\n\u001b[?2004l\r"]
[8521.310961, "o", "\u001b[?2004h> "]
[8521.311137, "o", "            state = load_deployment_state(env)\r\n\u001b[?2004l\r"]
[8521.311192, "o", "\u001b[?2004h> "]
[8521.311329, "o", "            if service not in state:\r\n\u001b[?2004l\ry\u001b[?2004h"]
[8521.311386, "o", "> "]
[8521.311568, "o", "                fail(f\"{service} is not deployed to {env}\")\r\n\u001b[?2004l\r"]
[8521.311623, "o", "\u001b[?2004h> "]
[8521.311718, "o", "            bounds = load_bounds(env)\r\n\u001b[?2004l\r"]
[8521.311774, "o", "\u001b[?2004h> "]
[8521.311885, "o", "            svc_bounds = bounds.get(service)\r\n\u001b[?2004l\r"]
[8521.31194, "o", "\u001b[?2004h> "]
[8521.312001, "o", "            if svc_bounds:\r\n\u001b[?2004l\r"]
[8521.312057, "o", "\u001b[?2004h> "]
[8521.312158, "o", "                bmin, bmax = svc_bounds\r\n\u001b[?2004l\r"]
[8521.312213, "o", "\u001b[?2004h> "]
[8521.312378, "o", "                print(f\"{service}: bounds [{bmin}..{bmax}]\")\r\n\u001b[?2004l\r"]
[8521.312434, "o", "\u001b[?2004h> "]
[8521.312491, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.312652, "o", "                print(f\"{service}: no bounds set\")\r\n\u001b[?2004l\r"]
[8521.312708, "o", "\u001b[?2004h> "]
[8521.312765, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.31287, "o", "        elif len(rest) == 4:\r\n\u001b[?2004l\r"]
[8521.312937, "o", "\u001b[?2004h> "]
