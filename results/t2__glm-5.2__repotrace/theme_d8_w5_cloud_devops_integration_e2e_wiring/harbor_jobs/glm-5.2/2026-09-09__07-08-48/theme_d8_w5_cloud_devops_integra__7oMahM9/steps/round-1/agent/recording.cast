[4900.437002, "o", "   506\tdef cmd_rollback(args):\r\n   507\t    values, flags, positionals = parse_opts(args, {\"--to-version\"}, set())\r\n   508\t    if len(positionals) != 2:\r\n   509\t        fail(\"rollback requires <environment> <service_name>\")\r\n"]
[4900.437135, "o", "   510\t\r\n   511\t    env, service = positionals\r\n   512\t    data = load_manifest()\r\n   513\t    _, envs = get_services(data)\r\n   514\t    if env not in envs:\r\n   515\t        fail(f\"environment not found: {env}\")\r\n   516\t    ensure_state()\r\n   517\t    state = load_deployment_state(env)\r\n   518\t"]
[4900.437218, "o", "\r\n   519\t    if service not in state:\r\n   520\t        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n   521\t        sys.exit(1)\r\n   522\t\r\n   523\t    current_version = state[service].get(\"version\")\r\n   524\t    if not current_version:\r\n   525\t        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n   526\t        sys.exit(1)\r\n   527\t\r\n   528\t    to_version = values.get(\"--to-version\")\r\n   529\t    target_version = find_rollback_target(env, service, current_version, to_version)\r\n   530\t\r\n   531\t    if target_version is None:\r\n   532\t        del state[service]\r\n   533\t        save_deployment_state(env, state)\r\n   534\t        append_event(env, \"ROLLBACK\", service, \"-\")\r\n   535\t        print(f\"ROLLBACK {service} from {env}: {current_version} -> (removed)\")\r\n   536\t    else:\r\n   537\t        state[service] = {\"version\": target_version, \"deployed_at\": now_iso()}\r\n"]
[4900.437315, "o", "   538\t        save_deployment_state(env, state)\r\n   539\t        append_event(env, \"ROLLBACK\", service, target_version)\r\n   540\t        print(f\"ROLLBACK {service} from {env}: {current_version} -> {target_version}\")\r\n   541\t\r\n   542\tdef valid_version(v):\r\n   543\t    if not isinstance(v, str):\r\n   544\t        return False\r\n   545\t    parts = v.split('.')\r\n   546\t    if len(parts) != 3:\r\n   547\t        return False"]
[4900.437392, "o", "\r\n   548\t    for part in parts:\r\n   549\t        if not part.isdigit() or (part != '0' and part.startswith('0')):\r\n   550\t            return False\r\n   551\t    return True\r\n   552\t\r\n   553\tdef parse_semver(v):\r\n   554\t    if not valid_version(v):\r\n   555\t        return None\r\n   556\t    return tuple(int(x) for x in v.split('.'))\r\n   557\t\r\n   558\tdef extract_semver(version):\r\n   559\t    if not isinstance(version, str):\r\n   560\t        return None\r\n   561\t    semver = version.split(':', 1)[1] if ':' in version else version\r\n   562\t    if '+build.' in semver:\r\n   563\t        semver = semver.split('+build.', 1)[0]\r\n   564"]
[4900.437451, "o", "\t    return parse_semver(semver)\r\n   565\t\r\n   566\tdef semver_string(version):\r\n   567\t    sv = extract_semver(version)\r\n   568\t    if sv is None:\r\n   569\t        return None\r\n   570\t    return f\"{sv[0]}.{sv[1]}.{sv[2]}\"\r\n"]
[4900.437517, "o", "   571\t\r\n   572\tdef version_build_timestamp(version):\r\n   573\t    if not isinstance(version, str) or '+build.' not in version:\r\n   574\t        return None\r\n   575\t    after = version.split('+build.', 1)[1]\r\n"]
[4900.43758, "o", "   576\t    try:\r\n   577\t        return int(after)\r\n   578\t    except ValueError:\r\n   579\t        return None\r\n   580\t\r\n   581\tdef compare_versions(a, b):\r\n   582\t    sa = extract_semver(a)\r\n   583\t    sb = extract_semver(b)\r\n   584\t    if sa is not None and sb is not None:\r\n   585\t        if sa != sb:\r\n   586\t            return 1 if sa > sb else -1\r\n   587\t        ta = version_build_timestamp(a)\r\n   588\t        tb = version_build_timestamp(b)\r\n"]
[4900.437649, "o", "   589\t        if ta is not None and tb is not None and ta != tb:\r\n   590\t            return 1 if ta > tb else -1\r\n   591\t        return 0\r\n   592\t    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)\r\n"]
