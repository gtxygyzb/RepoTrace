[4934.372793, "o", "   506\tdef cmd_rollback(args):\r\n   507\t    values, flags, positionals = parse_opts(args, {\"--to-version\"}, set())\r\n   508\t    if len(positionals) != 2:\r\n   509\t        fail(\"rollback requires <environment> <service_name>\")\r\n   510\t\r\n   511\t    env, service = positionals\r\n   512\t    data = load_manifest()\r\n   513\t    _, envs = get_services(data)\r\n   514\t    if env not in envs:\r\n   515\t        fail(f\"environment not found: {env}\")\r\n   516\t    ensure_state()\r\n   517\t    state = load_deployment_state(env)\r\n   518\t"]
[4934.372973, "o", "\r\n   519\t    if service not in state:\r\n   520\t        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n   521\t        sys.exit(1)\r\n   522\t\r\n   523\t    current_version = state[service].get(\"version\")\r\n   524\t    if not current_version:\r\n   525\t        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n   526\t        sys.exit(1)\r\n   527\t\r\n   528\t    to_version = values.get(\"--to-version\")\r\n   529\t    target_version = find_rollback_target(env, service, current_version, to_version)\r\n   530\t\r\n   531\t    if target_version is None:\r\n   532\t        del state[service]\r\n   533\t        save_deployment_state(env, state)\r\n   534\t        append_event(env, \"ROLLBACK\", service, \"-\")\r\n   535\t        print(f\"ROLLBACK {service} from {env}: {current_version} -> (removed)\")\r\n   536\t    else:\r\n   537\t        state[service] = {\"version\": target_version, \"deployed_at\": now_iso()}\r\n   538\t        save_deployment_state(env, state)\r\n   539\t        append_event(env, \"ROLLBACK\", service, target_version)\r\n"]
[4934.373119, "o", "   540\t        print(f\"ROLLBACK {service} from {env}: {current_version} -> {target_version}\")\r\n   541\t\r\n   542\tdef valid_version(v):\r\n   543\t    if not isinstance(v, str):\r\n   544\t        return False\r\n   545\t    parts = v.split('.')\r\n   546\t    if len(parts) != 3:\r\n   547\t        return False\r\n   548\t    for part in parts:\r\n   549\t        if not part.isdigit() or (part != '0' and part.startswith('0')):\r\n   550\t            return False\r\n   551\t    return True\r\n   552\t\r\n   553\tdef parse_semver(v):\r\n"]
