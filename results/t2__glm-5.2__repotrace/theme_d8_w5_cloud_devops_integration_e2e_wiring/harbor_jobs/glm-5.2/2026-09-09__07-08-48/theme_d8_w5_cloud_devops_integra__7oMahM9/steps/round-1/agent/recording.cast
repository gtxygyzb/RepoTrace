[3878.985605, "o", "\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[K\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Kment_file(env):\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Kment_state(env):\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    return load_json(\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Kment_file(env), {})\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksave_\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Kment_state(env, state):\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    save_json(\u001b[01;31m\u001b[Kdeploy\u001b[m\u001b[Kment_file(env), state)\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kevent_file(env):\r\n"]
