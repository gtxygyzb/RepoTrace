[7469.732839, "o", "  1142\t            print(f\"- {key}={cfg2[key]} (only in {env2})\")\r\n  1143\t        elif cfg1[key] != cfg2[key]:\r\n  1144\t            print(f\"~ {key}: {cfg1[key]} -> {cfg2[key]}\")\r\n  1145\t\r\n  1146\tdef cmd_config_delete(args):\r\n  1147\t    if len(args) != 2:\r\n  1148\t        fail(\"config delete requires <environment> <KEY>\")\r\n  1149\t    env, key = args\r\n  1150\t    validate_config_key(key)\r\n  1151\t    assert_env_exists(env)\r\n  1152\t    assert_not_locked(env)\r\n  1153\t    cfg = load_config(env)\r\n  1154\t    if key not in cfg:\r\n  1155\t        fail(f\"key '{key}' not found in {env}\")\r\n  1156\t    del cfg[key]\r\n  1157\t    save_config(env, cfg)\r\n  1158\t"]
