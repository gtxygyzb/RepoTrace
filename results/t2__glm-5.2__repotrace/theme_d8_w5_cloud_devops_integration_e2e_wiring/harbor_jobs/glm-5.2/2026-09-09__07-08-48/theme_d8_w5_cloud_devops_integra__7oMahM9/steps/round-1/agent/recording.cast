[3113.118395, "o", "    26\tdef fail(msg, code=1):\r\n    27\t    print(f\"ERROR: {msg}\")\r\n    28\t    sys.exit(code)\r\n    29\t\r\n    30\tdef now_iso():\r\n    31\t    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n    32\t\r\n    33\tdef load_json(path, default):\r\n    34\t    try:\r\n    35\t        with open(path) as f:\r\n    36\t            return json.load(f)\r\n    37\t    except FileNotFoundError:\r\n    38\t        return default\r\n    39\t    except json.JSONDecodeError as e:\r\n    40\t        fail(f\"state error in {path}: {e}\")\r\n    41\t\r\n    42\tdef save_json(path, data):\r\n    43\t    os.makedirs(os.path.dirname(path), exist_ok=True)\r\n    44\t    with open(path, 'w') as f:\r\n"]
