[9413.260642, "o", "    for s, version, forced in promote_events:\r\n        append_event(target, \"PROMOTE\", s, version, source, forced=forced)\r\n    print(f\"Promoted {promoted}, skipped {skipped}, conflicts {conflicts}\")\r\ndef cmd_diff(args):\r\n    if len(args) != 2:\r\n        fail(\"diff requires <env1> <env2>\")\r\n\r\n    env1, env2 = args\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n\r\n    if env1 not in envs:\r\n        fail(f\"environment not found: {env1}\")\r\n    if env2 not in envs:\r\n        fail(f\"environment not found: {env2}\")\r\n\r\n    ensure_state()\r\n    state1 = load_deployment_state(env1)\r\n    state2 = load_deployment_state(env2)\r\n\r\n"]
