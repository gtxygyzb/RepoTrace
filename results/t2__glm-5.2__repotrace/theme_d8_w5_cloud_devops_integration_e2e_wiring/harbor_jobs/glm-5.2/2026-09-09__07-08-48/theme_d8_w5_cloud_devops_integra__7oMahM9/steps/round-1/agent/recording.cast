[4269.245476, "o", "\u001b[?2004h> "]
[4269.245599, "o", "        events.append({\r\n\u001b[?2004l\r"]
[4269.245679, "o", "\u001b[?2004h> "]
[4269.245924, "o", "            \"timestamp\": parts[0],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4269.246094, "o", "            \"action\": parts[1],\r\n\u001b[?2004l\r"]
[4269.246135, "o", "\u001b[?2004h> "]
[4269.246315, "o", "            \"service\": parts[2],\r\n\u001b[?2004l\r"]
[4269.246375, "o", "\u001b[?2004h> "]
[4269.246517, "o", "            \"version\": parts[3],\r\n\u001b[?2004l\r"]
[4269.246573, "o", "\u001b[?2004h> "]
[4269.246683, "o", "            \"line\": line,\r\n\u001b[?2004l\r"]
[4269.246738, "o", "\u001b[?2004h> "]
[4269.246794, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h"]
[4269.246834, "o", "> "]
[4269.246915, "o", "    return events\r\n\u001b[?2004l\r"]
[4269.246977, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4269.247378, "o", "def find_rollback_target(env, service, current_version, to_version=None):\r\n\u001b[?2004l\r"]
[4269.247438, "o", "\u001b[?2004h> "]
[4269.247565, "o", "    events = load_events(env)\r\n\u001b[?2004l\r"]
[4269.247622, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[4269.247677, "o", "> "]
[4269.247814, "o", "    if to_version is not None:\r\n\u001b[?2004l\r"]
[4269.24787, "o", "\u001b[?2004h> "]
[4269.248038, "o", "        for ev in reversed(events):\r\n\u001b[?2004l\r"]
[4269.248093, "o", "\u001b[?2004h> "]
[4269.248596, "o", "            if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] == to_version:\r\n\u001b[?2004l\r"]
[4269.248672, "o", "\u001b[?2004h> "]
[4269.248807, "o", "                return to_version\r\n\u001b[?2004l\r"]
[4269.248864, "o", "\u001b[?2004h> "]
[4269.249139, "o", "        fail(f\"version not found in history for {service}\")\r\n\u001b[?2004l\r"]
[4269.249195, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rf\u001b[?2004h"]
[4269.249251, "o", "> "]
[4269.249445, "o", "    current_indices = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4269.249634, "o", "        idx for idx, ev in enumerate(events)\r\n\u001b[?2004l\r"]
[4269.249698, "o", "\u001b[?2004h> "]
[4269.249843, "o", "        if ev[\"service\"] == service\r\n\u001b[?2004l\r"]
[4269.249935, "o", "\u001b[?2004h> "]
[4269.250103, "o", "        and ev[\"version\"] == current_version\r\n\u001b[?2004l\r"]
[4269.250163, "o", "\u001b[?2004h> "]
[4269.250517, "o", "        and not (ev[\"action\"] == \"ROLLBACK\" and ev[\"version\"] == \"-\")\r\n\u001b[?2004l\r"]
[4269.250591, "o", "\u001b[?2004h>     ]\r\n\u001b[?2004l\r"]
[4269.250647, "o", "\u001b[?2004h> "]
[4269.250757, "o", "    if not current_indices:\r\n\u001b[?2004l\r"]
[4269.250813, "o", "\u001b[?2004h> "]
[4269.250899, "o", "        return None\r\n\u001b[?2004l\r"]
[4269.286548, "o", "\u001b[?2004h>     current_idx = current_indices[-1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for ev in reversed(events[:current_idx]):\r\n\u001b[?2004l\r\u001b[?2004h>         if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\":\r\n\u001b[?2004l\r\u001b[?2004h>             return ev[\"version\"]\r\n\u001b[?2004l\r\u001b[?2004h>     return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # rollback\r\n\u001b[?2004l\r\u001b[?2004h> replace_func(\r\n\u001b[?2004l\r\u001b[?2004h>     \"def cmd_rollback(args):\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"def valid_version(v):\",\r\n\u001b[?2004l\r\u001b[?2004h> '''def cmd_rollback(args):\r\n\u001b[?2004l\r\u001b[?2004h>     values, flags, positionals = parse_opts(args, {\"--to-version\"}, set())\r\n\u001b[?2004l\r\u001b[?2004h>     if len(positionals) != 2:\r\n\u001b[?2004l\r\u001b[?2004h>         fail(\"rollback requires <environment> <service_name>\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h>     env, service = positionals\r\n\u001b[?2004l\r\u001b[?2004h>     data = load_manifest()\r\n\u001b[?2004l\r\u001b[?2004h>     _, envs = get_services(data)\r\n\u001b[?2004l\r"]
[4269.286757, "o", "\r\n\u001b[?2004h>     if env not in envs:\r\n\u001b[?2004l\ri\u001b[?2004h>         fail(f\"environment not found: {env}\")\r\n\u001b[?2004l\r\u001b[?2004h>     ensure_state()\r\n\u001b[?2004l\r\u001b[?2004h>     state = load_deployment_state(env)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if service not in state:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4269.28683, "o", "        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n\u001b[?2004l\r"]
[4269.286895, "o", "\u001b[?2004h"]
[4269.28696, "o", "> "]
[4269.287031, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[4269.2871, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.287155, "o", "\u001b[?2004h> "]
[4269.287462, "o", "    current_version = state[service].get(\"version\")\r\n\u001b[?2004l\r"]
[4269.287531, "o", "\u001b[?2004h> "]
[4269.287678, "o", "    if not current_version:\r\n\u001b[?2004l\r"]
[4269.287739, "o", "\u001b[?2004h> "]
[4269.288111, "o", "        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n\u001b[?2004l\r"]
[4269.28817, "o", "\u001b[?2004h> "]
[4269.288279, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[4269.288354, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.288414, "o", "\u001b[?2004h"]
[4269.288472, "o", "> "]
[4269.288657, "o", "    to_version = values.get(\"--to-version\")\r\n\u001b[?2004l\r"]
[4269.288722, "o", "\u001b[?2004h> "]
[4269.28919, "o", "    target_version = find_rollback_target(env, service, current_version, to_version)\r\n\u001b[?2004l\r"]
[4269.289247, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.289324, "o", "\u001b[?2004h> "]
[4269.289491, "o", "    if target_version is None:\r\n\u001b[?2004l\r"]
[4269.289555, "o", "\u001b[?2004h> "]
[4269.289703, "o", "        del state[service]\r\n\u001b[?2004l\r"]
[4269.289767, "o", "\u001b[?2004h> "]
[4269.29, "o", "        save_deployment_state(env, state)\r\n\u001b[?2004l\r"]
[4269.290056, "o", "\u001b[?2004h> "]
[4269.290393, "o", "        append_event(env, \"ROLLBACK\", service, \"-\")\r\n\u001b[?2004l\r"]
[4269.29046, "o", "\u001b[?2004h> "]
[4269.290892, "o", "        print(f\"ROLLBACK {service} from {env}: {current_version} -> (removed)\")\r\n\u001b[?2004l\r"]
[4269.290947, "o", "\u001b[?2004h> "]
[4269.29101, "o", "    else:\r\n\u001b[?2004l\r"]
[4269.291068, "o", "\u001b[?2004h> "]
[4269.291521, "o", "        state[service] = {\"version\": target_version, \"deployed_at\": now_iso()}\r\n\u001b[?2004l\r"]
[4269.29158, "o", "\u001b[?2004h> "]
[4269.291809, "o", "        save_deployment_state(env, state)\r\n\u001b[?2004l\r"]
[4269.291866, "o", "\u001b[?2004h> "]
[4269.292218, "o", "        append_event(env, \"ROLLBACK\", service, target_version)\r\n\u001b[?2004l\r"]
[4269.292276, "o", "\u001b[?2004h> "]
[4269.292763, "o", "        print(f\"ROLLBACK {service} from {env}: {current_version} -> {target_version}\")\r\n\u001b[?2004l\r"]
[4269.292831, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.292887, "o", "\u001b[?2004h> "]
[4269.292946, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h"]
[4269.293002, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h"]
[4269.293057, "o", "> \r\n\u001b[?2004l\r"]
[4269.293111, "o", "\u001b[?2004h> "]
[4269.29327, "o", "# snapshot/restore before main\r\n\u001b[?2004l\r"]
[4269.293342, "o", "\u001b[?2004h> "]
[4269.293418, "o", "replace_once(\r\n\u001b[?2004l\r"]
[4269.293466, "o", "\u001b[?2004h> "]
[4269.293855, "o", "    '    print(f\"BUMP {service} {old} -> {new}\")\\n\\ndef main():\\n',\r\n\u001b[?2004l\r"]
[4269.293919, "o", "\u001b[?2004h> "]
[4269.294178, "o", "'''    print(f\"BUMP {service} {old} -> {new}\")\r\n\u001b[?2004l\r"]
[4269.294259, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4269.294297, "o", "> "]
[4269.294439, "o", "def snapshot_file(env):\r\n\u001b[?2004l\r"]
[4269.294496, "o", "\u001b[?2004h> "]
[4269.294796, "o", "    return os.path.join(SNAPSHOTS_DIR, f\"{env}.json\")\r\n\u001b[?2004l\r"]
[4269.294859, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.294921, "o", "\u001b[?2004h> "]
[4269.295058, "o", "def load_snapshots(env):\r\n\u001b[?2004l\r"]
[4269.29512, "o", "\u001b[?2004h> "]
[4269.295378, "o", "    return load_json(snapshot_file(env), [])\r\n\u001b[?2004l\r"]
[4269.29544, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.295496, "o", "\u001b[?2004h> "]
[4269.295711, "o", "def save_snapshots(env, snapshots):\r\n\u001b[?2004l\r"]
[4269.295767, "o", "\u001b[?2004h> "]
[4269.296008, "o", "    save_json(snapshot_file(env), snapshots)\r\n\u001b[?2004l\r"]
[4269.296072, "o", "\u001b[?2004h> \r\n"]
[4269.296128, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4269.296261, "o", "def cmd_snapshot(args):\r\n\u001b[?2004l\r"]
[4269.296338, "o", "\u001b[?2004h> "]
[4269.296662, "o", "    values, flags, positionals = parse_opts(args, set(), {\"--list\"})\r\n\u001b[?2004l\r"]
[4269.296721, "o", "\u001b[?2004h> "]
[4269.296873, "o", "    if len(positionals) != 1:\r\n\u001b[?2004l\r"]
[4269.296929, "o", "\u001b[?2004h> "]
[4269.297168, "o", "        fail(\"snapshot requires an environment\")\r\n\u001b[?2004l\r"]
[4269.297224, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.297279, "o", "\u001b[?2004h> "]
[4269.2974, "o", "    env = positionals[0]\r\n\u001b[?2004l\r"]
[4269.297457, "o", "\u001b[?2004h> "]
[4269.297587, "o", "    data = load_manifest()\r\n\u001b[?2004l\r"]
[4269.297647, "o", "\u001b[?2004h> "]
[4269.297802, "o", "    _, envs = get_services(data)\r\n\u001b[?2004l\r"]
[4269.297856, "o", "\u001b[?2004h> "]
[4269.297974, "o", "    if env not in envs:\r\n\u001b[?2004l\r"]
[4269.298034, "o", "\u001b[?2004h> "]
[4269.298251, "o", "        fail(f\"environment not found: {env}\")\r\n\u001b[?2004l\r"]
[4269.298325, "o", "\u001b[?2004h> "]
[4269.298405, "o", "    ensure_state()\r\n\u001b[?2004l\r"]
[4269.29846, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.298527, "o", "\u001b[?2004h> "]
[4269.298639, "o", "    if \"--list\" in flags:\r\n\u001b[?2004l\r"]
[4269.298705, "o", "\u001b[?2004h> "]
[4269.298887, "o", "        snapshots = load_snapshots(env)\r\n\u001b[?2004l\r"]
[4269.298944, "o", "\u001b[?2004h> "]
[4269.299095, "o", "        for snap in snapshots:\r\n\u001b[?2004l\r"]
[4269.299154, "o", "\u001b[?2004h> "]
[4269.299392, "o", "            services = snap.get(\"services\", {})\r\n\u001b[?2004l\r"]
[4269.29945, "o", "\u001b[?2004h> "]
[4269.299938, "o", "            print(f\"#{snap.get('id', '?')} {snap.get('timestamp', '')} ({len(services)} services)\")\r\n\u001b[?2004l\r"]
[4269.299993, "o", "\u001b[?2004h> "]
[4269.300069, "o", "        return\r\n\u001b[?2004l\r"]
[4269.300123, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.300162, "o", "\u001b[?2004h> "]
[4269.300402, "o", "    state = load_deployment_state(env)\r\n\u001b[?2004l\r"]
[4269.300465, "o", "\u001b[?2004h> "]
[4269.300635, "o", "    snapshots = load_snapshots(env)\r\n\u001b[?2004l\r"]
[4269.300695, "o", "\u001b[?2004h> "]
[4269.300766, "o", "    next_id = 1\r\n\u001b[?2004l\r"]
[4269.300825, "o", "\u001b[?2004h> "]
[4269.300951, "o", "    for snap in snapshots:\r\n\u001b[?2004l\r"]
[4269.301015, "o", "\u001b[?2004h> "]
[4269.301358, "o", "        if isinstance(snap.get(\"id\"), int) and snap[\"id\"] >= next_id:\r\n\u001b[?2004l\r"]
[4269.301421, "o", "\u001b[?2004h> "]
[4269.301597, "o", "            next_id = snap[\"id\"] + 1\r\n\u001b[?2004l\r"]
[4269.301653, "o", "\u001b[?2004h> "]
[4269.301781, "o", "    timestamp = now_iso()\r\n\u001b[?2004l\r"]
[4269.301836, "o", "\u001b[?2004h> "]
[4269.302193, "o", "    snapshot = {\"id\": next_id, \"timestamp\": timestamp, \"services\": state}\r\n\u001b[?2004l\r"]
[4269.302248, "o", "\u001b[?2004h> "]
[4269.302409, "o", "    snapshots.append(snapshot)\r\n\u001b[?2004l\r"]
[4269.302465, "o", "\u001b[?2004h> "]
[4269.302632, "o", "    save_snapshots(env, snapshots)\r\n\u001b[?2004l\r"]
[4269.302687, "o", "\u001b[?2004h> "]
[4269.303001, "o", "    print(f\"SNAPSHOT {env} #{next_id} ({len(state)} services)\")\r\n\u001b[?2004l\r"]
[4269.303055, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.30311, "o", "\u001b[?2004h> "]
[4269.30322, "o", "def cmd_restore(args):\r\n\u001b[?2004l\r"]
[4269.303275, "o", "\u001b[?2004h> "]
[4269.303593, "o", "    values, flags, positionals = parse_opts(args, set(), set())\r\n\u001b[?2004l\r"]
[4269.303651, "o", "\u001b[?2004h> "]
[4269.303793, "o", "    if len(positionals) != 2:\r\n\u001b[?2004l\r"]
[4269.303848, "o", "\u001b[?2004h> "]
[4269.304153, "o", "        fail(\"restore requires <environment> <snapshot_id>\")\r\n\u001b[?2004l\r"]
[4269.304216, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.304282, "o", "\u001b[?2004h> "]
[4269.304449, "o", "    env, snapshot_id_str = positionals\r\n\u001b[?2004l\r"]
[4269.304507, "o", "\u001b[?2004h> "]
[4269.304637, "o", "    data = load_manifest()\r\n\u001b[?2004l\r"]
[4269.304694, "o", "\u001b[?2004h> "]
[4269.304852, "o", "    _, envs = get_services(data)\r\n\u001b[?2004l\r"]
[4269.304908, "o", "\u001b[?2004h> "]
[4269.305022, "o", "    if env not in envs:\r\n\u001b[?2004l\r"]
[4269.305077, "o", "\u001b[?2004h> "]
[4269.305307, "o", "        fail(f\"environment not found: {env}\")\r\n\u001b[?2004l\r"]
[4269.305365, "o", "\u001b[?2004h> "]
[4269.305455, "o", "    ensure_state()\r\n\u001b[?2004l\r"]
[4269.305511, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.305579, "o", "\u001b[?2004h> "]
[4269.305633, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[4269.305688, "o", "> "]
[4269.305873, "o", "        snapshot_id = int(snapshot_id_str)\r\n\u001b[?2004l\r"]
[4269.305929, "o", "\u001b[?2004h> "]
[4269.30604, "o", "    except ValueError:\r\n\u001b[?2004l\r"]
[4269.306094, "o", "\u001b[?2004h> "]
[4269.306327, "o", "        fail(\"snapshot id must be an integer\")\r\n\u001b[?2004l\r"]
[4269.306383, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4269.306438, "o", "\u001b[?2004h> "]
[4269.306615, "o", "    snapshots = load_snapshots(env)\r\n\u001b[?2004l\r"]
[4269.30667, "o", "\u001b[?2004h> "]
[4269.306766, "o", "    snapshot = None\r\n\u001b[?2004l\r"]
[4269.306821, "o", "\u001b[?2004h> "]
[4269.306897, "o", "    for snap in snapshots:\r\n\u001b[?2004l\r"]
[4269.306952, "o", "\u001b[?2004h> "]
[4269.30708, "o", "        if snap.get(\"id\") == snapshot_id:\r\n\u001b[?2004l\r"]
[4269.307136, "o", "\u001b[?2004h> "]
[4269.307213, "o", "            snapshot = snap\r\n\u001b[?2004l\r"]
[4269.307267, "o", "\u001b[?2004h> "]
[4269.307339, "o", "            break\r\n\u001b[?2004l\r"]
[4269.307395, "o", "\u001b[?2004h> "]
[4269.307475, "o", "    if snapshot is None:\r\n\u001b[?2004l\r"]
[4269.30753, "o", "\u001b[?2004h> "]
[4269.307691, "o", "        fail(f\"snapshot not found: #{snapshot_id}\")\r\n\u001b[?2004l\r"]
[4269.307747, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4269.307806, "o", "> "]
[4269.307916, "o", "    recorded = snapshot.get(\"services\", {})\r\n\u001b[?2004l\r"]
