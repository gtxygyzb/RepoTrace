[4939.833927, "o", "   718\t    service = values.get(\"--service\")\r\n   719\t    limit = 10\r\n   720\t    if \"--limit\" in values:\r\n   721\t        try:\r\n   722\t            limit = int(values[\"--limit\"])\r\n   723\t        except ValueError:\r\n   724\t            fail(\"--limit requires an integer\")\r\n   725\t        if limit < 0:\r\n   726\t            fail(\"--limit must be non-negative\")\r\n   727\t\r\n   728\t    data = load_manifest()\r\n   729\t    _, envs = get_services(data)\r\n   730\t    if env not in envs:\r\n   731\t        fail(f\"environment not found: {env}\")\r\n   732\t\r\n   733\t    ensure_state()\r\n   734\t    try:\r\n   735\t        with open(event_file(env)) as f:\r\n   736\t            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n   737\t    except FileNotFoundError:\r\n"]
