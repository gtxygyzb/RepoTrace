[1131.707483, "o", "def print_tree(node, services, path, depth):\r\n\u001b[?2004l\r"]
[1131.707539, "o", "\u001b[?2004h> "]
[1131.70765, "o", "    print(\"  \" * depth + node)\r\n\u001b[?2004l\r"]
[1131.707703, "o", "\u001b[?2004h"]
[1131.707757, "o", "> "]
[1131.707811, "o", "    if node in path:\r\n\u001b[?2004l\r"]
[1131.707837, "o", "\u001b[?2004h> "]
[1131.707906, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.707958, "o", "> "]
[1131.708028, "o", "    path = path | {node}\r\n\u001b[?2004l\r"]
[1131.708084, "o", "\u001b[?2004h> "]
[1131.708452, "o", "    children = sorted([s for s in services if node in services[s].get('depends_on', [])])\r\n\u001b[?2004l\r"]
[1131.708516, "o", "\u001b[?2004h> "]
[1131.708594, "o", "    for child in children:\r\n\u001b[?2004l\r"]
[1131.70865, "o", "\u001b[?2004h> "]
[1131.708865, "o", "        print_tree(child, services, path, depth + 1)\r\n\u001b[?2004l\r"]
