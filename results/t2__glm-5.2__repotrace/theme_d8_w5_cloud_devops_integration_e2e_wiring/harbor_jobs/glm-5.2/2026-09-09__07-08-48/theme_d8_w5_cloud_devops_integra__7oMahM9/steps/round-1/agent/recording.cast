[13463.882404, "o", "   186\t\r\n   187\tdef build_waves(services, subset):\r\n   188\t    subset = set(subset)\r\n   189\t\r\n   190\t    in_degree = {s: 0 for s in subset}\r\n   191\t    adj = {s: [] for s in subset}\r\n   192\t\r\n   193\t    for s in subset:\r\n   194\t        for dep in services[s].get('depends_on', []):\r\n   195\t            if dep in subset:\r\n   196\t                adj[dep].append(s)\r\n   197\t                in_degree[s] += 1\r\n   198\t\r\n   199\t    waves = []\r\n   200\t    available = sorted([s for s in subset if in_degree[s] == 0])\r\n   201\t    while available:\r\n   202\t        waves.append(available)\r\n   203\t        next_available = []\r\n   204\t        for s in available:\r\n   205\t            for dependent in sorted(adj[s]):\r\n   206\t                in_degree[dependent] -= 1\r\n   207\t                if in_degree[dependent] == 0:\r\n   208\t                    next_available.append(dependent)\r\n   209\t        available = sorted(next_available)\r\n"]
