[3484.419872, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('/app/pipeline.sh')\nlines = p.read_text().splitlines()\n\ndef find_func(name):\n    start = None\n    for i, l in enumerate(lines):\n        if l.startswith(f'def {name}('):\n            start = i\n            break\n    if start is None:\n        raise SystemExit(f'function not found: {name}')\n    end = len(lines)\n    for j in range(start + 1, len(lines)):\n        if lines[j].startswith('def '):\n            end = j\n            break\n    return start, end\n\ndef replace_func(name, new_text):\n    global lines\n    start, end = find_func(name)\n    new_lines = new_text.rstrip('\\n').splitlines()\n    lines = lines[:start] + new_lines + lines[end:]\n\ndef replace_line(i, new_text):\n    global lines\n    lines[i] = new_text\n\ndef replace_first(old, new):\n    global lines\n    text = '\\n'.join(lines)\n    if old not in text:\n        raise SystemExit(f'not found: {old[:80]}')\n    text = text.replace(old, new, 1)\n    lines = text.splitlines()\n\n# Add version to SERVICE_FIELDS\nreplace_fi"]
