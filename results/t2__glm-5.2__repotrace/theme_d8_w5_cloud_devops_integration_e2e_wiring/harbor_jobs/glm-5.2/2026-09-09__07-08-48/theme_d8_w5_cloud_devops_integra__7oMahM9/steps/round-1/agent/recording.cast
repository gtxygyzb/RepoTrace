[11818.502935, "i", "python3 - <<'PY'\nfrom pathlib import Path\ns = Path('pipeline.sh').read_text()\nfor marker in ['assert_not_locked(env)\\n\\n    if service:', 'if cfg:\\n            print(f\"Config: {len(cfg)} variables\")', 'elif action == \"HEALTH\":', 'if get_health_state(env, service) == \"unhealthy\" and count > replicas.get(service, 1):', 'for s in sorted(state):\\n            if get_health_state(env, s) == \"unhealthy\" and count > replicas.get(s, 1):', \"elif cmd == 'config':\\n        cmd_config(args)\\n    elif cmd == 'scale':\"]:\n    idx = s.find(marker)\n    print('MARKER:', repr(marker), 'AT', idx)\n    if idx != -1:\n        print(repr(s[idx:idx+400]))\n    print('-'*80)\nPY\n"]
[11818.503161, "o", "python3 - <<'PY'\r\n"]
