[9421.609169, "o", "\r\n    major, minor, patch = sv\r\n    if level == 'major':\r\n        new = f\"{major + 1}.0.0\"\r\n    elif level == 'minor':\r\n        new = f\"{major}.{minor + 1}.0\"\r\n    else:\r\n        new = f\"{major}.{minor}.{patch + 1}\"\r\n\r\n    services[service]['version'] = new\r\n    with open(MANIFEST_PATH, 'w') as f:\r\n        yaml.safe_dump(data, f, sort_keys=False)\r\n"]
[9421.609229, "o", "    print(f\"BUMP {service} {old} -> {new}\")\r\n\r\ndef snapshot_file(env):\r\n    return os.path.join(SNAPSHOTS_DIR, f\"{env}.json\")\r\n\r\ndef load_snapshots(env):\r\n    return load_json(snapshot_file(env), [])\r\n\r\ndef save_snapshots(env, snapshots):\r\n    save_json(snapshot_file(env), snapshots)\r\n\r\ndef cmd_snapshot(args):\r\n    values, flags, positionals = parse_opts(args, set(), {\"--list\"})\r\n    if len(positionals) != 1:\r\n        fail(\"snapshot requires an environment\")\r\n\r\n    env = positionals[0]"]
