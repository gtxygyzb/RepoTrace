[9413.259935, "o", "        append_event(env, \"ROLLBACK\", service, \"-\")\r\n        print(f\"ROLLBACK {service} from {env}: {current_version} -> (removed)\")\r\n    else:\r\n        state[service] = {\"version\": target_version, \"deployed_at\": now_iso()}\r\n        replicas[service] = 1\r\n        save_deployment_state(env, state)\r\n        save_replicas(env, replicas)\r\n        append_event(env, \"ROLLBACK\", service, target_version)\r\n        print(f\"ROLLBACK {service} from {env}: {current_version} -> {target_version}\")\r\n\r\ndef valid_version(v):\r\n    if not isinstance(v, str):\r\n        return False\r\n    parts = v.split('.')\r\n    if len(parts) != 3:\r\n        return False\r\n    for part in parts:\r\n        if not part.isdigit() or (part != '0' and part.startswith('0')):\r\n            return False\r\n"]
[9413.259998, "o", "    return True\r\n\r\ndef parse_semver(v):\r\n    if not valid_version(v):\r\n        return None\r\n    return tuple(int(x) for x in v.split('.'))\r\n\r\ndef extract_semver(version):\r\n    if not isinstance(version, str):\r\n        return None\r\n    semver = version.split(':', 1)[1] if ':' in version else version\r\n    if '+build.' in semver:\r\n        semver = semver.split('+build.', 1)[0]\r\n    return parse_semver(semver)\r\n"]
[9413.260063, "o", "\r\ndef semver_string(version):\r\n    sv = extract_semver(version)\r\n    if sv is None:\r\n        return None\r\n    return f\"{sv[0]}.{sv[1]}.{sv[2]}\"\r\n\r\ndef version_build_timestamp(version):\r\n    if not isinstance(version, str) or '+build.' not in version:\r\n        return None\r\n    after = version.split('+build.', 1)[1]\r\n    try:\r\n        return int(after)\r\n    except ValueError:\r\n        return None\r\n"]
[9413.260126, "o", "\r\ndef compare_versions(a, b):\r\n    sa = extract_semver(a)\r\n    sb = extract_semver(b)\r\n    if sa is not None and sb is not None:\r\n        if sa != sb:\r\n            return 1 if sa > sb else -1\r\n        ta = version_build_timestamp(a)\r\n        tb = version_build_timestamp(b)\r\n        if ta is not None and tb is not None and ta != tb:\r\n            return 1 if ta > tb else -1\r\n        return 0\r\n    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)\r\ndef cmd_promote(args):\r\n"]
[9413.260189, "o", "    values, flags, positionals = parse_opts(args, {\"--service\"}, {\"--dry-run\", \"--force\"})\r\n    if len(positionals) != 2:\r\n        fail(\"promote requires <source-env> <target-env>\")\r\n\r\n    source, target = positionals\r\n    service = values.get(\"--service\")\r\n    dry_run = \"--dry-run\" in flags\r\n    force = \"--force\" in flags\r\n\r\n    data = load_manifest()\r\n    services, envs = get_services(data)\r\n\r\n    if source not in envs:\r\n"]
