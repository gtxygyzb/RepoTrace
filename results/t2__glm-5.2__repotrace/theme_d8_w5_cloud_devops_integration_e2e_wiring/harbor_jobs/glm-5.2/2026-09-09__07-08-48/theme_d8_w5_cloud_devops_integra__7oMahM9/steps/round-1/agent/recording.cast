[4826.798325, "o", "   629\t                continue\r\n   630\t            src_sv = extract_semver(src_version)\r\n   631\t            tgt_sv = extract_semver(tgt_version)\r\n   632\t            if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:\r\n   633\t                print(f\"  Would conflict {s} (downgrade)\")\r\n   634\t            else:\r\n   635\t                print(f\"  Would promote {s}\")\r\n"]
