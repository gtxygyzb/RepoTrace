[11888.672884, "i", "cat > /tmp/patch_quota2.py <<'PY'\nfrom pathlib import Path\n\np = Path('pipeline.sh')\ns = p.read_text()\n\n# 1. Add QUOTA_DIR constant and ensure_state directory\ns = s.replace(\n\"HEALTH_DIR = os.path.join(STATE_DIR, 'health')\\n\",\n\"HEALTH_DIR = os.path.join(STATE_DIR, 'health')\\nQUOTA_DIR = os.path.join(STATE_DIR, 'quotas')\\n\"\n)\n\ns = s.replace(\n\"os.makedirs(HEALTH_DIR, exist_ok=True)\\n\",\n\"os.makedirs(HEALTH_DIR, exist_ok=True)\\n    os.makedirs(QUOTA_DIR, exist_ok=True)\\n\"\n)\n\n# 2. Insert quota helpers before config_file\nhelpers = r'''\ndef quota_file(env):\n    return os.path.join(QUOTA_DIR, f\"{env}.json\")\n\ndef load_quotas(env):\n    return load_json(quota_file(env), {})\n\ndef save_quotas(env, quotas):\n    save_json(quota_file(env), quotas)\n\ndef quota_supported_resources():\n    return ['max_services', 'max_total_replicas']\n\ndef validate_quota_resource(resource):\n    if resource not in quota_supported_resources():\n        fail(f\"unknown quota resource '{resource}' (must be max_services or max_total_replicas)\")\n\ndef quota"]
