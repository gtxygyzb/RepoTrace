[7457.866374, "o", "\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef load_manifest\u001b[m\u001b[K():\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kvalidate_manifest(data):\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kfind_cycle(services):\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kget_services(data):\r\n\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktopo_order(services, subset=None):\r\n\u001b[32m\u001b[K179\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbuild_waves(services, subset):\r\n"]
[7457.866455, "o", "\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktransitive_deps(services, name):\r\n\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kservice_path(svc):\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kartifact_path(svc):\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kread_artifact(svc):\r\n"]
