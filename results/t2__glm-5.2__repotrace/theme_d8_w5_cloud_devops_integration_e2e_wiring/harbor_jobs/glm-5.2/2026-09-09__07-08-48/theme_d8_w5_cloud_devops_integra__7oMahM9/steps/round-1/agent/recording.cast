[3091.687998, "o", "def load_manifest():\r\n    try:\r\n        with open(MANIFEST_PATH) as f:\r\n            data = yaml.safe_load(f)\r\n    except FileNotFoundError:\r\n"]
[3091.688111, "o", "        fail(\"manifest not found\")\r\n    except yaml.YAMLError as e:\r\n        fail(f\"YAML syntax error: {e}\")\r\n    if not isinstance(data, dict):\r\n        fail(\"manifest must be a mapping\")\r\n    return data\r\n\r\ndef validate_manifest(data):\r\n    if not isinstance(data, dict):\r\n        raise ValueError(\"manifest must be a mapping\")\r\n\r\n    services = data.get('services')\r\n    if not isinstance(services, dict) or not services:\r\n        raise ValueError(\"manifest missing services\")\r\n\r\n    environments = data.get('environments')\r\n    if not isinstance(environments, dict) or not environments:\r\n        raise ValueError(\"manifest missing environments\")\r\n\r\n    for env_name, env in environments.items():\r\n        if not isinstance(env, dict):\r\n            raise ValueError(f\"environment {env_name} must be a mapping\")"]
[3091.68819, "o", "\r\n        for field in ENV_FIELDS:\r\n            if field not in env:\r\n                raise ValueError(f\"environment {env_name} missing required field: {field}\")\r\n\r\n    for name, svc in services.items():\r\n        if not isinstance(svc, dict):\r\n            raise ValueError(f\"service {name} must be a mapping\")\r\n        for field in SERVICE_FIELDS:\r\n            if field not in svc:\r\n                raise ValueError(f\"service {name} missing required field: {field}\")\r\n        if not isinstance(svc['depends_on'], list):\r\n"]
[3091.688262, "o", "            raise ValueError(f\"service {name} has invalid depends_on: must be a list\")\r\n        for dep in svc['depends_on']:\r\n            if dep not in services:\r\n                raise ValueError(f\"service {name} depends on undefined service: {dep}\")\r\n\r\n    port_map = {}\r\n"]
[3091.688851, "o", "\u001b[?2004h"]
[3091.68892, "o", "root@n30009:/app# "]
[3091.976201, "i", "sed -n '270,430p' pipeline.sh\n"]
[3091.976518, "o", "sed -n '270,430p' pipeline.sh\r\n\u001b[?2004l\r"]
[3091.979698, "o", "def cmd_validate(args):\r\n    if args:\r\n        fail(\"validate takes no arguments\")\r\n    data = load_manifest()\r\n    try:\r\n        validate_manifest(data)\r\n    except ValueError as e:\r\n        print(f\"ERROR: {e}\")\r\n"]
[3091.979807, "o", "        sys.exit(1)\r\n    print(\"VALID\")\r\n\r\ndef cmd_order(args):\r\n    if args:\r\n        fail(\"order takes no arguments\")\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n    for s in topo_order(services):\r\n        print(s)\r\n\r\ndef cmd_build(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--parallel'})\r\n    if positionals:\r\n        fail(\"build does not accept positional arguments\")\r\n\r\n    service = values.get('--service')\r\n    parallel = '--parallel' in flags\r\n\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n"]
[3091.979902, "o", "\r\n    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n\r\n    if parallel:\r\n        for wave in build_waves(services, subset):\r\n            print(\",\".join(wave))\r\n        return\r\n\r\n    order = topo_order(services, subset)\r\n    any_fail = False\r\n    for s in order:\r\n        svc = services[s]\r\n        path = service_path(svc)\r\n        if not os.path.isdir(path):\r\n            print(f\"BUILD {s} FAIL: service path does not exist\")\r\n            any_fail = True\r\n            continue\r\n        try:\r\n"]
[3091.980003, "o", "            os.makedirs(os.path.join(path, 'build'), exist_ok=True)\r\n            with open(os.path.join(path, 'build', 'artifact.txt'), 'w') as f:\r\n                f.write(f\"{s}:{int(time.time())}:built\")\r\n            print(f\"BUILD {s} OK\")\r\n        except Exception as e:\r\n            print(f\"BUILD {s} FAIL: {e}\")\r\n            any_fail = True\r\n\r\n"]
[3091.980088, "o", "    if any_fail:\r\n        sys.exit(1)\r\n\r\ndef cmd_test(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--fail-fast'})\r\n    if positionals:\r\n        fail(\"test does not accept positional arguments\")\r\n\r\n    service = values.get('--service')\r\n    fail_fast = '--fail-fast' in flags\r\n\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n\r\n    if service:\r\n        if service not in services:\r\n            fail(f\"service not found: {service}\")\r\n        order = [service]\r\n    else:\r\n        order = topo_order(services)\r\n\r\n    ensure_state()\r\n"]
[3091.980154, "o", "    results = load_json(TEST_RESULTS_PATH, {})\r\n    any_fail = False\r\n\r\n    for s in order:\r\n        if os.path.exists(artifact_path(services[s])):\r\n            results[s] = {\"pass\": True, \"timestamp\": now_iso()}\r\n            print(f\"TEST {s} PASS\")\r\n        else:\r\n"]
[3091.980217, "o", "            results[s] = {\"pass\": False, \"timestamp\": now_iso()}\r\n            print(f\"TEST {s} FAIL: not built\")\r\n            any_fail = True\r\n            if fail_fast:\r\n                break\r\n\r\n    save_json(TEST_RESULTS_PATH, results)\r\n    if any_fail:\r\n        sys.exit(1)\r\n\r\n"]
[3091.980281, "o", "def cmd_deploy(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--dry-run'})\r\n    if len(positionals) != 1:\r\n        fail(\"deploy requires an environment\")\r\n\r\n    env = positionals[0]\r\n    service = values.get('--service')\r\n    dry_run = '--dry-run' in flags\r\n\r\n    data = load_manifest()\r\n    services, envs = get_services(data)\r\n\r\n    if env not in envs:"]
[3091.980369, "o", "\r\n        fail(f\"environment not found: {env}\")\r\n\r\n    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n\r\n    order = topo_order(services, subset)\r\n    ensure_state()\r\n\r\n    if dry_run:\r\n        print(f\"DRY-RUN deploy to {env}:\")\r\n        for s in order:\r\n            print(f\"  Would deploy {s}\")\r\n        return\r\n"]
[3091.980435, "o", "\r\n    test_results = load_json(TEST_RESULTS_PATH, {})\r\n    state = load_deployment_state(env)\r\n    any_fail = False\r\n    deployed_events = []\r\n\r\n    for s in order:\r\n        rec = test_results.get(s)\r\n        if not rec or not rec.get(\"pass\"):\r\n            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n            any_fail = True\r\n            break\r\n\r\n        version = read_artifact(services[s])\r\n        if version is None:"]
[3091.980496, "o", "\r\n            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n            any_fail = True\r\n            break\r\n\r\n        state[s] = {\"version\": version, \"deployed_at\": now_iso()}\r\n        deployed_events.append((s, version))\r\n        print(f\"DEPLOY {s} -> {env} OK\")\r\n\r\n    save_deployment_state(env, state)\r\n    for s, version in deployed_events:\r\n        append_event(env, \"DEPLOY\", s, version)\r\n    if any_fail:\r\n"]
[3091.980563, "o", "        sys.exit(1)\r\n\r\ndef cmd_status(args):\r\n    if len(args) > 1:\r\n        fail(\"status takes at most one environment argument\")\r\n\r\n    data = load_manifest()\r\n"]
[3091.980624, "o", "    _, envs = get_services(data)\r\n"]
