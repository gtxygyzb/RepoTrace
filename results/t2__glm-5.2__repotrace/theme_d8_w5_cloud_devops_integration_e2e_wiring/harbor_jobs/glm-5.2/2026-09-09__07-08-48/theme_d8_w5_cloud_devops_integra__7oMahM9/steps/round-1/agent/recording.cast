[8521.321712, "o", "        print(f\"SCALED {env}/{service} to {count} replicas (was {previous})\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.321767, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8521.321823, "o", "\u001b[?2004h> "]
[8521.32188, "o", "    if len(rest) == 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.32194, "o", "        ensure_state()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.322031, "o", "        state = load_deployment_state(env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.32212, "o", "        if service not in state:\r\n\u001b[?2004l\r\u001b[?2004h> "]
