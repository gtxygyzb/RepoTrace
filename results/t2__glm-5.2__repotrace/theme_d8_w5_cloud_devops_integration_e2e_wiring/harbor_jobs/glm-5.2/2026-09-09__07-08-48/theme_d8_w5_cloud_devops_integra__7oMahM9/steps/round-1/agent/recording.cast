[3185.113703, "o", "        target_state[s] = src_rec\r\n   527\t        print(f\"PROMOTE {s} -> {target} OK\")\r\n   528\t        promoted += 1\r\n   529\t        promote_events.append((s, src_version))\r\n   530\t\r\n   531\t    save_deployment_state(target, target_state)\r\n   532\t    for s, version in promote_events:\r\n   533\t        append_event(target, \"PROMOTE\", s, version, source)\r\n   534\t    print(f\"Promoted {promoted}, skipped {skipped}\")\r\n   535\t\r\n"]
