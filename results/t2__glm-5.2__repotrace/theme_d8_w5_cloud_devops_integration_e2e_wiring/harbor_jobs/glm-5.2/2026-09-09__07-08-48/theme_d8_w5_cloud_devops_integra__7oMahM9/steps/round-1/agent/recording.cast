[3894.420641, "o", "    print(f\"ROLLBACK {service} from {env} OK\")\r\n   473\t\r\n   474\tdef valid_version(v):\r\n   475\t    if not isinstance(v, str):\r\n   476\t        return False\r\n   477\t    parts = v.split('.')\r\n   478\t    if len(parts) != 3:\r\n   479\t        return False\r\n   480\t    for part in parts:\r\n   481\t        if not part.isdigit() or (part != '0' and part.startswith('0')):\r\n   482\t            return False\r\n   483\t    return True\r\n   484\t\r\n   485\tdef parse_semver(v):\r\n   486\t    if not valid_version(v):\r\n   487\t        return None\r\n   488\t    return tuple(int(x) for x in v.split('.'))\r\n   489\t\r\n   490\tdef extract_semver(version):\r\n   491\t    if not isinstance(version, str):\r\n   492\t        return None\r\n   493\t    semver = version.split(':', 1)[1] if ':' in version else version\r\n"]
[3894.420721, "o", "   494\t    if '+build.' in semver:\r\n   495\t        semver = semver.split('+build.', 1)[0]\r\n   496\t    return parse_semver(semver)\r\n   497\t\r\n   498\tdef semver_string(version):\r\n   499\t    sv = extract_semver(version)\r\n   500\t    if sv is None:\r\n   501\t        return None\r\n   502\t    return f\"{sv[0]}.{sv[1]}.{sv[2]}\"\r\n   503\t\r\n   504\tdef version_build_timestamp(version):\r\n   505\t    if not isinstance(version, str) or '+build.' not in version:\r\n   506\t        return None\r\n   507\t    after = version.split('+build.', 1)[1]\r\n"]
