[9412.673625, "o", "#!/usr/bin/env bash\r\nset -euo pipefail\r\ntmp_script=\"$(mktemp)\"\r\ntrap 'rm -f \"$tmp_script\"' EXIT\r\ncat > \"$tmp_script\" <<'PY'\r\nimport sys\r\nimport os\r\n"]
[9412.673719, "o", "import json\r\nimport time\r\nimport yaml\r\nimport re\r\nfrom datetime import datetime, timezone\r\n\r\nAPP_DIR = '/app'\r\nMANIFEST_PATH = '/app/pipeline.yaml'\r\nSTATE_DIR = '/app/.pipeline'\r\nTEST_RESULTS_PATH = os.path.join(STATE_DIR, 'test_results.json')\r\nDEPLOYMENTS_DIR = os.path.join(STATE_DIR, 'deployments')\r\nEVENTS_DIR = os.path.join(STATE_DIR, 'events')\r\nSNAPSHOTS_DIR = os.path.join(STATE_DIR, 'snapshots')\r\nLOCK_DIR = os.path.join(STATE_DIR, 'locks')\r\nCONFIG_DIR = os.path.join(STATE_DIR, 'config')\r\nREPLICAS_DIR = os.path.join(STATE_DIR, 'replicas')\r\nBOUNDS_DIR = os.path.join(STATE_DIR, 'bounds')\r\n"]
[9412.673801, "o", "\r\nSERVICE_FIELDS = ['version', 'path', 'build_cmd', 'test_cmd', 'port', 'depends_on', 'health_endpoint']\r\nENV_FIELDS = ['deploy_target', 'health_check_port', 'max_replicas']\r\n\r\ndef ensure_state():\r\n    os.makedirs(STATE_DIR, exist_ok=True)\r\n    os.makedirs(DEPLOYMENTS_DIR, exist_ok=True)\r\n    os.makedirs(EVENTS_DIR, exist_ok=True)\r\n    os.makedirs(SNAPSHOTS_DIR, exist_ok=True)\r\n    os.makedirs(LOCK_DIR, exist_ok=True)\r\n    os.makedirs(CONFIG_DIR, exist_ok=True)\r\n    os.makedirs(REPLICAS_DIR, exist_ok=True)\r\n    os.makedirs(BOUNDS_DIR, exist_ok=True)\r\n\r\ndef fail(msg, code=1):\r\n    print(f\"ERROR: {msg}\")\r\n"]
[9412.673875, "o", "    sys.exit(code)\r\n\r\ndef now_iso():\r\n    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n\r\ndef load_json(path, default):\r\n    try:\r\n        with open(path) as f:\r\n            return json.load(f)\r\n    except FileNotFoundError:\r\n        return default\r\n    except json.JSONDecodeError as e:\r\n        fail(f\"state error in {path}: {e}\")\r\n\r\ndef save_json(path, data):\r\n    os.makedirs(os.path.dirname(path), exist_ok=True)\r\n"]
[9412.67394, "o", "    with open(path, 'w') as f:\r\n        json.dump(data, f, indent=2, sort_keys=True)\r\n\r\ndef load_manifest():\r\n    try:\r\n        with open(MANIFEST_PATH) as f:\r\n            data = yaml.safe_load(f)\r\n    except FileNotFoundError:\r\n        fail(\"manifest not found\")\r\n    except yaml.YAMLError as e:\r\n        fail(f\"YAML syntax error: {e}\")\r\n    if not isinstance(data, dict):\r\n        fail(\"manifest must be a mapping\")\r\n    return data\r\n\r\n"]
[9412.674002, "o", "def validate_manifest(data):\r\n    if not isinstance(data, dict):\r\n        raise ValueError(\"manifest must be a mapping\")\r\n\r\n    services = data.get('services')\r\n    if not isinstance(services, dict) or not services:\r\n        raise ValueError(\"manifest missing services\")\r\n\r\n    environments = data.get('environments')\r\n    if not isinstance(environments, dict) or not environments:\r\n        raise ValueError(\"manifest missing environments\")\r\n\r\n    for env_name, env in environments.items():\r\n        if not isinstance(env, dict):\r\n"]
[9412.674063, "o", "            raise ValueError(f\"environment {env_name} must be a mapping\")\r\n        for field in ENV_FIELDS:\r\n            if field not in env:\r\n                raise ValueError(f\"environment {env_name} missing required field: {field}\")\r\n\r\n    for name, svc in services.items():\r\n        if not isinstance(svc, dict):\r\n            raise ValueError(f\"service {name} must be a mapping\")\r\n        for field in SERVICE_FIELDS:\r\n            if field not in svc:\r\n                raise ValueError(f\"service {name} missing required field: {field}\")\r\n"]
[9412.674125, "o", "        if not isinstance(svc['depends_on'], list):\r\n            raise ValueError(f\"service {name} has invalid depends_on: must be a list\")\r\n        for dep in svc['depends_on']:\r\n            if dep not in services:\r\n                raise ValueError(f\"service {name} depends on undefined service: {dep}\")\r\n        if not valid_version(svc.get('version')):\r\n            raise ValueError(f\"service {name} has invalid version: expected N.N.N\")\r\n\r\n    port_map = {}\r\n    for name, svc in services.items():\r\n        port = svc['port']\r\n        if port in port_map:\r\n            raise ValueError(f\"duplicate port assignment: {port}\")\r\n"]
[9412.674189, "o", "        port_map[port] = name\r\n\r\n    cycle = find_cycle(services)\r\n    if cycle:\r\n        raise ValueError(f\"circular dependency detected: {' -> '.join(cycle)}\")\r\n\r\n    return True\r\n\r\ndef find_cycle(services):\r\n    visited = {}\r\n    stack = []\r\n\r\n    def dfs(node):\r\n"]
[9412.674252, "o", "        visited[node] = 1\r\n        stack.append(node)\r\n        for dep in services[node].get('depends_on', []):\r\n            if dep not in services:\r\n                continue\r\n            if visited.get(dep) == 1:\r\n                idx = stack.index(dep)\r\n                return stack[idx:] + [dep]\r\n            if visited.get(dep) is None:\r\n                res = dfs(dep)\r\n                if res:\r\n                    return res\r\n        stack.pop()\r\n"]
[9412.674333, "o", "        visited[node] = 2\r\n        return None\r\n\r\n    for n in sorted(services):\r\n        if visited.get(n) is None:\r\n            res = dfs(n)\r\n            if res:\r\n                return res\r\n    return None\r\n\r\ndef get_services(data):\r\n    try:\r\n"]
[9412.674396, "o", "        validate_manifest(data)\r\n    except ValueError as e:\r\n        fail(str(e))\r\n    return data['services'], data['environments']\r\n\r\ndef topo_order(services, subset=None):\r\n    if subset is None:\r\n        subset = set(services.keys())\r\n    subset = set(subset)\r\n\r\n    in_degree = {s: 0 for s in subset}\r\n    adj = {s: [] for s in subset}\r\n\r\n    for s in subset:\r\n        for dep in services[s].get('depends_on', []):\r\n            if dep in subset:\r\n"]
[9412.674465, "o", "                adj[dep].append(s)\r\n                in_degree[s] += 1\r\n\r\n    order = []\r\n    available = sorted([s for s in subset if in_degree[s] == 0])\r\n    while available:\r\n        next_available = []\r\n        for s in available:\r\n"]
[9412.674529, "o", "            order.append(s)\r\n            for dependent in sorted(adj[s]):\r\n                in_degree[dependent] -= 1\r\n                if in_degree[dependent] == 0:\r\n                    next_available.append(dependent)\r\n        available = sorted(next_available)\r\n\r\n    if len(order) != len(subset):\r\n        fail(\"circular dependency detected\")\r\n    return order\r\n\r\ndef build_waves(services, subset):\r\n    subset = set(subset)\r\n\r\n    in_degree = {s: 0 for s in subset}\r\n    adj = {s: [] for s in subset}\r\n\r\n    for s in subset:\r\n        for dep in services[s].get('depends_on', []):\r\n"]
[9412.674591, "o", "            if dep in subset:\r\n                adj[dep].append(s)\r\n                in_degree[s] += 1\r\n\r\n    waves = []\r\n    available = sorted([s for s in subset if in_degree[s] == 0])\r\n    while available:\r\n        waves.append(available)\r\n        next_available = []\r\n        for s in available:\r\n            for dependent in sorted(adj[s]):\r\n                in_degree[dependent] -= 1\r\n                if in_degree[dependent] == 0:\r\n                    next_available.append(dependent)\r\n        available = sorted(next_available)\r\n\r\n    if sum(len(w) for w in waves) != len(subset):\r\n"]
[9412.674652, "o", "        fail(\"circular dependency detected\")\r\n    return waves\r\n\r\ndef transitive_deps(services, name):\r\n    if name not in services:\r\n        fail(f\"service not found: {name}\")\r\n    result = set()\r\n    stack = [name]\r\n    while stack:\r\n        s = stack.pop()\r\n        if s not in result:\r\n            result.add(s)\r\n            for dep in services[s].get('depends_on', []):\r\n                if dep not in services:\r\n                    fail(f\"service {s} depends on undefined service: {dep}\")\r\n"]
[9412.674722, "o", "                stack.append(dep)\r\n    return result\r\n\r\ndef service_path(svc):\r\n    p = svc.get('path', '')\r\n    if os.path.isabs(p):\r\n        return p\r\n    return os.path.join(APP_DIR, p)"]
[9412.674792, "o", "\r\n\r\ndef artifact_path(svc):\r\n    return os.path.join(service_path(svc), 'build', 'artifact.txt')\r\n\r\ndef read_artifact(svc):\r\n    try:\r\n        with open(artifact_path(svc)) as f:\r\n            return f.read().strip()\r\n    except FileNotFoundError:\r\n        return None\r\n\r\ndef deployment_file(env):\r\n    return os.path.join(DEPLOYMENTS_DIR, f\"{env}.json\")\r\n\r\ndef load_deployment_state(env):\r\n    return load_json(deployment_file(env), {})\r\n\r\ndef save_deployment_state(env, state):\r\n    save_json(deployment_file(env), state)\r\n\r\ndef replica_file(env):\r\n    return os.path.join(REPLICAS_DIR, f\"{env}.json\")\r\n\r\n"]
[9412.674852, "o", "def load_replicas(env):\r\n    return load_json(replica_file(env), {})\r\n\r\ndef save_replicas(env, replicas):\r\n    save_json(replica_file(env), replicas)\r\n\r\ndef bounds_file(env):\r\n"]
