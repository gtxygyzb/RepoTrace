[11695.392902, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('pipeline.sh')\ns = p.read_text()\n\n# 1. Add QUOTA_DIR constant and ensure_state dir\ns = s.replace(\"HEALTH_DIR = os.path.join(STATE_DIR, 'health')\\n\", \"HEALTH_DIR = os.path.join(STATE_DIR, 'health')\\nQUOTA_DIR = os.path.join(STATE_DIR, 'quotas')\\n\")\ns = s.replace(\"os.makedirs(HEALTH_DIR, exist_ok=True)\\n\", \"os.makedirs(HEALTH_DIR, exist_ok=True)\\n    os.makedirs(QUOTA_DIR, exist_ok=True)\\n\")\n\n# 2. Add quota helpers after append_unlock_event/assert_env_exists/config_file/load_config block. Insert before config_file? We'll insert after load_config function.\nhelper = r'''\ndef quota_file(env):\n    return os.path.join(QUOTA_DIR, f\"{env}.json\")\n\ndef load_quotas(env):\n    return load_json(quota_file(env), {})\n\ndef save_quotas(env, quotas):\n    save_json(quota_file(env), quotas)\n\ndef quota_supported_resources():\n    return ['max_services', 'max_total_replicas']\n\ndef validate_quota_resource(resource):\n    if resource not in quota_supported_resources():\n        fail(f\"un"]
[11695.393189, "i", "known quota resource '{resource}' (must be max_services or max_total_replicas)\")\n\ndef quota_current_usage(env, resource):\n    state = load_deployment_state(env)\n    replicas = load_replicas(env)\n    if resource == 'max_services':\n        return len(state)\n    if resource == 'max_total_replicas':\n        return sum(replicas.get(svc, 1) for svc in state)\n    fail(f\"unknown quota resource '{resource}' (must be max_services or max_total_replicas)\")\n\ndef append_quota_set_event(env, resource, limit):\n    ensure_state()\n    event = {\n        \"timestamp\": int(time.time()),\n        \"iso_timestamp\": now_iso(),\n        \"action\": \"QUOTA_SET\",\n        \"service\": \"-\",\n        \"version\": \"-\",\n        \"resource\": resource,\n        \"limit\": limit,\n    }\n    with open(event_file(env), \"a\") as f:\n        f.write(json.dumps(event) + \"\\n\")\n\ndef append_quota_remove_event(env, resource):\n    ensure_state()\n    event = {\n        \"timestamp\": int(time.time()),\n        \"iso_timestamp\": now_iso(),\n        \"action\": \"QUOTA_REMOVE\",\n    "]
