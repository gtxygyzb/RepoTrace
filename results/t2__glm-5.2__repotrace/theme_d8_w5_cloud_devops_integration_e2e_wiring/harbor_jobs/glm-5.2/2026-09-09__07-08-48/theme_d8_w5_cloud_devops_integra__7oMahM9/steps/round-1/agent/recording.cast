[11467.705635, "o", "\t        \"action\": \"SCALE\",\r\n   366\t        \"service\": service,\r\n   367\t        \"version\": \"-\",\r\n   368\t        \"replicas\": count,\r\n   369\t        \"previous\": previous,\r\n   370\t    }\r\n   371\t    with open(event_file(env), \"a\") as f:\r\n   372\t        f.write(json.dumps(event) + chr(10))\r\n   373\t\r\n   374\tdef load_events(env):\r\n   375\t    ensure_state()\r\n   376\t    try:\r\n   377\t        with open(event_file(env)) as f:\r\n   378\t            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n   379\t    except FileNotFoundError:\r\n   380\t        return []\r\n   381\t    events = []\r\n   382\t    for line in lines:\r\n   383\t        if line.startswith('{'):\r\n   384\t            continue\r\n   385\t        parts = line.split()\r\n   386\t        if len(parts) < 4:\r\n   387\t            continue\r\n   388\t        events.append({\r\n   389\t            \"timestamp\": parts[0],\r\n   390\t            \"action\": parts[1],\r\n   391\t            \"service\": parts[2],\r\n   392\t            \"version\": parts[3],\r\n   393\t            \"line\": line,\r\n"]
