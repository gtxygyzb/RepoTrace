[1131.614347, "o", "    return os.path.join(service_path(svc), 'build', 'artifact.txt')\r\n\u001b[?2004l\r"]
[1131.61442, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.614489, "o", "def read_artifact(svc):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.614558, "o", "    try:\r\n\u001b[?2004l\r"]
[1131.614587, "o", "\u001b[?2004h> "]
