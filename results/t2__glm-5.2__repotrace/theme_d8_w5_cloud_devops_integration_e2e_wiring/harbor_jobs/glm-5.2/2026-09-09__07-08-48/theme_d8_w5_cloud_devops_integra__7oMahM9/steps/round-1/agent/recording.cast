[9864.907241, "o", "   255\t\r\n   256\tdef load_replicas(env):\r\n   257\t    return load_json(replica_file(env), {})\r\n   258\t\r\n   259\tdef save_replicas(env, replicas):\r\n   260\t    save_json(replica_file(env), replicas)\r\n"]
[9864.907456, "o", "   261\t\r\n   262\tdef bounds_file(env):\r\n   263\t    return os.path.join(BOUNDS_DIR, f\"{env}.json\")\r\n   264\t\r\n   265\tdef load_bounds(env):\r\n   266\t    return load_json(bounds_file(env), {})\r\n   267\t\r\n"]
[9864.907554, "o", "   268\tdef save_bounds(env, bounds):\r\n   269\t    save_json(bounds_file(env), bounds)\r\n   270\t\r\n   271\tdef get_replica_count(env, service):\r\n   272\t    replicas = load_replicas(env)\r\n   273\t    return replicas.get(service, 1)\r\n   274\t\r\n   275\tdef get_env_max(envs, env):\r\n   276\t    env_max = envs[env].get('max_replicas')\r\n   277\t    if env_max is None:\r\n   278\t        return None\r\n   279\t    try:\r\n   280\t        return int(env_max)\r\n   281\t    except (ValueError, TypeError):\r\n   282\t        return None\r\n   283\t\r\n   284\tdef parse_positive_int(s):\r\n   285\t    if not isinstance(s, str):\r\n   286\t        return None\r\n   287\t    if not re.fullmatch('[0-9]+', s):\r\n   288\t        return None\r\n   289\t    val = int(s)\r\n   290\t    if val < 1:\r\n   291\t        return None\r\n   292\t    return val\r\n   293\t\r\n   294\t\r\n   295\tdef event_file(env):\r\n   296\t    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n   297\t\r\n   298\tdef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n   299\t    "]
[9864.907653, "o", "ensure_state()\r\n   300\t    ts = now_iso()\r\n   301\t    line = f\"{ts} {action} {service} {version}\"\r\n   302\t    if action == \"PROMOTE\" and source_env is not None:\r\n   303\t        line += f\" from {source_env}\"\r\n   304\t        if forced:\r\n   305\t            line += \" (forced)\"\r\n   306\t    if action == \"RESTORE\" and snapshot_id is not None:\r\n   307\t        line += f\" from snapshot #{snapshot_id}\"\r\n   308\t    line += \"\\n\"\r\n   309\t    with open(event_file(env), \"a\") as f:\r\n   310\t        f.write(line)\r\n"]
[9864.908884, "o", "\u001b[?2004h"]
