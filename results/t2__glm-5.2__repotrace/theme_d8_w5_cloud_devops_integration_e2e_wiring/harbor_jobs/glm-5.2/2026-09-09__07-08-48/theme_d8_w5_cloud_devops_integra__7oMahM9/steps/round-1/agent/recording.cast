[4269.22479, "i", "ts[3],\n            \"line\": line,\n        })\n    return events\n\ndef find_rollback_target(env, service, current_version, to_version=None):\n    events = load_events(env)\n\n    if to_version is not None:\n        for ev in reversed(events):\n            if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] == to_version:\n                return to_version\n        fail(f\"version not found in history for {service}\")\n\n    current_indices = [\n        idx for idx, ev in enumerate(events)\n        if ev[\"service\"] == service\n        and ev[\"version\"] == current_version\n        and not (ev[\"action\"] == \"ROLLBACK\" and ev[\"version\"] == \"-\")\n    ]\n    if not current_indices:\n        return None\n    current_idx = current_indices[-1]\n\n    for ev in reversed(events[:current_idx]):\n        if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\":\n            return ev[\"version\"]\n    return None\n\n'''\n)\n\n# rollback\nreplace_func(\n    \"def cmd_rollback(args):\",\n    \"def valid_version(v):\",\n'''def cmd_rollback(a"]
