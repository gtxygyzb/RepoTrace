[9883.450393, "o", "\t        save_health(env, {})\r\n   304\t\r\n   305\tdef append_health_event(env, service, new_state, previous_state):\r\n   306\t    ensure_state()\r\n   307\t    event = {\r\n   308\t        \"timestamp\": int(time.time()),\r\n   309\t        \"iso_timestamp\": now_iso(),\r\n   310\t        \"action\": \"HEALTH\",\r\n   311\t        \"service\": service,\r\n"]
[9883.45045, "o", "   312\t        \"version\": \"-\",\r\n   313\t        \"state\": new_state,\r\n   314\t        \"previous_state\": previous_state,\r\n   315\t    }\r\n   316\t    with open(event_file(env), \"a\") as f:\r\n   317\t        f.write(json.dumps(event) + \"\\n\")\r\n   318\t\r\n   319\tdef get_replica_count(env, service):\r\n"]
