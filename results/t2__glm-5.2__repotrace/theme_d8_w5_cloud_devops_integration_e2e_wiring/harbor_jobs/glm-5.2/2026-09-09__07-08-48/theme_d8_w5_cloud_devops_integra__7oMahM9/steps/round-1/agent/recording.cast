[3484.512842, "o", "\u001b[?2004h> "]
[3484.512933, "o", "            if cmp == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.513005, "o", "                print(f\"SAME: {s} ({v1})\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.51309, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
