[8521.319049, "o", "\u001b[?2004h> "]
[8521.319104, "o", "    if len(rest) == 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.319161, "o", "        count_str = rest[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.319273, "o", "        count = parse_positive_int(count_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
