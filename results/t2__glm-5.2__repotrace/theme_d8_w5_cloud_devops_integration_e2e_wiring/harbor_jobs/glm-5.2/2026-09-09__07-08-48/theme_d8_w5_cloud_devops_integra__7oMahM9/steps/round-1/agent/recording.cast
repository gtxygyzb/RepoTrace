[5625.566647, "o", "gs) != 2:\r\n        fail(\"bump requires <service> <major|minor|patch>\")\r\n\r\n    service, level = args\r\n    if level not in ('major', 'minor', 'patch'):\r\n        fail(\"bump level must be major, minor, or patch\")\r\n\r\n    data = load_manifest()\r\n    services = data.get('services')\r\n    if not isinstance(services, dict) or service not in services:\r\n        fail(f\"service not found: {service}\")\r\n\r\n    old = services[service].get('version')\r\n    sv = parse_semver(old)\r\n    if sv is None:\r\n        fail(f\"service {service} has invalid version: {old}\")\r\n\r\n    major, minor, patch = sv\r\n    if level == 'major':\r\n        new = f\"{major + 1}.0.0\"\r\n    elif level == 'minor':\r\n        new = f\"{major}.{minor + 1}.0\"\r\n    else:\r\n        new = f\"{major}.{minor}.{patch + 1}\"\r\n\r\n    services[service]['version'] = new\r\n    with open(MANIFEST_PATH, 'w') as f:\r\n        yaml.safe_dump(data, f, sort_keys=False)\r\n    print(f\"BUMP {service} {old} -> {new}\")\r\n\r\ndef snapshot_file(env):\r\n    return os.path.join(SNAPSHOTS_DIR, f\"{env}.json\")\r"]
[5625.566748, "o", "\n\r\ndef load_snapshots(env):\r\n    return load_json(snapshot_file(env), [])\r\n\r\ndef save_snapshots(env, snapshots):\r\n    save_json(snapshot_file(env), snapshots)\r\n\r\ndef cmd_snapshot(args):\r\n    values, flags, positionals = parse_opts(args, set(), {\"--list\"})\r\n    if len(positionals) != 1:\r\n        fail(\"snapshot requires an environment\")\r\n\r\n    env = positionals[0]\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n    ensure_state()\r\n\r\n    if \"--list\" in flags:\r\n        snapshots = load_snapshots(env)\r\n        for snap in snapshots:\r\n            services = snap.get(\"services\", {})\r\n            print(f\"#{snap.get('id', '?')} {snap.get('timestamp', '')} ({len(services)} services)\")\r\n        return\r\n\r\n    state = load_deployment_state(env)\r\n    snapshots = load_snapshots(env)\r\n    next_id = 1\r\n    for snap in snapshots:\r\n        if isinstance(snap.get(\"id\"), int) and snap[\"id\"] >= next_id:\r\n            next_id = snap[\"id\"] + 1\r\n   "]
[5625.566923, "o", " timestamp = now_iso()\r\n    snapshot = {\"id\": next_id, \"timestamp\": timestamp, \"services\": state}\r\n    snapshots.append(snapshot)\r\n    save_snapshots(env, snapshots)\r\n    print(f\"SNAPSHOT {env} #{next_id} ({len(state)} services)\")\r\n\r\ndef cmd_restore(args):\r\n    values, flags, positionals = parse_opts(args, set(), set())\r\n    if len(positionals) != 2:\r\n        fail(\"restore requires <environment> <snapshot_id>\")\r\n\r\n    env, snapshot_id_str = positionals\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n    assert_not_locked(env)\r\n    ensure_state()\r\n\r\n    try:\r\n        snapshot_id = int(snapshot_id_str)\r\n    except ValueError:\r\n        fail(\"snapshot id must be an integer\")\r\n\r\n    snapshots = load_snapshots(env)\r\n    snapshot = None\r\n    for snap in snapshots:\r\n        if snap.get(\"id\") == snapshot_id:\r\n            snapshot = snap\r\n            break\r\n    if snapshot is None:\r\n        fail(f\"snapshot not found: #{snapshot_id}\")"]
[5625.567027, "o", "\r\n\r\n    recorded = snapshot.get(\"services\", {})\r\n    state = {}\r\n    for svc, rec in recorded.items():\r\n        state[svc] = dict(rec)\r\n    save_deployment_state(env, state)\r\n\r\n    for svc in sorted(state):\r\n        version = state[svc].get(\"version\", \"\")\r\n        append_event(env, \"RESTORE\", svc, version, snapshot_id=snapshot_id)\r\n        print(f\"RESTORE {svc} -> {env} ({version})\")\r\n    print(f\"Restored {len(state)} services from snapshot #{snapshot_id}\")\r\n\r\ndef cmd_lock(args):\r\n    values, flags, positionals = parse_opts(args, {'--reason'}, {'--list'})\r\n    if '--list' in flags:\r\n        data = load_manifest()\r\n        _, envs = get_services(data)\r\n        ensure_state()\r\n        locked = []\r\n        for env in envs:\r\n            lock = load_lock(env)\r\n            if lock is not None:\r\n                locked.append((env, lock.get('reason', 'manual lock'), lock.get('locked_since', '')))\r\n        for env, reason, since in sorted(locked):\r\n            print(f\"{env}: {reason} (locked since {since})\")\r\n        "]
[5625.567127, "o", "return\r\n    if len(positionals) != 1:\r\n        fail(\"lock requires <environment> [--reason REASON] or --list\")\r\n    env = positionals[0]\r\n    reason = values.get('--reason', 'manual lock')\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"unknown environment {env}\")\r\n    ensure_state()\r\n    save_lock(env, reason)\r\n    append_lock_event(env, reason)\r\n    print(f\"LOCKED {env}: {reason}\")\r\n\r\ndef cmd_unlock(args):\r\n    values, flags, positionals = parse_opts(args, set(), set())\r\n    if len(positionals) != 1:\r\n        fail(\"unlock requires <environment>\")\r\n    env = positionals[0]\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"unknown environment {env}\")\r\n    ensure_state()\r\n    remove_lock(env)\r\n    append_unlock_event(env)\r\n    print(f\"UNLOCKED {env}\")\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        fail(\"no command given\")\r\n\r\n    cmd = sys.argv[1]\r\n    args = sys.argv[2:]\r\n\r\n    if cmd == 'validate':\r"]
