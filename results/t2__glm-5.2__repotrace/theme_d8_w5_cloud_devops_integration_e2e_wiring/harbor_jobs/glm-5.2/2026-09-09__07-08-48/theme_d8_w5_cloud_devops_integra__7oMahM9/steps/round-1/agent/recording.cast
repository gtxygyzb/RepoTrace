[3941.930731, "o", "            fail(\"--limit must be non-negative\")\r\n\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n\r\n    ensure_state()\r\n    try:\r\n        with open(event_file(env)) as f:\r\n            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n    except FileNotFoundError:\r\n        lines = []\r\n\r\n    if service:\r\n        lines = [line for line in lines if len(line.split()) >= 3 and line.split()[2] == service]\r\n\r\n    lines.reverse()\r\n    lines = lines[:limit]\r\n    for line in lines:\r\n        print(line)\r\n\r\ndef print_tree(node, services, path, depth):\r\n    print(\"  \" * depth + node)\r\n    if node in path:\r\n        return\r\n    path = path | {node}\r\n    children = sorted([s for s in services if node in services[s].get('depends_on', [])])"]
[3941.930812, "o", "\r\n    for child in children:\r\n        print_tree(child, services, path, depth + 1)\r\n\r\n"]
