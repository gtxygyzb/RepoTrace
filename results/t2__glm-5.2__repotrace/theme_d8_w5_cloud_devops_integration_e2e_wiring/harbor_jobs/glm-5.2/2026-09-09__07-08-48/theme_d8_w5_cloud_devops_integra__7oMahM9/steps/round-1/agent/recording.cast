[3403.922561, "o", "        append_event(target, \"PROMOTE\", s, version, source, forced=forced)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.922723, "o", "    print(f\"Promoted {promoted}, skipped {skipped}, conflicts {conflicts}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.922779, "o", "\"\"\",\r\n\u001b[?2004l\r\u001b[?2004h>     ),\r\n\u001b[?2004l\r"]
[3403.922839, "o", "\u001b[?2004h>     (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.922908, "o", "        \"\"\"        elif v1 == v2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.923001, "o", "            print(f\"SAME: {s} ({v1})\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.92307, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.923142, "o", "            t1 = version_timestamp(v1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.923234, "o", "            t2 = version_timestamp(v2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.923352, "o", "            if t1 is not None and t2 is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.923426, "o", "                if t1 >= t2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.92351, "o", "                    newer = env1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.923572, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.923655, "o", "                    newer = env2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.923723, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.923846, "o", "                newer = env1 if str(v1) >= str(v2) else env2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.923984, "o", "            print(f\"DIFFERS: {s} {v1} vs {v2} ({newer} newer)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.92404, "o", "\"\"\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.924098, "o", "        \"\"\"        elif v1 == v2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.924191, "o", "            print(f\"SAME: {s} ({v1})\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.92424, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.924344, "o", "            cmp = compare_versions(v1, v2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.924412, "o", "            if cmp == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.924513, "o", "                print(f\"SAME: {s} ({v1})\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.924566, "o", "            else:\r\n\u001b[?2004l\r"]
[3403.924623, "o", "\u001b[?2004h> "]
[3403.924684, "o", "                newer = env1 if cmp > 0 else env2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.92483, "o", "                print(f\"DIFFERS: {s} {v1} vs {v2} ({newer} newer)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.924887, "o", "\"\"\",\r\n\u001b[?2004l\r\u001b[?2004h>     ),\r\n\u001b[?2004l\r"]
[3403.924943, "o", "\u001b[?2004h>     (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.925008, "o", "        \"\"\"def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.925063, "o", "    if len(sys.argv) < 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.925146, "o", "        fail(\"no command given\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.925173, "o", "\"\"\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[3403.925194, "o", "> "]
[3403.925257, "o", "        \"\"\"def cmd_bump(args):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.925323, "o", "    if len(args) != 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.925458, "o", "        fail(\"bump requires <service> <major|minor|patch>\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.92548, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.925549, "o", "    service, level = args\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.925662, "o", "    if level not in ('major', 'minor', 'patch'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.925793, "o", "        fail(\"bump level must be major, minor, or patch\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[3403.925814, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3403.925886, "o", "    data = load_manifest()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.925974, "o", "    services = data.get('services')\r\n\u001b[?2004l\r"]
[3403.925995, "o", "\u001b[?2004h> "]
[3403.986927, "o", "    if not isinstance(services, dict) or service not in services:\r\n\u001b[?2004l\r\u001b[?2004h>         fail(f\"service not found: {service}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     old = services[service].get('version')\r\n\u001b[?2004l\r\u001b[?2004h>     sv = parse_semver(old)\r\n\u001b[?2004l\r"]
[3403.986986, "o", "\u001b[?2004h> "]
[3403.987108, "o", "    if sv is None:\r\n\u001b[?2004l\r"]
[3403.987166, "o", "\u001b[?2004h> "]
[3403.987521, "o", "        fail(f\"service {service} has invalid version: {old}\")\r\n\u001b[?2004l\r"]
[3403.987581, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3403.987637, "o", "\u001b[?2004h> "]
[3403.987807, "o", "    major, minor, patch = sv\r\n\u001b[?2004l\r"]
[3403.987864, "o", "\u001b[?2004h> "]
[3403.988007, "o", "    if level == 'major':\r\n\u001b[?2004l\r"]
[3403.988069, "o", "\u001b[?2004h> "]
[3403.988253, "o", "        new = f\"{major + 1}.0.0\"\r\n\u001b[?2004l\r"]
[3403.988334, "o", "\u001b[?2004h> "]
[3403.988476, "o", "    elif level == 'minor':\r\n\u001b[?2004l\r"]
[3403.988553, "o", "\u001b[?2004h> "]
[3403.988754, "o", "        new = f\"{major}.{minor + 1}.0\"\r\n\u001b[?2004l\r"]
[3403.98881, "o", "\u001b[?2004h> "]
[3403.988873, "o", "    else:\r\n\u001b[?2004l\r"]
[3403.988929, "o", "\u001b[?2004h> "]
[3403.98921, "o", "        new = f\"{major}.{minor}.{patch + 1}\"\r\n\u001b[?2004l\r"]
[3403.989263, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3403.989345, "o", "\u001b[?2004h> "]
[3403.989584, "o", "    services[service]['version'] = new\r\n\u001b[?2004l\r"]
[3403.989644, "o", "\u001b[?2004h> "]
[3403.989869, "o", "    with open(MANIFEST_PATH, 'w') as f:\r\n\u001b[?2004l\r"]
[3403.989926, "o", "\u001b[?2004h> "]
[3403.990217, "o", "        yaml.safe_dump(data, f, sort_keys=False)\r\n\u001b[?2004l\r"]
[3403.990281, "o", "\u001b[?2004h> "]
[3403.990539, "o", "    print(f\"BUMP {service} {old} -> {new}\")\r\n\u001b[?2004l\r"]
[3403.990607, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3403.990663, "o", "\u001b[?2004h> "]
