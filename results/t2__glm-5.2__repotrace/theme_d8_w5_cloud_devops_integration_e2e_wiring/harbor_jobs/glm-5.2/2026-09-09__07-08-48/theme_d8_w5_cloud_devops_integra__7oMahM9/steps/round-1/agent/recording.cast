[9404.312778, "o", "    locked_since = existing.get('locked_since', now_iso()) if existing else now_iso()\r\n    lock = {\"reason\": reason, \"locked_since\": locked_since}\r\n    save_json(lock_file(env), lock)\r\n\r\ndef remove_lock(env):\r\n    try:\r\n        os.remove(lock_file(env))\r\n    except FileNotFoundError:\r\n        pass\r\n\r\ndef is_locked(env):\r\n    return load_lock(env) is not None\r\n\r\ndef assert_not_locked(env):\r\n    lock = load_lock(env)\r\n    if lock is not None:\r\n"]
[9404.312866, "o", "        fail(f\"{env} is locked ({lock.get('reason', 'manual lock')})\")\r\n\r\ndef append_lock_event(env, reason):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"LOCK\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n        \"reason\": reason,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef append_unlock_event(env):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"UNLOCK\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n"]
[9404.312955, "o", "    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef assert_env_exists(env):\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"unknown environment '{env}'\")\r\n\r\ndef config_file(env):\r\n    return os.path.join(CONFIG_DIR, f\"{env}.json\")\r\n\r\ndef load_config(env):\r\n    return load_json(config_file(env), {})\r\n\r\ndef save_config(env, cfg):\r\n    save_json(config_file(env), cfg)\r\n\r\ndef validate_config_key(key):\r\n"]
[9404.313042, "o", "    if not isinstance(key, str) or not re.match(r'^[A-Za-z_][A-Za-z0-9_]*$', key):\r\n        fail(f\"invalid key '{key}'\")\r\n\r\ndef append_config_set_event(env, key, value):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"CONFIG_SET\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n        \"key\": key,\r\n        \"value\": value,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef append_config_delete_event(env, key):\r\n"]
[9404.31313, "o", "    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"CONFIG_DELETE\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n        \"key\": key,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef find_rollback_target(env, service, current_version, to_version=None):\r\n    events = load_events(env)\r\n\r\n    if to_version is not None:\r\n        for ev in reversed(events):\r\n            if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] == to_version:\r\n                return to_version\r\n        fail(f\"version not found in history for {service}\")\r\n"]
[9404.313369, "o", "\r\n    current_idx = None\r\n    for idx, ev in enumerate(events):\r\n        if ev[\"service\"] != service:\r\n            continue\r\n        if ev[\"version\"] != current_version:\r\n            continue\r\n        if ev[\"action\"] == \"ROLLBACK\" and ev[\"version\"] == \"-\":\r\n            continue\r\n        current_idx = idx\r\n"]
[9404.313485, "o", "\r\n    if current_idx is None:\r\n        return None\r\n\r\n    for ev in reversed(events[:current_idx]):\r\n        if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] != current_version:\r\n            return ev[\"version\"]\r\n    return None\r\n\r\ndef parse_opts(args, value_opts, flag_opts):\r\n    values = {}\r\n    flags = set()\r\n    positionals = []\r\n    i = 0\r\n    while i < len(args):\r\n        a = args[i]\r\n        if a in value_opts:\r\n            i += 1\r\n            if i >= len(args):\r\n                fail(f\"{a} requires a value\")\r\n            values[a] = args[i]\r\n        elif a in flag_opts:\r\n            flags.add(a)\r\n        elif a.startswith('--'):\r\n            fail(f\"unknown option: {a}\")\r\n        else:\r\n            positionals.append(a)\r\n        i += 1\r\n    return values, flags, positionals\r\n\r\ndef cmd_validate(args):\r\n    if args:\r\n        fail(\"validate takes no arguments\")\r\n    data = load_manifest()\r\n    try:\r\n        validate_manifest(data)\r\n    except ValueError as e:\r\n        print(f\"ER"]
[9404.31358, "o", "ROR: {e}\")\r\n        sys.exit(1)\r\n    print(\"VALID\")\r\n\r\ndef cmd_order(args):\r\n    if args:\r\n        fail(\"order takes no arguments\")\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n    for s in topo_order(services):\r\n        print(s)\r\n\r\ndef cmd_build(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--parallel'})\r\n    if positionals:\r\n        fail(\"build does not accept positional arguments\")\r\n\r\n    service = values.get('--service')\r\n    parallel = '--parallel' in flags\r\n\r\n    data = load_manifest()\r\n"]
