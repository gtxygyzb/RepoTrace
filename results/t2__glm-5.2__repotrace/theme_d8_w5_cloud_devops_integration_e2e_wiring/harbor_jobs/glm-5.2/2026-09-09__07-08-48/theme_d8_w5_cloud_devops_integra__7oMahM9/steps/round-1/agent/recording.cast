[14276.988132, "o", "    os.makedirs(QUOTA_DIR, exist_ok=True)\r\n    42\t\r\n    43\tdef fail(msg, code=1):\r\n    44\t    print(f\"ERROR: {msg}\")\r\n    45\t    sys.exit(code)\r\n    46\t\r\n    47\tdef now_iso():\r\n    48\t    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n    49\t\r\n    50\tdef load_json(path, default):\r\n    51\t    try:\r\n    52\t        with open(path) as f:\r\n    53\t            return json.load(f)\r\n    54\t    except FileNotFoundError:\r\n    55\t        return default\r\n    56\t    except json.JSONDecodeError as e:\r\n    57\t        fail(f\"state error in {path}: {e}\")\r\n    58\t\r\n    59\tdef save_json(path, data):\r\n    60\t    os.makedirs(os.path.dirname(path), exist_ok=True)\r\n    61\t    with open(path, 'w') as f:\r\n    62\t        json.dump(data, f, indent=2, sort_keys=True)\r\n    63\t\r\n"]
