[14276.69901, "o", "        for dep in services[node].get('depends_on', []):\r\n   130\t            if dep not in services:\r\n   131\t                continue\r\n   132\t            if visited.get(dep) == 1:\r\n   133\t                idx = stack.index(dep)\r\n   134\t                return stack[idx:] + [dep]\r\n   135\t            if visited.get(dep) is None:\r\n   136\t                res = dfs(dep)\r\n   137\t                if res:\r\n   138\t                    return res\r\n   139\t        stack.pop()\r\n   140\t        visited[node] = 2\r\n   141\t        return None\r\n   142\t\r\n   143\t    for n in sorted(services):\r\n   144\t        if visited.get(n) is None:\r\n"]
