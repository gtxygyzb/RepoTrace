[5713.556527, "o", "\r\n   795\t        fail(f\"environment not found: {env}\")\r\n   796\t\r\n   797\t    ensure_state()\r\n   798\t    try:\r\n   799\t        with open(event_file(env)) as f:\r\n   800\t            raw_lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n   801\t    except FileNotFoundError:\r\n   802\t        raw_lines = []\r\n   803\t\r\n   804\t    entries = []\r\n   805\t    for line in raw_lines:\r\n   806\t        if line.startswith('{'):\r\n   807\t            try:\r\n   808\t                ev = json.loads(line)\r\n   809\t            except json.JSONDecodeError:\r\n   810\t                continue\r\n   811\t            action = ev.get(\"action\")\r\n   812\t            iso = ev.get(\"iso_timestamp\", \"\")\r\n   813\t            svc = ev.get(\"service\", \"-\")\r\n   814\t            if action == \"LOCK\":\r\n   815\t                entries.append((iso, svc, f\"{iso} LOCK {ev.get('reason', '')}\"))\r\n   816\t            elif action == \"UNLOCK\":\r\n   817\t                entries.append((iso, svc, f\"{iso} UNLOCK\"))\r\n   818\t            else:\r\n   819\t                entries.app"]
[5713.556617, "o", "end((iso, svc, line))\r\n   820\t        else:\r\n   821\t            parts = line.split()\r\n   822\t            svc = parts[2] if len(parts) >= 3 else \"\"\r\n   823\t            iso = parts[0] if parts else \"\"\r\n   824\t            entries.append((iso, svc, line))\r\n   825\t\r\n   826\t    if service:\r\n   827\t        entries = [e for e in entries if e[1] == service]\r\n   828\t\r\n   829\t    entries.reverse()\r\n   830\t    entries = entries[:limit]\r\n   831\t    for iso, svc, line in entries:\r\n   832\t        print(line)\r\n   833\t\r\n   834\tdef print_tree(node, services, path, depth):\r\n   835\t    print(\"  \" * depth + node)\r\n   836\t    if node in path:\r\n   837\t        return\r\n   838\t    path = path | {node}\r\n   839\t    children = sorted([s for s in services if node in services[s].get('depends_on', [])])\r\n   840\t    for child in children:\r\n"]
