[1602.756172, "o", "cat pipeline.yaml\r\n\u001b[?2004l\r"]
[1602.758407, "o", "project:\r\n  name: \"myproject\"\r\n  version: \"1.0.0\"\r\n\r\nenvironments:\r\n  staging:\r\n    deploy_target: \"/deployments/staging\"\r\n    health_check_port: 8080\r\n    max_replicas: 2\r\n  production:\r\n    deploy_target: \"/deployments/production\"\r\n    health_check_port: 8080\r\n    max_replicas: 4\r\n\r\nservices:\r\n  api-gateway:\r\n    path: \"services/api-gateway\"\r\n    build_cmd: \"make build\"\r\n    test_cmd: \"make test\"\r\n    port: 8080\r\n    depends_on: []\r\n    health_endpoint: \"/health\"\r\n\r\n  user-service:\r\n    path: \"services/user-service\"\r\n    build_cmd: \"make build\"\r\n    test_cmd: \"make test\"\r\n    port: 8081\r\n    depends_on: [\"api-gateway\"]\r\n    health_endpoint: \"/health\"\r\n\r\n"]
[1602.758551, "o", "  order-service:\r\n    path: \"services/order-service\"\r\n    build_cmd: \"make build\"\r\n    test_cmd: \"make test\"\r\n    port: 8082\r\n    depends_on: [\"user-service\", \"api-gateway\"]\r\n    health_endpoint: \"/health\"\r\n\r\n  notification-service:\r\n    path: \"services/notification-service\"\r\n    build_cmd: \"make build\"\r\n    test_cmd: \"make test\"\r\n    port: 8083\r\n    depends_on: [\"order-service\"]\r\n    health_endpoint: \"/health\"\r\n\r\n  analytics-service:\r\n    path: \"services/analytics-service\"\r\n    build_cmd: \"make build\"\r\n    test_cmd: \"make test\"\r\n    port: 8084\r\n    depends_on: [\"user-service\", \"order-service\"]\r\n    health_endpoint: \"/health\"\r\n"]
