[9619.210675, "o", "\u001b[?2004h> "]
[9619.210809, "o", "'''          if svc_bounds:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.210906, "o", "              bmin, bmax = svc_bounds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.211132, "o", "              if count < bmin or count > bmax:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.211355, "o", "                  fail(f\"{count} violates bounds [{bmin}..{bmax}] for {service} in {env}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.21159, "o", "          replicas = load_replicas(env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.211811, "o", "          if get_health_state(env, service) == \"unhealthy\" and count > replicas.get(service, 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
