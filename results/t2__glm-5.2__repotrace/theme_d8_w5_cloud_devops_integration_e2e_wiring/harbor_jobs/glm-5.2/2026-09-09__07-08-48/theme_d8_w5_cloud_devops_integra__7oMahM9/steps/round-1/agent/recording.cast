[3484.517119, "o", "\u001b[?2004h> "]
[3484.517222, "o", "        fail(\"bump level must be major, minor, or patch\")\r\n\u001b[?2004l\r"]
[3484.517317, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3484.51741, "o", "\u001b[?2004h>     data = load_manifest()\r\n\u001b[?2004l\r\u001b[?2004h> "]
