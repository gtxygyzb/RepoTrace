[11411.617831, "o", "def cmd_config_set(args):\r\n    if len(args) != 3:\r\n        fail(\"config set requires <environment> <KEY> <VALUE>\")\r\n    env, key, value = args\r\n    validate_config_key(key)\r\n    assert_env_exists(env)\r\n    assert_not_locked(env)\r\n    cfg = load_config(env)\r\n    cfg[key] = value\r\n    save_config(env, cfg)\r\n    append_config_set_event(env, key, value)\r\n    print(f\"CONFIG {env}: {key}={value}\")\r\n\r\ndef cmd_config_get(args):\r\n    if len(args) != 2:\r\n        fail(\"config get requires <environment> <KEY>\")\r\n    env, key = args\r\n    assert_env_exists(env)\r\n    cfg = load_config(env)\r\n    if key not in cfg:\r\n        fail(f\"key '{key}' not found in {env}\")\r\n    print(cfg[key])\r\n"]
