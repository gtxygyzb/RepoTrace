[11410.808309, "o", "\r\n    if len(order) != len(subset):\r\n        fail(\"circular dependency detected\")\r\n    return order\r\n\r\ndef build_waves(services, subset):\r\n    subset = set(subset)\r\n\r\n    in_degree = {s: 0 for s in subset}\r\n    adj = {s: [] for s in subset}\r\n\r\n    for s in subset:\r\n        for dep in services[s].get('depends_on', []):\r\n            if dep in subset:\r\n                adj[dep].append(s)\r\n"]
[11410.808458, "o", "                in_degree[s] += 1\r\n\r\n    waves = []\r\n    available = sorted([s for s in subset if in_degree[s] == 0])\r\n    while available:\r\n        waves.append(available)\r\n        next_available = []\r\n        for s in available:\r\n            for dependent in sorted(adj[s]):\r\n                in_degree[dependent] -= 1\r\n                if in_degree[dependent] == 0:\r\n                    next_available.append(dependent)\r\n        available = sorted(next_available)\r\n\r\n    if sum(len(w) for w in waves) != len(subset):\r\n        fail(\"circular dependency detected\")\r\n    return waves\r\n\r\ndef transitive_deps(services, name):\r\n    if name not in services:\r\n        fail(f\"service not found: {name}\")\r\n    result = set()\r\n    stack = [name]\r\n    while stack:\r\n        s = stack.pop()\r\n        if s not in result:\r\n            result.add(s)\r\n            for dep in services[s].get('depends_on', []):\r\n                if dep not in services:\r\n                    fail(f\"service {s} depends on undefined service: {dep}\")\r\n          "]
[11410.808543, "o", "      stack.append(dep)\r\n    return result\r\n\r\ndef service_path(svc):\r\n    p = svc.get('path', '')\r\n    if os.path.isabs(p):\r\n        return p\r\n    return os.path.join(APP_DIR, p)\r\n\r\ndef artifact_path(svc):\r\n    return os.path.join(service_path(svc), 'build', 'artifact.txt')\r\n\r\ndef read_artifact(svc):\r\n    try:\r\n        with open(artifact_path(svc)) as f:\r\n            return f.read().strip()\r\n    except FileNotFoundError:\r\n        return None\r\n\r\ndef deployment_file(env):\r\n    return os.path.join(DEPLOYMENTS_DIR, f\"{env}.json\")\r\n\r\ndef load_deployment_state(env):\r\n    return load_json(deployment_file(env), {})\r\n\r\ndef save_deployment_state(env, state):\r\n    save_json(deployment_file(env), state)\r\n\r\ndef replica_file(env):\r\n    return os.path.join(REPLICAS_DIR, f\"{env}.json\")\r\n\r\n"]
[11410.808638, "o", "def load_replicas(env):\r\n    return load_json(replica_file(env), {})\r\n\r\ndef save_replicas(env, replicas):\r\n    save_json(replica_file(env), replicas)\r\n\r\ndef bounds_file(env):\r\n    return os.path.join(BOUNDS_DIR, f\"{env}.json\")\r\n\r\ndef load_bounds(env):\r\n    return load_json(bounds_file(env), {})\r\n\r\n"]
[11410.808707, "o", "def save_bounds(env, bounds):\r\n    save_json(bounds_file(env), bounds)\r\n\r\ndef health_file(env):\r\n    return os.path.join(HEALTH_DIR, f\"{env}.json\")\r\n\r\ndef load_health(env):\r\n    return load_json(health_file(env), {})\r\n\r\ndef save_health(env, data):\r\n    save_json(health_file(env), data)\r\n\r\ndef is_valid_health_state(state):\r\n    return state in (\"healthy\", \"unhealthy\", \"degraded\")\r\n\r\ndef get_health_state(env, service):\r\n    health = load_health(env)\r\n    rec = health.get(service)\r\n    if not rec or rec.get(\"state\") not in (\"healthy\", \"unhealthy\", \"degraded\"):\r\n        return \"healthy\"\r\n    state = load_deployment_state(env)\r\n    snapshot = rec.get(\"state_snapshot\")\r\n    if not snapshot or state.get(service) != snapshot:\r\n        return \"healthy\"\r\n    return rec[\"state\"]\r\n\r\ndef reset_health(env, service):\r\n"]
[11410.808779, "o", "    health = load_health(env)\r\n    if service in health:\r\n        del health[service]\r\n        save_health(env, health)\r\n\r\ndef reset_all_health(env):\r\n    health = load_health(env)\r\n    if health:\r\n        save_health(env, {})\r\n\r\ndef append_health_event(env, service, new_state, previous_state):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"HEALTH\",\r\n        \"service\": service,\r\n        \"version\": \"-\",\r\n        \"state\": new_state,\r\n        \"previous_state\": previous_state,\r\n"]
[11410.80885, "o", "    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef get_replica_count(env, service):\r\n    replicas = load_replicas(env)\r\n    return replicas.get(service, 1)\r\n\r\ndef get_env_max(envs, env):\r\n    env_max = envs[env].get('max_replicas')\r\n    if env_max is None:\r\n        return None\r\n    try:\r\n        return int(env_max)\r\n    except (ValueError, TypeError):\r\n        return None\r\n\r\ndef parse_positive_int(s):\r\n    if not isinstance(s, str):\r\n        return None\r\n    if not re.fullmatch('[0-9]+', s):\r\n        return None\r\n    val = int(s)\r\n    if val < 1:\r\n        return None\r\n"]
[11410.80891, "o", "    return val\r\n\r\n\r\ndef event_file(env):\r\n    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n\r\ndef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n    ensure_state()\r\n    ts = now_iso()\r\n    line = f\"{ts} {action} {service} {version}\"\r\n    if action == \"PROMOTE\" and source_env is not None:\r\n        line += f\" from {source_env}\"\r\n        if forced:\r\n            line += \" (forced)\"\r\n    if action == \"RESTORE\" and snapshot_id is not None:\r\n        line += f\" from snapshot #{snapshot_id}\"\r\n"]
[11410.808975, "o", "    line += \"\\n\"\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(line)\r\n\r\ndef append_scale_event(env, service, count, previous):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"SCALE\",\r\n        \"service\": service,\r\n        \"version\": \"-\",\r\n        \"replicas\": count,\r\n        \"previous\": previous,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + chr(10))\r\n\r\ndef load_events(env):\r\n    ensure_state()\r\n    try:\r\n"]
[11410.809054, "o", "        with open(event_file(env)) as f:\r\n            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n    except FileNotFoundError:\r\n        return []\r\n    events = []\r\n    for line in lines:\r\n        if line.startswith('{'):\r\n            continue\r\n        parts = line.split()\r\n        if len(parts) < 4:\r\n            continue\r\n        events.append({\r\n            \"timestamp\": parts[0],\r\n            \"action\": parts[1],\r\n            \"service\": parts[2],\r\n            \"version\": parts[3],\r\n            \"line\": line,\r\n        })\r\n    return events\r\n\r\ndef lock_file(env):\r\n"]
[11410.809125, "o", "    return os.path.join(LOCK_DIR, f\"{env}.json\")\r\n\r\ndef load_lock(env):\r\n    return load_json(lock_file(env), None)\r\n\r\ndef save_lock(env, reason):\r\n    ensure_state()\r\n    existing = load_lock(env)\r\n    locked_since = existing.get('locked_since', now_iso()) if existing else now_iso()\r\n    lock = {\"reason\": reason, \"locked_since\": locked_since}\r\n    save_json(lock_file(env), lock)\r\n\r\ndef remove_lock(env):\r\n    try:\r\n        os.remove(lock_file(env))\r\n    except FileNotFoundError:\r\n        pass\r\n\r\ndef is_locked(env):\r\n    return load_lock(env) is not None\r\n\r\n"]
