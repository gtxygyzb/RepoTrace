[9421.609585, "o", "    timestamp = now_iso()\r\n    snapshot = {\"id\": next_id, \"timestamp\": timestamp, \"services\": state}\r\n    snapshots.append(snapshot)\r\n    save_snapshots(env, snapshots)\r\n    print(f\"SNAPSHOT {env} #{next_id} ({len(state)} services)\")\r\n\r\ndef cmd_restore(args):\r\n    values, flags, positionals = parse_opts(args, set(), set())\r\n    if len(positionals) != 2:\r\n        fail(\"restore requires <environment> <snapshot_id>\")\r\n\r\n    env, snapshot_id_str = positionals\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n    assert_not_locked(env)\r\n    ensure_state()\r\n\r\n    try:\r\n        snapshot_id = int(snapshot_id_str)\r\n    except ValueError:\r\n        fail(\"snapshot id must be an integer\")\r\n\r\n    snapshots = load_snapshots(env)\r\n    snapshot = None\r\n    for snap in snapshots:\r\n        if snap.get(\"id\") == snapshot_id:\r\n            snapshot = snap\r\n            break\r\n    if snapshot is None:\r\n        fail(f\"snapshot not found: #{snapshot_id"]
[9421.609675, "o", "}\")\r\n\r\n    recorded = snapshot.get(\"services\", {})\r\n    state = {}\r\n    for svc, rec in recorded.items():\r\n        state[svc] = dict(rec)\r\n    save_deployment_state(env, state)\r\n\r\n    for svc in sorted(state):\r\n        version = state[svc].get(\"version\", \"\")\r\n        append_event(env, \"RESTORE\", svc, version, snapshot_id=snapshot_id)\r\n        print(f\"RESTORE {svc} -> {env} ({version})\")\r\n    print(f\"Restored {len(state)} services from snapshot #{snapshot_id}\")\r\n\r\ndef cmd_lock(args):\r\n    values, flags, positionals = parse_opts(args, {'--reason'}, {'--list'})\r\n    if '--list' in flags:\r\n        data = load_manifest()\r\n        _, envs = get_services(data)\r\n        ensure_state()\r\n        locked = []\r\n        for env in envs:\r\n            lock = load_lock(env)\r\n            if lock is not None:\r\n                locked.append((env, lock.get('reason', 'manual lock'), lock.get('locked_since', '')))\r\n        for env, reason, since in sorted(locked):\r\n            print(f\"{env}: {reason} (locked since {since})\")\r\n     "]
[9421.609747, "o", "   return\r\n    if len(positionals) != 1:\r\n        fail(\"lock requires <environment> [--reason REASON] or --list\")\r\n    env = positionals[0]\r\n    reason = values.get('--reason', 'manual lock')\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"unknown environment {env}\")\r\n    ensure_state()\r\n    save_lock(env, reason)\r\n    append_lock_event(env, reason)\r\n    print(f\"LOCKED {env}: {reason}\")\r\n\r\ndef cmd_unlock(args):\r\n    values, flags, positionals = parse_opts(args, set(), set())\r\n    if len(positionals) != 1:\r\n        fail(\"unlock requires <environment>\")\r\n    env = positionals[0]\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"unknown environment {env}\")\r\n    ensure_state()\r\n    remove_lock(env)\r\n    append_unlock_event(env)\r\n    print(f\"UNLOCKED {env}\")\r\n\r\ndef cmd_config(args):\r\n    if not args:\r\n        fail(\"config requires a subcommand\")\r\n    sub = args[0]\r\n"]
