[11410.224576, "o", "\u001b[32m\u001b[K1084\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                entries.append((iso, svc, f\"{iso} SCALE {svc} from {ev.get('previous', '-')} to {ev.get('\u001b[01;31m\u001b[Kreplicas\u001b[m\u001b[K', '-')} \u001b[01;31m\u001b[Kreplicas\u001b[m\u001b[K\"))\r\n\u001b[32m\u001b[K1103\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kprint_tree(node, services, path, depth):\r\n\u001b[32m\u001b[K1112\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_graph(args):\r\n\u001b[32m\u001b[K1136\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_bump(args):\r\n\u001b[32m\u001b[K1167\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksnapshot_file(env):\r\n\u001b[32m\u001b[K1170\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_snapshots(env):\r\n"]
