[14611.215465, "o", "> "]
[14611.215532, "o", "if \"elif cmd == 'audit':\" not in s:\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.215587, "o", "> "]
[14611.216054, "o", "    s = s.replace(\"    elif cmd == 'clone':\\n        cmd_clone(args)\\n\", \"    elif cmd == 'clone':\\n        cmd_clone(args)\\n    elif cmd == 'audit':\\n        cmd_audit(args)\\n\", 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
