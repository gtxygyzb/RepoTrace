[8521.298612, "o", "    services, envs = get_services(data)\r\n\u001b[?2004l\r"]
[8521.298668, "o", "\u001b[?2004h> "]
[8521.298801, "o", "    if env not in envs:\r\n\u001b[?2004l\r"]
[8521.298849, "o", "\u001b[?2004h> "]
[8521.299141, "o", "        fail(f\"unknown environment '{env}'\")\r\n\u001b[?2004l\r"]
[8521.299197, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8521.299254, "o", "\u001b[?2004h> "]
[8521.299379, "o", "    rest = args[1:]\r\n\u001b[?2004l\r"]
[8521.299444, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[8521.299504, "o", "> "]
[8521.299683, "o", "    if rest and rest[0] == '--all':\r\n\u001b[?2004l\r"]
[8521.299738, "o", "\u001b[?2004h> "]
[8521.299907, "o", "        if len(rest) != 2:\r\n\u001b[?2004l\r"]
[8521.299963, "o", "\u001b[?2004h> "]
[8521.300278, "o", "            fail(\"scale <environment> --all <count>\")\r\n\u001b[?2004l\r"]
[8521.300347, "o", "\u001b[?2004h> "]
[8521.300502, "o", "        count_str = rest[1]\r\n\u001b[?2004l\r"]
[8521.300558, "o", "\u001b[?2004h> "]
[8521.300821, "o", "        count = parse_positive_int(count_str)\r\n\u001b[?2004l\r"]
[8521.300876, "o", "\u001b[?2004h> "]
[8521.301023, "o", "        if count is None:\r\n\u001b[?2004l\r"]
[8521.301079, "o", "\u001b[?2004h> "]
[8521.301412, "o", "            fail(f\"invalid replica count '{count_str}'\")\r\n\u001b[?2004l\r"]
[8521.301469, "o", "\u001b[?2004h> "]
[8521.301598, "o", "        ensure_state()\r\n\u001b[?2004l\r"]
[8521.301656, "o", "\u001b[?2004h> "]
[8521.301898, "o", "        state = load_deployment_state(env)\r\n\u001b[?2004l\r"]
[8521.301953, "o", "\u001b[?2004h> "]
[8521.302078, "o", "        if not state:\r\n\u001b[?2004l\r"]
[8521.302133, "o", "\u001b[?2004h> "]
[8521.302434, "o", "            fail(f\"no services deployed in {env}\")\r\n\u001b[?2004l\r"]
[8521.302492, "o", "\u001b[?2004h> "]
[8521.302727, "o", "        env_max = get_env_max(envs, env)\r\n\u001b[?2004l\r"]
[8521.302791, "o", "\u001b[?2004h> "]
[8521.303079, "o", "        if env_max is not None and count > env_max:\r\n\u001b[?2004l\r"]
[8521.303181, "o", "\u001b[?2004h> "]
[8521.303556, "o", "            fail(f\"{count} exceeds max_replicas ({env_max}) for {env}\")\r\n\u001b[?2004l\r"]
[8521.303671, "o", "\u001b[?2004h> "]
[8521.303799, "o", "        bounds = load_bounds(env)\r\n\u001b[?2004l\r"]
[8521.303856, "o", "\u001b[?2004h> "]
[8521.304094, "o", "        replicas = load_replicas(env)\r\n\u001b[?2004l\r"]
[8521.304157, "o", "\u001b[?2004h> "]
[8521.304363, "o", "        for s in sorted(state):\r\n\u001b[?2004l\r"]
[8521.30442, "o", "\u001b[?2004h> "]
[8521.304657, "o", "            svc_bounds = bounds.get(s)\r\n\u001b[?2004l\r"]
[8521.304713, "o", "\u001b[?2004h> "]
[8521.304864, "o", "            if svc_bounds:\r\n\u001b[?2004l\r"]
[8521.304919, "o", "\u001b[?2004h> "]
[8521.305146, "o", "                bmin, bmax = svc_bounds\r\n\u001b[?2004l\r"]
[8521.305204, "o", "\u001b[?2004h> "]
[8521.30549, "o", "                if count < bmin or count > bmax:\r\n\u001b[?2004l\r"]
[8521.305548, "o", "\u001b[?2004h> "]
[8521.306071, "o", "                    fail(f\"{count} violates bounds [{bmin}..{bmax}] for {s} in {env}\")\r\n\u001b[?2004l\r"]
[8521.30613, "o", "\u001b[?2004h> "]
[8521.306309, "o", "        assert_not_locked(env)\r\n\u001b[?2004l\r"]
[8521.306385, "o", "\u001b[?2004h> "]
[8521.306555, "o", "        for s in sorted(state):\r\n\u001b[?2004l\r"]
[8521.306612, "o", "\u001b[?2004h> "]
[8521.306849, "o", "            previous = replicas.get(s, 1)\r\n\u001b[?2004l\r"]
[8521.306905, "o", "\u001b[?2004h> "]
[8521.307105, "o", "            replicas[s] = count\r\n\u001b[?2004l\r"]
[8521.307162, "o", "\u001b[?2004h> "]
[8521.307497, "o", "            append_scale_event(env, s, count, previous)\r\n\u001b[?2004l\r"]
[8521.307554, "o", "\u001b[?2004h> "]
[8521.307992, "o", "            print(f\"SCALED {env}/{s} to {count} replicas (was {previous})\")\r\n\u001b[?2004l\r"]
[8521.308053, "o", "\u001b[?2004h> "]
[8521.308198, "o", "        save_replicas(env, replicas)\r\n\u001b[?2004l\r"]
[8521.308254, "o", "\u001b[?2004h> "]
[8521.308509, "o", "        print(f\"Scaled {len(state)} services to {count} replicas\")\r\n\u001b[?2004l\r"]
[8521.308568, "o", "\u001b[?2004h> "]
[8521.308625, "o", "        return\r\n\u001b[?2004l\r\"\u001b[?2004h> \r\n\u001b[?2004l\r)"]
[8521.308682, "o", "\u001b[?2004h> "]
[8521.308747, "o", "    if not rest:\r\n\u001b[?2004l\r\u001b[?2004h"]
[8521.308803, "o", "> "]
[8521.308878, "o", "        ensure_state()\r\n\u001b[?2004l\r"]
[8521.308934, "o", "\u001b[?2004h> "]
[8521.309076, "o", "        state = load_deployment_state(env)\r\n\u001b[?2004l\r"]
[8521.309132, "o", "\u001b[?2004h> "]
[8521.309272, "o", "        replicas = load_replicas(env)\r\n\u001b[?2004l\r"]
[8521.309339, "o", "\u001b[?2004h> "]
[8521.309428, "o", "        for s in sorted(state):\r\n\u001b[?2004l\r"]
[8521.309497, "o", "\u001b[?2004h> "]
[8521.309684, "o", "            print(f\"{s}: {replicas.get(s, 1)} replicas\")\r\n\u001b[?2004l\r"]
[8521.309739, "o", "\u001b[?2004h> "]
[8521.309802, "o", "        return\r\n\u001b[?2004l\r"]
[8521.30986, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.309967, "o", "    service = rest[0]\r\n\u001b[?2004l\r"]
[8521.310023, "o", "\u001b[?2004h> "]
[8521.310127, "o", "    if service not in services:\r\n\u001b[?2004l\r"]
[8521.310205, "o", "\u001b[?2004h> "]
[8521.310356, "o", "        fail(f\"unknown service '{service}'\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[8521.310414, "o", "> \r\n\u001b[?2004l\rT\u001b[?2004h> "]
[8521.310616, "o", "    if len(rest) >= 2 and rest[1] == '--bounds':\r\n\u001b[?2004l\r"]
[8521.310672, "o", "\u001b[?2004h> "]
