[12639.954143, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('pipeline.sh')\ns = p.read_text()\nold = \"\"\"    quotas = load_quotas(env)\n    max_services_limit = quotas.get('max_services')\n    if max_services_limit is not None:\n        state = load_deployment_state(env)\n        for s in order:\n            if s not in state:\n                current = len(state)\n                if current + 1 > max_services_limit:\n                    fail(f\"deploying {s} would exceed max_services quota ({current + 1}/{max_services_limit}) in {env}\")\n\n    if dry_run:\n\"\"\"\nnew = \"\"\"    quotas = load_quotas(env)\n    max_services_limit = quotas.get('max_services')\n\n    if dry_run:\n\"\"\"\nassert old in s\ns = s.replace(old, new)\n\nold2 = \"\"\"        version = read_artifact(services[s])\n        if version is None:\n            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\n            any_fail = True\n            break\n\n        state[s] = {\"version\": version, \"deployed_at\": now_iso()}\n\"\"\"\nnew2 = \"\"\"        version = read_artifact(services[s])\n      "]
