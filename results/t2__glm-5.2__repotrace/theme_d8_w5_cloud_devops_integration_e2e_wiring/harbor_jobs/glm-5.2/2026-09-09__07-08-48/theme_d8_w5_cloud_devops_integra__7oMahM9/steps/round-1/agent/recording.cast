[11447.680858, "o", "   900\t            return 1 if ta > tb else -1\r\n   901\t        return 0\r\n   902\t    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)\r\n   903\tdef cmd_promote(args):\r\n   904\t    values, flags, positionals = parse_opts(args, {\"--service\"}, {\"--dry-run\", \"--force\"})\r\n   905\t    if len(positionals) != 2:\r\n   906\t        fail(\"promote requires <source-env> <target-env>\")\r\n   907\t\r\n   908\t    source, target = positionals\r\n   909\t    service = values.get(\"--service\")\r\n"]
[11447.680977, "o", "   910\t    dry_run = \"--dry-run\" in flags\r\n   911\t    force = \"--force\" in flags\r\n   912\t\r\n   913\t    data = load_manifest()\r\n   914\t    services, envs = get_services(data)\r\n   915\t\r\n   916\t    if source not in envs:\r\n   917\t        fail(f\"environment not found: {source}\")\r\n   918\t    if target not in envs:\r\n   919\t        fail(f\"environment not found: {target}\")\r\n   920\t\r\n   921\t    assert_not_locked(target)\r\n   922\t\r\n   923\t    if service:\r\n   924\t        subset = transitive_deps(services, service)\r\n   925\t    else:\r\n   926\t        subset = set(services.keys())\r\n   927\t\r\n   928\t    ensure_state()\r\n   929\t    source_state = load_deployment_state(source)\r\n   930"]
[11447.681053, "o", "\t    target_state = load_deployment_state(target)\r\n   931\t    target_replicas = load_replicas(target)\r\n   932\t\r\n   933\t    candidates = {s for s in source_state if s in subset and s in services}\r\n   934\t    order = topo_order(services, candidates)\r\n   935\t\r\n   936\t    for s in sorted(order):\r\n   937\t        if get_health_state(source, s) == \"unhealthy\":\r\n   938\t            fail(f\"cannot promote unhealthy service '{s}' from {source}\")\r\n   939\t\r\n   940\t    if dry_run:\r\n   941\t        print(f\"DRY-RUN promote from {source} to {target}:\")\r\n   942\t        for s in order:\r\n"]
[11447.681123, "o", "   943\t            src_version = source_state[s].get(\"version\")\r\n   944\t            tgt_version = target_state.get(s, {}).get(\"version\")\r\n   945\t            if src_version == tgt_version:\r\n   946\t                continue\r\n   947\t            src_sv = extract_semver(src_version)\r\n   948\t            tgt_sv = extract_semver(tgt_version)\r\n   949\t            if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:\r\n   950\t                print(f\"  Would conflict {s} (downgrade)\")\r\n   951\t            else:\r\n   952\t                print(f\"  Would promote {s}\")\r\n   953\t        return\r\n"]
