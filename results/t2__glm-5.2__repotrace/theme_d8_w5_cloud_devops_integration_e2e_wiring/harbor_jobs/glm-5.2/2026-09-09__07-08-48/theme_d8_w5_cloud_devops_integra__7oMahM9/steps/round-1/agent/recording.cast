[14124.689764, "o", "\u001b[32m\u001b[K697\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd\u001b[m\u001b[K_order(args):\r\n\u001b[32m\u001b[K705\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd\u001b[m\u001b[K_build(args):\r\n\u001b[32m\u001b[K752\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd\u001b[m\u001b[K_test(args):\r\n"]
[14124.689817, "o", "\u001b[32m\u001b[K789\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd\u001b[m\u001b[K_deploy(args):\r\n\u001b[32m\u001b[K804\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    assert_not_\u001b[01;31m\u001b[Klock\u001b[m\u001b[Ked(env)\r\n"]
[14124.689874, "o", "\u001b[32m\u001b[K814\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks = load_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks(env)\r\n\u001b[32m\u001b[K815\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    max_services_limit = \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks.get('max_services')\r\n\u001b[32m\u001b[K827\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    deployed_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[Ks = []\r\n\u001b[32m\u001b[K845\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                fail(f\"deploying {s} would exceed max_services \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K ({current + 1}/{max_services_limit}) in {env}\")\r\n"]
[14124.689928, "o", "\u001b[32m\u001b[K849\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        deployed_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[Ks.append((s, version))\r\n\u001b[32m\u001b[K854\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    for s, version in deployed_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[Ks:\r\n\u001b[32m\u001b[K856\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    for s, version in deployed_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[Ks:\r\n\u001b[32m\u001b[K857\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        append_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K(env, \"DEPLOY\", s, version)\r\n"]
[14124.68998, "o", "\u001b[32m\u001b[K861\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd\u001b[m\u001b[K_\u001b[01;31m\u001b[Kstatus\u001b[m\u001b[K(args):\r\n\u001b[32m\u001b[K863\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fail(\"\u001b[01;31m\u001b[Kstatus\u001b[m\u001b[K takes at most one environment argument\")\r\n\u001b[32m\u001b[K872\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Klock\u001b[m\u001b[K = load_\u001b[01;31m\u001b[Klock\u001b[m\u001b[K(env)\r\n"]
