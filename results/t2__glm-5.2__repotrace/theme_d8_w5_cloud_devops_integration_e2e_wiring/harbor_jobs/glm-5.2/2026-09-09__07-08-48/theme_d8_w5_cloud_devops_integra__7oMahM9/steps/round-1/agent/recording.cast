[13423.540756, "o", "\r\n   465\t    save_json(quota_file(env), quotas)\r\n   466\t\r\n   467\tdef quota_supported_resources():\r\n   468\t    return ['max_services', 'max_total_replicas']\r\n   469\t\r\n   470\tdef validate_quota_resource(resource):\r\n   471\t    if resource not in quota_supported_resources():\r\n   472\t        fail(f\"unknown quota resource '{resource}' (must be max_services or max_total_replicas)\")\r\n   473\t\r\n   474\tdef quota_current_usage(env, resource):\r\n   475\t    state = load_deployment_state(env)\r\n   476\t    replicas = load_replicas(env)\r\n   477\t    if resource == 'max_services':\r\n"]
