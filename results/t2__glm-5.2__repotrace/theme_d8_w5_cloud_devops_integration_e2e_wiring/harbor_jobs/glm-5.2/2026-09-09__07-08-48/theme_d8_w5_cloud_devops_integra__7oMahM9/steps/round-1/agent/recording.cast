[4276.521452, "o", "APP_DIR = '/app'\r\nMANIFEST_PATH = '/app/pipeline.yaml'\r\nSTATE_DIR = '/app/.pipeline'\r\nTEST_RESULTS_PATH = os.path.join(STATE_DIR, 'test_results.json')\r\nDEPLOYMENTS_DIR = os.path.join(STATE_DIR, 'deployments')\r\nEVENTS_DIR = os.path.join(STATE_DIR, 'events')\r\nSNAPSHOTS_DIR = os.path.join(STATE_DIR, 'snapshots')\r\n\r\nSERVICE_FIELDS = ['version', 'path', 'build_cmd', 'test_cmd', 'port', 'depends_on', 'health_endpoint']\r\nENV_FIELDS = ['deploy_target', 'health_check_port', 'max_replicas']\r\n"]
[4276.521565, "o", "\r\ndef ensure_state():\r\n    os.makedirs(STATE_DIR, exist_ok=True)\r\n    os.makedirs(DEPLOYMENTS_DIR, exist_ok=True)\r\n    os.makedirs(EVENTS_DIR, exist_ok=True)\r\n"]
[4276.522158, "o", "\u001b[?2004h"]
[4276.522218, "o", "root@n30009:/app# "]
[4276.803977, "i", "sed -n '241,300p' pipeline.sh\n"]
[4276.804242, "o", "sed -n '241,300p' pipeline.sh\r\n\u001b[?2004l\r"]
[4276.807278, "o", "    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n\r\ndef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n    ensure_state()\r\n    ts = now_iso()\r\n    line = f\"{ts} {action} {service} {version}\"\r\n    if action == \"PROMOTE\" and source_env is not None:\r\n        line += f\" from {source_env}\"\r\n        if forced:"]
[4276.807398, "o", "\r\n            line += \" (forced)\"\r\n    if action == \"RESTORE\" and snapshot_id is not None:\r\n        line += f\" from snapshot #{snapshot_id}\"\r\n    line += \"\\n\"\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(line)\r\n\r\ndef load_events(env):\r\n    ensure_state()\r\n"]
[4276.807467, "o", "    try:\r\n        with open(event_file(env)) as f:\r\n            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n    except FileNotFoundError:\r\n        return []\r\n    events = []\r\n    for line in lines:\r\n        parts = line.split()\r\n        if len(parts) < 4:\r\n            continue\r\n        events.append({\r\n            \"timestamp\": parts[0],\r\n            \"action\": parts[1],\r\n            \"service\": parts[2],\r\n            \"version\": parts[3],\r\n            \"line\": line,\r\n        })\r\n    return events\r\n\r\ndef find_rollback_target(env, service, current_version, to_version=None):\r\n    events = load_events(env)\r\n\r\n    if to_version is not None:\r\n        for ev in reversed(events):\r\n            if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] == to_version:\r\n                return to_version\r\n        fail(f\"version not found in history for {service}\")\r\n"]
[4276.807511, "o", "\r\n    current_indices = [\r\n        idx for idx, ev in enumerate(events)\r\n        if ev[\"service\"] == service\r\n        and ev[\"version\"] == current_version\r\n        and not (ev[\"action\"] == \"ROLLBACK\" and ev[\"version\"] == \"-\")\r\n    ]\r\n    if not current_indices:\r\n"]
[4276.807603, "o", "        return None\r\n    current_idx = current_indices[-1]\r\n\r\n    for ev in reversed(events[:current_idx]):\r\n        if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\":\r\n            return ev[\"version\"]\r\n    return None\r\n"]
[4276.808179, "o", "\u001b[?2004h"]
