[4312.801933, "o", "   809\tdef snapshot_file(env):\r\n   810\t    return os.path.join(SNAPSHOTS_DIR, f\"{env}.json\")\r\n   811\t\r\n   812\tdef load_snapshots(env):\r\n   813\t    return load_json(snapshot_file(env), [])\r\n"]
[4312.802055, "o", "   814\t\r\n   815\tdef save_snapshots(env, snapshots):\r\n   816\t    save_json(snapshot_file(env), snapshots)\r\n   817\t\r\n   818\tdef cmd_snapshot(args):\r\n   819\t    values, flags, positionals = parse_opts(args, set(), {\"--list\"})\r\n   820\t    if len(positionals) != 1:\r\n   821\t        fail(\"snapshot requires an environment\")\r\n   822\t\r\n   823\t    env = positionals[0]\r\n   824\t    data = load_manifest()\r\n   825\t    _, envs = get_services(data)\r\n   826\t    if env not in envs:\r\n   827\t        fail(f\"environment not found: {env}\")\r\n   828\t    ensure_state()\r\n   829\t\r\n   830\t    if \"--list\" in flags:\r\n   831\t        snapshots = load_snapshots(env)\r\n"]
[4312.802126, "o", "   832\t        for snap in snapshots:\r\n   833\t            services = snap.get(\"services\", {})\r\n   834\t            print(f\"#{snap.get('id', '?')} {snap.get('timestamp', '')} ({len(services)} services)\")\r\n   835\t        return\r\n   836\t\r\n   837\t    state = load_deployment_state(env)\r\n   838\t    snapshots = load_snapshots(env)\r\n   839\t    next_id = 1\r\n   840\t    for snap in snapshots:\r\n   841\t        if isinstance(snap.get(\"id\"), int) and snap[\"id\"] >= next_id:\r\n   842\t            next_id = snap[\"id\"] + 1\r\n   843\t    timestamp = now_iso()\r\n   844"]
[4312.802188, "o", "\t    snapshot = {\"id\": next_id, \"timestamp\": timestamp, \"services\": state}\r\n   845\t    snapshots.append(snapshot)\r\n   846\t    save_snapshots(env, snapshots)\r\n   847\t    print(f\"SNAPSHOT {env} #{next_id} ({len(state)} services)\")\r\n   848\t\r\n"]
