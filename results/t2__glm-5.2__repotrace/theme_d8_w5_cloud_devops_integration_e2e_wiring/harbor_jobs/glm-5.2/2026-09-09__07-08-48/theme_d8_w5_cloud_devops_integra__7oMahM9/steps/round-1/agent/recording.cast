[7510.120509, "o", "   238\tdef deployment_file(env):\r\n   239\t    return os.path.join(DEPLOYMENTS_DIR, f\"{env}.json\")\r\n   240\t\r\n   241\tdef load_deployment_state(env):\r\n   242\t    return load_json(deployment_file(env), {})"]
[7510.120595, "o", "\r\n   243\t\r\n   244\tdef save_deployment_state(env, state):\r\n   245\t    save_json(deployment_file(env), state)\r\n   246\t\r\n   247\tdef event_file(env):\r\n   248\t    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n   249\t\r\n   250\tdef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n   251\t    ensure_state()\r\n   252\t    ts = now_iso()\r\n   253\t    line = f\"{ts} {action} {service} {version}\"\r\n   254\t    if action == \"PROMOTE\" and source_env is not None:\r\n   255\t        line += f\" from {source_env}\"\r\n"]
[7510.120668, "o", "   256\t        if forced:\r\n   257\t            line += \" (forced)\"\r\n   258\t    if action == \"RESTORE\" and snapshot_id is not None:\r\n   259\t        line += f\" from snapshot #{snapshot_id}\"\r\n   260\t    line += \"\\n\"\r\n   261\t    with open(event_file(env), \"a\") as f:\r\n   262\t        f.write(line)\r\n"]
[7510.120732, "o", "   263\t\r\n   264\tdef load_events(env):\r\n   265\t    ensure_state()\r\n   266\t    try:\r\n   267\t        with open(event_file(env)) as f:\r\n   268\t            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n   269\t    except FileNotFoundError:\r\n   270\t        return []\r\n   271\t    events = []\r\n   272\t    for line in lines:\r\n   273\t        if line.startswith('{'):\r\n   274\t            continue\r\n   275\t        parts = line.split()\r\n   276\t        if len(parts) < 4:\r\n   277\t            continue\r\n"]
[7510.120797, "o", "   278\t        events.append({\r\n   279\t            \"timestamp\": parts[0],\r\n   280\t            \"action\": parts[1],\r\n   281\t            \"service\": parts[2],\r\n   282\t            \"version\": parts[3],\r\n   283\t            \"line\": line,\r\n   284\t        })\r\n   285\t    return events\r\n   286\t\r\n   287\tdef lock_file(env):\r\n   288\t    return os.path.join(LOCK_DIR, f\"{env}.json\")\r\n"]
[7510.12087, "o", "   289\t\r\n   290\tdef load_lock(env):\r\n   291\t    return load_json(lock_file(env), None)\r\n   292\t\r\n   293\tdef save_lock(env, reason):\r\n   294\t    ensure_state()\r\n   295\t    existing = load_lock(env)\r\n   296\t    locked_since = existing.get('locked_since', now_iso()) if existing else now_iso()\r\n   297\t    lock = {\"reason\": reason, \"locked_since\": locked_since}\r\n   298\t    save_json(lock_file(env), lock)\r\n   299\t"]
[7510.120929, "o", "\r\n   300\tdef remove_lock(env):\r\n   301\t    try:\r\n   302\t        os.remove(lock_file(env))\r\n   303\t    except FileNotFoundError:\r\n   304\t        pass\r\n   305\t\r\n   306\tdef is_locked(env):\r\n   307\t    return load_lock(env) is not None\r\n"]
[7510.120993, "o", "   308\t\r\n   309\tdef assert_not_locked(env):\r\n   310\t    lock = load_lock(env)\r\n   311\t    if lock is not None:\r\n   312\t        fail(f\"{env} is locked ({lock.get('reason', 'manual lock')})\")\r\n   313\t\r\n   314\tdef append_lock_event(env, reason):\r\n   315\t    ensure_state()\r\n   316\t    event = {\r\n"]
[7510.121064, "o", "   317\t        \"timestamp\": int(time.time()),\r\n   318\t        \"iso_timestamp\": now_iso(),\r\n   319\t        \"action\": \"LOCK\",\r\n   320\t        \"service\": \"-\",\r\n   321\t        \"version\": \"-\",\r\n   322\t        \"reason\": reason,\r\n   323\t    }\r\n   324\t    with open(event_file(env), \"a\") as f:\r\n   325\t        f.write(json.dumps(event) + \"\\n\")\r\n   326\t\r\n"]
[7510.121122, "o", "   327\tdef append_unlock_event(env):\r\n   328\t    ensure_state()\r\n   329\t    event = {\r\n   330\t        \"timestamp\": int(time.time()),\r\n   331\t        \"iso_timestamp\": now_iso(),\r\n   332\t        \"action\": \"UNLOCK\",\r\n   333\t        \"service\": \"-\",\r\n   334\t        \"version\": \"-\",\r\n   335\t    }\r\n"]
[7510.121179, "o", "   336\t    with open(event_file(env), \"a\") as f:\r\n   337\t        f.write(json.dumps(event) + \"\\n\")\r\n   338\t\r\n   339\tdef assert_env_exists(env):\r\n   340\t    data = load_manifest()\r\n"]
