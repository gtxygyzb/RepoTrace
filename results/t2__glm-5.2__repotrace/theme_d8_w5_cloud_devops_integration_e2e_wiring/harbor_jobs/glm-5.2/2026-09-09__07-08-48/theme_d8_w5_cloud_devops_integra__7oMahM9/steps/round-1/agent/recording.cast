[13309.990245, "o", "\r\n    current_idx = None\r\n    for idx, ev in enumerate(events):\r\n        if ev[\"service\"] != service:\r\n            continue\r\n        if ev[\"version\"] != current_version:\r\n            continue\r\n        if ev[\"action\"] == \"ROLLBACK\" and ev[\"version\"] == \"-\":\r\n            continue\r\n        current_idx = idx\r\n\r\n    if current_idx is None:\r\n        return None\r\n\r\n    for ev in reversed(events[:current_idx]):\r\n        if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] != current_version:\r\n"]
