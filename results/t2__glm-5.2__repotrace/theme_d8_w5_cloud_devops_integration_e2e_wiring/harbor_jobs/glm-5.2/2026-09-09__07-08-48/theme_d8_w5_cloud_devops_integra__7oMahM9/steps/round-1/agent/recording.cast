[3076.789483, "o", "\r\n    in_degree = {s: 0 for s in subset}\r\n    adj = {s: [] for s in subset}\r\n\r\n    for s in subset:\r\n        for dep in services[s].get('depends_on', []):\r\n            if dep in subset:\r\n                adj[dep].append(s)\r\n                in_degree[s] += 1\r\n\r\n    waves = []\r\n    available = sorted([s for s in subset if in_degree[s] == 0])\r\n    while available:\r\n        waves.append(available)\r\n        next_available = []\r\n        for s in available:\r\n            for dependent in sorted(adj[s]):\r\n                in_degree[dependent] -= 1\r\n                if in_degree[dependent] == 0:\r\n                    next_available.append(dependent)\r\n        available = sorted(next_available)\r\n\r\n    if sum(len(w) for w in waves) != len(subset):\r\n        fail(\"circular dependency detected\")\r\n"]
[3076.789568, "o", "    return waves\r\n\r\ndef transitive_deps(services, name):\r\n    if name not in services:\r\n        fail(f\"service not found: {name}\")\r\n    result = set()\r\n    stack = [name]\r\n    while stack:\r\n        s = stack.pop()\r\n        if s not in result:\r\n            result.add(s)\r\n            for dep in services[s].get('depends_on', []):\r\n                if dep not in services:\r\n                    fail(f\"service {s} depends on undefined service: {dep}\")\r\n                stack.append(dep)\r\n    return result\r\n\r\ndef service_path(svc):\r\n"]
[3076.789639, "o", "    p = svc.get('path', '')\r\n    if os.path.isabs(p):\r\n        return p\r\n    return os.path.join(APP_DIR, p)\r\n\r\ndef artifact_path(svc):\r\n    return os.path.join(service_path(svc), 'build', 'artifact.txt')\r\n\r\ndef read_artifact(svc):\r\n    try:\r\n        with open(artifact_path(svc)) as f:\r\n            return f.read().strip()\r\n    except FileNotFoundError:\r\n        return None\r\n\r\ndef deployment_file(env):\r\n"]
[3076.789723, "o", "    return os.path.join(DEPLOYMENTS_DIR, f\"{env}.json\")\r\n\r\ndef load_deployment_state(env):\r\n    return load_json(deployment_file(env), {})\r\n\r\ndef save_deployment_state(env, state):\r\n    save_json(deployment_file(env), state)\r\n\r\ndef event_file(env):\r\n    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n\r\ndef append_event(env, action, service, version, source_env=None):\r\n    ensure_state()\r\n    ts = now_iso()\r\n    line = f\"{ts} {action} {service} {version}\"\r\n    if action == \"PROMOTE\" and source_env is not None:\r\n        line += f\" from {source_env}\"\r\n    line += \"\\n\"\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(line)\r\n"]
[3076.789807, "o", "\r\ndef parse_opts(args, value_opts, flag_opts):\r\n    values = {}\r\n    flags = set()\r\n    positionals = []\r\n    i = 0\r\n    while i < len(args):\r\n        a = args[i]\r\n        if a in value_opts:"]
[3076.789899, "o", "\r\n            i += 1\r\n            if i >= len(args):\r\n                fail(f\"{a} requires a value\")\r\n            values[a] = args[i]\r\n        elif a in flag_opts:\r\n            flags.add(a)\r\n        elif a.startswith('--'):\r\n            fail(f\"unknown option: {a}\")\r\n        else:\r\n            positionals.append(a)\r\n        i += 1\r\n    return values, flags, positionals\r\n\r\ndef cmd_validate(args):\r\n    if args:\r\n        fail(\"validate takes no arguments\")\r\n    data = load_manifest()\r\n    try:\r\n        validate_manifest(data)\r\n    except ValueError as e:\r\n        print(f\"ERROR: {e}\")\r\n"]
[3076.789974, "o", "        sys.exit(1)\r\n    print(\"VALID\")\r\n\r\ndef cmd_order(args):\r\n    if args:\r\n        fail(\"order takes no arguments\")\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n    for s in topo_order(services):\r\n"]
[3076.790065, "o", "        print(s)\r\n\r\ndef cmd_build(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--parallel'})\r\n    if positionals:\r\n        fail(\"build does not accept positional arguments\")\r\n\r\n    service = values.get('--service')\r\n    parallel = '--parallel' in flags\r\n\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n\r\n    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n\r\n    if parallel:\r\n        for wave in build_waves(services, subset):\r\n            print(\",\".join(wave))\r\n        return\r\n\r\n    order = topo_order(services, subset)\r\n    any_fail = False\r\n    for s in order:\r\n        svc = services[s]\r\n        path = service_path(svc)\r\n        if not os.path.isdir(path):\r\n            print(f\"BUILD {s} FAIL: service path does not exist\")"]
