[14276.698861, "o", "\t    port_map = {}\r\n   110\t    for name, svc in services.items():\r\n   111\t        port = svc['port']\r\n   112\t        if port in port_map:\r\n   113\t            raise ValueError(f\"duplicate port assignment: {port}\")\r\n   114\t        port_map[port] = name\r\n   115\t\r\n   116\t    cycle = find_cycle(services)\r\n   117\t    if cycle:\r\n   118\t        raise ValueError(f\"circular dependency detected: {' -> '.join(cycle)}\")\r\n   119\t\r\n   120\t    return True\r\n   121\t\r\n   122\tdef find_cycle(services):\r\n"]
