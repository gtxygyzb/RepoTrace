[11447.109484, "o", "    if not isinstance(services, dict) or not services:\r\n    80\t        raise ValueError(\"manifest missing services\")\r\n    81\t\r\n    82\t    environments = data.get('environments')\r\n    83\t    if not isinstance(environments, dict) or not environments:\r\n    84\t        raise ValueError(\"manifest missing environments\")\r\n    85\t\r\n    86\t    for env_name, env in environments.items():\r\n    87\t        if not isinstance(env, dict):\r\n    88\t            raise ValueError(f\"environment {env_name} must be a mapping\")\r\n    89\t        for field in ENV_FIELDS:\r\n    90\t            if field not in env:\r\n    91\t                raise ValueError(f\"environment {env_name} missing required field: {field}\")\r\n    92\t\r\n"]
[11447.109571, "o", "    93\t    for name, svc in services.items():\r\n    94\t        if not isinstance(svc, dict):\r\n    95\t            raise ValueError(f\"service {name} must be a mapping\")\r\n    96\t        for field in SERVICE_FIELDS:\r\n    97\t            if field not in svc:\r\n    98\t                raise ValueError(f\"service {name} missing required field: {field}\")\r\n    99\t        if not isinstance(svc['depends_on'], list):\r\n   100\t            raise ValueError(f\"service {name} has invalid depends_on: must be a list\")\r\n   101\t        for dep in svc['depends_on']:\r\n   102\t            if dep not in services:\r\n   103\t                raise ValueError(f\"service {name} depends on undefined service: {dep}\")\r\n   104\t"]
[11447.109636, "o", "        if not valid_version(svc.get('version')):\r\n   105\t            raise ValueError(f\"service {name} has invalid version: expected N.N.N\")\r\n   106\t\r\n   107\t    port_map = {}\r\n   108\t    for name, svc in services.items():\r\n   109\t        port = svc['port']\r\n   110\t        if port in port_map:\r\n   111\t            raise ValueError(f\"duplicate port assignment: {port}\")\r\n   112\t        port_map[port] = name\r\n   113\t\r\n   114\t    cycle = find_cycle(services)\r\n"]
