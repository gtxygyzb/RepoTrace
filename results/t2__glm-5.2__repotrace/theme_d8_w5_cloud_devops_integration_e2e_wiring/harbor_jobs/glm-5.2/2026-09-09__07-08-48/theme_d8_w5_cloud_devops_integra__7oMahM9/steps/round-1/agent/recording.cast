[3403.992218, "o", "\u001b[?2004h> "]
[3403.992461, "o", "        fail(f\"unknown command: {cmd}\")\r\n\u001b[?2004l\r"]
[3403.992529, "o", "\u001b[?2004h> "]
[3403.992586, "o", "\"\"\",\r\n\u001b[?2004l\r"]
[3403.992641, "o", "\u001b[?2004h> "]
[3403.99287, "o", "        \"\"\"    elif cmd == 'graph':\r\n\u001b[?2004l\r"]
[3403.992933, "o", "\u001b[?2004h> "]
[3403.993072, "o", "        cmd_graph(args)\r\n\u001b[?2004l\r"]
