[4826.798033, "o", "   588\t        tb = version_build_timestamp(b)\r\n   589\t        if ta is not None and tb is not None and ta != tb:\r\n   590\t            return 1 if ta > tb else -1\r\n   591\t        return 0\r\n   592\t    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)\r\n   593\tdef cmd_promote(args):\r\n   594\t    values, flags, positionals = parse_opts(args, {\"--service\"}, {\"--dry-run\", \"--force\"})\r\n   595\t"]
