[11381.909059, "o", "\r\ndef parse_opts(args, value_opts, flag_opts):\r\n    values = {}\r\n    flags = set()\r\n    positionals = []\r\n    i = 0\r\n    while i < len(args):\r\n        a = args[i]\r\n"]
[11381.90916, "o", "        if a in value_opts:\r\n            i += 1\r\n            if i >= len(args):\r\n                fail(f\"{a} requires a value\")\r\n            values[a] = args[i]\r\n        elif a in flag_opts:\r\n            flags.add(a)\r\n        elif a.startswith('--'):\r\n            fail(f\"unknown option: {a}\")\r\n        else:\r\n            positionals.append(a)\r\n        i += 1\r\n    return values, flags, positionals\r\n\r\ndef cmd_validate(args):\r\n    if args:\r\n        fail(\"validate takes no arguments\")\r\n    data = load_manifest()\r\n    try:\r\n        validate_manifest(data)\r\n    except ValueError as e:\r\n"]
[11381.909253, "o", "        print(f\"ERROR: {e}\")\r\n        sys.exit(1)\r\n    print(\"VALID\")\r\n\r\ndef cmd_order(args):\r\n    if args:\r\n        fail(\"order takes no arguments\")\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n    for s in topo_order(services):\r\n        print(s)\r\n\r\ndef cmd_build(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--parallel'})\r\n    if positionals:\r\n        fail(\"build does not accept positional arguments\")\r\n\r\n    service = values.get('--service')\r\n    parallel = '--parallel' in flags\r\n"]
[11381.909373, "o", "\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n\r\n    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n\r\n    if parallel:\r\n        for wave in build_waves(services, subset):\r\n            print(\",\".join(wave))\r\n        return\r\n\r\n    order = topo_order(services, subset)\r\n    any_fail = False\r\n    for s in order:\r\n        svc = services[s]\r\n"]
[11381.90945, "o", "        path = service_path(svc)\r\n        if not os.path.isdir(path):\r\n            print(f\"BUILD {s} FAIL: service path does not exist\")\r\n            any_fail = True\r\n            continue\r\n        version = svc.get('version')\r\n        if not valid_version(version):\r\n            print(f\"BUILD {s} FAIL: invalid version\")\r\n            any_fail = True\r\n            continue\r\n        try:\r\n"]
[11381.909526, "o", "            os.makedirs(os.path.join(path, 'build'), exist_ok=True)\r\n            with open(os.path.join(path, 'build', 'artifact.txt'), 'w') as f:\r\n                f.write(f\"{s}:{version}+build.{int(time.time())}\")\r\n            print(f\"BUILD {s} OK\")\r\n        except Exception as e:\r\n            print(f\"BUILD {s} FAIL: {e}\")\r\n            any_fail = True\r\n\r\n    if any_fail:\r\n        sys.exit(1)\r\n\r\ndef cmd_test(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--fail-fast'})\r\n    if positionals:\r\n        fail(\"test does not accept positional arguments\")\r\n\r\n    service = values.get('--service')\r\n"]
[11381.909598, "o", "    fail_fast = '--fail-fast' in flags\r\n\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n\r\n    if service:\r\n        if service not in services:\r\n            fail(f\"service not found: {service}\")\r\n        order = [service]\r\n    else:\r\n        order = topo_order(services)\r\n\r\n    ensure_state()\r\n    results = load_json(TEST_RESULTS_PATH, {})\r\n    any_fail = False\r\n"]
[11381.909671, "o", "\r\n    for s in order:\r\n        if os.path.exists(artifact_path(services[s])):\r\n            results[s] = {\"pass\": True, \"timestamp\": now_iso()}\r\n            print(f\"TEST {s} PASS\")\r\n        else:\r\n            results[s] = {\"pass\": False, \"timestamp\": now_iso()}\r\n            print(f\"TEST {s} FAIL: not built\")\r\n            any_fail = True\r\n            if fail_fast:\r\n                break\r\n\r\n    save_json(TEST_RESULTS_PATH, results)\r\n    if any_fail:\r\n        sys.exit(1)\r\n\r\ndef cmd_deploy(args):\r\n"]
[11381.909741, "o", "    values, flags, positionals = parse_opts(args, {'--service'}, {'--dry-run'})\r\n    if len(positionals) != 1:\r\n        fail(\"deploy requires an environment\")\r\n\r\n    env = positionals[0]\r\n    service = values.get('--service')\r\n    dry_run = '--dry-run' in flags\r\n\r\n    data = load_manifest()\r\n    services, envs = get_services(data)\r\n\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n\r\n    assert_not_locked(env)\r\n\r\n"]
[11381.90981, "o", "    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n\r\n    order = topo_order(services, subset)\r\n    ensure_state()\r\n\r\n    if dry_run:\r\n        print(f\"DRY-RUN deploy to {env}:\")\r\n        for s in order:\r\n            print(f\"  Would deploy {s}\")\r\n        return\r\n\r\n    test_results = load_json(TEST_RESULTS_PATH, {})\r\n"]
[11381.909878, "o", "    state = load_deployment_state(env)\r\n    replicas = load_replicas(env)\r\n    any_fail = False\r\n    deployed_events = []\r\n\r\n    for s in order:\r\n        rec = test_results.get(s)\r\n        if not rec or not rec.get(\"pass\"):\r\n            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n            any_fail = True\r\n            break\r\n\r\n        version = read_artifact(services[s])\r\n        if version is None:\r\n"]
[11381.909947, "o", "            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n            any_fail = True\r\n            break\r\n\r\n        state[s] = {\"version\": version, \"deployed_at\": now_iso()}\r\n        replicas[s] = 1\r\n        deployed_events.append((s, version))\r\n        print(f\"DEPLOY {s} -> {env} OK\")\r\n\r\n    save_deployment_state(env, state)\r\n    save_replicas(env, replicas)\r\n    for s, version in deployed_events:\r\n        reset_health(env, s)\r\n    for s, version in deployed_events:\r\n        append_event(env, \"DEPLOY\", s, version)\r\n    if any_fail:\r\n        sys.exit(1)\r\n"]
[11381.910015, "o", "\r\ndef cmd_status(args):\r\n    if len(args) > 1:\r\n        fail(\"status takes at most one environment argument\")\r\n\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n\r\n    if args:\r\n        env = args[0]\r\n        if env not in envs:\r\n            fail(f\"environment not found: {env}\")\r\n        lock = load_lock(env)\r\n        if lock is not None:\r\n"]
[11381.910085, "o", "            print(f\"[LOCKED: {lock.get('reason', 'manual lock')}]\")\r\n        cfg = load_config(env)\r\n        if cfg:\r\n            print(f\"Config: {len(cfg)} variables\")\r\n        state = load_deployment_state(env)\r\n        for s in sorted(state):\r\n            rec = state[s]\r\n            print(f\"{s}: {rec.get('version', '')} (deployed at {rec.get('deployed_at', '')}) [{get_replica_count(env, s)} replicas] [{get_health_state(env, s).upper()}]\")\r\n    else:\r\n        for env in sorted(envs):\r\n            state = load_deployment_state(env)\r\n            print(f\"{env}: {len(state)} services deployed\")\r\n\r\n"]
[11381.910153, "o", "def cmd_rollback(args):\r\n    values, flags, positionals = parse_opts(args, {\"--to-version\"}, set())\r\n    if len(positionals) != 2:\r\n        fail(\"rollback requires <environment> <service_name>\")\r\n\r\n    env, service = positionals\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n    assert_not_locked(env)\r\n    ensure_state()\r\n    state = load_deployment_state(env)\r\n"]
[11381.910228, "o", "    replicas = load_replicas(env)\r\n\r\n    if service not in state:\r\n        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n        sys.exit(1)\r\n\r\n    current_version = state[service].get(\"version\")\r\n    if not current_version:\r\n        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n        sys.exit(1)\r\n\r\n    to_version = values.get(\"--to-version\")\r\n    target_version = find_rollback_target(env, service, current_version, to_version)\r\n\r\n    if target_version is None:\r\n        del state[service]\r\n"]
[11381.910309, "o", "        if service in replicas:\r\n            del replicas[service]\r\n        save_deployment_state(env, state)\r\n        save_replicas(env, replicas)\r\n        reset_health(env, service)\r\n        append_event(env, \"ROLLBACK\", service, \"-\")\r\n        print(f\"ROLLBACK {service} from {env}: {current_version} -> (removed)\")\r\n    else:\r\n        state[service] = {\"version\": target_version, \"deployed_at\": now_iso()}\r\n        replicas[service] = 1\r\n        save_deployment_state(env, state)\r\n        save_replicas(env, replicas)\r\n"]
[11381.910385, "o", "        reset_health(env, service)\r\n        append_event(env, \"ROLLBACK\", service, target_version)\r\n        print(f\"ROLLBACK {service} from {env}: {current_version} -> {target_version}\")\r\n\r\ndef cmd_health(args):\r\n    if not args:\r\n        fail(\"health requires <environment>\")\r\n\r\n    env = args[0]\r\n    data = load_manifest()\r\n    services, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"unknown environment '{env}'\")\r\n\r\n    if len(args) == 1:\r\n        ensure_state()\r\n        state = load_deployment_state(env)\r\n        for s in sorted(state):\r\n            print(f\"{s}: {get_health_state(env, s)}\")\r\n        return\r\n"]
[11381.910455, "o", "\r\n    if len(args) >= 3 and args[1] == \"--filter\":\r\n        if len(args) != 3:\r\n            fail(\"health <environment> --filter <state>\")\r\n        state = args[2]\r\n        if not is_valid_health_state(state):\r\n            fail(f\"invalid health state '{state}' (must be healthy, unhealthy, or degraded)\")\r\n        ensure_state()\r\n        dep_state = load_deployment_state(env)\r\n        for s in sorted(dep_state):\r\n            hs = get_health_state(env, s)\r\n            if hs == state:\r\n                print(f\"{s}: {hs}\")\r\n"]
[11381.910528, "o", "        return\r\n\r\n    if len(args) < 2:\r\n        fail(\"health requires <environment> <service>\")\r\n\r\n    service = args[1]\r\n    if service not in services:\r\n        fail(f\"unknown service '{service}'\")\r\n\r\n    if len(args) == 2:\r\n        ensure_state()\r\n        state = load_deployment_state(env)\r\n        if service not in state:\r\n            fail(f\"{service} is not deployed to {env}\")\r\n        print(f\"{service}: {get_health_state(env, service)}\")\r\n        return\r\n\r\n"]
[11381.910598, "o", "    if len(args) < 4 or args[2] != \"set\":\r\n        fail(\"invalid health arguments\")\r\n\r\n    if len(args) != 4:\r\n        fail(\"health <environment> <service> set <state>\")\r\n\r\n    new_state = args[3]\r\n    if not is_valid_health_state(new_state):\r\n        fail(f\"invalid health state '{new_state}' (must be healthy, unhealthy, or degraded)\")\r\n\r\n    ensure_state()\r\n    state = load_deployment_state(env)\r\n"]
[11381.910666, "o", "    if service not in state:\r\n        fail(f\"{service} is not deployed to {env}\")\r\n    assert_not_locked(env)\r\n    previous = get_health_state(env, service)\r\n    health = load_health(env)\r\n    health[service] = {\r\n        \"state\": new_state,\r\n        \"state_snapshot\": state.get(service),\r\n    }\r\n    save_health(env, health)\r\n    append_health_event(env, service, new_state, previous)\r\n    print(f\"HEALTH {env}/{service} set to {new_state} (was {previous})\")\r\n\r\n"]
[11381.910734, "o", "def valid_version(v):\r\n    if not isinstance(v, str):\r\n        return False\r\n    parts = v.split('.')\r\n    if len(parts) != 3:\r\n        return False\r\n    for part in parts:\r\n        if not part.isdigit() or (part != '0' and part.startswith('0')):\r\n            return False\r\n    return True\r\n\r\ndef parse_semver(v):\r\n    if not valid_version(v):\r\n"]
[11381.910803, "o", "        return None\r\n    return tuple(int(x) for x in v.split('.'))\r\n\r\ndef extract_semver(version):\r\n    if not isinstance(version, str):\r\n        return None\r\n    semver = version.split(':', 1)[1] if ':' in version else version\r\n    if '+build.' in semver:\r\n        semver = semver.split('+build.', 1)[0]\r\n    return parse_semver(semver)\r\n\r\ndef semver_string(version):\r\n    sv = extract_semver(version)\r\n    if sv is None:\r\n"]
[11381.910871, "o", "        return None\r\n    return f\"{sv[0]}.{sv[1]}.{sv[2]}\"\r\n\r\ndef version_build_timestamp(version):\r\n    if not isinstance(version, str) or '+build.' not in version:\r\n        return None\r\n    after = version.split('+build.', 1)[1]\r\n    try:\r\n        return int(after)\r\n    except ValueError:\r\n        return None\r\n\r\ndef compare_versions(a, b):\r\n    sa = extract_semver(a)\r\n"]
[11381.910938, "o", "    sb = extract_semver(b)\r\n    if sa is not None and sb is not None:\r\n        if sa != sb:\r\n            return 1 if sa > sb else -1\r\n        ta = version_build_timestamp(a)\r\n        tb = version_build_timestamp(b)\r\n        if ta is not None and tb is not None and ta != tb:\r\n            return 1 if ta > tb else -1\r\n"]
