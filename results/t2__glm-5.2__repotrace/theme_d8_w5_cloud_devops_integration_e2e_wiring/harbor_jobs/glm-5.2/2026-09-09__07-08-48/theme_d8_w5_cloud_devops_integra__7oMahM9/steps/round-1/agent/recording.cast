[11799.254848, "o", "  1080^I                entries.append((iso, svc, f\"{iso} CONFIG_SET {ev.get('key', '')}={ev.get('value', '')}\"))$\r\n  1081^I            elif action == \"CONFIG_DELETE\":$\r\n  1082^I                entries.append((iso, svc, f\"{iso} CONFIG_DELETE {ev.get('key', '')}\"))$\r\n  1083^I            elif action == \"SCALE\":$\r\n  1084^I                entries.append((iso, svc, f\"{iso} SCALE {svc} from {ev.get('previous', '-')} to {ev.get('replicas', '-')} replicas\"))$\r\n  1085^I            elif action == \"HEALTH\":$\r\n  1086^I                entries.append((iso, svc, f\"{iso} HEALTH {svc} {ev.get('previous_state', '-')} -> {ev.get('state', '-')}\"))$\r\n  1087^I            else:$\r\n  1088^I                entries.append((iso, svc, line))$\r\n  1089^I        else:$\r\n  1090^I            parts = line.split()$\r\n"]
