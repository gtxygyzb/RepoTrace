[3208.132534, "o", "   536\tdef cmd_diff(args):\r\n   537\t    if len(args) != 2:\r\n   538\t        fail(\"diff requires <env1> <env2>\")\r\n   539\t\r\n   540\t    env1, env2 = args\r\n   541\t    data = load_manifest()\r\n   542\t    _, envs = get_services(data)\r\n   543\t"]
[3208.132637, "o", "\r\n   544\t    if env1 not in envs:\r\n   545\t        fail(f\"environment not found: {env1}\")\r\n   546\t    if env2 not in envs:\r\n   547\t        fail(f\"environment not found: {env2}\")\r\n   548\t\r\n   549\t    ensure_state()\r\n   550\t    state1 = load_deployment_state(env1)\r\n"]
[3208.132705, "o", "   551\t    state2 = load_deployment_state(env2)\r\n   552\t\r\n   553\t    all_services = sorted(set(state1) | set(state2))\r\n   554\t    if not all_services:\r\n   555\t        return\r\n   556\t\r\n   557\t    for s in all_services:\r\n   558\t        v1 = state1.get(s, {}).get(\"version\")\r\n   559\t        v2 = state2.get(s, {}).get(\"version\")\r\n   560\t\r\n   561\t        if v1 and not v2:\r\n   562\t            print(f\"ONLY_IN {env1}: {s} ({v1})\")\r\n   563\t        elif v2 and not v1:\r\n   564\t            print(f\"ONLY_IN {env2}: {s} ({v2})\")\r\n   565\t        elif v1 == v2:\r\n   566\t            print(f\"SAME: {s} ({v1})\")\r\n   567\t        else:\r\n"]
[3208.132765, "o", "   568\t            t1 = version_timestamp(v1)\r\n   569\t            t2 = version_timestamp(v2)\r\n   570\t            if t1 is not None and t2 is not None:\r\n   571\t                if t1 >= t2:\r\n   572\t                    newer = env1\r\n   573\t                else:\r\n   574\t                    newer = env2\r\n   575\t            else:\r\n   576\t                newer = env1 if str(v1) >= str(v2) else env2\r\n   577\t            print(f\"DIFFERS: {s} {v1} vs {v2} ({newer} newer)\")\r\n   578\t\r\n"]
