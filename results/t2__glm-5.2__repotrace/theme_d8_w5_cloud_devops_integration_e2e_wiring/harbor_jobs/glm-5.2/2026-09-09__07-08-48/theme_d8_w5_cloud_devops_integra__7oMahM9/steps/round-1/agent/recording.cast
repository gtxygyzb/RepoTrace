[11695.501453, "o", "s = s.replace(\"        if get_health_state(env, service) == \\\"unhealthy\\\" and count > replicas.get(service, 1):\\n            fail(f\\\"cannot scale up unhealthy service '{service}' in {env}\\\")\\n        assert_not_locked(env)\\n        previous = replicas.get(service, 1)\\n        replicas[service] = count\\n\", \"        if get_health_state(env, service) == \\\"unhealthy\\\" and count > replicas.get(service, 1):\\n            fail(f\\\"cannot scale up unhealthy service '{service}' in {env}\\\")\\n        assert_not_locked(env)\\n        quotas = load_quotas(env)\\n        max_total_limit = quotas.get('max_total_replicas')\\n        if max_total_limit is not None:\\n            current_total = sum(replicas.get(svc, 1) for svc in state)\\n            projected = current_total - replicas.get(service, 1) + count\\n            if projected > max_total_limit:\\n                fail(f\\\"scaling {service} to {count} would exceed max_total_replicas quota ({projected}/{max_total_limit}) in {env}\\\")\\n        previous = replicas.get(service, 1)\\"]
