[13423.246042, "o", "    90\t            raise ValueError(f\"environment {env_name} must be a mapping\")\r\n    91\t        for field in ENV_FIELDS:\r\n    92\t            if field not in env:\r\n    93\t                raise ValueError(f\"environment {env_name} missing required field: {field}\")\r\n    94\t\r\n    95\t    for name, svc in services.items():\r\n"]
[13423.246144, "o", "    96\t        if not isinstance(svc, dict):\r\n    97\t            raise ValueError(f\"service {name} must be a mapping\")\r\n    98\t        for field in SERVICE_FIELDS:\r\n    99\t            if field not in svc:\r\n   100\t                raise ValueError(f\"service {name} missing required field: {field}\")\r\n   101\t        if not isinstance(svc['depends_on'], list):\r\n   102\t            raise ValueError(f\"service {name} has invalid depends_on: must be a list\")\r\n   103\t        for dep in svc['depends_on']:\r\n   104\t            if dep not in services:\r\n   105\t                raise ValueError(f\"service {name} depends on undefined service: {dep}\")\r\n   106\t        if not valid_version(svc.get('version')):\r\n   107\t            raise ValueError(f\"service {name} has invalid version: expected N.N.N\")\r\n   108\t\r\n   109\t    port_map = {}\r\n"]
[13423.24622, "o", "   110\t    for name, svc in services.items():\r\n   111\t        port = svc['port']\r\n   112\t        if port in port_map:\r\n   113\t            raise ValueError(f\"duplicate port assignment: {port}\")\r\n   114\t        port_map[port] = name\r\n"]
[13423.246334, "o", "   115\t\r\n   116\t    cycle = find_cycle(services)\r\n   117\t    if cycle:\r\n   118\t        raise ValueError(f\"circular dependency detected: {' -> '.join(cycle)}\")\r\n   119\t\r\n   120\t    return True\r\n   121\t\r\n   122\tdef find_cycle(services):\r\n   123\t    visited = {}\r\n   124\t    stack = []\r\n   125\t\r\n   126\t    def dfs(node):\r\n   127\t        visited[node] = 1\r\n   128\t        stack.append(node)\r\n   129\t        for dep in services[node].get('depends_on', []):\r\n   130\t            if dep not in services:\r\n   131\t                continue\r\n   132\t            if visited.get(dep) == 1:\r\n   133\t                idx = stack.index(dep)\r\n   134\t                return stack[idx:] + [dep]\r\n   135\t            if visited.get(dep) is None:\r\n   136\t                res = dfs(dep)\r\n   137\t                if res:\r\n"]
[13423.2464, "o", "   138\t                    return res\r\n   139\t        stack.pop()\r\n   140\t        visited[node] = 2\r\n   141\t        return None\r\n   142\t\r\n   143\t    for n in sorted(services):\r\n   144\t        if visited.get(n) is None:\r\n   145\t            res = dfs(n)\r\n   146\t            if res:\r\n   147\t                return res\r\n   148\t    return None\r\n"]
