[11423.008037, "o", "\u001b[32m\u001b[K1103\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kprint_tree(node, services, path, depth):\r\n\u001b[32m\u001b[K1112\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_graph(args):\r\n\u001b[32m\u001b[K1136\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_bump(args):\r\n\u001b[32m\u001b[K1167\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksnapshot_file(env):\r\n\u001b[32m\u001b[K1170\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_snapshots(env):\r\n\u001b[32m\u001b[K1173\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksave_snapshots(env, snapshots):\r\n\u001b[32m\u001b[K1176\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_snapshot(args):\r\n\u001b[32m\u001b[K1207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_restore(args):\r\n\u001b[32m\u001b[K1246\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd_lock\u001b[m\u001b[K(args):\r\n"]
[11423.00811, "o", "\u001b[32m\u001b[K1273\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_unlock(args):\r\n\u001b[32m\u001b[K1287\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_config(args):\r\n\u001b[32m\u001b[K1309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_config_set(args):\r\n\u001b[32m\u001b[K1322\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_config_get(args):\r\n\u001b[32m\u001b[K1332\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_config_list(args):\r\n\u001b[32m\u001b[K1341\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_config_diff(args):\r\n"]
[11423.008174, "o", "\u001b[32m\u001b[K1357\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_config_delete(args):\r\n\u001b[32m\u001b[K1372\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_config_export(args):\r\n\u001b[32m\u001b[K1380\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcmd_config_import(args):\r\n\u001b[32m\u001b[K1409\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd_scale\u001b[m\u001b[K(args):\r\n"]
