[1131.614731, "o", "\u001b[?2004h> "]
[1131.614799, "o", "            return f.read().strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.614909, "o", "    except FileNotFoundError:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.614972, "o", "> "]
[1131.615041, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1131.615109, "o", "s\u001b[?2004h> def deployment_file(env):\r\n\u001b[?2004l\rru"]
[1131.615178, "o", "\u001b[?2004h> "]
