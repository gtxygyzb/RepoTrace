[1591.222847, "o", "MANIFEST_PATH = '/app/pipeline.yaml'\r\nSTATE_DIR = '/app/.pipeline'\r\nTEST_RESULTS_PATH = os.path.join(STATE_DIR, 'test_results.json')\r\nDEPLOYMENTS_DIR = os.path.join(STATE_DIR, 'deployments')\r\n\r\nSERVICE_FIELDS = ['path', 'build_cmd', 'test_cmd', 'port', 'depends_on', 'health_endpoint']\r\nENV_FIELDS = ['deploy_target', 'health_check_port', 'max_replicas']\r\n\r\ndef ensure_state():\r\n    os.makedirs(STATE_DIR, exist_ok=True)\r\n    os.makedirs(DEPLOYMENTS_DIR, exist_ok=True)"]
[1591.222962, "o", "\r\n\r\ndef fail(msg, code=1):\r\n    print(f\"ERROR: {msg}\")\r\n    sys.exit(code)\r\n\r\ndef now_iso():\r\n    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n\r\ndef load_json(path, default):\r\n    try:\r\n        with open(path) as f:\r\n            return json.load(f)\r\n    except FileNotFoundError:\r\n        return default\r\n    except json.JSONDecodeError as e:\r\n        fail(f\"state error in {path}: {e}\")\r\n\r\ndef save_json(path, data):\r\n    os.makedirs(os.path.dirname(path), exist_ok=True)\r\n    with open(path, 'w') as f:\r\n        json.dump(data, f, indent=2, sort_keys=True)\r\n\r\ndef load_manifest():\r\n"]
[1591.223023, "o", "    try:\r\n        with open(MANIFEST_PATH) as f:\r\n            data = yaml.safe_load(f)\r\n    except FileNotFoundError:\r\n        fail(\"manifest not found\")\r\n    except yaml.YAMLError as e:\r\n        fail(f\"YAML syntax error: {e}\")\r\n"]
[1591.223077, "o", "    if not isinstance(data, dict):\r\n        fail(\"manifest must be a mapping\")\r\n    return data\r\n\r\ndef validate_manifest(data):\r\n    if not isinstance(data, dict):\r\n        raise ValueError(\"manifest must be a mapping\")\r\n\r\n    services = data.get('services')\r\n    if not isinstance(services, dict) or not services:\r\n        raise ValueError(\"manifest missing services\")\r\n\r\n    environments = data.get('environments')\r\n    if not isinstance(environments, dict) or not environments:\r\n        raise ValueError(\"manifest missing environments\")\r\n\r\n    for env_name, env in environments.items():\r\n        if not isinstance(env, dict):\r\n"]
[1591.223126, "o", "            raise ValueError(f\"environment {env_name} must be a mapping\")\r\n        for field in ENV_FIELDS:\r\n            if field not in env:\r\n                raise ValueError(f\"environment {env_name} missing required field: {field}\")\r\n\r\n"]
[1591.223186, "o", "    for name, svc in services.items():\r\n        if not isinstance(svc, dict):\r\n            raise ValueError(f\"service {name} must be a mapping\")\r\n        for field in SERVICE_FIELDS:\r\n            if field not in svc:\r\n                raise ValueError(f\"service {name} missing required field: {field}\")\r\n        if not isinstance(svc['depends_on'], list):\r\n            raise ValueError(f\"service {name} has invalid depends_on: must be a list\")\r\n        for dep in svc['depends_on']:\r\n            if dep not in services:\r\n                raise ValueError(f\"service {name} depends on undefined service: {dep}\")\r\n\r\n    port_map = {}\r\n    for name, svc in services.items():\r\n        port = svc['port']\r\n        if port in port_map:\r\n            raise ValueError(f\"duplicate port assignment: {port}\")\r\n"]
[1591.223236, "o", "        port_map[port] = name\r\n\r\n    cycle = find_cycle(services)\r\n    if cycle:\r\n        raise ValueError(f\"circular dependency detected: {' -> '.join(cycle)}\")\r\n"]
[1591.223328, "o", "\r\n    return True\r\n\r\ndef find_cycle(services):\r\n    visited = {}\r\n    stack = []\r\n\r\n    def dfs(node):\r\n        visited[node] = 1\r\n        stack.append(node)\r\n        for dep in services[node].get('depends_on', []):\r\n            if dep not in services:\r\n                continue\r\n            if visited.get(dep) == 1:\r\n                idx = stack.index(dep)\r\n                return stack[idx:] + [dep]\r\n            if visited.get(dep) is None:\r\n                res = dfs(dep)\r\n                if res:\r\n                    return res\r\n        stack.pop()\r\n        visited[node] = 2\r\n"]
[1591.223389, "o", "        return None\r\n\r\n    for n in sorted(services):\r\n        if visited.get(n) is None:\r\n            res = dfs(n)\r\n            if res:\r\n                return res\r\n    return None\r\n\r\ndef get_services(data):\r\n    try:\r\n        validate_manifest(data)\r\n    except ValueError as e:\r\n"]
[1591.22346, "o", "        fail(str(e))\r\n    return data['services'], data['environments']\r\n\r\ndef topo_order(services, subset=None):\r\n    if subset is None:\r\n        subset = set(services.keys())\r\n    subset = set(subset)\r\n\r\n    in_degree = {s: 0 for s in subset}\r\n    adj = {s: [] for s in subset}\r\n\r\n    for s in subset:\r\n        for dep in services[s].get('depends_on', []):\r\n            if dep in subset:\r\n                adj[dep].append(s)\r\n"]
[1591.223513, "o", "                in_degree[s] += 1\r\n\r\n    order = []\r\n    available = sorted([s for s in subset if in_degree[s] == 0])\r\n    while available:\r\n        next_available = []\r\n        for s in available:\r\n            order.append(s)\r\n            for dependent in sorted(adj[s]):\r\n                in_degree[dependent] -= 1\r\n                if in_degree[dependent] == 0:\r\n                    next_available.append(dependent)\r\n        available = sorted(next_available)\r\n\r\n"]
[1591.223558, "o", "    if len(order) != len(subset):\r\n        fail(\"circular dependency detected\")\r\n    return order\r\n\r\ndef build_waves(services, subset):\r\n    subset = set(subset)\r\n\r\n    in_degree = {s: 0 for s in subset}\r\n    adj = {s: [] for s in subset}\r\n\r\n    for s in subset:\r\n"]
[1591.223607, "o", "        for dep in services[s].get('depends_on', []):\r\n            if dep in subset:\r\n                adj[dep].append(s)\r\n                in_degree[s] += 1\r\n\r\n    waves = []\r\n    available = sorted([s for s in subset if in_degree[s] == 0])\r\n    while available:\r\n        waves.append(available)\r\n        next_available = []\r\n        for s in available:\r\n            for dependent in sorted(adj[s]):\r\n"]
[1591.223654, "o", "                in_degree[dependent] -= 1\r\n                if in_degree[dependent] == 0:\r\n                    next_available.append(dependent)\r\n        available = sorted(next_available)\r\n\r\n    if sum(len(w) for w in waves) != len(subset):\r\n        fail(\"circular dependency detected\")\r\n    return waves\r\n\r\ndef transitive_deps(services, name):\r\n"]
[1591.223706, "o", "    if name not in services:\r\n        fail(f\"service not found: {name}\")\r\n    result = set()\r\n    stack = [name]\r\n    while stack:\r\n        s = stack.pop()\r\n        if s not in result:\r\n            result.add(s)\r\n            for dep in services[s].get('depends_on', []):\r\n                if dep not in services:\r\n                    fail(f\"service {s} depends on undefined service: {dep}\")\r\n                stack.append(dep)\r\n    return result\r\n\r\n"]
[1591.223761, "o", "def service_path(svc):\r\n    p = svc.get('path', '')\r\n    if os.path.isabs(p):\r\n        return p\r\n    return os.path.join(APP_DIR, p)\r\n\r\ndef artifact_path(svc):\r\n    return os.path.join(service_path(svc), 'build', 'artifact.txt')\r\n\r\ndef read_artifact(svc):\r\n    try:\r\n        with open(artifact_path(svc)) as f:\r\n            return f.read().strip()\r\n    except FileNotFoundError:"]
[1591.223804, "o", "\r\n        return None\r\n\r\ndef deployment_file(env):\r\n    return os.path.join(DEPLOYMENTS_DIR, f\"{env}.json\")\r\n\r\ndef load_deployment_state(env):\r\n    return load_json(deployment_file(env), {})\r\n\r\ndef save_deployment_state(env, state):\r\n    save_json(deployment_file(env), state)\r\n"]
[1591.22385, "o", "\r\ndef parse_opts(args, value_opts, flag_opts):\r\n    values = {}\r\n    flags = set()\r\n    positionals = []\r\n    i = 0\r\n    while i < len(args):\r\n        a = args[i]\r\n"]
[1591.224444, "o", "\u001b[?2004hroot@n30009:/app# "]
[1595.975821, "i", "sed -n '240,520p' pipeline.sh\n"]
[1595.976141, "o", "sed -n '240,520p' pipeline.sh\r\n\u001b[?2004l\r"]
[1595.979262, "o", "        a = args[i]\r\n        if a in value_opts:\r\n            i += 1\r\n            if i >= len(args):\r\n                fail(f\"{a} requires a value\")\r\n            values[a] = args[i]\r\n        elif a in flag_opts:\r\n            flags.add(a)\r\n"]
[1595.979305, "o", "        elif a.startswith('--'):\r\n            fail(f\"unknown option: {a}\")\r\n        else:\r\n            positionals.append(a)\r\n        i += 1\r\n    return values, flags, positionals\r\n\r\ndef cmd_validate(args):\r\n"]
[1595.979423, "o", "    if args:\r\n        fail(\"validate takes no arguments\")\r\n    data = load_manifest()\r\n    try:\r\n        validate_manifest(data)\r\n    except ValueError as e:\r\n        print(f\"ERROR: {e}\")\r\n        sys.exit(1)\r\n    print(\"VALID\")\r\n\r\ndef cmd_order(args):\r\n    if args:\r\n        fail(\"order takes no arguments\")\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n    for s in topo_order(services):\r\n        print(s)\r\n\r\ndef cmd_build(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--parallel'})\r\n    if positionals:\r\n        fail(\"build does not accept positional arguments\")\r\n\r\n    service = values.get('--service')\r\n"]
[1595.979482, "o", "    parallel = '--parallel' in flags\r\n\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n\r\n    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n\r\n    if parallel:\r\n        for wave in build_waves(services, subset):\r\n"]
[1595.979516, "o", "            print(\",\".join(wave))\r\n        return\r\n\r\n    order = topo_order(services, subset)\r\n    any_fail = False\r\n    for s in order:\r\n        svc = services[s]\r\n        path = service_path(svc)\r\n        if not os.path.isdir(path):\r\n"]
[1595.979574, "o", "            print(f\"BUILD {s} FAIL: service path does not exist\")\r\n            any_fail = True\r\n            continue\r\n        try:\r\n            os.makedirs(os.path.join(path, 'build'), exist_ok=True)\r\n            with open(os.path.join(path, 'build', 'artifact.txt'), 'w') as f:\r\n                f.write(f\"{s}:{int(time.time())}:built\")\r\n            print(f\"BUILD {s} OK\")\r\n        except Exception as e:\r\n            print(f\"BUILD {s} FAIL: {e}\")\r\n            any_fail = True\r\n\r\n    if any_fail:\r\n"]
[1595.979623, "o", "        sys.exit(1)\r\n\r\ndef cmd_test(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--fail-fast'})\r\n    if positionals:\r\n        fail(\"test does not accept positional arguments\")\r\n\r\n    service = values.get('--service')\r\n    fail_fast = '--fail-fast' in flags\r\n\r\n    data = load_manifest()\r\n"]
[1595.979681, "o", "    services, _ = get_services(data)\r\n\r\n    if service:\r\n        if service not in services:\r\n            fail(f\"service not found: {service}\")\r\n        order = [service]\r\n    else:\r\n        order = topo_order(services)\r\n\r\n    ensure_state()\r\n    results = load_json(TEST_RESULTS_PATH, {})\r\n    any_fail = False\r\n\r\n"]
[1595.979712, "o", "    for s in order:\r\n        if os.path.exists(artifact_path(services[s])):\r\n            results[s] = {\"pass\": True, \"timestamp\": now_iso()}\r\n            print(f\"TEST {s} PASS\")\r\n        else:\r\n            results[s] = {\"pass\": False, \"timestamp\": now_iso()}\r\n            print(f\"TEST {s} FAIL: not built\")\r\n"]
[1595.979767, "o", "            any_fail = True\r\n            if fail_fast:\r\n                break\r\n\r\n    save_json(TEST_RESULTS_PATH, results)\r\n    if any_fail:\r\n        sys.exit(1)\r\n\r\ndef cmd_deploy(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--dry-run'})\r\n    if len(positionals) != 1:\r\n        fail(\"deploy requires an environment\")\r\n\r\n"]
[1595.979816, "o", "    env = positionals[0]\r\n    service = values.get('--service')\r\n    dry_run = '--dry-run' in flags\r\n\r\n    data = load_manifest()\r\n    services, envs = get_services(data)\r\n\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n\r\n"]
[1595.979844, "o", "    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n\r\n    order = topo_order(services, subset)\r\n"]
[1595.979908, "o", "    ensure_state()\r\n\r\n    if dry_run:\r\n        print(f\"DRY-RUN deploy to {env}:\")\r\n        for s in order:\r\n            print(f\"  Would deploy {s}\")\r\n        return\r\n\r\n    test_results = load_json(TEST_RESULTS_PATH, {})\r\n    state = load_deployment_state(env)\r\n    any_fail = False\r\n\r\n    for s in order:\r\n        rec = test_results.get(s)\r\n        if not rec or not rec.get(\"pass\"):\r\n"]
[1595.979965, "o", "            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n            any_fail = True\r\n            break\r\n\r\n        version = read_artifact(services[s])\r\n        if version is None:\r\n            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n            any_fail = True\r\n            break\r\n\r\n        state[s] = {\"version\": version, \"deployed_at\": now_iso()}\r\n"]
[1595.980014, "o", "        print(f\"DEPLOY {s} -> {env} OK\")\r\n\r\n    save_deployment_state(env, state)\r\n    if any_fail:\r\n        sys.exit(1)\r\n"]
[1595.980066, "o", "\r\ndef cmd_status(args):\r\n    if len(args) > 1:\r\n        fail(\"status takes at most one environment argument\")\r\n\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n\r\n    if args:\r\n        env = args[0]\r\n        if env not in envs:\r\n            fail(f\"environment not found: {env}\")\r\n        state = load_deployment_state(env)\r\n        for s in sorted(state):\r\n            rec = state[s]\r\n            print(f\"{s}: {rec.get('version', '')} (deployed at {rec.get('deployed_at', '')})\")\r\n    else:\r\n"]
[1595.980117, "o", "        for env in sorted(envs):\r\n            state = load_deployment_state(env)\r\n            print(f\"{env}: {len(state)} services deployed\")\r\n\r\ndef cmd_rollback(args):\r\n"]
[1595.980168, "o", "    if len(args) != 2:\r\n        fail(\"rollback requires <environment> <service_name>\")\r\n\r\n    env, service = args\r\n    ensure_state()\r\n    state = load_deployment_state(env)\r\n\r\n    if service not in state:\r\n        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n        sys.exit(1)\r\n\r\n"]
[1595.980218, "o", "    del state[service]\r\n    save_deployment_state(env, state)\r\n    print(f\"ROLLBACK {service} from {env} OK\")\r\n\r\ndef print_tree(node, services, path, depth):\r\n    print(\"  \" * depth + node)\r\n    if node in path:\r\n        return\r\n    path = path | {node}\r\n    children = sorted([s for s in services if node in services[s].get('depends_on', [])])\r\n    for child in children:\r\n        print_tree(child, services, path, depth + 1)\r\n\r\ndef cmd_graph(args):\r\n    values, flags, positionals = parse_opts(args, {'--format'}, set())\r\n    if positionals:\r\n"]
[1595.980249, "o", "        fail(\"graph does not accept positional arguments\")\r\n\r\n    fmt = values.get('--format', 'text')\r\n    if fmt not in ('dot', 'text'):\r\n        fail(\"graph format must be dot or text\")\r\n\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n"]
[1595.980324, "o", "\r\n    if fmt == 'dot':\r\n        print(\"digraph pipeline {\")\r\n        for dep in sorted(services):\r\n            dependents = sorted([s for s in services if dep in services[s].get('depends_on', [])])\r\n            for dependent in dependents:\r\n                print(f'  \"{dep}\" -> \"{dependent}\";')\r\n        print(\"}\")\r\n    else:\r\n        roots = sorted([s for s in services if not services[s].get('depends_on')])\r\n        for root in roots:\r\n            print_tree(root, services, set(), 0)\r\n\r\n"]
[1595.980374, "o", "def main():\r\n    if len(sys.argv) < 2:\r\n        fail(\"no command given\")\r\n\r\n    cmd = sys.argv[1]\r\n"]
[1595.980425, "o", "    args = sys.argv[2:]\r\n\r\n    if cmd == 'validate':\r\n        cmd_validate(args)\r\n    elif cmd == 'order':\r\n        cmd_order(args)\r\n    elif cmd == 'build':\r\n        cmd_build(args)\r\n    elif cmd == 'test':\r\n        cmd_test(args)\r\n    elif cmd == 'deploy':\r\n        cmd_deploy(args)\r\n    elif cmd == 'status':\r\n        cmd_status(args)\r\n    elif cmd == 'rollback':\r\n        cmd_rollback(args)\r\n"]
[1595.980477, "o", "    elif cmd == 'graph':\r\n        cmd_graph(args)\r\n    else:\r\n        fail(f\"unknown command: {cmd}\")\r\n\r\nif __name__ == '__main__':\r\n    main()\r\nPY\r\n"]
