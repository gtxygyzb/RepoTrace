[3870.911699, "o", "   576\t        src_rec = source_state[s]\r\n   577\t        src_version = src_rec.get(\"version\")\r\n   578\t        if target_state.get(s, {}).get(\"version\") == src_version:\r\n   579\t            print(f\"PROMOTE {s} -> {target}: SKIP (same version)\")\r\n"]
[3870.911764, "o", "   580\t            skipped += 1\r\n   581\t            continue\r\n   582\t\r\n   583\t        src_sv = extract_semver(src_version)\r\n   584\t        tgt_sv = extract_semver(target_state.get(s, {}).get(\"version\"))\r\n   585\t        if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:\r\n   586\t            if force:\r\n   587\t                target_state[s] = src_rec\r\n   588\t                print(f\"PROMOTE {s} -> {target} OK (forced)\")\r\n   589\t                promoted += 1\r\n   590\t                promote_events.append((s, src_version, True))\r\n   591\t            else:\r\n"]
[3870.911831, "o", "   592\t                print(f\"CONFLICT: {s} -> {target}: downgrade ({src_sv[0]}.{src_sv[1]}.{src_sv[2]} < {tgt_sv[0]}.{tgt_sv[1]}.{tgt_sv[2]})\")\r\n   593\t                conflicts += 1\r\n   594\t            continue\r\n   595\t\r\n   596\t        target_state[s] = src_rec\r\n   597\t        print(f\"PROMOTE {s} -> {target} OK\")\r\n   598\t        promoted += 1\r\n   599\t        promote_events.append((s, src_version, False))\r\n   600\t\r\n   601\t    save_deployment_state(target, target_state)\r\n   602\t    for s, version, forced in promote_events:\r\n   603\t        append_event(target, \"PROMOTE\", s, version, source, forced=forced)\r\n   604\t    print(f\"Promoted {promoted}, skipped {skipped}, conflicts {conflicts}\")\r\n   605\tdef cmd_diff(args):\r\n   606"]
[3870.911891, "o", "\t    if len(args) != 2:\r\n   607\t        fail(\"diff requires <env1> <env2>\")\r\n   608\t\r\n   609\t    env1, env2 = args\r\n   610\t    data = load_manifest()\r\n   611\t    _, envs = get_services(data)\r\n   612\t\r\n   613\t    if env1 not in envs:\r\n   614\t        fail(f\"environment not found: {env1}\")\r\n   615\t    if env2 not in envs:\r\n"]
