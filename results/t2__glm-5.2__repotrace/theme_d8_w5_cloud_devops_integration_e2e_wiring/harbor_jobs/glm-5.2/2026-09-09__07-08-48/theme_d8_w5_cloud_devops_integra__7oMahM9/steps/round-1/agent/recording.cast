[14162.66138, "o", "        fail(\"history requires an environment\")\r\n  1195\t\r\n  1196\t    env = positionals[0]\r\n  1197\t    service = values.get(\"--service\")\r\n  1198\t    limit = 10\r\n  1199\t    if \"--limit\" in values:\r\n  1200\t        try:\r\n  1201\t            limit = int(values[\"--limit\"])\r\n  1202\t        except ValueError:\r\n  1203\t            fail(\"--limit requires an integer\")\r\n  1204\t        if limit < 0:\r\n  1205\t            fail(\"--limit must be non-negative\")\r\n  1206\t\r\n  1207\t    data = load_manifest()\r\n"]
[14162.661476, "o", "  1208\t    _, envs = get_services(data)\r\n  1209\t    if env not in envs:\r\n  1210\t        fail(f\"environment not found: {env}\")\r\n  1211\t\r\n  1212\t    ensure_state()\r\n  1213\t    try:\r\n  1214\t        with open(event_file(env)) as f:\r\n  1215\t            raw_lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n  1216\t    except FileNotFoundError:\r\n  1217\t        raw_lines = []\r\n  1218\t\r\n"]
