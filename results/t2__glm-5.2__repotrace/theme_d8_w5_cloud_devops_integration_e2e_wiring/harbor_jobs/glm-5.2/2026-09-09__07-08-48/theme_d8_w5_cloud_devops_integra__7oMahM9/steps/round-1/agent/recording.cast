[3207.851836, "o", "            return int(parts[1])\r\n   473\t        except ValueError:\r\n   474\t            return None\r\n   475\t    return None\r\n   476\t\r\n   477\tdef cmd_promote(args):\r\n   478\t    values, flags, positionals = parse_opts(args, {\"--service\"}, {\"--dry-run\"})\r\n   479\t    if len(positionals) != 2:\r\n   480\t        fail(\"promote requires <source-env> <target-env>\")\r\n   481\t\r\n   482\t    source, target = positionals\r\n   483\t    service = values.get(\"--service\")\r\n   484\t    dry_run = \"--dry-run\" in flags\r\n"]
