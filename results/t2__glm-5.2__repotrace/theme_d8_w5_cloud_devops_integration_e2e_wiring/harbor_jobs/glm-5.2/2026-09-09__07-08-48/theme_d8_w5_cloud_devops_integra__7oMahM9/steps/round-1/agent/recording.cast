[11447.394972, "o", "\t    return waves\r\n   212\t\r\n   213\tdef transitive_deps(services, name):\r\n   214\t    if name not in services:\r\n   215\t        fail(f\"service not found: {name}\")\r\n   216\t    result = set()\r\n   217\t    stack = [name]\r\n   218\t    while stack:\r\n   219\t"]
[11447.395037, "o", "        s = stack.pop()\r\n   220\t        if s not in result:\r\n   221\t            result.add(s)\r\n   222\t            for dep in services[s].get('depends_on', []):\r\n   223\t                if dep not in services:\r\n   224\t                    fail(f\"service {s} depends on undefined service: {dep}\")\r\n   225\t                stack.append(dep)\r\n   226\t    return result\r\n   227\t\r\n   228\tdef service_path(svc):\r\n"]
