[3143.980259, "o", "\t        for s in order:\r\n   509\t            if source_state[s].get(\"version\") == target_state.get(s, {}).get(\"version\"):\r\n   510\t                continue\r\n   511\t            print(f\"  Would promote {s}\")\r\n   512\t        return\r\n   513\t\r\n   514\t    promoted = 0\r\n   515\t    skipped = 0\r\n   516\t    promote_events = []\r\n   517\t\r\n   518\t    for s in order:\r\n   519\t        src_rec = source_state[s]\r\n   520\t        src_version = src_rec.get(\"version\")\r\n   521"]
