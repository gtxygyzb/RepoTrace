[4899.860809, "o", "   234\tdef load_deployment_state(env):\r\n   235\t    return load_json(deployment_file(env), {})\r\n   236\t\r\n   237\tdef save_deployment_state(env, state):\r\n"]
[4899.86091, "o", "   238\t    save_json(deployment_file(env), state)\r\n   239\t\r\n   240\tdef event_file(env):\r\n   241\t    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n   242\t\r\n   243\tdef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n   244\t    ensure_state()\r\n   245\t    ts = now_iso()\r\n   246\t    line = f\"{ts} {action} {service} {version}\"\r\n   247\t    if action == \"PROMOTE\" and source_env is not None:\r\n   248\t        line += f\" from {source_env}\"\r\n   249\t        if forced:\r\n   250\t            line += \" (forced)\"\r\n   251\t    if action == \"RESTORE\" and snapshot_id is not None:\r\n   252\t        line += f\" from snapshot #{snapshot_id}\"\r\n"]
[4899.860972, "o", "   253\t    line += \"\\n\"\r\n   254\t    with open(event_file(env), \"a\") as f:\r\n   255\t        f.write(line)\r\n   256\t\r\n   257\tdef load_events(env):\r\n   258\t    ensure_state()\r\n   259\t    try:\r\n   260\t        with open(event_file(env)) as f:\r\n   261\t            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n"]
[4899.861032, "o", "   262\t    except FileNotFoundError:\r\n   263\t        return []\r\n   264\t    events = []\r\n   265\t    for line in lines:\r\n   266\t        parts = line.split()\r\n   267\t        if len(parts) < 4:\r\n   268\t            continue\r\n   269\t        events.append({\r\n"]
[4899.86109, "o", "   270\t            \"timestamp\": parts[0],\r\n   271\t            \"action\": parts[1],\r\n   272\t            \"service\": parts[2],\r\n   273\t            \"version\": parts[3],\r\n   274\t            \"line\": line,\r\n   275\t        })\r\n   276\t    return events\r\n   277\t\r\n   278\tdef find_rollback_target(env, service, current_version, to_version=None):\r\n   279\t    events = load_events(env)\r\n"]
[4899.861149, "o", "   280\t\r\n   281\t    if to_version is not None:\r\n   282\t        for ev in reversed(events):\r\n   283\t            if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] == to_version:\r\n   284\t                return to_version\r\n   285\t        fail(f\"version not found in history for {service}\")\r\n   286\t\r\n   287\t    current_idx = None\r\n   288\t    for idx, ev in enumerate(events):\r\n"]
[4899.861202, "o", "   289\t        if ev[\"service\"] != service:\r\n   290\t            continue\r\n   291\t        if ev[\"version\"] != current_version:\r\n   292\t            continue\r\n   293\t        if ev[\"action\"] == \"ROLLBACK\" and ev[\"version\"] == \"-\":\r\n   294\t            continue\r\n   295\t        current_idx = idx\r\n   296\t\r\n   297\t    if current_idx is None:\r\n"]
[4899.861254, "o", "   298\t        return None\r\n   299\t\r\n   300\t    for ev in reversed(events[:current_idx]):\r\n   301\t        if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] != current_version:\r\n   302\t            return ev[\"version\"]\r\n   303\t    return None\r\n   304\t\r\n   305\tdef parse_opts(args, value_opts, flag_opts):\r\n"]
