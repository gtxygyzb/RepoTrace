[9474.887537, "o", "     1\t#!/usr/bin/env bash\r\n     2\tset -euo pipefail\r\n     3\ttmp_script=\"$(mktemp)\"\r\n     4\ttrap 'rm -f \"$tmp_script\"' EXIT\r\n     5\tcat > \"$tmp_script\" <<'PY'\r\n     6\timport sys\r\n     7\timport os\r\n"]
[9474.88769, "o", "     8\timport json\r\n     9\timport time\r\n    10\timport yaml\r\n    11\timport re\r\n    12\tfrom datetime import datetime, timezone\r\n    13\t\r\n    14\tAPP_DIR = '/app'\r\n    15\tMANIFEST_PATH = '/app/pipeline.yaml'\r\n    16\tSTATE_DIR = '/app/.pipeline'\r\n    17\tTEST_RESULTS_PATH = os.path.join(STATE_DIR, 'test_results.json')\r\n    18\tDEPLOYMENTS_DIR = os.path.join(STATE_DIR, 'deployments')\r\n    19\tEVENTS_DIR = os.path.join(STATE_DIR, 'events')\r\n    20\tSNAPSHOTS_DIR = os.path.join(STATE_DIR, 'snapshots')\r\n    21\tLOCK_DIR = os.path.join(STATE_DIR, 'locks')\r\n    22\tCONFIG_DIR = os.path.join(STATE_DIR, 'config')\r\n    23\tREPLICAS_DIR = os.path.join(STATE_DIR, 'replicas')\r\n    24\tBOUNDS_DIR = os.path.join(STATE_DIR, 'bounds')\r\n    25\t\r\n    26\tSERVICE_FIELDS = ['version', 'path', 'build_cmd', 'test_cmd', 'port', 'depends_on', 'health_endpoint']\r\n    27\tENV_FIELDS = ['deploy_target', 'health_check_port', 'max_replicas']\r\n    28\t\r\n    29\tdef ensure_state():\r\n    30\t    os.makedirs(STATE_DIR, exist_ok=True)\r\n"]
[9474.887814, "o", "    31\t    os.makedirs(DEPLOYMENTS_DIR, exist_ok=True)\r\n    32\t    os.makedirs(EVENTS_DIR, exist_ok=True)\r\n    33\t    os.makedirs(SNAPSHOTS_DIR, exist_ok=True)\r\n    34\t    os.makedirs(LOCK_DIR, exist_ok=True)\r\n    35\t    os.makedirs(CONFIG_DIR, exist_ok=True)\r\n    36\t    os.makedirs(REPLICAS_DIR, exist_ok=True)\r\n    37\t    os.makedirs(BOUNDS_DIR, exist_ok=True)\r\n    38\t\r\n    39\tdef fail(msg, code=1):\r\n    40\t    print(f\"ERROR: {msg}\")\r\n    41\t    sys.exit(code)\r\n    42\t\r\n    43\tdef now_iso():\r\n    44\t    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n    45\t\r\n    46\tdef load_json(path, default):\r\n    47\t    try:\r\n    48\t        with open(path) as f:\r\n    49\t            return json.load(f)\r\n"]
[9474.887913, "o", "    50\t    except FileNotFoundError:\r\n    51\t        return default\r\n    52\t    except json.JSONDecodeError as e:\r\n    53\t        fail(f\"state error in {path}: {e}\")\r\n    54\t\r\n    55\tdef save_json(path, data):\r\n    56\t    os.makedirs(os.path.dirname(path), exist_ok=True)\r\n    57\t    with open(path, 'w') as f:\r\n    58\t        json.dump(data, f, indent=2, sort_keys=True)\r\n    59\t\r\n    60\tdef load_manifest():\r\n    61\t    try:\r\n    62\t        with open(MANIFEST_PATH) as f:\r\n    63\t            data = yaml.safe_load(f)\r\n    64\t    except FileNotFoundError:\r\n    65\t        fail(\"manifest not found\")\r\n    66\t    except yaml.YAMLError as e:\r\n    67\t        fail(f\"YAML syntax error: {e}\")"]
[9474.887931, "o", "\r\n    68\t    if not isinstance(data, dict):\r\n    69\t        fail(\"manifest must be a mapping\")\r\n    70\t    return data\r\n"]
[9474.888037, "o", "    71\t\r\n    72\tdef validate_manifest(data):\r\n    73\t    if not isinstance(data, dict):\r\n    74\t        raise ValueError(\"manifest must be a mapping\")\r\n    75\t\r\n    76\t    services = data.get('services')\r\n    77\t    if not isinstance(services, dict) or not services:\r\n    78\t        raise ValueError(\"manifest missing services\")\r\n    79\t\r\n    80\t    environments = data.get('environments')\r\n    81\t    if not isinstance(environments, dict) or not environments:\r\n    82\t        raise ValueError(\"manifest missing environments\")\r\n    83\t\r\n    84\t    for env_name, env in environments.items():\r\n    85\t        if not isinstance(env, dict):\r\n    86\t            raise ValueError(f\"environment {env_name} must be a mapping\")\r\n    87\t        for field in ENV_FIELDS:\r\n    88"]
[9474.888053, "o", "\t            if field not in env:\r\n    89\t                raise ValueError(f\"environment {env_name} missing required field: {field}\")\r\n    90\t\r\n"]
