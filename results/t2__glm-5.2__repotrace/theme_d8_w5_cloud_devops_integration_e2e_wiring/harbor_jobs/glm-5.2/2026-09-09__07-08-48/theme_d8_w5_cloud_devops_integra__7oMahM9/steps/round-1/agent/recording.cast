[3484.511841, "o", "\u001b[?2004h> "]
[3484.512064, "o", "            print(f\"DIFFERS: {s} {v1} vs {v2} ({newer} newer)\")\"\"\",\r\n\u001b[?2004l\r"]
[3484.512148, "o", "\u001b[?2004h> "]
[3484.512239, "o", "    \"\"\"        elif v1 == v2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[3484.512344, "o", "> "]
[3484.512443, "o", "            print(f\"SAME: {s} ({v1})\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[3484.512539, "o", "> "]
