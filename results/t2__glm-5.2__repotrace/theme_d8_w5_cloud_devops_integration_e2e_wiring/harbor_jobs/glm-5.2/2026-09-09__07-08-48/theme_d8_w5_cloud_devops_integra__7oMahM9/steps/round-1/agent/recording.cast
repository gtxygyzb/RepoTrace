[9882.155672, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('pipeline.sh')\ns = p.read_text()\n\nif \"HEALTH_DIR = os.path.join(STATE_DIR, 'health')\" not in s:\n    s = s.replace(\"BOUNDS_DIR = os.path.join(STATE_DIR, 'bounds')\\n\", \"BOUNDS_DIR = os.path.join(STATE_DIR, 'bounds')\\nHEALTH_DIR = os.path.join(STATE_DIR, 'health')\\n\")\n\nif \"os.makedirs(HEALTH_DIR, exist_ok=True)\" not in s:\n    s = s.replace(\"    os.makedirs(BOUNDS_DIR, exist_ok=True)\\n\", \"    os.makedirs(BOUNDS_DIR, exist_ok=True)\\n    os.makedirs(HEALTH_DIR, exist_ok=True)\\n\")\n\nhelpers = '''def health_file(env):\n    return os.path.join(HEALTH_DIR, f\"{env}.json\")\n\ndef load_health(env):\n    return load_json(health_file(env), {})\n\ndef save_health(env, data):\n    save_json(health_file(env), data)\n\ndef is_valid_health_state(state):\n    return state in (\"healthy\", \"unhealthy\", \"degraded\")\n\ndef get_health_state(env, service):\n    health = load_health(env)\n    rec = health.get(service)\n    if not rec or rec.get(\"state\") not in (\"healthy\", \"unhealthy\", \"degraded\"):\n     "]
