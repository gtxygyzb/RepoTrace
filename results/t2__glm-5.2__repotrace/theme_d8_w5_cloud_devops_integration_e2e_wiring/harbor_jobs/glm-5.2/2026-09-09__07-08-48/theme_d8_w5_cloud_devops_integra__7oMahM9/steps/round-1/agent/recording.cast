[4195.796585, "o", "\u001b[?2004h> "]
[4195.796725, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[4195.796774, "o", "\u001b[?2004h> \r\n"]
[4195.796831, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4195.797003, "o", "    del state[service]\r\n\u001b[?2004l\r"]
[4195.797063, "o", "\u001b[?2004h> "]
[4195.797323, "o", "    save_deployment_state(env, state)\r\n\u001b[?2004l\r"]
[4195.797382, "o", "\u001b[?2004h> "]
[4195.797704, "o", "    append_event(env, \"ROLLBACK\", service, \"-\")\r\n\u001b[?2004l\r"]
[4195.797764, "o", "\u001b[?2004h> "]
[4195.798092, "o", "    print(f\"ROLLBACK {service} from {env} OK\")\r\n\u001b[?2004l\r"]
[4195.798149, "o", "\u001b[?2004h> "]
[4195.798204, "o", "'''\r\n\u001b[?2004l\r"]
[4195.798259, "o", "\u001b[?2004h> "]
[4195.798534, "o", "new_rollback = '''def cmd_rollback(args):\r\n\u001b[?2004l\r"]
[4195.798591, "o", "\u001b[?2004h> "]
[4195.799088, "o", "    values, flags, positionals = parse_opts(args, {\"--to-version\"}, set())\r\n\u001b[?2004l\r"]
[4195.799166, "o", "\u001b[?2004h> "]
[4195.799363, "o", "    if len(positionals) != 2:\r\n\u001b[?2004l\r"]
[4195.799445, "o", "\u001b[?2004h> "]
[4195.799845, "o", "        fail(\"rollback requires <environment> <service_name>\")\r\n\u001b[?2004l\r"]
[4195.79991, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4195.799964, "o", "\u001b[?2004h> "]
[4195.800173, "o", "    env, service = positionals\r\n\u001b[?2004l\r"]
[4195.800228, "o", "\u001b[?2004h> "]
[4195.800424, "o", "    data = load_manifest()\r\n\u001b[?2004l\r"]
[4195.800482, "o", "\u001b[?2004h> "]
[4195.800703, "o", "    _, envs = get_services(data)\r\n\u001b[?2004l\r"]
[4195.800759, "o", "\u001b[?2004h> "]
[4195.800925, "o", "    if env not in envs:\r\n\u001b[?2004l\r"]
[4195.800981, "o", "\u001b[?2004h> "]
[4195.801297, "o", "        fail(f\"environment not found: {env}\")\r\n\u001b[?2004l\r"]
[4195.801354, "o", "\u001b[?2004h> "]
[4195.801507, "o", "    ensure_state()\r\n\u001b[?2004l\r"]
[4195.801572, "o", "\u001b[?2004h> "]
[4195.801849, "o", "    state = load_deployment_state(env)\r\n\u001b[?2004l\r"]
[4195.801905, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4195.801967, "o", "\u001b[?2004h> "]
[4195.802168, "o", "    if service not in state:\r\n\u001b[?2004l\r"]
[4195.802244, "o", "\u001b[?2004h> "]
[4195.802687, "o", "        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n\u001b[?2004l\r"]
[4195.802764, "o", "\u001b[?2004h> "]
[4195.802878, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[4195.802946, "o", "\u001b[?2004h"]
[4195.803006, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.803377, "o", "    current_version = state[service].get(\"version\")\r\n\u001b[?2004l\r"]
[4195.803447, "o", "\u001b[?2004h> "]
[4195.80363, "o", "    if not current_version:\r\n\u001b[?2004l\r"]
[4195.803685, "o", "\u001b[?2004h> "]
[4195.804101, "o", "        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n\u001b[?2004l\r"]
[4195.804159, "o", "\u001b[?2004h> "]
[4195.804267, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[4195.804333, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4195.804397, "o", "\u001b[?2004h> "]
[4195.804641, "o", "    to_version = values.get(\"--to-version\")\r\n\u001b[?2004l\r"]
[4195.804698, "o", "\u001b[?2004h> "]
[4195.805172, "o", "    target_version = find_rollback_target(env, service, current_version, to_version)\r\n\u001b[?2004l\r"]
[4195.80523, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4195.805284, "o", "\u001b[?2004h> "]
[4195.805471, "o", "    if target_version is None:\r\n\u001b[?2004l\r"]
[4195.805531, "o", "\u001b[?2004h> "]
[4195.805681, "o", "        del state[service]\r\n\u001b[?2004l\r"]
[4195.805736, "o", "\u001b[?2004h> "]
[4195.805924, "o", "        save_deployment_state(env, state)\r\n\u001b[?2004l\r"]
[4195.80598, "o", "\u001b[?2004h> "]
[4195.806156, "o", "        append_event(env, \"ROLLBACK\", service, \"-\")\r\n\u001b[?2004l\r"]
[4195.806211, "o", "\u001b[?2004h> "]
[4195.806509, "o", "        print(f\"ROLLBACK {service} from {env}: {current_version} -> (removed)\")\r\n\u001b[?2004l\r"]
[4195.806566, "o", "\u001b[?2004h> "]
[4195.806626, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.806921, "o", "        state[service] = {\"version\": target_version, \"deployed_at\": now_iso()}\r\n\u001b[?2004l\r"]
[4195.806988, "o", "\u001b[?2004h> "]
[4195.807118, "o", "        save_deployment_state(env, state)\r\n\u001b[?2004l\r"]
[4195.807175, "o", "\u001b[?2004h> "]
[4195.807398, "o", "        append_event(env, \"ROLLBACK\", service, target_version)\r\n\u001b[?2004l\r"]
[4195.807463, "o", "\u001b[?2004h> "]
[4195.807757, "o", "        print(f\"ROLLBACK {service} from {env}: {current_version} -> {target_version}\")\r\n\u001b[?2004l\r"]
[4195.807821, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[4195.807848, "o", "\u001b[?2004h> "]
[4195.807949, "o", "if old_rollback not in s:\r\n\u001b[?2004l\r"]
[4195.808017, "o", "\u001b[?2004h> "]
[4195.808169, "o", "    raise SystemExit('rollback block not found')\r\n\u001b[?2004l\r"]
[4195.808235, "o", "\u001b[?2004h> "]
[4195.808368, "o", "s = s.replace(old_rollback, new_rollback)\r\n\u001b[?2004l\r"]
[4195.808432, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.808663, "o", "old_main = '''    print(f\"BUMP {service} {old} -> {new}\")\r\n\u001b[?2004l\r"]
[4195.808725, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.808788, "o", "def main():\r\n\u001b[?2004l\r"]
[4195.808882, "o", "\u001b[?2004h> '''\r\n"]
[4195.808945, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4195.809118, "o", "new_main = '''    print(f\"BUMP {service} {old} -> {new}\")\r\n\u001b[?2004l\r"]
[4195.80918, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.809285, "o", "def snapshot_file(env):\r\n\u001b[?2004l\r"]
[4195.809357, "o", "\u001b[?2004h> "]
[4195.809528, "o", "    return os.path.join(SNAPSHOTS_DIR, f\"{env}.json\")\r\n\u001b[?2004l\r"]
[4195.809585, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4195.809645, "o", "> "]
[4195.809703, "o", "def load_snapshots(env):\r\n\u001b[?2004l\r"]
[4195.809762, "o", "\u001b[?2004h> "]
[4195.809911, "o", "    return load_json(snapshot_file(env), [])\r\n\u001b[?2004l\r"]
[4195.809969, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4195.810029, "o", "> "]
[4195.810122, "o", "def save_snapshots(env, snapshots):\r\n\u001b[?2004l\r"]
[4195.810178, "o", "\u001b[?2004h> "]
[4195.810336, "o", "    save_json(snapshot_file(env), snapshots)\r\n\u001b[?2004l\r"]
[4195.810399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.810505, "o", "def cmd_snapshot(args):\r\n\u001b[?2004l\r"]
[4195.810561, "o", "\u001b[?2004h> "]
[4195.810802, "o", "    values, flags, positionals = parse_opts(args, set(), {\"--list\"})\r\n\u001b[?2004l\r"]
[4195.810857, "o", "\u001b[?2004h> "]
[4195.810953, "o", "    if len(positionals) != 1:\r\n\u001b[?2004l\r"]
[4195.811008, "o", "\u001b[?2004h> "]
[4195.811174, "o", "        fail(\"snapshot requires an environment\")\r\n\u001b[?2004l\r"]
[4195.81123, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4195.811289, "o", "> "]
[4195.811354, "o", "    env = positionals[0]\r\n\u001b[?2004l\r"]
[4195.811409, "o", "\u001b[?2004h> "]
[4195.811495, "o", "    data = load_manifest()\r\n\u001b[?2004l\r"]
[4195.81155, "o", "\u001b[?2004h> "]
[4195.811671, "o", "    _, envs = get_services(data)\r\n\u001b[?2004l\r"]
[4195.811744, "o", "\u001b[?2004h> "]
[4195.811801, "o", "    if env not in envs:\r\n\u001b[?2004l\r"]
[4195.811856, "o", "\u001b[?2004h> "]
[4195.812012, "o", "        fail(f\"environment not found: {env}\")\r\n\u001b[?2004l\r"]
[4195.812067, "o", "\u001b[?2004h> "]
[4195.812122, "o", "    ensure_state()\r\n\u001b[?2004l\r"]
[4195.812177, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4195.812233, "o", "> "]
[4195.812304, "o", "    if \"--list\" in flags:\r\n\u001b[?2004l\r"]
[4195.812336, "o", "\u001b[?2004h> "]
[4195.812494, "o", "        snapshots = load_snapshots(env)\r\n\u001b[?2004l\r"]
[4195.812562, "o", "\u001b[?2004h> "]
[4195.812649, "o", "        for snap in snapshots:\r\n\u001b[?2004l\r"]
[4195.812706, "o", "\u001b[?2004h> "]
[4195.812868, "o", "            services = snap.get(\"services\", {})\r\n\u001b[?2004l\r"]
[4195.812924, "o", "\u001b[?2004h> "]
[4195.81328, "o", "            print(f\"#{snap.get('id', '?')} {snap.get('timestamp', '')} ({len(services)} services)\")\r\n\u001b[?2004l\r"]
[4195.813352, "o", "\u001b[?2004h> "]
[4195.81341, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4195.813465, "o", "\u001b[?2004h> "]
[4195.813606, "o", "    state = load_deployment_state(env)\r\n\u001b[?2004l\r"]
[4195.813675, "o", "\u001b[?2004h> "]
[4195.81378, "o", "    snapshots = load_snapshots(env)\r\n\u001b[?2004l\r"]
[4195.813835, "o", "\u001b[?2004h> "]
[4195.813902, "o", "    next_id = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.814052, "o", "    for snap in snapshots:\r\n\u001b[?2004l\r\u001b[?2004h"]
[4195.814141, "o", "> "]
[4195.814396, "o", "        if isinstance(snap.get(\"id\"), int) and snap[\"id\"] >= next_id:\r\n\u001b[?2004l\r"]
[4195.814466, "o", "\u001b[?2004h> "]
[4195.814626, "o", "            next_id = snap[\"id\"] + 1\r\n\u001b[?2004l\r"]
[4195.814703, "o", "\u001b[?2004h> "]
[4195.814813, "o", "    timestamp = now_iso()\r\n\u001b[?2004l\r"]
[4195.814854, "o", "\u001b[?2004h> "]
[4195.815162, "o", "    snapshot = {\"id\": next_id, \"timestamp\": timestamp, \"services\": state}\r\n\u001b[?2004l\r"]
[4195.815231, "o", "\u001b[?2004h> "]
[4195.81538, "o", "    snapshots.append(snapshot)\r\n\u001b[?2004l\r"]
[4195.815442, "o", "\u001b[?2004h> "]
[4195.815593, "o", "    save_snapshots(env, snapshots)\r\n\u001b[?2004l\r"]
[4195.815633, "o", "\u001b[?2004h> "]
[4195.815908, "o", "    print(f\"SNAPSHOT {env} #{next_id} ({len(state)} services)\")\r\n\u001b[?2004l\r"]
[4195.815971, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4195.816041, "o", "\u001b[?2004h> "]
[4195.816102, "o", "def cmd_restore(args):\r\n\u001b[?2004l\r"]
[4195.816153, "o", "\u001b[?2004h> "]
[4195.816328, "o", "    values, flags, positionals = parse_opts(args, set(), set())\r\n\u001b[?2004l\r"]
[4195.816384, "o", "\u001b[?2004h> "]
[4195.816472, "o", "    if len(positionals) != 2:\r\n\u001b[?2004l\r"]
[4195.816536, "o", "\u001b[?2004h> "]
[4195.816686, "o", "        fail(\"restore requires <environment> <snapshot_id>\")\r\n\u001b[?2004l\r"]
[4195.816745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.816872, "o", "    env, snapshot_id_str = positionals\r\n\u001b[?2004l\r"]
[4195.816934, "o", "\u001b[?2004h> "]
[4195.817002, "o", "    data = load_manifest()\r\n\u001b[?2004l\r"]
[4195.817027, "o", "\u001b[?2004h> "]
[4195.817151, "o", "    _, envs = get_services(data)\r\n\u001b[?2004l\r"]
[4195.817204, "o", "\u001b[?2004h> "]
[4195.81727, "o", "    if env not in envs:\r\n\u001b[?2004l\r"]
[4195.817338, "o", "\u001b[?2004h> "]
[4195.817446, "o", "        fail(f\"environment not found: {env}\")\r\n\u001b[?2004l\r"]
[4195.817498, "o", "\u001b[?2004h> "]
[4195.817551, "o", "    ensure_state()\r\n\u001b[?2004l\r"]
[4195.817603, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4195.817676, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[4195.81773, "o", "> "]
[4195.81783, "o", "        snapshot_id = int(snapshot_id_str)\r\n\u001b[?2004l\r"]
[4195.817883, "o", "\u001b[?2004h> "]
[4195.817947, "o", "    except ValueError:\r\n\u001b[?2004l\r"]
[4195.817999, "o", "\u001b[?2004h> "]
[4195.818122, "o", "        fail(\"snapshot id must be an integer\")\r\n\u001b[?2004l\r"]
[4195.818182, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.818301, "o", "    snapshots = load_snapshots(env)\r\n\u001b[?2004l\r"]
[4195.818362, "o", "\u001b[?2004h> "]
[4195.818413, "o", "    snapshot = None\r\n\u001b[?2004l\r"]
[4195.818472, "o", "\u001b[?2004h> "]
[4195.818542, "o", "    for snap in snapshots:\r\n\u001b[?2004l\r"]
[4195.818602, "o", "\u001b[?2004h> "]
[4195.818707, "o", "        if snap.get(\"id\") == snapshot_id:\r\n\u001b[?2004l\r"]
[4195.818766, "o", "\u001b[?2004h> "]
[4195.818837, "o", "            snapshot = snap\r\n\u001b[?2004l\r"]
[4195.818897, "o", "\u001b[?2004h> "]
[4195.818941, "o", "            break\r\n\u001b[?2004l\r"]
[4195.818991, "o", "\u001b[?2004h> "]
[4195.819067, "o", "    if snapshot is None:\r\n\u001b[?2004l\r"]
[4195.819118, "o", "\u001b[?2004h> "]
[4195.819256, "o", "        fail(f\"snapshot not found: #{snapshot_id}\")\r\n\u001b[?2004l\r"]
[4195.819351, "o", "\u001b[?2004h"]
[4195.819407, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.819487, "o", "    recorded = snapshot.get(\"services\", {})\r\n\u001b[?2004l\r"]
[4195.819553, "o", "\u001b[?2004h> "]
[4195.819607, "o", "    state = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.819725, "o", "    for svc, rec in recorded.items():\r\n\u001b[?2004l\r"]
[4195.819778, "o", "\u001b[?2004h> "]
[4195.819863, "o", "        state[svc] = dict(rec)\r\n\u001b[?2004l\r"]
[4195.819919, "o", "\u001b[?2004h> "]
[4195.820011, "o", "    save_deployment_state(env, state)\r\n\u001b[?2004l\r"]
[4195.820063, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4195.820116, "o", "\u001b[?2004h> "]
[4195.820194, "o", "    for svc in sorted(state):\r\n\u001b[?2004l\r"]
[4195.820254, "o", "\u001b[?2004h> "]
[4195.820382, "o", "        version = state[svc].get(\"version\", \"\")\r\n\u001b[?2004l\r"]
[4195.820442, "o", "\u001b[?2004h> "]
[4195.820633, "o", "        append_event(env, \"RESTORE\", svc, version, snapshot_id=snapshot_id)\r\n\u001b[?2004l\r"]
[4195.820686, "o", "\u001b[?2004h> "]
[4195.820822, "o", "        print(f\"RESTORE {svc} -> {env} ({version})\")\r\n\u001b[?2004l\r"]
[4195.820875, "o", "\u001b[?2004h> "]
[4195.821066, "o", "    print(f\"Restored {len(state)} services from snapshot #{snapshot_id}\")\r\n\u001b[?2004l\r"]
[4195.821119, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.821176, "o", "def main():\r\n\u001b[?2004l\r"]
[4195.821236, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[4195.821289, "o", "\u001b[?2004h> "]
[4195.821354, "o", "if old_main not in s:\r\n\u001b[?2004l\r"]
[4195.821417, "o", "\u001b[?2004h> "]
[4195.821536, "o", "    raise SystemExit('main block not found')\r\n\u001b[?2004l\r"]
[4195.821587, "o", "\u001b[?2004h> "]
[4195.821676, "o", "s = s.replace(old_main, new_main)\r\n\u001b[?2004l\r"]
[4195.8217, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4195.821828, "o", "\u001b[?2004h> "]
[4195.821959, "o", "old_dispatch = '''    elif cmd == 'bump':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.822029, "o", "        cmd_bump(args)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4195.822092, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[4195.82215, "o", "> "]
