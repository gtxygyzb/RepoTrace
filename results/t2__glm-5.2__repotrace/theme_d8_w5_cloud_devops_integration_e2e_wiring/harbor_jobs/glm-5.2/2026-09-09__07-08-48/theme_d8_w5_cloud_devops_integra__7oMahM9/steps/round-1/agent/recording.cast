[7494.110244, "o", "def main():\r\n    if len(sys.argv) < 2:\r\n        fail(\"no command given\")\r\n\r\n    cmd = sys.argv[1]\r\n    args = sys.argv[2:]\r\n\r\n"]
[7494.110487, "o", "    if cmd == 'validate':\r\n        cmd_validate(args)\r\n    elif cmd == 'order':\r\n        cmd_order(args)\r\n    elif cmd == 'build':\r\n        cmd_build(args)\r\n    elif cmd == 'test':\r\n"]
[7494.110613, "o", "        cmd_test(args)\r\n    elif cmd == 'deploy':\r\n        cmd_deploy(args)\r\n    elif cmd == 'status':\r\n        cmd_status(args)\r\n    elif cmd == 'rollback':\r\n        cmd_rollback(args)\r\n    elif cmd == 'promote':\r\n        cmd_promote(args)\r\n    elif cmd == 'diff':\r\n        cmd_diff(args)\r\n    elif cmd == 'history':\r\n        cmd_history(args)\r\n    elif cmd == 'graph':\r\n        cmd_graph(args)\r\n    elif cmd == 'bump':\r\n        cmd_bump(args)\r\n    elif cmd == 'snapshot':\r\n        cmd_snapshot(args)\r\n    elif cmd == 'restore':\r\n        cmd_restore(args)\r\n    elif cmd == 'lock':\r\n        cmd_lock(args)\r\n    elif cmd == 'unlock':\r\n        cmd_unlock(args)\r\n    elif cmd == 'config':\r\n        cmd_config(args)\r\n    else:\r\n        fail(f\"unknown command: {cmd}\")\r\n\r\nif __name__ == '__main__':\r\n    main()\r\nPY\r\npython3 \"$tmp_script\" \"$@\"\r\n"]
