[9482.427673, "o", "   282\tdef parse_positive_int(s):\r\n   283\t    if not isinstance(s, str):\r\n   284\t        return None\r\n   285\t    if not re.fullmatch('[0-9]+', s):\r\n   286\t        return None\r\n   287\t    val = int(s)\r\n   288\t    if val < 1:\r\n   289\t        return None\r\n   290\t    return val\r\n   291\t\r\n   292\t\r\n"]
[9482.427866, "o", "   293\tdef event_file(env):\r\n   294\t    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n   295\t\r\n   296\tdef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n   297\t    ensure_state()\r\n   298\t    ts = now_iso()\r\n   299\t    line = f\"{ts} {action} {service} {version}\"\r\n   300\t    if action == \"PROMOTE\" and source_env is not None:\r\n   301\t        line += f\" from {source_env}\"\r\n   302\t        if forced:\r\n   303\t            line += \" (forced)\"\r\n   304\t    if action == \"RESTORE\" and snapshot_id is not None:\r\n   305\t        line += f\" from snapshot #{snapshot_id}\"\r\n   306\t    line += \"\\n\"\r\n   307\t    with open(event_file(env), \"a\") as f:\r\n   308\t        f.write(line)\r\n   309\t\r\n   310\tdef append_scale_event(env, service, count, previous):\r\n   311\t    ensure_state()\r\n   312\t    event = {\r\n   313\t        \"timestamp\": int(time.time()),\r\n   314\t        \"iso_timestamp\": now_iso(),\r\n   315\t        \"action\": \"SCALE\",\r\n   316\t        \"service\": service,\r\n   317\t        \"version\": \""]
[9482.427975, "o", "-\",\r\n   318\t        \"replicas\": count,\r\n   319\t        \"previous\": previous,\r\n   320\t    }\r\n   321\t    with open(event_file(env), \"a\") as f:\r\n   322\t        f.write(json.dumps(event) + chr(10))\r\n   323\t\r\n   324\tdef load_events(env):\r\n   325\t    ensure_state()\r\n   326\t    try:\r\n   327\t        with open(event_file(env)) as f:\r\n   328\t            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n   329\t    except FileNotFoundError:\r\n   330\t        return []\r\n"]
