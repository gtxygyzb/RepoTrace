[4412.97508, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/app/pipeline.sh')\ns = p.read_text()\nold = '''def find_rollback_target(env, service, current_version, to_version=None):\n    events = load_events(env)\n\n    if to_version is not None:\n        for ev in reversed(events):\n            if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] == to_version:\n                return to_version\n        fail(f\"version not found in history for {service}\")\n\n    current_indices = [\n        idx for idx, ev in enumerate(events)\n        if ev[\"service\"] == service\n        and ev[\"version\"] == current_version\n        and not (ev[\"action\"] == \"ROLLBACK\" and ev[\"version\"] == \"-\")\n    ]\n    if not current_indices:\n        return None\n    current_idx = current_indices[-1]\n\n    for ev in reversed(events[:current_idx]):\n        if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\":\n            return ev[\"version\"]\n    return None\n'''\nnew = '''def find_rollback_target(env, service, current_version, to_version"]
[4412.975341, "i", "=None):\n    events = load_events(env)\n\n    if to_version is not None:\n        for ev in reversed(events):\n            if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] == to_version:\n                return to_version\n        fail(f\"version not found in history for {service}\")\n\n    current_idx = None\n    for idx, ev in enumerate(events):\n        if ev[\"service\"] != service:\n            continue\n        if ev[\"version\"] != current_version:\n            continue\n        if ev[\"action\"] == \"ROLLBACK\" and ev[\"version\"] == \"-\":\n            continue\n        current_idx = idx\n\n    if current_idx is None:\n        return None\n\n    for ev in reversed(events[:current_idx]):\n        if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] != current_version:\n            return ev[\"version\"]\n    return None\n'''\nif old not in s:\n    raise SystemExit('find_rollback_target block not found')\ns = s.replace(old, new, 1)\np.write_text(s)\nPY\nbash -n pipeline.sh\n"]
