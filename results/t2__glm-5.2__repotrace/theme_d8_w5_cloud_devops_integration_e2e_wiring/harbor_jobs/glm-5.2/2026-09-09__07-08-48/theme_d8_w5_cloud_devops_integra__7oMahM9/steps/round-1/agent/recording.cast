[13281.906549, "o", "\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Know_iso():\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_json(path, default):\r\n\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksave_json(path, data):\r\n"]
[13281.906624, "o", "\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_manifest():\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kvalidate_manifest(data):\r\n\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kfind_cycle(services):\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kget_services(data):\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktopo_order(services, subset=None):\r\n\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbuild_waves(services, subset):\r\n"]
[13281.906704, "o", "\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktransitive_deps(services, name):\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kservice_path(svc):\r\n"]
[13281.906779, "o", "\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kartifact_path(svc):\r\n\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kread_artifact(svc):\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kdeployment_file(env):\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_deployment_state(env):\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksave_deployment_state(env, state):\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kreplica_file(env):\r\n\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_replicas(env):\r\n\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksave_replicas(env, replicas):\r\n\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbounds_file(env):\r\n\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_bounds(env):\r\n\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksave_bounds(env, bounds):\r\n\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Khealth_file(env):\r\n\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_health(env):\r\n"]
[13281.906849, "o", "\u001b[32m\u001b[K279\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksave_health(env, data):\r\n\u001b[32m\u001b[K282\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kis_valid_health_state(state):\r\n\u001b[32m\u001b[K285\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kget_health_state(env, service):\r\n\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kreset_health(env, service):\r\n\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kreset_all_health(env):\r\n"]
[13281.906909, "o", "\u001b[32m\u001b[K307\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kappend_health_event(env, service, new_state, previous_state):\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kget_replica_count(env, service):\r\n"]
[13281.90697, "o", "\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kget_env_max(envs, env):\r\n\u001b[32m\u001b[K334\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kparse_positive_int(s):\r\n\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kevent_file(env):\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kappend_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kappend_scale_event(env, service, count, previous):\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_events(env):\r\n\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Klock_file(env):\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_lock(env):\r\n"]
