[3403.994193, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3403.994248, "o", "\u001b[?2004h> "]
[3403.994416, "o", "for old, new in replacements:\r\n\u001b[?2004l\r"]
[3403.994473, "o", "\u001b[?2004h> "]
