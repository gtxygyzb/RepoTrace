[9428.848049, "o", "\r\n    for s in order:\r\n        rec = test_results.get(s)\r\n        if not rec or not rec.get(\"pass\"):\r\n            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n            any_fail = True\r\n            break\r\n\r\n        version = read_artifact(services[s])\r\n        if version is None:\r\n            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n            any_fail = True\r\n            break\r\n\r\n        state[s] = {\"version\": version, \"deployed_at\": now_iso()}\r\n        replicas[s] = 1\r\n        deployed_events.append((s, version))\r\n"]
[9428.848138, "o", "        print(f\"DEPLOY {s} -> {env} OK\")\r\n\r\n    save_deployment_state(env, state)\r\n    save_replicas(env, replicas)\r\n    for s, version in deployed_events:\r\n        append_event(env, \"DEPLOY\", s, version)\r\n    if any_fail:\r\n        sys.exit(1)\r\n\r\ndef cmd_status(args):\r\n    if len(args) > 1:\r\n        fail(\"status takes at most one environment argument\")\r\n\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n\r\n    if args:\r\n        env = args[0]\r\n"]
[9428.848222, "o", "        if env not in envs:\r\n            fail(f\"environment not found: {env}\")\r\n        lock = load_lock(env)\r\n        if lock is not None:\r\n            print(f\"[LOCKED: {lock.get('reason', 'manual lock')}]\")\r\n        cfg = load_config(env)\r\n        if cfg:\r\n            print(f\"Config: {len(cfg)} variables\")\r\n        state = load_deployment_state(env)\r\n        for s in sorted(state):\r\n            rec = state[s]\r\n            print(f\"{s}: {rec.get('version', '')} (deployed at {rec.get('deployed_at', '')}) [{get_replica_count(env, s)} replicas]\")\r\n    else:\r\n        for env in sorted(envs):\r\n            state = load_deployment_state(env)\r\n            print(f\"{env}: {len(state)} services deployed\")\r\n"]
[9428.848337, "o", "\r\ndef cmd_rollback(args):\r\n    values, flags, positionals = parse_opts(args, {\"--to-version\"}, set())\r\n    if len(positionals) != 2:\r\n        fail(\"rollback requires <environment> <service_name>\")\r\n\r\n    env, service = positionals\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n    assert_not_locked(env)\r\n    ensure_state()\r\n    state = load_deployment_state(env)\r\n    replicas = load_replicas(env)\r\n\r\n    if service not in state:\r\n        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n        sys.exit(1)\r\n"]
[9428.848412, "o", "\r\n    current_version = state[service].get(\"version\")\r\n    if not current_version:\r\n        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n        sys.exit(1)\r\n\r\n    to_version = values.get(\"--to-version\")\r\n    target_version = find_rollback_target(env, service, current_version, to_version)\r\n\r\n    if target_version is None:\r\n        del state[service]\r\n        if service in replicas:\r\n            del replicas[service]\r\n        save_deployment_state(env, state)\r\n        save_replicas(env, replicas)\r\n        append_event(env, \"ROLLBACK\", service, \"-\")\r\n        print(f\"ROLLBACK {service} from {env}: {current_version} -> (removed)\")\r\n    else:\r\n"]
[9428.848486, "o", "        state[service] = {\"version\": target_version, \"deployed_at\": now_iso()}\r\n        replicas[service] = 1\r\n        save_deployment_state(env, state)\r\n        save_replicas(env, replicas)\r\n        append_event(env, \"ROLLBACK\", service, target_version)\r\n        print(f\"ROLLBACK {service} from {env}: {current_version} -> {target_version}\")\r\n\r\ndef valid_version(v):\r\n    if not isinstance(v, str):\r\n        return False\r\n    parts = v.split('.')\r\n    if len(parts) != 3:\r\n        return False\r\n    for part in parts:\r\n        if not part.isdigit() or (part != '0' and part.startswith('0')):\r\n            return False\r\n    return True\r\n\r\ndef parse_semver(v):\r\n"]
[9428.848558, "o", "    if not valid_version(v):\r\n        return None\r\n    return tuple(int(x) for x in v.split('.'))\r\n\r\ndef extract_semver(version):\r\n    if not isinstance(version, str):\r\n        return None\r\n    semver = version.split(':', 1)[1] if ':' in version else version\r\n    if '+build.' in semver:\r\n        semver = semver.split('+build.', 1)[0]\r\n    return parse_semver(semver)\r\n\r\ndef semver_string(version):\r\n    sv = extract_semver(version)\r\n    if sv is None:\r\n        return None\r\n    return f\"{sv[0]}.{sv[1]}.{sv[2]}\"\r\n"]
[9428.848625, "o", "\r\ndef version_build_timestamp(version):\r\n    if not isinstance(version, str) or '+build.' not in version:\r\n        return None\r\n    after = version.split('+build.', 1)[1]\r\n"]
