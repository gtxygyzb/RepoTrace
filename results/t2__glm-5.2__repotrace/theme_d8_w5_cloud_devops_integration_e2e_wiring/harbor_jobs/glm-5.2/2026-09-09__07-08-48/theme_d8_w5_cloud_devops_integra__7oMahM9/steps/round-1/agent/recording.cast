[8521.318532, "o", "                append_scale_event(env, service, bmax, previous)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.318717, "o", "                print(f\"SCALED {env}/{service} to {bmax} replicas (was {previous})\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.318778, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.318837, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
