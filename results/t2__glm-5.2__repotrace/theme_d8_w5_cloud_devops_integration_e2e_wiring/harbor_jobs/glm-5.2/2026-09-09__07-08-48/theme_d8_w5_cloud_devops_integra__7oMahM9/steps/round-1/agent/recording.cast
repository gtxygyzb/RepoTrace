[3413.247268, "o", "\u001b[?2004l\r"]
[3413.25092, "o", "   239\tdef append_event(env, action, service, version, source_env=None):\r\n   240\t    ensure_state()\r\n   241\t    ts = now_iso()\r\n   242\t    line = f\"{ts} {action} {service} {version}\"\r\n   243\t    if action == \"PROMOTE\" and source_env is not None:\r\n   244\t        line += f\" from {source_env}\"\r\n   245\t    line += \"\\n\"\r\n   246\t    with open(event_file(env), \"a\") as f:\r\n   247\t        f.write(line)\r\n"]
[3413.251068, "o", "   248\t\r\n   249\tdef parse_opts(args, value_opts, flag_opts):\r\n   250\t    values = {}\r\n   251\t    flags = set()\r\n   252\t    positionals = []\r\n"]
