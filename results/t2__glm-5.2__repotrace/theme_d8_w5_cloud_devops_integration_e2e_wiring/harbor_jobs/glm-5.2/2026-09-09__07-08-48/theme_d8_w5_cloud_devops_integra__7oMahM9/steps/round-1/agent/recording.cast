[9421.608932, "o", "\r\ndef print_tree(node, services, path, depth):\r\n    print(\"  \" * depth + node)\r\n    if node in path:\r\n        return\r\n    path = path | {node}\r\n    children = sorted([s for s in services if node in services[s].get('depends_on', [])])\r\n    for child in children:\r\n        print_tree(child, services, path, depth + 1)\r\n\r\ndef cmd_graph(args):\r\n    values, flags, positionals = parse_opts(args, {'--format'}, set())\r\n"]
[9421.608989, "o", "    if positionals:\r\n        fail(\"graph does not accept positional arguments\")\r\n\r\n    fmt = values.get('--format', 'text')\r\n    if fmt not in ('dot', 'text'):\r\n        fail(\"graph format must be dot or text\")\r\n\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n\r\n    if fmt == 'dot':\r\n        print(\"digraph pipeline {\")\r\n        for dep in sorted(services):\r\n"]
