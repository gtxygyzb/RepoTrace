[11888.719097, "o", "old_scale_all = \"\"\"        for s in sorted(state):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.719256, "o", "            if get_health_state(env, s) == \"unhealthy\" and count > replicas.get(s, 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.719396, "o", "                fail(f\"cannot scale up unhealthy service '{s}' in {env}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.719465, "o", "        assert_not_locked(env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.719535, "o", "        for s in sorted(state):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.719621, "o", "            previous = replicas.get(s, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.719676, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.719755, "o", "new_scale_all = \"\"\"        for s in sorted(state):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.719911, "o", "            if get_health_state(env, s) == \"unhealthy\" and count > replicas.get(s, 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.720046, "o", "                fail(f\"cannot scale up unhealthy service '{s}' in {env}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.720114, "o", "        assert_not_locked(env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.720186, "o", "        quotas = load_quotas(env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
