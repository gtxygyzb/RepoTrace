[11410.224852, "o", "\u001b[32m\u001b[K1409\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd_scale\u001b[m\u001b[K(args):\r\n\u001b[32m\u001b[K1434\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            fail(f\"{count} exceeds max_\u001b[01;31m\u001b[Kreplicas\u001b[m\u001b[K ({env_max}) for {env}\")\r\n\u001b[32m\u001b[K1436\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kreplicas\u001b[m\u001b[K = load_\u001b[01;31m\u001b[Kreplicas\u001b[m\u001b[K(env)\r\n\u001b[32m\u001b[K1444\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if get_health_state(env, s) == \"unhealthy\" and count > \u001b[01;31m\u001b[Kreplicas\u001b[m\u001b[K.get(s, 1):\r\n\u001b[32m\u001b[K1448\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            previous = \u001b[01;31m\u001b[Kreplicas\u001b[m\u001b[K.get(s, 1)\r\n\u001b[32m\u001b[K1449\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kreplicas\u001b[m\u001b[K[s] = count\r\n\u001b[32m\u001b[K1451\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            print(f\"SCALED {env}/{s} to {count} \u001b[01;31m\u001b[Kreplicas\u001b[m\u001b[K (was {previous})\")\r\n\u001b[32m\u001b[K1452\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        save_\u001b[01;31m\u001b[Kreplicas\u001b[m\u001b[K(env, \u001b[01;31m\u001b[Kreplicas\u001b[m\u001b[K)\r\n"]
