[11447.394845, "o", "   192\t        for dep in services[s].get('depends_on', []):\r\n   193\t            if dep in subset:\r\n   194\t                adj[dep].append(s)\r\n   195\t                in_degree[s] += 1\r\n   196\t\r\n   197\t    waves = []\r\n   198\t    available = sorted([s for s in subset if in_degree[s] == 0])\r\n   199\t    while available:\r\n   200\t        waves.append(available)\r\n   201\t        next_available = []\r\n   202\t        for s in available:\r\n"]
