[4412.984359, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[4412.984427, "o", "\u001b[?2004h> "]
[4412.984905, "o", "new = '''def find_rollback_target(env, service, current_version, to_version=None):\r\n\u001b[?2004l\r"]
[4412.984977, "o", "\u001b[?2004h> "]
[4412.985139, "o", "    events = load_events(env)\r\n\u001b[?2004l\r"]
[4412.985205, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4412.985273, "o", "\u001b[?2004h> "]
[4412.985456, "o", "    if to_version is not None:\r\n\u001b[?2004l\r"]
[4412.985531, "o", "\u001b[?2004h> "]
[4412.985726, "o", "        for ev in reversed(events):\r\n\u001b[?2004l\r"]
[4412.985794, "o", "\u001b[?2004h> "]
[4412.986318, "o", "            if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] == to_version:\r\n\u001b[?2004l\r"]
[4412.986399, "o", "\u001b[?2004h> "]
[4412.986526, "o", "                return to_version\r\n\u001b[?2004l\r"]
[4412.986593, "o", "\u001b[?2004h> "]
[4412.986838, "o", "        fail(f\"version not found in history for {service}\")\r\n\u001b[?2004l\r"]
[4412.986905, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4412.986973, "o", "> "]
[4412.987039, "o", "    current_idx = None\r\n\u001b[?2004l\r"]
[4412.987108, "o", "\u001b[?2004h> "]
[4412.987254, "o", "    for idx, ev in enumerate(events):\r\n\u001b[?2004l\r"]
[4412.987334, "o", "\u001b[?2004h> "]
[4412.987477, "o", "        if ev[\"service\"] != service:\r\n\u001b[?2004l\r"]
[4412.987544, "o", "\u001b[?2004h> "]
[4412.98762, "o", "            continue\r\n\u001b[?2004l\r"]
[4412.987686, "o", "\u001b[?2004h> "]
[4412.987864, "o", "        if ev[\"version\"] != current_version:\r\n\u001b[?2004l\r"]
[4412.987931, "o", "\u001b[?2004h> "]
[4412.988007, "o", "            continue\r\n\u001b[?2004l\r"]
[4412.988081, "o", "\u001b[?2004h> "]
[4412.988344, "o", "        if ev[\"action\"] == \"ROLLBACK\" and ev[\"version\"] == \"-\":\r\n\u001b[?2004l\r"]
[4412.988411, "o", "\u001b[?2004h> "]
[4412.988487, "o", "            continue\r\n\u001b[?2004l\r"]
[4412.988554, "o", "\u001b[?2004h> "]
[4412.988647, "o", "        current_idx = idx\r\n\u001b[?2004l\r"]
[4412.988715, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4412.988865, "o", "    if current_idx is None:\r\n\u001b[?2004l\r"]
[4412.988935, "o", "\u001b[?2004h> "]
[4412.989006, "o", "        return None\r\n\u001b[?2004l\r"]
[4412.989073, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4412.989306, "o", "    for ev in reversed(events[:current_idx]):\r\n\u001b[?2004l\r"]
[4412.989386, "o", "\u001b[?2004h> "]
[4412.98982, "o", "        if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] != current_version:\r\n\u001b[?2004l\r"]
[4412.989887, "o", "\u001b[?2004h> "]
[4412.990018, "o", "            return ev[\"version\"]\r\n\u001b[?2004l\r"]
[4412.990085, "o", "\u001b[?2004h> "]
[4412.990158, "o", "    return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4412.990223, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4412.990338, "o", "if old not in s:\r\n\u001b[?2004l\r"]
[4412.990406, "o", "\u001b[?2004h> "]
[4412.99066, "o", "    raise SystemExit('find_rollback_target block not found')\r\n\u001b[?2004l\r"]
[4412.990726, "o", "\u001b[?2004h> "]
[4412.990834, "o", "s = s.replace(old, new, 1)\r\n\u001b[?2004l\r"]
[4412.9909, "o", "\u001b[?2004h> "]
[4412.990972, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4412.991038, "o", "PY\r\n\u001b[?2004l\r"]
