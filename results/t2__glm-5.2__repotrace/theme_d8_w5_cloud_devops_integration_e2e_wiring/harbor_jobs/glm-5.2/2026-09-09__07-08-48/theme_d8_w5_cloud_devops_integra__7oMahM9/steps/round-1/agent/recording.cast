[5648.262805, "o", "def cmd_lock(args):\r\n    values, flags, positionals = parse_opts(args, {'--reason'}, {'--list'})\r\n    if '--list' in flags:\r\n        data = load_manifest()\r\n        _, envs = get_services(data)\r\n        ensure_state()\r\n        locked = []\r\n        for env in envs:\r\n            lock = load_lock(env)\r\n            if lock is not None:\r\n                locked.append((env, lock.get('reason', 'manual lock'), lock.get('locked_since', '')))\r\n        for env, reason, since in sorted(locked):\r\n            print(f\"{env}: {reason} (locked since {since})\")\r\n"]
[5648.262858, "o", "        return\r\n    if len(positionals) != 1:\r\n        fail(\"lock requires <environment> [--reason REASON] or --list\")\r\n    env = positionals[0]\r\n    reason = values.get('--reason', 'manual lock')\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"unknown environment {env}\")\r\n    ensure_state()\r\n"]
[5648.26291, "o", "    save_lock(env, reason)\r\n    append_lock_event(env, reason)\r\n    print(f\"LOCKED {env}: {reason}\")\r\n\r\ndef cmd_unlock(args):\r\n    values, flags, positionals = parse_opts(args, set(), set())\r\n    if len(positionals) != 1:\r\n        fail(\"unlock requires <environment>\")\r\n    env = positionals[0]\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"unknown environment {env}\")\r\n    ensure_state()\r\n"]
[5648.26296, "o", "    remove_lock(env)\r\n    append_unlock_event(env)\r\n    print(f\"UNLOCKED {env}\")\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        fail(\"no command given\")\r\n\r\n    cmd = sys.argv[1]\r\n    args = sys.argv[2:]\r\n\r\n    if cmd == 'validate':\r\n        cmd_validate(args)\r\n    elif cmd == 'order':\r\n"]
[5648.263012, "o", "        cmd_order(args)\r\n    elif cmd == 'build':\r\n        cmd_build(args)\r\n    elif cmd == 'test':\r\n        cmd_test(args)\r\n    elif cmd == 'deploy':\r\n        cmd_deploy(args)\r\n    elif cmd == 'status':\r\n        cmd_status(args)\r\n    elif cmd == 'rollback':\r\n        cmd_rollback(args)\r\n    elif cmd == 'promote':\r\n        cmd_promote(args)\r\n"]
[5648.263063, "o", "    elif cmd == 'diff':\r\n        cmd_diff(args)\r\n    elif cmd == 'history':\r\n        cmd_history(args)\r\n    elif cmd == 'graph':\r\n        cmd_graph(args)\r\n    elif cmd == 'bump':\r\n        cmd_bump(args)\r\n    elif cmd == 'snapshot':\r\n        cmd_snapshot(args)"]
