[3403.845311, "o", ">     (\r\n\u001b[?2004l\r"]
[3403.845578, "o", "\u001b[?2004h> "]
[3403.845874, "o", "        \"\"\"def version_timestamp(version):\r\n\u001b[?2004l\r"]
[3403.84595, "o", "\u001b[?2004h> "]
[3403.846266, "o", "    if not isinstance(version, str):\r\n\u001b[?2004l\r"]
[3403.846338, "o", "\u001b[?2004h> "]
[3403.846475, "o", "        return None\r\n\u001b[?2004l\r"]
[3403.846533, "o", "\u001b[?2004h> "]
[3403.846759, "o", "    parts = version.split(\":\")\r\n\u001b[?2004l\r"]
[3403.846819, "o", "\u001b[?2004h> "]
[3403.846947, "o", "    if len(parts) >= 3:\r\n\u001b[?2004l\r"]
[3403.847002, "o", "\u001b[?2004h> "]
[3403.847056, "o", "        try:\r\n\u001b[?2004l\r"]
[3403.847111, "o", "\u001b[?2004h> "]
[3403.847272, "o", "            return int(parts[1])\r\n\u001b[?2004l\r"]
[3403.847351, "o", "\u001b[?2004h> "]
[3403.847462, "o", "        except ValueError:\r\n\u001b[?2004l\r"]
[3403.847483, "o", "\u001b[?2004h"]
[3403.847504, "o", "> "]
[3403.847625, "o", "            return None\r\n\u001b[?2004l\r"]
[3403.847646, "o", "\u001b[?2004h> "]
[3403.847729, "o", "    return None\r\n\u001b[?2004l\r"]
[3403.847749, "o", "\u001b[?2004h> "]
[3403.84777, "o", "\"\"\",\r\n\u001b[?2004l\r"]
[3403.847791, "o", "\u001b[?2004h> "]
[3403.847912, "o", "        \"\"\"def valid_version(v):\r\n\u001b[?2004l\r"]
[3403.847955, "o", "\u001b[?2004h> "]
[3403.848047, "o", "    if not isinstance(v, str):\r\n\u001b[?2004l\r"]
[3403.848069, "o", "\u001b[?2004h> "]
[3403.886934, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h>     parts = v.split('.')\r\n\u001b[?2004l\r\u001b[?2004h>     if len(parts) != 3:\r\n\u001b[?2004l\r\u001b[?2004h>         return False\r\n\u001b[?2004l\r\u001b[?2004h>     for part in parts:\r\n\u001b[?2004l\r\u001b[?2004h>         if not part.isdigit() or (part != '0' and part.startswith('0')):\r\n\u001b[?2004l\r\u001b[?2004h>             return False\r\n\u001b[?2004l\r\u001b[?2004h>     return True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r)\u001b[?2004h> def parse_semver(v):\r\n\u001b[?2004l\r\u001b[?2004h>     if not valid_version(v):\r\n\u001b[?2004l\r\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h>     return tuple(int(x) for x in v.split('.'))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> def extract_semver(version):\r\n\u001b[?2004l\r\u001b[?2004h>     if not isinstance(version, str):\r\n\u001b[?2004l\r\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h>     semver = version.split(':', 1)[1] if ':' in version else version\r\n\u001b[?2004l\r\u001b[?2004h>     if '+build.' in semver:\r\n\u001b[?2004l\r\u001b[?2004h>         semver = semver.split('+build.', 1)[0]\r\n\u001b[?2004l\r\u001b[?2004h>     return parse_semver(semver)\r\n\u001b[?2004l\r\u001b[?"]
[3403.887047, "o", "2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def semver_string(version):\r\n\u001b[?2004l\r\u001b[?2004h>     sv = extract_semver(version)\r\n\u001b[?2004l\r\u001b[?2004h>     if sv is None:\r\n\u001b[?2004l\r\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h>     return f\"{sv[0]}.{sv[1]}.{sv[2]}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h> def version_build_timestamp(version):\r\n\u001b[?2004l\r\u001b[?2004h>     if not isinstance(version, str) or '+build.' not in version:\r\n\u001b[?2004l\r\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h>     after = version.split('+build.', 1)[1]\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         return int(after)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.887144, "o", "    except ValueError:\r\n\u001b[?2004l\r"]
[3403.887214, "o", "\u001b[?2004h> "]
[3403.887346, "o", "        return None\r\n\u001b[?2004l\r"]
[3403.887409, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3403.887471, "o", "\u001b[?2004h> "]
[3403.887654, "o", "def compare_versions(a, b):\r\n\u001b[?2004l\r"]
[3403.887692, "o", "\u001b[?2004h> "]
[3403.887889, "o", "    sa = extract_semver(a)\r\n\u001b[?2004l\r"]
[3403.887954, "o", "\u001b[?2004h> "]
[3403.888141, "o", "    sb = extract_semver(b)\r\n\u001b[?2004l\r"]
[3403.888209, "o", "\u001b[?2004h> "]
[3403.8885, "o", "    if sa is not None and sb is not None:\r\n\u001b[?2004l\r"]
[3403.888575, "o", "\u001b[?2004h> "]
[3403.888737, "o", "        if sa != sb:\r\n\u001b[?2004l\r"]
[3403.888791, "o", "\u001b[?2004h"]
[3403.888853, "o", "> "]
[3403.889099, "o", "            return 1 if sa > sb else -1\r\n\u001b[?2004l\r"]
[3403.889159, "o", "\u001b[?2004h> "]
[3403.889432, "o", "        ta = version_build_timestamp(a)\r\n\u001b[?2004l\r"]
[3403.889493, "o", "\u001b[?2004h> "]
[3403.88976, "o", "        tb = version_build_timestamp(b)\r\n\u001b[?2004l\r"]
[3403.889819, "o", "\u001b[?2004h> "]
[3403.890215, "o", "        if ta is not None and tb is not None and ta != tb:\r\n\u001b[?2004l\r"]
[3403.890275, "o", "\u001b[?2004h> "]
[3403.890556, "o", "            return 1 if ta > tb else -1\r\n\u001b[?2004l\r"]
[3403.89062, "o", "\u001b[?2004h> "]
[3403.890733, "o", "        return 0\r\n\u001b[?2004l\r"]
[3403.890788, "o", "\u001b[?2004h"]
[3403.890841, "o", "> "]
[3403.891306, "o", "    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)\r\n\u001b[?2004l\r"]
[3403.891376, "o", "\u001b[?2004h> "]
[3403.891429, "o", "\"\"\",\r\n\u001b[?2004l\r"]
