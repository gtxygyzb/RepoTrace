[9567.414555, "o", "def save_lock(env, reason):\r\n   354\t    ensure_state()\r\n   355\t    existing = load_lock(env)\r\n   356\t    locked_since = existing.get('locked_since', now_iso()) if existing else now_iso()\r\n   357\t    lock = {\"reason\": reason, \"locked_since\": locked_since}\r\n   358\t    save_json(lock_file(env), lock)\r\n   359\t\r\n   360\tdef remove_lock(env):\r\n   361\t    try:\r\n   362\t        os.remove(lock_file(env))\r\n   363\t    except FileNotFoundError:\r\n   364\t        pass\r\n   365\t\r\n   366\tdef is_locked(env):\r\n   367\t    return load_lock(env) is not None\r\n   368\t\r\n   369\tdef assert_not_locked(env):\r\n   370\t    lock = load_lock(env)\r\n   371\t    if lock is not None:\r\n"]
