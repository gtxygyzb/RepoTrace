[3484.511106, "o", "\u001b[?2004h> "]
[3484.511202, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.511342, "o", "                    newer = env2\r\n\u001b[?2004l\r"]
[3484.51144, "o", "\u001b[?2004h> "]
