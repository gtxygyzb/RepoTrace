[13743.778864, "o", "    path: services/order-service\r\n    build_cmd: make build\r\n    test_cmd: make test\r\n    port: 8082\r\n    depends_on:\r\n    - user-service\r\n    - api-gateway\r\n    health_endpoint: /health\r\n  notification-service:\r\n    version: 0.8.0\r\n    path: services/notification-service\r\n    build_cmd: make build\r\n    test_cmd: make test\r\n    port: 8083\r\n    depends_on:\r\n    - order-service\r\n    health_endpoint: /health\r\n  analytics-service:\r\n    version: 1.10.0\r\n    path: services/analytics-service\r\n    build_cmd: make build\r\n    test_cmd: make test\r\n    port: 8084\r\n    depends_on:\r\n    - user-service\r\n    - order-service\r\n    health_endpoint: /health\r\n"]
