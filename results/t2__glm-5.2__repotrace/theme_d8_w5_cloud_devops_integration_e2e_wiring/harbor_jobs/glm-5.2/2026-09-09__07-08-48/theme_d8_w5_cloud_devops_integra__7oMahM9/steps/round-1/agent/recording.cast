[13309.688203, "o", "        quotas = load_quotas(env)\r\n        usage = quota_current_usage(env, resource)\r\n        if resource in quotas:\r\n            print(f\"{resource}: {quotas[resource]} (current: {usage})\")\r\n        else:\r\n            print(f\"{resource}: not set (current: {usage})\")\r\n"]
