[1131.580765, "o", "SERVICE_FIELDS = ['path', 'build_cmd', 'test_cmd', 'port', 'depends_on', 'health_endpoint']\r\n\u001b[?2004l\r"]
[1131.580853, "o", "\u001b[?2004h> "]
[1131.581383, "o", "ENV_FIELDS = ['deploy_target', 'health_check_port', 'max_replicas']\r\n\u001b[?2004l\r"]
[1131.581464, "o", "\u001b[?2004h> "]
[1131.581489, "o", "\r\n\u001b[?2004l\r=\u001b[?2004h> "]
[1131.581665, "o", "def ensure_state():\r\n\u001b[?2004l\r"]
[1131.581741, "o", "\u001b[?2004h> "]
[1131.582056, "o", "    os.makedirs(STATE_DIR, exist_ok=True)\r\n\u001b[?2004l\r"]
[1131.58213, "o", "\u001b[?2004h"]
[1131.582156, "o", "> "]
[1131.582479, "o", "    os.makedirs(DEPLOYMENTS_DIR, exist_ok=True)\r\n\u001b[?2004l\r"]
[1131.582559, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.582647, "o", "> "]
[1131.582757, "o", "def fail(msg, code=1):\r\n\u001b[?2004l\r"]
[1131.582825, "o", "\u001b[?2004h> "]
[1131.583009, "o", "    print(f\"ERROR: {msg}\")\r\n\u001b[?2004l\r"]
[1131.583081, "o", "\u001b[?2004h> "]
[1131.58322, "o", "    sys.exit(code)\r\n\u001b[?2004l\r"]
[1131.583298, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1131.583378, "o", "\u001b[?2004h> "]
[1131.583472, "o", "def now_iso():\r\n\u001b[?2004l\r"]
[1131.583495, "o", "\u001b[?2004h"]
[1131.58351, "o", "> "]
[1131.584002, "o", "    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n\u001b[?2004l\r"]
[1131.584038, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1131.58405, "o", " "]
[1131.584155, "o", "\u001b[?2004h> "]
[1131.584317, "o", "def load_json(path, default):\r\n"]
[1131.584391, "o", "\u001b[?2004l\r"]
[1131.584463, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[1131.58453, "o", "\u001b[?2004h> "]
[1131.584752, "o", "        with open(path) as f:\r\n\u001b[?2004l\r"]
[1131.584795, "o", "\u001b[?2004h> "]
[1131.58501, "o", "            return json.load(f)\r\n\u001b[?2004l\r"]
[1131.585083, "o", "\u001b[?2004h> "]
[1131.585278, "o", "    except FileNotFoundError:\r\n\u001b[?2004l\r"]
[1131.585359, "o", "\u001b[?2004h> "]
[1131.585519, "o", "        return default\r\n\u001b[?2004l\r"]
[1131.585582, "o", "\u001b[?2004h"]
[1131.585644, "o", "> "]
[1131.585875, "o", "    except json.JSONDecodeError as e:\r\n\u001b[?2004l\r"]
[1131.585954, "o", "\u001b[?2004h> "]
[1131.586216, "o", "        fail(f\"state error in {path}: {e}\")\r\n\u001b[?2004l\r"]
[1131.586302, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.586379, "o", "> "]
[1131.586492, "o", "def save_json(path, data):\r\n\u001b[?2004l\r"]
[1131.586571, "o", "\u001b[?2004h"]
[1131.586641, "o", "> "]
[1131.586858, "o", "    os.makedirs(os.path.dirname(path), exist_ok=True)\r\n\u001b[?2004l\r"]
[1131.586931, "o", "\u001b[?2004h> "]
[1131.587105, "o", "    with open(path, 'w') as f:\r\n\u001b[?2004l\r"]
[1131.587178, "o", "\u001b[?2004h"]
[1131.587206, "o", "> "]
[1131.587482, "o", "        json.dump(data, f, indent=2, sort_keys=True)\r\n\u001b[?2004l\r"]
[1131.587557, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.587626, "o", "> "]
[1131.587711, "o", "def load_manifest():\r\n\u001b[?2004l\r"]
[1131.587742, "o", "\u001b[?2004h> "]
[1131.587815, "o", "    try:\r\n\u001b[?2004l\r"]
[1131.587883, "o", "\u001b[?2004h"]
[1131.58795, "o", "> "]
[1131.588094, "o", "        with open(MANIFEST_PATH) as f:\r\n\u001b[?2004l\r"]
[1131.588173, "o", "\u001b[?2004h> "]
[1131.588371, "o", "            data = yaml.safe_load(f)\r\n\u001b[?2004l\r"]
[1131.588444, "o", "\u001b[?2004h> "]
[1131.588617, "o", "    except FileNotFoundError:\r\n\u001b[?2004l\r"]
[1131.58869, "o", "\u001b[?2004h"]
[1131.588767, "o", "> "]
[1131.588868, "o", "        fail(\"manifest not found\")\r\n\u001b[?2004l\r"]
[1131.588933, "o", "\u001b[?2004h"]
[1131.588999, "o", "> "]
[1131.589115, "o", "    except yaml.YAMLError as e:\r\n\u001b[?2004l\r"]
[1131.58918, "o", "\u001b[?2004h"]
[1131.589249, "o", "> "]
[1131.589432, "o", "        fail(f\"YAML syntax error: {e}\")\r\n\u001b[?2004l\r"]
[1131.589498, "o", "\u001b[?2004h"]
[1131.589566, "o", "> "]
[1131.589704, "o", "    if not isinstance(data, dict):\r\n\u001b[?2004l\r"]
[1131.589774, "o", "\u001b[?2004h> "]
[1131.590003, "o", "        fail(\"manifest must be a mapping\")\r\n\u001b[?2004l\r"]
[1131.590034, "o", "\u001b[?2004h"]
[1131.590115, "o", "> "]
[1131.590182, "o", "    return data\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.590251, "o", "> \r\n\u001b[?2004l\rn"]
[1131.590325, "o", "\u001b[?2004h> "]
[1131.590427, "o", "def validate_manifest(data):\r\n\u001b[?2004l\r"]
[1131.590492, "o", "\u001b[?2004h"]
[1131.590559, "o", "> "]
[1131.590693, "o", "    if not isinstance(data, dict):\r\n\u001b[?2004l\r"]
[1131.590763, "o", "\u001b[?2004h> "]
[1131.591063, "o", "        raise ValueError(\"manifest must be a mapping\")\r\n\u001b[?2004l\r"]
[1131.591095, "o", "\u001b[?2004h"]
[1131.591179, "o", "> \r\n\u001b[?2004l\r(\u001b[?2004h> "]
[1131.591376, "o", "    services = data.get('services')\r\n\u001b[?2004l\r"]
[1131.591448, "o", "\u001b[?2004h> "]
[1131.591765, "o", "    if not isinstance(services, dict) or not services:\r\n\u001b[?2004l\r"]
[1131.591847, "o", "\u001b[?2004h> "]
[1131.592111, "o", "        raise ValueError(\"manifest missing services\")\r\n\u001b[?2004l\r"]
[1131.592185, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.592474, "o", "    environments = data.get('environments')\r\n\u001b[?2004l\r"]
[1131.592547, "o", "\u001b[?2004h> "]
[1131.592898, "o", "    if not isinstance(environments, dict) or not environments:\r\n\u001b[?2004l\r"]
[1131.592968, "o", "\u001b[?2004h> "]
[1131.593289, "o", "        raise ValueError(\"manifest missing environments\")\r\n\u001b[?2004l\r"]
[1131.593375, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.593668, "o", "    for env_name, env in environments.items():\r\n\u001b[?2004l\r"]
[1131.593738, "o", "\u001b[?2004h> "]
[1131.593936, "o", "        if not isinstance(env, dict):\r\n\u001b[?2004l\r"]
[1131.594005, "o", "\u001b[?2004h"]
[1131.594073, "o", "> "]
[1131.594466, "o", "            raise ValueError(f\"environment {env_name} must be a mapping\")\r\n\u001b[?2004l\r"]
[1131.594541, "o", "\u001b[?2004h> "]
[1131.594701, "o", "        for field in ENV_FIELDS:\r\n\u001b[?2004l\r"]
[1131.59473, "o", "\u001b[?2004h> "]
[1131.594943, "o", "            if field not in env:\r\n\u001b[?2004l\r"]
[1131.595013, "o", "\u001b[?2004h> "]
[1131.595544, "o", "                raise ValueError(f\"environment {env_name} missing required field: {field}\")\r\n\u001b[?2004l\r"]
[1131.59562, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.59569, "o", "> "]
[1131.59587, "o", "    for name, svc in services.items():\r\n\u001b[?2004l\r"]
[1131.595942, "o", "\u001b[?2004h> "]
[1131.596144, "o", "        if not isinstance(svc, dict):\r\n\u001b[?2004l\r"]
[1131.596223, "o", "\u001b[?2004h> "]
[1131.596599, "o", "            raise ValueError(f\"service {name} must be a mapping\")\r\n\u001b[?2004l\r"]
[1131.596628, "o", "\u001b[?2004h> "]
[1131.596852, "o", "        for field in SERVICE_FIELDS:\r\n\u001b[?2004l\r"]
[1131.596914, "o", "\u001b[?2004h> "]
[1131.59707, "o", "            if field not in svc:\r\n\u001b[?2004l\r"]
[1131.597156, "o", "\u001b[?2004h> "]
[1131.597417, "o", "                raise ValueError(f\"service {name} missing required field: {field}\")\r\n\u001b[?2004l\r"]
[1131.597497, "o", "\u001b[?2004h> "]
[1131.597642, "o", "        if not isinstance(svc['depends_on'], list):\r\n\u001b[?2004l\r"]
[1131.597714, "o", "\u001b[?2004h> "]
[1131.597997, "o", "            raise ValueError(f\"service {name} has invalid depends_on: must be a list\")\r\n\u001b[?2004l\r"]
[1131.59807, "o", "\u001b[?2004h> "]
[1131.598162, "o", "        for dep in svc['depends_on']:\r\n\u001b[?2004l\r"]
[1131.598226, "o", "\u001b[?2004h"]
[1131.5983, "o", "> "]
[1131.598355, "o", "            if dep not in services:\r\n\u001b[?2004l\r"]
[1131.598377, "o", "\u001b[?2004h> "]
[1131.598684, "o", "                raise ValueError(f\"service {name} depends on undefined service: {dep}\")\r\n\u001b[?2004l\r"]
[1131.598756, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.598815, "o", "    port_map = {}\r\n\u001b[?2004l\r"]
[1131.598837, "o", "\u001b[?2004h"]
[1131.598918, "o", "> "]
[1131.598991, "o", "    for name, svc in services.items():\r\n\u001b[?2004l\r"]
[1131.59902, "o", "\u001b[?2004h> "]
[1131.599121, "o", "        port = svc['port']\r\n\u001b[?2004l\r"]
[1131.599144, "o", "\u001b[?2004h"]
[1131.599223, "o", "> "]
[1131.599299, "o", "        if port in port_map:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.599559, "o", "            raise ValueError(f\"duplicate port assignment: {port}\")\r\n\u001b[?2004l\r"]
[1131.599634, "o", "\u001b[?2004h> "]
[1131.599699, "o", "        port_map[port] = name\r\n\u001b[?2004l\r"]
[1131.599763, "o", "\u001b[?2004h"]
[1131.599791, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[1131.599907, "o", "    cycle = find_cycle(services)\r\n\u001b[?2004l\r"]
[1131.599977, "o", "\u001b[?2004h> "]
[1131.600049, "o", "    if cycle:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.60032, "o", "        raise ValueError(f\"circular dependency detected: {' -> '.join(cycle)}\")\r\n\u001b[?2004l\r"]
[1131.600393, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.600479, "o", "    return True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1131.600549, "o", "\u001b[?2004h> "]
[1131.600617, "o", "def find_cycle(services):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.600683, "o", "> "]
[1131.600751, "o", "    visited = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.600818, "o", ">     stack = []\r\n\u001b[?2004l\r"]
[1131.600885, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.60096, "o", "    def dfs(node):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.601048, "o", "        visited[node] = 1\r\n\u001b[?2004l\r"]
[1131.601113, "o", "\u001b[?2004h"]
[1131.601177, "o", "> "]
[1131.601245, "o", "        stack.append(node)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.601425, "o", "        for dep in services[node].get('depends_on', []):\r\n\u001b[?2004l\r"]
[1131.601498, "o", "\u001b[?2004h> "]
[1131.601593, "o", "            if dep not in services:\r\n\u001b[?2004l\r"]
[1131.601657, "o", "\u001b[?2004h> "]
[1131.601734, "o", "                continue\r\n\u001b[?2004l\r"]
[1131.601795, "o", "\u001b[?2004h> "]
[1131.601916, "o", "            if visited.get(dep) == 1:\r\n\u001b[?2004l\r"]
[1131.601983, "o", "\u001b[?2004h> "]
[1131.602098, "o", "                idx = stack.index(dep)\r\n\u001b[?2004l\r"]
[1131.602124, "o", "\u001b[?2004h> "]
[1131.602289, "o", "                return stack[idx:] + [dep]\r\n\u001b[?2004l\r"]
[1131.602361, "o", "\u001b[?2004h> "]
[1131.602479, "o", "            if visited.get(dep) is None:\r\n\u001b[?2004l\r"]
[1131.602502, "o", "\u001b[?2004h"]
[1131.602584, "o", "> "]
[1131.602654, "o", "                res = dfs(dep)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.602676, "o", "> "]
[1131.602754, "o", "                if res:\r\n\u001b[?2004l\r"]
[1131.602777, "o", "\u001b[?2004h> "]
[1131.602905, "o", "                    return res\r\n\u001b[?2004l\r"]
[1131.602975, "o", "\u001b[?2004h> "]
[1131.603045, "o", "        stack.pop()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.603152, "o", "        visited[node] = 2\r\n\u001b[?2004l\r"]
[1131.603215, "o", "\u001b[?2004h> "]
[1131.603296, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[1131.603319, "o", "\u001b[?2004h"]
[1131.603332, "o", "> "]
[1131.603445, "o", "    for n in sorted(services):\r\n\u001b[?2004l\r"]
[1131.603515, "o", "\u001b[?2004h> "]
[1131.603624, "o", "        if visited.get(n) is None:\r\n\u001b[?2004l\r"]
[1131.603699, "o", "\u001b[?2004h> "]
[1131.60376, "o", "            res = dfs(n)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.603824, "o", "> "]
[1131.603894, "o", "            if res:\r\n\u001b[?2004l\r"]
[1131.603962, "o", "\u001b[?2004h> "]
[1131.604028, "o", "                return res\r\n\u001b[?2004l\r"]
[1131.60409, "o", "\u001b[?2004h> "]
[1131.604113, "o", "    return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1131.604125, "o", "\u001b[?2004h"]
[1131.604223, "o", "> "]
[1131.6043, "o", "def get_services(data):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.60437, "o", "    try:\r\n\u001b[?2004l\r"]
[1131.604436, "o", "\u001b[?2004h> "]
[1131.604502, "o", "        validate_manifest(data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.604568, "o", "> "]
[1131.604645, "o", "    except ValueError as e:\r\n\u001b[?2004l\r"]
[1131.604667, "o", "\u001b[?2004h> "]
[1131.604748, "o", "        fail(str(e))\r\n\u001b[?2004l\r"]
[1131.604768, "o", "\u001b[?2004h> "]
[1131.604967, "o", "    return data['services'], data['environments']\r\n\u001b[?2004l\r"]
[1131.605039, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r)"]
[1131.605108, "o", "\u001b[?2004h> "]
[1131.605174, "o", "def topo_order(services, subset=None):\r\n\u001b[?2004l\r"]
[1131.605243, "o", "\u001b[?2004h> "]
[1131.605319, "o", "    if subset is None:\r\n\u001b[?2004l\r"]
[1131.605386, "o", "\u001b[?2004h> "]
[1131.605534, "o", "        subset = set(services.keys())\r\n\u001b[?2004l\r"]
[1131.605603, "o", "\u001b[?2004h> "]
[1131.605664, "o", "    subset = set(subset)\r\n\u001b[?2004l\r"]
[1131.605686, "o", "\u001b[?2004h> \r\n"]
[1131.6057, "o", "\u001b[?2004l\r"]
[1131.605712, "o", "\u001b[?2004h"]
[1131.605835, "o", "> "]
[1131.605905, "o", "    in_degree = {s: 0 for s in subset}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.606049, "o", "    adj = {s: [] for s in subset}\r\n\u001b[?2004l\r"]
[1131.606118, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rw"]
[1131.606141, "o", "\u001b[?2004h> "]
[1131.606224, "o", "    for s in subset:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.606472, "o", "        for dep in services[s].get('depends_on', []):\r\n\u001b[?2004l\r"]
[1131.60655, "o", "\u001b[?2004h> "]
[1131.606642, "o", "            if dep in subset:\r\n\u001b[?2004l\r"]
[1131.606724, "o", "\u001b[?2004h> "]
[1131.606807, "o", "                adj[dep].append(s)\r\n\u001b[?2004l\r"]
[1131.606867, "o", "\u001b[?2004h> "]
[1131.606966, "o", "                in_degree[s] += 1\r\n\u001b[?2004l\r"]
[1131.606988, "o", "\u001b[?2004h> \r\n"]
[1131.607067, "o", "\u001b[?2004l\r"]
[1131.607137, "o", "\u001b[?2004h>     order = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.607374, "o", "    available = sorted([s for s in subset if in_degree[s] == 0])\r\n\u001b[?2004l\r"]
[1131.60745, "o", "\u001b[?2004h>     while available:\r\n\u001b[?2004l\r"]
[1131.607519, "o", "\u001b[?2004h> "]
[1131.607586, "o", "        next_available = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.607652, "o", "> "]
[1131.607679, "o", "        for s in available:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.607761, "o", "            order.append(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.6079, "o", "            for dependent in sorted(adj[s]):\r\n\u001b[?2004l\r"]
[1131.607974, "o", "\u001b[?2004h> "]
[1131.608041, "o", "                in_degree[dependent] -= 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.608107, "o", "> "]
[1131.608198, "o", "                if in_degree[dependent] == 0:\r\n\u001b[?2004l\r"]
[1131.608225, "o", "\u001b[?2004h> "]
[1131.608371, "o", "                    next_available.append(dependent)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.60844, "o", "> "]
[1131.608527, "o", "        available = sorted(next_available)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.608593, "o", "> \r\n\u001b[?2004l\r"]
[1131.608663, "o", "\u001b[?2004h> "]
[1131.60869, "o", "    if len(order) != len(subset):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.608802, "o", "        fail(\"circular dependency detected\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.608825, "o", "> "]
