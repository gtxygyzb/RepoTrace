[11888.714807, "o", "> "]
[11888.714862, "o", "s = s.replace(old_status, new_status)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.714914, "o", "# 5. History integration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.715023, "o", "old_history = \"\"\"            elif action == \"HEALTH\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.715239, "o", "                entries.append((iso, svc, f\"{iso} HEALTH {svc} {ev.get('previous_state', '-')} -> {ev.get('state', '-')}\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.715307, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.715388, "o", "                entries.append((iso, svc, line))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.715443, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.715519, "o", "new_history = \"\"\"            elif action == \"HEALTH\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.715734, "o", "                entries.append((iso, svc, f\"{iso} HEALTH {svc} {ev.get('previous_state', '-')} -> {ev.get('state', '-')}\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.715819, "o", "            elif action == \"QUOTA_SET\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.716016, "o", "                entries.append((iso, svc, f\"{iso} QUOTA_SET {ev.get('resource', '-')}={ev.get('limit', '-')}\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.716105, "o", "            elif action == \"QUOTA_REMOVE\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.716269, "o", "                entries.append((iso, svc, f\"{iso} QUOTA_REMOVE {ev.get('resource', '-')}\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
