[5687.307018, "o", "\t        return None\r\n   623\t    semver = version.split(':', 1)[1] if ':' in version else version\r\n   624\t    if '+build.' in semver:\r\n   625\t        semver = semver.split('+build.', 1)[0]\r\n   626\t    return parse_semver(semver)\r\n   627\t\r\n   628\tdef semver_string(version):\r\n   629\t    sv = extract_semver(version)\r\n   630\t    if sv is None:\r\n   631\t        return None\r\n   632\t    return f\"{sv[0]}.{sv[1]}.{sv[2]}\"\r\n"]
