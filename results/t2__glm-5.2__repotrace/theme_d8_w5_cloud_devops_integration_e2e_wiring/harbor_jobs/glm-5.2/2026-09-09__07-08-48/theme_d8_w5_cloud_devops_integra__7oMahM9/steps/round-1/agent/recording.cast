[1131.609019, "o", "def build_waves(services, subset):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.609104, "o", "    subset = set(subset)\r\n\u001b[?2004l\r"]
[1131.609168, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1131.609237, "o", "\u001b[?2004h> "]
[1131.609314, "o", "    in_degree = {s: 0 for s in subset}\r\n\u001b[?2004l\r"]
[1131.609386, "o", "\u001b[?2004h> "]
[1131.609415, "o", "    adj = {s: [] for s in subset}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.609493, "o", "    for s in subset:\r\n\u001b[?2004l\r"]
[1131.609515, "o", "\u001b[?2004h> "]
[1131.60968, "o", "        for dep in services[s].get('depends_on', []):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.60978, "o", "            if dep in subset:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.609808, "o", "> "]
[1131.609895, "o", "                adj[dep].append(s)\r\n\u001b[?2004l\r"]
[1131.609958, "o", "\u001b[?2004h> "]
[1131.610028, "o", "                in_degree[s] += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1131.610093, "o", "\u001b[?2004h> "]
[1131.610121, "o", "    waves = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.61031, "o", "    available = sorted([s for s in subset if in_degree[s] == 0])\r\n\u001b[?2004l\r"]
[1131.610379, "o", "\u001b[?2004h> "]
[1131.610447, "o", "    while available:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.610519, "o", "        waves.append(available)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.6106, "o", "        next_available = []\r\n\u001b[?2004l\r"]
[1131.610669, "o", "\u001b[?2004h> "]
[1131.610739, "o", "        for s in available:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.610847, "o", "            for dependent in sorted(adj[s]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.610913, "o", "> "]
[1131.610996, "o", "                in_degree[dependent] -= 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.611157, "o", "                if in_degree[dependent] == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.611328, "o", "                    next_available.append(dependent)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.611401, "o", "> "]
[1131.611467, "o", "        available = sorted(next_available)\r\n\u001b[?2004l\r"]
[1131.61153, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1131.611596, "o", "\u001b[?2004h> "]
[1131.611662, "o", "    if sum(len(w) for w in waves) != len(subset):\r\n\u001b[?2004l\r"]
[1131.611725, "o", "\u001b[?2004h> "]
[1131.611817, "o", "        fail(\"circular dependency detected\")\r\n\u001b[?2004l\r"]
[1131.611885, "o", "\u001b[?2004h> "]
[1131.611957, "o", "    return waves\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.612044, "o", "def transitive_deps(services, name):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.612109, "o", "> "]
[1131.612177, "o", "    if name not in services:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.612284, "o", "        fail(f\"service not found: {name}\")\r\n\u001b[?2004l\r"]
[1131.612363, "o", "\u001b[?2004h>     result = set()\r\n\u001b[?2004l\r"]
[1131.61243, "o", "\u001b[?2004h> "]
[1131.612456, "o", "    stack = [name]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.612529, "o", "    while stack:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.612595, "o", "        s = stack.pop()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.612658, "o", "> "]
[1131.612726, "o", "        if s not in result:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.612783, "o", "            result.add(s)\r\n\u001b[?2004l\r"]
[1131.612846, "o", "\u001b[?2004h> "]
[1131.612986, "o", "            for dep in services[s].get('depends_on', []):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.613106, "o", "                if dep not in services:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.613171, "o", "> "]
[1131.613353, "o", "                    fail(f\"service {s} depends on undefined service: {dep}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.613464, "o", "                stack.append(dep)\r\n\u001b[?2004l\r"]
[1131.613526, "o", "\u001b[?2004h> "]
[1131.613595, "o", "    return result\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1131.61366, "o", "i\u001b[?2004h> "]
[1131.613726, "o", "def service_path(svc):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.613792, "o", "    p = svc.get('path', '')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.613862, "o", "    if os.path.isabs(p):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.613931, "o", "        return p\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.614027, "o", "    return os.path.join(APP_DIR, p)\r\n\u001b[?2004l\r"]
