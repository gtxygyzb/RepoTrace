[4883.569412, "o", "   141\t\r\n   142\tdef topo_order(services, subset=None):\r\n   143\t    if subset is None:\r\n   144\t        subset = set(services.keys())\r\n   145\t    subset = set(subset)\r\n   146\t\r\n   147\t    in_degree = {s: 0 for s in subset}\r\n   148\t    adj = {s: [] for s in subset}\r\n   149\t\r\n"]
[4883.569522, "o", "   150\t    for s in subset:\r\n   151\t        for dep in services[s].get('depends_on', []):\r\n   152\t            if dep in subset:\r\n   153\t                adj[dep].append(s)\r\n   154\t                in_degree[s] += 1\r\n   155\t\r\n   156\t    order = []\r\n   157\t    available = sorted([s for s in subset if in_degree[s] == 0])\r\n   158\t    while available:\r\n   159\t        next_available = []\r\n   160\t        for s in available:\r\n   161\t            order.append(s)\r\n   162\t            for dependent in sorted(adj[s]):\r\n   163\t                in_degree[dependent] -= 1\r\n   164\t                if in_degree[dependent] == 0:\r\n   165\t                    next_available.append(dependent)\r\n"]
[4883.569589, "o", "   166\t        available = sorted(next_available)\r\n   167\t\r\n   168\t    if len(order) != len(subset):\r\n   169\t        fail(\"circular dependency detected\")\r\n   170\t    return order\r\n   171\t\r\n   172\tdef build_waves(services, subset):\r\n   173\t    subset = set(subset)\r\n   174\t\r\n   175\t    in_degree = {s: 0 for s in subset}\r\n   176\t    adj = {s: [] for s in subset}\r\n   177\t\r\n   178\t    for s in subset:\r\n"]
[4883.569681, "o", "   179\t        for dep in services[s].get('depends_on', []):\r\n   180\t            if dep in subset:\r\n   181\t                adj[dep].append(s)\r\n   182\t                in_degree[s] += 1\r\n   183\t\r\n   184\t    waves = []\r\n   185\t    available = sorted([s for s in subset if in_degree[s] == 0])\r\n   186\t    while available:\r\n   187\t        waves.append(available)\r\n   188\t        next_available = []\r\n   189\t        for s in available:\r\n   190\t            for dependent in sorted(adj[s]):\r\n   191\t                in_degree[dependent] -= 1\r\n   192\t                if in_degree[dependent] == 0:\r\n   193\t                    next_available.append(dependent)\r\n   194\t        available = sorted(next_available)\r\n   195\t\r\n"]
[4883.569742, "o", "   196\t    if sum(len(w) for w in waves) != len(subset):\r\n   197\t        fail(\"circular dependency detected\")\r\n   198\t    return waves\r\n   199\t\r\n   200\tdef transitive_deps(services, name):\r\n   201\t    if name not in services:\r\n   202\t        fail(f\"service not found: {name}\")\r\n   203\t    result = set()\r\n   204\t    stack = [name]\r\n"]
[4883.569795, "o", "   205\t    while stack:\r\n"]
