[11447.108997, "o", "    11\timport re\r\n    12\tfrom datetime import datetime, timezone\r\n    13\t\r\n    14\tAPP_DIR = '/app'\r\n    15\tMANIFEST_PATH = '/app/pipeline.yaml'\r\n    16\tSTATE_DIR = '/app/.pipeline'\r\n    17\tTEST_RESULTS_PATH = os.path.join(STATE_DIR, 'test_results.json')\r\n    18\tDEPLOYMENTS_DIR = os.path.join(STATE_DIR, 'deployments')\r\n    19\tEVENTS_DIR = os.path.join(STATE_DIR, 'events')\r\n    20\tSNAPSHOTS_DIR = os.path.join(STATE_DIR, 'snapshots')\r\n    21\tLOCK_DIR = os.path.join(STATE_DIR, 'locks')\r\n    22\tCONFIG_DIR = os.path.join(STATE_DIR, 'config')\r\n    23\tREPLICAS_DIR = os.path.join(STATE_DIR, 'replicas')\r\n    24\tBOUNDS_DIR = os.path.join(STATE_DIR, 'bounds')\r\n    25\tHEALTH_DIR = os.path.join(STATE_DIR, 'health')\r\n"]
[11447.109076, "o", "    26\t\r\n    27\tSERVICE_FIELDS = ['version', 'path', 'build_cmd', 'test_cmd', 'port', 'depends_on', 'health_endpoint']\r\n    28\tENV_FIELDS = ['deploy_target', 'health_check_port', 'max_replicas']\r\n    29\t\r\n    30\tdef ensure_state():\r\n    31\t"]
[11447.109144, "o", "    os.makedirs(STATE_DIR, exist_ok=True)\r\n    32\t    os.makedirs(DEPLOYMENTS_DIR, exist_ok=True)\r\n    33\t    os.makedirs(EVENTS_DIR, exist_ok=True)\r\n    34\t    os.makedirs(SNAPSHOTS_DIR, exist_ok=True)\r\n    35\t    os.makedirs(LOCK_DIR, exist_ok=True)\r\n    36\t    os.makedirs(CONFIG_DIR, exist_ok=True)\r\n    37\t    os.makedirs(REPLICAS_DIR, exist_ok=True)\r\n    38\t    os.makedirs(BOUNDS_DIR, exist_ok=True)\r\n    39\t    os.makedirs(HEALTH_DIR, exist_ok=True)\r\n    40\t\r\n    41\tdef fail(msg, code=1):\r\n    42\t    print(f\"ERROR: {msg}\")\r\n    43\t    sys.exit(code)\r\n    44\t\r\n    45\tdef now_iso():\r\n    46\t    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n"]
[11447.109207, "o", "    47\t\r\n    48\tdef load_json(path, default):\r\n    49\t    try:\r\n    50\t        with open(path) as f:\r\n    51\t            return json.load(f)\r\n    52\t    except FileNotFoundError:\r\n    53\t        return default\r\n    54\t    except json.JSONDecodeError as e:\r\n    55\t        fail(f\"state error in {path}: {e}\")\r\n    56\t\r\n"]
[11447.109272, "o", "    57\tdef save_json(path, data):\r\n    58\t    os.makedirs(os.path.dirname(path), exist_ok=True)\r\n    59\t    with open(path, 'w') as f:\r\n    60\t        json.dump(data, f, indent=2, sort_keys=True)\r\n    61\t\r\n    62\tdef load_manifest():\r\n    63\t    try:\r\n    64\t        with open(MANIFEST_PATH) as f:\r\n    65\t            data = yaml.safe_load(f)\r\n"]
