[3403.893151, "o", "\u001b[?2004h> "]
[3403.893568, "o", "                    f.write(f\"{s}:{int(time.time())}:built\")\r\n\u001b[?2004l\r"]
[3403.893628, "o", "\u001b[?2004h> "]
