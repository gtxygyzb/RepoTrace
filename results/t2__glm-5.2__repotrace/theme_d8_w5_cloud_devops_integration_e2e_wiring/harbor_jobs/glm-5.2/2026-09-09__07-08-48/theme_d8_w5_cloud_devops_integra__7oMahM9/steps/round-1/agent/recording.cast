[13300.464288, "o", "#!/usr/bin/env bash\r\nset -euo pipefail\r\ntmp_script=\"$(mktemp)\"\r\ntrap 'rm -f \"$tmp_script\"' EXIT\r\ncat > \"$tmp_script\" <<'PY'\r\nimport sys\r\n"]
[13300.464393, "o", "import os\r\nimport json\r\nimport time\r\nimport yaml\r\nimport re\r\nfrom datetime import datetime, timezone\r\n\r\nAPP_DIR = '/app'\r\nMANIFEST_PATH = '/app/pipeline.yaml'\r\nSTATE_DIR = '/app/.pipeline'\r\nTEST_RESULTS_PATH = os.path.join(STATE_DIR, 'test_results.json')\r\nDEPLOYMENTS_DIR = os.path.join(STATE_DIR, 'deployments')\r\nEVENTS_DIR = os.path.join(STATE_DIR, 'events')\r\nSNAPSHOTS_DIR = os.path.join(STATE_DIR, 'snapshots')\r\nLOCK_DIR = os.path.join(STATE_DIR, 'locks')\r\nCONFIG_DIR = os.path.join(STATE_DIR, 'config')\r\nREPLICAS_DIR = os.path.join(STATE_DIR, 'replicas')\r\n"]
[13300.464461, "o", "BOUNDS_DIR = os.path.join(STATE_DIR, 'bounds')\r\nHEALTH_DIR = os.path.join(STATE_DIR, 'health')\r\nQUOTA_DIR = os.path.join(STATE_DIR, 'quotas')\r\n\r\nSERVICE_FIELDS = ['version', 'path', 'build_cmd', 'test_cmd', 'port', 'depends_on', 'health_endpoint']\r\nENV_FIELDS = ['deploy_target', 'health_check_port', 'max_replicas']\r\n\r\ndef ensure_state():\r\n    os.makedirs(STATE_DIR, exist_ok=True)\r\n    os.makedirs(DEPLOYMENTS_DIR, exist_ok=True)\r\n    os.makedirs(EVENTS_DIR, exist_ok=True)\r\n    os.makedirs(SNAPSHOTS_DIR, exist_ok=True)\r\n    os.makedirs(LOCK_DIR, exist_ok=True)\r\n    os.makedirs(CONFIG_DIR, exist_ok=True)\r\n"]
[13300.464524, "o", "    os.makedirs(REPLICAS_DIR, exist_ok=True)\r\n    os.makedirs(BOUNDS_DIR, exist_ok=True)\r\n    os.makedirs(HEALTH_DIR, exist_ok=True)\r\n    os.makedirs(QUOTA_DIR, exist_ok=True)\r\n\r\ndef fail(msg, code=1):\r\n    print(f\"ERROR: {msg}\")\r\n    sys.exit(code)\r\n\r\ndef now_iso():\r\n    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n\r\n"]
[13300.464579, "o", "def load_json(path, default):\r\n    try:\r\n        with open(path) as f:\r\n            return json.load(f)\r\n    except FileNotFoundError:\r\n        return default\r\n    except json.JSONDecodeError as e:\r\n        fail(f\"state error in {path}: {e}\")\r\n\r\ndef save_json(path, data):\r\n"]
[13300.464611, "o", "    os.makedirs(os.path.dirname(path), exist_ok=True)\r\n    with open(path, 'w') as f:\r\n        json.dump(data, f, indent=2, sort_keys=True)\r\n\r\ndef load_manifest():\r\n    try:\r\n        with open(MANIFEST_PATH) as f:\r\n            data = yaml.safe_load(f)\r\n    except FileNotFoundError:\r\n"]
[13300.464682, "o", "        fail(\"manifest not found\")\r\n    except yaml.YAMLError as e:\r\n        fail(f\"YAML syntax error: {e}\")\r\n    if not isinstance(data, dict):\r\n        fail(\"manifest must be a mapping\")\r\n    return data\r\n\r\ndef validate_manifest(data):\r\n    if not isinstance(data, dict):\r\n        raise ValueError(\"manifest must be a mapping\")\r\n\r\n    services = data.get('services')\r\n    if not isinstance(services, dict) or not services:\r\n        raise ValueError(\"manifest missing services\")\r\n\r\n"]
[13300.464738, "o", "    environments = data.get('environments')\r\n    if not isinstance(environments, dict) or not environments:\r\n        raise ValueError(\"manifest missing environments\")\r\n\r\n    for env_name, env in environments.items():\r\n        if not isinstance(env, dict):\r\n            raise ValueError(f\"environment {env_name} must be a mapping\")\r\n        for field in ENV_FIELDS:\r\n            if field not in env:\r\n                raise ValueError(f\"environment {env_name} missing required field: {field}\")\r\n\r\n    for name, svc in services.items():\r\n"]
[13300.464799, "o", "        if not isinstance(svc, dict):\r\n            raise ValueError(f\"service {name} must be a mapping\")\r\n        for field in SERVICE_FIELDS:\r\n            if field not in svc:\r\n                raise ValueError(f\"service {name} missing required field: {field}\")\r\n        if not isinstance(svc['depends_on'], list):\r\n            raise ValueError(f\"service {name} has invalid depends_on: must be a list\")\r\n        for dep in svc['depends_on']:\r\n            if dep not in services:\r\n                raise ValueError(f\"service {name} depends on undefined service: {dep}\")\r\n        if not valid_version(svc.get('version')):\r\n"]
[13300.464853, "o", "            raise ValueError(f\"service {name} has invalid version: expected N.N.N\")\r\n\r\n    port_map = {}\r\n    for name, svc in services.items():\r\n        port = svc['port']\r\n        if port in port_map:\r\n            raise ValueError(f\"duplicate port assignment: {port}\")\r\n        port_map[port] = name\r\n\r\n    cycle = find_cycle(services)\r\n    if cycle:\r\n"]
[13300.464908, "o", "        raise ValueError(f\"circular dependency detected: {' -> '.join(cycle)}\")\r\n\r\n    return True\r\n\r\ndef find_cycle(services):\r\n    visited = {}\r\n    stack = []\r\n\r\n"]
[13300.464965, "o", "    def dfs(node):\r\n        visited[node] = 1\r\n        stack.append(node)\r\n        for dep in services[node].get('depends_on', []):\r\n            if dep not in services:\r\n                continue\r\n            if visited.get(dep) == 1:\r\n                idx = stack.index(dep)\r\n                return stack[idx:] + [dep]\r\n            if visited.get(dep) is None:\r\n                res = dfs(dep)\r\n                if res:\r\n                    return res\r\n        stack.pop()\r\n        visited[node] = 2\r\n        return None\r\n\r\n    for n in sorted(services):\r\n"]
[13300.465021, "o", "        if visited.get(n) is None:\r\n            res = dfs(n)\r\n            if res:\r\n                return res\r\n    return None\r\n\r\ndef get_services(data):\r\n    try:\r\n        validate_manifest(data)\r\n    except ValueError as e:\r\n        fail(str(e))\r\n    return data['services'], data['environments']\r\n\r\n"]
[13300.465078, "o", "def topo_order(services, subset=None):\r\n    if subset is None:\r\n        subset = set(services.keys())\r\n    subset = set(subset)\r\n\r\n    in_degree = {s: 0 for s in subset}\r\n    adj = {s: [] for s in subset}\r\n\r\n    for s in subset:\r\n        for dep in services[s].get('depends_on', []):\r\n            if dep in subset:\r\n                adj[dep].append(s)\r\n                in_degree[s] += 1\r\n\r\n    order = []\r\n    available = sorted([s for s in subset if in_degree[s] == 0])\r\n"]
[13300.465137, "o", "    while available:\r\n        next_available = []\r\n        for s in available:\r\n            order.append(s)\r\n            for dependent in sorted(adj[s]):\r\n                in_degree[dependent] -= 1\r\n                if in_degree[dependent] == 0:\r\n                    next_available.append(dependent)\r\n"]
[13300.465933, "o", "\u001b[?2004h"]
[13300.465965, "o", "root@n30009:/app# "]
[13300.779111, "i", "sed -n '180,360p' pipeline.sh\n"]
[13300.779422, "o", "sed -n '180,360p' pipeline.sh\r\n"]
[13300.77949, "o", "\u001b[?2004l\r"]
[13300.782519, "o", "                    next_available.append(dependent)\r\n        available = sorted(next_available)\r\n\r\n"]
[13300.78253, "o", "    if len(order) != len(subset):\r\n        fail(\"circular dependency detected\")\r\n"]
[13300.782574, "o", "    return order\r\n"]
[13300.782647, "o", "\r\ndef build_waves(services, subset):\r\n    subset = set(subset)\r\n\r\n    in_degree = {s: 0 for s in subset}\r\n    adj = {s: [] for s in subset}\r\n\r\n    for s in subset:\r\n        for dep in services[s].get('depends_on', []):\r\n            if dep in subset:\r\n                adj[dep].append(s)\r\n                in_degree[s] += 1\r\n\r\n    waves = []\r\n    available = sorted([s for s in subset if in_degree[s] == 0])\r\n    while available:\r\n        waves.append(available)\r\n        next_available = []\r\n        for s in available:\r\n            for dependent in sorted(adj[s]):\r\n                in_degree[dependent] -= 1\r\n                if in_degree[dependent] == 0:\r\n                    next_available.append(dependent)\r\n        available = sorted(next_available)\r\n"]
[13300.78266, "o", "\r\n    if sum(len(w) for w in waves) != len(subset):\r\n        fail(\"circular dependency detected\")\r\n"]
[13300.78273, "o", "    return waves\r\n\r\ndef transitive_deps(services, name):\r\n    if name not in services:\r\n        fail(f\"service not found: {name}\")\r\n    result = set()\r\n    stack = [name]\r\n    while stack:\r\n        s = stack.pop()\r\n        if s not in result:\r\n            result.add(s)\r\n            for dep in services[s].get('depends_on', []):\r\n"]
[13300.78274, "o", "                if dep not in services:\r\n"]
[13300.782804, "o", "                    fail(f\"service {s} depends on undefined service: {dep}\")\r\n                stack.append(dep)\r\n    return result\r\n\r\ndef service_path(svc):\r\n    p = svc.get('path', '')\r\n    if os.path.isabs(p):\r\n        return p\r\n    return os.path.join(APP_DIR, p)\r\n\r\n"]
[13300.782856, "o", "def artifact_path(svc):\r\n    return os.path.join(service_path(svc), 'build', 'artifact.txt')\r\n\r\ndef read_artifact(svc):\r\n    try:\r\n        with open(artifact_path(svc)) as f:\r\n"]
[13300.782868, "o", "            return f.read().strip()\r\n    except FileNotFoundError:\r\n        return None\r\n"]
[13300.782928, "o", "\r\ndef deployment_file(env):\r\n    return os.path.join(DEPLOYMENTS_DIR, f\"{env}.json\")\r\n\r\ndef load_deployment_state(env):\r\n    return load_json(deployment_file(env), {})\r\n\r\ndef save_deployment_state(env, state):\r\n    save_json(deployment_file(env), state)\r\n\r\ndef replica_file(env):\r\n    return os.path.join(REPLICAS_DIR, f\"{env}.json\")\r\n"]
[13300.782938, "o", "\r\ndef load_replicas(env):\r\n"]
[13300.782997, "o", "    return load_json(replica_file(env), {})\r\n\r\ndef save_replicas(env, replicas):\r\n    save_json(replica_file(env), replicas)\r\n\r\ndef bounds_file(env):\r\n    return os.path.join(BOUNDS_DIR, f\"{env}.json\")\r\n\r\ndef load_bounds(env):\r\n    return load_json(bounds_file(env), {})\r\n\r\ndef save_bounds(env, bounds):\r\n"]
[13300.78301, "o", "    save_json(bounds_file(env), bounds)\r\n\r\ndef health_file(env):\r\n"]
[13300.783072, "o", "    return os.path.join(HEALTH_DIR, f\"{env}.json\")\r\n\r\ndef load_health(env):\r\n    return load_json(health_file(env), {})\r\n\r\ndef save_health(env, data):\r\n    save_json(health_file(env), data)\r\n\r\ndef is_valid_health_state(state):\r\n    return state in (\"healthy\", \"unhealthy\", \"degraded\")\r\n\r\ndef get_health_state(env, service):\r\n    health = load_health(env)\r\n    rec = health.get(service)\r\n"]
[13300.783084, "o", "    if not rec or rec.get(\"state\") not in (\"healthy\", \"unhealthy\", \"degraded\"):\r\n        return \"healthy\""]
[13300.783145, "o", "\r\n    state = load_deployment_state(env)\r\n    snapshot = rec.get(\"state_snapshot\")\r\n    if not snapshot or state.get(service) != snapshot:\r\n        return \"healthy\"\r\n    return rec[\"state\"]\r\n\r\ndef reset_health(env, service):\r\n    health = load_health(env)\r\n    if service in health:\r\n        del health[service]\r\n        save_health(env, health)\r\n\r\ndef reset_all_health(env):\r\n    health = load_health(env)\r\n    if health:\r\n"]
[13300.783155, "o", "        save_health(env, {})\r\n"]
[13300.78322, "o", "\r\ndef append_health_event(env, service, new_state, previous_state):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"HEALTH\",\r\n        \"service\": service,\r\n        \"version\": \"-\",\r\n        \"state\": new_state,\r\n        \"previous_state\": previous_state,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n"]
[13300.783231, "o", "\r\ndef get_replica_count(env, service):\r\n    replicas = load_replicas(env)\r\n    return replicas.get(service, 1)\r\n"]
[13300.783309, "o", "\r\ndef get_env_max(envs, env):\r\n    env_max = envs[env].get('max_replicas')\r\n    if env_max is None:\r\n        return None\r\n    try:\r\n        return int(env_max)\r\n    except (ValueError, TypeError):\r\n        return None\r\n\r\ndef parse_positive_int(s):\r\n    if not isinstance(s, str):\r\n        return None\r\n    if not re.fullmatch('[0-9]+', s):\r\n        return None\r\n    val = int(s)\r\n    if val < 1:\r\n"]
[13300.783361, "o", "        return None\r\n    return val\r\n\r\n\r\ndef event_file(env):\r\n    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n\r\ndef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n    ensure_state()\r\n    ts = now_iso()\r\n    line = f\"{ts} {action} {service} {version}\"\r\n    if action == \"PROMOTE\" and source_env is not None:\r\n        line += f\" from {source_env}\"\r\n"]
[13300.783373, "o", "        if forced:\r\n            line += \" (forced)\"\r\n    if action == \"RESTORE\" and snapshot_id is not None:\r\n"]
[13300.783431, "o", "        line += f\" from snapshot #{snapshot_id}\"\r\n    line += \"\\n\"\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(line)\r\n"]
