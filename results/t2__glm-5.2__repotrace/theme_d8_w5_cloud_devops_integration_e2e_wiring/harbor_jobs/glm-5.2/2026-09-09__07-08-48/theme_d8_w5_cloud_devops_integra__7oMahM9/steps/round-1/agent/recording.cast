[11888.712114, "o", "> "]
[11888.71218, "o", "        for s in order:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.712287, "o", "            if s not in state:\r\n\u001b[?2004l\r"]
[11888.712353, "o", "\u001b[?2004h> "]
[11888.712451, "o", "                current = len(state)\r\n\u001b[?2004l\r"]
[11888.712507, "o", "\u001b[?2004h> "]
[11888.712668, "o", "                if current + 1 > max_services_limit:\r\n\u001b[?2004l\r"]
[11888.712723, "o", "\u001b[?2004h> "]
[11888.713074, "o", "                    fail(f\"deploying {s} would exceed max_services quota ({current + 1}/{max_services_limit}) in {env}\")\r\n\u001b[?2004l\r"]
[11888.713136, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.71319, "o", ">     if dry_run:\r\n\u001b[?2004l\r"]
[11888.713245, "o", "\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.713328, "o", "assert old_deploy in s\r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.713383, "o", "> "]
[11888.713445, "o", "s = s.replace(old_deploy, new_deploy)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.7135, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
