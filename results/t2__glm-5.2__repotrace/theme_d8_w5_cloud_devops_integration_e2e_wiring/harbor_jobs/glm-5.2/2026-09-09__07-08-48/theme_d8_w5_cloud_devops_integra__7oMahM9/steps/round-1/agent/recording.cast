[14124.01805, "o", "rue)\r\n    34\t    os.makedirs(EVENTS_DIR, exist_ok=True)\r\n    35\t    os.makedirs(SNAPSHOTS_DIR, exist_ok=True)\r\n    36\t    os.makedirs(LOCK_DIR, exist_ok=True)\r\n    37\t    os.makedirs(CONFIG_DIR, exist_ok=True)\r\n    38\t    os.makedirs(REPLICAS_DIR, exist_ok=True)\r\n    39\t    os.makedirs(BOUNDS_DIR, exist_ok=True)\r\n    40\t    os.makedirs(HEALTH_DIR, exist_ok=True)\r\n    41\t    os.makedirs(QUOTA_DIR, exist_ok=True)\r\n    42\t\r\n    43\tdef fail(msg, code=1):\r\n    44\t    print(f\"ERROR: {msg}\")\r\n    45\t    sys.exit(code)\r\n    46\t\r\n    47\tdef now_iso():\r\n    48\t    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n    49\t\r\n    50\tdef load_json(path, default):\r\n    51\t    try:\r\n    52\t        with open(path) as f:\r\n"]
