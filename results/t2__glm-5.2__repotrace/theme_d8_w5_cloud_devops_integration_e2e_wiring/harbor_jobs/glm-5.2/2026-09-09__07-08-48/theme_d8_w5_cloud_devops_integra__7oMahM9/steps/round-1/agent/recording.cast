[4811.688201, "o", "    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n\r\ndef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n    ensure_state()\r\n    ts = now_iso()\r\n"]
[4811.688331, "o", "    line = f\"{ts} {action} {service} {version}\"\r\n    if action == \"PROMOTE\" and source_env is not None:\r\n        line += f\" from {source_env}\"\r\n        if forced:\r\n            line += \" (forced)\"\r\n    if action == \"RESTORE\" and snapshot_id is not None:\r\n        line += f\" from snapshot #{snapshot_id}\"\r\n    line += \"\\n\"\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(line)\r\n\r\ndef load_events(env):\r\n    ensure_state()\r\n    try:\r\n        with open(event_file(env)) as f:\r\n            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n    except FileNotFoundError:\r\n        return []\r\n    events = []\r\n    for line in lines:\r\n        parts = line.split()\r\n        if len(parts) < 4:\r\n"]
[4811.688436, "o", "            continue\r\n        events.append({\r\n            \"timestamp\": parts[0],\r\n            \"action\": parts[1],\r\n            \"service\": parts[2],\r\n            \"version\": parts[3],\r\n            \"line\": line,\r\n        })\r\n    return events\r\n\r\ndef find_rollback_target(env, service, current_version, to_version=None):\r\n    events = load_events(env)\r\n\r\n    if to_version is not None:\r\n        for ev in reversed(events):\r\n            if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] == to_version:\r\n                return to_version\r\n        fail(f\"version not found in history for {service}\")\r\n\r\n    current_idx = None\r\n    for idx, ev in enumerate(events):\r\n        if ev[\"service\"] != service:\r\n            continue\r\n"]
[4811.688523, "o", "        if ev[\"version\"] != current_version:\r\n            continue\r\n        if ev[\"action\"] == \"ROLLBACK\" and ev[\"version\"] == \"-\":\r\n            continue\r\n        current_idx = idx\r\n\r\n    if current_idx is None:\r\n"]
[4811.688637, "o", "        return None\r\n\r\n    for ev in reversed(events[:current_idx]):\r\n        if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] != current_version:\r\n            return ev[\"version\"]\r\n    return None\r\n\r\ndef parse_opts(args, value_opts, flag_opts):\r\n    values = {}\r\n    flags = set()\r\n    positionals = []\r\n    i = 0\r\n    while i < len(args):\r\n        a = args[i]\r\n        if a in value_opts:\r\n            i += 1\r\n            if i >= len(args):\r\n                fail(f\"{a} requires a value\")\r\n            values[a] = args[i]\r\n        elif a in flag_opts:\r\n            flags.add(a)\r\n        elif a.startswith('--'):\r\n            fail(f\"unknown option: {a}\")\r\n        else:\r\n            positionals.append(a)\r\n        i += 1\r\n    return values, flags, positionals\r\n\r\ndef cmd_validate(args):\r\n    if args:\r\n        fail(\"validate takes no arguments\")\r\n    data = load_manifest()\r\n    try:\r\n        validate_manifest(data)\r\n    except ValueError as e:\r\n        print(f\"ERROR: {e}\")\r\n        sys.exit(1)"]
[4811.688706, "o", "\r\n    print(\"VALID\")\r\n\r\ndef cmd_order(args):\r\n    if args:\r\n        fail(\"order takes no arguments\")\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n    for s in topo_order(services):\r\n        print(s)\r\n\r\ndef cmd_build(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--parallel'})\r\n    if positionals:\r\n        fail(\"build does not accept positional arguments\")\r\n"]
[4811.688776, "o", "\r\n    service = values.get('--service')\r\n    parallel = '--parallel' in flags\r\n\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n\r\n    if service:\r\n        subset = transitive_deps(services, service)\r\n"]
[4811.68884, "o", "    else:\r\n        subset = set(services.keys())\r\n\r\n    if parallel:\r\n        for wave in build_waves(services, subset):\r\n            print(\",\".join(wave))\r\n        return\r\n\r\n    order = topo_order(services, subset)\r\n    any_fail = False\r\n    for s in order:\r\n        svc = services[s]\r\n        path = service_path(svc)\r\n        if not os.path.isdir(path):\r\n            print(f\"BUILD {s} FAIL: service path does not exist\")\r\n            any_fail = True\r\n            continue\r\n        version = svc.get('version')\r\n        if not valid_version(version):\r\n            print(f\"BUILD {s} FAIL: invalid version\")\r\n            any_fail = True"]
[4811.688903, "o", "\r\n            continue\r\n        try:\r\n            os.makedirs(os.path.join(path, 'build'), exist_ok=True)\r\n            with open(os.path.join(path, 'build', 'artifact.txt'), 'w') as f:\r\n                f.write(f\"{s}:{version}+build.{int(time.time())}\")\r\n            print(f\"BUILD {s} OK\")\r\n        except Exception as e:\r\n            print(f\"BUILD {s} FAIL: {e}\")\r\n            any_fail = True\r\n\r\n    if any_fail:\r\n        sys.exit(1)\r\n\r\n"]
[4811.688967, "o", "def cmd_test(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--fail-fast'})\r\n    if positionals:\r\n        fail(\"test does not accept positional arguments\")\r\n\r\n    service = values.get('--service')\r\n    fail_fast = '--fail-fast' in flags\r\n\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n\r\n    if service:\r\n        if service not in services:\r\n            fail(f\"service not found: {service}\")\r\n        order = [service]\r\n"]
