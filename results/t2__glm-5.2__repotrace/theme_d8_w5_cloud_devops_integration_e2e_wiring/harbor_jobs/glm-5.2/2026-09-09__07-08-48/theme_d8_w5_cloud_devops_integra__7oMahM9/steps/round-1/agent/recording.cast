[4826.18362, "o", "    13\tSTATE_DIR = '/app/.pipeline'\r\n    14\tTEST_RESULTS_PATH = os.path.join(STATE_DIR, 'test_results.json')\r\n    15\tDEPLOYMENTS_DIR = os.path.join(STATE_DIR, 'deployments')\r\n    16\tEVENTS_DIR = os.path.join(STATE_DIR, 'events')\r\n    17\tSNAPSHOTS_DIR = os.path.join(STATE_DIR, 'snapshots')\r\n    18\t\r\n    19\tSERVICE_FIELDS = ['version', 'path', 'build_cmd', 'test_cmd', 'port', 'depends_on', 'health_endpoint']\r\n    20\tENV_FIELDS = ['deploy_target', 'health_check_port', 'max_replicas']\r\n    21\t\r\n    22\tdef ensure_state():\r\n    23\t    os.makedirs(STATE_DIR, exist_ok=True)\r\n    24\t    os.makedirs(DEPLOYMENTS_DIR, exist_ok=True)\r\n    25\t    os.makedirs(EVENTS_DIR, exist_ok=True)\r\n    26\t    os.makedirs(SNAPSHOTS_DIR, exist_ok=True)\r\n    27\t\r\n    28\tdef fail(msg, code=1):\r\n    29\t    print(f\"ERROR: {msg}\")\r\n    30\t    sys.exit(code)\r\n    31\t\r\n    32\tdef now_iso():\r\n    33\t    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n    34\t\r\n    35\tdef load_json(path, default):\r\n    36\t    try:\r\n    37\t       "]
[4826.183714, "o", " with open(path) as f:\r\n    38\t            return json.load(f)\r\n    39\t    except FileNotFoundError:\r\n    40\t        return default\r\n    41\t    except json.JSONDecodeError as e:\r\n    42\t        fail(f\"state error in {path}: {e}\")\r\n    43\t\r\n    44\tdef save_json(path, data):\r\n    45\t    os.makedirs(os.path.dirname(path), exist_ok=True)\r\n    46\t    with open(path, 'w') as f:\r\n    47\t        json.dump(data, f, indent=2, sort_keys=True)\r\n    48\t\r\n    49\tdef load_manifest():\r\n    50\t    try:\r\n    51\t        with open(MANIFEST_PATH) as f:\r\n    52\t            data = yaml.safe_load(f)\r\n    53\t    except FileNotFoundError:\r\n    54\t        fail(\"manifest not found\")\r\n"]
