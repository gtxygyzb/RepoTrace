[3403.841207, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.841756, "o", "        \"\"\"def append_event(env, action, service, version, source_env=None, forced=False):\r\n\u001b[?2004l\r"]
[3403.841823, "o", "\u001b[?2004h> "]
[3403.841926, "o", "    ensure_state()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3403.842076, "o", "    ts = now_iso()\r\n\u001b[?2004l\r"]
[3403.842152, "o", "\u001b[?2004h> "]
[3403.842521, "o", "    line = f\"{ts} {action} {service} {version}\"\r\n\u001b[?2004l\r"]
[3403.842605, "o", "\u001b[?2004h> "]
