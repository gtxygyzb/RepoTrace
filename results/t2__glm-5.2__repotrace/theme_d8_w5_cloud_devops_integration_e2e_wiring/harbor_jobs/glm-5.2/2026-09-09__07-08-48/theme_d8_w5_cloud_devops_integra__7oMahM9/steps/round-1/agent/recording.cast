[14112.335676, "o", "def get_health_state(env, service):\r\n    health = load_health(env)\r\n"]
[14112.335739, "o", "    rec = health.get(service)\r\n    if not rec or rec.get(\"state\") not in (\"healthy\", \"unhealthy\", \"degraded\"):\r\n        return \"healthy\"\r\n    state = load_deployment_state(env)\r\n    snapshot = rec.get(\"state_snapshot\")\r\n    if not snapshot or state.get(service) != snapshot:\r\n        return \"healthy\"\r\n    return rec[\"state\"]\r\n\r\ndef reset_health(env, service):\r\n    health = load_health(env)\r\n    if service in health:\r\n        del health[service]\r\n        save_health(env, health)\r\n\r\ndef reset_all_health(env):\r\n    health = load_health(env)"]
[14112.3358, "o", "\r\n    if health:\r\n        save_health(env, {})\r\n\r\ndef append_health_event(env, service, new_state, previous_state):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"HEALTH\",\r\n        \"service\": service,\r\n"]
[14112.335859, "o", "        \"version\": \"-\",\r\n        \"state\": new_state,\r\n        \"previous_state\": previous_state,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n"]
[14112.335916, "o", "\r\ndef get_replica_count(env, service):\r\n    replicas = load_replicas(env)\r\n    return replicas.get(service, 1)\r\n\r\ndef get_env_max(envs, env):\r\n    env_max = envs[env].get('max_replicas')\r\n    if env_max is None:\r\n        return None\r\n    try:\r\n        return int(env_max)\r\n"]
[14112.33598, "o", "    except (ValueError, TypeError):\r\n        return None\r\n\r\ndef parse_positive_int(s):\r\n    if not isinstance(s, str):\r\n        return None\r\n    if not re.fullmatch('[0-9]+', s):\r\n        return None\r\n    val = int(s)\r\n    if val < 1:\r\n        return None\r\n    return val\r\n\r\n\r\ndef event_file(env):\r\n    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n\r\ndef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n    ensure_state()\r\n    ts = now_iso()\r\n    line = f\"{ts} {action} {service} {version}\"\r\n    if action == \"PROMOTE\" and source_env is not None:\r\n        line += f\" from {source_env}\"\r\n        if forced:\r\n"]
[14112.33604, "o", "            line += \" (forced)\"\r\n    if action == \"RESTORE\" and snapshot_id is not None:\r\n        line += f\" from snapshot #{snapshot_id}\"\r\n    line += \"\\n\"\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(line)\r\n\r\ndef append_scale_event(env, service, count, previous):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"SCALE\",\r\n"]
[14112.336066, "o", "        \"service\": service,\r\n        \"version\": \"-\",\r\n        \"replicas\": count,\r\n        \"previous\": previous,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + chr(10))\r\n\r\ndef load_events(env):"]
[14112.336285, "o", "\r\n    ensure_state()\r\n    try:\r\n        with open(event_file(env)) as f:\r\n            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n    except FileNotFoundError:\r\n        return []\r\n    events = []\r\n    for line in lines:\r\n        if line.startswith('{'):\r\n            continue\r\n        parts = line.split()\r\n        if len(parts) < 4:\r\n            continue\r\n        events.append({\r\n            \"timestamp\": parts[0],\r\n            \"action\": parts[1],\r\n            \"service\": parts[2],\r\n            \"version\": parts[3],\r\n            \"line\": line,\r\n        })\r\n    return events\r\n\r\ndef lock_file(env):\r\n    return os.path.join(LOCK_DIR, f\"{env}.json\")\r\n\r\ndef load_lock(env):\r\n    return load_json(lock_file(env), None)\r\n\r\ndef save_lock(env, reason):\r\n    ensure_state()\r\n    existing = load_lock(env)\r\n    locked_since = existing.get('locked_since', now_iso()) if existing else now_iso()\r\n    lock = {\"reason\": reason, \"locked_since\": locked_since}\r\n    save_json(lock_file(env), lock)\r\n\r\ndef remove_lock(env):\r\n"]
[14112.336375, "o", "    try:\r\n        os.remove(lock_file(env))\r\n    except FileNotFoundError:\r\n        pass\r\n\r\ndef is_locked(env):\r\n    return load_lock(env) is not None\r\n\r\ndef assert_not_locked(env):\r\n    lock = load_lock(env)\r\n    if lock is not None:\r\n        fail(f\"{env} is locked ({lock.get('reason', 'manual lock')})\")\r\n\r\ndef append_lock_event(env, reason):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"LOCK\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n        \"reason\": reason,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n"]
[14112.336437, "o", "        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef append_unlock_event(env):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"UNLOCK\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n"]
[14112.336503, "o", "    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef assert_env_exists(env):\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"unknown environment '{env}'\")\r\n\r\n\r\ndef quota_file(env):\r\n    return os.path.join(QUOTA_DIR, f\"{env}.json\")\r\n\r\n"]
[14112.336562, "o", "def load_quotas(env):\r\n    return load_json(quota_file(env), {})\r\n\r\ndef save_quotas(env, quotas):\r\n    save_json(quota_file(env), quotas)\r\n\r\ndef quota_supported_resources():\r\n    return ['max_services', 'max_total_replicas']\r\n\r\ndef validate_quota_resource(resource):\r\n    if resource not in quota_supported_resources():\r\n        fail(f\"unknown quota resource '{resource}' (must be max_services or max_total_replicas)\")\r\n"]
[14112.33662, "o", "\r\ndef quota_current_usage(env, resource):\r\n    state = load_deployment_state(env)\r\n    replicas = load_replicas(env)\r\n    if resource == 'max_services':\r\n"]
[14112.336683, "o", "        return len(state)\r\n    if resource == 'max_total_replicas':\r\n        return sum(replicas.get(svc, 1) for svc in state)\r\n    fail(f\"unknown quota resource '{resource}' (must be max_services or max_total_replicas)\")\r\n\r\ndef append_quota_set_event(env, resource, limit):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"QUOTA_SET\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n        \"resource\": resource,\r\n        \"limit\": limit,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef append_quota_remove_event(env, resource):\r\n    ensure_state()\r\n"]
[14112.336741, "o", "    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"QUOTA_REMOVE\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n        \"resource\": resource,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef quota_status_line(env):\r\n    quotas = load_quotas(env)\r\n"]
[14112.336799, "o", "    if not quotas:\r\n        return None\r\n    parts = []\r\n    for resource in quota_supported_resources():\r\n        if resource in quotas:\r\n            limit = quotas[resource]\r\n            usage = quota_current_usage(env, resource)\r\n            parts.append(f\"{resource}={limit} ({usage}/{limit})\")\r\n    if not parts:\r\n"]
