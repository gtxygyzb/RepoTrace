[7468.826908, "o", "\r\n   228\tdef artifact_path(svc):\r\n   229\t    return os.path.join(service_path(svc), 'build', 'artifact.txt')\r\n   230\t\r\n   231\tdef read_artifact(svc):\r\n   232\t    try:\r\n   233\t        with open(artifact_path(svc)) as f:\r\n   234\t            return f.read().strip()\r\n   235\t    except FileNotFoundError:\r\n   236\t        return None\r\n   237\t\r\n   238\tdef deployment_file(env):\r\n"]
