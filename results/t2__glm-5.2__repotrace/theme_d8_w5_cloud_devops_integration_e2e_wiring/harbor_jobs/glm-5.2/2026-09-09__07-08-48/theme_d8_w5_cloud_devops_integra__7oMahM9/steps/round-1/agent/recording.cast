[1131.61741, "o", "\u001b[?2004h> "]
[1131.617437, "o", "        elif a.startswith('--'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.617531, "o", "            fail(f\"unknown option: {a}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.617601, "o", "> "]
[1131.617628, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.617719, "o", "            positionals.append(a)\r\n\u001b[?2004l\r"]
[1131.617779, "o", "\u001b[?2004h> "]
[1131.617847, "o", "        i += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.617911, "o", "    return values, flags, positionals\r\n\u001b[?2004l\r\u001b[?2004h> "]
