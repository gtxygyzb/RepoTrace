[13273.806185, "o", "\r\n    quotas = load_quotas(env)\r\n    max_services_limit = quotas.get('max_services')\r\n\r\n    if dry_run:\r\n        print(f\"DRY-RUN deploy to {env}:\")\r\n        for s in order:\r\n            print(f\"  Would deploy {s}\")\r\n        return\r\n\r\n    test_results = load_json(TEST_RESULTS_PATH, {})\r\n    state = load_deployment_state(env)\r\n    replicas = load_replicas(env)\r\n    any_fail = False\r\n    deployed_events = []\r\n\r\n"]
