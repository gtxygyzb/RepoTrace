[7537.205658, "o", " 652\t    else:\r\n   653\t        state[service] = {\"version\": target_version, \"deployed_at\": now_iso()}\r\n   654\t        save_deployment_state(env, state)\r\n   655\t        append_event(env, \"ROLLBACK\", service, target_version)\r\n   656\t        print(f\"ROLLBACK {service} from {env}: {current_version} -> {target_version}\")\r\n   657\t\r\n   658\tdef valid_version(v):\r\n   659\t    if not isinstance(v, str):\r\n   660\t        return False\r\n"]
