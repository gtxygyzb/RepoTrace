[11381.626076, "i", "sed -n '261,520p' pipeline.sh\n"]
[11381.626358, "o", "sed -n '261,520p' pipeline.sh\r\n\u001b[?2004l\r"]
[11381.629303, "o", "\r\ndef bounds_file(env):\r\n    return os.path.join(BOUNDS_DIR, f\"{env}.json\")\r\n\r\ndef load_bounds(env):\r\n    return load_json(bounds_file(env), {})\r\n\r\n"]
[11381.629514, "o", "def save_bounds(env, bounds):\r\n    save_json(bounds_file(env), bounds)\r\n"]
[11381.629638, "o", "\r\ndef health_file(env):\r\n    return os.path.join(HEALTH_DIR, f\"{env}.json\")\r\n\r\ndef load_health(env):\r\n    return load_json(health_file(env), {})\r\n\r\ndef save_health(env, data):\r\n    save_json(health_file(env), data)\r\n\r\ndef is_valid_health_state(state):\r\n    return state in (\"healthy\", \"unhealthy\", \"degraded\")\r\n\r\ndef get_health_state(env, service):\r\n    health = load_health(env)\r\n    rec = health.get(service)\r\n    if not rec or rec.get(\"state\") not in (\"healthy\", \"unhealthy\", \"degraded\"):\r\n        return \"healthy\"\r\n    state = load_deployment_state(env)\r\n    snapshot = rec.get(\"state_snapshot\")\r\n    if not snapshot or state.get(service) != snapshot:\r\n        return \"healthy\"\r\n    return rec[\"state\"]\r\n\r\ndef reset_health(env, service):\r\n    health = load_health(env)\r\n    if service in health:\r\n        del health[service]\r\n        save_health(env, health)\r\n\r\ndef reset_all_health(env):\r\n    health = load_health(env)\r\n    if health:\r\n        save_health(env, {})\r\n\r\ndef append_health_event(env, service, new_state, pr"]
[11381.629755, "o", "evious_state):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"HEALTH\",\r\n        \"service\": service,\r\n        \"version\": \"-\",\r\n        \"state\": new_state,\r\n        \"previous_state\": previous_state,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef get_replica_count(env, service):\r\n    replicas = load_replicas(env)\r\n    return replicas.get(service, 1)\r\n\r\ndef get_env_max(envs, env):\r\n    env_max = envs[env].get('max_replicas')\r\n    if env_max is None:\r\n        return None\r\n    try:\r\n        return int(env_max)\r\n    except (ValueError, TypeError):\r\n        return None\r\n\r\ndef parse_positive_int(s):\r\n    if not isinstance(s, str):\r\n        return None\r\n    if not re.fullmatch('[0-9]+', s):\r\n        return None\r\n"]
[11381.62986, "o", "    val = int(s)\r\n    if val < 1:\r\n        return None\r\n    return val\r\n\r\n\r\ndef event_file(env):\r\n    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n\r\ndef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n    ensure_state()\r\n    ts = now_iso()\r\n    line = f\"{ts} {action} {service} {version}\"\r\n    if action == \"PROMOTE\" and source_env is not None:\r\n        line += f\" from {source_env}\"\r\n        if forced:\r\n            line += \" (forced)\"\r\n    if action == \"RESTORE\" and snapshot_id is not None:\r\n        line += f\" from snapshot #{snapshot_id}\"\r\n    line += \"\\n\"\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(line)\r\n\r\ndef append_scale_event(env, service, count, previous):\r\n"]
[11381.629961, "o", "    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"SCALE\",\r\n        \"service\": service,\r\n        \"version\": \"-\",\r\n        \"replicas\": count,\r\n        \"previous\": previous,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + chr(10))\r\n\r\ndef load_events(env):\r\n    ensure_state()\r\n    try:\r\n        with open(event_file(env)) as f:\r\n            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n    except FileNotFoundError:\r\n        return []\r\n    events = []\r\n    for line in lines:\r\n        if line.startswith('{'):\r\n"]
[11381.63006, "o", "            continue\r\n        parts = line.split()\r\n        if len(parts) < 4:\r\n            continue\r\n        events.append({\r\n            \"timestamp\": parts[0],\r\n            \"action\": parts[1],\r\n            \"service\": parts[2],\r\n            \"version\": parts[3],\r\n            \"line\": line,\r\n        })\r\n    return events\r\n\r\ndef lock_file(env):\r\n    return os.path.join(LOCK_DIR, f\"{env}.json\")\r\n\r\ndef load_lock(env):\r\n    return load_json(lock_file(env), None)\r\n\r\n"]
[11381.630168, "o", "def save_lock(env, reason):\r\n    ensure_state()\r\n    existing = load_lock(env)\r\n    locked_since = existing.get('locked_since', now_iso()) if existing else now_iso()\r\n    lock = {\"reason\": reason, \"locked_since\": locked_since}\r\n    save_json(lock_file(env), lock)\r\n\r\ndef remove_lock(env):\r\n    try:\r\n        os.remove(lock_file(env))\r\n    except FileNotFoundError:\r\n        pass\r\n\r\ndef is_locked(env):\r\n    return load_lock(env) is not None\r\n\r\ndef assert_not_locked(env):\r\n    lock = load_lock(env)\r\n    if lock is not None:\r\n        fail(f\"{env} is locked ({lock.get('reason', 'manual lock')})\")\r\n\r\ndef append_lock_event(env, reason):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"LOCK\","]
[11381.630277, "o", "\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n        \"reason\": reason,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef append_unlock_event(env):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"UNLOCK\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef assert_env_exists(env):\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n"]
[11381.630363, "o", "    if env not in envs:\r\n        fail(f\"unknown environment '{env}'\")\r\n\r\ndef config_file(env):\r\n    return os.path.join(CONFIG_DIR, f\"{env}.json\")\r\n\r\ndef load_config(env):\r\n    return load_json(config_file(env), {})\r\n\r\ndef save_config(env, cfg):\r\n    save_json(config_file(env), cfg)\r\n\r\ndef validate_config_key(key):\r\n    if not isinstance(key, str) or not re.match(r'^[A-Za-z_][A-Za-z0-9_]*$', key):\r\n        fail(f\"invalid key '{key}'\")\r\n"]
[11381.630435, "o", "\r\ndef append_config_set_event(env, key, value):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"CONFIG_SET\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n        \"key\": key,\r\n"]
[11381.630502, "o", "        \"value\": value,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef append_config_delete_event(env, key):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"CONFIG_DELETE\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n        \"key\": key,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef find_rollback_target(env, service, current_version, to_version=None):\r\n    events = load_events(env)\r\n\r\n    if to_version is not None:\r\n"]
[11381.630574, "o", "        for ev in reversed(events):\r\n            if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] == to_version:\r\n                return to_version\r\n        fail(f\"version not found in history for {service}\")\r\n\r\n    current_idx = None\r\n    for idx, ev in enumerate(events):\r\n        if ev[\"service\"] != service:\r\n            continue\r\n        if ev[\"version\"] != current_version:\r\n            continue\r\n        if ev[\"action\"] == \"ROLLBACK\" and ev[\"version\"] == \"-\":\r\n            continue\r\n        current_idx = idx\r\n\r\n    if current_idx is None:\r\n"]
[11381.630638, "o", "        return None\r\n\r\n    for ev in reversed(events[:current_idx]):\r\n        if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] != current_version:\r\n            return ev[\"version\"]\r\n    return None\r\n"]
