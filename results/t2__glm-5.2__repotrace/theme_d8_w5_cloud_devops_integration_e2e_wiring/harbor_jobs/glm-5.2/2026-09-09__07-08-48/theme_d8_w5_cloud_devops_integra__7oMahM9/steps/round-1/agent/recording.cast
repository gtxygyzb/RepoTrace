[4900.160287, "o", "\t        fail(\"deploy requires an environment\")\r\n   433\t\r\n   434\t    env = positionals[0]\r\n   435\t    service = values.get('--service')\r\n   436\t    dry_run = '--dry-run' in flags\r\n   437\t\r\n   438\t    data = load_manifest()\r\n   439\t    services, envs = get_services(data)\r\n   440\t\r\n   441\t    if env not in envs:\r\n   442\t        fail(f\"environment not found: {env}\")\r\n"]
[4900.160357, "o", "   443\t\r\n   444\t    if service:\r\n   445\t        subset = transitive_deps(services, service)\r\n   446\t    else:\r\n   447\t        subset = set(services.keys())\r\n   448\t\r\n"]
[4900.160418, "o", "   449\t    order = topo_order(services, subset)\r\n   450\t    ensure_state()\r\n   451\t\r\n   452\t    if dry_run:\r\n   453\t        print(f\"DRY-RUN deploy to {env}:\")\r\n   454\t        for s in order:\r\n   455\t            print(f\"  Would deploy {s}\")\r\n   456\t        return\r\n   457\t"]
[4900.160476, "o", "\r\n   458\t    test_results = load_json(TEST_RESULTS_PATH, {})\r\n   459\t    state = load_deployment_state(env)\r\n   460\t    any_fail = False\r\n   461\t    deployed_events = []\r\n   462\t\r\n   463\t    for s in order:\r\n   464\t        rec = test_results.get(s)\r\n   465\t        if not rec or not rec.get(\"pass\"):\r\n   466"]
[4900.160534, "o", "\t            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n   467\t            any_fail = True\r\n   468\t            break\r\n   469\t\r\n   470\t        version = read_artifact(services[s])\r\n   471\t        if version is None:\r\n   472\t            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n   473\t            any_fail = True\r\n   474\t            break\r\n   475"]
[4900.160591, "o", "\t\r\n   476\t        state[s] = {\"version\": version, \"deployed_at\": now_iso()}\r\n   477\t        deployed_events.append((s, version))\r\n   478\t        print(f\"DEPLOY {s} -> {env} OK\")\r\n   479\t\r\n   480\t    save_deployment_state(env, state)\r\n   481\t    for s, version in deployed_events:\r\n   482\t        append_event(env, \"DEPLOY\", s, version)\r\n"]
[4900.160648, "o", "   483\t    if any_fail:\r\n   484\t        sys.exit(1)\r\n   485\t\r\n   486\tdef cmd_status(args):\r\n   487\t    if len(args) > 1:\r\n   488\t        fail(\"status takes at most one environment argument\")\r\n   489\t\r\n   490\t    data = load_manifest()\r\n"]
[4900.160703, "o", "   491\t    _, envs = get_services(data)\r\n   492\t\r\n   493\t    if args:\r\n   494\t        env = args[0]\r\n   495\t        if env not in envs:\r\n   496\t            fail(f\"environment not found: {env}\")\r\n   497\t        state = load_deployment_state(env)\r\n   498\t        for s in sorted(state):\r\n   499"]
[4900.160758, "o", "\t            rec = state[s]\r\n   500\t            print(f\"{s}: {rec.get('version', '')} (deployed at {rec.get('deployed_at', '')})\")\r\n   501\t    else:\r\n   502\t        for env in sorted(envs):\r\n   503\t            state = load_deployment_state(env)\r\n   504\t            print(f\"{env}: {len(state)} services deployed\")\r\n   505\t\r\n"]
