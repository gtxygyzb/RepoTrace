[8521.313049, "o", "\u001b[?2004h> "]
[8521.313118, "o", "            max_str = rest[3]\r\n\u001b[?2004l\r"]
[8521.313174, "o", "\u001b[?2004h> "]
[8521.313237, "o", "            ensure_state()\r\n\u001b[?2004l\r\u001b[?2004h"]
[8521.313301, "o", "> "]
[8521.313415, "o", "            state = load_deployment_state(env)\r\n\u001b[?2004l\r"]
[8521.313473, "o", "\u001b[?2004h> "]
[8521.313561, "o", "            if service not in state:\r\n\u001b[?2004l\r"]
[8521.313617, "o", "\u001b[?2004h> "]
[8521.313774, "o", "                fail(f\"{service} is not deployed to {env}\")\r\n\u001b[?2004l\r"]
[8521.313829, "o", "\u001b[?2004h> "]
[8521.313949, "o", "            bmin = parse_positive_int(min_str)\r\n\u001b[?2004l\r"]
[8521.314006, "o", "\u001b[?2004h> "]
[8521.314074, "o", "            if bmin is None:\r\n\u001b[?2004l\r"]
[8521.314131, "o", "\u001b[?2004h> "]
[8521.31428, "o", "                fail(\"invalid bounds: min must be >= 1\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[8521.31435, "o", "> "]
[8521.314467, "o", "            bmax = parse_positive_int(max_str)\r\n\u001b[?2004l\r"]
[8521.314524, "o", "\u001b[?2004h> "]
[8521.314637, "o", "            if bmax is None or bmax < bmin:\r\n\u001b[?2004l\r"]
[8521.314697, "o", "\u001b[?2004h> "]
[8521.314845, "o", "                fail(\"invalid bounds: max must be >= min\")\r\n\u001b[?2004l\r"]
[8521.314921, "o", "\u001b[?2004h> "]
[8521.315013, "o", "            env_max = get_env_max(envs, env)\r\n\u001b[?2004l\r"]
[8521.315081, "o", "\u001b[?2004h> "]
[8521.315216, "o", "            if env_max is not None and bmax > env_max:\r\n\u001b[?2004l\r"]
[8521.315274, "o", "\u001b[?2004h> "]
[8521.315558, "o", "                fail(f\"invalid bounds: max ({bmax}) exceeds max_replicas ({env_max}) for {env}\")\r\n\u001b[?2004l\r"]
[8521.315615, "o", "\u001b[?2004h> "]
[8521.315697, "o", "            assert_not_locked(env)\r\n\u001b[?2004l\r"]
[8521.315753, "o", "\u001b[?2004h> "]
[8521.315844, "o", "            bounds = load_bounds(env)\r\n\u001b[?2004l\r"]
[8521.315916, "o", "\u001b[?2004h> "]
[8521.316006, "o", "            bounds[service] = [bmin, bmax]\r\n\u001b[?2004l\r"]
[8521.316062, "o", "\u001b[?2004h> "]
[8521.316151, "o", "            save_bounds(env, bounds)\r\n\u001b[?2004l\r"]
[8521.316206, "o", "\u001b[?2004h> "]
[8521.316396, "o", "            print(f\"BOUNDS {env}/{service} set to [{bmin}..{bmax}]\")\r\n\u001b[?2004l\r"]
[8521.316475, "o", "\u001b[?2004h> "]
[8521.316553, "o", "            replicas = load_replicas(env)\r\n\u001b[?2004l\r"]
[8521.316613, "o", "\u001b[?2004h> "]
[8521.316728, "o", "            current = replicas.get(service, 1)\r\n\u001b[?2004l\r"]
[8521.316783, "o", "\u001b[?2004h> "]
[8521.316858, "o", "            if current < bmin:\r\n\u001b[?2004l\r"]
[8521.316915, "o", "\u001b[?2004h> "]
[8521.316995, "o", "                previous = current\r\n\u001b[?2004l\r"]
[8521.31705, "o", "\u001b[?2004h> "]
[8521.317165, "o", "                replicas[service] = bmin\r\n\u001b[?2004l\r"]
[8521.31722, "o", "\u001b[?2004h> "]
[8521.317343, "o", "                save_replicas(env, replicas)\r\n\u001b[?2004l\r"]
[8521.317399, "o", "\u001b[?2004h> "]
[8521.31757, "o", "                append_scale_event(env, service, bmin, previous)\r\n\u001b[?2004l\r"]
[8521.317626, "o", "\u001b[?2004h> "]
[8521.317858, "o", "                print(f\"SCALED {env}/{service} to {bmin} replicas (was {previous})\")\r\n\u001b[?2004l\r"]
[8521.317915, "o", "\u001b[?2004h> "]
[8521.31799, "o", "            elif current > bmax:\r\n\u001b[?2004l\r"]
[8521.318046, "o", "\u001b[?2004h> "]
[8521.318128, "o", "                previous = current\r\n\u001b[?2004l\r"]
[8521.318184, "o", "\u001b[?2004h> "]
[8521.318268, "o", "                replicas[service] = bmax\r\n\u001b[?2004l\r\u001b[?2004h> "]
