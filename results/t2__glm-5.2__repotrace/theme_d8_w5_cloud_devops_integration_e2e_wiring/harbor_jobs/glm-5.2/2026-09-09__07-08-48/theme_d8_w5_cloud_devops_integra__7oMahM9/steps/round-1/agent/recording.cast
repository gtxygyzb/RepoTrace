[7457.866741, "o", "\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kappend_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_events(env):\r\n\u001b[32m\u001b[K287\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Klock_file(env):\r\n"]
[7457.866817, "o", "\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kload_lock(env):\r\n\u001b[32m\u001b[K293\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksave_lock(env, reason):\r\n\u001b[32m\u001b[K300\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kremove_lock(env):\r\n\u001b[32m\u001b[K306\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kis_locked(env):\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kassert_not_locked(env):\r\n"]
[7457.866892, "o", "\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kappend_lock_event(env, reason):\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f.write(\u001b[01;31m\u001b[Kjson.dump\u001b[m\u001b[Ks(event) + \"\\n\")\r\n\u001b[32m\u001b[K327\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kappend_unlock_event(env):\r\n\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f.write(\u001b[01;31m\u001b[Kjson.dump\u001b[m\u001b[Ks(event) + \"\\n\")\r\n"]
