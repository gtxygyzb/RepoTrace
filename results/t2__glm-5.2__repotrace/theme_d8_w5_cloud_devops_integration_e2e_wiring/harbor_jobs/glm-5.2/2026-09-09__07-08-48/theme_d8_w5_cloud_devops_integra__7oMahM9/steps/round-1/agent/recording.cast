[11788.771038, "o", "\u001b[?2004h"]
[11788.771071, "o", "> "]
[11788.771318, "o", "        \"iso_timestamp\": now_iso(),\r\n"]
[11788.78692, "o", "\u001b[?2004l\r\u001b[?2004h>         \"action\": \"QUOTA_REMOVE\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[11788.787025, "o", "> "]
[11788.787104, "o", "        \"service\": \"-\",\r\n\u001b[?2004l\r"]
[11788.787195, "o", "\u001b[?2004h> "]
[11788.787349, "o", "        \"version\": \"-\",\r\n"]
[11788.787439, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[11788.787622, "o", "        \"resource\": resource,\r\n\u001b[?2004l\r"]
[11788.787709, "o", "\u001b[?2004h> "]
[11788.787802, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.788078, "o", "    with open(event_file(env), \"a\") as f:\r\n\u001b[?2004l\r"]
[11788.788165, "o", "\u001b[?2004h> "]
[11788.788443, "o", "        f.write(json.dumps(event) + \"\\n\")\r\n\u001b[?2004l\r"]
