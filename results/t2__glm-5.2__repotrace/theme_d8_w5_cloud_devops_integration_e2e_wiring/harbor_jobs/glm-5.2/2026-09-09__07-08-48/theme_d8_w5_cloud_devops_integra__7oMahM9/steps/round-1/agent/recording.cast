[3092.270074, "o", "\u001b[?2004l\r"]
[3092.273255, "o", "def version_timestamp(version):\r\n    if not isinstance(version, str):\r\n        return None\r\n    parts = version.split(\":\")\r\n"]
[3092.273266, "o", "    if len(parts) >= 3:\r\n        try:\r\n            return int(parts[1])\r\n"]
[3092.273273, "o", "        except ValueError:\r\n            return None\r\n"]
[3092.273312, "o", "    return None\r\n\r\ndef cmd_promote(args):\r\n    values, flags, positionals = parse_opts(args, {\"--service\"}, {\"--dry-run\"})\r\n"]
[3092.27332, "o", "    if len(positionals) != 2:\r\n        fail(\"promote requires <source-env> <target-env>\")\r\n"]
[3092.273505, "o", "\r\n    source, target = positionals\r\n    service = values.get(\"--service\")\r\n    dry_run = \"--dry-run\" in flags\r\n\r\n    data = load_manifest()\r\n    services, envs = get_services(data)\r\n\r\n    if source not in envs:\r\n        fail(f\"environment not found: {source}\")\r\n    if target not in envs:\r\n        fail(f\"environment not found: {target}\")\r\n\r\n    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n"]
[3092.27352, "o", "\r\n    ensure_state()\r\n    source_state = load_deployment_state(source)\r\n    target_state = load_deployment_state(target)\r\n\r\n    candidates = {s for s in source_state if s in subset and s in services}\r\n    order = topo_order(services, candidates)\r\n\r\n    if dry_run:\r\n        print(f\"DRY-RUN promote from {source} to {target}:\")\r\n        for s in order:\r\n            if source_state[s].get(\"version\") == target_state.get(s, {}).get(\"version\"):\r\n                continue\r\n            print(f\"  Would promote {s}\")\r\n        return\r\n\r\n    promoted = 0\r\n    skipped = 0\r\n    promote_events = []\r\n\r\n    for s in order:\r\n        src_rec = source_state[s]\r\n        src_version = src_rec.get(\"version\")\r\n        if target_state.get(s, {}).get(\"version\") == src_version:\r\n            print(f\"PROMOTE {s} -> {target}: SKIP (same version)\")\r\n            skipped += 1\r\n            continue\r\n"]
[3092.273594, "o", "\r\n        target_state[s] = src_rec\r\n        print(f\"PROMOTE {s} -> {target} OK\")\r\n        promoted += 1\r\n        promote_events.append((s, src_version))\r\n\r\n    save_deployment_state(target, target_state)\r\n    for s, version in promote_events:\r\n        append_event(target, \"PROMOTE\", s, version, source)\r\n    print(f\"Promoted {promoted}, skipped {skipped}\")\r\n\r\ndef cmd_diff(args):\r\n    if len(args) != 2:\r\n        fail(\"diff requires <env1> <env2>\")"]
[3092.273605, "o", "\r\n\r\n"]
[3092.27362, "o", "    env1, env2 = args\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n\r\n"]
[3092.27373, "o", "    if env1 not in envs:\r\n        fail(f\"environment not found: {env1}\")\r\n    if env2 not in envs:\r\n        fail(f\"environment not found: {env2}\")\r\n\r\n    ensure_state()\r\n    state1 = load_deployment_state(env1)\r\n    state2 = load_deployment_state(env2)\r\n\r\n    all_services = sorted(set(state1) | set(state2))\r\n    if not all_services:\r\n        return\r\n\r\n    for s in all_services:\r\n        v1 = state1.get(s, {}).get(\"version\")\r\n        v2 = state2.get(s, {}).get(\"version\")\r\n\r\n        if v1 and not v2:\r\n            print(f\"ONLY_IN {env1}: {s} ({v1})\")\r\n        elif v2 and not v1:\r\n            print(f\"ONLY_IN {env2}: {s} ({v2})\")\r\n        elif v1 == v2:\r\n            print(f\"SAME: {s} ({v1})\")\r\n        else:\r\n            t1 = version_timestamp(v1)"]
[3092.273782, "o", "\r\n            t2 = version_timestamp(v2)\r\n            if t1 is not None and t2 is not None:\r\n"]
