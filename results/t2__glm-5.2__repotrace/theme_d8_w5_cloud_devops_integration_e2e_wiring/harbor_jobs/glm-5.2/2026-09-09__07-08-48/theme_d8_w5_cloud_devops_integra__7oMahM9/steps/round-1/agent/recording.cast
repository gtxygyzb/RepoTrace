[5648.261797, "o", "def cmd_history(args):\r\n    values, flags, positionals = parse_opts(args, {\"--service\", \"--limit\"}, set())\r\n    if len(positionals) != 1:\r\n        fail(\"history requires an environment\")\r\n\r\n    env = positionals[0]"]
[5648.261871, "o", "\r\n    service = values.get(\"--service\")\r\n    limit = 10\r\n    if \"--limit\" in values:\r\n        try:\r\n            limit = int(values[\"--limit\"])\r\n        except ValueError:\r\n            fail(\"--limit requires an integer\")\r\n        if limit < 0:\r\n            fail(\"--limit must be non-negative\")\r\n\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n\r\n"]
[5648.261928, "o", "    ensure_state()\r\n    try:\r\n        with open(event_file(env)) as f:\r\n            raw_lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n    except FileNotFoundError:\r\n        raw_lines = []\r\n\r\n    entries = []\r\n    for line in raw_lines:\r\n        if line.startswith('{'):\r\n            try:\r\n                ev = json.loads(line)\r\n            except json.JSONDecodeError:\r\n"]
[5648.261979, "o", "                continue\r\n            action = ev.get(\"action\")\r\n            iso = ev.get(\"iso_timestamp\", \"\")\r\n            svc = ev.get(\"service\", \"-\")\r\n            if action == \"LOCK\":\r\n                entries.append((iso, svc, f\"{iso} LOCK {ev.get('reason', '')}\"))\r\n            elif action == \"UNLOCK\":\r\n                entries.append((iso, svc, f\"{iso} UNLOCK\"))\r\n            else:\r\n                entries.append((iso, svc, line))\r\n"]
[5648.262029, "o", "        else:\r\n            parts = line.split()\r\n            svc = parts[2] if len(parts) >= 3 else \"\"\r\n            iso = parts[0] if parts else \"\"\r\n            entries.append((iso, svc, line))\r\n\r\n    if service:\r\n        entries = [e for e in entries if e[1] == service]\r\n\r\n    entries.reverse()\r\n"]
[5648.26208, "o", "    entries = entries[:limit]\r\n    for iso, svc, line in entries:\r\n        print(line)\r\n\r\ndef print_tree(node, services, path, depth):\r\n    print(\"  \" * depth + node)\r\n    if node in path:\r\n        return\r\n    path = path | {node}\r\n    children = sorted([s for s in services if node in services[s].get('depends_on', [])])\r\n    for child in children:\r\n        print_tree(child, services, path, depth + 1)"]
[5648.262128, "o", "\r\n\r\ndef cmd_graph(args):\r\n    values, flags, positionals = parse_opts(args, {'--format'}, set())\r\n    if positionals:\r\n        fail(\"graph does not accept positional arguments\")\r\n\r\n    fmt = values.get('--format', 'text')\r\n    if fmt not in ('dot', 'text'):\r\n        fail(\"graph format must be dot or text\")\r\n"]
[5648.262176, "o", "\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n\r\n    if fmt == 'dot':\r\n        print(\"digraph pipeline {\")\r\n        for dep in sorted(services):\r\n            dependents = sorted([s for s in services if dep in services[s].get('depends_on', [])])\r\n            for dependent in dependents:\r\n                print(f'  \"{dep}\" -> \"{dependent}\";')\r\n        print(\"}\")\r\n"]
[5648.262224, "o", "    else:\r\n        roots = sorted([s for s in services if not services[s].get('depends_on')])\r\n        for root in roots:\r\n            print_tree(root, services, set(), 0)\r\n\r\ndef cmd_bump(args):\r\n    if len(args) != 2:\r\n        fail(\"bump requires <service> <major|minor|patch>\")\r\n\r\n    service, level = args\r\n"]
[5648.262271, "o", "    if level not in ('major', 'minor', 'patch'):\r\n        fail(\"bump level must be major, minor, or patch\")\r\n\r\n    data = load_manifest()\r\n    services = data.get('services')\r\n    if not isinstance(services, dict) or service not in services:\r\n        fail(f\"service not found: {service}\")\r\n\r\n    old = services[service].get('version')\r\n    sv = parse_semver(old)\r\n"]
[5648.262326, "o", "    if sv is None:\r\n        fail(f\"service {service} has invalid version: {old}\")\r\n\r\n    major, minor, patch = sv\r\n    if level == 'major':\r\n        new = f\"{major + 1}.0.0\"\r\n    elif level == 'minor':\r\n        new = f\"{major}.{minor + 1}.0\"\r\n    else:\r\n"]
[5648.262378, "o", "        new = f\"{major}.{minor}.{patch + 1}\"\r\n\r\n    services[service]['version'] = new\r\n    with open(MANIFEST_PATH, 'w') as f:\r\n        yaml.safe_dump(data, f, sort_keys=False)\r\n    print(f\"BUMP {service} {old} -> {new}\")\r\n\r\ndef snapshot_file(env):\r\n    return os.path.join(SNAPSHOTS_DIR, f\"{env}.json\")\r\n\r\ndef load_snapshots(env):\r\n    return load_json(snapshot_file(env), [])"]
