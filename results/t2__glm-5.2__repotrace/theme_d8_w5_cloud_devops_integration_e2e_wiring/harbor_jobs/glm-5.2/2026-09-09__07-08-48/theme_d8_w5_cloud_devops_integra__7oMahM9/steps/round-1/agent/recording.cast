[14757.849931, "o", "  1801\tdef audit_event_entries(env):\r\n  1802\t    ensure_state()\r\n  1803\t    try:\r\n  1804\t        with open(event_file(env)) as f:\r\n  1805\t            raw_lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n  1806\t"]
[14757.850048, "o", "    except FileNotFoundError:\r\n  1807\t        raw_lines = []\r\n  1808\t\r\n  1809\t    entries = []\r\n  1810\t    for line in raw_lines:\r\n  1811\t        if line.startswith('{'):\r\n  1812\t            try:\r\n  1813\t                ev = json.loads(line)\r\n  1814\t            except json.JSONDecodeError:\r\n  1815\t                continue\r\n  1816\t            action = ev.get(\"action\")\r\n  1817\t            iso = ev.get(\"iso_timestamp\", \"\")\r\n  1818\t            svc = ev.get(\"service\", \"-\")\r\n  1819\t            if action == \"LOCK\":\r\n  1820\t                details = ev.get(\"reason\", \"\")\r\n  1821\t                display = f\"{iso} LOCK {details}\" if details else f\"{iso} LOCK\"\r\n  1822\t            elif action == \"UNLOCK\":\r\n"]
[14757.850155, "o", "  1823\t                details = \"\"\r\n  1824\t                display = f\"{iso} UNLOCK\"\r\n  1825\t            elif action == \"CONFIG_SET\":\r\n  1826\t                details = f\"{ev.get('key', '')}={ev.get('value', '')}\"\r\n  1827\t                display = f\"{iso} CONFIG_SET {details}\"\r\n  1828\t            elif action == \"CONFIG_DELETE\":\r\n  1829\t                details = ev.get(\"key\", \"\")\r\n  1830\t                display = f\"{iso} CONFIG_DELETE {details}\"\r\n  1831\t            elif action == \"SCALE\":\r\n  1832\t                details = f\"{svc} from {ev.get('previous', '-')} to {ev.get('replicas', '-')} replicas\"\r\n  1833\t                display = f\"{iso} SCALE {details}\"\r\n  1834\t            elif action == \"HEALTH\":\r\n  1835\t                details = f\"{svc} {ev.get('previous_state', '-')} -> {ev.get('state', '-')}\"\r\n  1836\t                display = f\"{iso} HEALTH {details}\"\r\n"]
[14757.850234, "o", "  1837\t            elif action == \"QUOTA_SET\":\r\n  1838\t                details = f\"{ev.get('resource', '-')}={ev.get('limit', '-')}\"\r\n  1839\t                display = f\"{iso} QUOTA_SET {details}\"\r\n  1840\t            elif action == \"QUOTA_REMOVE\":\r\n  1841\t                details = ev.get(\"resource\", \"-\")\r\n  1842\t                display = f\"{iso} QUOTA_REMOVE {details}\"\r\n  1843\t            elif action == \"CLONE\":\r\n  1844\t                details = f\"from {ev.get('source', '-')}\"\r\n  1845\t                display = f\"{iso} CLONE {details}\"\r\n  1846\t            else:\r\n  1847\t"]
[14757.850354, "o", "                action = ev.get(\"action\", \"\")\r\n  1848\t                parts = line.split(None, 2)\r\n  1849\t                details = parts[2] if len(parts) > 2 else \"\"\r\n  1850\t                display = line\r\n  1851\t        else:\r\n  1852\t            parts = line.split(None, 2)\r\n  1853\t            iso = parts[0] if parts else \"\"\r\n  1854\t            action = parts[1] if len(parts) > 1 else \"\"\r\n  1855\t            details = parts[2] if len(parts) > 2 else \"\"\r\n  1856\t            display = line\r\n  1857\t\r\n  1858\t        entries.append({\r\n  1859\t            \"timestamp\": iso,\r\n  1860\t            \"action\": action,\r\n  1861\t            \"details\": details,\r\n  1862\t            \"display\": display,\r\n"]
[14757.850446, "o", "  1863\t        })\r\n  1864\t\r\n  1865\t    entries.reverse()\r\n  1866\t    return entries[:10]\r\n  1867\t\r\n  1868\tdef cmd_audit(args):\r\n  1869\t    values, flags, positionals = parse_opts(args, {\"--section\"}, {\"--json\"})\r\n  1870\t    if len(positionals) != 1:\r\n  1871\t        fail(\"audit requires an environment\")\r\n  1872\t\r\n  1873\t    env = positionals[0]\r\n  1874\t    assert_env_exists(env)\r\n  1875\t"]
[14757.850516, "o", "\r\n  1876\t    section = values.get(\"--section\")\r\n  1877\t    valid_sections = {\r\n  1878\t        \"deployment\": \"Deployment Summary\",\r\n  1879\t        \"replicas\": \"Replica Summary\",\r\n  1880\t        \"health\": \"Health Summary\",\r\n  1881\t        \"quotas\": \"Quota Status\",\r\n  1882\t        \"config\": \"Config Variables\",\r\n  1883\t        \"lock\": \"Lock Status\",\r\n  1884\t        \"activity\": \"Recent Activity\",\r\n  1885\t    }\r\n  1886\t"]
[14757.850587, "o", "    if section is not None and section not in valid_sections:\r\n  1887\t        fail(f\"unknown section '{section}' (valid: deployment, replicas, health, quotas, config, lock, activity)\")\r\n  1888\t    if \"--json\" in flags and section is not None:\r\n  1889\t        fail(\"--json and --section cannot be combined\")\r\n  1890\t\r\n  1891\t    state = load_deployment_state(env)\r\n  1892\t    services = sorted(state)\r\n  1893\t    deployment = {}\r\n  1894\t    replicas = {}\r\n  1895\t    health = {}\r\n"]
[14757.850665, "o", "  1896\t    for s in services:\r\n  1897\t        rec = state[s]\r\n  1898\t        deployment[s] = {\r\n  1899\t            \"version\": rec.get(\"version\", \"\"),\r\n  1900\t            \"timestamp\": rec.get(\"deployed_at\", \"\"),\r\n  1901\t        }\r\n  1902\t        replicas[s] = get_replica_count(env, s)\r\n  1903\t        health[s] = get_health_state(env, s)\r\n  1904\t\r\n  1905\t    quota_data = load_quotas(env)\r\n  1906\t    quotas = {}\r\n  1907\t    for resource in sorted(quota_data):\r\n  1908\t"]
[14757.850734, "o", "        limit = quota_data[resource]\r\n  1909\t        usage = quota_current_usage(env, resource)\r\n  1910\t        status = \"OK\" if usage <= limit else \"EXCEEDED\"\r\n  1911\t        quotas[resource] = {\r\n  1912\t            \"limit\": limit,\r\n  1913\t            \"current\": usage,\r\n  1914\t            \"status\": status,\r\n  1915\t        }\r\n  1916\t\r\n  1917\t    config_keys = sorted(load_config(env).keys())\r\n  1918\t    lock = load_lock(env)\r\n  1919"]
[14757.850802, "o", "\t    activity = audit_event_entries(env)\r\n  1920\t\r\n  1921\t    if \"--json\" in flags:\r\n  1922\t        report = {\r\n  1923\t            \"environment\": env,\r\n  1924\t            \"deployment\": deployment,\r\n  1925\t            \"replicas\": replicas,\r\n  1926\t            \"health\": health,\r\n  1927\t            \"quotas\": quotas,\r\n"]
[14757.850877, "o", "  1928\t            \"config\": config_keys,\r\n  1929\t            \"lock\": {\r\n  1930\t                \"locked\": lock is not None,\r\n  1931\t                \"reason\": lock.get(\"reason\", \"manual lock\") if lock is not None else None,\r\n  1932\t            },\r\n  1933\t            \"activity\": [\r\n  1934\t                {\r\n  1935\t                    \"timestamp\": e[\"timestamp\"],\r\n"]
