[7469.732971, "o", "  1169\tdef cmd_config_import(args):\r\n  1170\t    if len(args) != 1:\r\n  1171\t        fail(\"config import requires <environment>\")\r\n  1172\t    env = args[0]\r\n  1173\t    raw = sys.stdin.read()\r\n  1174\t    try:\r\n  1175\t        data = json.loads(raw)\r\n  1176\t    except json.JSONDecodeError as e:\r\n  1177\t        fail(f\"invalid JSON: {e}\")\r\n  1178\t    if not isinstance(data, dict):\r\n  1179\t        fail(\"invalid JSON input: expected an object\")\r\n  1180\t    for key, value in data.items():\r\n"]
