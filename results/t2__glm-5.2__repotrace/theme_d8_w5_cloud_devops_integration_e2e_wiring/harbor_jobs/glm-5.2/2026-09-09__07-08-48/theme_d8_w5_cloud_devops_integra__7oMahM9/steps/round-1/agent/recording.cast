[4907.621593, "o", "   240\tdef event_file(env):\r\n   241\t    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n   242\t\r\n   243\tdef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n   244\t    ensure_state()\r\n   245\t    ts = now_iso()\r\n   246\t    line = f\"{ts} {action} {service} {version}\"\r\n   247\t    if action == \"PROMOTE\" and source_env is not None:\r\n   248\t        line += f\" from {source_env}\"\r\n   249\t        if forced:\r\n   250\t            line += \" (forced)\"\r\n   251\t    if action == \"RESTORE\" and snapshot_id is not None:\r\n   252\t        line += f\" from snapshot #{snapshot_id}\"\r\n   253\t    line += \"\\n\"\r\n"]
[4907.621709, "o", "   254\t    with open(event_file(env), \"a\") as f:\r\n   255\t        f.write(line)\r\n   256\t\r\n   257\tdef load_events(env):\r\n   258\t    ensure_state()\r\n   259\t    try:\r\n   260\t        with open(event_file(env)) as f:\r\n   261\t            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n"]
[4907.621787, "o", "   262\t    except FileNotFoundError:\r\n   263\t        return []\r\n   264\t    events = []\r\n   265\t    for line in lines:\r\n   266\t        parts = line.split()\r\n   267\t        if len(parts) < 4:\r\n   268\t            continue\r\n   269\t        events.append({\r\n   270\t            \"timestamp\": parts[0],\r\n"]
[4907.621868, "o", "   271\t            \"action\": parts[1],\r\n   272\t            \"service\": parts[2],\r\n   273\t            \"version\": parts[3],\r\n   274\t            \"line\": line,\r\n   275\t        })\r\n   276\t    return events\r\n"]
[4907.621952, "o", "   277\t\r\n   278\tdef find_rollback_target(env, service, current_version, to_version=None):\r\n   279\t    events = load_events(env)\r\n   280\t\r\n   281\t    if to_version is not None:\r\n   282\t        for ev in reversed(events):\r\n   283\t            if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] == to_version:\r\n   284\t                return to_version\r\n   285\t        fail(f\"version not found in history for {service}\")\r\n   286\t\r\n   287\t    current_idx = None\r\n"]
