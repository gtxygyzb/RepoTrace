[9445.367422, "o", "def cmd_promote(args):\r\n    values, flags, positionals = parse_opts(args, {\"--service\"}, {\"--dry-run\", \"--force\"})\r\n    if len(positionals) != 2:\r\n        fail(\"promote requires <source-env> <target-env>\")\r\n\r\n"]
[9445.367565, "o", "    source, target = positionals\r\n    service = values.get(\"--service\")\r\n    dry_run = \"--dry-run\" in flags\r\n    force = \"--force\" in flags\r\n\r\n    data = load_manifest()\r\n    services, envs = get_services(data)\r\n\r\n    if source not in envs:\r\n"]
[9445.367652, "o", "        fail(f\"environment not found: {source}\")\r\n    if target not in envs:\r\n        fail(f\"environment not found: {target}\")\r\n\r\n    assert_not_locked(target)\r\n\r\n    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n\r\n    ensure_state()\r\n    source_state = load_deployment_state(source)\r\n    target_state = load_deployment_state(target)\r\n    target_replicas = load_replicas(target)\r\n\r\n    candidates = {s for s in source_state if s in subset and s in services}\r\n    order = topo_order(services, candidates)\r\n\r\n    if dry_run:\r\n        print(f\"DRY-RUN promote from {source} to {target}:\")\r\n        for s in order:\r\n            src_version = source_state[s].get(\"version\")\r\n            tgt_version = target_state.get(s, {}).get(\"version\")\r\n            if src_version == tgt_version:\r\n                continue\r\n            src_sv = extract_semver(src_version)\r\n            tgt_sv = extract_semver(tgt_version)\r\n            if src_sv is not None and tgt_sv is n"]
[9445.367741, "o", "ot None and tgt_sv > src_sv:\r\n                print(f\"  Would conflict {s} (downgrade)\")\r\n            else:\r\n                print(f\"  Would promote {s}\")\r\n        return\r\n\r\n    promoted = 0\r\n    skipped = 0\r\n    conflicts = 0\r\n    promote_events = []\r\n\r\n    for s in order:\r\n        src_rec = source_state[s]\r\n"]
[9445.367821, "o", "        src_version = src_rec.get(\"version\")\r\n        if target_state.get(s, {}).get(\"version\") == src_version:\r\n            print(f\"PROMOTE {s} -> {target}: SKIP (same version)\")\r\n            skipped += 1\r\n            continue\r\n\r\n        src_sv = extract_semver(src_version)\r\n        tgt_sv = extract_semver(target_state.get(s, {}).get(\"version\"))\r\n        if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:\r\n            if force:\r\n                target_state[s] = src_rec\r\n                target_replicas[s] = 1\r\n                print(f\"PROMOTE {s} -> {target} OK (forced)\")\r\n                promoted += 1\r\n                promote_events.append((s, src_version, True))\r\n            else:\r\n                print(f\"CONFLICT: {s} -> {target}: downgrade ({src_sv[0]}.{src_sv[1]}.{src_sv[2]} < {tgt_sv[0]}.{tgt_sv[1]}.{tgt_sv[2]})\")\r\n                conflicts += 1\r\n            continue\r\n\r\n        target_state[s] = src_rec\r\n"]
[9445.367894, "o", "        target_replicas[s] = 1\r\n        print(f\"PROMOTE {s} -> {target} OK\")\r\n        promoted += 1\r\n        promote_events.append((s, src_version, False))\r\n\r\n    save_deployment_state(target, target_state)\r\n    save_replicas(target, target_replicas)\r\n    for s, version, forced in promote_events:\r\n        append_event(target, \"PROMOTE\", s, version, source, forced=forced)\r\n    print(f\"Promoted {promoted}, skipped {skipped}, conflicts {conflicts}\")\r\ndef cmd_diff(args):\r\n"]
[9445.367967, "o", "    if len(args) != 2:\r\n        fail(\"diff requires <env1> <env2>\")\r\n\r\n    env1, env2 = args\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n\r\n    if env1 not in envs:\r\n        fail(f\"environment not found: {env1}\")\r\n    if env2 not in envs:\r\n        fail(f\"environment not found: {env2}\")\r\n\r\n    ensure_state()\r\n    state1 = load_deployment_state(env1)\r\n    state2 = load_deployment_state(env2)\r\n\r\n    all_services = sorted(set(state1) | set(state2))\r\n"]
[9445.368037, "o", "    if not all_services:\r\n        return\r\n\r\n    for s in all_services:\r\n        v1 = state1.get(s, {}).get(\"version\")\r\n        v2 = state2.get(s, {}).get(\"version\")\r\n\r\n        if v1 and not v2:\r\n            print(f\"ONLY_IN {env1}: {s} ({v1})\")\r\n        elif v2 and not v1:\r\n            print(f\"ONLY_IN {env2}: {s} ({v2})\")\r\n        elif v1 == v2:\r\n            print(f\"SAME: {s} ({v1})\")\r\n        else:\r\n            cmp = compare_versions(v1, v2)\r\n"]
[9445.368111, "o", "            if cmp == 0:\r\n                print(f\"SAME: {s} ({v1})\")\r\n            else:\r\n                newer = env1 if cmp > 0 else env2\r\n                print(f\"DIFFERS: {s} {v1} vs {v2} ({newer} newer)\")\r\n\r\ndef cmd_history(args):\r\n    values, flags, positionals = parse_opts(args, {\"--service\", \"--limit\"}, set())\r\n    if len(positionals) != 1:\r\n"]
[9445.368184, "o", "        fail(\"history requires an environment\")\r\n\r\n    env = positionals[0]\r\n    service = values.get(\"--service\")\r\n    limit = 10\r\n    if \"--limit\" in values:\r\n        try:\r\n            limit = int(values[\"--limit\"])\r\n        except ValueError:\r\n            fail(\"--limit requires an integer\")\r\n        if limit < 0:\r\n            fail(\"--limit must be non-negative\")\r\n\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n\r\n    ensure_state()\r\n    try:\r\n        with open(event_file(env)) as f:\r\n            raw_lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n    except FileNotFoundError:\r\n"]
[9445.368255, "o", "        raw_lines = []\r\n\r\n    entries = []\r\n    for line in raw_lines:\r\n        if line.startswith('{'):\r\n            try:\r\n                ev = json.loads(line)\r\n            except json.JSONDecodeError:\r\n                continue\r\n            action = ev.get(\"action\")\r\n            iso = ev.get(\"iso_timestamp\", \"\")\r\n            svc = ev.get(\"service\", \"-\")\r\n            if action == \"LOCK\":\r\n"]
[9445.36835, "o", "                entries.append((iso, svc, f\"{iso} LOCK {ev.get('reason', '')}\"))\r\n            elif action == \"UNLOCK\":\r\n                entries.append((iso, svc, f\"{iso} UNLOCK\"))\r\n            elif action == \"CONFIG_SET\":\r\n                entries.append((iso, svc, f\"{iso} CONFIG_SET {ev.get('key', '')}={ev.get('value', '')}\"))\r\n            elif action == \"CONFIG_DELETE\":\r\n                entries.append((iso, svc, f\"{iso} CONFIG_DELETE {ev.get('key', '')}\"))\r\n            elif action == \"SCALE\":\r\n                entries.append((iso, svc, f\"{iso} SCALE {svc} from {ev.get('previous', '-')} to {ev.get('replicas', '-')} replicas\"))\r\n            else:\r\n                entries.append((iso, svc, line))\r\n        else:\r\n            parts = line.split()\r\n            svc = parts[2] if len(parts) >= 3 else \"\"\r\n            iso = parts[0] if parts else \"\"\r\n            entries.append((iso, svc, line))\r\n"]
[9445.368422, "o", "\r\n    if service:\r\n        entries = [e for e in entries if e[1] == service]\r\n\r\n    entries.reverse()\r\n    entries = entries[:limit]\r\n    for iso, svc, line in entries:\r\n        print(line)\r\n\r\ndef print_tree(node, services, path, depth):\r\n    print(\"  \" * depth + node)\r\n    if node in path:\r\n        return\r\n    path = path | {node}\r\n    children = sorted([s for s in services if node in services[s].get('depends_on', [])])\r\n    for child in children:\r\n        print_tree(child, services, path, depth + 1)\r\n"]
