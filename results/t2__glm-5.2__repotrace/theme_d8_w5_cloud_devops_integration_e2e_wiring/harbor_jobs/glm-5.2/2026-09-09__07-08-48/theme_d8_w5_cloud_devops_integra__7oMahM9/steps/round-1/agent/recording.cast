[5603.863487, "i", "sed -n '241,520p' pipeline.sh\n"]
[5603.863759, "o", "sed -n '241,520p' pipeline.sh\r\n\u001b[?2004l\r"]
[5603.866656, "o", "\r\ndef event_file(env):\r\n    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n\r\n"]
[5603.866787, "o", "def append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n    ensure_state()\r\n    ts = now_iso()\r\n    line = f\"{ts} {action} {service} {version}\"\r\n    if action == \"PROMOTE\" and source_env is not None:\r\n        line += f\" from {source_env}\"\r\n        if forced:\r\n            line += \" (forced)\"\r\n    if action == \"RESTORE\" and snapshot_id is not None:\r\n        line += f\" from snapshot #{snapshot_id}\"\r\n    line += \"\\n\"\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(line)\r\n\r\ndef load_events(env):\r\n    ensure_state()\r\n    try:\r\n        with open(event_file(env)) as f:\r\n            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n    except FileNotFoundError:\r\n        return []\r\n    events = []\r\n    for line in lines:\r\n        if line.startswith('{'):\r\n            continue"]
[5603.866887, "o", "\r\n        parts = line.split()\r\n        if len(parts) < 4:\r\n            continue\r\n        events.append({\r\n            \"timestamp\": parts[0],\r\n            \"action\": parts[1],\r\n            \"service\": parts[2],\r\n            \"version\": parts[3],\r\n            \"line\": line,\r\n        })\r\n    return events\r\n\r\ndef lock_file(env):\r\n    return os.path.join(LOCK_DIR, f\"{env}.json\")\r\n\r\ndef load_lock(env):\r\n    return load_json(lock_file(env), None)\r\n\r\ndef save_lock(env, reason):\r\n    ensure_state()\r\n    existing = load_lock(env)\r\n"]
[5603.866979, "o", "    locked_since = existing.get('locked_since', now_iso()) if existing else now_iso()\r\n    lock = {\"reason\": reason, \"locked_since\": locked_since}\r\n    save_json(lock_file(env), lock)\r\n\r\ndef remove_lock(env):\r\n    try:\r\n        os.remove(lock_file(env))\r\n    except FileNotFoundError:\r\n        pass\r\n\r\ndef is_locked(env):\r\n    return load_lock(env) is not None\r\n\r\ndef assert_not_locked(env):\r\n    lock = load_lock(env)\r\n    if lock is not None:\r\n        fail(f\"{env} is locked ({lock.get('reason', 'manual lock')})\")\r\n\r\ndef append_lock_event(env, reason):\r\n    ensure_state()\r\n    event = {\r\n"]
[5603.86704, "o", "        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n        \"action\": \"LOCK\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n        \"reason\": reason,\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef append_unlock_event(env):\r\n    ensure_state()\r\n    event = {\r\n        \"timestamp\": int(time.time()),\r\n        \"iso_timestamp\": now_iso(),\r\n"]
[5603.867106, "o", "        \"action\": \"UNLOCK\",\r\n        \"service\": \"-\",\r\n        \"version\": \"-\",\r\n    }\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(json.dumps(event) + \"\\n\")\r\n\r\ndef find_rollback_target(env, service, current_version, to_version=None):\r\n    events = load_events(env)\r\n\r\n    if to_version is not None:\r\n        for ev in reversed(events):\r\n"]
[5603.867166, "o", "            if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] == to_version:\r\n                return to_version\r\n        fail(f\"version not found in history for {service}\")\r\n\r\n    current_idx = None\r\n    for idx, ev in enumerate(events):\r\n        if ev[\"service\"] != service:\r\n            continue\r\n        if ev[\"version\"] != current_version:\r\n            continue\r\n        if ev[\"action\"] == \"ROLLBACK\" and ev[\"version\"] == \"-\":\r\n            continue\r\n        current_idx = idx\r\n\r\n"]
[5603.867203, "o", "    if current_idx is None:\r\n        return None\r\n\r\n    for ev in reversed(events[:current_idx]):\r\n        if ev[\"service\"] == service and ev[\"action\"] != \"ROLLBACK\" and ev[\"version\"] != current_version:\r\n            return ev[\"version\"]\r\n    return None\r\n"]
[5603.867329, "o", "\r\ndef parse_opts(args, value_opts, flag_opts):\r\n    values = {}\r\n    flags = set()\r\n    positionals = []\r\n    i = 0\r\n    while i < len(args):\r\n        a = args[i]\r\n        if a in value_opts:\r\n            i += 1\r\n            if i >= len(args):\r\n                fail(f\"{a} requires a value\")\r\n            values[a] = args[i]\r\n        elif a in flag_opts:\r\n            flags.add(a)\r\n        elif a.startswith('--'):\r\n            fail(f\"unknown option: {a}\")\r\n        else:\r\n            positionals.append(a)\r\n        i += 1\r\n    return values, flags, positionals\r\n"]
[5603.867394, "o", "\r\ndef cmd_validate(args):\r\n    if args:\r\n        fail(\"validate takes no arguments\")\r\n    data = load_manifest()\r\n    try:\r\n        validate_manifest(data)\r\n    except ValueError as e:\r\n        print(f\"ERROR: {e}\")\r\n        sys.exit(1)\r\n    print(\"VALID\")\r\n\r\ndef cmd_order(args):\r\n    if args:\r\n"]
[5603.867464, "o", "        fail(\"order takes no arguments\")\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n    for s in topo_order(services):\r\n        print(s)\r\n\r\ndef cmd_build(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--parallel'})\r\n    if positionals:\r\n        fail(\"build does not accept positional arguments\")\r\n\r\n    service = values.get('--service')\r\n    parallel = '--parallel' in flags\r\n\r\n    data = load_manifest()\r\n"]
[5603.867528, "o", "    services, _ = get_services(data)\r\n\r\n    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n\r\n    if parallel:\r\n        for wave in build_waves(services, subset):\r\n            print(\",\".join(wave))\r\n        return\r\n\r\n    order = topo_order(services, subset)\r\n"]
[5603.867593, "o", "    any_fail = False\r\n    for s in order:\r\n        svc = services[s]\r\n        path = service_path(svc)\r\n        if not os.path.isdir(path):\r\n            print(f\"BUILD {s} FAIL: service path does not exist\")\r\n            any_fail = True\r\n            continue\r\n        version = svc.get('version')\r\n        if not valid_version(version):\r\n            print(f\"BUILD {s} FAIL: invalid version\")\r\n            any_fail = True\r\n            continue\r\n        try:\r\n            os.makedirs(os.path.join(path, 'build'), exist_ok=True)"]
[5603.867655, "o", "\r\n            with open(os.path.join(path, 'build', 'artifact.txt'), 'w') as f:\r\n                f.write(f\"{s}:{version}+build.{int(time.time())}\")\r\n            print(f\"BUILD {s} OK\")\r\n        except Exception as e:\r\n            print(f\"BUILD {s} FAIL: {e}\")\r\n            any_fail = True\r\n\r\n    if any_fail:\r\n        sys.exit(1)\r\n\r\n"]
[5603.867719, "o", "def cmd_test(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--fail-fast'})\r\n    if positionals:\r\n        fail(\"test does not accept positional arguments\")\r\n\r\n    service = values.get('--service')\r\n    fail_fast = '--fail-fast' in flags\r\n\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n\r\n    if service:\r\n        if service not in services:\r\n            fail(f\"service not found: {service}\")\r\n        order = [service]\r\n    else:\r\n"]
[5603.867777, "o", "        order = topo_order(services)\r\n\r\n    ensure_state()\r\n    results = load_json(TEST_RESULTS_PATH, {})\r\n    any_fail = False\r\n\r\n    for s in order:\r\n        if os.path.exists(artifact_path(services[s])):\r\n            results[s] = {\"pass\": True, \"timestamp\": now_iso()}\r\n            print(f\"TEST {s} PASS\")\r\n        else:\r\n"]
[5603.867849, "o", "            results[s] = {\"pass\": False, \"timestamp\": now_iso()}\r\n            print(f\"TEST {s} FAIL: not built\")\r\n            any_fail = True\r\n            if fail_fast:\r\n                break\r\n\r\n    save_json(TEST_RESULTS_PATH, results)\r\n    if any_fail:\r\n        sys.exit(1)\r\n\r\ndef cmd_deploy(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--dry-run'})\r\n    if len(positionals) != 1:\r\n        fail(\"deploy requires an environment\")\r\n\r\n    env = positionals[0]\r\n    service = values.get('--service')\r\n    dry_run = '--dry-run' in flags\r\n"]
[5603.867908, "o", "\r\n    data = load_manifest()\r\n    services, envs = get_services(data)\r\n\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n\r\n    assert_not_locked(env)\r\n\r\n    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n\r\n    order = topo_order(services, subset)\r\n    ensure_state()\r\n"]
[5603.867971, "o", "\r\n    if dry_run:\r\n        print(f\"DRY-RUN deploy to {env}:\")\r\n        for s in order:\r\n            print(f\"  Would deploy {s}\")\r\n        return\r\n\r\n    test_results = load_json(TEST_RESULTS_PATH, {})\r\n    state = load_deployment_state(env)\r\n    any_fail = False\r\n    deployed_events = []\r\n\r\n"]
