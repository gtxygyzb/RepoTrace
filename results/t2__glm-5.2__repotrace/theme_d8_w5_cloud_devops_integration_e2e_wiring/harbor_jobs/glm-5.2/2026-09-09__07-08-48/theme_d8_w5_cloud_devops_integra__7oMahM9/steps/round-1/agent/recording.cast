[9748.113936, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('pipeline.sh')\nlines = p.read_text().splitlines()\n\n# Patch single-service scale block\nfor i, line in enumerate(lines):\n    if line.strip() == \"if len(rest) == 2:\" and i > 1200:\n        # find assert_not_locked(env) inside this block\n        j = i\n        while j < len(lines):\n            if lines[j].strip() == \"assert_not_locked(env)\":\n                # It should be followed by replicas = load_replicas(env)\n                if lines[j+1].strip() == \"replicas = load_replicas(env)\":\n                    indent = lines[j][:len(lines[j])-len(lines[j].lstrip())]\n                    inner = indent + \"    \"\n                    lines[j] = indent + \"replicas = load_replicas(env)\"\n                    lines[j+1] = inner + \"if get_health_state(env, service) == \\\"unhealthy\\\" and count > replicas.get(service, 1):\"\n                    lines.insert(j+2, inner + \"    \" + \"fail(f\\\"cannot scale up unhealthy service '{service}' in {env}\\\")\")\n                    lines.insert(j+3, i"]
[9748.114231, "i", "ndent + \"assert_not_locked(env)\")\n                    break\n            j += 1\n        else:\n            raise SystemExit('scale assert_not_locked not found')\n        break\nelse:\n    raise SystemExit('scale len(rest)==2 not found')\n\n# Patch forced promote branch\nfor i, line in enumerate(lines):\n    if line.strip() == 'print(f\"PROMOTE {s} -> {target} OK (forced)\")':\n        if i > 0 and lines[i-1].strip() != 'promote_resets.append(s)':\n            indent = line[:len(line)-len(line.lstrip())]\n            lines.insert(i, indent + 'promote_resets.append(s)')\n        break\nelse:\n    raise SystemExit('forced promote print not found')\n\np.write_text('\\n'.join(lines) + '\\n')\nPY\npython3 - <<'PY'\nfrom pathlib import Path\ns = Path('pipeline.sh').read_text()\nstart = s.index(\"cat > \\\"$tmp_script\\\" <<'PY'\") + len(\"cat > \\\"$tmp_script\\\" <<'PY'\")\nend = s.rindex(\"\\nPY\\n\")\nPath('/tmp/pipeline_extracted.py').write_text(s[start:end])\nPY\npython3 -m py_compile /tmp/pipeline_extracted.py\n"]
