[7493.441819, "o", "def cmd_deploy(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--dry-run'})\r\n    if len(positionals) != 1:\r\n        fail(\"deploy requires an environment\")\r\n\r\n    env = positionals[0]\r\n"]
[7493.441912, "o", "    service = values.get('--service')\r\n    dry_run = '--dry-run' in flags\r\n\r\n    data = load_manifest()\r\n    services, envs = get_services(data)\r\n\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n\r\n    assert_not_locked(env)\r\n\r\n    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n\r\n    order = topo_order(services, subset)\r\n    ensure_state()\r\n\r\n    if dry_run:\r\n"]
[7493.442102, "o", "        print(f\"DRY-RUN deploy to {env}:\")\r\n        for s in order:\r\n            print(f\"  Would deploy {s}\")\r\n        return\r\n\r\n    test_results = load_json(TEST_RESULTS_PATH, {})\r\n    state = load_deployment_state(env)\r\n    any_fail = False\r\n    deployed_events = []\r\n\r\n    for s in order:\r\n        rec = test_results.get(s)\r\n        if not rec or not rec.get(\"pass\"):\r\n            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n            any_fail = True\r\n            break\r\n\r\n        version = read_artifact(services[s])\r\n        if version is None:\r\n            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n            any_fail = True\r\n            break\r\n\r\n        state[s] = {\"version\": version, \"deployed_at\": now_iso()}\r\n        deployed_events.append((s, version))\r\n        print(f\"DEPLOY {s} -> {env} OK\")\r\n\r\n    save_deployment_state(env, state)\r\n    for s, version in deployed_events:\r\n        append_event(env, \"DEPLOY\", s, version)\r\n    if any_fail:\r\n        sys.exit(1)\r\n\r\ndef cmd_status(ar"]
[7493.442224, "o", "gs):\r\n    if len(args) > 1:\r\n        fail(\"status takes at most one environment argument\")\r\n\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n\r\n    if args:\r\n        env = args[0]\r\n        if env not in envs:\r\n            fail(f\"environment not found: {env}\")\r\n        lock = load_lock(env)\r\n        if lock is not None:\r\n            print(f\"[LOCKED: {lock.get('reason', 'manual lock')}]\")\r\n        cfg = load_config(env)\r\n        if cfg:\r\n            print(f\"Config: {len(cfg)} variables\")\r\n        state = load_deployment_state(env)\r\n        for s in sorted(state):\r\n            rec = state[s]\r\n            print(f\"{s}: {rec.get('version', '')} (deployed at {rec.get('deployed_at', '')})\")\r\n    else:\r\n        for env in sorted(envs):\r\n            state = load_deployment_state(env)\r\n            print(f\"{env}: {len(state)} services deployed\")\r\n\r\ndef cmd_rollback(args):\r\n    values, flags, positionals = parse_opts(args, {\"--to-version\"}, set())\r\n    if len(positionals) != 2:\r\n        fail(\"rollback requir"]
[7493.442306, "o", "es <environment> <service_name>\")\r\n\r\n    env, service = positionals\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n    assert_not_locked(env)\r\n    ensure_state()\r\n    state = load_deployment_state(env)\r\n\r\n    if service not in state:\r\n        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n        sys.exit(1)\r\n\r\n    current_version = state[service].get(\"version\")\r\n    if not current_version:\r\n        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")\r\n        sys.exit(1)\r\n\r\n"]
[7493.442389, "o", "    to_version = values.get(\"--to-version\")\r\n    target_version = find_rollback_target(env, service, current_version, to_version)\r\n\r\n    if target_version is None:\r\n        del state[service]\r\n        save_deployment_state(env, state)\r\n        append_event(env, \"ROLLBACK\", service, \"-\")\r\n        print(f\"ROLLBACK {service} from {env}: {current_version} -> (removed)\")\r\n    else:\r\n        state[service] = {\"version\": target_version, \"deployed_at\": now_iso()}\r\n        save_deployment_state(env, state)\r\n        append_event(env, \"ROLLBACK\", service, target_version)\r\n        print(f\"ROLLBACK {service} from {env}: {current_version} -> {target_version}\")\r\n\r\ndef valid_version(v):\r\n    if not isinstance(v, str):\r\n        return False\r\n"]
