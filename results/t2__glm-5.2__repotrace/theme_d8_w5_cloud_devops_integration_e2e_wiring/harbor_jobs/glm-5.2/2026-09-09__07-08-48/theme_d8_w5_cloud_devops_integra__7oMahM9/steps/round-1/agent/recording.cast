[13290.021644, "o", "        save_replicas(env, replicas)\r\n        append_scale_event(env, service, count, previous)\r\n        print(f\"SCALED {env}/{service} to {count} replicas (was {previous})\")\r\n        return\r\n\r\n    if len(rest) == 1:\r\n        ensure_state()\r\n        state = load_deployment_state(env)\r\n        if service not in state:\r\n            fail(f\"{service} is not deployed to {env}\")\r\n        replicas = load_replicas(env)\r\n        count = replicas.get(service, 1)\r\n        print(f\"{service}: {count} replicas\")\r\n        return\r\n\r\n    fail(\"scale: invalid arguments\")\r\n\r\n"]
[13290.021708, "o", "def main():\r\n    if len(sys.argv) < 2:\r\n        fail(\"no command given\")\r\n\r\n    cmd = sys.argv[1]\r\n    args = sys.argv[2:]\r\n\r\n    if cmd == 'validate':\r\n        cmd_validate(args)\r\n    elif cmd == 'order':\r\n        cmd_order(args)\r\n    elif cmd == 'build':\r\n"]
[13290.021768, "o", "        cmd_build(args)\r\n    elif cmd == 'test':\r\n        cmd_test(args)\r\n    elif cmd == 'deploy':\r\n        cmd_deploy(args)\r\n    elif cmd == 'status':\r\n        cmd_status(args)\r\n    elif cmd == 'rollback':\r\n        cmd_rollback(args)\r\n    elif cmd == 'promote':\r\n        cmd_promote(args)\r\n    elif cmd == 'diff':\r\n"]
[13290.021836, "o", "        cmd_diff(args)\r\n    elif cmd == 'history':\r\n        cmd_history(args)\r\n    elif cmd == 'graph':\r\n        cmd_graph(args)\r\n    elif cmd == 'bump':\r\n"]
[13290.021903, "o", "        cmd_bump(args)\r\n    elif cmd == 'snapshot':\r\n        cmd_snapshot(args)\r\n    elif cmd == 'restore':\r\n        cmd_restore(args)\r\n    elif cmd == 'lock':\r\n        cmd_lock(args)\r\n    elif cmd == 'unlock':\r\n        cmd_unlock(args)\r\n    elif cmd == 'health':\r\n        cmd_health(args)\r\n    elif cmd == 'config':\r\n        cmd_config(args)\r\n    elif cmd == 'quota':\r\n        cmd_quota(args)\r\n    elif cmd == 'scale':\r\n        cmd_scale(args)\r\n    else:\r\n        fail(f\"unknown command: {cmd}\")\r\n\r\n"]
[13290.021963, "o", "if __name__ == '__main__':\r\n    main()\r\nPY\r\npython3 \"$tmp_script\" \"$@\"\r\n"]
