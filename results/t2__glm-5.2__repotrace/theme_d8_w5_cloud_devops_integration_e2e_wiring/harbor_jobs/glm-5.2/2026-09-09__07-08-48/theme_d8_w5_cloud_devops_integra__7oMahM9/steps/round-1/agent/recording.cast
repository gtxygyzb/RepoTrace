[4907.339442, "o", "    28\tdef fail(msg, code=1):\r\n    29\t    print(f\"ERROR: {msg}\")\r\n    30\t    sys.exit(code)\r\n    31\t\r\n    32\tdef now_iso():\r\n    33\t    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n    34\t\r\n    35\tdef load_json(path, default):\r\n    36\t    try:\r\n    37\t        with open(path) as f:\r\n    38\t            return json.load(f)\r\n    39\t    except FileNotFoundError:\r\n    40\t        return default\r\n"]
