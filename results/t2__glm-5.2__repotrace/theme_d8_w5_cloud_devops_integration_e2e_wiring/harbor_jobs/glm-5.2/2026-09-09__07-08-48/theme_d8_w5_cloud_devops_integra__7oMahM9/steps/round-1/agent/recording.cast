[9821.608762, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('pipeline.sh')\nlines = p.read_text().splitlines()\n\nstart = None\nfor i, line in enumerate(lines):\n    if i > 1470 and line.strip() == \"if count < bmin or count > bmax:\":\n        start = i\n        break\nif start is None:\n    raise SystemExit('bounds if not found')\n\n# Find the fail line inside bounds if\nfail_idx = None\nfor j in range(start, min(start + 5, len(lines))):\n    if lines[j].strip().startswith('fail(f\"{count} violates bounds'):\n        fail_idx = j\n        break\nif fail_idx is None:\n    raise SystemExit('bounds fail not found')\n\n# Find the following previous = replicas.get(service, 1) line\nprev_idx = None\nfor j in range(fail_idx + 1, min(fail_idx + 10, len(lines))):\n    if lines[j].strip() == \"previous = replicas.get(service, 1)\":\n        prev_idx = j\n        break\nif prev_idx is None:\n    raise SystemExit('previous replicas line not found')\n\nindent = lines[fail_idx][:len(lines[fail_idx])-len(lines[fail_idx].lstrip())]\nnew_lines = [\n    indent + \"repli"]
