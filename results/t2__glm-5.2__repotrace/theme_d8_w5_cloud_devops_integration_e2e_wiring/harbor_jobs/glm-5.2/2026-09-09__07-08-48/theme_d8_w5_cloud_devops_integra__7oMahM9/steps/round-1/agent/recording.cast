[14202.426747, "o", "   345\tdef event_file(env):\r\n   346\t    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n   347\t\r\n   348\tdef append_event(env, action, service, version, source_env=None, forced=False, snapshot_id=None):\r\n   349\t    ensure_state()\r\n   350\t    ts = now_iso()\r\n"]
[14202.426875, "o", "   351\t    line = f\"{ts} {action} {service} {version}\"\r\n   352\t    if action == \"PROMOTE\" and source_env is not None:\r\n   353\t        line += f\" from {source_env}\"\r\n   354\t        if forced:\r\n   355\t            line += \" (forced)\"\r\n   356\t    if action == \"RESTORE\" and snapshot_id is not None:\r\n   357\t        line += f\" from snapshot #{snapshot_id}\"\r\n   358\t    line += \"\\n\"\r\n   359\t    with open(event_file(env), \"a\") as f:\r\n   360\t        f.write(line)\r\n   361\t\r\n   362\tdef append_scale_event(env, service, count, previous):\r\n   363\t    ensure_state()\r\n   364\t    event = {\r\n   365\t        \"timestamp\": int(time.time()),\r\n   366\t        \"iso_timestamp\": now_iso(),\r\n   367\t        \"action\": \"SCALE\",\r\n"]
[14202.426968, "o", "   368\t        \"service\": service,\r\n   369\t        \"version\": \"-\",\r\n   370\t        \"replicas\": count,\r\n   371\t        \"previous\": previous,\r\n   372\t    }\r\n   373\t    with open(event_file(env), \"a\") as f:\r\n   374\t        f.write(json.dumps(event) + chr(10))\r\n   375\t\r\n"]
[14202.427041, "o", "   376\tdef load_events(env):\r\n   377\t    ensure_state()\r\n   378\t    try:\r\n   379\t        with open(event_file(env)) as f:\r\n   380\t            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n   381\t    except FileNotFoundError:\r\n   382\t        return []\r\n   383\t    events = []\r\n   384\t    for line in lines:\r\n   385\t        if line.startswith('{'):\r\n   386\t            continue\r\n   387\t        parts = line.split()\r\n   388\t        if len(parts) < 4:\r\n   389\t            continue\r\n   390\t        events.append({\r\n   391\t            \"timestamp\": parts[0],\r\n   392\t            \"action\": parts[1],\r\n   393\t            \"service\": parts[2],\r\n   394\t            \"version\": parts[3],\r\n   395\t            \"line\": line,\r\n"]
[14202.427105, "o", "   396\t        })\r\n   397\t    return events\r\n   398\t\r\n"]
