[3484.510509, "o", "\u001b[?2004h"]
[3484.510609, "o", "> "]
[3484.510711, "o", "            if t1 is not None and t2 is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3484.510834, "o", "                if t1 >= t2:\r\n\u001b[?2004l\r"]
[3484.510927, "o", "\u001b[?2004h> "]
