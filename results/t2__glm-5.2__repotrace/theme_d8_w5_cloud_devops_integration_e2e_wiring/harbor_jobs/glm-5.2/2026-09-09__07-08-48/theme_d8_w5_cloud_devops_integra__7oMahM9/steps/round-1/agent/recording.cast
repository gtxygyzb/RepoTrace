[12880.641347, "o", "  1560\t    for key in sorted(data):\r\n  1561\t        cfg[key] = data[key]\r\n  1562\t    save_config(env, cfg)\r\n  1563\t    for key in sorted(data):\r\n  1564\t        append_config_set_event(env, key, data[key])\r\n  1565\t        print(f\"CONFIG {env}: {key}={data[key]}\")\r\n  1566\t\r\n  1567\tdef cmd_scale(args):\r\n  1568\t    if not args:\r\n  1569\t        fail(\"scale requires <environment>\")\r\n  1570\t\r\n  1571\t    env = args[0]\r\n"]
[12880.641492, "o", "  1572\t    data = load_manifest()\r\n  1573\t    services, envs = get_services(data)\r\n  1574\t    if env not in envs:\r\n  1575\t        fail(f\"unknown environment '{env}'\")\r\n  1576\t\r\n  1577\t    rest = args[1:]\r\n  1578\t\r\n  1579\t    if rest and rest[0] == '--all':\r\n  1580\t        if len(rest) != 2:\r\n  1581\t            fail(\"scale <environment> --all <count>\")\r\n  1582\t        count_str = rest[1]\r\n  1583\t        count = parse_positive_int(count_str)\r\n  1584\t        if count is None:\r\n  1585\t            fail(f\"invalid replica count '{count_str}'\")\r\n  1586\t        ensure_state()\r\n  1587\t        state = load_deployment_state(env)\r\n  1588\t        if not state:\r\n  1589\t            fail(f\"no services deployed in {env}\")\r\n  1590\t        env_max = get_env_max(envs, env)\r\n  1591\t        if env_max is not None and count > env_max:\r\n  1592\t            fail(f\"{count} exceeds max_replicas ({env_max}) for {env}\")\r\n  1593\t        bounds = load_bounds(env)\r\n"]
[12880.641604, "o", "  1594\t        replicas = load_replicas(env)\r\n  1595\t        for s in sorted(state):\r\n  1596\t            svc_bounds = bounds.get(s)\r\n  1597\t            if svc_bounds:\r\n  1598\t                bmin, bmax = svc_bounds\r\n  1599\t                if count < bmin or count > bmax:\r\n  1600\t                    fail(f\"{count} violates bounds [{bmin}..{bmax}] for {s} in {env}\")\r\n  1601\t        for s in sorted(state):\r\n  1602\t            if get_health_state(env, s) == \"unhealthy\" and count > replicas.get(s, 1):\r\n  1603\t                fail(f\"cannot scale up unhealthy service '{s}' in {env}\")\r\n  1604\t        assert_not_locked(env)\r\n  1605\t        quotas = load_quotas(env)\r\n  1606\t        max_total_limit = quotas.get('max_total_replicas')\r\n  1607\t        if max_total_limit is not None:\r\n  1608\t            projected = count * len(state)\r\n"]
[12880.641703, "o", "  1609\t            if projected > max_total_limit:\r\n  1610\t                fail(f\"scaling all to {count} would exceed max_total_replicas quota ({projected}/{max_total_limit}) in {env}\")\r\n  1611\t        for s in sorted(state):\r\n  1612\t            previous = replicas.get(s, 1)\r\n  1613\t            replicas[s] = count\r\n  1614\t            append_scale_event(env, s, count, previous)\r\n  1615\t            print(f\"SCALED {env}/{s} to {count} replicas (was {previous})\")\r\n  1616\t        save_replicas(env, replicas)\r\n  1617\t        print(f\"Scaled {len(state)} services to {count} replicas\")\r\n  1618\t        return\r\n"]
