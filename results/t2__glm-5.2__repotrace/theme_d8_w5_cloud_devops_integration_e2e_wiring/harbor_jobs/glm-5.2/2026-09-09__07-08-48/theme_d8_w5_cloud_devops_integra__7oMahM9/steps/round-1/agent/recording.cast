[8521.319553, "o", "        ensure_state()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.319656, "o", "        state = load_deployment_state(env)\r\n\u001b[?2004l\r\u001b[?2004h"]
[8521.319712, "o", "> "]
[8521.319768, "o", "        if service not in state:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.319879, "o", "            fail(f\"{service} is not deployed to {env}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8521.319981, "o", "        env_max = get_env_max(envs, env)\r\n\u001b[?2004l\r\u001b[?2004h"]
[8521.320037, "o", "> "]
