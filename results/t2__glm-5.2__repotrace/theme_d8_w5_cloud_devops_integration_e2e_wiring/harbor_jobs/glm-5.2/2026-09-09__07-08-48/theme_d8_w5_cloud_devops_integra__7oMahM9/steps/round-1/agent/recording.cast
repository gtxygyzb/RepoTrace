[7531.000714, "o", "   835\t    env = positionals[0]\r\n   836\t    service = values.get(\"--service\")\r\n   837\t    limit = 10\r\n   838\t    if \"--limit\" in values:\r\n   839\t        try:\r\n   840\t            limit = int(values[\"--limit\"])\r\n   841\t        except ValueError:\r\n   842\t            fail(\"--limit requires an integer\")\r\n   843\t        if limit < 0:\r\n   844\t            fail(\"--limit must be non-negative\")\r\n   845\t\r\n   846\t    data = load_manifest()\r\n   847\t    _, envs = get_services(data)\r\n   848\t    if env not in envs:\r\n   849\t        fail(f\"environment not found: {env}\")\r\n   850\t\r\n   851\t    ensure_state()\r\n   852\t    try:\r\n   853\t        with open(event_file(env)) as f:\r\n   854\t            raw_lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n   855\t    except FileNotFoundError:\r\n   856\t        raw_lines = []"]
[7531.000799, "o", "\r\n   857\t\r\n   858\t    entries = []\r\n   859\t    for line in raw_lines:\r\n   860\t        if line.startswith('{'):\r\n   861\t            try:\r\n   862\t                ev = json.loads(line)\r\n   863\t            except json.JSONDecodeError:\r\n   864\t                continue\r\n   865\t            action = ev.get(\"action\")\r\n   866\t            iso = ev.get(\"iso_timestamp\", \"\")\r\n   867\t            svc = ev.get(\"service\", \"-\")\r\n   868\t"]
[7531.000873, "o", "            if action == \"LOCK\":\r\n   869\t                entries.append((iso, svc, f\"{iso} LOCK {ev.get('reason', '')}\"))\r\n   870\t            elif action == \"UNLOCK\":\r\n   871\t                entries.append((iso, svc, f\"{iso} UNLOCK\"))\r\n   872\t            elif action == \"CONFIG_SET\":\r\n   873\t                entries.append((iso, svc, f\"{iso} CONFIG_SET {ev.get('key', '')}={ev.get('value', '')}\"))\r\n   874\t            elif action == \"CONFIG_DELETE\":\r\n   875\t                entries.append((iso, svc, f\"{iso} CONFIG_DELETE {ev.get('key', '')}\"))\r\n   876\t            else:\r\n   877\t                entries.append((iso, svc, line))\r\n   878\t        else:\r\n   879\t"]
[7531.000941, "o", "            parts = line.split()\r\n   880\t            svc = parts[2] if len(parts) >= 3 else \"\"\r\n   881\t            iso = parts[0] if parts else \"\"\r\n   882\t            entries.append((iso, svc, line))\r\n   883\t\r\n   884\t    if service:\r\n   885\t        entries = [e for e in entries if e[1] == service]\r\n   886\t\r\n   887\t    entries.reverse()\r\n"]
