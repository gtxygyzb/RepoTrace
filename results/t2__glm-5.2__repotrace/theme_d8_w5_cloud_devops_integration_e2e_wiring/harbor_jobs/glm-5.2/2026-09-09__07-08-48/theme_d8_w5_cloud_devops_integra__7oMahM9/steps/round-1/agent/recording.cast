[11788.78863, "o", "> "]
[11788.78875, "o", "def quota_status_line(env):\r\n\u001b[?2004l\r"]
[11788.788836, "o", "\u001b[?2004h> "]
[11788.789023, "o", "    quotas = load_quotas(env)\r\n\u001b[?2004l\r"]
[11788.789111, "o", "\u001b[?2004h> "]
[11788.789214, "o", "    if not quotas:\r\n\u001b[?2004l\r"]
[11788.78931, "o", "\u001b[?2004h> "]
[11788.789438, "o", "        return None\r\n\u001b[?2004l\r"]
[11788.789524, "o", "\u001b[?2004h> "]
[11788.789608, "o", "    parts = []\r\n\u001b[?2004l\r"]
[11788.789693, "o", "\u001b[?2004h> "]
[11788.789999, "o", "    for resource in quota_supported_resources():\r\n\u001b[?2004l\r"]
[11788.790089, "o", "\u001b[?2004h> "]
[11788.790277, "o", "        if resource in quotas:\r\n\u001b[?2004l\r"]
[11788.790371, "o", "\u001b[?2004h> "]
[11788.790594, "o", "            limit = quotas[resource]\r\n\u001b[?2004l\r"]
[11788.790682, "o", "\u001b[?2004h> "]
[11788.79102, "o", "            usage = quota_current_usage(env, resource)\r\n\u001b[?2004l\r"]
[11788.79111, "o", "\u001b[?2004h> "]
[11788.791532, "o", "            parts.append(f\"{resource}={limit} ({usage}/{limit})\")\r\n\u001b[?2004l\r"]
[11788.791624, "o", "\u001b[?2004h> "]
[11788.791726, "o", "    if not parts:\r\n\u001b[?2004l\r"]
[11788.791812, "o", "\u001b[?2004h> "]
[11788.791934, "o", "        return None\r\n\u001b[?2004l\r"]
[11788.792021, "o", "\u001b[?2004h> "]
[11788.792284, "o", "    return \"Quotas: \" + \", \".join(parts)\r\n\u001b[?2004l\r"]
[11788.792375, "o", "\u001b[?2004h"]
[11788.792465, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[11788.792552, "o", "> "]
[11788.792642, "o", "def cmd_quota(args):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.792777, "o", "    if not args:\r\n"]
[11788.792864, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[11788.793401, "o", "        fail(\"quota requires <environment> <set|get|list|remove|--check> [args]\")\r\n\u001b[?2004l\r"]
[11788.793491, "o", "\u001b[?2004h> "]
[11788.793588, "o", "    env = args[0]\r\n\u001b[?2004l\r"]
[11788.793673, "o", "\u001b[?2004h> "]
[11788.793809, "o", "    if len(args) < 2:\r\n\u001b[?2004l\r"]
[11788.793895, "o", "\u001b[?2004h> "]
[11788.794426, "o", "        fail(\"quota requires <environment> <set|get|list|remove|--check> [args]\")\r\n\u001b[?2004l\r"]
[11788.794519, "o", "\u001b[?2004h> "]
[11788.794624, "o", "    sub = args[1]\r\n\u001b[?2004l\r"]
[11788.794708, "o", "\u001b[?2004h> "]
[11788.794828, "o", "    rest = args[2:]\r\n"]
[11788.794917, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11788.795013, "o", "\u001b[?2004h> "]
[11788.795182, "o", "    assert_env_exists(env)\r\n\u001b[?2004l\r"]
[11788.795277, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[11788.795367, "o", "> "]
[11788.795461, "o", "    if sub == 'set':\r\n\u001b[?2004l\r"]
[11788.795517, "o", "\u001b[?2004h> "]
[11788.795706, "o", "        if len(rest) != 2:\r\n\u001b[?2004l\r"]
[11788.79577, "o", "\u001b[?2004h> "]
[11788.796188, "o", "            fail(\"quota <environment> set <resource> <limit>\")\r\n\u001b[?2004l\r"]
[11788.796257, "o", "\u001b[?2004h> "]
[11788.796506, "o", "        resource, limit_str = rest\r\n\u001b[?2004l\r"]
[11788.796572, "o", "\u001b[?2004h> "]
[11788.796852, "o", "        validate_quota_resource(resource)\r\n\u001b[?2004l\r"]
[11788.796916, "o", "\u001b[?2004h> "]
[11788.797222, "o", "        limit = parse_positive_int(limit_str)\r\n\u001b[?2004l\r"]
[11788.797269, "o", "\u001b[?2004h> "]
[11788.797471, "o", "        if limit is None:\r\n\u001b[?2004l\r"]
[11788.797537, "o", "\u001b[?2004h> "]
[11788.79791, "o", "            fail(f\"invalid quota limit '{limit_str}'\")\r\n\u001b[?2004l\r"]
[11788.797974, "o", "\u001b[?2004h> "]
[11788.798189, "o", "        assert_not_locked(env)\r\n\u001b[?2004l\r"]
[11788.798253, "o", "\u001b[?2004h> "]
[11788.798487, "o", "        quotas = load_quotas(env)\r\n\u001b[?2004l\r"]
[11788.798548, "o", "\u001b[?2004h> "]
[11788.798783, "o", "        quotas[resource] = limit\r\n\u001b[?2004l\r"]
[11788.798831, "o", "\u001b[?2004h> "]
[11788.799073, "o", "        save_quotas(env, quotas)\r\n\u001b[?2004l\r"]
[11788.799138, "o", "\u001b[?2004h> "]
[11788.799506, "o", "        append_quota_set_event(env, resource, limit)\r\n\u001b[?2004l\r"]
[11788.799582, "o", "\u001b[?2004h> "]
[11788.799901, "o", "        print(f\"QUOTA {env}: {resource}={limit}\")\r\n\u001b[?2004l\r"]
[11788.79998, "o", "\u001b[?2004h> "]
[11788.800123, "o", "    elif sub == 'get':\r\n\u001b[?2004l\r"]
[11788.800209, "o", "\u001b[?2004h> "]
[11788.800386, "o", "        if len(rest) != 1:\r\n\u001b[?2004l\r"]
[11788.800477, "o", "\u001b[?2004h> "]
[11788.800828, "o", "            fail(\"quota <environment> get <resource>\")\r\n\u001b[?2004l\r"]
[11788.800915, "o", "\u001b[?2004h> "]
[11788.80108, "o", "        resource = rest[0]\r\n\u001b[?2004l\r"]
[11788.801166, "o", "\u001b[?2004h> "]
[11788.801442, "o", "        validate_quota_resource(resource)\r\n\u001b[?2004l\r"]
[11788.801531, "o", "\u001b[?2004h> "]
[11788.801735, "o", "        quotas = load_quotas(env)\r\n\u001b[?2004l\r"]
[11788.801824, "o", "\u001b[?2004h> "]
[11788.802149, "o", "        usage = quota_current_usage(env, resource)\r\n\u001b[?2004l\r"]
[11788.802237, "o", "\u001b[?2004h> "]
[11788.802467, "o", "        if resource in quotas:\r\n\u001b[?2004l\r"]
[11788.802595, "o", "\u001b[?2004h> "]
[11788.803021, "o", "            print(f\"{resource}: {quotas[resource]} (current: {usage})\")\r\n\u001b[?2004l\r"]
[11788.803119, "o", "\u001b[?2004h> "]
[11788.803201, "o", "        else:\r\n\u001b[?2004l\r"]
[11788.803302, "o", "\u001b[?2004h> "]
[11788.803733, "o", "            print(f\"{resource}: not set (current: {usage})\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[11788.803899, "o", "> "]
[11788.803992, "o", "    elif sub == 'list':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.8042, "o", "        quotas = load_quotas(env)\r\n\u001b[?2004l\r"]
[11788.804289, "o", "\u001b[?2004h> "]
[11788.804636, "o", "        for resource in quota_supported_resources():\r\n\u001b[?2004l\r"]
[11788.804722, "o", "\u001b[?2004h> "]
[11788.804869, "o", "            if resource in quotas:\r\n\u001b[?2004l\r"]
[11788.804957, "o", "\u001b[?2004h> "]
[11788.805208, "o", "                usage = quota_current_usage(env, resource)\r\n\u001b[?2004l\r"]
[11788.805243, "o", "\u001b[?2004h> "]
[11788.805641, "o", "                print(f\"{resource}: {quotas[resource]} (current: {usage})\")\r\n\u001b[?2004l\r"]
[11788.80573, "o", "\u001b[?2004h> "]
[11788.805807, "o", "    elif sub == 'remove':\r\n\u001b[?2004l\r"]
[11788.805892, "o", "\u001b[?2004h"]
[11788.805979, "o", ">         if len(rest) != 1:\r\n"]
[11788.806064, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[11788.80635, "o", "            fail(\"quota <environment> remove <resource>\")\r\n\u001b[?2004l\r"]
[11788.806436, "o", "\u001b[?2004h> "]
[11788.806531, "o", "        resource = rest[0]\r\n\u001b[?2004l\r"]
[11788.806627, "o", "\u001b[?2004h> "]
[11788.806805, "o", "        validate_quota_resource(resource)\r\n\u001b[?2004l\r"]
[11788.806892, "o", "\u001b[?2004h> "]
[11788.807014, "o", "        assert_not_locked(env)\r\n\u001b[?2004l\r"]
[11788.807101, "o", "\u001b[?2004h> "]
[11788.807228, "o", "        quotas = load_quotas(env)\r\n\u001b[?2004l\r"]
[11788.807328, "o", "\u001b[?2004h> "]
[11788.80745, "o", "        if resource not in quotas:\r\n\u001b[?2004l\r"]
[11788.807537, "o", "\u001b[?2004h> "]
[11788.807803, "o", "            fail(f\"quota '{resource}' not set in {env}\")\r\n\u001b[?2004l\r"]
[11788.80789, "o", "\u001b[?2004h> "]
[11788.807985, "o", "        del quotas[resource]\r\n\u001b[?2004l\r"]
[11788.808072, "o", "\u001b[?2004h> "]
[11788.808207, "o", "        save_quotas(env, quotas)\r\n\u001b[?2004l\r"]
[11788.808302, "o", "\u001b[?2004h> "]
[11788.808518, "o", "        append_quota_remove_event(env, resource)\r\n\u001b[?2004l\r"]
[11788.808604, "o", "\u001b[?2004h> "]
[11788.808809, "o", "        print(f\"QUOTA {env}: removed {resource}\")\r\n\u001b[?2004l\r"]
[11788.808897, "o", "\u001b[?2004h> "]
[11788.808987, "o", "    elif sub == '--check':\r\n\u001b[?2004l\r"]
[11788.809083, "o", "\u001b[?2004h> "]
[11788.809218, "o", "        quotas = load_quotas(env)\r\n\u001b[?2004l\r"]
[11788.809323, "o", "\u001b[?2004h> "]
[11788.809416, "o", "        exceeded = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.809693, "o", "        for resource in quota_supported_resources():\r\n\u001b[?2004l\r"]
[11788.809785, "o", "\u001b[?2004h> "]
[11788.809902, "o", "            if resource in quotas:\r\n\u001b[?2004l\r"]
[11788.809987, "o", "\u001b[?2004h> "]
[11788.810141, "o", "                limit = quotas[resource]\r\n\u001b[?2004l\r"]
[11788.810228, "o", "\u001b[?2004h> "]
[11788.810501, "o", "                usage = quota_current_usage(env, resource)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11788.810601, "o", "> "]
[11788.810709, "o", "                if usage > limit:\r\n\u001b[?2004l\r"]
[11788.810797, "o", "\u001b[?2004h> "]
[11788.811094, "o", "                    print(f\"{resource}: EXCEEDED ({usage}/{limit})\")\r\n\u001b[?2004l\r"]
[11788.811181, "o", "\u001b[?2004h> "]
[11788.811321, "o", "                    exceeded += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[11788.811413, "o", "> "]
[11788.811502, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.811835, "o", "                    print(f\"{resource}: OK ({usage}/{limit})\")\r\n\u001b[?2004l\r"]
[11788.811921, "o", "\u001b[?2004h> "]
[11788.811993, "o", "        if exceeded:\r\n\u001b[?2004l\r"]
[11788.812082, "o", "\u001b[?2004h> "]
[11788.812288, "o", "            print(f\"{exceeded} quota(s) exceeded\")\r\n\u001b[?2004l\r"]
[11788.812336, "o", "\u001b[?2004h> "]
[11788.812454, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.812637, "o", "            print(\"All quotas OK\")\r\n\u001b[?2004l\r"]
[11788.812725, "o", "\u001b[?2004h>     else:\r\n"]
[11788.812811, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[11788.813213, "o", "        fail(\"quota requires <environment> <set|get|list|remove|--check> [args]\")\r\n\u001b[?2004l\r"]
[11788.813306, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[11788.813332, "o", "'''\r\n\u001b[?2004l\r"]
[11788.813453, "o", "\u001b[?2004h> "]
[11788.813541, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.813625, "o", "old_config = \"\"\"def config_file(env):\r\n\u001b[?2004l\r\u001b[?2004h"]
[11788.81372, "o", "> "]
[11788.813917, "o", "    return os.path.join(CONFIG_DIR, f\"{env}.json\")\r\n\u001b[?2004l\r"]
[11788.81401, "o", "\u001b[?2004h> "]
[11788.8141, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.814187, "o", "assert old_config in s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.814439, "o", "s = s.replace(old_config, helpers + old_config)\r\n\u001b[?2004l\r"]
[11788.814534, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.814649, "o", "# 3. Deploy enforcement\r\n\u001b[?2004l\r"]
[11788.814744, "o", "\u001b[?2004h> "]
[11788.814916, "o", "old_deploy = \"\"\"    assert_not_locked(env)\r\n\u001b[?2004l\r"]
[11788.815012, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[11788.815102, "o", "    if service:\r\n\u001b[?2004l\r"]
[11788.815126, "o", "\u001b[?2004h"]
[11788.815253, "o", "> "]
[11788.815366, "o", "        subset = transitive_deps(services, service)\r\n\u001b[?2004l\r"]
[11788.815393, "o", "\u001b[?2004h> "]
[11788.815559, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.815655, "o", "        subset = set(services.keys())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[11788.815762, "o", "\u001b[?2004h> "]
[11788.815876, "o", "    order = topo_order(services, subset)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11788.81597, "o", ">     ensure_state()\r\n\u001b[?2004l\r"]
[11788.815996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r)"]
[11788.816134, "o", "\u001b[?2004h>     if dry_run:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.816227, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.816374, "o", "new_deploy = \"\"\"    assert_not_locked(env)\r\n\u001b[?2004l\r"]
[11788.816467, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[11788.816555, "o", "    if service:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.816689, "o", "        subset = transitive_deps(services, service)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11788.816779, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.816916, "o", "        subset = set(services.keys())\r\n\u001b[?2004l\r\u001b[?2004h"]
[11788.817004, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11788.81711, "o", "    order = topo_order(services, subset)\r\n\u001b[?2004l\r"]
