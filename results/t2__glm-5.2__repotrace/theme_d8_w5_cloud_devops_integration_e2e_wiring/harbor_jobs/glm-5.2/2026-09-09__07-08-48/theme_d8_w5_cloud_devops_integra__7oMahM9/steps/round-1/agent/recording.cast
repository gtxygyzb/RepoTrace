[5616.928234, "o", "def topo_order(services, subset=None):\r\n    if subset is None:\r\n        subset = set(services.keys())\r\n    subset = set(subset)\r\n\r\n    in_degree = {s: 0 for s in subset}\r\n    adj = {s: [] for s in subset}\r\n\r\n    for s in subset:\r\n        for dep in services[s].get('depends_on', []):\r\n            if dep in subset:\r\n                adj[dep].append(s)\r\n                in_degree[s] += 1\r\n\r\n"]
