[1773.609567, "o", "\u001b[?2004h> "]
[1773.609691, "o", "'''    test_results = load_json(TEST_RESULTS_PATH, {})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.609821, "o", "    state = load_deployment_state(env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.609918, "o", "    any_fail = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.609992, "o", "> "]
[1773.610065, "o", "    deployed_events = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rm\u001b[?2004h> "]
[1773.61014, "o", "    for s in order:\r\n\u001b[?2004l\r"]
[1773.610187, "o", "\u001b[?2004h> "]
[1773.610307, "o", "        rec = test_results.get(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.610448, "o", "        if not rec or not rec.get(\"pass\"):\r\n\u001b[?2004l\r"]
[1773.610481, "o", "\u001b[?2004h> "]
[1773.610721, "o", "            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.610805, "o", "            any_fail = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.610898, "o", "> "]
[1773.610989, "o", "            break\r\n\u001b[?2004l\r \u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[1773.611081, "o", "        version = read_artifact(services[s])\r\n\u001b[?2004l\r"]
[1773.61116, "o", "\u001b[?2004h> "]
[1773.611234, "o", "        if version is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.611456, "o", "            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.611585, "o", "            any_fail = True\r\n\u001b[?2004l\r"]
[1773.611647, "o", "\u001b[?2004h> "]
[1773.611723, "o", "            break\r\n\u001b[?2004l\r, \u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.611797, "o", "> "]
[1773.611957, "o", "        state[s] = {\"version\": version, \"deployed_at\": now_iso()}\r\n\u001b[?2004l\r"]
[1773.612019, "o", "\u001b[?2004h> "]
[1773.612153, "o", "        deployed_events.append((s, version))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.612319, "o", "        print(f\"DEPLOY {s} -> {env} OK\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.61239, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.612507, "o", "    save_deployment_state(env, state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.612571, "o", "> "]
[1773.612669, "o", "    for s, version in deployed_events:\r\n\u001b[?2004l\r"]
[1773.612731, "o", "\u001b[?2004h> "]
[1773.61284, "o", "        append_event(env, \"DEPLOY\", s, version)\r\n\u001b[?2004l\r"]
[1773.612884, "o", "\u001b[?2004h> "]
[1773.612967, "o", "    if any_fail:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.613036, "o", "        sys.exit(1)'''\r\n\u001b[?2004l\r"]
[1773.613089, "o", "\u001b[?2004h>     ),\r\n\u001b[?2004l\r"]
[1773.613142, "o", "\u001b[?2004h>     (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.613266, "o", "'''    del state[service]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.613382, "o", "    save_deployment_state(env, state)\r\n\u001b[?2004l\r"]
[1773.613475, "o", "\u001b[?2004h> "]
[1773.613567, "o", "    print(f\"ROLLBACK {service} from {env} OK\")''',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.613672, "o", "'''    del state[service]\r\n\u001b[?2004l\r"]
[1773.613758, "o", "\u001b[?2004h> "]
[1773.61385, "o", "    save_deployment_state(env, state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.613941, "o", "> "]
[1773.614025, "o", "    append_event(env, \"ROLLBACK\", service, \"-\")\r\n\u001b[?2004l\r"]
[1773.61411, "o", "\u001b[?2004h> "]
[1773.61419, "o", "    print(f\"ROLLBACK {service} from {env} OK\")'''\r\n\u001b[?2004l\r"]
[1773.614279, "o", "\u001b[?2004h> "]
[1773.61438, "o", "    ),\r\n\u001b[?2004l\r\u001b[?2004h>     (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.614502, "o", "'''def print_tree(node, services, path, depth):''',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.614636, "o", "'''def version_timestamp(version):\r\n\u001b[?2004l\r"]
[1773.614723, "o", "\u001b[?2004h> "]
[1773.614807, "o", "    if not isinstance(version, str):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.614889, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.615, "o", "    parts = version.split(\":\")\r\n\u001b[?2004l\r"]
[1773.615085, "o", "\u001b[?2004h>     if len(parts) >= 3:\r\n\u001b[?2004l\r"]
[1773.615172, "o", "\u001b[?2004h> "]
[1773.615259, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.615363, "o", "            return int(parts[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.615451, "o", "        except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.61553, "o", "            return None\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.615614, "o", "> "]
[1773.615699, "o", "    return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rr"]
[1773.615782, "o", "\u001b[?2004h> def cmd_promote(args):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.615997, "o", "    values, flags, positionals = parse_opts(args, {\"--service\"}, {\"--dry-run\"})\r\n\u001b[?2004l\r"]
[1773.616083, "o", "\u001b[?2004h> "]
[1773.616168, "o", "    if len(positionals) != 2:\r\n\u001b[?2004l\r"]
[1773.61625, "o", "\u001b[?2004h> "]
[1773.616347, "o", "        fail(\"promote requires <source-env> <target-env>\")\r\n\u001b[?2004l\r"]
[1773.616434, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[1773.616522, "o", "    source, target = positionals\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.616619, "o", "    service = values.get(\"--service\")\r\n\u001b[?2004l\r"]
[1773.616704, "o", "\u001b[?2004h> "]
[1773.616793, "o", "    dry_run = \"--dry-run\" in flags\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1773.616877, "o", "\u001b[?2004h> "]
[1773.616962, "o", "    data = load_manifest()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.617047, "o", "    services, envs = get_services(data)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1773.617133, "o", "\r\n\u001b[?2004h> "]
[1773.617218, "o", "    if source not in envs:\r\n\u001b[?2004l\r"]
[1773.617319, "o", "\u001b[?2004h> "]
[1773.617406, "o", "        fail(f\"environment not found: {source}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.617486, "o", "    if target not in envs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.61763, "o", "        fail(f\"environment not found: {target}\")\r\n\u001b[?2004l\r"]
[1773.617714, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h>     if service:\r\n\u001b[?2004l\r"]
[1773.6178, "o", "\u001b[?2004h> "]
[1773.617908, "o", "        subset = transitive_deps(services, service)\r\n\u001b[?2004l\r"]
[1773.617996, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.618121, "o", "        subset = set(services.keys())\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.618207, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     ensure_state()\r\n\u001b[?2004l\r"]
[1773.618305, "o", "\u001b[?2004h> "]
[1773.6184, "o", "    source_state = load_deployment_state(source)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.618497, "o", "    target_state = load_deployment_state(target)\r\n\u001b[?2004l\r"]
[1773.618581, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.618715, "o", "    candidates = {s for s in source_state if s in subset and s in services}\r\n\u001b[?2004l\r"]
[1773.6188, "o", "\u001b[?2004h> "]
[1773.618889, "o", "    order = topo_order(services, candidates)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.618973, "o", "    if dry_run:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.619088, "o", "        print(f\"DRY-RUN promote from {source} to {target}:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.619169, "o", "        for s in order:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.619254, "o", "> "]
[1773.619388, "o", "            if source_state[s].get(\"version\") == target_state.get(s, {}).get(\"version\"):\r\n\u001b[?2004l\r"]
[1773.619474, "o", "\u001b[?2004h>                 continue\r\n\u001b[?2004l\r"]
[1773.619559, "o", "\u001b[?2004h> "]
[1773.619649, "o", "            print(f\"  Would promote {s}\")\r\n\u001b[?2004l\r"]
[1773.619733, "o", "\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     promoted = 0\r\n\u001b[?2004l\r"]
[1773.619824, "o", "\u001b[?2004h> "]
[1773.619911, "o", "    skipped = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.619994, "o", "    promote_events = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for s in order:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.620097, "o", "        src_rec = source_state[s]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.620185, "o", "> "]
[1773.620273, "o", "        src_version = src_rec.get(\"version\")\r\n\u001b[?2004l\r"]
[1773.620375, "o", "\u001b[?2004h> "]
[1773.620465, "o", "        if target_state.get(s, {}).get(\"version\") == src_version:\r\n\u001b[?2004l\r"]
[1773.620497, "o", "\u001b[?2004h> "]
[1773.620618, "o", "            print(f\"PROMOTE {s} -> {target}: SKIP (same version)\")\r\n\u001b[?2004l\r\u001b[?2004h>             skipped += 1\r\n\u001b[?2004l\r"]
[1773.620711, "o", "\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.620804, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.620893, "o", "        target_state[s] = src_rec\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.620974, "o", "        print(f\"PROMOTE {s} -> {target} OK\")\r\n\u001b[?2004l\r"]
[1773.621059, "o", "\u001b[?2004h> "]
[1773.621146, "o", "        promoted += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.621231, "o", "        promote_events.append((s, src_version))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.621321, "o", "    save_deployment_state(target, target_state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.621405, "o", "> "]
[1773.621489, "o", "    for s, version in promote_events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.621576, "o", "        append_event(target, \"PROMOTE\", s, version, source)\r\n\u001b[?2004l\r"]
[1773.621663, "o", "\u001b[?2004h> "]
[1773.621743, "o", "    print(f\"Promoted {promoted}, skipped {skipped}\")\r\n\u001b[?2004l\r"]
[1773.621826, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.621912, "o", "def cmd_diff(args):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.621997, "o", "    if len(args) != 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.622089, "o", "        fail(\"diff requires <env1> <env2>\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1773.622177, "o", "\u001b[?2004h>     env1, env2 = args\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.622265, "o", "    data = load_manifest()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.622376, "o", ">     _, envs = get_services(data)\r\n\u001b[?2004l\r"]
[1773.622458, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if env1 not in envs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.62254, "o", "        fail(f\"environment not found: {env1}\")\r\n\u001b[?2004l\r"]
[1773.622622, "o", "\u001b[?2004h> "]
[1773.622708, "o", "    if env2 not in envs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.622793, "o", "        fail(f\"environment not found: {env2}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.622882, "o", "    ensure_state()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.622959, "o", "    state1 = load_deployment_state(env1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.623073, "o", "    state2 = load_deployment_state(env2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.623157, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.623235, "o", "    all_services = sorted(set(state1) | set(state2))\r\n\u001b[?2004l\r"]
[1773.623337, "o", "\u001b[?2004h> "]
[1773.623429, "o", "    if not all_services:\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.623511, "o", "    for s in all_services:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.623616, "o", "        v1 = state1.get(s, {}).get(\"version\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.623699, "o", "> "]
[1773.62379, "o", "        v2 = state2.get(s, {}).get(\"version\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.623871, "o", "        if v1 and not v2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.62399, "o", "            print(f\"ONLY_IN {env1}: {s} ({v1})\")\r\n\u001b[?2004l\r"]
[1773.624077, "o", "\u001b[?2004h>         elif v2 and not v1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.624166, "o", "> "]
[1773.624254, "o", "            print(f\"ONLY_IN {env2}: {s} ({v2})\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.624356, "o", "        elif v1 == v2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.624434, "o", "            print(f\"SAME: {s} ({v1})\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.624524, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.624611, "o", "            t1 = version_timestamp(v1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.624698, "o", "> "]
[1773.624786, "o", "            t2 = version_timestamp(v2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.624872, "o", "            if t1 is not None and t2 is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.62496, "o", "                if t1 >= t2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.625046, "o", "                    newer = env1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.625135, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.625219, "o", "                    newer = env2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.625324, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.625432, "o", "                newer = env1 if str(v1) >= str(v2) else env2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.625595, "o", "            print(f\"DIFFERS: {s} {v1} vs {v2} ({newer} newer)\")\r\n\u001b[?2004l\r"]
[1773.625678, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1773.625745, "o", "def cmd_history(args):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1773.6258, "o", "> "]
[1773.62591, "o", "    values, flags, positionals = parse_opts(args, {\"--service\", \"--limit\"}, set())\r\n\u001b[?2004l\r"]
[1773.625934, "o", "\u001b[?2004h> "]
[1773.626004, "o", "    if len(positionals) != 1:\r\n\u001b[?2004l\r"]
[1773.626024, "o", "\u001b[?2004h> "]
[1773.626143, "o", "        fail(\"history requires an environment\")\r\n\u001b[?2004l\r"]
[1773.626163, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1773.626184, "o", "\u001b[?2004h> "]
