[7447.95825, "o", "fail(f\"environment not found: {env}\")\r\n    ensure_state()\r\n\r\n    if \"--list\" in flags:\r\n        snapshots = load_snapshots(env)\r\n        for snap in snapshots:\r\n            services = snap.get(\"services\", {})\r\n            print(f\"#{snap.get('id', '?')} {snap.get('timestamp', '')} ({len(services)} services)\")\r\n        return\r\n\r\n    state = load_deployment_state(env)\r\n    snapshots = load_snapshots(env)\r\n    next_id = 1\r\n    for snap in snapshots:\r\n        if isinstance(snap.get(\"id\"), int) and snap[\"id\"] >= next_id:\r\n            next_id = snap[\"id\"] + 1\r\n    timestamp = now_iso()\r\n    snapshot = {\"id\": next_id, \"timestamp\": timestamp, \"services\": state}\r\n    snapshots.append(snapshot)\r\n    save_snapshots(env, snapshots)\r\n    print(f\"SNAPSHOT {env} #{next_id} ({len(state)} services)\")\r\n\r\n"]
[7447.958374, "o", "def cmd_restore(args):\r\n    values, flags, positionals = parse_opts(args, set(), set())\r\n    if len(positionals) != 2:\r\n        fail(\"restore requires <environment> <snapshot_id>\")\r\n\r\n    env, snapshot_id_str = positionals\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n    assert_not_locked(env)\r\n    ensure_state()\r\n\r\n    try:\r\n        snapshot_id = int(snapshot_id_str)\r\n    except ValueError:\r\n        fail(\"snapshot id must be an integer\")\r\n\r\n    snapshots = load_snapshots(env)\r\n    snapshot = None\r\n    for snap in snapshots:\r\n        if snap.get(\"id\") == snapshot_id:\r\n            snapshot = snap\r\n"]
[7447.958482, "o", "            break\r\n    if snapshot is None:\r\n        fail(f\"snapshot not found: #{snapshot_id}\")\r\n\r\n    recorded = snapshot.get(\"services\", {})\r\n    state = {}\r\n    for svc, rec in recorded.items():\r\n        state[svc] = dict(rec)\r\n    save_deployment_state(env, state)\r\n\r\n    for svc in sorted(state):\r\n        version = state[svc].get(\"version\", \"\")\r\n        append_event(env, \"RESTORE\", svc, version, snapshot_id=snapshot_id)\r\n        print(f\"RESTORE {svc} -> {env} ({version})\")\r\n    print(f\"Restored {len(state)} services from snapshot #{snapshot_id}\")\r\n\r\ndef cmd_lock(args):\r\n    values, flags, positionals = parse_opts(args, {'--reason'}, {'--list'})\r\n    if '--list' in flags:\r\n        data = load_manifest()\r\n        _, envs = get_services(data)\r\n        ensure_state()\r\n        locked = []\r\n        for env in envs:\r\n            lock = load_lock(env)\r\n"]
[7447.958647, "o", "            if lock is not None:\r\n                locked.append((env, lock.get('reason', 'manual lock'), lock.get('locked_since', '')))\r\n        for env, reason, since in sorted(locked):\r\n            print(f\"{env}: {reason} (locked since {since})\")\r\n        return\r\n    if len(positionals) != 1:\r\n        fail(\"lock requires <environment> [--reason REASON] or --list\")\r\n    env = positionals[0]\r\n    reason = values.get('--reason', 'manual lock')\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"unknown environment {env}\")\r\n    ensure_state()\r\n    save_lock(env, reason)\r\n    append_lock_event(env, reason)\r\n    print(f\"LOCKED {env}: {reason}\")\r\n\r\ndef cmd_unlock(args):\r\n    values, flags, positionals = parse_opts(args, set(), set())\r\n    if len(positionals) != 1:\r\n        fail(\"unlock requires <environment>\")\r\n    env = positionals[0]\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n    if env not in envs:\r\n        fail(f\"unknown environment {env}\")"]
[7447.958747, "o", "\r\n    ensure_state()\r\n    remove_lock(env)\r\n    append_unlock_event(env)\r\n    print(f\"UNLOCKED {env}\")\r\n\r\ndef cmd_config(args):\r\n    if not args:\r\n        fail(\"config requires a subcommand\")\r\n    sub = args[0]\r\n    rest = args[1:]\r\n    if sub == 'set':\r\n        cmd_config_set(rest)\r\n    elif sub == 'get':\r\n        cmd_config_get(rest)\r\n"]
[7447.958858, "o", "    elif sub == 'list':\r\n        cmd_config_list(rest)\r\n    elif sub == 'diff':\r\n        cmd_config_diff(rest)\r\n    elif sub == 'delete':\r\n        cmd_config_delete(rest)\r\n    elif sub == 'export':\r\n        cmd_config_export(rest)\r\n    elif sub == 'import':\r\n        cmd_config_import(rest)\r\n    else:\r\n        fail(f\"unknown config subcommand: {sub}\")\r\n\r\ndef cmd_config_set(args):\r\n    if len(args) != 3:\r\n        fail(\"config set requires <environment> <KEY> <VALUE>\")\r\n    env, key, value = args\r\n    validate_config_key(key)\r\n    assert_env_exists(env)\r\n    assert_not_locked(env)\r\n    cfg = load_config(env)\r\n"]
[7447.958957, "o", "    cfg[key] = value\r\n    save_config(env, cfg)\r\n    append_config_set_event(env, key, value)\r\n    print(f\"CONFIG {env}: {key}={value}\")\r\n\r\ndef cmd_config_get(args):\r\n    if len(args) != 2:\r\n        fail(\"config get requires <environment> <KEY>\")\r\n    env, key = args\r\n    assert_env_exists(env)\r\n    cfg = load_config(env)\r\n    if key not in cfg:\r\n        fail(f\"key '{key}' not found in {env}\")\r\n    print(cfg[key])\r\n\r\ndef cmd_config_list(args):\r\n    if len(args) != 1:\r\n        fail(\"config list requires <environment>\")\r\n    env = args[0]\r\n    assert_env_exists(env)\r\n    cfg = load_config(env)\r\n    for key in sorted(cfg):\r\n        print(f\"{key}={cfg[key]}\")\r\n\r\ndef cmd_config_diff(args):\r\n    if len(args) != 2:\r\n        fail(\"config diff requires <env1> <env2>\")\r\n    env1, env2 = args\r\n    assert_env_exists(env1)\r\n    assert_env_exists(env2)\r\n    cfg1 = load_config(env1)\r\n    cfg2 = load_config(env2)\r\n    for key in sorted(set(cfg1) | set(cfg2)):\r\n        if key in cfg1 and key not in cfg2:\r\n            print(f\""]
[7447.959066, "o", "+ {key}={cfg1[key]} (only in {env1})\")\r\n        elif key in cfg2 and key not in cfg1:\r\n            print(f\"- {key}={cfg2[key]} (only in {env2})\")\r\n        elif cfg1[key] != cfg2[key]:\r\n            print(f\"~ {key}: {cfg1[key]} -> {cfg2[key]}\")\r\n\r\ndef cmd_config_delete(args):\r\n    if len(args) != 2:\r\n        fail(\"config delete requires <environment> <KEY>\")\r\n    env, key = args\r\n    validate_config_key(key)\r\n    assert_env_exists(env)\r\n    assert_not_locked(env)\r\n    cfg = load_config(env)\r\n    if key not in cfg:\r\n        fail(f\"key '{key}' not found in {env}\")\r\n    del cfg[key]\r\n    save_config(env, cfg)\r\n    append_config_delete_event(env, key)\r\n    print(f\"CONFIG {env}: deleted {key}\")\r\n\r\ndef cmd_config_export(args):\r\n    if len(args) != 1:\r\n        fail(\"config export requires <environment>\")\r\n    env = args[0]\r\n    assert_env_exists(env)\r\n    cfg = load_config(env)\r\n    print(json.dumps(cfg, sort_keys=True, separators=(',', ':')))\r\n"]
[7447.959182, "o", "\r\ndef cmd_config_import(args):\r\n    if len(args) != 1:\r\n        fail(\"config import requires <environment>\")\r\n    env = args[0]\r\n    raw = sys.stdin.read()\r\n    try:\r\n        data = json.loads(raw)\r\n    except json.JSONDecodeError as e:\r\n        fail(f\"invalid JSON: {e}\")\r\n    if not isinstance(data, dict):\r\n        fail(\"invalid JSON input: expected an object\")\r\n    for key, value in data.items():\r\n        if not isinstance(key, str):\r\n            fail(\"invalid JSON input: keys must be strings\")\r\n        if not isinstance(value, str):\r\n            fail(\"invalid JSON input: values must be strings\")\r\n        validate_config_key(key)\r\n    assert_env_exists(env)\r\n    assert_not_locked(env)\r\n    if not data:\r\n        return\r\n    cfg = load_config(env)\r\n    for key in sorted(data):\r\n        cfg[key] = data[key]\r\n    save_config(env, cfg)\r\n"]
[7447.959311, "o", "    for key in sorted(data):\r\n        append_config_set_event(env, key, data[key])\r\n        print(f\"CONFIG {env}: {key}={data[key]}\")\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        fail(\"no command given\")\r\n\r\n    cmd = sys.argv[1]\r\n    args = sys.argv[2:]\r\n\r\n    if cmd == 'validate':\r\n        cmd_validate(args)\r\n    elif cmd == 'order':\r\n        cmd_order(args)\r\n    elif cmd == 'build':\r\n        cmd_build(args)\r\n    elif cmd == 'test':\r\n        cmd_test(args)\r\n    elif cmd == 'deploy':\r\n        cmd_deploy(args)\r\n    elif cmd == 'status':\r\n        cmd_status(args)\r\n    elif cmd == 'rollback':\r\n        cmd_rollback(args)\r\n    elif cmd == 'promote':\r\n        cmd_promote(args)\r\n"]
[7447.959348, "o", "    elif cmd == 'diff':\r\n        cmd_diff(args)\r\n    elif cmd == 'history':\r\n        cmd_history(args)\r\n    elif cmd == 'graph':\r\n"]
[7447.959459, "o", "        cmd_graph(args)\r\n    elif cmd == 'bump':\r\n        cmd_bump(args)\r\n    elif cmd == 'snapshot':\r\n        cmd_snapshot(args)\r\n    elif cmd == 'restore':\r\n        cmd_restore(args)\r\n    elif cmd == 'lock':\r\n        cmd_lock(args)\r\n    elif cmd == 'unlock':\r\n        cmd_unlock(args)\r\n    elif cmd == 'config':\r\n        cmd_config(args)\r\n    else:\r\n        fail(f\"unknown command: {cmd}\")\r\n\r\nif __name__ == '__main__':\r\n    main()\r\nPY\r\npython3 \"$tmp_script\" \"$@\"\r\n"]
