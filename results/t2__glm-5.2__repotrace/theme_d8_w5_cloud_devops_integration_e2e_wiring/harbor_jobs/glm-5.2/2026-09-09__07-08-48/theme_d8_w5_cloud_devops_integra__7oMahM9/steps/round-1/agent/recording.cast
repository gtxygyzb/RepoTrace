[4900.732904, "o", "   593\tdef cmd_promote(args):\r\n   594\t    values, flags, positionals = parse_opts(args, {\"--service\"}, {\"--dry-run\", \"--force\"})\r\n   595\t    if len(positionals) != 2:\r\n   596\t        fail(\"promote requires <source-env> <target-env>\")\r\n"]
[4900.732965, "o", "   597\t\r\n   598\t    source, target = positionals\r\n   599\t    service = values.get(\"--service\")\r\n   600\t    dry_run = \"--dry-run\" in flags\r\n   601\t    force = \"--force\" in flags\r\n   602\t\r\n   603\t    data = load_manifest()\r\n   604\t    services, envs = get_services(data)\r\n   605\t"]
[4900.733023, "o", "\r\n   606\t    if source not in envs:\r\n   607\t        fail(f\"environment not found: {source}\")\r\n   608\t    if target not in envs:\r\n   609\t        fail(f\"environment not found: {target}\")\r\n   610\t\r\n   611\t    if service:\r\n   612\t        subset = transitive_deps(services, service)\r\n   613\t    else:\r\n"]
[4900.733076, "o", "   614\t        subset = set(services.keys())\r\n   615\t\r\n   616\t    ensure_state()\r\n   617\t    source_state = load_deployment_state(source)\r\n   618\t    target_state = load_deployment_state(target)\r\n   619\t\r\n   620\t    candidates = {s for s in source_state if s in subset and s in services}\r\n   621\t    order = topo_order(services, candidates)\r\n   622\t\r\n   623\t"]
[4900.733126, "o", "    if dry_run:\r\n   624\t        print(f\"DRY-RUN promote from {source} to {target}:\")\r\n   625\t        for s in order:\r\n   626\t            src_version = source_state[s].get(\"version\")\r\n   627\t            tgt_version = target_state.get(s, {}).get(\"version\")\r\n   628\t            if src_version == tgt_version:\r\n"]
[4900.73318, "o", "   629\t                continue\r\n   630\t            src_sv = extract_semver(src_version)\r\n   631\t            tgt_sv = extract_semver(tgt_version)\r\n   632\t            if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:\r\n   633\t                print(f\"  Would conflict {s} (downgrade)\")\r\n   634\t            else:\r\n"]
[4900.73323, "o", "   635\t                print(f\"  Would promote {s}\")\r\n   636\t        return\r\n   637\t\r\n   638\t    promoted = 0\r\n   639\t    skipped = 0\r\n   640\t    conflicts = 0\r\n   641\t    promote_events = []\r\n   642\t\r\n   643\t    for s in order:\r\n"]
[4900.73328, "o", "   644\t        src_rec = source_state[s]\r\n   645\t        src_version = src_rec.get(\"version\")\r\n   646\t        if target_state.get(s, {}).get(\"version\") == src_version:\r\n   647\t            print(f\"PROMOTE {s} -> {target}: SKIP (same version)\")\r\n   648\t            skipped += 1\r\n   649\t            continue\r\n   650\t\r\n   651\t        src_sv = extract_semver(src_version)\r\n"]
[4900.733377, "o", "   652\t        tgt_sv = extract_semver(target_state.get(s, {}).get(\"version\"))\r\n   653\t        if src_sv is not None and tgt_sv is not None and tgt_sv > src_sv:\r\n   654\t            if force:\r\n   655\t                target_state[s] = src_rec\r\n   656\t                print(f\"PROMOTE {s} -> {target} OK (forced)\")\r\n   657\t                promoted += 1\r\n   658\t                promote_events.append((s, src_version, True))\r\n   659\t            else:\r\n   660\t                print(f\"CONFLICT: {s} -> {target}: downgrade ({src_sv[0]}.{src_sv[1]}.{src_sv[2]} < {tgt_sv[0]}.{tgt_sv[1]}.{tgt_sv[2]})\")\r\n   661\t                conflicts += 1\r\n   662\t            continue\r\n   663\t\r\n"]
[4900.73343, "o", "   664\t        target_state[s] = src_rec\r\n   665\t        print(f\"PROMOTE {s} -> {target} OK\")\r\n   666\t        promoted += 1\r\n   667\t        promote_events.append((s, src_version, False))\r\n   668\t\r\n   669\t    save_deployment_state(target, target_state)\r\n   670\t    for s, version, forced in promote_events:\r\n"]
[4900.733474, "o", "   671\t        append_event(target, \"PROMOTE\", s, version, source, forced=forced)\r\n   672\t    print(f\"Promoted {promoted}, skipped {skipped}, conflicts {conflicts}\")\r\n   673\tdef cmd_diff(args):\r\n   674\t    if len(args) != 2:\r\n   675\t        fail(\"diff requires <env1> <env2>\")\r\n   676\t\r\n   677\t    env1, env2 = args\r\n   678\t    data = load_manifest()\r\n   679\t"]
[4900.733565, "o", "    _, envs = get_services(data)\r\n   680\t\r\n   681\t    if env1 not in envs:\r\n   682\t        fail(f\"environment not found: {env1}\")\r\n   683\t    if env2 not in envs:\r\n"]
[4900.733631, "o", "   684\t        fail(f\"environment not found: {env2}\")\r\n   685\t\r\n   686\t    ensure_state()\r\n   687\t    state1 = load_deployment_state(env1)\r\n   688\t    state2 = load_deployment_state(env2)\r\n   689\t\r\n   690\t    all_services = sorted(set(state1) | set(state2))\r\n   691\t    if not all_services:\r\n   692\t        return\r\n   693\t\r\n   694\t    for s in all_services:\r\n   695\t        v1 = state1.get(s, {}).get(\"version\")\r\n   696\t        v2 = state2.get(s, {}).get(\"version\")\r\n   697\t\r\n   698\t        if v1 and not v2:\r\n   699\t            print(f\"ONLY_IN {env1}: {s} ({v1})\")\r\n   700\t        elif v2 and not v1:\r\n   701\t            print(f\"ONLY_IN {env2}: {s} ({v2})\")\r\n   702\t        elif v1 == v2:\r\n   703\t            print(f\"SAME: {s} ({v1})\")\r\n   704"]
[4900.733689, "o", "\t        else:\r\n   705\t            cmp = compare_versions(v1, v2)\r\n   706\t            if cmp == 0:\r\n   707\t                print(f\"SAME: {s} ({v1})\")\r\n   708\t            else:\r\n   709\t                newer = env1 if cmp > 0 else env2\r\n   710\t                print(f\"DIFFERS: {s} {v1} vs {v2} ({newer} newer)\")\r\n   711\t\r\n"]
