[2006.897846, "o", "\r\ndef event_file(env):\r\n    return os.path.join(EVENTS_DIR, f\"{env}.log\")\r\n\r\ndef append_event(env, action, service, version, source_env=None):\r\n    ensure_state()\r\n    ts = now_iso()\r\n    line = f\"{ts} {action} {service} {version}\"\r\n"]
[2006.897899, "o", "    if action == \"PROMOTE\" and source_env is not None:\r\n        line += f\" from {source_env}\"\r\n    line += \"\\n\"\r\n    with open(event_file(env), \"a\") as f:\r\n        f.write(line)\r\n\r\ndef parse_opts(args, value_opts, flag_opts):\r\n    values = {}\r\n"]
[2006.901355, "o", "\r\ndef cmd_test(args):\r\n    values, flags, positionals = parse_opts(args, {'--service'}, {'--fail-fast'})\r\n    if positionals:\r\n        fail(\"test does not accept positional arguments\")\r\n\r\n"]
[2006.901474, "o", "    service = values.get('--service')\r\n    fail_fast = '--fail-fast' in flags\r\n\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n\r\n    if service:\r\n        if service not in services:\r\n            fail(f\"service not found: {service}\")\r\n        order = [service]\r\n    else:\r\n        order = topo_order(services)\r\n\r\n    ensure_state()\r\n    results = load_json(TEST_RESULTS_PATH, {})\r\n    any_fail = False\r\n\r\n    for s in order:\r\n        if os.path.exists(artifact_path(services[s])):\r\n            results[s] = {\"pass\": True, \"timestamp\": now_iso()}\r\n"]
[2006.904794, "o", "\r\n    if dry_run:\r\n        print(f\"DRY-RUN deploy to {env}:\")\r\n        for s in order:\r\n            print(f\"  Would deploy {s}\")\r\n"]
[2006.904867, "o", "        return\r\n\r\n    test_results = load_json(TEST_RESULTS_PATH, {})\r\n    state = load_deployment_state(env)\r\n    any_fail = False\r\n    deployed_events = []\r\n\r\n    for s in order:\r\n        rec = test_results.get(s)\r\n        if not rec or not rec.get(\"pass\"):\r\n            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n            any_fail = True\r\n            break\r\n\r\n"]
[2006.90493, "o", "        version = read_artifact(services[s])\r\n        if version is None:\r\n            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n            any_fail = True\r\n            break\r\n\r\n        state[s] = {\"version\": version, \"deployed_at\": now_iso()}\r\n        deployed_events.append((s, version))\r\n        print(f\"DEPLOY {s} -> {env} OK\")\r\n\r\n    save_deployment_state(env, state)\r\n    for s, version in deployed_events:\r\n        append_event(env, \"DEPLOY\", s, version)\r\n    if any_fail:\r\n"]
[2006.904999, "o", "        sys.exit(1)\r\n\r\ndef cmd_status(args):\r\n    if len(args) > 1:\r\n        fail(\"status takes at most one environment argument\")\r\n\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n"]
[2006.908336, "o", "            fail(f\"environment not found: {env}\")\r\n        state = load_deployment_state(env)\r\n        for s in sorted(state):\r\n            rec = state[s]\r\n"]
[2006.908409, "o", "            print(f\"{s}: {rec.get('version', '')} (deployed at {rec.get('deployed_at', '')})\")\r\n    else:\r\n        for env in sorted(envs):\r\n            state = load_deployment_state(env)\r\n            print(f\"{env}: {len(state)} services deployed\")\r\n\r\ndef cmd_rollback(args):\r\n    if len(args) != 2:\r\n        fail(\"rollback requires <environment> <service_name>\")\r\n\r\n    env, service = args\r\n    ensure_state()\r\n    state = load_deployment_state(env)\r\n\r\n    if service not in state:\r\n        print(f\"ROLLBACK {service} from {env} FAIL: not deployed\")"]
[2006.908479, "o", "\r\n        sys.exit(1)\r\n\r\n    del state[service]\r\n    save_deployment_state(env, state)\r\n    append_event(env, \"ROLLBACK\", service, \"-\")\r\n    print(f\"ROLLBACK {service} from {env} OK\")\r\n\r\ndef version_timestamp(version):\r\n    if not isinstance(version, str):"]
[2006.908545, "o", "\r\n        return None\r\n    parts = version.split(\":\")\r\n    if len(parts) >= 3:\r\n        try:\r\n            return int(parts[1])\r\n        except ValueError:\r\n            return None\r\n    return None\r\n\r\ndef cmd_promote(args):\r\n    values, flags, positionals = parse_opts(args, {\"--service\"}, {\"--dry-run\"})\r\n    if len(positionals) != 2:\r\n        fail(\"promote requires <source-env> <target-env>\")\r\n\r\n    source, target = positionals\r\n    service = values.get(\"--service\")\r\n    dry_run = \"--dry-run\" in flags\r\n"]
[2006.90861, "o", "\r\n    data = load_manifest()\r\n    services, envs = get_services(data)\r\n\r\n    if source not in envs:\r\n        fail(f\"environment not found: {source}\")\r\n    if target not in envs:\r\n        fail(f\"environment not found: {target}\")\r\n\r\n    if service:\r\n        subset = transitive_deps(services, service)\r\n    else:\r\n        subset = set(services.keys())\r\n\r\n    ensure_state()\r\n    source_state = load_deployment_state(source)\r\n"]
[2006.908697, "o", "    target_state = load_deployment_state(target)\r\n\r\n    candidates = {s for s in source_state if s in subset and s in services}\r\n    order = topo_order(services, candidates)\r\n\r\n    if dry_run:\r\n        print(f\"DRY-RUN promote from {source} to {target}:\")\r\n        for s in order:\r\n            if source_state[s].get(\"version\") == target_state.get(s, {}).get(\"version\"):\r\n                continue\r\n            print(f\"  Would promote {s}\")\r\n        return\r\n\r\n    promoted = 0\r\n"]
[2006.912011, "o", "            print(f\"ONLY_IN {env2}: {s} ({v2})\")\r\n        elif v1 == v2:\r\n            print(f\"SAME: {s} ({v1})\")\r\n        else:\r\n"]
[2006.912085, "o", "            t1 = version_timestamp(v1)\r\n            t2 = version_timestamp(v2)\r\n            if t1 is not None and t2 is not None:\r\n                if t1 >= t2:\r\n                    newer = env1\r\n                else:\r\n                    newer = env2\r\n            else:\r\n                newer = env1 if str(v1) >= str(v2) else env2\r\n            print(f\"DIFFERS: {s} {v1} vs {v2} ({newer} newer)\")\r\n\r\ndef cmd_history(args):\r\n    values, flags, positionals = parse_opts(args, {\"--service\", \"--limit\"}, set())\r\n    if len(positionals) != 1:\r\n        fail(\"history requires an environment\")\r\n"]
[2006.912151, "o", "\r\n    env = positionals[0]\r\n    service = values.get(\"--service\")\r\n    limit = 10\r\n    if \"--limit\" in values:\r\n        try:\r\n            limit = int(values[\"--limit\"])\r\n        except ValueError:\r\n            fail(\"--limit requires an integer\")\r\n        if limit < 0:\r\n            fail(\"--limit must be non-negative\")\r\n\r\n    data = load_manifest()\r\n    _, envs = get_services(data)\r\n"]
[2006.912211, "o", "    if env not in envs:\r\n        fail(f\"environment not found: {env}\")\r\n\r\n    ensure_state()\r\n    try:\r\n        with open(event_file(env)) as f:\r\n            lines = [line.rstrip(\"\\n\") for line in f if line.strip()]\r\n    except FileNotFoundError:\r\n        lines = []\r\n\r\n    if service:\r\n        lines = [line for line in lines if len(line.split()) >= 3 and line.split()[2] == service]\r\n\r\n    lines.reverse()\r\n"]
[2006.91227, "o", "    lines = lines[:limit]\r\n    for line in lines:\r\n        print(line)\r\n\r\n"]
[2006.912763, "o", "\u001b[?2004h"]
[2006.912829, "o", "root@n30009:/app# "]
[2785.874643, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('pipeline.sh')\ntext = p.read_text()\nold = '''def cmd_rollback(args):\n    if len(args) != 2:\n        fail(\"rollback requires <environment> <service_name>\")\n\n    env, service = args\n    ensure_state()\n    state = load_deployment_state(env)\n'''\nnew = '''def cmd_rollback(args):\n    if len(args) != 2:\n        fail(\"rollback requires <environment> <service_name>\")\n\n    env, service = args\n    data = load_manifest()\n    _, envs = get_services(data)\n    if env not in envs:\n        fail(f\"environment not found: {env}\")\n    ensure_state()\n    state = load_deployment_state(env)\n'''\nif old not in text:\n    raise SystemExit('rollback block not found')\ntext = text.replace(old, new, 1)\np.write_text(text)\nPY\n"]
