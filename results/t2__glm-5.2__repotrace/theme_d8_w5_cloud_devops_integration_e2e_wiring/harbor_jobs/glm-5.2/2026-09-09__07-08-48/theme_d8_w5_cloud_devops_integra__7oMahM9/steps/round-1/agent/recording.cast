[3208.419032, "o", "   585\t    service = values.get(\"--service\")\r\n   586\t    limit = 10\r\n   587\t    if \"--limit\" in values:\r\n   588\t        try:\r\n   589\t            limit = int(values[\"--limit\"])\r\n   590\t        except ValueError:\r\n   591\t            fail(\"--limit requires an integer\")\r\n   592\t        if limit < 0:\r\n   593\t            fail(\"--limit must be non-negative\")\r\n   594\t\r\n   595\t    data = load_manifest()\r\n   596\t    _, envs = get_services(data)\r\n"]
