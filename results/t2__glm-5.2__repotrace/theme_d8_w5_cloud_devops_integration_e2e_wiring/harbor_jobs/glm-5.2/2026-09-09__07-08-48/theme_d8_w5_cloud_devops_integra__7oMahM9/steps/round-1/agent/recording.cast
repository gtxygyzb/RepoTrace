[3404.040434, "o", "pipeline.sh replacement not found:\r\ndef append_event(env, action, service, version, source_env=None):\r\n    ensure_state()\r\n    ts = now_iso()\r\n    line = f\"{ts} {action} {service} {version}\"\r\n    if action == \"PROMOTE\" and source_env is not\r\n"]
[3404.044101, "o", "\u001b[?2004h"]
