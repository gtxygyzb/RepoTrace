[3185.113354, "o", "            return int(parts[1])\r\n   473\t        except ValueError:\r\n   474\t            return None\r\n   475\t    return None\r\n   476\t\r\n   477\tdef cmd_promote(args):\r\n   478\t    values, flags, positionals = parse_opts(args, {\"--service\"}, {\"--dry-run\"})\r\n   479\t    if len(positionals) != 2:\r\n   480\t        fail(\"promote requires <source-env> <target-env>\")\r\n   481\t\r\n   482\t    source, target = positionals\r\n   483\t    service = values.get(\"--service\")\r\n   484\t    dry_run = \"--dry-run\" in flags\r\n   485\t\r\n   486\t    data = load_manifest()\r\n   487\t    services, envs = get_services(data)\r\n"]
[3185.113438, "o", "   488\t\r\n   489\t    if source not in envs:\r\n   490\t        fail(f\"environment not found: {source}\")\r\n   491\t    if target not in envs:\r\n   492\t        fail(f\"environment not found: {target}\")\r\n   493\t\r\n   494\t    if service:\r\n   495\t        subset = transitive_deps(services, service)\r\n   496\t    else:\r\n   497\t        subset = set(services.keys())\r\n   498\t\r\n   499\t    ensure_state()\r\n"]
[3185.113567, "o", "   500\t    source_state = load_deployment_state(source)\r\n   501\t    target_state = load_deployment_state(target)\r\n   502\t\r\n   503\t    candidates = {s for s in source_state if s in subset and s in services}\r\n   504\t    order = topo_order(services, candidates)\r\n   505\t\r\n   506\t    if dry_run:\r\n   507\t        print(f\"DRY-RUN promote from {source} to {target}:\")\r\n   508\t        for s in order:\r\n   509\t            if source_state[s].get(\"version\") == target_state.get(s, {}).get(\"version\"):\r\n   510\t                continue\r\n   511\t            print(f\"  Would promote {s}\")\r\n   512\t        return\r\n   513\t\r\n   514\t    promoted = 0\r\n   515\t    skipped = 0\r\n   516\t    promote_events = []\r\n"]
