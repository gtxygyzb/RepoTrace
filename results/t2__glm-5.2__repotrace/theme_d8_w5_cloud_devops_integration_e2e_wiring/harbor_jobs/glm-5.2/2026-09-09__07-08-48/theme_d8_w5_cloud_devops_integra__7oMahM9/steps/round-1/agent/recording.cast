[5656.9374, "o", "\timport time\r\n     8\timport yaml\r\n     9\tfrom datetime import datetime, timezone\r\n    10\t\r\n    11\tAPP_DIR = '/app'\r\n    12\tMANIFEST_PATH = '/app/pipeline.yaml'\r\n    13\tSTATE_DIR = '/app/.pipeline'\r\n    14\tTEST_RESULTS_PATH = os.path.join(STATE_DIR, 'test_results.json')\r\n    15\tDEPLOYMENTS_DIR = os.path.join(STATE_DIR, 'deployments')\r\n    16\tEVENTS_DIR = os.path.join(STATE_DIR, 'events')\r\n    17\tSNAPSHOTS_DIR = os.path.join(STATE_DIR, 'snapshots')\r\n    18\tLOCK_DIR = os.path.join(STATE_DIR, 'locks')\r\n    19\t\r\n"]
[5656.937481, "o", "    20\tSERVICE_FIELDS = ['version', 'path', 'build_cmd', 'test_cmd', 'port', 'depends_on', 'health_endpoint']\r\n    21\tENV_FIELDS = ['deploy_target', 'health_check_port', 'max_replicas']\r\n    22\t\r\n    23\tdef ensure_state():\r\n    24\t    os.makedirs(STATE_DIR, exist_ok=True)\r\n    25\t    os.makedirs(DEPLOYMENTS_DIR, exist_ok=True)\r\n    26\t    os.makedirs(EVENTS_DIR, exist_ok=True)\r\n    27\t    os.makedirs(SNAPSHOTS_DIR, exist_ok=True)\r\n    28\t    os.makedirs(LOCK_DIR, exist_ok=True)\r\n    29\t\r\n    30\tdef fail(msg, code=1):\r\n    31\t    print(f\"ERROR: {msg}\")\r\n    32\t    sys.exit(code)\r\n    33\t\r\n    34\tdef now_iso():\r\n    35\t    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n    36\t\r\n"]
[5656.937546, "o", "    37\tdef load_json(path, default):\r\n    38\t    try:\r\n    39\t        with open(path) as f:\r\n    40\t            return json.load(f)\r\n    41\t    except FileNotFoundError:\r\n    42\t        return default\r\n    43\t    except json.JSONDecodeError as e:\r\n    44\t        fail(f\"state error in {path}: {e}\")\r\n    45\t\r\n"]
[5656.937609, "o", "    46\tdef save_json(path, data):\r\n    47\t    os.makedirs(os.path.dirname(path), exist_ok=True)\r\n    48\t    with open(path, 'w') as f:\r\n    49\t        json.dump(data, f, indent=2, sort_keys=True)\r\n    50\t\r\n    51\tdef load_manifest():\r\n    52\t    try:\r\n    53\t        with open(MANIFEST_PATH) as f:\r\n    54\t            data = yaml.safe_load(f)\r\n    55\t    except FileNotFoundError:\r\n    56\t        fail(\"manifest not found\")\r\n    57\t    except yaml.YAMLError as e:\r\n"]
[5656.937674, "o", "    58\t        fail(f\"YAML syntax error: {e}\")\r\n    59\t    if not isinstance(data, dict):\r\n    60\t        fail(\"manifest must be a mapping\")\r\n    61\t    return data\r\n    62\t\r\n    63\tdef validate_manifest(data):\r\n    64\t    if not isinstance(data, dict):\r\n    65\t        raise ValueError(\"manifest must be a mapping\")\r\n    66\t\r\n    67\t    services = data.get('services')\r\n    68\t    if not isinstance(services, dict) or not services:\r\n"]
[5656.937744, "o", "    69\t        raise ValueError(\"manifest missing services\")\r\n    70\t\r\n    71\t    environments = data.get('environments')\r\n    72\t    if not isinstance(environments, dict) or not environments:\r\n    73\t        raise ValueError(\"manifest missing environments\")\r\n    74\t\r\n    75\t    for env_name, env in environments.items():\r\n    76\t        if not isinstance(env, dict):\r\n    77\t            raise ValueError(f\"environment {env_name} must be a mapping\")\r\n    78\t        for field in ENV_FIELDS:\r\n    79\t            if field not in env:\r\n    80\t                raise ValueError(f\"environment {env_name} missing required field: {field}\")\r\n"]
[5656.937811, "o", "    81\t\r\n    82\t    for name, svc in services.items():\r\n    83\t        if not isinstance(svc, dict):\r\n    84\t            raise ValueError(f\"service {name} must be a mapping\")\r\n    85\t        for field in SERVICE_FIELDS:\r\n    86\t            if field not in svc:\r\n    87\t                raise ValueError(f\"service {name} missing required field: {field}\")\r\n    88\t        if not isinstance(svc['depends_on'], list):\r\n    89\t            raise ValueError(f\"service {name} has invalid depends_on: must be a list\")\r\n    90\t        for dep in svc['depends_on']:\r\n    91\t            if dep not in services:\r\n"]
[5656.937928, "o", "    92\t                raise ValueError(f\"service {name} depends on undefined service: {dep}\")\r\n    93\t        if not valid_version(svc.get('version')):\r\n    94\t            raise ValueError(f\"service {name} has invalid version: expected N.N.N\")\r\n    95\t\r\n    96\t    port_map = {}\r\n    97\t    for name, svc in services.items():\r\n    98\t        port = svc['port']\r\n    99\t        if port in port_map:\r\n   100\t            raise ValueError(f\"duplicate port assignment: {port}\")\r\n   101\t        port_map[port] = name\r\n   102\t\r\n   103\t    cycle = find_cycle(services)\r\n   104\t    if cycle:\r\n   105\t        raise ValueError(f\"circular dependency detected: {' -> '.join(cycle)}\")\r\n   106\t\r\n   107\t    return True\r\n   108\t\r\n   109\tdef find_cycle(services):\r\n   110\t    visited = {}\r\n   111\t    stack = []\r\n"]
[5656.937995, "o", "   112\t\r\n   113\t    def dfs(node):\r\n   114\t        visited[node] = 1\r\n   115\t        stack.append(node)\r\n   116\t        for dep in services[node].get('depends_on', []):\r\n   117\t            if dep not in services:\r\n   118\t                continue\r\n   119\t            if visited.get(dep) == 1:\r\n   120\t                idx = stack.index(dep)\r\n"]
