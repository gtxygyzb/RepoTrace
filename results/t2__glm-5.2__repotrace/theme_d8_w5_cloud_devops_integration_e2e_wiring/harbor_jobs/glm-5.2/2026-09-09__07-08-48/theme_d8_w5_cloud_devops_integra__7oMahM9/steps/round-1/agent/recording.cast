[11888.685974, "o", "\u001b[?2004h> "]
[11888.686228, "o", "        \"timestamp\": int(time.time()),\r\n\u001b[?2004l\r"]
[11888.686285, "o", "\u001b[?2004h> "]
[11888.68652, "o", "        \"iso_timestamp\": now_iso(),\r\n\u001b[?2004l\r"]
[11888.686576, "o", "\u001b[?2004h> "]
[11888.686766, "o", "        \"action\": \"QUOTA_SET\",\r\n\u001b[?2004l\r"]
[11888.686821, "o", "\u001b[?2004h> "]
[11888.686976, "o", "        \"service\": \"-\",\r\n\u001b[?2004l\r"]
[11888.687041, "o", "\u001b[?2004h> "]
[11888.687186, "o", "        \"version\": \"-\",\r\n\u001b[?2004l\r"]
[11888.68725, "o", "\u001b[?2004h> "]
[11888.687449, "o", "        \"resource\": resource,\r\n\u001b[?2004l\r"]
[11888.687505, "o", "\u001b[?2004h> "]
[11888.687653, "o", "        \"limit\": limit,\r\n\u001b[?2004l\r"]
[11888.687716, "o", "\u001b[?2004h> "]
[11888.687772, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.687828, "o", "> "]
[11888.688072, "o", "    with open(event_file(env), \"a\") as f:\r\n\u001b[?2004l\r"]
[11888.688136, "o", "\u001b[?2004h> "]
[11888.688406, "o", "        f.write(json.dumps(event) + \"\\n\")\r\n\u001b[?2004l\r"]
[11888.688461, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11888.688516, "o", "\u001b[?2004h> "]
[11888.688804, "o", "def append_quota_remove_event(env, resource):\r\n\u001b[?2004l\r"]
[11888.68886, "o", "\u001b[?2004h> "]
[11888.688977, "o", "    ensure_state()\r\n\u001b[?2004l\r"]
[11888.689031, "o", "\u001b[?2004h> "]
[11888.68912, "o", "    event = {\r\n\u001b[?2004l\r"]
[11888.689175, "o", "\u001b[?2004h> "]
[11888.689428, "o", "        \"timestamp\": int(time.time()),\r\n\u001b[?2004l\r"]
[11888.689484, "o", "\u001b[?2004h> "]
[11888.689726, "o", "        \"iso_timestamp\": now_iso(),\r\n\u001b[?2004l\r"]
[11888.689774, "o", "\u001b[?2004h> "]
[11888.689998, "o", "        \"action\": \"QUOTA_REMOVE\",\r\n\u001b[?2004l\r"]
[11888.690073, "o", "\u001b[?2004h> "]
[11888.690212, "o", "        \"service\": \"-\",\r\n\u001b[?2004l\r"]
[11888.690269, "o", "\u001b[?2004h> "]
[11888.690438, "o", "        \"version\": \"-\",\r\n\u001b[?2004l\r"]
[11888.690494, "o", "\u001b[?2004h> "]
[11888.690686, "o", "        \"resource\": resource,\r\n\u001b[?2004l\r"]
[11888.690757, "o", "\u001b[?2004h> "]
[11888.690813, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.690868, "o", "> "]
[11888.691102, "o", "    with open(event_file(env), \"a\") as f:\r\n\u001b[?2004l\r"]
[11888.691168, "o", "\u001b[?2004h> "]
[11888.691454, "o", "        f.write(json.dumps(event) + \"\\n\")\r\n\u001b[?2004l\r"]
[11888.691509, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11888.691574, "o", "\u001b[?2004h> "]
[11888.691751, "o", "def quota_status_line(env):\r\n\u001b[?2004l\r"]
[11888.691807, "o", "\u001b[?2004h> "]
[11888.691996, "o", "    quotas = load_quotas(env)\r\n\u001b[?2004l\r"]
[11888.692053, "o", "\u001b[?2004h> "]
[11888.69217, "o", "    if not quotas:\r\n\u001b[?2004l\r"]
[11888.692226, "o", "\u001b[?2004h> "]
[11888.692359, "o", "        return None\r\n\u001b[?2004l\r"]
[11888.692416, "o", "\u001b[?2004h> "]
[11888.692507, "o", "    parts = []\r\n\u001b[?2004l\r"]
[11888.692563, "o", "\u001b[?2004h> "]
[11888.692891, "o", "    for resource in quota_supported_resources():\r\n\u001b[?2004l\r"]
[11888.692946, "o", "\u001b[?2004h> "]
[11888.69308, "o", "        if resource in quotas:\r\n\u001b[?2004l\r"]
[11888.693135, "o", "\u001b[?2004h> "]
[11888.693285, "o", "            limit = quotas[resource]\r\n\u001b[?2004l\r"]
[11888.693366, "o", "\u001b[?2004h> "]
[11888.693562, "o", "            usage = quota_current_usage(env, resource)\r\n\u001b[?2004l\r"]
[11888.693617, "o", "\u001b[?2004h> "]
[11888.693878, "o", "            parts.append(f\"{resource}={limit} ({usage}/{limit})\")\r\n\u001b[?2004l\r"]
[11888.693933, "o", "\u001b[?2004h> "]
[11888.694008, "o", "    if not parts:\r\n\u001b[?2004l\r"]
[11888.694062, "o", "\u001b[?2004h> "]
[11888.694152, "o", "        return None\r\n\u001b[?2004l\re"]
[11888.694207, "o", "\u001b[?2004h> "]
[11888.69437, "o", "    return \"Quotas: \" + \", \".join(parts)\r\n\u001b[?2004l\r"]
[11888.694432, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r(\u001b[?2004h> "]
[11888.694536, "o", "def cmd_quota(args):\r\n\u001b[?2004l\r"]
[11888.69459, "o", "\u001b[?2004h> "]
[11888.694656, "o", "    if not args:\r\n\u001b[?2004l\r"]
[11888.694711, "o", "\u001b[?2004h> "]
[11888.695058, "o", "        fail(\"quota requires <environment> <set|get|list|remove|--check> [args]\")\r\n\u001b[?2004l\r"]
[11888.695113, "o", "\u001b[?2004h> "]
[11888.695186, "o", "    env = args[0]\r\n\u001b[?2004l\r"]
[11888.695243, "o", "\u001b[?2004h> "]
[11888.695338, "o", "    if len(args) < 2:\r\n\u001b[?2004l\r"]
[11888.695395, "o", "\u001b[?2004h> "]
[11888.695747, "o", "        fail(\"quota requires <environment> <set|get|list|remove|--check> [args]\")\r\n\u001b[?2004l\r"]
[11888.695806, "o", "\u001b[?2004h> "]
[11888.695867, "o", "    sub = args[1]\r\n\u001b[?2004l\r"]
[11888.695922, "o", "\u001b[?2004h> "]
[11888.695997, "o", "    rest = args[2:]\r\n\u001b[?2004l\r"]
[11888.696052, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r)\u001b[?2004h"]
[11888.696107, "o", "> "]
[11888.696201, "o", "    assert_env_exists(env)\r\n\u001b[?2004l\r"]
[11888.696256, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h"]
[11888.696326, "o", "> "]
[11888.696382, "o", "    if sub == 'set':\r\n\u001b[?2004l\r"]
[11888.696436, "o", "\u001b[?2004h> "]
[11888.696533, "o", "        if len(rest) != 2:\r\n\u001b[?2004l\r"]
[11888.696589, "o", "\u001b[?2004h> "]
[11888.696869, "o", "            fail(\"quota <environment> set <resource> <limit>\")\r\n\u001b[?2004l\r"]
[11888.696924, "o", "\u001b[?2004h> "]
[11888.697055, "o", "        resource, limit_str = rest\r\n\u001b[?2004l\r"]
[11888.69711, "o", "\u001b[?2004h> "]
[11888.697281, "o", "        validate_quota_resource(resource)\r\n\u001b[?2004l\r"]
[11888.697343, "o", "\u001b[?2004h> "]
[11888.69752, "o", "        limit = parse_positive_int(limit_str)\r\n\u001b[?2004l\r"]
[11888.697574, "o", "\u001b[?2004h> "]
[11888.697673, "o", "        if limit is None:\r\n\u001b[?2004l\r"]
[11888.697726, "o", "\u001b[?2004h> "]
[11888.697958, "o", "            fail(f\"invalid quota limit '{limit_str}'\")\r\n\u001b[?2004l\r"]
[11888.698012, "o", "\u001b[?2004h> "]
[11888.698123, "o", "        assert_not_locked(env)\r\n\u001b[?2004l\r"]
[11888.698179, "o", "\u001b[?2004h> "]
[11888.698332, "o", "        quotas = load_quotas(env)\r\n\u001b[?2004l\r"]
[11888.698388, "o", "\u001b[?2004h> "]
[11888.698514, "o", "        quotas[resource] = limit\r\n\u001b[?2004l\r"]
[11888.69857, "o", "\u001b[?2004h> "]
[11888.698691, "o", "        save_quotas(env, quotas)\r\n\u001b[?2004l\r"]
[11888.698745, "o", "\u001b[?2004h> "]
[11888.698961, "o", "        append_quota_set_event(env, resource, limit)\r\n\u001b[?2004l\r"]
[11888.699015, "o", "\u001b[?2004h> "]
[11888.699228, "o", "        print(f\"QUOTA {env}: {resource}={limit}\")\r\n\u001b[?2004l\r"]
[11888.699283, "o", "\u001b[?2004h> "]
[11888.69937, "o", "    elif sub == 'get':\r\n\u001b[?2004l\r"]
[11888.699426, "o", "\u001b[?2004h> "]
[11888.699528, "o", "        if len(rest) != 1:\r\n\u001b[?2004l\r"]
[11888.699583, "o", "\u001b[?2004h> "]
[11888.699828, "o", "            fail(\"quota <environment> get <resource>\")\r\n\u001b[?2004l\r"]
[11888.699882, "o", "\u001b[?2004h> "]
[11888.699981, "o", "        resource = rest[0]\r\n\u001b[?2004l\r"]
[11888.700035, "o", "\u001b[?2004h> "]
[11888.700222, "o", "        validate_quota_resource(resource)\r\n\u001b[?2004l\r"]
[11888.700252, "o", "\u001b[?2004h> "]
[11888.700438, "o", "        quotas = load_quotas(env)\r\n\u001b[?2004l\r"]
[11888.700497, "o", "\u001b[?2004h> "]
[11888.700706, "o", "        usage = quota_current_usage(env, resource)\r\n\u001b[?2004l\r"]
[11888.700779, "o", "\u001b[?2004h> "]
[11888.70088, "o", "        if resource in quotas:\r\n\u001b[?2004l\r"]
[11888.700934, "o", "\u001b[?2004h> "]
[11888.701252, "o", "            print(f\"{resource}: {quotas[resource]} (current: {usage})\")\r\n\u001b[?2004l\r"]
[11888.701318, "o", "\u001b[?2004h> "]
[11888.701382, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.701665, "o", "            print(f\"{resource}: not set (current: {usage})\")\r\n\u001b[?2004l\r"]
[11888.70172, "o", "\u001b[?2004h> "]
[11888.7018, "o", "    elif sub == 'list':\r\n\u001b[?2004l\r"]
[11888.701854, "o", "\u001b[?2004h> "]
[11888.702025, "o", "        quotas = load_quotas(env)\r\n\u001b[?2004l\r"]
[11888.70208, "o", "\u001b[?2004h> "]
[11888.702301, "o", "        for resource in quota_supported_resources():\r\n\u001b[?2004l\r"]
[11888.70236, "o", "\u001b[?2004h> "]
[11888.702513, "o", "            if resource in quotas:\r\n\u001b[?2004l\r"]
[11888.702581, "o", "\u001b[?2004h> "]
[11888.702817, "o", "                usage = quota_current_usage(env, resource)\r\n\u001b[?2004l\r"]
[11888.702873, "o", "\u001b[?2004h> "]
[11888.703195, "o", "                print(f\"{resource}: {quotas[resource]} (current: {usage})\")\r\n\u001b[?2004l\r"]
[11888.703252, "o", "\u001b[?2004h> "]
[11888.703333, "o", "    elif sub == 'remove':\r\n\u001b[?2004l\r"]
[11888.703391, "o", "\u001b[?2004h> "]
[11888.703449, "o", "        if len(rest) != 1:\r\n\u001b[?2004l\r"]
[11888.703506, "o", "\u001b[?2004h> "]
[11888.703668, "o", "            fail(\"quota <environment> remove <resource>\")\r\n\u001b[?2004l\r"]
[11888.703723, "o", "\u001b[?2004h> "]
[11888.70379, "o", "        resource = rest[0]\r\n\u001b[?2004l\r"]
[11888.703845, "o", "\u001b[?2004h> "]
[11888.70396, "o", "        validate_quota_resource(resource)\r\n\u001b[?2004l\r"]
[11888.704015, "o", "\u001b[?2004h> "]
[11888.704103, "o", "        assert_not_locked(env)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.704158, "o", "> "]
[11888.704244, "o", "        quotas = load_quotas(env)\r\n\u001b[?2004l\r"]
[11888.704303, "o", "\u001b[?2004h> "]
[11888.704407, "o", "        if resource not in quotas:\r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.704461, "o", "> "]
[11888.704616, "o", "            fail(f\"quota '{resource}' not set in {env}\")\r\n\u001b[?2004l\r"]
[11888.704671, "o", "\u001b[?2004h> "]
[11888.704737, "o", "        del quotas[resource]\r\n\u001b[?2004l\r"]
[11888.704791, "o", "\u001b[?2004h> "]
[11888.704872, "o", "        save_quotas(env, quotas)\r\n\u001b[?2004l\r"]
[11888.704927, "o", "\u001b[?2004h> "]
[11888.705065, "o", "        append_quota_remove_event(env, resource)\r\n\u001b[?2004l\r"]
[11888.705119, "o", "\u001b[?2004h> "]
[11888.705265, "o", "        print(f\"QUOTA {env}: removed {resource}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.705373, "o", "> "]
[11888.705504, "o", "    elif sub == '--check':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.705562, "o", "        quotas = load_quotas(env)\r\n\u001b[?2004l\rj\u001b[?2004h> "]
[11888.705645, "o", "        exceeded = 0\r\n\u001b[?2004l\r"]
[11888.705702, "o", "\u001b[?2004h> "]
[11888.705857, "o", "        for resource in quota_supported_resources():\r\n\u001b[?2004l\r"]
[11888.705912, "o", "\u001b[?2004h> "]
[11888.70601, "o", "            if resource in quotas:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.706164, "o", "                limit = quotas[resource]\r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.706219, "o", "> "]
[11888.706449, "o", "                usage = quota_current_usage(env, resource)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.706509, "o", "> "]
[11888.706588, "o", "                if usage > limit:\r\n\u001b[?2004l\r"]
[11888.706643, "o", "\u001b[?2004h> "]
[11888.706862, "o", "                    print(f\"{resource}: EXCEEDED ({usage}/{limit})\")\r\n\u001b[?2004l\r"]
[11888.706923, "o", "\u001b[?2004h> "]
[11888.707001, "o", "                    exceeded += 1\r\n\u001b[?2004l\r"]
[11888.707057, "o", "\u001b[?2004h> "]
[11888.707107, "o", "                else:\r\n\u001b[?2004l\r"]
[11888.707162, "o", "\u001b[?2004h> "]
[11888.707351, "o", "                    print(f\"{resource}: OK ({usage}/{limit})\")\r\n\u001b[?2004l\r"]
[11888.707385, "o", "\u001b[?2004h> "]
[11888.707463, "o", "        if exceeded:\r\n\u001b[?2004l\re"]
[11888.707518, "o", "\u001b[?2004h> "]
[11888.70766, "o", "            print(f\"{exceeded} quota(s) exceeded\")\r\n\u001b[?2004l\r"]
[11888.707716, "o", "\u001b[?2004h> "]
[11888.707771, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.707886, "o", "            print(\"All quotas OK\")\r\n\u001b[?2004l\r"]
[11888.707941, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[11888.707996, "o", "\u001b[?2004h> "]
[11888.708241, "o", "        fail(\"quota requires <environment> <set|get|list|remove|--check> [args]\")\r\n\u001b[?2004l\r"]
[11888.708304, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ru\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[11888.708367, "o", "\u001b[?2004h> "]
[11888.708482, "o", "old_config = \"\"\"def config_file(env):\r\n\u001b[?2004l\r"]
[11888.708537, "o", "\u001b[?2004h> "]
[11888.708668, "o", "    return os.path.join(CONFIG_DIR, f\"{env}.json\")\r\n\u001b[?2004l\r"]
[11888.708723, "o", "\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.708827, "o", "assert old_config in s\r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.708881, "o", "> "]
[11888.709016, "o", "s = s.replace(old_config, helpers + old_config)\r\n\u001b[?2004l\r"]
[11888.709072, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r_\u001b[?2004h> "]
[11888.709164, "o", "# 3. Deploy enforcement\r\n\u001b[?2004l\r"]
[11888.709219, "o", "\u001b[?2004h> "]
[11888.709336, "o", "old_deploy = \"\"\"    assert_not_locked(env)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.709394, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.709457, "o", "    if service:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.709644, "o", "        subset = transitive_deps(services, service)\r\n\u001b[?2004l\r"]
[11888.7097, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[11888.709755, "o", "\u001b[?2004h> "]
[11888.709875, "o", "        subset = set(services.keys())\r\n\u001b[?2004l\rx\u001b[?2004h> "]
[11888.709932, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.710063, "o", "    order = topo_order(services, subset)\r\n\u001b[?2004l\r"]
[11888.710119, "o", "\u001b[?2004h> "]
[11888.710172, "o", "    ensure_state()\r\n\u001b[?2004l\rw\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11888.710228, "o", "\u001b[?2004h> "]
[11888.710306, "o", "    if dry_run:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.710372, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.710508, "o", "new_deploy = \"\"\"    assert_not_locked(env)\r\n\u001b[?2004l\r"]
[11888.710563, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.710615, "o", "    if service:\r\n\u001b[?2004l\r\")\r\n \u001b[?2004h"]
[11888.71067, "o", "> "]
[11888.71083, "o", "        subset = transitive_deps(services, service)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11888.710887, "o", ">     else:\r\n\u001b[?2004l\rs"]
[11888.710964, "o", "\u001b[?2004h> "]
[11888.711055, "o", "        subset = set(services.keys())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11888.711112, "o", " \u001b[?2004h> "]
[11888.711237, "o", "    order = topo_order(services, subset)\r\n\u001b[?2004l\r"]
[11888.711301, "o", "\u001b[?2004h> "]
[11888.711365, "o", "    ensure_state()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11888.71142, "o", "\u001b[?2004h> "]
