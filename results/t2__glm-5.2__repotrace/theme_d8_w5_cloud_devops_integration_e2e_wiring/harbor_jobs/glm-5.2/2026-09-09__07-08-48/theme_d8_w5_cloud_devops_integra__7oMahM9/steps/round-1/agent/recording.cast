[4212.216767, "o", "def append_event(env, action, service, version, source_env=None, forced=False):$\r\n    ensure_state()$\r\n    ts = now_iso()$\r\n    line = f\"{ts} {action} {service} {version}\"$\r\n    if action == \"PROMOTE\" and source_env is not None:$\r\n        line += f\" from {source_env}\"$\r\n        if forced:$\r\n            line += \" (forced)\"$\r\n    line += \"\\n\"$\r\n    with open(event_file(env), \"a\") as f:$\r\n        f.write(line)$\r\ndef parse_opts(args, value_opts, flag_opts):$\r\n    values = {}$\r\n    flags = set()$\r\n    positionals = []$\r\n    i = 0$\r\n    while i < len(args):$\r\n        a = args[i]$\r\n        if a in value_opts:$\r\n            i += 1$\r\n            if i >= len(args):$\r\n                fail(f\"{a} requires a value\")$\r\n            values[a] = args[i]$\r\n        elif a in flag_opts:$\r\n            flags.add(a)$\r\n        elif a.startswith('--'):$\r\n            fail(f\"unknown option: {a}\")$\r\n        else:$\r\n            positionals.append(a)$\r\n        i += 1$\r\n    return values, flags, positionals$\r\n$\r\n"]
