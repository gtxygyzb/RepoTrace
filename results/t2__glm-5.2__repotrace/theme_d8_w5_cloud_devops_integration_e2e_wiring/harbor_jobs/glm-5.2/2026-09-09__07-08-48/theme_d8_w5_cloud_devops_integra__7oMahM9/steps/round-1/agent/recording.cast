[4916.135687, "o", "   484\t        sys.exit(1)\r\n   485\t\r\n   486\tdef cmd_status(args):\r\n   487\t    if len(args) > 1:\r\n   488\t        fail(\"status takes at most one environment argument\")\r\n   489\t\r\n   490"]
[4916.135768, "o", "\t    data = load_manifest()\r\n   491\t    _, envs = get_services(data)\r\n   492\t\r\n   493\t    if args:\r\n   494\t        env = args[0]\r\n   495\t        if env not in envs:\r\n   496\t            fail(f\"environment not found: {env}\")\r\n   497\t        state = load_deployment_state(env)\r\n   498\t        for s in sorted(state):\r\n   499\t            rec = state[s]\r\n   500\t            print(f\"{s}: {rec.get('version', '')} (deployed at {rec.get('deployed_at', '')})\")\r\n   501\t    else:\r\n   502\t        for env in sorted(envs):\r\n   503\t            state = load_deployment_state(env)\r\n   504\t            print(f\"{env}: {len(state)} services deployed\")\r\n   505\t\r\n"]
