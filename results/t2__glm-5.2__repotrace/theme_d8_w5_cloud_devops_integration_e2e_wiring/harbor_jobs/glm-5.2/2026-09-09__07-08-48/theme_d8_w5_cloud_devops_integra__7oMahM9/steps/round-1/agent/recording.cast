[11888.716641, "o", "\u001b[?2004h> "]
[11888.716696, "o", "# 6. Scale single enforcement\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.716877, "o", "old_scale_single = \"\"\"        if get_health_state(env, service) == \"unhealthy\" and count > replicas.get(service, 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.717017, "o", "            fail(f\"cannot scale up unhealthy service '{service}' in {env}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.717085, "o", "        assert_not_locked(env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.717174, "o", "        previous = replicas.get(service, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.717259, "o", "        replicas[service] = count\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r"]
[11888.717358, "o", "\u001b[?2004h> "]
[11888.71748, "o", "new_scale_single = \"\"\"        if get_health_state(env, service) == \"unhealthy\" and count > replicas.get(service, 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.71762, "o", "            fail(f\"cannot scale up unhealthy service '{service}' in {env}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.717687, "o", "        assert_not_locked(env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.717761, "o", "        quotas = load_quotas(env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.717874, "o", "        max_total_limit = quotas.get('max_total_replicas')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.717963, "o", "        if max_total_limit is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.718091, "o", "            current_total = sum(replicas.get(svc, 1) for svc in state)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.718225, "o", "            projected = current_total - replicas.get(service, 1) + count\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.71833, "o", "            if projected > max_total_limit:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.718561, "o", "                fail(f\"scaling {service} to {count} would exceed max_total_replicas quota ({projected}/{max_total_limit}) in {env}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.71865, "o", "        previous = replicas.get(service, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.718724, "o", "        replicas[service] = count\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.71878, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.718837, "o", "assert old_scale_single in s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.718915, "o", "s = s.replace(old_scale_single, new_scale_single)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.718972, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
