[4277.373267, "o", "\r\ndef print_tree(node, services, path, depth):\r\n    print(\"  \" * depth + node)\r\n    if node in path:\r\n        return\r\n    path = path | {node}\r\n    children = sorted([s for s in services if node in services[s].get('depends_on', [])])\r\n    for child in children:\r\n        print_tree(child, services, path, depth + 1)\r\n"]
[4277.37332, "o", "\r\ndef cmd_graph(args):\r\n    values, flags, positionals = parse_opts(args, {'--format'}, set())\r\n    if positionals:\r\n        fail(\"graph does not accept positional arguments\")\r\n\r\n    fmt = values.get('--format', 'text')\r\n"]
[4277.373428, "o", "    if fmt not in ('dot', 'text'):\r\n        fail(\"graph format must be dot or text\")\r\n\r\n    data = load_manifest()\r\n    services, _ = get_services(data)\r\n\r\n    if fmt == 'dot':\r\n        print(\"digraph pipeline {\")\r\n        for dep in sorted(services):\r\n            dependents = sorted([s for s in services if dep in services[s].get('depends_on', [])])\r\n            for dependent in dependents:\r\n                print(f'  \"{dep}\" -> \"{dependent}\";')\r\n        print(\"}\")\r\n    else:\r\n        roots = sorted([s for s in services if not services[s].get('depends_on')])\r\n        for root in roots:\r\n            print_tree(root, services, set(), 0)\r\n\r\ndef cmd_bump(args):\r\n    if len(args) != 2:\r\n        fail(\"bump requires <service> <major|minor|patch>\")\r\n\r\n    service, level = args\r\n    if level not in ('major', 'minor', 'patch'):\r\n        fail(\"bump level must be major, minor, or patch\")\r\n"]
[4277.3735, "o", "\r\n    data = load_manifest()\r\n    services = data.get('services')\r\n    if not isinstance(services, dict) or service not in services:\r\n        fail(f\"service not found: {service}\")\r\n\r\n    old = services[service].get('version')\r\n    sv = parse_semver(old)\r\n    if sv is None:\r\n        fail(f\"service {service} has invalid version: {old}\")\r\n\r\n    major, minor, patch = sv\r\n    if level == 'major':\r\n        new = f\"{major + 1}.0.0\"\r\n    elif level == 'minor':\r\n"]
[4277.373563, "o", "        new = f\"{major}.{minor + 1}.0\"\r\n    else:\r\n        new = f\"{major}.{minor}.{patch + 1}\"\r\n\r\n    services[service]['version'] = new\r\n    with open(MANIFEST_PATH, 'w') as f:\r\n        yaml.safe_dump(data, f, sort_keys=False)\r\n    print(f\"BUMP {service} {old} -> {new}\")\r\n\r\ndef snapshot_file(env):\r\n    return os.path.join(SNAPSHOTS_DIR, f\"{env}.json\")\r\n\r\ndef load_snapshots(env):\r\n    return load_json(snapshot_file(env), [])\r\n"]
[4277.373622, "o", "\r\ndef save_snapshots(env, snapshots):\r\n    save_json(snapshot_file(env), snapshots)\r\n\r\ndef cmd_snapshot(args):\r\n    values, flags, positionals = parse_opts(args, set(), {\"--list\"})\r\n    if len(positionals) != 1:\r\n"]
