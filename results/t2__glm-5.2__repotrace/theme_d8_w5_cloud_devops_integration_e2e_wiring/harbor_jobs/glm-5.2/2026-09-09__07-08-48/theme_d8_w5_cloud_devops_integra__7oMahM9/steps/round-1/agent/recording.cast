[11447.394313, "o", "   120\tdef find_cycle(services):\r\n   121\t    visited = {}\r\n   122\t    stack = []\r\n   123\t\r\n   124\t    def dfs(node):\r\n   125\t        visited[node] = 1"]
[11447.39443, "o", "\r\n   126\t        stack.append(node)\r\n   127\t        for dep in services[node].get('depends_on', []):\r\n   128\t            if dep not in services:\r\n   129\t                continue\r\n   130\t            if visited.get(dep) == 1:\r\n   131\t                idx = stack.index(dep)\r\n   132\t                return stack[idx:] + [dep]\r\n   133"]
[11447.394515, "o", "\t            if visited.get(dep) is None:\r\n   134\t                res = dfs(dep)\r\n   135\t                if res:\r\n   136\t                    return res\r\n   137\t        stack.pop()\r\n   138\t        visited[node] = 2\r\n   139\t        return None\r\n   140\t\r\n   141\t    for n in sorted(services):\r\n   142\t        if visited.get(n) is None:\r\n   143\t            res = dfs(n)\r\n   144\t            if res:\r\n   145\t                return res\r\n   146\t    return None\r\n   147\t\r\n   148\tdef get_services(data):\r\n   149\t    try:\r\n   150\t        validate_manifest(data)\r\n   151\t    except ValueError as e:\r\n   152\t        fail(str(e))\r\n   153\t    return data['services'], data['environments']\r\n"]
[11447.39458, "o", "   154\t\r\n   155\tdef topo_order(services, subset=None):\r\n   156\t    if subset is None:\r\n   157\t        subset = set(services.keys())\r\n   158\t    subset = set(subset)\r\n   159\t\r\n   160\t    in_degree = {s: 0 for s in subset}\r\n   161\t    adj = {s: [] for s in subset}\r\n   162\t\r\n"]
[11447.39465, "o", "   163\t    for s in subset:\r\n   164\t        for dep in services[s].get('depends_on', []):\r\n   165\t            if dep in subset:\r\n   166\t                adj[dep].append(s)\r\n   167\t                in_degree[s] += 1\r\n   168\t\r\n   169\t    order = []\r\n   170\t    available = sorted([s for s in subset if in_degree[s] == 0])\r\n   171\t    while available:\r\n   172\t        next_available = []\r\n"]
