[14124.689112, "o", "\u001b[32m\u001b[K555\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        usage = \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_current_usage(env, resource)\r\n\u001b[32m\u001b[K556\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if resource in \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks:\r\n\u001b[32m\u001b[K557\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            print(f\"{resource}: {\u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks[resource]} (current: {usage})\")\r\n\u001b[32m\u001b[K560\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kelif\u001b[m\u001b[K sub == 'list':\r\n"]
[14124.689168, "o", "\u001b[32m\u001b[K561\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks = load_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks(env)\r\n\u001b[32m\u001b[K562\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        for resource in \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_supported_resources():\r\n\u001b[32m\u001b[K563\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if resource in \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks:\r\n\u001b[32m\u001b[K564\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                usage = \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_current_usage(env, resource)\r\n\u001b[32m\u001b[K565\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                print(f\"{resource}: {\u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks[resource]} (current: {usage})\")\r\n\u001b[32m\u001b[K566\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kelif\u001b[m\u001b[K sub == 'remove':\r\n"]
[14124.68922, "o", "\u001b[32m\u001b[K568\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            fail(\"\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K <environment> remove <resource>\")\r\n\u001b[32m\u001b[K570\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        validate_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_resource(resource)\r\n\u001b[32m\u001b[K571\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_not_\u001b[01;31m\u001b[Klock\u001b[m\u001b[Ked(env)\r\n\u001b[32m\u001b[K572\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks = load_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks(env)\r\n"]
[14124.689275, "o", "\u001b[32m\u001b[K573\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if resource not in \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks:\r\n\u001b[32m\u001b[K574\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            fail(f\"\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K '{resource}' not set in {env}\")\r\n\u001b[32m\u001b[K575\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        del \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks[resource]\r\n\u001b[32m\u001b[K576\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        save_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks(env, \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks)\r\n\u001b[32m\u001b[K577\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        append_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_remove_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K(env, resource)\r\n"]
[14124.689341, "o", "\u001b[32m\u001b[K579\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kelif\u001b[m\u001b[K sub == '--check':\r\n\u001b[32m\u001b[K580\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks = load_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks(env)\r\n\u001b[32m\u001b[K582\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        for resource in \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_supported_resources():\r\n\u001b[32m\u001b[K583\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            if resource in \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks:\r\n\u001b[32m\u001b[K584\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                limit = \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks[resource]\r\n"]
[14124.689395, "o", "\u001b[32m\u001b[K585\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                usage = \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_current_usage(env, resource)\r\n\u001b[32m\u001b[K592\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            print(f\"{exceeded} \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K(s) exceeded\")\r\n\u001b[32m\u001b[K594\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            print(\"All \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks OK\")\r\n\u001b[32m\u001b[K596\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fail(\"\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K requires <environment> <set|get|list|remove|--check> [args]\")\r\n"]
[14124.689449, "o", "\u001b[32m\u001b[K598\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K_file(env):\r\n\u001b[32m\u001b[K601\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef load\u001b[m\u001b[K_\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K(env):\r\n\u001b[32m\u001b[K602\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    return load_json(\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K_file(env), {})\r\n\u001b[32m\u001b[K604\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef save\u001b[m\u001b[K_\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K(env, cfg):\r\n\u001b[32m\u001b[K605\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    save_json(\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K_file(env), cfg)\r\n"]
[14124.6895, "o", "\u001b[32m\u001b[K607\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef validate_\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K_key(key):\r\n\u001b[32m\u001b[K611\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef append_\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K_set_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K(env, key, value):\r\n\u001b[32m\u001b[K613\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kevent\u001b[m\u001b[K = {\r\n\u001b[32m\u001b[K622\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    with open(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K_file(env), \"a\") as f:\r\n\u001b[32m\u001b[K623\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f.write(json.dumps(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K) + \"\\n\")\r\n"]
[14124.689551, "o", "\u001b[32m\u001b[K625\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef append_\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K_delete_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K(env, key):\r\n\u001b[32m\u001b[K627\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kevent\u001b[m\u001b[K = {\r\n\u001b[32m\u001b[K635\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    with open(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K_file(env), \"a\") as f:\r\n\u001b[32m\u001b[K636\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f.write(json.dumps(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K) + \"\\n\")\r\n"]
[14124.689605, "o", "\u001b[32m\u001b[K639\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kevent\u001b[m\u001b[Ks = load_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[Ks(env)\r\n\u001b[32m\u001b[K642\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        for ev in reversed(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[Ks):\r\n"]
[14124.689661, "o", "\u001b[32m\u001b[K645\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fail(f\"version not found in \u001b[01;31m\u001b[Khistory\u001b[m\u001b[K for {service}\")\r\n\u001b[32m\u001b[K648\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    for idx, ev in enumerate(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[Ks):\r\n\u001b[32m\u001b[K660\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    for ev in reversed(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[Ks[:current_idx]):\r\n\u001b[32m\u001b[K677\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kelif\u001b[m\u001b[K a in flag_opts:\r\n\u001b[32m\u001b[K679\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kelif\u001b[m\u001b[K a.startswith('--'):\r\n"]
