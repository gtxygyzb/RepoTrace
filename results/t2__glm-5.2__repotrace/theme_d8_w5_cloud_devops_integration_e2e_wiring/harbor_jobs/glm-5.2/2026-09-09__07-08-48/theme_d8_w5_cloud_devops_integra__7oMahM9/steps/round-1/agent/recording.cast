[9619.212188, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[9619.21226, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.212545, "o", "# Add cmd_health function before cmd_diff or after cmd_rollback? Insert before valid_version\r\n\u001b[?2004l\r\u001b[?2004h"]
[9619.212615, "o", "> "]
[9619.212681, "o", "health_cmd = '''def cmd_health(args):\r\n\u001b[?2004l\r"]
[9619.212747, "o", "\u001b[?2004h>     if not args:\r\n\u001b[?2004l\r"]
[9619.212816, "o", "\u001b[?2004h> "]
[9619.212924, "o", "        fail(\"health requires <environment>\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[9619.212999, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.213065, "o", "    env = args[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.213146, "o", "    data = load_manifest()\r\n\u001b[?2004l\r"]
[9619.213219, "o", "\u001b[?2004h> "]
[9619.213308, "o", "    services, envs = get_services(data)\r\n\u001b[?2004l\r"]
[9619.213344, "o", "\u001b[?2004h> "]
[9619.2136, "o", "    if env not in envs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.213634, "o", "        fail(f\"unknown environment '{env}'\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.213723, "o", "    if len(args) == 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.213792, "o", "        ensure_state()\r\n\u001b[?2004l\r"]
[9619.21385, "o", "\u001b[?2004h> "]
[9619.213943, "o", "        state = load_deployment_state(env)\r\n\u001b[?2004l\r"]
[9619.214, "o", "\u001b[?2004h> "]
[9619.214063, "o", "        for s in sorted(state):\r\n\u001b[?2004l\r"]
[9619.214119, "o", "\u001b[?2004h> "]
[9619.214247, "o", "            print(f\"{s}: {get_health_state(env, s)}\")\r\n\u001b[?2004l\r"]
[9619.214321, "o", "\u001b[?2004h>         return\r\n\u001b[?2004l\r"]
[9619.214379, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.21453, "o", "    if len(args) >= 3 and args[1] == \"--filter\":\r\n\u001b[?2004l\r"]
[9619.214586, "o", "\u001b[?2004h> "]
[9619.214648, "o", "        if len(args) != 3:\r\n\u001b[?2004l\r\u001b[?2004h"]
[9619.21471, "o", "> "]
[9619.214836, "o", "            fail(\"health <environment> --filter <state>\")\r\n\u001b[?2004l\r"]
[9619.214893, "o", "\u001b[?2004h> "]
[9619.214961, "o", "        state = args[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.215091, "o", "        if not is_valid_health_state(state):\r\n\u001b[?2004l\r"]
[9619.215148, "o", "\u001b[?2004h> "]
[9619.215402, "o", "            fail(f\"invalid health state '{state}' (must be healthy, unhealthy, or degraded)\")\r\n\u001b[?2004l\r"]
[9619.215461, "o", "\u001b[?2004h> "]
[9619.215518, "o", "        ensure_state()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.215662, "o", "        dep_state = load_deployment_state(env)\r\n\u001b[?2004l\r"]
[9619.215718, "o", "\u001b[?2004h> "]
[9619.215794, "o", "        for s in sorted(dep_state):\r\n\u001b[?2004l\r"]
[9619.21585, "o", "\u001b[?2004h> "]
[9619.215944, "o", "            hs = get_health_state(env, s)\r\n\u001b[?2004l\r"]
[9619.216, "o", "\u001b[?2004h> "]
[9619.216056, "o", "            if hs == state:\r\n\u001b[?2004l\r"]
[9619.216117, "o", "\u001b[?2004h> "]
[9619.216187, "o", "                print(f\"{s}: {hs}\")\r\n\u001b[?2004l\r"]
[9619.216243, "o", "\u001b[?2004h> "]
[9619.216304, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[9619.216361, "o", "\u001b[?2004h> "]
[9619.216418, "o", "    if len(args) < 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.216588, "o", "        fail(\"health requires <environment> <service>\")\r\n\u001b[?2004l\r"]
[9619.216645, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.216714, "o", "    service = args[1]\r\n\u001b[?2004l\r"]
[9619.21677, "o", "\u001b[?2004h> "]
[9619.216836, "o", "    if service not in services:\r\n\u001b[?2004l\r"]
[9619.216898, "o", "\u001b[?2004h> "]
[9619.216994, "o", "        fail(f\"unknown service '{service}'\")\r\n\u001b[?2004l\r"]
[9619.217056, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.217124, "o", "    if len(args) == 2:\r\n\u001b[?2004l\r"]
[9619.21718, "o", "\u001b[?2004h> "]
[9619.217236, "o", "        ensure_state()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.217389, "o", "        state = load_deployment_state(env)\r\n\u001b[?2004l\r"]
[9619.217476, "o", "\u001b[?2004h> "]
[9619.21754, "o", "        if service not in state:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.217707, "o", "            fail(f\"{service} is not deployed to {env}\")\r\n\u001b[?2004l\r"]
[9619.217763, "o", "\u001b[?2004h> "]
[9619.21791, "o", "        print(f\"{service}: {get_health_state(env, service)}\")\r\n\u001b[?2004l\r"]
[9619.217966, "o", "\u001b[?2004h> "]
[9619.218021, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[9619.218082, "o", "\u001b[?2004h> "]
[9619.218174, "o", "    if len(args) < 4 or args[2] != \"set\":\r\n\u001b[?2004l\r"]
[9619.21822, "o", "\u001b[?2004h> "]
[9619.218353, "o", "        fail(\"invalid health arguments\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[9619.218429, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[9619.218492, "o", "    if len(args) != 5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.218668, "o", "        fail(\"health <environment> <service> set <state>\")\r\n\u001b[?2004l\r"]
[9619.218737, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.218801, "o", "    new_state = args[4]\r\n\u001b[?2004l\r"]
[9619.218869, "o", "\u001b[?2004h> "]
[9619.218959, "o", "    if not is_valid_health_state(new_state):\r\n\u001b[?2004l\r"]
[9619.219018, "o", "\u001b[?2004h> "]
[9619.219269, "o", "        fail(f\"invalid health state '{new_state}' (must be healthy, unhealthy, or degraded)\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[9619.219373, "o", "\u001b[?2004h>     ensure_state()\r\n\u001b[?2004l\r"]
[9619.219453, "o", "\u001b[?2004h> "]
[9619.219538, "o", "    state = load_deployment_state(env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.219643, "o", "    if service not in state:\r\n\u001b[?2004l\r\u001b[?2004h"]
[9619.21972, "o", "> "]
[9619.219797, "o", "        fail(f\"{service} is not deployed to {env}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.219873, "o", "    assert_not_locked(env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.219951, "o", "    previous = get_health_state(env, service)\r\n\u001b[?2004l\r"]
[9619.220032, "o", "\u001b[?2004h>     health = load_health(env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.22011, "o", "    health[service] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.22019, "o", "        \"state\": new_state,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.22031, "o", "        \"state_snapshot\": state.get(service),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[9619.22039, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     save_health(env, health)\r\n\u001b[?2004l\r"]
[9619.220471, "o", "\u001b[?2004h> "]
[9619.220539, "o", "    append_health_event(env, service, new_state, previous)\r\n\u001b[?2004l\r"]
[9619.220599, "o", "\u001b[?2004h> "]
[9619.220688, "o", "    print(f\"HEALTH {env}/{service} set to {new_state} (was {previous})\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[9619.220752, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[9619.220809, "o", "\u001b[?2004h> "]
[9619.220937, "o", "s = s.replace(\"def valid_version(v):\\n\", health_cmd + \"def valid_version(v):\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
