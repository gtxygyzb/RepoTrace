[3403.991482, "o", "> "]
[3403.991536, "o", "    (\r\n\u001b[?2004l\r"]
[3403.991592, "o", "\u001b[?2004h> "]
[3403.991824, "o", "        \"\"\"    elif cmd == 'graph':\r\n\u001b[?2004l\r"]
[3403.991873, "o", "\u001b[?2004h> "]
[3403.992022, "o", "        cmd_graph(args)\r\n\u001b[?2004l\r"]
[3403.992068, "o", "\u001b[?2004h> "]
