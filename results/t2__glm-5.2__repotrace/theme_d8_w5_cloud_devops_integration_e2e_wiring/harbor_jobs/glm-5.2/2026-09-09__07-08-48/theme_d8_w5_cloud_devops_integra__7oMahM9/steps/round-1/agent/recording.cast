[7468.540581, "o", "     1\t#!/usr/bin/env bash\r\n     2\tset -euo pipefail\r\n     3\ttmp_script=\"$(mktemp)\"\r\n     4\ttrap 'rm -f \"$tmp_script\"' EXIT\r\n"]
[7468.540699, "o", "     5\tcat > \"$tmp_script\" <<'PY'\r\n     6\timport sys\r\n     7\timport os\r\n     8\timport json\r\n     9\timport time\r\n    10\timport yaml\r\n    11\timport re\r\n    12\tfrom datetime import datetime, timezone\r\n    13\t\r\n    14\tAPP_DIR = '/app'\r\n    15\tMANIFEST_PATH = '/app/pipeline.yaml'\r\n    16\tSTATE_DIR = '/app/.pipeline'\r\n    17\tTEST_RESULTS_PATH = os.path.join(STATE_DIR, 'test_results.json')\r\n    18\tDEPLOYMENTS_DIR = os.path.join(STATE_DIR, 'deployments')\r\n    19\tEVENTS_DIR = os.path.join(STATE_DIR, 'events')\r\n    20\tSNAPSHOTS_DIR = os.path.join(STATE_DIR, 'snapshots')\r\n    21\tLOCK_DIR = os.path.join(STATE_DIR, 'locks')\r\n    22\tCONFIG_DIR = os.path.join(STATE_DIR, 'config')\r\n    23\t\r\n    24\t"]
[7468.540781, "o", "SERVICE_FIELDS = ['version', 'path', 'build_cmd', 'test_cmd', 'port', 'depends_on', 'health_endpoint']\r\n    25\tENV_FIELDS = ['deploy_target', 'health_check_port', 'max_replicas']\r\n    26\t\r\n    27\tdef ensure_state():\r\n    28\t    os.makedirs(STATE_DIR, exist_ok=True)\r\n    29\t    os.makedirs(DEPLOYMENTS_DIR, exist_ok=True)\r\n    30\t    os.makedirs(EVENTS_DIR, exist_ok=True)\r\n    31\t    os.makedirs(SNAPSHOTS_DIR, exist_ok=True)\r\n    32\t    os.makedirs(LOCK_DIR, exist_ok=True)\r\n    33\t    os.makedirs(CONFIG_DIR, exist_ok=True)\r\n    34\t\r\n    35\tdef fail(msg, code=1):\r\n    36\t    print(f\"ERROR: {msg}\")"]
[7468.540848, "o", "\r\n    37\t    sys.exit(code)\r\n    38\t\r\n    39\tdef now_iso():\r\n    40\t    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n    41\t\r\n    42\tdef load_json(path, default):\r\n    43\t    try:\r\n    44\t        with open(path) as f:\r\n    45\t            return json.load(f)\r\n    46\t    except FileNotFoundError:"]
[7468.540916, "o", "\r\n    47\t        return default\r\n    48\t    except json.JSONDecodeError as e:\r\n    49\t        fail(f\"state error in {path}: {e}\")\r\n    50\t\r\n    51\tdef save_json(path, data):\r\n    52\t    os.makedirs(os.path.dirname(path), exist_ok=True)\r\n    53\t    with open(path, 'w') as f:\r\n    54\t        json.dump(data, f, indent=2, sort_keys=True)\r\n    55\t\r\n"]
[7468.540976, "o", "    56\tdef load_manifest():\r\n    57\t    try:\r\n    58\t        with open(MANIFEST_PATH) as f:\r\n    59\t            data = yaml.safe_load(f)\r\n    60\t    except FileNotFoundError:\r\n    61\t        fail(\"manifest not found\")\r\n    62\t    except yaml.YAMLError as e:\r\n    63\t        fail(f\"YAML syntax error: {e}\")\r\n    64\t    if not isinstance(data, dict):\r\n"]
[7468.541043, "o", "    65\t        fail(\"manifest must be a mapping\")\r\n    66\t    return data\r\n    67\t\r\n    68\tdef validate_manifest(data):\r\n    69\t    if not isinstance(data, dict):\r\n    70\t        raise ValueError(\"manifest must be a mapping\")\r\n    71\t\r\n    72\t    services = data.get('services')\r\n    73\t    if not isinstance(services, dict) or not services:\r\n    74\t        raise ValueError(\"manifest missing services\")\r\n"]
[7468.541109, "o", "    75\t\r\n    76\t    environments = data.get('environments')\r\n    77\t    if not isinstance(environments, dict) or not environments:\r\n    78\t        raise ValueError(\"manifest missing environments\")\r\n    79\t\r\n    80\t    for env_name, env in environments.items():\r\n    81\t        if not isinstance(env, dict):\r\n    82\t            raise ValueError(f\"environment {env_name} must be a mapping\")\r\n    83\t        for field in ENV_FIELDS:\r\n    84\t"]
[7468.54118, "o", "            if field not in env:\r\n    85\t                raise ValueError(f\"environment {env_name} missing required field: {field}\")\r\n    86\t\r\n    87\t    for name, svc in services.items():\r\n    88\t        if not isinstance(svc, dict):\r\n    89\t            raise ValueError(f\"service {name} must be a mapping\")\r\n"]
[7468.541246, "o", "    90\t        for field in SERVICE_FIELDS:\r\n    91\t            if field not in svc:\r\n    92\t                raise ValueError(f\"service {name} missing required field: {field}\")\r\n    93\t        if not isinstance(svc['depends_on'], list):\r\n    94\t            raise ValueError(f\"service {name} has invalid depends_on: must be a list\")\r\n    95\t        for dep in svc['depends_on']:\r\n    96\t            if dep not in services:\r\n    97\t                raise ValueError(f\"service {name} depends on undefined service: {dep}\")\r\n    98\t        if not valid_version(svc.get('version')):\r\n    99\t            raise ValueError(f\"service {name} has invalid version: expected N.N.N\")\r\n   100\t\r\n   101\t    port_map = {}\r\n   102\t    for name, svc in services.items():\r\n   103\t        port = svc['port']\r\n   104\t        if port in port_map:\r\n   105\t"]
[7468.541349, "o", "            raise ValueError(f\"duplicate port assignment: {port}\")\r\n   106\t        port_map[port] = name\r\n   107\t\r\n   108\t    cycle = find_cycle(services)\r\n   109\t    if cycle:\r\n   110\t        raise ValueError(f\"circular dependency detected: {' -> '.join(cycle)}\")\r\n"]
[7468.541417, "o", "   111\t\r\n   112\t    return True\r\n   113\t\r\n   114\tdef find_cycle(services):\r\n   115\t    visited = {}\r\n   116\t    stack = []\r\n   117\t\r\n   118\t    def dfs(node):\r\n   119\t        visited[node] = 1\r\n   120\t        stack.append(node)\r\n   121\t        for dep in services[node].get('depends_on', []):\r\n   122\t            if dep not in services:\r\n   123\t                continue\r\n   124\t            if visited.get(dep) == 1:\r\n   125\t                idx = stack.index(dep)\r\n   126\t                return stack[idx:] + [dep]\r\n   127\t            if visited.get(dep) is None:\r\n   128\t                res = dfs(dep)\r\n   129\t                if res:\r\n   130"]
[7468.541487, "o", "\t                    return res\r\n   131\t        stack.pop()\r\n   132\t        visited[node] = 2\r\n   133\t        return None\r\n   134\t\r\n"]
[7468.541551, "o", "   135\t    for n in sorted(services):\r\n   136\t        if visited.get(n) is None:\r\n   137\t            res = dfs(n)\r\n   138\t            if res:\r\n   139\t                return res\r\n   140\t    return None\r\n   141\t"]
[7468.541593, "o", "\r\n   142\tdef get_services(data):\r\n   143\t    try:\r\n   144\t        validate_manifest(data)\r\n   145\t    except ValueError as e:\r\n   146\t        fail(str(e))\r\n   147\t    return data['services'], data['environments']\r\n   148\t\r\n   149\tdef topo_order(services, subset=None):\r\n   150\t    if subset is None:\r\n   151\t        subset = set(services.keys())\r\n   152\t    subset = set(subset)\r\n   153\t\r\n"]
[7468.54168, "o", "   154\t    in_degree = {s: 0 for s in subset}\r\n   155\t    adj = {s: [] for s in subset}\r\n   156\t\r\n   157\t    for s in subset:\r\n   158\t        for dep in services[s].get('depends_on', []):\r\n   159\t            if dep in subset:\r\n   160\t                adj[dep].append(s)\r\n   161\t                in_degree[s] += 1\r\n   162\t\r\n   163\t    order = []\r\n   164\t    available = sorted([s for s in subset if in_degree[s] == 0])\r\n   165\t    while available:\r\n   166\t        next_available = []\r\n   167\t        for s in available:\r\n"]
[7468.54174, "o", "   168\t            order.append(s)\r\n   169\t            for dependent in sorted(adj[s]):\r\n   170\t                in_degree[dependent] -= 1\r\n   171\t                if in_degree[dependent] == 0:\r\n   172\t                    next_available.append(dependent)\r\n   173\t        available = sorted(next_available)\r\n   174\t\r\n   175\t    if len(order) != len(subset):\r\n   176\t        fail(\"circular dependency detected\")\r\n   177\t    return order\r\n   178\t\r\n"]
[7468.541812, "o", "   179\tdef build_waves(services, subset):\r\n   180\t    subset = set(subset)\r\n   181\t\r\n   182\t    in_degree = {s: 0 for s in subset}\r\n   183\t    adj = {s: [] for s in subset}\r\n   184\t\r\n"]
[7468.541883, "o", "   185\t    for s in subset:\r\n   186\t        for dep in services[s].get('depends_on', []):\r\n   187\t            if dep in subset:\r\n   188\t                adj[dep].append(s)\r\n   189\t                in_degree[s] += 1\r\n   190\t\r\n   191\t    waves = []\r\n   192\t    available = sorted([s for s in subset if in_degree[s] == 0])\r\n   193\t    while available:\r\n   194\t        waves.append(available)\r\n   195\t        next_available = []\r\n   196\t        for s in available:\r\n   197\t            for dependent in sorted(adj[s]):\r\n   198\t                in_degree[dependent] -= 1\r\n   199\t                if in_degree[dependent] == 0:\r\n   200\t                    next_available.append(dependent)\r\n   201\t        available = sorted(next_available)\r\n"]
[7468.541953, "o", "   202\t\r\n   203\t    if sum(len(w) for w in waves) != len(subset):\r\n   204\t        fail(\"circular dependency detected\")\r\n   205\t    return waves\r\n   206\t\r\n   207\tdef transitive_deps(services, name):\r\n   208\t    if name not in services:\r\n   209\t        fail(f\"service not found: {name}\")\r\n   210\t    result = set()\r\n   211"]
[7468.542021, "o", "\t    stack = [name]\r\n   212\t    while stack:\r\n   213\t        s = stack.pop()\r\n   214\t        if s not in result:\r\n   215\t            result.add(s)\r\n"]
[7468.542122, "o", "   216\t            for dep in services[s].get('depends_on', []):\r\n   217\t                if dep not in services:\r\n   218\t                    fail(f\"service {s} depends on undefined service: {dep}\")\r\n   219\t                stack.append(dep)\r\n   220\t    return result\r\n"]
