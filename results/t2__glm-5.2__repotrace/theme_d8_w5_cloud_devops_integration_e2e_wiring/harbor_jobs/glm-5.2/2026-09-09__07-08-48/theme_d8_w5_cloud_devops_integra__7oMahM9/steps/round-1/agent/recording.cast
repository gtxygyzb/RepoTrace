[13273.806341, "o", "            break\r\n\r\n        if max_services_limit is not None and s not in state:\r\n            current = len(state)\r\n            if current + 1 > max_services_limit:\r\n                fail(f\"deploying {s} would exceed max_services quota ({current + 1}/{max_services_limit}) in {env}\")\r\n\r\n        state[s] = {\"version\": version, \"deployed_at\": now_iso()}\r\n        replicas[s] = 1\r\n"]
[13273.8064, "o", "        deployed_events.append((s, version))\r\n        print(f\"DEPLOY {s} -> {env} OK\")\r\n\r\n    save_deployment_state(env, state)\r\n    save_replicas(env, replicas)\r\n    for s, version in deployed_events:\r\n        reset_health(env, s)\r\n    for s, version in deployed_events:\r\n        append_event(env, \"DEPLOY\", s, version)\r\n    if any_fail:\r\n        sys.exit(1)\r\n\r\n"]
