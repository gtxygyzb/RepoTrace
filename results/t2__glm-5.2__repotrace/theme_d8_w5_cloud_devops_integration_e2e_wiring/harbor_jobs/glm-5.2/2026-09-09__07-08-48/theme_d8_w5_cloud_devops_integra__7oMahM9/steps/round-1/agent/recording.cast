[11888.720488, "o", "            projected = count * len(state)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.720587, "o", "            if projected > max_total_limit:\r\n\u001b[?2004l\r"]
[11888.720642, "o", "\u001b[?2004h> "]
[11888.720829, "o", "                fail(f\"scaling all to {count} would exceed max_total_replicas quota ({projected}/{max_total_limit}) in {env}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.7209, "o", "        for s in sorted(state):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.720984, "o", "            previous = replicas.get(s, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.72104, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
