[3540.723855, "o", "   368\t            any_fail = True\r\n   369\t            if fail_fast:\r\n   370\t                break\r\n   371\t\r\n   372\t    save_json(TEST_RESULTS_PATH, results)\r\n   373\t    if any_fail:\r\n   374\t        sys.exit(1)\r\n   375\t\r\n"]
[3540.724078, "o", "   376\tdef cmd_deploy(args):\r\n   377\t    values, flags, positionals = parse_opts(args, {'--service'}, {'--dry-run'})\r\n   378\t    if len(positionals) != 1:\r\n   379\t        fail(\"deploy requires an environment\")\r\n   380\t\r\n   381\t    env = positionals[0]\r\n   382\t    service = values.get('--service')\r\n   383\t    dry_run = '--dry-run' in flags\r\n   384\t\r\n   385\t    data = load_manifest()\r\n   386\t    services, envs = get_services(data)\r\n   387\t\r\n   388\t    if env not in envs:\r\n   389\t        fail(f\"environment not found: {env}\")\r\n   390\t\r\n   391\t    if service:\r\n   392\t        subset = transitive_deps(services, service)\r\n   393\t    else:\r\n   394\t        subset = set(services.keys())\r\n   395\t\r\n   396\t    order = topo_order(services, subset)\r\n   397\t    ensure_state()\r\n   398\t\r\n   399\t    if dry_run:\r\n   400\t        print(f\"DRY-RUN deploy to {env}:\")\r\n   401\t        for s in order:\r\n   402\t            print(f\"  Would deploy {s}\")\r\n   403\t        return\r\n   404\t\r\n   405\t    test_results = load_json(TEST_RESULTS_PATH, {"]
[3540.724214, "o", "})\r\n   406\t    state = load_deployment_state(env)\r\n   407\t    any_fail = False\r\n   408\t    deployed_events = []\r\n   409\t\r\n   410\t    for s in order:\r\n   411\t        rec = test_results.get(s)\r\n   412\t        if not rec or not rec.get(\"pass\"):\r\n   413\t            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n   414\t            any_fail = True\r\n   415\t            break\r\n   416\t\r\n   417\t        version = read_artifact(services[s])\r\n   418\t        if version is None:\r\n   419\t            print(f\"DEPLOY {s} -> {env} FAIL: tests not passing\")\r\n   420\t            any_fail = True\r\n   421\t            break\r\n   422\t\r\n   423\t        state[s] = {\"version\": version, \"deployed_at\": now_iso()}\r\n   424\t        deployed_events.append((s, version))\r\n   425\t        print(f\"DEPLOY {s} -> {env} OK\")\r\n"]
