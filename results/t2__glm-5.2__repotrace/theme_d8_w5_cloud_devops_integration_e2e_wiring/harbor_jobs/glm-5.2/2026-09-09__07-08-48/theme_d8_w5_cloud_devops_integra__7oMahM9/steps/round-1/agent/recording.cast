[4820.045772, "o", "\tSERVICE_FIELDS = ['version', 'path', 'build_cmd', 'test_cmd', 'port', 'depends_on', 'health_endpoint']\r\n    20\tENV_FIELDS = ['deploy_target', 'health_check_port', 'max_replicas']\r\n    21\t\r\n    22\tdef ensure_state():\r\n    23\t    os.makedirs(STATE_DIR, exist_ok=True)\r\n    24\t    os.makedirs(DEPLOYMENTS_DIR, exist_ok=True)\r\n    25\t    os.makedirs(EVENTS_DIR, exist_ok=True)\r\n    26\t    os.makedirs(SNAPSHOTS_DIR, exist_ok=True)\r\n    27\t\r\n    28\tdef fail(msg, code=1):\r\n    29\t    print(f\"ERROR: {msg}\")\r\n    30\t    sys.exit(code)\r\n    31\t\r\n    32\tdef now_iso():\r\n    33\t    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\r\n    34\t\r\n    35\tdef load_json(path, default):\r\n    36\t    try:\r\n    37\t        with open(path) as f:\r\n    38\t            return json.load(f)\r\n    39\t    except FileNotFoundError:\r\n    40\t        return default\r\n    41\t    except json.JSONDecodeError as e:\r\n"]
