[1131.618582, "o", "    print(\"VALID\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[1131.618646, "o", "def cmd_order(args):\r\n\u001b[?2004l\r\u001b[?2004h> "]
