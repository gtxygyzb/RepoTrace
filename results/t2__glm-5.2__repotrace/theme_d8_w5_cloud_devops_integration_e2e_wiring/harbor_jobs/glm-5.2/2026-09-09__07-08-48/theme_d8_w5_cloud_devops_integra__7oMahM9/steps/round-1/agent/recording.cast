[14124.688247, "o", "\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef load\u001b[m\u001b[K_\u001b[01;31m\u001b[Klock\u001b[m\u001b[K(env):\r\n\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    return load_json(\u001b[01;31m\u001b[Klock\u001b[m\u001b[K_file(env), None)\r\n\u001b[32m\u001b[K405\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef save\u001b[m\u001b[K_\u001b[01;31m\u001b[Klock\u001b[m\u001b[K(env, reason):\r\n\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    existing = load_\u001b[01;31m\u001b[Klock\u001b[m\u001b[K(env)\r\n\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Klock\u001b[m\u001b[Ked_since = existing.get('\u001b[01;31m\u001b[Klock\u001b[m\u001b[Ked_since', now_iso()) if existing else now_iso()\r\n"]
[14124.68834, "o", "\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Klock\u001b[m\u001b[K = {\"reason\": reason, \"\u001b[01;31m\u001b[Klock\u001b[m\u001b[Ked_since\": \u001b[01;31m\u001b[Klock\u001b[m\u001b[Ked_since}\r\n\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    save_json(\u001b[01;31m\u001b[Klock\u001b[m\u001b[K_file(env), \u001b[01;31m\u001b[Klock\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef remove_\u001b[01;31m\u001b[Klock\u001b[m\u001b[K(env):\r\n\u001b[32m\u001b[K414\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        os.remove(\u001b[01;31m\u001b[Klock\u001b[m\u001b[K_file(env))\r\n\u001b[32m\u001b[K418\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef is_\u001b[01;31m\u001b[Klock\u001b[m\u001b[Ked(env):\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    return load_\u001b[01;31m\u001b[Klock\u001b[m\u001b[K(env) is not None\r\n\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef assert_not_\u001b[01;31m\u001b[Klock\u001b[m\u001b[Ked(env):\r\n"]
[14124.688411, "o", "\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Klock\u001b[m\u001b[K = load_\u001b[01;31m\u001b[Klock\u001b[m\u001b[K(env)\r\n\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if \u001b[01;31m\u001b[Klock\u001b[m\u001b[K is not None:\r\n\u001b[32m\u001b[K424\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fail(f\"{env} is \u001b[01;31m\u001b[Klock\u001b[m\u001b[Ked ({\u001b[01;31m\u001b[Klock\u001b[m\u001b[K.get('reason', 'manual \u001b[01;31m\u001b[Klock\u001b[m\u001b[K')})\")\r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef append_\u001b[01;31m\u001b[Klock\u001b[m\u001b[K_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K(env, reason):\r\n\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kevent\u001b[m\u001b[K = {\r\n\u001b[32m\u001b[K436\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    with open(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K_file(env), \"a\") as f:\r\n\u001b[32m\u001b[K437\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f.write(json.dumps(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K) + \"\\n\")\r\n"]
[14124.688473, "o", "\u001b[32m\u001b[K439\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef append_un\u001b[01;31m\u001b[Klock\u001b[m\u001b[K_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K(env):\r\n\u001b[32m\u001b[K441\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kevent\u001b[m\u001b[K = {\r\n\u001b[32m\u001b[K448\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    with open(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K_file(env), \"a\") as f:\r\n\u001b[32m\u001b[K449\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f.write(json.dumps(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K) + \"\\n\")\r\n"]
[14124.688539, "o", "\u001b[32m\u001b[K458\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_file(env):\r\n\u001b[32m\u001b[K461\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef load\u001b[m\u001b[K_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks(env):\r\n\u001b[32m\u001b[K462\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    return load_json(\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_file(env), {})\r\n\u001b[32m\u001b[K464\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef save\u001b[m\u001b[K_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks(env, \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks):\r\n\u001b[32m\u001b[K465\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    save_json(\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_file(env), \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks)\r\n"]
[14124.688604, "o", "\u001b[32m\u001b[K467\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_supported_resources():\r\n\u001b[32m\u001b[K470\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef validate_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_resource(resource):\r\n\u001b[32m\u001b[K471\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if resource not in \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_supported_resources():\r\n\u001b[32m\u001b[K472\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fail(f\"unknown \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K resource '{resource}' (must be max_services or max_total_replicas)\")\r\n\u001b[32m\u001b[K474\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_current_usage(env, resource):\r\n"]
[14124.688671, "o", "\u001b[32m\u001b[K481\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fail(f\"unknown \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K resource '{resource}' (must be max_services or max_total_replicas)\")\r\n\u001b[32m\u001b[K483\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef append_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_set_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K(env, resource, limit):\r\n\u001b[32m\u001b[K485\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kevent\u001b[m\u001b[K = {\r\n\u001b[32m\u001b[K494\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    with open(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K_file(env), \"a\") as f:\r\n\u001b[32m\u001b[K495\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f.write(json.dumps(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K) + \"\\n\")\r\n\u001b[32m\u001b[K497\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef append_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_remove_\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K(env, resource):\r\n\u001b[32m\u001b[K499\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kevent\u001b[m\u001b[K = {\r\n"]
[14124.688735, "o", "\u001b[32m\u001b[K507\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    with open(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K_file(env), \"a\") as f:\r\n\u001b[32m\u001b[K508\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f.write(json.dumps(\u001b[01;31m\u001b[Kevent\u001b[m\u001b[K) + \"\\n\")\r\n\u001b[32m\u001b[K510\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_\u001b[01;31m\u001b[Kstatus\u001b[m\u001b[K_line(env):\r\n\u001b[32m\u001b[K511\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks = load_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks(env)\r\n\u001b[32m\u001b[K512\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if not \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks:\r\n"]
[14124.688805, "o", "\u001b[32m\u001b[K515\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    for resource in \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_supported_resources():\r\n\u001b[32m\u001b[K516\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if resource in \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks:\r\n\u001b[32m\u001b[K517\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            limit = \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks[resource]\r\n"]
[14124.68888, "o", "\u001b[32m\u001b[K518\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            usage = \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_current_usage(env, resource)\r\n\u001b[32m\u001b[K524\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef cmd\u001b[m\u001b[K_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K(args):\r\n\u001b[32m\u001b[K526\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fail(\"\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K requires <environment> <set|get|list|remove|--check> [args]\")\r\n\u001b[32m\u001b[K529\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        fail(\"\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K requires <environment> <set|get|list|remove|--check> [args]\")\r\n"]
[14124.688953, "o", "\u001b[32m\u001b[K537\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            fail(\"\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K <environment> set <resource> <limit>\")\r\n\u001b[32m\u001b[K539\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        validate_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[K_resource(resource)\r\n\u001b[32m\u001b[K542\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            fail(f\"invalid \u001b[01;31m\u001b[Kquota\u001b[m\u001b[K limit '{limit_str}'\")\r\n\u001b[32m\u001b[K543\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_not_\u001b[01;31m\u001b[Klock\u001b[m\u001b[Ked(env)\r\n\u001b[32m\u001b[K544\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks = load_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks(env)\r\n\u001b[32m\u001b[K545\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks[resource] = limit\r\n\u001b[32m\u001b[K546\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        save_\u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks(env, \u001b[01;31m\u001b[Kquota\u001b[m\u001b[Ks)\r\n"]
