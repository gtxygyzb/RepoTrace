[1131.616043, "o", "> "]
[1131.616112, "o", "def parse_opts(args, value_opts, flag_opts):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.616177, "o", "    values = {}\r\n\u001b[?2004l\r"]
[1131.616205, "o", "\u001b[?2004h>     flags = set()\r\n\u001b[?2004l\r"]
[1131.616282, "o", "\u001b[?2004h>     positionals = []\r\n\u001b[?2004l\r"]
[1131.616362, "o", "\u001b[?2004h>     i = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.616433, "o", "    while i < len(args):\r\n\u001b[?2004l\r"]
[1131.616499, "o", "\u001b[?2004h> "]
[1131.61656, "o", "        a = args[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.616626, "o", ">         if a in value_opts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.61669, "o", "            i += 1\r\n\u001b[?2004l\r"]
[1131.616759, "o", "\u001b[?2004h> "]
[1131.616849, "o", "            if i >= len(args):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.616959, "o", "                fail(f\"{a} requires a value\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1131.617028, "o", "> "]
[1131.617097, "o", "            values[a] = args[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.617175, "o", "        elif a in flag_opts:\r\n\u001b[?2004l\r"]
[1131.617245, "o", "\u001b[?2004h> "]
