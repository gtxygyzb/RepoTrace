[11888.716417, "o", "                entries.append((iso, svc, line))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.716472, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11888.716527, "o", "assert old_history in s\r\n\u001b[?2004l\r\u001b[?2004h> "]
