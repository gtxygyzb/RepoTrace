[5519.521397, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport json\n\nevents_dir = Path('.pipeline/events')\nif events_dir.exists():\n    for p in events_dir.glob('*.log'):\n        lines = p.read_text().splitlines()\n        out = []\n        for line in lines:\n            if line.startswith('{'):\n                try:\n                    ev = json.loads(line)\n                except json.JSONDecodeError:\n                    out.append(line)\n                    continue\n                if ev.get('action') in ('LOCK', 'UNLOCK'):\n                    continue\n            out.append(line)\n        p.write_text(('\\n'.join(out) + '\\n') if out else '')\nPY\n"]
