[11788.770389, "o", "> "]
[11788.770516, "o", "    ensure_state()\r\n\u001b[?2004l\r"]
[11788.77055, "o", "\u001b[?2004h"]
[11788.770572, "o", "> "]
[11788.770689, "o", "    event = {\r\n\u001b[?2004l\r"]
[11788.77071, "o", "\u001b[?2004h"]
[11788.770729, "o", "> "]
