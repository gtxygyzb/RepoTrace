[7457.86703, "o", "\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kvalidate_config_key(key):\r\n\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kappend_config_set_event(env, key, value):\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f.write(\u001b[01;31m\u001b[Kjson.dump\u001b[m\u001b[Ks(event) + \"\\n\")\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kappend_config_delete_event(env, key):\r\n\u001b[32m\u001b[K383\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f.write(\u001b[01;31m\u001b[Kjson.dump\u001b[m\u001b[Ks(event) + \"\\n\")\r\n"]
