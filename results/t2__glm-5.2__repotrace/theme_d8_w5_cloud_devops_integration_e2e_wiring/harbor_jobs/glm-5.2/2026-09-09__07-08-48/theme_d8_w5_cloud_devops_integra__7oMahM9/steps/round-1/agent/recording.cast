[3894.420864, "o", "\t        tb = version_build_timestamp(b)\r\n   521\t        if ta is not None and tb is not None and ta != tb:\r\n   522\t            return 1 if ta > tb else -1\r\n   523\t        return 0\r\n   524\t    return 0 if str(a) == str(b) else (1 if str(a) > str(b) else -1)\r\n   525\tdef cmd_promote(args):\r\n   526\t    values, flags, positionals = parse_opts(args, {\"--service\"}, {\"--dry-run\", \"--force\"})\r\n   527\t    if len(positionals) != 2:\r\n   528\t        fail(\"promote requires <source-env> <target-env>\")\r\n   529\t\r\n   530"]
