[14181.231791, "o", "   125\t\r\n   126\t    def dfs(node):\r\n   127\t        visited[node] = 1\r\n   128\t        stack.append(node)\r\n   129\t        for dep in services[node].get('depends_on', []):\r\n   130\t            if dep not in services:\r\n   131\t                continue\r\n   132\t            if visited.get(dep) == 1:\r\n   133\t                idx = stack.index(dep)\r\n   134\t                return stack[idx:] + [dep]\r\n   135\t            if visited.get(dep) is None:\r\n   136\t                res = dfs(dep)\r\n   137\t                if res:\r\n   138\t                    return res\r\n   139\t        stack.pop()\r\n"]
