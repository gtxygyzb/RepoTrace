[14611.142848, "o", "\u001b[?2004h> "]
[14611.143126, "o", "        raw_lines = []\r\n\u001b[?2004l\r"]
[14611.143187, "o", "\u001b[?2004h"]
[14611.143234, "o", "> \r\n\u001b[?2004l\r"]
[14611.143281, "o", "\u001b[?2004h"]
[14611.143344, "o", "> "]
[14611.143525, "o", "    entries = []\r\n\u001b[?2004l\r"]
[14611.143597, "o", "\u001b[?2004h"]
[14611.143645, "o", "> "]
[14611.14392, "o", "    for line in raw_lines:\r\n"]
[14611.143968, "o", "\u001b[?2004l\r"]
[14611.144014, "o", "\u001b[?2004h> "]
[14611.144402, "o", "        if line.startswith('{'):\r\n"]
[14611.144449, "o", "\u001b[?2004l\r"]
[14611.144497, "o", "\u001b[?2004h> "]
[14611.1447, "o", "            try:\r\n\u001b[?2004l\r"]
[14611.144771, "o", "\u001b[?2004h"]
[14611.144826, "o", "> "]
[14611.145228, "o", "                ev = json.loads(line)\r\n"]
[14611.145275, "o", "\u001b[?2004l\r"]
[14611.145328, "o", "\u001b[?2004h> "]
[14611.145799, "o", "            except json.JSONDecodeError:\r\n\u001b[?2004l\r"]
[14611.145867, "o", "\u001b[?2004h"]
[14611.145914, "o", "> "]
[14611.146186, "o", "                continue\r\n"]
[14611.146233, "o", "\u001b[?2004l\r"]
[14611.146281, "o", "\u001b[?2004h> "]
[14611.146724, "o", "            action = ev.get(\"action\")\r\n\u001b[?2004l\r"]
[14611.146786, "o", "\u001b[?2004h"]
[14611.146834, "o", "> "]
[14611.147388, "o", "            iso = ev.get(\"iso_timestamp\", \"\")\r\n\u001b[?2004l\r"]
[14611.147464, "o", "\u001b[?2004h"]
[14611.147512, "o", "> "]
[14611.147967, "o", "            svc = ev.get(\"service\", \"-\")\r\n"]
[14611.148015, "o", "\u001b[?2004l\r"]
[14611.148062, "o", "\u001b[?2004h> "]
[14611.148382, "o", "            if action == \"LOCK\":\r\n\u001b[?2004l\r"]
[14611.14849, "o", "\u001b[?2004h> "]
[14611.148817, "o", "                details = ev.get(\"reason\", \"\")\r\n\u001b[?2004l\r"]
[14611.148869, "o", "\u001b[?2004h> "]
[14611.149484, "o", "                display = f\"{iso} LOCK {details}\" if details else f\"{iso} LOCK\"\r\n\u001b[?2004l\r"]
[14611.149542, "o", "\u001b[?2004h> "]
[14611.149821, "o", "            elif action == \"UNLOCK\":\r\n\u001b[?2004l\r"]
[14611.149871, "o", "\u001b[?2004h> "]
[14611.150101, "o", "                details = \"\"\r\n\u001b[?2004l\r"]
[14611.150151, "o", "\u001b[?2004h> "]
[14611.150498, "o", "                display = f\"{iso} UNLOCK\"\r\n\u001b[?2004l\r"]
[14611.150558, "o", "\u001b[?2004h> "]
[14611.15078, "o", "            elif action == \"CONFIG_SET\":\r\n\u001b[?2004l\r"]
[14611.150839, "o", "\u001b[?2004h> "]
[14611.151196, "o", "                details = f\"{ev.get('key', '')}={ev.get('value', '')}\"\r\n\u001b[?2004l\r"]
[14611.151248, "o", "\u001b[?2004h> "]
[14611.151544, "o", "                display = f\"{iso} CONFIG_SET {details}\"\r\n\u001b[?2004l\r"]
[14611.151602, "o", "\u001b[?2004h> "]
[14611.151826, "o", "            elif action == \"CONFIG_DELETE\":\r\n\u001b[?2004l\r"]
[14611.151878, "o", "\u001b[?2004h> "]
[14611.152103, "o", "                details = ev.get(\"key\", \"\")\r\n\u001b[?2004l\r"]
[14611.152155, "o", "\u001b[?2004h> "]
[14611.152471, "o", "                display = f\"{iso} CONFIG_DELETE {details}\"\r\n\u001b[?2004l\r"]
[14611.152526, "o", "\u001b[?2004h> "]
[14611.152699, "o", "            elif action == \"SCALE\":\r\n\u001b[?2004l\r"]
[14611.152751, "o", "\u001b[?2004h> "]
[14611.153266, "o", "                details = f\"{svc} from {ev.get('previous', '-')} to {ev.get('replicas', '-')} replicas\"\r\n\u001b[?2004l\r"]
[14611.153326, "o", "\u001b[?2004h> "]
[14611.153586, "o", "                display = f\"{iso} SCALE {details}\"\r\n\u001b[?2004l\r"]
[14611.153638, "o", "\u001b[?2004h> "]
[14611.153834, "o", "            elif action == \"HEALTH\":\r\n\u001b[?2004l\r"]
[14611.153886, "o", "\u001b[?2004h> "]
[14611.154362, "o", "                details = f\"{svc} {ev.get('previous_state', '-')} -> {ev.get('state', '-')}\"\r\n\u001b[?2004l\r"]
[14611.154415, "o", "\u001b[?2004h> "]
[14611.154675, "o", "                display = f\"{iso} HEALTH {details}\"\r\n\u001b[?2004l\r"]
[14611.154726, "o", "\u001b[?2004h> "]
[14611.154919, "o", "            elif action == \"QUOTA_SET\":\r\n\u001b[?2004l\r"]
[14611.15497, "o", "\u001b[?2004h> "]
[14611.155369, "o", "                details = f\"{ev.get('resource', '-')}={ev.get('limit', '-')}\"\r\n\u001b[?2004l\r"]
[14611.15542, "o", "\u001b[?2004h> "]
[14611.155701, "o", "                display = f\"{iso} QUOTA_SET {details}\"\r\n\u001b[?2004l\r"]
[14611.155753, "o", "\u001b[?2004h> "]
[14611.155962, "o", "            elif action == \"QUOTA_REMOVE\":\r\n\u001b[?2004l\r"]
[14611.156014, "o", "\u001b[?2004h> "]
[14611.156334, "o", "                details = ev.get(\"resource\", \"-\")\r\n\u001b[?2004l\r"]
[14611.156387, "o", "\u001b[?2004h> "]
[14611.156697, "o", "                display = f\"{iso} QUOTA_REMOVE {details}\"\r\n\u001b[?2004l\r"]
[14611.156749, "o", "\u001b[?2004h> "]
[14611.156929, "o", "            elif action == \"CLONE\":\r\n\u001b[?2004l\r"]
[14611.15698, "o", "\u001b[?2004h> "]
[14611.157278, "o", "                details = f\"from {ev.get('source', '-')}\"\r\n\u001b[?2004l\r"]
[14611.157334, "o", "\u001b[?2004h> "]
[14611.18655, "o", "                display = f\"{iso} CLONE {details}\"\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 action = ev.get(\"action\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h>                 parts = line.split(None, 2)\r\n\u001b[?2004l\r\u001b[?2004h>                 details = parts[2] if len(parts) > 2 else \"\"\r\n\u001b[?2004l\r\u001b[?2004h>                 display = line\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             parts = line.split(None, 2)\r\n\u001b[?2004l\r\u001b[?2004h>             iso = parts[0] if parts else \"\"\r\n\u001b[?2004l\r\u001b[?2004h>             action = parts[1] if len(parts) > 1 else \"\"\r\n\u001b[?2004l\r\u001b[?2004h>             details = parts[2] if len(parts) > 2 else \"\"\r\n\u001b[?2004l\r\u001b[?2004h>             display = line\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         entries.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"timestamp\": iso,\r\n\u001b[?2004l\r\u001b[?2004h>             \"action\": action,\r\n\u001b[?2004l\r\u001b[?2004h>             \"details\": details,\r\n\u001b[?2004l\r\u001b[?2004h>             \"display\": display,\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2"]
[14611.186681, "o", "004h> \r\n\u001b[?2004l\r\u001b[?2004h>     entries.reverse()\r\n\u001b[?2004l\r\u001b[?2004h>     return entries[:10]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def cmd_audit(args):\r\n\u001b[?2004l\r\u001b[?2004h>     values, flags, positionals = parse_opts(args, {\"--section\"}, {\"--json\"})\r\n\u001b[?2004l\r\u001b[?2004h>     if len(positionals) != 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.18675, "o", "> "]
[14611.18697, "o", "        fail(\"audit requires an environment\")\r\n\u001b[?2004l\r"]
[14611.187028, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[14611.187084, "o", "\u001b[?2004h> "]
[14611.187274, "o", "    env = positionals[0]\r\n\u001b[?2004l\r"]
[14611.187415, "o", "\u001b[?2004h> "]
[14611.187547, "o", "    assert_env_exists(env)\r\n\u001b[?2004l\r"]
[14611.187607, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[14611.187678, "o", "\u001b[?2004h> "]
[14611.187928, "o", "    section = values.get(\"--section\")\r\n\u001b[?2004l\r"]
[14611.187987, "o", "\u001b[?2004h> "]
[14611.18816, "o", "    valid_sections = {\r\n\u001b[?2004l\r"]
[14611.188217, "o", "\u001b[?2004h> "]
[14611.188556, "o", "        \"deployment\": \"Deployment Summary\",\r\n\u001b[?2004l\r"]
[14611.188624, "o", "\u001b[?2004h> "]
[14611.188914, "o", "        \"replicas\": \"Replica Summary\",\r\n\u001b[?2004l\r"]
[14611.188971, "o", "\u001b[?2004h> "]
[14611.189244, "o", "        \"health\": \"Health Summary\",\r\n\u001b[?2004l\r"]
[14611.189327, "o", "\u001b[?2004h> "]
[14611.189574, "o", "        \"quotas\": \"Quota Status\",\r\n\u001b[?2004l\r"]
[14611.189648, "o", "\u001b[?2004h> "]
[14611.189912, "o", "        \"config\": \"Config Variables\",\r\n\u001b[?2004l\r"]
[14611.18997, "o", "\u001b[?2004h> "]
[14611.190206, "o", "        \"lock\": \"Lock Status\",\r\n\u001b[?2004l\r"]
[14611.190264, "o", "\u001b[?2004h> "]
[14611.190576, "o", "        \"activity\": \"Recent Activity\",\r\n\u001b[?2004l\r"]
[14611.190636, "o", "\u001b[?2004h> "]
[14611.190686, "o", "    }\r\n\u001b[?2004l\r"]
[14611.190746, "o", "\u001b[?2004h> "]
[14611.191206, "o", "    if section is not None and section not in valid_sections:\r\n\u001b[?2004l\r"]
[14611.191261, "o", "\u001b[?2004h> "]
[14611.192143, "o", "        fail(f\"unknown section '{section}' (valid: deployment, replicas, health, quotas, config, lock, activity)\")\r\n\u001b[?2004l\r"]
[14611.192217, "o", "\u001b[?2004h> "]
[14611.192589, "o", "    if \"--json\" in flags and section is not None:\r\n\u001b[?2004l\r"]
[14611.192655, "o", "\u001b[?2004h> "]
[14611.192986, "o", "        fail(\"--json and --section cannot be combined\")\r\n\u001b[?2004l\r"]
[14611.193044, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[14611.19311, "o", "\u001b[?2004h> "]
[14611.193336, "o", "    state = load_deployment_state(env)\r\n\u001b[?2004l\r"]
[14611.193394, "o", "\u001b[?2004h> "]
[14611.193561, "o", "    services = sorted(state)\r\n\u001b[?2004l\r"]
[14611.193619, "o", "\u001b[?2004h> "]
[14611.193736, "o", "    deployment = {}\r\n\u001b[?2004l\r"]
[14611.193795, "o", "\u001b[?2004h> "]
[14611.1939, "o", "    replicas = {}\r\n\u001b[?2004l\r"]
[14611.193958, "o", "\u001b[?2004h> "]
[14611.19405, "o", "    health = {}\r\n\u001b[?2004l\r"]
[14611.194107, "o", "\u001b[?2004h> "]
[14611.194242, "o", "    for s in services:\r\n\u001b[?2004l\r"]
[14611.194305, "o", "\u001b[?2004h> "]
[14611.194439, "o", "        rec = state[s]\r\n\u001b[?2004l\r"]
[14611.194496, "o", "\u001b[?2004h> "]
[14611.194646, "o", "        deployment[s] = {\r\n\u001b[?2004l\r"]
[14611.194702, "o", "\u001b[?2004h> "]
[14611.194971, "o", "            \"version\": rec.get(\"version\", \"\"),\r\n\u001b[?2004l\r"]
[14611.195029, "o", "\u001b[?2004h> "]
[14611.195336, "o", "            \"timestamp\": rec.get(\"deployed_at\", \"\"),\r\n\u001b[?2004l\r"]
[14611.195396, "o", "\u001b[?2004h> "]
[14611.195452, "o", "        }\r\n\u001b[?2004l\r"]
[14611.195509, "o", "\u001b[?2004h> "]
[14611.19579, "o", "        replicas[s] = get_replica_count(env, s)\r\n\u001b[?2004l\r"]
[14611.195847, "o", "\u001b[?2004h> "]
[14611.196098, "o", "        health[s] = get_health_state(env, s)\r\n\u001b[?2004l\r"]
[14611.196154, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[14611.196212, "o", "\u001b[?2004h> "]
[14611.196417, "o", "    quota_data = load_quotas(env)\r\n\u001b[?2004l\r"]
[14611.196478, "o", "\u001b[?2004h> "]
[14611.196571, "o", "    quotas = {}\r\n\u001b[?2004l\r"]
[14611.196629, "o", "\u001b[?2004h> "]
[14611.196855, "o", "    for resource in sorted(quota_data):\r\n\u001b[?2004l\r"]
[14611.196913, "o", "\u001b[?2004h> "]
[14611.197124, "o", "        limit = quota_data[resource]\r\n\u001b[?2004l\r"]
[14611.197181, "o", "\u001b[?2004h> "]
[14611.197491, "o", "        usage = quota_current_usage(env, resource)\r\n\u001b[?2004l\r"]
[14611.197556, "o", "\u001b[?2004h> "]
[14611.197853, "o", "        status = \"OK\" if usage <= limit else \"EXCEEDED\"\r\n\u001b[?2004l\r"]
[14611.19791, "o", "\u001b[?2004h> "]
[14611.198075, "o", "        quotas[resource] = {\r\n\u001b[?2004l\r"]
[14611.198133, "o", "\u001b[?2004h> "]
[14611.198302, "o", "            \"limit\": limit,\r\n\u001b[?2004l\r"]
[14611.198359, "o", "\u001b[?2004h> "]
[14611.198528, "o", "            \"current\": usage,\r\n\u001b[?2004l\r"]
[14611.198591, "o", "\u001b[?2004h"]
[14611.198648, "o", "> "]
[14611.198786, "o", "            \"status\": status,\r\n\u001b[?2004l\r"]
[14611.198845, "o", "\u001b[?2004h> "]
[14611.198908, "o", "        }\r\n\u001b[?2004l\r"]
[14611.198965, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[14611.199032, "o", "\u001b[?2004h> "]
[14611.199317, "o", "    config_keys = sorted(load_config(env).keys())\r\n\u001b[?2004l\r"]
[14611.199374, "o", "\u001b[?2004h> "]
[14611.199523, "o", "    lock = load_lock(env)\r\n\u001b[?2004l\r"]
[14611.199579, "o", "\u001b[?2004h> "]
[14611.199809, "o", "    activity = audit_event_entries(env)\r\n\u001b[?2004l\r"]
[14611.199865, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[14611.199923, "o", "\u001b[?2004h> "]
[14611.200073, "o", "    if \"--json\" in flags:\r\n\u001b[?2004l\r"]
[14611.200131, "o", "\u001b[?2004h> "]
[14611.200243, "o", "        report = {\r\n\u001b[?2004l\r"]
[14611.200313, "o", "\u001b[?2004h> "]
[14611.200494, "o", "            \"environment\": env,\r\n\u001b[?2004l\r"]
[14611.200553, "o", "\u001b[?2004h> "]
[14611.200769, "o", "            \"deployment\": deployment,\r\n\u001b[?2004l\r"]
[14611.200827, "o", "\u001b[?2004h> "]
[14611.20102, "o", "            \"replicas\": replicas,\r\n\u001b[?2004l\r"]
[14611.201076, "o", "\u001b[?2004h> "]
[14611.20125, "o", "            \"health\": health,\r\n\u001b[?2004l\r"]
[14611.201313, "o", "\u001b[?2004h> "]
[14611.201482, "o", "            \"quotas\": quotas,\r\n\u001b[?2004l\r"]
[14611.201548, "o", "\u001b[?2004h> "]
[14611.201741, "o", "            \"config\": config_keys,\r\n\u001b[?2004l\r"]
[14611.201797, "o", "\u001b[?2004h> "]
[14611.201925, "o", "            \"lock\": {\r\n\u001b[?2004l\r"]
[14611.201988, "o", "\u001b[?2004h> "]
[14611.202235, "o", "                \"locked\": lock is not None,\r\n\u001b[?2004l\r"]
[14611.202302, "o", "\u001b[?2004h> "]
[14611.202776, "o", "                \"reason\": lock.get(\"reason\", \"manual lock\") if lock is not None else None,\r\n\u001b[?2004l\r"]
[14611.202836, "o", "\u001b[?2004h> "]
[14611.202901, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.202958, "o", "> "]
[14611.203038, "o", "            \"activity\": [\r\n\u001b[?2004l\r"]
[14611.203095, "o", "\u001b[?2004h> "]
[14611.203159, "o", "                {\r\n\u001b[?2004l\r"]
[14611.20322, "o", "\u001b[?2004h> "]
[14611.20341, "o", "                    \"timestamp\": e[\"timestamp\"],\r\n\u001b[?2004l\r"]
[14611.203469, "o", "\u001b[?2004h> "]
[14611.203631, "o", "                    \"action\": e[\"action\"],\r\n\u001b[?2004l\r"]
[14611.203687, "o", "\u001b[?2004h> "]
[14611.203856, "o", "                    \"details\": e[\"details\"],\r\n\u001b[?2004l\r"]
[14611.203913, "o", "\u001b[?2004h> "]
[14611.203976, "o", "                }\r\n\u001b[?2004l\r"]
[14611.204033, "o", "\u001b[?2004h> "]
[14611.204158, "o", "                for e in activity\r\n\u001b[?2004l\r"]
[14611.204217, "o", "\u001b[?2004h> "]
[14611.20427, "o", "            ],\r\n\u001b[?2004l\r"]
[14611.204338, "o", "\u001b[?2004h> "]
[14611.204394, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14611.204704, "o", "        print(json.dumps(report, separators=(\",\", \":\"), sort_keys=True))\r\n\u001b[?2004l\r"]
[14611.204762, "o", "\u001b[?2004h> "]
[14611.204822, "o", "        return\r\n\u001b[?2004l\r"]
[14611.20488, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.204937, "o", "> "]
[14611.205017, "o", "    def deployment_lines():\r\n\u001b[?2004l\r"]
[14611.205074, "o", "\u001b[?2004h> "]
[14611.205162, "o", "        if not services:\r\n\u001b[?2004l\r"]
[14611.205217, "o", "\u001b[?2004h> "]
[14611.205412, "o", "            return [\"  (no services deployed)\"]\r\n\u001b[?2004l\r"]
[14611.205469, "o", "\u001b[?2004h> "]
[14611.205526, "o", "        return [\r\n\u001b[?2004l\r"]
[14611.205582, "o", "\u001b[?2004h> "]
[14611.205937, "o", "            f\"  {s}: {deployment[s]['version']} (deployed {deployment[s]['timestamp']})\"\r\n\u001b[?2004l\r"]
[14611.205995, "o", "\u001b[?2004h> "]
[14611.2061, "o", "            for s in services\r\n\u001b[?2004l\r"]
[14611.206158, "o", "\u001b[?2004h> "]
[14611.206217, "o", "        ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[14611.206274, "o", "\u001b[?2004h> "]
[14611.206383, "o", "    def replica_lines():\r\n\u001b[?2004l\r"]
[14611.20644, "o", "\u001b[?2004h> "]
[14611.206533, "o", "        if not services:\r\n\u001b[?2004l\r"]
[14611.206589, "o", "\u001b[?2004h> "]
[14611.20677, "o", "            return [\"  (no services deployed)\"]\r\n\u001b[?2004l\r"]
[14611.206826, "o", "\u001b[?2004h> "]
[14611.207095, "o", "        return [f\"  {s}: {replicas[s]} replicas\" for s in services]\r\n\u001b[?2004l\r"]
[14611.207151, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[14611.207207, "o", "\u001b[?2004h> "]
[14611.207302, "o", "    def health_lines():\r\n\u001b[?2004l\r"]
[14611.207361, "o", "\u001b[?2004h> "]
[14611.207446, "o", "        if not services:\r\n\u001b[?2004l\r"]
[14611.207512, "o", "\u001b[?2004h> "]
[14611.207684, "o", "            return [\"  (no services deployed)\"]\r\n\u001b[?2004l\r"]
[14611.207741, "o", "\u001b[?2004h> "]
[14611.207963, "o", "        return [f\"  {s}: {health[s]}\" for s in services]\r\n\u001b[?2004l\r"]
[14611.20802, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.208077, "o", "> "]
[14611.208146, "o", "    def quota_lines():\r\n\u001b[?2004l\r"]
[14611.208202, "o", "\u001b[?2004h> "]
[14611.208281, "o", "        if not quotas:\r\n\u001b[?2004l\r"]
[14611.208349, "o", "\u001b[?2004h> "]
[14611.208503, "o", "            return [\"  (no quotas set)\"]\r\n\u001b[?2004l\r"]
[14611.208561, "o", "\u001b[?2004h> "]
[14611.208636, "o", "        return [\r\n\u001b[?2004l\r"]
[14611.208691, "o", "\u001b[?2004h> "]
[14611.209249, "o", "            f\"  {resource}: {quotas[resource]['limit']} (current: {quotas[resource]['current']}) [{quotas[resource]['status']}]\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14611.209434, "o", "            for resource in sorted(quotas)\r\n\u001b[?2004l\r"]
[14611.209505, "o", "\u001b[?2004h>         ]\r\n\u001b[?2004l\r"]
[14611.209564, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[14611.209623, "o", "\u001b[?2004h> "]
[14611.209706, "o", "    def config_lines():\r\n\u001b[?2004l\r"]
[14611.209761, "o", "\u001b[?2004h> "]
[14611.209865, "o", "        if not config_keys:\r\n\u001b[?2004l\r"]
[14611.20992, "o", "\u001b[?2004h> "]
[14611.210104, "o", "            return [\"  (no config variables)\"]\r\n\u001b[?2004l\r"]
[14611.210165, "o", "\u001b[?2004h> "]
[14611.210364, "o", "        return [f\"  {key}\" for key in config_keys]\r\n\u001b[?2004l\r"]
[14611.210422, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.210479, "o", "> "]
[14611.21054, "o", "    def lock_lines():\r\n\u001b[?2004l\r"]
[14611.210598, "o", "\u001b[?2004h> "]
[14611.210707, "o", "        if lock is not None:\r\n\u001b[?2004l\r"]
[14611.210765, "o", "\u001b[?2004h> "]
[14611.211038, "o", "            return [f\"  Locked: {lock.get('reason', 'manual lock')}\"]\r\n\u001b[?2004l\r"]
[14611.211095, "o", "\u001b[?2004h> "]
[14611.2112, "o", "        return [\"  Unlocked\"]\r\n\u001b[?2004l\r"]
[14611.211255, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.211332, "o", "> "]
[14611.211401, "o", "    def activity_lines():\r\n\u001b[?2004l\r"]
[14611.211457, "o", "\u001b[?2004h> "]
[14611.211551, "o", "        if not activity:\r\n\u001b[?2004l\r"]
[14611.211606, "o", "\u001b[?2004h> "]
[14611.211751, "o", "            return [\"  (no events)\"]\r\n\u001b[?2004l\r"]
[14611.211807, "o", "\u001b[?2004h> "]
[14611.212013, "o", "        return [f\"  {e['display']}\" for e in activity]\r\n\u001b[?2004l\r"]
[14611.212069, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[14611.212124, "o", "\u001b[?2004h> "]
[14611.212512, "o", "    section_order = [\"deployment\", \"replicas\", \"health\", \"quotas\", \"config\", \"lock\", \"activity\"]\r\n\u001b[?2004l\r"]
[14611.212571, "o", "\u001b[?2004h> "]
[14611.212653, "o", "    section_funcs = {\r\n\u001b[?2004l\r"]
[14611.21271, "o", "\u001b[?2004h> "]
[14611.212826, "o", "        \"deployment\": deployment_lines,\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.212883, "o", "> "]
[14611.212947, "o", "        \"replicas\": replica_lines,\r\n\u001b[?2004l\r"]
[14611.212979, "o", "\u001b[?2004h> "]
[14611.213063, "o", "        \"health\": health_lines,\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.213121, "o", "> "]
[14611.213179, "o", "        \"quotas\": quota_lines,\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.213253, "o", "> "]
[14611.213317, "o", "        \"config\": config_lines,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14611.213397, "o", "        \"lock\": lock_lines,\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.213453, "o", "> "]
[14611.21352, "o", "        \"activity\": activity_lines,\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.213577, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[14611.213633, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[14611.213737, "o", "    print(f\"=== Audit Report: {env} ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.213794, "o", "> "]
[14611.213853, "o", "    if section is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14611.214014, "o", "        print(f\"--- {valid_sections[section]} ---\")\r\n\u001b[?2004l\r"]
[14611.21407, "o", "\u001b[?2004h> "]
[14611.214166, "o", "        for line in section_funcs[section]():\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.214222, "o", "> "]
[14611.214277, "o", "            print(line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14611.21434, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14611.214444, "o", "        for key in section_order:\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.2145, "o", "> "]
[14611.214614, "o", "            print(f\"--- {valid_sections[key]} ---\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.214671, "o", "> "]
[14611.214767, "o", "            for line in section_funcs[key]():\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.214824, "o", "> "]
[14611.214886, "o", "                print(line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14611.215004, "o", "    print(\"=== End Audit Report ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[14611.21506, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[14611.215117, "o", "\u001b[?2004h> "]
