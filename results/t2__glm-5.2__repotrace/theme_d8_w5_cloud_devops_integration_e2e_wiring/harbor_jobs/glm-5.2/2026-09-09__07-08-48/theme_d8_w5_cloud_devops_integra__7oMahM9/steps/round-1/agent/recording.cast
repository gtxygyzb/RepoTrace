[1131.618017, "o", "\u001b[?2004h>     if args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.618106, "o", "        fail(\"validate takes no arguments\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1131.61818, "o", "    data = load_manifest()\r\n\u001b[?2004l\r "]
[1131.618246, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[1131.618302, "o", "\u001b[?2004h> "]
