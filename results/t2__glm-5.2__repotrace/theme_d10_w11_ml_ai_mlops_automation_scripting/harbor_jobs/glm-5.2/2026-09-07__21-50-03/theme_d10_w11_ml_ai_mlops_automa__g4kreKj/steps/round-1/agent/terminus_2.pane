[?2004lfunc main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "Usage: mlpipe <command> [args...]")
		fmt.Fprintln(os.Stderr, "Commands: validate, plan, run, report, artifacts, compare, sweep")
		os.Exit(1)
	}

	cmd := os.Args[1]
	args := os.Args[2:]

	switch cmd {
	case "validate":
		os.Exit(cmdValidate(args))
	case "plan":
		os.Exit(cmdPlan(args))
	case "run":
		os.Exit(cmdRun(args))
	case "report":
		os.Exit(cmdReport(args))
	case "artifacts":
		os.Exit(cmdArtifacts(args))
	case "compare":
		os.Exit(cmdCompare(args))
	case "sweep":
		os.Exit(cmdSweep(args))
	default:
		fmt.Fprintf(os.Stderr, "error: command %q is not implemented\n", cmd)
		os.Exit(1)
	}
}

func cmdValidate(args []string) int {
	if len(args) < 1 {
		fmt.Fprintln(os.Stderr, "Usage: mlpipe validate <pipeline.yaml>")
		return 1
	}
	p, err := loadPipeline(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	errs := validatePipeline(p)
	if len(errs) > 0 {
		for _, e := range errs {
			fmt.Println(e)
		}
		return 1
	}
	return 0
}
[?2004hroot@n30009:/app# sed -n '148,166p' main.go
[?2004lfunc cmdReport(args []string) int {
	if len(args) < 1 {
		fmt.Fprintln(os.Stderr, "Usage: mlpipe report <pipeline.yaml>")
		return 1
	}
	p, err := loadPipeline(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	if errs := validatePipeline(p); len(errs) > 0 {
		for _, e := range errs {
			fmt.Fprintln(os.Stderr, e)
		}
		return 1
	}
	return reportPipeline(p)
}

