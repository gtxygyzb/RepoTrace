   321	func loadPipeline(path string) (*Pipeline, error) {
   322		data, err := os.ReadFile(path)
   323		if err != nil {
   324			return nil, err
   325		}
   326		v, err := parseYAML(data)
   327		if err != nil {
   328			return nil, err
   329		}
   330		return mapToPipeline(v)
   331	}
