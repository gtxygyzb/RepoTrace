[?2004lname: image-classifier-training
version: "1.0"

parameters:
  learning_rate:
    type: grid
    values: [0.001, 0.01, 0.1]
  batch_size:
    type: grid
    values: [32, 64]
  optimizer:
    type: grid
    values: ["adam", "sgd"]

stages:
  - name: data-validation
    command: "./stages/validate_data.sh"
    inputs:
      - path: "data/sample"
        type: directory
    outputs:
      - path: "data/validated"
        type: directory
    metrics:
      - name: num_samples
        objective: report
      - name: corruption_rate
        objective: minimize

  - name: feature-extraction
    command: "./stages/extract_features.sh"
    depends_on: ["data-validation"]
    inputs:
      - path: "data/validated"
        type: directory
    outputs:
      - path: "data/features.bin"
        type: file
    env:
      BATCH_SIZE: "${batch_size}"

  - name: model-training
    command: "./stages/train_model.sh"
    depends_on: ["feature-extraction"]
    inputs:
      - path: "data/features.bin"
        type: file
    outputs:
      - path: "models/checkpoint.bin"
        type: file
    env:
      LEARNING_RATE: "${learning_rate}"
      OPTIMIZER: "${optimizer}"
      BATCH_SIZE: "${batch_size}"
    metrics:
      - name: train_loss
        objective: minimize
      - name: train_accuracy
        objective: maximize
    retry:
      max_attempts: 2
      backoff_seconds: 1

  - name: model-evaluation
    command: "./stages/evaluate_model.sh"
    depends_on: ["model-training"]
    inputs:
      - path: "models/checkpoint.bin"
        type: file
      - path: "data/validated"
        type: directory
    outputs:
      - path: "reports/evaluation.json"
        type: file
    metrics:
      - name: eval_accuracy
        objective: maximize
      - name: eval_f1
        objective: maximize
      - name: eval_loss
        objective: minimize

  - name: model-export
    command: "./stages/export_model.sh"
    depends_on: ["model-evaluation"]
    condition:
      metric: eval_accuracy
      operator: ">="
      threshold: 0.85
    inputs:
      - path: "models/checkpoint.bin"
        type: file
    outputs:
      - path: "models/exported/model.onnx"
        type: file
