   921	func artifactsGC(p *Pipeline) int {
   922		expected := make(map[string]bool)
   923		for _, combo := range parameterCombinations(p) {
   924			expected[experimentID(combo)] = true
   925		}
   926		entries, err := os.ReadDir(filepath.Join(".mlpipe", "state"))
