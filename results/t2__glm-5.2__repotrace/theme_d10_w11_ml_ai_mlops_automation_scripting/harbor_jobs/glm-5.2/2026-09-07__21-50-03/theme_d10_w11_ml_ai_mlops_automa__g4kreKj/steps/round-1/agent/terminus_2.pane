   928			return 0
   929		}
   930		for _, entry := range entries {
   931			if !expected[entry.Name()] {
   932				_ = os.RemoveAll(filepath.Join(".mlpipe", "state", entry.Name()))
   933			}
   934		}
   935		return 0
   936	}
