  1088			if err := json.Unmarshal([]byte(line), &mm); err == nil {
  1089				if name, ok := mm["metric"].(string); ok {
  1090					metrics = append(metrics, MetricData{Name: name, Value: asFloat(mm["value"])})
  1091				}
  1092			}
  1093		}
  1094		return metrics
  1095	}
