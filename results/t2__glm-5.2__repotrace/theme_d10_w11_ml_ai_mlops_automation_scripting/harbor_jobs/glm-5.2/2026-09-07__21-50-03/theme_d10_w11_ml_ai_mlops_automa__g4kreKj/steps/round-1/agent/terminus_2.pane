[?2004lfunc cmdExport(args []string) int {
	pipelineFile := ""
	sortBy := ""
	descending := false
	format := "csv"
	var filters []string
	for i := 0; i < len(args); i++ {
		arg := args[i]
		switch {
		case arg == "--sort-by":
			if i+1 >= len(args) {
				fmt.Fprintln(os.Stderr, "error: --sort-by requires a value")
				return 1
			}
			i++
			sortBy = args[i]
		case strings.HasPrefix(arg, "--sort-by="):
			sortBy = strings.TrimPrefix(arg, "--sort-by=")
		case arg == "--format":
			if i+1 >= len(args) {
				fmt.Fprintln(os.Stderr, "error: --format requires a value")
				return 1
			}
			i++
			format = args[i]
		case strings.HasPrefix(arg, "--format="):
			format = strings.TrimPrefix(arg, "--format=")
		case arg == "--filter":
			if i+1 >= len(args) {
				fmt.Fprintln(os.Stderr, "error: --filter requires a value")
				return 1
			}
			i++
			filters = append(filters, args[i])
		case strings.HasPrefix(arg, "--filter="):
			filters = append(filters, strings.TrimPrefix(arg, "--filter="))
		case arg == "--descending":
			descending = true
		case pipelineFile == "":
			pipelineFile = arg
		default:
			fmt.Fprintf(os.Stderr, "error: unknown argument %q\n", arg)
			return 1
		}
	}
	if pipelineFile == "" {
		fmt.Fprintln(os.Stderr, "Usage: mlpipe export <pipeline_yaml> [flags]")
		return 1
	}
	if format != "csv" && format != "json" && format != "markdown" {
		fmt.Fprintf(os.Stderr, "error: unsupported format %q\n", format)
		return 1
	}
	p, err := loadPipeline(pipelineFile)
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	if errs := validatePipeline(p); len(errs) > 0 {
		for _, e := range errs {
			fmt.Fprintln(os.Stderr, e)
		}
