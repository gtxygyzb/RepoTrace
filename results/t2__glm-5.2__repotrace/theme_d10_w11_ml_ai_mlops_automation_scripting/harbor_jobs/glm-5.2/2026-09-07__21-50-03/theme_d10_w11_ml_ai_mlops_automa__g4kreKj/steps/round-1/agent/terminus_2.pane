  1247	
  1248	func sampleStd(values []float64) float64 {
  1249		n := len(values)
  1250		if n <= 1 {
  1251			return 0.0
  1252		}
  1253		mean := meanValue(values)
  1254		ss := 0.0
  1255		for _, v := range values {
  1256			diff := v - mean
  1257			ss += diff * diff
  1258		}
  1259		return math.Sqrt(ss / float64(n-1))
  1260	}
