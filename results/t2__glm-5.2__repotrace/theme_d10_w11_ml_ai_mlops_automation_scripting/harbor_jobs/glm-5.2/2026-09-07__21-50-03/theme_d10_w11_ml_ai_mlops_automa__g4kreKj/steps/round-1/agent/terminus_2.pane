func saveArtifactIndex(idx *ArtifactIndex) error {
	if err := os.MkdirAll(filepath.Dir(artifactsIndexPath()), 0755); err != nil {
		return err
	}
	data, err := json.MarshalIndent(idx, "", "  ")
	if err != nil {
		return err
	}
	return os.WriteFile(artifactsIndexPath(), data, 0644)
}

func artifactsList() int {
	idx := loadArtifactIndex()
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	if err := enc.Encode(idx); err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	return 0
}

func artifactsGC(p *Pipeline) int {
	expected := make(map[string]bool)
	for _, combo := range parameterCombinations(p) {
		expected[experimentID(combo)] = true
	}
	entries, err := os.ReadDir(filepath.Join(".mlpipe", "state"))
	if err != nil {
		return 0
	}
	for _, entry := range entries {
		if !expected[entry.Name()] {
			_ = os.RemoveAll(filepath.Join(".mlpipe", "state", entry.Name()))
		}
	}
	return 0
}

func reportPipeline(p *Pipeline) int {
	type reportExperiment struct {
		ID      string             `json:"id"`
		Metrics map[string]float64 `json:"metrics"`
		Stages  []StageState       `json:"stages"`
	}
	type sensitivityEntry struct {
		BestWithout  string  `json:"best_without"`
		MaxComposite float64 `json:"max_composite"`
	}
	type reportOutput struct {
		Pipeline          string                        `json:"pipeline"`
		Experiments       []reportExperiment            `json:"experiments"`
		MetricSummary     map[string]metricSummaryEntry `json:"metric_summary"`
		MetricRankings    map[string]map[string]int     `json:"metric_rankings"`
		CompositeScores   map[string]float64            `json:"composite_scores"`
		NormalizedMetrics map[string]map[string]float64 `json:"normalized_metrics"`
		MetricImportance  map[string]float64            `json:"metric_importance"`
		ScoreSensitivity  map[string]sensitivityEntry   `json:"score_sensitivity"`
		BestExperiment    string                        `json:"best_experiment"`
	}

	out := reportOutput{
		Pipeline:          p.Name,
		Experiments:       []reportExperiment{},
		MetricSummary:     map[string]metricSummaryEntry{},
		MetricRankings:    map[string]map[string]int{},
		CompositeScores:   map[string]float64{},
		NormalizedMetrics: map[string]map[string]float64{},
		MetricImportance:  map[string]float64{},
		ScoreSensitivity:  map[string]sensitivityEntry{},
	}
	metricValues := map[string][]float64{}
	for _, combo := range parameterCombinations(p) {
		id := experimentID(combo)
		exp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}
		for _, stage := range p.Stages {
			if st, err := readStageState(id, stage.Name); err == nil {
				exp.Stages = append(exp.Stages, *st)
				for _, m := range st.Metrics {
					exp.Metrics[m.Name] = m.Value
					metricValues[m.Name] = append(metricValues[m.Name], m.Value)
				}
			}
		}
		out.Experiments = append(out.Experiments, exp)
	}
	for name, values := range metricValues {
		out.MetricSummary[name] = metricSummaryEntry{
			Count: len(values),
			Mean:  round4(meanValue(values)),
			Std:   round4(sampleStd(values)),
			Min:   round4(minValue(values)),
			Max:   round4(maxValue(values)),
		}
	}

	objectives := map[string]string{}
	for _, stage := range p.Stages {
		for _, m := range stage.Metrics {
			if m.Objective == "minimize" || m.Objective == "maximize" {
				objectives[m.Name] = m.Objective
			}
		}
	}
	objMetrics := make([]string, 0, len(objectives))
	for m := range objectives {
		if _, ok := metricValues[m]; ok {
			objMetrics = append(objMetrics, m)
		}
	}
	sort.Strings(objMetrics)

	if len(objMetrics) > 0 {
		minVal := map[string]float64{}
		maxVal := map[string]float64{}
		for _, m := range objMetrics {
			if vals, ok := metricValues[m]; ok && len(vals) > 0 {
				minVal[m] = minValue(vals)
				maxVal[m] = maxValue(vals)
			}
		}

		normalized := make([]map[string]float64, len(out.Experiments))
		for i, exp := range out.Experiments {
			normalized[i] = make(map[string]float64)
			normOut := make(map[string]float64)
			for _, m := range objMetrics {
				val, ok := exp.Metrics[m]
				if !ok {
					continue
				}
				rng := maxVal[m] - minVal[m]
				var norm float64
				if rng == 0 {
					norm = 0.5
				} else if objectives[m] == "maximize" {
					norm = (val - minVal[m]) / rng
				} else {
					norm = (maxVal[m] - val) / rng
				}
				normalized[i][m] = norm
				normOut[m] = round4(norm)
			}
			out.NormalizedMetrics[exp.ID] = normOut
		}

		composite := make([]float64, len(out.Experiments))
		for i := range out.Experiments {
			if len(normalized[i]) == 0 {
				composite[i] = 0
			} else {
				sum := 0.0
				for _, m := range objMetrics {
					if norm, ok := normalized[i][m]; ok {
						sum += norm
					}
				}
				composite[i] = sum / float64(len(normalized[i]))
			}
			out.CompositeScores[out.Experiments[i].ID] = round4(composite[i])
		}

		for _, m := range objMetrics {
			out.MetricRankings[m] = map[string]int{}
			type idxVal struct {
				idx int
				val float64
			}
			var items []idxVal
			for i, exp := range out.Experiments {
				if val, ok := exp.Metrics[m]; ok {
					items = append(items, idxVal{i, val})
				}
			}
			sort.SliceStable(items, func(a, b int) bool {
				va := items[a].val
				vb := items[b].val
				if va != vb {
					if objectives[m] == "maximize" {
						return va > vb
					}
					return va < vb
				}
				return out.Experiments[items[a].idx].ID < out.Experiments[items[b].idx].ID
			})
			currentRank := 0
			prevVal := math.NaN()
			for _, item := range items {
				if currentRank == 0 || item.val != prevVal {
					currentRank++
					prevVal = item.val
				}
				out.MetricRankings[m][out.Experiments[item.idx].ID] = currentRank
			}
		}

		for _, m := range objMetrics {
			var norms []float64
			for i := range out.Experiments {
				if norm, ok := normalized[i][m]; ok {
					norms = append(norms, norm)
				}
			}
			out.MetricImportance[m] = round4(sampleStd(norms))
		}

		for _, m := range objMetrics {
			if len(objMetrics) <= 1 {
				bestID := ""
				for _, exp := range out.Experiments {
					if bestID == "" || exp.ID < bestID {
						bestID = exp.ID
					}
				}
				out.ScoreSensitivity[m] = sensitivityEntry{
					BestWithout:  bestID,
					MaxComposite: 0,
				}
				continue
			}
			type idxScore struct {
				idx   int
				score float64
			}
			var scores []idxScore
			for i := range out.Experiments {
				sum := 0.0
				count := 0
				for _, mm := range objMetrics {
					if mm == m {
						continue
					}
					if norm, ok := normalized[i][mm]; ok {
						sum += norm
						count++
					}
				}
				var score float64
				if count > 0 {
					score = sum / float64(count)
				}
				scores = append(scores, idxScore{i, score})
			}
			sort.SliceStable(scores, func(a, b int) bool {
				if scores[a].score != scores[b].score {
					return scores[a].score > scores[b].score
				}
				return out.Experiments[scores[a].idx].ID < out.Experiments[scores[b].idx].ID
			})
			bestID := ""
			maxScore := 0.0
			if len(scores) > 0 {
				bestID = out.Experiments[scores[0].idx].ID
				maxScore = scores[0].score
			}
			out.ScoreSensitivity[m] = sensitivityEntry{
				BestWithout:  bestID,
				MaxComposite: round4(maxScore),
			}
		}

		bestIdx := -1
		var bestScore float64
		for i := range out.Experiments {
			score := round4(composite[i])
			if bestIdx == -1 || score > bestScore || (score == bestScore && out.Experiments[i].ID < out.Experiments[bestIdx].ID) {
				bestIdx = i
				bestScore = score
			}
		}
		if bestIdx >= 0 {
			out.BestExperiment = out.Experiments[bestIdx].ID
		}
	} else {
		bestID := ""
		for _, exp := range out.Experiments {
			if bestID == "" || exp.ID < bestID {
				bestID = exp.ID
			}
		}
		out.BestExperiment = bestID
	}

	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	if err := enc.Encode(out); err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	return 0
}

type metricSummaryEntry struct {
	Count int     `json:"count"`
	Mean  float64 `json:"mean"`
	Std   float64 `json:"std"`
	Min   float64 `json:"min"`
	Max   float64 `json:"max"`
}

func cmdSweep(args []string) int {
	pipelineFile := ""
	metricName := ""
	paramName := ""
	for i := 0; i < len(args); i++ {
		arg := args[i]
		switch {
		case arg == "--metric":
			if i+1 >= len(args) {
				fmt.Fprintln(os.Stderr, "error: --metric requires a value")
				return 1
			}
			i++
			metricName = args[i]
		case strings.HasPrefix(arg, "--metric="):
			metricName = strings.TrimPrefix(arg, "--metric=")
		case arg == "--param":
			if i+1 >= len(args) {
				fmt.Fprintln(os.Stderr, "error: --param requires a value")
				return 1
			}
			i++
			paramName = args[i]
		case strings.HasPrefix(arg, "--param="):
			paramName = strings.TrimPrefix(arg, "--param=")
		case pipelineFile == "":
			pipelineFile = arg
		default:
			fmt.Fprintf(os.Stderr, "error: unknown argument %q\n", arg)
			return 1
		}
	}
	if pipelineFile == "" || metricName == "" || paramName == "" {
		fmt.Fprintln(os.Stderr, "Usage: mlpipe sweep <pipeline.yaml> --metric <name> --param <name>")
		return 1
	}

	p, err := loadPipeline(pipelineFile)
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	if errs := validatePipeline(p); len(errs) > 0 {
		for _, e := range errs {
			fmt.Fprintln(os.Stderr, e)
		}
		return 1
	}

	objective := ""
	metricFound := false
	for _, stage := range p.Stages {
		for _, m := range stage.Metrics {
			if m.Name == metricName {
				metricFound = true
				if objective == "" {
					objective = m.Objective
				}
			}
		}
	}
	if !metricFound {
		fmt.Fprintf(os.Stderr, "error: metric %q not found in pipeline\n", metricName)
		return 1
	}

	paramFound := false
	for _, param := range p.Parameters {
		if param.Name == paramName {
			paramFound = true
			break
		}
	}
	if !paramFound {
		fmt.Fprintf(os.Stderr, "error: parameter %q not found in pipeline\n", paramName)
		return 1
	}

	return sweepPipeline(p, metricName, paramName, objective)
}

func sweepPipeline(p *Pipeline, metricName, paramName, objective string) int {
	type groupOut struct {
		Value string  `json:"value"`
		Count int     `json:"count"`
		Mean  float64 `json:"mean"`
		Std   float64 `json:"std"`
		Min   float64 `json:"min"`
		Max   float64 `json:"max"`
	}

	groupValues := map[string][]float64{}
	for _, combo := range parameterCombinations(p) {
		id := experimentID(combo)
		paramValue := asString(combo[paramName])
		metrics := map[string]float64{}
		for _, stage := range p.Stages {
[?2004hroot@n30009:/app# sed -n '1300,1800p' main.go
[?2004l		for _, stage := range p.Stages {
			if st, err := readStageState(id, stage.Name); err == nil && st.Status == "completed" {
				for _, m := range st.Metrics {
					metrics[m.Name] = m.Value
				}
			}
		}
		if val, ok := metrics[metricName]; ok {
			groupValues[paramValue] = append(groupValues[paramValue], val)
		}
	}

	if len(groupValues) == 0 {
		fmt.Fprintf(os.Stderr, "error: metric %q not found in any completed experiment\n", metricName)
		return 1
	}

	values := make([]string, 0, len(groupValues))
	for v := range groupValues {
		values = append(values, v)
	}
	sort.Strings(values)

	groups := make([]groupOut, 0, len(values))
	groupMeans := map[string]float64{}
	groupVars := map[string]float64{}
	totalN := 0
	grandSum := 0.0
	for _, v := range values {
		obs := groupValues[v]
		n := len(obs)
		totalN += n
		mean := meanValue(obs)
		variance := 0.0
		if n > 1 {
			ss := 0.0
			for _, x := range obs {
				diff := x - mean
				ss += diff * diff
			}
			variance = ss / float64(n-1)
		}
		groupMeans[v] = mean
		groupVars[v] = variance
		grandSum += mean * float64(n)
		groups = append(groups, groupOut{
			Value: v,
			Count: n,
			Mean:  round4(mean),
			Std:   round4(math.Sqrt(variance)),
			Min:   round4(minValue(obs)),
			Max:   round4(maxValue(obs)),
		})
	}

	grandMean := 0.0
	if totalN > 0 {
		grandMean = grandSum / float64(totalN)
	}

	k := len(values)
	betweenVariance := 0.0
	withinVariance := 0.0
	if k > 1 && totalN > k {
		for _, v := range values {
			n := len(groupValues[v])
			diff := groupMeans[v] - grandMean
			betweenVariance += float64(n) * diff * diff
			withinVariance += float64(n-1) * groupVars[v]
		}
		betweenVariance /= float64(k - 1)
		withinVariance /= float64(totalN - k)
	}

	var anovaF *float64
	if k > 1 && totalN > k && withinVariance > 0 {
		f := betweenVariance / withinVariance
		f = round4(f)
		anovaF = &f
	}

	var effectSize *float64
	pooledStd := math.Sqrt(withinVariance)
	if k > 1 && totalN > k && pooledStd > 0 {
		maxMean := groupMeans[values[0]]
		minMean := groupMeans[values[0]]
		for _, v := range values {
			if groupMeans[v] > maxMean {
				maxMean = groupMeans[v]
			}
			if groupMeans[v] < minMean {
				minMean = groupMeans[v]
			}
		}
		es := round4((maxMean - minMean) / pooledStd)
		effectSize = &es
	}

	bestValue := ""
	bestMean := 0.0
	for _, v := range values {
		mean := groupMeans[v]
		if bestValue == "" {
			bestValue = v
			bestMean = mean
			continue
		}
		if objective == "minimize" {
			if mean < bestMean {
				bestValue = v
				bestMean = mean
			}
		} else {
			if mean > bestMean {
				bestValue = v
				bestMean = mean
			}
		}
	}

	out := struct {
		Parameter  string     `json:"parameter"`
		Metric     string     `json:"metric"`
		Objective  string     `json:"objective"`
		Groups     []groupOut `json:"groups"`
		AnovaF     *float64   `json:"anova_f"`
		BestValue  string     `json:"best_value"`
		EffectSize *float64   `json:"effect_size"`
	}{
		Parameter:  paramName,
		Metric:     metricName,
		Objective:  objective,
		Groups:     groups,
		AnovaF:     anovaF,
		BestValue:  bestValue,
		EffectSize: effectSize,
	}

	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	if err := enc.Encode(out); err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	return 0
}

func meanValue(values []float64) float64 {
	if len(values) == 0 {
		return 0
	}
	sum := 0.0
	for _, v := range values {
		sum += v
	}
	return sum / float64(len(values))
}

func sampleStd(values []float64) float64 {
	n := len(values)
	if n <= 1 {
		return 0.0
	}
	mean := meanValue(values)
	ss := 0.0
	for _, v := range values {
		diff := v - mean
		ss += diff * diff
	}
	return math.Sqrt(ss / float64(n-1))
}

func minValue(values []float64) float64 {
	if len(values) == 0 {
		return 0
	}
	m := values[0]
	for _, v := range values {
		if v < m {
			m = v
		}
	}
	return m
}

func maxValue(values []float64) float64 {
	if len(values) == 0 {
		return 0
	}
	m := values[0]
	for _, v := range values {
		if v > m {
			m = v
		}
	}
	return m
}

func runExperiment(p *Pipeline, combo map[string]interface{}, resume bool) error {
	id := experimentID(combo)
	stageMap := make(map[string]Stage)
	for _, stage := range p.Stages {
		stageMap[stage.Name] = stage
	}
	groups, err := topologicalGroups(p)
	if err != nil {
		return err
	}
	metrics := make(map[string]float64)
	for _, group := range groups {
		for _, name := range group {
			stage := stageMap[name]
			if resume {
				if st, err := readStageState(id, name); err == nil && (st.Status == "completed" || st.Status == "skipped") {
					for _, m := range st.Metrics {
						metrics[m.Name] = m.Value
					}
					continue
				}
			}
			if stage.Condition != nil {
				val, ok := metrics[stage.Condition.Metric]
				if !ok || !compareMetric(val, stage.Condition.Operator, stage.Condition.Threshold) {
					st := &StageState{
						Name:      name,
						Status:    "skipped",
						ExitCode:  0,
						StartTime: time.Now().Format(time.RFC3339),
						EndTime:   time.Now().Format(time.RFC3339),
					}
					if err := writeStageState(id, name, st); err != nil {
						return err
					}
					continue
				}
			}
			st, err := runStage(id, stage, combo)
			if err != nil {
				return err
			}
			for _, m := range st.Metrics {
				metrics[m.Name] = m.Value
			}
			_ = updateArtifactIndex(id, name, stage)
		}
	}
	return nil
}

func runStage(experimentID string, stage Stage, combo map[string]interface{}) (*StageState, error) {
	maxAttempts := 1
	backoff := 0.0
	if stage.Retry != nil && stage.Retry.MaxAttempts > 0 {
		maxAttempts = stage.Retry.MaxAttempts
		backoff = stage.Retry.BackoffSeconds
	}
	var lastErr error
	for attempt := 1; attempt <= maxAttempts; attempt++ {
		cmd := exec.Command("sh", "-c", stage.Command)
		cmd.Env = os.Environ()
		for k, v := range stage.Env {
			cmd.Env = append(cmd.Env, k+"="+substituteParams(v, combo))
		}
		var stdout bytes.Buffer
		cmd.Stdout = &stdout
		cmd.Stderr = os.Stderr
		start := time.Now()
		runErr := cmd.Run()
		if runErr == nil {
			st := &StageState{
				Name:      stage.Name,
				Status:    "completed",
				ExitCode:  0,
				Metrics:   parseMetrics(stdout.String()),
				StartTime: start.Format(time.RFC3339),
				EndTime:   time.Now().Format(time.RFC3339),
				Retries:   attempt - 1,
			}
			if err := writeStageState(experimentID, stage.Name, st); err != nil {
				return nil, err
			}
			return st, nil
		}
		lastErr = runErr
		if attempt < maxAttempts && backoff > 0 {
			time.Sleep(time.Duration(backoff * float64(time.Second)))
		}
	}
	st := &StageState{
		Name:      stage.Name,
		Status:    "failed",
		ExitCode:  exitCodeFromError(lastErr),
		StartTime: time.Now().Format(time.RFC3339),
		EndTime:   time.Now().Format(time.RFC3339),
		Retries:   maxAttempts - 1,
	}
	_ = writeStageState(experimentID, stage.Name, st)
	return nil, fmt.Errorf("stage %s failed: %w", stage.Name, lastErr)
}

func parseMetrics(output string) []MetricData {
	var metrics []MetricData
	scanner := bufio.NewScanner(strings.NewReader(output))
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || !strings.HasPrefix(line, "{") {
			continue
		}
		var m MetricData
		if err := json.Unmarshal([]byte(line), &m); err == nil && m.Name != "" {
			metrics = append(metrics, m)
			continue
		}
		var mm map[string]interface{}
		if err := json.Unmarshal([]byte(line), &mm); err == nil {
			if name, ok := mm["metric"].(string); ok {
				metrics = append(metrics, MetricData{Name: name, Value: asFloat(mm["value"])})
			}
		}
	}
	return metrics
}

func compareMetric(val float64, op string, threshold float64) bool {
	switch op {
	case ">=":
		return val >= threshold
	case ">":
		return val > threshold
	case "<=":
		return val <= threshold
	case "<":
		return val < threshold
	case "==":
		return val == threshold
	case "!=":
		return val != threshold
	default:
		return false
	}
}

func exitCodeFromError(err error) int {
	if exiterr, ok := err.(*exec.ExitError); ok {
		return exiterr.ExitCode()
	}
	return 1
}

func updateArtifactIndex(experimentID, stageName string, stage Stage) error {
	idx := loadArtifactIndex()
	for _, out := range stage.Outputs {
		info, err := os.Stat(out.Path)
		if err != nil {
			continue
		}
		f, err := os.Open(out.Path)
		if err != nil {
			continue
		}
		h := sha256.New()
		if _, err := io.Copy(h, f); err != nil {
			f.Close()
			continue
		}
		f.Close()
		idx.Entries = append(idx.Entries, ArtifactEntry{
			ExperimentID: experimentID,
			StageName:    stageName,
			Path:         out.Path,
			Hash:         hex.EncodeToString(h.Sum(nil)),
			Size:         info.Size(),
		})
	}
	return saveArtifactIndex(idx)
}

type compareExperimentData struct {
	ID       string
	Pipeline string
	Metrics  map[string]float64
}

func collectExperimentMetrics(p *Pipeline, id string) map[string]float64 {
	metrics := map[string]float64{}
	for _, stage := range p.Stages {
		if st, err := readStageState(id, stage.Name); err == nil {
			for _, m := range st.Metrics {
				metrics[m.Name] = m.Value
			}
		}
	}
	return metrics
}

func dominates(a, b map[string]float64, metrics []string) bool {
	strictlyBetter := false
	for _, m := range metrics {
		if a[m] < b[m] {
			return false
		}
		if a[m] > b[m] {
			strictlyBetter = true
		}
	}
	return strictlyBetter
}

func cmdCompare(args []string) int {
	if len(args) < 2 {
		fmt.Fprintln(os.Stderr, "Usage: mlpipe compare <pipeline1.yaml> <pipeline2.yaml> ...")
		return 1
	}

