   846			keys = append(keys, k)
   847		}
   848		sort.Strings(keys)
   849		return keys
   850	}
   851	
   852	func stateDir(experimentID string) string {
   853		return filepath.Join(".mlpipe", "state", experimentID)
   854	}
   855	
   856	func stageStatePath(experimentID, stageName string) string {
   857		return filepath.Join(stateDir(experimentID), stageName+".json")
   858	}
   859	
   860	func experimentStateExists(id string) bool {
   861		info, err := os.Stat(stateDir(id))
   862		return err == nil && info.IsDir()
   863	}
   864	
   865	func readStageState(experimentID, stageName string) (*StageState, error) {
   866		data, err := os.ReadFile(stageStatePath(experimentID, stageName))
   867		if err != nil {
   868			return nil, err
   869		}
   870		var st StageState
   871		if err := json.Unmarshal(data, &st); err != nil {
   872			return nil, err
   873		}
   874		return &st, nil
   875	}
   876	
   877	func writeStageState(experimentID, stageName string, st *StageState) error {
   878		if err := os.MkdirAll(stateDir(experimentID), 0755); err != nil {
   879			return err
   880		}
   881		data, err := json.MarshalIndent(st, "", "  ")
   882		if err != nil {
   883			return err
   884		}
   885		return os.WriteFile(stageStatePath(experimentID, stageName), data, 0644)
   886	}
   887	
   888	func artifactsIndexPath() string {
   889		return filepath.Join(".mlpipe", "artifacts", "index.json")
   890	}
