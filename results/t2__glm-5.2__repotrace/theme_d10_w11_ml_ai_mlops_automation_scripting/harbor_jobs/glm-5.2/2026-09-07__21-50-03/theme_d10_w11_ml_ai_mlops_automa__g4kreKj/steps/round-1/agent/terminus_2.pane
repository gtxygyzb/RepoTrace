   109			fmt.Fprintln(os.Stderr, "error:", err)
   110			return 1
   111		}
   112		return 0
   113	}
   114	
   115	func cmdRun(args []string) int {
   116		pipelineFile, experimentIndex, resume, err := parseRunArgs(args)
   117		if err != nil {
   118			fmt.Fprintln(os.Stderr, "error:", err)
   119			return 1
   120		}
   121		p, err := loadPipeline(pipelineFile)
   122		if err != nil {
   123			fmt.Fprintln(os.Stderr, "error:", err)
   124			return 1
   125		}
   126		if errs := validatePipeline(p); len(errs) > 0 {
   127			for _, e := range errs {
   128				fmt.Fprintln(os.Stderr, e)
   129			}
   130			return 1
   131		}
   132		combos := parameterCombinations(p)
   133		if experimentIndex >= 0 {
   134			if experimentIndex >= len(combos) {
   135				fmt.Fprintf(os.Stderr, "error: experiment index %d out of range (0..%d)\n", experimentIndex, len(combos)-1)
   136				return 1
   137			}
   138			combos = []map[string]interface{}{combos[experimentIndex]}
   139		}
   140		for _, combo := range combos {
   141			id := experimentID(combo)
   142			fmt.Fprintf(os.Stderr, "Running experiment %s\n", id)
   143			if err := runExperiment(p, combo, resume); err != nil {
   144				fmt.Fprintln(os.Stderr, "error:", err)
   145				return 1
   146			}
   147		}
   148		return 0
   149	}
   150	
   151	func cmdReport(args []string) int {
   152		if len(args) < 1 {
   153			fmt.Fprintln(os.Stderr, "Usage: mlpipe report <pipeline.yaml>")
   154			return 1
   155		}
   156		p, err := loadPipeline(args[0])
   157		if err != nil {
   158			fmt.Fprintln(os.Stderr, "error:", err)
   159			return 1
   160		}
   161		if errs := validatePipeline(p); len(errs) > 0 {
   162			for _, e := range errs {
   163				fmt.Fprintln(os.Stderr, e)
   164			}
   165			return 1
   166		}
   167		return reportPipeline(p)
   168	}
