[?2004l   790	func parameterCombinations(p *Pipeline) []map[string]interface{} {
   791		if len(p.Parameters) == 0 {
   792			return []map[string]interface{}{{}}
   793		}
   794		combos := []map[string]interface{}{{}}
   795		for _, param := range p.Parameters {
   796			next := make([]map[string]interface{}, 0, len(combos)*len(param.Values))
   797			for _, combo := range combos {
   798				for _, value := range param.Values {
   799					c := copyMap(combo)
   800					c[param.Name] = value
   801					next = append(next, c)
   802				}
   803			}
   804			combos = next
   805		}
   806		return combos
   807	}
   808	
   809	func experimentID(combo map[string]interface{}) string {
   810		if len(combo) == 0 {
   811			return "exp_default"
   812		}
   813		keys := make([]string, 0, len(combo))
   814		for k := range combo {
   815			keys = append(keys, k)
   816		}
   817		sort.Strings(keys)
   818		parts := make([]string, 0, len(keys))
   819		for _, k := range keys {
   820			parts = append(parts, k+"="+asString(combo[k]))
   821		}
   822		return "exp_" + strings.Join(parts, "_")
   823	}
   824	
   825	func substituteParams(value string, combo map[string]interface{}) string {
   826		for k, v := range combo {
