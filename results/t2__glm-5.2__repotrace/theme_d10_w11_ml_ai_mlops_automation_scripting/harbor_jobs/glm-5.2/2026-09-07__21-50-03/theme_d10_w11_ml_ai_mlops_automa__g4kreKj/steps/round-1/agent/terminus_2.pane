   943	func reportPipeline(p *Pipeline) int {
   944		type reportExperiment struct {
   945			ID      string             `json:"id"`
   946			Metrics map[string]float64 `json:"metrics"`
   947			Stages  []StageState       `json:"stages"`
   948		}
