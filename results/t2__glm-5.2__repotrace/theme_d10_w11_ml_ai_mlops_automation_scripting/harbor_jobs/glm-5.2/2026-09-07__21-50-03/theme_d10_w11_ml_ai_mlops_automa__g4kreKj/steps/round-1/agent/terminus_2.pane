   167	}
   168	p, err := loadPipeline(pipelineFile)
   169	if err != nil {
   170	fmt.Fprintln(os.Stderr, "error:", err)
   171	return 1
   172	}
   173	if gc {
   174	return artifactsGC(p)
   175	}
   176	_ = list
   177	return artifactsList()
   178	}
