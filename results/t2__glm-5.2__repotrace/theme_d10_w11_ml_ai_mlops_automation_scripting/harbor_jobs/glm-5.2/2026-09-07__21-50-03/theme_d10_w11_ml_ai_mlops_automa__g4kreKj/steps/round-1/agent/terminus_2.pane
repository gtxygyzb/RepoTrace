  1151	type compareExperimentData struct {
  1152		ID       string
  1153		Pipeline string
  1154		Metrics  map[string]float64
  1155	}
  1156	
  1157	func collectExperimentMetrics(p *Pipeline, id string) map[string]float64 {
  1158		metrics := map[string]float64{}
  1159		for _, stage := range p.Stages {
  1160			if st, err := readStageState(id, stage.Name); err == nil {
  1161				for _, m := range st.Metrics {
  1162					metrics[m.Name] = m.Value
  1163				}
  1164			}
  1165		}
  1166		return metrics
  1167	}
  1168	
  1169	func dominates(a, b map[string]float64, metrics []string) bool {
  1170		strictlyBetter := false
  1171		for _, m := range metrics {
  1172			if a[m] < b[m] {
  1173				return false
  1174			}
  1175			if a[m] > b[m] {
  1176				strictlyBetter = true
  1177			}
  1178		}
  1179		return strictlyBetter
  1180	}
