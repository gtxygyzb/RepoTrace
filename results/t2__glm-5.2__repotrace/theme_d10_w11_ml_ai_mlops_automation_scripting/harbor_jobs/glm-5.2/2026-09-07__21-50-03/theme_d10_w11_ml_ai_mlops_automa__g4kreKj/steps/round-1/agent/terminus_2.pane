	Name       string
	Version    string
	Parameters []Parameter
	Stages     []Stage
}

type Parameter struct {
	Name   string
	Values []interface{}
}

type Stage struct {
	Name      string
	Command   string
	DependsOn []string
	Env       map[string]string
	Metrics   []Metric
	Retry     *Retry
	Condition *Condition
