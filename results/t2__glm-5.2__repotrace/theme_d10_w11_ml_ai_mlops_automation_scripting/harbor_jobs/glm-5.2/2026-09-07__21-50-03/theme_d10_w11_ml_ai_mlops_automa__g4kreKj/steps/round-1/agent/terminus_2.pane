   695	func validatePipeline(p *Pipeline) []string {
   696		var errs []string
   697		names := make(map[string]int)
   698		stageSet := make(map[string]bool)
   699		stageMap := make(map[string]Stage)
   700	
   701		for i, stage := range p.Stages {
   702			if stage.Name == "" {
   703				errs = append(errs, fmt.Sprintf("stage %d: missing required field name", i))
   704			}
   705			if stage.Command == "" {
   706				errs = append(errs, fmt.Sprintf("stage %d: missing required field command", i))
   707			}
   708			if stage.Name != "" {
   709				if prev, ok := names[stage.Name]; ok {
   710					errs = append(errs, fmt.Sprintf("duplicate stage name: %s (stages %d and %d)", stage.Name, prev, i))
   711				} else {
   712					names[stage.Name] = i
   713				}
   714				stageSet[stage.Name] = true
   715				stageMap[stage.Name] = stage
   716			}
   717		}
   718	
   719		for _, stage := range p.Stages {
   720			for _, dep := range stage.DependsOn {
   721				if !stageSet[dep] {
   722					errs = append(errs, fmt.Sprintf("stage %q depends on undefined stage %q", stage.Name, dep))
   723				}
   724			}
   725		}
   726	
   727		for _, stage := range p.Stages {
   728			if stage.Name == "" {
   729				continue
   730			}
   731			state := make(map[string]int)
   732			var check func(name string)
   733			check = func(name string) {
   734				state[name] = 1
   735				for _, dep := range stageMap[name].DependsOn {
   736					if !stageSet[dep] {
   737						continue
   738					}
   739					if state[dep] == 1 {
   740						errs = append(errs, fmt.Sprintf("circular dependency detected involving stage: %s", name))
   741					} else if state[dep] == 0 {
   742						check(dep)
   743					}
   744				}
   745				state[name] = 2
   746			}
   747			check(stage.Name)
   748		}
   749	
   750		return errs
   751	}
   752	
   753	func topologicalGroups(p *Pipeline) ([][]string, error) {
   754		stageMap := make(map[string]Stage)
   755		for _, stage := range p.Stages {
   756			stageMap[stage.Name] = stage
   757		}
   758	
   759		completed := make(map[string]bool)
   760		remaining := make(map[string]bool)
   761		for _, stage := range p.Stages {
   762			remaining[stage.Name] = true
   763		}
   764	
   765		var groups [][]string
   766		for len(remaining) > 0 {
   767			var ready []string
   768			for name := range remaining {
   769				ok := true
   770				for _, dep := range stageMap[name].DependsOn {
   771					if !completed[dep] {
   772						ok = false
   773						break
   774					}
   775				}
   776				if ok {
   777					ready = append(ready, name)
   778				}
   779			}
   780			sort.Strings(ready)
   781			if len(ready) == 0 {
   782				return nil, fmt.Errorf("circular dependency detected among stages: %v", sortedKeys(remaining))
   783			}
   784			groups = append(groups, ready)
   785			for _, name := range ready {
   786				completed[name] = true
   787				delete(remaining, name)
   788			}
   789		}
   790		return groups, nil
   791	}
   792	
   793	func parameterCombinations(p *Pipeline) []map[string]interface{} {
   794		if len(p.Parameters) == 0 {
   795			return []map[string]interface{}{{}}
   796		}
   797		combos := []map[string]interface{}{{}}
   798		for _, param := range p.Parameters {
   799			next := make([]map[string]interface{}, 0, len(combos)*len(param.Values))
   800			for _, combo := range combos {
   801				for _, value := range param.Values {
   802					c := copyMap(combo)
   803					c[param.Name] = value
   804					next = append(next, c)
   805				}
   806			}
   807			combos = next
   808		}
   809		return combos
   810	}
   811	
   812	func experimentID(combo map[string]interface{}) string {
   813		if len(combo) == 0 {
   814			return "exp_default"
   815		}
   816		keys := make([]string, 0, len(combo))
   817		for k := range combo {
   818			keys = append(keys, k)
   819		}
   820		sort.Strings(keys)
   821		parts := make([]string, 0, len(keys))
   822		for _, k := range keys {
   823			parts = append(parts, k+"="+asString(combo[k]))
   824		}
   825		return "exp_" + strings.Join(parts, "_")
   826	}
