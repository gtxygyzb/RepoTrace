  1182	func cmdCompare(args []string) int {
  1183		if len(args) < 2 {
  1184			fmt.Fprintln(os.Stderr, "Usage: mlpipe compare <pipeline1.yaml> <pipeline2.yaml> ...")
  1185			return 1
  1186		}
  1187	
  1188		type pipelineInfo struct {
  1189			Name     string
  1190			Pipeline *Pipeline
  1191			IDs      []string
  1192		}
  1193		var pipelines []pipelineInfo
  1194		idToPipeline := make(map[string]int)
  1195	
  1196		for i, file := range args {
  1197			p, err := loadPipeline(file)
  1198			if err != nil {
  1199				fmt.Fprintln(os.Stderr, "error:", err)
  1200				return 1
  1201			}
  1202			if errs := validatePipeline(p); len(errs) > 0 {
  1203				for _, e := range errs {
  1204					fmt.Fprintln(os.Stderr, e)
  1205				}
  1206				return 1
  1207			}
  1208			info := pipelineInfo{Name: p.Name, Pipeline: p}
  1209			for _, combo := range parameterCombinations(p) {
  1210				id := experimentID(combo)
  1211				if prev, ok := idToPipeline[id]; ok {
  1212					fmt.Fprintf(os.Stderr, "error: experiment ID collision: %s between pipelines %s and %s\n", id, pipelines[prev].Name, p.Name)
  1213					return 1
  1214				}
  1215				idToPipeline[id] = i
  1216				info.IDs = append(info.IDs, id)
  1217			}
  1218			pipelines = append(pipelines, info)
  1219		}
  1220	
  1221		for _, info := range pipelines {
  1222			matching := 0
  1223			for _, id := range info.IDs {
  1224				if experimentStateExists(id) {
  1225					matching++
  1226				}
  1227			}
  1228			if matching == 0 {
  1229				fmt.Fprintf(os.Stderr, "error: pipeline %s has no matching experiments under .mlpipe/state\n", info.Name)
  1230				return 1
  1231			}
  1232		}
  1233	
  1234		metricObjective := make(map[string]string)
  1235		for i, info := range pipelines {
  1236			pm := make(map[string]string)
  1237			for _, stage := range info.Pipeline.Stages {
  1238				for _, m := range stage.Metrics {
  1239					if m.Objective != "minimize" && m.Objective != "maximize" {
  1240						continue
  1241					}
  1242					if existing, ok := pm[m.Name]; ok && existing != m.Objective {
  1243						fmt.Fprintf(os.Stderr, "error: conflicting objective for metric %s in pipeline %s\n", m.Name, info.Name)
  1244						return 1
  1245					}
  1246					pm[m.Name] = m.Objective
  1247				}
  1248			}
  1249			if i == 0 {
  1250				metricObjective = pm
  1251			} else {
  1252				for k, v := range metricObjective {
  1253					if v2, ok := pm[k]; !ok || v2 != v {
  1254						delete(metricObjective, k)
  1255					}
  1256				}
  1257			}
  1258		}
  1259		sharedMetrics := make([]string, 0, len(metricObjective))
  1260		for k := range metricObjective {
  1261			sharedMetrics = append(sharedMetrics, k)
  1262		}
  1263		sort.Strings(sharedMetrics)
  1264		if len(sharedMetrics) == 0 {
