   107	func cmdRun(args []string) int {
   108	pipelineFile, experimentIndex, resume, err := parseRunArgs(args)
   109	if err != nil {
   110	fmt.Fprintln(os.Stderr, "error:", err)
   111	return 1
   112	}
   113	p, err := loadPipeline(pipelineFile)
   114	if err != nil {
   115	fmt.Fprintln(os.Stderr, "error:", err)
   116	return 1
   117	}
   118	if errs := validatePipeline(p); len(errs) > 0 {
   119	for _, e := range errs {
   120	fmt.Fprintln(os.Stderr, e)
   121	}
   122	return 1
   123	}
   124	combos := parameterCombinations(p)
   125	if experimentIndex >= 0 {
   126	if experimentIndex >= len(combos) {
   127	fmt.Fprintf(os.Stderr, "error: experiment index %d out of range (0..%d)\n", experimentIndex, len(combos)-1)
   128	return 1
   129	}
   130	combos = []map[string]interface{}{combos[experimentIndex]}
   131	}
   132	for _, combo := range combos {
   133	id := experimentID(combo)
   134	fmt.Fprintf(os.Stderr, "Running experiment %s\n", id)
   135	if err := runExperiment(p, combo, resume); err != nil {
   136	fmt.Fprintln(os.Stderr, "error:", err)
   137	return 1
   138	}
   139	}
   140	return 0
   141	}
