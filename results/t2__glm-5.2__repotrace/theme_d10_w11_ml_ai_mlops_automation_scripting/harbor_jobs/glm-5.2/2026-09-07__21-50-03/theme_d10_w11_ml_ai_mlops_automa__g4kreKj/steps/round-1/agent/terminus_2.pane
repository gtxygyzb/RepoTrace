   628	
   629	func asString(v interface{}) string {
   630		if v == nil {
   631			return ""
   632		}
   633		switch x := v.(type) {
   634		case string:
   635			return x
   636		case int:
   637			return strconv.Itoa(x)
   638		case float64:
   639			return formatFloat(x)
   640		case bool:
   641			return strconv.FormatBool(x)
   642		default:
   643			return fmt.Sprint(x)
   644		}
   645	}
   646	
   647	func asInt(v interface{}) int {
   648		switch x := v.(type) {
   649		case int:
   650			return x
   651		case float64:
   652			return int(x)
   653		case string:
   654			n, _ := strconv.Atoi(x)
   655			return n
   656		default:
   657			return 0
   658		}
   659	}
   660	
   661	func asFloat(v interface{}) float64 {
   662		switch x := v.(type) {
   663		case float64:
   664			return x
   665		case int:
   666			return float64(x)
   667		case string:
   668			f, _ := strconv.ParseFloat(x, 64)
   669			return f
   670		default:
   671			return 0
   672		}
   673	}
   674	
   675	func toStringSlice(v []interface{}) []string {
   676		out := make([]string, 0, len(v))
   677		for _, item := range v {
   678			out = append(out, asString(item))
   679		}
   680		return out
   681	}
   682	
   683	func toStringMap(m map[string]interface{}) map[string]string {
   684		out := make(map[string]string)
   685		for k, v := range m {
   686			out[k] = asString(v)
   687		}
   688		return out
   689	}
