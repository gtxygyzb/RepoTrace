   364	
   365	func parseSequence(lines []yamlLine, idx int, indent int) (interface{}, int) {
   366		seq := []interface{}{}
   367		for idx < len(lines) && lines[idx].indent == indent && (strings.HasPrefix(lines[idx].content, "- ") || lines[idx].content == "-") {
   368			content := strings.TrimPrefix(lines[idx].content, "-")
   369			content = strings.TrimLeft(content, " ")
   370			if content == "" {
   371				val, next := parseBlock(lines, idx+1, indent+2)
   372				seq = append(seq, val)
   373				idx = next
   374				continue
   375			}
   376			if isMappingStart(content) {
   377				sublines := []yamlLine{{indent: indent + 2, content: content}}
   378				start := idx + 1
   379				for start < len(lines) && lines[start].indent > indent {
   380					sublines = append(sublines, lines[start])
   381					start++
   382				}
   383				val, _ := parseBlock(sublines, 0, indent+2)
   384				seq = append(seq, val)
   385				idx = start
   386			} else {
   387				seq = append(seq, parseScalar(content))
   388				idx++
   389			}
   390		}
   391		return seq, idx
   392	}
   393	
   394	func parseMapping(lines []yamlLine, idx int, indent int) (interface{}, int) {
   395		m := map[string]interface{}{}
   396		for idx < len(lines) && lines[idx].indent == indent {
   397			content := lines[idx].content
   398			if strings.HasPrefix(content, "- ") || content == "-" {
   399				break
   400			}
   401			key, value, ok := splitKeyValue(content)
   402			if !ok {
   403				return nil, idx
   404			}
   405			if value != "" {
   406				m[key] = parseScalar(value)
   407				idx++
   408			} else {
   409				val, next := parseBlock(lines, idx+1, indent+2)
   410				m[key] = val
   411				idx = next
   412			}
   413		}
   414		return m, idx
   415	}
   416	
   417	func isMappingStart(s string) bool {
   418		if strings.HasPrefix(s, "[") || strings.HasPrefix(s, "{") {
   419			return false
   420		}
   421		_, _, ok := splitKeyValue(s)
   422		return ok
   423	}
