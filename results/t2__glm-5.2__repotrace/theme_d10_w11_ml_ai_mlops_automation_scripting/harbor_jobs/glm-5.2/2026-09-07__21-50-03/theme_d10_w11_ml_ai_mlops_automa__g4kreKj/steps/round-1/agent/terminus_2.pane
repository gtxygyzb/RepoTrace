   550	func unquoteScalar(s string) string {
   551		s = strings.TrimSpace(s)
   552		if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
   553			unq, err := strconv.Unquote(s)
   554			if err == nil {
   555				return unq
   556			}
   557			return s[1 : len(s)-1]
   558		}
   559		if len(s) >= 2 && s[0] == '\'' && s[len(s)-1] == '\'' {
   560			return strings.ReplaceAll(s[1:len(s)-1], "''", "'")
   561		}
   562		return s
   563	}
