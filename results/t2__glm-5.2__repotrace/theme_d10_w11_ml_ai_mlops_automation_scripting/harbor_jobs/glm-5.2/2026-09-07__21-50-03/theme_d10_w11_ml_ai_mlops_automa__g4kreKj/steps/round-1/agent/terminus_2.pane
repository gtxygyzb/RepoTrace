   695		stageSet := make(map[string]bool)
   696		stageMap := make(map[string]Stage)
   697	
   698		for i, stage := range p.Stages {
   699			if stage.Name == "" {
   700				errs = append(errs, fmt.Sprintf("stage %d: missing required field name", i))
   701			}
   702			if stage.Command == "" {
   703				errs = append(errs, fmt.Sprintf("stage %d: missing required field command", i))
   704			}
   705			if stage.Name != "" {
   706				if prev, ok := names[stage.Name]; ok {
   707					errs = append(errs, fmt.Sprintf("duplicate stage name: %s (stages %d and %d)", stage.Name, prev, i))
   708				} else {
   709					names[stage.Name] = i
   710				}
   711				stageSet[stage.Name] = true
   712				stageMap[stage.Name] = stage
   713			}
   714		}
   715	
   716		for _, stage := range p.Stages {
   717			for _, dep := range stage.DependsOn {
   718				if !stageSet[dep] {
   719					errs = append(errs, fmt.Sprintf("stage %q depends on undefined stage %q", stage.Name, dep))
   720				}
