			if vals, ok := metricValues[m]; ok && len(vals) > 0 {
				minVal[m] = minValue(vals)
				maxVal[m] = maxValue(vals)
			}
		}

		normalized := make([]map[string]float64, len(out.Experiments))
		for i, exp := range out.Experiments {
			normalized[i] = make(map[string]float64)
			normOut := make(map[string]float64)
			for _, m := range objMetrics {
				val, ok := exp.Metrics[m]
				if !ok {
					continue
				}
				rng := maxVal[m] - minVal[m]
				var norm float64
				if rng == 0 {
					norm = 0.5
				} else if objectives[m] == "maximize" {
					norm = (val - minVal[m]) / rng
				} else {
					norm = (maxVal[m] - val) / rng
				}
				normalized[i][m] = norm
				normOut[m] = round4(norm)
			}
			out.NormalizedMetrics[exp.ID] = normOut
		}

		composite := make([]float64, len(out.Experiments))
		for i := range out.Experiments {
			if len(normalized[i]) == 0 {
				composite[i] = 0
			} else {
				sum := 0.0
				for _, m := range objMetrics {
					if norm, ok := normalized[i][m]; ok {
						sum += norm
					}
				}
				composite[i] = sum / float64(len(normalized[i]))
