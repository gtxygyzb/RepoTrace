func saveArtifactIndex(idx *ArtifactIndex) error {
	if err := os.MkdirAll(filepath.Dir(artifactsIndexPath()), 0755); err != nil {
		return err
	}
	data, err := json.MarshalIndent(idx, "", "  ")
	if err != nil {
		return err
	}
	return os.WriteFile(artifactsIndexPath(), data, 0644)
}

func artifactsList() int {
	idx := loadArtifactIndex()
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	if err := enc.Encode(idx); err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	return 0
}

func artifactsGC(p *Pipeline) int {
	expected := make(map[string]bool)
	for _, combo := range parameterCombinations(p) {
		expected[experimentID(combo)] = true
	}
	entries, err := os.ReadDir(filepath.Join(".mlpipe", "state"))
	if err != nil {
		return 0
	}
	for _, entry := range entries {
		if !expected[entry.Name()] {
			_ = os.RemoveAll(filepath.Join(".mlpipe", "state", entry.Name()))
		}
	}
	return 0
}

func reportPipeline(p *Pipeline) int {
	type reportExperiment struct {
		ID      string             `json:"id"`
		Metrics map[string]float64 `json:"metrics"`
		Stages  []StageState       `json:"stages"`
	}
	type sensitivityEntry struct {
		BestWithout  string  `json:"best_without"`
		MaxComposite float64 `json:"max_composite"`
	}
	type reportOutput struct {
		Pipeline          string                        `json:"pipeline"`
		Experiments       []reportExperiment            `json:"experiments"`
		MetricSummary     map[string]metricSummaryEntry `json:"metric_summary"`
		MetricRankings    map[string]map[string]int     `json:"metric_rankings"`
		CompositeScores   map[string]float64            `json:"composite_scores"`
		NormalizedMetrics map[string]map[string]float64 `json:"normalized_metrics"`
		MetricImportance  map[string]float64            `json:"metric_importance"`
		ScoreSensitivity  map[string]sensitivityEntry   `json:"score_sensitivity"`
		BestExperiment    string                        `json:"best_experiment"`
	}

	out := reportOutput{
		Pipeline:          p.Name,
		Experiments:       []reportExperiment{},
		MetricSummary:     map[string]metricSummaryEntry{},
		MetricRankings:    map[string]map[string]int{},
		CompositeScores:   map[string]float64{},
		NormalizedMetrics: map[string]map[string]float64{},
		MetricImportance:  map[string]float64{},
		ScoreSensitivity:  map[string]sensitivityEntry{},
	}
	metricValues := map[string][]float64{}
	for _, combo := range parameterCombinations(p) {
		id := experimentID(combo)
		exp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}
		for _, stage := range p.Stages {
			if st, err := readStageState(id, stage.Name); err == nil {
				exp.Stages = append(exp.Stages, *st)
				for _, m := range st.Metrics {
					exp.Metrics[m.Name] = m.Value
					metricValues[m.Name] = append(metricValues[m.Name], m.Value)
				}
			}
		}
		out.Experiments = append(out.Experiments, exp)
	}
	for name, values := range metricValues {
		out.MetricSummary[name] = metricSummaryEntry{
			Count: len(values),
			Mean:  round4(meanValue(values)),
			Std:   round4(sampleStd(values)),
			Min:   round4(minValue(values)),
			Max:   round4(maxValue(values)),
		}
	}

	objectives := map[string]string{}
	for _, stage := range p.Stages {
		for _, m := range stage.Metrics {
			if m.Objective == "minimize" || m.Objective == "maximize" {
				objectives[m.Name] = m.Objective
			}
		}
	}
	objMetrics := make([]string, 0, len(objectives))
	for m := range objectives {
		if _, ok := metricValues[m]; ok {
			objMetrics = append(objMetrics, m)
		}
	}
	sort.Strings(objMetrics)

	if len(objMetrics) > 0 {
		minVal := map[string]float64{}
		maxVal := map[string]float64{}
		for _, m := range objMetrics {
			if vals, ok := metricValues[m]; ok && len(vals) > 0 {
				minVal[m] = minValue(vals)
				maxVal[m] = maxValue(vals)
			}
		}

		normalized := make([]map[string]float64, len(out.Experiments))
		for i, exp := range out.Experiments {
			normalized[i] = make(map[string]float64)
			normOut := make(map[string]float64)
			for _, m := range objMetrics {
				val, ok := exp.Metrics[m]
				if !ok {
					continue
				}
				rng := maxVal[m] - minVal[m]
				var norm float64
				if rng == 0 {
					norm = 0.5
				} else if objectives[m] == "maximize" {
					norm = (val - minVal[m]) / rng
				} else {
					norm = (maxVal[m] - val) / rng
				}
				normalized[i][m] = norm
				normOut[m] = round4(norm)
			}
			out.NormalizedMetrics[exp.ID] = normOut
		}

		composite := make([]float64, len(out.Experiments))
		for i := range out.Experiments {
			if len(normalized[i]) == 0 {
				composite[i] = 0
			} else {
				sum := 0.0
				for _, m := range objMetrics {
					if norm, ok := normalized[i][m]; ok {
						sum += norm
					}
				}
				composite[i] = sum / float64(len(normalized[i]))
			}
			out.CompositeScores[out.Experiments[i].ID] = round4(composite[i])
		}

		for _, m := range objMetrics {
			out.MetricRankings[m] = map[string]int{}
			type idxVal struct {
				idx int
				val float64
			}
			var items []idxVal
			for i, exp := range out.Experiments {
				if val, ok := exp.Metrics[m]; ok {
					items = append(items, idxVal{i, val})
				}
			}
			sort.SliceStable(items, func(a, b int) bool {
				va := items[a].val
				vb := items[b].val
				if va != vb {
					if objectives[m] == "maximize" {
						return va > vb
					}
					return va < vb
				}
				return out.Experiments[items[a].idx].ID < out.Experiments[items[b].idx].ID
			})
			currentRank := 0
			prevVal := math.NaN()
			for _, item := range items {
				if currentRank == 0 || item.val != prevVal {
					currentRank++
					prevVal = item.val
				}
				out.MetricRankings[m][out.Experiments[item.idx].ID] = currentRank
			}
		}

		for _, m := range objMetrics {
			var norms []float64
			for i := range out.Experiments {
				if norm, ok := normalized[i][m]; ok {
					norms = append(norms, norm)
				}
			}
			out.MetricImportance[m] = round4(sampleStd(norms))
		}

		for _, m := range objMetrics {
			if len(objMetrics) <= 1 {
				bestID := ""
				for _, exp := range out.Experiments {
					if bestID == "" || exp.ID < bestID {
						bestID = exp.ID
					}
				}
				out.ScoreSensitivity[m] = sensitivityEntry{
					BestWithout:  bestID,
					MaxComposite: 0,
				}
				continue
			}
[?2004hroot@n30009:/app# sed -n '1850,2070p' main.go
[?2004l			composite[i] = sum / float64(len(sharedMetrics))
		}
	}

	depth := make([]int, len(included))
	remaining := make([]int, len(included))
	for i := range remaining {
		remaining[i] = i
	}
	currentDepth := 0
	for len(remaining) > 0 {
		nonDom := []int{}
		for _, i := range remaining {
			dominated := false
			for _, j := range remaining {
				if i == j {
					continue
				}
				if dominates(normalized[j], normalized[i], sharedMetrics) {
					dominated = true
					break
				}
			}
			if !dominated {
				nonDom = append(nonDom, i)
			}
		}
		if len(nonDom) == 0 {
			for _, i := range remaining {
				depth[i] = currentDepth
			}
			break
		}
		for _, i := range nonDom {
			depth[i] = currentDepth
		}
		newRemaining := make([]int, 0, len(remaining)-len(nonDom))
		for _, i := range remaining {
			found := false
			for _, j := range nonDom {
				if i == j {
					found = true
					break
				}
			}
			if !found {
				newRemaining = append(newRemaining, i)
			}
		}
		remaining = newRemaining
		currentDepth++
	}

	order := make([]int, len(included))
	for i := range order {
		order[i] = i
	}
	sort.SliceStable(order, func(a, b int) bool {
		if composite[order[a]] != composite[order[b]] {
			return composite[order[a]] > composite[order[b]]
		}
		return included[order[a]].ID < included[order[b]].ID
	})
	rank := make([]int, len(included))
	currentRank := 0
	prevComposite := math.NaN()
	for _, idx := range order {
		if currentRank == 0 || composite[idx] != prevComposite {
			currentRank++
			prevComposite = composite[idx]
		}
		rank[idx] = currentRank
	}

	type experimentOut struct {
		ID              string             `json:"id"`
		Pipeline        string             `json:"pipeline"`
		Metrics         map[string]float64 `json:"metrics"`
		Normalized      map[string]float64 `json:"normalized"`
		CompositeScore  float64            `json:"composite_score"`
		Rank            int                `json:"rank"`
		IsParetoOptimal bool               `json:"is_pareto_optimal"`
		DominanceDepth  int                `json:"dominance_depth"`
	}
	experiments := []experimentOut{}
	for _, idx := range order {
		experiments = append(experiments, experimentOut{
			ID:              included[idx].ID,
			Pipeline:        included[idx].Pipeline,
			Metrics:         filterMetrics(included[idx].Metrics, sharedMetrics),
			Normalized:      normalized[idx],
			CompositeScore:  composite[idx],
			Rank:            rank[idx],
			IsParetoOptimal: depth[idx] == 0,
			DominanceDepth:  depth[idx],
		})
	}

	paretoFrontier := []string{}
	for i, exp := range included {
		if depth[i] == 0 {
			paretoFrontier = append(paretoFrontier, exp.ID)
		}
	}
	sort.Strings(paretoFrontier)

	type correlationOut struct {
		Spearman *float64 `json:"spearman_rho"`
		Kendall  *float64 `json:"kendall_tau"`
		N        int      `json:"n"`
	}
	correlations := map[string]correlationOut{}
	for i := 0; i < len(sharedMetrics); i++ {
		for j := i + 1; j < len(sharedMetrics); j++ {
			rho, tau := computeCorrelations(included, sharedMetrics[i], sharedMetrics[j])
			correlations[sharedMetrics[i]+"_vs_"+sharedMetrics[j]] = correlationOut{Spearman: rho, Kendall: tau, N: len(included)}
		}
	}

	pipelineNames := []string{}
	for _, info := range pipelines {
		pipelineNames = append(pipelineNames, info.Name)
	}
	maxDepth := 0
	paretoCount := 0
	for i := range included {
		if depth[i] > maxDepth {
			maxDepth = depth[i]
		}
		if depth[i] == 0 {
			paretoCount++
		}
	}
	type bestExperiment struct {
		ID             string  `json:"id"`
		Pipeline       string  `json:"pipeline"`
		CompositeScore float64 `json:"composite_score"`
	}
	var best *bestExperiment
	if len(order) > 0 {
		idx := order[0]
		best = &bestExperiment{ID: included[idx].ID, Pipeline: included[idx].Pipeline, CompositeScore: composite[idx]}
	}
	summary := struct {
		Total          int             `json:"total_experiments"`
		ParetoCount    int             `json:"pareto_count"`
		MaxDominance   int             `json:"max_dominance_depth"`
		BestExperiment *bestExperiment `json:"best_experiment"`
	}{
		Total:          len(included),
		ParetoCount:    paretoCount,
		MaxDominance:   maxDepth,
		BestExperiment: best,
	}
	out := struct {
		Pipelines      []string                  `json:"pipelines"`
		SharedMetrics  []string                  `json:"shared_metrics"`
		Experiments    []experimentOut           `json:"experiments"`
		ParetoFrontier []string                  `json:"pareto_frontier"`
		Correlations   map[string]correlationOut `json:"correlations"`
		Summary        struct {
			Total          int             `json:"total_experiments"`
			ParetoCount    int             `json:"pareto_count"`
			MaxDominance   int             `json:"max_dominance_depth"`
			BestExperiment *bestExperiment `json:"best_experiment"`
		} `json:"summary"`
	}{
		Pipelines:      pipelineNames,
		SharedMetrics:  sharedMetrics,
		Experiments:    experiments,
		ParetoFrontier: paretoFrontier,
		Correlations:   correlations,
		Summary:        summary,
	}
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	if err := enc.Encode(out); err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	return 0
}

func computeCorrelations(experiments []compareExperimentData, a, b string) (*float64, *float64) {
	n := len(experiments)
	if n < 3 {
		return nil, nil
	}
	valuesA := make([]float64, n)
	valuesB := make([]float64, n)
	for i, e := range experiments {
		valuesA[i] = e.Metrics[a]
		valuesB[i] = e.Metrics[b]
	}
	rho := spearmanRankCorrelation(valuesA, valuesB)
	r := round4(rho)
	tau := kendallTauB(valuesA, valuesB)
	if tau == nil {
		return &r, nil
	}
	t := round4(*tau)
	return &r, &t
}

func spearmanRankCorrelation(a, b []float64) float64 {
	n := len(a)
	rankA := fractionalRanks(a)
	rankB := fractionalRanks(b)
	sumD2 := 0.0
	for i := 0; i < n; i++ {
		d := rankA[i] - rankB[i]
		sumD2 += d * d
	}
	return 1 - 6*sumD2/(float64(n)*(float64(n)*float64(n)-1))
}

