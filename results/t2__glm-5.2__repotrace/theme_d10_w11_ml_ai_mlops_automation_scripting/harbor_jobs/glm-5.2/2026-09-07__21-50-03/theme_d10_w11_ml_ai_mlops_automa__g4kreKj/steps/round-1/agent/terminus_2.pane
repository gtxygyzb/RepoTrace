python3 - <<'PY'
import json, math, glob, os, subprocess

pipeline = 'pipelines/image_classifier.yaml'
metric = 'train_loss'
param = 'learning_rate'

# parse parameter values from YAML simply by reading the file
import re
text = open(pipeline).read()
params = {}
for m in re.finditer(r'- name: (\w+)\n(?:\s+values:\n((?:\s+- .+\n)+))', text):
    name = m.group(1)
    vals = [v.strip().strip('"').strip("'") for v in re.findall(r'- (.+)', m.group(2))]
    params[name] = vals
print('param values:', params[param])

groups = {}
for d in glob.glob('.mlpipe/state/exp_*'):
    combo = {}
    name = os.path.basename(d)[4:]
    for part in name.split('_'):
        if '=' in part:
            k, v = part.split('=', 1)
            combo[k] = v
    if param not in combo:
        continue
    val = combo[param]
    for state_file in glob.glob(os.path.join(d, '*.json')):
        st = json.load(open(state_file))
        if st.get('status') != 'completed':
            continue
        for m in st.get('metrics', []):
            if m['name'] == metric:
                groups.setdefault(val, []).append(m['value'])

values = sorted(groups)
print('groups:', values)
allvals = [x for v in values for x in groups[v]]
grand_mean = sum(allvals)/len(allvals)
k = len(values)
n = len(allvals)
between = 0.0
within = 0.0
for v in values:
    obs = groups[v]
    mean = sum(obs)/len(obs)
    var = sum((x-mean)**2 for x in obs)/(len(obs)-1) if len(obs)>1 else 0.0
    between += len(obs)*(mean-grand_mean)**2
    within += (len(obs)-1)*var
between /= (k-1)
within /= (n-k)
f = between/within if within else None
pooled = math.sqrt(within)
maxmean = max(sum(groups[v])/len(groups[v]) for v in values)
minmean = min(sum(groups[v])/len(groups[v]) for v in values)
es = (maxmean-minmean)/pooled if pooled else None
print('independent f:', round(f,4) if f is not None else None)
