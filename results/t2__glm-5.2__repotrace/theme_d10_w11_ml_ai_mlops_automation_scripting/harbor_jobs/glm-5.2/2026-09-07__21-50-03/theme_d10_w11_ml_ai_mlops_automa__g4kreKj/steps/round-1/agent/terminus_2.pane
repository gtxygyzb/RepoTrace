   943	func reportPipeline(p *Pipeline) int {
   944		type reportExperiment struct {
   945			ID      string             `json:"id"`
   946			Metrics map[string]float64 `json:"metrics"`
   947			Stages  []StageState       `json:"stages"`
   948		}
   949		type sensitivityEntry struct {
   950			BestWithout  string  `json:"best_without"`
   951			MaxComposite float64 `json:"max_composite"`
   952		}
   953		type reportOutput struct {
   954			Pipeline          string                        `json:"pipeline"`
   955			Experiments       []reportExperiment            `json:"experiments"`
   956			MetricSummary     map[string]metricSummaryEntry `json:"metric_summary"`
   957			MetricRankings    map[string]map[string]int     `json:"metric_rankings"`
   958			CompositeScores   map[string]float64            `json:"composite_scores"`
   959			NormalizedMetrics map[string]map[string]float64 `json:"normalized_metrics"`
   960			MetricImportance  map[string]float64            `json:"metric_importance"`
   961			ScoreSensitivity  map[string]sensitivityEntry   `json:"score_sensitivity"`
   962			BestExperiment    string                        `json:"best_experiment"`
   963		}
   964	
   965		out := reportOutput{
   966			Pipeline:          p.Name,
   967			Experiments:       []reportExperiment{},
   968			MetricSummary:     map[string]metricSummaryEntry{},
   969			MetricRankings:    map[string]map[string]int{},
   970			CompositeScores:   map[string]float64{},
   971			NormalizedMetrics: map[string]map[string]float64{},
   972			MetricImportance:  map[string]float64{},
   973			ScoreSensitivity:  map[string]sensitivityEntry{},
   974		}
   975		metricValues := map[string][]float64{}
   976		for _, combo := range parameterCombinations(p) {
   977			id := experimentID(combo)
   978			exp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}
   979			for _, stage := range p.Stages {
   980				if st, err := readStageState(id, stage.Name); err == nil {
   981					exp.Stages = append(exp.Stages, *st)
   982					for _, m := range st.Metrics {
   983						exp.Metrics[m.Name] = m.Value
   984						metricValues[m.Name] = append(metricValues[m.Name], m.Value)
   985					}
   986				}
   987			}
   988			out.Experiments = append(out.Experiments, exp)
   989		}
   990		for name, values := range metricValues {
   991			out.MetricSummary[name] = metricSummaryEntry{
   992				Count: len(values),
   993				Mean:  round4(meanValue(values)),
   994				Std:   round4(sampleStd(values)),
   995				Min:   round4(minValue(values)),
   996				Max:   round4(maxValue(values)),
   997			}
   998		}
   999	
  1000		objectives := map[string]string{}
  1001		for _, stage := range p.Stages {
  1002			for _, m := range stage.Metrics {
  1003				if m.Objective == "minimize" || m.Objective == "maximize" {
  1004					objectives[m.Name] = m.Objective
  1005				}
  1006			}
  1007		}
  1008		objMetrics := make([]string, 0, len(objectives))
  1009		for m := range objectives {
  1010			if _, ok := metricValues[m]; ok {
  1011				objMetrics = append(objMetrics, m)
  1012			}
  1013		}
  1014		sort.Strings(objMetrics)
  1015	
  1016		if len(objMetrics) > 0 {
  1017			minVal := map[string]float64{}
  1018			maxVal := map[string]float64{}
  1019			for _, m := range objMetrics {
  1020				if vals, ok := metricValues[m]; ok && len(vals) > 0 {
  1021					minVal[m] = minValue(vals)
  1022					maxVal[m] = maxValue(vals)
  1023				}
  1024			}
  1025	
  1026			normalized := make([]map[string]float64, len(out.Experiments))
  1027			for i, exp := range out.Experiments {
  1028				normalized[i] = make(map[string]float64)
  1029				normOut := make(map[string]float64)
  1030				for _, m := range objMetrics {
  1031					val, ok := exp.Metrics[m]
  1032					if !ok {
  1033						continue
