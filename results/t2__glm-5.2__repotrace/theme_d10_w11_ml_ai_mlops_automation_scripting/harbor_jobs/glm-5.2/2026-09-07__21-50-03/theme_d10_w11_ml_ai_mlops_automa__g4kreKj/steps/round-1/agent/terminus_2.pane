   316	type yamlLine struct {
   317		indent  int
   318		content string
   319	}
   320	
   321	func loadPipeline(path string) (*Pipeline, error) {
   322		data, err := os.ReadFile(path)
   323		if err != nil {
   324			return nil, err
   325		}
   326		v, err := parseYAML(data)
   327		if err != nil {
   328			return nil, err
   329		}
   330		return mapToPipeline(v)
   331	}
   332	
   333	func parseYAML(data []byte) (interface{}, error) {
   334		var lines []yamlLine
   335		for _, raw := range strings.Split(string(data), "\n") {
   336			raw = strings.TrimRight(raw, "\r")
   337			trimmed := strings.TrimSpace(raw)
   338			if trimmed == "" || strings.HasPrefix(trimmed, "#") {
   339				continue
   340			}
   341			indent := 0
   342			for indent < len(raw) && raw[indent] == ' ' {
   343				indent++
   344			}
   345			content := strings.TrimRight(raw[indent:], " ")
   346			lines = append(lines, yamlLine{indent: indent, content: content})
   347		}
   348		if len(lines) == 0 {
   349			return nil, nil
   350		}
   351		v, idx := parseBlock(lines, 0, 0)
   352		if idx < len(lines) {
   353			return nil, fmt.Errorf("unexpected YAML structure at line: %q", lines[idx].content)
   354		}
   355		return v, nil
   356	}
   357	
   358	func parseBlock(lines []yamlLine, idx int, indent int) (interface{}, int) {
   359		if idx >= len(lines) || lines[idx].indent < indent {
   360			return nil, idx
   361		}
   362		if strings.HasPrefix(lines[idx].content, "- ") || lines[idx].content == "-" {
   363			return parseSequence(lines, idx, indent)
   364		}
   365		return parseMapping(lines, idx, indent)
   366	}
   367	
   368	func parseSequence(lines []yamlLine, idx int, indent int) (interface{}, int) {
   369		seq := []interface{}{}
   370		for idx < len(lines) && lines[idx].indent == indent && (strings.HasPrefix(lines[idx].content, "- ") || lines[idx].content == "-") {
   371			content := strings.TrimPrefix(lines[idx].content, "-")
   372			content = strings.TrimLeft(content, " ")
   373			if content == "" {
   374				val, next := parseBlock(lines, idx+1, indent+2)
   375				seq = append(seq, val)
   376				idx = next
   377				continue
   378			}
   379			if isMappingStart(content) {
   380				sublines := []yamlLine{{indent: indent + 2, content: content}}
   381				start := idx + 1
   382				for start < len(lines) && lines[start].indent > indent {
   383					sublines = append(sublines, lines[start])
   384					start++
   385				}
   386				val, _ := parseBlock(sublines, 0, indent+2)
   387				seq = append(seq, val)
   388				idx = start
   389			} else {
   390				seq = append(seq, parseScalar(content))
   391				idx++
   392			}
   393		}
   394		return seq, idx
   395	}
   396	
   397	func parseMapping(lines []yamlLine, idx int, indent int) (interface{}, int) {
   398		m := map[string]interface{}{}
   399		for idx < len(lines) && lines[idx].indent == indent {
   400			content := lines[idx].content
   401			if strings.HasPrefix(content, "- ") || content == "-" {
   402				break
   403			}
   404			key, value, ok := splitKeyValue(content)
   405			if !ok {
   406				return nil, idx
   407			}
   408			if value != "" {
   409				m[key] = parseScalar(value)
   410				idx++
   411			} else {
   412				val, next := parseBlock(lines, idx+1, indent+2)
   413				m[key] = val
   414				idx = next
   415			}
   416		}
   417		return m, idx
   418	}
   419	
   420	func isMappingStart(s string) bool {
   421		if strings.HasPrefix(s, "[") || strings.HasPrefix(s, "{") {
   422			return false
   423		}
   424		_, _, ok := splitKeyValue(s)
   425		return ok
   426	}
   427	
   428	func splitKeyValue(s string) (string, string, bool) {
   429		inQuote := false
   430		quoteChar := byte(0)
   431		for i := 0; i < len(s); i++ {
   432			c := s[i]
   433			if inQuote {
   434				if c == quoteChar {
   435					inQuote = false
   436				}
   437				continue
   438			}
   439			if c == '"' || c == '\'' {
   440				inQuote = true
   441				quoteChar = c
   442				continue
   443			}
   444			if c == ':' {
   445				if i+1 >= len(s) || s[i+1] == ' ' {
   446					key := strings.TrimSpace(s[:i])
   447					value := strings.TrimSpace(s[i+1:])
   448					key = unquoteScalar(key)
   449					return key, value, true
   450				}
   451			}
   452		}
   453		return "", "", false
   454	}
   455	
   456	func parseScalar(s string) interface{} {
   457		s = strings.TrimSpace(s)
   458		if s == "" {
   459			return ""
   460		}
   461		if strings.HasPrefix(s, "[") && strings.HasSuffix(s, "]") {
   462			return parseInlineList(s)
   463		}
   464		if strings.HasPrefix(s, "{") && strings.HasSuffix(s, "}") {
   465			return parseInlineMap(s)
   466		}
   467		if len(s) >= 2 && (s[0] == '"' && s[len(s)-1] == '"' || s[0] == '\'' && s[len(s)-1] == '\'') {
   468			return unquoteScalar(s)
   469		}
   470		if s == "true" {
   471			return true
   472		}
   473		if s == "false" {
   474			return false
   475		}
   476		if n, err := strconv.Atoi(s); err == nil {
   477			return n
   478		}
   479		if f, err := strconv.ParseFloat(s, 64); err == nil {
   480			return f
   481		}
   482		return s
   483	}
   484	
   485	func parseInlineList(s string) interface{} {
   486		inner := strings.TrimSpace(s[1 : len(s)-1])
   487		if inner == "" {
   488			return []interface{}{}
   489		}
   490		parts := splitCommas(inner)
   491		out := make([]interface{}, 0, len(parts))
   492		for _, p := range parts {
   493			out = append(out, parseScalar(strings.TrimSpace(p)))
   494		}
   495		return out
   496	}
   497	
   498	func parseInlineMap(s string) interface{} {
   499		inner := strings.TrimSpace(s[1 : len(s)-1])
   500		if inner == "" {
   501			return map[string]interface{}{}
   502		}
   503		parts := splitCommas(inner)
   504		m := map[string]interface{}{}
   505		for _, p := range parts {
   506			key, value, ok := splitKeyValue(strings.TrimSpace(p))
   507			if ok {
   508				m[key] = parseScalar(value)
   509			}
   510		}
   511		return m
   512	}
   513	
   514	func splitCommas(s string) []string {
   515		var parts []string
