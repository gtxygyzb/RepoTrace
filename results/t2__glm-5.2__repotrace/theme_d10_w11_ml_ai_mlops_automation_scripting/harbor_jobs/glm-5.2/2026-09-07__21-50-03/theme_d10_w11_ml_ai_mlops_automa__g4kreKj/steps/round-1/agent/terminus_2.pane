   236	type Pipeline struct {
   237	    Name       string
   238	    Version    string
   239	    Parameters []Parameter
   240	    Stages     []Stage
   241	}
   242	
   243	type Parameter struct {
   244	    Name   string
   245	    Values []interface{}
   246	}
   247	
   248	type Stage struct {
   249	    Name      string
   250	    Command   string
   251	    DependsOn []string
   252	    Env       map[string]string
   253	    Metrics   []Metric
   254	    Retry     *Retry
   255	    Condition *Condition
   256	    Outputs   []ArtifactRef
   257	    Inputs    []ArtifactRef
   258	}
   259	
   260	type Metric struct {
   261	    Name      string
   262	    Objective string
   263	}
   264	
   265	type Retry struct {
   266	    MaxAttempts    int
   267	    BackoffSeconds float64
   268	}
   269	
   270	type Condition struct {
   271	    Metric    string
   272	    Operator  string
   273	    Threshold float64
   274	}
   275	
   276	type ArtifactRef struct {
   277	    Path string
   278	    Type string
   279	}
   280	
   281	type MetricData struct {
   282	    Name  string  `json:"name"`
   283	    Value float64 `json:"value"`
   284	}
   285	
   286	type StageState struct {
   287	    Name      string      `json:"name"`
   288	    Status    string      `json:"status"`
   289	    ExitCode  int         `json:"exit_code"`
   290	    Metrics   []MetricData `json:"metrics"`
   291	    StartTime string      `json:"start_time"`
   292	    EndTime   string      `json:"end_time"`
   293	    Retries   int         `json:"retries"`
   294	}
   295	
   296	type ArtifactEntry struct {
   297	    ExperimentID string `json:"experiment_id"`
   298	    StageName    string `json:"stage_name"`
   299	    Path         string `json:"path"`
   300	    Hash         string `json:"hash"`
   301	    Size         int64  `json:"size"`
   302	}
   303	
   304	type ArtifactIndex struct {
   305	    Entries []ArtifactEntry `json:"entries"`
   306	}
   307	
   308	type yamlLine struct {
   309	    indent  int
   310	    content string
   311	}
   312	
   313	func loadPipeline(path string) (*Pipeline, error) {
   314	    data, err := os.ReadFile(path)
   315	    if err != nil {
   316	        return nil, err
   317	    }
   318	    v, err := parseYAML(data)
   319	    if err != nil {
   320	        return nil, err
   321	    }
   322	    return mapToPipeline(v)
   323	}
   324	
   325	func parseYAML(data []byte) (interface{}, error) {
   326	    var lines []yamlLine
   327	    for _, raw := range strings.Split(string(data), "\n") {
   328	        raw = strings.TrimRight(raw, "\r")
   329	        trimmed := strings.TrimSpace(raw)
   330	        if trimmed == "" || strings.HasPrefix(trimmed, "#") {
   331	            continue
   332	        }
   333	        indent := 0
   334	        for indent < len(raw) && raw[indent] == ' ' {
   335	            indent++
   336	        }
   337	        content := strings.TrimRight(raw[indent:], " ")
   338	        lines = append(lines, yamlLine{indent: indent, content: content})
   339	    }
   340	    if len(lines) == 0 {
   341	        return nil, nil
   342	    }
   343	    v, idx := parseBlock(lines, 0, 0)
   344	    if idx < len(lines) {
   345	        return nil, fmt.Errorf("unexpected YAML structure at line: %q", lines[idx].content)
   346	    }
   347	    return v, nil
   348	}
   349	
   350	func parseBlock(lines []yamlLine, idx int, indent int) (interface{}, int) {
   351	    if idx >= len(lines) || lines[idx].indent < indent {
   352	        return nil, idx
   353	    }
   354	    if strings.HasPrefix(lines[idx].content, "- ") || lines[idx].content == "-" {
   355	        return parseSequence(lines, idx, indent)
   356	    }
   357	    return parseMapping(lines, idx, indent)
   358	}
   359	
   360	func parseSequence(lines []yamlLine, idx int, indent int) (interface{}, int) {
   361	    seq := []interface{}{}
   362	    for idx < len(lines) && lines[idx].indent == indent && (strings.HasPrefix(lines[idx].content, "- ") || lines[idx].content == "-") {
   363	        content := strings.TrimPrefix(lines[idx].content, "-")
   364	        content = strings.TrimLeft(content, " ")
   365	        if content == "" {
   366	            val, next := parseBlock(lines, idx+1, indent+2)
   367	            seq = append(seq, val)
   368	            idx = next
   369	            continue
   370	        }
   371	        if isMappingStart(content) {
   372	            sublines := []yamlLine{{indent: indent + 2, content: content}}
   373	            start := idx + 1
   374	            for start < len(lines) && lines[start].indent > indent {
   375	                sublines = append(sublines, lines[start])
   376	                start++
   377	            }
   378	            val, _ := parseBlock(sublines, 0, indent+2)
   379	            seq = append(seq, val)
   380	            idx = start
   381	        } else {
   382	            seq = append(seq, parseScalar(content))
   383	            idx++
   384	        }
   385	    }
   386	    return seq, idx
   387	}
   388	
   389	func parseMapping(lines []yamlLine, idx int, indent int) (interface{}, int) {
   390	    m := map[string]interface{}{}
   391	    for idx < len(lines) && lines[idx].indent == indent {
   392	        content := lines[idx].content
   393	        if strings.HasPrefix(content, "- ") || content == "-" {
   394	            break
   395	        }
   396	        key, value, ok := splitKeyValue(content)
   397	        if !ok {
   398	            return nil, idx
   399	        }
   400	        if value != "" {
   401	            m[key] = parseScalar(value)
   402	            idx++
   403	        } else {
   404	            val, next := parseBlock(lines, idx+1, indent+2)
   405	            m[key] = val
   406	            idx = next
   407	        }
   408	    }
   409	    return m, idx
   410	}
   411	
   412	func isMappingStart(s string) bool {
   413	    if strings.HasPrefix(s, "[") || strings.HasPrefix(s, "{") {
   414	        return false
   415	    }
   416	    _, _, ok := splitKeyValue(s)
   417	    return ok
   418	}
   419	
   420	func splitKeyValue(s string) (string, string, bool) {
   421	    inQuote := false
   422	    quoteChar := byte(0)
   423	    for i := 0; i < len(s); i++ {
   424	        c := s[i]
   425	        if inQuote {
   426	            if c == quoteChar {
   427	                inQuote = false
   428	            }
   429	            continue
   430	        }
   431	        if c == '"' || c == '\'' {
   432	            inQuote = true
   433	            quoteChar = c
   434	            continue
   435	        }
   436	        if c == ':' {
   437	            if i+1 >= len(s) || s[i+1] == ' ' {
   438	                key := strings.TrimSpace(s[:i])
   439	                value := strings.TrimSpace(s[i+1:])
   440	                key = unquoteScalar(key)
   441	                return key, value, true
   442	            }
   443	        }
   444	    }
   445	    return "", "", false
   446	}
   447	
   448	func parseScalar(s string) interface{} {
   449	    s = strings.TrimSpace(s)
   450	    if s == "" {
   451	        return ""
   452	    }
   453	    if strings.HasPrefix(s, "[") && strings.HasSuffix(s, "]") {
   454	        return parseInlineList(s)
   455	    }
   456	    if strings.HasPrefix(s, "{") && strings.HasSuffix(s, "}") {
   457	        return parseInlineMap(s)
   458	    }
   459	    if len(s) >= 2 && (s[0] == '"' && s[len(s)-1] == '"' || s[0] == '\'' && s[len(s)-1] == '\'') {
   460	        return unquoteScalar(s)
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '461,760p'
[?2004l   461	    }
   462	    if s == "true" {
   463	        return true
   464	    }
   465	    if s == "false" {
   466	        return false
   467	    }
   468	    if n, err := strconv.Atoi(s); err == nil {
   469	        return n
   470	    }
   471	    if f, err := strconv.ParseFloat(s, 64); err == nil {
   472	        return f
   473	    }
   474	    return s
   475	}
   476	
   477	func parseInlineList(s string) interface{} {
   478	    inner := strings.TrimSpace(s[1 : len(s)-1])
   479	    if inner == "" {
   480	        return []interface{}{}
   481	    }
   482	    parts := splitCommas(inner)
   483	    out := make([]interface{}, 0, len(parts))
   484	    for _, p := range parts {
   485	        out = append(out, parseScalar(strings.TrimSpace(p)))
   486	    }
   487	    return out
   488	}
   489	
   490	func parseInlineMap(s string) interface{} {
   491	    inner := strings.TrimSpace(s[1 : len(s)-1])
   492	    if inner == "" {
   493	        return map[string]interface{}{}
   494	    }
   495	    parts := splitCommas(inner)
   496	    m := map[string]interface{}{}
   497	    for _, p := range parts {
   498	        key, value, ok := splitKeyValue(strings.TrimSpace(p))
   499	        if ok {
   500	            m[key] = parseScalar(value)
   501	        }
   502	    }
   503	    return m
   504	}
   505	
   506	func splitCommas(s string) []string {
   507	    var parts []string
   508	    inQuote := false
   509	    quoteChar := byte(0)
   510	    depth := 0
   511	    start := 0
   512	    for i := 0; i < len(s); i++ {
   513	        c := s[i]
   514	        if inQuote {
   515	            if c == quoteChar {
   516	                inQuote = false
   517	            }
   518	            continue
   519	        }
   520	        if c == '"' || c == '\'' {
   521	            inQuote = true
   522	            quoteChar = c
   523	            continue
   524	        }
   525	        if c == '[' || c == '{' {
   526	            depth++
   527	            continue
   528	        }
   529	        if c == ']' || c == '}' {
   530	            depth--
   531	            continue
   532	        }
   533	        if c == ',' && depth == 0 {
   534	            parts = append(parts, s[start:i])
   535	            start = i + 1
   536	        }
   537	    }
   538	    parts = append(parts, s[start:])
   539	    return parts
   540	}
   541	
   542	func unquoteScalar(s string) string {
   543	    s = strings.TrimSpace(s)
   544	    if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
   545	        unq, err := strconv.Unquote(s)
   546	        if err == nil {
   547	            return unq
   548	        }
   549	        return s[1 : len(s)-1]
   550	    }
   551	    if len(s) >= 2 && s[0] == '\'' && s[len(s)-1] == '\'' {
   552	        return strings.ReplaceAll(s[1:len(s)-1], "''", "'")
   553	    }
   554	    return s
   555	}
   556	
   557	func mapToPipeline(v interface{}) (*Pipeline, error) {
   558	    p := &Pipeline{}
   559	    root := asMap(v)
   560	    if root == nil {
   561	        return p, nil
   562	    }
   563	    p.Name = asString(root["name"])
   564	    p.Version = asString(root["version"])
   565	    if params, ok := root["parameters"].(map[string]interface{}); ok {
   566	        keys := make([]string, 0, len(params))
   567	        for k := range params {
   568	            keys = append(keys, k)
   569	        }
   570	        sort.Strings(keys)
   571	        for _, k := range keys {
   572	            pm := asMap(params[k])
   573	            p.Parameters = append(p.Parameters, Parameter{Name: k, Values: asSlice(pm["values"])})
   574	        }
   575	    }
   576	    for _, sv := range asSlice(root["stages"]) {
   577	        sm := asMap(sv)
   578	        stage := Stage{
   579	            Name:    asString(sm["name"]),
   580	            Command: asString(sm["command"]),
   581	        }
   582	        stage.DependsOn = toStringSlice(asSlice(sm["depends_on"]))
   583	        stage.Env = toStringMap(asMap(sm["env"]))
   584	        for _, mv := range asSlice(sm["metrics"]) {
   585	            mm := asMap(mv)
   586	            stage.Metrics = append(stage.Metrics, Metric{Name: asString(mm["name"]), Objective: asString(mm["objective"])})
   587	        }
   588	        if rv := asMap(sm["retry"]); rv != nil {
   589	            stage.Retry = &Retry{MaxAttempts: asInt(rv["max_attempts"]), BackoffSeconds: asFloat(rv["backoff_seconds"])}
   590	        }
   591	        if cv := asMap(sm["condition"]); cv != nil {
   592	            stage.Condition = &Condition{Metric: asString(cv["metric"]), Operator: asString(cv["operator"]), Threshold: asFloat(cv["threshold"])}
   593	        }
   594	        for _, ov := range asSlice(sm["outputs"]) {
   595	            om := asMap(ov)
   596	            stage.Outputs = append(stage.Outputs, ArtifactRef{Path: asString(om["path"]), Type: asString(om["type"])})
   597	        }
   598	        for _, iv := range asSlice(sm["inputs"]) {
   599	            im := asMap(iv)
   600	            stage.Inputs = append(stage.Inputs, ArtifactRef{Path: asString(im["path"]), Type: asString(im["type"])})
   601	        }
   602	        p.Stages = append(p.Stages, stage)
   603	    }
   604	    return p, nil
   605	}
   606	
   607	func asMap(v interface{}) map[string]interface{} {
   608	    if m, ok := v.(map[string]interface{}); ok {
   609	        return m
   610	    }
   611	    return nil
   612	}
   613	
   614	func asSlice(v interface{}) []interface{} {
   615	    if s, ok := v.([]interface{}); ok {
   616	        return s
   617	    }
   618	    return nil
   619	}
   620	
   621	func asString(v interface{}) string {
   622	    if v == nil {
   623	        return ""
   624	    }
   625	    switch x := v.(type) {
   626	    case string:
   627	        return x
   628	    case int:
   629	        return strconv.Itoa(x)
   630	    case float64:
   631	        return formatFloat(x)
   632	    case bool:
   633	        return strconv.FormatBool(x)
   634	    default:
   635	        return fmt.Sprint(x)
   636	    }
   637	}
   638	
   639	func asInt(v interface{}) int {
   640	    switch x := v.(type) {
   641	    case int:
   642	        return x
   643	    case float64:
   644	        return int(x)
   645	    case string:
   646	        n, _ := strconv.Atoi(x)
   647	        return n
   648	    default:
   649	        return 0
   650	    }
   651	}
   652	
   653	func asFloat(v interface{}) float64 {
   654	    switch x := v.(type) {
   655	    case float64:
   656	        return x
   657	    case int:
   658	        return float64(x)
   659	    case string:
   660	        f, _ := strconv.ParseFloat(x, 64)
   661	        return f
   662	    default:
   663	        return 0
   664	    }
   665	}
   666	
   667	func toStringSlice(v []interface{}) []string {
   668	    out := make([]string, 0, len(v))
   669	    for _, item := range v {
   670	        out = append(out, asString(item))
   671	    }
   672	    return out
   673	}
   674	
   675	func toStringMap(m map[string]interface{}) map[string]string {
   676	    out := make(map[string]string)
   677	    for k, v := range m {
   678	        out[k] = asString(v)
   679	    }
   680	    return out
   681	}
   682	
   683	func formatFloat(f float64) string {
   684	    return strconv.FormatFloat(f, 'g', -1, 64)
   685	}
   686	
   687	func validatePipeline(p *Pipeline) []string {
   688	    var errs []string
   689	    names := make(map[string]int)
   690	    stageSet := make(map[string]bool)
   691	    stageMap := make(map[string]Stage)
   692	
   693	    for i, stage := range p.Stages {
   694	        if stage.Name == "" {
   695	            errs = append(errs, fmt.Sprintf("stage %d: missing required field name", i))
   696	        }
   697	        if stage.Command == "" {
   698	            errs = append(errs, fmt.Sprintf("stage %d: missing required field command", i))
   699	        }
   700	        if stage.Name != "" {
   701	            if prev, ok := names[stage.Name]; ok {
   702	                errs = append(errs, fmt.Sprintf("duplicate stage name: %s (stages %d and %d)", stage.Name, prev, i))
   703	            } else {
   704	                names[stage.Name] = i
   705	            }
   706	            stageSet[stage.Name] = true
   707	            stageMap[stage.Name] = stage
   708	        }
   709	    }
   710	
   711	    for _, stage := range p.Stages {
   712	        for _, dep := range stage.DependsOn {
   713	            if !stageSet[dep] {
   714	                errs = append(errs, fmt.Sprintf("stage %q depends on undefined stage %q", stage.Name, dep))
   715	            }
   716	        }
   717	    }
   718	
   719	    for _, stage := range p.Stages {
   720	        if stage.Name == "" {
   721	            continue
   722	        }
   723	        state := make(map[string]int)
   724	        var check func(name string)
   725	        check = func(name string) {
   726	            state[name] = 1
   727	            for _, dep := range stageMap[name].DependsOn {
   728	                if !stageSet[dep] {
   729	                    continue
   730	                }
   731	                if state[dep] == 1 {
   732	                    errs = append(errs, fmt.Sprintf("circular dependency detected involving stage: %s", name))
   733	                } else if state[dep] == 0 {
   734	                    check(dep)
   735	                }
   736	            }
   737	            state[name] = 2
   738	        }
   739	        check(stage.Name)
   740	    }
   741	
   742	    return errs
   743	}
