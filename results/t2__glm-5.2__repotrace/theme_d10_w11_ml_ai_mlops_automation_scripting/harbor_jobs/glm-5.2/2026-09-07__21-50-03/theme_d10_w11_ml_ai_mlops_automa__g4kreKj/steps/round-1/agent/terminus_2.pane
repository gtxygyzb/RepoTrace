					currentRank++
					prevVal = item.val
				}
				out.MetricRankings[m][out.Experiments[item.idx].ID] = currentRank
			}
		}

		for _, m := range objMetrics {
			var norms []float64
			for i := range out.Experiments {
				if norm, ok := normalized[i][m]; ok {
					norms = append(norms, norm)
				}
			}
			out.MetricImportance[m] = round4(sampleStd(norms))
		}

		for _, m := range objMetrics {
			if len(objMetrics) <= 1 {
				bestID := ""
				for _, exp := range out.Experiments {
					if bestID == "" || exp.ID < bestID {
						bestID = exp.ID
					}
				}
				out.ScoreSensitivity[m] = sensitivityEntry{
					BestWithout:  bestID,
					MaxComposite: 0,
				}
				continue
			}
