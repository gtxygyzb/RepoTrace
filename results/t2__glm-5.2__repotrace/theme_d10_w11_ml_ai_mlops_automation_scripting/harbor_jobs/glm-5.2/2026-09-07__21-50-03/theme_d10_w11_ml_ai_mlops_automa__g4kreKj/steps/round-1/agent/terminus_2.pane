   162	func cmdArtifacts(args []string) int {
   163	pipelineFile, list, gc, err := parseArtifactsArgs(args)
   164	if err != nil {
   165	fmt.Fprintln(os.Stderr, "error:", err)
   166	return 1
   167	}
   168	p, err := loadPipeline(pipelineFile)
   169	if err != nil {
   170	fmt.Fprintln(os.Stderr, "error:", err)
   171	return 1
   172	}
   173	if gc {
   174	return artifactsGC(p)
   175	}
   176	_ = list
   177	return artifactsList()
   178	}
   179	
   180	func parseRunArgs(args []string) (string, int, bool, error) {
   181	pipelineFile := ""
   182	experimentIndex := -1
   183	resume := false
   184	for i := 0; i < len(args); i++ {
   185	switch args[i] {
   186	case "--experiment":
   187	if i+1 >= len(args) {
   188	return "", 0, false, fmt.Errorf("--experiment requires an index")
   189	}
   190	idx, err := strconv.Atoi(args[i+1])
   191	if err != nil {
   192	return "", 0, false, fmt.Errorf("invalid experiment index: %v", err)
   193	}
   194	experimentIndex = idx
   195	i++
   196	case "--resume":
   197	resume = true
   198	default:
   199	if pipelineFile == "" {
   200	pipelineFile = args[i]
   201	} else {
   202	return "", 0, false, fmt.Errorf("unexpected argument: %s", args[i])
   203	}
   204	}
   205	}
   206	if pipelineFile == "" {
   207	return "", 0, false, fmt.Errorf("usage: mlpipe run <pipeline.yaml> [--experiment <index>] [--resume]")
   208	}
   209	return pipelineFile, experimentIndex, resume, nil
   210	}
   211	
   212	func parseArtifactsArgs(args []string) (string, bool, bool, error) {
   213	pipelineFile := ""
   214	list := false
   215	gc := false
   216	for _, arg := range args {
   217	switch arg {
   218	case "--list":
   219	list = true
   220	case "--gc":
   221	gc = true
   222	default:
   223	if pipelineFile == "" {
   224	pipelineFile = arg
   225	} else {
   226	return "", false, false, fmt.Errorf("unexpected argument: %s", arg)
   227	}
   228	}
   229	}
   230	if pipelineFile == "" {
   231	return "", false, false, fmt.Errorf("usage: mlpipe artifacts <pipeline.yaml> [--list] [--gc]")
   232	}
   233	return pipelineFile, list, gc, nil
   234	}
