   832	func copyMap(m map[string]interface{}) map[string]interface{} {
   833		out := make(map[string]interface{}, len(m))
   834		for k, v := range m {
   835			out[k] = v
   836		}
   837		return out
   838	}
   839	
   840	func sortedKeys(m map[string]bool) []string {
   841		keys := make([]string, 0, len(m))
   842		for k := range m {
   843			keys = append(keys, k)
   844		}
   845		sort.Strings(keys)
   846		return keys
   847	}
