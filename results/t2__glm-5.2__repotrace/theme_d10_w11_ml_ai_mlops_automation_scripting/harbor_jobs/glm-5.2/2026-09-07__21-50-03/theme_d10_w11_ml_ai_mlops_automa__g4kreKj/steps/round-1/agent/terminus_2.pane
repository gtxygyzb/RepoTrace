   621	func asString(v interface{}) string {
   622	    if v == nil {
   623	        return ""
   624	    }
   625	    switch x := v.(type) {
   626	    case string:
   627	        return x
   628	    case int:
   629	        return strconv.Itoa(x)
   630	    case float64:
   631	        return formatFloat(x)
   632	    case bool:
   633	        return strconv.FormatBool(x)
   634	    default:
   635	        return fmt.Sprint(x)
   636	    }
   637	}
   638	
   639	func asInt(v interface{}) int {
   640	    switch x := v.(type) {
   641	    case int:
   642	        return x
   643	    case float64:
   644	        return int(x)
   645	    case string:
   646	        n, _ := strconv.Atoi(x)
   647	        return n
   648	    default:
   649	        return 0
   650	    }
   651	}
   652	
   653	func asFloat(v interface{}) float64 {
   654	    switch x := v.(type) {
   655	    case float64:
