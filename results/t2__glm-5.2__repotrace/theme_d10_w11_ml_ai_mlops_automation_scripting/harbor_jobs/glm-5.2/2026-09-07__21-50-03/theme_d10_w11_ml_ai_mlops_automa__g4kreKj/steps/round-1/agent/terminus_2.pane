--- pipelines/broken_cycles.yaml
name: broken-circular-pipeline
version: "1.0"

stages:
  - name: stage-a
    command: "echo a"
    depends_on: ["stage-c"]
    outputs:
      - path: "out/a.txt"
        type: file

  - name: stage-b
    command: "echo b"
    depends_on: ["stage-a"]
    outputs:
      - path: "out/b.txt"
        type: file

  - name: stage-c
    command: "echo c"
    depends_on: ["stage-b"]
    outputs:
      - path: "out/c.txt"
        type: file
pipelines/image_classifier.yaml
--- pipelines/image_classifier.yaml
name: image-classifier-training
version: "1.0"

parameters:
  learning_rate:
    type: grid
    values: [0.001, 0.01, 0.1]
  batch_size:
    type: grid
    values: [32, 64]
  optimizer:
    type: grid
    values: ["adam", "sgd"]

stages:
  - name: data-validation
    command: "./stages/validate_data.sh"
    inputs:
      - path: "data/sample"
        type: directory
    outputs:
      - path: "data/validated"
        type: directory
    metrics:
      - name: num_samples
        objective: report
      - name: corruption_rate
        objective: minimize

  - name: feature-extraction
    command: "./stages/extract_features.sh"
    depends_on: ["data-validation"]
    inputs:
      - path: "data/validated"
        type: directory
    outputs:
      - path: "data/features.bin"
        type: file
    env:
      BATCH_SIZE: "${batch_size}"

  - name: model-training
    command: "./stages/train_model.sh"
    depends_on: ["feature-extraction"]
    inputs:
      - path: "data/features.bin"
        type: file
    outputs:
      - path: "models/checkpoint.bin"
        type: file
    env:
      LEARNING_RATE: "${learning_rate}"
      OPTIMIZER: "${optimizer}"
      BATCH_SIZE: "${batch_size}"
    metrics:
      - name: train_loss
        objective: minimize
      - name: train_accuracy
        objective: maximize
    retry:
      max_attempts: 2
      backoff_seconds: 1

  - name: model-evaluation
    command: "./stages/evaluate_model.sh"
    depends_on: ["model-training"]
    inputs:
      - path: "models/checkpoint.bin"
        type: file
      - path: "data/validated"
        type: directory
    outputs:
      - path: "reports/evaluation.json"
        type: file
    metrics:
      - name: eval_accuracy
        objective: maximize
      - name: eval_f1
        objective: maximize
      - name: eval_loss
        objective: minimize

  - name: model-export
    command: "./stages/export_model.sh"
    depends_on: ["model-evaluation"]
    condition:
      metric: eval_accuracy
      operator: ">="
      threshold: 0.85
    inputs:
      - path: "models/checkpoint.bin"
        type: file
    outputs:
      - path: "models/exported/model.onnx"
        type: file
pipelines/text_sentiment.yaml
--- pipelines/text_sentiment.yaml
name: text-sentiment-analysis
version: "1.0"

parameters:
  embedding_dim:
    type: grid
    values: [128, 256]
  dropout:
    type: grid
    values: [0.1, 0.3]

stages:
  - name: preprocess
    command: "./stages/validate_data.sh"
    inputs:
      - path: "data/sample"
        type: directory
    outputs:
      - path: "data/validated"
        type: directory
    metrics:
      - name: num_samples
        objective: report
      - name: corruption_rate
        objective: minimize

  - name: train
    command: "./stages/train_model.sh"
    depends_on: ["preprocess"]
    outputs:
      - path: "models/checkpoint.bin"
        type: file
    env:
      LEARNING_RATE: "0.001"
      OPTIMIZER: "adam"
      BATCH_SIZE: "${embedding_dim}"
      DROPOUT: "${dropout}"
    metrics:
      - name: train_loss
        objective: minimize
      - name: train_accuracy
        objective: maximize

  - name: evaluate
    command: "./stages/evaluate_model.sh"
    depends_on: ["train"]
    outputs:
      - path: "reports/evaluation.json"
        type: file
    metrics:
      - name: eval_accuracy
        objective: maximize
      - name: eval_f1
        objective: maximize
      - name: eval_loss
        objective: minimize
stages/validate_data.sh
--- stages/validate_data.sh
#!/bin/bash
# Validates input data directory and produces validated copy
mkdir -p data/validated
if [ -d "data/sample" ]; then
    cp -r data/sample/* data/validated/ 2>/dev/null || true
fi
COUNT=$(find data/validated -type f 2>/dev/null | wc -l)
echo "{\"metric\": \"num_samples\", \"value\": ${COUNT}}"
echo "{\"metric\": \"corruption_rate\", \"value\": 0.02}"
stages/extract_features.sh
--- stages/extract_features.sh
#!/bin/bash
# Extracts features from validated data
BS=${BATCH_SIZE:-32}
mkdir -p data
echo "features_batch${BS}" > data/features.bin
echo "{\"metric\": \"feature_dim\", \"value\": 512}"
stages/export_model.sh
--- stages/export_model.sh
#!/bin/bash
# Exports model to deployment format
mkdir -p models/exported
if [ ! -f "models/checkpoint.bin" ]; then
    echo "ERROR: No model checkpoint found" >&2
    exit 1
fi
cp models/checkpoint.bin models/exported/model.onnx
echo "{\"metric\": \"export_size_mb\", \"value\": 0.001}"
stages/train_model.sh
--- stages/train_model.sh
#!/bin/bash
# Trains a model with given hyperparameters
LR=${LEARNING_RATE:-0.01}
OPT=${OPTIMIZER:-adam}
BS=${BATCH_SIZE:-32}
DROP=${DROPOUT:-0}
mkdir -p models

if [ "$OPT" = "adam" ]; then OPT_VAL=1; else OPT_VAL=0; fi

LOSS=$(awk "BEGIN {printf \"%.4f\", 0.5 - ($OPT_VAL * 0.05) + ($BS / 1000.0) + ($LR * 10) + ($DROP * 0.1)}")
ACC=$(awk "BEGIN {printf \"%.4f\", 0.8 + ($OPT_VAL * 0.03) - ($BS / 2000.0) - ($LR * 5) - ($DROP * 0.05)}")

echo "model_${LR}_${OPT}_${BS}" > models/checkpoint.bin
echo "{\"metric\": \"train_loss\", \"value\": ${LOSS}}"
echo "{\"metric\": \"train_accuracy\", \"value\": ${ACC}}"
stages/evaluate_model.sh
--- stages/evaluate_model.sh
#!/bin/bash
# Evaluates the trained model
mkdir -p reports
if [ ! -f "models/checkpoint.bin" ]; then
    echo "ERROR: No model checkpoint found" >&2
    exit 1
fi

MODEL_INFO=$(cat models/checkpoint.bin)
LR=$(echo "$MODEL_INFO" | cut -d_ -f2)
OPT=$(echo "$MODEL_INFO" | cut -d_ -f3)
BS=$(echo "$MODEL_INFO" | cut -d_ -f4)
if [ "$OPT" = "adam" ]; then OPT_VAL=1; else OPT_VAL=0; fi

EVAL_ACC=$(awk "BEGIN {printf \"%.4f\", 0.82 + ($OPT_VAL * 0.06) - ($BS / 5000.0) - ($LR * 2)}")
EVAL_F1=$(awk "BEGIN {printf \"%.4f\", 0.78 + ($OPT_VAL * 0.05) - ($BS / 6000.0) - ($LR * 1.5)}")
EVAL_LOSS=$(awk "BEGIN {printf \"%.4f\", 0.3 - ($OPT_VAL * 0.04) + ($BS / 3000.0) + ($LR * 5)}")

echo "{\"eval_accuracy\": ${EVAL_ACC}, \"eval_f1\": ${EVAL_F1}}" > reports/evaluation.json
echo "{\"metric\": \"eval_accuracy\", \"value\": ${EVAL_ACC}}"
echo "{\"metric\": \"eval_f1\", \"value\": ${EVAL_F1}}"
echo "{\"metric\": \"eval_loss\", \"value\": ${EVAL_LOSS}}"
