   928		for _, combo := range parameterCombinations(p) {
   929			expected[experimentID(combo)] = true
   930		}
   931		entries, err := os.ReadDir(filepath.Join(".mlpipe", "state"))
   932		if err != nil {
   933			return 0
   934		}
   935		for _, entry := range entries {
   936			if !expected[entry.Name()] {
   937				_ = os.RemoveAll(filepath.Join(".mlpipe", "state", entry.Name()))
   938			}
   939		}
   940		return 0
   941	}
