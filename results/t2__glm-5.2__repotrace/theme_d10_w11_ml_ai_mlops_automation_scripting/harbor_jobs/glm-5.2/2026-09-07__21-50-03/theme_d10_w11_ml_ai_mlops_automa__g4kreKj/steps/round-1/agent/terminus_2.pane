    20	func main() {
    21	if len(os.Args) < 2 {
    22	fmt.Fprintln(os.Stderr, "Usage: mlpipe <command> [args...]")
    23	fmt.Fprintln(os.Stderr, "Commands: validate, plan, run, report, artifacts")
    24	os.Exit(1)
