   188	func parseRunArgs(args []string) (string, int, bool, error) {
   189		pipelineFile := ""
   190		experimentIndex := -1
   191		resume := false
   192		for i := 0; i < len(args); i++ {
   193			switch args[i] {
   194			case "--experiment":
   195				if i+1 >= len(args) {
   196					return "", 0, false, fmt.Errorf("--experiment requires an index")
   197				}
   198				idx, err := strconv.Atoi(args[i+1])
   199				if err != nil {
   200					return "", 0, false, fmt.Errorf("invalid experiment index: %v", err)
   201				}
   202				experimentIndex = idx
   203				i++
   204			case "--resume":
   205				resume = true
   206			default:
   207				if pipelineFile == "" {
   208					pipelineFile = args[i]
   209				} else {
   210					return "", 0, false, fmt.Errorf("unexpected argument: %s", args[i])
   211				}
   212			}
   213		}
   214		if pipelineFile == "" {
   215			return "", 0, false, fmt.Errorf("usage: mlpipe run <pipeline.yaml> [--experiment <index>] [--resume]")
   216		}
   217		return pipelineFile, experimentIndex, resume, nil
   218	}
