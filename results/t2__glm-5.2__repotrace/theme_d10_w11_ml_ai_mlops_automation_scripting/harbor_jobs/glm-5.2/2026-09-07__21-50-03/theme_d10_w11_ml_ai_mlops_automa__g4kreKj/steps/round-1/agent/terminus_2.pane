name: broken-circular-pipeline
version: "1.0"

stages:
  - name: stage-a
    command: "echo a"
    depends_on: ["stage-c"]
    outputs:
      - path: "out/a.txt"
        type: file

  - name: stage-b
    command: "echo b"
    depends_on: ["stage-a"]
    outputs:
      - path: "out/b.txt"
        type: file

  - name: stage-c
    command: "echo c"
    depends_on: ["stage-b"]
    outputs:
      - path: "out/c.txt"
