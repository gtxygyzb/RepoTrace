  1205		pipelineFile := ""
  1206		metricName := ""
  1207		paramName := ""
  1208		for i := 0; i < len(args); i++ {
  1209			arg := args[i]
  1210			switch {
  1211			case arg == "--metric":
  1212				if i+1 >= len(args) {
  1213					fmt.Fprintln(os.Stderr, "error: --metric requires a value")
  1214					return 1
  1215				}
  1216				i++
  1217				metricName = args[i]
  1218			case strings.HasPrefix(arg, "--metric="):
  1219				metricName = strings.TrimPrefix(arg, "--metric=")
  1220			case arg == "--param":
  1221				if i+1 >= len(args) {
  1222					fmt.Fprintln(os.Stderr, "error: --param requires a value")
  1223					return 1
  1224				}
  1225				i++
  1226				paramName = args[i]
  1227			case strings.HasPrefix(arg, "--param="):
  1228				paramName = strings.TrimPrefix(arg, "--param=")
  1229			case pipelineFile == "":
  1230				pipelineFile = arg
  1231			default:
  1232				fmt.Fprintf(os.Stderr, "error: unknown argument %q\n", arg)
  1233				return 1
  1234			}
  1235		}
  1236		if pipelineFile == "" || metricName == "" || paramName == "" {
  1237			fmt.Fprintln(os.Stderr, "Usage: mlpipe sweep <pipeline.yaml> --metric <name> --param <name>")
  1238			return 1
  1239		}
  1240	
  1241		p, err := loadPipeline(pipelineFile)
  1242		if err != nil {
  1243			fmt.Fprintln(os.Stderr, "error:", err)
  1244			return 1
  1245		}
  1246		if errs := validatePipeline(p); len(errs) > 0 {
  1247			for _, e := range errs {
  1248				fmt.Fprintln(os.Stderr, e)
  1249			}
  1250			return 1
  1251		}
  1252	
  1253		objective := ""
  1254		metricFound := false
  1255		for _, stage := range p.Stages {
  1256			for _, m := range stage.Metrics {
  1257				if m.Name == metricName {
  1258					metricFound = true
  1259					if objective == "" {
  1260						objective = m.Objective
  1261					}
  1262				}
  1263			}
  1264		}
  1265		if !metricFound {
  1266			fmt.Fprintf(os.Stderr, "error: metric %q not found in pipeline\n", metricName)
  1267			return 1
  1268		}
  1269	
  1270		paramFound := false
  1271		for _, param := range p.Parameters {
  1272			if param.Name == paramName {
  1273				paramFound = true
  1274				break
  1275			}
  1276		}
  1277		if !paramFound {
  1278			fmt.Fprintf(os.Stderr, "error: parameter %q not found in pipeline\n", paramName)
  1279			return 1
  1280		}
  1281	
  1282		return sweepPipeline(p, metricName, paramName, objective)
  1283	}
