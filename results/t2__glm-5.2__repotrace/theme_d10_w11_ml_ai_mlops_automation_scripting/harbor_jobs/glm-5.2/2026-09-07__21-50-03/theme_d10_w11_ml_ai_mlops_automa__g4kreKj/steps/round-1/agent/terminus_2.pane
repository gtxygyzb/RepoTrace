    50	        type: file
    51	    env:
    52	      LEARNING_RATE: "${learning_rate}"
    53	      OPTIMIZER: "${optimizer}"
    54	      BATCH_SIZE: "${batch_size}"
    55	    metrics:
    56	      - name: train_loss
    57	        objective: minimize
    58	      - name: train_accuracy
    59	        objective: maximize
    60	    retry:
