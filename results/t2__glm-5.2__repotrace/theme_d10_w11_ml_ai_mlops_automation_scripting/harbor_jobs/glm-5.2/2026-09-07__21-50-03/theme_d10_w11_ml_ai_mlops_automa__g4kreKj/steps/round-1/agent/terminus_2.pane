   195	i++
   196	case "--resume":
   197	resume = true
   198	default:
   199	if pipelineFile == "" {
   200	pipelineFile = args[i]
   201	} else {
   202	return "", 0, false, fmt.Errorf("unexpected argument: %s", args[i])
   203	}
   204	}
   205	}
   206	if pipelineFile == "" {
   207	return "", 0, false, fmt.Errorf("usage: mlpipe run <pipeline.yaml> [--experiment <index>] [--resume]")
   208	}
   209	return pipelineFile, experimentIndex, resume, nil
   210	}
   211	
   212	func parseArtifactsArgs(args []string) (string, bool, bool, error) {
   213	pipelineFile := ""
   214	list := false
   215	gc := false
   216	for _, arg := range args {
   217	switch arg {
   218	case "--list":
   219	list = true
   220	case "--gc":
   221	gc = true
   222	default:
   223	if pipelineFile == "" {
   224	pipelineFile = arg
   225	} else {
   226	return "", false, false, fmt.Errorf("unexpected argument: %s", arg)
   227	}
   228	}
   229	}
   230	if pipelineFile == "" {
   231	return "", false, false, fmt.Errorf("usage: mlpipe artifacts <pipeline.yaml> [--list] [--gc]")
   232	}
   233	return pipelineFile, list, gc, nil
   234	}
