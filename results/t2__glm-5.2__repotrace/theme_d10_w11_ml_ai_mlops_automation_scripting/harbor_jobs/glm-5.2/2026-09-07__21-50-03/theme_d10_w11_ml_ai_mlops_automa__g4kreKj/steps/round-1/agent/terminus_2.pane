	}

	out := reportOutput{Pipeline: p.Name, Experiments: []reportExperiment{}, MetricSummary: map[string]metricSummaryEntry{}}
	metricValues := map[string][]float64{}
	for _, combo := range parameterCombinations(p) {
		id := experimentID(combo)
		exp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}
		for _, stage := range p.Stages {
			if st, err := readStageState(id, stage.Name); err == nil {
				exp.Stages = append(exp.Stages, *st)
				for _, m := range st.Metrics {
					exp.Metrics[m.Name] = m.Value
					metricValues[m.Name] = append(metricValues[m.Name], m.Value)
				}
			}
		}
		out.Experiments = append(out.Experiments, exp)
	}
	for name, values := range metricValues {
		out.MetricSummary[name] = metricSummaryEntry{
			Count: len(values),
			Mean:  round4(meanValue(values)),
			Std:   round4(sampleStd(values)),
			Min:   round4(minValue(values)),
			Max:   round4(maxValue(values)),
		}
	}
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	if err := enc.Encode(out); err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	return 0
}

type metricSummaryEntry struct {
	Count int     `json:"count"`
	Mean  float64 `json:"mean"`
	Std   float64 `json:"std"`
	Min   float64 `json:"min"`
	Max   float64 `json:"max"`
}

func cmdSweep(args []string) int {
	pipelineFile := ""
	metricName := ""
	paramName := ""
	for i := 0; i < len(args); i++ {
		arg := args[i]
		switch {
		case arg == "--metric":
			if i+1 >= len(args) {
				fmt.Fprintln(os.Stderr, "error: --metric requires a value")
				return 1
			}
			i++
			metricName = args[i]
		case strings.HasPrefix(arg, "--metric="):
			metricName = strings.TrimPrefix(arg, "--metric=")
		case arg == "--param":
			if i+1 >= len(args) {
				fmt.Fprintln(os.Stderr, "error: --param requires a value")
				return 1
			}
			i++
			paramName = args[i]
		case strings.HasPrefix(arg, "--param="):
			paramName = strings.TrimPrefix(arg, "--param=")
		case pipelineFile == "":
			pipelineFile = arg
		default:
			fmt.Fprintf(os.Stderr, "error: unknown argument %q\n", arg)
			return 1
		}
	}
	if pipelineFile == "" || metricName == "" || paramName == "" {
		fmt.Fprintln(os.Stderr, "Usage: mlpipe sweep <pipeline.yaml> --metric <name> --param <name>")
		return 1
	}

	p, err := loadPipeline(pipelineFile)
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	if errs := validatePipeline(p); len(errs) > 0 {
		for _, e := range errs {
			fmt.Fprintln(os.Stderr, e)
		}
		return 1
	}

	objective := ""
	metricFound := false
	for _, stage := range p.Stages {
		for _, m := range stage.Metrics {
			if m.Name == metricName {
				metricFound = true
				if objective == "" {
					objective = m.Objective
				}
			}
		}
	}
	if !metricFound {
		fmt.Fprintf(os.Stderr, "error: metric %q not found in pipeline\n", metricName)
		return 1
	}

	paramFound := false
	for _, param := range p.Parameters {
		if param.Name == paramName {
				paramFound = true
				break
		}
	}
	if !paramFound {
		fmt.Fprintf(o[?2004h> from pathlib import Path
