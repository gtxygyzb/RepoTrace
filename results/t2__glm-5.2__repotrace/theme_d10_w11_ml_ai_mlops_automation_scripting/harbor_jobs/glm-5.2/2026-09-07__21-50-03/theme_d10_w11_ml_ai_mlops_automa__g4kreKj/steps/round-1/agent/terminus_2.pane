name: text-sentiment-analysis
version: "1.0"

parameters:
  embedding_dim:
    type: grid
    values: [128, 256]
  dropout:
    type: grid
    values: [0.1, 0.3]

stages:
  - name: preprocess
    command: "./stages/validate_data.sh"
    inputs:
      - path: "data/sample"
        type: directory
    outputs:
      - path: "data/validated"
        type: directory
    metrics:
      - name: num_samples
        objective: report
      - name: corruption_rate
        objective: minimize

  - name: train
    command: "./stages/train_model.sh"
    depends_on: ["preprocess"]
    outputs:
      - path: "models/checkpoint.bin"
        type: file
    env:
      LEARNING_RATE: "0.001"
      OPTIMIZER: "adam"
      BATCH_SIZE: "${embedding_dim}"
      DROPOUT: "${dropout}"
    metrics:
      - name: train_loss
        objective: minimize
      - name: train_accuracy
        objective: maximize

  - name: evaluate
    command: "./stages/evaluate_model.sh"
    depends_on: ["train"]
    outputs:
      - path: "reports/evaluation.json"
        type: file
    metrics:
      - name: eval_accuracy
        objective: maximize
      - name: eval_f1
        objective: maximize
      - name: eval_loss
        objective: minimize
