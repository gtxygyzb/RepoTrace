   565	func mapToPipeline(v interface{}) (*Pipeline, error) {
   566		p := &Pipeline{}
   567		root := asMap(v)
   568		if root == nil {
   569			return p, nil
   570		}
   571		p.Name = asString(root["name"])
   572		p.Version = asString(root["version"])
   573		if params, ok := root["parameters"].(map[string]interface{}); ok {
   574			keys := make([]string, 0, len(params))
   575			for k := range params {
   576				keys = append(keys, k)
   577			}
   578			sort.Strings(keys)
   579			for _, k := range keys {
   580				pm := asMap(params[k])
   581				p.Parameters = append(p.Parameters, Parameter{Name: k, Values: asSlice(pm["values"])})
   582			}
   583		}
   584		for _, sv := range asSlice(root["stages"]) {
   585			sm := asMap(sv)
   586			stage := Stage{
   587				Name:    asString(sm["name"]),
   588				Command: asString(sm["command"]),
   589			}
   590			stage.DependsOn = toStringSlice(asSlice(sm["depends_on"]))
   591			stage.Env = toStringMap(asMap(sm["env"]))
   592			for _, mv := range asSlice(sm["metrics"]) {
   593				mm := asMap(mv)
   594				stage.Metrics = append(stage.Metrics, Metric{Name: asString(mm["name"]), Objective: asString(mm["objective"])})
   595			}
   596			if rv := asMap(sm["retry"]); rv != nil {
   597				stage.Retry = &Retry{MaxAttempts: asInt(rv["max_attempts"]), BackoffSeconds: asFloat(rv["backoff_seconds"])}
   598			}
   599			if cv := asMap(sm["condition"]); cv != nil {
   600				stage.Condition = &Condition{Metric: asString(cv["metric"]), Operator: asString(cv["operator"]), Threshold: asFloat(cv["threshold"])}
   601			}
   602			for _, ov := range asSlice(sm["outputs"]) {
   603				om := asMap(ov)
   604				stage.Outputs = append(stage.Outputs, ArtifactRef{Path: asString(om["path"]), Type: asString(om["type"])})
   605			}
   606			for _, iv := range asSlice(sm["inputs"]) {
   607				im := asMap(iv)
   608				stage.Inputs = append(stage.Inputs, ArtifactRef{Path: asString(im["path"]), Type: asString(im["type"])})
   609			}
   610			p.Stages = append(p.Stages, stage)
   611		}
   612		return p, nil
   613	}
