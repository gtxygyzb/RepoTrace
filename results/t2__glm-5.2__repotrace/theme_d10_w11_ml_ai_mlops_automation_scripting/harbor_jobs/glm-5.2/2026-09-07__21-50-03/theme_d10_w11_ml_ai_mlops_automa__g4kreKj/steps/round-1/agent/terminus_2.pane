  1282		return sweepPipeline(p, metricName, paramName, objective)
  1283	}
  1284	
  1285	func sweepPipeline(p *Pipeline, metricName, paramName, objective string) int {
  1286		type groupOut struct {
  1287			Value string  `json:"value"`
  1288			Count int     `json:"count"`
  1289			Mean  float64 `json:"mean"`
  1290			Std   float64 `json:"std"`
  1291			Min   float64 `json:"min"`
  1292			Max   float64 `json:"max"`
  1293		}
  1294	
  1295		groupValues := map[string][]float64{}
  1296		for _, combo := range parameterCombinations(p) {
  1297			id := experimentID(combo)
  1298			paramValue := asString(combo[paramName])
  1299			metrics := map[string]float64{}
  1300			for _, stage := range p.Stages {
  1301				if st, err := readStageState(id, stage.Name); err == nil && st.Status == "completed" {
  1302					for _, m := range st.Metrics {
  1303						metrics[m.Name] = m.Value
  1304					}
  1305				}
  1306			}
  1307			if val, ok := metrics[metricName]; ok {
  1308				groupValues[paramValue] = append(groupValues[paramValue], val)
  1309			}
  1310		}
  1311	
  1312		if len(groupValues) == 0 {
  1313			fmt.Fprintf(os.Stderr, "error: metric %q not found in any completed experiment\n", metricName)
  1314			return 1
  1315		}
  1316	
  1317		values := make([]string, 0, len(groupValues))
  1318		for v := range groupValues {
  1319			values = append(values, v)
  1320		}
  1321		sort.Strings(values)
  1322	
  1323		groups := make([]groupOut, 0, len(values))
  1324		groupMeans := map[string]float64{}
  1325		groupVars := map[string]float64{}
  1326		totalN := 0
  1327		grandSum := 0.0
  1328		for _, v := range values {
  1329			obs := groupValues[v]
  1330			n := len(obs)
  1331			totalN += n
  1332			mean := meanValue(obs)
  1333			variance := 0.0
  1334			if n > 1 {
  1335				ss := 0.0
  1336				for _, x := range obs {
  1337					diff := x - mean
  1338					ss += diff * diff
  1339				}
  1340				variance = ss / float64(n-1)
  1341			}
  1342			groupMeans[v] = mean
  1343			groupVars[v] = variance
  1344			grandSum += mean * float64(n)
  1345			groups = append(groups, groupOut{
  1346				Value: v,
  1347				Count: n,
  1348				Mean:  round4(mean),
  1349				Std:   round4(math.Sqrt(variance)),
  1350				Min:   round4(minValue(obs)),
  1351				Max:   round4(maxValue(obs)),
  1352			})
  1353		}
  1354	
  1355		grandMean := 0.0
  1356		if totalN > 0 {
  1357			grandMean = grandSum / float64(totalN)
  1358		}
  1359	
  1360		k := len(values)
  1361		betweenVariance := 0.0
  1362		withinVariance := 0.0
  1363		if k > 1 && totalN > k {
  1364			for _, v := range values {
  1365				n := len(groupValues[v])
  1366				diff := groupMeans[v] - grandMean
  1367				betweenVariance += float64(n) * diff * diff
  1368				withinVariance += float64(n-1) * groupVars[v]
  1369			}
  1370			betweenVariance /= float64(k - 1)
  1371			withinVariance /= float64(totalN - k)
  1372		}
  1373	
  1374		var anovaF *float64
  1375		if k > 1 && totalN > k && withinVariance > 0 {
  1376			f := betweenVariance / withinVariance
  1377			f = round4(f)
  1378			anovaF = &f
  1379		}
  1380	
  1381		var effectSize *float64
  1382		pooledStd := math.Sqrt(withinVariance)
  1383		if k > 1 && totalN > k && pooledStd > 0 {
  1384			maxMean := groupMeans[values[0]]
  1385			minMean := groupMeans[values[0]]
  1386			for _, v := range values {
  1387				if groupMeans[v] > maxMean {
  1388					maxMean = groupMeans[v]
  1389				}
  1390				if groupMeans[v] < minMean {
  1391					minMean = groupMeans[v]
  1392				}
  1393			}
  1394			es := round4((maxMean - minMean) / pooledStd)
  1395			effectSize = &es
  1396		}
  1397	
  1398		bestValue := ""
  1399		bestMean := 0.0
  1400		for _, v := range values {
  1401			mean := groupMeans[v]
  1402			if bestValue == "" {
  1403				bestValue = v
  1404				bestMean = mean
  1405				continue
  1406			}
  1407			if objective == "minimize" {
  1408				if mean < bestMean {
  1409					bestValue = v
  1410					bestMean = mean
  1411				}
  1412			} else {
  1413				if mean > bestMean {
  1414					bestValue = v
  1415					bestMean = mean
  1416				}
  1417			}
  1418		}
  1419	
  1420		out := struct {
  1421			Parameter  string     `json:"parameter"`
  1422			Metric     string     `json:"metric"`
  1423			Objective  string     `json:"objective"`
  1424			Groups     []groupOut `json:"groups"`
  1425			AnovaF     *float64   `json:"anova_f"`
  1426			BestValue  string     `json:"best_value"`
  1427			EffectSize *float64   `json:"effect_size"`
  1428		}{
  1429			Parameter:  paramName,
  1430			Metric:     metricName,
  1431			Objective:  objective,
  1432			Groups:     groups,
  1433			AnovaF:     anovaF,
  1434			BestValue:  bestValue,
  1435			EffectSize: effectSize,
  1436		}
  1437	
  1438		enc := json.NewEncoder(os.Stdout)
  1439		enc.SetIndent("", "  ")
  1440		if err := enc.Encode(out); err != nil {
  1441			fmt.Fprintln(os.Stderr, "error:", err)
  1442			return 1
  1443		}
  1444		return 0
  1445	}
  1446	
  1447	func meanValue(values []float64) float64 {
  1448		if len(values) == 0 {
  1449			return 0
  1450		}
  1451		sum := 0.0
  1452		for _, v := range values {
  1453			sum += v
  1454		}
  1455		return sum / float64(len(values))
  1456	}
  1457	
  1458	func sampleStd(values []float64) float64 {
  1459		n := len(values)
  1460		if n <= 1 {
  1461			return 0.0
  1462		}
  1463		mean := meanValue(values)
  1464		ss := 0.0
  1465		for _, v := range values {
  1466			diff := v - mean
  1467			ss += diff * diff
  1468		}
  1469		return math.Sqrt(ss / float64(n-1))
  1470	}
