[?2004l   180	func parseRunArgs(args []string) (string, int, bool, error) {
   181	pipelineFile := ""
   182	experimentIndex := -1
   183	resume := false
   184	for i := 0; i < len(args); i++ {
   185	switch args[i] {
   186	case "--experiment":
   187	if i+1 >= len(args) {
   188	return "", 0, false, fmt.Errorf("--experiment requires an index")
   189	}
   190	idx, err := strconv.Atoi(args[i+1])
   191	if err != nil {
   192	return "", 0, false, fmt.Errorf("invalid experiment index: %v", err)
   193	}
   194	experimentIndex = idx
   195	i++
   196	case "--resume":
   197	resume = true
   198	default:
   199	if pipelineFile == "" {
   200	pipelineFile = args[i]
   201	} else {
   202	return "", 0, false, fmt.Errorf("unexpected argument: %s", args[i])
   203	}
   204	}
   205	}
   206	if pipelineFile == "" {
   207	return "", 0, false, fmt.Errorf("usage: mlpipe run <pipeline.yaml> [--experiment <index>] [--resume]")
   208	}
   209	return pipelineFile, experimentIndex, resume, nil
   210	}
