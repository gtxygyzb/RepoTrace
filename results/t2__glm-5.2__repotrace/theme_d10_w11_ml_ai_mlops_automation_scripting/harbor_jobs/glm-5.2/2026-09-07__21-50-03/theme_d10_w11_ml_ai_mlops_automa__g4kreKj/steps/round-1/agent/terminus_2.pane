   793	func parameterCombinations(p *Pipeline) []map[string]interface{} {
   794		if len(p.Parameters) == 0 {
   795			return []map[string]interface{}{{}}
   796		}
   797		combos := []map[string]interface{}{{}}
   798		for _, param := range p.Parameters {
   799			next := make([]map[string]interface{}, 0, len(combos)*len(param.Values))
   800			for _, combo := range combos {
   801				for _, value := range param.Values {
   802					c := copyMap(combo)
   803					c[param.Name] = value
   804					next = append(next, c)
   805				}
   806			}
   807			combos = next
   808		}
   809		return combos
   810	}
