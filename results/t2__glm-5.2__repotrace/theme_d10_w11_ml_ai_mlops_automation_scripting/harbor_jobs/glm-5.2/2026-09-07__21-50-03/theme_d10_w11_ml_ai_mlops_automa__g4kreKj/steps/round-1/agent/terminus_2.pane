  1230				pipelineFile = arg
  1231			default:
  1232				fmt.Fprintf(os.Stderr, "error: unknown argument %q\n", arg)
  1233				return 1
  1234			}
  1235		}
  1236		if pipelineFile == "" || metricName == "" || paramName == "" {
  1237			fmt.Fprintln(os.Stderr, "Usage: mlpipe sweep <pipeline.yaml> --metric <name> --param <name>")
  1238			return 1
  1239		}
