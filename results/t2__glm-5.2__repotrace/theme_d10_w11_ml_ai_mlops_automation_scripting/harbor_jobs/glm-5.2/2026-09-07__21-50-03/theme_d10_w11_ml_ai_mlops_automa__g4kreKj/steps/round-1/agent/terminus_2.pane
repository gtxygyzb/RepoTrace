   183	func parseRunArgs(args []string) (string, int, bool, error) {
   184		pipelineFile := ""
   185		experimentIndex := -1
   186		resume := false
   187		for i := 0; i < len(args); i++ {
   188			switch args[i] {
   189			case "--experiment":
   190				if i+1 >= len(args) {
   191					return "", 0, false, fmt.Errorf("--experiment requires an index")
   192				}
   193				idx, err := strconv.Atoi(args[i+1])
   194				if err != nil {
   195					return "", 0, false, fmt.Errorf("invalid experiment index: %v", err)
   196				}
   197				experimentIndex = idx
   198				i++
   199			case "--resume":
   200				resume = true
   201			default:
   202				if pipelineFile == "" {
   203					pipelineFile = args[i]
   204				} else {
   205					return "", 0, false, fmt.Errorf("unexpected argument: %s", args[i])
   206				}
   207			}
   208		}
   209		if pipelineFile == "" {
   210			return "", 0, false, fmt.Errorf("usage: mlpipe run <pipeline.yaml> [--experiment <index>] [--resume]")
   211		}
   212		return pipelineFile, experimentIndex, resume, nil
   213	}
   214	
   215	func parseArtifactsArgs(args []string) (string, bool, bool, error) {
   216		pipelineFile := ""
   217		list := false
   218		gc := false
   219		for _, arg := range args {
   220			switch arg {
   221			case "--list":
   222				list = true
   223			case "--gc":
   224				gc = true
   225			default:
   226				if pipelineFile == "" {
   227					pipelineFile = arg
   228				} else {
   229					return "", false, false, fmt.Errorf("unexpected argument: %s", arg)
   230				}
   231			}
   232		}
   233		if pipelineFile == "" {
   234			return "", false, false, fmt.Errorf("usage: mlpipe artifacts <pipeline.yaml> [--list] [--gc]")
   235		}
   236		return pipelineFile, list, gc, nil
   237	}
