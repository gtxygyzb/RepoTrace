type ArtifactEntry struct {
	ExperimentID string `json:"experiment_id"`
	StageName    string `json:"stage_name"`
	Path         string `json:"path"`
	Hash         string `json:"hash"`
	Size         int64  `json:"size"`
}

type ArtifactIndex struct {
	Entries []ArtifactEntry `json:"entries"`
}

type yamlLine struct {
	indent  int
	content string
}

func loadPipeline(path string) (*Pipeline, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	v, err := parseYAML(data)
	if err != nil {
		return nil, err
	}
	return mapToPipeline(v)
}

func parseYAML(data []byte) (interface{}, error) {
	var lines []yamlLine
	for _, raw := range strings.Split(string(data), "\n") {
		raw = strings.TrimRight(raw, "\r")
		trimmed := strings.TrimSpace(raw)
		if trimmed == "" || strings.HasPrefix(trimmed, "#") {
			continue
		}
		indent := 0
		for indent < len(raw) && raw[indent] == ' ' {
			indent++
		}
		content := strings.TrimRight(raw[indent:], " ")
		lines = append(lines, yamlLine{indent: indent, content: content})
	}
	if len(lines) == 0 {
		return nil, nil
	}
	v, idx := parseBlock(lines, 0, 0)
	if idx < len(lines) {
		return nil, fmt.Errorf("unexpected YAML structure at line: %q", lines[idx].content)
	}
	return v, nil
}

func parseBlock(lines []yamlLine, idx int, indent int) (interface{}, int) {
	if idx >= len(lines) || lines[idx].indent < indent {
		return nil, idx
	}
	if strings.HasPrefix(lines[idx].content, "- ") || lines[idx].content == "-" {
		return parseSequence(lines, idx, indent)
	}
	return parseMapping(lines, idx, indent)
}

func parseSequence(lines []yamlLine, idx int, indent int) (interface{}, int) {
	seq := []interface{}{}
	for idx < len(lines) && lines[idx].indent == indent && (strings.HasPrefix(lines[idx].content, "- ") || lines[idx].content == "-") {
		content := strings.TrimPrefix(lines[idx].content, "-")
		content = strings.TrimLeft(content, " ")
		if content == "" {
			val, next := parseBlock(lines, idx+1, indent+2)
			seq = append(seq, val)
			idx = next
			continue
		}
		if isMappingStart(content) {
			sublines := []yamlLine{{indent: indent + 2, content: content}}
			start := idx + 1
			for start < len(lines) && lines[start].indent > indent {
				sublines = append(sublines, lines[start])
				start++
			}
			val, _ := parseBlock(sublines, 0, indent+2)
			seq = append(seq, val)
			idx = start
		} else {
			seq = append(seq, parseScalar(content))
			idx++
		}
	}
	return seq, idx
}

func parseMapping(lines []yamlLine, idx int, indent int) (interface{}, int) {
	m := map[string]interface{}{}
	for idx < len(lines) && lines[idx].indent == indent {
		content := lines[idx].content
		if strings.HasPrefix(content, "- ") || content == "-" {
			break
		}
		key, value, ok := splitKeyValue(content)
		if !ok {
			return nil, idx
		}
		if value != "" {
			m[key] = parseScalar(value)
			idx++
		} else {
			val, next := parseBlock(lines, idx+1, indent+2)
			m[key] = val
			idx = next
		}
	}
	return m, idx
}

func isMappingStart(s string) bool {
	if strings.HasPrefix(s, "[") || strings.HasPrefix(s, "{") {
		return false
	}
	_, _, ok := splitKeyValue(s)
	return ok
}

func splitKeyValue(s string) (string, string, bool) {
	inQuote := false
	quoteChar := byte(0)
	for i := 0; i < len(s); i++ {
		c := s[i]
		if inQuote {
			if c == quoteChar {
				inQuote = false
			}
			continue
		}
		if c == '"' || c == '\'' {
			inQuote = true
			quoteChar = c
			continue
		}
		if c == ':' {
			if i+1 >= len(s) || s[i+1] == ' ' {
				key := strings.TrimSpace(s[:i])
				value := strings.TrimSpace(s[i+1:])
				key = unquoteScalar(key)
				return key, value, true
			}
		}
	}
	return "", "", false
}

func parseScalar(s string) interface{} {
	s = strings.TrimSpace(s)
	if s == "" {
		return ""
	}
	if strings.HasPrefix(s, "[") && strings.HasSuffix(s, "]") {
		return parseInlineList(s)
	}
	if strings.HasPrefix(s, "{") && strings.HasSuffix(s, "}") {
		return parseInlineMap(s)
	}
	if len(s) >= 2 && (s[0] == '"' && s[len(s)-1] == '"' || s[0] == '\'' && s[len(s)-1] == '\'') {
		return unquoteScalar(s)
	}
	if s == "true" {
		return true
	}
	if s == "false" {
		return false
	}
	if n, err := strconv.Atoi(s); err == nil {
		return n
	}
	if f, err := strconv.ParseFloat(s, 64); err == nil {
		return f
	}
	return s
}

func parseInlineList(s string) interface{} {
	inner := strings.TrimSpace(s[1 : len(s)-1])
	if inner == "" {
		return []interface{}{}
	}
	parts := splitCommas(inner)
	out := make([]interface{}, 0, len(parts))
	for _, p := range parts {
		out = append(out, parseScalar(strings.TrimSpace(p)))
	}
	return out
}

func parseInlineMap(s string) interface{} {
	inner := strings.TrimSpace(s[1 : len(s)-1])
	if inner == "" {
		return map[string]interface{}{}
	}
	parts := splitCommas(inner)
	m := map[string]interface{}{}
	for _, p := range parts {
		key, value, ok := splitKeyValue(strings.TrimSpace(p))
		if ok {
			m[key] = parseScalar(value)
		}
	}
	return m
}

func splitCommas(s string) []string {
	var parts []string
	inQuote := false
	quoteChar := byte(0)
	depth := 0
	start := 0
	for i := 0; i < len(s); i++ {
		c := s[i]
		if inQuote {
			if c == quoteChar {
				inQuote = false
			}
			continue
		}
		if c == '"' || c == '\'' {
			inQuote = true
			quoteChar = c
			continue
		}
		if c == '[' || c == '{' {
			depth++
			continue
		}
		if c == ']' || c == '}' {
			depth--
			continue
		}
		if c == ',' && depth == 0 {
			parts = append(parts, s[start:i])
			start = i + 1
		}
	}
	parts = append(parts, s[start:])
	return parts
}

func unquoteScalar(s string) string {
	s = strings.TrimSpace(s)
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		unq, err := strconv.Unquote(s)
		if err == nil {
			return unq
		}
		return s[1 : len(s)-1]
	}
	if len(s) >= 2 && s[0] == '\'' && s[len(s)-1] == '\'' {
		return strings.ReplaceAll(s[1:len(s)-1], "''", "'")
	}
	return s
}

func mapToPipeline(v interface{}) (*Pipeline, error) {
	p := &Pipeline{}
	root := asMap(v)
	if root == nil {
		return p, nil
	}
	p.Name = asString(root["name"])
	p.Version = asString(root["version"])
	if params, ok := root["parameters"].(map[string]interface{}); ok {
		keys := make([]string, 0, len(params))
		for k := range params {
			keys = append(keys, k)
		}
		sort.Strings(keys)
		for _, k := range keys {
			pm := asMap(params[k])
			p.Parameters = append(p.Parameters, Parameter{Name: k, Values: asSlice(pm["values"])})
		}
	}
	for _, sv := range asSlice(root["stages"]) {
		sm := asMap(sv)
		stage := Stage{
			Name:    asString(sm["name"]),
			Command: asString(sm["command"]),
		}
		stage.DependsOn = toStringSlice(asSlice(sm["depends_on"]))
		stage.Env = toStringMap(asMap(sm["env"]))
		for _, mv := range asSlice(sm["metrics"]) {
			mm := asMap(mv)
			stage.Metrics = append(stage.Metrics, Metric{Name: asString(mm["name"]), Objective: asString(mm["objective"])})
		}
		if rv := asMap(sm["retry"]); rv != nil {
			stage.Retry = &Retry{MaxAttempts: asInt(rv["max_attempts"]), BackoffSeconds: asFloat(rv["backoff_seconds"])}
		}
		if cv := asMap(sm["condition"]); cv != nil {
			stage.Condition = &Condition{Metric: asString(cv["metric"]), Operator: asString(cv["operator"]), Threshold: asFloat(cv["threshold"])}
		}
		for _, ov := range asSlice(sm["outputs"]) {
			om := asMap(ov)
			stage.Outputs = append(stage.Outputs, ArtifactRef{Path: asString(om["path"]), Type: asString(om["type"])})
		}
		for _, iv := range asSlice(sm["inputs"]) {
			im := asMap(iv)
			stage.Inputs = append(stage.Inputs, ArtifactRef{Path: asString(im["path"]), Type: asString(im["type"])})
		}
		p.Stages = append(p.Stages, stage)
	}
	return p, nil
}

func asMap(v interface{}) map[string]interface{} {
	if m, ok := v.(map[string]interface{}); ok {
		return m
	}
	return nil
}

func asSlice(v interface{}) []interface{} {
	if s, ok := v.([]interface{}); ok {
		return s
	}
	return nil
}

func asString(v interface{}) string {
	if v == nil {
		return ""
	}
	switch x := v.(type) {
	case string:
		return x
	case int:
		return strconv.Itoa(x)
	case float64:
		return formatFloat(x)
	case bool:
		return strconv.FormatBool(x)
	default:
		return fmt.Sprint(x)
	}
}

func asInt(v interface{}) int {
	switch x := v.(type) {
	case int:
		return x
	case float64:
		return int(x)
	case string:
		n, _ := strconv.Atoi(x)
		return n
	default:
		return 0
	}
}

func asFloat(v interface{}) float64 {
	switch x := v.(type) {
	case float64:
		return x
	case int:
		return float64(x)
	case string:
		f, _ := strconv.ParseFloat(x, 64)
		return f
	default:
		return 0
	}
}

func toStringSlice(v []interface{}) []string {
	out := make([]string, 0, len(v))
	for _, item := range v {
		out = append(out, asString(item))
	}
	return out
}

func toStringMap(m map[string]interface{}) map[string]string {
	out := make(map[string]string)
	for k, v := range m {
		out[k] = asString(v)
	}
	return out
}

func formatFloat(f float64) string {
	return strconv.FormatFloat(f, 'g', -1, 64)
}

func validatePipeline(p *Pipeline) []string {
	var errs []string
	names := make(map[string]int)
	stageSet := make(map[string]bool)
	stageMap := make(map[string]Stage)

[?2004hroot@n30009:/app# sed -n '700,1100p' main.go
[?2004l
	for i, stage := range p.Stages {
		if stage.Name == "" {
			errs = append(errs, fmt.Sprintf("stage %d: missing required field name", i))
		}
		if stage.Command == "" {
			errs = append(errs, fmt.Sprintf("stage %d: missing required field command", i))
		}
		if stage.Name != "" {
			if prev, ok := names[stage.Name]; ok {
				errs = append(errs, fmt.Sprintf("duplicate stage name: %s (stages %d and %d)", stage.Name, prev, i))
			} else {
				names[stage.Name] = i
			}
			stageSet[stage.Name] = true
			stageMap[stage.Name] = stage
		}
	}

	for _, stage := range p.Stages {
		for _, dep := range stage.DependsOn {
			if !stageSet[dep] {
				errs = append(errs, fmt.Sprintf("stage %q depends on undefined stage %q", stage.Name, dep))
			}
		}
	}

	for _, stage := range p.Stages {
		if stage.Name == "" {
			continue
		}
		state := make(map[string]int)
		var check func(name string)
		check = func(name string) {
			state[name] = 1
			for _, dep := range stageMap[name].DependsOn {
				if !stageSet[dep] {
					continue
				}
				if state[dep] == 1 {
					errs = append(errs, fmt.Sprintf("circular dependency detected involving stage: %s", name))
				} else if state[dep] == 0 {
					check(dep)
				}
			}
			state[name] = 2
		}
		check(stage.Name)
	}

	return errs
}

func topologicalGroups(p *Pipeline) ([][]string, error) {
	stageMap := make(map[string]Stage)
	for _, stage := range p.Stages {
		stageMap[stage.Name] = stage
	}

	completed := make(map[string]bool)
	remaining := make(map[string]bool)
	for _, stage := range p.Stages {
		remaining[stage.Name] = true
	}

	var groups [][]string
	for len(remaining) > 0 {
		var ready []string
		for name := range remaining {
			ok := true
			for _, dep := range stageMap[name].DependsOn {
				if !completed[dep] {
					ok = false
					break
				}
			}
			if ok {
				ready = append(ready, name)
			}
		}
		sort.Strings(ready)
		if len(ready) == 0 {
			return nil, fmt.Errorf("circular dependency detected among stages: %v", sortedKeys(remaining))
		}
		groups = append(groups, ready)
		for _, name := range ready {
			completed[name] = true
			delete(remaining, name)
		}
	}
	return groups, nil
}

func parameterCombinations(p *Pipeline) []map[string]interface{} {
	if len(p.Parameters) == 0 {
		return []map[string]interface{}{{}}
	}
	combos := []map[string]interface{}{{}}
	for _, param := range p.Parameters {
		next := make([]map[string]interface{}, 0, len(combos)*len(param.Values))
		for _, combo := range combos {
			for _, value := range param.Values {
				c := copyMap(combo)
				c[param.Name] = value
				next = append(next, c)
			}
		}
		combos = next
	}
	return combos
}

func experimentID(combo map[string]interface{}) string {
	if len(combo) == 0 {
		return "exp_default"
	}
	keys := make([]string, 0, len(combo))
	for k := range combo {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	parts := make([]string, 0, len(keys))
	for _, k := range keys {
		parts = append(parts, k+"="+asString(combo[k]))
	}
	return "exp_" + strings.Join(parts, "_")
}

func substituteParams(value string, combo map[string]interface{}) string {
	for k, v := range combo {
		value = strings.ReplaceAll(value, "${"+k+"}", asString(v))
	}
	return value
}

func copyMap(m map[string]interface{}) map[string]interface{} {
	out := make(map[string]interface{}, len(m))
	for k, v := range m {
		out[k] = v
	}
	return out
}

func sortedKeys(m map[string]bool) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

func stateDir(experimentID string) string {
	return filepath.Join(".mlpipe", "state", experimentID)
}

func stageStatePath(experimentID, stageName string) string {
	return filepath.Join(stateDir(experimentID), stageName+".json")
}

func experimentStateExists(id string) bool {
	info, err := os.Stat(stateDir(id))
	return err == nil && info.IsDir()
}

func readStageState(experimentID, stageName string) (*StageState, error) {
	data, err := os.ReadFile(stageStatePath(experimentID, stageName))
	if err != nil {
		return nil, err
	}
	var st StageState
	if err := json.Unmarshal(data, &st); err != nil {
		return nil, err
	}
	return &st, nil
}

func writeStageState(experimentID, stageName string, st *StageState) error {
	if err := os.MkdirAll(stateDir(experimentID), 0755); err != nil {
		return err
	}
	data, err := json.MarshalIndent(st, "", "  ")
	if err != nil {
		return err
	}
	return os.WriteFile(stageStatePath(experimentID, stageName), data, 0644)
}

func artifactsIndexPath() string {
	return filepath.Join(".mlpipe", "artifacts", "index.json")
}

func loadArtifactIndex() *ArtifactIndex {
	idx := &ArtifactIndex{}
	data, err := os.ReadFile(artifactsIndexPath())
	if err != nil {
		return idx
	}
	if err := json.Unmarshal(data, idx); err != nil {
		return &ArtifactIndex{}
	}
	return idx
}

func saveArtifactIndex(idx *ArtifactIndex) error {
	if err := os.MkdirAll(filepath.Dir(artifactsIndexPath()), 0755); err != nil {
		return err
	}
	data, err := json.MarshalIndent(idx, "", "  ")
	if err != nil {
		return err
	}
	return os.WriteFile(artifactsIndexPath(), data, 0644)
}

func artifactsList() int {
	idx := loadArtifactIndex()
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	if err := enc.Encode(idx); err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	return 0
}

func artifactsGC(p *Pipeline) int {
	expected := make(map[string]bool)
	for _, combo := range parameterCombinations(p) {
		expected[experimentID(combo)] = true
	}
	entries, err := os.ReadDir(filepath.Join(".mlpipe", "state"))
	if err != nil {
		return 0
	}
	for _, entry := range entries {
		if !expected[entry.Name()] {
			_ = os.RemoveAll(filepath.Join(".mlpipe", "state", entry.Name()))
		}
	}
	return 0
}

func reportPipeline(p *Pipeline) int {
	type reportExperiment struct {
		ID      string             `json:"id"`
		Metrics map[string]float64 `json:"metrics"`
		Stages  []StageState       `json:"stages"`
	}
	type sensitivityEntry struct {
		BestWithout  string  `json:"best_without"`
		MaxComposite float64 `json:"max_composite"`
	}
	type reportOutput struct {
		Pipeline          string                        `json:"pipeline"`
		Experiments       []reportExperiment            `json:"experiments"`
		MetricSummary     map[string]metricSummaryEntry `json:"metric_summary"`
		MetricRankings    map[string]map[string]int     `json:"metric_rankings"`
		CompositeScores   map[string]float64            `json:"composite_scores"`
		NormalizedMetrics map[string]map[string]float64 `json:"normalized_metrics"`
		MetricImportance  map[string]float64            `json:"metric_importance"`
		ScoreSensitivity  map[string]sensitivityEntry   `json:"score_sensitivity"`
		BestExperiment    string                        `json:"best_experiment"`
	}

	out := reportOutput{
		Pipeline:          p.Name,
		Experiments:       []reportExperiment{},
		MetricSummary:     map[string]metricSummaryEntry{},
		MetricRankings:    map[string]map[string]int{},
		CompositeScores:   map[string]float64{},
		NormalizedMetrics: map[string]map[string]float64{},
		MetricImportance:  map[string]float64{},
		ScoreSensitivity:  map[string]sensitivityEntry{},
	}
	metricValues := map[string][]float64{}
	for _, combo := range parameterCombinations(p) {
		id := experimentID(combo)
		exp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}
		for _, stage := range p.Stages {
			if st, err := readStageState(id, stage.Name); err == nil {
				exp.Stages = append(exp.Stages, *st)
				for _, m := range st.Metrics {
					exp.Metrics[m.Name] = m.Value
					metricValues[m.Name] = append(metricValues[m.Name], m.Value)
				}
			}
		}
		out.Experiments = append(out.Experiments, exp)
	}
	for name, values := range metricValues {
		out.MetricSummary[name] = metricSummaryEntry{
			Count: len(values),
			Mean:  round4(meanValue(values)),
			Std:   round4(sampleStd(values)),
			Min:   round4(minValue(values)),
			Max:   round4(maxValue(values)),
		}
	}

	objectives := map[string]string{}
	for _, stage := range p.Stages {
		for _, m := range stage.Metrics {
			if m.Objective == "minimize" || m.Objective == "maximize" {
				objectives[m.Name] = m.Objective
			}
		}
	}
	objMetrics := make([]string, 0, len(objectives))
	for m := range objectives {
		if _, ok := metricValues[m]; ok {
			objMetrics = append(objMetrics, m)
		}
	}
	sort.Strings(objMetrics)

	if len(objMetrics) > 0 {
		minVal := map[string]float64{}
		maxVal := map[string]float64{}
