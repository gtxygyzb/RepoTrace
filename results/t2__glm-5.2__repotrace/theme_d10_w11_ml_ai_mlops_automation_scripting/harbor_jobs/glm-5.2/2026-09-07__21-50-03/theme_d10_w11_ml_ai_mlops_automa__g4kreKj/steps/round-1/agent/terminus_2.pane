func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "Usage: mlpipe <command> [args...]")
		fmt.Fprintln(os.Stderr, "Commands: validate, plan, run, report, artifacts, compare, sweep, export")
		os.Exit(1)
	}

	cmd := os.Args[1]
	args := os.Args[2:]

	switch cmd {
	case "validate":
		os.Exit(cmdValidate(args))
	case "plan":
		os.Exit(cmdPlan(args))
	case "run":
		os.Exit(cmdRun(args))
	case "report":
		os.Exit(cmdReport(args))
	case "export":
		os.Exit(cmdExport(args))
	case "artifacts":
		os.Exit(cmdArtifacts(args))
	case "compare":
		os.Exit(cmdCompare(args))
	case "sweep":
		os.Exit(cmdSweep(args))
	default:
		fmt.Fprintf(os.Stderr, "error: command %q is not implemented\n", cmd)
		os.Exit(1)
	}
}

func cmdValidate(args []string) int {
	if len(args) < 1 {
		fmt.Fprintln(os.Stderr, "Usage: mlpipe validate <pipeline.yaml>")
		return 1
	}
	p, err := loadPipeline(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	errs := validatePipeline(p)
	if len(errs) > 0 {
		for _, e := range errs {
			fmt.Println(e)
		}
		return 1
	}
	return 0
}

func cmdPlan(args []string) int {
	if len(args) < 1 {
		fmt.Fprintln(os.Stderr, "Usage: mlpipe plan <pipeline.yaml>")
		return 1
	}
	p, err := loadPipeline(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	if errs := validatePipeline(p); len(errs) > 0 {
		for _, e := range errs {
			fmt.Fprintln(os.Stderr, e)
		}
		return 1
	}
	groups, err := topologicalGroups(p)
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	combos := parameterCombinations(p)
	out := struct {
		StagesOrder           [][]string               `json:"stages_order"`
		TotalExperiments      int                      `json:"total_experiments"`
		ParameterCombinations []map[string]interface{} `json:"parameter_combinations"`
	}{
		StagesOrder:           groups,
		TotalExperiments:      len(combos),
		ParameterCombinations: combos,
	}
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	if err := enc.Encode(out); err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	return 0
}

func cmdRun(args []string) int {
	pipelineFile, experimentIndex, resume, err := parseRunArgs(args)
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	p, err := loadPipeline(pipelineFile)
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	if errs := validatePipeline(p); len(errs) > 0 {
		for _, e := range errs {
			fmt.Fprintln(os.Stderr, e)
		}
		return 1
	}
	combos := parameterCombinations(p)
	if experimentIndex >= 0 {
		if experimentIndex >= len(combos) {
			fmt.Fprintf(os.Stderr, "error: experiment index %d out of range (0..%d)\n", experimentIndex, len(combos)-1)
			return 1
		}
		combos = []map[string]interface{}{combos[experimentIndex]}
	}
	for _, combo := range combos {
		id := experimentID(combo)
		fmt.Fprintf(os.Stderr, "Running experiment %s\n", id)
		if err := runExperiment(p, combo, resume); err != nil {
			fmt.Fprintln(os.Stderr, "error:", err)
			return 1
		}
	}
	return 0
}

func cmdReport(args []string) int {
	if len(args) < 1 {
		fmt.Fprintln(os.Stderr, "Usage: mlpipe report <pipeline.yaml>")
		return 1
	}
	p, err := loadPipeline(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	if errs := validatePipeline(p); len(errs) > 0 {
		for _, e := range errs {
			fmt.Fprintln(os.Stderr, e)
		}
		return 1
	}
	return reportPipeline(p)
}

func cmdArtifacts(args []string) int {
	pipelineFile, list, gc, err := parseArtifactsArgs(args)
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	p, err := loadPipeline(pipelineFile)
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		return 1
	}
	if gc {
		return artifactsGC(p)
	}
	_ = list
	return artifactsList()
}

func parseRunArgs(args []string) (string, int, bool, error) {
	pipelineFile := ""
	experimentIndex := -1
	resume := false
	for i := 0; i < len(args); i++ {
		switch args[i] {
		case "--experiment":
			if i+1 >= len(args) {
				return "", 0, false, fmt.Errorf("--experiment requires an index")
			}
			idx, err := strconv.Atoi(args[i+1])
			if err != nil {
				return "", 0, false, fmt.Errorf("invalid experiment index: %v", err)
			}
			experimentIndex = idx
			i++
		case "--resume":
			resume = true
		default:
			if pipelineFile == "" {
				pipelineFile = args[i]
			} else {
				return "", 0, false, fmt.Errorf("unexpected argument: %s", args[i])
			}
		}
	}
	if pipelineFile == "" {
		return "", 0, false, fmt.Errorf("usage: mlpipe run <pipeline.yaml> [--experiment <index>] [--resume]")
	}
	return pipelineFile, experimentIndex, resume, nil
}

func parseArtifactsArgs(args []string) (string, bool, bool, error) {
	pipelineFile := ""
	list := false
	gc := false
	for _, arg := range args {
		switch arg {
		case "--list":
			list = true
		case "--gc":
			gc = true
		default:
			if pipelineFile == "" {
				pipelineFile = arg
			} else {
				return "", false, false, fmt.Errorf("unexpected argument: %s", arg)
			}
		}
	}
	if pipelineFile == "" {
		return "", false, false, fmt.Errorf("usage: mlpipe artifacts <pipeline.yaml> [--list] [--gc]")
	}
	return pipelineFile, list, gc, nil
}

type Pipeline struct {
	Name       string
	Version    string
	Parameters []Parameter
	Stages     []Stage
}

type Parameter struct {
	Name   string
	Values []interface{}
}

type Stage struct {
	Name      string
	Command   string
	DependsOn []string
	Env       map[string]string
	Metrics   []Metric
	Retry     *Retry
	Condition *Condition
	Outputs   []ArtifactRef
	Inputs    []ArtifactRef
}

type Metric struct {
	Name      string
	Objective string
}

type Retry struct {
	MaxAttempts    int
	BackoffSeconds float64
}

type Condition struct {
	Metric    string
	Operator  string
	Threshold float64
}

type ArtifactRef struct {
	Path string
	Type string
}

type MetricData struct {
	Name  string  `json:"name"`
	Value float64 `json:"value"`
}

type StageState struct {
	Name      string       `json:"name"`
	Status    string       `json:"status"`
	ExitCode  int          `json:"exit_code"`
	Metrics   []MetricData `json:"metrics"`
	StartTime string       `json:"start_time"`
	EndTime   string       `json:"end_time"`
	Retries   int          `json:"retries"`
}

type ArtifactEntry struct {
	ExperimentID string `json:"experiment_id"`
	StageName    string `json:"stage_name"`
	Path         string `json:"path"`
	Hash         string `json:"hash"`
	Size         int64  `json:"size"`
}

type ArtifactIndex struct {
	Entries []ArtifactEntry `json:"entries"`
}

type yamlLine struct {
	indent  int
	content string
}

func loadPipeline(path string) (*Pipeline, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	v, err := parseYAML(data)
	if err != nil {
		return nil, err
	}
	return mapToPipeline(v)
}

func parseYAML(data []byte) (interface{}, error) {
	var lines []yamlLine
	for _, raw := range strings.Split(string(data), "\n") {
		raw = strings.TrimRight(raw, "\r")
		trimmed := strings.TrimSpace(raw)
		if trimmed == "" || strings.HasPrefix(trimmed, "#") {
			continue
		}
		indent := 0
		for indent < len(raw) && raw[indent] == ' ' {
			indent++
		}
		content := strings.TrimRight(raw[indent:], " ")
		lines = append(lines, yamlLine{indent: indent, content: content})
	}
	if len(lines) == 0 {
		return nil, nil
	}
	v, idx := parseBlock(lines, 0, 0)
	if idx < len(lines) {
		return nil, fmt.Errorf("unexpected YAML structure at line: %q", lines[idx].content)
	}
	return v, nil
}

func parseBlock(lines []yamlLine, idx int, indent int) (interface{}, int) {
	if idx >= len(lines) || lines[idx].indent < indent {
		return nil, idx
[?2004hroot@n30009:/app# sed -n '360,760p' main.go
[?2004l		return nil, idx
	}
	if strings.HasPrefix(lines[idx].content, "- ") || lines[idx].content == "-" {
		return parseSequence(lines, idx, indent)
	}
	return parseMapping(lines, idx, indent)
}

func parseSequence(lines []yamlLine, idx int, indent int) (interface{}, int) {
	seq := []interface{}{}
	for idx < len(lines) && lines[idx].indent == indent && (strings.HasPrefix(lines[idx].content, "- ") || lines[idx].content == "-") {
		content := strings.TrimPrefix(lines[idx].content, "-")
		content = strings.TrimLeft(content, " ")
		if content == "" {
			val, next := parseBlock(lines, idx+1, indent+2)
			seq = append(seq, val)
			idx = next
			continue
		}
		if isMappingStart(content) {
			sublines := []yamlLine{{indent: indent + 2, content: content}}
			start := idx + 1
			for start < len(lines) && lines[start].indent > indent {
				sublines = append(sublines, lines[start])
				start++
			}
			val, _ := parseBlock(sublines, 0, indent+2)
			seq = append(seq, val)
			idx = start
		} else {
			seq = append(seq, parseScalar(content))
			idx++
		}
	}
	return seq, idx
}

func parseMapping(lines []yamlLine, idx int, indent int) (interface{}, int) {
	m := map[string]interface{}{}
	for idx < len(lines) && lines[idx].indent == indent {
		content := lines[idx].content
		if strings.HasPrefix(content, "- ") || content == "-" {
			break
		}
		key, value, ok := splitKeyValue(content)
		if !ok {
			return nil, idx
		}
		if value != "" {
			m[key] = parseScalar(value)
			idx++
		} else {
			val, next := parseBlock(lines, idx+1, indent+2)
			m[key] = val
			idx = next
		}
	}
	return m, idx
}

func isMappingStart(s string) bool {
	if strings.HasPrefix(s, "[") || strings.HasPrefix(s, "{") {
		return false
	}
	_, _, ok := splitKeyValue(s)
	return ok
}

func splitKeyValue(s string) (string, string, bool) {
	inQuote := false
	quoteChar := byte(0)
	for i := 0; i < len(s); i++ {
		c := s[i]
		if inQuote {
			if c == quoteChar {
				inQuote = false
			}
			continue
		}
		if c == '"' || c == '\'' {
			inQuote = true
			quoteChar = c
			continue
		}
		if c == ':' {
			if i+1 >= len(s) || s[i+1] == ' ' {
				key := strings.TrimSpace(s[:i])
				value := strings.TrimSpace(s[i+1:])
				key = unquoteScalar(key)
				return key, value, true
			}
		}
	}
	return "", "", false
}

func parseScalar(s string) interface{} {
	s = strings.TrimSpace(s)
	if s == "" {
		return ""
	}
	if strings.HasPrefix(s, "[") && strings.HasSuffix(s, "]") {
		return parseInlineList(s)
	}
	if strings.HasPrefix(s, "{") && strings.HasSuffix(s, "}") {
		return parseInlineMap(s)
	}
	if len(s) >= 2 && (s[0] == '"' && s[len(s)-1] == '"' || s[0] == '\'' && s[len(s)-1] == '\'') {
		return unquoteScalar(s)
	}
	if s == "true" {
		return true
	}
	if s == "false" {
		return false
	}
	if n, err := strconv.Atoi(s); err == nil {
		return n
	}
	if f, err := strconv.ParseFloat(s, 64); err == nil {
		return f
	}
	return s
}

func parseInlineList(s string) interface{} {
	inner := strings.TrimSpace(s[1 : len(s)-1])
	if inner == "" {
		return []interface{}{}
	}
	parts := splitCommas(inner)
	out := make([]interface{}, 0, len(parts))
	for _, p := range parts {
		out = append(out, parseScalar(strings.TrimSpace(p)))
	}
	return out
}

func parseInlineMap(s string) interface{} {
	inner := strings.TrimSpace(s[1 : len(s)-1])
	if inner == "" {
		return map[string]interface{}{}
	}
	parts := splitCommas(inner)
	m := map[string]interface{}{}
	for _, p := range parts {
		key, value, ok := splitKeyValue(strings.TrimSpace(p))
		if ok {
			m[key] = parseScalar(value)
		}
	}
	return m
}

func splitCommas(s string) []string {
	var parts []string
	inQuote := false
	quoteChar := byte(0)
	depth := 0
	start := 0
	for i := 0; i < len(s); i++ {
		c := s[i]
		if inQuote {
			if c == quoteChar {
				inQuote = false
			}
			continue
		}
		if c == '"' || c == '\'' {
			inQuote = true
			quoteChar = c
			continue
		}
		if c == '[' || c == '{' {
			depth++
			continue
		}
		if c == ']' || c == '}' {
			depth--
			continue
		}
		if c == ',' && depth == 0 {
			parts = append(parts, s[start:i])
			start = i + 1
		}
	}
	parts = append(parts, s[start:])
	return parts
}

func unquoteScalar(s string) string {
	s = strings.TrimSpace(s)
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		unq, err := strconv.Unquote(s)
		if err == nil {
			return unq
		}
		return s[1 : len(s)-1]
	}
	if len(s) >= 2 && s[0] == '\'' && s[len(s)-1] == '\'' {
		return strings.ReplaceAll(s[1:len(s)-1], "''", "'")
	}
	return s
}

func mapToPipeline(v interface{}) (*Pipeline, error) {
	p := &Pipeline{}
	root := asMap(v)
	if root == nil {
		return p, nil
	}
	p.Name = asString(root["name"])
	p.Version = asString(root["version"])
	if params, ok := root["parameters"].(map[string]interface{}); ok {
		keys := make([]string, 0, len(params))
		for k := range params {
			keys = append(keys, k)
		}
		sort.Strings(keys)
		for _, k := range keys {
			pm := asMap(params[k])
			p.Parameters = append(p.Parameters, Parameter{Name: k, Values: asSlice(pm["values"])})
		}
	}
	for _, sv := range asSlice(root["stages"]) {
		sm := asMap(sv)
		stage := Stage{
			Name:    asString(sm["name"]),
			Command: asString(sm["command"]),
		}
		stage.DependsOn = toStringSlice(asSlice(sm["depends_on"]))
		stage.Env = toStringMap(asMap(sm["env"]))
		for _, mv := range asSlice(sm["metrics"]) {
			mm := asMap(mv)
			stage.Metrics = append(stage.Metrics, Metric{Name: asString(mm["name"]), Objective: asString(mm["objective"])})
		}
		if rv := asMap(sm["retry"]); rv != nil {
			stage.Retry = &Retry{MaxAttempts: asInt(rv["max_attempts"]), BackoffSeconds: asFloat(rv["backoff_seconds"])}
		}
		if cv := asMap(sm["condition"]); cv != nil {
			stage.Condition = &Condition{Metric: asString(cv["metric"]), Operator: asString(cv["operator"]), Threshold: asFloat(cv["threshold"])}
		}
		for _, ov := range asSlice(sm["outputs"]) {
			om := asMap(ov)
			stage.Outputs = append(stage.Outputs, ArtifactRef{Path: asString(om["path"]), Type: asString(om["type"])})
		}
		for _, iv := range asSlice(sm["inputs"]) {
			im := asMap(iv)
			stage.Inputs = append(stage.Inputs, ArtifactRef{Path: asString(im["path"]), Type: asString(im["type"])})
		}
		p.Stages = append(p.Stages, stage)
	}
	return p, nil
}

func asMap(v interface{}) map[string]interface{} {
	if m, ok := v.(map[string]interface{}); ok {
		return m
	}
	return nil
}

func asSlice(v interface{}) []interface{} {
	if s, ok := v.([]interface{}); ok {
		return s
	}
	return nil
}

func asString(v interface{}) string {
	if v == nil {
		return ""
	}
	switch x := v.(type) {
	case string:
		return x
	case int:
		return strconv.Itoa(x)
	case float64:
		return formatFloat(x)
	case bool:
		return strconv.FormatBool(x)
	default:
		return fmt.Sprint(x)
	}
}

func asInt(v interface{}) int {
	switch x := v.(type) {
	case int:
		return x
	case float64:
		return int(x)
	case string:
		n, _ := strconv.Atoi(x)
		return n
	default:
		return 0
	}
}

func asFloat(v interface{}) float64 {
	switch x := v.(type) {
	case float64:
		return x
	case int:
		return float64(x)
	case string:
		f, _ := strconv.ParseFloat(x, 64)
		return f
	default:
		return 0
	}
}

func toStringSlice(v []interface{}) []string {
	out := make([]string, 0, len(v))
	for _, item := range v {
		out = append(out, asString(item))
	}
	return out
}

func toStringMap(m map[string]interface{}) map[string]string {
	out := make(map[string]string)
	for k, v := range m {
		out[k] = asString(v)
	}
	return out
}

func formatFloat(f float64) string {
	return strconv.FormatFloat(f, 'g', -1, 64)
}

func validatePipeline(p *Pipeline) []string {
	var errs []string
	names := make(map[string]int)
	stageSet := make(map[string]bool)
	stageMap := make(map[string]Stage)

	for i, stage := range p.Stages {
		if stage.Name == "" {
			errs = append(errs, fmt.Sprintf("stage %d: missing required field name", i))
		}
		if stage.Command == "" {
			errs = append(errs, fmt.Sprintf("stage %d: missing required field command", i))
		}
		if stage.Name != "" {
			if prev, ok := names[stage.Name]; ok {
				errs = append(errs, fmt.Sprintf("duplicate stage name: %s (stages %d and %d)", stage.Name, prev, i))
			} else {
				names[stage.Name] = i
			}
			stageSet[stage.Name] = true
			stageMap[stage.Name] = stage
		}
	}

	for _, stage := range p.Stages {
		for _, dep := range stage.DependsOn {
			if !stageSet[dep] {
				errs = append(errs, fmt.Sprintf("stage %q depends on undefined stage %q", stage.Name, dep))
			}
		}
	}

	for _, stage := range p.Stages {
		if stage.Name == "" {
			continue
		}
		state := make(map[string]int)
		var check func(name string)
		check = func(name string) {
			state[name] = 1
			for _, dep := range stageMap[name].DependsOn {
				if !stageSet[dep] {
					continue
				}
				if state[dep] == 1 {
					errs = append(errs, fmt.Sprintf("circular dependency detected involving stage: %s", name))
				} else if state[dep] == 0 {
					check(dep)
				}
			}
			state[name] = 2
		}
		check(stage.Name)
	}

	return errs
}

