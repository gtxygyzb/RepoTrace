    53	if err != nil {
    54	fmt.Fprintln(os.Stderr, "error:", err)
    55	return 1
    56	}
    57	errs := validatePipeline(p)
    58	if len(errs) > 0 {
    59	for _, e := range errs {
    60	fmt.Println(e)
    61	}
    62	return 1
    63	}
    64	return 0
    65	}
    66	
    67	func cmdPlan(args []string) int {
    68	if len(args) < 1 {
    69	fmt.Fprintln(os.Stderr, "Usage: mlpipe plan <pipeline.yaml>")
    70	return 1
    71	}
    72	p, err := loadPipeline(args[0])
    73	if err != nil {
    74	fmt.Fprintln(os.Stderr, "error:", err)
    75	return 1
    76	}
    77	if errs := validatePipeline(p); len(errs) > 0 {
    78	for _, e := range errs {
    79	fmt.Fprintln(os.Stderr, e)
    80	}
    81	return 1
    82	}
    83	groups, err := topologicalGroups(p)
    84	if err != nil {
    85	fmt.Fprintln(os.Stderr, "error:", err)
    86	return 1
    87	}
    88	combos := parameterCombinations(p)
    89	out := struct {
    90	StagesOrder            [][]string                 `json:"stages_order"`
    91	TotalExperiments       int                        `json:"total_experiments"`
    92	ParameterCombinations  []map[string]interface{}   `json:"parameter_combinations"`
    93	}{
    94	StagesOrder:           groups,
    95	TotalExperiments:      len(combos),
    96	ParameterCombinations: combos,
    97	}
    98	enc := json.NewEncoder(os.Stdout)
    99	enc.SetIndent("", "  ")
   100	if err := enc.Encode(out); err != nil {
   101	fmt.Fprintln(os.Stderr, "error:", err)
   102	return 1
   103	}
   104	return 0
   105	}
