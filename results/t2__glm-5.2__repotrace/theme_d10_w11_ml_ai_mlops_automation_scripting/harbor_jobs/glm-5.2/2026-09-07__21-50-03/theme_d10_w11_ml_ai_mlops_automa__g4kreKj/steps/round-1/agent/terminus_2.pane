[?2004lpython3 - <<'PY'
import json, glob, os, subprocess, statistics

pipeline_file = 'pipelines/text_sentiment.yaml'
report = json.loads(subprocess.check_output(['./mlpipe', 'report', pipeline_file]))

# Parse simple YAML for metrics/objectives.
import re
metrics = {}
stage = None
with open(pipeline_file) as f:
    for line in f:
        m = re.match(r'\s*- name: (.+)', line)
        if m and not line.startswith(' ' * 6):
            stage = m.group(1)
        m2 = re.match(r'\s+- name: (.+)', line)
        m3 = re.match(r'\s+objective: (.+)', line)
        if m2:
            cur_metric = m2.group(1)
        if m3 and cur_metric:
            metrics[cur_metric] = m3.group(1)

obj = {k:v for k,v in metrics.items() if v in ('minimize','maximize')}
states = {}
for path in glob.glob('.mlpipe/state/*/train.json') + glob.glob('.mlpipe/state/*/evaluate.json') + glob.glob('.mlpipe/state/*/preprocess.json'):
    exp = os.path.basename(os.path.dirname(path))
    st = json.load(open(path))
    states.setdefault(exp, {})
    for m in st.get('metrics', []):
        states[exp][m['name']] = m['value']

exps = sorted(states)
minv = {m:min(states[e][m] for e in exps if m in states[e]) for m in obj}
maxv = {m:max(states[e][m] for e in exps if m in states[e]) for m in obj}
norm = {}
for e in exps:
    norm[e] = {}
    for m in obj:
        v = states[e][m]
        rng = maxv[m] - minv[m]
        n = 0.5 if rng == 0 else (v-minv[m])/rng if obj[m]=='maximize' else (maxv[m]-v)/rng
        norm[e][m] = round(n, 4)
comp = {e: round(sum(norm[e][m] for m in obj)/len(obj), 4) for e in exps}
imp = {m: round(statistics.stdev([norm[e][m] for e in exps]) if len(exps) > 1 else 0, 4) for m in obj}
sens = {}
for m in obj:
    if len(obj) == 1:
        sens[m] = {'best_without': exps[0], 'max_composite': 0}
    else:
        scores = {}
        for e in exps:
            vals = [norm[e][mm] for mm in obj if mm != m]
            scores[e] = round(sum(vals)/len(vals), 4)
        best = sorted(scores.items(), key=lambda kv: (-kv[1], kv[0]))[0]
        sens[m] = {'best_without': best[0], 'max_composite': best[1]}

for key, expected in [('composite_scores', comp), ('normalized_metrics', norm), ('metric_importance', imp), ('score_sensitivity', sens)]:
    assert report[key] == expected, (key, report[key], expected)
assert report['best_experiment'] == max(comp.items(), key=lambda kv: (kv[1], -ord(kv[0][3]) if False else 0))[0]
print('verification passed')
PY
?   	mlpipe	[no test files]
