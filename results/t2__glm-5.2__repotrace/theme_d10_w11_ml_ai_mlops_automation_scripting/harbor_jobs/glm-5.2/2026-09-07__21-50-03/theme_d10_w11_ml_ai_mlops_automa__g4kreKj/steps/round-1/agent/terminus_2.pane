    31	case "validate":
    32	os.Exit(cmdValidate(args))
    33	case "plan":
    34	os.Exit(cmdPlan(args))
    35	case "run":
    36	os.Exit(cmdRun(args))
    37	case "report":
    38	os.Exit(cmdReport(args))
    39	case "artifacts":
    40	os.Exit(cmdArtifacts(args))
    41	default:
    42	fmt.Fprintf(os.Stderr, "error: command %q is not implemented\n", cmd)
    43	os.Exit(1)
    44	}
    45	}
