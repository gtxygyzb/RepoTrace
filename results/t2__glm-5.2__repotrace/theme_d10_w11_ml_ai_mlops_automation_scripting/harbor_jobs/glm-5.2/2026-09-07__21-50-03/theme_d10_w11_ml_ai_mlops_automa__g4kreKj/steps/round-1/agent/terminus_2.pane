   453	func parseScalar(s string) interface{} {
   454		s = strings.TrimSpace(s)
   455		if s == "" {
   456			return ""
   457		}
   458		if strings.HasPrefix(s, "[") && strings.HasSuffix(s, "]") {
   459			return parseInlineList(s)
   460		}
   461		if strings.HasPrefix(s, "{") && strings.HasSuffix(s, "}") {
   462			return parseInlineMap(s)
   463		}
   464		if len(s) >= 2 && (s[0] == '"' && s[len(s)-1] == '"' || s[0] == '\'' && s[len(s)-1] == '\'') {
   465			return unquoteScalar(s)
   466		}
   467		if s == "true" {
   468			return true
   469		}
   470		if s == "false" {
   471			return false
   472		}
   473		if n, err := strconv.Atoi(s); err == nil {
   474			return n
   475		}
   476		if f, err := strconv.ParseFloat(s, 64); err == nil {
   477			return f
   478		}
   479		return s
   480	}
   481	
   482	func parseInlineList(s string) interface{} {
   483		inner := strings.TrimSpace(s[1 : len(s)-1])
