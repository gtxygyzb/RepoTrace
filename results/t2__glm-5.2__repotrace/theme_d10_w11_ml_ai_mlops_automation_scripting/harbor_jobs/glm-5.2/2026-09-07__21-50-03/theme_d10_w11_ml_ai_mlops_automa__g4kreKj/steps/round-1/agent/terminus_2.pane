   938	func reportPipeline(p *Pipeline) int {
   939		type reportExperiment struct {
   940			ID      string             `json:"id"`
   941			Metrics map[string]float64 `json:"metrics"`
   942			Stages  []StageState       `json:"stages"`
   943		}
   944		type reportOutput struct {
   945			Pipeline    string             `json:"pipeline"`
   946			Experiments []reportExperiment `json:"experiments"`
   947		}
   948	
   949		out := reportOutput{Pipeline: p.Name, Experiments: []reportExperiment{}}
   950		for _, combo := range parameterCombinations(p) {
   951			id := experimentID(combo)
   952			exp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}
   953			for _, stage := range p.Stages {
   954				if st, err := readStageState(id, stage.Name); err == nil {
   955					exp.Stages = append(exp.Stages, *st)
   956					for _, m := range st.Metrics {
   957						exp.Metrics[m.Name] = m.Value
   958					}
   959				}
   960			}
   961			out.Experiments = append(out.Experiments, exp)
   962		}
   963		enc := json.NewEncoder(os.Stdout)
   964		enc.SetIndent("", "  ")
   965		if err := enc.Encode(out); err != nil {
   966			fmt.Fprintln(os.Stderr, "error:", err)
   967			return 1
   968		}
   969		return 0
   970	}
   971	
   972	func runExperiment(p *Pipeline, combo map[string]interface{}, resume bool) error {
   973		id := experimentID(combo)
   974		stageMap := make(map[string]Stage)
   975		for _, stage := range p.Stages {
   976			stageMap[stage.Name] = stage
   977		}
   978		groups, err := topologicalGroups(p)
   979		if err != nil {
   980			return err
   981		}
   982		metrics := make(map[string]float64)
   983		for _, group := range groups {
   984			for _, name := range group {
   985				stage := stageMap[name]
   986				if resume {
   987					if st, err := readStageState(id, name); err == nil && (st.Status == "completed" || st.Status == "skipped") {
   988						for _, m := range st.Metrics {
   989							metrics[m.Name] = m.Value
   990						}
   991						continue
   992					}
   993				}
   994				if stage.Condition != nil {
   995					val, ok := metrics[stage.Condition.Metric]
   996					if !ok || !compareMetric(val, stage.Condition.Operator, stage.Condition.Threshold) {
   997						st := &StageState{
   998							Name:      name,
   999							Status:    "skipped",
  1000							ExitCode:  0,
  1001							StartTime: time.Now().Format(time.RFC3339),
  1002							EndTime:   time.Now().Format(time.RFC3339),
  1003						}
  1004						if err := writeStageState(id, name, st); err != nil {
  1005							return err
  1006						}
  1007						continue
  1008					}
  1009				}
  1010				st, err := runStage(id, stage, combo)
  1011				if err != nil {
  1012					return err
  1013				}
  1014				for _, m := range st.Metrics {
  1015					metrics[m.Name] = m.Value
  1016				}
  1017				_ = updateArtifactIndex(id, name, stage)
  1018			}
  1019		}
  1020		return nil
  1021	}
  1022	
  1023	func runStage(experimentID string, stage Stage, combo map[string]interface{}) (*StageState, error) {
  1024		maxAttempts := 1
  1025		backoff := 0.0
  1026		if stage.Retry != nil && stage.Retry.MaxAttempts > 0 {
  1027			maxAttempts = stage.Retry.MaxAttempts
  1028			backoff = stage.Retry.BackoffSeconds
  1029		}
  1030		var lastErr error
  1031		for attempt := 1; attempt <= maxAttempts; attempt++ {
  1032			cmd := exec.Command("sh", "-c", stage.Command)
  1033			cmd.Env = os.Environ()
  1034			for k, v := range stage.Env {
  1035				cmd.Env = append(cmd.Env, k+"="+substituteParams(v, combo))
  1036			}
  1037			var stdout bytes.Buffer
  1038			cmd.Stdout = &stdout
  1039			cmd.Stderr = os.Stderr
  1040			start := time.Now()
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '1040,1180p'
[?2004l  1040			start := time.Now()
  1041			runErr := cmd.Run()
  1042			if runErr == nil {
  1043				st := &StageState{
  1044					Name:      stage.Name,
  1045					Status:    "completed",
  1046					ExitCode:  0,
  1047					Metrics:   parseMetrics(stdout.String()),
  1048					StartTime: start.Format(time.RFC3339),
  1049					EndTime:   time.Now().Format(time.RFC3339),
  1050					Retries:   attempt - 1,
  1051				}
  1052				if err := writeStageState(experimentID, stage.Name, st); err != nil {
  1053					return nil, err
  1054				}
  1055				return st, nil
  1056			}
  1057			lastErr = runErr
  1058			if attempt < maxAttempts && backoff > 0 {
  1059				time.Sleep(time.Duration(backoff * float64(time.Second)))
  1060			}
  1061		}
  1062		st := &StageState{
  1063			Name:      stage.Name,
  1064			Status:    "failed",
  1065			ExitCode:  exitCodeFromError(lastErr),
  1066			StartTime: time.Now().Format(time.RFC3339),
  1067			EndTime:   time.Now().Format(time.RFC3339),
  1068			Retries:   maxAttempts - 1,
  1069		}
  1070		_ = writeStageState(experimentID, stage.Name, st)
  1071		return nil, fmt.Errorf("stage %s failed: %w", stage.Name, lastErr)
  1072	}
  1073	
  1074	func parseMetrics(output string) []MetricData {
  1075		var metrics []MetricData
  1076		scanner := bufio.NewScanner(strings.NewReader(output))
  1077		for scanner.Scan() {
  1078			line := strings.TrimSpace(scanner.Text())
  1079			if line == "" || !strings.HasPrefix(line, "{") {
  1080				continue
  1081			}
  1082			var m MetricData
  1083			if err := json.Unmarshal([]byte(line), &m); err == nil && m.Name != "" {
  1084				metrics = append(metrics, m)
  1085				continue
  1086			}
  1087			var mm map[string]interface{}
  1088			if err := json.Unmarshal([]byte(line), &mm); err == nil {
  1089				if name, ok := mm["metric"].(string); ok {
  1090					metrics = append(metrics, MetricData{Name: name, Value: asFloat(mm["value"])})
  1091				}
  1092			}
  1093		}
  1094		return metrics
  1095	}
  1096	
  1097	func compareMetric(val float64, op string, threshold float64) bool {
  1098		switch op {
  1099		case ">=":
  1100			return val >= threshold
  1101		case ">":
  1102			return val > threshold
  1103		case "<=":
  1104			return val <= threshold
  1105		case "<":
  1106			return val < threshold
  1107		case "==":
  1108			return val == threshold
  1109		case "!=":
  1110			return val != threshold
  1111		default:
  1112			return false
  1113		}
  1114	}
  1115	
  1116	func exitCodeFromError(err error) int {
  1117		if exiterr, ok := err.(*exec.ExitError); ok {
  1118			return exiterr.ExitCode()
  1119		}
  1120		return 1
  1121	}
  1122	
  1123	func updateArtifactIndex(experimentID, stageName string, stage Stage) error {
  1124		idx := loadArtifactIndex()
  1125		for _, out := range stage.Outputs {
  1126			info, err := os.Stat(out.Path)
  1127			if err != nil {
  1128				continue
  1129			}
  1130			f, err := os.Open(out.Path)
  1131			if err != nil {
  1132				continue
  1133			}
  1134			h := sha256.New()
  1135			if _, err := io.Copy(h, f); err != nil {
  1136				f.Close()
  1137				continue
  1138			}
  1139			f.Close()
  1140			idx.Entries = append(idx.Entries, ArtifactEntry{
  1141				ExperimentID: experimentID,
  1142				StageName:    stageName,
  1143				Path:         out.Path,
  1144				Hash:         hex.EncodeToString(h.Sum(nil)),
  1145				Size:         info.Size(),
  1146			})
  1147		}
  1148		return saveArtifactIndex(idx)
  1149	}
