[2187.915681, "o", "nl -ba main.go | sed -n '785,842p'\r\n\u001b[?2004l\r"]
[2187.91965, "o", "   785\tfunc parameterCombinations(p *Pipeline) []map[string]interface{} {\r\n   786\t    if len(p.Parameters) == 0 {\r\n   787\t        return []map[string]interface{}{{}}\r\n   788\t    }\r\n   789\t    combos := []map[string]interface{}{{}}\r\n   790\t"]
[2187.919758, "o", "    for _, param := range p.Parameters {\r\n   791\t        next := make([]map[string]interface{}, 0, len(combos)*len(param.Values))\r\n   792\t        for _, combo := range combos {\r\n   793\t            for _, value := range param.Values {\r\n   794\t                c := copyMap(combo)\r\n   795\t                c[param.Name] = value\r\n   796\t                next = append(next, c)\r\n   797\t            }\r\n   798\t        }\r\n   799\t        combos = next\r\n   800\t    }\r\n   801\t    return combos\r\n   802\t}\r\n   803\t\r\n   804\tfunc experimentID(combo map[string]interface{}) string {\r\n   805\t    if len(combo) == 0 {\r\n   806\t        return \"exp_default\"\r\n   807\t    }\r\n   808"]
[2187.919833, "o", "\t    keys := make([]string, 0, len(combo))\r\n   809\t    for k := range combo {\r\n   810\t        keys = append(keys, k)\r\n   811\t    }\r\n   812\t    sort.Strings(keys)\r\n   813\t    parts := make([]string, 0, len(keys))\r\n   814\t    for _, k := range keys {\r\n   815\t        parts = append(parts, k+\"=\"+asString(combo[k]))\r\n   816\t    }\r\n   817\t    return \"exp_\" + strings.Join(parts, \"_\")\r\n   818\t}\r\n"]
[2187.920003, "o", "   819\t\r\n   820\tfunc substituteParams(value string, combo map[string]interface{}) string {\r\n   821\t    for k, v := range combo {\r\n   822\t        value = strings.ReplaceAll(value, \"${\"+k+\"}\", asString(v))\r\n   823\t    }\r\n   824\t    return value\r\n   825\t}\r\n   826\t\r\n   827\tfunc copyMap(m map[string]interface{}) map[string]interface{} {\r\n   828\t    out := make(map[string]interface{}, len(m))\r\n   829\t    for k, v := range m {\r\n   830\t        out[k] = v\r\n   831\t    }\r\n   832\t    return out\r\n   833\t}\r\n   834\t\r\n   835\tfunc sortedKeys(m map[string]bool) []string {\r\n   836\t    keys := make([]string, 0, len(m))\r\n   837\t    for k := range m {\r\n   838\t        keys = append(keys, k)\r\n   839\t    }\r\n   840\t    sort.Strings(keys)\r\n   841\t"]
[2187.920073, "o", "    return keys\r\n   842\t}\r\n"]
