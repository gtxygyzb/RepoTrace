[2048.334514, "o", "\"io\"\r\n    10\t\"math\"\r\n    11\t\"os\"\r\n    12\t\"os/exec\"\r\n    13\t\"path/filepath\"\r\n    14\t\"sort\"\r\n    15\t\"strconv\"\r\n    16\t\"strings\"\r\n    17\t\"time\"\r\n    18\t)\r\n    19\t\r\n    20\tfunc main() {\r\n    21\tif len(os.Args) < 2 {\r\n    22\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe <command> [args...]\")\r\n    23\tfmt.Fprintln(os.Stderr, \"Commands: validate, plan, run, report, artifacts\")\r\n    24\tos.Exit(1)\r\n    25\t}\r\n    26\t\r\n    27\tcmd := os.Args[1]\r\n    28\targs := os.Args[2:]\r\n    29\t\r\n    30\tswitch cmd {\r\n    31\tcase \"validate\":\r\n    32\tos.Exit(cmdValidate(args))\r\n    33\tcase \"plan\":\r\n    34\tos.Exit(cmdPlan(args))\r\n    35\tcase \"run\":\r\n    36\tos.Exit(cmdRun(args))\r\n    37\tcase \"report\":\r\n    38\tos.Exit(cmdReport(args))\r\n    39\tcase \"artifacts\":\r\n"]
