[8154.018915, "o", "   187\t\r\n   188\tfunc parseRunArgs(args []string) (string, int, bool, error) {\r\n   189\t\tpipelineFile := \"\"\r\n   190\t\texperimentIndex := -1\r\n   191\t\tresume := false\r\n   192\t\tfor i := 0; i < len(args); i++ {\r\n   193\t\t\tswitch args[i] {\r\n   194\t\t\tcase \"--experiment\":\r\n   195\t\t\t\tif i+1 >= len(args) {\r\n   196\t\t\t\t\treturn \"\", 0, false, fmt.Errorf(\"--experiment requires an index\")\r\n   197\t\t\t\t}\r\n   198\t\t\t\tidx, err := strconv.Atoi(args[i+1])\r\n   199\t\t\t\tif err != nil {\r\n   200\t\t\t\t\treturn \"\", 0, false, fmt.Errorf(\"invalid experiment index: %v\", err)\r\n   201\t\t\t\t}\r\n   202\t\t\t\texperimentIndex = idx\r\n   203\t\t\t\ti++\r\n"]
