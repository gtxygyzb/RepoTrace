[8116.064888, "o", "\tEndTime   string       `json:\"end_time\"`\r\n\tRetries   int          `json:\"retries\"`\r\n}\r\n\r\ntype ArtifactEntry struct {\r\n\tExperimentID string `json:\"experiment_id\"`\r\n\tStageName    string `json:\"stage_name\"`\r\n\tPath         string `json:\"path\"`\r\n\tHash         string `json:\"hash\"`\r\n"]
[8116.06503, "o", "\tSize         int64  `json:\"size\"`\r\n}\r\n\r\ntype ArtifactIndex struct {\r\n\tEntries []ArtifactEntry `json:\"entries\"`\r\n}\r\n\r\ntype yamlLine struct {\r\n\tindent  int\r\n\tcontent string\r\n}\r\n\r\nfunc loadPipeline(path string) (*Pipeline, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tv, err := parseYAML(data)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn mapToPipeline(v)\r\n}\r\n\r\nfunc parseYAML(data []byte) (interface{}, error) {\r\n\tvar lines []yamlLine\r\n\tfor _, raw := range strings.Split(string(data), \"\\n\") {\r\n"]
[8116.0651, "o", "\t\traw = strings.TrimRight(raw, \"\\r\")\r\n\t\ttrimmed := strings.TrimSpace(raw)\r\n\t\tif trimmed == \"\" || strings.HasPrefix(trimmed, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tindent := 0\r\n\t\tfor indent < len(raw) && raw[indent] == ' ' {\r\n\t\t\tindent++\r\n\t\t}\r\n\t\tcontent := strings.TrimRight(raw[indent:], \" \")\r\n\t\tlines = append(lines, yamlLine{indent: indent, content: content})\r\n"]
[8116.065193, "o", "\t}\r\n\tif len(lines) == 0 {\r\n\t\treturn nil, nil\r\n\t}\r\n\tv, idx := parseBlock(lines, 0, 0)\r\n\tif idx < len(lines) {\r\n\t\treturn nil, fmt.Errorf(\"unexpected YAML structure at line: %q\", lines[idx].content)\r\n\t}\r\n\treturn v, nil\r\n}\r\n\r\nfunc parseBlock(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n\tif idx >= len(lines) || lines[idx].indent < indent {\r\n\t\treturn nil, idx\r\n"]
[8116.065257, "o", "\t}\r\n\tif strings.HasPrefix(lines[idx].content, \"- \") || lines[idx].content == \"-\" {\r\n\t\treturn parseSequence(lines, idx, indent)\r\n\t}\r\n\treturn parseMapping(lines, idx, indent)\r\n}\r\n\r\nfunc parseSequence(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n\tseq := []interface{}{}\r\n"]
[8116.06532, "o", "\tfor idx < len(lines) && lines[idx].indent == indent && (strings.HasPrefix(lines[idx].content, \"- \") || lines[idx].content == \"-\") {\r\n\t\tcontent := strings.TrimPrefix(lines[idx].content, \"-\")\r\n\t\tcontent = strings.TrimLeft(content, \" \")\r\n\t\tif content == \"\" {\r\n\t\t\tval, next := parseBlock(lines, idx+1, indent+2)\r\n\t\t\tseq = append(seq, val)\r\n\t\t\tidx = next\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif isMappingStart(content) {\r\n\t"]
[8116.06538, "o", "\t\tsublines := []yamlLine{{indent: indent + 2, content: content}}\r\n\t\t\tstart := idx + 1\r\n\t\t\tfor start < len(lines) && lines[start].indent > indent {\r\n\t\t\t\tsublines = append(sublines, lines[start])\r\n\t\t\t\tstart++\r\n\t\t\t}\r\n\t\t\tval, _ := parseBlock(sublines, 0, indent+2)\r\n\t\t\tseq = append(seq, val)\r\n\t\t\tidx = start\r\n"]
[8116.065442, "o", "\t\t} else {\r\n\t\t\tseq = append(seq, parseScalar(content))\r\n\t\t\tidx++\r\n\t\t}\r\n\t}\r\n\treturn seq, idx\r\n}\r\n\r\nfunc parseMapping(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n\tm := map[string]interface{}{}\r\n"]
[8116.065523, "o", "\tfor idx < len(lines) && lines[idx].indent == indent {\r\n\t\tcontent := lines[idx].content\r\n\t\tif strings.HasPrefix(content, \"- \") || content == \"-\" {\r\n\t\t\tbreak\r\n\t\t}\r\n\t\tkey, value, ok := splitKeyValue(content)\r\n\t\tif !ok {\r\n"]
[8116.065599, "o", "\t\t\treturn nil, idx\r\n\t\t}\r\n\t\tif value != \"\" {\r\n\t\t\tm[key] = parseScalar(value)\r\n\t\t\tidx++\r\n\t\t} else {\r\n\t\t\tval, next := parseBlock(lines, idx+1, indent+2)\r\n\t\t\tm[key] = val\r\n\t\t\tidx = next\r\n\t\t}\r\n\t}\r\n\treturn m, idx\r\n}\r\n\r\nfunc isMappingStart(s string) bool {\r\n\tif strings.HasPrefix(s, \"[\") || strings.HasPrefix(s, \"{\") {\r\n\t\treturn false\r\n\t}\r\n\t_, _, ok := splitKeyValue(s)\r\n\treturn ok\r\n}\r\n"]
[8116.065662, "o", "\r\nfunc splitKeyValue(s string) (string, string, bool) {\r\n\tinQuote := false\r\n\tquoteChar := byte(0)\r\n\tfor i := 0; i < len(s); i++ {\r\n\t\tc := s[i]\r\n\t\tif inQuote {\r\n\t\t\tif c == quoteChar {\r\n\t\t\t\tinQuote = false\r\n\t\t\t}\r\n"]
[8116.065718, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tif c == '\"' || c == '\\'' {\r\n\t\t\tinQuote = true\r\n\t\t\tquoteChar = c\r\n\t\t\tcontinue\r\n"]
[8116.065781, "o", "\t\t}\r\n\t\tif c == ':' {\r\n\t\t\tif i+1 >= len(s) || s[i+1] == ' ' {\r\n\t\t\t\tkey := strings.TrimSpace(s[:i])\r\n\t\t\t\tvalue := strings.TrimSpace(s[i+1:])\r\n\t\t\t\tkey = unquoteScalar(key)\r\n\t\t\t\treturn key, value, true\r\n\t\t\t}\r\n\t\t}\r\n\t"]
[8116.065842, "o", "}\r\n\treturn \"\", \"\", false\r\n}\r\n\r\nfunc parseScalar(s string) interface{} {\r\n\ts = strings.TrimSpace(s)\r\n\tif s == \"\" {\r\n\t\treturn \"\"\r\n\t}\r\n\tif strings.HasPrefix(s, \"[\") && strings.HasSuffix(s, \"]\") {\r\n\t\treturn parseInlineList(s)\r\n\t}\r\n"]
[8116.065904, "o", "\tif strings.HasPrefix(s, \"{\") && strings.HasSuffix(s, \"}\") {\r\n\t\treturn parseInlineMap(s)\r\n\t}\r\n\tif len(s) >= 2 && (s[0] == '\"' && s[len(s)-1] == '\"' || s[0] == '\\'' && s[len(s)-1] == '\\'') {\r\n\t\treturn unquoteScalar(s)\r\n\t}\r\n\tif s == \"true\" {\r\n\t\treturn true\r\n\t}\r\n\tif s == \"false\" {\r\n\t\treturn false\r\n\t}\r\n"]
[8116.065985, "o", "\tif n, err := strconv.Atoi(s); err == nil {\r\n\t\treturn n\r\n\t}\r\n\tif f, err := strconv.ParseFloat(s, 64); err == nil {\r\n\t\treturn f\r\n\t}\r\n"]
[8116.066048, "o", "\treturn s\r\n}\r\n\r\nfunc parseInlineList(s string) interface{} {\r\n\tinner := strings.TrimSpace(s[1 : len(s)-1])\r\n\tif inner == \"\" {\r\n\t\treturn []interface{}{}\r\n\t}\r\n\tparts := splitCommas(inner)\r\n\tout := make([]interface{}, 0, len(parts))\r\n\tfor _, p := range parts {\r\n\t\tout = append(out, parseScalar(strings.TrimSpace(p)))\r\n\t}\r\n\treturn out\r\n}\r\n"]
[8116.066108, "o", "\r\nfunc parseInlineMap(s string) interface{} {\r\n\tinner := strings.TrimSpace(s[1 : len(s)-1])\r\n\tif inner == \"\" {\r\n\t\treturn map[string]interface{}{}\r\n\t}\r\n\tparts := splitCommas(inner)\r\n\tm := map[string]interface{}{}\r\n\tfor _, p := range parts {\r\n\t\tkey, value, ok := splitKeyValue(strings.TrimSpace(p))\r\n"]
[8116.066168, "o", "\t\tif ok {\r\n\t\t\tm[key] = parseScalar(value)\r\n\t\t}\r\n\t}\r\n\treturn m\r\n}\r\n\r\nfunc splitCommas(s string) []string {\r\n\tvar parts []string\r\n\tinQuote := false\r\n"]
[8116.066226, "o", "\tquoteChar := byte(0)\r\n\tdepth := 0\r\n\tstart := 0\r\n\tfor i := 0; i < len(s); i++ {\r\n\t\tc := s[i]\r\n\t\tif inQuote {\r\n\t\t\tif c == quoteChar {\r\n\t\t\t\tinQuote = false\r\n"]
[8116.066283, "o", "\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif c == '\"' || c == '\\'' {\r\n\t\t\tinQuote = true\r\n\t\t\tquoteChar = c\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif c == '[' || c == '{' {\r\n\t\t\tdepth++\r\n\t\t\tcontinue\r\n"]
[8116.066346, "o", "\t\t}\r\n\t\tif c == ']' || c == '}' {\r\n\t\t\tdepth--\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif c == ',' && depth == 0 {\r\n\t\t\tparts = append(parts, s[start:i])\r\n\t\t\tstart = i + 1\r\n\t\t}\r\n"]
[8116.066404, "o", "\t}\r\n\tparts = append(parts, s[start:])\r\n\treturn parts\r\n}\r\n\r\nfunc unquoteScalar(s string) string {\r\n\ts = strings.TrimSpace(s)\r\n\tif len(s) >= 2 && s[0] == '\"' && s[len(s)-1] == '\"' {\r\n\t\tunq, err := strconv.Unquote(s)\r\n\t\tif err == nil {\r\n"]
[8116.066462, "o", "\t\t\treturn unq\r\n\t\t}\r\n\t\treturn s[1 : len(s)-1]\r\n\t}\r\n\tif len(s) >= 2 && s[0] == '\\'' && s[len(s)-1] == '\\'' {\r\n\t\treturn strings.ReplaceAll(s[1:len(s)-1], \"''\", \"'\")\r\n\t}\r\n\treturn s\r\n"]
[8116.06652, "o", "}\r\n\r\nfunc mapToPipeline(v interface{}) (*Pipeline, error) {\r\n\tp := &Pipeline{}\r\n\troot := asMap(v)\r\n\tif root == nil {\r\n\t\treturn p, nil\r\n\t}\r\n\tp.Name = asString(root[\"name\"])\r\n\tp.Version = asString(root[\"version\"])\r\n\tif params, ok := root[\"parameters\"].(map[string]interface{}); ok {\r\n\t"]
[8116.066581, "o", "\tkeys := make([]string, 0, len(params))\r\n\t\tfor k := range params {\r\n\t\t\tkeys = append(keys, k)\r\n\t\t}\r\n\t\tsort.Strings(keys)\r\n\t\tfor _, k := range keys {\r\n\t\t\tpm := asMap(params[k])\r\n\t\t\tp.Parameters = append(p.Parameters, Parameter{Name: k, Values: asSlice(pm[\"values\"])})\r\n\t\t}\r\n"]
[8116.066637, "o", "\t}\r\n\tfor _, sv := range asSlice(root[\"stages\"]) {\r\n\t\tsm := asMap(sv)\r\n\t\tstage := Stage{\r\n\t\t\tName:    asString(sm[\"name\"]),\r\n\t\t\tCommand: asString(sm[\"command\"]),\r\n\t\t}\r\n\t\tstage.DependsOn = toStringSlice(asSlice(sm[\"depends_on\"]))\r\n\t\t"]
[8116.066698, "o", "stage.Env = toStringMap(asMap(sm[\"env\"]))\r\n\t\tfor _, mv := range asSlice(sm[\"metrics\"]) {\r\n\t\t\tmm := asMap(mv)\r\n\t\t\tstage.Metrics = append(stage.Metrics, Metric{Name: asString(mm[\"name\"]), Objective: asString(mm[\"objective\"])})\r\n\t\t}\r\n\t\tif rv := asMap(sm[\"retry\"]); rv != nil {\r\n\t\t\tstage.Retry = &Retry{MaxAttempts: asInt(rv[\"max_attempts\"]), BackoffSeconds: asFloat(rv[\"backoff_seconds\"])}\r\n\t\t}\r\n\t\tif cv := asMap(sm[\"condition\"]); cv != nil {\r\n\t\t\tstage.Condition = &Condition{Metric: asString(cv[\"metric\"]), Operator: asString(cv[\"operator\"]), Threshold: asFloat(cv[\"threshold\"])}\r\n"]
[8116.066767, "o", "\t\t}\r\n\t\tfor _, ov := range asSlice(sm[\"outputs\"]) {\r\n\t\t\tom := asMap(ov)\r\n\t\t\tstage.Outputs = append(stage.Outputs, ArtifactRef{Path: asString(om[\"path\"]), Type: asString(om[\"type\"])})\r\n\t\t}\r\n"]
[8116.066829, "o", "\t\tfor _, iv := range asSlice(sm[\"inputs\"]) {\r\n\t\t\tim := asMap(iv)\r\n\t\t\tstage.Inputs = append(stage.Inputs, ArtifactRef{Path: asString(im[\"path\"]), Type: asString(im[\"type\"])})\r\n\t\t}\r\n\t\tp.Stages = append(p.Stages, stage)\r\n\t}\r\n\treturn p, nil\r\n}\r\n\r\nfunc asMap(v interface{}) map[string]interface{} {\r\n\tif m, ok := v.(map[string]interface{}); ok {\r\n\t\treturn m\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc asSlice(v interface{}) []interface{} {\r\n\tif s, ok := v.([]interface{}); ok {\r\n"]
[8116.066887, "o", "\t\treturn s\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc asString(v interface{}) string {\r\n\tif v == nil {\r\n\t\treturn \"\"\r\n\t}\r\n\tswitch x := v.(type) {\r\n\tcase string:\r\n\t\treturn x\r\n"]
[8116.066965, "o", "\tcase int:\r\n\t\treturn strconv.Itoa(x)\r\n\tcase float64:\r\n\t\treturn formatFloat(x)\r\n\tcase bool:\r\n\t\treturn strconv.FormatBool(x)\r\n\tdefault:\r\n\t\treturn fmt.Sprint(x)\r\n\t}\r\n}\r\n\r\nfunc asInt(v interface{}) int {\r\n"]
[8116.067037, "o", "\tswitch x := v.(type) {\r\n\tcase int:\r\n\t\treturn x\r\n\tcase float64:\r\n\t\treturn int(x)\r\n\tcase string:\r\n\t\tn, _ := strconv.Atoi(x)\r\n\t\treturn n\r\n\tdefault:\r\n\t\treturn 0\r\n\t}\r\n"]
[8116.067094, "o", "}\r\n\r\nfunc asFloat(v interface{}) float64 {\r\n\tswitch x := v.(type) {\r\n\tcase float64:\r\n\t\treturn x\r\n\tcase int:\r\n\t\treturn float64(x)\r\n\tcase string:\r\n\t\tf, _ := strconv.ParseFloat(x, 64)\r\n\t\treturn f\r\n\tdefault:\r\n\t\treturn 0\r\n"]
[8116.06715, "o", "\t}\r\n}\r\n\r\nfunc toStringSlice(v []interface{}) []string {\r\n\tout := make([]string, 0, len(v))\r\n\tfor _, item := range v {\r\n\t\tout = append(out, asString(item))\r\n\t}\r\n"]
[8116.067207, "o", "\treturn out\r\n}\r\n\r\nfunc toStringMap(m map[string]interface{}) map[string]string {\r\n\tout := make(map[string]string)\r\n\tfor k, v := range m {\r\n\t\tout[k] = asString(v)\r\n\t}\r\n\treturn out\r\n}\r\n\r\n"]
[8116.067269, "o", "func formatFloat(f float64) string {\r\n\treturn strconv.FormatFloat(f, 'g', -1, 64)\r\n}\r\n\r\nfunc validatePipeline(p *Pipeline) []string {\r\n\tvar errs []string\r\n\tnames := make(map[string]int)\r\n\tstageSet := make(map[string]bool)\r\n\tstageMap := make(map[string]Stage)\r\n\r\n"]
[8116.068133, "o", "\u001b[?2004h"]
