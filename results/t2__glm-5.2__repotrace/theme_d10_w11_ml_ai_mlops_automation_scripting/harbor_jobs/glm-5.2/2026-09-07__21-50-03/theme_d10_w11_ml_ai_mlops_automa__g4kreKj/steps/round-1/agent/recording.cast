[3314.143859, "o", "\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n    78\t\t\treturn 1\r\n    79\t\t}\r\n    80\t\tif errs := validatePipeline(p); len(errs) > 0 {\r\n    81\t\t\tfor _, e := range errs {\r\n    82\t\t\t\tfmt.Fprintln(os.Stderr, e)\r\n    83\t\t\t}\r\n    84\t\t\treturn 1\r\n    85\t"]
[3314.143915, "o", "\t}\r\n    86\t\tgroups, err := topologicalGroups(p)\r\n    87\t\tif err != nil {\r\n    88\t\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n    89\t\t\treturn 1\r\n    90\t\t}\r\n    91\t\tcombos := parameterCombinations(p)\r\n    92\t\t"]
[3314.143987, "o", "out := struct {\r\n    93\t\t\tStagesOrder           [][]string               `json:\"stages_order\"`\r\n    94\t\t\tTotalExperiments      int                      `json:\"total_experiments\"`\r\n    95\t\t\tParameterCombinations []map[string]interface{} `json:\"parameter_combinations\"`\r\n    96\t\t}{\r\n    97\t\t\tStagesOrder:           groups,\r\n    98\t\t\tTotalExperiments:      len(combos),\r\n"]
[3314.144044, "o", "    99\t\t\tParameterCombinations: combos,\r\n   100\t\t}\r\n   101\t\tenc := json.NewEncoder(os.Stdout)\r\n   102\t\tenc.SetIndent(\"\", \"  \")\r\n   103\t\tif err := enc.Encode(out); err != nil {\r\n   104\t\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n   105\t\t\treturn 1\r\n"]
