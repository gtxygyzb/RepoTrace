[1600.793599, "o", "        }\r\n\u001b[?2004l\r"]
[1600.793654, "o", "\u001b[?2004h> "]
[1600.793866, "o", "        state := make(map[string]int)\r\n\u001b[?2004l\r"]
[1600.793921, "o", "\u001b[?2004h> "]
[1600.794136, "o", "        var check func(name string)\r\n\u001b[?2004l\r"]
[1600.794201, "o", "\u001b[?2004h> "]
[1600.794369, "o", "        check = func(name string) {\r\n\u001b[?2004l\r"]
[1600.794436, "o", "\u001b[?2004h> "]
[1600.794558, "o", "            state[name] = 1\r\n\u001b[?2004l\r"]
[1600.794624, "o", "\u001b[?2004h> "]
[1600.794898, "o", "            for _, dep := range stageMap[name].DependsOn {\r\n\u001b[?2004l\r"]
[1600.794989, "o", "\u001b[?2004h> "]
[1600.795133, "o", "                if !stageSet[dep] {\r\n\u001b[?2004l\r"]
[1600.795198, "o", "\u001b[?2004h> "]
[1600.795332, "o", "                    continue\r\n\u001b[?2004l\r"]
[1600.795396, "o", "\u001b[?2004h> "]
[1600.795473, "o", "                }\r\n\u001b[?2004l\r"]
[1600.795538, "o", "\u001b[?2004h> "]
[1600.795706, "o", "                if state[dep] == 1 {\r\n\u001b[?2004l\r"]
[1600.795766, "o", "\u001b[?2004h"]
[1600.79582, "o", "> "]
[1600.796309, "o", "                    errs = append(errs, fmt.Sprintf(\"circular dependency detected involving stage: %s\", name))\r\n\u001b[?2004l\r"]
[1600.796376, "o", "\u001b[?2004h> "]
[1600.796579, "o", "                } else if state[dep] == 0 {\r\n\u001b[?2004l\r"]
[1600.796647, "o", "\u001b[?2004h> "]
[1600.796782, "o", "                    check(dep)\r\n\u001b[?2004l\r"]
[1600.796845, "o", "\u001b[?2004h> "]
[1600.796922, "o", "                }\r\n\u001b[?2004l\r"]
[1600.797, "o", "\u001b[?2004h> "]
[1600.797073, "o", "            }\r\n\u001b[?2004l\r"]
[1600.797134, "o", "\u001b[?2004h> "]
[1600.797243, "o", "            state[name] = 2\r\n\u001b[?2004l\r"]
[1600.797308, "o", "\u001b[?2004h> "]
[1600.797401, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1600.797523, "o", "        check(stage.Name)\r\n\u001b[?2004l\r"]
[1600.797607, "o", "\u001b[?2004h> "]
[1600.797685, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1600.79775, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1600.797839, "o", "    return errs\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1600.797918, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1600.797971, "o", "\u001b[?2004h> "]
[1600.798243, "o", "func topologicalGroups(p *Pipeline) ([][]string, error) {\r\n\u001b[?2004l\r"]
[1600.79834, "o", "\u001b[?2004h> "]
[1600.798482, "o", "    stageMap := make(map[string]Stage)\r\n\u001b[?2004l\r"]
[1600.798586, "o", "\u001b[?2004h"]
[1600.798651, "o", "> "]
[1600.798724, "o", "    for _, stage := range p.Stages {\r\n\u001b[?2004l\r"]
[1600.798802, "o", "\u001b[?2004h> "]
[1600.79896, "o", "        stageMap[stage.Name] = stage\r\n\u001b[?2004l\r"]
[1600.799029, "o", "\u001b[?2004h> "]
[1600.799091, "o", "    }\r\n\u001b[?2004l\r"]
[1600.799116, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1600.799139, "o", "\u001b[?2004h"]
[1600.799162, "o", "> "]
[1600.799363, "o", "    completed := make(map[string]bool)\r\n\u001b[?2004l\r"]
[1600.799426, "o", "\u001b[?2004h> "]
[1600.799601, "o", "    remaining := make(map[string]bool)\r\n\u001b[?2004l\r"]
[1600.799702, "o", "\u001b[?2004h> "]
[1600.799833, "o", "    for _, stage := range p.Stages {\r\n\u001b[?2004l\r"]
[1600.799908, "o", "\u001b[?2004h> "]
[1600.800073, "o", "        remaining[stage.Name] = true\r\n\u001b[?2004l\r"]
[1600.80014, "o", "\u001b[?2004h> "]
[1600.800205, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1600.800285, "o", "\u001b[?2004h> "]
[1600.800384, "o", "    var groups [][]string\r\n\u001b[?2004l\r"]
[1600.800441, "o", "\u001b[?2004h> "]
[1600.800576, "o", "    for len(remaining) > 0 {\r\n\u001b[?2004l\r"]
[1600.800663, "o", "\u001b[?2004h> "]
[1600.800762, "o", "        var ready []string\r\n\u001b[?2004l\r"]
[1600.800842, "o", "\u001b[?2004h> "]
[1600.801009, "o", "        for name := range remaining {\r\n\u001b[?2004l\r"]
[1600.801099, "o", "\u001b[?2004h> "]
[1600.801177, "o", "            ok := true\r\n\u001b[?2004l\r"]
[1600.801244, "o", "\u001b[?2004h> "]
[1600.801514, "o", "            for _, dep := range stageMap[name].DependsOn {\r\n\u001b[?2004l\r"]
[1600.801594, "o", "\u001b[?2004h> "]
[1600.801745, "o", "                if !completed[dep] {\r\n\u001b[?2004l\r"]
[1600.801809, "o", "\u001b[?2004h"]
[1600.801875, "o", "> "]
[1600.801976, "o", "                    ok = false\r\n\u001b[?2004l\r\u001b[?2004h"]
[1600.802, "o", "> "]
[1600.802136, "o", "                    break\r\n\u001b[?2004l\r"]
[1600.802212, "o", "\u001b[?2004h> "]
[1600.802276, "o", "                }\r\n\u001b[?2004l\r"]
[1600.802342, "o", "\u001b[?2004h> "]
[1600.802396, "o", "            }\r\n\u001b[?2004l\r"]
[1600.802459, "o", "\u001b[?2004h> "]
[1600.802548, "o", "            if ok {\r\n\u001b[?2004l\r"]
[1600.802622, "o", "\u001b[?2004h> "]
[1600.802815, "o", "                ready = append(ready, name)\r\n\u001b[?2004l\r"]
[1600.80288, "o", "\u001b[?2004h> "]
[1600.802982, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1600.803066, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1600.803128, "o", "> "]
[1600.803231, "o", "        sort.Strings(ready)\r\n\u001b[?2004l\r"]
[1600.803296, "o", "\u001b[?2004h> "]
[1600.803425, "o", "        if len(ready) == 0 {\r\n\u001b[?2004l\r"]
[1600.803486, "o", "\u001b[?2004h"]
[1600.803541, "o", "> "]
[1600.804008, "o", "            return nil, fmt.Errorf(\"circular dependency detected among stages: %v\", sortedKeys(remaining))\r\n\u001b[?2004l\r"]
[1600.804079, "o", "\u001b[?2004h> "]
[1600.804138, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1600.804192, "o", "> "]
[1600.804351, "o", "        groups = append(groups, ready)\r\n\u001b[?2004l\r"]
[1600.804418, "o", "\u001b[?2004h> "]
[1600.804512, "o", "        for _, name := range ready {\r\n\u001b[?2004l\r"]
[1600.804575, "o", "\u001b[?2004h> "]
[1600.804657, "o", "            completed[name] = true\r\n\u001b[?2004l\r"]
[1600.804719, "o", "\u001b[?2004h> "]
[1600.819334, "o", "            delete(remaining, name)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return groups, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func parameterCombinations(p *Pipeline) []map[string]interface{} {\r\n\u001b[?2004l\r\u001b[?2004h>     if len(p.Parameters) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         return []map[string]interface{}{{}}\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     combos := []map[string]interface{}{{}}\r\n\u001b[?2004l\r\u001b[?2004h>     for _, param := range p.Parameters {\r\n\u001b[?2004l\r\u001b[?2004h>         next := make([]map[string]interface{}, 0, len(combos)*len(param.Values))\r\n\u001b[?2004l\r\u001b[?2004h>         for _, combo := range combos {\r\n\u001b[?2004l\r\u001b[?2004h>             for _, value := range param.Values {\r\n\u001b[?2004l\r\u001b[?2004h>                 c := copyMap(combo)\r\n\u001b[?2004l\r\u001b[?2004h>                 c[param.Name] = value\r\n\u001b[?2004l\r\u001b[?2004h>                 next = append(next, c)\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>        "]
[1600.819464, "o", " combos = next\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return combos\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func experimentID(combo map[string]interface{}) string {\r\n\u001b[?2004l\r\u001b[?2004h>     if len(combo) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         return \"exp_default\"\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     keys := make([]string, 0, len(combo))\r\n\u001b[?2004l\r\u001b[?2004h>     for k := range combo {\r\n\u001b[?2004l\r\u001b[?2004h>         keys = append(keys, k)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     sort.Strings(keys)\r\n\u001b[?2004l\r\u001b[?2004h>     parts := make([]string, 0, len(keys))\r\n\u001b[?2004l\r\u001b[?2004h>     for _, k := range keys {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1600.819684, "o", "        parts = append(parts, k+\"=\"+asString(combo[k]))\r\n\u001b[?2004l\r"]
[1600.819772, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1600.819962, "o", "    return \"exp_\" + strings.Join(parts, \"_\")\r\n\u001b[?2004l\r"]
[1600.820046, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1600.820113, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1600.820359, "o", "func substituteParams(value string, combo map[string]interface{}) string {\r\n\u001b[?2004l\r"]
[1600.820424, "o", "\u001b[?2004h> "]
[1600.820512, "o", "    for k, v := range combo {\r\n\u001b[?2004l\r"]
[1600.820577, "o", "\u001b[?2004h> "]
[1600.820814, "o", "        value = strings.ReplaceAll(value, \"${\"+k+\"}\", asString(v))\r\n\u001b[?2004l\r"]
[1600.820898, "o", "\u001b[?2004h> "]
[1600.820988, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     return value\r\n\u001b[?2004l\r"]
[1600.821078, "o", "\u001b[?2004h> }\r\n"]
[1600.821144, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1600.821355, "o", "func copyMap(m map[string]interface{}) map[string]interface{} {\r\n\u001b[?2004l\r"]
[1600.821414, "o", "\u001b[?2004h> "]
[1600.821573, "o", "    out := make(map[string]interface{}, len(m))\r\n\u001b[?2004l\r"]
[1600.82163, "o", "\u001b[?2004h> "]
[1600.821708, "o", "    for k, v := range m {\r\n\u001b[?2004l\r"]
[1600.821766, "o", "\u001b[?2004h> "]
[1600.82182, "o", "        out[k] = v\r\n\u001b[?2004l\r"]
[1600.821874, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1600.821941, "o", "\u001b[?2004h> "]
[1600.822003, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1600.822059, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1600.822113, "o", "\u001b[?2004h> "]
[1600.822281, "o", "func sortedKeys(m map[string]bool) []string {\r\n\u001b[?2004l\r"]
[1600.822336, "o", "\u001b[?2004h> "]
[1600.822463, "o", "    keys := make([]string, 0, len(m))\r\n\u001b[?2004l\r"]
[1600.822519, "o", "\u001b[?2004h> "]
[1600.82259, "o", "    for k := range m {\r\n\u001b[?2004l\r"]
[1600.822645, "o", "\u001b[?2004h> "]
[1600.822747, "o", "        keys = append(keys, k)\r\n\u001b[?2004l\r"]
[1600.822803, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1600.822858, "o", "\u001b[?2004h> "]
[1600.822942, "o", "    sort.Strings(keys)\r\n\u001b[?2004l\r"]
[1600.822997, "o", "\u001b[?2004h> "]
[1600.823061, "o", "    return keys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1600.823115, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1600.82317, "o", "EOF\r\n\u001b[?2004l\r"]
[1600.825857, "o", "\u001b[?2004hroot@n30009:/app# "]
