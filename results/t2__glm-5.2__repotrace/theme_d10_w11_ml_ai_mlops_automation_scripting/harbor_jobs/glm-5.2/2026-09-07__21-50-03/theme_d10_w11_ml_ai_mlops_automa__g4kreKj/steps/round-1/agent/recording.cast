[1924.585886, "o", "    if strings.HasPrefix(s, \"[\") && strings.HasSuffix(s, \"]\") {\r\n        return parseInlineList(s)\r\n    }\r\n    if strings.HasPrefix(s, \"{\") && strings.HasSuffix(s, \"}\") {\r\n        return parseInlineMap(s)\r\n    }\r\n    if len(s) >= 2 && (s[0] == '\"' && s[len(s)-1] == '\"' || s[0] == '\\'' && s[len(s)-1] == '\\'') {\r\n        return unquoteScalar(s)\r\n    }\r\n    if s == \"true\" {\r\n        return true\r\n    }\r\n    if s == \"false\" {\r\n        return false\r\n    }\r\n    if n, err := strconv.Atoi(s); err == nil {\r\n        return n\r\n    }\r\n    if f, err := strconv.ParseFloat(s, 64); err == nil {\r\n        return f\r\n    }\r\n    return s\r\n}\r\n\r\nfunc parseInlineList(s string) interface{} {\r\n    inner := strings.TrimSpace(s[1 : len(s)-1])\r\n    if inner == \"\" {\r\n        return []interface{}{}\r\n    }\r\n    parts := splitCommas(inner)\r\n    out := make([]interface{}, 0, len(parts))\r\n    for _, p := range parts {\r\n        out = append(out, parseScalar(strings.TrimSpace(p)))\r\n    }\r\n    return out\r\n}\r\n\r\nfunc parseInlineMap(s string) interfa"]
[1924.586021, "o", "ce{} {\r\n    inner := strings.TrimSpace(s[1 : len(s)-1])\r\n    if inner == \"\" {\r\n        return map[string]interface{}{}\r\n    }\r\n    parts := splitCommas(inner)\r\n    m := map[string]interface{}{}\r\n    for _, p := range parts {\r\n        key, value, ok := splitKeyValue(strings.TrimSpace(p))\r\n        if ok {\r\n            m[key] = parseScalar(value)\r\n        }\r\n    }\r\n    return m\r\n}\r\n\r\nfunc splitCommas(s string) []string {\r\n    var parts []string\r\n    inQuote := false\r\n    quoteChar := byte(0)\r\n    depth := 0\r\n    start := 0\r\n    for i := 0; i < len(s); i++ {\r\n        c := s[i]\r\n        if inQuote {\r\n            if c == quoteChar {\r\n                inQuote = false\r\n            }\r\n            continue\r\n        }\r\n        if c == '\"' || c == '\\'' {\r\n            inQuote = true\r\n            quoteChar = c\r\n            continue\r\n        }\r\n        if c == '[' || c == '{' {\r\n            depth++\r\n            continue\r\n        }\r\n        if c == ']' || c == '}' {\r\n            depth--\r\n            continue\r\n        }\r\n     "]
[1924.58609, "o", "   if c == ',' && depth == 0 {\r\n            parts = append(parts, s[start:i])\r\n            start = i + 1\r\n        }\r\n    }\r\n    parts = append(parts, s[start:])\r\n    return parts\r\n}\r\n\r\nfunc unquoteScalar(s string) string {\r\n    s = strings.TrimSpace(s)\r\n    if len(s) >= 2 && s[0] == '\"' && s[len(s)-1] == '\"' {\r\n        unq, err := strconv.Unquote(s)\r\n        if err == nil {\r\n            return unq\r\n        }\r\n        return s[1 : len(s)-1]\r\n    }\r\n    if len(s) >= 2 && s[0] == '\\'' && s[len(s)-1] == '\\'' {\r\n        return strings.ReplaceAll(s[1:len(s)-1], \"''\", \"'\")\r\n    }\r\n    return s\r\n}\r\n"]
[1924.586158, "o", "\r\nfunc mapToPipeline(v interface{}) (*Pipeline, error) {\r\n    p := &Pipeline{}\r\n    root := asMap(v)\r\n    if root == nil {\r\n        return p, nil\r\n    }\r\n    p.Name = asString(root[\"name\"])\r\n    p.Version = asString(root[\"version\"])\r\n    if params, ok := root[\"parameters\"].(map[string]interface{}); ok {\r\n        keys := make([]string, 0, len(params))\r\n        for k := range params {\r\n            keys = append(keys, k)\r\n        }\r\n"]
[1924.586223, "o", "        sort.Strings(keys)\r\n        for _, k := range keys {\r\n            pm := asMap(params[k])\r\n            p.Parameters = append(p.Parameters, Parameter{Name: k, Values: asSlice(pm[\"values\"])})\r\n        }\r\n    }\r\n    for _, sv := range asSlice(root[\"stages\"]) {\r\n        sm := asMap(sv)\r\n        stage := Stage{\r\n            Name:    asString(sm[\"name\"]),\r\n            Command: asString(sm[\"command\"]),\r\n        }\r\n        stage.DependsOn = toStringSlice(asSlice(sm[\"depends_on\"]))\r\n        stage.Env = toStringMap(asMap(sm[\"env\"]))\r\n        for _, mv := range asSlice(sm[\"metrics\"]) {\r\n"]
[1924.586287, "o", "            mm := asMap(mv)\r\n            stage.Metrics = append(stage.Metrics, Metric{Name: asString(mm[\"name\"]), Objective: asString(mm[\"objective\"])})\r\n        }\r\n        if rv := asMap(sm[\"retry\"]); rv != nil {\r\n            stage.Retry = &Retry{MaxAttempts: asInt(rv[\"max_attempts\"]), BackoffSeconds: asFloat(rv[\"backoff_seconds\"])}\r\n        }\r\n        if cv := asMap(sm[\"condition\"]); cv != nil {\r\n            stage.Condition = &Condition{Metric: asString(cv[\"metric\"]), Operator: asString(cv[\"operator\"]), Threshold: asFloat(cv[\"threshold\"])}\r\n        }\r\n        for _, ov := range asSlice(sm[\"outputs\"]) {\r\n            om := asMap(ov)\r\n            stage.Outputs = append(stage.Outputs, ArtifactRef{Path: asString(om[\"path\"]), Type: asString(om[\"type\"])})\r\n        }\r\n"]
[1924.586346, "o", "        for _, iv := range asSlice(sm[\"inputs\"]) {\r\n            im := asMap(iv)\r\n            stage.Inputs = append(stage.Inputs, ArtifactRef{Path: asString(im[\"path\"]), Type: asString(im[\"type\"])})\r\n        }\r\n        p.Stages = append(p.Stages, stage)\r\n    }\r\n    return p, nil\r\n}\r\n\r\nfunc asMap(v interface{}) map[string]interface{} {\r\n    if m, ok := v.(map[string]interface{}); ok {\r\n"]
[1924.586406, "o", "        return m\r\n    }\r\n    return nil\r\n}\r\n\r\nfunc asSlice(v interface{}) []interface{} {\r\n    if s, ok := v.([]interface{}); ok {\r\n        return s\r\n    }\r\n    return nil\r\n}\r\n\r\nfunc asString(v interface{}) string {\r\n    if v == nil {\r\n"]
[1924.586512, "o", "        return \"\"\r\n    }\r\n    switch x := v.(type) {\r\n    case string:\r\n        return x\r\n    case int:\r\n        return strconv.Itoa(x)\r\n    case float64:\r\n        return formatFloat(x)\r\n    case bool:\r\n        return strconv.FormatBool(x)\r\n    default:\r\n        return fmt.Sprint(x)\r\n    }\r\n}\r\n\r\nfunc asInt(v interface{}) int {\r\n    switch x := v.(type) {\r\n    case int:\r\n        return x\r\n    case float64:\r\n        return int(x)\r\n    case string:\r\n        n, _ := strconv.Atoi(x)\r\n"]
[1924.586578, "o", "        return n\r\n    default:\r\n        return 0\r\n    }\r\n}\r\n\r\nfunc asFloat(v interface{}) float64 {\r\n    switch x := v.(type) {\r\n    case float64:\r\n        return x\r\n    case int:\r\n        return float64(x)\r\n    case string:\r\n        f, _ := strconv.ParseFloat(x, 64)\r\n        return f\r\n"]
[1924.586637, "o", "    default:\r\n        return 0\r\n    }\r\n}\r\n\r\nfunc toStringSlice(v []interface{}) []string {\r\n    out := make([]string, 0, len(v))\r\n    for _, item := range v {\r\n        out = append(out, asString(item))\r\n    }\r\n    return out\r\n}\r\n\r\n"]
[1924.5867, "o", "func toStringMap(m map[string]interface{}) map[string]string {\r\n    out := make(map[string]string)\r\n    for k, v := range m {\r\n        out[k] = asString(v)\r\n    }\r\n    return out\r\n}\r\n\r\nfunc formatFloat(f float64) string {\r\n    return strconv.FormatFloat(f, 'g', -1, 64)\r\n}\r\n\r\nfunc validatePipeline(p *Pipeline) []string {\r\n    var errs []string\r\n"]
[1924.586764, "o", "    names := make(map[string]int)\r\n    stageSet := make(map[string]bool)\r\n    stageMap := make(map[string]Stage)\r\n\r\n    for i, stage := range p.Stages {\r\n        if stage.Name == \"\" {\r\n            errs = append(errs, fmt.Sprintf(\"stage %d: missing required field name\", i))\r\n        }\r\n        if stage.Command == \"\" {\r\n            errs = append(errs, fmt.Sprintf(\"stage %d: missing required field command\", i))\r\n        }\r\n"]
[1924.586828, "o", "        if stage.Name != \"\" {\r\n            if prev, ok := names[stage.Name]; ok {\r\n                errs = append(errs, fmt.Sprintf(\"duplicate stage name: %s (stages %d and %d)\", stage.Name, prev, i))\r\n            } else {\r\n                names[stage.Name] = i\r\n            }\r\n            stageSet[stage.Name] = true\r\n            stageMap[stage.Name] = stage\r\n        }\r\n    }\r\n\r\n    for _, stage := range p.Stages {\r\n        for _, dep := range stage.DependsOn {\r\n            if !stageSet[dep] {\r\n"]
[1924.586892, "o", "                errs = append(errs, fmt.Sprintf(\"stage %q depends on undefined stage %q\", stage.Name, dep))\r\n            }\r\n        }\r\n    }\r\n\r\n    for _, stage := range p.Stages {\r\n        if stage.Name == \"\" {\r\n            continue\r\n        }\r\n        state := make(map[string]int)\r\n        var check func(name string)\r\n        check = func(name string) {\r\n            state[name] = 1\r\n            for _, dep := range stageMap[name].DependsOn {\r\n"]
[1924.586975, "o", "                if !stageSet[dep] {\r\n                    continue\r\n                }\r\n                if state[dep] == 1 {\r\n                    errs = append(errs, fmt.Sprintf(\"circular dependency detected involving stage: %s\", name))\r\n                } else if state[dep] == 0 {\r\n                    check(dep)\r\n                }\r\n            }\r\n            state[name] = 2\r\n        }\r\n        check(stage.Name)\r\n    }\r\n\r\n    return errs\r\n}\r\n"]
