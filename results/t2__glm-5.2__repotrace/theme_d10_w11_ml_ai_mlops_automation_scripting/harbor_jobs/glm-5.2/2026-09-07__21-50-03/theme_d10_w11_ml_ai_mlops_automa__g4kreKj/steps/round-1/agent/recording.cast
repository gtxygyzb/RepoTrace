[2112.182003, "o", "\t    }\r\n   618\t    return nil\r\n   619\t}\r\n   620\t\r\n   621\tfunc asString(v interface{}) string {\r\n   622\t    if v == nil {\r\n   623\t        return \"\"\r\n   624\t    }\r\n   625\t    switch x := v.(type) {\r\n   626\t    case string:\r\n   627\t        return x\r\n   628\t    case int:\r\n   629\t        return strconv.Itoa(x)\r\n   630"]
[2112.182063, "o", "\t    case float64:\r\n   631\t        return formatFloat(x)\r\n   632\t    case bool:\r\n   633\t        return strconv.FormatBool(x)\r\n   634\t    default:\r\n   635\t        return fmt.Sprint(x)\r\n   636\t    }\r\n   637\t}\r\n   638\t\r\n   639\tfunc asInt(v interface{}) int {\r\n"]
