[8109.001549, "o", "\t\tfor _, stage := range p.Stages {\r\n\t\t\tif st, err := readStageState(id, stage.Name); err == nil && st.Status == \"completed\" {\r\n\t\t\t\tfor _, m := range st.Metrics {\r\n\t\t\t\t\tmetrics[m.Name] = m.Value\r\n"]
[8109.001657, "o", "\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif val, ok := metrics[metricName]; ok {\r\n\t\t\tgroupValues[paramValue] = append(groupValues[paramValue], val)\r\n\t\t}\r\n\t}\r\n\r\n"]
[8109.001728, "o", "\tif len(groupValues) == 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: metric %q not found in any completed experiment\\n\", metricName)\r\n\t\treturn 1\r\n\t}\r\n\r\n\tvalues := make([]string, 0, len(groupValues))\r\n\tfor v := range groupValues {\r\n\t\tvalues = append(values, v)\r\n\t}\r\n\tsort.Strings(values)\r\n\r\n\tgroups := make([]groupOut, 0, len(values))\r\n\tgroupMeans := map[string]float64{}\r\n\tgroupVars := map[string]float64{}\r\n\ttotalN := 0\r\n\tgrandSum := 0.0\r\n\tfor _, v := range values {\r\n\t\tobs := groupValues[v]\r\n"]
[8109.001803, "o", "\t\tn := len(obs)\r\n\t\ttotalN += n\r\n\t\tmean := meanValue(obs)\r\n\t\tvariance := 0.0\r\n\t\tif n > 1 {\r\n\t\t\tss := 0.0\r\n\t\t\tfor _, x := range obs {\r\n\t\t\t\tdiff := x - mean\r\n\t\t\t\tss += diff * diff\r\n\t\t\t}\r\n\t\t\tvariance = ss / float64(n-1)\r\n\t\t}\r\n\t\tgroupMeans[v] = mean\r\n"]
[8109.001865, "o", "\t\tgroupVars[v] = variance\r\n\t\tgrandSum += mean * float64(n)\r\n\t\tgroups = append(groups, groupOut{\r\n\t\t\tValue: v,\r\n\t\t\tCount: n,\r\n\t\t\tMean:  round4(mean),\r\n\t\t\tStd:   round4(math.Sqrt(variance)),\r\n\t\t\tMin:   round4(minValue(obs)),\r\n"]
[8109.001964, "o", "\t\t\tMax:   round4(maxValue(obs)),\r\n\t\t})\r\n\t}\r\n\r\n\tgrandMean := 0.0\r\n\tif totalN > 0 {\r\n\t\tgrandMean = grandSum / float64(totalN)\r\n\t}\r\n\r\n\tk := len(values)\r\n\tbetweenVariance := 0.0\r\n\t"]
[8109.002032, "o", "withinVariance := 0.0\r\n\tif k > 1 && totalN > k {\r\n\t\tfor _, v := range values {\r\n\t\t\tn := len(groupValues[v])\r\n\t\t\tdiff := groupMeans[v] - grandMean\r\n\t\t\tbetweenVariance += float64(n) * diff * diff\r\n\t\t\twithinVariance += float64(n-1) * groupVars[v]\r\n\t\t}\r\n\t\tbetweenVariance /= float64(k - 1)\r\n\t\twithinVariance /= float64(totalN - k)\r\n\t}\r\n\r\n\tvar anovaF *float64\r\n\t"]
[8109.0021, "o", "if k > 1 && totalN > k && withinVariance > 0 {\r\n\t\tf := betweenVariance / withinVariance\r\n\t\tf = round4(f)\r\n\t\tanovaF = &f\r\n\t}\r\n\r\n\tvar effectSize *float64\r\n\t"]
[8109.002166, "o", "pooledStd := math.Sqrt(withinVariance)\r\n\tif k > 1 && totalN > k && pooledStd > 0 {\r\n\t\tmaxMean := groupMeans[values[0]]\r\n\t\tminMean := groupMeans[values[0]]\r\n\t\tfor _, v := range values {\r\n\t\t\tif groupMeans[v] > maxMean {\r\n\t\t\t\tmaxMean = groupMeans[v]\r\n\t\t\t}\r\n\t\t\tif groupMeans[v] < minMean {\r\n\t\t\t\tminMean = groupMeans[v]\r\n\t\t\t}\r\n\t\t}\r\n\t\tes := round4((maxMean - minMean) / pooledStd)\r\n\t\teffectSize = &es\r\n\t}\r\n\r\n"]
[8109.002226, "o", "\tbestValue := \"\"\r\n\tbestMean := 0.0\r\n\tfor _, v := range values {\r\n\t\tmean := groupMeans[v]\r\n\t\tif bestValue == \"\" {\r\n\t\t\tbestValue = v\r\n\t\t\tbestMean = mean\r\n"]
[8109.002293, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tif objective == \"minimize\" {\r\n\t\t\tif mean < bestMean {\r\n\t\t\t\tbestValue = v\r\n\t\t\t\tbestMean = mean\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t\tif mean > bestMean {\r\n\t\t\t\tbestValue = v\r\n"]
[8109.002355, "o", "\t\t\t\tbestMean = mean\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tout := struct {\r\n\t\tParameter  string     `json:\"parameter\"`\r\n\t\tMetric     string     `json:\"metric\"`\r\n\t\tObjective  string     `json:\"objective\"`\r\n"]
[8109.00242, "o", "\t\tGroups     []groupOut `json:\"groups\"`\r\n\t\tAnovaF     *float64   `json:\"anova_f\"`\r\n\t\tBestValue  string     `json:\"best_value\"`\r\n\t\tEffectSize *float64   `json:\"effect_size\"`\r\n\t}{\r\n\t\tParameter:  paramName,\r\n\t\tMetric:     metricName,\r\n\t\tObjective:  objective,\r\n\t\tGroups:     groups,\r\n\t\tAnovaF:     anovaF,\r\n\t\tBestValue:  bestValue,\r\n"]
[8109.002487, "o", "\t\tEffectSize: effectSize,\r\n\t}\r\n\r\n\tenc := json.NewEncoder(os.Stdout)\r\n\tenc.SetIndent(\"\", \"  \")\r\n\tif err := enc.Encode(out); err != nil {\r\n\t\t"]
[8109.002552, "o", "fmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc meanValue(values []float64) float64 {\r\n\tif len(values) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tsum := 0.0\r\n\tfor _, v := range values {\r\n\t\tsum += v\r\n\t}\r\n\treturn sum / float64(len(values))\r\n}\r\n\r\n"]
[8109.002613, "o", "func sampleStd(values []float64) float64 {\r\n\tn := len(values)\r\n\tif n <= 1 {\r\n\t\treturn 0.0\r\n\t}\r\n\tmean := meanValue(values)\r\n\tss := 0.0\r\n\tfor _, v := range values {\r\n\t\tdiff := v - mean\r\n\t\tss += diff * diff\r\n\t}\r\n"]
[8109.002671, "o", "\treturn math.Sqrt(ss / float64(n-1))\r\n}\r\n\r\nfunc minValue(values []float64) float64 {\r\n\tif len(values) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tm := values[0]\r\n\t"]
[8109.00273, "o", "for _, v := range values {\r\n\t\tif v < m {\r\n\t\t\tm = v\r\n\t\t}\r\n\t}\r\n\treturn m\r\n}\r\n\r\nfunc maxValue(values []float64) float64 {\r\n"]
[8109.002792, "o", "\tif len(values) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tm := values[0]\r\n\tfor _, v := range values {\r\n\t\tif v > m {\r\n\t\t\tm = v\r\n\t\t}\r\n\t}\r\n\treturn m\r\n}\r\n\r\n"]
[8109.002858, "o", "func runExperiment(p *Pipeline, combo map[string]interface{}, resume bool) error {\r\n\tid := experimentID(combo)\r\n\tstageMap := make(map[string]Stage)\r\n\tfor _, stage := range p.Stages {\r\n\t\tstageMap[stage.Name] = stage\r\n\t}\r\n\tgroups, err := topologicalGroups(p)\r\n"]
[8109.002935, "o", "\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tmetrics := make(map[string]float64)\r\n\tfor _, group := range groups {\r\n\t\tfor _, name := range group {\r\n\t\t\tstage := stageMap[name]\r\n\t\t\tif resume {\r\n\t\t\t\tif st, err := readStageState(id, name); err == nil && (st.Status == \"completed\" || st.Status == \"skipped\") {\r\n\t\t\t\t\tfor _, m := range st.Metrics {\r\n\t\t\t\t\t\tmetrics[m.Name] = m.Value\r\n\t\t\t\t\t}\r\n\t\t\t\t\tcontinue\r\n"]
[8109.003001, "o", "\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif stage.Condition != nil {\r\n\t\t\t\tval, ok := metrics[stage.Condition.Metric]\r\n\t\t\t\tif !ok || !compareMetric(val, stage.Condition.Operator, stage.Condition.Threshold) {\r\n\t\t\t\t\tst := &StageState{\r\n\t\t\t\t"]
[8109.003062, "o", "\t\tName:      name,\r\n\t\t\t\t\t\tStatus:    \"skipped\",\r\n\t\t\t\t\t\tExitCode:  0,\r\n\t\t\t\t\t\tStartTime: time.Now().Format(time.RFC3339),\r\n\t\t\t\t\t\tEndTime:   time.Now().Format(time.RFC3339),\r\n\t\t\t\t\t}\r\n\t\t\t\t\t"]
[8109.003122, "o", "if err := writeStageState(id, name, st); err != nil {\r\n\t\t\t\t\t\treturn err\r\n\t\t\t\t\t}\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tst, err := runStage(id, stage, combo)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn err\r\n"]
[8109.003184, "o", "\t\t\t}\r\n\t\t\tfor _, m := range st.Metrics {\r\n\t\t\t\tmetrics[m.Name] = m.Value\r\n\t\t\t}\r\n\t\t\t_ = updateArtifactIndex(id, name, stage)\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n"]
[8109.003244, "o", "\r\nfunc runStage(experimentID string, stage Stage, combo map[string]interface{}) (*StageState, error) {\r\n\tmaxAttempts := 1\r\n\tbackoff := 0.0\r\n\tif stage.Retry != nil && stage.Retry.MaxAttempts > 0 {\r\n\t\tmaxAttempts = stage.Retry.MaxAttempts\r\n\t\tbackoff = stage.Retry.BackoffSeconds\r\n\t}\r\n"]
[8109.003309, "o", "\tvar lastErr error\r\n\tfor attempt := 1; attempt <= maxAttempts; attempt++ {\r\n\t\tcmd := exec.Command(\"sh\", \"-c\", stage.Command)\r\n\t\tcmd.Env = os.Environ()\r\n\t\tfor k, v := range stage.Env {\r\n\t\t\tcmd.Env = append(cmd.Env, k+\"=\"+substituteParams(v, combo))\r\n\t\t}\r\n\t\tvar stdout bytes.Buffer\r\n\t\tcmd.Stdout = &stdout\r\n\t\tcmd.Stderr = os.Stderr\r\n\t\t"]
[8109.003371, "o", "start := time.Now()\r\n\t\trunErr := cmd.Run()\r\n\t\tif runErr == nil {\r\n\t\t\tst := &StageState{\r\n"]
[8109.003435, "o", "\t\t\t\tName:      stage.Name,\r\n\t\t\t\tStatus:    \"completed\",\r\n\t\t\t\tExitCode:  0,\r\n\t\t\t\tMetrics:   parseMetrics(stdout.String()),\r\n\t\t\t\tStartTime: start.Format(time.RFC3339),\r\n\t\t\t\tEndTime:   time.Now().Format(time.RFC3339),\r\n\t\t\t\tRetries:   attempt - 1,\r\n\t\t\t}\r\n\t\t\tif err := writeStageState(experimentID, stage.Name, st); err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\treturn st, nil\r\n\t"]
[8109.003497, "o", "\t}\r\n\t\tlastErr = runErr\r\n\t\tif attempt < maxAttempts && backoff > 0 {\r\n\t\t\ttime.Sleep(time.Duration(backoff * float64(time.Second)))\r\n\t\t}\r\n\t}\r\n\tst := &StageState{\r\n\t\tName:      stage.Name,\r\n\t\tStatus:    \"failed\",\r\n\t"]
[8109.003561, "o", "\tExitCode:  exitCodeFromError(lastErr),\r\n\t\tStartTime: time.Now().Format(time.RFC3339),\r\n\t\tEndTime:   time.Now().Format(time.RFC3339),\r\n\t\tRetries:   maxAttempts - 1,\r\n\t}\r\n\t_ = writeStageState(experimentID, stage.Name, st)\r\n\treturn nil, fmt.Errorf(\"stage %s failed: %w\", stage.Name, lastErr)\r\n}\r\n\r\nfunc parseMetrics(output string) []MetricData {\r\n"]
[8109.003626, "o", "\tvar metrics []MetricData\r\n\tscanner := bufio.NewScanner(strings.NewReader(output))\r\n\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n"]
[8109.003688, "o", "\t\tif line == \"\" || !strings.HasPrefix(line, \"{\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvar m MetricData\r\n\t\tif err := json.Unmarshal([]byte(line), &m); err == nil && m.Name != \"\" {\r\n\t\t\tmetrics = append(metrics, m)\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvar mm map[string]interface{}\r\n\t\tif err := json.Unmarshal([]byte(line), &mm); err == nil {\r\n\t\t\tif name, ok := mm[\"metric\"].(string); ok {\r\n\t\t\t\tmetrics = append(metrics, MetricData{Name: name, Value: asFloat(mm[\"value\"])})\r\n"]
[8109.00375, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn metrics\r\n}\r\n\r\nfunc compareMetric(val float64, op string, threshold float64) bool {\r\n\tswitch op {\r\n\tcase \">=\":\r\n\t\treturn val >= threshold\r\n"]
[8109.003813, "o", "\tcase \">\":\r\n\t\treturn val > threshold\r\n\tcase \"<=\":\r\n\t\treturn val <= threshold\r\n\tcase \"<\":\r\n\t\treturn val < threshold\r\n\tcase \"==\":\r\n\t\treturn val == threshold\r\n\tcase \"!=\":\r\n\t"]
[8109.003874, "o", "\treturn val != threshold\r\n\tdefault:\r\n\t\treturn false\r\n\t}\r\n}\r\n\r\nfunc exitCodeFromError(err error) int {\r\n\tif exiterr, ok := err.(*exec.ExitError); ok {\r\n\t\treturn exiterr.ExitCode()\r\n\t}\r\n\treturn 1"]
[8109.003942, "o", "\r\n}\r\n\r\nfunc updateArtifactIndex(experimentID, stageName string, stage Stage) error {\r\n\tidx := loadArtifactIndex()\r\n\tfor _, out := range stage.Outputs {\r\n\t\tinfo, err := os.Stat(out.Path)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t"]
[8109.004007, "o", "\t}\r\n\t\tf, err := os.Open(out.Path)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\th := sha256.New()\r\n\t\tif _, err := io.Copy(h, f); err != nil {\r\n\t\t\tf.Close()\r\n\t\t\tcontinue\r\n"]
[8109.004071, "o", "\t\t}\r\n\t\tf.Close()\r\n\t\tidx.Entries = append(idx.Entries, ArtifactEntry{\r\n\t\t\tExperimentID: experimentID,\r\n\t\t\tStageName:    stageName,\r\n\t\t\tPath:         out.Path,\r\n\t\t\tHash:         hex.EncodeToString(h.Sum(nil)),\r\n\t\t\tSize:         info.Size(),\r\n\t\t})\r\n\t}\r\n\treturn saveArtifactIndex(idx)\r\n"]
[8109.004135, "o", "}\r\n\r\ntype compareExperimentData struct {\r\n\tID       string\r\n\tPipeline string\r\n\tMetrics  map[string]float64\r\n}\r\n\r\nfunc collectExperimentMetrics(p *Pipeline, id string) map[string]float64 {\r\n\tmetrics := map[string]float64{}\r\n\tfor _, stage := range p.Stages {\r\n\t\tif st, err := readStageState(id, stage.Name); err == nil {\r\n\t\t\t"]
[8109.004205, "o", "for _, m := range st.Metrics {\r\n\t\t\t\tmetrics[m.Name] = m.Value\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn metrics\r\n}\r\n\r\nfunc dominates(a, b map[string]float64, metrics []string) bool {\r\n\tstrictlyBetter := false\r\n\tfor _, m := range metrics {\r\n\t\tif a[m] < b[m] {\r\n"]
[8109.004265, "o", "\t\t\treturn false\r\n\t\t}\r\n\t\tif a[m] > b[m] {\r\n\t\t\tstrictlyBetter = true\r\n\t\t}\r\n\t}\r\n\treturn strictlyBetter\r\n}\r\n\r\n"]
[8109.004327, "o", "func cmdCompare(args []string) int {\r\n\tif len(args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe compare <pipeline1.yaml> <pipeline2.yaml> ...\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\ttype pipelineInfo struct {\r\n\t\tName     string\r\n\t\tPipeline *Pipeline\r\n\t\tIDs      []string\r\n\t}"]
[8109.004387, "o", "\r\n\tvar pipelines []pipelineInfo\r\n\tidToPipeline := make(map[string]int)\r\n\r\n\tfor i, file := range args {\r\n\t\tp, err := loadPipeline(file)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\t\treturn 1\r\n"]
[8109.004447, "o", "\t\t}\r\n\t\tif errs := validatePipeline(p); len(errs) > 0 {\r\n\t\t\tfor _, e := range errs {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, e)\r\n\t\t\t}\r\n\t\t\treturn 1\r\n\t\t}\r\n"]
[8109.004509, "o", "\t\tinfo := pipelineInfo{Name: p.Name, Pipeline: p}\r\n\t\tfor _, combo := range parameterCombinations(p) {\r\n\t\t\tid := experimentID(combo)\r\n\t\t\tif prev, ok := idToPipeline[id]; ok {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: experiment ID collision: %s between pipelines %s and %s\\n\", id, pipelines[prev].Name, p.Name)\r\n\t\t\t\treturn 1\r\n\t\t\t}\r\n\t\t\tidToPipeline[id] = i\r\n\t\t\tinfo.IDs = append(info.IDs, id)\r\n"]
[8109.004573, "o", "\t\t}\r\n\t\tpipelines = append(pipelines, info)\r\n\t}\r\n\r\n\tfor _, info := range pipelines {\r\n"]
[8109.004635, "o", "\t\tmatching := 0\r\n\t\tfor _, id := range info.IDs {\r\n\t\t\tif experimentStateExists(id) {\r\n\t\t\t\tmatching++\r\n\t\t\t}\r\n\t\t}\r\n\t\tif matching == 0 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: pipeline %s has no matching experiments under .mlpipe/state\\n\", info.Name)\r\n\t\t\treturn 1\r\n\t\t}\r\n\t}\r\n\r\n\tmetricObjective := make(map[string]string)\r\n\tfor i, info := range pipelines {"]
[8109.0047, "o", "\r\n\t\tpm := make(map[string]string)\r\n\t\tfor _, stage := range info.Pipeline.Stages {\r\n\t\t\tfor _, m := range stage.Metrics {\r\n\t\t\t\tif m.Objective != \"minimize\" && m.Objective != \"maximize\" {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tif existing, ok := pm[m.Name]; ok && existing != m.Objective {\r\n\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: conflicting objective for metric %s in pipeline %s\\n\", m.Name, info.Name)\r\n\t\t\t\t\treturn 1\r\n"]
[8109.004767, "o", "\t\t\t\t}\r\n\t\t\t\tpm[m.Name] = m.Objective\r\n\t\t\t}\r\n\t\t}\r\n\t\tif i == 0 {\r\n"]
[8109.00483, "o", "\t\t\tmetricObjective = pm\r\n\t\t} else {\r\n\t\t\tfor k, v := range metricObjective {\r\n\t\t\t\tif v2, ok := pm[k]; !ok || v2 != v {\r\n\t\t\t\t\tdelete(metricObjective, k)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tsharedMetrics := make([]string, 0, len(metricObjective))\r\n\tfor k := range metricObjective {\r\n\t\tsharedMetrics = append(sharedMetrics, k)\r\n\t}\r\n\tsort.Strings(sharedMetrics)\r\n\tif len(sharedMetrics) == 0 {\r\n"]
[8109.004892, "o", "\t\tfmt.Fprintln(os.Stderr, \"error: no shared objective metrics found across pipelines\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\tincluded := []compareExperimentData{}\r\n\tfor _, info := range pipelines {\r\n\t\tfor _, id := range info.IDs {\r\n\t\t\tif !experimentStateExists(id) {\r\n\t\t\t\tcontinue\r\n"]
[8109.004962, "o", "\t\t\t}\r\n"]
