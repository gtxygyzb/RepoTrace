[6241.465648, "o", "\t\t\tIsParetoOptimal: depth[idx] == 0,\r\n\t\t\tDominanceDepth:  depth[idx],\r\n\t\t})\r\n\t}\r\n\r\n\tparetoFrontier := []string{}\r\n\tfor i, exp := range included {\r\n\t\tif depth[i] == 0 {\r\n\t\t\tparetoFrontier = append(paretoFrontier, exp.ID)\r\n\t\t}\r\n\t}\r\n\tsort.Strings(paretoFrontier)"]
[6241.465713, "o", "\r\n\r\n\ttype correlationOut struct {\r\n\t\tSpearman *float64 `json:\"spearman_rho\"`\r\n\t\tKendall  *float64 `json:\"kendall_tau\"`\r\n\t\tN        int      `json:\"n\"`\r\n\t}\r\n\tcorrelations := map[string]correlationOut{}\r\n\tfor i := 0; i < len(sharedMetrics); i++ {\r\n\t\tfor j := i + 1; j < len(sharedMetrics); j++ {\r\n\t\t\trho, tau := computeCorrelations(included, sharedMetrics[i], sharedMetrics[j])\r\n\t\t\tcorrelations[sharedMetrics[i]+\"_vs_\"+sharedMetrics[j]] = correlationOut{Spearman: rho, Kendall: tau, N: len(included)}"]
