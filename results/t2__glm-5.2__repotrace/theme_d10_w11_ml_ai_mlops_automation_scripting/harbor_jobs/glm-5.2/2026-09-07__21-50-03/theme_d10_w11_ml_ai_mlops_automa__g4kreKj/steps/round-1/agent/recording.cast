[8100.941424, "o", "func parseArtifactsArgs(args []string) (string, bool, bool, error) {\r\n\tpipelineFile := \"\"\r\n\tlist := false\r\n\tgc := false\r\n\tfor _, arg := range args {\r\n\t\tswitch arg {\r\n\t\tcase \"--list\":\r\n\t\t\tlist = true\r\n\t\tcase \"--gc\":\r\n"]
[8100.941544, "o", "\t\t\tgc = true\r\n\t\tdefault:\r\n\t\t\tif pipelineFile == \"\" {\r\n\t\t\t\tpipelineFile = arg\r\n\t\t\t} else {\r\n\t\t\t\treturn \"\", false, false, fmt.Errorf(\"unexpected argument: %s\", arg)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif pipelineFile == \"\" {\r\n\t\treturn \"\", false, false, fmt.Errorf(\"usage: mlpipe artifacts <pipeline.yaml> [--list] [--gc]\")\r\n\t}\r\n\treturn pipelineFile, list, gc, nil\r\n}\r\n\r\ntype Pipeline struct {\r\n\tName       string\r\n\tVersion    string\r\n\tParameters []Parameter\r\n\tStages     []Stage\r\n}\r\n\r\n"]
[8100.941629, "o", "type Parameter struct {\r\n\tName   string\r\n\tValues []interface{}\r\n}\r\n\r\ntype Stage struct {\r\n"]
[8100.941704, "o", "\tName      string\r\n\tCommand   string\r\n\tDependsOn []string\r\n\tEnv       map[string]string\r\n\tMetrics   []Metric\r\n\tRetry     *Retry\r\n\tCondition *Condition\r\n\tOutputs   []ArtifactRef\r\n\tInputs    []ArtifactRef\r\n}\r\n\r\ntype Metric struct {\r\n\tName      string\r\n\tObjective string\r\n}\r\n\r\ntype Retry struct {\r\n\tMaxAttempts    int\r\n"]
[8100.941774, "o", "\tBackoffSeconds float64\r\n}\r\n\r\ntype Condition struct {\r\n\tMetric    string\r\n\tOperator  string\r\n\tThreshold float64\r\n}\r\n\r\ntype ArtifactRef struct {\r\n\tPath string\r\n\tType string\r\n}\r\n\r\ntype MetricData struct {\r\n\tName  string  `json:\"name\"`\r\n\tValue float64 `json:\"value\"`\r\n"]
[8100.941841, "o", "}\r\n\r\ntype StageState struct {\r\n\tName      string       `json:\"name\"`\r\n\tStatus    string       `json:\"status\"`\r\n\tExitCode  int          `json:\"exit_code\"`\r\n\tMetrics   []MetricData `json:\"metrics\"`\r\n\tStartTime string       `json:\"start_time\"`\r\n\tEndTime   string       `json:\"end_time\"`\r\n\tRetries   int          `json:\"retries\"`\r\n}\r\n\r\ntype ArtifactEntry struct {\r\n\tExperimentID string `json:\"experiment_id\"`\r\n\tStageName    string `json:\"stage_name\"`\r\n\tPath         string `json:\"path\"`\r\n\tHash         string `json:\"hash\"`\r\n\tSize         int64  `json:\"size\"`\r\n}\r\n\r\ntype ArtifactIndex struct {\r\n"]
[8100.941904, "o", "\tEntries []ArtifactEntry `json:\"entries\"`\r\n}\r\n\r\ntype yamlLine struct {\r\n\tindent  int\r\n\tcontent string\r\n}\r\n\r\n"]
[8100.941967, "o", "func loadPipeline(path string) (*Pipeline, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tv, err := parseYAML(data)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn mapToPipeline(v)\r\n}\r\n\r\nfunc parseYAML(data []byte) (interface{}, error) {\r\n"]
[8100.942052, "o", "\tvar lines []yamlLine\r\n\tfor _, raw := range strings.Split(string(data), \"\\n\") {\r\n\t\traw = strings.TrimRight(raw, \"\\r\")\r\n\t\ttrimmed := strings.TrimSpace(raw)\r\n\t\tif trimmed == \"\" || strings.HasPrefix(trimmed, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tindent := 0\r\n\t\tfor indent < len(raw) && raw[indent] == ' ' {\r\n\t\t\tindent++\r\n\t\t}\r\n\t\tcontent := strings.TrimRight(raw[indent:], \" \")\r\n\t\tlines = append(lines, yamlLine{indent: indent, content: content})\r\n\t}\r\n\tif len(lines) == 0 {\r\n"]
[8100.94212, "o", "\t\treturn nil, nil\r\n\t}\r\n\tv, idx := parseBlock(lines, 0, 0)\r\n\tif idx < len(lines) {\r\n\t\treturn nil, fmt.Errorf(\"unexpected YAML structure at line: %q\", lines[idx].content)\r\n\t}\r\n\treturn v, nil\r\n}\r\n"]
[8100.942184, "o", "\r\nfunc parseBlock(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n\tif idx >= len(lines) || lines[idx].indent < indent {\r\n\t\treturn nil, idx\r\n\t}\r\n\tif strings.HasPrefix(lines[idx].content, \"- \") || lines[idx].content == \"-\" {\r\n\t\treturn parseSequence(lines, idx, indent)\r\n\t}\r\n\treturn parseMapping(lines, idx, indent)\r\n}\r\n\r\nfunc parseSequence(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n\tseq := []interface{}{}\r\n\tfor idx < len(lines) && lines[idx].indent == indent && (strings.HasPrefix(lines[idx].content, \"- \") || lines[idx].content == \"-\") {\r\n\t\tcontent := strings.TrimPrefix(lines[idx].content, \"-\")\r\n\t\t"]
[8100.942247, "o", "content = strings.TrimLeft(content, \" \")\r\n\t\tif content == \"\" {\r\n\t\t\tval, next := parseBlock(lines, idx+1, indent+2)\r\n\t\t\tseq = append(seq, val)\r\n\t\t\tidx = next\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif isMappingStart(content) {\r\n\t\t\tsublines := []yamlLine{{indent: indent + 2, content: content}}\r\n\t\t\tstart := idx + 1\r\n"]
[8100.942305, "o", "\t\t\tfor start < len(lines) && lines[start].indent > indent {\r\n\t\t\t\tsublines = append(sublines, lines[start])\r\n\t\t\t\tstart++\r\n\t\t\t}\r\n\t\t\tval, _ := parseBlock(sublines, 0, indent+2)\r\n\t\t\tseq = append(seq, val)\r\n\t\t\tidx = start\r\n\t\t} else {\r\n\t\t\tseq = append(seq, parseScalar(content))\r\n"]
[8100.942369, "o", "\t\t\tidx++\r\n\t\t}\r\n\t}\r\n\treturn seq, idx\r\n}\r\n\r\nfunc parseMapping(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n\tm := map[string]interface{}{}\r\n\tfor idx < len(lines) && lines[idx].indent == indent {\r\n\t\tcontent := lines[idx].content\r\n\t\tif strings.HasPrefix(content, \"- \") || content == \"-\" {\r\n\t\t\tbreak\r\n\t\t}\r\n\t\tkey, value, ok := splitKeyValue(content)\r\n"]
[8100.942434, "o", "\t\tif !ok {\r\n\t\t\treturn nil, idx\r\n\t\t}\r\n\t\tif value != \"\" {\r\n\t\t\tm[key] = parseScalar(value)\r\n"]
[8100.942491, "o", "\t\t\tidx++\r\n\t\t} else {\r\n\t\t\tval, next := parseBlock(lines, idx+1, indent+2)\r\n\t\t\tm[key] = val\r\n\t\t\tidx = next\r\n\t\t}\r\n\t}\r\n\treturn m, idx\r\n}\r\n\r\nfunc isMappingStart(s string) bool {\r\n\tif strings.HasPrefix(s, \"[\") || strings.HasPrefix(s, \"{\") {\r\n\t\treturn false\r\n\t}\r\n\t_, _, ok := splitKeyValue(s)\r\n\treturn ok"]
[8100.942549, "o", "\r\n}\r\n\r\nfunc splitKeyValue(s string) (string, string, bool) {\r\n\tinQuote := false\r\n\tquoteChar := byte(0)\r\n\tfor i := 0; i < len(s); i++ {\r\n\t\tc := s[i]\r\n\t\tif inQuote {\r\n\t\t\tif c == quoteChar {\r\n\t\t\t\tinQuote = false\r\n\t\t\t"]
[8100.942609, "o", "}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif c == '\"' || c == '\\'' {\r\n\t\t\tinQuote = true\r\n\t\t\tquoteChar = c\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif c == ':' {\r\n\t\t\tif i+1 >= len(s) || s[i+1] == ' ' {\r\n"]
[8100.942671, "o", "\t\t\t\tkey := strings.TrimSpace(s[:i])\r\n\t\t\t\tvalue := strings.TrimSpace(s[i+1:])\r\n\t\t\t\tkey = unquoteScalar(key)\r\n\t\t\t\treturn key, value, true\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[8100.942727, "o", "\treturn \"\", \"\", false\r\n}\r\n\r\nfunc parseScalar(s string) interface{} {\r\n\ts = strings.TrimSpace(s)\r\n\tif s == \"\" {\r\n\t\treturn \"\"\r\n\t}\r\n\tif strings.HasPrefix(s, \"[\") && strings.HasSuffix(s, \"]\") {\r\n\t\treturn parseInlineList(s)\r\n\t}\r\n"]
[8100.942788, "o", "\tif strings.HasPrefix(s, \"{\") && strings.HasSuffix(s, \"}\") {\r\n\t\treturn parseInlineMap(s)\r\n\t}\r\n\tif len(s) >= 2 && (s[0] == '\"' && s[len(s)-1] == '\"' || s[0] == '\\'' && s[len(s)-1] == '\\'') {\r\n\t\treturn unquoteScalar(s)\r\n\t}\r\n\tif s == \"true\" {\r\n\t\treturn true\r\n\t}\r\n\tif s == \"false\" {\r\n\t\treturn false\r\n"]
[8100.94285, "o", "\t}\r\n\tif n, err := strconv.Atoi(s); err == nil {\r\n\t\treturn n\r\n\t}\r\n\tif f, err := strconv.ParseFloat(s, 64); err == nil {\r\n"]
[8100.942914, "o", "\t\treturn f\r\n\t}\r\n\treturn s\r\n}\r\n\r\nfunc parseInlineList(s string) interface{} {\r\n\tinner := strings.TrimSpace(s[1 : len(s)-1])\r\n\tif inner == \"\" {\r\n\t\treturn []interface{}{}\r\n\t}\r\n\tparts := splitCommas(inner)\r\n\tout := make([]interface{}, 0, len(parts))\r\n\tfor _, p := range parts {\r\n\t\tout = append(out, parseScalar(strings.TrimSpace(p)))\r\n"]
[8100.94299, "o", "\t}\r\n\treturn out\r\n}\r\n\r\nfunc parseInlineMap(s string) interface{} {\r\n\tinner := strings.TrimSpace(s[1 : len(s)-1])\r\n\tif inner == \"\" {\r\n\t\treturn map[string]interface{}{}\r\n\t}\r\n\tparts := splitCommas(inner)\r\n\tm := map[string]interface{}{}\r\n\tfor _, p := range parts {\r\n\t\tkey, value, ok := splitKeyValue(strings.TrimSpace(p))\r\n\t\tif ok {\r\n"]
[8100.943047, "o", "\t\t\tm[key] = parseScalar(value)\r\n\t\t}\r\n\t}\r\n\treturn m\r\n}\r\n\r\nfunc splitCommas(s string) []string {\r\n\tvar parts []string\r\n\tinQuote := false\r\n\tquoteChar := byte(0)\r\n\tdepth := 0\r\n\tstart := 0\r\n"]
[8100.943107, "o", "\tfor i := 0; i < len(s); i++ {\r\n"]
