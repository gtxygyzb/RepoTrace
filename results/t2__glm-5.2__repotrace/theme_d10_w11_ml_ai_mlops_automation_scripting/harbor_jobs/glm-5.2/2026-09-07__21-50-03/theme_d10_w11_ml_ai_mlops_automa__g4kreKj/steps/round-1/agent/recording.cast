[6472.042591, "o", "=== pipelines/broken_cycles.yaml\r\n"]
[6472.045435, "o", "name: broken-circular-pipeline\r\nversion: \"1.0\"\r\n\r\nstages:\r\n  - name: stage-a\r\n    command: \"echo a\"\r\n    depends_on: [\"stage-c\"]\r\n    outputs:"]
[6472.04555, "o", "\r\n      - path: \"out/a.txt\"\r\n        type: file\r\n\r\n  - name: stage-b\r\n    command: \"echo b\"\r\n    depends_on: [\"stage-a\"]\r\n    outputs:\r\n      - path: \"out/b.txt\"\r\n        type: file\r\n\r\n  - name: stage-c\r\n"]
[6472.04562, "o", "    command: \"echo c\"\r\n    depends_on: [\"stage-b\"]\r\n    outputs:\r\n      - path: \"out/c.txt\"\r\n        type: file\r\n"]
[6472.045964, "o", "=== pipelines/image_classifier.yaml\r\n"]
[6472.048654, "o", "name: image-classifier-training\r\nversion: \"1.0\"\r\n\r\nparameters:\r\n  learning_rate:\r\n    type: grid\r\n    values: [0.001, 0.01, 0.1]"]
[6472.048763, "o", "\r\n  batch_size:\r\n    type: grid\r\n    values: [32, 64]\r\n  optimizer:\r\n    type: grid\r\n    values: [\"adam\", \"sgd\"]\r\n\r\n"]
[6472.04886, "o", "stages:\r\n  - name: data-validation\r\n    command: \"./stages/validate_data.sh\"\r\n    inputs:\r\n      - path: \"data/sample\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    metrics:\r\n      - name: num_samples\r\n        objective: report\r\n      - name: corruption_rate\r\n        objective: minimize\r\n\r\n  - name: feature-extraction\r\n    command: \"./stages/extract_features.sh\"\r\n    depends_on: [\"data-validation\"]\r\n    inputs:\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"data/features.bin\"\r\n        type: file\r\n    env:\r\n      BATCH_SIZE: \"${batch_size}\"\r\n\r\n  - name: model-training\r\n    command: \"./stages/train_model.sh\"\r\n    depends_on: [\"feature-extraction\"]\r\n    inputs:\r\n      - path: \"data/features.bin\"\r\n        type: file\r\n    outputs:\r\n      - path: \"models/checkpoint.bin\""]
