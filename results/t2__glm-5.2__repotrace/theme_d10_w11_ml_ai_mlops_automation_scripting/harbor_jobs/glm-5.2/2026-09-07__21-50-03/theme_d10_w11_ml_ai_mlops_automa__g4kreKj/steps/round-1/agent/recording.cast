[3297.375273, "o", "func compareMetric(val float64, op string, threshold float64) bool {\r\n  1098\t\tswitch op {\r\n  1099\t\tcase \">=\":\r\n  1100\t\t\treturn val >= threshold\r\n  1101\t\tcase \">\":\r\n  1102\t\t\treturn val > threshold\r\n  1103\t\tcase \"<=\":\r\n  1104\t"]
[3297.375347, "o", "\t\treturn val <= threshold\r\n  1105\t\tcase \"<\":\r\n  1106\t\t\treturn val < threshold\r\n  1107\t\tcase \"==\":\r\n  1108\t\t\treturn val == threshold\r\n  1109\t\tcase \"!=\":\r\n  1110\t\t\treturn val != threshold\r\n  1111\t\tdefault:\r\n  1112\t\t\treturn false\r\n  1113\t\t}\r\n  1114"]
