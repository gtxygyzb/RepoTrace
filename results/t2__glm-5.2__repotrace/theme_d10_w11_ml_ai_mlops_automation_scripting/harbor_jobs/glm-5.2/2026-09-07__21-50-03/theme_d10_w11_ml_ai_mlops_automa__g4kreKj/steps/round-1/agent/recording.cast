[3394.905408, "o", "\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype Pipeline\u001b[m\u001b[K struct {\r\n"]
[3394.905488, "o", "\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KParameters\u001b[m\u001b[K []Parameter\r\n"]
[3394.905572, "o", "\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype Parameter\u001b[m\u001b[K struct {\r\n"]
[3394.905634, "o", "\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype Stage\u001b[m\u001b[K struct {\r\n"]
[3394.905694, "o", "\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K   []Metric\r\n"]
[3394.905725, "o", "\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype Metric\u001b[m\u001b[K struct {\r\n"]
[3394.905977, "o", "\u001b[32m\u001b[K265\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KObjective\u001b[m\u001b[K string\r\n\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype Metric\u001b[m\u001b[KData struct {\r\n\u001b[32m\u001b[K289\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype Stage\u001b[m\u001b[KState struct {\r\n\u001b[32m\u001b[K293\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K   []MetricData `json:\"metrics\"`\r\n\u001b[32m\u001b[K576\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tp.\u001b[01;31m\u001b[KParameters\u001b[m\u001b[K = append(p.\u001b[01;31m\u001b[KParameters\u001b[m\u001b[K, Parameter{Name: k, Values: asSlice(pm[\"values\"])})\r\n\u001b[32m\u001b[K589\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tstage.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K = append(stage.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K, Metric{Name: asString(mm[\"name\"]), \u001b[01;31m\u001b[KObjective\u001b[m\u001b[K: asString(mm[\"objective\"])})\r\n"]
[3394.906069, "o", "\u001b[32m\u001b[K789\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif len(p.\u001b[01;31m\u001b[KParameters\u001b[m\u001b[K) == 0 {\r\n\u001b[32m\u001b[K793\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, param := range p.\u001b[01;31m\u001b[KParameters\u001b[m\u001b[K {\r\n"]
[3394.906165, "o", "\u001b[32m\u001b[K941\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K map[string]float64 `json:\"metrics\"`\r\n\u001b[32m\u001b[K952\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\texp := reportExperiment{ID: id, \u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K: map[string]float64{}, Stages: []StageState{}}\r\n\u001b[32m\u001b[K956\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tfor _, m := range st.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K957\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t"]
[3394.906245, "o", "\t\texp.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[m.Name] = m.Value\r\n\u001b[32m\u001b[K988\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tfor _, m := range st.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1014\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor _, m := range st.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1047\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K:   parse\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K(stdout.String()),\r\n"]
[3394.906307, "o", "\u001b[32m\u001b[K1074\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc parse\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K(output string) []MetricData {\r\n\u001b[32m\u001b[K1154\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K  map[string]float64\r\n\u001b[32m\u001b[K1157\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc collectExperiment\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K(p *Pipeline, id string) map[string]float64 {\r\n\u001b[32m\u001b[K1161\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor _, m := range st.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmetric\u001b[01;31m\u001b[KObjective\u001b[m\u001b[K := make(map[string]string)\r\n"]
[3394.906367, "o", "\u001b[32m\u001b[K1238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor _, m := range stage.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1239\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif m.\u001b[01;31m\u001b[KObjective\u001b[m\u001b[K != \"minimize\" && m.\u001b[01;31m\u001b[KObjective\u001b[m\u001b[K != \"maximize\" {\r\n\u001b[32m\u001b[K1242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif existing, ok := pm[m.Name]; ok && existing != m.\u001b[01;31m\u001b[KObjective\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1246\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tpm[m.Name] = m.\u001b[01;31m\u001b[KObjective\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1250\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tmetric\u001b[01;31m\u001b[KObjective\u001b[m\u001b[K = pm\r\n\u001b[32m\u001b[K1252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor k, v := range metric\u001b[01;31m\u001b[KObjective\u001b[m\u001b[K {\r\n"]
[3394.90643, "o", "\u001b[32m\u001b[K1254\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tdelete(metric\u001b[01;31m\u001b[KObjective\u001b[m\u001b[K, k)\r\n\u001b[32m\u001b[K1259\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tshared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K := make([]string, 0, len(metric\u001b[01;31m\u001b[KObjective\u001b[m\u001b[K))\r\n\u001b[32m\u001b[K1260\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor k := range metric\u001b[01;31m\u001b[KObjective\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1261\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tshared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K = append(shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K, k)\r\n\u001b[32m\u001b[K1263\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tsort.Strings(shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K)\r\n"]
[3394.90649, "o", "\u001b[32m\u001b[K1264\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif len(shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K) == 0 {\r\n\u001b[32m\u001b[K1275\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tmetrics := collectExperiment\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K(info.Pipeline, id)\r\n\u001b[32m\u001b[K1277\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor _, m := range shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1286\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tincluded = append(included, compareExperimentData{ID: id, Pipeline: info.Name, \u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K: metrics})\r\n\u001b[32m\u001b[K1294\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, m := range shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n"]
[3394.906557, "o", "\u001b[32m\u001b[K1298\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tv := exp.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[m]\r\n\u001b[32m\u001b[K1311\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tnorm = (exp.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[m] - min) / (max - min)\r\n\u001b[32m\u001b[K1313\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif metric\u001b[01;31m\u001b[KObjective\u001b[m\u001b[K[m] == \"minimize\" {\r\n\u001b[32m\u001b[K1323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, m := range shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K1326\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif len(shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K) > 0 {\r\n\u001b[32m\u001b[K1327\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcomposite[i] = sum / float64(len(shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K))\r\n"]
[3394.906615, "o", "\u001b[32m\u001b[K1345\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif dominates(normalized[j], normalized[i], shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K1404\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K         map[string]float64 `json:\"metrics\"`\r\n\u001b[32m\u001b[K1416\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K:         filter\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K(included[idx].\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K, shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K),\r\n"]
[3394.906674, "o", "\u001b[32m\u001b[K1439\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor i := 0; i < len(shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K); i++ {\r\n\u001b[32m\u001b[K1440\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor j := i + 1; j < len(shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K); j++ {\r\n\u001b[32m\u001b[K1441\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\trho, tau := computeCorrelations(included, shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[i], shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[j])\r\n\u001b[32m\u001b[K1442\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcorrelations[shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[i]+\"_vs_\"+shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[j]] = correlationOut{Spearman: rho, Kendall: tau, N: len(included)}\r\n"]
[3394.906737, "o", "\u001b[32m\u001b[K1483\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tShared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K  []string                  `json:\"shared_metrics\"`\r\n\u001b[32m\u001b[K1495\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tShared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K:  shared\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K,\r\n\u001b[32m\u001b[K1518\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tvaluesA[i] = e.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[a]\r\n\u001b[32m\u001b[K1519\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tvaluesB[i] = e.\u001b[01;31m\u001b[KMetrics\u001b[m\u001b[K[b]\r\n"]
