[3420.875223, "o", "\u001b[32m\u001b[K808\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(combo) == 0 {\r\n\u001b[32m\u001b[K809\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn \"exp_default\"\r\n\u001b[32m\u001b[K810\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K811\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tkeys := make([]string, 0, len(combo))\r\n\u001b[32m\u001b[K812\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k := range combo {\r\n\u001b[32m\u001b[K813\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tkeys = append(keys, k)\r\n\u001b[32m\u001b[K814\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K815\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tsort.Strings(keys)\r\n\u001b[32m\u001b[K816\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tparts := make([]string, 0, len(keys))\r\n"]
[3420.875315, "o", "\u001b[32m\u001b[K817\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, k := range keys {\r\n\u001b[32m\u001b[K818\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tparts = append(parts, k+\"=\"+asString(combo[k]))\r\n\u001b[32m\u001b[K819\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K820\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn \"exp_\" + strings.Join(parts, \"_\")\r\n\u001b[32m\u001b[K821\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K822\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K823\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc substituteParams(value string, combo map[string]interface{}) string {\r\n\u001b[32m\u001b[K824\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k, v := range combo {\r\n\u001b[32m\u001b[K825\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tvalue = strings.ReplaceAll(value, \"${\"+k+\"}\", asString(v))\r\n\u001b[32m\u001b[K826\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K827\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn value\r\n"]
