[1324.669327, "o", "    if strings.HasPrefix(s, \"[\") || strings.HasPrefix(s, \"{\") {\r\n        return false\r\n    }\r\n"]
[1324.669369, "o", "    _, _, ok := splitKeyValue(s)\r\n    return ok\r\n"]
[1324.669384, "o", "}\r\n\r\nfunc splitKeyValue(s string) (string, string, bool) {\r\n"]
