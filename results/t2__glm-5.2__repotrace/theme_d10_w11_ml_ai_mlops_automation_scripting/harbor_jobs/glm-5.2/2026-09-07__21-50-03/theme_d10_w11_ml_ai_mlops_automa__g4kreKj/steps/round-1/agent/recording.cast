[8123.72136, "o", "\r\n\t\"io\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe <command> [args...]\")\r\n\t\tfmt.Fprintln(os.Stderr, \"Commands: validate, plan, run, report, artifacts, compare, sweep, export\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[8123.721452, "o", "\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n\tcase \"validate\":\r\n\t\tos.Exit(cmdValidate(args))\r\n\tcase \"plan\":\r\n\t\tos.Exit(cmdPlan(args))\r\n\tcase \"run\":\r\n\t\tos.Exit(cmdRun(args))\r\n\tcase \"report\":\r\n\t\tos.Exit(cmdReport(args))\r\n\tcase \"export\":\r\n\t\tos.Exit(cmdExport(args))\r\n\tcase \"artifacts\":\r\n"]
