[5086.698751, "o", "\t\t\t}\r\n\t\t\tmetrics := collectExperimentMetrics(info.Pipeline, id)\r\n\t\t\tallPresent := true\r\n\t\t\tfor _, m := range sharedMetrics {\r\n\t\t\t\tif _, ok := metrics[m]; !ok {\r\n"]
[5086.698846, "o", "\t\t\t\t\tallPresent = false\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !allPresent {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tincluded = append(included, compareExperimentData{ID: id, Pipeline: info.Name, Metrics: metrics})\r\n\t\t}\r\n\t}\r\n\r\n\tnormalized := make([]map[string]float64, len(included))\r\n\tfor i := range normalized {\r\n\t\tnormalized[i] = make(map[string]float64)\r\n"]
[5086.698967, "o", "\t}\r\n\tfor _, m := range sharedMetrics {\r\n\t\tmin := math.Inf(1)\r\n\t\tmax := math.Inf(-1)\r\n\t\tfor _, exp := range included {\r\n\t\t\tv := exp.Metrics[m]\r\n\t\t\tif v < min {\r\n\t\t\t\tmin = v\r\n\t\t\t}\r\n\t\t\tif v > max {\r\n\t\t\t\tmax = v\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor i, exp := range included {\r\n\t\t"]
[5086.69904, "o", "\tvar norm float64\r\n\t\t\tif max == min {\r\n\t\t\t\tnorm = 0.5\r\n\t\t\t} else {\r\n\t\t\t\tnorm = (exp.Metrics[m] - min) / (max - min)\r\n\t\t\t}\r\n\t\t\tif metricObjective[m] == \"minimize\" {\r\n\t\t\t\tnorm = 1 - norm\r\n"]
[5086.69911, "o", "\t\t\t}\r\n\t\t\tnormalized[i][m] = norm\r\n\t\t}\r\n\t}\r\n\r\n\tcomposite := make([]float64, len(included))\r\n\tfor i := range included {\r\n\t\tsum := 0.0\r\n\t\tfor _, m := range sharedMetrics {\r\n\t\t\tsum += normalized[i][m]\r\n\t\t}\r\n\t\tif len(sharedMetrics) > 0 {\r\n"]
[5086.699181, "o", "\t\t\tcomposite[i] = sum / float64(len(sharedMetrics))\r\n\t\t}\r\n\t}\r\n\r\n\tdepth := make([]int, len(included))\r\n\tremaining := make([]int, len(included))\r\n\tfor i := range remaining {\r\n\t\tremaining[i] = i\r\n\t}\r\n"]
[5086.69925, "o", "\tcurrentDepth := 0\r\n\tfor len(remaining) > 0 {\r\n\t\tnonDom := []int{}\r\n\t\tfor _, i := range remaining {\r\n\t\t\tdominated := false\r\n\t\t\tfor _, j := range remaining {\r\n\t\t\t\tif i == j {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t"]
[5086.699319, "o", "\t\tif dominates(normalized[j], normalized[i], sharedMetrics) {\r\n\t\t\t\t\tdominated = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !dominated {\r\n\t\t\t\tnonDom = append(nonDom, i)\r\n\t\t\t}\r\n\t\t}\r\n\t"]
[5086.699394, "o", "\tif len(nonDom) == 0 {\r\n\t\t\tfor _, i := range remaining {\r\n\t\t\t\tdepth[i] = currentDepth\r\n\t\t\t}\r\n\t\t\tbreak\r\n\t\t}\r\n\t\tfor _, i := range nonDom {\r\n\t\t\tdepth[i] = currentDepth\r\n\t\t}\r\n\t\tnewRemaining := make([]int, 0, len(remaining)-len(nonDom))\r\n"]
[5086.699466, "o", "\t\tfor _, i := range remaining {\r\n\t\t\tfound := false\r\n\t\t\tfor _, j := range nonDom {\r\n\t\t\t\tif i == j {\r\n\t\t\t\t\tfound = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n"]
[5086.699544, "o", "\t\t\t}\r\n\t\t\tif !found {\r\n\t\t\t\tnewRemaining = append(newRemaining, i)\r\n\t\t\t}\r\n\t"]
