[3632.564579, "o", "\u001b[32m\u001b[K861\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdata, err := os.ReadFile(stageStatePath(experimentID, stageName))\r\n\u001b[32m\u001b[K862\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K863\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn nil, err\r\n\u001b[32m\u001b[K864\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K865\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar st StageState\r\n\u001b[32m\u001b[K866\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := json.Unmarshal(data, &st); err != nil {\r\n\u001b[32m\u001b[K867\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn nil, err\r\n\u001b[32m\u001b[K868\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K869\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn &st, nil\r\n\u001b[32m\u001b[K870\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K871\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K872\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc writeStageState(experimentID, stageName string, st *StageState) error {\r\n\u001b[32m\u001b[K873\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := os.MkdirAll(stateDir(experimentID), 0755); err != nil {\r\n"]
[3632.564646, "o", "\u001b[32m\u001b[K874\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn err\r\n\u001b[32m\u001b[K875\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K876\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdata, err := json.MarshalIndent(st, \"\", \"  \")\r\n\u001b[32m\u001b[K877\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K878\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn err\r\n\u001b[32m\u001b[K879\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K880\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn os.WriteFile(stageStatePath(experimentID, stageName), data, 0644)\r\n"]
