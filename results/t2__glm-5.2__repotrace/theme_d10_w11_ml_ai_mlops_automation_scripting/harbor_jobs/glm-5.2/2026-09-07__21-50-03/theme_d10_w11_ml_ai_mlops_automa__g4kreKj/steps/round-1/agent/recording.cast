[1998.487454, "o", "   750\t\r\n   751\t    completed := make(map[string]bool)\r\n   752\t    remaining := make(map[string]bool)\r\n   753\t    for _, stage := range p.Stages {\r\n   754\t        remaining[stage.Name] = true\r\n   755\t    }\r\n   756\t\r\n   757\t    var groups [][]string\r\n   758\t    for len(remaining) > 0 {\r\n   759\t        var ready []string\r\n   760\t        for name := range remaining {\r\n   761\t            ok := true\r\n   762\t            for _, dep := range stageMap[name].DependsOn {\r\n   763\t                if !completed[dep] {\r\n   764\t                    ok = false\r\n   765\t                    break\r\n   766\t                }\r\n   767\t            }\r\n   768\t            if ok {\r\n   769\t                ready = append(ready, name)\r\n   770\t            }\r\n   771\t        }\r\n   772\t        sort.Strings(ready)\r\n"]
[1998.487513, "o", "   773\t        if len(ready) == 0 {\r\n   774\t            return nil, fmt.Errorf(\"circular dependency detected among stages: %v\", sortedKeys(remaining))\r\n"]
[1998.487569, "o", "   775\t        }\r\n   776\t        groups = append(groups, ready)\r\n   777\t        for _, name := range ready {\r\n   778\t            completed[name] = true\r\n   779\t            delete(remaining, name)\r\n   780\t        }\r\n   781\t    }\r\n   782\t    return groups, nil\r\n   783\t}\r\n   784\t\r\n   785\tfunc parameterCombinations(p *Pipeline) []map[string]interface{} {\r\n   786\t    if len(p.Parameters) == 0 {\r\n"]
