[6294.638257, "o", "type Pipeline struct {\r\n\tName       string\r\n\tVersion    string\r\n\tParameters []Parameter\r\n\tStages     []Stage\r\n}\r\n\r\ntype Parameter struct {\r\n"]
[6294.638352, "o", "\tName   string\r\n\tValues []interface{}\r\n}\r\n\r\ntype Stage struct {\r\n\tName      string\r\n\tCommand   string\r\n\tDependsOn []string\r\n\tEnv       map[string]string\r\n\tMetrics   []Metric\r\n\tRetry     *Retry\r\n\tCondition *Condition\r\n\tOutputs   []ArtifactRef\r\n"]
[6294.63843, "o", "\tInputs    []ArtifactRef\r\n}\r\n\r\ntype Metric struct {\r\n\tName      string\r\n\tObjective string\r\n}\r\n\r\ntype Retry struct {\r\n\tMaxAttempts    int\r\n\t"]
[6294.638497, "o", "BackoffSeconds float64\r\n}\r\n\r\ntype Condition struct {\r\n\tMetric    string\r\n\tOperator  string\r\n\tThreshold float64\r\n}\r\n\r\n"]
[6294.638554, "o", "type ArtifactRef struct {\r\n\tPath string\r\n\tType string\r\n}\r\n\r\ntype MetricData struct {\r\n\tName  string  `json:\"name\"`\r\n\tValue float64 `json:\"value\"`\r\n}\r\n\r\n"]
[6294.638614, "o", "type StageState struct {\r\n\tName      string       `json:\"name\"`\r\n\tStatus    string       `json:\"status\"`\r\n\tExitCode  int          `json:\"exit_code\"`\r\n\tMetrics   []MetricData `json:\"metrics\"`\r\n\tStartTime string       `json:\"start_time\"`\r\n\tEndTime   string       `json:\"end_time\"`\r\n"]
[6294.638681, "o", "\tRetries   int          `json:\"retries\"`\r\n}\r\n\r\ntype ArtifactEntry struct {\r\n\tExperimentID string `json:\"experiment_id\"`\r\n\tStageName    string `json:\"stage_name\"`\r\n\tPath         string `json:\"path\"`\r\n\tHash         string `json:\"hash\"`\r\n"]
[6294.638745, "o", "\tSize         int64  `json:\"size\"`\r\n}\r\n\r\ntype ArtifactIndex struct {\r\n\tEntries []ArtifactEntry `json:\"entries\"`\r\n}\r\n\r\ntype yamlLine struct {\r\n\tindent  int\r\n\tcontent string\r\n}\r\n"]
[6294.638816, "o", "\r\nfunc loadPipeline(path string) (*Pipeline, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tv, err := parseYAML(data)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}"]
[6294.63888, "o", "\r\n\treturn mapToPipeline(v)\r\n}\r\n\r\nfunc parseYAML(data []byte) (interface{}, error) {\r\n\tvar lines []yamlLine\r\n\tfor _, raw := range strings.Split(string(data), \"\\n\") {\r\n\t\traw = strings.TrimRight(raw, \"\\r\")\r\n\t"]
[6294.638946, "o", "\ttrimmed := strings.TrimSpace(raw)\r\n\t\tif trimmed == \"\" || strings.HasPrefix(trimmed, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tindent := 0\r\n"]
[6294.639008, "o", "\t\tfor indent < len(raw) && raw[indent] == ' ' {\r\n\t\t\tindent++\r\n\t\t}\r\n\t\tcontent := strings.TrimRight(raw[indent:], \" \")\r\n\t\tlines = append(lines, yamlLine{indent: indent, content: content})\r\n"]
[6294.639072, "o", "\t}\r\n\tif len(lines) == 0 {\r\n\t\treturn nil, nil\r\n\t}\r\n\tv, idx := parseBlock(lines, 0, 0)\r\n\tif idx < len(lines) {\r\n\t\treturn nil, fmt.Errorf(\"unexpected YAML structure at line: %q\", lines[idx].content)\r\n\t}\r\n"]
[6294.63913, "o", "\treturn v, nil\r\n}\r\n\r\nfunc parseBlock(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n\tif idx >= len(lines) || lines[idx].indent < indent {\r\n\t\treturn nil, idx\r\n\t}\r\n\tif strings.HasPrefix(lines[idx].content, \"- \") || lines[idx].content == \"-\" {\r\n\t"]
[6294.639193, "o", "\treturn parseSequence(lines, idx, indent)\r\n"]
[6294.640016, "o", "\u001b[?2004h"]
