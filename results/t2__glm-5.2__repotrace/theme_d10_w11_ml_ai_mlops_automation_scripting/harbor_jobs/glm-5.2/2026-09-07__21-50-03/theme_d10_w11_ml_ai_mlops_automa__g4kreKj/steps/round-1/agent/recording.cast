[2149.55904, "o", "   687\tfunc validatePipeline(p *Pipeline) []string {\r\n   688\t    var errs []string\r\n   689\t    names := make(map[string]int)\r\n   690\t    stageSet := make(map[string]bool)\r\n   691\t    stageMap := make(map[string]Stage)\r\n   692\t\r\n   693\t    for i, stage := range p.Stages {\r\n   694\t        if stage.Name == \"\" {\r\n"]
[2149.559171, "o", "   695\t            errs = append(errs, fmt.Sprintf(\"stage %d: missing required field name\", i))\r\n   696\t        }\r\n   697\t        if stage.Command == \"\" {\r\n   698\t            errs = append(errs, fmt.Sprintf(\"stage %d: missing required field command\", i))\r\n   699\t        }\r\n   700\t        if stage.Name != \"\" {\r\n   701\t            if prev, ok := names[stage.Name]; ok {\r\n   702\t                errs = append(errs, fmt.Sprintf(\"duplicate stage name: %s (stages %d and %d)\", stage.Name, prev, i))\r\n   703\t            } else {\r\n   704\t                names[stage.Name] = i\r\n   705\t            }\r\n   706\t            stageSet[stage.Name] = true\r\n   707\t            stageMap[stage.Name] = stage\r\n   708\t        }\r\n   709\t    }\r\n   710\t\r\n   711\t    for _, stage := range p.Stages {\r\n   712\t        for _, dep := range stage.DependsOn {\r\n   713\t            if !stageSet[dep] {\r\n   714\t                errs = append(errs, fmt.Sprintf(\"stage %q depends on undefined stage %q\", stage.Name, dep))\r\n   715\t            }\r\n   716\t        }"]
[2149.559261, "o", "\r\n   717\t    }\r\n   718\t\r\n   719\t    for _, stage := range p.Stages {\r\n   720\t        if stage.Name == \"\" {\r\n   721\t            continue\r\n   722\t        }\r\n   723\t        state := make(map[string]int)\r\n   724\t        var check func(name string)\r\n   725\t        check = func(name string) {\r\n   726\t            state[name] = 1\r\n   727\t            for _, dep := range stageMap[name].DependsOn {\r\n   728\t                if !stageSet[dep] {\r\n   729\t                    continue\r\n   730\t                }\r\n"]
[2149.559326, "o", "   731\t                if state[dep] == 1 {\r\n   732\t                    errs = append(errs, fmt.Sprintf(\"circular dependency detected involving stage: %s\", name))\r\n   733\t                } else if state[dep] == 0 {\r\n   734\t                    check(dep)\r\n   735\t                }\r\n   736\t            }\r\n   737\t            state[name] = 2\r\n   738\t        }\r\n"]
[2149.559448, "o", "   739\t        check(stage.Name)\r\n   740\t    }\r\n   741\t\r\n   742\t    return errs\r\n   743\t}\r\n   744\t\r\n   745\tfunc topologicalGroups(p *Pipeline) ([][]string, error) {\r\n   746\t    stageMap := make(map[string]Stage)\r\n   747\t    for _, stage := range p.Stages {\r\n   748\t        stageMap[stage.Name] = stage\r\n   749\t    }\r\n   750\t\r\n   751\t    completed := make(map[string]bool)\r\n   752\t    remaining := make(map[string]bool)\r\n   753\t    for _, stage := range p.Stages {\r\n   754\t        remaining[stage.Name] = true\r\n   755\t    }\r\n   756\t\r\n   757\t    var groups [][]string\r\n   758\t    for len(remaining) > 0 {\r\n   759\t        var ready []string\r\n   760\t        for name := range remaining {\r\n"]
[2149.559518, "o", "   761\t            ok := true\r\n   762\t            for _, dep := range stageMap[name].DependsOn {\r\n   763\t                if !completed[dep] {\r\n   764\t                    ok = false\r\n   765\t                    break\r\n   766\t                }\r\n   767\t            }\r\n   768\t            if ok {\r\n   769\t                ready = append(ready, name)\r\n   770\t            }\r\n   771\t        }\r\n   772\t        sort.Strings(ready)\r\n"]
[2149.559582, "o", "   773\t        if len(ready) == 0 {\r\n   774\t            return nil, fmt.Errorf(\"circular dependency detected among stages: %v\", sortedKeys(remaining))\r\n   775\t        }\r\n   776\t        groups = append(groups, ready)\r\n   777\t        for _, name := range ready {\r\n   778\t            completed[name] = true\r\n   779\t            delete(remaining, name)\r\n   780\t        }\r\n   781\t    }\r\n   782\t    return groups, nil\r\n   783\t}\r\n"]
[2149.559638, "o", "   784\t\r\n   785\tfunc parameterCombinations(p *Pipeline) []map[string]interface{} {\r\n"]
