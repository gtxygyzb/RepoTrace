[7090.730695, "o", "   486\t\tinner := strings.TrimSpace(s[1 : len(s)-1])\r\n   487\t\tif inner == \"\" {\r\n   488\t\t\treturn []interface{}{}\r\n   489\t\t}\r\n   490\t\tparts := splitCommas(inner)\r\n   491"]
[7090.73077, "o", "\t\tout := make([]interface{}, 0, len(parts))\r\n   492\t\tfor _, p := range parts {\r\n   493\t\t\tout = append(out, parseScalar(strings.TrimSpace(p)))\r\n   494\t\t}\r\n   495\t\treturn out\r\n   496\t}\r\n   497\t\r\n   498\tfunc parseInlineMap(s string) interface{} {\r\n   499\t\tinner := strings.TrimSpace(s[1 : len(s)-1])\r\n   500\t\tif inner == \"\" {\r\n   501\t\t\treturn map[string]interface{}{}\r\n   502\t\t}\r\n   503\t\tparts := splitCommas(inner)\r\n   504\t\tm := map[string]interface{}{}\r\n   505\t\tfor _, p := range parts {\r\n   506\t\t\tkey, value, ok := splitKeyValue(strings.TrimSpace(p))\r\n   507\t\t\tif ok {\r\n   508\t\t\t\tm[key] = parseScalar(value)\r\n   509\t\t\t}\r\n"]
[7090.730845, "o", "   510\t\t}\r\n   511\t\treturn m\r\n   512\t}\r\n   513\t\r\n   514\tfunc splitCommas(s string) []string {\r\n   515\t\tvar parts []string\r\n"]
[7090.730919, "o", "   516\t\tinQuote := false\r\n   517\t\tquoteChar := byte(0)\r\n   518\t\tdepth := 0\r\n   519\t\tstart := 0\r\n   520\t\tfor i := 0; i < len(s); i++ {\r\n"]
