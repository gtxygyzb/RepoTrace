[3297.660916, "o", "\t\t\tfor _, m := range stage.Metrics {\r\n  1239\t\t\t\t\tif m.Objective != \"minimize\" && m.Objective != \"maximize\" {\r\n  1240\t\t\t\t\t\tcontinue\r\n  1241\t\t\t\t\t}\r\n  1242\t\t\t\t\tif existing, ok := pm[m.Name]; ok && existing != m.Objective {\r\n  1243\t\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: conflicting objective for metric %s in pipeline %s\\n\", m.Name, info.Name)\r\n  1244\t\t\t\t\t\treturn 1"]
