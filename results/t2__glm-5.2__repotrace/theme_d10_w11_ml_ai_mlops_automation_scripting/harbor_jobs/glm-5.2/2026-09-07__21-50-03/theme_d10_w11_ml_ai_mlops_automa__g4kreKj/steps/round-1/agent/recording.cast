[6294.360855, "o", "func cmdReport(args []string) int {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe report <pipeline.yaml>\")\r\n\t\treturn 1\r\n\t}\r\n\tp, err := loadPipeline(args[0])\r\n"]
[6294.360974, "o", "\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tif errs := validatePipeline(p); len(errs) > 0 {\r\n\t\tfor _, e := range errs {\r\n\t\t\tfmt.Fprintln(os.Stderr, e)\r\n\t\t}\r\n\t\treturn 1\r\n\t}\r\n\treturn reportPipeline(p)\r\n}\r\n\r\n"]
[6294.361784, "o", "\u001b[?2004h"]
