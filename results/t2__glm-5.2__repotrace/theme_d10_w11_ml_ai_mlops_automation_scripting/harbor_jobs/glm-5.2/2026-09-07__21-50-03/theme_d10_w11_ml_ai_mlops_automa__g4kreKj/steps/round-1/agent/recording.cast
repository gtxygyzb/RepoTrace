[2205.599829, "o", "     1\tname: text-sentiment-analysis\r\n     2\tversion: \"1.0\"\r\n     3\t\r\n     4\tparameters:\r\n     5\t  embedding_dim:\r\n     6\t    type: grid\r\n     7\t    values: [128, 256]\r\n     8\t  dropout:\r\n     9\t    type: grid\r\n"]
[2205.599994, "o", "    10\t    values: [0.1, 0.3]\r\n    11\t\r\n    12\tstages:\r\n    13\t  - name: preprocess\r\n    14\t    command: \"./stages/validate_data.sh\"\r\n    15\t    inputs:\r\n    16\t      - path: \"data/sample\"\r\n    17\t        type: directory\r\n    18\t    outputs:\r\n    19\t      - path: \"data/validated\"\r\n    20\t        type: directory\r\n    21\t    metrics:\r\n    22\t      - name: num_samples\r\n    23\t        objective: report\r\n    24\t      - name: corruption_rate\r\n    25\t        objective: minimize\r\n    26\t\r\n    27\t  - name: train\r\n    28\t    command: \"./stages/train_model.sh\"\r\n    29\t    depends_on: [\"preprocess\"]\r\n    30\t    outputs:\r\n    31\t      - path: \"models/checkpoint.bin\"\r\n    32\t        type: file\r\n"]
[2205.600097, "o", "    33\t    env:\r\n    34\t      LEARNING_RATE: \"0.001\"\r\n    35\t      OPTIMIZER: \"adam\"\r\n    36\t      BATCH_SIZE: \"${embedding_dim}\"\r\n    37\t      DROPOUT: \"${dropout}\"\r\n    38\t    metrics:\r\n    39\t      - name: train_loss\r\n    40\t        objective: minimize\r\n    41\t      - name: train_accuracy\r\n    42\t        objective: maximize\r\n    43\t\r\n    44\t  - name: evaluate\r\n    45\t    command: \"./stages/evaluate_model.sh\"\r\n    46\t    depends_on: [\"train\"]\r\n    47\t    outputs:\r\n"]
[2205.600194, "o", "    48\t      - path: \"reports/evaluation.json\"\r\n    49\t        type: file\r\n    50\t    metrics:\r\n    51\t      - name: eval_accuracy\r\n    52\t        objective: maximize\r\n    53\t      - name: eval_f1\r\n    54\t        objective: maximize\r\n    55\t      - name: eval_loss\r\n    56\t        objective: minimize\r\n"]
[2205.600689, "o", "\u001b[?2004h"]
[2205.600781, "o", "root@n30009:/app# "]
[2225.071124, "i", "cat stages/evaluate_model.sh\n"]
[2225.071399, "o", "cat stages/evaluate_model.sh\r\n\u001b[?2004l\r"]
[2225.073714, "o", "#!/bin/bash\r\n# Evaluates the trained model\r\nmkdir -p reports\r\nif [ ! -f \"models/checkpoint.bin\" ]; then\r\n    echo \"ERROR: No model checkpoint found\" >&2\r\n    exit 1\r\nfi\r\n\r\nMODEL_INFO=$(cat models/checkpoint.bin)\r\nLR=$(echo \"$MODEL_INFO\" | cut -d_ -f2)\r\nOPT=$(echo \"$MODEL_INFO\" | cut -d_ -f3)\r\nBS=$(echo \"$MODEL_INFO\" | cut -d_ -f4)\r\nif [ \"$OPT\" = \"adam\" ]; then OPT_VAL=1; else OPT_VAL=0; fi\r\n\r\nEVAL_ACC=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.82 + ($OPT_VAL * 0.06) - ($BS / 5000.0) - ($LR * 2)}\")\r\nEVAL_F1=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.78 + ($OPT_VAL * 0.05) - ($BS / 6000.0) - ($LR * 1.5)}\")\r\nEVAL_LOSS=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.3 - ($OPT_VAL * 0.04) + ($BS / 3000.0) + ($LR * 5)}\")\r\n\r\necho \"{\\\"eval_accuracy\\\": ${EVAL_ACC}, \\\"eval_f1\\\": ${EVAL_F1}}\" > reports/evaluation.json\r\necho \"{\\\"metric\\\": \\\"eval_accuracy\\\", \\\"value\\\": ${EVAL_ACC}}\"\r\necho \"{\\\"metric\\\": \\\"eval_f1\\\", \\\"value\\\": ${EVAL_F1}}\"\r\necho \"{\\\"metric\\\": \\\"eval_loss\\\", \\\"value\\\": ${EVAL_LOSS}}\"\r\n"]
[2225.07409, "o", "\u001b[?2004h"]
[2225.07418, "o", "root@n30009:/app# "]
[2225.344983, "i", "cat stages/export_model.sh\n"]
[2225.345251, "o", "cat stages/export_model.sh\r\n\u001b[?2004l\r"]
[2225.347397, "o", "#!/bin/bash\r\n# Exports model to deployment format\r\nmkdir -p models/exported\r\nif [ ! -f \"models/checkpoint.bin\" ]; then\r\n    echo \"ERROR: No model checkpoint found\" >&2\r\n    exit 1\r\nfi\r\ncp models/checkpoint.bin models/exported/model.onnx\r\necho \"{\\\"metric\\\": \\\"export_size_mb\\\", \\\"value\\\": 0.001}\"\r\n"]
[2225.347847, "o", "\u001b[?2004h"]
