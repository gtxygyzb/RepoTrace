[6294.079739, "o", "func main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe <command> [args...]\")\r\n"]
[6294.079757, "o", "\t\tfmt.Fprintln(os.Stderr, \"Commands: validate, plan, run, report, artifacts, compare, sweep\")\r\n"]
[6294.079834, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n\tcase \"validate\":\r\n\t\tos.Exit(cmdValidate(args))\r\n\tcase \"plan\":\r\n\t\tos.Exit(cmdPlan(args))\r\n\tcase \"run\":\r\n\t\tos.Exit(cmdRun(args))\r\n\tcase \"report\":\r\n\t\tos.Exit(cmdReport(args))\r\n\tcase \"artifacts\":\r\n\t\tos.Exit(cmdArtifacts(args))\r\n"]
[6294.079918, "o", "\tcase \"compare\":\r\n\t\tos.Exit(cmdCompare(args))\r\n\tcase \"sweep\":\r\n\t\tos.Exit(cmdSweep(args))\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"error: command %q is not implemented\\n\", cmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc cmdValidate(args []string) int {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe validate <pipeline.yaml>\")\r\n"]
[6294.079977, "o", "\t\treturn 1\r\n"]
[6294.08003, "o", "\t}\r\n\tp, err := loadPipeline(args[0])\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\terrs := validatePipeline(p)\r\n\tif len(errs) > 0 {\r\n\t\tfor _, e := range errs {"]
[6294.080045, "o", "\r\n\t\t\tfmt.Println(e)\r\n\t\t}\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n"]
