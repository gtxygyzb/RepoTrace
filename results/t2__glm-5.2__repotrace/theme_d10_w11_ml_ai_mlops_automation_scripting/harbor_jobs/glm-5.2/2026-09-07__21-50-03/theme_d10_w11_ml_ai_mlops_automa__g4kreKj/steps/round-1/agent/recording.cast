[5210.960088, "o", "  1903\t\t\t\t\tcontinue\r\n  1904\t\t\t\t}\r\n  1905\t\t\t\tif bTied {\r\n  1906\t\t\t\t\ttiedSecond++\r\n  1907\t\t\t\t\tcontinue\r\n  1908\t\t\t\t}\r\n  1909\t\t\t\tif (da > 0 && db > 0) || (da < 0 && db < 0) {\r\n  1910\t\t\t\t\tconcordant++\r\n  1911\t\t\t\t} else {\r\n  1912\t\t\t\t\tdiscordant++\r\n  1913\t\t\t\t}\r\n  1914"]
[5210.960164, "o", "\t\t\t}\r\n  1915\t\t}\r\n  1916\t\tdenom := math.Sqrt(float64((concordant + discordant + tiedFirst) * (concordant + discordant + tiedSecond)))\r\n  1917\t\tif denom == 0 {\r\n  1918\t\t\treturn nil\r\n  1919\t\t}\r\n  1920\t\t"]
[5210.960226, "o", "tau := float64(concordant-discordant) / denom\r\n  1921\t\treturn &tau\r\n  1922\t}\r\n  1923\t\r\n  1924\tfunc round4(f float64) float64 {\r\n  1925\t\tf = math.Round(f*10000) / 10000\r\n  1926\t\tif f == 0 {\r\n  1927\t\t\tf = 0\r\n  1928\t\t}\r\n  1929\t\treturn f\r\n  1930\t}\r\n  1931\t\r\n  1932\tfunc filterMetrics(metrics map[string]float64, shared []string) map[string]float64 {\r\n  1933\t\tout := make(map[string]float64, len(shared))\r\n  1934\t\tfor _, name := range shared {\r\n"]
[5210.960284, "o", "  1935\t\t\tout[name] = metrics[name]\r\n  1936\t\t}\r\n  1937\t\treturn out\r\n  1938\t}\r\n"]
