[3976.112129, "i", "python3 - <<'PY'\nimport json, math, subprocess\nout = subprocess.check_output(['./mlpipe','sweep','pipelines/image_classifier.yaml','--metric','train_loss','--param','learning_rate'])\nd = json.loads(out)\nfor g in d['groups']:\n    vals = [0.492,0.512,0.528,0.544] if g['value']=='0.001' else [0.392,0.412,0.428,0.444] if g['value']=='0.01' else [0.292,0.312,0.328,0.344]\n    mean=sum(vals)/len(vals)\n    std=math.sqrt(sum((x-mean)**2 for x in vals)/(len(vals)-1))\n    print(g['value'], round(mean,4), round(std,4), g['mean'], g['std'])\nPY\n"]
