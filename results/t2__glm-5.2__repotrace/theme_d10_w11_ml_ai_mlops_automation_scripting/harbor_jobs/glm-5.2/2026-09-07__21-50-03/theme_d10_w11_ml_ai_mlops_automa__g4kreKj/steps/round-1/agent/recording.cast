[8252.154148, "o", "    22\tfunc main() {\r\n    23\t\tif len(os.Args) < 2 {\r\n    24\t\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe <command> [args...]\")\r\n    25\t\t\tfmt.Fprintln(os.Stderr, \"Commands: validate, plan, run, report, artifacts, compare, sweep, export\")\r\n    26\t\t\tos.Exit(1)\r\n    27\t\t}\r\n    28"]
[8252.154263, "o", "\t\r\n    29\t\tcmd := os.Args[1]\r\n    30\t\targs := os.Args[2:]\r\n    31\t\r\n    32\t\tswitch cmd {\r\n    33\t\tcase \"validate\":\r\n    34\t\t\tos.Exit(cmdValidate(args))\r\n    35\t\tcase \"plan\":\r\n    36\t\t\tos.Exit(cmdPlan(args))\r\n    37\t\tcase \"run\":\r\n    38\t\t\tos.Exit(cmdRun(args))\r\n    39\t\tcase \"report\":\r\n    40\t\t\tos.Exit(cmdReport(args))\r\n    41\t\tcase \"export\":\r\n    42\t\t\t"]
[8252.154328, "o", "os.Exit(cmdExport(args))\r\n    43\t\tcase \"artifacts\":\r\n    44\t\t\tos.Exit(cmdArtifacts(args))\r\n    45\t\tcase \"compare\":\r\n    46\t\t\tos.Exit(cmdCompare(args))\r\n    47\t\tcase \"sweep\":\r\n    48\t\t\tos.Exit(cmdSweep(args))\r\n    49\t\tdefault:\r\n"]
[8252.154388, "o", "    50\t\t\tfmt.Fprintf(os.Stderr, \"error: command %q is not implemented\\n\", cmd)\r\n    51\t\t\tos.Exit(1)\r\n    52\t\t}\r\n    53\t}\r\n    54\t\r\n"]
