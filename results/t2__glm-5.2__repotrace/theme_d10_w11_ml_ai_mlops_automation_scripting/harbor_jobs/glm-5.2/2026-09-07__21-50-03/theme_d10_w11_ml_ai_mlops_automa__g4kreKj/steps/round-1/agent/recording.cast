[3632.264613, "o", "\u001b[32m\u001b[K625\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif v == nil {\r\n\u001b[32m\u001b[K626\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn \"\"\r\n\u001b[32m\u001b[K627\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K628\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tswitch x := v.(type) {\r\n\u001b[32m\u001b[K629\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase string:\r\n\u001b[32m\u001b[K630\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn x\r\n\u001b[32m\u001b[K631\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase int:\r\n\u001b[32m\u001b[K632\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn strconv.Itoa(x)\r\n\u001b[32m\u001b[K633\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase float64:\r\n\u001b[32m\u001b[K634\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn formatFloat(x)\r\n\u001b[32m\u001b[K635\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase bool:\r\n\u001b[32m\u001b[K636\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn strconv.FormatBool(x)\r\n\u001b[32m\u001b[K637\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefault:\r\n\u001b[32m\u001b[K638\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn fmt.Sprint(x)\r\n\u001b[32m\u001b[K639\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K640\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
