[6287.581665, "o", "\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KExperimentID\u001b[m\u001b[K string `json:\"\u001b[01;31m\u001b[Kexperiment_id\u001b[m\u001b[K\"`\r\n"]
[6287.582035, "o", "\u001b[32m\u001b[K948\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tMaxComposite float64 `json:\"max_\u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K\"`\r\n\u001b[32m\u001b[K955\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tCompositeScores   map[string]float64            `json:\"\u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K_scores\"`\r\n"]
[6287.582174, "o", "\u001b[32m\u001b[K956\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KNormalize\u001b[m\u001b[KdMetrics map[string]map[string]float64 `json:\"\u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd_metrics\"`\r\n\u001b[32m\u001b[K968\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KNormalize\u001b[m\u001b[KdMetrics: map[string]map[string]float64{},\r\n"]
[6287.58227, "o", "\u001b[32m\u001b[K1023\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd := make([]map[string]float64, len(out.Experiments))\r\n\u001b[32m\u001b[K1025\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[i] = make(map[string]float64)\r\n"]
[6287.582334, "o", "\u001b[32m\u001b[K1041\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[i][m] = norm\r\n\u001b[32m\u001b[K1044\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tout.\u001b[01;31m\u001b[KNormalize\u001b[m\u001b[KdMetrics[exp.ID] = normOut\r\n\u001b[32m\u001b[K1047\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K := make([]float64, len(out.Experiments))\r\n\u001b[32m\u001b[K1049\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif len(\u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[i]) == 0 {\r\n\u001b[32m\u001b[K1050\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[i] = 0\r\n"]
[6287.582402, "o", "\u001b[32m\u001b[K1054\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tif norm, ok := \u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[i][m]; ok {\r\n\u001b[32m\u001b[K1058\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[i] = sum / float64(len(\u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[i]))\r\n\u001b[32m\u001b[K1060\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tout.CompositeScores[out.Experiments[i].ID] = round4(\u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[i])\r\n\u001b[32m\u001b[K1100\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif norm, ok := \u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[i][m]; ok {\r\n"]
[6287.582461, "o", "\u001b[32m\u001b[K1133\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tif norm, ok := \u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[i][mm]; ok {\r\n\u001b[32m\u001b[K1165\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tscore := round4(\u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[i])\r\n"]
[6287.58267, "o", "\u001b[32m\u001b[K1664\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KExperimentID\u001b[m\u001b[K: experimentID,\r\n"]
[6287.582737, "o", "\u001b[32m\u001b[K1813\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd := make([]map[string]float64, len(included))\r\n\u001b[32m\u001b[K1814\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor i := range \u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd {\r\n"]
[6287.582797, "o", "\u001b[32m\u001b[K1815\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[i] = make(map[string]float64)\r\n\u001b[32m\u001b[K1839\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[i][m] = norm\r\n\u001b[32m\u001b[K1843\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K := make([]float64, len(included))\r\n\u001b[32m\u001b[K1847\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tsum += \u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[i][m]\r\n\u001b[32m\u001b[K1850\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[i] = sum / float64(len(sharedMetrics))\r\n"]
[6287.582866, "o", "\u001b[32m\u001b[K1868\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif dominates(\u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[j], \u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[i], sharedMetrics) {\r\n\u001b[32m\u001b[K1908\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif \u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[order[a]] != \u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[order[b]] {\r\n\u001b[32m\u001b[K1909\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn \u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[order[a]] > \u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[order[b]]\r\n"]
[6287.582947, "o", "\u001b[32m\u001b[K1917\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif currentRank == 0 || \u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[idx] != prevComposite {\r\n\u001b[32m\u001b[K1919\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tprevComposite = \u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[idx]\r\n\u001b[32m\u001b[K1928\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KNormalize\u001b[m\u001b[Kd      map[string]float64 `json:\"\u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd\"`\r\n\u001b[32m\u001b[K1929\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tCompositeScore  float64            `json:\"\u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K_score\"`\r\n"]
[6287.583028, "o", "\u001b[32m\u001b[K1931\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tIs\u001b[01;31m\u001b[KPareto\u001b[m\u001b[KOptimal bool               `json:\"is_\u001b[01;31m\u001b[Kpareto\u001b[m\u001b[K_optimal\"`\r\n\u001b[32m\u001b[K1940\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KNormalize\u001b[m\u001b[Kd:      \u001b[01;31m\u001b[Knormalize\u001b[m\u001b[Kd[idx],\r\n"]
[6287.583094, "o", "\u001b[32m\u001b[K1941\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tCompositeScore:  \u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[idx],\r\n\u001b[32m\u001b[K1943\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tIs\u001b[01;31m\u001b[KPareto\u001b[m\u001b[KOptimal: depth[idx] == 0,\r\n\u001b[32m\u001b[K1948\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kpareto\u001b[m\u001b[KFrontier := []string{}\r\n\u001b[32m\u001b[K1951\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kpareto\u001b[m\u001b[KFrontier = append(\u001b[01;31m\u001b[Kpareto\u001b[m\u001b[KFrontier, exp.ID)\r\n"]
[6287.583163, "o", "\u001b[32m\u001b[K1954\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tsort.Strings(\u001b[01;31m\u001b[Kpareto\u001b[m\u001b[KFrontier)\r\n\u001b[32m\u001b[K1974\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kpareto\u001b[m\u001b[KCount := 0\r\n\u001b[32m\u001b[K1980\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kpareto\u001b[m\u001b[KCount++\r\n"]
[6287.583229, "o", "\u001b[32m\u001b[K1986\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tCompositeScore float64 `json:\"\u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K_score\"`\r\n\u001b[32m\u001b[K1991\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tbest = &bestExperiment{ID: included[idx].ID, Pipeline: included[idx].Pipeline, CompositeScore: \u001b[01;31m\u001b[Kcomposite\u001b[m\u001b[K[idx]}\r\n\u001b[32m\u001b[K1995\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KPareto\u001b[m\u001b[KCount    int             `json:\"\u001b[01;31m\u001b[Kpareto\u001b[m\u001b[K_count\"`\r\n\u001b[32m\u001b[K2000\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KPareto\u001b[m\u001b[KCount:    \u001b[01;31m\u001b[Kpareto\u001b[m\u001b[KCount,\r\n\u001b[32m\u001b[K2008\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KPareto\u001b[m\u001b[KFrontier []string                  `json:\"\u001b[01;31m\u001b[Kpareto\u001b[m\u001b[K_frontier\"`\r\n\u001b[32m\u001b[K2012\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KPareto\u001b[m\u001b[KCount    int             `json:\"\u001b[01;31m\u001b[Kpareto\u001b[m\u001b[K_count\"`\r\n"]
[6287.583294, "o", "\u001b[32m\u001b[K2020\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KPareto\u001b[m\u001b[KFrontier: \u001b[01;31m\u001b[Kpareto\u001b[m\u001b[KFrontier,\r\n"]
