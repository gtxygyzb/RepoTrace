[6216.272256, "o", "\r\nfunc saveArtifactIndex(idx *ArtifactIndex) error {\r\n\tif err := os.MkdirAll(filepath.Dir(artifactsIndexPath()), 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdata, err := json.MarshalIndent(idx, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(artifactsIndexPath(), data, 0644)\r\n}\r\n\r\nfunc artifactsList() int {\r\n\tidx := loadArtifactIndex()\r\n\tenc := json.NewEncoder(os.Stdout)\r\n"]
[6216.27241, "o", "\tenc.SetIndent(\"\", \"  \")\r\n\tif err := enc.Encode(idx); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc artifactsGC(p *Pipeline) int {\r\n\texpected := make(map[string]bool)\r\n\tfor _, combo := range parameterCombinations(p) {\r\n\t\texpected[experimentID(combo)] = true\r\n\t}\r\n\tentries, err := os.ReadDir(filepath.Join(\".mlpipe\", \"state\"))\r\n\tif err != nil {\r\n\t\treturn 0\r\n\t}\r\n\tfor _, entry := range entries {\r\n\t\tif !expected[entry.Name()] {\r\n\t\t\t_ = os.RemoveAll(filepath.Join(\".mlpipe\", \"state\", entry.Name()))\r\n\t\t}\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc reportPipeline(p *Pipeline) int {\r\n\ttype reportExperiment struct {\r\n\t\tID      string             `json:\"id\"`\r\n"]
[6216.272494, "o", "\t\tMetrics map[string]float64 `json:\"metrics\"`\r\n\t\tStages  []StageState       `json:\"stages\"`\r\n\t}\r\n\ttype sensitivityEntry struct {\r\n\t\tBestWithout  string  `json:\"best_without\"`\r\n\t\tMaxComposite float64 `json:\"max_composite\"`\r\n\t}\r\n\ttype reportOutput struct {\r\n\t\tPipeline          string                        `json:\"pipeline\"`\r\n\t\tExperiments       []reportExperiment            `json:\"experiments\"`\r\n\t\tMetricSummary     map[string]metricSummaryEntry `json:\"metric_summary\"`\r\n\t"]
[6216.272569, "o", "\tMetricRankings    map[string]map[string]int     `json:\"metric_rankings\"`\r\n\t\tCompositeScores   map[string]float64            `json:\"composite_scores\"`\r\n\t\tNormalizedMetrics map[string]map[string]float64 `json:\"normalized_metrics\"`\r\n\t\tMetricImportance  map[string]float64            `json:\"metric_importance\"`\r\n\t\tScoreSensitivity  map[string]sensitivityEntry   `json:\"score_sensitivity\"`\r\n\t\tBestExperiment    string                        `json:\"best_experiment\"`\r\n\t}\r\n\r\n\tout := reportOutput{\r\n\t\tPipeline:          p.Name,\r\n\t\tExperiments:       []reportExperiment{},\r\n"]
[6216.272645, "o", "\t\tMetricSummary:     map[string]metricSummaryEntry{},\r\n\t\tMetricRankings:    map[string]map[string]int{},\r\n\t\tCompositeScores:   map[string]float64{},\r\n\t\tNormalizedMetrics: map[string]map[string]float64{},\r\n"]
[6216.272726, "o", "\t\tMetricImportance:  map[string]float64{},\r\n\t\tScoreSensitivity:  map[string]sensitivityEntry{},\r\n\t}\r\n\tmetricValues := map[string][]float64{}\r\n\tfor _, combo := range parameterCombinations(p) {\r\n\t\tid := experimentID(combo)\r\n\t\texp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}\r\n\t\tfor _, stage := range p.Stages {\r\n\t\t\tif st, err := readStageState(id, stage.Name); err == nil {\r\n\t\t\t\texp.Stages = append(exp.Stages, *st)\r\n\t\t\t\tfor _, m := range st.Metrics {\r\n\t\t\t\t\texp.Metrics[m.Name] = m.Value\r\n"]
[6216.272796, "o", "\t\t\t\t\tmetricValues[m.Name] = append(metricValues[m.Name], m.Value)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tout.Experiments = append(out.Experiments, exp)\r\n\t}\r\n\tfor name, values := range metricValues {\r\n\t\tout.MetricSummary[name] = metricSummaryEntry{\r\n\t\t\tCount: len(values),\r\n\t\t\tMean:  round4(meanValue(values)),\r\n\t\t\tStd:   round4(sampleStd(values)),\r\n\t\t\tMin:   round4(minValue(values)),\r\n\t\t\tMax:   round4(maxValue(values)),\r\n\t\t}\r\n\t}\r\n\r\n"]
[6216.272867, "o", "\tobjectives := map[string]string{}\r\n\tfor _, stage := range p.Stages {\r\n\t\tfor _, m := range stage.Metrics {\r\n\t\t\tif m.Objective == \"minimize\" || m.Objective == \"maximize\" {\r\n\t\t\t\tobjectives[m.Name] = m.Objective\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tobjMetrics := make([]string, 0, len(objectives))\r\n\tfor m := range objectives {\r\n"]
[6216.272968, "o", "\t\tif _, ok := metricValues[m]; ok {\r\n\t\t\tobjMetrics = append(objMetrics, m)\r\n\t\t}\r\n\t}\r\n\tsort.Strings(objMetrics)\r\n\r\n\tif len(objMetrics) > 0 {\r\n\t\tminVal := map[string]float64{}\r\n\t\tmaxVal := map[string]float64{}\r\n\t\tfor _, m := range objMetrics {\r\n\t\t\tif vals, ok := metricValues[m]; ok && len(vals) > 0 {\r\n\t\t\t\tminVal[m] = minValue(vals)\r\n"]
[6216.273041, "o", "\t\t\t\tmaxVal[m] = maxValue(vals)\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tnormalized := make([]map[string]float64, len(out.Experiments))\r\n\t\tfor i, exp := range out.Experiments {\r\n\t\t\tnormalized[i] = make(map[string]float64)\r\n\t\t\tnormOut := make(map[string]float64)\r\n\t\t\tfor _, m := range objMetrics {\r\n\t\t\t\tval, ok := exp.Metrics[m]\r\n\t\t\t\t"]
[6216.273107, "o", "if !ok {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\trng := maxVal[m] - minVal[m]\r\n\t\t\t\tvar norm float64\r\n\t\t\t\tif rng == 0 {\r\n\t\t\t\t\tnorm = 0.5\r\n\t\t\t\t} else if objectives[m] == \"maximize\" {\r\n\t\t\t"]
[6216.273175, "o", "\t\tnorm = (val - minVal[m]) / rng\r\n\t\t\t\t} else {\r\n\t\t\t\t\tnorm = (maxVal[m] - val) / rng\r\n\t\t\t\t}\r\n\t\t\t\tnormalized[i][m] = norm\r\n\t\t\t\tnormOut[m] = round4(norm)\r\n\t\t\t}\r\n\t\t\tout.NormalizedMetrics[exp.ID] = normOut\r\n"]
[6216.273242, "o", "\t\t}\r\n\r\n\t\tcomposite := make([]float64, len(out.Experiments))\r\n\t\tfor i := range out.Experiments {\r\n\t\t\tif len(normalized[i]) == 0 {\r\n\t\t\t\tcomposite[i] = 0\r\n\t\t\t} else {\r\n\t\t\t\tsum := 0.0\r\n\t\t\t\tfor _, m := range objMetrics {\r\n\t\t\t\t\tif norm, ok := normalized[i][m]; ok {\r\n"]
[6216.273317, "o", "\t\t\t\t\t\tsum += norm\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tcomposite[i] = sum / float64(len(normalized[i]))\r\n\t\t\t}\r\n\t\t\tout.CompositeScores[out.Experiments[i].ID] = round4(composite[i])\r\n\t\t}"]
[6216.273393, "o", "\r\n\r\n\t\tfor _, m := range objMetrics {\r\n\t\t\tout.MetricRankings[m] = map[string]int{}\r\n\t\t\ttype idxVal struct {\r\n\t\t\t\tidx int\r\n\t\t\t\tval float64\r\n\t\t\t}\r\n\t\t\tvar items []idxVal\r\n\t\t\tfor i, exp := range out.Experiments {\r\n\t\t\t\tif val, ok := exp.Metrics[m]; ok {\r\n\t\t\t\t\titems = append(items, idxVal{i, val})\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tsort.SliceStable(items, func(a, b int) bool {\r\n"]
[6216.273469, "o", "\t\t\t\tva := items[a].val\r\n\t\t\t\tvb := items[b].val\r\n\t\t\t\tif va != vb {\r\n\t\t\t\t\tif objectives[m] == \"maximize\" {\r\n\t\t\t\t\t\treturn va > vb\r\n\t\t\t\t\t}\r\n\t\t\t\t\treturn va < vb\r\n\t\t\t\t}\r\n\t\t\t\treturn out.Experiments[items[a].idx].ID < out.Experiments[items[b].idx].ID\r\n"]
[6216.273543, "o", "\t\t\t})\r\n\t\t\tcurrentRank := 0\r\n\t\t\tprevVal := math.NaN()\r\n\t\t\tfor _, item := range items {\r\n\t\t\t\tif currentRank == 0 || item.val != prevVal {\r\n\t\t\t\t\tcurrentRank++\r\n\t\t\t\t\tprevVal = item.val\r\n\t\t\t\t}\r\n\t\t\t\tout.MetricRankings[m][out.Experiments[item.idx].ID] = currentRank\r\n\t\t\t}\r\n"]
[6216.273634, "o", "\t\t}\r\n\r\n\t\tfor _, m := range objMetrics {\r\n\t\t\tvar norms []float64\r\n\t\t\tfor i := range out.Experiments {\r\n\t\t\t\tif norm, ok := normalized[i][m]; ok {\r\n\t\t\t\t\tnorms = append(norms, norm)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tout.MetricImportance[m] = round4(sampleStd(norms))\r\n\t\t}\r\n\r\n\t\tfor _, m := range objMetrics {\r\n\t\t\tif len(objMetrics) <= 1 {\r\n\t\t\t\tbestID := \"\"\r\n\t\t\t\tfor _, exp := range out.Experiments {\r\n\t\t\t\t\tif bestID == \"\" || exp.ID < bestID {\r\n"]
[6216.273701, "o", "\t\t\t\t\t\tbestID = exp.ID\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tout.ScoreSensitivity[m] = sensitivityEntry{\r\n\t\t\t\t\tBestWithout:  bestID,\r\n\t\t\t\t\tMaxComposite: 0,\r\n\t\t\t\t}\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
