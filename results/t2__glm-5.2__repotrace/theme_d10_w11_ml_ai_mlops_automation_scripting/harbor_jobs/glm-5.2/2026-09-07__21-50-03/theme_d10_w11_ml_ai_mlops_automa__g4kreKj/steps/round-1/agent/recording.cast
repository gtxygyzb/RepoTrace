[3290.666186, "o", "}\r\n\r\nfunc cmdCompare(args []string) int {\r\n\tif len(args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe compare <pipeline1.yaml> <pipeline2.yaml> ...\")\r\n\t\treturn 1"]
[3290.666297, "o", "\r\n\t}\r\n\r\n\ttype pipelineInfo struct {\r\n\t\tName     string\r\n\t\tPipeline *Pipeline\r\n\t\tIDs      []string\r\n\t}\r\n\tvar pipelines []pipelineInfo\r\n\tidToPipeline := make(map[string]int)\r\n\r\n\tfor i, file := range args {\r\n\t\tp, err := loadPipeline(file)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\t\treturn 1\r\n\t\t}\r\n\t\tif errs := validatePipeline(p); len(errs) > 0 {\r\n\t"]
[3290.66638, "o", "\t\tfor _, e := range errs {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, e)\r\n\t\t\t}\r\n\t\t\treturn 1\r\n\t\t}\r\n\t\tinfo := pipelineInfo{Name: p.Name, Pipeline: p}\r\n\t\tfor _, combo := range parameterCombinations(p) {\r\n\t\t\tid := experimentID(combo)\r\n\t\t\tif prev, ok := idToPipeline[id]; ok {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: experiment ID collision: %s between pipelines %s and %s\\n\", id, pipelines[prev].Name, p.Name)\r\n\t\t\t\treturn 1\r\n\t\t\t}\r\n"]
[3290.666445, "o", "\t\t\tidToPipeline[id] = i\r\n\t\t\tinfo.IDs = append(info.IDs, id)\r\n\t\t}\r\n\t\tpipelines = append(pipelines, info)\r\n\t}\r\n\r\n\tfor _, info := range pipelines {\r\n\t\tmatching := 0\r\n\t\tfor _, id := range info.IDs {\r\n\t\t\tif experimentStateExists(id) {\r\n\t"]
[3290.666511, "o", "\t\t\tmatching++\r\n\t\t\t}\r\n\t\t}\r\n\t\tif matching == 0 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: pipeline %s has no matching experiments under .mlpipe/state\\n\", info.Name)\r\n\t\t\treturn 1\r\n\t\t}\r\n\t}\r\n\r\n"]
[3290.666575, "o", "\tmetricObjective := make(map[string]string)\r\n\tfor i, info := range pipelines {\r\n\t\tpm := make(map[string]string)\r\n\t\tfor _, stage := range info.Pipeline.Stages {\r\n\t\t\tfor _, m := range stage.Metrics {\r\n\t\t\t\tif m.Objective != \"minimize\" && m.Objective != \"maximize\" {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tif existing, ok := pm[m.Name]; ok && existing != m.Objective {\r\n"]
[3290.666639, "o", "\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: conflicting objective for metric %s in pipeline %s\\n\", m.Name, info.Name)\r\n\t\t\t\t\treturn 1\r\n\t\t\t\t}\r\n\t\t\t\tpm[m.Name] = m.Objective\r\n\t\t\t}\r\n\t\t}\r\n\t\tif i == 0 {\r\n"]
[3290.666696, "o", "\t\t\tmetricObjective = pm\r\n\t\t} else {\r\n\t\t\tfor k, v := range metricObjective {\r\n\t\t\t\tif v2, ok := pm[k]; !ok || v2 != v {\r\n\t\t\t\t\tdelete(metricObjective, k)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t"]
[3290.666765, "o", "\t}\r\n\t}\r\n\tsharedMetrics := make([]string, 0, len(metricObjective))\r\n\tfor k := range metricObjective {\r\n\t\tsharedMetrics = append(sharedMetrics, k)\r\n\t}\r\n\tsort.Strings(sharedMetrics)\r\n\tif len(sharedMetrics) == 0 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: no shared objective metrics found across pipelines\")\r\n\t\treturn 1\r\n"]
[3290.666824, "o", "\t}\r\n\r\n\tincluded := []compareExperimentData{}\r\n\tfor _, info := range pipelines {\r\n\t\tfor _, id := range info.IDs {\r\n\t\t\tif !experimentStateExists(id) {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tmetrics := collectExperimentMetrics(info.Pipeline, id)\r\n\t\t\tallPresent := true\r\n\t\t\tfor _, m := range sharedMetrics {\r\n"]
[3290.666881, "o", "\t\t\t\tif _, ok := metrics[m]; !ok {\r\n\t\t\t\t\tallPresent = false\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !allPresent {\r\n\t\t\t\tcontinue\r\n\t\t\t}"]
[3290.66697, "o", "\r\n\t\t\tincluded = append(included, compareExperimentData{ID: id, Pipeline: info.Name, Metrics: metrics})\r\n\t\t}\r\n\t}\r\n\r\n"]
[3290.667041, "o", "\tnormalized := make([]map[string]float64, len(included))\r\n\tfor i := range normalized {\r\n\t\tnormalized[i] = make(map[string]float64)\r\n\t}\r\n\tfor _, m := range sharedMetrics {\r\n\t\tmin := math.Inf(1)\r\n\t\tmax := math.Inf(-1)\r\n\t\tfor _, exp := range included {\r\n\t\t\tv := exp.Metrics[m]\r\n\t\t\tif v < min {\r\n\t\t\t\tmin = v\r\n\t\t\t}\r\n\t\t\tif v > max {\r\n\t\t\t\tmax = v\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor i, exp := range included {\r\n\t\t\tvar norm float64\r\n"]
[3290.667099, "o", "\t\t\tif max == min {\r\n\t\t\t\tnorm = 0.5\r\n\t\t\t} else {\r\n\t\t\t\tnorm = (exp.Metrics[m] - min) / (max - min)\r\n\t\t\t}\r\n\t\t\tif metricObjective[m] == \"minimize\" {\r\n\t\t\t\tnorm = 1 - norm\r\n\t\t\t}\r\n"]
[3290.667164, "o", "\t\t\tnormalized[i][m] = norm\r\n\t\t}\r\n\t}\r\n\r\n\tcomposite := make([]float64, len(included))\r\n\tfor i := range included {\r\n\t\tsum := 0.0\r\n\t\tfor _, m := range sharedMetrics {\r\n\t\t\tsum += normalized[i][m]\r\n\t\t}\r\n"]
[3290.667222, "o", "\t\tif len(sharedMetrics) > 0 {\r\n\t\t\tcomposite[i] = sum / float64(len(sharedMetrics))\r\n\t\t}\r\n\t}\r\n\r\n\tdepth := make([]int, len(included))\r\n\tremaining := make([]int, len(included))\r\n\tfor i := range remaining {\r\n\t\t"]
[3290.667289, "o", "remaining[i] = i\r\n\t}\r\n\tcurrentDepth := 0\r\n\tfor len(remaining) > 0 {\r\n\t\tnonDom := []int{}\r\n"]
[3290.667349, "o", "\t\tfor _, i := range remaining {\r\n\t\t\tdominated := false\r\n"]
