[5995.236531, "i", "ns[m] = {'best_without': best[0], 'max_composite': best[1]}\n\nfor key, expected in [('composite_scores', comp), ('normalized_metrics', norm), ('metric_importance', imp), ('score_sensitivity', sens)]:\n    assert report[key] == expected, (key, report[key], expected)\nassert report['best_experiment'] == max(comp.items(), key=lambda kv: (kv[1], -ord(kv[0][3]) if False else 0))[0]\nprint('verification passed')\nPY\n"]
