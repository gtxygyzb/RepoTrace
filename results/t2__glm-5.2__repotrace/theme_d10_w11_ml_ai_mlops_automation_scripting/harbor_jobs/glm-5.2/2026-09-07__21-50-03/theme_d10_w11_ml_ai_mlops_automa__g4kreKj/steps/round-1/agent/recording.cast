[8101.234723, "o", "\t\t}\r\n\t}\r\n\tparts = append(parts, s[start:])\r\n\treturn parts\r\n}\r\n\r\nfunc unquoteScalar(s string) string {\r\n\ts = strings.TrimSpace(s)\r\n\tif len(s) >= 2 && s[0] == '\"' && s[len(s)-1] == '\"' {\r\n\t\tunq, err := strconv.Unquote(s)\r\n\t\tif err == nil {\r\n\t\t\treturn unq\r\n\t\t}\r\n\t\treturn s[1 : len(s)-1]\r\n\t}\r\n\t"]
[8101.234791, "o", "if len(s) >= 2 && s[0] == '\\'' && s[len(s)-1] == '\\'' {\r\n\t\treturn strings.ReplaceAll(s[1:len(s)-1], \"''\", \"'\")\r\n\t}\r\n\treturn s\r\n}\r\n\r\nfunc mapToPipeline(v interface{}) (*Pipeline, error) {\r\n\tp := &Pipeline{}\r\n\troot := asMap(v)\r\n\tif root == nil {\r\n\t\treturn p, nil\r\n\t}\r\n\tp.Name = asString(root[\"name\"])\r\n\tp.Version = asString(root[\"version\"])\r\n"]
[8101.234852, "o", "\tif params, ok := root[\"parameters\"].(map[string]interface{}); ok {\r\n\t\tkeys := make([]string, 0, len(params))\r\n\t\tfor k := range params {\r\n\t\t\tkeys = append(keys, k)\r\n\t\t}\r\n\t\tsort.Strings(keys)\r\n\t\tfor _, k := range keys {\r\n\t\t\tpm := asMap(params[k])\r\n"]
[8101.234977, "o", "\t\t\tp.Parameters = append(p.Parameters, Parameter{Name: k, Values: asSlice(pm[\"values\"])})\r\n\t\t}\r\n\t}\r\n\tfor _, sv := range asSlice(root[\"stages\"]) {\r\n\t\tsm := asMap(sv)\r\n\t\tstage := Stage{\r\n\t\t\tName:    asString(sm[\"name\"]),\r\n\t"]
[8101.235045, "o", "\t\tCommand: asString(sm[\"command\"]),\r\n\t\t}\r\n\t\tstage.DependsOn = toStringSlice(asSlice(sm[\"depends_on\"]))\r\n\t\tstage.Env = toStringMap(asMap(sm[\"env\"]))\r\n\t\tfor _, mv := range asSlice(sm[\"metrics\"]) {\r\n\t\t\tmm := asMap(mv)\r\n\t\t\tstage.Metrics = append(stage.Metrics, Metric{Name: asString(mm[\"name\"]), Objective: asString(mm[\"objective\"])})\r\n\t\t}\r\n\t\tif rv := asMap(sm[\"retry\"]); rv != nil {\r\n\t\t\tstage.Retry = &Retry{MaxAttempts: asInt(rv[\"max_attempts\"]), BackoffSeconds: asFloat(rv[\"backoff_seconds\"])}\r\n\t\t}\r\n\t\tif cv := asMap(sm[\"condition\"]); cv != nil {\r\n\t\t\tstage.Condition = &Condition{Metric: asString(cv[\"metric\"]), Operator: asString(cv[\"operator\"]), Threshold: asFloat(cv[\"threshold\"])}\r\n\t\t}\r\n\t\tfor _, ov := range asSlice(sm[\"outputs\"]) {\r\n\t\t\tom := asMap(ov)\r\n\t\t\tstage.Outputs = append(stage.Outputs, ArtifactRef{Path: asString(om[\"path\"]), Type: asString(om[\"type\"])})\r\n\t\t}\r\n"]
[8101.235117, "o", "\t\tfor _, iv := range asSlice(sm[\"inputs\"]) {\r\n\t\t\tim := asMap(iv)\r\n\t\t\tstage.Inputs = append(stage.Inputs, ArtifactRef{Path: asString(im[\"path\"]), Type: asString(im[\"type\"])})\r\n\t\t}\r\n\t\tp.Stages = append(p.Stages, stage)\r\n\t"]
[8101.235186, "o", "}\r\n\treturn p, nil\r\n}\r\n\r\nfunc asMap(v interface{}) map[string]interface{} {\r\n\tif m, ok := v.(map[string]interface{}); ok {\r\n\t\treturn m\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc asSlice(v interface{}) []interface{} {\r\n\tif s, ok := v.([]interface{}); ok {\r\n\t\treturn s\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc asString(v interface{}) string {\r\n"]
[8101.235245, "o", "\tif v == nil {\r\n\t\treturn \"\"\r\n\t}\r\n\tswitch x := v.(type) {\r\n\tcase string:\r\n\t\treturn x\r\n\tcase int:\r\n\t\treturn strconv.Itoa(x)\r\n\tcase float64:\r\n"]
[8101.235305, "o", "\t\treturn formatFloat(x)\r\n\tcase bool:\r\n\t\treturn strconv.FormatBool(x)\r\n\tdefault:\r\n\t\treturn fmt.Sprint(x)\r\n\t}\r\n}\r\n\r\nfunc asInt(v interface{}) int {\r\n\tswitch x := v.(type) {\r\n\tcase int:\r\n\t\treturn x\r\n\t"]
[8101.235364, "o", "case float64:\r\n\t\treturn int(x)\r\n\tcase string:\r\n\t\tn, _ := strconv.Atoi(x)\r\n\t\treturn n\r\n\tdefault:\r\n\t\treturn 0\r\n\t}\r\n}\r\n\r\nfunc asFloat(v interface{}) float64 {\r\n\t"]
[8101.235422, "o", "switch x := v.(type) {\r\n\tcase float64:\r\n\t\treturn x\r\n\tcase int:\r\n\t\treturn float64(x)\r\n\tcase string:\r\n\t\tf, _ := strconv.ParseFloat(x, 64)\r\n\t\treturn f\r\n\tdefault:\r\n\t\treturn 0\r\n"]
[8101.235479, "o", "\t}\r\n}\r\n\r\nfunc toStringSlice(v []interface{}) []string {\r\n\tout := make([]string, 0, len(v))\r\n\tfor _, item := range v {\r\n\t\tout = append(out, asString(item))\r\n\t}\r\n\treturn out\r\n}\r\n"]
[8101.235538, "o", "\r\nfunc toStringMap(m map[string]interface{}) map[string]string {\r\n\tout := make(map[string]string)\r\n\tfor k, v := range m {\r\n\t\tout[k] = asString(v)\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc formatFloat(f float64) string {\r\n\treturn strconv.FormatFloat(f, 'g', -1, 64)\r\n}\r\n\r\n"]
[8101.235602, "o", "func validatePipeline(p *Pipeline) []string {\r\n\tvar errs []string\r\n\tnames := make(map[string]int)\r\n\tstageSet := make(map[string]bool)\r\n\tstageMap := make(map[string]Stage)\r\n\r\n\tfor i, stage := range p.Stages {\r\n\t\tif stage.Name == \"\" {\r\n\t\t\terrs = append(errs, fmt.Sprintf(\"stage %d: missing required field name\", i))\r\n"]
[8101.235663, "o", "\t\t}\r\n\t\tif stage.Command == \"\" {\r\n\t\t\terrs = append(errs, fmt.Sprintf(\"stage %d: missing required field command\", i))\r\n\t\t}\r\n\t\tif stage.Name != \"\" {\r\n\t\t\tif prev, ok := names[stage.Name]; ok {\r\n\t\t\t\terrs = append(errs, fmt.Sprintf(\"duplicate stage name: %s (stages %d and %d)\", stage.Name, prev, i))\r\n\t\t\t} else {\r\n\t\t\t\tnames[stage.Name] = i\r\n\t\t\t}\r\n\t"]
[8101.235725, "o", "\t\tstageSet[stage.Name] = true\r\n\t\t\tstageMap[stage.Name] = stage\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, stage := range p.Stages {\r\n\t\tfor _, dep := range stage.DependsOn {\r\n\t\t\tif !stageSet[dep] {\r\n\t\t\t\terrs = append(errs, fmt.Sprintf(\"stage %q depends on undefined stage %q\", stage.Name, dep))\r\n"]
[8101.235788, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, stage := range p.Stages {\r\n\t\tif stage.Name == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tstate := make(map[string]int)\r\n"]
[8101.23585, "o", "\t\tvar check func(name string)\r\n\t\tcheck = func(name string) {\r\n\t\t\tstate[name] = 1\r\n\t\t\tfor _, dep := range stageMap[name].DependsOn {\r\n\t\t\t\tif !stageSet[dep] {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tif state[dep] == 1 {\r\n\t\t\t\t\terrs = append(errs, fmt.Sprintf(\"circular dependency detected involving stage: %s\", name))\r\n"]
[8101.235912, "o", "\t\t\t\t} else if state[dep] == 0 {\r\n\t\t\t\t\tcheck(dep)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tstate[name] = 2\r\n\t\t}\r\n\t\tcheck(stage.Name)\r\n\t}\r\n\r\n"]
[8101.235994, "o", "\treturn errs\r\n}\r\n\r\nfunc topologicalGroups(p *Pipeline) ([][]string, error) {\r\n\tstageMap := make(map[string]Stage)\r\n\tfor _, stage := range p.Stages {\r\n\t\tstageMap[stage.Name] = stage\r\n\t}\r\n\r\n\tcompleted := make(map[string]bool)\r\n\tremaining := make(map[string]bool)\r\n\tfor _, stage := range p.Stages {\r\n\t"]
[8101.236057, "o", "\tremaining[stage.Name] = true\r\n\t}\r\n\r\n\tvar groups [][]string\r\n\tfor len(remaining) > 0 {\r\n\t\tvar ready []string\r\n\t\tfor name := range remaining {\r\n\t\t\tok := true\r\n\t\t\tfor _, dep := range stageMap[name].DependsOn {\r\n\t\t\t\tif !completed[dep] {\r\n"]
[8101.236118, "o", "\t\t\t\t\tok = false\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif ok {\r\n\t\t\t\tready = append(ready, name)\r\n\t\t\t}\r\n\t\t}\r\n"]
[8101.236182, "o", "\t\tsort.Strings(ready)\r\n\t\tif len(ready) == 0 {\r\n\t\t\treturn nil, fmt.Errorf(\"circular dependency detected among stages: %v\", sortedKeys(remaining))\r\n\t\t}\r\n\t\tgroups = append(groups, ready)\r\n\t\tfor _, name := range ready {\r\n\t\t\tcompleted[name] = true\r\n\t\t\tdelete(remaining, name)\r\n\t"]
[8101.236243, "o", "\t}\r\n\t}\r\n\treturn groups, nil\r\n}\r\n\r\nfunc parameterCombinations(p *Pipeline) []map[string]interface{} {\r\n\tif len(p.Parameters) == 0 {\r\n\t\treturn []map[string]interface{}{{}}\r\n"]
[8101.236307, "o", "\t}\r\n\tcombos := []map[string]interface{}{{}}\r\n\tfor _, param := range p.Parameters {\r\n\t\tnext := make([]map[string]interface{}, 0, len(combos)*len(param.Values))\r\n\t\tfor _, combo := range combos {\r\n\t\t\tfor _, value := range param.Values {\r\n\t\t\t\tc := copyMap(combo)\r\n\t\t\t\tc[param.Name] = value\r\n\t\t\t\tnext = append(next, c)\r\n"]
[8101.236367, "o", "\t\t\t}\r\n\t\t}\r\n\t\tcombos = next\r\n\t}\r\n\treturn combos\r\n}\r\n\r\nfunc experimentID(combo map[string]interface{}) string {\r\n\tif len(combo) == 0 {\r\n\t\treturn \"exp_default\"\r\n\t}\r\n"]
[8101.236431, "o", "\tkeys := make([]string, 0, len(combo))\r\n\tfor k := range combo {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n\tsort.Strings(keys)\r\n\tparts := make([]string, 0, len(keys))\r\n\tfor _, k := range keys {\r\n\t\tparts = append(parts, k+\"=\"+asString(combo[k]))\r\n\t}\r\n\treturn \"exp_\" + strings.Join(parts, \"_\")\r\n"]
[8101.236494, "o", "}\r\n\r\nfunc substituteParams(value string, combo map[string]interface{}) string {\r\n\tfor k, v := range combo {\r\n\t\tvalue = strings.ReplaceAll(value, \"${\"+k+\"}\", asString(v))\r\n\t}\r\n\treturn value\r\n}\r\n\r\nfunc copyMap(m map[string]interface{}) map[string]interface{} {\r\n\tout := make(map[string]interface{}, len(m))\r\n\t"]
[8101.236561, "o", "for k, v := range m {\r\n\t\tout[k] = v\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc sortedKeys(m map[string]bool) []string {\r\n\tkeys := make([]string, 0, len(m))\r\n\tfor k := range m {\r\n\t\tkeys = append(keys, k)\r\n"]
[8101.236633, "o", "\t}\r\n\tsort.Strings(keys)\r\n\treturn keys\r\n}\r\n\r\nfunc stateDir(experimentID string) string {\r\n\treturn filepath.Join(\".mlpipe\", \"state\", experimentID)\r\n}\r\n\r\nfunc stageStatePath(experimentID, stageName string) string {\r\n\treturn filepath.Join(stateDir(experimentID), stageName+\".json\")\r\n}\r\n\r\n"]
[8101.236692, "o", "func experimentStateExists(id string) bool {\r\n\tinfo, err := os.Stat(stateDir(id))\r\n\treturn err == nil && info.IsDir()\r\n}\r\n\r\nfunc readStageState(experimentID, stageName string) (*StageState, error) {\r\n\tdata, err := os.ReadFile(stageStatePath(experimentID, stageName))\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n"]
[8101.236751, "o", "\t}\r\n\tvar st StageState\r\n\tif err := json.Unmarshal(data, &st); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn &st, nil\r\n}\r\n\r\nfunc writeStageState(experimentID, stageName string, st *StageState) error {\r\n\tif err := os.MkdirAll(stateDir(experimentID), 0755); err != nil {\r\n\t\treturn err\r\n"]
[8101.236809, "o", "\t}\r\n\tdata, err := json.MarshalIndent(st, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(stageStatePath(experimentID, stageName), data, 0644)\r\n}\r\n\r\nfunc artifactsIndexPath() string {\r\n\treturn filepath.Join(\".mlpipe\", \"artifacts\", \"index.json\")\r\n}\r\n"]
[8101.236869, "o", "\r\nfunc loadArtifactIndex() *ArtifactIndex {\r\n\tidx := &ArtifactIndex{}\r\n\tdata, err := os.ReadFile(artifactsIndexPath())\r\n\tif err != nil {\r\n\t\treturn idx\r\n\t}\r\n\tif err := json.Unmarshal(data, idx); err != nil {\r\n\t\t"]
[8101.236946, "o", "return &ArtifactIndex{}\r\n\t}\r\n"]
