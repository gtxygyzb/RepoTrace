[2054.904891, "o", "   353\t    }\r\n   354\t    if strings.HasPrefix(lines[idx].content, \"- \") || lines[idx].content == \"-\" {\r\n   355\t        return parseSequence(lines, idx, indent)\r\n   356\t    }\r\n   357\t    return parseMapping(lines, idx, indent)\r\n   358\t}\r\n   359\t\r\n   360\tfunc parseSequence(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n"]
