[2054.904729, "o", "   327\t    for _, raw := range strings.Split(string(data), \"\\n\") {\r\n   328\t        raw = strings.TrimRight(raw, \"\\r\")\r\n   329\t        trimmed := strings.TrimSpace(raw)\r\n   330\t        if trimmed == \"\" || strings.HasPrefix(trimmed, \"#\") {\r\n   331\t            continue\r\n   332\t        }\r\n   333\t        indent := 0\r\n   334\t        for indent < len(raw) && raw[indent] == ' ' {\r\n"]
[2054.904782, "o", "   335\t            indent++\r\n   336\t        }\r\n   337\t        content := strings.TrimRight(raw[indent:], \" \")\r\n   338\t        lines = append(lines, yamlLine{indent: indent, content: content})\r\n   339\t    }\r\n   340\t    if len(lines) == 0 {\r\n   341\t        return nil, nil\r\n   342\t    }\r\n   343\t    v, idx := parseBlock(lines, 0, 0)\r\n"]
