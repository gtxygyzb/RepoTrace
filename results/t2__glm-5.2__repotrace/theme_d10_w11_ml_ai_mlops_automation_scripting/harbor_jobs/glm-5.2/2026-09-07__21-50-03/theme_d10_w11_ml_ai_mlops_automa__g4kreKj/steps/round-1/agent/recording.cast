[5196.107524, "o", "name: text-sentiment-analysis\r\nversion: \"1.0\"\r\n\r\nparameters:\r\n  embedding_dim:\r\n    type: grid\r\n    values: [128, 256]\r\n  dropout:\r\n    type: grid\r\n    values: [0.1, 0.3]\r\n\r\nstages:\r\n  - name: preprocess\r\n    command: \"./stages/validate_data.sh\"\r\n    inputs:\r\n      - path: \"data/sample\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    metrics:\r\n      - name: num_samples\r\n"]
[5196.107619, "o", "        objective: report\r\n      - name: corruption_rate\r\n        objective: minimize\r\n\r\n  - name: train\r\n    command: \"./stages/train_model.sh\"\r\n    depends_on: [\"preprocess\"]\r\n    outputs:\r\n      - path: \"models/checkpoint.bin\"\r\n        type: file\r\n    env:\r\n      LEARNING_RATE: \"0.001\"\r\n      OPTIMIZER: \"adam\"\r\n      BATCH_SIZE: \"${embedding_dim}\"\r\n      DROPOUT: \"${dropout}\"\r\n    metrics:\r\n      - name: train_loss\r\n        objective: minimize\r\n      - name: train_accuracy\r\n        objective: maximize\r\n\r\n  - name: evaluate\r\n    command: \"./stages/evaluate_model.sh\"\r\n    depends_on: [\"train\"]\r\n    outputs:\r\n      - path: \"reports/evaluation.json\"\r\n        type: file\r\n    metrics:\r\n      - name: eval_accuracy\r\n        objective: maximize\r\n      - name: eval_f1\r\n        objective: maximize\r\n      - name: eval_loss\r\n        objective: minimize\r\n"]
