[8124.012827, "o", "\t\tsort.Strings(keys)\r\n\t\tfor _, k := range keys {\r\n\t\t\tpm := asMap(params[k])\r\n\t\t\tp.Parameters = append(p.Parameters, Parameter{Name: k, Values: asSlice(pm[\"values\"])})\r\n\t\t}\r\n\t}\r\n\tfor _, sv := range asSlice(root[\"stages\"]) {\r\n\t\tsm := asMap(sv)\r\n\t\tstage := Stage{\r\n\t\t\tName:    asString(sm[\"name\"]),\r\n\t"]
