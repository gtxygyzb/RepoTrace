[6241.465976, "o", "Total          int             `json:\"total_experiments\"`\r\n\t\tParetoCount    int             `json:\"pareto_count\"`\r\n\t\tMaxDominance   int             `json:\"max_dominance_depth\"`\r\n\t\tBestExperiment *bestExperiment `json:\"best_experiment\"`\r\n\t}{\r\n\t\tTotal:          len(included),\r\n\t\tParetoCount:    paretoCount,\r\n\t\tMaxDominance:   maxDepth,\r\n\t\tBestExperiment: best,\r\n\t}\r\n\tout := struct {\r\n"]
