[2019.139761, "o", "===== pipelines/text_sentiment.yaml =====\r\n"]
[2019.141891, "o", "     1\tname: text-sentiment-analysis\r\n     2\tversion: \"1.0\"\r\n     3\t\r\n"]
[2019.142008, "o", "     4\tparameters:\r\n     5\t  embedding_dim:\r\n     6\t    type: grid\r\n     7\t    values: [128, 256]\r\n     8\t  dropout:\r\n     9\t    type: grid\r\n    10\t    values: [0.1, 0.3]\r\n    11\t\r\n    12\tstages:\r\n    13\t  - name: preprocess\r\n    14\t    command: \"./stages/validate_data.sh\"\r\n    15\t    inputs:\r\n    16\t      - path: \"data/sample\"\r\n    17\t        type: directory\r\n    18\t    outputs:\r\n    19\t      - path: \"data/validated\"\r\n    20\t        type: directory\r\n"]
[2019.142032, "o", "    21\t    metrics:\r\n    22\t      - name: num_samples\r\n"]
[2019.14211, "o", "    23\t        objective: report\r\n    24\t      - name: corruption_rate\r\n    25\t        objective: minimize\r\n    26\t\r\n    27\t  - name: train\r\n    28\t    command: \"./stages/train_model.sh\"\r\n    29\t    depends_on: [\"preprocess\"]\r\n    30\t    outputs:\r\n    31\t      - path: \"models/checkpoint.bin\"\r\n"]
[2019.142126, "o", "    32\t        type: file\r\n    33\t    env:\r\n"]
[2019.142196, "o", "    34\t      LEARNING_RATE: \"0.001\"\r\n    35\t      OPTIMIZER: \"adam\"\r\n"]
[2019.142247, "o", "    36\t      BATCH_SIZE: \"${embedding_dim}\"\r\n    37\t      DROPOUT: \"${dropout}\"\r\n    38\t    metrics:\r\n    39\t      - name: train_loss\r\n    40\t        objective: minimize\r\n    41\t      - name: train_accuracy\r\n    42\t        objective: maximize\r\n    43\t\r\n    44\t  - name: evaluate\r\n    45\t    command: \"./stages/evaluate_model.sh\"\r\n"]
[2019.1423, "o", "    46\t    depends_on: [\"train\"]\r\n    47\t    outputs:\r\n    48\t      - path: \"reports/evaluation.json\"\r\n    49\t        type: file\r\n    50\t    metrics:\r\n    51\t      - name: eval_accuracy\r\n    52\t        objective: maximize\r\n    53\t      - name: eval_f1\r\n"]
[2019.142351, "o", "    54\t        objective: maximize\r\n    55\t      - name: eval_loss\r\n    56\t        objective: minimize\r\n"]
