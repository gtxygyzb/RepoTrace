[1985.01025, "o", "   674\t\r\n   675\tfunc toStringMap(m map[string]interface{}) map[string]string {\r\n   676\t    out := make(map[string]string)\r\n   677\t    for k, v := range m {\r\n"]
[1985.010313, "o", "   678\t        out[k] = asString(v)\r\n   679\t    }\r\n   680\t    return out\r\n   681\t}\r\n   682\t\r\n   683\tfunc formatFloat(f float64) string {\r\n   684\t    return strconv.FormatFloat(f, 'g', -1, 64)\r\n   685\t}\r\n   686\t\r\n   687\tfunc validatePipeline(p *Pipeline) []string {\r\n   688\t    var errs []string\r\n   689\t    names := make(map[string]int)\r\n   690\t    stageSet := make(map[string]bool)\r\n"]
[1985.010374, "o", "   691\t    stageMap := make(map[string]Stage)\r\n   692\t\r\n   693\t    for i, stage := range p.Stages {\r\n   694\t        if stage.Name == \"\" {\r\n   695\t            errs = append(errs, fmt.Sprintf(\"stage %d: missing required field name\", i))\r\n   696\t        }\r\n   697\t        if stage.Command == \"\" {\r\n"]
[1985.010438, "o", "   698\t            errs = append(errs, fmt.Sprintf(\"stage %d: missing required field command\", i))\r\n   699\t        }\r\n   700\t        if stage.Name != \"\" {\r\n   701\t            if prev, ok := names[stage.Name]; ok {\r\n   702\t                errs = append(errs, fmt.Sprintf(\"duplicate stage name: %s (stages %d and %d)\", stage.Name, prev, i))\r\n   703\t            } else {\r\n   704\t                names[stage.Name] = i\r\n   705\t            }\r\n   706\t            stageSet[stage.Name] = true\r\n"]
[1985.010497, "o", "   707\t            stageMap[stage.Name] = stage\r\n   708\t        }\r\n   709\t    }\r\n   710\t\r\n   711\t    for _, stage := range p.Stages {\r\n   712\t        for _, dep := range stage.DependsOn {\r\n   713\t            if !stageSet[dep] {\r\n   714\t                errs = append(errs, fmt.Sprintf(\"stage %q depends on undefined stage %q\", stage.Name, dep))\r\n   715\t            }\r\n   716\t        }\r\n"]
[1985.010563, "o", "   717\t    }\r\n   718\t\r\n   719\t    for _, stage := range p.Stages {\r\n   720\t        if stage.Name == \"\" {\r\n   721\t            continue\r\n   722\t        }\r\n   723\t        state := make(map[string]int)\r\n"]
[1985.010641, "o", "   724\t        var check func(name string)\r\n   725\t        check = func(name string) {\r\n   726\t            state[name] = 1\r\n   727\t            for _, dep := range stageMap[name].DependsOn {\r\n   728\t                if !stageSet[dep] {\r\n   729\t                    continue\r\n   730\t                }\r\n   731\t                if state[dep] == 1 {\r\n   732\t                    errs = append(errs, fmt.Sprintf(\"circular dependency detected involving stage: %s\", name))\r\n   733\t                } else if state[dep] == 0 {\r\n   734\t                    check(dep)\r\n   735\t                }\r\n   736\t            }\r\n   737\t            state[name] = 2\r\n   738\t        }\r\n   739\t        check(stage.Name)\r\n   740\t    }\r\n"]
[1985.010709, "o", "   741\t\r\n   742\t    return errs\r\n   743\t}\r\n   744\t\r\n   745\tfunc topologicalGroups(p *Pipeline) ([][]string, error) {\r\n   746\t    stageMap := make(map[string]Stage)\r\n"]
[1985.010772, "o", "   747\t    for _, stage := range p.Stages {\r\n   748\t        stageMap[stage.Name] = stage\r\n   749\t    }\r\n   750\t\r\n   751\t    completed := make(map[string]bool)\r\n   752\t    remaining := make(map[string]bool)\r\n   753\t    for _, stage := range p.Stages {\r\n   754\t        remaining[stage.Name] = true\r\n   755\t    }\r\n   756\t\r\n   757\t    var groups [][]string\r\n   758\t    for len(remaining) > 0 {\r\n   759\t        var ready []string\r\n"]
[1985.01084, "o", "   760\t        for name := range remaining {\r\n   761\t            ok := true\r\n   762\t            for _, dep := range stageMap[name].DependsOn {\r\n   763\t                if !completed[dep] {\r\n   764\t                    ok = false\r\n   765\t                    break\r\n"]
[1985.010909, "o", "   766\t                }\r\n   767\t            }\r\n   768\t            if ok {\r\n   769\t                ready = append(ready, name)\r\n   770\t            }\r\n   771\t        }\r\n   772\t        sort.Strings(ready)\r\n   773\t        if len(ready) == 0 {\r\n   774\t            return nil, fmt.Errorf(\"circular dependency detected among stages: %v\", sortedKeys(remaining))\r\n   775\t        }\r\n   776\t        groups = append(groups, ready)\r\n   777\t        for _, name := range ready {\r\n   778"]
[1985.010992, "o", "\t            completed[name] = true\r\n   779\t            delete(remaining, name)\r\n   780\t        }\r\n   781\t    }\r\n   782\t    return groups, nil\r\n   783\t}\r\n   784\t\r\n   785\tfunc parameterCombinations(p *Pipeline) []map[string]interface{} {\r\n   786\t    if len(p.Parameters) == 0 {\r\n   787\t        return []map[string]interface{}{{}}\r\n   788\t    }\r\n   789\t    combos := []map[string]interface{}{{}}\r\n   790\t    for _, param := range p.Parameters {\r\n"]
[1985.011053, "o", "   791\t        next := make([]map[string]interface{}, 0, len(combos)*len(param.Values))\r\n   792\t        for _, combo := range combos {\r\n   793\t            for _, value := range param.Values {\r\n   794\t                c := copyMap(combo)\r\n   795\t                c[param.Name] = value\r\n   796"]
[1985.011112, "o", "\t                next = append(next, c)\r\n   797\t            }\r\n   798\t        }\r\n   799\t        combos = next\r\n   800\t    }\r\n   801\t    return combos\r\n   802\t}\r\n"]
[1985.011169, "o", "   803\t\r\n   804\tfunc experimentID(combo map[string]interface{}) string {\r\n   805\t    if len(combo) == 0 {\r\n   806\t        return \"exp_default\"\r\n   807\t    }\r\n   808\t    keys := make([]string, 0, len(combo))\r\n   809\t    for k := range combo {\r\n"]
[1985.011227, "o", "   810\t        keys = append(keys, k)\r\n   811\t    }\r\n   812\t    sort.Strings(keys)\r\n   813\t    parts := make([]string, 0, len(keys))\r\n   814\t    for _, k := range keys {\r\n   815\t        parts = append(parts, k+\"=\"+asString(combo[k]))\r\n"]
[1985.011285, "o", "   816\t    }\r\n   817\t    return \"exp_\" + strings.Join(parts, \"_\")\r\n   818\t}\r\n   819\t\r\n   820\tfunc substituteParams(value string, combo map[string]interface{}) string {\r\n   821\t    for k, v := range combo {\r\n   822\t        value = strings.ReplaceAll(value, \"${\"+k+\"}\", asString(v))\r\n   823\t    }\r\n"]
[1985.011341, "o", "   824\t    return value\r\n   825\t}\r\n   826\t\r\n   827\tfunc copyMap(m map[string]interface{}) map[string]interface{} {\r\n   828\t    out := make(map[string]interface{}, len(m))\r\n   829\t    for k, v := range m {\r\n"]
[1985.011398, "o", "   830\t        out[k] = v\r\n   831\t    }\r\n   832\t    return out\r\n   833\t}\r\n   834\t\r\n   835\tfunc sortedKeys(m map[string]bool) []string {\r\n   836\t    keys := make([]string, 0, len(m))\r\n   837\t    for k := range m {\r\n   838\t        keys = append(keys, k)\r\n   839\t    }\r\n"]
[1985.011452, "o", "   840\t    sort.Strings(keys)\r\n   841\t    return keys\r\n   842\t}\r\n"]
