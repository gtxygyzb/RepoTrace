[1984.429433, "o", "   416\t    _, _, ok := splitKeyValue(s)\r\n   417\t    return ok\r\n   418\t}\r\n   419\t\r\n   420\tfunc splitKeyValue(s string) (string, string, bool) {\r\n   421\t    inQuote := false\r\n   422\t    quoteChar := byte(0)\r\n   423\t    for i := 0; i < len(s); i++ {\r\n   424\t        c := s[i]\r\n   425\t        if inQuote {\r\n   426\t            if c == quoteChar {\r\n   427\t                inQuote = false\r\n   428\t            }\r\n   429\t            continue\r\n   430\t        }\r\n   431\t        if c == '\"' || c == '\\'' {\r\n   432\t            inQuote = true\r\n   433\t            quoteChar = c\r\n   434\t            continue\r\n"]
