[3370.535747, "o", "   151\t\tp, err := loadPipeline(args[0])\r\n   152\t\tif err != nil {\r\n   153\t\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n   154\t\t\treturn 1\r\n   155\t\t}\r\n   156\t\tif errs := validatePipeline(p); len(errs) > 0 {\r\n   157\t\t\tfor _, e := range errs {\r\n   158\t\t\t\tfmt.Fprintln(os.Stderr, e)\r\n   159\t\t\t}\r\n   160\t\t\treturn 1\r\n   161\t\t}\r\n   162\t\treturn reportPipeline(p)\r\n   163\t}\r\n   164\t\r\n   165\tfunc cmdArtifacts(args []string) int {\r\n   166\t\tpipelineFile, list, gc, err := parseArtifactsArgs(args)\r\n   167\t\tif err != nil {\r\n   168\t\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n   169\t\t\treturn 1\r\n   170\t\t}\r\n   171\t\tp, err := loadPipeline(pipelineFile)\r\n   172\t\tif err != nil {\r\n   173\t\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n   174"]
[3370.535824, "o", "\t\t\treturn 1\r\n   175\t\t}\r\n"]
