[3411.112562, "o", "   184\t\tpipelineFile := \"\"\r\n   185\t\texperimentIndex := -1\r\n   186\t\tresume := false\r\n   187\t\tfor i := 0; i < len(args); i++ {\r\n   188\t\t\tswitch args[i] {\r\n   189\t\t\tcase \"--experiment\":\r\n   190\t\t\t\tif i+1 >= len(args) {\r\n   191\t\t\t\t\treturn \"\", 0, false, fmt.Errorf(\"--experiment requires an index\")\r\n   192\t\t\t\t}\r\n   193\t\t\t\tidx, err := strconv.Atoi(args[i+1])\r\n   194\t\t\t\tif err != nil {\r\n   195\t\t\t\t\treturn \"\", 0, false, fmt.Errorf(\"invalid experiment index: %v\", err)\r\n   196\t\t\t\t}\r\n   197\t\t\t\texperimentIndex = idx\r\n"]
[3411.112636, "o", "   198\t\t\t\ti++\r\n   199\t\t\tcase \"--resume\":\r\n   200\t\t\t\tresume = true\r\n   201\t\t\tdefault:\r\n   202\t\t\t\tif pipelineFile == \"\" {\r\n   203\t\t\t\t\tpipelineFile = args[i]\r\n   204\t\t\t\t} else {\r\n   205\t\t\t\t\treturn \"\", 0, false, fmt.Errorf(\"unexpected argument: %s\", args[i])\r\n"]
[3411.112714, "o", "   206\t\t\t\t}\r\n   207\t\t\t}\r\n   208\t\t}\r\n   209\t\tif pipelineFile == \"\" {\r\n   210\t\t\treturn \"\", 0, false, fmt.Errorf(\"usage: mlpipe run <pipeline.yaml> [--experiment <index>] [--resume]\")\r\n   211\t\t}\r\n"]
[3411.112778, "o", "   212\t\treturn pipelineFile, experimentIndex, resume, nil\r\n   213\t}\r\n   214\t\r\n   215\tfunc parseArtifactsArgs(args []string) (string, bool, bool, error) {\r\n   216\t\tpipelineFile := \"\"\r\n   217\t\tlist := false\r\n   218\t\tgc := false\r\n   219\t\tfor _, arg := range args {\r\n   220\t\t\tswitch arg {\r\n   221\t\t\tcase \"--list\":\r\n   222\t\t\t\tlist = true\r\n   223\t\t\tcase \"--gc\":\r\n   224\t\t\t\tgc = true\r\n"]
[3411.112846, "o", "   225\t\t\tdefault:\r\n   226\t\t\t\tif pipelineFile == \"\" {\r\n   227\t\t\t\t\tpipelineFile = arg\r\n   228\t\t\t\t} else {\r\n   229\t\t\t\t\treturn \"\", false, false, fmt.Errorf(\"unexpected argument: %s\", arg)\r\n   230\t\t\t\t}\r\n   231\t\t\t}\r\n"]
[3411.112907, "o", "   232\t\t}\r\n   233\t\tif pipelineFile == \"\" {\r\n   234\t\t\treturn \"\", false, false, fmt.Errorf(\"usage: mlpipe artifacts <pipeline.yaml> [--list] [--gc]\")\r\n   235\t\t}\r\n   236\t\treturn pipelineFile, list, gc, nil\r\n   237\t}\r\n   238\t\r\n   239\ttype Pipeline struct {\r\n   240\t\tName       string\r\n   241\t\tVersion    string\r\n"]
