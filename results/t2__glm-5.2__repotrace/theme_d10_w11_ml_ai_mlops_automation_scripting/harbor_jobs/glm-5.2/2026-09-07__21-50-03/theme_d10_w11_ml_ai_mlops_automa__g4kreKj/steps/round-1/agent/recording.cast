[3290.372089, "o", "\t}\r\n\t_ = writeStageState(experimentID, stage.Name, st)\r\n\treturn nil, fmt.Errorf(\"stage %s failed: %w\", stage.Name, lastErr)\r\n}\r\n\r\nfunc parseMetrics(output string) []MetricData {\r\n\tvar metrics []MetricData\r\n\tscanner := bufio.NewScanner(strings.NewReader(output))\r\n\tfor scanner.Scan() {\r\n"]
[3290.372172, "o", "\t\tline := strings.TrimSpace(scanner.Text())\r\n\t\tif line == \"\" || !strings.HasPrefix(line, \"{\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvar m MetricData\r\n\t\tif err := json.Unmarshal([]byte(line), &m); err == nil && m.Name != \"\" {\r\n\t\t\tmetrics = append(metrics, m)\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvar mm map[string]interface{}\r\n\t\tif err := json.Unmarshal([]byte(line), &mm); err == nil {\r\n"]
[3290.372235, "o", "\t\t\tif name, ok := mm[\"metric\"].(string); ok {\r\n\t\t\t\tmetrics = append(metrics, MetricData{Name: name, Value: asFloat(mm[\"value\"])})\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn metrics\r\n}\r\n\r\nfunc compareMetric(val float64, op string, threshold float64) bool {\r\n\tswitch op {\r\n\tcase \">=\":\r\n\t\treturn val >= threshold\r\n\tcase \">\":\r\n\t\treturn val > threshold\r\n\tcase \"<=\":\r\n\t\treturn val <= threshold\r\n"]
[3290.372294, "o", "\tcase \"<\":\r\n\t\treturn val < threshold\r\n\tcase \"==\":\r\n\t\treturn val == threshold\r\n\tcase \"!=\":\r\n\t\treturn val != threshold\r\n\tdefault:\r\n\t\treturn false\r\n\t}\r\n"]
[3290.372372, "o", "}\r\n\r\nfunc exitCodeFromError(err error) int {\r\n\tif exiterr, ok := err.(*exec.ExitError); ok {\r\n\t\treturn exiterr.ExitCode()\r\n\t}\r\n\treturn 1\r\n}\r\n\r\nfunc updateArtifactIndex(experimentID, stageName string, stage Stage) error {\r\n\tidx := loadArtifactIndex()\r\n\tfor _, out := range stage.Outputs {\r\n\t\tinfo, err := os.Stat(out.Path)"]
[3290.372434, "o", "\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tf, err := os.Open(out.Path)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\th := sha256.New()\r\n\t\t"]
[3290.372495, "o", "if _, err := io.Copy(h, f); err != nil {\r\n\t\t\tf.Close()\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tf.Close()\r\n\t\tidx.Entries = append(idx.Entries, ArtifactEntry{\r\n\t\t\tExperimentID: experimentID,\r\n\t\t\tStageName:    stageName,\r\n"]
[3290.372559, "o", "\t\t\tPath:         out.Path,\r\n\t\t\tHash:         hex.EncodeToString(h.Sum(nil)),\r\n\t\t\tSize:         info.Size(),\r\n\t\t})\r\n\t}\r\n\treturn saveArtifactIndex(idx)\r\n}\r\n\r\ntype compareExperimentData struct {\r\n\tID       string\r\n\tPipeline string\r\n\tMetrics  map[string]float64\r\n}\r\n\r\n"]
[3290.372625, "o", "func collectExperimentMetrics(p *Pipeline, id string) map[string]float64 {\r\n\tmetrics := map[string]float64{}\r\n\tfor _, stage := range p.Stages {\r\n\t\tif st, err := readStageState(id, stage.Name); err == nil {\r\n\t\t\tfor _, m := range st.Metrics {\r\n\t\t\t\tmetrics[m.Name] = m.Value\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn metrics\r\n"]
[3290.372691, "o", "}\r\n\r\nfunc dominates(a, b map[string]float64, metrics []string) bool {\r\n\tstrictlyBetter := false\r\n\tfor _, m := range metrics {\r\n\t\tif a[m] < b[m] {\r\n\t\t\treturn false\r\n\t\t}\r\n\t\tif a[m] > b[m] {\r\n\t\t\t"]
[3290.372752, "o", "strictlyBetter = true\r\n\t\t}\r\n\t}\r\n\treturn strictlyBetter\r\n}\r\n"]
