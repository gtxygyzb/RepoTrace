[2176.687116, "o", "for f in pipelines/*.yaml; do echo \"===== $f =====\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[2176.687361, "o", "===== pipelines/broken_cycles.yaml =====\r\n"]
[2176.68833, "o", "name: broken-circular-pipeline\r\nversion: \"1.0\"\r\n\r\nstages:\r\n  - name: stage-a\r\n    command: \"echo a\"\r\n    depends_on: [\"stage-c\"]\r\n    outputs:\r\n      - path: \"out/a.txt\"\r\n        type: file\r\n\r\n  - name: stage-b\r\n    command: \"echo b\"\r\n    depends_on: [\"stage-a\"]\r\n    outputs:\r\n      - path: \"out/b.txt\"\r\n        type: file\r\n\r\n  - name: stage-c\r\n    command: \"echo c\"\r\n    depends_on: [\"stage-b\"]\r\n    outputs:\r\n      - path: \"out/c.txt\"\r\n        type: file\r\n"]
[2176.688527, "o", "===== pipelines/image_classifier.yaml =====\r\n"]
[2176.690562, "o", "name: image-classifier-training\r\nversion: \"1.0\"\r\n\r\nparameters:\r\n  learning_rate:\r\n    type: grid\r\n    values: [0.001, 0.01, 0.1]\r\n  batch_size:\r\n    type: grid\r\n    values: [32, 64]\r\n  optimizer:\r\n    type: grid\r\n    values: [\"adam\", \"sgd\"]\r\n\r\nstages:\r\n  - name: data-validation\r\n    command: \"./stages/validate_data.sh\"\r\n    inputs:\r\n      - path: \"data/sample\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    metrics:\r\n      - name: num_samples\r\n        objective: report\r\n      - name: corruption_rate\r\n        objective: minimize\r\n\r\n  - name: feature-extraction\r\n    command: \"./stages/extract_features.sh\"\r\n    depends_on: [\"data-validation\"]\r\n    inputs:\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"data/features.bin\"\r\n        type: file\r\n    env:\r\n      BATCH_SIZE: \"${batch_size}\"\r\n\r\n  - name: model-training\r\n"]
[2176.690673, "o", "    command: \"./stages/train_model.sh\"\r\n    depends_on: [\"feature-extraction\"]\r\n    inputs:\r\n      - path: \"data/features.bin\"\r\n        type: file\r\n    outputs:\r\n      - path: \"models/checkpoint.bin\"\r\n        type: file\r\n    env:\r\n      LEARNING_RATE: \"${learning_rate}\"\r\n      OPTIMIZER: \"${optimizer}\"\r\n      BATCH_SIZE: \"${batch_size}\"\r\n    metrics:\r\n      - name: train_loss\r\n        objective: minimize\r\n      - name: train_accuracy\r\n        objective: maximize\r\n    retry:\r\n      max_attempts: 2\r\n      backoff_seconds: 1\r\n\r\n  - name: model-evaluation\r\n    command: \"./stages/evaluate_model.sh\"\r\n    depends_on: [\"model-training\"]\r\n    inputs:\r\n      - path: \"models/checkpoint.bin\"\r\n        type: file\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"reports/evaluation.json\"\r\n        type: file\r\n    metrics:\r\n      - name: eval_accuracy\r\n        objective: maximize\r\n      - name: eval_f1\r\n        objective: maximize\r\n      - name: eval_loss\r\n        objective: minimize\r\n\r\n  "]
[2176.690758, "o", "- name: model-export\r\n    command: \"./stages/export_model.sh\"\r\n    depends_on: [\"model-evaluation\"]\r\n    condition:\r\n      metric: eval_accuracy\r\n      operator: \">=\"\r\n      threshold: 0.85\r\n    inputs:\r\n      - path: \"models/checkpoint.bin\"\r\n        type: file\r\n    outputs:\r\n      - path: \"models/exported/model.onnx\"\r\n        type: file\r\n"]
[2176.690985, "o", "===== pipelines/text_sentiment.yaml =====\r\n"]
[2176.693003, "o", "name: text-sentiment-analysis\r\nversion: \"1.0\"\r\n\r\nparameters:\r\n  embedding_dim:\r\n    type: grid\r\n    values: [128, 256]\r\n  dropout:\r\n    type: grid\r\n    values: [0.1, 0.3]\r\n\r\nstages:\r\n  - name: preprocess\r\n    command: \"./stages/validate_data.sh\"\r\n    inputs:\r\n      - path: \"data/sample\"\r\n        type: directory\r\n    outputs:\r\n      - path: \"data/validated\"\r\n        type: directory\r\n    metrics:\r\n      - name: num_samples\r\n        objective: report\r\n      - name: corruption_rate\r\n        objective: minimize\r\n\r\n"]
[2176.69308, "o", "  - name: train\r\n    command: \"./stages/train_model.sh\"\r\n    depends_on: [\"preprocess\"]\r\n    outputs:\r\n      - path: \"models/checkpoint.bin\"\r\n        type: file\r\n    env:\r\n      LEARNING_RATE: \"0.001\"\r\n      OPTIMIZER: \"adam\"\r\n      BATCH_SIZE: \"${embedding_dim}\"\r\n      DROPOUT: \"${dropout}\"\r\n    metrics:\r\n      - name: train_loss\r\n        objective: minimize\r\n      - name: train_accuracy\r\n        objective: maximize\r\n\r\n  - name: evaluate\r\n    command: \"./stages/evaluate_model.sh\"\r\n    depends_on: [\"train\"]\r\n    outputs:\r\n      - path: \"reports/evaluation.json\"\r\n        type: file\r\n    metrics:\r\n      - name: eval_accuracy\r\n        objective: maximize\r\n      - name: eval_f1\r\n        objective: maximize\r\n      - name: eval_loss\r\n        objective: minimize\r\n"]
[2176.693483, "o", "\u001b[?2004h"]
[2176.693579, "o", "root@n30009:/app# "]
[2176.974415, "i", "for f in stages/*.sh; do echo \"===== $f =====\"; cat \"$f\"; done\n"]
[2176.97488, "o", "for f in stages/*.sh; do echo \"===== $f =====\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[2176.975169, "o", "===== stages/evaluate_model.sh =====\r\n"]
[2176.977597, "o", "#!/bin/bash\r\n# Evaluates the trained model\r\nmkdir -p reports\r\nif [ ! -f \"models/checkpoint.bin\" ]; then\r\n    echo \"ERROR: No model checkpoint found\" >&2\r\n    exit 1\r\nfi\r\n\r\nMODEL_INFO=$(cat models/checkpoint.bin)\r\nLR=$(echo \"$MODEL_INFO\" | cut -d_ -f2)\r\nOPT=$(echo \"$MODEL_INFO\" | cut -d_ -f3)\r\nBS=$(echo \"$MODEL_INFO\" | cut -d_ -f4)\r\nif [ \"$OPT\" = \"adam\" ]; then OPT_VAL=1; else OPT_VAL=0; fi\r\n\r\nEVAL_ACC=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.82 + ($OPT_VAL * 0.06) - ($BS / 5000.0) - ($LR * 2)}\")\r\nEVAL_F1=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.78 + ($OPT_VAL * 0.05) - ($BS / 6000.0) - ($LR * 1.5)}\")\r\nEVAL_LOSS=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.3 - ($OPT_VAL * 0.04) + ($BS / 3000.0) + ($LR * 5)}\")\r\n\r\necho \"{\\\"eval_accuracy\\\": ${EVAL_ACC}, \\\"eval_f1\\\": ${EVAL_F1}}\" > reports/evaluation.json\r\necho \"{\\\"metric\\\": \\\"eval_accuracy\\\", \\\"value\\\": ${EVAL_ACC}}\"\r\necho \"{\\\"metric\\\": \\\"eval_f1\\\", \\\"value\\\": ${EVAL_F1}}\"\r\necho \"{\\\"metric\\\": \\\"eval_loss\\\", \\\"value\\\": ${EVAL_LOSS}}\""]
[2176.977627, "o", "\r\n"]
[2176.97807, "o", "===== stages/export_model.sh =====\r\n"]
[2176.980172, "o", "#!/bin/bash\r\n# Exports model to deployment format\r\nmkdir -p models/exported\r\nif [ ! -f \"models/checkpoint.bin\" ]; then\r\n    echo \"ERROR: No model checkpoint found\" >&2\r\n    exit 1\r\nfi\r\ncp models/checkpoint.bin models/exported/model.onnx\r\necho \"{\\\"metric\\\": \\\"export_size_mb\\\", \\\"value\\\": 0.001}\"\r\n"]
[2176.980505, "o", "===== stages/extract_features.sh =====\r\n"]
[2176.982773, "o", "#!/bin/bash\r\n# Extracts features from validated data\r\nBS=${BATCH_SIZE:-32}\r\nmkdir -p data\r\necho \"features_batch${BS}\" > data/features.bin\r\necho \"{\\\"metric\\\": \\\"feature_dim\\\", \\\"value\\\": 512}\"\r\n"]
[2176.983104, "o", "===== stages/train_model.sh =====\r\n"]
[2176.985266, "o", "#!/bin/bash\r\n# Trains a model with given hyperparameters\r\nLR=${LEARNING_RATE:-0.01}\r\nOPT=${OPTIMIZER:-adam}\r\nBS=${BATCH_SIZE:-32}\r\nDROP=${DROPOUT:-0}\r\nmkdir -p models\r\n\r\nif [ \"$OPT\" = \"adam\" ]; then OPT_VAL=1; else OPT_VAL=0; fi\r\n\r\nLOSS=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.5 - ($OPT_VAL * 0.05) + ($BS / 1000.0) + ($LR * 10) + ($DROP * 0.1)}\")\r\nACC=$(awk \"BEGIN {printf \\\"%.4f\\\", 0.8 + ($OPT_VAL * 0.03) - ($BS / 2000.0) - ($LR * 5) - ($DROP * 0.05)}\")\r\n\r\necho \"model_${LR}_${OPT}_${BS}\" > models/checkpoint.bin\r\necho \"{\\\"metric\\\": \\\"train_loss\\\", \\\"value\\\": ${LOSS}}\"\r\necho \"{\\\"metric\\\": \\\"train_accuracy\\\", \\\"value\\\": ${ACC}}\"\r\n"]
[2176.985589, "o", "===== stages/validate_data.sh =====\r\n"]
[2176.98751, "o", "#!/bin/bash\r\n# Validates input data directory and produces validated copy\r\nmkdir -p data/validated\r\nif [ -d \"data/sample\" ]; then\r\n    cp -r data/sample/* data/validated/ 2>/dev/null || true\r\nfi\r\nCOUNT=$(find data/validated -type f 2>/dev/null | wc -l)\r\necho \"{\\\"metric\\\": \\\"num_samples\\\", \\\"value\\\": ${COUNT}}\"\r\necho \"{\\\"metric\\\": \\\"corruption_rate\\\", \\\"value\\\": 0.02}\"\r\n"]
[2176.987889, "o", "\u001b[?2004h"]
[2176.987966, "o", "root@n30009:/app# "]
[2187.071369, "i", "nl -ba pipelines/image_classifier.yaml\n"]
[2187.071696, "o", "nl -ba pipelines/image_classifier.yaml\r\n\u001b[?2004l\r"]
[2187.074085, "o", "     1\tname: image-classifier-training\r\n     2\tversion: \"1.0\"\r\n     3\t\r\n     4\tparameters:\r\n     5\t  learning_rate:\r\n     6\t    type: grid\r\n"]
