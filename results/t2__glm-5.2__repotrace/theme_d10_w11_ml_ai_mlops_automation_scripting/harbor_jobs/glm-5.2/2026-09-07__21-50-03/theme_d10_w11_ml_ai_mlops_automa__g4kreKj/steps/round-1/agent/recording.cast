[1984.718272, "o", "        }\r\n   444\t    }\r\n   445\t    return \"\", \"\", false\r\n   446\t}\r\n   447\t\r\n   448\tfunc parseScalar(s string) interface{} {\r\n   449\t    s = strings.TrimSpace(s)\r\n   450\t    if s == \"\" {\r\n   451\t        return \"\"\r\n   452\t    }\r\n   453\t    if strings.HasPrefix(s, \"[\") && strings.HasSuffix(s, \"]\") {\r\n   454\t        return parseInlineList(s)\r\n   455\t    }\r\n   456\t    if strings.HasPrefix(s, \"{\") && strings.HasSuffix(s, \"}\") {\r\n   457\t"]
[1984.718347, "o", "        return parseInlineMap(s)\r\n   458\t    }\r\n   459\t    if len(s) >= 2 && (s[0] == '\"' && s[len(s)-1] == '\"' || s[0] == '\\'' && s[len(s)-1] == '\\'') {\r\n   460\t        return unquoteScalar(s)\r\n   461\t    }\r\n   462\t    if s == \"true\" {\r\n   463\t        return true\r\n   464\t    }\r\n   465\t    if s == \"false\" {\r\n"]
[1984.718416, "o", "   466\t        return false\r\n   467\t    }\r\n   468\t    if n, err := strconv.Atoi(s); err == nil {\r\n   469\t        return n\r\n   470\t    }\r\n   471\t    if f, err := strconv.ParseFloat(s, 64); err == nil {\r\n   472\t        return f\r\n   473\t    }\r\n   474\t    return s\r\n   475\t}\r\n   476\t"]
[1984.718481, "o", "\r\n   477\tfunc parseInlineList(s string) interface{} {\r\n   478\t    inner := strings.TrimSpace(s[1 : len(s)-1])\r\n   479\t    if inner == \"\" {\r\n   480\t        return []interface{}{}\r\n   481\t    }\r\n   482\t    parts := splitCommas(inner)\r\n   483\t    out := make([]interface{}, 0, len(parts))\r\n   484\t    for _, p := range parts {\r\n   485\t        out = append(out, parseScalar(strings.TrimSpace(p)))\r\n   486"]
[1984.718541, "o", "\t    }\r\n   487\t    return out\r\n   488\t}\r\n   489\t\r\n   490\tfunc parseInlineMap(s string) interface{} {\r\n   491\t    inner := strings.TrimSpace(s[1 : len(s)-1])\r\n   492\t    if inner == \"\" {\r\n   493\t        return map[string]interface{}{}\r\n   494\t    }\r\n"]
[1984.7186, "o", "   495\t    parts := splitCommas(inner)\r\n   496\t    m := map[string]interface{}{}\r\n   497\t    for _, p := range parts {\r\n   498\t        key, value, ok := splitKeyValue(strings.TrimSpace(p))\r\n   499\t        if ok {\r\n   500\t            m[key] = parseScalar(value)\r\n   501\t        }\r\n   502\t    }\r\n   503\t    return m\r\n   504\t"]
[1984.71866, "o", "}\r\n   505\t\r\n   506\tfunc splitCommas(s string) []string {\r\n   507\t    var parts []string\r\n   508\t    inQuote := false\r\n   509\t    quoteChar := byte(0)\r\n   510\t    depth := 0\r\n   511\t    start := 0\r\n   512\t    for i := 0; i < len(s); i++ {\r\n   513\t        c := s[i]\r\n"]
[1984.718718, "o", "   514\t        if inQuote {\r\n   515\t            if c == quoteChar {\r\n   516\t                inQuote = false\r\n   517\t            }\r\n   518\t            continue\r\n   519\t        }\r\n   520\t        if c == '\"' || c == '\\'' {\r\n   521\t            inQuote = true\r\n"]
[1984.718776, "o", "   522\t            quoteChar = c\r\n   523\t            continue\r\n   524\t        }\r\n   525\t        if c == '[' || c == '{' {\r\n   526\t            depth++\r\n   527\t            continue\r\n   528\t        }\r\n   529\t        if c == ']' || c == '}' {\r\n   530\t            depth--\r\n   531\t            continue\r\n"]
[1984.718833, "o", "   532\t        }\r\n   533\t        if c == ',' && depth == 0 {\r\n   534\t            parts = append(parts, s[start:i])\r\n   535\t            start = i + 1\r\n   536\t        }\r\n   537\t    }\r\n   538\t    parts = append(parts, s[start:])\r\n   539\t    return parts\r\n   540\t}\r\n   541\t"]
[1984.718892, "o", "\r\n   542\tfunc unquoteScalar(s string) string {\r\n   543\t    s = strings.TrimSpace(s)\r\n   544\t    if len(s) >= 2 && s[0] == '\"' && s[len(s)-1] == '\"' {\r\n   545\t        unq, err := strconv.Unquote(s)\r\n   546\t        if err == nil {\r\n   547\t            return unq\r\n   548\t        }\r\n   549\t"]
[1984.719005, "o", "        return s[1 : len(s)-1]\r\n   550\t    }\r\n   551\t    if len(s) >= 2 && s[0] == '\\'' && s[len(s)-1] == '\\'' {\r\n   552\t        return strings.ReplaceAll(s[1:len(s)-1], \"''\", \"'\")\r\n   553\t    }\r\n   554\t    return s\r\n   555\t}\r\n   556\t\r\n   557\tfunc mapToPipeline(v interface{}) (*Pipeline, error) {\r\n   558\t    p := &Pipeline{}\r\n   559\t    root := asMap(v)\r\n   560\t    if root == nil {\r\n   561\t        return p, nil\r\n   562\t    }\r\n   563\t    p.Name = asString(root[\"name\"])\r\n"]
[1984.71911, "o", "   564\t    p.Version = asString(root[\"version\"])\r\n   565\t    if params, ok := root[\"parameters\"].(map[string]interface{}); ok {\r\n   566\t        keys := make([]string, 0, len(params))\r\n   567\t        for k := range params {\r\n   568\t"]
[1984.719173, "o", "            keys = append(keys, k)\r\n   569\t        }\r\n   570\t        sort.Strings(keys)\r\n   571\t        for _, k := range keys {\r\n   572\t            pm := asMap(params[k])\r\n   573\t            p.Parameters = append(p.Parameters, Parameter{Name: k, Values: asSlice(pm[\"values\"])})\r\n   574\t        }\r\n   575\t    }\r\n   576\t    for _, sv := range asSlice(root[\"stages\"]) {\r\n   577\t        sm := asMap(sv)\r\n   578\t        stage := Stage{\r\n   579\t            Name:    asString(sm[\"name\"]),\r\n   580\t            Command: asString(sm[\"command\"]),\r\n   581\t        }\r\n   582\t        stage.DependsOn = toStringSlice(asSlice(sm[\"depends_on\"]))\r\n   583\t        stage.Env = toStringMap(asMap(sm[\"env\"]))\r\n"]
[1984.719242, "o", "   584\t        for _, mv := range asSlice(sm[\"metrics\"]) {\r\n   585\t            mm := asMap(mv)\r\n   586\t            stage.Metrics = append(stage.Metrics, Metric{Name: asString(mm[\"name\"]), Objective: asString(mm[\"objective\"])})\r\n   587\t        }\r\n   588\t        if rv := asMap(sm[\"retry\"]); rv != nil {\r\n   589\t            stage.Retry = &Retry{MaxAttempts: asInt(rv[\"max_attempts\"]), BackoffSeconds: asFloat(rv[\"backoff_seconds\"])}\r\n   590\t        }\r\n   591\t        if cv := asMap(sm[\"condition\"]); cv != nil {\r\n   592\t            stage.Condition = &Condition{Metric: asString(cv[\"metric\"]), Operator: asString(cv[\"operator\"]), Threshold: asFloat(cv[\"threshold\"])}\r\n   593\t        }\r\n   594\t"]
[1984.719306, "o", "        for _, ov := range asSlice(sm[\"outputs\"]) {\r\n   595\t            om := asMap(ov)\r\n   596\t            stage.Outputs = append(stage.Outputs, ArtifactRef{Path: asString(om[\"path\"]), Type: asString(om[\"type\"])})\r\n   597\t        }\r\n   598\t        for _, iv := range asSlice(sm[\"inputs\"]) {\r\n   599\t            im := asMap(iv)\r\n   600\t            stage.Inputs = append(stage.Inputs, ArtifactRef{Path: asString(im[\"path\"]), Type: asString(im[\"type\"])})\r\n   601\t        }\r\n   602\t        p.Stages = append(p.Stages, stage)"]
[1984.719417, "o", "\r\n   603\t    }\r\n   604\t    return p, nil\r\n   605\t}\r\n   606\t\r\n   607\tfunc asMap(v interface{}) map[string]interface{} {\r\n   608\t    if m, ok := v.(map[string]interface{}); ok {\r\n   609\t        return m\r\n   610\t    }\r\n   611\t    return nil\r\n   612\t}\r\n   613\t\r\n   614\tfunc asSlice(v interface{}) []interface{} {\r\n   615\t    if s, ok := v.([]interface{}); ok {\r\n   616\t        return s\r\n   617\t    }\r\n"]
[1984.719476, "o", "   618\t    return nil\r\n   619\t}\r\n   620\t\r\n   621\tfunc asString(v interface{}) string {\r\n   622\t    if v == nil {\r\n   623\t        return \"\"\r\n   624\t    }\r\n"]
[1984.71954, "o", "   625\t    switch x := v.(type) {\r\n   626\t    case string:\r\n   627\t        return x\r\n   628\t    case int:\r\n   629\t        return strconv.Itoa(x)\r\n   630\t    case float64:\r\n   631\t        return formatFloat(x)\r\n   632\t    case bool:\r\n   633\t        return strconv.FormatBool(x)\r\n   634\t    default:\r\n   635\t        return fmt.Sprint(x)\r\n   636\t    }\r\n"]
[1984.719599, "o", "   637\t}\r\n   638\t\r\n   639\tfunc asInt(v interface{}) int {\r\n   640\t    switch x := v.(type) {\r\n   641\t    case int:\r\n   642\t        return x\r\n   643\t    case float64:\r\n   644\t        return int(x)\r\n   645\t    case string:\r\n"]
[1984.719658, "o", "   646\t        n, _ := strconv.Atoi(x)\r\n   647\t        return n\r\n   648\t    default:\r\n   649\t        return 0\r\n   650\t    }\r\n   651\t}\r\n   652\t\r\n   653\t"]
[1984.719719, "o", "func asFloat(v interface{}) float64 {\r\n   654\t    switch x := v.(type) {\r\n   655\t    case float64:\r\n   656\t        return x\r\n   657\t    case int:\r\n   658\t        return float64(x)\r\n   659\t    case string:\r\n   660\t        f, _ := strconv.ParseFloat(x, 64)\r\n"]
