[8204.388304, "o", "   857\t\treturn filepath.Join(stateDir(experimentID), stageName+\".json\")\r\n   858\t}\r\n   859\t\r\n   860\tfunc experimentStateExists(id string) bool {\r\n   861\t\tinfo, err := os.Stat(stateDir(id))\r\n   862\t\treturn err == nil && info.IsDir()\r\n   863\t}\r\n   864\t\r\n   865\tfunc readStageState(experimentID, stageName string) (*StageState, error) {\r\n   866\t\tdata, err := os.ReadFile(stageStatePath(experimentID, stageName))\r\n   867\t\tif err != nil {\r\n   868\t\t\treturn nil, err\r\n   869\t\t}\r\n   870\t\tvar st StageState\r\n   871\t\tif err := json.Unmarshal(data, &st); err != nil {\r\n   872\t\t\treturn nil, err\r\n   873\t\t}\r\n   874\t\treturn &st, nil\r\n   875\t}\r\n   876\t\r\n   877\tfunc writeStageState(experimentID, stageName string, st *StageState) error {\r\n   878\t\tif err := os.MkdirAll(stateDir(experimentID), 0755); err != nil {\r\n   879\t\t\treturn err\r\n   880\t\t}\r\n   881\t\tdata, err := json.MarshalIndent(st, \"\", \"  \")\r\n   882\t\tif err != nil {\r\n   883\t\t\treturn err\r\n   884\t\t}\r\n   885\t\treturn os.WriteFile(stageStatePath(experimentID, stageName), data, 0644)\r\n"]
