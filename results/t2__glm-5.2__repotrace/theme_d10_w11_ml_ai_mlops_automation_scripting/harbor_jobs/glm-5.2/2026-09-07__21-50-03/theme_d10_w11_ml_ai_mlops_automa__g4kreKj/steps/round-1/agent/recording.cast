[4123.496054, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path(\"main.go\")\ns = p.read_text()\nold = '''\\t\\t\\tfor _, m := range st.Metrics {\n\\t\\t\\t\\texp.Metrics[m.Name] = m.Value\n\\t\\t\\t\\tmetricValues[m.Name] = append(metricValues[m.Name], m.Value)\n\\t\\t\\t}\n'''\nnew = '''\\t\\t\\tfor _, m := range st.Metrics {\n\\t\\t\\t\\texp.Metrics[m.Name] = m.Value\n\\t\\t\\t}\n'''\nif old not in s:\n    raise SystemExit(\"stage loop pattern not found\")\ns = s.replace(old, new, 1)\nold2 = '''\\t\\tout.Experiments = append(out.Experiments, exp)\n\\t}\n\\tfor name, values := range metricValues {\n'''\nnew2 = '''\\t\\tfor name, value := range exp.Metrics {\n\\t\\t\\tmetricValues[name] = append(metricValues[name], value)\n\\t\\t}\n\\t\\tout.Experiments = append(out.Experiments, exp)\n\\t}\n\\tfor name, values := range metricValues {\n'''\nif old2 not in s:\n    raise SystemExit(\"append loop pattern not found\")\ns = s.replace(old2, new2, 1)\np.write_text(s)\nPY\n"]
