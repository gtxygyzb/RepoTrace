[3314.143503, "o", "    28\t\tcmd := os.Args[1]\r\n    29\t\targs := os.Args[2:]\r\n    30\t\r\n    31\t\tswitch cmd {\r\n    32\t\tcase \"validate\":\r\n    33\t\t\tos.Exit(cmdValidate(args))\r\n"]
[3314.143563, "o", "    34\t\tcase \"plan\":\r\n    35\t\t\tos.Exit(cmdPlan(args))\r\n    36\t\tcase \"run\":\r\n    37\t\t\tos.Exit(cmdRun(args))\r\n    38\t\tcase \"report\":\r\n    39\t\t\tos.Exit(cmdReport(args))\r\n    40\t\tcase \"artifacts\":\r\n    41\t\t\tos.Exit(cmdArtifacts(args))\r\n    42\t\tcase \"compare\":\r\n"]
[3314.143622, "o", "    43\t\t\tos.Exit(cmdCompare(args))\r\n    44\t\tdefault:\r\n    45\t\t\tfmt.Fprintf(os.Stderr, \"error: command %q is not implemented\\n\", cmd)\r\n    46\t\t\tos.Exit(1)\r\n    47\t\t}\r\n    48\t}\r\n    49\t\r\n"]
[3314.143682, "o", "    50\tfunc cmdValidate(args []string) int {\r\n    51\t\tif len(args) < 1 {\r\n    52\t\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe validate <pipeline.yaml>\")\r\n    53\t\t\treturn 1\r\n    54\t\t}\r\n    55\t\tp, err := loadPipeline(args[0])\r\n    56\t\tif err != nil {\r\n    57\t\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n    58\t\t\treturn 1\r\n    59\t\t}\r\n    60\t\terrs := validatePipeline(p)\r\n"]
[3314.143742, "o", "    61\t\tif len(errs) > 0 {\r\n    62\t\t\tfor _, e := range errs {\r\n    63\t\t\t\tfmt.Println(e)\r\n    64\t\t\t}\r\n    65\t\t\treturn 1\r\n    66\t\t}\r\n    67\t\treturn 0\r\n    68\t}\r\n"]
