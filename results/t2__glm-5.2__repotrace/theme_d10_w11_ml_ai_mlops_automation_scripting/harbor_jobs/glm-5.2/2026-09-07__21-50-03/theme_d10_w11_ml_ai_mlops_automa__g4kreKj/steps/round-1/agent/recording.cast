[4046.437623, "i", "python3 - <<'PY'\nimport json, math, glob, os, subprocess\n\npipeline = 'pipelines/image_classifier.yaml'\nmetric = 'train_loss'\nparam = 'learning_rate'\n\n# parse parameter values from YAML simply by reading the file\nimport re\ntext = open(pipeline).read()\nparams = {}\nfor m in re.finditer(r'- name: (\\w+)\\n(?:\\s+values:\\n((?:\\s+- .+\\n)+))', text):\n    name = m.group(1)\n    vals = [v.strip().strip('\"').strip(\"'\") for v in re.findall(r'- (.+)', m.group(2))]\n    params[name] = vals\nprint('param values:', params[param])\n\ngroups = {}\nfor d in glob.glob('.mlpipe/state/exp_*'):\n    combo = {}\n    name = os.path.basename(d)[4:]\n    for part in name.split('_'):\n        if '=' in part:\n            k, v = part.split('=', 1)\n            combo[k] = v\n    if param not in combo:\n        continue\n    val = combo[param]\n    for state_file in glob.glob(os.path.join(d, '*.json')):\n        st = json.load(open(state_file))\n        if st.get('status') != 'completed':\n            continue\n        for m in st.get('metrics', []):\n          "]
[4046.437842, "i", "  if m['name'] == metric:\n                groups.setdefault(val, []).append(m['value'])\n\nvalues = sorted(groups)\nprint('groups:', values)\nallvals = [x for v in values for x in groups[v]]\ngrand_mean = sum(allvals)/len(allvals)\nk = len(values)\nn = len(allvals)\nbetween = 0.0\nwithin = 0.0\nfor v in values:\n    obs = groups[v]\n    mean = sum(obs)/len(obs)\n    var = sum((x-mean)**2 for x in obs)/(len(obs)-1) if len(obs)>1 else 0.0\n    between += len(obs)*(mean-grand_mean)**2\n    within += (len(obs)-1)*var\nbetween /= (k-1)\nwithin /= (n-k)\nf = between/within if within else None\npooled = math.sqrt(within)\nmaxmean = max(sum(groups[v])/len(groups[v]) for v in values)\nminmean = min(sum(groups[v])/len(groups[v]) for v in values)\nes = (maxmean-minmean)/pooled if pooled else None\nprint('independent f:', round(f,4) if f is not None else None)\nprint('independent effect_size:', round(es,4) if es is not None else None)\n\nout = subprocess.check_output(['./mlpipe','sweep',pipeline,'--metric',metric,'--param',param])\nd = json.loads("]
