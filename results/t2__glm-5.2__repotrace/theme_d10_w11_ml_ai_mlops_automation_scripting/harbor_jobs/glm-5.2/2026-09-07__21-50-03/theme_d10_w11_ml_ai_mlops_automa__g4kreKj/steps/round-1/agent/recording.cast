[3290.082843, "o", "if err := enc.Encode(idx); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc artifactsGC(p *Pipeline) int {\r\n\texpected := make(map[string]bool)\r\n\tfor _, combo := range parameterCombinations(p) {\r\n\t\texpected[experimentID(combo)] = true\r\n\t}\r\n\tentries, err := os.ReadDir(filepath.Join(\".mlpipe\", \"state\"))\r\n\tif err != nil {\r\n\t\treturn 0\r\n\t}\r\n\tfor _, entry := range entries {\r\n\t\tif !expected[entry.Name()] {\r\n\t\t\t_ = os.RemoveAll(filepath.Join(\".mlpipe\", \"state\", entry.Name()))\r\n\t\t}\r\n\t}\r\n\treturn 0\r\n"]
[3290.082918, "o", "}\r\n\r\nfunc reportPipeline(p *Pipeline) int {\r\n\ttype reportExperiment struct {\r\n\t\tID      string             `json:\"id\"`\r\n\t\tMetrics map[string]float64 `json:\"metrics\"`\r\n\t\tStages  []StageState       `json:\"stages\"`\r\n\t}"]
[3290.08302, "o", "\r\n\ttype reportOutput struct {\r\n\t\tPipeline    string             `json:\"pipeline\"`\r\n\t\tExperiments []reportExperiment `json:\"experiments\"`\r\n\t}\r\n\r\n\tout := reportOutput{Pipeline: p.Name, Experiments: []reportExperiment{}}\r\n\tfor _, combo := range parameterCombinations(p) {\r\n\t\tid := experimentID(combo)\r\n\t\texp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}\r\n\t\tfor _, stage := range p.Stages {\r\n\t\t\tif st, err := readStageState(id, stage.Name); err == nil {\r\n\t\t\t\texp.Stages = append(exp.Stages, *st)\r\n\t\t\t\tfor _, m := range st.Metrics {\r\n\t\t\t\t\texp.Metrics[m.Name] = m.Value\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n"]
[3290.083082, "o", "\t\tout.Experiments = append(out.Experiments, exp)\r\n\t}\r\n\tenc := json.NewEncoder(os.Stdout)\r\n\tenc.SetIndent(\"\", \"  \")\r\n\tif err := enc.Encode(out); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n"]
[3290.083151, "o", "}\r\n\r\nfunc runExperiment(p *Pipeline, combo map[string]interface{}, resume bool) error {\r\n\tid := experimentID(combo)\r\n\tstageMap := make(map[string]Stage)\r\n\tfor _, stage := range p.Stages {\r\n\t\tstageMap[stage.Name] = stage\r\n\t}\r\n\tgroups, err := topologicalGroups(p)\r\n\tif err != nil {\r\n\t\treturn err\r\n"]
[3290.083214, "o", "\t}\r\n\tmetrics := make(map[string]float64)\r\n\tfor _, group := range groups {\r\n\t\tfor _, name := range group {\r\n\t\t\tstage := stageMap[name]\r\n\t\t\tif resume {\r\n\t\t\t\tif st, err := readStageState(id, name); err == nil && (st.Status == \"completed\" || st.Status == \"skipped\") {\r\n\t\t\t\t\tfor _, m := range st.Metrics {\r\n"]
[3290.083271, "o", "\t\t\t\t\t\tmetrics[m.Name] = m.Value\r\n\t\t\t\t\t}\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif stage.Condition != nil {\r\n\t\t\t\tval, ok := metrics[stage.Condition.Metric]\r\n\t\t\t\tif !ok || !compareMetric(val, stage.Condition.Operator, stage.Condition.Threshold) {\r\n"]
[3290.083329, "o", "\t\t\t\t\tst := &StageState{\r\n\t\t\t\t\t\tName:      name,\r\n\t\t\t\t\t\tStatus:    \"skipped\",\r\n\t\t\t\t\t\tExitCode:  0,\r\n\t\t\t\t\t\tStartTime: time.Now().Format(time.RFC3339),\r\n\t\t\t\t\t\tEndTime:   time.Now().Format(time.RFC3339),\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif err := writeStageState(id, name, st); err != nil {\r\n"]
[3290.083387, "o", "\t\t\t\t\t\treturn err\r\n\t\t\t\t\t}\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tst, err := runStage(id, stage, combo)\r\n"]
[3290.083445, "o", "\t\t\tif err != nil {\r\n\t\t\t\treturn err\r\n\t\t\t}\r\n\t\t\tfor _, m := range st.Metrics {\r\n\t\t\t\tmetrics[m.Name] = m.Value\r\n\t\t\t}\r\n\t\t\t_ = updateArtifactIndex(id, name, stage)\r\n\t\t}\r\n\t}\r\n"]
[3290.083503, "o", "\treturn nil\r\n}\r\n\r\nfunc runStage(experimentID string, stage Stage, combo map[string]interface{}) (*StageState, error) {\r\n\tmaxAttempts := 1\r\n\tbackoff := 0.0\r\n\tif stage.Retry != nil && stage.Retry.MaxAttempts > 0 {\r\n\t\tmaxAttempts = stage.Retry.MaxAttempts\r\n\t\tbackoff = stage.Retry.BackoffSeconds\r\n"]
[3290.083573, "o", "\t}\r\n\tvar lastErr error\r\n\tfor attempt := 1; attempt <= maxAttempts; attempt++ {\r\n\t\tcmd := exec.Command(\"sh\", \"-c\", stage.Command)\r\n\t\tcmd.Env = os.Environ()\r\n\t\tfor k, v := range stage.Env {\r\n\t\t\tcmd.Env = append(cmd.Env, k+\"=\"+substituteParams(v, combo))\r\n\t\t}\r\n\t\tvar stdout bytes.Buffer\r\n"]
[3290.083637, "o", "\t\tcmd.Stdout = &stdout\r\n\t\tcmd.Stderr = os.Stderr\r\n\t\tstart := time.Now()\r\n\t\trunErr := cmd.Run()\r\n\t\tif runErr == nil {\r\n\t\t\tst := &StageState{\r\n\t\t\t\tName:      stage.Name,\r\n\t\t\t\tStatus:    \"completed\",\r\n\t\t\t\tExitCode:  0,\r\n"]
[3290.083694, "o", "\t\t\t\tMetrics:   parseMetrics(stdout.String()),\r\n\t\t\t\tStartTime: start.Format(time.RFC3339),\r\n\t\t\t\tEndTime:   time.Now().Format(time.RFC3339),\r\n\t\t\t\tRetries:   attempt - 1,\r\n\t\t\t}\r\n\t\t\tif err := writeStageState(experimentID, stage.Name, st); err != nil {\r\n\t\t\t\treturn nil, err\r\n"]
[3290.083753, "o", "\t\t\t}\r\n\t\t\treturn st, nil\r\n\t\t}\r\n\t\tlastErr = runErr\r\n\t\tif attempt < maxAttempts && backoff > 0 {\r\n\t\t\ttime.Sleep(time.Duration(backoff * float64(time.Second)))\r\n\t\t}\r\n\t}\r\n\tst := &StageState{\r\n\t\tName:      stage.Name,\r\n"]
[3290.083834, "o", "\t\tStatus:    \"failed\",\r\n\t\tExitCode:  exitCodeFromError(lastErr),\r\n\t\tStartTime: time.Now().Format(time.RFC3339),\r\n\t\tEndTime:   time.Now().Format(time.RFC3339),\r\n\t\tRetries:   maxAttempts - 1,\r\n\t}\r\n\t_ = writeStageState(experimentID, stage.Name, st)\r\n\treturn nil, fmt.Errorf(\"stage %s failed: %w\", stage.Name, lastErr)\r\n}\r\n\r\nfunc parseMetrics(output string) []MetricData {\r\n\tvar metrics []MetricData\r\n"]
[3290.083899, "o", "\tscanner := bufio.NewScanner(strings.NewReader(output))\r\n\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n\t\tif line == \"\" || !strings.HasPrefix(line, \"{\") {\r\n\t\t\tcontinue\r\n"]
