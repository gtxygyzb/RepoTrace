[8115.486297, "o", "\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KparseBlock(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KparseSequence(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n\u001b[32m\u001b[K397\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KparseMapping(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n"]
[8115.486368, "o", "\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KisMappingStart(s string) bool {\r\n\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KsplitKeyValue(s string) (string, string, bool) {\r\n\u001b[32m\u001b[K456\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KparseScalar(s string) interface{} {\r\n\u001b[32m\u001b[K485\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KparseInlineList(s string) interface{} {\r\n\u001b[32m\u001b[K498\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KparseInlineMap(s string) interface{} {\r\n\u001b[32m\u001b[K514\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KsplitCommas(s string) []string {\r\n\u001b[32m\u001b[K550\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KunquoteScalar(s string) string {\r\n\u001b[32m\u001b[K565\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KmapToPipeline(v interface{}) (*Pipeline, error) {\r\n\u001b[32m\u001b[K615\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KasMap(v interface{}) map[string]interface{} {\r\n\u001b[32m\u001b[K622\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KasSlice(v interface{}) []interface{} {\r\n"]
