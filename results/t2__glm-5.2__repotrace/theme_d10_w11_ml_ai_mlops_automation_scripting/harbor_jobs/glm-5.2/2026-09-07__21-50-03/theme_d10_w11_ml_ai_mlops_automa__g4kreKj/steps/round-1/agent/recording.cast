[8116.364704, "i", "sed -n '700,1100p' main.go\n"]
[8116.365003, "o", "sed -n '700,1100p' main.go\r\n\u001b[?2004l\r"]
[8116.368047, "o", "\r\n\tfor i, stage := range p.Stages {\r\n\t\tif stage.Name == \"\" {\r\n\t\t\terrs = append(errs, fmt.Sprintf(\"stage %d: missing required field name\", i))\r\n\t"]
[8116.368186, "o", "\t}\r\n\t\tif stage.Command == \"\" {\r\n\t\t\terrs = append(errs, fmt.Sprintf(\"stage %d: missing required field command\", i))\r\n\t\t}\r\n\t\tif stage.Name != \"\" {\r\n\t\t\tif prev, ok := names[stage.Name]; ok {\r\n\t\t\t\terrs = append(errs, fmt.Sprintf(\"duplicate stage name: %s (stages %d and %d)\", stage.Name, prev, i))\r\n\t\t\t} else {\r\n\t\t\t\tnames[stage.Name] = i\r\n\t\t\t}\r\n\t\t\tstageSet[stage.Name] = true\r\n\t\t\tstageMap[stage.Name] = stage\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, stage := range p.Stages {\r\n\t\tfor _, dep := range stage.DependsOn {\r\n\t\t\tif !stageSet[dep] {\r\n"]
[8116.368287, "o", "\t\t\t\terrs = append(errs, fmt.Sprintf(\"stage %q depends on undefined stage %q\", stage.Name, dep))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, stage := range p.Stages {\r\n\t\tif stage.Name == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tstate := make(map[string]int)\r\n\t\tvar check func(name string)\r\n\t\tcheck = func(name string) {\r\n\t\t\tstate[name] = 1\r\n\t\t\tfor _, dep := range stageMap[name].DependsOn {\r\n\t\t\t\tif !stageSet[dep] {\r\n\t\t\t\t\t"]
[8116.368359, "o", "continue\r\n\t\t\t\t}\r\n\t\t\t\tif state[dep] == 1 {\r\n\t\t\t\t\terrs = append(errs, fmt.Sprintf(\"circular dependency detected involving stage: %s\", name))\r\n\t\t\t\t} else if state[dep] == 0 {\r\n\t\t\t\t\tcheck(dep)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tstate[name] = 2\r\n\t\t}\r\n\t\tcheck(stage.Name)\r\n"]
[8116.368445, "o", "\t}\r\n\r\n\treturn errs\r\n}\r\n\r\nfunc topologicalGroups(p *Pipeline) ([][]string, error) {\r\n\tstageMap := make(map[string]Stage)\r\n\tfor _, stage := range p.Stages {"]
[8116.368514, "o", "\r\n\t\tstageMap[stage.Name] = stage\r\n\t}\r\n\r\n\tcompleted := make(map[string]bool)\r\n\tremaining := make(map[string]bool)\r\n\tfor _, stage := range p.Stages {\r\n\t\tremaining[stage.Name] = true\r\n\t}\r\n\r\n\tvar groups [][]string\r\n\tfor len(remaining) > 0 {\r\n\t\tvar ready []string\r\n\t\tfor name := range remaining {\r\n\t\t\tok := true\r\n\t\t\tfor _, dep := range stageMap[name].DependsOn {\r\n\t\t\t\tif !completed[dep] {\r\n\t\t\t\t\tok = false\r\n\t\t\t\t\tbreak\r\n"]
[8116.368587, "o", "\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif ok {\r\n\t\t\t\tready = append(ready, name)\r\n\t\t\t}\r\n\t\t}\r\n\t\tsort.Strings(ready)\r\n\t\tif len(ready) == 0 {\r\n\t\t\treturn nil, fmt.Errorf(\"circular dependency detected among stages: %v\", sortedKeys(remaining))\r\n\t\t}\r\n\t"]
[8116.368659, "o", "\tgroups = append(groups, ready)\r\n\t\tfor _, name := range ready {\r\n\t\t\tcompleted[name] = true\r\n\t\t\tdelete(remaining, name)\r\n\t\t}\r\n\t}\r\n\treturn groups, nil\r\n}\r\n\r\nfunc parameterCombinations(p *Pipeline) []map[string]interface{} {\r\n\tif len(p.Parameters) == 0 {\r\n\t\treturn []map[string]interface{}{{}}\r\n\t}\r\n"]
[8116.368723, "o", "\tcombos := []map[string]interface{}{{}}\r\n\tfor _, param := range p.Parameters {\r\n\t\tnext := make([]map[string]interface{}, 0, len(combos)*len(param.Values))\r\n\t\tfor _, combo := range combos {\r\n\t\t\tfor _, value := range param.Values {\r\n\t\t\t\tc := copyMap(combo)\r\n\t\t\t\tc[param.Name] = value\r\n\t\t\t\tnext = append(next, c)\r\n\t\t\t}\r\n"]
[8116.368785, "o", "\t\t}\r\n\t\tcombos = next\r\n\t}\r\n\treturn combos\r\n}\r\n\r\nfunc experimentID(combo map[string]interface{}) string {\r\n\tif len(combo) == 0 {\r\n\t\treturn \"exp_default\"\r\n\t}\r\n\tkeys := make([]string, 0, len(combo))\r\n"]
[8116.368844, "o", "\tfor k := range combo {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n\tsort.Strings(keys)\r\n\tparts := make([]string, 0, len(keys))\r\n\tfor _, k := range keys {\r\n\t\tparts = append(parts, k+\"=\"+asString(combo[k]))\r\n\t}\r\n\treturn \"exp_\" + strings.Join(parts, \"_\")\r\n}\r\n"]
[8116.368903, "o", "\r\nfunc substituteParams(value string, combo map[string]interface{}) string {\r\n\tfor k, v := range combo {\r\n\t\tvalue = strings.ReplaceAll(value, \"${\"+k+\"}\", asString(v))\r\n\t}\r\n\treturn value\r\n}\r\n\r\nfunc copyMap(m map[string]interface{}) map[string]interface{} {\r\n\tout := make(map[string]interface{}, len(m))\r\n\t"]
[8116.368983, "o", "for k, v := range m {\r\n\t\tout[k] = v\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc sortedKeys(m map[string]bool) []string {\r\n\tkeys := make([]string, 0, len(m))\r\n\tfor k := range m {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n\tsort.Strings(keys)\r\n"]
[8116.369047, "o", "\treturn keys\r\n}\r\n\r\nfunc stateDir(experimentID string) string {\r\n\treturn filepath.Join(\".mlpipe\", \"state\", experimentID)\r\n}\r\n\r\nfunc stageStatePath(experimentID, stageName string) string {\r\n\treturn filepath.Join(stateDir(experimentID), stageName+\".json\")\r\n}\r\n\r\nfunc experimentStateExists(id string) bool {\r\n"]
[8116.36911, "o", "\tinfo, err := os.Stat(stateDir(id))\r\n\treturn err == nil && info.IsDir()\r\n}\r\n\r\nfunc readStageState(experimentID, stageName string) (*StageState, error) {\r\n\tdata, err := os.ReadFile(stageStatePath(experimentID, stageName))\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\t"]
[8116.369148, "o", "var st StageState\r\n\tif err := json.Unmarshal(data, &st); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn &st, nil\r\n}\r\n\r\n"]
[8116.369235, "o", "func writeStageState(experimentID, stageName string, st *StageState) error {\r\n\tif err := os.MkdirAll(stateDir(experimentID), 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdata, err := json.MarshalIndent(st, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(stageStatePath(experimentID, stageName), data, 0644)\r\n}\r\n\r\nfunc artifactsIndexPath() string {\r\n\treturn filepath.Join(\".mlpipe\", \"artifacts\", \"index.json\")\r\n}\r\n\r\n"]
[8116.3693, "o", "func loadArtifactIndex() *ArtifactIndex {\r\n\tidx := &ArtifactIndex{}\r\n\tdata, err := os.ReadFile(artifactsIndexPath())\r\n\tif err != nil {\r\n\t\treturn idx\r\n\t}\r\n\tif err := json.Unmarshal(data, idx); err != nil {\r\n\t\treturn &ArtifactIndex{}\r\n\t}\r\n\treturn idx\r\n}\r\n"]
[8116.369364, "o", "\r\nfunc saveArtifactIndex(idx *ArtifactIndex) error {\r\n\tif err := os.MkdirAll(filepath.Dir(artifactsIndexPath()), 0755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdata, err := json.MarshalIndent(idx, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(artifactsIndexPath(), data, 0644)\r\n}"]
[8116.36943, "o", "\r\n\r\nfunc artifactsList() int {\r\n\tidx := loadArtifactIndex()\r\n\tenc := json.NewEncoder(os.Stdout)\r\n\tenc.SetIndent(\"\", \"  \")\r\n\tif err := enc.Encode(idx); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[8116.369497, "o", "\r\nfunc artifactsGC(p *Pipeline) int {\r\n\texpected := make(map[string]bool)\r\n\tfor _, combo := range parameterCombinations(p) {\r\n\t\texpected[experimentID(combo)] = true\r\n\t}\r\n"]
[8116.369559, "o", "\tentries, err := os.ReadDir(filepath.Join(\".mlpipe\", \"state\"))\r\n\tif err != nil {\r\n\t\treturn 0\r\n\t}\r\n\tfor _, entry := range entries {\r\n\t\tif !expected[entry.Name()] {\r\n\t\t\t_ = os.RemoveAll(filepath.Join(\".mlpipe\", \"state\", entry.Name()))\r\n\t\t}\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc reportPipeline(p *Pipeline) int {\r\n"]
[8116.369643, "o", "\ttype reportExperiment struct {\r\n\t\tID      string             `json:\"id\"`\r\n\t\tMetrics map[string]float64 `json:\"metrics\"`\r\n\t\tStages  []StageState       `json:\"stages\"`\r\n\t}\r\n\ttype sensitivityEntry struct {\r\n\t\tBestWithout  string  `json:\"best_without\"`\r\n\t\tMaxComposite float64 `json:\"max_composite\"`\r\n\t}\r\n\ttype reportOutput struct {\r\n\t\tPipeline          string                        `json:\"pipeline\"`\r\n\t\tExperiments       []reportExperiment            `json:\"experiments\"`\r\n\t\tMetricSummary     map[string]metricSummaryEntry `json:\"metric_summary\"`\r\n"]
[8116.369709, "o", "\t\tMetricRankings    map[string]map[string]int     `json:\"metric_rankings\"`\r\n\t\tCompositeScores   map[string]float64            `json:\"composite_scores\"`\r\n\t\tNormalizedMetrics map[string]map[string]float64 `json:\"normalized_metrics\"`\r\n\t\tMetricImportance  map[string]float64            `json:\"metric_importance\"`\r\n\t\tScoreSensitivity  map[string]sensitivityEntry   `json:\"score_sensitivity\"`\r\n\t\tBestExperiment    string                        `json:\"best_experiment\"`\r\n\t}\r\n\r\n\tout := reportOutput{\r\n\t\tPipeline:          p.Name,\r\n\t\tExperiments:       []reportExperiment{},"]
[8116.369773, "o", "\r\n\t\tMetricSummary:     map[string]metricSummaryEntry{},\r\n\t\tMetricRankings:    map[string]map[string]int{},\r\n\t\tCompositeScores:   map[string]float64{},\r\n\t\tNormalizedMetrics: map[string]map[string]float64{},\r\n\t\tMetricImportance:  map[string]float64{},\r\n\t\tScoreSensitivity:  map[string]sensitivityEntry{},\r\n\t}\r\n\tmetricValues := map[string][]float64{}\r\n\tfor _, combo := range parameterCombinations(p) {\r\n\t"]
[8116.369862, "o", "\tid := experimentID(combo)\r\n\t\texp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}\r\n\t\tfor _, stage := range p.Stages {\r\n\t\t\tif st, err := readStageState(id, stage.Name); err == nil {\r\n\t\t\t\texp.Stages = append(exp.Stages, *st)\r\n\t\t\t\tfor _, m := range st.Metrics {\r\n\t\t\t\t\texp.Metrics[m.Name] = m.Value\r\n\t\t\t\t\tmetricValues[m.Name] = append(metricValues[m.Name], m.Value)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tout.Experiments = append(out.Experiments, exp)\r\n\t}\r\n\tfor name, values := range metricValues {\r\n\t\tout.MetricSummary[name] = metricSummaryEntry{\r\n\t"]
[8116.369957, "o", "\t\tCount: len(values),\r\n\t\t\tMean:  round4(meanValue(values)),\r\n\t\t\tStd:   round4(sampleStd(values)),\r\n\t\t\tMin:   round4(minValue(values)),\r\n"]
[8116.370022, "o", "\t\t\tMax:   round4(maxValue(values)),\r\n\t\t}\r\n\t}\r\n\r\n\tobjectives := map[string]string{}\r\n\tfor _, stage := range p.Stages {\r\n\t\tfor _, m := range stage.Metrics {\r\n\t\t\tif m.Objective == \"minimize\" || m.Objective == \"maximize\" {\r\n\t\t\t\tobjectives[m.Name] = m.Objective\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tobjMetrics := make([]string, 0, len(objectives))\r\n\tfor m := range objectives {\r\n\t\tif _, ok := metricValues[m]; ok {\r\n\t\t\tobjMetrics = append(objMetrics, m)\r\n\t\t}\r\n"]
[8116.370085, "o", "\t}\r\n\tsort.Strings(objMetrics)\r\n\r\n\tif len(objMetrics) > 0 {\r\n\t\tminVal := map[string]float64{}\r\n\t\tmaxVal := map[string]float64{}\r\n\t\tfor _, m := range objMetrics {\r\n\t\t\tif vals, ok := metricValues[m]; ok && len(vals) > 0 {\r\n\t\t\t\tminVal[m] = minValue(vals)\r\n\t\t\t\tmaxVal[m] = maxValue(vals)\r\n\t\t\t}\r\n\t"]
[8116.370148, "o", "\t}\r\n\r\n\t\tnormalized := make([]map[string]float64, len(out.Experiments))\r\n\t\tfor i, exp := range out.Experiments {\r\n\t\t\tnormalized[i] = make(map[string]float64)\r\n\t\t\tnormOut := make(map[string]float64)\r\n\t\t\tfor _, m := range objMetrics {\r\n\t\t\t\tval, ok := exp.Metrics[m]\r\n"]
[8116.370217, "o", "\t\t\t\tif !ok {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\trng := maxVal[m] - minVal[m]\r\n\t\t\t\tvar norm float64\r\n\t\t\t\tif rng == 0 {\r\n\t\t\t\t\tnorm = 0.5\r\n\t\t\t\t} else if objectives[m] == \"maximize\" {\r\n\t\t\t\t\tnorm = (val - minVal[m]) / rng\r\n\t\t\t\t} else {\r\n"]
[8116.370282, "o", "\t\t\t\t\tnorm = (maxVal[m] - val) / rng\r\n\t\t\t\t}\r\n\t\t\t\tnormalized[i][m] = norm\r\n\t\t\t\tnormOut[m] = round4(norm)\r\n\t\t\t}\r\n\t\t\tout.NormalizedMetrics[exp.ID] = normOut\r\n\t\t}\r\n\r\n"]
[8116.370344, "o", "\t\tcomposite := make([]float64, len(out.Experiments))\r\n\t\tfor i := range out.Experiments {\r\n\t\t\tif len(normalized[i]) == 0 {\r\n\t\t\t\tcomposite[i] = 0\r\n\t\t\t} else {\r\n\t\t\t\tsum := 0.0\r\n\t\t\t\tfor _, m := range objMetrics {\r\n\t\t\t\t\tif norm, ok := normalized[i][m]; ok {\r\n\t\t\t\t\t\tsum += norm\r\n"]
[8116.370409, "o", "\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tcomposite[i] = sum / float64(len(normalized[i]))\r\n\t\t\t}\r\n\t\t\tout.CompositeScores[out.Experiments[i].ID] = round4(composite[i])\r\n\t\t}\r\n\r\n\t\tfor _, m := range objMetrics {\r\n\t\t\tout.MetricRankings[m] = map[string]int{}\r\n\t\t\t"]
[8116.370472, "o", "type idxVal struct {\r\n\t\t\t\tidx int\r\n\t\t\t\tval float64\r\n\t\t\t}\r\n\t\t\tvar items []idxVal\r\n\t\t\tfor i, exp := range out.Experiments {\r\n\t\t\t\tif val, ok := exp.Metrics[m]; ok {\r\n\t\t\t\t\t"]
[8116.370534, "o", "items = append(items, idxVal{i, val})\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tsort.SliceStable(items, func(a, b int) bool {\r\n\t\t\t\tva := items[a].val\r\n\t\t\t\tvb := items[b].val\r\n\t\t\t\tif va != vb {\r\n\t\t\t\t\tif objectives[m] == \"maximize\" {\r\n\t\t\t\t\t\treturn va > vb\r\n\t\t\t\t\t}\r\n"]
[8116.370595, "o", "\t\t\t\t\treturn va < vb\r\n\t\t\t\t}\r\n\t\t\t\treturn out.Experiments[items[a].idx].ID < out.Experiments[items[b].idx].ID\r\n\t\t\t})\r\n\t\t\tcurrentRank := 0\r\n\t\t\tprevVal := math.NaN()\r\n\t\t\tfor _, item := range items {\r\n"]
[8116.370656, "o", "\t\t\t\tif currentRank == 0 || item.val != prevVal {\r\n\t\t\t\t\tcurrentRank++\r\n\t\t\t\t\tprevVal = item.val\r\n\t\t\t\t}\r\n\t\t\t\tout.MetricRankings[m][out.Experiments[item.idx].ID] = currentRank\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tfor _, m := range objMetrics {\r\n"]
