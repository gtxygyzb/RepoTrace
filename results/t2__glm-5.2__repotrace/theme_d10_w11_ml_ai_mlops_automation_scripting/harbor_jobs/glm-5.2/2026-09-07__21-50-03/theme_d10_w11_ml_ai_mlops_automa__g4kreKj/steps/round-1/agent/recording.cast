[3411.113213, "o", "   278\t\r\n   279\ttype ArtifactRef struct {\r\n   280\t\tPath string\r\n   281\t\tType string\r\n   282\t}\r\n   283\t\r\n   284\ttype MetricData struct {\r\n   285\t\tName  string  `json:\"name\"`\r\n   286\t\tValue float64 `json:\"value\"`\r\n   287\t}\r\n   288\t\r\n"]
