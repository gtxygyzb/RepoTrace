[2879.940258, "o", "  1000\t\t\t\t\t\t\tExitCode:  0,\r\n  1001\t\t\t\t\t\t\tStartTime: time.Now().Format(time.RFC3339),\r\n  1002\t\t\t\t\t\t\tEndTime:   time.Now().Format(time.RFC3339),\r\n  1003\t\t\t\t\t\t}\r\n"]
[2879.940391, "o", "  1004\t\t\t\t\t\tif err := writeStageState(id, name, st); err != nil {\r\n  1005\t\t\t\t\t\t\treturn err\r\n  1006\t\t\t\t\t\t}\r\n  1007\t\t\t\t\t\tcontinue\r\n  1008\t\t\t\t\t}\r\n  1009\t\t\t\t}\r\n  1010\t\t\t\tst, err := runStage(id, stage, combo)\r\n  1011\t\t\t\tif err != nil {\r\n  1012\t\t\t\t\treturn err\r\n  1013\t\t\t\t}\r\n  1014\t\t\t\tfor _, m := range st.Metrics {\r\n  1015\t\t\t\t\tmetrics[m.Name] = m.Value\r\n  1016\t\t\t\t}\r\n  1017\t\t\t\t_ = updateArtifactIndex(id, name, stage)\r\n  1018\t\t\t}\r\n  1019\t\t}\r\n"]
[2879.940473, "o", "  1020\t\treturn nil\r\n  1021\t}\r\n  1022\t\r\n  1023\tfunc runStage(experimentID string, stage Stage, combo map[string]interface{}) (*StageState, error) {\r\n  1024\t\tmaxAttempts := 1\r\n  1025\t\tbackoff := 0.0\r\n  1026\t\tif stage.Retry != nil && stage.Retry.MaxAttempts > 0 {\r\n  1027\t\t\tmaxAttempts = stage.Retry.MaxAttempts\r\n  1028\t\t\tbackoff = stage.Retry.BackoffSeconds\r\n  1029\t\t}\r\n"]
[2879.940553, "o", "  1030\t\tvar lastErr error\r\n  1031\t\tfor attempt := 1; attempt <= maxAttempts; attempt++ {\r\n  1032\t\t\tcmd := exec.Command(\"sh\", \"-c\", stage.Command)\r\n  1033\t\t\tcmd.Env = os.Environ()\r\n  1034\t\t\tfor k, v := range stage.Env {\r\n  1035\t\t\t\tcmd.Env = append(cmd.Env, k+\"=\"+substituteParams(v, combo))\r\n  1036\t\t\t}\r\n  1037\t\t\tvar stdout bytes.Buffer\r\n  1038\t\t\tcmd.Stdout = &stdout\r\n  1039\t\t\tcmd.Stderr = os.Stderr\r\n  1040\t\t\tstart := time.Now()\r\n"]
[2879.94062, "o", "  1041\t\t\trunErr := cmd.Run()\r\n  1042\t\t\tif runErr == nil {\r\n  1043\t\t\t\tst := &StageState{\r\n  1044\t\t\t\t\tName:      stage.Name,\r\n  1045\t\t\t\t\tStatus:    \"completed\",\r\n  1046\t\t\t\t\tExitCode:  0,\r\n  1047\t\t\t\t\tMetrics:   parseMetrics(stdout.String()),\r\n  1048\t\t\t\t\tStartTime: start.Format(time.RFC3339),\r\n"]
[2879.940679, "o", "  1049\t\t\t\t\tEndTime:   time.Now().Format(time.RFC3339),\r\n  1050\t\t\t\t\tRetries:   attempt - 1,\r\n  1051\t\t\t\t}\r\n  1052\t\t\t\tif err := writeStageState(experimentID, stage.Name, st); err != nil {\r\n  1053\t\t\t\t\treturn nil, err\r\n  1054\t\t\t\t}\r\n  1055\t\t\t\treturn st, nil\r\n  1056\t\t\t}\r\n"]
[2879.940738, "o", "  1057\t\t\tlastErr = runErr\r\n  1058\t\t\tif attempt < maxAttempts && backoff > 0 {\r\n  1059\t\t\t\ttime.Sleep(time.Duration(backoff * float64(time.Second)))\r\n  1060\t\t\t}\r\n  1061\t\t}\r\n  1062\t\tst := &StageState{\r\n  1063\t\t\tName:      stage.Name,\r\n"]
[2879.940797, "o", "  1064\t\t\tStatus:    \"failed\",\r\n  1065\t\t\tExitCode:  exitCodeFromError(lastErr),\r\n  1066\t\t\tStartTime: time.Now().Format(time.RFC3339),\r\n  1067\t\t\tEndTime:   time.Now().Format(time.RFC3339),\r\n  1068\t\t\tRetries:   maxAttempts - 1,\r\n  1069\t\t}\r\n  1070\t\t_ = writeStageState(experimentID, stage.Name, st)\r\n  1071\t\treturn nil, fmt.Errorf(\"stage %s failed: %w\", stage.Name, lastErr)\r\n  1072\t}\r\n"]
[2879.940856, "o", "  1073\t\r\n  1074\tfunc parseMetrics(output string) []MetricData {\r\n  1075\t\tvar metrics []MetricData\r\n  1076\t\tscanner := bufio.NewScanner(strings.NewReader(output))\r\n  1077\t\tfor scanner.Scan() {\r\n  1078\t\t\tline := strings.TrimSpace(scanner.Text())\r\n  1079\t\t\tif line == \"\" || !strings.HasPrefix(line, \"{\") {\r\n  1080\t\t"]
[2879.940914, "o", "\t\tcontinue\r\n  1081\t\t\t}\r\n  1082\t\t\tvar m MetricData\r\n  1083\t\t\tif err := json.Unmarshal([]byte(line), &m); err == nil && m.Name != \"\" {\r\n  1084\t\t\t\tmetrics = append(metrics, m)\r\n  1085\t\t\t\tcontinue\r\n  1086\t\t\t}\r\n  1087\t\t\tvar mm map[string]interface{}\r\n"]
[2879.940993, "o", "  1088\t\t\tif err := json.Unmarshal([]byte(line), &mm); err == nil {\r\n  1089\t\t\t\tif name, ok := mm[\"metric\"].(string); ok {\r\n  1090\t\t\t\t\tmetrics = append(metrics, MetricData{Name: name, Value: asFloat(mm[\"value\"])})\r\n  1091\t\t\t\t}\r\n  1092\t\t\t}\r\n  1093\t\t}\r\n  1094\t\treturn metrics\r\n  1095\t}\r\n  1096\t\r\n  1097\tfunc compareMetric(val float64, op string, threshold float64) bool {\r\n  1098\t\tswitch op {\r\n  1099"]
[2879.941051, "o", "\t\tcase \">=\":\r\n  1100\t\t\treturn val >= threshold\r\n  1101\t\tcase \">\":\r\n  1102\t\t\treturn val > threshold\r\n  1103\t\tcase \"<=\":\r\n  1104\t\t\treturn val <= threshold\r\n  1105\t\tcase \"<\":\r\n"]
[2879.941093, "o", "  1106\t\t\treturn val < threshold\r\n  1107\t\tcase \"==\":\r\n  1108\t\t\treturn val == threshold\r\n  1109\t\tcase \"!=\":\r\n  1110\t\t\treturn val != threshold\r\n"]
[2879.941178, "o", "  1111\t\tdefault:\r\n  1112\t\t\treturn false\r\n  1113\t\t}\r\n  1114\t}\r\n  1115\t\r\n  1116\tfunc exitCodeFromError(err error) int {\r\n  1117\t\tif exiterr, ok := err.(*exec.ExitError); ok {\r\n  1118\t\t\treturn exiterr.ExitCode()\r\n  1119\t\t}\r\n  1120\t\treturn 1\r\n"]
