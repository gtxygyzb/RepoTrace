[8124.013028, "o", "\tstage.Inputs = append(stage.Inputs, ArtifactRef{Path: asString(im[\"path\"]), Type: asString(im[\"type\"])})\r\n\t\t}\r\n\t\tp.Stages = append(p.Stages, stage)\r\n\t}\r\n\treturn p, nil\r\n}\r\n\r\nfunc asMap(v interface{}) map[string]interface{} {\r\n\tif m, ok := v.(map[string]interface{}); ok {\r\n\t\treturn m\r\n"]
