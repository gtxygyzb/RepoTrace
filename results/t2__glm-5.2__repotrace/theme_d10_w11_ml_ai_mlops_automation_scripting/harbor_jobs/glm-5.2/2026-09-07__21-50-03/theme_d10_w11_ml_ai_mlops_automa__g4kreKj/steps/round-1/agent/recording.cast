[5996.038461, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[5996.038736, "o", "pipeline_file = 'pipelines/text_sentiment.yaml'\r\n\u001b[?2004l\r"]
[5996.038946, "o", "\u001b[?2004h> "]
[5996.039295, "o", "report = json.loads(subprocess.check_output(['./mlpipe', 'report', pipeline_file]))\r\n\u001b[?2004l\r"]
[5996.039382, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5996.039451, "o", "\u001b[?2004h> "]
[5996.039651, "o", "# Parse simple YAML for metrics/objectives.\r\n\u001b[?2004l\r"]
[5996.03972, "o", "\u001b[?2004h> "]
[5996.039775, "o", "import re\r\n\u001b[?2004l\r"]
[5996.039836, "o", "\u001b[?2004h> "]
[5996.039904, "o", "metrics = {}\r\n\u001b[?2004l\r"]
[5996.039973, "o", "\u001b[?2004h> "]
[5996.04006, "o", "stage = None\r\n\u001b[?2004l\r"]
[5996.040116, "o", "\u001b[?2004h> "]
[5996.040305, "o", "with open(pipeline_file) as f:\r\n\u001b[?2004l\r"]
[5996.040368, "o", "\u001b[?2004h> "]
[5996.040474, "o", "    for line in f:\r\n\u001b[?2004l\r"]
[5996.040538, "o", "\u001b[?2004h> "]
[5996.0408, "o", "        m = re.match(r'\\s*- name: (.+)', line)\r\n\u001b[?2004l\r"]
[5996.040858, "o", "\u001b[?2004h> "]
[5996.041182, "o", "        if m and not line.startswith(' ' * 6):\r\n\u001b[?2004l\r"]
[5996.041231, "o", "\u001b[?2004h> "]
[5996.041419, "o", "            stage = m.group(1)\r\n\u001b[?2004l\r"]
[5996.041476, "o", "\u001b[?2004h> "]
[5996.041768, "o", "        m2 = re.match(r'\\s+- name: (.+)', line)\r\n\u001b[?2004l\r"]
[5996.041902, "o", "\u001b[?2004h> "]
[5996.042113, "o", "        m3 = re.match(r'\\s+objective: (.+)', line)\r\n\u001b[?2004l\r"]
[5996.04218, "o", "\u001b[?2004h> "]
[5996.042265, "o", "        if m2:\r\n\u001b[?2004l\r"]
[5996.042333, "o", "\u001b[?2004h> "]
[5996.042526, "o", "            cur_metric = m2.group(1)\r\n\u001b[?2004l\r"]
[5996.042591, "o", "\u001b[?2004h> "]
[5996.042755, "o", "        if m3 and cur_metric:\r\n\u001b[?2004l\r"]
[5996.042802, "o", "\u001b[?2004h> "]
[5996.043085, "o", "            metrics[cur_metric] = m3.group(1)\r\n\u001b[?2004l\r"]
[5996.043144, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5996.043192, "o", "\u001b[?2004h> "]
[5996.043603, "o", "obj = {k:v for k,v in metrics.items() if v in ('minimize','maximize')}\r\n\u001b[?2004l\r"]
[5996.043669, "o", "\u001b[?2004h> "]
[5996.043736, "o", "states = {}\r\n\u001b[?2004l\r"]
[5996.043792, "o", "\u001b[?2004h> "]
[5996.044617, "o", "for path in glob.glob('.mlpipe/state/*/train.json') + glob.glob('.mlpipe/state/*/evaluate.json') + glob.glob('.mlpipe/state/*/preprocess.json'):\r\n\u001b[?2004l\r"]
[5996.044681, "o", "\u001b[?2004h> "]
[5996.044964, "o", "    exp = os.path.basename(os.path.dirname(path))\r\n\u001b[?2004l\r"]
[5996.045048, "o", "\u001b[?2004h> "]
[5996.045237, "o", "    st = json.load(open(path))\r\n\u001b[?2004l\r"]
[5996.045308, "o", "\u001b[?2004h> "]
[5996.045475, "o", "    states.setdefault(exp, {})\r\n\u001b[?2004l\r"]
[5996.045541, "o", "\u001b[?2004h> "]
[5996.045758, "o", "    for m in st.get('metrics', []):\r\n\u001b[?2004l\r"]
[5996.045816, "o", "\u001b[?2004h> "]
[5996.046092, "o", "        states[exp][m['name']] = m['value']\r\n\u001b[?2004l\r"]
[5996.046167, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5996.046225, "o", "\u001b[?2004h> "]
[5996.046339, "o", "exps = sorted(states)\r\n\u001b[?2004l\r"]
[5996.046394, "o", "\u001b[?2004h> "]
[5996.046813, "o", "minv = {m:min(states[e][m] for e in exps if m in states[e]) for m in obj}\r\n\u001b[?2004l\r"]
[5996.046872, "o", "\u001b[?2004h> "]
[5996.047284, "o", "maxv = {m:max(states[e][m] for e in exps if m in states[e]) for m in obj}\r\n\u001b[?2004l\r"]
[5996.047344, "o", "\u001b[?2004h> "]
[5996.0474, "o", "norm = {}\r\n\u001b[?2004l\r"]
[5996.047454, "o", "\u001b[?2004h> "]
[5996.047545, "o", "for e in exps:\r\n\u001b[?2004l\r"]
[5996.047608, "o", "\u001b[?2004h> "]
[5996.0477, "o", "    norm[e] = {}\r\n\u001b[?2004l\r"]
[5996.047755, "o", "\u001b[?2004h> "]
[5996.047853, "o", "    for m in obj:\r\n\u001b[?2004l\r"]
[5996.047908, "o", "\u001b[?2004h> "]
[5996.048016, "o", "        v = states[e][m]\r\n\u001b[?2004l\r"]
[5996.048073, "o", "\u001b[?2004h> "]
[5996.048204, "o", "        rng = maxv[m] - minv[m]\r\n\u001b[?2004l\r"]
[5996.048259, "o", "\u001b[?2004h> "]
[5996.048657, "o", "        n = 0.5 if rng == 0 else (v-minv[m])/rng if obj[m]=='maximize' else (maxv[m]-v)/rng\r\n\u001b[?2004l\r"]
[5996.048712, "o", "\u001b[?2004h> "]
[5996.04885, "o", "        norm[e][m] = round(n, 4)\r\n\u001b[?2004l\r"]
[5996.04887, "o", "\u001b[?2004h"]
[5996.04889, "o", "> "]
[5996.049231, "o", "comp = {e: round(sum(norm[e][m] for m in obj)/len(obj), 4) for e in exps}\r\n\u001b[?2004l\r"]
[5996.049252, "o", "\u001b[?2004h"]
[5996.049271, "o", "> "]
[5996.04976, "o", "imp = {m: round(statistics.stdev([norm[e][m] for e in exps]) if len(exps) > 1 else 0, 4) for m in obj}\r\n\u001b[?2004l\r\u001b[?2004h"]
[5996.049802, "o", "> "]
[5996.049824, "o", "sens = {}\r\n\u001b[?2004l\r"]
[5996.049863, "o", "\u001b[?2004h> "]
[5996.049947, "o", "for m in obj:\r\n\u001b[?2004l\r"]
[5996.049968, "o", "\u001b[?2004h> "]
[5996.050089, "o", "    if len(obj) == 1:\r\n\u001b[?2004l\r"]
[5996.05011, "o", "\u001b[?2004h"]
[5996.05013, "o", "> "]
[5996.050437, "o", "        sens[m] = {'best_without': exps[0], 'max_composite': 0}\r\n\u001b[?2004l\r"]
[5996.05046, "o", "\u001b[?2004h> "]
[5996.050529, "o", "    else:\r\n\u001b[?2004l\r"]
[5996.050549, "o", "\u001b[?2004h"]
[5996.05057, "o", "> "]
[5996.050665, "o", "        scores = {}\r\n\u001b[?2004l\r"]
[5996.050685, "o", "\u001b[?2004h"]
[5996.050704, "o", "> "]
[5996.050814, "o", "        for e in exps:\r\n\u001b[?2004l\r"]
[5996.050847, "o", "\u001b[?2004h> "]
[5996.11989, "o", "            vals = [norm[e][mm] for mm in obj if mm != m]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5996.120031, "o", "            scores[e] = round(sum(vals)/len(vals), 4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5996.120103, "o", "> "]
[5996.120476, "o", "        best = sorted(scores.items(), key=lambda kv: (-kv[1], kv[0]))[0]\r\n\u001b[?2004l\r"]
[5996.120555, "o", "\u001b[?2004h> "]
[5996.12094, "o", "        sens[m] = {'best_without': best[0], 'max_composite': best[1]}\r\n\u001b[?2004l\r"]
[5996.121006, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5996.121062, "o", "\u001b[?2004h> "]
[5996.121833, "o", "for key, expected in [('composite_scores', comp), ('normalized_metrics', norm), ('metric_importance', imp), ('score_sensitivity', sens)]:\r\n\u001b[?2004l\r"]
[5996.121885, "o", "\u001b[?2004h> "]
[5996.122273, "o", "    assert report[key] == expected, (key, report[key], expected)\r\n\u001b[?2004l\r"]
[5996.122336, "o", "\u001b[?2004h> "]
[5996.122981, "o", "assert report['best_experiment'] == max(comp.items(), key=lambda kv: (kv[1], -ord(kv[0][3]) if False else 0))[0]\r\n\u001b[?2004l\r"]
[5996.123036, "o", "\u001b[?2004h> "]
[5996.123208, "o", "print('verification passed')\r\n\u001b[?2004l\r"]
[5996.123264, "o", "\u001b[?2004h> "]
[5996.12332, "o", "PY\r\n\u001b[?2004l\r"]
[5996.180718, "o", "verification passed\r\n"]
