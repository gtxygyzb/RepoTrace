[3297.374847, "o", "Metrics:   parseMetrics(stdout.String()),\r\n  1048\t\t\t\t\tStartTime: start.Format(time.RFC3339),\r\n  1049\t\t\t\t\tEndTime:   time.Now().Format(time.RFC3339),\r\n  1050\t\t\t\t\tRetries:   attempt - 1,\r\n  1051\t\t\t\t}\r\n  1052\t\t\t\tif err := writeStageState(experimentID, stage.Name, st); err != nil {\r\n  1053\t\t\t\t\treturn nil, err\r\n  1054\t\t\t\t}\r\n  1055\t\t\t\treturn st, nil\r\n  1056"]
