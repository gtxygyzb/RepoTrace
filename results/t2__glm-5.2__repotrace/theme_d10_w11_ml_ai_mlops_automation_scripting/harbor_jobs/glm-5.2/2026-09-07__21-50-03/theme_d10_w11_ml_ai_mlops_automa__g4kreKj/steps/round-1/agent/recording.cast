[2192.644387, "o", "   828\t    out := make(map[string]interface{}, len(m))\r\n   829\t    for k, v := range m {\r\n   830\t        out[k] = v\r\n   831\t    }\r\n   832\t    return out\r\n   833\t}\r\n   834\t\r\n   835\tfunc sortedKeys(m map[string]bool) []string {\r\n   836\t    keys := make([]string, 0, len(m))\r\n"]
[2192.644452, "o", "   837\t    for k := range m {\r\n   838\t        keys = append(keys, k)\r\n   839\t    }\r\n   840\t    sort.Strings(keys)\r\n   841\t    return keys\r\n   842\t}\r\n"]
