[3297.088418, "o", "  1009\t\t\t\t}\r\n  1010\t\t\t\tst, err := runStage(id, stage, combo)\r\n  1011\t\t\t\tif err != nil {\r\n  1012\t\t\t\t\treturn err\r\n  1013\t\t\t\t}\r\n  1014\t\t\t\tfor _, m := range st.Metrics {\r\n  1015\t\t\t\t\tmetrics[m.Name] = m.Value\r\n  1016\t\t\t\t}\r\n  1017\t\t\t\t_ = updateArtifactIndex(id, name, stage)\r\n  1018\t\t\t}\r\n"]
