[3411.395615, "o", "     1\tname: image-classifier-training\r\n     2\tversion: \"1.0\"\r\n     3\t\r\n     4\tparameters:\r\n     5\t  learning_rate:\r\n     6\t    type: grid\r\n"]
[3411.395723, "o", "     7\t    values: [0.001, 0.01, 0.1]\r\n     8\t  batch_size:\r\n     9\t    type: grid\r\n    10\t    values: [32, 64]\r\n    11\t  optimizer:\r\n    12\t    type: grid\r\n    13\t    values: [\"adam\", \"sgd\"]\r\n    14\t\r\n"]
[3411.395816, "o", "    15\tstages:\r\n    16\t  - name: data-validation\r\n    17\t    command: \"./stages/validate_data.sh\"\r\n    18\t    inputs:\r\n    19\t      - path: \"data/sample\"\r\n    20\t        type: directory\r\n    21\t    outputs:\r\n    22\t      - path: \"data/validated\"\r\n    23\t        type: directory\r\n    24\t    metrics:\r\n    25\t      - name: num_samples\r\n    26\t        objective: report\r\n    27\t      - name: corruption_rate\r\n    28\t        objective: minimize\r\n    29\t\r\n    30\t  - name: feature-extraction\r\n    31\t    command: \"./stages/extract_features.sh\"\r\n    32\t    depends_on: [\"data-validation\"]\r\n    33\t    inputs:\r\n    34\t      - path: \"data/validated\"\r\n    35\t        type: directory\r\n"]
[3411.395916, "o", "    36\t    outputs:\r\n    37\t      - path: \"data/features.bin\"\r\n    38\t        type: file\r\n    39\t    env:\r\n    40\t      BATCH_SIZE: \"${batch_size}\"\r\n    41\t\r\n    42\t  - name: model-training\r\n    43\t    command: \"./stages/train_model.sh\"\r\n    44\t    depends_on: [\"feature-extraction\"]\r\n    45\t    inputs:\r\n    46\t      - path: \"data/features.bin\"\r\n    47\t        type: file\r\n    48\t    outputs:\r\n    49\t      - path: \"models/checkpoint.bin\"\r\n    50\t        type: file\r\n"]
[3411.396033, "o", "    51\t    env:\r\n    52\t      LEARNING_RATE: \"${learning_rate}\"\r\n    53\t      OPTIMIZER: \"${optimizer}\"\r\n    54\t      BATCH_SIZE: \"${batch_size}\"\r\n    55\t    metrics:\r\n    56\t      - name: train_loss\r\n    57\t        objective: minimize\r\n    58\t      - name: train_accuracy\r\n    59\t        objective: maximize\r\n    60\t    retry:\r\n    61\t      max_attempts: 2\r\n    62\t      backoff_seconds: 1\r\n    63\t\r\n"]
[3411.396108, "o", "    64\t  - name: model-evaluation\r\n    65\t    command: \"./stages/evaluate_model.sh\"\r\n    66\t    depends_on: [\"model-training\"]\r\n    67\t    inputs:\r\n    68\t      - path: \"models/checkpoint.bin\"\r\n    69\t        type: file\r\n    70\t"]
[3411.396194, "o", "      - path: \"data/validated\"\r\n    71\t        type: directory\r\n    72\t    outputs:\r\n    73\t      - path: \"reports/evaluation.json\"\r\n    74\t        type: file\r\n    75\t    metrics:\r\n    76\t      - name: eval_accuracy\r\n    77\t        objective: maximize\r\n    78\t      - name: eval_f1\r\n    79\t        objective: maximize\r\n    80\t      - name: eval_loss\r\n    81\t        objective: minimize\r\n    82\t\r\n    83\t  - name: model-export\r\n    84\t    command: \"./stages/export_model.sh\"\r\n    85\t    depends_on: [\"model-evaluation\"]\r\n    86\t    condition:\r\n    87\t      metric: eval_accuracy\r\n    88\t"]
[3411.396276, "o", "      operator: \">=\"\r\n    89\t      threshold: 0.85\r\n    90\t    inputs:\r\n    91\t      - path: \"models/checkpoint.bin\"\r\n    92\t        type: file\r\n    93\t    outputs:\r\n    94\t      - path: \"models/exported/model.onnx\"\r\n    95\t        type: file\r\n"]
