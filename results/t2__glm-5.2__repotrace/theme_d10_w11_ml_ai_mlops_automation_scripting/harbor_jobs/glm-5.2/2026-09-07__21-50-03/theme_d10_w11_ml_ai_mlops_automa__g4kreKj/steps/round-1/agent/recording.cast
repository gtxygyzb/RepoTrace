[8124.012525, "o", "continue\r\n\t\t}\r\n\t\tif c == '[' || c == '{' {\r\n\t\t\tdepth++\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif c == ']' || c == '}' {\r\n\t\t\tdepth--\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
