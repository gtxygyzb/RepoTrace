[6505.412031, "o", "    28\t\tcmd := os.Args[1]\r\n    29\t\targs := os.Args[2:]\r\n    30\t\r\n    31\t\tswitch cmd {\r\n    32\t\tcase \"validate\":\r\n    33\t\t\tos.Exit(cmdValidate(args))\r\n    34\t\tcase \"plan\":\r\n    35\t\t\tos.Exit(cmdPlan(args))\r\n    36\t\tcase \"run\":\r\n    37\t\t\tos.Exit(cmdRun(args))\r\n    38\t\tcase \"report\":\r\n    39\t\t\tos.Exit(cmdReport(args))\r\n    40\t\tcase \"artifacts\":\r\n    41\t\t\tos.Exit(cmdArtifacts(args))\r\n    42\t\tcase \"compare\":\r\n    43\t\t\tos.Exit(cmdCompare(args))\r\n    44\t\tcase \"sweep\":\r\n    45\t\t\tos.Exit(cmdSweep(args))\r\n"]
[6505.412118, "o", "    46\t\tdefault:\r\n    47\t\t\tfmt.Fprintf(os.Stderr, \"error: command %q is not implemented\\n\", cmd)\r\n    48\t\t\tos.Exit(1)\r\n    49\t\t}\r\n    50\t}\r\n"]
