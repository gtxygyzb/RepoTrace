[3420.578957, "o", "\u001b[32m\u001b[K789\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(p.Parameters) == 0 {\r\n\u001b[32m\u001b[K790\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn []map[string]interface{}{{}}\r\n\u001b[32m\u001b[K791\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K792\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcombos := []map[string]interface{}{{}}\r\n\u001b[32m\u001b[K793\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, param := range p.Parameters {\r\n\u001b[32m\u001b[K794\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tnext := make([]map[string]interface{}, 0, len(combos)*len(param.Values))\r\n\u001b[32m\u001b[K795\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor _, combo := range combos {\r\n\u001b[32m\u001b[K796\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tfor _, value := range param.Values {\r\n\u001b[32m\u001b[K797\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tc := copyMap(combo)\r\n\u001b[32m\u001b[K798\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tc[param.Name] = value\r\n\u001b[32m\u001b[K799\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tnext = append(next, c)\r\n"]
[3420.579048, "o", "\u001b[32m\u001b[K800\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K801\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K802\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tcombos = next\r\n\u001b[32m\u001b[K803\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K804\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn combos\r\n\u001b[32m\u001b[K805\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K806\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K807\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc experimentID(combo map[string]interface{}) string {\r\n\u001b[32m\u001b[K808\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(combo) == 0 {\r\n\u001b[32m\u001b[K809\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn \"exp_default\"\r\n\u001b[32m\u001b[K810\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K811\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tkeys := make([]string, 0, len(combo))\r\n\u001b[32m\u001b[K812\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k := range combo {\r\n\u001b[32m\u001b[K813\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tkeys = append(keys, k)\r\n\u001b[32m\u001b[K814\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t"]
[3420.579122, "o", "}\r\n\u001b[32m\u001b[K815\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tsort.Strings(keys)\r\n\u001b[32m\u001b[K816\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tparts := make([]string, 0, len(keys))\r\n\u001b[32m\u001b[K817\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, k := range keys {\r\n\u001b[32m\u001b[K818\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tparts = append(parts, k+\"=\"+asString(combo[k]))\r\n\u001b[32m\u001b[K819\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K820\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn \"exp_\" + strings.Join(parts, \"_\")\r\n\u001b[32m\u001b[K821\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K822\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K823\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc substituteParams(value string, combo map[string]interface{}) string {\r\n\u001b[32m\u001b[K824\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor k, v := range combo {\r\n"]
[3420.579213, "o", "\u001b[32m\u001b[K825\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tvalue = strings.ReplaceAll(value, \"${\"+k+\"}\", asString(v))\r\n\u001b[32m\u001b[K826\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K827\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn value\r\n\u001b[32m\u001b[K828\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
