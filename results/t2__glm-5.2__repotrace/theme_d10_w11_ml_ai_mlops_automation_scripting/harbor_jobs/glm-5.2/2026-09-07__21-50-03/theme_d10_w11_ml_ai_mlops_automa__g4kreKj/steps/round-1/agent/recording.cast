[1985.291957, "o", "===== pipelines/broken_cycles.yaml =====\r\n"]
[1985.294401, "o", "     1\tname: broken-circular-pipeline\r\n     2\tversion: \"1.0\"\r\n     3\t\r\n     4\tstages:\r\n     5\t  - name: stage-a\r\n     6\t    command: \"echo a\"\r\n     7\t    depends_on: [\"stage-c\"]\r\n"]
[1985.294505, "o", "     8\t    outputs:\r\n     9\t      - path: \"out/a.txt\"\r\n    10\t        type: file\r\n    11\t\r\n    12\t  - name: stage-b\r\n    13\t    command: \"echo b\"\r\n    14\t    depends_on: [\"stage-a\"]\r\n    15\t    outputs:\r\n    16\t      - path: \"out/b.txt\"\r\n    17\t        type: file\r\n"]
[1985.294596, "o", "    18\t\r\n    19\t  - name: stage-c\r\n    20\t    command: \"echo c\"\r\n    21\t    depends_on: [\"stage-b\"]\r\n    22\t    outputs:\r\n    23\t      - path: \"out/c.txt\"\r\n    24"]
[1985.294669, "o", "\t        type: file\r\n"]
[1985.29492, "o", "===== pipelines/image_classifier.yaml =====\r\n"]
[1985.29706, "o", "     1\tname: image-classifier-training\r\n     2\tversion: \"1.0\"\r\n     3\t\r\n     4\tparameters:\r\n     5\t  learning_rate:\r\n     6\t"]
[1985.297106, "o", "    type: grid\r\n     7\t    values: [0.001, 0.01, 0.1]\r\n     8\t  batch_size:\r\n     9\t    type: grid\r\n    10\t    values: [32, 64]\r\n    11\t  optimizer:\r\n"]
[1985.297198, "o", "    12\t    type: grid\r\n    13\t    values: [\"adam\", \"sgd\"]\r\n    14\t\r\n    15\tstages:\r\n    16\t  - name: data-validation\r\n    17\t    command: \"./stages/validate_data.sh\"\r\n    18\t    inputs:\r\n    19\t      - path: \"data/sample\"\r\n    20\t        type: directory\r\n    21\t    outputs:\r\n    22\t      - path: \"data/validated\"\r\n    23\t        type: directory\r\n    24\t    metrics:\r\n    25\t      - name: num_samples\r\n"]
[1985.297264, "o", "    26\t        objective: report\r\n    27\t      - name: corruption_rate\r\n    28\t        objective: minimize\r\n    29\t\r\n    30\t  - name: feature-extraction\r\n"]
[1985.297327, "o", "    31\t    command: \"./stages/extract_features.sh\"\r\n    32\t    depends_on: [\"data-validation\"]\r\n    33\t    inputs:\r\n    34\t      - path: \"data/validated\"\r\n    35\t        type: directory\r\n    36\t    outputs:\r\n    37\t      - path: \"data/features.bin\"\r\n    38\t        type: file\r\n    39\t    env:\r\n    40\t      BATCH_SIZE: \"${batch_size}\"\r\n    41\t\r\n    42\t  - name: model-training\r\n    43\t    command: \"./stages/train_model.sh\"\r\n    44\t    depends_on: [\"feature-extraction\"]\r\n    45\t    inputs:\r\n    46\t      - path: \"data/features.bin\""]
