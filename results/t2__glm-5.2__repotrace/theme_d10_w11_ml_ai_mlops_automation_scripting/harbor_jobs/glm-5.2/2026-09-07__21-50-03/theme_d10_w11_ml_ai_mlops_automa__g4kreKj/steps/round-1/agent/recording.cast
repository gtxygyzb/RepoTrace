[3305.228645, "o", "\t\t\"io\"\r\n    11\t\t\"math\"\r\n    12\t\t\"os\"\r\n    13\t\t\"os/exec\"\r\n    14\t\t\"path/filepath\"\r\n    15\t\t\"sort\"\r\n    16\t\t\"strconv\"\r\n    17\t\t\"strings\"\r\n    18\t\t\"time\"\r\n    19\t)\r\n    20\t\r\n    21\tfunc main() {\r\n    22\t\tif len(os.Args) < 2 {\r\n    23\t\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe <command> [args...]\")\r\n    24\t\t\tfmt.Fprintln(os.Stderr, \"Commands: validate, plan, run, report, artifacts, compare\")\r\n    25\t\t\tos.Exit(1)\r\n    26\t\t}\r\n    27\t\r\n    28\t\tcmd := os.Args[1]\r\n    29\t\targs := os.Args[2:]\r\n    30\t\r\n    31\t\tswitch cmd {\r\n    32"]
