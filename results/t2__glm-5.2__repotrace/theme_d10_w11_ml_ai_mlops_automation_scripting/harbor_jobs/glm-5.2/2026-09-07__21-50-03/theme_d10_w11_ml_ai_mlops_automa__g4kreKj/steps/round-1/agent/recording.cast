[3297.37577, "o", "metrics[m.Name] = m.Value\r\n  1163\t\t\t\t}\r\n  1164\t\t\t}\r\n  1165\t\t}\r\n  1166\t\treturn metrics\r\n  1167\t}\r\n  1168\t\r\n"]
[3297.375827, "o", "  1169\tfunc dominates(a, b map[string]float64, metrics []string) bool {\r\n  1170\t\tstrictlyBetter := false\r\n  1171\t\tfor _, m := range metrics {\r\n  1172\t\t\tif a[m] < b[m] {\r\n  1173\t\t\t\treturn false\r\n  1174\t\t\t}\r\n  1175\t\t\tif a[m] > b[m] {\r\n  1176\t\t\t\tstrictlyBetter = true\r\n"]
