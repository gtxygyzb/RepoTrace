[3306.058491, "o", "}\r\n  1150\t\r\n  1151\ttype compareExperimentData struct {\r\n  1152\t\tID       string\r\n  1153\t\tPipeline string\r\n  1154\t\tMetrics  map[string]float64\r\n  1155\t}\r\n  1156\t\r\n  1157\tfunc collectExperimentMetrics(p *Pipeline, id string) map[string]float64 {\r\n  1158\t\t"]
[3306.058532, "o", "metrics := map[string]float64{}\r\n  1159\t\tfor _, stage := range p.Stages {\r\n  1160\t\t\tif st, err := readStageState(id, stage.Name); err == nil {\r\n  1161\t\t\t\tfor _, m := range st.Metrics {\r\n  1162\t\t\t\t\tmetrics[m.Name] = m.Value\r\n  1163\t\t\t\t}\r\n"]
