[2019.139266, "o", "    62\t      backoff_seconds: 1\r\n    63\t\r\n    64\t  - name: model-evaluation\r\n    65\t    command: \"./stages/evaluate_model.sh\"\r\n    66\t    depends_on: [\"model-training\"]\r\n    67\t    inputs:\r\n    68\t      - path: \"models/checkpoint.bin\"\r\n    69"]
[2019.139317, "o", "\t        type: file\r\n    70\t      - path: \"data/validated\"\r\n    71\t        type: directory\r\n    72\t    outputs:\r\n    73\t      - path: \"reports/evaluation.json\"\r\n    74\t        type: file\r\n    75\t    metrics:\r\n    76"]
[2019.139371, "o", "\t      - name: eval_accuracy\r\n    77\t        objective: maximize\r\n    78\t      - name: eval_f1\r\n    79\t        objective: maximize\r\n    80\t      - name: eval_loss\r\n    81\t        objective: minimize\r\n    82\t\r\n    83\t  - name: model-export\r\n"]
