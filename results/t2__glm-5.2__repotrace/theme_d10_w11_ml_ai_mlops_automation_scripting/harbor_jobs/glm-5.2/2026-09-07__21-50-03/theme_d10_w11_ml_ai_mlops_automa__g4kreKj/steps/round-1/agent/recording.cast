[3297.37553, "o", "\tif err != nil {\r\n  1132\t\t\t\tcontinue\r\n  1133\t\t\t}\r\n  1134\t\t\th := sha256.New()\r\n  1135\t\t\tif _, err := io.Copy(h, f); err != nil {\r\n  1136\t\t\t\tf.Close()\r\n  1137\t\t\t\tcontinue\r\n"]
