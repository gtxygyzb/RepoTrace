[6471.462583, "o", "  2131\tfunc round4(f float64) float64 {\r\n  2132\t\tf = math.Round(f*10000) / 10000\r\n  2133\t\tif f == 0 {\r\n  2134\t\t\tf = 0\r\n  2135\t\t}\r\n  2136\t\treturn f\r\n  2137\t}\r\n  2138\t\r\n  2139"]
[6471.462747, "o", "\tfunc filterMetrics(metrics map[string]float64, shared []string) map[string]float64 {\r\n  2140\t\tout := make(map[string]float64, len(shared))\r\n  2141\t\tfor _, name := range shared {\r\n  2142\t\t\tout[name] = metrics[name]\r\n  2143\t\t}\r\n  2144\t\treturn out\r\n  2145\t}\r\n"]
