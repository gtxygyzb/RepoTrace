[2701.245868, "o", "data/      go.mod     main.go    pipelines/ stages/    \r\n> return val >= threshold\r\n\u001b[?2004l\r"]
[2701.245929, "o", "\u001b[?2004h> \u0007"]
[2701.245986, "o", "case \">\":\r\n\u001b[?2004l\r\u001b[?2004h> \u0007"]
