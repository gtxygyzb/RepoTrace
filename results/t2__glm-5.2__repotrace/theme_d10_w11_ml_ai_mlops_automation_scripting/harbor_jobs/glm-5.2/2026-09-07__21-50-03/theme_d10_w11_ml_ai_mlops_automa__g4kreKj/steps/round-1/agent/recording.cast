[2879.651986, "o", "\u001b[32m\u001b[K952\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\texp := reportExperiment{ID: id, \u001b[01;31m\u001b[KMetrics:\u001b[m\u001b[K map[string]float64{}, Stages: []StageState{}}\r\n"]
[2879.652076, "o", "\u001b[32m\u001b[K1047\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[KMetrics:\u001b[m\u001b[K   parseMetrics(stdout.String()),\r\n"]
[2879.652149, "o", "\u001b[32m\u001b[K1182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcmdCompare\u001b[m\u001b[K(args []string) int {\r\n\u001b[32m\u001b[K1286\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tincluded = append(included, compareExperimentData{ID: id, Pipeline: info.Name, \u001b[01;31m\u001b[KMetrics:\u001b[m\u001b[K metrics})\r\n"]
[2879.652259, "o", "\u001b[32m\u001b[K1401\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\ttype \u001b[01;31m\u001b[KexperimentOut\u001b[m\u001b[K struct {\r\n\u001b[32m\u001b[K1411\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\texperiments := []\u001b[01;31m\u001b[KexperimentOut\u001b[m\u001b[K{}\r\n"]
[2879.652331, "o", "\u001b[32m\u001b[K1413\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\texperiments = append(experiments, \u001b[01;31m\u001b[KexperimentOut\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K1416\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KMetrics:\u001b[m\u001b[K         included[idx].Metrics,\r\n\u001b[32m\u001b[K1484\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tExperiments    []\u001b[01;31m\u001b[KexperimentOut\u001b[m\u001b[K           `json:\"experiments\"`\r\n"]
[2879.652385, "o", "\u001b[32m\u001b[K1495\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tShared\u001b[01;31m\u001b[KMetrics:\u001b[m\u001b[K  sharedMetrics,\r\n"]
[2879.652493, "o", "\u001b[32m\u001b[K1616\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KfilterMetrics\u001b[m\u001b[K(metrics map[string]float64, shared []string) map[string]float64 {\r\n"]
