[5214.509494, "o", "   790\tfunc parameterCombinations(p *Pipeline) []map[string]interface{} {\r\n   791\t\tif len(p.Parameters) == 0 {\r\n   792\t\t\treturn []map[string]interface{}{{}}\r\n   793\t\t}"]
[5214.509529, "o", "\r\n   794\t\tcombos := []map[string]interface{}{{}}\r\n   795\t\tfor _, param := range p.Parameters {\r\n   796\t\t"]
[5214.509749, "o", "\tnext := make([]map[string]interface{}, 0, len(combos)*len(param.Values))\r\n   797\t\t\tfor _, combo := range combos {\r\n   798\t\t\t\tfor _, value := range param.Values {\r\n   799\t\t\t\t\tc := copyMap(combo)\r\n   800\t\t\t\t\tc[param.Name] = value\r\n   801\t\t\t\t\tnext = append(next, c)\r\n   802\t\t\t\t}\r\n   803\t\t\t}\r\n   804\t\t\tcombos = next\r\n   805\t\t}\r\n   806\t\treturn combos\r\n   807\t}\r\n   808\t\r\n   809\tfunc experimentID(combo map[string]interface{}) string {\r\n   810\t\tif len(combo) == 0 {\r\n   811\t\t\treturn \"exp_default\"\r\n   812\t\t}\r\n   813\t\tkeys := make([]string, 0, len(combo))\r\n   814\t\tfor k := range combo {\r\n   815\t\t\tkeys = append(keys, k)\r\n   816\t\t}\r\n   817\t\tsort.Strings(keys)\r\n   818\t\tparts := make([]string, 0, len(keys))\r\n"]
[5214.509838, "o", "   819\t\tfor _, k := range keys {\r\n   820\t\t\tparts = append(parts, k+\"=\"+asString(combo[k]))\r\n   821\t\t}\r\n   822\t\treturn \"exp_\" + strings.Join(parts, \"_\")\r\n   823\t}\r\n   824\t\r\n   825\tfunc substituteParams(value string, combo map[string]interface{}) string {\r\n   826\t\tfor k, v := range combo {\r\n   827\t\t\tvalue = strings.ReplaceAll(value, \"${\"+k+\"}\", asString(v))\r\n   828\t\t}\r\n   829\t\treturn value\r\n   830\t}\r\n"]
[5214.509973, "o", "   831\t\r\n   832\tfunc copyMap(m map[string]interface{}) map[string]interface{} {\r\n   833\t\tout := make(map[string]interface{}, len(m))\r\n   834\t\tfor k, v := range m {\r\n   835\t\t\tout[k] = v\r\n   836\t\t}\r\n   837\t\treturn out\r\n   838\t}\r\n   839\t\r\n   840\tfunc sortedKeys(m map[string]bool) []string {\r\n   841\t\tkeys := make([]string, 0, len(m))\r\n"]
[5214.510068, "o", "   842\t\tfor k := range m {\r\n   843\t\t\tkeys = append(keys, k)\r\n   844\t\t}\r\n   845\t\tsort.Strings(keys)\r\n   846\t\treturn keys\r\n   847\t}\r\n   848\t\r\n   849\tfunc stateDir(experimentID string) string {\r\n   850\t\treturn filepath.Join(\".mlpipe\", \"state\", experimentID)\r\n   851\t}\r\n   852\t\r\n   853\t"]
[5214.510135, "o", "func stageStatePath(experimentID, stageName string) string {\r\n   854\t\treturn filepath.Join(stateDir(experimentID), stageName+\".json\")\r\n   855\t}\r\n   856\t\r\n   857\tfunc experimentStateExists(id string) bool {\r\n   858\t\tinfo, err := os.Stat(stateDir(id))\r\n   859\t\treturn err == nil && info.IsDir()\r\n"]
