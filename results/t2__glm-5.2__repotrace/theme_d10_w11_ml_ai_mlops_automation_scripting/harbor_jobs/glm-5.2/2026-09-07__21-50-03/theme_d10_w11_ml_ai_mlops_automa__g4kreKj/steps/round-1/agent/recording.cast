[8108.69886, "o", "\tMin   float64 `json:\"min\"`\r\n\tMax   float64 `json:\"max\"`\r\n}\r\n\r\nfunc cmdSweep(args []string) int {\r\n\tpipelineFile := \"\"\r\n"]
[8108.698942, "o", "\tmetricName := \"\"\r\n\tparamName := \"\"\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tswitch {\r\n\t\tcase arg == \"--metric\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --metric requires a value\")\r\n\t\t\t\treturn 1\r\n\t\t\t}\r\n\t\t\ti++\r\n\t\t\tmetricName = args[i]\r\n"]
[8108.699026, "o", "\t\tcase strings.HasPrefix(arg, \"--metric=\"):\r\n\t\t\tmetricName = strings.TrimPrefix(arg, \"--metric=\")\r\n\t\tcase arg == \"--param\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --param requires a value\")\r\n\t\t\t\treturn 1\r\n\t\t\t}\r\n\t\t\ti++\r\n\t\t\tparamName = args[i]\r\n\t\tcase strings.HasPrefix(arg, \"--param=\"):\r\n\t\t\tparamName = strings.TrimPrefix(arg, \"--param=\")\r\n\t\tcase pipelineFile == \"\":\r\n\t\t\tpipelineFile = arg\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown argument %q\\n\", arg)\r\n\t\t\treturn 1\r\n"]
[8108.699097, "o", "\t\t}\r\n\t}\r\n\tif pipelineFile == \"\" || metricName == \"\" || paramName == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe sweep <pipeline.yaml> --metric <name> --param <name>\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\tp, err := loadPipeline(pipelineFile)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n"]
[8108.699172, "o", "\t}\r\n\tif errs := validatePipeline(p); len(errs) > 0 {\r\n\t\tfor _, e := range errs {\r\n\t\t\tfmt.Fprintln(os.Stderr, e)\r\n\t\t}\r\n\t\treturn 1\r\n\t}\r\n\r\n\tobjective := \"\"\r\n\tmetricFound := false\r\n\tfor _, stage := range p.Stages {\r\n\t\tfor _, m := range stage.Metrics {\r\n"]
[8108.699259, "o", "\t\t\tif m.Name == metricName {\r\n\t\t\t\tmetricFound = true\r\n\t\t\t\tif objective == \"\" {\r\n\t\t\t\t\tobjective = m.Objective\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif !metricFound {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: metric %q not found in pipeline\\n\", metricName)\r\n\t\treturn 1\r\n\t}\r\n\r\n"]
[8108.69932, "o", "\tparamFound := false\r\n\tfor _, param := range p.Parameters {\r\n\t\tif param.Name == paramName {\r\n\t\t\tparamFound = true\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif !paramFound {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: parameter %q not found in pipeline\\n\", paramName)\r\n"]
[8108.69938, "o", "\t\treturn 1\r\n\t}\r\n\r\n\treturn sweepPipeline(p, metricName, paramName, objective)\r\n}\r\n\r\nfunc sweepPipeline(p *Pipeline, metricName, paramName, objective string) int {\r\n\ttype groupOut struct {\r\n\t\tValue string  `json:\"value\"`\r\n\t\tCount int     `json:\"count\"`\r\n\t\t"]
