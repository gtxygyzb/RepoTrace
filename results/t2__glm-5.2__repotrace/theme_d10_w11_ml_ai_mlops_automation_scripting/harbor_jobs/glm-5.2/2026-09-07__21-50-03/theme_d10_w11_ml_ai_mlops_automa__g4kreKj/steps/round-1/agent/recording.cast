[8197.628279, "o", "  1074\t\t\t\t\tif val, ok := exp.Metrics[m]; ok {\r\n  1075\t\t\t\t\t\titems = append(items, idxVal{i, val})\r\n  1076\t\t\t\t\t}\r\n  1077\t\t\t\t}\r\n  1078\t\t\t\tsort.SliceStable(items, func(a, b int) bool {\r\n  1079\t\t\t\t\tva := items[a].val\r\n  1080\t\t\t\t\tvb := items[b].val\r\n  1081\t\t\t\t\tif va != vb {\r\n  1082\t\t\t\t\t\tif objectives[m] == \"maximize\" {\r\n  1083\t\t\t\t\t\t\treturn va > vb\r\n  1084\t\t\t\t\t\t}\r\n  1085\t\t\t\t\t\treturn va < vb\r\n"]
