[6216.553212, "o", "\t\t\tcomposite[i] = sum / float64(len(sharedMetrics))\r\n\t\t}\r\n\t}\r\n\r\n\tdepth := make([]int, len(included))\r\n\tremaining := make([]int, len(included))\r\n\tfor i := range remaining {\r\n\t\t"]
[6216.55336, "o", "remaining[i] = i\r\n\t}\r\n\tcurrentDepth := 0\r\n\tfor len(remaining) > 0 {\r\n\t\tnonDom := []int{}\r\n\t\tfor _, i := range remaining {\r\n\t\t\tdominated := false\r\n\t\t\tfor _, j := range remaining {\r\n"]
[6216.553447, "o", "\t\t\t\tif i == j {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tif dominates(normalized[j], normalized[i], sharedMetrics) {\r\n\t\t\t\t\tdominated = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !dominated {\r\n\t\t\t\tnonDom = append(nonDom, i)\r\n\t\t\t}\r\n\t\t}\r\n\t\tif len(nonDom) == 0 {\r\n\t\t\tfor _, i := range remaining {\r\n\t\t\t\tdepth[i] = currentDepth\r\n\t\t\t}\r\n\t\t\tbreak\r\n\t\t}\r\n\t\tfor _, i := range nonDom {\r\n\t\t\tdepth[i] = currentDepth\r\n\t\t}\r\n"]
[6216.55353, "o", "\t\tnewRemaining := make([]int, 0, len(remaining)-len(nonDom))\r\n\t\tfor _, i := range remaining {\r\n\t\t\tfound := false\r\n\t\t\tfor _, j := range nonDom {\r\n\t\t\t\tif i == j {\r\n\t\t\t\t\tfound = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif !found {\r\n\t\t\t\t"]
[6216.553606, "o", "newRemaining = append(newRemaining, i)\r\n\t\t\t}\r\n\t\t}\r\n\t\tremaining = newRemaining\r\n\t\tcurrentDepth++\r\n\t}\r\n\r\n\torder := make([]int, len(included))\r\n\tfor i := range order {\r\n\t\torder[i] = i\r\n\t}\r\n\tsort.SliceStable(order, func(a, b int) bool {\r\n\t\tif composite[order[a]] != composite[order[b]] {\r\n\t\t\treturn composite[order[a]] > composite[order[b]]\r\n\t\t}\r\n\t\treturn included[order[a]].ID < included[order[b]].ID\r\n\t})\r\n\trank := make([]int, len(included))\r\n\tcurrentRank := 0"]
[6216.553681, "o", "\r\n\tprevComposite := math.NaN()\r\n\tfor _, idx := range order {\r\n\t\tif currentRank == 0 || composite[idx] != prevComposite {\r\n\t\t\tcurrentRank++\r\n\t\t\tprevComposite = composite[idx]\r\n\t\t}\r\n\t\trank[idx] = currentRank\r\n\t}\r\n\r\n\ttype experimentOut struct {\r\n\t\tID              string             `json:\"id\"`\r\n\t"]
[6216.553801, "o", "\tPipeline        string             `json:\"pipeline\"`\r\n\t\tMetrics         map[string]float64 `json:\"metrics\"`\r\n\t\tNormalized      map[string]float64 `json:\"normalized\"`\r\n\t\tCompositeScore  float64            `json:\"composite_score\"`\r\n\t\tRank            int                `json:\"rank\"`\r\n\t\tIsParetoOptimal bool               `json:\"is_pareto_optimal\"`\r\n\t\tDominanceDepth  int                `json:\"dominance_depth\"`\r\n\t}\r\n\texperiments := []experimentOut{}\r\n\tfor _, idx := range order {\r\n\t\texperiments = append(experiments, experimentOut{\r\n\t\t\tID:              included[idx].ID,\r\n\t\t\tPipeline:        included[idx].Pipeline,\r\n\t\t\tMetrics:         filterMetrics(included[idx].Metrics, sharedMetrics),\r\n\t\t\tNormalized:      normalized[idx],\r\n\t\t\tCompositeScore:  composite[idx],\r\n\t\t\tRank:            rank[idx],\r\n"]
[6216.553877, "o", "\t\t\tIsParetoOptimal: depth[idx] == 0,\r\n\t\t\tDominanceDepth:  depth[idx],\r\n\t\t})\r\n\t}\r\n\r\n\tparetoFrontier := []string{}\r\n\tfor i, exp := range included {\r\n"]
[6216.553995, "o", "\t\tif depth[i] == 0 {\r\n\t\t\tparetoFrontier = append(paretoFrontier, exp.ID)\r\n\t\t}\r\n\t}\r\n\tsort.Strings(paretoFrontier)\r\n\r\n\ttype correlationOut struct {\r\n\t\tSpearman *float64 `json:\"spearman_rho\"`\r\n\t\tKendall  *float64 `json:\"kendall_tau\"`\r\n\t\tN        int      `json:\"n\"`\r\n\t}\r\n\tcorrelations := map[string]correlationOut{}\r\n"]
[6216.554074, "o", "\tfor i := 0; i < len(sharedMetrics); i++ {\r\n\t\tfor j := i + 1; j < len(sharedMetrics); j++ {\r\n\t\t\trho, tau := computeCorrelations(included, sharedMetrics[i], sharedMetrics[j])\r\n\t\t\tcorrelations[sharedMetrics[i]+\"_vs_\"+sharedMetrics[j]] = correlationOut{Spearman: rho, Kendall: tau, N: len(included)}\r\n\t\t}\r\n\t}\r\n\r\n\tpipelineNames := []string{}\r\n\tfor _, info := range pipelines {\r\n\t\tpipelineNames = append(pipelineNames, info.Name)\r\n\t}\r\n\tmaxDepth := 0\r\n\tparetoCount := 0\r\n\tfor i := range included {\r\n\t\tif depth[i] > maxDepth {\r\n\t\t\tmaxDepth = depth[i]\r\n\t\t}\r\n\t\tif depth[i] == 0 {\r\n\t\t\tparetoCount++\r\n\t\t}\r\n\t}\r\n\ttype bestExperiment struct {\r\n\t\tID             string  `json:\"id\"`\r\n\t\tPipeline       string  `json:\"pipeline\"`\r\n\t\tCompositeScore float64 `json:\"composite_score\"`\r\n"]
[6216.554141, "o", "\t}\r\n\tvar best *bestExperiment\r\n\tif len(order) > 0 {\r\n\t\tidx := order[0]\r\n\t\tbest = &bestExperiment{ID: included[idx].ID, Pipeline: included[idx].Pipeline, CompositeScore: composite[idx]}\r\n\t}\r\n\tsummary := struct {\r\n\t\tTotal          int             `json:\"total_experiments\"`\r\n\t\tParetoCount    int             `json:\"pareto_count\"`\r\n\t\tMaxDominance   int             `json:\"max_dominance_depth\"`\r\n\t"]
[6216.554212, "o", "\tBestExperiment *bestExperiment `json:\"best_experiment\"`\r\n\t}{\r\n\t\tTotal:          len(included),\r\n\t\tParetoCount:    paretoCount,\r\n\t\tMaxDominance:   maxDepth,\r\n\t\tBestExperiment: best,\r\n\t}\r\n\tout := struct {\r\n\t\tPipelines      []string                  `json:\"pipelines\"`\r\n\t\tSharedMetrics  []string                  `json:\"shared_metrics\"`\r\n\t\tExperiments    []experimentOut           `json:\"experiments\"`\r\n\t\t"]
