[6231.744746, "o", "\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tp, err := loadPipeline(pipelineFile)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tif gc {\r\n"]
[6231.74481, "o", "\t\treturn artifactsGC(p)\r\n\t}\r\n\t_ = list\r\n\treturn artifactsList()\r\n}\r\n\r\nfunc parseRunArgs(args []string) (string, int, bool, error) {\r\n\tpipelineFile := \"\"\r\n\texperimentIndex := -1\r\n\tresume := false\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n"]
[6231.744878, "o", "\t\tcase \"--experiment\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn \"\", 0, false, fmt.Errorf(\"--experiment requires an index\")\r\n\t\t\t}\r\n\t\t\tidx, err := strconv.Atoi(args[i+1])\r\n\t\t\tif err != nil {\r\n"]
[6231.744963, "o", "\t\t\t\treturn \"\", 0, false, fmt.Errorf(\"invalid experiment index: %v\", err)\r\n\t\t\t}\r\n\t\t\texperimentIndex = idx\r\n\t\t\ti++\r\n\t\tcase \"--resume\":\r\n\t\t\tresume = true\r\n\t\tdefault:\r\n\t\t\tif pipelineFile == \"\" {\r\n\t\t\t\tpipelineFile = args[i]\r\n\t\t\t} else {\r\n"]
[6231.745062, "o", "\t\t\t\treturn \"\", 0, false, fmt.Errorf(\"unexpected argument: %s\", args[i])\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif pipelineFile == \"\" {\r\n\t\treturn \"\", 0, false, fmt.Errorf(\"usage: mlpipe run <pipeline.yaml> [--experiment <index>] [--resume]\")\r\n\t}\r\n\treturn pipelineFile, experimentIndex, resume, nil\r\n}\r\n\r\nfunc parseArtifactsArgs(args []string) (string, bool, bool, error) {\r\n\tpipelineFile := \"\"\r\n\tlist := false\r\n\tgc := false\r\n\tfor _, arg := range args {\r\n\t\tswitch arg {\r\n\t\tcase \"--list\":\r\n\t\t\tlist = true\r\n\t\tcase \"--gc\":\r\n\t\t\tgc = true\r\n\t\tdefault:\r\n\t\t\tif pipelineFile == \"\" {\r\n"]
[6231.745149, "o", "\t\t\t\tpipelineFile = arg\r\n\t\t\t} else {\r\n\t\t\t\treturn \"\", false, false, fmt.Errorf(\"unexpected argument: %s\", arg)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif pipelineFile == \"\" {\r\n\t\treturn \"\", false, false, fmt.Errorf(\"usage: mlpipe artifacts <pipeline.yaml> [--list] [--gc]\")\r\n\t}\r\n\treturn pipelineFile, list, gc, nil\r\n}\r\n\r\n"]
