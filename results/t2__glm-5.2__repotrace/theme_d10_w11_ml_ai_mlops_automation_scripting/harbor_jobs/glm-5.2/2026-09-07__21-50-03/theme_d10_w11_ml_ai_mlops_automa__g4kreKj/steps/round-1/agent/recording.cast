[3306.057903, "o", "  1078\t\t\tline := strings.TrimSpace(scanner.Text())\r\n  1079\t\t\tif line == \"\" || !strings.HasPrefix(line, \"{\") {\r\n  1080\t\t\t\tcontinue\r\n  1081\t\t\t}\r\n  1082\t\t\tvar m MetricData\r\n"]
[3306.058034, "o", "  1083\t\t\tif err := json.Unmarshal([]byte(line), &m); err == nil && m.Name != \"\" {\r\n  1084\t\t\t\tmetrics = append(metrics, m)\r\n  1085\t\t\t\tcontinue\r\n  1086\t\t\t}\r\n  1087\t\t\tvar mm map[string]interface{}\r\n  1088\t\t\tif err := json.Unmarshal([]byte(line), &mm); err == nil {\r\n  1089\t\t\t\tif name, ok := mm[\"metric\"].(string); ok {\r\n  1090\t\t\t\t\tmetrics = append(metrics, MetricData{Name: name, Value: asFloat(mm[\"value\"])})\r\n  1091\t\t\t\t}\r\n  1092\t\t\t}\r\n"]
[3306.058115, "o", "  1093\t\t}\r\n  1094\t\treturn metrics\r\n  1095\t}\r\n  1096\t\r\n  1097\tfunc compareMetric(val float64, op string, threshold float64) bool {\r\n  1098\t\tswitch op {\r\n  1099\t\tcase \">=\":\r\n  1100\t\t\treturn val >= threshold\r\n  1101\t\tcase \">\":\r\n  1102\t\t\treturn val > threshold\r\n  1103\t\tcase \"<=\":\r\n  1104\t\t\treturn val <= threshold\r\n  1105\t\tcase \"<\":\r\n  1106\t\t\treturn val < threshold\r\n  1107"]
[3306.058183, "o", "\t\tcase \"==\":\r\n  1108\t\t\treturn val == threshold\r\n  1109\t\tcase \"!=\":\r\n  1110\t\t\treturn val != threshold\r\n  1111"]
[3306.058243, "o", "\t\tdefault:\r\n  1112\t\t\treturn false\r\n  1113\t\t}\r\n  1114\t}\r\n  1115\t\r\n  1116\tfunc exitCodeFromError(err error) int {\r\n  1117\t\tif exiterr, ok := err.(*exec.ExitError); ok {\r\n  1118\t\t\treturn exiterr.ExitCode()\r\n  1119\t\t}\r\n  1120\t\treturn 1\r\n  1121\t}\r\n  1122\t\r\n"]
[3306.058303, "o", "  1123\tfunc updateArtifactIndex(experimentID, stageName string, stage Stage) error {\r\n  1124\t\tidx := loadArtifactIndex()\r\n  1125\t\tfor _, out := range stage.Outputs {\r\n  1126\t\t\tinfo, err := os.Stat(out.Path)\r\n  1127\t\t\tif err != nil {\r\n  1128\t\t\t\tcontinue\r\n  1129\t\t\t}\r\n  1130\t\t\tf, err := os.Open(out.Path)\r\n  1131\t\t\tif err != nil {\r\n  1132\t\t\t\tcontinue"]
[3306.058366, "o", "\r\n  1133\t\t\t}\r\n  1134\t\t\th := sha256.New()\r\n  1135\t\t\tif _, err := io.Copy(h, f); err != nil {\r\n  1136\t\t\t\tf.Close()\r\n  1137\t\t\t\tcontinue\r\n  1138\t\t\t}\r\n  1139\t\t\tf.Close()\r\n  1140\t\t\tidx.Entries = append(idx.Entries, ArtifactEntry{\r\n"]
