[8124.013145, "o", "func asString(v interface{}) string {\r\n\tif v == nil {\r\n\t\treturn \"\"\r\n\t}\r\n\tswitch x := v.(type) {\r\n\tcase string:\r\n\t\treturn x\r\n\tcase int:\r\n\t\treturn strconv.Itoa(x)\r\n"]
[8124.013202, "o", "\tcase float64:\r\n\t\treturn formatFloat(x)\r\n\tcase bool:\r\n\t\treturn strconv.FormatBool(x)\r\n\tdefault:\r\n\t\treturn fmt.Sprint(x)\r\n\t}\r\n}\r\n\r\n"]
[8124.01326, "o", "func asInt(v interface{}) int {\r\n\tswitch x := v.(type) {\r\n\tcase int:\r\n\t\treturn x\r\n\tcase float64:\r\n\t\treturn int(x)\r\n\tcase string:\r\n\t\tn, _ := strconv.Atoi(x)\r\n\t\treturn n\r\n\tdefault:\r\n\t\treturn 0"]
[8124.01332, "o", "\r\n\t}\r\n}\r\n\r\nfunc asFloat(v interface{}) float64 {\r\n\tswitch x := v.(type) {\r\n\tcase float64:\r\n\t\treturn x\r\n\tcase int:\r\n\t\treturn float64(x)\r\n\tcase string:\r\n\t\tf, _ := strconv.ParseFloat(x, 64)\r\n"]
[8124.013376, "o", "\t\treturn f\r\n\tdefault:\r\n\t\treturn 0\r\n\t}\r\n}\r\n\r\nfunc toStringSlice(v []interface{}) []string {\r\n\tout := make([]string, 0, len(v))\r\n"]
[8124.013432, "o", "\tfor _, item := range v {\r\n\t\tout = append(out, asString(item))\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc toStringMap(m map[string]interface{}) map[string]string {\r\n\tout := make(map[string]string)\r\n\tfor k, v := range m {\r\n\t\tout[k] = asString(v)\r\n"]
[8124.013489, "o", "\t}\r\n\treturn out\r\n}\r\n\r\nfunc formatFloat(f float64) string {\r\n\treturn strconv.FormatFloat(f, 'g', -1, 64)\r\n}\r\n\r\nfunc validatePipeline(p *Pipeline) []string {\r\n\tvar errs []string\r\n\tnames := make(map[string]int)"]
[8124.013546, "o", "\r\n\tstageSet := make(map[string]bool)\r\n\tstageMap := make(map[string]Stage)\r\n\r\n\tfor i, stage := range p.Stages {\r\n\t\tif stage.Name == \"\" {\r\n\t\t\terrs = append(errs, fmt.Sprintf(\"stage %d: missing required field name\", i))\r\n\t\t}\r\n\t\tif stage.Command == \"\" {\r\n\t\t\terrs = append(errs, fmt.Sprintf(\"stage %d: missing required field command\", i))\r\n\t\t}"]
[8124.013613, "o", "\r\n\t\tif stage.Name != \"\" {\r\n\t\t\tif prev, ok := names[stage.Name]; ok {\r\n\t\t\t\terrs = append(errs, fmt.Sprintf(\"duplicate stage name: %s (stages %d and %d)\", stage.Name, prev, i))\r\n\t\t\t} else {\r\n"]
[8124.013675, "o", "\t\t\t\tnames[stage.Name] = i\r\n\t\t\t}\r\n\t\t\tstageSet[stage.Name] = true\r\n\t\t\tstageMap[stage.Name] = stage\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, stage := range p.Stages {\r\n\t\tfor _, dep := range stage.DependsOn {\r\n\t\t\tif !stageSet[dep] {\r\n\t\t\t\terrs = append(errs, fmt.Sprintf(\"stage %q depends on undefined stage %q\", stage.Name, dep))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[8124.013734, "o", "\tfor _, stage := range p.Stages {\r\n\t\tif stage.Name == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tstate := make(map[string]int)\r\n\t\tvar check func(name string)\r\n\t\tcheck = func(name string) {\r\n\t\t\tstate[name] = 1\r\n\t\t\tfor _, dep := range stageMap[name].DependsOn {\r\n\t"]
[8124.013791, "o", "\t\t\tif !stageSet[dep] {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tif state[dep] == 1 {\r\n\t\t\t\t\terrs = append(errs, fmt.Sprintf(\"circular dependency detected involving stage: %s\", name))\r\n\t\t\t\t} else if state[dep] == 0 {\r\n\t\t\t\t\tcheck(dep)\r\n"]
[8124.013859, "o", "\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tstate[name] = 2\r\n\t\t}\r\n\t\tcheck(stage.Name)\r\n\t}\r\n\r\n\treturn errs\r\n}\r\n\r\nfunc topologicalGroups(p *Pipeline) ([][]string, error) {\r\n"]
[8124.013916, "o", "\tstageMap := make(map[string]Stage)\r\n\tfor _, stage := range p.Stages {\r\n\t\tstageMap[stage.Name] = stage\r\n\t}\r\n\r\n\tcompleted := make(map[string]bool)\r\n\tremaining := make(map[string]bool)\r\n"]
