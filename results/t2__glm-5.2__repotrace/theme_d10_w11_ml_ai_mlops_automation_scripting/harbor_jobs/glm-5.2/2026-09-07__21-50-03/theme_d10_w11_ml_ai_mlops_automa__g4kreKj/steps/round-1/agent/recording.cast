[6215.991357, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"bytes\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n"]
[6215.991451, "o", "\t\"fmt\"\r\n\t\"io\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe <command> [args...]\")\r\n\t\tfmt.Fprintln(os.Stderr, \"Commands: validate, plan, run, report, artifacts, compare, sweep\")\r\n\t"]
[6215.991521, "o", "\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\targs := os.Args[2:]\r\n\r\n\tswitch cmd {\r\n\tcase \"validate\":\r\n\t\tos.Exit(cmdValidate(args))\r\n\tcase \"plan\":\r\n\t\tos.Exit(cmdPlan(args))\r\n\t"]
[6215.991586, "o", "case \"run\":\r\n\t\tos.Exit(cmdRun(args))\r\n\tcase \"report\":\r\n\t\tos.Exit(cmdReport(args))\r\n\tcase \"artifacts\":\r\n\t\tos.Exit(cmdArtifacts(args))\r\n\tcase \"compare\":\r\n\t\tos.Exit(cmdCompare(args))\r\n\tcase \"sweep\":\r\n\t\tos.Exit(cmdSweep(args))\r\n"]
[6215.991647, "o", "\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"error: command %q is not implemented\\n\", cmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc cmdValidate(args []string) int {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe validate <pipeline.yaml>\")\r\n\t\treturn 1\r\n\t}\r\n\t"]
[6215.991707, "o", "p, err := loadPipeline(args[0])\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\terrs := validatePipeline(p)\r\n\tif len(errs) > 0 {\r\n\t\tfor _, e := range errs {\r\n\t\t\tfmt.Println(e)\r\n"]
[6215.99177, "o", "\t\t}\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc cmdPlan(args []string) int {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe plan <pipeline.yaml>\")\r\n\t\treturn 1\r\n"]
[6215.991841, "o", "\t}\r\n\tp, err := loadPipeline(args[0])\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1"]
[6215.991901, "o", "\r\n\t}\r\n\tif errs := validatePipeline(p); len(errs) > 0 {\r\n\t\tfor _, e := range errs {\r\n\t\t\tfmt.Fprintln(os.Stderr, e)\r\n\t\t}\r\n\t\treturn 1\r\n\t}\r\n\tgroups, err := topologicalGroups(p)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tcombos := parameterCombinations(p)\r\n"]
[6215.991993, "o", "\tout := struct {\r\n\t\tStagesOrder           [][]string               `json:\"stages_order\"`\r\n\t\tTotalExperiments      int                      `json:\"total_experiments\"`\r\n\t\tParameterCombinations []map[string]interface{} `json:\"parameter_combinations\"`\r\n\t}{\r\n\t\tStagesOrder:           groups,\r\n\t\tTotalExperiments:      len(combos),\r\n\t\tParameterCombinations: combos,\r\n\t}\r\n"]
[6215.992092, "o", "\tenc := json.NewEncoder(os.Stdout)\r\n\tenc.SetIndent(\"\", \"  \")\r\n\tif err := enc.Encode(out); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc cmdRun(args []string) int {\r\n\tpipelineFile, experimentIndex, resume, err := parseRunArgs(args)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tp, err := loadPipeline(pipelineFile)\r\n"]
[6215.992189, "o", "\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tif errs := validatePipeline(p); len(errs) > 0 {\r\n\t\tfor _, e := range errs {\r\n\t\t\tfmt.Fprintln(os.Stderr, e)\r\n\t\t}\r\n\t\treturn 1\r\n\t}\r\n\tcombos := parameterCombinations(p)\r\n\tif experimentIndex >= 0 {\r\n\t\tif experimentIndex >= len(combos) {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: experiment index %d out of range (0..%d)\\n\", experimentIndex, len(combos)-1)\r\n\t\t\treturn 1\r\n\t\t}\r\n\t"]
[6215.992233, "o", "\tcombos = []map[string]interface{}{combos[experimentIndex]}\r\n\t}\r\n\tfor _, combo := range combos {\r\n\t\tid := experimentID(combo)\r\n\t\tfmt.Fprintf(os.Stderr, \"Running experiment %s\\n\", id)\r\n\t\tif err := runExperiment(p, combo, resume); err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n"]
[6215.99232, "o", "\t\t\treturn 1\r\n\t\t}\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc cmdReport(args []string) int {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe report <pipeline.yaml>\")\r\n\t\treturn 1\r\n\t}\r\n"]
[6215.992384, "o", "\tp, err := loadPipeline(args[0])\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tif errs := validatePipeline(p); len(errs) > 0 {\r\n\t\tfor _, e := range errs {\r\n\t\t\tfmt.Fprintln(os.Stderr, e)\r\n\t\t}\r\n\t\treturn 1\r\n\t}\r\n"]
[6215.992451, "o", "\treturn reportPipeline(p)\r\n}\r\n\r\nfunc cmdArtifacts(args []string) int {\r\n\tpipelineFile, list, gc, err := parseArtifactsArgs(args)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t"]
[6215.992515, "o", "}\r\n\tp, err := loadPipeline(pipelineFile)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tif gc {\r\n\t\treturn artifactsGC(p)\r\n\t}\r\n\t_ = list\r\n\treturn artifactsList()\r\n}\r\n\r\nfunc parseRunArgs(args []string) (string, int, bool, error) {\r\n\tpipelineFile := \"\"\r\n\texperimentIndex := -1\r\n\tresume := false\r\n"]
[6215.992587, "o", "\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--experiment\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\treturn \"\", 0, false, fmt.Errorf(\"--experiment requires an index\")\r\n\t\t\t}\r\n\t\t\tidx, err := strconv.Atoi(args[i+1])\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn \"\", 0, false, fmt.Errorf(\"invalid experiment index: %v\", err)\r\n\t\t\t}"]
[6215.992644, "o", "\r\n\t\t\texperimentIndex = idx\r\n\t\t\ti++\r\n\t\tcase \"--resume\":\r\n\t\t\tresume = true\r\n\t\tdefault:\r\n\t\t\tif pipelineFile == \"\" {\r\n\t\t\t\tpipelineFile = args[i]\r\n\t\t\t} else {\r\n\t\t\t\treturn \"\", 0, false, fmt.Errorf(\"unexpected argument: %s\", args[i])\r\n"]
[6215.9927, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif pipelineFile == \"\" {\r\n\t\treturn \"\", 0, false, fmt.Errorf(\"usage: mlpipe run <pipeline.yaml> [--experiment <index>] [--resume]\")\r\n\t}\r\n\treturn pipelineFile, experimentIndex, resume, nil\r\n}\r\n\r\n"]
[6215.99276, "o", "func parseArtifactsArgs(args []string) (string, bool, bool, error) {\r\n\tpipelineFile := \"\"\r\n\tlist := false\r\n\tgc := false\r\n\tfor _, arg := range args {\r\n\t\tswitch arg {\r\n\t\tcase \"--list\":\r\n\t\t\tlist = true\r\n\t\tcase \"--gc\":\r\n\t\t\tgc = true\r\n"]
[6215.992819, "o", "\t\tdefault:\r\n\t\t\tif pipelineFile == \"\" {\r\n\t\t\t\tpipelineFile = arg\r\n\t\t\t} else {\r\n\t\t\t\treturn \"\", false, false, fmt.Errorf(\"unexpected argument: %s\", arg)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif pipelineFile == \"\" {\r\n"]
[6215.99288, "o", "\t\treturn \"\", false, false, fmt.Errorf(\"usage: mlpipe artifacts <pipeline.yaml> [--list] [--gc]\")\r\n\t}\r\n\treturn pipelineFile, list, gc, nil\r\n}\r\n\r\ntype Pipeline struct {\r\n\tName       string\r\n\tVersion    string\r\n\tParameters []Parameter\r\n\tStages     []Stage\r\n}\r\n"]
[6215.992951, "o", "\r\ntype Parameter struct {\r\n\tName   string\r\n\tValues []interface{}\r\n}\r\n\r\ntype Stage struct {\r\n\tName      string\r\n\tCommand   string\r\n\tDependsOn []string\r\n\tEnv       map[string]string\r\n\tMetrics   []Metric"]
[6215.993017, "o", "\r\n\tRetry     *Retry\r\n\tCondition *Condition\r\n"]
