[2138.494582, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K723\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kstate\u001b[m\u001b[K := make(map[string]int)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K726\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kstate\u001b[m\u001b[K[name] = 1\r\n"]
[2138.494632, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K731\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                if \u001b[01;31m\u001b[Kstate\u001b[m\u001b[K[dep] == 1 {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K733\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                } else if \u001b[01;31m\u001b[Kstate\u001b[m\u001b[K[dep] == 0 {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K737\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kstate\u001b[m\u001b[K[name] = 2\r\n"]
