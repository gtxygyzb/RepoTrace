[1984.42875, "o", "   325\tfunc parseYAML(data []byte) (interface{}, error) {\r\n   326\t    var lines []yamlLine\r\n   327\t    for _, raw := range strings.Split(string(data), \"\\n\") {\r\n   328\t        raw = strings.TrimRight(raw, \"\\r\")\r\n   329\t        trimmed := strings.TrimSpace(raw)\r\n   330\t        if trimmed == \"\" || strings.HasPrefix(trimmed, \"#\") {\r\n   331\t            continue\r\n   332\t        }\r\n   333\t        indent := 0\r\n   334\t        for indent < len(raw) && raw[indent] == ' ' {\r\n   335\t            indent++\r\n"]
[1984.42881, "o", "   336\t        }\r\n   337\t        content := strings.TrimRight(raw[indent:], \" \")\r\n   338\t        lines = append(lines, yamlLine{indent: indent, content: content})\r\n   339\t    }\r\n   340\t    if len(lines) == 0 {\r\n   341\t        return nil, nil\r\n   342\t    }\r\n   343\t    v, idx := parseBlock(lines, 0, 0)\r\n   344\t    if idx < len(lines) {\r\n   345\t"]
[1984.428869, "o", "        return nil, fmt.Errorf(\"unexpected YAML structure at line: %q\", lines[idx].content)\r\n   346\t    }\r\n   347\t    return v, nil\r\n   348\t}\r\n   349\t\r\n   350\tfunc parseBlock(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n   351\t    if idx >= len(lines) || lines[idx].indent < indent {\r\n   352\t        return nil, idx\r\n   353\t    }\r\n"]
[1984.428958, "o", "   354\t    if strings.HasPrefix(lines[idx].content, \"- \") || lines[idx].content == \"-\" {\r\n   355\t        return parseSequence(lines, idx, indent)\r\n   356\t    }\r\n   357\t    return parseMapping(lines, idx, indent)\r\n   358\t}\r\n   359\t\r\n   360\tfunc parseSequence(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n   361\t    seq := []interface{}{}\r\n"]
[1984.429024, "o", "   362\t    for idx < len(lines) && lines[idx].indent == indent && (strings.HasPrefix(lines[idx].content, \"- \") || lines[idx].content == \"-\") {\r\n   363\t        content := strings.TrimPrefix(lines[idx].content, \"-\")\r\n   364\t        content = strings.TrimLeft(content, \" \")\r\n   365\t        if content == \"\" {\r\n   366\t            val, next := parseBlock(lines, idx+1, indent+2)\r\n   367\t            seq = append(seq, val)\r\n   368\t            idx = next\r\n"]
[1984.429084, "o", "   369\t            continue\r\n   370\t        }\r\n   371\t        if isMappingStart(content) {\r\n   372\t            sublines := []yamlLine{{indent: indent + 2, content: content}}\r\n   373\t            start := idx + 1\r\n   374\t            for start < len(lines) && lines[start].indent > indent {\r\n   375\t                sublines = append(sublines, lines[start])\r\n   376\t                start++\r\n   377\t            }\r\n   378\t            val, _ := parseBlock(sublines, 0, indent+2)\r\n   379\t            seq = append(seq, val)\r\n   380\t            idx = start\r\n   381\t        } else {\r\n   382\t            seq = append(seq, parseScalar(content))\r\n"]
[1984.429148, "o", "   383\t            idx++\r\n   384\t        }\r\n   385\t    }\r\n   386\t    return seq, idx\r\n   387\t}\r\n   388\t\r\n   389\tfunc parseMapping(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n   390\t    m := map[string]interface{}{}\r\n   391\t    for idx < len(lines) && lines[idx].indent == indent {\r\n   392\t        content := lines[idx].content\r\n"]
[1984.42927, "o", "   393\t        if strings.HasPrefix(content, \"- \") || content == \"-\" {\r\n   394\t            break\r\n   395\t        }\r\n   396\t        key, value, ok := splitKeyValue(content)\r\n   397\t        if !ok {\r\n   398\t            return nil, idx\r\n   399\t        }\r\n   400\t        if value != \"\" {\r\n   401\t            m[key] = parseScalar(value)\r\n   402\t            idx++\r\n   403\t        } else {\r\n   404\t            val, next := parseBlock(lines, idx+1, indent+2)\r\n   405\t            m[key] = val\r\n   406\t            idx = next\r\n   407\t        }\r\n   408\t    }\r\n   409\t    return m, idx\r\n   410\t}\r\n   411\t\r\n"]
