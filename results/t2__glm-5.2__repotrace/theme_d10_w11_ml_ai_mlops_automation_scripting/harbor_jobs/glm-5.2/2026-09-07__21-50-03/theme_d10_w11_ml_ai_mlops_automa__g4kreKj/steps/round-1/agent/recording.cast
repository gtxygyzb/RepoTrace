[1915.357238, "o", "./data/sample/test.csv\r\n./data/sample/train.csv\r\n./go.mod\r\n./main.go\r\n./pipelines/broken_cycles.yaml\r\n./pipelines/image_classifier.yaml\r\n./pipelines/text_sentiment.yaml\r\n"]
[1915.357339, "o", "./stages/evaluate_model.sh\r\n./stages/export_model.sh\r\n./stages/extract_features.sh\r\n./stages/train_model.sh\r\n./stages/validate_data.sh\r\n"]
