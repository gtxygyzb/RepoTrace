[6303.127475, "o", "    21\tfunc main() {\r\n    22\t\tif len(os.Args) < 2 {\r\n    23\t\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe <command> [args...]\")\r\n    24\t\t\tfmt.Fprintln(os.Stderr, \"Commands: validate, plan, run, report, artifacts, compare, sweep\")\r\n    25\t\t\tos.Exit(1)\r\n    26\t\t}\r\n"]
[6303.127601, "o", "    27\t\r\n    28\t\tcmd := os.Args[1]\r\n    29\t\targs := os.Args[2:]\r\n    30\t\r\n    31\t\tswitch cmd {\r\n    32\t\tcase \"validate\":\r\n    33\t\t\tos.Exit(cmdValidate(args))\r\n    34\t\tcase \"plan\":\r\n    35\t\t\tos.Exit(cmdPlan(args))\r\n    36"]
[6303.127678, "o", "\t\tcase \"run\":\r\n    37\t\t\tos.Exit(cmdRun(args))\r\n    38\t\tcase \"report\":\r\n    39\t\t\tos.Exit(cmdReport(args))\r\n    40\t\tcase \"artifacts\":\r\n    41\t\t\tos.Exit(cmdArtifacts(args))\r\n    42\t\tcase \"compare\":\r\n    43\t\t\tos.Exit(cmdCompare(args))\r\n    44\t\tcase \"sweep\":\r\n    45\t\t\tos.Exit(cmdSweep(args))\r\n    46\t\tdefault:\r\n    47\t\t\tfmt.Fprintf(os.Stderr, \"error: command %q is not implemented\\n\", cmd)\r\n    48\t\t\tos.Exit(1)\r\n    49\t\t}\r\n    50\t}\r\n    51\t\r\n"]
[6303.127749, "o", "    52\tfunc cmdValidate(args []string) int {\r\n    53\t\tif len(args) < 1 {\r\n    54\t\t\tfmt.Fprintln(os.Stderr, \"Usage: mlpipe validate <pipeline.yaml>\")\r\n    55\t\t\treturn 1\r\n    56\t\t}\r\n    57\t\tp, err := loadPipeline(args[0])\r\n    58\t\tif err != nil {\r\n    59\t\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n    60\t\t\treturn 1\r\n    61\t\t}\r\n"]
[6303.127819, "o", "    62\t\terrs := validatePipeline(p)\r\n    63\t\tif len(errs) > 0 {\r\n    64\t\t\tfor _, e := range errs {\r\n    65\t\t\t\tfmt.Println(e)\r\n    66\t\t\t}\r\n    67\t\t\treturn 1\r\n    68\t\t}\r\n    69\t\treturn 0\r\n    70\t}\r\n"]
[6303.129602, "o", "\u001b[?2004hroot@n30009:/app# "]
