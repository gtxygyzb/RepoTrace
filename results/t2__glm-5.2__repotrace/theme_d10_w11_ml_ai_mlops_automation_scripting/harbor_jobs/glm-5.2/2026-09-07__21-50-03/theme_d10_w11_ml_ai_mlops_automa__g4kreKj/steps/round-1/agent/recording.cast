[6216.554361, "o", "\t\t\tMaxDominance   int             `json:\"max_dominance_depth\"`\r\n\t\t\tBestExperiment *bestExperiment `json:\"best_experiment\"`\r\n\t\t} `json:\"summary\"`\r\n\t}{\r\n\t\tPipelines:      pipelineNames,\r\n\t\tSharedMetrics:  sharedMetrics,\r\n\t\tExperiments:    experiments,\r\n\t\tParetoFrontier: paretoFrontier,\r\n\t\tCorrelations:   correlations,\r\n\t\tSummary:        summary,\r\n\t}\r\n\tenc := json.NewEncoder(os.Stdout)\r\n"]
[6216.554437, "o", "\tenc.SetIndent(\"\", \"  \")\r\n\tif err := enc.Encode(out); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc computeCorrelations(experiments []compareExperimentData, a, b string) (*float64, *float64) {\r\n\tn := len(experiments)\r\n\tif n < 3 {\r\n\t\treturn nil, nil\r\n\t}\r\n\tvaluesA := make([]float64, n)\r\n\tvaluesB := make([]float64, n)\r\n\tfor i, e := range experiments {\r\n\t\tvaluesA[i] = e.Metrics[a]\r\n\t\tvaluesB[i] = e.Metrics[b]\r\n"]
[6216.554509, "o", "\t}\r\n\trho := spearmanRankCorrelation(valuesA, valuesB)\r\n\tr := round4(rho)\r\n\ttau := kendallTauB(valuesA, valuesB)\r\n\tif tau == nil {\r\n\t\treturn &r, nil\r\n\t}\r\n\tt := round4(*tau)\r\n\treturn &r, &t\r\n}\r\n\r\n"]
[6216.554578, "o", "func spearmanRankCorrelation(a, b []float64) float64 {\r\n\tn := len(a)\r\n\trankA := fractionalRanks(a)\r\n\trankB := fractionalRanks(b)\r\n\tsumD2 := 0.0\r\n\tfor i := 0; i < n; i++ {\r\n\t\td := rankA[i] - rankB[i]\r\n\t\tsumD2 += d * d\r\n\t}\r\n\treturn 1 - 6*sumD2/(float64(n)*(float64(n)*float64(n)-1))\r\n}\r\n\r\nfunc fractionalRanks(values []float64) []float64 {\r\n\tn := len(values)\r\n"]
