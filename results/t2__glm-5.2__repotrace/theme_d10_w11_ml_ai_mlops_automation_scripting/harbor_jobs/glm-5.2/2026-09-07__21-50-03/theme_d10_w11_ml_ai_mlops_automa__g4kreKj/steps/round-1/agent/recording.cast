[8132.546735, "o", "   321\tfunc loadPipeline(path string) (*Pipeline, error) {\r\n   322\t\tdata, err := os.ReadFile(path)\r\n   323\t\tif err != nil {\r\n   324\t\t\treturn nil, err\r\n   325\t\t}\r\n   326\t\tv, err := parseYAML(data)\r\n   327\t\tif err != nil {\r\n   328\t\t\treturn nil, err\r\n   329\t\t}\r\n   330\t\treturn mapToPipeline(v)\r\n   331\t}\r\n   332\t\r\n"]
[8132.546806, "o", "   333\tfunc parseYAML(data []byte) (interface{}, error) {\r\n   334\t\tvar lines []yamlLine\r\n   335\t\tfor _, raw := range strings.Split(string(data), \"\\n\") {\r\n   336\t\t\traw = strings.TrimRight(raw, \"\\r\")\r\n   337\t\t\ttrimmed := strings.TrimSpace(raw)\r\n"]
[8132.546867, "o", "   338\t\t\tif trimmed == \"\" || strings.HasPrefix(trimmed, \"#\") {\r\n   339\t\t\t\tcontinue\r\n   340\t\t\t}\r\n   341\t\t\tindent := 0\r\n   342\t\t\tfor indent < len(raw) && raw[indent] == ' ' {\r\n   343\t\t\t\tindent++\r\n   344\t\t\t}\r\n   345\t\t\tcontent := strings.TrimRight(raw[indent:], \" \")\r\n   346\t\t\tlines = append(lines, yamlLine{indent: indent, content: content})\r\n   347\t\t}\r\n   348\t\tif len(lines) == 0 {\r\n   349\t"]
[8132.546968, "o", "\t\treturn nil, nil\r\n   350\t\t}\r\n   351\t\tv, idx := parseBlock(lines, 0, 0)\r\n   352\t\tif idx < len(lines) {\r\n   353\t\t\treturn nil, fmt.Errorf(\"unexpected YAML structure at line: %q\", lines[idx].content)\r\n   354\t\t}\r\n   355\t\treturn v, nil\r\n   356\t}\r\n   357\t\r\n   358\tfunc parseBlock(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n   359\t\tif idx >= len(lines) || lines[idx].indent < indent {\r\n   360\t\t\treturn nil, idx\r\n   361\t\t}\r\n"]
[8132.54703, "o", "   362\t\tif strings.HasPrefix(lines[idx].content, \"- \") || lines[idx].content == \"-\" {\r\n   363\t\t\treturn parseSequence(lines, idx, indent)\r\n   364\t\t}\r\n   365\t\treturn parseMapping(lines, idx, indent)\r\n   366\t}\r\n   367\t\r\n   368\tfunc parseSequence(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n   369\t\tseq := []interface{}{}\r\n   370\t\tfor idx < len(lines) && lines[idx].indent == indent && (strings.HasPrefix(lines[idx].content, \"- \") || lines[idx].content == \"-\") {\r\n   371\t\t\tcontent := strings.TrimPrefix(lines[idx].content, \"-\")\r\n   372\t\t\t"]
[8132.547104, "o", "content = strings.TrimLeft(content, \" \")\r\n   373\t\t\tif content == \"\" {\r\n   374\t\t\t\tval, next := parseBlock(lines, idx+1, indent+2)\r\n   375\t\t\t\tseq = append(seq, val)\r\n   376\t\t\t\tidx = next\r\n   377\t\t\t\tcontinue\r\n   378\t\t\t}\r\n   379\t\t\tif isMappingStart(content) {\r\n   380\t\t\t\tsublines := []yamlLine{{indent: indent + 2, content: content}}\r\n   381\t\t\t\tstart := idx + 1\r\n   382\t\t\t\tfor start < len(lines) && lines[start].indent > indent {\r\n"]
[8132.547175, "o", "   383\t\t\t\t\tsublines = append(sublines, lines[start])\r\n   384\t\t\t\t\tstart++\r\n   385\t\t\t\t}\r\n   386\t\t\t\tval, _ := parseBlock(sublines, 0, indent+2)\r\n   387\t\t\t\tseq = append(seq, val)\r\n   388\t\t\t\tidx = start\r\n   389\t\t\t} else {\r\n   390\t\t\t\tseq = append(seq, parseScalar(content))\r\n   391\t\t\t\tidx++\r\n"]
[8132.547256, "o", "   392\t\t\t}\r\n   393\t\t}\r\n   394\t\treturn seq, idx\r\n   395\t}\r\n   396\t\r\n   397\tfunc parseMapping(lines []yamlLine, idx int, indent int) (interface{}, int) {\r\n   398\t\tm := map[string]interface{}{}\r\n   399\t\tfor idx < len(lines) && lines[idx].indent == indent {\r\n   400\t\t\tcontent := lines[idx].content\r\n   401\t\t\tif strings.HasPrefix(content, \"- \") || content == \"-\" {\r\n"]
[8132.547325, "o", "   402\t\t\t\tbreak\r\n   403\t\t\t}\r\n   404\t\t\tkey, value, ok := splitKeyValue(content)\r\n   405\t\t\tif !ok {\r\n   406\t\t\t\treturn nil, idx\r\n   407\t\t\t}\r\n   408\t\t\tif value != \"\" {\r\n   409\t\t\t\tm[key] = parseScalar(value)\r\n   410\t\t\t\tidx++\r\n   411\t\t\t} else {\r\n"]
[8132.547407, "o", "   412\t\t\t\tval, next := parseBlock(lines, idx+1, indent+2)\r\n   413\t\t\t\tm[key] = val\r\n   414\t\t\t\tidx = next\r\n   415\t\t\t}\r\n   416\t\t}\r\n   417\t\treturn m, idx\r\n   418\t}\r\n   419\t\r\n   420\tfunc isMappingStart(s string) bool {\r\n   421\t\tif strings.HasPrefix(s, \"[\") || strings.HasPrefix(s, \"{\") {\r\n   422\t\t\treturn false\r\n"]
[8132.547476, "o", "   423\t\t}\r\n   424\t\t_, _, ok := splitKeyValue(s)\r\n   425\t\treturn ok\r\n   426\t}\r\n   427\t\r\n   428\tfunc splitKeyValue(s string) (string, string, bool) {\r\n   429\t\tinQuote := false\r\n   430\t\tquoteChar := byte(0)\r\n   431\t\tfor i := 0; i < len(s); i++ {\r\n   432\t\t\tc := s[i]\r\n   433\t\t\tif inQuote {\r\n"]
[8132.547534, "o", "   434\t\t\t\tif c == quoteChar {\r\n   435\t\t\t\t\tinQuote = false\r\n   436\t\t\t\t}\r\n   437\t\t\t\tcontinue\r\n   438\t\t\t}\r\n   439\t\t\tif c == '\"' || c == '\\'' {\r\n   440\t\t\t\tinQuote = true\r\n"]
