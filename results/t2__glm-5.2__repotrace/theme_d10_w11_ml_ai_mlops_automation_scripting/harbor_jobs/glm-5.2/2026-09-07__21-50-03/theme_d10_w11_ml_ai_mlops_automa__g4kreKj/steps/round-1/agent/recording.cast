[6471.169435, "o", "   688\tfunc formatFloat(f float64) string {\r\n   689\t\treturn strconv.FormatFloat(f, 'g', -1, 64)\r\n   690\t}\r\n   691\t\r\n   692\tfunc validatePipeline(p *Pipeline) []string {\r\n   693\t\tvar errs []string\r\n"]
[6471.169568, "o", "   694\t\tnames := make(map[string]int)\r\n   695\t\tstageSet := make(map[string]bool)\r\n   696\t\tstageMap := make(map[string]Stage)\r\n   697\t\r\n   698\t\tfor i, stage := range p.Stages {\r\n   699\t\t\tif stage.Name == \"\" {\r\n   700\t\t\t\terrs = append(errs, fmt.Sprintf(\"stage %d: missing required field name\", i))\r\n   701\t\t\t}\r\n   702\t\t\tif stage.Command == \"\" {\r\n   703\t\t\t\terrs = append(errs, fmt.Sprintf(\"stage %d: missing required field command\", i))\r\n   704\t\t\t}\r\n   705\t\t\tif stage.Name != \"\" {\r\n   706\t\t\t\tif prev, ok := names[stage.Name]; ok {\r\n   707\t\t\t\t\terrs = append(errs, fmt.Sprintf(\"duplicate stage name: %s (stages %d and %d)\", stage.Name, prev, i))\r\n   708\t\t\t\t} else {\r\n   709\t\t\t\t\tnames[stage.Name] = i\r\n   710\t\t\t\t}\r\n"]
[6471.169657, "o", "   711\t\t\t\tstageSet[stage.Name] = true\r\n   712\t\t\t\tstageMap[stage.Name] = stage\r\n   713\t\t\t}\r\n   714\t\t}\r\n   715\t\r\n   716\t\tfor _, stage := range p.Stages {\r\n   717\t\t\tfor _, dep := range stage.DependsOn {\r\n   718\t\t\t\tif !stageSet[dep] {\r\n   719\t\t\t\t\terrs = append(errs, fmt.Sprintf(\"stage %q depends on undefined stage %q\", stage.Name, dep))\r\n   720\t\t\t\t}\r\n"]
