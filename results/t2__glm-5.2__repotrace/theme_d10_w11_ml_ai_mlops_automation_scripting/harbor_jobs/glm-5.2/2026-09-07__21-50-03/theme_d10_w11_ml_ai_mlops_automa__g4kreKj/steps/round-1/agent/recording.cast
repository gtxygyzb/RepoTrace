[8124.012702, "o", "}\r\n\tif len(s) >= 2 && s[0] == '\\'' && s[len(s)-1] == '\\'' {\r\n\t\treturn strings.ReplaceAll(s[1:len(s)-1], \"''\", \"'\")\r\n\t}\r\n\treturn s\r\n}\r\n\r\nfunc mapToPipeline(v interface{}) (*Pipeline, error) {\r\n\tp := &Pipeline{}\r\n\troot := asMap(v)\r\n\tif root == nil {\r\n\t\treturn p, nil\r\n"]
