[3370.830422, "o", "   938\tfunc reportPipeline(p *Pipeline) int {\r\n   939\t\ttype reportExperiment struct {\r\n   940\t\t\tID      string             `json:\"id\"`\r\n   941\t\t\tMetrics map[string]float64 `json:\"metrics\"`\r\n   942\t\t\tStages  []StageState       `json:\"stages\"`\r\n   943\t"]
[3370.830564, "o", "\t}\r\n   944\t\ttype reportOutput struct {\r\n   945\t\t\tPipeline    string             `json:\"pipeline\"`\r\n   946\t\t\tExperiments []reportExperiment `json:\"experiments\"`\r\n   947\t\t}\r\n   948\t\r\n   949\t\tout := reportOutput{Pipeline: p.Name, Experiments: []reportExperiment{}}\r\n   950\t\tfor _, combo := range parameterCombinations(p) {\r\n   951\t\t\tid := experimentID(combo)\r\n   952\t\t\texp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}\r\n"]
[3370.830613, "o", "   953\t\t\tfor _, stage := range p.Stages {\r\n   954\t\t\t\tif st, err := readStageState(id, stage.Name); err == nil {\r\n   955\t\t\t\t\texp.Stages = append(exp.Stages, *st)\r\n"]
[3370.830717, "o", "   956\t\t\t\t\tfor _, m := range st.Metrics {\r\n   957\t\t\t\t\t\texp.Metrics[m.Name] = m.Value\r\n   958\t\t\t\t\t}\r\n   959\t\t\t\t}\r\n   960\t\t\t}\r\n   961\t\t\tout.Experiments = append(out.Experiments, exp)\r\n   962\t\t}\r\n   963\t\tenc := json.NewEncoder(os.Stdout)\r\n   964\t\tenc.SetIndent(\"\", \"  \")\r\n   965\t\tif err := enc.Encode(out); err != nil {\r\n   966\t\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n   967\t\t\treturn 1\r\n   968\t\t}\r\n   969\t\treturn 0\r\n   970\t}\r\n"]
