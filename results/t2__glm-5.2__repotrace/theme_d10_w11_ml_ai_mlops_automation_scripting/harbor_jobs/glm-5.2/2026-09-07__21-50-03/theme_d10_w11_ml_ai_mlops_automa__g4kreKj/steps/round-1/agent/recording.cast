[1332.810892, "o", "        }\r\n        for _, ov := range asSlice(sm[\"outputs\"]) {\r\n            om := asMap(ov)\r\n            stage.Outputs = append(stage.Outputs, ArtifactRef{Path: asString(om[\"path\"]), Type: asString(om[\"type\"])})\r\n        }\r\n        for _, iv := range asSlice(sm[\"inputs\"]) {\r\n            im := asMap(iv)\r\n            stage.Inputs = append(stage.Inputs, ArtifactRef{Path: asString(im[\"path\"]), Type: asString(im[\"type\"])})\r\n        }\r\n        p.Stages = append(p.Stages, stage)\r\n    }\r\n    return p, nil\r\n"]
[1332.810991, "o", "}\r\n\r\nfunc asMap(v interface{}) map[string]interface{} {\r\n    if m, ok := v.(map[string]interface{}); ok {\r\n        return m\r\n    }\r\n    return nil\r\n}\r\n\r\nfunc asSlice(v interface{}) []interface{} {\r\n    if s, ok := v.([]interface{}); ok {\r\n        return s\r\n    }\r\n    return nil\r\n}\r\n\r\nfunc asString(v interface{}) string {\r\n    if v == nil {\r\n        return \"\"\r\n"]
[1332.811049, "o", "    }\r\n    switch x := v.(type) {\r\n    case string:\r\n        return x\r\n    case int:\r\n        return strconv.Itoa(x)\r\n    case float64:\r\n        return formatFloat(x)\r\n    case bool:\r\n        return strconv.FormatBool(x)\r\n    default:\r\n        return fmt.Sprint(x)\r\n    }\r\n}\r\n\r\nfunc asInt(v interface{}) int {"]
