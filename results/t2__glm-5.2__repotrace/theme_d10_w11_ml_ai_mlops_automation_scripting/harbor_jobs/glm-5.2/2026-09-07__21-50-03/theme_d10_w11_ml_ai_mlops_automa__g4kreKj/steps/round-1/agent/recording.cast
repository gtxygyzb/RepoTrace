[2187.627183, "o", "     1\tname: broken-circular-pipeline\r\n     2\tversion: \"1.0\"\r\n     3\t\r\n     4\tstages:\r\n     5\t  - name: stage-a\r\n     6\t    command: \"echo a\"\r\n     7\t    depends_on: [\"stage-c\"]\r\n     8\t    outputs:\r\n"]
[2187.62729, "o", "     9\t      - path: \"out/a.txt\"\r\n    10\t        type: file\r\n    11\t\r\n    12\t  - name: stage-b\r\n    13\t    command: \"echo b\"\r\n    14\t    depends_on: [\"stage-a\"]\r\n    15\t    outputs:\r\n    16\t      - path: \"out/b.txt\"\r\n    17\t        type: file\r\n    18\t\r\n    19\t  - name: stage-c\r\n    20\t    command: \"echo c\"\r\n    21\t    depends_on: [\"stage-b\"]\r\n    22\t    outputs:\r\n    23\t      - path: \"out/c.txt\"\r\n    24\t        type: file\r\n"]
