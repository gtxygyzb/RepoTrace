[6231.744424, "o", "\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tp, err := loadPipeline(pipelineFile)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tif errs := validatePipeline(p); len(errs) > 0 {\r\n\t\tfor _, e := range errs {\r\n\t\t\tfmt.Fprintln(os.Stderr, e)\r\n\t\t}\r\n\t"]
