        filterStatus = strings.TrimPrefix(arg, "--filter-status=")\n                case arg == "--stage":\n                        if i+1 >= len(args) {\n                                fmt.Fprintln(os.Stderr, "error: --stage requires a value")\n                                return 1\n                        }\n                        i++\n                        stageFilter = args[i]\n                case strings.HasPrefix(arg, "--stage="):\n                        stageFilter = strings.TrimPrefix(arg, "--stage=")\n                case pipelineFile == "":\n                        pipelineFile = arg\n                default:\n                        fmt.Fprintf(os.Stderr, "error: unknown argument %q\\n", arg)\n                        return 1\n                }\n        }\n        if pipelineFile == "" {\n                fmt.Fprintln(os.Stderr, "Usage: mlpipe status <pipeline.yaml> [--filter-status <status>] [--stage <name>]")\n                return 1\n        }\n        if filterStatus != "" && filterStatus != "completed" && filterStatus != "failed" && filterStatus != "pending" && filterStatus != "running" {\n                fmt.Fprintf(os.Stderr, "error: invalid filter status %q\\n", filterStatus)\n                return 1\n        }\n        p, err := loadPipeline(pipelineFile)\n        if err != nil {\n                fmt.Fprintln(os.Stderr, "error:", err)\n                return 1\n        }\n        if errs := validatePipeline(p); len(errs) > 0 {\n                for _, e := range errs {\n                        fmt.Fprintln(os.Stderr, e)\n                }\n                return 1\n        }\n        stageNames, err := pipelineStageNames(p)\n        if err != nil {\n                fmt.Fprintln(os.Stderr, "error:", err)\n                return 1\n        }\n        if stageFilter != "" {\n                found := false\n                for _, name := range stageNames {\n                        if name == stageFilter {\n                                found = true\n                                break\n                        }\n                }\n                if !found {\n                        fmt.Fprintf(os.Stderr, "error: stage %q not found in pipeline\\n", stageFilter)\n                        return 1\n                }\n        }\n\n        expected := expectedExperimentIDs(p)\n        sort.Strings(expected)\n\n        type expInfo struct {\n                id       string\n                params   map[string]string\n                stages   []statusStage\n                status   string\n                totalDur float64\n        }\n        infos := make([]expInfo, 0, len(expected))\n        stageFailCounts := map[string]int{}\n        stageDurations := map[string][]float64{}\n        stagePending := map[string]int{}\n        stageSkipped := map[string]int{}\n        stageCompleted := map[string]int{}\n        stageFailed := map[string]int{}\n        for _, stage := range stageNames {\n                stageFailCounts[stage] = 0\n                stageDurations[stage] = []float64{}\n                stagePending[stage] = 0\n                stageSkipped[stage] = 0\n                stageCompleted[stage] = 0\n                stageFailed[stage] = 0\n        }\n\n        completedExperiments := 0\n        failedExperiments := 0\n        pendingExperiments := 0\n        totalDurCompleted := 0.0\n        completedCount := 0\n\n        for _, id := range expected {\n                params := extractExperimentParams(p, id)\n                stages := []statusStage{}\n                hasAnyState := false\n                anyRunning := false\n                anyFailed := false\n                allCompletedOrSkipped := true\n                completedStages := 0\n                totalDur := 0.0\n\n                for _, stage := range stageNames {\n                        if stageFilter != "" && stage != stageFilter {\n                                // Still compute summary below by reading state even if filtered out of