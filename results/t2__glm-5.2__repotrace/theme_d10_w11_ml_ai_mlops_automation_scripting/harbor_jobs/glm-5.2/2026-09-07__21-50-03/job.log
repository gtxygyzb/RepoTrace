Sending keys: ['cat >> main.go <<\'EOF\'\n\nfunc validatePipeline(p *Pipeline) []string {\n    var errs []string\n    names := make(map[string]int)\n    stageSet := make(map[string]bool)\n    stageMap := make(map[string]Stage)\n\n    for i, stage := range p.Stages {\n        if stage.Name == "" {\n            errs = append(errs, fmt.Sprintf("stage %d: missing required field name", i))\n        }\n        if stage.Command == "" {\n            errs = append(errs, fmt.Sprintf("stage %d: missing required field command", i))\n        }\n        if stage.Name != "" {\n            if prev, ok := names[stage.Name]; ok {\n                errs = append(errs, fmt.Sprintf("duplicate stage name: %s (stages %d and %d)", stage.Name, prev, i))\n            } else {\n                names[stage.Name] = i\n            }\n            stageSet[stage.Name] = true\n            stageMap[stage.Name] = stage\n        }\n    }\n\n    for _, stage := range p.Stages {\n        for _, dep := range stage.DependsOn {\n            if !stageSet[dep] {\n                errs = append(errs, fmt.Sprintf("stage %q depends on undefined stage %q", stage.Name, dep))\n            }\n        }\n    }\n\n    for _, stage := range p.Stages {\n        if stage.Name == "" {\n            continue\n        }\n        state := make(map[string]int)\n        var check func(name string)\n        check = func(name string) {\n            state[name] = 1\n            for _, dep := range stageMap[name].DependsOn {\n                if !stageSet[dep] {\n                    continue\n                }\n                if state[dep] == 1 {\n                    errs = append(errs, fmt.Sprintf("circular dependency detected involving stage: %s", name))\n                } else if state[dep] == 0 {\n                    check(dep)\n                }\n            }\n            state[name] = 2\n        }\n        check(stage.Name)\n    }\n\n    return errs\n}\n\nfunc topologicalGroups(p *Pipeline) ([][]string, error) {\n    stageMap := make(map[string]Stage)\n    for _, stage := range p.Stages {\n        stageMap[stage.Name] = stage\n    }\n\n    completed := make(map[string]bool)\n    remaining := make(map[string]bool)\n    for _, stage := range p.Stages {\n        remaining[stage.Name] = true\n    }\n\n    var groups [][]string\n    for len(remaining) > 0 {\n        var ready []string\n        for name := range remaining {\n            ok := true\n            for _, dep := range stageMap[name].DependsOn {\n                if !completed[dep] {\n                    ok = false\n                    break\n                }\n            }\n            if ok {\n                ready = append(ready, name)\n            }\n        }\n        sort.Strings(ready)\n        if len(ready) == 0 {\n            return nil, fmt.Errorf("circular dependency detected among stages: %v", sortedKeys(remaining))\n        }\n        groups = append(groups, ready)\n        for _, name := range ready {\n            completed[name] = true\n            delete(remaining, name)\n        }\n    }\n    return groups, nil\n}\n\nfunc parameterCombinations(p *Pipeline) []map[string]interface{} {\n    if len(p.Parameters) == 0 {\n        return []map[string]interface{}{{}}\n    }\n    combos := []map[string]interface{}{{}}\n    for _, param := range p.Parameters {\n        next := make([]map[string]interface{}, 0, len(combos)*len(param.Values))\n        for _, combo := range combos {\n            for _, value := range param.Values {\n                c := copyMap(combo)\n                c[param.Name] = value\n                next = append(next, c)\n            }\n        }\n        combos = next\n    }\n    return combos\n}\n\nfunc experimentID(combo map[string]interface{}) string {\n    if len(combo) == 0 {\n        return "exp_default"\n    }\n    keys := make([]string, 0, len(combo))\n    for k := range combo {\n        keys = append(keys, k)\n    }\n    sort.Strings(keys)\n    parts := make([]string, 0, len(keys))\n    for _, k := range keys {\n        parts = append(parts, k+"="+asString(combo[k]))\n    }\n    return "exp_" + strings.Join(parts, "_")\n}\n\nfunc substituteParams(value string, combo map[string]interface{}) string {\n    for k, v := range combo {\n        value = strings.ReplaceAll(value, "${"+k+"}", asString(v))\n    }\n    return value\n}\n\nfunc copyMap(m map[string]interface{}) map[string]interface{} {\n    out := make(map[string]interface{}, len(m))\n    for k, v := range m {\n        out[k] = v\n    }\n    return out\n}\n\nfunc sortedKeys(m map[string]bool) []string {\n    keys := make([]string, 0, len(m))\n    for k := range m {\n        keys = append(keys, k)\n    }\n    sort.Strings(keys)\n    return keys\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
