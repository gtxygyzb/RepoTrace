; err == nil {\n                exp.Stages = append(exp.Stages, *st)\n                for _, m := range st.Metrics {\n                    exp.Metrics[m.Name] = m.Value\n                    metricValues[m.Name] = append(metricValues[m.Name], m.Value)\n                }\n            }\n        }\n        out.Experiments = append(out.Experiments, exp)\n    }\n    for name, values := range metricValues {\n        out.MetricSummary[name] = metricSummaryEntry{\n            Count: len(values),\n            Mean:  round4(meanValue(values)),\n            Std:   round4(sampleStd(values)),\n            Min:   round4(minValue(values)),\n            Max:   round4(maxValue(values)),\n        }\n    }\n\n    objectives := map[string]string{}\n    for _, stage := range p.Stages {\n        for _, m := range stage.Metrics {\n            if m.Objective == "minimize" || m.Objective == "maximize" {\n                objectives[m.Name] = m.Objective\n            }\n        }\n    }\n    objMetrics := make([]string, 0, len(objectives))\n    for m := range objectives {\n        objMetrics = append(objMetrics, m)\n    }\n    sort.Strings(objMetrics)\n\n    if len(objMetrics) > 0 {\n        minVal := map[string]float64{}\n        maxVal := map[string]float64{}\n        for _, m := range objMetrics {\n            if vals, ok := metricValues[m]; ok && len(vals) > 0 {\n                minVal[m] = minValue(vals)\n                maxVal[m] = maxValue(vals)\n            }\n        }\n\n        normalized := make([]map[string]float64, len(out.Experiments))\n        for i, exp := range out.Experiments {\n            normalized[i] = make(map[string]float64)\n            normOut := make(map[string]float64)\n            for _, m := range objMetrics {\n                val, ok := exp.Metrics[m]\n                if !ok {\n                    continue\n                }\n                rng := maxVal[m] - minVal[m]\n                var norm float64\n                if rng == 0 {\n                    norm = 0.5\n                } else if objectives[m] == "maximize" {\n                    norm = (val - minVal[m]) / rng\n                } else {\n                    norm = (maxVal[m] - val) / rng\n                }\n                normalized[i][m] = norm\n                normOut[m] = round4(norm)\n            }\n            out.NormalizedMetrics[exp.ID] = normOut\n        }\n\n        composite := make([]float64, len(out.Experiments))\n        for i := range out.Experiments {\n            if len(normalized[i]) == 0 {\n                composite[i] = 0\n            } else {\n                sum := 0.0\n                for _, m := range objMetrics {\n                    if norm, ok := normalized[i][m]; ok {\n                        sum += norm\n                    }\n                }\n                composite[i] = sum / float64(len(normalized[i]))\n            }\n            out.CompositeScores[out.Experiments[i].ID] = round4(composite[i])\n        }\n\n        for _, m := range objMetrics {\n            out.MetricRankings[m] = map[string]int{}\n            type idxVal struct {\n                idx int\n                val float64\n            }\n            var items []idxVal\n            for i, exp := range out.Experiments {\n                if val, ok := exp.Metrics[m]; ok {\n                    items = append(items, idxVal{i, val})\n                }\n            }\n            sort.SliceStable(items, func(a, b int) bool {\n                va := items[a].val\n                vb := items[b].val\n                if va != vb {\n                    if objectives[m] == "maximize" {\n                        return va > vb\n                    }\n                    return va < vb\n                }\n                return out.Experiments[items[a].idx].ID < out.Experiments[items[b].idx].ID\n            })\n            currentRank := 0\n            prevVal := math.NaN()\n            for _, item := range items {\n                if currentRank == 0 || item.val != prevVal {\n                    currentRank++\n                    prevVal = item.val\n                }\n                out.MetricRankings[m][out.Experiments[item.idx].ID] = currentRank\n            }\n        }\n\n        for _, m := range objMetrics {\n            var norms []float64\n            for i := range out.Experiments {\n                if norm, ok := normalized[i][m]; ok {\n                    norms = append(norms, norm)\n                }\n            }\n            out.MetricImportance[m] = round4(sampleStd(norms))\n        }\n\n        for _, m := range objMetrics {\n            if len(objMetrics) <= 1 {\n                bestID := ""\n                for _, exp := range out.Experiments {\n                    if bestID == "" || exp.ID < bestID {\n                        bestID = exp.ID\n                    }\n                }\n                out.ScoreSensitivity[m] = sensitivityEntry{\n                    BestWithout:  bestID,\n                    MaxComposite: 0,\n                }\n                continue\n            }\n            type idxScore struct {\n                idx   int\n                score float64\n            }\n            var scores []idxScore\n            for i := range out.Experiments {\n                sum := 0.0\n                count := 0\n                for _, mm := range objMetrics {\n                    if mm == m {\n                        continue\n                    }\n                    if norm, ok := normalized[i][mm]; ok {\n                        sum += norm\n                        count++\n                    }\n                }\n                var score float64\n                if count > 0 {\n                    score = sum / float64(count)\n                }\n                scores = append(scores, idxScore{i, score})\n            }\n            sort.SliceStable(scores, func(a, b int) bool {\n                if scores[a].score != scores[b].score {\n                    return scores[a].score > scores[b].score\n                }\n                return out.Experiments[scores[a].idx].ID < out.Experiments[scores[b].idx].ID\n            })\n            bestID := ""\n            maxScore := 0.0\n            if len(scores) > 0 {\n                bestID = out.Experiments[scores[0].idx].ID\n                maxScore = scores[0].score\n            }\n            out.ScoreSensitivity[m] = sensitivityEntry{\n                BestWithout:  bestID,\n                MaxComposite: round4(maxScore),\n            }\n        }\n\n        bestIdx := -1\n        var bestScore float64\n        for i := range out.Experiments {\n            if bestIdx == -1 || composite[i] > bestScore || (composite[i] == bestScore && out.Experiments[i].ID < out.Experiments[bestIdx].ID) {\n                bestIdx = i\n                bestScore = composite[i]\n            }\n        }\n        if bestIdx >= 0 {\n            out.BestExperiment = out.Experiments[bestIdx].ID\n        }\n    } else {\n        bestID := ""\n        for _, exp := range out.Experiments {\n            if bestID == "" || exp.ID < bestID {\n                bestID = exp.ID\n            }\n        }\n        out.BestExperiment = bestID\n    }\n\n    enc := json.NewEncoder(os.Stdout)\n    enc.SetIndent("", "  ")\n    if err := enc.Encode(out); err != nil {\n        fmt.Fprintln(os.Stderr, "error:", err)\n        return 1\n    }\n    return 0\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
