iedSecond, tiedBoth := 0, 0, 0, 0, 0\n\tfor i := 0; i < n; i++ {\n\t\tfor j := i + 1; j < n; j++ {\n\t\t\tda := a[i] - a[j]\n\t\t\tdb := b[i] - b[j]\n\t\t\taTied := da == 0\n\t\t\tbTied := db == 0\n\t\t\tif aTied && bTied {\n\t\t\t\ttiedBoth++\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif aTied {\n\t\t\t\ttiedFirst++\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif bTied {\n\t\t\t\ttiedSecond++\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif (da > 0 && db > 0) || (da < 0 && db < 0) {\n\t\t\t\tconcordant++\n\t\t\t} else {\n\t\t\t\tdiscordant++\n\t\t\t}\n\t\t}\n\t}\n\tdenom := math.Sqrt(float64((concordant + discordant + tiedFirst) * (concordant + discordant + tiedSecond)))\n\tif denom == 0 {\n\t\treturn nil\n\t}\n\ttau := float64(concordant-discordant) / denom\n\treturn &tau\n}\n\nfunc round4(f float64) float64 {\n\tf = math.Round(f*10000) / 10000\n\tif f == 0 {\n\t\tf = 0\n\t}\n\treturn f\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
