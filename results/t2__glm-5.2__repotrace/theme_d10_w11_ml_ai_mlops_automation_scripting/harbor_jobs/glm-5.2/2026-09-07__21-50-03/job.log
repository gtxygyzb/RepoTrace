etedOrSkipped = false\n                        default:\n                                stagePending[stage]++\n                                allCompletedOrSkipped = false\n                        }\n                }\n\n                status := "pending"\n                if !hasAnyState && len(stages) == 0 {\n                        status = "pending"\n                } else if anyFailed {\n                        status = "failed"\n                } else if anyRunning {\n                        status = "running"\n                } else if allCompletedOrSkipped {\n                        status = "completed"\n                } else {\n                        status = "pending"\n                }\n                _ = hasAnyState\n\n                switch status {\n                case "completed":\n                        completedExperiments++\n                        completedCount++\n                        totalDurCompleted += totalDur\n                case "failed":\n                        failedExperiments++\n                case "pending":\n                        pendingExperiments++\n                }\n\n                infos = append(infos, expInfo{id: id, params: params, stages: stages, status: status, totalDur: round1(totalDur)})\n        }\n\n        out := statusOutput{\n                Pipeline:             p.Name,\n                TotalExperiments:     len(expected),\n                CompletedExperiments: completedExperiments,\n                FailedExperiments:    failedExperiments,\n                PendingExperiments:   pendingExperiments,\n                Experiments:           []statusExperiment{},\n                StageSummary:          map[string]stageSummaryEntry{},\n                ParameterBreakdown:    map[string]map[string]paramBreakdownValue{},\n        }\n\n        for _, info := range infos {\n                if filterStatus != "" && info.status != filterStatus {\n                        continue\n                }\n               