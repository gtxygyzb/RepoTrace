g]bool{}\n        for _, param := range p.Parameters {\n                known[param.Name] = true\n        }\n        for k := range params {\n                if !known[k] {\n                        delete(params, k)\n                }\n        }\n        return params\n}\n\nfunc anyExpectedExperimentHasState(p *Pipeline) bool {\n        for _, id := range expectedExperimentIDs(p) {\n                if experimentStateExists(id) {\n                        return true\n                }\n        }\n        return false\n}\n\nfunc stageDurationSeconds(st *StageState) float64 {\n        if st == nil || st.StartTime == "" || st.EndTime == "" {\n                return 0\n        }\n        start, err1 := time.Parse(time.RFC3339, st.StartTime)\n        end, err2 := time.Parse(time.RFC3339, st.EndTime)\n        if err1 != nil || err2 != nil {\n                return 0\n        }\n        if end.Before(start) {\n                return 0\n        }\n        return end.Sub(start).Seconds()\n}\n\nfunc round1(f float64) float64 {\n        return math.Round(f*10) / 10\n}\n\nfunc pipelineStageNames(p *Pipeline) ([]string, error) {\n        groups, err := topologicalGroups(p)\n        if err != nil {\n                return nil, err\n        }\n        names := []string{}\n        seen := map[string]bool{}\n        for _, group := range groups {\n                for _, name := range group {\n                        if !seen[name] {\n                                seen[name] = true\n                                names = append(names, name)\n                        }\n                }\n        }\n        // Fallback to declaration order if topological sort produced nothing.\n        if len(names) == 0 {\n                for _, stage := range p.Stages {\n                        if stage.Name != "" && !seen[stage.Name] {\n                                seen[stage.Name] = true\n                                names = append(names, stage.Name)\n                        }\n                }\n        }\n        return names, nil\n}\n\'\'\'\ns = s.replace(\'func substituteParams(value string, combo map[string]interface{}) string {\', helpers + \'\\nfunc substituteParams(value string, combo map[string]interface{}) string {\')\n\n# 3. Add no-state error to reportPipeline after out initialization / before iterating combos.\ns = s.replace(\n    \'        metricValues := map[string][]float64{}\\n        for _, combo := range parameterCombinations(p) {\\n                id := experimentID(combo)\\n                exp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}\',\n    \'        if !anyExpectedExperimentHasState(p) {\\n                fmt.Fprintln(os.Stderr, "error: no expected experiments have state data")\\n                return 1\\n        }\\n        metricValues := map[string][]float64{}\\n        for _, combo := range parameterCombinations(p) {\\n                id := experimentID(combo)\\n                exp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}\'\n)\n\n# 4. Add no-state error to export after validation before expData type.\ns = s.replace(\n    \'        if errs := validatePipeline(p); len(errs) > 0 {\\n                for _, e := range errs {\\n                        fmt.Fprintln(os.Stderr, e)\\n                }\\n                return 1\\n        }\\n\\n        type expData struct {\\n                ID      string\\n                Params  map[string]string\\n                Metrics map[string]float64\\n        }\',\n    \'        if errs := validatePipeline(p); len(errs) > 0 {\\n                for _, e := range errs {\\n                        fmt.Fprintln(os.Stderr, e)\\n                }\\n                return 1\\n        }\\n        if !anyExpectedExperimentHasState(p) {\\n                fmt.Fprintln(os.Stderr, "error: no expected experiments have state data")\\n                return 1\\n        }\\n\\n        type expData struct {\\n                