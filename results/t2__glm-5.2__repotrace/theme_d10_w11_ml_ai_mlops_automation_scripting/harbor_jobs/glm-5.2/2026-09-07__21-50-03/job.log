Sending keys: ['cat >> main.go <<\'EOF\'\n\nfunc stateDir(experimentID string) string {\n\treturn filepath.Join(".mlpipe", "state", experimentID)\n}\n\nfunc stageStatePath(experimentID, stageName string) string {\n\treturn filepath.Join(stateDir(experimentID), stageName+".json")\n}\n\nfunc experimentStateExists(id string) bool {\n\tinfo, err := os.Stat(stateDir(id))\n\treturn err == nil && info.IsDir()\n}\n\nfunc readStageState(experimentID, stageName string) (*StageState, error) {\n\tdata, err := os.ReadFile(stageStatePath(experimentID, stageName))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar st StageState\n\tif err := json.Unmarshal(data, &st); err != nil {\n\t\treturn nil, err\n\t}\n\treturn &st, nil\n}\n\nfunc writeStageState(experimentID, stageName string, st *StageState) error {\n\tif err := os.MkdirAll(stateDir(experimentID), 0755); err != nil {\n\t\treturn err\n\t}\n\tdata, err := json.MarshalIndent(st, "", "  ")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(stageStatePath(experimentID, stageName), data, 0644)\n}\n\nfunc artifactsIndexPath() string {\n\treturn filepath.Join(".mlpipe", "artifacts", "index.json")\n}\n\nfunc loadArtifactIndex() *ArtifactIndex {\n\tidx := &ArtifactIndex{}\n\tdata, err := os.ReadFile(artifactsIndexPath())\n\tif err != nil {\n\t\treturn idx\n\t}\n\tif err := json.Unmarshal(data, idx); err != nil {\n\t\treturn &ArtifactIndex{}\n\t}\n\treturn idx\n}\n\nfunc saveArtifactIndex(idx *ArtifactIndex) error {\n\tif err := os.MkdirAll(filepath.Dir(artifactsIndexPath()), 0755); err != nil {\n\t\treturn err\n\t}\n\tdata, err := json.MarshalIndent(idx, "", "  ")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(artifactsIndexPath(), data, 0644)\n}\n\nfunc artifactsList() int {\n\tidx := loadArtifactIndex()\n\tenc := json.NewEncoder(os.Stdout)\n\tenc.SetIndent("", "  ")\n\tif err := enc.Encode(idx); err != nil {\n\t\tfmt.Fprintln(os.Stderr, "error:", err)\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc artifactsGC