Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\n\npath = Path("main.go")\ntext = path.read_text()\n\ntext = text.replace(\n    \'fmt.Fprintln(os.Stderr, "Commands: validate, plan, run, report, artifacts, compare")\',\n    \'fmt.Fprintln(os.Stderr, "Commands: validate, plan, run, report, artifacts, compare, sweep")\'\n)\n\ntext = text.replace(\n    \'\\tcase "compare":\\n\\t\\tos.Exit(cmdCompare(args))\',\n    \'\\tcase "compare":\\n\\t\\tos.Exit(cmdCompare(args))\\n\\tcase "sweep":\\n\\t\\tos.Exit(cmdSweep(args))\'\n)\n\nstart = text.index(\'func reportPipeline(p *Pipeline) int {\')\nend = text.index(\'func runExperiment(p *Pipeline, combo map[string]interface{}, resume bool) error {\')\n\nnew = r\'\'\'func reportPipeline(p *Pipeline) int {\n\ttype reportExperiment struct {\n\t\tID      string             `json:"id"`\n\t\tMetrics map[string]float64 `json:"metrics"`\n\t\tStages  []StageState       `json:"stages"`\n\t}\n\ttype reportOutput struct {\n\t\tPipeline      string                       `json:"pipeline"`\n\t\tExperiments   []reportExperiment           `json:"experiments"`\n\t\tMetricSummary map[string]metricSummaryEntry `json:"metric_summary"`\n\t}\n\n\tout := reportOutput{Pipeline: p.Name, Experiments: []reportExperiment{}, MetricSummary: map[string]metricSummaryEntry{}}\n\tmetricValues := map[string][]float64{}\n\tfor _, combo := range parameterCombinations(p) {\n\t\tid := experimentID(combo)\n\t\texp := reportExperiment{ID: id, Metrics: map[string]float64{}, Stages: []StageState{}}\n\t\tfor _, stage := range p.Stages {\n\t\t\tif st, err := readStageState(id, stage.Name); err == nil {\n\t\t\t\texp.Stages = append(exp.Stages, *st)\n\t\t\t\tfor _, m := range st.Metrics {\n\t\t\t\t\texp.Metrics[m.Name] = m.Value\n\t\t\t\t\tmetricValues[m.Name] = append(metricValues[m.Name], m.Value)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tout.Experiments = append(out.Experiments, exp)\n\t}\n\tfor name, values := range metricValues {\n\t\tout.MetricSummary[name] = metricSummaryEntry{\n\t\t\tCount: len(values),\n\t\t\tMean:  round4(meanValue(values)),\n\t\t\tStd:   round4(sampleStd(values)),\n\t\t\tMin:   round4(minValue(values)),\n\t\t\tMax:   round4(maxValue(values)),\n\t\t}\n\t}\n\tenc := json.NewEncoder(os.Stdout)\n\tenc.SetIndent("", "  ")\n\tif err := enc.Encode(out); err != nil {\n\t\tfmt.Fprintln(os.Stderr, "error:", err)\n\t\treturn 1\n\t}\n\treturn 0\n}\n\ntype metricSummaryEntry struct {\n\tCount int     `json:"count"`\n\tMean  float64 `json:"mean"`\n\tStd   float64 `json:"std"`\n\tMin   float64 `json:"min"`\n\tMax   float64 `json:"max"`\n}\n\nfunc cmdSweep(args []string) int {\n\tpipelineFile := ""\n\tmetricName := ""\n\tparamName := ""\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tswitch {\n\t\tcase arg == "--metric":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\tfmt.Fprintln(os.Stderr, "error: --metric requires a value")\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\ti++\n\t\t\tmetricName = args[i]\n\t\tcase strings.HasPrefix(arg, "--metric="):\n\t\t\tmetricName = strings.TrimPrefix(arg, "--metric=")\n\t\tcase arg == "--param":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\tfmt.Fprintln(os.Stderr, "error: --param requires a value")\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\ti++\n\t\t\tparamName = args[i]\n\t\tcase strings.HasPrefix(arg, "--param="):\n\t\t\tparamName = strings.TrimPrefix(arg, "--param=")\n\t\tcase pipelineFile == "":\n\t\t\tpipelineFile = arg\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, "error: unknown argument %q\\n", arg)\n\t\t\treturn 1\n\t\t}\n\t}\n\tif pipelineFile == "" || metricName == "" || paramName == "" {\n\t\tfmt.Fprintln(os.Stderr, "Usage: mlpipe sweep <pipeline.yaml> --metric <name> --param <name>")\n\t\treturn 1\n\t}\n\n\tp, err := loadPipeline(pipelineFile)\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, "error:", err)\n\t\treturn 1\n\t}\n\tif errs := validatePipeline(p); len(errs) > 0 {\n\t\tfor _, e := range errs {\n\t\t\tfmt.Fprintln(os.Stderr, e)\n\t\t}\n\t\treturn 1\n\t}\n\n\tobjective := ""\n\tmetricFound := false\n\tfor _, stage := range p.Stages {\n\t\tfor _, m := range stage.Metrics {\n\t\t\tif m.Name == metricName {\n\t\t\t\tmetricFound = true\n\t\t\t\tif objective == "" {\n\t\t\t\t\tobjective = m.Objective\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif !metricFound {\n\t\tfmt.Fprintf(os.Stderr, "error: metric %q not found in pipeline\\n", metricName)\n\t\treturn 1\n\t}\n\n\tparamFound := false\n\tfor _, param := range p.Parameters {\n\t\tif param.Name == paramName {\n\t\t\t\tparamFound = true\n\t\t\t\tbreak\n\t\t}\n\t}\n\tif !paramFound {\n\t\tfmt.Fprintf(os.Stderr, "error: parameter %q not found in pipeline\\n", paramName)\n\t\treturn 1\n\t}\n\n\treturn sweepPipeline(p, metricName, paramName, objective)\n}\n\nfunc sweepPipeline(p *Pipeline, metricName, paramName, objective string) int {\n\ttype groupOut struct {\n\t\tValue string  `json:"value"`\n\t\tCount int     `json:"count"`\n\t\tMean  float64 `json:"mean"`\n\t\tStd   float64 `json:"std"`\n\t\tMin   float64 `json:"min"`\n\t\tMax   float64 `json:"max"`\n\t}\n\n\tgroupValues := map[string][]float64{}\n\tfor _, combo := range parameterCombinations(p) {\n\t\tid := experimentID(combo)\n\t\tparamValue := asString(combo[paramName])\n\t\tmetrics := map[string]float64{}\n\t\tfor _, stage := range p.Stages {\n\t\t\tif st, err := readStageState(id, stage.Name); err == nil && st.Status == "completed" {\n\t\t\t\tfor _, m := range st.Metrics {\n\t\t\t\t\tmetrics[m.Name] = m.Value\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif val, ok := metrics[metricName]; ok {\n\t\t\tgroupValues[paramValue] = append(groupValues[paramValue], val)\n\t\t}\n\t}\n\n\tif len(groupValues) == 0 {\n\t\tfmt.Fprintf(os.Stderr, "error: metric %q not found in any completed experiment\\n", metricName)\n\t\treturn 1\n\t}\n\n\tvalues := make([]string, 0, len(groupValues))\n\tfor v := range groupValues {\n\t\tvalues = append(values, v)\n\t}\n\tsort.Strings(values)\n\n\tgroups := make([]groupOut, 0, len(values))\n\tgroupMeans := map[string]float64{}\n\tgroupVars := map[string]float64{}\n\ttotalN := 0\n\tgrandSum := 0.0\n\tfor _, v := range values {\n\t\tobs := groupValues[v]\n\t\tn := len(obs)\n\t\ttotalN += n\n\t\tmean := meanValue(obs)\n\t\tvariance := 0.0\n\t\tif n > 1 {\n\t\t\tss := 0.0\n\t\t\tfor _, x := range obs {\n\t\t\t\tdiff := x - mean\n\t\t\t\tss += diff * diff\n\t\t\t}\n\t\t\tvariance = ss / float64(n-1)\n\t\t}\n\t\tgroupMeans[v] = mean\n\t\tgroupVars[v] = variance\n\t\tgrandSum += mean * float64(n)\n\t\tgroups = append(groups, groupOut{\n\t\t\tValue: v,\n\t\t\tCount: n,\n\t\t\tMean:  round4(mean),\n\t\t\tStd:   round4(math.Sqrt(variance)),\n\t\t\tMin:   round4(minValue(obs)),\n\t\t\tMax:   round4(maxValue(obs)),\n\t\t})\n\t}\n\n\tgrandMean := 0.0\n\tif totalN > 0 {\n\t\tgrandMean = grandSum / float64(totalN)\n\t}\n\n\tk := len(values)\n\tbetweenVariance := 0.0\n\twithinVariance := 0.0\n\tif k > 1 && totalN > k {\n\t\tfor _, v := range values {\n\t\t\tn := len(groupValues[v])\n\t\t\tdiff := groupMeans[v] - grandMean\n\t\t\tbetweenVariance += float64(n) * diff * diff\n\t\t\twithinVariance += float64(n-1) * groupVars[v]\n\t\t}\n\t\tbetweenVariance /= float64(k - 1)\n\t\twithinVariance /= float64(totalN - k)\n\t}\n\n\tvar anovaF *float64\n\tif k > 1 && totalN > k && withinVariance > 0 {\n\t\tf := betweenVariance / withinVariance\n\t\tf = round4(f)\n\t\tanovaF = &f\n\t}\n\n\tvar effectSize *float64\n\tpooledStd := math.Sqrt(withinVariance)\n\tif k > 1 && totalN > k && pooledStd > 0 {\n\t\tmaxMean := groupMeans[values[0]]\n\t\tminMean := groupMeans[values[0]]\n\t\tfor _, v := range values {\n\t\t\tif groupMeans[v] > maxMean {\n\t\t\t\tmaxMean = groupMeans[v]\n\t\t\t}\n\t\t\tif groupMeans[v] < minMean {\n\t\t\t\tminMean = groupMeans[v]\n\t\t\t}\n\t\t}\n\t\tes := round4((maxMean - minMean) / pooledStd)\n\t\teffectSize = &es\n\t}\n\n\tbestValue := ""\n\tbestMean := 0.0\n\tfor _, v := range values {\n\t\tmean := groupMeans[v]\n\t\tif bestValue == "" {\n\t\t\tbestValue = v\n\t\t\tbestMean = mean\n\t\t\tcontinue\n\t\t}\n\t\tif objective == "minimize" {\n\t\t\tif mean < bestMean {\n\t\t\t\tbestValue = v\n\t\t\t\tbestMean = mean\n\t\t\t}\n\t\t} else {\n\t\t\tif mean > bestMean {\n\t\t\t\tbestValue = v\n\t\t\t\tbestMean = mean\n\t\t\t}\n\t\t}\n\t}\n\n\tout := struct {\n\t\tParameter  string    `json:"parameter"`\n\t\tMetric     string    `json:"metric"`\n\t\tObjective  string    `json:"objective"`\n\t\tGroups     []groupOut `json:"groups"`\n\t\tAnovaF     *float64  `json:"anova_f"`\n\t\tBestValue  string    `json:"best_value"`\n\t\tEffectSize *float64  `json:"effect_size"`\n\t}{\n\t\tParameter:  paramName,\n\t\tMetric:     metricName,\n\t\tObjective:  objective,\n\t\tGroups:     groups,\n\t\tAnovaF:     anovaF,\n\t\tBestValue:  bestValue,\n\t\tEffectSize: effectSize,\n\t}\n\n\tenc := json.NewEncoder(os.Stdout)\n\tenc.SetIndent("", "  ")\n\tif err := enc.Encode(out); err != nil {\n\t\tfmt.Fprintln(os.Stderr, "error:", err)\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc meanValue(values []float64) float64 {\n\tif len(values) == 0 {\n\t\treturn 0\n\t}\n\tsum := 0.0\n\tfor _, v := range values {\n\t\tsum += v\n\t}\n\treturn sum / float64(len(values))\n}\n\nfunc sampleStd(values []float64) float64 {\n\tn := len(values)\n\tif n <= 1 {\n\t\treturn 0.0\n\t}\n\tmean := meanValue(values)\n\tss := 0.0\n\tfor _, v := range values {\n\t\tdiff := v - mean\n\t\tss += diff * diff\n\t}\n\treturn math.Sqrt(ss / float64(n-1))\n}\n\nfunc minValue(values []float64) float64 {\n\tif len(values) == 0 {\n\t\treturn 0\n\t}\n\tm := values[0]\n\tfor _, v := range values {\n\t\tif v < m {\n\t\t\tm = v\n\t\t}\n\t}\n\treturn m\n}\n\nfunc maxValue(values []float64) float64 {\n\tif len(values) == 0 {\n\t\treturn 0\n\t}\n\tm := values[0]\n\tfor _, v := range values {\n\t\tif v > m {\n\t\t\tm = v\n\t\t}\n\t}\n\treturn m\n}\n\nfunc round4(x float64) float64 {\n\treturn math.Round(x*10000) / 10000\n}\n\n\'\'\'\n\ntext = text[:start] + new + text[end:]\npath.write_text(text)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
