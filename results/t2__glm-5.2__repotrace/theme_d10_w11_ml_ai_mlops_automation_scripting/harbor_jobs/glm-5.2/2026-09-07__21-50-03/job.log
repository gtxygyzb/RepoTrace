end(paramNames, param.Name)\n        }\n        sort.Strings(paramNames)\n        for _, name := range paramNames {\n                out.ParameterBreakdown[name] = map[string]paramBreakdownValue{}\n        }\n        for _, info := range infos {\n                for _, name := range paramNames {\n                        val := info.params[name]\n                        if _, ok := out.ParameterBreakdown[name]; !ok {\n                                out.ParameterBreakdown[name] = map[string]paramBreakdownValue{}\n                        }\n                        entry := out.ParameterBreakdown[name][val]\n                        switch info.status {\n                        case "completed":\n                                entry.Completed++\n                        case "failed":\n                                entry.Failed++\n                        case "pending":\n                                entry.Pending++\n                        }\n                        out.ParameterBreakdown[name][val] = entry\n                }\n        }\n        // Sort parameter values alphabetically by using sorted keys and rebuilding maps.\n        for name, vals := range out.ParameterBreakdown {\n                keys := make([]string, 0, len(vals))\n                for k := range vals {\n                        keys = append(keys, k)\n                }\n                sort.Strings(keys)\n                sortedVals := map[string]paramBreakdownValue{}\n                for _, k := range keys {\n                        sortedVals[k] = vals[k]\n                }\n                out.ParameterBreakdown[name] = sortedVals\n        }\n\n        // Health\n        completionRate := 0.0\n        failureRate := 0.0\n        if len(expected) > 0 {\n                completionRate = float64(completedExperiments) / float64(len(expected))\n                failureRate = float64(failedExperiments) / float64(len(expected))\n        }\n        var mostFailed *string\n        maxFail := -1\n        for _, stage := range stageNames {\n                cnt := stageFailCounts[stage]\n                if cnt > 0 && cnt > maxFail {\n                        maxFail = cnt\n                        name := stage\n                        mostFailed = &name\n                }\n        }\n        var slowest *string\n        maxMean := -1.0\n        for _, stage := range stageNames {\n                mean := 0.0\n                if len(stageDurations[stage]) > 0 {\n                        mean = meanValue(stageDurations[stage])\n                }\n                if len(stageDurations[stage]) > 0 && mean > maxMean {\n                        maxMean = mean\n                        name := stage\n                        slowest = &name\n                }\n        }\n        estimatedRemaining := 0.0\n        if pendingExperiments > 0 && completedCount > 0 {\n                estimatedRemaining = (totalDurCompleted / float64(completedCount)) * float64(pendingExperiments)\n        }\n        out.Health = statusHealth{\n                CompletionRate:             round4(completionRate),\n                FailureRate:                round4(failureRate),\n                MostFailedStage:            mostFailed,\n                SlowestStage:               slowest,\n                EstimatedRemainingSeconds: round1(estimatedRemaining),\n        }\n\n        enc := json.NewEncoder(os.Stdout)\n        enc.SetIndent("", "  ")\n        if err := enc.Encode(out); err != nil {\n                fmt.Fprintln(os.Stderr, "error:", err)\n                return 1\n        }\n        return 0\n}\n\nfunc countCompletedStages(stages []statusStage) int {\n        n := 0\n        for _, s := range stages {\n                if s.Status == "completed" {\n                        n++\n                }\n        }\n        return n\n}\n\'\'\'\ns = s.replace(\'func cmdExport(args []string) int {\', status_code + \'\\nfunc cmdExport(args []string) int {\')\n\n# Ensure time import is present\nif \'"time"\' 