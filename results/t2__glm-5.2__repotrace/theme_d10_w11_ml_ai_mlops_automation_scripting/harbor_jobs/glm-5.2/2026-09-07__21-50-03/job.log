Sending keys: ["python3 - <<'PY'\nimport json, glob, os, subprocess, statistics\n\npipeline_file = 'pipelines/text_sentiment.yaml'\nreport = json.loads(subprocess.check_output(['./mlpipe', 'report', pipeline_file]))\n\n# Parse simple YAML for metrics/objectives.\nimport re\nmetrics = {}\nstage = None\nwith open(pipeline_file) as f:\n    for line in f:\n        m = re.match(r'\\s*- name: (.+)', line)\n        if m and not line.startswith(' ' * 6):\n            stage = m.group(1)\n        m2 = re.match(r'\\s+- name: (.+)', line)\n        m3 = re.match(r'\\s+objective: (.+)', line)\n        if m2:\n            cur_metric = m2.group(1)\n        if m3 and cur_metric:\n            metrics[cur_metric] = m3.group(1)\n\nobj = {k:v for k,v in metrics.items() if v in ('minimize','maximize')}\nstates = {}\nfor path in glob.glob('.mlpipe/state/*/train.json') + glob.glob('.mlpipe/state/*/evaluate.json') + glob.glob('.mlpipe/state/*/preprocess.json'):\n    exp = os.path.basename(os.path.dirname(path))\n    st = json.load(open(path))\n    states.setdefault(exp, {})\n    for m in st.get('metrics', []):\n        states[exp][m['name']] = m['value']\n\nexps = sorted(states)\nminv = {m:min(states[e][m] for e in exps if m in states[e]) for m in obj}\nmaxv = {m:max(states[e][m] for e in exps if m in states[e]) for m in obj}\nnorm = {}\nfor e in exps:\n    norm[e] = {}\n    for m in obj:\n        v = states[e][m]\n        rng = maxv[m] - minv[m]\n        n = 0.5 if rng == 0 else (v-minv[m])/rng if obj[m]=='maximize' else (maxv[m]-v)/rng\n        norm[e][m] = round(n, 4)\ncomp = {e: round(sum(norm[e][m] for m in obj)/len(obj), 4) for e in exps}\nimp = {m: round(statistics.stdev([norm[e][m] for e in exps]) if len(exps) > 1 else 0, 4) for m in obj}\nsens = {}\nfor m in obj:\n    if len(obj) == 1:\n        sens[m] = {'best_without': exps[0], 'max_composite': 0}\n    else:\n        scores = {}\n        for e in exps:\n            vals = [norm[e][mm] for mm in obj if mm != m]\n            scores[e] = round(sum(vals)/len(vals), 4)\n        best = sorted(scores.items(), key=lambda kv: (-kv[1], kv[0]))[0]\n        sens[m] = {'best_without': best[0], 'max_composite': best[1]}\n\nfor key, expected in [('composite_scores', comp), ('normalized_metrics', norm), ('metric_importance', imp), ('score_sensitivity', sens)]:\n    assert report[key] == expected, (key, report[key], expected)\nassert report['best_experiment'] == max(comp.items(), key=lambda kv: (kv[1], -ord(kv[0][3]) if False else 0))[0]\nprint('verification passed')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
