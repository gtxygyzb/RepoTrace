[2911.417043, "o", "if err := json.Unmarshal(data, &top); err != nil || top == nil {\r\n    47\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"top-level JSON must be an object\"}\r\n    48\t\t}\r\n    49\t\r\n    50\t\trawJobs, ok := top[\"jobs\"]\r\n    51\t\tif !ok {\r\n    52\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"missing jobs\"}\r\n    53\t\t}\r\n    54\t\r\n    55\t\tvar jobsRaw []json.RawMessage\r\n    56\t\tif err := json.Unmarshal(rawJobs, &jobsRaw); err != nil || jobsRaw == nil {\r\n    57\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"jobs must be an array\"}\r\n"]
