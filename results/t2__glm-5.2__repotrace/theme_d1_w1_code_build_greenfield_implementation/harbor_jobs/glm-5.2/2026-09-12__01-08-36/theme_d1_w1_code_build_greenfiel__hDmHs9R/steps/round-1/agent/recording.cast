[2871.470275, "o", "   102\t\r\n   103\t\tpath := findCyclePath(start, adj, inStartSCC)\r\n   104\t\treturn &ValidationError{Code: \"cycle\", Message: path}\r\n   105\t}\r\n   106\t\r\n   107\tfunc findCyclePath(start string, adj map[string][]string, inSCC map[string]bool) string {\r\n   108\t\tpath := []string{start}\r\n"]
[2871.470343, "o", "   109\t\tvisited := map[string]bool{}\r\n   110\t\r\n   111\t\tvar dfs func() bool\r\n   112\t\tdfs = func() bool {\r\n   113\t\t\tcur := path[len(path)-1]\r\n   114\t\t\tfor _, next := range adj[cur] {\r\n   115\t\t\t\tif !inSCC[next] {\r\n   116\t\t\t\t\tcontinue\r\n   117\t\t\t\t}\r\n   118\t\t\t\tif next == start {\r\n"]
[2871.470398, "o", "   119\t\t\t\t\tpath = append(path, start)\r\n   120\t\t\t\t\treturn true\r\n   121\t\t\t\t}\r\n   122\t\t\t\tif visited[next] {\r\n   123\t\t\t\t\tcontinue\r\n"]
[2871.47045, "o", "   124\t\t\t\t}\r\n   125\t\t\t\tvisited[next] = true\r\n   126"]
[2871.470506, "o", "\t\t\t\tpath = append(path, next)\r\n   127\t\t\t\tif dfs() {\r\n   128\t\t\t\t\treturn true\r\n   129\t\t\t\t}\r\n   130\t\t\t\tpath = path[:len(path)-1]\r\n   131\t\t\t\tdelete(visited, next)\r\n   132\t\t\t}\r\n   133\t\t\treturn false\r\n   134\t\t}\r\n   135\t\r\n   136\t\tif dfs() {\r\n   137\t\t\treturn strings.Join(path, \" -> \")\r\n"]
[2871.470561, "o", "   138\t\t}\r\n   139\t\treturn start\r\n   140\t}\r\n"]
