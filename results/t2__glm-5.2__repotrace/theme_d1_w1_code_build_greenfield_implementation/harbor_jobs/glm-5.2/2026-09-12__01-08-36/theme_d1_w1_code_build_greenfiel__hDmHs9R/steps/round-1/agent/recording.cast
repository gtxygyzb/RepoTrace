[2912.015968, "o", "\t\t\t}\r\n   118\t\t\t\tif next == start {\r\n   119\t\t\t\t\tpath = append(path, start)\r\n   120\t\t\t\t\treturn true\r\n   121\t\t\t\t}\r\n   122\t\t\t\tif visited[next] {\r\n   123\t\t\t\t\tcontinue\r\n   124\t\t\t\t}\r\n   125\t\t\t\tvisited[next] = true\r\n   126\t\t\t\tpath = append(path, next)\r\n   127\t\t\t\tif dfs() {\r\n   128\t\t\t\t\treturn true\r\n   129\t\t\t\t}\r\n   130\t\t\t\tpath = path[:len(path)-1]\r\n"]
