[8599.073, "o", "nl -ba cmd/jobforge/ancestors.go | sed -n '1,120p'\r\n\u001b[?2004l\r"]
[8599.076894, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n"]
[8599.07705, "o", "     5\t\t\"flag\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"strings\"\r\n     9\t)\r\n    10\t\r\n    11\tfunc runAncestors(args []string) int {\r\n    12\t\tfs := flag.NewFlagSet(\"ancestors\", flag.ContinueOnError)\r\n    13\t\tfs.SetOutput(os.Stderr)\r\n    14\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    15\t\tjobName := fs.String(\"job\", \"\", \"target job\")\r\n    16\t\tformat := fs.String(\"format\", \"text\", \"output format: text|json\")\r\n    17\t\tif err := fs.Parse(args); err != nil {\r\n    18\t\t\treturn 2\r\n    19\t\t}\r\n"]
[8599.077132, "o", "    20\t\r\n    21\t\tif *format != \"text\" && *format != \"json\" {\r\n    22\t\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n    23\t\t\treturn 2\r\n    24\t\t}\r\n    25\t\tif *specPath == \"\" {\r\n    26\t\t\tfmt.Fprintln(os.Stderr, \"error: --spec required\")\r\n    27\t\t\treturn 2\r\n    28\t\t}\r\n    29\t\tif *jobName == \"\" {\r\n    30\t\t\tfmt.Fprintln(os.Stderr, \"error: --job required\")\r\n    31\t"]
[8599.077186, "o", "\t\treturn 2\r\n    32\t\t}\r\n    33\t\tif len(fs.Args()) != 0 {\r\n    34\t\t\tfmt.Fprintln(os.Stderr, \"error: unexpected arguments\")\r\n    35\t\t\treturn 2\r\n    36\t\t}\r\n    37\t\r\n    38\t\tspec, err := loadSpec(*specPath)\r\n"]
[8599.077223, "o", "    39\t\tif err != nil {\r\n    40\t\t\tprintValidationError(err)\r\n    41\t\t\treturn 2\r\n    42\t\t}\r\n"]
[8599.077257, "o", "    43\t\r\n    44\t\ttarget, ok := spec.ByName[*jobName]\r\n    45\t\tif !ok {\r\n    46\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown_job: %s\\n\", *jobName)\r\n    47\t\t"]
[8599.07729, "o", "\treturn 2\r\n    48\t\t}\r\n    49\t\r\n    50\t\tancestorSet := computeAncestorSet(spec, target)\r\n    51\t\r\n    52\t\tlevels := computeLevels(spec)\r\n"]
[8599.077322, "o", "    53\t\tordered := make([]string, 0, len(ancestorSet))\r\n    54\t\t"]
[8599.07734, "o", "for _, names := range levels {\r\n    55\t\t\tfor _, name := range names {\r\n    56\t\t\t\tif ancestorSet[name] {\r\n    57\t\t\t\t\tordered = append(ordered, name)\r\n    58\t\t\t\t}\r\n"]
[8599.077379, "o", "    59\t\t\t}\r\n    60\t\t}\r\n    61\t\r\n    62\t\tswitch *format {\r\n    63"]
[8599.07741, "o", "\t\tcase \"text\":\r\n    64\t\t\tif len(ordered) > 0 {\r\n    65\t\t\t\tos.Stdout.WriteString(strings.Join(ordered, \"\\n\") + \"\\n\")\r\n    66\t\t\t}\r\n"]
[8599.077439, "o", "    67\t\tcase \"json\":\r\n    68\t\t\tout, err := json.Marshal(ordered)\r\n    69\t\t\tif err != nil {\r\n"]
[8599.07747, "o", "    70\t\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n    71\t\t\t\treturn 2\r\n    72\t\t\t}\r\n    73\t\t\tos.Stdout.Write(out)\r\n    74\t\t\tfmt.Println()\r\n    75\t\t}\r\n    76\t"]
[8599.077499, "o", "\r\n    77\t\treturn 0\r\n    78\t}\r\n    79\t\r\n"]
[8599.07753, "o", "    80\tfunc computeAncestorSet(spec *Spec, target *Job) map[string]bool {\r\n    81\t\tancestors := map[string]bool{}\r\n    82\t\tvar visit func(job *Job)\r\n    83\t\tvisit = func(job *Job) {\r\n    84\t\t\tfor _, dep := range job.Deps {\r\n"]
[8599.077564, "o", "    85\t\t\t\tif !ancestors[dep] {\r\n    86\t\t\t\t\tancestors[dep] = true\r\n    87"]
[8599.077594, "o", "\t\t\t\t\tvisit(spec.ByName[dep])\r\n    88\t\t\t\t}\r\n    89\t\t\t}\r\n    90\t\t}\r\n    91\t\tvisit(target)\r\n    92\t\treturn ancestors\r\n"]
[8599.077624, "o", "    93\t}\r\n"]
