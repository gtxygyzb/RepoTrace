[4741.119149, "o", "\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K, err := loadSpec(*\u001b[01;31m\u001b[Kspec\u001b[m\u001b[KPath)\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tselected, err := parseOnlyFilter(\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K, *\u001b[01;31m\u001b[Konly\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tjobs, levels := listJobs(\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K, selected)\r\n\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tswitch *\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tos.Stdout.Write(renderListJSON(*\u001b[01;31m\u001b[Kspec\u001b[m\u001b[KPath, jobs, levels))\r\n\u001b[32m\u001b[K174\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc parseOnlyFilter(\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K *Spec, \u001b[01;31m\u001b[Konly\u001b[m\u001b[K string) (map[string]bool, error) {\r\n\u001b[32m\u001b[K175\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif \u001b[01;31m\u001b[Konly\u001b[m\u001b[K == \"\" {\r\n"]
