[5192.216029, "o", "\t\"regexp\"\r\n\t\"sort\"\r\n)\r\n\r\ntype Job struct {\r\n\tIndex   int\r\n\tName    string\r\n\tCommand string\r\n\tDeps    []string\r\n\tWorkdir string\r\n"]
