[2943.9251, "o", "\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> \u001b[01;31m\u001b[K--spec\u001b[m\u001b[K <path> [flags]\")\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"plan\":\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"run\":\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"validate\":\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"list\":\r\n"]
[2943.925195, "o", "\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> \u001b[01;31m\u001b[K--spec\u001b[m\u001b[K <path> [flags]\")\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunPlan(args []string) int {\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan \u001b[01;31m\u001b[K--spec\u001b[m\u001b[K <path> [\u001b[01;31m\u001b[K--format\u001b[m\u001b[K json|text]\")\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"text\":\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"json\":\r\n"]
[2943.925269, "o", "\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunRun(args []string) int {\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run \u001b[01;31m\u001b[K--spec\u001b[m\u001b[K <path> [--on-failure stop|continue] [--results <path>]\")\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunValidate(args []string) int {\r\n"]
[2943.92533, "o", "\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"error: missing \u001b[01;31m\u001b[K--spec\u001b[m\u001b[K\")\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrunList(args []string) int {\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"error: missing \u001b[01;31m\u001b[K--spec\u001b[m\u001b[K\")\r\n"]
[2943.925387, "o", "\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"error: bad \u001b[01;31m\u001b[K--format\u001b[m\u001b[K\")\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"text\":\r\n"]
[2943.925447, "o", "\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K166\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"json\":\r\n\u001b[35m\u001b[Kcmd/jobforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KparseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {\r\n"]
