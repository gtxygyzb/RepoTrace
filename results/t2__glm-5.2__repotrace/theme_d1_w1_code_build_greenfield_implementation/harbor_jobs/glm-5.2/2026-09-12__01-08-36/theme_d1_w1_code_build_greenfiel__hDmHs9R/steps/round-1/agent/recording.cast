[2092.74924, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\""]
[2092.749269, "o", "\r\n\t\"os\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc main() {\r\n\t"]
[2092.749431, "o", "if len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run> --spec <path> [flags]\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n"]
[2092.749523, "o", "\tcase \"plan\":\r\n\t\tos.Exit(runPlan(os.Args[2:]))\r\n\tcase \"run\":\r\n\t\tos.Exit(runRun(os.Args[2:]))\r\n\tdefault:\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run> --spec <path> [flags]\")\r\n\t\tos.Exit(2)\r\n\t}\r\n}\r\n\r\nfunc runPlan(args []string) int {\r\n\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n\t\treturn 2\r\n\t}\r\n\tif *format != \"text\" && *format != \"json\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tlevels := computeLevels(spec)\r\n\tswitch *format {\r\n\tcase \"text\":\r\n\t\tfor i, names := range levels {\r\n\t\t\tfmt.Printf(\"level %d: %s\\n\", i, strings.Join(names, \", \"))\r\n"]
[2092.749632, "o", "\t\t}\r\n\tcase \"json\":\r\n\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tos.Stdout.Write(out)\r\n\t\tfmt.Println()\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc runRun(args []string) int {\r\n\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tonFailure := fs.String(\"on-failure\", \"stop\", \"on failure behavior: stop|continue\")\r\n"]
[2092.749731, "o", "\tresultsPath := fs.String(\"results\", \"\", \"path to results JSON file\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]\")\r\n\t\treturn 2\r\n"]
[2092.74982, "o", "\t}\r\n\tif *onFailure != \"stop\" && *onFailure != \"continue\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid on-failure: %s\\n\", *onFailure)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\treturn runSpec(spec, *onFailure, *resultsPath)\r\n}\r\n\r\nfunc printValidationError(err error) {\r\n"]
[2092.749903, "o", "\tif ve, ok := err.(*ValidationError); ok {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s: %s\\n\", ve.Code, ve.Message)\r\n\t\treturn\r\n\t}\r\n\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n}\r\n"]
[2092.750319, "o", "\u001b[?2004h"]
[2092.75039, "o", "root@n30009:/app# "]
