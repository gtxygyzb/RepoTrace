[5112.588707, "o", "   138\t\t}\r\n   139\t\r\n   140\t\tfor _, job := range jobs {\r\n   141\t\t\tif _, ok := jobMaps[job.Index][\"name\"]; !ok {\r\n   142\t\t\t\treturn nil, &ValidationError{Code: \"invalid_name\", Message: \"invalid name: <missing>\"}\r\n   143\t\t\t}\r\n   144\t\t\tif !nameRegexp.MatchString(job.Name) {\r\n   145\t\t\t\treturn nil, &ValidationError{Code: \"invalid_name\", Message: \"invalid name: \" + job.Name}\r\n   146\t\t\t}\r\n   147\t\t}\r\n   148\t\r\n   149\t\tseen := map[string]bool{}\r\n   150\t\tfor _, job := range jobs {\r\n   151\t\t\tif seen[job.Name] {\r\n   152\t\t\t\treturn nil, &ValidationError{Code: \"duplicate_name\", Message: \"duplicate name: \" + job.Name}\r\n   153\t\t\t}\r\n   154\t\t\tseen[job.Name] = true\r\n   155"]
