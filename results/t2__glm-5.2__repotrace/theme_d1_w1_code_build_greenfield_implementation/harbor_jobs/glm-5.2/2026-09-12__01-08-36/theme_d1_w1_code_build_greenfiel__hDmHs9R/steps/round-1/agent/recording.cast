[9104.616215, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('cmd/jobforge/impact.go')\ns = p.read_text()\nold = '''func computeDescendantSet(spec *Spec, target *Job) map[string]bool {\n\\tdescendants := map[string]bool{}\n\\tvar visit func(job *Job)\n\\tvisit = func(job *Job) {\n\\t\\tfor _, dependent := range spec.Dependents[job.Name] {\n\\t\\t\\tif !descendants[dependent] {\n\\t\\t\\t\\tdescendants[dependent] = true\n\\t\\t\\t\\tvisit(spec.ByName[dependent])\n\\t\\t\\t}\n\\t\\t}\n\\t}\n\\tvisit(target)\n\\treturn descendants\n}\n'''\nnew = '''func computeDescendantSet(spec *Spec, target *Job) map[string]bool {\n\\tdependents := map[string][]string{}\n\\tfor _, job := range spec.Jobs {\n\\t\\tfor _, dep := range job.Deps {\n\\t\\t\\tdependents[dep] = append(dependents[dep], job.Name)\n\\t\\t}\n\\t}\n\n\\tdescendants := map[string]bool{}\n\\tvar visit func(name string)\n\\tvisit = func(name string) {\n\\t\\tfor _, dependent := range dependents[name] {\n\\t\\t\\tif !descendants[dependent] {\n\\t\\t\\t\\tdescendants[dependent] = true\n\\t\\t\\t\\tvisit(dependent)\n\\t\\t\\t}\n\\t\\t}\n\\t}\n\\tvisit(target.Nam"]
[9104.616547, "i", "e)\n\\treturn descendants\n}\n'''\nif old not in s:\n    raise SystemExit('old computeDescendantSet block not found')\np.write_text(s.replace(old, new))\nPY\n"]
