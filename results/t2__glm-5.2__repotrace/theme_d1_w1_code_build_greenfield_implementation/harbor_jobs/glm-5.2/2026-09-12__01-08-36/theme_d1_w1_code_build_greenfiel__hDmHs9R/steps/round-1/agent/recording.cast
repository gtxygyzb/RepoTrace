[6797.925933, "i", "sed -n '1,220p' cmd/jobforge/schedule.go\n"]
[6797.926289, "o", "sed -n '1,220p' cmd/jobforge/schedule.go\r\n\u001b[?2004l\r"]
[6797.929578, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[6797.929679, "o", "\t\"strconv\"\r\n)\r\n\r\ntype scheduleAssignment struct {\r\n\tName   string `json:\"name\"`\r\n\tWorker int    `json:\"worker\"`\r\n\tStart  int    `json:\"start\"`\r\n\tEnd    int    `json:\"end\"`\r\n}\r\n\r\nfunc runSchedule(args []string) int {\r\n\tfs := flag.NewFlagSet(\"schedule\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tworkersStr := fs.String(\"workers\", \"\", \"number of worker lanes\")\r\n\tformat := fs.String(\"format\", \"text\", \"output format: text|json\")\r\n\r\n\t"]
[6797.929723, "o", "if err := fs.Parse(args); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\r\n\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n\t"]
[6797.92989, "o", "\treturn 2\r\n\t}\r\n\r\n\tif *workersStr == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --workers required\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tworkers, ok := parseWorkers(*workersStr)\r\n\tif !ok {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --workers\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tif *format != \"text\" && *format != \"json\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tif len(fs.Args()) > 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n"]
[6797.929958, "o", "\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tassignments, makespan := computeSchedule(spec, workers)\r\n"]
[6797.93002, "o", "\tswitch *format {\r\n\tcase \"text\":\r\n\t\tos.Stdout.Write(renderScheduleText(makespan, assignments))\r\n\tcase \"json\":\r\n\t\tos.Stdout.Write(renderScheduleJSON(workers, makespan, assignments))\r\n\t}\r\n\treturn 0"]
[6797.930079, "o", "\r\n}\r\n\r\nfunc parseWorkers(s string) (int, bool) {\r\n\tif s == \"\" || s[0] < '1' || s[0] > '9' {\r\n\t\treturn 0, false\r\n\t}\r\n"]
[6797.930143, "o", "\tfor i := 1; i < len(s); i++ {\r\n\t\tif s[i] < '0' || s[i] > '9' {\r\n\t\t\treturn 0, false\r\n\t\t}\r\n\t}\r\n\r\n\tn := 0\r\n"]
[6797.930206, "o", "\tfor i := 0; i < len(s); i++ {\r\n\t\tn = n*10 + int(s[i]-'0')\r\n\t}\r\n\treturn n, true\r\n}\r\n\r\nfunc computeSchedule(spec *Spec, workers int) ([]scheduleAssignment, int) {\r\n\tlevels := computeLevels(spec)\r\n\tbusyUntil := make([]int, workers)\r\n"]
[6797.930265, "o", "\tendTime := make(map[string]int, len(spec.Jobs))\r\n\r\n\tassignments := make([]scheduleAssignment, 0, len(spec.Jobs))\r\n\tmakespan := 0\r\n\r\n\tfor _, names := range levels {\r\n\t\tfor _, name := range names {\r\n"]
[6797.930352, "o", "\t\t\tjob := spec.ByName[name]\r\n\r\n\t\t\tearliest := 0\r\n\t\t\tfor _, dep := range job.Deps {\r\n\t\t\t\tif end := endTime[dep]; end > earliest {\r\n\t\t\t\t\tearliest = end\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\tworker := -1\r\n\t\t\tfor w := 0; w < workers; w++ {\r\n"]
[6797.930412, "o", "\t\t\t\tif busyUntil[w] <= earliest {\r\n\t\t\t\t\tworker = w\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t\tif worker == -1 || busyUntil[w] < busyUntil[worker] {\r\n\t\t\t\t\tworker = w\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif worker == -1 {\r\n\t\t\t\tworker = 0\r\n"]
[6797.930471, "o", "\t\t\t}\r\n\t\t\tif busyUntil[worker] > earliest {\r\n\t\t\t\tearliest = busyUntil[worker]\r\n\t\t\t}\r\n\r\n\t\t\tstart := earliest\r\n\t\t\tend := start + 1\r\n"]
[6797.930533, "o", "\t\t\tbusyUntil[worker] = end\r\n\t\t\tendTime[name] = end\r\n\r\n\t\t\tassignments = append(assignments, scheduleAssignment{\r\n\t\t\t\tName:   name,\r\n\t\t\t\tWorker: worker,\r\n\t\t\t\tStart:  start,\r\n"]
[6797.930588, "o", "\t\t\t\tEnd:    end,\r\n\t\t\t})\r\n\r\n\t\t\tif end > makespan {\r\n\t\t\t\tmakespan = end\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[6797.93066, "o", "\r\n\treturn assignments, makespan\r\n}\r\n\r\nfunc renderScheduleText(makespan int, assignments []scheduleAssignment) []byte {\r\n\tvar b bytes.Buffer\r\n\tb.WriteString(\"makespan=\")\r\n\tb.WriteString(strconv.Itoa(makespan))\r\n\tb.WriteByte('\\n')\r\n\t"]
[6797.930725, "o", "for _, a := range assignments {\r\n\t\tb.WriteString(a.Name)\r\n\t\tb.WriteString(\"\\tworker=\")\r\n\t\tb.WriteString(strconv.Itoa(a.Worker))\r\n\t\tb.WriteString(\"\\tstart=\")\r\n\t\tb.WriteString(strconv.Itoa(a.Start))\r\n"]
[6797.930782, "o", "\t\tb.WriteString(\"\\tend=\")\r\n\t\tb.WriteString(strconv.Itoa(a.End))\r\n\t\tb.WriteByte('\\n')\r\n\t}\r\n\treturn b.Bytes()\r\n}\r\n\r\n"]
[6797.930866, "o", "func renderScheduleJSON(workers, makespan int, assignments []scheduleAssignment) []byte {\r\n\tvar b bytes.Buffer\r\n\tb.WriteString(`{\"workers\":`)\r\n\tb.WriteString(strconv.Itoa(workers))\r\n\tb.WriteString(`,\"makespan\":`)\r\n\tb.WriteString(strconv.Itoa(makespan))\r\n\tb.WriteString(`,\"assignments\":[`)\r\n\tfor i, a := range assignments {\r\n\t\tif i > 0 {\r\n"]
[6797.930932, "o", "\t\t\tb.WriteByte(',')\r\n\t\t}\r\n\t\tb.WriteString(`{\"name\":\"`)\r\n\t\twriteJSONString(&b, a.Name)\r\n\t\tb.WriteString(`\",\"worker\":`)\r\n\t\tb.WriteString(strconv.Itoa(a.Worker))\r\n\t\tb.WriteString(`,\"start\":`)\r\n"]
[6797.930987, "o", "\t\tb.WriteString(strconv.Itoa(a.Start))\r\n\t\tb.WriteString(`,\"end\":`)\r\n\t\tb.WriteString(strconv.Itoa(a.End))\r\n\t\tb.WriteByte('}')\r\n\t}\r\n\tb.WriteString(`]}`)\r\n\t"]
[6797.931047, "o", "b.WriteByte('\\n')\r\n\treturn b.Bytes()\r\n}\r\n"]
