[5112.588973, "o", "   179\t\tspec := &Spec{Jobs: jobs, ByName: map[string]*Job{}}\r\n   180\t\tfor _, job := range jobs {\r\n   181\t\t\tspec.ByName[job.Name] = job\r\n   182\t\t}\r\n   183\t\r\n   184\t\tfor _, job := range jobs {\r\n   185\t\t\tfor _, dep := range job.Deps {\r\n"]
