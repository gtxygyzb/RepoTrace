[6884.695064, "o", "func writeDepsJSON(b *bytes.Buffer, deps []string) {\r\n\tb.WriteByte('[')\r\n\tfor i, dep := range deps {\r\n\t\tif i > 0 {\r\n\t\t\tb.WriteByte(',')\r\n\t\t}\r\n\t\tb.WriteByte('\"')\r\n\t\twriteJSONString(b, dep)\r\n\t\tb.WriteByte('\"')\r\n\t}\r\n\tb.WriteByte(']')\r\n"]
[6884.695198, "o", "}\r\n\r\nfunc writeEnvJSON(b *bytes.Buffer, env map[string]string) {\r\n\tb.WriteByte('{')\r\n\tif len(env) > 0 {\r\n\t\tkeys := make([]string, 0, len(env))\r\n\t\tfor k := range env {\r\n\t\t\tkeys = append(keys, k)\r\n\t\t}\r\n"]
[6884.695272, "o", "\t\tsort.Strings(keys)\r\n\t\tfor i, k := range keys {\r\n\t\t\tif i > 0 {\r\n\t\t\t\tb.WriteByte(',')\r\n\t\t\t}\r\n\t\t\tb.WriteByte('\"')\r\n\t\t\twriteJSONString(b, k)\r\n\t\t\tb.WriteString(`\":\"`)\r\n\t\t\twriteJSONString(b, env[k])\r\n\t\t\tb.WriteByte('\"')\r\n\t\t}\r\n\t}\r\n\tb.WriteByte('}')\r\n}\r\n\r\nfunc printValidationError(err error) {\r\n\tif ve, ok := err.(*ValidationError); ok {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s: %s\\n\", ve.Code, ve.Message)\r\n\t\treturn\r\n\t}\r\n\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n"]
[6884.695344, "o", "}\r\n"]
