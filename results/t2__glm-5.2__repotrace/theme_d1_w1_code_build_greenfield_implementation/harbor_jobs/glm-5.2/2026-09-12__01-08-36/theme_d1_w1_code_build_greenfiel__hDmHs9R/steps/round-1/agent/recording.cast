[8176.958827, "o", "   167\t\t\tkeys := make([]string, 0, len(job.Env))\r\n   168\t\t\tfor k := range job.Env {\r\n   169\t\t\t\tkeys = append(keys, k)\r\n   170\t\t\t}\r\n   171\t\t\tsort.Strings(keys)\r\n   172\t\t\tfor _, k := range keys {\r\n   173\t\t\t\tif !envKeyRegexp.MatchString(k) {\r\n   174\t\t\t\t\treturn nil, &ValidationError{Code: \"invalid_env_key\", Message: \"invalid env key in \" + job.Name + \": \" + k}\r\n"]
