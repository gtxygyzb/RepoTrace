[5112.865503, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/sha256\"\r\n     5\t\t\"encoding/hex\"\r\n"]
[5112.865591, "o", "     6\t\t\"flag\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"io\"\r\n     9\t\t\"os\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strings\"\r\n    12\t)\r\n    13\t\r\n    14\tfunc runHash(args []string) int {\r\n    15\t\tfs := flag.NewFlagSet(\"hash\", flag.ContinueOnError)\r\n    16\t\tfs.SetOutput(io.Discard)\r\n    17\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    18"]
[5112.865667, "o", "\t\tformat := fs.String(\"format\", \"short\", \"hash format: short|long\")\r\n    19\t\tif err := fs.Parse(args); err != nil {\r\n    20\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n    21\t\t\treturn 2\r\n    22\t\t}\r\n    23\t\tif *specPath == \"\" {\r\n    24\t\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n    25\t\t\treturn 2\r\n    26\t\t}\r\n    27\t\tif len(fs.Args()) > 0 {\r\n"]
[5112.865738, "o", "    28\t\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n    29\t\t\treturn 2\r\n    30\t\t}\r\n    31\t\tif *format != \"short\" && *format != \"long\" {\r\n"]
[5112.865801, "o", "    32\t\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n    33\t\t\treturn 2\r\n    34\t\t}\r\n    35\t\r\n    36\t\tspec, err := loadSpec(*specPath)\r\n    37\t\tif err != nil {\r\n    38\t\t\tprintValidationError(err)\r\n    39\t\t\treturn 2\r\n    40\t\t}\r\n    41\t\r\n    42\t\tvar buf strings.Builder\r\n    43\t\tfor _, names := range computeLevels(spec) {\r\n"]
[5112.865902, "o", "    44\t\t\tfor _, name := range names {\r\n    45\t\t\t\tjob := spec.ByName[name]\r\n    46\t\t\t\tbuf.WriteString(job.Name)\r\n    47\t\t\t\tbuf.WriteByte(0)\r\n    48\t\t\t\tbuf.WriteString(job.Workdir)\r\n    49\t\t\t\tbuf.WriteByte(0)\r\n    50\t\t\t\tbuf.WriteString(job.Command)\r\n    51\t\t\t\tbuf.WriteByte(0)\r\n    52\t\t\t\tbuf.WriteString(\"deps=\")\r\n    53\t\t\t\tbuf.WriteString(strings.Join(job.Deps, \",\"))\r\n    54\t\t\t\tbuf.WriteByte(0)\r\n    55"]
[5112.865934, "o", "\t\t\t\tbuf.WriteString(\"env=\")\r\n    56\t\t\t\tkeys := make([]string, 0, len(job.Env))\r\n    57\t\t\t\tfor k := range job.Env {\r\n    58\t\t\t\t\tkeys = append(keys, k)\r\n"]
[5112.86602, "o", "    59\t\t\t\t}\r\n    60\t\t\t\tsort.Strings(keys)\r\n    61\t\t\t\tparts := make([]string, 0, len(keys))\r\n    62\t\t\t\tfor _, k := range keys {\r\n    63\t\t\t\t\tparts = append(parts, k+\"=\"+job.Env[k])\r\n    64\t\t\t\t}\r\n    65\t\t\t\tbuf.WriteString(strings.Join(parts, \",\"))\r\n    66\t\t\t\tbuf.WriteByte('\\n')\r\n    67\t\t\t}\r\n    68\t\t}\r\n    69\t\r\n    70\t\t"]
[5112.866085, "o", "sum := sha256.Sum256([]byte(buf.String()))\r\n    71\t\thexSum := hex.EncodeToString(sum[:])\r\n    72\t\tif *format == \"short\" {\r\n    73\t\t\tfmt.Println(hexSum[:12])\r\n    74\t\t} else {\r\n    75\t\t\tfmt.Println(hexSum)\r\n    76\t\t}\r\n    77\t\treturn 0\r\n"]
[5112.866151, "o", "    78\t}\r\n"]
