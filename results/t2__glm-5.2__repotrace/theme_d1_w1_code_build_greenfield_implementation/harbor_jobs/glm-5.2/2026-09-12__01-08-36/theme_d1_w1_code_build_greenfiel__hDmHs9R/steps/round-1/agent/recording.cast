[2879.9266, "o", "    75\t\t\t\tsort.Strings(sorted)\r\n    76\t\t\t\tfor _, n := range sorted {\r\n    77\t\t\t\t\tcyclicSCC[n] = true\r\n    78\t\t\t\t}\r\n    79\t\t\t\tif start == \"\" || sorted[0] < start {\r\n    80\t\t\t\t\tstart = sorted[0]\r\n    81\t\t\t\t}\r\n    82\t\t\t"]
[2879.926662, "o", "}\r\n    83\t\t}\r\n    84\t\r\n    85\t\tif start == \"\" {\r\n    86\t\t\treturn nil\r\n    87\t\t}\r\n    88\t\r\n    89\t\tinStartSCC := map[string]bool{}\r\n    90\t\tfor _, scc := range sccs {\r\n    91\t\t\tif len(scc) > 1 {\r\n"]
[2879.926723, "o", "    92\t\t\t\tfor _, n := range scc {\r\n    93\t\t\t\t\tif n == start {\r\n    94\t\t\t\t\t\tfor _, n2 := range scc {\r\n    95\t\t\t\t\t\t\tinStartSCC[n2] = true\r\n    96\t\t\t\t\t\t}\r\n    97\t\t\t\t\t\tbreak\r\n    98\t\t\t\t\t}"]
[2879.926803, "o", "\r\n    99\t\t\t\t}\r\n   100\t\t\t}\r\n   101\t\t}\r\n   102\t\r\n   103\t\tpath := findCyclePath(start, adj, inStartSCC)\r\n   104\t\treturn &ValidationError{Code: \"cycle\", Message: path}\r\n   105\t}\r\n   106\t\r\n   107\tfunc findCyclePath(start string, adj map[string][]string, inSCC map[string]bool) string {\r\n   108\t\tpath := []string{start}\r\n   109\t\tvisited := map[string]bool{}\r\n   110"]
[2879.926937, "o", "\t\r\n   111\t\tvar dfs func() bool\r\n   112\t\tdfs = func() bool {\r\n   113\t\t\tcur := path[len(path)-1]\r\n   114\t\t\tfor _, next := range adj[cur] {\r\n   115\t\t\t\tif !inSCC[next] {\r\n   116\t\t\t\t\tcontinue\r\n   117\t\t\t\t}\r\n   118\t\t\t\tif next == start {\r\n   119\t\t\t\t\tpath = append(path, start)\r\n   120\t\t\t\t\treturn true\r\n   121\t\t\t\t}\r\n   122\t\t\t\tif visited[next] {\r\n   123\t\t\t\t\tcontinue\r\n   124\t\t\t\t}\r\n   125\t\t\t\tvisited[next] = true\r\n   126\t\t\t\tpath = append(path, next)\r\n   127\t\t\t\tif dfs() {\r\n   128\t\t\t\t\treturn true\r\n"]
[2879.927005, "o", "   129\t\t\t\t}\r\n   130\t\t\t\tpath = path[:len(path)-1]\r\n   131\t\t\t\tdelete(visited, next)\r\n   132\t\t\t}\r\n   133\t\t\treturn false\r\n   134\t\t}\r\n   135\t\r\n   136\t\tif dfs() {\r\n   137\t\t\treturn strings.Join(path, \" -> \")\r\n   138"]
[2879.92706, "o", "\t\t}\r\n   139\t\treturn start\r\n   140\t}\r\n"]
