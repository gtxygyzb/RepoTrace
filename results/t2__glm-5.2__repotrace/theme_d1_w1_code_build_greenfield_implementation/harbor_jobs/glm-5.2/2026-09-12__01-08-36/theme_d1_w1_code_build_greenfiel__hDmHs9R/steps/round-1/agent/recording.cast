[6827.502529, "o", "    50\t}\r\n    51\t\r\n    52\tfunc canonicalForm(spec *Spec) string {\r\n    53\t\tvar buf strings.Builder\r\n    54\t\tfor _, names := range computeLevels(spec) {\r\n    55\t\t\tfor _, name := range names {\r\n    56\t\t\t\tjob := spec.ByName[name]\r\n    57\t\t\t\tbuf.WriteString(job.Name)\r\n    58\t\t\t\tbuf.WriteByte(0)\r\n"]
