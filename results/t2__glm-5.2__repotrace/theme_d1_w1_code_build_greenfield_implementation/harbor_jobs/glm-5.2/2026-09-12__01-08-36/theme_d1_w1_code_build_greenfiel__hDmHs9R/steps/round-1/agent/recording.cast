[5873.846237, "o", "   178\tfunc parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {\r\n   179\t\tif only == \"\" {\r\n   180\t\t\treturn nil, nil\r\n   181\t\t}\r\n   182\t\r\n   183\t\tselected := map[string]bool{}\r\n   184\t\tseen := map[string]bool{}\r\n   185\t\tfor _, name := range strings.Split(only, \",\") {\r\n   186\t\t"]
[5873.846358, "o", "\tif seen[name] {\r\n   187\t\t\t\tcontinue\r\n   188\t\t\t}\r\n   189\t\t\tseen[name] = true\r\n   190\t\r\n   191\t\t\tjob, ok := spec.ByName[name]\r\n   192\t\t\tif !ok {\r\n   193\t\t\t\treturn nil, &ValidationError{Code: \"unknown_dep\", Message: \"unknown dep in --only: \" + name}\r\n   194\t\t\t}\r\n   195\t\t\taddTransitiveDeps(spec, job, selected)\r\n   196\t\t}\r\n   197\t\treturn selected, nil\r\n   198\t}\r\n   199\t\r\n   200\tfunc addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {\r\n   201\t\tif selected[job.Name] {\r\n   202\t\t\treturn\r\n"]
[5873.84642, "o", "   203\t\t}\r\n   204\t\tselected[job.Name] = true\r\n   205\t\tfor _, dep := range job.Deps {\r\n   206\t\t\taddTransitiveDeps(spec, spec.ByName[dep], selected)\r\n   207\t\t}\r\n   208\t}\r\n   209\t\r\n   210\tfunc listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {\r\n   211\t\tlevels := computeLevels(spec)\r\n   212\t\tlevel := make(map[string]int, len(spec.Jobs))\r\n   213"]
[5873.846503, "o", "\t\tfor i, names := range levels {\r\n   214\t\t\tfor _, name := range names {\r\n   215\t\t\t\tlevel[name] = i\r\n   216\t\t\t}\r\n   217\t\t}\r\n   218\t\r\n   219\t\torder := make([]*Job, 0, len(spec.Jobs))\r\n   220\t\tfor _, names := range levels {\r\n   221\t\t\tfor _, name := range names {\r\n   222\t\t\t\tif selected != nil && !selected[name] {\r\n   223\t\t\t\t\tcontinue\r\n   224"]
[5873.846559, "o", "\t\t\t\t}\r\n   225\t\t\t\torder = append(order, spec.ByName[name])\r\n   226\t\t\t}\r\n   227\t\t}\r\n   228\t\treturn order, level\r\n   229\t}\r\n   230\t\r\n   231\t"]
[5873.84661, "o", "func renderListText(jobs []*Job, level map[string]int) []byte {\r\n   232\t\tvar b strings.Builder\r\n   233\t\tfor _, job := range jobs {\r\n   234\t\t\tb.WriteString(job.Name)\r\n   235\t\t\tb.WriteString(\"\\tlevel=\")\r\n"]
