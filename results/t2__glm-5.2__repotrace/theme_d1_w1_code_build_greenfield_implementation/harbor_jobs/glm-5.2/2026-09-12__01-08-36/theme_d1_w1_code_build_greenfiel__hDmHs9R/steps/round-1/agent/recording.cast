[6826.916623, "o", "   198\t\t}\r\n   199\t\treturn selected, nil\r\n   200\t}\r\n   201\t\r\n   202\tfunc addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {\r\n   203\t\tif selected[job.Name] {\r\n   204\t\t\treturn\r\n   205\t\t}\r\n   206\t\tselected[job.Name] = true\r\n   207\t\tfor _, dep := range job.Deps {\r\n   208\t\t\taddTransitiveDeps(spec, spec.ByName[dep], selected)\r\n   209\t\t}\r\n   210\t}\r\n   211\t\r\n   212\tfunc listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {\r\n   213\t\tlevels := computeLevels(spec)\r\n   214\t\tlevel := make(map[string]int, len(spec.Jobs))\r\n   215\t\tfor i, names := range levels {\r\n   216\t\t\tfor _, name := range names {\r\n   217\t\t\t\tlevel[name] = i\r\n   218\t\t\t}\r\n   219\t\t}\r\n   220\t\r\n"]
[6826.916642, "o", "   221\t\torder := make([]*Job, 0, len(spec.Jobs))\r\n   222\t\tfor _, names := range levels {\r\n   223\t\t\tfor _, name := range names {\r\n"]
