[5838.908934, "o", "    10\t\r\n    11\ttype Job struct {\r\n    12\t\tIndex   int\r\n    13\t\tName    string\r\n    14\t\tCommand string\r\n    15\t\tDeps    []string\r\n    16\t\tWorkdir string\r\n    17\t\tEnv     map[string]string\r\n    18\t}\r\n    19\t\r\n    20\ttype Spec struct {\r\n    21\t\tJobs   []*Job\r\n    22\t\tByName map[string]*Job\r\n    23\t}\r\n    24\t\r\n    25\ttype ValidationError struct {\r\n    26\t\tCode    string\r\n"]
