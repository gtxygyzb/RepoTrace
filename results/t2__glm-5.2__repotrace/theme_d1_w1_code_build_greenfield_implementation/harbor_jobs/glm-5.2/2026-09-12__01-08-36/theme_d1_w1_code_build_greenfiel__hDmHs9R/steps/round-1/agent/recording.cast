[8997.674957, "o", "   171\t\t\treturn 2\r\n   172\t\t}\r\n   173\t\r\n   174\t\tjobs, levels := listJobs(spec, selected)\r\n   175\t\tswitch *format {\r\n   176\t\tcase \"text\":\r\n   177\t\t\tos.Stdout.Write(renderListText(jobs, levels))\r\n   178\t\tcase \"json\":\r\n"]
