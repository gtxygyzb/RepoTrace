[8965.579939, "o", "\t\treturn 2\r\n\t}\r\n\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n\t\treturn 2\r\n\t}\r\n\tif len(fs.Args()) > 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n\t\treturn 2\r\n"]
[8965.579955, "o", "\t}\r\n\tif *format != \"short\" && *format != \"long\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n"]
[8965.580027, "o", "\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tsum := sha256.Sum256([]byte(canonicalForm(spec)))\r\n\thexSum := hex.EncodeToString(sum[:])\r\n\tif *format == \"short\" {\r\n\t\tfmt.Println(hexSum[:12])\r\n\t} else {\r\n\t\tfmt.Println(hexSum)\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[8965.580042, "o", "\r\nfunc canonicalForm(spec *Spec) string {\r\n\tvar buf strings.Builder\r\n"]
[8965.580109, "o", "\tfor _, names := range computeLevels(spec) {\r\n\t\tfor _, name := range names {\r\n\t"]
[8965.580158, "o", "\t\tjob := spec.ByName[name]\r\n\t\t\tbuf.WriteString(job.Name)\r\n\t\t\tbuf.WriteByte(0)\r\n\t\t\tbuf.WriteString(job.Workdir)\r\n\t\t\tbuf.WriteByte(0)\r\n\t\t\tbuf.WriteString(job.Command)\r\n\t\t\tbuf.WriteByte(0)\r\n\t\t\tbuf.WriteString(\"deps=\")\r\n\t\t\tbuf.WriteString(strings.Join(job.Deps, \",\"))\r\n\t\t\tbuf.WriteByte(0)\r\n"]
[8965.580214, "o", "\t\t\tbuf.WriteString(\"env=\")\r\n\t\t\tkeys := make([]string, 0, len(job.Env))\r\n\t\t\tfor k := range job.Env {\r\n\t\t\t\tkeys = append(keys, k)\r\n\t\t\t}\r\n\t\t\tsort.Strings(keys)\r\n\t\t\tparts := make([]string, 0, len(keys))\r\n\t\t\tfor _, k := range keys {\r\n\t\t\t\tparts = append(parts, k+\"=\"+job.Env[k])\r\n\t\t\t}\r\n\t\t\tbuf.WriteString(strings.Join(parts, \",\"))\r\n\t\t\tbuf.WriteByte('\\n')\r\n"]
[8965.580265, "o", "\t\t}\r\n\t}\r\n"]
[8965.580315, "o", "\treturn buf.String()\r\n}\r\n"]
[8965.580868, "o", "cmd/jobforge/cycle.go\r\n"]
[8965.582724, "o", "===== cmd/jobforge/cycle.go\r\n"]
[8965.584824, "o", "package main\r\n\r\nimport (\r\n"]
[8965.584846, "o", "\t\"sort\"\r\n\t\"strings\"\r\n)\r\n\r\n"]
[8965.584857, "o", "func detectCycle(spec *Spec) *ValidationError {\r\n"]
[8965.584972, "o", "\tadj := map[string][]string{}\r\n\tfor _, job := range spec.Jobs {\r\n\t\tdeps := append([]string(nil), job.Deps...)\r\n\t\tsort.Strings(deps)\r\n\t\tadj[job.Name] = deps\r\n\t}\r\n\r\n\tindex := 0\r\n\tstack := []string{}\r\n\tonStack := map[string]bool{}\r\n\tindices := map[string]int{}\r\n\tlow := map[string]int{}\r\n\tvar sccs [][]string\r\n\r\n\tvar strongconnect func(v string)\r\n\tstrongconnect = func(v string) {\r\n\t\tindices[v] = index\r\n\t\tlow[v] = index\r\n\t\tindex++\r\n\t\tstack = append(stack, v)\r\n\t\tonStack[v] = true\r\n"]
[8965.584991, "o", "\r\n\t\tfor _, w := range adj[v] {\r\n\t\t\tif _, ok := indices[w]; !ok {"]
[8965.585085, "o", "\r\n\t\t\t\tstrongconnect(w)\r\n\t\t\t\tif low[w] < low[v] {\r\n\t\t\t\t\tlow[v] = low[w]\r\n\t"]
[8965.58514, "o", "\t\t\t}\r\n\t\t\t} else if onStack[w] {\r\n\t\t\t\tif indices[w] < low[v] {\r\n\t\t\t\t\tlow[v] = indices[w]\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif low[v] == indices[v] {\r\n\t\t\tvar scc []string\r\n\t\t\tfor {\r\n\t\t\t\tw := stack[len(stack)-1]\r\n\t\t\t\tstack = stack[:len(stack)-1]\r\n"]
[8965.58516, "o", "\t\t\t\tonStack[w] = false\r\n\t\t\t\tscc = append(scc, w)\r\n\t\t\t\tif w == v {\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tsccs = append(sccs, scc)\r\n\t\t}\r\n\t}\r\n"]
[8965.585236, "o", "\r\n\tnames := make([]string, 0, len(spec.Jobs))\r\n\tfor _, job := range spec.Jobs {\r\n\t\tnames = append(names, job.Name)\r\n\t}\r\n\tsort.Strings(names)\r\n\tfor _, name := range names {\r\n\t\tif _, ok := indices[name]; !ok {\r\n\t\t\tstrongconnect(name)\r\n\t\t}\r\n\t}\r\n\r\n\tcyclicSCC := map[string]bool{}\r\n"]
[8965.585297, "o", "\tvar start string\r\n\tfor _, scc := range sccs {\r\n\t\tif len(scc) > 1 {\r\n\t\t\tsorted := append([]string(nil), scc...)\r\n\t\t\tsort.Strings(sorted)\r\n\t\t\tfor _, n := range sorted {\r\n\t\t\t\tcyclicSCC[n] = true\r\n\t\t\t}\r\n\t\t\tif start == \"\" || sorted[0] < start {\r\n\t\t\t\tstart = sorted[0]\r\n"]
[8965.585352, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[8965.58541, "o", "\r\n\tif start == \"\" {\r\n\t\treturn nil\r\n\t}\r\n\r\n\tinStartSCC := map[string]bool{}\r\n\tfor _, scc := range sccs {\r\n\t\tif len(scc) > 1 {\r\n\t\t\tfor _, n := range scc {\r\n\t\t\t\tif n == start {\r\n\t\t\t\t\tfor _, n2 := range scc {\r\n"]
[8965.58543, "o", "\t\t\t\t\t\tinStartSCC[n2] = true\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[8965.585622, "o", "\tpath := findCyclePath(start, adj, inStartSCC)\r\n\treturn &ValidationError{Code: \"cycle\", Message: path}\r\n}\r\n\r\nfunc findCyclePath(start string, adj map[string][]string, inSCC map[string]bool) string {\r\n\tpath := []string{start}\r\n\tvisited := map[string]bool{}\r\n\r\n\tvar dfs func() bool\r\n\tdfs = func() bool {\r\n\t\tcur := path[len(path)-1]\r\n\t\tfor _, next := range adj[cur] {\r\n\t\t\tif !inSCC[next] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif next == start {\r\n\t\t\t\tpath = append(path, start)\r\n\t\t\t\treturn true\r\n\t\t\t}\r\n\t\t\tif visited[next] {\r\n"]
[8965.585696, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvisited[next] = true\r\n\t\t\tpath = append(path, next)\r\n\t\t\tif dfs() {\r\n\t\t\t\treturn true\r\n\t\t\t}\r\n\t\t\tpath = path[:len(path)-1]\r\n\t\t\tdelete(visited, next)\r\n\t\t}\r\n\t\treturn false\r\n\t}\r\n\r\n\tif dfs() {\r\n\t\treturn strings.Join(path, \" -> \")\r\n\t}\r\n\treturn start\r\n}\r\n"]
[8965.586274, "o", "cmd/jobforge/graph.go\r\n"]
[8965.588295, "o", "===== cmd/jobforge/graph.go\r\n"]
[8965.590544, "o", "package main\r\n\r\nimport (\r\n\t"]
[8965.590605, "o", "\"flag\"\r\n\t\"fmt\"\r\n"]
[8965.590676, "o", "\t\"io\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\ntype graphEdge struct {\r\n\tdep  string\r\n\tname string\r\n}\r\n\r\nfunc runGraph(args []string) int {\r\n\tfs := flag.NewFlagSet(\"graph\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\t"]
[8965.590735, "o", "specPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tformat := fs.String(\"format\", \"dot\", \"output format: dot|mermaid\")\r\n\tonly := fs.String(\"only\", \"\", \"comma-separated list of job names\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n\t\treturn 2\r\n\t}\r\n\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n\t\treturn 2\r\n\t}\r\n\tif len(fs.Args()) > 0 {\r\n"]
[8965.590799, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n\t\treturn 2\r\n\t}\r\n\tif *format != \"dot\" && *format != \"mermaid\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tselected, err := parseOnlyFilter(spec, *only)\r\n\tif err != nil {\r\n\t\t"]
[8965.590868, "o", "printValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tjobs, levels := listJobs(spec, selected)\r\n\tos.Stdout.Write(renderGraph(jobs, levels, *format))\r\n\treturn 0\r\n"]
[8965.590953, "o", "}\r\n\r\nfunc renderGraph(jobs []*Job, level map[string]int, format string) []byte {\r\n\tinSet := make(map[string]bool, len(jobs))\r\n\tfor _, job := range jobs {\r\n\t\tinSet[job.Name] = true\r\n\t"]
[8965.591094, "o", "}\r\n\r\n\tvar edges []graphEdge\r\n\tfor _, job := range jobs {\r\n\t\tfor _, dep := range job.Deps {\r\n\t\t\tif inSet[dep] {\r\n\t\t\t\tedges = append(edges, graphEdge{dep: dep, name: job.Name})\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tswitch format {\r\n\tcase \"dot\":\r\n\t\treturn renderDot(jobs, level, edges)\r\n\tcase \"mermaid\":\r\n\t\treturn renderMermaid(jobs, edges)\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc renderDot(jobs []*Job, level map[string]int, edges []graphEdge) []byte {\r\n\tvar b strings.Builder\r\n\tb.WriteString(\"digraph jobforge {\\n\")\r\n\tb.WriteString(\"\\trankdir=LR;\\n\")\r\n\tfor _, job := range jobs {\r\n\t\tb.WriteString(\"\\t\\\"\")\r\n\t\tb.WriteString(dotQuote(job.Name))\r\n\t\tb.WriteString(\"\\\" [level=\\\"\")\r\n\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n\t\tb.WriteString(\"\\\" workdir=\\\"\")\r\n\t\tb.WriteString(dotQuote(job.Workdir))\r\n\t\tb.WriteString(\"\\\"];\\n\")\r\n\t}\r\n\tfor _, e := range edges {\r\n\t\tb.WriteString(\"\\t\\\"\")\r\n\t\tb.WriteString(dotQuote(e.dep))\r\n\t\tb.WriteString(\"\\\" -> \\\"\")\r\n\t\tb.WriteString(dotQuote(e.name))\r\n"]
[8965.591191, "o", "\t\tb.WriteString(\"\\\";\\n\")\r\n\t}\r\n\tb.WriteString(\"}\\n\")\r\n\treturn []byte(b.String())\r\n}\r\n\r\nfunc renderMermaid(jobs []*Job, edges []graphEdge) []byte {\r\n\tvar b strings.Builder\r\n\tb.WriteString(\"graph LR\\n\")\r\n\tb.WriteString(\"\\t%% nodes=\")\r\n\tb.WriteString(strconv.Itoa(len(jobs)))\r\n\tb.WriteString(\" edges=\")\r\n\tb.WriteString(strconv.Itoa(len(edges)))\r\n\tb.WriteString(\"\\n\")\r\n\tfor _, job := range jobs {\r\n\t\tb.WriteString(\"\\t\")\r\n\t\tb.WriteString(mermaidID(job.Name))\r\n\t\tb.WriteString(\"[\\\"\")\r\n\t\tb.WriteString(mermaidLabel(job.Name))\r\n"]
[8965.59126, "o", "\t\tb.WriteString(\"\\\"]\\n\")\r\n\t}\r\n\tfor _, e := range edges {\r\n\t\tb.WriteString(\"\\t\")\r\n\t\tb.WriteString(mermaidID(e.dep))\r\n\t\tb.WriteString(\" --> \")\r\n\t\tb.WriteString(mermaidID(e.name))\r\n\t\tb.WriteString(\"\\n\")\r\n\t}\r\n\treturn []byte(b.String())\r\n}\r\n\r\nfunc dotQuote(s string) string {\r\n\t"]
[8965.591326, "o", "var b strings.Builder\r\n\tfor i := 0; i < len(s); i++ {\r\n\t\tc := s[i]\r\n\t\tswitch c {\r\n\t\tcase '\"':\r\n\t\t\tb.WriteString(`\\\"`)\r\n\t\tcase '\\\\':\r\n\t\t\tb.WriteString(`\\\\`)\r\n\t\tdefault:\r\n\t\t\tb.WriteByte(c)\r\n\t\t}\r\n\t"]
[8965.591384, "o", "}\r\n\treturn b.String()\r\n}\r\n\r\nfunc mermaidID(name string) string {\r\n\tvar b strings.Builder\r\n\tfor i := 0; i < len(name); i++ {\r\n\t\tc := name[i]\r\n\t\tif (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' {\r\n\t\t\t"]
[8965.591449, "o", "b.WriteByte(c)\r\n\t\t} else {\r\n\t\t\tb.WriteByte('_')\r\n\t\t}\r\n\t}\r\n\treturn b.String()\r\n}\r\n\r\nfunc mermaidLabel(name string) string {\r\n\tvar b strings.Builder\r\n\tfor i := 0; i < len(name); i++ {\r\n"]
[8965.591505, "o", "\t\tc := name[i]\r\n\t\tif c == '\"' {\r\n\t\t\tb.WriteString(\"#quot;\")\r\n\t\t} else {\r\n\t\t\tb.WriteByte(c)\r\n\t\t}\r\n\t}\r\n\treturn b.String()\r\n}\r\n"]
[8965.592182, "o", "cmd/jobforge/diff.go\r\n"]
[8965.5941, "o", "===== cmd/jobforge/diff.go\r\n"]
[8965.596328, "o", "package main\r\n\r\nimport (\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n"]
[8965.596397, "o", "\t\"os\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc runDiff(args []string) int {\r\n\tfs := flag.NewFlagSet(\"diff\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\toldPath := fs.String(\"old\", \"\", \"path to old spec file\")\r\n\tnewPath := fs.String(\"new\", \"\", \"path to new spec file\")\r\n"]
[8965.596473, "o", "\tif err := fs.Parse(args); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n\t\treturn 2\r\n\t}\r\n\tif *oldPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --old\")\r\n\t\treturn 2\r\n\t}\r\n\tif *newPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --new\")\r\n\t\treturn 2\r\n\t}\r\n"]
[8965.596536, "o", "\tif len(fs.Args()) > 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n\t\treturn 2\r\n\t}\r\n\r\n\toldSpec, err := loadSpec(*oldPath)\r\n\tif err != nil {\r\n\t\tprintDiffValidationError(\"old: \", err)\r\n\t\treturn 2\r\n\t}\r\n"]
[8965.596595, "o", "\tnewSpec, err := loadSpec(*newPath)\r\n\tif err != nil {\r\n\t\tprintDiffValidationError(\"new: \", err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tif canonicalForm(oldSpec) == canonicalForm(newSpec) {\r\n\t\treturn 0\r\n\t}\r\n"]
[8965.596654, "o", "\r\n\toldTuples := jobTuples(oldSpec)\r\n\tnewTuples := jobTuples(newSpec)\r\n\r\n\toldByName := make(map[string]diffJob, len(oldTuples))\r\n\tfor _, t := range oldTuples {\r\n\t\toldByName[t.name] = t\r\n\t}\r\n\tnewByName := make(map[string]diffJob, len(newTuples))\r\n\tfor _, t := range newTuples {\r\n\t\tnewByName[t.name] = t\r\n"]
[8965.596715, "o", "\t}\r\n\r\n\tvar out strings.Builder\r\n\tfor _, t := range newTuples {\r\n\t\tif _, ok := oldByName[t.name]; !ok {\r\n\t\t\tfmt.Fprintf(&out, \"+ %s\\n\", t.name)\r\n\t\t}\r\n\t}\r\n\tfor _, t := range oldTuples {\r\n\t\t"]
[8965.596772, "o", "if _, ok := newByName[t.name]; !ok {\r\n\t\t\tfmt.Fprintf(&out, \"- %s\\n\", t.name)\r\n\t\t}\r\n\t}\r\n\tfor _, t := range newTuples {\r\n\t\told, ok := oldByName[t.name]\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif old.workdir != t.workdir {\r\n"]
[8965.596831, "o", "\t\t\tfmt.Fprintf(&out, \"~ %s workdir: %s -> %s\\n\", t.name, old.workdir, t.workdir)\r\n\t\t}\r\n\t\tif old.command != t.command {\r\n\t\t\tfmt.Fprintf(&out, \"~ %s command: %s -> %s\\n\", t.name, old.command, t.command)\r\n\t\t}\r\n\t\tif reprDeps(old.deps) != reprDeps(t.deps) {\r\n\t\t\tfmt.Fprintf(&out, \"~ %s deps: %s -> %s\\n\", t.name, reprDeps(old.deps), reprDeps(t.deps))\r\n\t\t}\r\n\t\tif reprEnv(old.env) != reprEnv(t.env) {\r\n"]
[8965.596927, "o", "\t\t\tfmt.Fprintf(&out, \"~ %s env: %s -> %s\\n\", t.name, reprEnv(old.env), reprEnv(t.env))\r\n\t\t}\r\n\t\tif old.level != t.level {\r\n\t\t\tfmt.Fprintf(&out, \"~ %s level: %s -> %s\\n\", t.name, reprLevel(old.level), reprLevel(t.level))\r\n\t\t}\r\n\t}\r\n\r\n\tif out.Len() == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tfmt.Print(out.String())\r\n\treturn 1\r\n}\r\n\r\ntype diffJob struct {\r\n\tname    string\r\n\tworkdir string\r\n\tcommand string\r\n\tdeps    []string\r\n"]
[8965.597005, "o", "\tenv     []string\r\n\tlevel   int\r\n}\r\n\r\nfunc jobTuples(spec *Spec) []diffJob {\r\n\tlevels := computeLevels(spec)\r\n\tvar tuples []diffJob\r\n\tfor level, names := range levels {\r\n\t\tfor _, name := range names {\r\n\t\t\tjob := spec.ByName[name]\r\n\t\t\tenvKeys := make([]string, 0, len(job.Env))\r\n\t\t\tfor k := range job.Env {\r\n\t\t\t\tenvKeys = append(envKeys, k)\r\n\t\t\t}\r\n\t"]
[8965.597065, "o", "\t\tsort.Strings(envKeys)\r\n\t\t\tenvParts := make([]string, 0, len(envKeys))\r\n\t\t\tfor _, k := range envKeys {\r\n\t\t\t\tenvParts = append(envParts, k+\"=\"+job.Env[k])\r\n\t\t\t}\r\n\t\t\ttuples = append(tuples, diffJob{\r\n\t\t\t\tname:    job.Name,\r\n"]
[8965.597122, "o", "\t\t\t\tworkdir: job.Workdir,\r\n\t\t\t\tcommand: job.Command,\r\n\t\t\t\tdeps:    job.Deps,\r\n\t\t\t\tenv:     envParts,\r\n\t\t\t\tlevel:   level,\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\t"]
[8965.59718, "o", "return tuples\r\n}\r\n\r\nfunc reprDeps(deps []string) string {\r\n\treturn \"[\" + strings.Join(deps, \",\") + \"]\"\r\n}\r\n\r\nfunc reprEnv(parts []string) string {\r\n\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\r\n}\r\n\r\nfunc reprLevel(level int) string {\r\n\treturn strconv.Itoa(level)\r\n}\r\n"]
[8965.597237, "o", "\r\nfunc printDiffValidationError(prefix string, err error) {\r\n\tif ve, ok := err.(*ValidationError); ok {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s%s: %s\\n\", prefix, ve.Code, ve.Message)\r\n\t\treturn\r\n\t}\r\n\tfmt.Fprintf(os.Stderr, \"error: %s%s\\n\", prefix, err)\r\n}\r\n"]
[8965.597914, "o", "cmd/jobforge/spec.go\r\n"]
[8965.599851, "o", "===== cmd/jobforge/spec.go\r\n"]
[8965.60211, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n"]
[8965.602182, "o", "\t\"fmt\"\r\n\t\"os\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n)\r\n\r\ntype Job struct {\r\n\tIndex   int\r\n\tName    string\r\n\tCommand string\r\n\tDeps    []string\r\n\tWorkdir string\r\n\tEnv     map[string]string\r\n}"]
[8965.602246, "o", "\r\n\r\ntype Spec struct {\r\n\tJobs   []*Job\r\n\tByName map[string]*Job\r\n}\r\n\r\ntype ValidationError struct {\r\n\tCode    string\r\n\tMessage string\r\n}\r\n\r\n"]
[8965.602303, "o", "func (e *ValidationError) Error() string {\r\n\treturn e.Code + \": \" + e.Message\r\n}\r\n\r\nvar (\r\n\tnameRegexp   = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_-]*$`)\r\n\tenvKeyRegexp = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)\r\n)\r\n\r\nfunc loadSpec(path string) (*Spec, error) {\r\n\tdata, err := os.ReadFile(path)\r\n"]
[8965.602373, "o", "\tif err != nil {\r\n\t\treturn nil, &ValidationError{Code: \"spec_not_found\", Message: fmt.Sprintf(\"cannot read spec: %s\", path)}\r\n\t}\r\n\r\n\tvar top map[string]json.RawMessage\r\n\tif err := json.Unmarshal(data, &top); err != nil || top == nil {\r\n\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"top-level JSON must be an object\"}\r\n\t}\r\n\r\n\trawJobs, ok := top[\"jobs\"]\r\n\tif !ok {\r\n\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"missing jobs\"}\r\n\t}\r\n\r\n\t"]
[8965.602442, "o", "var jobsRaw []json.RawMessage\r\n\tif err := json.Unmarshal(rawJobs, &jobsRaw); err != nil || jobsRaw == nil {\r\n\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"jobs must be an array\"}\r\n\t}\r\n\r\n\tvar unknownTop []string\r\n\tfor k := range top {\r\n\t\tif k != \"jobs\" {\r\n\t\t\tunknownTop = append(unknownTop, k)\r\n\t\t}\r\n\t}\r\n\tif len(unknownTop) > 0 {\r\n\t\tsort.Strings(unknownTop)\r\n"]
[8965.602499, "o", "\t\treturn nil, &ValidationError{Code: \"unknown_field\", Message: \"unknown field: \" + unknownTop[0]}\r\n\t}\r\n\r\n\tjobMaps := make([]map[string]json.RawMessage, len(jobsRaw))\r\n\tfor i, raw := range jobsRaw {\r\n\t\tvar m map[string]json.RawMessage\r\n\t\tif err := json.Unmarshal(raw, &m); err != nil || m == nil {\r\n\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d] must be an object\", i)}\r\n\t\t}\r\n\t\tjobMaps[i] = m\r\n\t}"]
[8965.602554, "o", "\r\n\r\n\tjobs := make([]*Job, len(jobMaps))\r\n\tfor i, m := range jobMaps {\r\n\t\tjob := &Job{\r\n\t\t\tIndex:   i,\r\n\t\t\tDeps:    []string{},\r\n\t\t\tEnv:     map[string]string{},\r\n\t\t\tWorkdir: \"/app\",\r\n\t"]
[8965.602619, "o", "\t}\r\n\r\n\t\tif raw, ok := m[\"name\"]; ok {\r\n\t\t\tvar s string\r\n\t\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].name must be a string\", i)}\r\n\t\t\t}\r\n\t\t\tjob.Name = s\r\n\t\t}\r\n"]
[8965.602692, "o", "\t\tif raw, ok := m[\"command\"]; ok {\r\n\t\t\tvar s string\r\n\t\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].command must be a string\", i)}\r\n\t\t\t}\r\n\t\t\tjob.Command = s\r\n\t\t}\r\n\t\tif raw, ok := m[\"deps\"]; ok {\r\n\t\t\tvar arr []string\r\n\t\t\t"]
[8965.602751, "o", "if err := json.Unmarshal(raw, &arr); err != nil || arr == nil {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].deps must be an array of strings\", i)}\r\n\t\t\t}\r\n\t\t\tjob.Deps = arr\r\n\t\t}\r\n\t\tif raw, ok := m[\"workdir\"]; ok {\r\n\t\t\tvar s string\r\n\t\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].workdir must be a string\", i)}\r\n\t\t\t}\r\n\t\t\tjob.Workdir = s\r\n"]
[8965.602808, "o", "\t\t}\r\n\t\tif raw, ok := m[\"env\"]; ok {\r\n\t\t\tenv := map[string]string{}\r\n\t\t\tif err := json.Unmarshal(raw, &env); err != nil || env == nil {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].env must be an object of strings\", i)}\r\n\t\t\t}\r\n\t\t\tjob.Env = env\r\n"]
[8965.602889, "o", "\t\t}\r\n\t\tjobs[i] = job\r\n\t}\r\n\r\n\tfor i, m := range jobMaps {\r\n\t\tvar unknown []string\r\n\t\tfor k := range m {\r\n\t\t\tif !isKnownJobField(k) {\r\n\t\t\t\tunknown = append(unknown, k)\r\n\t\t\t}\r\n\t\t}\r\n"]
[8965.602951, "o", "\t\tif len(unknown) > 0 {\r\n\t\t\tsort.Strings(unknown)\r\n\t\t\treturn nil, &ValidationError{Code: \"unknown_field\", Message: fmt.Sprintf(\"unknown field: jobs[%d].%s\", i, unknown[0])}\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, job := range jobs {\r\n"]
[8965.603014, "o", "\t\tif _, ok := jobMaps[job.Index][\"name\"]; !ok {\r\n\t\t\treturn nil, &ValidationError{Code: \"invalid_name\", Message: \"invalid name: <missing>\"}\r\n\t\t}\r\n\t\tif !nameRegexp.MatchString(job.Name) {\r\n\t\t\treturn nil, &ValidationError{Code: \"invalid_name\", Message: \"invalid name: \" + job.Name}\r\n\t\t}\r\n\t}\r\n\r\n\tseen := map[string]bool{}\r\n\tfor _, job := range jobs {\r\n"]
[8965.603072, "o", "\t\tif seen[job.Name] {\r\n\t\t\treturn nil, &ValidationError{Code: \"duplicate_name\", Message: \"duplicate name: \" + job.Name}\r\n\t\t}\r\n\t\tseen[job.Name] = true\r\n\t}\r\n\r\n\tfor _, job := range jobs {\r\n\t\tif _, ok := jobMaps[job.Index][\"command\"]; !ok {\r\n\t\t\treturn nil, &ValidationError{Code: \"invalid_command\", Message: \"invalid command for \" + job.Name}\r\n"]
[8965.60314, "o", "\t\t}\r\n\t\tif job.Command == \"\" {\r\n\t\t\treturn nil, &ValidationError{Code: \"invalid_command\", Message: \"invalid command for \" + job.Name}\r\n\t\t}\r\n\t}\r\n\r\n"]
[8965.603201, "o", "\tfor _, job := range jobs {\r\n\t\tkeys := make([]string, 0, len(job.Env))\r\n\t\tfor k := range job.Env {\r\n\t\t\tkeys = append(keys, k)\r\n\t\t}\r\n\t\tsort.Strings(keys)\r\n\t\tfor _, k := range keys {\r\n\t\t\tif !envKeyRegexp.MatchString(k) {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"invalid_env_key\", Message: \"invalid env key in \" + job.Name + \": \" + k}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[8965.603314, "o", "\tspec := &Spec{Jobs: jobs, ByName: map[string]*Job{}}\r\n\tfor _, job := range jobs {\r\n\t\tspec.ByName[job.Name] = job\r\n\t}\r\n\r\n\tfor _, job := range jobs {\r\n"]
[8965.603387, "o", "\t\tfor _, dep := range job.Deps {\r\n\t\t\tif _, ok := spec.ByName[dep]; !ok {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"unknown_dep\", Message: \"unknown dep in \" + job.Name + \": \" + dep}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, job := range jobs {\r\n\t\tseenDeps := map[string]bool{}\r\n\t\tfor _, dep := range job.Deps {\r\n\t\t\tif seenDeps[dep] {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"duplicate_dep\", Message: \"duplicate dep in \" + job.Name + \": \" + dep}\r\n\t\t\t}\r\n\t\t\tseenDeps[dep] = true\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, job := range jobs {\r\n\t\tfor _, dep := range job.Deps {\r\n\t\t\tif dep == job.Name {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"self_dep\", Message: \"self dep: \" + job.Name}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif err := detectCycle(spec); err != nil {\r\n\t\t"]
[8965.603455, "o", "return nil, err\r\n\t}\r\n\r\n\treturn spec, nil\r\n}\r\n\r\nfunc isKnownJobField(k string) bool {\r\n\tswitch k {\r\n\tcase \"name\", \"command\", \"deps\", \"workdir\", \"env\":\r\n\t\treturn true\r\n"]
[8965.60416, "o", "cmd/jobforge/run.go\r\n"]
[8965.606138, "o", "===== cmd/jobforge/run.go\r\n"]
[8965.608421, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t"]
[8965.608511, "o", "\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"syscall\"\r\n)\r\n\r\ntype jobResult struct {\r\n\tName     string\r\n\tStatus   string\r\n\tExitCode int\r\n\tStdout   string\r\n\tStderr   string\r\n}\r\n"]
[8965.608573, "o", "\r\nfunc runSpec(spec *Spec, onFailure string, resultsPath string) int {\r\n\tlevels := computeLevels(spec)\r\n\torder := make([]*Job, 0, len(spec.Jobs))\r\n\tfor _, names := range levels {\r\n\t\tfor _, name := range names {\r\n\t\t\torder = append(order, spec.ByName[name])\r\n\t\t}\r\n\t}\r\n\r\n"]
[8965.608632, "o", "\tresults := make([]jobResult, len(order))\r\n\tstatuses := map[string]string{}\r\n\tshortCircuit := false\r\n\r\n\tfor i, job := range order {\r\n\t\tresults[i].Name = job.Name\r\n\r\n\t\tif shortCircuit {\r\n\t\t\tresults[i].Status = \"skipped\"\r\n\t\t\tresults[i].ExitCode = -1\r\n\t\t\t"]
[8965.608699, "o", "results[i].Stdout = \"\"\r\n\t\t\tresults[i].Stderr = \"\"\r\n\t\t\tstatuses[job.Name] = \"skipped\"\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tskip := false\r\n\t\tfor _, dep := range job.Deps {\r\n\t\t\tif statuses[dep] != \"ok\" {\r\n\t\t\t\tskip = true\r\n"]
[8965.608757, "o", "\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif skip {\r\n\t\t\tresults[i].Status = \"skipped\"\r\n\t\t\tresults[i].ExitCode = -1\r\n\t\t\tresults[i].Stdout = \"\"\r\n\t\t\tresults[i].Stderr = \"\"\r\n\t\t\tstatuses[job.Name] = \"skipped\"\r\n\t"]
[8965.608816, "o", "\t\tcontinue\r\n\t\t}\r\n\r\n\t\tstdout, stderr, exitCode := runJob(job)\r\n\t\tresults[i].Stdout = stdout\r\n\t\tresults[i].Stderr = stderr\r\n\t\tresults[i].ExitCode = exitCode\r\n\r\n\t\tif exitCode == 0 {\r\n"]
[8965.608889, "o", "\t\t\tresults[i].Status = \"ok\"\r\n\t\t\tstatuses[job.Name] = \"ok\"\r\n\t\t} else {\r\n\t\t\tresults[i].Status = \"failed\"\r\n\t\t\tstatuses[job.Name] = \"failed\"\r\n\t\t\tif onFailure == \"stop\" {\r\n\t\t\t\tshortCircuit = true\r\n"]
[8965.60895, "o", "\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif resultsPath != \"\" {\r\n\t\tif err := writeResults(resultsPath, onFailure, results); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: results_write: %s\\n\", err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t}\r\n\r\n"]
[8965.609008, "o", "\tfor _, r := range results {\r\n\t\tif r.Status != \"ok\" {\r\n\t\t\treturn 1\r\n\t\t}\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc runJob(job *Job) (string, string, int) {\r\n\tcmd := exec.Command(\"bash\", \"-c\", job.Command)\r\n\t"]
[8965.60907, "o", "cmd.Dir = job.Workdir\r\n\r\n\tenvMap := map[string]string{}\r\n\tfor _, kv := range os.Environ() {\r\n\t\tif idx := strings.IndexByte(kv, '='); idx >= 0 {\r\n\t\t\tenvMap[kv[:idx]] = kv[idx+1:]\r\n\t\t}\r\n\t}\r\n\tfor k, v := range job.Env {\r\n\t\t"]
[8965.6091, "o", "envMap[k] = v\r\n\t}\r\n\tenvMap[\"JOBFORGE_JOB_NAME\"] = job.Name\r\n\tresolvedWorkdir, err := filepath.Abs(job.Workdir)\r\n\tif err != nil {\r\n"]
[8965.609185, "o", "\t\tresolvedWorkdir = job.Workdir\r\n\t}\r\n\tenvMap[\"JOBFORGE_JOB_WORKDIR\"] = resolvedWorkdir\r\n\r\n\tenv := make([]string, 0, len(envMap))\r\n\tfor k, v := range envMap {\r\n\t\tenv = append(env, k+\"=\"+v)\r\n\t}\r\n\tsort.Strings(env)\r\n\tcmd.Env = env\r\n\r\n\tvar stdoutBuf, stderrBuf bytes.Buffer\r\n\tcmd.Stdout = &stdoutBuf\r\n\tcmd.Stderr = &stderrBuf\r\n\r\n"]
[8965.609246, "o", "\terr = cmd.Run()\r\n\tif err != nil && cmd.ProcessState == nil {\r\n\t\treturn sanitizeOutput(stdoutBuf.Bytes()), sanitizeOutput(stderrBuf.Bytes()), 127\r\n\t}\r\n\texitCode := 0\r\n\tif cmd.ProcessState != nil {\r\n\t\texitCode = exitCodeFromProcessState(cmd.ProcessState)\r\n\t}\r\n\treturn sanitizeOutput(stdoutBuf.Bytes()), sanitizeOutput(stderrBuf.Bytes()), exitCode\r\n}\r\n"]
[8965.609308, "o", "\r\nfunc exitCodeFromProcessState(ps *os.ProcessState) int {\r\n\tif status, ok := ps.Sys().(syscall.WaitStatus); ok {\r\n\t\tif status.Exited() {\r\n\t\t\treturn status.ExitStatus()\r\n\t\t}\r\n\t\tif status.Signaled() {\r\n\t\t\treturn 128 + int(status.Signal())\r\n\t\t}\r\n"]
[8965.609378, "o", "\t}\r\n\treturn ps.ExitCode()\r\n}\r\n\r\nfunc sanitizeOutput(b []byte) string {\r\n\treturn strings.ToValidUTF8(string(b), \"\\ufffd\")\r\n}\r\n\r\nfunc writeResults(path, onFailure string, results []jobResult) error {\r\n\tvar b bytes.Buffer\r\n\tb.WriteString(\"{\\n\")\r\n\tb.WriteString(\"  \\\"on_failure\\\": \\\"\")\r\n\tb.WriteString(onFailure)"]
[8965.609454, "o", "\r\n\tb.WriteString(\"\\\",\\n\")\r\n\tb.WriteString(\"  \\\"jobs\\\": [\")\r\n\tif len(results) == 0 {\r\n\t\tb.WriteString(\"]\\n\")\r\n\t} else {\r\n\t\tb.WriteString(\"\\n\")\r\n\t\tfor i, r := range results {\r\n\t\t\tb.WriteString(\"    {\\n\")\r\n\t\t\tb.WriteString(\"      \\\"name\\\": \\\"\")\r\n"]
[8965.609529, "o", "\t\t\twriteJSONString(&b, r.Name)\r\n\t\t\tb.WriteString(\"\\\",\\n\")\r\n\t\t\tb.WriteString(\"      \\\"status\\\": \\\"\")\r\n\t\t\tb.WriteString(r.Status)\r\n\t\t\tb.WriteString(\"\\\",\\n\")\r\n\t\t\tb.WriteString(\"      \\\"exit_code\\\": \")\r\n\t\t\tb.WriteString(strconv.Itoa(r.ExitCode))\r\n\t\t\tb.WriteString(\",\\n\")\r\n\t\t\tb.WriteString(\"      \\\"stdout\\\": \\\"\")\r\n\t\t\twriteJSONString(&b, r.Stdout)\r\n\t\t\tb.WriteString(\"\\\",\\n\")\r\n\t\t\tb.WriteString(\"      \\\"stderr\\\": \\\"\")\r\n"]
[8965.609593, "o", "\t\t\twriteJSONString(&b, r.Stderr)\r\n\t\t\tb.WriteString(\"\\\"\\n\")\r\n\t\t\tb.WriteString(\"    }\")\r\n\t\t\tif i < len(results)-1 {\r\n\t\t\t\tb.WriteString(\",\")\r\n\t\t\t}\r\n\t\t\tb.WriteString(\"\\n\")\r\n\t\t}\r\n\t\tb.WriteString(\"  ]\\n\")\r\n"]
[8965.609648, "o", "\t}\r\n\tb.WriteString(\"}\\n\")\r\n\treturn os.WriteFile(path, b.Bytes(), 0644)\r\n}\r\n\r\nfunc writeJSONString(b *bytes.Buffer, s string) {\r\n\tfor i := 0; i < len(s); i++ {\r\n\t\tc := s[i]\r\n\t\tswitch c {\r\n"]
[8965.609707, "o", "\t\tcase '\"':\r\n\t\t\tb.WriteString(`\\\"`)\r\n\t\tcase '\\\\':\r\n\t\t\tb.WriteString(`\\\\`)\r\n\t\tcase '\\b':\r\n\t\t\tb.WriteString(`\\b`)\r\n\t\tcase '\\t':\r\n\t\t\tb.WriteString(`\\t`)\r\n\t"]
[8965.609768, "o", "\tcase '\\n':\r\n\t\t\tb.WriteString(`\\n`)\r\n\t\tcase '\\f':\r\n\t\t\tb.WriteString(`\\f`)\r\n\t\tcase '\\r':\r\n\t\t\tb.WriteString(`\\r`)\r\n\t\tdefault:\r\n\t\t\tif c < 0x20 {\r\n\t\t"]
[8965.609823, "o", "\t\tb.WriteString(fmt.Sprintf(`\\u00%02x`, c))\r\n\t\t\t} else {\r\n\t\t\t\tb.WriteByte(c)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n"]
[8965.610495, "o", "cmd/jobforge/schedule.go\r\n"]
[8965.612357, "o", "===== cmd/jobforge/schedule.go\r\n"]
[8965.614479, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n"]
[8965.614551, "o", "\t\"os\"\r\n\t\"strconv\"\r\n)\r\n\r\ntype scheduleAssignment struct {\r\n\tName   string `json:\"name\"`\r\n\tWorker int    `json:\"worker\"`\r\n\tStart  int    `json:\"start\"`\r\n\tEnd    int    `json:\"end\"`\r\n}\r\n\r\n"]
[8965.614615, "o", "func runSchedule(args []string) int {\r\n\tfs := flag.NewFlagSet(\"schedule\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tworkersStr := fs.String(\"workers\", \"\", \"number of worker lanes\")\r\n\tformat := fs.String(\"format\", \"text\", \"output format: text|json\")\r\n\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\r\n\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n\t"]
[8965.614676, "o", "\treturn 2\r\n\t}\r\n\r\n\tif *workersStr == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --workers required\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tworkers, ok := parseWorkers(*workersStr)\r\n\tif !ok {\r\n"]
[8965.614735, "o", "\t\tfmt.Fprintln(os.Stderr, \"error: bad --workers\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tif *format != \"text\" && *format != \"json\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tif len(fs.Args()) > 0 {\r\n\t\t"]
[8965.614798, "o", "fmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tassignments, makespan := computeSchedule(spec, workers)\r\n\tswitch *format {\r\n"]
[8965.614874, "o", "\tcase \"text\":\r\n\t\tos.Stdout.Write(renderScheduleText(makespan, assignments))\r\n\tcase \"json\":\r\n\t\tos.Stdout.Write(renderScheduleJSON(workers, makespan, assignments))\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc parseWorkers(s string) (int, bool) {\r\n\tif s == \"\" || s[0] < '1' || s[0] > '9' {\r\n\t\treturn 0, false\r\n\t}\r\n"]
[8965.614936, "o", "\tfor i := 1; i < len(s); i++ {\r\n\t\tif s[i] < '0' || s[i] > '9' {\r\n\t\t\treturn 0, false\r\n\t\t}\r\n\t}\r\n\r\n\tn := 0\r\n\tfor i := 0; i < len(s); i++ {\r\n\t\tn = n*10 + int(s[i]-'0')\r\n\t}\r\n\treturn n, true\r\n}\r\n\r\n"]
[8965.614997, "o", "func computeSchedule(spec *Spec, workers int) ([]scheduleAssignment, int) {\r\n\tlevels := computeLevels(spec)\r\n\tbusyUntil := make([]int, workers)\r\n\tendTime := make(map[string]int, len(spec.Jobs))\r\n\r\n\tassignments := make([]scheduleAssignment, 0, len(spec.Jobs))\r\n\tmakespan := 0\r\n\r\n\tfor _, names := range levels {\r\n\t\tfor _, name := range names {\r\n"]
[8965.615063, "o", "\t\t\tjob := spec.ByName[name]\r\n\r\n\t\t\tearliest := 0\r\n\t\t\tfor _, dep := range job.Deps {\r\n\t\t\t\tif end := endTime[dep]; end > earliest {\r\n\t\t\t\t"]
[8965.615121, "o", "\tearliest = end\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\tworker := -1\r\n\t\t\tfor w := 0; w < workers; w++ {\r\n\t\t\t\tif busyUntil[w] <= earliest {\r\n\t\t\t\t\tworker = w\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t\tif worker == -1 || busyUntil[w] < busyUntil[worker] {\r\n\t\t\t\t\tworker = w\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[8965.615177, "o", "\t\t\tif worker == -1 {\r\n\t\t\t\tworker = 0\r\n\t\t\t}\r\n\t\t\tif busyUntil[worker] > earliest {\r\n\t\t\t\tearliest = busyUntil[worker]\r\n\t\t\t}\r\n\r\n\t\t\tstart := earliest\r\n"]
[8965.615236, "o", "\t\t\tend := start + 1\r\n\t\t\tbusyUntil[worker] = end\r\n\t\t\tendTime[name] = end\r\n\r\n\t\t\tassignments = append(assignments, scheduleAssignment{\r\n\t\t\t\tName:   name,\r\n\t\t\t\tWorker: worker,\r\n\t\t\t\tStart:  start,\r\n\t\t\t\tEnd:    end,\r\n"]
[8965.615298, "o", "\t\t\t})\r\n\r\n\t\t\tif end > makespan {\r\n\t\t\t\tmakespan = end\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\treturn assignments, makespan\r\n"]
[8965.615356, "o", "}\r\n\r\nfunc renderScheduleText(makespan int, assignments []scheduleAssignment) []byte {\r\n\tvar b bytes.Buffer\r\n\tb.WriteString(\"makespan=\")\r\n\tb.WriteString(strconv.Itoa(makespan))\r\n\tb.WriteByte('\\n')\r\n\tfor _, a := range assignments {\r\n\t\tb.WriteString(a.Name)\r\n\t\tb.WriteString(\"\\tworker=\")\r\n"]
[8965.615417, "o", "\t\tb.WriteString(strconv.Itoa(a.Worker))\r\n\t\tb.WriteString(\"\\tstart=\")\r\n\t\tb.WriteString(strconv.Itoa(a.Start))\r\n\t\tb.WriteString(\"\\tend=\")\r\n\t\tb.WriteString(strconv.Itoa(a.End))\r\n\t\tb.WriteByte('\\n')\r\n\t}\r\n\treturn b.Bytes()\r\n}\r\n\r\nfunc renderScheduleJSON(workers, makespan int, assignments []scheduleAssignment) []byte {\r\n\tvar b bytes.Buffer\r\n\t"]
[8965.615475, "o", "b.WriteString(`{\"workers\":`)\r\n\tb.WriteString(strconv.Itoa(workers))\r\n\tb.WriteString(`,\"makespan\":`)\r\n\tb.WriteString(strconv.Itoa(makespan))\r\n\tb.WriteString(`,\"assignments\":[`)\r\n\tfor i, a := range assignments {\r\n\t\tif i > 0 {\r\n\t\t\tb.WriteByte(',')\r\n\t\t}\r\n\t"]
[8965.615531, "o", "\tb.WriteString(`{\"name\":\"`)\r\n\t\twriteJSONString(&b, a.Name)\r\n\t\tb.WriteString(`\",\"worker\":`)\r\n\t\tb.WriteString(strconv.Itoa(a.Worker))\r\n\t\tb.WriteString(`,\"start\":`)\r\n\t\tb.WriteString(strconv.Itoa(a.Start))\r\n\t\tb.WriteString(`,\"end\":`)\r\n\t\tb.WriteString(strconv.Itoa(a.End))\r\n\t\tb.WriteByte('}')\r\n"]
[8965.615603, "o", "\t}\r\n\tb.WriteString(`]}`)\r\n\tb.WriteByte('\\n')\r\n\treturn b.Bytes()\r\n}\r\n"]
[8965.616139, "o", "cmd/jobforge/critical.go\r\n"]
[8965.617973, "o", "===== cmd/jobforge/critical.go\r\n"]
[8965.620024, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n"]
[8965.620098, "o", "\t\"io\"\r\n\t\"os\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc runCritical(args []string) int {\r\n\tfs := flag.NewFlagSet(\"critical\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n"]
[8965.620127, "o", "\tif err := fs.Parse(args); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n\t\treturn 2\r\n\t}\r\n\tif *specPath == \"\" {\r\n"]
[8965.620157, "o", "\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n\t\treturn 2\r\n\t}\r\n\tif len(fs.Args()) > 0 {"]
[8965.62018, "o", "\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n\t\treturn 2\r\n\t}\r\n\tif *format != \"text\" && *format != \"json\" {\r\n"]
[8965.620336, "o", "\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tlength, path := criticalPath(spec)\r\n\tswitch *format {\r\n\tcase \"text\":\r\n\t\tvar b strings.Builder\r\n\t\tfmt.Fprintf(&b, \"length=%d\\n\", length)\r\n\t\tfor _, name := range path {\r\n\t\t\tb.WriteString(name)\r\n\t\t\tb.WriteByte('\\n')\r\n\t\t}\r\n\t\tos.Stdout.WriteString(b.String())\r\n\tcase \"json\":\r\n\t\tout, err := json.Marshal(struct {\r\n\t\t\tLength int      `json:\"length\"`\r\n\t"]
[8965.6204, "o", "\t\tPath   []string `json:\"path\"`\r\n\t\t}{Length: length, Path: path})\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tos.Stdout.Write(out)\r\n\t\tfmt.Println()\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[8965.620464, "o", "\r\nfunc criticalPath(spec *Spec) (int, []string) {\r\n\tif len(spec.Jobs) == 0 {\r\n\t\treturn 0, []string{}\r\n\t}\r\n\r\n\tlengths := make(map[string]int)\r\n\tvar compute func(job *Job) int\r\n\tcompute = func(job *Job) int {\r\n\t\tif l, ok := lengths[job.Name]; ok {\r\n\t\t\treturn l\r\n"]
[8965.620522, "o", "\t\t}\r\n\t\tmaxDepLen := 0\r\n\t\tfor _, dep := range job.Deps {\r\n\t\t\tl := compute(spec.ByName[dep])\r\n\t\t\tif l > maxDepLen {\r\n\t\t\t\tmaxDepLen = l\r\n\t\t\t}\r\n\t\t}\r\n"]
[8965.620579, "o", "\t\tl := maxDepLen + 1\r\n\t\tlengths[job.Name] = l\r\n\t\treturn l\r\n\t}\r\n\r\n\tfor _, job := range spec.Jobs {\r\n\t\tcompute(job)\r\n\t}\r\n\r\n"]
[8965.620637, "o", "\tmaxLength := 0\r\n\tvar sink string\r\n\tfor _, job := range spec.Jobs {\r\n\t\tl := lengths[job.Name]\r\n\t\tif l > maxLength || (l == maxLength && job.Name < sink) {\r\n\t\t\tmaxLength = l\r\n\t\t\tsink = job.Name\r\n\t\t}\r\n\t}\r\n\r\n"]
[8965.620693, "o", "\tpath := []string{sink}\r\n\tcur := spec.ByName[sink]\r\n\tfor len(cur.Deps) > 0 {\r\n\t\tbestDep := \"\"\r\n\t\tbestLen := 0\r\n\t\tfor _, dep := range cur.Deps {\r\n\t\t\tl := lengths[dep]\r\n\t\t\tif l > bestLen || (l == bestLen && dep < bestDep) {\r\n"]
[8965.62075, "o", "\t\t\t\tbestLen = l\r\n\t\t\t\tbestDep = dep\r\n\t\t\t}\r\n\t\t}\r\n\t\tpath = append(path, bestDep)\r\n\t\tcur = spec.ByName[bestDep]\r\n\t}\r\n\r\n\tfor i, j := 0, len(path)-1; i < j; i, j = i+1, j-1 {\r\n\t\t"]
[8965.620805, "o", "path[i], path[j] = path[j], path[i]\r\n\t}\r\n\treturn maxLength, path\r\n}\r\n"]
[8965.62139, "o", "cmd/jobforge/ancestors.go\r\n"]
[8965.623334, "o", "===== cmd/jobforge/ancestors.go\r\n"]
[8965.625368, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n"]
[8965.625442, "o", "\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc runAncestors(args []string) int {\r\n\tfs := flag.NewFlagSet(\"ancestors\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tjobName := fs.String(\"job\", \"\", \"target job\")\r\n\tformat := fs.String(\"format\", \"text\", \"output format: text|json\")\r\n\t"]
[8965.625502, "o", "if err := fs.Parse(args); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\r\n\tif *format != \"text\" && *format != \"json\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n\t\treturn 2\r\n\t}\r\n"]
[8965.625562, "o", "\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --spec required\")\r\n\t\treturn 2\r\n\t}\r\n\tif *jobName == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --job required\")\r\n\t\treturn 2\r\n\t}\r\n\t"]
[8965.62562, "o", "if len(fs.Args()) != 0 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: unexpected arguments\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n"]
[8965.625678, "o", "\t}\r\n\r\n\ttarget, ok := spec.ByName[*jobName]\r\n\tif !ok {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unknown_job: %s\\n\", *jobName)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tancestorSet := computeAncestorSet(spec, target)\r\n\r\n\tlevels := computeLevels(spec)\r\n\tordered := make([]string, 0, len(ancestorSet))\r\n\tfor _, names := range levels {\r\n"]
[8965.625737, "o", "\t\tfor _, name := range names {\r\n\t\t\tif ancestorSet[name] {\r\n\t\t\t\tordered = append(ordered, name)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tswitch *format {\r\n\tcase \"text\":\r\n\t\tif len(ordered) > 0 {\r\n\t"]
[8965.625795, "o", "\t\tos.Stdout.WriteString(strings.Join(ordered, \"\\n\") + \"\\n\")\r\n\t\t}\r\n\tcase \"json\":\r\n\t\tout, err := json.Marshal(ordered)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\t"]
[8965.625867, "o", "os.Stdout.Write(out)\r\n\t\tfmt.Println()\r\n\t}\r\n\r\n\treturn 0\r\n}\r\n\r\nfunc computeAncestorSet(spec *Spec, target *Job) map[string]bool {\r\n\tancestors := map[string]bool{}\r\n\tvar visit func(job *Job)\r\n\tvisit = func(job *Job) {\r\n"]
[8965.625926, "o", "\t\tfor _, dep := range job.Deps {\r\n\t\t\tif !ancestors[dep] {\r\n\t\t\t\tancestors[dep] = true\r\n\t\t\t\tvisit(spec.ByName[dep])\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[8965.625981, "o", "\tvisit(target)\r\n\treturn ancestors\r\n}\r\n"]
