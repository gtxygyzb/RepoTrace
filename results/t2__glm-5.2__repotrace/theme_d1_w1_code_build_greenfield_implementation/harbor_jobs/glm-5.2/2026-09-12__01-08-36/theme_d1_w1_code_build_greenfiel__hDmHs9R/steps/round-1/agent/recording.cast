[3281.592406, "o", "package main\r\n\r\nimport (\r\n\"flag\"\r\n\"fmt\"\r\n\"io\"\r\n\"os\"\r\n\"strconv\"\r\n\"strings\"\r\n)\r\n\r\ntype graphEdge struct {\r\ndep  string\r\nname string\r\n}\r\n\r\nfunc runGraph(args []string) int {\r\nfs := flag.NewFlagSet(\"graph\", flag.ContinueOnError)\r\nfs.SetOutput(io.Discard)\r\nspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\nformat := fs.String(\"format\", \"dot\", \"output format: dot|mermaid\")\r\nonly := fs.String(\"only\", \"\", \"comma-separated list of job names\")\r\nif err := fs.Parse(args); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\nreturn 2\r\n}\r\nif *specPath == \"\" {\r\nfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\nreturn 2\r\n}\r\nif len(fs.Args()) > 0 {\r\nfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\nreturn 2\r\n}\r\nif *format != \"dot\" && *format != \"mermaid\" {\r\nfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\nreturn 2\r\n}\r\n\r\nspec, err := loadSpec(*specPath)"]
[3281.592594, "o", "\r\nif err != nil {\r\nprintValidationError(err)\r\nreturn 2\r\n}\r\n\r\nselected, err := parseOnlyFilter(spec, *only)\r\nif err != nil {\r\nprintValidationError(err)\r\nreturn 2\r\n}\r\n\r\njobs, levels := listJobs(spec, selected)\r\nos.Stdout.Write(renderGraph(jobs, levels, *format))\r\nreturn 0\r\n}\r\n\r\nfunc renderGraph(jobs []*Job, level map[string]int, format string) []byte {\r\ninSet := make(map[string]bool, len(jobs))\r\nfor _, job := range jobs {\r\ninSet[job.Name] = true\r\n}\r\n\r\nvar edges []graphEdge\r\nfor _, job := range jobs {\r\nfor _, dep := range job.Deps {\r\nif inSet[dep] {\r\nedges = append(edges, graphEdge{dep: dep, name: job.Name})\r\n}\r\n}\r\n}\r\n\r\nswitch format {\r\ncase \"dot\":\r\nreturn renderDot(jobs, level, edges)\r\ncase \"mermaid\":\r\nreturn renderMermaid(jobs, edges)\r\n}\r\nreturn nil\r\n}\r\n\r\nfunc renderDot(jobs []*Job, level map[string]int, edges []graphEdge) []byte {\r\nvar b strings.Builder\r\nb.WriteString(\"digraph jobforge {\\n\")\r\nb.WriteString(\"\\trankdir=LR;\\n\")\r\nfor _, job := range jobs {\r\nb.WriteString(\"\\t\\\"\")\r\nb.WriteString(dotQuote(job.Name))"]
[3281.592775, "o", "\r\nb.WriteString(\"\\\" [level=\\\"\")\r\nb.WriteString(strconv.Itoa(level[job.Name]))\r\nb.WriteString(\"\\\",workdir=\\\"\")\r\nb.WriteString(dotQuote(job.Workdir))\r\nb.WriteString(\"\\\"];\\n\")\r\n}\r\nfor _, e := range edges {\r\nb.WriteString(\"\\t\\\"\")\r\nb.WriteString(dotQuote(e.dep))\r\nb.WriteString(\"\\\" -> \\\"\")\r\nb.WriteString(dotQuote(e.name))\r\nb.WriteString(\"\\\";\\n\")\r\n}\r\nb.WriteString(\"}\\n\")\r\nreturn []byte(b.String())\r\n}\r\n\r\nfunc renderMermaid(jobs []*Job, edges []graphEdge) []byte {\r\nvar b strings.Builder\r\nb.WriteString(\"graph LR\\n\")\r\nb.WriteString(\"\\t%% nodes=\")\r\nb.WriteString(strconv.Itoa(len(jobs)))\r\nb.WriteString(\" edges=\")\r\nb.WriteString(strconv.Itoa(len(edges)))\r\nb.WriteString(\"\\n\")\r\nfor _, job := range jobs {\r\nb.WriteString(\"\\t\")\r\nb.WriteString(mermaidID(job.Name))\r\nb.WriteString(\"[\\\"\")\r\nb.WriteString(mermaidLabel(job.Name))\r\nb.WriteString(\"\\\"]\\n\")\r\n}\r\nfor _, e := range edges {\r\nb.WriteString(\"\\t\")\r\nb.WriteString(mermaidID(e.dep))\r\nb.WriteString(\" --> \")\r\nb.WriteString(mermaidID(e.name))\r\nb.WriteString(\"\\n\")\r\n}\r\nreturn []byte(b.S"]
[3281.59287, "o", "tring())\r\n}\r\n\r\nfunc dotQuote(s string) string {\r\nvar b strings.Builder\r\nfor i := 0; i < len(s); i++ {\r\nc := s[i]\r\nswitch c {\r\ncase '\"':\r\nb.WriteString(`\\\"`)\r\ncase '\\\\':\r\nb.WriteString(`\\\\`)\r\ndefault:\r\nb.WriteByte(c)\r\n}\r\n}\r\nreturn b.String()\r\n}\r\n\r\nfunc mermaidID(name string) string {\r\nvar b strings.Builder\r\nfor i := 0; i < len(name); i++ {\r\nc := name[i]\r\nif (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' {\r\nb.WriteByte(c)\r\n} else {\r\nb.WriteByte('_')\r\n}\r\n}\r\nreturn b.String()\r\n}\r\n\r\nfunc mermaidLabel(name string) string {\r\nvar b strings.Builder\r\nfor i := 0; i < len(name); i++ {\r\nc := name[i]\r\nif c == '\"' {\r\nb.WriteString(\"#quot;\")\r\n} else {\r\nb.WriteByte(c)\r\n}\r\n}\r\nreturn b.String()\r\n}\r\n"]
