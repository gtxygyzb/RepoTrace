[5803.044719, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"flag\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"io\"\r\n"]
[5803.044922, "o", "     9\t\t\"os\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc main() {\r\n    16\t\tif len(os.Args) < 2 {\r\n    17\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    18\t\t\tos.Exit(2)\r\n    19\t\t}\r\n    20\t\r\n    21\t\tswitch os.Args[1] {\r\n    22\t\tcase \"plan\":\r\n    23\t\t\tos.Exit(runPlan(os.Args[2:]))\r\n    24\t\tcase \"run\":\r\n    25\t\t\tos.Exit(runRun(os.Args[2:]))\r\n    26\t\tcase \"validate\":\r\n    27\t\t\tos.Exit(runValidate(os.Args[2:]))\r\n    28\t\tcase \"list\":\r\n    29\t\t\tos.Exit(runList(os.Args[2:]))\r\n    30\t\tcase \"graph\":\r\n    31\t\t\tos.Exit(runGraph(os.Args[2:]))\r\n    32\t\tcase \"hash\":\r\n    33\t\t\tos.Exit(runHash(os.Args[2:]))\r\n    34\t\tcase \"diff\":\r\n    35\t\t\tos.Exit(runDiff(os.Args[2:]))\r\n    36\t\tdefault:\r\n"]
[5803.045017, "o", "    37\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    38\t\t\tos.Exit(2)\r\n    39\t\t}\r\n    40\t}\r\n    41\t\r\n    42\tfunc runPlan(args []string) int {\r\n    43\t"]
[5803.045095, "o", "\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n    44\t\tfs.SetOutput(os.Stderr)\r\n    45\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    46\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n    47\t\tif err := fs.Parse(args); err != nil {\r\n    48\t\t\treturn 2\r\n    49\t\t}\r\n    50\t\tif *specPath == \"\" {\r\n    51\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n    52\t\t\treturn 2\r\n    53\t\t}\r\n    54\t\tif *format != \"text\" && *format != \"json\" {\r\n    55\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n    56\t\t\treturn 2\r\n    57\t\t}\r\n    58\t\r\n    59\t\tspec, err := loadSpec(*specPath)\r\n"]
[5803.045164, "o", "    60\t\tif err != nil {\r\n    61\t\t\tprintValidationError(err)\r\n    62\t\t\treturn 2\r\n    63\t\t}\r\n    64\t\r\n    65\t\tlevels := computeLevels(spec)\r\n    66\t\tswitch *format {\r\n    67\t\tcase \"text\":\r\n    68\t\t\tfor i, names := range levels {\r\n"]
[5803.045228, "o", "    69\t\t\t\tfmt.Printf(\"level %d: %s\\n\", i, strings.Join(names, \", \"))\r\n    70\t\t\t}\r\n    71\t\tcase \"json\":\r\n    72\t\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n    73\t\t\tif err != nil {\r\n    74\t\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n    75\t\t\t\treturn 2\r\n    76\t\t\t}\r\n    77\t\t\tos.Stdout.Write(out)\r\n"]
[5803.045295, "o", "    78\t\t\tfmt.Println()\r\n    79\t\t}\r\n    80\t\treturn 0\r\n    81\t}\r\n    82\t\r\n    83\tfunc runRun(args []string) int {\r\n    84\t\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n    85\t\tfs.SetOutput(os.Stderr)\r\n    86\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    87\t\tonFailure := fs.String(\"on-failure\", \"stop\", \"on failure behavior: stop|continue\")\r\n"]
[5803.045388, "o", "    88\t\tresultsPath := fs.String(\"results\", \"\", \"path to results JSON file\")\r\n    89\t\tif err := fs.Parse(args); err != nil {\r\n    90\t\t\treturn 2\r\n    91\t\t}\r\n    92\t\tif *specPath == \"\" {\r\n    93\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]\")\r\n    94\t\t\treturn 2\r\n    95\t\t}\r\n    96\t\tif *onFailure != \"stop\" && *onFailure != \"continue\" {\r\n    97\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid on-failure: %s\\n\", *onFailure)\r\n    98\t\t"]
[5803.045476, "o", "\treturn 2\r\n    99\t\t}\r\n   100\t\r\n   101\t\tspec, err := loadSpec(*specPath)\r\n   102\t\tif err != nil {\r\n   103\t\t\tprintValidationError(err)\r\n   104\t\t\treturn 2\r\n   105\t\t}\r\n   106\t\r\n   107\t\treturn runSpec(spec, *onFailure, *resultsPath)\r\n   108\t}\r\n   109\t\r\n   110\tfunc runValidate(args []string) int {\r\n   111\t\tfs := flag.NewFlagSet(\"validate\", flag.ContinueOnError)\r\n"]
[5803.045563, "o", "   112\t\tfs.SetOutput(io.Discard)\r\n   113\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n   114\t\tif err := fs.Parse(args); err != nil {\r\n   115\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   116\t\t\treturn 2\r\n   117\t\t}\r\n   118\t\tif *specPath == \"\" {\r\n   119\t\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n   120\t\t\treturn 2\r\n"]
