[4763.97206, "o", "\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[Kcompute\u001b[01;31m\u001b[KLevel\u001b[m\u001b[Ks(spec *\u001b[01;31m\u001b[KSpec\u001b[m\u001b[K) [][]string {\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar dfs func(job *\u001b[01;31m\u001b[KJob\u001b[m\u001b[K) int\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tdfs = func(job *\u001b[01;31m\u001b[KJob\u001b[m\u001b[K) int {\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tl := dfs(spec.\u001b[01;31m\u001b[KByName\u001b[m\u001b[K[dep])\r\n\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, job := range spec.\u001b[01;31m\u001b[KJobs\u001b[m\u001b[K {\r\n"]
[4763.972147, "o", "\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmax\u001b[01;31m\u001b[KLevel\u001b[m\u001b[K := -1\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif l > max\u001b[01;31m\u001b[KLevel\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tmax\u001b[01;31m\u001b[KLevel\u001b[m\u001b[K = l\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t"]
[4763.972206, "o", "levels := make([][]string, max\u001b[01;31m\u001b[KLevel\u001b[m\u001b[K+1)\r\n\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, job := range spec.\u001b[01;31m\u001b[KJobs\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Ksort\u001b[m\u001b[K.Strings(names)\r\n"]
