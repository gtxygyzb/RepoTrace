[5124.633505, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"flag\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"io\"\r\n"]
[5124.633602, "o", "     7\t\t\"os\"\r\n     8\t\t\"strconv\"\r\n     9\t\t\"strings\"\r\n    10\t)\r\n    11\t\r\n    12\ttype graphEdge struct {\r\n    13\t\tdep  string\r\n    14\t\tname string\r\n    15\t}\r\n    16\t\r\n    17\tfunc runGraph(args []string) int {\r\n    18\t\tfs := flag.NewFlagSet(\"graph\", flag.ContinueOnError)\r\n    19\t\tfs.SetOutput(io.Discard)\r\n    20\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    21\t\tformat := fs.String(\"format\", \"dot\", \"output format: dot|mermaid\")\r\n"]
[5124.633674, "o", "    22\t\tonly := fs.String(\"only\", \"\", \"comma-separated list of job names\")\r\n    23\t\tif err := fs.Parse(args); err != nil {\r\n    24\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n    25\t\t\treturn 2\r\n    26\t\t}\r\n    27\t\tif *specPath == \"\" {\r\n    28\t\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n    29\t\t\treturn 2\r\n"]
[5124.63373, "o", "    30\t\t}\r\n    31\t\tif len(fs.Args()) > 0 {\r\n"]
[5124.633783, "o", "    32\t\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n    33\t\t\treturn 2\r\n    34\t\t}\r\n    35\t\tif *format != \"dot\" && *format != \"mermaid\" {\r\n    36\t\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n    37\t\t\treturn 2\r\n    38\t\t}\r\n    39\t\r\n    40\t\tspec, err := loadSpec(*specPath)\r\n    41\t\tif err != nil {\r\n"]
[5124.633841, "o", "    42\t\t\tprintValidationError(err)\r\n    43\t\t\treturn 2\r\n    44\t\t}\r\n    45\t\r\n    46\t\tselected, err := parseOnlyFilter(spec, *only)\r\n    47\t\tif err != nil {\r\n    48\t\t\tprintValidationError(err)\r\n    49\t\t\treturn 2\r\n    50\t\t}\r\n"]
[5124.633897, "o", "    51\t\r\n    52\t\tjobs, levels := listJobs(spec, selected)\r\n    53\t\tos.Stdout.Write(renderGraph(jobs, levels, *format))\r\n    54\t\treturn 0\r\n    55\t}\r\n    56\t\r\n    57\tfunc renderGraph(jobs []*Job, level map[string]int, format string) []byte {\r\n    58\t\tinSet := make(map[string]bool, len(jobs))\r\n    59\t\tfor _, job := range jobs {\r\n    60\t\t\tinSet[job.Name] = true\r\n    61\t\t}\r\n    62\t\r\n    63\t\tvar edges []graphEdge\r\n"]
[5124.633949, "o", "    64\t\tfor _, job := range jobs {\r\n    65\t\t\tfor _, dep := range job.Deps {\r\n"]
[5124.63398, "o", "    66\t\t\t\tif inSet[dep] {\r\n    67\t\t\t\t\tedges = append(edges, graphEdge{dep: dep, name: job.Name})\r\n    68\t\t\t\t}\r\n    69\t\t\t}\r\n    70\t\t}\r\n    71\t\r\n    72\t\tswitch format {\r\n"]
[5124.634051, "o", "    73\t\tcase \"dot\":\r\n    74\t\t\treturn renderDot(jobs, level, edges)\r\n    75\t\tcase \"mermaid\":\r\n    76\t\t\treturn renderMermaid(jobs, edges)\r\n    77\t\t}\r\n    78\t\treturn nil\r\n    79\t}\r\n    80\t\r\n    81\tfunc renderDot(jobs []*Job, level map[string]int, edges []graphEdge) []byte {\r\n    82\t\tvar b strings.Builder\r\n    83\t\tb.WriteString(\"digraph jobforge {\\n\")\r\n"]
[5124.634107, "o", "    84\t\tb.WriteString(\"\\trankdir=LR;\\n\")\r\n    85\t\tfor _, job := range jobs {\r\n    86\t\t\tb.WriteString(\"\\t\\\"\")\r\n"]
[5124.634161, "o", "    87\t\t\tb.WriteString(dotQuote(job.Name))\r\n    88\t\t\tb.WriteString(\"\\\" [level=\\\"\")\r\n    89\t\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n    90\t\t\tb.WriteString(\"\\\" workdir=\\\"\")\r\n    91\t\t\tb.WriteString(dotQuote(job.Workdir))\r\n    92\t\t\tb.WriteString(\"\\\"];\\n\")\r\n    93\t\t}\r\n    94\t\tfor _, e := range edges {\r\n    95\t\t\tb.WriteString(\"\\t\\\"\")\r\n    96\t\t\tb.WriteString(dotQuote(e.dep))\r\n"]
[5124.634216, "o", "    97\t\t\tb.WriteString(\"\\\" -> \\\"\")\r\n    98\t\t\tb.WriteString(dotQuote(e.name))\r\n    99\t\t\tb.WriteString(\"\\\";\\n\")\r\n   100\t\t}\r\n   101\t\tb.WriteString(\"}\\n\")\r\n   102\t\treturn []byte(b.String())\r\n   103\t}\r\n   104\t\r\n"]
[5124.634242, "o", "   105\tfunc renderMermaid(jobs []*Job, edges []graphEdge) []byte {\r\n   106\t\tvar b strings.Builder\r\n   107\t\tb.WriteString(\"graph LR\\n\")\r\n   108\t\tb.WriteString(\"\\t%% nodes=\")\r\n   109\t\tb.WriteString(strconv.Itoa(len(jobs)))\r\n   110\t\tb.WriteString(\" edges=\")\r\n   111\t\tb.WriteString(strconv.Itoa(len(edges)))\r\n   112\t\tb.WriteString(\"\\n\")\r\n"]
[5124.634311, "o", "   113\t\tfor _, job := range jobs {\r\n   114\t\t\tb.WriteString(\"\\t\")\r\n   115\t\t\tb.WriteString(mermaidID(job.Name))\r\n   116\t\t\tb.WriteString(\"[\\\"\")\r\n   117\t\t\tb.WriteString(mermaidLabel(job.Name))\r\n   118\t\t\tb.WriteString(\"\\\"]\\n\")\r\n   119\t\t}\r\n   120\t\tfor _, e := range edges {\r\n   121\t\t\tb.WriteString(\"\\t\")\r\n   122\t\t\tb.WriteString(mermaidID(e.dep))\r\n"]
[5124.634362, "o", "   123\t\t\tb.WriteString(\" --> \")\r\n   124\t\t\tb.WriteString(mermaidID(e.name))\r\n   125\t\t\t"]
[5124.634424, "o", "b.WriteString(\"\\n\")\r\n   126\t\t}\r\n   127\t\treturn []byte(b.String())\r\n   128\t}\r\n   129\t\r\n   130\tfunc dotQuote(s string) string {\r\n   131\t\tvar b strings.Builder\r\n   132\t\tfor i := 0; i < len(s); i++ {\r\n   133\t\t\tc := s[i]\r\n   134\t\t"]
[5124.634485, "o", "\tswitch c {\r\n   135\t\t\tcase '\"':\r\n   136\t\t\t\tb.WriteString(`\\\"`)\r\n   137\t\t\tcase '\\\\':\r\n   138\t\t\t\tb.WriteString(`\\\\`)\r\n   139\t\t\tdefault:\r\n   140\t\t\t\tb.WriteByte(c)\r\n   141\t\t\t}\r\n   142\t\t}\r\n   143\t\treturn b.String()\r\n"]
[5124.63454, "o", "   144\t}\r\n   145\t\r\n   146\tfunc mermaidID(name string) string {\r\n   147\t\tvar b strings.Builder\r\n   148\t\tfor i := 0; i < len(name); i++ {\r\n   149\t\t\tc := name[i]\r\n   150\t\t\tif (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' {\r\n   151\t\t\t\tb.WriteByte(c)\r\n   152\t\t\t} else {\r\n"]
[5124.634598, "o", "   153\t\t\t\tb.WriteByte('_')\r\n   154\t\t\t}\r\n   155\t\t}\r\n   156\t\treturn b.String()\r\n   157\t}\r\n   158\t\r\n   159\tfunc mermaidLabel(name string) string {\r\n   160\t\tvar b strings.Builder\r\n   161\t\tfor i := 0; i < len(name); i++ {\r\n   162\t\t\tc := name[i]\r\n   163\t\t\tif c == '\"' {\r\n   164\t\t\t\tb.WriteString(\"#quot;\")\r\n   165\t\t\t} else {\r\n   166\t\t\t\tb.WriteByte(c)\r\n"]
[5124.63465, "o", "   167\t\t\t}\r\n   168\t\t}\r\n   169\t\treturn b.String()\r\n   170"]
[5124.634705, "o", "\t}\r\n"]
