[5173.377681, "o", "\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc computeLevels\u001b[m\u001b[K(spec *Spec) [][]string {\r\n\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tlevel := map[string]int{}\r\n\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar dfs func(job *Job) int\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdfs = func(job *Job) int {\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif l, ok := level[job.Name]; ok {\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn l\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tmaxDep := -1\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor _, dep := range job.Deps {\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tl := dfs(spec.ByName[dep])\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t"]
[5173.377777, "o", "\t\tif l > maxDep {\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tmaxDep = l\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tlevel[job.Name] = maxDep + 1\r\n\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn level[job.Name]\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, job := range spec.Jobs {\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tdfs(job)\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[5173.377945, "o", "\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmaxLevel := -1\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, l := range level {\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif l > maxLevel {\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tmaxLevel = l\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[5173.378046, "o", "\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tlevels := make([][]string, maxLevel+1)\r\n"]
