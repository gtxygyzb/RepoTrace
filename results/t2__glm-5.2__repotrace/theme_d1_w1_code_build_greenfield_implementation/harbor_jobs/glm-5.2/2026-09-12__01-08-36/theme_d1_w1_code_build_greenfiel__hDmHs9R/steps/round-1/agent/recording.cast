[2998.560908, "o", "package main\r\n\r\nimport (\r\n\t\"sort\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc detectCycle(spec *Spec) *ValidationError {\r\n\tadj := map[string][]string{}\r\n\tfor _, job := range spec.Jobs {\r\n\t\tdeps := append([]string(nil), job.Deps...)\r\n\t\tsort.Strings(deps)\r\n\t\tadj[job.Name] = deps\r\n\t}\r\n\r\n\tindex := 0\r\n\tstack := []string{}\r\n\tonStack := map[string]bool{}\r\n\tindices := map[string]int{}\r\n\tlow := map[string]int{}\r\n\tvar sccs [][]string\r\n\r\n\tvar strongconnect func(v string)\r\n\tstrongconnect = func(v string) {\r\n\t\tindices[v] = index\r\n\t\tlow[v] = index\r\n\t\tindex++\r\n\t\tstack = append(stack, v)\r\n\t\tonStack[v] = true"]
[2998.561026, "o", "\r\n\r\n\t\tfor _, w := range adj[v] {\r\n\t\t\tif _, ok := indices[w]; !ok {\r\n\t\t\t\tstrongconnect(w)\r\n\t\t\t\tif low[w] < low[v] {\r\n\t\t\t\t\tlow[v] = low[w]\r\n\t\t\t\t}\r\n\t\t\t} else if onStack[w] {\r\n\t\t\t\tif indices[w] < low[v] {\r\n\t\t\t\t\tlow[v] = indices[w]\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif low[v] == indices[v] {\r\n\t\t\tvar scc []string\r\n\t\t\tfor {\r\n\t\t\t\tw := stack[len(stack)-1]\r\n\t\t\t\tstack = stack[:len(stack)-1]\r\n\t\t\t\tonStack[w] = false\r\n\t\t\t\tscc = append(scc, w)\r\n\t\t\t\tif w == v {\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tsccs = append(sccs, scc)\r\n\t\t}\r\n\t}\r\n\r\n\tnames := make([]string, 0, len(spec.Jobs))\r\n\tfor _, job := range spec.Jobs {\r\n\t\tnames = append(names, job.Name)\r\n\t}\r\n\tsort.Strings(names)\r\n\tfor _, name := range names {\r\n\t\tif _, ok := indices[name]; !ok {\r\n\t\t\tstrongconnect(name)\r\n\t\t}\r\n"]
[2998.561169, "o", "\t}\r\n\r\n\tcyclicSCC := map[string]bool{}\r\n\tvar start string\r\n\tfor _, scc := range sccs {\r\n\t\tif len(scc) > 1 {\r\n\t\t\tsorted := append([]string(nil), scc...)\r\n\t\t\tsort.Strings(sorted)\r\n\t\t\tfor _, n := range sorted {\r\n\t\t\t\tcyclicSCC[n] = true\r\n\t\t\t}\r\n\t\t\tif start == \"\" || sorted[0] < start {\r\n\t\t\t\tstart = sorted[0]\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif start == \"\" {\r\n\t\treturn nil\r\n\t}\r\n\r\n\tinStartSCC := map[string]bool{}\r\n\tfor _, scc := range sccs {\r\n\t\tif len(scc) > 1 {\r\n\t\t\tfor _, n := range scc {\r\n\t\t\t\tif n == start {\r\n\t\t\t\t\tfor _, n2 := range scc {\r\n\t\t\t\t\t\tinStartSCC[n2] = true\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tpath := findCyclePath(start, adj, inStartSCC)\r\n\treturn &ValidationError{Code: \"cycle\", Message: path}\r\n}\r\n\r\nfunc findCyclePath(start string, adj map[string][]string, inSCC map[string]bool) string {\r\n\tpath := []string{start}\r\n\tvisited := map"]
[2998.56124, "o", "[string]bool{}\r\n\r\n\tvar dfs func() bool\r\n\tdfs = func() bool {\r\n\t\tcur := path[len(path)-1]\r\n\t\tfor _, next := range adj[cur] {\r\n\t\t\tif !inSCC[next] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif next == start {\r\n\t\t\t\tpath = append(path, start)\r\n\t\t\t\treturn true\r\n\t\t\t}\r\n\t\t\tif visited[next] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvisited[next] = true\r\n\t\t\t"]
[2998.5613, "o", "path = append(path, next)\r\n\t\t\tif dfs() {\r\n\t\t\t\treturn true\r\n\t\t\t}\r\n\t\t\tpath = path[:len(path)-1]\r\n\t\t\tdelete(visited, next)\r\n\t\t}\r\n\t\treturn false\r\n\t}\r\n\r\n\tif dfs() {\r\n\t\treturn strings.Join(path, \" -> \")\r\n\t}\r\n\treturn start\r\n}\r\n"]
