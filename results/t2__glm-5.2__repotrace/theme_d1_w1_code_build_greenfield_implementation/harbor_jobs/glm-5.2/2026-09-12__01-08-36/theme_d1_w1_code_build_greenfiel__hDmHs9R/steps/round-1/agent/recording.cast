[1662.405273, "o", "package main\r\n\r\nimport (\r\n\"sort\"\r\n\"strings\"\r\n)\r\n\r\n"]
[1662.405341, "o", "func detectCycle(spec *Spec) *ValidationError {\r\nadj := map[string][]string{}\r\nfor _, job := range spec.Jobs {\r\ndeps := append([]string(nil), job.Deps...)\r\nsort.Strings(deps)\r\nadj[job.Name] = deps\r\n}\r\n\r\nindex := 0\r\nstack := []string{}\r\nonStack := map[string]bool{}\r\nindices := map[string]int{}\r\nlow := map[string]int{}\r\nvar sccs [][]string\r\n"]
[1662.405401, "o", "\r\nvar strongconnect func(v string)\r\nstrongconnect = func(v string) {\r\nindices[v] = index\r\nlow[v] = index\r\nindex++\r\nstack = append(stack, v)\r\nonStack[v] = true\r\n\r\nfor _, w := range adj[v] {\r\nif _, ok := indices[w]; !ok {\r\n"]
[1662.405458, "o", "strongconnect(w)\r\nif low[w] < low[v] {\r\nlow[v] = low[w]\r\n}\r\n} else if onStack[w] {\r\nif indices[w] < low[v] {\r\nlow[v] = indices[w]\r\n}\r\n}\r\n}\r\n\r\nif low[v] == indices[v] {\r\nvar scc []string\r\n"]
[1662.405525, "o", "for {\r\nw := stack[len(stack)-1]\r\nstack = stack[:len(stack)-1]\r\nonStack[w] = false\r\nscc = append(scc, w)\r\nif w == v {\r\nbreak\r\n"]
[1662.405584, "o", "}\r\n}\r\nsccs = append(sccs, scc)\r\n}\r\n}\r\n\r\nnames := make([]string, 0, len(spec.Jobs))\r\nfor _, job := range spec.Jobs {\r\nnames = append(names, job.Name)\r\n}\r\nsort.Strings(names)\r\nfor _, name := range names {\r\nif _, ok := indices[name]; !ok {\r\nstrongconnect(name)\r\n}\r\n}\r\n\r\ncyclicSCC := map[string]bool{}\r\nvar start string\r\nfor _, scc := range sccs {\r\n"]
[1662.405643, "o", "if len(scc) > 1 {\r\nsorted := append([]string(nil), scc...)\r\nsort.Strings(sorted)\r\nfor _, n := range sorted {\r\n"]
[1662.405701, "o", "cyclicSCC[n] = true\r\n}\r\nif start == \"\" || sorted[0] < start {\r\nstart = sorted[0]\r\n}\r\n}\r\n}\r\n\r\nif start == \"\" {\r\nreturn nil\r\n}\r\n\r\ninStartSCC := map[string]bool{}\r\nfor _, scc := range sccs {\r\nif len(scc) > 1 {\r\nfor _, n := range scc {\r\nif n == start {\r\n"]
[1662.405766, "o", "for _, n2 := range scc {\r\ninStartSCC[n2] = true\r\n}\r\nbreak\r\n}\r\n}\r\n}\r\n}\r\n\r\npath := findCyclePath(start, adj, inStartSCC)\r\nreturn &ValidationError{Code: \"cycle\", Message: path}\r\n}\r\n\r\nfunc findCyclePath(start string, adj map[string][]string, inSCC map[string]bool) string {\r\n"]
[1662.405807, "o", "path := []string{start}\r\nvisited := map[string]bool{}\r\n\r\nvar dfs func() bool\r\ndfs = func() bool {\r\ncur := path[len(path)-1]\r\nfor _, next := range adj[cur] {\r\nif !inSCC[next] {\r\ncontinue\r\n}\r\n"]
[1662.405894, "o", "if next == start {\r\npath = append(path, start)\r\nreturn true\r\n}\r\nif visited[next] {\r\ncontinue\r\n}\r\nvisited[next] = true\r\npath = append(path, next)\r\nif dfs() {\r\nreturn true\r\n}\r\npath = path[:len(path)-1]\r\ndelete(visited, next)\r\n}\r\nreturn false\r\n"]
[1662.405955, "o", "}\r\n\r\nif dfs() {\r\nreturn strings.Join(path, \" -> \")\r\n}\r\nreturn start\r\n}\r\n"]
