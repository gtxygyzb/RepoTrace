[2122.097238, "o", "\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"syscall\"\r\n)\r\n\r\ntype jobResult struct {\r\n\tName     string\r\n\tStatus   string\r\n\tExitCode int\r\n\tStdout   string\r\n\tStderr   string\r\n}\r\n\r\nfunc runSpec(spec *Spec, onFailure string, resultsPath string) int {\r\n\tlevels := computeLevels(spec)\r\n\torder := make([]*Job, 0, len(spec.Jobs))\r\n\tfor _, names := range levels {\r\n\t\tfor _, name := range names {\r\n\t\t\torder = append(order, spec.ByName[name])\r\n"]
[2122.097331, "o", "\t\t}\r\n\t}\r\n\r\n\tresults := make([]jobResult, len(order))\r\n\tstatuses := map[string]string{}\r\n\tshortCircuit := false\r\n\r\n\tfor i, job := range order {\r\n\t\tresults[i].Name = job.Name\r\n\r\n\t\tif shortCircuit {\r\n"]
[2122.097411, "o", "\t\t\tresults[i].Status = \"skipped\"\r\n\t\t\tresults[i].ExitCode = -1\r\n\t\t\tresults[i].Stdout = \"\"\r\n\t\t\tresults[i].Stderr = \"\"\r\n\t\t\tstatuses[job.Name] = \"skipped\"\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tskip := false\r\n\t\tfor _, dep := range job.Deps {\r\n\t\t\tif statuses[dep] != \"ok\" {\r\n\t\t\t\tskip = true\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif skip {\r\n\t\t"]
[2122.097493, "o", "\tresults[i].Status = \"skipped\"\r\n\t\t\tresults[i].ExitCode = -1\r\n\t\t\tresults[i].Stdout = \"\"\r\n\t\t\tresults[i].Stderr = \"\"\r\n\t\t\tstatuses[job.Name] = \"skipped\"\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tstdout, stderr, exitCode := runJob(job)\r\n\t\tresults[i].Stdout = stdout\r\n\t\tresults[i].Stderr = stderr\r\n\t\tresults[i].ExitCode = exitCode\r\n"]
[2122.09757, "o", "\r\n\t\tif exitCode == 0 {\r\n\t\t\tresults[i].Status = \"ok\"\r\n\t\t\tstatuses[job.Name] = \"ok\"\r\n\t\t} else {\r\n\t\t\tresults[i].Status = \"failed\"\r\n\t\t\tstatuses[job.Name] = \"failed\"\r\n\t\t\tif onFailure == \"stop\" {\r\n\t\t\t\tshortCircuit = true\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif resultsPath != \"\" {\r\n\t\tif err := writeResults(resultsPath, onFailure, results); err != nil {\r\n"]
