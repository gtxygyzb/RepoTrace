[8176.957563, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n"]
[8176.957643, "o", "     6\t\t\"os\"\r\n     7\t\t\"regexp\"\r\n     8\t\t\"sort\"\r\n     9\t)\r\n    10\t\r\n    11\ttype Job struct {\r\n    12\t\tIndex   int\r\n    13\t\tName    string\r\n    14\t\tCommand string\r\n    15\t\tDeps    []string\r\n    16\t\tWorkdir string\r\n    17\t\tEnv     map[string]string\r\n"]
[8176.957708, "o", "    18\t}\r\n    19\t\r\n    20\ttype Spec struct {\r\n    21\t\tJobs   []*Job\r\n    22\t\tByName map[string]*Job\r\n    23\t}\r\n    24\t\r\n    25\ttype ValidationError struct {\r\n    26\t\tCode    string"]
[8176.957776, "o", "\r\n    27\t\tMessage string\r\n    28\t}\r\n    29\t\r\n    30\tfunc (e *ValidationError) Error() string {\r\n"]
[8176.957869, "o", "    31\t\treturn e.Code + \": \" + e.Message\r\n    32\t}\r\n    33\t\r\n    34\tvar (\r\n    35\t\tnameRegexp   = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_-]*$`)\r\n    36\t\tenvKeyRegexp = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)\r\n    37\t)\r\n    38\t\r\n    39\tfunc loadSpec(path string) (*Spec, error) {\r\n    40\t\tdata, err := os.ReadFile(path)\r\n    41\t\tif err != nil {\r\n    42\t\t\treturn nil, &ValidationError{Code: \"spec_not_found\", Message: fmt.Sprintf(\"cannot read spec: %s\", path)}\r\n    43\t\t}\r\n    44\t\r\n"]
[8176.957938, "o", "    45\t\tvar top map[string]json.RawMessage\r\n    46\t\tif err := json.Unmarshal(data, &top); err != nil || top == nil {\r\n    47\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"top-level JSON must be an object\"}\r\n    48\t\t}\r\n    49\t\r\n    50\t\trawJobs, ok := top[\"jobs\"]\r\n    51\t\tif !ok {\r\n    52\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"missing jobs\"}\r\n    53\t\t}\r\n    54\t\r\n    55\t\tvar jobsRaw []json.RawMessage\r\n    56\t\t"]
[8176.958002, "o", "if err := json.Unmarshal(rawJobs, &jobsRaw); err != nil || jobsRaw == nil {\r\n    57\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"jobs must be an array\"}\r\n    58\t\t}\r\n    59\t\r\n    60\t\tvar unknownTop []string\r\n    61\t\tfor k := range top {\r\n    62\t\t\tif k != \"jobs\" {\r\n    63\t\t\t\tunknownTop = append(unknownTop, k)\r\n    64\t\t\t}\r\n    65"]
[8176.958067, "o", "\t\t}\r\n    66\t\tif len(unknownTop) > 0 {\r\n    67\t\t\tsort.Strings(unknownTop)\r\n    68\t\t\treturn nil, &ValidationError{Code: \"unknown_field\", Message: \"unknown field: \" + unknownTop[0]}\r\n    69\t\t}\r\n    70\t\r\n    71\t\tjobMaps := make([]map[string]json.RawMessage, len(jobsRaw))\r\n    72\t\tfor i, raw := range jobsRaw {\r\n    73\t\t\tvar m map[string]json.RawMessage\r\n"]
[8176.958127, "o", "    74\t\t\tif err := json.Unmarshal(raw, &m); err != nil || m == nil {\r\n    75\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d] must be an object\", i)}\r\n    76\t\t\t}\r\n    77\t\t\tjobMaps[i] = m\r\n    78\t\t}\r\n    79\t\r\n    80\t\tjobs := make([]*Job, len(jobMaps))\r\n    81\t\tfor i, m := range jobMaps {\r\n    82\t\t\tjob := &Job{\r\n"]
[8176.958184, "o", "    83\t\t\t\tIndex:   i,\r\n    84\t\t\t\tDeps:    []string{},\r\n    85\t\t\t\tEnv:     map[string]string{},\r\n    86\t\t\t\tWorkdir: \"/app\",\r\n    87\t\t\t}\r\n    88\t\r\n    89\t\t\tif raw, ok := m[\"name\"]; ok {\r\n    90\t\t\t\tvar s string\r\n"]
[8176.958265, "o", "    91\t\t\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n    92\t\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].name must be a string\", i)}\r\n    93\t\t\t\t}\r\n    94\t\t\t\tjob.Name = s\r\n    95\t\t\t}\r\n    96\t\t\tif raw, ok := m[\"command\"]; ok {\r\n    97\t\t\t\tvar s string\r\n    98\t\t\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n"]
[8176.958338, "o", "    99\t\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].command must be a string\", i)}\r\n   100\t\t\t\t}\r\n   101\t\t\t\tjob.Command = s\r\n   102\t\t\t}\r\n   103\t\t\tif raw, ok := m[\"deps\"]; ok {\r\n   104\t\t\t\tvar arr []string\r\n   105\t\t\t\tif err := json.Unmarshal(raw, &arr); err != nil || arr == nil {\r\n   106\t\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].deps must be an array of strings\", i)}\r\n   107\t\t\t\t}\r\n   108\t\t\t\tjob.Deps = arr\r\n"]
[8176.958451, "o", "   109\t\t\t}\r\n   110\t\t\tif raw, ok := m[\"workdir\"]; ok {\r\n   111\t\t\t\tvar s string\r\n   112\t\t\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n   113\t\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].workdir must be a string\", i)}\r\n   114\t\t\t\t}\r\n   115\t\t\t\tjob.Workdir = s\r\n   116\t\t\t}\r\n   117\t\t\tif raw, ok := m[\"env\"]; ok {\r\n   118\t\t\t\tenv := map[string]string{}\r\n   119\t\t\t\tif err := json.Unmarshal(raw, &env); err != nil || env == nil {\r\n   120\t\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].env must be an object of strings\", i)}\r\n   121\t\t\t\t"]
[8176.958582, "o", "}\r\n   122\t\t\t\tjob.Env = env\r\n   123\t\t\t}\r\n   124\t\t\tjobs[i] = job\r\n   125\t\t}\r\n   126\t\r\n   127\t\tfor i, m := range jobMaps {\r\n   128\t\t\tvar unknown []string\r\n   129\t\t\tfor k := range m {\r\n   130\t\t\t\tif !isKnownJobField(k) {\r\n   131\t\t\t\t\tunknown = append(unknown, k)\r\n   132\t\t\t\t}\r\n   133\t\t\t}\r\n   134\t\t\tif len(unknown) > 0 {\r\n   135\t\t\t\tsort.Strings(unknown)\r\n   136\t\t\t\treturn nil, &ValidationError{Code: \"unknown_field\", Message: fmt.Sprintf(\"unknown field: jobs[%d].%s\", i, unknown[0])}\r\n   137\t\t\t}\r\n   138\t\t}\r\n   139\t\r\n   140\t\tfor _, job := range jobs {\r\n"]
