[6094.915625, "i", "sed -n '1,220p' cmd/jobforge/schedule.go\n"]
[6094.916002, "o", "sed -n '1,220p' cmd/jobforge/schedule.go\r\n"]
[6094.916109, "o", "\u001b[?2004l\r"]
[6094.919183, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"flag\"\r\n\t\"fmt\""]
[6094.919278, "o", "\r\n\t\"os\"\r\n\t\"strconv\"\r\n)\r\n\r\ntype scheduleAssignment struct {\r\n\tName   string `json:\"name\"`\r\n\tWorker int    `json:\"worker\"`\r\n\tStart  int    `json:\"start\"`\r\n\tEnd    int    `json:\"end\"`\r\n}\r\n\r\nfunc runSchedule(args []string) int {\r\n\tfs := flag.NewFlagSet(\"schedule\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tworkersStr := fs.String(\"workers\", \"\", \"number of worker lanes\")\r\n\t"]
[6094.919355, "o", "format := fs.String(\"format\", \"text\", \"output format: text|json\")\r\n\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\r\n\tif *specPath == \"\" {\r\n"]
[6094.919389, "o", "\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tif *workersStr == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --workers required\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tworkers, ok := parseWorkers(*workersStr)\r\n\tif !ok {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --workers\")\r\n\t\treturn 2\r\n"]
[6094.919482, "o", "\t}\r\n\r\n\tif *format != \"text\" && *format != \"json\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n\t"]
[6094.919545, "o", "\treturn 2\r\n\t}\r\n\r\n\tif len(fs.Args()) > 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tassignments, makespan := computeSchedule(spec, workers)\r\n\tswitch *format {\r\n\tcase \"text\":\r\n\t\tos.Stdout.Write(renderScheduleText(makespan, assignments))\r\n\tcase \"json\":\r\n\t\tos.Stdout.Write(renderScheduleJSON(workers, makespan, assignments))"]
[6094.91961, "o", "\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc parseWorkers(s string) (int, bool) {\r\n\tif s == \"\" || s[0] < '1' || s[0] > '9' {\r\n\t\treturn 0, false\r\n\t}\r\n\tfor i := 1; i < len(s); i++ {\r\n\t\tif s[i] < '0' || s[i] > '9' {\r\n\t\t\t"]
[6094.919671, "o", "return 0, false\r\n\t\t}\r\n\t}\r\n\r\n\tn := 0\r\n\tfor i := 0; i < len(s); i++ {\r\n\t\tn = n*10 + int(s[i]-'0')\r\n\t}\r\n\treturn n, true\r\n}\r\n\r\n"]
[6094.919734, "o", "func computeSchedule(spec *Spec, workers int) ([]scheduleAssignment, int) {\r\n\tlevels := computeLevels(spec)\r\n\tbusyUntil := make([]int, workers)\r\n\tendTime := make(map[string]int, len(spec.Jobs))\r\n\r\n\tassignments := make([]scheduleAssignment, 0, len(spec.Jobs))\r\n\tmakespan := 0\r\n\r\n\tfor _, names := range levels {\r\n\t\tfor _, name := range names {\r\n\t\t\tjob := spec.ByName[name]\r\n\r\n"]
[6094.91981, "o", "\t\t\tearliest := 0\r\n\t\t\tfor _, dep := range job.Deps {\r\n\t\t\t\tif end := endTime[dep]; end > earliest {\r\n\t\t\t\t\tearliest = end\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\tworker := -1\r\n\t\t\tfor w := 0; w < workers; w++ {\r\n\t\t\t\tif busyUntil[w] <= earliest {\r\n"]
[6094.919914, "o", "\t\t\t\t\tworker = w\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t\tif worker == -1 || busyUntil[w] < busyUntil[worker] {\r\n\t\t\t\t\tworker = w\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif worker == -1 {\r\n\t\t\t\tworker = 0\r\n\t\t\t}\r\n\t\t\tif busyUntil[worker] > earliest {\r\n\t\t"]
[6094.920015, "o", "\t\tearliest = busyUntil[worker]\r\n\t\t\t}\r\n\r\n\t\t\tstart := earliest\r\n\t\t\tend := start + 1\r\n\t\t\tbusyUntil[worker] = end\r\n\t\t\tendTime[name] = end\r\n\r\n\t\t\tassignments = append(assignments, scheduleAssignment{\r\n\t\t\t\tName:   name,\r\n\t\t\t\tWorker: worker,\r\n\t\t\t\tStart:  start,\r\n\t\t\t\tEnd:    end,\r\n\t\t\t})\r\n\r\n\t\t\tif end > makespan {\r\n"]
[6094.920089, "o", "\t\t\t\tmakespan = end\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\treturn assignments, makespan\r\n}\r\n\r\n"]
[6094.920155, "o", "func renderScheduleText(makespan int, assignments []scheduleAssignment) []byte {\r\n\tvar b bytes.Buffer\r\n\tb.WriteString(\"makespan=\")\r\n\tb.WriteString(strconv.Itoa(makespan))\r\n\tb.WriteByte('\\n')\r\n\tfor _, a := range assignments {\r\n\t\tb.WriteString(a.Name)\r\n\t\tb.WriteString(\"\\tworker=\")\r\n\t\tb.WriteString(strconv.Itoa(a.Worker))\r\n\t\tb.WriteString(\"\\tstart=\")\r\n\t\tb.WriteString(strconv.Itoa(a.Start))\r\n\t\tb.WriteString(\"\\tend=\")\r\n\t\tb.WriteString(strconv.Itoa(a.End))\r\n"]
[6094.920226, "o", "\t\tb.WriteByte('\\n')\r\n\t}\r\n\treturn b.Bytes()\r\n}\r\n\r\nfunc renderScheduleJSON(workers, makespan int, assignments []scheduleAssignment) []byte {\r\n\tvar b bytes.Buffer\r\n\tb.WriteString(`{\"workers\":`)\r\n\tb.WriteString(strconv.Itoa(workers))\r\n\tb.WriteString(`,\"makespan\":`)\r\n\tb.WriteString(strconv.Itoa(makespan))\r\n\t"]
[6094.920431, "o", "b.WriteString(`,\"assignments\":[`)\r\n\tfor i, a := range assignments {\r\n\t\tif i > 0 {\r\n\t\t\tb.WriteByte(',')\r\n\t\t}\r\n"]
[6094.920523, "o", "\t\tb.WriteString(`{\"name\":\"`)\r\n\t\twriteJSONString(&b, a.Name)\r\n\t\tb.WriteString(`\",\"worker\":`)\r\n\t\tb.WriteString(strconv.Itoa(a.Worker))\r\n\t\tb.WriteString(`,\"start\":`)\r\n\t\tb.WriteString(strconv.Itoa(a.Start))\r\n\t\tb.WriteString(`,\"end\":`)\r\n\t\tb.WriteString(strconv.Itoa(a.End))\r\n\t\tb.WriteByte('}')\r\n\t}\r\n\tb.WriteString(`]}`)\r\n\tb.WriteByte('\\n')\r\n\treturn b.Bytes()\r\n}\r\n"]
[6094.920874, "o", "\u001b[?2004h"]
[6094.920955, "o", "root@n30009:/app# "]
[6095.211647, "i", "nl -ba cmd/jobforge/main.go | sed -n '15,40p'\n"]
[6095.212073, "o", "nl -ba cmd/jobforge/main.go | sed -n '15,40p'\r\n\u001b[?2004l\r"]
[6095.216065, "o", "    15\tfunc main() {\r\n    16\t\tif len(os.Args) < 2 {\r\n    17\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    18\t\t\tos.Exit(2)\r\n    19\t\t}\r\n    20\t\r\n"]
[6095.216218, "o", "    21\t\tswitch os.Args[1] {\r\n    22\t\tcase \"plan\":\r\n    23\t\t\tos.Exit(runPlan(os.Args[2:]))\r\n    24\t\tcase \"run\":\r\n    25\t\t\tos.Exit(runRun(os.Args[2:]))\r\n    26\t\tcase \"validate\":\r\n    27\t\t\tos.Exit(runValidate(os.Args[2:]))\r\n    28"]
[6095.216325, "o", "\t\tcase \"list\":\r\n    29\t\t\tos.Exit(runList(os.Args[2:]))\r\n    30\t\tcase \"graph\":\r\n    31\t\t\tos.Exit(runGraph(os.Args[2:]))\r\n    32\t\tcase \"hash\":\r\n    33\t\t\tos.Exit(runHash(os.Args[2:]))\r\n    34\t\tcase \"diff\":\r\n    35\t\t\tos.Exit(runDiff(os.Args[2:]))\r\n    36\t\tcase \"schedule\":\r\n    37\t\t\tos.Exit(runSchedule(os.Args[2:]))\r\n    38\t\tdefault:\r\n    39\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    40\t\t\tos.Exit(2)\r\n"]
