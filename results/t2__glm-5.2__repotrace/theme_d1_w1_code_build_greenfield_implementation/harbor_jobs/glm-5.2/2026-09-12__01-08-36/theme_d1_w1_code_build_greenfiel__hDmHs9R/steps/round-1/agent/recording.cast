[4782.618574, "o", "    42\t\t\treturn nil, &ValidationError{Code: \"spec_not_found\", Message: fmt.Sprintf(\"cannot read spec: %s\", path)}\r\n    43\t\t}\r\n    44\t\r\n    45\t\tvar top map[string]json.RawMessage\r\n    46\t\tif err := json.Unmarshal(data, &top); err != nil || top == nil {\r\n    47\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"top-level JSON must be an object\"}\r\n    48\t\t}\r\n    49\t\r\n    50\t\trawJobs, ok := top[\"jobs\"]\r\n    51\t\tif !ok {\r\n    52"]
[4782.618636, "o", "\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"missing jobs\"}\r\n    53\t\t}\r\n    54\t\r\n    55\t\tvar jobsRaw []json.RawMessage\r\n    56\t\tif err := json.Unmarshal(rawJobs, &jobsRaw); err != nil || jobsRaw == nil {\r\n    57\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"jobs must be an array\"}\r\n    58\t\t}\r\n    59\t\r\n    60\t"]
[4782.618696, "o", "\tvar unknownTop []string\r\n    61\t\tfor k := range top {\r\n    62\t\t\tif k != \"jobs\" {\r\n    63\t\t\t\tunknownTop = append(unknownTop, k)\r\n    64\t\t\t}\r\n    65\t\t}\r\n    66\t\tif len(unknownTop) > 0 {\r\n    67\t\t\tsort.Strings(unknownTop)\r\n    68"]
[4782.618754, "o", "\t\t\treturn nil, &ValidationError{Code: \"unknown_field\", Message: \"unknown field: \" + unknownTop[0]}\r\n    69\t\t}\r\n    70\t\r\n"]
