[2911.417241, "o", "\t\tif len(unknownTop) > 0 {\r\n    67\t\t\tsort.Strings(unknownTop)\r\n    68\t\t\treturn nil, &ValidationError{Code: \"unknown_field\", Message: \"unknown field: \" + unknownTop[0]}\r\n    69\t\t}\r\n    70\t\r\n    71\t\tjobMaps := make([]map[string]json.RawMessage, len(jobsRaw))\r\n    72\t\tfor i, raw := range jobsRaw {\r\n    73\t\t\tvar m map[string]json.RawMessage\r\n    74\t\t\tif err := json.Unmarshal(raw, &m); err != nil || m == nil {\r\n    75\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d] must be an object\", i)}\r\n    76\t\t\t}\r\n    77\t\t\tjobMaps[i] = m\r\n    78\t\t}\r\n    79\t\r\n    80\t\tjobs := make([]*Job, len(jobMaps))\r\n"]
