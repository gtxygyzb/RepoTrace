[5124.04212, "o", "\t\tcase \"run\":\r\n    25\t\t\tos.Exit(runRun(os.Args[2:]))\r\n    26\t\tcase \"validate\":\r\n    27\t\t\tos.Exit(runValidate(os.Args[2:]))\r\n    28\t\tcase \"list\":\r\n    29\t\t\tos.Exit(runList(os.Args[2:]))\r\n    30\t\tcase \"graph\":\r\n    31\t\t\tos.Exit(runGraph(os.Args[2:]))\r\n    32\t\tcase \"hash\":\r\n    33\t\t\tos.Exit(runHash(os.Args[2:]))\r\n    34\t\tdefault:\r\n"]
[5124.042192, "o", "    35\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    36\t\t\tos.Exit(2)\r\n    37\t\t}\r\n    38\t}\r\n    39\t\r\n    40\tfunc runPlan(args []string) int {\r\n    41\t\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n"]
[5124.042271, "o", "    42\t\tfs.SetOutput(os.Stderr)\r\n    43\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    44\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n    45\t\tif err := fs.Parse(args); err != nil {\r\n    46\t\t\treturn 2\r\n    47\t\t}\r\n    48\t\tif *specPath == \"\" {\r\n    49\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n    50\t\t\treturn 2\r\n"]
[5124.042336, "o", "    51\t\t}\r\n    52\t\tif *format != \"text\" && *format != \"json\" {\r\n    53\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n    54\t\t\treturn 2\r\n    55\t\t}\r\n    56\t\r\n    57\t\tspec, err := loadSpec(*specPath)\r\n    58\t\tif err != nil {\r\n    59\t\t\tprintValidationError(err)\r\n    60\t\t\treturn 2\r\n    61\t\t}\r\n    62\t\r\n    63\t\tlevels := computeLevels(spec)\r\n"]
[5124.042439, "o", "    64\t\tswitch *format {\r\n    65\t\tcase \"text\":\r\n    66\t\t\tfor i, names := range levels {\r\n    67\t\t\t\tfmt.Printf(\"level %d: %s\\n\", i, strings.Join(names, \", \"))\r\n    68\t\t\t}\r\n    69\t\tcase \"json\":"]
[5124.042509, "o", "\r\n    70\t\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n    71\t\t\tif err != nil {\r\n    72\t\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n    73\t\t\t\treturn 2\r\n    74\t\t\t}\r\n    75\t\t\tos.Stdout.Write(out)\r\n    76\t\t\tfmt.Println()\r\n    77\t\t}\r\n    78\t\treturn 0\r\n    79\t}\r\n    80\t\r\n    81\tfunc runRun(args []string) int {\r\n    82\t\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n    83\t\tfs.SetOutput(os.Stderr)\r\n    84\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    85\t\tonFailure := fs.String(\"on-failure\", \"stop\", \"on failure behavior: stop|continue\")\r\n    86\t\tresultsPath := fs.String(\"results\", \"\", \"path to results JSON file\")\r\n    87\t\tif err := fs.Parse(args); err != nil {\r\n"]
[5124.042581, "o", "    88\t\t\treturn 2\r\n    89\t\t}\r\n    90\t\tif *specPath == \"\" {\r\n    91\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]\")\r\n    92\t\t\treturn 2\r\n"]
[5124.042702, "o", "    93\t\t}\r\n    94\t\tif *onFailure != \"stop\" && *onFailure != \"continue\" {\r\n    95\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid on-failure: %s\\n\", *onFailure)\r\n    96\t\t\treturn 2\r\n    97\t\t}\r\n    98\t\r\n    99\t\tspec, err := loadSpec(*specPath)\r\n   100\t\tif err != nil {\r\n   101\t\t\tprintValidationError(err)\r\n   102\t\t\treturn 2\r\n   103\t\t}\r\n   104\t\r\n"]
[5124.042768, "o", "   105\t\treturn runSpec(spec, *onFailure, *resultsPath)\r\n   106\t}\r\n   107\t\r\n   108\tfunc runValidate(args []string) int {\r\n   109\t\tfs := flag.NewFlagSet(\"validate\", flag.ContinueOnError)\r\n   110\t\tfs.SetOutput(io.Discard)\r\n   111\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n   112\t\tif err := fs.Parse(args); err != nil {\r\n   113\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   114\t\t\treturn 2\r\n   115\t\t}\r\n   116\t\tif *specPath == \"\" {\r\n   117\t\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n   118\t\t\treturn 2\r\n   119\t\t}\r\n   120\t\tif len(fs.Args()) > 0 {\r\n   121\t\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n   122\t\t\treturn 2\r\n   123\t\t}\r\n   124\t\tif _, err := loadSpec(*specPath); err != nil {\r\n"]
