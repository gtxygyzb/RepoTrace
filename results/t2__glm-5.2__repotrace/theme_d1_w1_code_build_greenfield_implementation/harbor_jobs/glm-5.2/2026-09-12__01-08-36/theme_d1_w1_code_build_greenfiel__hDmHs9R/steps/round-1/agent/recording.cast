[6854.281357, "o", "\t\t\tif _, ok := jobMaps[job.Index][\"name\"]; !ok {\r\n   142\t\t\t\treturn nil, &ValidationError{Code: \"invalid_name\", Message: \"invalid name: <missing>\"}\r\n   143\t\t\t}\r\n   144\t\t\tif !nameRegexp.MatchString(job.Name) {\r\n   145\t\t\t\treturn nil, &ValidationError{Code: \"invalid_name\", Message: \"invalid name: \" + job.Name}\r\n   146\t\t\t}\r\n   147\t\t}\r\n   148\t\r\n   149\t\tseen := map[string]bool{}\r\n"]
[6854.281412, "o", "   150\t\tfor _, job := range jobs {\r\n   151\t\t\tif seen[job.Name] {\r\n   152\t\t\t\treturn nil, &ValidationError{Code: \"duplicate_name\", Message: \"duplicate name: \" + job.Name}\r\n   153\t\t\t}\r\n   154\t\t\tseen[job.Name] = true\r\n"]
[6854.281474, "o", "   155\t\t}\r\n   156\t\r\n   157\t\tfor _, job := range jobs {\r\n   158\t\t\tif _, ok := jobMaps[job.Index][\"command\"]; !ok {\r\n   159\t\t\t\treturn nil, &ValidationError{Code: \"invalid_command\", Message: \"invalid command for \" + job.Name}\r\n   160\t\t\t}\r\n   161\t\t\tif job.Command == \"\" {\r\n   162\t\t\t\treturn nil, &ValidationError{Code: \"invalid_command\", Message: \"invalid command for \" + job.Name}\r\n   163\t\t\t}\r\n   164\t\t}"]
[6854.281546, "o", "\r\n   165\t\r\n   166\t\tfor _, job := range jobs {\r\n   167\t\t\tkeys := make([]string, 0, len(job.Env))\r\n   168\t\t\tfor k := range job.Env {\r\n   169\t\t\t\tkeys = append(keys, k)\r\n   170\t\t\t}\r\n   171\t\t\tsort.Strings(keys)\r\n   172\t\t\tfor _, k := range keys {\r\n   173\t\t\t\tif !envKeyRegexp.MatchString(k) {\r\n"]
[6854.281602, "o", "   174\t\t\t\t\treturn nil, &ValidationError{Code: \"invalid_env_key\", Message: \"invalid env key in \" + job.Name + \": \" + k}\r\n   175\t\t\t\t}\r\n   176\t\t\t}\r\n   177\t\t}\r\n   178\t\r\n   179\t\tspec := &Spec{Jobs: jobs, ByName: map[string]*Job{}}\r\n   180\t\tfor _, job := range jobs {\r\n   181\t\t\tspec.ByName[job.Name] = job\r\n   182\t\t}\r\n   183\t\r\n"]
[6854.281658, "o", "   184\t\tfor _, job := range jobs {\r\n   185\t\t\tfor _, dep := range job.Deps {\r\n   186\t\t\t\tif _, ok := spec.ByName[dep]; !ok {\r\n   187\t\t\t\t\treturn nil, &ValidationError{Code: \"unknown_dep\", Message: \"unknown dep in \" + job.Name + \": \" + dep}\r\n   188\t\t\t\t}\r\n   189\t\t\t}\r\n   190\t"]
[6854.281715, "o", "\t}\r\n   191\t\r\n   192\t\tfor _, job := range jobs {\r\n   193\t\t\tseenDeps := map[string]bool{}\r\n   194\t\t\tfor _, dep := range job.Deps {\r\n   195\t\t\t\tif seenDeps[dep] {\r\n   196\t\t\t\t\treturn nil, &ValidationError{Code: \"duplicate_dep\", Message: \"duplicate dep in \" + job.Name + \": \" + dep}\r\n"]
