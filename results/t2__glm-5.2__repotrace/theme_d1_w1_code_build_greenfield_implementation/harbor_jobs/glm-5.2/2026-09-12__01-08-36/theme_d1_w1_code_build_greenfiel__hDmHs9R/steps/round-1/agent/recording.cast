[6826.626797, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"flag\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"io\"\r\n     9\t\t\"os\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc main() {\r\n    16\t\tif len(os.Args) < 2 {\r\n    17\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    18\t\t\tos.Exit(2)\r\n    19\t\t}\r\n"]
[6826.626962, "o", "    20\t\r\n    21\t\tswitch os.Args[1] {\r\n    22\t\tcase \"plan\":\r\n    23\t\t\tos.Exit(runPlan(os.Args[2:]))\r\n    24\t\tcase \"run\":\r\n    25\t\t\tos.Exit(runRun(os.Args[2:]))\r\n    26\t\tcase \"validate\":\r\n    27\t\t\tos.Exit(runValidate(os.Args[2:]))\r\n    28\t\tcase \"list\":\r\n    29\t\t\tos.Exit(runList(os.Args[2:]))\r\n    30\t\tcase \"graph\":\r\n    31\t\t\tos.Exit(runGraph(os.Args[2:]))\r\n    32\t\tcase \"hash\":\r\n    33\t\t\tos.Exit(runHash(os.Args[2:]))\r\n    34\t\tcase \"diff\":\r\n    35\t\t\tos.Exit(runDiff(os.Args[2:]))\r\n    36\t\tcase \"schedule\":\r\n    37\t\t\tos.Exit(runSchedule(os.Args[2:]))\r\n    38\t\tdefault:\r\n    39\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    40\t\t\tos.Exit(2)\r\n    41\t\t}\r\n    42\t}\r\n    43\t\r\n    44\tfunc runPlan(args []string) int {\r\n    45\t\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n    46\t\tfs.SetOutput(os.Stderr)\r\n    47\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n"]
[6826.627048, "o", "    48\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n    49\t\tif err := fs.Parse(args); err != nil {\r\n    50\t\t\treturn 2\r\n    51\t\t}\r\n    52\t\tif *specPath == \"\" {\r\n    53\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n    54\t\t\treturn 2\r\n    55\t\t}\r\n    56\t\tif *format != \"text\" && *format != \"json\" {\r\n    57\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n    58\t\t\treturn 2\r\n    59\t\t}\r\n    60\t\r\n    61\t\tspec, err := loadSpec(*specPath)\r\n    62\t\tif err != nil {\r\n    63\t\t\tprintValidationError(err)\r\n    64\t\t\treturn 2\r\n    65\t\t}\r\n    66\t\r\n    67\t\tlevels := computeLevels(spec)\r\n"]
[6826.627127, "o", "    68\t\tswitch *format {\r\n    69\t\tcase \"text\":\r\n    70\t\t\tfor i, names := range levels {\r\n    71\t\t\t\tfmt.Printf(\"level %d: %s\\n\", i, strings.Join(names, \", \"))\r\n    72\t\t\t}\r\n    73\t\tcase \"json\":\r\n    74\t\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n    75\t\t\tif err != nil {\r\n    76\t\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n    77\t\t\t\treturn 2\r\n    78\t\t\t}\r\n    79\t\t\tos.Stdout.Write(out)\r\n    80\t\t\tfmt.Println()\r\n    81\t\t}\r\n    82\t\treturn 0\r\n    83\t}\r\n    84\t\r\n    85\tfunc runRun(args []string) int {\r\n"]
[6826.6272, "o", "    86\t\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n    87\t\tfs.SetOutput(os.Stderr)\r\n    88\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    89\t\tonFailure := fs.String(\"on-failure\", \"stop\", \"on failure behavior: stop|continue\")\r\n    90\t\tresultsPath := fs.String(\"results\", \"\", \"path to results JSON file\")\r\n    91\t\tif err := fs.Parse(args); err != nil {\r\n    92\t\t\treturn 2\r\n    93\t\t}\r\n    94\t\tif *specPath == \"\" {\r\n    95\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]\")\r\n    96\t\t\treturn 2\r\n    97\t\t}\r\n    98\t\tif *onFailure != \"stop\" && *onFailure != \"continue\" {\r\n    99\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid on-failure: %s\\n\", *onFailure)\r\n   100"]
[6826.627278, "o", "\t\t\treturn 2\r\n   101\t\t}\r\n   102\t\r\n   103\t\tspec, err := loadSpec(*specPath)\r\n   104\t\tif err != nil {\r\n   105\t\t\tprintValidationError(err)\r\n   106\t\t\treturn 2\r\n   107\t\t}\r\n   108\t\r\n   109\t\treturn runSpec(spec, *onFailure, *resultsPath)\r\n   110\t}\r\n   111\t\r\n   112\tfunc runValidate(args []string) int {\r\n   113\t\tfs := flag.NewFlagSet(\"validate\", flag.ContinueOnError)\r\n   114\t\tfs.SetOutput(io.Discard)\r\n   115\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n   116\t\tif err := fs.Parse(args); err != nil {\r\n"]
