[2871.470028, "o", "    65\t\t\tif _, ok := indices[name]; !ok {\r\n    66\t\t\t\tstrongconnect(name)\r\n    67\t\t\t}\r\n    68\t\t}\r\n    69\t\r\n    70\t\tcyclicSCC := map[string]bool{}\r\n    71\t\t"]
[2871.470083, "o", "var start string\r\n    72\t\tfor _, scc := range sccs {\r\n    73\t\t\tif len(scc) > 1 {\r\n    74\t\t\t\tsorted := append([]string(nil), scc...)\r\n    75\t\t\t\tsort.Strings(sorted)\r\n    76\t\t\t\tfor _, n := range sorted {\r\n"]
[2871.470141, "o", "    77\t\t\t\t\tcyclicSCC[n] = true\r\n    78\t\t\t\t}\r\n    79\t\t\t\tif start == \"\" || sorted[0] < start {\r\n    80\t\t\t\t\tstart = sorted[0]\r\n    81\t\t\t\t}\r\n    82\t\t\t}\r\n    83\t\t}\r\n    84\t\r\n    85\t\tif start == \"\" {\r\n    86\t\t\treturn nil\r\n    87\t\t}\r\n    88\t\r\n    89\t\tinStartSCC := map[string]bool{}\r\n    90\t\tfor _, scc := range sccs {\r\n    91\t\t\tif len(scc) > 1 {\r\n"]
[2871.470197, "o", "    92\t\t\t\tfor _, n := range scc {\r\n    93\t\t\t\t\tif n == start {\r\n    94\t\t\t\t\t\tfor _, n2 := range scc {\r\n    95\t\t\t\t\t\t\tinStartSCC[n2] = true\r\n    96\t\t\t\t\t\t}\r\n    97\t\t\t\t\t\tbreak\r\n    98\t\t\t\t\t}\r\n"]
