[6876.391404, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"regexp\"\r\n"]
[6876.391587, "o", "\t\"sort\"\r\n)\r\n\r\ntype Job struct {\r\n\tIndex   int\r\n\tName    string\r\n\tCommand string\r\n\tDeps    []string\r\n\tWorkdir string\r\n\tEnv     map[string]string\r\n}\r\n\r\ntype Spec struct {\r\n\tJobs   []*Job\r\n\tByName map[string]*Job\r\n}\r\n\r\ntype ValidationError struct {\r\n\tCode    string\r\n\tMessage string\r\n}\r\n\r\nfunc (e *ValidationError) Error() string {\r\n\treturn e.Code + \": \" + e.Message\r\n}\r\n\r\nvar (\r\n\tnameRegexp   = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_-]*$`)\r\n\tenvKeyRegexp = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)\r\n)\r\n\r\nfunc loadSpec(path string) (*Spec, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n"]
[6876.391686, "o", "\t\treturn nil, &ValidationError{Code: \"spec_not_found\", Message: fmt.Sprintf(\"cannot read spec: %s\", path)}\r\n\t}\r\n\r\n\tvar top map[string]json.RawMessage\r\n"]
[6876.392078, "o", "\u001b[?2004hroot@n30009:/app# "]
