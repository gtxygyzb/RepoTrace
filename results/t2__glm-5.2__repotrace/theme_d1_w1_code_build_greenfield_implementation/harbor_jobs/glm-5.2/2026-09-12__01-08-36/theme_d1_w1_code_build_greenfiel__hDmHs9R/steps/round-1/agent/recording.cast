[6853.682062, "o", "   219\t\t}\r\n   220\t\r\n   221\t\torder := make([]*Job, 0, len(spec.Jobs))\r\n   222\t\tfor _, names := range levels {\r\n   223\t\t\tfor _, name := range names {\r\n   224\t\t\t\tif selected != nil && !selected[name] {\r\n   225\t\t\t\t\tcontinue\r\n   226\t\t\t\t}\r\n   227\t\t\t\torder = append(order, spec.ByName[name])\r\n   228\t\t\t}\r\n"]
[6853.682139, "o", "   229\t\t}\r\n   230\t\treturn order, level\r\n   231\t}\r\n   232\t\r\n   233\tfunc renderListText(jobs []*Job, level map[string]int) []byte {\r\n   234\t\tvar b strings.Builder\r\n   235\t\tfor _, job := range jobs {\r\n   236\t\t\tb.WriteString(job.Name)\r\n   237\t\t\tb.WriteString(\"\\tlevel=\")\r\n   238\t\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n"]
[6853.682207, "o", "   239\t\t\tb.WriteString(\"\\tworkdir=\")\r\n   240\t\t\tb.WriteString(job.Workdir)\r\n   241\t\t\tb.WriteString(\"\\tdeps=\")\r\n   242\t\t\tb.WriteString(strings.Join(job.Deps, \",\"))\r\n   243\t\t\tb.WriteString(\"\\tenv=\")\r\n   244\t\t\tb.WriteString(renderEnvText(job.Env))\r\n   245\t\t\tb.WriteString(\"\\n\")\r\n   246\t\t}\r\n   247\t\treturn []byte(b.String())\r\n   248\t}\r\n   249\t\r\n"]
[6853.682282, "o", "   250\tfunc renderEnvText(env map[string]string) string {\r\n   251\t\tif len(env) == 0 {\r\n   252\t\t\treturn \"\"\r\n   253\t\t}\r\n   254\t\tkeys := make([]string, 0, len(env))\r\n   255\t\tfor k := range env {\r\n   256\t\t\tkeys = append(keys, k)\r\n   257\t\t}\r\n   258\t\tsort.Strings(keys)\r\n   259\t\tparts := make([]string, len(keys))\r\n   260\t\tfor i, k := range keys {\r\n"]
[6853.682351, "o", "   261\t\t\tparts[i] = k + \"=\" + env[k]\r\n   262\t\t}\r\n   263\t\treturn strings.Join(parts, \",\")\r\n   264\t}\r\n   265\t\r\n   266\tfunc renderListJSON(specPath string, jobs []*Job, level map[string]int) []byte {\r\n   267\t\tvar b bytes.Buffer\r\n   268\t\tb.WriteString(`{\"spec_path\":\"`)\r\n   269\t\twriteJSONString(&b, specPath)"]
[6853.682428, "o", "\r\n   270\t\tb.WriteString(`\",\"count\":`)\r\n   271\t\tb.WriteString(strconv.Itoa(len(jobs)))\r\n   272\t\tb.WriteString(`,\"jobs\":[`)\r\n   273\t\tfor i, job := range jobs {\r\n   274\t\t\tif i > 0 {\r\n   275\t\t\t\tb.WriteByte(',')\r\n   276\t\t\t}\r\n   277\t\t\tb.WriteString(`{\"name\":\"`)\r\n   278\t\t\twriteJSONString(&b, job.Name)\r\n   279\t\t\tb.WriteString(`\",\"level\":`)\r\n   280\t\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n   281\t\t\tb.WriteString(`,\"workdir\":\"`)\r\n   282\t\t"]
[6853.682503, "o", "\twriteJSONString(&b, job.Workdir)\r\n   283\t\t\tb.WriteString(`\",\"deps\":`)\r\n   284\t\t\twriteDepsJSON(&b, job.Deps)\r\n   285\t\t\tb.WriteString(`,\"env\":`)\r\n   286\t\t\twriteEnvJSON(&b, job.Env)\r\n"]
[6853.682575, "o", "   287\t\t\tb.WriteString(`,\"command\":\"`)\r\n   288\t\t\twriteJSONString(&b, job.Command)\r\n   289\t\t\tb.WriteString(`\"}`)\r\n   290\t\t}\r\n   291\t\tb.WriteString(`]}`)\r\n   292\t\tb.WriteByte('\\n')\r\n   293\t\treturn b.Bytes()\r\n   294\t}\r\n   295\t\r\n   296\tfunc writeDepsJSON(b *bytes.Buffer, deps []string) {\r\n   297\t\tb.WriteByte('[')\r\n   298\t\tfor i, dep := range deps {\r\n   299\t\t\tif i > 0 {\r\n   300\t\t\t\tb.WriteByte(',')\r\n   301\t\t\t}\r\n   302\t\t\tb.WriteByte('\"')\r\n   303\t\t\twriteJSONString(b, dep)\r\n"]
[6853.682648, "o", "   304\t\t\tb.WriteByte('\"')\r\n   305\t\t}\r\n   306\t\tb.WriteByte(']')\r\n   307\t}\r\n   308\t\r\n   309\tfunc writeEnvJSON(b *bytes.Buffer, env map[string]string) {\r\n   310\t\tb.WriteByte('{')\r\n   311\t\tif len(env) > 0 {\r\n   312\t\t\tkeys := make([]string, 0, len(env))\r\n   313\t\t\tfor k := range env {\r\n   314\t\t\t\tkeys = append(keys, k)\r\n   315\t\t\t}\r\n"]
[6853.682716, "o", "   316\t\t\tsort.Strings(keys)\r\n   317\t\t\tfor i, k := range keys {\r\n   318\t\t\t\tif i > 0 {\r\n   319\t\t\t\t\tb.WriteByte(',')\r\n   320\t\t\t\t}\r\n   321\t\t\t\tb.WriteByte('\"')\r\n   322\t\t\t\twriteJSONString(b, k)\r\n   323\t\t\t\tb.WriteString(`\":\"`)\r\n   324\t\t\t\twriteJSONString(b, env[k])\r\n"]
[6853.682786, "o", "   325\t\t\t\tb.WriteByte('\"')\r\n   326\t\t\t}\r\n   327\t\t}\r\n   328\t\tb.WriteByte('}')\r\n   329\t}\r\n   330\t\r\n   331\tfunc printValidationError(err error) {\r\n   332\t\tif ve, ok := err.(*ValidationError); ok {\r\n   333\t\t\tfmt.Fprintf(os.Stderr, \"error: %s: %s\\n\", ve.Code, ve.Message)\r\n   334\t\t\treturn\r\n   335\t\t}\r\n"]
[6853.682861, "o", "   336\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   337\t}\r\n"]
