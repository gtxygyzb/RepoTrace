[5803.532155, "o", "   243\t\t\tb.WriteString(\"\\n\")\r\n   244\t\t}\r\n   245\t\treturn []byte(b.String())\r\n   246\t}\r\n   247\t\r\n   248\tfunc renderEnvText(env map[string]string) string {\r\n   249\t\tif len(env) == 0 {\r\n   250\t\t"]
[5803.532223, "o", "\treturn \"\"\r\n   251\t\t}\r\n   252\t\tkeys := make([]string, 0, len(env))\r\n   253\t\tfor k := range env {\r\n   254\t\t\tkeys = append(keys, k)\r\n   255\t\t}\r\n   256\t\tsort.Strings(keys)\r\n"]
