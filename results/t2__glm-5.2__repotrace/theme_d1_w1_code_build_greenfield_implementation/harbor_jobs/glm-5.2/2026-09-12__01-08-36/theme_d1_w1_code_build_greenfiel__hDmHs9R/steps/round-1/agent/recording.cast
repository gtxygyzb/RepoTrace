[5112.589095, "o", "   189\t\t\t}\r\n   190\t\t}\r\n   191\t\r\n   192\t\tfor _, job := range jobs {\r\n   193\t\t\tseenDeps := map[string]bool{}\r\n   194\t\t\tfor _, dep := range job.Deps {\r\n   195\t\t\t\tif seenDeps[dep] {\r\n   196\t\t\t\t\treturn nil, &ValidationError{Code: \"duplicate_dep\", Message: \"duplicate dep in \" + job.Name + \": \" + dep}\r\n   197\t\t\t\t}\r\n   198\t\t\t\tseenDeps[dep] = true\r\n   199\t\t\t}\r\n   200\t\t}\r\n   201"]
[5112.589157, "o", "\t\r\n   202\t\tfor _, job := range jobs {\r\n   203\t\t\tfor _, dep := range job.Deps {\r\n   204\t\t\t\tif dep == job.Name {\r\n   205\t\t\t\t\treturn nil, &ValidationError{Code: \"self_dep\", Message: \"self dep: \" + job.Name}\r\n"]
[5112.589231, "o", "   206\t\t\t\t}\r\n   207\t\t\t}\r\n   208\t\t}\r\n   209\t\r\n   210\t\tif err := detectCycle(spec); err != nil {\r\n   211\t\t\treturn nil, err\r\n   212\t\t}\r\n   213\t\r\n   214\t\treturn spec, nil\r\n   215\t}\r\n   216\t\r\n   217\tfunc isKnownJobField(k string) bool {\r\n   218\t\tswitch k {\r\n   219\t\tcase \"name\", \"command\", \"deps\", \"workdir\", \"env\":\r\n"]
