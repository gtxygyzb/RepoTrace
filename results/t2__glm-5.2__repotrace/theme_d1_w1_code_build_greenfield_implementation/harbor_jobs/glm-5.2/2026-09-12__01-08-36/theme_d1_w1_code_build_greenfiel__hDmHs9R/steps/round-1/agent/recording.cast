[2921.48824, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"flag\"\r\n"]
[2921.488407, "o", "     7\t\t\"fmt\"\r\n     8\t\t\"io\"\r\n     9\t\t\"os\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc main() {\r\n    16\t\tif len(os.Args) < 2 {\r\n    17\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    18\t\t\tos.Exit(2)\r\n    19\t\t}\r\n    20\t\r\n    21\t\tswitch os.Args[1] {\r\n    22\t\tcase \"plan\":\r\n    23\t\t\tos.Exit(runPlan(os.Args[2:]))\r\n    24\t\tcase \"run\":\r\n    25\t\t\tos.Exit(runRun(os.Args[2:]))\r\n    26\t\tcase \"validate\":\r\n    27\t\t\tos.Exit(runValidate(os.Args[2:]))\r\n    28\t\tcase \"list\":\r\n    29\t\t\tos.Exit(runList(os.Args[2:]))\r\n    30\t\tdefault:\r\n    31\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    32\t\t\tos.Exit(2)"]
[2921.488508, "o", "\r\n    33\t\t}\r\n    34\t}\r\n    35\t\r\n    36\tfunc runPlan(args []string) int {\r\n    37\t\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n    38\t\tfs.SetOutput(os.Stderr)\r\n    39\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    40\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n    41\t\tif err := fs.Parse(args); err != nil {\r\n    42\t\t\treturn 2\r\n    43\t\t}\r\n    44\t\tif *specPath == \"\" {\r\n    45\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n    46\t\t\treturn 2\r\n"]
[2921.488579, "o", "    47\t\t}\r\n    48\t\tif *format != \"text\" && *format != \"json\" {\r\n    49\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n    50\t\t\treturn 2\r\n    51\t\t}\r\n    52\t\r\n    53\t\tspec, err := loadSpec(*specPath)\r\n    54\t\tif err != nil {\r\n    55\t\t\tprintValidationError(err)\r\n    56\t\t\treturn 2\r\n    57\t\t}\r\n"]
[2921.488653, "o", "    58\t\r\n    59\t\tlevels := computeLevels(spec)\r\n    60\t\tswitch *format {\r\n    61\t\tcase \"text\":\r\n    62\t\t\tfor i, names := range levels {\r\n    63\t\t\t\tfmt.Printf(\"level %d: %s\\n\", i, strings.Join(names, \", \"))\r\n    64\t\t\t}\r\n    65\t\tcase \"json\":\r\n    66"]
[2921.488724, "o", "\t\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n    67\t\t\tif err != nil {\r\n    68\t\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n    69\t\t\t\treturn 2\r\n    70\t\t\t}\r\n    71\t\t\tos.Stdout.Write(out)\r\n    72\t\t\tfmt.Println()\r\n"]
[2921.488797, "o", "    73\t\t}\r\n    74\t\treturn 0\r\n    75\t}\r\n    76\t\r\n    77\tfunc runRun(args []string) int {\r\n    78\t\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n    79\t\tfs.SetOutput(os.Stderr)\r\n    80\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    81\t\tonFailure := fs.String(\"on-failure\", \"stop\", \"on failure behavior: stop|continue\")\r\n    82\t\tresultsPath := fs.String(\"results\", \"\", \"path to results JSON file\")\r\n    83\t\tif err := fs.Parse(args); err != nil {\r\n    84"]
[2921.488881, "o", "\t\t\treturn 2\r\n    85\t\t}\r\n    86\t\tif *specPath == \"\" {\r\n    87\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]\")\r\n    88\t\t\treturn 2\r\n    89\t\t}\r\n    90\t\tif *onFailure != \"stop\" && *onFailure != \"continue\" {\r\n    91\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid on-failure: %s\\n\", *onFailure)\r\n    92\t\t\treturn 2\r\n"]
[2921.488981, "o", "    93\t\t}\r\n    94\t\r\n    95\t\tspec, err := loadSpec(*specPath)\r\n    96\t\tif err != nil {\r\n    97\t\t\tprintValidationError(err)\r\n    98\t\t\treturn 2\r\n    99\t\t}\r\n   100\t\r\n   101\t\treturn runSpec(spec, *onFailure, *resultsPath)\r\n   102\t}\r\n   103\t\r\n   104\tfunc runValidate(args []string) int {\r\n   105\t\tfs := flag.NewFlagSet(\"validate\", flag.ContinueOnError)\r\n"]
[2921.489041, "o", "   106\t\tfs.SetOutput(io.Discard)\r\n   107\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n   108\t\tif err := fs.Parse(args); err != nil {\r\n   109\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   110\t\t\treturn 2\r\n   111\t\t}\r\n   112\t\tif *specPath == \"\" {\r\n   113\t\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n   114\t\t\treturn 2\r\n   115\t\t}\r\n"]
[2921.489102, "o", "   116\t\tif len(fs.Args()) > 0 {\r\n   117\t\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n   118\t\t\treturn 2\r\n   119\t\t}\r\n   120\t\tif _, err := loadSpec(*specPath); err != nil {\r\n   121\t\t\tprintValidationError(err)\r\n   122\t\t\treturn 2\r\n   123\t\t}\r\n"]
[2921.489179, "o", "   124\t\treturn 0\r\n   125\t}\r\n   126\t\r\n   127\tfunc runList(args []string) int {\r\n   128\t\tfs := flag.NewFlagSet(\"list\", flag.ContinueOnError)\r\n   129\t\tfs.SetOutput(io.Discard)\r\n   130\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n   131\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n   132\t\tonly := fs.String(\"only\", \"\", \"comma-separated list of job names\")\r\n   133\t\tif err := fs.Parse(args); err != nil {\r\n"]
[2921.489245, "o", "   134\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   135\t\t\treturn 2\r\n   136\t\t}\r\n   137\t\tif *specPath == \"\" {\r\n   138\t\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n   139\t\t\treturn 2\r\n   140\t\t}\r\n   141\t\tif len(fs.Args()) > 0 {\r\n   142\t\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n   143\t\t\treturn 2\r\n   144"]
[2921.489306, "o", "\t\t}\r\n   145\t\tif *format != \"text\" && *format != \"json\" {\r\n   146\t\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n   147\t\t\treturn 2\r\n   148\t\t}\r\n   149\t\r\n   150\t\tspec, err := loadSpec(*specPath)\r\n   151\t\tif err != nil {\r\n   152\t\t\t"]
[2921.489367, "o", "printValidationError(err)\r\n   153\t\t\treturn 2\r\n   154\t\t}\r\n   155\t\r\n   156\t\tselected, err := parseOnlyFilter(spec, *only)\r\n   157\t\tif err != nil {\r\n   158\t\t\tprintValidationError(err)\r\n   159\t\t\treturn 2\r\n"]
[2921.48943, "o", "   160\t\t}\r\n   161\t\r\n   162\t\tjobs, levels := listJobs(spec, selected)\r\n   163\t\tswitch *format {\r\n   164\t\tcase \"text\":\r\n   165\t\t\tos.Stdout.Write(renderListText(jobs, levels))\r\n   166\t\tcase \"json\":\r\n   167\t\t\tos.Stdout.Write(renderListJSON(*specPath, jobs, levels))\r\n   168\t\t}\r\n"]
[2921.489493, "o", "   169\t\treturn 0\r\n   170\t}\r\n   171\t\r\n   172\tfunc parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {\r\n   173\t\tif only == \"\" {\r\n   174\t\t\treturn nil, nil\r\n   175\t\t}\r\n   176\t\r\n   177\t\tselected := map[string]bool{}\r\n   178\t"]
[2921.489557, "o", "\tseen := map[string]bool{}\r\n   179\t\tfor _, name := range strings.Split(only, \",\") {\r\n   180\t\t\tif seen[name] {\r\n   181\t\t\t\tcontinue\r\n   182\t\t\t}\r\n   183\t\t\tseen[name] = true\r\n   184\t\r\n   185\t\t\tjob, ok := spec.ByName[name]\r\n   186\t\t\tif !ok {\r\n   187\t\t\t\treturn nil, &ValidationError{Code: \"unknown_dep\", Message: \"unknown dep in --only: \" + name}\r\n"]
[2921.489625, "o", "   188\t\t\t}\r\n   189\t\t\taddTransitiveDeps(spec, job, selected)\r\n   190\t\t}\r\n   191\t\treturn selected, nil\r\n   192\t}\r\n   193\t\r\n"]
[2921.48969, "o", "   194\tfunc addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {\r\n   195\t\tif selected[job.Name] {\r\n   196\t\t\treturn\r\n   197\t\t}\r\n   198\t\tselected[job.Name] = true\r\n   199\t\tfor _, dep := range job.Deps {\r\n   200\t\t\taddTransitiveDeps(spec, spec.ByName[dep], selected)\r\n   201\t\t}\r\n   202\t}\r\n   203"]
[2921.489757, "o", "\t\r\n   204\tfunc listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {\r\n   205\t\tlevels := computeLevels(spec)\r\n   206\t\tlevel := make(map[string]int, len(spec.Jobs))\r\n   207\t\tfor i, names := range levels {\r\n   208\t\t\tfor _, name := range names {\r\n   209\t\t\t\tlevel[name] = i\r\n   210\t\t\t}\r\n   211\t\t}\r\n   212\t\r\n   213\t\torder := make([]*Job, 0, len(spec.Jobs))\r\n   214\t\tfor _, names := range levels {\r\n   215\t\t\tfor _, name := range names {\r\n"]
[2921.489824, "o", "   216\t\t\t\tif selected != nil && !selected[name] {\r\n   217\t\t\t\t\tcontinue\r\n   218\t\t\t\t}\r\n   219\t\t\t\torder = append(order, spec.ByName[name])\r\n   220\t\t\t}\r\n   221\t\t}\r\n   222\t\treturn order, level\r\n   223\t}\r\n   224\t\r\n   225\tfunc renderListText(jobs []*Job, level map[string]int) []byte {\r\n   226\t\tvar b strings.Builder\r\n"]
[2921.489922, "o", "   227\t\tfor _, job := range jobs {\r\n   228\t\t\tb.WriteString(job.Name)\r\n   229\t\t\tb.WriteString(\"\\tlevel=\")\r\n   230\t\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n   231\t\t\tb.WriteString(\"\\tworkdir=\")\r\n   232\t\t\tb.WriteString(job.Workdir)\r\n   233\t\t\tb.WriteString(\"\\tdeps=\")\r\n   234\t\t\tb.WriteString(strings.Join(job.Deps, \",\"))\r\n   235\t\t\tb.WriteString(\"\\tenv=\")\r\n   236\t\t\tb.WriteString(renderEnvText(job.Env))\r\n   237\t"]
[2921.489984, "o", "\t\tb.WriteString(\"\\n\")\r\n   238\t\t}\r\n   239\t\treturn []byte(b.String())\r\n   240\t}\r\n   241\t\r\n   242\tfunc renderEnvText(env map[string]string) string {\r\n   243\t\tif len(env) == 0 {\r\n   244\t\t\treturn \"\"\r\n"]
[2921.490047, "o", "   245\t\t}\r\n   246\t\tkeys := make([]string, 0, len(env))\r\n   247\t\tfor k := range env {\r\n   248\t\t\tkeys = append(keys, k)\r\n   249\t\t}\r\n   250\t\tsort.Strings(keys)\r\n   251\t\tparts := make([]string, len(keys))\r\n   252\t\tfor i, k := range keys {\r\n   253\t\t\tparts[i] = k + \"=\" + env[k]\r\n   254\t\t}\r\n"]
