[8393.954136, "o", "func computeAncestorSet(spec *Spec, target *Job) map[string]bool {\r\n\u001b[?2004l\r"]
[8393.954201, "o", "\u001b[?2004h> "]
[8393.954319, "o", "    ancestors := map[string]bool{}\r\n\u001b[?2004l\r"]
[8393.954379, "o", "\u001b[?2004h> "]
[8393.954481, "o", "    var visit func(job *Job)\r\n\u001b[?2004l\r"]
[8393.954546, "o", "\u001b[?2004h> "]
[8393.954644, "o", "    visit = func(job *Job) {\r\n\u001b[?2004l\r"]
[8393.954697, "o", "\u001b[?2004h> "]
[8393.954888, "o", "        for _, dep := range job.Deps {\r\n\u001b[?2004l\r"]
[8393.954957, "o", "\u001b[?2004h> "]
[8393.955066, "o", "            if !ancestors[dep] {\r\n\u001b[?2004l\r"]
[8393.955122, "o", "\u001b[?2004h> "]
[8393.955265, "o", "                ancestors[dep] = true\r\n\u001b[?2004l\r"]
[8393.955322, "o", "\u001b[?2004h> "]
[8393.955474, "o", "                visit(spec.ByName[dep])\r\n\u001b[?2004l\r"]
[8393.95553, "o", "\u001b[?2004h> "]
[8393.95558, "o", "            }\r\n\u001b[?2004l\r"]
[8393.955638, "o", "\u001b[?2004h> "]
[8393.955698, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8393.955763, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8393.955869, "o", "    visit(target)\r\n\u001b[?2004l\r"]
[8393.955931, "o", "\u001b[?2004h> "]
[8393.95602, "o", "    return ancestors\r\n\u001b[?2004l\r"]
[8393.956076, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
