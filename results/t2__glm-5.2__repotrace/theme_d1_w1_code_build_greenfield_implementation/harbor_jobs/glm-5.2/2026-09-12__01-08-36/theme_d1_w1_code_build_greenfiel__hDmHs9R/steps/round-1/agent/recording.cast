[9065.157408, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n)\r\n\r\n"]
[9065.157457, "o", "type Job struct {\r\n\tIndex   int\r\n\tName    string\r\n\tCommand string\r\n\tDeps    []string\r\n\tWorkdir string\r\n\tEnv     map[string]string\r\n}\r\n\r\ntype Spec struct {\r\n\tJobs   []*Job\r\n\tByName map[string]*Job"]
[9065.157563, "o", "\r\n}\r\n\r\ntype ValidationError struct {\r\n\tCode    string\r\n\tMessage string\r\n}\r\n\r\nfunc (e *ValidationError) Error() string {\r\n\treturn e.Code + \": \" + e.Message\r\n}\r\n\r\nvar (\r\n\tnameRegexp   = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_-]*$`)\r\n\tenvKeyRegexp = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)\r\n)\r\n\r\nfunc loadSpec(path string) (*Spec, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n"]
[9065.157579, "o", "\t\treturn nil, &ValidationError{Code: \"spec_not_found\", Message: fmt.Sprintf(\"cannot read spec: %s\", path)}\r\n\t}\r\n"]
[9065.157665, "o", "\r\n\tvar top map[string]json.RawMessage\r\n"]
[9065.157681, "o", "\tif err := json.Unmarshal(data, &top); err != nil || top == nil {\r\n\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"top-level JSON must be an object\"}\r\n\t}\r\n\r\n\trawJobs, ok := top[\"jobs\"]\r\n\tif !ok {\r\n\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"missing jobs\"}\r\n\t}\r\n\r\n\tvar jobsRaw []json.RawMessage\r\n\tif err := json.Unmarshal(rawJobs, &jobsRaw); err != nil || jobsRaw == nil {\r\n\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"jobs must be an array\"}\r\n\t}\r\n\r\n\tvar unknownTop []string\r\n\tfor k := range top {\r\n\t\tif k != \"jobs\" {\r\n"]
[9065.157763, "o", "\t\t\tunknownTop = append(unknownTop, k)\r\n\t\t}\r\n\t}\r\n\tif len(unknownTop) > 0 {\r\n\t\tsort.Strings(unknownTop)\r\n\t\treturn nil, &ValidationError{Code: \"unknown_field\", Message: \"unknown field: \" + unknownTop[0]}\r\n\t}\r\n\r\n\tjobMaps := make([]map[string]json.RawMessage, len(jobsRaw))\r\n\tfor i, raw := range jobsRaw {\r\n\t\tvar m map[string]json.RawMessage\r\n\t\tif err := json.Unmarshal(raw, &m); err != nil || m == nil {\r\n\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d] must be an object\", i)}\r\n\t\t}\r\n\t\tjobMaps[i] = m\r\n\t"]
[9065.157776, "o", "}\r\n"]
[9065.157784, "o", "\r\n\tjobs := make([]*Job, len(jobMaps))\r\n"]
[9065.158345, "o", "\u001b[?2004h"]
[9065.158414, "o", "root@n30009:/app# "]
[9065.442614, "i", "sed -n '1,140p' cmd/jobforge/impact.go\n"]
[9065.443146, "o", "sed -n '1,140p' cmd/jobforge/impact.go\r\n"]
[9065.443273, "o", "\u001b[?2004l\r"]
[9065.446121, "o", "package main\r\n\r\nimport (\r\n\"encoding/json\"\r\n\"flag\"\r\n\"fmt\"\r\n\"os\"\r\n"]
[9065.446206, "o", "\"strings\"\r\n)\r\n\r\nfunc runImpact(args []string) int {\r\nfs := flag.NewFlagSet(\"impact\", flag.ContinueOnError)\r\nfs.SetOutput(os.Stderr)\r\nspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\njobName := fs.String(\"job\", \"\", \"target job\")\r\nformat := fs.String(\"format\", \"text\", \"output format: text|json\")\r\nif err := fs.Parse(args); err != nil {\r\nreturn 2\r\n}\r\n\r\nif *format != \"text\" && *format != \"json\" {\r\nfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\nreturn 2\r\n"]
[9065.446293, "o", "}\r\nif *specPath == \"\" {\r\nfmt.Fprintln(os.Stderr, \"error: --spec required\")\r\nreturn 2\r\n}\r\nif *jobName == \"\" {\r\nfmt.Fprintln(os.Stderr, \"error: --job required\")\r\n"]
[9065.446374, "o", "return 2\r\n}\r\nif len(fs.Args()) != 0 {\r\nfmt.Fprintln(os.Stderr, \"error: unexpected arguments\")\r\nreturn 2\r\n}\r\n\r\nspec, err := loadSpec(*specPath)\r\nif err != nil {\r\nprintValidationError(err)\r\nreturn 2\r\n}\r\n\r\ntarget, ok := spec.ByName[*jobName]\r\nif !ok {\r\nfmt.Fprintf(os.Stderr, \"error: unknown_job: %s\\n\", *jobName)\r\nreturn 2\r\n}\r\n\r\ndescendants := computeDescendantSet(spec, target)\r\n\r\nlevels := computeLevels(spec)\r\nordered := make([]string, 0, len(descendants))\r\nfor _, names := range levels {\r\nfor _, name := range names {\r\nif descendants[name] {\r\nordered = append(ordered, name)\r\n}\r\n}\r\n"]
[9065.44645, "o", "}\r\n\r\nswitch *format {\r\ncase \"text\":\r\nif len(ordered) > 0 {\r\nos.Stdout.WriteString(strings.Join(ordered, \"\\n\") + \"\\n\")\r\n}\r\ncase \"json\":\r\n"]
[9065.446525, "o", "out, err := json.Marshal(ordered)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\nreturn 2\r\n}\r\nos.Stdout.Write(out)\r\nfmt.Println()\r\n}\r\n\r\nreturn 0\r\n}\r\n\r\nfunc computeDescendantSet(spec *Spec, target *Job) map[string]bool {\r\ndescendants := map[string]bool{}\r\nvar visit func(job *Job)\r\nvisit = func(job *Job) {\r\nfor _, dependent := range spec.Dependents[job.Name] {\r\nif !descendants[dependent] {\r\ndescendants[dependent] = true\r\nvisit(spec.ByName[dependent])\r\n}\r\n}\r\n}\r\nvisit(target)\r\nreturn descendants"]
[9065.446593, "o", "\r\n}\r\n"]
[9065.447053, "o", "\u001b[?2004h"]
[9065.447121, "o", "root@n30009:/app# "]
