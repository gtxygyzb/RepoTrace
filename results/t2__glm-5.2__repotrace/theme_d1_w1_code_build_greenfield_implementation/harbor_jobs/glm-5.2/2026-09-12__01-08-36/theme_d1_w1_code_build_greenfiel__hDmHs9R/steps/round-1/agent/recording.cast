[5551.487666, "i", "cat > cmd/jobforge/hash.go <<'EOF'\npackage main\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n)\n\nfunc runHash(args []string) int {\n\tfs := flag.NewFlagSet(\"hash\", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\n\tformat := fs.String(\"format\", \"short\", \"hash format: short|long\")\n\tif err := fs.Parse(args); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\n\t\treturn 2\n\t}\n\tif *specPath == \"\" {\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\n\t\treturn 2\n\t}\n\tif len(fs.Args()) > 0 {\n\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\n\t\treturn 2\n\t}\n\tif *format != \"short\" && *format != \"long\" {\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\n\t\treturn 2\n\t}\n\n\tspec, err := loadSpec(*specPath)\n\tif err != nil {\n\t\tprintValidationError(err)\n\t\treturn 2\n\t}\n\n\tsum := sha256.Sum256([]byte(canonicalForm(spec)))\n\thexSum := hex.EncodeToString(sum[:])\n\tif *format == \"short\" {\n\t\tfmt.Println(hexSum[:12])\n\t} "]
[5551.487986, "i", "else {\n\t\tfmt.Println(hexSum)\n\t}\n\treturn 0\n}\n\nfunc canonicalForm(spec *Spec) string {\n\tvar buf strings.Builder\n\tfor _, names := range computeLevels(spec) {\n\t\tfor _, name := range names {\n\t\t\tjob := spec.ByName[name]\n\t\t\tbuf.WriteString(job.Name)\n\t\t\tbuf.WriteByte(0)\n\t\t\tbuf.WriteString(job.Workdir)\n\t\t\tbuf.WriteByte(0)\n\t\t\tbuf.WriteString(job.Command)\n\t\t\tbuf.WriteByte(0)\n\t\t\tbuf.WriteString(\"deps=\")\n\t\t\tbuf.WriteString(strings.Join(job.Deps, \",\"))\n\t\t\tbuf.WriteByte(0)\n\t\t\tbuf.WriteString(\"env=\")\n\t\t\tkeys := make([]string, 0, len(job.Env))\n\t\t\tfor k := range job.Env {\n\t\t\t\tkeys = append(keys, k)\n\t\t\t}\n\t\t\tsort.Strings(keys)\n\t\t\tparts := make([]string, 0, len(keys))\n\t\t\tfor _, k := range keys {\n\t\t\t\tparts = append(parts, k+\"=\"+job.Env[k])\n\t\t\t}\n\t\t\tbuf.WriteString(strings.Join(parts, \",\"))\n\t\t\tbuf.WriteByte('\\n')\n\t\t}\n\t}\n\treturn buf.String()\n}\nEOF\n"]
