[8394.234871, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"flag\"\r\n"]
[8394.234965, "o", "     7\t\t\"fmt\"\r\n     8\t\t\"io\"\r\n     9\t\t\"os\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc main() {\r\n    16\t\tif len(os.Args) < 2 {\r\n    17\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list|ancestors> --spec <path> [flags]\")\r\n    18\t\t\tos.Exit(2)\r\n    19\t\t}\r\n    20\t\r\n    21\t"]
[8394.235017, "o", "\tswitch os.Args[1] {\r\n    22\t\tcase \"plan\":\r\n    23\t\t\tos.Exit(runPlan(os.Args[2:]))\r\n    24\t\tcase \"ancestors\":\r\n    25\t\t\tos.Exit(runAncestors(os.Args[2:]))\r\n    26\t\tcase \"run\":\r\n    27"]
[8394.235071, "o", "\t\t\tos.Exit(runRun(os.Args[2:]))\r\n    28\t\tcase \"validate\":\r\n    29\t\t\tos.Exit(runValidate(os.Args[2:]))\r\n    30\t\tcase \"list\":\r\n    31\t\t\tos.Exit(runList(os.Args[2:]))\r\n    32\t\tcase \"graph\":\r\n    33\t\t\tos.Exit(runGraph(os.Args[2:]))\r\n    34\t\tcase \"hash\":\r\n"]
[8394.235121, "o", "    35\t\t\tos.Exit(runHash(os.Args[2:]))\r\n    36\t\tcase \"diff\":\r\n    37\t\t\tos.Exit(runDiff(os.Args[2:]))\r\n    38\t\tcase \"schedule\":\r\n    39\t\t\tos.Exit(runSchedule(os.Args[2:]))\r\n    40\t\tcase \"critical\":\r\n    41\t\t\tos.Exit(runCritical(os.Args[2:]))\r\n    42\t\tdefault:"]
[8394.235173, "o", "\r\n    43\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list|ancestors> --spec <path> [flags]\")\r\n    44\t\t\tos.Exit(2)\r\n    45\t\t}\r\n    46\t}\r\n    47\t\r\n    48\tfunc runPlan(args []string) int {\r\n    49\t\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n    50\t"]
[8394.235216, "o", "\tfs.SetOutput(os.Stderr)\r\n    51\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    52\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n    53\t\tif err := fs.Parse(args); err != nil {\r\n    54\t\t\treturn 2\r\n    55\t\t}\r\n"]
[8394.235264, "o", "    56\t\tif *specPath == \"\" {\r\n    57\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n    58\t\t\treturn 2\r\n    59\t\t}\r\n    60\t\tif *format != \"text\" && *format != \"json\" {\r\n    61\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n    62\t\t\treturn 2\r\n    63\t\t"]
[8394.235307, "o", "}\r\n    64\t\r\n    65\t\tspec, err := loadSpec(*specPath)\r\n    66\t\tif err != nil {\r\n    67\t\t\tprintValidationError(err)\r\n    68\t\t\treturn 2\r\n    69\t\t}\r\n    70\t\r\n"]
[8394.235358, "o", "    71\t\tlevels := computeLevels(spec)\r\n    72\t\tswitch *format {\r\n    73\t\tcase \"text\":\r\n    74\t\t\tfor i, names := range levels {\r\n    75\t\t\t\tfmt.Printf(\"L%d [%s]\\n\", i, strings.Join(names, \", \"))\r\n    76\t\t\t}\r\n    77\t\tcase \"json\":\r\n"]
