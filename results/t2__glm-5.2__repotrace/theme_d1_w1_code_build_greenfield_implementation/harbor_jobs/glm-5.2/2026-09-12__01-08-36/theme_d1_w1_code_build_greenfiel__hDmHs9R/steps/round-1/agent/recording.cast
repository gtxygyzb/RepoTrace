[5796.571084, "o", "    66\t\tswitch *format {\r\n    67\t\tcase \"text\":\r\n    68\t\t\tfor i, names := range levels {\r\n    69\t\t\t\tfmt.Printf(\"level %d: %s\\n\", i, strings.Join(names, \", \"))\r\n    70\t\t\t}\r\n    71\t\tcase \"json\":\r\n    72\t\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n    73\t\t\tif err != nil {\r\n"]
