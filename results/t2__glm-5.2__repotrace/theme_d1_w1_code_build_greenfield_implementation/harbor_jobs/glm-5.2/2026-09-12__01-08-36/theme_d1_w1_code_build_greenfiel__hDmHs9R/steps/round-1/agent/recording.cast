[8176.67183, "o", "   181\t\r\n   182\tfunc parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {\r\n   183\t\tif only == \"\" {\r\n   184\t\t\treturn nil, nil\r\n   185\t\t}\r\n   186\t\r\n"]
[8176.671926, "o", "   187\t\tselected := map[string]bool{}\r\n   188\t\tseen := map[string]bool{}\r\n   189\t\tfor _, name := range strings.Split(only, \",\") {\r\n   190\t\t\tif seen[name] {\r\n   191\t\t\t\tcontinue\r\n   192\t\t\t}\r\n   193\t\t\tseen[name] = true\r\n   194\t\r\n   195\t\t\tjob, ok := spec.ByName[name]\r\n   196\t\t\tif !ok {\r\n   197\t\t\t\treturn nil, &ValidationError{Code: \"unknown_dep\", Message: \"unknown dep in --only: \" + name}\r\n"]
[8176.672039, "o", "   198\t\t\t}\r\n   199\t\t\taddTransitiveDeps(spec, job, selected)\r\n   200\t\t}\r\n   201\t\treturn selected, nil\r\n   202\t}\r\n   203\t\r\n   204\tfunc addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {\r\n   205\t\tif selected[job.Name] {\r\n   206\t\t\treturn\r\n   207\t\t}\r\n   208\t\tselected[job.Name] = true\r\n   209\t\tfor _, dep := range job.Deps {\r\n   210\t\t\taddTransitiveDeps(spec, spec.ByName[dep], selected)\r\n   211\t\t}\r\n   212\t}\r\n   213\t\r\n   214\tfunc listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {\r\n   215"]
[8176.672107, "o", "\t\tlevels := computeLevels(spec)\r\n   216\t\tlevel := make(map[string]int, len(spec.Jobs))\r\n   217\t\tfor i, names := range levels {\r\n   218\t\t\tfor _, name := range names {\r\n   219\t\t\t\tlevel[name] = i\r\n   220\t\t\t}\r\n   221\t\t}\r\n   222\t\r\n   223\t\torder := make([]*Job, 0, len(spec.Jobs))\r\n"]
[8176.672172, "o", "   224\t\tfor _, names := range levels {\r\n   225\t\t\tfor _, name := range names {\r\n   226\t\t\t\tif selected != nil && !selected[name] {\r\n   227\t\t\t\t\tcontinue\r\n   228\t\t\t\t}\r\n   229\t\t\t\torder = append(order, spec.ByName[name])\r\n   230\t\t\t}\r\n   231\t\t}\r\n"]
[8176.672231, "o", "   232\t\treturn order, level\r\n   233\t}\r\n   234\t\r\n   235\tfunc renderListText(jobs []*Job, level map[string]int) []byte {\r\n   236\t\tvar b strings.Builder\r\n   237\t\tfor _, job := range jobs {\r\n   238\t\t\tb.WriteString(job.Name)\r\n   239\t\t\tb.WriteString(\"\\tlevel=\")\r\n   240\t\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n   241"]
[8176.672289, "o", "\t\t\tb.WriteString(\"\\tworkdir=\")\r\n   242\t\t\tb.WriteString(job.Workdir)\r\n   243\t\t\tb.WriteString(\"\\tdeps=\")\r\n   244\t\t\tb.WriteString(strings.Join(job.Deps, \",\"))\r\n   245\t\t\tb.WriteString(\"\\tenv=\")\r\n   246\t\t\tb.WriteString(renderEnvText(job.Env))\r\n   247\t\t\tb.WriteString(\"\\n\")\r\n   248\t\t}\r\n"]
[8176.672348, "o", "   249\t\treturn []byte(b.String())\r\n   250\t}\r\n   251\t\r\n   252\tfunc renderEnvText(env map[string]string) string {\r\n   253\t\tif len(env) == 0 {\r\n   254\t\t\treturn \"\"\r\n   255\t\t}\r\n   256\t\tkeys := make([]string, 0, len(env))\r\n"]
[8176.672417, "o", "   257\t\tfor k := range env {\r\n   258\t\t\tkeys = append(keys, k)\r\n   259\t\t}\r\n   260\t\tsort.Strings(keys)\r\n   261\t\t"]
[8176.672476, "o", "parts := make([]string, len(keys))\r\n   262\t\tfor i, k := range keys {\r\n   263\t\t\tparts[i] = k + \"=\" + env[k]\r\n   264\t\t}\r\n   265\t\treturn strings.Join(parts, \",\")\r\n   266\t}\r\n   267\t\r\n   268\tfunc renderListJSON(specPath string, jobs []*Job, level map[string]int) []byte {\r\n   269\t\tvar b bytes.Buffer\r\n   270\t\tb.WriteString(`{\"spec_path\":\"`)\r\n   271\t\twriteJSONString(&b, specPath)\r\n"]
[8176.672539, "o", "   272\t\tb.WriteString(`\",\"count\":`)\r\n   273\t\tb.WriteString(strconv.Itoa(len(jobs)))\r\n   274\t\tb.WriteString(`,\"jobs\":[`)\r\n   275\t\tfor i, job := range jobs {\r\n   276\t\t\tif i > 0 {\r\n   277\t\t\t\tb.WriteByte(',')\r\n   278\t\t\t}\r\n   279\t\t\tb.WriteString(`{\"name\":\"`)\r\n   280\t\t\twriteJSONString(&b, job.Name)\r\n   281\t\t\tb.WriteString(`\",\"level\":`)\r\n"]
[8176.672597, "o", "   282\t\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n   283\t\t\tb.WriteString(`,\"workdir\":\"`)\r\n   284\t\t\twriteJSONString(&b, job.Workdir)\r\n   285\t\t\tb.WriteString(`\",\"deps\":`)\r\n   286\t\t\twriteDepsJSON(&b, job.Deps)\r\n   287\t\t\tb.WriteString(`,\"env\":`)\r\n   288\t\t\twriteEnvJSON(&b, job.Env)\r\n   289\t\t\tb.WriteString(`,\"command\":\"`)\r\n"]
[8176.672655, "o", "   290\t\t\twriteJSONString(&b, job.Command)\r\n   291\t\t\tb.WriteString(`\"}`)\r\n   292\t\t}\r\n   293\t\tb.WriteString(`]}`)\r\n   294\t\tb.WriteByte('\\n')\r\n   295\t\treturn b.Bytes()\r\n   296\t}\r\n   297\t\r\n   298"]
[8176.672713, "o", "\tfunc writeDepsJSON(b *bytes.Buffer, deps []string) {\r\n   299\t\tb.WriteByte('[')\r\n   300\t\tfor i, dep := range deps {\r\n   301\t\t\tif i > 0 {\r\n   302\t\t\t\tb.WriteByte(',')\r\n   303\t\t\t}\r\n   304\t\t\tb.WriteByte('\"')\r\n"]
[8176.672769, "o", "   305\t\t\twriteJSONString(b, dep)\r\n   306\t\t\tb.WriteByte('\"')\r\n   307\t\t}\r\n   308\t\tb.WriteByte(']')\r\n   309\t}\r\n   310\t\r\n   311\tfunc writeEnvJSON(b *bytes.Buffer, env map[string]string) {\r\n   312\t\tb.WriteByte('{')\r\n   313\t"]
[8176.672825, "o", "\tif len(env) > 0 {\r\n   314\t\t\tkeys := make([]string, 0, len(env))\r\n   315\t\t\tfor k := range env {\r\n   316\t\t\t\tkeys = append(keys, k)\r\n   317\t\t\t}\r\n   318\t\t\tsort.Strings(keys)\r\n   319\t\t\tfor i, k := range keys {\r\n   320\t\t"]
[8176.672894, "o", "\t\tif i > 0 {\r\n   321\t\t\t\t\tb.WriteByte(',')\r\n"]
[8176.672956, "o", "   322\t\t\t\t}\r\n   323\t\t\t\tb.WriteByte('\"')\r\n   324\t\t\t\twriteJSONString(b, k)\r\n   325\t\t\t\tb.WriteString(`\":\"`)\r\n   326\t\t\t\twriteJSONString(b, env[k])\r\n   327\t\t\t\tb.WriteByte('\"')\r\n   328\t\t\t}\r\n   329\t\t}\r\n   330\t\tb.WriteByte('}')\r\n   331\t}\r\n   332\t\r\n   333\tfunc printValidationError(err error) {\r\n   334\t\tif ve, ok := err.(*ValidationError); ok {\r\n   335\t\t\tfmt.Fprintf(os.Stderr, \"error: %s: %s\\n\", ve.Code, ve.Message)\r\n   336\t\t\treturn\r\n"]
[8176.673022, "o", "   337\t\t}\r\n   338\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   339\t}\r\n"]
