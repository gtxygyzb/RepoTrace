[4949.540791, "o", "sed -n '15,36p' cmd/jobforge/main.go\r\n\u001b[?2004l\r"]
[4949.543464, "o", "func main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n"]
[4949.543598, "o", "\tcase \"plan\":\r\n\t\tos.Exit(runPlan(os.Args[2:]))\r\n\tcase \"run\":\r\n\t\tos.Exit(runRun(os.Args[2:]))\r\n\tcase \"validate\":\r\n\t\tos.Exit(runValidate(os.Args[2:]))\r\n\tcase \"list\":\r\n\t\tos.Exit(runList(os.Args[2:]))\r\n\tcase \"graph\":\r\n\t\tos.Exit(runGraph(os.Args[2:]))\r\n\tcase \"hash\":\r\n\t\tos.Exit(runHash(os.Args[2:]))\r\n\tdefault:\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n\t\tos.Exit(2)\r\n"]
[4949.544038, "o", "\u001b[?2004hroot@n30009:/app# "]
[4949.845438, "i", "sed -n '81,93p' cmd/jobforge/graph.go\n"]
[4949.84576, "o", "sed -n '81,93p' cmd/jobforge/graph.go\r\n\u001b[?2004l\r"]
[4949.848893, "o", "func renderDot(jobs []*Job, level map[string]int, edges []graphEdge) []byte {\r\n\tvar b strings.Builder\r\n\tb.WriteString(\"digraph jobforge {\\n\")\r\n\tb.WriteString(\"\\trankdir=LR;\\n\")\r\n\tfor _, job := range jobs {\r\n\t\tb.WriteString(\"\\t\\\"\")\r\n\t\tb.WriteString(dotQuote(job.Name))\r\n\t\tb.WriteString(\"\\\" [level=\\\"\")\r\n\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n\t\tb.WriteString(\"\\\" workdir=\\\"\")\r\n\t\tb.WriteString(dotQuote(job.Workdir))\r\n\t\tb.WriteString(\"\\\"];\\n\")\r\n\t}\r\n"]
[4949.849429, "o", "\u001b[?2004h"]
