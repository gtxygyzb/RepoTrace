[2880.194342, "o", "    94\t}\r\n    95\t\r\n    96\tfunc runJob(job *Job) (string, string, int) {\r\n    97\t\tcmd := exec.Command(\"bash\", \"-c\", job.Command)\r\n    98\t\tcmd.Dir = job.Workdir\r\n    99\t\r\n   100\t\tenvMap := map[string]string{}\r\n   101\t\tfor _, kv := range os.Environ() {\r\n   102\t\t\tif idx := strings.IndexByte(kv, '='); idx >= 0 {\r\n"]
[2880.194393, "o", "   103\t\t\t\tenvMap[kv[:idx]] = kv[idx+1:]\r\n   104\t\t\t}\r\n   105\t\t}\r\n   106\t\tfor k, v := range job.Env {\r\n   107\t\t\tenvMap[k] = v\r\n   108\t\t}\r\n"]
[2880.194444, "o", "   109\t\tenvMap[\"JOBFORGE_JOB_NAME\"] = job.Name\r\n   110\t\tresolvedWorkdir, err := filepath.Abs(job.Workdir)\r\n   111\t\tif err != nil {\r\n   112\t\t\tresolvedWorkdir = job.Workdir\r\n   113\t\t}\r\n   114\t\tenvMap[\"JOBFORGE_JOB_WORKDIR\"] = resolvedWorkdir\r\n"]
