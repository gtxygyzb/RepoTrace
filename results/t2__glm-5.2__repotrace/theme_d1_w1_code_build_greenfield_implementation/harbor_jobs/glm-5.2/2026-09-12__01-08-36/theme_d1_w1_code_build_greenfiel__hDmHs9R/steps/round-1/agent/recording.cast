[4700.29334, "o", "    79\tfunc runRun(args []string) int {\r\n    80\t\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n    81\t\tfs.SetOutput(os.Stderr)\r\n    82\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    83\t\tonFailure := fs.String(\"on-failure\", \"stop\", \"on failure behavior: stop|continue\")\r\n    84\t\tresultsPath := fs.String(\"results\", \"\", \"path to results JSON file\")\r\n    85\t\tif err := fs.Parse(args); err != nil {\r\n    86\t\t\treturn 2\r\n    87\t\t}\r\n    88\t\tif *specPath == \"\" {\r\n"]
[4700.293419, "o", "    89\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]\")\r\n    90\t\t\treturn 2\r\n    91\t\t}\r\n    92\t\tif *onFailure != \"stop\" && *onFailure != \"continue\" {\r\n    93\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid on-failure: %s\\n\", *onFailure)\r\n    94\t\t\treturn 2\r\n    95\t\t}\r\n    96\t\r\n    97\t\tspec, err := loadSpec(*specPath)\r\n    98\t\tif err != nil {\r\n    99\t\t\tprintValidationError(err)\r\n   100"]
[4700.29349, "o", "\t\t\treturn 2\r\n   101\t\t}\r\n   102\t\r\n   103\t\treturn runSpec(spec, *onFailure, *resultsPath)\r\n   104\t}\r\n   105\t\r\n   106\tfunc runValidate(args []string) int {\r\n   107\t\tfs := flag.NewFlagSet(\"validate\", flag.ContinueOnError)\r\n   108\t\tfs.SetOutput(io.Discard)\r\n   109\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n"]
