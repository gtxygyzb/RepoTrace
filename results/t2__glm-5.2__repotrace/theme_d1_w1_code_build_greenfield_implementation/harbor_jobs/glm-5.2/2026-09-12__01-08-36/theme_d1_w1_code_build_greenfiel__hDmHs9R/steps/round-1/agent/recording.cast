[8393.935816, "i", "python3 - <<'PY'\nfrom pathlib import Path\ncontent = '''package main\n\nimport (\n    \"encoding/json\"\n    \"flag\"\n    \"fmt\"\n    \"os\"\n    \"strings\"\n)\n\nfunc runAncestors(args []string) int {\n    fs := flag.NewFlagSet(\"ancestors\", flag.ContinueOnError)\n    fs.SetOutput(os.Stderr)\n    specPath := fs.String(\"spec\", \"\", \"path to spec file\")\n    jobName := fs.String(\"job\", \"\", \"target job\")\n    format := fs.String(\"format\", \"text\", \"output format: text|json\")\n    if err := fs.Parse(args); err != nil {\n        return 2\n    }\n\n    if *format != \"text\" && *format != \"json\" {\n        fmt.Fprintln(os.Stderr, \"error: bad --format\")\n        return 2\n    }\n    if *specPath == \"\" {\n        fmt.Fprintln(os.Stderr, \"error: --spec required\")\n        return 2\n    }\n    if *jobName == \"\" {\n        fmt.Fprintln(os.Stderr, \"error: --job required\")\n        return 2\n    }\n    if len(fs.Args()) != 0 {\n        fmt.Fprintln(os.Stderr, \"error: unexpected arguments\")\n        return 2\n    }\n\n    spec, err := loadSpec(*specPath)\n    if err != ni"]
[8393.936171, "i", "l {\n        printValidationError(err)\n        return 2\n    }\n\n    target, ok := spec.ByName[*jobName]\n    if !ok {\n        fmt.Fprintf(os.Stderr, \"error: unknown_job: %s\\\\n\", *jobName)\n        return 2\n    }\n\n    ancestorSet := computeAncestorSet(spec, target)\n\n    levels := computeLevels(spec)\n    var ordered []string\n    for _, names := range levels {\n        for _, name := range names {\n            if ancestorSet[name] {\n                ordered = append(ordered, name)\n            }\n        }\n    }\n\n    switch *format {\n    case \"text\":\n        if len(ordered) > 0 {\n            os.Stdout.WriteString(strings.Join(ordered, \"\\\\n\") + \"\\\\n\")\n        }\n    case \"json\":\n        out, err := json.Marshal(ordered)\n        if err != nil {\n            fmt.Fprintf(os.Stderr, \"error: marshal: %s\\\\n\", err)\n            return 2\n        }\n        os.Stdout.Write(out)\n        fmt.Println()\n    }\n\n    return 0\n}\n\nfunc computeAncestorSet(spec *Spec, target *Job) map[string]bool {\n    ancestors := map[string]bool{}\n    var visi"]
