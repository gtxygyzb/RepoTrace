[4912.061382, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\nmain_path = Path('cmd/jobforge/main.go')\nmain = main_path.read_text()\nold = '\\tcase \"graph\":\\n\\t\\tos.Exit(runGraph(os.Args[2:]))\\n\\tdefault:'\nnew = '\\tcase \"graph\":\\n\\t\\tos.Exit(runGraph(os.Args[2:]))\\n\\tcase \"hash\":\\n\\t\\tos.Exit(runHash(os.Args[2:]))\\n\\tdefault:'\nif old not in main:\n    raise SystemExit('dispatch pattern not found')\nmain_path.write_text(main.replace(old, new, 1))\n\ngraph_path = Path('cmd/jobforge/graph.go')\ngraph = graph_path.read_text()\nold = 'b.WriteString(\"\\\\\",workdir=\\\\\"\")'\nnew = 'b.WriteString(\"\\\\\" workdir=\\\\\"\")'\nif old not in graph:\n    raise SystemExit('dot separator pattern not found')\ngraph_path.write_text(graph.replace(old, new, 1))\n\nhash_path = Path('cmd/jobforge/hash.go')\nhash_path.write_text(r'''package main\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n)\n\nfunc runHash(args []string) int {\n\tfs := flag.NewFlagSet(\"hash\", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tspecPath := fs.String(\"spec"]
[4912.061697, "i", "\", \"\", \"path to spec file\")\n\tformat := fs.String(\"format\", \"short\", \"hash format: short|long\")\n\tif err := fs.Parse(args); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\n\t\treturn 2\n\t}\n\tif *specPath == \"\" {\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\n\t\treturn 2\n\t}\n\tif len(fs.Args()) > 0 {\n\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\n\t\treturn 2\n\t}\n\tif *format != \"short\" && *format != \"long\" {\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\n\t\treturn 2\n\t}\n\n\tspec, err := loadSpec(*specPath)\n\tif err != nil {\n\t\tprintValidationError(err)\n\t\treturn 2\n\t}\n\n\tvar buf strings.Builder\n\tfor _, names := range computeLevels(spec) {\n\t\tfor _, name := range names {\n\t\t\tjob := spec.ByName[name]\n\t\t\tbuf.WriteString(job.Name)\n\t\t\tbuf.WriteByte(0)\n\t\t\tbuf.WriteString(job.Workdir)\n\t\t\tbuf.WriteByte(0)\n\t\t\tbuf.WriteString(job.Command)\n\t\t\tbuf.WriteByte(0)\n\t\t\tbuf.WriteString(\"deps=\")\n\t\t\tbuf.WriteString(strings.Join(job.Deps, \",\"))\n\t\t\tbuf.WriteByte(0)\n\t\t\tbuf.WriteString(\"env=\")\n\t\t\tkeys := make([]st"]
