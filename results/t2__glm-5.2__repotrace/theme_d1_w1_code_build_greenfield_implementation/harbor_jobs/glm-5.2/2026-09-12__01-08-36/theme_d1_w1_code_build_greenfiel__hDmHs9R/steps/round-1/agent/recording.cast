[2082.868504, "o", "\r\n\r\nfunc detectCycle(spec *Spec) *ValidationError {\r\n\tadj := map[string][]string{}\r\n\tfor _, job := range spec.Jobs {\r\n\t\tdeps := append([]string(nil), job.Deps...)\r\n"]
[2082.868535, "o", "\t\tsort.Strings(deps)\r\n\t\tadj[job.Name] = deps\r\n\t}\r\n"]
[2082.86866, "o", "\r\n\tindex := 0\r\n\tstack := []string{}\r\n\tonStack := map[string]bool{}\r\n\tindices := map[string]int{}\r\n\tlow := map[string]int{}\r\n\tvar sccs [][]string\r\n\r\n\tvar strongconnect func(v string)\r\n\tstrongconnect = func(v string) {\r\n\t"]
[2082.868729, "o", "\tindices[v] = index\r\n\t\tlow[v] = index\r\n\t\tindex++\r\n\t\tstack = append(stack, v)\r\n\t\tonStack[v] = true\r\n\r\n\t\tfor _, w := range adj[v] {\r\n\t\t\tif _, ok := indices[w]; !ok {\r\n\t\t\t\tstrongconnect(w)\r\n\t\t\t\tif low[w] < low[v] {"]
[2082.868809, "o", "\r\n\t\t\t\t\tlow[v] = low[w]\r\n\t\t\t\t}\r\n\t\t\t} else if onStack[w] {\r\n"]
[2082.868922, "o", "\t\t\t\tif indices[w] < low[v] {\r\n\t\t\t\t\tlow[v] = indices[w]\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif low[v] == indices[v] {\r\n\t\t\tvar scc []string\r\n\t\t\tfor {\r\n\t\t\t\tw := stack[len(stack)-1]\r\n"]
[2082.868984, "o", "\t\t\t\tstack = stack[:len(stack)-1]\r\n\t\t\t\tonStack[w] = false\r\n\t\t\t\tscc = append(scc, w)\r\n\t\t\t\tif w == v {\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tsccs = append(sccs, scc)\r\n\t\t}\r\n\t}\r\n\r\n\t"]
[2082.869043, "o", "names := make([]string, 0, len(spec.Jobs))\r\n\tfor _, job := range spec.Jobs {\r\n\t\tnames = append(names, job.Name)\r\n\t}\r\n\tsort.Strings(names)\r\n\tfor _, name := range names {\r\n\t\tif _, ok := indices[name]; !ok {\r\n\t\t\tstrongconnect(name)\r\n"]
[2082.869109, "o", "\t\t}\r\n\t}\r\n\r\n\tcyclicSCC := map[string]bool{}\r\n\tvar start string\r\n\tfor _, scc := range sccs {\r\n\t\tif len(scc) > 1 {\r\n\t\t\tsorted := append([]string(nil), scc...)\r\n\t\t\tsort.Strings(sorted)\r\n\t\t\tfor _, n := range sorted {\r\n\t"]
[2082.869166, "o", "\t\t\tcyclicSCC[n] = true\r\n\t\t\t}\r\n\t\t\tif start == \"\" || sorted[0] < start {\r\n\t\t\t\tstart = sorted[0]\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif start == \"\" {\r\n"]
[2082.869227, "o", "\t\treturn nil\r\n\t}\r\n\r\n\tinStartSCC := map[string]bool{}\r\n\tfor _, scc := range sccs {\r\n\t\tif len(scc) > 1 {\r\n\t\t\tfor _, n := range scc {\r\n"]
[2082.869282, "o", "\t\t\t\tif n == start {\r\n\t\t\t\t\tfor _, n2 := range scc {\r\n\t\t\t\t\t\tinStartSCC[n2] = true\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[2082.869343, "o", "\t\t}\r\n\t}\r\n\r\n\tpath := findCyclePath(start, adj, inStartSCC)\r\n\treturn &ValidationError{Code: \"cycle\", Message: path}\r\n}\r\n\r\nfunc findCyclePath(start string, adj map[string][]string, inSCC map[string]bool) string {\r\n\tpath := []string{start}\r\n\tvisited := map[string]bool{}\r\n\r\n"]
[2082.869406, "o", "\tvar dfs func() bool\r\n\tdfs = func() bool {\r\n\t\tcur := path[len(path)-1]\r\n\t\tfor _, next := range adj[cur] {\r\n\t\t\tif !inSCC[next] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif next == start {\r\n\t"]
[2082.869479, "o", "\t\t\tpath = append(path, start)\r\n\t\t\t\treturn true\r\n\t\t\t}\r\n\t\t\tif visited[next] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvisited[next] = true\r\n\t\t\tpath = append(path, next)\r\n\t\t\tif dfs() {\r\n\t\t\t\treturn true\r\n\t"]
[2082.86954, "o", "\t\t}\r\n\t\t\tpath = path[:len(path)-1]\r\n\t\t\tdelete(visited, next)\r\n\t\t}\r\n\t\treturn false\r\n\t}\r\n\r\n\tif dfs() {\r\n\t\treturn strings.Join(path, \" -> \")\r\n\t}\r\n"]
[2082.869597, "o", "\treturn start\r\n}\r\n"]
