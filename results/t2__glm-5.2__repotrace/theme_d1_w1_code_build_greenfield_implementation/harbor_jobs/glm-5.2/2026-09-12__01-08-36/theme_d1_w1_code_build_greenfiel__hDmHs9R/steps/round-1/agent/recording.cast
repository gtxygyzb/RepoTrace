[2880.194555, "o", "   123\t\tvar stdoutBuf, stderrBuf bytes.Buffer\r\n   124\t\tcmd.Stdout = &stdoutBuf\r\n   125\t\tcmd.Stderr = &stderrBuf\r\n   126\t\r\n   127\t\terr = cmd.Run()\r\n   128\t\tif err != nil && cmd.ProcessState == nil {\r\n   129\t\t\treturn sanitizeOutput(stdoutBuf.Bytes()), sanitizeOutput(stderrBuf.Bytes()), 127\r\n   130\t\t}\r\n   131"]
[2880.194615, "o", "\t\texitCode := 0\r\n   132\t\tif cmd.ProcessState != nil {\r\n   133\t\t\texitCode = exitCodeFromProcessState(cmd.ProcessState)\r\n   134\t\t}\r\n   135\t\treturn sanitizeOutput(stdoutBuf.Bytes()), sanitizeOutput(stderrBuf.Bytes()), exitCode\r\n   136\t}\r\n   137\t\r\n   138\tfunc exitCodeFromProcessState(ps *os.ProcessState) int {\r\n   139\t\tif status, ok := ps.Sys().(syscall.WaitStatus); ok {\r\n   140\t\t\tif status.Exited() {\r\n   141\t\t\t\treturn status.ExitStatus()\r\n   142\t\t\t}\r\n   143\t\t\tif status.Signaled() {\r\n"]
[2880.194675, "o", "   144\t\t\t\treturn 128 + int(status.Signal())\r\n   145\t\t\t}\r\n"]
[2880.194778, "o", "   146\t\t}\r\n   147\t\treturn ps.ExitCode()\r\n   148\t}\r\n   149\t\r\n   150\tfunc sanitizeOutput(b []byte) string {\r\n   151\t\treturn strings.ToValidUTF8(string(b), \"\\ufffd\")\r\n   152\t}\r\n   153\t\r\n   154\tfunc writeResults(path, onFailure string, results []jobResult) error {\r\n   155\t\tvar b bytes.Buffer\r\n"]
[2880.194831, "o", "   156\t\tb.WriteString(\"{\\n\")\r\n   157\t\tb.WriteString(\"  \\\"on_failure\\\": \\\"\")\r\n   158\t\tb.WriteString(onFailure)\r\n   159\t\tb.WriteString(\"\\\",\\n\")\r\n   160\t\tb.WriteString(\"  \\\"jobs\\\": [\")\r\n   161\t\tif len(results) == 0 {\r\n   162\t\t\tb.WriteString(\"]\\n\")\r\n   163\t\t} else {\r\n   164\t\t\tb.WriteString(\"\\n\")\r\n   165\t\t\tfor i, r := range results {\r\n   166\t\t\t\tb.WriteString(\"    {\\n\")\r\n"]
[2880.194892, "o", "   167\t\t\t\tb.WriteString(\"      \\\"name\\\": \\\"\")\r\n   168\t\t\t\twriteJSONString(&b, r.Name)\r\n   169\t\t\t\tb.WriteString(\"\\\",\\n\")\r\n   170\t\t\t\tb.WriteString(\"      \\\"status\\\": \\\"\")\r\n   171\t\t\t\tb.WriteString(r.Status)\r\n   172\t\t\t\tb.WriteString(\"\\\",\\n\")\r\n   173\t\t\t\tb.WriteString(\"      \\\"exit_code\\\": \")\r\n"]
