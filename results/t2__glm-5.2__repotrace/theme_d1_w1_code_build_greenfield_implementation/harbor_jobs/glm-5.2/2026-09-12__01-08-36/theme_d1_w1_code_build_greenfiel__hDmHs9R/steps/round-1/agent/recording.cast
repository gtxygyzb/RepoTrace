[4794.191647, "o", "\u001b[32m\u001b[K202\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\taddTransitiveDeps(\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K, \u001b[01;31m\u001b[Kspec\u001b[m\u001b[K.ByName[dep], selected)\r\n\u001b[32m\u001b[K206\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc listJobs(\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K *Spec, selected map[string]bool) ([]*Job, map[string]int) {\r\n\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tlevels := computeLevels(\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K208\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tlevel := make(map[string]int, len(\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K.Jobs))\r\n\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\torder := make([]*Job, 0, len(\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K.Jobs))\r\n\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\torder = append(order, \u001b[01;31m\u001b[Kspec\u001b[m\u001b[K.ByName[name])\r\n\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K order, level\r\n"]
[4794.191751, "o", "\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K []byte(b.String())\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K \"\"\r\n\u001b[32m\u001b[K257\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K strings.Join(parts, \",\")\r\n\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc renderListJSON(\u001b[01;31m\u001b[Kspec\u001b[m\u001b[KPath string, jobs []*Job, level map[string]int) []byte {\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tb.WriteString(`{\"\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K_path\":\"`)\r\n\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\twriteJSONString(&b, \u001b[01;31m\u001b[Kspec\u001b[m\u001b[KPath)\r\n\u001b[32m\u001b[K287\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K b.Bytes()\r\n\u001b[32m\u001b[K327\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.\u001b[01;31m\u001b[KStderr\u001b[m\u001b[K, \"error: %s: %s\\n\", ve.Code, ve.Message)\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K\r\n\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Fprintf(os.\u001b[01;31m\u001b[KStderr\u001b[m\u001b[K, \"error: %s\\n\", err)\r\n"]
