[5834.301593, "o", "\t\t\tif raw, ok := m[\"deps\"]; ok {\r\n   104\t\t\t\tvar arr []string\r\n   105\t\t\t\tif err := json.Unmarshal(raw, &arr); err != nil || arr == nil {\r\n   106\t\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].deps must be an array of strings\", i)}\r\n   107\t\t\t\t}\r\n   108\t\t\t\tjob.Deps = arr\r\n   109\t\t\t}\r\n   110\t\t\tif raw, ok := m[\"workdir\"]; ok {\r\n   111\t\t\t\tvar s string\r\n   112\t\t\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n   113\t\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].workdir must be a string\", i)}\r\n   114\t\t\t\t}\r\n   115\t\t\t\tjob.Workdir = s\r\n   116\t\t\t}\r\n   117\t\t\tif raw, ok := m[\"env\"]; ok {\r\n   118\t\t\t\tenv := map[string]string{}\r\n   119\t\t\t\tif err := json.Unmarshal(raw, &env); err != nil || env == nil {\r\n   120\t\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].env must be an object of strings\", i)}\r\n"]
