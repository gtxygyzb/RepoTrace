[6816.358263, "o", "\tCommand string\r\n    15\t\tDeps    []string\r\n    16\t\tWorkdir string\r\n    17\t\tEnv     map[string]string\r\n    18\t}\r\n    19\t\r\n    20\ttype Spec struct {\r\n    21\t\tJobs   []*Job\r\n    22\t\tByName map[string]*Job\r\n    23\t}\r\n    24\t\r\n    25\ttype ValidationError struct {\r\n    26\t\tCode    string\r\n    27\t\tMessage string\r\n    28\t}\r\n    29\t\r\n    30\tfunc (e *ValidationError) Error() string {\r\n    31\t\treturn e.Code + \": \" + e.Message\r\n    32\t}\r\n    33\t\r\n    34\tvar (\r\n    35\t\tnameRegexp   = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_-]*$`)\r\n    36\t\tenvKeyRegexp = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)\r\n    37\t)\r\n    38\t\r\n    39\tfunc loadSpec(path string) (*Spec, error) {\r\n    40\t\tdata, err := os.ReadFile(path)\r\n    41\t\tif err != nil {\r\n    42\t\t\treturn nil, &ValidationError{Code: \"spec_not_found\", Message: fmt.Sprintf(\"cannot read spec: %s\", path)}\r\n    43\t\t}\r\n    44\t\r\n    45\t\tvar top map[string]json.RawMessage\r\n    46\t\tif err := json.Unmarshal(data, &top); err != nil || top == nil {\r\n    47\t\t\treturn nil, &ValidationError{C"]
