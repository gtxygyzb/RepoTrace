[9137.501197, "i", "cat cmd/jobforge/impact.go\n"]
[9137.501463, "o", "cat cmd/jobforge/impact.go\r\n"]
[9137.501565, "o", "\u001b[?2004l\r"]
[9137.503983, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc runImpact(args []string) int {\r\n\tfs := flag.NewFlagSet(\"impact\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tjobName := fs.String(\"job\", \"\", \"target job\")\r\n\tformat := fs.String(\"format\", \"text\", \"output format: text|json\")\r\n\tif err := fs.Parse(args); err != nil {\r\n"]
[9137.504093, "o", "\t\treturn 2\r\n\t}\r\n\r\n\tif *format != \"text\" && *format != \"json\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n\t\treturn 2\r\n\t}\r\n\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --spec required\")\r\n\t\treturn 2\r\n\t}\r\n\tif *jobName == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: --job required\")\r\n\t\treturn 2\r\n\t}\r\n\tif len(fs.Args()) != 0 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: unexpected arguments\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\ttarget, ok := spec.ByName[*jobName]\r\n\tif !ok {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unknown_job: %s\\n\", *jobName)\r\n\t\treturn 2\r\n\t}"]
[9137.504188, "o", "\r\n\r\n\tdescendants := computeDescendantSet(spec, target)\r\n\r\n\tlevels := computeLevels(spec)\r\n\tordered := make([]string, 0, len(descendants))\r\n\tfor _, names := range levels {\r\n\t\tfor _, name := range names {\r\n\t\t\tif descendants[name] {\r\n\t\t\t\tordered = append(ordered, name)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tswitch *format {\r\n\tcase \"text\":\r\n\t\t"]
[9137.504272, "o", "if len(ordered) > 0 {\r\n\t\t\tos.Stdout.WriteString(strings.Join(ordered, \"\\n\") + \"\\n\")\r\n\t\t}\r\n\tcase \"json\":\r\n\t\tout, err := json.Marshal(ordered)\r\n\t\tif err != nil {\r\n\t\t\t"]
[9137.504321, "o", "fmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tos.Stdout.Write(out)\r\n\t\tfmt.Println()\r\n\t}\r\n\r\n\treturn 0\r\n}\r\n\r\nfunc computeDescendantSet(spec *Spec, target *Job) map[string]bool {\r\n\tdescendants := map[string]bool{}\r\n\tvar visit func(job *Job)\r\n\tvisit = func(job *Job) {\r\n\t\tfor _, dependent := range spec.Dependents[job.Name] {\r\n\t\t\tif !descendants[dependent] {\r\n\t\t\t\tdescendants[dependent] = true\r\n\t\t\t\tvisit(spec.ByName[dependent])\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tvisit(target)\r\n\treturn descendants\r\n}\r\n"]
[9137.504764, "o", "\u001b[?2004h"]
[9137.504901, "o", "root@n30009:/app# "]
[9137.790273, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('cmd/jobforge/impact.go')\ns = p.read_text()\nstart = s.index('func computeDescendantSet')\nold = s[start:]\nnew = '''func computeDescendantSet(spec *Spec, target *Job) map[string]bool {\n\\tdependents := map[string][]string{}\n\\tfor _, job := range spec.Jobs {\n\\t\\tfor _, dep := range job.Deps {\n\\t\\t\\tdependents[dep] = append(dependents[dep], job.Name)\n\\t\\t}\n\\t}\n\n\\tdescendants := map[string]bool{}\n\\tvar visit func(name string)\n\\tvisit = func(name string) {\n\\t\\tfor _, dependent := range dependents[name] {\n\\t\\t\\tif dependent == target.Name {\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}\n\\t\\t\\tif !descendants[dependent] {\n\\t\\t\\t\\tdescendants[dependent] = true\n\\t\\t\\t\\tvisit(dependent)\n\\t\\t\\t}\n\\t\\t}\n\\t}\n\\tvisit(target.Name)\n\\treturn descendants\n}\n'''\np.write_text(s[:start] + new)\nPY\n"]
