[2075.394626, "o", "     8\tfunc detectCycle(spec *Spec) *ValidationError {\r\n     9\t\tadj := map[string][]string{}\r\n    10\t\tfor _, job := range spec.Jobs {\r\n    11\t\t\tdeps := append([]string(nil), job.Deps...)\r\n    12\t\t\tsort.Strings(deps)\r\n    13\t\t\tadj[job.Name] = deps\r\n    14\t\t}\r\n    15\t\r\n    16\t\tindex := 0\r\n    17\t\tstack := []string{}\r\n    18\t\tonStack := map[string]bool{}\r\n    19\t\tindices := map[string]int{}\r\n    20\t\tlow := map[string]int{}\r\n    21\t\tvar sccs [][]string\r\n"]
[2075.394692, "o", "    22\t\r\n    23\t\tvar strongconnect func(v string)\r\n    24\t\tstrongconnect = func(v string) {\r\n    25\t\t\tindices[v] = index\r\n    26\t\t\tlow[v] = index\r\n    27\t\t\tindex++\r\n    28\t\t\tstack = append(stack, v)\r\n    29\t\t\tonStack[v] = true\r\n    30\t\r\n"]
[2075.394825, "o", "    31\t\t\tfor _, w := range adj[v] {\r\n    32\t\t\t\tif _, ok := indices[w]; !ok {\r\n    33\t\t\t\t\tstrongconnect(w)\r\n    34\t\t\t\t\tif low[w] < low[v] {\r\n    35\t\t\t\t\t\tlow[v] = low[w]\r\n    36\t\t\t\t\t}\r\n    37\t\t\t\t} else if onStack[w] {\r\n    38\t\t\t\t\tif indices[w] < low[v] {\r\n    39\t\t\t\t\t\tlow[v] = indices[w]\r\n"]
[2075.394935, "o", "    40\t\t\t\t\t}\r\n    41\t\t\t\t}\r\n    42\t\t\t}\r\n    43\t\r\n    44\t\t\tif low[v] == indices[v] {\r\n    45\t\t\t\tvar scc []string\r\n    46\t\t\t\tfor {\r\n    47\t\t\t\t\tw := stack[len(stack)-1]\r\n    48\t\t\t\t\tstack = stack[:len(stack)-1]\r\n    49\t\t\t\t\tonStack[w] = false\r\n    50\t\t\t\t\tscc = append(scc, w)\r\n    51\t\t\t\t\tif w == v {\r\n"]
[2075.394993, "o", "    52\t\t\t\t\t\tbreak\r\n    53\t\t\t\t\t}\r\n    54\t\t\t\t}\r\n    55\t\t\t\tsccs = append(sccs, scc)\r\n    56\t\t\t}\r\n    57\t\t}\r\n    58\t\r\n"]
[2075.395047, "o", "    59\t\tnames := make([]string, 0, len(spec.Jobs))\r\n    60\t\tfor _, job := range spec.Jobs {\r\n    61\t\t\tnames = append(names, job.Name)\r\n    62\t\t}\r\n    63\t\tsort.Strings(names)\r\n    64\t\tfor _, name := range names {\r\n"]
[2075.395103, "o", "    65\t\t\tif _, ok := indices[name]; !ok {\r\n    66\t\t\t\tstrongconnect(name)\r\n    67\t\t\t}\r\n    68\t\t}\r\n    69\t\r\n    70\t\tcyclicSCC := map[string]bool{}\r\n    71\t\tvar start string\r\n    72\t\tfor _, scc := range sccs {\r\n    73\t\t"]
[2075.395156, "o", "\tif len(scc) > 1 {\r\n    74\t\t\t\tsorted := append([]string(nil), scc...)\r\n    75\t\t\t\tsort.Strings(sorted)\r\n    76\t\t\t\tfor _, n := range sorted {\r\n    77\t\t\t\t\tcyclicSCC[n] = true\r\n    78\t\t\t\t}\r\n    79\t\t\t\tif start == \"\" || sorted[0] < start {\r\n"]
[2075.395212, "o", "    80\t\t\t\t\tstart = sorted[0]\r\n    81\t\t\t\t}\r\n    82\t\t\t}\r\n    83\t\t}\r\n    84\t\r\n    85\t\tif start == \"\" {\r\n    86\t\t\treturn nil\r\n    87\t\t}\r\n    88\t\r\n    89\t\t"]
[2075.395268, "o", "inStartSCC := map[string]bool{}\r\n    90\t\tfor _, scc := range sccs {\r\n    91\t\t\tif len(scc) > 1 {\r\n    92\t\t\t\tfor _, n := range scc {\r\n    93\t\t\t\t\tif n == start {\r\n    94\t\t\t\t\t\tfor _, n2 := range scc {\r\n    95\t\t\t\t\t\t\tinStartSCC[n2] = true\r\n"]
[2075.39532, "o", "    96\t\t\t\t\t\t}\r\n    97\t\t\t\t\t\tbreak\r\n    98\t\t\t\t\t}\r\n    99\t\t\t\t}\r\n   100\t\t\t}\r\n   101\t\t}\r\n"]
[2075.395372, "o", "   102\t\r\n   103\t\tpath := findCyclePath(start, adj, inStartSCC)\r\n   104\t\treturn &ValidationError{Code: \"cycle\", Message: path}\r\n   105\t}\r\n   106\t\r\n   107\tfunc findCyclePath(start string, adj map[string][]string, inSCC map[string]bool) string {\r\n"]
[2075.395429, "o", "   108\t\tpath := []string{start}\r\n   109\t\tvisited := map[string]bool{}\r\n   110\t\r\n   111\t\tvar dfs func() bool\r\n   112\t\tdfs = func() bool {\r\n   113\t\t\tcur := path[len(path)-1]\r\n   114\t\t\tfor _, next := range adj[cur] {\r\n   115\t\t\t\tif !inSCC[next] {\r\n   116\t\t\t\t\tcontinue\r\n"]
[2075.395484, "o", "   117\t\t\t\t}\r\n   118\t\t\t\tif next == start {\r\n   119\t\t\t\t\tpath = append(path, start)\r\n   120\t\t\t\t\treturn true\r\n   121\t\t\t\t}\r\n   122\t\t\t\tif visited[next] {\r\n   123\t\t\t\t\tcontinue\r\n   124\t\t\t\t}\r\n"]
[2075.395535, "o", "   125\t\t\t\tvisited[next] = true\r\n   126\t\t\t\tpath = append(path, next)\r\n   127\t\t\t\tif dfs() {\r\n   128\t\t\t\t\treturn true\r\n   129\t\t\t\t}\r\n"]
[2075.395591, "o", "   130\t\t\t\tpath = path[:len(path)-1]\r\n   131\t\t\t\tdelete(visited, next)\r\n   132\t\t\t}\r\n   133\t\t\treturn false\r\n   134\t\t}\r\n   135\t\r\n   136\t\tif dfs() {\r\n   137\t\t\treturn strings.Join(path, \" -> \")\r\n"]
[2075.39564, "o", "   138\t\t}\r\n   139\t\treturn start\r\n   140\t}\r\n"]
