[8997.674248, "o", "    73\t\tcase \"text\":\r\n    74\t\t\tfor i, names := range levels {\r\n    75\t\t\t\tfmt.Printf(\"L%d [%s]\\n\", i, strings.Join(names, \", \"))\r\n    76\t\t\t}\r\n    77\t\tcase \"json\":\r\n    78\t\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n    79\t\t\tif err != nil {\r\n    80\t\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n"]
[8997.674309, "o", "    81\t\t\t\treturn 2\r\n    82\t\t\t}\r\n    83\t\t\tos.Stdout.Write(out)\r\n    84\t\t\tfmt.Println()\r\n    85\t\t}\r\n    86\t\treturn 0\r\n    87\t}\r\n    88\t\r\n    89\tfunc runRun(args []string) int {\r\n"]
[8997.674382, "o", "    90\t\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n    91\t\tfs.SetOutput(os.Stderr)\r\n    92\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    93\t\tonFailure := fs.String(\"on-failure\", \"stop\", \"on failure behavior: stop|continue\")\r\n    94\t\tresultsPath := fs.String(\"results\", \"\", \"path to results JSON file\")\r\n"]
[8997.674447, "o", "    95\t\tif err := fs.Parse(args); err != nil {\r\n    96\t\t\treturn 2\r\n    97\t\t}\r\n    98\t\tif *specPath == \"\" {\r\n    99\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]\")\r\n   100\t\t\treturn 2\r\n   101\t\t}\r\n   102\t\tif *onFailure != \"stop\" && *onFailure != \"continue\" {\r\n   103\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid on-failure: %s\\n\", *onFailure)\r\n   104\t\t\treturn 2\r\n   105\t\t}\r\n   106\t\r\n   107\t\tspec, err := loadSpec(*specPath)\r\n"]
[8997.674513, "o", "   108\t\tif err != nil {\r\n   109\t\t\tprintValidationError(err)\r\n   110\t\t\treturn 2\r\n   111\t\t}\r\n   112\t\r\n   113\t\treturn runSpec(spec, *onFailure, *resultsPath)\r\n   114\t}\r\n   115\t\r\n   116\tfunc runValidate(args []string) int {\r\n"]
