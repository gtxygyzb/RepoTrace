[2912.015155, "o", "     9\t\tadj := map[string][]string{}\r\n    10\t\tfor _, job := range spec.Jobs {\r\n    11\t\t\tdeps := append([]string(nil), job.Deps...)\r\n    12\t\t\tsort.Strings(deps)\r\n    13\t\t\tadj[job.Name] = deps\r\n    14\t\t}\r\n    15\t\r\n    16\t\tindex := 0\r\n    17\t\tstack := []string{}\r\n    18\t\tonStack := map[string]bool{}\r\n    19\t\tindices := map[string]int{}\r\n    20\t\tlow := map[string]int{}\r\n    21\t\tvar sccs [][]string\r\n    22\t\r\n    23\t\tvar strongconnect func(v string)\r\n    24\t\tstrongconnect = func(v string) {\r\n    25\t\t\tindices[v] = index\r\n    26\t\t\tlow[v] = index\r\n    27\t\t\tindex++\r\n    28\t\t\tstack = append(stack, v)\r\n    29\t\t\tonStack[v] = true\r\n"]
[2912.015278, "o", "    30\t\r\n    31\t\t\tfor _, w := range adj[v] {\r\n    32\t\t\t\tif _, ok := indices[w]; !ok {\r\n    33\t\t\t\t\tstrongconnect(w)\r\n    34\t\t\t\t\tif low[w] < low[v] {\r\n    35\t\t\t\t\t\tlow[v] = low[w]\r\n    36\t\t\t\t\t}\r\n    37\t\t\t\t} else if onStack[w] {\r\n    38\t\t\t\t\tif indices[w] < low[v] {\r\n    39\t\t\t\t\t\tlow[v] = indices[w]\r\n    40\t\t\t\t\t}\r\n    41\t\t\t\t}\r\n    42\t\t\t}\r\n    43\t\r\n    44\t\t\tif low[v] == indices[v] {\r\n"]
[2912.015459, "o", "    45\t\t\t\tvar scc []string\r\n    46\t\t\t\tfor {\r\n    47\t\t\t\t\tw := stack[len(stack)-1]\r\n    48\t\t\t\t\tstack = stack[:len(stack)-1]\r\n    49\t\t\t\t\tonStack[w] = false\r\n    50\t\t\t\t\tscc = append(scc, w)\r\n    51\t\t\t\t\tif w == v {\r\n    52\t\t\t\t\t\tbreak\r\n    53\t\t\t\t\t}\r\n    54\t\t\t\t}\r\n    55\t\t\t\tsccs = append(sccs, scc)\r\n    56\t\t\t}\r\n    57\t\t}\r\n    58\t\r\n    59\t\tnames := make([]string, 0, len(spec.Jobs))\r\n    60\t\tfor _, job := range spec.Jobs {\r\n    61\t\t\tnames = append(names, job.Name)\r\n    62\t\t}\r\n    63\t\tsort.Strings(names)\r\n    64\t\tfor _, name := range names {\r\n    65\t"]
