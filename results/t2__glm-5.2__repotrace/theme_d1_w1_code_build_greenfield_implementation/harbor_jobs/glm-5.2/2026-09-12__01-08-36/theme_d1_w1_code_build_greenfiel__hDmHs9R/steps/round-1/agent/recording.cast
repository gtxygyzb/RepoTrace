[4709.816984, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n"]
[4709.817089, "o", "     6\t\t\"flag\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"io\"\r\n     9\t\t\"os\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc main() {\r\n    16\t\tif len(os.Args) < 2 {\r\n    17\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    18\t\t\tos.Exit(2)\r\n    19\t\t}\r\n    20\t\r\n    21\t\tswitch os.Args[1] {\r\n    22\t\tcase \"plan\":\r\n    23\t\t\tos.Exit(runPlan(os.Args[2:]))\r\n    24\t\tcase \"run\":\r\n"]
[4709.81716, "o", "    25\t\t\tos.Exit(runRun(os.Args[2:]))\r\n    26\t\tcase \"validate\":\r\n    27\t\t\tos.Exit(runValidate(os.Args[2:]))\r\n    28\t\tcase \"list\":\r\n    29\t\t\tos.Exit(runList(os.Args[2:]))\r\n    30\t\tcase \"graph\":\r\n    31\t\t\tos.Exit(runGraph(os.Args[2:]))\r\n    32\t\tdefault:\r\n    33\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    34\t\t\tos.Exit(2)\r\n    35\t\t}\r\n"]
[4709.817193, "o", "    36\t}\r\n    37\t\r\n    38\tfunc runPlan(args []string) int {\r\n    39\t\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n    40\t\tfs.SetOutput(os.Stderr)\r\n"]
[4709.817216, "o", "    41\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    42\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n    43\t\tif err := fs.Parse(args); err != nil {\r\n    44\t\t\treturn 2\r\n    45"]
[4709.817317, "o", "\t\t}\r\n    46\t\tif *specPath == \"\" {\r\n    47\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n    48\t\t\treturn 2\r\n    49\t\t}\r\n    50\t\tif *format != \"text\" && *format != \"json\" {\r\n    51\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n    52\t\t\treturn 2\r\n    53\t\t}\r\n    54\t\r\n    55\t\tspec, err := loadSpec(*specPath)\r\n    56\t\tif err != nil {\r\n    57\t\t\tprintValidationError(err)\r\n    58\t\t\treturn 2\r\n    59\t\t}\r\n    60\t\r\n    61\t"]
[4709.817372, "o", "\tlevels := computeLevels(spec)\r\n    62\t\tswitch *format {\r\n    63\t\tcase \"text\":\r\n"]
[4709.817425, "o", "    64\t\t\tfor i, names := range levels {\r\n    65\t\t\t\tfmt.Printf(\"level %d: %s\\n\", i, strings.Join(names, \", \"))\r\n    66\t\t\t}\r\n    67\t\tcase \"json\":\r\n    68\t\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n    69\t\t\tif err != nil {\r\n    70\t\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n    71\t\t\t\treturn 2\r\n"]
[4709.817478, "o", "    72\t\t\t}\r\n    73\t\t\tos.Stdout.Write(out)\r\n    74\t\t\tfmt.Println()\r\n    75\t\t}\r\n    76\t\treturn 0\r\n    77\t}\r\n    78\t\r\n    79\tfunc runRun(args []string) int {\r\n    80\t\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n"]
[4709.817533, "o", "    81\t\tfs.SetOutput(os.Stderr)\r\n    82\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    83\t\tonFailure := fs.String(\"on-failure\", \"stop\", \"on failure behavior: stop|continue\")\r\n    84\t\tresultsPath := fs.String(\"results\", \"\", \"path to results JSON file\")\r\n    85\t\tif err := fs.Parse(args); err != nil {\r\n    86\t\t\treturn 2\r\n    87\t\t}\r\n    88\t\tif *specPath == \"\" {\r\n"]
[4709.817592, "o", "    89\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]\")\r\n    90\t\t\treturn 2\r\n    91\t\t}\r\n    92\t\tif *onFailure != \"stop\" && *onFailure != \"continue\" {\r\n    93\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid on-failure: %s\\n\", *onFailure)\r\n    94\t\t\treturn 2\r\n    95\t\t}\r\n    96\t\r\n    97\t\tspec, err := loadSpec(*specPath)\r\n    98\t\tif err != nil {\r\n    99\t\t\tprintValidationError(err)\r\n   100\t\t\treturn 2\r\n   101\t\t}\r\n   102\t\r\n   103\t\treturn runSpec(spec, *onFailure, *resultsPath)\r\n   104\t"]
[4709.817649, "o", "}\r\n   105\t\r\n   106\tfunc runValidate(args []string) int {\r\n   107\t\tfs := flag.NewFlagSet(\"validate\", flag.ContinueOnError)\r\n   108\t\tfs.SetOutput(io.Discard)\r\n   109\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n   110\t\tif err := fs.Parse(args); err != nil {\r\n   111\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n"]
[4709.8177, "o", "   112\t\t\treturn 2\r\n"]
[4709.817756, "o", "   113\t\t}\r\n   114\t\tif *specPath == \"\" {\r\n   115\t\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n   116\t\t\treturn 2\r\n   117\t\t}\r\n   118\t\tif len(fs.Args()) > 0 {\r\n   119\t\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n   120\t\t\treturn 2\r\n   121\t\t}\r\n   122\t\tif _, err := loadSpec(*specPath); err != nil {\r\n   123\t\t\tprintValidationError(err)\r\n   124\t\t\treturn 2\r\n   125\t\t}\r\n   126\t\treturn 0\r\n   127\t"]
[4709.817811, "o", "}\r\n   128\t\r\n   129\tfunc runList(args []string) int {\r\n"]
[4709.817926, "o", "   130\t\tfs := flag.NewFlagSet(\"list\", flag.ContinueOnError)\r\n   131\t\tfs.SetOutput(io.Discard)\r\n   132\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n   133\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n   134\t\tonly := fs.String(\"only\", \"\", \"comma-separated list of job names\")\r\n   135\t\tif err := fs.Parse(args); err != nil {\r\n   136\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   137\t\t\treturn 2\r\n   138\t\t}\r\n   139\t\tif *specPath == \"\" {\r\n   140\t\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n   141\t\t\treturn 2\r\n   142\t\t}\r\n   143\t\tif len(fs.Args()) > 0 {\r\n   144\t\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n   145\t\t\treturn 2\r\n"]
