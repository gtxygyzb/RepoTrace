[2880.19403, "o", "    53\t\t\t\t}\r\n    54\t\t\t}\r\n    55\t\t\tif skip {\r\n    56\t\t\t\tresults[i].Status = \"skipped\"\r\n    57\t\t\t\tresults[i].ExitCode = -1\r\n    58\t\t\t\tresults[i].Stdout = \"\"\r\n    59\t\t\t\tresults[i].Stderr = \"\"\r\n    60\t\t\t\tstatuses[job.Name] = \"skipped\"\r\n"]
