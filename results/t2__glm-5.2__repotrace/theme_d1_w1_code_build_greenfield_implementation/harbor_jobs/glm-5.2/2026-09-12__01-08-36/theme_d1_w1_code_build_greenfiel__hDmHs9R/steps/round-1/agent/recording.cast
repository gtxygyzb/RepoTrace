[7395.839715, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc runCritical(args []string) int {\r\n\tfs := flag.NewFlagSet(\"critical\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n\t\treturn 2\r\n\t}\r\n"]
[7395.839827, "o", "\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n\t\treturn 2\r\n\t}\r\n\tif len(fs.Args()) > 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n\t\treturn 2\r\n\t}\r\n\tif *format != \"text\" && *format != \"json\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n"]
