[4700.294023, "o", "\t}\r\n   178\t\r\n   179\t\tselected := map[string]bool{}\r\n   180\t\tseen := map[string]bool{}\r\n   181\t\tfor _, name := range strings.Split(only, \",\") {\r\n   182\t\t\tif seen[name] {\r\n   183\t\t\t\tcontinue\r\n   184\t\t\t}\r\n   185\t\t\tseen[name] = true\r\n"]
[4700.294147, "o", "   186\t\r\n   187\t\t\tjob, ok := spec.ByName[name]\r\n   188\t\t\tif !ok {\r\n   189\t\t\t\treturn nil, &ValidationError{Code: \"unknown_dep\", Message: \"unknown dep in --only: \" + name}\r\n   190\t\t\t}\r\n   191\t\t\taddTransitiveDeps(spec, job, selected)\r\n   192\t\t}\r\n   193\t\treturn selected, nil\r\n   194\t}\r\n   195\t\r\n   196\tfunc addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {\r\n   197\t\tif selected[job.Name] {\r\n   198\t\t\treturn\r\n   199\t\t}\r\n   200\t\tselected[job.Name] = true\r\n   201\t\tfor _, dep := range job.Deps {\r\n   202\t\t\taddTransitiveDeps(spec, spec.ByName[dep], selected)\r\n"]
[4700.294357, "o", "   203\t\t}\r\n   204\t}\r\n   205\t\r\n   206\tfunc listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {\r\n   207\t\tlevels := computeLevels(spec)\r\n   208\t\tlevel := make(map[string]int, len(spec.Jobs))"]
[4700.294465, "o", "\r\n   209\t\tfor i, names := range levels {\r\n   210\t\t\tfor _, name := range names {\r\n   211\t\t\t\tlevel[name] = i\r\n   212\t\t\t}\r\n   213\t\t}\r\n   214\t\r\n   215\t\torder := make([]*Job, 0, len(spec.Jobs))\r\n   216\t\tfor _, names := range levels {\r\n   217\t\t\tfor _, name := range names {\r\n   218\t\t\t\tif selected != nil && !selected[name] {\r\n   219\t\t\t\t\tcontinue\r\n   220\t\t\t\t}\r\n   221\t\t\t\torder = append(order, spec.ByName[name])\r\n   222\t\t\t}\r\n   223\t\t}\r\n   224\t\treturn order, level\r\n   225\t}\r\n   226\t\r\n   227\tfunc renderListText(jobs []*Job, level map[string]int) []byte {\r\n   228\t\tvar b strings.Builder\r\n   229\t\tfor _, job := range jobs {\r\n   230\t\t\tb.WriteString(job.Name)\r\n   231\t\t\tb.WriteString(\"\\tlevel=\")\r\n   232\t\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n   233\t\t\tb.WriteString(\"\\tworkdir=\")\r\n   234\t\t\tb.WriteString(job.Workdir)\r\n   235\t\t\tb.WriteString(\"\\tdeps=\")\r\n   236\t\t\tb.WriteString(strings.Join(job.Deps, \",\"))\r\n   237\t\t\tb.WriteString(\"\\tenv=\")\r\n   238\t\t\tb.WriteString(renderEnvText(job.Env))\r\n   239\t\t\tb.WriteString(\"\\n\")\r\n   240\t\t"]
[4700.294546, "o", "}\r\n   241\t\treturn []byte(b.String())\r\n   242\t}\r\n   243\t\r\n   244\tfunc renderEnvText(env map[string]string) string {\r\n   245\t\tif len(env) == 0 {\r\n   246\t\t\treturn \"\"\r\n   247\t\t}\r\n   248\t\tkeys := make([]string, 0, len(env))\r\n   249\t\tfor k := range env {\r\n   250\t\t\tkeys = append(keys, k)\r\n   251\t\t}\r\n   252\t\tsort.Strings(keys)\r\n   253\t\tparts := make([]string, len(keys))\r\n   254\t\tfor i, k := range keys {\r\n   255\t\t\tparts[i] = k + \"=\" + env[k]\r\n   256\t\t}\r\n   257\t\treturn strings.Join(parts, \",\")\r\n   258\t}\r\n   259\t\r\n   260\t"]
