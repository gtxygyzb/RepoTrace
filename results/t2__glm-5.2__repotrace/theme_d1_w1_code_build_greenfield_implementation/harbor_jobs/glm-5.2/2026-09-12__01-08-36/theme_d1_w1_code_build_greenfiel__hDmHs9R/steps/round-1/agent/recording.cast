[4741.118271, "o", "\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"list\"\u001b[m\u001b[K:\r\n"]
[4741.118333, "o", "\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"graph\"\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K <path> [flags]\")\r\n"]
[4741.118405, "o", "\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc run\u001b[m\u001b[KPlan(args []string) int {\r\n"]
[4741.118457, "o", "\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfs := flag.New\u001b[01;31m\u001b[KFlag\u001b[m\u001b[KSet(\"plan\", flag.ContinueOnError)\r\n\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kspec\u001b[m\u001b[KPath := fs.String(\"\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K\", \"\", \"path to \u001b[01;31m\u001b[Kspec\u001b[m\u001b[K file\")\r\n"]
[4741.11852, "o", "\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K := fs.String(\"\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K\", \"text\", \"output \u001b[01;31m\u001b[Kformat\u001b[m\u001b[K: json|text\")\r\n\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif *\u001b[01;31m\u001b[Kspec\u001b[m\u001b[KPath == \"\" {\r\n"]
[4741.118578, "o", "\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K <path> [--\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K json|text]\")\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif *\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K != \"text\" && *\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K != \"json\" {\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"error: invalid \u001b[01;31m\u001b[Kformat\u001b[m\u001b[K: %s\\n\", *\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K, err := loadSpec(*\u001b[01;31m\u001b[Kspec\u001b[m\u001b[KPath)\r\n"]
[4741.11866, "o", "\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tlevels := computeLevels(\u001b[01;31m\u001b[Kspec\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tswitch *\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K {\r\n"]
