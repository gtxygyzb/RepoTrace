[5788.757098, "o", "   200\t\t}\r\n   201\t\r\n   202\t\tfor _, job := range jobs {\r\n   203\t\t\tfor _, dep := range job.Deps {\r\n   204\t\t\t\tif dep == job.Name {\r\n   205\t\t\t\t\treturn nil, &ValidationError{Code: \"self_dep\", Message: \"self dep: \" + job.Name}\r\n   206\t\t\t\t}\r\n   207\t\t\t}\r\n   208\t\t}\r\n"]
[5788.757162, "o", "   209\t\r\n   210\t\tif err := detectCycle(spec); err != nil {\r\n   211\t\t\treturn nil, err\r\n   212\t\t}\r\n   213\t\r\n   214\t\treturn spec, nil\r\n   215\t}\r\n   216\t\r\n   217\tfunc isKnownJobField(k string) bool {\r\n   218\t\t"]
[5788.757232, "o", "switch k {\r\n   219\t\tcase \"name\", \"command\", \"deps\", \"workdir\", \"env\":\r\n   220\t\t\treturn true\r\n   221\t\t}\r\n   222\t\treturn false\r\n   223\t}\r\n   224\t\r\n   225\tfunc computeLevels(spec *Spec) [][]string {\r\n   226\t\tlevel := map[string]int{}\r\n   227\t\r\n   228\t\tvar dfs func(job *Job) int\r\n   229\t\tdfs = func(job *Job) int {\r\n"]
[5788.757272, "o", "   230\t\t\tif l, ok := level[job.Name]; ok {\r\n   231\t\t\t\treturn l\r\n   232\t\t\t}\r\n   233\t\t\tmaxDep := -1\r\n   234\t\t\tfor _, dep := range job.Deps {\r\n"]
[5788.75736, "o", "   235\t\t\t\tl := dfs(spec.ByName[dep])\r\n   236\t\t\t\tif l > maxDep {\r\n   237\t\t\t\t\tmaxDep = l\r\n   238\t\t\t\t}\r\n   239\t\t\t}\r\n   240\t\t\tlevel[job.Name] = maxDep + 1\r\n   241\t\t\treturn level[job.Name]\r\n   242\t\t}\r\n   243\t\r\n   244\t\tfor _, job := range spec.Jobs {\r\n   245\t\t\tdfs(job)\r\n   246\t\t}\r\n"]
[5788.75743, "o", "   247\t\r\n   248\t\tmaxLevel := -1\r\n   249\t\tfor _, l := range level {\r\n   250\t\t\tif l > maxLevel {\r\n   251\t\t\t\tmaxLevel = l\r\n   252\t\t\t}\r\n   253\t\t}\r\n   254\t\r\n   255\t\tlevels := make([][]string, maxLevel+1)\r\n   256\t\tfor _, job := range spec.Jobs {\r\n   257\t\t\tlevels[level[job.Name]] = append(levels[level[job.Name]], job.Name)\r\n   258\t\t}\r\n   259\t"]
