[8598.788163, "o", "\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"ancestors\"\u001b[m\u001b[K:\r\n"]
[8598.788254, "o", "\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Printf(\"\u001b[01;31m\u001b[KL%d\u001b[m\u001b[K [%s]\\n\", i, strings.Join(names, \", \"))\r\n"]
