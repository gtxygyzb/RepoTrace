[8168.575442, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n"]
[8168.575641, "o", "\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n"]
[8168.57575, "o", "\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"plan\":\r\n\t\tos.Exit(runPlan(os.Args[2:]))\r\n\tcase \"run\":\r\n\t\tos.Exit(runRun(os.Args[2:]))\r\n\tcase \"validate\":\r\n\t\tos.Exit(runValidate(os.Args[2:]))\r\n\tcase \"list\":\r\n\t\tos.Exit(runList(os.Args[2:]))\r\n\tcase \"graph\":\r\n\t\tos.Exit(runGraph(os.Args[2:]))\r\n\tcase \"hash\":\r\n\t\tos.Exit(runHash(os.Args[2:]))\r\n\tcase \"diff\":\r\n\t\tos.Exit(runDiff(os.Args[2:]))\r\n\tcase \"schedule\":\r\n\t\tos.Exit(runSchedule(os.Args[2:]))\r\n\tcase \"critical\":\r\n\t\tos.Exit(runCritical(os.Args[2:]))\r\n\tdefault:\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n\t\tos.Exit(2)\r\n\t}\r\n}\r\n\r\nfunc runPlan(args []string) int {\r\n\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif *spec"]
[8168.57586, "o", "Path == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n\t\treturn 2\r\n\t}\r\n\tif *format != \"text\" && *format != \"json\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tlevels := computeLevels(spec)\r\n\tswitch *format {\r\n\tcase \"text\":\r\n\t\tfor i, names := range levels {\r\n\t\t\tfmt.Printf(\"level %d: %s\\n\", i, strings.Join(names, \", \"))\r\n\t\t}\r\n\tcase \"json\":\r\n\t"]
[8168.575933, "o", "\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tos.Stdout.Write(out)\r\n\t\tfmt.Println()\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc runRun(args []string) int {\r\n\t"]
[8168.576022, "o", "fs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tonFailure := fs.String(\"on-failure\", \"stop\", \"on failure behavior: stop|continue\")\r\n\tresultsPath := fs.String(\"results\", \"\", \"path to results JSON file\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]\")\r\n\t\treturn 2\r\n\t}\r\n\tif *onFailure != \"stop\" && *onFailure != \"continue\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid on-failure: %s\\n\", *onFailure)\r\n"]
[8168.576088, "o", "\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\treturn runSpec(spec, *onFailure, *resultsPath)\r\n}\r\n\r\n"]
[8168.576152, "o", "func runValidate(args []string) int {\r\n\tfs := flag.NewFlagSet(\"validate\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n\t\treturn 2\r\n\t}\r\n\tif *specPath == \"\" {\r\n\t"]
[8168.576213, "o", "\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n\t\treturn 2\r\n\t}\r\n\tif len(fs.Args()) > 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n\t\treturn 2\r\n\t}\r\n\tif _, err := loadSpec(*specPath); err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[8168.576272, "o", "\r\nfunc runList(args []string) int {\r\n\tfs := flag.NewFlagSet(\"list\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n\tonly := fs.String(\"only\", \"\", \"comma-separated list of job names\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n"]
[8168.576339, "o", "\t\treturn 2\r\n\t}\r\n\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n\t\treturn 2\r\n\t}\r\n\tif len(fs.Args()) > 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n\t\treturn 2\r\n\t}\r\n\tif *format != \"text\" && *format != \"json\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n"]
[8168.576397, "o", "\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tselected, err := parseOnlyFilter(spec, *only)\r\n"]
[8168.576456, "o", "\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tjobs, levels := listJobs(spec, selected)\r\n\tswitch *format {\r\n\tcase \"text\":\r\n\t\tos.Stdout.Write(renderListText(jobs, levels))\r\n\tcase \"json\":\r\n"]
[8168.576522, "o", "\t\tos.Stdout.Write(renderListJSON(*specPath, jobs, levels))\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {\r\n\tif only == \"\" {\r\n\t\treturn nil, nil\r\n\t}\r\n\r\n\tselected := map[string]bool{}\r\n"]
[8168.576584, "o", "\tseen := map[string]bool{}\r\n\tfor _, name := range strings.Split(only, \",\") {\r\n\t\tif seen[name] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tseen[name] = true\r\n\r\n\t\tjob, ok := spec.ByName[name]\r\n\t\tif !ok {\r\n\t\t\treturn nil, &ValidationError{Code: \"unknown_dep\", Message: \"unknown dep in --only: \" + name}\r\n\t\t}\r\n"]
[8168.576647, "o", "\t\taddTransitiveDeps(spec, job, selected)\r\n\t}\r\n\treturn selected, nil\r\n}\r\n\r\nfunc addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {\r\n\tif selected[job.Name] {\r\n\t\treturn\r\n"]
[8168.576728, "o", "\t}\r\n\tselected[job.Name] = true\r\n\tfor _, dep := range job.Deps {\r\n\t\taddTransitiveDeps(spec, spec.ByName[dep], selected)\r\n\t}\r\n}\r\n\r\nfunc listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {\r\n\tlevels := computeLevels(spec)\r\n\tlevel := make(map[string]int, len(spec.Jobs))\r\n\tfor i, names := range levels {\r\n\t\tfor _, name := range names {\r\n\t\t\tlevel[name] = i\r\n\t\t}\r\n\t}\r\n"]
[8168.576797, "o", "\r\n\torder := make([]*Job, 0, len(spec.Jobs))\r\n\tfor _, names := range levels {\r\n\t\tfor _, name := range names {\r\n\t\t\tif selected != nil && !selected[name] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\torder = append(order, spec.ByName[name])\r\n\t\t}\r\n"]
[8168.5769, "o", "\t}\r\n\treturn order, level\r\n}\r\n\r\nfunc renderListText(jobs []*Job, level map[string]int) []byte {\r\n\tvar b strings.Builder\r\n\tfor _, job := range jobs {\r\n\t\tb.WriteString(job.Name)\r\n"]
[8168.576965, "o", "\t\tb.WriteString(\"\\tlevel=\")\r\n\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n\t\tb.WriteString(\"\\tworkdir=\")\r\n\t\tb.WriteString(job.Workdir)\r\n\t\tb.WriteString(\"\\tdeps=\")\r\n\t\tb.WriteString(strings.Join(job.Deps, \",\"))\r\n\t\tb.WriteString(\"\\tenv=\")\r\n\t\tb.WriteString(renderEnvText(job.Env))\r\n\t\tb.WriteString(\"\\n\")\r\n\t}\r\n\treturn []byte(b.String())\r\n}\r\n\r\nfunc renderEnvText(env map[string]string) string {\r\n\tif len(env) == 0 {\r\n\t\treturn \"\"\r\n\t}\r\n\tkeys := make([]string, 0, len(env))\r\n\tfor k := range env {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n"]
[8168.577029, "o", "\tsort.Strings(keys)\r\n\tparts := make([]string, len(keys))\r\n\tfor i, k := range keys {\r\n\t\tparts[i] = k + \"=\" + env[k]\r\n\t}\r\n\treturn strings.Join(parts, \",\")\r\n}\r\n\r\nfunc renderListJSON(specPath string, jobs []*Job, level map[string]int) []byte {\r\n\tvar b bytes.Buffer\r\n"]
[8168.577092, "o", "\tb.WriteString(`{\"spec_path\":\"`)\r\n\twriteJSONString(&b, specPath)\r\n\tb.WriteString(`\",\"count\":`)\r\n\tb.WriteString(strconv.Itoa(len(jobs)))\r\n\tb.WriteString(`,\"jobs\":[`)\r\n\tfor i, job := range jobs {\r\n\t\tif i > 0 {\r\n\t\t\tb.WriteByte(',')\r\n\t\t}\r\n\t\tb.WriteString(`{\"name\":\"`)\r\n\t\twriteJSONString(&b, job.Name)\r\n\t\t"]
[8168.577153, "o", "b.WriteString(`\",\"level\":`)\r\n\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n\t\tb.WriteString(`,\"workdir\":\"`)\r\n\t\twriteJSONString(&b, job.Workdir)\r\n\t\tb.WriteString(`\",\"deps\":`)\r\n\t\twriteDepsJSON(&b, job.Deps)\r\n\t\tb.WriteString(`,\"env\":`)\r\n\t\twriteEnvJSON(&b, job.Env)\r\n\t\tb.WriteString(`,\"command\":\"`)\r\n"]
[8168.577213, "o", "\t\twriteJSONString(&b, job.Command)\r\n\t\tb.WriteString(`\"}`)\r\n\t}\r\n\tb.WriteString(`]}`)\r\n\tb.WriteByte('\\n')\r\n\treturn b.Bytes()\r\n}\r\n\r\nfunc writeDepsJSON(b *bytes.Buffer, deps []string) {\r\n\tb.WriteByte('[')\r\n"]
[8168.577274, "o", "\tfor i, dep := range deps {\r\n\t\tif i > 0 {\r\n\t\t\tb.WriteByte(',')\r\n\t\t}\r\n\t\tb.WriteByte('\"')\r\n\t\twriteJSONString(b, dep)\r\n\t\tb.WriteByte('\"')\r\n"]
[8168.577334, "o", "\t}\r\n\tb.WriteByte(']')\r\n}\r\n\r\nfunc writeEnvJSON(b *bytes.Buffer, env map[string]string) {\r\n\tb.WriteByte('{')\r\n\tif len(env) > 0 {\r\n\t\tkeys := make([]string, 0, len(env))\r\n\t\t"]
[8168.57742, "o", "for k := range env {\r\n\t\t\tkeys = append(keys, k)\r\n\t\t}\r\n\t\tsort.Strings(keys)\r\n\t\tfor i, k := range keys {\r\n\t\t\tif i > 0 {\r\n\t\t\t\tb.WriteByte(',')\r\n\t\t\t}\r\n\t\t\tb.WriteByte('\"')\r\n\t\t\twriteJSONString(b, k)\r\n\t\t\tb.WriteString(`\":\"`)\r\n\t\t\twriteJSONString(b, env[k])\r\n\t\t\tb.WriteByte('\"')\r\n\t\t}\r\n"]
[8168.577481, "o", "\t}\r\n\tb.WriteByte('}')\r\n}\r\n\r\nfunc printValidationError(err error) {\r\n\tif ve, ok := err.(*ValidationError); ok {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s: %s\\n\", ve.Code, ve.Message)\r\n\t\treturn\r\n\t}\r\n\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n}\r\n"]
