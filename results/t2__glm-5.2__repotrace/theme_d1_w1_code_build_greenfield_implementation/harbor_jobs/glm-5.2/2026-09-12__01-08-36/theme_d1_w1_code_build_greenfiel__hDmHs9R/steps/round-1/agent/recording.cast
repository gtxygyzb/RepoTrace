[6071.912438, "o", "Usage of schedule:\r\n  -format string\r\n    \toutput format: text|json (default \"text\")\r\n  -spec string\r\n    \tpath to spec file\r\n  -workers string\r\n    \t"]
[6071.912508, "o", "number of worker lanes\r\n"]
