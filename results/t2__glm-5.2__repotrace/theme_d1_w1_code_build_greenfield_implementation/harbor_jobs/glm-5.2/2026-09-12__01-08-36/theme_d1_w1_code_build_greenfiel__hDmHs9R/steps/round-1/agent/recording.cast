[6853.378983, "o", "    74\t\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n    75\t\t\tif err != nil {\r\n    76\t\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n    77\t\t\t\treturn 2\r\n    78\t\t\t}\r\n    79\t\t\tos.Stdout.Write(out)\r\n    80\t\t\tfmt.Println()\r\n"]
