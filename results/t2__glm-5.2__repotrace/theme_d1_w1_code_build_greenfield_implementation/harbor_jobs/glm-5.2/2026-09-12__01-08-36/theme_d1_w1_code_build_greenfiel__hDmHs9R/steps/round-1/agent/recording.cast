[2885.187072, "o", "   138\t\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n   139\t\t\treturn 2\r\n   140\t\t}\r\n   141\t\tif len(fs.Args()) > 0 {\r\n   142\t\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n   143\t\t\treturn 2\r\n   144\t\t}\r\n"]
[2885.187139, "o", "   145\t\tif *format != \"text\" && *format != \"json\" {\r\n   146\t\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n   147\t\t\treturn 2\r\n   148\t\t}\r\n   149\t\r\n   150\t\tspec, err := loadSpec(*specPath)\r\n   151\t\tif err != nil {\r\n   152\t"]
[2885.187196, "o", "\t\tprintValidationError(err)\r\n   153\t\t\treturn 2\r\n   154\t\t}\r\n   155\t\r\n   156\t\tselected, err := parseOnlyFilter(spec, *only)\r\n   157\t\tif err != nil {\r\n"]
[2885.187257, "o", "   158\t\t\tprintValidationError(err)\r\n   159\t\t\treturn 2\r\n   160\t\t}\r\n   161\t\r\n   162\t\tjobs, levels := listJobs(spec, selected)\r\n   163\t\tswitch *format {\r\n   164\t\tcase \"text\":\r\n"]
[2885.187315, "o", "   165\t\t\tos.Stdout.Write(renderListText(jobs, levels))\r\n   166\t\tcase \"json\":\r\n   167\t\t\tos.Stdout.Write(renderListJSON(*specPath, jobs, levels))\r\n   168\t\t}\r\n   169\t\treturn 0\r\n"]
[2885.187393, "o", "   170\t}\r\n   171\t\r\n   172\tfunc parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {\r\n   173\t\tif only == \"\" {\r\n   174\t\t\treturn nil, nil\r\n   175\t\t}\r\n   176\t\r\n   177\t\tselected := map[string]bool{}\r\n   178\t\tseen := map[string]bool{}\r\n"]
[2885.187458, "o", "   179\t\tfor _, name := range strings.Split(only, \",\") {\r\n   180\t\t\tif seen[name] {\r\n   181\t\t\t\tcontinue\r\n   182\t\t\t}\r\n   183\t\t\tseen[name] = true\r\n   184\t\r\n   185\t\t\tjob, ok := spec.ByName[name]\r\n   186\t\t\tif !ok {\r\n"]
[2885.187516, "o", "   187\t\t\t\treturn nil, &ValidationError{Code: \"unknown_dep\", Message: \"unknown dep in --only: \" + name}\r\n   188\t\t\t}\r\n   189\t\t\taddTransitiveDeps(spec, job, selected)\r\n   190\t\t}\r\n   191\t\treturn selected, nil\r\n   192\t}\r\n   193\t\r\n"]
[2885.187573, "o", "   194\tfunc addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {\r\n   195\t\tif selected[job.Name] {\r\n   196\t\t\treturn\r\n   197\t\t}\r\n   198\t\tselected[job.Name] = true\r\n   199\t\tfor _, dep := range job.Deps {\r\n   200"]
[2885.187631, "o", "\t\t\taddTransitiveDeps(spec, spec.ByName[dep], selected)\r\n   201\t\t}\r\n   202\t}\r\n   203\t\r\n   204\tfunc listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {\r\n   205\t\tlevels := computeLevels(spec)\r\n   206\t\tlevel := make(map[string]int, len(spec.Jobs))\r\n"]
