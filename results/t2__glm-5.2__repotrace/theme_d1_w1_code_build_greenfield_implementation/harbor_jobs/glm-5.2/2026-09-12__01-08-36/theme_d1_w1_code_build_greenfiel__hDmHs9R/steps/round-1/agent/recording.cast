[5153.279175, "o", "\t\tb.WriteByte('\"')\r\n\t}\r\n\tb.WriteByte(']')\r\n}\r\n"]
[5153.279296, "o", "\r\nfunc writeEnvJSON(b *bytes.Buffer, env map[string]string) {\r\n\tb.WriteByte('{')\r\n\tif len(env) > 0 {\r\n\t\tkeys := make([]string, 0, len(env))\r\n\t\tfor k := range env {\r\n\t\t\tkeys = append(keys, k)\r\n\t\t}\r\n\t\tsort.Strings(keys)\r\n\t\tfor i, k := range keys {\r\n\t\t\tif i > 0 {\r\n\t\t\t\tb.WriteByte(',')\r\n\t\t\t}\r\n\t\t\tb.WriteByte('\"')\r\n\t\t\twriteJSONString(b, k)\r\n"]
[5153.279385, "o", "\t\t\tb.WriteString(`\":\"`)\r\n\t\t\twriteJSONString(b, env[k])\r\n\t\t\tb.WriteByte('\"')\r\n\t\t}\r\n\t}\r\n\tb.WriteByte('}')\r\n}\r\n"]
[5153.27946, "o", "\r\nfunc printValidationError(err error) {\r\n\tif ve, ok := err.(*ValidationError); ok {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s: %s\\n\", ve.Code, ve.Message)\r\n\t\treturn\r\n\t}\r\n\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n}\r\n"]
