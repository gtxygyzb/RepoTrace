[1643.877734, "i", "cat > cmd/jobforge/run.go <<'EOF'\npackage main\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n)\n\ntype jobResult struct {\n\tName     string\n\tStatus   string\n\tExitCode int\n\tStdout   string\n\tStderr   string\n}\n\nfunc runSpec(spec *Spec, onFailure string, resultsPath string) int {\n\tlevels := computeLevels(spec)\n\torder := make([]*Job, 0, len(spec.Jobs))\n\tfor _, names := range levels {\n\t\tfor _, name := range names {\n\t\t\torder = append(order, spec.ByName[name])\n\t\t}\n\t}\n\n\tresults := make([]jobResult, len(order))\n\tstatuses := map[string]string{}\n\tshortCircuit := false\n\n\tfor i, job := range order {\n\t\tresults[i].Name = job.Name\n\n\t\tif shortCircuit {\n\t\t\tresults[i].Status = \"skipped\"\n\t\t\tresults[i].ExitCode = -1\n\t\t\tresults[i].Stdout = \"\"\n\t\t\tresults[i].Stderr = \"\"\n\t\t\tstatuses[job.Name] = \"skipped\"\n\t\t\tcontinue\n\t\t}\n\n\t\tskip := false\n\t\tfor _, dep := range job.Deps {\n\t\t\tif statuses[dep] != \"ok\" {\n\t\t\t\tskip = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif skip {\n\t\t\tresults[i].Status = \"skipped\"\n\t\t\tres"]
[1643.877991, "i", "ults[i].ExitCode = -1\n\t\t\tresults[i].Stdout = \"\"\n\t\t\tresults[i].Stderr = \"\"\n\t\t\tstatuses[job.Name] = \"skipped\"\n\t\t\tcontinue\n\t\t}\n\n\t\tstdout, stderr, exitCode := runJob(job)\n\t\tresults[i].Stdout = stdout\n\t\tresults[i].Stderr = stderr\n\t\tresults[i].ExitCode = exitCode\n\n\t\tif exitCode == 0 {\n\t\t\tresults[i].Status = \"ok\"\n\t\t\tstatuses[job.Name] = \"ok\"\n\t\t} else {\n\t\t\tresults[i].Status = \"failed\"\n\t\t\tstatuses[job.Name] = \"failed\"\n\t\t\tif onFailure == \"stop\" {\n\t\t\t\tshortCircuit = true\n\t\t\t}\n\t\t}\n\t}\n\n\tif resultsPath != \"\" {\n\t\tif err := writeResults(resultsPath, onFailure, results); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"error: results_write: %s\\n\", err)\n\t\t\treturn 2\n\t\t}\n\t}\n\n\tfor _, r := range results {\n\t\tif r.Status != \"ok\" {\n\t\t\treturn 1\n\t\t}\n\t}\n\treturn 0\n}\n\nfunc runJob(job *Job) (string, string, int) {\n\tcmd := exec.Command(\"bash\", \"-c\", job.Command)\n\tcmd.Dir = job.Workdir\n\n\tenvMap := map[string]string{}\n\tfor _, kv := range os.Environ() {\n\t\tif idx := strings.IndexByte(kv, '='); idx >= 0 {\n\t\t\tenvMap[kv[:idx]] = kv[idx+1:]\n\t\t}\n\t}\n\tfor k, v"]
[1643.878093, "i", " := range job.Env {\n\t\tenvMap[k] = v\n\t}\n\tenvMap[\"JOBFORGE_JOB_NAME\"] = job.Name\n\tresolvedWorkdir, err := filepath.Abs(job.Workdir)\n\tif err != nil {\n\t\tresolvedWorkdir = job.Workdir\n\t}\n\tenvMap[\"JOBFORGE_JOB_WORKDIR\"] = resolvedWorkdir\n\n\tenv := make([]string, 0, len(envMap))\n\tfor k, v := range envMap {\n\t\tenv = append(env, k+\"=\"+v)\n\t}\n\tsort.Strings(env)\n\tcmd.Env = env\n\n\tvar stdoutBuf, stderrBuf bytes.Buffer\n\tcmd.Stdout = &stdoutBuf\n\tcmd.Stderr = &stderrBuf\n\n\terr = cmd.Run()\n\tif err != nil && cmd.ProcessState == nil {\n\t\treturn sanitizeOutput(stdoutBuf.Bytes()), sanitizeOutput(stderrBuf.Bytes()), 127\n\t}\n\texitCode := 0\n\tif cmd.ProcessState != nil {\n\t\texitCode = exitCodeFromProcessState(cmd.ProcessState)\n\t}\n\treturn sanitizeOutput(stdoutBuf.Bytes()), sanitizeOutput(stderrBuf.Bytes()), exitCode\n}\n\nfunc exitCodeFromProcessState(ps *os.ProcessState) int {\n\tif status, ok := ps.Sys().(syscall.WaitStatus); ok {\n\t\tif status.Exited() {\n\t\t\treturn status.ExitStatus()\n\t\t}\n\t\tif status.Signaled() {\n\t\t\treturn 128 + int(status.Signal"]
