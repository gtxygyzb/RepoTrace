[2074.505806, "o", "\t\tprintValidationError(err)\r\n    90\t\t\treturn 2\r\n    91\t\t}\r\n    92\t\r\n    93\t\treturn runSpec(spec, *onFailure, *resultsPath)\r\n    94\t}\r\n    95\t\r\n    96\tfunc printValidationError(err error) {\r\n    97\t\tif ve, ok := err.(*ValidationError); ok {\r\n    98"]
