[8162.741921, "o", "cmd/jobforge/critical.go\r\ncmd/jobforge/cycle.go\r\ncmd/jobforge/diff.go\r\ncmd/jobforge/graph.go\r\ncmd/jobforge/hash.go\r\ncmd/jobforge/main.go\r\ncmd/jobforge/run.go\r\n"]
[8162.742077, "o", "cmd/jobforge/schedule.go\r\ncmd/jobforge/spec.go\r\n"]
[8162.742484, "o", "\u001b[?2004h"]
[8162.742548, "o", "root@n30009:/app# "]
[8162.990501, "i", "sed -n '1,240p' cmd/jobforge/main.go\n"]
[8162.990821, "o", "sed -n '1,240p' cmd/jobforge/main.go\r\n\u001b[?2004l\r"]
[8162.993764, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n"]
[8162.993862, "o", "\t\"flag\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc main() {"]
[8162.99393, "o", "\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"plan\":\r\n\t\tos.Exit(runPlan(os.Args[2:]))\r\n\tcase \"run\":\r\n\t\tos.Exit(runRun(os.Args[2:]))\r\n\tcase \"validate\":\r\n\t\tos.Exit(runValidate(os.Args[2:]))\r\n\tcase \"list\":\r\n\t\tos.Exit(runList(os.Args[2:]))\r\n\tcase \"graph\":\r\n\t\tos.Exit(runGraph(os.Args[2:]))\r\n"]
[8162.994006, "o", "\tcase \"hash\":\r\n\t\tos.Exit(runHash(os.Args[2:]))\r\n\tcase \"diff\":\r\n\t\tos.Exit(runDiff(os.Args[2:]))\r\n\tcase \"schedule\":\r\n\t\tos.Exit(runSchedule(os.Args[2:]))\r\n\t"]
[8162.994075, "o", "case \"critical\":\r\n\t\tos.Exit(runCritical(os.Args[2:]))\r\n\tdefault:\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n\t\tos.Exit(2)\r\n\t}\r\n}\r\n\r\nfunc runPlan(args []string) int {\r\n\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n"]
[8162.994137, "o", "\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n\t\treturn 2\r\n\t}\r\n\tif *format != \"text\" && *format != \"json\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n"]
[8162.994197, "o", "\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tlevels := computeLevels(spec)\r\n\tswitch *format {\r\n\tcase \"text\":\r\n\t\tfor i, names := range levels {\r\n\t\t\tfmt.Printf(\"level %d: %s\\n\", i, strings.Join(names, \", \"))\r\n\t\t}\r\n"]
[8162.994264, "o", "\tcase \"json\":\r\n\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n\t\tif err != nil {\r\n"]
[8162.994304, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\tos.Stdout.Write(out)\r\n\t\tfmt.Println()\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc runRun(args []string) int {\r\n\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n\tfs.SetOutput(os.Stderr)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n"]
[8162.994388, "o", "\tonFailure := fs.String(\"on-failure\", \"stop\", \"on failure behavior: stop|continue\")\r\n\tresultsPath := fs.String(\"results\", \"\", \"path to results JSON file\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]\")\r\n\t\treturn 2\r\n\t}\r\n\tif *onFailure != \"stop\" && *onFailure != \"continue\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid on-failure: %s\\n\", *onFailure)\r\n\t\treturn 2\r\n\t}\r\n\r\n"]
[8162.994449, "o", "\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\treturn runSpec(spec, *onFailure, *resultsPath)\r\n}\r\n\r\nfunc runValidate(args []string) int {\r\n\tfs := flag.NewFlagSet(\"validate\", flag.ContinueOnError)\r\n"]
[8162.99451, "o", "\tfs.SetOutput(io.Discard)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n\t\treturn 2\r\n\t}\r\n\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n\t\treturn 2\r\n\t}\r\n\tif len(fs.Args()) > 0 {\r\n"]
[8162.994575, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n\t\treturn 2\r\n\t}\r\n\tif _, err := loadSpec(*specPath); err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n"]
[8162.994638, "o", "\t}\r\n\treturn 0\r\n}\r\n\r\nfunc runList(args []string) int {\r\n\tfs := flag.NewFlagSet(\"list\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n\tonly := fs.String(\"only\", \"\", \"comma-separated list of job names\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n\t\treturn 2\r\n\t}\r\n"]
[8162.994697, "o", "\tif *specPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --spec\")\r\n\t\treturn 2\r\n\t}\r\n\tif len(fs.Args()) > 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n\t\treturn 2\r\n\t}\r\n\tif *format != \"text\" && *format != \"json\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")"]
[8162.994765, "o", "\r\n\t\treturn 2\r\n\t}\r\n\r\n\tspec, err := loadSpec(*specPath)\r\n\tif err != nil {\r\n"]
[8162.994823, "o", "\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tselected, err := parseOnlyFilter(spec, *only)\r\n\tif err != nil {\r\n\t\tprintValidationError(err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tjobs, levels := listJobs(spec, selected)\r\n\tswitch *format {\r\n\tcase \"text\":\r\n\t\tos.Stdout.Write(renderListText(jobs, levels))\r\n\tcase \"json\":\r\n"]
[8162.994894, "o", "\t\tos.Stdout.Write(renderListJSON(*specPath, jobs, levels))\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {\r\n\tif only == \"\" {\r\n\t\treturn nil, nil\r\n\t}\r\n"]
[8162.994953, "o", "\r\n\tselected := map[string]bool{}\r\n\tseen := map[string]bool{}\r\n\tfor _, name := range strings.Split(only, \",\") {\r\n\t\tif seen[name] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tseen[name] = true\r\n\r\n"]
[8162.995019, "o", "\t\tjob, ok := spec.ByName[name]\r\n\t\tif !ok {\r\n\t\t\treturn nil, &ValidationError{Code: \"unknown_dep\", Message: \"unknown dep in --only: \" + name}\r\n\t\t}\r\n\t\taddTransitiveDeps(spec, job, selected)\r\n\t}\r\n"]
[8162.995077, "o", "\treturn selected, nil\r\n}\r\n\r\nfunc addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {\r\n\tif selected[job.Name] {\r\n\t\treturn\r\n\t}\r\n\tselected[job.Name] = true\r\n\tfor _, dep := range job.Deps {\r\n\t\taddTransitiveDeps(spec, spec.ByName[dep], selected)\r\n\t}\r\n}\r\n\r\nfunc listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {\r\n\tlevels := computeLevels(spec)\r\n"]
[8162.99514, "o", "\tlevel := make(map[string]int, len(spec.Jobs))\r\n\tfor i, names := range levels {\r\n\t\tfor _, name := range names {\r\n\t\t\tlevel[name] = i\r\n\t\t}\r\n"]
[8162.995198, "o", "\t}\r\n\r\n\torder := make([]*Job, 0, len(spec.Jobs))\r\n\tfor _, names := range levels {\r\n\t\tfor _, name := range names {\r\n\t\t\tif selected != nil && !selected[name] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\torder = append(order, spec.ByName[name])\r\n\t\t}\r\n\t}\r\n\treturn order, level\r\n}\r\n\r\nfunc renderListText(jobs []*Job, level map[string]int) []byte {\r\n\tvar b strings.Builder\r\n"]
[8162.995261, "o", "\tfor _, job := range jobs {\r\n\t\tb.WriteString(job.Name)\r\n\t\tb.WriteString(\"\\tlevel=\")\r\n\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n"]
[8162.995735, "o", "\u001b[?2004h"]
[8162.995792, "o", "root@n30009:/app# "]
[8163.278682, "i", "sed -n '1,260p' cmd/jobforge/spec.go\n"]
[8163.279041, "o", "sed -n '1,260p' cmd/jobforge/spec.go\r\n\u001b[?2004l\r"]
[8163.282386, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"regexp\"\r\n"]
[8163.282503, "o", "\t\"sort\"\r\n)\r\n\r\ntype Job struct {\r\n\tIndex   int\r\n\tName    string\r\n\tCommand string\r\n\tDeps    []string\r\n\tWorkdir string\r\n\tEnv     map[string]string\r\n"]
[8163.282589, "o", "}\r\n\r\ntype Spec struct {\r\n\tJobs   []*Job\r\n\tByName map[string]*Job\r\n}\r\n\r\ntype ValidationError struct {\r\n\tCode    string\r\n\tMessage string\r\n}\r\n\r\nfunc (e *ValidationError) Error() string {\r\n\treturn e.Code + \": \" + e.Message\r\n}\r\n\r\nvar (\r\n\tnameRegexp   = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_-]*$`)\r\n\tenvKeyRegexp = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)\r\n)\r\n\r\nfunc loadSpec(path string) (*Spec, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, &ValidationError{Code: \"spec_not_found\", Message: fmt.Sprintf(\"cannot read spec: %s\", path)}\r\n\t}\r\n\r\n"]
[8163.282686, "o", "\tvar top map[string]json.RawMessage\r\n\tif err := json.Unmarshal(data, &top); err != nil || top == nil {\r\n\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"top-level JSON must be an object\"}\r\n\t}\r\n\r\n\trawJobs, ok := top[\"jobs\"]\r\n\tif !ok {\r\n\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"missing jobs\"}\r\n\t}\r\n\r\n\tvar jobsRaw []json.RawMessage\r\n\tif err := json.Unmarshal(rawJobs, &jobsRaw); err != nil || jobsRaw == nil {\r\n\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: \"jobs must be an array\"}\r\n\t}\r\n\r\n\tvar unknownTop []string\r\n\tfor k := range top {\r\n\t\tif k != \"jobs\" {\r\n"]
[8163.282765, "o", "\t\t\tunknownTop = append(unknownTop, k)\r\n\t\t}\r\n\t}\r\n\tif len(unknownTop) > 0 {\r\n\t\tsort.Strings(unknownTop)\r\n\t\treturn nil, &ValidationError{Code: \"unknown_field\", Message: \"unknown field: \" + unknownTop[0]}\r\n\t}\r\n\r\n\tjobMaps := make([]map[string]json.RawMessage, len(jobsRaw))\r\n\tfor i, raw := range jobsRaw {\r\n\t\tvar m map[string]json.RawMessage\r\n\t\tif err := json.Unmarshal(raw, &m); err != nil || m == nil {\r\n"]
[8163.282831, "o", "\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d] must be an object\", i)}\r\n\t\t}\r\n\t\tjobMaps[i] = m\r\n\t}\r\n\r\n\tjobs := make([]*Job, len(jobMaps))\r\n\tfor i, m := range jobMaps {\r\n\t\tjob := &Job{\r\n\t\t\tIndex:   i,\r\n\t\t\tDeps:    []string{},\r\n"]
[8163.282917, "o", "\t\t\tEnv:     map[string]string{},\r\n\t\t\tWorkdir: \"/app\",\r\n\t\t}\r\n\r\n\t\tif raw, ok := m[\"name\"]; ok {\r\n\t\t\tvar s string\r\n\t\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].name must be a string\", i)}\r\n\t\t\t}\r\n\t\t\tjob.Name = s\r\n\t"]
[8163.282983, "o", "\t}\r\n\t\tif raw, ok := m[\"command\"]; ok {\r\n\t\t\tvar s string\r\n\t\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].command must be a string\", i)}\r\n\t\t\t}\r\n\t\t\tjob.Command = s\r\n\t\t}\r\n\t\tif raw, ok := m[\"deps\"]; ok {\r\n"]
[8163.283047, "o", "\t\t\tvar arr []string\r\n\t\t\tif err := json.Unmarshal(raw, &arr); err != nil || arr == nil {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].deps must be an array of strings\", i)}\r\n\t\t\t}\r\n\t\t\tjob.Deps = arr\r\n\t\t}\r\n\t\tif raw, ok := m[\"workdir\"]; ok {\r\n\t\t\tvar s string\r\n\t\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n"]
[8163.283108, "o", "\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].workdir must be a string\", i)}\r\n\t\t\t}\r\n\t\t\tjob.Workdir = s\r\n\t\t}\r\n\t\tif raw, ok := m[\"env\"]; ok {\r\n\t\t\tenv := map[string]string{}\r\n\t\t\tif err := json.Unmarshal(raw, &env); err != nil || env == nil {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"spec_parse\", Message: fmt.Sprintf(\"jobs[%d].env must be an object of strings\", i)}\r\n"]
[8163.283175, "o", "\t\t\t}\r\n\t\t\tjob.Env = env\r\n\t\t}\r\n\t\tjobs[i] = job\r\n\t}\r\n\r\n\tfor i, m := range jobMaps {\r\n"]
[8163.283238, "o", "\t\tvar unknown []string\r\n\t\tfor k := range m {\r\n\t\t\tif !isKnownJobField(k) {\r\n\t\t\t\tunknown = append(unknown, k)\r\n\t\t\t}\r\n\t\t}\r\n\t\tif len(unknown) > 0 {\r\n\t\t\tsort.Strings(unknown)\r\n\t\t\treturn nil, &ValidationError{Code: \"unknown_field\", Message: fmt.Sprintf(\"unknown field: jobs[%d].%s\", i, unknown[0])}\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, job := range jobs {\r\n\t\tif _, ok := jobMaps[job.Index][\"name\"]; !ok {\r\n"]
[8163.283303, "o", "\t\t\treturn nil, &ValidationError{Code: \"invalid_name\", Message: \"invalid name: <missing>\"}\r\n\t\t}\r\n\t\tif !nameRegexp.MatchString(job.Name) {\r\n\t\t\treturn nil, &ValidationError{Code: \"invalid_name\", Message: \"invalid name: \" + job.Name}\r\n\t\t}\r\n\t}\r\n\r\n\tseen := map[string]bool{}\r\n\tfor _, job := range jobs {\r\n\t\tif seen[job.Name] {\r\n"]
[8163.28337, "o", "\t\t\treturn nil, &ValidationError{Code: \"duplicate_name\", Message: \"duplicate name: \" + job.Name}\r\n\t\t}\r\n\t\tseen[job.Name] = true\r\n\t}\r\n\r\n\tfor _, job := range jobs {\r\n\t\tif _, ok := jobMaps[job.Index][\"command\"]; !ok {\r\n\t\t\treturn nil, &ValidationError{Code: \"invalid_command\", Message: \"invalid command for \" + job.Name}\r\n\t\t}\r\n\t\tif job.Command == \"\" {\r\n"]
[8163.283431, "o", "\t\t\treturn nil, &ValidationError{Code: \"invalid_command\", Message: \"invalid command for \" + job.Name}\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, job := range jobs {\r\n\t\tkeys := make([]string, 0, len(job.Env))\r\n\t\tfor k := range job.Env {\r\n\t\t\tkeys = append(keys, k)\r\n\t\t}\r\n\t\tsort.Strings(keys)\r\n"]
[8163.283501, "o", "\t\tfor _, k := range keys {\r\n\t\t\tif !envKeyRegexp.MatchString(k) {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"invalid_env_key\", Message: \"invalid env key in \" + job.Name + \": \" + k}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tspec := &Spec{Jobs: jobs, ByName: map[string]*Job{}}\r\n\tfor _, job := range jobs {\r\n\t\tspec.ByName[job.Name] = job\r\n\t}\r\n\r\n"]
[8163.283565, "o", "\tfor _, job := range jobs {\r\n\t\tfor _, dep := range job.Deps {\r\n\t\t\tif _, ok := spec.ByName[dep]; !ok {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"unknown_dep\", Message: \"unknown dep in \" + job.Name + \": \" + dep}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, job := range jobs {\r\n\t\tseenDeps := map[string]bool{}\r\n"]
[8163.283625, "o", "\t\tfor _, dep := range job.Deps {\r\n\t\t\tif seenDeps[dep] {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"duplicate_dep\", Message: \"duplicate dep in \" + job.Name + \": \" + dep}\r\n"]
[8163.28369, "o", "\t\t\t}\r\n\t\t\tseenDeps[dep] = true\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, job := range jobs {\r\n\t\tfor _, dep := range job.Deps {\r\n\t\t\tif dep == job.Name {\r\n\t\t\t\treturn nil, &ValidationError{Code: \"self_dep\", Message: \"self dep: \" + job.Name}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif err := detectCycle(spec); err != nil {\r\n\t\treturn nil, err\r\n"]
[8163.283754, "o", "\t}\r\n\r\n\treturn spec, nil\r\n}\r\n\r\nfunc isKnownJobField(k string) bool {\r\n\tswitch k {\r\n\tcase \"name\", \"command\", \"deps\", \"workdir\", \"env\":\r\n\t\treturn true\r\n\t}\r\n\treturn false\r\n}"]
[8163.283811, "o", "\r\n\r\nfunc computeLevels(spec *Spec) [][]string {\r\n\tlevel := map[string]int{}\r\n\r\n\tvar dfs func(job *Job) int\r\n\tdfs = func(job *Job) int {\r\n\t\tif l, ok := level[job.Name]; ok {\r\n\t\t\treturn l\r\n\t\t}\r\n"]
[8163.283889, "o", "\t\tmaxDep := -1\r\n\t\tfor _, dep := range job.Deps {\r\n\t\t\tl := dfs(spec.ByName[dep])\r\n\t\t\tif l > maxDep {\r\n\t\t\t\tmaxDep = l\r\n\t\t\t}\r\n\t\t}\r\n\t\tlevel[job.Name] = maxDep + 1\r\n\t\treturn level[job.Name]\r\n\t}\r\n"]
[8163.283948, "o", "\r\n\tfor _, job := range spec.Jobs {\r\n\t\tdfs(job)\r\n\t}\r\n\r\n\tmaxLevel := -1\r\n\tfor _, l := range level {\r\n\t\tif l > maxLevel {\r\n\t\t\tmaxLevel = l\r\n"]
[8163.284006, "o", "\t\t}\r\n\t}\r\n\r\n\tlevels := make([][]string, maxLevel+1)\r\n\tfor _, job := range spec.Jobs {\r\n\t\tlevels[level[job.Name]] = append(levels[level[job.Name]], job.Name)\r\n\t}\r\n\tfor _, names := range levels {\r\n\t\tsort.Strings(names)\r\n"]
[8163.284537, "o", "\u001b[?2004h"]
[8163.284603, "o", "root@n30009:/app# "]
[8163.56155, "i", "grep -R \"func cmdPlan\\|plan\\|level\" -n cmd/jobforge\n"]
