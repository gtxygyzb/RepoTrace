[5816.235874, "o", "    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc main() {\r\n    16\t\tif len(os.Args) < 2 {\r\n    17\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    18\t\t\tos.Exit(2)\r\n    19\t\t}\r\n    20\t\r\n    21\t\tswitch os.Args[1] {\r\n    22\t\tcase \"plan\":\r\n    23\t\t\tos.Exit(runPlan(os.Args[2:]))\r\n    24\t\tcase \"run\":\r\n    25\t\t\tos.Exit(runRun(os.Args[2:]))\r\n    26\t\tcase \"validate\":\r\n    27\t\t\tos.Exit(runValidate(os.Args[2:]))\r\n    28\t\tcase \"list\":\r\n    29\t\t\tos.Exit(runList(os.Args[2:]))\r\n    30\t\tcase \"graph\":\r\n    31\t\t\tos.Exit(runGraph(os.Args[2:]))\r\n"]
[5816.236025, "o", "    32\t\tcase \"hash\":\r\n    33\t\t\tos.Exit(runHash(os.Args[2:]))\r\n    34\t\tcase \"diff\":\r\n    35\t\t\tos.Exit(runDiff(os.Args[2:]))\r\n    36\t\tdefault:\r\n    37\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    38\t\t\tos.Exit(2)\r\n    39\t\t}\r\n    40\t}\r\n    41\t\r\n    42\tfunc runPlan(args []string) int {\r\n    43\t\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n    44\t\tfs.SetOutput(os.Stderr)\r\n    45\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    46\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n    47\t\tif err := fs.Parse(args); err != nil {\r\n    48\t\t\treturn 2\r\n    49\t\t}\r\n"]
[5816.236107, "o", "    50\t\tif *specPath == \"\" {\r\n    51\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n    52\t\t\treturn 2\r\n    53\t\t}\r\n    54\t\tif *format != \"text\" && *format != \"json\" {\r\n    55\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n    56\t\t\treturn 2\r\n    57\t\t}\r\n    58\t\r\n    59\t\tspec, err := loadSpec(*specPath)\r\n    60\t\tif err != nil {"]
