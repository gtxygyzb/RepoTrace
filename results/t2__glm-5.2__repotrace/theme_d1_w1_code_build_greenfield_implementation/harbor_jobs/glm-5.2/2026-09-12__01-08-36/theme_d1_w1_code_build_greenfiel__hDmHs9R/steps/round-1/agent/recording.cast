[3281.025275, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\""]
[3281.025364, "o", "\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list|graph> --spec <path> [flags]\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"plan\":\r\n\t\tos.Exit(runPlan(os.Args[2:]))\r\n"]
[3281.025445, "o", "\tcase \"run\":\r\n\t\tos.Exit(runRun(os.Args[2:]))\r\n\tcase \"validate\":\r\n\t\tos.Exit(runValidate(os.Args[2:]))\r\n\tcase \"list\":\r\n\t\tos.Exit(runList(os.Args[2:]))\r\n\tcase \"graph\":\r\n\t\tos.Exit(runGraph(os.Args[2:]))\r\n\tdefault:\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list|graph> --spec <path> [flags]\")\r\n\t\tos.Exit(2)\r\n\t}\r\n"]
