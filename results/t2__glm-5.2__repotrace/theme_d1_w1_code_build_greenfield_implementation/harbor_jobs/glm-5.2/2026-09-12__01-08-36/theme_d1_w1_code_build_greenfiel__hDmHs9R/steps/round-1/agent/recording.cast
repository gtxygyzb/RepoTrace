[2074.505255, "o", "     9\t)\r\n    10\t\r\n    11\tfunc main() {\r\n    12\t\tif len(os.Args) < 2 {\r\n    13\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run> --spec <path> [flags]\")\r\n    14\t\t\tos.Exit(2)\r\n    15\t\t}\r\n    16\t\r\n    17\t\tswitch os.Args[1] {\r\n    18\t\tcase \"plan\":\r\n    19\t\t\tos.Exit(runPlan(os.Args[2:]))\r\n    20\t\tcase \"run\":\r\n    21\t"]
[2074.50532, "o", "\t\tos.Exit(runRun(os.Args[2:]))\r\n    22\t\tdefault:\r\n    23\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run> --spec <path> [flags]\")\r\n    24\t\t\tos.Exit(2)\r\n    25\t\t}\r\n    26\t}\r\n    27\t\r\n    28\tfunc runPlan(args []string) int {\r\n    29\t\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n"]
[2074.505391, "o", "    30\t\tfs.SetOutput(os.Stderr)\r\n    31\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    32\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n    33\t\tif err := fs.Parse(args); err != nil {\r\n    34\t\t\treturn 2\r\n    35\t\t}\r\n    36\t\tif *specPath == \"\" {\r\n    37\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n    38\t\t\treturn 2\r\n    39\t\t}\r\n    40\t\tif *format != \"text\" && *format != \"json\" {\r\n    41\t"]
[2074.50545, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n    42\t\t\treturn 2\r\n    43\t\t}\r\n    44\t\r\n    45\t\tspec, err := loadSpec(*specPath)\r\n    46\t\tif err != nil {\r\n    47\t\t\tprintValidationError(err)\r\n    48\t\t\treturn 2\r\n    49\t\t}\r\n"]
[2074.505508, "o", "    50\t\r\n    51\t\tlevels := computeLevels(spec)\r\n    52\t\tswitch *format {\r\n    53\t\tcase \"text\":\r\n    54\t\t\tfor i, names := range levels {\r\n    55\t\t\t\tfmt.Printf(\"level %d: %s\\n\", i, strings.Join(names, \", \"))\r\n    56\t\t\t}\r\n"]
[2074.505565, "o", "    57\t\tcase \"json\":\r\n    58\t\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n    59\t\t\tif err != nil {\r\n    60\t\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n    61\t\t\t\treturn 2\r\n    62\t\t\t}\r\n"]
[2074.505633, "o", "    63\t\t\tos.Stdout.Write(out)\r\n    64\t\t\tfmt.Println()\r\n    65\t\t}\r\n    66\t\treturn 0\r\n    67\t}\r\n    68\t\r\n    69\tfunc runRun(args []string) int {\r\n    70\t\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n    71\t\tfs.SetOutput(os.Stderr)\r\n    72\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    73\t"]
[2074.505692, "o", "\tonFailure := fs.String(\"on-failure\", \"stop\", \"on failure behavior: stop|continue\")\r\n    74\t\tresultsPath := fs.String(\"results\", \"\", \"path to results JSON file\")\r\n    75\t\tif err := fs.Parse(args); err != nil {\r\n    76\t\t\treturn 2\r\n    77\t\t}\r\n    78\t\tif *specPath == \"\" {\r\n    79\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]\")\r\n    80\t\t\treturn 2\r\n    81\t\t}\r\n"]
