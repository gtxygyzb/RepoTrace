[2871.769604, "o", "    39\t\t\tif shortCircuit {\r\n    40\t\t\t\tresults[i].Status = \"skipped\"\r\n    41\t\t\t\tresults[i].ExitCode = -1\r\n    42\t\t\t\tresults[i].Stdout = \"\"\r\n    43\t\t\t\tresults[i].Stderr = \"\"\r\n    44\t\t\t\tstatuses[job.Name] = \"skipped\"\r\n    45\t\t\t\tcontinue\r\n    46\t\t\t}\r\n    47\t\r\n    48\t\t\tskip := false\r\n    49\t\t\tfor _, dep := range job.Deps {\r\n    50\t\t\t\tif statuses[dep] != \"ok\" {\r\n    51\t\t\t\t\tskip = true\r\n    52\t\t\t\t\tbreak\r\n"]
