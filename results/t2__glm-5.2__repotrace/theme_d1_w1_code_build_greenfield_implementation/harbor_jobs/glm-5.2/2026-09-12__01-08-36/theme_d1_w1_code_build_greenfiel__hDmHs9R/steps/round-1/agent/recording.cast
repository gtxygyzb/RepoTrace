[4700.894818, "o", "    86\t\t\tb.WriteString(\"\\t\\\"\")\r\n    87\t\t\tb.WriteString(dotQuote(job.Name))\r\n    88\t\t\tb.WriteString(\"\\\" [level=\\\"\")\r\n    89\t\t\tb.WriteString(strconv.Itoa(level[job.Name]))\r\n    90\t\t\tb.WriteString(\"\\\",workdir=\\\"\")\r\n    91\t\t\tb.WriteString(dotQuote(job.Workdir))\r\n    92\t\t\tb.WriteString(\"\\\"];\\n\")\r\n"]
[4700.894831, "o", "    93\t\t}\r\n    94\t\tfor _, e := range edges {\r\n"]
[4700.894911, "o", "    95\t\t\tb.WriteString(\"\\t\\\"\")\r\n    96\t\t\tb.WriteString(dotQuote(e.dep))\r\n    97\t\t\tb.WriteString(\"\\\" -> \\\"\")\r\n    98\t\t\tb.WriteString(dotQuote(e.name))\r\n    99\t\t\tb.WriteString(\"\\\";\\n\")\r\n   100\t\t}\r\n"]
[4700.894924, "o", "   101\t\tb.WriteString(\"}\\n\")\r\n   102\t\treturn []byte(b.String())\r\n"]
[4700.894988, "o", "   103\t}\r\n   104\t\r\n   105\tfunc renderMermaid(jobs []*Job, edges []graphEdge) []byte {\r\n   106\t\tvar b strings.Builder\r\n   107\t\tb.WriteString(\"graph LR\\n\")\r\n   108\t\tb.WriteString(\"\\t%% nodes=\")\r\n   109\t\tb.WriteString(strconv.Itoa(len(jobs)))\r\n   110\t\tb.WriteString(\" edges=\")\r\n   111\t\tb.WriteString(strconv.Itoa(len(edges)))\r\n   112\t\tb.WriteString(\"\\n\")\r\n   113\t\t"]
[4700.895001, "o", "for _, job := range jobs {\r\n   114\t\t\tb.WriteString(\"\\t\")\r\n"]
[4700.895064, "o", "   115\t\t\tb.WriteString(mermaidID(job.Name))\r\n   116\t\t\tb.WriteString(\"[\\\"\")\r\n   117\t\t\tb.WriteString(mermaidLabel(job.Name))\r\n   118\t\t\tb.WriteString(\"\\\"]\\n\")\r\n   119\t\t}\r\n   120\t\tfor _, e := range edges {\r\n   121\t\t\tb.WriteString(\"\\t\")\r\n"]
[4700.895111, "o", "   122\t\t\tb.WriteString(mermaidID(e.dep))\r\n   123\t\t\tb.WriteString(\" --> \")\r\n   124\t\t\tb.WriteString(mermaidID(e.name))\r\n"]
[4700.895124, "o", "   125\t\t\tb.WriteString(\"\\n\")\r\n   126\t\t}\r\n   127\t\treturn []byte(b.String())\r\n   128\t}\r\n"]
[4700.8952, "o", "   129\t\r\n   130\tfunc dotQuote(s string) string {\r\n   131\t\tvar b strings.Builder\r\n   132\t\tfor i := 0; i < len(s); i++ {\r\n   133\t\t\tc := s[i]\r\n   134\t\t\tswitch c {\r\n   135\t\t\tcase '\"':\r\n   136\t\t\t\tb.WriteString(`\\\"`)\r\n   137\t\t\tcase '\\\\':\r\n   138\t\t\t\tb.WriteString(`\\\\`)\r\n   139\t\t\tdefault:\r\n   140\t\t\t\tb.WriteByte(c)\r\n   141\t\t\t}\r\n"]
[4700.895214, "o", "   142\t\t}\r\n   143\t"]
[4700.895224, "o", "\treturn b.String()\r\n   144\t}\r\n"]
[4700.895317, "o", "   145\t\r\n   146\tfunc mermaidID(name string) string {\r\n   147\t\tvar b strings.Builder\r\n   148\t\tfor i := 0; i < len(name); i++ {\r\n   149\t\t\tc := name[i]\r\n   150\t\t\tif (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' {\r\n   151\t\t\t\tb.WriteByte(c)\r\n"]
[4700.89533, "o", "   152\t\t\t} else {\r\n   153\t\t\t\tb.WriteByte('_')\r\n   154\t\t\t}\r\n   155\t\t}\r\n   156\t\treturn b.String()\r\n   157\t}\r\n   158\t\r\n   159\tfunc mermaidLabel(name string) string {\r\n"]
[4700.895394, "o", "   160\t\tvar b strings.Builder\r\n   161\t\tfor i := 0; i < len(name); i++ {\r\n   162\t\t\tc := name[i]\r\n   163\t\t\tif c == '\"' {\r\n   164\t\t\t\tb.WriteString(\"#quot;\")\r\n   165\t\t\t} else {\r\n   166\t\t\t\tb.WriteByte(c)\r\n   167\t\t\t}\r\n   168\t\t}\r\n"]
[4700.895406, "o", "   169\t\treturn b.String()\r\n   170\t}\r\n"]
