[2880.193714, "o", "     7\t\t\"os/exec\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t\t\"syscall\"\r\n    13\t)\r\n    14\t\r\n    15\ttype jobResult struct {\r\n    16\t\tName     string\r\n    17\t\tStatus   string\r\n    18\t\tExitCode int\r\n    19\t\tStdout   string\r\n    20\t\tStderr   string\r\n    21\t}\r\n    22\t\r\n    23\tfunc runSpec(spec *Spec, onFailure string, resultsPath string) int {\r\n"]
[2880.193781, "o", "    24\t\tlevels := computeLevels(spec)\r\n    25\t\torder := make([]*Job, 0, len(spec.Jobs))\r\n    26\t\tfor _, names := range levels {\r\n    27\t\t\tfor _, name := range names {\r\n    28\t\t\t\torder = append(order, spec.ByName[name])\r\n    29\t\t\t}\r\n    30\t\t}\r\n    31\t\r\n    32\t"]
[2880.193813, "o", "\tresults := make([]jobResult, len(order))\r\n    33\t\tstatuses := map[string]string{}\r\n    34\t\tshortCircuit := false\r\n    35\t\r\n    36\t\tfor i, job := range order {\r\n"]
[2880.193918, "o", "    37\t\t\tresults[i].Name = job.Name\r\n    38\t\r\n    39\t\t\tif shortCircuit {\r\n    40\t\t\t\tresults[i].Status = \"skipped\"\r\n    41\t\t\t\tresults[i].ExitCode = -1\r\n    42\t\t\t\tresults[i].Stdout = \"\"\r\n    43\t\t\t\tresults[i].Stderr = \"\"\r\n    44\t\t\t\tstatuses[job.Name] = \"skipped\"\r\n    45\t\t\t\tcontinue\r\n    46\t\t\t}\r\n    47\t\r\n    48\t\t\tskip := false\r\n    49\t\t\tfor _, dep := range job.Deps {\r\n"]
