[9024.828565, "o", "   225\tfunc computeLevels(spec *Spec) [][]string {\r\n   226\t\tlevel := map[string]int{}\r\n   227\t\r\n   228\t\tvar dfs func(job *Job) int\r\n   229\t\tdfs = func(job *Job) int {\r\n   230\t\t\tif l, ok := level[job.Name]; ok {\r\n   231\t\t\t\treturn l\r\n   232\t\t\t}\r\n   233\t\t\tmaxDep := -1\r\n   234\t\t\tfor _, dep := range job.Deps {\r\n   235\t\t\t\tl := dfs(spec.ByName[dep])\r\n   236\t\t\t\tif l > maxDep {\r\n   237\t\t\t\t\tmaxDep = l\r\n   238\t\t\t\t}\r\n"]
[9024.828784, "o", "   239\t\t\t}\r\n   240\t\t\tlevel[job.Name] = maxDep + 1\r\n   241\t\t\treturn level[job.Name]\r\n   242\t\t}\r\n   243\t\r\n   244\t\tfor _, job := range spec.Jobs {\r\n   245\t\t\tdfs(job)\r\n   246\t\t}\r\n   247\t\r\n   248\t\tmaxLevel := -1\r\n   249\t\tfor _, l := range level {\r\n   250\t\t\tif l > maxLevel {\r\n   251\t\t\t\tmaxLevel = l\r\n   252\t\t\t}\r\n   253\t\t}\r\n   254\t\r\n   255\t\tlevels := make([][]string, maxLevel+1)\r\n   256\t\tfor _, job := range spec.Jobs {\r\n   257\t\t\tlevels[level[job.Name]] = append(levels[level[job.Name]], job.Name)\r\n   258\t\t}\r\n   259\t\tfor _, names := range levels {\r\n   260\t\t\tsort.Strings(names)\r\n   261\t\t}\r\n   262\t\treturn levels\r\n   263\t}\r\n"]
