[1643.534986, "i", "cat > cmd/jobforge/cycle.go <<'EOF'\npackage main\n\nimport (\n\t\"sort\"\n\t\"strings\"\n)\n\nfunc detectCycle(spec *Spec) *ValidationError {\n\tadj := map[string][]string{}\n\tfor _, job := range spec.Jobs {\n\t\tdeps := append([]string(nil), job.Deps...)\n\t\tsort.Strings(deps)\n\t\tadj[job.Name] = deps\n\t}\n\n\tindex := 0\n\tstack := []string{}\n\tonStack := map[string]bool{}\n\tindices := map[string]int{}\n\tlow := map[string]int{}\n\tvar sccs [][]string\n\n\tvar strongconnect func(v string)\n\tstrongconnect = func(v string) {\n\t\tindices[v] = index\n\t\tlow[v] = index\n\t\tindex++\n\t\tstack = append(stack, v)\n\t\tonStack[v] = true\n\n\t\tfor _, w := range adj[v] {\n\t\t\tif _, ok := indices[w]; !ok {\n\t\t\t\tstrongconnect(w)\n\t\t\t\tif low[w] < low[v] {\n\t\t\t\t\tlow[v] = low[w]\n\t\t\t\t}\n\t\t\t} else if onStack[w] {\n\t\t\t\tif indices[w] < low[v] {\n\t\t\t\t\tlow[v] = indices[w]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tif low[v] == indices[v] {\n\t\t\tvar scc []string\n\t\t\tfor {\n\t\t\t\tw := stack[len(stack)-1]\n\t\t\t\tstack = stack[:len(stack)-1]\n\t\t\t\tonStack[w] = false\n\t\t\t\tscc = append(scc, w)\n\t\t\t\tif w == v {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n"]
[1643.535052, "i", "\t\t\tsccs = append(sccs, scc)\n\t\t}\n\t}\n\n\tnames := make([]string, 0, len(spec.Jobs))\n\tfor _, job := range spec.Jobs {\n\t\tnames = append(names, job.Name)\n\t}\n\tsort.Strings(names)\n\tfor _, name := range names {\n\t\tif _, ok := indices[name]; !ok {\n\t\t\tstrongconnect(name)\n\t\t}\n\t}\n\n\tcyclicSCC := map[string]bool{}\n\tvar start string\n\tfor _, scc := range sccs {\n\t\tif len(scc) > 1 {\n\t\t\tsorted := append([]string(nil), scc...)\n\t\t\tsort.Strings(sorted)\n\t\t\tfor _, n := range sorted {\n\t\t\t\tcyclicSCC[n] = true\n\t\t\t}\n\t\t\tif start == \"\" || sorted[0] < start {\n\t\t\t\tstart = sorted[0]\n\t\t\t}\n\t\t}\n\t}\n\n\tif start == \"\" {\n\t\treturn nil\n\t}\n\n\tinStartSCC := map[string]bool{}\n\tfor _, scc := range sccs {\n\t\tif len(scc) > 1 {\n\t\t\tfor _, n := range scc {\n\t\t\t\tif n == start {\n\t\t\t\t\tfor _, n2 := range scc {\n\t\t\t\t\t\tinStartSCC[n2] = true\n\t\t\t\t\t}\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tpath := findCyclePath(start, adj, inStartSCC)\n\treturn &ValidationError{Code: \"cycle\", Message: path}\n}\n\nfunc findCyclePath(start string, adj map[string][]string, inSCC map[string]bool) string {\n\tpat"]
[1643.535255, "i", "h := []string{start}\n\tvisited := map[string]bool{}\n\n\tvar dfs func() bool\n\tdfs = func() bool {\n\t\tcur := path[len(path)-1]\n\t\tfor _, next := range adj[cur] {\n\t\t\tif !inSCC[next] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif next == start {\n\t\t\t\tpath = append(path, start)\n\t\t\t\treturn true\n\t\t\t}\n\t\t\tif visited[next] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tvisited[next] = true\n\t\t\tpath = append(path, next)\n\t\t\tif dfs() {\n\t\t\t\treturn true\n\t\t\t}\n\t\t\tpath = path[:len(path)-1]\n\t\t\tdelete(visited, next)\n\t\t}\n\t\treturn false\n\t}\n\n\tif dfs() {\n\t\treturn strings.Join(path, \" -> \")\n\t}\n\treturn start\n}\nEOF\n"]
