[7395.524422, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n"]
[7395.524538, "o", "\t\"os\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"plan\":\r\n\t\tos.Exit(runPlan(os.Args[2:]))\r\n\tcase \"run\":\r\n\t\tos.Exit(runRun(os.Args[2:]))\r\n\tcase \"validate\":\r\n\t\tos.Exit(runValidate(os.Args[2:]))\r\n\tcase \"list\":\r\n\t\tos.Exit(runList(os.Args[2:]))\r\n\tcase \"graph\":\r\n"]
[7395.524619, "o", "\t\tos.Exit(runGraph(os.Args[2:]))\r\n\tcase \"hash\":\r\n\t\tos.Exit(runHash(os.Args[2:]))\r\n\tcase \"diff\":\r\n\t\tos.Exit(runDiff(os.Args[2:]))\r\n\tcase \"schedule\":\r\n\t\tos.Exit(runSchedule(os.Args[2:]))\r\n\tcase \"critical\":\r\n\t\tos.Exit(runCritical(os.Args[2:]))\r\n\tdefault:\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n\t\tos.Exit(2)\r\n\t}\r\n}\r\n"]
[7395.524664, "o", "\r\n"]
