[8176.958975, "o", "   180\t\tfor _, job := range jobs {\r\n   181\t\t\tspec.ByName[job.Name] = job\r\n   182\t\t}\r\n   183\t\r\n   184\t\tfor _, job := range jobs {\r\n   185\t\t\tfor _, dep := range job.Deps {\r\n   186\t\t\t\tif _, ok := spec.ByName[dep]; !ok {\r\n   187\t\t\t\t\treturn nil, &ValidationError{Code: \"unknown_dep\", Message: \"unknown dep in \" + job.Name + \": \" + dep}\r\n   188\t\t\t\t}\r\n   189\t\t\t}\r\n"]
[8176.959035, "o", "   190\t\t}\r\n   191\t\r\n   192\t\tfor _, job := range jobs {\r\n   193\t\t\tseenDeps := map[string]bool{}\r\n   194\t\t\tfor _, dep := range job.Deps {\r\n   195\t\t\t\tif seenDeps[dep] {\r\n   196\t\t\t\t\treturn nil, &ValidationError{Code: \"duplicate_dep\", Message: \"duplicate dep in \" + job.Name + \": \" + dep}\r\n   197\t\t\t\t}\r\n   198\t\t\t\tseenDeps[dep] = true\r\n   199\t\t\t}\r\n   200\t\t}\r\n   201\t\r\n"]
[8176.959093, "o", "   202\t\tfor _, job := range jobs {\r\n   203\t\t\tfor _, dep := range job.Deps {\r\n   204\t\t\t\tif dep == job.Name {\r\n   205\t\t\t\t\treturn nil, &ValidationError{Code: \"self_dep\", Message: \"self dep: \" + job.Name}\r\n   206\t\t\t\t}\r\n   207\t\t\t}\r\n   208\t\t}\r\n   209\t\r\n"]
[8176.959154, "o", "   210\t\tif err := detectCycle(spec); err != nil {\r\n   211\t\t\treturn nil, err\r\n   212\t\t}\r\n   213\t\r\n   214\t\treturn spec, nil\r\n   215\t}\r\n   216\t\r\n   217\tfunc isKnownJobField(k string) bool {\r\n   218\t\tswitch k {\r\n   219\t\tcase \"name\", \"command\", \"deps\", \"workdir\", \"env\":\r\n"]
[8176.959222, "o", "   220\t\t\treturn true\r\n   221\t\t}\r\n   222\t\treturn false\r\n   223\t}\r\n   224\t\r\n   225\tfunc computeLevels(spec *Spec) [][]string {\r\n   226\t\tlevel := map[string]int{}\r\n   227\t\r\n   228\t\tvar dfs func(job *Job) int\r\n   229\t\tdfs = func(job *Job) int {\r\n   230\t\t\tif l, ok := level[job.Name]; ok {\r\n"]
[8176.95928, "o", "   231\t\t\t\treturn l\r\n   232\t\t\t}\r\n   233\t\t\tmaxDep := -1\r\n   234\t\t\tfor _, dep := range job.Deps {\r\n   235\t\t\t\tl := dfs(spec.ByName[dep])\r\n   236\t\t\t\tif l > maxDep {\r\n   237\t\t\t\t\tmaxDep = l\r\n   238\t\t\t\t}\r\n   239\t\t\t}\r\n"]
[8176.959336, "o", "   240\t\t\tlevel[job.Name] = maxDep + 1\r\n   241\t\t\treturn level[job.Name]\r\n   242\t\t}\r\n   243\t\r\n   244\t\tfor _, job := range spec.Jobs {\r\n   245\t\t\tdfs(job)\r\n   246\t\t}\r\n   247\t\r\n   248\t\tmaxLevel := -1\r\n"]
[8176.95943, "o", "   249\t\tfor _, l := range level {\r\n   250\t\t\tif l > maxLevel {\r\n   251\t\t\t\tmaxLevel = l\r\n   252\t\t\t}\r\n   253\t\t}\r\n   254\t\r\n   255\t\tlevels := make([][]string, maxLevel+1)\r\n   256\t\tfor _, job := range spec.Jobs {\r\n   257\t\t\tlevels[level[job.Name]] = append(levels[level[job.Name]], job.Name)\r\n   258\t\t}\r\n   259\t\tfor _, names := range levels {\r\n   260\t\t\tsort.Strings(names)\r\n   261\t\t}\r\n"]
[8176.959496, "o", "   262\t\treturn levels\r\n   263\t}\r\n"]
