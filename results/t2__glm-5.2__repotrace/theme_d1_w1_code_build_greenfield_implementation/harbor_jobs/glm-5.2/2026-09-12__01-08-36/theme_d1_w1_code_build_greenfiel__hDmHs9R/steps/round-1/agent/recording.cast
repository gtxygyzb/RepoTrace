[6826.627486, "o", "   148\t\t}\r\n   149\t\tif len(fs.Args()) > 0 {\r\n   150\t\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n   151\t\t\treturn 2\r\n   152\t\t}\r\n   153\t\tif *format != \"text\" && *format != \"json\" {\r\n   154\t\t\tfmt.Fprintln(os.Stderr, \"error: bad --format\")\r\n   155\t\t\treturn 2\r\n   156\t\t}\r\n   157\t\r\n   158\t\tspec, err := loadSpec(*specPath)\r\n   159\t\tif err != nil {\r\n   160\t\t\tprintValidationError(err)\r\n"]
