[8997.673914, "o", "\tif len(os.Args) < 2 {\r\n    17\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    18\t\t\tos.Exit(2)\r\n    19\t\t}\r\n    20\t\r\n    21\t\tswitch os.Args[1] {\r\n    22\t\tcase \"plan\":\r\n    23\t\t\tos.Exit(runPlan(os.Args[2:]))\r\n    24\t\tcase \"ancestors\":\r\n    25\t\t\tos.Exit(runAncestors(os.Args[2:]))\r\n    26\t\tcase \"run\":\r\n    27\t\t\tos.Exit(runRun(os.Args[2:]))\r\n    28\t\tcase \"validate\":\r\n    29\t\t\tos.Exit(runValidate(os.Args[2:]))\r\n    30\t\tcase \"list\":\r\n    31\t\t\tos.Exit(runList(os.Args[2:]))\r\n    32\t\tcase \"graph\":\r\n    33\t\t\tos.Exit(runGraph(os.Args[2:]))\r\n    34\t\tcase \"hash\":\r\n    35\t\t\tos.Exit(runHash(os.Args[2:]))\r\n    36\t\tcase \"diff\":\r\n    37\t\t\tos.Exit(runDiff(os.Args[2:]))\r\n"]
[8997.673995, "o", "    38\t\tcase \"schedule\":\r\n    39\t\t\tos.Exit(runSchedule(os.Args[2:]))\r\n    40\t\tcase \"critical\":\r\n    41\t\t\tos.Exit(runCritical(os.Args[2:]))\r\n    42\t\tdefault:\r\n    43\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    44\t\t\tos.Exit(2)\r\n    45\t\t}\r\n    46\t}\r\n    47\t\r\n    48\t"]
[8997.674062, "o", "func runPlan(args []string) int {\r\n    49\t\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n    50\t\tfs.SetOutput(os.Stderr)\r\n    51\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    52\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n    53\t\tif err := fs.Parse(args); err != nil {\r\n    54\t\t\treturn 2\r\n"]
[8997.674125, "o", "    55\t\t}\r\n    56\t\tif *specPath == \"\" {\r\n    57\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n    58\t\t\treturn 2\r\n    59\t\t}\r\n    60\t\tif *format != \"text\" && *format != \"json\" {\r\n    61\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n    62\t\t\treturn 2\r\n    63\t\t}\r\n    64\t"]
