[4950.432956, "i", "printf '{\"jobs\":[{\"name\":\"a\",\"command\":\"echo a\"},{\"name\":\"a\",\"command\":\"echo a\"}]}' > /tmp/bad_spec.json && jobforge hash --spec /tmp/bad_spec.json; echo \"exit=$?\"\n"]
