[4782.330554, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\""]
[4782.33067, "o", "\r\n     6\t\t\"flag\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"io\"\r\n     9\t\t\"os\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc main() {\r\n    16\t\tif len(os.Args) < 2 {\r\n    17\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    18\t\t\tos.Exit(2)\r\n    19\t\t}"]
[4782.330774, "o", "\r\n    20\t\r\n    21\t\tswitch os.Args[1] {\r\n    22\t\tcase \"plan\":\r\n    23\t\t\tos.Exit(runPlan(os.Args[2:]))\r\n    24\t\tcase \"run\":\r\n    25\t\t\tos.Exit(runRun(os.Args[2:]))\r\n    26\t\tcase \"validate\":\r\n    27\t\t\tos.Exit(runValidate(os.Args[2:]))"]
[4782.330917, "o", "\r\n    28\t\tcase \"list\":\r\n    29\t\t\tos.Exit(runList(os.Args[2:]))\r\n    30\t\tcase \"graph\":\r\n    31\t\t\tos.Exit(runGraph(os.Args[2:]))\r\n    32\t\tdefault:\r\n    33\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    34\t\t\tos.Exit(2)\r\n    35\t\t}\r\n    36\t}\r\n    37\t\r\n    38\tfunc runPlan(args []string) int {\r\n    39\t\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n    40\t\tfs.SetOutput(os.Stderr)\r\n    41\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    42\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n    43\t\tif err := fs.Parse(args); err != nil {\r\n    44\t\t\treturn 2\r\n    45\t\t}\r\n    46\t\tif *specPath == \"\" {\r\n    47\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n    48\t\t\treturn 2\r\n    49\t\t}\r\n    50\t\tif *format != \"text\" && *format != \"json\" {\r\n    51\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n    52\t\t\treturn 2\r\n"]
[4782.33104, "o", "    53\t\t}\r\n    54\t\r\n    55\t\tspec, err := loadSpec(*specPath)\r\n    56\t\tif err != nil {\r\n    57\t\t\tprintValidationError(err)\r\n    58\t\t\treturn 2\r\n    59\t\t}\r\n    60\t\r\n    61\t\tlevels := computeLevels(spec)\r\n    62\t\tswitch *format {\r\n    63\t\tcase \"text\":\r\n    64\t\t\tfor i, names := range levels {\r\n    65\t\t\t\tfmt.Printf(\"level %d: %s\\n\", i, strings.Join(names, \", \"))\r\n    66\t\t\t}\r\n    67"]
[4782.331166, "o", "\t\tcase \"json\":\r\n    68\t\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n    69\t\t\tif err != nil {\r\n    70\t\t\t\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n    71\t\t\t\treturn 2\r\n    72\t\t\t}\r\n    73\t\t\tos.Stdout.Write(out)\r\n    74\t\t\tfmt.Println()\r\n    75\t\t}\r\n    76\t\treturn 0\r\n    77\t}\r\n    78\t\r\n    79\tfunc runRun(args []string) int {\r\n    80\t\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n"]
