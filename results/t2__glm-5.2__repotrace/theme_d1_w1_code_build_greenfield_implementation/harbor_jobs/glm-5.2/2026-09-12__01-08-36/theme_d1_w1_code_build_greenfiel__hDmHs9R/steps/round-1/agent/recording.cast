[8185.672962, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"flag\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"io\"\r\n     9\t\t\"os\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t)\r\n"]
[8185.673058, "o", "    14\t\r\n    15\tfunc main() {\r\n    16\t\tif len(os.Args) < 2 {\r\n    17\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    18\t\t\tos.Exit(2)\r\n    19\t\t}\r\n    20\t\r\n    21\t\tswitch os.Args[1] {\r\n    22\t\tcase \"plan\":\r\n    23\t\t\tos.Exit(runPlan(os.Args[2:]))\r\n    24\t\tcase \"run\":\r\n    25\t\t\tos.Exit(runRun(os.Args[2:]))\r\n    26\t\tcase \"validate\":\r\n    27\t\t\tos.Exit(runValidate(os.Args[2:]))\r\n    28\t\tcase \"list\":\r\n    29\t\t\tos.Exit(runList(os.Args[2:]))\r\n    30\t\tcase \"graph\":\r\n    31\t\t\tos.Exit(runGraph(os.Args[2:]))\r\n    32\t\tcase \"hash\":\r\n    33\t\t\tos.Exit(runHash(os.Args[2:]))\r\n    34\t\tcase \"diff\":\r\n    35\t\t\tos.Exit(runDiff(os.Args[2:]))\r\n    36\t\tcase \"schedule\":\r\n    37\t\t\tos.Exit(runSchedule(os.Args[2:]))\r\n    38\t\tcase \"critical\":\r\n"]
[8185.67314, "o", "    39\t\t\tos.Exit(runCritical(os.Args[2:]))\r\n    40\t\tdefault:\r\n    41\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    42\t\t\tos.Exit(2)\r\n    43\t\t}\r\n    44\t}\r\n    45\t\r\n    46\tfunc runPlan(args []string) int {\r\n    47\t\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n    48\t\tfs.SetOutput(os.Stderr)\r\n    49\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    50\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n    51\t\tif err := fs.Parse(args); err != nil {\r\n    52\t\t\treturn 2\r\n    53\t\t}\r\n    54\t\tif *specPath == \"\" {\r\n    55\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n    56\t\t\treturn 2\r\n    57\t\t}\r\n    58\t\tif *format != \"text\" && *format != \"json\" {\r\n    59\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n    60"]
[8185.673208, "o", "\t\t\treturn 2\r\n    61\t\t}\r\n    62\t\r\n    63\t\tspec, err := loadSpec(*specPath)\r\n    64\t\tif err != nil {\r\n    65\t\t\tprintValidationError(err)\r\n    66\t\t\treturn 2\r\n    67\t\t}\r\n    68\t\r\n    69\t\tlevels := computeLevels(spec)\r\n    70\t\tswitch *format {\r\n    71\t\tcase \"text\":\r\n    72\t\t\tfor i, names := range levels {\r\n    73\t\t\t\tfmt.Printf(\"level %d: %s\\n\", i, strings.Join(names, \", \"))\r\n    74\t\t\t}\r\n    75\t\tcase \"json\":\r\n    76\t\t\tout, err := json.Marshal(map[string][][]string{\"levels\": levels})\r\n    77\t\t\tif err != nil {\r\n    78\t\t\t"]
[8185.673273, "o", "\tfmt.Fprintf(os.Stderr, \"error: marshal: %s\\n\", err)\r\n    79\t\t\t\treturn 2\r\n    80\t\t\t}\r\n    81\t\t\tos.Stdout.Write(out)\r\n    82\t\t\tfmt.Println()\r\n    83\t\t}\r\n    84\t\treturn 0\r\n    85\t}\r\n    86\t\r\n    87\tfunc runRun(args []string) int {\r\n    88\t\tfs := flag.NewFlagSet(\"run\", flag.ContinueOnError)\r\n    89\t\tfs.SetOutput(os.Stderr)\r\n    90\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n    91\t\tonFailure := fs.String(\"on-failure\", \"stop\", \"on failure behavior: stop|continue\")\r\n    92\t\tresultsPath := fs.String(\"results\", \"\", \"path to results JSON file\")\r\n"]
[8185.673334, "o", "    93\t\tif err := fs.Parse(args); err != nil {\r\n    94\t\t\treturn 2\r\n    95\t\t}\r\n    96\t\tif *specPath == \"\" {\r\n    97\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]\")\r\n    98\t\t\treturn 2\r\n    99\t\t}\r\n   100\t\tif *onFailure != \"stop\" && *onFailure != \"continue\" {\r\n   101\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid on-failure: %s\\n\", *onFailure)\r\n   102\t\t\treturn 2\r\n   103\t\t}\r\n   104\t\r\n   105\t\tspec, err := loadSpec(*specPath)\r\n   106\t\tif err != nil {\r\n   107\t\t\tprintValidationError(err)\r\n   108\t"]
[8185.673396, "o", "\t\treturn 2\r\n   109\t\t}\r\n   110\t\r\n   111\t\treturn runSpec(spec, *onFailure, *resultsPath)\r\n   112\t}\r\n   113\t\r\n   114\tfunc runValidate(args []string) int {\r\n   115\t\tfs := flag.NewFlagSet(\"validate\", flag.ContinueOnError)\r\n   116\t\tfs.SetOutput(io.Discard)\r\n   117\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n   118\t\tif err := fs.Parse(args); err != nil {\r\n   119\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n"]
