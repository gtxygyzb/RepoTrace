[2885.185724, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"flag\"\r\n     7\t\t\"fmt\"\r\n"]
[2885.185863, "o", "     8\t\t\"io\"\r\n     9\t\t\"os\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc main() {\r\n    16\t\tif len(os.Args) < 2 {\r\n    17\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    18\t\t\tos.Exit(2)\r\n    19\t\t}\r\n    20\t\r\n    21\t\tswitch os.Args[1] {\r\n    22\t\tcase \"plan\":\r\n"]
[2885.185935, "o", "    23\t\t\tos.Exit(runPlan(os.Args[2:]))\r\n    24\t\tcase \"run\":\r\n    25\t\t\tos.Exit(runRun(os.Args[2:]))\r\n"]
[2885.185992, "o", "    26\t\tcase \"validate\":\r\n    27\t\t\tos.Exit(runValidate(os.Args[2:]))\r\n    28\t\tcase \"list\":\r\n    29\t\t\tos.Exit(runList(os.Args[2:]))\r\n    30\t\tdefault:\r\n    31\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n    32\t\t\tos.Exit(2)\r\n    33\t\t}\r\n    34"]
[2885.186047, "o", "\t}\r\n    35\t\r\n    36\tfunc runPlan(args []string) int {\r\n    37\t\tfs := flag.NewFlagSet(\"plan\", flag.ContinueOnError)\r\n    38\t\tfs.SetOutput(os.Stderr)\r\n    39\t\tspecPath := fs.String(\"spec\", \"\", \"path to spec file\")\r\n"]
[2885.186105, "o", "    40\t\tformat := fs.String(\"format\", \"text\", \"output format: json|text\")\r\n    41\t\tif err := fs.Parse(args); err != nil {\r\n    42\t\t\treturn 2\r\n    43\t\t}\r\n    44\t\tif *specPath == \"\" {\r\n    45\t\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge plan --spec <path> [--format json|text]\")\r\n    46\t\t\treturn 2\r\n    47\t\t}\r\n    48\t\tif *format != \"text\" && *format != \"json\" {\r\n"]
[2885.186157, "o", "    49\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format: %s\\n\", *format)\r\n    50\t\t\treturn 2\r\n"]
