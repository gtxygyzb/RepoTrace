[5618.139972, "i", "sed -n '1,220p' cmd/jobforge/diff.go\n"]
[5618.140296, "o", "sed -n '1,220p' cmd/jobforge/diff.go\r\n\u001b[?2004l\r"]
[5618.143379, "o", "package main\r\n\r\nimport (\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n"]
[5618.143483, "o", "\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc runDiff(args []string) int {\r\n\tfs := flag.NewFlagSet(\"diff\", flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\toldPath := fs.String(\"old\", \"\", \"path to old spec file\")\r\n\tnewPath := fs.String(\"new\", \"\", \"path to new spec file\")\r\n\tif err := fs.Parse(args); err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n\t\treturn 2\r\n\t}\r\n\tif *oldPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --old\")\r\n"]
[5618.143582, "o", "\t\treturn 2\r\n\t}\r\n\tif *newPath == \"\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: missing --new\")\r\n\t\treturn 2\r\n\t}\r\n\tif len(fs.Args()) > 0 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", fs.Args()[0])\r\n\t\treturn 2\r\n\t}\r\n\r\n\toldSpec, err := loadSpec(*oldPath)\r\n\tif err != nil {\r\n\t\tprintDiffValidationError(\"old: \", err)\r\n\t\treturn 2\r\n"]
[5618.143652, "o", "\t}\r\n\tnewSpec, err := loadSpec(*newPath)\r\n\tif err != nil {\r\n\t\tprintDiffValidationError(\"new: \", err)\r\n\t\treturn 2\r\n\t}\r\n\r\n\tif canonicalForm(oldSpec) == canonicalForm(newSpec) {\r\n\t\treturn 0\r\n\t}\r\n\r\n\toldTuples := jobTuples(oldSpec)\r\n"]
[5618.14376, "o", "\tnewTuples := jobTuples(newSpec)\r\n\r\n\toldByName := make(map[string]diffJob, len(oldTuples))\r\n\tfor _, t := range oldTuples {\r\n\t\toldByName[t.name] = t\r\n\t}\r\n\tnewByName := make(map[string]diffJob, len(newTuples))\r\n\tfor _, t := range newTuples {\r\n\t\tnewByName[t.name] = t\r\n\t}\r\n\r\n\tvar out strings.Builder\r\n\tfor _, t := range newTuples {\r\n\t\tif _, ok := oldByName[t.name]; !ok {\r\n\t\t\tfmt.Fprintf(&out, \"+ %s\\n\", t.name)\r\n"]
[5618.143914, "o", "\t\t}\r\n\t}\r\n\tfor _, t := range oldTuples {\r\n\t\tif _, ok := newByName[t.name]; !ok {\r\n\t\t\tfmt.Fprintf(&out, \"- %s\\n\", t.name)\r\n\t\t}\r\n\t}\r\n\tfor _, t := range newTuples {\r\n\t\told, ok := oldByName[t.name]\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif old.workdir != t.workdir {\r\n\t\t\tfmt.Fprintf(&out, \"~ %s workdir: %s -> %s\\n\", t.name, old.workdir, t.workdir)\r\n\t\t}\r\n\t\tif old.command != t.command {\r\n\t\t\tfmt.Fprintf(&out, \"~ %s command: %s -> %s\\n\", t.name, old.command, t.command)\r\n\t\t}\r\n\t\tif reprDeps(old.deps) != reprDeps(t.deps) {\r\n\t\t\tfmt.Fprintf(&out, \"~ %s deps: %s -> %s\\n\", t.name, reprDeps(old.deps), reprDeps(t.deps))\r\n\t\t}\r\n"]
[5618.144004, "o", "\t\tif reprEnv(old.env) != reprEnv(t.env) {\r\n\t\t\tfmt.Fprintf(&out, \"~ %s env: %s -> %s\\n\", t.name, reprEnv(old.env), reprEnv(t.env))\r\n\t\t}\r\n\t\tif old.level != t.level {\r\n\t\t\tfmt.Fprintf(&out, \"~ %s level: %s -> %s\\n\", t.name, reprLevel(old.level), reprLevel(t.level))\r\n\t\t}\r\n\t}\r\n\r\n\tif out.Len() == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tfmt.Print(out.String())\r\n\treturn 1\r\n}\r\n"]
[5618.144144, "o", "\r\ntype diffJob struct {\r\n\tname    string\r\n\tworkdir string\r\n\tcommand string\r\n\tdeps    []string\r\n\tenv     []string\r\n\tlevel   int\r\n}\r\n\r\nfunc jobTuples(spec *Spec) []diffJob {\r\n\tlevels := computeLevels(spec)\r\n\tvar tuples []diffJob\r\n\tfor level, names := range levels {\r\n\t\tfor _, name := range names {\r\n\t\t\tjob := spec.ByName[name]\r\n\t\t\tenvKeys := make([]string, 0, len(job.Env))\r\n\t\t\tfor k := range job.Env {\r\n\t\t\t\tenvKeys = append(envKeys, k)\r\n\t\t\t}\r\n\t\t\tsort.Strings(envKeys)\r\n\t\t\tenvParts := make([]string, 0, len(envKeys))\r\n"]
[5618.144207, "o", "\t\t\tfor _, k := range envKeys {\r\n\t\t\t\tenvParts = append(envParts, k+\"=\"+job.Env[k])\r\n\t\t\t}\r\n\t\t\ttuples = append(tuples, diffJob{\r\n\t\t\t\tname:    job.Name,\r\n\t\t\t\tworkdir: job.Workdir,\r\n\t\t\t\tcommand: job.Command,\r\n\t\t\t\tdeps:    job.Deps,\r\n\t"]
[5618.144279, "o", "\t\t\tenv:     envParts,\r\n\t\t\t\tlevel:   level,\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn tuples\r\n}\r\n\r\n"]
[5618.144346, "o", "func reprDeps(deps []string) string {\r\n\treturn \"[\" + strings.Join(deps, \",\") + \"]\"\r\n}\r\n\r\nfunc reprEnv(parts []string) string {\r\n\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\r\n}\r\n\r\nfunc reprLevel(level int) string {\r\n\treturn strconv.Itoa(level)\r\n}\r\n\r\nfunc printDiffValidationError(prefix string, err error) {\r\n\tif ve, ok := err.(*ValidationError); ok {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %s%s: %s\\n\", prefix, ve.Code, ve.Message)\r\n\t\treturn\r\n\t}\r\n\tfmt.Fprintf(os.Stderr, \"error: %s%s\\n\", prefix, err)\r\n}\r\n"]
[5618.144871, "o", "\u001b[?2004h"]
[5618.144936, "o", "root@n30009:/app# "]
[5618.438679, "i", "sed -n '1,40p' cmd/jobforge/main.go\n"]
[5618.439004, "o", "sed -n '1,40p' cmd/jobforge/main.go\r\n"]
[5618.439076, "o", "\u001b[?2004l\r"]
[5618.442153, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n"]
[5618.442217, "o", "\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n\t"]
[5618.44227, "o", "\tos.Exit(2)\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"plan\":\r\n\t\tos.Exit(runPlan(os.Args[2:]))\r\n\tcase \"run\":\r\n"]
[5618.442323, "o", "\t\tos.Exit(runRun(os.Args[2:]))\r\n\tcase \"validate\":\r\n\t\tos.Exit(runValidate(os.Args[2:]))\r\n\tcase \"list\":\r\n\t\tos.Exit(runList(os.Args[2:]))\r\n\tcase \"graph\":\r\n\t\tos.Exit(runGraph(os.Args[2:]))\r\n\tcase \"hash\":\r\n"]
[5618.442367, "o", "\t\tos.Exit(runHash(os.Args[2:]))\r\n\tcase \"diff\":\r\n\t\tos.Exit(runDiff(os.Args[2:]))\r\n\tdefault:\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: jobforge <plan|run|validate|list> --spec <path> [flags]\")\r\n"]
[5618.442414, "o", "\t\tos.Exit(2)\r\n\t}\r\n}\r\n"]
