   179		if only == "" {
   180			return nil, nil
   181		}
   182	
   183		selected := map[string]bool{}
   184		seen := map[string]bool{}
   185		for _, name := range strings.Split(only, ",") {
   186			if seen[name] {
   187				continue
   188			}
   189			seen[name] = true
   190	
   191			job, ok := spec.ByName[name]
   192			if !ok {
   193				return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in --only: " + name}
   194			}
   195			addTransitiveDeps(spec, job, selected)
   196		}
   197		return selected, nil
   198	}
   199	
   200	func addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {
   201		if selected[job.Name] {
   202			return
   203		}
   204		selected[job.Name] = true
   205		for _, dep := range job.Deps {
   206			addTransitiveDeps(spec, spec.ByName[dep], selected)
   207		}
   208	}
   209	
   210	func listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {
   211		levels := computeLevels(spec)
   212		level := make(map[string]int, len(spec.Jobs))
   213		for i, names := range levels {
   214			for _, name := range names {
   215				level[name] = i
   216			}
   217		}
   218	
   219		order := make([]*Job, 0, len(spec.Jobs))
   220		for _, names := range levels {
   221			for _, name := range names {
   222				if selected != nil && !selected[name] {
   223					continue
   224				}
   225				order = append(order, spec.ByName[name])
   226			}
   227		}
   228		return order, level
   229	}
