[?2004lpackage main

import (
"encoding/json"
"flag"
"fmt"
"os"
"strings"
)

func runImpact(args []string) int {
fs := flag.NewFlagSet("impact", flag.ContinueOnError)
fs.SetOutput(os.Stderr)
specPath := fs.String("spec", "", "path to spec file")
jobName := fs.String("job", "", "target job")
format := fs.String("format", "text", "output format: text|json")
if err := fs.Parse(args); err != nil {
return 2
}

if *format != "text" && *format != "json" {
fmt.Fprintln(os.Stderr, "error: bad --format")
return 2
}
if *specPath == "" {
fmt.Fprintln(os.Stderr, "error: --spec required")
return 2
}
if *jobName == "" {
fmt.Fprintln(os.Stderr, "error: --job required")
return 2
}
if len(fs.Args()) != 0 {
fmt.Fprintln(os.Stderr, "error: unexpected arguments")
return 2
}

spec, err := loadSpec(*specPath)
if err != nil {
printValidationError(err)
return 2
}

target, ok := spec.ByName[*jobName]
if !ok {
fmt.Fprintf(os.Stderr, "error: unknown_job: %s\n", *jobName)
return 2
}

descendants := computeDescendantSet(spec, target)

levels := computeLevels(spec)
ordered := make([]string, 0, len(descendants))
for _, names := range levels {
for _, name := range names {
if descendants[name] {
ordered = append(ordered, name)
}
}
}

switch *format {
case "text":
if len(ordered) > 0 {
os.Stdout.WriteString(strings.Join(ordered, "\n") + "\n")
}
case "json":
out, err := json.Marshal(ordered)
if err != nil {
fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
return 2
}
os.Stdout.Write(out)
fmt.Println()
}

return 0
}

func computeDescendantSet(spec *Spec, target *Job) map[string]bool {
descendants := map[string]bool{}
var visit func(job *Job)
visit = func(job *Job) {
for _, dependent := range spec.Dependents[job.Name] {
if !descendants[dependent] {
descendants[dependent] = true
visit(spec.ByName[dependent])
}
}
}
visit(target)
return descendants
}
