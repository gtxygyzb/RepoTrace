    58			return 2
    59		}
    60	
    61		levels := computeLevels(spec)
    62		switch *format {
    63		case "text":
    64			for i, names := range levels {
    65				fmt.Printf("level %d: %s\n", i, strings.Join(names, ", "))
    66			}
    67		case "json":
