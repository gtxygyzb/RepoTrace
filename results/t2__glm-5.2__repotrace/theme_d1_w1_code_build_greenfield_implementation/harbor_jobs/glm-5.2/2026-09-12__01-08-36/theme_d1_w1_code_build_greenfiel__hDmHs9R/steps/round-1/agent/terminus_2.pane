    30		default:
    31			fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run|validate|list> --spec <path> [flags]")
    32			os.Exit(2)
    33		}
    34	}
    35	
    36	func runPlan(args []string) int {
    37		fs := flag.NewFlagSet("plan", flag.ContinueOnError)
    38		fs.SetOutput(os.Stderr)
    39		specPath := fs.String("spec", "", "path to spec file")
    40		format := fs.String("format", "text", "output format: json|text")
    41		if err := fs.Parse(args); err != nil {
    42			return 2
    43		}
    44		if *specPath == "" {
    45			fmt.Fprintln(os.Stderr, "usage: jobforge plan --spec <path> [--format json|text]")
    46			return 2
    47		}
    48		if *format != "text" && *format != "json" {
    49			fmt.Fprintf(os.Stderr, "error: invalid format: %s\n", *format)
    50			return 2
    51		}
    52	
    53		spec, err := loadSpec(*specPath)
    54		if err != nil {
    55			printValidationError(err)
    56			return 2
    57		}
    58	
    59		levels := computeLevels(spec)
    60		switch *format {
    61		case "text":
    62			for i, names := range levels {
    63				fmt.Printf("level %d: %s\n", i, strings.Join(names, ", "))
    64			}
    65		case "json":
    66			out, err := json.Marshal(map[string][][]string{"levels": levels})
    67			if err != nil {
    68				fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
    69				return 2
    70			}
    71			os.Stdout.Write(out)
    72			fmt.Println()
    73		}
    74		return 0
    75	}
    76	
    77	func runRun(args []string) int {
    78		fs := flag.NewFlagSet("run", flag.ContinueOnError)
    79		fs.SetOutput(os.Stderr)
    80		specPath := fs.String("spec", "", "path to spec file")
    81		onFailure := fs.String("on-failure", "stop", "on failure behavior: stop|continue")
    82		resultsPath := fs.String("results", "", "path to results JSON file")
    83		if err := fs.Parse(args); err != nil {
    84			return 2
    85		}
