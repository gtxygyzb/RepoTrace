   200	func addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {
   201		if selected[job.Name] {
   202			return
   203		}
   204		selected[job.Name] = true
   205		for _, dep := range job.Deps {
   206			addTransitiveDeps(spec, spec.ByName[dep], selected)
   207		}
   208	}
