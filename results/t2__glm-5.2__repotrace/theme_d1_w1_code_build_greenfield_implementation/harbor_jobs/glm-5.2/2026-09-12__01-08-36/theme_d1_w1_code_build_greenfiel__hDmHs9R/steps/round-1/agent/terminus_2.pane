     2	
     3	import (
     4		"encoding/json"
     5		"flag"
     6		"fmt"
     7		"os"
     8		"strings"
     9	)
    10	
    11	func main() {
    12		if len(os.Args) < 2 {
    13			fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run> --spec <path> [flags]")
    14			os.Exit(2)
    15		}
    16	
    17		switch os.Args[1] {
    18		case "plan":
    19			os.Exit(runPlan(os.Args[2:]))
    20		case "run":
    21			os.Exit(runRun(os.Args[2:]))
    22		default:
    23			fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run> --spec <path> [flags]")
    24			os.Exit(2)
    25		}
    26	}
    27	
    28	func runPlan(args []string) int {
    29		fs := flag.NewFlagSet("plan", flag.ContinueOnError)
    30		fs.SetOutput(os.Stderr)
    31		specPath := fs.String("spec", "", "path to spec file")
    32		format := fs.String("format", "text", "output format: json|text")
    33		if err := fs.Parse(args); err != nil {
    34			return 2
    35		}
    36		if *specPath == "" {
    37			fmt.Fprintln(os.Stderr, "usage: jobforge plan --spec <path> [--format json|text]")
    38			return 2
    39		}
    40		if *format != "text" && *format != "json" {
    41			fmt.Fprintf(os.Stderr, "error: invalid format: %s\n", *format)
    42			return 2
    43		}
    44	
    45		spec, err := loadSpec(*specPath)
    46		if err != nil {
    47			printValidationError(err)
    48			return 2
    49		}
    50	
    51		levels := computeLevels(spec)
    52		switch *format {
    53		case "text":
    54			for i, names := range levels {
    55				fmt.Printf("level %d: %s\n", i, strings.Join(names, ", "))
    56			}
    57		case "json":
    58			out, err := json.Marshal(map[string][][]string{"levels": levels})
    59			if err != nil {
    60				fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
    61				return 2
    62			}
    63			os.Stdout.Write(out)
    64			fmt.Println()
    65		}
    66		return 0
    67	}
    68	
    69	func runRun(args []string) int {
    70		fs := flag.NewFlagSet("run", flag.ContinueOnError)
    71		fs.SetOutput(os.Stderr)
    72		specPath := fs.String("spec", "", "path to spec file")
    73		onFailure := fs.String("on-failure", "stop", "on failure behavior: stop|continue")
    74		resultsPath := fs.String("results", "", "path to results JSON file")
    75		if err := fs.Parse(args); err != nil {
    76			return 2
    77		}
    78		if *specPath == "" {
    79			fmt.Fprintln(os.Stderr, "usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]")
    80			return 2
    81		}
    82		if *onFailure != "stop" && *onFailure != "continue" {
    83			fmt.Fprintf(os.Stderr, "error: invalid on-failure: %s\n", *onFailure)
    84			return 2
    85		}
    86	
    87		spec, err := loadSpec(*specPath)
    88		if err != nil {
    89			printValidationError(err)
    90			return 2
    91		}
    92	
    93		return runSpec(spec, *onFailure, *resultsPath)
    94	}
