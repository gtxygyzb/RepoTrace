  46: 			buf.WriteString(job.Name)
  47: 			buf.WriteByte(0)
  48: 			buf.WriteString(job.Workdir)
  49: 			buf.WriteByte(0)
  50: 			buf.WriteString(job.Command)
  51: 			buf.WriteByte(0)
