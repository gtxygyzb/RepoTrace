    14	
    15	func main() {
    16		if len(os.Args) < 2 {
    17			fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run|validate|list> --spec <path> [flags]")
    18			os.Exit(2)
    19		}
    20	
    21		switch os.Args[1] {
    22		case "plan":
    23			os.Exit(runPlan(os.Args[2:]))
    24		case "run":
    25			os.Exit(runRun(os.Args[2:]))
    26		case "validate":
    27			os.Exit(runValidate(os.Args[2:]))
    28		case "list":
    29			os.Exit(runList(os.Args[2:]))
    30		case "graph":
    31			os.Exit(runGraph(os.Args[2:]))
    32		case "hash":
    33			os.Exit(runHash(os.Args[2:]))
    34		case "diff":
    35			os.Exit(runDiff(os.Args[2:]))
    36		case "schedule":
    37			os.Exit(runSchedule(os.Args[2:]))
    38		default:
    39			fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run|validate|list> --spec <path> [flags]")
    40			os.Exit(2)
    41		}
    42	}
    43	
    44	func runPlan(args []string) int {
    45		fs := flag.NewFlagSet("plan", flag.ContinueOnError)
    46		fs.SetOutput(os.Stderr)
    47		specPath := fs.String("spec", "", "path to spec file")
    48		format := fs.String("format", "text", "output format: json|text")
    49		if err := fs.Parse(args); err != nil {
    50			return 2
    51		}
    52		if *specPath == "" {
    53			fmt.Fprintln(os.Stderr, "usage: jobforge plan --spec <path> [--format json|text]")
    54			return 2
    55		}
    56		if *format != "text" && *format != "json" {
    57			fmt.Fprintf(os.Stderr, "error: invalid format: %s\n", *format)
    58			return 2
    59		}
    60	
    61		spec, err := loadSpec(*specPath)
    62		if err != nil {
    63			printValidationError(err)
    64			return 2
    65		}
    66	
    67		levels := computeLevels(spec)
    68		switch *format {
    69		case "text":
    70			for i, names := range levels {
    71				fmt.Printf("level %d: %s\n", i, strings.Join(names, ", "))
    72			}
    73		case "json":
    74			out, err := json.Marshal(map[string][][]string{"levels": levels})
    75			if err != nil {
    76				fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
    77				return 2
    78			}
    79			os.Stdout.Write(out)
    80			fmt.Println()
    81		}
    82		return 0
    83	}
    84	
    85	func runRun(args []string) int {
    86		fs := flag.NewFlagSet("run", flag.ContinueOnError)
    87		fs.SetOutput(os.Stderr)
    88		specPath := fs.String("spec", "", "path to spec file")
    89		onFailure := fs.String("on-failure", "stop", "on failure behavior: stop|continue")
    90		resultsPath := fs.String("results", "", "path to results JSON file")
    91		if err := fs.Parse(args); err != nil {
    92			return 2
    93		}
    94		if *specPath == "" {
    95			fmt.Fprintln(os.Stderr, "usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]")
    96			return 2
    97		}
    98		if *onFailure != "stop" && *onFailure != "continue" {
    99			fmt.Fprintf(os.Stderr, "error: invalid on-failure: %s\n", *onFailure)
   100			return 2
   101		}
   102	
   103		spec, err := loadSpec(*specPath)
   104		if err != nil {
   105			printValidationError(err)
   106			return 2
   107		}
   108	
   109		return runSpec(spec, *onFailure, *resultsPath)
   110	}
   111	
   112	func runValidate(args []string) int {
   113		fs := flag.NewFlagSet("validate", flag.ContinueOnError)
   114		fs.SetOutput(io.Discard)
   115		specPath := fs.String("spec", "", "path to spec file")
   116		if err := fs.Parse(args); err != nil {
   117			fmt.Fprintf(os.Stderr, "error: %s\n", err)
   118			return 2
   119		}
   120		if *specPath == "" {
[?2004hroot@n30009:/app# nl -ba cmd/jobforge/main.go | sed -n '120,340p'
[?2004l   120		if *specPath == "" {
   121			fmt.Fprintln(os.Stderr, "error: missing --spec")
   122			return 2
   123		}
   124		if len(fs.Args()) > 0 {
   125			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
   126			return 2
   127		}
   128		if _, err := loadSpec(*specPath); err != nil {
   129			printValidationError(err)
   130			return 2
   131		}
   132		return 0
   133	}
   134	
   135	func runList(args []string) int {
   136		fs := flag.NewFlagSet("list", flag.ContinueOnError)
   137		fs.SetOutput(io.Discard)
   138		specPath := fs.String("spec", "", "path to spec file")
   139		format := fs.String("format", "text", "output format: json|text")
   140		only := fs.String("only", "", "comma-separated list of job names")
   141		if err := fs.Parse(args); err != nil {
   142			fmt.Fprintf(os.Stderr, "error: %s\n", err)
   143			return 2
   144		}
   145		if *specPath == "" {
   146			fmt.Fprintln(os.Stderr, "error: missing --spec")
   147			return 2
   148		}
   149		if len(fs.Args()) > 0 {
   150			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
   151			return 2
   152		}
   153		if *format != "text" && *format != "json" {
   154			fmt.Fprintln(os.Stderr, "error: bad --format")
   155			return 2
   156		}
   157	
   158		spec, err := loadSpec(*specPath)
   159		if err != nil {
   160			printValidationError(err)
   161			return 2
   162		}
   163	
   164		selected, err := parseOnlyFilter(spec, *only)
   165		if err != nil {
   166			printValidationError(err)
   167			return 2
   168		}
   169	
   170		jobs, levels := listJobs(spec, selected)
   171		switch *format {
   172		case "text":
   173			os.Stdout.Write(renderListText(jobs, levels))
   174		case "json":
   175			os.Stdout.Write(renderListJSON(*specPath, jobs, levels))
   176		}
   177		return 0
   178	}
   179	
   180	func parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {
   181		if only == "" {
   182			return nil, nil
   183		}
   184	
   185		selected := map[string]bool{}
   186		seen := map[string]bool{}
   187		for _, name := range strings.Split(only, ",") {
   188			if seen[name] {
   189				continue
   190			}
   191			seen[name] = true
   192	
   193			job, ok := spec.ByName[name]
   194			if !ok {
   195				return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in --only: " + name}
   196			}
   197			addTransitiveDeps(spec, job, selected)
   198		}
   199		return selected, nil
   200	}
   201	
   202	func addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {
   203		if selected[job.Name] {
   204			return
   205		}
   206		selected[job.Name] = true
   207		for _, dep := range job.Deps {
   208			addTransitiveDeps(spec, spec.ByName[dep], selected)
   209		}
   210	}
   211	
   212	func listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {
   213		levels := computeLevels(spec)
   214		level := make(map[string]int, len(spec.Jobs))
   215		for i, names := range levels {
   216			for _, name := range names {
   217				level[name] = i
   218			}
   219		}
   220	
   221		order := make([]*Job, 0, len(spec.Jobs))
   222		for _, names := range levels {
   223			for _, name := range names {
   224				if selected != nil && !selected[name] {
   225					continue
   226				}
   227				order = append(order, spec.ByName[name])
   228			}
   229		}
   230		return order, level
   231	}
   232	
   233	func renderListText(jobs []*Job, level map[string]int) []byte {
   234		var b strings.Builder
   235		for _, job := range jobs {
   236			b.WriteString(job.Name)
   237			b.WriteString("\tlevel=")
   238			b.WriteString(strconv.Itoa(level[job.Name]))
   239			b.WriteString("\tworkdir=")
   240			b.WriteString(job.Workdir)
   241			b.WriteString("\tdeps=")
   242			b.WriteString(strings.Join(job.Deps, ","))
   243			b.WriteString("\tenv=")
   244			b.WriteString(renderEnvText(job.Env))
   245			b.WriteString("\n")
   246		}
   247		return []byte(b.String())
