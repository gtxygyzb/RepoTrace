    39	func loadSpec(path string) (*Spec, error) {
    40		data, err := os.ReadFile(path)
    41		if err != nil {
    42			return nil, &ValidationError{Code: "spec_not_found", Message: fmt.Sprintf("cannot read spec: %s", path)}
    43		}
    44	
    45		var top map[string]json.RawMessage
    46		if err := json.Unmarshal(data, &top); err != nil || top == nil {
    47			return nil, &ValidationError{Code: "spec_parse", Message: "top-level JSON must be an object"}
    48		}
    49	
    50		rawJobs, ok := top["jobs"]
    51		if !ok {
    52			return nil, &ValidationError{Code: "spec_parse", Message: "missing jobs"}
    53		}
    54	
    55		var jobsRaw []json.RawMessage
    56		if err := json.Unmarshal(rawJobs, &jobsRaw); err != nil || jobsRaw == nil {
    57			return nil, &ValidationError{Code: "spec_parse", Message: "jobs must be an array"}
    58		}
    59	
    60		var unknownTop []string
    61		for k := range top {
    62			if k != "jobs" {
    63				unknownTop = append(unknownTop, k)
    64			}
    65		}
    66		if len(unknownTop) > 0 {
    67			sort.Strings(unknownTop)
    68			return nil, &ValidationError{Code: "unknown_field", Message: "unknown field: " + unknownTop[0]}
    69		}
    70	
    71		jobMaps := make([]map[string]json.RawMessage, len(jobsRaw))
    72		for i, raw := range jobsRaw {
    73			var m map[string]json.RawMessage
    74			if err := json.Unmarshal(raw, &m); err != nil || m == nil {
    75				return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d] must be an object", i)}
    76			}
    77			jobMaps[i] = m
    78		}
    79	
    80		jobs := make([]*Job, len(jobMaps))
    81		for i, m := range jobMaps {
    82			job := &Job{
    83				Index:   i,
    84				Deps:    []string{},
    85				Env:     map[string]string{},
    86				Workdir: "/app",
    87			}
    88	
    89			if raw, ok := m["name"]; ok {
    90				var s string
    91				if err := json.Unmarshal(raw, &s); err != nil {
    92					return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].name must be a string", i)}
    93				}
    94				job.Name = s
    95			}
    96			if raw, ok := m["command"]; ok {
    97				var s string
    98				if err := json.Unmarshal(raw, &s); err != nil {
    99					return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].command must be a string", i)}
   100				}
   101				job.Command = s
   102			}
   103			if raw, ok := m["deps"]; ok {
   104				var arr []string
   105				if err := json.Unmarshal(raw, &arr); err != nil || arr == nil {
