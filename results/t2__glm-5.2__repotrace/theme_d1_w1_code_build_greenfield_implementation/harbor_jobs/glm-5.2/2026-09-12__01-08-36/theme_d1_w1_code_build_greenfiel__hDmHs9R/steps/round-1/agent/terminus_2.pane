    29			return 2
    30		}
    31		if len(fs.Args()) > 0 {
    32			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
    33			return 2
    34		}
    35		if *format != "dot" && *format != "mermaid" {
    36			fmt.Fprintln(os.Stderr, "error: bad --format")
    37			return 2
