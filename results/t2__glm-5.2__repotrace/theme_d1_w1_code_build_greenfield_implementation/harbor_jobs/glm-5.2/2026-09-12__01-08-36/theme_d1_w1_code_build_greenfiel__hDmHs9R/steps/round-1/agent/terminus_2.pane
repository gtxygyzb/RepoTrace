    53		if err := fs.Parse(args); err != nil {
    54			return 2
    55		}
    56		if *specPath == "" {
    57			fmt.Fprintln(os.Stderr, "usage: jobforge plan --spec <path> [--format json|text]")
    58			return 2
    59		}
    60		if *format != "text" && *format != "json" {
    61			fmt.Fprintf(os.Stderr, "error: invalid format: %s\n", *format)
    62			return 2
