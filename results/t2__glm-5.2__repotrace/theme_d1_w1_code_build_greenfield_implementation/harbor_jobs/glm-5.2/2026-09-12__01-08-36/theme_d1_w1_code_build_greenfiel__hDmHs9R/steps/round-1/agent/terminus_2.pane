[?2004lpackage main

import (
	"crypto/sha256"
	"encoding/hex"
	"flag"
	"fmt"
	"io"
	"os"
	"sort"
	"strings"
)

func runHash(args []string) int {
	fs := flag.NewFlagSet("hash", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	specPath := fs.String("spec", "", "path to spec file")
	format := fs.String("format", "short", "hash format: short|long")
	if err := fs.Parse(args); err != nil {
		fmt.Fprintf(os.Stderr, "error: %s\n", err)
		return 2
	}
	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "error: missing --spec")
		return 2
	}
	if len(fs.Args()) > 0 {
		fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
		return 2
	}
	if *format != "short" && *format != "long" {
		fmt.Fprintln(os.Stderr, "error: bad --format")
		return 2
	}

	spec, err := loadSpec(*specPath)
	if err != nil {
		printValidationError(err)
		return 2
	}

	var buf strings.Builder
	for _, names := range computeLevels(spec) {
		for _, name := range names {
			job := spec.ByName[name]
			buf.WriteString(job.Name)
			buf.WriteByte(0)
			buf.WriteString(job.Workdir)
			buf.WriteByte(0)
			buf.WriteString(job.Command)
			buf.WriteByte(0)
			buf.WriteString("deps=")
			buf.WriteString(strings.Join(job.Deps, ","))
			buf.WriteByte(0)
			buf.WriteString("env=")
			keys := make([]string, 0, len(job.Env))
			for k := range job.Env {
				keys = append(keys, k)
			}
			sort.Strings(keys)
			parts := make([]string, 0, len(keys))
			for _, k := range keys {
				parts = append(parts, k+"="+job.Env[k])
			}
			buf.WriteString(strings.Join(parts, ","))
			buf.WriteByte('\n')
		}
	}

	sum := sha256.Sum256([]byte(buf.String()))
	hexSum := hex.EncodeToString(sum[:])
	if *format == "short" {
		fmt.Println(hexSum[:12])
	} else {
		fmt.Println(hexSum)
	}
	return 0
}
[?2004hroot@n30009:/app# sed -n '1,220p' cmd/jobforge/graph.go
[?2004lpackage main

import (
	"flag"
	"fmt"
	"io"
	"os"
	"strconv"
	"strings"
)

type graphEdge struct {
	dep  string
	name string
}

func runGraph(args []string) int {
	fs := flag.NewFlagSet("graph", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	specPath := fs.String("spec", "", "path to spec file")
	format := fs.String("format", "dot", "output format: dot|mermaid")
	only := fs.String("only", "", "comma-separated list of job names")
	if err := fs.Parse(args); err != nil {
		fmt.Fprintf(os.Stderr, "error: %s\n", err)
		return 2
	}
	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "error: missing --spec")
		return 2
	}
	if len(fs.Args()) > 0 {
		fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
		return 2
	}
	if *format != "dot" && *format != "mermaid" {
		fmt.Fprintln(os.Stderr, "error: bad --format")
		return 2
	}

	spec, err := loadSpec(*specPath)
	if err != nil {
		printValidationError(err)
		return 2
	}

	selected, err := parseOnlyFilter(spec, *only)
	if err != nil {
		printValidationError(err)
		return 2
	}

	jobs, levels := listJobs(spec, selected)
	os.Stdout.Write(renderGraph(jobs, levels, *format))
	return 0
}

func renderGraph(jobs []*Job, level map[string]int, format string) []byte {
	inSet := make(map[string]bool, len(jobs))
	for _, job := range jobs {
		inSet[job.Name] = true
	}

	var edges []graphEdge
	for _, job := range jobs {
		for _, dep := range job.Deps {
			if inSet[dep] {
				edges = append(edges, graphEdge{dep: dep, name: job.Name})
			}
		}
	}

	switch format {
	case "dot":
		return renderDot(jobs, level, edges)
	case "mermaid":
		return renderMermaid(jobs, edges)
	}
	return nil
}

func renderDot(jobs []*Job, level map[string]int, edges []graphEdge) []byte {
	var b strings.Builder
	b.WriteString("digraph jobforge {\n")
	b.WriteString("\trankdir=LR;\n")
	for _, job := range jobs {
		b.WriteString("\t\"")
		b.WriteString(dotQuote(job.Name))
		b.WriteString("\" [level=\"")
		b.WriteString(strconv.Itoa(level[job.Name]))
		b.WriteString("\" workdir=\"")
		b.WriteString(dotQuote(job.Workdir))
		b.WriteString("\"];\n")
	}
	for _, e := range edges {
		b.WriteString("\t\"")
		b.WriteString(dotQuote(e.dep))
		b.WriteString("\" -> \"")
		b.WriteString(dotQuote(e.name))
		b.WriteString("\";\n")
	}
	b.WriteString("}\n")
	return []byte(b.String())
}

func renderMermaid(jobs []*Job, edges []graphEdge) []byte {
	var b strings.Builder
	b.WriteString("graph LR\n")
	b.WriteString("\t%% nodes=")
	b.WriteString(strconv.Itoa(len(jobs)))
	b.WriteString(" edges=")
	b.WriteString(strconv.Itoa(len(edges)))
	b.WriteString("\n")
	for _, job := range jobs {
		b.WriteString("\t")
		b.WriteString(mermaidID(job.Name))
		b.WriteString("[\"")
		b.WriteString(mermaidLabel(job.Name))
		b.WriteString("\"]\n")
	}
	for _, e := range edges {
		b.WriteString("\t")
		b.WriteString(mermaidID(e.dep))
		b.WriteString(" --> ")
		b.WriteString(mermaidID(e.name))
		b.WriteString("\n")
	}
	return []byte(b.String())
}

func dotQuote(s string) string {
	var b strings.Builder
	for i := 0; i < len(s); i++ {
		c := s[i]
		switch c {
		case '"':
			b.WriteString(`\"`)
		case '\\':
			b.WriteString(`\\`)
		default:
			b.WriteByte(c)
		}
	}
	return b.String()
}

func mermaidID(name string) string {
	var b strings.Builder
	for i := 0; i < len(name); i++ {
		c := name[i]
		if (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' {
			b.WriteByte(c)
		} else {
			b.WriteByte('_')
		}
	}
	return b.String()
}

func mermaidLabel(name string) string {
	var b strings.Builder
	for i := 0; i < len(name); i++ {
		c := name[i]
		if c == '"' {
			b.WriteString("#quot;")
		} else {
			b.WriteByte(c)
		}
	}
	return b.String()
}
