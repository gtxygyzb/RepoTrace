===== cmd/jobforge/spec.go
package main

import (
	"encoding/json"
	"fmt"
	"os"
	"regexp"
	"sort"
)

type Job struct {
	Index   int
	Name    string
	Command string
	Deps    []string
	Workdir string
	Env     map[string]string
}

type Spec struct {
	Jobs   []*Job
	ByName map[string]*Job
}

type ValidationError struct {
	Code    string
	Message string
}

func (e *ValidationError) Error() string {
	return e.Code + ": " + e.Message
}

var (
	nameRegexp   = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_-]*$`)
	envKeyRegexp = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
)

func loadSpec(path string) (*Spec, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, &ValidationError{Code: "spec_not_found", Message: fmt.Sprintf("cannot read spec: %s", path)}
	}

	var top map[string]json.RawMessage
	if err := json.Unmarshal(data, &top); err != nil || top == nil {
		return nil, &ValidationError{Code: "spec_parse", Message: "top-level JSON must be an object"}
	}

	rawJobs, ok := top["jobs"]
	if !ok {
		return nil, &ValidationError{Code: "spec_parse", Message: "missing jobs"}
	}

	var jobsRaw []json.RawMessage
	if err := json.Unmarshal(rawJobs, &jobsRaw); err != nil || jobsRaw == nil {
		return nil, &ValidationError{Code: "spec_parse", Message: "jobs must be an array"}
	}

	var unknownTop []string
	for k := range top {
		if k != "jobs" {
			unknownTop = append(unknownTop, k)
		}
	}
	if len(unknownTop) > 0 {
		sort.Strings(unknownTop)
		return nil, &ValidationError{Code: "unknown_field", Message: "unknown field: " + unknownTop[0]}
	}

	jobMaps := make([]map[string]json.RawMessage, len(jobsRaw))
	for i, raw := range jobsRaw {
		var m map[string]json.RawMessage
		if err := json.Unmarshal(raw, &m); err != nil || m == nil {
			return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d] must be an object", i)}
		}
		jobMaps[i] = m
	}

	jobs := make([]*Job, len(jobMaps))
	for i, m := range jobMaps {
		job := &Job{
			Index:   i,
			Deps:    []string{},
			Env:     map[string]string{},
			Workdir: "/app",
		}

		if raw, ok := m["name"]; ok {
			var s string
			if err := json.Unmarshal(raw, &s); err != nil {
				return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].name must be a string", i)}
			}
			job.Name = s
		}
		if raw, ok := m["command"]; ok {
			var s string
			if err := json.Unmarshal(raw, &s); err != nil {
				return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].command must be a string", i)}
			}
			job.Command = s
		}
		if raw, ok := m["deps"]; ok {
			var arr []string
			if err := json.Unmarshal(raw, &arr); err != nil || arr == nil {
				return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].deps must be an array of strings", i)}
			}
			job.Deps = arr
		}
		if raw, ok := m["workdir"]; ok {
			var s string
			if err := json.Unmarshal(raw, &s); err != nil {
				return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].workdir must be a string", i)}
			}
			job.Workdir = s
		}
		if raw, ok := m["env"]; ok {
			env := map[string]string{}
			if err := json.Unmarshal(raw, &env); err != nil || env == nil {
				return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].env must be an object of strings", i)}
			}
			job.Env = env
		}
		jobs[i] = job
	}

	for i, m := range jobMaps {
		var unknown []string
		for k := range m {
			if !isKnownJobField(k) {
				unknown = append(unknown, k)
			}
		}
		if len(unknown) > 0 {
			sort.Strings(unknown)
			return nil, &ValidationError{Code: "unknown_field", Message: fmt.Sprintf("unknown field: jobs[%d].%s", i, unknown[0])}
		}
	}

	for _, job := range jobs {
		if _, ok := jobMaps[job.Index]["name"]; !ok {
			return nil, &ValidationError{Code: "invalid_name", Message: "invalid name: <missing>"}
		}
		if !nameRegexp.MatchString(job.Name) {
			return nil, &ValidationError{Code: "invalid_name", Message: "invalid name: " + job.Name}
		}
	}

	seen := map[string]bool{}
	for _, job := range jobs {
		if seen[job.Name] {
			return nil, &ValidationError{Code: "duplicate_name", Message: "duplicate name: " + job.Name}
		}
		seen[job.Name] = true
	}

	for _, job := range jobs {
		if _, ok := jobMaps[job.Index]["command"]; !ok {
			return nil, &ValidationError{Code: "invalid_command", Message: "invalid command for " + job.Name}
		}
		if job.Command == "" {
			return nil, &ValidationError{Code: "invalid_command", Message: "invalid command for " + job.Name}
		}
	}

	for _, job := range jobs {
		keys := make([]string, 0, len(job.Env))
		for k := range job.Env {
			keys = append(keys, k)
		}
		sort.Strings(keys)
		for _, k := range keys {
			if !envKeyRegexp.MatchString(k) {
				return nil, &ValidationError{Code: "invalid_env_key", Message: "invalid env key in " + job.Name + ": " + k}
			}
		}
	}

	spec := &Spec{Jobs: jobs, ByName: map[string]*Job{}}
	for _, job := range jobs {
		spec.ByName[job.Name] = job
	}

	for _, job := range jobs {
		for _, dep := range job.Deps {
			if _, ok := spec.ByName[dep]; !ok {
				return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in " + job.Name + ": " + dep}
			}
		}
	}

	for _, job := range jobs {
		seenDeps := map[string]bool{}
		for _, dep := range job.Deps {
			if seenDeps[dep] {
				return nil, &ValidationError{Code: "duplicate_dep", Message: "duplicate dep in " + job.Name + ": " + dep}
			}
			seenDeps[dep] = true
		}
	}

	for _, job := range jobs {
		for _, dep := range job.Deps {
			if dep == job.Name {
				return nil, &ValidationError{Code: "self_dep", Message: "self dep: " + job.Name}
			}
		}
	}

	if err := detectCycle(spec); err != nil {
		return nil, err
	}

	return spec, nil
}

func isKnownJobField(k string) bool {
	switch k {
	case "name", "command", "deps", "workdir", "env":
		return true
cmd/jobforge/run.go
===== cmd/jobforge/run.go
package main

import (
	"bytes"
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"sort"
	"strconv"
	"strings"
	"syscall"
)

type jobResult struct {
	Name     string
	Status   string
	ExitCode int
	Stdout   string
	Stderr   string
}

func runSpec(spec *Spec, onFailure string, resultsPath string) int {
	levels := computeLevels(spec)
	order := make([]*Job, 0, len(spec.Jobs))
	for _, names := range levels {
		for _, name := range names {
			order = append(order, spec.ByName[name])
		}
	}

	results := make([]jobResult, len(order))
	statuses := map[string]string{}
	shortCircuit := false

	for i, job := range order {
		results[i].Name = job.Name

		if shortCircuit {
			results[i].Status = "skipped"
			results[i].ExitCode = -1
			results[i].Stdout = ""
			results[i].Stderr = ""
			statuses[job.Name] = "skipped"
			continue
		}

		skip := false
		for _, dep := range job.Deps {
			if statuses[dep] != "ok" {
				skip = true
				break
			}
		}
		if skip {
			results[i].Status = "skipped"
			results[i].ExitCode = -1
			results[i].Stdout = ""
			results[i].Stderr = ""
			statuses[job.Name] = "skipped"
			continue
		}

		stdout, stderr, exitCode := runJob(job)
		results[i].Stdout = stdout
		results[i].Stderr = stderr
		results[i].ExitCode = exitCode

		if exitCode == 0 {
			results[i].Status = "ok"
			statuses[job.Name] = "ok"
		} else {
			results[i].Status = "failed"
			statuses[job.Name] = "failed"
			if onFailure == "stop" {
				shortCircuit = true
			}
		}
	}

	if resultsPath != "" {
		if err := writeResults(resultsPath, onFailure, results); err != nil {
			fmt.Fprintf(os.Stderr, "error: results_write: %s\n", err)
			return 2
		}
	}

	for _, r := range results {
		if r.Status != "ok" {
			return 1
		}
	}
	return 0
}

func runJob(job *Job) (string, string, int) {
	cmd := exec.Command("bash", "-c", job.Command)
	cmd.Dir = job.Workdir

	envMap := map[string]string{}
	for _, kv := range os.Environ() {
		if idx := strings.IndexByte(kv, '='); idx >= 0 {
			envMap[kv[:idx]] = kv[idx+1:]
		}
	}
	for k, v := range job.Env {
		envMap[k] = v
	}
	envMap["JOBFORGE_JOB_NAME"] = job.Name
	resolvedWorkdir, err := filepath.Abs(job.Workdir)
	if err != nil {
		resolvedWorkdir = job.Workdir
	}
	envMap["JOBFORGE_JOB_WORKDIR"] = resolvedWorkdir

	env := make([]string, 0, len(envMap))
	for k, v := range envMap {
		env = append(env, k+"="+v)
	}
	sort.Strings(env)
	cmd.Env = env

	var stdoutBuf, stderrBuf bytes.Buffer
	cmd.Stdout = &stdoutBuf
	cmd.Stderr = &stderrBuf

	err = cmd.Run()
	if err != nil && cmd.ProcessState == nil {
		return sanitizeOutput(stdoutBuf.Bytes()), sanitizeOutput(stderrBuf.Bytes()), 127
	}
	exitCode := 0
	if cmd.ProcessState != nil {
		exitCode = exitCodeFromProcessState(cmd.ProcessState)
	}
	return sanitizeOutput(stdoutBuf.Bytes()), sanitizeOutput(stderrBuf.Bytes()), exitCode
}

func exitCodeFromProcessState(ps *os.ProcessState) int {
	if status, ok := ps.Sys().(syscall.WaitStatus); ok {
		if status.Exited() {
			return status.ExitStatus()
		}
		if status.Signaled() {
			return 128 + int(status.Signal())
		}
	}
	return ps.ExitCode()
}

func sanitizeOutput(b []byte) string {
	return strings.ToValidUTF8(string(b), "\ufffd")
}

func writeResults(path, onFailure string, results []jobResult) error {
	var b bytes.Buffer
	b.WriteString("{\n")
	b.WriteString("  \"on_failure\": \"")
	b.WriteString(onFailure)
	b.WriteString("\",\n")
	b.WriteString("  \"jobs\": [")
	if len(results) == 0 {
		b.WriteString("]\n")
	} else {
		b.WriteString("\n")
		for i, r := range results {
			b.WriteString("    {\n")
			b.WriteString("      \"name\": \"")
			writeJSONString(&b, r.Name)
			b.WriteString("\",\n")
			b.WriteString("      \"status\": \"")
			b.WriteString(r.Status)
			b.WriteString("\",\n")
			b.WriteString("      \"exit_code\": ")
			b.WriteString(strconv.Itoa(r.ExitCode))
			b.WriteString(",\n")
			b.WriteString("      \"stdout\": \"")
			writeJSONString(&b, r.Stdout)
			b.WriteString("\",\n")
			b.WriteString("      \"stderr\": \"")
			writeJSONString(&b, r.Stderr)
			b.WriteString("\"\n")
			b.WriteString("    }")
			if i < len(results)-1 {
				b.WriteString(",")
			}
			b.WriteString("\n")
		}
		b.WriteString("  ]\n")
	}
	b.WriteString("}\n")
	return os.WriteFile(path, b.Bytes(), 0644)
}

func writeJSONString(b *bytes.Buffer, s string) {
	for i := 0; i < len(s); i++ {
		c := s[i]
		switch c {
		case '"':
			b.WriteString(`\"`)
		case '\\':
			b.WriteString(`\\`)
		case '\b':
			b.WriteString(`\b`)
		case '\t':
			b.WriteString(`\t`)
		case '\n':
			b.WriteString(`\n`)
		case '\f':
			b.WriteString(`\f`)
		case '\r':
			b.WriteString(`\r`)
		default:
			if c < 0x20 {
				b.WriteString(fmt.Sprintf(`\u00%02x`, c))
			} else {
				b.WriteByte(c)
			}
		}
	}
}
cmd/jobforge/schedule.go
===== cmd/jobforge/schedule.go
package main

import (
	"bytes"
	"flag"
	"fmt"
	"os"
	"strconv"
)

type scheduleAssignment struct {
	Name   string `json:"name"`
	Worker int    `json:"worker"`
	Start  int    `json:"start"`
	End    int    `json:"end"`
}

func runSchedule(args []string) int {
	fs := flag.NewFlagSet("schedule", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	specPath := fs.String("spec", "", "path to spec file")
	workersStr := fs.String("workers", "", "number of worker lanes")
	format := fs.String("format", "text", "output format: text|json")

	if err := fs.Parse(args); err != nil {
		return 2
	}

	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "error: missing --spec")
		return 2
	}

	if *workersStr == "" {
		fmt.Fprintln(os.Stderr, "error: --workers required")
		return 2
	}

	workers, ok := parseWorkers(*workersStr)
	if !ok {
		fmt.Fprintln(os.Stderr, "error: bad --workers")
		return 2
	}

	if *format != "text" && *format != "json" {
		fmt.Fprintln(os.Stderr, "error: bad --format")
		return 2
	}

	if len(fs.Args()) > 0 {
		fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
		return 2
	}

	spec, err := loadSpec(*specPath)
	if err != nil {
		printValidationError(err)
		return 2
	}

	assignments, makespan := computeSchedule(spec, workers)
	switch *format {
	case "text":
		os.Stdout.Write(renderScheduleText(makespan, assignments))
	case "json":
		os.Stdout.Write(renderScheduleJSON(workers, makespan, assignments))
	}
	return 0
}

func parseWorkers(s string) (int, bool) {
	if s == "" || s[0] < '1' || s[0] > '9' {
		return 0, false
	}
	for i := 1; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return 0, false
		}
	}

	n := 0
	for i := 0; i < len(s); i++ {
		n = n*10 + int(s[i]-'0')
	}
	return n, true
}

func computeSchedule(spec *Spec, workers int) ([]scheduleAssignment, int) {
	levels := computeLevels(spec)
	busyUntil := make([]int, workers)
	endTime := make(map[string]int, len(spec.Jobs))

	assignments := make([]scheduleAssignment, 0, len(spec.Jobs))
	makespan := 0

	for _, names := range levels {
		for _, name := range names {
			job := spec.ByName[name]

			earliest := 0
			for _, dep := range job.Deps {
				if end := endTime[dep]; end > earliest {
					earliest = end
				}
			}

			worker := -1
			for w := 0; w < workers; w++ {
				if busyUntil[w] <= earliest {
					worker = w
					break
				}
				if worker == -1 || busyUntil[w] < busyUntil[worker] {
					worker = w
				}
			}
			if worker == -1 {
				worker = 0
			}
			if busyUntil[worker] > earliest {
				earliest = busyUntil[worker]
			}

			start := earliest
			end := start + 1
			busyUntil[worker] = end
			endTime[name] = end

			assignments = append(assignments, scheduleAssignment{
				Name:   name,
				Worker: worker,
				Start:  start,
				End:    end,
			})

			if end > makespan {
				makespan = end
			}
		}
	}

	return assignments, makespan
}

func renderScheduleText(makespan int, assignments []scheduleAssignment) []byte {
	var b bytes.Buffer
	b.WriteString("makespan=")
	b.WriteString(strconv.Itoa(makespan))
	b.WriteByte('\n')
	for _, a := range assignments {
		b.WriteString(a.Name)
		b.WriteString("\tworker=")
		b.WriteString(strconv.Itoa(a.Worker))
		b.WriteString("\tstart=")
		b.WriteString(strconv.Itoa(a.Start))
		b.WriteString("\tend=")
		b.WriteString(strconv.Itoa(a.End))
		b.WriteByte('\n')
	}
	return b.Bytes()
}

func renderScheduleJSON(workers, makespan int, assignments []scheduleAssignment) []byte {
	var b bytes.Buffer
	b.WriteString(`{"workers":`)
	b.WriteString(strconv.Itoa(workers))
	b.WriteString(`,"makespan":`)
	b.WriteString(strconv.Itoa(makespan))
	b.WriteString(`,"assignments":[`)
	for i, a := range assignments {
		if i > 0 {
			b.WriteByte(',')
		}
		b.WriteString(`{"name":"`)
		writeJSONString(&b, a.Name)
		b.WriteString(`","worker":`)
		b.WriteString(strconv.Itoa(a.Worker))
		b.WriteString(`,"start":`)
		b.WriteString(strconv.Itoa(a.Start))
		b.WriteString(`,"end":`)
		b.WriteString(strconv.Itoa(a.End))
		b.WriteByte('}')
	}
	b.WriteString(`]}`)
	b.WriteByte('\n')
	return b.Bytes()
}
