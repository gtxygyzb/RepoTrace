    54		for _, names := range levels {
    55			for _, name := range names {
    56				if ancestorSet[name] {
    57					ordered = append(ordered, name)
    58				}
    59			}
    60		}
    61	
    62		switch *format {
    63		case "text":
    64			if len(ordered) > 0 {
    65				os.Stdout.WriteString(strings.Join(ordered, "\n") + "\n")
    66			}
    67		case "json":
    68			out, err := json.Marshal(ordered)
    69			if err != nil {
    70				fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
    71				return 2
    72			}
    73			os.Stdout.Write(out)
    74			fmt.Println()
    75		}
