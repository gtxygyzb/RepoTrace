    52	func canonicalForm(spec *Spec) string {
    53		var buf strings.Builder
    54		for _, names := range computeLevels(spec) {
    55			for _, name := range names {
    56				job := spec.ByName[name]
    57				buf.WriteString(job.Name)
    58				buf.WriteByte(0)
    59				buf.WriteString(job.Workdir)
    60				buf.WriteByte(0)
    61				buf.WriteString(job.Command)
    62				buf.WriteByte(0)
    63				buf.WriteString("deps=")
    64				buf.WriteString(strings.Join(job.Deps, ","))
    65				buf.WriteByte(0)
    66				buf.WriteString("env=")
    67				keys := make([]string, 0, len(job.Env))
    68				for k := range job.Env {
    69					keys = append(keys, k)
    70				}
    71				sort.Strings(keys)
    72				parts := make([]string, 0, len(keys))
    73				for _, k := range keys {
    74					parts = append(parts, k+"="+job.Env[k])
    75				}
    76				buf.WriteString(strings.Join(parts, ","))
    77				buf.WriteByte('\n')
    78			}
    79		}
    80		return buf.String()
    81	}
