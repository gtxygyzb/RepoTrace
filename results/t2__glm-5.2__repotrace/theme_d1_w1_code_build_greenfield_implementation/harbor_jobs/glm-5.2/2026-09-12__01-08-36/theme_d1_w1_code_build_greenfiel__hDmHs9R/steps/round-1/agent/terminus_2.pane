func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run|validate|list|graph> --spec <path> [flags]")
		os.Exit(2)
	}

	switch os.Args[1] {
	case "plan":
		os.Exit(runPlan(os.Args[2:]))
	case "run":
		os.Exit(runRun(os.Args[2:]))
	case "validate":
		os.Exit(runValidate(os.Args[2:]))
	case "list":
		os.Exit(runList(os.Args[2:]))
	case "graph":
		os.Exit(runGraph(os.Args[2:]))
	default:
		fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run|validate|list|graph> --spec <path> [flags]")
		os.Exit(2)
	}
