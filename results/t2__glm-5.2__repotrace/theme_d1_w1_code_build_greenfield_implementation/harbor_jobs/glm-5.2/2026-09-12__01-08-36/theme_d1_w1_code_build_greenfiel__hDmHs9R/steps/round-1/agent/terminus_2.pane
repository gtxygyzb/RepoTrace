[?2004lpackage main

import (
	"bytes"
	"encoding/json"
	"flag"
	"fmt"
	"io"
	"os"
	"sort"
	"strconv"
	"strings"
)

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run|validate|list> --spec <path> [flags]")
		os.Exit(2)
	}

	switch os.Args[1] {
	case "plan":
		os.Exit(runPlan(os.Args[2:]))
	case "run":
		os.Exit(runRun(os.Args[2:]))
	case "validate":
		os.Exit(runValidate(os.Args[2:]))
	case "list":
		os.Exit(runList(os.Args[2:]))
	case "graph":
		os.Exit(runGraph(os.Args[2:]))
	default:
		fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run|validate|list> --spec <path> [flags]")
		os.Exit(2)
	}
}

func runPlan(args []string) int {
	fs := flag.NewFlagSet("plan", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	specPath := fs.String("spec", "", "path to spec file")
	format := fs.String("format", "text", "output format: json|text")
	if err := fs.Parse(args); err != nil {
		return 2
	}
	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "usage: jobforge plan --spec <path> [--format json|text]")
		return 2
	}
	if *format != "text" && *format != "json" {
		fmt.Fprintf(os.Stderr, "error: invalid format: %s\n", *format)
		return 2
	}

	spec, err := loadSpec(*specPath)
	if err != nil {
		printValidationError(err)
		return 2
	}

	levels := computeLevels(spec)
	switch *format {
	case "text":
		for i, names := range levels {
			fmt.Printf("level %d: %s\n", i, strings.Join(names, ", "))
		}
	case "json":
		out, err := json.Marshal(map[string][][]string{"levels": levels})
		if err != nil {
			fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
			return 2
		}
		os.Stdout.Write(out)
		fmt.Println()
	}
	return 0
}

func runRun(args []string) int {
	fs := flag.NewFlagSet("run", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	specPath := fs.String("spec", "", "path to spec file")
	onFailure := fs.String("on-failure", "stop", "on failure behavior: stop|continue")
	resultsPath := fs.String("results", "", "path to results JSON file")
	if err := fs.Parse(args); err != nil {
		return 2
	}
	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]")
		return 2
	}
	if *onFailure != "stop" && *onFailure != "continue" {
		fmt.Fprintf(os.Stderr, "error: invalid on-failure: %s\n", *onFailure)
		return 2
	}

	spec, err := loadSpec(*specPath)
	if err != nil {
		printValidationError(err)
		return 2
	}

	return runSpec(spec, *onFailure, *resultsPath)
}

func runValidate(args []string) int {
	fs := flag.NewFlagSet("validate", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	specPath := fs.String("spec", "", "path to spec file")
	if err := fs.Parse(args); err != nil {
		fmt.Fprintf(os.Stderr, "error: %s\n", err)
		return 2
	}
	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "error: missing --spec")
		return 2
	}
	if len(fs.Args()) > 0 {
		fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
		return 2
	}
	if _, err := loadSpec(*specPath); err != nil {
		printValidationError(err)
		return 2
	}
	return 0
}

func runList(args []string) int {
	fs := flag.NewFlagSet("list", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	specPath := fs.String("spec", "", "path to spec file")
	format := fs.String("format", "text", "output format: json|text")
	only := fs.String("only", "", "comma-separated list of job names")
	if err := fs.Parse(args); err != nil {
		fmt.Fprintf(os.Stderr, "error: %s\n", err)
		return 2
	}
	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "error: missing --spec")
		return 2
	}
	if len(fs.Args()) > 0 {
		fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
		return 2
	}
	if *format != "text" && *format != "json" {
		fmt.Fprintln(os.Stderr, "error: bad --format")
		return 2
	}

	spec, err := loadSpec(*specPath)
	if err != nil {
		printValidationError(err)
		return 2
	}

	selected, err := parseOnlyFilter(spec, *only)
	if err != nil {
		printValidationError(err)
		return 2
	}

	jobs, levels := listJobs(spec, selected)
	switch *format {
	case "text":
		os.Stdout.Write(renderListText(jobs, levels))
	case "json":
		os.Stdout.Write(renderListJSON(*specPath, jobs, levels))
	}
	return 0
}

func parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {
	if only == "" {
		return nil, nil
	}

	selected := map[string]bool{}
	seen := map[string]bool{}
	for _, name := range strings.Split(only, ",") {
		if seen[name] {
			continue
		}
		seen[name] = true

		job, ok := spec.ByName[name]
		if !ok {
			return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in --only: " + name}
		}
		addTransitiveDeps(spec, job, selected)
	}
	return selected, nil
}

func addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {
	if selected[job.Name] {
		return
	}
	selected[job.Name] = true
	for _, dep := range job.Deps {
		addTransitiveDeps(spec, spec.ByName[dep], selected)
	}
}

func listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {
	levels := computeLevels(spec)
	level := make(map[string]int, len(spec.Jobs))
	for i, names := range levels {
		for _, name := range names {
			level[name] = i
		}
	}

	order := make([]*Job, 0, len(spec.Jobs))
	for _, names := range levels {
		for _, name := range names {
			if selected != nil && !selected[name] {
				continue
			}
			order = append(order, spec.ByName[name])
		}
	}
	return order, level
}

func renderListText(jobs []*Job, level map[string]int) []byte {
	var b strings.Builder
	for _, job := range jobs {
		b.WriteString(job.Name)
		b.WriteString("\tlevel=")
		b.WriteString(strconv.Itoa(level[job.Name]))
		b.WriteString("\tworkdir=")
		b.WriteString(job.Workdir)
		b.WriteString("\tdeps=")
		b.WriteString(strings.Join(job.Deps, ","))
		b.WriteString("\tenv=")
		b.WriteString(renderEnvText(job.Env))
		b.WriteString("\n")
	}
