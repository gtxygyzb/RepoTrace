    11	func runAncestors(args []string) int {
    12	fs := flag.NewFlagSet("ancestors", flag.ContinueOnError)
    13	fs.SetOutput(os.Stderr)
    14	specPath := fs.String("spec", "", "path to spec file")
    15	jobName := fs.String("job", "", "target job")
    16	format := fs.String("format", "text", "output format: text|json")
    17	if err := fs.Parse(args); err != nil {
    18	return 2
    19	}
    20	
    21	if *specPath == "" {
    22	fmt.Fprintln(os.Stderr, "error: --spec required")
    23	return 2
    24	}
    25	if *jobName == "" {
    26	fmt.Fprintln(os.Stderr, "error: --job required")
    27	return 2
    28	}
    29	if *format != "text" && *format != "json" {
    30	fmt.Fprintln(os.Stderr, "error: bad --format")
    31	return 2
    32	}
    33	if len(fs.Args()) != 0 {
    34	fmt.Fprintln(os.Stderr, "error: unexpected arguments")
    35	return 2
    36	}
    37	
    38	spec, err := loadSpec(*specPath)
    39	if err != nil {
    40	printValidationError(err)
    41	return 2
    42	}
    43	
    44	target, ok := spec.ByName[*jobName]
    45	if !ok {
    46	fmt.Fprintf(os.Stderr, "error: unknown_job: %s\n", *jobName)
    47	return 2
    48	}
    49	
    50	ancestorSet := computeAncestorSet(spec, target)
    51	
    52	levels := computeLevels(spec)
    53	var ordered []string
    54	for _, names := range levels {
    55	for _, name := range names {
    56	if ancestorSet[name] {
    57	ordered = append(ordered, name)
