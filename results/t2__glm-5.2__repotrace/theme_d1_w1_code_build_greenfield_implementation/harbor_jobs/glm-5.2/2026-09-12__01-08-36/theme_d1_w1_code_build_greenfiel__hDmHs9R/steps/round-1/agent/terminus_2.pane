   181	
   182	func parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {
   183		if only == "" {
   184			return nil, nil
   185		}
   186	
   187		selected := map[string]bool{}
   188		seen := map[string]bool{}
   189		for _, name := range strings.Split(only, ",") {
   190			if seen[name] {
   191				continue
   192			}
   193			seen[name] = true
   194	
   195			job, ok := spec.ByName[name]
   196			if !ok {
   197				return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in --only: " + name}
   198			}
   199			addTransitiveDeps(spec, job, selected)
   200		}
   201		return selected, nil
   202	}
   203	
   204	func addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {
   205		if selected[job.Name] {
   206			return
   207		}
   208		selected[job.Name] = true
   209		for _, dep := range job.Deps {
   210			addTransitiveDeps(spec, spec.ByName[dep], selected)
   211		}
   212	}
   213	
   214	func listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {
   215		levels := computeLevels(spec)
   216		level := make(map[string]int, len(spec.Jobs))
   217		for i, names := range levels {
   218			for _, name := range names {
   219				level[name] = i
   220			}
   221		}
   222	
   223		order := make([]*Job, 0, len(spec.Jobs))
   224		for _, names := range levels {
   225			for _, name := range names {
   226				if selected != nil && !selected[name] {
   227					continue
   228				}
   229				order = append(order, spec.ByName[name])
   230			}
   231		}
   232		return order, level
   233	}
   234	
   235	func renderListText(jobs []*Job, level map[string]int) []byte {
   236		var b strings.Builder
   237		for _, job := range jobs {
   238			b.WriteString(job.Name)
   239			b.WriteString("\tlevel=")
   240			b.WriteString(strconv.Itoa(level[job.Name]))
   241			b.WriteString("\tworkdir=")
   242			b.WriteString(job.Workdir)
   243			b.WriteString("\tdeps=")
   244			b.WriteString(strings.Join(job.Deps, ","))
   245			b.WriteString("\tenv=")
   246			b.WriteString(renderEnvText(job.Env))
   247			b.WriteString("\n")
   248		}
   249		return []byte(b.String())
   250	}
   251	
   252	func renderEnvText(env map[string]string) string {
   253		if len(env) == 0 {
   254			return ""
   255		}
   256		keys := make([]string, 0, len(env))
   257		for k := range env {
   258			keys = append(keys, k)
   259		}
   260		sort.Strings(keys)
   261		parts := make([]string, len(keys))
   262		for i, k := range keys {
   263			parts[i] = k + "=" + env[k]
   264		}
   265		return strings.Join(parts, ",")
   266	}
