    14	
    15	func main() {
    16		if len(os.Args) < 2 {
    17			fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run|validate|list> --spec <path> [flags]")
    18			os.Exit(2)
    19		}
    20	
    21		switch os.Args[1] {
    22		case "plan":
