[?2004hroot@n30009:/app# sed -n '1,220p' cmd/jobforge/main.go
[?2004lpackage main

import (
	"bytes"
	"encoding/json"
	"flag"
	"fmt"
	"io"
	"os"
	"sort"
	"strconv"
	"strings"
)

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run|validate|list> --spec <path> [flags]")
		os.Exit(2)
	}

	switch os.Args[1] {
	case "plan":
		os.Exit(runPlan(os.Args[2:]))
	case "run":
		os.Exit(runRun(os.Args[2:]))
	case "validate":
		os.Exit(runValidate(os.Args[2:]))
	case "list":
		os.Exit(runList(os.Args[2:]))
	case "graph":
		os.Exit(runGraph(os.Args[2:]))
	default:
		fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run|validate|list> --spec <path> [flags]")
		os.Exit(2)
	}
}

func runPlan(args []string) int {
	fs := flag.NewFlagSet("plan", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	specPath := fs.String("spec", "", "path to spec file")
	format := fs.String("format", "text", "output format: json|text")
	if err := fs.Parse(args); err != nil {
		return 2
	}
	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "usage: jobforge plan --spec <path> [--format json|text]")
		return 2
	}
	if *format != "text" && *format != "json" {
		fmt.Fprintf(os.Stderr, "error: invalid format: %s\n", *format)
		return 2
	}

	spec, err := loadSpec(*specPath)
	if err != nil {
		printValidationError(err)
		return 2
	}

	levels := computeLevels(spec)
	switch *format {
	case "text":
		for i, names := range levels {
			fmt.Printf("level %d: %s\n", i, strings.Join(names, ", "))
		}
	case "json":
		out, err := json.Marshal(map[string][][]string{"levels": levels})
		if err != nil {
			fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
			return 2
		}
		os.Stdout.Write(out)
		fmt.Println()
	}
	return 0
}

func runRun(args []string) int {
	fs := flag.NewFlagSet("run", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	specPath := fs.String("spec", "", "path to spec file")
	onFailure := fs.String("on-failure", "stop", "on failure behavior: stop|continue")
	resultsPath := fs.String("results", "", "path to results JSON file")
	if err := fs.Parse(args); err != nil {
		return 2
	}
	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]")
		return 2
	}
	if *onFailure != "stop" && *onFailure != "continue" {
		fmt.Fprintf(os.Stderr, "error: invalid on-failure: %s\n", *onFailure)
		return 2
	}

	spec, err := loadSpec(*specPath)
	if err != nil {
		printValidationError(err)
		return 2
	}

	return runSpec(spec, *onFailure, *resultsPath)
}

func runValidate(args []string) int {
	fs := flag.NewFlagSet("validate", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	specPath := fs.String("spec", "", "path to spec file")
	if err := fs.Parse(args); err != nil {
		fmt.Fprintf(os.Stderr, "error: %s\n", err)
		return 2
	}
	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "error: missing --spec")
		return 2
	}
	if len(fs.Args()) > 0 {
		fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
		return 2
	}
	if _, err := loadSpec(*specPath); err != nil {
		printValidationError(err)
		return 2
	}
	return 0
}

func runList(args []string) int {
	fs := flag.NewFlagSet("list", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	specPath := fs.String("spec", "", "path to spec file")
	format := fs.String("format", "text", "output format: json|text")
	only := fs.String("only", "", "comma-separated list of job names")
	if err := fs.Parse(args); err != nil {
		fmt.Fprintf(os.Stderr, "error: %s\n", err)
		return 2
	}
	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "error: missing --spec")
		return 2
	}
	if len(fs.Args()) > 0 {
		fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
		return 2
	}
	if *format != "text" && *format != "json" {
		fmt.Fprintln(os.Stderr, "error: bad --format")
		return 2
	}

	spec, err := loadSpec(*specPath)
	if err != nil {
		printValidationError(err)
		return 2
	}

	selected, err := parseOnlyFilter(spec, *only)
	if err != nil {
		printValidationError(err)
		return 2
	}

	jobs, levels := listJobs(spec, selected)
	switch *format {
	case "text":
		os.Stdout.Write(renderListText(jobs, levels))
	case "json":
		os.Stdout.Write(renderListJSON(*specPath, jobs, levels))
	}
	return 0
}

func parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {
	if only == "" {
		return nil, nil
	}

	selected := map[string]bool{}
	seen := map[string]bool{}
	for _, name := range strings.Split(only, ",") {
		if seen[name] {
			continue
		}
		seen[name] = true

		job, ok := spec.ByName[name]
		if !ok {
			return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in --only: " + name}
		}
		addTransitiveDeps(spec, job, selected)
	}
	return selected, nil
}

func addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {
	if selected[job.Name] {
		return
	}
	selected[job.Name] = true
	for _, dep := range job.Deps {
		addTransitiveDeps(spec, spec.ByName[dep], selected)
	}
}

func listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {
	levels := computeLevels(spec)
	level := make(map[string]int, len(spec.Jobs))
	for i, names := range levels {
		for _, name := range names {
			level[name] = i
		}
	}

	order := make([]*Job, 0, len(spec.Jobs))
	for _, names := range levels {
		for _, name := range names {
			if selected != nil && !selected[name] {
				continue
			}
[?2004hroot@n30009:/app# sed -n '1,280p' cmd/jobforge/spec.go
[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"regexp"
	"sort"
)

type Job struct {
	Index   int
	Name    string
	Command string
	Deps    []string
	Workdir string
	Env     map[string]string
}

type Spec struct {
	Jobs   []*Job
	ByName map[string]*Job
}

type ValidationError struct {
	Code    string
	Message string
}

func (e *ValidationError) Error() string {
	return e.Code + ": " + e.Message
}

var (
	nameRegexp   = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_-]*$`)
	envKeyRegexp = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
)

func loadSpec(path string) (*Spec, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, &ValidationError{Code: "spec_not_found", Message: fmt.Sprintf("cannot read spec: %s", path)}
	}

	var top map[string]json.RawMessage
	if err := json.Unmarshal(data, &top); err != nil || top == nil {
		return nil, &ValidationError{Code: "spec_parse", Message: "top-level JSON must be an object"}
	}

	rawJobs, ok := top["jobs"]
	if !ok {
		return nil, &ValidationError{Code: "spec_parse", Message: "missing jobs"}
	}

	var jobsRaw []json.RawMessage
	if err := json.Unmarshal(rawJobs, &jobsRaw); err != nil || jobsRaw == nil {
		return nil, &ValidationError{Code: "spec_parse", Message: "jobs must be an array"}
	}

	var unknownTop []string
	for k := range top {
		if k != "jobs" {
			unknownTop = append(unknownTop, k)
		}
	}
	if len(unknownTop) > 0 {
		sort.Strings(unknownTop)
		return nil, &ValidationError{Code: "unknown_field", Message: "unknown field: " + unknownTop[0]}
	}

	jobMaps := make([]map[string]json.RawMessage, len(jobsRaw))
	for i, raw := range jobsRaw {
		var m map[string]json.RawMessage
		if err := json.Unmarshal(raw, &m); err != nil || m == nil {
			return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d] must be an object", i)}
		}
		jobMaps[i] = m
	}

	jobs := make([]*Job, len(jobMaps))
	for i, m := range jobMaps {
		job := &Job{
			Index:   i,
			Deps:    []string{},
			Env:     map[string]string{},
			Workdir: "/app",
		}

		if raw, ok := m["name"]; ok {
			var s string
			if err := json.Unmarshal(raw, &s); err != nil {
				return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].name must be a string", i)}
			}
			job.Name = s
		}
		if raw, ok := m["command"]; ok {
			var s string
			if err := json.Unmarshal(raw, &s); err != nil {
				return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].command must be a string", i)}
			}
			job.Command = s
		}
		if raw, ok := m["deps"]; ok {
			var arr []string
			if err := json.Unmarshal(raw, &arr); err != nil || arr == nil {
				return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].deps must be an array of strings", i)}
			}
			job.Deps = arr
		}
		if raw, ok := m["workdir"]; ok {
			var s string
			if err := json.Unmarshal(raw, &s); err != nil {
				return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].workdir must be a string", i)}
			}
			job.Workdir = s
		}
		if raw, ok := m["env"]; ok {
			env := map[string]string{}
			if err := json.Unmarshal(raw, &env); err != nil || env == nil {
				return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].env must be an object of strings", i)}
			}
			job.Env = env
		}
		jobs[i] = job
	}

	for i, m := range jobMaps {
		var unknown []string
		for k := range m {
			if !isKnownJobField(k) {
				unknown = append(unknown, k)
			}
		}
		if len(unknown) > 0 {
			sort.Strings(unknown)
			return nil, &ValidationError{Code: "unknown_field", Message: fmt.Sprintf("unknown field: jobs[%d].%s", i, unknown[0])}
		}
	}

	for _, job := range jobs {
		if _, ok := jobMaps[job.Index]["name"]; !ok {
			return nil, &ValidationError{Code: "invalid_name", Message: "invalid name: <missing>"}
		}
		if !nameRegexp.MatchString(job.Name) {
			return nil, &ValidationError{Code: "invalid_name", Message: "invalid name: " + job.Name}
		}
	}

	seen := map[string]bool{}
	for _, job := range jobs {
		if seen[job.Name] {
			return nil, &ValidationError{Code: "duplicate_name", Message: "duplicate name: " + job.Name}
		}
		seen[job.Name] = true
	}

	for _, job := range jobs {
		if _, ok := jobMaps[job.Index]["command"]; !ok {
			return nil, &ValidationError{Code: "invalid_command", Message: "invalid command for " + job.Name}
		}
		if job.Command == "" {
			return nil, &ValidationError{Code: "invalid_command", Message: "invalid command for " + job.Name}
		}
	}

	for _, job := range jobs {
		keys := make([]string, 0, len(job.Env))
		for k := range job.Env {
			keys = append(keys, k)
		}
		sort.Strings(keys)
		for _, k := range keys {
			if !envKeyRegexp.MatchString(k) {
				return nil, &ValidationError{Code: "invalid_env_key", Message: "invalid env key in " + job.Name + ": " + k}
			}
		}
	}

	spec := &Spec{Jobs: jobs, ByName: map[string]*Job{}}
	for _, job := range jobs {
		spec.ByName[job.Name] = job
	}

	for _, job := range jobs {
		for _, dep := range job.Deps {
			if _, ok := spec.ByName[dep]; !ok {
				return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in " + job.Name + ": " + dep}
			}
		}
	}

	for _, job := range jobs {
		seenDeps := map[string]bool{}
		for _, dep := range job.Deps {
			if seenDeps[dep] {
				return nil, &ValidationError{Code: "duplicate_dep", Message: "duplicate dep in " + job.Name + ": " + dep}
			}
			seenDeps[dep] = true
		}
	}

	for _, job := range jobs {
		for _, dep := range job.Deps {
			if dep == job.Name {
				return nil, &ValidationError{Code: "self_dep", Message: "self dep: " + job.Name}
			}
		}
	}

	if err := detectCycle(spec); err != nil {
		return nil, err
	}

	return spec, nil
}

func isKnownJobField(k string) bool {
	switch k {
	case "name", "command", "deps", "workdir", "env":
		return true
	}
	return false
}

func computeLevels(spec *Spec) [][]string {
	level := map[string]int{}

	var dfs func(job *Job) int
	dfs = func(job *Job) int {
		if l, ok := level[job.Name]; ok {
			return l
		}
		maxDep := -1
		for _, dep := range job.Deps {
			l := dfs(spec.ByName[dep])
			if l > maxDep {
				maxDep = l
			}
		}
		level[job.Name] = maxDep + 1
		return level[job.Name]
	}

	for _, job := range spec.Jobs {
		dfs(job)
	}

	maxLevel := -1
	for _, l := range level {
		if l > maxLevel {
			maxLevel = l
		}
	}

	levels := make([][]string, maxLevel+1)
	for _, job := range spec.Jobs {
		levels[level[job.Name]] = append(levels[level[job.Name]], job.Name)
	}
	for _, names := range levels {
		sort.Strings(names)
	}
	return levels
}
