   150		for _, job := range jobs {
   151			if seen[job.Name] {
   152				return nil, &ValidationError{Code: "duplicate_name", Message: "duplicate name: " + job.Name}
   153			}
   154			seen[job.Name] = true
   155		}
   156	
   157		for _, job := range jobs {
   158			if _, ok := jobMaps[job.Index]["command"]; !ok {
   159				return nil, &ValidationError{Code: "invalid_command", Message: "invalid command for " + job.Name}
   160			}
   161			if job.Command == "" {
   162				return nil, &ValidationError{Code: "invalid_command", Message: "invalid command for " + job.Name}
   163			}
   164		}
   165	
   166		for _, job := range jobs {
   167			keys := make([]string, 0, len(job.Env))
   168			for k := range job.Env {
   169				keys = append(keys, k)
   170			}
   171			sort.Strings(keys)
   172			for _, k := range keys {
   173				if !envKeyRegexp.MatchString(k) {
   174					return nil, &ValidationError{Code: "invalid_env_key", Message: "invalid env key in " + job.Name + ": " + k}
   175				}
   176			}
   177		}
   178	
   179		spec := &Spec{Jobs: jobs, ByName: map[string]*Job{}}
   180		for _, job := range jobs {
   181			spec.ByName[job.Name] = job
   182		}
   183	
   184		for _, job := range jobs {
   185			for _, dep := range job.Deps {
   186				if _, ok := spec.ByName[dep]; !ok {
   187					return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in " + job.Name + ": " + dep}
   188				}
   189			}
   190		}
   191	
   192		for _, job := range jobs {
   193			seenDeps := map[string]bool{}
   194			for _, dep := range job.Deps {
   195				if seenDeps[dep] {
   196					return nil, &ValidationError{Code: "duplicate_dep", Message: "duplicate dep in " + job.Name + ": " + dep}
   197				}
   198				seenDeps[dep] = true
   199			}
   200		}
   201	
   202		for _, job := range jobs {
   203			for _, dep := range job.Deps {
   204				if dep == job.Name {
   205					return nil, &ValidationError{Code: "self_dep", Message: "self dep: " + job.Name}
   206				}
   207			}
   208		}
   209	
   210		if err := detectCycle(spec); err != nil {
   211			return nil, err
   212		}
   213	
   214		return spec, nil
   215	}
   216	
   217	func isKnownJobField(k string) bool {
   218		switch k {
   219		case "name", "command", "deps", "workdir", "env":
   220			return true
   221		}
   222		return false
   223	}
