    71				return 2
    72			}
    73			os.Stdout.Write(out)
    74			fmt.Println()
    75		}
    76		return 0
    77	}
    78	
    79	func runRun(args []string) int {
    80		fs := flag.NewFlagSet("run", flag.ContinueOnError)
    81		fs.SetOutput(os.Stderr)
    82		specPath := fs.String("spec", "", "path to spec file")
    83		onFailure := fs.String("on-failure", "stop", "on failure behavior: stop|continue")
    84		resultsPath := fs.String("results", "", "path to results JSON file")
    85		if err := fs.Parse(args); err != nil {
    86			return 2
    87		}
    88		if *specPath == "" {
    89			fmt.Fprintln(os.Stderr, "usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]")
    90			return 2
    91		}
    92		if *onFailure != "stop" && *onFailure != "continue" {
    93			fmt.Fprintf(os.Stderr, "error: invalid on-failure: %s\n", *onFailure)
    94			return 2
    95		}
    96	
    97		spec, err := loadSpec(*specPath)
    98		if err != nil {
    99			printValidationError(err)
   100			return 2
   101		}
   102	
   103		return runSpec(spec, *onFailure, *resultsPath)
   104	}
   105	
   106	func runValidate(args []string) int {
   107		fs := flag.NewFlagSet("validate", flag.ContinueOnError)
   108		fs.SetOutput(io.Discard)
   109		specPath := fs.String("spec", "", "path to spec file")
   110		if err := fs.Parse(args); err != nil {
   111			fmt.Fprintf(os.Stderr, "error: %s\n", err)
   112			return 2
   113		}
   114		if *specPath == "" {
   115			fmt.Fprintln(os.Stderr, "error: missing --spec")
   116			return 2
   117		}
   118		if len(fs.Args()) > 0 {
   119			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
   120			return 2
   121		}
   122		if _, err := loadSpec(*specPath); err != nil {
   123			printValidationError(err)
   124			return 2
   125		}
   126		return 0
   127	}
   128	
   129	func runList(args []string) int {
   130		fs := flag.NewFlagSet("list", flag.ContinueOnError)
   131		fs.SetOutput(io.Discard)
   132		specPath := fs.String("spec", "", "path to spec file")
   133		format := fs.String("format", "text", "output format: json|text")
   134		only := fs.String("only", "", "comma-separated list of job names")
   135		if err := fs.Parse(args); err != nil {
   136			fmt.Fprintf(os.Stderr, "error: %s\n", err)
   137			return 2
   138		}
   139		if *specPath == "" {
   140			fmt.Fprintln(os.Stderr, "error: missing --spec")
   141			return 2
   142		}
   143		if len(fs.Args()) > 0 {
   144			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
   145			return 2
   146		}
   147		if *format != "text" && *format != "json" {
   148			fmt.Fprintln(os.Stderr, "error: bad --format")
   149			return 2
   150		}
   151	
   152		spec, err := loadSpec(*specPath)
   153		if err != nil {
   154			printValidationError(err)
   155			return 2
   156		}
   157	
   158		selected, err := parseOnlyFilter(spec, *only)
   159		if err != nil {
   160			printValidationError(err)
   161			return 2
   162		}
   163	
   164		jobs, levels := listJobs(spec, selected)
   165		switch *format {
   166		case "text":
   167			os.Stdout.Write(renderListText(jobs, levels))
   168		case "json":
   169			os.Stdout.Write(renderListJSON(*specPath, jobs, levels))
   170		}
   171		return 0
   172	}
   173	
   174	func parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {
   175		if only == "" {
   176			return nil, nil
   177		}
   178	
   179		selected := map[string]bool{}
   180		seen := map[string]bool{}
   181		for _, name := range strings.Split(only, ",") {
   182			if seen[name] {
   183				continue
   184			}
   185			seen[name] = true
   186	
   187			job, ok := spec.ByName[name]
   188			if !ok {
   189				return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in --only: " + name}
   190			}
   191			addTransitiveDeps(spec, job, selected)
   192		}
   193		return selected, nil
   194	}
   195	
   196	func addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {
   197		if selected[job.Name] {
   198			return
   199		}
   200		selected[job.Name] = true
   201		for _, dep := range job.Deps {
   202			addTransitiveDeps(spec, spec.ByName[dep], selected)
   203		}
   204	}
   205	
   206	func listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {
   207		levels := computeLevels(spec)
   208		level := make(map[string]int, len(spec.Jobs))
   209		for i, names := range levels {
   210			for _, name := range names {
   211				level[name] = i
   212			}
   213		}
   214	
   215		order := make([]*Job, 0, len(spec.Jobs))
   216		for _, names := range levels {
   217			for _, name := range names {
   218				if selected != nil && !selected[name] {
   219					continue
   220				}
   221				order = append(order, spec.ByName[name])
   222			}
   223		}
   224		return order, level
   225	}
   226	
   227	func renderListText(jobs []*Job, level map[string]int) []byte {
   228		var b strings.Builder
   229		for _, job := range jobs {
   230			b.WriteString(job.Name)
   231			b.WriteString("\tlevel=")
   232			b.WriteString(strconv.Itoa(level[job.Name]))
   233			b.WriteString("\tworkdir=")
   234			b.WriteString(job.Workdir)
   235			b.WriteString("\tdeps=")
   236			b.WriteString(strings.Join(job.Deps, ","))
   237			b.WriteString("\tenv=")
   238			b.WriteString(renderEnvText(job.Env))
   239			b.WriteString("\n")
   240		}
   241		return []byte(b.String())
   242	}
   243	
   244	func renderEnvText(env map[string]string) string {
   245		if len(env) == 0 {
   246			return ""
   247		}
   248		keys := make([]string, 0, len(env))
   249		for k := range env {
   250			keys = append(keys, k)
   251		}
   252		sort.Strings(keys)
   253		parts := make([]string, len(keys))
   254		for i, k := range keys {
   255			parts[i] = k + "=" + env[k]
   256		}
   257		return strings.Join(parts, ",")
   258	}
   259	
