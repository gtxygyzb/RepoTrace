   114			return 2
   115		}
   116		if len(fs.Args()) > 0 {
   117			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
   118			return 2
   119		}
   120		if _, err := loadSpec(*specPath); err != nil {
   121			printValidationError(err)
   122			return 2
   123		}
   124		return 0
   125	}
   126	
   127	func runList(args []string) int {
   128		fs := flag.NewFlagSet("list", flag.ContinueOnError)
   129		fs.SetOutput(io.Discard)
   130		specPath := fs.String("spec", "", "path to spec file")
   131		format := fs.String("format", "text", "output format: json|text")
   132		only := fs.String("only", "", "comma-separated list of job names")
   133		if err := fs.Parse(args); err != nil {
   134			fmt.Fprintf(os.Stderr, "error: %s\n", err)
   135			return 2
