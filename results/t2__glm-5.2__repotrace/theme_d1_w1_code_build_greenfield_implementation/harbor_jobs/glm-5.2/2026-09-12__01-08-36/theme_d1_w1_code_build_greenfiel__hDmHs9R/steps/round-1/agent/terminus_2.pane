   182		}
   183	
   184		for _, job := range jobs {
   185			for _, dep := range job.Deps {
   186				if _, ok := spec.ByName[dep]; !ok {
   187					return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in " + job.Name + ": " + dep}
   188				}
   189			}
   190		}
   191	
   192		for _, job := range jobs {
   193			seenDeps := map[string]bool{}
   194			for _, dep := range job.Deps {
   195				if seenDeps[dep] {
   196					return nil, &ValidationError{Code: "duplicate_dep", Message: "duplicate dep in " + job.Name + ": " + dep}
   197				}
   198				seenDeps[dep] = true
   199			}
   200		}
   201	
   202		for _, job := range jobs {
   203			for _, dep := range job.Deps {
   204				if dep == job.Name {
   205					return nil, &ValidationError{Code: "self_dep", Message: "self dep: " + job.Name}
   206				}
   207			}
   208		}
   209	
   210		if err := detectCycle(spec); err != nil {
   211			return nil, err
   212		}
   213	
   214		return spec, nil
   215	}
   216	
   217	func isKnownJobField(k string) bool {
   218		switch k {
   219		case "name", "command", "deps", "workdir", "env":
   220			return true
   221		}
   222		return false
   223	}
   224	
   225	func computeLevels(spec *Spec) [][]string {
   226		level := map[string]int{}
   227	
   228		var dfs func(job *Job) int
   229		dfs = func(job *Job) int {
   230			if l, ok := level[job.Name]; ok {
   231				return l
   232			}
   233			maxDep := -1
   234			for _, dep := range job.Deps {
   235				l := dfs(spec.ByName[dep])
   236				if l > maxDep {
   237					maxDep = l
   238				}
   239			}
   240			level[job.Name] = maxDep + 1
   241			return level[job.Name]
   242		}
   243	
   244		for _, job := range spec.Jobs {
   245			dfs(job)
   246		}
   247	
   248		maxLevel := -1
   249		for _, l := range level {
   250			if l > maxLevel {
   251				maxLevel = l
   252			}
   253		}
   254	
   255		levels := make([][]string, maxLevel+1)
   256		for _, job := range spec.Jobs {
   257			levels[level[job.Name]] = append(levels[level[job.Name]], job.Name)
   258		}
   259		for _, names := range levels {
   260			sort.Strings(names)
   261		}
   262		return levels
   263	}
