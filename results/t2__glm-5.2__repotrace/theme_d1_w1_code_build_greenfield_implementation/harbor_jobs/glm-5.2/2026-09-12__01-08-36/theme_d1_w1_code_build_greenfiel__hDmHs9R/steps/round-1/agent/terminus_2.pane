   137		if *specPath == "" {
   138			fmt.Fprintln(os.Stderr, "error: missing --spec")
   139			return 2
   140		}
   141		if len(fs.Args()) > 0 {
   142			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
   143			return 2
   144		}
   145		if *format != "text" && *format != "json" {
