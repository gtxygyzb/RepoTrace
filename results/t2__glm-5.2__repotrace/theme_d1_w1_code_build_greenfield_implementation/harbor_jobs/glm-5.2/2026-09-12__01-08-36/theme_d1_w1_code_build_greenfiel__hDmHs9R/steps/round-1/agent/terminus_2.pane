   117			if raw, ok := m["env"]; ok {
   118				env := map[string]string{}
   119				if err := json.Unmarshal(raw, &env); err != nil || env == nil {
   120					return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].env must be an object of strings", i)}
   121				}
   122				job.Env = env
   123			}
   124			jobs[i] = job
   125		}
   126	
   127		for i, m := range jobMaps {
   128			var unknown []string
   129			for k := range m {
   130				if !isKnownJobField(k) {
   131					unknown = append(unknown, k)
   132				}
   133			}
   134			if len(unknown) > 0 {
   135				sort.Strings(unknown)
   136				return nil, &ValidationError{Code: "unknown_field", Message: fmt.Sprintf("unknown field: jobs[%d].%s", i, unknown[0])}
   137			}
   138		}
   139	
   140		for _, job := range jobs {
   141			if _, ok := jobMaps[job.Index]["name"]; !ok {
   142				return nil, &ValidationError{Code: "invalid_name", Message: "invalid name: <missing>"}
   143			}
   144			if !nameRegexp.MatchString(job.Name) {
   145				return nil, &ValidationError{Code: "invalid_name", Message: "invalid name: " + job.Name}
   146			}
   147		}
   148	
   149		seen := map[string]bool{}
   150		for _, job := range jobs {
   151			if seen[job.Name] {
   152				return nil, &ValidationError{Code: "duplicate_name", Message: "duplicate name: " + job.Name}
   153			}
   154			seen[job.Name] = true
   155		}
   156	
   157		for _, job := range jobs {
