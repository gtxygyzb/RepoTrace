    87			fmt.Fprintln(os.Stderr, "usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]")
    88			return 2
    89		}
    90		if *onFailure != "stop" && *onFailure != "continue" {
    91			fmt.Fprintf(os.Stderr, "error: invalid on-failure: %s\n", *onFailure)
    92			return 2
    93		}
    94	
    95		spec, err := loadSpec(*specPath)
    96		if err != nil {
    97			printValidationError(err)
    98			return 2
    99		}
   100	
   101		return runSpec(spec, *onFailure, *resultsPath)
   102	}
   103	
   104	func runValidate(args []string) int {
   105		fs := flag.NewFlagSet("validate", flag.ContinueOnError)
   106		fs.SetOutput(io.Discard)
   107		specPath := fs.String("spec", "", "path to spec file")
