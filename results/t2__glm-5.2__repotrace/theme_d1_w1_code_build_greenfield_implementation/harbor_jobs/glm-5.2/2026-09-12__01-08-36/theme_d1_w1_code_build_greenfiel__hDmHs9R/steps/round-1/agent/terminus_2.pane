    14	
    15	type jobResult struct {
    16		Name     string
    17		Status   string
    18		ExitCode int
    19		Stdout   string
    20		Stderr   string
    21	}
    22	
    23	func runSpec(spec *Spec, onFailure string, resultsPath string) int {
    24		levels := computeLevels(spec)
    25		order := make([]*Job, 0, len(spec.Jobs))
    26		for _, names := range levels {
    27			for _, name := range names {
    28				order = append(order, spec.ByName[name])
    29			}
    30		}
    31	
    32		results := make([]jobResult, len(order))
    33		statuses := map[string]string{}
    34		shortCircuit := false
    35	
    36		for i, job := range order {
    37			results[i].Name = job.Name
    38	
    39			if shortCircuit {
    40				results[i].Status = "skipped"
    41				results[i].ExitCode = -1
    42				results[i].Stdout = ""
    43				results[i].Stderr = ""
    44				statuses[job.Name] = "skipped"
    45				continue
    46			}
    47	
    48			skip := false
    49			for _, dep := range job.Deps {
    50				if statuses[dep] != "ok" {
    51					skip = true
    52					break
    53				}
    54			}
    55			if skip {
    56				results[i].Status = "skipped"
    57				results[i].ExitCode = -1
    58				results[i].Stdout = ""
    59				results[i].Stderr = ""
    60				statuses[job.Name] = "skipped"
    61				continue
    62			}
    63	
    64			stdout, stderr, exitCode := runJob(job)
    65			results[i].Stdout = stdout
    66			results[i].Stderr = stderr
    67			results[i].ExitCode = exitCode
    68	
    69			if exitCode == 0 {
    70				results[i].Status = "ok"
    71				statuses[job.Name] = "ok"
    72			} else {
    73				results[i].Status = "failed"
    74				statuses[job.Name] = "failed"
    75				if onFailure == "stop" {
    76					shortCircuit = true
    77				}
    78			}
    79		}
    80	
    81		if resultsPath != "" {
    82			if err := writeResults(resultsPath, onFailure, results); err != nil {
    83				fmt.Fprintf(os.Stderr, "error: results_write: %s\n", err)
    84				return 2
    85			}
    86		}
    87	
    88		for _, r := range results {
    89			if r.Status != "ok" {
    90				return 1
    91			}
    92		}
    93		return 0
    94	}
    95	
    96	func runJob(job *Job) (string, string, int) {
    97		cmd := exec.Command("bash", "-c", job.Command)
    98		cmd.Dir = job.Workdir
    99	
   100		envMap := map[string]string{}
   101		for _, kv := range os.Environ() {
   102			if idx := strings.IndexByte(kv, '='); idx >= 0 {
   103				envMap[kv[:idx]] = kv[idx+1:]
   104			}
   105		}
   106		for k, v := range job.Env {
   107			envMap[k] = v
   108		}
   109		envMap["JOBFORGE_JOB_NAME"] = job.Name
   110		resolvedWorkdir, err := filepath.Abs(job.Workdir)
   111		if err != nil {
   112			resolvedWorkdir = job.Workdir
   113		}
   114		envMap["JOBFORGE_JOB_WORKDIR"] = resolvedWorkdir
   115	
   116		env := make([]string, 0, len(envMap))
   117		for k, v := range envMap {
   118			env = append(env, k+"="+v)
   119		}
   120		sort.Strings(env)
   121		cmd.Env = env
   122	
   123		var stdoutBuf, stderrBuf bytes.Buffer
   124		cmd.Stdout = &stdoutBuf
   125		cmd.Stderr = &stderrBuf
   126	
   127		err = cmd.Run()
   128		if err != nil && cmd.ProcessState == nil {
   129			return sanitizeOutput(stdoutBuf.Bytes()), sanitizeOutput(stderrBuf.Bytes()), 127
   130		}
   131		exitCode := 0
   132		if cmd.ProcessState != nil {
   133			exitCode = exitCodeFromProcessState(cmd.ProcessState)
   134		}
   135		return sanitizeOutput(stdoutBuf.Bytes()), sanitizeOutput(stderrBuf.Bytes()), exitCode
   136	}
   137	
   138	func exitCodeFromProcessState(ps *os.ProcessState) int {
   139		if status, ok := ps.Sys().(syscall.WaitStatus); ok {
   140			if status.Exited() {
   141				return status.ExitStatus()
   142			}
   143			if status.Signaled() {
   144				return 128 + int(status.Signal())
   145			}
   146		}
   147		return ps.ExitCode()
   148	}
   149	
   150	func sanitizeOutput(b []byte) string {
   151		return strings.ToValidUTF8(string(b), "\ufffd")
   152	}
   153	
   154	func writeResults(path, onFailure string, results []jobResult) error {
   155		var b bytes.Buffer
   156		b.WriteString("{\n")
   157		b.WriteString("  \"on_failure\": \"")
   158		b.WriteString(onFailure)
   159		b.WriteString("\",\n")
   160		b.WriteString("  \"jobs\": [")
   161		if len(results) == 0 {
   162			b.WriteString("]\n")
   163		} else {
   164			b.WriteString("\n")
   165			for i, r := range results {
   166				b.WriteString("    {\n")
   167				b.WriteString("      \"name\": \"")
   168				writeJSONString(&b, r.Name)
   169				b.WriteString("\",\n")
   170				b.WriteString("      \"status\": \"")
   171				b.WriteString(r.Status)
   172				b.WriteString("\",\n")
   173				b.WriteString("      \"exit_code\": ")
   174				b.WriteString(strconv.Itoa(r.ExitCode))
   175				b.WriteString(",\n")
   176				b.WriteString("      \"stdout\": \"")
   177				writeJSONString(&b, r.Stdout)
   178				b.WriteString("\",\n")
   179				b.WriteString("      \"stderr\": \"")
   180				writeJSONString(&b, r.Stderr)
   181				b.WriteString("\"\n")
   182				b.WriteString("    }")
   183				if i < len(results)-1 {
   184					b.WriteString(",")
   185				}
   186				b.WriteString("\n")
   187			}
   188			b.WriteString("  ]\n")
   189		}
   190		b.WriteString("}\n")
   191		return os.WriteFile(path, b.Bytes(), 0644)
   192	}
   193	
   194	func writeJSONString(b *bytes.Buffer, s string) {
   195		for i := 0; i < len(s); i++ {
   196			c := s[i]
   197			switch c {
   198			case '"':
   199				b.WriteString(`\"`)
   200			case '\\':
   201				b.WriteString(`\\`)
   202			case '\b':
   203				b.WriteString(`\b`)
   204			case '\t':
   205				b.WriteString(`\t`)
   206			case '\n':
   207				b.WriteString(`\n`)
   208			case '\f':
   209				b.WriteString(`\f`)
   210			case '\r':
   211				b.WriteString(`\r`)
   212			default:
   213				if c < 0x20 {
   214					b.WriteString(fmt.Sprintf(`\u00%02x`, c))
   215				} else {
   216					b.WriteByte(c)
   217				}
   218			}
   219		}
   220	}
