   142			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
   143			return 2
   144		}
   145		if *format != "text" && *format != "json" {
   146			fmt.Fprintln(os.Stderr, "error: bad --format")
