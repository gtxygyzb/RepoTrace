    17	func runGraph(args []string) int {
    18		fs := flag.NewFlagSet("graph", flag.ContinueOnError)
    19		fs.SetOutput(io.Discard)
    20		specPath := fs.String("spec", "", "path to spec file")
    21		format := fs.String("format", "dot", "output format: dot|mermaid")
    22		only := fs.String("only", "", "comma-separated list of job names")
    23		if err := fs.Parse(args); err != nil {
    24			fmt.Fprintf(os.Stderr, "error: %s\n", err)
    25			return 2
    26		}
    27		if *specPath == "" {
    28			fmt.Fprintln(os.Stderr, "error: missing --spec")
    29			return 2
    30		}
    31		if len(fs.Args()) > 0 {
    32			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
    33			return 2
    34		}
    35		if *format != "dot" && *format != "mermaid" {
    36			fmt.Fprintln(os.Stderr, "error: bad --format")
    37			return 2
    38		}
    39	
    40		spec, err := loadSpec(*specPath)
    41		if err != nil {
    42			printValidationError(err)
    43			return 2
    44		}
    45	
    46		selected, err := parseOnlyFilter(spec, *only)
