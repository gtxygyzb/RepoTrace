   210	func listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {
   211		levels := computeLevels(spec)
   212		level := make(map[string]int, len(spec.Jobs))
   213		for i, names := range levels {
   214			for _, name := range names {
   215				level[name] = i
   216			}
   217		}
   218	
   219		order := make([]*Job, 0, len(spec.Jobs))
   220		for _, names := range levels {
   221			for _, name := range names {
   222				if selected != nil && !selected[name] {
   223					continue
   224				}
   225				order = append(order, spec.ByName[name])
   226			}
   227		}
   228		return order, level
   229	}
   230	
   231	func renderListText(jobs []*Job, level map[string]int) []byte {
   232		var b strings.Builder
   233		for _, job := range jobs {
   234			b.WriteString(job.Name)
   235			b.WriteString("\tlevel=")
   236			b.WriteString(strconv.Itoa(level[job.Name]))
   237			b.WriteString("\tworkdir=")
   238			b.WriteString(job.Workdir)
   239			b.WriteString("\tdeps=")
   240			b.WriteString(strings.Join(job.Deps, ","))
   241			b.WriteString("\tenv=")
   242			b.WriteString(renderEnvText(job.Env))
   243			b.WriteString("\n")
   244		}
   245		return []byte(b.String())
   246	}
   247	
   248	func renderEnvText(env map[string]string) string {
   249		if len(env) == 0 {
   250			return ""
   251		}
   252		keys := make([]string, 0, len(env))
   253		for k := range env {
   254			keys = append(keys, k)
   255		}
   256		sort.Strings(keys)
   257		parts := make([]string, len(keys))
   258		for i, k := range keys {
   259			parts[i] = k + "=" + env[k]
   260		}
   261		return strings.Join(parts, ",")
   262	}
