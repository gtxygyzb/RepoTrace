    45			fmt.Fprintln(os.Stderr, "usage: jobforge plan --spec <path> [--format json|text]")
    46			return 2
    47		}
    48		if *format != "text" && *format != "json" {
    49			fmt.Fprintf(os.Stderr, "error: invalid format: %s\n", *format)
    50			return 2
    51		}
    52	
    53		spec, err := loadSpec(*specPath)
    54		if err != nil {
    55			printValidationError(err)
    56			return 2
    57		}
    58	
    59		levels := computeLevels(spec)
    60		switch *format {
    61		case "text":
    62			for i, names := range levels {
    63				fmt.Printf("level %d: %s\n", i, strings.Join(names, ", "))
    64			}
    65		case "json":
    66			out, err := json.Marshal(map[string][][]string{"levels": levels})
    67			if err != nil {
    68				fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
    69				return 2
    70			}
    71			os.Stdout.Write(out)
    72			fmt.Println()
    73		}
    74		return 0
    75	}
