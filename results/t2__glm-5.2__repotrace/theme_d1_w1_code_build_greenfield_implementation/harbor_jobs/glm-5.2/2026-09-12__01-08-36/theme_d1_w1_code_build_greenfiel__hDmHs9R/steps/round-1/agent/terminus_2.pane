   130	
   131	func runList(args []string) int {
   132		fs := flag.NewFlagSet("list", flag.ContinueOnError)
   133		fs.SetOutput(io.Discard)
   134		specPath := fs.String("spec", "", "path to spec file")
   135		format := fs.String("format", "text", "output format: json|text")
   136		only := fs.String("only", "", "comma-separated list of job names")
   137		if err := fs.Parse(args); err != nil {
   138			fmt.Fprintf(os.Stderr, "error: %s\n", err)
   139			return 2
   140		}
   141		if *specPath == "" {
   142			fmt.Fprintln(os.Stderr, "error: missing --spec")
   143			return 2
   144		}
   145		if len(fs.Args()) > 0 {
   146			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
   147			return 2
   148		}
   149		if *format != "text" && *format != "json" {
   150			fmt.Fprintln(os.Stderr, "error: bad --format")
   151			return 2
   152		}
   153	
   154		spec, err := loadSpec(*specPath)
   155		if err != nil {
   156			printValidationError(err)
   157			return 2
   158		}
   159	
   160		selected, err := parseOnlyFilter(spec, *only)
   161		if err != nil {
   162			printValidationError(err)
   163			return 2
   164		}
   165	
   166		jobs, levels := listJobs(spec, selected)
   167		switch *format {
   168		case "text":
   169			os.Stdout.Write(renderListText(jobs, levels))
   170		case "json":
   171			os.Stdout.Write(renderListJSON(*specPath, jobs, levels))
   172		}
   173		return 0
   174	}
   175	
   176	func parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {
   177		if only == "" {
   178			return nil, nil
   179		}
   180	
   181		selected := map[string]bool{}
   182		seen := map[string]bool{}
   183		for _, name := range strings.Split(only, ",") {
   184			if seen[name] {
   185				continue
   186			}
   187			seen[name] = true
   188	
   189			job, ok := spec.ByName[name]
   190			if !ok {
   191				return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in --only: " + name}
   192			}
   193			addTransitiveDeps(spec, job, selected)
   194		}
   195		return selected, nil
   196	}
   197	
   198	func addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {
   199		if selected[job.Name] {
   200			return
   201		}
   202		selected[job.Name] = true
   203		for _, dep := range job.Deps {
   204			addTransitiveDeps(spec, spec.ByName[dep], selected)
   205		}
   206	}
