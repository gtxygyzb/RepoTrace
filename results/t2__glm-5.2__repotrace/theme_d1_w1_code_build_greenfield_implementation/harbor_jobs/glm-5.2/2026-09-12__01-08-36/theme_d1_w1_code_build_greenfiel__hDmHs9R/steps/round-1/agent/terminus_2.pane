   172	func parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {
   173		if only == "" {
   174			return nil, nil
   175		}
   176	
   177		selected := map[string]bool{}
   178		seen := map[string]bool{}
   179		for _, name := range strings.Split(only, ",") {
   180			if seen[name] {
   181				continue
   182			}
   183			seen[name] = true
   184	
   185			job, ok := spec.ByName[name]
   186			if !ok {
   187				return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in --only: " + name}
   188			}
   189			addTransitiveDeps(spec, job, selected)
   190		}
   191		return selected, nil
   192	}
