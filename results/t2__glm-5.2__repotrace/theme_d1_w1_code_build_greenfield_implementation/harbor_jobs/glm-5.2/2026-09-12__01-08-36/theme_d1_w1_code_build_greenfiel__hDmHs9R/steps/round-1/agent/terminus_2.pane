import (
	"encoding/json"
	"fmt"
	"os"
	"regexp"
	"sort"
)

type Job struct {
	Index   int
	Name    string
	Command string
	Deps    []string
	Workdir string
	Env     map[string]string
}

type Spec struct {
	Jobs   []*Job
	ByName map[string]*Job
}

type ValidationError struct {
	Code    string
	Message string
}

func (e *ValidationError) Error() string {
	return e.Code + ": " + e.Message
}

