===== cmd/jobforge/critical.go
package main

import (
	"encoding/json"
	"flag"
	"fmt"
	"io"
	"os"
	"strings"
)

func runCritical(args []string) int {
	fs := flag.NewFlagSet("critical", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	specPath := fs.String("spec", "", "path to spec file")
	format := fs.String("format", "text", "output format: json|text")
	if err := fs.Parse(args); err != nil {
		fmt.Fprintf(os.Stderr, "error: %s\n", err)
		return 2
	}
	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "error: missing --spec")
		return 2
	}
	if len(fs.Args()) > 0 {
		fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
		return 2
	}
	if *format != "text" && *format != "json" {
		fmt.Fprintln(os.Stderr, "error: bad --format")
		return 2
	}

	spec, err := loadSpec(*specPath)
	if err != nil {
		printValidationError(err)
		return 2
	}

	length, path := criticalPath(spec)
	switch *format {
	case "text":
		var b strings.Builder
		fmt.Fprintf(&b, "length=%d\n", length)
		for _, name := range path {
			b.WriteString(name)
			b.WriteByte('\n')
		}
		os.Stdout.WriteString(b.String())
	case "json":
		out, err := json.Marshal(struct {
			Length int      `json:"length"`
			Path   []string `json:"path"`
		}{Length: length, Path: path})
		if err != nil {
			fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
			return 2
		}
		os.Stdout.Write(out)
		fmt.Println()
	}
	return 0
}

func criticalPath(spec *Spec) (int, []string) {
	if len(spec.Jobs) == 0 {
		return 0, []string{}
	}

	lengths := make(map[string]int)
	var compute func(job *Job) int
	compute = func(job *Job) int {
		if l, ok := lengths[job.Name]; ok {
			return l
		}
		maxDepLen := 0
		for _, dep := range job.Deps {
			l := compute(spec.ByName[dep])
			if l > maxDepLen {
				maxDepLen = l
			}
		}
		l := maxDepLen + 1
		lengths[job.Name] = l
		return l
	}

	for _, job := range spec.Jobs {
		compute(job)
	}

	maxLength := 0
	var sink string
	for _, job := range spec.Jobs {
		l := lengths[job.Name]
		if l > maxLength || (l == maxLength && job.Name < sink) {
			maxLength = l
			sink = job.Name
		}
	}

	path := []string{sink}
	cur := spec.ByName[sink]
	for len(cur.Deps) > 0 {
		bestDep := ""
		bestLen := 0
		for _, dep := range cur.Deps {
			l := lengths[dep]
			if l > bestLen || (l == bestLen && dep < bestDep) {
				bestLen = l
				bestDep = dep
			}
		}
		path = append(path, bestDep)
		cur = spec.ByName[bestDep]
	}

	for i, j := 0, len(path)-1; i < j; i, j = i+1, j-1 {
		path[i], path[j] = path[j], path[i]
	}
	return maxLength, path
}
