    42	func runPlan(args []string) int {
    43		fs := flag.NewFlagSet("plan", flag.ContinueOnError)
    44		fs.SetOutput(os.Stderr)
    45		specPath := fs.String("spec", "", "path to spec file")
    46		format := fs.String("format", "text", "output format: json|text")
    47		if err := fs.Parse(args); err != nil {
    48			return 2
    49		}
    50		if *specPath == "" {
    51			fmt.Fprintln(os.Stderr, "usage: jobforge plan --spec <path> [--format json|text]")
    52			return 2
    53		}
    54		if *format != "text" && *format != "json" {
    55			fmt.Fprintf(os.Stderr, "error: invalid format: %s\n", *format)
    56			return 2
    57		}
    58	
    59		spec, err := loadSpec(*specPath)
    60		if err != nil {
    61			printValidationError(err)
    62			return 2
    63		}
    64	
    65		levels := computeLevels(spec)
    66		switch *format {
    67		case "text":
    68			for i, names := range levels {
    69				fmt.Printf("level %d: %s\n", i, strings.Join(names, ", "))
    70			}
    71		case "json":
    72			out, err := json.Marshal(map[string][][]string{"levels": levels})
    73			if err != nil {
    74				fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
    75				return 2
    76			}
    77			os.Stdout.Write(out)
    78			fmt.Println()
    79		}
    80		return 0
    81	}
