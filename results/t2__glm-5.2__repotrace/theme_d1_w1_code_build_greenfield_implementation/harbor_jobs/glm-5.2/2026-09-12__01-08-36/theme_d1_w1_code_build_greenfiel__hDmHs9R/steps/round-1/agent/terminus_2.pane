    80	func computeAncestorSet(spec *Spec, target *Job) map[string]bool {
    81	ancestors := map[string]bool{}
    82	var visit func(job *Job)
    83	visit = func(job *Job) {
    84	for _, dep := range job.Deps {
    85	if !ancestors[dep] {
    86	ancestors[dep] = true
    87	visit(spec.ByName[dep])
