   204	func listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {
   205		levels := computeLevels(spec)
   206		level := make(map[string]int, len(spec.Jobs))
   207		for i, names := range levels {
   208			for _, name := range names {
   209				level[name] = i
   210			}
   211		}
   212	
   213		order := make([]*Job, 0, len(spec.Jobs))
   214		for _, names := range levels {
   215			for _, name := range names {
   216				if selected != nil && !selected[name] {
   217					continue
   218				}
   219				order = append(order, spec.ByName[name])
   220			}
   221		}
   222		return order, level
   223	}
   224	
   225	func renderListText(jobs []*Job, level map[string]int) []byte {
   226		var b strings.Builder
   227		for _, job := range jobs {
   228			b.WriteString(job.Name)
   229			b.WriteString("\tlevel=")
   230			b.WriteString(strconv.Itoa(level[job.Name]))
   231			b.WriteString("\tworkdir=")
   232			b.WriteString(job.Workdir)
   233			b.WriteString("\tdeps=")
   234			b.WriteString(strings.Join(job.Deps, ","))
   235			b.WriteString("\tenv=")
   236			b.WriteString(renderEnvText(job.Env))
   237			b.WriteString("\n")
   238		}
   239		return []byte(b.String())
   240	}
   241	
   242	func renderEnvText(env map[string]string) string {
   243		if len(env) == 0 {
   244			return ""
   245		}
   246		keys := make([]string, 0, len(env))
   247		for k := range env {
   248			keys = append(keys, k)
   249		}
   250		sort.Strings(keys)
   251		parts := make([]string, len(keys))
   252		for i, k := range keys {
   253			parts[i] = k + "=" + env[k]
   254		}
   255		return strings.Join(parts, ",")
   256	}
