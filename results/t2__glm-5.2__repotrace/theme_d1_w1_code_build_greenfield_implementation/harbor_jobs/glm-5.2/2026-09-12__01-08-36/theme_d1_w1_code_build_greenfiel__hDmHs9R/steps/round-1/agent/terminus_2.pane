   250	func renderEnvText(env map[string]string) string {
   251		if len(env) == 0 {
   252			return ""
   253		}
   254		keys := make([]string, 0, len(env))
   255		for k := range env {
   256			keys = append(keys, k)
   257		}
   258		sort.Strings(keys)
   259		parts := make([]string, len(keys))
   260		for i, k := range keys {
   261			parts[i] = k + "=" + env[k]
   262		}
   263		return strings.Join(parts, ",")
   264	}
