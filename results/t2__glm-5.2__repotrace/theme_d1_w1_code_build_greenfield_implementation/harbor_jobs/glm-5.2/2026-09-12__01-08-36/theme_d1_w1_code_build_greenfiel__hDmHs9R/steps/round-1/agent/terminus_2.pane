    66		if err != nil {
    67			printValidationError(err)
    68			return 2
    69		}
    70	
    71		levels := computeLevels(spec)
    72		switch *format {
    73		case "text":
    74			for i, names := range levels {
    75				fmt.Printf("L%d [%s]\n", i, strings.Join(names, ", "))
    76			}
