     7	
     8	func detectCycle(spec *Spec) *ValidationError {
     9		adj := map[string][]string{}
    10		for _, job := range spec.Jobs {
    11			deps := append([]string(nil), job.Deps...)
    12			sort.Strings(deps)
    13			adj[job.Name] = deps
    14		}
    15	
    16		index := 0
    17		stack := []string{}
    18		onStack := map[string]bool{}
    19		indices := map[string]int{}
    20		low := map[string]int{}
    21		var sccs [][]string
    22	
    23		var strongconnect func(v string)
    24		strongconnect = func(v string) {
    25			indices[v] = index
    26			low[v] = index
    27			index++
    28			stack = append(stack, v)
    29			onStack[v] = true
    30	
    31			for _, w := range adj[v] {
    32				if _, ok := indices[w]; !ok {
    33					strongconnect(w)
    34					if low[w] < low[v] {
    35						low[v] = low[w]
    36					}
    37				} else if onStack[w] {
    38					if indices[w] < low[v] {
    39						low[v] = indices[w]
    40					}
    41				}
    42			}
    43	
    44			if low[v] == indices[v] {
    45				var scc []string
    46				for {
    47					w := stack[len(stack)-1]
    48					stack = stack[:len(stack)-1]
    49					onStack[w] = false
    50					scc = append(scc, w)
    51					if w == v {
    52						break
    53					}
    54				}
    55				sccs = append(sccs, scc)
    56			}
    57		}
    58	
    59		names := make([]string, 0, len(spec.Jobs))
    60		for _, job := range spec.Jobs {
    61			names = append(names, job.Name)
    62		}
    63		sort.Strings(names)
    64		for _, name := range names {
    65			if _, ok := indices[name]; !ok {
    66				strongconnect(name)
    67			}
    68		}
    69	
    70		cyclicSCC := map[string]bool{}
    71		var start string
    72		for _, scc := range sccs {
    73			if len(scc) > 1 {
    74				sorted := append([]string(nil), scc...)
    75				sort.Strings(sorted)
    76				for _, n := range sorted {
    77					cyclicSCC[n] = true
    78				}
    79				if start == "" || sorted[0] < start {
    80					start = sorted[0]
    81				}
    82			}
    83		}
    84	
    85		if start == "" {
    86			return nil
    87		}
    88	
    89		inStartSCC := map[string]bool{}
    90		for _, scc := range sccs {
    91			if len(scc) > 1 {
    92				for _, n := range scc {
    93					if n == start {
    94						for _, n2 := range scc {
    95							inStartSCC[n2] = true
    96						}
    97						break
    98					}
    99				}
   100			}
   101		}
   102	
   103		path := findCyclePath(start, adj, inStartSCC)
   104		return &ValidationError{Code: "cycle", Message: path}
   105	}
   106	
   107	func findCyclePath(start string, adj map[string][]string, inSCC map[string]bool) string {
   108		path := []string{start}
   109		visited := map[string]bool{}
   110	
   111		var dfs func() bool
   112		dfs = func() bool {
   113			cur := path[len(path)-1]
   114			for _, next := range adj[cur] {
   115				if !inSCC[next] {
   116					continue
   117				}
   118				if next == start {
   119					path = append(path, start)
   120					return true
   121				}
   122				if visited[next] {
   123					continue
   124				}
   125				visited[next] = true
   126				path = append(path, next)
   127				if dfs() {
   128					return true
   129				}
   130				path = path[:len(path)-1]
   131				delete(visited, next)
   132			}
   133			return false
   134		}
   135	
   136		if dfs() {
   137			return strings.Join(path, " -> ")
   138		}
   139		return start
   140	}
