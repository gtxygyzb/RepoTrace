    52		jobs, levels := listJobs(spec, selected)
    53		os.Stdout.Write(renderGraph(jobs, levels, *format))
    54		return 0
    55	}
    56	
    57	func renderGraph(jobs []*Job, level map[string]int, format string) []byte {
    58		inSet := make(map[string]bool, len(jobs))
    59		for _, job := range jobs {
    60			inSet[job.Name] = true
    61		}
    62	
    63		var edges []graphEdge
    64		for _, job := range jobs {
    65			for _, dep := range job.Deps {
    66				if inSet[dep] {
    67					edges = append(edges, graphEdge{dep: dep, name: job.Name})
    68				}
    69			}
    70		}
    71	
    72		switch format {
    73		case "dot":
    74			return renderDot(jobs, level, edges)
    75		case "mermaid":
    76			return renderMermaid(jobs, edges)
    77		}
    78		return nil
    79	}
    80	
    81	func renderDot(jobs []*Job, level map[string]int, edges []graphEdge) []byte {
    82		var b strings.Builder
    83		b.WriteString("digraph jobforge {\n")
    84		b.WriteString("\trankdir=LR;\n")
    85		for _, job := range jobs {
    86			b.WriteString("\t\"")
    87			b.WriteString(dotQuote(job.Name))
    88			b.WriteString("\" [level=\"")
    89			b.WriteString(strconv.Itoa(level[job.Name]))
    90			b.WriteString("\" workdir=\"")
    91			b.WriteString(dotQuote(job.Workdir))
    92			b.WriteString("\"];\n")
    93		}
    94		for _, e := range edges {
    95			b.WriteString("\t\"")
    96			b.WriteString(dotQuote(e.dep))
    97			b.WriteString("\" -> \"")
    98			b.WriteString(dotQuote(e.name))
    99			b.WriteString("\";\n")
   100		}
   101		b.WriteString("}\n")
   102		return []byte(b.String())
   103	}
   104	
   105	func renderMermaid(jobs []*Job, edges []graphEdge) []byte {
   106		var b strings.Builder
   107		b.WriteString("graph LR\n")
   108		b.WriteString("\t%% nodes=")
   109		b.WriteString(strconv.Itoa(len(jobs)))
   110		b.WriteString(" edges=")
   111		b.WriteString(strconv.Itoa(len(edges)))
   112		b.WriteString("\n")
   113		for _, job := range jobs {
   114			b.WriteString("\t")
   115			b.WriteString(mermaidID(job.Name))
   116			b.WriteString("[\"")
   117			b.WriteString(mermaidLabel(job.Name))
   118			b.WriteString("\"]\n")
   119		}
   120		for _, e := range edges {
   121			b.WriteString("\t")
   122			b.WriteString(mermaidID(e.dep))
   123			b.WriteString(" --> ")
   124			b.WriteString(mermaidID(e.name))
   125			b.WriteString("\n")
   126		}
   127		return []byte(b.String())
   128	}
   129	
   130	func dotQuote(s string) string {
   131		var b strings.Builder
   132		for i := 0; i < len(s); i++ {
   133			c := s[i]
   134			switch c {
   135			case '"':
   136				b.WriteString(`\"`)
   137			case '\\':
   138				b.WriteString(`\\`)
   139			default:
   140				b.WriteByte(c)
   141			}
   142		}
   143		return b.String()
   144	}
   145	
   146	func mermaidID(name string) string {
   147		var b strings.Builder
   148		for i := 0; i < len(name); i++ {
   149			c := name[i]
   150			if (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' {
   151				b.WriteByte(c)
   152			} else {
   153				b.WriteByte('_')
   154			}
   155		}
   156		return b.String()
   157	}
   158	
   159	func mermaidLabel(name string) string {
   160		var b strings.Builder
   161		for i := 0; i < len(name); i++ {
   162			c := name[i]
   163			if c == '"' {
   164				b.WriteString("#quot;")
   165			} else {
   166				b.WriteByte(c)
   167			}
   168		}
   169		return b.String()
   170	}
