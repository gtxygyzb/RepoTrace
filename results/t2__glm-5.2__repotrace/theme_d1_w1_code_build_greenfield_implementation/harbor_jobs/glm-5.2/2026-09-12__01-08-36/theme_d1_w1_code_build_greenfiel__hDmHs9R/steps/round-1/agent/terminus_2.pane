    34		}
    35		if *format != "dot" && *format != "mermaid" {
    36			fmt.Fprintln(os.Stderr, "error: bad --format")
    37			return 2
    38		}
    39	
    40		spec, err := loadSpec(*specPath)
    41		if err != nil {
    42			printValidationError(err)
    43			return 2
    44		}
    45	
    46		selected, err := parseOnlyFilter(spec, *only)
    47		if err != nil {
