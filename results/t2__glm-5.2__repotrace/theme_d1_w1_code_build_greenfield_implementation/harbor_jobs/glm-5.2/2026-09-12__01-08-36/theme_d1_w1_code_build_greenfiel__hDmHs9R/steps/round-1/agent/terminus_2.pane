    36			os.Exit(2)
    37		}
    38	}
    39	
    40	func runPlan(args []string) int {
    41		fs := flag.NewFlagSet("plan", flag.ContinueOnError)
    42		fs.SetOutput(os.Stderr)
    43		specPath := fs.String("spec", "", "path to spec file")
    44		format := fs.String("format", "text", "output format: json|text")
    45		if err := fs.Parse(args); err != nil {
    46			return 2
    47		}
    48		if *specPath == "" {
    49			fmt.Fprintln(os.Stderr, "usage: jobforge plan --spec <path> [--format json|text]")
    50			return 2
    51		}
    52		if *format != "text" && *format != "json" {
    53			fmt.Fprintf(os.Stderr, "error: invalid format: %s\n", *format)
    54			return 2
    55		}
    56	
    57		spec, err := loadSpec(*specPath)
    58		if err != nil {
    59			printValidationError(err)
    60			return 2
    61		}
    62	
    63		levels := computeLevels(spec)
    64		switch *format {
    65		case "text":
    66			for i, names := range levels {
    67				fmt.Printf("level %d: %s\n", i, strings.Join(names, ", "))
    68			}
    69		case "json":
    70			out, err := json.Marshal(map[string][][]string{"levels": levels})
    71			if err != nil {
    72				fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
    73				return 2
    74			}
    75			os.Stdout.Write(out)
    76			fmt.Println()
    77		}
    78		return 0
    79	}
    80	
    81	func runRun(args []string) int {
    82		fs := flag.NewFlagSet("run", flag.ContinueOnError)
    83		fs.SetOutput(os.Stderr)
    84		specPath := fs.String("spec", "", "path to spec file")
    85		onFailure := fs.String("on-failure", "stop", "on failure behavior: stop|continue")
    86		resultsPath := fs.String("results", "", "path to results JSON file")
    87		if err := fs.Parse(args); err != nil {
    88			return 2
    89		}
    90		if *specPath == "" {
    91			fmt.Fprintln(os.Stderr, "usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]")
    92			return 2
    93		}
    94		if *onFailure != "stop" && *onFailure != "continue" {
    95			fmt.Fprintf(os.Stderr, "error: invalid on-failure: %s\n", *onFailure)
    96			return 2
    97		}
    98	
    99		spec, err := loadSpec(*specPath)
   100		if err != nil {
   101			printValidationError(err)
   102			return 2
   103		}
   104	
   105		return runSpec(spec, *onFailure, *resultsPath)
   106	}
   107	
   108	func runValidate(args []string) int {
   109		fs := flag.NewFlagSet("validate", flag.ContinueOnError)
   110		fs.SetOutput(io.Discard)
   111		specPath := fs.String("spec", "", "path to spec file")
   112		if err := fs.Parse(args); err != nil {
   113			fmt.Fprintf(os.Stderr, "error: %s\n", err)
   114			return 2
   115		}
   116		if *specPath == "" {
   117			fmt.Fprintln(os.Stderr, "error: missing --spec")
   118			return 2
   119		}
   120		if len(fs.Args()) > 0 {
   121			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
   122			return 2
   123		}
   124		if _, err := loadSpec(*specPath); err != nil {
   125			printValidationError(err)
   126			return 2
   127		}
   128		return 0
   129	}
   130	
   131	func runList(args []string) int {
   132		fs := flag.NewFlagSet("list", flag.ContinueOnError)
   133		fs.SetOutput(io.Discard)
   134		specPath := fs.String("spec", "", "path to spec file")
   135		format := fs.String("format", "text", "output format: json|text")
   136		only := fs.String("only", "", "comma-separated list of job names")
   137		if err := fs.Parse(args); err != nil {
   138			fmt.Fprintf(os.Stderr, "error: %s\n", err)
   139			return 2
   140		}
   141		if *specPath == "" {
   142			fmt.Fprintln(os.Stderr, "error: missing --spec")
   143			return 2
   144		}
   145		if len(fs.Args()) > 0 {
   146			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", fs.Args()[0])
   147			return 2
   148		}
   149		if *format != "text" && *format != "json" {
   150			fmt.Fprintln(os.Stderr, "error: bad --format")
   151			return 2
   152		}
   153	
   154		spec, err := loadSpec(*specPath)
   155		if err != nil {
   156			printValidationError(err)
   157			return 2
   158		}
   159	
   160		selected, err := parseOnlyFilter(spec, *only)
   161		if err != nil {
   162			printValidationError(err)
   163			return 2
   164		}
   165	
   166		jobs, levels := listJobs(spec, selected)
   167		switch *format {
   168		case "text":
   169			os.Stdout.Write(renderListText(jobs, levels))
   170		case "json":
   171			os.Stdout.Write(renderListJSON(*specPath, jobs, levels))
   172		}
   173		return 0
   174	}
