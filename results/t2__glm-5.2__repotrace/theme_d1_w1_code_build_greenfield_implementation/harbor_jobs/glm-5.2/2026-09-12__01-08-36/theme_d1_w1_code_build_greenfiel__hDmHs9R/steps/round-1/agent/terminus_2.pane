    22			fmt.Fprintln(os.Stderr, "error: bad --format")
    23			return 2
    24		}
    25		if *specPath == "" {
    26			fmt.Fprintln(os.Stderr, "error: --spec required")
    27			return 2
    28		}
    29		if *jobName == "" {
    30			fmt.Fprintln(os.Stderr, "error: --job required")
    31			return 2
    32		}
    33		if len(fs.Args()) != 0 {
    34			fmt.Fprintln(os.Stderr, "error: unexpected arguments")
    35			return 2
    36		}
    37	
    38		spec, err := loadSpec(*specPath)
    39		if err != nil {
    40			printValidationError(err)
    41			return 2
    42		}
    43	
    44		target, ok := spec.ByName[*jobName]
    45		if !ok {
    46			fmt.Fprintf(os.Stderr, "error: unknown_job: %s\n", *jobName)
    47			return 2
    48		}
    49	
    50		ancestorSet := computeAncestorSet(spec, target)
    51	
    52		levels := computeLevels(spec)
