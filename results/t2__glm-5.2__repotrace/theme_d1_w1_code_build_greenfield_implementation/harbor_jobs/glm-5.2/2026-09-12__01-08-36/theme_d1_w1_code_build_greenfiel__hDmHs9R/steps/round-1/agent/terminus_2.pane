    80		jobs := make([]*Job, len(jobMaps))
    81		for i, m := range jobMaps {
    82			job := &Job{
    83				Index:   i,
    84				Deps:    []string{},
    85				Env:     map[string]string{},
    86				Workdir: "/app",
    87			}
    88	
    89			if raw, ok := m["name"]; ok {
    90				var s string
    91				if err := json.Unmarshal(raw, &s); err != nil {
    92					return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].name must be a string", i)}
    93				}
    94				job.Name = s
    95			}
    96			if raw, ok := m["command"]; ok {
    97				var s string
    98				if err := json.Unmarshal(raw, &s); err != nil {
    99					return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].command must be a string", i)}
   100				}
   101				job.Command = s
   102			}
   103			if raw, ok := m["deps"]; ok {
   104				var arr []string
   105				if err := json.Unmarshal(raw, &arr); err != nil || arr == nil {
   106					return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].deps must be an array of strings", i)}
   107				}
   108				job.Deps = arr
   109			}
   110			if raw, ok := m["workdir"]; ok {
   111				var s string
   112				if err := json.Unmarshal(raw, &s); err != nil {
   113					return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].workdir must be a string", i)}
   114				}
   115				job.Workdir = s
   116			}
   117			if raw, ok := m["env"]; ok {
   118				env := map[string]string{}
   119				if err := json.Unmarshal(raw, &env); err != nil || env == nil {
   120					return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].env must be an object of strings", i)}
   121				}
   122				job.Env = env
   123			}
   124			jobs[i] = job
   125		}
   126	
   127		for i, m := range jobMaps {
   128			var unknown []string
   129			for k := range m {
   130				if !isKnownJobField(k) {
   131					unknown = append(unknown, k)
   132				}
   133			}
   134			if len(unknown) > 0 {
   135				sort.Strings(unknown)
   136				return nil, &ValidationError{Code: "unknown_field", Message: fmt.Sprintf("unknown field: jobs[%d].%s", i, unknown[0])}
   137			}
   138		}
   139	
   140		for _, job := range jobs {
   141			if _, ok := jobMaps[job.Index]["name"]; !ok {
   142				return nil, &ValidationError{Code: "invalid_name", Message: "invalid name: <missing>"}
   143			}
   144			if !nameRegexp.MatchString(job.Name) {
   145				return nil, &ValidationError{Code: "invalid_name", Message: "invalid name: " + job.Name}
   146			}
   147		}
   148	
   149		seen := map[string]bool{}
   150		for _, job := range jobs {
   151			if seen[job.Name] {
   152				return nil, &ValidationError{Code: "duplicate_name", Message: "duplicate name: " + job.Name}
   153			}
   154			seen[job.Name] = true
   155		}
   156	
   157		for _, job := range jobs {
   158			if _, ok := jobMaps[job.Index]["command"]; !ok {
   159				return nil, &ValidationError{Code: "invalid_command", Message: "invalid command for " + job.Name}
   160			}
   161			if job.Command == "" {
   162				return nil, &ValidationError{Code: "invalid_command", Message: "invalid command for " + job.Name}
   163			}
   164		}
   165	
   166		for _, job := range jobs {
   167			keys := make([]string, 0, len(job.Env))
   168			for k := range job.Env {
   169				keys = append(keys, k)
   170			}
   171			sort.Strings(keys)
   172			for _, k := range keys {
   173				if !envKeyRegexp.MatchString(k) {
   174					return nil, &ValidationError{Code: "invalid_env_key", Message: "invalid env key in " + job.Name + ": " + k}
   175				}
   176			}
   177		}
   178	
   179		spec := &Spec{Jobs: jobs, ByName: map[string]*Job{}}
   180		for _, job := range jobs {
   181			spec.ByName[job.Name] = job
   182		}
   183	
   184		for _, job := range jobs {
   185			for _, dep := range job.Deps {
   186				if _, ok := spec.ByName[dep]; !ok {
   187					return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in " + job.Name + ": " + dep}
   188				}
   189			}
   190		}
   191	
   192		for _, job := range jobs {
   193			seenDeps := map[string]bool{}
   194			for _, dep := range job.Deps {
   195				if seenDeps[dep] {
   196					return nil, &ValidationError{Code: "duplicate_dep", Message: "duplicate dep in " + job.Name + ": " + dep}
   197				}
   198				seenDeps[dep] = true
   199			}
   200		}
   201	
   202		for _, job := range jobs {
   203			for _, dep := range job.Deps {
   204				if dep == job.Name {
   205					return nil, &ValidationError{Code: "self_dep", Message: "self dep: " + job.Name}
   206				}
   207			}
   208		}
   209	
   210		if err := detectCycle(spec); err != nil {
   211			return nil, err
   212		}
   213	
   214		return spec, nil
   215	}
