			if seenDeps[dep] {
				return nil, &ValidationError{Code: "duplicate_dep", Message: "duplicate dep in " + job.Name + ": " + dep}
			}
			seenDeps[dep] = true
		}
	}

	for _, job := range jobs {
		for _, dep := range job.Deps {
			if dep == job.Name {
				return nil, &ValidationError{Code: "self_dep", Message: "self dep: " + job.Name}
			}
		}
	}

	if err := detectCycle(spec); err != nil {
		return nil, err
	}

	return spec, nil
}

func isKnownJobField(k string) bool {
	switch k {
	case "name", "command", "deps", "workdir", "env":
		return true
	}
	return false
}

func computeLevels(spec *Spec) [][]string {
	level := map[string]int{}

	var dfs func(job *Job) int
	dfs = func(job *Job) int {
		if l, ok := level[job.Name]; ok {
			return l
		}
		maxDep := -1
		for _, dep := range job.Deps {
			l := dfs(spec.ByName[dep])
			if l > maxDep {
				maxDep = l
			}
		}
		level[job.Name] = maxDep + 1
		return level[job.Name]
	}

	for _, job := range spec.Jobs {
		dfs(job)
	}

	maxLevel := -1
	for _, l := range level {
		if l > maxLevel {
			maxLevel = l
		}
	}

	levels := make([][]string, maxLevel+1)
	for _, job := range spec.Jobs {
		levels[level[job.Name]] = append(levels[level[job.Name]], job.Name)
	}
	for _, names := range levels {
		sort.Strings(names)
	}
	return levels
}
[?2004hroot@n30009:/app# sed -n '1,220p' cmd/jobforge/ancestors.go
[?2004lpackage main

import (
	"encoding/json"
	"flag"
	"fmt"
	"os"
	"strings"
)

func runAncestors(args []string) int {
	fs := flag.NewFlagSet("ancestors", flag.ContinueOnError)
	fs.SetOutput(os.Stderr)
	specPath := fs.String("spec", "", "path to spec file")
	jobName := fs.String("job", "", "target job")
	format := fs.String("format", "text", "output format: text|json")
	if err := fs.Parse(args); err != nil {
		return 2
	}

	if *format != "text" && *format != "json" {
		fmt.Fprintln(os.Stderr, "error: bad --format")
		return 2
	}
	if *specPath == "" {
		fmt.Fprintln(os.Stderr, "error: --spec required")
		return 2
	}
	if *jobName == "" {
		fmt.Fprintln(os.Stderr, "error: --job required")
		return 2
	}
	if len(fs.Args()) != 0 {
		fmt.Fprintln(os.Stderr, "error: unexpected arguments")
		return 2
	}

	spec, err := loadSpec(*specPath)
	if err != nil {
		printValidationError(err)
		return 2
	}

	target, ok := spec.ByName[*jobName]
	if !ok {
		fmt.Fprintf(os.Stderr, "error: unknown_job: %s\n", *jobName)
		return 2
	}

	ancestorSet := computeAncestorSet(spec, target)

	levels := computeLevels(spec)
	ordered := make([]string, 0, len(ancestorSet))
	for _, names := range levels {
		for _, name := range names {
			if ancestorSet[name] {
				ordered = append(ordered, name)
			}
		}
	}

	switch *format {
	case "text":
		if len(ordered) > 0 {
			os.Stdout.WriteString(strings.Join(ordered, "\n") + "\n")
		}
	case "json":
		out, err := json.Marshal(ordered)
		if err != nil {
			fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
			return 2
		}
		os.Stdout.Write(out)
		fmt.Println()
	}

	return 0
}

func computeAncestorSet(spec *Spec, target *Job) map[string]bool {
	ancestors := map[string]bool{}
	var visit func(job *Job)
	visit = func(job *Job) {
		for _, dep := range job.Deps {
			if !ancestors[dep] {
				ancestors[dep] = true
				visit(spec.ByName[dep])
			}
		}
	}
	visit(target)
	return ancestors
}
