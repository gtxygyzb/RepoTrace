[?2004lpackage main

import (
"encoding/json"
"flag"
"fmt"
"os"
"strings"
)

func main() {
if len(os.Args) < 2 {
fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run> --spec <path> [flags]")
os.Exit(2)
}

switch os.Args[1] {
case "plan":
os.Exit(runPlan(os.Args[2:]))
case "run":
os.Exit(runRun(os.Args[2:]))
default:
fmt.Fprintln(os.Stderr, "usage: jobforge <plan|run> --spec <path> [flags]")
os.Exit(2)
}
}

func runPlan(args []string) int {
fs := flag.NewFlagSet("plan", flag.ContinueOnError)
fs.SetOutput(os.Stderr)
specPath := fs.String("spec", "", "path to spec file")
format := fs.String("format", "text", "output format: json|text")
if err := fs.Parse(args); err != nil {
return 2
}
if *specPath == "" {
fmt.Fprintln(os.Stderr, "usage: jobforge plan --spec <path> [--format json|text]")
return 2
}
if *format != "text" && *format != "json" {
fmt.Fprintf(os.Stderr, "error: invalid format: %s\n", *format)
return 2
}

spec, err := loadSpec(*specPath)
if err != nil {
printValidationError(err)
return 2
}

levels := computeLevels(spec)
switch *format {
case "text":
for i, names := range levels {
fmt.Printf("level %d: %s\n", i, strings.Join(names, ", "))
}
case "json":
out, err := json.Marshal(map[string][][]string{"levels": levels})
if err != nil {
fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
return 2
}
os.Stdout.Write(out)
fmt.Println()
}
return 0
}

func runRun(args []string) int {
fs := flag.NewFlagSet("run", flag.ContinueOnError)
fs.SetOutput(os.Stderr)
specPath := fs.String("spec", "", "path to spec file")
onFailure := fs.String("on-failure", "stop", "on failure behavior: stop|continue")
resultsPath := fs.String("results", "", "path to results JSON file")
if err := fs.Parse(args); err != nil {
return 2
}
if *specPath == "" {
fmt.Fprintln(os.Stderr, "usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]")
return 2
}
if *onFailure != "stop" && *onFailure != "continue" {
fmt.Fprintf(os.Stderr, "error: invalid on-failure: %s\n", *onFailure)
return 2
}

spec, err := loadSpec(*specPath)
if err != nil {
printValidationError(err)
return 2
}

return runSpec(spec, *onFailure, *resultsPath)
}

func printValidationError(err error) {
if ve, ok := err.(*ValidationError); ok {
fmt.Fprintf(os.Stderr, "error: %s: %s\n", ve.Code, ve.Message)
return
}
fmt.Fprintf(os.Stderr, "error: %s\n", err)
}
[?2004hroot@n30009:/app# sed -n '1,320p' cmd/jobforge/spec.go
[?2004lpackage main

import (
"encoding/json"
"fmt"
"os"
"regexp"
"sort"
"strings"
)

type Job struct {
Index   int
Name    string
Command string
Deps    []string
Workdir string
Env     map[string]string
}

type Spec struct {
Jobs   []*Job
ByName map[string]*Job
}

type ValidationError struct {
Code    string
Message string
}

func (e *ValidationError) Error() string {
return e.Code + ": " + e.Message
}

var (
nameRegexp    = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_-]*$`)
envKeyRegexp  = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
)

func loadSpec(path string) (*Spec, error) {
data, err := os.ReadFile(path)
if err != nil {
return nil, &ValidationError{Code: "spec_not_found", Message: fmt.Sprintf("cannot read spec: %s", path)}
}

var top map[string]json.RawMessage
if err := json.Unmarshal(data, &top); err != nil || top == nil {
return nil, &ValidationError{Code: "spec_parse", Message: "top-level JSON must be an object"}
}

rawJobs, ok := top["jobs"]
if !ok {
return nil, &ValidationError{Code: "spec_parse", Message: "missing jobs"}
}

var jobsRaw []json.RawMessage
if err := json.Unmarshal(rawJobs, &jobsRaw); err != nil || jobsRaw == nil {
return nil, &ValidationError{Code: "spec_parse", Message: "jobs must be an array"}
}

var unknownTop []string
for k := range top {
if k != "jobs" {
unknownTop = append(unknownTop, k)
}
}
if len(unknownTop) > 0 {
sort.Strings(unknownTop)
return nil, &ValidationError{Code: "unknown_field", Message: "unknown field: " + unknownTop[0]}
}

jobMaps := make([]map[string]json.RawMessage, len(jobsRaw))
for i, raw := range jobsRaw {
var m map[string]json.RawMessage
if err := json.Unmarshal(raw, &m); err != nil || m == nil {
return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d] must be an object", i)}
}
jobMaps[i] = m
}

jobs := make([]*Job, len(jobMaps))
for i, m := range jobMaps {
job := &Job{
Index:   i,
Deps:    []string{},
Env:     map[string]string{},
Workdir: "/app",
}

if raw, ok := m["name"]; ok {
var s string
if err := json.Unmarshal(raw, &s); err != nil {
return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].name must be a string", i)}
}
job.Name = s
}
if raw, ok := m["command"]; ok {
var s string
if err := json.Unmarshal(raw, &s); err != nil {
return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].command must be a string", i)}
}
job.Command = s
}
if raw, ok := m["deps"]; ok {
var arr []string
if err := json.Unmarshal(raw, &arr); err != nil || arr == nil {
return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].deps must be an array of strings", i)}
}
job.Deps = arr
}
if raw, ok := m["workdir"]; ok {
var s string
if err := json.Unmarshal(raw, &s); err != nil {
return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].workdir must be a string", i)}
}
job.Workdir = s
}
if raw, ok := m["env"]; ok {
env := map[string]string{}
if err := json.Unmarshal(raw, &env); err != nil || env == nil {
return nil, &ValidationError{Code: "spec_parse", Message: fmt.Sprintf("jobs[%d].env must be an object of strings", i)}
}
job.Env = env
}
jobs[i] = job
}

for i, m := range jobMaps {
var unknown []string
for k := range m {
if !isKnownJobField(k) {
unknown = append(unknown, k)
}
}
if len(unknown) > 0 {
sort.Strings(unknown)
return nil, &ValidationError{Code: "unknown_field", Message: fmt.Sprintf("unknown field: jobs[%d].%s", i, unknown[0])}
}
}

for _, job := range jobs {
if _, ok := jobMaps[job.Index]["name"]; !ok {
return nil, &ValidationError{Code: "invalid_name", Message: "invalid name: <missing>"}
}
if !nameRegexp.MatchString(job.Name) {
return nil, &ValidationError{Code: "invalid_name", Message: "invalid name: " + job.Name}
}
}

seen := map[string]bool{}
for _, job := range jobs {
if seen[job.Name] {
return nil, &ValidationError{Code: "duplicate_name", Message: "duplicate name: " + job.Name}
}
seen[job.Name] = true
}

for _, job := range jobs {
if _, ok := jobMaps[job.Index]["command"]; !ok {
return nil, &ValidationError{Code: "invalid_command", Message: "invalid command for " + job.Name}
}
if job.Command == "" {
return nil, &ValidationError{Code: "invalid_command", Message: "invalid command for " + job.Name}
}
}

for _, job := range jobs {
keys := make([]string, 0, len(job.Env))
for k := range job.Env {
keys = append(keys, k)
}
sort.Strings(keys)
for _, k := range keys {
if !envKeyRegexp.MatchString(k) {
return nil, &ValidationError{Code: "invalid_env_key", Message: "invalid env key in " + job.Name + ": " + k}
}
}
}

spec := &Spec{Jobs: jobs, ByName: map[string]*Job{}}
for _, job := range jobs {
spec.ByName[job.Name] = job
}

for _, job := range jobs {
for _, dep := range job.Deps {
if _, ok := spec.ByName[dep]; !ok {
return nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in " + job.Name + ": " + dep}
}
}
}

for _, job := range jobs {
seenDeps := map[string]bool{}
for _, dep := range job.Deps {
if seenDeps[dep] {
return nil, &ValidationError{Code: "duplicate_dep", Message: "duplicate dep in " + job.Name + ": " + dep}
}
seenDeps[dep] = true
}
}

for _, job := range jobs {
for _, dep := range job.Deps {
if dep == job.Name {
return nil, &ValidationError{Code: "self_dep", Message: "self dep: " + job.Name}
}
}
}

if err := detectCycle(spec); err != nil {
return nil, err
}

return spec, nil
}

func isKnownJobField(k string) bool {
switch k {
case "name", "command", "deps", "workdir", "env":
return true
}
return false
}

func computeLevels(spec *Spec) [][]string {
level := map[string]int{}

var dfs func(job *Job) int
dfs = func(job *Job) int {
if l, ok := level[job.Name]; ok {
return l
}
maxDep := -1
for _, dep := range job.Deps {
l := dfs(spec.ByName[dep])
if l > maxDep {
maxDep = l
}
}
level[job.Name] = maxDep + 1
return level[job.Name]
}

for _, job := range spec.Jobs {
dfs(job)
}

maxLevel := -1
for _, l := range level {
if l > maxLevel {
maxLevel = l
}
}

levels := make([][]string, maxLevel+1)
for _, job := range spec.Jobs {
levels[level[job.Name]] = append(levels[level[job.Name]], job.Name)
}
for _, names := range levels {
sort.Strings(names)
}
return levels
}
[?2004hroot@n30009:/app# sed -n '1,260p' cmd/jobforge/run.go
[?2004lpackage main

import (
"bytes"
"fmt"
"os"
"os/exec"
"path/filepath"
"sort"
"strconv"
"strings"
"syscall"
)

type jobResult struct {
Name     string
Status   string
ExitCode int
Stdout   string
Stderr   string
}

func runSpec(spec *Spec, onFailure string, resultsPath string) int {
levels := computeLevels(spec)
order := make([]*Job, 0, len(spec.Jobs))
for _, names := range levels {
for _, name := range names {
order = append(order, spec.ByName[name])
}
}

results := make([]jobResult, len(order))
statuses := map[string]string{}
shortCircuit := false

for i, job := range order {
results[i].Name = job.Name

if shortCircuit {
results[i].Status = "skipped"
results[i].ExitCode = -1
results[i].Stdout = ""
results[i].Stderr = ""
statuses[job.Name] = "skipped"
continue
}

skip := false
for _, dep := range job.Deps {
if statuses[dep] != "ok" {
skip = true
break
}
}
if skip {
results[i].Status = "skipped"
results[i].ExitCode = -1
results[i].Stdout = ""
results[i].Stderr = ""
statuses[job.Name] = "skipped"
continue
}

stdout, stderr, exitCode := runJob(job)
results[i].Stdout = stdout
results[i].Stderr = stderr
results[i].ExitCode = exitCode

if exitCode == 0 {
results[i].Status = "ok"
statuses[job.Name] = "ok"
} else {
results[i].Status = "failed"
statuses[job.Name] = "failed"
if onFailure == "stop" {
shortCircuit = true
}
}
}

if resultsPath != "" {
if err := writeResults(resultsPath, onFailure, results); err != nil {
fmt.Fprintf(os.Stderr, "error: results_write: %s\n", err)
return 2
}
}

for _, r := range results {
if r.Status != "ok" {
return 1
}
}
return 0
}

func runJob(job *Job) (string, string, int) {
cmd := exec.Command("bash", "-c", job.Command)
cmd.Dir = job.Workdir

envMap := map[string]string{}
for _, kv := range os.Environ() {
if idx := strings.IndexByte(kv, '='); idx >= 0 {
envMap[kv[:idx]] = kv[idx+1:]
}
}
for k, v := range job.Env {
envMap[k] = v
}
envMap["JOBFORGE_JOB_NAME"] = job.Name
resolvedWorkdir, err := filepath.Abs(job.Workdir)
if err != nil {
resolvedWorkdir = job.Workdir
}
envMap["JOBFORGE_JOB_WORKDIR"] = resolvedWorkdir

env := make([]string, 0, len(envMap))
for k, v := range envMap {
env = append(env, k+"="+v)
}
sort.Strings(env)
cmd.Env = env

var stdoutBuf, stderrBuf bytes.Buffer
cmd.Stdout = &stdoutBuf
cmd.Stderr = &stderrBuf

err = cmd.Run()
if err != nil && cmd.ProcessState == nil {
return sanitizeOutput(stdoutBuf.Bytes()), sanitizeOutput(stderrBuf.Bytes()), 127
}
exitCode := 0
if cmd.ProcessState != nil {
exitCode = exitCodeFromProcessState(cmd.ProcessState)
}
return sanitizeOutput(stdoutBuf.Bytes()), sanitizeOutput(stderrBuf.Bytes()), exitCode
}

func exitCodeFromProcessState(ps *os.ProcessState) int {
if status, ok := ps.Sys().(syscall.WaitStatus); ok {
if status.Exited() {
return status.ExitStatus()
}
if status.Signaled() {
return 128 + int(status.Signal())
}
}
return ps.ExitCode()
}

func sanitizeOutput(b []byte) string {
return strings.ToValidUTF8(string(b), "\ufffd")
}

func writeResults(path, onFailure string, results []jobResult) error {
var b bytes.Buffer
b.WriteString("{\n")
b.WriteString("  \"on_failure\": \"")
b.WriteString(onFailure)
b.WriteString("\",\n")
b.WriteString("  \"jobs\": [")
if len(results) == 0 {
b.WriteString("]\n")
} else {
b.WriteString("\n")
for i, r := range results {
b.WriteString("    {\n")
b.WriteString("      \"name\": \"")
writeJSONString(&b, r.Name)
b.WriteString("\",\n")
b.WriteString("      \"status\": \"")
b.WriteString(r.Status)
b.WriteString("\",\n")
b.WriteString("      \"exit_code\": ")
b.WriteString(strconv.Itoa(r.ExitCode))
b.WriteString(",\n")
b.WriteString("      \"stdout\": \"")
writeJSONString(&b, r.Stdout)
b.WriteString("\",\n")
b.WriteString("      \"stderr\": \"")
writeJSONString(&b, r.Stderr)
b.WriteString("\"\n")
b.WriteString("    }")
if i < len(results)-1 {
b.WriteString(",")
}
b.WriteString("\n")
}
b.WriteString("  ]\n")
}
b.WriteString("}\n")
return os.WriteFile(path, b.Bytes(), 0644)
}

func writeJSONString(b *bytes.Buffer, s string) {
for i := 0; i < len(s); i++ {
c := s[i]
switch c {
case '"':
b.WriteString(`\"`)
case '\\':
b.WriteString(`\\`)
case '\b':
b.WriteString(`\b`)
case '\t':
b.WriteString(`\t`)
case '\n':
b.WriteString(`\n`)
case '\f':
b.WriteString(`\f`)
case '\r':
b.WriteString(`\r`)
default:
if c < 0x20 {
b.WriteString(fmt.Sprintf(`\u00%02x`, c))
} else {
b.WriteByte(c)
}
}
}
}
[?2004hroot@n30009:/app# sed -n '1,220p' cmd/jobforge/cycle.go
[?2004lpackage main

import (
"sort"
"strings"
)

func detectCycle(spec *Spec) *ValidationError {
adj := map[string][]string{}
for _, job := range spec.Jobs {
deps := append([]string(nil), job.Deps...)
sort.Strings(deps)
adj[job.Name] = deps
}

index := 0
stack := []string{}
onStack := map[string]bool{}
indices := map[string]int{}
low := map[string]int{}
var sccs [][]string

var strongconnect func(v string)
strongconnect = func(v string) {
indices[v] = index
low[v] = index
index++
stack = append(stack, v)
onStack[v] = true

for _, w := range adj[v] {
if _, ok := indices[w]; !ok {
strongconnect(w)
if low[w] < low[v] {
low[v] = low[w]
}
} else if onStack[w] {
if indices[w] < low[v] {
low[v] = indices[w]
}
}
}

if low[v] == indices[v] {
var scc []string
for {
w := stack[len(stack)-1]
stack = stack[:len(stack)-1]
onStack[w] = false
scc = append(scc, w)
if w == v {
break
}
}
sccs = append(sccs, scc)
}
}

names := make([]string, 0, len(spec.Jobs))
for _, job := range spec.Jobs {
names = append(names, job.Name)
}
sort.Strings(names)
for _, name := range names {
if _, ok := indices[name]; !ok {
strongconnect(name)
}
}

cyclicSCC := map[string]bool{}
var start string
for _, scc := range sccs {
if len(scc) > 1 {
sorted := append([]string(nil), scc...)
sort.Strings(sorted)
for _, n := range sorted {
cyclicSCC[n] = true
}
if start == "" || sorted[0] < start {
start = sorted[0]
}
}
}

if start == "" {
return nil
}

inStartSCC := map[string]bool{}
for _, scc := range sccs {
if len(scc) > 1 {
for _, n := range scc {
if n == start {
for _, n2 := range scc {
inStartSCC[n2] = true
}
break
}
}
}
}

path := findCyclePath(start, adj, inStartSCC)
return &ValidationError{Code: "cycle", Message: path}
}

func findCyclePath(start string, adj map[string][]string, inSCC map[string]bool) string {
path := []string{start}
visited := map[string]bool{}

var dfs func() bool
dfs = func() bool {
cur := path[len(path)-1]
for _, next := range adj[cur] {
if !inSCC[next] {
continue
}
if next == start {
path = append(path, start)
return true
}
if visited[next] {
continue
}
visited[next] = true
path = append(path, next)
if dfs() {
return true
}
path = path[:len(path)-1]
delete(visited, next)
}
return false
}

if dfs() {
return strings.Join(path, " -> ")
}
return start
}
