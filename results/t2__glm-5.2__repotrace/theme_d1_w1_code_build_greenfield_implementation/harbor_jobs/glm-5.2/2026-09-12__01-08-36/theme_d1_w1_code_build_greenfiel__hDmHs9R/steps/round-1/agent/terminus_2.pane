    77			if err != nil {
    78				fmt.Fprintf(os.Stderr, "error: marshal: %s\n", err)
    79				return 2
    80			}
    81			os.Stdout.Write(out)
    82			fmt.Println()
    83		}
    84		return 0
    85	}
