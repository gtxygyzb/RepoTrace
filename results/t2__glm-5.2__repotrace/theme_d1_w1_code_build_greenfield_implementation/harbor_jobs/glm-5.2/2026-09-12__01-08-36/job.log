\tonFailure := fs.String("on-failure", "stop", "on failure behavior: stop|continue")\n\tresultsPath := fs.String("results", "", "path to results JSON file")\n\tif err := fs.Parse(args); err != nil {\n\t\treturn 2\n\t}\n\tif *specPath == "" {\n\t\tfmt.Fprintln(os.Stderr, "usage: jobforge run --spec <path> [--on-failure stop|continue] [--results <path>]")\n\t\treturn 2\n\t}\n\tif *onFailure != "stop" && *onFailure != "continue" {\n\t\tfmt.Fprintf(os.Stderr, "error: invalid on-failure: %s\\n", *onFailure)\n\t\treturn 2\n\t}\n\n\tspec, err := loadSpec(*specPath)\n\tif err != nil {\n\t\tprintValidationError(err)\n\t\treturn 2\n\t}\n\n\treturn runSpec(spec, *onFailure, *resultsPath)\n}\n\nfunc runValidate(args []string) int {\n\tfs := flag.NewFlagSet("validate", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tspecPath := fs.String("spec", "", "path to spec file")\n\tif err := fs.Parse(args); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: %s\\n", err)\n\t\treturn 2\n\t}\n\tif *specPath == "" {\n\t\tfmt.Fprintln(os.Stderr, "error: missing --spec")\n\t\treturn 2\n\t}\n\tif len(fs.Args()) > 0 {\n\t\tfmt.Fprintf(os.Stderr, "error: unexpected argument: %s\\n", fs.Args()[0])\n\t\treturn 2\n\t}\n\tif _, err := loadSpec(*specPath); err != nil {\n\t\tprintValidationError(err)\n\t\treturn 2\n\t}\n\treturn 0\n}\n\nfunc runList(args []string) int {\n\tfs := flag.NewFlagSet("list", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tspecPath := fs.String("spec", "", "path to spec file")\n\tformat := fs.String("format", "text", "output format: json|text")\n\tonly := fs.String("only", "", "comma-separated list of job names")\n\tif err := fs.Parse(args); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: %s\\n", err)\n\t\treturn 2\n\t}\n\tif *specPath == "" {\n\t\tfmt.Fprintln(os.Stderr, "error: missing --spec")\n\t\treturn 2\n\t}\n\tif len(fs.Args()) > 0 {\n\t\tfmt.Fprintf(os.Stderr, "error: unexpected argument: %s\\n", fs.Args()[0])\n\t\treturn 2\n\t}\n\tif *format != "text" && *format != "json" {\n\t\tfmt.Fprintln(os.Stderr, "error: bad --format")\n\t\treturn 2\n\t}\n\n\tspec, err := loadSpec(*specPath)\n\tif err != nil {\n\t\tprintValidationError(err)\n\t\treturn 2\n\t}\n\n\tselected, err := parseOnlyFilter(spec, *only)\n\tif err != nil {\n\t\tprintValidationError(err)\n\t\treturn 2\n\t}\n\n\tjobs, levels := listJobs(spec, selected)\n\tswitch *format {\n\tcase "text":\n\t\tos.Stdout.Write(renderListText(jobs, levels))\n\tcase "json":\n\t\tos.Stdout.Write(renderListJSON(*specPath, jobs, levels))\n\t}\n\treturn 0\n}\n\nfunc parseOnlyFilter(spec *Spec, only string) (map[string]bool, error) {\n\tif only == "" {\n\t\treturn nil, nil\n\t}\n\n\tselected := map[string]bool{}\n\tseen := map[string]bool{}\n\tfor _, name := range strings.Split(only, ",") {\n\t\tif seen[name] {\n\t\t\tcontinue\n\t\t}\n\t\tseen[name] = true\n\n\t\tjob, ok := spec.ByName[name]\n\t\tif !ok {\n\t\t\treturn nil, &ValidationError{Code: "unknown_dep", Message: "unknown dep in --only: " + name}\n\t\t}\n\t\taddTransitiveDeps(spec, job, selected)\n\t}\n\treturn selected, nil\n}\n\nfunc addTransitiveDeps(spec *Spec, job *Job, selected map[string]bool) {\n\tif selected[job.Name] {\n\t\treturn\n\t}\n\tselected[job.Name] = true\n\tfor _, dep := range job.Deps {\n\t\taddTransitiveDeps(spec, spec.ByName[dep], selected)\n\t}\n}\n\nfunc listJobs(spec *Spec, selected map[string]bool) ([]*Job, map[string]int) {\n\tlevels := computeLevels(spec)\n\tlevel := make(map[string]int, len(spec.Jobs))\n\tfor i, names := range levels {\n\t\tfor _, name := range names {\n\t\t\tlevel[name] = i\n\t\t}\n\t}\n\n\torder := make([]*Job, 0, len(spec.Jobs))\n\tfor _, names := range levels {\n\t\tfor _, name := range names {\n\t\t\tif selected != nil && !selected[name] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\torder = append(order, spec.ByName[name])\n\t\t}\n\t}\n\treturn order, level\n}\n\nfunc renderListText(jobs []*Job, level map[string]int) []byte {\n\tvar b strings.Builder\n\tfor _, job := range jobs {\n\t\tb.WriteString(job.Name)\n\t\tb.WriteString("\\tlevel=")\n\t\tb.WriteString(strconv.Itoa(level[job.Name]))\n\t\tb.WriteString("\\tworkdir=")\n\t\tb.WriteString(job.Workdir)\n\t\tb.WriteString("\\tdeps=")\n\t\tb.WriteString(strings.Join(job.Deps, ","))\n\t\tb.WriteString("\\tenv=")\n\t\tb.WriteString(renderEnvText(job.Env))\n\t\tb.WriteString("\\n")\n\t}\n\treturn []byte(b.String())\n}\n\nfunc renderEnvText(env map[string]string) string {\n\tif len(env) == 0 {\n\t\treturn ""\n\t}\n\tkeys := make([]string, 0, len(env))\n\tfor k := range env {\n\t\tkeys = append(keys, k)\n\t}\n\tsort.Strings(keys)\n\tparts := make([]string, len(keys))\n\tfor i, k := range keys {\n\t\tparts[i] = k + "=" + env[k]\n\t}\n\treturn strings.Join(parts, ",")\n}\n\nfunc renderListJSON(specPath string, jobs []*Job, level map[string]int) []byte {\n\tvar b bytes.Buffer\n\tb.WriteString(`{"spec_path":"`)\n\twriteJSONString(&b, specPath)\n\tb.WriteString(`","count":`)\n\tb.WriteString(strconv.Itoa(len(jobs)))\n\tb.WriteString(`,"jobs":[`)\n\tfor i, job := range jobs {\n\t\tif i > 0 {\n\t\t\tb.WriteByte(\',\')\n\t\t}\n\t\tb.WriteString(`{"name":"`)\n\t\twriteJSONString(&b, job.Name)\n\t\tb.WriteString(`","level":`)\n\t\tb.WriteString(strconv.Itoa(level[job.Name]))\n\t\tb.WriteString(`,"workdir":"`)\n\t\twriteJSONString(&b, job.Workdir)\n\t\tb.WriteString(`","deps":`)\n\t\twriteDepsJSON(&b, job.Deps)\n\t\tb.WriteString(`,"env":`)\n\t\twriteEnvJSON(&b, job.Env)\n\t\tb.WriteString(`,"command":"`)\n\t\twriteJSONString(&b, job.Command)\n\t\tb.WriteString(`"}`)\n\t}\n\tb.WriteString(`]}`)\n\tb.WriteByte(\'\\n\')\n\treturn b.Bytes()\n}\n\nfunc writeDepsJSON(b *bytes.Buffer, deps []string) {\n\tb.WriteByte(\'[\')\n\tfor i, dep := range deps {\n\t\tif i > 0 {\n\t\t\tb.WriteByte(\',\')\n\t\t}\n\t\tb.WriteByte(\'"\')\n\t\twriteJSONString(b, dep)\n\t\tb.WriteByte(\'"\')\n\t}\n\tb.WriteByte(\']\')\n}\n\nfunc writeEnvJSON(b *bytes.Buffer, env map[string]string) {\n\tb.WriteByte(\'{\')\n\tif len(env) > 0 {\n\t\tkeys := make([]string, 0, len(env))\n\t\tfor k := range env {\n\t\t\tkeys = append(keys, k)\n\t\t}\n\t\tsort.Strings(keys)\n\t\tfor i, k := range keys {\n\t\t\tif i > 0 {\n\t\t\t\tb.WriteByte(\',\')\n\t\t\t}\n\t\t\tb.WriteByte(\'"\')\n\t\t\twriteJSONString(b, k)\n\t\t\tb.WriteString(`":"`)\n\t\t\twriteJSONString(b, env[k])\n\t\t\tb.WriteByte(\'"\')\n\t\t}\n\t}\n\tb.WriteByte(\'}\')\n}\n\nfunc printValidationError(err error) {\n\tif ve, ok := err.(*ValidationError); ok {\n\t\tfmt.Fprintf(os.Stderr, "error: %s: %s\\n", ve.Code, ve.Message)\n\t\treturn\n\t}\n\tfmt.Fprintf(os.Stderr, "error: %s\\n", err)\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
