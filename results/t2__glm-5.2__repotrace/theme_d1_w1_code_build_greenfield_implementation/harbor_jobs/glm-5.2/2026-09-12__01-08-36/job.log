 = l\n\t\t\t}\n\t\t}\n\t\tl := maxDepLen + 1\n\t\tlengths[job.Name] = l\n\t\treturn l\n\t}\n\n\tfor _, job := range spec.Jobs {\n\t\tcompute(job)\n\t}\n\n\tmaxLength := 0\n\tvar sink string\n\tfor _, job := range spec.Jobs {\n\t\tl := lengths[job.Name]\n\t\tif l > maxLength || (l == maxLength && job.Name < sink) {\n\t\t\tmaxLength = l\n\t\t\tsink = job.Name\n\t\t}\n\t}\n\n\tpath := []string{sink}\n\tcur := spec.ByName[sink]\n\tfor len(cur.Deps) > 0 {\n\t\tbestDep := ""\n\t\tbestLen := 0\n\t\tfor _, dep := range cur.Deps {\n\t\t\tl := lengths[dep]\n\t\t\tif l > bestLen || (l == bestLen && dep < bestDep) {\n\t\t\t\tbestLen = l\n\t\t\t\tbestDep = dep\n\t\t\t}\n\t\t}\n\t\tpath = append(path, bestDep)\n\t\tcur = spec.ByName[bestDep]\n\t}\n\n\tfor i, j := 0, len(path)-1; i < j; i, j = i+1, j-1 {\n\t\tpath[i], path[j] = path[j], path[i]\n\t}\n\treturn maxLength, path\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
