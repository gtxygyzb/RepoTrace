Sending keys: ['cat > cmd/jobforge/graph.go <<\'EOF\'\npackage main\n\nimport (\n\t"flag"\n\t"fmt"\n\t"io"\n\t"os"\n\t"strconv"\n\t"strings"\n)\n\ntype graphEdge struct {\n\tdep  string\n\tname string\n}\n\nfunc runGraph(args []string) int {\n\tfs := flag.NewFlagSet("graph", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tspecPath := fs.String("spec", "", "path to spec file")\n\tformat := fs.String("format", "dot", "output format: dot|mermaid")\n\tonly := fs.String("only", "", "comma-separated list of job names")\n\tif err := fs.Parse(args); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: %s\\n", err)\n\t\treturn 2\n\t}\n\tif *specPath == "" {\n\t\tfmt.Fprintln(os.Stderr, "error: missing --spec")\n\t\treturn 2\n\t}\n\tif len(fs.Args()) > 0 {\n\t\tfmt.Fprintf(os.Stderr, "error: unexpected argument: %s\\n", fs.Args()[0])\n\t\treturn 2\n\t}\n\tif *format != "dot" && *format != "mermaid" {\n\t\tfmt.Fprintln(os.Stderr, "error: bad --format")\n\t\treturn 2\n\t}\n\n\tspec, err := loadSpec(*specPath)\n\tif err != nil {\n\t\tprintValidationError(err)\n\t\treturn 2\n\t}\n\n\tselected, err := parseOnlyFilter(spec, *only)\n\tif err != nil {\n\t\tprintValidationError(err)\n\t\treturn 2\n\t}\n\n\tjobs, levels := listJobs(spec, selected)\n\tos.Stdout.Write(renderGraph(jobs, levels, *format))\n\treturn 0\n}\n\nfunc renderGraph(jobs []*Job, level map[string]int, format string) []byte {\n\tinSet := make(map[string]bool, len(jobs))\n\tfor _, job := range jobs {\n\t\tinSet[job.Name] = true\n\t}\n\n\tvar edges []graphEdge\n\tfor _, job := range jobs {\n\t\tfor _, dep := range job.Deps {\n\t\t\tif inSet[dep] {\n\t\t\t\tedges = append(edges, graphEdge{dep: dep, name: job.Name})\n\t\t\t}\n\t\t}\n\t}\n\n\tswitch format {\n\tcase "dot":\n\t\treturn renderDot(jobs, level, edges)\n\tcase "mermaid":\n\t\treturn renderMermaid(jobs, edges)\n\t}\n\treturn nil\n}\n\nfunc renderDot(jobs []*Job, level map[string]int, edges []graphEdge) []byte {\n\tvar b strings.Builder\n\tb.WriteString("digraph jobforge {\\n")\n\tb.WriteString("\\trankdir=LR;\\n")\n\tfor _, job := range jobs {\n\t\tb.WriteString("\\t\\"")\n\t\tb.WriteString(dotQuote(job.Name))\n\t\tb.WriteString("\\" [level=\\"")\n\t\tb.WriteString(strconv.Itoa(level[job.Name]))\n\t\tb.WriteString("\\",workdir=\\"")\n\t\tb.WriteString(dotQuote(job.Workdir))\n\t\tb.WriteString("\\"];\\n")\n\t}\n\tfor _, e := range edges {\n\t\tb.WriteString("\\t\\"")\n\t\tb.WriteString(dotQuote(e.dep))\n\t\tb.WriteString("\\" -> \\"")\n\t\tb.WriteString(dotQuote(e.name))\n\t\tb.WriteString("\\";\\n")\n\t}\n\tb.WriteString("}\\n")\n\treturn []byte(b.String())\n}\n\nfunc renderMermaid(jobs []*Job, edges []graphEdge) []byte {\n\tvar b strings.Builder\n\tb.WriteString("graph LR\\n")\n\tb.WriteString("\\t%% nodes=")\n\tb.WriteString(strconv.Itoa(len(jobs)))\n\tb.WriteString(" edges=")\n\tb.WriteString(strconv.Itoa(len(edges)))\n\tb.WriteString("\\n")\n\tfor _, job := range jobs {\n\t\tb.WriteString("\\t")\n\t\tb.WriteString(mermaidID(job.Name))\n\t\tb.WriteString("[\\"")\n\t\tb.WriteString(mermaidLabel(job.Name))\n\t\tb.WriteString("\\"]\\n")\n\t}\n\tfor _, e := range edges {\n\t\tb.WriteString("\\t")\n\t\tb.WriteString(mermaidID(e.dep))\n\t\tb.WriteString(" --> ")\n\t\tb.WriteString(mermaidID(e.name))\n\t\tb.WriteString("\\n")\n\t}\n\treturn []byte(b.String())\n}\n\nfunc dotQuote(s string) string {\n\tvar b strings.Builder\n\tfor i := 0; i < len(s); i++ {\n\t\tc := s[i]\n\t\tswitch c {\n\t\tcase \'"\':\n\t\t\tb.WriteString(`\\"`)\n\t\tcase \'\\\\\':\n\t\t\tb.WriteString(`\\\\`)\n\t\tdefault:\n\t\t\tb.WriteByte(c)\n\t\t}\n\t}\n\treturn b.String()\n}\n\nfunc mermaidID(name string) string {\n\tvar b strings.Builder\n\tfor i := 0; i < len(name); i++ {\n\t\tc := name[i]\n\t\tif (c >= \'A\' && c <= \'Z\') || (c >= \'a\' && c <= \'z\') || (c >= \'0\' && c <= \'9\') || c == \'_\' {\n\t\t\tb.WriteByte(c)\n\t\t} else {\n\t\t\tb.WriteByte(\'_\')\n\t\t}\n\t}\n\treturn b.String()\n}\n\nfunc mermaidLabel(name string) string {\n\tvar b strings.Builder\n\tfor i := 0; i < len(name); i++ {\n\t\tc := name[i]\n\t\tif c == \'"\' {\n\t\t\tb.WriteString("#quot;")\n\t\t} else {\n\t\t\tb.WriteByte(c)\n\t\t}\n\t}\n\treturn b.String()\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
