e([]int, workers)\n\tendTime := make(map[string]int, len(spec.Jobs))\n\n\tassignments := make([]scheduleAssignment, 0, len(spec.Jobs))\n\tmakespan := 0\n\n\tfor _, names := range levels {\n\t\tfor _, name := range names {\n\t\t\tjob := spec.ByName[name]\n\n\t\t\tearliest := 0\n\t\t\tfor _, dep := range job.Deps {\n\t\t\t\tif end := endTime[dep]; end > earliest {\n\t\t\t\t\tearliest = end\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tworker := -1\n\t\t\tfor w := 0; w < workers; w++ {\n\t\t\t\tif busyUntil[w] <= earliest {\n\t\t\t\t\tworker = w\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\tif worker == -1 || busyUntil[w] < busyUntil[worker] {\n\t\t\t\t\tworker = w\n\t\t\t\t}\n\t\t\t}\n\t\t\tif worker == -1 {\n\t\t\t\tworker = 0\n\t\t\t}\n\t\t\tif busyUntil[worker] > earliest {\n\t\t\t\tearliest = busyUntil[worker]\n\t\t\t}\n\n\t\t\tstart := earliest\n\t\t\tend := start + 1\n\t\t\tbusyUntil[worker] = end\n\t\t\tendTime[name] = end\n\n\t\t\tassignments = append(assignments, scheduleAssignment{\n\t\t\t\tName:   name,\n\t\t\t\tWorker: worker,\n\t\t\t\tStart:  start,\n\t\t\t\tEnd:    end,\n\t\t\t})\n\n\t\t\tif end > makespan {\n\t\t\t\tmakespan = end\n\t\t\t}\n\t\t}\n\t}\n\n\treturn assignments, makespan\n}\n\nfunc renderScheduleText(makespan int, assignments []scheduleAssignment) []byte {\n\tvar b bytes.Buffer\n\tb.WriteString("makespan=")\n\tb.WriteString(strconv.Itoa(makespan))\n\tb.WriteByte(\'\\n\')\n\tfor _, a := range assignments {\n\t\tb.WriteString(a.Name)\n\t\tb.WriteString("\\tworker=")\n\t\tb.WriteString(strconv.Itoa(a.Worker))\n\t\tb.WriteString("\\tstart=")\n\t\tb.WriteString(strconv.Itoa(a.Start))\n\t\tb.WriteString("\\tend=")\n\t\tb.WriteString(strconv.Itoa(a.End))\n\t\tb.WriteByte(\'\\n\')\n\t}\n\treturn b.Bytes()\n}\n\nfunc renderScheduleJSON(workers, makespan int, assignments []scheduleAssignment) []byte {\n\tvar b bytes.Buffer\n\tb.WriteString(`{"workers":`)\n\tb.WriteString(strconv.Itoa(workers))\n\tb.WriteString(`,"makespan":`)\n\tb.WriteString(strconv.Itoa(makespan))\n\tb.WriteString(`,"assignments":[`)\n\tfor i, a := range assignments {\n\t\tif i > 0 {\n\t\t\tb.WriteByte(\',\')\n\t\t}\n\t\tb.WriteString(`{"name":"`)\n\t\twriteJSONString(&b, a.Name)\n\t\tb.WriteString(`","worker":`)\n\t\tb.WriteString(strconv.Itoa(a.Worker))\n\t\tb.WriteString(`,"start":`)\n\t\tb.WriteString(strconv.Itoa(a.Start))\n\t\tb.WriteString(`,"end":`)\n\t\tb.WriteString(strconv.Itoa(a.End))\n\t\tb.WriteByte(\'}\')\n\t}\n\tb.WriteString(`]}`)\n\tb.WriteByte(\'\\n\')\n\treturn b.Bytes()\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
