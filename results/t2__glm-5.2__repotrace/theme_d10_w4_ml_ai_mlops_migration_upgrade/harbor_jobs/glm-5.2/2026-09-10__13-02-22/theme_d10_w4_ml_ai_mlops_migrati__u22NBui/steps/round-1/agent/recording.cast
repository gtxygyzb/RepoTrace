[6472.543976, "o", "\u001b[?2004l\r"]
[6472.546898, "o", "package experiment\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n"]
[6472.546989, "o", "\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\n// Experiment groups related runs together.\r\ntype Experiment struct {\r\n\tName      string    `json:\"name\"`\r\n\tRuns      []*Run    `json:\"runs\"`\r\n\tCreatedAt time.Time `json:\"created_at\"`\r\n}\r\n\r\n// Run records a single experiment execution with parameters and metrics.\r\n"]
[6472.547062, "o", "type Run struct {\r\n\tID         string             `json:\"id\"`\r\n\tParameters map[string]float64 `json:\"parameters\"`\r\n\tMetrics    map[string]float64 `json:\"metrics\"`\r\n\tTags       map[string]string  `json:\"tags\"`\r\n\tCreatedAt  time.Time          `json:\"created_at\"`\r\n}\r\n\r\n// Tracker manages experiments and their runs.\r\ntype Tracker struct {\r\n\tmu          sync.RWMutex\r\n\texperiments map[string]*Experiment\r\n\tdataDir     string\r\n\trunCounter  int\r\n}"]
[6472.547129, "o", "\r\n\r\n// NewTracker creates a new experiment tracker backed by the given data directory.\r\nfunc NewTracker(dataDir string) *Tracker {\r\n\tos.MkdirAll(dataDir, 0755)\r\n\tt := &Tracker{\r\n\t\texperiments: make(map[string]*Experiment),\r\n\t\tdataDir:     dataDir,\r\n\t}\r\n\tt.loadAll()\r\n\treturn t\r\n}\r\n"]
[6472.547194, "o", "\r\n// CreateExperiment creates a new experiment with the given name.\r\nfunc (t *Tracker) CreateExperiment(name string) (*Experiment, error) {\r\n\tt.mu.Lock()\r\n\tdefer t.mu.Unlock()\r\n\r\n\tif _, exists := t.experiments[name]; exists {\r\n\t\treturn nil, fmt.Errorf(\"experiment %q already exists\", name)\r\n\t}\r\n\r\n\texp := &Experiment{\r\n\t\tName:      name,\r\n\t\tRuns:      make([]*Run, 0),\r\n\t\tCreatedAt: time.Now(),\r\n"]
[6472.547264, "o", "\t}\r\n\tt.experiments[name] = exp\r\n\tif err := t.saveExperiment(exp); err != nil {\r\n\t\tdelete(t.experiments, name)\r\n\t\treturn nil, err\r\n\t}\r\n\treturn exp, nil\r\n"]
[6472.547828, "o", "\u001b[?2004h"]
[6472.54792, "o", "root@n30009:/app# "]
[6472.840372, "i", "sed -n '520,560p' internal/experiment/experiment.go\n"]
[6472.840798, "o", "sed -n '520,560p' internal/experiment/experiment.go\r\n"]
[6472.84094, "o", "\u001b[?2004l\r"]
[6472.843838, "o", "}\r\n\r\nfunc (t *Tracker) DeleteRun(experimentName, runID string) error {\r\n\tt.mu.Lock()\r\n\tdefer t.mu.Unlock()\r\n\r\n\texp, exists := t.experiments[experimentName]\r\n\tif !exists {\r\n"]
[6472.843963, "o", "\t\treturn fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\t}\r\n\r\n\tfor i, run := range exp.Runs {\r\n\t\tif run.ID == runID {\r\n\t\t\texp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)\r\n\t\t\treturn t.saveExperiment(exp)\r\n\t\t}\r\n\t}\r\n\treturn fmt.Errorf(\"run %q not found in experiment %q\", runID, experimentName)\r\n}\r\n\r\nfunc percentile(sorted []float64, p float64) float64 {\r\n\tn := len(sorted)\r\n\tif n == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tif n == 1 {\r\n\t\treturn sorted[0]\r\n\t}\r\n\trank := p * float64(n-1)\r\n"]
[6472.844039, "o", "\tlower := int(math.Floor(rank))\r\n\tupper := int(math.Ceil(rank))\r\n\tif lower == upper {\r\n\t\treturn sorted[lower]\r\n\t}\r\n\tfrac := rank - float64(lower)\r\n\treturn sorted[lower]*(1-frac) + sorted[upper]*frac\r\n}\r\n\r\nfunc sortedCopy(values []float64) []float64 {\r\n\ts := make([]float64, len(values))\r\n\tcopy(s, values)\r\n"]
[6472.84452, "o", "\u001b[?2004h"]
[6472.844581, "o", "root@n30009:/app# "]
[6473.118022, "i", "sed -n '1,150p' internal/serving/serving.go\n"]
[6473.1184, "o", "sed -n '1,150p' internal/serving/serving.go\r\n\u001b[?2004l\r"]
[6473.121572, "o", "package serving\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"sync\"\r\n\t\"time\"\r\n"]
[6473.121701, "o", "\r\n\t\"gomlops/internal/registry\"\r\n)\r\n\r\n// LoadedModel tracks a model version currently loaded for serving.\r\ntype LoadedModel struct {\r\n\tModelName   string                 `json:\"model_name\"`\r\n\tVersionNum  int                    `json:\"version_num\"`\r\n\tStage       registry.Stage         `json:\"stage\"`\r\n\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n\tLoadedAt    time.Time              `json:\"loaded_at\"`\r\n}\r\n\r\n// InferenceRequest contains the input data for model inference.\r\ntype InferenceRequest struct {\r\n\tModelName string    `json:\"model_name\"`\r\n\tInput     []float64 `json:\"input\"`\r\n}\r\n\r\n// InferenceResponse contains the model prediction results.\r\ntype InferenceResponse struct {\r\n\tModelName   string    `json:\"model_name\"`\r\n\tVersion     int       `json:\"version\"`\r\n"]
[6473.121791, "o", "\tPredictions []float64 `json:\"predictions\"`\r\n\tLatencyMs   float64   `json:\"latency_ms\"`\r\n}\r\n\r\n// ModelStats tracks inference statistics for a single model.\r\ntype ModelStats struct {\r\n\tRequests   int     `json:\"requests\"`\r\n\tSuccessful int     `json:\"successful\"`\r\n\tFailed     int     `json:\"failed\"`\r\n\tLatencySum float64 `json:\"-\"`\r\n}\r\n\r\n// Stats tracks accumulated serving statistics.\r\ntype Stats struct {\r\n\tTotalRequests int\r\n\tSuccessful    int\r\n\t"]
[6473.121886, "o", "Failed        int\r\n\tLatencySum    float64\r\n\tModels        map[string]*ModelStats\r\n}\r\n\r\n// StatsResponse is the public serving statistics representation.\r\ntype StatsResponse struct {\r\n\tTotalRequests int                           `json:\"total_requests\"`\r\n"]
[6473.121959, "o", "\tSuccessful    int                           `json:\"successful\"`\r\n\tFailed        int                           `json:\"failed\"`\r\n\tAvgLatencyMs  float64                       `json:\"avg_latency_ms\"`\r\n\tModels        map[string]ModelStatsResponse `json:\"models\"`\r\n}\r\n\r\n// ModelStatsResponse is the public model statistics representation.\r\ntype ModelStatsResponse struct {\r\n\tRequests     int     `json:\"requests\"`\r\n\tSuccessful   int     `json:\"successful\"`\r\n\tFailed       int     `json:\"failed\"`\r\n\tAvgLatencyMs float64 `json:\"avg_latency_ms\"`\r\n\tSuccessRate  float64 `json:\"success_rate\"`\r\n}\r\n\r\n"]
[6473.122024, "o", "// Server manages model loading and inference.\r\ntype Server struct {\r\n\tmu       sync.RWMutex\r\n\tloaded   map[string]*LoadedModel\r\n\tregistry *registry.Registry\r\n\tstats    Stats\r\n}\r\n\r\n// NewServer creates a new serving server backed by the given registry.\r\nfunc NewServer(reg *registry.Registry) *Server {\r\n\treturn &Server{\r\n\t\tloaded:   make(map[string]*LoadedModel),\r\n\t\t"]
[6473.122085, "o", "registry: reg,\r\n\t\tstats: Stats{\r\n\t\t\tModels: make(map[string]*ModelStats),\r\n\t\t},\r\n\t}\r\n}\r\n\r\n// LoadModel loads a model version for serving. Specify either versionNum > 0\r\n// or a non-empty stage string (not both).\r\nfunc (s *Server) LoadModel(modelName string, versionNum int, stage string) error {\r\n"]
[6473.122144, "o", "\tvar version *registry.Version\r\n\tvar err error\r\n\r\n\tif versionNum > 0 {\r\n\t\tversion, err = s.registry.GetVersion(modelName, versionNum)\r\n\t} else if stage != \"\" {\r\n\t\tversion, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))\r\n\t} else {\r\n\t\treturn fmt.Errorf(\"must specify version number or stage\")\r\n\t}\r\n"]
[6473.122205, "o", "\r\n\tif err != nil {\r\n\t\treturn fmt.Errorf(\"load model: %w\", err)\r\n\t}\r\n\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\t"]
[6473.122263, "o", "s.loaded[modelName] = &LoadedModel{\r\n\t\tModelName:   modelName,\r\n\t\tVersionNum:  version.Number,\r\n\t\tStage:       version.Stage,\r\n\t\tModelConfig: version.ModelConfig,\r\n\t\tLoadedAt:    time.Now(),\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n// UnloadModel removes a model from the serving cache.\r\n"]
[6473.12232, "o", "func (s *Server) UnloadModel(modelName string) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\tif _, exists := s.loaded[modelName]; !exists {\r\n\t\treturn fmt.Errorf(\"model %q is not loaded\", modelName)\r\n\t}\r\n\tdelete(s.loaded, modelName)\r\n\t"]
[6473.122376, "o", "return nil\r\n}\r\n\r\n// Infer runs inference on the loaded model and returns predictions.\r\nfunc (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {\r\n\tstart := time.Now()\r\n\r\n\ts.mu.RLock()\r\n\tloaded, exists := s.loaded[req.ModelName]\r\n"]
[6473.122449, "o", "\ts.mu.RUnlock()\r\n\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", req.ModelName)\r\n\t}\r\n\r\n\tpredictions, err := computePrediction(loaded.ModelConfig, req.Input)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n\t}\r\n\r\n"]
[6473.12251, "o", "\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n\r\n\treturn &InferenceResponse{\r\n"]
[6473.123027, "o", "\u001b[?2004h"]
[6473.123085, "o", "root@n30009:/app# "]
[6473.389372, "i", "sed -n '1,120p' internal/api/router.go\n"]
[6473.389687, "o", "sed -n '1,120p' internal/api/router.go\r\n\u001b[?2004l\r"]
[6473.392704, "o", "package api\r\n\r\nimport (\r\n\t\"net/http\"\r\n\r\n\t\"gomlops/internal/experiment\"\r\n\t\"gomlops/internal/pipeline\"\r\n\t\"gomlops/internal/registry\"\r\n"]
[6473.392786, "o", "\t\"gomlops/internal/serving\"\r\n)\r\n\r\n// Handlers holds references to all service components.\r\ntype Handlers struct {\r\n\tRegistry   *registry.Registry\r\n\tPipeline   *pipeline.Engine\r\n\tExperiment *experiment.Tracker\r\n\tServing    *serving.Server\r\n\tTemplates  *TemplateStore\r\n}\r\n\r\n// NewRouter builds the HTTP route table and returns a handler.\r\nfunc NewRouter(reg *registry.Registry, eng *pipeline.Engine, tracker *experiment.Tracker, srv *serving.Server) http.Handler {\r\n\th := &Handlers{\r\n\t"]
[6473.39291, "o", "\tRegistry:   reg,\r\n\t\tPipeline:   eng,\r\n\t\tExperiment: tracker,\r\n\t\tServing:    srv,\r\n\t\tTemplates:  NewTemplateStore(),\r\n\t}\r\n\r\n\tmux := http.NewServeMux()\r\n\r\n\t// Model registry endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/models\", h.RegisterModel)\r\n\tmux.HandleFunc(\"GET /api/v1/models\", h.ListModels)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}\", h.GetModel)\r\n\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions\", h.CreateVersion)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions\", h.ListModelVersions)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/compare\", h.CompareVersionMetrics)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/diff\", h.VersionDiff)\r\n\t"]
[6473.392978, "o", "mux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}\", h.GetVersion)\r\n\tmux.HandleFunc(\"PUT /api/v1/models/{name}/versions/{num}/promote\", h.PromoteVersion)\r\n\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions/{num}/rollback\", h.RollbackVersion)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}/lineage\", h.ModelLineage)\r\n\tmux.HandleFunc(\"POST /api/v1/models/{name}/dependencies\", h.DeclareDependencies)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}/dependencies\", h.GetDependencies)\r\n\tmux.HandleFunc(\"DELETE /api/v1/models/{name}/dependencies/{dep}\", h.RemoveDependency)\r\n\tmux.HandleFunc(\"DELETE /api/v1/models/{name}\", h.DeleteModel)\r\n\r\n\t// Model version annotations\r\n\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions/{num}/annotations\", h.AddAnnotation)\r\n"]
[6473.393041, "o", "\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}/annotations\", h.ListAnnotations)\r\n\tmux.HandleFunc(\"DELETE /api/v1/models/{name}/versions/{num}/annotations/{key}\", h.DeleteAnnotation)\r\n\r\n\t// Pipeline endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/validate\", h.ValidatePipeline)\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/execute\", h.ExecutePipeline)\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/templates\", h.CreateTemplate)\r\n\tmux.HandleFunc(\"GET /api/v1/pipelines/templates\", h.ListTemplates)\r\n\tmux.HandleFunc(\"GET /api/v1/pipelines/templates/{name}\", h.GetTemplate)\r\n"]
[6473.393105, "o", "\tmux.HandleFunc(\"PUT /api/v1/pipelines/templates/{name}\", h.UpdateTemplate)\r\n\tmux.HandleFunc(\"DELETE /api/v1/pipelines/templates/{name}\", h.DeleteTemplate)\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/templates/{name}/execute\", h.ExecuteTemplate)\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/history/record\", h.RecordPipelineHistory)\r\n\tmux.HandleFunc(\"GET /api/v1/pipelines/history\", h.ListPipelineHistory)\r\n\r\n\t// Experiment endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/experiments\", h.CreateExperiment)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments\", h.ListExperiments)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments/{name}\", h.GetExperiment)\r\n\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/clone\", h.CloneExperiment)\r\n"]
[6473.393168, "o", "\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs\", h.LogRun)\r\n\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs/bulk-tag\", h.BulkTagRuns)\r\n\tmux.HandleFunc(\"DELETE /api/v1/experiments/{name}/runs/{id}\", h.DeleteRun)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments/compare\", h.CompareExperiments)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/aggregate\", h.AggregateMetric)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/correlation\", h.ExperimentCorrelation)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/history\", h.GetMetricHistory)\r\n\tmux.HandleFunc(\"PUT /api/v1/experiments/{name}/runs/{id}\", h.UpdateRun)\r\n\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs/search\", h.SearchRuns)\r\n"]
[6473.393227, "o", "\r\n\t// Serving endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/serving/load\", h.LoadModel)\r\n\tmux.HandleFunc(\"DELETE /api/v1/serving/models/{name}\", h.UnloadModel)\r\n\tmux.HandleFunc(\"GET /api/v1/serving/models\", h.ListLoadedModels)\r\n\tmux.HandleFunc(\"GET /api/v1/serving/models/{name}/health\", h.ServingHealth)\r\n\tmux.HandleFunc(\"POST /api/v1/serving/infer\", h.Infer)\r\n\tmux.HandleFunc(\"POST /api/v1/serving/batch\", h.BatchInfer)\r\n\t"]
[6473.393291, "o", "mux.HandleFunc(\"GET /api/v1/serving/stats\", h.ServingStats)\r\n\tmux.HandleFunc(\"POST /api/v1/serving/stats/reset\", h.ResetServingStats)\r\n\r\n\t// Health check\r\n\tmux.HandleFunc(\"GET /health\", func(w http.ResponseWriter, r *http.Request) {\r\n\t\tw.WriteHeader(http.StatusOK)\r\n\t\tw.Write([]byte(`{\"status\":\"ok\"}`))\r\n\t})\r\n\r\n\treturn mux\r\n}\r\n"]
