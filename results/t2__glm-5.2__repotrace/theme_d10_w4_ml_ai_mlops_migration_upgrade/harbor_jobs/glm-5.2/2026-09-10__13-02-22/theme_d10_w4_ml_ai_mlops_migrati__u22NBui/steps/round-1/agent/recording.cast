[5951.465267, "o", "     1\tpackage pipeline\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"sort\"\r\n     6\t\t\"strings\"\r\n     7\t\t\"time\"\r\n"]
[5951.465376, "o", "     8\t)\r\n     9\t\r\n    10\t// StepType identifies the kind of processing a pipeline step performs.\r\n    11\ttype StepType string\r\n    12\t\r\n    13\tconst (\r\n    14\t\tStepTransform StepType = \"transform\"\r\n    15\t\tStepValidate  StepType = \"validate\"\r\n    16\t\tStepAggregate StepType = \"aggregate\"\r\n    17\t\tStepExport    StepType = \"export\"\r\n    18\t\tStepFilter    StepType = \"filter\"\r\n    19\t\tStepSleep     StepType = \"sleep\"\r\n    20\t)\r\n    21\t\r\n    22\t// Step defines a single unit of work in a pipeline.\r\n    23\ttype Step struct {\r\n    24\t\tName            string                 `json:\"name\"`\r\n    25\t\tType            StepType               `json:\"type\"`\r\n    26"]
[5951.465467, "o", "\t\tConfig          map[string]interface{} `json:\"config\"`\r\n    27\t\tDependencies    []string               `json:\"dependencies\"`\r\n    28\t\tSetVars         map[string]string      `json:\"set_vars,omitempty\"`\r\n    29\t\tOutputTransform string                 `json:\"output_transform,omitempty\"`\r\n    30\t\tRetry           int                    `json:\"retry,omitempty\"`\r\n    31\t\tTimeoutMs       int                    `json:\"timeout_ms,omitempty\"`\r\n    32\t}\r\n    33\t\r\n    34\t// Pipeline defines a named sequence of dependent steps.\r\n    35\ttype Pipeline struct {\r\n    36\t\tName  string  `json:\"name\"`\r\n    37\t\tSteps []*Step `json:\"steps\"`\r\n    38\t}\r\n"]
[5951.465554, "o", "    39\t\r\n    40\t// StepResult records the outcome of executing a single step.\r\n    41\ttype StepResult struct {\r\n    42\t\tStepName   string                 `json:\"step_name\"`\r\n    43\t\tStepType   StepType               `json:\"step_type\"`\r\n    44\t\tStatus     string                 `json:\"status\"`\r\n    45\t\tOutput     map[string]interface{} `json:\"output,omitempty\"`\r\n    46\t\tError      string                 `json:\"error,omitempty\"`\r\n    47\t\tDurationMs float64                `json:\"duration_ms\"`\r\n"]
[5951.465652, "o", "    48\t\tRetries    int                    `json:\"retries\"`\r\n    49\t}\r\n    50\t\r\n    51\t// PipelineResult records the outcome of executing an entire pipeline.\r\n    52\ttype PipelineResult struct {\r\n    53\t\tPipelineName string        `json:\"pipeline_name\"`\r\n    54\t\tStatus       string        `json:\"status\"`\r\n    55\t\tSteps        []*StepResult `json:\"steps\"`\r\n    56\t\tTotalTimeMs  float64       `json:\"total_time_ms\"`\r\n    57\t}\r\n    58\t\r\n    59\t// Engine executes pipelines by resolving step dependencies and running each step.\r\n    60\ttype Engine struct {\r\n    61\t\tstepExecutors map[StepType]StepExecutor\r\n    62\t}\r\n    63\t\r\n    64\t"]
[5951.465736, "o", "// StepExecutor is the function signature for executing a pipeline step.\r\n    65\ttype StepExecutor func(config, input map[string]interface{}) (map[string]interface{}, error)\r\n    66\t\r\n    67\t// NewEngine creates a pipeline engine with built-in step executors.\r\n    68\tfunc NewEngine() *Engine {\r\n    69\t\te := &Engine{\r\n    70\t\t\tstepExecutors: make(map[StepType]StepExecutor),\r\n    71\t\t}\r\n    72\t\te.stepExecutors[StepTransform] = ExecuteTransform\r\n    73\t\te.stepExecutors[StepValidate] = ExecuteValidate\r\n    74\t\te.stepExecutors[StepAggregate] = ExecuteAggregate\r\n    75\t\te.stepExecutors[StepExport] = ExecuteExport\r\n    76\t\t"]
[5951.465822, "o", "e.stepExecutors[StepFilter] = ExecuteFilter\r\n    77\t\te.stepExecutors[StepSleep] = ExecuteSleep\r\n    78\t\treturn e\r\n    79\t}\r\n    80\t\r\n    81\t// ValidationResult describes the structural validation outcome of a pipeline.\r\n    82\ttype ValidationResult struct {\r\n    83\t\tValid          bool            `json:\"valid\"`\r\n    84\t\tExecutionOrder []string        `json:\"execution_order\"`\r\n    85\t\tStepCount      int             `json:\"step_count\"`\r\n    86\t\tSteps          []ValidatedStep `json:\"steps\"`\r\n    87\t\tErrors         []string        `json:\"errors\"`\r\n    88\t}\r\n    89\t\r\n    90\t// ValidatedStep contains structural details for a validated step.\r\n"]
[5951.46651, "o", "\u001b[?2004h"]
