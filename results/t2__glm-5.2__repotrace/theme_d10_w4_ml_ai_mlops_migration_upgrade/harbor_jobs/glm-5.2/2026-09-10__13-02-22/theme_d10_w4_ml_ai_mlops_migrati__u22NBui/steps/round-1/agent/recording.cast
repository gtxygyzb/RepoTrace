[1137.569349, "o", "   128\tfunc (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, int, error) {\r\n   129\t\tt.mu.RLock()\r\n   130\t\tdefer t.mu.RUnlock()\r\n   131\t\r\n"]
[1137.569471, "o", "   132\t\texp, exists := t.experiments[experimentName]\r\n   133\t\tif !exists {\r\n   134\t\t\treturn 0, 0, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   135\t\t}\r\n   136\t\r\n"]
[1137.569546, "o", "   137\t\tif len(exp.Runs) == 0 {\r\n   138\t\t\treturn 0, 0, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n   139\t\t}\r\n   140\t\r\n   141\t\tvar values []float64\r\n   142\t\tvar weights []float64\r\n   143\t\tfor _, run := range exp.Runs {\r\n   144\t\t\tvalue, ok := run.Metrics[metricName]\r\n   145\t\t\tif !ok {\r\n   146\t\t\t\tcontinue\r\n   147\t\t\t}\r\n   148\t\t\tvalues = append(values, value)\r\n   149\t\t\tif aggType == \"weighted_mean\" {\r\n   150\t\t\t\tweight, ok := run.Parameters[weightParam]\r\n   151\t\t\t\tif !ok {\r\n   152\t\t\t\t\tcontinue\r\n   153\t\t\t\t}\r\n   154\t\t\t\tweights = append(weights, weight)\r\n   155\t\t\t}\r\n   156\t\t}\r\n"]
[1137.569628, "o", "   157\t\r\n   158\t\tif len(values) == 0 {\r\n   159\t\t\treturn 0, 0, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n"]
[1137.569701, "o", "   160\t\t}\r\n   161\t\r\n   162\t\tswitch aggType {\r\n   163\t\tcase \"mean\":\r\n   164\t\t\tsum := 0.0\r\n   165\t\t\tfor _, v := range values {\r\n   166\t\t\t\tsum += v\r\n   167\t\t\t}\r\n   168\t\t\treturn sum / float64(len(values)), len(values), nil\r\n   169\t\r\n   170\t\tcase \"median\":\r\n   171\t\t\tsorted := sortedCopy(values)\r\n   172\t\t\tn := len(sorted)\r\n   173\t\t\tif n%2 == 0 {\r\n   174\t\t\t\treturn (sorted[n/2-1] + sorted[n/2]) / 2, len(values), nil\r\n   175\t\t\t}\r\n"]
[1137.569768, "o", "   176\t\t\treturn sorted[n/2], len(values), nil\r\n   177\t\r\n   178\t\tcase \"p95\":\r\n   179\t\t\tsorted := sortedCopy(values)\r\n   180\t\t\treturn percentile(sorted, 0.95), len(values), nil\r\n   181\t\r\n   182\t\tcase \"p99\":\r\n   183\t\t\tsorted := sortedCopy(values)\r\n   184\t\t\treturn percentile(sorted, 0.99), len(values), nil\r\n   185\t\r\n   186\t\tcase \"weighted_mean\":\r\n   187\t\t\tif weightParam == \"\" {\r\n   188\t\t\t\treturn 0, 0, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\n   189\t\t\t}\r\n   190\t\t\tif len(weights) == 0 {\r\n"]
[1137.569827, "o", "   191\t\t\t\treturn 0, 0, fmt.Errorf(\"no runs with metric %q and weight parameter %q\", metricName, weightParam)\r\n   192\t\t\t}\r\n   193\t\t\tif len(weights) != len(values) {\r\n   194\t\t\t\treturn 0, 0, fmt.Errorf(\"mismatch between metric values and weights\")\r\n   195\t\t\t}\r\n   196\t\t\tweightedSum := 0.0\r\n   197\t\t\tweightSum := 0.0\r\n   198\t\t\tfor i, v := range values {\r\n"]
[1137.569923, "o", "   199\t\t\t\tweightedSum += v * weights[i]\r\n   200\t\t\t\tweightSum += weights[i]\r\n   201\t\t\t}\r\n   202\t\t\tif weightSum == 0 {\r\n   203\t\t\t\treturn 0, 0, fmt.Errorf(\"weighted_mean has zero total weight\")\r\n   204\t\t\t}\r\n   205\t\t\treturn weightedSum / weightSum, len(values), nil\r\n   206\t\r\n   207\t\tdefault:\r\n   208\t\t\treturn 0, 0, fmt.Errorf(\"unknown aggregation type %q\", aggType)"]
[1137.569999, "o", "\r\n   209\t\t}\r\n   210\t}\r\n"]
