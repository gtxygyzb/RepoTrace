[2102.878117, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/pipeline/engine.go')\ns = p.read_text()\nold = '''\\t\\t// Find and run the executor\n\\t\\texecutor, ok := e.stepExecutors[step.Type]\n'''\nnew = '''\\t\\t// Check skip condition before executing the step.\n\\t\\tskip, serr := shouldSkipStep(resolvedConfig, variables)\n\\t\\tif serr != nil {\n\\t\\t\\tsr := &StepResult{\n\\t\\t\\t\\tStepName:   step.Name,\n\\t\\t\\t\\tStepType:   step.Type,\n\\t\\t\\t\\tStatus:     \"failed\",\n\\t\\t\\t\\tError:      serr.Error(),\n\\t\\t\\t\\tDurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\n\\t\\t\\t}\n\\t\\t\\tresult.Steps = append(result.Steps, sr)\n\\t\\t\\tresult.Status = \"failed\"\n\\t\\t\\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\n\\t\\t\\treturn result, nil\n\\t\\t}\n\\t\\tif skip {\n\\t\\t\\tduration := float64(time.Since(stepStart).Microseconds()) / 1000.0\n\\t\\t\\toutput := map[string]interface{}{\"status\": \"skipped\", \"data\": []interface{}{}}\n\\t\\t\\tsr := &StepResult{\n\\t\\t\\t\\tStepName:   step.Name,\n\\t\\t\\t\\tStepType:   step.Type"]
[2102.878421, "i", ",\n\\t\\t\\t\\tStatus:     \"skipped\",\n\\t\\t\\t\\tOutput:     output,\n\\t\\t\\t\\tDurationMs: duration,\n\\t\\t\\t}\n\\t\\t\\tresult.Steps = append(result.Steps, sr)\n\\t\\t\\tstepOutputs[step.Name] = output\n\\t\\t\\tcontinue\n\\t\\t}\n\n\\t\\t// Find and run the executor\n\\t\\texecutor, ok := e.stepExecutors[step.Type]\n'''\nif old not in s:\n    raise SystemExit('executor block not found')\ns = s.replace(old, new)\nhelper = '''\n// shouldSkipStep evaluates a step's skip_condition against pipeline variables.\nfunc shouldSkipStep(config map[string]interface{}, variables map[string]float64) (bool, error) {\n\\tcond, ok := config[\"skip_condition\"]\n\\tif !ok {\n\\t\\treturn false, nil\n\\t}\n\\tc, ok := cond.(map[string]interface{})\n\\tif !ok {\n\\t\\treturn false, fmt.Errorf(\"skip_condition must be an object\")\n\\t}\n\\tvarName, ok := c[\"var\"].(string)\n\\tif !ok || varName == \"\" {\n\\t\\treturn false, fmt.Errorf(\"skip_condition requires a var name\")\n\\t}\n\\tval, exists := variables[varName]\n\\tif !exists {\n\\t\\treturn false, nil\n\\t}\n\\top, _ := c[\"op\"].(string)\n\\tthreshold, err :="]
[2102.878482, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2102.878604, "i", " toFloat(c[\"threshold\"])\n\\tif err != nil {\n\\t\\treturn false, fmt.Errorf(\"skip_condition invalid threshold: %w\", err)\n\\t}\n\\tswitch op {\n\\tcase \"gt\":\n\\t\\treturn val > threshold, nil\n\\tcase \"lt\":\n\\t\\treturn val < threshold, nil\n\\tcase \"eq\":\n\\t\\treturn val == threshold, nil\n\\tcase \"gte\":\n\\t\\treturn val >= threshold, nil\n\\tcase \"lte\":\n\\t\\treturn val <= threshold, nil\n\\tcase \"ne\":\n\\t\\treturn val != threshold, nil\n\\tdefault:\n\\t\\treturn false, fmt.Errorf(\"skip_condition unsupported operator %q\", op)\n\\t}\n}\n'''\n# Insert helper after Execute function closing brace (line 188) before topologicalSort.\nmarker = '\\n// topologicalSort orders steps so that dependencies are executed first.\\n'\nif marker not in s:\n    raise SystemExit('topologicalSort marker not found')\ns = s.replace(marker, helper + marker)\np.write_text(s)\nPY\n"]
