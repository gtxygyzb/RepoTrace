[648.951248, "i", "python3 - <<'PY'\nimport json, urllib.request, urllib.error, time, uuid\n\nBASE = \"http://localhost:8080/api/v1\"\n\ndef req(method, path, body=None):\n    url = BASE + path\n    data = None\n    headers = {\"Content-Type\": \"application/json\"}\n    if body is not None:\n        data = json.dumps(body).encode()\n    r = urllib.request.Request(url, data=data, method=method, headers=headers)\n    try:\n        with urllib.request.urlopen(r, timeout=5) as resp:\n            return resp.status, resp.read().decode()\n    except urllib.error.HTTPError as e:\n        return e.code, e.read().decode()\n    except Exception as e:\n        return None, str(e)\n\nsuf = str(int(time.time()*1000))[-6:]\nprint(\"=== Registry ===\")\nm = \"linreg\" + suf\nprint(req(\"POST\", \"/models\", {\"name\": m, \"framework\": \"linear\", \"description\": \"test\", \"tags\": [\"tag1\"]}))\nprint(req(\"POST\", f\"/models/{m}/versions\", {\"metrics\": {\"acc\": 0.8}, \"tags\": [\"v1\"], \"model_config\": {\"model_type\": \"linear\", \"weights\": [2,3], \"bias\": 1}}))\nprint(req(\"POST\", f\"/models/{m}/version"]
[648.951529, "i", "s\", {\"metrics\": {\"acc\": 0.82}, \"tags\": [\"v2\"], \"model_config\": {\"model_type\": \"linear\", \"weights\": [1,1], \"bias\": 0}}))\nst, body = req(\"GET\", f\"/models/{m}\", None)\nprint(st, body)\nprint(\"version numbers:\", [v[\"number\"] for v in json.loads(body)[\"versions\"]])\nprint(req(\"PUT\", f\"/models/{m}/versions/1/promote\", {\"stage\": \"staging\"}))\nprint(req(\"PUT\", f\"/models/{m}/versions/1/promote\", {\"stage\": \"production\"}))\nprint(req(\"PUT\", f\"/models/{m}/versions/2/promote\", {\"stage\": \"staging\"}))\nprint(req(\"PUT\", f\"/models/{m}/versions/2/promote\", {\"stage\": \"production\"}))\nst, body = req(\"GET\", f\"/models/{m}\", None)\nprint(st, [(v[\"number\"], v[\"stage\"]) for v in json.loads(body)[\"versions\"]])\nprint(\"list framework:\", req(\"GET\", \"/models?framework=linear\", None))\nprint(\"list tag:\", req(\"GET\", \"/models?tag=tag1\", None))\n\nprint(\"=== Pipeline dependency merge ===\")\npipeline = {\n  \"name\": \"mergepipe\",\n  \"input\": {\"data\": [1,2,3]},\n  \"steps\": [\n    {\"name\": \"a\", \"type\": \"transform\", \"config\": {\"mode\": \"scale\", \"factor\": 2}, \"depen"]
