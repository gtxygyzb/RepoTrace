[648.995959, "o", "\u001b[?2004h> "]
[648.996331, "o", "print(\"load by stage:\", req(\"POST\", \"/serving/load\", {\"model_name\": poly, \"stage\": \"staging\"}))\r\n\u001b[?2004l\r"]
[648.996388, "o", "\u001b[?2004h> "]
[648.996737, "o", "print(\"poly infer:\", req(\"POST\", \"/serving/infer\", {\"model_name\": poly, \"input\": [1,2]}))\r\n\u001b[?2004l\r"]
[648.996793, "o", "\u001b[?2004h> "]
[648.997107, "o", "print(\"delete model serving unload:\", req(\"DELETE\", f\"/models/{poly}\", None))\r\n\u001b[?2004l\r"]
