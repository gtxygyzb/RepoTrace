[1442.64213, "o", "pipelineStart := time.Now()\r\n\u001b[?2004l\r"]
[1442.642185, "o", "\u001b[?2004h> "]
[1442.642232, "o", "\u0007"]
[1442.642358, "o", "result := &PipelineResult{\r\n\u001b[?2004l\r"]
