[6505.961368, "o", "\r\n   526\t\texp, exists := t.experiments[experimentName]\r\n   527\t\tif !exists {\r\n   528\t\t\treturn fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   529\t\t}\r\n   530"]
[6505.96144, "o", "\t\r\n   531\t\tfor i, run := range exp.Runs {\r\n   532\t\t\tif run.ID == runID {\r\n   533\t\t\t\texp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)\r\n   534\t\t\t\treturn t.saveExperiment(exp)\r\n   535\t\t\t}\r\n   536\t\t}\r\n   537\t\treturn fmt.Errorf(\"run %q not found in experiment %q\", runID, experimentName)\r\n   538\t}\r\n   539\t\r\n   540\tfunc percentile(sorted []float64, p float64) float64 {\r\n   541\t\tn := len(sorted)\r\n   542\t\tif n == 0 {\r\n   543\t\t\treturn 0\r\n   544\t\t}\r\n   545\t\tif n == 1 {\r\n   546\t\t\treturn sorted[0]\r\n   547\t\t}\r\n   548\t\trank := p * float64(n-1)\r\n   549\t\tlower := int(math.Floor(rank))\r\n   550\t\tupper := int(math.Ceil(rank))\r\n   551\t\tif lower == upper {\r\n   552\t\t\treturn sorted[lower]\r\n"]
[6505.961517, "o", "   553\t\t}\r\n   554\t\tfrac := rank - float64(lower)\r\n   555\t\treturn sorted[lower]*(1-frac) + sorted[upper]*frac\r\n   556\t}\r\n   557\t\r\n"]
