[5635.862737, "o", "\tModelName   string                 `json:\"model_name\"`\r\n    14\t\tVersionNum  int                    `json:\"version_num\"`\r\n    15\t\tStage       registry.Stage         `json:\"stage\"`\r\n    16\t\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n    17\t\tLoadedAt    time.Time              `json:\"loaded_at\"`\r\n    18\t}\r\n    19\t\r\n    20\t// InferenceRequest contains the input data for model inference.\r\n    21\ttype InferenceRequest struct {\r\n    22\t\tModelName string    `json:\"model_name\"`\r\n    23\t\tInput     []float64 `json:\"input\"`\r\n    24\t}\r\n    25\t\r\n"]
[5635.862832, "o", "    26\t// InferenceResponse contains the model prediction results.\r\n    27\ttype InferenceResponse struct {\r\n    28\t\tModelName   string    `json:\"model_name\"`\r\n    29\t\tVersion     int       `json:\"version\"`\r\n    30\t\tPredictions []float64 `json:\"predictions\"`\r\n    31\t\tLatencyMs   float64   `json:\"latency_ms\"`\r\n    32\t}\r\n    33"]
[5635.8629, "o", "\t\r\n    34\t// ModelStats tracks inference statistics for a single model.\r\n    35\ttype ModelStats struct {\r\n    36\t\tRequests   int     `json:\"requests\"`\r\n    37\t\tSuccessful int     `json:\"successful\"`\r\n    38\t\tFailed     int     `json:\"failed\"`\r\n    39\t\tLatencySum float64 `json:\"-\"`\r\n    40\t}\r\n    41\t\r\n"]
[5635.862971, "o", "    42\t// Stats tracks accumulated serving statistics.\r\n    43\ttype Stats struct {\r\n    44\t\tTotalRequests int\r\n    45\t\tSuccessful    int\r\n    46\t\tFailed        int\r\n    47\t\tLatencySum    float64\r\n    48\t\tModels        map[string]*ModelStats\r\n    49\t}\r\n    50\t\r\n    51\t// StatsResponse is the public serving statistics representation.\r\n    52\ttype StatsResponse struct {\r\n"]
[5635.863065, "o", "    53\t\tTotalRequests int                           `json:\"total_requests\"`\r\n    54\t\tSuccessful    int                           `json:\"successful\"`\r\n    55\t\tFailed        int                           `json:\"failed\"`\r\n    56\t\tAvgLatencyMs  float64                       `json:\"avg_latency_ms\"`\r\n    57\t\tModels        map[string]ModelStatsResponse `json:\"models\"`\r\n    58\t}\r\n    59\t\r\n    60\t// ModelStatsResponse is the public model statistics representation.\r\n    61\ttype ModelStatsResponse struct {\r\n    62\t\t"]
[5635.863138, "o", "Requests     int     `json:\"requests\"`\r\n    63\t\tSuccessful   int     `json:\"successful\"`\r\n    64\t\tFailed       int     `json:\"failed\"`\r\n    65\t\tAvgLatencyMs float64 `json:\"avg_latency_ms\"`\r\n    66\t\tSuccessRate  float64 `json:\"success_rate\"`\r\n    67\t}\r\n    68\t\r\n    69\t// Server manages model loading and inference.\r\n    70\ttype Server struct {\r\n    71\t\tmu       sync.RWMutex\r\n    72\t\tloaded   map[string]*LoadedModel\r\n    73\t\t"]
[5635.863215, "o", "registry *registry.Registry\r\n    74\t\tstats    Stats\r\n    75\t}\r\n    76\t\r\n    77\t// NewServer creates a new serving server backed by the given registry.\r\n    78\tfunc NewServer(reg *registry.Registry) *Server {\r\n    79\t\treturn &Server{\r\n"]
[5635.863288, "o", "    80\t\t\tloaded:   make(map[string]*LoadedModel),\r\n    81\t\t\tregistry: reg,\r\n    82\t\t\tstats: Stats{\r\n    83\t\t\t\tModels: make(map[string]*ModelStats),\r\n    84\t\t\t},\r\n    85\t\t}\r\n    86\t}\r\n    87\t\r\n    88\t// LoadModel loads a model version for serving. Specify either versionNum > 0\r\n    89\t// or a non-empty stage string (not both).\r\n    90\tfunc (s *Server) LoadModel(modelName string, versionNum int, stage string) error {\r\n    91\t\tvar version *registry.Version\r\n    92\t\tvar err error\r\n    93\t\r\n    94\t\tif versionNum > 0 {\r\n"]
[5635.863364, "o", "    95\t\t\tversion, err = s.registry.GetVersion(modelName, versionNum)\r\n    96\t\t} else if stage != \"\" {\r\n    97\t\t\tversion, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))\r\n    98\t\t} else {\r\n    99\t\t\treturn fmt.Errorf(\"must specify version number or stage\")\r\n   100\t\t}\r\n   101\t\r\n   102\t\tif err != nil {\r\n   103\t\t\treturn fmt.Errorf(\"load model: %w\", err)\r\n"]
[5635.863457, "o", "   104\t\t}\r\n   105\t\r\n   106\t\ts.mu.Lock()\r\n   107\t\tdefer s.mu.Unlock()\r\n   108\t\r\n   109\t\ts.loaded[modelName] = &LoadedModel{\r\n   110\t\t\tModelName:   modelName,\r\n   111\t\t\tVersionNum:  version.Number,\r\n   112\t\t\tStage:       version.Stage,\r\n   113\t\t\tModelConfig: version.ModelConfig,\r\n   114\t\t\tLoadedAt:    time.Now(),\r\n   115\t\t}\r\n   116\t\treturn nil\r\n   117\t}\r\n"]
[5635.863528, "o", "   118\t\r\n   119\t// UnloadModel removes a model from the serving cache.\r\n   120\tfunc (s *Server) UnloadModel(modelName string) error {\r\n   121\t\ts.mu.Lock()\r\n   122\t\tdefer s.mu.Unlock()\r\n   123\t\r\n   124\t\tif _, exists := s.loaded[modelName]; !exists {\r\n   125\t\t\treturn fmt.Errorf(\"model %q is not loaded\", modelName)\r\n   126\t\t}\r\n   127\t\tdelete(s.loaded, modelName)\r\n"]
[5635.863604, "o", "   128\t\treturn nil\r\n   129\t}\r\n   130\t\r\n   131\t// Infer runs inference on the loaded model and returns predictions.\r\n   132\tfunc (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {\r\n   133\t\tstart := time.Now()\r\n   134\t\r\n   135\t\ts.mu.RLock()\r\n   136\t\tloaded, exists := s.loaded[req.ModelName]\r\n   137\t\ts.mu.RUnlock()\r\n"]
[5635.863677, "o", "   138\t\r\n   139\t\tif !exists {\r\n   140\t\t\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", req.ModelName)\r\n   141\t\t}\r\n   142\t\r\n   143\t\tpredictions, err := computePrediction(loaded.ModelConfig, req.Input)\r\n"]
[5635.863749, "o", "   144\t\tif err != nil {\r\n   145\t\t\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n   146\t\t}\r\n   147\t\r\n   148\t\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n   149\t\r\n   150\t\treturn &InferenceResponse{\r\n   151\t\t\tModelName:   req.ModelName,\r\n   152\t\t\tVersion:     loaded.VersionNum,\r\n   153\t\t\tPredictions: predictions,\r\n   154\t\t\tLatencyMs:   latency,\r\n   155\t\t}, nil\r\n   156\t}\r\n   157\t\r\n   158\t// RecordRequest updates serving statistics for a single inference request.\r\n   159\t"]
[5635.863828, "o", "func (s *Server) RecordRequest(modelName string, successful bool, latencyMs float64) {\r\n   160\t\ts.mu.Lock()\r\n   161\t\tdefer s.mu.Unlock()\r\n   162\t\r\n   163\t\ts.stats.TotalRequests++\r\n   164\t\tif successful {\r\n   165\t\t\ts.stats.Successful++\r\n   166\t\t\ts.stats.LatencySum += latencyMs\r\n   167\t\t} else {\r\n   168\t\t"]
[5635.863921, "o", "\ts.stats.Failed++\r\n   169\t\t}\r\n   170\t\r\n   171\t\tmodel := s.stats.Models[modelName]\r\n   172\t\tif model == nil {\r\n   173\t\t\tmodel = &ModelStats{}\r\n   174\t\t\ts.stats.Models[modelName] = model\r\n   175\t\t}\r\n   176\t\tmodel.Requests++\r\n   177\t\tif successful {\r\n   178\t\t"]
[5635.863992, "o", "\tmodel.Successful++\r\n   179\t\t\tmodel.LatencySum += latencyMs\r\n   180\t\t} else {\r\n   181\t\t\tmodel.Failed++\r\n   182"]
[5635.864065, "o", "\t\t}\r\n   183\t}\r\n   184\t\r\n   185\t// GetStats returns a snapshot of accumulated serving statistics.\r\n   186\tfunc (s *Server) GetStats() StatsResponse {\r\n   187\t\ts.mu.RLock()\r\n   188\t\tdefer s.mu.RUnlock()\r\n   189\t\r\n   190\t\tresp := StatsResponse{\r\n   191\t\t\tTotalRequests: s.stats.TotalRequests,\r\n   192\t\t\tSuccessful:    s.stats.Successful,\r\n   193\t\t\tFailed:        s.stats.Failed,\r\n   194\t\t\tModels:        make(map[string]ModelStatsResponse),\r\n   195\t\t}\r\n   196\t\tif s.stats.Successful > 0 {\r\n   197"]
[5635.864132, "o", "\t\t\tresp.AvgLatencyMs = s.stats.LatencySum / float64(s.stats.Successful)\r\n   198\t\t}\r\n   199\t\r\n   200\t\tfor name, model := range s.stats.Models {\r\n"]
[5635.864256, "o", "   201\t\t\tm := ModelStatsResponse{\r\n   202\t\t\t\tRequests:   model.Requests,\r\n   203\t\t\t\tSuccessful: model.Successful,\r\n   204\t\t\t\tFailed:     model.Failed,\r\n   205\t\t\t}\r\n   206\t\t\tif model.Successful > 0 {\r\n   207\t\t\t\tm.AvgLatencyMs = model.LatencySum / float64(model.Successful)\r\n   208\t\t\t}\r\n   209\t\t"]
[5635.864332, "o", "\tif model.Requests > 0 {\r\n   210\t\t\t\tm.SuccessRate = float64(model.Successful) / float64(model.Requests)\r\n   211\t\t\t}\r\n   212\t\t\tresp.Models[name] = m\r\n   213\t\t}\r\n   214\t\treturn resp\r\n   215\t}\r\n   216\t\r\n   217\t// ResetStats resets all serving statistics to zero.\r\n   218\tfunc (s *Server) ResetStats() {\r\n   219\t\ts.mu.Lock()\r\n   220\t\tdefer s.mu.Unlock()\r\n   221\t\r\n   222\t\ts.stats = Stats{\r\n   223\t\t\tModels: make(map[string]*ModelStats),\r\n   224\t\t}\r\n   225\t}\r\n   226\t\r\n   227\t// ListLoaded returns all currently loaded models.\r\n   228\tfunc (s *Server) ListLoaded() []*LoadedModel {\r\n   229\t\ts.mu.RLock()\r\n   230\t\tdefer s.mu.RUnlock()\r\n   231\t\r\n   232\t\tresult := make([]*LoadedModel, 0, len(s.loaded))"]
[5635.864427, "o", "\r\n   233\t\tfor _, lm := range s.loaded {\r\n   234\t\t\tresult = append(result, lm)\r\n   235\t\t}\r\n"]
[5635.8645, "o", "   236\t\treturn result\r\n   237\t}\r\n   238\t\r\n   239\t// computePrediction evaluates a model against input data.\r\n   240\t// Supported model types: linear, polynomial.\r\n"]
