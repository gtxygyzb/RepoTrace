[6399.78671, "o", "\u001b[35m\u001b[Kinternal/experiment/experiment.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KCorrelation\u001b[m\u001b[KResult contains the Pearson correlation coefficient between two metrics.\r\n\u001b[35m\u001b[Kinternal/experiment/experiment.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktype \u001b[01;31m\u001b[KCorrelation\u001b[m\u001b[KResult struct {\r\n\u001b[35m\u001b[Kinternal/experiment/experiment.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KCorrelation\u001b[m\u001b[K computes the Pearson correlation coefficient between two metrics\r\n\u001b[35m\u001b[Kinternal/experiment/experiment.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (t *Tracker) \u001b[01;31m\u001b[KCorrelation\u001b[m\u001b[K(experimentName, metricX, metricY string) (*\u001b[01;31m\u001b[KCorrelation\u001b[m\u001b[KResult, error) {\r\n"]
