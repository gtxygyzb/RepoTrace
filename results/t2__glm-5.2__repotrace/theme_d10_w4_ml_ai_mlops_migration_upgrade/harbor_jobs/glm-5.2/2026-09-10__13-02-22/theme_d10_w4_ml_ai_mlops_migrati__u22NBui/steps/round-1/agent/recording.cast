[2061.968314, "o", "     1\tpackage pipeline\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"sort\"\r\n     6\t\t\"strings\"\r\n"]
[2061.968393, "o", "     7\t\t\"time\"\r\n     8\t)\r\n     9\t\r\n    10\t// StepType identifies the kind of processing a pipeline step performs.\r\n    11\ttype StepType string\r\n    12\t\r\n    13\tconst (\r\n    14\t\tStepTransform StepType = \"transform\"\r\n    15\t\tStepValidate  StepType = \"validate\"\r\n    16\t\tStepAggregate StepType = \"aggregate\"\r\n"]
[2061.968472, "o", "    17\t\tStepExport    StepType = \"export\"\r\n    18\t\tStepFilter    StepType = \"filter\"\r\n    19\t)\r\n    20\t\r\n"]
[2061.968537, "o", "    21\t// Step defines a single unit of work in a pipeline.\r\n    22\ttype Step struct {\r\n    23\t\tName            string                 `json:\"name\"`\r\n    24\t\tType            StepType               `json:\"type\"`\r\n    25\t\tConfig          map[string]interface{} `json:\"config\"`\r\n    26\t\tDependencies    []string               `json:\"dependencies\"`\r\n    27\t\tSetVars         map[string]string      `json:\"set_vars,omitempty\"`\r\n    28\t\tOutputTransform string                 `json:\"output_transform,omitempty\"`\r\n    29\t}\r\n    30\t\r\n    31\t// Pipeline defines a named sequence of dependent steps.\r\n"]
[2061.968604, "o", "    32\ttype Pipeline struct {\r\n    33\t\tName  string  `json:\"name\"`\r\n    34\t\tSteps []*Step `json:\"steps\"`\r\n    35\t}\r\n    36\t\r\n    37\t// StepResult records the outcome of executing a single step.\r\n    38\t"]
[2061.968667, "o", "type StepResult struct {\r\n    39\t\tStepName   string                 `json:\"step_name\"`\r\n    40\t\tStepType   StepType               `json:\"step_type\"`\r\n    41\t\tStatus     string                 `json:\"status\"`\r\n    42\t\tOutput     map[string]interface{} `json:\"output,omitempty\"`\r\n    43\t\tError      string                 `json:\"error,omitempty\"`\r\n"]
[2061.968729, "o", "    44\t\tDurationMs float64                `json:\"duration_ms\"`\r\n    45\t}\r\n    46\t\r\n    47\t// PipelineResult records the outcome of executing an entire pipeline.\r\n    48\ttype PipelineResult struct {\r\n"]
[2061.968788, "o", "    49\t\tPipelineName string        `json:\"pipeline_name\"`\r\n    50\t\tStatus       string        `json:\"status\"`\r\n    51\t\tSteps        []*StepResult `json:\"steps\"`\r\n    52\t\tTotalTimeMs  float64       `json:\"total_time_ms\"`\r\n    53\t}\r\n"]
[2061.968845, "o", "    54\t\r\n    55\t// Engine executes pipelines by resolving step dependencies and running each step.\r\n    56\ttype Engine struct {\r\n    57\t\tstepExecutors map[StepType]StepExecutor\r\n    58\t}\r\n    59\t\r\n"]
[2061.968914, "o", "    60\t// StepExecutor is the function signature for executing a pipeline step.\r\n    61\ttype StepExecutor func(config, input map[string]interface{}) (map[string]interface{}, error)\r\n    62\t\r\n    63\t// NewEngine creates a pipeline engine with built-in step executors.\r\n    64\tfunc NewEngine() *Engine {\r\n    65\t\te := &Engine{\r\n"]
[2061.96898, "o", "    66\t\t\tstepExecutors: make(map[StepType]StepExecutor),\r\n    67\t\t}\r\n    68\t\te.stepExecutors[StepTransform] = ExecuteTransform\r\n    69\t\te.stepExecutors[StepValidate] = ExecuteValidate\r\n    70\t\te.stepExecutors[StepAggregate] = ExecuteAggregate\r\n    71\t"]
[2061.969038, "o", "\te.stepExecutors[StepExport] = ExecuteExport\r\n    72\t\te.stepExecutors[StepFilter] = ExecuteFilter\r\n    73\t\treturn e\r\n    74\t}\r\n    75\t\r\n    76\t// Execute runs a pipeline with the given initial input data.\r\n"]
[2061.9691, "o", "    77\tfunc (e *Engine) Execute(p *Pipeline, initialInput map[string]interface{}) (*PipelineResult, error) {\r\n    78\t\tordered, err := topologicalSort(p.Steps)\r\n    79\t\tif err != nil {\r\n    80\t\t\treturn nil, fmt.Errorf(\"dependency resolution failed: %w\", err)\r\n    81\t\t}\r\n"]
[2061.969163, "o", "    82\t\r\n    83\t\tpipelineStart := time.Now()\r\n    84\t\tresult := &PipelineResult{\r\n    85\t\t\tPipelineName: p.Name,\r\n    86\t\t\tStatus:       \"success\",\r\n"]
[2061.969225, "o", "    87\t\t\tSteps:        make([]*StepResult, 0, len(ordered)),\r\n    88\t\t}\r\n    89\t\r\n    90\t\tstepOutputs := make(map[string]map[string]interface{})\r\n    91\t\tvariables := make(map[string]float64)\r\n    92\t"]
[2061.969306, "o", "\tvariableSetter := make(map[string]string)\r\n    93\t\tallDeps := computeTransitiveDependencies(p.Steps)\r\n    94\t\r\n    95\t\tfor _, step := range ordered {\r\n    96\t\t\tstepStart := time.Now()\r\n    97\t\r\n    98\t\t\tresolvedConfig, err := resolveVariables(step.Config, variables, variableSetter, allDeps[step.Name])\r\n    99\t\t\t"]
[2061.969362, "o", "if err != nil {\r\n   100\t\t\t\tsr := &StepResult{\r\n   101\t\t\t\t\tStepName:   step.Name,\r\n   102\t\t\t\t\tStepType:   step.Type,\r\n"]
[2061.969418, "o", "   103\t\t\t\t\tStatus:     \"failed\",\r\n   104\t\t\t\t\tError:      err.Error(),\r\n   105\t\t\t\t\tDurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\r\n   106\t\t\t\t}\r\n"]
[2061.969477, "o", "   107\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   108\t\t\t\tresult.Status = \"failed\"\r\n   109\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   110\t\t\t\treturn result, nil\r\n   111\t\t\t}\r\n"]
[2061.969533, "o", "   112\t\r\n   113\t\t\t// Determine input for this step\r\n   114\t\t\tvar input map[string]interface{}\r\n   115\t\t\tif len(step.Dependencies) == 0 {\r\n   116\t\t\t\tinput = initialInput\r\n"]
[2061.969594, "o", "   117\t\t\t} else {\r\n   118\t\t\t\tinput = mergeDependencyOutputs(step.Dependencies, stepOutputs)\r\n   119\t\t\t}\r\n   120\t\r\n"]
