[1442.615765, "i", "\n\n// mergeDependencyOutputs concatenates the \"data\" arrays from all dependency outputs into a single input.\nfunc mergeDependencyOutputs(deps []string, outputs map[string]map[string]interface{}) map[string]interface{} {\n\tmerged := make([]interface{}, 0)\n\tfor _, dep := range deps {\n\t\tout, ok := outputs[dep]\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tswitch data := out[\"data\"].(type) {\n\t\tcase []interface{}:\n\t\t\tmerged = append(merged, data...)\n\t\tcase []float64:\n\t\t\tfor _, v := range data {\n\t\t\t\tmerged = append(merged, v)\n\t\t\t}\n\t\t}\n\t}\n\treturn map[string]interface{}{\"data\": merged}\n}\n\nfunc computeTransitiveDependencies(steps []*Step) map[string]map[string]bool {\n\tstepMap := make(map[string]*Step)\n\tfor _, s := range steps {\n\t\tstepMap[s.Name] = s\n\t}\n\n\tresult := make(map[string]map[string]bool)\n\tvar visit func(s *Step) map[string]bool\n\n\tvisit = func(s *Step) map[string]bool {\n\t\tif deps, ok := result[s.Name]; ok {\n\t\t\treturn deps\n\t\t}\n\t\tdeps := make(map[string]bool)\n\t\tfor _, dep := range s.Dependencies {\n\t\t\tdeps[dep] = true\n\t\t\tif depStep"]
