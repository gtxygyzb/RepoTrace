[6217.799956, "o", "\t\t\tSteps    []*pipeline.Step       `json:\"steps\"`\r\n   175\t\t\tInput    map[string]interface{} `json:\"input\"`\r\n   176\t\t\tPipeline *pipeline.Pipeline     `json:\"pipeline\"`\r\n   177\t\t}\r\n   178\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n   179\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n   180\t\t\treturn\r\n   181\t\t}\r\n   182\t\tp := req.Pipeline\r\n   183\t\tif p == nil {\r\n   184\t\t\tp = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}\r\n"]
