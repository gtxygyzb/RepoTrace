[1092.423445, "o", "\tsr.Error = err.Error()\r\n   127\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   128\t\t\t\tresult.Status = \"failed\"\r\n   129\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   130\t\t\t\treturn result, nil\r\n   131\t\t\t}\r\n   132\t\r\n   133\t\t\tsr.Status = \"success\"\r\n   134\t\t\tsr.Output = output\r\n   135\t\t\tresult.Steps = append(result.Steps, sr)\r\n   136\t\r\n   137\t\t\tstepOutputs[step.Name] = output\r\n   138\t\t}\r\n   139\t\r\n   140\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   141\t\treturn result, nil\r\n   142"]
[1092.423523, "o", "\t}\r\n   143\t\r\n   144\t// topologicalSort orders steps so that dependencies are executed first.\r\n   145\t// Returns an error if a cycle is detected.\r\n   146\tfunc topologicalSort(steps []*Step) ([]*Step, error) {\r\n   147\t\tstepMap := make(map[string]*Step)\r\n   148\t\tinDegree := make(map[string]int)\r\n   149\t\r\n   150\t\tfor _, s := range steps {\r\n   151\t\t\tstepMap[s.Name] = s\r\n   152\t\t\tinDegree[s.Name] = 0\r\n   153\t\t}\r\n   154\t\r\n"]
[1092.423588, "o", "   155\t\t// Build in-degree counts\r\n   156\t\tfor _, s := range steps {\r\n   157\t\t\tfor _, dep := range s.Dependencies {\r\n   158\t\t\t\tif _, ok := stepMap[dep]; !ok {\r\n   159\t\t\t\t\treturn nil, fmt.Errorf(\"step %q depends on unknown step %q\", s.Name, dep)\r\n   160\t\t\t\t}\r\n   161\t\t\t\tinDegree[s.Name]++\r\n   162\t\t\t}\r\n"]
[1092.423649, "o", "   163\t\t}\r\n   164\t\r\n   165\t\t// Kahn's algorithm\r\n   166\t\tvar queue []*Step\r\n   167\t\tfor _, s := range steps {\r\n"]
[1092.423709, "o", "   168\t\t\tif inDegree[s.Name] == 0 {\r\n   169\t\t\t\tqueue = append(queue, s)\r\n   170\t\t\t}\r\n   171\t\t}\r\n   172\t\r\n   173\t\tvar ordered []*Step\r\n   174\t\tfor len(queue) > 0 {\r\n   175\t\t\tcurrent := queue[0]\r\n   176\t\t\tqueue = queue[1:]\r\n   177\t\t\tordered = append(ordered, current)\r\n   178\t\r\n   179\t\t\t// Find steps that depend on current\r\n   180\t\t\tfor _, s := range steps {\r\n   181\t\t\t\tfor _, dep := range s.Dependencies {\r\n"]
[1092.423768, "o", "   182\t\t\t\t\tif dep == current.Name {\r\n   183\t\t\t\t\t\tinDegree[s.Name]--\r\n   184\t\t\t\t\t\tif inDegree[s.Name] == 0 {\r\n   185\t\t\t\t\t\t\tqueue = append(queue, s)\r\n   186\t\t\t\t\t\t}\r\n   187\t\t\t\t\t}\r\n   188\t\t\t\t}\r\n"]
[1092.42383, "o", "   189\t\t\t}\r\n   190\t\t}\r\n   191\t\r\n   192\t\tif len(ordered) != len(steps) {\r\n   193\t\t\treturn nil, fmt.Errorf(\"cycle detected in pipeline dependencies\")\r\n   194\t\t}\r\n   195\t\r\n   196\t\treturn ordered, nil\r\n   197\t}\r\n"]
[1092.423917, "o", "   198\t\r\n   199\t// mergeDependencyOutputs concatenates the \"data\" arrays from all dependency outputs into a single input.\r\n   200\tfunc mergeDependencyOutputs(deps []string, outputs map[string]map[string]interface{}) map[string]interface{} {\r\n   201\t\tmerged := make([]interface{}, 0)\r\n   202\t\tfor _, dep := range deps {\r\n"]
[1092.42398, "o", "   203\t\t\tout, ok := outputs[dep]\r\n   204\t\t\tif !ok {\r\n   205\t\t\t\tcontinue\r\n   206\t\t\t}\r\n   207\t\t\tswitch data := out[\"data\"].(type) {\r\n   208\t\t\tcase []interface{}:\r\n   209\t\t\t\tmerged = append(merged, data...)\r\n   210\t\t\tcase []float64:\r\n   211\t\t\t\tfor _, v := range data {\r\n   212\t\t\t\t\tmerged = append(merged, v)\r\n   213\t\t\t\t}\r\n   214\t\t\t}\r\n   215\t\t}\r\n   216\t\treturn map[string]interface{}{\"data\": merged}\r\n   217\t}\r\n"]
