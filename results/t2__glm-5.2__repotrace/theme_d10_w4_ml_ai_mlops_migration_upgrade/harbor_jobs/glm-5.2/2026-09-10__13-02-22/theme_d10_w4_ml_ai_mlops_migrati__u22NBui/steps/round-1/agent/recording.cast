[6956.143485, "i", "oard returns the top runs for an experiment ranked by a metric.\nfunc (t *Tracker) Leaderboard(experimentName, metric, order string, limit int) (*LeaderboardResult, error) {\n\\tif order == \"\" {\n\\t\\torder = \"desc\"\n\\t}\n\\tif order != \"asc\" && order != \"desc\" {\n\\t\\treturn nil, fmt.Errorf(\"order must be \\\\\"asc\\\\\" or \\\\\"desc\\\\\"\")\n\\t}\n\n\\tt.mu.RLock()\n\\tdefer t.mu.RUnlock()\n\n\\texp, exists := t.experiments[experimentName]\n\\tif !exists {\n\\t\\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\n\\t}\n\n\\ttype candidate struct {\n\\t\\trun   *Run\n\\t\\tvalue float64\n\\t}\n\\tvar candidates []candidate\n\\tfor _, run := range exp.Runs {\n\\t\\tif run == nil {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tvalue, ok := run.Metrics[metric]\n\\t\\tif !ok {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tcandidates = append(candidates, candidate{run: run, value: value})\n\\t}\n\n\\tsort.Slice(candidates, func(i, j int) bool {\n\\t\\tif candidates[i].value != candidates[j].value {\n\\t\\t\\tif order == \"desc\" {\n\\t\\t\\t\\treturn candidates[i].value > candidates[j].value\n\\t\\t\\t}\n\\t\\t\\treturn ca"]
[6956.143568, "o", "pend(result.Errors, fmt.Sprintf(\"step %s depends on unknown step: %s\", step.Name, dep))\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}'''\r\ntext, n = re.subn(dep_pattern, dep_replacement, text, count=1)\r\nif"]
[6956.143637, "i", "ndidates[i].value < candidates[j].value\n\\t\\t}\n\\t\\treturn candidates[i].run.ID < candidates[j].run.ID\n\\t})\n\n\\tif limit < 0 {\n\\t\\tlimit = 0\n\\t}\n\\tif limit > len(candidates) {\n\\t\\tlimit = len(candidates)\n\\t}\n\n\\tentries := make([]LeaderboardEntry, 0, limit)\n\\tfor i := 0; i < limit; i++ {\n\\t\\trun := candidates[i].run\n\\t\\tentries = append(entries, LeaderboardEntry{\n\\t\\t\\tRank:       i + 1,\n\\t\\t\\tRunID:      run.ID,\n\\t\\t\\tValue:      candidates[i].value,\n\\t\\t\\tParameters: run.Parameters,\n\\t\\t\\tMetrics:    run.Metrics,\n\\t\\t})\n\\t}\n\n\\treturn &LeaderboardResult{\n\\t\\tExperiment: experimentName,\n\\t\\tMetric:     metric,\n\\t\\tOrder:      order,\n\\t\\tEntries:    entries,\n\\t\\tTotalRuns:  len(candidates),\n\\t}, nil\n}\n\n// SummaryResult contains basic statistics for a metric across runs.\ntype SummaryResult struct {\n\\tExperiment string  `json:\"experiment\"`\n\\tMetric     string  `json:\"metric\"`\n\\tCount      int     `json:\"count\"`\n\\tMin        float64 `json:\"min\"`\n\\tMax        float64 `json:\"max\"`\n\\tMean       float64 `json:\"mean\"`\n\\tM"]
