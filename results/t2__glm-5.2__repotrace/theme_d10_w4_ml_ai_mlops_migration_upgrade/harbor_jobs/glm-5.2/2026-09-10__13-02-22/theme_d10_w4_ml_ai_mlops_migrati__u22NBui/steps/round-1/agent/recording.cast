[151.744113, "o", "    94\t\t\tVersions:    make([]*Version, 0),\r\n    95\t\t\tCreatedAt:   now,\r\n    96\t\t\tUpdatedAt:   now,\r\n    97\t\t}\r\n    98\t\tr.models[name] = model\r\n    99\t\tif err := r.saveModel(model); err != nil {\r\n   100\t\t\tdelete(r.models, name)\r\n   101\t\t\treturn nil, err\r\n"]
