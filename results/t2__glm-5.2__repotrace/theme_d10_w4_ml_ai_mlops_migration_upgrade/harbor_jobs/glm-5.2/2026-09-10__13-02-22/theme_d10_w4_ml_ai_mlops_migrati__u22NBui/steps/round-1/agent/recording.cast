[4108.954809, "o", "   280\t// SearchRuns filters runs within an experiment by metric conditions.\r\n   281\tfunc (t *Tracker) SearchRuns(experimentName string, filters []MetricFilter) ([]*Run, error) {\r\n   282\t\tt.mu.RLock()\r\n   283\t\tdefer t.mu.RUnlock()\r\n   284\t\r\n   285\t\texp, exists := t.experiments[experimentName]\r\n   286\t\tif !exists {\r\n   287\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n"]
[4108.954962, "o", "   288\t\t}\r\n   289\t\r\n   290\t\tvar result []*Run\r\n   291\t\tfor _, run := range exp.Runs {\r\n   292\t\t\tmatch := true\r\n   293\t\t\tfor _, f := range filters {\r\n   294\t\t\t\tvalue, ok := run.Metrics[f.Metric]\r\n   295\t\t\t\tif !ok {\r\n   296\t\t\t\t\tmatch = false\r\n   297\t\t\t\t\tbreak\r\n"]
[4108.955034, "o", "   298\t\t\t\t}\r\n   299\t\t\t\tif !compareMetric(value, f.Op, f.Value) {\r\n   300\t\t\t\t\tmatch = false\r\n   301\t\t\t\t\tbreak\r\n   302\t\t\t\t}\r\n   303\t\t\t}\r\n   304\t\t\tif match {\r\n   305\t\t\t\tresult = append(result, run)\r\n   306\t\t\t}\r\n   307\t\t}\r\n   308\t\treturn result, nil"]
[4108.955096, "o", "\r\n   309\t}\r\n   310\t\r\n   311\t// MetricFilter defines a metric condition for searching runs.\r\n   312\ttype MetricFilter struct {\r\n   313\t\tMetric string  `json:\"metric\"`\r\n   314\t\tOp     string  `json:\"op\"`\r\n   315\t\tValue  float64 `json:\"value\"`\r\n   316\t}\r\n"]
[4108.955154, "o", "   317\t\r\n   318\tfunc compareMetric(value float64, op string, threshold float64) bool {\r\n   319\t\tswitch op {\r\n   320\t\tcase \"gt\":\r\n   321\t\t\treturn value > threshold\r\n   322\t\tcase \"lt\":\r\n   323\t\t\treturn value < threshold\r\n   324\t\tcase \"gte\":\r\n"]
[4108.95521, "o", "   325\t\t\treturn value >= threshold\r\n   326\t\tcase \"lte\":\r\n   327\t\t\treturn value <= threshold\r\n   328\t\tcase \"eq\":\r\n   329\t\t\treturn value == threshold\r\n   330\t\tdefault:\r\n   331\t\t\treturn false\r\n"]
[4108.955273, "o", "   332\t\t}\r\n   333\t}\r\n   334\t\r\n   335\tfunc matchTags(runTags map[string]string, filters map[string]string) bool {\r\n   336\t\tfor k, v := range filters {\r\n   337\t\t\tif runTags[k] != v {\r\n   338\t\t\t\treturn false\r\n   339\t\t\t}\r\n   340\t\t}\r\n   341\t\treturn true\r\n"]
[4108.95533, "o", "   342\t}\r\n   343\t\r\n   344\tfunc (t *Tracker) DeleteRun(experimentName, runID string) error {\r\n   345\t\tt.mu.Lock()\r\n   346\t\tdefer t.mu.Unlock()\r\n   347\t\r\n   348\t\texp, exists := t.experiments[experimentName]\r\n   349\t\tif !exists {\r\n"]
[4108.955394, "o", "   350\t\t\treturn fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   351\t\t}\r\n   352\t\r\n   353\t\tfor i, run := range exp.Runs {\r\n   354\t\t\tif run.ID == runID {\r\n   355\t\t\t\texp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)\r\n   356\t\t\t\treturn t.saveExperiment(exp)\r\n   357\t\t\t}\r\n"]
[4108.955454, "o", "   358\t\t}\r\n   359\t\treturn fmt.Errorf(\"run %q not found in experiment %q\", runID, experimentName)\r\n   360\t}\r\n"]
