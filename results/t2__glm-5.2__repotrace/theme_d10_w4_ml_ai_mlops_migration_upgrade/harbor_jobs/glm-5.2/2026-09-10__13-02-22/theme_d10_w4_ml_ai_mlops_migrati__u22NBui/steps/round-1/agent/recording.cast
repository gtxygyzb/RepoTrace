[5596.202592, "o", "internal/experiment/experiment.go:127:// AggregateMetric computes an aggregate statistic for a given metric across all runs\r\ninternal/experiment/experiment.go:128:// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.\r\ninternal/experiment/experiment.go:129:// For weighted_mean, weightParam specifies which parameter to use as weight.\r\ninternal/experiment/experiment.go:130:func (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string, tagFilters map[string]string) (float64, int, []string, error) {\r\ninternal/experiment/experiment.go:154:\t\tif aggType == \"weighted_mean\" {\r\ninternal/experiment/experiment.go:176:\tcase \"mean\":\r\ninternal/experiment/experiment.go:199:\tcase \"weighted_mean\":\r\ninternal/experiment/experiment.go:201:\t\t\treturn 0, 0, nil, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\ninternal/experiment/experiment.go:216:\t\t\treturn 0, 0, nil, fmt.Errorf(\"weighted_mean has zero total weight\")\r\ninternal/api/handlers.go:261:func (h *Handlers) AggregateMet"]
[5596.202725, "o", "ric(w http.ResponseWriter, r *http.Request) {\r\ninternal/api/handlers.go:281:\tresult, count, runIDs, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam, tagFilters)\r\ninternal/api/handlers.go:452:\t\t\t\"mean\":        sum / float64(len(vals)),\r\ninternal/api/handlers.go:648:\tMean  float64 `json:\"mean\"`\r\ninternal/api/handlers.go:686:\tvar means []float64\r\ninternal/api/handlers.go:720:\t\tmean := sum / float64(len(values))\r\ninternal/api/handlers.go:723:\t\t\tMean:  mean,\r\ninternal/api/handlers.go:728:\t\tmeans = append(means, mean)\r\ninternal/api/handlers.go:730:\t\tif len(entries) == 1 || mean > bestMean {\r\ninternal/api/handlers.go:732:\t\t\tbestMean = mean\r\ninternal/api/handlers.go:742:\tif len(means) > 0 {\r\ninternal/api/handlers.go:743:\t\tminMean := means[0]\r\ninternal/api/handlers.go:744:\t\tmaxMean := means[0]\r\ninternal/api/handlers.go:745:\t\tfor _, mean := range means {\r\ninternal/api/handlers.go:746:\t\t\tif mean < minMean {\r\ninternal/api/handlers.go:747:\t\t\t\tminMean = mean\r\ninternal/api/handlers.go:749:\t\t\tif"]
