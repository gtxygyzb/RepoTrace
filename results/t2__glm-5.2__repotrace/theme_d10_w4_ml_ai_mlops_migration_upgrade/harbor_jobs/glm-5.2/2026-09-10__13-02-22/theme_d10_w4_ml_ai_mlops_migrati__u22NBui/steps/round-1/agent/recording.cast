[7166.631294, "o", "\\tloaded, err := h.Serving.ReloadModel(name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.631359, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.631428, "o", "\\t\\tif strings.Contains(err.Error(), \"is not loaded\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.631516, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.63157, "o", "\\t\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.63164, "o", "\\t\\t\\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
