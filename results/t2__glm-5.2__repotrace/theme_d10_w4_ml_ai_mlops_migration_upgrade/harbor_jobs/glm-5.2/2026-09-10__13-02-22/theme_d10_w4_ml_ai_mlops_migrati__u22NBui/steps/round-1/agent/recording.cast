[6956.307026, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.307081, "o", "\u001b[?2004h> "]
[6956.307219, "o", "\\twriteJSON(w, http.StatusOK, result)\r\n\u001b[?2004l\r"]
[6956.307274, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[6956.307329, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.307384, "o", "\u001b[?2004h> "]
[6956.30766, "o", "func (h *Handlers) ReloadModel(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[6956.307716, "o", "\u001b[?2004h> "]
[6956.307832, "o", "\\tname := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[6956.307897, "o", "\u001b[?2004h> "]
[6956.308072, "o", "\\tloaded, err := h.Serving.ReloadModel(name)\r\n\u001b[?2004l\r"]
[6956.308128, "o", "\u001b[?2004h> "]
[6956.308191, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[6956.308248, "o", "\u001b[?2004h> "]
[6956.308463, "o", "\\t\\tif strings.Contains(err.Error(), \"is not loaded\") {\r\n\u001b[?2004l\r"]
[6956.308519, "o", "\u001b[?2004h> "]
[6956.308724, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[6956.308781, "o", "\u001b[?2004h> "]
