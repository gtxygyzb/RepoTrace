[2164.488294, "o", "\u001b[?2004h> "]
[2164.488369, "o", "\\t\\t\\t\\tmatch = false\r\n\u001b[?2004l\r"]
[2164.488423, "o", "\u001b[?2004h> "]
[2164.488484, "o", "\\t\\t\\t\\tbreak\r\n\u001b[?2004l\r\u001b[?2004h"]
[2164.488539, "o", "> \\t\\t\\t}\r\n\u001b[?2004l\r"]
[2164.488596, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[2164.488648, "o", "\u001b[?2004h> "]
[2164.488714, "o", "\\t\\tif match {\r\n\u001b[?2004l\r"]
[2164.488768, "o", "\u001b[?2004h> "]
[2164.48892, "o", "\\t\\t\\tresult = append(result, run)\r\n\u001b[?2004l\r"]
[2164.488975, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[2164.489037, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2164.489092, "o", "\u001b[?2004h> "]
[2164.489176, "o", "\\treturn result, nil\r\n\u001b[?2004l\r"]
[2164.48923, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2164.489283, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
