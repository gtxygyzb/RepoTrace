[1043.641997, "o", "     1\tpackage api\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"net/http\"\r\n     5\t\r\n     6"]
[1043.642134, "o", "\t\t\"gomlops/internal/experiment\"\r\n     7\t\t\"gomlops/internal/pipeline\"\r\n     8\t\t\"gomlops/internal/registry\"\r\n     9\t\t\"gomlops/internal/serving\"\r\n    10\t)\r\n    11\t\r\n    12\t// Handlers holds references to all service components.\r\n    13\ttype Handlers struct {\r\n    14\t\tRegistry   *registry.Registry\r\n    15\t\tPipeline   *pipeline.Engine\r\n    16\t\tExperiment *experiment.Tracker\r\n    17\t\tServing    *serving.Server\r\n    18\t}\r\n    19\t\r\n    20\t// NewRouter builds the HTTP route table and returns a handler.\r\n    21\tfunc NewRouter(reg *registry.Registry, eng *pipeline.Engine, tracker *experiment.Tracker, srv *serving.Server) http.Handler {\r\n    22\t\th := &Handlers{\r\n"]
[1043.642231, "o", "    23\t\t\tRegistry:   reg,\r\n    24\t\t\tPipeline:   eng,\r\n    25\t\t\tExperiment: tracker,\r\n    26\t\t\tServing:    srv,\r\n    27\t\t}\r\n    28\t\r\n    29\t\tmux := http.NewServeMux()\r\n    30\t\r\n    31\t\t// Model registry endpoints\r\n    32\t\tmux.HandleFunc(\"POST /api/v1/models\", h.RegisterModel)\r\n    33\t\tmux.HandleFunc(\"GET /api/v1/models\", h.ListModels)\r\n    34\t\tmux.HandleFunc(\"GET /api/v1/models/{name}\", h.GetModel)\r\n    35\t\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions\", h.CreateVersion)\r\n    36\t\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}\", h.GetVersion)\r\n    37\t\tmux.HandleFunc(\"PUT /api/v1/models/{name}/versions/{num}/promote\", h.PromoteVersion)\r\n"]
[1043.642301, "o", "    38\t\tmux.HandleFunc(\"DELETE /api/v1/models/{name}\", h.DeleteModel)\r\n    39\t\r\n    40\t\t// Pipeline endpoints\r\n    41\t\tmux.HandleFunc(\"POST /api/v1/pipelines/execute\", h.ExecutePipeline)\r\n    42\t\r\n    43\t\t// Experiment endpoints\r\n    44\t\tmux.HandleFunc(\"POST /api/v1/experiments\", h.CreateExperiment)\r\n"]
[1043.642385, "o", "    45\t\tmux.HandleFunc(\"GET /api/v1/experiments\", h.ListExperiments)\r\n    46\t\tmux.HandleFunc(\"GET /api/v1/experiments/{name}\", h.GetExperiment)\r\n    47\t\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs\", h.LogRun)\r\n    48\t\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/aggregate\", h.AggregateMetric)\r\n    49\t\r\n    50\t\t// Serving endpoints\r\n    51\t\tmux.HandleFunc(\"POST /api/v1/serving/load\", h.LoadModel)\r\n"]
[1043.64245, "o", "    52\t\tmux.HandleFunc(\"DELETE /api/v1/serving/models/{name}\", h.UnloadModel)\r\n    53\t\tmux.HandleFunc(\"GET /api/v1/serving/models\", h.ListLoadedModels)\r\n    54\t\tmux.HandleFunc(\"POST /api/v1/serving/infer\", h.Infer)\r\n    55\t\r\n    56\t\t// Health check\r\n    57\t\tmux.HandleFunc(\"GET /health\", func(w http.ResponseWriter, r *http.Request) {\r\n    58\t\t\tw.WriteHeader(http.StatusOK)\r\n    59\t\t\tw.Write([]byte(`{\"status\":\"ok\"}`))\r\n    60\t\t})\r\n    61\t\r\n    62\t\treturn mux\r\n    63\t}\r\n"]
