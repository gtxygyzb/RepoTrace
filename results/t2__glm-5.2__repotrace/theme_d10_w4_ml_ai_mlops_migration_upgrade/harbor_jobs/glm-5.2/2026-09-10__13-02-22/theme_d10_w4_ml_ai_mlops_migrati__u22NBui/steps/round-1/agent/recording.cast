[2520.518149, "o", "\u001b[?2004h> "]
[2520.518683, "o", "new_handlers = '''func (h *Handlers) GetMetricHistory(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[2520.518738, "o", "\u001b[?2004h> "]
