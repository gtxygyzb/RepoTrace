[4624.41064, "o", "\\t\\treturn versions[i].Number < versions[j].Number\r\n\u001b[?2004l\r"]
[4624.410678, "o", "\u001b[?2004h> "]
[4624.410716, "o", "\\t})\r\n\u001b[?2004l\r\u001b[?2004h"]
