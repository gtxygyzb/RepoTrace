[1442.628524, "o", "\u0007"]
[1442.628886, "o", "StepName   string                 `json:\"step_name\"`\r\n\u001b[?2004l\r"]
[1442.628936, "o", "\u001b[?2004h> "]
[1442.629009, "o", "\u0007"]
[1442.629364, "o", "StepType   StepType               `json:\"step_type\"`\r\n\u001b[?2004l\r"]
[1442.629414, "o", "\u001b[?2004h> "]
[1442.629486, "o", "\u0007"]
[1442.629823, "o", "Status     string                 `json:\"status\"`\r\n\u001b[?2004l\r"]
[1442.629881, "o", "\u001b[?2004h> "]
[1442.629953, "o", "\u0007"]
[1442.630352, "o", "Output     map[string]interface{} `json:\"output,omitempty\"`\r\n\u001b[?2004l\r"]
