[135.593547, "o", "sed -n '1,260p' internal/serving/serving.go\r\n\u001b[?2004l\r"]
[135.596409, "o", "package serving\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"sync\"\r\n\t\"time\"\r\n\r\n\t\"gomlops/internal/registry\"\r\n"]
[135.596495, "o", ")\r\n\r\n// LoadedModel tracks a model version currently loaded for serving.\r\ntype LoadedModel struct {\r\n\tModelName   string                 `json:\"model_name\"`\r\n\tVersionNum  int                    `json:\"version_num\"`\r\n\tStage       registry.Stage         `json:\"stage\"`\r\n\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n\tLoadedAt    time.Time              `json:\"loaded_at\"`\r\n}\r\n\r\n// InferenceRequest contains the input data for model inference.\r\ntype InferenceRequest struct {\r\n\tModelName string    `json:\"model_name\"`\r\n\tInput     []float64 `json:\"input\"`\r\n"]
[135.596577, "o", "}\r\n\r\n// InferenceResponse contains the model prediction results.\r\ntype InferenceResponse struct {\r\n\tModelName   string      `json:\"model_name\"`\r\n\tVersion     interface{} `json:\"version\"`\r\n\tPredictions []float64   `json:\"predictions\"`\r\n\tLatencyMs   float64     `json:\"latency_ms\"`\r\n}\r\n\r\n// Server manages model loading and inference.\r\ntype Server struct {\r\n\tmu       sync.RWMutex\r\n\tloaded   map[string]*LoadedModel\r\n\tregistry *registry.Registry\r\n}\r\n"]
[135.59664, "o", "\r\n// NewServer creates a new serving server backed by the given registry.\r\nfunc NewServer(reg *registry.Registry) *Server {\r\n\treturn &Server{\r\n\t\tloaded:   make(map[string]*LoadedModel),\r\n\t\tregistry: reg,\r\n\t}\r\n}\r\n\r\n// LoadModel loads a model version for serving. Specify either versionNum > 0\r\n// or a non-empty stage string (not both).\r\n"]
[135.5967, "o", "func (s *Server) LoadModel(modelName string, versionNum int, stage string) error {\r\n\tvar version *registry.Version\r\n\tvar err error\r\n\r\n\tif versionNum > 0 {\r\n\t\tversion, err = s.registry.GetVersion(modelName, versionNum)\r\n\t} else if stage != \"\" {\r\n\t\tversion, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))\r\n\t"]
[135.596764, "o", "} else {\r\n\t\treturn fmt.Errorf(\"must specify version number or stage\")\r\n\t}\r\n\r\n\tif err != nil {\r\n\t\treturn fmt.Errorf(\"load model: %w\", err)\r\n\t}\r\n\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n"]
[135.596825, "o", "\ts.loaded[modelName] = &LoadedModel{\r\n\t\tModelName:   modelName,\r\n\t\tVersionNum:  version.Number,\r\n\t\tStage:       version.Stage,\r\n\t\tModelConfig: version.ModelConfig,\r\n\t\tLoadedAt:    time.Now(),\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n// UnloadModel removes a model from the serving cache.\r\nfunc (s *Server) UnloadModel(modelName string) error {\r\n\ts.mu.Lock()\r\n"]
[135.596907, "o", "\tdefer s.mu.Unlock()\r\n\r\n\tif _, exists := s.loaded[modelName]; !exists {\r\n\t\treturn fmt.Errorf(\"model %q is not loaded\", modelName)\r\n\t}\r\n\tdelete(s.loaded, modelName)\r\n\treturn nil\r\n}\r\n\r\n// Infer runs inference on the loaded model and returns predictions.\r\nfunc (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {\r\n"]
[135.59697, "o", "\tstart := time.Now()\r\n\r\n\ts.mu.RLock()\r\n\tloaded, exists := s.loaded[req.ModelName]\r\n\ts.mu.RUnlock()\r\n\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", req.ModelName)\r\n\t}\r\n\r\n"]
[135.597033, "o", "\tpredictions, err := computePrediction(loaded.ModelConfig, req.Input)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n\t}\r\n\r\n\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n\r\n\treturn &InferenceResponse{\r\n\t\tModelName:   req.ModelName,\r\n\t\tVersion:     string(loaded.Stage),\r\n\t\tPredictions: predictions,\r\n\t\tLatencyMs:   latency,\r\n"]
[135.597095, "o", "\t}, nil\r\n}\r\n\r\n// ListLoaded returns all currently loaded models.\r\nfunc (s *Server) ListLoaded() []*LoadedModel {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\r\n\tresult := make([]*LoadedModel, 0, len(s.loaded))\r\n\tfor _, lm := range s.loaded {\r\n\t\tresult = append(result, lm)\r\n\t}\r\n\treturn result\r\n}\r\n"]
[135.597159, "o", "\r\n// computePrediction evaluates a model against input data.\r\n// Supported model types: linear, polynomial.\r\nfunc computePrediction(modelConfig map[string]interface{}, input []float64) ([]float64, error) {\r\n\tif modelConfig == nil {\r\n\t\treturn nil, fmt.Errorf(\"model has no configuration\")\r\n\t}\r\n\r\n\tmodelType, _ := modelConfig[\"model_type\"].(string)\r\n\tswitch modelType {\r\n\tcase \"linear\":\r\n\t\treturn linearPredict(modelConfig, input)\r\n\tcase \"polynomial\":\r\n"]
[135.597248, "o", "\t\treturn polynomialPredict(modelConfig, input)\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"unsupported model type: %s\", modelType)\r\n\t}\r\n}\r\n\r\n// linearPredict computes y = sum(weights[i] * input[i]) + bias\r\nfunc linearPredict(config map[string]interface{}, input []float64) ([]float64, error) {\r\n\tweightsRaw, ok := config[\"weights\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"linear model missing weights\")\r\n\t}\r\n\tbias, _ := config[\"bias\"].(float64)\r\n\r\n\tweights := make([]float64, len(weightsRaw))\r\n\t"]
[135.597306, "o", "for i, w := range weightsRaw {\r\n\t\twf, ok := w.(float64)\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"weight %d is not a number\", i)\r\n\t\t}\r\n\t\tweights[i] = wf\r\n\t}\r\n\r\n\tprediction := bias\r\n\tfor i := 0; i < len(weights) && i < len(input); i++ {"]
[135.597362, "o", "\r\n\t\tprediction += weights[i] * input[i]\r\n\t}\r\n\r\n\treturn []float64{prediction}, nil\r\n}\r\n\r\n// polynomialPredict computes y = sum(coefficients[i] * x^i) for each input x\r\nfunc polynomialPredict(config map[string]interface{}, input []float64) ([]float64, error) {\r\n\tcoeffRaw, ok := config[\"coefficients\"].([]interface{})\r\n"]
[135.59743, "o", "\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"polynomial model missing coefficients\")\r\n\t}\r\n\r\n\tcoefficients := make([]float64, len(coeffRaw))\r\n\tfor i, c := range coeffRaw {\r\n\t\tcf, ok := c.(float64)\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"coefficient %d is not a number\", i)\r\n\t\t}\r\n\t\tcoefficients[i] = cf\r\n"]
[135.597492, "o", "\t}\r\n\r\n\tpredictions := make([]float64, len(input))\r\n\tfor j, x := range input {\r\n\t\ty := 0.0\r\n\t\txPow := x\r\n\t\tfor _, c := range coefficients {\r\n\t\t\ty += c * xPow\r\n\t\t\txPow *= x\r\n\t\t}\r\n\t"]
[135.597548, "o", "\tpredictions[j] = y\r\n\t}\r\n\r\n\treturn predictions, nil\r\n}\r\n"]
[135.598006, "o", "\u001b[?2004h"]
[135.598064, "o", "root@n30009:/app# "]
[135.872906, "i", "sed -n '1,360p' internal/api/handlers.go\n"]
[135.873242, "o", "sed -n '1,360p' internal/api/handlers.go\r\n\u001b[?2004l\r"]
[135.876053, "o", "package api\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[135.876102, "o", "\t\"net/http\"\r\n\t\"strconv\"\r\n\r\n\t\"gomlops/internal/pipeline\"\r\n\t\"gomlops/internal/registry\"\r\n\t\"gomlops/internal/serving\"\r\n)\r\n\r\n"]
[135.876254, "o", "// --- Model Registry Handlers ---\r\n\r\nfunc (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tName        string   `json:\"name\"`\r\n\t\tFramework   string   `json:\"framework\"`\r\n\t\tDescription string   `json:\"description\"`\r\n\t\tTags        []string `json:\"tags\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Name == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"name is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tmodel, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, model)\r\n}"]
[135.87635, "o", "\r\n\r\nfunc (h *Handlers) ListModels(w http.ResponseWriter, r *http.Request) {\r\n\tvar filter *registry.ModelFilter\r\n\tframework := r.URL.Query().Get(\"framework\")\r\n\ttag := r.URL.Query().Get(\"tag\")\r\n\tif framework != \"\" || tag != \"\" {\r\n\t\tfilter = &registry.ModelFilter{Framework: framework, Tag: tag}\r\n\t}\r\n\r\n\tmodels, err := h.Registry.ListModels(filter)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusInternalServerError, \"%v\", err)\r\n\t\treturn\r\n"]
[135.876422, "o", "\t}\r\n\twriteJSON(w, http.StatusOK, models)\r\n}\r\n\r\nfunc (h *Handlers) DeleteModel(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\tif err := h.Registry.DeleteModel(name); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n}\r\n\r\nfunc (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n"]
[135.87651, "o", "\tmodel, err := h.Registry.GetModel(name)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, model)\r\n}\r\n\r\nfunc (h *Handlers) CreateVersion(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\r\n\tvar req struct {\r\n\t\tMetrics     map[string]float64     `json:\"metrics\"`\r\n\t"]
[135.8766, "o", "\tTags        []string               `json:\"tags\"`\r\n\t\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n"]
[135.876687, "o", "\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\r\n\tversion, err := h.Registry.CreateVersion(modelName, req.Metrics, req.Tags, req.ModelConfig)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, version)\r\n}\r\n\r\nfunc (h *Handlers) GetVersion(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\tnumStr := r.PathValue(\"num\")\r\n\tnum, err := strconv.Atoi(numStr)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\t\treturn\r\n\t}\r\n\r\n\tversion, err := h.Registry.GetVersion(modelName, num)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n"]
[135.876782, "o", "\t}\r\n\twriteJSON(w, http.StatusOK, version)\r\n}\r\n\r\nfunc (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\tnumStr := r.PathValue(\"num\")\r\n\tnum, err := strconv.Atoi(numStr)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\t\treturn\r\n\t}\r\n\r\n\tvar req struct {\r\n\t\tStage string `json:\"stage\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n"]
[135.876939, "o", "\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Stage == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"stage is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tif err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"promoted\"})\r\n}\r\n\r\n// --- Pipeline Handlers ---\r\n\r\nfunc (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tPipeline *pipeline.Pipeline     `json:\"pipeline\"`\r\n\t\tInput    map[string]interface{} `json:\"input\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n"]
[135.876987, "o", "\t\treturn\r\n\t}\r\n\tif req.Pipeline == nil || len(req.Pipeline.Steps) == 0 {\r\n\t\twriteError(w, http.StatusBadRequest, \"pipeline with at least one step is required\")\r\n\t\treturn\r\n\t}\r\n\tif req.Input == nil {\r\n\t\treq.Input = make(map[string]interface{})\r\n\t}\r\n"]
[135.877209, "o", "\r\n\tresult, err := h.Pipeline.Execute(req.Pipeline, req.Input)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, result)\r\n}\r\n\r\n// --- Experiment Handlers ---\r\n\r\nfunc (h *Handlers) CreateExperiment(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tName string `json:\"name\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Name == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"name is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\texp, err := h.Experiment.CreateExperiment(req.Name)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, exp)\r\n}\r\n\r\nfunc (h *Handlers) ListExperiments(w http.ResponseWriter, r *http.Request) {\r\n\texps := h.Experiment.ListExperiments()\r\n\twriteJSON(w, http.StatusOK, exps)\r\n}\r\n\r\nfunc (h *Handlers) GetExperiment(w http.ResponseWriter, r *http.Request) {"]
[135.877283, "o", "\r\n\tname := r.PathValue(\"name\")\r\n\texp, err := h.Experiment.GetExperiment(name)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, exp)\r\n}\r\n\r\nfunc (h *Handlers) LogRun(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\r\n\tvar req struct {\r\n\t\tParameters map[string]float64 `json:\"parameters\"`\r\n\t"]
[135.877345, "o", "\tMetrics    map[string]float64 `json:\"metrics\"`\r\n\t\tTags       map[string]string  `json:\"tags\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\r\n\trun, err := h.Experiment.LogRun(expName, req.Parameters, req.Metrics, req.Tags)\r\n\tif err != nil {\r\n"]
[135.877406, "o", "\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, run)\r\n}\r\n\r\nfunc (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\tmetricName := r.PathValue(\"metric\")\r\n\taggType := r.URL.Query().Get(\"type\")\r\n\tweightParam := r.URL.Query().Get(\"weight_param\")\r\n"]
[135.877464, "o", "\r\n\tif aggType == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"query parameter 'type' is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tresult, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam)\r\n\tif err != nil {\r\n"]
[135.877522, "o", "\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\r\n\texp, _ := h.Experiment.GetExperiment(expName)\r\n\trunCount := 0\r\n\tif exp != nil {\r\n\t\trunCount = len(exp.Runs)\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\t\t\"experiment\": expName,\r\n"]
[135.877607, "o", "\t\t\"metric\":     metricName,\r\n\t\t\"type\":       aggType,\r\n\t\t\"value\":      result,\r\n\t\t\"count\":      runCount,\r\n\t"]
[135.877674, "o", "})\r\n}\r\n\r\n// --- Serving Handlers ---\r\n\r\nfunc (h *Handlers) LoadModel(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tModelName  string `json:\"model_name\"`\r\n\t\tVersionNum int    `json:\"version_num\"`\r\n\t\tStage      string `json:\"stage\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.ModelName == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"model_name is required\")\r\n\t\treturn\r\n\t}\r\n\r\n"]
[135.877733, "o", "\tif err := h.Serving.LoadModel(req.ModelName, req.VersionNum, req.Stage); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"loaded\"})\r\n}\r\n\r\nfunc (h *Handlers) UnloadModel(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n"]
[135.877791, "o", "\tif err := h.Serving.UnloadModel(name); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"unloaded\"})\r\n}\r\n\r\nfunc (h *Handlers) ListLoadedModels(w http.ResponseWriter, r *http.Request) {\r\n\tmodels := h.Serving.ListLoaded()\r\n\twriteJSON(w, http.StatusOK, models)\r\n}\r\n"]
[135.87785, "o", "\r\nfunc (h *Handlers) Infer(w http.ResponseWriter, r *http.Request) {\r\n\tvar req serving.InferenceRequest\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.ModelName == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"model_name is required\")\r\n\t\treturn\r\n"]
[135.877921, "o", "\t}\r\n\r\n\tresp, err := h.Serving.Infer(&req)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, resp)\r\n}\r\n\r\n// --- Helpers ---\r\n"]
[135.87798, "o", "\r\nfunc writeJSON(w http.ResponseWriter, status int, data interface{}) {\r\n\tw.Header().Set(\"Content-Type\", \"application/json\")\r\n\tw.WriteHeader(status)\r\n\tjson.NewEncoder(w).Encode(data)\r\n}\r\n\r\nfunc writeError(w http.ResponseWriter, status int, format string, args ...interface{}) {\r\n\tw.Header().Set(\"Content-Type\", \"application/json\")\r\n\tw.WriteHeader(status)\r\n"]
[135.878037, "o", "\tmsg := fmt.Sprintf(format, args...)\r\n\tjson.NewEncoder(w).Encode(map[string]string{\"error\": msg})\r\n}\r\n"]
[135.878479, "o", "\u001b[?2004h"]
[135.878536, "o", "root@n30009:/app# "]
[136.152251, "i", "sed -n '1,220p' internal/api/router.go\n"]
[136.152588, "o", "sed -n '1,220p' internal/api/router.go\r\n\u001b[?2004l\r"]
[136.155693, "o", "package api\r\n\r\nimport (\r\n\t\"net/http\"\r\n\r\n\t"]
[136.155777, "o", "\"gomlops/internal/experiment\"\r\n\t\"gomlops/internal/pipeline\"\r\n\t\"gomlops/internal/registry\"\r\n\t\"gomlops/internal/serving\"\r\n)\r\n\r\n// Handlers holds references to all service components.\r\ntype Handlers struct {\r\n\tRegistry   *registry.Registry\r\n\tPipeline   *pipeline.Engine\r\n\tExperiment *experiment.Tracker\r\n\tServing    *serving.Server\r\n}\r\n\r\n"]
[136.155886, "o", "// NewRouter builds the HTTP route table and returns a handler.\r\nfunc NewRouter(reg *registry.Registry, eng *pipeline.Engine, tracker *experiment.Tracker, srv *serving.Server) http.Handler {\r\n\th := &Handlers{\r\n\t\tRegistry:   reg,\r\n\t\tPipeline:   eng,\r\n\t\tExperiment: tracker,\r\n\t\tServing:    srv,\r\n\t}\r\n\r\n\tmux := http.NewServeMux()\r\n\r\n\t// Model registry endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/models\", h.RegisterModel)\r\n\tmux.HandleFunc(\"GET /api/v1/models\", h.ListModels)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}\", h.GetModel)\r\n\t"]
[136.155981, "o", "mux.HandleFunc(\"POST /api/v1/models/{name}/versions\", h.CreateVersion)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}\", h.GetVersion)\r\n\tmux.HandleFunc(\"PUT /api/v1/models/{name}/versions/{num}/promote\", h.PromoteVersion)\r\n\tmux.HandleFunc(\"DELETE /api/v1/models/{name}\", h.DeleteModel)\r\n\r\n\t// Pipeline endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/execute\", h.ExecutePipeline)\r\n\r\n\t// Experiment endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/experiments\", h.CreateExperiment)\r\n\t"]
[136.156051, "o", "mux.HandleFunc(\"GET /api/v1/experiments\", h.ListExperiments)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments/{name}\", h.GetExperiment)\r\n\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs\", h.LogRun)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/aggregate\", h.AggregateMetric)\r\n\r\n\t// Serving endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/serving/load\", h.LoadModel)\r\n\tmux.HandleFunc(\"DELETE /api/v1/serving/models/{name}\", h.UnloadModel)\r\n\tmux.HandleFunc(\"GET /api/v1/serving/models\", h.ListLoadedModels)\r\n\tmux.HandleFunc(\"POST /api/v1/serving/infer\", h.Infer)\r\n\r\n\t// Health check\r\n\tmux.HandleFunc(\"GET /health\", func(w http.ResponseWriter, r *http.Request) {\r\n\t\tw.WriteHeader(http.StatusOK)\r\n\t\tw.Write([]byte(`{\"status\":\"ok\"}`))\r\n\t})\r\n\r\n\treturn mux\r\n}\r\n"]
