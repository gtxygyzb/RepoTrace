[5753.04038, "o", "   369\tfunc validateAnnotationKey(key string) bool {\r\n   370\t\treturn annotationKeyRegexp.MatchString(key)\r\n   371\t}\r\n   372\t\r\n   373\t// AddAnnotation attaches a new key-value annotation to a model version.\r\n   374\tfunc (r *Registry) AddAnnotation(modelName string, versionNum int, key, value string) (*Annotation, error) {\r\n   375\t\tr.mu.Lock()\r\n"]
[5753.040496, "o", "   376\t\tdefer r.mu.Unlock()\r\n   377\t\r\n   378\t\tif _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {\r\n   379\t\t\treturn nil, err\r\n   380\t\t}\r\n   381\t\tif !validateAnnotationKey(key) {\r\n   382\t\t\treturn nil, fmt.Errorf(\"invalid annotation key\")\r\n   383\t\t}\r\n   384\t\r\n   385\t\tif r.annotations[modelName] == nil {\r\n   386\t\t\tr.annotations[modelName] = make(map[int]map[string]*Annotation)\r\n   387\t\t}\r\n   388\t\tif r.annotations[modelName][versionNum] == nil {\r\n   389\t\t\tr.annotations[modelName][versionNum] = make(map[string]*Annotation)\r\n   390\t\t}\r\n   391\t\tif _, exists := r.annotations[modelName][versionNum][key]; exists {\r\n"]
[5753.040582, "o", "   392\t\t\treturn nil, fmt.Errorf(\"annotation %q already exists\", key)\r\n   393\t\t}\r\n   394\t\r\n   395\t\tannotation := &Annotation{\r\n   396\t\t\tKey:       key,\r\n   397\t\t\tValue:     value,\r\n   398\t\t\tCreatedAt: time.Now(),\r\n   399\t\t}\r\n   400\t\tr.annotations[modelName][versionNum][key] = annotation\r\n   401\t\treturn annotation, nil\r\n   402\t}\r\n   403\t\r\n"]
[5753.04066, "o", "   404\t// ListAnnotations returns all annotations for a model version sorted by key.\r\n   405\tfunc (r *Registry) ListAnnotations(modelName string, versionNum int) ([]*Annotation, error) {\r\n   406\t\tr.mu.RLock()\r\n   407\t\tdefer r.mu.RUnlock()\r\n   408\t\r\n   409\t\tif _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {\r\n   410\t\t\treturn nil, err\r\n   411\t\t}\r\n   412\t\r\n   413\t\tvar annotations []*Annotation\r\n   414\t\t"]
[5753.040735, "o", "if versions, ok := r.annotations[modelName]; ok {\r\n   415\t\t\tif keys, ok := versions[versionNum]; ok {\r\n   416\t\t\t\tfor _, a := range keys {\r\n   417\t\t\t\t\tannotations = append(annotations, a)\r\n   418\t\t\t\t}\r\n   419\t\t\t}\r\n   420\t\t}\r\n   421\t\tsort.Slice(annotations, func(i, j int) bool {\r\n   422\t\t\treturn annotations[i].Key < annotations[j].Key\r\n   423\t\t})\r\n"]
[5753.040806, "o", "   424\t\tif annotations == nil {\r\n   425\t\t\tannotations = []*Annotation{}\r\n   426\t\t}\r\n   427\t\treturn annotations, nil\r\n   428\t}\r\n   429\t\r\n   430\t// DeleteAnnotation removes a specific annotation from a model version.\r\n   431\tfunc (r *Registry) DeleteAnnotation(modelName string, versionNum int, key string) error {\r\n"]
[5753.040916, "o", "   432\t\tr.mu.Lock()\r\n   433\t\tdefer r.mu.Unlock()\r\n   434\t\r\n   435\t\tif _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {\r\n   436\t\t\treturn err\r\n   437\t\t}\r\n   438\t\r\n   439\t\tif r.annotations[modelName] == nil || r.annotations[modelName][versionNum] == nil {\r\n   440\t\t\treturn fmt.Errorf(\"annotation %q not found\", key)\r\n   441\t\t}\r\n   442\t\tif _, exists := r.annotations[modelName][versionNum][key]; !exists {\r\n   443\t\t\treturn fmt.Errorf(\"annotation %q not found\", key)\r\n   444\t\t}\r\n"]
[5753.040988, "o", "   445\t\tdelete(r.annotations[modelName][versionNum], key)\r\n   446\t\treturn nil\r\n   447\t}\r\n   448\t\r\n   449\t// AnnotationsMap returns a map of annotation key to value for a model version.\r\n   450\tfunc (r *Registry) AnnotationsMap(modelName string, versionNum int) map[string]string {\r\n   451\t\tr.mu.RLock()\r\n   452\t\tdefer r.mu.RUnlock()\r\n   453\t\r\n   454\t\tresult := make(map[string]string)\r\n"]
[5753.041061, "o", "   455\t\tif versions, ok := r.annotations[modelName]; ok {\r\n   456\t\t\tif keys, ok := versions[versionNum]; ok {\r\n   457\t\t\t\tfor k, a := range keys {\r\n   458\t\t\t\t\tresult[k] = a.Value\r\n   459\t\t\t\t}\r\n   460\t\t\t}\r\n   461\t\t}\r\n   462\t\treturn result\r\n   463\t}\r\n   464\t\r\n   465\t// loadAll reads all model files from the data directory.\r\n"]
