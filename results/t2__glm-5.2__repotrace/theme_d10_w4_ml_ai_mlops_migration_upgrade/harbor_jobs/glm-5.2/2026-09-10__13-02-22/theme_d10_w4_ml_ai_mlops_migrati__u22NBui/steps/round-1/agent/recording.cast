[2192.655054, "o", "\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers) GetModel\u001b[m\u001b[K(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tname := r.PathValue(\"name\")\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t"]
[2192.655133, "o", "model, err := h.Registry.GetModel(name)\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\twriteJSON(w, http.StatusOK, model)\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (h *Handlers) CreateVersion(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmodelName := r.PathValue(\"name\")\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[2192.655208, "o", "\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar req struct {\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tMetrics     map[string]float64     `json:\"metrics\"`\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tTags        []string               `json:\"tags\"`\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tversion, err := h.Registry.CreateVersion(modelName, req.Metrics, req.Tags, req.ModelConfig)\r\n"]
[2192.655271, "o", "\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\twriteJSON(w, http.StatusCreated, version)\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (h *Handlers) GetVersion(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmodelName := r.PathValue(\"name\")\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tnumStr := r.PathValue(\"num\")\r\n"]
[2192.655331, "o", "\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tnum, err := strconv.Atoi(numStr)\r\n\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tversion, err := h.Registry.GetVersion(modelName, num)\r\n\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[2192.655396, "o", "\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\twriteJSON(w, http.StatusOK, version)\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmodelName := r.PathValue(\"name\")\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tnumStr := r.PathValue(\"num\")\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tnum, err := strconv.Atoi(numStr)\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n"]
[2192.655465, "o", "\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K124\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar req struct {\r\n\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tStage string `json:\"stage\"`\r\n\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n"]
[2192.655526, "o", "\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif req.Stage == \"\" {\r\n\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"stage is required\")\r\n\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {\r\n\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\u001b[32m\u001b[K139\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"promoted\"})\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
[2192.655609, "o", "\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// --- Pipeline Handlers ---\r\n\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar req struct {\r\n\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tName     string                 `json:\"name\"`\r\n\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tSteps    []*pipeline.Step       `json:\"steps\"`\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tInput    map[string]interface{} `json:\"input\"`\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tPipeline *pipeline.Pipeline     `json:\"pipeline\"`\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n"]
[2192.655669, "o", "\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tp := req.Pipeline\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif p == nil {\r\n\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tp = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}\r\n\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif p == nil || len(p.Steps) == 0 {\r\n\u001b[32m\u001b[K162\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"pipeline with at least one step is required\")\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[2192.65577, "o", "\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif req.Input == nil {\r\n\u001b[32m\u001b[K166\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treq.Input = make(map[string]interface{})\r\n\u001b[32m\u001b[K167\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[2192.656198, "o", "\u001b[?2004h"]
[2192.656255, "o", "root@n30009:/app# "]
[2198.047278, "i", "sed -n '1,120p' internal/api/templates.go\n"]
[2198.047624, "o", "sed -n '1,120p' internal/api/templates.go\r\n"]
[2198.047711, "o", "\u001b[?2004l\r"]
[2198.050613, "o", "package api\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"net/http\"\r\n"]
[2198.050683, "o", "\t\"regexp\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\t\"time\"\r\n\r\n\t\"gomlops/internal/pipeline\"\r\n)\r\n\r\ntype TemplateParameter struct {\r\n\tName    string      `json:\"name\"`\r\n\tType    string      `json:\"type\"`\r\n\tDefault interface{} `json:\"default,omitempty\"`\r\n"]
[2198.050748, "o", "}\r\n\r\ntype Template struct {\r\n\tName        string              `json:\"name\"`\r\n\tDescription string              `json:\"description\"`\r\n\tParameters  []TemplateParameter `json:\"parameters\"`\r\n\tPipeline    *pipeline.Pipeline  `json:\"pipeline\"`\r\n\tCreatedAt   time.Time           `json:\"created_at\"`\r\n\tUpdatedAt   *time.Time          `json:\"updated_at\"`\r\n}\r\n\r\n"]
[2198.05081, "o", "type TemplateStore struct {\r\n\tmu        sync.RWMutex\r\n\ttemplates map[string]*Template\r\n}\r\n\r\nfunc NewTemplateStore() *TemplateStore {\r\n\treturn &TemplateStore{templates: make(map[string]*Template)}\r\n}\r\n\r\nvar templateNameRe = regexp.MustCompile(`^[a-zA-Z0-9_-]+$`)\r\n\r\n"]
[2198.050911, "o", "func validateTemplateName(name string) bool {\r\n\treturn len(name) > 0 && len(name) <= 64 && templateNameRe.MatchString(name)\r\n}\r\n\r\nfunc (s *TemplateStore) Get(name string) (*Template, bool) {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\tt, ok := s.templates[name]\r\n\treturn t, ok\r\n}\r\n\r\nfunc (s *TemplateStore) List(sortBy string) []*Template {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\tresult := make([]*Template, 0, len(s.templates))\r\n\tfor _, t := range s.templates {\r\n\t\tresult = append(result, t)\r\n"]
[2198.050973, "o", "\t}\r\n\tif sortBy == \"created_at\" {\r\n\t\tsort.Slice(result, func(i, j int) bool {\r\n\t\t\treturn result[i].CreatedAt.Before(result[j].CreatedAt)\r\n\t\t})\r\n\t} else {\r\n\t\tsort.Slice(result, func(i, j int) bool {\r\n\t\t\treturn result[i].Name < result[j].Name\r\n\t\t})\r\n\t}\r\n"]
[2198.051034, "o", "\treturn result\r\n}\r\n\r\nfunc (s *TemplateStore) Create(t *Template) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\tif _, exists := s.templates[t.Name]; exists {\r\n\t\treturn fmt.Errorf(\"template %q already exists\", t.Name)\r\n\t}\r\n"]
[2198.051091, "o", "\tt.CreatedAt = time.Now()\r\n\tt.UpdatedAt = nil\r\n\ts.templates[t.Name] = t\r\n\treturn nil\r\n}\r\n\r\nfunc (s *TemplateStore) Update(t *Template) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\tif _, exists := s.templates[t.Name]; !exists {\r\n"]
