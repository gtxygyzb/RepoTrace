[4680.591596, "i", "il, nil, attempt, true\n\\t\\t\\t}\n\\t\\t} else {\n\\t\\t\\tres := <-resChan\n\\t\\t\\toutput, err = res.output, res.err\n\\t\\t}\n\n\\t\\tif err == nil {\n\\t\\t\\treturn output, nil, attempt, false\n\\t\\t}\n\\t}\n\n\\treturn output, err, maxAttempts - 1, false\n}\n'''\nnew = '''// executeWithRetryAndTimeout runs an executor with optional retry and timeout.\nfunc (e *Engine) executeWithRetryAndTimeout(executor StepExecutor, config, input map[string]interface{}, retry, timeoutMs int) (map[string]interface{}, error, int, bool) {\n\\tmaxAttempts := retry + 1\n\\tif maxAttempts < 1 {\n\\t\\tmaxAttempts = 1\n\\t}\n\n\\tdeadline := time.Time{}\n\\tif timeoutMs > 0 {\n\\t\\tdeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n\\t}\n\n\\tvar output map[string]interface{}\n\\tvar err error\n\\tfor attempt := 0; attempt < maxAttempts; attempt++ {\n\\t\\ttype execResult struct {\n\\t\\t\\toutput map[string]interface{}\n\\t\\t\\terr    error\n\\t\\t}\n\\t\\tresChan := make(chan execResult, 1)\n\\t\\tgo func() {\n\\t\\t\\tout, e := executor(config, input)\n\\t\\t\\tresChan <- execResult{out"]
