[499.868189, "o", "# experiment.go: replace AggregateMetric and fix percentile rank\r\n\u001b[?2004l\r"]
[499.868252, "o", "\u001b[?2004h> "]
[499.868532, "o", "p = Path(\"internal/experiment/experiment.go\")\r\n\u001b[?2004l\r"]
[499.868587, "o", "\u001b[?2004h> "]
[499.868714, "o", "s = p.read_text()\r\n\u001b[?2004l\r"]
[499.868769, "o", "\u001b[?2004h> "]
[499.87881, "o", "replacement = '''func (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, int, error) {\\n\\tt.mu.RLock()\\n\\tdefer t.mu.RUnlock()\\n\\n\\texp, exists := t.experiments[experimentName]\\n\\tif !exists {\\n\\t\\treturn 0, 0, fmt.Errorf(\"experiment %q not found\", experimentName)\\n\\t}\\n\\n\\tif len(exp.Runs) == 0 {\\n\\t\\treturn 0, 0, fmt.Errorf(\"experiment %q has no runs\", experimentName)\\n\\t}\\n\\n\\tvar values []float64\\n\\tvar weights []float64\\n\\tfor _, run := range exp.Runs {\\n\\t\\tvalue, ok := run.Metrics[metricName]\\n\\t\\tif !ok {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tvalues = append(values, value)\\n\\t\\tif aggType == \"weighted_mean\" {\\n\\t\\t\\tweight, ok := run.Parameters[weightParam]\\n\\t\\t\\tif !ok {\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\t}\\n\\t\\t\\tweights = append(weights, weight)\\n\\t\\t}\\n\\t}\\n\\n\\tif len(values) == 0 {\\n\\t\\treturn 0, 0, fmt.Errorf(\"no values found for metric %q\", metricName)\\n\\t}\\n\\n\\tswitch aggType {\\n\\tcase \"mean\":\\n\\t\\tsum := 0.0\\n\\t\\tfor _, v := range values {\\n\\t\\t\\tsum += v\\n\\t\\t}\\n\\t\\"]
[499.878902, "o", "treturn sum / float64(len(values)), len(values), nil\\n\\n\\tcase \"median\":\\n\\t\\tsorted := sortedCopy(values)\\n\\t\\tn := len(sorted)\\n\\t\\tif n%2 == 0 {\\n\\t\\t\\treturn (sorted[n/2-1] + sorted[n/2]) / 2, len(values), nil\\n\\t\\t}\\n\\t\\treturn sorted[n/2], len(values), nil\\n\\n\\tcase \"p95\":\\n\\t\\tsorted := sortedCopy(values)\\n\\t\\treturn percentile(sorted, 0.95), len(values), nil\\n\\n\\tcase \"p99\":\\n\\t\\tsorted := sortedCopy(values)\\n\\t\\treturn percentile(sorted, 0.99), len(values), nil\\n\\n\\tcase \"weighted_mean\":\\n\\t\\tif weightParam == \"\" {\\n\\t\\t\\treturn 0, 0, fmt.Errorf(\"weighted_mean requires weight parameter\")\\n\\t\\t}\\n\\t\\tif len(weights) == 0 {\\n\\t\\t\\treturn 0, 0, fmt.Errorf(\"no runs with metric %q and weight parameter %q\", metricName, weightParam)\\n\\t\\t}\\n\\t\\tif len(weights) != len(values) {\\n\\t\\t\\treturn 0, 0, fmt.Errorf(\"mismatch between metric values and weights\")\\n\\t\\t}\\n\\t\\tweightedSum := 0.0\\n\\t\\tweightSum := 0.0\\n\\t\\tfor i, v := range values {\\n\\t\\t\\tweightedSum += v * weights[i]\\n\\t\\t\\tweightSum += weights[i]\\n\\t\\"]
[499.87896, "o", "t}\\n\\t\\tif weightSum == 0 {\\n\\t\\t\\treturn 0, 0, fmt.Errorf(\"weighted_mean has zero total weight\")\\n\\t\\t}\\n\\t\\treturn weightedSum / weightSum, len(values), nil\\n\\n\\tdefault:\\n\\t\\treturn 0, 0, fmt.Errorf(\"unknown aggregation type %q\", aggType)\\n\\t}\\n}'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[499.879402, "o", "s = re.sub(r'func \\(t \\*Tracker\\) AggregateMetric\\(.*?\\n}\\n\\nfunc percentile', replacement + '\\n\\nfunc percentile', s, flags=re.S)\r\n\u001b[?2004l\r"]
[499.87946, "o", "\u001b[?2004h> "]
[499.879679, "o", "s = s.replace(\"rank := p * float64(n)\", \"rank := p * float64(n-1)\")\r\n\u001b[?2004l\r"]
[499.879734, "o", "\u001b[?2004h> "]
[499.879798, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[499.891757, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # engine.go: merge dependency outputs instead of using lastOutput\r\n\u001b[?2004l\r\u001b[?2004h> p = Path(\"internal/pipeline/engine.go\")\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('\\t\\tvar input map[string]interface{}\\n\\t\\tif len(step.Dependencies) == 0 {\\n\\t\\t\\tinput = initialInput\\n\\t\\t} else {\\n\\t\\t\\tinput = lastOutput\\n\\t\\t}',\r\n\u001b[?2004l\r\u001b[?2004h>               '\\t\\tvar input map[string]interface{}\\n\\t\\tif len(step.Dependencies) == 0 {\\n\\t\\t\\tinput = initialInput\\n\\t\\t} else {\\n\\t\\t\\tinput = mergeDependencyOutputs(step.Dependencies, stepOutputs)\\n\\t\\t}')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('\\tvar lastOutput map[string]interface{}\\n', '')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('\\t\\tstepOutputs[step.Name] = output\\n\\t\\tlastOutput = output\\n', '\\t\\tstepOutputs[step.Name] = output\\n')\r\n\u001b[?2004l\r\u001b[?2004h> if 'mergeDependencyOutputs' not in s:\r\n\u001b[?2004l\r\u001b[?2004h> "]
