[7103.318598, "o", "# --- experiment deletion + leaderboard + summary ---\r\n\u001b[?2004l\r"]
[7103.318665, "o", "\u001b[?2004h> "]
[7103.319001, "o", "p = Path(\"internal/experiment/experiment.go\")\r\n\u001b[?2004l\r"]
[7103.319056, "o", "\u001b[?2004h> "]
[7103.319217, "o", "text = p.read_text()\r\n\u001b[?2004l\r"]
[7103.319285, "o", "\u001b[?2004h> "]
[7103.319619, "o", "start = text.index(\"func (t *Tracker) DeleteRun\")\r\n\u001b[?2004l\r"]
[7103.319675, "o", "\u001b[?2004h> "]
[7103.320001, "o", "end = text.index(\"\\n\\nfunc percentile\", start)\r\n\u001b[?2004l\r"]
[7103.320074, "o", "\u001b[?2004h> "]
[7103.320656, "o", "new_block = '''func (t *Tracker) DeleteRun(experimentName, runID string) (*Run, error) {\r\n\u001b[?2004l\r"]
[7103.32073, "o", "\u001b[?2004h> "]
[7103.320828, "o", "\\tt.mu.Lock()\r\n\u001b[?2004l\r"]
[7103.320917, "o", "\u001b[?2004h> "]
[7103.321062, "o", "\\tdefer t.mu.Unlock()\r\n\u001b[?2004l\r"]
[7103.32113, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.321199, "o", "\u001b[?2004h> "]
[7103.321517, "o", "\\texp, exists := t.experiments[experimentName]\r\n\u001b[?2004l\r"]
[7103.321587, "o", "\u001b[?2004h> "]
[7103.321684, "o", "\\tif !exists {\r\n\u001b[?2004l\r"]
[7103.321742, "o", "\u001b[?2004h> "]
[7103.322242, "o", "\\t\\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\u001b[?2004l\r"]
[7103.322319, "o", "\u001b[?2004h> \\t}\r\n"]
[7103.322386, "o", "\u001b[?2004l\r"]
[7103.322453, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.322695, "o", "\\tfor i, run := range exp.Runs {\r\n\u001b[?2004l\r"]
[7103.322765, "o", "\u001b[?2004h> "]
[7103.322948, "o", "\\t\\tif run.ID == runID {\r\n\u001b[?2004l\r"]
[7103.323033, "o", "\u001b[?2004h> "]
[7103.323214, "o", "\\t\\t\\tdeleted := exp.Runs[i]\r\n\u001b[?2004l\r"]
[7103.323282, "o", "\u001b[?2004h> "]
[7103.323657, "o", "\\t\\t\\texp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)\r\n\u001b[?2004l\r"]
[7103.323728, "o", "\u001b[?2004h> "]
[7103.324079, "o", "\\t\\t\\tif err := t.saveExperiment(exp); err != nil {\r\n\u001b[?2004l\r"]
[7103.324154, "o", "\u001b[?2004h> "]
[7103.324304, "o", "\\t\\t\\t\\treturn nil, err\r\n\u001b[?2004l\r"]
[7103.32437, "o", "\u001b[?2004h> "]
[7103.324433, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[7103.324497, "o", "\u001b[?2004h> "]
[7103.324673, "o", "\\t\\t\\treturn deleted, nil\r\n\u001b[?2004l\r"]
[7103.324744, "o", "\u001b[?2004h> "]
[7103.324809, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.32489, "o", "> \\t}\r\n\u001b[?2004l\r"]
[7103.324958, "o", "\u001b[?2004h> "]
[7103.325504, "o", "\\treturn nil, fmt.Errorf(\"run %q not found in experiment %q\", runID, experimentName)\r\n\u001b[?2004l\r"]
[7103.325574, "o", "\u001b[?2004h"]
[7103.325639, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.325704, "o", "\u001b[?2004h> "]
[7103.326127, "o", "// LeaderboardEntry represents a run in a metric leaderboard.\r\n\u001b[?2004l\r"]
[7103.326197, "o", "\u001b[?2004h> "]
[7103.326398, "o", "type LeaderboardEntry struct {\r\n"]
[7103.326468, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[7103.32678, "o", "\\tRank       int                `json:\"rank\"`\r\n\u001b[?2004l\r"]
[7103.326845, "o", "\u001b[?2004h> "]
[7103.327174, "o", "\\tRunID      string             `json:\"run_id\"`\r\n\u001b[?2004l\r"]
[7103.327235, "o", "\u001b[?2004h> "]
[7103.327558, "o", "\\tValue      float64            `json:\"value\"`\r\n\u001b[?2004l\r"]
[7103.327618, "o", "\u001b[?2004h> "]
[7103.327977, "o", "\\tParameters map[string]float64 `json:\"parameters\"`\r\n\u001b[?2004l\r"]
[7103.328036, "o", "\u001b[?2004h> "]
[7103.328364, "o", "\\tMetrics    map[string]float64 `json:\"metrics\"`\r\n\u001b[?2004l\r"]
[7103.328434, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[7103.3285, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.328565, "o", "\u001b[?2004h> "]
[7103.328954, "o", "// LeaderboardResult contains the top runs for a metric.\r\n\u001b[?2004l\r"]
[7103.329013, "o", "\u001b[?2004h> "]
[7103.32924, "o", "type LeaderboardResult struct {\r\n\u001b[?2004l\r"]
[7103.329302, "o", "\u001b[?2004h> "]
[7103.329658, "o", "\\tExperiment string             `json:\"experiment\"`\r\n\u001b[?2004l\r"]
[7103.329715, "o", "\u001b[?2004h> "]
[7103.330047, "o", "\\tMetric     string             `json:\"metric\"`\r\n\u001b[?2004l\r"]
[7103.330117, "o", "\u001b[?2004h> "]
[7103.330427, "o", "\\tOrder      string             `json:\"order\"`\r\n\u001b[?2004l\r"]
[7103.330483, "o", "\u001b[?2004h> "]
[7103.330711, "o", "\\tEntries    []LeaderboardEntry `json:\"entries\"`\r\n\u001b[?2004l\r"]
[7103.330768, "o", "\u001b[?2004h> "]
[7103.331043, "o", "\\tTotalRuns  int                `json:\"total_runs\"`\r\n\u001b[?2004l\r"]
[7103.331112, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[7103.33117, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.331541, "o", "// Leaderboard returns the top runs for an experiment ranked by a metric.\r\n\u001b[?2004l\r"]
[7103.331598, "o", "\u001b[?2004h> "]
[7103.332144, "o", "func (t *Tracker) Leaderboard(experimentName, metric, order string, limit int) (*LeaderboardResult, error) {\r\n\u001b[?2004l\r"]
[7103.332203, "o", "\u001b[?2004h> "]
[7103.332273, "o", "\\tif order == \"\" {\r\n\u001b[?2004l\r"]
[7103.332329, "o", "\u001b[?2004h> "]
[7103.332417, "o", "\\t\\torder = \"desc\"\r\n\u001b[?2004l\r"]
[7103.332473, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7103.332529, "o", "\u001b[?2004h> "]
[7103.332753, "o", "\\tif order != \"asc\" && order != \"desc\" {\r\n\u001b[?2004l\r"]
[7103.332808, "o", "\u001b[?2004h> "]
[7103.333153, "o", "\\t\\treturn nil, fmt.Errorf(\"order must be \\\\\"asc\\\\\" or \\\\\"desc\\\\\"\")\r\n\u001b[?2004l\r"]
[7103.333209, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7103.333264, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.333319, "o", "\u001b[?2004h> "]
[7103.333376, "o", "\\tt.mu.RLock()\r\n\u001b[?2004l\r"]
[7103.333431, "o", "\u001b[?2004h> "]
[7103.333534, "o", "\\tdefer t.mu.RUnlock()\r\n\u001b[?2004l\r"]
[7103.333589, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h"]
[7103.333644, "o", "> "]
[7103.333882, "o", "\\texp, exists := t.experiments[experimentName]\r\n\u001b[?2004l\r"]
[7103.33394, "o", "\u001b[?2004h> "]
[7103.333998, "o", "\\tif !exists {\r\n\u001b[?2004l\r"]
[7103.334056, "o", "\u001b[?2004h> "]
[7103.334415, "o", "\\t\\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\u001b[?2004l\r"]
[7103.334471, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7103.334526, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.334583, "o", "\u001b[?2004h> "]
[7103.334699, "o", "\\ttype candidate struct {\r\n\u001b[?2004l\r"]
[7103.334755, "o", "\u001b[?2004h> "]
[7103.334827, "o", "\\t\\trun   *Run\r\n\u001b[?2004l\r"]
[7103.334901, "o", "\u001b[?2004h> "]
[7103.334969, "o", "\\t\\tvalue float64\r\n\u001b[?2004l\r"]
[7103.335025, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7103.335079, "o", "\u001b[?2004h> "]
[7103.335222, "o", "\\tvar candidates []candidate\r\n\u001b[?2004l\r"]
[7103.335278, "o", "\u001b[?2004h> "]
[7103.335423, "o", "\\tfor _, run := range exp.Runs {\r\n\u001b[?2004l\r"]
[7103.335478, "o", "\u001b[?2004h> "]
[7103.33558, "o", "\\t\\tif run == nil {\r\n\u001b[?2004l\r"]
[7103.335636, "o", "\u001b[?2004h> "]
[7103.335701, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[7103.335757, "o", "\u001b[?2004h> \\t\\t}\r\n"]
[7103.335813, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[7103.336033, "o", "\\t\\tvalue, ok := run.Metrics[metric]\r\n\u001b[?2004l\r"]
[7103.336091, "o", "\u001b[?2004h> "]
[7103.336157, "o", "\\t\\tif !ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.336213, "o", "> "]
[7103.336267, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[7103.336322, "o", "\u001b[?2004h> \\t\\t}\r\n"]
[7103.336382, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[7103.336756, "o", "\\t\\tcandidates = append(candidates, candidate{run: run, value: value})\r\n\u001b[?2004l\r"]
[7103.336811, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7103.336892, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.337153, "o", "\\tsort.Slice(candidates, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[7103.337209, "o", "\u001b[?2004h> "]
[7103.337459, "o", "\\t\\tif candidates[i].value != candidates[j].value {\r\n\u001b[?2004l\r"]
[7103.337515, "o", "\u001b[?2004h> "]
[7103.337645, "o", "\\t\\t\\tif order == \"desc\" {\r\n\u001b[?2004l\r"]
[7103.33771, "o", "\u001b[?2004h> "]
[7103.338005, "o", "\\t\\t\\t\\treturn candidates[i].value > candidates[j].value\r\n\u001b[?2004l\r"]
[7103.33807, "o", "\u001b[?2004h> "]
[7103.338136, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.338408, "o", "\\t\\t\\treturn candidates[i].value < candidates[j].value\r\n\u001b[?2004l\r"]
[7103.338476, "o", "\u001b[?2004h"]
[7103.338547, "o", "> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.338818, "o", "\\t\\treturn candidates[i].run.ID < candidates[j].run.ID\r\n\u001b[?2004l\r"]
[7103.3389, "o", "\u001b[?2004h> "]
[7103.338965, "o", "\\t})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.339031, "o", "\u001b[?2004h> "]
[7103.339095, "o", "\\tif limit < 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.339164, "o", "> "]
[7103.33922, "o", "\\t\\tlimit = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.339276, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.339332, "o", "> "]
[7103.339469, "o", "\\tif limit > len(candidates) {\r\n\u001b[?2004l\r"]
[7103.339525, "o", "\u001b[?2004h> "]
[7103.339659, "o", "\\t\\tlimit = len(candidates)\r\n\u001b[?2004l\r"]
[7103.339715, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7103.33977, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re"]
[7103.339824, "o", "\u001b[?2004h> "]
[7103.340065, "o", "\\tentries := make([]LeaderboardEntry, 0, limit)\r\n\u001b[?2004l\r"]
[7103.340122, "o", "\u001b[?2004h> "]
[7103.340268, "o", "\\tfor i := 0; i < limit; i++ {\r\n\u001b[?2004l\r"]
[7103.340323, "o", "\u001b[?2004h> "]
[7103.340456, "o", "\\t\\trun := candidates[i].run\r\n\u001b[?2004l\r"]
[7103.340513, "o", "\u001b[?2004h> "]
[7103.340738, "o", "\\t\\tentries = append(entries, LeaderboardEntry{\r\n\u001b[?2004l\r"]
[7103.340795, "o", "\u001b[?2004h> "]
[7103.340872, "o", "\\t\\t\\tRank:       i + 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.340994, "o", "\\t\\t\\tRunID:      run.ID,\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.34105, "o", "> "]
[7103.341148, "o", "\\t\\t\\tValue:      candidates[i].value,\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.341204, "o", "> "]
[7103.34128, "o", "\\t\\t\\tParameters: run.Parameters,\r\n\u001b[?2004l\r"]
[7103.341336, "o", "\u001b[?2004h> "]
[7103.341417, "o", "\\t\\t\\tMetrics:    run.Metrics,\r\n\u001b[?2004l\r"]
[7103.341472, "o", "\u001b[?2004h> \\t\\t})\r\n\u001b[?2004l\r"]
[7103.34153, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.341584, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.341683, "o", "\\treturn &LeaderboardResult{\r\n\u001b[?2004l\r"]
[7103.341738, "o", "\u001b[?2004h> "]
[7103.341819, "o", "\\t\\tExperiment: experimentName,\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.341893, "o", "> "]
[7103.341952, "o", "\\t\\tMetric:     metric,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.342048, "o", "\\t\\tOrder:      order,\r\n\u001b[?2004l\r"]
[7103.342104, "o", "\u001b[?2004h> "]
[7103.34217, "o", "\\t\\tEntries:    entries,\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.342225, "o", "> "]
[7103.342311, "o", "\\t\\tTotalRuns:  len(candidates),\r\n\u001b[?2004l\r"]
[7103.342367, "o", "\u001b[?2004h> \\t}, nil\r\n\u001b[?2004l\r"]
[7103.342422, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.342479, "o", "> \r\n\u001b[?2004l\rl\u001b[?2004h> "]
[7103.342705, "o", "// SummaryResult contains basic statistics for a metric across runs.\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.342761, "o", "> "]
[7103.342829, "o", "type SummaryResult struct {\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.342904, "o", "> "]
[7103.343023, "o", "\\tExperiment string  `json:\"experiment\"`\r\n"]
[7103.343199, "o", "\u001b[?2004l\r"]
[7103.343299, "o", "\u001b[?2004h"]
[7103.343354, "o", "> "]
[7103.343605, "o", "\\tMetric     string  `json:\"metric\"`\r\n\u001b[?2004l\r"]
[7103.343652, "o", "\u001b[?2004h"]
[7103.343709, "o", "> "]
[7103.343939, "o", "\\tCount      int     `json:\"count\"`\r\n\u001b[?2004l\r"]
[7103.344005, "o", "\u001b[?2004h> "]
[7103.344241, "o", "\\tMin        float64 `json:\"min\"`\r\n\u001b[?2004l\r"]
[7103.344322, "o", "\u001b[?2004h> "]
[7103.344534, "o", "\\tMax        float64 `json:\"max\"`\r\n\u001b[?2004l\r"]
[7103.344621, "o", "\u001b[?2004h> "]
[7103.344849, "o", "\\tMean       float64 `json:\"mean\"`\r\n\u001b[?2004l\r"]
[7103.344912, "o", "\u001b[?2004h> "]
[7103.345183, "o", "\\tMedian     float64 `json:\"median\"`\r\n\u001b[?2004l\r"]
[7103.34527, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[7103.345344, "o", "\u001b[?2004h"]
[7103.345415, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.345984, "o", "// Summary computes summary statistics for a metric across all runs in an experiment.\r\n\u001b[?2004l\r"]
[7103.346072, "o", "\u001b[?2004h> "]
[7103.346622, "o", "func (t *Tracker) Summary(experimentName, metric string) (*SummaryResult, error) {\r\n\u001b[?2004l\r"]
[7103.346706, "o", "\u001b[?2004h> "]
[7103.34681, "o", "\\tt.mu.RLock()\r\n\u001b[?2004l\r"]
[7103.346906, "o", "\u001b[?2004h> "]
[7103.347054, "o", "\\tdefer t.mu.RUnlock()\r\n\u001b[?2004l\r"]
[7103.347135, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.347215, "o", "\u001b[?2004h> "]
[7103.347513, "o", "\\texp, exists := t.experiments[experimentName]\r\n\u001b[?2004l\r"]
[7103.347602, "o", "\u001b[?2004h> "]
[7103.34769, "o", "\\tif !exists {\r\n\u001b[?2004l\r"]
[7103.347775, "o", "\u001b[?2004h> "]
[7103.348238, "o", "\\t\\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\u001b[?2004l\r"]
[7103.348306, "o", "\u001b[?2004h> "]
[7103.348366, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.348422, "o", "> \r\n\u001b[?2004l\r"]
[7103.391755, "o", "\u001b[?2004h> \\tvar values []float64\r\n\u001b[?2004l\r\u001b[?2004h> \\tfor _, run := range exp.Runs {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tif run == nil {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tcontinue\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\tif value, ok := run.Metrics[metric]; ok {\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tvalues = append(values, value)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \\tif len(values) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.392047, "o", "\\t\\treturn nil, fmt.Errorf(\"no runs have metric %q\", metric)\r\n\u001b[?2004l\r"]
[7103.392138, "o", "\u001b[?2004h> \\t}\r\n"]
[7103.392228, "o", "\u001b[?2004l\r"]
[7103.392288, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.392442, "o", "\\tsort.Float64s(values)\r\n\u001b[?2004l\r"]
[7103.392529, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.392623, "o", "> "]
[7103.392716, "o", "\\tmin := values[0]\r\n\u001b[?2004l\r"]
[7103.392801, "o", "\u001b[?2004h> "]
[7103.393002, "o", "\\tmax := values[len(values)-1]\r\n\u001b[?2004l\r"]
[7103.393083, "o", "\u001b[?2004h> "]
[7103.393153, "o", "\\tsum := 0.0\r\n"]
[7103.393229, "o", "\u001b[?2004l\r"]
[7103.393303, "o", "\u001b[?2004h> "]
[7103.393426, "o", "\\tfor _, v := range values {\r\n\u001b[?2004l\r"]
[7103.393505, "o", "\u001b[?2004h> "]
[7103.393593, "o", "\\t\\tsum += v\r\n\u001b[?2004l\r"]
[7103.393677, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7103.39371, "o", "\u001b[?2004h> "]
[7103.394004, "o", "\\tmean := sum / float64(len(values))\r\n\u001b[?2004l\r"]
[7103.394062, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.394118, "o", "\u001b[?2004h> "]
[7103.394241, "o", "\\tmedian := 0.0\r\n\u001b[?2004l\r"]
[7103.394311, "o", "\u001b[?2004h> "]
[7103.394429, "o", "\\tn := len(values)\r\n\u001b[?2004l\r"]
[7103.394476, "o", "\u001b[?2004h"]
[7103.394537, "o", "> "]
[7103.394609, "o", "\\tif n%2 == 1 {\r\n\u001b[?2004l\r"]
[7103.394673, "o", "\u001b[?2004h> "]
[7103.394862, "o", "\\t\\tmedian = values[n/2]\r\n\u001b[?2004l\r"]
[7103.394928, "o", "\u001b[?2004h> "]
[7103.395011, "o", "\\t} else {\r\n\u001b[?2004l\r"]
[7103.395074, "o", "\u001b[?2004h> "]
[7103.395404, "o", "\\t\\tmedian = (values[n/2-1] + values[n/2]) / 2.0\r\n\u001b[?2004l\r"]
[7103.395489, "o", "\u001b[?2004h> \\t}\r\n"]
[7103.395579, "o", "\u001b[?2004l\r"]
[7103.395663, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7103.39581, "o", "\\treturn &SummaryResult{\r\n\u001b[?2004l\r"]
[7103.395907, "o", "\u001b[?2004h> "]
[7103.39612, "o", "\\t\\tExperiment: experimentName,\r\n\u001b[?2004l\r"]
[7103.396194, "o", "\u001b[?2004h> "]
[7103.39635, "o", "\\t\\tMetric:     metric,\r\n\u001b[?2004l\r"]
[7103.396421, "o", "\u001b[?2004h> "]
[7103.396549, "o", "\\t\\tCount:      n,\r\n\u001b[?2004l\r"]
[7103.396629, "o", "\u001b[?2004h> "]
[7103.396763, "o", "\\t\\tMin:        min,\r\n\u001b[?2004l\r"]
[7103.396809, "o", "\u001b[?2004h> "]
[7103.396977, "o", "\\t\\tMax:        max,\r\n\u001b[?2004l\r"]
[7103.397044, "o", "\u001b[?2004h> "]
[7103.397189, "o", "\\t\\tMean:       mean,\r\n"]
[7103.397279, "o", "\u001b[?2004l\r\u001b[?2004h"]
[7103.397362, "o", "> "]
[7103.397434, "o", "\\t\\tMedian:     median,\r\n\u001b[?2004l\r"]
[7103.397513, "o", "\u001b[?2004h> "]
[7103.397577, "o", "\\t}, nil\r\n\u001b[?2004l\r"]
[7103.39766, "o", "\u001b[?2004h> }'''\r\n\u001b[?2004l\r"]
[7103.397751, "o", "\u001b[?2004h> "]
[7103.398048, "o", "text = text[:start] + new_block + text[end:]\r\n\u001b[?2004l\r"]
[7103.398134, "o", "\u001b[?2004h> "]
[7103.398247, "o", "p.write_text(text)\r\n\u001b[?2004l\r"]
[7103.39831, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.398364, "o", "\u001b[?2004h> "]
[7103.398604, "o", "# --- serving reload + warmup ---\r\n\u001b[?2004l\r"]
[7103.398673, "o", "\u001b[?2004h> "]
[7103.39894, "o", "p = Path(\"internal/serving/serving.go\")\r\n\u001b[?2004l\r"]
[7103.399011, "o", "\u001b[?2004h> "]
[7103.399155, "o", "text = p.read_text()\r\n\u001b[?2004l\r"]
[7103.399242, "o", "\u001b[?2004h> "]
[7103.399528, "o", "warmup_type = '''type WarmupResult struct {\r\n\u001b[?2004l\r"]
[7103.399608, "o", "\u001b[?2004h> "]
[7103.399863, "o", "\\tStatus     string  `json:\"status\"`\r\n\u001b[?2004l\r"]
[7103.399928, "o", "\u001b[?2004h> "]
[7103.400201, "o", "\\tModelName  string  `json:\"model_name\"`\r\n\u001b[?2004l\r"]
[7103.40025, "o", "\u001b[?2004h> "]
[7103.400566, "o", "\\tVersionNum int     `json:\"version_num\"`\r\n\u001b[?2004l\r"]
[7103.40063, "o", "\u001b[?2004h"]
[7103.400684, "o", "> "]
[7103.400941, "o", "\\tLatencyMs  float64 `json:\"latency_ms\"`\r\n\u001b[?2004l\r"]
[7103.401021, "o", "\u001b[?2004h> }\r\n"]
[7103.40111, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.401192, "o", "\u001b[?2004h> "]
[7103.401616, "o", "// ModelStats tracks inference statistics for a single model.'''\r\n\u001b[?2004l\r"]
[7103.401707, "o", "\u001b[?2004h> "]
[7103.402382, "o", "text = text.replace(\"// ModelStats tracks inference statistics for a single model.\", warmup_type, 1)\r\n\u001b[?2004l\r"]
[7103.402409, "o", "\u001b[?2004h"]
[7103.402543, "o", "> "]
[7103.403017, "o", "methods = '''func (s *Server) ReloadModel(modelName string) (*LoadedModel, error) {\r\n\u001b[?2004l\r"]
[7103.403081, "o", "\u001b[?2004h> "]
[7103.40317, "o", "\\ts.mu.Lock()\r\n\u001b[?2004l\r"]
[7103.403236, "o", "\u001b[?2004h> "]
[7103.403399, "o", "\\tdefer s.mu.Unlock()\r\n\u001b[?2004l\r"]
[7103.403471, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.403554, "o", "\u001b[?2004h> "]
[7103.4038, "o", "\\tloaded, exists := s.loaded[modelName]\r\n\u001b[?2004l\r"]
[7103.40389, "o", "\u001b[?2004h> "]
[7103.403986, "o", "\\tif !exists {\r\n\u001b[?2004l\r"]
[7103.404072, "o", "\u001b[?2004h> "]
[7103.404555, "o", "\\t\\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", modelName)\r\n\u001b[?2004l\r"]
[7103.404624, "o", "\u001b[?2004h> "]
[7103.404679, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.404739, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.404798, "o", "> "]
[7103.405277, "o", "\\tversion, err := s.registry.GetVersion(modelName, loaded.VersionNum)\r\n\u001b[?2004l\r"]
[7103.405344, "o", "\u001b[?2004h> "]
[7103.405468, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[7103.405516, "o", "\u001b[?2004h> "]
[7103.406047, "o", "\\t\\treturn nil, fmt.Errorf(\"version no longer exists in registry: %w\", err)\r\n\u001b[?2004l\r"]
[7103.406099, "o", "\u001b[?2004h> "]
[7103.406158, "o", "\\t}\r\n\u001b[?2004l\r"]
[7103.406215, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.406281, "o", "\u001b[?2004h> "]
[7103.406539, "o", "\\ts.loaded[modelName] = &LoadedModel{\r\n\u001b[?2004l\r"]
[7103.406595, "o", "\u001b[?2004h> "]
[7103.406798, "o", "\\t\\tModelName:   modelName,\r\n\u001b[?2004l\r"]
[7103.406869, "o", "\u001b[?2004h> "]
[7103.407093, "o", "\\t\\tVersionNum:  version.Number,\r\n\u001b[?2004l\r"]
[7103.40715, "o", "\u001b[?2004h> "]
[7103.407373, "o", "\\t\\tStage:       version.Stage,\r\n\u001b[?2004l\r"]
[7103.407439, "o", "\u001b[?2004h> "]
[7103.407699, "o", "\\t\\tModelConfig: version.ModelConfig,\r\n\u001b[?2004l\r"]
[7103.407757, "o", "\u001b[?2004h> "]
[7103.407968, "o", "\\t\\tLoadedAt:    time.Now(),\r\n\u001b[?2004l\r"]
[7103.408019, "o", "\u001b[?2004h> "]
[7103.408069, "o", "\\t}\r\n\u001b[?2004l\r"]
[7103.408123, "o", "\u001b[?2004h> "]
[7103.40836, "o", "\\treturn s.loaded[modelName], nil\r\n\u001b[?2004l\r"]
[7103.408424, "o", "\u001b[?2004h> }\r\n"]
[7103.408479, "o", "\u001b[?2004l\r\u001b[?2004h"]
[7103.408537, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.408597, "o", "> "]
[7103.409054, "o", "func (s *Server) WarmupModel(modelName string) (*WarmupResult, error) {\r\n\u001b[?2004l\r"]
[7103.409125, "o", "\u001b[?2004h> "]
[7103.409269, "o", "\\tstart := time.Now()\r\n\u001b[?2004l\r"]
[7103.409319, "o", "\u001b[?2004h> \r\n"]
[7103.409377, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[7103.409495, "o", "\\ts.mu.RLock()\r\n\u001b[?2004l\r"]
[7103.409559, "o", "\u001b[?2004h> "]
[7103.409834, "o", "\\tloaded, exists := s.loaded[modelName]\r\n\u001b[?2004l\r"]
[7103.409907, "o", "\u001b[?2004h> "]
[7103.409995, "o", "\\ts.mu.RUnlock()\r\n\u001b[?2004l\r"]
[7103.410051, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7103.410107, "o", "\u001b[?2004h> "]
[7103.410166, "o", "\\tif !exists {\r\n\u001b[?2004l\r"]
[7103.410221, "o", "\u001b[?2004h> "]
[7103.410609, "o", "\\t\\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", modelName)\r\n\u001b[?2004l\r"]
[7103.410664, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7103.410723, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7103.410781, "o", "> "]
[7103.411187, "o", "\\tif _, err := computePrediction(loaded.ModelConfig, []float64{0.0}); err != nil {\r\n\u001b[?2004l\r"]
[7103.411245, "o", "\u001b[?2004h> "]
[7103.411519, "o", "\\t\\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n\u001b[?2004l\r"]
[7103.411575, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7103.41163, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h"]
[7103.411685, "o", "> "]
[7103.412019, "o", "\\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n\u001b[?2004l\r"]
[7103.412077, "o", "\u001b[?2004h> "]
[7103.412177, "o", "\\treturn &WarmupResult{\r\n\u001b[?2004l\r"]
[7103.412233, "o", "\u001b[?2004h> "]
[7103.412375, "o", "\\t\\tStatus:     \"warmed_up\",\r\n\u001b[?2004l\r"]
[7103.412431, "o", "\u001b[?2004h> "]
[7103.412562, "o", "\\t\\tModelName:  modelName,\r\n\u001b[?2004l\r"]
[7103.412619, "o", "\u001b[?2004h> "]
[7103.412786, "o", "\\t\\tVersionNum: loaded.VersionNum,\r\n\u001b[?2004l\r"]
[7103.412842, "o", "\u001b[?2004h> "]
[7103.412952, "o", "\\t\\tLatencyMs:  latency,\r\n\u001b[?2004l\r"]
[7103.413008, "o", "\u001b[?2004h> "]
[7103.413064, "o", "\\t}, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[7103.413124, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rm"]
[7103.41318, "o", "\u001b[?2004h> "]
[7103.413598, "o", "// RecordRequest updates serving statistics for a single inference request.'''\r\n\u001b[?2004l\r"]
[7103.413683, "o", "\u001b[?2004h> "]
[7103.414203, "o", "text = text.replace(\"// RecordRequest updates serving statistics for a single inference request.\", methods, 1)\r\n\u001b[?2004l\r"]
[7103.414291, "o", "\u001b[?2004h> "]
[7103.414354, "o", "p.write_text(text)\r\n\u001b[?2004l\r"]
[7103.414441, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
