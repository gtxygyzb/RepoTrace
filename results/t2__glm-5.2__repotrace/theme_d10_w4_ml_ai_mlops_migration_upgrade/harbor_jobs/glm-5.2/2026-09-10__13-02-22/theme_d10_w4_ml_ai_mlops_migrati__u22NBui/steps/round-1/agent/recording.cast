[5636.511221, "o", "   266\t\ttagFilters := map[string]string{}\r\n   267\t\tfor _, filter := range r.URL.Query()[\"tag_filter\"] {\r\n   268\t\t\tparts := strings.SplitN(filter, \":\", 2)\r\n   269\t\t\tif len(parts) != 2 {\r\n   270\t\t\t\twriteError(w, http.StatusBadRequest, \"invalid tag_filter %q, expected key:value\", filter)\r\n   271\t\t\t\treturn\r\n   272\t\t\t}\r\n   273\t\t\ttagFilters[parts[0]] = parts[1]\r\n"]
