[4186.153075, "o", "     8\t\t\"gomlops/internal/registry\"\r\n     9\t)\r\n    10\t\r\n    11\t// LoadedModel tracks a model version currently loaded for serving.\r\n    12\ttype LoadedModel struct {\r\n    13\t\tModelName   string                 `json:\"model_name\"`\r\n    14\t\tVersionNum  int                    `json:\"version_num\"`\r\n    15\t\tStage       registry.Stage         `json:\"stage\"`\r\n    16\t\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n    17\t\tLoadedAt    time.Time              `json:\"loaded_at\"`\r\n    18\t}\r\n    19\t\r\n    20\t// InferenceRequest contains the input data for model inference.\r\n"]
[4186.153148, "o", "    21\ttype InferenceRequest struct {\r\n    22\t\tModelName string    `json:\"model_name\"`\r\n    23\t\tInput     []float64 `json:\"input\"`\r\n    24\t}\r\n    25\t\r\n"]
[4186.153217, "o", "    26\t// InferenceResponse contains the model prediction results.\r\n    27\ttype InferenceResponse struct {\r\n    28\t\tModelName   string    `json:\"model_name\"`\r\n    29\t\tVersion     int       `json:\"version\"`\r\n    30\t\tPredictions []float64 `json:\"predictions\"`\r\n    31\t\tLatencyMs   float64   `json:\"latency_ms\"`\r\n    32\t}\r\n    33\t\r\n    34\t// ModelStats tracks inference statistics for a single model.\r\n    35\ttype ModelStats struct {\r\n    36\t\tRequests   int     `json:\"requests\"`\r\n    37\t\tSuccessful int     `json:\"successful\"`\r\n    38\t\tFailed     int     `json:\"failed\"`\r\n    39\t\tLatencySum float64 `json:\"-\"`\r\n    40\t}\r\n    41\t\r\n    42"]
[4186.153279, "o", "\t// Stats tracks accumulated serving statistics.\r\n    43\ttype Stats struct {\r\n    44\t\tTotalRequests int\r\n    45\t\tSuccessful    int\r\n    46\t\tFailed        int\r\n    47\t\tLatencySum    float64\r\n    48\t\tModels        map[string]*ModelStats\r\n    49\t}\r\n    50\t\r\n    51\t// StatsResponse is the public serving statistics representation.\r\n    52\ttype StatsResponse struct {\r\n"]
[4186.153342, "o", "    53\t\tTotalRequests int                           `json:\"total_requests\"`\r\n    54\t\tSuccessful    int                           `json:\"successful\"`\r\n    55\t\tFailed        int                           `json:\"failed\"`\r\n    56\t\tAvgLatencyMs  float64                       `json:\"avg_latency_ms\"`\r\n    57\t\tModels        map[string]ModelStatsResponse `json:\"models\"`\r\n    58\t}\r\n    59\t\r\n    60\t// ModelStatsResponse is the public model statistics representation.\r\n    61\ttype ModelStatsResponse struct {\r\n    62\t\tRequests     int     `json:\"requests\"`\r\n"]
[4186.153401, "o", "    63\t\tSuccessful   int     `json:\"successful\"`\r\n    64\t\tFailed       int     `json:\"failed\"`\r\n    65\t\tAvgLatencyMs float64 `json:\"avg_latency_ms\"`\r\n    66\t}\r\n    67\t\r\n    68\t// Server manages model loading and inference.\r\n    69\ttype Server struct {\r\n    70\t\tmu       sync.RWMutex\r\n    71\t\tloaded   map[string]*LoadedModel\r\n    72\t\t"]
[4186.153462, "o", "registry *registry.Registry\r\n    73\t\tstats    Stats\r\n    74\t}\r\n    75\t\r\n    76\t// NewServer creates a new serving server backed by the given registry.\r\n    77\tfunc NewServer(reg *registry.Registry) *Server {\r\n    78\t\treturn &Server{\r\n    79\t\t\tloaded:   make(map[string]*LoadedModel),\r\n    80\t\t\tregistry: reg,\r\n    81\t\t\tstats: Stats{\r\n    82\t"]
[4186.153519, "o", "\t\t\tModels: make(map[string]*ModelStats),\r\n    83\t\t\t},\r\n    84\t\t}\r\n    85\t}\r\n    86\t\r\n    87\t// LoadModel loads a model version for serving. Specify either versionNum > 0\r\n    88\t// or a non-empty stage string (not both).\r\n    89\tfunc (s *Server) LoadModel(modelName string, versionNum int, stage string) error {\r\n    90\t\tvar version *registry.Version\r\n"]
[4186.153581, "o", "    91\t\tvar err error\r\n    92\t\r\n    93\t\tif versionNum > 0 {\r\n    94\t\t\tversion, err = s.registry.GetVersion(modelName, versionNum)\r\n    95\t\t} else if stage != \"\" {\r\n    96\t\t\tversion, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))\r\n    97\t\t} else {\r\n    98\t\t\treturn fmt.Errorf(\"must specify version number or stage\")\r\n"]
[4186.153637, "o", "    99\t\t}\r\n   100\t\r\n   101\t\tif err != nil {\r\n   102\t\t\treturn fmt.Errorf(\"load model: %w\", err)\r\n   103\t\t}\r\n   104\t\r\n   105\t\ts.mu.Lock()\r\n   106\t\tdefer s.mu.Unlock()\r\n   107\t\r\n"]
[4186.153698, "o", "   108\t\ts.loaded[modelName] = &LoadedModel{\r\n   109\t\t\tModelName:   modelName,\r\n   110\t\t\tVersionNum:  version.Number,\r\n   111\t\t\tStage:       version.Stage,\r\n   112\t\t\tModelConfig: version.ModelConfig,\r\n   113\t\t\tLoadedAt:    time.Now(),\r\n   114\t\t}\r\n   115\t\treturn nil\r\n   116\t}\r\n   117\t\r\n"]
[4186.153758, "o", "   118\t// UnloadModel removes a model from the serving cache.\r\n   119\tfunc (s *Server) UnloadModel(modelName string) error {\r\n   120\t\ts.mu.Lock()\r\n"]
