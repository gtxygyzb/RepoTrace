[6472.25288, "o", "func (h *Handlers) ValidatePipeline(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tName     string                 `json:\"name\"`\r\n"]
[6472.252989, "o", "\t\tSteps    []*pipeline.Step       `json:\"steps\"`\r\n\t\tInput    map[string]interface{} `json:\"input\"`\r\n\t\tPipeline *pipeline.Pipeline     `json:\"pipeline\"`\r\n\t}\r\n"]
[6472.253057, "o", "\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tp := req.Pipeline\r\n\tif p == nil {\r\n\t\tp = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}\r\n\t}\r\n\r\n\tresult := h.Pipeline.Validate(p)\r\n\twriteJSON(w, http.StatusOK, result)\r\n}\r\n\r\n// --- Serving Statistics Handlers ---\r\n\r\nfunc (h *Handlers) ServingStats(w http.ResponseWriter, r *http.Request) {\r\n\twriteJSON(w, http.StatusOK, h.Serving.GetStats())\r\n}\r\n\r\nfunc (h *Handlers) ResetServingStats(w http.ResponseWriter, r *http.Request) {\r\n\th.Serving.ResetStats()\r\n"]
