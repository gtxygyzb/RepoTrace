[5746.385947, "o", "     6\t\t\"gomlops/internal/experiment\"\r\n     7\t\t\"gomlops/internal/pipeline\"\r\n     8\t\t\"gomlops/internal/registry\"\r\n     9\t\t\"gomlops/internal/serving\"\r\n    10\t)\r\n    11\t\r\n    12\t// Handlers holds references to all service components.\r\n    13\ttype Handlers struct {\r\n    14\t\tRegistry   *registry.Registry\r\n    15\t\tPipeline   *pipeline.Engine\r\n"]
[5746.386019, "o", "    16\t\tExperiment *experiment.Tracker\r\n    17\t\tServing    *serving.Server\r\n    18\t\tTemplates  *TemplateStore\r\n    19\t}\r\n    20\t\r\n    21\t// NewRouter builds the HTTP route table and returns a handler.\r\n    22\tfunc NewRouter(reg *registry.Registry, eng *pipeline.Engine, tracker *experiment.Tracker, srv *serving.Server) http.Handler {\r\n    23\t\th := &Handlers{\r\n    24\t\t\tRegistry:   reg,\r\n    25\t\t\tPipeline:   eng,\r\n"]
[5746.386086, "o", "    26\t\t\tExperiment: tracker,\r\n    27\t\t\tServing:    srv,\r\n    28\t\t\tTemplates:  NewTemplateStore(),\r\n    29\t\t}\r\n    30\t\r\n    31\t\tmux := http.NewServeMux()\r\n    32\t\r\n    33\t\t// Model registry endpoints\r\n    34\t\tmux.HandleFunc(\"POST /api/v1/models\", h.RegisterModel)\r\n    35"]
[5746.38615, "o", "\t\tmux.HandleFunc(\"GET /api/v1/models\", h.ListModels)\r\n    36\t\tmux.HandleFunc(\"GET /api/v1/models/{name}\", h.GetModel)\r\n    37\t\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions\", h.CreateVersion)\r\n    38\t\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions\", h.ListModelVersions)\r\n    39\t\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/compare\", h.CompareVersionMetrics)\r\n    40\t\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}\", h.GetVersion)\r\n    41\t\tmux.HandleFunc(\"PUT /api/v1/models/{name}/versions/{num}/promote\", h.PromoteVersion)\r\n    42\t\tmux.HandleFunc(\"GET /api/v1/models/{name}/lineage\", h.ModelLineage)\r\n    43\t\tmux.HandleFunc(\"POST /api/v1/models/{name}/dependencies\", h.DeclareDependencies)\r\n    44"]
[5746.386216, "o", "\t\tmux.HandleFunc(\"GET /api/v1/models/{name}/dependencies\", h.GetDependencies)\r\n    45\t\tmux.HandleFunc(\"DELETE /api/v1/models/{name}/dependencies/{dep}\", h.RemoveDependency)\r\n    46\t\tmux.HandleFunc(\"DELETE /api/v1/models/{name}\", h.DeleteModel)\r\n    47\t\r\n    48\t\t// Model version annotations\r\n    49\t\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions/{num}/annotations\", h.AddAnnotation)\r\n    50\t\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}/annotations\", h.ListAnnotations)\r\n    51\t\tmux.HandleFunc(\"DELETE /api/v1/models/{name}/versions/{num}/annotations/{key}\", h.DeleteAnnotation)\r\n    52\t\r\n    53\t\t// Pipeline endpoints\r\n"]
