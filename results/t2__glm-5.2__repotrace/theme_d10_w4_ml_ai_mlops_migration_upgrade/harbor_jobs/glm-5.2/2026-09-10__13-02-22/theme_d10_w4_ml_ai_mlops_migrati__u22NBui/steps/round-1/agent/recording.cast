[3947.386199, "o", "     6\t\t\"net/http\"\r\n     7\t\t\"sort\"\r\n     8\t\t\"strconv\"\r\n     9\t\t\"strings\"\r\n    10\t\r\n    11\t\t\"gomlops/internal/experiment\"\r\n    12\t\t\"gomlops/internal/pipeline\"\r\n    13\t\t\"gomlops/internal/registry\"\r\n    14\t\t\"gomlops/internal/serving\"\r\n    15\t)\r\n    16\t\r\n    17\t// --- Model Registry Handlers ---\r\n    18\t\r\n"]
[3947.386287, "o", "    19\tfunc (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {\r\n    20\t\tvar req struct {\r\n    21\t\t\tName        string   `json:\"name\"`\r\n    22\t\t\tFramework   string   `json:\"framework\"`\r\n    23\t\t\tDescription string   `json:\"description\"`\r\n    24\t\t\tTags        []string `json:\"tags\"`\r\n    25\t\t}\r\n"]
[3947.386358, "o", "    26\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n    27\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n    28\t\t\treturn\r\n    29\t\t}\r\n    30\t\tif req.Name == \"\" {\r\n    31\t\t\twriteError(w, http.StatusBadRequest, \"name is required\")\r\n    32\t\t\treturn\r\n    33\t\t}\r\n    34\t\r\n    35\t\tmodel, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)\r\n    36"]
[3947.38642, "o", "\t\tif err != nil {\r\n    37\t\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n    38\t\t\treturn\r\n    39\t\t}\r\n    40\t\twriteJSON(w, http.StatusCreated, model)\r\n    41\t}\r\n    42\t\r\n    43\tfunc (h *Handlers) ListModels(w http.ResponseWriter, r *http.Request) {\r\n    44\t\tvar filter *registry.ModelFilter\r\n    45\t\tframework := r.URL.Query().Get(\"framework\")\r\n    46\t\ttag := r.URL.Query().Get(\"tag\")\r\n"]
[3947.386481, "o", "    47\t\tif framework != \"\" || tag != \"\" {\r\n    48\t\t\tfilter = &registry.ModelFilter{Framework: framework, Tag: tag}\r\n    49\t\t}\r\n    50\t\r\n    51\t\tmodels, err := h.Registry.ListModels(filter)\r\n    52\t\tif err != nil {\r\n    53\t\t\twriteError(w, http.StatusInternalServerError, \"%v\", err)\r\n    54\t\t\treturn\r\n    55\t\t}\r\n    56\t\twriteJSON(w, http.StatusOK, models)\r\n"]
[3947.38654, "o", "    57\t}\r\n    58\t\r\n    59\tfunc (h *Handlers) DeleteModel(w http.ResponseWriter, r *http.Request) {\r\n    60\t\tname := r.PathValue(\"name\")\r\n    61\t\tif err := h.Registry.DeleteModel(name); err != nil {\r\n    62\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n    63\t\t\treturn\r\n"]
[3947.386603, "o", "    64\t\t}\r\n    65\t\t_ = h.Serving.UnloadModel(name)\r\n    66\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n    67\t}\r\n    68\t\r\n    69\tfunc (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {\r\n    70\t\tname := r.PathValue(\"name\")\r\n    71\t\tmodel, err := h.Registry.GetModel(name)\r\n    72\t\tif err != nil {\r\n    73\t\t\t"]
[3947.386665, "o", "writeError(w, http.StatusNotFound, \"%v\", err)\r\n    74\t\t\treturn\r\n    75\t\t}\r\n    76\t\tstageSummary := map[string]int{\r\n    77\t\t\t\"development\": 0,\r\n    78\t\t\t\"staging\":     0,\r\n    79\t\t\t\"production\":  0,\r\n"]
[3947.38673, "o", "    80\t\t\t\"archived\":    0,\r\n    81\t\t}\r\n    82\t\tfor _, v := range model.Versions {\r\n    83\t\t\tstageSummary[string(v.Stage)]++\r\n    84\t\t}\r\n    85\t\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n    86\t\t\t\"name\":          model.Name,\r\n    87\t\t\t\"framework\":     model.Framework,\r\n    88\t\t\t\"description\":   model.Description,\r\n    89\t\t\t\"tags\":          model.Tags,\r\n    90"]
[3947.386794, "o", "\t\t\t\"versions\":      model.Versions,\r\n    91\t\t\t\"created_at\":    model.CreatedAt,\r\n    92\t\t\t\"updated_at\":    model.UpdatedAt,\r\n    93\t\t\t\"stage_summary\": stageSummary,\r\n    94\t\t})\r\n    95\t}\r\n    96\t\r\n    97\tfunc (h *Handlers) CreateVersion(w http.ResponseWriter, r *http.Request) {\r\n"]
[3947.386862, "o", "    98\t\tmodelName := r.PathValue(\"name\")\r\n    99\t\r\n   100\t\tvar req struct {\r\n   101\t\t\tMetrics     map[string]float64     `json:\"metrics\"`\r\n   102\t\t\tTags        []string               `json:\"tags\"`\r\n   103\t\t\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n   104\t\t}\r\n   105\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n   106\t\t\t"]
[3947.386929, "o", "writeError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n   107\t\t\treturn\r\n   108\t\t}\r\n   109\t\r\n   110\t\tversion, err := h.Registry.CreateVersion(modelName, req.Metrics, req.Tags, req.ModelConfig)\r\n   111\t\tif err != nil {\r\n   112\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   113\t\t\treturn\r\n"]
[3947.386991, "o", "   114\t\t}\r\n   115\t\twriteJSON(w, http.StatusCreated, version)\r\n   116\t}\r\n   117\t\r\n   118\tfunc (h *Handlers) GetVersion(w http.ResponseWriter, r *http.Request) {\r\n   119\t\tmodelName := r.PathValue(\"name\")\r\n   120\t\tnumStr := r.PathValue(\"num\")\r\n   121\t\tnum, err := strconv.Atoi(numStr)\r\n   122\t"]
[3947.387056, "o", "\tif err != nil {\r\n   123\t\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n   124\t\t\treturn\r\n   125\t\t}\r\n   126\t\r\n   127\t\tversion, err := h.Registry.GetVersion(modelName, num)\r\n   128\t\t"]
[3947.38712, "o", "if err != nil {\r\n   129\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   130\t\t\treturn\r\n   131\t\t}\r\n   132\t\twriteJSON(w, http.StatusOK, struct {\r\n   133\t\t\t*registry.Version\r\n   134\t\t\tAnnotations map[string]string `json:\"annotations\"`\r\n   135\t\t}{\r\n   136\t\t\tVersion:     version,\r\n   137\t\t\tAnnotations: h.Registry.AnnotationsMap(modelName, num),\r\n   138\t\t})\r\n   139\t}\r\n   140\t\r\n"]
[3947.38718, "o", "   141\tfunc (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {\r\n   142\t\tmodelName := r.PathValue(\"name\")\r\n   143\t\tnumStr := r.PathValue(\"num\")\r\n   144\t\tnum, err := strconv.Atoi(numStr)\r\n   145\t\tif err != nil {\r\n   146\t\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n   147\t\t\treturn\r\n   148\t\t}\r\n   149\t\r\n   150\t\t"]
[3947.387242, "o", "var req struct {\r\n   151\t\t\tStage string `json:\"stage\"`\r\n   152\t\t}\r\n   153\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n   154\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n   155\t\t\treturn\r\n   156\t\t}\r\n   157\t\tif req.Stage == \"\" {\r\n"]
[3947.387304, "o", "   158\t\t\twriteError(w, http.StatusBadRequest, \"stage is required\")\r\n   159\t\t\treturn\r\n   160\t\t}\r\n   161\t\r\n   162\t\tif err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {\r\n   163\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n   164\t\t\treturn\r\n   165\t\t}\r\n   166\t\t"]
