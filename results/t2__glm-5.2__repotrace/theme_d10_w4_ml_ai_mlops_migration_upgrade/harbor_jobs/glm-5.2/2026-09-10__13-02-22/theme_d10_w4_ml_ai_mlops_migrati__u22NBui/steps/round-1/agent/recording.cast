[3966.014784, "o", "     1\tpackage api\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"net/http\"\r\n     5\t\r\n     6\t\t\"gomlops/internal/experiment\"\r\n"]
[3966.014923, "o", "     7\t\t\"gomlops/internal/pipeline\"\r\n     8\t\t\"gomlops/internal/registry\"\r\n     9\t\t\"gomlops/internal/serving\"\r\n    10\t)\r\n    11\t\r\n    12\t// Handlers holds references to all service components.\r\n    13\ttype Handlers struct {\r\n    14\t\tRegistry   *registry.Registry\r\n    15\t\tPipeline   *pipeline.Engine\r\n    16\t\tExperiment *experiment.Tracker\r\n    17\t\tServing    *serving.Server\r\n    18\t\tTemplates  *TemplateStore\r\n    19\t}\r\n    20\t\r\n    21\t// NewRouter builds the HTTP route table and returns a handler.\r\n    22\tfunc NewRouter(reg *registry.Registry, eng *pipeline.Engine, tracker *experiment.Tracker, srv *serving.Server) http.Handler {\r\n    23\t\th := &Handlers{\r\n    24\t\t\tRegistry:   reg,\r\n"]
[3966.015016, "o", "    25\t\t\tPipeline:   eng,\r\n    26\t\t\tExperiment: tracker,\r\n    27\t\t\tServing:    srv,\r\n    28\t\t\tTemplates:  NewTemplateStore(),\r\n    29\t\t}\r\n    30\t\r\n    31\t\tmux := http.NewServeMux()\r\n    32\t\r\n    33\t\t// Model registry endpoints\r\n    34\t\tmux.HandleFunc(\"POST /api/v1/models\", h.RegisterModel)\r\n    35\t\tmux.HandleFunc(\"GET /api/v1/models\", h.ListModels)\r\n    36\t\tmux.HandleFunc(\"GET /api/v1/models/{name}\", h.GetModel)\r\n    37\t\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions\", h.CreateVersion)\r\n"]
[3966.01511, "o", "    38\t\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/compare\", h.CompareVersionMetrics)\r\n    39\t\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}\", h.GetVersion)\r\n    40\t\tmux.HandleFunc(\"PUT /api/v1/models/{name}/versions/{num}/promote\", h.PromoteVersion)\r\n    41\t\tmux.HandleFunc(\"DELETE /api/v1/models/{name}\", h.DeleteModel)\r\n    42\t\r\n    43\t\t// Model version annotations\r\n    44\t\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions/{num}/annotations\", h.AddAnnotation)\r\n    45\t\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}/annotations\", h.ListAnnotations)\r\n    46\t\tmux.HandleFunc(\"DELETE /api/v1/models/{name}/versions/{num}/annotations/{key}\", h.DeleteAnnotation)\r\n    47\t\r\n    48\t\t// Pipeline endpoints\r\n    49\t\tmux.HandleFunc(\"POST /api/v1/pipelines/validate\", h.ValidatePipeline)\r\n    50\t\tmux.HandleFunc(\"POST /api/v1/pipelines/execute\", h.ExecutePipeline)\r\n"]
[3966.015199, "o", "    51\t\tmux.HandleFunc(\"POST /api/v1/pipelines/templates\", h.CreateTemplate)\r\n    52\t\tmux.HandleFunc(\"GET /api/v1/pipelines/templates\", h.ListTemplates)\r\n    53\t\tmux.HandleFunc(\"GET /api/v1/pipelines/templates/{name}\", h.GetTemplate)\r\n    54\t\tmux.HandleFunc(\"PUT /api/v1/pipelines/templates/{name}\", h.UpdateTemplate)\r\n    55\t\tmux.HandleFunc(\"DELETE /api/v1/pipelines/templates/{name}\", h.DeleteTemplate)\r\n    56\t\tmux.HandleFunc(\"POST /api/v1/pipelines/templates/{name}/execute\", h.ExecuteTemplate)\r\n    57\t\r\n    58\t\t// Experiment endpoints\r\n    59\t\tmux.HandleFunc(\"POST /api/v1/experiments\", h.CreateExperiment)\r\n    60\t\tmux.HandleFunc(\"GET /api/v1/experiments\", h.ListExperiments)\r\n    61\t\tmux.HandleFunc(\"GET /api/v1/experiments/{name}\", h.GetExperiment)\r\n    62\t\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs\", h.LogRun)\r\n    63\t\tmux.HandleFunc(\"DELETE /api/v1/experiments/{name}/runs/{id}\", h.DeleteRun)\r\n    64"]
[3966.015324, "o", "\t\tmux.HandleFunc(\"GET /api/v1/experiments/compare\", h.CompareExperiments)\r\n    65\t\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/aggregate\", h.AggregateMetric)\r\n    66\t\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/history\", h.GetMetricHistory)\r\n    67\t\tmux.HandleFunc(\"PUT /api/v1/experiments/{name}/runs/{id}\", h.UpdateRun)\r\n    68\t\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs/search\", h.SearchRuns)\r\n    69\t\r\n    70\t"]
[3966.015411, "o", "\t// Serving endpoints\r\n    71\t\tmux.HandleFunc(\"POST /api/v1/serving/load\", h.LoadModel)\r\n    72\t\tmux.HandleFunc(\"DELETE /api/v1/serving/models/{name}\", h.UnloadModel)\r\n    73\t\tmux.HandleFunc(\"GET /api/v1/serving/models\", h.ListLoadedModels)\r\n    74\t\tmux.HandleFunc(\"POST /api/v1/serving/infer\", h.Infer)\r\n    75\t\tmux.HandleFunc(\"POST /api/v1/serving/batch\", h.BatchInfer)\r\n    76\t\tmux.HandleFunc(\"GET /api/v1/serving/stats\", h.ServingStats)\r\n    77\t\tmux.HandleFunc(\"POST /api/v1/serving/stats/reset\", h.ResetServingStats)\r\n    78\t\r\n    79\t\t// Health check\r\n    80\t\tmux.HandleFunc(\"GET /health\", func(w http.ResponseWriter, r *http.Request) {\r\n    81\t\t\tw.WriteHeader(http.StatusOK)\r\n    82\t\t\tw.Write([]byte(`{\"status\":\"ok\"}`))\r\n    83\t\t})\r\n    84\t\r\n    85\t\treturn mux\r\n    86\t}\r\n"]
