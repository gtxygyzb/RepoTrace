[3717.116125, "o", "   255\t\t\t\t\tStepType:   step.Type,\r\n   256\t\t\t\t\tStatus:     \"failed\",\r\n   257\t\t\t\t\tError:      fmt.Sprintf(\"unknown step type: %s\", step.Type),\r\n   258\t\t\t\t\tDurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\r\n   259\t\t\t\t}\r\n"]
[3717.116231, "o", "   260\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   261\t\t\t\tresult.Status = \"failed\"\r\n   262\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   263\t\t\t\treturn result, nil\r\n   264\t\t\t}\r\n   265\t\r\n   266\t\t\toutput, err := executor(resolvedConfig, input)\r\n   267\t\t\tduration := float64(time.Since(stepStart).Microseconds()) / 1000.0\r\n   268\t\r\n   269\t\t\tsr := &StepResult{\r\n   270\t\t\t\tStepName:   step.Name,\r\n   271\t\t\t\tStepType:   step.Type,\r\n   272\t\t\t\tDurationMs: duration,\r\n   273\t\t\t}\r\n   274\t\r\n   275\t\t\tif err != nil {\r\n"]
[3717.116309, "o", "   276\t\t\t\tsr.Status = \"failed\"\r\n   277\t\t\t\tsr.Error = err.Error()\r\n   278\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   279\t\t\t\tresult.Status = \"failed\"\r\n   280\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n"]
[3717.116378, "o", "   281\t\t\t\treturn result, nil\r\n   282\t\t\t}\r\n   283\t\r\n   284\t\t\tif step.OutputTransform != \"\" && (step.Type == StepTransform || step.Type == StepFilter) {\r\n   285\t\t\t\ttransformed, terr := applyOutputTransform(output, resolvedConfig, step.OutputTransform)\r\n   286\t\t\t\tif terr != nil {\r\n   287\t\t\t\t\tsr.Status = \"failed\"\r\n   288\t\t\t\t\tsr.Error = terr.Error()\r\n   289\t\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   290\t\t\t\t\tresult.Status = \"failed\"\r\n   291\t\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   292\t\t\t\t\treturn result, nil\r\n   293\t\t\t\t}\r\n   294\t\t\t\toutput = transformed\r\n"]
[3717.116439, "o", "   295\t\t\t}\r\n   296\t\r\n   297\t\t\tif len(step.SetVars) > 0 {\r\n   298\t\t\t\tif verr := setVariables(output, step.SetVars, variables, variableSetter, step.Name); verr != nil {\r\n   299\t\t\t\t\tsr.Status = \"failed\"\r\n   300\t\t\t\t\tsr.Error = verr.Error()\r\n   301\t\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   302\t\t\t\t\tresult.Status = \"failed\"\r\n"]
