[3948.259906, "o", "   228\t\tfor _, model := range r.models {\r\n   229\t\t\tif filter != nil {\r\n   230\t\t\t\tif filter.Framework != \"\" && model.Framework != filter.Framework {\r\n   231\t\t\t\t\tcontinue\r\n   232\t\t\t\t}\r\n   233\t\t\t\tif filter.Tag != \"\" {\r\n   234\t\t\t\t\thasTag := false\r\n   235\t\t\t\t\tfor _, t := range model.Tags {\r\n   236\t\t\t\t\t\tif t == filter.Tag {\r\n   237\t\t\t\t\t\t\thasTag = true\r\n   238\t\t\t\t\t\t\tbreak\r\n   239\t\t\t\t\t\t}\r\n   240\t\t\t\t\t}\r\n   241\t\t\t\t\tif !hasTag {\r\n   242\t\t\t\t\t\tcontinue\r\n   243\t\t\t\t\t}\r\n   244\t\t\t\t}\r\n"]
[3948.259986, "o", "   245\t\t\t}\r\n   246\t\t\tresult = append(result, model)\r\n   247\t\t}\r\n"]
[3948.260055, "o", "   248\t\tsort.Slice(result, func(i, j int) bool {\r\n   249\t\t\treturn result[i].Name < result[j].Name\r\n   250\t\t})\r\n   251\t\treturn result, nil\r\n   252\t}\r\n   253\t\r\n   254\t// DeleteModel removes a model from the registry.\r\n   255\tfunc (r *Registry) DeleteModel(name string) error {\r\n   256\t\tr.mu.Lock()\r\n   257\t\tdefer r.mu.Unlock()\r\n   258\t\r\n   259\t\tif _, exists := r.models[name]; !exists {\r\n"]
[3948.26012, "o", "   260\t\t\treturn fmt.Errorf(\"model %q not found\", name)\r\n   261\t\t}\r\n   262\t\r\n   263\t\tdelete(r.models, name)\r\n   264\t\tfilename := filepath.Join(r.dataDir, name+\".json\")\r\n   265\t\tos.Remove(filename)\r\n   266\t\treturn nil\r\n   267\t}\r\n"]
