[6505.423824, "o", "   479\t\tvar req struct {\r\n   480\t\t\tModelName  string `json:\"model_name\"`\r\n   481\t\t\tVersionNum int    `json:\"version_num\"`\r\n   482\t\t\tStage      string `json:\"stage\"`\r\n   483\t\t}\r\n   484\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n   485\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n   486\t\t\treturn\r\n   487\t\t}\r\n   488\t\tif req.ModelName == \"\" {\r\n   489\t\t\twriteError(w, http.StatusBadRequest, \"model_name is required\")\r\n   490\t\t\treturn\r\n   491\t\t}\r\n   492\t\r\n   493\t\tif err := h.Serving.LoadModel(req.ModelName, req.VersionNum, req.Stage); err != nil {\r\n   494\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n   495\t\t\treturn\r\n   496\t\t}\r\n   497\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"loaded\"})\r\n   498\t}\r\n   499\t\r\n   500\tfunc (h *Handlers) UnloadModel(w http.ResponseWriter, r *http.Request) {\r\n   501\t\tname := r.PathValue(\"name\")\r\n"]
