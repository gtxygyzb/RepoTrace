[5997.788957, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('internal/experiment/experiment.go')\ns = p.read_text()\n\nold = '''// MetricHistory returns chronological values of a metric across all runs in an experiment.\n'''\nnew = '''// CorrelationResult contains the Pearson correlation coefficient between two metrics.\ntype CorrelationResult struct {\n\\tExperiment string  `json:\"experiment\"`\n\\tMetricX    string  `json:\"metric_x\"`\n\\tMetricY    string  `json:\"metric_y\"`\n\\tR          float64 `json:\"r\"`\n\\tCount      int     `json:\"count\"`\n}\n\n// Correlation computes the Pearson correlation coefficient between two metrics\n// across all runs that have both metrics.\nfunc (t *Tracker) Correlation(experimentName, metricX, metricY string) (*CorrelationResult, error) {\n\\tt.mu.RLock()\n\\tdefer t.mu.RUnlock()\n\n\\texp, exists := t.experiments[experimentName]\n\\tif !exists {\n\\t\\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\n\\t}\n\n\\tvar xs []float64\n\\tvar ys []float64\n\\tfor _, run := range exp.Runs {\n\\t\\tx, ok1 := run.Metr"]
[5997.789189, "i", "ics[metricX]\n\\t\\ty, ok2 := run.Metrics[metricY]\n\\t\\tif !ok1 || !ok2 {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\txs = append(xs, x)\n\\t\\tys = append(ys, y)\n\\t}\n\n\\tif len(xs) < 2 {\n\\t\\treturn nil, fmt.Errorf(\"at least 2 runs with both metrics are required\")\n\\t}\n\n\\tn := float64(len(xs))\n\\tsumX, sumY := 0.0, 0.0\n\\tfor i := 0; i < len(xs); i++ {\n\\t\\tsumX += xs[i]\n\\t\\tsumY += ys[i]\n\\t}\n\\tmeanX := sumX / n\n\\tmeanY := sumY / n\n\n\\tvar sumXY, sumXX, sumYY float64\n\\tfor i := 0; i < len(xs); i++ {\n\\t\\tdx := xs[i] - meanX\n\\t\\tdy := ys[i] - meanY\n\\t\\tsumXY += dx * dy\n\\t\\tsumXX += dx * dx\n\\t\\tsumYY += dy * dy\n\\t}\n\n\\tr := 0.0\n\\tif sumXX > 0 && sumYY > 0 {\n\\t\\tr = sumXY / math.Sqrt(sumXX*sumYY)\n\\t}\n\n\\treturn &CorrelationResult{\n\\t\\tExperiment: experimentName,\n\\t\\tMetricX:    metricX,\n\\t\\tMetricY:    metricY,\n\\t\\tR:          math.Round(r*10000) / 10000,\n\\t\\tCount:      len(xs),\n\\t}, nil\n}\n\n// MetricHistory returns chronological values of a metric across all runs in an experiment.\n'''\nif old not in s:\n    raise SystemExit('MetricHistory comment "]
