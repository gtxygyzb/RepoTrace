[2055.696502, "o", "   221\t\tfor len(queue) > 0 {\r\n   222\t\t\tcurrent := queue[0]\r\n   223\t\t\tqueue = queue[1:]\r\n   224\t\t\tordered = append(ordered, current)\r\n   225\t\r\n   226\t\t\t// Find steps that depend on current\r\n   227\t\t\tfor _, s := range steps {\r\n"]
[2055.696572, "o", "   228\t\t\t\tfor _, dep := range s.Dependencies {\r\n   229\t\t\t\t\tif dep == current.Name {\r\n   230\t\t\t\t\t\tinDegree[s.Name]--\r\n   231\t\t\t\t\t\tif inDegree[s.Name] == 0 {\r\n   232\t\t\t\t\t\t\tqueue = append(queue, s)\r\n"]
[2055.69664, "o", "   233\t\t\t\t\t\t}\r\n   234\t\t\t\t\t}\r\n   235\t\t\t\t}\r\n   236\t\t\t}\r\n   237\t\t}\r\n   238\t\r\n   239\t\tif len(ordered) != len(steps) {\r\n   240\t\t\treturn nil, fmt.Errorf(\"cycle detected in pipeline dependencies\")\r\n   241\t\t}\r\n   242\t\r\n   243\t\treturn ordered, nil\r\n   244\t}\r\n"]
[2055.696739, "o", "   245\t\r\n   246\t// mergeDependencyOutputs concatenates the \"data\" arrays from all dependency outputs into a single input.\r\n   247\tfunc mergeDependencyOutputs(deps []string, outputs map[string]map[string]interface{}) map[string]interface{} {\r\n   248\t\tmerged := make([]interface{}, 0)\r\n   249\t\tfor _, dep := range deps {\r\n   250\t\t\tout, ok := outputs[dep]\r\n   251\t\t\tif !ok {\r\n   252\t\t\t\tcontinue\r\n   253\t\t\t}\r\n"]
[2055.696804, "o", "   254\t\t\tswitch data := out[\"data\"].(type) {\r\n   255\t\t\tcase []interface{}:\r\n   256\t\t\t\tmerged = append(merged, data...)\r\n   257\t\t\tcase []float64:\r\n   258\t\t\t\tfor _, v := range data {\r\n   259\t\t\t\t\tmerged = append(merged, v)"]
[2055.696908, "o", "\r\n   260\t\t\t\t}\r\n   261\t\t\t}\r\n   262\t\t}\r\n   263\t\treturn map[string]interface{}{\"data\": merged}\r\n   264\t}\r\n   265\t\r\n   266\tfunc computeTransitiveDependencies(steps []*Step) map[string]map[string]bool {\r\n   267\t\tstepMap := make(map[string]*Step)\r\n   268\t\tfor _, s := range steps {\r\n   269\t\t\tstepMap[s.Name] = s\r\n"]
[2055.696973, "o", "   270\t\t}\r\n   271\t\r\n   272\t\tresult := make(map[string]map[string]bool)\r\n   273\t\tvar visit func(s *Step) map[string]bool\r\n   274\t\r\n   275\t\tvisit = func(s *Step) map[string]bool {\r\n   276\t\t\tif deps, ok := result[s.Name]; ok {\r\n   277\t\t"]
[2055.697036, "o", "\t\treturn deps\r\n   278\t\t\t}\r\n   279\t\t\tdeps := make(map[string]bool)\r\n   280\t\t\tfor _, dep := range s.Dependencies {\r\n   281\t\t\t\tdeps[dep] = true\r\n   282\t\t\t\tif depStep, ok := stepMap[dep]; ok {\r\n   283\t"]
[2055.697106, "o", "\t\t\t\tfor d := range visit(depStep) {\r\n   284\t\t\t\t\t\tdeps[d] = true\r\n   285\t\t\t\t\t}\r\n   286\t\t\t\t}\r\n   287\t\t\t}"]
[2055.697173, "o", "\r\n   288\t\t\tresult[s.Name] = deps\r\n   289\t\t\treturn deps\r\n   290\t\t}\r\n   291\t\r\n"]
[2055.697202, "o", "   292\t\tfor _, s := range steps {\r\n   293\t\t\tvisit(s)\r\n   294\t\t}\r\n   295\t\treturn result\r\n   296\t}\r\n   297\t\r\n"]
[2055.697308, "o", "   298\tfunc resolveVariables(config map[string]interface{}, variables map[string]float64, setter map[string]string, depSet map[string]bool) (map[string]interface{}, error) {\r\n   299\t\tresolved := make(map[string]interface{}, len(config))\r\n   300\t\tfor k, v := range config {\r\n   301\t\t\tif s, ok := v.(string); ok {\r\n   302\t\t\t\tif strings.HasPrefix(s, \"${\") && strings.HasSuffix(s, \"}\") {\r\n   303\t\t\t\t\tvarName := s[2 : len(s)-1]\r\n"]
[2055.697389, "o", "   304\t\t\t\t\tval, ok := variables[varName]\r\n   305\t\t\t\t\tif !ok {\r\n   306\t\t\t\t\t\treturn nil, fmt.Errorf(\"undefined variable\")\r\n   307\t\t\t\t\t}\r\n"]
[2055.697452, "o", "   308\t\t\t\t\tsetterStep, ok := setter[varName]\r\n   309\t\t\t\t\tif !ok || !depSet[setterStep] {\r\n   310\t\t\t\t\t\treturn nil, fmt.Errorf(\"variable not in dependency chain\")\r\n   311\t\t\t\t\t}\r\n   312\t\t\t\t\tresolved[k] = val\r\n   313\t\t\t\t\tcontinue\r\n"]
[2055.697519, "o", "   314\t\t\t\t}\r\n   315\t\t\t}\r\n   316\t\t\tresolved[k] = v\r\n   317\t\t}\r\n   318\t\treturn resolved, nil\r\n   319\t}\r\n   320\t\r\n   321\tfunc applyOutputTransform(output map[string]interface{}, config map[string]interface{}, transform string) (map[string]interface{}, error) {\r\n   322\t\tdata, ok := output[\"data\"]\r\n   323\t\tif !ok {\r\n   324\t\t\treturn output, nil"]
[2055.697587, "o", "\r\n   325\t\t}\r\n   326\t\r\n   327\t\tvar arr []interface{}\r\n   328\t\tswitch d := data.(type) {\r\n   329\t\tcase []interface{}:\r\n   330\t\t\tarr = d\r\n   331\t\tcase []float64:\r\n   332\t\t\tarr = make([]interface{}, len(d))\r\n   333\t\t\tfor i, v := range d {\r\n"]
[2055.697649, "o", "   334\t\t\t\tarr[i] = v\r\n   335\t\t\t}\r\n   336\t\tdefault:\r\n   337\t\t\treturn output, nil\r\n   338\t\t}\r\n   339\t\r\n   340\t\tswitch transform {\r\n"]
