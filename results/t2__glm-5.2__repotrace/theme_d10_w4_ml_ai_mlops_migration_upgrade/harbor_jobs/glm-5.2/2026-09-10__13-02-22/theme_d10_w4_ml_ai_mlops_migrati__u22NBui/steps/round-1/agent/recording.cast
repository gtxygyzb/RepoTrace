[6505.144727, "o", "   220\t\t\tresult.Valid = false\r\n   221\t\t\tif strings.Contains(err.Error(), \"cycle\") {\r\n   222\t\t\t\tresult.Errors = append(result.Errors, \"dependency cycle detected\")\r\n   223\t\t\t}\r\n   224\t\t}\r\n   225\t\r\n   226\t\tif result.Valid && err == nil {\r\n   227\t\t\tfor _, step := range ordered {\r\n   228\t\t\t\tresult.ExecutionOrder = append(result.ExecutionOrder, step.Name)\r\n   229\t\t\t}\r\n   230\t\t}\r\n   231\t\r\n   232\t\tif len(result.Errors) > 0 {\r\n   233\t\t\tresult.Valid = false\r\n"]
