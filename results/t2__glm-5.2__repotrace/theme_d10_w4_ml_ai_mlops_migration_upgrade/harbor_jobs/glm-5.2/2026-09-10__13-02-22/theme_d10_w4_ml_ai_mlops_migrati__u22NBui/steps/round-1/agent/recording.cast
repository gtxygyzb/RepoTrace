[6956.143776, "i", "edian     float64 `json:\"median\"`\n}\n\n// Summary computes summary statistics for a metric across all runs in an experiment.\nfunc (t *Tracker) Summary(experimentName, metric string) (*SummaryResult, error) {\n\\tt.mu.RLock()\n\\tdefer t.mu.RUnlock()\n\n\\texp, exists := t.experiments[experimentName]\n\\tif !exists {\n\\t\\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\n\\t}\n\n\\tvar values []float64\n\\tfor _, run := range exp.Runs {\n\\t\\tif run == nil {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif value, ok := run.Metrics[metric]; ok {\n\\t\\t\\tvalues = append(values, value)\n\\t\\t}\n\\t}\n\n\\tif len(values) == 0 {\n\\t\\treturn nil, fmt.Errorf(\"no runs have metric %q\", metric)\n\\t}\n\n\\tsort.Float64s(values)\n\n\\tmin := values[0]\n\\tmax := values[len(values)-1]\n\\tsum := 0.0\n\\tfor _, v := range values {\n\\t\\tsum += v\n\\t}\n\\tmean := sum / float64(len(values))\n\n\\tmedian := 0.0\n\\tn := len(values)\n\\tif n%2 == 1 {\n\\t\\tmedian = values[n/2]\n\\t} else {\n\\t\\tmedian = (values[n/2-1] + values[n/2]) / 2.0\n\\t}\n\n\\treturn &SummaryResult{\n\\t\\tExperiment: experim"]
