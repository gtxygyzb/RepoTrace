[5745.757504, "o", "func (s *Server) LoadModel(modelName string, versionNum int, stage string) error {\r\n    91\t\tvar version *registry.Version\r\n    92\t\tvar err error\r\n    93\t\r\n    94\t\tif versionNum > 0 {\r\n    95\t\t\tversion, err = s.registry.GetVersion(modelName, versionNum)\r\n    96\t\t} else if stage != \"\" {\r\n    97\t\t\tversion, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))\r\n    98\t\t} else {\r\n    99"]
[5745.757577, "o", "\t\t\treturn fmt.Errorf(\"must specify version number or stage\")\r\n   100\t\t}\r\n   101\t\r\n   102\t\tif err != nil {\r\n   103\t\t\treturn fmt.Errorf(\"load model: %w\", err)\r\n   104\t\t}\r\n   105\t\r\n   106\t\ts.mu.Lock()\r\n   107\t\tdefer s.mu.Unlock()\r\n   108\t\r\n   109\t"]
[5745.757647, "o", "\ts.loaded[modelName] = &LoadedModel{\r\n   110\t\t\tModelName:   modelName,\r\n   111\t\t\tVersionNum:  version.Number,\r\n   112\t\t\tStage:       version.Stage,\r\n   113\t\t\tModelConfig: version.ModelConfig,\r\n   114\t\t\tLoadedAt:    time.Now(),\r\n   115\t\t}\r\n   116\t\treturn nil\r\n   117\t}\r\n   118\t\r\n"]
