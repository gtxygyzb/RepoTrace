[2973.340429, "o", "\texperiments: make(map[string]*Experiment),\r\n    43\t\t\tdataDir:     dataDir,\r\n    44\t\t}\r\n    45\t\tt.loadAll()\r\n    46\t\treturn t\r\n    47\t}\r\n    48\t\r\n    49\t// CreateExperiment creates a new experiment with the given name.\r\n    50\tfunc (t *Tracker) CreateExperiment(name string) (*Experiment, error) {\r\n    51\t\tt.mu.Lock()\r\n"]
[2973.340492, "o", "    52\t\tdefer t.mu.Unlock()\r\n    53\t\r\n    54\t\tif _, exists := t.experiments[name]; exists {\r\n    55\t\t\treturn nil, fmt.Errorf(\"experiment %q already exists\", name)\r\n    56\t\t}\r\n    57\t\r\n    58\t\texp := &Experiment{\r\n    59\t\t\tName:      name,\r\n    60\t\t\tRuns:      make([]*Run, 0),\r\n    61\t"]
[2973.340552, "o", "\t\tCreatedAt: time.Now(),\r\n    62\t\t}\r\n    63\t\tt.experiments[name] = exp\r\n    64\t\tif err := t.saveExperiment(exp); err != nil {\r\n    65\t\t\tdelete(t.experiments, name)\r\n    66\t\t\treturn nil, err\r\n    67\t\t}\r\n    68\t\treturn exp, nil\r\n    69\t}\r\n"]
[2973.340613, "o", "    70\t\r\n    71\t// LogRun adds a new run to the specified experiment.\r\n    72\tfunc (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {\r\n    73\t\tt.mu.Lock()\r\n    74\t\tdefer t.mu.Unlock()\r\n    75\t\r\n    76\t\texp, exists := t.experiments[experimentName]\r\n    77\t\tif !exists {\r\n    78\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n"]
[2973.340682, "o", "    79\t\t}\r\n    80\t\r\n    81\t\tt.runCounter++\r\n    82\t\trun := &Run{\r\n    83\t\t\tID:         fmt.Sprintf(\"run_%d\", t.runCounter),\r\n    84"]
[2973.340749, "o", "\t\t\tParameters: params,\r\n    85\t\t\tMetrics:    metrics,\r\n    86\t\t\tTags:       tags,\r\n    87\t\t\tCreatedAt:  time.Now(),\r\n    88\t\t}\r\n    89\t\texp.Runs = append(exp.Runs, run)\r\n    90\t\r\n    91\t\tif err := t.saveExperiment(exp); err != nil {\r\n    92\t\t\texp.Runs = exp.Runs[:len(exp.Runs)-1]\r\n    93\t\t\treturn nil, err\r\n    94\t\t}\r\n    95\t\treturn run, nil\r\n    96\t}\r\n    97\t\r\n    98\t// GetExperiment returns the experiment with the given name."]
[2973.34082, "o", "\r\n    99\tfunc (t *Tracker) GetExperiment(name string) (*Experiment, error) {\r\n   100\t\tt.mu.RLock()\r\n   101\t\tdefer t.mu.RUnlock()\r\n   102\t\r\n   103\t\texp, exists := t.experiments[name]\r\n   104\t\tif !exists {\r\n   105\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", name)\r\n   106\t\t}\r\n"]
[2973.34092, "o", "   107\t\treturn exp, nil\r\n   108\t}\r\n   109\t\r\n   110\t// ListExperiments returns all experiments.\r\n   111\tfunc (t *Tracker) ListExperiments() []*Experiment {\r\n   112\t\tt.mu.RLock()\r\n   113\t\tdefer t.mu.RUnlock()\r\n   114\t\r\n   115\t\tresult := make([]*Experiment, 0, len(t.experiments))\r\n   116\t\tfor _, exp := range t.experiments {\r\n   117\t\t\tresult = append(result, exp)\r\n   118\t\t}\r\n   119\t\tsort.Slice(result, func(i, j int) bool {\r\n   120\t\t\treturn result[i].Name < result[j].Name\r\n"]
[2973.340999, "o", "   121\t\t})\r\n   122\t\treturn result\r\n   123\t}\r\n   124\t\r\n   125\t// AggregateMetric computes an aggregate statistic for a given metric across all runs\r\n   126\t// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.\r\n   127\t// For weighted_mean, weightParam specifies which parameter to use as weight.\r\n   128\tfunc (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string, tagFilters map[string]string) (float64, int, []string, error) {\r\n   129\t\tt.mu.RLock()\r\n   130\t\tdefer t.mu.RUnlock()\r\n   131\t\r\n   132\t\texp, exists := t.experiments[experimentName]\r\n"]
[2973.341058, "o", "   133\t\tif !exists {\r\n   134\t\t\treturn 0, 0, nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   135\t\t}\r\n   136\t\r\n   137\t\tif len(exp.Runs) == 0 {\r\n   138\t\t\treturn 0, 0, nil, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n   139\t\t}\r\n"]
[2973.341114, "o", "   140\t\r\n"]
