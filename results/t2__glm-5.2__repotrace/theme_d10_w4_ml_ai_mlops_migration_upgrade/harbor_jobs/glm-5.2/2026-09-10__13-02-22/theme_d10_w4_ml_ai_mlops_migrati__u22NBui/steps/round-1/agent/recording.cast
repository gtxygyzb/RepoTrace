[6956.30915, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[6956.309202, "o", "\u001b[?2004h> "]
[6956.309263, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[6956.309318, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6956.309374, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.309429, "o", "\u001b[?2004h> "]
[6956.309635, "o", "\\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[?2004l\r"]
[6956.30969, "o", "\u001b[?2004h> "]
