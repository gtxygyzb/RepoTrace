[5635.246369, "o", "\t\tval, err := toFloat(v)\r\n   115\t\t\t\tif err != nil {\r\n   116\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: not a number\", i))\r\n   117\t\t\t\t\tcontinue\r\n   118\t\t\t\t}\r\n   119\t\t\t\tif val < minVal {\r\n   120\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f below minimum %f\", i, val, minVal))\r\n   121\t\t\t\t}\r\n   122\t\t\t}\r\n   123\t\t}\r\n   124\t\r\n   125\t\t// Check max_value constraint\r\n   126\t\tif maxVal, ok := config[\"max_value\"].(float64); ok {\r\n   127\t\t\tfor i, v := range data {\r\n   128\t\t\t\tval, err := toFloat(v)\r\n   129\t\t\t\tif err != nil {\r\n   130\t\t\t\t\tcontinue\r\n   131\t\t\t\t}\r\n   132\t\t\t\tif val > maxVal {\r\n   133\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f above maximum %f\", i, val, maxVal))\r\n   134\t\t\t\t}\r\n"]
