[3723.73017, "o", "\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc topologicalSort\u001b[m\u001b[K(steps []*Step) ([]*Step, error) {\r\n"]
[3723.730619, "o", "\u001b[?2004h"]
