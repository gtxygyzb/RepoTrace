[183.568494, "o", "\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (r *Registry) DeleteModel\u001b[m\u001b[K(name string) error {\r\n\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tr.mu.Lock()\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer r.mu.Unlock()\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[183.568634, "o", "\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif _, exists := r.models[name]; !exists {\r\n\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn fmt.Errorf(\"model %q not found\", name)\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdelete(r.models, name)\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfilename := filepath.Join(r.dataDir, name+\".json\")\r\n\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tos.Remove(filename)\r\n\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn nil\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K257\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// GetVersion returns a specific version of a model.\r\n\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (r *Registry) GetVersion(modelName string, versionNum int) (*Version, error) {\r\n\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tr.mu.RLock()\r\n\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer r.mu.RUnlock()\r\n\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmodel, exists := r.models[modelName]\r\n\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif !exists {\r\n\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b"]
[183.568755, "o", "[K\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n\u001b[32m\u001b[K265\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K266\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, v := range model.Versions {\r\n\u001b[32m\u001b[K268\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif v.Number == versionNum {\r\n\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn v, nil\r\n\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn nil, fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K274\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K275\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// GetVersionByStage returns the version of a model currently in the specified stage.\r\n\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (r *Registry) GetVersionByStage(modelName string, stage Stage) (*Version, error) {\r\n\u001b[32m\u001b[K277\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tr.mu.RLock()\r\n\u001b[32m\u001b[K278\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer r.mu.RUnlock()\r\n\u001b[32m\u001b[K279\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K280\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmodel, exists := r.models[modelName]\r\n\u001b[32m"]
