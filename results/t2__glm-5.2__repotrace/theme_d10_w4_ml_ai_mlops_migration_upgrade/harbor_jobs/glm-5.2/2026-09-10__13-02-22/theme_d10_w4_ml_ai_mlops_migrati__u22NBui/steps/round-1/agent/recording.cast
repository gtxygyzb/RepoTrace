[171.639685, "i", "sed -n '230,380p' internal/pipeline/steps.go\n"]
[171.64006, "o", "sed -n '230,380p' internal/pipeline/steps.go\r\n"]
[171.640141, "o", "\u001b[?2004l\r"]
[171.64293, "o", "\r\n\tcase \"summary\":\r\n\t\tdata, ok := input[\"data\"].([]interface{})\r\n\t\tcount := 0\r\n"]
[171.643054, "o", "\t\tif ok {\r\n\t\t\tcount = len(data)\r\n\t\t}\r\n\t\treturn map[string]interface{}{\r\n\t\t\t\"format\": \"summary\",\r\n\t\t\t\"count\":  float64(count),\r\n"]
[171.643144, "o", "\t\t\t\"data\":   input,\r\n\t\t}, nil\r\n\r\n\tcase \"csv\":\r\n\t\tdata, ok := input[\"data\"].([]interface{})\r\n\t\tif !ok {\r\n\t\t\treturn map[string]interface{}{\"format\": \"csv\", \"content\": \"\"}, nil\r\n\t\t}\r\n\t\tcsv := \"\"\r\n\t\tfor i, v := range data {\r\n\t\t\tif i > 0 {\r\n\t\t\t\tcsv += \",\"\r\n\t\t\t}\r\n\t\t\tcsv += fmt.Sprintf(\"%v\", v)\r\n\t\t}\r\n\t\treturn map[string]interface{}{\r\n\t\t\t\"format\":  \"csv\",\r\n\t\t\t\"content\": csv,\r\n\t\t\t\"data\":    data,\r\n\t\t}, nil\r\n\r\n\tdefault:\r\n"]
[171.643222, "o", "\t\treturn nil, fmt.Errorf(\"export: unknown format %q\", format)\r\n\t}\r\n}\r\n\r\n// ExecuteFilter selects elements from the data array based on a comparison condition.\r\n// Supported modes: gt, lt, gte, lte, eq, ne.\r\nfunc ExecuteFilter(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"filter: missing or invalid 'data' field in input\")\r\n\t}\r\n\r\n\tmode, _ := config[\"mode\"].(string)\r\n\tif mode == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"filter: missing 'mode' in config\")\r\n\t}\r\n\tthreshold, _ := config[\"threshold\"].(float64)\r\n\r\n\tvar result []interface{}\r\n\tfor _, v := range data {\r\n\t\tval, err := toFloat(v)\r\n\t\tif err != nil {\r\n\t"]
[171.643286, "o", "\t\tcontinue\r\n\t\t}\r\n\t\tvar keep bool\r\n\t\tswitch mode {\r\n\t\tcase \"gt\":\r\n\t\t\tkeep = val < threshold\r\n\t\tcase \"lt\":\r\n\t\t\tkeep = val > threshold\r\n\t\tcase \"gte\":\r\n\t\t\tkeep = val <= threshold\r\n\t\tcase \"lte\":\r\n"]
[171.643347, "o", "\t\t\tkeep = val >= threshold\r\n\t\tcase \"eq\":\r\n\t\t\tkeep = val != threshold\r\n\t\tcase \"ne\":\r\n\t\t\tkeep = val == threshold\r\n\t\tdefault:\r\n\t\t\treturn nil, fmt.Errorf(\"filter: unknown mode %q\", mode)\r\n\t\t}\r\n\t\tif keep {\r\n\t\t\tresult = append(result, val)\r\n"]
[171.643409, "o", "\t\t}\r\n\t}\r\n\r\n\tif result == nil {\r\n\t\tresult = []interface{}{}\r\n\t}\r\n\treturn map[string]interface{}{\"data\": result}, nil\r\n}\r\n\r\n// Helper functions\r\n\r\nfunc toFloat(v interface{}) (float64, error) {\r\n\tswitch val := v.(type) {\r\n"]
[171.643467, "o", "\tcase float64:\r\n\t\treturn val, nil\r\n\tcase int:\r\n\t\treturn float64(val), nil\r\n\tcase int64:\r\n\t\treturn float64(val), nil\r\n\tdefault:\r\n\t\treturn 0, fmt.Errorf(\"cannot convert %T to float64\", v)\r\n\t}\r\n}\r\n\r\n"]
[171.643523, "o", "func findMinMax(data []interface{}) (float64, float64) {\r\n\tif len(data) == 0 {\r\n\t\treturn 0, 0\r\n\t}\r\n\tminVal, _ := toFloat(data[0])\r\n\tmaxVal := minVal\r\n\tfor _, v := range data[1:] {\r\n\t\tval, err := toFloat(v)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n"]
[171.643581, "o", "\t\t}\r\n\t\tif val < minVal {\r\n\t\t\tminVal = val\r\n\t\t}\r\n\t\tif val > maxVal {\r\n\t\t\tmaxVal = val\r\n\t\t}\r\n\t}\r\n\treturn minVal, maxVal\r\n"]
[171.643637, "o", "}\r\n\r\nfunc sortedCopy(values []float64) []float64 {\r\n\ts := make([]float64, len(values))\r\n\tcopy(s, values)\r\n\tsort.Float64s(s)\r\n\treturn s\r\n}\r\n"]
