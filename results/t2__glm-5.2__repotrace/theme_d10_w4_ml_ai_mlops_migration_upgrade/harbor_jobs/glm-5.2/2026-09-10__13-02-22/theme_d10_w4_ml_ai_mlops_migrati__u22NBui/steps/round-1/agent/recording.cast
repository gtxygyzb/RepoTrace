[2520.525787, "o", "func (h *Handlers) SearchRuns(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[2520.525846, "o", "\u001b[?2004h> "]
[2520.52597, "o", "\\texpName := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[2520.526029, "o", "\u001b[?2004h> "]
[2520.526097, "o", "\\tvar req struct {\r\n\u001b[?2004l\r"]
[2520.526157, "o", "\u001b[?2004h> "]
