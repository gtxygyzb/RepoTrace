[4624.4108, "o", "> "]
[4624.411049, "o", "\\tentries := make([]map[string]interface{}, 0, len(versions))\r\n\u001b[?2004l\r"]
[4624.411094, "o", "\u001b[?2004h> "]
[4624.411218, "o", "\\tfor _, v := range versions {\r\n\u001b[?2004l\r"]
[4624.411255, "o", "\u001b[?2004h> "]
