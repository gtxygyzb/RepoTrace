[6437.628422, "o", "grep -n \"func (h \\*Handlers)\" internal/api/handlers.go\r\n\u001b[?2004l\r"]
[6437.631658, "o", "\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers)\u001b[m\u001b[K RegisterModel(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers)\u001b[m\u001b[K ListModels(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers)\u001b[m\u001b[K DeleteModel(w http.ResponseWriter, r *http.Request) {\r\n"]
[6437.631758, "o", "\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers)\u001b[m\u001b[K GetModel(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers)\u001b[m\u001b[K CreateVersion(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers)\u001b[m\u001b[K GetVersion(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers)\u001b[m\u001b[K PromoteVersion(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K171\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers)\u001b[m\u001b[K ExecutePipeline(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers)\u001b[m\u001b[K CreateExperiment(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers)\u001b[m\u001b[K ListExperiments(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers)\u001b[m\u001b[K GetExperiment(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K:"]
