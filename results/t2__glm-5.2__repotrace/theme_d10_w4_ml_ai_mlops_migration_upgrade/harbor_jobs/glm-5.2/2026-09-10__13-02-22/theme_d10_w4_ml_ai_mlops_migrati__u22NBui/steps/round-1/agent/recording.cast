[3948.260589, "o", "   312\t// The caller must hold an appropriate lock.\r\n   313\tfunc (r *Registry) findVersionLocked(modelName string, versionNum int) (*Model, *Version, error) {\r\n   314\t\tmodel, exists := r.models[modelName]\r\n   315\t\tif !exists {\r\n   316\t\t\treturn nil, nil, fmt.Errorf(\"model %q not found\", modelName)\r\n   317\t\t}\r\n"]
