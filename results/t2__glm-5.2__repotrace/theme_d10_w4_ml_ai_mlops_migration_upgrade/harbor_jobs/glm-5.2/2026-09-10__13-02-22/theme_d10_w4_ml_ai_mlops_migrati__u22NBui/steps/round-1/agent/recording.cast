[5996.95549, "o", "\u001b[?2004h> "]
[5996.955528, "o", "\\t}\r\n\u001b[?2004l\r"]
[5996.955564, "o", "\u001b[?2004h"]
[5996.955601, "o", "> "]
[5996.955725, "o", "\\tstart := total - limit\r\n\u001b[?2004l\r"]
[5996.955763, "o", "\u001b[?2004h"]
[5996.955801, "o", "> "]
[5996.956086, "o", "\\tresult := make([]PipelineExecutionRecord, limit)\r\n\u001b[?2004l\r"]
[5996.956131, "o", "\u001b[?2004h> "]
[5996.956312, "o", "\\tcopy(result, e.history[start:])\r\n\u001b[?2004l\r"]
[5996.956349, "o", "\u001b[?2004h> "]
[5996.956475, "o", "\\t// Reverse to most recent first\r\n\u001b[?2004l\r"]
[5996.956512, "o", "\u001b[?2004h> "]
[5996.956732, "o", "\\tfor i, j := 0, len(result)-1; i < j; i, j = i+1, j-1 {\r\n\u001b[?2004l\r"]
[5996.956769, "o", "\u001b[?2004h> "]
[5996.956958, "o", "\\t\\tresult[i], result[j] = result[j], result[i]\r\n\u001b[?2004l\r"]
[5996.957003, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[5996.95704, "o", "\u001b[?2004h> "]
[5996.957144, "o", "\\treturn result, total\r\n\u001b[?2004l\r"]
[5996.957182, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
