[6480.944137, "i", "sed -n '140,240p' internal/pipeline/engine.go\n"]
[6480.944532, "o", "sed -n '140,240p' internal/pipeline/engine.go\r\n\u001b[?2004l\r"]
[6480.94764, "o", "\tErrors         []string        `json:\"errors\"`\r\n}\r\n\r\n// ValidatedStep contains structural details for a validated step.\r\ntype ValidatedStep struct {\r\n\tName         string   `json:\"name\"`\r\n\tType         StepType `json:\"type\"`\r\n\tDependencies []string `json:\"dependencies\"`\r\n}\r\n"]
[6480.947751, "o", "\r\n// Validate checks a pipeline definition for structural correctness without executing it.\r\nfunc (e *Engine) Validate(p *Pipeline) *ValidationResult {\r\n\tresult := &ValidationResult{\r\n\t\tValid:          true,\r\n\t\tExecutionOrder: []string{},\r\n\t\tSteps:          []ValidatedStep{},\r\n\t\tErrors:         []string{},\r\n\t}\r\n"]
[6480.947825, "o", "\tif p == nil {\r\n\t\tresult.Valid = false\r\n\t\tresult.Errors = append(result.Errors, \"pipeline definition is required\")\r\n\t\treturn result\r\n\t}\r\n\r\n\tstepCount := len(p.Steps)\r\n\tresult.StepCount = stepCount\r\n\r\n\tseen := make(map[string]bool)\r\n\tduplicateNames := make(map[string]bool)\r\n\tnameOrder := make([]string, 0, stepCount)\r\n\r\n\tfor i, step := range p.Steps {\r\n\t\tif step == nil {\r\n\t\t\tresult.Valid = false\r\n\t\t\tresult.Errors = append(result.Errors, \"step is null\")\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif step.Name == \"\" {\r\n\t\t\tresult.Valid = false\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"step at index %d has empty name\", i))\r\n"]
[6480.947925, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tresult.Steps = append(result.Steps, ValidatedStep{\r\n\t\t\tName:         step.Name,\r\n\t\t\tType:         step.Type,\r\n\t\t\tDependencies: step.Dependencies,\r\n\t\t})\r\n\t\tif seen[step.Name] {\r\n\t\t\tduplicateNames[step.Name] = true\r\n\t\t}\r\n\t\tif !seen[step.Name] {\r\n\t"]
[6480.947993, "o", "\t\tseen[step.Name] = true\r\n\t\t\tnameOrder = append(nameOrder, step.Name)\r\n\t\t}\r\n\t}\r\n\tif len(duplicateNames) > 0 {\r\n\t\tresult.Valid = false\r\n\t\tfor name := range duplicateNames {\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"duplicate step name: %s\", name))\r\n\t\t}\r\n\t}\r\n"]
[6480.948053, "o", "\r\n\tfor _, step := range p.Steps {\r\n\t\tif step == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif _, exists := e.stepExecutors[step.Type]; !exists {\r\n\t\t\tresult.Valid = false\r\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"unknown step type: %s\", step.Type))\r\n\t\t}\r\n"]
[6480.948112, "o", "\t\tfor _, dep := range step.Dependencies {\r\n\t\t\tif !seen[dep] {\r\n\t\t\t\tresult.Valid = false\r\n\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"step %s depends on unknown step: %s\", step.Name, dep))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t"]
[6480.948173, "o", "ordered, err := topologicalSort(p.Steps)\r\n\tif err != nil {\r\n\t\tresult.Valid = false\r\n\t\tif strings.Contains(err.Error(), \"cycle\") {\r\n\t\t\tresult.Errors = append(result.Errors, \"dependency cycle detected\")\r\n\t\t}\r\n\t}\r\n\r\n\tif result.Valid && err == nil {\r\n\t\tfor _, step := range ordered {\r\n\t\t\tresult.ExecutionOrder = append(result.ExecutionOrder, step.Name)\r\n"]
[6480.948231, "o", "\t\t}\r\n\t}\r\n\r\n\tif len(result.Errors) > 0 {\r\n\t\tresult.Valid = false\r\n\t\tresult.ExecutionOrder = []string{}\r\n\t}\r\n\r\n\treturn result\r\n}\r\n\r\n// Execute runs a pipeline with the given initial input data.\r\n"]
[6480.948845, "o", "\u001b[?2004h"]
