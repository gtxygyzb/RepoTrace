[1504.229749, "o", "\u001b[?2004h> "]
[1504.229957, "o", "\\t\\t\\texp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)\r\n\u001b[?2004l\r"]
[1504.230013, "o", "\u001b[?2004h> "]
[1504.230129, "o", "\\t\\t\\treturn t.saveExperiment(exp)\r\n\u001b[?2004l\r"]
