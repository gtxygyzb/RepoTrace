[2520.523019, "o", "\u001b[?2004h> "]
[2520.523123, "o", "\\trunID := r.PathValue(\"id\")\r\n\u001b[?2004l\r"]
[2520.523178, "o", "\u001b[?2004h> "]
[2520.523244, "o", "\\tvar req struct {\r\n\u001b[?2004l\r"]
[2520.523299, "o", "\u001b[?2004h> "]
[2520.523481, "o", "\\t\\tMetrics map[string]float64 `json:\"metrics\"`\r\n\u001b[?2004l\r"]
[2520.523536, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2520.52359, "o", "\u001b[?2004h> "]
[2520.523838, "o", "\\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[?2004l\r"]
[2520.523917, "o", "\u001b[?2004h> "]
[2520.524184, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\u001b[?2004l\r"]
[2520.524245, "o", "\u001b[?2004h> "]
[2520.524305, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2520.524363, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2520.524666, "o", "\\trun, err := h.Experiment.UpdateRunMetrics(expName, runID, req.Metrics)\r\n\u001b[?2004l\r"]
[2520.524725, "o", "\u001b[?2004h> "]
[2520.524784, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[2520.524886, "o", "\u001b[?2004h> "]
[2520.525031, "o", "\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[2520.525092, "o", "\u001b[?2004h> "]
[2520.525151, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> "]
