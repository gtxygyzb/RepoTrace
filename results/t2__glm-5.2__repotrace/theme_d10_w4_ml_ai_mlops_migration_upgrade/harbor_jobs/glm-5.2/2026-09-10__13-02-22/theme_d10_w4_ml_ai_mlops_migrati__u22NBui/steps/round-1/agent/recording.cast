[1998.080026, "o", "package pipeline\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"sort\"\r\n)\r\n\r\n"]
[1998.080117, "o", "// ExecuteTransform applies a data transformation.\r\n// Supported modes: scale, offset, normalize, identity, clip, log.\r\nfunc ExecuteTransform(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"transform: missing or invalid 'data' field in input\")\r\n\t}\r\n\r\n\tmode, _ := config[\"mode\"].(string)\r\n\tif mode == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"transform: missing 'mode' in config\")\r\n\t}\r\n\r\n\tresult := make([]interface{}, len(data))\r\n"]
[1998.080218, "o", "\r\n\tswitch mode {\r\n\tcase \"scale\":\r\n\t\tfactor, _ := config[\"factor\"].(float64)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform scale: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t\t\tresult[i] = val * factor\r\n\t\t}\r\n\r\n\tcase \"offset\":\r\n\t\toffset, _ := config[\"offset\"].(float64)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n"]
[1998.080293, "o", "\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform offset: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t\t\tresult[i] = val + offset\r\n\t\t}\r\n\r\n\tcase \"normalize\":\r\n\t\tif len(data) == 0 {\r\n\t\t\treturn map[string]interface{}{\"data\": result}, nil\r\n\t\t}\r\n\t\tminVal, maxVal := findMinMax(data)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n"]
[1998.080364, "o", "\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform normalize: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t\t\tif maxVal == minVal {\r\n\t\t\t\tresult[i] = 0.5\r\n\t\t\t} else {\r\n\t\t\t\tresult[i] = (val - minVal) / (maxVal - minVal)\r\n\t\t\t}\r\n"]
[1998.080436, "o", "\t\t}\r\n\r\n\tcase \"identity\":\r\n\t\tcopy(result, data)\r\n\r\n\tcase \"clip\":\r\n\t\tlow, _ := config[\"low\"].(float64)\r\n\t\thigh, _ := config[\"high\"].(float64)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t"]
[1998.080503, "o", "\t\treturn nil, fmt.Errorf(\"transform clip: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t\t\tif val < low {\r\n\t\t\t\tval = low\r\n\t\t\t}\r\n\t\t\tif val > high {\r\n\t\t\t\tval = high\r\n\t\t\t}\r\n\t"]
[1998.080574, "o", "\t\tresult[i] = val\r\n\t\t}\r\n\r\n\tcase \"log\":\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform log: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t\t\tif val <= 0 {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform log: element %d is non-positive (%f)\", i, val)\r\n"]
[1998.080647, "o", "\t\t\t}\r\n\t\t\tresult[i] = math.Log(val)\r\n\t\t}\r\n\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"transform: unknown mode %q\", mode)\r\n\t}\r\n\r\n\treturn map[string]interface{}{\"data\": result}, nil\r\n}\r\n\r\n// ExecuteValidate checks data against schema constraints.\r\nfunc ExecuteValidate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n"]
[1998.080715, "o", "\t\treturn nil, fmt.Errorf(\"validate: missing or invalid 'data' field\")\r\n\t}\r\n\r\n\tvar errors []interface{}\r\n\r\n\t// Check min_value constraint\r\n\tif minVal, ok := config[\"min_value\"].(float64); ok {\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: not a number\", i))\r\n"]
[1998.080793, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif val < minVal {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f below minimum %f\", i, val, minVal))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// Check max_value constraint\r\n\tif maxVal, ok := config[\"max_value\"].(float64); ok {\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n"]
[1998.080874, "o", "\t\t\tif err != nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif val > maxVal {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f above maximum %f\", i, val, maxVal))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// Check min_count constraint\r\n\tif minCount, ok := config[\"min_count\"].(float64); ok {\r\n\t\tif float64(len(data)) < minCount {\r\n\t\t\t"]
[1998.080944, "o", "errors = append(errors, fmt.Sprintf(\"data has %d elements, minimum required is %d\", len(data), int(minCount)))\r\n\t\t}\r\n\t}\r\n\r\n\tvalid := len(errors) == 0\r\n\treturn map[string]interface{}{\r\n\t\t\"valid\":  valid,\r\n\t\t\"errors\": errors,\r\n\t\t\"data\":   data,\r\n\t}, nil\r\n}\r\n\r\n"]
[1998.081012, "o", "// ExecuteAggregate computes aggregations over input data.\r\n// Supported operations: sum, mean, count, min, max.\r\nfunc ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"aggregate: missing or invalid 'data' field\")\r\n\t}\r\n\r\n\toperation, _ := config[\"operation\"].(string)\r\n\tif operation == \"\" {\r\n"]
[1998.081081, "o", "\t\treturn nil, fmt.Errorf(\"aggregate: missing 'operation' in config\")\r\n\t}\r\n\r\n\tvalues := make([]float64, 0, len(data))\r\n\tfor _, v := range data {\r\n\t\tval, err := toFloat(v)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvalues = append(values, val)\r\n\t}\r\n\r\n"]
[1998.081149, "o", "\tif len(values) == 0 {\r\n\t\treturn map[string]interface{}{\"result\": 0.0, \"count\": 0.0}, nil\r\n\t}\r\n\r\n\tvar result float64\r\n\tswitch operation {\r\n\tcase \"sum\":\r\n\t\tfor _, v := range values {\r\n\t\t\tresult += v\r\n\t\t}\r\n\tcase \"mean\":\r\n\t\tfor _, v := range values {\r\n\t"]
[1998.081216, "o", "\t\tresult += v\r\n\t\t}\r\n\t\tresult /= float64(len(values))\r\n\tcase \"count\":\r\n\t\tresult = float64(len(values))\r\n\tcase \"min\":\r\n\t\tresult = values[0]\r\n\t\tfor _, v := range values[1:] {\r\n\t\t\tif v < result {\r\n\t\t\t\tresult = v\r\n"]
[1998.081283, "o", "\t\t\t}\r\n\t\t}\r\n\tcase \"max\":\r\n\t\tresult = values[0]\r\n\t\tfor _, v := range values[1:] {\r\n\t\t\tif v > result {\r\n\t\t\t\tresult = v\r\n\t\t\t}\r\n\t\t}\r\n\t"]
[1998.081359, "o", "case \"range\":\r\n\t\tif len(values) < 2 {\r\n\t\t\tresult = 0.0\r\n\t\t} else {\r\n\t\t\tminVal := values[0]\r\n\t\t\tmaxVal := values[0]\r\n\t\t\tfor _, v := range values[1:] {\r\n\t\t\t\tif v < minVal {\r\n\t\t\t\t\tminVal = v\r\n\t\t\t\t}\r\n\t\t"]
[1998.081431, "o", "\t\tif v > maxVal {\r\n\t\t\t\t\tmaxVal = v\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tresult = maxVal - minVal\r\n\t\t}\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"aggregate: unknown operation %q\", operation)\r\n\t}\r\n\r\n\treturn map[string]interface{}{\r\n\t\t\"result\": result,\r\n"]
[1998.081498, "o", "\t\t\"count\":  float64(len(values)),\r\n\t\t\"data\":   data,\r\n\t}, nil\r\n}\r\n\r\n// ExecuteExport formats data for output.\r\n// Supported formats: json, csv, summary.\r\nfunc ExecuteExport(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tformat, _ := config[\"format\"].(string)\r\n\tif format == \"\" {\r\n"]
[1998.081567, "o", "\t\tformat = \"json\"\r\n\t}\r\n\r\n\tswitch format {\r\n\tcase \"json\":\r\n\t\treturn map[string]interface{}{\r\n\t\t\t\"format\": \"json\",\r\n\t\t\t\"data\":   input,\r\n\t\t}, nil\r\n\r\n\tcase \"summary\":\r\n\t\tdata, ok := input[\"data\"].([]interface{})\r\n\t\t"]
[1998.081635, "o", "count := 0\r\n\t\tif ok {\r\n\t\t\tcount = len(data)\r\n\t\t}\r\n\t\treturn map[string]interface{}{\r\n\t\t\t\"format\": \"summary\",\r\n\t\t\t\"count\":  float64(count),\r\n\t\t\t\"data\":   input,\r\n\t\t}, nil\r\n\r\n"]
[1998.081704, "o", "\tcase \"csv\":\r\n\t\tdata, ok := input[\"data\"].([]interface{})\r\n"]
[1998.082189, "o", "\u001b[?2004h"]
[1998.082256, "o", "root@n30009:/app# "]
[1998.352348, "i", "sed -n '120,230p' internal/registry/registry.go\n"]
[1998.352745, "o", "sed -n '120,230p' internal/registry/registry.go\r\n\u001b[?2004l\r"]
[1998.355983, "o", "\t\t}\r\n\t}\r\n\r\n\tversion := &Version{\r\n\t\tNumber:      nextNum,\r\n"]
[1998.356123, "o", "\t\tStage:       StageDevelopment,\r\n\t\tMetrics:     metrics,\r\n\t\tTags:        tags,\r\n\t\tModelConfig: modelConfig,\r\n\t\tCreatedAt:   time.Now(),\r\n\t}\r\n\tmodel.Versions = append(model.Versions, version)\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\tif err := r.saveModel(model); err != nil {\r\n\t\tmodel.Versions = model.Versions[:len(model.Versions)-1]\r\n\t\treturn nil, err\r\n\t}\r\n\treturn version, nil\r\n}\r\n\r\n// PromoteVersion transitions a model version to the specified stage.\r\nfunc (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t"]
[1998.356209, "o", "\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tvar version *Version\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Number == versionNum {\r\n\t\t\tversion = v\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif version == nil {\r\n\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n\t}\r\n\r\n"]
[1998.356281, "o", "\t// Validate stage transition\r\n\tallowed := validTransitions[version.Stage]\r\n\tvalid := false\r\n\tfor _, s := range allowed {\r\n\t\tif s == targetStage {\r\n\t\t\tvalid = true\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif !valid {\r\n\t"]
[1998.35635, "o", "\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n\t}\r\n\r\n\t// If promoting to production, demote current production version\r\n\tif targetStage == StageProduction {\r\n\t\tfor _, v := range model.Versions {\r\n\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n\t\t\t\tv.Stage = StageArchived\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[1998.356421, "o", "\tversion.Stage = targetStage\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\treturn r.saveModel(model)\r\n}\r\n\r\n// GetModel returns a model with its versions sorted by version number descending.\r\nfunc (r *Registry) GetModel(name string) (*Model, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tmodel, exists := r.models[name]\r\n\tif !exists {\r\n"]
[1998.356497, "o", "\t\treturn nil, fmt.Errorf(\"model %q not found\", name)\r\n\t}\r\n\r\n\t// Return a copy with versions sorted\r\n\tresult := *model\r\n\tresult.Versions = make([]*Version, len(model.Versions))\r\n\tcopy(result.Versions, model.Versions)\r\n\tsort.Slice(result.Versions, func(i, j int) bool {\r\n\t\treturn result.Versions[i].Number > result.Versions[j].Number\r\n\t})\r\n\treturn &result, nil\r\n}\r\n"]
[1998.356565, "o", "\r\n// ListModels returns all models matching the optional filter.\r\nfunc (r *Registry) ListModels(filter *ModelFilter) ([]*Model, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tvar result []*Model\r\n\tfor _, model := range r.models {\r\n\t\tif filter != nil {\r\n\t\t\tif filter.Framework != \"\" && model.Framework != filter.Framework {\r\n\t\t\t\tcontinue\r\n"]
[1998.356633, "o", "\t\t\t}\r\n\t\t\tif filter.Tag != \"\" {\r\n\t\t\t\thasTag := false\r\n\t\t\t\tfor _, t := range model.Tags {\r\n\t\t\t\t\tif t == filter.Tag {\r\n\t\t\t\t\t\thasTag = true\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n"]
[1998.356699, "o", "\t\t\t\tif !hasTag {\r\n\t\t\t\t\tcontinue\r\n"]
[1998.357202, "o", "\u001b[?2004h"]
