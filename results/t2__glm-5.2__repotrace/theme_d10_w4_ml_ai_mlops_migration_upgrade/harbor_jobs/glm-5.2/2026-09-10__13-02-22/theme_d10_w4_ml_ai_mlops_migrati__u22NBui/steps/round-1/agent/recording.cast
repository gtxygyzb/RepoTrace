[4680.610902, "o", "\u001b[?2004h> "]
[4680.611034, "o", "\\t\\t\\treturn output, nil, attempt, false\r\n\u001b[?2004l\r"]
[4680.611089, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[4680.611145, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[4680.6112, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4680.611259, "o", "\u001b[?2004h> "]
[4680.611401, "o", "\\treturn output, err, maxAttempts - 1, false\r\n\u001b[?2004l\r"]
[4680.611457, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
