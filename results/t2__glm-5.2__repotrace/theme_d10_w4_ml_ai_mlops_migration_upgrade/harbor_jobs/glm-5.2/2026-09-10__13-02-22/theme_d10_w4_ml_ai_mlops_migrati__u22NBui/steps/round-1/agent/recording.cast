[6388.332227, "o", "\u001b[32m\u001b[K287\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KExecuteFilter(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\u001b[32m\u001b[K335\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KtoFloat(v interface{}) (float64, error) {\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KfindMinMax(data []interface{}) (float64, float64) {\r\n\u001b[32m\u001b[K369\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KsortedCopy(values []float64) []float64 {\r\n\u001b[32m\u001b[K377\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KExecuteSleep(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n"]
