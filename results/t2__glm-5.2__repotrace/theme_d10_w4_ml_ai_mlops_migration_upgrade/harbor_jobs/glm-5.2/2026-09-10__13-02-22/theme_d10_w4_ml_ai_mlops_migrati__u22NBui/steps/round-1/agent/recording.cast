[247.686869, "o", "   128\tfunc (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, error) {\r\n   129\t\tt.mu.RLock()\r\n   130\t\tdefer t.mu.RUnlock()\r\n   131\t\r\n   132\t\texp, exists := t.experiments[experimentName]\r\n   133\t\tif !exists {\r\n"]
[247.687022, "o", "   134\t\t\treturn 0, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   135\t\t}\r\n   136\t\r\n   137\t\tif len(exp.Runs) == 0 {\r\n   138\t\t\treturn 0, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n   139\t\t}\r\n   140\t\r\n   141"]
[247.687104, "o", "\t\tvar values []float64\r\n   142\t\tvar weights []float64\r\n   143\t\tfor _, run := range exp.Runs {\r\n   144\t\t\tvalues = append(values, run.Metrics[metricName])\r\n   145\t\t\tif weightParam != \"\" {\r\n   146\t\t\t\tweights = append(weights, run.Parameters[weightParam])\r\n   147\t\t\t}\r\n   148\t\t}\r\n   149\t\r\n   150\t\tif len(values) == 0 {\r\n   151\t\t\treturn 0, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n   152\t\t}\r\n   153\t\r\n   154\t\tswitch aggType {\r\n"]
[247.687178, "o", "   155\t\tcase \"mean\":\r\n   156\t\t\tsum := 0.0\r\n   157\t\t\tfor _, v := range values {\r\n   158\t\t\t\tsum += v\r\n   159\t\t\t}\r\n   160\t\t\treturn sum / float64(len(values)), nil\r\n   161\t\r\n   162\t\tcase \"median\":\r\n"]
[247.68725, "o", "   163\t\t\tsorted := sortedCopy(values)\r\n   164\t\t\tn := len(sorted)\r\n   165\t\t\tif n%2 == 0 {\r\n   166\t\t\t\treturn (sorted[n/2-1] + sorted[n/2]) / 2, nil\r\n   167\t\t\t}\r\n   168\t\t\treturn sorted[n/2], nil\r\n   169\t\r\n   170\t\tcase \"p95\":\r\n   171\t\t\tsorted := sortedCopy(values)\r\n   172\t\t\treturn percentile(sorted, 0.95), nil\r\n   173\t\r\n   174\t\tcase \"p99\":\r\n"]
[247.687313, "o", "   175\t\t\tsorted := sortedCopy(values)\r\n   176\t\t\treturn percentile(sorted, 0.99), nil\r\n   177\t\r\n   178\t\tcase \"weighted_mean\":\r\n   179\t\t\tif len(weights) == 0 || len(weights) != len(values) {\r\n   180\t\t\t\treturn 0, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\n"]
[247.687377, "o", "   181\t\t\t}\r\n   182\t\t\tweightedSum := 0.0\r\n   183\t\t\tfor i, v := range values {\r\n   184\t\t\t\tweightedSum += v * weights[i]\r\n"]
[247.687438, "o", "   185\t\t\t}\r\n   186\t\t\treturn weightedSum / float64(len(values)), nil\r\n   187\t\r\n   188\t\tdefault:\r\n   189\t\t\treturn 0, fmt.Errorf(\"unknown aggregation type %q\", aggType)\r\n   190\t\t}\r\n   191\t}\r\n   192\t\r\n   193\tfunc percentile(sorted []float64, p float64) float64 {\r\n   194\t\tn := len(sorted)"]
[247.687497, "o", "\r\n   195\t\tif n == 0 {\r\n   196\t\t\treturn 0\r\n   197\t\t}\r\n   198\t\tif n == 1 {\r\n   199\t\t\treturn sorted[0]\r\n   200\t\t}\r\n"]
[247.687553, "o", "   201\t\trank := p * float64(n)\r\n   202\t\tlower := int(math.Floor(rank))\r\n   203\t\tupper := int(math.Ceil(rank))\r\n   204\t\tif lower == upper {\r\n   205\t\t\treturn sorted[lower]\r\n   206\t\t}\r\n"]
[247.687616, "o", "   207\t\tfrac := rank - float64(lower)\r\n   208\t\treturn sorted[lower]*(1-frac) + sorted[upper]*frac\r\n   209\t}\r\n   210\t\r\n   211\tfunc sortedCopy(values []float64) []float64 {\r\n   212\t\ts := make([]float64, len(values))\r\n   213\t\tcopy(s, values)\r\n"]
[247.687677, "o", "   214\t\tsort.Float64s(s)\r\n   215\t\treturn s\r\n   216\t}\r\n   217\t\r\n   218\tfunc (t *Tracker) loadAll() {\r\n   219\t\tentries, err := os.ReadDir(t.dataDir)\r\n   220\t\tif err != nil {\r\n"]
