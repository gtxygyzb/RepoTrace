[144.857585, "o", "   153\t// Supported operations: sum, mean, count, min, max.\r\n   154\tfunc ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   155\t\tdata, ok := input[\"data\"].([]interface{})\r\n   156\t\tif !ok {\r\n   157\t\t\treturn nil, fmt.Errorf(\"aggregate: missing or invalid 'data' field\")\r\n   158\t\t}\r\n   159\t\r\n   160\t\toperation, _ := config[\"operation\"].(string)\r\n   161\t\tif operation == \"\" {\r\n"]
[144.857644, "o", "   162\t\t\treturn nil, fmt.Errorf(\"aggregate: missing 'operation' in config\")\r\n   163\t\t}\r\n   164\t\r\n   165\t\tvalues := make([]float64, 0, len(data))\r\n   166\t\tfor _, v := range data {\r\n   167\t\t\tval, err := toFloat(v)\r\n   168\t\t\tif err != nil {\r\n   169\t\t\t\t"]
[144.857702, "o", "continue\r\n   170\t\t\t}\r\n   171\t\t\tvalues = append(values, val)\r\n   172\t\t}\r\n   173\t\r\n   174\t\tif len(values) == 0 {\r\n   175\t\t\treturn map[string]interface{}{\"result\": 0.0, \"count\": 0.0}, nil\r\n   176\t\t}\r\n"]
