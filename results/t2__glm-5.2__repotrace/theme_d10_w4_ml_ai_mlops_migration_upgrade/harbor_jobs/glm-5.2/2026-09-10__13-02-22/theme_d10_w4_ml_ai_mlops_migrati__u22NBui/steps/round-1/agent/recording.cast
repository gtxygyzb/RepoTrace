[6956.312463, "o", "\u001b[?2004h> "]
[6956.312519, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.312575, "o", "> \\t}\r\n\u001b[?2004l\r"]
[6956.312633, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
