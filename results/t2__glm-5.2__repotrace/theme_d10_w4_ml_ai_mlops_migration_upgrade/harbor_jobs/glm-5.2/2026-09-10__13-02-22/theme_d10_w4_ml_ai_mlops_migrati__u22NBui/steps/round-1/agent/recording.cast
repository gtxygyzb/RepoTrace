[2589.463095, "o", "func validateParameters(params []TemplateParameter) error {\r\n   259\t\tnames := make(map[string]bool)\r\n   260\t\tfor _, p := range params {\r\n   261\t\t\tif p.Name == \"\" {\r\n   262\t\t\t\treturn fmt.Errorf(\"parameter name is required\")\r\n   263\t\t\t}\r\n   264\t\t\tif names[p.Name] {\r\n   265\t\t\t\treturn fmt.Errorf(\"duplicate parameter name %q\", p.Name)\r\n   266\t\t\t}\r\n   267\t\t\tnames[p.Name] = true"]
