[2009.765385, "o", "\"gomlops/internal/pipeline\"\r\n    12\t\t\"gomlops/internal/registry\"\r\n    13\t\t\"gomlops/internal/serving\"\r\n    14\t)\r\n    15\t\r\n    16\t// --- Model Registry Handlers ---\r\n    17\t\r\n    18\tfunc (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {\r\n    19\t\tvar req struct {\r\n    20\t\t\tName        string   `json:\"name\"`\r\n    21\t\t\tFramework   string   `json:\"framework\"`\r\n    22\t\t\tDescription string   `json:\"description\"`\r\n    23\t\t\tTags        []string `json:\"tags\"`\r\n    24\t\t}\r\n    25\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n    26\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n    27\t\t\treturn\r\n    28\t\t}\r\n    29\t\tif req.Name == \"\" {\r\n    30\t\t\twriteError(w, http.StatusBadRequest, \"name is required\")\r\n"]
[2009.765484, "o", "    31\t\t\treturn\r\n    32\t\t}\r\n    33\t\r\n    34\t\tmodel, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)\r\n    35\t\tif err != nil {\r\n    36\t\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n    37\t\t\treturn\r\n"]
[2009.765552, "o", "    38\t\t}\r\n    39\t\twriteJSON(w, http.StatusCreated, model)\r\n    40\t}\r\n    41\t\r\n    42\tfunc (h *Handlers) ListModels(w http.ResponseWriter, r *http.Request) {\r\n    43\t\tvar filter *registry.ModelFilter\r\n    44\t\tframework := r.URL.Query().Get(\"framework\")\r\n    45\t\ttag := r.URL.Query().Get(\"tag\")\r\n    46\t\tif framework != \"\" || tag != \"\" {\r\n    47\t\t\tfilter = &registry.ModelFilter{Framework: framework, Tag: tag}\r\n    48\t\t}\r\n    49\t\r\n    50\t\tmodels, err := h.Registry.ListModels(filter)\r\n    51\t\tif err != nil {\r\n    52\t\t\twriteError(w, http.StatusInternalServerError, \"%v\", err)\r\n    53\t\t\treturn\r\n    54\t\t}\r\n"]
