[794.420772, "i", "python3 - <<'PY'\nimport json, urllib.request, urllib.error, time\n\nBASE = \"http://localhost:8080/api/v1\"\n\ndef req(method, path, body=None):\n    data = json.dumps(body).encode() if body is not None else None\n    r = urllib.request.Request(BASE+path, data=data, method=method, headers={\"Content-Type\":\"application/json\"})\n    try:\n        with urllib.request.urlopen(r, timeout=5) as resp:\n            return resp.status, json.loads(resp.read().decode())\n    except urllib.error.HTTPError as e:\n        return e.code, json.loads(e.read().decode())\n\nsuf = str(int(time.time()*1000))[-6:]\nresults = []\ndef check(name, cond, detail=\"\"):\n    results.append((name, cond, detail))\n    print((\"PASS\" if cond else \"FAIL\"), name, detail)\n\n# Registry\nm = \"reg\"+suf\nst, b = req(\"POST\", \"/models\", {\"name\": m, \"framework\": \"linear\", \"description\": \"d\", \"tags\": [\"t1\"]})\ncheck(\"register model\", st==201, b)\nst, b = req(\"POST\", f\"/models/{m}/versions\", {\"metrics\": {\"acc\":0.8}, \"tags\": [\"v1\"], \"model_config\": {\"model_type\":\"linear\",\"weights"]
[794.421093, "i", "\":[2,3],\"bias\":1}})\ncheck(\"create v1 dev\", st==201 and b.get(\"stage\")==\"development\" and b.get(\"number\")==1, b)\nreq(\"POST\", f\"/models/{m}/versions\", {\"metrics\": {\"acc\":0.82}, \"tags\": [\"v2\"], \"model_config\": {\"model_type\":\"linear\",\"weights\":[1,1],\"bias\":0}})\nst, b = req(\"GET\", f\"/models/{m}\")\ncheck(\"versions desc\", [v[\"number\"] for v in b[\"versions\"]]==[2,1], b)\ncheck(\"invalid transition dev->prod\", req(\"PUT\", f\"/models/{m}/versions/1/promote\", {\"stage\":\"production\"})[0]==400)\nreq(\"PUT\", f\"/models/{m}/versions/1/promote\", {\"stage\":\"staging\"})\nreq(\"PUT\", f\"/models/{m}/versions/1/promote\", {\"stage\":\"production\"})\nreq(\"PUT\", f\"/models/{m}/versions/2/promote\", {\"stage\":\"staging\"})\nreq(\"PUT\", f\"/models/{m}/versions/2/promote\", {\"stage\":\"production\"})\nst, b = req(\"GET\", f\"/models/{m}\")\nstages = {v[\"number\"]:v[\"stage\"] for v in b[\"versions\"]}\ncheck(\"single production demotes old\", stages=={1:\"archived\",2:\"production\"}, stages)\ncheck(\"list filter framework\", req(\"GET\",\"/models?framework=linear\")[0]==200)\ncheck(\"list f"]
[794.421182, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
