[5681.966343, "o", "   145\t\tvalid := len(errors) == 0\r\n   146\t\treturn map[string]interface{}{\r\n   147\t\t\t\"valid\":  valid,\r\n   148\t\t\t\"errors\": errors,\r\n   149\t\t\t\"data\":   data,\r\n   150\t\t}, nil\r\n   151\t}\r\n   152\t\r\n   153\t// ExecuteAggregate computes aggregations over input data.\r\n   154\t// Supported operations: sum, mean, count, min, max.\r\n   155\tfunc ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   156\t\tdata, ok := input[\"data\"].([]interface{})\r\n   157\t\tif !ok {\r\n   158\t\t\treturn nil, fmt.Errorf(\"aggregate: missing or invalid 'data' field\")\r\n   159\t\t}\r\n   160\t\r\n   161\t\toperation, _ := config[\"operation\"].(string)\r\n   162\t\tif operation == \"\" {\r\n   163\t\t\treturn nil, fmt.Errorf(\"aggregate: missing 'operation' in config\")\r\n"]
[5681.96642, "o", "   164\t\t}\r\n   165\t\r\n   166\t\tvalues := make([]float64, 0, len(data))\r\n   167\t\tfor _, v := range data {\r\n   168\t\t\tval, err := toFloat(v)\r\n   169\t\t\tif err != nil {\r\n   170\t"]
