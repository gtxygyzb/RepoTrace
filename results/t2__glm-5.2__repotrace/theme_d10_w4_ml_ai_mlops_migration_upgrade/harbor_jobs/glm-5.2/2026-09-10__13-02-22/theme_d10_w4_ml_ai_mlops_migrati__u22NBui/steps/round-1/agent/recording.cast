[4519.399139, "i", "c (e *Engine) executeWithRetryAndTimeout(executor StepExecutor, config, input map[string]interface{}, retry, timeoutMs int) (map[string]interface{}, error, int, bool) {\n\\tmaxAttempts := retry + 1\n\\tif maxAttempts < 1 {\n\\t\\tmaxAttempts = 1\n\\t}\n\n\\tvar output map[string]interface{}\n\\tvar err error\n\\tfor attempt := 0; attempt < maxAttempts; attempt++ {\n\\t\\ttype execResult struct {\n\\t\\t\\toutput map[string]interface{}\n\\t\\t\\terr    error\n\\t\\t}\n\\t\\tresChan := make(chan execResult, 1)\n\\t\\tstart := time.Now()\n\\t\\tgo func() {\n\\t\\t\\tout, e := executor(config, input)\n\\t\\t\\tresChan <- execResult{output: out, err: e}\n\\t\\t}()\n\n\\t\\tif timeoutMs > 0 {\n\\t\\t\\tselect {\n\\t\\t\\tcase res := <-resChan:\n\\t\\t\\t\\toutput, err = res.output, res.err\n\\t\\t\\tcase <-time.After(time.Duration(timeoutMs)*time.Millisecond - time.Since(start)):\n\\t\\t\\t\\treturn nil, nil, attempt, true\n\\t\\t\\t}\n\\t\\t} else {\n\\t\\t\\tres := <-resChan\n\\t\\t\\toutput, err = res.output, res.err\n\\t\\t}\n\n\\t\\tif err == nil {\n\\t\\t\\treturn output, nil, attempt, false\n\\t\\t}\n\\t}\n\n\\tretu"]
