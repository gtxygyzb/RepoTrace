[4172.102485, "o", "   217\t\t\t\t\t}\r\n   218\t\t\t\t}\r\n   219\t\t\t\tresult = maxVal - minVal\r\n   220\t\t\t}\r\n   221\t\tdefault:\r\n   222\t\t\treturn nil, fmt.Errorf(\"aggregate: unknown operation %q\", operation)\r\n   223\t\t}\r\n   224\t\r\n   225\t\treturn map[string]interface{}{\r\n   226\t\t\t\"result\": result,\r\n   227\t\t\t\"count\":  float64(len(values)),\r\n   228\t\t\t\"data\":   data,\r\n   229\t\t}, nil\r\n"]
