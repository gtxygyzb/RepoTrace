[4680.591782, "i", "put: out, err: e}\n\\t\\t}()\n\n\\t\\tif timeoutMs > 0 {\n\\t\\t\\tremaining := time.Until(deadline)\n\\t\\t\\tif remaining <= 0 {\n\\t\\t\\t\\treturn nil, nil, attempt, true\n\\t\\t\\t}\n\\t\\t\\tselect {\n\\t\\t\\tcase res := <-resChan:\n\\t\\t\\t\\toutput, err = res.output, res.err\n\\t\\t\\tcase <-time.After(remaining):\n\\t\\t\\t\\treturn nil, nil, attempt, true\n\\t\\t\\t}\n\\t\\t} else {\n\\t\\t\\tres := <-resChan\n\\t\\t\\toutput, err = res.output, res.err\n\\t\\t}\n\n\\t\\tif err == nil {\n\\t\\t\\treturn output, nil, attempt, false\n\\t\\t}\n\\t}\n\n\\treturn output, err, maxAttempts - 1, false\n}\n'''\nif old not in s:\n    raise SystemExit('old function not found')\ns = s.replace(old, new)\np.write_text(s)\nPY\ngofmt -w internal/registry/registry.go internal/experiment/experiment.go internal/pipeline/engine.go internal/pipeline/steps.go internal/serving/serving.go internal/api/batch.go internal/api/handlers.go internal/api/router.go\ngo build ./...\ngo test ./...\n"]
