[2959.905401, "o", "\t\"sync\"\r\n    11\t\t\"time\"\r\n    12\t)\r\n    13\t\r\n    14\t// Experiment groups related runs together.\r\n    15\ttype Experiment struct {\r\n    16\t\tName      string    `json:\"name\"`\r\n    17\t\tRuns      []*Run    `json:\"runs\"`\r\n    18\t\tCreatedAt time.Time `json:\"created_at\"`\r\n    19\t}\r\n    20\t\r\n    21\t// Run records a single experiment execution with parameters and metrics.\r\n    22\ttype Run struct {\r\n    23\t\tID         string             `json:\"id\"`\r\n    24\t\tParameters map[string]float64 `json:\"parameters\"`\r\n    25\t\tMetrics    map[string]float64 `json:\"metrics\"`\r\n    26\t\tTags       map[string]string  `json:\"tags\"`\r\n    27\t\tCreatedAt  time.Time          `json:\"created_at\"`\r\n    28\t}\r\n    29\t\r\n    30\t// Tracker manages experiments and their runs.\r\n    31\ttype Tracker struct {\r\n    32\t\tmu          sync.RWMutex\r\n    33\t\texperiments map[string]*Experiment\r\n    34\t\tdataDir     string\r\n    35\t\trunCounter  int\r\n    36"]
[2959.905487, "o", "\t}\r\n    37\t\r\n    38\t// NewTracker creates a new experiment tracker backed by the given data directory.\r\n    39\tfunc NewTracker(dataDir string) *Tracker {\r\n    40\t\tos.MkdirAll(dataDir, 0755)\r\n    41\t\tt := &Tracker{\r\n"]
[2959.905614, "o", "    42\t\t\texperiments: make(map[string]*Experiment),\r\n    43\t\t\tdataDir:     dataDir,\r\n    44\t\t}\r\n    45\t\tt.loadAll()\r\n    46\t\treturn t\r\n    47\t}\r\n    48\t\r\n    49\t// CreateExperiment creates a new experiment with the given name.\r\n    50\tfunc (t *Tracker) CreateExperiment(name string) (*Experiment, error) {\r\n    51\t\tt.mu.Lock()\r\n    52\t\tdefer t.mu.Unlock()\r\n    53\t\r\n    54\t\tif _, exists := t.experiments[name]; exists {\r\n    55\t\t\treturn nil, fmt.Errorf(\"experiment %q already exists\", name)\r\n    56\t\t}\r\n    57\t\r\n    58\t\texp := &Experiment{\r\n    59\t\t\tName:      name,\r\n    60\t\t\tRuns:      make([]*Run, 0),\r\n    61\t\t\tCreatedAt: time.Now(),\r\n    62\t\t}\r\n    63\t\tt.experiments[name] = exp\r\n    64\t\tif err := t.saveExperiment(exp); err != nil {\r\n    65\t\t\tdelete(t.experiments, name)\r\n"]
[2959.905688, "o", "    66\t\t\treturn nil, err\r\n    67\t\t}\r\n    68\t\treturn exp, nil\r\n    69\t}\r\n    70\t\r\n    71\t// LogRun adds a new run to the specified experiment.\r\n    72\tfunc (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {\r\n    73\t\tt.mu.Lock()\r\n    74\t\tdefer t.mu.Unlock()\r\n    75\t\r\n    76\t\texp, exists := t.experiments[experimentName]\r\n    77\t\tif !exists {\r\n"]
[2959.905766, "o", "    78\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n    79\t\t}\r\n    80\t\r\n    81\t\tt.runCounter++\r\n    82\t\trun := &Run{\r\n    83\t"]
[2959.905836, "o", "\t\tID:         fmt.Sprintf(\"run_%d\", t.runCounter),\r\n    84\t\t\tParameters: params,\r\n    85\t\t\tMetrics:    metrics,\r\n    86\t\t\tTags:       tags,\r\n    87\t\t\tCreatedAt:  time.Now(),\r\n    88\t\t}\r\n    89\t\texp.Runs = append(exp.Runs, run)\r\n    90\t\r\n    91\t\tif err := t.saveExperiment(exp); err != nil {\r\n    92\t\t\texp.Runs = exp.Runs[:len(exp.Runs)-1]\r\n    93\t\t\treturn nil, err\r\n    94\t\t}\r\n    95\t\treturn run, nil\r\n    96\t}\r\n    97\t\r\n    98\t// GetExperiment returns the experiment with the given name.\r\n    99"]
[2959.905941, "o", "\tfunc (t *Tracker) GetExperiment(name string) (*Experiment, error) {\r\n   100\t\tt.mu.RLock()\r\n   101\t\tdefer t.mu.RUnlock()\r\n   102\t\r\n   103\t\texp, exists := t.experiments[name]\r\n   104\t\tif !exists {\r\n   105\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", name)\r\n   106\t\t}\r\n   107\t\treturn exp, nil\r\n   108\t}\r\n   109\t\r\n   110\t// ListExperiments returns all experiments.\r\n   111\tfunc (t *Tracker) ListExperiments() []*Experiment {\r\n   112\t\tt.mu.RLock()\r\n"]
[2959.906034, "o", "   113\t\tdefer t.mu.RUnlock()\r\n   114\t\r\n   115\t\tresult := make([]*Experiment, 0, len(t.experiments))\r\n   116\t\tfor _, exp := range t.experiments {\r\n   117\t\t\tresult = append(result, exp)\r\n   118\t\t}\r\n   119\t\tsort.Slice(result, func(i, j int) bool {\r\n   120"]
[2959.906127, "o", "\t\t\treturn result[i].Name < result[j].Name\r\n"]
