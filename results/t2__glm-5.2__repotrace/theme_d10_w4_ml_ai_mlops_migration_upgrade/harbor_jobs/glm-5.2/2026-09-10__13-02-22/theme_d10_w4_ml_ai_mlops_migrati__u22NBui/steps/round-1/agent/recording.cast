[6656.873197, "o", "   538\t}\r\n   539\t\r\n   540\t// mergeDependencyOutputs concatenates the \"data\" arrays from all dependency outputs into a single input.\r\n   541\tfunc mergeDependencyOutputs(deps []string, outputs map[string]map[string]interface{}) map[string]interface{} {\r\n   542\t\tmerged := make([]interface{}, 0)\r\n   543\t\tfor _, dep := range deps {\r\n   544\t\t\tout, ok := outputs[dep]\r\n   545\t\t\tif !ok {\r\n   546\t\t\t\tcontinue\r\n   547\t\t\t}\r\n"]
[6656.873279, "o", "   548\t\t\tswitch data := out[\"data\"].(type) {\r\n   549\t\t\tcase []interface{}:\r\n   550\t\t\t\tmerged = append(merged, data...)\r\n   551\t\t\tcase []float64:\r\n   552\t\t\t\tfor _, v := range data {\r\n   553\t\t\t\t\tmerged = append(merged, v)\r\n   554\t\t\t\t}\r\n   555\t\t\t}\r\n"]
[6656.873344, "o", "   556\t\t}\r\n   557\t\treturn map[string]interface{}{\"data\": merged}\r\n   558\t}\r\n   559\t\r\n   560\tfunc computeTransitiveDependencies(steps []*Step) map[string]map[string]bool {\r\n"]
