[6377.535874, "o", "./configs/config.json\r\n./data/experiments/corr_clone.json\r\n./data/experiments/corr_exp.json\r\n./data/experiments/corr_few.json\r\n./data/experiments/corr_partial.json\r\n./data/experiments/corr_pos.json\r\n./data/experiments/corr_src.json\r\n"]
[6377.53598, "o", "./data/experiments/corr_zero.json\r\n./data/experiments/four_exp.json\r\n./data/experiments/reg_clone.json\r\n./data/experiments/reg_src.json\r\n./data/experiments/six_exp.json\r\n./data/experiments/small_exp.json\r\n./data/experiments/tag_trim.json\r\n./data/experiments/tm_clone.json\r\n./data/experiments/tm_float.json\r\n./data/experiments/tm_src.json\r\n./data/experiments/trim_exp.json\r\n./data/registry/ann_mod.json\r\n./data/registry/ann_rb.json\r\n./data/registry/batch_reg.json\r\n./data/registry/demote_r6.json\r\n"]
[6377.536045, "o", "./data/registry/dep_a.json\r\n./data/registry/dep_b.json\r\n./data/registry/diff_mod.json\r\n./data/registry/diff_mod2.json\r\n./data/registry/empty_diff.json\r\n./data/registry/h_tag.json\r\n./data/registry/rb_mod.json\r\n./data/registry/reg_vf.json\r\n./data/registry/tag_mod.json\r\n"]
[6377.536142, "o", "./docs/api-v1.md\r\n./go.mod\r\n./gomlops\r\n./internal/api/batch.go\r\n./internal/api/handlers.go\r\n"]
[6377.536199, "o", "./internal/api/router.go\r\n./internal/api/templates.go\r\n./internal/experiment/experiment.go\r\n./internal/pipeline/engine.go\r\n./internal/pipeline/steps.go\r\n./internal/registry/registry.go\r\n./internal/serving/serving.go\r\n./main.go\r\n"]
