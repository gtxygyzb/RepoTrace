[4016.774893, "o", "     1\tpackage registry\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n"]
[4016.775029, "o", "     6\t\t\"os\"\r\n     7\t\t\"path/filepath\"\r\n     8\t\t\"regexp\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"sync\"\r\n    11\t\t\"time\"\r\n"]
[4016.775102, "o", "    12\t)\r\n    13\t\r\n    14\t// Stage represents the lifecycle stage of a model version.\r\n    15\ttype Stage string\r\n    16\t\r\n    17\tconst (\r\n    18\t\tStageDevelopment Stage = \"development\"\r\n    19\t\tStageStaging     Stage = \"staging\"\r\n    20\t\tStageProduction  Stage = \"production\"\r\n    21\t\tStageArchived    Stage = \"archived\"\r\n    22\t)\r\n    23\t\r\n    24\tvar validTransitions = map[Stage][]Stage{\r\n    25\t\tStageDevelopment: {StageStaging, StageArchived},\r\n    26\t\tStageStaging:     {StageProduction, StageArchived},\r\n    27\t\tStageProduction:  {StageArchived},\r\n    28\t\tStageArchived:    {},\r\n    29\t}\r\n    30\t\r\n    31\t// Version represents a specific version of a model.\r\n    32\ttype Version struct {\r\n    33\t\tNumber      int                    `json:\"number\"`\r\n    34\t"]
[4016.775187, "o", "\tStage       Stage                  `json:\"stage\"`\r\n    35\t\tMetrics     map[string]float64     `json:\"metrics\"`\r\n    36\t\tTags        []string               `json:\"tags\"`\r\n    37\t\tModelConfig map[string]interface{} `json:\"model_config,omitempty\"`\r\n    38\t\tCreatedAt   time.Time              `json:\"created_at\"`\r\n"]
[4016.775256, "o", "    39\t}\r\n    40\t\r\n    41\t// Model represents a registered ML model.\r\n    42\ttype Model struct {\r\n    43\t\tName        string     `json:\"name\"`\r\n    44\t\tFramework   string     `json:\"framework\"`\r\n    45\t\tDescription string     `json:\"description\"`\r\n    46\t\tTags        []string   `json:\"tags\"`\r\n    47\t\tVersions    []*Version `json:\"versions\"`\r\n    48\t\tCreatedAt   time.Time  `json:\"created_at\"`\r\n    49\t\tUpdatedAt   time.Time  `json:\"updated_at\"`\r\n    50\t}\r\n    51\t\r\n    52\t// ModelFilter defines filtering criteria for listing models.\r\n    53\ttype ModelFilter struct {\r\n    54\t\tFramework string\r\n"]
[4016.775322, "o", "    55\t\tTag       string\r\n    56\t}\r\n    57\t\r\n    58\t// Annotation represents a key-value annotation attached to a model version.\r\n    59\ttype Annotation struct {\r\n    60"]
[4016.775384, "o", "\t\tKey       string    `json:\"key\"`\r\n    61\t\tValue     string    `json:\"value\"`\r\n    62\t\tCreatedAt time.Time `json:\"created_at\"`\r\n    63\t}\r\n    64\t\r\n    65\tvar annotationKeyRegexp = regexp.MustCompile(`^[A-Za-z0-9_]+$`)\r\n    66\t\r\n    67\t// Registry manages model registration, versioning, and lifecycle.\r\n    68\ttype Registry struct {\r\n    69\t\tmu          sync.RWMutex\r\n    70\t\tmodels      map[string]*Model\r\n    71\t\tdataDir     string\r\n    72\t\tannotations map[string]map[int]map[string]*Annotation\r\n    73\t}\r\n"]
[4016.775443, "o", "    74\t\r\n    75\t// NewRegistry creates a new Registry backed by the given data directory.\r\n    76\tfunc NewRegistry(dataDir string) (*Registry, error) {\r\n    77\t\tif err := os.MkdirAll(dataDir, 0755); err != nil {\r\n    78\t\t\treturn nil, fmt.Errorf(\"create data dir: %w\", err)\r\n    79\t\t}\r\n    80\t\tr := &Registry{\r\n    81\t\t\tmodels:      make(map[string]*Model),\r\n    82\t\t\tdataDir:     dataDir,\r\n    83\t\t\tannotations: make(map[string]map[int]map[string]*Annotation),\r\n"]
[4016.775506, "o", "    84\t\t}\r\n    85\t\tif err := r.loadAll(); err != nil {\r\n    86\t\t\treturn nil, fmt.Errorf(\"load registry: %w\", err)\r\n    87\t\t}\r\n    88\t\treturn r, nil\r\n    89\t}\r\n    90\t\r\n    91\t// RegisterModel creates a new model entry in the registry.\r\n"]
[4016.775566, "o", "    92\tfunc (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {\r\n    93\t\tr.mu.Lock()\r\n    94\t\tdefer r.mu.Unlock()\r\n    95\t\r\n    96\t\tif _, exists := r.models[name]; exists {\r\n    97\t\t\treturn nil, fmt.Errorf(\"model %q already exists\", name)\r\n    98\t\t}\r\n    99\t\r\n   100\t\tnow := time.Now()\r\n"]
[4016.775627, "o", "   101\t\tmodel := &Model{\r\n   102\t\t\tName:        name,\r\n   103\t\t\tFramework:   framework,\r\n   104\t\t\tDescription: description,\r\n   105\t\t\tTags:        tags,\r\n   106\t\t\tVersions:    make([]*Version, 0),\r\n   107\t\t\tCreatedAt:   now,\r\n   108\t\t\tUpdatedAt:   now,\r\n"]
[4016.775685, "o", "   109\t\t}\r\n   110\t\tr.models[name] = model\r\n   111\t\tif err := r.saveModel(model); err != nil {\r\n   112\t\t\tdelete(r.models, name)\r\n   113\t\t\treturn nil, err\r\n   114\t\t}\r\n   115\t\treturn model, nil\r\n   116\t}\r\n"]
[4016.775744, "o", "   117\t\r\n   118\t// CreateVersion adds a new version to the specified model.\r\n   119\tfunc (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {\r\n   120\t\tr.mu.Lock()\r\n   121\t\tdefer r.mu.Unlock()\r\n   122\t\r\n   123\t\tmodel, exists := r.models[modelName]\r\n   124\t\tif !exists {\r\n   125"]
[4016.775806, "o", "\t\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n   126\t\t}\r\n   127\t\r\n   128\t\tnextNum := 1\r\n   129\t\tfor _, v := range model.Versions {\r\n   130\t\t\tif v.Number >= nextNum {\r\n   131\t\t\t\tnextNum = v.Number + 1\r\n   132\t\t\t}\r\n   133\t\t}\r\n"]
[4016.775896, "o", "   134\t\r\n   135\t\tversion := &Version{\r\n   136\t\t\tNumber:      nextNum,\r\n   137\t\t\tStage:       StageDevelopment,\r\n   138\t\t\tMetrics:     metrics,\r\n   139\t\t\tTags:        tags,\r\n   140\t\t\tModelConfig: modelConfig,\r\n   141\t\t\tCreatedAt:   time.Now(),\r\n   142\t\t}\r\n   143\t\tmodel.Versions = append(model.Versions, version)\r\n   144\t\tmodel.UpdatedAt = time.Now()\r\n   145\t\r\n"]
[4016.775954, "o", "   146\t\tif err := r.saveModel(model); err != nil {\r\n   147\t\t\tmodel.Versions = model.Versions[:len(model.Versions)-1]\r\n   148\t\t\treturn nil, err\r\n   149\t\t}\r\n   150\t\treturn version, nil\r\n"]
