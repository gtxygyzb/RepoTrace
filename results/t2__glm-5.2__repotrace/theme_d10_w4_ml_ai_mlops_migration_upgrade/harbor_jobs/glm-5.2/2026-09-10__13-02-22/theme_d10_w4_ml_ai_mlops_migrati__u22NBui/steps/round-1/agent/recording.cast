[4186.447967, "o", "\t\t\tm.AvgLatencyMs = model.LatencySum / float64(model.Successful)\r\n   207\t\t\t}\r\n   208\t\t\tresp.Models[name] = m\r\n   209\t\t}\r\n   210\t\treturn resp\r\n   211\t}\r\n   212\t\r\n   213\t// ResetStats resets all serving statistics to zero.\r\n   214\tfunc (s *Server) ResetStats() {\r\n   215\t\ts.mu.Lock()\r\n   216\t\tdefer s.mu.Unlock()\r\n   217\t\r\n   218\t\ts.stats = Stats{\r\n   219\t\t\tModels: make(map[string]*ModelStats),\r\n   220\t\t}\r\n"]
