[134.756292, "o", "package experiment\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
[134.756369, "o", "\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\n// Experiment groups related runs together.\r\ntype Experiment struct {\r\n\tName      string    `json:\"name\"`\r\n\tRuns      []*Run    `json:\"runs\"`\r\n\tCreatedAt time.Time `json:\"created_at\"`\r\n}\r\n\r\n"]
[134.756489, "o", "// Run records a single experiment execution with parameters and metrics.\r\ntype Run struct {\r\n\tID         string             `json:\"id\"`\r\n\tParameters map[string]float64 `json:\"parameters\"`\r\n\tMetrics    map[string]float64 `json:\"metrics\"`\r\n\tTags       map[string]string  `json:\"tags\"`\r\n\tCreatedAt  time.Time          `json:\"created_at\"`\r\n}\r\n\r\n// Tracker manages experiments and their runs.\r\ntype Tracker struct {\r\n\tmu          sync.RWMutex\r\n\texperiments map[string]*Experiment\r\n\tdataDir     string\r\n\trunCounter  int\r\n}\r\n\r\n// NewTracker creates a new experiment tracker backed by the given data directory.\r\n"]
[134.756567, "o", "func NewTracker(dataDir string) *Tracker {\r\n\tos.MkdirAll(dataDir, 0755)\r\n\tt := &Tracker{\r\n\t\texperiments: make(map[string]*Experiment),\r\n\t\tdataDir:     dataDir,\r\n\t}\r\n\tt.loadAll()\r\n\treturn t\r\n}\r\n\r\n// CreateExperiment creates a new experiment with the given name.\r\nfunc (t *Tracker) CreateExperiment(name string) (*Experiment, error) {\r\n\tt.mu.Lock()\r\n\tdefer t.mu.Unlock()\r\n\r\n\tif _, exists := t.experiments[name]; exists {\r\n"]
[134.756629, "o", "\t\treturn nil, fmt.Errorf(\"experiment %q already exists\", name)\r\n\t}\r\n\r\n\texp := &Experiment{\r\n\t\tName:      name,\r\n\t\tRuns:      make([]*Run, 0),\r\n\t\tCreatedAt: time.Now(),\r\n\t}\r\n\tt.experiments[name] = exp\r\n\tif err := t.saveExperiment(exp); err != nil {\r\n\t\tdelete(t.experiments, name)\r\n"]
[134.756723, "o", "\t\treturn nil, err\r\n\t}\r\n\treturn exp, nil\r\n}\r\n\r\n// LogRun adds a new run to the specified experiment.\r\nfunc (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {\r\n\tt.mu.Lock()\r\n\tdefer t.mu.Unlock()\r\n\r\n\texp, exists := t.experiments[experimentName]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\t}\r\n\r\n\tt.runCounter++\r\n\trun := &Run{\r\n"]
[134.756791, "o", "\t\tID:         fmt.Sprintf(\"run_%d\", t.runCounter),\r\n\t\tParameters: params,\r\n\t\tMetrics:    metrics,\r\n\t\tTags:       tags,\r\n\t\tCreatedAt:  time.Now(),\r\n\t}\r\n\texp.Runs = append(exp.Runs, run)\r\n\r\n\tif err := t.saveExperiment(exp); err != nil {\r\n\t\texp.Runs = exp.Runs[:len(exp.Runs)-1]\r\n\t\treturn nil, err\r\n"]
[134.756897, "o", "\t}\r\n\treturn run, nil\r\n}\r\n\r\n// GetExperiment returns the experiment with the given name.\r\nfunc (t *Tracker) GetExperiment(name string) (*Experiment, error) {\r\n\tt.mu.RLock()\r\n\tdefer t.mu.RUnlock()\r\n\r\n\texp, exists := t.experiments[name]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"experiment %q not found\", name)\r\n"]
[134.756977, "o", "\t}\r\n\treturn exp, nil\r\n}\r\n\r\n// ListExperiments returns all experiments.\r\nfunc (t *Tracker) ListExperiments() []*Experiment {\r\n\tt.mu.RLock()\r\n\tdefer t.mu.RUnlock()\r\n\r\n\tresult := make([]*Experiment, 0, len(t.experiments))\r\n\tfor _, exp := range t.experiments {\r\n\t\tresult = append(result, exp)\r\n\t}\r\n\tsort.Slice(result, func(i, j int) bool {\r\n\t\treturn result[i].Name < result[j].Name\r\n\t})\r\n\treturn result\r\n}"]
[134.757044, "o", "\r\n\r\n// AggregateMetric computes an aggregate statistic for a given metric across all runs\r\n// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.\r\n// For weighted_mean, weightParam specifies which parameter to use as weight.\r\nfunc (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, error) {\r\n\tt.mu.RLock()\r\n\tdefer t.mu.RUnlock()\r\n\r\n\texp, exists := t.experiments[experimentName]\r\n\tif !exists {\r\n\t\treturn 0, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\t"]
[134.757106, "o", "}\r\n\r\n\tif len(exp.Runs) == 0 {\r\n\t\treturn 0, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n\t}\r\n\r\n\tvar values []float64\r\n\tvar weights []float64\r\n\tfor _, run := range exp.Runs {\r\n\t\tvalues = append(values, run.Metrics[metricName])\r\n\t\tif weightParam != \"\" {\r\n"]
[134.757165, "o", "\t\t\tweights = append(weights, run.Parameters[weightParam])\r\n\t\t}\r\n\t}\r\n\r\n\tif len(values) == 0 {\r\n\t\treturn 0, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n\t}\r\n\r\n\tswitch aggType {\r\n\tcase \"mean\":\r\n"]
[134.757225, "o", "\t\tsum := 0.0\r\n\t\tfor _, v := range values {\r\n\t\t\tsum += v\r\n\t\t}\r\n\t\treturn sum / float64(len(values)), nil\r\n\r\n\tcase \"median\":\r\n\t\tsorted := sortedCopy(values)\r\n"]
[134.757292, "o", "\t\tn := len(sorted)\r\n\t\tif n%2 == 0 {\r\n\t\t\treturn (sorted[n/2-1] + sorted[n/2]) / 2, nil\r\n\t\t}\r\n"]
[134.757356, "o", "\t\treturn sorted[n/2], nil\r\n\r\n\tcase \"p95\":\r\n\t\tsorted := sortedCopy(values)\r\n\t\treturn percentile(sorted, 0.95), nil\r\n\r\n\tcase \"p99\":\r\n\t\tsorted := sortedCopy(values)\r\n\t\treturn percentile(sorted, 0.99), nil\r\n\r\n\tcase \"weighted_mean\":\r\n\t\tif len(weights) == 0 || len(weights) != len(values) {\r\n\t\t\treturn 0, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\n\t\t}\r\n\t\tweightedSum := 0.0\r\n\t\tfor i, v := range values {"]
[134.757421, "o", "\r\n\t\t\tweightedSum += v * weights[i]\r\n\t\t}\r\n\t\treturn weightedSum / float64(len(values)), nil\r\n\r\n"]
[134.757477, "o", "\tdefault:\r\n\t\treturn 0, fmt.Errorf(\"unknown aggregation type %q\", aggType)\r\n\t}\r\n}\r\n\r\nfunc percentile(sorted []float64, p float64) float64 {\r\n\tn := len(sorted)\r\n\tif n == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tif n == 1 {\r\n\t\treturn sorted[0]\r\n\t}\r\n\trank := p * float64(n)\r\n\tlower := int(math.Floor(rank))\r\n\tupper := int(math.Ceil(rank))\r\n"]
[134.757539, "o", "\tif lower == upper {\r\n\t\treturn sorted[lower]\r\n\t}\r\n\tfrac := rank - float64(lower)\r\n\treturn sorted[lower]*(1-frac) + sorted[upper]*frac\r\n}\r\n\r\nfunc sortedCopy(values []float64) []float64 {\r\n\ts := make([]float64, len(values))\r\n\tcopy(s, values)\r\n\tsort.Float64s(s)\r\n"]
[134.757607, "o", "\treturn s\r\n}\r\n\r\nfunc (t *Tracker) loadAll() {\r\n\tentries, err := os.ReadDir(t.dataDir)\r\n\tif err != nil {\r\n\t\treturn\r\n\t}\r\n\tfor _, entry := range entries {\r\n\t\tif !entry.IsDir() && filepath.Ext(entry.Name()) == \".json\" {\r\n\t\t\tdata, err := os.ReadFile(filepath.Join(t.dataDir, entry.Name()))\r\n\t"]
[134.757663, "o", "\t\tif err != nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvar exp Experiment\r\n\t\t\tif err := json.Unmarshal(data, &exp); err != nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
[134.757726, "o", "\t\t\tt.experiments[exp.Name] = &exp\r\n\t\t\tfor _, r := range exp.Runs {\r\n\t\t\t\t_ = r\r\n\t\t\t\tt.runCounter++\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc (t *Tracker) saveExperiment(exp *Experiment) error {\r\n"]
[134.757782, "o", "\tdata, err := json.MarshalIndent(exp, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tfilename := filepath.Join(t.dataDir, exp.Name+\".json\")\r\n\treturn os.WriteFile(filename, data, 0644)\r\n}\r\n"]
