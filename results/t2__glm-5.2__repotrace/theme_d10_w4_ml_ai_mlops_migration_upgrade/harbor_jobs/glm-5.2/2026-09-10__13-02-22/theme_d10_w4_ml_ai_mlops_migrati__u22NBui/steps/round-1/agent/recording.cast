[5714.176101, "o", "if tags == nil {\r\n   114\t\t\ttags = []string{}\r\n   115\t\t}\r\n   116\t\tmodel := &Model{\r\n   117\t\t\tName:         name,\r\n   118\t\t\tFramework:    framework,\r\n   119\t\t\tDescription:  description,\r\n   120\t\t\tTags:         tags,\r\n   121\t\t\tVersions:     make([]*Version, 0),\r\n   122\t\t\tDependencies: []string{},\r\n   123\t\t\tCreatedAt:    now,\r\n   124\t\t\tUpdatedAt:    now,\r\n   125\t\t}\r\n   126\t\tr.models[name] = model\r\n   127\t\tr.dependencies[name] = []string{}\r\n   128\t\tif err := r.saveModel(model); err != nil {\r\n   129\t\t\tdelete(r.models, name)\r\n"]
