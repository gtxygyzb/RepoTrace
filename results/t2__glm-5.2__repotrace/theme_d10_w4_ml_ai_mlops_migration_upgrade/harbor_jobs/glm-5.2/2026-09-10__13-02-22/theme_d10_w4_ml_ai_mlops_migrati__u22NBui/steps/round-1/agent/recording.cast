[6956.311768, "o", "\u001b[?2004h> "]
[6956.311974, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[6956.312031, "o", "\u001b[?2004h> "]
[6956.312087, "o", "\\t\\t} else {\r\n\u001b[?2004l\r"]
[6956.312144, "o", "\u001b[?2004h> "]
