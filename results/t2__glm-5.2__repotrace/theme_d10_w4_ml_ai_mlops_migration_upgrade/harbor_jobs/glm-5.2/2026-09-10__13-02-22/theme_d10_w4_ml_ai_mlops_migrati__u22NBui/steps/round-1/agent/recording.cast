[5997.50872, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('internal/serving/serving.go')\ns = p.read_text()\n\nold = '''// ListLoaded returns all currently loaded models.\n'''\nnew = '''// HealthCheck checks a loaded model against the current registry state.\ntype HealthStatus struct {\n\\tModelName     string         `json:\"model_name\"`\n\\tStatus        string         `json:\"status\"`\n\\tLoadedVersion int            `json:\"loaded_version\"`\n\\tLoadedStage   registry.Stage `json:\"loaded_stage\"`\n\\tRegistryStage registry.Stage `json:\"registry_stage\"`\n\\tStageMatch    bool           `json:\"stage_match\"`\n}\n\n// HealthCheck verifies the loaded model's stage against the current registry state.\nfunc (s *Server) HealthCheck(modelName string) (*HealthStatus, error) {\n\\ts.mu.RLock()\n\\tloaded, ok := s.loaded[modelName]\n\\ts.mu.RUnlock()\n\\tif !ok {\n\\t\\treturn nil, fmt.Errorf(\"model %q is not loaded\", modelName)\n\\t}\n\n\\th := &HealthStatus{\n\\t\\tModelName:     modelName,\n\\t\\tLoadedVersion: loaded.VersionNum,\n\\t\\tLoadedStage:   loaded.Stage,\n\\t}\n\n"]
[5997.508976, "i", "\\tversion, err := s.registry.GetVersion(modelName, loaded.VersionNum)\n\\tif err != nil {\n\\t\\th.Status = \"orphaned\"\n\\t\\th.RegistryStage = \"unknown\"\n\\t\\th.StageMatch = false\n\\t\\treturn h, nil\n\\t}\n\n\\th.RegistryStage = version.Stage\n\\th.StageMatch = loaded.Stage == version.Stage\n\\tif h.StageMatch {\n\\t\\th.Status = \"healthy\"\n\\t} else {\n\\t\\th.Status = \"stale\"\n\\t}\n\\treturn h, nil\n}\n\n// ListLoaded returns all currently loaded models.\n'''\nif old not in s:\n    raise SystemExit('ListLoaded comment not found')\ns = s.replace(old, new)\n\np.write_text(s)\nPY\n"]
[5997.509, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[5997.509117, "o", "\\tversion, err := s.registry.GetVersion(modelName, loaded.VersionNum)\r\n\\tif err != nil {\r\n\\t\\th.Status = \"orphaned\"\r\n\\t\\th.RegistryStage = \"unknown\"\r\n\\t\\th.StageMatch = false\r\n\\t\\treturn h, nil\r\n\\t}\r\n\r\n\\th.RegistryStage = version.Stage\r\n\\th.StageM"]
[5997.509187, "o", "atch = loaded.Stage == version.Stage\r\n\\tif h.StageMatch {\r\n\\t\\th.Status = \"healthy\"\r\n\\t} else {\r\n\\t\\th.Status = \"stale\"\r\n\\t}\r\n\\treturn h, nil\r\n}\r\n\r\n// ListLoaded returns all currently loade"]
[5997.509254, "o", "d models.\r\n'''\r\nif old not in s:\r\n    raise SystemExit('ListLoaded comment not found')\r\ns = s.replace(old, new)\r\n\r\np.write_text(s)\r\nPY\r\n\u001b[?2004h"]
