[6514.344831, "o", "}\r\n   537\t\treturn fmt.Errorf(\"run %q not found in experiment %q\", runID, experimentName)\r\n   538\t}\r\n   539\t\r\n   540\tfunc percentile(sorted []float64, p float64) float64 {\r\n   541\t\tn := len(sorted)\r\n   542\t\tif n == 0 {\r\n   543\t\t\treturn 0\r\n   544\t\t}\r\n   545\t\tif n == 1 {\r\n   546\t\t\treturn sorted[0]\r\n   547\t"]
[6514.344913, "o", "\t}\r\n   548\t\trank := p * float64(n-1)\r\n   549\t\tlower := int(math.Floor(rank))\r\n   550\t\tupper := int(math.Ceil(rank))\r\n   551\t\tif lower == upper {\r\n   552\t\t\treturn sorted[lower]\r\n   553\t\t}\r\n   554\t\tfrac := rank - float64(lower)\r\n   555\t\t"]
[6514.344974, "o", "return sorted[lower]*(1-frac) + sorted[upper]*frac\r\n   556\t}\r\n   557\t\r\n   558\tfunc sortedCopy(values []float64) []float64 {\r\n   559\t\ts := make([]float64, len(values))\r\n   560\t\tcopy(s, values)\r\n"]
