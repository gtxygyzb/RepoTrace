[5616.696649, "o", "}\r\n\r\n// ExecuteValidate checks data against schema constraints.\r\nfunc ExecuteValidate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n"]
[5616.696778, "o", "\t\treturn nil, fmt.Errorf(\"validate: missing or invalid 'data' field\")\r\n\t}\r\n\r\n\tvar errors []interface{}\r\n\r\n\t// Check min_value constraint\r\n\tif minVal, ok := config[\"min_value\"].(float64); ok {\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: not a number\", i))\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif val < minVal {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f below minimum %f\", i, val, minVal))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// Check max_value constraint\r\n\tif maxVal, ok := config[\"max_value\"].(float64); ok {\r\n\t\tfor i, v := range data {\r\n"]
[5616.696819, "o", "\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\t"]
[5616.697004, "o", "if val > maxVal {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f above maximum %f\", i, val, maxVal))\r\n\t\t\t}\r\n\t\t}\r\n"]
[5616.697082, "o", "\t}\r\n\r\n\t// Check min_count constraint\r\n\tif minCount, ok := config[\"min_count\"].(float64); ok {\r\n\t\tif float64(len(data)) < minCount {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"data has %d elements, minimum required is %d\", len(data), int(minCount)))\r\n\t\t}\r\n\t}\r\n\r\n\tvalid := len(errors) == 0\r\n\treturn map[string]interface{}{\r\n\t\t\"valid\":  valid,\r\n\t\t\"errors\": errors,\r\n\t\t\"data\":   data,\r\n\t}, nil\r\n}\r\n\r\n// ExecuteAggregate computes aggregations over input data.\r\n// Supported operations: sum, mean, count, min, max.\r\nfunc ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"aggregate: missing or invalid 'data' field\")\r\n\t}\r\n\r\n\toperation, _ := config[\"operation\"].(string)\r\n\tif operation == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"aggregate: missing 'operation' in config\")\r\n\t}\r\n"]
[5616.697154, "o", "\r\n\tvalues := make([]float64, 0, len(data))\r\n\tfor _, v := range data {\r\n\t\tval, err := toFloat(v)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvalues = append(values, val)\r\n\t}\r\n"]
[5616.697188, "o", "\r\n\tif len(values) == 0 {\r\n\t\treturn map[string]interface{}{\"result\": 0.0, \"count\": 0.0}, nil\r\n\t}\r\n\r\n\tvar result float64\r\n\tswitch operation {\r\n\tcase \"sum\":\r\n\t\tfor _, v := range values {\r\n\t\t\t"]
[5616.69728, "o", "result += v\r\n\t\t}\r\n\tcase \"mean\":\r\n\t\tfor _, v := range values {\r\n\t\t\tresult += v\r\n"]
[5616.69735, "o", "\t\t}\r\n\t\tresult /= float64(len(values))\r\n\tcase \"count\":\r\n\t\tresult = float64(len(values))\r\n\tcase \"min\":\r\n\t\tresult = values[0]\r\n\t\tfor _, v := range values[1:] {\r\n\t\t\tif v < result {\r\n\t\t\t\tresult = v\r\n\t\t\t}\r\n\t\t}\r\n\tcase \"max\":\r\n"]
[5616.697446, "o", "\t\tresult = values[0]\r\n\t\tfor _, v := range values[1:] {\r\n\t\t\tif v > result {\r\n\t\t\t\tresult = v\r\n\t\t\t}\r\n\t\t}\r\n\tcase \"range\":\r\n\t\tif len(values) < 2 {\r\n\t\t\tresult = 0.0\r\n\t\t} else {\r\n\t\t\tminVal := values[0]\r\n\t\t\tmaxVal := values[0]\r\n\t\t\tfor _, v := range values[1:] {\r\n\t\t\t\tif v < minVal {\r\n\t\t\t\t\tminVal = v\r\n\t\t\t\t}\r\n\t\t\t\t"]
[5616.697518, "o", "if v > maxVal {\r\n\t\t\t\t\tmaxVal = v\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tresult = maxVal - minVal\r\n\t\t}\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"aggregate: unknown operation %q\", operation)\r\n\t}\r\n\r\n\treturn map[string]interface{}{\r\n\t\t\"result\": result,\r\n\t\t\"count\":  float64(len(values)),"]
[5616.697587, "o", "\r\n\t\t\"data\":   data,\r\n\t}, nil\r\n"]
[5616.698048, "o", "\u001b[?2004h"]
[5616.698155, "o", "root@n30009:/app# "]
[5616.958575, "i", "sed -n '1,220p' internal/registry/registry.go\n"]
[5616.958794, "o", "sed -n '1,220p' internal/registry/registry.go\r\n\u001b[?2004l\r"]
[5616.961434, "o", "package registry\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[5616.961551, "o", "\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\n// Stage represents the lifecycle stage of a model version.\r\ntype Stage string\r\n\r\nconst (\r\n\tStageDevelopment Stage = \"development\"\r\n\tStageStaging     Stage = \"staging\"\r\n\tStageProduction  Stage = \"production\"\r\n\tStageArchived    Stage = \"archived\"\r\n)\r\n\r\nvar validTransitions = map[Stage][]Stage{\r\n\tStageDevelopment: {StageStaging, StageArchived},\r\n\tStageStaging:     {StageProduction, StageArchived},\r\n\tStageProduction:  {StageArchived},\r\n"]
[5616.961663, "o", "\tStageArchived:    {},\r\n}\r\n\r\n// PromotionRecord records a single stage transition in a version's lineage.\r\ntype PromotionRecord struct {\r\n\tFromStage Stage  `json:\"from_stage\"`\r\n\tToStage   Stage  `json:\"to_stage\"`\r\n\tTimestamp string `json:\"timestamp\"`\r\n}\r\n\r\n// Version represents a specific version of a model.\r\ntype Version struct {\r\n\tNumber      int                    `json:\"number\"`\r\n\tStage       Stage                  `json:\"stage\"`\r\n\tMetrics     map[string]float64     `json:\"metrics\"`\r\n\tTags        []string               `json:\"tags\"`\r\n\tModelConfig map[string]interface{} `json:\"model_config,omitempty\"`\r\n\tCreatedAt   time.Time              `json:\"created_at\"`\r\n\t"]
[5616.961793, "o", "Lineage     []PromotionRecord      `json:\"lineage\"`\r\n\tDemotedBy   int                    `json:\"demoted_by,omitempty\"`\r\n}\r\n\r\n// Model represents a registered ML model.\r\ntype Model struct {\r\n"]
[5616.961907, "o", "\tName         string     `json:\"name\"`\r\n\tFramework    string     `json:\"framework\"`\r\n\tDescription  string     `json:\"description\"`\r\n\tTags         []string   `json:\"tags\"`\r\n\tVersions     []*Version `json:\"versions\"`\r\n\tDependencies []string   `json:\"dependencies\"`\r\n\tCreatedAt    time.Time  `json:\"created_at\"`\r\n\tUpdatedAt    time.Time  `json:\"updated_at\"`\r\n}\r\n\r\n// ModelFilter defines filtering criteria for listing models.\r\ntype ModelFilter struct {\r\n\tFramework string\r\n\tTag       string\r\n}\r\n\r\n// Annotation represents a key-value annotation attached to a model version.\r\ntype Annotation struct {\r\n\tKey       string    `json:\"key\"`\r\n\tValue     string    `json:\"value\"`\r\n\tCreatedAt time.Time `json:\"created_at\"`\r\n}\r\n\r\nvar annotationKeyRegexp = regexp.MustCompile(`^[A-Za-z0-9_]+$`)\r\n\r\n// Registry manages model registration, versioning, and lifecycle.\r\ntype Registry struct {\r\n\tmu           sync.RWMutex\r\n\tmodels       map[string]*Model\r\n\tdataDir      string\r\n\tannotations  map[string]map[int]map[string]*Annotation\r\n\tdepende"]
[5616.961991, "o", "ncies map[string][]string\r\n}\r\n\r\n// NewRegistry creates a new Registry backed by the given data directory.\r\nfunc NewRegistry(dataDir string) (*Registry, error) {\r\n\tif err := os.MkdirAll(dataDir, 0755); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"create data dir: %w\", err)\r\n\t}\r\n\tr := &Registry{\r\n\t\tmodels:       make(map[string]*Model),\r\n\t\tdataDir:      dataDir,\r\n\t\tannotations:  make(map[string]map[int]map[string]*Annotation),\r\n\t\tdependencies: make(map[string][]string),\r\n\t}\r\n\tif err := r.loadAll(); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"load registry: %w\", err)\r\n\t}\r\n\treturn r, nil\r\n}\r\n\r\n"]
[5616.962061, "o", "// RegisterModel creates a new model entry in the registry.\r\nfunc (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tif _, exists := r.models[name]; exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q already exists\", name)\r\n\t}\r\n\r\n\tnow := time.Now()\r\n\tif tags == nil {\r\n\t\ttags = []string{}\r\n\t}\r\n\tmodel := &Model{\r\n"]
[5616.962132, "o", "\t\tName:         name,\r\n\t\tFramework:    framework,\r\n\t\tDescription:  description,\r\n\t\tTags:         tags,\r\n\t\tVersions:     make([]*Version, 0),\r\n\t\tDependencies: []string{},\r\n\t\tCreatedAt:    now,\r\n\t\tUpdatedAt:    now,\r\n\t}\r\n\tr.models[name] = model\r\n\tr.dependencies[name] = []string{}\r\n\t"]
[5616.9622, "o", "if err := r.saveModel(model); err != nil {\r\n\t\tdelete(r.models, name)\r\n\t\treturn nil, err\r\n\t}\r\n\treturn model, nil\r\n}\r\n\r\n// CreateVersion adds a new version to the specified model.\r\nfunc (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n"]
[5616.962274, "o", "\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tnextNum := 1\r\n"]
[5616.962379, "o", "\tfor _, v := range model.Versions {\r\n\t\tif v.Number >= nextNum {\r\n\t\t\tnextNum = v.Number + 1\r\n\t\t}\r\n\t}\r\n\r\n\tif tags == nil {\r\n\t\ttags = []string{}\r\n\t}\r\n\tversion := &Version{\r\n\t\tNumber:      nextNum,\r\n\t\tStage:       StageDevelopment,\r\n\t\tMetrics:     metrics,\r\n\t\tTags:        tags,\r\n\t\tModelConfig: modelConfig,\r\n\t\tCreatedAt:   time.Now(),\r\n\t\tLineage:     []PromotionRecord{},\r\n\t}\r\n\tmodel.Versions = append(model.Versions, version)\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\tif err := r.saveModel(model); err != nil {\r\n\t\tmodel.Versions = model.Versions[:len(model.Versions)-1]\r\n\t\treturn nil, err\r\n\t}"]
[5616.962468, "o", "\r\n\treturn version, nil\r\n}\r\n\r\n// PromoteVersion transitions a model version to the specified stage.\r\nfunc (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tvar version *Version\r\n\tfor _, v := range model.Versions {\r\n\t"]
[5616.962537, "o", "\tif v.Number == versionNum {\r\n\t\t\tversion = v\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif version == nil {\r\n\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n\t}\r\n\r\n\t// Validate stage transition\r\n\tallowed := validTransitions[version.Stage]\r\n\tvalid := false\r\n\tfor _, s := range allowed {\r\n"]
[5616.962605, "o", "\t\tif s == targetStage {\r\n\t\t\tvalid = true\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif !valid {\r\n\t\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n\t}\r\n\r\n\tpromotionTime := time.Now().UTC().Format(time.RFC3339)\r\n\r\n\t// If promoting to production, demote current production version.\r\n"]
[5616.962679, "o", "\tif targetStage == StageProduction {\r\n\t\tfor _, v := range model.Versions {\r\n\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n\t\t\t\tif v.Lineage == nil {\r\n\t\t\t\t\tv.Lineage = []PromotionRecord{}\r\n"]
[5616.962748, "o", "\t\t\t\t}\r\n\t\t\t\tv.Lineage = append(v.Lineage, PromotionRecord{\r\n\t\t\t\t\tFromStage: StageProduction,\r\n\t\t\t\t\tToStage:   StageStaging,\r\n\t\t\t\t\tTimestamp: promotionTime,\r\n"]
[5616.963137, "o", "\u001b[?2004hroot@n30009:/app# "]
[5617.240594, "i", "sed -n '1,220p' internal/serving/serving.go\n"]
[5617.240986, "o", "sed -n '1,220p' internal/serving/serving.go\r\n"]
[5617.24108, "o", "\u001b[?2004l\r"]
[5617.244026, "o", "package serving\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"sync\"\r\n"]
[5617.244137, "o", "\t\"time\"\r\n\r\n\t\"gomlops/internal/registry\"\r\n)\r\n\r\n// LoadedModel tracks a model version currently loaded for serving.\r\ntype LoadedModel struct {\r\n\tModelName   string                 `json:\"model_name\"`\r\n\tVersionNum  int                    `json:\"version_num\"`\r\n\tStage       registry.Stage         `json:\"stage\"`\r\n\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n\tLoadedAt    time.Time              `json:\"loaded_at\"`\r\n}\r\n\r\n// InferenceRequest contains the input data for model inference.\r\ntype InferenceRequest struct {\r\n\tModelName string    `json:\"model_name\"`\r\n\tInput     []float64 `json:\"input\"`\r\n}\r\n\r\n// InferenceResponse contains the model prediction results.\r\ntype InferenceResponse struct {\r\n\tModelName   string    `json:\"model_name\"`\r\n"]
[5617.244224, "o", "\tVersion     int       `json:\"version\"`\r\n\tPredictions []float64 `json:\"predictions\"`\r\n\tLatencyMs   float64   `json:\"latency_ms\"`\r\n}\r\n\r\n// ModelStats tracks inference statistics for a single model.\r\ntype ModelStats struct {\r\n\tRequests   int     `json:\"requests\"`\r\n"]
[5617.24432, "o", "\tSuccessful int     `json:\"successful\"`\r\n\tFailed     int     `json:\"failed\"`\r\n\tLatencySum float64 `json:\"-\"`\r\n}\r\n\r\n// Stats tracks accumulated serving statistics.\r\ntype Stats struct {\r\n\tTotalRequests int\r\n\tSuccessful    int\r\n\tFailed        int\r\n\tLatencySum    float64\r\n\tModels        map[string]*ModelStats\r\n}\r\n\r\n// StatsResponse is the public serving statistics representation.\r\ntype StatsResponse struct {\r\n\tTotalRequests int                           `json:\"total_requests\"`\r\n\tSuccessful    int                           `json:\"successful\"`\r\n\tFailed        int                           `json:\"failed\"`\r\n\tAvgLatencyMs  float64                       `json:\"avg_latency_ms\"`\r\n\tModels        map[string]ModelStatsResponse `json:\"models\"`\r\n}\r\n\r\n// ModelStatsResponse is the public model statistics representation.\r\ntype ModelStatsResponse struct {\r\n\tRequests     int     `json:\"requests\"`"]
[5617.244396, "o", "\r\n\tSuccessful   int     `json:\"successful\"`\r\n\tFailed       int     `json:\"failed\"`\r\n\tAvgLatencyMs float64 `json:\"avg_latency_ms\"`\r\n\tSuccessRate  float64 `json:\"success_rate\"`\r\n}\r\n"]
[5617.244477, "o", "\r\n// Server manages model loading and inference.\r\ntype Server struct {\r\n\tmu       sync.RWMutex\r\n\tloaded   map[string]*LoadedModel\r\n\tregistry *registry.Registry\r\n\tstats    Stats\r\n}\r\n\r\n// NewServer creates a new serving server backed by the given registry.\r\nfunc NewServer(reg *registry.Registry) *Server {\r\n\treturn &Server{\r\n\t\tloaded:   make(map[string]*LoadedModel),\r\n\t\tregistry: reg,\r\n\t\tstats: Stats{\r\n\t\t\tModels: make(map[string]*ModelStats),\r\n\t\t},\r\n\t}\r\n}\r\n\r\n// LoadModel loads a model version for serving. Specify either versionNum > 0\r\n// or a non-empty stage string (not both).\r\nfunc (s *Server) LoadModel(modelName string, versionNum int, stage string) error {\r\n\t"]
[5617.244547, "o", "var version *registry.Version\r\n\tvar err error\r\n\r\n\tif versionNum > 0 {\r\n\t\tversion, err = s.registry.GetVersion(modelName, versionNum)\r\n\t} else if stage != \"\" {\r\n\t\tversion, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))\r\n\t} else {\r\n\t\treturn fmt.Errorf(\"must specify version number or stage\")\r\n\t}\r\n\r\n"]
[5617.244622, "o", "\tif err != nil {\r\n\t\treturn fmt.Errorf(\"load model: %w\", err)\r\n\t}\r\n\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\ts.loaded[modelName] = &LoadedModel{\r\n\t\tModelName:   modelName,\r\n\t\tVersionNum:  version.Number,\r\n\t\tStage:       version.Stage,\r\n\t\tModelConfig: version.ModelConfig,\r\n\t\t"]
[5617.244707, "o", "LoadedAt:    time.Now(),\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n// UnloadModel removes a model from the serving cache.\r\nfunc (s *Server) UnloadModel(modelName string) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\tif _, exists := s.loaded[modelName]; !exists {\r\n\t\treturn fmt.Errorf(\"model %q is not loaded\", modelName)\r\n\t}\r\n\tdelete(s.loaded, modelName)\r\n\treturn nil\r\n}\r\n\r\n"]
[5617.244776, "o", "// Infer runs inference on the loaded model and returns predictions.\r\nfunc (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {\r\n\tstart := time.Now()\r\n\r\n\ts.mu.RLock()\r\n\tloaded, exists := s.loaded[req.ModelName]\r\n\ts.mu.RUnlock()\r\n\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", req.ModelName)\r\n\t}\r\n\r\n"]
[5617.244849, "o", "\tpredictions, err := computePrediction(loaded.ModelConfig, req.Input)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n\t}\r\n"]
[5617.244964, "o", "\r\n\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n\r\n\treturn &InferenceResponse{\r\n\t\tModelName:   req.ModelName,\r\n\t\tVersion:     loaded.VersionNum,\r\n\t\tPredictions: predictions,\r\n\t\tLatencyMs:   latency,\r\n\t}, nil\r\n}\r\n\r\n// RecordRequest updates serving statistics for a single inference request.\r\nfunc (s *Server) RecordRequest(modelName string, successful bool, latencyMs float64) {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\ts.stats.TotalRequests++\r\n\tif successful {\r\n\t\ts.stats.Successful++\r\n\t\ts.stats.LatencySum += latencyMs"]
[5617.245039, "o", "\r\n\t} else {\r\n\t\ts.stats.Failed++\r\n\t}\r\n\r\n\tmodel := s.stats.Models[modelName]\r\n\tif model == nil {\r\n\t\tmodel = &ModelStats{}\r\n\t\ts.stats.Models[modelName] = model\r\n\t}\r\n\tmodel.Requests++\r\n\tif successful {\r\n\t\tmodel.Successful++\r\n\t\tmodel.LatencySum += latencyMs\r\n\t} else {\r\n\t\tmodel.Failed++\r\n\t}\r\n}\r\n"]
[5617.245111, "o", "\r\n// GetStats returns a snapshot of accumulated serving statistics.\r\nfunc (s *Server) GetStats() StatsResponse {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\r\n\tresp := StatsResponse{\r\n\t\tTotalRequests: s.stats.TotalRequests,\r\n\t\tSuccessful:    s.stats.Successful,\r\n\t\tFailed:        s.stats.Failed,\r\n\t\tModels:        make(map[string]ModelStatsResponse),\r\n\t}\r\n\t"]
[5617.245183, "o", "if s.stats.Successful > 0 {\r\n\t\tresp.AvgLatencyMs = s.stats.LatencySum / float64(s.stats.Successful)\r\n\t}\r\n\r\n\tfor name, model := range s.stats.Models {\r\n\t\tm := ModelStatsResponse{\r\n\t\t\tRequests:   model.Requests,\r\n\t\t\tSuccessful: model.Successful,\r\n\t\t\tFailed:     model.Failed,\r\n\t\t}\r\n\t"]
[5617.24525, "o", "\tif model.Successful > 0 {\r\n\t\t\tm.AvgLatencyMs = model.LatencySum / float64(model.Successful)\r\n\t\t}\r\n\t\tif model.Requests > 0 {\r\n\t\t\tm.SuccessRate = float64(model.Successful) / float64(model.Requests)\r\n\t\t}\r\n\t\tresp.Models[name] = m\r\n\t}\r\n\treturn resp\r\n}\r\n"]
[5617.245341, "o", "\r\n// ResetStats resets all serving statistics to zero.\r\nfunc (s *Server) ResetStats() {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n"]
[5617.245761, "o", "\u001b[?2004h"]
[5617.245829, "o", "root@n30009:/app# "]
[5617.517441, "i", "sed -n '1,120p' internal/api/router.go\n"]
[5617.517777, "o", "sed -n '1,120p' internal/api/router.go\r\n"]
[5617.517911, "o", "\u001b[?2004l\r"]
[5617.520833, "o", "package api\r\n\r\nimport (\r\n\t\"net/http\"\r\n\r\n\t\"gomlops/internal/experiment\"\r\n"]
[5617.520879, "o", "\t\"gomlops/internal/pipeline\"\r\n\t\"gomlops/internal/registry\"\r\n\t\"gomlops/internal/serving\"\r\n)\r\n\r\n"]
[5617.521012, "o", "// Handlers holds references to all service components.\r\ntype Handlers struct {\r\n\tRegistry   *registry.Registry\r\n\tPipeline   *pipeline.Engine\r\n\tExperiment *experiment.Tracker\r\n\tServing    *serving.Server\r\n\tTemplates  *TemplateStore\r\n}\r\n\r\n// NewRouter builds the HTTP route table and returns a handler.\r\nfunc NewRouter(reg *registry.Registry, eng *pipeline.Engine, tracker *experiment.Tracker, srv *serving.Server) http.Handler {\r\n\th := &Handlers{\r\n\t\tRegistry:   reg,\r\n\t\tPipeline:   eng,\r\n\t\tExperiment: tracker,\r\n\t\tServing:    srv,\r\n\t\tTemplates:  NewTemplateStore(),\r\n\t}\r\n\r\n\tmux := http.NewServeMux()\r\n\r\n\t// Model registry endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/models\", h.RegisterModel)\r\n"]
[5617.521123, "o", "\tmux.HandleFunc(\"GET /api/v1/models\", h.ListModels)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}\", h.GetModel)\r\n\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions\", h.CreateVersion)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions\", h.ListModelVersions)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/compare\", h.CompareVersionMetrics)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}\", h.GetVersion)\r\n\tmux.HandleFunc(\"PUT /api/v1/models/{name}/versions/{num}/promote\", h.PromoteVersion)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}/lineage\", h.ModelLineage)\r\n\tmux.HandleFunc(\"POST /api/v1/models/{name}/dependencies\", h.DeclareDependencies)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}/dependencies\", h.GetDependencies)\r\n\tmux.HandleFunc(\"DELETE /api/v1/models/{name}/dependencies/{dep}\", h.RemoveDependency)\r\n\tmux.HandleFunc(\"DELETE /api/v1/models/{name}\", h.DeleteModel)\r\n\r\n\t// Model version annotations\r\n\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions/{num}/annotations\", h.AddAnnotation)\r\n\tmux.Ha"]
[5617.521212, "o", "ndleFunc(\"GET /api/v1/models/{name}/versions/{num}/annotations\", h.ListAnnotations)\r\n\tmux.HandleFunc(\"DELETE /api/v1/models/{name}/versions/{num}/annotations/{key}\", h.DeleteAnnotation)\r\n\r\n\t// Pipeline endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/validate\", h.ValidatePipeline)\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/execute\", h.ExecutePipeline)\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/templates\", h.CreateTemplate)\r\n\tmux.HandleFunc(\"GET /api/v1/pipelines/templates\", h.ListTemplates)\r\n\tmux.HandleFunc(\"GET /api/v1/pipelines/templates/{name}\", h.GetTemplate)\r\n\tmux.HandleFunc(\"PUT /api/v1/pipelines/templates/{name}\", h.UpdateTemplate)\r\n\tmux.HandleFunc(\"DELETE /api/v1/pipelines/templates/{name}\", h.DeleteTemplate)\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/templates/{name}/execute\", h.ExecuteTemplate)\r\n\r\n\t// Experiment endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/experiments\", h.CreateExperiment)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments\", h.ListExperiments)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments/{name}\", h.Get"]
[5617.52129, "o", "Experiment)\r\n\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/clone\", h.CloneExperiment)\r\n\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs\", h.LogRun)\r\n\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs/bulk-tag\", h.BulkTagRuns)\r\n\tmux.HandleFunc(\"DELETE /api/v1/experiments/{name}/runs/{id}\", h.DeleteRun)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments/compare\", h.CompareExperiments)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/aggregate\", h.AggregateMetric)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/history\", h.GetMetricHistory)\r\n\tmux.HandleFunc(\"PUT /api/v1/experiments/{name}/runs/{id}\", h.UpdateRun)\r\n\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs/search\", h.SearchRuns)\r\n\r\n\t// Serving endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/serving/load\", h.LoadModel)\r\n\tmux.HandleFunc(\"DELETE /api/v1/serving/models/{name}\", h.UnloadModel)\r\n\tmux.HandleFunc(\"GET /api/v1/serving/models\", h.ListLoadedModels)"]
[5617.521362, "o", "\r\n\tmux.HandleFunc(\"POST /api/v1/serving/infer\", h.Infer)\r\n\tmux.HandleFunc(\"POST /api/v1/serving/batch\", h.BatchInfer)\r\n\tmux.HandleFunc(\"GET /api/v1/serving/stats\", h.ServingStats)\r\n\tmux.HandleFunc(\"POST /api/v1/serving/stats/reset\", h.ResetServingStats)\r\n\r\n\t// Health check\r\n\tmux.HandleFunc(\"GET /health\", func(w http.ResponseWriter, r *http.Request) {\r\n\t\tw.WriteHeader(http.StatusOK)\r\n\t\tw.Write([]byte(`{\"status\":\"ok\"}`))\r\n\t})\r\n\r\n"]
[5617.521432, "o", "\treturn mux\r\n}\r\n"]
