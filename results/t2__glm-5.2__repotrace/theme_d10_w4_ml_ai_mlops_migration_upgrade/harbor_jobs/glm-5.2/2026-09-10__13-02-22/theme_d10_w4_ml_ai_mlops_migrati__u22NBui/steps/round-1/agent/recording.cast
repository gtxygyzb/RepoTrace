[5689.476912, "o", "   125\t\t// Check max_value constraint\r\n   126\t\tif maxVal, ok := config[\"max_value\"].(float64); ok {\r\n   127\t\t\tfor i, v := range data {\r\n   128\t\t\t\tval, err := toFloat(v)\r\n   129\t\t\t\tif err != nil {\r\n   130\t\t\t\t\tcontinue\r\n   131\t\t\t\t}\r\n   132\t\t\t\tif val > maxVal {\r\n"]
[5689.476989, "o", "   133\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f above maximum %f\", i, val, maxVal))\r\n   134\t\t\t\t}\r\n   135\t\t\t}\r\n   136\t\t}\r\n   137\t\r\n   138\t\t// Check min_count constraint\r\n   139\t\tif minCount, ok := config[\"min_count\"].(float64); ok {\r\n   140\t\t\tif float64(len(data)) < minCount {\r\n   141\t\t\t\terrors = append(errors, fmt.Sprintf(\"data has %d elements, minimum required is %d\", len(data), int(minCount)))\r\n   142\t\t\t}\r\n   143\t\t}\r\n   144\t\r\n   145\t\t"]
