[5714.176913, "o", "   228\t\tif version.Lineage == nil {\r\n   229\t\t\tversion.Lineage = []PromotionRecord{}\r\n   230\t\t}\r\n   231\t\tversion.Lineage = append(version.Lineage, PromotionRecord{\r\n   232\t\t\tFromStage: version.Stage,\r\n   233\t\t\tToStage:   targetStage,\r\n   234\t\t\tTimestamp: promotionTime,\r\n   235\t\t})\r\n   236\t\tversion.Stage = targetStage\r\n   237\t\tmodel.UpdatedAt = time.Now()\r\n   238\t\r\n   239\t\treturn r.saveModel(model)\r\n   240\t}\r\n   241\t\r\n   242\t// GetModel returns a model with its versions sorted by version number descending."]
[5714.176986, "o", "\r\n   243\tfunc (r *Registry) GetModel(name string) (*Model, error) {\r\n   244\t\tr.mu.RLock()\r\n   245\t\tdefer r.mu.RUnlock()\r\n   246\t\r\n   247\t\tmodel, exists := r.models[name]\r\n   248\t\tif !exists {\r\n   249\t\t\treturn nil, fmt.Errorf(\"model %q not found\", name)\r\n   250\t\t}\r\n   251\t\r\n   252\t\t"]
[5714.177057, "o", "// Return a copy with versions sorted\r\n   253\t\tresult := *model\r\n   254\t\tresult.Versions = make([]*Version, len(model.Versions))\r\n   255\t\tcopy(result.Versions, model.Versions)\r\n   256\t\tsort.Slice(result.Versions, func(i, j int) bool {\r\n   257\t\t\treturn result.Versions[i].Number > result.Versions[j].Number\r\n   258\t\t})\r\n   259\t\treturn &result, nil\r\n   260\t}\r\n"]
