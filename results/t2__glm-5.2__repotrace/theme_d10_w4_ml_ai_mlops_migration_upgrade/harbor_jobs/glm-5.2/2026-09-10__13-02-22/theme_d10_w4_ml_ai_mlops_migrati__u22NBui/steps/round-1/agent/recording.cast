[5831.383274, "o", "\t\t}\r\n   546\t\r\n   547\t\tvar req struct {\r\n   548\t\t\tKey   string `json:\"key\"`\r\n   549\t\t\tValue string `json:\"value\"`\r\n   550\t\t}\r\n   551\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n   552\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n   553\t\t\treturn\r\n   554\t\t}\r\n   555\t\tif !registry.ValidateAnnotationKey(req.Key) {\r\n   556\t\t\twriteError(w, http.StatusBadRequest, \"annotation key must contain only letters, digits, and underscores\")\r\n   557\t\t\treturn\r\n   558\t\t}\r\n   559\t\r\n   560\t\tannotation, err := h.Registry.AddAnnotation(modelName, num, req.Key, req.Value)\r\n   561\t\tif err != nil {\r\n   562\t\t\tif strings.Contains(err.Error(), \"not found\") {\r\n   563\t\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   564\t\t\t} else if strings.Contains(err.Error(), \"already exists\") {\r\n   565\t\t\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n"]
[5831.383394, "o", "   566\t\t\t} else {\r\n   567\t\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n   568\t\t\t}\r\n   569\t\t\treturn\r\n   570\t\t}\r\n   571\t\twriteJSON(w, http.StatusCreated, annotation)\r\n   572\t}\r\n   573\t\r\n   574\tfunc (h *Handlers) ListAnnotations(w http.ResponseWriter, r *http.Request) {\r\n   575\t\tmodelName := r.PathValue(\"name\")\r\n   576\t\tnumStr := r.PathValue(\"num\")\r\n   577\t\tnum, err := strconv.Atoi(numStr)\r\n   578\t\tif err != nil {\r\n   579\t\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n   580\t\t\treturn\r\n   581\t\t}\r\n   582\t\r\n   583\t\tannotations, err := h.Registry.ListAnnotations(modelName, num)\r\n"]
[5831.383515, "o", "   584\t\tif err != nil {\r\n   585\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   586\t\t\treturn\r\n   587\t\t}\r\n   588\t\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n   589\t\t\t\"annotations\": annotations,\r\n   590\t\t\t\"count\":       len(annotations),\r\n   591\t\t})\r\n   592\t}\r\n   593\t\r\n   594\tfunc (h *Handlers) DeleteAnnotation(w http.ResponseWriter, r *http.Request) {\r\n   595\t\tmodelName := r.PathValue(\"name\")\r\n   596\t\tnumStr := r.PathValue(\"num\")\r\n   597\t\tnum, err := strconv.Atoi(numStr)\r\n   598\t\tif err != nil {\r\n   599\t\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n"]
