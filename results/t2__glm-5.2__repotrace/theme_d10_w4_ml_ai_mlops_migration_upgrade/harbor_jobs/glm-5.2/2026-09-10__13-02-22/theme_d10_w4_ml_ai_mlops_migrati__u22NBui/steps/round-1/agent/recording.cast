[6488.047591, "o", "sed -n '466,540p' internal/api/handlers.go\r\n\u001b[?2004l\r"]
[6488.050694, "o", "func (h *Handlers) DeleteRun(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\trunID := r.PathValue(\"id\")\r\n\tif err := h.Experiment.DeleteRun(expName, runID); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n"]
[6488.050818, "o", "\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n}\r\n\r\n// --- Serving Handlers ---\r\n\r\nfunc (h *Handlers) LoadModel(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tModelName  string `json:\"model_name\"`\r\n\t\tVersionNum int    `json:\"version_num\"`\r\n\t\tStage      string `json:\"stage\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.ModelName == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"model_name is required\")\r\n\t\treturn\r\n"]
[6488.050931, "o", "\t}\r\n\r\n\tif err := h.Serving.LoadModel(req.ModelName, req.VersionNum, req.Stage); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"loaded\"})\r\n}\r\n\r\nfunc (h *Handlers) UnloadModel(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\tif err := h.Serving.UnloadModel(name); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"unloaded\"})\r\n}\r\n\r\n"]
[6488.050999, "o", "func (h *Handlers) ListLoadedModels(w http.ResponseWriter, r *http.Request) {\r\n\tmodels := h.Serving.ListLoaded()\r\n\twriteJSON(w, http.StatusOK, models)\r\n}\r\n\r\nfunc (h *Handlers) Infer(w http.ResponseWriter, r *http.Request) {\r\n\tvar req serving.InferenceRequest\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.ModelName == \"\" {\r\n"]
[6488.05107, "o", "\t\th.Serving.RecordRequest(req.ModelName, false, 0)\r\n\t\twriteError(w, http.StatusBadRequest, \"model_name is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tresp, err := h.Serving.Infer(&req)\r\n\tif err != nil {\r\n\t\th.Serving.RecordRequest(req.ModelName, false, 0)\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\th.Serving.RecordRequest(req.ModelName, true, resp.LatencyMs)\r\n\twriteJSON(w, http.StatusOK, resp)\r\n"]
[6488.051129, "o", "}\r\n\r\n// --- Model Version Annotation Handlers ---\r\n\r\nfunc (h *Handlers) AddAnnotation(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\tnumStr := r.PathValue(\"num\")\r\n"]
