[6036.601058, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('internal/api/router.go')\ns = p.read_text()\n\n# Add diff and rollback routes near version routes\nold = '''\\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/compare\", h.CompareVersionMetrics)\n\\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}\", h.GetVersion)\n\\tmux.HandleFunc(\"PUT /api/v1/models/{name}/versions/{num}/promote\", h.PromoteVersion)\n'''\nnew = '''\\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/compare\", h.CompareVersionMetrics)\n\\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/diff\", h.VersionDiff)\n\\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}\", h.GetVersion)\n\\tmux.HandleFunc(\"PUT /api/v1/models/{name}/versions/{num}/promote\", h.PromoteVersion)\n\\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions/{num}/rollback\", h.RollbackVersion)\n'''\nif old not in s:\n    raise SystemExit('version routes not found')\ns = s.replace(old, new)\n\n# Add pipeline history routes\nold = '''\\tmux.HandleFunc(\"POST /api/v1/pipelines/templates/{nam"]
