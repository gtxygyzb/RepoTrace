[5745.757381, "o", "    78\tfunc NewServer(reg *registry.Registry) *Server {\r\n    79\t\treturn &Server{\r\n    80\t\t\tloaded:   make(map[string]*LoadedModel),\r\n    81\t\t\tregistry: reg,\r\n    82\t\t\tstats: Stats{\r\n    83\t\t\t\tModels: make(map[string]*ModelStats),\r\n"]
