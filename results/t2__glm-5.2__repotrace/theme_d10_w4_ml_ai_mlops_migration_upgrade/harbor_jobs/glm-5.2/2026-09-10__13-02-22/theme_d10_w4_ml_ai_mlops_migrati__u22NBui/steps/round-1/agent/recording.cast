[1037.197572, "o", "   264\t\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n   265\t\t}\r\n   266\t\r\n   267\t\tfor _, v := range model.Versions {\r\n   268\t\t\tif v.Number == versionNum {\r\n   269\t\t\t\t"]
[1037.197634, "o", "return v, nil\r\n   270\t\t\t}\r\n   271\t\t}\r\n   272\t\treturn nil, fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n   273\t}\r\n   274\t\r\n"]
[1037.197696, "o", "   275\t// GetVersionByStage returns the version of a model currently in the specified stage.\r\n   276\tfunc (r *Registry) GetVersionByStage(modelName string, stage Stage) (*Version, error) {\r\n   277\t\tr.mu.RLock()\r\n   278\t\tdefer r.mu.RUnlock()\r\n   279\t\r\n   280\t\tmodel, exists := r.models[modelName]\r\n   281\t\tif !exists {\r\n"]
[1037.197758, "o", "   282\t\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n   283\t\t}\r\n   284\t\r\n   285\t\tfor _, v := range model.Versions {\r\n   286\t\t\tif v.Stage == stage {\r\n   287\t\t\t\treturn v, nil\r\n"]
