[5625.377949, "i", "sed -n '1,260p' internal/registry/registry.go\n"]
[5625.378314, "o", "sed -n '1,260p' internal/registry/registry.go\r\n\u001b[?2004l\r"]
[5625.381344, "o", "package registry\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\n"]
[5625.381494, "o", "// Stage represents the lifecycle stage of a model version.\r\ntype Stage string\r\n\r\nconst (\r\n\tStageDevelopment Stage = \"development\"\r\n\tStageStaging     Stage = \"staging\"\r\n\tStageProduction  Stage = \"production\"\r\n\tStageArchived    Stage = \"archived\"\r\n)\r\n\r\nvar validTransitions = map[Stage][]Stage{\r\n\tStageDevelopment: {StageStaging, StageArchived},\r\n\tStageStaging:     {StageProduction, StageArchived},\r\n\tStageProduction:  {StageArchived},\r\n\tStageArchived:    {},\r\n}\r\n\r\n// PromotionRecord records a single stage transition in a version's lineage.\r\ntype PromotionRecord struct {\r\n\tFromStage Stage  `json:\"from_stage\"`\r\n\tToStage   Stage  `json:\"to_stage\"`\r\n\tTimestamp string `json:\"timestamp\"`\r\n}\r\n\r\n// Version represents a specific version of a model.\r\ntype Version struct {\r\n\tNumber      int                    `json:\"number\"`\r\n\tStage       Stage                  `json:\"stage\"`\r\n\tMetrics     map[string]float64     `json:\"metrics\"`\r\n"]
[5625.381602, "o", "\tTags        []string               `json:\"tags\"`\r\n\tModelConfig map[string]interface{} `json:\"model_config,omitempty\"`\r\n\tCreatedAt   time.Time              `json:\"created_at\"`\r\n\tLineage     []PromotionRecord      `json:\"lineage\"`\r\n\tDemotedBy   int                    `json:\"demoted_by,omitempty\"`\r\n}\r\n\r\n// Model represents a registered ML model.\r\ntype Model struct {\r\n\tName         string     `json:\"name\"`\r\n\tFramework    string     `json:\"framework\"`\r\n\tDescription  string     `json:\"description\"`\r\n\tTags         []string   `json:\"tags\"`\r\n\tVersions     []*Version `json:\"versions\"`\r\n\tDependencies []string   `json:\"dependencies\"`\r\n\tCreatedAt    time.Time  `json:\"created_at\"`\r\n\tUpdatedAt    time.Time  `json:\"updated_at\"`\r\n}\r\n\r\n"]
[5625.381697, "o", "// ModelFilter defines filtering criteria for listing models.\r\ntype ModelFilter struct {\r\n\tFramework string\r\n\tTag       string\r\n}\r\n\r\n// Annotation represents a key-value annotation attached to a model version.\r\n"]
[5625.381775, "o", "type Annotation struct {\r\n\tKey       string    `json:\"key\"`\r\n\tValue     string    `json:\"value\"`\r\n\tCreatedAt time.Time `json:\"created_at\"`\r\n}\r\n\r\nvar annotationKeyRegexp = regexp.MustCompile(`^[A-Za-z0-9_]+$`)\r\n\r\n// Registry manages model registration, versioning, and lifecycle.\r\ntype Registry struct {\r\n\tmu           sync.RWMutex\r\n\tmodels       map[string]*Model\r\n\tdataDir      string\r\n\tannotations  map[string]map[int]map[string]*Annotation\r\n\tdependencies map[string][]string\r\n}\r\n\r\n// NewRegistry creates a new Registry backed by the given data directory.\r\nfunc NewRegistry(dataDir string) (*Registry, error) {\r\n\tif err := os.MkdirAll(dataDir, 0755); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"create data dir: %w\", err)\r\n\t}\r\n\tr := &Registry{\r\n\t\tmodels:       make(map[string]*Model),\r\n\t\tdataDir:      dataDir,\r\n\t\tannotations:  make(map[string]map[int]map[string]*Annotation),\r\n\t\tdependencies: make(map[string][]string),\r\n"]
[5625.381912, "o", "\t}\r\n\tif err := r.loadAll(); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"load registry: %w\", err)\r\n\t}\r\n\treturn r, nil\r\n}\r\n\r\n// RegisterModel creates a new model entry in the registry.\r\nfunc (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {\r\n\tr.mu.Lock()\r\n"]
[5625.381989, "o", "\tdefer r.mu.Unlock()\r\n\r\n\tif _, exists := r.models[name]; exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q already exists\", name)\r\n\t}\r\n\r\n\tnow := time.Now()\r\n\tif tags == nil {\r\n\t\ttags = []string{}\r\n\t}\r\n\tmodel := &Model{\r\n\t\tName:         name,\r\n\t\tFramework:    framework,\r\n\t\tDescription:  description,\r\n\t\tTags:         tags,\r\n\t\tVersions:     make([]*Version, 0),\r\n\t\tDependencies: []string{},\r\n\t\tCreatedAt:    now,\r\n\t\tUpdatedAt:    now,\r\n\t}\r\n\tr.models[name] = model\r\n\tr.dependencies[name] = []string{}\r\n\tif err := r.saveModel(model); err != nil {\r\n"]
[5625.382061, "o", "\t\tdelete(r.models, name)\r\n\t\treturn nil, err\r\n\t}\r\n\treturn model, nil\r\n}\r\n\r\n// CreateVersion adds a new version to the specified model.\r\nfunc (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n"]
[5625.382134, "o", "\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tnextNum := 1\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Number >= nextNum {\r\n\t\t\tnextNum = v.Number + 1\r\n\t\t}\r\n\t}\r\n\r\n"]
[5625.382234, "o", "\tif tags == nil {\r\n\t\ttags = []string{}\r\n\t}\r\n\tversion := &Version{\r\n\t\tNumber:      nextNum,\r\n\t\tStage:       StageDevelopment,\r\n\t\tMetrics:     metrics,\r\n\t\tTags:        tags,\r\n\t\tModelConfig: modelConfig,\r\n\t\tCreatedAt:   time.Now(),\r\n\t\tLineage:     []PromotionRecord{},\r\n\t}\r\n\tmodel.Versions = append(model.Versions, version)\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\tif err := r.saveModel(model); err != nil {\r\n\t\tmodel.Versions = model.Versions[:len(model.Versions)-1]\r\n"]
[5625.382305, "o", "\t\treturn nil, err\r\n\t}\r\n\treturn version, nil\r\n}\r\n\r\n// PromoteVersion transitions a model version to the specified stage.\r\nfunc (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n"]
[5625.382387, "o", "\tvar version *Version\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Number == versionNum {\r\n\t\t\tversion = v\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif version == nil {\r\n\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n\t}\r\n\r\n\t// Validate stage transition\r\n\tallowed := validTransitions[version.Stage]\r\n\t"]
[5625.382457, "o", "valid := false\r\n\tfor _, s := range allowed {\r\n\t\tif s == targetStage {\r\n\t\t\tvalid = true\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif !valid {\r\n\t\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n\t}\r\n\r\n\tpromotionTime := time.Now().UTC().Format(time.RFC3339)\r\n\r\n"]
[5625.382536, "o", "\t// If promoting to production, demote current production version.\r\n\tif targetStage == StageProduction {\r\n\t\tfor _, v := range model.Versions {\r\n\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n\t\t\t\tif v.Lineage == nil {\r\n\t\t\t\t\tv.Lineage = []PromotionRecord{}\r\n\t\t\t\t}\r\n\t\t\t\tv.Lineage = append(v.Lineage, PromotionRecord{\r\n\t\t\t\t\tFromStage: StageProduction,\r\n\t\t\t\t\tToStage:   StageStaging,\r\n\t\t\t\t\tTimestamp: promotionTime,\r\n"]
[5625.382613, "o", "\t\t\t\t})\r\n\t\t\t\tv.DemotedBy = versionNum\r\n\t\t\t\tv.Stage = StageStaging\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif version.Lineage == nil {\r\n\t\tversion.Lineage = []PromotionRecord{}\r\n\t}\r\n\tversion.Lineage = append(version.Lineage, PromotionRecord{\r\n\t\tFromStage: version.Stage,\r\n"]
[5625.382684, "o", "\t\tToStage:   targetStage,\r\n\t\tTimestamp: promotionTime,\r\n\t})\r\n\tversion.Stage = targetStage\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\treturn r.saveModel(model)\r\n}\r\n\r\n"]
[5625.382761, "o", "// GetModel returns a model with its versions sorted by version number descending.\r\nfunc (r *Registry) GetModel(name string) (*Model, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tmodel, exists := r.models[name]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", name)\r\n\t}\r\n\r\n\t// Return a copy with versions sorted\r\n\tresult := *model\r\n\tresult.Versions = make([]*Version, len(model.Versions))\r\n\tcopy(result.Versions, model.Versions)\r\n"]
[5625.382877, "o", "\tsort.Slice(result.Versions, func(i, j int) bool {\r\n\t\treturn result.Versions[i].Number > result.Versions[j].Number\r\n\t})\r\n\treturn &result, nil\r\n}\r\n"]
[5625.383353, "o", "\u001b[?2004h"]
[5625.383426, "o", "root@n30009:/app# "]
[5625.650692, "i", "sed -n '1,240p' internal/serving/serving.go\n"]
[5625.651088, "o", "sed -n '1,240p' internal/serving/serving.go\r\n"]
[5625.651174, "o", "\u001b[?2004l\r"]
[5625.65418, "o", "package serving\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"sync\"\r\n\t\"time\"\r\n\r\n"]
[5625.654306, "o", "\t\"gomlops/internal/registry\"\r\n)\r\n\r\n// LoadedModel tracks a model version currently loaded for serving.\r\ntype LoadedModel struct {\r\n\tModelName   string                 `json:\"model_name\"`\r\n\tVersionNum  int                    `json:\"version_num\"`\r\n\tStage       registry.Stage         `json:\"stage\"`\r\n\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n\tLoadedAt    time.Time              `json:\"loaded_at\"`\r\n}\r\n\r\n// InferenceRequest contains the input data for model inference.\r\ntype InferenceRequest struct {\r\n\tModelName string    `json:\"model_name\"`\r\n\tInput     []float64 `json:\"input\"`\r\n}\r\n\r\n// InferenceResponse contains the model prediction results.\r\ntype InferenceResponse struct {\r\n\tModelName   string    `json:\"model_name\"`\r\n\tVersion     int       `json:\"version\"`\r\n"]
[5625.654393, "o", "\tPredictions []float64 `json:\"predictions\"`\r\n\tLatencyMs   float64   `json:\"latency_ms\"`\r\n}\r\n\r\n// ModelStats tracks inference statistics for a single model.\r\ntype ModelStats struct {\r\n\tRequests   int     `json:\"requests\"`\r\n\tSuccessful int     `json:\"successful\"`\r\n\tFailed     int     `json:\"failed\"`\r\n\tLatencySum float64 `json:\"-\"`\r\n}\r\n\r\n// Stats tracks accumulated serving statistics.\r\ntype Stats struct {\r\n\tTotalRequests int\r\n"]
[5625.654476, "o", "\tSuccessful    int\r\n\tFailed        int\r\n\tLatencySum    float64\r\n\tModels        map[string]*ModelStats\r\n}\r\n\r\n// StatsResponse is the public serving statistics representation.\r\ntype StatsResponse struct {\r\n\tTotalRequests int                           `json:\"total_requests\"`\r\n\tSuccessful    int                           `json:\"successful\"`\r\n\tFailed        int                           `json:\"failed\"`\r\n\tAvgLatencyMs  float64                       `json:\"avg_latency_ms\"`\r\n\tModels        map[string]ModelStatsResponse `json:\"models\"`\r\n}\r\n\r\n"]
[5625.654552, "o", "// ModelStatsResponse is the public model statistics representation.\r\ntype ModelStatsResponse struct {\r\n\tRequests     int     `json:\"requests\"`\r\n\tSuccessful   int     `json:\"successful\"`\r\n\tFailed       int     `json:\"failed\"`\r\n\tAvgLatencyMs float64 `json:\"avg_latency_ms\"`\r\n\tSuccessRate  float64 `json:\"success_rate\"`\r\n}\r\n\r\n// Server manages model loading and inference.\r\ntype Server struct {\r\n\tmu       sync.RWMutex\r\n\tloaded   map[string]*LoadedModel\r\n\tregistry *registry.Registry\r\n\tstats    Stats\r\n"]
[5625.654628, "o", "}\r\n\r\n// NewServer creates a new serving server backed by the given registry.\r\nfunc NewServer(reg *registry.Registry) *Server {\r\n\treturn &Server{\r\n\t\tloaded:   make(map[string]*LoadedModel),\r\n\t\tregistry: reg,\r\n\t\tstats: Stats{\r\n\t\t\tModels: make(map[string]*ModelStats),\r\n\t\t},\r\n\t}\r\n}\r\n"]
[5625.654699, "o", "\r\n// LoadModel loads a model version for serving. Specify either versionNum > 0\r\n// or a non-empty stage string (not both).\r\nfunc (s *Server) LoadModel(modelName string, versionNum int, stage string) error {\r\n\tvar version *registry.Version\r\n\tvar err error\r\n\r\n\tif versionNum > 0 {\r\n\t\tversion, err = s.registry.GetVersion(modelName, versionNum)\r\n\t} else if stage != \"\" {\r\n\t\tversion, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))\r\n\t} else {\r\n\t\t"]
[5625.654775, "o", "return fmt.Errorf(\"must specify version number or stage\")\r\n\t}\r\n\r\n\tif err != nil {\r\n\t\treturn fmt.Errorf(\"load model: %w\", err)\r\n\t}\r\n\r\n\ts.mu.Lock()\r\n"]
[5625.654848, "o", "\tdefer s.mu.Unlock()\r\n\r\n\ts.loaded[modelName] = &LoadedModel{\r\n\t\tModelName:   modelName,\r\n\t\tVersionNum:  version.Number,\r\n\t\tStage:       version.Stage,\r\n\t\tModelConfig: version.ModelConfig,\r\n\t\tLoadedAt:    time.Now(),\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n// UnloadModel removes a model from the serving cache.\r\nfunc (s *Server) UnloadModel(modelName string) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\tif _, exists := s.loaded[modelName]; !exists {\r\n"]
[5625.654933, "o", "\t\treturn fmt.Errorf(\"model %q is not loaded\", modelName)\r\n\t}\r\n\tdelete(s.loaded, modelName)\r\n\treturn nil\r\n}\r\n\r\n// Infer runs inference on the loaded model and returns predictions.\r\nfunc (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {\r\n\tstart := time.Now()\r\n\r\n\ts.mu.RLock()\r\n\tloaded, exists := s.loaded[req.ModelName]\r\n\ts.mu.RUnlock()\r\n\r\n\tif !exists {\r\n"]
[5625.655017, "o", "\t\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", req.ModelName)\r\n\t}\r\n\r\n\tpredictions, err := computePrediction(loaded.ModelConfig, req.Input)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n\t}\r\n\r\n\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n\r\n\treturn &InferenceResponse{\r\n\t\tModelName:   req.ModelName,\r\n"]
[5625.655089, "o", "\t\tVersion:     loaded.VersionNum,\r\n\t\tPredictions: predictions,\r\n\t\tLatencyMs:   latency,\r\n\t}, nil\r\n}\r\n\r\n// RecordRequest updates serving statistics for a single inference request.\r\nfunc (s *Server) RecordRequest(modelName string, successful bool, latencyMs float64) {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\ts.stats.TotalRequests++\r\n\tif successful {\r\n"]
[5625.655159, "o", "\t\ts.stats.Successful++\r\n\t\ts.stats.LatencySum += latencyMs\r\n\t} else {\r\n\t\ts.stats.Failed++\r\n\t}\r\n\r\n\tmodel := s.stats.Models[modelName]\r\n\tif model == nil {\r\n\t\tmodel = &ModelStats{}\r\n\t\ts.stats.Models[modelName] = model\r\n\t}\r\n\tmodel.Requests++"]
[5625.655233, "o", "\r\n\tif successful {\r\n\t\tmodel.Successful++\r\n\t\tmodel.LatencySum += latencyMs\r\n\t} else {\r\n\t\tmodel.Failed++\r\n\t}\r\n}\r\n\r\n// GetStats returns a snapshot of accumulated serving statistics.\r\nfunc (s *Server) GetStats() StatsResponse {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()"]
[5625.655306, "o", "\r\n\r\n\tresp := StatsResponse{\r\n\t\tTotalRequests: s.stats.TotalRequests,\r\n\t\tSuccessful:    s.stats.Successful,\r\n\t\tFailed:        s.stats.Failed,\r\n\t\tModels:        make(map[string]ModelStatsResponse),\r\n\t}\r\n\tif s.stats.Successful > 0 {\r\n\t\tresp.AvgLatencyMs = s.stats.LatencySum / float64(s.stats.Successful)\r\n\t}\r\n"]
[5625.655379, "o", "\r\n\tfor name, model := range s.stats.Models {\r\n\t\tm := ModelStatsResponse{\r\n\t\t\tRequests:   model.Requests,\r\n\t\t\tSuccessful: model.Successful,\r\n\t\t\tFailed:     model.Failed,\r\n\t\t}\r\n\t\tif model.Successful > 0 {\r\n\t\t\tm.AvgLatencyMs = model.LatencySum / float64(model.Successful)\r\n\t\t}\r\n\t\t"]
[5625.655449, "o", "if model.Requests > 0 {\r\n\t\t\tm.SuccessRate = float64(model.Successful) / float64(model.Requests)\r\n\t\t}\r\n\t\tresp.Models[name] = m\r\n\t}\r\n\treturn resp\r\n}\r\n\r\n// ResetStats resets all serving statistics to zero.\r\nfunc (s *Server) ResetStats() {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n"]
[5625.655521, "o", "\ts.stats = Stats{\r\n\t\tModels: make(map[string]*ModelStats),\r\n\t}\r\n}\r\n\r\n// ListLoaded returns all currently loaded models.\r\nfunc (s *Server) ListLoaded() []*LoadedModel {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\r\n\tresult := make([]*LoadedModel, 0, len(s.loaded))\r\n"]
[5625.655589, "o", "\tfor _, lm := range s.loaded {\r\n\t\tresult = append(result, lm)\r\n\t}\r\n\treturn result\r\n}\r\n\r\n// computePrediction evaluates a model against input data.\r\n// Supported model types: linear, polynomial.\r\n"]
