[1130.584071, "o", "   154\tfunc ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   155\t\tdata, ok := input[\"data\"].([]interface{})\r\n   156\t\tif !ok {\r\n   157\t\t\t"]
[1130.584154, "o", "return nil, fmt.Errorf(\"aggregate: missing or invalid 'data' field\")\r\n   158\t\t}\r\n   159\t\r\n   160\t\toperation, _ := config[\"operation\"].(string)\r\n   161\t\tif operation == \"\" {\r\n   162\t\t\treturn nil, fmt.Errorf(\"aggregate: missing 'operation' in config\")\r\n   163\t\t}\r\n   164\t\r\n   165\t\tvalues := make([]float64, 0, len(data))\r\n   166\t\tfor _, v := range data {\r\n   167\t\t\tval, err := toFloat(v)\r\n   168\t\t\tif err != nil {"]
[1130.584229, "o", "\r\n   169\t\t\t\tcontinue\r\n   170\t\t\t}\r\n   171\t\t\tvalues = append(values, val)\r\n   172\t\t}\r\n   173\t\r\n   174\t\tif len(values) == 0 {\r\n   175\t\t\treturn map[string]interface{}{\"result\": 0.0, \"count\": 0.0}, nil\r\n   176\t\t}\r\n   177\t\r\n   178\t\t"]
[1130.584292, "o", "var result float64\r\n   179\t\tswitch operation {\r\n   180\t\tcase \"sum\":\r\n   181\t\t\tfor _, v := range values {\r\n   182\t\t\t\tresult += v\r\n   183\t\t\t}\r\n   184\t\tcase \"mean\":\r\n   185\t\t\tfor _, v := range values {\r\n   186\t\t\t\tresult += v\r\n   187\t\t\t"]
[1130.584351, "o", "}\r\n   188\t\t\tresult /= float64(len(values))\r\n   189\t\tcase \"count\":\r\n   190\t\t\tresult = float64(len(values))\r\n   191\t\tcase \"min\":\r\n   192\t\t\tresult = values[0]\r\n   193\t\t\tfor _, v := range values[1:] {\r\n   194\t\t\t\tif v < result {\r\n   195\t\t\t\t\tresult = v\r\n"]
