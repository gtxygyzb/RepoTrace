[5791.924353, "o", "   102\t\t\tTags        []string               `json:\"tags\"`\r\n   103\t\t\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n   104\t\t}\r\n   105\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n   106\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n   107\t\t\treturn\r\n   108\t\t}\r\n   109\t\r\n   110\t\tversion, err := h.Registry.CreateVersion(modelName, req.Metrics, req.Tags, req.ModelConfig)\r\n   111\t\tif err != nil {\r\n   112\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   113\t\t\treturn\r\n   114\t\t}\r\n   115\t\twriteJSON(w, http.StatusCreated, version)\r\n   116\t}\r\n   117\t\r\n   118\tfunc (h *Handlers) GetVersion(w http.ResponseWriter, r *http.Request) {\r\n   119"]
[5791.924453, "o", "\t\tmodelName := r.PathValue(\"name\")\r\n   120\t\tnumStr := r.PathValue(\"num\")\r\n   121\t\tnum, err := strconv.Atoi(numStr)\r\n   122\t\tif err != nil {\r\n   123\t\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n   124\t\t\treturn\r\n   125\t\t}\r\n   126\t\r\n   127\t\tversion, err := h.Registry.GetVersion(modelName, num)\r\n   128\t\tif err != nil {\r\n   129\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   130\t\t\treturn\r\n   131\t\t}\r\n   132\t\twriteJSON(w, http.StatusOK, struct {\r\n"]
