[2010.314814, "o", "     1\tpackage api\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"net/http\"\r\n     5\t\r\n     6\t\t\"gomlops/internal/experiment\"\r\n"]
[2010.314942, "o", "     7\t\t\"gomlops/internal/pipeline\"\r\n     8\t\t\"gomlops/internal/registry\"\r\n     9\t\t\"gomlops/internal/serving\"\r\n    10\t)\r\n    11\t\r\n    12\t// Handlers holds references to all service components.\r\n    13\ttype Handlers struct {\r\n    14\t\tRegistry   *registry.Registry\r\n    15\t\tPipeline   *pipeline.Engine\r\n    16\t\tExperiment *experiment.Tracker\r\n    17\t\tServing    *serving.Server\r\n    18\t\tTemplates  *TemplateStore\r\n    19\t}\r\n    20\t\r\n    21\t// NewRouter builds the HTTP route table and returns a handler.\r\n    22\tfunc NewRouter(reg *registry.Registry, eng *pipeline.Engine, tracker *experiment.Tracker, srv *serving.Server) http.Handler {\r\n"]
[2010.315027, "o", "    23\t\th := &Handlers{\r\n    24\t\t\tRegistry:   reg,\r\n    25\t\t\tPipeline:   eng,\r\n    26\t\t\tExperiment: tracker,\r\n    27\t\t\tServing:    srv,\r\n    28\t\t\t"]
[2010.315137, "o", "Templates:  NewTemplateStore(),\r\n    29\t\t}\r\n    30\t\r\n    31\t\tmux := http.NewServeMux()\r\n    32\t\r\n    33\t\t// Model registry endpoints\r\n    34\t\tmux.HandleFunc(\"POST /api/v1/models\", h.RegisterModel)\r\n    35\t\tmux.HandleFunc(\"GET /api/v1/models\", h.ListModels)\r\n    36\t\tmux.HandleFunc(\"GET /api/v1/models/{name}\", h.GetModel)\r\n    37\t\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions\", h.CreateVersion)\r\n    38\t\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/compare\", h.CompareVersionMetrics)\r\n    39\t\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}\", h.GetVersion)\r\n    40\t\tmux.HandleFunc(\"PUT /api/v1/models/{name}/versions/{num}/promote\", h.PromoteVersion)\r\n    41\t\tmux.HandleFunc(\"DELETE /api/v1/models/{name}\", h.DeleteModel)\r\n    42\t\r\n    43\t\t// Pipeline endpoints\r\n    44\t\tmux.HandleFunc(\"POST /api/v1/pipelines/execute\", h.ExecutePipeline)\r\n    45\t\tmux.HandleFunc(\"POST /api/v1/pipelines/templates\", h.CreateTemplate)\r\n    46\t\tmux.HandleFunc(\"GET /api/v1/pipelines/templates\", h.ListTemplates)\r\n    47\t\t"]
[2010.315213, "o", "mux.HandleFunc(\"GET /api/v1/pipelines/templates/{name}\", h.GetTemplate)\r\n    48\t\tmux.HandleFunc(\"PUT /api/v1/pipelines/templates/{name}\", h.UpdateTemplate)\r\n    49\t\tmux.HandleFunc(\"DELETE /api/v1/pipelines/templates/{name}\", h.DeleteTemplate)\r\n    50\t\tmux.HandleFunc(\"POST /api/v1/pipelines/templates/{name}/execute\", h.ExecuteTemplate)\r\n    51\t\r\n    52\t\t// Experiment endpoints\r\n    53\t\tmux.HandleFunc(\"POST /api/v1/experiments\", h.CreateExperiment)\r\n    54\t\tmux.HandleFunc(\"GET /api/v1/experiments\", h.ListExperiments)\r\n    55\t\tmux.HandleFunc(\"GET /api/v1/experiments/{name}\", h.GetExperiment)\r\n    56\t\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs\", h.LogRun)\r\n    57\t\tmux.HandleFunc(\"DELETE /api/v1/experiments/{name}/runs/{id}\", h.DeleteRun)\r\n    58\t\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/aggregate\", h.AggregateMetric)\r\n    59\t\r\n    60\t\t// Serving endpoints\r\n    61\t\tmux.HandleFunc(\"POST /api/v1/serving/load\", h.LoadModel)\r\n    62\t\tmux.HandleFunc(\"DELETE /api/v1/serving/models/{name}"]
[2010.315256, "o", "\", h.UnloadModel)\r\n    63\t\tmux.HandleFunc(\"GET /api/v1/serving/models\", h.ListLoadedModels)\r\n    64\t\tmux.HandleFunc(\"POST /api/v1/serving/infer\", h.Infer)\r\n    65\t\tmux.HandleFunc(\"POST /api/v1/serving/batch\", h.BatchInfer)\r\n    66\t\r\n    67\t\t// Health check\r\n    68\t\tmux.HandleFunc(\"GET /health\", func(w http.ResponseWriter, r *http.Request) {\r\n    69\t"]
