[6369.565388, "o", "sed -n '1,260p' internal/experiment/experiment.go\r\n"]
[6369.565489, "o", "\u001b[?2004l\r"]
[6369.568963, "o", "package experiment\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n"]
[6369.569032, "o", "\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\n// Experiment groups related runs together.\r\ntype Experiment struct {\r\n\tName      string    `json:\"name\"`\r\n\tRuns      []*Run    `json:\"runs\"`\r\n\tCreatedAt time.Time `json:\"created_at\"`\r\n"]
[6369.569097, "o", "}\r\n\r\n// Run records a single experiment execution with parameters and metrics.\r\ntype Run struct {\r\n\tID         string             `json:\"id\"`\r\n\tParameters map[string]float64 `json:\"parameters\"`\r\n\tMetrics    map[string]float64 `json:\"metrics\"`\r\n\tTags       map[string]string  `json:\"tags\"`\r\n\tCreatedAt  time.Time          `json:\"created_at\"`\r\n}\r\n"]
[6369.569168, "o", "\r\n// Tracker manages experiments and their runs.\r\ntype Tracker struct {\r\n\tmu          sync.RWMutex\r\n\texperiments map[string]*Experiment\r\n\tdataDir     string\r\n\trunCounter  int\r\n}\r\n\r\n// NewTracker creates a new experiment tracker backed by the given data directory.\r\nfunc NewTracker(dataDir string) *Tracker {\r\n\tos.MkdirAll(dataDir, 0755)\r\n\tt := &Tracker{\r\n"]
[6369.569227, "o", "\t\texperiments: make(map[string]*Experiment),\r\n\t\tdataDir:     dataDir,\r\n\t}\r\n\tt.loadAll()\r\n\treturn t\r\n}\r\n\r\n// CreateExperiment creates a new experiment with the given name.\r\nfunc (t *Tracker) CreateExperiment(name string) (*Experiment, error) {\r\n\tt.mu.Lock()\r\n"]
[6369.569289, "o", "\tdefer t.mu.Unlock()\r\n\r\n\tif _, exists := t.experiments[name]; exists {\r\n\t\treturn nil, fmt.Errorf(\"experiment %q already exists\", name)\r\n\t}\r\n\r\n\texp := &Experiment{\r\n\t\tName:      name,\r\n\t\tRuns:      make([]*Run, 0),\r\n\t\tCreatedAt: time.Now(),\r\n\t}\r\n\tt.experiments[name] = exp\r\n"]
[6369.569353, "o", "\tif err := t.saveExperiment(exp); err != nil {\r\n\t\tdelete(t.experiments, name)\r\n\t\treturn nil, err\r\n\t}\r\n\treturn exp, nil\r\n}\r\n\r\n// LogRun adds a new run to the specified experiment.\r\nfunc (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {\r\n\tt.mu.Lock()\r\n"]
[6369.569411, "o", "\tdefer t.mu.Unlock()\r\n\r\n\texp, exists := t.experiments[experimentName]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\t}\r\n\r\n\tt.runCounter++\r\n\trun := &Run{\r\n\t\tID:         fmt.Sprintf(\"run_%d\", t.runCounter),\r\n\t\tParameters: params,\r\n"]
[6369.569467, "o", "\t\tMetrics:    metrics,\r\n\t\tTags:       tags,\r\n\t\tCreatedAt:  time.Now(),\r\n\t}\r\n\texp.Runs = append(exp.Runs, run)\r\n\r\n\tif err := t.saveExperiment(exp); err != nil {\r\n\t\texp.Runs = exp.Runs[:len(exp.Runs)-1]\r\n\t\treturn nil, err\r\n\t"]
[6369.569526, "o", "}\r\n\treturn run, nil\r\n}\r\n\r\n// GetExperiment returns the experiment with the given name.\r\nfunc (t *Tracker) GetExperiment(name string) (*Experiment, error) {\r\n\tt.mu.RLock()\r\n\tdefer t.mu.RUnlock()\r\n\r\n\texp, exists := t.experiments[name]\r\n\tif !exists {\r\n"]
[6369.569589, "o", "\t\treturn nil, fmt.Errorf(\"experiment %q not found\", name)\r\n\t}\r\n\treturn exp, nil\r\n}\r\n\r\n// ListExperiments returns all experiments.\r\nfunc (t *Tracker) ListExperiments() []*Experiment {\r\n\tt.mu.RLock()\r\n\tdefer t.mu.RUnlock()\r\n\r\n\tresult := make([]*Experiment, 0, len(t.experiments))\r\n\tfor _, exp := range t.experiments {\r\n"]
[6369.569649, "o", "\t\tresult = append(result, exp)\r\n\t}\r\n\tsort.Slice(result, func(i, j int) bool {\r\n\t\treturn result[i].Name < result[j].Name\r\n\t})\r\n\treturn result\r\n}\r\n\r\n// AggregateMetric computes an aggregate statistic for a given metric across all runs\r\n"]
[6369.569709, "o", "// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.\r\n// For weighted_mean, weightParam specifies which parameter to use as weight.\r\nfunc (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string, tagFilters map[string]string) (float64, int, []string, error) {\r\n\tt.mu.RLock()\r\n\tdefer t.mu.RUnlock()\r\n\r\n\texp, exists := t.experiments[experimentName]\r\n\tif !exists {\r\n\t\treturn 0, 0, nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\t}\r\n"]
[6369.56979, "o", "\r\n\tif len(exp.Runs) == 0 {\r\n\t\treturn 0, 0, nil, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n\t}\r\n\r\n\tvar values []float64\r\n\tvar weights []float64\r\n\tvar runIDs []string\r\n\tfor _, run := range exp.Runs {\r\n\t\tif !matchTags(run.Tags, tagFilters) {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvalue, ok := run.Metrics[metricName]\r\n\t\tif !ok {\r\n"]
[6369.569848, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tif aggType == \"weighted_mean\" {\r\n\t\t\tweight, ok := run.Metrics[weightParam]\r\n\t\t\tif !ok {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvalues = append(values, value)\r\n"]
[6369.569947, "o", "\t\t\tweights = append(weights, weight)\r\n\t\t\trunIDs = append(runIDs, run.ID)\r\n\t\t} else {\r\n\t\t\tvalues = append(values, value)\r\n\t\t\trunIDs = append(runIDs, run.ID)\r\n\t\t}\r\n\t}\r\n\r\n\tif len(values) == 0 {\r\n\t\tif len(tagFilters) > 0 {\r\n\t\t\treturn 0, 0, nil, fmt.Errorf(\"no runs match tag filters for metric %q\", metricName)\r\n\t\t}\r\n\t\treturn 0, 0, nil, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n\t}\r\n"]
[6369.570006, "o", "\r\n\tswitch aggType {\r\n\tcase \"mean\":\r\n\t\tif len(values) >= 4 {\r\n\t\t\tsorted := sortedCopy(values)\r\n\t\t\ttrimmed := sorted[1 : len(sorted)-1]\r\n\t\t\tsum := 0.0\r\n\t\t\tfor _, v := range trimmed {\r\n"]
[6369.570064, "o", "\t\t\t\tsum += v\r\n\t\t\t}\r\n\t\t\treturn sum / float64(len(trimmed)), len(values), runIDs, nil\r\n\t\t}\r\n\t\tsum := 0.0\r\n\t\tfor _, v := range values {\r\n\t\t\tsum += v\r\n\t\t}\r\n\t\treturn sum / float64(len(values)), len(values), runIDs, nil\r\n\r\n"]
[6369.570121, "o", "\tcase \"median\":\r\n\t\tsorted := sortedCopy(values)\r\n\t\tn := len(sorted)\r\n\t\tif n%2 == 0 {\r\n\t\t\treturn (sorted[n/2-1] + sorted[n/2]) / 2, len(values), runIDs, nil\r\n\t\t}\r\n\t\treturn sorted[n/2], len(values), runIDs, nil\r\n\r\n\tcase \"p95\":\r\n"]
[6369.570179, "o", "\t\tsorted := sortedCopy(values)\r\n\t\treturn percentile(sorted, 0.95), len(values), runIDs, nil\r\n\r\n\tcase \"p99\":\r\n\t\tsorted := sortedCopy(values)\r\n\t\treturn percentile(sorted, 0.99), len(values), runIDs, nil\r\n\r\n\tcase \"weighted_mean\":\r\n\t\tif weightParam == \"\" {\r\n"]
[6369.570236, "o", "\t\t\treturn 0, 0, nil, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\n\t\t}\r\n\t\tif len(weights) == 0 {\r\n\t\t\treturn 0, 0, nil, fmt.Errorf(\"no runs with metric %q and weight metric %q\", metricName, weightParam)\r\n\t\t}\r\n\t\tif len(weights) != len(values) {\r\n\t\t\treturn 0, 0, nil, fmt.Errorf(\"mismatch between metric values and weights\")\r\n\t\t}\r\n"]
[6369.570293, "o", "\t\tweightedSum := 0.0\r\n\t\tweightSum := 0.0\r\n\t\tfor i, v := range values {\r\n\t\t\tweightedSum += v * weights[i]\r\n\t\t\tweightSum += weights[i]\r\n\t\t}\r\n\t\tif weightSum == 0 {\r\n\t\t\treturn 0, 0, nil, fmt.Errorf(\"weighted_mean has zero total weight\")\r\n"]
[6369.570354, "o", "\t\t}\r\n\t\treturn weightedSum / weightSum, len(values), runIDs, nil\r\n\r\n\tdefault:\r\n\t\treturn 0, 0, nil, fmt.Errorf(\"unknown aggregation type %q\", aggType)\r\n\t}\r\n}\r\n\r\n// CorrelationResult contains the Pearson correlation coefficient between two metrics.\r\ntype CorrelationResult struct {\r\n"]
[6369.570412, "o", "\tExperiment string  `json:\"experiment\"`\r\n\tMetricX    string  `json:\"metric_x\"`\r\n\tMetricY    string  `json:\"metric_y\"`\r\n\tR          float64 `json:\"r\"`\r\n\tCount      int     `json:\"count\"`\r\n}\r\n\r\n// Correlation computes the Pearson correlation coefficient between two metrics\r\n// across all runs that have both metrics.\r\nfunc (t *Tracker) Correlation(experimentName, metricX, metricY string) (*CorrelationResult, error) {\r\n\tt.mu.RLock()\r\n\tdefer t.mu.RUnlock()\r\n\r\n"]
[6369.570474, "o", "\texp, exists := t.experiments[experimentName]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\t}\r\n\r\n\tvar xs []float64\r\n\tvar ys []float64\r\n\tfor _, run := range exp.Runs {\r\n\t\tx, ok1 := run.Metrics[metricX]\r\n\t\ty, ok2 := run.Metrics[metricY]\r\n\t"]
[6369.570534, "o", "\tif !ok1 || !ok2 {\r\n\t\t\tcontinue\r\n"]
[6369.571084, "o", "\u001b[?2004h"]
