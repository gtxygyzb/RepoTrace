[6218.145045, "o", "12:// Supported modes: scale, offset, normalize, identity, clip, log.\r\n13:func ExecuteTransform(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n14-\tdata, ok := input[\"data\"].([]interface{})\r\n15-\tif !ok {\r\n16-\t\treturn nil, fmt.Errorf(\"transform: missing or invalid 'data' field in input\")\r\n17-\t}\r\n18-\r\n19:\tmode, _ := config[\"mode\"].(string)\r\n20:\tif mode == \"\" {\r\n21:\t\treturn nil, fmt.Errorf(\"transform: missing 'mode' in config\")\r\n22-\t}\r\n23-\r\n24-\tresult := make([]interface{}, len(data))\r\n25-\r\n26:\tswitch mode {\r\n27-\tcase \"scale\":\r\n28-\t\tfactor, _ := config[\"factor\"].(float64)\r\n29-\t"]
[6218.145142, "o", "\tfor i, v := range data {\r\n30-\t\t\tval, err := toFloat(v)\r\n31-\t\t\tif err != nil {\r\n32-\t\t\t\treturn nil, fmt.Errorf(\"transform scale: element %d: %w\", i, err)\r\n33-\t\t\t}\r\n34-\t\t\tresult[i] = val * factor\r\n35-\t\t}\r\n36-\r\n37-\tcase \"offset\":\r\n38-\t\toffset, _ := config[\"offset\"].(float64)\r\n39-\t\tfor i, v := range data {\r\n40-\t\t\tval, err := toFloat(v)\r\n41-\t\t\tif err != nil {\r\n42-\t\t\t\treturn nil, fmt.Errorf(\"transform offset: element %d: %w\", i, err)\r\n43-\t\t\t}\r\n44-\t\t\tresult[i] = val + offset\r\n45-\t\t}\r\n46-\r\n47-\tcase \"normalize\":\r\n48-\t\tif len(data) == 0 {\r\n49-\t\t\treturn map[string]interface{}{\"data\": result}, nil\r\n50-\t\t"]
[6218.145223, "o", "}\r\n51-\t\tminVal, maxVal := findMinMax(data)\r\n52-\t\tfor i, v := range data {\r\n53-\t\t\tval, err := toFloat(v)\r\n54-\t\t\tif err != nil {\r\n55-\t\t\t\treturn nil, fmt.Errorf(\"transform normalize: element %d: %w\", i, err)\r\n56-\t\t\t}\r\n57-\t\t\tif maxVal == minVal {\r\n58-\t\t\t\tresult[i] = 0.0\r\n59-\t\t\t} else {\r\n60-\t\t\t\tresult[i] = 2.0*(val-minVal)/(maxVal-minVal) - 1.0\r\n61-\t\t\t}\r\n62-\t\t}\r\n63-\r\n64-\tcase \"identity\":\r\n65-\t\tcopy(result, data)"]
[6218.14529, "o", "\r\n66-\r\n67-\tcase \"clip\":\r\n68-\t\tlow, _ := config[\"low\"].(float64)\r\n69-\t\thigh, _ := config[\"high\"].(float64)\r\n70-\t\tfor i, v := range data {\r\n71-\t\t\tval, err := toFloat(v)\r\n72-\t\t\tif err != nil {\r\n73-\t\t\t\treturn nil, fmt.Errorf(\"transform clip: element %d: %w\", i, err)\r\n74-\t\t\t}\r\n75-\t\t\tif val < low {\r\n76-\t\t\t\tval = low\r\n77-\t\t\t}\r\n78-\t\t\tif val > high {\r\n79-\t\t\t\tval = high\r\n80-\t\t\t}\r\n81-"]
[6218.145349, "o", "\t\t\tresult[i] = val\r\n82-\t\t}\r\n83-\r\n84-\tcase \"log\":\r\n85-\t\tfor i, v := range data {\r\n86-\t\t\tval, err := toFloat(v)\r\n--\r\n97:\t\treturn nil, fmt.Errorf(\"transform: unknown mode %q\", mode)\r\n98-\t}\r\n99-\r\n100-\treturn map[string]interface{}{\"data\": result}, nil\r\n"]
