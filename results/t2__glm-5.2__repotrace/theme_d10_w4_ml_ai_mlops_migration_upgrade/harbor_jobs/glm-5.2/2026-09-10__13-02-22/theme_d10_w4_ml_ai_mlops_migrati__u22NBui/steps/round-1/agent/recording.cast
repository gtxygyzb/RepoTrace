[6956.160703, "o", "\r\n"]
[6956.160769, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.160861, "o", "result.Valid = false\r\n\u001b[?2004l\r"]
[6956.160928, "o", "\u001b[?2004h> "]
[6956.160996, "o", "\u0007\r\n"]
[6956.161052, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.161121, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.16119, "o", "\r\n"]
[6956.161256, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.161323, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.161881, "o", "result.Errors = append(result.Errors, fmt.Sprintf(\"step %q depends on itself\", step.Name))\r\n\u001b[?2004l\r"]
[6956.161948, "o", "\u001b[?2004h> "]
[6956.162014, "o", "\u0007\r\n"]
[6956.162097, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\n"]
[6956.162152, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.162226, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.162286, "o", "\r\n"]
[6956.162353, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.162479, "o", "selfDependencyFound = true\r\n\u001b[?2004l\r"]
[6956.162546, "o", "\u001b[?2004h> "]
[6956.162617, "o", "\u0007\r\n"]
[6956.162683, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.16275, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.162807, "o", "\r\n"]
[6956.162908, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.162979, "o", "\u0007"]
[6956.163043, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.163117, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.163177, "o", "\r\n"]
[6956.163242, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.163305, "o", "if !seen[dep] {\r\n\u001b[?2004l\r"]
[6956.163346, "o", "\u001b[?2004h> "]
[6956.163405, "o", "\u0007"]
[6956.163448, "o", "\r\n"]
[6956.163488, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.163538, "o", "\r\n"]
[6956.163573, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.163625, "o", "\r\n"]
[6956.191997, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> result.Valid = false\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> result.Errors = append(result.Errors, fmt.Sprintf(\"step %s depends on unknown step: %s\", step.Name, dep))\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> }\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n"]
[6956.192074, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> }'''\r\n\u001b[?2004l\r\u001b[?2004h> text, n = re.subn(dep_pattern, dep_replacement, text, count=1)\r\n\u001b[?2004l\r\u001b[?2004h> if n != 1:\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit(\"dependency validation block not replaced\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.192169, "o", "cycle_pattern = r'''ordered, err := topologicalSort\\(p\\.Steps\\)\r\n\u001b[?2004l\r"]
[6956.192236, "o", "\u001b[?2004h> "]
[6956.192371, "o", "\\tif err != nil \\{\r\n\u001b[?2004l\r"]
[6956.192439, "o", "\u001b[?2004h> "]
[6956.192608, "o", "\\t\\tresult\\.Valid = false\r\n\u001b[?2004l\r"]
[6956.192675, "o", "\u001b[?2004h> "]
[6956.193063, "o", "\\t\\tif strings\\.Contains\\(err\\.Error\\(\\), \"cycle\"\\) \\{\r\n\u001b[?2004l\r"]
[6956.193131, "o", "\u001b[?2004h> "]
[6956.193635, "o", "\\t\\t\\tresult\\.Errors = append\\(result\\.Errors, \"dependency cycle detected\"\\)\r\n\u001b[?2004l\r"]
[6956.193702, "o", "\u001b[?2004h> "]
[6956.193776, "o", "\\t\\t\\}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.193844, "o", "> "]
[6956.193945, "o", "\\t\\}'''\r\n\u001b[?2004l\r"]
[6956.194014, "o", "\u001b[?2004h> "]
[6956.194367, "o", "cycle_replacement = '''ordered, err := topologicalSort(p.Steps)\r\n\u001b[?2004l\r"]
[6956.194435, "o", "\u001b[?2004h> "]
[6956.194501, "o", "\u0007"]
[6956.19462, "o", "if err != nil {\r\n\u001b[?2004l\r"]
[6956.194684, "o", "\u001b[?2004h> "]
[6956.194745, "o", "\u0007"]
[6956.194806, "o", "\r\n"]
[6956.194889, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.195025, "o", "result.Valid = false\r\n\u001b[?2004l\r"]
[6956.19509, "o", "\u001b[?2004h> "]
[6956.195157, "o", "\u0007"]
[6956.19522, "o", "\r\n"]
[6956.195274, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.195733, "o", "if strings.Contains(err.Error(), \"cycle\") && !selfDependencyFound {\r\n\u001b[?2004l\r"]
[6956.195798, "o", "\u001b[?2004h> "]
[6956.195864, "o", "\u0007"]
[6956.195931, "o", "\r\n"]
[6956.195985, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.19606, "o", "\r\n"]
[6956.196131, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.196558, "o", "result.Errors = append(result.Errors, \"dependency cycle detected\")\r\n\u001b[?2004l\r"]
[6956.196625, "o", "\u001b[?2004h> "]
[6956.196694, "o", "\u0007"]
[6956.196759, "o", "\r\n"]
[6956.196814, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[6956.196894, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.196969, "o", "\u0007"]
[6956.197033, "o", "}'''\r\n\u001b[?2004l\r"]
[6956.1971, "o", "\u001b[?2004h> "]
[6956.197518, "o", "text, n = re.subn(cycle_pattern, cycle_replacement, text, count=1)\r\n\u001b[?2004l\r"]
[6956.197586, "o", "\u001b[?2004h> "]
[6956.197657, "o", "if n != 1:\r\n\u001b[?2004l\r"]
[6956.197724, "o", "\u001b[?2004h> "]
[6956.198128, "o", "    raise SystemExit(\"cycle validation block not replaced\")\r\n\u001b[?2004l\r"]
[6956.198195, "o", "\u001b[?2004h> "]
[6956.198321, "o", "p.write_text(text)\r\n\u001b[?2004l\r"]
[6956.198377, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.19844, "o", "\u001b[?2004h> "]
[6956.198811, "o", "# --- experiment deletion + leaderboard + summary ---\r\n\u001b[?2004l\r"]
[6956.198886, "o", "\u001b[?2004h> "]
[6956.199192, "o", "p = Path(\"internal/experiment/experiment.go\")\r\n\u001b[?2004l\r"]
[6956.199259, "o", "\u001b[?2004h> "]
[6956.199398, "o", "text = p.read_text()\r\n\u001b[?2004l\r"]
[6956.199454, "o", "\u001b[?2004h> "]
[6956.199801, "o", "start = text.index(\"func (t *Tracker) DeleteRun\")\r\n\u001b[?2004l\r"]
[6956.199889, "o", "\u001b[?2004h> "]
[6956.200184, "o", "end = text.index(\"\\n\\nfunc percentile\", start)\r\n\u001b[?2004l\r"]
[6956.200242, "o", "\u001b[?2004h> "]
[6956.200845, "o", "new_block = '''func (t *Tracker) DeleteRun(experimentName, runID string) (*Run, error) {\r\n\u001b[?2004l\r"]
[6956.200922, "o", "\u001b[?2004h> "]
[6956.20101, "o", "\\tt.mu.Lock()\r\n\u001b[?2004l\r"]
[6956.201076, "o", "\u001b[?2004h> "]
[6956.201222, "o", "\\tdefer t.mu.Unlock()\r\n\u001b[?2004l\r"]
[6956.201289, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.201355, "o", "\u001b[?2004h> "]
[6956.201664, "o", "\\texp, exists := t.experiments[experimentName]\r\n\u001b[?2004l\r"]
[6956.20173, "o", "\u001b[?2004h> "]
[6956.201831, "o", "\\tif !exists {\r\n\u001b[?2004l\r"]
[6956.201906, "o", "\u001b[?2004h> "]
[6956.202363, "o", "\\t\\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\u001b[?2004l\r"]
[6956.202429, "o", "\u001b[?2004h> "]
[6956.202495, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.202566, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.202804, "o", "\\tfor i, run := range exp.Runs {\r\n\u001b[?2004l\r"]
[6956.202876, "o", "\u001b[?2004h> "]
[6956.203044, "o", "\\t\\tif run.ID == runID {\r\n\u001b[?2004l\r"]
[6956.20311, "o", "\u001b[?2004h> "]
[6956.203304, "o", "\\t\\t\\tdeleted := exp.Runs[i]\r\n\u001b[?2004l\r"]
[6956.203368, "o", "\u001b[?2004h> "]
[6956.203749, "o", "\\t\\t\\texp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)\r\n\u001b[?2004l\r"]
[6956.203816, "o", "\u001b[?2004h> "]
[6956.204162, "o", "\\t\\t\\tif err := t.saveExperiment(exp); err != nil {\r\n\u001b[?2004l\r"]
[6956.204227, "o", "\u001b[?2004h> "]
[6956.204385, "o", "\\t\\t\\t\\treturn nil, err\r\n\u001b[?2004l\r"]
[6956.204439, "o", "\u001b[?2004h> "]
[6956.204515, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[6956.20458, "o", "\u001b[?2004h> "]
[6956.20476, "o", "\\t\\t\\treturn deleted, nil\r\n\u001b[?2004l\r"]
[6956.204825, "o", "\u001b[?2004h> "]
[6956.2049, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.204965, "o", "> \\t}\r\n\u001b[?2004l\r"]
[6956.205033, "o", "\u001b[?2004h> "]
[6956.205588, "o", "\\treturn nil, fmt.Errorf(\"run %q not found in experiment %q\", runID, experimentName)\r\n\u001b[?2004l\r"]
[6956.205655, "o", "\u001b[?2004h> }\r\n"]
[6956.205719, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.205775, "o", "\u001b[?2004h> "]
[6956.20621, "o", "// LeaderboardEntry represents a run in a metric leaderboard.\r\n\u001b[?2004l\r"]
[6956.206278, "o", "\u001b[?2004h> "]
[6956.206484, "o", "type LeaderboardEntry struct {\r\n\u001b[?2004l\r"]
[6956.20655, "o", "\u001b[?2004h> "]
[6956.206893, "o", "\\tRank       int                    `json:\"rank\"`\r\n\u001b[?2004l\r"]
[6956.206926, "o", "\u001b[?2004h"]
[6956.207013, "o", "> "]
[6956.207302, "o", "\\tRunID      string                 `json:\"run_id\"`\r\n\u001b[?2004l\r"]
[6956.207367, "o", "\u001b[?2004h> "]
[6956.207702, "o", "\\tValue      float64                `json:\"value\"`\r\n\u001b[?2004l\r"]
[6956.207768, "o", "\u001b[?2004h> "]
[6956.20815, "o", "\\tParameters map[string]float64     `json:\"parameters\"`\r\n\u001b[?2004l\r"]
[6956.208183, "o", "\u001b[?2004h"]
[6956.208268, "o", "> "]
[6956.208563, "o", "\\tMetrics    map[string]float64     `json:\"metrics\"`\r\n\u001b[?2004l\r"]
[6956.20863, "o", "\u001b[?2004h> }\r\n"]
[6956.208696, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[6956.208763, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[6956.209163, "o", "// LeaderboardResult contains the top runs for a metric.\r\n\u001b[?2004l\r"]
[6956.209232, "o", "\u001b[?2004h> "]
[6956.209444, "o", "type LeaderboardResult struct {\r\n\u001b[?2004l\r"]
[6956.209511, "o", "\u001b[?2004h> "]
[6956.209858, "o", "\\tExperiment string             `json:\"experiment\"`\r\n\u001b[?2004l\r"]
[6956.209926, "o", "\u001b[?2004h> "]
[6956.21024, "o", "\\tMetric     string             `json:\"metric\"`\r\n\u001b[?2004l\r"]
[6956.210307, "o", "\u001b[?2004h> "]
[6956.210616, "o", "\\tOrder      string             `json:\"order\"`\r\n\u001b[?2004l\r"]
[6956.210682, "o", "\u001b[?2004h> "]
[6956.210947, "o", "\\tEntries    []LeaderboardEntry `json:\"entries\"`\r\n\u001b[?2004l\r"]
[6956.211014, "o", "\u001b[?2004h> "]
[6956.211257, "o", "\\tTotalRuns  int                `json:\"total_runs\"`\r\n\u001b[?2004l\r"]
[6956.211323, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[6956.211393, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.211791, "o", "// Leaderboard returns the top runs for an experiment ranked by a metric.\r\n\u001b[?2004l\r"]
[6956.211864, "o", "\u001b[?2004h> "]
[6956.2124, "o", "func (t *Tracker) Leaderboard(experimentName, metric, order string, limit int) (*LeaderboardResult, error) {\r\n\u001b[?2004l\r"]
[6956.212469, "o", "\u001b[?2004h> "]
[6956.212531, "o", "\\tif order == \"\" {\r\n\u001b[?2004l\r"]
[6956.212597, "o", "\u001b[?2004h> "]
[6956.212672, "o", "\\t\\torder = \"desc\"\r\n\u001b[?2004l\r"]
[6956.212739, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6956.212808, "o", "\u001b[?2004h> "]
[6956.212983, "o", "\\tif order != \"asc\" && order != \"desc\" {\r\n\u001b[?2004l\r"]
[6956.213051, "o", "\u001b[?2004h> "]
[6956.213376, "o", "\\t\\treturn nil, fmt.Errorf(\"order must be \\\\\"asc\\\\\" or \\\\\"desc\\\\\"\")\r\n\u001b[?2004l\r"]
[6956.213442, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6956.213508, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.213597, "o", "\\tt.mu.RLock()\r\n\u001b[?2004l\r"]
[6956.213662, "o", "\u001b[?2004h> "]
[6956.213746, "o", "\\tdefer t.mu.RUnlock()\r\n\u001b[?2004l\r"]
[6956.213811, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h"]
[6956.213886, "o", "> "]
[6956.214073, "o", "\\texp, exists := t.experiments[experimentName]\r\n\u001b[?2004l\r"]
[6956.214139, "o", "\u001b[?2004h> "]
[6956.214194, "o", "\\tif !exists {\r\n\u001b[?2004l\r"]
[6956.214259, "o", "\u001b[?2004h> "]
[6956.214599, "o", "\\t\\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\u001b[?2004l\r"]
[6956.214666, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6956.214732, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.214871, "o", "\\ttype candidate struct {\r\n\u001b[?2004l\r"]
[6956.21494, "o", "\u001b[?2004h> "]
[6956.215013, "o", "\\t\\trun   *Run\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.215078, "o", "> "]
[6956.215149, "o", "\\t\\tvalue float64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.215215, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.215387, "o", "\\tvar candidates []candidate\r\n\u001b[?2004l\r"]
[6956.215454, "o", "\u001b[?2004h> "]
[6956.215583, "o", "\\tfor _, run := range exp.Runs {\r\n\u001b[?2004l\r"]
[6956.215648, "o", "\u001b[?2004h> "]
[6956.215731, "o", "\\t\\tif run == nil {\r\n\u001b[?2004l\r"]
[6956.215797, "o", "\u001b[?2004h> "]
[6956.215867, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.215933, "o", "> \\t\\t}\r\n\u001b[?2004l\r"]
[6956.216007, "o", "\u001b[?2004h> "]
[6956.216162, "o", "\\t\\tvalue, ok := run.Metrics[metric]\r\n\u001b[?2004l\r"]
[6956.216228, "o", "\u001b[?2004h> "]
[6956.216297, "o", "\\t\\tif !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.216397, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[6956.216462, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[6956.21653, "o", "\u001b[?2004h> "]
[6956.216879, "o", "\\t\\tcandidates = append(candidates, candidate{run: run, value: value})\r\n\u001b[?2004l\r"]
[6956.216946, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6956.21701, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.217277, "o", "\\tsort.Slice(candidates, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[6956.217345, "o", "\u001b[?2004h> "]
[6956.217593, "o", "\\t\\tif candidates[i].value != candidates[j].value {\r\n\u001b[?2004l\r"]
[6956.217659, "o", "\u001b[?2004h> "]
[6956.217769, "o", "\\t\\t\\tif order == \"desc\" {\r\n\u001b[?2004l\r"]
[6956.217915, "o", "\u001b[?2004h> "]
[6956.218115, "o", "\\t\\t\\t\\treturn candidates[i].value > candidates[j].value\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.218221, "o", "> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.218514, "o", "\\t\\t\\treturn candidates[i].value < candidates[j].value\r\n\u001b[?2004l\r"]
[6956.218576, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[6956.218637, "o", "\u001b[?2004h> "]
[6956.218924, "o", "\\t\\treturn candidates[i].run.ID < candidates[j].run.ID\r\n\u001b[?2004l\r"]
[6956.218983, "o", "\u001b[?2004h> \\t})\r\n\u001b[?2004l\r"]
[6956.219042, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.219099, "o", "\u001b[?2004h> "]
[6956.219161, "o", "\\tif limit < 0 {\r\n\u001b[?2004l\r"]
[6956.219217, "o", "\u001b[?2004h> "]
[6956.219278, "o", "\\t\\tlimit = 0\r\n\u001b[?2004l\r"]
[6956.219334, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6956.219391, "o", "\u001b[?2004h> "]
[6956.219544, "o", "\\tif limit > len(candidates) {\r\n\u001b[?2004l\r"]
[6956.2196, "o", "\u001b[?2004h> "]
[6956.219742, "o", "\\t\\tlimit = len(candidates)\r\n\u001b[?2004l\r"]
[6956.219798, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6956.219859, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.219892, "o", "\u001b[?2004h> "]
[6956.220144, "o", "\\tentries := make([]LeaderboardEntry, 0, limit)\r\n\u001b[?2004l\r"]
[6956.220227, "o", "\u001b[?2004h> "]
[6956.220345, "o", "\\tfor i := 0; i < limit; i++ {\r\n\u001b[?2004l\r"]
[6956.220403, "o", "\u001b[?2004h> "]
[6956.220539, "o", "\\t\\trun := candidates[i].run\r\n\u001b[?2004l\r"]
[6956.220596, "o", "\u001b[?2004h> "]
[6956.220828, "o", "\\t\\tentries = append(entries, LeaderboardEntry{\r\n\u001b[?2004l\r"]
[6956.220896, "o", "\u001b[?2004h> "]
[6956.221002, "o", "\\t\\t\\tRank:       i + 1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.221059, "o", "> "]
[6956.221124, "o", "\\t\\t\\tRunID:      run.ID,\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.22118, "o", "> "]
[6956.22128, "o", "\\t\\t\\tValue:      candidates[i].value,\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.221337, "o", "> "]
[6956.221421, "o", "\\t\\t\\tParameters: run.Parameters,\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.221477, "o", "> "]
[6956.221552, "o", "\\t\\t\\tMetrics:    run.Metrics,\r\n\u001b[?2004l\r"]
[6956.221609, "o", "\u001b[?2004h> \\t\\t})\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.221665, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.221722, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.221823, "o", "\\treturn &LeaderboardResult{\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.221887, "o", "> "]
[6956.22196, "o", "\\t\\tExperiment: experimentName,\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.222016, "o", "> "]
[6956.222082, "o", "\\t\\tMetric:     metric,\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.222137, "o", "> "]
[6956.22219, "o", "\\t\\tOrder:      order,\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.222244, "o", "> "]
[6956.222303, "o", "\\t\\tEntries:    entries,\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.222358, "o", "> "]
[6956.222442, "o", "\\t\\tTotalRuns:  len(candidates),\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.222497, "o", "> \\t}, nil\r\n\u001b[?2004l\r="]
[6956.222559, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[6956.222614, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[6956.222826, "o", "// SummaryResult contains basic statistics for a metric across runs.\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.222894, "o", "> "]
[6956.222952, "o", "type SummaryResult struct {\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.223007, "o", "> "]
[6956.223104, "o", "\\tExperiment string  `json:\"experiment\"`\r\n\u001b[?2004l\r"]
[6956.22316, "o", "\u001b[?2004h> "]
[6956.223262, "o", "\\tMetric     string  `json:\"metric\"`\r\n\u001b[?2004l\r"]
[6956.223317, "o", "\u001b[?2004h> "]
[6956.223413, "o", "\\tCount      int     `json:\"count\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.223469, "o", "> "]
[6956.223547, "o", "\\tMin        float64 `json:\"min\"`\r\n\u001b[?2004l\r"]
[6956.223603, "o", "\u001b[?2004h> "]
[6956.223695, "o", "\\tMax        float64 `json:\"max\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.22375, "o", "> "]
[6956.223831, "o", "\\tMean       float64 `json:\"mean\"`\r\n\u001b[?2004l\r"]
[6956.223896, "o", "\u001b[?2004h> "]
[6956.223988, "o", "\\tMedian     float64 `json:\"median\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.224044, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.224099, "o", "\u001b[?2004h> "]
[6956.224378, "o", "// Summary computes summary statistics for a metric across all runs in an experiment.\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.224434, "o", "> "]
[6956.224674, "o", "func (t *Tracker) Summary(experimentName, metric string) (*SummaryResult, error) {\r\n\u001b[?2004l\r"]
[6956.224729, "o", "\u001b[?2004h> "]
[6956.224784, "o", "\\tt.mu.RLock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.224874, "o", "\\tdefer t.mu.RUnlock()\r\n\u001b[?2004l\r"]
[6956.224932, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.225098, "o", "\\texp, exists := t.experiments[experimentName]\r\n\u001b[?2004l\r"]
[6956.225155, "o", "\u001b[?2004h> "]
[6956.225211, "o", "\\tif !exists {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.225437, "o", "\\t\\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.225494, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[6956.225552, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[6956.225617, "o", "\\tvar values []float64\r\n\u001b[?2004l\r"]
[6956.225672, "o", "\u001b[?2004h> "]
[6956.225764, "o", "\\tfor _, run := range exp.Runs {\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.225818, "o", "> "]
[6956.22588, "o", "\\t\\tif run == nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.225944, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[6956.225999, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r}\u001b[?2004h"]
[6956.226054, "o", "> "]
[6956.226178, "o", "\\t\\tif value, ok := run.Metrics[metric]; ok {\r\n\u001b[?2004l\r"]
[6956.226233, "o", "\u001b[?2004h> "]
[6956.226326, "o", "\\t\\t\\tvalues = append(values, value)\r\n\u001b[?2004l\r"]
[6956.226381, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[6956.226437, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.226494, "o", "d\u001b[?2004h> "]
[6956.226587, "o", "\\tif len(values) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.226642, "o", "> "]
[6956.2268, "o", "\\t\\treturn nil, fmt.Errorf(\"no runs have metric %q\", metric)\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.226864, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.226925, "o", "o\u001b[?2004h> "]
[6956.227002, "o", "\\tsort.Float64s(values)\r\n\u001b[?2004l\rE\u001b[?2004h"]
[6956.227057, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.227131, "o", "\\tmin := values[0]\r\n\u001b[?2004l\r"]
[6956.227186, "o", "\u001b[?2004h> "]
[6956.227255, "o", "\\tmax := values[len(values)-1]\r\n\u001b[?2004l\r"]
[6956.227311, "o", "\u001b[?2004h> "]
[6956.227366, "o", "\\tsum := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.227458, "o", "\\tfor _, v := range values {\r\n\u001b[?2004l\r"]
[6956.227512, "o", "\u001b[?2004h> "]
[6956.227566, "o", "\\t\\tsum += v\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6956.227622, "o", "\u001b[?2004h> "]
[6956.22774, "o", "\\tmean := sum / float64(len(values))\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.227796, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.227849, "o", "\\tmedian := 0.0\r\n\u001b[?2004l\r"]
[6956.227914, "o", "\u001b[?2004h> "]
[6956.227969, "o", "\\tn := len(values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.22803, "o", "\\tif n%2 == 1 {\r\n\u001b[?2004l\r"]
[6956.228086, "o", "\u001b[?2004h> "]
[6956.228151, "o", "\\t\\tmedian = values[n/2]\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.228206, "o", "> \\t} else {\r\n\u001b[?2004l\r"]
[6956.228263, "o", "\u001b[?2004h> "]
[6956.228411, "o", "\\t\\tmedian = (values[n/2-1] + values[n/2]) / 2.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.228467, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.228523, "o", "\u001b[?2004h> "]
[6956.228593, "o", "\\treturn &SummaryResult{\r\n\u001b[?2004l\r"]
[6956.228666, "o", "\u001b[?2004h> "]
[6956.228734, "o", "\\t\\tExperiment: experimentName,\r\n\u001b[?2004l\r"]
[6956.228746, "o", "\u001b[?2004h> "]
[6956.228829, "o", "\\t\\tMetric:     metric,\r\n\u001b[?2004l\r"]
[6956.228889, "o", "\u001b[?2004h> "]
[6956.228942, "o", "\\t\\tCount:      n,\r\n\u001b[?2004l\ri"]
[6956.228988, "o", "\u001b[?2004h> "]
[6956.229048, "o", "\\t\\tMin:        min,\r\n\u001b[?2004l\r"]
[6956.229058, "o", "\u001b[?2004h"]
[6956.229118, "o", "> "]
[6956.229167, "o", "\\t\\tMax:        max,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.229252, "o", "\\t\\tMean:       mean,\r\n\u001b[?2004l\r"]
[6956.229263, "o", "\u001b[?2004h"]
[6956.229322, "o", "> "]
[6956.229369, "o", "\\t\\tMedian:     median,\r\n\u001b[?2004l\r"]
[6956.229379, "o", "\u001b[?2004h"]
[6956.229435, "o", "> \\t}, nil\r\n\u001b[?2004l\r"]
[6956.229445, "o", "\u001b[?2004h> "]
[6956.229501, "o", "}'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.229666, "o", "text = text[:start] + new_block + text[end:]\r\n\u001b[?2004l\r"]
[6956.229676, "o", "\u001b[?2004h"]
[6956.229735, "o", "> "]
[6956.229745, "o", "p.write_text(text)\r\n"]
[6956.229803, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[6956.229935, "o", "# --- serving reload + warmup ---\r\n\u001b[?2004l\r"]
[6956.229945, "o", "\u001b[?2004h> "]
[6956.230085, "o", "p = Path(\"internal/serving/serving.go\")\r\n\u001b[?2004l\r"]
[6956.230136, "o", "\u001b[?2004h> "]
[6956.230196, "o", "text = p.read_text()\r\n\u001b[?2004l\r"]
[6956.230207, "o", "\u001b[?2004h"]
[6956.230265, "o", "> "]
[6956.230363, "o", "warmup_type = '''type WarmupResult struct {\r\n\u001b[?2004l\r"]
[6956.230413, "o", "\u001b[?2004h> "]
[6956.230516, "o", "\\tStatus     string  `json:\"status\"`\r\n\u001b[?2004l\r"]
[6956.230566, "o", "\u001b[?2004h> "]
[6956.230683, "o", "\\tModelName  string  `json:\"model_name\"`\r\n\u001b[?2004l\r"]
[6956.230695, "o", "\u001b[?2004h"]
[6956.230754, "o", "> "]
[6956.230857, "o", "\\tVersionNum int     `json:\"version_num\"`\r\n\u001b[?2004l\r"]
[6956.230905, "o", "\u001b[?2004h> "]
[6956.231035, "o", "\\tLatencyMs  float64 `json:\"latency_ms\"`\r\n\u001b[?2004l\r"]
[6956.231086, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.231097, "o", "> \r\n\u001b[?2004l\r"]
[6956.231159, "o", "\u001b[?2004h> "]
[6956.231351, "o", "// ModelStats tracks inference statistics for a single model.'''\r\n\u001b[?2004l\r"]
[6956.231401, "o", "\u001b[?2004h> "]
[6956.231715, "o", "text = text.replace(\"// ModelStats tracks inference statistics for a single model.\", warmup_type, 1)\r\n\u001b[?2004l\r"]
[6956.231767, "o", "\u001b[?2004h> "]
[6956.232024, "o", "methods = '''func (s *Server) ReloadModel(modelName string) (*LoadedModel, error) {\r\n\u001b[?2004l\r"]
[6956.232035, "o", "\u001b[?2004h> "]
[6956.232091, "o", "\\ts.mu.Lock()\r\n\u001b[?2004l\r"]
[6956.232103, "o", "\u001b[?2004h> "]
[6956.232157, "o", "\\tdefer s.mu.Unlock()\r\n\u001b[?2004l\r"]
[6956.232207, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[6956.232318, "o", "\\tloaded, exists := s.loaded[modelName]\r\n\u001b[?2004l\r"]
[6956.232328, "o", "\u001b[?2004h> "]
[6956.232407, "o", "\\tif !exists {\r\n\u001b[?2004l\r"]
[6956.232418, "o", "\u001b[?2004h> "]
[6956.232682, "o", "\\t\\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", modelName)\r\n\u001b[?2004l\r"]
[6956.232695, "o", "\u001b[?2004h> "]
[6956.232754, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[6956.233049, "o", "\\tversion, err := s.registry.GetVersion(modelName, loaded.VersionNum)\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.23306, "o", "> "]
[6956.23311, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[6956.23312, "o", "\u001b[?2004h> "]
[6956.233321, "o", "\\t\\treturn nil, fmt.Errorf(\"version no longer exists in registry: %w\", err)\r\n\u001b[?2004l\r"]
[6956.233331, "o", "\u001b[?2004h> "]
[6956.233389, "o", "\\t}\r\n\u001b[?2004l\r(\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[6956.233546, "o", "\\ts.loaded[modelName] = &LoadedModel{\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.233556, "o", "> "]
[6956.233665, "o", "\\t\\tModelName:   modelName,\r\n\u001b[?2004l\r"]
[6956.233676, "o", "\u001b[?2004h> "]
[6956.23385, "o", "\\t\\tVersionNum:  version.Number,\r\n\u001b[?2004l\r"]
[6956.233903, "o", "\u001b[?2004h> "]
[6956.233959, "o", "\\t\\tStage:       version.Stage,\r\n\u001b[?2004l\r"]
[6956.233969, "o", "\u001b[?2004h> "]
[6956.234138, "o", "\\t\\tModelConfig: version.ModelConfig,\r\n\u001b[?2004l\r"]
[6956.234189, "o", "\u001b[?2004h> "]
[6956.234256, "o", "\\t\\tLoadedAt:    time.Now(),\r\n\u001b[?2004l\r"]
[6956.234308, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.234427, "o", "\\treturn s.loaded[modelName], nil\r\n\u001b[?2004l\r"]
[6956.234439, "o", "\u001b[?2004h> "]
[6956.234497, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rp\u001b[?2004h> "]
[6956.234746, "o", "func (s *Server) WarmupModel(modelName string) (*WarmupResult, error) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.234794, "o", "> "]
[6956.234844, "o", "\\tstart := time.Now()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r+\u001b[?2004h> "]
[6956.234905, "o", "\\ts.mu.RLock()\r\n\u001b[?2004l\rd"]
[6956.234916, "o", "\u001b[?2004h> "]
[6956.235016, "o", "\\tloaded, exists := s.loaded[modelName]\r\n\u001b[?2004l\r"]
[6956.235066, "o", "\u001b[?2004h> "]
[6956.235119, "o", "\\ts.mu.RUnlock()\r\n\u001b[?2004l\r"]
[6956.235131, "o", "\u001b[?2004h> "]
[6956.235195, "o", "\r\n\u001b[?2004l\ra\u001b[?2004h> \\tif !exists {"]
[6956.235206, "o", "\r\n\u001b[?2004l\r"]
[6956.235268, "o", "\u001b[?2004h> "]
[6956.235427, "o", "\\t\\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", modelName)\r\n\u001b[?2004l\r"]
[6956.235476, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rx"]
[6956.235488, "o", "\u001b[?2004h"]
[6956.235546, "o", "> "]
[6956.23571, "o", "\\tif _, err := computePrediction(loaded.ModelConfig, []float64{0.0}); err != nil {\r\n\u001b[?2004l\r"]
[6956.235721, "o", "\u001b[?2004h> "]
[6956.235873, "o", "\\t\\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.235884, "o", "\\t}\r\n\u001b[?2004l\r"]
[6956.235947, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.236091, "o", "\\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n\u001b[?2004l\r"]
[6956.236102, "o", "\u001b[?2004h> "]
[6956.236172, "o", "\\treturn &WarmupResult{\r\n\u001b[?2004l\r"]
[6956.236184, "o", "\u001b[?2004h> "]
[6956.236277, "o", "\\t\\tStatus:     \"warmed_up\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.236328, "o", "> "]
[6956.23638, "o", "\\t\\tModelName:  modelName,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.236456, "o", "\\t\\tVersionNum: loaded.VersionNum,\r\n\u001b[?2004l\r"]
[6956.236466, "o", "\u001b[?2004h> "]
[6956.23654, "o", "\\t\\tLatencyMs:  latency,\r\n\u001b[?2004l\run\u001b[?2004h"]
[6956.23659, "o", "> \\t}, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.236602, "o", "}\r\n"]
[6956.236663, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.236834, "o", "// RecordRequest updates serving statistics for a single inference request.'''\r\n\u001b[?2004l\r"]
[6956.236844, "o", "\u001b[?2004h> "]
[6956.237118, "o", "text = text.replace(\"// RecordRequest updates serving statistics for a single inference request.\", methods, 1)\r\n\u001b[?2004l\r"]
[6956.237128, "o", "\u001b[?2004h> "]
[6956.237187, "o", "p.write_text(text)\r\n\u001b[?2004l\r"]
[6956.237197, "o", "\u001b[?2004h> "]
[6956.237258, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.237268, "o", "# --- handlers ---\r\n\u001b[?2004l\r"]
[6956.291759, "o", "\u001b[?2004h> p = Path(\"internal/api/handlers.go\")\r\n\u001b[?2004l\r\u001b[?2004h> text = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> del_pattern = r'''if err := h\\.Experiment\\.DeleteRun\\(expName, runID\\); err != nil \\{\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\twriteError\\(w, http\\.StatusNotFound, \"%v\", err\\)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6956.292228, "o", "\\twriteJSON\\(w, http\\.StatusOK, map\\[string\\]string\\{\"status\": \"deleted\"\\}\\)'''\r\n\u001b[?2004l\r"]
[6956.292319, "o", "\u001b[?2004h"]
[6956.292375, "o", "> "]
[6956.292703, "o", "del_replacement = '''run, err := h.Experiment.DeleteRun(expName, runID)\r\n\u001b[?2004l\r"]
[6956.292764, "o", "\u001b[?2004h> "]
[6956.292887, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[6956.292948, "o", "\u001b[?2004h> "]
[6956.293176, "o", "\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[6956.293232, "o", "\u001b[?2004h> "]
[6956.293295, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[6956.293352, "o", "\u001b[?2004h> "]
[6956.29341, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.293466, "o", "> "]
[6956.29362, "o", "\\twriteJSON(w, http.StatusOK, run)'''\r\n\u001b[?2004l\r"]
[6956.293676, "o", "\u001b[?2004h> "]
[6956.294002, "o", "text, n = re.subn(del_pattern, del_replacement, text, count=1)\r\n\u001b[?2004l\r"]
[6956.294059, "o", "\u001b[?2004h> "]
[6956.294117, "o", "if n != 1:\r\n\u001b[?2004l\r"]
[6956.294174, "o", "\u001b[?2004h> "]
[6956.294471, "o", "    raise SystemExit(\"DeleteRun handler not replaced\")\r\n\u001b[?2004l\r"]
[6956.294521, "o", "\u001b[?2004h> "]
[6956.29515, "o", "new_handlers = '''func (h *Handlers) ExperimentLeaderboard(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[6956.295213, "o", "\u001b[?2004h> "]
[6956.29542, "o", "\\texpName := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[6956.295474, "o", "\u001b[?2004h> "]
[6956.29573, "o", "\\tmetric := r.URL.Query().Get(\"metric\")\r\n\u001b[?2004l\r"]
[6956.295791, "o", "\u001b[?2004h> "]
[6956.295925, "o", "\\tif metric == \"\" {\r\n\u001b[?2004l\r"]
[6956.295987, "o", "\u001b[?2004h> "]
[6956.29646, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"metric query parameter is required\")\r\n\u001b[?2004l\r"]
[6956.296511, "o", "\u001b[?2004h> "]
[6956.296596, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[6956.296656, "o", "\u001b[?2004h> "]
[6956.296712, "o", "\\t}\r\n\u001b[?2004l\r"]
[6956.296768, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.296824, "o", "\u001b[?2004h> "]
[6956.297056, "o", "\\torder := r.URL.Query().Get(\"order\")\r\n\u001b[?2004l\r"]
[6956.297117, "o", "\u001b[?2004h> "]
[6956.29724, "o", "\\tif order == \"\" {\r\n\u001b[?2004l\r"]
[6956.297307, "o", "\u001b[?2004h> "]
[6956.297424, "o", "\\t\\torder = \"desc\"\r\n\u001b[?2004l\r"]
[6956.297485, "o", "\u001b[?2004h> "]
[6956.297542, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.297599, "o", "> "]
[6956.297806, "o", "\\tif order != \"asc\" && order != \"desc\" {\r\n\u001b[?2004l\r"]
[6956.29788, "o", "\u001b[?2004h> "]
[6956.298332, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"order must be \\\\\"asc\\\\\" or \\\\\"desc\\\\\"\")\r\n\u001b[?2004l\r"]
[6956.298398, "o", "\u001b[?2004h> "]
[6956.298461, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[6956.298512, "o", "\u001b[?2004h> "]
[6956.298571, "o", "\\t}\r\n\u001b[?2004l\r"]
[6956.298627, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.298688, "o", "\u001b[?2004h> "]
[6956.298777, "o", "\\tlimit := 10\r\n\u001b[?2004l\r"]
[6956.298827, "o", "\u001b[?2004h> "]
[6956.299193, "o", "\\tif limitStr := r.URL.Query().Get(\"limit\"); limitStr != \"\" {\r\n\u001b[?2004l\r"]
[6956.299259, "o", "\u001b[?2004h> "]
[6956.299464, "o", "\\t\\tn, err := strconv.Atoi(limitStr)\r\n\u001b[?2004l\r"]
[6956.29951, "o", "\u001b[?2004h> "]
[6956.299645, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[6956.29971, "o", "\u001b[?2004h> "]
[6956.300112, "o", "\\t\\t\\twriteError(w, http.StatusBadRequest, \"limit must be an integer\")\r\n\u001b[?2004l\r"]
[6956.30017, "o", "\u001b[?2004h> "]
[6956.300248, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r"]
[6956.300307, "o", "\u001b[?2004h> "]
[6956.300363, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[6956.300419, "o", "\u001b[?2004h> "]
[6956.300497, "o", "\\t\\tif n < 0 {\r\n\u001b[?2004l\r"]
[6956.300553, "o", "\u001b[?2004h> "]
[6956.30063, "o", "\\t\\t\\tn = 0\r\n\u001b[?2004l\r"]
[6956.300685, "o", "\u001b[?2004h> "]
[6956.300741, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[6956.300797, "o", "\u001b[?2004h> "]
[6956.30088, "o", "\\t\\tlimit = n\r\n\u001b[?2004l\r"]
[6956.300937, "o", "\u001b[?2004h> "]
[6956.300993, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.301049, "o", "> \r\n\u001b[?2004l\r"]
[6956.301104, "o", "\u001b[?2004h> "]
[6956.301496, "o", "\\tresult, err := h.Experiment.Leaderboard(expName, metric, order, limit)\r\n\u001b[?2004l\r"]
[6956.30156, "o", "\u001b[?2004h> "]
[6956.301663, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[6956.301719, "o", "\u001b[?2004h> "]
[6956.302022, "o", "\\t\\tif strings.Contains(err.Error(), \"not found\") {\r\n\u001b[?2004l\r"]
[6956.302082, "o", "\u001b[?2004h> "]
[6956.302375, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[6956.302432, "o", "\u001b[?2004h> "]
[6956.302515, "o", "\\t\\t} else {\r\n\u001b[?2004l\r"]
[6956.302571, "o", "\u001b[?2004h> "]
[6956.302885, "o", "\\t\\t\\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\u001b[?2004l\r"]
[6956.302942, "o", "\u001b[?2004h> "]
[6956.302998, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[6956.303053, "o", "\u001b[?2004h> "]
[6956.30311, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[6956.303165, "o", "\u001b[?2004h> "]
[6956.303221, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.303275, "o", "> \r\n\u001b[?2004l\r"]
[6956.30333, "o", "\u001b[?2004h> "]
[6956.303534, "o", "\\twriteJSON(w, http.StatusOK, result)\r\n\u001b[?2004l\r"]
[6956.303597, "o", "\u001b[?2004h> }\r\n"]
[6956.303655, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[6956.303709, "o", "\u001b[?2004l\r\u001b[?2004h"]
[6956.303765, "o", "> "]
