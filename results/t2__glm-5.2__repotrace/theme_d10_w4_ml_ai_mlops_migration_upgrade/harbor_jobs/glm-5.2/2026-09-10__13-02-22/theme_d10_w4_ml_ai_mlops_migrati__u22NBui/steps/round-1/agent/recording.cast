[409.611414, "o", "\u001b[?2004h> "]
[409.611509, "o", "\\tif exp != nil {\r\n\u001b[?2004l\r"]
[409.611565, "o", "\u001b[?2004h> "]
[409.611728, "o", "\\t\\trunCount = len(exp.Runs)\r\n\u001b[?2004l\r"]
[409.611784, "o", "\u001b[?2004h> \\t}\r\n"]
[409.611844, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[409.612159, "o", "\\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[?2004l\r"]
[409.612215, "o", "\u001b[?2004h> "]
[409.612364, "o", "\\t\\t\"experiment\": expName,\r\n\u001b[?2004l\r"]
