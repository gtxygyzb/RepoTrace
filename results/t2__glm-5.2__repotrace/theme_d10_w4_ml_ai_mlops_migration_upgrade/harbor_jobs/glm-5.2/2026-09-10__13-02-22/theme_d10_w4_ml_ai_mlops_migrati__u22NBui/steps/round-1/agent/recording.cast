[184.983512, "o", "\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Server) Infer\u001b[m\u001b[K(req *InferenceRequest) (*InferenceResponse, error) {\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tstart := time.Now()\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ts.mu.RLock()\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tloaded, exists := s.loaded[req.ModelName]\r\n"]
[184.983608, "o", "\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ts.mu.RUnlock()\r\n\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif !exists {\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", req.ModelName)\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tpredictions, err := computePrediction(loaded.ModelConfig, req.Input)\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn &InferenceResponse{\r\n"]
[184.983684, "o", "\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tModelName:   req.ModelName,\r\n\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tVersion:     string(loaded.Stage),\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tPredictions: predictions,\r\n\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tLatencyMs:   latency,\r\n\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}, nil\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// ListLoaded returns all currently loaded models.\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (s *Server) ListLoaded() []*LoadedModel {\r\n\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ts.mu.RLock()\r\n"]
[184.983761, "o", "\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer s.mu.RUnlock()\r\n\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K124\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tresult := make([]*LoadedModel, 0, len(s.loaded))\r\n\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, lm := range s.loaded {\r\n\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tresult = append(result, lm)\r\n\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn result\r\n\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// computePrediction evaluates a model against input data.\r\n\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// Supported model types: linear, polynomial.\r\n\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc computePrediction(modelConfig map[string]interface{}, input []float64) ([]float64, error) {\r\n\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif modelConfig == nil {\r\n"]
[184.983825, "o", "\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn nil, fmt.Errorf(\"model has no configuration\")\r\n\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmodelType, _ := modelConfig[\"model_type\"].(string)\r\n\u001b[32m\u001b[K139\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tswitch modelType {\r\n\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"linear\":\r\n\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn linearPredict(modelConfig, input)\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase \"polynomial\":\r\n\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn polynomialPredict(modelConfig, input)\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefault:\r\n"]
[184.983897, "o", "\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn nil, fmt.Errorf(\"unsupported model type: %s\", modelType)\r\n\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
