[2050.174295, "o", "sed -n '1,260p' internal/pipeline/engine.go\r\n\u001b[?2004l\r"]
[2050.177328, "o", "package pipeline\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\n"]
[2050.177516, "o", "// StepType identifies the kind of processing a pipeline step performs.\r\ntype StepType string\r\n\r\nconst (\r\n\tStepTransform StepType = \"transform\"\r\n\tStepValidate  StepType = \"validate\"\r\n\tStepAggregate StepType = \"aggregate\"\r\n\tStepExport    StepType = \"export\"\r\n\tStepFilter    StepType = \"filter\"\r\n)"]
[2050.177623, "o", "\r\n\r\n// Step defines a single unit of work in a pipeline.\r\ntype Step struct {\r\n\tName            string                 `json:\"name\"`\r\n\tType            StepType               `json:\"type\"`\r\n\tConfig          map[string]interface{} `json:\"config\"`\r\n\tDependencies    []string               `json:\"dependencies\"`\r\n\tSetVars         map[string]string      `json:\"set_vars,omitempty\"`\r\n\tOutputTransform string                 `json:\"output_transform,omitempty\"`\r\n}\r\n\r\n// Pipeline defines a named sequence of dependent steps.\r\ntype Pipeline struct {\r\n\tName  string  `json:\"name\"`\r\n\tSteps []*Step `json:\"steps\"`\r\n}\r\n\r\n// StepResult records the outcome of executing a single step.\r\ntype StepResult struct {\r\n\tStepName   string                 `json:\"step_name\"`\r\n\tStepType   StepType               `json:\"step_type\"`\r\n"]
[2050.177737, "o", "\tStatus     string                 `json:\"status\"`\r\n\tOutput     map[string]interface{} `json:\"output,omitempty\"`\r\n\tError      string                 `json:\"error,omitempty\"`\r\n\tDurationMs float64                `json:\"duration_ms\"`\r\n}\r\n\r\n// PipelineResult records the outcome of executing an entire pipeline.\r\ntype PipelineResult struct {\r\n\tPipelineName string        `json:\"pipeline_name\"`\r\n\tStatus       string        `json:\"status\"`\r\n\tSteps        []*StepResult `json:\"steps\"`\r\n\tTotalTimeMs  float64       `json:\"total_time_ms\"`\r\n}\r\n\r\n// Engine executes pipelines by resolving step dependencies and running each step.\r\ntype Engine struct {\r\n\tstepExecutors map[StepType]StepExecutor\r\n}\r\n\r\n// StepExecutor is the function signature for executing a pipeline step.\r\n"]
[2050.177811, "o", "type StepExecutor func(config, input map[string]interface{}) (map[string]interface{}, error)\r\n\r\n// NewEngine creates a pipeline engine with built-in step executors.\r\nfunc NewEngine() *Engine {\r\n\te := &Engine{\r\n\t\tstepExecutors: make(map[StepType]StepExecutor),\r\n\t}\r\n\te.stepExecutors[StepTransform] = ExecuteTransform\r\n"]
[2050.177934, "o", "\te.stepExecutors[StepValidate] = ExecuteValidate\r\n\te.stepExecutors[StepAggregate] = ExecuteAggregate\r\n\te.stepExecutors[StepExport] = ExecuteExport\r\n\te.stepExecutors[StepFilter] = ExecuteFilter\r\n\treturn e\r\n}\r\n\r\n// Execute runs a pipeline with the given initial input data.\r\nfunc (e *Engine) Execute(p *Pipeline, initialInput map[string]interface{}) (*PipelineResult, error) {\r\n\tordered, err := topologicalSort(p.Steps)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"dependency resolution failed: %w\", err)\r\n\t}\r\n\r\n\tpipelineStart := time.Now()\r\n\tresult := &PipelineResult{\r\n\t\tPipelineName: p.Name,\r\n\t\tStatus:       \"success\",\r\n\t\tSteps:        make([]*StepResult, 0, len(ordered)),\r\n\t}\r\n\r\n"]
[2050.177996, "o", "\tstepOutputs := make(map[string]map[string]interface{})\r\n\tvariables := make(map[string]float64)\r\n\tvariableSetter := make(map[string]string)\r\n\tallDeps := computeTransitiveDependencies(p.Steps)\r\n\r\n\tfor _, step := range ordered {\r\n\t\tstepStart := time.Now()\r\n\r\n\t\t"]
[2050.178056, "o", "resolvedConfig, err := resolveVariables(step.Config, variables, variableSetter, allDeps[step.Name])\r\n\t\tif err != nil {\r\n\t\t\tsr := &StepResult{\r\n\t\t\t\tStepName:   step.Name,\r\n\t\t\t\tStepType:   step.Type,\r\n\t\t\t\tStatus:     \"failed\",\r\n\t\t\t\tError:      err.Error(),\r\n\t\t\t\t"]
[2050.178113, "o", "DurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\r\n\t\t\t}\r\n\t\t\tresult.Steps = append(result.Steps, sr)\r\n\t\t\tresult.Status = \"failed\"\r\n\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n\t\t\treturn result, nil\r\n\t\t}\r\n\r\n"]
[2050.178169, "o", "\t\t// Determine input for this step\r\n\t\tvar input map[string]interface{}\r\n\t\tif len(step.Dependencies) == 0 {\r\n\t\t\tinput = initialInput\r\n\t\t} else {\r\n\t\t\tinput = mergeDependencyOutputs(step.Dependencies, stepOutputs)\r\n\t\t}\r\n\r\n\t\t// Find and run the executor\r\n\t\texecutor, ok := e.stepExecutors[step.Type]\r\n\t"]
[2050.178238, "o", "\tif !ok {\r\n\t\t\tsr := &StepResult{\r\n\t\t\t\tStepName:   step.Name,\r\n\t\t\t\tStepType:   step.Type,\r\n\t\t\t\tStatus:     \"failed\",\r\n\t\t\t\tError:      fmt.Sprintf(\"unknown step type: %s\", step.Type),\r\n\t\t\t\tDurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\r\n\t\t\t"]
[2050.178293, "o", "}\r\n\t\t\tresult.Steps = append(result.Steps, sr)\r\n\t\t\tresult.Status = \"failed\"\r\n\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n\t\t\treturn result, nil\r\n\t\t}\r\n\r\n\t\toutput, err := executor(resolvedConfig, input)"]
[2050.178351, "o", "\r\n\t\tduration := float64(time.Since(stepStart).Microseconds()) / 1000.0\r\n\r\n\t\tsr := &StepResult{\r\n\t\t\tStepName:   step.Name,\r\n\t\t\tStepType:   step.Type,\r\n\t\t\tDurationMs: duration,\r\n\t\t}\r\n\r\n\t\tif err != nil {\r\n\t\t\tsr.Status = \"failed\"\r\n\t"]
[2050.178408, "o", "\t\tsr.Error = err.Error()\r\n\t\t\tresult.Steps = append(result.Steps, sr)\r\n\t\t\tresult.Status = \"failed\"\r\n\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n\t\t\treturn result, nil\r\n\t\t}\r\n\r\n"]
[2050.178466, "o", "\t\tif step.OutputTransform != \"\" && (step.Type == StepTransform || step.Type == StepFilter) {\r\n\t\t\ttransformed, terr := applyOutputTransform(output, resolvedConfig, step.OutputTransform)\r\n\t\t\tif terr != nil {\r\n\t\t\t\tsr.Status = \"failed\"\r\n\t\t\t\tsr.Error = terr.Error()\r\n\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n\t\t\t\tresult.Status = \"failed\"\r\n\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n"]
[2050.178523, "o", "\t\t\t\treturn result, nil\r\n\t\t\t}\r\n\t\t\toutput = transformed\r\n\t\t}\r\n\r\n\t\tif len(step.SetVars) > 0 {\r\n\t\t\tif verr := setVariables(output, step.SetVars, variables, variableSetter, step.Name); verr != nil {\r\n\t\t\t\tsr.Status = \"failed\"\r\n"]
[2050.178585, "o", "\t\t\t\tsr.Error = verr.Error()\r\n\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n\t\t\t\tresult.Status = \"failed\"\r\n\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n\t\t\t\treturn result, nil\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tsr.Status = \"success\"\r\n\t\tsr.Output = output\r\n\t\tresult.Steps = append(result.Steps, sr)\r\n"]
[2050.178641, "o", "\r\n\t\tstepOutputs[step.Name] = output\r\n\t}\r\n\r\n\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n\treturn result, nil\r\n}\r\n\r\n// topologicalSort orders steps so that dependencies are executed first.\r\n// Returns an error if a cycle is detected.\r\n"]
[2050.178698, "o", "func topologicalSort(steps []*Step) ([]*Step, error) {\r\n\tstepMap := make(map[string]*Step)\r\n\tinDegree := make(map[string]int)\r\n\r\n\tfor _, s := range steps {\r\n\t\tstepMap[s.Name] = s\r\n\t\tinDegree[s.Name] = 0\r\n\t}\r\n\r\n\t// Build in-degree counts\r\n"]
[2050.178754, "o", "\tfor _, s := range steps {\r\n\t\tfor _, dep := range s.Dependencies {\r\n\t\t\tif _, ok := stepMap[dep]; !ok {\r\n\t\t\t\treturn nil, fmt.Errorf(\"step %q depends on unknown step %q\", s.Name, dep)\r\n\t\t\t}\r\n\t\t\tinDegree[s.Name]++\r\n\t\t}\r\n"]
[2050.178808, "o", "\t}\r\n\r\n\t// Initialize queue with steps that have no dependencies\r\n\tqueue := make([]*Step, 0)\r\n\tfor _, s := range steps {\r\n\t\tif inDegree[s.Name] == 0 {\r\n\t\t\tqueue = append(queue, s)\r\n\t\t}\r\n\t}\r\n\r\n"]
[2050.178882, "o", "\t// Process steps in topological order\r\n\tordered := make([]*Step, 0, len(steps))\r\n\tfor len(queue) > 0 {\r\n\t\tcurrent := queue[0]\r\n\t\tqueue = queue[1:]\r\n\t\tordered = append(ordered, current)\r\n\r\n\t\t// Find steps that depend on current\r\n\t\tfor _, s := range steps {\r\n\t\t\tfor _, dep := range s.Dependencies {\r\n\t\t\t\tif dep == current.Name {\r\n"]
[2050.178943, "o", "\t\t\t\t\tinDegree[s.Name]--\r\n\t\t\t\t\tif inDegree[s.Name] == 0 {\r\n\t\t\t\t\t\tqueue = append(queue, s)\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[2050.179002, "o", "\tif len(ordered) != len(steps) {\r\n\t\treturn nil, fmt.Errorf(\"cycle detected in pipeline dependencies\")\r\n\t}\r\n\r\n\treturn ordered, nil\r\n}\r\n\r\n// mergeDependencyOutputs concatenates the \"data\" arrays from all dependency outputs into a single input.\r\nfunc mergeDependencyOutputs(deps []string, outputs map[string]map[string]interface{}) map[string]interface{} {\r\n\tmerged := make([]interface{}, 0)\r\n\tfor _, dep := range deps {\r\n"]
[2050.179062, "o", "\t\tout, ok := outputs[dep]\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tswitch data := out[\"data\"].(type) {\r\n\t\tcase []interface{}:\r\n\t\t\tmerged = append(merged, data...)\r\n\t\tcase []float64:\r\n\t\t\tfor _, v := range data {\r\n\t"]
[2050.179117, "o", "\t\t\tmerged = append(merged, v)\r\n\t\t\t}\r\n"]
[2050.179641, "o", "\u001b[?2004h"]
