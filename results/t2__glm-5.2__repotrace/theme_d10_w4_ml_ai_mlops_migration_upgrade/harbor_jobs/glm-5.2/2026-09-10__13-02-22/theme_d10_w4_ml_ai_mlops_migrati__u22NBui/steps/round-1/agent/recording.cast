[5636.157476, "o", "    69\t\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs/bulk-tag\", h.BulkTagRuns)\r\n    70\t\tmux.HandleFunc(\"DELETE /api/v1/experiments/{name}/runs/{id}\", h.DeleteRun)\r\n    71\t\tmux.HandleFunc(\"GET /api/v1/experiments/compare\", h.CompareExperiments)\r\n    72\t\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/aggregate\", h.AggregateMetric)\r\n    73\t\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/history\", h.GetMetricHistory)\r\n    74\t\tmux.HandleFunc(\"PUT /api/v1/experiments/{name}/runs/{id}\", h.UpdateRun)\r\n    75\t\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs/search\", h.SearchRuns)\r\n    76\t\r\n    77\t\t// Serving endpoints\r\n    78\t\tmux.HandleFunc(\"POST /api/v1/serving/load\", h.LoadModel)\r\n    79"]
[5636.157562, "o", "\t\tmux.HandleFunc(\"DELETE /api/v1/serving/models/{name}\", h.UnloadModel)\r\n    80\t\tmux.HandleFunc(\"GET /api/v1/serving/models\", h.ListLoadedModels)\r\n    81\t\tmux.HandleFunc(\"POST /api/v1/serving/infer\", h.Infer)\r\n    82\t\tmux.HandleFunc(\"POST /api/v1/serving/batch\", h.BatchInfer)\r\n    83\t\tmux.HandleFunc(\"GET /api/v1/serving/stats\", h.ServingStats)\r\n    84\t\tmux.HandleFunc(\"POST /api/v1/serving/stats/reset\", h.ResetServingStats)\r\n    85\t\r\n    86\t\t// Health check\r\n    87\t\tmux.HandleFunc(\"GET /health\", func(w http.ResponseWriter, r *http.Request) {\r\n    88\t\t\tw.WriteHeader(http.StatusOK)\r\n    89\t\t\tw.Write([]byte(`{\"status\":\"ok\"}`))\r\n    90\t\t})\r\n    91\t\r\n    92"]
