[2520.511843, "o", "\u001b[?2004h> "]
[2520.511922, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[2520.511981, "o", "\u001b[?2004h> \\t}\r\n"]
[2520.512035, "o", "\u001b[?2004l\r\u001b[?2004h"]
[2520.512089, "o", "> "]
[2520.512249, "o", "\\tstageSummary := map[string]int{\r\n\u001b[?2004l\r"]
[2520.512311, "o", "\u001b[?2004h> "]
[2520.512436, "o", "\\t\\t\"development\": 0,\r\n\u001b[?2004l\r"]
[2520.51249, "o", "\u001b[?2004h> "]
[2520.512618, "o", "\\t\\t\"staging\":     0,\r\n\u001b[?2004l\r"]
[2520.512662, "o", "\u001b[?2004h> "]
[2520.512805, "o", "\\t\\t\"production\":  0,\r\n\u001b[?2004l\r"]
[2520.512882, "o", "\u001b[?2004h> "]
[2520.512999, "o", "\\t\\t\"archived\":    0,\r\n\u001b[?2004l\r"]
[2520.513054, "o", "\u001b[?2004h> "]
[2520.513109, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2520.513163, "o", "> "]
[2520.513345, "o", "\\tfor _, v := range model.Versions {\r\n\u001b[?2004l\r"]
[2520.5134, "o", "\u001b[?2004h> "]
[2520.513605, "o", "\\t\\tstageSummary[string(v.Stage)]++\r\n\u001b[?2004l\r"]
[2520.513659, "o", "\u001b[?2004h> "]
[2520.51372, "o", "\\t}\r\n\u001b[?2004l\r"]
[2520.513775, "o", "\u001b[?2004h> "]
[2520.514058, "o", "\\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[?2004l\r"]
[2520.514114, "o", "\u001b[?2004h> "]
[2520.514301, "o", "\\t\\t\"name\":          model.Name,\r\n\u001b[?2004l\r"]
[2520.514355, "o", "\u001b[?2004h> "]
[2520.514572, "o", "\\t\\t\"framework\":     model.Framework,\r\n\u001b[?2004l\r"]
[2520.514635, "o", "\u001b[?2004h> "]
[2520.51487, "o", "\\t\\t\"description\":   model.Description,\r\n\u001b[?2004l\r"]
[2520.514926, "o", "\u001b[?2004h> "]
[2520.515109, "o", "\\t\\t\"tags\":          model.Tags,\r\n\u001b[?2004l\r"]
[2520.515172, "o", "\u001b[?2004h> "]
[2520.515378, "o", "\\t\\t\"versions\":      model.Versions,\r\n\u001b[?2004l\r"]
[2520.51544, "o", "\u001b[?2004h> "]
[2520.515652, "o", "\\t\\t\"created_at\":    model.CreatedAt,\r\n\u001b[?2004l\r"]
[2520.515706, "o", "\u001b[?2004h> "]
[2520.515935, "o", "\\t\\t\"updated_at\":    model.UpdatedAt,\r\n\u001b[?2004l\r"]
[2520.51599, "o", "\u001b[?2004h> "]
[2520.516186, "o", "\\t\\t\"stage_summary\": stageSummary,\r\n\u001b[?2004l\r"]
[2520.516241, "o", "\u001b[?2004h> "]
[2520.516295, "o", "\\t})\r\n\u001b[?2004l\r\u001b[?2004h"]
[2520.51635, "o", "> }'''\r\n\u001b[?2004l\r"]
[2520.516396, "o", "\u001b[?2004h"]
[2520.516454, "o", "> "]
[2520.516566, "o", "if old_getmodel not in s:\r\n\u001b[?2004l\r"]
[2520.516629, "o", "\u001b[?2004h> "]
[2520.516909, "o", "    raise SystemExit('GetModel block not found')\r\n\u001b[?2004l\r"]
[2520.516965, "o", "\u001b[?2004h> "]
[2520.517201, "o", "s = s.replace(old_getmodel, new_getmodel)\r\n\u001b[?2004l\r"]
[2520.517256, "o", "\u001b[?2004h> "]
[2520.517567, "o", "marker = '// --- Model Version Comparison Handler ---'\r\n\u001b[?2004l\r"]
[2520.517622, "o", "\u001b[?2004h> "]
[2520.51774, "o", "if marker not in s:\r\n\u001b[?2004l\r"]
[2520.517794, "o", "\u001b[?2004h> "]
