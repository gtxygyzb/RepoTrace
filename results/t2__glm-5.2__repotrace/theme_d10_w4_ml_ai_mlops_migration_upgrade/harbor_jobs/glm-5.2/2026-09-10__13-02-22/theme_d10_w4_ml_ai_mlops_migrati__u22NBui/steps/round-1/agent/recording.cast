[2960.446717, "o", "\r\n     8\t\t\"gomlops/internal/serving\"\r\n     9\t)\r\n    10\t\r\n    11\ttype batchRequest struct {\r\n"]
[2960.44679, "o", "    12\t\tRequests []serving.InferenceRequest `json:\"requests\"`\r\n    13\t\tStrategy string                     `json:\"strategy\"`\r\n    14\t}\r\n    15\t\r\n    16\tfunc (h *Handlers) BatchInfer(w http.ResponseWriter, r *http.Request) {\r\n    17\t\tvar req batchRequest\r\n    18\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n    19\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n    20\t\t\treturn\r\n    21\t\t}\r\n    22\t\tif len(req.Requests) == 0 {\r\n    23\t\t\twriteError(w, http.StatusBadRequest, \"requests array is required and cannot be empty\")\r\n    24\t\t\treturn\r\n    25\t\t}\r\n    26\t\tstrategy := req.Strategy\r\n    27\t\tif strategy == \"\" {\r\n    28\t\t\tstrategy = \"independent\"\r\n    29\t\t}\r\n    30\t\tif strategy != \"independent\" && strategy != \"stop_on_error\" {\r\n    31\t\t\twriteError(w, http.StatusBadRequest, \"invalid strategy %q\", strategy)\r\n    32\t\t\treturn\r\n    33\t\t}\r\n    34\t\r\n    35\t\tstart := time.Now()\r\n    36\t"]
[2960.44689, "o", "\tresults := make([]map[string]interface{}, 0, len(req.Requests))\r\n    37\t\tsucceeded := 0\r\n    38\t\tfailed := 0\r\n    39\t\tskipped := 0\r\n    40\t\tstop := false\r\n    41\t\r\n    42\t\tfor i, ir := range req.Requests {\r\n    43\t\t\tif stop {\r\n    44\t\t\t\tresults = append(results, map[string]interface{}{\r\n    45\t\t\t\t\t\"model_name\": ir.ModelName,\r\n    46\t\t\t\t\t\"status\":     \"skipped\",\r\n"]
[2960.446957, "o", "    47\t\t\t\t})\r\n    48\t\t\t\tskipped++\r\n    49\t\t\t\tcontinue\r\n    50\t\t\t}\r\n    51\t\r\n    52\t\t\tif ir.ModelName == \"\" {\r\n    53\t\t\t\tresults = append(results, map[string]interface{}{\r\n    54\t\t\t\t\t\"model_name\": ir.ModelName,\r\n    55\t\t\t\t\t\"error\":      \"model_name is required\",\r\n    56\t\t\t\t})"]
[2960.447017, "o", "\r\n    57\t\t\t\tfailed++\r\n    58\t\t\t\tif strategy == \"stop_on_error\" {\r\n    59\t\t\t\t\tstop = true\r\n    60\t\t\t\t}\r\n    61\t\t\t\tcontinue\r\n    62\t\t\t}\r\n    63\t\r\n    64\t\t\tresp, err := h.Serving.Infer(&ir)\r\n"]
[2960.447075, "o", "    65\t\t\tif err != nil {\r\n    66\t\t\t\tresults = append(results, map[string]interface{}{\r\n    67\t\t\t\t\t\"model_name\": ir.ModelName,\r\n    68\t\t\t\t\t\"error\":      err.Error(),\r\n    69\t\t\t\t})\r\n    70\t\t\t\tfailed++\r\n    71\t\t\t\tif strategy == \"stop_on_error\" {\r\n    72\t\t\t\t\tstop = true\r\n"]
[2960.447133, "o", "    73\t\t\t\t}\r\n    74\t\t\t\tcontinue\r\n    75\t\t\t}\r\n    76\t\r\n    77\t\t\tresults = append(results, map[string]interface{}{\r\n    78\t\t\t\t\"model_name\":  resp.ModelName,\r\n    79\t\t\t\t\"version\":     resp.Version,\r\n    80\t\t\t\t\"predictions\": resp.Predictions,\r\n    81\t\t\t\t\"latency_ms\":  resp.LatencyMs,\r\n"]
[2960.44719, "o", "    82\t\t\t})\r\n    83\t\t\tsucceeded++\r\n    84\t\t\t_ = i\r\n    85\t\t}\r\n    86\t\r\n    87\t\tsummary := map[string]int{\r\n    88\t\t\t\"total\":     len(req.Requests),\r\n    89\t\t\t\"succeeded\": succeeded,\r\n"]
[2960.447246, "o", "    90\t\t\t\"failed\":    failed,\r\n    91\t\t}\r\n    92\t\tif strategy == \"stop_on_error\" {\r\n    93\t\t\tsummary[\"skipped\"] = skipped\r\n    94\t\t}\r\n    95\t\r\n    96\t\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n    97\t\t\t\"results\":          results,\r\n"]
