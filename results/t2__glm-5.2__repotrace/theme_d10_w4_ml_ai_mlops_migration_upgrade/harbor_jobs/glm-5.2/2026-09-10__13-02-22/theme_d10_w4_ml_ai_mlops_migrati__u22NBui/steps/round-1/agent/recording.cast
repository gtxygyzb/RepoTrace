[5636.513876, "o", "   973\t}\r\n   974\t\r\n   975\tfunc (h *Handlers) GetDependencies(w http.ResponseWriter, r *http.Request) {\r\n   976\t\tmodelName := r.PathValue(\"name\")\r\n   977\t\tdirect, transitive, err := h.Registry.GetDependencies(modelName)\r\n   978\t\tif err != nil {\r\n   979\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   980\t\t\treturn\r\n   981\t\t}\r\n   982\t\tif direct == nil {\r\n   983"]
[5636.513947, "o", "\t\t\tdirect = []string{}\r\n   984\t\t}\r\n   985\t\tif transitive == nil {\r\n   986\t\t\ttransitive = []string{}\r\n   987\t\t}\r\n   988\t\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n   989\t\t\t\"model\":      modelName,\r\n   990\t\t\t\"direct\":     direct,\r\n   991\t\t\t\"transitive\": transitive,\r\n   992\t\t})\r\n   993\t}\r\n   994\t\r\n   995\tfunc (h *Handlers) RemoveDependency(w http.ResponseWriter, r *http.Request) {"]
[5636.514021, "o", "\r\n   996\t\tmodelName := r.PathValue(\"name\")\r\n   997\t\tdep := r.PathValue(\"dep\")\r\n   998\t\tif err := h.Registry.RemoveDependency(modelName, dep); err != nil {\r\n   999\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n  1000\t\t\treturn\r\n  1001\t\t}\r\n  1002\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n  1003\t}\r\n  1004\t\r\n  1005\t// --- Helpers ---\r\n"]
[5636.514089, "o", "  1006\t\r\n  1007\tfunc writeJSON(w http.ResponseWriter, status int, data interface{}) {\r\n  1008\t\tw.Header().Set(\"Content-Type\", \"application/json\")\r\n  1009\t\tw.WriteHeader(status)\r\n  1010\t\tjson.NewEncoder(w).Encode(data)\r\n"]
