[244.166355, "o", "\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, error) {\r\n\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[Kpercentile(sorted []float64, p float64) float64 {\r\n\u001b[32m\u001b[K211\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KsortedCopy(values []float64) []float64 {\r\n\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(t *Tracker) loadAll() {\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(t *Tracker) saveExperiment(exp *Experiment) error {\r\n"]
