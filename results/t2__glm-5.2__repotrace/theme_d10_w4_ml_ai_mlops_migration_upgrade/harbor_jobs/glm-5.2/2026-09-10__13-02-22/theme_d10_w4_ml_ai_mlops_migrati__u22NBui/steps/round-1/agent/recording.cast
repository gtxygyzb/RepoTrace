[5634.974549, "o", "\tt.mu.RLock()\r\n   115\t\tdefer t.mu.RUnlock()\r\n   116\t\r\n   117\t\tresult := make([]*Experiment, 0, len(t.experiments))\r\n   118\t\tfor _, exp := range t.experiments {\r\n   119\t\t\tresult = append(result, exp)\r\n   120\t\t}\r\n   121\t\tsort.Slice(result, func(i, j int) bool {\r\n   122\t\t\treturn result[i].Name < result[j].Name\r\n   123\t\t})\r\n   124\t\treturn result\r\n   125\t}\r\n   126\t\r\n   127\t// AggregateMetric computes an aggregate statistic for a given metric across all runs\r\n   128\t// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.\r\n   129\t// For weighted_mean, weightParam specifies which parameter to use as weight.\r\n   130\tfunc (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string, tagFilters map[string]string) (float64, int, []string, error) {\r\n   131\t\tt.mu.RLock()\r\n   132\t\tdefer t.mu.RUnlock()\r\n   133\t\r\n"]
[5634.974655, "o", "   134\t\texp, exists := t.experiments[experimentName]\r\n   135\t\tif !exists {\r\n   136\t\t\treturn 0, 0, nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   137\t\t}\r\n   138\t\r\n   139\t\tif len(exp.Runs) == 0 {\r\n   140\t\t\treturn 0, 0, nil, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n   141\t\t}\r\n   142\t\r\n   143\t\tvar values []float64\r\n   144\t\tvar weights []float64\r\n   145\t\tvar runIDs []string\r\n   146\t\tfor _, run := range exp.Runs {\r\n"]
[5634.974732, "o", "   147\t\t\tif !matchTags(run.Tags, tagFilters) {\r\n   148\t\t\t\tcontinue\r\n   149\t\t\t}\r\n   150\t\t\tvalue, ok := run.Metrics[metricName]\r\n   151\t\t\tif !ok {\r\n   152\t\t\t\tcontinue\r\n   153\t\t\t}\r\n   154\t\t\tif aggType == \"weighted_mean\" {\r\n   155\t\t\t\tweight, ok := run.Metrics[weightParam]\r\n"]
[5634.974828, "o", "   156\t\t\t\tif !ok {\r\n   157\t\t\t\t\tcontinue\r\n   158\t\t\t\t}\r\n   159\t\t\t\tvalues = append(values, value)\r\n   160\t\t\t\tweights = append(weights, weight)\r\n   161\t\t\t\trunIDs = append(runIDs, run.ID)\r\n   162\t\t\t} else {\r\n   163\t\t\t\tvalues = append(values, value)\r\n"]
[5634.97494, "o", "   164\t\t\t\trunIDs = append(runIDs, run.ID)\r\n   165\t\t\t}\r\n   166\t\t}\r\n   167\t\r\n   168\t\tif len(values) == 0 {\r\n   169\t\t\tif len(tagFilters) > 0 {\r\n   170\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"no runs match tag filters for metric %q\", metricName)\r\n   171\t\t\t}\r\n   172\t\t\treturn 0, 0, nil, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n   173\t\t}\r\n   174\t\r\n   175\t\tswitch aggType {\r\n   176\t\tcase \"mean\":\r\n   177\t\t\tsum := 0.0\r\n   178\t\t\tfor _, v := range values {\r\n   179\t\t\t\tsum += v\r\n   180\t\t\t}\r\n   181\t\t\treturn sum / float64(len(values)), len(values), runIDs, nil\r\n   182\t\r\n   183\t\tcase \"median\":\r\n   184\t\t\tsorted := sortedCopy(values)\r\n"]
[5634.975019, "o", "   185\t\t\tn := len(sorted)\r\n   186\t\t\tif n%2 == 0 {\r\n   187\t\t\t\treturn (sorted[n/2-1] + sorted[n/2]) / 2, len(values), runIDs, nil\r\n   188\t\t\t}\r\n   189\t\t\treturn sorted[n/2], len(values), runIDs, nil\r\n"]
[5634.975097, "o", "   190\t\r\n   191\t\tcase \"p95\":\r\n   192\t\t\tsorted := sortedCopy(values)\r\n   193\t\t\treturn percentile(sorted, 0.95), len(values), runIDs, nil\r\n   194\t\r\n   195\t\tcase \"p99\":\r\n   196\t\t\tsorted := sortedCopy(values)\r\n   197\t\t\treturn percentile(sorted, 0.99), len(values), runIDs, nil\r\n   198\t\r\n   199\t\tcase \"weighted_mean\":\r\n   200\t\t\tif weightParam == \"\" {\r\n   201\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\n   202\t\t\t}\r\n   203\t\t\tif len(weights) == 0 {\r\n   204\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"no runs with metric %q and weight metric %q\", metricName, weightParam)\r\n   205\t\t\t}\r\n   206\t\t\tif len(weights) != len(values) {\r\n   207\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"mismatch between metric values and weights\")\r\n"]
[5634.975186, "o", "   208\t\t\t}\r\n   209\t\t\tweightedSum := 0.0\r\n   210\t\t\tweightSum := 0.0\r\n   211\t\t\tfor i, v := range values {\r\n   212\t\t\t\tweightedSum += v * weights[i]\r\n   213\t\t\t\tweightSum += weights[i]\r\n   214\t\t\t}\r\n   215\t\t\tif weightSum == 0 {\r\n   216\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"weighted_mean has zero total weight\")\r\n   217\t\t\t}\r\n"]
[5634.97526, "o", "   218\t\t\treturn weightedSum / weightSum, len(values), runIDs, nil\r\n   219\t\r\n   220\t\tdefault:\r\n   221\t\t\treturn 0, 0, nil, fmt.Errorf(\"unknown aggregation type %q\", aggType)\r\n   222\t\t}\r\n   223\t}\r\n   224\t\r\n   225\t// MetricHistory returns chronological values of a metric across all runs in an experiment.\r\n   226\tfunc (t *Tracker) MetricHistory(experimentName, metricName string) ([]MetricHistoryEntry, error) {\r\n   227\t\tt.mu.RLock()\r\n   228\t\tdefer t.mu.RUnlock()\r\n   229\t\r\n"]
