[4519.532219, "o", "// ExecuteSleep sleeps for a configured duration and passes input data through.\r\n\u001b[?2004l\r"]
[4519.532278, "o", "\u001b[?2004h> "]
[4519.532776, "o", "func ExecuteSleep(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\u001b[?2004l\r"]
[4519.532842, "o", "\u001b[?2004h> "]
[4519.533047, "o", "\\tval, ok := config[\"duration_ms\"]\r\n\u001b[?2004l\r"]
[4519.533106, "o", "\u001b[?2004h> "]
[4519.533171, "o", "\\tif !ok {\r\n\u001b[?2004l\r"]
[4519.533236, "o", "\u001b[?2004h> "]
[4519.533617, "o", "\\t\\treturn nil, fmt.Errorf(\"sleep: missing 'duration_ms' in config\")\r\n\u001b[?2004l\r"]
[4519.533666, "o", "\u001b[?2004h> "]
[4519.533723, "o", "\\t}\r\n\u001b[?2004l\r"]
[4519.533781, "o", "\u001b[?2004h> "]
[4519.533965, "o", "\\tdurationMs, err := toFloat(val)\r\n\u001b[?2004l\r"]
[4519.53404, "o", "\u001b[?2004h> "]
[4519.53413, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[4519.534194, "o", "\u001b[?2004h> "]
[4519.534568, "o", "\\t\\treturn nil, fmt.Errorf(\"sleep: 'duration_ms' must be a number\")\r\n\u001b[?2004l\r"]
[4519.534624, "o", "\u001b[?2004h> "]
[4519.534681, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.534738, "o", "> "]
[4519.534841, "o", "\\tif durationMs < 0 {\r\n\u001b[?2004l\r"]
[4519.534909, "o", "\u001b[?2004h> "]
[4519.53531, "o", "\\t\\treturn nil, fmt.Errorf(\"sleep: 'duration_ms' must be non-negative\")\r\n\u001b[?2004l\r"]
[4519.535366, "o", "\u001b[?2004h> "]
[4519.535422, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.535482, "o", "> "]
[4519.535785, "o", "\\ttime.Sleep(time.Duration(durationMs) * time.Millisecond)\r\n\u001b[?2004l\r"]
[4519.535849, "o", "\u001b[?2004h> "]
[4519.536203, "o", "\\treturn map[string]interface{}{\"data\": input[\"data\"]}, nil\r\n\u001b[?2004l\r"]
[4519.536262, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4519.536316, "o", "\u001b[?2004h"]
[4519.536372, "o", "> '''\r\n\u001b[?2004l\r"]
