[4036.699494, "o", "   254\t// DeleteModel removes a model from the registry.\r\n   255\tfunc (r *Registry) DeleteModel(name string) error {\r\n   256\t\tr.mu.Lock()\r\n   257\t\tdefer r.mu.Unlock()\r\n   258\t\r\n   259\t\tif _, exists := r.models[name]; !exists {\r\n   260\t\t\treturn fmt.Errorf(\"model %q not found\", name)\r\n   261\t\t}\r\n   262\t\r\n   263\t\tdelete(r.models, name)\r\n   264\t\tfilename := filepath.Join(r.dataDir, name+\".json\")\r\n   265\t\tos.Remove(filename)\r\n   266\t\treturn nil\r\n   267\t}\r\n   268\t\r\n   269\t// GetVersion returns a specific version of a model.\r\n"]
