[1009.348655, "o", "\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(r *Registry) GetVersion(modelName string, versionNum int) (*Version, error) {\r\n\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(r *Registry) GetVersionByStage(modelName string, stage Stage) (*Version, error) {\r\n\u001b[32m\u001b[K294\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(r *Registry) loadAll() error {\r\n\u001b[32m\u001b[K319\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(r *Registry) saveModel(model *Model) error {\r\n"]
