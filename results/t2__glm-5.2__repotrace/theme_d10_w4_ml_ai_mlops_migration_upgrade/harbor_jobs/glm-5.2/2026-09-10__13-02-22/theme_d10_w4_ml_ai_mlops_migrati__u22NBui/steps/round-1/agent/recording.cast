[2009.766882, "o", "\r\n   236\tfunc (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {\r\n   237\t\texpName := r.PathValue(\"name\")\r\n   238\t\tmetricName := r.PathValue(\"metric\")\r\n   239\t\taggType := r.URL.Query().Get(\"type\")\r\n   240\t\tweightParam := r.URL.Query().Get(\"weight_param\")\r\n   241\t\ttagFilters := map[string]string{}\r\n   242\t\tfor _, filter := range r.URL.Query()[\"tag_filter\"] {\r\n   243\t\t\tparts := strings.SplitN(filter, \":\", 2)\r\n"]
[2009.766951, "o", "   244\t\t\tif len(parts) != 2 {\r\n   245\t\t\t\twriteError(w, http.StatusBadRequest, \"invalid tag_filter %q, expected key:value\", filter)\r\n   246\t\t\t\treturn\r\n   247\t\t\t}\r\n   248\t\t\ttagFilters[parts[0]] = parts[1]\r\n   249\t\t}\r\n   250\t\r\n   251\t\tif aggType == \"\" {\r\n   252\t\t\twriteError(w, http.StatusBadRequest, \"query parameter 'type' is required\")\r\n"]
[2009.76701, "o", "   253\t\t\treturn\r\n   254\t\t}\r\n   255\t\r\n   256\t\tresult, count, runIDs, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam, tagFilters)\r\n   257\t\tif err != nil {\r\n   258\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n   259\t\t\treturn\r\n"]
[2009.767065, "o", "   260\t\t}\r\n   261\t\r\n   262\t\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n   263\t\t\t\"experiment\": expName,\r\n   264\t\t\t\"metric\":     metricName,\r\n   265\t\t\t\"type\":       aggType,\r\n   266\t\t\t\"value\":      result,\r\n   267\t"]
[2009.767126, "o", "\t\t\"count\":      count,\r\n   268\t\t\t\"run_ids\":    runIDs,\r\n   269\t\t})\r\n   270\t}\r\n   271\t\r\n   272\t// --- Model Version Comparison Handler ---\r\n   273\t\r\n   274\tfunc (h *Handlers) CompareVersionMetrics(w http.ResponseWriter, r *http.Request) {\r\n   275\t\tmodelName := r.PathValue(\"name\")\r\n   276\t"]
[2009.767183, "o", "\tversionParam := r.URL.Query().Get(\"versions\")\r\n   277\t\tif versionParam == \"\" {\r\n   278\t\t\twriteError(w, http.StatusBadRequest, \"query parameter 'versions' is required\")\r\n   279\t\t\treturn\r\n   280\t\t}\r\n   281\t\r\n   282\t\tparts := strings.Split(versionParam, \",\")\r\n   283\t\tseen := map[int]bool{}\r\n"]
[2009.767244, "o", "   284\t\tversionNums := make([]int, 0, len(parts))\r\n   285\t\tfor _, p := range parts {\r\n   286\t\t\tnum, err := strconv.Atoi(strings.TrimSpace(p))\r\n   287\t\t\tif err != nil {\r\n   288\t\t\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %q\", p)\r\n   289\t\t\t\treturn\r\n   290\t\t\t}\r\n"]
[2009.767299, "o", "   291\t\t\tif seen[num] {\r\n   292\t\t\t\twriteError(w, http.StatusBadRequest, \"duplicate version number: %d\", num)\r\n   293\t\t\t\treturn\r\n   294\t\t\t}\r\n   295\t\t\tseen[num] = true\r\n   296\t\t\tversionNums = append(versionNums, num)\r\n   297\t\t}\r\n   298\t\tif len(versionNums) < 2 {\r\n"]
[2009.767356, "o", "   299\t\t\twriteError(w, http.StatusBadRequest, \"at least 2 versions are required for comparison\")\r\n   300\t\t\treturn\r\n   301\t\t}\r\n   302\t\r\n   303\t\tmodel, err := h.Registry.GetModel(modelName)\r\n   304\t\tif err != nil {\r\n   305\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   306\t\t\treturn\r\n"]
[2009.767421, "o", "   307\t\t}\r\n   308\t\r\n   309\t\tsort.Ints(versionNums)\r\n   310\t\tversionMap := map[int]*registry.Version{}\r\n   311\t\tfor _, v := range model.Versions {\r\n   312\t\t\tversionMap[v.Number] = v\r\n   313\t\t}\r\n   314\t\r\n   315\t\tversions := make([]map[string]interface{}, 0, len(versionNums))\r\n   316\t\tfor _, num := range versionNums {\r\n   317\t\t\t"]
[2009.767483, "o", "v, ok := versionMap[num]\r\n   318\t\t\tif !ok {\r\n   319\t\t\t\twriteError(w, http.StatusBadRequest, \"version %d does not exist for model %q\", num, modelName)\r\n   320\t\t\t\treturn\r\n   321\t\t\t}\r\n   322\t\t\tversions = append(versions, map[string]interface{}{\r\n   323\t\t\t\t\"number\":  v.Number,\r\n   324\t\t\t\t\"stage\":   v.Stage,\r\n   325\t\t\t\t\"metrics\": v.Metrics,\r\n"]
[2009.767548, "o", "   326\t\t\t})\r\n   327\t\t}\r\n   328\t\r\n   329\t\tmetricSummary := map[string]map[string]interface{}{}\r\n   330\t\tmetricValues := map[string][]float64{}\r\n   331\t\tfor _, v := range versions {\r\n   332\t\t\tmetrics, _ := v[\"metrics\"].(map[string]float64)\r\n   333\t\t\tfor name, val := range metrics {\r\n   334\t\t\t\tmetricValues[name] = append(metricValues[name], val)\r\n   335\t\t\t}\r\n   336\t"]
[2009.767603, "o", "\t}\r\n   337\t\r\n   338\t\tfor name, vals := range metricValues {\r\n   339\t\t\tif len(vals) == 0 {\r\n   340\t\t\t\tcontinue\r\n"]
