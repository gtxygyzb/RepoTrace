[6036.34259, "o", "\\t\\t\"model\":       modelName,\r\n\u001b[?2004l\r"]
[6036.342638, "o", "\u001b[?2004h"]
[6036.34269, "o", "> "]
[6036.342778, "o", "\\t\\t\"v1\":           v1,\r\n\u001b[?2004l\r"]
[6036.342827, "o", "\u001b[?2004h"]
[6036.342837, "o", "> "]
[6036.342945, "o", "\\t\\t\"v2\":           v2,\r\n\u001b[?2004l\r"]
[6036.342996, "o", "\u001b[?2004h> "]
[6036.343082, "o", "\\t\\t\"metric_diff\":  metricDiff,\r\n\u001b[?2004l\r"]
[6036.343131, "o", "\u001b[?2004h> "]
[6036.343376, "o", "\\t\\t\"stage_diff\":   map[string]interface{}{\"v1\": ver1.Stage, \"v2\": ver2.Stage},\r\n\u001b[?2004l\r"]
[6036.34343, "o", "\u001b[?2004h"]
[6036.34348, "o", "> "]
[6036.343636, "o", "\\t\\t\"tags_diff\":    map[string]interface{}{\"v1\": v1Tags, \"v2\": v2Tags},\r\n\u001b[?2004l\r"]
[6036.343688, "o", "\u001b[?2004h> \\t})\r\n\u001b[?2004l\r"]
[6036.343742, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[6036.34376, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6036.343831, "o", "\u001b[?2004h> "]
[6036.343924, "o", "// --- Serving Health Handler ---\r\n\u001b[?2004l\r"]
[6036.343973, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.344022, "o", "> "]
[6036.344237, "o", "func (h *Handlers) ServingHealth(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[6036.34429, "o", "\u001b[?2004h> "]
[6036.344379, "o", "\\tmodelName := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[6036.344433, "o", "\u001b[?2004h> "]
[6036.344573, "o", "\\tresult, err := h.Serving.HealthCheck(modelName)\r\n\u001b[?2004l\r"]
[6036.344625, "o", "\u001b[?2004h> "]
[6036.344672, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[6036.344683, "o", "\u001b[?2004h"]
[6036.344742, "o", "> "]
[6036.344863, "o", "\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[6036.344912, "o", "\u001b[?2004h> "]
[6036.34496, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.34497, "o", "> "]
[6036.345031, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6036.345151, "o", "\\twriteJSON(w, http.StatusOK, result)\r\n\u001b[?2004l\r"]
[6036.345203, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[6036.345255, "o", "\u001b[?2004h"]
[6036.345305, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6036.345404, "o", "// --- Experiment Correlation Handler ---\r\n\u001b[?2004l\r"]
[6036.345456, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6036.34547, "o", "\u001b[?2004h"]
[6036.34553, "o", "> "]
[6036.34574, "o", "func (h *Handlers) ExperimentCorrelation(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[6036.345788, "o", "\u001b[?2004h> "]
[6036.345892, "o", "\\texpName := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[6036.345941, "o", "\u001b[?2004h> "]
[6036.346077, "o", "\\tmetricsParam := r.URL.Query().Get(\"metrics\")\r\n\u001b[?2004l\r"]
[6036.346131, "o", "\u001b[?2004h> "]
[6036.346194, "o", "\\tif metricsParam == \"\" {\r\n\u001b[?2004l\r"]
[6036.346248, "o", "\u001b[?2004h> "]
[6036.346463, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"metrics parameter is required\")\r\n\u001b[?2004l\r"]
[6036.346515, "o", "\u001b[?2004h> "]
[6036.346531, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[6036.346598, "o", "\u001b[?2004h> "]
[6036.34661, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.346669, "o", "> "]
[6036.346764, "o", "\\tparts := strings.Split(metricsParam, \",\")\r\n\u001b[?2004l\r"]
[6036.346813, "o", "\u001b[?2004h> "]
[6036.346882, "o", "\\tif len(parts) != 2 {\r\n\u001b[?2004l\r"]
[6036.346932, "o", "\u001b[?2004h> "]
[6036.347211, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"metrics must contain exactly two metric names\")\r\n\u001b[?2004l\r"]
[6036.347265, "o", "\u001b[?2004h> "]
[6036.347318, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.347332, "o", "> "]
[6036.347399, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6036.347575, "o", "\\tmetricX := strings.TrimSpace(parts[0])\r\n\u001b[?2004l\r"]
[6036.347622, "o", "\u001b[?2004h> "]
[6036.347769, "o", "\\tmetricY := strings.TrimSpace(parts[1])\r\n\u001b[?2004l\r"]
[6036.347814, "o", "\u001b[?2004h> "]
[6036.347988, "o", "\\tif metricX == \"\" || metricY == \"\" {\r\n\u001b[?2004l\r"]
[6036.348045, "o", "\u001b[?2004h> "]
[6036.348349, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"metrics must contain exactly two metric names\")\r\n\u001b[?2004l\r"]
[6036.348403, "o", "\u001b[?2004h> "]
[6036.348454, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.348466, "o", "> "]
[6036.348524, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.348535, "o", "> \r\n"]
[6036.348593, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[6036.348859, "o", "\\tresult, err := h.Experiment.Correlation(expName, metricX, metricY)\r\n"]
[6036.34887, "o", "\u001b[?2004l\r"]
[6036.348935, "o", "\u001b[?2004h> "]
[6036.348982, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[6036.349036, "o", "\u001b[?2004h> "]
[6036.349223, "o", "\\t\\tif strings.Contains(err.Error(), \"not found\") {\r\n\u001b[?2004l\r"]
[6036.349272, "o", "\u001b[?2004h> "]
[6036.349454, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[6036.349489, "o", "\u001b[?2004h"]
[6036.349499, "o", "> "]
[6036.349575, "o", "\\t\\t} else {\r\n"]
[6036.349584, "o", "\u001b[?2004l\r"]
[6036.34964, "o", "\u001b[?2004h> "]
[6036.349812, "o", "\\t\\t\\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\u001b[?2004l\r"]
[6036.349864, "o", "\u001b[?2004h> "]
[6036.349917, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[6036.349967, "o", "\u001b[?2004h> "]
[6036.350015, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6036.350064, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6036.350188, "o", "\\twriteJSON(w, http.StatusOK, result)\r\n\u001b[?2004l\r"]
[6036.350236, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[6036.350254, "o", "\u001b[?2004h> \r\n"]
[6036.350261, "o", "\u001b[?2004l\r"]
[6036.350289, "o", "\u001b[?2004h"]
[6036.350299, "o", "> "]
[6036.350419, "o", "// --- Pipeline History Handlers ---\r\n\u001b[?2004l\r"]
[6036.350439, "o", "\u001b[?2004h"]
[6036.350454, "o", "> \r\n\u001b[?2004l\r"]
[6036.350478, "o", "\u001b[?2004h"]
[6036.350493, "o", "> "]
[6036.350756, "o", "func (h *Handlers) RecordPipelineHistory(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[6036.350776, "o", "\u001b[?2004h"]
[6036.350795, "o", "> "]
[6036.350861, "o", "\\tvar req struct {\r\n\u001b[?2004l\r"]
[6036.350901, "o", "\u001b[?2004h> "]
[6036.351064, "o", "\\t\\tPipelineName string  `json:\"pipeline_name\"`\r\n\u001b[?2004l\r"]
[6036.351084, "o", "\u001b[?2004h"]
[6036.351102, "o", "> "]
[6036.351236, "o", "\\t\\tStatus      string  `json:\"status\"`\r\n\u001b[?2004l\r"]
[6036.351256, "o", "\u001b[?2004h"]
[6036.351274, "o", "> "]
[6036.351438, "o", "\\t\\tTotalTimeMs float64 `json:\"total_time_ms\"`\r\n\u001b[?2004l\r"]
[6036.351459, "o", "\u001b[?2004h"]
[6036.351477, "o", "> "]
[6036.351623, "o", "\\t\\tStepCount   int     `json:\"step_count\"`\r\n\u001b[?2004l\r"]
[6036.351644, "o", "\u001b[?2004h"]
[6036.351662, "o", "> "]
[6036.351682, "o", "\\t}\r\n\u001b[?2004l\r"]
[6036.351713, "o", "\u001b[?2004h"]
[6036.351731, "o", "> "]
[6036.392373, "o", "\\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6036.392473, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n"]
[6036.392561, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[6036.392646, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[6036.392731, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6036.392816, "o", "\u001b[?2004h> "]
[6036.392966, "o", "\\tif req.PipelineName == \"\" {\r\n\u001b[?2004l\r"]
[6036.393053, "o", "\u001b[?2004h> "]
[6036.393414, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"pipeline_name is required\")\r\n\u001b[?2004l\r"]
[6036.3935, "o", "\u001b[?2004h> "]
[6036.393585, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[6036.393668, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6036.393752, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6036.393834, "o", "\u001b[?2004h> "]
[6036.394419, "o", "\\trecord := h.Pipeline.RecordExecution(req.PipelineName, req.Status, req.TotalTimeMs, req.StepCount)\r\n\u001b[?2004l\r"]
[6036.394509, "o", "\u001b[?2004h> "]
[6036.394748, "o", "\\twriteJSON(w, http.StatusCreated, record)\r\n\u001b[?2004l\r"]
[6036.394835, "o", "\u001b[?2004h> }\r\n"]
[6036.39494, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6036.395025, "o", "\u001b[?2004h> "]
[6036.39544, "o", "func (h *Handlers) ListPipelineHistory(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[6036.39553, "o", "\u001b[?2004h> "]
[6036.395758, "o", "\\tlimitStr := r.URL.Query().Get(\"limit\")\r\n\u001b[?2004l\r"]
[6036.395844, "o", "\u001b[?2004h> "]
[6036.395946, "o", "\\tlimit := 10\r\n\u001b[?2004l\r"]
[6036.396028, "o", "\u001b[?2004h> "]
[6036.396173, "o", "\\tif limitStr != \"\" {\r\n\u001b[?2004l\r"]
[6036.396257, "o", "\u001b[?2004h> "]
[6036.396486, "o", "\\t\\tparsed, err := strconv.Atoi(limitStr)\r\n\u001b[?2004l\r"]
[6036.396544, "o", "\u001b[?2004h> "]
[6036.396757, "o", "\\t\\tif err != nil || parsed < 0 {\r\n\u001b[?2004l\r"]
[6036.39683, "o", "\u001b[?2004h> "]
[6036.397305, "o", "\\t\\t\\twriteError(w, http.StatusBadRequest, \"limit must be a non-negative integer\")\r\n\u001b[?2004l\r"]
[6036.397382, "o", "\u001b[?2004h"]
[6036.397461, "o", "> \\t\\t\\treturn\r\n\u001b[?2004l\r"]
[6036.397543, "o", "\u001b[?2004h> "]
[6036.397626, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.397707, "o", "> "]
[6036.397805, "o", "\\t\\tif parsed > 0 {\r\n\u001b[?2004l\r"]
[6036.397902, "o", "\u001b[?2004h> "]
[6036.398034, "o", "\\t\\t\\tlimit = parsed\r\n\u001b[?2004l\r"]
[6036.398118, "o", "\u001b[?2004h> \\t\\t}\r\n"]
[6036.398201, "o", "\u001b[?2004l\r\u001b[?2004h"]
[6036.398283, "o", "> \\t}\r\n\u001b[?2004l\r"]
[6036.398363, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6036.398445, "o", "\u001b[?2004h> "]
[6036.398757, "o", "\\trecords, total := h.Pipeline.ListExecutionHistory(limit)\r\n\u001b[?2004l\r"]
[6036.39882, "o", "\u001b[?2004h> "]
[6036.398999, "o", "\\tif records == nil {\r\n\u001b[?2004l\r"]
[6036.399071, "o", "\u001b[?2004h> "]
[6036.399359, "o", "\\t\\trecords = []pipeline.PipelineExecutionRecord{}\r\n\u001b[?2004l\r"]
[6036.39943, "o", "\u001b[?2004h> "]
[6036.399513, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6036.399822, "o", "\\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[?2004l\r"]
[6036.399903, "o", "\u001b[?2004h"]
[6036.399985, "o", "> "]
[6036.400068, "o", "\\t\\t\"records\":  records,\r\n\u001b[?2004l\r"]
[6036.400153, "o", "\u001b[?2004h> "]
[6036.400289, "o", "\\t\\t\"total\":   total,\r\n\u001b[?2004l\r"]
[6036.400372, "o", "\u001b[?2004h> "]
[6036.400532, "o", "\\t\\t\"returned\": len(records),\r\n\u001b[?2004l\r"]
[6036.400609, "o", "\u001b[?2004h> "]
[6036.400692, "o", "\\t})\r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.400774, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.400866, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.400954, "o", "> "]
[6036.401137, "o", "// --- Model Version Rollback Handler ---\r\n\u001b[?2004l\r"]
[6036.401204, "o", "\u001b[?2004h> "]
[6036.401291, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6036.401752, "o", "func (h *Handlers) RollbackVersion(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[6036.401817, "o", "\u001b[?2004h> "]
[6036.402064, "o", "\\tmodelName := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[6036.402123, "o", "\u001b[?2004h"]
[6036.4022, "o", "> "]
[6036.402357, "o", "\\tnumStr := r.PathValue(\"num\")\r\n\u001b[?2004l\r"]
[6036.402435, "o", "\u001b[?2004h> "]
[6036.402628, "o", "\\tnum, err := strconv.Atoi(numStr)\r\n\u001b[?2004l\r"]
[6036.402702, "o", "\u001b[?2004h> "]
[6036.402817, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[6036.402904, "o", "\u001b[?2004h> "]
[6036.403321, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\u001b[?2004l\r"]
[6036.403388, "o", "\u001b[?2004h> "]
[6036.403468, "o", "\\t\\treturn\r\n"]
[6036.403551, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[6036.403637, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6036.403718, "o", "\u001b[?2004h> "]
[6036.404145, "o", "\\tif err := h.Registry.RollbackVersion(modelName, num); err != nil {\r\n\u001b[?2004l\r"]
[6036.404226, "o", "\u001b[?2004h> "]
[6036.404527, "o", "\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[6036.404592, "o", "\u001b[?2004h"]
[6036.404676, "o", "> "]
[6036.404761, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.404847, "o", "> \\t}\r\n\u001b[?2004l\r"]
[6036.404946, "o", "\u001b[?2004h> "]
[6036.405197, "o", "\\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[?2004l\r"]
[6036.405269, "o", "\u001b[?2004h> "]
[6036.405385, "o", "\\t\\t\"status\":  \"rolled_back\",\r\n\u001b[?2004l\r"]
[6036.405467, "o", "\u001b[?2004h> "]
[6036.405548, "o", "\\t\\t\"model\":   modelName,\r\n\u001b[?2004l\r"]
[6036.405633, "o", "\u001b[?2004h> "]
[6036.405718, "o", "\\t\\t\"version\": num,\r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.405801, "o", "> "]
[6036.405893, "o", "\\t\\t\"stage\":   \"development\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.405977, "o", "> \\t})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6036.406059, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6036.406141, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6036.406222, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6036.40636, "o", "s = s.rstrip() + '\\n' + insert\r\n\u001b[?2004l\r"]
[6036.406435, "o", "\u001b[?2004h> "]
[6036.406516, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[6036.406599, "o", "> PY\r\n\u001b[?2004l\r"]
[6036.450968, "o", "\u001b[?2004h"]
