[970.171632, "o", "   246\t\t\t\treturn map[string]interface{}{\"format\": \"csv\", \"content\": \"\"}, nil\r\n   247\t\t\t}\r\n   248\t\t\tcsv := \"\"\r\n   249\t\t\tfor i, v := range data {\r\n   250\t\t\t\tif i > 0 {\r\n   251\t\t\t\t\tcsv += \",\"\r\n   252\t\t\t\t}\r\n   253\t\t\t\tcsv += fmt.Sprintf(\"%v\", v)\r\n   254\t\t"]
[970.171695, "o", "\t}\r\n   255\t\t\treturn map[string]interface{}{\r\n   256\t\t\t\t\"format\":  \"csv\",\r\n   257\t\t\t\t\"content\": csv,\r\n   258\t\t\t\t\"data\":    data,\r\n   259\t\t\t}, nil\r\n   260\t\r\n   261\t\tdefault:\r\n   262\t\t"]
[970.171756, "o", "\treturn nil, fmt.Errorf(\"export: unknown format %q\", format)\r\n   263\t\t}\r\n   264\t}\r\n   265\t\r\n   266\t// ExecuteFilter selects elements from the data array based on a comparison condition.\r\n   267\t// Supported modes: gt, lt, gte, lte, eq, ne.\r\n   268\tfunc ExecuteFilter(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   269\t\tdata, ok := input[\"data\"].([]interface{})\r\n   270\t\tif !ok {\r\n   271\t\t\t"]
[970.171819, "o", "return nil, fmt.Errorf(\"filter: missing or invalid 'data' field in input\")\r\n   272\t\t}\r\n   273\t\r\n   274\t\tmode, _ := config[\"mode\"].(string)\r\n   275\t\tif mode == \"\" {\r\n   276\t\t\treturn nil, fmt.Errorf(\"filter: missing 'mode' in config\")\r\n   277\t\t}\r\n   278\t\tthreshold, _ := config[\"threshold\"].(float64)\r\n   279\t\r\n   280\t\tvar result []interface{}\r\n   281\t"]
[970.171891, "o", "\tfor _, v := range data {\r\n   282\t\t\tval, err := toFloat(v)\r\n   283\t\t\tif err != nil {\r\n   284\t\t\t\tcontinue\r\n   285\t\t\t}\r\n   286\t\t\tvar keep bool\r\n   287\t\t\tswitch mode {\r\n   288\t\t\tcase \"gt\":\r\n   289\t\t\t\tkeep = val > threshold\r\n"]
[970.171955, "o", "   290\t\t\tcase \"lt\":\r\n   291\t\t\t\tkeep = val < threshold\r\n   292\t\t\tcase \"gte\":\r\n   293\t\t\t\tkeep = val >= threshold\r\n   294\t\t\tcase \"lte\":\r\n   295\t\t\t\tkeep = val <= threshold\r\n   296\t\t\tcase \"eq\":\r\n   297\t\t\t\tkeep = val == threshold\r\n   298"]
[970.172017, "o", "\t\t\tcase \"ne\":\r\n   299\t\t\t\tkeep = val != threshold\r\n   300\t\t\tdefault:\r\n   301\t\t\t\treturn nil, fmt.Errorf(\"filter: unknown mode %q\", mode)\r\n   302\t\t\t}\r\n   303\t\t\tif keep {\r\n   304\t\t\t\tresult = append(result, val)\r\n   305\t"]
[970.172078, "o", "\t\t}\r\n   306\t\t}\r\n   307\t\r\n   308\t\tif result == nil {\r\n   309\t\t\tresult = []interface{}{}\r\n   310\t\t}\r\n   311\t\treturn map[string]interface{}{\"data\": result}, nil\r\n   312\t}\r\n   313\t\r\n"]
[970.172143, "o", "   314\t// Helper functions\r\n   315\t\r\n   316\tfunc toFloat(v interface{}) (float64, error) {\r\n   317\t\tswitch val := v.(type) {\r\n   318\t\tcase float64:\r\n   319\t\t\treturn val, nil\r\n"]
[970.172201, "o", "   320\t\tcase int:\r\n   321\t\t\treturn float64(val), nil\r\n   322\t\tcase int64:\r\n   323\t\t\treturn float64(val), nil\r\n   324\t\tdefault:\r\n   325\t\t\treturn 0, fmt.Errorf(\"cannot convert %T to float64\", v)\r\n   326\t\t}\r\n   327\t}\r\n   328\t\r\n   329\tfunc findMinMax(data []interface{}) (float64, float64) {\r\n   330\t\tif len(data) == 0 {\r\n   331\t"]
[970.172264, "o", "\t\treturn 0, 0\r\n   332\t\t}\r\n   333\t\tminVal, _ := toFloat(data[0])\r\n   334\t\tmaxVal := minVal\r\n   335\t\tfor _, v := range data[1:] {\r\n"]
[970.172324, "o", "   336\t\t\tval, err := toFloat(v)\r\n   337\t\t\tif err != nil {\r\n   338\t\t\t\tcontinue\r\n   339\t\t\t}\r\n   340\t\t\tif val < minVal {\r\n   341\t\t\t\tminVal = val\r\n   342\t\t\t}\r\n   343\t\t\tif val > maxVal {\r\n   344\t\t\t\tmaxVal = val\r\n   345\t\t\t}\r\n   346\t\t}\r\n   347\t\treturn minVal, maxVal\r\n   348\t"]
[970.172383, "o", "}\r\n   349\t\r\n   350\tfunc sortedCopy(values []float64) []float64 {\r\n   351\t\ts := make([]float64, len(values))\r\n   352\t\tcopy(s, values)\r\n   353\t\tsort.Float64s(s)\r\n   354\t\treturn s\r\n   355\t}\r\n"]
