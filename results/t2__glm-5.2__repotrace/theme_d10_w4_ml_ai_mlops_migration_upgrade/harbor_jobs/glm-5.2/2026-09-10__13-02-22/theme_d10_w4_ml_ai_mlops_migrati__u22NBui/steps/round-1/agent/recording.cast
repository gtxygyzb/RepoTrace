[5752.751749, "o", "   136\tfunc (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {\r\n   137\t\tr.mu.Lock()\r\n   138\t\tdefer r.mu.Unlock()\r\n   139\t\r\n   140\t\tmodel, exists := r.models[modelName]\r\n"]
[5752.751887, "o", "   141\t\tif !exists {\r\n   142\t\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n   143\t\t}\r\n   144\t\r\n   145\t\tnextNum := 1\r\n   146\t\tfor _, v := range model.Versions {\r\n   147\t\t"]
[5752.751968, "o", "\tif v.Number >= nextNum {\r\n   148\t\t\t\tnextNum = v.Number + 1\r\n   149\t\t\t}\r\n   150\t\t}\r\n   151\t\r\n   152\t\tif tags == nil {\r\n   153\t\t\ttags = []string{}\r\n   154\t\t}\r\n   155\t\tversion := &Version{\r\n   156\t\t\tNumber:      nextNum,\r\n   157\t\t\tStage:       StageDevelopment,\r\n   158\t\t\tMetrics:     metrics,\r\n   159\t\t\tTags:        tags,\r\n   160\t\t\tModelConfig: modelConfig,\r\n   161\t\t\tCreatedAt:   time.Now(),\r\n   162\t\t\tLineage:     []PromotionRecord{},\r\n   163\t\t}\r\n   164\t\tmodel.Versions = append(model.Versions, version)\r\n   165\t\tmodel.UpdatedAt = time.Now()\r\n   166\t\r\n   167\t\tif err := r.saveModel(model); err != nil {\r\n   168\t\t\tmodel.Versions = model.Versions[:len(model.Versions)-1]\r\n   169\t\t\treturn nil, err\r\n   170\t\t}\r\n   171\t\treturn version, nil\r\n   172\t}\r\n"]
[5752.752056, "o", "   173\t\r\n   174\t// PromoteVersion transitions a model version to the specified stage.\r\n"]
[5752.752602, "o", "\u001b[?2004h"]
