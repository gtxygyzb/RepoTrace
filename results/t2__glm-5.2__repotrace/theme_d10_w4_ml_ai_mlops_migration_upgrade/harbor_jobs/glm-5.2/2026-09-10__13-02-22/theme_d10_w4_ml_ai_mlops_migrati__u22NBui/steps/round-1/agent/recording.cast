[4624.412337, "o", "\u001b[?2004h> "]
[4624.412504, "o", "\\t\\t\\t\"current_stage\": string(v.Stage),\r\n\u001b[?2004l\r"]
[4624.41254, "o", "\u001b[?2004h> "]
