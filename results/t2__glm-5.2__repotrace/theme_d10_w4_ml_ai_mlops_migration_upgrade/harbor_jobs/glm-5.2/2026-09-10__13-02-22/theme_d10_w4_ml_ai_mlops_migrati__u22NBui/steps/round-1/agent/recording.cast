[648.954463, "o", "> "]
[648.954663, "o", "def req(method, path, body=None):\r\n\u001b[?2004l\r"]
[648.954719, "o", "\u001b[?2004h> "]
[648.954871, "o", "    url = BASE + path\r\n"]
[648.95493, "o", "\u001b[?2004l\r\u001b[?2004h"]
[648.954986, "o", "> "]
[648.95508, "o", "    data = None\r\n\u001b[?2004l\r"]
[648.955134, "o", "\u001b[?2004h> "]
[648.955496, "o", "    headers = {\"Content-Type\": \"application/json\"}\r\n\u001b[?2004l\r"]
[648.955556, "o", "\u001b[?2004h> "]
[648.955733, "o", "    if body is not None:\r\n\u001b[?2004l\r"]
[648.955796, "o", "\u001b[?2004h> "]
[648.9561, "o", "        data = json.dumps(body).encode()\r\n\u001b[?2004l\r"]
[648.956158, "o", "\u001b[?2004h> "]
[648.956692, "o", "    r = urllib.request.Request(url, data=data, method=method, headers=headers)\r\n\u001b[?2004l\r"]
[648.956749, "o", "\u001b[?2004h> "]
[648.956819, "o", "    try:\r\n\u001b[?2004l\r"]
[648.956887, "o", "\u001b[?2004h> "]
[648.957294, "o", "        with urllib.request.urlopen(r, timeout=5) as resp:\r\n\u001b[?2004l\r"]
[648.957351, "o", "\u001b[?2004h> "]
[648.957723, "o", "            return resp.status, resp.read().decode()\r\n\u001b[?2004l\r"]
[648.957778, "o", "\u001b[?2004h> "]
[648.958092, "o", "    except urllib.error.HTTPError as e:\r\n\u001b[?2004l\r"]
[648.958148, "o", "\u001b[?2004h> "]
[648.958423, "o", "        return e.code, e.read().decode()\r\n\u001b[?2004l\r"]
[648.958479, "o", "\u001b[?2004h> "]
[648.958675, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[648.958731, "o", "\u001b[?2004h> "]
[648.958933, "o", "        return None, str(e)\r\n\u001b[?2004l\r"]
