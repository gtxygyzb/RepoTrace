[2164.489567, "o", "// MetricFilter defines a metric condition for searching runs.\r\n\u001b[?2004l\r"]
[2164.489622, "o", "\u001b[?2004h> "]
[2164.489721, "o", "type MetricFilter struct {\r\n\u001b[?2004l\r"]
[2164.489775, "o", "\u001b[?2004h> "]
[2164.489909, "o", "\\tMetric string  `json:\"metric\"`\r\n\u001b[?2004l\r"]
[2164.489965, "o", "\u001b[?2004h> "]
[2164.490068, "o", "\\tOp     string  `json:\"op\"`\r\n\u001b[?2004l\r"]
[2164.49009, "o", "\u001b[?2004h> "]
[2164.490241, "o", "\\tValue  float64 `json:\"value\"`\r\n\u001b[?2004l\r"]
[2164.490261, "o", "\u001b[?2004h> "]
[2164.490281, "o", "}\r\n\u001b[?2004l\r"]
[2164.490317, "o", "\u001b[?2004h> "]
[2164.490338, "o", "\r\n\u001b[?2004l\r"]
[2164.490358, "o", "\u001b[?2004h"]
[2164.490379, "o", "> "]
[2164.491959, "o", "func compareMetric(value float64, op string, threshold float64) bool {\r\n\u001b[?2004l\r\u001b[?2004h> \\tswitch op {\r\n\u001b[?2004l\r\u001b[?2004h> \\tcase \"gt\":\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\treturn value > threshold\r\n\u001b[?2004l\r\u001b[?2004h> \\tcase \"lt\":\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\treturn value < threshold\r\n\u001b[?2004l\r\u001b[?2004h> \\tcase \"gte\":\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\treturn value >= threshold\r\n\u001b[?2004l\r\u001b[?2004h> \\tcase \"lte\":\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\treturn value <= threshold\r\n\u001b[?2004l\r\u001b[?2004h> \\tcase \"eq\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2164.49209, "o", "\\t\\treturn value == threshold\r\n\u001b[?2004l\r"]
[2164.492146, "o", "\u001b[?2004h> "]
[2164.492202, "o", "\\tdefault:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2164.492288, "o", "\\t\\treturn false\r\n\u001b[?2004l\r"]
[2164.492345, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2164.492402, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2164.492457, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[2164.49251, "o", "> '''\r\n\u001b[?2004l\r"]
[2164.492564, "o", "\u001b[?2004h> "]
[2164.492635, "o", "if marker not in s:\r\n\u001b[?2004l\r"]
[2164.49269, "o", "\u001b[?2004h> "]
[2164.492902, "o", "    raise SystemExit('matchTags marker not found')\r\n\u001b[?2004l\r"]
[2164.492957, "o", "\u001b[?2004h> "]
[2164.49313, "o", "s = s.replace(marker, new_methods + marker)\r\n\u001b[?2004l\r"]
[2164.493184, "o", "\u001b[?2004h> "]
[2164.493241, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[2164.493294, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[2164.531538, "o", "\u001b[?2004hroot@n30009:/app# "]
