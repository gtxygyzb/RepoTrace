[6956.309873, "o", "\u001b[?2004h> "]
[6956.310015, "o", "\\t\\t\"model_name\":  loaded.ModelName,\r\n\u001b[?2004l\r"]
[6956.31007, "o", "\u001b[?2004h> "]
