[1442.64115, "o", "\u001b[?2004h> "]
[1442.641201, "o", "\u0007"]
[1442.641261, "o", "if err != nil {\r\n\u001b[?2004l\r"]
[1442.64131, "o", "\u001b[?2004h> "]
[1442.641357, "o", "\u0007"]
[1442.641403, "o", "\r\n"]
[1442.641451, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.641754, "o", "return nil, fmt.Errorf(\"dependency resolution failed: %w\", err)\r\n\u001b[?2004l\r"]
[1442.641816, "o", "\u001b[?2004h> "]
[1442.641875, "o", "\u0007}\r\n\u001b[?2004l\r\u001b[?2004h"]
