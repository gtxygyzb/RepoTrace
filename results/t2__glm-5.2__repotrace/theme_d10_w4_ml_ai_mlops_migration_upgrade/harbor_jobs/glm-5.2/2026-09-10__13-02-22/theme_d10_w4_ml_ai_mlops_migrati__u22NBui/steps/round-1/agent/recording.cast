[960.804111, "i", "sed -n '1,240p' internal/registry/registry.go\n"]
[960.804474, "o", "sed -n '1,240p' internal/registry/registry.go\r\n\u001b[?2004l\r"]
[960.807651, "o", "package registry\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[960.807726, "o", "\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\n// Stage represents the lifecycle stage of a model version.\r\ntype Stage string\r\n\r\nconst (\r\n\tStageDevelopment Stage = \"development\"\r\n\tStageStaging     Stage = \"staging\"\r\n\tStageProduction  Stage = \"production\"\r\n\tStageArchived    Stage = \"archived\"\r\n"]
[960.80777, "o", ")\r\n\r\nvar validTransitions = map[Stage][]Stage{\r\n\tStageDevelopment: {StageStaging, StageArchived},\r\n\tStageStaging:     {StageProduction, StageArchived},\r\n\tStageProduction:  {StageArchived},\r\n\tStageArchived:    {},\r\n"]
[960.807906, "o", "}\r\n\r\n// Version represents a specific version of a model.\r\ntype Version struct {\r\n\tNumber      int                    `json:\"number\"`\r\n\tStage       Stage                  `json:\"stage\"`\r\n\tMetrics     map[string]float64     `json:\"metrics\"`\r\n\tTags        []string               `json:\"tags\"`\r\n\tModelConfig map[string]interface{} `json:\"model_config,omitempty\"`\r\n\tCreatedAt   time.Time              `json:\"created_at\"`\r\n}\r\n\r\n// Model represents a registered ML model.\r\ntype Model struct {\r\n\tName        string     `json:\"name\"`\r\n\tFramework   string     `json:\"framework\"`\r\n\tDescription string     `json:\"description\"`\r\n\tTags        []string   `json:\"tags\"`\r\n\tVersions    []*Version `json:\"versions\"`\r\n\tCreatedAt   time.Time  `json:\"created_at\"`\r\n\tUpdatedAt   time.Time  `json:\"updated_at\"`\r\n}\r\n\r\n// ModelFilter defines filtering criteria for listing models.\r\n"]
[960.807979, "o", "type ModelFilter struct {\r\n\tFramework string\r\n\tTag       string\r\n}\r\n\r\n// Registry manages model registration, versioning, and lifecycle.\r\ntype Registry struct {\r\n\tmu      sync.RWMutex\r\n"]
[960.808044, "o", "\tmodels  map[string]*Model\r\n\tdataDir string\r\n}\r\n\r\n// NewRegistry creates a new Registry backed by the given data directory.\r\nfunc NewRegistry(dataDir string) (*Registry, error) {\r\n\tif err := os.MkdirAll(dataDir, 0755); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"create data dir: %w\", err)\r\n\t}\r\n\tr := &Registry{\r\n\t\tmodels:  make(map[string]*Model),\r\n\t\tdataDir: dataDir,\r\n\t}\r\n\tif err := r.loadAll(); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"load registry: %w\", err)\r\n"]
[960.808107, "o", "\t}\r\n\treturn r, nil\r\n}\r\n\r\n// RegisterModel creates a new model entry in the registry.\r\nfunc (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tif _, exists := r.models[name]; exists {\r\n"]
[960.808174, "o", "\t\treturn nil, fmt.Errorf(\"model %q already exists\", name)\r\n\t}\r\n\r\n\tnow := time.Now()\r\n\tmodel := &Model{\r\n\t\tName:        name,\r\n\t\tFramework:   framework,\r\n\t\tDescription: description,\r\n\t\tTags:        tags,\r\n\t\tVersions:    make([]*Version, 0),\r\n\t"]
[960.808231, "o", "\tCreatedAt:   now,\r\n\t\tUpdatedAt:   now,\r\n\t}\r\n\tr.models[name] = model\r\n\tif err := r.saveModel(model); err != nil {\r\n\t\tdelete(r.models, name)\r\n\t\treturn nil, err\r\n\t}\r\n\treturn model, nil\r\n"]
[960.808292, "o", "}\r\n\r\n// CreateVersion adds a new version to the specified model.\r\nfunc (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n"]
[960.808357, "o", "\t}\r\n\r\n\tnextNum := 1\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Number >= nextNum {\r\n\t\t\tnextNum = v.Number + 1\r\n\t\t}\r\n\t}\r\n"]
[960.80842, "o", "\r\n\tversion := &Version{\r\n\t\tNumber:      nextNum,\r\n\t\tStage:       StageDevelopment,\r\n\t\tMetrics:     metrics,\r\n\t\tTags:        tags,\r\n\t\tModelConfig: modelConfig,\r\n\t\tCreatedAt:   time.Now(),\r\n\t}\r\n\tmodel.Versions = append(model.Versions, version)\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\tif err := r.saveModel(model); err != nil {\r\n\t\tmodel.Versions = model.Versions[:len(model.Versions)-1]\r\n\t\t"]
[960.808477, "o", "return nil, err\r\n\t}\r\n\treturn version, nil\r\n}\r\n\r\n// PromoteVersion transitions a model version to the specified stage.\r\nfunc (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n"]
[960.808547, "o", "\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tvar version *Version\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Number == versionNum {\r\n\t\t\tversion = v\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n"]
[960.808608, "o", "\tif version == nil {\r\n\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n\t}\r\n\r\n\t// Validate stage transition\r\n\tallowed := validTransitions[version.Stage]\r\n\tvalid := false\r\n\tfor _, s := range allowed {\r\n\t\tif s == targetStage {\r\n"]
[960.808669, "o", "\t\t\tvalid = true\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif !valid {\r\n\t\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n\t}\r\n\r\n\t// If promoting to production, demote current production version\r\n\tif targetStage == StageProduction {\r\n\t\tfor _, v := range model.Versions {\r\n"]
[960.808726, "o", "\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n\t\t\t\tv.Stage = StageArchived\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tversion.Stage = targetStage\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\treturn r.saveModel(model)\r\n}\r\n\r\n"]
[960.808785, "o", "// GetModel returns a model with its versions sorted by version number descending.\r\nfunc (r *Registry) GetModel(name string) (*Model, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tmodel, exists := r.models[name]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", name)\r\n\t}\r\n"]
[960.808846, "o", "\r\n\t// Return a copy with versions sorted\r\n\tresult := *model\r\n\tresult.Versions = make([]*Version, len(model.Versions))\r\n\tcopy(result.Versions, model.Versions)\r\n\tsort.Slice(result.Versions, func(i, j int) bool {\r\n\t\treturn result.Versions[i].Number > result.Versions[j].Number\r\n\t})\r\n\treturn &result, nil\r\n"]
[960.808919, "o", "}\r\n\r\n// ListModels returns all models matching the optional filter.\r\nfunc (r *Registry) ListModels(filter *ModelFilter) ([]*Model, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tvar result []*Model\r\n\tfor _, model := range r.models {\r\n\t\tif filter != nil {\r\n\t\t\tif filter.Framework != \"\" && model.Framework != filter.Framework {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t"]
[960.808975, "o", "\t\tif filter.Tag != \"\" {\r\n\t\t\t\thasTag := false\r\n\t\t\t\tfor _, t := range model.Tags {\r\n\t\t\t\t\tif t == filter.Tag {\r\n\t\t\t\t\t\thasTag = true\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t}\r\n"]
[960.809035, "o", "\t\t\t\t}\r\n\t\t\t\tif !hasTag {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tresult = append(result, model)\r\n\t}\r\n\tsort.Slice(result, func(i, j int) bool {\r\n"]
[960.809096, "o", "\t\treturn result[i].Name < result[j].Name\r\n\t})\r\n\treturn result, nil\r\n}\r\n"]
[960.809576, "o", "\u001b[?2004h"]
[960.809632, "o", "root@n30009:/app# "]
[961.09856, "i", "sed -n '1,260p' internal/experiment/experiment.go\n"]
[961.099003, "o", "sed -n '1,260p' internal/experiment/experiment.go\r\n"]
[961.099105, "o", "\u001b[?2004l\r"]
[961.102208, "o", "package experiment\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\n// Experiment groups related runs together.\r\ntype Experiment struct {\r\n\tName      string    `json:\"name\"`\r\n\tRuns      []*Run    `json:\"runs\"`\r\n\tCreatedAt time.Time `json:\"created_at\"`\r\n}\r\n\r\n"]
[961.102333, "o", "// Run records a single experiment execution with parameters and metrics.\r\ntype Run struct {\r\n\tID         string             `json:\"id\"`\r\n\tParameters map[string]float64 `json:\"parameters\"`\r\n\tMetrics    map[string]float64 `json:\"metrics\"`\r\n\tTags       map[string]string  `json:\"tags\"`\r\n\tCreatedAt  time.Time          `json:\"created_at\"`\r\n}\r\n\r\n// Tracker manages experiments and their runs.\r\ntype Tracker struct {\r\n\tmu          sync.RWMutex\r\n\texperiments map[string]*Experiment\r\n\tdataDir     string\r\n\trunCounter  int\r\n}\r\n\r\n// NewTracker creates a new experiment tracker backed by the given data directory.\r\nfunc NewTracker(dataDir string) *Tracker {\r\n\tos.MkdirAll(dataDir, 0755)\r\n\tt := &Tracker{\r\n\t\texperiments: make(map[string]*Experiment),\r\n\t"]
[961.102408, "o", "\tdataDir:     dataDir,\r\n\t}\r\n\tt.loadAll()\r\n\treturn t\r\n}\r\n\r\n// CreateExperiment creates a new experiment with the given name.\r\nfunc (t *Tracker) CreateExperiment(name string) (*Experiment, error) {\r\n\tt.mu.Lock()\r\n\tdefer t.mu.Unlock()\r\n\r\n\tif _, exists := t.experiments[name]; exists {\r\n\t\treturn nil, fmt.Errorf(\"experiment %q already exists\", name)\r\n\t}\r\n"]
[961.102518, "o", "\r\n\texp := &Experiment{\r\n\t\tName:      name,\r\n\t\tRuns:      make([]*Run, 0),\r\n\t\tCreatedAt: time.Now(),\r\n\t}\r\n\tt.experiments[name] = exp\r\n\tif err := t.saveExperiment(exp); err != nil {\r\n\t\tdelete(t.experiments, name)\r\n\t\treturn nil, err\r\n\t}\r\n\treturn exp, nil\r\n}\r\n\r\n// LogRun adds a new run to the specified experiment.\r\nfunc (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {\r\n\tt.mu.Lock()\r\n\tdefer t.mu.Unlock()\r\n\r\n\texp, exists := t.experiments[experimentName]\r\n"]
[961.102592, "o", "\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\t}\r\n\r\n\tt.runCounter++\r\n\trun := &Run{\r\n\t\t"]
[961.102659, "o", "ID:         fmt.Sprintf(\"run_%d\", t.runCounter),\r\n\t\tParameters: params,\r\n\t\tMetrics:    metrics,\r\n\t\tTags:       tags,\r\n\t\tCreatedAt:  time.Now(),\r\n\t}\r\n\texp.Runs = append(exp.Runs, run)\r\n\r\n\tif err := t.saveExperiment(exp); err != nil {\r\n\t\texp.Runs = exp.Runs[:len(exp.Runs)-1]\r\n\t\treturn nil, err\r\n\t}\r\n\treturn run, nil\r\n}\r\n\r\n// GetExperiment returns the experiment with the given name.\r\nfunc (t *Tracker) GetExperiment(name string) (*Experiment, error) {\r\n"]
[961.102721, "o", "\tt.mu.RLock()\r\n\tdefer t.mu.RUnlock()\r\n\r\n\texp, exists := t.experiments[name]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"experiment %q not found\", name)\r\n\t}\r\n\treturn exp, nil\r\n}\r\n\r\n// ListExperiments returns all experiments.\r\n"]
[961.102782, "o", "func (t *Tracker) ListExperiments() []*Experiment {\r\n\tt.mu.RLock()\r\n\tdefer t.mu.RUnlock()\r\n\r\n\tresult := make([]*Experiment, 0, len(t.experiments))\r\n\tfor _, exp := range t.experiments {\r\n\t\tresult = append(result, exp)\r\n\t}\r\n\tsort.Slice(result, func(i, j int) bool {\r\n\t\t"]
[961.102844, "o", "return result[i].Name < result[j].Name\r\n\t})\r\n\treturn result\r\n}\r\n\r\n// AggregateMetric computes an aggregate statistic for a given metric across all runs\r\n// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.\r\n// For weighted_mean, weightParam specifies which parameter to use as weight.\r\nfunc (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, int, error) {\r\n\tt.mu.RLock()\r\n"]
[961.102951, "o", "\tdefer t.mu.RUnlock()\r\n\r\n\texp, exists := t.experiments[experimentName]\r\n\tif !exists {\r\n\t\treturn 0, 0, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\t}\r\n\r\n\tif len(exp.Runs) == 0 {\r\n\t\treturn 0, 0, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n\t}\r\n\r\n\tvar values []float64\r\n\tvar weights []float64\r\n\tfor _, run := range exp.Runs {\r\n\t\tvalue, ok := run.Metrics[metricName]\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[961.103024, "o", "\t\tvalues = append(values, value)\r\n\t\tif aggType == \"weighted_mean\" {\r\n\t\t\tweight, ok := run.Parameters[weightParam]\r\n\t\t\tif !ok {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tweights = append(weights, weight)\r\n\t\t}\r\n\t}\r\n\r\n\tif len(values) == 0 {\r\n"]
[961.103083, "o", "\t\treturn 0, 0, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n\t}\r\n\r\n\tswitch aggType {\r\n\tcase \"mean\":\r\n\t\tsum := 0.0\r\n\t\tfor _, v := range values {\r\n\t\t\tsum += v\r\n\t\t}\r\n"]
[961.103141, "o", "\t\treturn sum / float64(len(values)), len(values), nil\r\n\r\n\tcase \"median\":\r\n\t\tsorted := sortedCopy(values)\r\n\t\tn := len(sorted)\r\n\t\tif n%2 == 0 {\r\n\t\t\treturn (sorted[n/2-1] + sorted[n/2]) / 2, len(values), nil\r\n\t\t}\r\n\t\treturn sorted[n/2], len(values), nil\r\n\r\n"]
[961.103206, "o", "\tcase \"p95\":\r\n\t\tsorted := sortedCopy(values)\r\n\t\treturn percentile(sorted, 0.95), len(values), nil\r\n\r\n\tcase \"p99\":\r\n\t\tsorted := sortedCopy(values)\r\n\t\treturn percentile(sorted, 0.99), len(values), nil\r\n\r\n\tcase \"weighted_mean\":\r\n\t\tif weightParam == \"\" {\r\n\t\t\treturn 0, 0, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\n"]
[961.103268, "o", "\t\t}\r\n\t\tif len(weights) == 0 {\r\n\t\t\treturn 0, 0, fmt.Errorf(\"no runs with metric %q and weight parameter %q\", metricName, weightParam)\r\n\t\t}\r\n\t\tif len(weights) != len(values) {\r\n\t\t\treturn 0, 0, fmt.Errorf(\"mismatch between metric values and weights\")\r\n\t\t}\r\n\t\tweightedSum := 0.0\r\n\t\t"]
[961.103325, "o", "weightSum := 0.0\r\n\t\tfor i, v := range values {\r\n\t\t\tweightedSum += v * weights[i]\r\n\t\t\tweightSum += weights[i]\r\n\t\t}\r\n\t\tif weightSum == 0 {\r\n\t\t\treturn 0, 0, fmt.Errorf(\"weighted_mean has zero total weight\")\r\n\t\t}\r\n\t\treturn weightedSum / weightSum, len(values), nil\r\n"]
[961.103381, "o", "\r\n\tdefault:\r\n\t\treturn 0, 0, fmt.Errorf(\"unknown aggregation type %q\", aggType)\r\n\t}\r\n}\r\n\r\nfunc percentile(sorted []float64, p float64) float64 {\r\n\tn := len(sorted)\r\n\tif n == 0 {\r\n"]
[961.103441, "o", "\t\treturn 0\r\n\t}\r\n\tif n == 1 {\r\n\t\treturn sorted[0]\r\n\t}\r\n\trank := p * float64(n-1)\r\n\tlower := int(math.Floor(rank))\r\n\tupper := int(math.Ceil(rank))\r\n\tif lower == upper {\r\n\t\treturn sorted[lower]\r\n\t"]
[961.103503, "o", "}\r\n\tfrac := rank - float64(lower)\r\n\treturn sorted[lower]*(1-frac) + sorted[upper]*frac\r\n}\r\n\r\nfunc sortedCopy(values []float64) []float64 {\r\n\ts := make([]float64, len(values))\r\n\tcopy(s, values)\r\n\tsort.Float64s(s)\r\n\treturn s\r\n}\r\n"]
[961.103568, "o", "\r\nfunc (t *Tracker) loadAll() {\r\n\tentries, err := os.ReadDir(t.dataDir)\r\n\tif err != nil {\r\n\t\treturn\r\n\t}\r\n"]
[961.103634, "o", "\tfor _, entry := range entries {\r\n\t\tif !entry.IsDir() && filepath.Ext(entry.Name()) == \".json\" {\r\n\t\t\tdata, err := os.ReadFile(filepath.Join(t.dataDir, entry.Name()))\r\n\t\t\tif err != nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvar exp Experiment\r\n\t\t\tif err := json.Unmarshal(data, &exp); err != nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
[961.1037, "o", "\t\t\tt.experiments[exp.Name] = &exp\r\n\t\t\tfor _, r := range exp.Runs {\r\n\t\t\t\t_ = r\r\n\t\t\t\tt.runCounter++\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\n"]
