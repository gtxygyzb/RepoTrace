[1442.630883, "o", "Error      string                 `json:\"error,omitempty\"`\r\n\u001b[?2004l\r"]
[1442.630947, "o", "\u001b[?2004h> "]
[1442.630998, "o", "\u0007"]
[1442.631369, "o", "DurationMs float64                `json:\"duration_ms\"`\r\n\u001b[?2004l\r"]
[1442.631429, "o", "\u001b[?2004h> }"]
[1442.631478, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1442.631523, "o", "> \r\n\u001b[?2004l\r"]
[1442.631569, "o", "\u001b[?2004h> "]
[1442.632044, "o", "// PipelineResult records the outcome of executing an entire pipeline.\r\n\u001b[?2004l\r"]
[1442.632097, "o", "\u001b[?2004h> "]
[1442.6323, "o", "type PipelineResult struct {\r\n\u001b[?2004l\r"]
[1442.632347, "o", "\u001b[?2004h> "]
[1442.632422, "o", "\u0007"]
[1442.632758, "o", "PipelineName string        `json:\"pipeline_name\"`\r\n\u001b[?2004l\r"]
[1442.632807, "o", "\u001b[?2004h> "]
[1442.63289, "o", "\u0007"]
[1442.633183, "o", "Status       string        `json:\"status\"`\r\n\u001b[?2004l\r"]
[1442.633241, "o", "\u001b[?2004h> "]
[1442.633308, "o", "\u0007"]
[1442.633596, "o", "Steps        []*StepResult `json:\"steps\"`\r\n\u001b[?2004l\r"]
