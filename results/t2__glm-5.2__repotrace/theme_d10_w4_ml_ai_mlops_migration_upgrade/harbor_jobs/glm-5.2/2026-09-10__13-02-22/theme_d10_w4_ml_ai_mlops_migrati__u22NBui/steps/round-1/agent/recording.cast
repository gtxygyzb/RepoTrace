[3939.065973, "o", "\u001b[?2004l\r"]
[3939.069054, "o", "\r\nfunc (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\tmetricName := r.PathValue(\"metric\")\r\n\taggType := r.URL.Query().Get(\"type\")\r\n\tweightParam := r.URL.Query().Get(\"weight_param\")\r\n\ttagFilters := map[string]string{}\r\n\tfor _, filter := range r.URL.Query()[\"tag_filter\"] {\r\n\t\tparts := strings.SplitN(filter, \":\", 2)\r\n\t"]
[3939.069159, "o", "\tif len(parts) != 2 {\r\n\t\t\twriteError(w, http.StatusBadRequest, \"invalid tag_filter %q, expected key:value\", filter)\r\n\t\t\treturn\r\n\t\t}\r\n\t\ttagFilters[parts[0]] = parts[1]\r\n\t}\r\n\r\n\tif aggType == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"query parameter 'type' is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tresult, count, runIDs, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam, tagFilters)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n"]
[3939.069248, "o", "\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\t\t\"experiment\": expName,\r\n\t\t\"metric\":     metricName,\r\n\t\t\"type\":       aggType,\r\n\t\t\"value\":      result,\r\n\t\t\"count\":      count,\r\n\t\t\"run_ids\":    runIDs,\r\n\t})\r\n}\r\n\r\nfunc (h *Handlers) GetMetricHistory(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\tmetricName := r.PathValue(\"metric\")\r\n\t"]
[3939.069332, "o", "history, err := h.Experiment.MetricHistory(expName, metricName)\r\n\tif err != nil {\r\n\t\tif strings.Contains(err.Error(), \"not found\") {\r\n\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\t} else {\r\n\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\t}\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\t\t\"experiment\": expName,\r\n\t\t\"metric\":     metricName,\r\n"]
[3939.069381, "o", "\t\t\"history\":    history,\r\n\t\t\"count\":      len(history),\r\n\t})\r\n}\r\n\r\nfunc (h *Handlers) UpdateRun(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\trunID := r.PathValue(\"id\")\r\n\tvar req struct {\r\n"]
[3939.069487, "o", "\t\tMetrics map[string]float64 `json:\"metrics\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\trun, err := h.Experiment.UpdateRunMetrics(expName, runID, req.Metrics)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, run)\r\n}\r\n\r\nfunc (h *Handlers) SearchRuns(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\tvar req struct {"]
[3939.06957, "o", "\r\n\t\tFilters []experiment.MetricFilter `json:\"filters\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\truns, err := h.Experiment.SearchRuns(expName, req.Filters)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\t\t\"runs\":  runs,\r\n\t\t\"count\": len(runs),\r\n\t"]
[3939.069651, "o", "})\r\n}\r\n\r\n// --- Model Version Comparison Handler ---\r\n\r\nfunc (h *Handlers) CompareVersionMetrics(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\tversionParam := r.URL.Query().Get(\"versions\")\r\n\tif versionParam == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"query parameter 'versions' is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tparts := strings.Split(versionParam, \",\")\r\n\tseen := map[int]bool{}\r\n"]
[3939.069733, "o", "\tversionNums := make([]int, 0, len(parts))\r\n\tfor _, p := range parts {\r\n\t\tnum, err := strconv.Atoi(strings.TrimSpace(p))\r\n\t\tif err != nil {\r\n\t\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %q\", p)\r\n\t\t\treturn\r\n\t\t}\r\n\t\tif seen[num] {\r\n\t\t\twriteError(w, http.StatusBadRequest, \"duplicate version number: %d\", num)\r\n\t\t\treturn\r\n"]
[3939.069812, "o", "\t\t}\r\n\t\tseen[num] = true\r\n\t\tversionNums = append(versionNums, num)\r\n\t}\r\n\tif len(versionNums) < 2 {\r\n\t\twriteError(w, http.StatusBadRequest, \"at least 2 versions are required for comparison\")\r\n\t\treturn\r\n\t}\r\n\r\n\tmodel, err := h.Registry.GetModel(modelName)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n"]
[3939.06991, "o", "\t}\r\n\r\n\tsort.Ints(versionNums)\r\n\tversionMap := map[int]*registry.Version{}\r\n\tfor _, v := range model.Versions {\r\n\t\tversionMap[v.Number] = v\r\n\t}\r\n\r\n\tversions := make([]map[string]interface{}, 0, len(versionNums))\r\n\tfor _, num := range versionNums {\r\n\t\tv, ok := versionMap[num]\r\n\t\tif !ok {\r\n\t\t\twriteError(w, http.StatusBadRequest, \"version %d does not exist for model %q\", num, modelName)\r\n\t\t\treturn\r\n"]
[3939.069995, "o", "\t\t}\r\n\t\tversions = append(versions, map[string]interface{}{\r\n\t\t\t\"number\":  v.Number,\r\n\t\t\t\"stage\":   v.Stage,\r\n\t\t\t\"metrics\": v.Metrics,\r\n\t\t})\r\n\t}\r\n\r\n\tmetricSummary := map[string]map[string]interface{}{}\r\n\tmetricValues := map[string][]float64{}\r\n\tfor _, v := range versions {\r\n\t\tmetrics, _ := v[\"metrics\"].(map[string]float64)\r\n\t\tfor name, val := range metrics {\r\n"]
[3939.070073, "o", "\t\t\tmetricValues[name] = append(metricValues[name], val)\r\n\t\t}\r\n\t}\r\n\r\n\tfor name, vals := range metricValues {\r\n\t\tif len(vals) == 0 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tminVal := vals[0]\r\n\t\tmaxVal := vals[0]\r\n\t\tsum := 0.0\r\n"]
[3939.070152, "o", "\t\tfor _, val := range vals {\r\n\t\t\tif val < minVal {\r\n\t\t\t\tminVal = val\r\n\t\t\t}\r\n\t\t\tif val > maxVal {\r\n\t\t\t\tmaxVal = val\r\n\t\t\t}\r\n\t\t\tsum += val\r\n\t\t}\r\n\t\tfirst := vals[0]\r\n\t\tlast := vals[len(vals)-1]\r\n"]
[3939.070231, "o", "\t\timprovement := last - first\r\n\t\ttrend := \"stable\"\r\n\t\tif improvement > 0 {\r\n\t\t\ttrend = \"improving\"\r\n\t\t} else if improvement < 0 {\r\n\t\t\ttrend = \"degrading\"\r\n\t\t}\r\n\t\tmetricSummary[name] = map[string]interface{}{\r\n\t\t\t\"min\":         minVal,\r\n\t\t\t\"max\":         maxVal,\r\n\t\t\t\"first\":       first,\r\n\t\t\t\"last\":        last,\r\n\t\t"]
[3939.070311, "o", "\t\"improvement\": improvement,\r\n\t\t\t\"mean\":        sum / float64(len(vals)),\r\n\t\t\t\"trend\":       trend,\r\n\t\t}\r\n\t}\r\n\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\t\t\"model\":          modelName,\r\n\t\t\"versions\":       versions,\r\n\t\t\"metric_summary\": metricSummary,\r\n\t})\r\n}\r\n\r\n// --- Experiment Run Deletion Handler ---\r\n\r\n"]
[3939.07039, "o", "func (h *Handlers) DeleteRun(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\trunID := r.PathValue(\"id\")\r\n\tif err := h.Experiment.DeleteRun(expName, runID); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n}\r\n\r\n// --- Serving Handlers ---\r\n\r\nfunc (h *Handlers) LoadModel(w http.ResponseWriter, r *http.Request) {\r\n"]
[3939.070471, "o", "\tvar req struct {\r\n\t\tModelName  string `json:\"model_name\"`\r\n\t\tVersionNum int    `json:\"version_num\"`\r\n\t\tStage      string `json:\"stage\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.ModelName == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"model_name is required\")\r\n\t\treturn\r\n\t}\r\n"]
[3939.07055, "o", "\r\n\tif err := h.Serving.LoadModel(req.ModelName, req.VersionNum, req.Stage); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"loaded\"})\r\n}\r\n\r\nfunc (h *Handlers) UnloadModel(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\tif err := h.Serving.UnloadModel(name); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t"]
[3939.070631, "o", "}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"unloaded\"})\r\n}\r\n\r\nfunc (h *Handlers) ListLoadedModels(w http.ResponseWriter, r *http.Request) {\r\n\tmodels := h.Serving.ListLoaded()\r\n\twriteJSON(w, http.StatusOK, models)\r\n}\r\n\r\nfunc (h *Handlers) Infer(w http.ResponseWriter, r *http.Request) {\r\n\tvar req serving.InferenceRequest\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n"]
[3939.070771, "o", "\t}\r\n\tif req.ModelName == \"\" {\r\n"]
