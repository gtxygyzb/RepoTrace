[830.0877, "i", "python3 - <<'PY'\nimport json, urllib.request, urllib.error\nBASE = \"http://localhost:8080/api/v1\"\ndef req(method, path, body=None):\n    data = json.dumps(body).encode() if body is not None else None\n    r = urllib.request.Request(BASE+path, data=data, method=method, headers={\"Content-Type\":\"application/json\"})\n    try:\n        with urllib.request.urlopen(r, timeout=5) as resp:\n            return resp.status, json.loads(resp.read().decode())\n    except urllib.error.HTTPError as e:\n        return e.code, json.loads(e.read().decode())\nfor mode, threshold, expected in [(\"gt\",5,[6]),(\"lt\",5,[1]),(\"gte\",5,[5,6]),(\"lte\",5,[1,5]),(\"eq\",5,[5]),(\"ne\",5,[1,6])]:\n    st, b = req(\"POST\",\"/pipelines/execute\", {\"name\":\"p\",\"input\":{\"data\":[1,5,6]},\"steps\":[{\"name\":\"f\",\"type\":\"filter\",\"config\":{\"mode\":mode,\"threshold\":threshold},\"dependencies\":[]}]})\n    print(mode, b[\"steps\"][0][\"output\"][\"data\"], \"expected\", expected)\nPY\n"]
