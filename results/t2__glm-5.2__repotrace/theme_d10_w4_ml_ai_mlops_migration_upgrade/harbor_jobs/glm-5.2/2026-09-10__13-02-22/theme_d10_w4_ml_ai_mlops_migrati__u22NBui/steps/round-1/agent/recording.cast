[145.410308, "o", "   316\t\r\n   317\tfunc writeJSON(w http.ResponseWriter, status int, data interface{}) {\r\n   318\t\tw.Header().Set(\"Content-Type\", \"application/json\")\r\n   319\t\tw.WriteHeader(status)\r\n   320\t\tjson.NewEncoder(w).Encode(data)\r\n   321\t}\r\n   322\t\r\n   323\tfunc writeError(w http.ResponseWriter, status int, format string, args ...interface{}) {\r\n   324\t\tw.Header().Set(\"Content-Type\", \"application/json\")\r\n"]
