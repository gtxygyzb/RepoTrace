[4899.57164, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/experiment/experiment.go')\ns = p.read_text()\n\nif '\"strings\"' not in s:\n    s = s.replace('import (\\n', 'import (\\n\\t\"strings\"\\n', 1)\n\nold = '''\\t\\t\\tfor _, r := range exp.Runs {\n\\t\\t\\t\\t_ = r\n\\t\\t\\t\\tt.runCounter++\n\\t\\t\\t}\n'''\nnew = '''\\t\\t\\tfor _, r := range exp.Runs {\n\\t\\t\\t\\tif num, err := strconv.Atoi(strings.TrimPrefix(r.ID, \"run_\")); err == nil && num > t.runCounter {\n\\t\\t\\t\\t\\tt.runCounter = num\n\\t\\t\\t\\t}\n\\t\\t\\t}\n'''\nif old not in s:\n    raise SystemExit('loadAll counter block not found')\ns = s.replace(old, new)\n\nif '\"strconv\"' not in s:\n    s = s.replace('\"strings\"', '\"strings\"\\n\\t\"strconv\"', 1)\n\np.write_text(s)\nPY\ngofmt -w internal/experiment/experiment.go\ngo build ./...\ngo test ./...\n"]
