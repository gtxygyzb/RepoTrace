[252.186729, "o", "     1\tpackage pipeline\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"time\"\r\n     6\t)\r\n     7\t"]
[252.186819, "o", "\r\n     8\t// StepType identifies the kind of processing a pipeline step performs.\r\n     9\ttype StepType string\r\n    10\t\r\n    11\tconst (\r\n    12\t\tStepTransform StepType = \"transform\"\r\n    13\t\tStepValidate  StepType = \"validate\"\r\n    14\t\tStepAggregate StepType = \"aggregate\"\r\n    15\t\tStepExport    StepType = \"export\"\r\n    16\t\tStepFilter    StepType = \"filter\"\r\n    17\t)\r\n    18\t\r\n    19\t// Step defines a single unit of work in a pipeline.\r\n"]
[252.186916, "o", "    20\ttype Step struct {\r\n    21\t\tName         string                 `json:\"name\"`\r\n    22\t\tType         StepType               `json:\"type\"`\r\n    23\t\tConfig       map[string]interface{} `json:\"config\"`\r\n    24\t\tDependencies []string               `json:\"dependencies\"`\r\n    25\t}\r\n"]
[252.186988, "o", "    26\t\r\n    27\t// Pipeline defines a named sequence of dependent steps.\r\n    28\ttype Pipeline struct {\r\n    29\t\tName  string  `json:\"name\"`\r\n    30\t\tSteps []*Step `json:\"steps\"`\r\n    31\t}\r\n    32\t\r\n    33\t// StepResult records the outcome of executing a single step.\r\n    34\ttype StepResult struct {\r\n    35\t\tStepName   string                 `json:\"step_name\"`\r\n    36\t\tStepType   StepType               `json:\"step_type\"`\r\n    37\t\tStatus     string                 `json:\"status\"`\r\n    38\t\tOutput     map[string]interface{} `json:\"output,omitempty\"`\r\n    39\t\tError      string                 `json:\"error,omitempty\"`\r\n    40\t\t"]
[252.187051, "o", "DurationMs float64                `json:\"duration_ms\"`\r\n    41\t}\r\n    42\t\r\n    43\t// PipelineResult records the outcome of executing an entire pipeline.\r\n    44\ttype PipelineResult struct {\r\n    45\t\tPipelineName string        `json:\"pipeline_name\"`\r\n    46\t\tStatus       string        `json:\"status\"`\r\n    47\t\tSteps        []*StepResult `json:\"steps\"`\r\n    48\t\tTotalTimeMs  float64       `json:\"total_time_ms\"`\r\n    49\t}\r\n    50\t\r\n"]
[252.187112, "o", "    51\t// Engine executes pipelines by resolving step dependencies and running each step.\r\n    52\ttype Engine struct {\r\n    53\t\tstepExecutors map[StepType]StepExecutor\r\n    54\t}\r\n    55\t\r\n    56\t// StepExecutor is the function signature for executing a pipeline step.\r\n    57\ttype StepExecutor func(config, input map[string]interface{}) (map[string]interface{}, error)\r\n    58\t\r\n    59\t// NewEngine creates a pipeline engine with built-in step executors.\r\n"]
[252.187172, "o", "    60\tfunc NewEngine() *Engine {\r\n    61\t\te := &Engine{\r\n    62\t\t\tstepExecutors: make(map[StepType]StepExecutor),\r\n    63\t\t}\r\n    64\t\te.stepExecutors[StepTransform] = ExecuteTransform\r\n    65\t\te.stepExecutors[StepValidate] = ExecuteValidate\r\n    66\t\te.stepExecutors[StepAggregate] = ExecuteAggregate\r\n    67\t\te.stepExecutors[StepExport] = ExecuteExport\r\n    68\t\te.stepExecutors[StepFilter] = ExecuteFilter\r\n"]
[252.187233, "o", "    69\t\treturn e\r\n    70\t}\r\n    71\t\r\n    72\t// Execute runs a pipeline with the given initial input data.\r\n    73\tfunc (e *Engine) Execute(p *Pipeline, initialInput map[string]interface{}) (*PipelineResult, error) {\r\n    74\t\tordered, err := topologicalSort(p.Steps)\r\n    75\t\tif err != nil {\r\n    76\t\t\treturn nil, fmt.Errorf(\"dependency resolution failed: %w\", err)\r\n    77\t\t}\r\n    78"]
[252.18729, "o", "\t\r\n    79\t\tpipelineStart := time.Now()\r\n    80\t\tresult := &PipelineResult{\r\n    81\t\t\tPipelineName: p.Name,\r\n    82\t\t\tStatus:       \"success\",\r\n    83\t\t\tSteps:        make([]*StepResult, 0, len(ordered)),\r\n    84\t\t}\r\n    85\t\r\n    86\t\t"]
[252.187351, "o", "stepOutputs := make(map[string]map[string]interface{})\r\n    87\t\tvar lastOutput map[string]interface{}\r\n    88\t\r\n    89\t\tfor _, step := range ordered {\r\n    90\t\t\tstepStart := time.Now()\r\n    91\t\r\n    92\t\t\t// Determine input for this step\r\n    93\t\t\tvar input map[string]interface{}\r\n    94\t\t\t"]
[252.187417, "o", "if len(step.Dependencies) == 0 {\r\n    95\t\t\t\tinput = initialInput\r\n    96\t\t\t} else {\r\n    97\t\t\t\tinput = lastOutput\r\n    98\t\t\t}\r\n    99\t\r\n   100\t\t\t// Find and run the executor\r\n   101\t\t\texecutor, ok := e.stepExecutors[step.Type]\r\n   102\t\t\tif !ok {\r\n"]
[252.187478, "o", "   103\t\t\t\tsr := &StepResult{\r\n   104\t\t\t\t\tStepName:   step.Name,\r\n   105\t\t\t\t\tStepType:   step.Type,\r\n   106\t\t\t\t\tStatus:     \"failed\",\r\n   107\t\t\t\t\tError:      fmt.Sprintf(\"unknown step type: %s\", step.Type),\r\n   108\t\t\t\t\tDurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\r\n"]
[252.187511, "o", "   109\t\t\t\t}\r\n   110\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   111\t\t\t\tresult.Status = \"failed\"\r\n   112\t\t"]
[252.187609, "o", "\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   113\t\t\t\treturn result, nil\r\n   114\t\t\t}\r\n   115\t\r\n   116\t\t\toutput, err := executor(step.Config, input)"]
[252.187676, "o", "\r\n   117\t\t\tduration := float64(time.Since(stepStart).Microseconds()) / 1000.0\r\n   118\t\r\n   119\t\t\tsr := &StepResult{\r\n   120\t\t\t\tStepName:   step.Name,\r\n   121\t\t\t\tStepType:   step.Type,\r\n   122\t\t\t\tDurationMs: duration,\r\n   123\t\t\t}\r\n   124\t\r\n   125\t\t\tif err != nil {\r\n   126\t\t\t\tsr.Status = \"failed\"\r\n   127\t\t\t\tsr.Error = err.Error()\r\n   128\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   129\t\t\t\tresult.Status = \"failed\"\r\n   130\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n"]
[252.187735, "o", "   131\t\t\t\treturn result, nil\r\n   132\t\t\t}\r\n   133\t\r\n   134\t\t\tsr.Status = \"success\"\r\n   135\t\t\tsr.Output = output\r\n   136\t\t\tresult.Steps = append(result.Steps, sr)\r\n   137\t\r\n   138\t\t\tstepOutputs[step.Name] = output\r\n   139\t\t\tlastOutput = output\r\n   140\t\t}\r\n"]
[252.187797, "o", "   141\t\r\n   142\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   143\t\treturn result, nil\r\n   144\t}\r\n   145\t\r\n   146\t// topologicalSort orders steps so that dependencies are executed first.\r\n   147\t// Returns an error if a cycle is detected.\r\n   148\tfunc topologicalSort(steps []*Step) ([]*Step, error) {\r\n   149\t\tstepMap := make(map[string]*Step)\r\n"]
[252.187865, "o", "   150\t\tinDegree := make(map[string]int)\r\n   151\t\r\n   152\t\tfor _, s := range steps {\r\n   153\t\t\tstepMap[s.Name] = s\r\n   154\t\t\tinDegree[s.Name] = 0\r\n   155\t\t}\r\n   156\t\r\n   157\t\t// Build in-degree counts\r\n   158\t\tfor _, s := range steps {\r\n"]
[252.187925, "o", "   159\t\t\tfor _, dep := range s.Dependencies {\r\n   160\t\t\t\tif _, ok := stepMap[dep]; !ok {\r\n   161\t\t\t\t\treturn nil, fmt.Errorf(\"step %q depends on unknown step %q\", s.Name, dep)\r\n   162\t\t\t\t}\r\n   163\t\t\t\tinDegree[s.Name]++\r\n   164\t\t\t}\r\n   165\t\t}\r\n   166\t\r\n   167\t\t"]
[252.187985, "o", "// Kahn's algorithm\r\n   168\t\tvar queue []*Step\r\n   169\t\tfor _, s := range steps {\r\n   170\t\t\tif inDegree[s.Name] == 0 {\r\n   171\t\t\t\tqueue = append(queue, s)\r\n   172\t\t\t}\r\n   173\t\t}\r\n   174\t\r\n   175\t\t"]
[252.188042, "o", "var ordered []*Step\r\n   176\t\tfor len(queue) > 0 {\r\n   177\t\t\tcurrent := queue[0]\r\n   178\t\t\tqueue = queue[1:]\r\n   179\t\t\tordered = append(ordered, current)\r\n   180\t\r\n"]
