[4624.417905, "o", "\u001b[?2004h> "]
[4624.417941, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[4624.417987, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[4624.418031, "o", "\u001b[?2004h> "]
[4624.418076, "o", "\\tif deps == nil {\r\n\u001b[?2004l\r"]
