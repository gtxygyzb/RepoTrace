[6956.310917, "o", "func (h *Handlers) WarmupModel(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[6956.310976, "o", "\u001b[?2004h> "]
[6956.311088, "o", "\\tname := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
