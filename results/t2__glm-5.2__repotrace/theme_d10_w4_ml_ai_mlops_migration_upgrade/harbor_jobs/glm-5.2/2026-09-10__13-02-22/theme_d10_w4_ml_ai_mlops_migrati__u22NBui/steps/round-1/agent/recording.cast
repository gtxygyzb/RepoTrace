[5848.949394, "o", "\u001b[35m\u001b[Kinternal/api/router.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// NewRouter builds the HTTP route table and returns a handler.\r\n\u001b[35m\u001b[Kinternal/api/router.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc NewRouter(reg *registry.Registry, eng *pipeline.Engine, tracker *experiment.Tracker, srv *serving.Server) http.Handler {\r\n\u001b[35m\u001b[Kinternal/api/router.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\th := &Handlers{\r\n\u001b[35m\u001b[Kinternal/api/router.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tRegistry:   reg,\r\n\u001b[35m\u001b[Kinternal/api/router.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tPipeline:   eng,\r\n\u001b[35m\u001b[Kinternal/api/router.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tExperiment: tracker,\r\n\u001b[35m\u001b[Kinternal/api/router.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tServing:    srv,\r\n\u001b[35m\u001b[Kinternal/api/router.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tTemplates:  NewTemplateStore(),\r\n\u001b[35m\u001b[Kinternal/api/router.go\u001b[m\u001b[K\u001b[3"]
