[4820.818544, "o", "\t\treturn\r\n\t}\r\n\r\n\tstart := time.Now()\r\n\tresults := make([]map[string]interface{}, 0, len(req.Requests))\r\n\tsucceeded := 0\r\n\tfailed := 0\r\n\tskipped := 0\r\n\tstop := false\r\n\r\n\tfor i, ir := range req.Requests {\r\n\t\tif stop {\r\n\t\t\tresults = append(results, map[string]interface{}{\r\n\t\t\t\t\"model_name\": ir.ModelName,\r\n"]
