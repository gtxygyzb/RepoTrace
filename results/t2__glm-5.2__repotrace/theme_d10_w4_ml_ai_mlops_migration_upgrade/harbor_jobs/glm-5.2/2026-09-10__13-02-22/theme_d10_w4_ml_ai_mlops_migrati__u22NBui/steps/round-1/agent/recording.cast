[2520.529952, "o", "        s = s.replace('\"gomlops/internal/pipeline\"', '\"gomlops/internal/experiment\"\\n\\t\"gomlops/internal/pipeline\"')\r\n\u001b[?2004l\r"]
[2520.53001, "o", "\u001b[?2004h> "]
[2520.530065, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2520.53043, "o", "        s = s.replace('import (\\n', 'import (\\n\\t\"gomlops/internal/experiment\"\\n', 1)\r\n\u001b[?2004l\r"]
[2520.530488, "o", "\u001b[?2004h> "]
[2520.530541, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
