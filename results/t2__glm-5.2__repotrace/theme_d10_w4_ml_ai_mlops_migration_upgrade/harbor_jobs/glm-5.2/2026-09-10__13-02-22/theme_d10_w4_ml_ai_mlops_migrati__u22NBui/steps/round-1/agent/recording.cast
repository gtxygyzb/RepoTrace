[4680.60219, "o", "new = '''// executeWithRetryAndTimeout runs an executor with optional retry and timeout.\r\n\u001b[?2004l\r"]
[4680.602237, "o", "\u001b[?2004h> "]
[4680.603215, "o", "func (e *Engine) executeWithRetryAndTimeout(executor StepExecutor, config, input map[string]interface{}, retry, timeoutMs int) (map[string]interface{}, error, int, bool) {\r\n\u001b[?2004l\r"]
[4680.603266, "o", "\u001b[?2004h> "]
[4680.60343, "o", "\\tmaxAttempts := retry + 1\r\n\u001b[?2004l\r"]
[4680.603477, "o", "\u001b[?2004h> "]
[4680.603621, "o", "\\tif maxAttempts < 1 {\r\n\u001b[?2004l\r"]
[4680.603668, "o", "\u001b[?2004h> "]
[4680.603791, "o", "\\t\\tmaxAttempts = 1\r\n\u001b[?2004l\r"]
[4680.603837, "o", "\u001b[?2004h> "]
[4680.603899, "o", "\\t}\r\n\u001b[?2004l\r"]
[4680.603946, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4680.603993, "o", "\u001b[?2004h"]
[4680.604038, "o", "> "]
[4680.60416, "o", "\\tdeadline := time.Time{}\r\n\u001b[?2004l\r"]
[4680.604208, "o", "\u001b[?2004h> "]
[4680.604338, "o", "\\tif timeoutMs > 0 {\r\n\u001b[?2004l\r"]
[4680.604385, "o", "\u001b[?2004h> "]
[4680.604815, "o", "\\t\\tdeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\r\n\u001b[?2004l\r"]
[4680.604877, "o", "\u001b[?2004h> "]
[4680.604924, "o", "\\t}\r\n\u001b[?2004l\r"]
[4680.604971, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4680.605017, "o", "\u001b[?2004h> "]
[4680.605234, "o", "\\tvar output map[string]interface{}\r\n\u001b[?2004l\r"]
[4680.605281, "o", "\u001b[?2004h> "]
[4680.605384, "o", "\\tvar err error\r\n\u001b[?2004l\r"]
[4680.60543, "o", "\u001b[?2004h> "]
[4680.605748, "o", "\\tfor attempt := 0; attempt < maxAttempts; attempt++ {\r\n\u001b[?2004l\r"]
[4680.605795, "o", "\u001b[?2004h> "]
[4680.605986, "o", "\\t\\ttype execResult struct {\r\n\u001b[?2004l\r"]
[4680.606034, "o", "\u001b[?2004h> "]
[4680.606249, "o", "\\t\\t\\toutput map[string]interface{}\r\n\u001b[?2004l\r"]
[4680.606313, "o", "\u001b[?2004h> "]
[4680.606417, "o", "\\t\\t\\terr    error\r\n\u001b[?2004l\r"]
[4680.606484, "o", "\u001b[?2004h> "]
[4680.60654, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4680.606595, "o", "> "]
[4680.606799, "o", "\\t\\tresChan := make(chan execResult, 1)\r\n\u001b[?2004l\r"]
[4680.606846, "o", "\u001b[?2004h> "]
[4680.606964, "o", "\\t\\tgo func() {\r\n\u001b[?2004l\r"]
[4680.607012, "o", "\u001b[?2004h> "]
[4680.607248, "o", "\\t\\t\\tout, e := executor(config, input)\r\n\u001b[?2004l\r"]
[4680.607312, "o", "\u001b[?2004h> "]
[4680.607581, "o", "\\t\\t\\tresChan <- execResult{output: out, err: e}\r\n\u001b[?2004l\r"]
[4680.607644, "o", "\u001b[?2004h> "]
[4680.607709, "o", "\\t\\t}()\r\n\u001b[?2004l\r"]
[4680.607765, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4680.60782, "o", "\u001b[?2004h> "]
[4680.607955, "o", "\\t\\tif timeoutMs > 0 {\r\n\u001b[?2004l\r"]
[4680.608001, "o", "\u001b[?2004h> "]
[4680.608238, "o", "\\t\\t\\tremaining := time.Until(deadline)\r\n\u001b[?2004l\r"]
[4680.608289, "o", "\u001b[?2004h> "]
[4680.608447, "o", "\\t\\t\\tif remaining <= 0 {\r\n\u001b[?2004l\r"]
[4680.608515, "o", "\u001b[?2004h> "]
