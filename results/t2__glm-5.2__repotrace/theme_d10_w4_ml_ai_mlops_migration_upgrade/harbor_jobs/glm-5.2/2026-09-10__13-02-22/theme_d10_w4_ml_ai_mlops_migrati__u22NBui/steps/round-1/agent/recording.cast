[3971.518656, "o", "   688\t\t\t\twriteError(w, http.StatusNotFound, \"experiment %q not found\", name)\r\n   689\t\t\t\treturn\r\n   690\t\t\t}\r\n   691\t\r\n   692\t\t\tvar values []float64\r\n   693\t\t\tfor _, run := range exp.Runs {\r\n   694\t\t\t\tif value, ok := run.Metrics[metric]; ok {\r\n   695\t\t\t\t\tvalues = append(values, value)\r\n"]
[3971.518712, "o", "   696\t\t\t\t}\r\n   697\t\t\t}\r\n   698\t\t\tif len(values) == 0 {\r\n   699\t\t\t\tcontinue\r\n   700\t\t\t}\r\n   701\t\r\n   702\t\t\tsum := 0.0\r\n   703\t\t\tminVal := values[0]\r\n"]
[3971.518772, "o", "   704\t\t\tmaxVal := values[0]\r\n   705\t\t\tfor _, value := range values {\r\n   706\t\t\t\tsum += value\r\n   707\t\t\t\tif value < minVal {\r\n   708\t\t\t\t\tminVal = value\r\n   709\t\t\t\t}\r\n   710\t\t\t\tif value > maxVal {\r\n   711\t\t\t\t\tmaxVal = value\r\n   712"]
[3971.518828, "o", "\t\t\t\t}\r\n   713\t\t\t}\r\n   714\t\t\tmean := sum / float64(len(values))\r\n   715\t\t\tentries = append(entries, experimentComparisonEntry{\r\n   716\t\t\t\tName:  name,\r\n   717\t\t\t\tMean:  mean,\r\n   718\t\t\t\tMin:   minVal,\r\n"]
[3971.518892, "o", "   719\t\t\t\tMax:   maxVal,\r\n   720\t\t\t\tCount: len(values),\r\n   721\t\t\t})\r\n   722\t\t\tmeans = append(means, mean)\r\n   723\t\t\ttotalRuns += len(values)\r\n   724\t\t\tif len(entries) == 1 || mean > bestMean {\r\n   725\t\t\t\tbest = name\r\n"]
[3971.518949, "o", "   726\t\t\t\tbestMean = mean\r\n   727\t\t\t}\r\n   728\t\t}\r\n   729\t\r\n   730\t\tif len(entries) == 0 {\r\n   731\t\t\twriteError(w, http.StatusBadRequest, \"no data found for metric %q across specified experiments\", metric)\r\n   732\t\t\treturn\r\n"]
[3971.519006, "o", "   733\t\t}\r\n   734\t\r\n   735\t\tspread := 0.0\r\n   736\t\tif len(means) > 0 {\r\n   737\t\t\tminMean := means[0]\r\n   738\t\t\tmaxMean := means[0]\r\n   739\t\t\tfor _, mean := range means {\r\n   740\t\t\t\tif mean < minMean {\r\n"]
[3971.519068, "o", "   741\t\t\t\t\tminMean = mean\r\n   742\t\t\t\t}\r\n   743\t\t\t\tif mean > maxMean {\r\n   744\t\t\t\t\tmaxMean = mean\r\n   745\t\t\t\t}\r\n   746\t\t\t}\r\n   747\t\t\tspread = maxMean - minMean\r\n   748\t\t}\r\n   749\t\r\n   750\t\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n   751\t\t\t\"metric\":      metric,\r\n"]
[3971.519127, "o", "   752\t\t\t\"experiments\": entries,\r\n   753\t\t\t\"best\":        best,\r\n   754\t\t\t\"summary\": map[string]interface{}{\r\n   755\t\t\t\t\"spread\":           spread,\r\n   756\t\t\t\t\"experiment_count\": len(entries),\r\n   757\t\t\t\t\"total_runs\":       totalRuns,\r\n   758\t\t\t},\r\n   759\t\t})\r\n"]
[3971.519187, "o", "   760\t}\r\n"]
