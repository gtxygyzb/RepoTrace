[172.472492, "o", "\t}\r\n\twriteJSON(w, http.StatusCreated, exp)\r\n}\r\n\r\nfunc (h *Handlers) ListExperiments(w http.ResponseWriter, r *http.Request) {\r\n\texps := h.Experiment.ListExperiments()\r\n\twriteJSON(w, http.StatusOK, exps)\r\n}\r\n\r\nfunc (h *Handlers) GetExperiment(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\texp, err := h.Experiment.GetExperiment(name)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, exp)"]
[172.472569, "o", "\r\n}\r\n\r\nfunc (h *Handlers) LogRun(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\r\n\tvar req struct {\r\n\t\tParameters map[string]float64 `json:\"parameters\"`\r\n\t\tMetrics    map[string]float64 `json:\"metrics\"`\r\n\t\tTags       map[string]string  `json:\"tags\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\t"]
[172.472631, "o", "return\r\n\t}\r\n\r\n\trun, err := h.Experiment.LogRun(expName, req.Parameters, req.Metrics, req.Tags)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, run)\r\n"]
[172.472692, "o", "}\r\n\r\nfunc (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\tmetricName := r.PathValue(\"metric\")\r\n\taggType := r.URL.Query().Get(\"type\")\r\n\tweightParam := r.URL.Query().Get(\"weight_param\")\r\n\r\n\tif aggType == \"\" {\r\n"]
[172.472752, "o", "\t\twriteError(w, http.StatusBadRequest, \"query parameter 'type' is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tresult, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\r\n\texp, _ := h.Experiment.GetExperiment(expName)\r\n\trunCount := 0\r\n\tif exp != nil {\r\n"]
[172.472814, "o", "\t\trunCount = len(exp.Runs)\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\t\t\"experiment\": expName,\r\n\t\t\"metric\":     metricName,\r\n\t\t\"type\":       aggType,\r\n\t\t\"value\":      result,\r\n\t\t\"count\":      runCount,\r\n\t})\r\n}\r\n"]
[172.472902, "o", "\r\n// --- Serving Handlers ---\r\n\r\nfunc (h *Handlers) LoadModel(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tModelName  string `json:\"model_name\"`\r\n\t\tVersionNum int    `json:\"version_num\"`\r\n\t\tStage      string `json:\"stage\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}"]
[172.472961, "o", "\r\n\tif req.ModelName == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"model_name is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tif err := h.Serving.LoadModel(req.ModelName, req.VersionNum, req.Stage); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n"]
[172.473027, "o", "\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"loaded\"})\r\n}\r\n\r\nfunc (h *Handlers) UnloadModel(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\tif err := h.Serving.UnloadModel(name); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"unloaded\"})\r\n}\r\n\r\nfunc (h *Handlers) ListLoadedModels(w http.ResponseWriter, r *http.Request) {\r\n"]
[172.473094, "o", "\tmodels := h.Serving.ListLoaded()\r\n\twriteJSON(w, http.StatusOK, models)\r\n}\r\n\r\nfunc (h *Handlers) Infer(w http.ResponseWriter, r *http.Request) {\r\n\t"]
[172.473201, "o", "var req serving.InferenceRequest\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.ModelName == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"model_name is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tresp, err := h.Serving.Infer(&req)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, resp)\r\n}\r\n\r\n// --- Helpers ---\r\n\r\nfunc writeJSON(w http.ResponseWriter, status int, data interface{}) {\r\n\tw.Header().Set(\"Content-Type\", \"application/json\")\r\n"]
[172.473261, "o", "\tw.WriteHeader(status)\r\n\tjson.NewEncoder(w).Encode(data)\r\n}\r\n\r\nfunc writeError(w http.ResponseWriter, status int, format string, args ...interface{}) {\r\n\tw.Header().Set(\"Content-Type\", \"application/json\")\r\n\tw.WriteHeader(status)\r\n\tmsg := fmt.Sprintf(format, args...)\r\n\tjson.NewEncoder(w).Encode(map[string]string{\"error\": msg})\r\n}\r\n"]
