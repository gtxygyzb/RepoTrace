[6388.014632, "o", ") ([]float64, error) {\r\n\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KpolynomialPredict(config map[string]interface{}, input []float64) ([]float64, error) {\r\n"]
