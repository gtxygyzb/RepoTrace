[409.617582, "o", "s = s.replace(\r\n\u001b[?2004l\r"]
[409.617638, "o", "\u001b[?2004h> "]
[409.618331, "o", "\"\"\"func (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, error) {\r\n\u001b[?2004l\r"]
[409.61839, "o", "\u001b[?2004h> "]
[409.618467, "o", "\\tt.mu.RLock()\r\n\u001b[?2004l\r"]
[409.618524, "o", "\u001b[?2004h> "]
[409.618653, "o", "\\tdefer t.mu.RUnlock()\r\n\u001b[?2004l\r"]
[409.61871, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[409.618765, "o", "\u001b[?2004h> "]
[409.61904, "o", "\\texp, exists := t.experiments[experimentName]\r\n\u001b[?2004l\r"]
[409.619099, "o", "\u001b[?2004h> "]
[409.619174, "o", "\\tif !exists {\r\n\u001b[?2004l\r"]
[409.61923, "o", "\u001b[?2004h> "]
[409.619523, "o", "\\t\\treturn 0, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\u001b[?2004l\r"]
[409.619583, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[409.619643, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.619767, "o", "\\tif len(exp.Runs) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.619822, "o", "> "]
[409.620083, "o", "\\t\\treturn 0, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n\u001b[?2004l\r"]
[409.620141, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.620195, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.620302, "o", "\\tvar values []float64\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.620356, "o", "> "]
[409.620425, "o", "\\tvar weights []float64\r\n\u001b[?2004l\r"]
[409.62048, "o", "\u001b[?2004h> "]
[409.620595, "o", "\\tfor _, run := range exp.Runs {\r\n\u001b[?2004l\r"]
[409.62065, "o", "\u001b[?2004h> "]
[409.620842, "o", "\\t\\tvalues = append(values, run.Metrics[metricName])\r\n\u001b[?2004l\r"]
[409.620913, "o", "\u001b[?2004h> "]
[409.620989, "o", "\\t\\tif weightParam != \"\" {\r\n\u001b[?2004l\r"]
[409.621043, "o", "\u001b[?2004h> "]
[409.621271, "o", "\\t\\t\\tweights = append(weights, run.Parameters[weightParam])\r\n\u001b[?2004l\r"]
[409.621326, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[409.621382, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[409.621437, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h> "]
[409.62155, "o", "\\tif len(values) == 0 {\r\n\u001b[?2004l\r"]
[409.621604, "o", "\u001b[?2004h> "]
[409.621884, "o", "\\t\\treturn 0, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.62194, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.621995, "o", "> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[409.622078, "o", "\\tswitch aggType {\r\n\u001b[?2004l\r"]
[409.622132, "o", "\u001b[?2004h> "]
[409.6222, "o", "\\tcase \"mean\":\r\n\u001b[?2004l\r"]
[409.622262, "o", "\u001b[?2004h> "]
[409.622321, "o", "\\t\\tsum := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.622458, "o", "\\t\\tfor _, v := range values {\r\n\u001b[?2004l\r"]
[409.622512, "o", "\u001b[?2004h> "]
[409.622575, "o", "\\t\\t\\tsum += v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.62263, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.622695, "o", "> "]
[409.622833, "o", "\\t\\treturn sum / float64(len(values)), nil\r\n\u001b[?2004l\r"]
[409.622895, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[409.62298, "o", "\\tcase \"median\":\r\n\u001b[?2004l\r"]
[409.623036, "o", "\u001b[?2004h> "]
[409.623146, "o", "\\t\\tsorted := sortedCopy(values)\r\n\u001b[?2004l\r"]
[409.623202, "o", "\u001b[?2004h> "]
[409.623265, "o", "\\t\\tn := len(sorted)\r\n\u001b[?2004l\r\"\u001b[?2004h"]
[409.623319, "o", "> "]
[409.623387, "o", "\\t\\tif n%2 == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.623605, "o", "\\t\\t\\treturn (sorted[n/2-1] + sorted[n/2]) / 2, nil\r\n\u001b[?2004l\r"]
[409.62366, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\rs"]
[409.623717, "o", "\u001b[?2004h> "]
[409.623821, "o", "\\t\\treturn sorted[n/2], nil\r\n\u001b[?2004l\r"]
[409.623884, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[409.623943, "o", "> "]
[409.623999, "o", "\\tcase \"p95\":\r\n\u001b[?2004l\rm\u001b[?2004h> "]
[409.624127, "o", "\\t\\tsorted := sortedCopy(values)\r\n\u001b[?2004l\r"]
[409.624182, "o", "\u001b[?2004h> "]
[409.62432, "o", "\\t\\treturn percentile(sorted, 0.95), nil\r\n\u001b[?2004l\r"]
[409.624375, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[409.624451, "o", "\\tcase \"p99\":\r\n\u001b[?2004l\r"]
[409.624507, "o", "\u001b[?2004h> "]
[409.624617, "o", "\\t\\tsorted := sortedCopy(values)\r\n\u001b[?2004l\r"]
[409.624673, "o", "\u001b[?2004h> "]
[409.624823, "o", "\\t\\treturn percentile(sorted, 0.99), nil\r\n\u001b[?2004l\r"]
[409.624895, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[409.625006, "o", "\\tcase \"weighted_mean\":\r\n\u001b[?2004l\r"]
[409.625061, "o", "\u001b[?2004h> "]
[409.625265, "o", "\\t\\tif len(weights) == 0 || len(weights) != len(values) {\r\n\u001b[?2004l\r"]
[409.62532, "o", "\u001b[?2004h> "]
[409.625578, "o", "\\t\\t\\treturn 0, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\n\u001b[?2004l\r"]
[409.625633, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[409.625693, "o", "\u001b[?2004h> "]
[409.625773, "o", "\\t\\tweightedSum := 0.0\r\n\u001b[?2004l\r"]
[409.625828, "o", "\u001b[?2004h> "]
[409.625939, "o", "\\t\\tfor i, v := range values {\r\n\u001b[?2004l\r"]
[409.625996, "o", "\u001b[?2004h> "]
[409.626119, "o", "\\t\\t\\tweightedSum += v * weights[i]\r\n\u001b[?2004l\r"]
[409.626174, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[409.626228, "o", "\u001b[?2004h> "]
[409.626422, "o", "\\t\\treturn weightedSum / float64(len(values)), nil\r\n\u001b[?2004l\r"]
[409.626478, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.626547, "o", "\\tdefault:\r\n\u001b[?2004l\r"]
[409.626602, "o", "\u001b[?2004h> "]
[409.626837, "o", "\\t\\treturn 0, fmt.Errorf(\"unknown aggregation type %q\", aggType)\r\n\u001b[?2004l\r"]
[409.626902, "o", "\u001b[?2004h> "]
[409.626959, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> }\"\"\",\r\n\u001b[?2004l\r"]
[409.627015, "o", "\u001b[?2004h> "]
[409.627453, "o", "\"\"\"func (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, int, error) {\r\n\u001b[?2004l\r"]
[409.62751, "o", "\u001b[?2004h> "]
[409.627566, "o", "\\tt.mu.RLock()\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.627622, "o", "> "]
[409.627682, "o", "\\tdefer t.mu.RUnlock()\r\n\u001b[?2004l\r"]
[409.627738, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[409.62797, "o", "\\texp, exists := t.experiments[experimentName]\r\n\u001b[?2004l\r"]
[409.628026, "o", "\u001b[?2004h> "]
[409.628083, "o", "\\tif !exists {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.62839, "o", "\\t\\treturn 0, 0, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\u001b[?2004l\r"]
[409.628447, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.628504, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.628586, "o", "\\tif len(exp.Runs) == 0 {\r\n\u001b[?2004l\r"]
[409.628642, "o", "\u001b[?2004h> "]
[409.628856, "o", "\\t\\treturn 0, 0, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n\u001b[?2004l\r"]
[409.628912, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.628967, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.629049, "o", "\\tvar values []float64\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.629104, "o", "> "]
[409.629162, "o", "\\tvar weights []float64\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.629222, "o", "> "]
[409.629294, "o", "\\tfor _, run := range exp.Runs {\r\n\u001b[?2004l\r"]
[409.629351, "o", "\u001b[?2004h> "]
[409.62946, "o", "\\t\\tvalue, ok := run.Metrics[metricName]\r\n\u001b[?2004l\r"]
[409.629515, "o", "\u001b[?2004h> "]
[409.62957, "o", "\\t\\tif !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.62963, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.629692, "o", "> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.629821, "o", "\\t\\tvalues = append(values, value)\r\n\u001b[?2004l\r"]
[409.629882, "o", "\u001b[?2004h> "]
[409.629976, "o", "\\t\\tif aggType == \"weighted_mean\" {\r\n\u001b[?2004l\r"]
[409.630031, "o", "\u001b[?2004h> "]
[409.630162, "o", "\\t\\t\\tweight, ok := run.Parameters[weightParam]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.63022, "o", "\\t\\t\\tif !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.630278, "o", "\\t\\t\\t\\tcontinue\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.630333, "o", "> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.630421, "o", "\\t\\t\\tweights = append(weights, weight)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.630476, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[409.630531, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.630594, "o", "\\tif len(values) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.630756, "o", "\\t\\treturn 0, 0, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.630812, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.630879, "o", "\\tswitch aggType {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.630946, "o", "\\tcase \"mean\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631001, "o", "\\t\\tsum := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631072, "o", "\\t\\tfor _, v := range values {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631126, "o", "\\t\\t\\tsum += v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631181, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631298, "o", "\\t\\treturn sum / float64(len(values)), len(values), nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631352, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631407, "o", "\\tcase \"median\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631473, "o", "\\t\\tsorted := sortedCopy(values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631537, "o", "\\t\\tn := len(sorted)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631596, "o", "\\t\\tif n%2 == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631748, "o", "\\t\\t\\treturn (sorted[n/2-1] + sorted[n/2]) / 2, len(values), nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631803, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631896, "o", "\\t\\treturn sorted[n/2], len(values), nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.631953, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \\tcase \"p95\":\r\n\u001b[?2004l\r"]
[409.632008, "o", "\u001b[?2004h> "]
[409.632071, "o", "\\t\\tsorted := sortedCopy(values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.632191, "o", "\\t\\treturn percentile(sorted, 0.95), len(values), nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.632246, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.632305, "o", "\\tcase \"p99\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.632368, "o", "\\t\\tsorted := sortedCopy(values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[409.632481, "o", "\\t\\treturn percentile(sorted, 0.99), len(values), nil\r\n\u001b[?2004l\r"]
