[3724.107444, "o", "   320\tfunc shouldSkipStep(config map[string]interface{}, variables map[string]float64) (bool, error) {\r\n   321\t\tcond, ok := config[\"skip_condition\"]\r\n   322\t\tif !ok {\r\n   323\t\t\treturn false, nil\r\n   324\t\t}\r\n   325"]
[3724.107558, "o", "\t\tc, ok := cond.(map[string]interface{})\r\n   326\t\tif !ok {\r\n   327\t\t\treturn false, fmt.Errorf(\"skip_condition must be an object\")\r\n   328\t\t}\r\n   329\t\tvarName, ok := c[\"var\"].(string)\r\n"]
[3724.10763, "o", "   330\t\tif !ok || varName == \"\" {\r\n   331\t\t\treturn false, fmt.Errorf(\"skip_condition requires a var name\")\r\n   332\t\t}\r\n   333\t\tval, exists := variables[varName]\r\n   334\t\tif !exists {\r\n   335\t\t\treturn false, nil\r\n   336\t\t}\r\n   337\t\top, _ := c[\"op\"].(string)\r\n   338\t\tthreshold, err := toFloat(c[\"threshold\"])\r\n   339\t\tif err != nil {\r\n   340\t\t\treturn false, fmt.Errorf(\"skip_condition invalid threshold: %w\", err)\r\n   341\t\t}\r\n   342\t\tswitch op {\r\n   343\t\tcase \"gt\":\r\n   344\t\t\treturn val > threshold, nil\r\n   345\t\tcase \"lt\":\r\n   346\t"]
[3724.107703, "o", "\t\treturn val < threshold, nil\r\n   347\t\tcase \"eq\":\r\n   348\t\t\treturn val == threshold, nil\r\n   349\t\tcase \"gte\":\r\n   350\t\t\treturn val >= threshold, nil\r\n   351\t\tcase \"lte\":\r\n   352\t\t\treturn val <= threshold, nil\r\n   353\t\tcase \"ne\":\r\n   354\t"]
[3724.107768, "o", "\t\treturn val != threshold, nil\r\n   355\t\tdefault:\r\n   356\t\t\treturn false, fmt.Errorf(\"skip_condition unsupported operator %q\", op)\r\n   357\t\t}\r\n   358\t}\r\n   359\t\r\n   360\t// topologicalSort orders steps so that dependencies are executed first.\r\n   361\t// Returns an error if a cycle is detected.\r\n   362\tfunc topologicalSort(steps []*Step) ([]*Step, error) {\r\n   363\t\tstepMap := make(map[string]*Step)\r\n   364\t\tinDegree := make(map[string]int)\r\n"]
[3724.107831, "o", "   365\t\r\n   366\t\tfor _, s := range steps {\r\n   367\t\t\tstepMap[s.Name] = s\r\n   368\t\t\tinDegree[s.Name] = 0\r\n   369\t\t}\r\n   370\t\r\n"]
[3724.108418, "o", "\u001b[?2004h"]
[3724.108475, "o", "root@n30009:/app# "]
[3729.391623, "i", "nl -ba internal/pipeline/engine.go | sed -n '360,415p'\n"]
[3729.392111, "o", "nl -ba internal/pipeline/engine.go | sed -n '360,415p'\r\n\u001b[?2004l\r"]
[3729.395938, "o", "   360\t// topologicalSort orders steps so that dependencies are executed first.\r\n   361\t// Returns an error if a cycle is detected.\r\n   362\tfunc topologicalSort(steps []*Step) ([]*Step, error) {\r\n   363\t\tstepMap := make(map[string]*Step)\r\n   364\t\tinDegree := make(map[string]int)\r\n"]
[3729.396046, "o", "   365\t\r\n   366\t\tfor _, s := range steps {\r\n   367\t\t\tstepMap[s.Name] = s\r\n   368\t\t\tinDegree[s.Name] = 0\r\n   369\t\t}\r\n   370\t\r\n   371\t\t// Build in-degree counts\r\n   372\t\tfor _, s := range steps {\r\n   373\t\t\tfor _, dep := range s.Dependencies {\r\n   374\t\t\t\tif _, ok := stepMap[dep]; !ok {\r\n   375\t\t\t\t\treturn nil, fmt.Errorf(\"step %q depends on unknown step %q\", s.Name, dep)\r\n   376\t\t\t\t}\r\n   377\t\t\t\tinDegree[s.Name]++\r\n   378\t\t\t}\r\n   379\t\t}\r\n"]
[3729.396133, "o", "   380\t\r\n   381\t\t// Initialize queue with steps that have no dependencies\r\n   382\t\tqueue := make([]*Step, 0)\r\n   383\t\tfor _, s := range steps {\r\n   384\t\t\tif inDegree[s.Name] == 0 {\r\n"]
[3729.396196, "o", "   385\t\t\t\tqueue = append(queue, s)\r\n   386\t\t\t}\r\n   387\t\t}\r\n   388\t\r\n   389\t\t// Process steps in topological order\r\n   390\t\tordered := make([]*Step, 0, len(steps))\r\n   391\t\tfor len(queue) > 0 {\r\n   392\t\t\tcurrent := queue[0]\r\n   393\t\t\tqueue = queue[1:]\r\n   394\t\t\tordered = append(ordered, current)\r\n   395\t\r\n"]
[3729.396263, "o", "   396\t\t\t// Find steps that depend on current\r\n   397\t\t\tfor _, s := range steps {\r\n   398\t\t\t\tfor _, dep := range s.Dependencies {\r\n   399\t\t\t\t\tif dep == current.Name {\r\n   400\t\t\t\t\t\tinDegree[s.Name]--\r\n   401\t\t\t\t\t\tif inDegree[s.Name] == 0 {\r\n   402\t\t\t\t\t\t\t"]
[3729.396322, "o", "queue = append(queue, s)\r\n   403\t\t\t\t\t\t}\r\n   404\t\t\t\t\t}\r\n"]
[3729.396378, "o", "   405\t\t\t\t}\r\n   406\t\t\t}\r\n   407\t\t}\r\n   408\t\r\n   409\t\tif len(ordered) != len(steps) {\r\n   410\t\t\treturn nil, fmt.Errorf(\"cycle detected in pipeline dependencies\")\r\n"]
[3729.396441, "o", "   411\t\t}\r\n   412\t\r\n   413\t\treturn ordered, nil\r\n   414\t}\r\n   415\t\r\n"]
[3729.397029, "o", "\u001b[?2004h"]
[3729.397093, "o", "root@n30009:/app# "]
[3746.348782, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/pipeline/engine.go')\ns = p.read_text()\nold = '''\\tordered, err := topologicalSort(p.Steps)\n\\tif err != nil {\n\\t\\tresult.Valid = false\n\\t\\tresult.Errors = append(result.Errors, \"dependency cycle detected\")\n\\t}'''\nnew = '''\\tordered, err := topologicalSort(p.Steps)\n\\tif err != nil {\n\\t\\tresult.Valid = false\n\\t\\tif strings.Contains(err.Error(), \"cycle\") {\n\\t\\t\\tresult.Errors = append(result.Errors, \"dependency cycle detected\")\n\\t\\t}\n\\t}'''\nif old not in s:\n    raise SystemExit('Validate topologicalSort block not found')\ns = s.replace(old, new)\np.write_text(s)\nPY\ngofmt -w internal/pipeline/engine.go\ngo build ./...\n"]
