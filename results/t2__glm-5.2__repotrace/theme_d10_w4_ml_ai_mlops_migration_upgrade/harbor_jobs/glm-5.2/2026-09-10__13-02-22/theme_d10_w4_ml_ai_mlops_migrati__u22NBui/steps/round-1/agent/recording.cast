[1999.217544, "o", "package api\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"net/http\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n"]
[1999.217662, "o", "\t\"strings\"\r\n\t\"sync\"\r\n\t\"time\"\r\n\r\n\t\"gomlops/internal/pipeline\"\r\n)\r\n\r\ntype TemplateParameter struct {\r\n\tName    string      `json:\"name\"`\r\n\tType    string      `json:\"type\"`\r\n\tDefault interface{} `json:\"default,omitempty\"`\r\n}\r\n\r\ntype Template struct {\r\n\tName        string              `json:\"name\"`\r\n\tDescription string              `json:\"description\"`\r\n\tParameters  []TemplateParameter `json:\"parameters\"`\r\n\tPipeline    *pipeline.Pipeline  `json:\"pipeline\"`\r\n\tCreatedAt   time.Time           `json:\"created_at\"`\r\n\tUpdatedAt   *time.Time          `json:\"updated_at\"`\r\n}\r\n"]
[1999.217742, "o", "\r\ntype TemplateStore struct {\r\n\tmu        sync.RWMutex\r\n\ttemplates map[string]*Template\r\n}\r\n\r\nfunc NewTemplateStore() *TemplateStore {\r\n\treturn &TemplateStore{templates: make(map[string]*Template)}\r\n}\r\n\r\nvar templateNameRe = regexp.MustCompile(`^[a-zA-Z0-9_-]+$`)\r\n\r\nfunc validateTemplateName(name string) bool {\r\n\treturn len(name) > 0 && len(name) <= 64 && templateNameRe.MatchString(name)\r\n}\r\n\r\nfunc (s *TemplateStore) Get(name string) (*Template, bool) {\r\n\ts.mu.RLock()\r\n\t"]
[1999.217805, "o", "defer s.mu.RUnlock()\r\n\tt, ok := s.templates[name]\r\n\treturn t, ok\r\n}\r\n\r\nfunc (s *TemplateStore) List(sortBy string) []*Template {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\tresult := make([]*Template, 0, len(s.templates))\r\n\tfor _, t := range s.templates {\r\n\t\tresult = append(result, t)\r\n"]
[1999.217877, "o", "\t}\r\n\tif sortBy == \"created_at\" {\r\n\t\tsort.Slice(result, func(i, j int) bool {\r\n\t\t\treturn result[i].CreatedAt.Before(result[j].CreatedAt)\r\n\t\t})\r\n\t} else {\r\n\t\tsort.Slice(result, func(i, j int) bool {\r\n\t\t\t"]
[1999.217941, "o", "return result[i].Name < result[j].Name\r\n\t\t})\r\n\t}\r\n\treturn result\r\n}\r\n\r\nfunc (s *TemplateStore) Create(t *Template) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\tif _, exists := s.templates[t.Name]; exists {\r\n\t\treturn fmt.Errorf(\"template %q already exists\", t.Name)\r\n\t}\r\n\tt.CreatedAt = time.Now()\r\n"]
[1999.218008, "o", "\tt.UpdatedAt = nil\r\n\ts.templates[t.Name] = t\r\n\treturn nil\r\n}\r\n\r\nfunc (s *TemplateStore) Update(t *Template) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\tif _, exists := s.templates[t.Name]; !exists {\r\n\t\treturn fmt.Errorf(\"template %q not found\", t.Name)\r\n\t}\r\n\tnow := time.Now()\r\n"]
[1999.218071, "o", "\tt.UpdatedAt = &now\r\n\ts.templates[t.Name] = t\r\n\treturn nil\r\n}\r\n\r\nfunc (s *TemplateStore) Delete(name string) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\tif _, exists := s.templates[name]; !exists {\r\n\t\treturn fmt.Errorf(\"template %q not found\", name)\r\n\t}\r\n\t"]
[1999.218133, "o", "delete(s.templates, name)\r\n\treturn nil\r\n}\r\n\r\nfunc (h *Handlers) CreateTemplate(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tName        string              `json:\"name\"`\r\n\t\tDescription string              `json:\"description\"`\r\n\t\tParameters  []TemplateParameter `json:\"parameters\"`\r\n\t\tPipeline    *pipeline.Pipeline  `json:\"pipeline\"`\r\n\t}\r\n"]
[1999.218205, "o", "\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif !validateTemplateName(req.Name) {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid template name\")\r\n\t\t"]
[1999.218269, "o", "return\r\n\t}\r\n\tif req.Pipeline == nil || len(req.Pipeline.Steps) == 0 {\r\n\t\twriteError(w, http.StatusBadRequest, \"pipeline with at least one step is required\")\r\n\t\treturn\r\n\t}\r\n\tparams := req.Parameters\r\n\tif params == nil {\r\n\t\tparams = []TemplateParameter{}\r\n\t}\r\n\tif err := validateParameters(params); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n"]
[1999.218328, "o", "\ttmpl := &Template{\r\n\t\tName:        req.Name,\r\n\t\tDescription: req.Description,\r\n\t\tParameters:  params,\r\n\t\tPipeline:    req.Pipeline,\r\n\t}\r\n\tif err := h.Templates.Create(tmpl); err != nil {\r\n\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n"]
[1999.2184, "o", "\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, templateResponse(tmpl))\r\n}\r\n\r\nfunc (h *Handlers) ListTemplates(w http.ResponseWriter, r *http.Request) {\r\n\tsortBy := r.URL.Query().Get(\"sort\")\r\n\twriteJSON(w, http.StatusOK, templateListResponse(h.Templates.List(sortBy)))\r\n}\r\n\r\nfunc (h *Handlers) GetTemplate(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n"]
[1999.218465, "o", "\ttmpl, ok := h.Templates.Get(name)\r\n\tif !ok {\r\n\t\twriteError(w, http.StatusNotFound, \"template %q not found\", name)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, templateResponse(tmpl))\r\n}\r\n\r\nfunc (h *Handlers) UpdateTemplate(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\t"]
[1999.218525, "o", "tmpl, ok := h.Templates.Get(name)\r\n\tif !ok {\r\n\t\twriteError(w, http.StatusNotFound, \"template %q not found\", name)\r\n\t\treturn\r\n\t}\r\n\tvar req struct {\r\n\t\tDescription *string              `json:\"description\"`\r\n\t\tParameters  *[]TemplateParameter `json:\"parameters\"`\r\n\t\tPipeline    *pipeline.Pipeline   `json:\"pipeline\"`\r\n"]
[1999.218585, "o", "\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tupdated := &Template{\r\n\t\tName:        tmpl.Name,\r\n\t\tDescription: tmpl.Description,\r\n\t\tParameters:  tmpl.Parameters,\r\n\t\tPipeline:    tmpl.Pipeline,"]
[1999.21865, "o", "\r\n\t\tCreatedAt:   tmpl.CreatedAt,\r\n\t}\r\n\tif req.Description != nil {\r\n\t\tupdated.Description = *req.Description\r\n\t}\r\n"]
[1999.218713, "o", "\tif req.Parameters != nil {\r\n\t\tif err := validateParameters(*req.Parameters); err != nil {\r\n\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\t\treturn\r\n\t\t}\r\n\t\tupdated.Parameters = *req.Parameters\r\n\t}\r\n\tif req.Pipeline != nil {\r\n\t\tif len(req.Pipeline.Steps) == 0 {\r\n\t\t\twriteError(w, http.StatusBadRequest, \"pipeline with at least one step is required\")\r\n\t\t\treturn\r\n\t\t}\r\n\t\tupdated.Pipeline = req.Pipeline\r\n\t}\r\n\tif err := h.Templates.Update(updated); err != nil {\r\n"]
[1999.218777, "o", "\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, templateResponse(updated))\r\n}\r\n\r\nfunc (h *Handlers) DeleteTemplate(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\tif err := h.Templates.Delete(name); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n"]
[1999.218846, "o", "\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n}\r\n\r\nfunc (h *Handlers) ExecuteTemplate(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\ttmpl, ok := h.Templates.Get(name)\r\n"]
[1999.21893, "o", "\tif !ok {\r\n\t\twriteError(w, http.StatusNotFound, \"template %q not found\", name)\r\n\t\treturn\r\n\t}\r\n\tvar req struct {\r\n\t\tInput  map[string]interface{} `json:\"input\"`\r\n\t\tParams map[string]interface{} `json:\"params\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\t"]
[1999.219007, "o", "p, err := substituteParameters(tmpl, req.Params)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Input == nil {\r\n\t\treq.Input = make(map[string]interface{})\r\n\t}\r\n\tresult, err := h.Pipeline.Execute(p, req.Input)\r\n"]
