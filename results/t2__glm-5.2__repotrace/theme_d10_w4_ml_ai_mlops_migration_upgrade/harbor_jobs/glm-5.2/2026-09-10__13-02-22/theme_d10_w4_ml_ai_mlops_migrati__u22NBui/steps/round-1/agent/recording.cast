[5785.775364, "o", "   478\tfunc (h *Handlers) LoadModel(w http.ResponseWriter, r *http.Request) {\r\n   479\t\tvar req struct {\r\n   480\t\t\tModelName  string `json:\"model_name\"`\r\n   481\t\t\tVersionNum int    `json:\"version_num\"`\r\n"]
[5785.775503, "o", "   482\t\t\tStage      string `json:\"stage\"`\r\n   483\t\t}\r\n   484\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n"]
[5785.775598, "o", "   485\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n   486\t\t\treturn\r\n   487\t\t}\r\n   488\t\tif req.ModelName == \"\" {\r\n   489\t\t\twriteError(w, http.StatusBadRequest, \"model_name is required\")\r\n   490\t\t\treturn\r\n   491\t\t}\r\n   492\t\r\n   493\t\tif err := h.Serving.LoadModel(req.ModelName, req.VersionNum, req.Stage); err != nil {\r\n   494\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n   495\t\t\treturn\r\n   496\t\t}\r\n   497\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"loaded\"})\r\n   498\t}\r\n   499\t\r\n   500\tfunc (h *Handlers) UnloadModel(w http.ResponseWriter, r *http.Request) {\r\n   501\t\tname := r.PathValue(\"name\")\r\n   502\t\tif err := h.Serving.UnloadModel(name); err != nil {\r\n   503\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   504\t\t\treturn\r\n   505\t\t}\r\n   506\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"unloaded\"})\r\n   507\t}\r\n   508\t\r\n   509\tfunc (h *Handlers) ListLoadedModels(w http.ResponseWriter, r *http.Request) {\r\n   510\t\tmodels := h.Serving.ListLoaded()\r\n   511\t\t"]
[5785.775727, "o", "writeJSON(w, http.StatusOK, models)\r\n   512\t}\r\n   513\t\r\n   514\tfunc (h *Handlers) Infer(w http.ResponseWriter, r *http.Request) {\r\n   515\t\tvar req serving.InferenceRequest\r\n   516\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n   517\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n   518\t\t\treturn\r\n   519\t\t}\r\n   520\t\tif req.ModelName == \"\" {\r\n   521\t\t\th.Serving.RecordRequest(req.ModelName, false, 0)\r\n   522\t\t\twriteError(w, http.StatusBadRequest, \"model_name is required\")\r\n   523\t\t\treturn\r\n   524\t\t}\r\n   525\t\r\n   526\t\tresp, err := h.Serving.Infer(&req)\r\n   527\t\tif err != nil {\r\n   528\t\t\th.Serving.RecordRequest(req.ModelName, false, 0)\r\n   529\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   530\t\t\treturn\r\n   531\t\t}\r\n"]
[5785.775886, "o", "   532\t\th.Serving.RecordRequest(req.ModelName, true, resp.LatencyMs)\r\n   533\t\twriteJSON(w, http.StatusOK, resp)\r\n   534\t}\r\n   535\t\r\n   536\t// --- Model Version Annotation Handlers ---\r\n   537\t\r\n   538\tfunc (h *Handlers) AddAnnotation(w http.ResponseWriter, r *http.Request) {\r\n   539\t\tmodelName := r.PathValue(\"name\")\r\n   540\t\tnumStr := r.PathValue(\"num\")\r\n   541\t\tnum, err := strconv.Atoi(numStr)\r\n   542\t\tif err != nil {\r\n   543\t\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n   544\t\t\treturn\r\n   545\t\t}\r\n   546\t\r\n   547\t\tvar req struct {\r\n   548\t\t\tKey   string `json:\"key\"`\r\n   549\t\t\tValue string `json:\"value\"`\r\n   550\t\t}\r\n   551\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n"]
[5785.776032, "o", "   552\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n   553\t\t\treturn\r\n   554\t\t}\r\n   555\t\tif !registry.ValidateAnnotationKey(req.Key) {\r\n   556\t\t\twriteError(w, http.StatusBadRequest, \"annotation key must contain only letters, digits, and underscores\")\r\n   557\t\t\treturn\r\n   558\t\t}\r\n   559\t\r\n   560\t\tannotation, err := h.Registry.AddAnnotation(modelName, num, req.Key, req.Value)\r\n   561\t\tif err != nil {\r\n   562\t\t\tif strings.Contains(err.Error(), \"not found\") {\r\n   563\t\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   564\t\t\t} else if strings.Contains(err.Error(), \"already exists\") {\r\n   565\t\t\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n   566\t\t\t} else {\r\n   567\t\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n   568\t\t\t}\r\n   569\t\t\treturn\r\n   570\t\t}\r\n   571\t\twriteJSON(w, http.StatusCreated, annotation)\r\n   572\t}\r\n   573\t\r\n"]
