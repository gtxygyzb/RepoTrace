[2066.474085, "o", "   193\t\tstepMap := make(map[string]*Step)\r\n   194\t\tinDegree := make(map[string]int)\r\n   195\t\r\n   196\t\tfor _, s := range steps {\r\n   197\t\t\tstepMap[s.Name] = s\r\n   198\t\t\tinDegree[s.Name] = 0\r\n   199\t\t}\r\n   200\t\r\n   201\t\t// Build in-degree counts\r\n   202"]
[2066.474144, "o", "\t\tfor _, s := range steps {\r\n   203\t\t\tfor _, dep := range s.Dependencies {\r\n   204\t\t\t\tif _, ok := stepMap[dep]; !ok {\r\n   205\t\t\t\t\treturn nil, fmt.Errorf(\"step %q depends on unknown step %q\", s.Name, dep)\r\n   206\t\t\t\t}\r\n   207\t\t\t\tinDegree[s.Name]++\r\n   208\t\t\t}\r\n   209\t\t"]
[2066.4742, "o", "}\r\n   210\t\r\n   211\t\t// Initialize queue with steps that have no dependencies\r\n   212\t\tqueue := make([]*Step, 0)\r\n   213\t\tfor _, s := range steps {\r\n   214\t\t\tif inDegree[s.Name] == 0 {\r\n   215\t\t\t\tqueue = append(queue, s)\r\n   216\t\t\t}\r\n"]
