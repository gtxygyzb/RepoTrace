[1442.619903, "o", "type StepType string\r\n\u001b[?2004l\r"]
[1442.619954, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1442.620006, "o", "\u001b[?2004h> "]
[1442.620077, "o", "const (\r\n\u001b[?2004l\r"]
[1442.620128, "o", "\u001b[?2004h> "]
[1442.620205, "o", "\u0007"]
[1442.62049, "o", "StepTransform StepType = \"transform\"\r\n\u001b[?2004l\r"]
[1442.620541, "o", "\u001b[?2004h> "]
[1442.620613, "o", "\u0007"]
[1442.620912, "o", "StepValidate  StepType = \"validate\"\r\n\u001b[?2004l\r"]
[1442.620961, "o", "\u001b[?2004h> "]
[1442.621043, "o", "\u0007"]
[1442.621295, "o", "StepAggregate StepType = \"aggregate\"\r\n\u001b[?2004l\r"]
[1442.621344, "o", "\u001b[?2004h> "]
[1442.621419, "o", "\u0007"]
[1442.62165, "o", "StepExport    StepType = \"export\"\r\n\u001b[?2004l\r"]
[1442.621699, "o", "\u001b[?2004h> "]
[1442.62177, "o", "\u0007"]
[1442.622014, "o", "StepFilter    StepType = \"filter\"\r\n\u001b[?2004l\r"]
[1442.622061, "o", "\u001b[?2004h"]
[1442.622108, "o", "> )\r\n\u001b[?2004l\r"]
[1442.622154, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1442.622201, "o", "\u001b[?2004h"]
[1442.622252, "o", "> "]
[1442.622593, "o", "// Step defines a single unit of work in a pipeline.\r\n\u001b[?2004l\r"]
[1442.622641, "o", "\u001b[?2004h> "]
[1442.622787, "o", "type Step struct {\r\n\u001b[?2004l\r"]
