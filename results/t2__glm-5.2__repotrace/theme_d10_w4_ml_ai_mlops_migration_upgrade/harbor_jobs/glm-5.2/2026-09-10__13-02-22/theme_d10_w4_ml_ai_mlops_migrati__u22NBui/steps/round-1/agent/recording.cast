[1201.96348, "o", "\r\n   243\t\t\tif !entry.IsDir() && filepath.Ext(entry.Name()) == \".json\" {\r\n   244\t\t\t\tdata, err := os.ReadFile(filepath.Join(t.dataDir, entry.Name()))\r\n   245\t\t\t\tif err != nil {\r\n   246\t\t\t\t\tcontinue\r\n   247\t\t\t\t}\r\n   248\t"]
[1201.963545, "o", "\t\t\tvar exp Experiment\r\n   249\t\t\t\tif err := json.Unmarshal(data, &exp); err != nil {\r\n   250\t\t\t\t\tcontinue\r\n   251\t\t\t\t}\r\n   252\t\t\t\tt.experiments[exp.Name] = &exp\r\n   253\t\t\t\tfor _, r := range exp.Runs {\r\n   254\t\t\t\t\t_ = r\r\n   255\t\t\t\t\tt.runCounter++\r\n   256\t\t\t\t}\r\n   257\t\t\t}\r\n   258\t\t}\r\n   259\t}\r\n   260\t\r\n   261\tfunc (t *Tracker) saveExperiment(exp *Experiment) error {\r\n"]
[1201.963615, "o", "   262\t\tdata, err := json.MarshalIndent(exp, \"\", \"  \")\r\n   263\t\tif err != nil {\r\n   264\t\t\treturn err\r\n   265\t\t}\r\n   266\t\tfilename := filepath.Join(t.dataDir, exp.Name+\".json\")\r\n   267\t\treturn os.WriteFile(filename, data, 0644)\r\n   268\t}\r\n"]
