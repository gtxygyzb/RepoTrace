[2988.805988, "o", "   125\t// AggregateMetric computes an aggregate statistic for a given metric across all runs\r\n   126\t// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.\r\n   127\t// For weighted_mean, weightParam specifies which parameter to use as weight.\r\n   128\t"]
[2988.806094, "o", "func (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string, tagFilters map[string]string) (float64, int, []string, error) {\r\n   129\t\tt.mu.RLock()\r\n   130\t\tdefer t.mu.RUnlock()\r\n   131\t\r\n   132\t\texp, exists := t.experiments[experimentName]\r\n   133\t\tif !exists {\r\n   134\t\t\treturn 0, 0, nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   135\t\t}\r\n   136\t\r\n   137\t\tif len(exp.Runs) == 0 {\r\n   138\t\t\treturn 0, 0, nil, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n   139\t\t}\r\n   140\t\r\n   141\t\tvar values []float64\r\n   142\t\tvar weights []float64\r\n   143\t\tvar runIDs []string\r\n"]
[2988.806162, "o", "   144\t\tfor _, run := range exp.Runs {\r\n   145\t\t\tif !matchTags(run.Tags, tagFilters) {\r\n   146\t\t\t\tcontinue\r\n   147\t\t\t}\r\n   148\t\t\tvalue, ok := run.Metrics[metricName]\r\n   149\t\t\tif !ok {\r\n   150\t\t\t\tcontinue\r\n   151\t\t\t}\r\n"]
[2988.806257, "o", "   152\t\t\tif aggType == \"weighted_mean\" {\r\n   153\t\t\t\tweight, ok := run.Metrics[weightParam]\r\n   154\t\t\t\tif !ok {\r\n   155\t\t\t\t\tcontinue\r\n   156\t\t\t\t}\r\n   157\t\t\t\tvalues = append(values, value)\r\n   158\t\t"]
