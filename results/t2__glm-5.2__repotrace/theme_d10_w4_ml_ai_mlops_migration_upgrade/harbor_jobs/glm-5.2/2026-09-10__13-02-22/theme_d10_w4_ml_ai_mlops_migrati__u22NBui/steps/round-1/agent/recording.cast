[5714.176558, "o", "   174\t// PromoteVersion transitions a model version to the specified stage.\r\n   175\tfunc (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {\r\n   176\t\tr.mu.Lock()\r\n   177\t\tdefer r.mu.Unlock()\r\n   178\t\r\n   179\t\tmodel, exists := r.models[modelName]\r\n   180\t\tif !exists {\r\n   181\t\t\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n   182\t\t}\r\n   183\t\r\n   184\t\tvar version *Version\r\n   185\t\tfor _, v := range model.Versions {\r\n   186\t\t\tif v.Number == versionNum {\r\n   187\t\t\t\tversion = v\r\n   188\t\t\t\tbreak\r\n   189\t\t\t}\r\n   190\t\t}\r\n   191\t\tif version == nil {\r\n   192\t\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n   193\t\t}\r\n   194\t\r\n"]
