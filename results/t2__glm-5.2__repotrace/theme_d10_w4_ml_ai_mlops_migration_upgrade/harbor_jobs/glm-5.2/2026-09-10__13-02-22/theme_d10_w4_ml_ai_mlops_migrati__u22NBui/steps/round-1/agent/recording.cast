[2520.622025, "o", "\u001b[?2004hroot@n30009:/app# "]
[2520.790295, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/api/router.go')\ns = p.read_text()\nold = 'mux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/aggregate\", h.AggregateMetric)'\nnew = '''mux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/aggregate\", h.AggregateMetric)\n\\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/history\", h.GetMetricHistory)\n\\tmux.HandleFunc(\"PUT /api/v1/experiments/{name}/runs/{id}\", h.UpdateRun)\n\\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs/search\", h.SearchRuns)'''\nif old not in s:\n    raise SystemExit('aggregate route not found')\np.write_text(s.replace(old, new))\nPY\n"]
[2520.790512, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[2520.79061, "o", "\u001b[?2004h> "]
[2520.790771, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[2520.790849, "o", "\u001b[?2004h> "]
[2520.791093, "o", "p = Path('internal/api/router.go')\r\n\u001b[?2004l\r"]
[2520.791152, "o", "\u001b[?2004h> "]
[2520.791256, "o", "s = p.read_text()\r\n\u001b[?2004l\r"]
[2520.791313, "o", "\u001b[?2004h> "]
[2520.7919, "o", "old = 'mux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/aggregate\", h.AggregateMetric)'\r\n\u001b[?2004l\r"]
[2520.79196, "o", "\u001b[?2004h> "]
[2520.792547, "o", "new = '''mux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/aggregate\", h.AggregateMetric)\r\n\u001b[?2004l\r"]
[2520.792628, "o", "\u001b[?2004h> "]
[2520.793138, "o", "\\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/history\", h.GetMetricHistory)\r\n\u001b[?2004l\r"]
[2520.793204, "o", "\u001b[?2004h> "]
[2520.793606, "o", "\\tmux.HandleFunc(\"PUT /api/v1/experiments/{name}/runs/{id}\", h.UpdateRun)\r\n\u001b[?2004l\r"]
[2520.793674, "o", "\u001b[?2004h> "]
[2520.794136, "o", "\\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs/search\", h.SearchRuns)'''\r\n\u001b[?2004l\r"]
[2520.794195, "o", "\u001b[?2004h> "]
[2520.79429, "o", "if old not in s:\r\n\u001b[?2004l\r"]
[2520.794348, "o", "\u001b[?2004h> "]
[2520.794641, "o", "    raise SystemExit('aggregate route not found')\r\n\u001b[?2004l\r"]
[2520.794698, "o", "\u001b[?2004h> "]
[2520.794909, "o", "p.write_text(s.replace(old, new))\r\n\u001b[?2004l\r"]
[2520.794968, "o", "\u001b[?2004h> "]
[2520.795025, "o", "PY\r\n\u001b[?2004l\r"]
[2520.838753, "o", "\u001b[?2004h"]
