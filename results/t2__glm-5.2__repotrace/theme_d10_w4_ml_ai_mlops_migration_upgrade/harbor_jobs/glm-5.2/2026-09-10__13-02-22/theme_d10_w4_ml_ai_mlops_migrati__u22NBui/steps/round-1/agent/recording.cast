[2055.359577, "o", "   123\t\t\tif !ok {\r\n   124\t\t\t\tsr := &StepResult{\r\n   125\t\t\t\t\tStepName:   step.Name,\r\n   126\t\t\t\t\tStepType:   step.Type,\r\n   127\t\t\t\t\tStatus:     \"failed\",\r\n   128\t\t\t\t\tError:      fmt.Sprintf(\"unknown step type: %s\", step.Type),\r\n   129\t\t\t\t\tDurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\r\n   130\t\t\t\t}\r\n   131\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   132\t\t\t\tresult.Status = \"failed\"\r\n   133\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   134\t\t\t\treturn result, nil\r\n   135\t\t\t}\r\n   136\t\r\n   137\t\t\toutput, err := executor(resolvedConfig, input)\r\n   138\t\t\tduration := float64(time.Since(stepStart).Microseconds()) / 1000.0\r\n   139\t\r\n   140\t\t\tsr := &StepResult{\r\n   141\t\t\t\tStepName:   step.Name,\r\n   142\t\t\t\tStepType:   step.Type,\r\n   143\t\t\t\tDurationMs: duration,\r\n   144"]
