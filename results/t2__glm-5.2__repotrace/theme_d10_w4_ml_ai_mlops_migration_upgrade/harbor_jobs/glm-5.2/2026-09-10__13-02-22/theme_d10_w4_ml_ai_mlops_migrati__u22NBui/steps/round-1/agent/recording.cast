[2041.262477, "o", "package pipeline\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"sort\"\r\n)\r\n\r\n"]
[2041.262562, "o", "// ExecuteTransform applies a data transformation.\r\n// Supported modes: scale, offset, normalize, identity, clip, log.\r\nfunc ExecuteTransform(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"transform: missing or invalid 'data' field in input\")\r\n\t}\r\n\r\n\tmode, _ := config[\"mode\"].(string)\r\n\tif mode == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"transform: missing 'mode' in config\")\r\n\t}\r\n\r\n\tresult := make([]interface{}, len(data))\r\n"]
[2041.262643, "o", "\r\n\tswitch mode {\r\n\tcase \"scale\":\r\n\t\tfactor, _ := config[\"factor\"].(float64)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n"]
[2041.262716, "o", "\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform scale: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t\t\tresult[i] = val * factor\r\n\t\t}\r\n\r\n\tcase \"offset\":\r\n\t\toffset, _ := config[\"offset\"].(float64)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform offset: element %d: %w\", i, err)\r\n\t\t\t}\r\n"]
[2041.262781, "o", "\t\t\tresult[i] = val + offset\r\n\t\t}\r\n\r\n\tcase \"normalize\":\r\n\t\tif len(data) == 0 {\r\n\t\t\treturn map[string]interface{}{\"data\": result}, nil\r\n\t\t}\r\n\t\tminVal, maxVal := findMinMax(data)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform normalize: element %d: %w\", i, err)\r\n\t\t\t}\r\n"]
[2041.26284, "o", "\t\t\tif maxVal == minVal {\r\n\t\t\t\tresult[i] = 0.5\r\n\t\t\t} else {\r\n\t\t\t\tresult[i] = (val - minVal) / (maxVal - minVal)\r\n\t\t\t}\r\n\t\t}\r\n\r\n\tcase \"identity\":\r\n\t\tcopy(result, data)\r\n\r\n"]
[2041.262965, "o", "\tcase \"clip\":\r\n\t\tlow, _ := config[\"low\"].(float64)\r\n\t\thigh, _ := config[\"high\"].(float64)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform clip: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t\t\tif val < low {\r\n\t\t\t\tval = low\r\n\t\t\t}\r\n\t\t\tif val > high {\r\n"]
[2041.263033, "o", "\t\t\t\tval = high\r\n\t\t\t}\r\n\t\t\tresult[i] = val\r\n\t\t}\r\n"]
[2041.263611, "o", "\u001b[?2004h"]
[2041.263664, "o", "root@n30009:/app# "]
[2049.899514, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/pipeline/steps.go')\ns = p.read_text()\nold = '''\\t\\t\\tif maxVal == minVal {\n\\t\\t\\t\\tresult[i] = 0.5\n\\t\\t\\t} else {\n\\t\\t\\t\\tresult[i] = (val - minVal) / (maxVal - minVal)\n\\t\\t\\t}\n'''\nnew = '''\\t\\t\\tif maxVal == minVal {\n\\t\\t\\t\\tresult[i] = 0.0\n\\t\\t\\t} else {\n\\t\\t\\t\\tresult[i] = 2.0*(val-minVal)/(maxVal-minVal) - 1.0\n\\t\\t\\t}\n'''\nif old not in s:\n    raise SystemExit('normalize block not found')\np.write_text(s.replace(old, new))\nPY\n"]
[2049.899771, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
