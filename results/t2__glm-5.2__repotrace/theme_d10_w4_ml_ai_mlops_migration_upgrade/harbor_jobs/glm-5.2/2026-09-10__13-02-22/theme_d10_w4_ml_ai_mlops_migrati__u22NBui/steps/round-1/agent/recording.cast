[2020.149098, "o", "\t\t}\r\n\t}\r\n\r\n\tversion := &Version{\r\n\t\tNumber:      nextNum,\r\n\t\tStage:       StageDevelopment,\r\n\t\t"]
[2020.149294, "o", "Metrics:     metrics,\r\n\t\tTags:        tags,\r\n\t\tModelConfig: modelConfig,\r\n\t\tCreatedAt:   time.Now(),\r\n\t}\r\n\tmodel.Versions = append(model.Versions, version)\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\tif err := r.saveModel(model); err != nil {\r\n\t\tmodel.Versions = model.Versions[:len(model.Versions)-1]\r\n\t\treturn nil, err\r\n\t}\r\n\treturn version, nil\r\n}\r\n\r\n// PromoteVersion transitions a model version to the specified stage.\r\nfunc (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tvar version *Version\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Number == versionNum {\r\n\t\t\tversion = v\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif version == nil {\r\n"]
[2020.149394, "o", "\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n\t}\r\n\r\n\t// Validate stage transition\r\n\tallowed := validTransitions[version.Stage]\r\n\tvalid := false\r\n\tfor _, s := range allowed {\r\n\t\tif s == targetStage {\r\n\t\t\tvalid = true\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif !valid {\r\n\t\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n"]
[2020.149465, "o", "\t}\r\n\r\n\t// If promoting to production, demote current production version\r\n\tif targetStage == StageProduction {\r\n\t\tfor _, v := range model.Versions {\r\n\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n\t\t\t\tv.Stage = StageArchived\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[2020.149539, "o", "\tversion.Stage = targetStage\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\treturn r.saveModel(model)\r\n}\r\n\r\n// GetModel returns a model with its versions sorted by version number descending.\r\nfunc (r *Registry) GetModel(name string) (*Model, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tmodel, exists := r.models[name]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", name)\r\n\t"]
[2020.149605, "o", "}\r\n\r\n\t// Return a copy with versions sorted\r\n\tresult := *model\r\n\tresult.Versions = make([]*Version, len(model.Versions))\r\n\tcopy(result.Versions, model.Versions)\r\n\tsort.Slice(result.Versions, func(i, j int) bool {\r\n\t\treturn result.Versions[i].Number > result.Versions[j].Number\r\n\t})\r\n\treturn &result, nil\r\n}\r\n\r\n"]
[2020.149675, "o", "// ListModels returns all models matching the optional filter.\r\nfunc (r *Registry) ListModels(filter *ModelFilter) ([]*Model, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tvar result []*Model\r\n\tfor _, model := range r.models {\r\n\t\tif filter != nil {\r\n\t\t\tif filter.Framework != \"\" && model.Framework != filter.Framework {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif filter.Tag != \"\" {\r\n"]
[2020.149742, "o", "\t\t\t\thasTag := false\r\n\t\t\t\tfor _, t := range model.Tags {\r\n\t\t\t\t\tif t == filter.Tag {\r\n\t\t\t\t\t\thasTag = true\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tif !hasTag {\r\n\t\t\t\t\tcontinue\r\n"]
