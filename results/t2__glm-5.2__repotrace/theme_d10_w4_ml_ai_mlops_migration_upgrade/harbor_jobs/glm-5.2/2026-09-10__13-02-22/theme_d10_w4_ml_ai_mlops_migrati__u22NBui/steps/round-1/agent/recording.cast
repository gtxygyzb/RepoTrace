[1148.127164, "o", "    22\ttype Run struct {\r\n    23\t\tID         string             `json:\"id\"`\r\n    24\t\tParameters map[string]float64 `json:\"parameters\"`\r\n    25\t\tMetrics    map[string]float64 `json:\"metrics\"`\r\n    26\t\tTags       map[string]string  `json:\"tags\"`\r\n    27\t\tCreatedAt  time.Time          `json:\"created_at\"`\r\n    28\t}\r\n    29\t\r\n"]
[1148.127238, "o", "    30\t// Tracker manages experiments and their runs.\r\n    31\ttype Tracker struct {\r\n    32\t\tmu          sync.RWMutex\r\n    33\t\texperiments map[string]*Experiment\r\n    34\t\tdataDir     string\r\n    35\t\trunCounter  int\r\n    36\t}\r\n    37\t\r\n    38\t// NewTracker creates a new experiment tracker backed by the given data directory.\r\n    39\tfunc NewTracker(dataDir string) *Tracker {\r\n    40\t\tos.MkdirAll(dataDir, 0755)\r\n    41\t\tt := &Tracker{\r\n    42\t\t\texperiments: make(map[string]*Experiment),\r\n    43\t\t\tdataDir:     dataDir,\r\n    44\t\t}\r\n    45\t\tt.loadAll()\r\n    46\t\treturn t\r\n    47\t}\r\n    48\t\r\n    49\t// CreateExperiment creates a new experiment with the given name.\r\n    50\tfunc (t *Tracker) CreateExperiment(name string) (*Experiment, error) {\r\n    51\t\tt.mu.Lock()\r\n    52\t\tdefer t.mu.Unlock()\r\n    53\t\r\n    54\t\tif _, exists := t.experiments[name]; exists {\r\n"]
[1148.127306, "o", "    55\t\t\treturn nil, fmt.Errorf(\"experiment %q already exists\", name)\r\n    56\t\t}\r\n    57\t\r\n    58\t\texp := &Experiment{\r\n    59\t\t\tName:      name,\r\n    60\t\t\tRuns:      make([]*Run, 0),\r\n"]
[1148.127372, "o", "    61\t\t\tCreatedAt: time.Now(),\r\n    62\t\t}\r\n    63\t\tt.experiments[name] = exp\r\n    64\t\tif err := t.saveExperiment(exp); err != nil {\r\n    65\t\t\tdelete(t.experiments, name)\r\n    66\t\t\treturn nil, err\r\n    67\t\t}\r\n    68\t\treturn exp, nil\r\n    69\t}\r\n    70\t\r\n    71\t// LogRun adds a new run to the specified experiment.\r\n    72\tfunc (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {\r\n    73\t\tt.mu.Lock()\r\n    74\t\tdefer t.mu.Unlock()\r\n    75\t\r\n    76\t\texp, exists := t.experiments[experimentName]\r\n    77\t\tif !exists {\r\n    78\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n"]
[1148.127435, "o", "    79\t\t}\r\n    80\t\r\n    81\t\tt.runCounter++\r\n    82\t\trun := &Run{\r\n    83\t\t\tID:         fmt.Sprintf(\"run_%d\", t.runCounter),\r\n    84\t\t\tParameters: params,\r\n    85\t\t\tMetrics:    metrics,\r\n    86\t\t\tTags:       tags,\r\n    87\t\t\tCreatedAt:  time.Now(),\r\n    88\t\t}\r\n    89"]
[1148.127494, "o", "\t\texp.Runs = append(exp.Runs, run)\r\n    90\t\r\n    91\t\tif err := t.saveExperiment(exp); err != nil {\r\n    92\t\t\texp.Runs = exp.Runs[:len(exp.Runs)-1]\r\n    93\t\t\treturn nil, err\r\n    94\t\t}\r\n    95\t\treturn run, nil\r\n    96\t}\r\n"]
