[7166.58983, "o", "new_block = '''func (t *Tracker) DeleteRun(experimentName, runID string) (*Run, error) {\r\n\u001b[?2004l\r"]
[7166.58991, "o", "\u001b[?2004h> "]
[7166.590024, "o", "\\tt.mu.Lock()\r\n\u001b[?2004l\r"]
[7166.59008, "o", "\u001b[?2004h"]
[7166.59014, "o", "> "]
[7166.590245, "o", "\\tdefer t.mu.Unlock()\r\n\u001b[?2004l\r"]
[7166.590314, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\r\n"]
[7166.590376, "o", "\u001b[?2004h> "]
[7166.590682, "o", "\\texp, exists := t.experiments[experimentName]\r\n\u001b[?2004l\r"]
[7166.590748, "o", "\u001b[?2004h> "]
[7166.590872, "o", "\\tif !exists {\r\n\u001b[?2004l\r"]
[7166.590938, "o", "\u001b[?2004h> "]
[7166.591437, "o", "\\t\\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\u001b[?2004l\r"]
[7166.591501, "o", "\u001b[?2004h> "]
[7166.591558, "o", "\\t}\r\n\u001b[?2004l\r"]
[7166.591613, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7166.591669, "o", "\u001b[?2004h> "]
[7166.591928, "o", "\\tfor i, run := range exp.Runs {\r\n\u001b[?2004l\r"]
[7166.591985, "o", "\u001b[?2004h> "]
[7166.592164, "o", "\\t\\tif run.ID == runID {\r\n\u001b[?2004l\r"]
[7166.592221, "o", "\u001b[?2004h> "]
[7166.592424, "o", "\\t\\t\\tdeleted := exp.Runs[i]\r\n\u001b[?2004l\r"]
[7166.592487, "o", "\u001b[?2004h> "]
[7166.592903, "o", "\\t\\t\\texp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)\r\n\u001b[?2004l\r"]
[7166.592961, "o", "\u001b[?2004h> "]
[7166.593318, "o", "\\t\\t\\tif err := t.saveExperiment(exp); err != nil {\r\n\u001b[?2004l\r"]
[7166.593375, "o", "\u001b[?2004h> "]
[7166.59354, "o", "\\t\\t\\t\\treturn nil, err\r\n\u001b[?2004l\r"]
[7166.593594, "o", "\u001b[?2004h> "]
[7166.593668, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[7166.593716, "o", "\u001b[?2004h> "]
[7166.593932, "o", "\\t\\t\\treturn deleted, nil\r\n\u001b[?2004l\r"]
[7166.593991, "o", "\u001b[?2004h> "]
[7166.594043, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[7166.594098, "o", "\u001b[?2004h> "]
[7166.594154, "o", "\\t}\r\n\u001b[?2004l\r"]
[7166.594209, "o", "\u001b[?2004h> "]
[7166.594786, "o", "\\treturn nil, fmt.Errorf(\"run %q not found in experiment %q\", runID, experimentName)\r\n\u001b[?2004l\r"]
[7166.59485, "o", "\u001b[?2004h> }\r\n"]
[7166.59492, "o", "\u001b[?2004l\r\u001b[?2004h"]
[7166.594976, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.595042, "o", "> "]
[7166.595424, "o", "// LeaderboardEntry represents a run in a metric leaderboard.\r\n\u001b[?2004l\r"]
[7166.59548, "o", "\u001b[?2004h> "]
[7166.595695, "o", "type LeaderboardEntry struct {\r\n\u001b[?2004l\r"]
[7166.595758, "o", "\u001b[?2004h> "]
[7166.596098, "o", "\\tRank       int                `json:\"rank\"`\r\n\u001b[?2004l\r"]
[7166.596155, "o", "\u001b[?2004h> "]
[7166.596496, "o", "\\tRunID      string             `json:\"run_id\"`\r\n\u001b[?2004l\r"]
[7166.596552, "o", "\u001b[?2004h> "]
[7166.596812, "o", "\\tValue      float64            `json:\"value\"`\r\n\u001b[?2004l\r"]
[7166.596895, "o", "\u001b[?2004h> "]
[7166.597153, "o", "\\tParameters map[string]float64 `json:\"parameters\"`\r\n\u001b[?2004l\r"]
[7166.597207, "o", "\u001b[?2004h> "]
[7166.597482, "o", "\\tMetrics    map[string]float64 `json:\"metrics\"`\r\n\u001b[?2004l\r"]
[7166.597536, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[7166.597592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7166.597647, "o", "\u001b[?2004h> "]
[7166.597964, "o", "// LeaderboardResult contains the top runs for a metric.\r\n\u001b[?2004l\r"]
[7166.597995, "o", "\u001b[?2004h> "]
[7166.598178, "o", "type LeaderboardResult struct {\r\n\u001b[?2004l\r"]
[7166.598234, "o", "\u001b[?2004h> "]
[7166.59851, "o", "\\tExperiment string             `json:\"experiment\"`\r\n\u001b[?2004l\r"]
[7166.598566, "o", "\u001b[?2004h> "]
[7166.59881, "o", "\\tMetric     string             `json:\"metric\"`\r\n\u001b[?2004l\r"]
[7166.598895, "o", "\u001b[?2004h> "]
[7166.599144, "o", "\\tOrder      string             `json:\"order\"`\r\n\u001b[?2004l\r"]
[7166.599199, "o", "\u001b[?2004h> "]
[7166.599476, "o", "\\tEntries    []LeaderboardEntry `json:\"entries\"`\r\n\u001b[?2004l\r"]
[7166.599532, "o", "\u001b[?2004h> "]
[7166.599828, "o", "\\tTotalRuns  int                `json:\"total_runs\"`\r\n\u001b[?2004l\r"]
[7166.599909, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.599966, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.600438, "o", "// Leaderboard returns the top runs for an experiment ranked by a metric.\r\n\u001b[?2004l\r"]
[7166.600494, "o", "\u001b[?2004h> "]
[7166.601066, "o", "func (t *Tracker) Leaderboard(experimentName, metric, order string, limit int) (*LeaderboardResult, error) {\r\n\u001b[?2004l\r"]
[7166.601125, "o", "\u001b[?2004h> "]
[7166.601205, "o", "\\tif order == \"\" {\r\n\u001b[?2004l\r"]
[7166.601261, "o", "\u001b[?2004h> "]
[7166.601368, "o", "\\t\\torder = \"desc\"\r\n\u001b[?2004l\r"]
[7166.601425, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7166.601482, "o", "\u001b[?2004h> "]
[7166.601704, "o", "\\tif order != \"asc\" && order != \"desc\" {\r\n\u001b[?2004l\r"]
[7166.60176, "o", "\u001b[?2004h> "]
[7166.602119, "o", "\\t\\treturn nil, fmt.Errorf(\"order must be \\\\\"asc\\\\\" or \\\\\"desc\\\\\"\")\r\n\u001b[?2004l\r"]
[7166.602177, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7166.602233, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7166.602289, "o", "\u001b[?2004h> "]
[7166.602361, "o", "\\tt.mu.RLock()\r\n\u001b[?2004l\r"]
[7166.602417, "o", "\u001b[?2004h> "]
[7166.602525, "o", "\\tdefer t.mu.RUnlock()\r\n\u001b[?2004l\r"]
[7166.602579, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7166.602635, "o", "\u001b[?2004h> "]
[7166.602879, "o", "\\texp, exists := t.experiments[experimentName]\r\n\u001b[?2004l\r"]
[7166.602934, "o", "\u001b[?2004h> "]
[7166.603016, "o", "\\tif !exists {\r\n\u001b[?2004l\r"]
[7166.603077, "o", "\u001b[?2004h> "]
[7166.603485, "o", "\\t\\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\u001b[?2004l\r"]
[7166.603539, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7166.603591, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re"]
[7166.603652, "o", "\u001b[?2004h> "]
[7166.603805, "o", "\\ttype candidate struct {\r\n\u001b[?2004l\r"]
[7166.60388, "o", "\u001b[?2004h> "]
[7166.603962, "o", "\\t\\trun   *Run\r\n\u001b[?2004l\r"]
[7166.604017, "o", "\u001b[?2004h> "]
[7166.604105, "o", "\\t\\tvalue float64\r\n\u001b[?2004l\r"]
[7166.604159, "o", "\u001b[?2004h> \\t}\r\n"]
[7166.604219, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[7166.604389, "o", "\\tvar candidates []candidate\r\n\u001b[?2004l\r"]
[7166.604446, "o", "\u001b[?2004h> "]
[7166.604609, "o", "\\tfor _, run := range exp.Runs {\r\n\u001b[?2004l\r"]
[7166.60467, "o", "\u001b[?2004h> "]
[7166.604773, "o", "\\t\\tif run == nil {\r\n\u001b[?2004l\r"]
[7166.604828, "o", "\u001b[?2004h> "]
[7166.604911, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[7166.604967, "o", "\u001b[?2004h> "]
[7166.605022, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.605258, "o", "\\t\\tvalue, ok := run.Metrics[metric]\r\n\u001b[?2004l\r"]
[7166.605311, "o", "\u001b[?2004h> "]
[7166.605379, "o", "\\t\\tif !ok {\r\n\u001b[?2004l\r"]
[7166.605434, "o", "\u001b[?2004h> "]
[7166.605516, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[7166.605571, "o", "\u001b[?2004h> "]
[7166.605627, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.606032, "o", "\\t\\tcandidates = append(candidates, candidate{run: run, value: value})\r\n\u001b[?2004l\r"]
[7166.606088, "o", "\u001b[?2004h> \\t}\r\n"]
[7166.606142, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7166.606197, "o", "\u001b[?2004h> "]
[7166.606477, "o", "\\tsort.Slice(candidates, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[7166.606532, "o", "\u001b[?2004h> "]
[7166.606849, "o", "\\t\\tif candidates[i].value != candidates[j].value {\r\n\u001b[?2004l\r"]
[7166.606919, "o", "\u001b[?2004h> "]
[7166.60705, "o", "\\t\\t\\tif order == \"desc\" {\r\n\u001b[?2004l\r"]
[7166.607077, "o", "\u001b[?2004h"]
[7166.607152, "o", "> "]
[7166.607434, "o", "\\t\\t\\t\\treturn candidates[i].value > candidates[j].value\r\n\u001b[?2004l\r"]
[7166.60749, "o", "\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r"]
[7166.607546, "o", "\u001b[?2004h> "]
[7166.607718, "o", "\\t\\t\\treturn candidates[i].value < candidates[j].value\r\n\u001b[?2004l\r"]
[7166.607773, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[7166.607829, "o", "\u001b[?2004h> "]
[7166.608025, "o", "\\t\\treturn candidates[i].run.ID < candidates[j].run.ID\r\n\u001b[?2004l\r"]
[7166.608082, "o", "\u001b[?2004h> \\t})\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.608141, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.608199, "o", "\\tif limit < 0 {\r\n\u001b[?2004l\r"]
[7166.608252, "o", "\u001b[?2004h> "]
[7166.608316, "o", "\\t\\tlimit = 0\r\n\u001b[?2004l\r"]
[7166.608381, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.608485, "o", "\\tif limit > len(candidates) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.608539, "o", "> "]
[7166.608609, "o", "\\t\\tlimit = len(candidates)\r\n\u001b[?2004l\r"]
[7166.608667, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\rr\u001b[?2004h"]
[7166.608725, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.60889, "o", "\\tentries := make([]LeaderboardEntry, 0, limit)\r\n\u001b[?2004l\r"]
[7166.608945, "o", "\u001b[?2004h> "]
[7166.609036, "o", "\\tfor i := 0; i < limit; i++ {\r\n\u001b[?2004l\r"]
[7166.609097, "o", "\u001b[?2004h> "]
[7166.609174, "o", "\\t\\trun := candidates[i].run\r\n\u001b[?2004l\r"]
[7166.609229, "o", "\u001b[?2004h> "]
[7166.60938, "o", "\\t\\tentries = append(entries, LeaderboardEntry{\r\n\u001b[?2004l\r"]
[7166.609433, "o", "\u001b[?2004h> "]
[7166.609502, "o", "\\t\\t\\tRank:       i + 1,\r\n\u001b[?2004l\r"]
[7166.609557, "o", "\u001b[?2004h> "]
[7166.609624, "o", "\\t\\t\\tRunID:      run.ID,\r\n\u001b[?2004l\r"]
[7166.609678, "o", "\u001b[?2004h> "]
[7166.609794, "o", "\\t\\t\\tValue:      candidates[i].value,\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.609847, "o", "> "]
[7166.609938, "o", "\\t\\t\\tParameters: run.Parameters,\r\n\u001b[?2004l\r"]
[7166.609993, "o", "\u001b[?2004h> "]
[7166.610081, "o", "\\t\\t\\tMetrics:    run.Metrics,\r\n\u001b[?2004l\r"]
[7166.610137, "o", "\u001b[?2004h> \\t\\t})\r\n\u001b[?2004l\r"]
[7166.610192, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\rS\u001b[?2004h"]
[7166.610251, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.610363, "o", "\\treturn &LeaderboardResult{\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.610416, "o", "> "]
[7166.610512, "o", "\\t\\tExperiment: experimentName,\r\n\u001b[?2004l\r"]
[7166.61057, "o", "\u001b[?2004h> "]
[7166.610645, "o", "\\t\\tMetric:     metric,\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.610699, "o", "> "]
[7166.610755, "o", "\\t\\tOrder:      order,\r\n\u001b[?2004l\r"]
[7166.61081, "o", "\u001b[?2004h> "]
[7166.610889, "o", "\\t\\tEntries:    entries,\r\n\u001b[?2004l\r"]
[7166.610945, "o", "\u001b[?2004h> "]
[7166.611042, "o", "\\t\\tTotalRuns:  len(candidates),\r\n\u001b[?2004l\r"]
[7166.611095, "o", "\u001b[?2004h> \\t}, nil\r\n\u001b[?2004l\re"]
[7166.61115, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.611209, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.611458, "o", "// SummaryResult contains basic statistics for a metric across runs.\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.611513, "o", "> "]
[7166.611584, "o", "type SummaryResult struct {\r\n\u001b[?2004l\r"]
[7166.611639, "o", "\u001b[?2004h> "]
[7166.611757, "o", "\\tExperiment string  `json:\"experiment\"`\r\n\u001b[?2004l\r"]
[7166.611811, "o", "\u001b[?2004h> "]
[7166.611931, "o", "\\tMetric     string  `json:\"metric\"`\r\n\u001b[?2004l\r"]
[7166.611986, "o", "\u001b[?2004h> "]
[7166.612094, "o", "\\tCount      int     `json:\"count\"`\r\n\u001b[?2004l\r"]
[7166.612159, "o", "\u001b[?2004h> "]
[7166.612245, "o", "\\tMin        float64 `json:\"min\"`\r\n\u001b[?2004l\r"]
[7166.612306, "o", "\u001b[?2004h> "]
[7166.61239, "o", "\\tMax        float64 `json:\"max\"`\r\n\u001b[?2004l\r"]
[7166.612444, "o", "\u001b[?2004h> "]
[7166.612544, "o", "\\tMean       float64 `json:\"mean\"`\r\n\u001b[?2004l\r"]
[7166.612599, "o", "\u001b[?2004h> "]
[7166.612721, "o", "\\tMedian     float64 `json:\"median\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.612776, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\""]
[7166.612835, "o", "\u001b[?2004h> "]
[7166.613129, "o", "// Summary computes summary statistics for a metric across all runs in an experiment.\r\n\u001b[?2004l\r"]
[7166.613186, "o", "\u001b[?2004h> "]
[7166.613463, "o", "func (t *Tracker) Summary(experimentName, metric string) (*SummaryResult, error) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.613528, "o", "> "]
[7166.613583, "o", "\\tt.mu.RLock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.613677, "o", "\\tdefer t.mu.RUnlock()\r\n\u001b[?2004l\r"]
[7166.613732, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r(\u001b[?2004h> "]
[7166.613925, "o", "\\texp, exists := t.experiments[experimentName]\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.613982, "o", "> "]
[7166.614038, "o", "\\tif !exists {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.614334, "o", "\\t\\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\u001b[?2004l\r"]
[7166.61439, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.614446, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.614526, "o", "\\tvar values []float64\r\n\u001b[?2004l\r"]
[7166.614581, "o", "\u001b[?2004h> "]
[7166.61467, "o", "\\tfor _, run := range exp.Runs {\r\n\u001b[?2004l\r"]
[7166.614725, "o", "\u001b[?2004h> "]
[7166.614783, "o", "\\t\\tif run == nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.614838, "o", "> "]
[7166.614907, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.614964, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.615136, "o", "\\t\\tif value, ok := run.Metrics[metric]; ok {\r\n\u001b[?2004l\r"]
[7166.615192, "o", "\u001b[?2004h> "]
[7166.615302, "o", "\\t\\t\\tvalues = append(values, value)\r\n\u001b[?2004l\r"]
[7166.615356, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\r\n"]
[7166.615412, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.615468, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.615556, "o", "\\tif len(values) == 0 {\r\n\u001b[?2004l\r"]
[7166.615611, "o", "\u001b[?2004h> "]
[7166.615816, "o", "\\t\\treturn nil, fmt.Errorf(\"no runs have metric %q\", metric)\r\n\u001b[?2004l\r"]
[7166.615887, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7166.615943, "o", "%\u001b[?2004h> "]
[7166.616008, "o", "\\tsort.Float64s(values)\r\n\u001b[?2004l\r"]
[7166.616066, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.616143, "o", "\\tmin := values[0]\r\n\u001b[?2004l\r"]
[7166.616197, "o", "\u001b[?2004h> "]
[7166.616284, "o", "\\tmax := values[len(values)-1]\r\n\u001b[?2004l\r"]
[7166.616339, "o", "\u001b[?2004h> "]
[7166.616393, "o", "\\tsum := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.616504, "o", "\\tfor _, v := range values {\r\n\u001b[?2004l\r"]
[7166.616558, "o", "\u001b[?2004h> "]
[7166.616612, "o", "\\t\\tsum += v\r\n\u001b[?2004l\r\u001b[?2004h> \\t}"]
[7166.616667, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.616794, "o", "\\tmean := sum / float64(len(values))\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.616848, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.61693, "o", "\\tmedian := 0.0\r\n\u001b[?2004l\ro\u001b[?2004h"]
[7166.616987, "o", "> "]
[7166.617041, "o", "\\tn := len(values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.617111, "o", "\\tif n%2 == 1 {\r\n\u001b[?2004l\r"]
[7166.617167, "o", "\u001b[?2004h> "]
[7166.617229, "o", "\\t\\tmedian = values[n/2]\r\n\u001b[?2004l\r"]
[7166.617284, "o", "\u001b[?2004h> "]
[7166.617342, "o", "\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.617397, "o", "> "]
[7166.617539, "o", "\\t\\tmedian = (values[n/2-1] + values[n/2]) / 2.0\r\n\u001b[?2004l\r"]
[7166.6176, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.617659, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.617732, "o", "\\treturn &SummaryResult{\r\n\u001b[?2004l\r"]
[7166.617786, "o", "\u001b[?2004h> "]
[7166.6179, "o", "\\t\\tExperiment: experimentName,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.617997, "o", "\\t\\tMetric:     metric,\r\n\u001b[?2004l\r"]
[7166.618051, "o", "\u001b[?2004h> "]
[7166.6181, "o", "\\t\\tCount:      n,\r\n\u001b[?2004l\r"]
[7166.618154, "o", "\u001b[?2004h> "]
[7166.618205, "o", "\\t\\tMin:        min,\r\n\u001b[?2004l\r"]
[7166.61826, "o", "\u001b[?2004h> "]
[7166.618315, "o", "\\t\\tMax:        max,\r\n\u001b[?2004l\r"]
[7166.618371, "o", "\u001b[?2004h> "]
[7166.618429, "o", "\\t\\tMean:       mean,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.61853, "o", "\\t\\tMedian:     median,\r\n\u001b[?2004l\r"]
[7166.618584, "o", "\u001b[?2004h> \\t}, nil\r\n\u001b[?2004l\r"]
[7166.618639, "o", "\u001b[?2004h> }'''\r\n\u001b[?2004l\r"]
[7166.618697, "o", "\u001b[?2004h> "]
[7166.618839, "o", "text = text[:start] + new_block + text[end:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.618918, "o", "p.write_text(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.618973, "o", "\r\n\u001b[?2004l\rr\u001b[?2004h> "]
[7166.619054, "o", "# --- serving reload + warmup ---\r\n\u001b[?2004l\r"]
[7166.619108, "o", "\u001b[?2004h> "]
[7166.619196, "o", "p = Path(\"internal/serving/serving.go\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.619266, "o", "text = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.619416, "o", "warmup_type = '''type WarmupResult struct {\r\n\u001b[?2004l\r"]
[7166.619472, "o", "\u001b[?2004h> "]
[7166.619539, "o", "\\tStatus     string  `json:\"status\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.619675, "o", "\\tModelName  string  `json:\"model_name\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.619817, "o", "\\tVersionNum int     `json:\"version_num\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.619954, "o", "\\tLatencyMs  float64 `json:\"latency_ms\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.620011, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[7166.620208, "o", "// ModelStats tracks inference statistics for a single model.'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.620486, "o", "text = text.replace(\"// ModelStats tracks inference statistics for a single model.\", warmup_type, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.620733, "o", "methods = '''func (s *Server) ReloadModel(modelName string) (*LoadedModel, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.620795, "o", "\\ts.mu.Lock()\r\n\u001b[?2004l\r"]
[7166.62085, "o", "\u001b[?2004h> "]
[7166.620915, "o", "\\tdefer s.mu.Unlock()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[7166.62104, "o", "\\tloaded, exists := s.loaded[modelName]\r\n\u001b[?2004l\r"]
[7166.621096, "o", "\u001b[?2004h> \\tif !exists {\r\n\u001b[?2004l\rd.V"]
[7166.621152, "o", "\u001b[?2004h> "]
[7166.621342, "o", "\\t\\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", modelName)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.621398, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.621453, "o", "> "]
[7166.621614, "o", "\\tversion, err := s.registry.GetVersion(modelName, loaded.VersionNum)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.621681, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.621736, "o", "> "]
[7166.621927, "o", "\\t\\treturn nil, fmt.Errorf(\"version no longer exists in registry: %w\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.621988, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.622101, "o", "\\ts.loaded[modelName] = &LoadedModel{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.622202, "o", "\\t\\tModelName:   modelName,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.622319, "o", "\\t\\tVersionNum:  version.Number,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.622425, "o", "\\t\\tStage:       version.Stage,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.622546, "o", "\\t\\tModelConfig: version.ModelConfig,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.622644, "o", "\\t\\tLoadedAt:    time.Now(),\r\n\u001b[?2004l\r"]
[7166.622699, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.622801, "o", "\\treturn s.loaded[modelName], nil\r\n\u001b[?2004l\r"]
[7166.622863, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rJ"]
[7166.622917, "o", "\u001b[?2004h> "]
[7166.623085, "o", "func (s *Server) WarmupModel(modelName string) (*WarmupResult, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.623169, "o", "\\tstart := time.Now()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.623223, "o", "\r\n\u001b[?2004l\r-\u001b[?2004h> "]
[7166.623278, "o", "\\ts.mu.RLock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.623375, "o", "\\tloaded, exists := s.loaded[modelName]\r\n\u001b[?2004l\r"]
[7166.62343, "o", "\u001b[?2004h> "]
[7166.623484, "o", "\\ts.mu.RUnlock()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rl\u001b[?2004h> "]
[7166.623538, "o", "\\tif !exists {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.623767, "o", "\\t\\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", modelName)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.623822, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rx\u001b[?2004h> "]
[7166.624072, "o", "\\tif _, err := computePrediction(loaded.ModelConfig, []float64{0.0}); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.624248, "o", "\\t\\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.624301, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[7166.624486, "o", "\\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n\u001b[?2004l\r"]
[7166.62454, "o", "\u001b[?2004h> "]
[7166.624595, "o", "\\treturn &WarmupResult{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.624679, "o", "\\t\\tStatus:     \"warmed_up\",\r\n\u001b[?2004l\r"]
[7166.624734, "o", "\u001b[?2004h> "]
[7166.624788, "o", "\\t\\tModelName:  modelName,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.624889, "o", "\\t\\tVersionNum: loaded.VersionNum,\r\n\u001b[?2004l\r"]
[7166.624943, "o", "\u001b[?2004h> "]
[7166.624997, "o", "\\t\\tLatencyMs:  latency,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.625051, "o", "\\t}, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[7166.625106, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rm\u001b[?2004h> "]
[7166.625312, "o", "// RecordRequest updates serving statistics for a single inference request.'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.62564, "o", "text = text.replace(\"// RecordRequest updates serving statistics for a single inference request.\", methods, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.625711, "o", "p.write_text(text)\r\n\u001b[?2004l\r"]
[7166.625767, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\"\u001b[?2004h> "]
[7166.625826, "o", "# --- handlers ---\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.625928, "o", "p = Path(\"internal/api/handlers.go\")\r\n\u001b[?2004l\r"]
[7166.625985, "o", "\u001b[?2004h> "]
[7166.626042, "o", "text = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.62618, "o", "old = '''if err := h.Experiment.DeleteRun(expName, runID); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.626235, "o", "> "]
[7166.626292, "o", "\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.626355, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7166.62641, "o", "\u001b[?2004h> "]
[7166.626516, "o", "\\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.626643, "o", "new = '''run, err := h.Experiment.DeleteRun(expName, runID)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.626698, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.626807, "o", "\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.626879, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7166.626936, "o", "\u001b[?2004h> "]
[7166.626994, "o", "\\twriteJSON(w, http.StatusOK, run)'''\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.627057, "o", "> if old not in text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.627155, "o", "    raise SystemExit(\"DeleteRun handler block not found\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.627234, "o", "text = text.replace(old, new, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.627449, "o", "new_handlers = '''func (h *Handlers) ExperimentLeaderboard(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.627531, "o", "\\texpName := r.PathValue(\"name\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.627622, "o", "\\tmetric := r.URL.Query().Get(\"metric\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.627676, "o", "\\tif metric == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.627739, "o", "> "]
[7166.627844, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"metric query parameter is required\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.627915, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7166.62797, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.628029, "o", "\\torder := r.URL.Query().Get(\"order\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.628085, "o", "\\tif order == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.628139, "o", "\\t\\torder = \"desc\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.628193, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.628262, "o", "\\tif order != \"asc\" && order != \"desc\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.62843, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"order must be \\\\\"asc\\\\\" or \\\\\"desc\\\\\"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.628494, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[7166.62855, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.628604, "o", "\\tlimit := 10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.628698, "o", "\\tif limitStr := r.URL.Query().Get(\"limit\"); limitStr != \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.628786, "o", "\\t\\tn, err := strconv.Atoi(limitStr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.628844, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.628995, "o", "\\t\\t\\twriteError(w, http.StatusBadRequest, \"limit must be an integer\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.629053, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[7166.62911, "o", "\u001b[?2004h> \\t\\tif n < 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.629165, "o", "\\t\\t\\tn = 0\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.629218, "o", "\\t\\tlimit = n\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[7166.629272, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.629357, "o", "\\tresult, err := h.Experiment.Leaderboard(expName, metric, order, limit)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.629415, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.629485, "o", "\\t\\tif strings.Contains(err.Error(), \"not found\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.629574, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.629627, "o", "\\t\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.629699, "o", "\\t\\t\\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.629753, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.629812, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.629876, "o", "\\twriteJSON(w, http.StatusOK, result)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[7166.629934, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.630028, "o", "func (h *Handlers) ExperimentSummary(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.63009, "o", "\\texpName := r.PathValue(\"name\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.630162, "o", "\\tmetric := r.URL.Query().Get(\"metric\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.630222, "o", "\\tif metric == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.63033, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"metric query parameter is required\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.630385, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7166.63044, "o", "\u001b[?2004h> "]
[7166.630502, "o", "\\tresult, err := h.Experiment.Summary(expName, metric)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.630557, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.630622, "o", "\\t\\tif strings.Contains(err.Error(), \"not found\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.630708, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.630762, "o", "\\t\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.630835, "o", "\\t\\t\\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.630903, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.630961, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
