[5664.498006, "o", "\t\t\t\tif v > result {\r\n   203\t\t\t\t\tresult = v\r\n   204\t\t\t\t}\r\n   205\t\t\t}\r\n   206\t\tcase \"range\":\r\n   207\t\t\tif len(values) < 2 {\r\n   208\t\t\t\tresult = 0.0\r\n   209\t\t\t} else {\r\n   210\t\t\t\tminVal := values[0]\r\n   211\t\t\t\tmaxVal := values[0]\r\n   212\t\t\t\tfor _, v := range values[1:] {\r\n   213\t\t\t\t\tif v < minVal {\r\n   214\t\t\t\t\t\tminVal = v\r\n   215\t\t\t\t\t}\r\n   216\t\t\t\t\tif v > maxVal {\r\n   217\t\t\t\t\t\tmaxVal = v\r\n   218\t\t\t\t\t"]
[5664.498078, "o", "}\r\n   219\t\t\t\t}\r\n   220\t\t\t\tresult = maxVal - minVal\r\n   221\t\t\t}\r\n   222\t\tdefault:\r\n   223\t\t\treturn nil, fmt.Errorf(\"aggregate: unknown operation %q\", operation)\r\n   224\t\t}\r\n   225\t\r\n   226\t\treturn map[string]interface{}{\r\n   227\t\t\t\"result\": result,\r\n   228\t"]
