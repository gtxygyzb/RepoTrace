[4031.944072, "o", "   153\t// PromoteVersion transitions a model version to the specified stage.\r\n   154\tfunc (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {\r\n   155\t\tr.mu.Lock()\r\n   156\t\tdefer r.mu.Unlock()\r\n   157\t\r\n   158\t\tmodel, exists := r.models[modelName]\r\n   159\t\tif !exists {\r\n   160\t\t\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n   161\t\t}\r\n"]
[4031.944316, "o", "   162\t\r\n   163\t\tvar version *Version\r\n   164\t\tfor _, v := range model.Versions {\r\n   165\t\t\tif v.Number == versionNum {\r\n   166\t\t\t\tversion = v\r\n   167\t\t\t\tbreak\r\n   168\t\t\t}\r\n   169\t\t}\r\n   170\t\tif version == nil {\r\n   171\t\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n   172\t\t}\r\n   173\t\r\n   174\t\t// Validate stage transition\r\n   175\t\tallowed := validTransitions[version.Stage]\r\n   176\t\tvalid := false\r\n   177\t\tfor _, s := range allowed {\r\n   178\t\t\tif s == targetStage {\r\n   179\t\t\t\tvalid = true\r\n   180\t\t\t\tbreak\r\n   181\t\t\t}\r\n   182\t\t}\r\n   183\t\tif !valid {\r\n   184\t\t\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n   185\t\t}\r\n   186\t\r\n   187\t\t// If promoting to production, demote current production version\r\n   188\t\tif targetStage == StageProduction {\r\n   189\t\t\tfor _, v := range model.Versions {\r\n   190\t\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n"]
[4031.944427, "o", "   191\t\t\t\t\tv.Stage = StageStaging\r\n   192\t\t\t\t}\r\n   193\t\t\t}\r\n   194\t\t}\r\n   195\t\r\n   196\t\tversion.Stage = targetStage\r\n   197\t\tmodel.UpdatedAt = time.Now()\r\n   198\t\r\n   199\t\treturn r.saveModel(model)\r\n   200\t}\r\n   201\t\r\n   202\t// GetModel returns a model with its versions sorted by version number descending.\r\n   203\tfunc (r *Registry) GetModel(name string) (*Model, error) {\r\n   204\t\tr.mu.RLock()\r\n   205\t\tdefer r.mu.RUnlock()\r\n   206\t\r\n   207\t\tmodel, exists := r.models[name]\r\n   208\t\tif !exists {\r\n   209\t\t\treturn nil, fmt.Errorf(\"model %q not found\", name)\r\n   210\t\t}\r\n   211\t\r\n"]
[4031.944497, "o", "   212\t\t// Return a copy with versions sorted\r\n   213\t\tresult := *model\r\n   214\t\tresult.Versions = make([]*Version, len(model.Versions))\r\n   215\t\tcopy(result.Versions, model.Versions)\r\n   216\t\tsort.Slice(result.Versions, func(i, j int) bool {\r\n   217\t\t\treturn result.Versions[i].Number > result.Versions[j].Number\r\n   218\t\t})\r\n   219\t\treturn &result, nil\r\n   220\t}\r\n   221\t\r\n   222\t// ListModels returns all models matching the optional filter."]
[4031.944561, "o", "\r\n   223\tfunc (r *Registry) ListModels(filter *ModelFilter) ([]*Model, error) {\r\n   224\t\tr.mu.RLock()\r\n   225\t\tdefer r.mu.RUnlock()\r\n   226\t\r\n   227\t\tvar result []*Model\r\n   228\t\tfor _, model := range r.models {\r\n   229\t\t\tif filter != nil {\r\n   230\t\t\t\tif filter.Framework != \"\" && model.Framework != filter.Framework {\r\n"]
[4031.944628, "o", "   231\t\t\t\t\tcontinue\r\n   232\t\t\t\t}\r\n   233\t\t\t\tif filter.Tag != \"\" {\r\n   234\t\t\t\t\thasTag := false\r\n   235\t\t\t\t\tfor _, t := range model.Tags {\r\n   236\t\t\t\t\t\tif t == filter.Tag {\r\n   237\t\t\t\t\t\t\thasTag = true\r\n   238\t\t\t\t\t\t\tbreak\r\n"]
[4031.944688, "o", "   239\t\t\t\t\t\t}\r\n   240\t\t\t\t\t}\r\n   241\t\t\t\t\tif !hasTag {\r\n   242\t\t\t\t\t\tcontinue\r\n   243\t\t\t\t\t}\r\n   244\t\t\t\t}\r\n   245\t\t\t}\r\n   246\t\t\tresult = append(result, model)\r\n"]
[4031.944747, "o", "   247\t\t}\r\n   248\t\tsort.Slice(result, func(i, j int) bool {\r\n   249\t\t\treturn result[i].Name < result[j].Name\r\n   250\t\t})\r\n   251\t\treturn result, nil\r\n   252\t}\r\n   253\t\r\n"]
[4031.944805, "o", "   254\t// DeleteModel removes a model from the registry.\r\n   255\tfunc (r *Registry) DeleteModel(name string) error {\r\n   256\t\tr.mu.Lock()\r\n   257\t\tdefer r.mu.Unlock()\r\n   258\t\r\n   259\t\tif _, exists := r.models[name]; !exists {\r\n   260\t\t\treturn fmt.Errorf(\"model %q not found\", name)\r\n   261\t\t}\r\n"]
