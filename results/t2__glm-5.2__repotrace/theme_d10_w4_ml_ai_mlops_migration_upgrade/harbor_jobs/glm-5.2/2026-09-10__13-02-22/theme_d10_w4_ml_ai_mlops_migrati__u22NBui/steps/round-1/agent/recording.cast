[2192.367782, "o", "sed -n '1,120p' internal/api/templates.go\r\n\u001b[?2004l\r"]
[2192.370874, "o", "package api\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[2192.370957, "o", "\t\"net/http\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\t\"time\"\r\n\r\n\t\"gomlops/internal/pipeline\"\r\n)\r\n\r\ntype TemplateParameter struct {\r\n\tName    string      `json:\"name\"`\r\n\tType    string      `json:\"type\"`\r\n\tDefault interface{} `json:\"default,omitempty\"`\r\n}"]
[2192.371027, "o", "\r\n\r\ntype Template struct {\r\n\tName        string              `json:\"name\"`\r\n\tDescription string              `json:\"description\"`\r\n\tParameters  []TemplateParameter `json:\"parameters\"`\r\n\tPipeline    *pipeline.Pipeline  `json:\"pipeline\"`\r\n\tCreatedAt   time.Time           `json:\"created_at\"`\r\n\tUpdatedAt   *time.Time          `json:\"updated_at\"`\r\n}\r\n\r\ntype TemplateStore struct {\r\n"]
[2192.371098, "o", "\tmu        sync.RWMutex\r\n\ttemplates map[string]*Template\r\n}\r\n\r\nfunc NewTemplateStore() *TemplateStore {\r\n\treturn &TemplateStore{templates: make(map[string]*Template)}\r\n}\r\n\r\nvar templateNameRe = regexp.MustCompile(`^[a-zA-Z0-9_-]+$`)\r\n\r\nfunc validateTemplateName(name string) bool {\r\n\treturn len(name) > 0 && len(name) <= 64 && templateNameRe.MatchString(name)\r\n}\r\n\r\nfunc (s *TemplateStore) Get(name string) (*Template, bool) {\r\n\t"]
[2192.371158, "o", "s.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\tt, ok := s.templates[name]\r\n\treturn t, ok\r\n}\r\n\r\nfunc (s *TemplateStore) List(sortBy string) []*Template {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n"]
[2192.371226, "o", "\tresult := make([]*Template, 0, len(s.templates))\r\n\tfor _, t := range s.templates {\r\n\t\tresult = append(result, t)\r\n\t}\r\n\tif sortBy == \"created_at\" {\r\n\t\t"]
[2192.371291, "o", "sort.Slice(result, func(i, j int) bool {\r\n\t\t\treturn result[i].CreatedAt.Before(result[j].CreatedAt)\r\n\t\t})\r\n\t} else {\r\n\t\tsort.Slice(result, func(i, j int) bool {\r\n\t\t\treturn result[i].Name < result[j].Name\r\n\t\t})\r\n\t}\r\n\treturn result\r\n}\r\n\r\nfunc (s *TemplateStore) Create(t *Template) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\tif _, exists := s.templates[t.Name]; exists {\r\n"]
[2192.371352, "o", "\t\treturn fmt.Errorf(\"template %q already exists\", t.Name)\r\n\t}\r\n\tt.CreatedAt = time.Now()\r\n\tt.UpdatedAt = nil\r\n\ts.templates[t.Name] = t\r\n\treturn nil\r\n}\r\n\r\nfunc (s *TemplateStore) Update(t *Template) error {\r\n\ts.mu.Lock()\r\n"]
[2192.371414, "o", "\tdefer s.mu.Unlock()\r\n\tif _, exists := s.templates[t.Name]; !exists {\r\n\t\treturn fmt.Errorf(\"template %q not found\", t.Name)\r\n\t}\r\n\tnow := time.Now()\r\n\tt.UpdatedAt = &now\r\n\ts.templates[t.Name] = t\r\n\treturn nil\r\n}\r\n\r\nfunc (s *TemplateStore) Delete(name string) error {\r\n"]
[2192.371475, "o", "\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\tif _, exists := s.templates[name]; !exists {\r\n\t\treturn fmt.Errorf(\"template %q not found\", name)\r\n\t}\r\n\tdelete(s.templates, name)\r\n\treturn nil\r\n}\r\n\r\nfunc (h *Handlers) CreateTemplate(w http.ResponseWriter, r *http.Request) {\r\n\t"]
[2192.371538, "o", "var req struct {\r\n\t\tName        string              `json:\"name\"`\r\n\t\tDescription string              `json:\"description\"`\r\n\t\tParameters  []TemplateParameter `json:\"parameters\"`\r\n\t\tPipeline    *pipeline.Pipeline  `json:\"pipeline\"`\r\n"]
[2192.371601, "o", "\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif !validateTemplateName(req.Name) {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid template name\")\r\n\t\treturn\r\n\t}\r\n"]
