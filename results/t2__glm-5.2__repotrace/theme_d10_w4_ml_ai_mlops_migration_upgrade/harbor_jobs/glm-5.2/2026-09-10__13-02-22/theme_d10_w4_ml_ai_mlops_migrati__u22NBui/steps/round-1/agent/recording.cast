[152.023489, "o", "   242\t// DeleteModel removes a model from the registry.\r\n   243\tfunc (r *Registry) DeleteModel(name string) error {\r\n   244\t\tr.mu.Lock()\r\n   245\t\tdefer r.mu.Unlock()\r\n   246\t\r\n   247\t\tif _, exists := r.models[name]; !exists {\r\n   248\t\t\treturn fmt.Errorf(\"model %q not found\", name)\r\n   249\t\t}\r\n   250\t\r\n   251\t\tdelete(r.models, name)\r\n   252\t\tfilename := filepath.Join(r.dataDir, name+\".json\")\r\n   253\t\tos.Remove(filename)\r\n   254\t\treturn nil\r\n   255\t}\r\n   256\t\r\n   257\t// GetVersion returns a specific version of a model.\r\n"]
