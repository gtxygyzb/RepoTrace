[2102.892267, "o", "\u001b[?2004h> "]
[2102.892412, "o", "\\tval, exists := variables[varName]\r\n\u001b[?2004l\r"]
[2102.892466, "o", "\u001b[?2004h> "]
[2102.89252, "o", "\\tif !exists {\r\n\u001b[?2004l\r"]
[2102.892575, "o", "\u001b[?2004h> "]
[2102.89265, "o", "\\t\\treturn false, nil\r\n\u001b[?2004l\r"]
[2102.892705, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2102.89276, "o", "\u001b[?2004h> "]
[2102.892874, "o", "\\top, _ := c[\"op\"].(string)\r\n\u001b[?2004l\r"]
[2102.892931, "o", "\u001b[?2004h> "]
[2102.893115, "o", "\\tthreshold, err := toFloat(c[\"threshold\"])\r\n\u001b[?2004l\r"]
[2102.893171, "o", "\u001b[?2004h> "]
[2102.893236, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[2102.89329, "o", "\u001b[?2004h> "]
[2102.893576, "o", "\\t\\treturn false, fmt.Errorf(\"skip_condition invalid threshold: %w\", err)\r\n\u001b[?2004l\r"]
[2102.89363, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2102.893685, "o", "\u001b[?2004h> "]
[2102.893745, "o", "\\tswitch op {\r\n\u001b[?2004l\r"]
[2102.8938, "o", "\u001b[?2004h> "]
[2102.893863, "o", "\\tcase \"gt\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[2102.893931, "o", "> "]
[2102.894014, "o", "\\t\\treturn val > threshold, nil\r\n\u001b[?2004l\r"]
[2102.894069, "o", "\u001b[?2004h> "]
[2102.894127, "o", "\\tcase \"lt\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[2102.894181, "o", "> "]
[2102.894284, "o", "\\t\\treturn val < threshold, nil\r\n\u001b[?2004l\r"]
[2102.894339, "o", "\u001b[?2004h> "]
[2102.894384, "o", "\\tcase \"eq\":\r\n\u001b[?2004l\r"]
[2102.89444, "o", "\u001b[?2004h> "]
[2102.894554, "o", "\\t\\treturn val == threshold, nil\r\n\u001b[?2004l\r"]
[2102.894614, "o", "\u001b[?2004h> "]
[2102.894677, "o", "\\tcase \"gte\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2102.894829, "o", "\\t\\treturn val >= threshold, nil\r\n\u001b[?2004l\r"]
[2102.894899, "o", "\u001b[?2004h> "]
[2102.894963, "o", "\\tcase \"lte\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[2102.895017, "o", "> "]
[2102.895121, "o", "\\t\\treturn val <= threshold, nil\r\n\u001b[?2004l\r"]
[2102.895176, "o", "\u001b[?2004h> "]
[2102.895237, "o", "\\tcase \"ne\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[2102.895291, "o", "> "]
[2102.895421, "o", "\\t\\treturn val != threshold, nil\r\n\u001b[?2004l\r"]
[2102.895475, "o", "\u001b[?2004h> "]
[2102.89553, "o", "\\tdefault:\r\n\u001b[?2004l\r\u001b[?2004h"]
[2102.895585, "o", "> "]
[2102.895865, "o", "\\t\\treturn false, fmt.Errorf(\"skip_condition unsupported operator %q\", op)\r\n\u001b[?2004l\r"]
[2102.895927, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2102.895982, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2102.896037, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[2102.896092, "o", "\u001b[?2004h> "]
[2102.896472, "o", "# Insert helper after Execute function closing brace (line 188) before topologicalSort.\r\n\u001b[?2004l\r"]
[2102.896537, "o", "\u001b[?2004h> "]
[2102.896905, "o", "marker = '\\n// topologicalSort orders steps so that dependencies are executed first.\\n'\r\n\u001b[?2004l\r"]
[2102.896962, "o", "\u001b[?2004h> "]
[2102.897033, "o", "if marker not in s:\r\n\u001b[?2004l\r"]
[2102.897088, "o", "\u001b[?2004h> "]
[2102.897312, "o", "    raise SystemExit('topologicalSort marker not found')\r\n\u001b[?2004l\r"]
[2102.897367, "o", "\u001b[?2004h> "]
[2102.897515, "o", "s = s.replace(marker, helper + marker)\r\n\u001b[?2004l\r"]
[2102.89757, "o", "\u001b[?2004h> "]
[2102.897643, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[2102.897697, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[2102.940175, "o", "\u001b[?2004hroot@n30009:/app# "]
[2103.160127, "i", "sed -n '1,220p' internal/registry/registry.go\n"]
[2103.160494, "o", "sed -n '1,220p' internal/registry/registry.go\r\n"]
[2103.160627, "o", "\u001b[?2004l\r"]
[2103.163401, "o", "package registry\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n\t\"time\"\r\n"]
[2103.16351, "o", ")\r\n\r\n// Stage represents the lifecycle stage of a model version.\r\ntype Stage string\r\n\r\nconst (\r\n\tStageDevelopment Stage = \"development\"\r\n\tStageStaging     Stage = \"staging\"\r\n\tStageProduction  Stage = \"production\"\r\n\tStageArchived    Stage = \"archived\"\r\n)\r\n\r\nvar validTransitions = map[Stage][]Stage{\r\n\tStageDevelopment: {StageStaging, StageArchived},\r\n\tStageStaging:     {StageProduction, StageArchived},\r\n\tStageProduction:  {StageArchived},\r\n\tStageArchived:    {},\r\n}\r\n\r\n// Version represents a specific version of a model.\r\ntype Version struct {\r\n"]
[2103.163598, "o", "\tNumber      int                    `json:\"number\"`\r\n\tStage       Stage                  `json:\"stage\"`\r\n\tMetrics     map[string]float64     `json:\"metrics\"`\r\n\tTags        []string               `json:\"tags\"`\r\n\tModelConfig map[string]interface{} `json:\"model_config,omitempty\"`\r\n\tCreatedAt   time.Time              `json:\"created_at\"`\r\n}\r\n\r\n// Model represents a registered ML model.\r\ntype Model struct {\r\n\tName        string     `json:\"name\"`\r\n\tFramework   string     `json:\"framework\"`\r\n\tDescription string     `json:\"description\"`\r\n\tTags        []string   `json:\"tags\"`\r\n"]
[2103.163666, "o", "\tVersions    []*Version `json:\"versions\"`\r\n\tCreatedAt   time.Time  `json:\"created_at\"`\r\n\tUpdatedAt   time.Time  `json:\"updated_at\"`\r\n}\r\n\r\n// ModelFilter defines filtering criteria for listing models.\r\ntype ModelFilter struct {\r\n\tFramework string\r\n\tTag       string\r\n}\r\n\r\n// Registry manages model registration, versioning, and lifecycle.\r\ntype Registry struct {\r\n\tmu      sync.RWMutex\r\n\tmodels  map[string]*Model\r\n"]
[2103.163731, "o", "\tdataDir string\r\n}\r\n\r\n// NewRegistry creates a new Registry backed by the given data directory.\r\nfunc NewRegistry(dataDir string) (*Registry, error) {\r\n\tif err := os.MkdirAll(dataDir, 0755); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"create data dir: %w\", err)\r\n\t}\r\n\tr := &Registry{\r\n\t\tmodels:  make(map[string]*Model),\r\n\t\tdataDir: dataDir,\r\n\t}\r\n\tif err := r.loadAll(); err != nil {"]
[2103.163793, "o", "\r\n\t\treturn nil, fmt.Errorf(\"load registry: %w\", err)\r\n\t}\r\n\treturn r, nil\r\n}\r\n\r\n// RegisterModel creates a new model entry in the registry.\r\nfunc (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tif _, exists := r.models[name]; exists {\r\n"]
[2103.163897, "o", "\t\treturn nil, fmt.Errorf(\"model %q already exists\", name)\r\n\t}\r\n\r\n\tnow := time.Now()\r\n\tmodel := &Model{\r\n\t\tName:        name,\r\n\t\tFramework:   framework,\r\n\t\tDescription: description,\r\n"]
[2103.163971, "o", "\t\tTags:        tags,\r\n\t\tVersions:    make([]*Version, 0),\r\n\t\tCreatedAt:   now,\r\n\t\tUpdatedAt:   now,\r\n\t}\r\n\tr.models[name] = model\r\n\tif err := r.saveModel(model); err != nil {\r\n\t\tdelete(r.models, name)\r\n\t\treturn nil, err\r\n\t}\r\n\treturn model, nil\r\n}\r\n\r\n// CreateVersion adds a new version to the specified model.\r\n"]
[2103.164031, "o", "func (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tnextNum := 1\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Number >= nextNum {\r\n\t\t\tnextNum = v.Number + 1\r\n"]
[2103.164093, "o", "\t\t}\r\n\t}\r\n\r\n\tversion := &Version{\r\n\t\tNumber:      nextNum,\r\n\t\tStage:       StageDevelopment,\r\n\t\tMetrics:     metrics,\r\n\t\tTags:        tags,\r\n\t\tModelConfig: modelConfig,\r\n\t\tCreatedAt:   time.Now(),\r\n\t}\r\n"]
[2103.164152, "o", "\tmodel.Versions = append(model.Versions, version)\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\tif err := r.saveModel(model); err != nil {\r\n\t\tmodel.Versions = model.Versions[:len(model.Versions)-1]\r\n\t\treturn nil, err\r\n\t}\r\n\treturn version, nil\r\n}\r\n\r\n// PromoteVersion transitions a model version to the specified stage.\r\n"]
[2103.16422, "o", "func (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n"]
[2103.164278, "o", "\t}\r\n\r\n\tvar version *Version\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Number == versionNum {\r\n\t\t\tversion = v\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif version == nil {\r\n\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n\t}\r\n\r\n\t// Validate stage transition\r\n\tallowed := validTransitions[version.Stage]\r\n\tvalid := false"]
[2103.164353, "o", "\r\n\tfor _, s := range allowed {\r\n\t\tif s == targetStage {\r\n\t\t\tvalid = true\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif !valid {\r\n\t\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n\t}\r\n"]
[2103.164412, "o", "\r\n\t// If promoting to production, demote current production version\r\n\tif targetStage == StageProduction {\r\n\t\tfor _, v := range model.Versions {\r\n\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n\t\t\t\tv.Stage = StageArchived\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[2103.164469, "o", "\tversion.Stage = targetStage\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\treturn r.saveModel(model)\r\n}\r\n\r\n// GetModel returns a model with its versions sorted by version number descending.\r\nfunc (r *Registry) GetModel(name string) (*Model, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n"]
[2103.164527, "o", "\r\n\tmodel, exists := r.models[name]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", name)\r\n\t}\r\n\r\n\t// Return a copy with versions sorted\r\n\tresult := *model\r\n\tresult.Versions = make([]*Version, len(model.Versions))\r\n\tcopy(result.Versions, model.Versions)\r\n\tsort.Slice(result.Versions, func(i, j int) bool {\r\n"]
[2103.164584, "o", "\t\treturn result.Versions[i].Number > result.Versions[j].Number\r\n\t})\r\n\treturn &result, nil\r\n}\r\n\r\n// ListModels returns all models matching the optional filter.\r\nfunc (r *Registry) ListModels(filter *ModelFilter) ([]*Model, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tvar result []*Model\r\n\t"]
[2103.16464, "o", "for _, model := range r.models {\r\n\t\tif filter != nil {\r\n\t\t\tif filter.Framework != \"\" && model.Framework != filter.Framework {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
[2103.165144, "o", "\u001b[?2004h"]
[2103.165202, "o", "root@n30009:/app# "]
