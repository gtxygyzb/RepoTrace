[3028.533103, "o", "    75\t\r\n    76\t// Execute runs a pipeline with the given initial input data.\r\n    77\tfunc (e *Engine) Execute(p *Pipeline, initialInput map[string]interface{}) (*PipelineResult, error) {\r\n    78\t\tordered, err := topologicalSort(p.Steps)\r\n    79\t\tif err != nil {\r\n    80\t\t\treturn nil, fmt.Errorf(\"dependency resolution failed: %w\", err)\r\n    81\t\t}\r\n    82\t\r\n    83\t\tpipelineStart := time.Now()\r\n"]
