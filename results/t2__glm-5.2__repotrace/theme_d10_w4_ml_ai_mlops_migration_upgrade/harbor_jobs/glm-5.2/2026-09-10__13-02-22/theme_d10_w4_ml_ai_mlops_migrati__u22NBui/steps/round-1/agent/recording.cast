[1603.622768, "i", "cat > internal/api/batch.go <<'EOF'\npackage api\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"time\"\n\n\t\"gomlops/internal/serving\"\n)\n\ntype batchRequest struct {\n\tRequests []serving.InferenceRequest `json:\"requests\"`\n\tStrategy string                     `json:\"strategy\"`\n}\n\nfunc (h *Handlers) BatchInfer(w http.ResponseWriter, r *http.Request) {\n\tvar req batchRequest\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\n\t\treturn\n\t}\n\tif len(req.Requests) == 0 {\n\t\twriteError(w, http.StatusBadRequest, \"requests array is required and cannot be empty\")\n\t\treturn\n\t}\n\tstrategy := req.Strategy\n\tif strategy == \"\" {\n\t\tstrategy = \"independent\"\n\t}\n\tif strategy != \"independent\" && strategy != \"stop_on_error\" {\n\t\twriteError(w, http.StatusBadRequest, \"invalid strategy %q\", strategy)\n\t\treturn\n\t}\n\n\tstart := time.Now()\n\tresults := make([]map[string]interface{}, 0, len(req.Requests))\n\tsucceeded := 0\n\tfailed := 0\n\tskipped := 0\n\tstop := false\n\n\tfor i, ir"]
[1603.623088, "i", " := range req.Requests {\n\t\tif stop {\n\t\t\tresults = append(results, map[string]interface{}{\n\t\t\t\t\"model_name\": ir.ModelName,\n\t\t\t\t\"status\":    \"skipped\",\n\t\t\t})\n\t\t\tskipped++\n\t\t\tcontinue\n\t\t}\n\n\t\tif ir.ModelName == \"\" {\n\t\t\tresults = append(results, map[string]interface{}{\n\t\t\t\t\"model_name\": ir.ModelName,\n\t\t\t\t\"error\":      \"model_name is required\",\n\t\t\t})\n\t\t\tfailed++\n\t\t\tif strategy == \"stop_on_error\" {\n\t\t\t\tstop = true\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\n\t\tresp, err := h.Serving.Infer(&ir)\n\t\tif err != nil {\n\t\t\tresults = append(results, map[string]interface{}{\n\t\t\t\t\"model_name\": ir.ModelName,\n\t\t\t\t\"error\":      err.Error(),\n\t\t\t})\n\t\t\tfailed++\n\t\t\tif strategy == \"stop_on_error\" {\n\t\t\t\tstop = true\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\n\t\tresults = append(results, map[string]interface{}{\n\t\t\t\"model_name\":   resp.ModelName,\n\t\t\t\"version\":      resp.Version,\n\t\t\t\"predictions\":  resp.Predictions,\n\t\t\t\"latency_ms\":   resp.LatencyMs,\n\t\t})\n\t\tsucceeded++\n\t\t_ = i\n\t}\n\n\tsummary := map[string]int{\n\t\t\"total\":     len(req.Requests),\n\t\t\"succeeded\": succeeded,\n\t\t\"failed\":    fai"]
[1603.623194, "i", "led,\n\t}\n\tif strategy == \"stop_on_error\" {\n\t\tsummary[\"skipped\"] = skipped\n\t}\n\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\n\t\t\"results\":          results,\n\t\t\"total_latency_ms\": float64(time.Since(start).Microseconds()) / 1000.0,\n\t\t\"summary\":          summary,\n\t})\n}\nEOF\n"]
[1603.623225, "o", "cat > internal/api/batch.go <<'EOF'\r\n\u001b[?2004l\r"]
[1603.623329, "o", "led,\r\n\t}\r\n\tif strategy == \"stop_on_error\" {\r\n\t\tsummary[\"skipped\"] = skipped\r\n\t}\r\n\r\n\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\t\t\"results\":          results,\r\n\t\t\"total_latency_ms\": float64(time.Since(start).Microseconds()) / 1000."]
[1603.623394, "o", "0,\r\n\t\t\"summary\":          summary,\r\n\t})\r\n}\r\nEOF\r\n\u001b[?2004h"]
