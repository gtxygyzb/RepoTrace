[5676.920645, "o", "   127\t// AggregateMetric computes an aggregate statistic for a given metric across all runs\r\n   128\t// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.\r\n   129\t// For weighted_mean, weightParam specifies which parameter to use as weight.\r\n   130\tfunc (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string, tagFilters map[string]string) (float64, int, []string, error) {\r\n   131\t\tt.mu.RLock()\r\n   132\t\tdefer t.mu.RUnlock()\r\n"]
[5676.920774, "o", "   133\t\r\n   134\t\texp, exists := t.experiments[experimentName]\r\n   135\t\tif !exists {\r\n   136\t\t\treturn 0, 0, nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   137\t\t}\r\n   138\t\r\n   139\t\tif len(exp.Runs) == 0 {\r\n   140\t\t\treturn 0, 0, nil, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n   141\t\t}\r\n   142\t\r\n   143\t\tvar values []float64\r\n   144\t\tvar weights []float64\r\n   145\t\tvar runIDs []string\r\n   146\t\tfor _, run := range exp.Runs {\r\n   147\t\t\tif !matchTags(run.Tags, tagFilters) {\r\n   148\t\t\t\tcontinue\r\n   149\t\t\t}\r\n   150\t\t\tvalue, ok := run.Metrics[metricName]\r\n   151\t\t\tif !ok {\r\n   152\t\t\t\tcontinue\r\n   153\t\t\t}\r\n   154\t\t\tif aggType == \"weighted_mean\" {\r\n   155\t\t\t\tweight, ok := run.Metrics[weightParam]\r\n   156\t\t\t\tif !ok {\r\n   157\t\t\t\t\tcontinue\r\n   158\t\t\t\t}\r\n   159\t\t\t\tvalues = append(values, value)\r\n   160\t\t\t\tweights = append(weights, weight)\r\n   161\t\t\t\trunIDs = append(runIDs, run.ID)\r\n   162\t\t\t} else {\r\n   163\t\t\t\tvalues = append(values, value)\r\n   164\t\t\t\trunIDs = append(runIDs, run.ID)\r\n   165\t\t\t}\r\n"]
[5676.920954, "o", "   166\t\t}\r\n   167\t\r\n   168\t\tif len(values) == 0 {\r\n   169\t\t\tif len(tagFilters) > 0 {\r\n   170\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"no runs match tag filters for metric %q\", metricName)\r\n   171\t\t\t}\r\n   172\t\t\treturn 0, 0, nil, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n   173\t\t}\r\n   174\t\r\n   175\t\tswitch aggType {\r\n"]
