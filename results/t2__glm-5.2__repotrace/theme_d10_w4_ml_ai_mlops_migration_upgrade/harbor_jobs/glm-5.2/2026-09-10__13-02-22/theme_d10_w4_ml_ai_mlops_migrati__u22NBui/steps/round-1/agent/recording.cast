[1442.634185, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1442.634235, "o", "> \r\n\u001b[?2004l\r"]
[1442.634283, "o", "\u001b[?2004h> "]
[1442.634819, "o", "// Engine executes pipelines by resolving step dependencies and running each step.\r\n\u001b[?2004l\r"]
[1442.634884, "o", "\u001b[?2004h> "]
[1442.635029, "o", "type Engine struct {\r\n\u001b[?2004l\r"]
