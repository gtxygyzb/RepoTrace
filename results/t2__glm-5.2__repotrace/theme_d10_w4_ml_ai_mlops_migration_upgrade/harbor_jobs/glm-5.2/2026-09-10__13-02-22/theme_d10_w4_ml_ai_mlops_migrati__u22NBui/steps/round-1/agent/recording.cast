[5791.373521, "o", "\t\tr.mu.Lock()\r\n   376\t\tdefer r.mu.Unlock()\r\n   377\t\r\n   378\t\tif _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {\r\n   379\t\t\treturn nil, err\r\n   380\t\t}\r\n   381\t\tif !validateAnnotationKey(key) {\r\n   382\t\t\treturn nil, fmt.Errorf(\"invalid annotation key\")\r\n   383\t\t}\r\n   384\t\r\n   385\t\tif r.annotations[modelName] == nil {\r\n   386\t\t\tr.annotations[modelName] = make(map[int]map[string]*Annotation)\r\n   387\t\t}\r\n   388\t\tif r.annotations[modelName][versionNum] == nil {\r\n   389\t\t\tr.annotations[modelName][versionNum] = make(map[string]*Annotation)\r\n   390\t\t}\r\n   391\t\tif _, exists := r.annotations[modelName][versionNum][key]; exists {\r\n   392\t\t\treturn nil, fmt.Errorf(\"annotation %q already exists\", key)\r\n   393\t\t}\r\n   394\t"]
[5791.373592, "o", "\r\n   395\t\tannotation := &Annotation{\r\n   396\t\t\tKey:       key,\r\n   397\t\t\tValue:     value,\r\n   398\t\t\tCreatedAt: time.Now(),\r\n   399\t\t}\r\n   400\t\tr.annotations[modelName][versionNum][key] = annotation\r\n   401\t\treturn annotation, nil\r\n   402\t}\r\n"]
