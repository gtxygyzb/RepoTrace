[5689.477144, "o", "\tfunc ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   156\t\tdata, ok := input[\"data\"].([]interface{})\r\n   157\t\tif !ok {\r\n   158\t\t\treturn nil, fmt.Errorf(\"aggregate: missing or invalid 'data' field\")\r\n   159\t\t}\r\n   160\t\r\n   161\t\toperation, _ := config[\"operation\"].(string)\r\n   162\t\tif operation == \"\" {\r\n   163\t\t\treturn nil, fmt.Errorf(\"aggregate: missing 'operation' in config\")\r\n   164\t\t}\r\n   165\t\r\n   166\t\tvalues := make([]float64, 0, len(data))\r\n   167\t"]
[5689.477215, "o", "\tfor _, v := range data {\r\n   168\t\t\tval, err := toFloat(v)\r\n   169\t\t\tif err != nil {\r\n   170\t\t\t\tcontinue\r\n   171\t\t\t}\r\n   172\t\t\tvalues = append(values, val)\r\n   173\t\t}\r\n   174\t\r\n   175\t\tif len(values) == 0 {\r\n   176\t\t\treturn map[string]interface{}{\"result\": 0.0, \"count\": 0.0}, nil\r\n   177\t\t}\r\n"]
[5689.477293, "o", "   178\t\r\n   179\t\tvar result float64\r\n   180\t\tswitch operation {\r\n   181\t\tcase \"sum\":\r\n   182\t\t\tfor _, v := range values {\r\n   183\t\t\t\tresult += v\r\n   184\t\t\t}\r\n   185\t\tcase \"mean\":\r\n   186\t\t\tfor _, v := range values {\r\n   187\t\t\t\tresult += v\r\n"]
[5689.47737, "o", "   188\t\t\t}\r\n   189\t\t\tresult /= float64(len(values))\r\n   190\t\tcase \"count\":\r\n   191\t\t\tresult = float64(len(values))\r\n   192\t\tcase \"min\":\r\n   193\t\t\tresult = values[0]\r\n   194\t\t\tfor _, v := range values[1:] {\r\n   195\t\t\t\tif v < result {\r\n   196\t\t\t\t\tresult = v\r\n   197\t\t\t\t}\r\n   198\t\t\t"]
[5689.477442, "o", "}\r\n   199\t\tcase \"max\":\r\n   200\t\t\tresult = values[0]\r\n   201\t\t\tfor _, v := range values[1:] {\r\n   202\t\t\t\tif v > result {\r\n   203\t\t\t\t\tresult = v\r\n   204\t\t\t\t}\r\n   205\t\t\t}\r\n   206\t\tcase \"range\":\r\n   207\t\t\tif len(values) < 2 {\r\n   208\t\t\t\tresult = 0.0\r\n"]
[5689.477515, "o", "   209\t\t\t} else {\r\n   210\t\t\t\tminVal := values[0]\r\n   211\t\t\t\tmaxVal := values[0]\r\n   212\t\t\t\tfor _, v := range values[1:] {\r\n   213\t\t\t\t\tif v < minVal {\r\n   214\t\t\t\t\t\tminVal = v\r\n   215\t\t\t\t\t}\r\n   216\t\t\t\t\tif v > maxVal {\r\n   217\t\t\t\t\t\tmaxVal = v\r\n   218\t\t\t\t"]
[5689.477584, "o", "\t}\r\n   219\t\t\t\t}\r\n   220\t\t\t\tresult = maxVal - minVal\r\n   221\t\t\t}\r\n   222\t\tdefault:\r\n   223\t\t\treturn nil, fmt.Errorf(\"aggregate: unknown operation %q\", operation)\r\n   224\t\t}\r\n   225\t\r\n   226\t\treturn map[string]interface{}{\r\n"]
[5689.477662, "o", "   227\t\t\t\"result\": result,\r\n   228\t\t\t\"count\":  float64(len(values)),\r\n   229\t\t\t\"data\":   data,\r\n   230\t\t}, nil\r\n   231\t}\r\n   232\t\r\n   233\t// ExecuteExport formats data for output.\r\n   234\t// Supported formats: json, csv, summary.\r\n   235\tfunc ExecuteExport(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   236\t\tformat, _ := config[\"format\"].(string)\r\n   237\t\tif format == \"\" {\r\n   238\t\t\tformat = \"json\"\r\n"]
