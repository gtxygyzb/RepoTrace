[6463.368617, "o", "\u001b[35m\u001b[K./internal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (e *Engine) Validate\u001b[m\u001b[K(p *Pipeline) *ValidationResult {\r\n"]
[6463.368756, "o", "\u001b[35m\u001b[K./internal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"\u001b[01;31m\u001b[Kduplicate step name\u001b[m\u001b[K: %s\", name))\r\n"]
