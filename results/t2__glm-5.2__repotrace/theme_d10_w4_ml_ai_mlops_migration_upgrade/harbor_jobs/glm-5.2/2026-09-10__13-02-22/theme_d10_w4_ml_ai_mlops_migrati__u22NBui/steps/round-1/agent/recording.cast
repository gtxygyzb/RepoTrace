[2520.510747, "o", "new_getmodel = '''func (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[2520.510802, "o", "\u001b[?2004h> "]
[2520.510998, "o", "\\tname := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[2520.511054, "o", "\u001b[?2004h> "]
[2520.51129, "o", "\\tmodel, err := h.Registry.GetModel(name)\r\n\u001b[?2004l\r"]
[2520.511347, "o", "\u001b[?2004h> "]
[2520.511452, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[2520.511508, "o", "\u001b[?2004h> "]
