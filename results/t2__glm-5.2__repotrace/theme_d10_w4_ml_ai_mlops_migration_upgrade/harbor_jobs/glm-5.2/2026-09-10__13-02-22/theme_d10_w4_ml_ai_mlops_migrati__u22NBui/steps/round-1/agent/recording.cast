[4187.072667, "o", "\"status\":     \"skipped\",\r\n    47\t\t\t\t})\r\n    48\t\t\t\tskipped++\r\n    49\t\t\t\tcontinue\r\n    50\t\t\t}\r\n    51\t\r\n    52\t\t\tif ir.ModelName == \"\" {\r\n    53\t\t\t\tresults = append(results, map[string]interface{}{\r\n    54\t\t\t\t\t\"model_name\": ir.ModelName,\r\n    55\t\t\t\t\t\"error\":      \"model_name is required\",\r\n    56\t\t\t\t})\r\n    57\t\t\t\tfailed++\r\n    58\t\t\t\tif strategy == \"stop_on_error\" {\r\n    59\t\t\t\t\tstop = true\r\n    60\t\t\t\t}\r\n    61\t\t\t\tcontinue\r\n    62\t\t\t}\r\n"]
