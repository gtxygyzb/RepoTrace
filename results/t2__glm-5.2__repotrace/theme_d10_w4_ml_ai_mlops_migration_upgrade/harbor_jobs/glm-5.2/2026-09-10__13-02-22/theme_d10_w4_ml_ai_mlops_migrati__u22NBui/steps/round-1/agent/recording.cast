[4192.514652, "o", "    91\t\tvar err error\r\n    92\t\r\n    93\t\tif versionNum > 0 {\r\n    94\t\t\tversion, err = s.registry.GetVersion(modelName, versionNum)\r\n    95\t\t} else if stage != \"\" {\r\n    96\t\t\tversion, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))\r\n    97\t\t} else {\r\n    98\t\t\treturn fmt.Errorf(\"must specify version number or stage\")\r\n    99\t\t}\r\n"]
