[890.031619, "o", "import json, urllib.request, urllib.error, time\r\n\u001b[?2004l\r"]
[890.031677, "o", "\u001b[?2004h> \r\n"]
[890.03171, "o", "\u001b[?2004l\r\u001b[?2004h"]
[890.031791, "o", "> "]
[890.032032, "o", "BASE = \"http://localhost:8080/api/v1\"\r\n\u001b[?2004l\r"]
[890.032101, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[890.032169, "o", "\u001b[?2004h> "]
[890.032387, "o", "def req(method, path, body=None):\r\n\u001b[?2004l\r"]
[890.032455, "o", "\u001b[?2004h> "]
[890.032911, "o", "    data = json.dumps(body).encode() if body is not None else None\r\n\u001b[?2004l\r"]
[890.032981, "o", "\u001b[?2004h> "]
[890.033726, "o", "    r = urllib.request.Request(BASE+path, data=data, method=method, headers={\"Content-Type\":\"application/json\"})\r\n\u001b[?2004l\r"]
[890.033794, "o", "\u001b[?2004h> "]
[890.033887, "o", "    try:\r\n\u001b[?2004l\r"]
[890.033957, "o", "\u001b[?2004h> "]
[890.034322, "o", "        with urllib.request.urlopen(r, timeout=5) as resp:\r\n\u001b[?2004l\r"]
[890.034388, "o", "\u001b[?2004h> "]
[890.034814, "o", "            return resp.status, json.loads(resp.read().decode())\r\n\u001b[?2004l\r"]
[890.03489, "o", "\u001b[?2004h> "]
[890.035165, "o", "    except urllib.error.HTTPError as e:\r\n\u001b[?2004l\r"]
[890.035235, "o", "\u001b[?2004h> "]
[890.035584, "o", "        return e.code, json.loads(e.read().decode())\r\n\u001b[?2004l\r"]
[890.03565, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[890.035718, "o", "\u001b[?2004h> "]
