[2920.169253, "o", "   351\tfunc (h *Handlers) CompareVersionMetrics(w http.ResponseWriter, r *http.Request) {\r\n   352\t\tmodelName := r.PathValue(\"name\")\r\n   353\t\tversionParam := r.URL.Query().Get(\"versions\")\r\n   354\t\tif versionParam == \"\" {\r\n   355\t\t\twriteError(w, http.StatusBadRequest, \"query parameter 'versions' is required\")\r\n   356\t\t\treturn\r\n   357\t\t}\r\n   358\t\r\n   359\t\tparts := strings.Split(versionParam, \",\")\r\n   360\t\tseen := map[int]bool{}\r\n   361\t\tversionNums := make([]int, 0, len(parts))\r\n   362\t\tfor _, p := range parts {\r\n   363\t\t\tnum, err := strconv.Atoi(strings.TrimSpace(p))\r\n   364"]
[2920.169446, "o", "\t\t\tif err != nil {\r\n   365\t\t\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %q\", p)\r\n   366\t\t\t\treturn\r\n   367\t\t\t}\r\n   368\t\t\tif seen[num] {\r\n   369\t\t\t\twriteError(w, http.StatusBadRequest, \"duplicate version number: %d\", num)\r\n   370\t\t\t\treturn\r\n   371\t\t\t}\r\n   372\t\t\tseen[num] = true\r\n   373\t\t\tversionNums = append(versionNums, num)\r\n   374\t\t}\r\n   375\t\tif len(versionNums) < 2 {\r\n   376\t\t\twriteError(w, http.StatusBadRequest, \"at least 2 versions are required for comparison\")\r\n   377\t\t\treturn\r\n   378\t\t}\r\n   379\t\r\n   380\t\tmodel, err := h.Registry.GetModel(modelName)\r\n   381\t\tif err != nil {\r\n   382\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   383\t\t\treturn\r\n   384\t\t}\r\n   385\t\r\n   386\t\tsort.Ints(versionNums)\r\n   387\t\tversionMap := map[int]*registry.Version{}\r\n   388\t\tfor _, v := range model.Versions {\r\n   389\t\t\tversionMap[v.Number] = v\r\n   390\t\t}\r\n   391\t\r\n"]
[2920.16956, "o", "   392\t\tversions := make([]map[string]interface{}, 0, len(versionNums))\r\n   393\t\tfor _, num := range versionNums {\r\n   394\t\t\tv, ok := versionMap[num]\r\n   395\t\t\tif !ok {\r\n   396\t\t\t\twriteError(w, http.StatusBadRequest, \"version %d does not exist for model %q\", num, modelName)\r\n   397\t\t\t\treturn\r\n   398\t\t\t}\r\n   399\t\t\tversions = append(versions, map[string]interface{}{\r\n   400\t\t\t\t\"number\":  v.Number,\r\n   401\t\t\t\t\"stage\":   v.Stage,\r\n   402\t\t\t\t\"metrics\": v.Metrics,\r\n   403\t\t\t})\r\n   404\t\t}\r\n   405\t\r\n   406\t\tmetricSummary := map[string]map[string]interface{}{}\r\n   407\t\tmetricValues := map[string][]float64{}\r\n"]
[2920.169648, "o", "   408\t\tfor _, v := range versions {\r\n   409\t\t\tmetrics, _ := v[\"metrics\"].(map[string]float64)\r\n   410\t\t\tfor name, val := range metrics {\r\n   411\t\t\t\tmetricValues[name] = append(metricValues[name], val)\r\n   412\t\t\t}\r\n   413\t\t}\r\n   414\t\r\n   415\t\tfor name, vals := range metricValues {\r\n   416\t\t\tif len(vals) == 0 {\r\n   417\t\t\t\tcontinue\r\n   418\t\t\t}\r\n"]
[2920.169688, "o", "   419\t\t\tminVal := vals[0]\r\n   420\t\t\tmaxVal := vals[0]\r\n   421\t\t\tsum := 0.0\r\n   422\t\t\tfor _, val := range vals {\r\n   423\t\t\t\tif val < minVal {\r\n   424\t\t"]
[2920.169894, "o", "\t\t\tminVal = val\r\n   425\t\t\t\t}\r\n   426\t\t\t\tif val > maxVal {\r\n   427\t\t\t\t\tmaxVal = val\r\n   428\t\t\t\t}\r\n   429\t\t\t\tsum += val\r\n   430\t\t\t}\r\n   431\t\t\tfirst := vals[0]\r\n   432\t\t\tlast := vals[len(vals)-1]\r\n   433\t\t\timprovement := last - first\r\n   434\t\t\ttrend := \"stable\"\r\n   435\t\t\tif improvement > 0 {\r\n   436\t\t\t\ttrend = \"improving\"\r\n   437\t\t\t} else if improvement < 0 {\r\n   438\t\t\t\ttrend = \"degrading\"\r\n   439\t\t\t}\r\n   440\t\t\tmetricSummary[name] = map[string]interface{}{\r\n   441\t\t\t\t\"min\":         minVal,\r\n   442\t\t\t\t\"max\":         maxVal,\r\n   443\t\t\t\t\"first\":       first,\r\n   444\t\t\t\t\"last\":        last,\r\n   445\t\t\t\t\"improvement\": improvement,\r\n   446\t\t\t\t\"mean\":        sum / float64(len(vals)),\r\n   447\t\t\t\t\"trend\":       trend,\r\n   448\t\t\t}\r\n   449\t\t}\r\n"]
