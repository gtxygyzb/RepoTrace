[1442.61532, "i", "eDependencies(p.Steps)\n\n\tfor _, step := range ordered {\n\t\tstepStart := time.Now()\n\n\t\tresolvedConfig, err := resolveVariables(step.Config, variables, variableSetter, allDeps[step.Name])\n\t\tif err != nil {\n\t\t\tsr := &StepResult{\n\t\t\t\tStepName:   step.Name,\n\t\t\t\tStepType:   step.Type,\n\t\t\t\tStatus:     \"failed\",\n\t\t\t\tError:      err.Error(),\n\t\t\t\tDurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\n\t\t\t}\n\t\t\tresult.Steps = append(result.Steps, sr)\n\t\t\tresult.Status = \"failed\"\n\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\n\t\t\treturn result, nil\n\t\t}\n\n\t\t// Determine input for this step\n\t\tvar input map[string]interface{}\n\t\tif len(step.Dependencies) == 0 {\n\t\t\tinput = initialInput\n\t\t} else {\n\t\t\tinput = mergeDependencyOutputs(step.Dependencies, stepOutputs)\n\t\t}\n\n\t\t// Find and run the executor\n\t\texecutor, ok := e.stepExecutors[step.Type]\n\t\tif !ok {\n\t\t\tsr := &StepResult{\n\t\t\t\tStepName:   step.Name,\n\t\t\t\tStepType:   step.Type,\n\t\t\t\tStatus:     \"failed\",\n\t\t\t\tError:      fmt.Sprintf(\"unk"]
