[1122.392512, "o", "     7\t)\r\n     8\t\r\n     9\t// ExecuteTransform applies a data transformation.\r\n    10\t// Supported modes: scale, offset, normalize, identity, clip, log.\r\n    11\tfunc ExecuteTransform(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n    12\t\t"]
[1122.392603, "o", "data, ok := input[\"data\"].([]interface{})\r\n    13\t\tif !ok {\r\n    14\t\t\treturn nil, fmt.Errorf(\"transform: missing or invalid 'data' field in input\")\r\n    15\t\t}\r\n    16\t\r\n    17\t\tmode, _ := config[\"mode\"].(string)\r\n    18\t\tif mode == \"\" {\r\n    19\t\t\treturn nil, fmt.Errorf(\"transform: missing 'mode' in config\")\r\n    20\t\t}\r\n    21\t\r\n    22\t\tresult := make([]interface{}, len(data))\r\n    23\t\r\n    24\t\tswitch mode {\r\n    25\t\tcase \"scale\":\r\n    26\t\t\tfactor, _ := config[\"factor\"].(float64)\r\n    27\t\t\tfor i, v := range data {\r\n    28\t\t\t\tval, err := toFloat(v)\r\n"]
[1122.392675, "o", "    29\t\t\t\tif err != nil {\r\n    30\t\t\t\t\treturn nil, fmt.Errorf(\"transform scale: element %d: %w\", i, err)\r\n    31\t\t\t\t}\r\n    32\t\t\t\tresult[i] = val * factor\r\n    33\t\t\t}\r\n    34\t\r\n    35\t\tcase \"offset\":\r\n    36\t\t\toffset, _ := config[\"offset\"].(float64)\r\n    37\t\t\tfor i, v := range data {\r\n    38\t\t\t\tval, err := toFloat(v)\r\n    39\t\t\t\tif err != nil {\r\n    40\t\t\t\t\treturn nil, fmt.Errorf(\"transform offset: element %d: %w\", i, err)\r\n    41\t\t\t\t}\r\n    42\t\t\t\tresult[i] = val + offset\r\n    43\t\t\t}\r\n    44\t\r\n    45\t\tcase \"normalize\":\r\n"]
[1122.392749, "o", "    46\t\t\tif len(data) == 0 {\r\n    47\t\t\t\treturn map[string]interface{}{\"data\": result}, nil\r\n    48\t\t\t}\r\n    49\t\t\tminVal, maxVal := findMinMax(data)\r\n    50\t\t\tfor i, v := range data {\r\n    51\t\t\t\tval, err := toFloat(v)\r\n    52\t\t\t\tif err != nil {\r\n    53\t\t\t\t\treturn nil, fmt.Errorf(\"transform normalize: element %d: %w\", i, err)\r\n    54\t\t\t\t}\r\n    55\t"]
[1122.39289, "o", "\t\t\tif maxVal == minVal {\r\n    56\t\t\t\t\tresult[i] = 0.0\r\n    57\t\t\t\t} else {\r\n    58\t\t\t\t\tresult[i] = (val - minVal) / (maxVal - minVal)\r\n    59\t\t\t\t}\r\n    60\t\t\t}\r\n    61\t\r\n    62\t\tcase \"identity\":\r\n    63\t\t\tcopy(result, data)\r\n    64\t\r\n    65\t\tcase \"clip\":\r\n    66\t\t\tlow, _ := config[\"low\"].(float64)\r\n    67\t\t\thigh, _ := config[\"high\"].(float64)\r\n    68\t\t\tfor i, v := range data {\r\n    69\t\t\t\tval, err := toFloat(v)\r\n    70\t\t\t\tif err != nil {\r\n"]
