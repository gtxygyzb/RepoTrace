[2114.996071, "o", "\treturn nil, fmt.Errorf(\"model %q not found\", name)\r\n   198\t\t}\r\n   199\t\r\n   200\t\t// Return a copy with versions sorted\r\n   201\t\tresult := *model\r\n   202\t\tresult.Versions = make([]*Version, len(model.Versions))\r\n   203\t\tcopy(result.Versions, model.Versions)\r\n   204\t\tsort.Slice(result.Versions, func(i, j int) bool {\r\n   205\t\t\treturn result.Versions[i].Number > result.Versions[j].Number\r\n   206\t\t})\r\n"]
