[2021.012295, "o", "\tif err := h.Templates.Update(updated); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, templateResponse(updated))\r\n}\r\n\r\nfunc (h *Handlers) DeleteTemplate(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\tif err := h.Templates.Delete(name); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n}\r\n\r\nfunc (h *Handlers) ExecuteTemplate(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n"]
