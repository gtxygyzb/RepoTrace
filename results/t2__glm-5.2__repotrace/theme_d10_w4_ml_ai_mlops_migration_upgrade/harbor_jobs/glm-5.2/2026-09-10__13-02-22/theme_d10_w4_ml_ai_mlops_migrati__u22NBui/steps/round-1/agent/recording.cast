[7854.557249, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path(\"internal/pipeline/engine.go\")\ntext = p.read_text()\nold = '''\tfor _, step := range p.Steps {\n\t\tif step == nil {\n\t\t\tcontinue\n\t\t}\n\t\tif _, exists := e.stepExecutors[step.Type]; !exists {\n\t\t\tresult.Valid = false\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"unknown step type: %s\", step.Type))\n\t\t}\n\t\tfor _, dep := range step.Dependencies {\n\t\t\tif dep == step.Name {\n\t\t\t\tresult.Valid = false\n\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"step %q depends on itself\", step.Name))\n\t\t\t}\n\t\t\tif !seen[dep] {\n\t\t\t\tresult.Valid = false\n\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"step %s depends on unknown step: %s\", step.Name, dep))\n\t\t\t}\n\t\t}\n\t}\n\n\tordered, err := topologicalSort(p.Steps)\n\tif err != nil {\n\t\tresult.Valid = false\n\t\tif strings.Contains(err.Error(), \"cycle\") {\n\t\t\tresult.Errors = append(result.Errors, \"dependency cycle detected\")\n\t\t}\n\t}\n'''\nnew = '''\tselfDependencyFound := false\n\tfor _, step := range p.Steps {\n\t\tif step == nil {\n\t\t\tcontinue\n\t"]
[7854.557532, "i", "\t}\n\t\tif _, exists := e.stepExecutors[step.Type]; !exists {\n\t\t\tresult.Valid = false\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"unknown step type: %s\", step.Type))\n\t\t}\n\t\tfor _, dep := range step.Dependencies {\n\t\t\tif dep == step.Name {\n\t\t\t\tresult.Valid = false\n\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"step %q depends on itself\", step.Name))\n\t\t\t\tselfDependencyFound = true\n\t\t\t}\n\t\t\tif !seen[dep] {\n\t\t\t\tresult.Valid = false\n\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"step %s depends on unknown step: %s\", step.Name, dep))\n\t\t\t}\n\t\t}\n\t}\n\n\tordered, err := topologicalSort(p.Steps)\n\tif err != nil {\n\t\tresult.Valid = false\n\t\tif strings.Contains(err.Error(), \"cycle\") && !selfDependencyFound {\n\t\t\tresult.Errors = append(result.Errors, \"dependency cycle detected\")\n\t\t}\n\t}\n'''\nif old not in text:\n    raise SystemExit(\"validation block not found\")\np.write_text(text.replace(old, new, 1))\nprint(\"patched\")\nPY\n"]
