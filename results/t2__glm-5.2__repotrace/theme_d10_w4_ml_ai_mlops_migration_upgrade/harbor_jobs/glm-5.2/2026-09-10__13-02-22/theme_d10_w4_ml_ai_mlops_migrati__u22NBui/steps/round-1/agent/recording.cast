[4116.427227, "o", "\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\te.stepExecutors[\u001b[01;31m\u001b[KStep\u001b[m\u001b[KTransform] = ExecuteTransform\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\te.stepExecutors[\u001b[01;31m\u001b[KStep\u001b[m\u001b[KValidate] = ExecuteValidate\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\te.stepExecutors[\u001b[01;31m\u001b[KStep\u001b[m\u001b[KAggregate] = ExecuteAggregate\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\te.stepExecutors[\u001b[01;31m\u001b[KStep\u001b[m\u001b[KExport] = ExecuteExport\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\te.stepExecutors[\u001b[01;31m\u001b[KStep\u001b[m\u001b[KFilter] = ExecuteFilter\r\n"]
[4116.427292, "o", "\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype \u001b[m\u001b[KValidationResult struct {\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KStep\u001b[m\u001b[KCount      int             `json:\"step_count\"`\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KStep\u001b[m\u001b[Ks          []Validated\u001b[01;31m\u001b[KStep\u001b[m\u001b[K `json:\"steps\"`\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// Validated\u001b[01;31m\u001b[KStep\u001b[m\u001b[K contains structural details for a validated step.\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype \u001b[m\u001b[KValidated\u001b[01;31m\u001b[KStep\u001b[m\u001b[K struct {\r\n"]
[4116.427358, "o", "\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tType         \u001b[01;31m\u001b[KStep\u001b[m\u001b[KType `json:\"type\"`\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(e *Engine) Validate(p *Pipeline) *ValidationResult {\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KStep\u001b[m\u001b[Ks:          []Validated\u001b[01;31m\u001b[KStep\u001b[m\u001b[K{},\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tstepCount := len(p.\u001b[01;31m\u001b[KStep\u001b[m\u001b[Ks)\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tresult.\u001b[01;31m\u001b[KStep\u001b[m\u001b[KCount = stepCount\r\n\u001b[35m\u001b[Kinternal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, step := range p.\u001b[01;31m\u001b[KStep\u001b[m\u001b[Ks {\r\n"]
