[6497.085549, "o", "   151\tfunc (e *Engine) Validate(p *Pipeline) *ValidationResult {\r\n   152\t\tresult := &ValidationResult{\r\n   153\t\t\tValid:          true,\r\n   154\t\t\tExecutionOrder: []string{},\r\n   155\t\t\tSteps:          []ValidatedStep{},\r\n"]
[6497.085627, "o", "   156\t\t\tErrors:         []string{},\r\n   157\t\t}\r\n   158\t\tif p == nil {\r\n   159\t\t\tresult.Valid = false\r\n   160\t\t\tresult.Errors = append(result.Errors, \"pipeline definition is required\")\r\n   161\t\t\treturn result\r\n   162\t\t}\r\n   163\t\r\n   164\t\tstepCount := len(p.Steps)\r\n   165\t\tresult.StepCount = stepCount\r\n   166"]
[6497.085701, "o", "\t\r\n   167\t\tseen := make(map[string]bool)\r\n   168\t\tduplicateNames := make(map[string]bool)\r\n   169\t\tnameOrder := make([]string, 0, stepCount)\r\n   170\t\r\n   171\t\tfor i, step := range p.Steps {\r\n   172\t\t\tif step == nil {\r\n   173\t\t\t\tresult.Valid = false\r\n   174\t\t\t\tresult.Errors = append(result.Errors, \"step is null\")\r\n"]
[6497.085762, "o", "   175\t\t\t\tcontinue\r\n   176\t\t\t}\r\n   177\t\t\tif step.Name == \"\" {\r\n   178\t\t\t\tresult.Valid = false\r\n   179\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"step at index %d has empty name\", i))\r\n   180\t\t\t\tcontinue\r\n   181\t\t\t}\r\n   182\t\t\tresult.Steps = append(result.Steps, ValidatedStep{\r\n"]
[6497.085823, "o", "   183\t\t\t\tName:         step.Name,\r\n   184\t\t\t\tType:         step.Type,\r\n   185\t\t\t\tDependencies: step.Dependencies,\r\n   186\t\t\t})\r\n   187\t\t\tif seen[step.Name] {\r\n   188\t\t\t\tduplicateNames[step.Name] = true\r\n   189\t\t\t}\r\n   190\t\t\tif !seen[step.Name] {\r\n"]
[6497.08591, "o", "   191\t\t\t\tseen[step.Name] = true\r\n   192\t\t\t\tnameOrder = append(nameOrder, step.Name)\r\n   193\t\t\t}\r\n   194\t\t}\r\n   195\t\tif len(duplicateNames) > 0 {\r\n"]
[6497.085974, "o", "   196\t\t\tresult.Valid = false\r\n   197\t\t\tfor name := range duplicateNames {\r\n   198\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"duplicate step name: %s\", name))\r\n   199\t\t\t}\r\n   200\t\t}\r\n   201\t\r\n   202\t\tfor _, step := range p.Steps {\r\n   203\t\t\tif step == nil {\r\n   204\t\t\t\tcontinue\r\n"]
[6497.086034, "o", "   205\t\t\t}\r\n   206\t\t\tif _, exists := e.stepExecutors[step.Type]; !exists {\r\n   207\t\t\t\tresult.Valid = false\r\n   208\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"unknown step type: %s\", step.Type))\r\n   209\t\t\t}\r\n   210\t\t\tfor _, dep := range step.Dependencies {\r\n   211\t\t\t\tif !seen[dep] {\r\n"]
[6497.086091, "o", "   212\t\t\t\t\tresult.Valid = false\r\n   213\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"step %s depends on unknown step: %s\", step.Name, dep))\r\n   214\t\t\t\t}\r\n   215\t\t\t}\r\n"]
