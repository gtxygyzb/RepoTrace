[5682.252835, "o", "    12\t)\r\n    13\t\r\n    14\t// Stage represents the lifecycle stage of a model version.\r\n    15\ttype Stage string\r\n    16\t\r\n    17\tconst (\r\n    18\t\tStageDevelopment Stage = \"development\"\r\n    19\t\tStageStaging     Stage = \"staging\"\r\n    20\t\tStageProduction  Stage = \"production\"\r\n    21\t\tStageArchived    Stage = \"archived\"\r\n    22\t)\r\n    23\t\r\n    24\tvar validTransitions = map[Stage][]Stage{\r\n    25\t\tStageDevelopment: {StageStaging, StageArchived},\r\n    26\t\tStageStaging:     {StageProduction, StageArchived},\r\n    27\t\tStageProduction:  {StageArchived},\r\n    28\t\tStageArchived:    {},\r\n"]
[5682.252933, "o", "    29\t}\r\n    30\t\r\n    31\t// PromotionRecord records a single stage transition in a version's lineage.\r\n    32\ttype PromotionRecord struct {\r\n    33\t\tFromStage Stage  `json:\"from_stage\"`\r\n    34\t\tToStage   Stage  `json:\"to_stage\"`\r\n    35\t\tTimestamp string `json:\"timestamp\"`\r\n    36\t}\r\n    37\t\r\n    38\t// Version represents a specific version of a model.\r\n    39\ttype Version struct {\r\n    40\t\tNumber      int                    `json:\"number\"`\r\n    41"]
[5682.25302, "o", "\t\tStage       Stage                  `json:\"stage\"`\r\n    42\t\tMetrics     map[string]float64     `json:\"metrics\"`\r\n    43\t\tTags        []string               `json:\"tags\"`\r\n    44\t\tModelConfig map[string]interface{} `json:\"model_config,omitempty\"`\r\n    45\t\tCreatedAt   time.Time              `json:\"created_at\"`\r\n    46\t\tLineage     []PromotionRecord      `json:\"lineage\"`\r\n    47\t\tDemotedBy   int                    `json:\"demoted_by,omitempty\"`\r\n    48\t}\r\n    49\t\r\n    50\t// Model represents a registered ML model.\r\n    51\ttype Model struct {\r\n    52\t\tName         string     `json:\"name\"`\r\n"]
