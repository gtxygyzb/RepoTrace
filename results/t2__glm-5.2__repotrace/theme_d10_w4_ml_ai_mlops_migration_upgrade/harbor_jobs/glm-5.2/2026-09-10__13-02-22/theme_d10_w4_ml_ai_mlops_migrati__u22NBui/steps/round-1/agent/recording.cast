[6652.120503, "o", "   255\t\tvariables := make(map[string]float64)\r\n   256\t\tvariableSetter := make(map[string]string)\r\n   257\t\tallDeps := computeTransitiveDependencies(p.Steps)\r\n   258\t\r\n   259\t\tfor _, step := range ordered {\r\n   260\t\t\tstepStart := time.Now()\r\n   261\t\r\n   262\t\t\tresolvedConfig, err := resolveVariables(step.Config, variables, variableSetter, allDeps[step.Name])\r\n   263\t\t\tif err != nil {\r\n   264\t\t\t\tsr := &StepResult{\r\n   265\t\t\t\t\tStepName:   step.Name,\r\n   266\t\t\t\t\tStepType:   step.Type,\r\n   267\t\t\t\t\tStatus:     \"failed\",\r\n   268\t\t\t\t\tError:      err.Error(),\r\n   269\t\t\t\t\tDurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\r\n   270\t\t\t\t}\r\n   271\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   272\t\t\t\tresult.Status = \"failed\"\r\n   273\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   274\t\t\t\treturn result, nil\r\n   275\t\t\t}\r\n   276\t\r\n   277\t\t\t// Determine input for this step\r\n   278\t\t\tvar input map[string]interface{}\r\n   279\t"]
