[794.421733, "o", "import json, urllib.request, urllib.error, time\r\n\u001b[?2004l\r"]
[794.421789, "o", "\u001b[?2004h"]
[794.421848, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[794.421922, "o", "> "]
[794.422153, "o", "BASE = \"http://localhost:8080/api/v1\"\r\n\u001b[?2004l\r"]
[794.42221, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[794.42227, "o", "\u001b[?2004h> "]
[794.422515, "o", "def req(method, path, body=None):\r\n\u001b[?2004l\r"]
[794.422565, "o", "\u001b[?2004h> "]
[794.423053, "o", "    data = json.dumps(body).encode() if body is not None else None\r\n\u001b[?2004l\r"]
[794.423088, "o", "\u001b[?2004h"]
[794.423174, "o", "> "]
[794.423962, "o", "    r = urllib.request.Request(BASE+path, data=data, method=method, headers={\"Content-Type\":\"application/json\"})\r\n\u001b[?2004l\r"]
[794.424016, "o", "\u001b[?2004h> "]
[794.424095, "o", "    try:\r\n\u001b[?2004l\r"]
[794.424159, "o", "\u001b[?2004h> "]
[794.424575, "o", "        with urllib.request.urlopen(r, timeout=5) as resp:\r\n\u001b[?2004l\r"]
[794.424631, "o", "\u001b[?2004h> "]
[794.425096, "o", "            return resp.status, json.loads(resp.read().decode())\r\n\u001b[?2004l\r"]
[794.425157, "o", "\u001b[?2004h> "]
[794.425432, "o", "    except urllib.error.HTTPError as e:\r\n\u001b[?2004l\r"]
[794.425497, "o", "\u001b[?2004h> "]
[794.425884, "o", "        return e.code, json.loads(e.read().decode())\r\n\u001b[?2004l\r"]
[794.425958, "o", "\u001b[?2004h"]
[794.426014, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[794.426282, "o", "suf = str(int(time.time()*1000))[-6:]\r\n\u001b[?2004l\r"]
[794.426348, "o", "\u001b[?2004h> "]
[794.42644, "o", "results = []\r\n\u001b[?2004l\r"]
[794.426497, "o", "\u001b[?2004h> "]
[794.426731, "o", "def check(name, cond, detail=\"\"):\r\n\u001b[?2004l\r"]
[794.426795, "o", "\u001b[?2004h> "]
[794.427086, "o", "    results.append((name, cond, detail))\r\n\u001b[?2004l\r"]
[794.427134, "o", "\u001b[?2004h> "]
[794.42755, "o", "    print((\"PASS\" if cond else \"FAIL\"), name, detail)\r\n\u001b[?2004l\r"]
[794.427606, "o", "\u001b[?2004h"]
[794.427662, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
