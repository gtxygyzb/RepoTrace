[5855.688006, "o", "     1\tpackage experiment\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"math\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t"]
[5855.688163, "o", "\t\"sort\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t\t\"sync\"\r\n    13\t\t\"time\"\r\n    14\t)\r\n    15\t\r\n    16\t// Experiment groups related runs together.\r\n    17\ttype Experiment struct {\r\n    18\t\tName      string    `json:\"name\"`\r\n    19\t\t"]
[5855.688268, "o", "Runs      []*Run    `json:\"runs\"`\r\n    20\t\tCreatedAt time.Time `json:\"created_at\"`\r\n    21\t}\r\n    22\t\r\n    23\t// Run records a single experiment execution with parameters and metrics.\r\n    24\ttype Run struct {\r\n    25\t\tID         string             `json:\"id\"`\r\n    26\t\tParameters map[string]float64 `json:\"parameters\"`\r\n    27\t\tMetrics    map[string]float64 `json:\"metrics\"`\r\n    28\t\tTags       map[string]string  `json:\"tags\"`\r\n    29\t\tCreatedAt  time.Time          `json:\"created_at\"`\r\n    30\t}\r\n    31\t\r\n    32\t// Tracker manages experiments and their runs.\r\n    33\ttype Tracker struct {\r\n    34\t\tmu          sync.RWMutex\r\n    35\t\texperiments map[string]*Experiment\r\n    36\t\tdataDir     string\r\n"]
[5855.688371, "o", "    37\t\trunCounter  int\r\n    38\t}\r\n    39\t\r\n    40\t// NewTracker creates a new experiment tracker backed by the given data directory.\r\n    41\tfunc NewTracker(dataDir string) *Tracker {\r\n    42\t\tos.MkdirAll(dataDir, 0755)\r\n    43\t\tt := &Tracker{\r\n    44\t\t\texperiments: make(map[string]*Experiment),\r\n    45\t\t\tdataDir:     dataDir,\r\n    46\t\t}\r\n    47\t\tt.loadAll()\r\n    48\t\treturn t\r\n    49\t}\r\n    50\t\r\n    51\t// CreateExperiment creates a new experiment with the given name.\r\n    52\tfunc (t *Tracker) CreateExperiment(name string) (*Experiment, error) {\r\n    53\t\tt.mu.Lock()\r\n"]
[5855.688461, "o", "    54\t\tdefer t.mu.Unlock()\r\n    55\t\r\n    56\t\tif _, exists := t.experiments[name]; exists {\r\n    57\t\t\treturn nil, fmt.Errorf(\"experiment %q already exists\", name)\r\n    58\t\t}\r\n    59\t\r\n    60\t\texp := &Experiment{\r\n    61\t\t\tName:      name,\r\n    62\t\t\tRuns:      make([]*Run, 0),\r\n    63\t\t\tCreatedAt: time.Now(),\r\n    64\t\t}\r\n    65\t\tt.experiments[name] = exp\r\n    66\t\tif err := t.saveExperiment(exp); err != nil {\r\n    67\t\t\tdelete(t.experiments, name)\r\n    68\t\t\treturn nil, err\r\n    69"]
[5855.688557, "o", "\t\t}\r\n    70\t\treturn exp, nil\r\n    71\t}\r\n    72\t\r\n    73\t// LogRun adds a new run to the specified experiment.\r\n    74\tfunc (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {\r\n    75\t\tt.mu.Lock()\r\n    76\t\tdefer t.mu.Unlock()\r\n    77\t\r\n    78\t\texp, exists := t.experiments[experimentName]\r\n    79\t\tif !exists {\r\n    80\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n    81\t\t}\r\n"]
[5855.688659, "o", "    82\t\r\n    83\t\tt.runCounter++\r\n    84\t\trun := &Run{\r\n    85\t\t\tID:         fmt.Sprintf(\"run_%d\", t.runCounter),\r\n    86\t\t\tParameters: params,\r\n    87\t\t\tMetrics:    metrics,\r\n    88\t\t\tTags:       tags,\r\n    89\t\t\tCreatedAt:  time.Now(),\r\n    90\t\t}\r\n    91\t\texp.Runs = append(exp.Runs, run)\r\n    92\t\r\n    93\t\tif err := t.saveExperiment(exp); err != nil {\r\n    94\t\t\texp.Runs = exp.Runs[:len(exp.Runs)-1]\r\n    95\t\t\treturn nil, err\r\n"]
[5855.688754, "o", "    96\t\t}\r\n    97\t\treturn run, nil\r\n    98\t}\r\n    99\t\r\n   100\t// GetExperiment returns the experiment with the given name.\r\n   101\tfunc (t *Tracker) GetExperiment(name string) (*Experiment, error) {\r\n   102\t\tt.mu.RLock()\r\n   103\t\tdefer t.mu.RUnlock()\r\n   104\t\r\n   105\t\texp, exists := t.experiments[name]\r\n   106\t\tif !exists {\r\n   107\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", name)\r\n   108\t\t}\r\n   109\t\treturn exp, nil\r\n   110\t}\r\n"]
[5855.688791, "o", "   111\t\r\n   112\t// ListExperiments returns all experiments.\r\n   113\tfunc (t *Tracker) ListExperiments() []*Experiment {\r\n   114\t\tt.mu.RLock()\r\n   115\t\tdefer t.mu.RUnlock()\r\n   116\t\r\n   117\t\tresult := make([]*Experiment, 0, len(t.experiments))\r\n   118\t\tfor _, exp := range t.experiments {\r\n   119\t\t\tresult = append(result, exp)\r\n   120\t\t}\r\n"]
