[3939.729476, "o", "\t\treturn fmt.Errorf(\"model %q not found\", name)\r\n\t}\r\n\r\n\tdelete(r.models, name)\r\n\tfilename := filepath.Join(r.dataDir, name+\".json\")\r\n\tos.Remove(filename)\r\n\treturn nil\r\n}\r\n\r\n// GetVersion returns a specific version of a model.\r\nfunc (r *Registry) GetVersion(modelName string, versionNum int) (*Version, error) {\r\n\tr.mu.RLock()"]
[3939.729666, "o", "\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Number == versionNum {\r\n\t\t\treturn v, nil\r\n\t\t}\r\n\t}\r\n\treturn nil, fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n}\r\n\r\n// GetVersionByStage returns the version of a model currently in the specified stage.\r\nfunc (r *Registry) GetVersionByStage(modelName string, stage Stage) (*Version, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n"]
[3939.729769, "o", "\tfor _, v := range model.Versions {\r\n\t\tif v.Stage == stage {\r\n\t\t\treturn v, nil\r\n\t\t}\r\n\t}\r\n\treturn nil, fmt.Errorf(\"no version in stage %s for model %q\", stage, modelName)\r\n}\r\n\r\n// ValidateAnnotationKey returns true if key is non-empty and contains only\r\n// letters, digits, and underscores.\r\nfunc ValidateAnnotationKey(key string) bool {\r\n\treturn validateAnnotationKey(key)\r\n"]
[3939.729906, "o", "}\r\n\r\n// findVersionLocked returns the version pointer for the given model and version number.\r\n// The caller must hold an appropriate lock.\r\nfunc (r *Registry) findVersionLocked(modelName string, versionNum int) (*Model, *Version, error) {\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn nil, nil, fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tfor _, v := range model.Versions {\r\n"]
[3939.730007, "o", "\t\tif v.Number == versionNum {\r\n\t\t\treturn model, v, nil\r\n\t\t}\r\n\t}\r\n\treturn nil, nil, fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n}\r\n\r\n// validateAnnotationKey returns true if key is non-empty and contains only\r\n// letters, digits, and underscores.\r\nfunc validateAnnotationKey(key string) bool {\r\n\treturn annotationKeyRegexp.MatchString(key)\r\n}\r\n\r\n// AddAnnotation attaches a new key-value annotation to a model version.\r\nfunc (r *Registry) AddAnnotation(modelName string, versionNum int, key, value string) (*Annotation, error) {\r\n\tr.mu.Lock()\r\n"]
[3939.730093, "o", "\tdefer r.mu.Unlock()\r\n\r\n\tif _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif !validateAnnotationKey(key) {\r\n\t\treturn nil, fmt.Errorf(\"invalid annotation key\")\r\n\t}\r\n\r\n\tif r.annotations[modelName] == nil {\r\n\t\t"]
[3939.730145, "o", "r.annotations[modelName] = make(map[int]map[string]*Annotation)\r\n\t}\r\n\tif r.annotations[modelName][versionNum] == nil {\r\n\t\tr.annotations[modelName][versionNum] = make(map[string]*Annotation)\r\n\t}\r\n\t"]
[3939.73019, "o", "if _, exists := r.annotations[modelName][versionNum][key]; exists {\r\n\t\treturn nil, fmt.Errorf(\"annotation %q already exists\", key)\r\n\t}\r\n\r\n\tannotation := &Annotation{\r\n"]
[3939.730313, "o", "\t\tKey:       key,\r\n\t\tValue:     value,\r\n\t\tCreatedAt: time.Now(),\r\n\t}\r\n\tr.annotations[modelName][versionNum][key] = annotation\r\n\treturn annotation, nil\r\n}\r\n\r\n// ListAnnotations returns all annotations for a model version sorted by key.\r\nfunc (r *Registry) ListAnnotations(modelName string, versionNum int) ([]*Annotation, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tif _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {\r\n"]
[3939.730395, "o", "\t\treturn nil, err\r\n\t}\r\n\r\n\tvar annotations []*Annotation\r\n\tif versions, ok := r.annotations[modelName]; ok {\r\n\t\tif keys, ok := versions[versionNum]; ok {\r\n\t\t\tfor _, a := range keys {\r\n\t\t\t\tannotations = append(annotations, a)\r\n\t\t\t}\r\n\t\t}"]
[3939.730474, "o", "\r\n\t}\r\n\tsort.Slice(annotations, func(i, j int) bool {\r\n\t\treturn annotations[i].Key < annotations[j].Key\r\n\t})\r\n\tif annotations == nil {\r\n\t\tannotations = []*Annotation{}\r\n\t}\r\n\treturn annotations, nil"]
[3939.730556, "o", "\r\n}\r\n\r\n// DeleteAnnotation removes a specific annotation from a model version.\r\nfunc (r *Registry) DeleteAnnotation(modelName string, versionNum int, key string) error {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tif _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {\r\n\t\treturn err\r\n\t"]
[3939.730636, "o", "}\r\n\r\n\tif r.annotations[modelName] == nil || r.annotations[modelName][versionNum] == nil {\r\n\t\treturn fmt.Errorf(\"annotation %q not found\", key)\r\n\t}\r\n\tif _, exists := r.annotations[modelName][versionNum][key]; !exists {\r\n\t\treturn fmt.Errorf(\"annotation %q not found\", key)\r\n\t}\r\n\tdelete(r.annotations[modelName][versionNum], key)\r\n\t"]
[3939.730715, "o", "return nil\r\n}\r\n\r\n// AnnotationsMap returns a map of annotation key to value for a model version.\r\nfunc (r *Registry) AnnotationsMap(modelName string, versionNum int) map[string]string {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tresult := make(map[string]string)\r\n\tif versions, ok := r.annotations[modelName]; ok {\r\n"]
[3939.730794, "o", "\t\tif keys, ok := versions[versionNum]; ok {\r\n\t\t\tfor k, a := range keys {\r\n\t\t\t\tresult[k] = a.Value\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn result\r\n}\r\n\r\n"]
[3939.730882, "o", "// loadAll reads all model files from the data directory.\r\nfunc (r *Registry) loadAll() error {\r\n\tentries, err := os.ReadDir(r.dataDir)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil\r\n\t\t}\r\n\t\treturn err\r\n\t}\r\n"]
[3939.730961, "o", "\tfor _, entry := range entries {\r\n\t\tif !entry.IsDir() && filepath.Ext(entry.Name()) == \".json\" {\r\n\t\t\tdata, err := os.ReadFile(filepath.Join(r.dataDir, entry.Name()))\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn err\r\n\t\t\t}\r\n\t\t\tvar model Model\r\n\t\t\tif err := json.Unmarshal(data, &model); err != nil {\r\n"]
[3939.73104, "o", "\t\t\t\treturn err\r\n\t\t\t}\r\n\t\t\tr.models[model.Name] = &model\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n"]
[3939.73112, "o", "// saveModel writes a model's data to its JSON file.\r\nfunc (r *Registry) saveModel(model *Model) error {\r\n\tdata, err := json.MarshalIndent(model, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tfilename := filepath.Join(r.dataDir, model.Name+\".json\")\r\n\treturn os.WriteFile(filename, data, 0644)\r\n"]
[3939.731198, "o", "}\r\n"]
