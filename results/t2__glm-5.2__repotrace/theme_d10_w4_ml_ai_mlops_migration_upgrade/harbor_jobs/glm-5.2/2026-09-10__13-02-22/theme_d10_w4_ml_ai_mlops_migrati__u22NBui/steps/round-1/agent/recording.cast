[2520.518991, "o", "\u001b[?2004h> "]
[2520.519203, "o", "\\tmetricName := r.PathValue(\"metric\")\r\n\u001b[?2004l\r"]
[2520.519258, "o", "\u001b[?2004h> "]
[2520.519624, "o", "\\thistory, err := h.Experiment.MetricHistory(expName, metricName)\r\n\u001b[?2004l\r"]
[2520.51969, "o", "\u001b[?2004h> "]
[2520.519787, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[2520.519842, "o", "\u001b[?2004h> "]
[2520.52014, "o", "\\t\\tif strings.Contains(err.Error(), \"not found\") {\r\n\u001b[?2004l\r"]
[2520.520197, "o", "\u001b[?2004h> "]
[2520.520487, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[2520.520544, "o", "\u001b[?2004h> "]
[2520.52062, "o", "\\t\\t} else {\r\n\u001b[?2004l\r"]
[2520.520682, "o", "\u001b[?2004h> "]
[2520.520987, "o", "\\t\\t\\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\u001b[?2004l\r"]
[2520.521044, "o", "\u001b[?2004h> "]
[2520.521098, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[2520.521153, "o", "\u001b[?2004h> "]
[2520.521213, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[2520.521267, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2520.52132, "o", "\u001b[?2004h> "]
[2520.521637, "o", "\\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[?2004l\r"]
[2520.521691, "o", "\u001b[?2004h> "]
[2520.521793, "o", "\\t\\t\"experiment\": expName,\r\n\u001b[?2004l\r"]
[2520.521848, "o", "\u001b[?2004h> "]
[2520.521966, "o", "\\t\\t\"metric\":     metricName,\r\n\u001b[?2004l\r"]
[2520.522022, "o", "\u001b[?2004h> "]
[2520.522119, "o", "\\t\\t\"history\":    history,\r\n\u001b[?2004l\r"]
[2520.522174, "o", "\u001b[?2004h> "]
[2520.522291, "o", "\\t\\t\"count\":      len(history),\r\n\u001b[?2004l\r"]
[2520.522345, "o", "\u001b[?2004h> \\t})\r\n\u001b[?2004l\r"]
[2520.5224, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2520.522456, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2520.522511, "o", "\u001b[?2004h> "]
[2520.522782, "o", "func (h *Handlers) UpdateRun(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[2520.522837, "o", "\u001b[?2004h> "]
