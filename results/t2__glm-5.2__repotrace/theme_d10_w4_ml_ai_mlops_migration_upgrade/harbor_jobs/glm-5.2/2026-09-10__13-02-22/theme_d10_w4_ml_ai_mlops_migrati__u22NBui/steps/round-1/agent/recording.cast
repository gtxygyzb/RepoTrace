[5997.226324, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('internal/registry/registry.go')\ns = p.read_text()\n\n# Add RollbackVersion after DeleteAnnotation or after AnnotationsMap\nold = '''// loadAll reads all model files from the data directory.\n'''\nnew = '''// RollbackVersion restores a version to its initial state: stage development,\n// preserved annotations, empty lineage, and demoted_by reset to 0.\nfunc (r *Registry) RollbackVersion(modelName string, versionNum int) error {\n\\tr.mu.Lock()\n\\tdefer r.mu.Unlock()\n\n\\tmodel, version, err := r.findVersionLocked(modelName, versionNum)\n\\tif err != nil {\n\\t\\treturn err\n\\t}\n\n\\tversion.Stage = StageDevelopment\n\\tversion.Lineage = []PromotionRecord{}\n\\tversion.DemotedBy = 0\n\\tmodel.UpdatedAt = time.Now()\n\n\\treturn r.saveModel(model)\n}\n\n// loadAll reads all model files from the data directory.\n'''\nif old not in s:\n    raise SystemExit('loadAll comment not found')\ns = s.replace(old, new)\n\np.write_text(s)\nPY\n"]
