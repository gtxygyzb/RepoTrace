[5709.028915, "o", "   238\t\t\tformat = \"json\"\r\n   239\t\t}\r\n   240\t\r\n   241\t\tswitch format {\r\n   242\t\tcase \"json\":\r\n   243\t\t\treturn map[string]interface{}{\r\n   244\t\t\t\t\"format\": \"json\",\r\n   245\t\t\t\t\"data\":   input,\r\n   246\t\t\t}, nil\r\n   247\t\r\n   248\t\tcase \"summary\":\r\n   249\t\t\tdata, ok := input[\"data\"].([]interface{})\r\n"]
[5709.029162, "o", "   250\t\t\tcount := 0\r\n   251\t\t\tif ok {\r\n   252\t\t\t\tcount = len(data)\r\n   253\t\t\t}\r\n   254\t\t\treturn map[string]interface{}{\r\n   255\t\t\t\t\"format\": \"summary\",\r\n   256\t\t\t\t\"count\":  float64(count),\r\n   257\t\t\t\t\"data\":   input,\r\n   258\t\t\t}, nil\r\n   259\t\r\n   260\t\tcase \"csv\":\r\n   261\t\t\tdata, ok := input[\"data\"].([]interface{})\r\n   262\t\t\tif !ok {\r\n   263\t\t\t\treturn map[string]interface{}{\"format\": \"csv\", \"content\": \"\"}, nil\r\n   264\t\t\t}\r\n   265\t\t\tcsv := \"\"\r\n   266\t\t\tfor i, v := range data {\r\n   267\t\t\t\tif i > 0 {\r\n   268\t\t\t\t\tcsv += \",\"\r\n   269\t\t\t\t}\r\n   270\t\t\t\tcsv += fmt.Sprintf(\"%v\", v)\r\n   271\t\t\t}\r\n   272\t\t\treturn map[string]interface{}{\r\n   273\t\t\t\t\"format\":  \"csv\",\r\n   274\t\t\t\t\"content\": csv,\r\n   275\t\t\t\t\"data\":    data,\r\n   276\t\t\t}, nil\r\n   277\t\r\n   278\t\tdefault:\r\n   279\t\t\treturn nil, fmt.Errorf(\"export: unknown format %q\", format)\r\n   280\t\t}\r\n   281\t}\r\n   282\t\r\n   283\t// ExecuteFilter selects elements from the data array based on a comparison condition.\r\n   284\t// Supported modes: gt, lt, gte, lte, eq, ne.\r\n"]
[5709.02925, "o", "   285\tfunc ExecuteFilter(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   286\t\tdata, ok := input[\"data\"].([]interface{})\r\n   287\t\tif !ok {\r\n   288\t\t\treturn nil, fmt.Errorf(\"filter: missing or invalid 'data' field in input\")\r\n   289\t\t}\r\n   290\t\r\n   291\t\tmode, _ := config[\"mode\"].(string)\r\n   292\t\tif mode == \"\" {\r\n   293\t\t\treturn nil, fmt.Errorf(\"filter: missing 'mode' in config\")\r\n   294\t\t}\r\n   295\t\tthreshold, _ := config[\"threshold\"].(float64)\r\n"]
[5709.029333, "o", "   296\t\r\n   297\t\tvar result []interface{}\r\n   298\t\tfor _, v := range data {\r\n   299\t\t\tval, err := toFloat(v)\r\n   300\t\t\tif err != nil {\r\n   301\t\t\t\tcontinue\r\n   302\t\t\t}\r\n   303\t\t\tvar keep bool\r\n   304\t\t\tswitch mode {\r\n   305\t\t\tcase \"gt\":\r\n   306\t\t\t\tkeep = val > threshold\r\n"]
[5709.029409, "o", "   307\t\t\tcase \"lt\":\r\n   308\t\t\t\tkeep = val < threshold\r\n   309\t\t\tcase \"gte\":\r\n   310\t\t\t\tkeep = val >= threshold\r\n   311\t\t\tcase \"lte\":\r\n   312\t\t\t\tkeep = val <= threshold\r\n   313\t\t\tcase \"eq\":\r\n   314\t\t\t\tkeep = val == threshold\r\n   315\t\t\tcase \"ne\":\r\n   316\t\t\t\tkeep = val != threshold\r\n   317"]
[5709.0295, "o", "\t\t\tdefault:\r\n   318\t\t\t\treturn nil, fmt.Errorf(\"filter: unknown mode %q\", mode)\r\n   319\t\t\t}\r\n   320\t\t\tif keep {\r\n   321\t\t\t\tresult = append(result, val)\r\n   322\t\t\t}\r\n   323\t\t}\r\n   324\t\r\n"]
[5709.029573, "o", "   325\t\tif result == nil {\r\n   326\t\t\tresult = []interface{}{}\r\n   327\t\t}\r\n   328\t\treturn map[string]interface{}{\"data\": result}, nil\r\n   329\t}\r\n   330\t\r\n   331\t// Helper functions\r\n   332\t\r\n   333\tfunc toFloat(v interface{}) (float64, error) {\r\n   334\t\tswitch val := v.(type) {\r\n   335\t\tcase float64:\r\n   336\t\t\treturn val, nil\r\n   337\t\tcase int:\r\n   338\t\t\treturn float64(val), nil\r\n   339\t\tcase int64:\r\n   340\t\t\treturn float64(val), nil\r\n"]
