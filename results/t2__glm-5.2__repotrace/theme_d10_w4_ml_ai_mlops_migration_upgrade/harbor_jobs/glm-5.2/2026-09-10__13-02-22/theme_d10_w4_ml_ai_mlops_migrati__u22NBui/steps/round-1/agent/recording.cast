[3948.261049, "o", "   360\t\tr.annotations[modelName][versionNum][key] = annotation\r\n   361\t\treturn annotation, nil\r\n   362\t}\r\n   363\t\r\n   364\t// ListAnnotations returns all annotations for a model version sorted by key.\r\n   365\tfunc (r *Registry) ListAnnotations(modelName string, versionNum int) ([]*Annotation, error) {\r\n   366\t\tr.mu.RLock()\r\n"]
[3948.261106, "o", "   367\t\tdefer r.mu.RUnlock()\r\n   368\t\r\n   369\t\tif _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {\r\n   370\t\t\treturn nil, err\r\n   371\t\t}\r\n   372\t\r\n   373\t\tvar annotations []*Annotation\r\n"]
