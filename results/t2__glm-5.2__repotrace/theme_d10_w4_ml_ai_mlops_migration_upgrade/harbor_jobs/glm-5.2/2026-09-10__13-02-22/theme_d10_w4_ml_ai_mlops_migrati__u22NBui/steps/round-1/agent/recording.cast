[6956.305728, "o", "\\tresult, err := h.Experiment.Summary(expName, metric)\r\n\u001b[?2004l\r"]
[6956.305784, "o", "\u001b[?2004h> "]
[6956.305849, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[6956.305916, "o", "\u001b[?2004h> "]
[6956.306114, "o", "\\t\\tif strings.Contains(err.Error(), \"not found\") {\r\n\u001b[?2004l\r"]
[6956.306169, "o", "\u001b[?2004h> "]
[6956.30637, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
