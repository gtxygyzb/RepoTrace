[969.885661, "o", "     1\tpackage experiment\r\n     2\t"]
[969.885675, "o", "\r\n     3\timport (\r\n"]
[969.885747, "o", "     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"math\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"sync\"\r\n    11\t\t\"time\"\r\n    12"]
[969.885798, "o", "\t)\r\n    13\t\r\n"]
[969.885866, "o", "    14\t// Experiment groups related runs together.\r\n    15\ttype Experiment struct {\r\n    16\t\tName      string    `json:\"name\"`\r\n    17\t\tRuns      []*Run    `json:\"runs\"`\r\n    18\t\tCreatedAt time.Time `json:\"created_at\"`\r\n    19\t}\r\n"]
[969.88592, "o", "    20\t\r\n    21\t// Run records a single experiment execution with parameters and metrics.\r\n    22\ttype Run struct {\r\n    23\t\tID         string             `json:\"id\"`\r\n"]
[969.885936, "o", "    24\t\tParameters map[string]float64 `json:\"parameters\"`\r\n    25\t\tMetrics    map[string]float64 `json:\"metrics\"`\r\n    26\t\tTags       map[string]string  `json:\"tags\"`\r\n    27\t\tCreatedAt  time.Time          `json:\"created_at\"`\r\n    28\t}\r\n    29\t\r\n    30\t// Tracker manages experiments and their runs."]
[969.886011, "o", "\r\n"]
[969.886027, "o", "    31\ttype Tracker struct {\r\n    32\t\tmu          sync.RWMutex\r\n    33\t\texperiments map[string]*Experiment\r\n    34\t\tdataDir     string\r\n    35\t\trunCounter  int\r\n    36\t}\r\n    37\t\r\n    38\t// NewTracker creates a new experiment tracker backed by the given data directory.\r\n"]
[969.886096, "o", "    39\tfunc NewTracker(dataDir string) *Tracker {\r\n    40"]
[969.886145, "o", "\t\tos.MkdirAll(dataDir, 0755)\r\n    41\t\tt := &Tracker{\r\n    42\t\t\texperiments: make(map[string]*Experiment),\r\n    43\t\t\tdataDir:     dataDir,\r\n    44\t\t}\r\n    45\t\tt.loadAll()\r\n    46\t\treturn t\r\n    47\t}\r\n    48\t\r\n"]
[969.886198, "o", "    49\t// CreateExperiment creates a new experiment with the given name.\r\n    50\tfunc (t *Tracker) CreateExperiment(name string) (*Experiment, error) {\r\n    51\t\tt.mu.Lock()\r\n    52\t\tdefer t.mu.Unlock()\r\n    53\t\r\n"]
[969.886249, "o", "    54\t\tif _, exists := t.experiments[name]; exists {\r\n    55\t\t\treturn nil, fmt.Errorf(\"experiment %q already exists\", name)\r\n    56\t\t}\r\n    57\t\r\n    58\t\texp := &Experiment{\r\n    59\t\t\tName:      name,\r\n    60\t\t\tRuns:      make([]*Run, 0),\r\n    61\t\t\tCreatedAt: time.Now(),\r\n    62\t\t"]
[969.886263, "o", "}\r\n    63\t\t"]
[969.886328, "o", "t.experiments[name] = exp\r\n"]
[969.886385, "o", "    64\t\tif err := t.saveExperiment(exp); err != nil {\r\n    65\t\t\tdelete(t.experiments, name)\r\n    66\t\t\treturn nil, err\r\n    67\t\t}\r\n    68\t\treturn exp, nil\r\n    69\t}\r\n    70\t\r\n    71\t// LogRun adds a new run to the specified experiment.\r\n    72\tfunc (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {\r\n    73\t\tt.mu.Lock()\r\n    74\t\tdefer t.mu.Unlock()\r\n    75\t"]
[969.886438, "o", "\r\n    76\t\texp, exists := t.experiments[experimentName]\r\n"]
[969.886489, "o", "    77\t\tif !exists {\r\n    78\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n    79\t\t}\r\n    80\t\r\n    81\t\tt.runCounter++\r\n"]
[969.886544, "o", "    82\t\trun := &Run{\r\n    83\t\t\tID:         fmt.Sprintf(\"run_%d\", t.runCounter),\r\n    84\t\t\tParameters: params,\r\n    85\t\t\tMetrics:    metrics,\r\n    86\t\t\tTags:       tags,\r\n"]
[969.886593, "o", "    87\t\t\tCreatedAt:  time.Now(),\r\n    88\t\t}\r\n    89\t\texp.Runs = append(exp.Runs, run)\r\n    90\t\r\n"]
[969.886641, "o", "    91\t\tif err := t.saveExperiment(exp); err != nil {\r\n    92\t\t\texp.Runs = exp.Runs[:len(exp.Runs)-1]\r\n    93\t\t\treturn nil, err\r\n    94\t\t}\r\n    95\t\treturn run, nil\r\n    96"]
[969.886688, "o", "\t}\r\n    97\t\r\n    98\t// GetExperiment returns the experiment with the given name.\r\n    99\tfunc (t *Tracker) GetExperiment(name string) (*Experiment, error) {\r\n   100\t\tt.mu.RLock()\r\n"]
[969.886737, "o", "   101\t\tdefer t.mu.RUnlock()\r\n   102\t\r\n   103\t\texp, exists := t.experiments[name]\r\n   104\t\tif !exists {\r\n   105\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", name)\r\n   106\t"]
[969.886775, "o", "\t}\r\n   107\t\treturn exp, nil\r\n   108\t}\r\n   109\t\r\n   110\t// ListExperiments returns all experiments.\r\n   111\tfunc (t *Tracker) ListExperiments() []*Experiment {"]
[969.886829, "o", "\r\n   112\t\tt.mu.RLock()\r\n   113\t\tdefer t.mu.RUnlock()\r\n   114\t\r\n   115\t\tresult := make([]*Experiment, 0, len(t.experiments))\r\n   116\t\tfor _, exp := range t.experiments {\r\n   117\t\t\tresult = append(result, exp)\r\n   118\t\t}\r\n   119\t\tsort.Slice(result, func(i, j int) bool {"]
[969.886888, "o", "\r\n   120\t\t\treturn result[i].Name < result[j].Name\r\n"]
[969.886937, "o", "   121\t\t})\r\n   122\t\treturn result\r\n   123\t}\r\n   124\t\r\n   125\t// AggregateMetric computes an aggregate statistic for a given metric across all runs\r\n   126"]
[969.886951, "o", "\t// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.\r\n   127\t// For weighted_mean, weightParam specifies which parameter to use as weight.\r\n   128\tfunc (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, int, error) {\r\n   129\t\tt.mu.RLock()\r\n"]
[969.887021, "o", "   130\t\tdefer t.mu.RUnlock()\r\n   131\t\r\n   132\t\texp, exists := t.experiments[experimentName]\r\n   133\t\tif !exists {\r\n   134\t\t\treturn 0, 0, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   135\t\t}\r\n   136\t\r\n"]
[969.887069, "o", "   137\t\tif len(exp.Runs) == 0 {\r\n   138\t\t\treturn 0, 0, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n"]
[969.887117, "o", "   139\t\t}\r\n   140\t\r\n   141\t\tvar values []float64\r\n   142\t\tvar weights []float64\r\n"]
[969.887166, "o", "   143\t\tfor _, run := range exp.Runs {\r\n   144\t\t\tvalue, ok := run.Metrics[metricName]\r\n   145\t\t\tif !ok {\r\n   146\t\t\t\tcontinue\r\n   147\t\t\t}\r\n   148"]
[969.887213, "o", "\t\t\tvalues = append(values, value)\r\n   149\t\t\tif aggType == \"weighted_mean\" {\r\n   150\t\t\t\tweight, ok := run.Parameters[weightParam]\r\n   151\t\t\t\tif !ok {\r\n   152\t\t\t\t\tcontinue\r\n   153\t"]
[969.887266, "o", "\t\t\t}\r\n   154\t\t\t\tweights = append(weights, weight)\r\n   155\t\t\t}\r\n   156\t\t}\r\n   157\t\r\n   158\t\tif len(values) == 0 {\r\n   159\t\t\treturn 0, 0, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n"]
[969.887314, "o", "   160\t\t}\r\n   161\t\r\n"]
[969.887329, "o", "   162\t\tswitch aggType {\r\n   163\t\tcase \"mean\":\r\n   164\t\t\tsum := 0.0\r\n   165\t\t\tfor _, v := range values {\r\n   166\t\t\t\tsum += v\r\n"]
[969.887393, "o", "   167\t\t\t}\r\n   168\t\t\treturn sum / float64(len(values)), len(values), nil\r\n"]
[969.887441, "o", "   169\t\r\n   170\t\tcase \"median\":\r\n   171\t\t\tsorted := sortedCopy(values)\r\n   172\t\t\tn := len(sorted)\r\n   173\t\t\tif n%2 == 0 {\r\n   174\t\t\t\t"]
[969.887488, "o", "return (sorted[n/2-1] + sorted[n/2]) / 2, len(values), nil\r\n   175\t\t\t}\r\n   176\t\t\treturn sorted[n/2], len(values), nil\r\n   177\t\r\n   178\t\tcase \"p95\":\r\n   179\t\t\tsorted := sortedCopy(values)"]
[969.887539, "o", "\r\n   180\t\t\treturn percentile(sorted, 0.95), len(values), nil\r\n   181\t\r\n   182\t\tcase \"p99\":\r\n   183\t\t\tsorted := sortedCopy(values)\r\n   184\t\t\treturn percentile(sorted, 0.99), len(values), nil\r\n   185\t\r\n   186\t\tcase \"weighted_mean\":\r\n"]
[969.887587, "o", "   187\t\t\tif weightParam == \"\" {\r\n   188\t\t\t\t"]
[969.887635, "o", "return 0, 0, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\n   189\t\t\t}\r\n   190\t\t\tif len(weights) == 0 {\r\n   191\t\t\t\treturn 0, 0, fmt.Errorf(\"no runs with metric %q and weight parameter %q\", metricName, weightParam)\r\n"]
[969.887682, "o", "   192\t\t\t}\r\n   193\t\t\tif len(weights) != len(values) {\r\n   194\t\t\t\treturn 0, 0, fmt.Errorf(\"mismatch between metric values and weights\")\r\n   195\t\t\t}\r\n"]
[969.88773, "o", "   196\t\t\tweightedSum := 0.0\r\n   197\t\t\tweightSum := 0.0\r\n   198\t\t\tfor i, v := range values {\r\n   199\t\t\t\tweightedSum += v * weights[i]\r\n   200\t\t\t\tweightSum += weights[i]\r\n"]
[969.88778, "o", "   201\t\t\t}\r\n   202\t\t\tif weightSum == 0 {\r\n   203\t\t\t\treturn 0, 0, fmt.Errorf(\"weighted_mean has zero total weight\")\r\n   204\t\t\t}\r\n   205\t\t\t"]
[969.887827, "o", "return weightedSum / weightSum, len(values), nil\r\n   206\t\r\n   207\t\tdefault:\r\n   208\t\t\treturn 0, 0, fmt.Errorf(\"unknown aggregation type %q\", aggType)\r\n   209\t\t}\r\n"]
[969.887883, "o", "   210\t}\r\n   211\t\r\n   212\tfunc percentile(sorted []float64, p float64) float64 {\r\n   213\t\tn := len(sorted)\r\n   214\t\tif n == 0 {\r\n"]
[969.887897, "o", "   215\t\t\treturn 0\r\n   216\t\t}\r\n   217\t\tif n == 1 {\r\n   218\t\t\treturn sorted[0]\r\n   219\t\t}\r\n"]
[969.887963, "o", "   220\t\trank := p * float64(n-1)\r\n"]
[969.888011, "o", "   221\t\tlower := int(math.Floor(rank))\r\n   222\t\tupper := int(math.Ceil(rank))\r\n   223\t\tif lower == upper {\r\n   224\t\t\treturn sorted[lower]\r\n   225\t\t}\r\n   226\t\tfrac := rank - float64(lower)\r\n   227\t\treturn sorted[lower]*(1-frac) + sorted[upper]*frac\r\n"]
[969.888061, "o", "   228\t}\r\n   229\t\r\n   230\tfunc sortedCopy(values []float64) []float64 {\r\n   231\t\ts := make([]float64, len(values))\r\n   232\t\tcopy(s, values)\r\n   233"]
[969.888113, "o", "\t\tsort.Float64s(s)\r\n   234\t\treturn s\r\n   235\t}\r\n   236\t\r\n   237\tfunc (t *Tracker) loadAll() {\r\n   238\t\tentries, err := os.ReadDir(t.dataDir)\r\n   239\t\tif err != nil {\r\n"]
[969.888161, "o", "   240\t\t\treturn\r\n   241\t\t}\r\n"]
[969.888211, "o", "   242\t\tfor _, entry := range entries {\r\n   243\t\t\tif !entry.IsDir() && filepath.Ext(entry.Name()) == \".json\" {\r\n   244\t\t\t\tdata, err := os.ReadFile(filepath.Join(t.dataDir, entry.Name()))\r\n   245\t\t\t\tif err != nil {\r\n   246\t\t\t\t\tcontinue\r\n"]
[969.888266, "o", "   247\t\t\t\t}\r\n   248\t\t\t\tvar exp Experiment\r\n   249\t\t\t\tif err := json.Unmarshal(data, &exp); err != nil {\r\n   250\t\t\t\t\tcontinue\r\n   251\t\t\t\t}\r\n   252\t\t\t\tt.experiments[exp.Name] = &exp\r\n   253\t\t\t\tfor _, r := range exp.Runs {\r\n   254"]
[969.888315, "o", "\t\t\t\t\t_ = r\r\n"]
[969.888369, "o", "   255\t\t\t\t\tt.runCounter++\r\n   256\t\t\t\t}\r\n   257\t\t\t}\r\n   258\t\t}\r\n   259\t}\r\n   260\t\r\n   261\tfunc (t *Tracker) saveExperiment(exp *Experiment) error {\r\n   262\t\tdata, err := json.MarshalIndent(exp, \"\", \"  \")\r\n   263\t\tif err != nil {\r\n   264"]
[969.888424, "o", "\t\t\treturn err\r\n   265\t\t}\r\n   266\t\tfilename := filepath.Join(t.dataDir, exp.Name+\".json\")\r\n   267\t\treturn os.WriteFile(filename, data, 0644)\r\n   268\t}\r\n"]
