[3395.00924, "o", "\u001b[?2004h> "]
[3395.009792, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"annotation key must contain only letters, digits, and underscores\")\r\n\u001b[?2004l\r"]
[3395.009898, "o", "\u001b[?2004h> \\t\\treturn\r\n\u001b[?2004l\r"]
[3395.009985, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.010072, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.010515, "o", "\\tannotation, err := h.Registry.AddAnnotation(modelName, num, req.Key, req.Value)\r\n\u001b[?2004l\r"]
[3395.010602, "o", "\u001b[?2004h> "]
[3395.010695, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.011005, "o", "\\t\\tif strings.Contains(err.Error(), \"not found\") {\r\n\u001b[?2004l\r"]
[3395.011093, "o", "\u001b[?2004h> "]
[3395.011364, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[3395.011395, "o", "\u001b[?2004h> "]
[3395.011916, "o", "\\t\\t} else if strings.Contains(err.Error(), \"already exists\") {\r\n\u001b[?2004l\r"]
[3395.012011, "o", "\u001b[?2004h> "]
[3395.012508, "o", "\\t\\t\\twriteError(w, http.StatusConflict, \"%v\", err)\r\n\u001b[?2004l\r"]
[3395.012596, "o", "\u001b[?2004h> "]
[3395.012679, "o", "\\t\\t} else {\r\n\u001b[?2004l\r"]
[3395.012775, "o", "\u001b[?2004h> "]
[3395.013229, "o", "\\t\\t\\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\u001b[?2004l\r"]
[3395.013295, "o", "\u001b[?2004h> "]
[3395.013587, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\treturn\r\n"]
[3395.013699, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3395.013821, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.014511, "o", "\\twriteJSON(w, http.StatusCreated, annotation)\r\n\u001b[?2004l\r"]
[3395.014697, "o", "\u001b[?2004h> "]
[3395.014958, "o", "}\r\n\u001b[?2004l\r"]
[3395.015037, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r("]
[3395.015224, "o", "\u001b[?2004h> "]
[3395.016445, "o", "func (h *Handlers) ListAnnotations(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[3395.016534, "o", "\u001b[?2004h> "]
[3395.016666, "o", "\\tmodelName := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[3395.016735, "o", "\u001b[?2004h> "]
[3395.016833, "o", "\\tnumStr := r.PathValue(\"num\")\r\n\u001b[?2004l\r"]
[3395.016909, "o", "\u001b[?2004h> "]
[3395.017011, "o", "\\tnum, err := strconv.Atoi(numStr)\r\n\u001b[?2004l\r"]
[3395.017078, "o", "\u001b[?2004h> "]
[3395.01716, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.017436, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\u001b[?2004l\r"]
[3395.017506, "o", "\u001b[?2004h> \\t\\treturn\r\n\u001b[?2004l\r"]
[3395.017589, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r>"]
[3395.017669, "o", "\u001b[?2004h> "]
[3395.017886, "o", "\\tannotations, err := h.Registry.ListAnnotations(modelName, num)\r\n\u001b[?2004l\r"]
[3395.017955, "o", "\u001b[?2004h> "]
[3395.018034, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.018226, "o", "\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[3395.018293, "o", "\u001b[?2004h> \\t\\treturn\r\n\u001b[?2004l\r"]
[3395.018375, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.018594, "o", "\\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[?2004l\r"]
[3395.018663, "o", "\u001b[?2004h> "]
[3395.018762, "o", "\\t\\t\"annotations\": annotations,\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.018827, "o", "> "]
[3395.018942, "o", "\\t\\t\"count\":       len(annotations),\r\n\u001b[?2004l\r"]
[3395.019009, "o", "\u001b[?2004h> \\t})\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.019088, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.019169, "o", "> "]
[3395.019401, "o", "func (h *Handlers) DeleteAnnotation(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[3395.019469, "o", "\u001b[?2004h> "]
[3395.01958, "o", "\\tmodelName := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[3395.019645, "o", "\u001b[?2004h> "]
[3395.019723, "o", "\\tnumStr := r.PathValue(\"num\")\r\n\u001b[?2004l\r"]
[3395.019802, "o", "\u001b[?2004h> "]
[3395.019913, "o", "\\tnum, err := strconv.Atoi(numStr)\r\n\u001b[?2004l\r"]
[3395.019985, "o", "\u001b[?2004h> "]
[3395.020066, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.02034, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\u001b[?2004l\r"]
[3395.020408, "o", "\u001b[?2004h> \\t\\treturn\r\n\u001b[?2004l\r"]
[3395.020486, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.020605, "o", "\\tkey := r.PathValue(\"key\")\r\n\u001b[?2004l\r"]
[3395.02067, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[3395.020967, "o", "\\tif err := h.Registry.DeleteAnnotation(modelName, num, key); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.021038, "o", "> "]
[3395.021198, "o", "\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[3395.021263, "o", "\u001b[?2004h> \\t\\treturn\r\n\u001b[?2004l\r"]
[3395.021345, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.021557, "o", "\\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.021626, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.021703, "o", "> "]
[3395.021784, "o", "// --- Pipeline Validation Handler ---\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3395.021867, "o", "\u001b[?2004h> "]
[3395.022051, "o", "func (h *Handlers) ValidatePipeline(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.022117, "o", "> \\tvar req struct {\r\n\u001b[?2004l\r"]
[3395.022197, "o", "\u001b[?2004h> "]
[3395.022309, "o", "\\t\\tName     string                 `json:\"name\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.022378, "o", "> "]
[3395.022482, "o", "\\t\\tSteps    []*pipeline.Step       `json:\"steps\"`\r\n\u001b[?2004l\r"]
[3395.022549, "o", "\u001b[?2004h> "]
[3395.02266, "o", "\\t\\tInput    map[string]interface{} `json:\"input\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.022723, "o", "> "]
[3395.022835, "o", "\\t\\tPipeline *pipeline.Pipeline     `json:\"pipeline\"`\r\n\u001b[?2004l\r"]
[3395.022922, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.023092, "o", "\\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.023155, "o", "> "]
[3395.023327, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\u001b[?2004l\r"]
[3395.023391, "o", "\u001b[?2004h> \\t\\treturn\r\n\u001b[?2004l\r"]
[3395.023467, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.023548, "o", "\\tp := req.Pipeline\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.023626, "o", "\\tif p == nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.023798, "o", "\\t\\tp = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}\r\n\u001b[?2004l\r"]
[3395.023878, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3395.023957, "o", "\u001b[?2004h> "]
[3395.024035, "o", "\\tresult := h.Pipeline.Validate(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.02415, "o", "\\twriteJSON(w, http.StatusOK, result)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.024193, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.024271, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.024365, "o", "// --- Serving Statistics Handlers ---\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.024429, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.024622, "o", "func (h *Handlers) ServingStats(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[3395.024687, "o", "\u001b[?2004h> "]
[3395.024799, "o", "\\twriteJSON(w, http.StatusOK, h.Serving.GetStats())\r\n\u001b[?2004l\r"]
[3395.024879, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.024956, "o", "> "]
[3395.025126, "o", "func (h *Handlers) ResetServingStats(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[3395.025191, "o", "\u001b[?2004h> "]
[3395.025271, "o", "\\th.Serving.ResetStats()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.025458, "o", "\\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"reset\"})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.025524, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.025604, "o", "> "]
[3395.025683, "o", "// --- Experiment Comparison Handler ---\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3395.025768, "o", "\u001b[?2004h> "]
[3395.025848, "o", "type experimentComparisonEntry struct {\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.025943, "o", "> "]
[3395.026021, "o", "\\tName  string  `json:\"name\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.026103, "o", "\\tMean  float64 `json:\"mean\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.026201, "o", "\\tMin   float64 `json:\"min\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.02627, "o", "> "]
[3395.026347, "o", "\\tMax   float64 `json:\"max\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.026427, "o", "\\tCount int     `json:\"count\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.026504, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3395.026582, "o", "> "]
[3395.026708, "o", "func (h *Handlers) CompareExperiments(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.026829, "o", "\\texperimentsParam := r.URL.Query().Get(\"experiments\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.026932, "o", "\\tmetric := r.URL.Query().Get(\"metric\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3395.027005, "o", "\u001b[?2004h> \\tif metric == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.02715, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"metric parameter is required\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.027219, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[3395.027296, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.027374, "o", "\\tnames := strings.Split(experimentsParam, \",\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.027451, "o", "\\tif len(names) < 2 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.027587, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"at least two experiment names are required\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.027656, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.027734, "o", "\\tfor i := range names {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.027813, "o", "\\t\\tnames[i] = strings.TrimSpace(names[i])\r\n\u001b[?2004l\r"]
[3395.0279, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.027979, "o", "\\tfor _, name := range names {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.028097, "o", "\\t\\tif _, err := h.Experiment.GetExperiment(name); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.028238, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"experiment %q not found\", name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.02829, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.028364, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.028445, "o", "\\tvar entries []experimentComparisonEntry\r\n\u001b[?2004l\r"]
[3395.028523, "o", "\u001b[?2004h> \\tvar means []float64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.028602, "o", "\\ttotalRuns := 0\r\n\u001b[?2004l\r\u001b[?2004h> \\tbest := \"\"\r\n\u001b[?2004l\r"]
[3395.02868, "o", "\u001b[?2004h> \\tvar bestMean float64\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3395.028759, "o", "\u001b[?2004h> \\tfor _, name := range names {\r\n\u001b[?2004l\r"]
[3395.028837, "o", "\u001b[?2004h> "]
[3395.028926, "o", "\\t\\texp, err := h.Experiment.GetExperiment(name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.029004, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.029106, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"experiment %q not found\", name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.029179, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3395.029258, "o", "\u001b[?2004h> \\t\\tvar values []float64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.029339, "o", "\\t\\tfor _, run := range exp.Runs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.029452, "o", "\\t\\t\\tif value, ok := run.Metrics[metric]; ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.029546, "o", "\\t\\t\\t\\tvalues = append(values, value)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.029611, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.029687, "o", "\\t\\tif len(values) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.029766, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.02984, "o", "\\t\\tsum := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.029923, "o", "\\t\\tminVal := values[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.030002, "o", "\\t\\tmaxVal := values[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.030071, "o", "\\t\\tfor _, value := range values {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.030149, "o", "\\t\\t\\tsum += value\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tif value < minVal {\r\n\u001b[?2004l\r"]
[3395.030226, "o", "\u001b[?2004h> \\t\\t\\t\\tminVal = value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.030305, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tif value > maxVal {\r\n\u001b[?2004l\r"]
[3395.030382, "o", "\u001b[?2004h> \\t\\t\\t\\tmaxVal = value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.03046, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.030538, "o", "\\t\\tmean := sum / float64(len(values))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.030658, "o", "\\t\\tentries = append(entries, experimentComparisonEntry{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.030725, "o", "\\t\\t\\tName:  name,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.030804, "o", "\\t\\t\\tMean:  mean,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.030889, "o", "\\t\\t\\tMin:   minVal,\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\t\\tMax:   maxVal,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.030969, "o", "\\t\\t\\tCount: len(values),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.031048, "o", "\\t\\t})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.031127, "o", "\\t\\tmeans = append(means, mean)\r\n\u001b[?2004l\r\u001b[?2004h> \\t\\ttotalRuns += len(values)\r\n\u001b[?2004l\r"]
[3395.031165, "o", "\u001b[?2004h> "]
[3395.031253, "o", "\\t\\tif len(entries) == 1 || mean > bestMean {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3395.031305, "o", "\\t\\t\\tbest = name\r\n\u001b[?2004l\r\u001b[?2004h> "]
