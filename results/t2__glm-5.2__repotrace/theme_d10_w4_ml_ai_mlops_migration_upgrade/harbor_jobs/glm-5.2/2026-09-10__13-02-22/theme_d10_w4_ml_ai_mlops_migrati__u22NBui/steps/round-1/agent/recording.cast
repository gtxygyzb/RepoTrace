[4680.609822, "o", "\u001b[?2004h> "]
[4680.610062, "o", "\\t\\t\\t\\treturn nil, nil, attempt, true\r\n\u001b[?2004l\r"]
[4680.610128, "o", "\u001b[?2004h> "]
[4680.610188, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[4680.610244, "o", "\u001b[?2004h> "]
[4680.610293, "o", "\\t\\t} else {\r\n\u001b[?2004l\r"]
[4680.610349, "o", "\u001b[?2004h> "]
[4680.610426, "o", "\\t\\t\\tres := <-resChan\r\n\u001b[?2004l\r"]
[4680.61049, "o", "\u001b[?2004h> "]
