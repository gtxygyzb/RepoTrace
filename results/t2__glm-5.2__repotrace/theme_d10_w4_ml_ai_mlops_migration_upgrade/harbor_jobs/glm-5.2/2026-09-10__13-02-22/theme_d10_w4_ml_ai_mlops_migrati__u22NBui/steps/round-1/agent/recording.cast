[499.85949, "o", "s = s.replace('if err := h.Registry.DeleteModel(name); err != nil {\\n\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\\n\\t\\treturn\\n\\t}\\n\\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})',\r\n\u001b[?2004l\r"]
[499.859554, "o", "\u001b[?2004h> "]
[499.861307, "o", "              'if err := h.Registry.DeleteModel(name); err != nil {\\n\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\\n\\t\\treturn\\n\\t}\\n\\t_ = h.Serving.UnloadModel(name)\\n\\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})')\r\n\u001b[?2004l\r"]
[499.861375, "o", "\u001b[?2004h> "]
[499.864807, "o", "s = s.replace('result, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam)\\n\\tif err != nil {\\n\\t\\twriteError(w, http.StatusBadRequest, \"%v\", err)\\n\\t\\treturn\\n\\t}\\n\\n\\texp, _ := h.Experiment.GetExperiment(expName)\\n\\trunCount := 0\\n\\tif exp != nil {\\n\\t\\trunCount = len(exp.Runs)\\n\\t}\\n\\twriteJSON(w, http.StatusOK, map[string]interface{}{\\n\\t\\t\"experiment\": expName,\\n\\t\\t\"metric\":     metricName,\\n\\t\\t\"type\":       aggType,\\n\\t\\t\"value\":      result,\\n\\t\\t\"count\":      runCount,\\n\\t})',\r\n\u001b[?2004l\r"]
[499.864957, "o", "\u001b[?2004h> "]
[499.867484, "o", "              'result, count, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam)\\n\\tif err != nil {\\n\\t\\twriteError(w, http.StatusBadRequest, \"%v\", err)\\n\\t\\treturn\\n\\t}\\n\\n\\twriteJSON(w, http.StatusOK, map[string]interface{}{\\n\\t\\t\"experiment\": expName,\\n\\t\\t\"metric\":     metricName,\\n\\t\\t\"type\":       aggType,\\n\\t\\t\"value\":      result,\\n\\t\\t\"count\":      count,\\n\\t})')\r\n\u001b[?2004l\r"]
