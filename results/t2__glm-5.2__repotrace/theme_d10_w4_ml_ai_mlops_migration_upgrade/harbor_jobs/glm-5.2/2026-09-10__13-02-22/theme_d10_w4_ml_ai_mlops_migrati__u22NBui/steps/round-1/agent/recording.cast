[3201.610922, "i", "s.Successful)\n\t}\n\n\tfor name, model := range s.stats.Models {\n\t\tm := ModelStatsResponse{\n\t\t\tRequests:   model.Requests,\n\t\t\tSuccessful: model.Successful,\n\t\t\tFailed:     model.Failed,\n\t\t}\n\t\tif model.Successful > 0 {\n\t\t\tm.AvgLatencyMs = model.LatencySum / float64(model.Successful)\n\t\t}\n\t\tresp.Models[name] = m\n\t}\n\treturn resp\n}\n\n// ResetStats resets all serving statistics to zero.\nfunc (s *Server) ResetStats() {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\n\ts.stats = Stats{\n\t\tModels: make(map[string]*ModelStats),\n\t}\n}\n'''\ns = s.replace('\\n// ListLoaded returns all currently loaded models.', insert + '\\n// ListLoaded returns all currently loaded models.')\n# remove unused sort if necessary later\np.write_text(s)\nPY\ngofmt -w internal/serving/serving.go\ngo build ./internal/serving/\n"]
