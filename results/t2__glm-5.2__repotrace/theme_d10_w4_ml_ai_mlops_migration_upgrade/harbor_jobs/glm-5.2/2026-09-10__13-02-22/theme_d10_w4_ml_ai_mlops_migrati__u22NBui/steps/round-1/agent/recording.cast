[5689.475943, "o", "     1\tpackage pipeline\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"math\"\r\n     6\t\t\"sort\"\r\n     7\t\t\"time\"\r\n     8\t)\r\n"]
[5689.476049, "o", "     9\t\r\n    10\t// ExecuteTransform applies a data transformation.\r\n    11\t// Supported modes: scale, offset, normalize, identity, clip, log.\r\n    12\tfunc ExecuteTransform(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n    13\t\tdata, ok := input[\"data\"].([]interface{})\r\n    14\t\tif !ok {\r\n    15\t\t\treturn nil, fmt.Errorf(\"transform: missing or invalid 'data' field in input\")\r\n    16\t\t}\r\n    17"]
[5689.476138, "o", "\t\r\n    18\t\tmode, _ := config[\"mode\"].(string)\r\n    19\t\tif mode == \"\" {\r\n    20\t\t\treturn nil, fmt.Errorf(\"transform: missing 'mode' in config\")\r\n    21\t\t}\r\n    22\t\r\n    23\t\tresult := make([]interface{}, len(data))\r\n    24\t\r\n    25\t\tswitch mode {\r\n    26\t\tcase \"scale\":\r\n    27\t\t\tfactor, _ := config[\"factor\"].(float64)\r\n    28\t\t\tfor i, v := range data {\r\n    29\t\t\t\tval, err := toFloat(v)\r\n    30\t\t\t\tif err != nil {\r\n    31\t\t\t\t\treturn nil, fmt.Errorf(\"transform scale: element %d: %w\", i, err)\r\n    32\t\t\t\t}\r\n    33\t\t\t\tresult[i] = val * factor\r\n    34\t\t\t}\r\n    35"]
[5689.476214, "o", "\t\r\n    36\t\tcase \"offset\":\r\n    37\t\t\toffset, _ := config[\"offset\"].(float64)\r\n    38\t\t\tfor i, v := range data {\r\n    39\t\t\t\tval, err := toFloat(v)\r\n    40\t\t\t\tif err != nil {\r\n    41\t\t\t\t\treturn nil, fmt.Errorf(\"transform offset: element %d: %w\", i, err)\r\n    42\t\t\t\t}\r\n    43\t\t\t\tresult[i] = val + offset\r\n    44\t\t\t}\r\n    45\t\r\n"]
[5689.476295, "o", "    46\t\tcase \"normalize\":\r\n    47\t\t\tif len(data) == 0 {\r\n    48\t\t\t\treturn map[string]interface{}{\"data\": result}, nil\r\n    49\t\t\t}\r\n    50\t\t\tminVal, maxVal := findMinMax(data)\r\n    51\t\t\tfor i, v := range data {\r\n    52\t\t\t\tval, err := toFloat(v)\r\n    53\t\t\t\tif err != nil {\r\n    54\t\t\t\t\treturn nil, fmt.Errorf(\"transform normalize: element %d: %w\", i, err)\r\n    55\t\t\t\t}\r\n    56\t\t\t\tif maxVal == minVal {\r\n"]
[5689.476366, "o", "    57\t\t\t\t\tresult[i] = 0.0\r\n    58\t\t\t\t} else {\r\n    59\t\t\t\t\tresult[i] = 2.0*(val-minVal)/(maxVal-minVal) - 1.0\r\n    60\t\t\t\t}\r\n    61\t\t\t}\r\n    62\t\r\n    63\t\tcase \"identity\":\r\n    64\t\t\tcopy(result, data)\r\n    65\t\r\n"]
[5689.476443, "o", "    66\t\tcase \"clip\":\r\n    67\t\t\tlow, _ := config[\"low\"].(float64)\r\n    68\t\t\thigh, _ := config[\"high\"].(float64)\r\n    69\t\t\tfor i, v := range data {\r\n    70\t\t\t\tval, err := toFloat(v)\r\n    71\t\t\t\tif err != nil {\r\n    72\t\t\t\t\treturn nil, fmt.Errorf(\"transform clip: element %d: %w\", i, err)\r\n    73\t\t\t\t}\r\n    74\t\t\t\tif val < low {\r\n    75\t\t"]
[5689.476516, "o", "\t\t\tval = low\r\n    76\t\t\t\t}\r\n    77\t\t\t\tif val > high {\r\n    78\t\t\t\t\tval = high\r\n    79\t\t\t\t}\r\n    80\t\t\t\tresult[i] = val\r\n    81\t\t\t}\r\n    82\t\r\n    83\t\tcase \"log\":\r\n    84\t\t\tfor i, v := range data {\r\n"]
[5689.476591, "o", "    85\t\t\t\tval, err := toFloat(v)\r\n    86\t\t\t\tif err != nil {\r\n    87\t\t\t\t\treturn nil, fmt.Errorf(\"transform log: element %d: %w\", i, err)\r\n    88\t\t\t\t}\r\n    89\t\t\t\tif val <= 0 {\r\n    90\t\t\t\t\treturn nil, fmt.Errorf(\"transform log: element %d is non-positive (%f)\", i, val)\r\n    91\t\t\t\t}\r\n    92\t\t\t\tresult[i] = math.Log(val)\r\n    93\t\t\t}\r\n"]
[5689.476668, "o", "    94\t\r\n    95\t\tdefault:\r\n    96\t\t\treturn nil, fmt.Errorf(\"transform: unknown mode %q\", mode)\r\n    97\t\t}\r\n    98\t\r\n    99\t\treturn map[string]interface{}{\"data\": result}, nil\r\n   100\t}\r\n   101\t\r\n   102\t// ExecuteValidate checks data against schema constraints.\r\n   103\tfunc ExecuteValidate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   104\t\tdata, ok := input[\"data\"].([]interface{})\r\n   105\t\tif !ok {\r\n"]
[5689.476744, "o", "   106\t\t\treturn nil, fmt.Errorf(\"validate: missing or invalid 'data' field\")\r\n   107\t\t}\r\n   108\t\r\n   109\t\tvar errors []interface{}\r\n   110\t\r\n   111\t\t// Check min_value constraint\r\n   112\t\tif minVal, ok := config[\"min_value\"].(float64); ok {\r\n   113\t\t\tfor i, v := range data {\r\n   114\t\t\t\tval, err := toFloat(v)\r\n   115\t\t\t\tif err != nil {\r\n"]
