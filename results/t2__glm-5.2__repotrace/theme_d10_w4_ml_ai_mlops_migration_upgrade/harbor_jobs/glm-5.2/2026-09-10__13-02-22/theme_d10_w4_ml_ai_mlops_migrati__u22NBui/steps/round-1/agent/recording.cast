[6424.369973, "o", "\u001b[35m\u001b[K./internal/registry/registry.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K599\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tdirect := append([]string{}, r.\u001b[01;31m\u001b[Kdependencies\u001b[m\u001b[K[modelName]...)\r\n\u001b[35m\u001b[K./internal/registry/registry.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K624\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tdirect := r.\u001b[01;31m\u001b[Kdependencies\u001b[m\u001b[K[modelName]\r\n\u001b[35m\u001b[K./internal/registry/registry.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K636\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tr.\u001b[01;31m\u001b[Kdependencies\u001b[m\u001b[K[modelName] = append(direct[:idx], direct[idx+1:]...)\r\n"]
