[4483.845492, "i", "time.Now(),\n\\t\\t})\n\\t}\n\n\\tt.experiments[newName] = clone\n\\tif err := t.saveExperiment(clone); err != nil {\n\\t\\tdelete(t.experiments, newName)\n\\t\\treturn nil, err\n\\t}\n\\treturn clone, nil\n}\n\n// BulkTagRuns merges tags into multiple runs in an experiment.\nfunc (t *Tracker) BulkTagRuns(experimentName string, runIDs []string, tags map[string]string) (int, []string, error) {\n\\tt.mu.Lock()\n\\tdefer t.mu.Unlock()\n\n\\texp, exists := t.experiments[experimentName]\n\\tif !exists {\n\\t\\treturn 0, nil, fmt.Errorf(\"experiment %q not found\", experimentName)\n\\t}\n\n\\trunByID := make(map[string]*Run, len(exp.Runs))\n\\tfor _, run := range exp.Runs {\n\\t\\trunByID[run.ID] = run\n\\t}\n\n\\tnotFound := make([]string, 0)\n\\tupdated := 0\n\\tfor _, id := range runIDs {\n\\t\\trun, ok := runByID[id]\n\\t\\tif !ok {\n\\t\\t\\tnotFound = append(notFound, id)\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif run.Tags == nil {\n\\t\\t\\trun.Tags = make(map[string]string)\n\\t\\t}\n\\t\\tfor k, v := range tags {\n\\t\\t\\trun.Tags[k] = v\n\\t\\t}\n\\t\\tupdated++\n\\t}\n\n\\tif updated > 0 {\n\\t\\tif err := t.sa"]
