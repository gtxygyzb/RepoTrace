[4031.945183, "o", "   306\t// letters, digits, and underscores.\r\n   307\tfunc ValidateAnnotationKey(key string) bool {\r\n   308\t\treturn validateAnnotationKey(key)\r\n   309\t}\r\n   310\t\r\n   311\t// findVersionLocked returns the version pointer for the given model and version number.\r\n   312\t// The caller must hold an appropriate lock.\r\n   313\tfunc (r *Registry) findVersionLocked(modelName string, versionNum int) (*Model, *Version, error) {\r\n   314\t\tmodel, exists := r.models[modelName]\r\n   315\t\tif !exists {\r\n"]
