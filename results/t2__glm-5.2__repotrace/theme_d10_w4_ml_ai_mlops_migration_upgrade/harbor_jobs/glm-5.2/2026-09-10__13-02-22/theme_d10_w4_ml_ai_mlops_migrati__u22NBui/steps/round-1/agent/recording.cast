[5636.512996, "o", "   844\t}\r\n   845\t\r\n   846\t// --- Model Version Filtering Handler ---\r\n   847\t\r\n   848\tfunc (h *Handlers) ListModelVersions(w http.ResponseWriter, r *http.Request) {\r\n   849\t\tmodelName := r.PathValue(\"name\")\r\n   850\t\tstageFilter := r.URL.Query().Get(\"stage\")\r\n   851\t\tminMetricParam := r.URL.Query().Get(\"min_metric\")\r\n   852\t\r\n   853\t\tvar metricName string\r\n   854\t\tvar metricThreshold float64\r\n"]
[5636.513065, "o", "   855\t\tif minMetricParam != \"\" {\r\n   856\t\t\tparts := strings.SplitN(minMetricParam, \":\", 2)\r\n   857\t\t\tif len(parts) != 2 || parts[0] == \"\" {\r\n   858\t\t\t\twriteError(w, http.StatusBadRequest, \"invalid min_metric format, expected name:value\")\r\n   859\t\t\t\treturn\r\n   860\t\t\t}\r\n   861\t\t\tval, err := strconv.ParseFloat(parts[1], 64)\r\n   862\t\t\tif err != nil {\r\n   863\t\t\t\twriteError(w, http.StatusBadRequest, \"invalid min_metric value: %v\", err)\r\n"]
[5636.513139, "o", "   864\t\t\t\treturn\r\n   865\t\t\t}\r\n   866\t\t\tmetricName = parts[0]\r\n   867\t\t\tmetricThreshold = val\r\n   868\t\t}\r\n   869\t\r\n   870\t\tmodel, err := h.Registry.GetModel(modelName)\r\n   871\t\tif err != nil {\r\n   872\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   873\t\t\treturn\r\n   874\t\t}\r\n   875\t\r\n"]
[5636.513211, "o", "   876\t\tversions := make([]*registry.Version, 0, len(model.Versions))\r\n   877\t\tfor _, v := range model.Versions {\r\n   878\t\t\tif stageFilter != \"\" && string(v.Stage) != stageFilter {\r\n   879\t\t\t\tcontinue\r\n   880\t\t\t}\r\n   881\t\t\tif metricName != \"\" {\r\n   882\t\t\t\tval, ok := v.Metrics[metricName]\r\n   883\t\t\t\tif !ok || val < metricThreshold {\r\n   884\t\t\t\t\tcontinue\r\n   885\t\t\t\t}\r\n"]
[5636.51329, "o", "   886\t\t\t}\r\n   887\t\t\tversions = append(versions, v)\r\n   888\t\t}\r\n   889\t\r\n   890\t\tsort.Slice(versions, func(i, j int) bool {\r\n   891\t\t\treturn versions[i].Number > versions[j].Number\r\n   892\t\t})\r\n   893\t\r\n   894\t\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n   895\t\t\t\"model\":    modelName,\r\n   896\t\t\t\"versions\": versions,\r\n   897\t\t\t\"count\":    len(versions),\r\n   898"]
[5636.513361, "o", "\t\t})\r\n   899\t}\r\n   900\t\r\n   901\t// --- Model Lineage Handler ---\r\n   902\t\r\n   903\tfunc (h *Handlers) ModelLineage(w http.ResponseWriter, r *http.Request) {\r\n   904\t\tmodelName := r.PathValue(\"name\")\r\n   905\t\tmodel, err := h.Registry.GetModel(modelName)\r\n   906\t\tif err != nil {\r\n   907\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n   908"]
[5636.513433, "o", "\t\t\treturn\r\n   909\t\t}\r\n   910\t\r\n   911\t\tversions := make([]*registry.Version, len(model.Versions))\r\n   912\t\tcopy(versions, model.Versions)\r\n   913\t\tsort.Slice(versions, func(i, j int) bool {\r\n   914\t\t\treturn versions[i].Number < versions[j].Number\r\n   915\t\t})\r\n   916\t\r\n   917\t\tentries := make([]map[string]interface{}, 0, len(versions))\r\n   918\t\tfor _, v := range versions {\r\n   919"]
[5636.513507, "o", "\t\t\tpromotions := []registry.PromotionRecord{}\r\n   920\t\t\tif v.Lineage != nil {\r\n   921\t\t\t\tpromotions = append(promotions, v.Lineage...)\r\n   922\t\t\t}\r\n   923\t\t\tentry := map[string]interface{}{\r\n   924\t\t\t\t\"version\":       v.Number,\r\n   925\t\t\t\t\"current_stage\": string(v.Stage),\r\n   926\t\t\t\t\"promotions\":    promotions,\r\n   927\t\t\t}\r\n"]
[5636.513576, "o", "   928\t\t\tif v.DemotedBy != 0 {\r\n   929\t\t\t\tentry[\"demoted_by\"] = v.DemotedBy\r\n   930\t\t\t}\r\n   931\t\t\tentries = append(entries, entry)\r\n   932\t\t}\r\n   933\t\r\n   934\t\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n   935\t\t\t\"model\":    modelName,\r\n   936\t\t\t\"versions\": entries,\r\n   937\t\t})\r\n   938\t}\r\n"]
[5636.513646, "o", "   939\t\r\n   940\t// --- Model Dependency Handlers ---\r\n   941\t\r\n   942\tfunc (h *Handlers) DeclareDependencies(w http.ResponseWriter, r *http.Request) {\r\n   943\t\tmodelName := r.PathValue(\"name\")\r\n   944\t\tvar req struct {\r\n   945\t\t\tDependsOn []string `json:\"depends_on\"`\r\n   946\t\t}\r\n   947\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n   948\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n   949\t\t\treturn\r\n   950\t\t}\r\n"]
