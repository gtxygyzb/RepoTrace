[2008.910207, "o", "\r\n   149\t\t}, nil\r\n   150\t}\r\n   151\t\r\n   152\t// ExecuteAggregate computes aggregations over input data.\r\n   153\t// Supported operations: sum, mean, count, min, max.\r\n   154\tfunc ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   155\t\tdata, ok := input[\"data\"].([]interface{})\r\n   156\t\tif !ok {\r\n   157\t\t\treturn nil, fmt.Errorf(\"aggregate: missing or invalid 'data' field\")\r\n   158\t\t}\r\n   159\t\r\n   160\t\toperation, _ := config[\"operation\"].(string)\r\n"]
[2008.910291, "o", "   161\t\tif operation == \"\" {\r\n   162\t\t\treturn nil, fmt.Errorf(\"aggregate: missing 'operation' in config\")\r\n   163\t\t}\r\n   164\t\r\n   165\t\tvalues := make([]float64, 0, len(data))\r\n   166\t\tfor _, v := range data {\r\n   167\t\t\tval, err := toFloat(v)\r\n   168\t\t\tif err != nil {\r\n   169\t\t\t\tcontinue\r\n   170\t\t\t}\r\n   171\t\t\tvalues = append(values, val)\r\n   172\t\t}\r\n"]
[2008.910375, "o", "   173\t\r\n   174\t\tif len(values) == 0 {\r\n   175\t\t\treturn map[string]interface{}{\"result\": 0.0, \"count\": 0.0}, nil\r\n   176\t\t}\r\n   177\t\r\n   178\t\tvar result float64\r\n   179\t\tswitch operation {\r\n   180\t\tcase \"sum\":\r\n   181\t\t\tfor _, v := range values {\r\n   182\t\t\t\tresult += v\r\n   183\t\t\t}\r\n"]
[2008.910459, "o", "   184\t\tcase \"mean\":\r\n   185\t\t\tfor _, v := range values {\r\n   186\t\t\t\tresult += v\r\n   187\t\t\t}\r\n   188\t\t\tresult /= float64(len(values))\r\n   189\t\tcase \"count\":\r\n   190\t\t\tresult = float64(len(values))\r\n   191\t\tcase \"min\":\r\n   192\t\t\tresult = values[0]\r\n   193\t\t\tfor _, v := range values[1:] {\r\n   194\t\t\t\tif v < result {\r\n   195\t\t\t\t\tresult = v\r\n"]
[2008.910539, "o", "   196\t\t\t\t}\r\n   197\t\t\t}\r\n   198\t\tcase \"max\":\r\n   199\t\t\tresult = values[0]\r\n   200\t\t\tfor _, v := range values[1:] {\r\n   201\t\t\t\tif v > result {\r\n   202\t\t\t\t\tresult = v\r\n   203\t\t\t\t}\r\n   204\t\t\t}\r\n   205\t\tcase \"range\":\r\n"]
[2008.910623, "o", "   206\t\t\tif len(values) < 2 {\r\n   207\t\t\t\tresult = 0.0\r\n   208\t\t\t} else {\r\n   209\t\t\t\tminVal := values[0]\r\n   210\t\t\t\tmaxVal := values[0]\r\n   211\t\t\t\tfor _, v := range values[1:] {\r\n   212\t\t\t\t\tif v < minVal {\r\n   213\t\t\t\t\t\tminVal = v\r\n   214\t\t\t\t\t}\r\n   215\t\t\t\t\tif v > maxVal {\r\n   216\t\t\t\t\t\tmaxVal = v\r\n   217\t\t\t\t\t}\r\n   218\t\t\t\t}\r\n"]
