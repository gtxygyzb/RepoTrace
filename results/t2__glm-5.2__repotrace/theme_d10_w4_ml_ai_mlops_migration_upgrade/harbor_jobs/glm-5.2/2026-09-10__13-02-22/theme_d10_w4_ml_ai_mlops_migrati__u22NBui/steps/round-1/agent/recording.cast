[143.941032, "o", "     1\tpackage registry\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"path/filepath\"\r\n     8\t\t\"sort\"\r\n"]
[143.941145, "o", "     9\t\t\"sync\"\r\n    10\t\t\"time\"\r\n    11\t)\r\n    12\t\r\n    13\t// Stage represents the lifecycle stage of a model version.\r\n    14\ttype Stage string\r\n    15\t\r\n    16\tconst (\r\n    17\t\tStageDevelopment Stage = \"development\"\r\n    18\t\tStageStaging     Stage = \"staging\"\r\n    19\t\tStageProduction  Stage = \"production\"\r\n    20\t\tStageArchived    Stage = \"archived\"\r\n    21\t)\r\n    22\t\r\n    23\tvar validTransitions = map[Stage][]Stage{\r\n    24\t\t"]
[143.9412, "o", "StageDevelopment: {StageStaging, StageArchived},\r\n    25\t\tStageStaging:     {StageProduction, StageArchived},\r\n    26\t\tStageProduction:  {StageArchived},\r\n    27\t\tStageArchived:    {},\r\n    28\t}\r\n    29\t\r\n    30\t// Version represents a specific version of a model.\r\n    31\ttype Version struct {\r\n    32\t\t"]
[143.941298, "o", "Number      int                    `json:\"number\"`\r\n    33\t\tStage       Stage                  `json:\"stage\"`\r\n    34\t\tMetrics     map[string]float64     `json:\"metrics\"`\r\n    35\t\tTags        []string               `json:\"tags\"`\r\n    36\t\tModelConfig map[string]interface{} `json:\"model_config,omitempty\"`\r\n    37\t\tCreatedAt   time.Time              `json:\"created_at\"`\r\n    38\t}\r\n    39\t\r\n    40\t// Model represents a registered ML model.\r\n    41\ttype Model struct {\r\n    42\t\tName        string     `json:\"name\"`\r\n    43\t\tFramework   string     `json:\"framework\"`\r\n    44\t\tDescription string     `json:\"description\"`\r\n    45\t\tTags        []string   `json:\"tags\"`\r\n"]
[143.941364, "o", "    46\t\tVersions    []*Version `json:\"versions\"`\r\n    47\t\tCreatedAt   time.Time  `json:\"created_at\"`\r\n    48\t\tUpdatedAt   time.Time  `json:\"updated_at\"`\r\n    49\t}\r\n    50\t\r\n    51\t// ModelFilter defines filtering criteria for listing models.\r\n    52\ttype ModelFilter struct {\r\n    53\t\tFramework string\r\n    54\t\tTag       string\r\n    55\t}\r\n    56\t\r\n"]
[143.941431, "o", "    57\t// Registry manages model registration, versioning, and lifecycle.\r\n    58\ttype Registry struct {\r\n    59\t\tmu      sync.RWMutex\r\n    60\t\tmodels  map[string]*Model\r\n    61\t\tdataDir string\r\n    62\t}\r\n    63\t\r\n    64\t// NewRegistry creates a new Registry backed by the given data directory.\r\n    65\tfunc NewRegistry(dataDir string) (*Registry, error) {\r\n"]
[143.941493, "o", "    66\t\tif err := os.MkdirAll(dataDir, 0755); err != nil {\r\n    67\t\t\treturn nil, fmt.Errorf(\"create data dir: %w\", err)\r\n    68\t\t}\r\n    69\t\tr := &Registry{\r\n    70\t\t\tmodels:  make(map[string]*Model),\r\n    71\t\t\tdataDir: dataDir,\r\n    72\t\t}\r\n    73\t\tif err := r.loadAll(); err != nil {\r\n    74\t\t\treturn nil, fmt.Errorf(\"load registry: %w\", err)\r\n    75\t"]
[143.941564, "o", "\t}\r\n    76\t\treturn r, nil\r\n    77\t}\r\n    78\t\r\n    79\t// RegisterModel creates a new model entry in the registry.\r\n    80\tfunc (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {\r\n    81\t\tr.mu.Lock()\r\n    82\t\tdefer r.mu.Unlock()\r\n    83\t\r\n    84\t\tif _, exists := r.models[name]; exists {\r\n    85\t\t\treturn nil, fmt.Errorf(\"model %q already exists\", name)\r\n    86\t\t}\r\n"]
[143.941628, "o", "    87\t\r\n    88\t\tnow := time.Now()\r\n    89\t\tmodel := &Model{\r\n    90\t\t\tName:        name,\r\n    91\t\t\tFramework:   framework,\r\n    92\t\t\tDescription: description,\r\n    93\t\t\tTags:        tags,\r\n    94\t\t\tVersions:    make([]*Version, 0),\r\n    95\t\t\tCreatedAt:   now,\r\n"]
[143.94169, "o", "    96\t\t\tUpdatedAt:   now,\r\n    97\t\t}\r\n    98\t\tr.models[name] = model\r\n    99\t\tif err := r.saveModel(model); err != nil {\r\n   100\t\t\tdelete(r.models, name)\r\n   101\t\t\treturn nil, err\r\n   102\t\t}\r\n   103\t\treturn model, nil\r\n   104"]
[143.941754, "o", "\t}\r\n   105\t\r\n   106\t// CreateVersion adds a new version to the specified model.\r\n   107\tfunc (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {\r\n   108\t\tr.mu.Lock()\r\n   109\t\tdefer r.mu.Unlock()\r\n   110\t\r\n   111\t\tmodel, exists := r.models[modelName]\r\n"]
[143.94183, "o", "   112\t\tif !exists {\r\n   113\t\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n   114\t\t}\r\n   115\t\r\n   116\t\tnextNum := 1\r\n   117\t\tfor _, v := range model.Versions {\r\n   118\t\t\tif v.Number >= nextNum {\r\n   119\t\t\t\tnextNum = v.Number + 1\r\n"]
[143.941912, "o", "   120\t\t\t}\r\n   121\t\t}\r\n   122\t\r\n   123\t\tversion := &Version{\r\n   124\t\t\tNumber:      nextNum,\r\n   125\t\t\tStage:       StageDevelopment,\r\n   126\t\t\tMetrics:     metrics,\r\n"]
[143.941992, "o", "   127\t\t\tTags:        tags,\r\n   128\t\t\tModelConfig: modelConfig,\r\n   129\t\t\tCreatedAt:   time.Now(),\r\n   130\t\t}\r\n   131\t\tmodel.Versions = append(model.Versions, version)\r\n   132\t\tmodel.UpdatedAt = time.Now()\r\n   133\t\r\n   134\t\tif err := r.saveModel(model); err != nil {\r\n   135\t\t\tmodel.Versions = model.Versions[:len(model.Versions)-1]\r\n   136\t\t\treturn nil, err\r\n   137\t\t}\r\n   138\t\treturn version, nil\r\n   139\t}\r\n   140\t\r\n   141\t// PromoteVersion transitions a model version to the specified stage.\r\n   142\t"]
[143.942057, "o", "func (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {\r\n   143\t\tr.mu.Lock()\r\n   144\t\tdefer r.mu.Unlock()\r\n   145\t\r\n   146\t\tmodel, exists := r.models[modelName]\r\n   147\t\tif !exists {\r\n   148\t\t\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n   149\t\t}\r\n   150\t\r\n   151\t\tvar version *Version\r\n"]
[143.942119, "o", "   152\t\tfor _, v := range model.Versions {\r\n   153\t\t\tif v.Number == versionNum {\r\n   154\t\t\t\tversion = v\r\n   155\t\t\t\tbreak\r\n   156\t\t\t}\r\n   157\t\t}\r\n   158\t\tif version == nil {\r\n   159\t\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n   160\t\t}\r\n   161\t\r\n"]
[143.942187, "o", "   162\t\t// Validate stage transition\r\n   163\t\tallowed := validTransitions[version.Stage]\r\n   164\t\tvalid := false\r\n   165\t\tfor _, s := range allowed {\r\n   166\t\t\tif s == targetStage {\r\n   167"]
[143.942251, "o", "\t\t\t\tvalid = true\r\n   168\t\t\t\tbreak\r\n   169\t\t\t}\r\n   170\t\t}\r\n   171\t\tif !valid {\r\n   172\t\t\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n   173\t\t}\r\n   174\t\r\n   175\t\t// If promoting to production, demote current production version\r\n   176\t\tif targetStage == StageProduction {\r\n   177\t\t\tfor _, v := range model.Versions {\r\n   178\t\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n   179\t\t\t\t\tv.Stage = StageArchived\r\n"]
[143.942319, "o", "   180\t\t\t\t}\r\n   181\t\t\t}\r\n   182\t\t}\r\n   183\t\r\n   184\t\tversion.Stage = targetStage\r\n   185\t\tmodel.UpdatedAt = time.Now()\r\n   186\t\r\n   187\t\treturn r.saveModel(model)\r\n   188\t}\r\n   189\t\r\n"]
[143.942383, "o", "   190\t// GetModel returns a model with its versions sorted by version number descending.\r\n   191\tfunc (r *Registry) GetModel(name string) (*Model, error) {\r\n   192\t\tr.mu.RLock()\r\n   193\t\tdefer r.mu.RUnlock()\r\n   194\t\r\n   195\t\tmodel, exists := r.models[name]\r\n   196\t\tif !exists {\r\n   197\t\t\treturn nil, fmt.Errorf(\"model %q not found\", name)\r\n"]
[143.942453, "o", "   198\t\t}\r\n   199\t\r\n   200\t\t// Return a copy with versions sorted\r\n   201\t\tresult := *model\r\n   202\t\tresult.Versions = make([]*Version, len(model.Versions))\r\n   203\t\tcopy(result.Versions, model.Versions)\r\n   204\t\tsort.Slice(result.Versions, func(i, j int) bool {\r\n   205\t\t\treturn result.Versions[i].Number < result.Versions[j].Number\r\n   206\t\t})\r\n   207\t\treturn &result, nil\r\n   208\t}"]
[143.942517, "o", "\r\n   209\t\r\n   210\t// ListModels returns all models matching the optional filter.\r\n   211\tfunc (r *Registry) ListModels(filter *ModelFilter) ([]*Model, error) {\r\n   212\t\tr.mu.RLock()\r\n   213\t\tdefer r.mu.RUnlock()\r\n   214\t\r\n   215\t\tvar result []*Model\r\n   216\t\tfor _, model := range r.models {\r\n   217\t\t\tif filter != nil {\r\n   218\t\t\t"]
[143.942585, "o", "\tif filter.Framework != \"\" && model.Framework != filter.Framework {\r\n   219\t\t\t\t\tcontinue\r\n   220\t\t\t\t}\r\n   221\t\t\t\tif filter.Tag != \"\" {\r\n   222\t\t\t\t\thasTag := false\r\n   223\t\t\t\t\tfor _, t := range model.Tags {\r\n   224\t\t\t\t\t\tif t == filter.Tag {\r\n   225\t\t\t\t\t\t\thasTag = true\r\n"]
[143.942644, "o", "   226\t\t\t\t\t\t\tbreak\r\n   227\t\t\t\t\t\t}\r\n   228\t\t\t\t\t}\r\n   229\t\t\t\t\tif !hasTag {\r\n   230\t\t\t\t\t\tcontinue\r\n   231\t\t\t\t\t}\r\n   232\t\t\t\t}\r\n"]
[143.942703, "o", "   233\t\t\t}\r\n   234\t\t\tresult = append(result, model)\r\n   235\t\t}\r\n   236\t\tsort.Slice(result, func(i, j int) bool {\r\n   237\t\t\treturn result[i].Name < result[j].Name\r\n   238\t\t})\r\n   239\t\treturn result, nil\r\n   240\t}\r\n   241\t\r\n   242\t"]
[143.942769, "o", "// DeleteModel removes a model from the registry.\r\n   243\tfunc (r *Registry) DeleteModel(name string) error {\r\n   244\t\tr.mu.Lock()\r\n   245\t\tdefer r.mu.Unlock()\r\n   246\t\r\n   247\t\tif _, exists := r.models[name]; !exists {\r\n   248\t\t\treturn fmt.Errorf(\"model %q not found\", name)\r\n   249\t\t}\r\n   250\t\r\n   251\t\tdelete(r.models, name)\r\n"]
[143.942831, "o", "   252\t\tfilename := filepath.Join(r.dataDir, name+\".json\")\r\n   253\t\tos.Remove(filename)\r\n   254\t\treturn nil\r\n   255\t}\r\n   256\t\r\n   257\t// GetVersion returns a specific version of a model.\r\n   258\tfunc (r *Registry) GetVersion(modelName string, versionNum int) (*Version, error) {\r\n   259\t\tr.mu.RLock()\r\n   260\t\tdefer r.mu.RUnlock()\r\n"]
