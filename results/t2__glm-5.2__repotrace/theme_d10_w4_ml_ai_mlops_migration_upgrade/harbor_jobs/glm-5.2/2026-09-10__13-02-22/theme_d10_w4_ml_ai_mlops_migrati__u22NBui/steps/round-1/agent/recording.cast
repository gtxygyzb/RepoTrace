[211.065187, "o", "   164\t\tvalid := false\r\n   165\t\tfor _, s := range allowed {\r\n   166\t\t\tif s == targetStage {\r\n   167\t\t\t\tvalid = true\r\n   168\t\t\t\tbreak\r\n   169\t\t\t}\r\n   170\t\t}\r\n   171\t\tif !valid {\r\n   172\t\t\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n   173\t\t}\r\n   174\t\r\n   175\t\t// If promoting to production, demote current production version\r\n   176\t\tif targetStage == StageProduction {\r\n"]
[211.065252, "o", "   177\t\t\tfor _, v := range model.Versions {\r\n   178\t\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n   179\t\t\t\t\tv.Stage = StageArchived\r\n   180\t\t\t\t}\r\n   181\t\t\t}\r\n   182\t\t}\r\n   183\t\r\n   184\t\tversion.Stage = targetStage\r\n   185\t\t"]
