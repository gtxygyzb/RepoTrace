[1504.228096, "o", "\\treturn true\r\n\u001b[?2004l\r\u001b[?2004h"]
[1504.228155, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
