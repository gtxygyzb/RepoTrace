[6956.310272, "o", "\u001b[?2004h> "]
[6956.310397, "o", "\\t\\t\"stage\":       loaded.Stage,\r\n\u001b[?2004l\r"]
[6956.310453, "o", "\u001b[?2004h> \\t})\r\n\u001b[?2004l\r"]
[6956.310504, "o", "\u001b[?2004h> }\r\n"]
[6956.310558, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
