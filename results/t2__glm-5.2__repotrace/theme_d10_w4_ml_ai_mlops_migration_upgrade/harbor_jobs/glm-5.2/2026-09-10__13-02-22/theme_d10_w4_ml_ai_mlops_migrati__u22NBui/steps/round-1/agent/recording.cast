[170.522541, "o", "}\r\n\tsort.Slice(result, func(i, j int) bool {\r\n\t\treturn result[i].Name < result[j].Name\r\n\t})\r\n\treturn result, nil\r\n}\r\n\r\n// DeleteModel removes a model from the registry.\r\nfunc (r *Registry) DeleteModel(name string) error {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tif _, exists := r.models[name]; !exists {\r\n\t\treturn fmt.Errorf(\"model %q not found\", name)\r\n\t}\r\n"]
[170.522638, "o", "\r\n\tdelete(r.models, name)\r\n\tfilename := filepath.Join(r.dataDir, name+\".json\")\r\n\tos.Remove(filename)\r\n\treturn nil\r\n}\r\n\r\n// GetVersion returns a specific version of a model.\r\n"]
[170.522707, "o", "func (r *Registry) GetVersion(modelName string, versionNum int) (*Version, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Number == versionNum {\r\n\t\t\treturn v, nil\r\n\t\t}\r\n\t}\r\n\treturn nil, fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n}\r\n\r\n// GetVersionByStage returns the version of a model currently in the specified stage.\r\nfunc (r *Registry) GetVersionByStage(modelName string, stage Stage) (*Version, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n"]
[170.522775, "o", "\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Stage == stage {\r\n\t\t\treturn v, nil\r\n\t\t}\r\n\t}\r\n\t"]
[170.522835, "o", "return nil, fmt.Errorf(\"no version in stage %s for model %q\", stage, modelName)\r\n}\r\n\r\n// loadAll reads all model files from the data directory.\r\nfunc (r *Registry) loadAll() error {\r\n\tentries, err := os.ReadDir(r.dataDir)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil\r\n\t\t}\r\n\t\treturn err\r\n\t"]
[170.522875, "o", "}\r\n\tfor _, entry := range entries {\r\n\t\tif !entry.IsDir() && filepath.Ext(entry.Name()) == \".json\" {\r\n\t\t\tdata, err := os.ReadFile(filepath.Join(r.dataDir, entry.Name()))\r\n"]
[170.522963, "o", "\t\t\tif err != nil {\r\n\t\t\t\treturn err\r\n\t\t\t}\r\n\t\t\tvar model Model\r\n"]
[170.523026, "o", "\t\t\tif err := json.Unmarshal(data, &model); err != nil {\r\n\t\t\t\treturn err\r\n\t\t\t}\r\n\t\t\tr.models[model.Name] = &model\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n// saveModel writes a model's data to its JSON file.\r\nfunc (r *Registry) saveModel(model *Model) error {\r\n\tdata, err := json.MarshalIndent(model, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tfilename := filepath.Join(r.dataDir, model.Name+\".json\")\r\n\treturn os.WriteFile(filename, data, 0644)\r\n}\r\n"]
[170.5235, "o", "\u001b[?2004h"]
