[4031.945303, "o", "   324\t\treturn nil, nil, fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n   325\t}\r\n   326\t\r\n   327\t// validateAnnotationKey returns true if key is non-empty and contains only\r\n   328\t// letters, digits, and underscores.\r\n   329\tfunc validateAnnotationKey(key string) bool {\r\n   330\t\treturn annotationKeyRegexp.MatchString(key)\r\n"]
