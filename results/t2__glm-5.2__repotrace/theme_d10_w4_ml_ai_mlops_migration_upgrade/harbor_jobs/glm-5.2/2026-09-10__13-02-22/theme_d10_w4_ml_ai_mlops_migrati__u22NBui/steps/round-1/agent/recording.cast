[171.919215, "i", "sed -n '1,180p' internal/serving/serving.go\n"]
[171.919563, "o", "sed -n '1,180p' internal/serving/serving.go\r\n"]
[171.919666, "o", "\u001b[?2004l\r"]
[171.922363, "o", "package serving\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"sync\"\r\n\t\"time\"\r\n\r\n"]
[171.922453, "o", "\t\"gomlops/internal/registry\"\r\n)\r\n\r\n// LoadedModel tracks a model version currently loaded for serving.\r\ntype LoadedModel struct {\r\n\tModelName   string                 `json:\"model_name\"`\r\n\tVersionNum  int                    `json:\"version_num\"`\r\n\tStage       registry.Stage         `json:\"stage\"`\r\n\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n\tLoadedAt    time.Time              `json:\"loaded_at\"`\r\n}\r\n\r\n// InferenceRequest contains the input data for model inference.\r\ntype InferenceRequest struct {\r\n\tModelName string    `json:\"model_name\"`\r\n\tInput     []float64 `json:\"input\"`\r\n}\r\n"]
[171.922534, "o", "\r\n// InferenceResponse contains the model prediction results.\r\ntype InferenceResponse struct {\r\n\tModelName   string      `json:\"model_name\"`\r\n\tVersion     interface{} `json:\"version\"`\r\n\tPredictions []float64   `json:\"predictions\"`\r\n\tLatencyMs   float64     `json:\"latency_ms\"`\r\n}\r\n\r\n// Server manages model loading and inference.\r\ntype Server struct {\r\n\tmu       sync.RWMutex\r\n\tloaded   map[string]*LoadedModel\r\n\tregistry *registry.Registry\r\n"]
[171.922654, "o", "}\r\n\r\n// NewServer creates a new serving server backed by the given registry.\r\nfunc NewServer(reg *registry.Registry) *Server {\r\n\treturn &Server{\r\n\t\tloaded:   make(map[string]*LoadedModel),\r\n\t\tregistry: reg,\r\n\t}\r\n}\r\n\r\n// LoadModel loads a model version for serving. Specify either versionNum > 0\r\n// or a non-empty stage string (not both).\r\nfunc (s *Server) LoadModel(modelName string, versionNum int, stage string) error {\r\n\tvar version *registry.Version\r\n\tvar err error\r\n\r\n\tif versionNum > 0 {\r\n\t\tversion, err = s.registry.GetVersion(modelName, versionNum)\r\n\t} else if stage != \"\" {\r\n\t\tversion, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))\r\n\t} else {\r\n\t\treturn fmt.Errorf(\"must specify version number or stage\")\r\n\t}\r\n"]
[171.922716, "o", "\r\n\tif err != nil {\r\n\t\treturn fmt.Errorf(\"load model: %w\", err)\r\n\t}\r\n\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\ts.loaded[modelName] = &LoadedModel{\r\n\t\tModelName:   modelName,\r\n\t\tVersionNum:  version.Number,\r\n\t\tStage:       version.Stage,\r\n\t"]
[171.922774, "o", "\tModelConfig: version.ModelConfig,\r\n\t\tLoadedAt:    time.Now(),\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n// UnloadModel removes a model from the serving cache.\r\nfunc (s *Server) UnloadModel(modelName string) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\tif _, exists := s.loaded[modelName]; !exists {\r\n"]
[171.922832, "o", "\t\treturn fmt.Errorf(\"model %q is not loaded\", modelName)\r\n\t}\r\n\tdelete(s.loaded, modelName)\r\n\treturn nil\r\n}\r\n\r\n// Infer runs inference on the loaded model and returns predictions.\r\nfunc (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {\r\n\tstart := time.Now()\r\n\r\n\ts.mu.RLock()\r\n\t"]
[171.92288, "o", "loaded, exists := s.loaded[req.ModelName]\r\n\ts.mu.RUnlock()\r\n\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", req.ModelName)\r\n\t}\r\n\r\n"]
[171.922963, "o", "\tpredictions, err := computePrediction(loaded.ModelConfig, req.Input)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n\t}\r\n\r\n\t"]
[171.923025, "o", "latency := float64(time.Since(start).Microseconds()) / 1000.0\r\n\r\n\treturn &InferenceResponse{\r\n\t\tModelName:   req.ModelName,\r\n\t\tVersion:     string(loaded.Stage),\r\n\t\tPredictions: predictions,\r\n\t\tLatencyMs:   latency,\r\n\t}, nil\r\n}\r\n\r\n// ListLoaded returns all currently loaded models.\r\nfunc (s *Server) ListLoaded() []*LoadedModel {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\r\n\tresult := make([]*LoadedModel, 0, len(s.loaded))\r\n\tfor _, lm := range s.loaded {\r\n\t\tresult = append(result, lm)\r\n\t}\r\n\treturn result\r\n}\r\n\r\n// computePrediction evaluates a model against input data.\r\n// Supported model types: linear, polynomial.\r\n"]
[171.923082, "o", "func computePrediction(modelConfig map[string]interface{}, input []float64) ([]float64, error) {\r\n\tif modelConfig == nil {\r\n\t\treturn nil, fmt.Errorf(\"model has no configuration\")\r\n\t}\r\n\r\n\tmodelType, _ := modelConfig[\"model_type\"].(string)\r\n\tswitch modelType {\r\n\tcase \"linear\":\r\n\t\treturn linearPredict(modelConfig, input)\r\n\tcase \"polynomial\":\r\n"]
[171.923147, "o", "\t\treturn polynomialPredict(modelConfig, input)\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"unsupported model type: %s\", modelType)\r\n\t}\r\n}\r\n\r\n// linearPredict computes y = sum(weights[i] * input[i]) + bias\r\nfunc linearPredict(config map[string]interface{}, input []float64) ([]float64, error) {\r\n\tweightsRaw, ok := config[\"weights\"].([]interface{})\r\n\tif !ok {\r\n\t"]
[171.923205, "o", "\treturn nil, fmt.Errorf(\"linear model missing weights\")\r\n\t}\r\n\tbias, _ := config[\"bias\"].(float64)\r\n\r\n\tweights := make([]float64, len(weightsRaw))\r\n\tfor i, w := range weightsRaw {\r\n\t\twf, ok := w.(float64)\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"weight %d is not a number\", i)\r\n"]
[171.923262, "o", "\t\t}\r\n\t\tweights[i] = wf\r\n\t}\r\n\r\n\tprediction := bias\r\n\tfor i := 0; i < len(weights) && i < len(input); i++ {\r\n\t\tprediction += weights[i] * input[i]\r\n\t}\r\n\r\n\treturn []float64{prediction}, nil\r\n}\r\n"]
[171.923318, "o", "\r\n// polynomialPredict computes y = sum(coefficients[i] * x^i) for each input x\r\nfunc polynomialPredict(config map[string]interface{}, input []float64) ([]float64, error) {\r\n\tcoeffRaw, ok := config[\"coefficients\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"polynomial model missing coefficients\")\r\n\t}\r\n\r\n"]
[171.923803, "o", "\u001b[?2004h"]
[171.923873, "o", "root@n30009:/app# "]
[172.192332, "i", "sed -n '1,180p' internal/api/handlers.go\n"]
[172.192654, "o", "sed -n '1,180p' internal/api/handlers.go\r\n\u001b[?2004l\r"]
[172.195664, "o", "package api\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[172.195743, "o", "\t\"net/http\"\r\n\t\"strconv\"\r\n\r\n\t\"gomlops/internal/pipeline\"\r\n\t\"gomlops/internal/registry\"\r\n\t\"gomlops/internal/serving\"\r\n)\r\n\r\n// --- Model Registry Handlers ---\r\n\r\nfunc (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tName        string   `json:\"name\"`\r\n\t\tFramework   string   `json:\"framework\"`\r\n\t\tDescription string   `json:\"description\"`\r\n"]
[172.195815, "o", "\t\tTags        []string `json:\"tags\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Name == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"name is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tmodel, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)\r\n"]
[172.195913, "o", "\tif err != nil {\r\n\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, model)\r\n}\r\n\r\nfunc (h *Handlers) ListModels(w http.ResponseWriter, r *http.Request) {\r\n\tvar filter *registry.ModelFilter\r\n\tframework := r.URL.Query().Get(\"framework\")\r\n\ttag := r.URL.Query().Get(\"tag\")\r\n\tif framework != \"\" || tag != \"\" {\r\n\t\tfilter = &registry.ModelFilter{Framework: framework, Tag: tag}\r\n\t}\r\n\r\n\tmodels, err := h.Registry.ListModels(filter)\r\n"]
[172.195976, "o", "\tif err != nil {\r\n\t\twriteError(w, http.StatusInternalServerError, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, models)\r\n}\r\n\r\nfunc (h *Handlers) DeleteModel(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\tif err := h.Registry.DeleteModel(name); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n"]
[172.196037, "o", "\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n}\r\n\r\nfunc (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\tmodel, err := h.Registry.GetModel(name)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, model)\r\n}\r\n\r\n"]
[172.196101, "o", "func (h *Handlers) CreateVersion(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\r\n\tvar req struct {\r\n\t\tMetrics     map[string]float64     `json:\"metrics\"`\r\n\t\tTags        []string               `json:\"tags\"`\r\n\t\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n"]
[172.196159, "o", "\r\n\tversion, err := h.Registry.CreateVersion(modelName, req.Metrics, req.Tags, req.ModelConfig)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, version)\r\n}\r\n\r\nfunc (h *Handlers) GetVersion(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\tnumStr := r.PathValue(\"num\")\r\n"]
[172.196218, "o", "\tnum, err := strconv.Atoi(numStr)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\t\treturn\r\n\t}\r\n\r\n\tversion, err := h.Registry.GetVersion(modelName, num)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, version)\r\n"]
[172.19628, "o", "}\r\n\r\nfunc (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\tnumStr := r.PathValue(\"num\")\r\n\tnum, err := strconv.Atoi(numStr)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\t\treturn\r\n\t}\r\n\r\n\tvar req struct {\r\n"]
[172.196339, "o", "\t\tStage string `json:\"stage\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Stage == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"stage is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tif err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {\r\n"]
[172.196395, "o", "\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"promoted\"})\r\n}\r\n\r\n// --- Pipeline Handlers ---\r\n\r\nfunc (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tPipeline *pipeline.Pipeline     `json:\"pipeline\"`\r\n"]
[172.196453, "o", "\t\tInput    map[string]interface{} `json:\"input\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Pipeline == nil || len(req.Pipeline.Steps) == 0 {\r\n\t\twriteError(w, http.StatusBadRequest, \"pipeline with at least one step is required\")\r\n\t\treturn\r\n\t}"]
[172.196532, "o", "\r\n\tif req.Input == nil {\r\n\t\treq.Input = make(map[string]interface{})\r\n\t}\r\n\r\n\tresult, err := h.Pipeline.Execute(req.Pipeline, req.Input)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, result)"]
[172.196598, "o", "\r\n}\r\n\r\n// --- Experiment Handlers ---\r\n\r\nfunc (h *Handlers) CreateExperiment(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tName string `json:\"name\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n"]
[172.196668, "o", "\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Name == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"name is required\")\r\n"]
[172.196726, "o", "\t\treturn\r\n"]
