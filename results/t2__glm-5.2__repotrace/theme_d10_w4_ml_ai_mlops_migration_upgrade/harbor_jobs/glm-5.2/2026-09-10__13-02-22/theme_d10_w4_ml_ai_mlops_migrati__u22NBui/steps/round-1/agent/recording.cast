[3997.665038, "o", "   357\tfunc (h *Handlers) CompareVersionMetrics(w http.ResponseWriter, r *http.Request) {\r\n   358\t\tmodelName := r.PathValue(\"name\")\r\n   359\t\tversionParam := r.URL.Query().Get(\"versions\")\r\n   360\t\tif versionParam == \"\" {\r\n"]
[3997.665071, "o", "   361\t\t\twriteError(w, http.StatusBadRequest, \"query parameter 'versions' is required\")\r\n   362\t\t\treturn\r\n   363\t\t}\r\n   364\t\r\n   365\t\tparts := strings.Split(versionParam, \",\")\r\n   366\t\tseen := map[int]bool{}\r\n"]
[3997.665242, "o", "   367\t\tversionNums := make([]int, 0, len(parts))\r\n   368\t\tfor _, p := range parts {\r\n   369\t\t\tnum, err := strconv.Atoi(strings.TrimSpace(p))\r\n   370\t\t\tif err != nil {\r\n   371\t\t\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %q\", p)\r\n   372\t\t\t\treturn\r\n   373\t\t\t}\r\n   374\t\t\tif seen[num] {\r\n   375\t\t\t\twriteError(w, http.StatusBadRequest, \"duplicate version number: %d\", num)\r\n   376\t\t\t\treturn\r\n   377\t\t\t}\r\n   378\t\t\tseen[num] = true\r\n   379\t\t\tversionNums = append(versionNums, num)\r\n   380\t\t}\r\n   381\t\tif len(versionNums) < 2 {\r\n   382\t\t\twriteError(w, http.StatusBadRequest, \"at least 2 versions are required for comparison\")\r\n   383\t\t\treturn\r\n   384\t\t}\r\n   385\t\r\n   386\t\tmodel, err := h.Registry.GetModel(modelName)\r\n   387\t\tif err != nil {\r\n   388\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n"]
[3997.66534, "o", "   389\t\t\treturn\r\n   390\t\t}\r\n   391\t\r\n   392\t\tsort.Ints(versionNums)\r\n   393\t\tversionMap := map[int]*registry.Version{}\r\n   394\t\tfor _, v := range model.Versions {\r\n   395\t\t\tversionMap[v.Number] = v\r\n   396\t\t}\r\n   397\t\r\n   398\t\tversions := make([]map[string]interface{}, 0, len(versionNums))\r\n   399\t\tfor _, num := range versionNums {\r\n   400\t\t\tv, ok := versionMap[num]\r\n   401\t\t\tif !ok {\r\n"]
[3997.665435, "o", "   402\t\t\t\twriteError(w, http.StatusBadRequest, \"version %d does not exist for model %q\", num, modelName)\r\n   403\t\t\t\treturn\r\n   404\t\t\t}\r\n   405\t\t\tversions = append(versions, map[string]interface{}{\r\n   406\t\t\t\t\"number\":  v.Number,\r\n   407\t\t\t\t\"stage\":   v.Stage,\r\n   408\t\t\t\t\"metrics\": v.Metrics,\r\n   409\t\t\t})\r\n   410\t\t}\r\n   411\t\r\n   412\t\tmetricSummary := map[string]map[string]interface{}{}\r\n   413\t\tmetricValues := map[string][]float64{}\r\n"]
[3997.665518, "o", "   414\t\tfor _, v := range versions {\r\n   415\t\t\tmetrics, _ := v[\"metrics\"].(map[string]float64)\r\n   416\t\t\tfor name, val := range metrics {\r\n   417\t\t\t\tmetricValues[name] = append(metricValues[name], val)"]
[3997.665605, "o", "\r\n   418\t\t\t}\r\n   419\t\t}\r\n   420\t\r\n   421\t\tfor name, vals := range metricValues {\r\n   422\t\t\tif len(vals) == 0 {\r\n   423\t\t\t\tcontinue\r\n   424\t\t\t}\r\n   425\t\t\tminVal := vals[0]\r\n   426\t\t\tmaxVal := vals[0]\r\n   427\t\t\tsum := 0.0\r\n   428\t\t\tfor _, val := range vals {\r\n   429\t\t\t\tif val < minVal {\r\n   430\t\t\t\t\tminVal = val\r\n   431\t\t\t\t}\r\n   432\t\t\t\tif val > maxVal {\r\n   433\t\t\t\t\tmaxVal = val\r\n   434\t\t\t\t}\r\n"]
[3997.665701, "o", "   435\t\t\t\tsum += val\r\n   436\t\t\t}\r\n   437\t\t\tfirst := vals[0]\r\n   438\t\t\tlast := vals[len(vals)-1]\r\n   439\t\t\timprovement := last - first\r\n   440\t\t\ttrend := \"stable\"\r\n   441\t\t\tif improvement > 0 {\r\n   442\t\t\t\ttrend = \"improving\"\r\n   443\t\t\t} else if improvement < 0 {\r\n   444\t\t\t\ttrend = \"degrading\"\r\n   445\t\t\t}\r\n   446\t\t\tmetricSummary[name] = map[string]interface{}{\r\n   447\t\t\t\t\"min\":         minVal,\r\n   448\t\t\t\t\"max\":         maxVal,\r\n   449\t\t"]
[3997.665787, "o", "\t\t\"first\":       first,\r\n   450\t\t\t\t\"last\":        last,\r\n   451\t\t\t\t\"improvement\": improvement,\r\n   452\t\t\t\t\"mean\":        sum / float64(len(vals)),\r\n   453\t\t\t\t\"trend\":       trend,\r\n   454\t\t\t}\r\n   455\t\t}\r\n   456\t\r\n   457\t\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n   458\t\t\t\"model\":          modelName,\r\n"]
[3997.665918, "o", "   459\t\t\t\"versions\":       versions,\r\n   460\t\t\t\"metric_summary\": metricSummary,\r\n"]
