[1990.33317, "o", "\u001b[35m\u001b[Kinternal/experiment/experiment.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// in an experiment. Supported types: mean, median, p95, p99, \u001b[01;31m\u001b[Kweighted_mean\u001b[m\u001b[K.\r\n"]
[1990.333263, "o", "\u001b[35m\u001b[Kinternal/experiment/experiment.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// For \u001b[01;31m\u001b[Kweighted_mean\u001b[m\u001b[K, weightParam specifies which parameter to use as weight.\r\n\u001b[35m\u001b[Kinternal/experiment/experiment.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif aggType == \"\u001b[01;31m\u001b[Kweighted_mean\u001b[m\u001b[K\" {\r\n\u001b[35m\u001b[Kinternal/experiment/experiment.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kweighted_mean\u001b[m\u001b[K\":\r\n\u001b[35m\u001b[Kinternal/experiment/experiment.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K199\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn 0, 0, nil, fmt.Errorf(\"\u001b[01;31m\u001b[Kweighted_mean\u001b[m\u001b[K requires weight parameter\")\r\n"]
[1990.333319, "o", "\u001b[35m\u001b[Kinternal/experiment/experiment.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn 0, 0, nil, fmt.Errorf(\"\u001b[01;31m\u001b[Kweighted_mean\u001b[m\u001b[K has zero total weight\")\r\n"]
[1990.333524, "o", "\u001b[35m\u001b[Kinternal/api/handlers.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (h *Handlers) \u001b[01;31m\u001b[KPromoteVersion\u001b[m\u001b[K(w http.ResponseWriter, r *http.Request) {\r\n\u001b[35m\u001b[Kinternal/api/handlers.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif err := h.Registry.\u001b[01;31m\u001b[KPromoteVersion\u001b[m\u001b[K(modelName, num, registry.Stage(req.Stage)); err != nil {\r\n"]
[1990.33375, "o", "\u001b[35m\u001b[Kinternal/api/router.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"PUT /api/v1/models/{name}/versions/{num}/promote\", h.\u001b[01;31m\u001b[KPromoteVersion\u001b[m\u001b[K)\r\n"]
[1990.334506, "o", "\u001b[35m\u001b[Kinternal/pipeline/steps.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// Supported modes: scale, offset, \u001b[01;31m\u001b[Knormalize\u001b[m\u001b[K, identity, clip, log.\r\n"]
[1990.334578, "o", "\u001b[35m\u001b[Kinternal/pipeline/steps.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Knormalize\u001b[m\u001b[K\":\r\n\u001b[35m\u001b[Kinternal/pipeline/steps.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn nil, fmt.Errorf(\"transform \u001b[01;31m\u001b[Knormalize\u001b[m\u001b[K: element %d: %w\", i, err)\r\n"]
