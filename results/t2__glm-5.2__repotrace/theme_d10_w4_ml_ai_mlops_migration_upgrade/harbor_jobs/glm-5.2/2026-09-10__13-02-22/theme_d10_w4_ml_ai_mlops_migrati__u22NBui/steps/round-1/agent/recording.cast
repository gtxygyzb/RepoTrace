[5635.576018, "o", "    14\t// Stage represents the lifecycle stage of a model version.\r\n    15\ttype Stage string\r\n    16\t\r\n    17\tconst (\r\n    18\t\tStageDevelopment Stage = \"development\"\r\n    19\t\tStageStaging     Stage = \"staging\"\r\n    20\t\tStageProduction  Stage = \"production\"\r\n    21\t\tStageArchived    Stage = \"archived\"\r\n    22\t)\r\n    23\t\r\n    24\tvar validTransitions = map[Stage][]Stage{\r\n    25\t\tStageDevelopment: {StageStaging, StageArchived},\r\n    26\t\tStageStaging:     {StageProduction, StageArchived},\r\n    27\t\tStageProduction:  {StageArchived},\r\n    28\t\tStageArchived:    {},\r\n    29\t}\r\n    30\t\r\n    31\t// PromotionRecord records a single stage transition in a version's lineage.\r\n    32\ttype PromotionRecord struct {\r\n    33\t\tFromStage Stage  `json:\"from_stage\"`\r\n    34\t\tToStage   Stage  `json:\"to_stage\"`\r\n    35\t\tTimestamp string `json:\"timestamp\"`\r\n    36\t}\r\n    37\t\r\n    38\t// Version represents a specific version of a model.\r\n    39\ttype Version struct {\r\n    40\t\tNumber      int                    `json:\"number\"`\r\n    41\t\tSta"]
[5635.576142, "o", "ge       Stage                  `json:\"stage\"`\r\n    42\t\tMetrics     map[string]float64     `json:\"metrics\"`\r\n    43\t\tTags        []string               `json:\"tags\"`\r\n    44\t\tModelConfig map[string]interface{} `json:\"model_config,omitempty\"`\r\n    45\t\tCreatedAt   time.Time              `json:\"created_at\"`\r\n    46\t\tLineage     []PromotionRecord      `json:\"lineage\"`\r\n    47\t\tDemotedBy   int                    `json:\"demoted_by,omitempty\"`\r\n    48\t}\r\n    49\t\r\n    50\t// Model represents a registered ML model.\r\n    51\ttype Model struct {\r\n    52\t\tName         string     `json:\"name\"`\r\n    53\t\tFramework    string     `json:\"framework\"`\r\n    54\t\tDescription  string     `json:\"description\"`\r\n    55\t\tTags         []string   `json:\"tags\"`\r\n    56\t\tVersions     []*Version `json:\"versions\"`\r\n    57\t\tDependencies []string   `json:\"dependencies\"`\r\n    58\t\tCreatedAt    time.Time  `json:\"created_at\"`\r\n    59\t\tUpdatedAt    time.Time  `json:\"updated_at\"`\r\n    60\t}\r\n    61\t\r\n    62\t// ModelFilter defines filtering criteria for "]
[5635.576251, "o", "listing models.\r\n    63\ttype ModelFilter struct {\r\n    64\t\tFramework string\r\n    65\t\tTag       string\r\n    66\t}\r\n    67\t\r\n    68\t// Annotation represents a key-value annotation attached to a model version.\r\n    69\ttype Annotation struct {\r\n    70\t\tKey       string    `json:\"key\"`\r\n    71\t\tValue     string    `json:\"value\"`\r\n    72\t\tCreatedAt time.Time `json:\"created_at\"`\r\n    73\t}\r\n    74\t\r\n    75\tvar annotationKeyRegexp = regexp.MustCompile(`^[A-Za-z0-9_]+$`)\r\n    76\t\r\n    77\t// Registry manages model registration, versioning, and lifecycle.\r\n    78\ttype Registry struct {\r\n    79\t\tmu           sync.RWMutex\r\n    80\t\tmodels       map[string]*Model\r\n    81\t\tdataDir      string\r\n    82\t\tannotations  map[string]map[int]map[string]*Annotation\r\n    83\t\tdependencies map[string][]string\r\n    84\t}\r\n    85\t\r\n    86\t// NewRegistry creates a new Registry backed by the given data directory.\r\n    87\tfunc NewRegistry(dataDir string) (*Registry, error) {\r\n    88\t\tif err := os.MkdirAll(dataDir, 0755); err != nil {\r\n    89\t\t\tr"]
[5635.576366, "o", "eturn nil, fmt.Errorf(\"create data dir: %w\", err)\r\n    90\t\t}\r\n    91\t\tr := &Registry{\r\n    92\t\t\tmodels:       make(map[string]*Model),\r\n    93\t\t\tdataDir:      dataDir,\r\n    94\t\t\tannotations:  make(map[string]map[int]map[string]*Annotation),\r\n    95\t\t\tdependencies: make(map[string][]string),\r\n    96\t\t}\r\n    97\t\tif err := r.loadAll(); err != nil {\r\n    98\t\t\treturn nil, fmt.Errorf(\"load registry: %w\", err)\r\n    99\t\t}\r\n   100\t\treturn r, nil\r\n   101\t}\r\n   102\t\r\n   103\t// RegisterModel creates a new model entry in the registry.\r\n   104\tfunc (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {\r\n   105\t\tr.mu.Lock()\r\n   106"]
[5635.576473, "o", "\t\tdefer r.mu.Unlock()\r\n   107\t\r\n   108\t\tif _, exists := r.models[name]; exists {\r\n   109\t\t\treturn nil, fmt.Errorf(\"model %q already exists\", name)\r\n   110\t\t}\r\n   111\t\r\n   112\t\tnow := time.Now()\r\n   113\t\tif tags == nil {\r\n   114\t\t\ttags = []string{}\r\n   115\t\t}\r\n   116\t\tmodel := &Model{\r\n   117\t\t\tName:         name,\r\n   118\t\t\tFramework:    framework,\r\n   119\t\t\tDescription:  description,\r\n   120\t\t\tTags:         tags,\r\n"]
[5635.576582, "o", "   121\t\t\tVersions:     make([]*Version, 0),\r\n   122\t\t\tDependencies: []string{},\r\n   123\t\t\tCreatedAt:    now,\r\n   124\t\t\tUpdatedAt:    now,\r\n   125\t\t}\r\n   126\t\tr.models[name] = model\r\n   127\t\tr.dependencies[name] = []string{}\r\n   128\t\tif err := r.saveModel(model); err != nil {\r\n   129\t\t\tdelete(r.models, name)\r\n   130\t\t\treturn nil, err\r\n   131\t\t}\r\n   132\t\treturn model, nil\r\n   133\t}\r\n   134\t\r\n   135\t// CreateVersion adds a new version to the specified model.\r\n   136\tfunc (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {\r\n   137\t\tr.mu.Lock()\r\n"]
[5635.576682, "o", "   138\t\tdefer r.mu.Unlock()\r\n   139\t\r\n   140\t\tmodel, exists := r.models[modelName]\r\n   141\t\tif !exists {\r\n   142\t\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n   143\t\t}\r\n   144\t\r\n   145\t\tnextNum := 1\r\n   146\t\tfor _, v := range model.Versions {\r\n   147\t\t\tif v.Number >= nextNum {\r\n   148\t\t\t\tnextNum = v.Number + 1\r\n   149\t\t\t}\r\n   150\t\t}\r\n   151\t"]
[5635.576785, "o", "\r\n   152\t\tif tags == nil {\r\n   153\t\t\ttags = []string{}\r\n   154\t\t}\r\n   155\t\tversion := &Version{\r\n   156\t\t"]
[5635.576907, "o", "\tNumber:      nextNum,\r\n   157\t\t\tStage:       StageDevelopment,\r\n   158\t\t\tMetrics:     metrics,\r\n   159\t\t\tTags:        tags,\r\n   160\t\t\tModelConfig: modelConfig,\r\n   161\t\t\tCreatedAt:   time.Now(),\r\n   162\t\t\tLineage:     []PromotionRecord{},\r\n   163\t\t}\r\n   164\t\tmodel.Versions = append(model.Versions, version)\r\n   165\t\tmodel.UpdatedAt = time.Now()\r\n   166\t\r\n   167\t\tif err := r.saveModel(model); err != nil {\r\n   168\t\t\tmodel.Versions = model.Versions[:len(model.Versions)-1]\r\n   169\t\t\treturn nil, err\r\n   170\t\t}\r\n   171\t\treturn version, nil\r\n   172\t}\r\n"]
[5635.577005, "o", "   173\t\r\n   174\t// PromoteVersion transitions a model version to the specified stage.\r\n   175\tfunc (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {\r\n   176\t\tr.mu.Lock()\r\n   177\t\tdefer r.mu.Unlock()\r\n   178\t\r\n   179\t\tmodel, exists := r.models[modelName]\r\n   180\t\tif !exists {\r\n   181\t\t\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n   182\t\t}\r\n   183\t\r\n   184\t\tvar version *Version\r\n   185\t\tfor _, v := range model.Versions {\r\n   186\t\t\tif v.Number == versionNum {\r\n   187\t\t\t\tversion = v\r\n   188\t\t\t\tbreak\r\n   189\t\t\t}\r\n   190\t\t}\r\n   191\t\tif version == nil {\r\n   192\t\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n   193\t\t}\r\n   194"]
[5635.577106, "o", "\t\r\n   195\t\t// Validate stage transition\r\n   196\t\tallowed := validTransitions[version.Stage]\r\n   197\t\tvalid := false\r\n   198\t\tfor _, s := range allowed {\r\n   199\t\t\tif s == targetStage {\r\n   200\t\t\t\tvalid = true\r\n   201\t\t\t\tbreak\r\n   202\t\t\t}\r\n   203\t\t}\r\n   204\t\tif !valid {\r\n   205\t\t\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n   206\t\t}\r\n   207\t\r\n   208\t"]
[5635.57721, "o", "\tpromotionTime := time.Now().UTC().Format(time.RFC3339)\r\n   209\t\r\n   210\t\t// If promoting to production, demote current production version.\r\n   211\t\tif targetStage == StageProduction {\r\n   212\t\t\tfor _, v := range model.Versions {\r\n   213\t\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n   214\t\t\t\t\tif v.Lineage == nil {\r\n   215\t\t\t\t\t\tv.Lineage = []PromotionRecord{}\r\n   216\t\t\t\t\t}\r\n   217\t\t\t\t\tv.Lineage = append(v.Lineage, PromotionRecord{\r\n   218\t\t\t\t\t\tFromStage: StageProduction,\r\n   219\t\t\t\t\t\tToStage:   StageStaging,\r\n   220\t\t\t\t\t\tTimestamp: promotionTime,\r\n"]
[5635.577317, "o", "   221\t\t\t\t\t})\r\n   222\t\t\t\t\tv.DemotedBy = versionNum\r\n   223\t\t\t\t\tv.Stage = StageStaging\r\n   224\t\t\t\t}\r\n   225\t\t\t}\r\n   226\t\t}\r\n   227\t\r\n   228\t\tif version.Lineage == nil {\r\n   229\t\t\tversion.Lineage = []PromotionRecord{}\r\n   230\t\t}\r\n   231\t\tversion.Lineage = append(version.Lineage, PromotionRecord{\r\n   232\t\t\tFromStage: version.Stage,\r\n   233\t\t\tToStage:   targetStage,\r\n   234\t\t\tTimestamp: promotionTime,\r\n   235"]
[5635.577438, "o", "\t\t})\r\n   236\t\tversion.Stage = targetStage\r\n   237\t\tmodel.UpdatedAt = time.Now()\r\n   238\t\r\n   239\t\treturn r.saveModel(model)\r\n   240\t}\r\n   241\t\r\n   242\t// GetModel returns a model with its versions sorted by version number descending.\r\n"]
[5635.57756, "o", "   243\tfunc (r *Registry) GetModel(name string) (*Model, error) {\r\n   244\t\tr.mu.RLock()\r\n   245\t\tdefer r.mu.RUnlock()\r\n   246\t\r\n   247\t\tmodel, exists := r.models[name]\r\n   248\t\tif !exists {\r\n   249\t\t\treturn nil, fmt.Errorf(\"model %q not found\", name)\r\n   250\t\t}\r\n   251\t\r\n   252\t\t// Return a copy with versions sorted\r\n   253\t\tresult := *model\r\n   254\t\tresult.Versions = make([]*Version, len(model.Versions))\r\n   255\t\tcopy(result.Versions, model.Versions)\r\n   256\t\tsort.Slice(result.Versions, func(i, j int) bool {\r\n   257\t\t\treturn result.Versions[i].Number > result.Versions[j].Number\r\n   258\t\t})\r\n   259\t\treturn &result, nil\r\n   260\t}\r\n"]
