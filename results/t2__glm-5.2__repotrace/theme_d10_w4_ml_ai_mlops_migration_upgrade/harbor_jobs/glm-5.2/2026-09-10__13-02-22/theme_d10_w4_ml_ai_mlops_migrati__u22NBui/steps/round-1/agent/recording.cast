[2008.910785, "o", "\t\t}, nil\r\n   230\t}\r\n   231\t\r\n   232\t// ExecuteExport formats data for output.\r\n   233\t// Supported formats: json, csv, summary.\r\n   234\tfunc ExecuteExport(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   235\t\tformat, _ := config[\"format\"].(string)\r\n   236\t\tif format == \"\" {\r\n   237\t\t\tformat = \"json\"\r\n   238\t\t}\r\n   239\t\r\n   240"]
