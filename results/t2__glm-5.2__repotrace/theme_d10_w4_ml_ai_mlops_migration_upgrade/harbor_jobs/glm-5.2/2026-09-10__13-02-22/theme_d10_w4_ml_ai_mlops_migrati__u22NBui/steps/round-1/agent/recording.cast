[4186.447485, "o", "   127\t\treturn nil\r\n   128\t}\r\n   129\t\r\n   130\t// Infer runs inference on the loaded model and returns predictions.\r\n   131\tfunc (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {\r\n   132\t\tstart := time.Now()\r\n   133\t\r\n   134\t\ts.mu.RLock()\r\n   135\t\tloaded, exists := s.loaded[req.ModelName]\r\n   136\t\ts.mu.RUnlock()\r\n   137\t\r\n   138\t\tif !exists {\r\n   139\t\t\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", req.ModelName)\r\n   140\t\t}\r\n   141\t\r\n   142\t\tpredictions, err := computePrediction(loaded.ModelConfig, req.Input)\r\n   143\t\tif err != nil {\r\n   144\t\t\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n   145\t\t}\r\n   146\t\r\n   147\t\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n   148\t\r\n   149\t\treturn &InferenceResponse{\r\n   150\t\t\tModelName:   req.ModelName,"]
[4186.447569, "o", "\r\n   151\t\t\tVersion:     loaded.VersionNum,\r\n   152\t\t\tPredictions: predictions,\r\n   153\t\t\tLatencyMs:   latency,\r\n   154\t\t}, nil\r\n   155\t}\r\n   156\t\r\n   157\t// RecordRequest updates serving statistics for a single inference request.\r\n   158\tfunc (s *Server) RecordRequest(modelName string, successful bool, latencyMs float64) {\r\n   159\t\ts.mu.Lock()\r\n   160\t\tdefer s.mu.Unlock()\r\n   161\t\r\n   162\t\ts.stats.TotalRequests++\r\n   163"]
[4186.447642, "o", "\t\tif successful {\r\n   164\t\t\ts.stats.Successful++\r\n   165\t\t\ts.stats.LatencySum += latencyMs\r\n   166\t\t} else {\r\n   167\t\t"]
[4186.447714, "o", "\ts.stats.Failed++\r\n   168\t\t}\r\n   169\t\r\n   170\t\tmodel := s.stats.Models[modelName]\r\n   171\t\tif model == nil {\r\n   172\t\t\tmodel = &ModelStats{}\r\n   173\t\t\ts.stats.Models[modelName] = model\r\n   174\t\t}\r\n   175\t\tmodel.Requests++\r\n   176\t\tif successful {\r\n   177\t\t\tmodel.Successful++\r\n   178\t\t\tmodel.LatencySum += latencyMs\r\n   179\t\t} else {\r\n   180\t\t\tmodel.Failed++\r\n   181\t\t}\r\n   182\t}\r\n   183\t\r\n"]
[4186.447781, "o", "   184\t// GetStats returns a snapshot of accumulated serving statistics.\r\n   185\tfunc (s *Server) GetStats() StatsResponse {\r\n   186\t\ts.mu.RLock()\r\n   187\t\tdefer s.mu.RUnlock()\r\n   188\t\r\n   189\t\tresp := StatsResponse{\r\n   190\t\t\tTotalRequests: s.stats.TotalRequests,\r\n   191\t\t\tSuccessful:    s.stats.Successful,\r\n   192\t\t\tFailed:        s.stats.Failed,\r\n   193\t\t\tModels:        make(map[string]ModelStatsResponse),\r\n   194\t\t}\r\n   195\t\tif s.stats.Successful > 0 {\r\n   196\t"]
