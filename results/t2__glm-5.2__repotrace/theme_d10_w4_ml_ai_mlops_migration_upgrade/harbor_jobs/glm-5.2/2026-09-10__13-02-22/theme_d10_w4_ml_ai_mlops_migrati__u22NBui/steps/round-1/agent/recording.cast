[670.152887, "o", "   143\t\r\n   144\tfunc (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {\r\n   145\t\tvar req struct {\r\n   146\t\t\tPipeline *pipeline.Pipeline     `json:\"pipeline\"`\r\n"]
