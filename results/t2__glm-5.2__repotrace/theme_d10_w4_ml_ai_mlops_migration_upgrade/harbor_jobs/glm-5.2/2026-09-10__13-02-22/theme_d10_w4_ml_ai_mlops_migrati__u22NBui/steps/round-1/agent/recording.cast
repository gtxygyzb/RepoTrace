[4132.313557, "o", "     1\tpackage pipeline\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"sort\"\r\n"]
[4132.313658, "o", "     6\t\t\"strings\"\r\n     7\t\t\"time\"\r\n     8\t)\r\n     9\t\r\n    10\t// StepType identifies the kind of processing a pipeline step performs.\r\n    11\ttype StepType string\r\n    12\t\r\n    13\tconst (\r\n    14\t\tStepTransform StepType = \"transform\"\r\n    15\t\tStepValidate  StepType = \"validate\"\r\n    16\t\tStepAggregate StepType = \"aggregate\"\r\n    17\t\tStepExport    StepType = \"export\"\r\n    18\t\tStepFilter    StepType = \"filter\"\r\n    19\t)\r\n"]
[4132.313745, "o", "    20\t\r\n    21\t// Step defines a single unit of work in a pipeline.\r\n    22\ttype Step struct {\r\n    23\t\tName            string                 `json:\"name\"`\r\n    24\t\tType            StepType               `json:\"type\"`\r\n    25\t\tConfig          map[string]interface{} `json:\"config\"`\r\n    26\t\tDependencies    []string               `json:\"dependencies\"`\r\n    27\t\tSetVars         map[string]string      `json:\"set_vars,omitempty\"`\r\n    28\t\tOutputTransform string                 `json:\"output_transform,omitempty\"`\r\n    29\t}\r\n    30\t\r\n    31\t// Pipeline defines a named sequence of dependent steps.\r\n    32\ttype Pipeline struct {\r\n    33\t\tName  string  `json:\"name\"`\r\n    34\t\tSteps []*Step `json:\"steps\"`"]
[4132.313827, "o", "\r\n    35\t}\r\n    36\t\r\n    37\t// StepResult records the outcome of executing a single step.\r\n    38\ttype StepResult struct {\r\n    39\t\tStepName   string                 `json:\"step_name\"`\r\n    40\t\tStepType   StepType               `json:\"step_type\"`\r\n    41\t\tStatus     string                 `json:\"status\"`\r\n    42\t\tOutput     map[string]interface{} `json:\"output,omitempty\"`\r\n    43\t\tError      string                 `json:\"error,omitempty\"`\r\n    44\t\t"]
[4132.313932, "o", "DurationMs float64                `json:\"duration_ms\"`\r\n    45\t}\r\n    46\t\r\n    47\t// PipelineResult records the outcome of executing an entire pipeline.\r\n    48\ttype PipelineResult struct {\r\n    49\t\tPipelineName string        `json:\"pipeline_name\"`\r\n    50\t\tStatus       string        `json:\"status\"`\r\n    51\t\tSteps        []*StepResult `json:\"steps\"`\r\n    52\t\tTotalTimeMs  float64       `json:\"total_time_ms\"`\r\n    53\t}\r\n    54\t\r\n"]
[4132.313995, "o", "    55\t// Engine executes pipelines by resolving step dependencies and running each step.\r\n    56\ttype Engine struct {\r\n    57\t\tstepExecutors map[StepType]StepExecutor\r\n    58\t}\r\n    59\t\r\n    60\t// StepExecutor is the function signature for executing a pipeline step.\r\n    61\ttype StepExecutor func(config, input map[string]interface{}) (map[string]interface{}, error)\r\n"]
[4132.314054, "o", "    62\t\r\n    63\t// NewEngine creates a pipeline engine with built-in step executors.\r\n    64\tfunc NewEngine() *Engine {\r\n    65\t\te := &Engine{\r\n    66\t\t\tstepExecutors: make(map[StepType]StepExecutor),\r\n    67\t\t}\r\n    68\t\te.stepExecutors[StepTransform] = ExecuteTransform\r\n    69\t\te.stepExecutors[StepValidate] = ExecuteValidate\r\n"]
[4132.314112, "o", "    70\t\te.stepExecutors[StepAggregate] = ExecuteAggregate\r\n    71\t\te.stepExecutors[StepExport] = ExecuteExport\r\n    72\t\te.stepExecutors[StepFilter] = ExecuteFilter\r\n    73\t\treturn e\r\n    74\t}\r\n    75\t\r\n    76\t// ValidationResult describes the structural validation outcome of a pipeline.\r\n    77\ttype ValidationResult struct {\r\n    78\t\tValid          bool            `json:\"valid\"`\r\n"]
[4132.31417, "o", "    79\t\tExecutionOrder []string        `json:\"execution_order\"`\r\n    80\t\tStepCount      int             `json:\"step_count\"`\r\n    81\t\tSteps          []ValidatedStep `json:\"steps\"`\r\n    82\t\tErrors         []string        `json:\"errors\"`\r\n    83\t}\r\n    84\t\r\n    85\t"]
[4132.314242, "o", "// ValidatedStep contains structural details for a validated step.\r\n    86\ttype ValidatedStep struct {\r\n    87\t\tName         string   `json:\"name\"`\r\n    88\t\tType         StepType `json:\"type\"`\r\n    89\t\tDependencies []string `json:\"dependencies\"`\r\n    90\t}\r\n    91\t\r\n    92\t// Validate checks a pipeline definition for structural correctness without executing it.\r\n    93\tfunc (e *Engine) Validate(p *Pipeline) *ValidationResult {\r\n    94\t\tresult := &ValidationResult{\r\n    95\t\t\tValid:          true,\r\n"]
[4132.314304, "o", "    96\t\t\tExecutionOrder: []string{},\r\n    97\t\t\tSteps:          []ValidatedStep{},\r\n    98\t\t\tErrors:         []string{},\r\n    99\t\t}\r\n   100\t\tif p == nil {\r\n   101\t\t\tresult.Valid = false\r\n   102\t\t\tresult.Errors = append(result.Errors, \"pipeline definition is required\")\r\n   103\t\t"]
[4132.314372, "o", "\treturn result\r\n   104\t\t}\r\n   105\t\r\n   106\t\tstepCount := len(p.Steps)\r\n   107\t\tresult.StepCount = stepCount\r\n   108\t\r\n   109\t\tseen := make(map[string]bool)\r\n   110\t\tduplicateNames := make(map[string]bool)\r\n   111\t\tnameOrder := make([]string, 0, stepCount)\r\n   112\t\r\n   113\t"]
[4132.314434, "o", "\tfor _, step := range p.Steps {\r\n   114\t\t\tif step == nil {\r\n   115\t\t\t\tresult.Valid = false\r\n   116\t\t\t\tresult.Errors = append(result.Errors, \"step is null\")\r\n   117\t\t\t\tcontinue\r\n   118\t\t\t}\r\n   119\t\t\tresult.Steps = append(result.Steps, ValidatedStep{\r\n   120\t\t\t\tName:         step.Name,\r\n"]
