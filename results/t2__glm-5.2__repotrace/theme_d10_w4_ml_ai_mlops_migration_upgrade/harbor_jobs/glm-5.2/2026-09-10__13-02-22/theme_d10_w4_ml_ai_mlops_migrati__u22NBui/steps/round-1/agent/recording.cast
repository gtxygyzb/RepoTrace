[5635.246782, "o", "   183\t\t\t\tresult += v\r\n   184\t\t\t}\r\n   185\t\tcase \"mean\":\r\n   186\t\t\tfor _, v := range values {\r\n   187\t\t\t\tresult += v\r\n   188\t\t\t}\r\n   189\t\t\tresult /= float64(len(values))\r\n   190\t\tcase \"count\":\r\n   191\t\t\tresult = float64(len(values))\r\n   192\t\tcase \"min\":\r\n"]
[5635.246888, "o", "   193\t\t\tresult = values[0]\r\n   194\t\t\tfor _, v := range values[1:] {\r\n   195\t\t\t\tif v < result {\r\n   196\t\t\t\t\tresult = v\r\n   197\t\t\t\t}\r\n   198\t\t\t}\r\n   199\t\tcase \"max\":\r\n   200\t\t\tresult = values[0]\r\n   201\t\t\tfor _, v := range values[1:] {\r\n   202\t\t\t\tif v > result {\r\n"]
[5635.246966, "o", "   203\t\t\t\t\tresult = v\r\n   204\t\t\t\t}\r\n   205\t\t\t}\r\n   206\t\tcase \"range\":\r\n   207\t\t\tif len(values) < 2 {\r\n   208\t\t\t\tresult = 0.0\r\n   209\t\t\t} else {\r\n   210\t\t\t\tminVal := values[0]\r\n   211\t\t\t\tmaxVal := values[0]\r\n   212\t\t\t\tfor _, v := range values[1:] {\r\n   213\t\t\t\t\tif v < minVal {\r\n   214\t\t\t\t"]
[5635.247036, "o", "\t\tminVal = v\r\n   215\t\t\t\t\t}\r\n   216\t\t\t\t\tif v > maxVal {\r\n   217\t\t\t\t\t\tmaxVal = v\r\n   218\t\t\t\t\t}\r\n   219\t\t\t\t}\r\n   220\t\t\t\tresult = maxVal - minVal\r\n   221\t\t\t}\r\n   222\t\tdefault:\r\n   223\t\t\treturn nil, fmt.Errorf(\"aggregate: unknown operation %q\", operation)\r\n"]
[5635.247108, "o", "   224\t\t}\r\n   225\t\r\n   226\t\treturn map[string]interface{}{\r\n   227\t\t\t\"result\": result,\r\n   228\t\t\t\"count\":  float64(len(values)),\r\n   229\t\t\t\"data\":   data,\r\n   230\t\t}, nil\r\n"]
