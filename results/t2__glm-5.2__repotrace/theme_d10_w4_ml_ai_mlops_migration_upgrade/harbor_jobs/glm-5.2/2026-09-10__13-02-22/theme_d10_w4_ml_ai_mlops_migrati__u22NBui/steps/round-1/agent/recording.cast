[1016.841517, "o", "   120\t\t\t}\r\n   121\t\t}\r\n   122\t\r\n   123\t\tversion := &Version{\r\n   124\t\t\tNumber:      nextNum,\r\n"]
[1016.841605, "o", "   125\t\t\tStage:       StageDevelopment,\r\n   126\t\t\tMetrics:     metrics,\r\n   127\t\t\tTags:        tags,\r\n   128\t\t\tModelConfig: modelConfig,\r\n   129\t\t\tCreatedAt:   time.Now(),\r\n   130\t\t}\r\n   131\t\tmodel.Versions = append(model.Versions, version)\r\n   132\t\tmodel.UpdatedAt = time.Now()\r\n   133\t\r\n   134\t\tif err := r.saveModel(model); err != nil {\r\n   135\t\t\t"]
[1016.841675, "o", "model.Versions = model.Versions[:len(model.Versions)-1]\r\n   136\t\t\treturn nil, err\r\n   137\t\t}\r\n   138\t\treturn version, nil\r\n   139\t}\r\n   140\t\r\n   141\t// PromoteVersion transitions a model version to the specified stage.\r\n   142\tfunc (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {\r\n   143\t\tr.mu.Lock()\r\n   144\t\tdefer r.mu.Unlock()\r\n"]
[1016.841735, "o", "   145\t\r\n   146\t\tmodel, exists := r.models[modelName]\r\n   147\t\tif !exists {\r\n   148\t\t\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n   149\t\t}\r\n   150\t\r\n   151\t\tvar version *Version\r\n   152\t\tfor _, v := range model.Versions {\r\n   153\t\t\tif v.Number == versionNum {\r\n   154\t\t\t\tversion = v\r\n"]
[1016.841796, "o", "   155\t\t\t\tbreak\r\n   156\t\t\t}\r\n   157\t\t}\r\n   158\t\tif version == nil {\r\n   159\t\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n   160\t\t}\r\n   161\t\r\n   162\t\t// Validate stage transition\r\n   163\t\tallowed := validTransitions[version.Stage]\r\n"]
[1016.841879, "o", "   164\t\tvalid := false\r\n   165\t\tfor _, s := range allowed {\r\n   166\t\t\tif s == targetStage {\r\n   167\t\t\t\tvalid = true\r\n   168\t\t\t\tbreak\r\n   169\t\t\t}\r\n   170\t\t}\r\n   171\t\tif !valid {\r\n   172\t\t\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n   173\t\t}\r\n"]
[1016.841938, "o", "   174\t\r\n   175\t\t// If promoting to production, demote current production version\r\n   176\t\tif targetStage == StageProduction {\r\n   177\t\t\tfor _, v := range model.Versions {\r\n   178\t\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n   179\t\t\t\t\tv.Stage = StageArchived\r\n   180\t\t\t\t}\r\n   181\t\t\t}\r\n   182\t\t}\r\n   183\t\r\n   184\t\tversion.Stage = targetStage\r\n   185\t\tmodel.UpdatedAt = time.Now()\r\n"]
[1016.841965, "o", "   186\t\r\n   187\t\treturn r.saveModel(model)\r\n   188\t}\r\n   189\t\r\n   190\t// GetModel returns a model with its versions sorted by version number descending.\r\n"]
[1016.842047, "o", "   191\tfunc (r *Registry) GetModel(name string) (*Model, error) {\r\n   192\t\tr.mu.RLock()\r\n   193\t\tdefer r.mu.RUnlock()\r\n   194\t\r\n   195\t\tmodel, exists := r.models[name]\r\n   196\t\tif !exists {\r\n   197\t\t\treturn nil, fmt.Errorf(\"model %q not found\", name)\r\n   198\t\t}\r\n   199\t\r\n   200\t\t// Return a copy with versions sorted\r\n   201\t\tresult := *model\r\n   202\t\tresult.Versions = make([]*Version, len(model.Versions))\r\n   203\t\tcopy(result.Versions, model.Versions)\r\n"]
[1016.842106, "o", "   204\t\tsort.Slice(result.Versions, func(i, j int) bool {\r\n   205\t\t\treturn result.Versions[i].Number > result.Versions[j].Number\r\n   206\t\t})\r\n   207\t\treturn &result, nil\r\n   208\t}\r\n   209\t\r\n   210\t// ListModels returns all models matching the optional filter.\r\n   211\tfunc (r *Registry) ListModels(filter *ModelFilter) ([]*Model, error) {\r\n   212\t\tr.mu.RLock()\r\n   213\t\tdefer r.mu.RUnlock()\r\n   214\t\r\n"]
[1016.842169, "o", "   215\t\tvar result []*Model\r\n   216\t\tfor _, model := range r.models {\r\n   217\t\t\tif filter != nil {\r\n   218\t\t\t\tif filter.Framework != \"\" && model.Framework != filter.Framework {\r\n   219\t\t\t\t\tcontinue\r\n   220\t\t\t\t}\r\n   221\t\t\t\tif filter.Tag != \"\" {\r\n   222\t\t\t\t\thasTag := false\r\n   223\t\t\t\t\tfor _, t := range model.Tags {\r\n   224\t\t\t\t\t\tif t == filter.Tag {\r\n"]
[1016.842225, "o", "   225\t\t\t\t\t\t\thasTag = true\r\n   226\t\t\t\t\t\t\tbreak\r\n   227\t\t\t\t\t\t}\r\n   228\t\t\t\t\t}\r\n   229\t\t\t\t\tif !hasTag {\r\n   230\t\t\t\t\t\tcontinue\r\n   231\t\t\t\t\t}\r\n"]
[1016.842281, "o", "   232\t\t\t\t}\r\n   233\t\t\t}\r\n   234\t\t\tresult = append(result, model)\r\n   235\t\t}\r\n   236\t\tsort.Slice(result, func(i, j int) bool {\r\n   237\t\t\treturn result[i].Name < result[j].Name\r\n   238\t\t})\r\n   239\t\treturn result, nil\r\n"]
[1016.842336, "o", "   240\t}\r\n   241\t\r\n   242\t// DeleteModel removes a model from the registry.\r\n   243\tfunc (r *Registry) DeleteModel(name string) error {\r\n   244\t\tr.mu.Lock()\r\n   245\t\tdefer r.mu.Unlock()\r\n   246\t\r\n   247\t\tif _, exists := r.models[name]; !exists {\r\n   248\t\t\treturn fmt.Errorf(\"model %q not found\", name)\r\n   249\t\t}\r\n"]
[1016.842406, "o", "   250\t\r\n   251\t\tdelete(r.models, name)\r\n   252\t\tfilename := filepath.Join(r.dataDir, name+\".json\")\r\n   253\t\tos.Remove(filename)\r\n   254\t\treturn nil\r\n   255\t}\r\n   256\t\r\n   257\t// GetVersion returns a specific version of a model.\r\n   258\tfunc (r *Registry) GetVersion(modelName string, versionNum int) (*Version, error) {\r\n   259\t\tr.mu.RLock()\r\n"]
[1016.842463, "o", "   260\t\tdefer r.mu.RUnlock()\r\n   261\t\r\n   262\t\tmodel, exists := r.models[modelName]\r\n   263\t\tif !exists {\r\n   264\t\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n   265\t\t}\r\n   266\t\r\n   267\t\tfor _, v := range model.Versions {\r\n   268\t\t\tif v.Number == versionNum {\r\n   269\t\t\t\treturn v, nil\r\n"]
[1016.84252, "o", "   270\t\t\t}\r\n   271\t\t}\r\n   272\t\treturn nil, fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n   273\t}\r\n   274\t\r\n   275\t// GetVersionByStage returns the version of a model currently in the specified stage.\r\n   276\tfunc (r *Registry) GetVersionByStage(modelName string, stage Stage) (*Version, error) {\r\n   277\t\tr.mu.RLock()\r\n   278\t\tdefer r.mu.RUnlock()\r\n"]
[1016.842577, "o", "   279\t\r\n   280\t\tmodel, exists := r.models[modelName]\r\n   281\t\tif !exists {\r\n   282\t\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n   283\t\t}\r\n   284\t\r\n   285\t\tfor _, v := range model.Versions {\r\n   286\t\t\tif v.Stage == stage {\r\n   287\t\t\t\treturn v, nil\r\n   288\t\t\t}\r\n"]
[1016.842634, "o", "   289\t\t}\r\n   290\t\treturn nil, fmt.Errorf(\"no version in stage %s for model %q\", stage, modelName)\r\n   291\t}\r\n   292\t\r\n   293\t// loadAll reads all model files from the data directory.\r\n   294\tfunc (r *Registry) loadAll() error {\r\n   295\t\tentries, err := os.ReadDir(r.dataDir)\r\n   296\t\tif err != nil {\r\n   297\t\t\tif os.IsNotExist(err) {\r\n   298\t\t\t\treturn nil\r\n"]
[1016.84269, "o", "   299\t\t\t}\r\n   300\t\t\treturn err\r\n   301\t\t}\r\n   302\t\tfor _, entry := range entries {\r\n   303\t\t\tif !entry.IsDir() && filepath.Ext(entry.Name()) == \".json\" {\r\n   304\t\t\t\tdata, err := os.ReadFile(filepath.Join(r.dataDir, entry.Name()))\r\n   305\t\t\t\tif err != nil {\r\n   306\t\t\t\t\treturn err\r\n   307\t\t\t\t}\r\n"]
[1016.842746, "o", "   308\t\t\t\tvar model Model\r\n   309\t\t\t\tif err := json.Unmarshal(data, &model); err != nil {\r\n   310\t\t\t\t\treturn err\r\n   311\t\t\t\t}\r\n   312\t\t\t\tr.models[model.Name] = &model\r\n   313\t\t\t}\r\n   314\t\t}\r\n   315\t\treturn nil\r\n   316\t}\r\n   317\t\r\n"]
[1016.842807, "o", "   318\t// saveModel writes a model's data to its JSON file.\r\n   319\tfunc (r *Registry) saveModel(model *Model) error {\r\n   320\t\tdata, err := json.MarshalIndent(model, \"\", \"  \")\r\n   321\t\tif err != nil {\r\n   322\t\t\treturn err\r\n   323\t\t}\r\n   324\t\tfilename := filepath.Join(r.dataDir, model.Name+\".json\")\r\n   325\t\treturn os.WriteFile(filename, data, 0644)\r\n"]
[1016.842893, "o", "   326\t}\r\n"]
