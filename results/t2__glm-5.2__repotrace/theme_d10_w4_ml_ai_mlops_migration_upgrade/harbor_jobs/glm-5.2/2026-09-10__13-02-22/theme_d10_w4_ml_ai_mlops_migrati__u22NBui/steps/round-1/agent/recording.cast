[290.265125, "o", "    56\tfunc (h *Handlers) DeleteModel(w http.ResponseWriter, r *http.Request) {\r\n    57\t\tname := r.PathValue(\"name\")\r\n    58\t\tif err := h.Registry.DeleteModel(name); err != nil {\r\n    59\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n    60\t\t\treturn\r\n    61\t\t}\r\n    62\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n    63\t}\r\n"]
[290.265276, "o", "    64\t\r\n    65\tfunc (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {\r\n    66\t\tname := r.PathValue(\"name\")\r\n    67\t\tmodel, err := h.Registry.GetModel(name)\r\n    68\t\tif err != nil {\r\n    69\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n    70\t\t\treturn\r\n    71\t\t}\r\n    72\t\twriteJSON(w, http.StatusOK, model)\r\n    73\t}\r\n    74\t\r\n    75\tfunc (h *Handlers) CreateVersion(w http.ResponseWriter, r *http.Request) {\r\n"]
