[6656.872721, "o", "   486\tfunc topologicalSort(steps []*Step) ([]*Step, error) {\r\n   487\t\tstepMap := make(map[string]*Step)\r\n   488\t\tinDegree := make(map[string]int)\r\n   489\t\r\n   490\t\tfor _, s := range steps {\r\n   491\t"]
[6656.87281, "o", "\t\tstepMap[s.Name] = s\r\n   492\t\t\tinDegree[s.Name] = 0\r\n   493\t\t}\r\n   494\t\r\n   495\t\t// Build in-degree counts\r\n   496\t\tfor _, s := range steps {\r\n   497\t\t\tfor _, dep := range s.Dependencies {\r\n   498\t\t\t\tif _, ok := stepMap[dep]; !ok {\r\n   499\t\t\t\t\treturn nil, fmt.Errorf(\"step %q depends on unknown step %q\", s.Name, dep)\r\n   500\t\t\t\t}\r\n   501\t\t\t\tinDegree[s.Name]++\r\n   502\t\t\t}\r\n   503\t\t}\r\n"]
[6656.872939, "o", "   504\t\r\n   505\t\t// Initialize queue with steps that have no dependencies\r\n   506\t\tqueue := make([]*Step, 0)\r\n   507\t\tfor _, s := range steps {\r\n   508\t\t\tif inDegree[s.Name] == 0 {\r\n   509\t\t\t\tqueue = append(queue, s)\r\n   510\t\t\t}\r\n   511\t\t}\r\n   512\t\r\n   513\t\t// Process steps in topological order\r\n   514\t\tordered := make([]*Step, 0, len(steps))\r\n   515\t\tfor len(queue) > 0 {\r\n   516\t\t\tcurrent := queue[0]\r\n   517\t\t\tqueue = queue[1:]\r\n   518\t\t\tordered = append(ordered, current)\r\n"]
[6656.873029, "o", "   519\t\r\n   520\t\t\t// Find steps that depend on current\r\n   521\t\t\tfor _, s := range steps {\r\n   522\t\t\t\tfor _, dep := range s.Dependencies {\r\n   523\t\t\t\t\tif dep == current.Name {\r\n   524\t\t\t\t\t\tinDegree[s.Name]--\r\n   525\t\t\t\t\t\tif inDegree[s.Name] == 0 {\r\n   526\t\t\t\t\t\t\tqueue = append(queue, s)\r\n   527\t\t\t\t\t\t}\r\n   528\t\t\t\t\t}\r\n   529\t\t\t\t}\r\n   530\t\t\t}\r\n"]
