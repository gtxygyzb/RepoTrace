[6956.142637, "i", "python3 - <<'PY'\nimport re\nfrom pathlib import Path\n\ndef must_replace(path, old, new):\n    text = Path(path).read_text()\n    if old not in text:\n        raise SystemExit(f\"pattern not found in {path}:\\n{old}\")\n    Path(path).write_text(text.replace(old, new, 1))\n\n# --- pipeline validation ---\np = Path(\"internal/pipeline/engine.go\")\ntext = p.read_text()\ntext = text.replace('fmt.Sprintf(\"duplicate step name: %s\", name)', 'fmt.Sprintf(\"duplicate step name: %q\", name)', 1)\n\ndep_pattern = r'''for _, step := range p\\.Steps \\{\n\\t\\t\\tif step == nil \\{\n\\t\\t\\t\\tcontinue\n\\t\\t\\t\\}\n\\t\\t\\tif _, exists := e\\.stepExecutors\\[step\\.Type\\]; !exists \\{\n\\t\\t\\t\\tresult\\.Valid = false\n\\t\\t\\t\\tresult\\.Errors = append\\(result\\.Errors, fmt\\.Sprintf\\(\"unknown step type: %s\", step\\.Type\\)\\)\n\\t\\t\\t\\}\n\\t\\t\\tfor _, dep := range step\\.Dependencies \\{\n\\t\\t\\t\\tif !seen\\[dep\\] \\{\n\\t\\t\\t\\t\\tresult\\.Valid = false\n\\t\\t\\t\\t\\tresult\\.Errors = append\\(result\\.Errors, fmt\\.Sprintf\\(\"step %s depends on unknown step: %s\", step\\.Name, dep\\)\\)\n\\t\\t\\t\\t\\}"]
