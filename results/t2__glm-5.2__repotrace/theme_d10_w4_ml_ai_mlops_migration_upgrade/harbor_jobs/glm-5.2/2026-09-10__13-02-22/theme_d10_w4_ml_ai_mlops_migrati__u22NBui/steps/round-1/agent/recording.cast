[2035.276435, "o", "    54\t\t\t\t}\r\n    55\t\t\t\tif maxVal == minVal {\r\n    56\t\t\t\t\tresult[i] = 0.5\r\n    57\t\t\t\t} else {\r\n    58\t\t\t\t\tresult[i] = (val - minVal) / (maxVal - minVal)\r\n    59\t\t\t\t}\r\n    60\t\t\t}\r\n    61\t\r\n    62\t"]
