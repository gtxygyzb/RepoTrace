[1442.622926, "o", "\u0007"]
[1442.623278, "o", "Name            string                 `json:\"name\"`\r\n\u001b[?2004l\r"]
[1442.623325, "o", "\u001b[?2004h"]
[1442.623372, "o", "> "]
[1442.623418, "o", "\u0007"]
[1442.623766, "o", "Type            StepType               `json:\"type\"`\r\n\u001b[?2004l\r"]
[1442.623814, "o", "\u001b[?2004h> "]
[1442.623898, "o", "\u0007"]
[1442.624264, "o", "Config          map[string]interface{} `json:\"config\"`\r\n\u001b[?2004l\r"]
[1442.624311, "o", "\u001b[?2004h> "]
[1442.624392, "o", "\u0007"]
[1442.624799, "o", "Dependencies    []string               `json:\"dependencies\"`\r\n\u001b[?2004l\r"]
