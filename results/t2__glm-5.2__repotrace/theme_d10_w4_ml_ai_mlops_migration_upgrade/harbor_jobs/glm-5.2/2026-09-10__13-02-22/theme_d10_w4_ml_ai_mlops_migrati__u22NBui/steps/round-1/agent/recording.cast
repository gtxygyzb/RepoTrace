[2520.505595, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/api/handlers.go')\ns = p.read_text()\nold_getmodel = '''func (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {\n\\tname := r.PathValue(\"name\")\n\\tmodel, err := h.Registry.GetModel(name)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\n\\t\\treturn\n\\t}\n\\twriteJSON(w, http.StatusOK, model)\n}'''\nnew_getmodel = '''func (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {\n\\tname := r.PathValue(\"name\")\n\\tmodel, err := h.Registry.GetModel(name)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\n\\t\\treturn\n\\t}\n\\tstageSummary := map[string]int{\n\\t\\t\"development\": 0,\n\\t\\t\"staging\":     0,\n\\t\\t\"production\":  0,\n\\t\\t\"archived\":    0,\n\\t}\n\\tfor _, v := range model.Versions {\n\\t\\tstageSummary[string(v.Stage)]++\n\\t}\n\\twriteJSON(w, http.StatusOK, map[string]interface{}{\n\\t\\t\"name\":          model.Name,\n\\t\\t\"framework\":     model.Framework,\n\\t\\t\"description\":   model.Description,\n\\t\\t\"tags\":          model.Tags"]
[2520.505752, "i", ",\n\\t\\t\"versions\":      model.Versions,\n\\t\\t\"created_at\":    model.CreatedAt,\n\\t\\t\"updated_at\":    model.UpdatedAt,\n\\t\\t\"stage_summary\": stageSummary,\n\\t})\n}'''\nif old_getmodel not in s:\n    raise SystemExit('GetModel block not found')\ns = s.replace(old_getmodel, new_getmodel)\nmarker = '// --- Model Version Comparison Handler ---'\nif marker not in s:\n    raise SystemExit('comparison marker not found')\nnew_handlers = '''func (h *Handlers) GetMetricHistory(w http.ResponseWriter, r *http.Request) {\n\\texpName := r.PathValue(\"name\")\n\\tmetricName := r.PathValue(\"metric\")\n\\thistory, err := h.Experiment.MetricHistory(expName, metricName)\n\\tif err != nil {\n\\t\\tif strings.Contains(err.Error(), \"not found\") {\n\\t\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\n\\t\\t} else {\n\\t\\t\\twriteError(w, http.StatusBadRequest, \"%v\", err)\n\\t\\t}\n\\t\\treturn\n\\t}\n\\twriteJSON(w, http.StatusOK, map[string]interface{}{\n\\t\\t\"experiment\": expName,\n\\t\\t\"metric\":     metricName,\n\\t\\t\"history\":    history,\n\\t\\t\"count\":      len(history),\n\\t})\n}\n"]
[2520.505831, "i", "\nfunc (h *Handlers) UpdateRun(w http.ResponseWriter, r *http.Request) {\n\\texpName := r.PathValue(\"name\")\n\\trunID := r.PathValue(\"id\")\n\\tvar req struct {\n\\t\\tMetrics map[string]float64 `json:\"metrics\"`\n\\t}\n\\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n\\t\\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\n\\t\\treturn\n\\t}\n\\trun, err := h.Experiment.UpdateRunMetrics(expName, runID, req.Metrics)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\n\\t\\treturn\n\\t}\n\\twriteJSON(w, http.StatusOK, run)\n}\n\nfunc (h *Handlers) SearchRuns(w http.ResponseWriter, r *http.Request) {\n\\texpName := r.PathValue(\"name\")\n\\tvar req struct {\n\\t\\tFilters []experiment.MetricFilter `json:\"filters\"`\n\\t}\n\\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n\\t\\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\n\\t\\treturn\n\\t}\n\\truns, err := h.Experiment.SearchRuns(expName, req.Filters)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\n\\t\\tretur"]
