[1999.494296, "o", "package api\r\n\r\nimport (\r\n\t\"net/http\"\r\n\r\n\t\"gomlops/internal/experiment\"\r\n\t\"gomlops/internal/pipeline\"\r\n"]
[1999.494404, "o", "\t\"gomlops/internal/registry\"\r\n\t\"gomlops/internal/serving\"\r\n)\r\n\r\n// Handlers holds references to all service components.\r\ntype Handlers struct {\r\n\tRegistry   *registry.Registry\r\n\tPipeline   *pipeline.Engine\r\n\tExperiment *experiment.Tracker\r\n\tServing    *serving.Server\r\n\tTemplates  *TemplateStore\r\n}\r\n\r\n// NewRouter builds the HTTP route table and returns a handler.\r\nfunc NewRouter(reg *registry.Registry, eng *pipeline.Engine, tracker *experiment.Tracker, srv *serving.Server) http.Handler {\r\n\th := &Handlers{\r\n\t\tRegistry:   reg,\r\n\t\tPipeline:   eng,\r\n\t\tExperiment: tracker,\r\n"]
[1999.494494, "o", "\t\tServing:    srv,\r\n\t\tTemplates:  NewTemplateStore(),\r\n\t}\r\n\r\n\tmux := http.NewServeMux()\r\n\r\n\t// Model registry endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/models\", h.RegisterModel)\r\n\tmux.HandleFunc(\"GET /api/v1/models\", h.ListModels)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}\", h.GetModel)\r\n\tmux.HandleFunc(\"POST /api/v1/models/{name}/versions\", h.CreateVersion)\r\n"]
[1999.49461, "o", "\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/compare\", h.CompareVersionMetrics)\r\n\tmux.HandleFunc(\"GET /api/v1/models/{name}/versions/{num}\", h.GetVersion)\r\n\tmux.HandleFunc(\"PUT /api/v1/models/{name}/versions/{num}/promote\", h.PromoteVersion)\r\n\tmux.HandleFunc(\"DELETE /api/v1/models/{name}\", h.DeleteModel)\r\n\r\n\t// Pipeline endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/execute\", h.ExecutePipeline)\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/templates\", h.CreateTemplate)\r\n\tmux.HandleFunc(\"GET /api/v1/pipelines/templates\", h.ListTemplates)\r\n\tmux.HandleFunc(\"GET /api/v1/pipelines/templates/{name}\", h.GetTemplate)\r\n\tmux.HandleFunc(\"PUT /api/v1/pipelines/templates/{name}\", h.UpdateTemplate)\r\n\tmux.HandleFunc(\"DELETE /api/v1/pipelines/templates/{name}\", h.DeleteTemplate)\r\n\tmux.HandleFunc(\"POST /api/v1/pipelines/templates/{name}/execute\", h.ExecuteTemplate)\r\n\r\n\t// Experiment endpoints\r\n\tmux.HandleFunc(\"POST /api/v1/experiments\", h.CreateExperiment)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments\", h.ListExperiments)\r\n"]
[1999.494679, "o", "\tmux.HandleFunc(\"GET /api/v1/experiments/{name}\", h.GetExperiment)\r\n\tmux.HandleFunc(\"POST /api/v1/experiments/{name}/runs\", h.LogRun)\r\n\tmux.HandleFunc(\"DELETE /api/v1/experiments/{name}/runs/{id}\", h.DeleteRun)\r\n\tmux.HandleFunc(\"GET /api/v1/experiments/{name}/metrics/{metric}/aggregate\", h.AggregateMetric)\r\n\r\n\t// Serving endpoints\r\n"]
[1999.494744, "o", "\tmux.HandleFunc(\"POST /api/v1/serving/load\", h.LoadModel)\r\n\tmux.HandleFunc(\"DELETE /api/v1/serving/models/{name}\", h.UnloadModel)\r\n\tmux.HandleFunc(\"GET /api/v1/serving/models\", h.ListLoadedModels)\r\n\tmux.HandleFunc(\"POST /api/v1/serving/infer\", h.Infer)\r\n\tmux.HandleFunc(\"POST /api/v1/serving/batch\", h.BatchInfer)\r\n\r\n\t// Health check\r\n\tmux.HandleFunc(\"GET /health\", func(w http.ResponseWriter, r *http.Request) {\r\n\t\tw.WriteHeader(http.StatusOK)\r\n\t\tw.Write([]byte(`{\"status\":\"ok\"}`))\r\n\t})\r\n\r\n\treturn mux\r\n}\r\n"]
