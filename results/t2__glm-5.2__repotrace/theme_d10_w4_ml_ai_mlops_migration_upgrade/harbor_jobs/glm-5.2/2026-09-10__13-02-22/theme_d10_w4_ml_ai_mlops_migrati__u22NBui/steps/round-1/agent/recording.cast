[970.169744, "o", "     1\tpackage pipeline\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"math\"\r\n     6\t"]
[970.169986, "o", "\t\"sort\"\r\n     7\t)\r\n     8\t\r\n     9\t// ExecuteTransform applies a data transformation.\r\n    10\t// Supported modes: scale, offset, normalize, identity, clip, log.\r\n    11\tfunc ExecuteTransform(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n    12\t"]
[970.170088, "o", "\tdata, ok := input[\"data\"].([]interface{})\r\n    13\t\tif !ok {\r\n    14\t\t\treturn nil, fmt.Errorf(\"transform: missing or invalid 'data' field in input\")\r\n    15\t\t}\r\n    16\t\r\n    17\t\tmode, _ := config[\"mode\"].(string)\r\n    18\t\tif mode == \"\" {\r\n    19\t\t\treturn nil, fmt.Errorf(\"transform: missing 'mode' in config\")\r\n    20\t\t}\r\n    21\t\r\n    22\t\tresult := make([]interface{}, len(data))\r\n    23\t\r\n    24\t\tswitch mode {\r\n    25\t\tcase \"scale\":\r\n    26\t\t\tfactor, _ := config[\"factor\"].(float64)\r\n    27\t\t\tfor i, v := range data {\r\n    28\t\t\t\tval, err := toFloat(v)\r\n    29\t\t\t\tif err != nil {\r\n    30\t\t\t\t\treturn nil, fmt.Errorf(\"transform scale: element %d: %w\", i, err)\r\n    31\t\t\t\t}\r\n    32\t\t\t\tresult[i] = val * factor\r\n    33\t\t\t}\r\n    34\t\r\n    35\t\tcase \"offset\":\r\n    36\t\t\toffset, _ := config[\"offset\"].(float64)\r\n    37\t\t\tfor i, v := range data {\r\n    38\t\t\t\tval, err := toFloat(v)\r\n    39\t\t\t\tif err != nil {\r\n    40\t\t\t\t\treturn nil, fmt.Errorf(\"transform offset: element %d: %w\", i, err)\r\n    41\t\t\t\t}\r\n    42\t\t\t\tresult[i] = val + offs"]
[970.170174, "o", "et\r\n    43\t\t\t}\r\n    44\t\r\n    45\t\tcase \"normalize\":\r\n    46\t\t\tif len(data) == 0 {\r\n    47\t\t\t\treturn map[string]interface{}{\"data\": result}, nil\r\n    48\t\t\t}\r\n    49\t\t\tminVal, maxVal := findMinMax(data)\r\n    50\t\t\tfor i, v := range data {\r\n    51\t\t\t\tval, err := toFloat(v)\r\n    52\t\t\t\tif err != nil {\r\n    53\t\t\t\t\treturn nil, fmt.Errorf(\"transform normalize: element %d: %w\", i, err)\r\n    54\t\t\t\t}\r\n    55\t\t\t\tif maxVal == minVal {\r\n    56\t\t\t\t\tresult[i] = 0.0\r\n    57\t\t\t\t} else {\r\n    58\t\t\t\t\tresult[i] = (val - minVal) / (maxVal - minVal)\r\n    59\t\t\t\t}\r\n    60\t\t\t}\r\n    61\t\r\n    62\t\tcase \"identity\":\r\n    63\t"]
[970.17024, "o", "\t\tcopy(result, data)\r\n    64\t\r\n    65\t\tcase \"clip\":\r\n    66\t\t\tlow, _ := config[\"low\"].(float64)\r\n    67\t\t\thigh, _ := config[\"high\"].(float64)\r\n    68\t\t\tfor i, v := range data {\r\n    69\t\t\t\tval, err := toFloat(v)\r\n    70\t\t\t\tif err != nil {\r\n"]
[970.170302, "o", "    71\t\t\t\t\treturn nil, fmt.Errorf(\"transform clip: element %d: %w\", i, err)\r\n    72\t\t\t\t}\r\n    73\t\t\t\tif val < low {\r\n    74\t\t\t\t\tval = low\r\n    75\t\t\t\t}\r\n    76\t\t\t\tif val > high {\r\n    77\t\t\t\t\tval = high\r\n    78\t\t\t\t}\r\n    79"]
[970.170363, "o", "\t\t\t\tresult[i] = val\r\n    80\t\t\t}\r\n    81\t\r\n    82\t\tcase \"log\":\r\n    83\t\t\tfor i, v := range data {\r\n    84\t\t\t\tval, err := toFloat(v)\r\n    85\t\t\t\tif err != nil {\r\n    86\t\t\t\t\treturn nil, fmt.Errorf(\"transform log: element %d: %w\", i, err)\r\n"]
[970.170421, "o", "    87\t\t\t\t}\r\n    88\t\t\t\tif val <= 0 {\r\n    89\t\t\t\t\treturn nil, fmt.Errorf(\"transform log: element %d is non-positive (%f)\", i, val)\r\n    90\t\t\t\t}\r\n    91\t\t\t\tresult[i] = math.Log(val)\r\n    92\t\t\t}\r\n    93\t\r\n"]
[970.17048, "o", "    94\t\tdefault:\r\n    95\t\t\treturn nil, fmt.Errorf(\"transform: unknown mode %q\", mode)\r\n    96\t\t}\r\n    97\t\r\n    98\t\treturn map[string]interface{}{\"data\": result}, nil\r\n    99\t}\r\n   100"]
[970.170536, "o", "\t\r\n   101\t// ExecuteValidate checks data against schema constraints.\r\n   102\tfunc ExecuteValidate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   103\t\tdata, ok := input[\"data\"].([]interface{})\r\n   104\t\tif !ok {\r\n   105\t\t\treturn nil, fmt.Errorf(\"validate: missing or invalid 'data' field\")\r\n   106\t\t}\r\n   107\t\r\n   108\t"]
[970.170606, "o", "\tvar errors []interface{}\r\n   109\t\r\n   110\t\t// Check min_value constraint\r\n   111\t\tif minVal, ok := config[\"min_value\"].(float64); ok {\r\n   112\t\t\tfor i, v := range data {\r\n   113\t\t"]
[970.170673, "o", "\t\tval, err := toFloat(v)\r\n   114\t\t\t\tif err != nil {\r\n   115\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: not a number\", i))\r\n   116\t\t\t\t\tcontinue\r\n   117\t\t\t\t}\r\n   118\t\t\t\tif val < minVal {\r\n   119\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f below minimum %f\", i, val, minVal))\r\n   120\t\t\t\t}\r\n   121\t\t\t}\r\n   122"]
[970.170732, "o", "\t\t}\r\n   123\t\r\n   124\t\t// Check max_value constraint\r\n   125\t\tif maxVal, ok := config[\"max_value\"].(float64); ok {\r\n   126\t\t\tfor i, v := range data {\r\n   127\t\t\t\tval, err := toFloat(v)\r\n   128\t\t\t\tif err != nil {\r\n   129\t\t\t\t\tcontinue\r\n   130\t\t\t\t}\r\n   131\t\t\t\tif val > maxVal {\r\n"]
[970.170794, "o", "   132\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f above maximum %f\", i, val, maxVal))\r\n   133\t\t\t\t}\r\n   134\t\t\t}\r\n   135\t\t}\r\n"]
[970.170875, "o", "   136\t\r\n   137\t\t// Check min_count constraint\r\n   138\t\tif minCount, ok := config[\"min_count\"].(float64); ok {\r\n   139\t\t\tif float64(len(data)) < minCount {\r\n   140\t\t\t\terrors = append(errors, fmt.Sprintf(\"data has %d elements, minimum required is %d\", len(data), int(minCount)))\r\n   141\t\t\t}\r\n   142\t\t}\r\n   143\t\r\n   144\t\tvalid := len(errors) == 0\r\n   145\t\treturn map[string]interface{}{\r\n   146\t\t\t\"valid\":  valid,\r\n   147\t\t\t\"errors\": errors,\r\n   148\t\t\t\"data\":   data,\r\n   149\t\t}, nil\r\n"]
[970.170955, "o", "   150\t}\r\n   151\t\r\n   152\t// ExecuteAggregate computes aggregations over input data.\r\n   153\t// Supported operations: sum, mean, count, min, max.\r\n   154\tfunc ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   155\t\tdata, ok := input[\"data\"].([]interface{})\r\n   156\t\tif !ok {\r\n   157\t\t\treturn nil, fmt.Errorf(\"aggregate: missing or invalid 'data' field\")\r\n   158\t\t}\r\n   159\t\r\n   160\t\toperation, _ := config[\"operation\"].(string)\r\n"]
[970.171072, "o", "   161\t\tif operation == \"\" {\r\n   162\t\t\treturn nil, fmt.Errorf(\"aggregate: missing 'operation' in config\")\r\n   163\t\t}\r\n   164\t\r\n   165\t\tvalues := make([]float64, 0, len(data))\r\n   166\t\tfor _, v := range data {\r\n   167\t\t\tval, err := toFloat(v)\r\n   168\t\t\tif err != nil {\r\n   169\t\t\t\tcontinue\r\n   170\t\t\t}\r\n   171\t\t\tvalues = append(values, val)\r\n   172\t\t}\r\n   173\t\r\n   174\t\tif len(values) == 0 {\r\n   175\t\t\treturn map[string]interface{}{\"result\": 0.0, \"count\": 0.0}, nil\r\n   176\t\t}\r\n   177\t\r\n   178\t\tvar result float64\r\n"]
[970.171136, "o", "   179\t\tswitch operation {\r\n   180\t\tcase \"sum\":\r\n   181\t\t\tfor _, v := range values {\r\n   182\t\t\t\tresult += v\r\n   183\t\t\t}\r\n   184\t\tcase \"mean\":\r\n   185\t\t\tfor _, v := range values {\r\n   186\t\t\t\tresult += v\r\n"]
[970.171199, "o", "   187\t\t\t}\r\n   188\t\t\tresult /= float64(len(values))\r\n   189\t\tcase \"count\":\r\n   190\t\t\tresult = float64(len(values))\r\n   191\t\tcase \"min\":\r\n   192\t\t\tresult = values[0]\r\n   193\t\t\tfor _, v := range values[1:] {\r\n   194\t\t\t\tif v < result {\r\n"]
[970.171259, "o", "   195\t\t\t\t\tresult = v\r\n   196\t\t\t\t}\r\n   197\t\t\t}\r\n   198\t\tcase \"max\":\r\n   199\t\t\tresult = values[0]\r\n   200\t\t\tfor _, v := range values[1:] {\r\n   201\t\t\t\tif v > result {\r\n   202\t\t\t\t\tresult = v\r\n   203\t\t\t\t}\r\n"]
[970.17132, "o", "   204\t\t\t}\r\n   205\t\tdefault:\r\n   206\t\t\treturn nil, fmt.Errorf(\"aggregate: unknown operation %q\", operation)\r\n   207\t\t}\r\n   208\t\r\n   209\t\treturn map[string]interface{}{\r\n   210\t\t\t\"result\": result,\r\n   211\t\t\t\"count\":  float64(len(values)),\r\n   212\t"]
[970.17138, "o", "\t\t\"data\":   data,\r\n   213\t\t}, nil\r\n   214\t}\r\n   215\t\r\n   216\t// ExecuteExport formats data for output.\r\n   217\t// Supported formats: json, csv, summary.\r\n   218\tfunc ExecuteExport(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   219\t\tformat, _ := config[\"format\"].(string)\r\n   220\t\tif format == \"\" {\r\n"]
[970.171446, "o", "   221\t\t\tformat = \"json\"\r\n   222\t\t}\r\n   223\t\r\n   224\t\tswitch format {\r\n   225\t\tcase \"json\":\r\n   226\t\t"]
[970.171514, "o", "\treturn map[string]interface{}{\r\n   227\t\t\t\t\"format\": \"json\",\r\n   228\t\t\t\t\"data\":   input,\r\n   229\t\t\t}, nil\r\n   230\t\r\n   231\t\tcase \"summary\":\r\n   232\t\t\tdata, ok := input[\"data\"].([]interface{})\r\n   233\t\t\tcount := 0\r\n   234\t\t\tif ok {\r\n   235\t\t\t\tcount = len(data)\r\n   236\t\t\t}\r\n   237\t\t\treturn map[string]interface{}{\r\n   238\t\t\t\t\"format\": \"summary\",\r\n"]
