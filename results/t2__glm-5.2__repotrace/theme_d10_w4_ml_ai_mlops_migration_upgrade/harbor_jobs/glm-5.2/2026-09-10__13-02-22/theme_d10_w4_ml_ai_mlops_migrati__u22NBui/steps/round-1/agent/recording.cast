[6424.370967, "o", "\u001b[35m\u001b[K./internal/api/router.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"DELETE /api/v1/models/{name}/\u001b[01;31m\u001b[Kdependencies\u001b[m\u001b[K/{dep}\", h.RemoveDependency)\r\n\u001b[35m\u001b[K./internal/api/router.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"POST /api/v1/pipelines/validate\", h.\u001b[01;31m\u001b[KValidatePipeline\u001b[m\u001b[K)\r\n"]
[6424.371249, "o", "\u001b[35m\u001b[K./internal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tDependencies    []string               `json:\"\u001b[01;31m\u001b[Kdependencies\u001b[m\u001b[K\"`\r\n"]
[6424.371306, "o", "\u001b[35m\u001b[K./internal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// Engine executes pipelines by resolving step \u001b[01;31m\u001b[Kdependencies\u001b[m\u001b[K and running each step.\r\n\u001b[35m\u001b[K./internal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tDependencies []string `json:\"\u001b[01;31m\u001b[Kdependencies\u001b[m\u001b[K\"`\r\n"]
[6424.371443, "o", "\u001b[35m\u001b[K./internal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"\u001b[01;31m\u001b[Kduplicate step name\u001b[m\u001b[K: %s\", name))\r\n\u001b[35m\u001b[K./internal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif strings.Contains(err.Error(), \"\u001b[01;31m\u001b[Kcycle\u001b[m\u001b[K\") {\r\n"]
[6424.371499, "o", "\u001b[35m\u001b[K./internal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tresult.Errors = append(result.Errors, \"dependency \u001b[01;31m\u001b[Kcycle\u001b[m\u001b[K detected\")\r\n"]
[6424.371561, "o", "\u001b[35m\u001b[K./internal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K484\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// topologicalSort orders steps so that \u001b[01;31m\u001b[Kdependencies\u001b[m\u001b[K are executed first.\r\n\u001b[35m\u001b[K./internal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K485\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// Returns an error if a \u001b[01;31m\u001b[Kcycle\u001b[m\u001b[K is detected.\r\n"]
[6424.371624, "o", "\u001b[35m\u001b[K./internal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K505\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// Initialize queue with steps that have no \u001b[01;31m\u001b[Kdependencies\u001b[m\u001b[K\r\n\u001b[35m\u001b[K./internal/pipeline/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K534\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn nil, fmt.Errorf(\"\u001b[01;31m\u001b[Kcycle\u001b[m\u001b[K detected in pipeline \u001b[01;31m\u001b[Kdependencies\u001b[m\u001b[K\")\r\n"]
[6424.372096, "o", "\u001b[35m\u001b[K./docs/api-v1.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K5\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kgomlops is an ML model life\u001b[01;31m\u001b[Kcycle\u001b[m\u001b[K management platform providing model registration, versioning, pipeline execution, experiment tracking, and model serving through a REST API.\r\n"]
[6424.372154, "o", "\u001b[35m\u001b[K./docs/api-v1.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      {\"name\": \"s1\", \"type\": \"transform\", \"config\": {\"mode\": \"scale\", \"factor\": 2}, \"\u001b[01;31m\u001b[Kdependencies\u001b[m\u001b[K\": []},\r\n\u001b[35m\u001b[K./docs/api-v1.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      {\"name\": \"s2\", \"type\": \"aggregate\", \"config\": {\"operation\": \"sum\"}, \"\u001b[01;31m\u001b[Kdependencies\u001b[m\u001b[K\": [\"s1\"]}\r\n"]
