[5681.965332, "o", "     8\t)\r\n     9\t\r\n    10\t// ExecuteTransform applies a data transformation.\r\n    11\t// Supported modes: scale, offset, normalize, identity, clip, log.\r\n    12\tfunc ExecuteTransform(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n    13\t\tdata, ok := input[\"data\"].([]interface{})\r\n    14\t\tif !ok {\r\n    15\t\t\treturn nil, fmt.Errorf(\"transform: missing or invalid 'data' field in input\")\r\n    16\t\t}\r\n    17\t\r\n    18\t\tmode, _ := config[\"mode\"].(string)\r\n    19\t\tif mode == \"\" {\r\n    20\t\t\treturn nil, fmt.Errorf(\"transform: missing 'mode' in config\")\r\n    21\t\t}\r\n    22\t\r\n    23\t\tresult := make([]interface{}, len(data))\r\n    24\t\r\n"]
[5681.965424, "o", "    25\t\tswitch mode {\r\n    26\t\tcase \"scale\":\r\n    27\t\t\tfactor, _ := config[\"factor\"].(float64)\r\n    28\t\t\tfor i, v := range data {\r\n    29\t\t\t\tval, err := toFloat(v)\r\n    30\t\t\t\tif err != nil {\r\n    31\t\t\t\t\treturn nil, fmt.Errorf(\"transform scale: element %d: %w\", i, err)\r\n    32\t\t\t\t}\r\n    33\t\t\t\tresult[i] = val * factor\r\n    34\t\t\t}\r\n    35\t\r\n    36\t\tcase \"offset\":\r\n    37\t\t\toffset, _ := config[\"offset\"].(float64)\r\n"]
[5681.9655, "o", "    38\t\t\tfor i, v := range data {\r\n    39\t\t\t\tval, err := toFloat(v)\r\n    40\t\t\t\tif err != nil {\r\n    41\t\t\t\t\treturn nil, fmt.Errorf(\"transform offset: element %d: %w\", i, err)\r\n    42\t\t\t\t}\r\n    43\t\t\t\tresult[i] = val + offset\r\n    44\t\t\t}\r\n    45\t\r\n    46\t\tcase \"normalize\":\r\n    47\t\t\tif len(data) == 0 {\r\n"]
[5681.965574, "o", "    48\t\t\t\treturn map[string]interface{}{\"data\": result}, nil\r\n    49\t\t\t}\r\n    50\t\t\tminVal, maxVal := findMinMax(data)\r\n    51\t\t\tfor i, v := range data {\r\n    52\t\t\t\tval, err := toFloat(v)\r\n    53\t\t\t\tif err != nil {\r\n    54\t\t\t\t\treturn nil, fmt.Errorf(\"transform normalize: element %d: %w\", i, err)\r\n    55\t\t\t\t}\r\n    56\t\t\t\tif maxVal == minVal {\r\n    57\t\t\t\t\tresult[i] = 0.0\r\n"]
[5681.965649, "o", "    58\t\t\t\t} else {\r\n    59\t\t\t\t\tresult[i] = 2.0*(val-minVal)/(maxVal-minVal) - 1.0\r\n    60\t\t\t\t}\r\n    61\t\t\t}\r\n    62\t\r\n    63\t\tcase \"identity\":\r\n    64\t\t\tcopy(result, data)\r\n    65\t\r\n    66\t\tcase \"clip\":\r\n    67\t\t\tlow, _ := config[\"low\"].(float64)\r\n    68\t\t\thigh, _ := config[\"high\"].(float64)\r\n"]
[5681.965724, "o", "    69\t\t\tfor i, v := range data {\r\n    70\t\t\t\tval, err := toFloat(v)\r\n    71\t\t\t\tif err != nil {\r\n    72\t\t\t\t\treturn nil, fmt.Errorf(\"transform clip: element %d: %w\", i, err)\r\n    73\t\t\t\t}\r\n    74\t\t\t\tif val < low {\r\n    75\t\t\t\t\tval = low\r\n    76\t\t\t\t}\r\n    77\t\t\t\tif val > high {\r\n    78\t\t\t\t\tval = high\r\n    79\t\t\t\t}\r\n    80"]
