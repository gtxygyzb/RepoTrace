[2520.526472, "o", "\u001b[?2004h> "]
[2520.526708, "o", "\\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[?2004l\r"]
[2520.526767, "o", "\u001b[?2004h> "]
[2520.527057, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\u001b[?2004l\r"]
[2520.527115, "o", "\u001b[?2004h> "]
[2520.52717, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2520.527226, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2520.527489, "o", "\\truns, err := h.Experiment.SearchRuns(expName, req.Filters)\r\n\u001b[?2004l\r"]
[2520.527545, "o", "\u001b[?2004h> "]
[2520.527605, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[2520.527662, "o", "\u001b[?2004h> "]
[2520.527846, "o", "\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[2520.527917, "o", "\u001b[?2004h> "]
[2520.527972, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2520.528031, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2520.528259, "o", "\\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[?2004l\r"]
[2520.528314, "o", "\u001b[?2004h> "]
[2520.528383, "o", "\\t\\t\"runs\":  runs,\r\n\u001b[?2004l\r"]
[2520.528437, "o", "\u001b[?2004h> "]
[2520.528524, "o", "\\t\\t\"count\": len(runs),\r\n\u001b[?2004l\r"]
[2520.528578, "o", "\u001b[?2004h> \\t})\r\n\u001b[?2004l\r"]
[2520.528632, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[2520.528689, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2520.528744, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[2520.528799, "o", "\u001b[?2004h> "]
