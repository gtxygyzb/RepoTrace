[6956.312881, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[6956.31294, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[6956.312996, "o", "> '''\r\n\u001b[?2004l\r"]
[6956.313051, "o", "\u001b[?2004h> "]
[6956.313179, "o", "idx = text.index(\"func writeJSON\")\r\n\u001b[?2004l\r"]
[6956.313235, "o", "\u001b[?2004h> "]
[6956.313443, "o", "text = text[:idx] + new_handlers + \"\\n\" + text[idx:]\r\n\u001b[?2004l\r"]
[6956.313498, "o", "\u001b[?2004h> "]
[6956.313568, "o", "p.write_text(text)\r\n\u001b[?2004l\r"]
[6956.313622, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6956.313678, "o", "\u001b[?2004h> "]
[6956.313731, "o", "# --- router ---\r\n\u001b[?2004l\r"]
[6956.313787, "o", "\u001b[?2004h> "]
[6956.31393, "o", "p = Path(\"internal/api/router.go\")\r\n\u001b[?2004l\r"]
[6956.313988, "o", "\u001b[?2004h> "]
[6956.314063, "o", "text = p.read_text()\r\n\u001b[?2004l\r"]
[6956.314118, "o", "\u001b[?2004h> "]
