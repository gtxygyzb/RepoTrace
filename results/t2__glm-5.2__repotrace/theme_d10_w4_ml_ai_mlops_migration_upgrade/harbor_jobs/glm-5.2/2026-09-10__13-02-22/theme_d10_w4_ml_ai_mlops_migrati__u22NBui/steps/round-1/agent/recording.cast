[5752.479939, "o", "    39\ttype Version struct {\r\n    40\t\tNumber      int                    `json:\"number\"`\r\n    41\t\tStage       Stage                  `json:\"stage\"`\r\n    42\t\tMetrics     map[string]float64     `json:\"metrics\"`\r\n    43\t\tTags        []string               `json:\"tags\"`\r\n    44"]
[5752.480079, "o", "\t\tModelConfig map[string]interface{} `json:\"model_config,omitempty\"`\r\n    45\t\tCreatedAt   time.Time              `json:\"created_at\"`\r\n    46\t\tLineage     []PromotionRecord      `json:\"lineage\"`\r\n    47\t\tDemotedBy   int                    `json:\"demoted_by,omitempty\"`\r\n    48\t}\r\n    49\t\r\n    50\t// Model represents a registered ML model.\r\n"]
[5752.480183, "o", "    51\ttype Model struct {\r\n    52\t\tName         string     `json:\"name\"`\r\n    53\t\tFramework    string     `json:\"framework\"`\r\n    54\t\tDescription  string     `json:\"description\"`\r\n    55\t\tTags         []string   `json:\"tags\"`\r\n    56\t\tVersions     []*Version `json:\"versions\"`\r\n    57\t\tDependencies []string   `json:\"dependencies\"`\r\n    58\t\tCreatedAt    time.Time  `json:\"created_at\"`\r\n    59\t\tUpdatedAt    time.Time  `json:\"updated_at\"`\r\n    60\t}\r\n    61\t\r\n    62\t// ModelFilter defines filtering criteria for listing models.\r\n    63\ttype ModelFilter struct {\r\n    64\t\tFramework string\r\n    65\t\tTag       string\r\n    66\t}\r\n    67\t\r\n    68\t// Annotation represents a key-value annotation attached to a model version.\r\n    69\ttype Annotation struct {\r\n    70\t\tKey       string    `json:\"key\"`\r\n    71\t\tValue     string    `json:\"value\"`\r\n"]
[5752.480263, "o", "    72\t\tCreatedAt time.Time `json:\"created_at\"`\r\n    73\t}\r\n    74\t\r\n    75\tvar annotationKeyRegexp = regexp.MustCompile(`^[A-Za-z0-9_]+$`)\r\n"]
