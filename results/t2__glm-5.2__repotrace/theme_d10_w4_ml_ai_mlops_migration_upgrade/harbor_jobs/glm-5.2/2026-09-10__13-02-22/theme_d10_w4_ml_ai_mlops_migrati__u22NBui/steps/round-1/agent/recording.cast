[3947.674327, "o", "   261\tfunc (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {\r\n   262\t\texpName := r.PathValue(\"name\")\r\n   263\t\tmetricName := r.PathValue(\"metric\")\r\n   264\t\taggType := r.URL.Query().Get(\"type\")\r\n"]
