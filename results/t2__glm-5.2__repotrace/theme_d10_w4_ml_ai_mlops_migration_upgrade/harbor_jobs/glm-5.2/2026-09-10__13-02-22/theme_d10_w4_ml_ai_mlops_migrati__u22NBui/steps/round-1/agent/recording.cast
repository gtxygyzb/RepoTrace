[171.07596, "i", "sed -n '1,220p' internal/pipeline/engine.go\n"]
[171.076301, "o", "sed -n '1,220p' internal/pipeline/engine.go\r\n\u001b[?2004l\r"]
[171.07914, "o", "package pipeline\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"time\"\r\n)\r\n\r\n// StepType identifies the kind of processing a pipeline step performs.\r\ntype StepType string\r\n"]
[171.079231, "o", "\r\nconst (\r\n\tStepTransform StepType = \"transform\"\r\n\tStepValidate  StepType = \"validate\"\r\n\tStepAggregate StepType = \"aggregate\"\r\n\tStepExport    StepType = \"export\"\r\n\tStepFilter    StepType = \"filter\"\r\n)\r\n\r\n// Step defines a single unit of work in a pipeline.\r\ntype Step struct {\r\n\tName         string                 `json:\"name\"`\r\n\tType         StepType               `json:\"type\"`\r\n\tConfig       map[string]interface{} `json:\"config\"`\r\n\tDependencies []string               `json:\"dependencies\"`\r\n}\r\n\r\n"]
[171.079298, "o", "// Pipeline defines a named sequence of dependent steps.\r\ntype Pipeline struct {\r\n\tName  string  `json:\"name\"`\r\n\tSteps []*Step `json:\"steps\"`\r\n}\r\n\r\n// StepResult records the outcome of executing a single step.\r\ntype StepResult struct {\r\n\tStepName   string                 `json:\"step_name\"`\r\n\tStepType   StepType               `json:\"step_type\"`\r\n\tStatus     string                 `json:\"status\"`\r\n\tOutput     map[string]interface{} `json:\"output,omitempty\"`\r\n\t"]
[171.07936, "o", "Error      string                 `json:\"error,omitempty\"`\r\n\tDurationMs float64                `json:\"duration_ms\"`\r\n}\r\n\r\n// PipelineResult records the outcome of executing an entire pipeline.\r\n"]
[171.079462, "o", "type PipelineResult struct {\r\n\tPipelineName string        `json:\"pipeline_name\"`\r\n\tStatus       string        `json:\"status\"`\r\n\tSteps        []*StepResult `json:\"steps\"`\r\n\tTotalTimeMs  float64       `json:\"total_time_ms\"`\r\n}\r\n\r\n// Engine executes pipelines by resolving step dependencies and running each step.\r\ntype Engine struct {\r\n\tstepExecutors map[StepType]StepExecutor\r\n"]
[171.079518, "o", "}\r\n\r\n// StepExecutor is the function signature for executing a pipeline step.\r\ntype StepExecutor func(config, input map[string]interface{}) (map[string]interface{}, error)\r\n\r\n// NewEngine creates a pipeline engine with built-in step executors.\r\nfunc NewEngine() *Engine {\r\n\te := &Engine{\r\n\t\tstepExecutors: make(map[StepType]StepExecutor),\r\n\t}\r\n\te.stepExecutors[StepTransform] = ExecuteTransform\r\n\te.stepExecutors[StepValidate] = ExecuteValidate\r\n\te.stepExecutors[StepAggregate] = ExecuteAggregate\r\n\te.stepExecutors[StepExport] = ExecuteExport\r\n\te.stepExecutors[StepFilter] = ExecuteFilter\r\n\treturn e\r\n}\r\n\r\n"]
[171.079572, "o", "// Execute runs a pipeline with the given initial input data.\r\nfunc (e *Engine) Execute(p *Pipeline, initialInput map[string]interface{}) (*PipelineResult, error) {\r\n\tordered, err := topologicalSort(p.Steps)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"dependency resolution failed: %w\", err)\r\n\t}\r\n\r\n\tpipelineStart := time.Now()\r\n\tresult := &PipelineResult{\r\n\t\tPipelineName: p.Name,\r\n\t\tStatus:       \"success\",\r\n"]
[171.079625, "o", "\t\tSteps:        make([]*StepResult, 0, len(ordered)),\r\n\t}\r\n\r\n\tstepOutputs := make(map[string]map[string]interface{})\r\n\tvar lastOutput map[string]interface{}\r\n\r\n\tfor _, step := range ordered {\r\n"]
[171.079675, "o", "\t\tstepStart := time.Now()\r\n\r\n\t\t// Determine input for this step\r\n\t\tvar input map[string]interface{}\r\n\t\tif len(step.Dependencies) == 0 {\r\n\t\t\tinput = initialInput\r\n\t\t} else {\r\n\t\t\tinput = lastOutput\r\n\t\t}\r\n\r\n"]
[171.079727, "o", "\t\t// Find and run the executor\r\n\t\texecutor, ok := e.stepExecutors[step.Type]\r\n\t\tif !ok {\r\n\t\t\tsr := &StepResult{\r\n\t\t\t\tStepName:   step.Name,\r\n\t\t\t\tStepType:   step.Type,\r\n\t\t\t\tStatus:     \"failed\",\r\n\t\t\t\tError:      fmt.Sprintf(\"unknown step type: %s\", step.Type),\r\n\t\t\t\tDurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\r\n\t\t\t}\r\n\t\t\tresult.Steps = append(result.Steps, sr)\r\n"]
[171.079779, "o", "\t\t\tresult.Status = \"failed\"\r\n\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n\t\t\treturn result, nil\r\n\t\t}\r\n\r\n\t\toutput, err := executor(step.Config, input)\r\n"]
[171.079836, "o", "\t\tduration := float64(time.Since(stepStart).Microseconds()) / 1000.0\r\n\r\n\t\tsr := &StepResult{\r\n\t\t\tStepName:   step.Name,\r\n\t\t\tStepType:   step.Type,\r\n\t\t\tDurationMs: duration,\r\n\t\t}\r\n\r\n\t\tif err != nil {\r\n\t\t\tsr.Status = \"failed\"\r\n\t\t\tsr.Error = err.Error()\r\n\t\t\tresult.Steps = append(result.Steps, sr)\r\n\t\t\tresult.Status = \"failed\"\r\n\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n\t\t\treturn result, nil\r\n\t\t}\r\n\r\n"]
[171.079858, "o", "\t\tsr.Status = \"success\"\r\n"]
[171.07994, "o", "\t\tsr.Output = output\r\n\t\tresult.Steps = append(result.Steps, sr)\r\n\r\n\t\tstepOutputs[step.Name] = output\r\n\t\tlastOutput = output\r\n\t}\r\n\r\n\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n\treturn result, nil\r\n}\r\n\r\n// topologicalSort orders steps so that dependencies are executed first.\r\n// Returns an error if a cycle is detected.\r\nfunc topologicalSort(steps []*Step) ([]*Step, error) {\r\n\tstepMap := make(map[string]*Step)\r\n"]
[171.079992, "o", "\tinDegree := make(map[string]int)\r\n\r\n\tfor _, s := range steps {\r\n\t\t"]
[171.080047, "o", "stepMap[s.Name] = s\r\n\t\tinDegree[s.Name] = 0\r\n\t}\r\n\r\n\t// Build in-degree counts\r\n\tfor _, s := range steps {\r\n\t\tfor _, dep := range s.Dependencies {\r\n\t\t\tif _, ok := stepMap[dep]; !ok {\r\n"]
[171.080098, "o", "\t\t\t\treturn nil, fmt.Errorf(\"step %q depends on unknown step %q\", s.Name, dep)\r\n\t\t\t}\r\n\t\t\tinDegree[s.Name]++\r\n\t\t}\r\n\t}\r\n\r\n\t// Kahn's algorithm\r\n\tvar queue []*Step\r\n\t"]
[171.08015, "o", "for _, s := range steps {\r\n\t\tif inDegree[s.Name] == 0 {\r\n\t\t\tqueue = append(queue, s)\r\n\t\t}\r\n\t}\r\n\r\n\tvar ordered []*Step\r\n\tfor len(queue) > 0 {\r\n\t\tcurrent := queue[0]\r\n\t\tqueue = queue[1:]\r\n"]
[171.080201, "o", "\t\tordered = append(ordered, current)\r\n\r\n\t\t// Find steps that depend on current\r\n\t\tfor _, s := range steps {\r\n\t\t\tfor _, dep := range s.Dependencies {\r\n\t\t\t\tif dep == current.Name {\r\n\t\t\t\t\tinDegree[s.Name]--\r\n"]
[171.080257, "o", "\t\t\t\t\tif inDegree[s.Name] == 0 {\r\n\t\t\t\t\t\tqueue = append(queue, s)\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif len(ordered) != len(steps) {\r\n\t\treturn nil, fmt.Errorf(\"cycle detected in pipeline dependencies\")\r\n\t}\r\n\r\n\treturn ordered, nil\r\n}\r\n\r\n// mergeOutputs collects and merges data arrays from the specified dependency outputs.\r\nfunc mergeOutputs(stepOutputs map[string]map[string]interface{}, deps []string) map[string]interface{} {\r\n"]
[171.080309, "o", "\tmerged := make(map[string]interface{})\r\n\tvar mergedData []interface{}\r\n"]
[171.080359, "o", "\r\n\tfor _, dep := range deps {\r\n\t\tif output, ok := stepOutputs[dep]; ok {\r\n\t\t\tif data, ok := output[\"data\"]; ok {\r\n\t\t\t\tswitch d := data.(type) {\r\n\t\t\t\tcase []interface{}:\r\n\t\t\t\t\tmergedData = append(mergedData, d...)\r\n\t\t\t\tcase []float64:\r\n"]
[171.080414, "o", "\t\t\t\t\tfor _, v := range d {\r\n\t\t\t\t\t\tmergedData = append(mergedData, v)\r\n\t\t\t\t\t}\r\n\t\t\t\tdefault:\r\n\t\t\t\t\tmergedData = append(mergedData, data)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t// Also carry non-data fields keyed by dependency name\r\n"]
[171.080856, "o", "\u001b[?2004h"]
[171.080916, "o", "root@n30009:/app# "]
[171.367483, "i", "sed -n '1,230p' internal/pipeline/steps.go\n"]
[171.36782, "o", "sed -n '1,230p' internal/pipeline/steps.go\r\n"]
[171.367886, "o", "\u001b[?2004l\r"]
[171.370648, "o", "package pipeline\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
[171.370728, "o", "\t\"sort\"\r\n)\r\n\r\n// ExecuteTransform applies a data transformation.\r\n// Supported modes: scale, offset, normalize, identity, clip, log.\r\nfunc ExecuteTransform(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"transform: missing or invalid 'data' field in input\")\r\n\t}\r\n\r\n\tmode, _ := config[\"mode\"].(string)\r\n\tif mode == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"transform: missing 'mode' in config\")\r\n"]
[171.370802, "o", "\t}\r\n\r\n\tresult := make([]interface{}, len(data))\r\n\r\n\tswitch mode {\r\n\tcase \"scale\":\r\n\t\tfactor, _ := config[\"factor\"].(float64)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform scale: element %d: %w\", i, err)\r\n\t\t\t}\r\n"]
[171.370901, "o", "\t\t\tresult[i] = val * factor\r\n\t\t}\r\n\r\n\tcase \"offset\":\r\n\t\toffset, _ := config[\"offset\"].(float64)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform offset: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t\t\tresult[i] = val + offset\r\n"]
[171.370961, "o", "\t\t}\r\n\r\n\tcase \"normalize\":\r\n\t\tif len(data) == 0 {\r\n\t\t\treturn map[string]interface{}{\"data\": result}, nil\r\n\t\t}\r\n\t\tminVal, maxVal := findMinMax(data)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform normalize: element %d: %w\", i, err)\r\n\t\t\t}\r\n"]
[171.371018, "o", "\t\t\tif maxVal == 0 {\r\n\t\t\t\tresult[i] = 0.0\r\n\t\t\t} else {\r\n\t\t\t\tresult[i] = (val - minVal) / maxVal\r\n\t\t\t}\r\n\t\t}\r\n\r\n"]
[171.371077, "o", "\tcase \"identity\":\r\n\t\tcopy(result, data)\r\n\r\n\tcase \"clip\":\r\n\t\tlow, _ := config[\"low\"].(float64)\r\n\t\thigh, _ := config[\"high\"].(float64)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n"]
[171.371134, "o", "\t\t\t\treturn nil, fmt.Errorf(\"transform clip: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t\t\tif val < low {\r\n\t\t\t\tval = low\r\n\t\t\t}\r\n\t\t\tif val > high {\r\n\t\t\t\tval = high\r\n\t\t\t}\r\n\t"]
[171.371195, "o", "\t\tresult[i] = val\r\n\t\t}\r\n\r\n\tcase \"log\":\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform log: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t"]
[171.371253, "o", "\t\tif val <= 0 {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform log: element %d is non-positive (%f)\", i, val)\r\n\t\t\t}\r\n\t\t\tresult[i] = math.Log(val)\r\n\t\t}\r\n\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"transform: unknown mode %q\", mode)\r\n\t}\r\n\r\n"]
[171.37131, "o", "\treturn map[string]interface{}{\"data\": result}, nil\r\n}\r\n\r\n// ExecuteValidate checks data against schema constraints.\r\nfunc ExecuteValidate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"validate: missing or invalid 'data' field\")\r\n\t}\r\n\r\n\tvar errors []interface{}\r\n\r\n"]
[171.371372, "o", "\t// Check min_value constraint\r\n\tif minVal, ok := config[\"min_value\"].(float64); ok {\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: not a number\", i))\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif val < minVal {\r\n\t\t"]
[171.37143, "o", "\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f below minimum %f\", i, val, minVal))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// Check max_value constraint\r\n\tif maxVal, ok := config[\"max_value\"].(float64); ok {\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n"]
[171.371487, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif val > maxVal {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f above maximum %f\", i, val, maxVal))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// Check min_count constraint\r\n"]
[171.371547, "o", "\tif minCount, ok := config[\"min_count\"].(float64); ok {\r\n\t\tif float64(len(data)) < minCount {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"data has %d elements, minimum required is %d\", len(data), int(minCount)))\r\n\t\t}\r\n\t}\r\n\r\n\tvalid := len(errors) == 0\r\n"]
[171.371606, "o", "\treturn map[string]interface{}{\r\n\t\t\"valid\":  valid,\r\n\t\t\"errors\": errors,\r\n\t\t\"data\":   data,\r\n\t}, nil\r\n}\r\n\r\n// ExecuteAggregate computes aggregations over input data.\r\n// Supported operations: sum, mean, count, min, max.\r\nfunc ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n"]
[171.371663, "o", "\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"aggregate: missing or invalid 'data' field\")\r\n\t}\r\n\r\n\toperation, _ := config[\"operation\"].(string)\r\n\tif operation == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"aggregate: missing 'operation' in config\")\r\n\t}\r\n\r\n"]
[171.371719, "o", "\tvalues := make([]float64, 0, len(data))\r\n\tfor _, v := range data {\r\n\t\tval, err := toFloat(v)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvalues = append(values, val)\r\n\t}\r\n\r\n\tif len(values) == 0 {\r\n"]
[171.371776, "o", "\t\treturn map[string]interface{}{\"result\": 0.0, \"count\": 0.0}, nil\r\n\t}\r\n\r\n\tvar result float64\r\n\tswitch operation {\r\n\tcase \"sum\":\r\n\t\tfor _, v := range values {\r\n\t\t\tresult += v\r\n\t\t}\r\n\tcase \"mean\":\r\n\t\tfor _, v := range values {\r\n"]
[171.371833, "o", "\t\t\tresult += v\r\n\t\t}\r\n\t\tresult /= float64(len(values))\r\n\tcase \"count\":\r\n\t\tresult = float64(len(values))\r\n\tcase \"min\":\r\n\t\tresult = values[0]\r\n\t\tfor _, v := range values[1:] {\r\n\t\t\tif v < result {\r\n"]
[171.371897, "o", "\t\t\t\tresult = v\r\n\t\t\t}\r\n\t\t}\r\n\tcase \"max\":\r\n\t\tresult = values[0]\r\n\t\tfor _, v := range values[1:] {\r\n\t\t\tif v > result {\r\n\t\t\t\tresult = v\r\n\t\t\t}\r\n\t\t}\r\n"]
[171.371955, "o", "\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"aggregate: unknown operation %q\", operation)\r\n\t}\r\n\r\n\treturn map[string]interface{}{\r\n\t\t\"result\": result,\r\n\t\t\"count\":  float64(len(values)),\r\n\t\t\"data\":   data,\r\n\t}, nil\r\n"]
[171.372017, "o", "}\r\n\r\n// ExecuteExport formats data for output.\r\n// Supported formats: json, csv, summary.\r\nfunc ExecuteExport(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tformat, _ := config[\"format\"].(string)\r\n\tif format == \"\" {\r\n\t\tformat = \"json\"\r\n\t}\r\n\r\n\tswitch format {\r\n\tcase \"json\":\r\n"]
[171.372073, "o", "\t\treturn map[string]interface{}{\r\n\t\t\t\"format\": \"json\",\r\n\t\t\t\"data\":   input,\r\n\t\t}, nil\r\n\r\n"]
[171.372559, "o", "\u001b[?2004h"]
