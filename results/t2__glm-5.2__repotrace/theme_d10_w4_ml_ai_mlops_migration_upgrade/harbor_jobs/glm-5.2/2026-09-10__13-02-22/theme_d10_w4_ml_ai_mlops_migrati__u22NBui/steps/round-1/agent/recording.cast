[2055.359713, "o", "\r\n   149\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   150\t\t\t\tresult.Status = \"failed\"\r\n   151\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   152\t\t\t\treturn result, nil\r\n   153\t\t\t}\r\n   154\t\r\n   155\t\t\tif step.OutputTransform != \"\" && (step.Type == StepTransform || step.Type == StepFilter) {\r\n   156\t\t\t\ttransformed, terr := applyOutputTransform(output, resolvedConfig, step.OutputTransform)\r\n   157\t\t\t\tif terr != nil {\r\n   158\t\t\t\t\tsr.Status = \"failed\"\r\n   159\t\t\t\t\tsr.Error = terr.Error()\r\n   160\t\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   161\t\t\t\t\tresult.Status = \"failed\"\r\n"]
[2055.359772, "o", "   162\t\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   163\t\t\t\t\treturn result, nil\r\n   164\t\t\t\t}\r\n   165\t\t\t\toutput = transformed\r\n   166\t\t\t}\r\n   167\t\r\n"]
[2055.359831, "o", "   168\t\t\tif len(step.SetVars) > 0 {\r\n   169\t\t\t\tif verr := setVariables(output, step.SetVars, variables, variableSetter, step.Name); verr != nil {\r\n   170\t\t\t\t\tsr.Status = \"failed\"\r\n   171\t\t\t\t\tsr.Error = verr.Error()\r\n   172\t\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   173\t\t\t\t\tresult.Status = \"failed\"\r\n   174\t\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n"]
[2055.359903, "o", "   175\t\t\t\t\treturn result, nil\r\n   176\t\t\t\t}\r\n   177\t\t\t}\r\n   178\t\r\n   179\t\t\tsr.Status = \"success\"\r\n   180\t\t\tsr.Output = output\r\n   181\t\t\tresult.Steps = append(result.Steps, sr)\r\n   182\t\r\n   183\t"]
[2055.359962, "o", "\t\tstepOutputs[step.Name] = output\r\n   184\t\t}\r\n   185\t\r\n   186\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   187\t\treturn result, nil\r\n   188\t}\r\n   189\t\r\n   190\t// topologicalSort orders steps so that dependencies are executed first.\r\n   191\t// Returns an error if a cycle is detected.\r\n   192\t"]
[2055.36002, "o", "func topologicalSort(steps []*Step) ([]*Step, error) {\r\n   193\t\tstepMap := make(map[string]*Step)\r\n   194\t\tinDegree := make(map[string]int)\r\n   195\t\r\n   196\t\tfor _, s := range steps {\r\n   197\t\t\tstepMap[s.Name] = s\r\n   198\t\t\tinDegree[s.Name] = 0\r\n   199\t\t}\r\n   200\t\r\n   201\t\t"]
[2055.360087, "o", "// Build in-degree counts\r\n   202\t\tfor _, s := range steps {\r\n   203\t\t\tfor _, dep := range s.Dependencies {\r\n   204\t\t\t\tif _, ok := stepMap[dep]; !ok {\r\n   205\t\t\t\t\t"]
[2055.360149, "o", "return nil, fmt.Errorf(\"step %q depends on unknown step %q\", s.Name, dep)\r\n   206\t\t\t\t}\r\n   207\t\t\t\tinDegree[s.Name]++\r\n   208\t\t\t}\r\n   209\t\t}\r\n   210\t\r\n   211\t\t// Initialize queue with steps that have no dependencies\r\n   212\t\tqueue := make([]*Step, 0)\r\n   213\t\tfor _, s := range steps {\r\n   214\t\t\tif inDegree[s.Name] == 0 {\r\n   215\t\t\t\tqueue = append(queue, s)\r\n   216\t\t\t}\r\n   217\t\t}\r\n   218\t\r\n   219\t\t// Process steps in topological order\r\n"]
[2055.360215, "o", "   220\t\tordered := make([]*Step, 0, len(steps))\r\n"]
