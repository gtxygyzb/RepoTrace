[6388.767218, "o", "package serving\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"sync\"\r\n\t\"time\"\r\n\r\n\t\"gomlops/internal/registry\"\r\n)\r\n\r\n// LoadedModel tracks a model version currently loaded for serving.\r\ntype LoadedModel struct {\r\n"]
[6388.767366, "o", "\tModelName   string                 `json:\"model_name\"`\r\n\tVersionNum  int                    `json:\"version_num\"`\r\n\tStage       registry.Stage         `json:\"stage\"`\r\n\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n\tLoadedAt    time.Time              `json:\"loaded_at\"`\r\n}\r\n\r\n// InferenceRequest contains the input data for model inference.\r\ntype InferenceRequest struct {\r\n\tModelName string    `json:\"model_name\"`\r\n\tInput     []float64 `json:\"input\"`\r\n}\r\n\r\n// InferenceResponse contains the model prediction results.\r\ntype InferenceResponse struct {\r\n\tModelName   string    `json:\"model_name\"`\r\n\tVersion     int       `json:\"version\"`\r\n\tPredictions []float64 `json:\"predictions\"`\r\n\tLatencyMs   float64   `json:\"latency_ms\"`\r\n}\r\n\r\n// ModelStats tracks inference statistics for a single model.\r\ntype ModelStats struct {\r\n\tRequests   int     `json:\"requests\"`\r\n\tSuccessful int     `json:\"successful\"`\r\n\tFailed     int     `json:\"failed\"`\r\n\tLatencySum float64 `json:\"-\"`\r\n}\r\n"]
[6388.767471, "o", "\r\n// Stats tracks accumulated serving statistics.\r\ntype Stats struct {\r\n\tTotalRequests int\r\n\tSuccessful    int\r\n\tFailed        int\r\n\tLatencySum    float64\r\n\tModels        map[string]*ModelStats\r\n}\r\n\r\n// StatsResponse is the public serving statistics representation.\r\ntype StatsResponse struct {\r\n\tTotalRequests int                           `json:\"total_requests\"`\r\n\tSuccessful    int                           `json:\"successful\"`\r\n\tFailed        int                           `json:\"failed\"`\r\n\tAvgLatencyMs  float64                       `json:\"avg_latency_ms\"`\r\n\tModels        map[string]ModelStatsResponse `json:\"models\"`\r\n}\r\n\r\n// ModelStatsResponse is the public model statistics representation.\r\ntype ModelStatsResponse struct {\r\n\tRequests     int     `json:\"requests\"`\r\n"]
[6388.767564, "o", "\tSuccessful   int     `json:\"successful\"`\r\n\tFailed       int     `json:\"failed\"`\r\n\tAvgLatencyMs float64 `json:\"avg_latency_ms\"`\r\n\tSuccessRate  float64 `json:\"success_rate\"`\r\n}\r\n\r\n// Server manages model loading and inference.\r\ntype Server struct {\r\n\tmu       sync.RWMutex\r\n\tloaded   map[string]*LoadedModel\r\n\tregistry *registry.Registry\r\n\tstats    Stats\r\n}\r\n\r\n// NewServer creates a new serving server backed by the given registry.\r\nfunc NewServer(reg *registry.Registry) *Server {\r\n\treturn &Server{\r\n\t\tloaded:   make(map[string]*LoadedModel),\r\n\t\tregistry: reg,\r\n\t\tstats: Stats{\r\n"]
[6388.76765, "o", "\t\t\tModels: make(map[string]*ModelStats),\r\n\t\t},\r\n\t}\r\n}\r\n\r\n// LoadModel loads a model version for serving. Specify either versionNum > 0\r\n// or a non-empty stage string (not both).\r\nfunc (s *Server) LoadModel(modelName string, versionNum int, stage string) error {\r\n\tvar version *registry.Version\r\n\tvar err error\r\n\r\n\tif versionNum > 0 {\r\n\t\tversion, err = s.registry.GetVersion(modelName, versionNum)\r\n\t} else if stage != \"\" {\r\n\t\tversion, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))\r\n"]
[6388.767731, "o", "\t} else {\r\n\t\treturn fmt.Errorf(\"must specify version number or stage\")\r\n\t}\r\n\r\n\tif err != nil {\r\n\t\treturn fmt.Errorf(\"load model: %w\", err)\r\n\t}\r\n\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\ts.loaded[modelName] = &LoadedModel{\r\n\t\tModelName:   modelName,\r\n\t\tVersionNum:  version.Number,\r\n\t\tStage:       version.Stage,\r\n\t\tModelConfig: version.ModelConfig,\r\n\t\t"]
[6388.767817, "o", "LoadedAt:    time.Now(),\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n// UnloadModel removes a model from the serving cache.\r\nfunc (s *Server) UnloadModel(modelName string) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\tif _, exists := s.loaded[modelName]; !exists {\r\n\t\treturn fmt.Errorf(\"model %q is not loaded\", modelName)\r\n\t}\r\n\tdelete(s.loaded, modelName)\r\n\treturn nil\r\n}\r\n\r\n// Infer runs inference on the loaded model and returns predictions.\r\nfunc (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {\r\n"]
[6388.767932, "o", "\tstart := time.Now()\r\n\r\n\ts.mu.RLock()\r\n\tloaded, exists := s.loaded[req.ModelName]\r\n\ts.mu.RUnlock()\r\n\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", req.ModelName)\r\n\t}\r\n\r\n\tpredictions, err := computePrediction(loaded.ModelConfig, req.Input)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n\t}\r\n\r\n\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n\r\n\treturn &InferenceResponse{\r\n\t\tModelName:   req.ModelName,\r\n"]
[6388.768014, "o", "\t\tVersion:     loaded.VersionNum,\r\n\t\tPredictions: predictions,\r\n\t\tLatencyMs:   latency,\r\n\t}, nil\r\n}\r\n\r\n// RecordRequest updates serving statistics for a single inference request.\r\nfunc (s *Server) RecordRequest(modelName string, successful bool, latencyMs float64) {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\ts.stats.TotalRequests++\r\n\tif successful {\r\n\t\ts.stats.Successful++\r\n\t\ts.stats.LatencySum += latencyMs\r\n\t} else {\r\n\t\ts.stats.Failed++\r\n\t}\r\n"]
[6388.768094, "o", "\r\n\tmodel := s.stats.Models[modelName]\r\n\tif model == nil {\r\n\t\tmodel = &ModelStats{}\r\n\t\ts.stats.Models[modelName] = model\r\n\t}\r\n\tmodel.Requests++\r\n\tif successful {\r\n\t\tmodel.Successful++\r\n\t\tmodel.LatencySum += latencyMs\r\n\t} else {\r\n\t\tmodel.Failed++\r\n\t}\r\n}\r\n\r\n// GetStats returns a snapshot of accumulated serving statistics.\r\nfunc (s *Server) GetStats() StatsResponse {\r\n"]
[6388.768176, "o", "\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\r\n\tresp := StatsResponse{\r\n\t\tTotalRequests: s.stats.TotalRequests,\r\n\t\tSuccessful:    s.stats.Successful,\r\n\t\tFailed:        s.stats.Failed,\r\n\t\tModels:        make(map[string]ModelStatsResponse),\r\n\t}\r\n\tif s.stats.Successful > 0 {\r\n\t\tresp.AvgLatencyMs = s.stats.LatencySum / float64(s.stats.Successful)\r\n\t}\r\n\r\n\tfor name, model := range s.stats.Models {\r\n\t\tm := ModelStatsResponse{\r\n\t\t\tRequests:   model.Requests,\r\n"]
[6388.768256, "o", "\t\t\tSuccessful: model.Successful,\r\n\t\t\tFailed:     model.Failed,\r\n\t\t}\r\n\t\tif model.Successful > 0 {\r\n\t\t\tm.AvgLatencyMs = model.LatencySum / float64(model.Successful)\r\n\t\t}\r\n\t\tif model.Requests > 0 {\r\n\t\t\tm.SuccessRate = float64(model.Successful) / float64(model.Requests)\r\n\t\t}\r\n\t\tresp.Models[name] = m\r\n\t}\r\n\treturn resp\r\n}\r\n"]
[6388.768333, "o", "\r\n// ResetStats resets all serving statistics to zero.\r\nfunc (s *Server) ResetStats() {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n"]
[6388.768815, "o", "\u001b[?2004h"]
[6388.768901, "o", "root@n30009:/app# "]
[6389.236284, "i", "sed -n '220,520p' internal/serving/serving.go\n"]
[6389.236654, "o", "sed -n '220,520p' internal/serving/serving.go\r\n\u001b[?2004l\r"]
[6389.239732, "o", "\tdefer s.mu.Unlock()\r\n\r\n\ts.stats = Stats{\r\n\t\tModels: make(map[string]*ModelStats),\r\n\t}\r\n}\r\n\r\n"]
[6389.239814, "o", "// HealthCheck checks a loaded model against the current registry state.\r\ntype HealthStatus struct {\r\n\tModelName     string         `json:\"model_name\"`\r\n\tStatus        string         `json:\"status\"`\r\n\tLoadedVersion int            `json:\"loaded_version\"`\r\n\tLoadedStage   registry.Stage `json:\"loaded_stage\"`\r\n\tRegistryStage registry.Stage `json:\"registry_stage\"`\r\n\tStageMatch    bool           `json:\"stage_match\"`\r\n}\r\n\r\n// HealthCheck verifies the loaded model's stage against the current registry state.\r\nfunc (s *Server) HealthCheck(modelName string) (*HealthStatus, error) {\r\n\ts.mu.RLock()\r\n\t"]
[6389.239925, "o", "loaded, ok := s.loaded[modelName]\r\n\ts.mu.RUnlock()\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"model %q is not loaded\", modelName)\r\n\t}\r\n\r\n\th := &HealthStatus{\r\n\t\tModelName:     modelName,\r\n\t\tLoadedVersion: loaded.VersionNum,\r\n\t\tLoadedStage:   loaded.Stage,\r\n\t}\r\n\r\n\tversion, err := s.registry.GetVersion(modelName, loaded.VersionNum)\r\n\tif err != nil {\r\n\t\th.Status = \"orphaned\"\r\n\t\t"]
[6389.239991, "o", "h.RegistryStage = \"unknown\"\r\n\t\th.StageMatch = false\r\n\t\treturn h, nil\r\n\t}\r\n\r\n\th.RegistryStage = version.Stage\r\n\th.StageMatch = loaded.Stage == version.Stage\r\n\tif h.StageMatch {\r\n\t\th.Status = \"healthy\"\r\n\t} else {\r\n"]
[6389.240048, "o", "\t\th.Status = \"stale\"\r\n\t}\r\n\treturn h, nil\r\n}\r\n\r\n// ListLoaded returns all currently loaded models.\r\nfunc (s *Server) ListLoaded() []*LoadedModel {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\r\n\tresult := make([]*LoadedModel, 0, len(s.loaded))\r\n\tfor _, lm := range s.loaded {\r\n\t\tresult = append(result, lm)\r\n"]
[6389.240113, "o", "\t}\r\n\treturn result\r\n}\r\n\r\n// computePrediction evaluates a model against input data.\r\n// Supported model types: linear, polynomial.\r\nfunc computePrediction(modelConfig map[string]interface{}, input []float64) ([]float64, error) {\r\n\tif modelConfig == nil {\r\n\t\treturn nil, fmt.Errorf(\"model has no configuration\")\r\n\t}\r\n\r\n"]
[6389.240174, "o", "\tmodelType, _ := modelConfig[\"model_type\"].(string)\r\n\tswitch modelType {\r\n\tcase \"linear\":\r\n\t\treturn linearPredict(modelConfig, input)\r\n\tcase \"polynomial\":\r\n\t\treturn polynomialPredict(modelConfig, input)\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"unsupported model type: %s\", modelType)\r\n\t}\r\n}\r\n"]
[6389.240232, "o", "\r\n// linearPredict computes y = sum(weights[i] * input[i]) + bias\r\nfunc linearPredict(config map[string]interface{}, input []float64) ([]float64, error) {\r\n\tweightsRaw, ok := config[\"weights\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"linear model missing weights\")\r\n\t}\r\n\tbias, _ := config[\"bias\"].(float64)\r\n\r\n\tweights := make([]float64, len(weightsRaw))\r\n\tfor i, w := range weightsRaw {\r\n\t"]
[6389.240289, "o", "\twf, ok := w.(float64)\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"weight %d is not a number\", i)\r\n\t\t}\r\n\t\tweights[i] = wf\r\n\t}\r\n\r\n\tprediction := bias\r\n\tfor i := 0; i < len(weights) && i < len(input); i++ {"]
[6389.240357, "o", "\r\n\t\tprediction += weights[i] * input[i]\r\n\t}\r\n\r\n\treturn []float64{prediction}, nil\r\n}\r\n\r\n"]
[6389.240417, "o", "// polynomialPredict computes y = sum(coefficients[i] * x^i) for each input x\r\nfunc polynomialPredict(config map[string]interface{}, input []float64) ([]float64, error) {\r\n\tcoeffRaw, ok := config[\"coefficients\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"polynomial model missing coefficients\")\r\n\t}\r\n\r\n\tcoefficients := make([]float64, len(coeffRaw))\r\n\tfor i, c := range coeffRaw {\r\n\t\tcf, ok := c.(float64)\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"coefficient %d is not a number\", i)\r\n\t\t}\r\n\t\tcoefficients[i] = cf\r\n\t}\r\n\r\n\tpredictions := make([]float64, len(input))\r\n\tfor j, x := range input {\r\n"]
[6389.24048, "o", "\t\ty := 0.0\r\n\t\txPow := 1.0\r\n\t\tfor _, c := range coefficients {\r\n\t\t\ty += c * xPow\r\n\t\t\txPow *= x\r\n\t\t}\r\n\t\tpredictions[j] = y\r\n\t}\r\n\r\n\treturn predictions, nil\r\n}\r\n"]
