[144.857816, "o", "\t\t\tfor _, v := range values {\r\n   186\t\t\t\tresult += v\r\n   187\t\t\t}\r\n   188\t\t\tresult /= float64(len(values))\r\n   189\t\tcase \"count\":\r\n   190\t\t\tresult = float64(len(values))\r\n   191\t\tcase \"min\":\r\n   192\t\t\tresult = values[0]\r\n"]
[144.857884, "o", "   193\t\t\tfor _, v := range values[1:] {\r\n   194\t\t\t\tif v < result {\r\n   195\t\t\t\t\tresult = v\r\n   196\t\t\t\t}\r\n   197\t\t\t}\r\n   198\t\tcase \"max\":\r\n   199\t\t\tresult = values[0]\r\n   200\t\t\tfor _, v := range values[1:] {\r\n   201\t\t\t\tif v > result {\r\n   202\t\t\t\t\tresult = v\r\n"]
