[1442.635159, "o", "\u0007"]
[1442.63543, "o", "stepExecutors map[StepType]StepExecutor\r\n\u001b[?2004l\r"]
[1442.635487, "o", "\u001b[?2004h> "]
[1442.635538, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1442.635587, "o", "> \r\n\u001b[?2004l\r"]
[1442.635635, "o", "\u001b[?2004h> "]
[1442.636114, "o", "// StepExecutor is the function signature for executing a pipeline step.\r\n\u001b[?2004l\r"]
[1442.636177, "o", "\u001b[?2004h> "]
[1442.636664, "o", "type StepExecutor func(config, input map[string]interface{}) (map[string]interface{}, error)\r\n\u001b[?2004l\r"]
[1442.636692, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1442.636776, "o", " \u001b[?2004h> "]
[1442.63711, "o", "// NewEngine creates a pipeline engine with built-in step executors.\r\n\u001b[?2004l\r"]
[1442.637169, "o", "\u001b[?2004h> "]
[1442.637281, "o", "func NewEngine() *Engine {\r\n\u001b[?2004l\r"]
[1442.637335, "o", "\u001b[?2004h> "]
[1442.637385, "o", "\u0007"]
[1442.637434, "o", "e := &Engine{\r\n\u001b[?2004l\r"]
[1442.637482, "o", "\u001b[?2004h> "]
[1442.637528, "o", "\u0007"]
[1442.637577, "o", "\r\n"]
[1442.637624, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.637866, "o", "stepExecutors: make(map[StepType]StepExecutor),\r\n\u001b[?2004l\r"]
[1442.637927, "o", "\u001b[?2004h> "]
[1442.637977, "o", "\u0007}\r\n\u001b[?2004l\r"]
[1442.638027, "o", "\u001b[?2004h> "]
[1442.638076, "o", "\u0007"]
[1442.638322, "o", "e.stepExecutors[StepTransform] = ExecuteTransform\r\n\u001b[?2004l\r"]
[1442.638381, "o", "\u001b[?2004h> "]
[1442.638431, "o", "\u0007"]
[1442.638662, "o", "e.stepExecutors[StepValidate] = ExecuteValidate\r\n\u001b[?2004l\r"]
[1442.638719, "o", "\u001b[?2004h> "]
[1442.638769, "o", "\u0007"]
[1442.639006, "o", "e.stepExecutors[StepAggregate] = ExecuteAggregate\r\n\u001b[?2004l\r"]
[1442.639066, "o", "\u001b[?2004h> "]
[1442.639117, "o", "\u0007"]
[1442.639315, "o", "e.stepExecutors[StepExport] = ExecuteExport\r\n\u001b[?2004l\r"]
[1442.639344, "o", "\u001b[?2004h> "]
[1442.639409, "o", "\u0007"]
[1442.639611, "o", "e.stepExecutors[StepFilter] = ExecuteFilter\r\n\u001b[?2004l\r"]
[1442.639666, "o", "\u001b[?2004h> "]
[1442.639713, "o", "\u0007"]
[1442.639761, "o", "return e\r\n\u001b[?2004l\r"]
[1442.639808, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1442.639865, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h"]
[1442.639913, "o", "> "]
[1442.640206, "o", "// Execute runs a pipeline with the given initial input data.\r\n\u001b[?2004l\r"]
[1442.640267, "o", "\u001b[?2004h> "]
[1442.640767, "o", "func (e *Engine) Execute(p *Pipeline, initialInput map[string]interface{}) (*PipelineResult, error) {\r\n\u001b[?2004l\r"]
