[4214.690834, "o", "   264\t\t\tcsv := \"\"\r\n   265\t\t\tfor i, v := range data {\r\n   266\t\t\t\tif i > 0 {\r\n   267\t\t\t\t\tcsv += \",\"\r\n   268\t\t\t\t}\r\n   269\t\t\t\tcsv += fmt.Sprintf(\"%v\", v)\r\n   270\t\t\t}\r\n   271\t\t\treturn map[string]interface{}{\r\n   272\t\t\t\t\"format\":  \"csv\",\r\n   273\t\t\t\t\"content\": csv,\r\n   274\t\t\t\t\"data\":    data,\r\n   275\t\t\t}, nil\r\n   276\t\r\n   277\t\tdefault:\r\n"]
[4214.690916, "o", "   278\t\t\treturn nil, fmt.Errorf(\"export: unknown format %q\", format)\r\n   279\t\t}\r\n   280\t}\r\n   281\t\r\n   282\t// ExecuteFilter selects elements from the data array based on a comparison condition.\r\n   283\t// Supported modes: gt, lt, gte, lte, eq, ne.\r\n   284\tfunc ExecuteFilter(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   285\t\tdata, ok := input[\"data\"].([]interface{})\r\n   286\t\tif !ok {\r\n"]
[4214.690977, "o", "   287\t\t\treturn nil, fmt.Errorf(\"filter: missing or invalid 'data' field in input\")\r\n   288\t\t}\r\n   289\t\r\n   290\t\tmode, _ := config[\"mode\"].(string)\r\n   291\t\tif mode == \"\" {\r\n   292\t\t\treturn nil, fmt.Errorf(\"filter: missing 'mode' in config\")\r\n   293\t\t}\r\n   294\t\tthreshold, _ := config[\"threshold\"].(float64)\r\n   295\t\r\n   296\t\tvar result []interface{}\r\n"]
[4214.691039, "o", "   297\t\tfor _, v := range data {\r\n   298\t\t\tval, err := toFloat(v)\r\n   299\t\t\tif err != nil {\r\n   300\t\t\t\tcontinue\r\n   301\t\t\t}\r\n   302\t\t\tvar keep bool\r\n   303\t\t\tswitch mode {\r\n   304\t\t\tcase \"gt\":\r\n"]
[4214.691109, "o", "   305\t\t\t\tkeep = val > threshold\r\n   306\t\t\tcase \"lt\":\r\n   307\t\t\t\tkeep = val < threshold\r\n   308\t\t\tcase \"gte\":\r\n   309\t\t\t\tkeep = val >= threshold\r\n   310\t\t\tcase \"lte\":\r\n   311\t\t\t\tkeep = val <= threshold\r\n   312\t\t\tcase \"eq\":\r\n   313\t\t\t\tkeep = val == threshold\r\n   314\t\t\tcase \"ne\":"]
[4214.691173, "o", "\r\n   315\t\t\t\tkeep = val != threshold\r\n   316\t\t\tdefault:\r\n   317\t\t\t\treturn nil, fmt.Errorf(\"filter: unknown mode %q\", mode)\r\n   318\t\t\t}\r\n   319\t\t\tif keep {\r\n   320\t\t\t\tresult = append(result, val)\r\n   321\t\t\t}\r\n   322\t\t}\r\n   323"]
[4214.691236, "o", "\t\r\n   324\t\tif result == nil {\r\n   325\t\t\tresult = []interface{}{}\r\n   326\t\t}\r\n   327\t\treturn map[string]interface{}{\"data\": result}, nil\r\n   328\t}\r\n   329\t\r\n   330\t// Helper functions\r\n   331\t\r\n"]
[4214.6913, "o", "   332\tfunc toFloat(v interface{}) (float64, error) {\r\n   333\t\tswitch val := v.(type) {\r\n   334\t\tcase float64:\r\n   335\t\t\t"]
[4214.691367, "o", "return val, nil\r\n   336\t\tcase int:\r\n   337\t\t\treturn float64(val), nil\r\n   338\t\tcase int64:\r\n   339\t\t\treturn float64(val), nil\r\n   340\t\tdefault:\r\n   341\t\t\treturn 0, fmt.Errorf(\"cannot convert %T to float64\", v)\r\n   342\t\t}\r\n   343\t}\r\n   344\t\r\n   345\tfunc findMinMax(data []interface{}) (float64, float64) {\r\n   346\t\tif len(data) == 0 {\r\n   347\t\t\treturn 0, 0\r\n   348\t\t}\r\n   349\t\tminVal, _ := toFloat(data[0])\r\n   350\t\tmaxVal := minVal\r\n"]
[4214.691423, "o", "   351\t\tfor _, v := range data[1:] {\r\n   352\t\t\tval, err := toFloat(v)\r\n   353\t\t\tif err != nil {\r\n   354\t\t\t\tcontinue\r\n   355\t\t\t}\r\n   356\t\t\tif val < minVal {\r\n   357\t\t\t\tminVal = val\r\n   358\t"]
[4214.691478, "o", "\t\t}\r\n   359\t\t\tif val > maxVal {\r\n   360\t\t\t\tmaxVal = val\r\n"]
