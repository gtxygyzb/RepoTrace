[5606.06051, "o", "package registry\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n"]
[5606.060622, "o", "\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"sort\""]
[5606.060696, "o", "\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\n// Stage represents the lifecycle stage of a model version.\r\ntype Stage string\r\n\r\nconst (\r\n\tStageDevelopment Stage = \"development\"\r\n\tStageStaging     Stage = \"staging\"\r\n\tStageProduction  Stage = \"production\"\r\n\tStageArchived    Stage = \"archived\"\r\n)\r\n\r\nvar validTransitions = map[Stage][]Stage{\r\n\tStageDevelopment: {StageStaging, StageArchived},\r\n\tStageStaging:     {StageProduction, StageArchived},\r\n\tStageProduction:  {StageArchived},\r\n\tStageArchived:    {},\r\n}\r\n\r\n// PromotionRecord records a single stage transition in a version's lineage.\r\ntype PromotionRecord struct {\r\n\tFromStage Stage  `json:\"from_stage\"`\r\n\tToStage   Stage  `json:\"to_stage\"`\r\n\tTimestamp string `json:\"timestamp\"`\r\n}\r\n\r\n// Version represents a specific version of a model.\r\ntype Version struct {\r\n"]
[5606.060776, "o", "\tNumber      int                    `json:\"number\"`\r\n\tStage       Stage                  `json:\"stage\"`\r\n\tMetrics     map[string]float64     `json:\"metrics\"`\r\n\tTags        []string               `json:\"tags\"`\r\n\tModelConfig map[string]interface{} `json:\"model_config,omitempty\"`\r\n\tCreatedAt   time.Time              `json:\"created_at\"`\r\n\tLineage     []PromotionRecord      `json:\"lineage\"`\r\n\tDemotedBy   int                    `json:\"demoted_by,omitempty\"`\r\n}\r\n\r\n// Model represents a registered ML model.\r\ntype Model struct {\r\n\tName         string     `json:\"name\"`\r\n\tFramework    string     `json:\"framework\"`\r\n\tDescription  string     `json:\"description\"`\r\n\tTags         []string   `json:\"tags\"`\r\n"]
[5606.060841, "o", "\tVersions     []*Version `json:\"versions\"`\r\n\tDependencies []string   `json:\"dependencies\"`\r\n\tCreatedAt    time.Time  `json:\"created_at\"`\r\n\tUpdatedAt    time.Time  `json:\"updated_at\"`\r\n}\r\n\r\n// ModelFilter defines filtering criteria for listing models.\r\ntype ModelFilter struct {\r\n\tFramework string\r\n\tTag       string\r\n}\r\n\r\n// Annotation represents a key-value annotation attached to a model version.\r\n"]
[5606.061192, "o", "type Annotation struct {\r\n\tKey       string    `json:\"key\"`\r\n\tValue     string    `json:\"value\"`\r\n\tCreatedAt time.Time `json:\"created_at\"`\r\n}\r\n\r\nvar annotationKeyRegexp = regexp.MustCompile(`^[A-Za-z0-9_]+$`)\r\n\r\n// Registry manages model registration, versioning, and lifecycle.\r\ntype Registry struct {\r\n\tmu           sync.RWMutex\r\n\tmodels       map[string]*Model\r\n\tdataDir      string\r\n\tannotations  map[string]map[int]map[string]*Annotation\r\n\tdependencies map[string][]string\r\n}\r\n\r\n// NewRegistry creates a new Registry backed by the given data directory.\r\nfunc NewRegistry(dataDir string) (*Registry, error) {\r\n\tif err := os.MkdirAll(dataDir, 0755); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"create data dir: %w\", err)\r\n\t}\r\n\tr := &Registry{\r\n\t\tmodels:       make(map[string]*Model),\r\n\t\tdataDir:      dataDir,\r\n\t\tannotations:  make(map[string]map[int]map[string]*Annotation),\r\n\t\tdependencies: make(map[string][]string),\r\n\t}\r\n\tif err := r.loadAll(); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"load registry: %w\", err)\r\n\t}\r\n\tretu"]
[5606.061237, "o", "rn r, nil\r\n}\r\n\r\n// RegisterModel creates a new model entry in the registry.\r\nfunc (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tif _, exists := r.models[name]; exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q already exists\", name)\r\n\t}\r\n\r\n\tnow := time.Now()\r\n\tif tags == nil {\r\n\t\ttags = []string{}\r\n\t}\r\n\tmodel := &Model{\r\n\t\tName:         name,\r\n\t\tFramework:    framework,\r\n\t\tDescription:  description,\r\n\t\tTags:         tags,\r\n\t\tVersions:     make([]*Version, 0),\r\n\t\tDependencies: []string{},\r\n\t\tCreatedAt:    now,\r\n\t\tUpdatedAt:    now,\r\n\t}\r\n\tr.models[name] = model\r\n\tr.dependencies[name] = []string{}\r\n\tif err := r.saveModel(model); err != nil {\r\n\t\tdelete(r.models, name)\r\n\t\t"]
[5606.061417, "o", "return nil, err\r\n\t}\r\n\treturn model, nil\r\n}\r\n\r\n// CreateVersion adds a new version to the specified model.\r\nfunc (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tnextNum := 1\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Number >= nextNum {\r\n\t\t\tnextNum = v.Number + 1\r\n\t\t}\r\n\t}\r\n\r\n\tif tags == nil {\r\n\t\ttags = []string{}\r\n\t}\r\n\tversion := &Version{\r\n\t\tNumber:      nextNum,\r\n\t\tStage:       StageDevelopment,\r\n\t\tMetrics:     metrics,\r\n\t\tTags:        tags,\r\n"]
[5606.061631, "o", "\t\tModelConfig: modelConfig,\r\n\t\tCreatedAt:   time.Now(),\r\n\t\tLineage:     []PromotionRecord{},\r\n\t}\r\n\tmodel.Versions = append(model.Versions, version)\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\tif err := r.saveModel(model); err != nil {\r\n\t\tmodel.Versions = model.Versions[:len(model.Versions)-1]\r\n"]
[5606.061725, "o", "\t\treturn nil, err\r\n\t}\r\n\treturn version, nil\r\n}\r\n\r\n// PromoteVersion transitions a model version to the specified stage.\r\nfunc (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {\r\n\tr.mu.Lock()\r\n\tdefer r.mu.Unlock()\r\n\r\n\tmodel, exists := r.models[modelName]\r\n\tif !exists {\r\n\t\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n\t}\r\n\r\n\tvar version *Version\r\n\tfor _, v := range model.Versions {\r\n\t\tif v.Number == versionNum {\r\n\t\t\tversion = v\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif version == nil {\r\n\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n\t}\r\n\r\n\t// Validate stage transition\r\n\tallowed := validTransitions[version.Stage]\r\n\tvalid := false\r\n\tfor _, s := range allowed {\r\n\t\tif s == targetStage {\r\n\t\t\tvalid = true\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif !valid {\r\n\t\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n\t}\r\n\r\n\tpromotionTime := time.Now().UTC().Format(time.RFC3339)\r\n\r\n\t// If promoting to production, demote current production version."]
[5606.061836, "o", "\r\n\tif targetStage == StageProduction {\r\n\t\tfor _, v := range model.Versions {\r\n\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n\t\t\t\tif v.Lineage == nil {\r\n\t\t\t\t\tv.Lineage = []PromotionRecord{}\r\n\t\t\t\t}\r\n\t\t\t\tv.Lineage = append(v.Lineage, PromotionRecord{\r\n\t\t\t\t\tFromStage: StageProduction,\r\n\t\t\t\t\tToStage:   StageStaging,\r\n\t\t\t\t\tTimestamp: promotionTime,\r\n\t\t\t\t})\r\n\t\t\t\tv.DemotedBy = versionNum\r\n\t\t\t\tv.Stage = StageStaging\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif version.Lineage == nil {\r\n\t\tversion.Lineage = []PromotionRecord{}\r\n\t}\r\n\tversion.Lineage = append(version.Lineage, PromotionRecord{\r\n\t\tFromStage: version.Stage,\r\n\t\tToStage:   targetStage,\r\n\t\tTimestamp: promotionTime,\r\n"]
[5606.061934, "o", "\t})\r\n\tversion.Stage = targetStage\r\n\tmodel.UpdatedAt = time.Now()\r\n\r\n\treturn r.saveModel(model)\r\n}\r\n\r\n// GetModel returns a model with its versions sorted by version number descending.\r\nfunc (r *Registry) GetModel(name string) (*Model, error) {\r\n\tr.mu.RLock()\r\n\tdefer r.mu.RUnlock()\r\n\r\n\tmodel, exists := r.models[name]\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q not found\", name)\r\n\t}\r\n\r\n"]
[5606.062055, "o", "\t// Return a copy with versions sorted\r\n\tresult := *model\r\n\tresult.Versions = make([]*Version, len(model.Versions))\r\n\tcopy(result.Versions, model.Versions)\r\n\tsort.Slice(result.Versions, func(i, j int) bool {\r\n\t\treturn result.Versions[i].Number > result.Versions[j].Number\r\n\t})\r\n\treturn &result, nil\r\n}\r\n"]
