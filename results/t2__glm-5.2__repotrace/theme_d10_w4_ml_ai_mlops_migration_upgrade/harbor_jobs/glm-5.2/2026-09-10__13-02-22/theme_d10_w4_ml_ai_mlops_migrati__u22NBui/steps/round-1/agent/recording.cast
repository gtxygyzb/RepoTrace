[183.031228, "o", "\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (r *Registry) PromoteVersion\u001b[m\u001b[K(modelName string, versionNum int, targetStage Stage) error {\r\n\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tr.mu.Lock()\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer r.mu.Unlock()\r\n"]
[183.03136, "o", "\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmodel, exists := r.models[modelName]\r\n"]
[183.031463, "o", "\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif !exists {\r\n\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn fmt.Errorf(\"model %q not found\", modelName)\r\n\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar version *Version\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, v := range model.Versions {\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif v.Number == versionNum {\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tversion = v\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tbreak\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif version == nil {\r\n\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn fmt.Errorf(\"version %d not found for model %q\", versionNum, modelName)\r\n\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K162\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t// Validate stage transition\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tallowed := validTransitions[version.Stage]\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvalid := false\r\n"]
[183.031589, "o", "\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, s := range allowed {\r\n\u001b[32m\u001b[K166\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif s == targetStage {\r\n\u001b[32m\u001b[K167\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tvalid = true\r\n\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tbreak\r\n\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K170\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K171\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif !valid {\r\n\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn fmt.Errorf(\"invalid stage transition from %s to %s\", version.Stage, targetStage)\r\n\u001b[32m\u001b[K173\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K174\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K175\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t// If promoting to production, demote current production version\r\n\u001b[32m\u001b[K176\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif targetStage == StageProduction {\r\n\u001b[32m\u001b[K177\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tfor _, v := range model.Versions {\r\n\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif v.Stage == StageProduction && v.Number != versionNum {\r\n\u001b[32m\u001b[K179\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tv.Stage = StageArchived\r\n"]
[183.031702, "o", "\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K181\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tversion.Stage = targetStage\r\n\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmodel.UpdatedAt = time.Now()\r\n"]
[183.031773, "o", "\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn r.saveModel(model)\r\n"]
