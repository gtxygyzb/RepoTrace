[184.141494, "o", "\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tpipelineStart := time.Now()\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tresult := &PipelineResult{\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tPipelineName: p.Name,\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tStatus:       \"success\",\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t"]
[184.141603, "o", "Steps:        make([]*StepResult, 0, len(ordered)),\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tstepOutputs := make(map[string]map[string]interface{})\r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar lastOutput map[string]interface{}\r\n\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, step := range ordered {\r\n\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tstepStart := time.Now()\r\n\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t// Determine input for this step\r\n\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tvar input map[string]interface{}\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif len(step.Dependencies) == 0 {\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tinput = initialInput\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t} else {\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tinput = lastOutput\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t// Find and run the executor\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\texecutor, ok := e.stepExecutors[ste"]
