[1442.624935, "o", "\u0007"]
[1442.625379, "o", "SetVars         map[string]string      `json:\"set_vars,omitempty\"`\r\n\u001b[?2004l\r"]
[1442.625427, "o", "\u001b[?2004h> "]
[1442.625506, "o", "\u0007"]
[1442.626035, "o", "OutputTransform string                 `json:\"output_transform,omitempty\"`\r\n\u001b[?2004l\r"]
[1442.626098, "o", "\u001b[?2004h> }\r\n"]
[1442.626148, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1442.626196, "o", "> \r\n\u001b[?2004l\r"]
[1442.626246, "o", "\u001b[?2004h> "]
[1442.626655, "o", "// Pipeline defines a named sequence of dependent steps.\r\n\u001b[?2004l\r"]
[1442.626707, "o", "\u001b[?2004h"]
[1442.626757, "o", "> "]
[1442.626898, "o", "type Pipeline struct {\r\n\u001b[?2004l\r"]
[1442.626946, "o", "\u001b[?2004h> "]
[1442.627023, "o", "\u0007"]
[1442.627221, "o", "Name  string  `json:\"name\"`\r\n\u001b[?2004l\r"]
[1442.627269, "o", "\u001b[?2004h> "]
[1442.627337, "o", "\u0007"]
[1442.62754, "o", "Steps []*Step `json:\"steps\"`\r\n\u001b[?2004l\r"]
[1442.627589, "o", "\u001b[?2004h> "]
[1442.627636, "o", "}\r\n\u001b[?2004l\r"]
[1442.627682, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1442.627728, "o", "\u001b[?2004h> "]
[1442.628161, "o", "// StepResult records the outcome of executing a single step.\r\n\u001b[?2004l\r"]
[1442.628216, "o", "\u001b[?2004h> "]
[1442.628398, "o", "type StepResult struct {\r\n\u001b[?2004l\r"]
