[2175.281685, "i", "sed -n '1,240p' internal/api/templates.go\n"]
[2175.282067, "o", "sed -n '1,240p' internal/api/templates.go\r\n"]
[2175.282173, "o", "\u001b[?2004l\r"]
[2175.284997, "o", "package api\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[2175.285066, "o", "\t\"net/http\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\t\"time\"\r\n\r\n\t\"gomlops/internal/pipeline\"\r\n)\r\n\r\n"]
[2175.28513, "o", "type TemplateParameter struct {\r\n\tName    string      `json:\"name\"`\r\n\tType    string      `json:\"type\"`\r\n\tDefault interface{} `json:\"default,omitempty\"`\r\n}\r\n\r\ntype Template struct {\r\n\tName        string              `json:\"name\"`\r\n\t"]
[2175.285194, "o", "Description string              `json:\"description\"`\r\n\tParameters  []TemplateParameter `json:\"parameters\"`\r\n\tPipeline    *pipeline.Pipeline  `json:\"pipeline\"`\r\n\tCreatedAt   time.Time           `json:\"created_at\"`\r\n\tUpdatedAt   *time.Time          `json:\"updated_at\"`\r\n}\r\n\r\ntype TemplateStore struct {\r\n\t"]
[2175.285258, "o", "mu        sync.RWMutex\r\n\ttemplates map[string]*Template\r\n}\r\n\r\nfunc NewTemplateStore() *TemplateStore {\r\n\treturn &TemplateStore{templates: make(map[string]*Template)}\r\n}\r\n\r\nvar templateNameRe = regexp.MustCompile(`^[a-zA-Z0-9_-]+$`)\r\n\r\nfunc validateTemplateName(name string) bool {\r\n"]
[2175.285321, "o", "\treturn len(name) > 0 && len(name) <= 64 && templateNameRe.MatchString(name)\r\n}\r\n\r\nfunc (s *TemplateStore) Get(name string) (*Template, bool) {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\tt, ok := s.templates[name]\r\n\treturn t, ok\r\n}\r\n\r\n"]
[2175.28538, "o", "func (s *TemplateStore) List(sortBy string) []*Template {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\tresult := make([]*Template, 0, len(s.templates))\r\n\tfor _, t := range s.templates {\r\n\t\tresult = append(result, t)\r\n\t}\r\n"]
[2175.285437, "o", "\tif sortBy == \"created_at\" {\r\n\t\tsort.Slice(result, func(i, j int) bool {\r\n\t\t\treturn result[i].CreatedAt.Before(result[j].CreatedAt)\r\n\t\t})\r\n\t} else {\r\n\t\tsort.Slice(result, func(i, j int) bool {\r\n"]
[2175.285502, "o", "\t\t\treturn result[i].Name < result[j].Name\r\n\t\t})\r\n\t}\r\n\treturn result\r\n}\r\n\r\nfunc (s *TemplateStore) Create(t *Template) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\t"]
[2175.285563, "o", "if _, exists := s.templates[t.Name]; exists {\r\n\t\treturn fmt.Errorf(\"template %q already exists\", t.Name)\r\n\t}\r\n\tt.CreatedAt = time.Now()\r\n\tt.UpdatedAt = nil\r\n\ts.templates[t.Name] = t\r\n\treturn nil\r\n}\r\n\r\n"]
[2175.285619, "o", "func (s *TemplateStore) Update(t *Template) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\tif _, exists := s.templates[t.Name]; !exists {\r\n\t\treturn fmt.Errorf(\"template %q not found\", t.Name)\r\n\t}\r\n\tnow := time.Now()\r\n\tt.UpdatedAt = &now\r\n\ts.templates[t.Name] = t\r\n\treturn nil\r\n"]
[2175.285681, "o", "}\r\n\r\nfunc (s *TemplateStore) Delete(name string) error {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\tif _, exists := s.templates[name]; !exists {\r\n\t\treturn fmt.Errorf(\"template %q not found\", name)\r\n\t}\r\n"]
[2175.285739, "o", "\tdelete(s.templates, name)\r\n\treturn nil\r\n}\r\n\r\nfunc (h *Handlers) CreateTemplate(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tName        string              `json:\"name\"`\r\n\t\tDescription string              `json:\"description\"`\r\n"]
[2175.285796, "o", "\t\tParameters  []TemplateParameter `json:\"parameters\"`\r\n\t\tPipeline    *pipeline.Pipeline  `json:\"pipeline\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n"]
[2175.285862, "o", "\tif !validateTemplateName(req.Name) {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid template name\")\r\n\t\treturn\r\n\t}\r\n\tif req.Pipeline == nil || len(req.Pipeline.Steps) == 0 {\r\n"]
[2175.285926, "o", "\t\twriteError(w, http.StatusBadRequest, \"pipeline with at least one step is required\")\r\n\t\treturn\r\n\t}\r\n\tparams := req.Parameters\r\n\tif params == nil {\r\n\t\tparams = []TemplateParameter{}\r\n\t}\r\n\tif err := validateParameters(params); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n"]
[2175.285989, "o", "\t\treturn\r\n\t}\r\n\ttmpl := &Template{\r\n\t\tName:        req.Name,\r\n\t\tDescription: req.Description,\r\n\t\tParameters:  params,\r\n\t\tPipeline:    req.Pipeline,\r\n\t}\r\n\tif err := h.Templates.Create(tmpl); err != nil {"]
[2175.286063, "o", "\r\n\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, templateResponse(tmpl))\r\n}\r\n\r\nfunc (h *Handlers) ListTemplates(w http.ResponseWriter, r *http.Request) {\r\n\tsortBy := r.URL.Query().Get(\"sort\")\r\n\t"]
[2175.286119, "o", "writeJSON(w, http.StatusOK, templateListResponse(h.Templates.List(sortBy)))\r\n}\r\n\r\nfunc (h *Handlers) GetTemplate(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\ttmpl, ok := h.Templates.Get(name)\r\n\tif !ok {\r\n"]
[2175.286175, "o", "\t\twriteError(w, http.StatusNotFound, \"template %q not found\", name)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, templateResponse(tmpl))\r\n}\r\n\r\nfunc (h *Handlers) UpdateTemplate(w http.ResponseWriter, r *http.Request) {\r\n"]
[2175.286234, "o", "\tname := r.PathValue(\"name\")\r\n\ttmpl, ok := h.Templates.Get(name)\r\n\tif !ok {\r\n\t\twriteError(w, http.StatusNotFound, \"template %q not found\", name)\r\n\t\treturn\r\n\t}\r\n\tvar req struct {\r\n\t\tDescription *string              `json:\"description\"`\r\n\t\t"]
[2175.286294, "o", "Parameters  *[]TemplateParameter `json:\"parameters\"`\r\n\t\tPipeline    *pipeline.Pipeline   `json:\"pipeline\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\t"]
[2175.286356, "o", "updated := &Template{\r\n\t\tName:        tmpl.Name,\r\n\t\tDescription: tmpl.Description,\r\n\t\tParameters:  tmpl.Parameters,\r\n\t\tPipeline:    tmpl.Pipeline,\r\n\t\tCreatedAt:   tmpl.CreatedAt,\r\n"]
[2175.286412, "o", "\t}\r\n\tif req.Description != nil {\r\n\t\tupdated.Description = *req.Description\r\n\t}\r\n\tif req.Parameters != nil {\r\n\t\tif err := validateParameters(*req.Parameters); err != nil {\r\n"]
[2175.286467, "o", "\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\t\treturn\r\n\t\t}\r\n\t\tupdated.Parameters = *req.Parameters\r\n\t}\r\n\tif req.Pipeline != nil {\r\n\t\tif len(req.Pipeline.Steps) == 0 {\r\n"]
[2175.286522, "o", "\t\t\twriteError(w, http.StatusBadRequest, \"pipeline with at least one step is required\")\r\n\t\t\treturn\r\n\t\t}\r\n\t\tupdated.Pipeline = req.Pipeline\r\n\t}\r\n\tif err := h.Templates.Update(updated); err != nil {\r\n"]
[2175.286577, "o", "\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, templateResponse(updated))\r\n}\r\n\r\nfunc (h *Handlers) DeleteTemplate(w http.ResponseWriter, r *http.Request) {\r\n"]
[2175.286632, "o", "\tname := r.PathValue(\"name\")\r\n\tif err := h.Templates.Delete(name); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n}\r\n"]
[2175.286688, "o", "\r\nfunc (h *Handlers) ExecuteTemplate(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\ttmpl, ok := h.Templates.Get(name)\r\n\tif !ok {\r\n\t\twriteError(w, http.StatusNotFound, \"template %q not found\", name)\r\n\t\treturn\r\n"]
[2175.286743, "o", "\t}\r\n\tvar req struct {\r\n\t\tInput  map[string]interface{} `json:\"input\"`\r\n\t\tParams map[string]interface{} `json:\"params\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n"]
[2175.286804, "o", "\t\treturn\r\n\t}\r\n\tp, err := substituteParameters(tmpl, req.Params)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Input == nil {\r\n"]
[2175.286877, "o", "\t\treq.Input = make(map[string]interface{})\r\n\t}\r\n\tresult, err := h.Pipeline.Execute(p, req.Input)\r\n"]
[2175.287389, "o", "\u001b[?2004h"]
[2175.287444, "o", "root@n30009:/app# "]
[2175.736378, "i", "sed -n '1,220p' internal/api/handlers.go\n"]
[2175.736724, "o", "sed -n '1,220p' internal/api/handlers.go\r\n"]
[2175.736777, "o", "\u001b[?2004l\r"]
[2175.739581, "o", "package api\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"net/http\"\r\n"]
[2175.739672, "o", "\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\r\n\t\"gomlops/internal/pipeline\"\r\n\t\"gomlops/internal/registry\"\r\n\t\"gomlops/internal/serving\"\r\n)\r\n\r\n// --- Model Registry Handlers ---\r\n\r\nfunc (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tName        string   `json:\"name\"`\r\n\t\t"]
[2175.739751, "o", "Framework   string   `json:\"framework\"`\r\n\t\tDescription string   `json:\"description\"`\r\n\t\tTags        []string `json:\"tags\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Name == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"name is required\")\r\n\t\treturn\r\n"]
[2175.739813, "o", "\t}\r\n\r\n\tmodel, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, model)\r\n}\r\n\r\nfunc (h *Handlers) ListModels(w http.ResponseWriter, r *http.Request) {\r\n\tvar filter *registry.ModelFilter\r\n"]
[2175.739886, "o", "\tframework := r.URL.Query().Get(\"framework\")\r\n\ttag := r.URL.Query().Get(\"tag\")\r\n\tif framework != \"\" || tag != \"\" {\r\n\t\tfilter = &registry.ModelFilter{Framework: framework, Tag: tag}\r\n\t}\r\n\r\n\tmodels, err := h.Registry.ListModels(filter)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusInternalServerError, \"%v\", err)\r\n\t\treturn\r\n\t"]
[2175.739952, "o", "}\r\n\twriteJSON(w, http.StatusOK, models)\r\n}\r\n\r\nfunc (h *Handlers) DeleteModel(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\tif err := h.Registry.DeleteModel(name); err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\t_ = h.Serving.UnloadModel(name)\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n"]
[2175.740012, "o", "}\r\n\r\nfunc (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\tmodel, err := h.Registry.GetModel(name)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n"]
[2175.740071, "o", "\twriteJSON(w, http.StatusOK, model)\r\n}\r\n\r\nfunc (h *Handlers) CreateVersion(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\r\n\tvar req struct {\r\n\t\tMetrics     map[string]float64     `json:\"metrics\"`\r\n\t\tTags        []string               `json:\"tags\"`\r\n\t\t"]
[2175.740134, "o", "ModelConfig map[string]interface{} `json:\"model_config\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\r\n\tversion, err := h.Registry.CreateVersion(modelName, req.Metrics, req.Tags, req.ModelConfig)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t"]
[2175.740193, "o", "\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, version)\r\n}\r\n\r\nfunc (h *Handlers) GetVersion(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\tnumStr := r.PathValue(\"num\")\r\n\tnum, err := strconv.Atoi(numStr)\r\n\tif err != nil {\r\n\t"]
[2175.740251, "o", "\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\t\treturn\r\n\t}\r\n\r\n\tversion, err := h.Registry.GetVersion(modelName, num)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n"]
[2175.740309, "o", "\twriteJSON(w, http.StatusOK, version)\r\n}\r\n\r\nfunc (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\tnumStr := r.PathValue(\"num\")\r\n\tnum, err := strconv.Atoi(numStr)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\t\treturn\r\n\t"]
[2175.74037, "o", "}\r\n\r\n\tvar req struct {\r\n\t\tStage string `json:\"stage\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Stage == \"\" {\r\n"]
[2175.740427, "o", "\t\twriteError(w, http.StatusBadRequest, \"stage is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tif err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"promoted\"})\r\n}\r\n"]
[2175.740497, "o", "\r\n// --- Pipeline Handlers ---\r\n\r\nfunc (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tName     string                 `json:\"name\"`\r\n\t\tSteps    []*pipeline.Step       `json:\"steps\"`\r\n\t\tInput    map[string]interface{} `json:\"input\"`\r\n\t\tPipeline *pipeline.Pipeline     `json:\"pipeline\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)"]
[2175.740559, "o", "\r\n\t\treturn\r\n\t}\r\n\tp := req.Pipeline\r\n\tif p == nil {\r\n\t\tp = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}\r\n\t}\r\n\tif p == nil || len(p.Steps) == 0 {\r\n\t\twriteError(w, http.StatusBadRequest, \"pipeline with at least one step is required\")\r\n\t"]
[2175.740658, "o", "\treturn\r\n\t}\r\n\tif req.Input == nil {\r\n\t\treq.Input = make(map[string]interface{})\r\n\t}\r\n\r\n\tresult, err := h.Pipeline.Execute(p, req.Input)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, result)\r\n}\r\n\r\n// --- Experiment Handlers ---\r\n\r\nfunc (h *Handlers) CreateExperiment(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tName string `json:\"name\"`\r\n\t"]
[2175.740719, "o", "}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Name == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"name is required\")\r\n\t\treturn\r\n\t}\r\n\r\n"]
[2175.740776, "o", "\texp, err := h.Experiment.CreateExperiment(req.Name)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, exp)\r\n}\r\n\r\nfunc (h *Handlers) ListExperiments(w http.ResponseWriter, r *http.Request) {\r\n"]
[2175.740836, "o", "\texps := h.Experiment.ListExperiments()\r\n\twriteJSON(w, http.StatusOK, exps)\r\n}\r\n\r\nfunc (h *Handlers) GetExperiment(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\texp, err := h.Experiment.GetExperiment(name)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n"]
[2175.740918, "o", "\t}\r\n\twriteJSON(w, http.StatusOK, exp)\r\n}\r\n\r\nfunc (h *Handlers) LogRun(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\r\n\tvar req struct {\r\n\t\tParameters map[string]float64 `json:\"parameters\"`"]
[2175.740977, "o", "\r\n\t\tMetrics    map[string]float64 `json:\"metrics\"`\r\n"]
