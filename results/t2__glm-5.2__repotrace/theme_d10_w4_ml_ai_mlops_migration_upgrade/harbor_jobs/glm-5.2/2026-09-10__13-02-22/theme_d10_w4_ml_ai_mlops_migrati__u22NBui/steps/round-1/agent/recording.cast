[5714.175746, "o", "    67\t\r\n    68\t// Annotation represents a key-value annotation attached to a model version.\r\n    69\ttype Annotation struct {\r\n    70\t\tKey       string    `json:\"key\"`\r\n    71\t\tValue     string    `json:\"value\"`\r\n    72\t\tCreatedAt time.Time `json:\"created_at\"`\r\n    73\t}\r\n    74\t\r\n    75\tvar annotationKeyRegexp = regexp.MustCompile(`^[A-Za-z0-9_]+$`)\r\n    76\t\r\n    77\t// Registry manages model registration, versioning, and lifecycle.\r\n    78\ttype Registry struct {\r\n    79\t\tmu           sync.RWMutex\r\n    80\t\tmodels       map[string]*Model\r\n    81\t\tdataDir      string\r\n    82\t"]
[5714.175816, "o", "\tannotations  map[string]map[int]map[string]*Annotation\r\n    83\t\tdependencies map[string][]string\r\n    84\t}\r\n    85\t\r\n    86\t// NewRegistry creates a new Registry backed by the given data directory.\r\n    87\tfunc NewRegistry(dataDir string) (*Registry, error) {\r\n    88\t\tif err := os.MkdirAll(dataDir, 0755); err != nil {\r\n    89\t\t\treturn nil, fmt.Errorf(\"create data dir: %w\", err)\r\n    90\t\t}\r\n    91\t\tr := &Registry{\r\n"]
