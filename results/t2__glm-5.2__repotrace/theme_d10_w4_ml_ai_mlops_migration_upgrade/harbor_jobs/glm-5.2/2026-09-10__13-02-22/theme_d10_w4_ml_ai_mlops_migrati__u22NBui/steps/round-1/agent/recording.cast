[2984.752631, "o", "     1\tpackage serving\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"sync\"\r\n     6\t\t\"time\"\r\n     7\t\r\n     8\t\t\"gomlops/internal/registry\""]
[2984.752744, "o", "\r\n     9\t)\r\n    10\t\r\n    11\t// LoadedModel tracks a model version currently loaded for serving.\r\n    12\ttype LoadedModel struct {\r\n    13\t\tModelName   string                 `json:\"model_name\"`\r\n    14\t\tVersionNum  int                    `json:\"version_num\"`\r\n    15\t\tStage       registry.Stage         `json:\"stage\"`\r\n    16\t\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n    17\t\tLoadedAt    time.Time              `json:\"loaded_at\"`\r\n    18\t}\r\n    19\t\r\n    20\t// InferenceRequest contains the input data for model inference.\r\n    21\ttype InferenceRequest struct {\r\n    22\t\tModelName string    `json:\"model_name\"`\r\n    23\t\tInput     []float64 `json:\"input\"`\r\n"]
[2984.752823, "o", "    24\t}\r\n    25\t\r\n    26\t// InferenceResponse contains the model prediction results.\r\n    27\ttype InferenceResponse struct {\r\n    28\t\tModelName   string    `json:\"model_name\"`\r\n    29\t\tVersion     int       `json:\"version\"`\r\n    30\t\tPredictions []float64 `json:\"predictions\"`\r\n    31\t\tLatencyMs   float64   `json:\"latency_ms\"`\r\n    32\t}\r\n    33\t\r\n    34\t// Server manages model loading and inference.\r\n    35\ttype Server struct {"]
[2984.752972, "o", "\r\n    36\t\tmu       sync.RWMutex\r\n    37\t\tloaded   map[string]*LoadedModel\r\n    38\t\tregistry *registry.Registry\r\n    39\t}\r\n    40\t\r\n    41\t// NewServer creates a new serving server backed by the given registry.\r\n    42\tfunc NewServer(reg *registry.Registry) *Server {\r\n    43\t\treturn &Server{\r\n    44\t\t\tloaded:   make(map[string]*LoadedModel),\r\n    45\t\t\tregistry: reg,\r\n    46\t\t}\r\n    47\t}\r\n    48\t\r\n    49\t// LoadModel loads a model version for serving. Specify either versionNum > 0\r\n    50\t// or a non-empty stage string (not both).\r\n    51\tfunc (s *Server) LoadModel(modelName string, versionNum int, stage string) error {\r\n    52\t\tvar version *registry.Version\r\n"]
[2984.753097, "o", "    53\t\tvar err error\r\n    54\t\r\n    55\t\tif versionNum > 0 {\r\n    56\t\t\tversion, err = s.registry.GetVersion(modelName, versionNum)\r\n    57\t\t} else if stage != \"\" {\r\n    58\t\t\tversion, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))\r\n    59\t\t} else {\r\n    60\t\t\treturn fmt.Errorf(\"must specify version number or stage\")\r\n    61\t\t}\r\n    62\t\r\n    63\t\tif err != nil {\r\n    64\t\t\treturn fmt.Errorf(\"load model: %w\", err)\r\n    65\t\t}\r\n    66\t\r\n    67\t\ts.mu.Lock()\r\n    68\t\tdefer s.mu.Unlock()\r\n    69\t\r\n    70\t\ts.loaded[modelName] = &LoadedModel{\r\n"]
[2984.753168, "o", "    71\t\t\tModelName:   modelName,\r\n    72\t\t\tVersionNum:  version.Number,\r\n    73\t\t\tStage:       version.Stage,\r\n    74\t\t\tModelConfig: version.ModelConfig,\r\n    75\t\t\tLoadedAt:    time.Now(),\r\n"]
[2984.753234, "o", "    76\t\t}\r\n    77\t\treturn nil\r\n    78\t}\r\n    79\t\r\n    80\t// UnloadModel removes a model from the serving cache.\r\n    81\tfunc (s *Server) UnloadModel(modelName string) error {\r\n    82\t\ts.mu.Lock()\r\n    83\t\tdefer s.mu.Unlock()\r\n    84\t\r\n    85\t\tif _, exists := s.loaded[modelName]; !exists {\r\n    86\t\t\treturn fmt.Errorf(\"model %q is not loaded\", modelName)\r\n    87\t\t}\r\n    88\t\tdelete(s.loaded, modelName)\r\n    89\t\treturn nil\r\n    90"]
[2984.753293, "o", "\t}\r\n    91\t\r\n    92\t// Infer runs inference on the loaded model and returns predictions.\r\n    93\tfunc (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {\r\n    94\t\tstart := time.Now()\r\n    95\t\r\n    96\t\ts.mu.RLock()\r\n    97\t\tloaded, exists := s.loaded[req.ModelName]\r\n    98\t\ts.mu.RUnlock()\r\n"]
[2984.753351, "o", "    99\t\r\n   100\t\tif !exists {\r\n   101\t\t\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", req.ModelName)\r\n   102\t\t}\r\n   103\t\r\n   104\t\tpredictions, err := computePrediction(loaded.ModelConfig, req.Input)\r\n   105\t\tif err != nil {\r\n"]
[2984.753411, "o", "   106\t\t\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n   107\t\t}\r\n   108\t\r\n   109\t\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n   110\t\r\n   111\t\treturn &InferenceResponse{\r\n   112\t\t"]
[2984.753471, "o", "\tModelName:   req.ModelName,\r\n   113\t\t\tVersion:     loaded.VersionNum,\r\n   114\t\t\tPredictions: predictions,\r\n   115\t\t\tLatencyMs:   latency,\r\n   116\t\t}, nil\r\n   117\t}\r\n   118\t\r\n   119\t// ListLoaded returns all currently loaded models.\r\n   120\tfunc (s *Server) ListLoaded() []*LoadedModel {\r\n"]
[2984.753529, "o", "   121\t\ts.mu.RLock()\r\n   122\t\tdefer s.mu.RUnlock()\r\n   123\t\r\n   124\t\tresult := make([]*LoadedModel, 0, len(s.loaded))\r\n   125\t\tfor _, lm := range s.loaded {\r\n   126\t\t\tresult = append(result, lm)\r\n   127\t\t}\r\n"]
[2984.753589, "o", "   128\t\treturn result\r\n   129\t}\r\n   130\t\r\n   131\t// computePrediction evaluates a model against input data.\r\n   132\t// Supported model types: linear, polynomial.\r\n   133\tfunc computePrediction(modelConfig map[string]interface{}, input []float64) ([]float64, error) {\r\n   134\t\tif modelConfig == nil {\r\n   135\t\t\treturn nil, fmt.Errorf(\"model has no configuration\")\r\n"]
[2984.753655, "o", "   136\t\t}\r\n   137\t\r\n   138\t\tmodelType, _ := modelConfig[\"model_type\"].(string)\r\n   139\t\tswitch modelType {\r\n   140\t\tcase \"linear\":\r\n   141\t\t\treturn linearPredict(modelConfig, input)\r\n   142\t\tcase \"polynomial\":\r\n   143\t\t\treturn polynomialPredict(modelConfig, input)\r\n   144\t\tdefault:\r\n   145\t\t\treturn nil, fmt.Errorf(\"unsupported model type: %s\", modelType)\r\n   146"]
[2984.753713, "o", "\t\t}\r\n   147\t}\r\n   148\t\r\n   149\t// linearPredict computes y = sum(weights[i] * input[i]) + bias\r\n   150\tfunc linearPredict(config map[string]interface{}, input []float64) ([]float64, error) {\r\n   151\t\tweightsRaw, ok := config[\"weights\"].([]interface{})\r\n   152\t\tif !ok {\r\n   153\t\t\treturn nil, fmt.Errorf(\"linear model missing weights\")\r\n"]
[2984.75378, "o", "   154\t\t}\r\n   155\t\tbias, _ := config[\"bias\"].(float64)\r\n   156\t\r\n   157\t\tweights := make([]float64, len(weightsRaw))\r\n   158\t\tfor i, w := range weightsRaw {\r\n"]
[2984.753839, "o", "   159\t\t\twf, ok := w.(float64)\r\n   160\t\t\tif !ok {\r\n   161\t\t\t\treturn nil, fmt.Errorf(\"weight %d is not a number\", i)\r\n   162\t\t\t}\r\n   163\t\t\tweights[i] = wf\r\n   164\t\t}\r\n   165\t\r\n   166\t\tprediction := bias\r\n   167\t\tfor i := 0; i < len(weights) && i < len(input); i++ {\r\n   168\t\t\tprediction += weights[i] * input[i]\r\n   169\t\t}\r\n   170\t\r\n   171\t\t"]
[2984.753912, "o", "return []float64{prediction}, nil\r\n   172\t}\r\n   173\t\r\n   174\t// polynomialPredict computes y = sum(coefficients[i] * x^i) for each input x\r\n   175\tfunc polynomialPredict(config map[string]interface{}, input []float64) ([]float64, error) {\r\n   176\t\tcoeffRaw, ok := config[\"coefficients\"].([]interface{})\r\n   177\t\tif !ok {\r\n   178\t\t\treturn nil, fmt.Errorf(\"polynomial model missing coefficients\")\r\n   179\t\t}\r\n   180\t\r\n"]
[2984.754431, "o", "\u001b[?2004h"]
