[3028.532987, "o", "\r\n    60\t// StepExecutor is the function signature for executing a pipeline step.\r\n    61\ttype StepExecutor func(config, input map[string]interface{}) (map[string]interface{}, error)\r\n    62\t\r\n    63\t// NewEngine creates a pipeline engine with built-in step executors.\r\n    64\tfunc NewEngine() *Engine {\r\n    65\t\te := &Engine{\r\n    66\t\t\tstepExecutors: make(map[StepType]StepExecutor),\r\n    67\t\t}\r\n"]
