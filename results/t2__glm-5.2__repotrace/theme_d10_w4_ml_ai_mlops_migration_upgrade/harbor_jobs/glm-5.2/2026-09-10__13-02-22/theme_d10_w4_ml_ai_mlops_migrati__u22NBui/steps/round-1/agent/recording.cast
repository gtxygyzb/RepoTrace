[4082.144263, "o", "   141\t\tvar values []float64\r\n   142\t\tvar weights []float64\r\n   143\t\tvar runIDs []string\r\n   144\t\tfor _, run := range exp.Runs {\r\n   145\t\t\t"]
[4082.14434, "o", "if !matchTags(run.Tags, tagFilters) {\r\n   146\t\t\t\tcontinue\r\n   147\t\t\t}\r\n   148\t\t\tvalue, ok := run.Metrics[metricName]\r\n   149\t\t\tif !ok {\r\n   150\t\t\t\tcontinue\r\n   151\t\t\t}\r\n   152\t\t\tif aggType == \"weighted_mean\" {\r\n   153\t\t\t\tweight, ok := run.Metrics[weightParam]\r\n   154\t\t\t\tif !ok {\r\n   155"]
[4082.144404, "o", "\t\t\t\t\tcontinue\r\n   156\t\t\t\t}\r\n   157\t\t\t\tvalues = append(values, value)\r\n   158\t\t\t\tweights = append(weights, weight)\r\n   159\t\t\t\trunIDs = append(runIDs, run.ID)\r\n   160\t\t\t} else {\r\n   161\t\t\t\tvalues = append(values, value)\r\n   162\t\t\t\trunIDs = append(runIDs, run.ID)\r\n   163\t"]
[4082.144463, "o", "\t\t}\r\n   164\t\t}\r\n   165\t\r\n   166\t\tif len(values) == 0 {\r\n   167\t\t\tif len(tagFilters) > 0 {\r\n   168\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"no runs match tag filters for metric %q\", metricName)\r\n   169\t\t\t}\r\n"]
[4082.144523, "o", "   170\t\t\treturn 0, 0, nil, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n   171\t\t}\r\n   172\t\r\n   173\t\tswitch aggType {\r\n   174\t\tcase \"mean\":\r\n   175\t\t\tsum := 0.0\r\n   176\t\t\tfor _, v := range values {\r\n   177\t\t\t\tsum += v\r\n   178\t\t\t}\r\n   179\t\t\t"]
[4082.144582, "o", "return sum / float64(len(values)), len(values), runIDs, nil\r\n   180\t\r\n   181\t\tcase \"median\":\r\n   182\t\t\tsorted := sortedCopy(values)\r\n   183\t\t\tn := len(sorted)\r\n   184\t\t\tif n%2 == 0 {\r\n   185\t\t\t\treturn (sorted[n/2-1] + sorted[n/2]) / 2, len(values), runIDs, nil\r\n   186\t\t\t}\r\n   187\t\t\treturn sorted[n/2], len(values), runIDs, nil\r\n"]
[4082.144661, "o", "   188\t\r\n   189\t\tcase \"p95\":\r\n   190\t\t\tsorted := sortedCopy(values)\r\n   191\t\t\treturn percentile(sorted, 0.95), len(values), runIDs, nil\r\n   192\t\r\n   193\t\tcase \"p99\":\r\n   194\t\t\tsorted := sortedCopy(values)\r\n"]
[4082.14472, "o", "   195\t\t\treturn percentile(sorted, 0.99), len(values), runIDs, nil\r\n   196\t\r\n   197\t\tcase \"weighted_mean\":\r\n   198\t\t\tif weightParam == \"\" {\r\n   199\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\n   200\t\t\t}\r\n   201\t\t\tif len(weights) == 0 {\r\n   202\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"no runs with metric %q and weight metric %q\", metricName, weightParam)\r\n   203\t\t\t}\r\n   204\t\t\tif len(weights) != len(values) {\r\n   205\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"mismatch between metric values and weights\")\r\n   206\t\t\t}\r\n   207\t"]
[4082.144781, "o", "\t\tweightedSum := 0.0\r\n   208\t\t\tweightSum := 0.0\r\n   209\t\t\tfor i, v := range values {\r\n   210\t\t\t\tweightedSum += v * weights[i]\r\n   211\t\t\t\tweightSum += weights[i]\r\n   212\t\t\t}\r\n   213\t\t\tif weightSum == 0 {\r\n   214\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"weighted_mean has zero total weight\")\r\n"]
[4082.144842, "o", "   215\t\t\t}\r\n   216\t\t\treturn weightedSum / weightSum, len(values), runIDs, nil\r\n   217\t\r\n   218\t\tdefault:\r\n   219\t\t\treturn 0, 0, nil, fmt.Errorf(\"unknown aggregation type %q\", aggType)\r\n   220\t\t}\r\n   221\t}\r\n   222\t\r\n   223\t// MetricHistory returns chronological values of a metric across all runs in an experiment.\r\n   224\tfunc (t *Tracker) MetricHistory(experimentName, metricName string) ([]MetricHistoryEntry, error) {\r\n   225"]
[4082.144941, "o", "\t\tt.mu.RLock()\r\n   226\t\tdefer t.mu.RUnlock()\r\n   227\t\r\n   228\t\texp, exists := t.experiments[experimentName]\r\n   229\t\tif !exists {\r\n   230\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   231\t\t}\r\n   232\t\r\n   233\t\tvar history []MetricHistoryEntry\r\n   234\t\tfor _, run := range exp.Runs {\r\n"]
[4082.145, "o", "   235\t\t\tvalue, ok := run.Metrics[metricName]\r\n   236\t\t\tif !ok {\r\n   237\t\t\t\tcontinue\r\n   238\t\t\t}\r\n   239\t\t\thistory = append(history, MetricHistoryEntry{RunID: run.ID, Value: value})\r\n   240\t\t}\r\n   241\t\tif len(history) == 0 {\r\n   242\t\t\treturn nil, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n   243\t\t}\r\n   244\t\t"]
[4082.14506, "o", "return history, nil\r\n   245\t}\r\n   246\t\r\n   247\t// MetricHistoryEntry records a single metric value for a run.\r\n   248\ttype MetricHistoryEntry struct {\r\n   249\t\tRunID string  `json:\"run_id\"`\r\n   250\t\tValue float64 `json:\"value\"`\r\n   251\t}\r\n   252\t\r\n   253\t// UpdateRunMetrics updates an existing run's metrics."]
[4082.145137, "o", "\r\n   254\tfunc (t *Tracker) UpdateRunMetrics(experimentName, runID string, metrics map[string]float64) (*Run, error) {\r\n   255\t\tt.mu.Lock()\r\n   256\t\tdefer t.mu.Unlock()\r\n   257\t\r\n   258\t\texp, exists := t.experiments[experimentName]\r\n   259\t\tif !exists {\r\n   260\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   261\t\t}\r\n   262\t\r\n   263\t\t"]
[4082.145201, "o", "for _, run := range exp.Runs {\r\n   264\t\t\tif run.ID == runID {\r\n   265\t\t\t\tif run.Metrics == nil {\r\n   266\t\t\t\t\trun.Metrics = make(map[string]float64)\r\n   267\t\t\t\t}\r\n   268\t\t\t\tfor k, v := range metrics {\r\n   269\t\t\t\t\trun.Metrics[k] = v\r\n   270\t\t\t\t}\r\n   271\t\t\t\tif err := t.saveExperiment(exp); err != nil {\r\n"]
[4082.145257, "o", "   272\t\t\t\t\treturn nil, err\r\n   273\t\t\t\t}\r\n   274\t\t\t\treturn run, nil\r\n   275\t\t\t}\r\n   276\t\t}\r\n   277\t\treturn nil, fmt.Errorf(\"run %q not found in experiment %q\", runID, experimentName)\r\n   278\t}\r\n"]
