[1442.642509, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.642641, "o", "PipelineName: p.Name,\r\n\u001b[?2004l\r"]
[1442.642692, "o", "\u001b[?2004h> "]
[1442.642739, "o", "\u0007"]
[1442.642787, "o", "\r\n"]
[1442.642835, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.642942, "o", "Status:       \"success\",\r\n\u001b[?2004l\r"]
[1442.642993, "o", "\u001b[?2004h> "]
[1442.643039, "o", "\u0007"]
[1442.643087, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.643375, "o", "Steps:        make([]*StepResult, 0, len(ordered)),\r\n\u001b[?2004l\r"]
[1442.643436, "o", "\u001b[?2004h> "]
[1442.643487, "o", "\u0007}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1442.643537, "o", "> \r\n\u001b[?2004l\rp\u001b[?2004h"]
[1442.643583, "o", "> \u0007"]
[1442.643905, "o", "stepOutputs := make(map[string]map[string]interface{})\r\n\u001b[?2004l\r"]
[1442.643965, "o", "\u001b[?2004h> "]
[1442.644016, "o", "\u0007"]
[1442.6442, "o", "variables := make(map[string]float64)\r\n\u001b[?2004l\r"]
[1442.644256, "o", "\u001b[?2004h> "]
[1442.644305, "o", "\u0007"]
[1442.644494, "o", "variableSetter := make(map[string]string)\r\n\u001b[?2004l\r"]
[1442.644556, "o", "\u001b[?2004h> "]
[1442.644605, "o", "\u0007"]
[1442.64484, "o", "allDeps := computeTransitiveDependencies(p.Steps)\r\n\u001b[?2004l\r"]
[1442.644905, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h"]
[1442.644956, "o", "> \u0007"]
[1442.645145, "o", "for _, step := range ordered {\r\n\u001b[?2004l\r"]
[1442.645207, "o", "\u001b[?2004h> "]
[1442.645255, "o", "\u0007\r\n"]
[1442.645304, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.645437, "o", "stepStart := time.Now()\r\n\u001b[?2004l\r"]
[1442.645491, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h"]
[1442.64554, "o", "> "]
[1442.645588, "o", "\u0007"]
[1442.645635, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.646173, "o", "resolvedConfig, err := resolveVariables(step.Config, variables, variableSetter, allDeps[step.Name])\r\n\u001b[?2004l\r"]
[1442.64624, "o", "\u001b[?2004h> "]
[1442.646291, "o", "\u0007\r\n"]
[1442.646343, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.646414, "o", "if err != nil {\r\n\u001b[?2004l\r"]
[1442.646461, "o", "\u001b[?2004h> "]
[1442.646509, "o", "\u0007"]
[1442.646555, "o", "\r\n"]
[1442.646603, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.646651, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.646754, "o", "sr := &StepResult{\r\n\u001b[?2004l\r"]
[1442.646803, "o", "\u001b[?2004h> "]
[1442.646857, "o", "\u0007"]
[1442.646905, "o", "\r\n"]
[1442.646953, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.647, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.647048, "o", "\r\n"]
[1442.647095, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.647152, "o", "StepName:   step.Name,\r\n\u001b[?2004l\r"]
[1442.6472, "o", "\u001b[?2004h> \u0007"]
[1442.647249, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.647297, "o", "\r\n"]
[1442.647344, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\n"]
[1442.647392, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.647459, "o", "StepType:   step.Type,\r\n\u001b[?2004l\r"]
[1442.647507, "o", "\u001b[?2004h> \u0007"]
[1442.647557, "o", "\r\n"]
[1442.647602, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\n"]
[1442.64765, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\n"]
[1442.647698, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.647746, "o", "Status:     \"failed\",\r\n\u001b[?2004l\re"]
[1442.647793, "o", "\u001b[?2004h> "]
[1442.647841, "o", "\u0007\r\n"]
[1442.647893, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\n"]
[1442.647943, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\n"]
[1442.64799, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.648067, "o", "Error:      err.Error(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1442.648116, "o", "> \u0007"]
[1442.648163, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.648211, "o", "\r\nconfigs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.64826, "o", "\r\n"]
[1442.648309, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> "]
[1442.648504, "o", "DurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\r\n\u001b[?2004l\r"]
[1442.648553, "o", "\u001b[?2004h> \u0007"]
[1442.648598, "o", "\r\n"]
[1442.648643, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> \r\n"]
[1442.648689, "o", "configs/  data/     docs/     go.mod    gomlops   internal/ main.go   \r\n> }\r\n\u001b[?2004l\r\u001b[?2004h"]
