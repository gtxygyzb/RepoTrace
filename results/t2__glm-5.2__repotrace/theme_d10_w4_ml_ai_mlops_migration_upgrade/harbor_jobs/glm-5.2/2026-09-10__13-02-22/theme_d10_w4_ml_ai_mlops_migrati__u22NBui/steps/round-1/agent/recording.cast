[5664.497154, "o", "   100\t}\r\n   101\t\r\n   102\t// ExecuteValidate checks data against schema constraints.\r\n   103\tfunc ExecuteValidate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   104\t\tdata, ok := input[\"data\"].([]interface{})\r\n   105\t\tif !ok {\r\n   106\t\t\treturn nil, fmt.Errorf(\"validate: missing or invalid 'data' field\")\r\n"]
[5664.497296, "o", "   107\t\t}\r\n   108\t\r\n   109\t\tvar errors []interface{}\r\n   110\t\r\n   111\t\t// Check min_value constraint\r\n   112\t\tif minVal, ok := config[\"min_value\"].(float64); ok {\r\n   113\t\t\tfor i, v := range data {\r\n   114\t\t\t\tval, err := toFloat(v)\r\n   115\t\t\t\tif err != nil {\r\n   116\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: not a number\", i))\r\n   117\t\t\t\t\tcontinue\r\n   118\t\t\t\t}\r\n   119\t\t\t\tif val < minVal {\r\n   120\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f below minimum %f\", i, val, minVal))\r\n   121\t\t\t\t}\r\n   122\t\t\t}\r\n   123\t\t}\r\n   124\t\r\n"]
[5664.497398, "o", "   125\t\t// Check max_value constraint\r\n   126\t\tif maxVal, ok := config[\"max_value\"].(float64); ok {\r\n   127\t\t\tfor i, v := range data {\r\n   128\t\t\t\tval, err := toFloat(v)\r\n   129\t\t\t\tif err != nil {\r\n   130\t\t\t\t\tcontinue\r\n"]
[5664.497439, "o", "   131\t\t\t\t}\r\n   132\t\t\t\tif val > maxVal {\r\n   133\t\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f above maximum %f\", i, val, maxVal))\r\n   134\t\t\t\t}\r\n   135\t\t\t}\r\n   136\t\t}\r\n   137\t\r\n   138\t\t// Check min_count constraint\r\n   139\t\tif minCount, ok := config[\"min_count\"].(float64); ok {\r\n   140\t\t\tif float64(len(data)) < minCount {\r\n   141\t\t\t\terrors = append(errors, fmt.Sprintf(\"data has %d elements, minimum required is %d\", len(data), int(minCount)))\r\n   142\t\t\t}\r\n"]
[5664.497542, "o", "   143\t\t}\r\n   144\t\r\n   145\t\tvalid := len(errors) == 0\r\n   146\t\treturn map[string]interface{}{\r\n   147\t\t\t\"valid\":  valid,\r\n   148\t\t\t\"errors\": errors,\r\n   149\t\t\t\"data\":   data,\r\n   150\t\t}, nil\r\n   151\t}\r\n   152\t\r\n   153\t// ExecuteAggregate computes aggregations over input data.\r\n   154\t// Supported operations: sum, mean, count, min, max.\r\n   155\tfunc ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   156\t\tdata, ok := input[\"data\"].([]interface{})\r\n   157\t\tif !ok {\r\n"]
