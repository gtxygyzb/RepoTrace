[3028.80514, "o", "   300\t\t\t\t\tif dep == current.Name {\r\n   301\t\t\t\t\t\tinDegree[s.Name]--\r\n   302\t\t\t\t\t\tif inDegree[s.Name] == 0 {\r\n   303\t\t\t\t\t\t\tqueue = append(queue, s)\r\n   304\t\t\t\t\t\t}\r\n   305\t\t\t\t\t}\r\n"]
