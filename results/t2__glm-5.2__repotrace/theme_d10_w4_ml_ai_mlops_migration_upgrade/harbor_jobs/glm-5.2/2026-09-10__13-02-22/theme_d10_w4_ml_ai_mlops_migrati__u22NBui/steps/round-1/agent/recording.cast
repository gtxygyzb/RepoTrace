[524.470734, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path(\"internal/pipeline/engine.go\")\ns = p.read_text()\nif not s.contains(\"func mergeDependencyOutputs\"):\n    s += '''\n// mergeDependencyOutputs concatenates the \"data\" arrays from all dependency outputs into a single input.\nfunc mergeDependencyOutputs(deps []string, outputs map[string]map[string]interface{}) map[string]interface{} {\n\\tmerged := make([]interface{}, 0)\n\\tfor _, dep := range deps {\n\\t\\tout, ok := outputs[dep]\n\\t\\tif !ok {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\tswitch data := out[\"data\"].(type) {\n\\t\\tcase []interface{}:\n\\t\\t\\tmerged = append(merged, data...)\n\\t\\tcase []float64:\n\\t\\t\\tfor _, v := range data {\n\\t\\t\\t\\tmerged = append(merged, v)\n\\t\\t\\t}\n\\t\\t}\n\\t}\n\\treturn map[string]interface{}{\"data\": merged}\n}\n'''\n    p.write_text(s)\nPY\n"]
[524.471018, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[524.47118, "o", "\u001b[?2004h> "]
[524.471286, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[524.47137, "o", "\u001b[?2004h> "]
