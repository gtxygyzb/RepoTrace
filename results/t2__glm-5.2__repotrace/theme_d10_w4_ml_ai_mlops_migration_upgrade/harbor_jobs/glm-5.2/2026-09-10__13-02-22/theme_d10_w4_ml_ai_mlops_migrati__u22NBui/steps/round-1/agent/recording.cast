[890.104394, "o", "req(\"POST\", f\"/experiments/{exp}/runs\", {\"parameters\":{\"weight\":3},\"metrics\":{\"loss\":0.5},\"tags\":{}})\r\n\u001b[?2004l\r"]
[890.104487, "o", "\u001b[?2004h> "]
[890.104785, "o", "st, b = req(\"GET\", f\"/experiments/{exp}/metrics/accuracy/aggregate?type=mean\")\r\n\u001b[?2004l\r"]
[890.104849, "o", "\u001b[?2004h> "]
[890.105118, "o", "check(\"agg skip missing metric\", b[\"count\"]==2 and b[\"value\"]==15, b)\r\n\u001b[?2004l\r"]
[890.105184, "o", "\u001b[?2004h> "]
[890.105593, "o", "st, b = req(\"GET\", f\"/experiments/{exp}/metrics/accuracy/aggregate?type=weighted_mean&weight_param=weight\")\r\n\u001b[?2004l\r"]
[890.105658, "o", "\u001b[?2004h> "]
[890.105949, "o", "check(\"weighted mean\", b[\"count\"]==2 and abs(b[\"value\"]-16.666666)<1e-6, b)\r\n\u001b[?2004l\r"]
[890.106014, "o", "\u001b[?2004h> "]
[890.106088, "o", "exp2 = \"exp2\"+suf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[890.10627, "o", "req(\"POST\",\"/experiments\",{\"name\":exp2})\r\n\u001b[?2004l\r"]
[890.106336, "o", "\u001b[?2004h> "]
[890.106425, "o", "for v in [10,20,30,40,50]:\r\n\u001b[?2004l\r"]
[890.106491, "o", "\u001b[?2004h> "]
[890.106867, "o", "    req(\"POST\", f\"/experiments/{exp2}/runs\", {\"parameters\":{},\"metrics\":{\"accuracy\":v},\"tags\":{}})\r\n\u001b[?2004l\r"]
[890.106932, "o", "\u001b[?2004h> "]
[890.107228, "o", "st, b = req(\"GET\", f\"/experiments/{exp2}/metrics/accuracy/aggregate?type=p95\")\r\n\u001b[?2004l\r"]
[890.107294, "o", "\u001b[?2004h> "]
[890.107537, "o", "check(\"p95 interpolation\", b[\"value\"]==48.0 and b[\"count\"]==5, b)\r\n\u001b[?2004l\r"]
[890.107603, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[890.107675, "o", "> # Serving\r\n\u001b[?2004l\r"]
[890.107739, "o", "\u001b[?2004h> "]
[890.107997, "o", "st, b = req(\"POST\",\"/serving/load\",{\"model_name\":m,\"version_num\":1})\r\n\u001b[?2004l\r"]
[890.108031, "o", "\u001b[?2004h> "]
[890.108223, "o", "check(\"load version\", st==200, b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[890.108489, "o", "st, b = req(\"POST\",\"/serving/infer\",{\"model_name\":m,\"input\":[1,2]})\r\n\u001b[?2004l\r"]
[890.108557, "o", "\u001b[?2004h> "]
[890.108973, "o", "check(\"inference response\", st==200 and b[\"version\"]==1 and b[\"predictions\"]==[9] and \"latency_ms\" in b, b)\r\n\u001b[?2004l\r"]
[890.109048, "o", "\u001b[?2004h> "]
[890.109172, "o", "req(\"DELETE\", f\"/serving/models/{m}\")\r\n\u001b[?2004l\r"]
[890.109228, "o", "\u001b[?2004h> "]
[890.109586, "o", "check(\"infer unloaded\", req(\"POST\",\"/serving/infer\",{\"model_name\":m,\"input\":[1,2]})[0]==404)\r\n\u001b[?2004l\r"]
[890.109642, "o", "\u001b[?2004h> "]
[890.109706, "o", "poly = \"poly\"+suf\r\n\u001b[?2004l\r"]
[890.109761, "o", "\u001b[?2004h> "]
[890.110112, "o", "req(\"POST\",\"/models\",{\"name\":poly,\"framework\":\"polynomial\",\"description\":\"d\",\"tags\":[]})\r\n\u001b[?2004l\r"]
[890.110168, "o", "\u001b[?2004h> "]
[890.110685, "o", "req(\"POST\", f\"/models/{poly}/versions\", {\"metrics\":{},\"tags\":[],\"model_config\":{\"model_type\":\"polynomial\",\"coefficients\":[1,2,3]}})\r\n\u001b[?2004l\r"]
[890.110745, "o", "\u001b[?2004h> "]
[890.111015, "o", "req(\"PUT\", f\"/models/{poly}/versions/1/promote\", {\"stage\":\"staging\"})\r\n\u001b[?2004l\r"]
[890.11107, "o", "\u001b[?2004h> "]
[890.111324, "o", "req(\"POST\",\"/serving/load\",{\"model_name\":poly,\"stage\":\"staging\"})\r\n\u001b[?2004l\r"]
[890.111379, "o", "\u001b[?2004h> "]
[890.111652, "o", "st, b = req(\"POST\",\"/serving/infer\",{\"model_name\":poly,\"input\":[1,2]})\r\n\u001b[?2004l\r"]
[890.111707, "o", "\u001b[?2004h> "]
[890.111979, "o", "check(\"polynomial\", b[\"version\"]==1 and b[\"predictions\"]==[6,17], b)\r\n\u001b[?2004l\r"]
[890.112035, "o", "\u001b[?2004h> "]
[890.112183, "o", "req(\"DELETE\", f\"/models/{poly}\")\r\n\u001b[?2004l\r"]
[890.112238, "o", "\u001b[?2004h> "]
[890.112701, "o", "check(\"delete unloads serving\", req(\"POST\",\"/serving/infer\",{\"model_name\":poly,\"input\":[1,2]})[0]==404)\r\n\u001b[?2004l\r"]
[890.112757, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[890.112813, "o", "\u001b[?2004h> "]
[890.1131, "o", "print(\"SUMMARY\", sum(1 for _,c,_ in results if c), \"/\", len(results))\r\n\u001b[?2004l\r"]
[890.113157, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
