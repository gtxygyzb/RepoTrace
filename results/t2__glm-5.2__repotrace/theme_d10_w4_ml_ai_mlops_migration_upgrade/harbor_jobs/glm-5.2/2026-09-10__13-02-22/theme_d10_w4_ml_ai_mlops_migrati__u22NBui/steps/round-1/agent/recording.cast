[6505.693481, "o", "     6\t\t\"math\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t\t\"sync\"\r\n    13\t\t\"time\"\r\n    14\t)\r\n    15\t\r\n    16\t// Experiment groups related runs together.\r\n    17\ttype Experiment struct {\r\n    18\t\tName      string    `json:\"name\"`\r\n    19"]
[6505.693557, "o", "\t\tRuns      []*Run    `json:\"runs\"`\r\n    20\t\tCreatedAt time.Time `json:\"created_at\"`\r\n    21\t}\r\n    22\t\r\n    23\t// Run records a single experiment execution with parameters and metrics.\r\n    24\ttype Run struct {\r\n    25\t\tID         string             `json:\"id\"`\r\n    26\t\tParameters map[string]float64 `json:\"parameters\"`\r\n    27\t\tMetrics    map[string]float64 `json:\"metrics\"`\r\n    28\t\tTags       map[string]string  `json:\"tags\"`\r\n    29\t\tCreatedAt  time.Time          `json:\"created_at\"`\r\n    30\t}\r\n    31\t\r\n    32\t// Tracker manages experiments and their runs.\r\n    33\ttype Tracker struct {\r\n"]
[6505.693624, "o", "    34\t\tmu          sync.RWMutex\r\n    35\t\texperiments map[string]*Experiment\r\n    36\t\tdataDir     string\r\n    37\t\trunCounter  int\r\n    38\t}\r\n    39\t\r\n    40\t// NewTracker creates a new experiment tracker backed by the given data directory.\r\n    41\tfunc NewTracker(dataDir string) *Tracker {\r\n    42\t\tos.MkdirAll(dataDir, 0755)\r\n"]
[6505.693691, "o", "    43\t\tt := &Tracker{\r\n    44\t\t\texperiments: make(map[string]*Experiment),\r\n    45\t\t\tdataDir:     dataDir,\r\n    46\t\t}\r\n    47\t\tt.loadAll()\r\n    48\t\treturn t\r\n    49\t}\r\n    50\t\r\n    51\t// CreateExperiment creates a new experiment with the given name.\r\n    52\tfunc (t *Tracker) CreateExperiment(name string) (*Experiment, error) {\r\n    53\t\tt.mu.Lock()\r\n    54\t\t"]
[6505.693756, "o", "defer t.mu.Unlock()\r\n    55\t\r\n    56\t\tif _, exists := t.experiments[name]; exists {\r\n    57\t\t\treturn nil, fmt.Errorf(\"experiment %q already exists\", name)\r\n    58\t\t}\r\n    59\t\r\n    60\t\texp := &Experiment{\r\n    61\t\t\tName:      name,\r\n    62\t\t\tRuns:      make([]*Run, 0),\r\n    63\t\t\tCreatedAt: time.Now(),\r\n    64\t\t}\r\n"]
