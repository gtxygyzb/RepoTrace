[1442.615666, "i", "\tstepMap[s.Name] = s\n\t\tinDegree[s.Name] = 0\n\t}\n\n\t// Build in-degree counts\n\tfor _, s := range steps {\n\t\tfor _, dep := range s.Dependencies {\n\t\t\tif _, ok := stepMap[dep]; !ok {\n\t\t\t\treturn nil, fmt.Errorf(\"step %q depends on unknown step %q\", s.Name, dep)\n\t\t\t}\n\t\t\tinDegree[s.Name]++\n\t\t}\n\t}\n\n\t// Initialize queue with steps that have no dependencies\n\tqueue := make([]*Step, 0)\n\tfor _, s := range steps {\n\t\tif inDegree[s.Name] == 0 {\n\t\t\tqueue = append(queue, s)\n\t\t}\n\t}\n\n\t// Process steps in topological order\n\tordered := make([]*Step, 0, len(steps))\n\tfor len(queue) > 0 {\n\t\tcurrent := queue[0]\n\t\tqueue = queue[1:]\n\t\tordered = append(ordered, current)\n\n\t\t// Find steps that depend on current\n\t\tfor _, s := range steps {\n\t\t\tfor _, dep := range s.Dependencies {\n\t\t\t\tif dep == current.Name {\n\t\t\t\t\tinDegree[s.Name]--\n\t\t\t\t\tif inDegree[s.Name] == 0 {\n\t\t\t\t\t\tqueue = append(queue, s)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tif len(ordered) != len(steps) {\n\t\treturn nil, fmt.Errorf(\"cycle detected in pipeline dependencies\")\n\t}\n\n\treturn ordered, nil\n}"]
