[185.268718, "o", "\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (h *Handlers) AggregateMetric\u001b[m\u001b[K(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\texpName := r.PathValue(\"name\")\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmetricName := r.PathValue(\"metric\")\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\taggType := r.URL.Query().Get(\"type\")\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tweightParam := r.URL.Query().Get(\"weight_param\")\r\n"]
[185.268839, "o", "\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif aggType == \"\" {\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"query parameter 'type' is required\")\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tresult, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam)\r\n"]
[185.268941, "o", "\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\texp, _ := h.Experiment.GetExperiment(expName)\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\trunCount := 0\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif exp != nil {\r\n\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\trunCount = len(exp.Runs)\r\n\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\"experiment\": expName,\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\"metric\":     metricName,\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\"type\":       aggType,\r\n\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\"value\":      result,\r\n\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\"count\":      runCount,\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t})\r\n\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K257\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[3"]
[185.269042, "o", "6m\u001b[K-\u001b[m\u001b[K// --- Serving Handlers ---\r\n\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (h *Handlers) LoadModel(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar req struct {\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tModelName  string `json:\"model_name\"`\r\n\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tVersionNum int    `json:\"version_num\"`\r\n\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tStage      string `json:\"stage\"`\r\n\u001b[32m\u001b[K265\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K266\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\u001b[32m\u001b[K268\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif req.ModelName == \"\" {\r\n\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"model_name is required\")\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n"]
