[740.78978, "o", "   314\t// Helper functions\r\n   315\t\r\n   316\tfunc toFloat(v interface{}) (float64, error) {\r\n   317\t\tswitch val := v.(type) {\r\n   318\t\tcase float64:\r\n   319\t\t\treturn val, nil\r\n   320\t\tcase int:\r\n   321\t\t\treturn float64(val), nil\r\n   322\t\tcase int64:\r\n   323"]
[740.78987, "o", "\t\t\treturn float64(val), nil\r\n   324\t\tdefault:\r\n   325\t\t\treturn 0, fmt.Errorf(\"cannot convert %T to float64\", v)\r\n   326\t\t}\r\n   327\t}\r\n   328\t\r\n   329\tfunc findMinMax(data []interface{}) (float64, float64) {\r\n   330\t\tif len(data) == 0 {\r\n   331\t\t\treturn 0, 0\r\n   332\t\t}\r\n   333\t\tminVal, _ := toFloat(data[0])\r\n   334\t\tmaxVal := minVal\r\n   335\t\tfor _, v := range data[1:] {\r\n"]
[740.789931, "o", "   336\t\t\tval, err := toFloat(v)\r\n   337\t\t\tif err != nil {\r\n   338\t\t\t\tcontinue\r\n   339\t\t\t}\r\n   340\t\t\tif val < minVal {\r\n   341\t\t\t\tminVal = val\r\n   342\t\t\t}\r\n   343\t\t\tif val > maxVal {\r\n   344\t\t\t\tmaxVal = val\r\n   345\t\t\t}\r\n"]
[740.789989, "o", "   346\t\t}\r\n   347\t\treturn minVal, maxVal\r\n   348\t}\r\n   349\t\r\n   350\tfunc sortedCopy(values []float64) []float64 {\r\n   351\t\ts := make([]float64, len(values))\r\n   352\t\tcopy(s, values)\r\n   353\t\tsort.Float64s(s)\r\n"]
[740.790044, "o", "   354\t\treturn s\r\n   355\t}\r\n"]
