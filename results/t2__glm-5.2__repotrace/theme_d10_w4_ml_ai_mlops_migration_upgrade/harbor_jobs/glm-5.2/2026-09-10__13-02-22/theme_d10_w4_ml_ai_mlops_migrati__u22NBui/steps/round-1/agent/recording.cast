[5996.95471, "o", "\\ttotal := len(e.history)\r\n\u001b[?2004l\r"]
[5996.954748, "o", "\u001b[?2004h"]
[5996.954786, "o", "> "]
[5996.954871, "o", "\\tif limit <= 0 {\r\n\u001b[?2004l\r"]
[5996.95491, "o", "\u001b[?2004h"]
[5996.954947, "o", "> "]
[5996.955035, "o", "\\t\\tlimit = 10\r\n\u001b[?2004l\r"]
[5996.955075, "o", "\u001b[?2004h> "]
[5996.955111, "o", "\\t}\r\n\u001b[?2004l\r"]
[5996.955148, "o", "\u001b[?2004h"]
[5996.955185, "o", "> "]
[5996.955287, "o", "\\tif limit > total {\r\n\u001b[?2004l\r"]
[5996.955327, "o", "\u001b[?2004h> "]
