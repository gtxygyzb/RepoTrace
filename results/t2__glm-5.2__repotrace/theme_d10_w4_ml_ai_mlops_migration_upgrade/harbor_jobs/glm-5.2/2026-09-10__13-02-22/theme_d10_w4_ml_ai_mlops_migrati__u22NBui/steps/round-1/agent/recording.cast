[144.243029, "o", "     1\tpackage experiment\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"math\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9"]
[144.243189, "o", "\t\t\"sort\"\r\n    10\t\t\"sync\"\r\n    11\t\t\"time\"\r\n    12\t)\r\n    13\t\r\n    14\t// Experiment groups related runs together.\r\n    15\ttype Experiment struct {\r\n    16\t\tName      string    `json:\"name\"`\r\n    17\t\tRuns      []*Run    `json:\"runs\"`\r\n    18\t\tCreatedAt time.Time `json:\"created_at\"`\r\n    19\t}\r\n    20\t\r\n    21\t// Run records a single experiment execution with parameters and metrics.\r\n    22\ttype Run struct {\r\n    23\t\tID         string             `json:\"id\"`\r\n    24\t\tParameters map[string]float64 `json:\"parameters\"`\r\n    25\t\tMetrics    map[string]float64 `json:\"metrics\"`\r\n    26\t\tTags       map[string]string  `json:\"tags\"`\r\n    27\t\tCreatedAt  time.Time          `json:\"created_at\"`\r\n    28\t}\r\n    29\t\r\n    30\t// Tracker manages experiments and their runs.\r\n    31\ttype Tracker struct {\r\n    32"]
[144.243283, "o", "\t\tmu          sync.RWMutex\r\n    33\t\texperiments map[string]*Experiment\r\n    34\t\tdataDir     string\r\n    35\t\trunCounter  int\r\n    36\t}\r\n    37\t\r\n    38\t// NewTracker creates a new experiment tracker backed by the given data directory.\r\n    39\tfunc NewTracker(dataDir string) *Tracker {\r\n    40\t\tos.MkdirAll(dataDir, 0755)\r\n    41\t\tt := &Tracker{\r\n    42\t\t\texperiments: make(map[string]*Experiment),\r\n    43\t\t\tdataDir:     dataDir,\r\n    44\t\t}\r\n    45\t\tt.loadAll()\r\n"]
[144.243355, "o", "    46\t\treturn t\r\n    47\t}\r\n    48\t\r\n    49\t// CreateExperiment creates a new experiment with the given name.\r\n    50\tfunc (t *Tracker) CreateExperiment(name string) (*Experiment, error) {\r\n    51\t\tt.mu.Lock()\r\n    52\t\tdefer t.mu.Unlock()\r\n    53\t\r\n    54\t\tif _, exists := t.experiments[name]; exists {\r\n    55\t\t\treturn nil, fmt.Errorf(\"experiment %q already exists\", name)\r\n"]
[144.243442, "o", "    56\t\t}\r\n    57\t\r\n    58\t\texp := &Experiment{\r\n    59\t\t\tName:      name,\r\n    60\t\t\tRuns:      make([]*Run, 0),\r\n    61\t\t\tCreatedAt: time.Now(),\r\n    62\t\t}\r\n    63\t\tt.experiments[name] = exp\r\n    64\t\tif err := t.saveExperiment(exp); err != nil {\r\n    65\t\t\tdelete(t.experiments, name)\r\n    66\t\t\treturn nil, err\r\n    67\t\t}\r\n"]
[144.243505, "o", "    68\t\treturn exp, nil\r\n    69\t}\r\n    70\t\r\n    71\t// LogRun adds a new run to the specified experiment.\r\n    72\tfunc (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {\r\n    73\t\tt.mu.Lock()\r\n    74\t\tdefer t.mu.Unlock()\r\n    75\t\r\n    76\t\texp, exists := t.experiments[experimentName]\r\n    77\t\tif !exists {\r\n    78\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n"]
[144.243582, "o", "    79\t\t}\r\n    80\t\r\n    81\t\tt.runCounter++\r\n    82\t\trun := &Run{\r\n    83\t\t\tID:         fmt.Sprintf(\"run_%d\", t.runCounter),\r\n    84\t\t\tParameters: params,\r\n    85\t\t\tMetrics:    metrics,\r\n    86\t\t\tTags:       tags,\r\n    87\t\t\tCreatedAt:  time.Now(),\r\n    88\t\t}\r\n    89\t\texp.Runs = append(exp.Runs, run)\r\n"]
[144.243642, "o", "    90\t\r\n    91\t\tif err := t.saveExperiment(exp); err != nil {\r\n    92\t\t\texp.Runs = exp.Runs[:len(exp.Runs)-1]\r\n    93\t\t\treturn nil, err\r\n    94\t\t}\r\n    95\t\treturn run, nil\r\n    96\t}\r\n    97\t\r\n    98\t"]
[144.243703, "o", "// GetExperiment returns the experiment with the given name.\r\n    99\tfunc (t *Tracker) GetExperiment(name string) (*Experiment, error) {\r\n   100\t\tt.mu.RLock()\r\n   101\t\tdefer t.mu.RUnlock()\r\n   102\t\r\n   103\t\texp, exists := t.experiments[name]\r\n   104\t\tif !exists {\r\n   105\t\t\treturn nil, fmt.Errorf(\"experiment %q not found\", name)\r\n   106\t\t}\r\n   107"]
[144.243768, "o", "\t\treturn exp, nil\r\n   108\t}\r\n   109\t\r\n   110\t// ListExperiments returns all experiments.\r\n   111\tfunc (t *Tracker) ListExperiments() []*Experiment {\r\n   112\t\tt.mu.RLock()\r\n   113\t\tdefer t.mu.RUnlock()\r\n   114\t\r\n   115\t\tresult := make([]*Experiment, 0, len(t.experiments))\r\n   116\t"]
[144.243826, "o", "\tfor _, exp := range t.experiments {\r\n   117\t\t\tresult = append(result, exp)\r\n   118\t\t}\r\n   119\t\tsort.Slice(result, func(i, j int) bool {\r\n   120\t\t\treturn result[i].Name < result[j].Name\r\n   121\t\t})\r\n   122\t\treturn result\r\n   123\t}\r\n   124"]
[144.243914, "o", "\t\r\n   125\t// AggregateMetric computes an aggregate statistic for a given metric across all runs\r\n   126\t// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.\r\n   127\t// For weighted_mean, weightParam specifies which parameter to use as weight.\r\n   128\tfunc (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, error) {\r\n   129\t\tt.mu.RLock()\r\n   130\t\tdefer t.mu.RUnlock()\r\n   131\t\r\n   132\t\texp, exists := t.experiments[experimentName]\r\n"]
[144.243979, "o", "   133\t\tif !exists {\r\n   134\t\t\treturn 0, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   135\t\t}\r\n   136\t\r\n   137\t\tif len(exp.Runs) == 0 {\r\n   138\t\t\treturn 0, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n   139\t\t}\r\n   140\t\r\n   141\t\tvar values []float64\r\n   142\t\tvar weights []float64\r\n   143\t\t"]
[144.244046, "o", "for _, run := range exp.Runs {\r\n   144\t\t\tvalues = append(values, run.Metrics[metricName])\r\n   145\t\t\tif weightParam != \"\" {\r\n   146\t\t\t\tweights = append(weights, run.Parameters[weightParam])\r\n   147\t\t\t}\r\n   148\t\t}\r\n   149\t\r\n   150\t\tif len(values) == 0 {\r\n   151\t\t\t"]
[144.244119, "o", "return 0, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n   152\t\t}\r\n   153\t\r\n   154\t\tswitch aggType {\r\n   155\t\tcase \"mean\":\r\n   156\t\t\tsum := 0.0\r\n"]
[144.24418, "o", "   157\t\t\tfor _, v := range values {\r\n   158\t\t\t\tsum += v\r\n   159\t\t\t}\r\n   160\t\t\treturn sum / float64(len(values)), nil\r\n   161\t\r\n   162\t\tcase \"median\":\r\n   163\t\t\tsorted := sortedCopy(values)\r\n   164\t\t\tn := len(sorted)\r\n   165\t\t\tif n%2 == 0 {\r\n   166\t\t\t\treturn (sorted[n/2-1] + sorted[n/2]) / 2, nil\r\n   167\t\t\t}\r\n   168\t\t\treturn sorted[n/2], nil\r\n   169\t\r\n   170\t\tcase \"p95\":\r\n   171\t"]
[144.244237, "o", "\t\tsorted := sortedCopy(values)\r\n   172\t\t\treturn percentile(sorted, 0.95), nil\r\n   173\t\r\n   174\t\tcase \"p99\":\r\n   175\t\t\tsorted := sortedCopy(values)\r\n   176\t\t\treturn percentile(sorted, 0.99), nil\r\n   177\t\r\n   178\t\tcase \"weighted_mean\":\r\n   179\t\t\t"]
[144.244303, "o", "if len(weights) == 0 || len(weights) != len(values) {\r\n   180\t\t\t\treturn 0, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\n   181\t\t\t}\r\n   182\t\t\tweightedSum := 0.0\r\n   183\t\t\tfor i, v := range values {\r\n   184\t\t\t\tweightedSum += v * weights[i]\r\n   185\t\t\t}\r\n   186\t\t\treturn weightedSum / float64(len(values)), nil\r\n   187\t\r\n   188\t\tdefault:\r\n"]
[144.244377, "o", "   189\t\t\treturn 0, fmt.Errorf(\"unknown aggregation type %q\", aggType)\r\n   190\t\t}\r\n   191\t}\r\n   192\t\r\n   193\tfunc percentile(sorted []float64, p float64) float64 {\r\n   194\t\tn := len(sorted)\r\n   195\t\tif n == 0 {\r\n   196\t\t\treturn 0\r\n   197\t\t}\r\n   198\t\tif n == 1 {\r\n   199"]
[144.244441, "o", "\t\t\treturn sorted[0]\r\n   200\t\t}\r\n   201\t\trank := p * float64(n)\r\n   202\t\tlower := int(math.Floor(rank))\r\n   203\t\tupper := int(math.Ceil(rank))\r\n   204\t\tif lower == upper {\r\n   205\t\t\treturn sorted[lower]\r\n   206\t\t}\r\n"]
[144.2445, "o", "   207\t\tfrac := rank - float64(lower)\r\n   208\t\treturn sorted[lower]*(1-frac) + sorted[upper]*frac\r\n   209\t}\r\n   210\t\r\n   211\tfunc sortedCopy(values []float64) []float64 {\r\n   212\t\ts := make([]float64, len(values))\r\n   213\t\tcopy(s, values)\r\n   214\t\t"]
[144.24456, "o", "sort.Float64s(s)\r\n   215\t\treturn s\r\n   216\t}\r\n   217\t\r\n   218\tfunc (t *Tracker) loadAll() {\r\n   219\t\tentries, err := os.ReadDir(t.dataDir)\r\n   220\t\tif err != nil {\r\n   221\t\t\treturn\r\n   222\t\t}\r\n"]
[144.244628, "o", "   223\t\tfor _, entry := range entries {\r\n   224\t\t\tif !entry.IsDir() && filepath.Ext(entry.Name()) == \".json\" {\r\n   225\t\t\t\tdata, err := os.ReadFile(filepath.Join(t.dataDir, entry.Name()))\r\n   226\t\t\t\tif err != nil {\r\n   227\t\t\t\t\tcontinue\r\n   228\t\t\t\t}\r\n   229\t\t\t\tvar exp Experiment\r\n   230\t\t\t\tif err := json.Unmarshal(data, &exp); err != nil {\r\n   231\t\t\t\t\t"]
[144.244687, "o", "continue\r\n   232\t\t\t\t}\r\n   233\t\t\t\tt.experiments[exp.Name] = &exp\r\n   234\t\t\t\tfor _, r := range exp.Runs {\r\n   235\t\t\t\t\t_ = r\r\n   236\t\t\t\t\tt.runCounter++\r\n   237\t\t\t\t}\r\n   238\t\t\t}\r\n   239\t\t}\r\n"]
[144.244745, "o", "   240\t}\r\n   241\t\r\n   242\tfunc (t *Tracker) saveExperiment(exp *Experiment) error {\r\n   243\t\tdata, err := json.MarshalIndent(exp, \"\", \"  \")\r\n   244\t\tif err != nil {\r\n   245\t\t\treturn err\r\n   246\t\t}\r\n   247\t\tfilename := filepath.Join(t.dataDir, exp.Name+\".json\")\r\n   248\t\treturn os.WriteFile(filename, data, 0644)\r\n"]
[144.2448, "o", "   249\t}\r\n"]
