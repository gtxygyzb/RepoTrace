[2210.116765, "o", "    14\t)\r\n    15\t\r\n    16\ttype TemplateParameter struct {\r\n    17\t\tName    string      `json:\"name\"`\r\n    18\t\tType    string      `json:\"type\"`\r\n    19\t\tDefault interface{} `json:\"default,omitempty\"`\r\n    20\t}\r\n    21\t\r\n    22\ttype Template struct {\r\n"]
[2210.116835, "o", "    23\t\tName        string              `json:\"name\"`\r\n    24\t\tDescription string              `json:\"description\"`\r\n    25\t\tParameters  []TemplateParameter `json:\"parameters\"`\r\n    26\t\tPipeline    *pipeline.Pipeline  `json:\"pipeline\"`\r\n    27\t\tCreatedAt   time.Time           `json:\"created_at\"`\r\n    28\t\tUpdatedAt   *time.Time          `json:\"updated_at\"`\r\n    29\t}\r\n    30\t\r\n    31\ttype TemplateStore struct {\r\n    32\t\tmu        sync.RWMutex\r\n    33\t\ttemplates map[string]*Template\r\n    34\t}\r\n    35\t\r\n    36\tfunc NewTemplateStore() *TemplateStore {\r\n"]
[2210.11691, "o", "    37\t\treturn &TemplateStore{templates: make(map[string]*Template)}\r\n    38\t}\r\n    39\t\r\n    40\tvar templateNameRe = regexp.MustCompile(`^[a-zA-Z0-9_-]+$`)\r\n    41\t\r\n    42\tfunc validateTemplateName(name string) bool {\r\n    43\t\treturn len(name) > 0 && len(name) <= 64 && templateNameRe.MatchString(name)\r\n    44\t}\r\n    45\t\r\n"]
[2210.116978, "o", "    46\tfunc (s *TemplateStore) Get(name string) (*Template, bool) {\r\n    47\t\ts.mu.RLock()\r\n    48\t\tdefer s.mu.RUnlock()\r\n    49\t\tt, ok := s.templates[name]\r\n    50\t\treturn t, ok\r\n    51\t}\r\n    52\t\r\n    53\tfunc (s *TemplateStore) List(sortBy string) []*Template {\r\n    54\t\ts.mu.RLock()\r\n    55\t\tdefer s.mu.RUnlock()\r\n"]
[2210.117039, "o", "    56\t\tresult := make([]*Template, 0, len(s.templates))\r\n    57\t\tfor _, t := range s.templates {\r\n    58\t\t\tresult = append(result, t)\r\n    59\t\t}\r\n    60\t\tif sortBy == \"created_at\" {\r\n"]
