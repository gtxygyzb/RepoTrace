[2600.582788, "o", "   215\t}\r\n   216\t\r\n   217\tfunc (h *Handlers) ExecuteTemplate(w http.ResponseWriter, r *http.Request) {\r\n   218\t\tname := r.PathValue(\"name\")\r\n   219\t\ttmpl, ok := h.Templates.Get(name)\r\n"]
[2600.582913, "o", "   220\t\tif !ok {\r\n   221\t\t\twriteError(w, http.StatusNotFound, \"template %q not found\", name)\r\n   222\t\t\treturn\r\n   223\t\t}\r\n   224\t\tvar req struct {\r\n   225\t\t\tInput  map[string]interface{} `json:\"input\"`\r\n   226\t\t\tParams map[string]interface{} `json:\"params\"`\r\n   227\t\t}\r\n   228\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n   229\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n   230\t\t\treturn\r\n   231\t\t}\r\n   232\t\tp, resolvedParams, defaultsUsed, err := substituteParameters(tmpl, req.Params)\r\n   233\t\tif err != nil {\r\n   234\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n   235"]
[2600.582993, "o", "\t\t\treturn\r\n   236\t\t}\r\n   237\t\tif req.Input == nil {\r\n   238\t\t\treq.Input = make(map[string]interface{})\r\n   239\t\t}\r\n"]
[2600.583114, "o", "   240\t\tresult, err := h.Pipeline.Execute(p, req.Input)\r\n   241\t\tif err != nil {\r\n   242\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n   243\t\t\treturn\r\n   244\t\t}\r\n   245\t\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n   246\t\t\t\"template_info\": map[string]interface{}{\r\n   247\t\t\t\t\"template_name\":  name,\r\n   248\t\t\t\t\"resolved_params\": resolvedParams,\r\n   249\t\t\t\t\"defaults_used\":  defaultsUsed,\r\n   250\t\t\t},\r\n"]
