[5664.497763, "o", "\t\tvar result float64\r\n   180\t\tswitch operation {\r\n   181\t\tcase \"sum\":\r\n   182\t\t\tfor _, v := range values {\r\n   183\t\t\t\tresult += v\r\n   184\t\t\t}\r\n   185\t\tcase \"mean\":\r\n   186\t\t\tfor _, v := range values {\r\n   187\t\t\t\tresult += v\r\n   188\t\t\t}\r\n"]
[5664.497831, "o", "   189\t\t\tresult /= float64(len(values))\r\n   190\t\tcase \"count\":\r\n   191\t\t\tresult = float64(len(values))\r\n   192\t\tcase \"min\":\r\n   193\t\t\tresult = values[0]\r\n   194\t\t\tfor _, v := range values[1:] {\r\n   195\t\t\t\tif v < result {\r\n   196\t\t\t\t\tresult = v\r\n"]
