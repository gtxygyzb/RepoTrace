[4624.347624, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4624.347677, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4624.347732, "o", "> "]
[4624.34797, "o", "func removeEmptyStrings(in []string) []string {\r\n\u001b[?2004l\r"]
[4624.348025, "o", "\u001b[?2004h> "]
[4624.34821, "o", "\\tout := make([]string, 0, len(in))\r\n\u001b[?2004l\r"]
[4624.348265, "o", "\u001b[?2004h> "]
[4624.348395, "o", "\\tfor _, s := range in {\r\n\u001b[?2004l\r"]
[4624.348449, "o", "\u001b[?2004h> "]
[4624.348549, "o", "\\t\\tif s != \"\" {\r\n\u001b[?2004l\r"]
[4624.348604, "o", "\u001b[?2004h> "]
[4624.348753, "o", "\\t\\t\\tout = append(out, s)\r\n\u001b[?2004l\r"]
[4624.348808, "o", "\u001b[?2004h> "]
[4624.348878, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4624.348935, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4624.348989, "o", "> "]
[4624.349054, "o", "\\treturn out\r\n\u001b[?2004l\r\u001b[?2004h"]
[4624.349109, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4624.349164, "o", "> ''')\r\n\u001b[?2004l\r"]
[4624.349218, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4624.349273, "o", "\u001b[?2004h> "]
[4624.349326, "o", "insert = '''\r\n\u001b[?2004l\r"]
[4624.349381, "o", "\u001b[?2004h> "]
[4624.349562, "o", "// --- Experiment Cloning Handler ---\r\n\u001b[?2004l\r"]
[4624.349618, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4624.349672, "o", "\u001b[?2004h> "]
[4624.350068, "o", "func (h *Handlers) CloneExperiment(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[4624.350124, "o", "\u001b[?2004h> "]
[4624.350322, "o", "\\tsourceName := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[4624.350378, "o", "\u001b[?2004h> "]
[4624.35048, "o", "\\tvar req struct {\r\n\u001b[?2004l\r"]
[4624.350533, "o", "\u001b[?2004h> "]
[4624.350726, "o", "\\t\\tNewName string `json:\"new_name\"`\r\n\u001b[?2004l\r"]
[4624.350781, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[4624.350847, "o", "\u001b[?2004h> "]
[4624.351191, "o", "\\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[?2004l\r"]
[4624.351247, "o", "\u001b[?2004h> "]
[4624.351655, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\u001b[?2004l\r"]
[4624.351711, "o", "\u001b[?2004h> "]
[4624.351771, "o", "\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h"]
[4624.351827, "o", "> \\t}\r\n\u001b[?2004l\r"]
[4624.35189, "o", "\u001b[?2004h> "]
[4624.352004, "o", "\\tif req.NewName == \"\" {\r\n\u001b[?2004l\r"]
[4624.352062, "o", "\u001b[?2004h> "]
[4624.352405, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"new_name is required\")\r\n\u001b[?2004l\r"]
[4624.352459, "o", "\u001b[?2004h> "]
[4624.352519, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[4624.352574, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[4624.352632, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4624.352687, "o", "\u001b[?2004h> "]
[4624.353061, "o", "\\texp, err := h.Experiment.CloneExperiment(sourceName, req.NewName)\r\n\u001b[?2004l\r"]
[4624.353118, "o", "\u001b[?2004h> "]
[4624.3532, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[4624.353255, "o", "\u001b[?2004h> "]
[4624.353512, "o", "\\t\\tif strings.Contains(err.Error(), \"not found\") {\r\n\u001b[?2004l\r"]
[4624.353566, "o", "\u001b[?2004h> "]
[4624.353828, "o", "\\t\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[4624.353895, "o", "\u001b[?2004h> "]
[4624.353949, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\rr"]
[4624.354005, "o", "\u001b[?2004h> \\t\\t}\r\n"]
[4624.35406, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4624.354378, "o", "\\t\\tif strings.Contains(err.Error(), \"already exists\") {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4624.354432, "o", "> "]
[4624.354594, "o", "\\t\\t\\twriteError(w, http.StatusConflict, \"%v\", err)\r\n\u001b[?2004l\r"]
[4624.354648, "o", "\u001b[?2004h> "]
[4624.354702, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4624.354758, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4624.354964, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\u001b[?2004l\r"]
[4624.35502, "o", "\u001b[?2004h> "]
[4624.355075, "o", "\\t\\treturn\r\n\u001b[?2004l\r\r\n\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[4624.35513, "o", "\u001b[?2004h> "]
[4624.355268, "o", "\\twriteJSON(w, http.StatusCreated, exp)\r\n\u001b[?2004l\r"]
[4624.355323, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4624.355378, "o", "\u001b[?2004h> "]
[4624.355543, "o", "// --- Experiment Run Bulk Tagging Handler ---\r\n\u001b[?2004l\r"]
[4624.355599, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r=\u001b[?2004h> "]
[4624.355882, "o", "func (h *Handlers) BulkTagRuns(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[4624.355939, "o", "\u001b[?2004h> "]
[4624.356046, "o", "\\texpName := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[4624.3561, "o", "\u001b[?2004h> "]
[4624.356153, "o", "\\tvar req struct {\r\n\u001b[?2004l\r"]
[4624.356207, "o", "\u001b[?2004h> "]
[4624.356358, "o", "\\t\\tRunIDs []string          `json:\"run_ids\"`\r\n\u001b[?2004l\r"]
[4624.356412, "o", "\u001b[?2004h> "]
[4624.356552, "o", "\\t\\tTags   map[string]string `json:\"tags\"`\r\n\u001b[?2004l\r"]
[4624.356606, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[4624.35666, "o", "\u001b[?2004h> "]
[4624.356889, "o", "\\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[?2004l\r"]
[4624.356945, "o", "\u001b[?2004h> "]
[4624.357198, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\u001b[?2004l\r"]
[4624.357268, "o", "\u001b[?2004h> \\t\\treturn\r\n\u001b[?2004l\r"]
[4624.357353, "o", "\u001b[?2004h> "]
[4624.357414, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4624.357477, "o", "\\tif len(req.RunIDs) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4624.357728, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"run_ids is required\")\r\n\u001b[?2004l\r"]
[4624.357784, "o", "\u001b[?2004h> \\t\\treturn\r\n"]
[4624.357838, "o", "\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[4624.357922, "o", "\u001b[?2004h"]
[4624.391804, "o", "> "]
[4624.392016, "o", "\\tif len(req.Tags) == 0 {\r\n\u001b[?2004l\r"]
[4624.392077, "o", "\u001b[?2004h> "]
[4624.392485, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"tags is required\")\r\n\u001b[?2004l\r"]
[4624.39255, "o", "\u001b[?2004h> "]
[4624.392624, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[4624.392684, "o", "\u001b[?2004h> "]
[4624.392737, "o", "\\t}\r\n\u001b[?2004l\r"]
[4624.392793, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4624.392849, "o", "\u001b[?2004h> "]
[4624.393414, "o", "\\tupdated, notFound, err := h.Experiment.BulkTagRuns(expName, req.RunIDs, req.Tags)\r\n\u001b[?2004l\r"]
[4624.393476, "o", "\u001b[?2004h> "]
[4624.393595, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[4624.393657, "o", "\u001b[?2004h> "]
[4624.394017, "o", "\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[4624.394104, "o", "\u001b[?2004h> "]
[4624.39417, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[4624.394228, "o", "\u001b[?2004h> "]
[4624.394284, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4624.39434, "o", "> "]
[4624.394465, "o", "\\tif notFound == nil {\r\n\u001b[?2004l\r"]
[4624.394526, "o", "\u001b[?2004h> "]
[4624.394715, "o", "\\t\\tnotFound = []string{}\r\n\u001b[?2004l\r"]
[4624.394772, "o", "\u001b[?2004h> "]
[4624.394827, "o", "\\t}\r\n\u001b[?2004l\r"]
[4624.394893, "o", "\u001b[?2004h> "]
[4624.39525, "o", "\\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[?2004l\r"]
[4624.395318, "o", "\u001b[?2004h> "]
[4624.39551, "o", "\\t\\t\"updated\":      updated,\r\n\u001b[?2004l\r"]
[4624.395575, "o", "\u001b[?2004h> "]
[4624.395791, "o", "\\t\\t\"not_found\":    notFound,\r\n\u001b[?2004l\r"]
[4624.395848, "o", "\u001b[?2004h> "]
[4624.39606, "o", "\\t\\t\"tags_applied\": req.Tags,\r\n\u001b[?2004l\r"]
[4624.39612, "o", "\u001b[?2004h> "]
[4624.396188, "o", "\\t})\r\n\u001b[?2004l\r"]
[4624.396244, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4624.396301, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4624.396357, "o", "\u001b[?2004h> "]
[4624.396652, "o", "// --- Model Version Filtering Handler ---\r\n\u001b[?2004l\r"]
[4624.396715, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[4624.39677, "o", "\u001b[?2004h> "]
[4624.397334, "o", "func (h *Handlers) ListModelVersions(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[4624.397396, "o", "\u001b[?2004h> "]
[4624.397619, "o", "\\tmodelName := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[4624.397675, "o", "\u001b[?2004h> "]
[4624.397992, "o", "\\tstageFilter := r.URL.Query().Get(\"stage\")\r\n\u001b[?2004l\r"]
[4624.398049, "o", "\u001b[?2004h> "]
[4624.39841, "o", "\\tminMetricParam := r.URL.Query().Get(\"min_metric\")\r\n\u001b[?2004l\r"]
[4624.398475, "o", "\u001b[?2004h> \r\n"]
[4624.398531, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4624.398703, "o", "\\tvar metricName string\r\n\u001b[?2004l\r"]
[4624.398766, "o", "\u001b[?2004h> "]
[4624.398973, "o", "\\tvar metricThreshold float64\r\n\u001b[?2004l\r"]
[4624.399043, "o", "\u001b[?2004h> "]
[4624.399236, "o", "\\tif minMetricParam != \"\" {\r\n\u001b[?2004l\r"]
[4624.399293, "o", "\u001b[?2004h> "]
[4624.399638, "o", "\\t\\tparts := strings.SplitN(minMetricParam, \":\", 2)\r\n\u001b[?2004l\r"]
[4624.399697, "o", "\u001b[?2004h> "]
[4624.400015, "o", "\\t\\tif len(parts) != 2 || parts[0] == \"\" {\r\n\u001b[?2004l\r"]
[4624.400072, "o", "\u001b[?2004h> "]
[4624.400614, "o", "\\t\\t\\twriteError(w, http.StatusBadRequest, \"invalid min_metric format, expected name:value\")\r\n\u001b[?2004l\r"]
[4624.400691, "o", "\u001b[?2004h> "]
[4624.400774, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r"]
[4624.400849, "o", "\u001b[?2004h> "]
[4624.400944, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4624.401182, "o", "\\t\\tval, err := strconv.ParseFloat(parts[1], 64)\r\n\u001b[?2004l\r"]
[4624.401232, "o", "\u001b[?2004h> "]
[4624.401356, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[4624.401412, "o", "\u001b[?2004h> "]
[4624.401864, "o", "\\t\\t\\twriteError(w, http.StatusBadRequest, \"invalid min_metric value: %v\", err)\r\n\u001b[?2004l\r"]
[4624.401929, "o", "\u001b[?2004h> "]
[4624.401999, "o", "\\t\\t\\treturn\r\n\u001b[?2004l\r"]
[4624.402046, "o", "\u001b[?2004h> "]
[4624.402093, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[4624.402142, "o", "\u001b[?2004h> "]
[4624.402301, "o", "\\t\\tmetricName = parts[0]\r\n\u001b[?2004l\r"]
[4624.402349, "o", "\u001b[?2004h> "]
[4624.402508, "o", "\\t\\tmetricThreshold = val\r\n\u001b[?2004l\r"]
[4624.402555, "o", "\u001b[?2004h> "]
[4624.402606, "o", "\\t}\r\n\u001b[?2004l\r"]
[4624.402659, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4624.402714, "o", "\u001b[?2004h> "]
[4624.402978, "o", "\\tmodel, err := h.Registry.GetModel(modelName)\r\n\u001b[?2004l\r"]
[4624.403025, "o", "\u001b[?2004h> "]
[4624.40314, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[4624.403185, "o", "\u001b[?2004h> "]
[4624.403479, "o", "\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[4624.403523, "o", "\u001b[?2004h> "]
[4624.403604, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
[4624.403643, "o", "\u001b[?2004h"]
[4624.403687, "o", "> \\t}\r\n\u001b[?2004l\r"]
[4624.403734, "o", "\u001b[?2004h> \r\n"]
[4624.40378, "o", "\u001b[?2004l\r\u001b[?2004h"]
[4624.403825, "o", "> "]
[4624.404172, "o", "\\tversions := make([]*registry.Version, 0, len(model.Versions))\r\n\u001b[?2004l\r"]
[4624.404217, "o", "\u001b[?2004h> "]
[4624.404441, "o", "\\tfor _, v := range model.Versions {\r\n\u001b[?2004l\r"]
[4624.404486, "o", "\u001b[?2004h> "]
[4624.404838, "o", "\\t\\tif stageFilter != \"\" && string(v.Stage) != stageFilter {\r\n\u001b[?2004l\r"]
[4624.404883, "o", "\u001b[?2004h"]
[4624.404921, "o", "> "]
[4624.40499, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[4624.405029, "o", "\u001b[?2004h"]
[4624.405075, "o", "> \\t\\t}\r\n\u001b[?2004l\r"]
[4624.405119, "o", "\u001b[?2004h"]
[4624.405157, "o", "> "]
[4624.405289, "o", "\\t\\tif metricName != \"\" {\r\n\u001b[?2004l\r"]
[4624.405326, "o", "\u001b[?2004h"]
[4624.405365, "o", "> "]
[4624.405567, "o", "\\t\\t\\tval, ok := v.Metrics[metricName]\r\n\u001b[?2004l\r"]
[4624.405604, "o", "\u001b[?2004h"]
[4624.405641, "o", "> "]
[4624.405858, "o", "\\t\\t\\tif !ok || val < metricThreshold {\r\n\u001b[?2004l\r"]
[4624.405912, "o", "\u001b[?2004h> "]
[4624.406013, "o", "\\t\\t\\t\\tcontinue\r\n\u001b[?2004l\r"]
[4624.406051, "o", "\u001b[?2004h"]
[4624.406096, "o", "> "]
[4624.406134, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[4624.406178, "o", "\u001b[?2004h> "]
[4624.406216, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[4624.406252, "o", "\u001b[?2004h"]
[4624.406289, "o", "> "]
[4624.406471, "o", "\\t\\tversions = append(versions, v)\r\n\u001b[?2004l\r"]
[4624.406509, "o", "\u001b[?2004h"]
[4624.406547, "o", "> \\t}\r\n"]
[4624.406585, "o", "\u001b[?2004l\r\u001b[?2004h"]
[4624.406622, "o", "> \r\n\u001b[?2004l\r"]
[4624.406659, "o", "\u001b[?2004h"]
[4624.406696, "o", "> "]
[4624.406869, "o", "\\tsort.Slice(versions, func(i, j int) bool {\r\n\u001b[?2004l\r"]
[4624.406907, "o", "\u001b[?2004h> "]
[4624.40713, "o", "\\t\\treturn versions[i].Number > versions[j].Number\r\n\u001b[?2004l\r"]
[4624.407168, "o", "\u001b[?2004h> "]
[4624.40721, "o", "\\t})\r\n\u001b[?2004l\r\u001b[?2004h"]
[4624.407267, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4624.407506, "o", "\\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[?2004l\r\u001b[?2004h"]
[4624.407543, "o", "> "]
[4624.407653, "o", "\\t\\t\"model\":    modelName,\r\n\u001b[?2004l\r"]
[4624.40769, "o", "\u001b[?2004h> "]
[4624.407801, "o", "\\t\\t\"versions\": versions,\r\n\u001b[?2004l\r"]
[4624.407838, "o", "\u001b[?2004h> "]
[4624.407973, "o", "\\t\\t\"count\":   len(versions),\r\n\u001b[?2004l\r"]
[4624.408011, "o", "\u001b[?2004h> "]
[4624.408049, "o", "\\t})\r\n\u001b[?2004l\r\u001b[?2004h"]
[4624.408095, "o", "> }\r\n\u001b[?2004l\r"]
[4624.408132, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4624.408168, "o", "\u001b[?2004h> "]
[4624.408308, "o", "// --- Model Lineage Handler ---\r\n\u001b[?2004l\r"]
[4624.408345, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4624.408382, "o", "\u001b[?2004h> "]
[4624.4087, "o", "func (h *Handlers) ModelLineage(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r"]
[4624.408737, "o", "\u001b[?2004h> "]
[4624.40889, "o", "\\tmodelName := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[4624.408927, "o", "\u001b[?2004h> "]
