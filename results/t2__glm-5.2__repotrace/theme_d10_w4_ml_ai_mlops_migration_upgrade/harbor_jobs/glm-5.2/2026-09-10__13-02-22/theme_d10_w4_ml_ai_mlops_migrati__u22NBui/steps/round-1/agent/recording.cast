[1164.340945, "o", "   128\tfunc (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, int, error) {\r\n   129\t\tt.mu.RLock()\r\n   130\t\tdefer t.mu.RUnlock()\r\n   131\t\r\n"]
[1164.341015, "o", "   132\t\texp, exists := t.experiments[experimentName]\r\n   133\t\tif !exists {\r\n   134\t\t\treturn 0, 0, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   135\t\t}\r\n   136\t\r\n   137\t\tif len(exp.Runs) == 0 {\r\n   138\t\t\treturn 0, 0, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n   139\t\t}\r\n   140\t\r\n   141\t"]
[1164.34108, "o", "\tvar values []float64\r\n   142\t\tvar weights []float64\r\n   143\t\tfor _, run := range exp.Runs {\r\n   144\t\t\tvalue, ok := run.Metrics[metricName]\r\n   145\t\t\tif !ok {\r\n   146\t\t\t\tcontinue\r\n   147\t\t\t}\r\n   148\t\t\tvalues = append(values, value)\r\n   149\t\t\tif aggType == \"weighted_mean\" {\r\n"]
[1164.341145, "o", "   150\t\t\t\tweight, ok := run.Parameters[weightParam]\r\n   151\t\t\t\tif !ok {\r\n   152\t\t\t\t\tcontinue\r\n   153\t\t\t\t}\r\n   154\t\t\t\tweights = append(weights, weight)\r\n   155\t\t\t}\r\n   156\t\t}\r\n   157\t\r\n   158\t\tif len(values) == 0 {\r\n"]
[1164.341206, "o", "   159\t\t\treturn 0, 0, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n   160\t\t}\r\n   161\t\r\n   162\t\tswitch aggType {\r\n   163\t\tcase \"mean\":\r\n   164\t\t\tsum := 0.0\r\n   165\t\t\tfor _, v := range values {\r\n"]
[1164.341266, "o", "   166\t\t\t\tsum += v\r\n   167\t\t\t}\r\n   168\t\t\treturn sum / float64(len(values)), len(values), nil\r\n   169\t\r\n   170\t\tcase \"median\":\r\n   171\t\t\tsorted := sortedCopy(values)\r\n"]
