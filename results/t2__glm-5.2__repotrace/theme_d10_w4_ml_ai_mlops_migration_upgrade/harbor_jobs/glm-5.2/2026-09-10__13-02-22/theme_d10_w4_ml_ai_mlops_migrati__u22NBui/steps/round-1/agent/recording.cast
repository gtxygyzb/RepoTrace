[961.390176, "o", "sed -n '1,320p' internal/pipeline/steps.go\r\n\u001b[?2004l\r"]
[961.393236, "o", "package pipeline\r\n\r\nimport (\r\n\t\"fmt\"\r\n"]
[961.393306, "o", "\t\"math\"\r\n\t\"sort\"\r\n)\r\n\r\n// ExecuteTransform applies a data transformation.\r\n// Supported modes: scale, offset, normalize, identity, clip, log.\r\nfunc ExecuteTransform(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"transform: missing or invalid 'data' field in input\")\r\n\t}\r\n\r\n\tmode, _ := config[\"mode\"].(string)\r\n\tif mode == \"\" {\r\n\t\t"]
[961.393378, "o", "return nil, fmt.Errorf(\"transform: missing 'mode' in config\")\r\n\t}\r\n\r\n\tresult := make([]interface{}, len(data))\r\n\r\n\tswitch mode {\r\n\tcase \"scale\":\r\n\t\tfactor, _ := config[\"factor\"].(float64)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform scale: element %d: %w\", i, err)\r\n\t\t\t}\r\n"]
[961.393442, "o", "\t\t\tresult[i] = val * factor\r\n\t\t}\r\n\r\n\tcase \"offset\":\r\n"]
[961.393504, "o", "\t\toffset, _ := config[\"offset\"].(float64)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform offset: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t\t\tresult[i] = val + offset\r\n\t\t}\r\n\r\n\tcase \"normalize\":\r\n\t\tif len(data) == 0 {\r\n\t\t\treturn map[string]interface{}{\"data\": result}, nil\r\n\t\t}\r\n"]
[961.393563, "o", "\t\tminVal, maxVal := findMinMax(data)\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform normalize: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t\t\tif maxVal == minVal {\r\n"]
[961.393619, "o", "\t\t\t\tresult[i] = 0.0\r\n\t\t\t} else {\r\n\t\t\t\tresult[i] = (val - minVal) / (maxVal - minVal)\r\n\t\t\t}\r\n\t\t}\r\n\r\n"]
[961.393681, "o", "\tcase \"identity\":\r\n\t\tcopy(result, data)\r\n\r\n\tcase \"clip\":\r\n\t\tlow, _ := config[\"low\"].(float64)\r\n\t\thigh, _ := config[\"high\"].(float64)\r\n\t\tfor i, v := range data {\r\n"]
[961.393744, "o", "\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform clip: element %d: %w\", i, err)\r\n\t\t\t}\r\n"]
[961.393784, "o", "\t\t\tif val < low {\r\n\t\t\t\tval = low\r\n\t\t\t}\r\n\t\t\tif val > high {\r\n\t\t\t\tval = high\r\n\t\t\t}\r\n\t\t\tresult[i] = val\r\n"]
[961.393877, "o", "\t\t}\r\n\r\n\tcase \"log\":\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform log: element %d: %w\", i, err)\r\n\t\t\t}\r\n\t\t\tif val <= 0 {\r\n\t\t\t\treturn nil, fmt.Errorf(\"transform log: element %d is non-positive (%f)\", i, val)\r\n\t\t\t}\r\n\t\t\tresult[i] = math.Log(val)\r\n"]
[961.393941, "o", "\t\t}\r\n\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"transform: unknown mode %q\", mode)\r\n\t}\r\n\r\n\treturn map[string]interface{}{\"data\": result}, nil\r\n}\r\n"]
[961.393999, "o", "\r\n// ExecuteValidate checks data against schema constraints.\r\nfunc ExecuteValidate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"validate: missing or invalid 'data' field\")\r\n\t}\r\n\r\n\tvar errors []interface{}\r\n\r\n\t// Check min_value constraint\r\n"]
[961.394056, "o", "\tif minVal, ok := config[\"min_value\"].(float64); ok {\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: not a number\", i))\r\n\t\t\t\tcontinue\r\n\t"]
[961.394115, "o", "\t\t}\r\n\t\t\tif val < minVal {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f below minimum %f\", i, val, minVal))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[961.394171, "o", "\r\n\t// Check max_value constraint\r\n\tif maxVal, ok := config[\"max_value\"].(float64); ok {\r\n\t\tfor i, v := range data {\r\n\t\t\tval, err := toFloat(v)\r\n\t\t\tif err != nil {\r\n"]
[961.39423, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif val > maxVal {\r\n\t\t\t\terrors = append(errors, fmt.Sprintf(\"element %d: value %f above maximum %f\", i, val, maxVal))\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[961.394285, "o", "\r\n\t// Check min_count constraint\r\n\tif minCount, ok := config[\"min_count\"].(float64); ok {\r\n\t\tif float64(len(data)) < minCount {\r\n\t\t\terrors = append(errors, fmt.Sprintf(\"data has %d elements, minimum required is %d\", len(data), int(minCount)))\r\n\t\t}\r\n\t}\r\n"]
[961.394341, "o", "\r\n\tvalid := len(errors) == 0\r\n\treturn map[string]interface{}{\r\n\t\t\"valid\":  valid,\r\n\t\t\"errors\": errors,\r\n\t\t\"data\":   data,\r\n\t}, nil\r\n"]
[961.394397, "o", "}\r\n\r\n// ExecuteAggregate computes aggregations over input data.\r\n// Supported operations: sum, mean, count, min, max.\r\nfunc ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"aggregate: missing or invalid 'data' field\")\r\n"]
[961.394435, "o", "\t}\r\n\r\n\toperation, _ := config[\"operation\"].(string)\r\n\tif operation == \"\" {\r\n"]
[961.394514, "o", "\t\treturn nil, fmt.Errorf(\"aggregate: missing 'operation' in config\")\r\n\t}\r\n\r\n\tvalues := make([]float64, 0, len(data))\r\n\tfor _, v := range data {\r\n\t\tval, err := toFloat(v)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvalues = append(values, val)\r\n\t}\r\n\r\n"]
[961.39457, "o", "\tif len(values) == 0 {\r\n\t\treturn map[string]interface{}{\"result\": 0.0, \"count\": 0.0}, nil\r\n\t}\r\n\r\n\tvar result float64\r\n\tswitch operation {\r\n\tcase \"sum\":\r\n\t\tfor _, v := range values {\r\n"]
[961.394629, "o", "\t\t\tresult += v\r\n\t\t}\r\n\tcase \"mean\":\r\n\t\tfor _, v := range values {\r\n\t\t\tresult += v\r\n"]
[961.394692, "o", "\t\t}\r\n\t\tresult /= float64(len(values))\r\n\tcase \"count\":\r\n\t\tresult = float64(len(values))\r\n"]
[961.394751, "o", "\tcase \"min\":\r\n\t\tresult = values[0]\r\n\t\tfor _, v := range values[1:] {\r\n\t\t\tif v < result {\r\n\t\t\t\tresult = v\r\n\t\t\t}\r\n\t\t}\r\n\tcase \"max\":\r\n\t\tresult = values[0]\r\n\t\tfor _, v := range values[1:] {\r\n\t\t\tif v > result {\r\n\t\t"]
[961.394807, "o", "\t\tresult = v\r\n\t\t\t}\r\n\t\t}\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"aggregate: unknown operation %q\", operation)\r\n\t}\r\n"]
[961.394875, "o", "\r\n\treturn map[string]interface{}{\r\n\t\t\"result\": result,\r\n\t\t\"count\":  float64(len(values)),\r\n\t\t\"data\":   data,\r\n"]
[961.394932, "o", "\t}, nil\r\n}\r\n\r\n// ExecuteExport formats data for output.\r\n// Supported formats: json, csv, summary.\r\nfunc ExecuteExport(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tformat, _ := config[\"format\"].(string)\r\n\tif format == \"\" {\r\n\t\tformat = \"json\"\r\n\t}\r\n\r\n\t"]
[961.394993, "o", "switch format {\r\n\tcase \"json\":\r\n"]
[961.395049, "o", "\t\treturn map[string]interface{}{\r\n\t\t\t\"format\": \"json\",\r\n\t\t\t\"data\":   input,\r\n\t\t}, nil\r\n\r\n\tcase \"summary\":\r\n\t\tdata, ok := input[\"data\"].([]interface{})\r\n\t\tcount := 0\r\n\t\tif ok {\r\n\t\t\tcount = len(data)\r\n\t\t}\r\n"]
[961.395104, "o", "\t\treturn map[string]interface{}{\r\n\t\t\t\"format\": \"summary\",\r\n\t\t\t\"count\":  float64(count),\r\n\t\t\t\"data\":   input,\r\n\t\t}, nil\r\n\r\n\tcase \"csv\":\r\n"]
[961.395163, "o", "\t\tdata, ok := input[\"data\"].([]interface{})\r\n\t\tif !ok {\r\n\t\t\treturn map[string]interface{}{\"format\": \"csv\", \"content\": \"\"}, nil\r\n\t\t}\r\n\t\tcsv := \"\"\r\n\t\tfor i, v := range data {\r\n"]
[961.395218, "o", "\t\t\tif i > 0 {\r\n\t\t\t\tcsv += \",\"\r\n\t\t\t}\r\n\t\t\tcsv += fmt.Sprintf(\"%v\", v)\r\n\t\t}\r\n\t\treturn map[string]interface{}{\r\n\t\t\t\"format\":  \"csv\",\r\n"]
[961.395279, "o", "\t\t\t\"content\": csv,\r\n\t\t\t\"data\":    data,\r\n\t\t}, nil\r\n\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"export: unknown format %q\", format)\r\n\t}\r\n}\r\n\r\n"]
[961.395344, "o", "// ExecuteFilter selects elements from the data array based on a comparison condition.\r\n// Supported modes: gt, lt, gte, lte, eq, ne.\r\nfunc ExecuteFilter(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n\tdata, ok := input[\"data\"].([]interface{})\r\n\tif !ok {\r\n"]
[961.395406, "o", "\t\treturn nil, fmt.Errorf(\"filter: missing or invalid 'data' field in input\")\r\n\t}\r\n\r\n\tmode, _ := config[\"mode\"].(string)\r\n\tif mode == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"filter: missing 'mode' in config\")\r\n\t}\r\n\tthreshold, _ := config[\"threshold\"].(float64)\r\n\r\n\tvar result []interface{}\r\n\tfor _, v := range data {\r\n\t\tval, err := toFloat(v)\r\n\t\tif err != nil {\r\n"]
[961.395468, "o", "\t\t\tcontinue\r\n\t\t}\r\n"]
[961.39553, "o", "\t\tvar keep bool\r\n\t\tswitch mode {\r\n\t\tcase \"gt\":\r\n\t\t\tkeep = val > threshold\r\n\t\tcase \"lt\":\r\n\t\t\tkeep = val < threshold\r\n\t\tcase \"gte\":\r\n\t\t\tkeep = val >= threshold\r\n\t\tcase \"lte\":\r\n"]
[961.395587, "o", "\t\t\tkeep = val <= threshold\r\n\t\tcase \"eq\":\r\n\t\t\tkeep = val == threshold\r\n\t\tcase \"ne\":\r\n\t\t\tkeep = val != threshold\r\n\t\tdefault:\r\n\t\t\treturn nil, fmt.Errorf(\"filter: unknown mode %q\", mode)\r\n\t\t}\r\n\t\tif keep {\r\n\t\t\tresult = append(result, val)\r\n\t\t}\r\n"]
[961.395647, "o", "\t}\r\n\r\n\tif result == nil {\r\n\t\tresult = []interface{}{}\r\n\t}\r\n\treturn map[string]interface{}{\"data\": result}, nil\r\n"]
[961.395704, "o", "}\r\n\r\n// Helper functions\r\n\r\nfunc toFloat(v interface{}) (float64, error) {\r\n\tswitch val := v.(type) {\r\n\tcase float64:\r\n\t\treturn val, nil\r\n"]
[961.395761, "o", "\tcase int:\r\n"]
