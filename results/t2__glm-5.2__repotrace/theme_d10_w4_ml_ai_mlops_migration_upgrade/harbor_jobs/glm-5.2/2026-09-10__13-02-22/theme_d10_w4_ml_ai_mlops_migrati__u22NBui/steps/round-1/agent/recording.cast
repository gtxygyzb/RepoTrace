[2640.168848, "o", "cat main.go\r\n\u001b[?2004l\r"]
[2640.171166, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"log\"\r\n\t\"net/http\"\r\n\t\"os\"\r\n\r\n\t\"gomlops/internal/api\"\r\n\t\"gomlops/internal/experiment\"\r\n\t\"gomlops/internal/pipeline\"\r\n\t\"gomlops/internal/registry\"\r\n\t\"gomlops/internal/serving\"\r\n)\r\n\r\n// Config holds the server configuration.\r\ntype Config struct {\r\n\tPort    int    `json:\"port\"`\r\n\tDataDir string `json:\"data_dir\"`\r\n}\r\n\r\nfunc main() {\r\n\tconfigPath := flag.String(\"config\", \"/app/configs/config.json\", \"path to config file\")\r\n\tflag.Parse()\r\n\r\n\tcfg, err := loadConfig(*configPath)\r\n\tif err != nil {\r\n\t\tlog.Fatalf(\"Failed to load config: %v\", err)\r\n\t}\r\n\r\n\treg, err := registry.NewRegistry(cfg.DataDir + \"/registry\")\r\n"]
[2640.171282, "o", "\tif err != nil {\r\n\t\tlog.Fatalf(\"Failed to initialize registry: %v\", err)\r\n\t}\r\n\r\n\teng := pipeline.NewEngine()\r\n\ttracker := experiment.NewTracker(cfg.DataDir + \"/experiments\")\r\n\tsrv := serving.NewServer(reg)\r\n\r\n\trouter := api.NewRouter(reg, eng, tracker, srv)\r\n\r\n\taddr := fmt.Sprintf(\":%d\", cfg.Port)\r\n\tlog.Printf(\"gomlops server starting on %s\", addr)\r\n\tlog.Printf(\"data directory: %s\", cfg.DataDir)\r\n\tif err := http.ListenAndServe(addr, router); err != nil {\r\n\t\tlog.Fatalf(\"Server failed: %v\", err)\r\n\t}\r\n}\r\n\r\nfunc loadConfig(path string) (*Config, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn &Config{Port: 8080, DataDir: \"/app/data\"}, nil\r\n\t}\r\n\tvar cfg Config\r\n\tif err := json.Unmarshal(data, &cfg); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"parse config: %w\", err)\r\n\t}\r\n\tif cfg.Port == 0 {\r\n\t\tcfg.Port = 8080\r\n\t}\r\n\tif cfg.DataDir == \"\" {\r\n\t\tcfg.DataDir = \"/app/data\"\r\n\t}\r\n\treturn &cfg, nil\r\n}\r\n"]
