[1504.22305, "o", "\\t\\treturn percentile(sorted, 0.99), len(values), runIDs, nil\r\n\u001b[?2004l\r"]
[1504.223107, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1504.223163, "o", "\u001b[?2004h> "]
[1504.223237, "o", "\\tcase \"weighted_mean\":\r\n\u001b[?2004l\r"]
[1504.223292, "o", "\u001b[?2004h> "]
[1504.22338, "o", "\\t\\tif weightParam == \"\" {\r\n\u001b[?2004l\r"]
[1504.223435, "o", "\u001b[?2004h> "]
[1504.223708, "o", "\\t\\t\\treturn 0, 0, nil, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\n\u001b[?2004l\r"]
[1504.223763, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[1504.223817, "o", "\u001b[?2004h> "]
[1504.22392, "o", "\\t\\tif len(weights) == 0 {\r\n\u001b[?2004l\r"]
[1504.223977, "o", "\u001b[?2004h> "]
[1504.224364, "o", "\\t\\t\\treturn 0, 0, nil, fmt.Errorf(\"no runs with metric %q and weight parameter %q\", metricName, weightParam)\r\n\u001b[?2004l\r"]
[1504.224419, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[1504.224473, "o", "\u001b[?2004h> "]
[1504.224601, "o", "\\t\\tif len(weights) != len(values) {\r\n\u001b[?2004l\r"]
[1504.224656, "o", "\u001b[?2004h> "]
[1504.224952, "o", "\\t\\t\\treturn 0, 0, nil, fmt.Errorf(\"mismatch between metric values and weights\")\r\n\u001b[?2004l\r"]
[1504.225008, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[1504.225065, "o", "\u001b[?2004h> "]
[1504.225139, "o", "\\t\\tweightedSum := 0.0\r\n\u001b[?2004l\r"]
[1504.225195, "o", "\u001b[?2004h> "]
[1504.225255, "o", "\\t\\tweightSum := 0.0\r\n\u001b[?2004l\r"]
[1504.225309, "o", "\u001b[?2004h> "]
[1504.225408, "o", "\\t\\tfor i, v := range values {\r\n\u001b[?2004l\r"]
[1504.225464, "o", "\u001b[?2004h> "]
[1504.225581, "o", "\\t\\t\\tweightedSum += v * weights[i]\r\n\u001b[?2004l\r"]
[1504.225636, "o", "\u001b[?2004h> "]
[1504.225733, "o", "\\t\\t\\tweightSum += weights[i]\r\n\u001b[?2004l\r"]
[1504.225786, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[1504.225841, "o", "\u001b[?2004h> "]
[1504.225932, "o", "\\t\\tif weightSum == 0 {\r\n\u001b[?2004l\r"]
[1504.22599, "o", "\u001b[?2004h> "]
[1504.226246, "o", "\\t\\t\\treturn 0, 0, nil, fmt.Errorf(\"weighted_mean has zero total weight\")\r\n\u001b[?2004l\r"]
[1504.2263, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[1504.226361, "o", "\u001b[?2004h> "]
[1504.226573, "o", "\\t\\treturn weightedSum / weightSum, len(values), runIDs, nil\r\n\u001b[?2004l\r"]
[1504.226628, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1504.226684, "o", "> \\tdefault:\r\n\u001b[?2004l\r"]
[1504.22674, "o", "\u001b[?2004h> "]
[1504.227009, "o", "\\t\\treturn 0, 0, nil, fmt.Errorf(\"unknown aggregation type %q\", aggType)\r\n\u001b[?2004l\r"]
[1504.227066, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
