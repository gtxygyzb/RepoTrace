[6438.218056, "o", "sed -n '1,70p' internal/experiment/experiment.go\r\n\u001b[?2004l\r"]
[6438.221086, "o", "package experiment\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
[6438.221167, "o", "\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\n"]
[6438.221236, "o", "// Experiment groups related runs together.\r\ntype Experiment struct {\r\n\tName      string    `json:\"name\"`\r\n\tRuns      []*Run    `json:\"runs\"`\r\n\tCreatedAt time.Time `json:\"created_at\"`\r\n}\r\n\r\n// Run records a single experiment execution with parameters and metrics.\r\ntype Run struct {\r\n\tID         string             `json:\"id\"`\r\n\tParameters map[string]float64 `json:\"parameters\"`\r\n\tMetrics    map[string]float64 `json:\"metrics\"`\r\n"]
[6438.221306, "o", "\tTags       map[string]string  `json:\"tags\"`\r\n\tCreatedAt  time.Time          `json:\"created_at\"`\r\n}\r\n\r\n"]
[6438.221369, "o", "// Tracker manages experiments and their runs.\r\ntype Tracker struct {\r\n\tmu          sync.RWMutex\r\n\texperiments map[string]*Experiment\r\n\tdataDir     string\r\n\trunCounter  int\r\n}\r\n\r\n// NewTracker creates a new experiment tracker backed by the given data directory.\r\nfunc NewTracker(dataDir string) *Tracker {\r\n\tos.MkdirAll(dataDir, 0755)\r\n\tt := &Tracker{\r\n\t\texperiments: make(map[string]*Experiment),\r\n"]
[6438.221439, "o", "\t\tdataDir:     dataDir,\r\n\t}\r\n\tt.loadAll()\r\n\treturn t\r\n}\r\n\r\n"]
[6438.221498, "o", "// CreateExperiment creates a new experiment with the given name.\r\nfunc (t *Tracker) CreateExperiment(name string) (*Experiment, error) {\r\n\tt.mu.Lock()\r\n\tdefer t.mu.Unlock()\r\n\r\n\tif _, exists := t.experiments[name]; exists {\r\n\t\treturn nil, fmt.Errorf(\"experiment %q already exists\", name)\r\n\t}\r\n\r\n\texp := &Experiment{\r\n\t\tName:      name,\r\n\t"]
[6438.221559, "o", "\tRuns:      make([]*Run, 0),\r\n\t\tCreatedAt: time.Now(),\r\n\t}\r\n\tt.experiments[name] = exp\r\n\tif err := t.saveExperiment(exp); err != nil {\r\n\t\tdelete(t.experiments, name)\r\n"]
[6438.221615, "o", "\t\treturn nil, err\r\n\t}\r\n\treturn exp, nil\r\n"]
[6438.222209, "o", "\u001b[?2004h"]
[6438.222268, "o", "root@n30009:/app# "]
[6438.551826, "i", "sed -n '510,560p' internal/experiment/experiment.go\n"]
[6438.552262, "o", "sed -n '510,560p' internal/experiment/experiment.go\r\n\u001b[?2004l\r"]
[6438.555341, "o", "\t}\r\n}\r\n\r\nfunc matchTags(runTags map[string]string, filters map[string]string) bool {\r\n\tfor k, v := range filters {\r\n\t\t"]
[6438.555415, "o", "if runTags[k] != v {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc (t *Tracker) DeleteRun(experimentName, runID string) error {\r\n\tt.mu.Lock()\r\n\tdefer t.mu.Unlock()\r\n\r\n\texp, exists := t.experiments[experimentName]\r\n"]
[6438.555474, "o", "\tif !exists {\r\n\t\treturn fmt.Errorf(\"experiment %q not found\", experimentName)\r\n\t}\r\n\r\n\tfor i, run := range exp.Runs {\r\n\t\tif run.ID == runID {\r\n\t\t\texp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)\r\n\t\t\treturn t.saveExperiment(exp)\r\n\t\t}\r\n"]
[6438.555545, "o", "\t}\r\n\treturn fmt.Errorf(\"run %q not found in experiment %q\", runID, experimentName)\r\n}\r\n\r\nfunc percentile(sorted []float64, p float64) float64 {\r\n\tn := len(sorted)\r\n\tif n == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tif n == 1 {\r\n\t\treturn sorted[0]\r\n\t}\r\n\t"]
[6438.555602, "o", "rank := p * float64(n-1)\r\n\tlower := int(math.Floor(rank))\r\n\tupper := int(math.Ceil(rank))\r\n\tif lower == upper {\r\n\t\treturn sorted[lower]\r\n\t}\r\n\tfrac := rank - float64(lower)\r\n\treturn sorted[lower]*(1-frac) + sorted[upper]*frac\r\n}\r\n"]
[6438.555658, "o", "\r\nfunc sortedCopy(values []float64) []float64 {\r\n\ts := make([]float64, len(values))\r\n\tcopy(s, values)\r\n"]
[6438.556144, "o", "\u001b[?2004h"]
[6438.556202, "o", "root@n30009:/app# "]
[6438.837902, "i", "sed -n '1,170p' internal/serving/serving.go\n"]
[6438.838295, "o", "sed -n '1,170p' internal/serving/serving.go\r\n\u001b[?2004l\r"]
[6438.841332, "o", "package serving\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"sync\"\r\n\t\"time\"\r\n\r\n"]
[6438.841417, "o", "\t\"gomlops/internal/registry\"\r\n)\r\n\r\n// LoadedModel tracks a model version currently loaded for serving.\r\ntype LoadedModel struct {\r\n\tModelName   string                 `json:\"model_name\"`\r\n\tVersionNum  int                    `json:\"version_num\"`\r\n\tStage       registry.Stage         `json:\"stage\"`\r\n\t"]
[6438.841497, "o", "ModelConfig map[string]interface{} `json:\"model_config\"`\r\n\tLoadedAt    time.Time              `json:\"loaded_at\"`\r\n}\r\n\r\n// InferenceRequest contains the input data for model inference.\r\ntype InferenceRequest struct {\r\n\tModelName string    `json:\"model_name\"`\r\n\tInput     []float64 `json:\"input\"`\r\n}\r\n\r\n// InferenceResponse contains the model prediction results.\r\ntype InferenceResponse struct {\r\n\tModelName   string    `json:\"model_name\"`\r\n\tVersion     int       `json:\"version\"`\r\n\tPredictions []float64 `json:\"predictions\"`\r\n\tLatencyMs   float64   `json:\"latency_ms\"`\r\n}\r\n\r\n// ModelStats tracks inference statistics for a single model.\r\ntype ModelStats struct {\r\n\tRequests   int     `json:\"requests\"`\r\n\tSuccessful int     `json:\"successful\"`\r\n"]
[6438.841565, "o", "\tFailed     int     `json:\"failed\"`\r\n\tLatencySum float64 `json:\"-\"`\r\n}\r\n\r\n// Stats tracks accumulated serving statistics.\r\ntype Stats struct {\r\n\tTotalRequests int\r\n\tSuccessful    int\r\n\tFailed        int\r\n\tLatencySum    float64\r\n\tModels        map[string]*ModelStats\r\n}\r\n\r\n"]
[6438.841628, "o", "// StatsResponse is the public serving statistics representation.\r\ntype StatsResponse struct {\r\n\tTotalRequests int                           `json:\"total_requests\"`\r\n\tSuccessful    int                           `json:\"successful\"`\r\n\tFailed        int                           `json:\"failed\"`\r\n\tAvgLatencyMs  float64                       `json:\"avg_latency_ms\"`\r\n\tModels        map[string]ModelStatsResponse `json:\"models\"`\r\n}\r\n\r\n// ModelStatsResponse is the public model statistics representation.\r\n"]
[6438.841691, "o", "type ModelStatsResponse struct {\r\n\tRequests     int     `json:\"requests\"`\r\n\tSuccessful   int     `json:\"successful\"`\r\n\tFailed       int     `json:\"failed\"`\r\n\tAvgLatencyMs float64 `json:\"avg_latency_ms\"`\r\n\tSuccessRate  float64 `json:\"success_rate\"`\r\n}\r\n\r\n// Server manages model loading and inference.\r\ntype Server struct {\r\n"]
[6438.841755, "o", "\tmu       sync.RWMutex\r\n\tloaded   map[string]*LoadedModel\r\n\tregistry *registry.Registry\r\n\tstats    Stats\r\n}\r\n\r\n// NewServer creates a new serving server backed by the given registry.\r\nfunc NewServer(reg *registry.Registry) *Server {\r\n\treturn &Server{\r\n\t\tloaded:   make(map[string]*LoadedModel),\r\n\t\tregistry: reg,\r\n\t\tstats: Stats{\r\n"]
[6438.841813, "o", "\t\t\tModels: make(map[string]*ModelStats),\r\n\t\t},\r\n\t}\r\n}\r\n\r\n// LoadModel loads a model version for serving. Specify either versionNum > 0\r\n// or a non-empty stage string (not both).\r\nfunc (s *Server) LoadModel(modelName string, versionNum int, stage string) error {\r\n\tvar version *registry.Version\r\n\tvar err error\r\n"]
[6438.841927, "o", "\r\n\tif versionNum > 0 {\r\n\t\tversion, err = s.registry.GetVersion(modelName, versionNum)\r\n\t} else if stage != \"\" {\r\n\t\tversion, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))\r\n\t} else {\r\n\t\treturn fmt.Errorf(\"must specify version number or stage\")\r\n\t}\r\n\r\n\tif err != nil {\r\n\t\treturn fmt.Errorf(\"load model: %w\", err)\r\n\t}\r\n\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\ts.loaded[modelName] = &LoadedModel{"]
[6438.841995, "o", "\r\n\t\tModelName:   modelName,\r\n\t\tVersionNum:  version.Number,\r\n\t\tStage:       version.Stage,\r\n\t\tModelConfig: version.ModelConfig,\r\n\t\tLoadedAt:    time.Now(),\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n// UnloadModel removes a model from the serving cache.\r\nfunc (s *Server) UnloadModel(modelName string) error {\r\n"]
[6438.842053, "o", "\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\tif _, exists := s.loaded[modelName]; !exists {\r\n\t\treturn fmt.Errorf(\"model %q is not loaded\", modelName)\r\n\t}\r\n\tdelete(s.loaded, modelName)\r\n\treturn nil\r\n}\r\n\r\n"]
[6438.842117, "o", "// Infer runs inference on the loaded model and returns predictions.\r\nfunc (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {\r\n\tstart := time.Now()\r\n\r\n\ts.mu.RLock()\r\n\tloaded, exists := s.loaded[req.ModelName]\r\n\ts.mu.RUnlock()\r\n\r\n\tif !exists {\r\n\t\treturn nil, fmt.Errorf(\"model %q is not loaded for serving\", req.ModelName)\r\n\t}\r\n"]
[6438.842192, "o", "\r\n\tpredictions, err := computePrediction(loaded.ModelConfig, req.Input)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"inference error: %w\", err)\r\n\t}\r\n\r\n\tlatency := float64(time.Since(start).Microseconds()) / 1000.0\r\n\r\n\treturn &InferenceResponse{\r\n\t\tModelName:   req.ModelName,\r\n\t\tVersion:     loaded.VersionNum,\r\n\t\tPredictions: predictions,\r\n\t"]
[6438.84225, "o", "\tLatencyMs:   latency,\r\n\t}, nil\r\n}\r\n\r\n// RecordRequest updates serving statistics for a single inference request.\r\nfunc (s *Server) RecordRequest(modelName string, successful bool, latencyMs float64) {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\r\n\ts.stats.TotalRequests++\r\n\tif successful {\r\n"]
[6438.84231, "o", "\t\ts.stats.Successful++\r\n\t\ts.stats.LatencySum += latencyMs\r\n\t} else {\r\n\t\ts.stats.Failed++\r\n\t}\r\n\r\n"]
