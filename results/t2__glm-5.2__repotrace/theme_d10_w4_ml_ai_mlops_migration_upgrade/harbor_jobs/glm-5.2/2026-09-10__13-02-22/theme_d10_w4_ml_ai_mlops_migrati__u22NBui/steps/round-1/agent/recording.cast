[960.539677, "o", "./internal/api/handlers.go\r\n./internal/api/router.go\r\n./internal/experiment/experiment.go\r\n./internal/pipeline/engine.go\r\n./internal/pipeline/steps.go\r\n./internal/registry/registry.go\r\n./internal/serving/serving.go\r\n./main.go\r\n"]
[960.540217, "o", "\u001b[?2004h"]
