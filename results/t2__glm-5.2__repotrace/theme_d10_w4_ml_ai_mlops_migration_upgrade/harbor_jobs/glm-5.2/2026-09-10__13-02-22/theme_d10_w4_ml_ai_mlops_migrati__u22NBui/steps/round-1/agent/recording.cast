[4009.989125, "o", "\t\r\n   646\ttype experimentComparisonEntry struct {\r\n   647\t\tName  string  `json:\"name\"`\r\n   648\t\tMean  float64 `json:\"mean\"`\r\n   649\t\tMin   float64 `json:\"min\"`\r\n   650\t\tMax   float64 `json:\"max\"`\r\n   651\t\tCount int     `json:\"count\"`\r\n   652\t}\r\n   653\t\r\n"]
[4009.989194, "o", "   654\tfunc (h *Handlers) CompareExperiments(w http.ResponseWriter, r *http.Request) {\r\n   655\t\texperimentsParam := r.URL.Query().Get(\"experiments\")\r\n   656\t\tmetric := r.URL.Query().Get(\"metric\")\r\n   657\t\r\n   658\t\t"]
[4009.989256, "o", "if metric == \"\" {\r\n   659\t\t\twriteError(w, http.StatusBadRequest, \"metric parameter is required\")\r\n   660\t\t\treturn\r\n   661\t\t}\r\n   662\t\r\n   663\t\tnames := strings.Split(experimentsParam, \",\")\r\n   664\t\tif len(names) < 2 {\r\n   665\t\t\twriteError(w, http.StatusBadRequest, \"at least two experiment names are required\")\r\n   666\t\t\treturn\r\n   667\t\t}\r\n   668\t\tfor i := range names {\r\n   669\t\t\tnames[i] = strings.TrimSpace(names[i])\r\n   670\t\t}\r\n"]
[4009.989314, "o", "   671\t\r\n   672\t\tfor _, name := range names {\r\n   673\t\t\tif _, err := h.Experiment.GetExperiment(name); err != nil {\r\n   674\t\t\t\twriteError(w, http.StatusNotFound, \"experiment %q not found\", name)\r\n   675\t\t\t\treturn\r\n   676\t\t\t}\r\n   677\t\t}\r\n   678\t\r\n"]
[4009.989372, "o", "   679\t\tvar entries []experimentComparisonEntry\r\n   680\t\tvar means []float64\r\n   681\t\ttotalRuns := 0\r\n   682\t\tbest := \"\"\r\n   683\t\tvar bestMean float64\r\n   684\t\r\n   685\t\tfor _, name := range names {\r\n   686\t\t\texp, err := h.Experiment.GetExperiment(name)\r\n"]
[4009.989428, "o", "   687\t\t\tif err != nil {\r\n   688\t\t\t\twriteError(w, http.StatusNotFound, \"experiment %q not found\", name)\r\n   689\t\t\t\treturn\r\n   690\t\t\t}\r\n   691\t\r\n   692\t\t\tvar values []float64\r\n   693\t\t\tfor _, run := range exp.Runs {\r\n   694\t\t\t\tif value, ok := run.Metrics[metric]; ok {\r\n"]
[4009.989489, "o", "   695\t\t\t\t\tvalues = append(values, value)\r\n   696\t\t\t\t}\r\n   697\t\t\t}\r\n   698\t\t\tif len(values) == 0 {\r\n   699\t\t\t\tcontinue\r\n   700\t\t\t}\r\n   701\t\r\n"]
[4009.989546, "o", "   702\t\t\tsum := 0.0\r\n   703\t\t\tminVal := values[0]\r\n   704\t\t\tmaxVal := values[0]\r\n   705\t\t\tfor _, value := range values {\r\n   706\t\t\t\tsum += value\r\n   707\t\t\t\tif value < minVal {\r\n   708\t\t\t\t\tminVal = value\r\n   709\t\t\t\t}\r\n   710\t\t\t\tif value > maxVal {\r\n"]
[4009.989602, "o", "   711\t\t\t\t\tmaxVal = value\r\n   712\t\t\t\t}\r\n   713\t\t\t}\r\n   714\t\t\tmean := sum / float64(len(values))\r\n   715\t\t\tentries = append(entries, experimentComparisonEntry{\r\n   716\t\t\t\tName:  name,\r\n   717\t\t\t\tMean:  mean,\r\n   718\t"]
[4009.989669, "o", "\t\t\tMin:   minVal,\r\n   719\t\t\t\tMax:   maxVal,\r\n   720\t\t\t\tCount: len(values),\r\n   721\t\t\t})\r\n   722\t"]
[4009.989728, "o", "\t\tmeans = append(means, mean)\r\n   723\t\t\ttotalRuns += len(values)\r\n   724\t\t\tif len(entries) == 1 || mean > bestMean {\r\n   725\t\t\t\tbest = name\r\n   726\t\t\t\tbestMean = mean\r\n   727\t\t\t}\r\n   728\t\t}\r\n   729\t\r\n   730\t\tif len(entries) == 0 {\r\n   731\t\t\twriteError(w, http.StatusBadRequest, \"no data found for metric %q across specified experiments\", metric)\r\n   732\t\t\treturn\r\n   733\t\t}\r\n   734\t\r\n"]
[4009.989807, "o", "   735\t\tspread := 0.0\r\n   736\t\tif len(means) > 0 {\r\n   737\t\t\tminMean := means[0]\r\n   738\t\t\tmaxMean := means[0]\r\n   739\t\t\tfor _, mean := range means {\r\n"]
[4009.989895, "o", "   740\t\t\t\tif mean < minMean {\r\n   741\t\t\t\t\tminMean = mean\r\n   742\t\t\t\t}\r\n   743\t\t\t\tif mean > maxMean {\r\n   744\t\t\t\t\tmaxMean = mean\r\n   745\t\t\t\t}\r\n   746\t\t\t}\r\n   747\t\t\tspread = maxMean - minMean\r\n   748\t\t}\r\n   749\t\r\n   750\t\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n   751\t\t\t\"metric\":      metric,\r\n   752\t\t\t\"experiments\": entries,\r\n   753\t\t\t\"best\":        best,\r\n   754\t\t\t\"summary\": map[string]interface{}{\r\n   755\t\t\t\t\"spread\":           spread,\r\n   756\t\t\t\t\"experiment_count\": len(entries),\r\n   757\t\t\t\t\"total_runs\":       totalRuns,\r\n   758\t\t\t},\r\n   759\t\t})\r\n   760\t}\r\n"]
