[3782.64619, "o", "\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (e *Engine) Validate\u001b[m\u001b[K(p *Pipeline) *ValidationResult {\r\n"]
[3782.646698, "o", "\u001b[?2004h"]
[3782.646762, "o", "root@n30009:/app# "]
[3782.942677, "i", "nl -ba internal/pipeline/engine.go | sed -n '75,175p'\n"]
[3782.943127, "o", "nl -ba internal/pipeline/engine.go | sed -n '75,175p'\r\n\u001b[?2004l\r"]
[3782.947248, "o", "    75\t\r\n    76\t// ValidationResult describes the structural validation outcome of a pipeline.\r\n    77\ttype ValidationResult struct {\r\n    78\t\tValid          bool            `json:\"valid\"`\r\n    79\t\tExecutionOrder []string        `json:\"execution_order\"`\r\n    80\t\tStepCount      int             `json:\"step_count\"`\r\n"]
[3782.947346, "o", "    81\t\tSteps          []ValidatedStep `json:\"steps\"`\r\n    82\t\tErrors         []string        `json:\"errors\"`\r\n    83\t}\r\n    84\t\r\n    85\t// ValidatedStep contains structural details for a validated step.\r\n"]
[3782.947427, "o", "    86\ttype ValidatedStep struct {\r\n    87\t\tName         string   `json:\"name\"`\r\n    88\t\tType         StepType `json:\"type\"`\r\n    89\t\tDependencies []string `json:\"dependencies\"`\r\n    90\t}\r\n    91\t\r\n    92\t// Validate checks a pipeline definition for structural correctness without executing it.\r\n    93\tfunc (e *Engine) Validate(p *Pipeline) *ValidationResult {\r\n    94\t\tresult := &ValidationResult{\r\n    95\t\t\tValid:          true,\r\n    96\t\t\tExecutionOrder: []string{},\r\n    97\t\t\tSteps:          []ValidatedStep{},\r\n    98\t\t\tErrors:         []string{},\r\n    99\t\t}\r\n   100\t\tif p == nil {\r\n   101\t\t\tresult.Valid = false\r\n   102\t\t\tresult.Errors = append(result.Errors, \"pipeline definition is required\")\r\n   103\t\t\treturn result\r\n   104\t\t}\r\n   105\t\r\n"]
[3782.947494, "o", "   106\t\tstepCount := len(p.Steps)\r\n   107\t\tresult.StepCount = stepCount\r\n   108\t\r\n   109\t\tseen := make(map[string]bool)\r\n   110\t\tduplicateNames := make(map[string]bool)\r\n   111\t\tnameOrder := make([]string, 0, stepCount)\r\n   112\t\r\n   113\t\tfor _, step := range p.Steps {\r\n   114\t\t\tif step == nil {\r\n   115\t\t\t\tresult.Valid = false\r\n"]
[3782.947557, "o", "   116\t\t\t\tresult.Errors = append(result.Errors, \"step is null\")\r\n   117\t\t\t\tcontinue\r\n   118\t\t\t}\r\n   119\t\t\tresult.Steps = append(result.Steps, ValidatedStep{\r\n   120\t\t\t\tName:         step.Name,\r\n   121\t\t\t\tType:         step.Type,\r\n   122\t\t\t\tDependencies: step.Dependencies,\r\n   123\t\t\t})\r\n   124\t\t\tif seen[step.Name] {\r\n"]
[3782.947617, "o", "   125\t\t\t\tduplicateNames[step.Name] = true\r\n   126\t\t\t}\r\n   127\t\t\tif !seen[step.Name] {\r\n   128\t\t\t\tseen[step.Name] = true\r\n   129\t\t\t\tnameOrder = append(nameOrder, step.Name)\r\n   130\t\t\t}\r\n   131\t\t}\r\n   132\t\tif len(duplicateNames) > 0 {\r\n   133\t\t\tresult.Valid = false\r\n"]
[3782.947675, "o", "   134\t\t\tfor name := range duplicateNames {\r\n   135\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"duplicate step name: %s\", name))\r\n   136\t\t\t}\r\n   137\t\t}\r\n   138\t\r\n   139\t\tfor _, step := range p.Steps {\r\n   140\t\t\tif step == nil {\r\n"]
[3782.947734, "o", "   141\t\t\t\tcontinue\r\n   142\t\t\t}\r\n   143\t\t\tif _, exists := e.stepExecutors[step.Type]; !exists {\r\n   144\t\t\t\tresult.Valid = false\r\n   145\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"unknown step type: %s\", step.Type))\r\n   146\t\t\t}\r\n   147\t\t\tfor _, dep := range step.Dependencies {\r\n   148\t\t\t\tif !seen[dep] {\r\n"]
[3782.947789, "o", "   149\t\t\t\t\tresult.Valid = false\r\n   150\t\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf(\"step %s depends on unknown step: %s\", step.Name, dep))\r\n   151\t\t\t\t}\r\n   152\t\t\t}\r\n   153\t\t}\r\n   154\t\r\n   155\t\tordered, err := topologicalSort(p.Steps)\r\n   156\t"]
[3782.947867, "o", "\tif err != nil {\r\n   157\t\t\tresult.Valid = false\r\n   158\t\t\tif strings.Contains(err.Error(), \"cycle\") {\r\n   159\t\t\t\tresult.Errors = append(result.Errors, \"dependency cycle detected\")\r\n   160\t\t\t}\r\n   161\t\t}\r\n   162\t\r\n   163\t\tif result.Valid && err == nil {\r\n   164\t\t"]
[3782.947931, "o", "\tfor _, step := range ordered {\r\n   165\t\t\t\tresult.ExecutionOrder = append(result.ExecutionOrder, step.Name)\r\n   166\t\t\t}\r\n   167\t\t}\r\n   168\t\r\n   169\t\tif len(result.Errors) > 0 {\r\n"]
[3782.947959, "o", "   170\t\t\tresult.Valid = false\r\n   171\t\t\t"]
[3782.948036, "o", "result.ExecutionOrder = []string{}\r\n   172\t\t}\r\n   173\t\r\n   174\t\treturn result\r\n   175\t}\r\n"]
[3782.948927, "o", "\u001b[?2004h"]
