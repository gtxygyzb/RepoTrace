[4519.431827, "o", "// executeWithRetryAndTimeout runs an executor with optional retry and timeout.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.432244, "o", "func (e *Engine) executeWithRetryAndTimeout(executor StepExecutor, config, input map[string]interface{}, retry, timeoutMs int) (map[string]interface{}, error, int, bool) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.4323, "o", "> "]
[4519.432354, "o", "\\tmaxAttempts := retry + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.432406, "o", "\\tif maxAttempts < 1 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.432478, "o", "\\t\\tmaxAttempts = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.432532, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4519.432585, "o", "\u001b[?2004h> "]
[4519.432643, "o", "\\tvar output map[string]interface{}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.432698, "o", "> \\tvar err error\r\n\u001b[?2004l\r"]
[4519.432753, "o", "\u001b[?2004h> "]
[4519.43286, "o", "\\tfor attempt := 0; attempt < maxAttempts; attempt++ {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.432947, "o", "\\t\\ttype execResult struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.433054, "o", "\\t\\t\\toutput map[string]interface{}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.433108, "o", "> \\t\\t\\terr    error\r\n\u001b[?2004l\r"]
[4519.433171, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.43328, "o", "\\t\\tresChan := make(chan execResult, 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.433336, "o", "> "]
[4519.43339, "o", "\\t\\tstart := time.Now()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.433444, "o", "\\t\\tgo func() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.433537, "o", "\\t\\t\\tout, e := executor(config, input)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.433591, "o", "> "]
[4519.433672, "o", "\\t\\t\\tresChan <- execResult{output: out, err: e}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.433728, "o", "> \\t\\t}()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4519.433781, "o", "\u001b[?2004h> "]
[4519.433843, "o", "\\t\\tif timeoutMs > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.433911, "o", "\\t\\t\\tselect {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.433975, "o", "\\t\\t\\tcase res := <-resChan:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.434094, "o", "\\t\\t\\t\\toutput, err = res.output, res.err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.434315, "o", "\\t\\t\\tcase <-time.After(time.Duration(timeoutMs)*time.Millisecond - time.Since(start)):\r\n\u001b[?2004l\r"]
[4519.434371, "o", "\u001b[?2004h> "]
[4519.434429, "o", "\\t\\t\\t\\treturn nil, nil, attempt, true\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.434484, "o", "> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.434547, "o", "\\t\\t} else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.434607, "o", "\\t\\t\\tres := <-resChan\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.43466, "o", "> "]
[4519.434721, "o", "\\t\\t\\toutput, err = res.output, res.err\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.434776, "o", "> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4519.434832, "o", "\u001b[?2004h> "]
[4519.434893, "o", "\\t\\tif err == nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.434975, "o", "\\t\\t\\treturn output, nil, attempt, false\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.43503, "o", "> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.435085, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.4352, "o", "\\treturn output, err, maxAttempts - 1, false\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.435255, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[4519.435308, "o", "\u001b[?2004h> "]
[4519.435507, "o", "marker = '\\n// shouldSkipStep evaluates a step\\'s skip_condition against pipeline variables.\\n'\r\n\u001b[?2004l\r\u001b[?2004h"]
[4519.435562, "o", "> if marker not in s:\r\n\u001b[?2004l\r"]
[4519.435616, "o", "\u001b[?2004h> "]
[4519.435696, "o", "    raise SystemExit('marker not found')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.435809, "o", "s = s.replace(marker, insert + marker)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4519.435877, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
