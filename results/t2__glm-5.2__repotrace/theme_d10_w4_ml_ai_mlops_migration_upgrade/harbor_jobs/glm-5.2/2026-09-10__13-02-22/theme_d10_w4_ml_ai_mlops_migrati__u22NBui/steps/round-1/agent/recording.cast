[4145.806543, "o", "   175\t}\r\n   176\t\r\n   177\t// Execute runs a pipeline with the given initial input data.\r\n   178\tfunc (e *Engine) Execute(p *Pipeline, initialInput map[string]interface{}) (*PipelineResult, error) {\r\n   179\t\tordered, err := topologicalSort(p.Steps)\r\n   180\t\tif err != nil {\r\n   181\t\t\treturn nil, fmt.Errorf(\"dependency resolution failed: %w\", err)\r\n   182\t\t}\r\n   183\t\r\n   184\t\tpipelineStart := time.Now()\r\n   185\t\tresult := &PipelineResult{\r\n   186\t\t\tPipelineName: p.Name,\r\n   187\t\t\tStatus:       \"success\",\r\n   188\t\t\tSteps:        make([]*StepResult, 0, len(ordered)),\r\n"]
[4145.806606, "o", "   189\t\t}\r\n   190\t\r\n   191\t\tstepOutputs := make(map[string]map[string]interface{})\r\n   192\t\tvariables := make(map[string]float64)\r\n   193\t\tvariableSetter := make(map[string]string)\r\n   194\t\tallDeps := computeTransitiveDependencies(p.Steps)\r\n   195\t\r\n   196\t\tfor _, step := range ordered {\r\n   197\t\t\tstepStart := time.Now()\r\n"]
[4145.806664, "o", "   198\t\r\n   199\t\t\tresolvedConfig, err := resolveVariables(step.Config, variables, variableSetter, allDeps[step.Name])\r\n   200\t\t\tif err != nil {\r\n   201\t\t\t\tsr := &StepResult{\r\n   202\t\t\t\t\tStepName:   step.Name,\r\n   203\t\t\t\t\tStepType:   step.Type,\r\n   204\t\t\t\t\tStatus:     \"failed\",\r\n"]
[4145.80672, "o", "   205\t\t\t\t\tError:      err.Error(),\r\n   206\t\t\t\t\tDurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\r\n   207\t\t\t\t}\r\n   208\t\t\t\tresult.Steps = append(result.Steps, sr)\r\n   209\t\t\t\tresult.Status = \"failed\"\r\n   210\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\r\n   211\t\t\t\treturn result, nil\r\n   212\t\t\t}\r\n   213\t"]
[4145.806777, "o", "\r\n   214\t\t\t// Determine input for this step\r\n   215\t\t\tvar input map[string]interface{}\r\n   216\t\t\tif len(step.Dependencies) == 0 {\r\n   217\t\t\t\tinput = initialInput\r\n   218\t\t\t} else {\r\n   219\t\t\t\tinput = mergeDependencyOutputs(step.Dependencies, stepOutputs)\r\n"]
