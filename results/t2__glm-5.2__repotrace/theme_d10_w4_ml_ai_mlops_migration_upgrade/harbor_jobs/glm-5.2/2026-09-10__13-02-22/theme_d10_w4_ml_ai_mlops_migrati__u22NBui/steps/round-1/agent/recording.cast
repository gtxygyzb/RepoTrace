[7166.63183, "o", "\\twriteJSON(w, http.StatusOK, map[string]interface{}{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.631891, "o", "\\t\\t\"status\":      \"reloaded\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.63196, "o", "\\t\\t\"model_name\":  loaded.ModelName,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.632029, "o", "\\t\\t\"version_num\": loaded.VersionNum,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.632092, "o", "\\t\\t\"stage\":       loaded.Stage,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7166.632147, "o", "\\t})\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
