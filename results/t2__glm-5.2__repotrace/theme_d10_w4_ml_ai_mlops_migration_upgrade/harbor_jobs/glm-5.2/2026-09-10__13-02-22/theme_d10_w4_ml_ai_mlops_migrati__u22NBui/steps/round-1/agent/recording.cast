[1504.205316, "i", "ues = append(values, value)\n\\t\\t\\tweights = append(weights, weight)\n\\t\\t\\trunIDs = append(runIDs, run.ID)\n\\t\\t} else {\n\\t\\t\\tvalues = append(values, value)\n\\t\\t\\trunIDs = append(runIDs, run.ID)\n\\t\\t}\n\\t}\n\n\\tif len(values) == 0 {\n\\t\\tif len(tagFilters) > 0 {\n\\t\\t\\treturn 0, 0, nil, fmt.Errorf(\"no runs match tag filters for metric %q\", metricName)\n\\t\\t}\n\\t\\treturn 0, 0, nil, fmt.Errorf(\"no values found for metric %q\", metricName)\n\\t}\n\n\\tswitch aggType {\n\\tcase \"mean\":\n\\t\\tsum := 0.0\n\\t\\tfor _, v := range values {\n\\t\\t\\tsum += v\n\\t\\t}\n\\t\\treturn sum / float64(len(values)), len(values), runIDs, nil\n\n\\tcase \"median\":\n\\t\\tsorted := sortedCopy(values)\n\\t\\tn := len(sorted)\n\\t\\tif n%2 == 0 {\n\\t\\t\\treturn (sorted[n/2-1] + sorted[n/2]) / 2, len(values), runIDs, nil\n\\t\\t}\n\\t\\treturn sorted[n/2], len(values), runIDs, nil\n\n\\tcase \"p95\":\n\\t\\tsorted := sortedCopy(values)\n\\t\\treturn percentile(sorted, 0.95), len(values), runIDs, nil\n\n\\tcase \"p99\":\n\\t\\tsorted := sortedCopy(values)\n\\t\\treturn percentile(sorted, 0.99), len(value"]
