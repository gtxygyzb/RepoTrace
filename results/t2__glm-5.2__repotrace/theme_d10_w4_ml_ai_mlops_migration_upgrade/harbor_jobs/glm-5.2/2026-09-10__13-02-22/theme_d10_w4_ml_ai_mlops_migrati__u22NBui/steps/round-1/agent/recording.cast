[5714.176258, "o", "   136\tfunc (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {\r\n   137\t\tr.mu.Lock()\r\n   138\t\tdefer r.mu.Unlock()\r\n   139\t\r\n   140\t\tmodel, exists := r.models[modelName]\r\n   141\t\tif !exists {\r\n   142\t\t\treturn nil, fmt.Errorf(\"model %q not found\", modelName)\r\n   143\t\t}\r\n   144\t\r\n   145\t\tnextNum := 1\r\n   146\t\tfor _, v := range model.Versions {\r\n   147\t\t\tif v.Number >= nextNum {\r\n   148\t\t\t\tnextNum = v.Number + 1\r\n   149\t\t\t}\r\n   150\t\t}\r\n   151\t\r\n   152\t\tif tags == nil {\r\n   153\t"]
