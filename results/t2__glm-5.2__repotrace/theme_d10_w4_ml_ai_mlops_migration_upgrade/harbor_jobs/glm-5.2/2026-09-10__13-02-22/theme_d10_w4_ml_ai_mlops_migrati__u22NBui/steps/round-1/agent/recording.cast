[2009.480054, "o", "// ListExperiments returns all experiments.\r\n   111\tfunc (t *Tracker) ListExperiments() []*Experiment {\r\n   112\t\tt.mu.RLock()\r\n   113\t\tdefer t.mu.RUnlock()\r\n   114\t\r\n   115\t\tresult := make([]*Experiment, 0, len(t.experiments))\r\n   116\t\tfor _, exp := range t.experiments {\r\n"]
[2009.480117, "o", "   117\t\t\tresult = append(result, exp)\r\n   118\t\t}\r\n   119\t\tsort.Slice(result, func(i, j int) bool {\r\n   120\t\t\treturn result[i].Name < result[j].Name\r\n   121\t\t})\r\n   122\t\treturn result\r\n   123\t}\r\n   124\t\r\n   125\t// AggregateMetric computes an aggregate statistic for a given metric across all runs\r\n   126\t// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.\r\n"]
[2009.480185, "o", "   127\t// For weighted_mean, weightParam specifies which parameter to use as weight.\r\n   128\tfunc (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string, tagFilters map[string]string) (float64, int, []string, error) {\r\n   129\t\tt.mu.RLock()\r\n   130\t\tdefer t.mu.RUnlock()\r\n"]
[2009.480247, "o", "   131\t\r\n   132\t\texp, exists := t.experiments[experimentName]\r\n   133\t\tif !exists {\r\n   134\t\t\treturn 0, 0, nil, fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   135\t\t}\r\n   136\t\r\n   137\t\tif len(exp.Runs) == 0 {\r\n   138\t\t\treturn 0, 0, nil, fmt.Errorf(\"experiment %q has no runs\", experimentName)\r\n   139\t\t}\r\n   140\t\r\n   141\t\tvar values []float64\r\n   142\t\tvar weights []float64\r\n   143\t\tvar runIDs []string\r\n"]
[2009.480308, "o", "   144\t\tfor _, run := range exp.Runs {\r\n   145\t\t\tif !matchTags(run.Tags, tagFilters) {\r\n   146\t\t\t\tcontinue\r\n   147\t\t\t}\r\n   148\t\t\tvalue, ok := run.Metrics[metricName]\r\n   149\t\t\tif !ok {\r\n   150\t\t\t\tcontinue\r\n   151\t\t\t}\r\n   152\t\t\tif aggType == \"weighted_mean\" {\r\n   153\t"]
[2009.480366, "o", "\t\t\tweight, ok := run.Parameters[weightParam]\r\n   154\t\t\t\tif !ok {\r\n   155\t\t\t\t\tcontinue\r\n   156\t\t\t\t}\r\n   157\t\t\t\tvalues = append(values, value)\r\n   158\t\t\t\tweights = append(weights, weight)\r\n   159\t\t\t\trunIDs = append(runIDs, run.ID)\r\n   160\t\t\t} else {\r\n"]
[2009.480421, "o", "   161\t\t\t\tvalues = append(values, value)\r\n   162\t\t\t\trunIDs = append(runIDs, run.ID)\r\n   163\t\t\t}\r\n   164\t\t}\r\n   165\t\r\n   166\t\tif len(values) == 0 {\r\n   167\t\t\tif len(tagFilters) > 0 {\r\n"]
[2009.480479, "o", "   168\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"no runs match tag filters for metric %q\", metricName)\r\n   169\t\t\t}\r\n   170\t\t\treturn 0, 0, nil, fmt.Errorf(\"no values found for metric %q\", metricName)\r\n   171\t\t}\r\n   172\t\r\n   173\t\tswitch aggType {\r\n   174\t\tcase \"mean\":\r\n   175\t\t\tsum := 0.0\r\n   176\t\t\tfor _, v := range values {\r\n"]
[2009.480535, "o", "   177\t\t\t\tsum += v\r\n   178\t\t\t}\r\n   179\t\t\treturn sum / float64(len(values)), len(values), runIDs, nil\r\n   180\t\r\n   181\t\tcase \"median\":\r\n   182\t\t\tsorted := sortedCopy(values)\r\n   183\t\t\tn := len(sorted)\r\n"]
[2009.480593, "o", "   184\t\t\tif n%2 == 0 {\r\n   185\t\t\t\treturn (sorted[n/2-1] + sorted[n/2]) / 2, len(values), runIDs, nil\r\n   186\t\t\t}\r\n   187\t\t\treturn sorted[n/2], len(values), runIDs, nil\r\n   188\t\r\n   189\t\tcase \"p95\":\r\n   190\t\t\tsorted := sortedCopy(values)\r\n   191\t\t\treturn percentile(sorted, 0.95), len(values), runIDs, nil\r\n   192\t\r\n"]
[2009.48066, "o", "   193\t\tcase \"p99\":\r\n   194\t\t\tsorted := sortedCopy(values)\r\n   195\t\t\treturn percentile(sorted, 0.99), len(values), runIDs, nil\r\n   196\t\r\n"]
[2009.480723, "o", "   197\t\tcase \"weighted_mean\":\r\n   198\t\t\tif weightParam == \"\" {\r\n   199\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"weighted_mean requires weight parameter\")\r\n   200\t\t\t}\r\n   201\t\t\tif len(weights) == 0 {\r\n   202\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"no runs with metric %q and weight parameter %q\", metricName, weightParam)\r\n   203\t\t\t}\r\n   204\t\t\tif len(weights) != len(values) {\r\n   205\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"mismatch between metric values and weights\")\r\n   206\t\t\t}\r\n   207\t\t\tweightedSum := 0.0\r\n   208\t\t\tweightSum := 0.0\r\n"]
[2009.480786, "o", "   209\t\t\tfor i, v := range values {\r\n   210\t\t\t\tweightedSum += v * weights[i]\r\n   211\t\t\t\tweightSum += weights[i]\r\n   212\t\t\t}\r\n   213\t\t\tif weightSum == 0 {\r\n   214\t\t\t\treturn 0, 0, nil, fmt.Errorf(\"weighted_mean has zero total weight\")\r\n   215\t\t\t}\r\n   216\t\t\treturn weightedSum / weightSum, len(values), runIDs, nil\r\n   217\t\r\n"]
[2009.480872, "o", "   218\t\tdefault:\r\n   219\t\t\treturn 0, 0, nil, fmt.Errorf(\"unknown aggregation type %q\", aggType)\r\n   220\t\t}\r\n   221\t}\r\n   222\t\r\n   223\tfunc matchTags(runTags map[string]string, filters map[string]string) bool {\r\n   224\t\tfor k, v := range filters {\r\n   225\t\t\tif runTags[k] != v {\r\n   226\t\t\t\treturn false\r\n   227\t\t\t}\r\n   228\t\t}\r\n   229\t\treturn true\r\n"]
[2009.480937, "o", "   230\t}\r\n   231\t\r\n   232\tfunc (t *Tracker) DeleteRun(experimentName, runID string) error {\r\n   233\t\tt.mu.Lock()\r\n   234\t\tdefer t.mu.Unlock()\r\n   235\t\r\n   236\t\texp, exists := t.experiments[experimentName]\r\n   237\t\tif !exists {\r\n   238\t\t\treturn fmt.Errorf(\"experiment %q not found\", experimentName)\r\n   239\t\t}\r\n   240"]
[2009.480994, "o", "\t\r\n   241\t\tfor i, run := range exp.Runs {\r\n   242\t\t\tif run.ID == runID {\r\n   243\t\t\t\texp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)\r\n   244\t\t\t\treturn t.saveExperiment(exp)\r\n   245\t\t\t}\r\n   246\t\t}\r\n   247\t"]
[2009.481053, "o", "\treturn fmt.Errorf(\"run %q not found in experiment %q\", runID, experimentName)\r\n   248\t}\r\n   249\t\r\n   250\tfunc percentile(sorted []float64, p float64) float64 {\r\n   251\t\tn := len(sorted)\r\n   252\t\tif n == 0 {\r\n   253\t\t\treturn 0\r\n   254\t\t}\r\n"]
[2009.481126, "o", "   255\t\tif n == 1 {\r\n   256\t\t\treturn sorted[0]\r\n   257\t\t}\r\n   258\t\trank := p * float64(n-1)\r\n   259\t\tlower := int(math.Floor(rank))\r\n   260\t\tupper := int(math.Ceil(rank))\r\n   261\t\tif lower == upper {\r\n   262\t\t\treturn sorted[lower]\r\n   263\t\t}\r\n   264\t\tfrac := rank - float64(lower)\r\n   265\t\t"]
[2009.481187, "o", "return sorted[lower]*(1-frac) + sorted[upper]*frac\r\n   266\t}\r\n   267\t\r\n   268\tfunc sortedCopy(values []float64) []float64 {\r\n   269\t\ts := make([]float64, len(values))\r\n   270\t\tcopy(s, values)\r\n   271\t\tsort.Float64s(s)\r\n   272\t\treturn s\r\n   273\t}\r\n"]
