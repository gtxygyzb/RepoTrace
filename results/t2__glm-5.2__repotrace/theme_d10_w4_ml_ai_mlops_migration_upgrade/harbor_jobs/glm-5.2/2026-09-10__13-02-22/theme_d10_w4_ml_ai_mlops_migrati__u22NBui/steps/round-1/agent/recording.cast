[6153.72982, "o", "\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"GET /api/v1/\u001b[01;31m\u001b[Kexperiments/{name}\u001b[m\u001b[K\", h.GetExperiment)\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"POST /api/v1/\u001b[01;31m\u001b[Kexperiments/{name}\u001b[m\u001b[K/clone\", h.CloneExperiment)\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"POST /api/v1/\u001b[01;31m\u001b[Kexperiments/{name}\u001b[m\u001b[K/runs\", h.LogRun)\r\n"]
[6153.729947, "o", "\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"POST /api/v1/\u001b[01;31m\u001b[Kexperiments/{name}\u001b[m\u001b[K/runs/bulk-tag\", h.BulkTagRuns)\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"DELETE /api/v1/\u001b[01;31m\u001b[Kexperiments/{name}\u001b[m\u001b[K/runs/{id}\", h.DeleteRun)\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"GET /api/v1/\u001b[01;31m\u001b[Kexperiments/{name}\u001b[m\u001b[K/metrics/{metric}/aggregate\", h.AggregateMetric)\r\n"]
[6153.730044, "o", "\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"GET /api/v1/\u001b[01;31m\u001b[Kexperiments/{name}\u001b[m\u001b[K/\u001b[01;31m\u001b[Kcorrelation\u001b[m\u001b[K\", h.Experiment\u001b[01;31m\u001b[KCorrelation\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"GET /api/v1/\u001b[01;31m\u001b[Kexperiments/{name}\u001b[m\u001b[K/metrics/{metric}/history\", h.GetMetricHistory)\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"PUT /api/v1/\u001b[01;31m\u001b[Kexperiments/{name}\u001b[m\u001b[K/runs/{id}\", h.UpdateRun)\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmux.HandleFunc(\"POST /api/v1/\u001b[01;31m\u001b[Kexperiments/{name}\u001b[m\u001b[K/runs/search\", h.SearchRuns)\r\n"]
