[1442.615899, "i", ", ok := stepMap[dep]; ok {\n\t\t\t\tfor d := range visit(depStep) {\n\t\t\t\t\tdeps[d] = true\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tresult[s.Name] = deps\n\t\treturn deps\n\t}\n\n\tfor _, s := range steps {\n\t\tvisit(s)\n\t}\n\treturn result\n}\n\nfunc resolveVariables(config map[string]interface{}, variables map[string]float64, setter map[string]string, depSet map[string]bool) (map[string]interface{}, error) {\n\tif len(variables) == 0 {\n\t\treturn config, nil\n\t}\n\n\tresolved := make(map[string]interface{}, len(config))\n\tfor k, v := range config {\n\t\tif s, ok := v.(string); ok {\n\t\t\tif strings.HasPrefix(s, \"${\") && strings.HasSuffix(s, \"}\") {\n\t\t\t\tvarName := s[2 : len(s)-1]\n\t\t\t\tval, ok := variables[varName]\n\t\t\t\tif !ok {\n\t\t\t\t\treturn nil, fmt.Errorf(\"undefined variable\")\n\t\t\t\t}\n\t\t\t\tsetterStep, ok := setter[varName]\n\t\t\t\tif !ok || !depSet[setterStep] {\n\t\t\t\t\treturn nil, fmt.Errorf(\"variable not in dependency chain\")\n\t\t\t\t}\n\t\t\t\tresolved[k] = val\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tresolved[k] = v\n\t}\n\treturn resolved, nil\n}\n\nfunc applyOutputTransform(output map[string]interface{}, conf"]
