[6036.32056, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('internal/api/handlers.go')\ns = p.read_text()\n\ninsert = '''\n// --- Model Version Diff Handler ---\n\nfunc (h *Handlers) VersionDiff(w http.ResponseWriter, r *http.Request) {\n\\tmodelName := r.PathValue(\"name\")\n\\tv1Str := r.URL.Query().Get(\"v1\")\n\\tv2Str := r.URL.Query().Get(\"v2\")\n\\tv1, err := strconv.Atoi(v1Str)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusBadRequest, \"v1 must be a valid integer\")\n\\t\\treturn\n\\t}\n\\tv2, err := strconv.Atoi(v2Str)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusBadRequest, \"v2 must be a valid integer\")\n\\t\\treturn\n\\t}\n\\tif v1 == v2 {\n\\t\\twriteError(w, http.StatusBadRequest, \"v1 and v2 must be different\")\n\\t\\treturn\n\\t}\n\n\\tver1, err := h.Registry.GetVersion(modelName, v1)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\n\\t\\treturn\n\\t}\n\\tver2, err := h.Registry.GetVersion(modelName, v2)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\n\\t\\treturn\n\\t}\n\n\\tmetricDiff := map[string]map[string]interfac"]
[6036.320648, "i", "e{}{}\n\\tfor k, v := range ver1.Metrics {\n\\t\\tif _, exists := metricDiff[k]; !exists {\n\\t\\t\\tmetricDiff[k] = map[string]interface{}{}\n\\t\\t}\n\\t\\tmetricDiff[k][\"v1\"] = v\n\\t}\n\\tfor k, v := range ver2.Metrics {\n\\t\\tif _, exists := metricDiff[k]; !exists {\n\\t\\t\\tmetricDiff[k] = map[string]interface{}{}\n\\t\\t}\n\\t\\tmetricDiff[k][\"v2\"] = v\n\\t}\n\\tfor k, entry := range metricDiff {\n\\t\\tv1Val, hasV1 := entry[\"v1\"]\n\\t\\tv2Val, hasV2 := entry[\"v2\"]\n\\t\\tif hasV1 && hasV2 {\n\\t\\t\\tentry[\"delta\"] = v2Val.(float64) - v1Val.(float64)\n\\t\\t} else {\n\\t\\t\\tentry[\"delta\"] = nil\n\\t\\t\\tif !hasV1 {\n\\t\\t\\t\\tentry[\"v1\"] = nil\n\\t\\t\\t}\n\\t\\t\\tif !hasV2 {\n\\t\\t\\t\\tentry[\"v2\"] = nil\n\\t\\t\\t}\n\\t\\t}\n\\t}\n\n\\tv1Tags := ver1.Tags\n\\tif v1Tags == nil {\n\\t\\tv1Tags = []string{}\n\\t}\n\\tv2Tags := ver2.Tags\n\\tif v2Tags == nil {\n\\t\\tv2Tags = []string{}\n\\t}\n\n\\twriteJSON(w, http.StatusOK, map[string]interface{}{\n\\t\\t\"model\":       modelName,\n\\t\\t\"v1\":           v1,\n\\t\\t\"v2\":           v2,\n\\t\\t\"metric_diff\":  metricDiff,\n\\t\\t\"stage_diff\":   map[string]interface{}{\""]
