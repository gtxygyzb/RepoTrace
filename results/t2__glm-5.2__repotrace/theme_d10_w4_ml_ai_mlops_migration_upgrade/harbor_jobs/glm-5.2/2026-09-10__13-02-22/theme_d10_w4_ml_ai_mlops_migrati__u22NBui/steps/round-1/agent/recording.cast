[664.137153, "o", "   143\t\r\n   144\tfunc (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {\r\n   145\t\tvar req struct {\r\n   146\t\t\tPipeline *pipeline.Pipeline     `json:\"pipeline\"`\r\n   147\t\t\t"]
[664.137356, "o", "Input    map[string]interface{} `json:\"input\"`\r\n   148\t\t}\r\n   149\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n   150\t\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n   151\t\t\treturn\r\n   152\t\t}\r\n   153\t\tif req.Pipeline == nil || len(req.Pipeline.Steps) == 0 {\r\n"]
[664.137476, "o", "   154\t\t\twriteError(w, http.StatusBadRequest, \"pipeline with at least one step is required\")\r\n   155\t\t\treturn\r\n   156\t\t}\r\n   157\t\tif req.Input == nil {\r\n   158\t\t\treq.Input = make(map[string]interface{})\r\n   159\t\t}\r\n   160\t\r\n   161\t\tresult, err := h.Pipeline.Execute(req.Pipeline, req.Input)\r\n   162\t\tif err != nil {\r\n   163\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n   164\t\t\treturn\r\n   165\t\t}\r\n   166\t\twriteJSON(w, http.StatusOK, result)\r\n   167\t}\r\n   168\t\r\n   169\t// --- Experiment Handlers ---\r\n   170\t\r\n"]
