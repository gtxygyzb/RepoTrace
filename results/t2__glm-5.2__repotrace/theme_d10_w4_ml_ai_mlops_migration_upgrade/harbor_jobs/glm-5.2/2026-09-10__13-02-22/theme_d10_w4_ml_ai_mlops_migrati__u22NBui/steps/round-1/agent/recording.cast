[6154.009367, "o", "\u001b[32m\u001b[K1114\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (h *Handlers) \u001b[01;31m\u001b[KExperimentCorrelation\u001b[m\u001b[K(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K1115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\texpName := r.PathValue(\"name\")\r\n\u001b[32m\u001b[K1116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmetricsParam := r.URL.Query().Get(\"metrics\")\r\n\u001b[32m\u001b[K1117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif metricsParam == \"\" {\r\n\u001b[32m\u001b[K1118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"metrics parameter is required\")\r\n\u001b[32m\u001b[K1119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[6154.009508, "o", "\t\treturn\r\n\u001b[32m\u001b[K1120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K1121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tparts := strings.Split(metricsParam, \",\")\r\n\u001b[32m\u001b[K1122\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(parts) != 2 {\r\n\u001b[32m\u001b[K1123\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"metrics must contain exactly two metric names\")\r\n\u001b[32m\u001b[K1124\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K1125\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K1126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmetricX := strings.TrimSpace(parts[0])\r\n\u001b[32m\u001b[K1127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmetricY := strings.TrimSpace(parts[1])\r\n\u001b[32m\u001b[K1128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif metricX == \"\" || metricY == \"\" {\r\n\u001b[32m\u001b[K1129\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twriteError(w, http.StatusBadRequest, \"metrics must contain exactly two metric names\")\r\n\u001b[32m\u001b[K1130\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K1131\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K1132\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1133\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tresult, err := h.Experiment.Correlation(expName, metricX, metricY)\r\n\u001b[32m\u001b[K1134\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err != nil {\r\n\u001b[32m\u001b[K1135\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[6154.009601, "o", "\t\tif strings.Contains(err.Error(), \"not found\") {\r\n\u001b[32m\u001b[K1136\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[32m\u001b[K1137\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t} else {\r\n\u001b[32m\u001b[K1138\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\u001b[32m\u001b[K1139\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K1140\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn\r\n\u001b[32m\u001b[K1141\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K1142\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\twriteJSON(w, http.StatusOK, result)\r\n\u001b[32m\u001b[K1143\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1144\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1145\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// --- Pipeline History Handlers ---\r\n\u001b[32m\u001b[K1146\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1147\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (h *Handlers) RecordPipelineHistory(w http.ResponseWriter, r *http.Request) {\r\n\u001b[32m\u001b[K1148\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar req struct {\r\n\u001b[32m\u001b[K1149\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tPipelineName string  `json:\"pipeline_name\"`\r\n\u001b[32m\u001b[K1150\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tStatus      string  `json:\"status\"`\r\n\u001b[32m\u001b[K1151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tTotalTimeMs float64 `json:\"total_time_"]
[6154.009664, "o", "ms\"`\r\n\u001b[32m\u001b[K1152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tStepCount   int     `json:\"step_count\"`\r\n\u001b[32m\u001b[K1153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K1154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n"]
