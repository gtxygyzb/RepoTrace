[4624.415412, "o", "\u001b[?2004h> "]
[4624.415458, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4624.415496, "o", "> "]
[4624.415732, "o", "\\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\u001b[?2004l\r"]
[4624.415769, "o", "\u001b[?2004h> "]
[4624.416083, "o", "\\t\\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\u001b[?2004l\r"]
[4624.416121, "o", "\u001b[?2004h> "]
[4624.41618, "o", "\\t\\treturn\r\n\u001b[?2004l\r"]
