[4172.102295, "o", "   193\t\t\tfor _, v := range values[1:] {\r\n   194\t\t\t\tif v < result {\r\n   195\t\t\t\t\tresult = v\r\n   196\t\t\t\t}\r\n   197\t\t\t}\r\n   198\t\tcase \"max\":\r\n   199\t\t\tresult = values[0]\r\n   200\t\t\tfor _, v := range values[1:] {\r\n"]
[4172.102358, "o", "   201\t\t\t\tif v > result {\r\n   202\t\t\t\t\tresult = v\r\n   203\t\t\t\t}\r\n   204\t\t\t}\r\n   205\t\tcase \"range\":\r\n   206\t\t\tif len(values) < 2 {\r\n   207\t\t\t\tresult = 0.0\r\n   208\t\t\t} else {\r\n   209\t\t\t\tminVal := values[0]\r\n   210\t\t\t\tmaxVal := values[0]\r\n   211\t\t\t\tfor _, v := range values[1:] {\r\n"]
