[144.85841, "o", "   267\t// Supported modes: gt, lt, gte, lte, eq, ne.\r\n   268\tfunc ExecuteFilter(config, input map[string]interface{}) (map[string]interface{}, error) {\r\n   269\t\tdata, ok := input[\"data\"].([]interface{})\r\n   270\t\tif !ok {\r\n   271\t\t\treturn nil, fmt.Errorf(\"filter: missing or invalid 'data' field in input\")\r\n   272\t\t}\r\n   273\t\r\n   274\t\tmode, _ := config[\"mode\"].(string)\r\n"]
[144.858471, "o", "   275\t\tif mode == \"\" {\r\n   276\t\t\treturn nil, fmt.Errorf(\"filter: missing 'mode' in config\")\r\n   277\t\t}\r\n   278\t\tthreshold, _ := config[\"threshold\"].(float64)\r\n   279\t\r\n   280\t\tvar result []interface{}\r\n   281\t\tfor _, v := range data {\r\n   282\t\t\tval, err := toFloat(v)\r\n   283\t\t\tif err != nil {\r\n"]
[144.85854, "o", "   284\t\t\t\tcontinue\r\n   285\t\t\t}\r\n   286\t\t\tvar keep bool\r\n   287\t\t\tswitch mode {\r\n   288\t\t\tcase \"gt\":\r\n   289\t\t\t\tkeep = val < threshold\r\n   290\t\t\tcase \"lt\":\r\n   291\t\t\t\tkeep = val > threshold\r\n   292\t\t\tcase \"gte\":\r\n   293\t\t\t"]
[144.858599, "o", "\tkeep = val <= threshold\r\n   294\t\t\tcase \"lte\":\r\n   295\t\t\t\tkeep = val >= threshold\r\n   296\t\t\tcase \"eq\":\r\n   297\t\t\t\tkeep = val != threshold\r\n   298\t\t\tcase \"ne\":\r\n   299\t\t\t\tkeep = val == threshold\r\n   300"]
[144.858655, "o", "\t\t\tdefault:\r\n   301\t\t\t\treturn nil, fmt.Errorf(\"filter: unknown mode %q\", mode)\r\n   302\t\t\t}\r\n   303\t\t\tif keep {\r\n   304\t\t\t\tresult = append(result, val)\r\n   305\t\t\t}\r\n   306\t\t}\r\n   307\t\r\n   308\t\tif result == nil {\r\n"]
