[3534.193243, "o", "nl -ba main.go | sed -n '1,90p'\r\n\u001b[?2004l\r"]
[3534.197165, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"flag\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"log\"\r\n"]
[3534.19726, "o", "     8\t\t\"net/http\"\r\n     9\t\t\"os\"\r\n    10\t\r\n    11\t\t\"gomlops/internal/api\"\r\n    12\t\t\"gomlops/internal/experiment\"\r\n    13\t\t\"gomlops/internal/pipeline\"\r\n    14\t\t\"gomlops/internal/registry\"\r\n    15\t\t\"gomlops/internal/serving\"\r\n    16\t)\r\n    17\t\r\n    18\t// Config holds the server configuration.\r\n    19\ttype Config struct {\r\n    20\t\tPort    int    `json:\"port\"`\r\n    21\t"]
[3534.197352, "o", "\tDataDir string `json:\"data_dir\"`\r\n    22\t}\r\n    23\t\r\n    24\tfunc main() {\r\n    25\t\tconfigPath := flag.String(\"config\", \"/app/configs/config.json\", \"path to config file\")\r\n    26\t\tflag.Parse()\r\n    27\t\r\n    28\t\t"]
[3534.197422, "o", "cfg, err := loadConfig(*configPath)\r\n    29\t\tif err != nil {\r\n    30\t\t\tlog.Fatalf(\"Failed to load config: %v\", err)\r\n    31\t\t}\r\n    32\t\r\n    33\t\treg, err := registry.NewRegistry(cfg.DataDir + \"/registry\")\r\n    34\t\tif err != nil {\r\n    35\t\t\tlog.Fatalf(\"Failed to initialize registry: %v\", err)\r\n    36\t\t}\r\n    37\t\r\n    38\t\teng := pipeline.NewEngine()\r\n    39\t\ttracker := experiment.NewTracker(cfg.DataDir + \"/experiments\")\r\n    40\t\tsrv := serving.NewServer(reg)\r\n    41\t\r\n    42\t\trouter := api.NewRouter(reg, eng, tracker, srv)\r\n    43\t\r\n    44\t\taddr := fmt.Sprintf(\":%d\", cfg.Port)\r\n"]
[3534.197492, "o", "    45\t\tlog.Printf(\"gomlops server starting on %s\", addr)\r\n    46\t\tlog.Printf(\"data directory: %s\", cfg.DataDir)\r\n    47\t\tif err := http.ListenAndServe(addr, router); err != nil {\r\n    48\t\t\tlog.Fatalf(\"Server failed: %v\", err)\r\n    49\t\t}\r\n"]
[3534.19756, "o", "    50\t}\r\n    51\t\r\n    52\tfunc loadConfig(path string) (*Config, error) {\r\n    53\t\tdata, err := os.ReadFile(path)\r\n    54\t\tif err != nil {\r\n    55\t\t\treturn &Config{Port: 8080, DataDir: \"/app/data\"}, nil\r\n    56\t\t}\r\n    57\t\tvar cfg Config\r\n    58\t\tif err := json.Unmarshal(data, &cfg); err != nil {\r\n    59\t\t\treturn nil, fmt.Errorf(\"parse config: %w\", err)\r\n    60\t\t}\r\n    61\t\tif cfg.Port == 0 {\r\n    62\t\t\tcfg.Port = 8080\r\n    63\t"]
[3534.197623, "o", "\t}\r\n    64\t\tif cfg.DataDir == \"\" {\r\n    65\t\t\tcfg.DataDir = \"/app/data\"\r\n    66\t\t}\r\n    67\t\treturn &cfg, nil\r\n    68\t}\r\n"]
