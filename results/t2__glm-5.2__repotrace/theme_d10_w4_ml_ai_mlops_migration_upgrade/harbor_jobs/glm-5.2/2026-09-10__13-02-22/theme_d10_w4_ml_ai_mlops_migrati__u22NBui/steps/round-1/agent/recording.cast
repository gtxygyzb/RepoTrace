[4624.420913, "o", "func (h *Handlers) RemoveDependency(w http.ResponseWriter, r *http.Request) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[4624.420951, "o", "> "]
[4624.42103, "o", "\\tmodelName := r.PathValue(\"name\")\r\n\u001b[?2004l\r"]
[4624.421067, "o", "\u001b[?2004h> "]
[4624.421134, "o", "\\tdep := r.PathValue(\"dep\")\r\n\u001b[?2004l\r"]
[4624.421172, "o", "\u001b[?2004h> "]
[4624.421342, "o", "\\tif err := h.Registry.RemoveDependency(modelName, dep); err != nil {\r\n\u001b[?2004l\r"]
[4624.42138, "o", "\u001b[?2004h> "]
[4624.421506, "o", "\\t\\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\u001b[?2004l\r"]
[4624.421544, "o", "\u001b[?2004h> "]
