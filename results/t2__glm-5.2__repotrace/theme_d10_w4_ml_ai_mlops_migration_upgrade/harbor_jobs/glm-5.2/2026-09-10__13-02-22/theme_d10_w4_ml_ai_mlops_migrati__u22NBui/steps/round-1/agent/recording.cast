[1998.954277, "o", "package api\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[1998.95435, "o", "\t\"net/http\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\r\n\t\"gomlops/internal/pipeline\"\r\n\t\"gomlops/internal/registry\"\r\n\t\"gomlops/internal/serving\"\r\n)\r\n\r\n// --- Model Registry Handlers ---\r\n\r\nfunc (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\t"]
[1998.954425, "o", "Name        string   `json:\"name\"`\r\n\t\tFramework   string   `json:\"framework\"`\r\n\t\tDescription string   `json:\"description\"`\r\n\t\tTags        []string `json:\"tags\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Name == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"name is required\")\r\n\t\treturn\r\n"]
[1998.954489, "o", "\t}\r\n\r\n\tmodel, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, model)\r\n}\r\n\r\nfunc (h *Handlers) ListModels(w http.ResponseWriter, r *http.Request) {\r\n\tvar filter *registry.ModelFilter\r\n"]
[1998.954554, "o", "\tframework := r.URL.Query().Get(\"framework\")\r\n\ttag := r.URL.Query().Get(\"tag\")\r\n\tif framework != \"\" || tag != \"\" {\r\n\t\tfilter = &registry.ModelFilter{Framework: framework, Tag: tag}\r\n\t}\r\n\r\n\tmodels, err := h.Registry.ListModels(filter)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusInternalServerError, \"%v\", err)\r\n\t\treturn\r\n\t}"]
[1998.954622, "o", "\r\n\twriteJSON(w, http.StatusOK, models)\r\n}\r\n\r\nfunc (h *Handlers) DeleteModel(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\tif err := h.Registry.DeleteModel(name); err != nil {\r\n"]
[1998.95469, "o", "\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\t_ = h.Serving.UnloadModel(name)\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"deleted\"})\r\n}\r\n\r\nfunc (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\tmodel, err := h.Registry.GetModel(name)\r\n\tif err != nil {\r\n"]
[1998.954765, "o", "\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, model)\r\n}\r\n\r\nfunc (h *Handlers) CreateVersion(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\r\n\tvar req struct {\r\n\t\tMetrics     map[string]float64     `json:\"metrics\"`\r\n\t\tTags        []string               `json:\"tags\"`\r\n\t\tModelConfig map[string]interface{} `json:\"model_config\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t"]
[1998.954843, "o", "\treturn\r\n\t}\r\n\r\n\tversion, err := h.Registry.CreateVersion(modelName, req.Metrics, req.Tags, req.ModelConfig)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, version)\r\n}\r\n\r\nfunc (h *Handlers) GetVersion(w http.ResponseWriter, r *http.Request) {\r\n\t"]
[1998.954916, "o", "modelName := r.PathValue(\"name\")\r\n\tnumStr := r.PathValue(\"num\")\r\n\tnum, err := strconv.Atoi(numStr)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\t\treturn\r\n\t}\r\n\r\n\tversion, err := h.Registry.GetVersion(modelName, num)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n"]
[1998.954988, "o", "\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, version)\r\n}\r\n\r\nfunc (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {\r\n\tmodelName := r.PathValue(\"name\")\r\n\tnumStr := r.PathValue(\"num\")\r\n\tnum, err := strconv.Atoi(numStr)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid version number: %v\", err)\r\n\t"]
[1998.955049, "o", "\treturn\r\n\t}\r\n\r\n\tvar req struct {\r\n\t\tStage string `json:\"stage\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Stage == \"\" {\r\n"]
[1998.955114, "o", "\t\twriteError(w, http.StatusBadRequest, \"stage is required\")\r\n\t\treturn\r\n\t}\r\n\r\n\tif err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t"]
[1998.955176, "o", "}\r\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"promoted\"})\r\n}\r\n\r\n// --- Pipeline Handlers ---\r\n\r\nfunc (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tName     string                 `json:\"name\"`\r\n\t\tSteps    []*pipeline.Step       `json:\"steps\"`\r\n\t\tInput    map[string]interface{} `json:\"input\"`\r\n\t\tPipeline *pipeline.Pipeline     `json:\"pipeline\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n"]
[1998.955241, "o", "\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tp := req.Pipeline\r\n\tif p == nil {\r\n\t\t"]
[1998.955304, "o", "p = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}\r\n\t}\r\n\tif p == nil || len(p.Steps) == 0 {\r\n\t\twriteError(w, http.StatusBadRequest, \"pipeline with at least one step is required\")\r\n\t\treturn\r\n\t}\r\n\tif req.Input == nil {\r\n\t\treq.Input = make(map[string]interface{})\r\n\t}\r\n\r\n\tresult, err := h.Pipeline.Execute(p, req.Input)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusOK, result)"]
[1998.955388, "o", "\r\n}\r\n\r\n// --- Experiment Handlers ---\r\n\r\nfunc (h *Handlers) CreateExperiment(w http.ResponseWriter, r *http.Request) {\r\n\tvar req struct {\r\n\t\tName string `json:\"name\"`\r\n\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\tif req.Name == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"name is required\")\r\n"]
[1998.955445, "o", "\t\treturn\r\n\t}\r\n\r\n\texp, err := h.Experiment.CreateExperiment(req.Name)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusConflict, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n\twriteJSON(w, http.StatusCreated, exp)\r\n"]
[1998.955508, "o", "}\r\n\r\nfunc (h *Handlers) ListExperiments(w http.ResponseWriter, r *http.Request) {\r\n\texps := h.Experiment.ListExperiments()\r\n\twriteJSON(w, http.StatusOK, exps)\r\n}\r\n\r\nfunc (h *Handlers) GetExperiment(w http.ResponseWriter, r *http.Request) {\r\n\tname := r.PathValue(\"name\")\r\n\texp, err := h.Experiment.GetExperiment(name)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n"]
[1998.955576, "o", "\t}\r\n\twriteJSON(w, http.StatusOK, exp)\r\n}\r\n\r\nfunc (h *Handlers) LogRun(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\r\n\tvar req struct {\r\n\t\tParameters map[string]float64 `json:\"parameters\"`\r\n\t\tMetrics    map[string]float64 `json:\"metrics\"`\r\n\t\tTags       map[string]string  `json:\"tags\"`\r\n"]
[1998.955639, "o", "\t}\r\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"invalid request body: %v\", err)\r\n\t\treturn\r\n\t}\r\n\r\n\trun, err := h.Experiment.LogRun(expName, req.Parameters, req.Metrics, req.Tags)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusNotFound, \"%v\", err)\r\n\t\treturn\r\n"]
[1998.955711, "o", "\t}\r\n\twriteJSON(w, http.StatusCreated, run)\r\n}\r\n\r\nfunc (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {\r\n\texpName := r.PathValue(\"name\")\r\n\tmetricName := r.PathValue(\"metric\")\r\n\taggType := r.URL.Query().Get(\"type\")\r\n\tweightParam := r.URL.Query().Get(\"weight_param\")\r\n\ttagFilters := map[string]string{}\r\n\tfor _, filter := range r.URL.Query()[\"tag_filter\"] {\r\n\t\tparts := strings.SplitN(filter, \":\", 2)\r\n"]
[1998.955771, "o", "\t\tif len(parts) != 2 {\r\n\t\t\twriteError(w, http.StatusBadRequest, \"invalid tag_filter %q, expected key:value\", filter)\r\n\t\t\treturn\r\n\t\t}\r\n\t\ttagFilters[parts[0]] = parts[1]\r\n\t}\r\n\r\n\tif aggType == \"\" {\r\n\t\twriteError(w, http.StatusBadRequest, \"query parameter 'type' is required\")\r\n"]
[1998.955831, "o", "\t\treturn\r\n\t}\r\n\r\n\tresult, count, runIDs, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam, tagFilters)\r\n\tif err != nil {\r\n\t\twriteError(w, http.StatusBadRequest, \"%v\", err)\r\n\t\treturn\r\n\t}\r\n"]
