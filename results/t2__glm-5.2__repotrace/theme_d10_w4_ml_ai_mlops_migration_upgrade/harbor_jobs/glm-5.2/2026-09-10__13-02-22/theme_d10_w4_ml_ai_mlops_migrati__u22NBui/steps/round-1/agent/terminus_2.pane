   113	func (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {
   114		modelName := r.PathValue("name")
   115		numStr := r.PathValue("num")
   116		num, err := strconv.Atoi(numStr)
   117		if err != nil {
   118			writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
   119			return
   120		}
   121	
   122		var req struct {
   123			Stage string `json:"stage"`
   124		}
   125		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   126			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   127			return
   128		}
   129		if req.Stage == "" {
   130			writeError(w, http.StatusBadRequest, "stage is required")
   131			return
   132		}
   133	
   134		if err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {
   135			writeError(w, http.StatusBadRequest, "%v", err)
   136			return
   137		}
   138		writeJSON(w, http.StatusOK, map[string]string{"status": "promoted"})
   139	}
