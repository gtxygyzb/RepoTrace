[?2004l   351	func (h *Handlers) CompareVersionMetrics(w http.ResponseWriter, r *http.Request) {
   352		modelName := r.PathValue("name")
   353		versionParam := r.URL.Query().Get("versions")
   354		if versionParam == "" {
   355			writeError(w, http.StatusBadRequest, "query parameter 'versions' is required")
   356			return
   357		}
   358	
   359		parts := strings.Split(versionParam, ",")
   360		seen := map[int]bool{}
   361		versionNums := make([]int, 0, len(parts))
   362		for _, p := range parts {
   363			num, err := strconv.Atoi(strings.TrimSpace(p))
   364			if err != nil {
   365				writeError(w, http.StatusBadRequest, "invalid version number: %q", p)
   366				return
   367			}
   368			if seen[num] {
   369				writeError(w, http.StatusBadRequest, "duplicate version number: %d", num)
   370				return
   371			}
   372			seen[num] = true
   373			versionNums = append(versionNums, num)
   374		}
   375		if len(versionNums) < 2 {
   376			writeError(w, http.StatusBadRequest, "at least 2 versions are required for comparison")
   377			return
   378		}
   379	
   380		model, err := h.Registry.GetModel(modelName)
   381		if err != nil {
   382			writeError(w, http.StatusNotFound, "%v", err)
   383			return
   384		}
   385	
   386		sort.Ints(versionNums)
   387		versionMap := map[int]*registry.Version{}
   388		for _, v := range model.Versions {
   389			versionMap[v.Number] = v
   390		}
   391	
   392		versions := make([]map[string]interface{}, 0, len(versionNums))
   393		for _, num := range versionNums {
   394			v, ok := versionMap[num]
   395			if !ok {
   396				writeError(w, http.StatusBadRequest, "version %d does not exist for model %q", num, modelName)
   397				return
   398			}
   399			versions = append(versions, map[string]interface{}{
   400				"number":  v.Number,
   401				"stage":   v.Stage,
   402				"metrics": v.Metrics,
   403			})
   404		}
   405	
   406		metricSummary := map[string]map[string]interface{}{}
   407		metricValues := map[string][]float64{}
   408		for _, v := range versions {
   409			metrics, _ := v["metrics"].(map[string]float64)
   410			for name, val := range metrics {
   411				metricValues[name] = append(metricValues[name], val)
   412			}
   413		}
   414	
   415		for name, vals := range metricValues {
   416			if len(vals) == 0 {
   417				continue
   418			}
   419			minVal := vals[0]
   420			maxVal := vals[0]
   421			sum := 0.0
   422			for _, val := range vals {
   423				if val < minVal {
   424					minVal = val
   425				}
   426				if val > maxVal {
   427					maxVal = val
   428				}
   429				sum += val
   430			}
   431			first := vals[0]
   432			last := vals[len(vals)-1]
   433			improvement := last - first
   434			trend := "stable"
   435			if improvement > 0 {
   436				trend = "improving"
   437			} else if improvement < 0 {
   438				trend = "degrading"
   439			}
   440			metricSummary[name] = map[string]interface{}{
   441				"min":         minVal,
   442				"max":         maxVal,
   443				"first":       first,
   444				"last":        last,
   445				"improvement": improvement,
   446				"mean":        sum / float64(len(vals)),
   447				"trend":       trend,
   448			}
   449		}
   450	
   451		writeJSON(w, http.StatusOK, map[string]interface{}{
   452			"model":          modelName,
   453			"versions":       versions,
   454			"metric_summary": metricSummary,
   455		})
   456	}
