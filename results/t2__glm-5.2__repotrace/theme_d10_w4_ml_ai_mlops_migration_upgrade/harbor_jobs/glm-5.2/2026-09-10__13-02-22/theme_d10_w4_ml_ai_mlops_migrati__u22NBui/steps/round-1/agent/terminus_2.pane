    76	// ValidationResult describes the structural validation outcome of a pipeline.
    77	type ValidationResult struct {
    78		Valid          bool            `json:"valid"`
    79		ExecutionOrder []string        `json:"execution_order"`
    80		StepCount      int             `json:"step_count"`
    81		Steps          []ValidatedStep `json:"steps"`
    82		Errors         []string        `json:"errors"`
    83	}
    84	
    85	// ValidatedStep contains structural details for a validated step.
    86	type ValidatedStep struct {
    87		Name         string   `json:"name"`
    88		Type         StepType `json:"type"`
    89		Dependencies []string `json:"dependencies"`
    90	}
    91	
    92	// Validate checks a pipeline definition for structural correctness without executing it.
    93	func (e *Engine) Validate(p *Pipeline) *ValidationResult {
    94		result := &ValidationResult{
    95			Valid:          true,
    96			ExecutionOrder: []string{},
    97			Steps:          []ValidatedStep{},
    98			Errors:         []string{},
    99		}
   100		if p == nil {
   101			result.Valid = false
   102			result.Errors = append(result.Errors, "pipeline definition is required")
   103			return result
   104		}
   105	
   106		stepCount := len(p.Steps)
   107		result.StepCount = stepCount
   108	
   109		seen := make(map[string]bool)
   110		duplicateNames := make(map[string]bool)
   111		nameOrder := make([]string, 0, stepCount)
   112	
   113		for _, step := range p.Steps {
   114			if step == nil {
   115				result.Valid = false
   116				result.Errors = append(result.Errors, "step is null")
   117				continue
   118			}
   119			result.Steps = append(result.Steps, ValidatedStep{
   120				Name:         step.Name,
   121				Type:         step.Type,
   122				Dependencies: step.Dependencies,
   123			})
   124			if seen[step.Name] {
   125				duplicateNames[step.Name] = true
   126			}
   127			if !seen[step.Name] {
   128				seen[step.Name] = true
   129				nameOrder = append(nameOrder, step.Name)
   130			}
   131		}
   132		if len(duplicateNames) > 0 {
   133			result.Valid = false
   134			for name := range duplicateNames {
   135				result.Errors = append(result.Errors, fmt.Sprintf("duplicate step name: %s", name))
   136			}
   137		}
   138	
   139		for _, step := range p.Steps {
   140			if step == nil {
   141				continue
   142			}
   143			if _, exists := e.stepExecutors[step.Type]; !exists {
   144				result.Valid = false
   145				result.Errors = append(result.Errors, fmt.Sprintf("unknown step type: %s", step.Type))
   146			}
   147			for _, dep := range step.Dependencies {
   148				if !seen[dep] {
   149					result.Valid = false
   150					result.Errors = append(result.Errors, fmt.Sprintf("step %s depends on unknown step: %s", step.Name, dep))
   151				}
   152			}
   153		}
   154	
   155		ordered, err := topologicalSort(p.Steps)
   156		if err != nil {
   157			result.Valid = false
   158			if strings.Contains(err.Error(), "cycle") {
   159				result.Errors = append(result.Errors, "dependency cycle detected")
   160			}
   161		}
   162	
   163		if result.Valid && err == nil {
   164			for _, step := range ordered {
   165				result.ExecutionOrder = append(result.ExecutionOrder, step.Name)
   166			}
   167		}
   168	
   169		if len(result.Errors) > 0 {
   170			result.Valid = false
   171			result.ExecutionOrder = []string{}
   172		}
   173	
   174		return result
   175	}
