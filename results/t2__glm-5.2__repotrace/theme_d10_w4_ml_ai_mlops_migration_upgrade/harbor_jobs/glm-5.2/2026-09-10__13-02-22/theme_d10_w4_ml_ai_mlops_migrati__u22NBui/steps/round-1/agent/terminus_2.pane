     9	
    10	// StepType identifies the kind of processing a pipeline step performs.
    11	type StepType string
    12	
    13	const (
    14		StepTransform StepType = "transform"
    15		StepValidate  StepType = "validate"
    16		StepAggregate StepType = "aggregate"
    17		StepExport    StepType = "export"
    18		StepFilter    StepType = "filter"
    19	)
    20	
    21	// Step defines a single unit of work in a pipeline.
    22	type Step struct {
    23		Name            string                 `json:"name"`
    24		Type            StepType               `json:"type"`
    25		Config          map[string]interface{} `json:"config"`
    26		Dependencies    []string               `json:"dependencies"`
    27		SetVars         map[string]string      `json:"set_vars,omitempty"`
    28		OutputTransform string                 `json:"output_transform,omitempty"`
    29	}
    30	
    31	// Pipeline defines a named sequence of dependent steps.
    32	type Pipeline struct {
    33		Name  string  `json:"name"`
    34		Steps []*Step `json:"steps"`
    35	}
    36	
    37	// StepResult records the outcome of executing a single step.
    38	type StepResult struct {
    39		StepName   string                 `json:"step_name"`
    40		StepType   StepType               `json:"step_type"`
    41		Status     string                 `json:"status"`
    42		Output     map[string]interface{} `json:"output,omitempty"`
    43		Error      string                 `json:"error,omitempty"`
    44		DurationMs float64                `json:"duration_ms"`
    45	}
    46	
    47	// PipelineResult records the outcome of executing an entire pipeline.
    48	type PipelineResult struct {
    49		PipelineName string        `json:"pipeline_name"`
    50		Status       string        `json:"status"`
    51		Steps        []*StepResult `json:"steps"`
    52		TotalTimeMs  float64       `json:"total_time_ms"`
    53	}
    54	
    55	// Engine executes pipelines by resolving step dependencies and running each step.
    56	type Engine struct {
    57		stepExecutors map[StepType]StepExecutor
    58	}
    59	
    60	// StepExecutor is the function signature for executing a pipeline step.
    61	type StepExecutor func(config, input map[string]interface{}) (map[string]interface{}, error)
