   141	func (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {
   142		modelName := r.PathValue("name")
   143		numStr := r.PathValue("num")
   144		num, err := strconv.Atoi(numStr)
   145		if err != nil {
   146			writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
   147			return
   148		}
   149	
   150		var req struct {
   151			Stage string `json:"stage"`
   152		}
   153		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   154			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   155			return
   156		}
   157		if req.Stage == "" {
   158			writeError(w, http.StatusBadRequest, "stage is required")
   159			return
   160		}
   161	
   162		if err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {
   163			writeError(w, http.StatusBadRequest, "%v", err)
   164			return
   165		}
   166		writeJSON(w, http.StatusOK, map[string]string{"status": "promoted"})
   167	}
