   644	// --- Experiment Comparison Handler ---
   645	
   646	type experimentComparisonEntry struct {
   647		Name  string  `json:"name"`
   648		Mean  float64 `json:"mean"`
   649		Min   float64 `json:"min"`
   650		Max   float64 `json:"max"`
   651		Count int     `json:"count"`
   652	}
   653	
   654	func (h *Handlers) CompareExperiments(w http.ResponseWriter, r *http.Request) {
   655		experimentsParam := r.URL.Query().Get("experiments")
   656		metric := r.URL.Query().Get("metric")
   657	
   658		if metric == "" {
   659			writeError(w, http.StatusBadRequest, "metric parameter is required")
   660			return
   661		}
   662	
   663		names := strings.Split(experimentsParam, ",")
   664		if len(names) < 2 {
   665			writeError(w, http.StatusBadRequest, "at least two experiment names are required")
   666			return
   667		}
   668		for i := range names {
   669			names[i] = strings.TrimSpace(names[i])
   670		}
   671	
   672		for _, name := range names {
   673			if _, err := h.Experiment.GetExperiment(name); err != nil {
   674				writeError(w, http.StatusNotFound, "experiment %q not found", name)
   675				return
   676			}
   677		}
   678	
   679		var entries []experimentComparisonEntry
   680		var means []float64
   681		totalRuns := 0
   682		best := ""
   683		var bestMean float64
   684	
   685		for _, name := range names {
   686			exp, err := h.Experiment.GetExperiment(name)
   687			if err != nil {
   688				writeError(w, http.StatusNotFound, "experiment %q not found", name)
   689				return
   690			}
   691	
   692			var values []float64
   693			for _, run := range exp.Runs {
   694				if value, ok := run.Metrics[metric]; ok {
   695					values = append(values, value)
   696				}
   697			}
   698			if len(values) == 0 {
   699				continue
   700			}
   701	
   702			sum := 0.0
   703			minVal := values[0]
   704			maxVal := values[0]
   705			for _, value := range values {
   706				sum += value
   707				if value < minVal {
   708					minVal = value
   709				}
   710				if value > maxVal {
   711					maxVal = value
   712				}
   713			}
   714			mean := sum / float64(len(values))
   715			entries = append(entries, experimentComparisonEntry{
   716				Name:  name,
   717				Mean:  mean,
   718				Min:   minVal,
   719				Max:   maxVal,
   720				Count: len(values),
   721			})
   722			means = append(means, mean)
   723			totalRuns += len(values)
   724			if len(entries) == 1 || mean > bestMean {
   725				best = name
   726				bestMean = mean
   727			}
   728		}
   729	
   730		if len(entries) == 0 {
   731			writeError(w, http.StatusBadRequest, "no data found for metric %q across specified experiments", metric)
   732			return
   733		}
   734	
   735		spread := 0.0
   736		if len(means) > 0 {
   737			minMean := means[0]
   738			maxMean := means[0]
   739			for _, mean := range means {
   740				if mean < minMean {
   741					minMean = mean
   742				}
   743				if mean > maxMean {
   744					maxMean = mean
   745				}
   746			}
   747			spread = maxMean - minMean
   748		}
   749	
   750		writeJSON(w, http.StatusOK, map[string]interface{}{
   751			"metric":      metric,
   752			"experiments": entries,
   753			"best":        best,
   754			"summary": map[string]interface{}{
   755				"spread":           spread,
   756				"experiment_count": len(entries),
   757				"total_runs":       totalRuns,
   758			},
   759		})
   760	}
