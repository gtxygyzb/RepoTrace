    11	type batchRequest struct {
    12		Requests []serving.InferenceRequest `json:"requests"`
    13		Strategy string                     `json:"strategy"`
    14	}
    15	
    16	func (h *Handlers) BatchInfer(w http.ResponseWriter, r *http.Request) {
    17		var req batchRequest
    18		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
    19			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
    20			return
    21		}
    22		if len(req.Requests) == 0 {
    23			writeError(w, http.StatusBadRequest, "requests array is required and cannot be empty")
    24			return
    25		}
    26		strategy := req.Strategy
    27		if strategy == "" {
    28			strategy = "independent"
    29		}
    30		if strategy != "independent" && strategy != "stop_on_error" {
    31			writeError(w, http.StatusBadRequest, "invalid strategy %q", strategy)
    32			return
    33		}
    34	
    35		start := time.Now()
    36		results := make([]map[string]interface{}, 0, len(req.Requests))
    37		succeeded := 0
    38		failed := 0
    39		skipped := 0
    40		stop := false
    41	
    42		for i, ir := range req.Requests {
    43			if stop {
    44				results = append(results, map[string]interface{}{
    45					"model_name": ir.ModelName,
    46					"status":     "skipped",
    47				})
    48				skipped++
    49				continue
    50			}
    51	
    52			if ir.ModelName == "" {
    53				results = append(results, map[string]interface{}{
    54					"model_name": ir.ModelName,
    55					"error":      "model_name is required",
    56				})
    57				failed++
    58				if strategy == "stop_on_error" {
    59					stop = true
    60				}
    61				continue
    62			}
    63	
    64			resp, err := h.Serving.Infer(&ir)
    65			if err != nil {
    66				h.Serving.RecordRequest(ir.ModelName, false, 0)
    67				results = append(results, map[string]interface{}{
    68					"model_name": ir.ModelName,
    69					"error":      err.Error(),
    70				})
    71				failed++
    72				if strategy == "stop_on_error" {
    73					stop = true
    74				}
    75				continue
    76			}
    77	
    78			h.Serving.RecordRequest(ir.ModelName, true, resp.LatencyMs)
    79			results = append(results, map[string]interface{}{
    80				"model_name":  resp.ModelName,
    81				"version":     resp.Version,
    82				"predictions": resp.Predictions,
    83				"latency_ms":  resp.LatencyMs,
    84			})
    85			succeeded++
    86			_ = i
    87		}
    88	
    89		summary := map[string]int{
    90			"total":     len(req.Requests),
    91			"succeeded": succeeded,
    92			"failed":    failed,
    93		}
    94		if strategy == "stop_on_error" {
    95			summary["skipped"] = skipped
    96		}
    97	
    98		writeJSON(w, http.StatusOK, map[string]interface{}{
    99			"results":          results,
   100			"total_latency_ms": float64(time.Since(start).Microseconds()) / 1000.0,
   101			"summary":          summary,
   102		})
   103	}
