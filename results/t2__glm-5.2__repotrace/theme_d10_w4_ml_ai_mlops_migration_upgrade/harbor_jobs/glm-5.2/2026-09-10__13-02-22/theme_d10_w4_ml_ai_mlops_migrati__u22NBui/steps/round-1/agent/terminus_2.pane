   126	// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.
   127	// For weighted_mean, weightParam specifies which parameter to use as weight.
   128	func (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string, tagFilters map[string]string) (float64, int, []string, error) {
   129		t.mu.RLock()
   130		defer t.mu.RUnlock()
   131	
   132		exp, exists := t.experiments[experimentName]
   133		if !exists {
   134			return 0, 0, nil, fmt.Errorf("experiment %q not found", experimentName)
   135		}
   136	
   137		if len(exp.Runs) == 0 {
   138			return 0, 0, nil, fmt.Errorf("experiment %q has no runs", experimentName)
   139		}
   140	
   141		var values []float64
   142		var weights []float64
   143		var runIDs []string
   144		for _, run := range exp.Runs {
   145			if !matchTags(run.Tags, tagFilters) {
   146				continue
   147			}
   148			value, ok := run.Metrics[metricName]
   149			if !ok {
   150				continue
   151			}
   152			if aggType == "weighted_mean" {
   153				weight, ok := run.Metrics[weightParam]
   154				if !ok {
   155					continue
   156				}
   157				values = append(values, value)
   158				weights = append(weights, weight)
   159				runIDs = append(runIDs, run.ID)
   160			} else {
   161				values = append(values, value)
   162				runIDs = append(runIDs, run.ID)
   163			}
   164		}
   165	
   166		if len(values) == 0 {
   167			if len(tagFilters) > 0 {
   168				return 0, 0, nil, fmt.Errorf("no runs match tag filters for metric %q", metricName)
   169			}
   170			return 0, 0, nil, fmt.Errorf("no values found for metric %q", metricName)
   171		}
   172	
   173		switch aggType {
   174		case "mean":
   175			sum := 0.0
   176			for _, v := range values {
   177				sum += v
   178			}
   179			return sum / float64(len(values)), len(values), runIDs, nil
   180	
   181		case "median":
   182			sorted := sortedCopy(values)
   183			n := len(sorted)
   184			if n%2 == 0 {
   185				return (sorted[n/2-1] + sorted[n/2]) / 2, len(values), runIDs, nil
   186			}
   187			return sorted[n/2], len(values), runIDs, nil
   188	
   189		case "p95":
   190			sorted := sortedCopy(values)
   191			return percentile(sorted, 0.95), len(values), runIDs, nil
   192	
   193		case "p99":
   194			sorted := sortedCopy(values)
   195			return percentile(sorted, 0.99), len(values), runIDs, nil
   196	
   197		case "weighted_mean":
   198			if weightParam == "" {
   199				return 0, 0, nil, fmt.Errorf("weighted_mean requires weight parameter")
   200			}
   201			if len(weights) == 0 {
   202				return 0, 0, nil, fmt.Errorf("no runs with metric %q and weight metric %q", metricName, weightParam)
   203			}
   204			if len(weights) != len(values) {
   205				return 0, 0, nil, fmt.Errorf("mismatch between metric values and weights")
   206			}
   207			weightedSum := 0.0
   208			weightSum := 0.0
   209			for i, v := range values {
   210				weightedSum += v * weights[i]
   211				weightSum += weights[i]
   212			}
   213			if weightSum == 0 {
   214				return 0, 0, nil, fmt.Errorf("weighted_mean has zero total weight")
   215			}
