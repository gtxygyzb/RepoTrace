   289	func substituteParameters(tmpl *Template, params map[string]interface{}) (*pipeline.Pipeline, error) {
   290		declared := make(map[string]TemplateParameter)
   291		for _, p := range tmpl.Parameters {
   292			declared[p.Name] = p
   293		}
   294		for name := range params {
   295			if _, ok := declared[name]; !ok {
   296				return nil, fmt.Errorf("unknown parameter %q", name)
   297			}
   298		}
   299		resolved := make(map[string]interface{})
   300		for name, p := range declared {
   301			if val, ok := params[name]; ok {
   302				if err := validateParamValue(p, val); err != nil {
   303					return nil, err
   304				}
   305				resolved[name] = val
   306			} else if p.Default != nil {
   307				resolved[name] = p.Default
   308			} else {
   309				return nil, fmt.Errorf("missing required parameter %q", name)
   310			}
   311		}
   312		data, err := json.Marshal(tmpl.Pipeline)
   313		if err != nil {
   314			return nil, err
   315		}
   316		var p pipeline.Pipeline
   317		if err := json.Unmarshal(data, &p); err != nil {
   318			return nil, err
   319		}
   320		for _, step := range p.Steps {
   321			if step.Config != nil {
   322				for k, v := range step.Config {
   323					if s, ok := v.(string); ok {
   324						if strings.HasPrefix(s, "${param.") && strings.HasSuffix(s, "}") {
   325							paramName := s[8 : len(s)-1]
   326							val, ok := resolved[paramName]
   327							if !ok {
   328								return nil, fmt.Errorf("unknown parameter %q", paramName)
   329							}
   330							step.Config[k] = val
   331						}
   332					}
   333				}
   334			}
   335		}
   336		return &p, nil
   337	}
