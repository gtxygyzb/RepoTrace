   141	// --- Pipeline Handlers ---
   142	
   143	func (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {
   144		var req struct {
   145			Pipeline *pipeline.Pipeline     `json:"pipeline"`
   146			Input    map[string]interface{} `json:"input"`
   147		}
   148		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   149			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   150			return
   151		}
   152		if req.Pipeline == nil || len(req.Pipeline.Steps) == 0 {
   153			writeError(w, http.StatusBadRequest, "pipeline with at least one step is required")
   154			return
   155		}
   156		if req.Input == nil {
   157			req.Input = make(map[string]interface{})
   158		}
   159	
   160		result, err := h.Pipeline.Execute(req.Pipeline, req.Input)
   161		if err != nil {
   162			writeError(w, http.StatusBadRequest, "%v", err)
   163			return
   164		}
   165		writeJSON(w, http.StatusOK, result)
   166	}
