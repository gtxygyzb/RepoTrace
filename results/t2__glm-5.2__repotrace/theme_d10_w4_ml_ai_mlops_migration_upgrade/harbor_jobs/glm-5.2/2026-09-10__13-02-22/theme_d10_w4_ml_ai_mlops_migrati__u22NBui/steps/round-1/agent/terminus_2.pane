    57		mux.HandleFunc("DELETE /api/v1/experiments/{name}/runs/{id}", h.DeleteRun)
    58		mux.HandleFunc("GET /api/v1/experiments/{name}/metrics/{metric}/aggregate", h.AggregateMetric)
    59		mux.HandleFunc("GET /api/v1/experiments/{name}/metrics/{metric}/history", h.GetMetricHistory)
    60		mux.HandleFunc("PUT /api/v1/experiments/{name}/runs/{id}", h.UpdateRun)
    61		mux.HandleFunc("POST /api/v1/experiments/{name}/runs/search", h.SearchRuns)
    62	
    63		// Serving endpoints
