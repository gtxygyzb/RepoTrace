   283	// ExecuteFilter selects elements from the data array based on a comparison condition.
   284	// Supported modes: gt, lt, gte, lte, eq, ne.
   285	func ExecuteFilter(config, input map[string]interface{}) (map[string]interface{}, error) {
   286		data, ok := input["data"].([]interface{})
   287		if !ok {
   288			return nil, fmt.Errorf("filter: missing or invalid 'data' field in input")
   289		}
   290	
   291		mode, _ := config["mode"].(string)
   292		if mode == "" {
   293			return nil, fmt.Errorf("filter: missing 'mode' in config")
   294		}
   295		threshold, _ := config["threshold"].(float64)
   296	
   297		var result []interface{}
   298		for _, v := range data {
   299			val, err := toFloat(v)
   300			if err != nil {
   301				continue
   302			}
   303			var keep bool
   304			switch mode {
   305			case "gt":
   306				keep = val > threshold
   307			case "lt":
   308				keep = val < threshold
   309			case "gte":
   310				keep = val >= threshold
   311			case "lte":
   312				keep = val <= threshold
   313			case "eq":
   314				keep = val == threshold
   315			case "ne":
   316				keep = val != threshold
   317			default:
   318				return nil, fmt.Errorf("filter: unknown mode %q", mode)
   319			}
   320			if keep {
   321				result = append(result, val)
   322			}
   323		}
   324	
   325		if result == nil {
   326			result = []interface{}{}
   327		}
   328		return map[string]interface{}{"data": result}, nil
   329	}
