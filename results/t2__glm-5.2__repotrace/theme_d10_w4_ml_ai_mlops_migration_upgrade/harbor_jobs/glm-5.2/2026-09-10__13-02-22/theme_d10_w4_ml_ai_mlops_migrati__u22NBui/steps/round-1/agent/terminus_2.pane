[?2004l[?2004h> insert = '''
[?2004l[?2004h> // executeWithRetryAndTimeout runs an executor with optional retry and timeout.
[?2004l[?2004h> func (e *Engine) executeWithRetryAndTimeout(executor StepExecutor, config, input map[string]interface{}, retry, timeoutMs int) (map[string]interface{}, error, int, bool) {
[?2004l[?2004h> \tmaxAttempts := retry + 1
[?2004l[?2004h> \tif maxAttempts < 1 {
[?2004l[?2004h> \t\tmaxAttempts = 1
[?2004l[?2004h> \t}
[?2004l[?2004h> 
[?2004l[?2004h> \tvar output map[string]interface{}
[?2004l[?2004h> \tvar err error
[?2004l[?2004h> \tfor attempt := 0; attempt < maxAttempts; attempt++ {
[?2004l[?2004h> \t\ttype execResult struct {
[?2004l[?2004h> \t\t\toutput map[string]interface{}
[?2004l[?2004h> \t\t\terr    error
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t\tresChan := make(chan execResult, 1)
[?2004l[?2004h> \t\tstart := time.Now()
[?2004l[?2004h> \t\tgo func() {
[?2004l[?2004h> \t\t\tout, e := executor(config, input)
[?2004l[?2004h> \t\t\tresChan <- execResult{output: out, err: e}
[?2004l[?2004h> \t\t}()
[?2004l[?2004h> 
[?2004l[?2004h> \t\tif timeoutMs > 0 {
[?2004l[?2004h> \t\t\tselect {
[?2004l[?2004h> \t\t\tcase res := <-resChan:
[?2004l[?2004h> \t\t\t\toutput, err = res.output, res.err
[?2004l[?2004h> \t\t\tcase <-time.After(time.Duration(timeoutMs)*time.Millisecond - time.Since(start)):
[?2004l[?2004h> \t\t\t\treturn nil, nil, attempt, true
[?2004l[?2004h> \t\t\t}
[?2004l[?2004h> \t\t} else {
[?2004l[?2004h> \t\t\tres := <-resChan
[?2004l[?2004h> \t\t\toutput, err = res.output, res.err
[?2004l[?2004h> \t\t}
[?2004l[?2004h> 
[?2004l[?2004h> \t\tif err == nil {
[?2004l[?2004h> \t\t\treturn output, nil, attempt, false
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t}
[?2004l[?2004h> 
[?2004l[?2004h> \treturn output, err, maxAttempts - 1, false
[?2004l[?2004h> }
[?2004l[?2004h> '''
[?2004l[?2004h> marker = '\n// shouldSkipStep evaluates a step\'s skip_condition against pipeline variables.\n'
[?2004l[?2004h> if marker not in s:
[?2004l[?2004h>     raise SystemExit('marker not found')
[?2004l[?2004h> s = s.replace(marker, insert + marker)
[?2004l[?2004h> p.write_text(s)
