     9	// ExecuteTransform applies a data transformation.
    10	// Supported modes: scale, offset, normalize, identity, clip, log.
    11	func ExecuteTransform(config, input map[string]interface{}) (map[string]interface{}, error) {
    12		data, ok := input["data"].([]interface{})
    13		if !ok {
    14			return nil, fmt.Errorf("transform: missing or invalid 'data' field in input")
    15		}
    16	
    17		mode, _ := config["mode"].(string)
    18		if mode == "" {
    19			return nil, fmt.Errorf("transform: missing 'mode' in config")
    20		}
    21	
    22		result := make([]interface{}, len(data))
    23	
    24		switch mode {
    25		case "scale":
    26			factor, _ := config["factor"].(float64)
    27			for i, v := range data {
    28				val, err := toFloat(v)
    29				if err != nil {
    30					return nil, fmt.Errorf("transform scale: element %d: %w", i, err)
    31				}
    32				result[i] = val * factor
    33			}
    34	
    35		case "offset":
    36			offset, _ := config["offset"].(float64)
    37			for i, v := range data {
    38				val, err := toFloat(v)
    39				if err != nil {
    40					return nil, fmt.Errorf("transform offset: element %d: %w", i, err)
    41				}
    42				result[i] = val + offset
    43			}
    44	
    45		case "normalize":
    46			if len(data) == 0 {
    47				return map[string]interface{}{"data": result}, nil
    48			}
    49			minVal, maxVal := findMinMax(data)
    50			for i, v := range data {
    51				val, err := toFloat(v)
    52				if err != nil {
    53					return nil, fmt.Errorf("transform normalize: element %d: %w", i, err)
    54				}
    55				if maxVal == minVal {
    56					result[i] = 0.0
    57				} else {
    58					result[i] = (val - minVal) / (maxVal - minVal)
    59				}
    60			}
    61	
    62		case "identity":
    63			copy(result, data)
    64	
    65		case "clip":
    66			low, _ := config["low"].(float64)
    67			high, _ := config["high"].(float64)
    68			for i, v := range data {
    69				val, err := toFloat(v)
    70				if err != nil {
    71					return nil, fmt.Errorf("transform clip: element %d: %w", i, err)
    72				}
    73				if val < low {
    74					val = low
    75				}
    76				if val > high {
    77					val = high
    78				}
    79				result[i] = val
    80			}
    81	
    82		case "log":
    83			for i, v := range data {
    84				val, err := toFloat(v)
    85				if err != nil {
    86					return nil, fmt.Errorf("transform log: element %d: %w", i, err)
    87				}
    88				if val <= 0 {
    89					return nil, fmt.Errorf("transform log: element %d is non-positive (%f)", i, val)
    90				}
    91				result[i] = math.Log(val)
    92			}
    93	
    94		default:
    95			return nil, fmt.Errorf("transform: unknown mode %q", mode)
    96		}
    97	
    98		return map[string]interface{}{"data": result}, nil
    99	}
   100	
   101	// ExecuteValidate checks data against schema constraints.
   102	func ExecuteValidate(config, input map[string]interface{}) (map[string]interface{}, error) {
   103		data, ok := input["data"].([]interface{})
   104		if !ok {
   105			return nil, fmt.Errorf("validate: missing or invalid 'data' field")
   106		}
   107	
   108		var errors []interface{}
   109	
   110		// Check min_value constraint
   111		if minVal, ok := config["min_value"].(float64); ok {
   112			for i, v := range data {
   113				val, err := toFloat(v)
   114				if err != nil {
   115					errors = append(errors, fmt.Sprintf("element %d: not a number", i))
   116					continue
   117				}
   118				if val < minVal {
   119					errors = append(errors, fmt.Sprintf("element %d: value %f below minimum %f", i, val, minVal))
   120				}
   121			}
   122		}
   123	
   124		// Check max_value constraint
   125		if maxVal, ok := config["max_value"].(float64); ok {
   126			for i, v := range data {
   127				val, err := toFloat(v)
   128				if err != nil {
   129					continue
   130				}
   131				if val > maxVal {
   132					errors = append(errors, fmt.Sprintf("element %d: value %f above maximum %f", i, val, maxVal))
   133				}
   134			}
   135		}
   136	
   137		// Check min_count constraint
   138		if minCount, ok := config["min_count"].(float64); ok {
   139			if float64(len(data)) < minCount {
   140				errors = append(errors, fmt.Sprintf("data has %d elements, minimum required is %d", len(data), int(minCount)))
   141			}
   142		}
   143	
   144		valid := len(errors) == 0
   145		return map[string]interface{}{
   146			"valid":  valid,
   147			"errors": errors,
   148			"data":   data,
   149		}, nil
   150	}
   151	
   152	// ExecuteAggregate computes aggregations over input data.
   153	// Supported operations: sum, mean, count, min, max.
   154	func ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {
   155		data, ok := input["data"].([]interface{})
   156		if !ok {
   157			return nil, fmt.Errorf("aggregate: missing or invalid 'data' field")
   158		}
   159	
   160		operation, _ := config["operation"].(string)
   161		if operation == "" {
   162			return nil, fmt.Errorf("aggregate: missing 'operation' in config")
   163		}
   164	
   165		values := make([]float64, 0, len(data))
   166		for _, v := range data {
   167			val, err := toFloat(v)
   168			if err != nil {
   169				continue
   170			}
   171			values = append(values, val)
   172		}
   173	
   174		if len(values) == 0 {
   175			return map[string]interface{}{"result": 0.0, "count": 0.0}, nil
   176		}
   177	
   178		var result float64
   179		switch operation {
   180		case "sum":
   181			for _, v := range values {
   182				result += v
   183			}
   184		case "mean":
   185			for _, v := range values {
   186				result += v
   187			}
   188			result /= float64(len(values))
   189		case "count":
   190			result = float64(len(values))
   191		case "min":
   192			result = values[0]
   193			for _, v := range values[1:] {
   194				if v < result {
   195					result = v
   196				}
   197			}
   198		case "max":
   199			result = values[0]
   200			for _, v := range values[1:] {
   201				if v > result {
   202					result = v
   203				}
   204			}
   205		default:
   206			return nil, fmt.Errorf("aggregate: unknown operation %q", operation)
   207		}
   208	
   209		return map[string]interface{}{
   210			"result": result,
   211			"count":  float64(len(values)),
   212			"data":   data,
   213		}, nil
   214	}
   215	
   216	// ExecuteExport formats data for output.
   217	// Supported formats: json, csv, summary.
   218	func ExecuteExport(config, input map[string]interface{}) (map[string]interface{}, error) {
   219		format, _ := config["format"].(string)
   220		if format == "" {
   221			format = "json"
   222		}
   223	
   224		switch format {
   225		case "json":
   226			return map[string]interface{}{
   227				"format": "json",
   228				"data":   input,
   229			}, nil
   230	
   231		case "summary":
   232			data, ok := input["data"].([]interface{})
   233			count := 0
   234			if ok {
   235				count = len(data)
   236			}
   237			return map[string]interface{}{
   238				"format": "summary",
   239				"count":  float64(count),
   240				"data":   input,
   241			}, nil
   242	
   243		case "csv":
   244			data, ok := input["data"].([]interface{})
   245			if !ok {
   246				return map[string]interface{}{"format": "csv", "content": ""}, nil
   247			}
   248			csv := ""
   249			for i, v := range data {
   250				if i > 0 {
   251					csv += ","
   252				}
   253				csv += fmt.Sprintf("%v", v)
   254			}
   255			return map[string]interface{}{
   256				"format":  "csv",
   257				"content": csv,
   258				"data":    data,
   259			}, nil
   260	
   261		default:
   262			return nil, fmt.Errorf("export: unknown format %q", format)
   263		}
   264	}
   265	
   266	// ExecuteFilter selects elements from the data array based on a comparison condition.
   267	// Supported modes: gt, lt, gte, lte, eq, ne.
   268	func ExecuteFilter(config, input map[string]interface{}) (map[string]interface{}, error) {
   269		data, ok := input["data"].([]interface{})
   270		if !ok {
   271			return nil, fmt.Errorf("filter: missing or invalid 'data' field in input")
   272		}
   273	
   274		mode, _ := config["mode"].(string)
   275		if mode == "" {
   276			return nil, fmt.Errorf("filter: missing 'mode' in config")
   277		}
   278		threshold, _ := config["threshold"].(float64)
   279	
   280		var result []interface{}
   281		for _, v := range data {
   282			val, err := toFloat(v)
   283			if err != nil {
   284				continue
   285			}
   286			var keep bool
   287			switch mode {
   288			case "gt":
   289				keep = val > threshold
   290			case "lt":
   291				keep = val < threshold
   292			case "gte":
   293				keep = val >= threshold
   294			case "lte":
   295				keep = val <= threshold
   296			case "eq":
   297				keep = val == threshold
   298			case "ne":
   299				keep = val != threshold
   300			default:
   301				return nil, fmt.Errorf("filter: unknown mode %q", mode)
   302			}
   303			if keep {
   304				result = append(result, val)
   305			}
   306		}
   307	
   308		if result == nil {
   309			result = []interface{}{}
   310		}
   311		return map[string]interface{}{"data": result}, nil
   312	}
   313	
   314	// Helper functions
   315	
   316	func toFloat(v interface{}) (float64, error) {
   317		switch val := v.(type) {
   318		case float64:
   319			return val, nil
   320		case int:
   321			return float64(val), nil
   322		case int64:
   323			return float64(val), nil
   324		default:
   325			return 0, fmt.Errorf("cannot convert %T to float64", v)
   326		}
   327	}
   328	
   329	func findMinMax(data []interface{}) (float64, float64) {
   330		if len(data) == 0 {
   331			return 0, 0
   332		}
   333		minVal, _ := toFloat(data[0])
   334		maxVal := minVal
   335		for _, v := range data[1:] {
   336			val, err := toFloat(v)
   337			if err != nil {
   338				continue
   339			}
   340			if val < minVal {
   341				minVal = val
   342			}
   343			if val > maxVal {
   344				maxVal = val
   345			}
   346		}
   347		return minVal, maxVal
   348	}
   349	
   350	func sortedCopy(values []float64) []float64 {
   351		s := make([]float64, len(values))
   352		copy(s, values)
   353		sort.Float64s(s)
   354		return s
   355	}
