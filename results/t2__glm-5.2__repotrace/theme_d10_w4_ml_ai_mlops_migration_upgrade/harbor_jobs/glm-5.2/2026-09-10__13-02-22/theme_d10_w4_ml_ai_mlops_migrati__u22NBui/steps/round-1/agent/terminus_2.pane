// Validate checks a pipeline definition for structural correctness without executing it.
func (e *Engine) Validate(p *Pipeline) *ValidationResult {
	result := &ValidationResult{
		Valid:          true,
		ExecutionOrder: []string{},
		Steps:          []ValidatedStep{},
		Errors:         []string{},
	}
	if p == nil {
		result.Valid = false
		result.Errors = append(result.Errors, "pipeline definition is required")
		return result
	}

	stepCount := len(p.Steps)
	result.StepCount = stepCount

	seen := make(map[string]bool)
	duplicateNames := make(map[string]bool)
	nameOrder := make([]string, 0, stepCount)

	for i, step := range p.Steps {
		if step == nil {
			result.Valid = false
			result.Errors = append(result.Errors, "step is null")
			continue
		}
		if step.Name == "" {
			result.Valid = false
			result.Errors = append(result.Errors, fmt.Sprintf("step at index %d has empty name", i))
			continue
		}
		result.Steps = append(result.Steps, ValidatedStep{
			Name:         step.Name,
			Type:         step.Type,
			Dependencies: step.Dependencies,
		})
		if seen[step.Name] {
			duplicateNames[step.Name] = true
		}
		if !seen[step.Name] {
			seen[step.Name] = true
			nameOrder = append(nameOrder, step.Name)
		}
	}
	if len(duplicateNames) > 0 {
		result.Valid = false
		for name := range duplicateNames {
			result.Errors = append(result.Errors, fmt.Sprintf("duplicate step name: %s", name))
		}
	}

	for _, step := range p.Steps {
		if step == nil {
			continue
		}
		if _, exists := e.stepExecutors[step.Type]; !exists {
			result.Valid = false
			result.Errors = append(result.Errors, fmt.Sprintf("unknown step type: %s", step.Type))
		}
		for _, dep := range step.Dependencies {
			if !seen[dep] {
				result.Valid = false
				result.Errors = append(result.Errors, fmt.Sprintf("step %s depends on unknown step: %s", step.Name, dep))
			}
		}
	}

	ordered, err := topologicalSort(p.Steps)
	if err != nil {
		result.Valid = false
		if strings.Contains(err.Error(), "cycle") {
			result.Errors = append(result.Errors, "dependency cycle detected")
		}
	}

	if result.Valid && err == nil {
		for _, step := range ordered {
			result.ExecutionOrder = append(result.ExecutionOrder, step.Name)
		}
	}

	if len(result.Errors) > 0 {
		result.Valid = false
		result.ExecutionOrder = []string{}
	}

	return result
}

