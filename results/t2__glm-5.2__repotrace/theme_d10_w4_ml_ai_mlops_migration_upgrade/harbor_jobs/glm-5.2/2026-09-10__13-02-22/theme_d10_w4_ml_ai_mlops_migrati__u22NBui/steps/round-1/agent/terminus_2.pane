   146				continue
   147			}
   148			value, ok := run.Metrics[metricName]
   149			if !ok {
   150				continue
   151			}
   152			if aggType == "weighted_mean" {
   153				weight, ok := run.Metrics[weightParam]
   154				if !ok {
   155					continue
   156				}
   157				values = append(values, value)
   158				weights = append(weights, weight)
   159				runIDs = append(runIDs, run.ID)
   160			} else {
   161				values = append(values, value)
   162				runIDs = append(runIDs, run.ID)
   163			}
   164		}
