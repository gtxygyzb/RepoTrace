    18	func (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {
    19		var req struct {
    20			Name        string   `json:"name"`
    21			Framework   string   `json:"framework"`
    22			Description string   `json:"description"`
    23			Tags        []string `json:"tags"`
    24		}
    25		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
    26			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
    27			return
    28		}
    29		if req.Name == "" {
    30			writeError(w, http.StatusBadRequest, "name is required")
    31			return
    32		}
    33	
    34		model, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)
    35		if err != nil {
    36			writeError(w, http.StatusConflict, "%v", err)
    37			return
    38		}
    39		writeJSON(w, http.StatusCreated, model)
    40	}
