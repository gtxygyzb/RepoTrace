from pathlib import Path
p = Path('internal/api/router.go')
s = p.read_text()
s = s.replace('''\tmux.HandleFunc("DELETE /api/v1/models/{name}", h.DeleteModel)''', '''\tmux.HandleFunc("DELETE /api/v1/models/{name}", h.DeleteModel)

\t// Model version annotations
\tmux.HandleFunc("POST /api/v1/models/{name}/versions/{num}/annotations", h.AddAnnotation)
\tmux.HandleFunc("GET /api/v1/models/{name}/versions/{num}/annotations", h.ListAnnotations)
\tmux.HandleFunc("DELETE /api/v1/models/{name}/versions/{num}/annotations/{key}", h.DeleteAnnotation)''')
s = s.replace('''\tmux.HandleFunc("POST /api/v1/pipelines/execute", h.ExecutePipeline)''', '''\tmux.HandleFunc("POST /api/v1/pipelines/validate", h.ValidatePipeline)
\tmux.HandleFunc("POST /api/v1/pipelines/execute", h.ExecutePipeline)''')
s = s.replace('''\tmux.HandleFunc("GET /api/v1/experiments/{name}/metrics/{metric}/aggregate", h.AggregateMetric)''', '''\tmux.HandleFunc("GET /api/v1/experiments/compare", h.CompareExperiments)
\tmux.HandleFunc("GET /api/v1/experiments/{name}/metrics/{metric}/aggregate", h.AggregateMetric)''')
s = s.replace('''\tmux.HandleFunc("POST /api/v1/serving/batch", h.BatchInfer)''', '''\tmux.HandleFunc("POST /api/v1/serving/batch", h.BatchInfer)
\tmux.HandleFunc("GET /api/v1/serving/stats", h.ServingStats)
\tmux.HandleFunc("POST /api/v1/serving/stats/reset", h.ResetServingStats)''')
p.write_text(s)
PY
gofmt -w internal/api/router.go
go build ./...
