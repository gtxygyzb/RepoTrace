   163	// --- Pipeline Handlers ---
   164	
   165	func (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {
   166		var req struct {
   167			Name     string                 `json:"name"`
   168			Steps    []*pipeline.Step       `json:"steps"`
   169			Input    map[string]interface{} `json:"input"`
   170			Pipeline *pipeline.Pipeline     `json:"pipeline"`
   171		}
   172		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   173			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   174			return
   175		}
   176		p := req.Pipeline
   177		if p == nil {
   178			p = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}
   179		}
   180		if p == nil || len(p.Steps) == 0 {
   181			writeError(w, http.StatusBadRequest, "pipeline with at least one step is required")
   182			return
   183		}
   184		if req.Input == nil {
   185			req.Input = make(map[string]interface{})
   186		}
   187	
   188		result, err := h.Pipeline.Execute(p, req.Input)
   189		if err != nil {
   190			writeError(w, http.StatusBadRequest, "%v", err)
   191			return
   192		}
   193		writeJSON(w, http.StatusOK, result)
   194	}
