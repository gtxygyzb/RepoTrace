func (h *Handlers) UpdateRun(w http.ResponseWriter, r *http.Request) {
\texpName := r.PathValue("name")
\trunID := r.PathValue("id")
\tvar req struct {
\t\tMetrics map[string]float64 `json:"metrics"`
\t}
\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {
\t\twriteError(w, http.StatusBadRequest, "invalid request body: %v", err)
\t\treturn
\t}
\trun, err := h.Experiment.UpdateRunMetrics(expName, runID, req.Metrics)
\tif err != nil {
\t\twriteError(w, http.StatusNotFound, "%v", err)
\t\treturn
\t}
\twriteJSON(w, http.StatusOK, run)
}

