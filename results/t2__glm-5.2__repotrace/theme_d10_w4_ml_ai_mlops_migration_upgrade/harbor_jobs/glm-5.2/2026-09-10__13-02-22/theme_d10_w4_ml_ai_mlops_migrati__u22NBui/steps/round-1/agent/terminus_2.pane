    45		mux.HandleFunc("POST /api/v1/pipelines/templates", h.CreateTemplate)
    46		mux.HandleFunc("GET /api/v1/pipelines/templates", h.ListTemplates)
    47		mux.HandleFunc("GET /api/v1/pipelines/templates/{name}", h.GetTemplate)
    48		mux.HandleFunc("PUT /api/v1/pipelines/templates/{name}", h.UpdateTemplate)
    49		mux.HandleFunc("DELETE /api/v1/pipelines/templates/{name}", h.DeleteTemplate)
    50		mux.HandleFunc("POST /api/v1/pipelines/templates/{name}/execute", h.ExecuteTemplate)
    51	
    52		// Experiment endpoints
    53		mux.HandleFunc("POST /api/v1/experiments", h.CreateExperiment)
    54		mux.HandleFunc("GET /api/v1/experiments", h.ListExperiments)
    55		mux.HandleFunc("GET /api/v1/experiments/{name}", h.GetExperiment)
