    14	// Stage represents the lifecycle stage of a model version.
    15	type Stage string
    16	
    17	const (
    18		StageDevelopment Stage = "development"
    19		StageStaging     Stage = "staging"
    20		StageProduction  Stage = "production"
    21		StageArchived    Stage = "archived"
    22	)
    23	
    24	var validTransitions = map[Stage][]Stage{
    25		StageDevelopment: {StageStaging, StageArchived},
    26		StageStaging:     {StageProduction, StageArchived},
    27		StageProduction:  {StageArchived},
    28		StageArchived:    {},
    29	}
    30	
    31	// Version represents a specific version of a model.
    32	type Version struct {
    33		Number      int                    `json:"number"`
    34		Stage       Stage                  `json:"stage"`
    35		Metrics     map[string]float64     `json:"metrics"`
    36		Tags        []string               `json:"tags"`
    37		ModelConfig map[string]interface{} `json:"model_config,omitempty"`
    38		CreatedAt   time.Time              `json:"created_at"`
    39	}
    40	
    41	// Model represents a registered ML model.
    42	type Model struct {
    43		Name        string     `json:"name"`
    44		Framework   string     `json:"framework"`
    45		Description string     `json:"description"`
    46		Tags        []string   `json:"tags"`
    47		Versions    []*Version `json:"versions"`
    48		CreatedAt   time.Time  `json:"created_at"`
    49		UpdatedAt   time.Time  `json:"updated_at"`
    50	}
    51	
    52	// ModelFilter defines filtering criteria for listing models.
    53	type ModelFilter struct {
    54		Framework string
    55		Tag       string
    56	}
    57	
    58	// Annotation represents a key-value annotation attached to a model version.
    59	type Annotation struct {
    60		Key       string    `json:"key"`
    61		Value     string    `json:"value"`
    62		CreatedAt time.Time `json:"created_at"`
    63	}
    64	
    65	var annotationKeyRegexp = regexp.MustCompile(`^[A-Za-z0-9_]+$`)
    66	
    67	// Registry manages model registration, versioning, and lifecycle.
    68	type Registry struct {
    69		mu          sync.RWMutex
    70		models      map[string]*Model
    71		dataDir     string
    72		annotations map[string]map[int]map[string]*Annotation
    73	}
    74	
    75	// NewRegistry creates a new Registry backed by the given data directory.
    76	func NewRegistry(dataDir string) (*Registry, error) {
    77		if err := os.MkdirAll(dataDir, 0755); err != nil {
    78			return nil, fmt.Errorf("create data dir: %w", err)
    79		}
    80		r := &Registry{
    81			models:      make(map[string]*Model),
    82			dataDir:     dataDir,
    83			annotations: make(map[string]map[int]map[string]*Annotation),
    84		}
    85		if err := r.loadAll(); err != nil {
    86			return nil, fmt.Errorf("load registry: %w", err)
    87		}
    88		return r, nil
    89	}
    90	
    91	// RegisterModel creates a new model entry in the registry.
    92	func (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {
    93		r.mu.Lock()
    94		defer r.mu.Unlock()
    95	
    96		if _, exists := r.models[name]; exists {
    97			return nil, fmt.Errorf("model %q already exists", name)
    98		}
    99	
   100		now := time.Now()
   101		model := &Model{
   102			Name:        name,
   103			Framework:   framework,
   104			Description: description,
   105			Tags:        tags,
   106			Versions:    make([]*Version, 0),
   107			CreatedAt:   now,
   108			UpdatedAt:   now,
   109		}
   110		r.models[name] = model
   111		if err := r.saveModel(model); err != nil {
   112			delete(r.models, name)
   113			return nil, err
   114		}
   115		return model, nil
   116	}
   117	
   118	// CreateVersion adds a new version to the specified model.
   119	func (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {
   120		r.mu.Lock()
   121		defer r.mu.Unlock()
   122	
   123		model, exists := r.models[modelName]
   124		if !exists {
   125			return nil, fmt.Errorf("model %q not found", modelName)
   126		}
   127	
   128		nextNum := 1
   129		for _, v := range model.Versions {
   130			if v.Number >= nextNum {
   131				nextNum = v.Number + 1
   132			}
   133		}
   134	
   135		version := &Version{
   136			Number:      nextNum,
   137			Stage:       StageDevelopment,
   138			Metrics:     metrics,
   139			Tags:        tags,
   140			ModelConfig: modelConfig,
   141			CreatedAt:   time.Now(),
   142		}
   143		model.Versions = append(model.Versions, version)
   144		model.UpdatedAt = time.Now()
   145	
   146		if err := r.saveModel(model); err != nil {
   147			model.Versions = model.Versions[:len(model.Versions)-1]
   148			return nil, err
   149		}
   150		return version, nil
