python3 - <<'PY'
from pathlib import Path
p = Path('internal/pipeline/engine.go')
s = p.read_text()
s = s.replace('''\t\t\tif seen[step.Name] {
\t\t\t\tduplicateNames[step.Name] = true
\t\t\t}
\t\t\tif !seen[step.Name] {
\t\t\t\tseen[step.Name] = true
\t\t\t\tnameOrder = append(nameOrder, step.Name)
\t\t\t}
''', '''\t\t\tif step.Name != "" && seen[step.Name] {
\t\t\t\tduplicateNames[step.Name] = true
\t\t\t}
\t\t\tif step.Name != "" && !seen[step.Name] {
\t\t\t\tseen[step.Name] = true
\t\t\t\tnameOrder = append(nameOrder, step.Name)
\t\t\t}
''')
p.write_text(s)
PY

