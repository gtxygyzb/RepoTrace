   246	
   247		if _, exists := r.models[name]; !exists {
   248			return fmt.Errorf("model %q not found", name)
   249		}
   250	
   251		delete(r.models, name)
   252		filename := filepath.Join(r.dataDir, name+".json")
   253		os.Remove(filename)
   254		return nil
   255	}
