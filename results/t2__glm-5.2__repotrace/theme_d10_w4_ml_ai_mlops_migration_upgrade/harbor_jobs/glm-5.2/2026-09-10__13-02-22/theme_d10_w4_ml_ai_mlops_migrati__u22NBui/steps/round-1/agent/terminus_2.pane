[?2004l[?2004h> 
[?2004l[?2004h> content = r'''package api
[?2004l[?2004h> 
[?2004l[?2004h> import (
[?2004l[?2004h> "net/http"
[?2004l[?2004h> 
[?2004l[?2004h> "gomlops/internal/experiment"
