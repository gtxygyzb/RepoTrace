    40	func (h *Handlers) ListModels(w http.ResponseWriter, r *http.Request) {
    41		var filter *registry.ModelFilter
    42		framework := r.URL.Query().Get("framework")
    43		tag := r.URL.Query().Get("tag")
    44		if framework != "" || tag != "" {
    45			filter = &registry.ModelFilter{Framework: framework, Tag: tag}
    46		}
    47	
    48		models, err := h.Registry.ListModels(filter)
    49		if err != nil {
    50			writeError(w, http.StatusInternalServerError, "%v", err)
    51			return
    52		}
    53		writeJSON(w, http.StatusOK, models)
    54	}
