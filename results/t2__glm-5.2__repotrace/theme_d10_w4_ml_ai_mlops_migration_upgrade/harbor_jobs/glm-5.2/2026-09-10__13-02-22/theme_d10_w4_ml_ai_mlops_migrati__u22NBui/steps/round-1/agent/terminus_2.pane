   215					if v > maxVal {
   216						maxVal = v
   217					}
   218				}
   219				result = maxVal - minVal
   220			}
   221		default:
   222			return nil, fmt.Errorf("aggregate: unknown operation %q", operation)
   223		}
   224	
   225		return map[string]interface{}{
   226			"result": result,
   227			"count":  float64(len(values)),
   228			"data":   data,
   229		}, nil
   230	}
