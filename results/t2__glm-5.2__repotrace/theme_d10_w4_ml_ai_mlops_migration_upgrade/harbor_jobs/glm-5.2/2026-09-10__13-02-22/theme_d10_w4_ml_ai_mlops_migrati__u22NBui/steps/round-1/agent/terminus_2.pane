// RecordExecution records a pipeline execution result and returns the stored record.
func (e *Engine) RecordExecution(pipelineName, status string, totalTimeMs float64, stepCount int) PipelineExecutionRecord {
\te.historyMu.Lock()
\tdefer e.historyMu.Unlock()

\tid := len(e.history) + 1
\trecord := PipelineExecutionRecord{
\t\tID:           id,
\t\tPipelineName: pipelineName,
\t\tStatus:       status,
\t\tTotalTimeMs:  totalTimeMs,
\t\tStepCount:    stepCount,
\t\tRecordedAt:  time.Now().UTC(),
\t}
\te.history = append(e.history, record)
\treturn record
}

// ListExecutionHistory returns the last n execution records, most recent first.
func (e *Engine) ListExecutionHistory(limit int) ([]PipelineExecutionRecord, int) {
\te.historyMu.Lock()
\tdefer e.historyMu.Unlock()

\ttotal := len(e.history)
\tif limit <= 0 {
\t\tlimit = 10
\t}
\tif limit > total {
\t\tlimit = total
\t}
\tstart := total - limit
\tresult := make([]PipelineExecutionRecord, limit)
\tcopy(result, e.history[start:])
\t// Reverse to most recent first
\tfor i, j := 0, len(result)-1; i < j; i, j = i+1, j-1 {
