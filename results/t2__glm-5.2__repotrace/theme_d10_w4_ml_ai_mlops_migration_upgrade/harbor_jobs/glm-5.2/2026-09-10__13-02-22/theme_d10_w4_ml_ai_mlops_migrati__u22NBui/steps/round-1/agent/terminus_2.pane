func (h *Handlers) LogRun(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")

	var req struct {
		Parameters map[string]float64 `json:"parameters"`
		Metrics    map[string]float64 `json:"metrics"`
		Tags       map[string]string  `json:"tags"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}

	run, err := h.Experiment.LogRun(expName, req.Parameters, req.Metrics, req.Tags)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusCreated, run)
}

func (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")
	metricName := r.PathValue("metric")
	aggType := r.URL.Query().Get("type")
	weightParam := r.URL.Query().Get("weight_param")

	if aggType == "" {
		writeError(w, http.StatusBadRequest, "query parameter 'type' is required")
		return
	}

	result, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam)
	if err != nil {
		writeError(w, http.StatusBadRequest, "%v", err)
		return
	}

	exp, _ := h.Experiment.GetExperiment(expName)
	runCount := 0
	if exp != nil {
		runCount = len(exp.Runs)
	}
	writeJSON(w, http.StatusOK, map[string]interface{}{
		"experiment": expName,
		"metric":     metricName,
		"type":       aggType,
		"value":      result,
		"count":      runCount,
	})
}

// --- Serving Handlers ---

func (h *Handlers) LoadModel(w http.ResponseWriter, r *http.Request) {
	var req struct {
		ModelName  string `json:"model_name"`
		VersionNum int    `json:"version_num"`
		Stage      string `json:"stage"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	if req.ModelName == "" {
		writeError(w, http.StatusBadRequest, "model_name is required")
		return
	}

	if err := h.Serving.LoadModel(req.ModelName, req.VersionNum, req.Stage); err != nil {
		writeError(w, http.StatusBadRequest, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]string{"status": "loaded"})
}

func (h *Handlers) UnloadModel(w http.ResponseWriter, r *http.Request) {
	name := r.PathValue("name")
	if err := h.Serving.UnloadModel(name); err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]string{"status": "unloaded"})
}

func (h *Handlers) ListLoadedModels(w http.ResponseWriter, r *http.Request) {
	models := h.Serving.ListLoaded()
	writeJSON(w, http.StatusOK, models)
}

func (h *Handlers) Infer(w http.ResponseWriter, r *http.Request) {
	var req serving.InferenceRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	if req.ModelName == "" {
		writeError(w, http.StatusBadRequest, "model_name is required")
		return
	}

	resp, err := h.Serving.Infer(&req)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, resp)
}

// --- Helpers ---

func writeJSON(w http.ResponseWriter, status int, data interface{}) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	json.NewEncoder(w).Encode(data)
}

func writeError(w http.ResponseWriter, status int, format string, args ...interface{}) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	msg := fmt.Sprintf(format, args...)
	json.NewEncoder(w).Encode(map[string]string{"error": msg})
}
