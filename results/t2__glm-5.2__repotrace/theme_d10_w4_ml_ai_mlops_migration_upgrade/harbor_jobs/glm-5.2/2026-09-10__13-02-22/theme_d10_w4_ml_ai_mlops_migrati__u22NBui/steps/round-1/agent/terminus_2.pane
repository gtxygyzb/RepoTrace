// --- Model Registry Handlers ---

func (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Name        string   `json:"name"`
		Framework   string   `json:"framework"`
		Description string   `json:"description"`
		Tags        []string `json:"tags"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	if req.Name == "" {
		writeError(w, http.StatusBadRequest, "name is required")
		return
	}

	model, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)
	if err != nil {
		writeError(w, http.StatusConflict, "%v", err)
		return
	}
	writeJSON(w, http.StatusCreated, model)
}

func (h *Handlers) ListModels(w http.ResponseWriter, r *http.Request) {
	var filter *registry.ModelFilter
	framework := r.URL.Query().Get("framework")
	tag := r.URL.Query().Get("tag")
	if framework != "" || tag != "" {
		filter = &registry.ModelFilter{Framework: framework, Tag: tag}
	}

	models, err := h.Registry.ListModels(filter)
	if err != nil {
		writeError(w, http.StatusInternalServerError, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, models)
}

func (h *Handlers) DeleteModel(w http.ResponseWriter, r *http.Request) {
	name := r.PathValue("name")
	if err := h.Registry.DeleteModel(name); err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	_ = h.Serving.UnloadModel(name)
	writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
}

func (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {
	name := r.PathValue("name")
	model, err := h.Registry.GetModel(name)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	stageSummary := map[string]int{
		"development": 0,
		"staging":     0,
		"production":  0,
		"archived":    0,
	}
	for _, v := range model.Versions {
		stageSummary[string(v.Stage)]++
	}
	writeJSON(w, http.StatusOK, map[string]interface{}{
		"name":          model.Name,
		"framework":     model.Framework,
		"description":   model.Description,
		"tags":          model.Tags,
		"versions":      model.Versions,
		"created_at":    model.CreatedAt,
		"updated_at":    model.UpdatedAt,
		"stage_summary": stageSummary,
	})
}

func (h *Handlers) CreateVersion(w http.ResponseWriter, r *http.Request) {
	modelName := r.PathValue("name")

	var req struct {
		Metrics     map[string]float64     `json:"metrics"`
		Tags        []string               `json:"tags"`
		ModelConfig map[string]interface{} `json:"model_config"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}

	version, err := h.Registry.CreateVersion(modelName, req.Metrics, req.Tags, req.ModelConfig)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusCreated, version)
}

func (h *Handlers) GetVersion(w http.ResponseWriter, r *http.Request) {
	modelName := r.PathValue("name")
	numStr := r.PathValue("num")
	num, err := strconv.Atoi(numStr)
	if err != nil {
		writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
		return
	}

	version, err := h.Registry.GetVersion(modelName, num)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, version)
}

func (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {
	modelName := r.PathValue("name")
	numStr := r.PathValue("num")
	num, err := strconv.Atoi(numStr)
	if err != nil {
		writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
		return
	}

	var req struct {
		Stage string `json:"stage"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	if req.Stage == "" {
		writeError(w, http.StatusBadRequest, "stage is required")
		return
	}

	if err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {
		writeError(w, http.StatusBadRequest, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]string{"status": "promoted"})
}

// --- Pipeline Handlers ---

func (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Name     string                 `json:"name"`
		Steps    []*pipeline.Step       `json:"steps"`
		Input    map[string]interface{} `json:"input"`
		Pipeline *pipeline.Pipeline     `json:"pipeline"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	p := req.Pipeline
	if p == nil {
		p = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}
	}
	if p == nil || len(p.Steps) == 0 {
		writeError(w, http.StatusBadRequest, "pipeline with at least one step is required")
		return
	}
	if req.Input == nil {
		req.Input = make(map[string]interface{})
	}

	result, err := h.Pipeline.Execute(p, req.Input)
	if err != nil {
		writeError(w, http.StatusBadRequest, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, result)
}

// --- Experiment Handlers ---

func (h *Handlers) CreateExperiment(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Name string `json:"name"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	if req.Name == "" {
		writeError(w, http.StatusBadRequest, "name is required")
		return
	}

	exp, err := h.Experiment.CreateExperiment(req.Name)
	if err != nil {
		writeError(w, http.StatusConflict, "%v", err)
		return
	}
	writeJSON(w, http.StatusCreated, exp)
}

func (h *Handlers) ListExperiments(w http.ResponseWriter, r *http.Request) {
	exps := h.Experiment.ListExperiments()
	writeJSON(w, http.StatusOK, exps)
}

func (h *Handlers) GetExperiment(w http.ResponseWriter, r *http.Request) {
	name := r.PathValue("name")
	exp, err := h.Experiment.GetExperiment(name)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, exp)
}

func (h *Handlers) LogRun(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")

	var req struct {
		Parameters map[string]float64 `json:"parameters"`
		Metrics    map[string]float64 `json:"metrics"`
		Tags       map[string]string  `json:"tags"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}

	run, err := h.Experiment.LogRun(expName, req.Parameters, req.Metrics, req.Tags)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusCreated, run)
}

