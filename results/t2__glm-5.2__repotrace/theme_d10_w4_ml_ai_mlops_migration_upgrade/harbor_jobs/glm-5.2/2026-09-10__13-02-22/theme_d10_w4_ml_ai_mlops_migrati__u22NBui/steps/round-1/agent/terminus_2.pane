   255	func (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {
   256		expName := r.PathValue("name")
   257		metricName := r.PathValue("metric")
   258		aggType := r.URL.Query().Get("type")
   259		weightParam := r.URL.Query().Get("weight_param")
   260		tagFilters := map[string]string{}
   261		for _, filter := range r.URL.Query()["tag_filter"] {
   262			parts := strings.SplitN(filter, ":", 2)
   263			if len(parts) != 2 {
   264				writeError(w, http.StatusBadRequest, "invalid tag_filter %q, expected key:value", filter)
   265				return
   266			}
   267			tagFilters[parts[0]] = parts[1]
   268		}
   269	
   270		if aggType == "" {
   271			writeError(w, http.StatusBadRequest, "query parameter 'type' is required")
   272			return
   273		}
   274	
   275		result, count, runIDs, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam, tagFilters)
   276		if err != nil {
   277			writeError(w, http.StatusBadRequest, "%v", err)
   278			return
   279		}
   280	
   281		writeJSON(w, http.StatusOK, map[string]interface{}{
   282			"experiment": expName,
   283			"metric":     metricName,
   284			"type":       aggType,
   285			"value":      result,
   286			"count":      count,
   287			"run_ids":    runIDs,
   288		})
   289	}
