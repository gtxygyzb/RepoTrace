// SearchRuns filters runs within an experiment by metric conditions.
func (t *Tracker) SearchRuns(experimentName string, filters []MetricFilter) ([]*Run, error) {
\tt.mu.RLock()
\tdefer t.mu.RUnlock()

\texp, exists := t.experiments[experimentName]
\tif !exists {
