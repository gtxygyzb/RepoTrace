   355	// --- Model Version Comparison Handler ---
   356	
   357	func (h *Handlers) CompareVersionMetrics(w http.ResponseWriter, r *http.Request) {
   358		modelName := r.PathValue("name")
   359		versionParam := r.URL.Query().Get("versions")
   360		if versionParam == "" {
   361			writeError(w, http.StatusBadRequest, "query parameter 'versions' is required")
   362			return
   363		}
   364	
   365		parts := strings.Split(versionParam, ",")
   366		seen := map[int]bool{}
   367		versionNums := make([]int, 0, len(parts))
   368		for _, p := range parts {
   369			num, err := strconv.Atoi(strings.TrimSpace(p))
   370			if err != nil {
   371				writeError(w, http.StatusBadRequest, "invalid version number: %q", p)
   372				return
   373			}
   374			if seen[num] {
   375				writeError(w, http.StatusBadRequest, "duplicate version number: %d", num)
   376				return
   377			}
   378			seen[num] = true
   379			versionNums = append(versionNums, num)
   380		}
   381		if len(versionNums) < 2 {
   382			writeError(w, http.StatusBadRequest, "at least 2 versions are required for comparison")
   383			return
   384		}
   385	
   386		model, err := h.Registry.GetModel(modelName)
   387		if err != nil {
   388			writeError(w, http.StatusNotFound, "%v", err)
   389			return
   390		}
   391	
   392		sort.Ints(versionNums)
   393		versionMap := map[int]*registry.Version{}
   394		for _, v := range model.Versions {
   395			versionMap[v.Number] = v
   396		}
   397	
   398		versions := make([]map[string]interface{}, 0, len(versionNums))
   399		for _, num := range versionNums {
   400			v, ok := versionMap[num]
   401			if !ok {
   402				writeError(w, http.StatusBadRequest, "version %d does not exist for model %q", num, modelName)
   403				return
   404			}
   405			versions = append(versions, map[string]interface{}{
   406				"number":  v.Number,
   407				"stage":   v.Stage,
   408				"metrics": v.Metrics,
   409			})
   410		}
   411	
   412		metricSummary := map[string]map[string]interface{}{}
   413		metricValues := map[string][]float64{}
   414		for _, v := range versions {
   415			metrics, _ := v["metrics"].(map[string]float64)
   416			for name, val := range metrics {
   417				metricValues[name] = append(metricValues[name], val)
   418			}
   419		}
   420	
   421		for name, vals := range metricValues {
   422			if len(vals) == 0 {
   423				continue
   424			}
   425			minVal := vals[0]
   426			maxVal := vals[0]
   427			sum := 0.0
   428			for _, val := range vals {
   429				if val < minVal {
   430					minVal = val
   431				}
   432				if val > maxVal {
   433					maxVal = val
   434				}
   435				sum += val
   436			}
   437			first := vals[0]
   438			last := vals[len(vals)-1]
   439			improvement := last - first
   440			trend := "stable"
[?2004hroot@n30009:/app# nl -ba internal/api/handlers.go | sed -n '441,760p'
[?2004l   441			if improvement > 0 {
   442				trend = "improving"
   443			} else if improvement < 0 {
   444				trend = "degrading"
   445			}
   446			metricSummary[name] = map[string]interface{}{
   447				"min":         minVal,
   448				"max":         maxVal,
   449				"first":       first,
   450				"last":        last,
   451				"improvement": improvement,
   452				"mean":        sum / float64(len(vals)),
   453				"trend":       trend,
   454			}
   455		}
   456	
   457		writeJSON(w, http.StatusOK, map[string]interface{}{
   458			"model":          modelName,
   459			"versions":       versions,
   460			"metric_summary": metricSummary,
   461		})
   462	}
   463	
   464	// --- Experiment Run Deletion Handler ---
   465	
   466	func (h *Handlers) DeleteRun(w http.ResponseWriter, r *http.Request) {
   467		expName := r.PathValue("name")
   468		runID := r.PathValue("id")
   469		if err := h.Experiment.DeleteRun(expName, runID); err != nil {
   470			writeError(w, http.StatusNotFound, "%v", err)
   471			return
   472		}
   473		writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
   474	}
