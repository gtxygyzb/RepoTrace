	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	if req.ModelName == "" {
[?2004hroot@n30009:/app# sed -n '1,260p' internal/registry/registry.go
[?2004lpackage registry

import (
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"regexp"
	"sort"
	"sync"
	"time"
)

// Stage represents the lifecycle stage of a model version.
type Stage string

const (
	StageDevelopment Stage = "development"
	StageStaging     Stage = "staging"
	StageProduction  Stage = "production"
	StageArchived    Stage = "archived"
)

var validTransitions = map[Stage][]Stage{
	StageDevelopment: {StageStaging, StageArchived},
	StageStaging:     {StageProduction, StageArchived},
	StageProduction:  {StageArchived},
	StageArchived:    {},
}

// Version represents a specific version of a model.
type Version struct {
	Number      int                    `json:"number"`
	Stage       Stage                  `json:"stage"`
	Metrics     map[string]float64     `json:"metrics"`
	Tags        []string               `json:"tags"`
	ModelConfig map[string]interface{} `json:"model_config,omitempty"`
	CreatedAt   time.Time              `json:"created_at"`
}

// Model represents a registered ML model.
type Model struct {
	Name        string     `json:"name"`
	Framework   string     `json:"framework"`
	Description string     `json:"description"`
	Tags        []string   `json:"tags"`
	Versions    []*Version `json:"versions"`
	CreatedAt   time.Time  `json:"created_at"`
	UpdatedAt   time.Time  `json:"updated_at"`
}

// ModelFilter defines filtering criteria for listing models.
type ModelFilter struct {
	Framework string
	Tag       string
}

// Annotation represents a key-value annotation attached to a model version.
type Annotation struct {
	Key       string    `json:"key"`
	Value     string    `json:"value"`
	CreatedAt time.Time `json:"created_at"`
}

var annotationKeyRegexp = regexp.MustCompile(`^[A-Za-z0-9_]+$`)

// Registry manages model registration, versioning, and lifecycle.
type Registry struct {
	mu          sync.RWMutex
	models      map[string]*Model
	dataDir     string
	annotations map[string]map[int]map[string]*Annotation
}

// NewRegistry creates a new Registry backed by the given data directory.
func NewRegistry(dataDir string) (*Registry, error) {
	if err := os.MkdirAll(dataDir, 0755); err != nil {
		return nil, fmt.Errorf("create data dir: %w", err)
	}
	r := &Registry{
		models:      make(map[string]*Model),
		dataDir:     dataDir,
		annotations: make(map[string]map[int]map[string]*Annotation),
	}
	if err := r.loadAll(); err != nil {
		return nil, fmt.Errorf("load registry: %w", err)
	}
	return r, nil
}

// RegisterModel creates a new model entry in the registry.
func (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {
	r.mu.Lock()
	defer r.mu.Unlock()

	if _, exists := r.models[name]; exists {
		return nil, fmt.Errorf("model %q already exists", name)
	}

	now := time.Now()
	model := &Model{
		Name:        name,
		Framework:   framework,
		Description: description,
		Tags:        tags,
		Versions:    make([]*Version, 0),
		CreatedAt:   now,
		UpdatedAt:   now,
	}
	r.models[name] = model
	if err := r.saveModel(model); err != nil {
		delete(r.models, name)
		return nil, err
	}
	return model, nil
}

// CreateVersion adds a new version to the specified model.
func (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {
	r.mu.Lock()
	defer r.mu.Unlock()

	model, exists := r.models[modelName]
	if !exists {
		return nil, fmt.Errorf("model %q not found", modelName)
	}

	nextNum := 1
	for _, v := range model.Versions {
		if v.Number >= nextNum {
			nextNum = v.Number + 1
		}
	}

	version := &Version{
		Number:      nextNum,
		Stage:       StageDevelopment,
		Metrics:     metrics,
		Tags:        tags,
		ModelConfig: modelConfig,
		CreatedAt:   time.Now(),
	}
	model.Versions = append(model.Versions, version)
	model.UpdatedAt = time.Now()

	if err := r.saveModel(model); err != nil {
		model.Versions = model.Versions[:len(model.Versions)-1]
		return nil, err
	}
	return version, nil
}

// PromoteVersion transitions a model version to the specified stage.
func (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	model, exists := r.models[modelName]
	if !exists {
		return fmt.Errorf("model %q not found", modelName)
	}

	var version *Version
	for _, v := range model.Versions {
		if v.Number == versionNum {
			version = v
			break
		}
	}
	if version == nil {
		return fmt.Errorf("version %d not found for model %q", versionNum, modelName)
	}

	// Validate stage transition
	allowed := validTransitions[version.Stage]
	valid := false
	for _, s := range allowed {
		if s == targetStage {
			valid = true
			break
		}
	}
	if !valid {
		return fmt.Errorf("invalid stage transition from %s to %s", version.Stage, targetStage)
	}

	// If promoting to production, demote current production version
	if targetStage == StageProduction {
		for _, v := range model.Versions {
			if v.Stage == StageProduction && v.Number != versionNum {
				v.Stage = StageStaging
			}
		}
	}

	version.Stage = targetStage
	model.UpdatedAt = time.Now()

	return r.saveModel(model)
}

// GetModel returns a model with its versions sorted by version number descending.
func (r *Registry) GetModel(name string) (*Model, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	model, exists := r.models[name]
	if !exists {
		return nil, fmt.Errorf("model %q not found", name)
	}

	// Return a copy with versions sorted
	result := *model
	result.Versions = make([]*Version, len(model.Versions))
	copy(result.Versions, model.Versions)
	sort.Slice(result.Versions, func(i, j int) bool {
		return result.Versions[i].Number > result.Versions[j].Number
	})
	return &result, nil
}

// ListModels returns all models matching the optional filter.
func (r *Registry) ListModels(filter *ModelFilter) ([]*Model, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	var result []*Model
	for _, model := range r.models {
		if filter != nil {
			if filter.Framework != "" && model.Framework != filter.Framework {
				continue
			}
			if filter.Tag != "" {
				hasTag := false
				for _, t := range model.Tags {
					if t == filter.Tag {
						hasTag = true
						break
					}
				}
				if !hasTag {
					continue
				}
			}
		}
		result = append(result, model)
	}
	sort.Slice(result, func(i, j int) bool {
		return result[i].Name < result[j].Name
	})
	return result, nil
}

// DeleteModel removes a model from the registry.
func (r *Registry) DeleteModel(name string) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	if _, exists := r.models[name]; !exists {
		return fmt.Errorf("model %q not found", name)
[?2004hroot@n30009:/app# sed -n '260,560p' internal/registry/registry.go
[?2004l		return fmt.Errorf("model %q not found", name)
	}

	delete(r.models, name)
	filename := filepath.Join(r.dataDir, name+".json")
	os.Remove(filename)
	return nil
}

// GetVersion returns a specific version of a model.
func (r *Registry) GetVersion(modelName string, versionNum int) (*Version, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	model, exists := r.models[modelName]
	if !exists {
		return nil, fmt.Errorf("model %q not found", modelName)
	}

	for _, v := range model.Versions {
		if v.Number == versionNum {
			return v, nil
		}
	}
	return nil, fmt.Errorf("version %d not found for model %q", versionNum, modelName)
}

// GetVersionByStage returns the version of a model currently in the specified stage.
func (r *Registry) GetVersionByStage(modelName string, stage Stage) (*Version, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	model, exists := r.models[modelName]
	if !exists {
		return nil, fmt.Errorf("model %q not found", modelName)
	}

	for _, v := range model.Versions {
		if v.Stage == stage {
			return v, nil
		}
	}
	return nil, fmt.Errorf("no version in stage %s for model %q", stage, modelName)
}

// ValidateAnnotationKey returns true if key is non-empty and contains only
// letters, digits, and underscores.
func ValidateAnnotationKey(key string) bool {
	return validateAnnotationKey(key)
}

// findVersionLocked returns the version pointer for the given model and version number.
// The caller must hold an appropriate lock.
func (r *Registry) findVersionLocked(modelName string, versionNum int) (*Model, *Version, error) {
	model, exists := r.models[modelName]
	if !exists {
		return nil, nil, fmt.Errorf("model %q not found", modelName)
	}

	for _, v := range model.Versions {
		if v.Number == versionNum {
			return model, v, nil
		}
	}
	return nil, nil, fmt.Errorf("version %d not found for model %q", versionNum, modelName)
}

// validateAnnotationKey returns true if key is non-empty and contains only
// letters, digits, and underscores.
func validateAnnotationKey(key string) bool {
	return annotationKeyRegexp.MatchString(key)
}

// AddAnnotation attaches a new key-value annotation to a model version.
func (r *Registry) AddAnnotation(modelName string, versionNum int, key, value string) (*Annotation, error) {
	r.mu.Lock()
	defer r.mu.Unlock()

	if _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {
		return nil, err
	}
	if !validateAnnotationKey(key) {
		return nil, fmt.Errorf("invalid annotation key")
	}

	if r.annotations[modelName] == nil {
		r.annotations[modelName] = make(map[int]map[string]*Annotation)
	}
	if r.annotations[modelName][versionNum] == nil {
		r.annotations[modelName][versionNum] = make(map[string]*Annotation)
	}
	if _, exists := r.annotations[modelName][versionNum][key]; exists {
		return nil, fmt.Errorf("annotation %q already exists", key)
	}

	annotation := &Annotation{
		Key:       key,
		Value:     value,
		CreatedAt: time.Now(),
	}
	r.annotations[modelName][versionNum][key] = annotation
	return annotation, nil
}

// ListAnnotations returns all annotations for a model version sorted by key.
func (r *Registry) ListAnnotations(modelName string, versionNum int) ([]*Annotation, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	if _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {
		return nil, err
	}

	var annotations []*Annotation
	if versions, ok := r.annotations[modelName]; ok {
		if keys, ok := versions[versionNum]; ok {
			for _, a := range keys {
				annotations = append(annotations, a)
			}
		}
	}
	sort.Slice(annotations, func(i, j int) bool {
		return annotations[i].Key < annotations[j].Key
	})
	if annotations == nil {
		annotations = []*Annotation{}
	}
	return annotations, nil
}

// DeleteAnnotation removes a specific annotation from a model version.
func (r *Registry) DeleteAnnotation(modelName string, versionNum int, key string) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	if _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {
		return err
	}

	if r.annotations[modelName] == nil || r.annotations[modelName][versionNum] == nil {
		return fmt.Errorf("annotation %q not found", key)
	}
	if _, exists := r.annotations[modelName][versionNum][key]; !exists {
		return fmt.Errorf("annotation %q not found", key)
	}
	delete(r.annotations[modelName][versionNum], key)
	return nil
}

// AnnotationsMap returns a map of annotation key to value for a model version.
func (r *Registry) AnnotationsMap(modelName string, versionNum int) map[string]string {
	r.mu.RLock()
	defer r.mu.RUnlock()

	result := make(map[string]string)
	if versions, ok := r.annotations[modelName]; ok {
		if keys, ok := versions[versionNum]; ok {
			for k, a := range keys {
				result[k] = a.Value
			}
		}
	}
	return result
}

// loadAll reads all model files from the data directory.
func (r *Registry) loadAll() error {
	entries, err := os.ReadDir(r.dataDir)
	if err != nil {
		if os.IsNotExist(err) {
			return nil
		}
		return err
	}
	for _, entry := range entries {
		if !entry.IsDir() && filepath.Ext(entry.Name()) == ".json" {
			data, err := os.ReadFile(filepath.Join(r.dataDir, entry.Name()))
			if err != nil {
				return err
			}
			var model Model
			if err := json.Unmarshal(data, &model); err != nil {
				return err
			}
			r.models[model.Name] = &model
		}
	}
	return nil
}

// saveModel writes a model's data to its JSON file.
func (r *Registry) saveModel(model *Model) error {
	data, err := json.MarshalIndent(model, "", "  ")
	if err != nil {
		return err
	}
	filename := filepath.Join(r.dataDir, model.Name+".json")
	return os.WriteFile(filename, data, 0644)
}
