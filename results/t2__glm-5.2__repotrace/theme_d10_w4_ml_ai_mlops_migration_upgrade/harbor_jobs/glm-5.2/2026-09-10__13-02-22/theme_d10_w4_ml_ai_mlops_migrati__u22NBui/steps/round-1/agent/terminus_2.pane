    38	// NewTracker creates a new experiment tracker backed by the given data directory.
    39	func NewTracker(dataDir string) *Tracker {
    40		os.MkdirAll(dataDir, 0755)
    41		t := &Tracker{
    42			experiments: make(map[string]*Experiment),
    43			dataDir:     dataDir,
    44		}
    45		t.loadAll()
    46		return t
    47	}
    48	
    49	// CreateExperiment creates a new experiment with the given name.
    50	func (t *Tracker) CreateExperiment(name string) (*Experiment, error) {
    51		t.mu.Lock()
    52		defer t.mu.Unlock()
    53	
    54		if _, exists := t.experiments[name]; exists {
    55			return nil, fmt.Errorf("experiment %q already exists", name)
    56		}
    57	
    58		exp := &Experiment{
    59			Name:      name,
    60			Runs:      make([]*Run, 0),
    61			CreatedAt: time.Now(),
    62		}
    63		t.experiments[name] = exp
    64		if err := t.saveExperiment(exp); err != nil {
    65			delete(t.experiments, name)
    66			return nil, err
    67		}
    68		return exp, nil
    69	}
    70	
    71	// LogRun adds a new run to the specified experiment.
    72	func (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {
    73		t.mu.Lock()
    74		defer t.mu.Unlock()
    75	
    76		exp, exists := t.experiments[experimentName]
    77		if !exists {
    78			return nil, fmt.Errorf("experiment %q not found", experimentName)
    79		}
    80	
    81		t.runCounter++
    82		run := &Run{
    83			ID:         fmt.Sprintf("run_%d", t.runCounter),
    84			Parameters: params,
    85			Metrics:    metrics,
    86			Tags:       tags,
    87			CreatedAt:  time.Now(),
    88		}
    89		exp.Runs = append(exp.Runs, run)
    90	
    91		if err := t.saveExperiment(exp); err != nil {
    92			exp.Runs = exp.Runs[:len(exp.Runs)-1]
    93			return nil, err
    94		}
    95		return run, nil
    96	}
    97	
    98	// GetExperiment returns the experiment with the given name.
    99	func (t *Tracker) GetExperiment(name string) (*Experiment, error) {
   100		t.mu.RLock()
   101		defer t.mu.RUnlock()
   102	
   103		exp, exists := t.experiments[name]
   104		if !exists {
   105			return nil, fmt.Errorf("experiment %q not found", name)
   106		}
   107		return exp, nil
   108	}
   109	
   110	// ListExperiments returns all experiments.
   111	func (t *Tracker) ListExperiments() []*Experiment {
   112		t.mu.RLock()
   113		defer t.mu.RUnlock()
   114	
   115		result := make([]*Experiment, 0, len(t.experiments))
   116		for _, exp := range t.experiments {
   117			result = append(result, exp)
   118		}
   119		sort.Slice(result, func(i, j int) bool {
   120			return result[i].Name < result[j].Name
   121		})
   122		return result
   123	}
   124	
   125	// AggregateMetric computes an aggregate statistic for a given metric across all runs
   126	// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.
   127	// For weighted_mean, weightParam specifies which parameter to use as weight.
   128	func (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, int, error) {
   129		t.mu.RLock()
   130		defer t.mu.RUnlock()
   131	
   132		exp, exists := t.experiments[experimentName]
   133		if !exists {
   134			return 0, 0, fmt.Errorf("experiment %q not found", experimentName)
   135		}
   136	
   137		if len(exp.Runs) == 0 {
   138			return 0, 0, fmt.Errorf("experiment %q has no runs", experimentName)
   139		}
   140	
   141		var values []float64
   142		var weights []float64
   143		for _, run := range exp.Runs {
   144			value, ok := run.Metrics[metricName]
   145			if !ok {
   146				continue
   147			}
   148			values = append(values, value)
   149			if aggType == "weighted_mean" {
   150				weight, ok := run.Parameters[weightParam]
   151				if !ok {
   152					continue
   153				}
   154				weights = append(weights, weight)
   155			}
   156		}
   157	
   158		if len(values) == 0 {
   159			return 0, 0, fmt.Errorf("no values found for metric %q", metricName)
   160		}
   161	
   162		switch aggType {
   163		case "mean":
   164			sum := 0.0
   165			for _, v := range values {
   166				sum += v
   167			}
   168			return sum / float64(len(values)), len(values), nil
   169	
   170		case "median":
   171			sorted := sortedCopy(values)
   172			n := len(sorted)
   173			if n%2 == 0 {
   174				return (sorted[n/2-1] + sorted[n/2]) / 2, len(values), nil
   175			}
   176			return sorted[n/2], len(values), nil
   177	
   178		case "p95":
   179			sorted := sortedCopy(values)
   180			return percentile(sorted, 0.95), len(values), nil
   181	
   182		case "p99":
   183			sorted := sortedCopy(values)
   184			return percentile(sorted, 0.99), len(values), nil
   185	
   186		case "weighted_mean":
   187			if weightParam == "" {
   188				return 0, 0, fmt.Errorf("weighted_mean requires weight parameter")
   189			}
   190			if len(weights) == 0 {
   191				return 0, 0, fmt.Errorf("no runs with metric %q and weight parameter %q", metricName, weightParam)
   192			}
   193			if len(weights) != len(values) {
   194				return 0, 0, fmt.Errorf("mismatch between metric values and weights")
   195			}
   196			weightedSum := 0.0
   197			weightSum := 0.0
   198			for i, v := range values {
   199				weightedSum += v * weights[i]
   200				weightSum += weights[i]
   201			}
   202			if weightSum == 0 {
   203				return 0, 0, fmt.Errorf("weighted_mean has zero total weight")
   204			}
   205			return weightedSum / weightSum, len(values), nil
   206	
   207		default:
   208			return 0, 0, fmt.Errorf("unknown aggregation type %q", aggType)
   209		}
   210	}
   211	
   212	func percentile(sorted []float64, p float64) float64 {
   213		n := len(sorted)
   214		if n == 0 {
   215			return 0
   216		}
   217		if n == 1 {
   218			return sorted[0]
   219		}
   220		rank := p * float64(n-1)
   221		lower := int(math.Floor(rank))
   222		upper := int(math.Ceil(rank))
   223		if lower == upper {
   224			return sorted[lower]
   225		}
   226		frac := rank - float64(lower)
   227		return sorted[lower]*(1-frac) + sorted[upper]*frac
   228	}
   229	
   230	func sortedCopy(values []float64) []float64 {
   231		s := make([]float64, len(values))
   232		copy(s, values)
   233		sort.Float64s(s)
   234		return s
   235	}
