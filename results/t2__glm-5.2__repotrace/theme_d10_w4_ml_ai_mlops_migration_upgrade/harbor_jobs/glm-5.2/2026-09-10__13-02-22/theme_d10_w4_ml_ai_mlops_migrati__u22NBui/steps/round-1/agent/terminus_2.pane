   250	func percentile(sorted []float64, p float64) float64 {
   251		n := len(sorted)
   252		if n == 0 {
   253			return 0
   254		}
   255		if n == 1 {
   256			return sorted[0]
   257		}
   258		rank := p * float64(n-1)
   259		lower := int(math.Floor(rank))
   260		upper := int(math.Ceil(rank))
   261		if lower == upper {
   262			return sorted[lower]
   263		}
   264		frac := rank - float64(lower)
   265		return sorted[lower]*(1-frac) + sorted[upper]*frac
   266	}
   267	
   268	func sortedCopy(values []float64) []float64 {
   269		s := make([]float64, len(values))
   270		copy(s, values)
   271		sort.Float64s(s)
   272		return s
   273	}
   274	
   275	func (t *Tracker) loadAll() {
   276		entries, err := os.ReadDir(t.dataDir)
   277		if err != nil {
   278			return
   279		}
   280		for _, entry := range entries {
   281			if !entry.IsDir() && filepath.Ext(entry.Name()) == ".json" {
   282				data, err := os.ReadFile(filepath.Join(t.dataDir, entry.Name()))
   283				if err != nil {
   284					continue
   285				}
   286				var exp Experiment
   287				if err := json.Unmarshal(data, &exp); err != nil {
   288					continue
   289				}
   290				t.experiments[exp.Name] = &exp
   291				for _, r := range exp.Runs {
   292					_ = r
   293					t.runCounter++
   294				}
   295			}
   296		}
   297	}
   298	
   299	func (t *Tracker) saveExperiment(exp *Experiment) error {
   300		data, err := json.MarshalIndent(exp, "", "  ")
   301		if err != nil {
   302			return err
   303		}
   304		filename := filepath.Join(t.dataDir, exp.Name+".json")
   305		return os.WriteFile(filename, data, 0644)
   306	}
