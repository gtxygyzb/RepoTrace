   260	
   261	// topologicalSort orders steps so that dependencies are executed first.
   262	// Returns an error if a cycle is detected.
   263	func topologicalSort(steps []*Step) ([]*Step, error) {
   264		stepMap := make(map[string]*Step)
   265		inDegree := make(map[string]int)
   266	
   267		for _, s := range steps {
   268			stepMap[s.Name] = s
   269			inDegree[s.Name] = 0
   270		}
   271	
   272		// Build in-degree counts
   273		for _, s := range steps {
   274			for _, dep := range s.Dependencies {
   275				if _, ok := stepMap[dep]; !ok {
   276					return nil, fmt.Errorf("step %q depends on unknown step %q", s.Name, dep)
   277				}
   278				inDegree[s.Name]++
   279			}
   280		}
   281	
   282		// Initialize queue with steps that have no dependencies
   283		queue := make([]*Step, 0)
   284		for _, s := range steps {
   285			if inDegree[s.Name] == 0 {
   286				queue = append(queue, s)
   287			}
   288		}
   289	
   290		// Process steps in topological order
   291		ordered := make([]*Step, 0, len(steps))
   292		for len(queue) > 0 {
   293			current := queue[0]
   294			queue = queue[1:]
   295			ordered = append(ordered, current)
   296	
   297			// Find steps that depend on current
   298			for _, s := range steps {
   299				for _, dep := range s.Dependencies {
   300					if dep == current.Name {
   301						inDegree[s.Name]--
   302						if inDegree[s.Name] == 0 {
