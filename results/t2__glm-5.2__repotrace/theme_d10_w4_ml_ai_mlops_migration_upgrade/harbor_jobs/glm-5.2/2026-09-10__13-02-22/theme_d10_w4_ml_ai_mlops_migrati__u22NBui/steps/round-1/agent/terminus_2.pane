    41	
    42	// Stats tracks accumulated serving statistics.
    43	type Stats struct {
    44		TotalRequests int
    45		Successful    int
    46		Failed        int
    47		LatencySum    float64
    48		Models        map[string]*ModelStats
    49	}
    50	
    51	// StatsResponse is the public serving statistics representation.
    52	type StatsResponse struct {
    53		TotalRequests int                           `json:"total_requests"`
    54		Successful    int                           `json:"successful"`
    55		Failed        int                           `json:"failed"`
    56		AvgLatencyMs  float64                       `json:"avg_latency_ms"`
    57		Models        map[string]ModelStatsResponse `json:"models"`
    58	}
    59	
    60	// ModelStatsResponse is the public model statistics representation.
    61	type ModelStatsResponse struct {
    62		Requests     int     `json:"requests"`
    63		Successful   int     `json:"successful"`
    64		Failed       int     `json:"failed"`
    65		AvgLatencyMs float64 `json:"avg_latency_ms"`
    66		SuccessRate  float64 `json:"success_rate"`
    67	}
