   141	// PromoteVersion transitions a model version to the specified stage.
   142	func (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {
   143		r.mu.Lock()
   144		defer r.mu.Unlock()
   145	
   146		model, exists := r.models[modelName]
   147		if !exists {
   148			return fmt.Errorf("model %q not found", modelName)
   149		}
   150	
   151		var version *Version
   152		for _, v := range model.Versions {
   153			if v.Number == versionNum {
   154				version = v
   155				break
   156			}
   157		}
   158		if version == nil {
   159			return fmt.Errorf("version %d not found for model %q", versionNum, modelName)
   160		}
   161	
   162		// Validate stage transition
   163		allowed := validTransitions[version.Stage]
   164		valid := false
   165		for _, s := range allowed {
   166			if s == targetStage {
   167				valid = true
   168				break
   169			}
   170		}
   171		if !valid {
   172			return fmt.Errorf("invalid stage transition from %s to %s", version.Stage, targetStage)
   173		}
   174	
   175		// If promoting to production, demote current production version
   176		if targetStage == StageProduction {
   177			for _, v := range model.Versions {
   178				if v.Stage == StageProduction && v.Number != versionNum {
   179					v.Stage = StageArchived
   180				}
   181			}
   182		}
   183	
   184		version.Stage = targetStage
   185		model.UpdatedAt = time.Now()
   186	
   187		return r.saveModel(model)
   188	}
