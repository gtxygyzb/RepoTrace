   223	// MetricHistory returns chronological values of a metric across all runs in an experiment.
   224	func (t *Tracker) MetricHistory(experimentName, metricName string) ([]MetricHistoryEntry, error) {
   225		t.mu.RLock()
   226		defer t.mu.RUnlock()
   227	
   228		exp, exists := t.experiments[experimentName]
   229		if !exists {
   230			return nil, fmt.Errorf("experiment %q not found", experimentName)
   231		}
   232	
   233		var history []MetricHistoryEntry
   234		for _, run := range exp.Runs {
   235			value, ok := run.Metrics[metricName]
   236			if !ok {
   237				continue
   238			}
   239			history = append(history, MetricHistoryEntry{RunID: run.ID, Value: value})
   240		}
   241		if len(history) == 0 {
   242			return nil, fmt.Errorf("no values found for metric %q", metricName)
   243		}
   244		return history, nil
   245	}
