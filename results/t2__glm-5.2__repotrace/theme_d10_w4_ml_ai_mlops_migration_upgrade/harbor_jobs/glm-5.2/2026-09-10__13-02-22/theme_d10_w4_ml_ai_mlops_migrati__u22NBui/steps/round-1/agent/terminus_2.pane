    64	// NewRegistry creates a new Registry backed by the given data directory.
    65	func NewRegistry(dataDir string) (*Registry, error) {
    66		if err := os.MkdirAll(dataDir, 0755); err != nil {
    67			return nil, fmt.Errorf("create data dir: %w", err)
    68		}
    69		r := &Registry{
    70			models:  make(map[string]*Model),
