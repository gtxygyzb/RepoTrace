    32	
    33		// Model registry endpoints
    34		mux.HandleFunc("POST /api/v1/models", h.RegisterModel)
    35		mux.HandleFunc("GET /api/v1/models", h.ListModels)
    36		mux.HandleFunc("GET /api/v1/models/{name}", h.GetModel)
    37		mux.HandleFunc("POST /api/v1/models/{name}/versions", h.CreateVersion)
    38		mux.HandleFunc("GET /api/v1/models/{name}/versions", h.ListModelVersions)
    39		mux.HandleFunc("GET /api/v1/models/{name}/versions/compare", h.CompareVersionMetrics)
    40		mux.HandleFunc("GET /api/v1/models/{name}/versions/{num}", h.GetVersion)
    41		mux.HandleFunc("PUT /api/v1/models/{name}/versions/{num}/promote", h.PromoteVersion)
    42		mux.HandleFunc("GET /api/v1/models/{name}/lineage", h.ModelLineage)
    43		mux.HandleFunc("POST /api/v1/models/{name}/dependencies", h.DeclareDependencies)
    44		mux.HandleFunc("GET /api/v1/models/{name}/dependencies", h.GetDependencies)
    45		mux.HandleFunc("DELETE /api/v1/models/{name}/dependencies/{dep}", h.RemoveDependency)
    46		mux.HandleFunc("DELETE /api/v1/models/{name}", h.DeleteModel)
    47	
    48		// Model version annotations
    49		mux.HandleFunc("POST /api/v1/models/{name}/versions/{num}/annotations", h.AddAnnotation)
    50		mux.HandleFunc("GET /api/v1/models/{name}/versions/{num}/annotations", h.ListAnnotations)
    51		mux.HandleFunc("DELETE /api/v1/models/{name}/versions/{num}/annotations/{key}", h.DeleteAnnotation)
    52	
    53		// Pipeline endpoints
    54		mux.HandleFunc("POST /api/v1/pipelines/validate", h.ValidatePipeline)
    55		mux.HandleFunc("POST /api/v1/pipelines/execute", h.ExecutePipeline)
