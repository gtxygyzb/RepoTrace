import json, urllib.request, urllib.error

BASE = "http://localhost:8080/api/v1"

def req(method, path, body=None):
    url = BASE + path
    data = json.dumps(body).encode() if body is not None else None
    r = urllib.request.Request(url, data=data, method=method, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(r, timeout=5) as resp:
            return resp.status, resp.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode()

print("flat pipeline merge:")
print(req("POST", "/pipelines/execute", {
  "name": "mergepipe",
  "input": {"data": [1,2,3]},
  "steps": [
    {"name": "a", "type": "transform", "config": {"mode": "scale", "factor": 2}, "dependencies": []},
    {"name": "b", "type": "transform", "config": {"mode": "offset", "offset": 100}, "dependencies": []},
    {"name": "c", "type": "aggregate", "config": {"operation": "sum"}, "dependencies": ["a","b"]}
  ]
}))
print("normalize:")
print(req("POST", "/pipelines/execute", {
  "name": "normpipe",
  "input": {"data": [0,10,20]},
  "steps": [
    {"name": "n", "type": "transform", "config": {"mode": "normalize"}, "dependencies": []}
  ]
}))
print("cycle:")
print(req("POST", "/pipelines/execute", {
  "name": "cyclepipe",
  "input": {"data": [1]},
  "steps": [
    {"name": "a", "type": "identity", "config": {}, "dependencies": ["b"]},
    {"name": "b", "type": "identity", "config": {}, "dependencies": ["a"]}
  ]
}))
PY
