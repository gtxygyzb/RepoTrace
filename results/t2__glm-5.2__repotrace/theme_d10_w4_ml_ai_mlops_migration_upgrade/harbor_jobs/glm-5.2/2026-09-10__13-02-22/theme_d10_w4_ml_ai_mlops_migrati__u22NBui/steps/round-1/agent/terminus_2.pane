   538	func (h *Handlers) AddAnnotation(w http.ResponseWriter, r *http.Request) {
   539		modelName := r.PathValue("name")
   540		numStr := r.PathValue("num")
   541		num, err := strconv.Atoi(numStr)
   542		if err != nil {
   543			writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
   544			return
   545		}
   546	
   547		var req struct {
   548			Key   string `json:"key"`
   549			Value string `json:"value"`
   550		}
   551		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   552			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   553			return
   554		}
   555		if !registry.ValidateAnnotationKey(req.Key) {
   556			writeError(w, http.StatusBadRequest, "annotation key must contain only letters, digits, and underscores")
   557			return
   558		}
   559	
   560		annotation, err := h.Registry.AddAnnotation(modelName, num, req.Key, req.Value)
   561		if err != nil {
   562			if strings.Contains(err.Error(), "not found") {
   563				writeError(w, http.StatusNotFound, "%v", err)
   564			} else if strings.Contains(err.Error(), "already exists") {
   565				writeError(w, http.StatusConflict, "%v", err)
   566			} else {
   567				writeError(w, http.StatusBadRequest, "%v", err)
   568			}
   569			return
   570		}
   571		writeJSON(w, http.StatusCreated, annotation)
   572	}
