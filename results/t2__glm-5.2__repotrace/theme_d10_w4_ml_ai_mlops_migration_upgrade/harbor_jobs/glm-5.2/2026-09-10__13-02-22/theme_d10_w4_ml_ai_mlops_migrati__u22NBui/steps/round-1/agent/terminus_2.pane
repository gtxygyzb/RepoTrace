[?2004l   486	func topologicalSort(steps []*Step) ([]*Step, error) {
   487		stepMap := make(map[string]*Step)
   488		inDegree := make(map[string]int)
   489	
   490		for _, s := range steps {
   491			stepMap[s.Name] = s
   492			inDegree[s.Name] = 0
   493		}
   494	
   495		// Build in-degree counts
   496		for _, s := range steps {
   497			for _, dep := range s.Dependencies {
   498				if _, ok := stepMap[dep]; !ok {
   499					return nil, fmt.Errorf("step %q depends on unknown step %q", s.Name, dep)
   500				}
   501				inDegree[s.Name]++
   502			}
   503		}
   504	
   505		// Initialize queue with steps that have no dependencies
   506		queue := make([]*Step, 0)
   507		for _, s := range steps {
   508			if inDegree[s.Name] == 0 {
   509				queue = append(queue, s)
   510			}
   511		}
   512	
   513		// Process steps in topological order
   514		ordered := make([]*Step, 0, len(steps))
   515		for len(queue) > 0 {
   516			current := queue[0]
   517			queue = queue[1:]
   518			ordered = append(ordered, current)
   519	
   520			// Find steps that depend on current
   521			for _, s := range steps {
   522				for _, dep := range s.Dependencies {
   523					if dep == current.Name {
   524						inDegree[s.Name]--
   525						if inDegree[s.Name] == 0 {
   526							queue = append(queue, s)
   527						}
   528					}
   529				}
   530			}
   531		}
   532	
   533		if len(ordered) != len(steps) {
   534			return nil, fmt.Errorf("cycle detected in pipeline dependencies")
   535		}
   536	
   537		return ordered, nil
   538	}
