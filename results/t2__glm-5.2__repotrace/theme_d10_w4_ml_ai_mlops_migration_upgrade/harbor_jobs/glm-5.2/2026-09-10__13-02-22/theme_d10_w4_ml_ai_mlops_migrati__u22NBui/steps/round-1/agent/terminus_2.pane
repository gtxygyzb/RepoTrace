   190	// topologicalSort orders steps so that dependencies are executed first.
   191	// Returns an error if a cycle is detected.
   192	func topologicalSort(steps []*Step) ([]*Step, error) {
   193		stepMap := make(map[string]*Step)
   194		inDegree := make(map[string]int)
   195	
   196		for _, s := range steps {
   197			stepMap[s.Name] = s
   198			inDegree[s.Name] = 0
   199		}
   200	
   201		// Build in-degree counts
   202		for _, s := range steps {
   203			for _, dep := range s.Dependencies {
   204				if _, ok := stepMap[dep]; !ok {
   205					return nil, fmt.Errorf("step %q depends on unknown step %q", s.Name, dep)
   206				}
   207				inDegree[s.Name]++
   208			}
   209		}
   210	
   211		// Initialize queue with steps that have no dependencies
   212		queue := make([]*Step, 0)
   213		for _, s := range steps {
   214			if inDegree[s.Name] == 0 {
   215				queue = append(queue, s)
   216			}
   217		}
   218	
   219		// Process steps in topological order
   220		ordered := make([]*Step, 0, len(steps))
