    10	// ExecuteTransform applies a data transformation.
    11	// Supported modes: scale, offset, normalize, identity, clip, log.
    12	func ExecuteTransform(config, input map[string]interface{}) (map[string]interface{}, error) {
    13		data, ok := input["data"].([]interface{})
    14		if !ok {
    15			return nil, fmt.Errorf("transform: missing or invalid 'data' field in input")
    16		}
    17	
    18		mode, _ := config["mode"].(string)
    19		if mode == "" {
    20			return nil, fmt.Errorf("transform: missing 'mode' in config")
    21		}
    22	
    23		result := make([]interface{}, len(data))
    24	
    25		switch mode {
    26		case "scale":
    27			factor, _ := config["factor"].(float64)
    28			for i, v := range data {
    29				val, err := toFloat(v)
    30				if err != nil {
    31					return nil, fmt.Errorf("transform scale: element %d: %w", i, err)
    32				}
    33				result[i] = val * factor
    34			}
    35	
    36		case "offset":
    37			offset, _ := config["offset"].(float64)
    38			for i, v := range data {
    39				val, err := toFloat(v)
    40				if err != nil {
    41					return nil, fmt.Errorf("transform offset: element %d: %w", i, err)
    42				}
    43				result[i] = val + offset
    44			}
    45	
    46		case "normalize":
    47			if len(data) == 0 {
    48				return map[string]interface{}{"data": result}, nil
    49			}
    50			minVal, maxVal := findMinMax(data)
    51			for i, v := range data {
    52				val, err := toFloat(v)
    53				if err != nil {
    54					return nil, fmt.Errorf("transform normalize: element %d: %w", i, err)
    55				}
    56				if maxVal == minVal {
    57					result[i] = 0.0
    58				} else {
    59					result[i] = 2.0*(val-minVal)/(maxVal-minVal) - 1.0
    60				}
    61			}
    62	
    63		case "identity":
    64			copy(result, data)
    65	
    66		case "clip":
    67			low, _ := config["low"].(float64)
    68			high, _ := config["high"].(float64)
    69			for i, v := range data {
    70				val, err := toFloat(v)
    71				if err != nil {
    72					return nil, fmt.Errorf("transform clip: element %d: %w", i, err)
    73				}
    74				if val < low {
    75					val = low
    76				}
    77				if val > high {
    78					val = high
    79				}
    80				result[i] = val
    81			}
    82	
    83		case "log":
    84			for i, v := range data {
    85				val, err := toFloat(v)
    86				if err != nil {
    87					return nil, fmt.Errorf("transform log: element %d: %w", i, err)
    88				}
    89				if val <= 0 {
    90					return nil, fmt.Errorf("transform log: element %d is non-positive (%f)", i, val)
    91				}
    92				result[i] = math.Log(val)
    93			}
    94	
    95		default:
    96			return nil, fmt.Errorf("transform: unknown mode %q", mode)
    97		}
    98	
    99		return map[string]interface{}{"data": result}, nil
   100	}
   101	
   102	// ExecuteValidate checks data against schema constraints.
   103	func ExecuteValidate(config, input map[string]interface{}) (map[string]interface{}, error) {
   104		data, ok := input["data"].([]interface{})
   105		if !ok {
   106			return nil, fmt.Errorf("validate: missing or invalid 'data' field")
   107		}
   108	
   109		var errors []interface{}
   110	
   111		// Check min_value constraint
   112		if minVal, ok := config["min_value"].(float64); ok {
   113			for i, v := range data {
   114				val, err := toFloat(v)
   115				if err != nil {
   116					errors = append(errors, fmt.Sprintf("element %d: not a number", i))
   117					continue
   118				}
   119				if val < minVal {
   120					errors = append(errors, fmt.Sprintf("element %d: value %f below minimum %f", i, val, minVal))
   121				}
   122			}
   123		}
   124	
   125		// Check max_value constraint
   126		if maxVal, ok := config["max_value"].(float64); ok {
   127			for i, v := range data {
   128				val, err := toFloat(v)
   129				if err != nil {
   130					continue
   131				}
   132				if val > maxVal {
   133					errors = append(errors, fmt.Sprintf("element %d: value %f above maximum %f", i, val, maxVal))
   134				}
   135			}
   136		}
   137	
   138		// Check min_count constraint
   139		if minCount, ok := config["min_count"].(float64); ok {
   140			if float64(len(data)) < minCount {
   141				errors = append(errors, fmt.Sprintf("data has %d elements, minimum required is %d", len(data), int(minCount)))
   142			}
   143		}
   144	
   145		valid := len(errors) == 0
   146		return map[string]interface{}{
   147			"valid":  valid,
   148			"errors": errors,
   149			"data":   data,
   150		}, nil
   151	}
   152	
   153	// ExecuteAggregate computes aggregations over input data.
   154	// Supported operations: sum, mean, count, min, max.
   155	func ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {
   156		data, ok := input["data"].([]interface{})
   157		if !ok {
   158			return nil, fmt.Errorf("aggregate: missing or invalid 'data' field")
   159		}
   160	
   161		operation, _ := config["operation"].(string)
   162		if operation == "" {
   163			return nil, fmt.Errorf("aggregate: missing 'operation' in config")
   164		}
   165	
   166		values := make([]float64, 0, len(data))
   167		for _, v := range data {
   168			val, err := toFloat(v)
   169			if err != nil {
   170				continue
   171			}
   172			values = append(values, val)
   173		}
   174	
   175		if len(values) == 0 {
   176			return map[string]interface{}{"result": 0.0, "count": 0.0}, nil
   177		}
   178	
   179		var result float64
   180		switch operation {
   181		case "sum":
   182			for _, v := range values {
   183				result += v
   184			}
   185		case "mean":
   186			for _, v := range values {
   187				result += v
   188			}
   189			result /= float64(len(values))
   190		case "count":
   191			result = float64(len(values))
   192		case "min":
   193			result = values[0]
   194			for _, v := range values[1:] {
   195				if v < result {
   196					result = v
   197				}
   198			}
   199		case "max":
   200			result = values[0]
   201			for _, v := range values[1:] {
   202				if v > result {
   203					result = v
   204				}
   205			}
   206		case "range":
   207			if len(values) < 2 {
   208				result = 0.0
   209			} else {
   210				minVal := values[0]
   211				maxVal := values[0]
   212				for _, v := range values[1:] {
   213					if v < minVal {
   214						minVal = v
   215					}
   216					if v > maxVal {
   217						maxVal = v
   218					}
   219				}
   220				result = maxVal - minVal
   221			}
   222		default:
   223			return nil, fmt.Errorf("aggregate: unknown operation %q", operation)
   224		}
   225	
   226		return map[string]interface{}{
   227			"result": result,
   228			"count":  float64(len(values)),
   229			"data":   data,
   230		}, nil
   231	}
