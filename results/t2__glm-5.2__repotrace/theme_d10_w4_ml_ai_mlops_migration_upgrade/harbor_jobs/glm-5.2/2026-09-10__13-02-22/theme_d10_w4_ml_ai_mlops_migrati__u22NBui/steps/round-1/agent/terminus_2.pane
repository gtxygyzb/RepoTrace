   169	// --- Pipeline Handlers ---
   170	
   171	func (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {
   172		var req struct {
   173			Name     string                 `json:"name"`
   174			Steps    []*pipeline.Step       `json:"steps"`
   175			Input    map[string]interface{} `json:"input"`
   176			Pipeline *pipeline.Pipeline     `json:"pipeline"`
   177		}
   178		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   179			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   180			return
   181		}
   182		p := req.Pipeline
   183		if p == nil {
   184			p = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}
   185		}
   186		if p == nil || len(p.Steps) == 0 {
   187			writeError(w, http.StatusBadRequest, "pipeline with at least one step is required")
   188			return
   189		}
   190		if req.Input == nil {
   191			req.Input = make(map[string]interface{})
   192		}
   193	
   194		result, err := h.Pipeline.Execute(p, req.Input)
   195		if err != nil {
   196			writeError(w, http.StatusBadRequest, "%v", err)
   197			return
   198		}
   199		writeJSON(w, http.StatusOK, result)
   200	}
