    57		Dependencies []string   `json:"dependencies"`
    58		CreatedAt    time.Time  `json:"created_at"`
    59		UpdatedAt    time.Time  `json:"updated_at"`
    60	}
    61	
    62	// ModelFilter defines filtering criteria for listing models.
    63	type ModelFilter struct {
    64		Framework string
    65		Tag       string
    66	}
    67	
    68	// Annotation represents a key-value annotation attached to a model version.
    69	type Annotation struct {
    70		Key       string    `json:"key"`
    71		Value     string    `json:"value"`
