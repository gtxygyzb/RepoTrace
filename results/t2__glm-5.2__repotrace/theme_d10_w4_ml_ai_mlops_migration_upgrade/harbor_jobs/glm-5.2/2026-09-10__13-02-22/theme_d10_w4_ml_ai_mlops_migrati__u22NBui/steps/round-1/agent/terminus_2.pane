// --- Model Version Comparison Handler ---

func (h *Handlers) CompareVersionMetrics(w http.ResponseWriter, r *http.Request) {
\tmodelName := r.PathValue("name")
\tversionParam := r.URL.Query().Get("versions")
\tif versionParam == "" {
\t\twriteError(w, http.StatusBadRequest, "query parameter 'versions' is required")
\t\treturn
\t}

\tparts := strings.Split(versionParam, ",")
\tseen := map[int]bool{}
\tversionNums := make([]int, 0, len(parts))
\tfor _, p := range parts {
\t\tnum, err := strconv.Atoi(strings.TrimSpace(p))
\t\tif err != nil {
\t\t\twriteError(w, http.StatusBadRequest, "invalid version number: %q", p)
\t\t\treturn
\t\t}
\t\tif seen[num] {
\t\t\twriteError(w, http.StatusBadRequest, "duplicate version number: %d", num)
\t\t\treturn
\t\t}
\t\tseen[num] = true
\t\tversionNums = append(versionNums, num)
\t}
\tif len(versionNums) < 2 {
\t\twriteError(w, http.StatusBadRequest, "at least 2 versions are required for comparison")
\t\treturn
\t}

\tmodel, err := h.Registry.GetModel(modelName)
\tif err != nil {
\t\twriteError(w, http.StatusNotFound, "%v", err)
\t\treturn
\t}

\tsort.Ints(versionNums)
\tversionMap := map[int]*registry.Version{}
\tfor _, v := range model.Versions {
\t\tversionMap[v.Number] = v
\t}

\tversions := make([]map[string]interface{}, 0, len(versionNums))
\tfor _, num := range versionNums {
\t\tv, ok := versionMap[num]
\t\tif !ok {
\t\t\twriteError(w, http.StatusBadRequest, "version %d does not exist for model %q", num, modelName)
\t\t\treturn
\t\t}
\t\tversions = append(versions, map[string]interface{}{
\t\t\t"number":  v.Number,
