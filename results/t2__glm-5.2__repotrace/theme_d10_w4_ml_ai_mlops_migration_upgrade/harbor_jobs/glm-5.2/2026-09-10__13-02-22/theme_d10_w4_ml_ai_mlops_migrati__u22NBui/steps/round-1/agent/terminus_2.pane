// PromoteVersion transitions a model version to the specified stage.
func (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	model, exists := r.models[modelName]
	if !exists {
		return fmt.Errorf("model %q not found", modelName)
	}

	var version *Version
	for _, v := range model.Versions {
		if v.Number == versionNum {
			version = v
			break
		}
	}
	if version == nil {
		return fmt.Errorf("version %d not found for model %q", versionNum, modelName)
	}

	// Validate stage transition
	allowed := validTransitions[version.Stage]
	valid := false
	for _, s := range allowed {
		if s == targetStage {
			valid = true
			break
		}
	}
	if !valid {
		return fmt.Errorf("invalid stage transition from %s to %s", version.Stage, targetStage)
	}

	// If promoting to production, demote current production version
	if targetStage == StageProduction {
		for _, v := range model.Versions {
			if v.Stage == StageProduction && v.Number != versionNum {
				v.Stage = StageArchived
			}
		}
	}

	version.Stage = targetStage
	model.UpdatedAt = time.Now()

	return r.saveModel(model)
}

// GetModel returns a model with its versions sorted by version number descending.
func (r *Registry) GetModel(name string) (*Model, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	model, exists := r.models[name]
	if !exists {
		return nil, fmt.Errorf("model %q not found", name)
	}

	// Return a copy with versions sorted
	result := *model
	result.Versions = make([]*Version, len(model.Versions))
	copy(result.Versions, model.Versions)
	sort.Slice(result.Versions, func(i, j int) bool {
		return result.Versions[i].Number < result.Versions[j].Number
	})
	return &result, nil
}

// ListModels returns all models matching the optional filter.
func (r *Registry) ListModels(filter *ModelFilter) ([]*Model, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	var result []*Model
	for _, model := range r.models {
		if filter != nil {
			if filter.Framework != "" && model.Framework != filter.Framework {
				continue
			}
			if filter.Tag != "" {
				hasTag := false
				for _, t := range model.Tags {
					if t == filter.Tag {
						hasTag = true
						break
					}
				}
				if !hasTag {
					continue
[?2004hroot@n30009:/app# sed -n '230,330p' internal/registry/registry.go
[?2004l					continue
				}
			}
		}
		result = append(result, model)
	}
	sort.Slice(result, func(i, j int) bool {
		return result[i].Name < result[j].Name
	})
	return result, nil
}

// DeleteModel removes a model from the registry.
func (r *Registry) DeleteModel(name string) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	if _, exists := r.models[name]; !exists {
		return fmt.Errorf("model %q not found", name)
	}

	delete(r.models, name)
	filename := filepath.Join(r.dataDir, name+".json")
	os.Remove(filename)
	return nil
}

// GetVersion returns a specific version of a model.
func (r *Registry) GetVersion(modelName string, versionNum int) (*Version, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	model, exists := r.models[modelName]
	if !exists {
		return nil, fmt.Errorf("model %q not found", modelName)
	}

	for _, v := range model.Versions {
		if v.Number == versionNum {
			return v, nil
		}
	}
	return nil, fmt.Errorf("version %d not found for model %q", versionNum, modelName)
}

// GetVersionByStage returns the version of a model currently in the specified stage.
func (r *Registry) GetVersionByStage(modelName string, stage Stage) (*Version, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	model, exists := r.models[modelName]
	if !exists {
		return nil, fmt.Errorf("model %q not found", modelName)
	}

	for _, v := range model.Versions {
		if v.Stage == stage {
			return v, nil
		}
	}
	return nil, fmt.Errorf("no version in stage %s for model %q", stage, modelName)
}

// loadAll reads all model files from the data directory.
func (r *Registry) loadAll() error {
	entries, err := os.ReadDir(r.dataDir)
	if err != nil {
		if os.IsNotExist(err) {
			return nil
		}
		return err
	}
	for _, entry := range entries {
		if !entry.IsDir() && filepath.Ext(entry.Name()) == ".json" {
			data, err := os.ReadFile(filepath.Join(r.dataDir, entry.Name()))
			if err != nil {
				return err
			}
			var model Model
			if err := json.Unmarshal(data, &model); err != nil {
				return err
			}
			r.models[model.Name] = &model
		}
	}
	return nil
}

// saveModel writes a model's data to its JSON file.
func (r *Registry) saveModel(model *Model) error {
	data, err := json.MarshalIndent(model, "", "  ")
	if err != nil {
		return err
	}
	filename := filepath.Join(r.dataDir, model.Name+".json")
	return os.WriteFile(filename, data, 0644)
}
