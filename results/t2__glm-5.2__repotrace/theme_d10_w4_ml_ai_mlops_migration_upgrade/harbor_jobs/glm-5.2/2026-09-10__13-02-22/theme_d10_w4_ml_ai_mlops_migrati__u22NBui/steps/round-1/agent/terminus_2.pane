    13	// Stage represents the lifecycle stage of a model version.
    14	type Stage string
    15	
    16	const (
    17		StageDevelopment Stage = "development"
    18		StageStaging     Stage = "staging"
    19		StageProduction  Stage = "production"
    20		StageArchived    Stage = "archived"
    21	)
    22	
    23	var validTransitions = map[Stage][]Stage{
    24		StageDevelopment: {StageStaging, StageArchived},
    25		StageStaging:     {StageProduction, StageArchived},
    26		StageProduction:  {StageArchived},
    27		StageArchived:    {},
    28	}
    29	
    30	// Version represents a specific version of a model.
    31	type Version struct {
    32		Number      int                    `json:"number"`
    33		Stage       Stage                  `json:"stage"`
    34		Metrics     map[string]float64     `json:"metrics"`
    35		Tags        []string               `json:"tags"`
    36		ModelConfig map[string]interface{} `json:"model_config,omitempty"`
    37		CreatedAt   time.Time              `json:"created_at"`
    38	}
    39	
    40	// Model represents a registered ML model.
    41	type Model struct {
    42		Name        string     `json:"name"`
    43		Framework   string     `json:"framework"`
    44		Description string     `json:"description"`
    45		Tags        []string   `json:"tags"`
    46		Versions    []*Version `json:"versions"`
    47		CreatedAt   time.Time  `json:"created_at"`
    48		UpdatedAt   time.Time  `json:"updated_at"`
    49	}
    50	
    51	// ModelFilter defines filtering criteria for listing models.
    52	type ModelFilter struct {
    53		Framework string
    54		Tag       string
    55	}
    56	
    57	// Registry manages model registration, versioning, and lifecycle.
    58	type Registry struct {
    59		mu      sync.RWMutex
    60		models  map[string]*Model
    61		dataDir string
    62	}
    63	
    64	// NewRegistry creates a new Registry backed by the given data directory.
    65	func NewRegistry(dataDir string) (*Registry, error) {
    66		if err := os.MkdirAll(dataDir, 0755); err != nil {
    67			return nil, fmt.Errorf("create data dir: %w", err)
    68		}
    69		r := &Registry{
    70			models:  make(map[string]*Model),
    71			dataDir: dataDir,
    72		}
    73		if err := r.loadAll(); err != nil {
    74			return nil, fmt.Errorf("load registry: %w", err)
    75		}
    76		return r, nil
    77	}
