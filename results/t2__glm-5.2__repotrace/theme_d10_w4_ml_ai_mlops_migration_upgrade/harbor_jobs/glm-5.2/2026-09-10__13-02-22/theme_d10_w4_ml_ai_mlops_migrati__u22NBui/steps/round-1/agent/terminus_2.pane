   309	// GetVersion returns a specific version of a model.
   310	func (r *Registry) GetVersion(modelName string, versionNum int) (*Version, error) {
   311		r.mu.RLock()
   312		defer r.mu.RUnlock()
   313	
   314		model, exists := r.models[modelName]
   315		if !exists {
   316			return nil, fmt.Errorf("model %q not found", modelName)
   317		}
   318	
   319		for _, v := range model.Versions {
   320			if v.Number == versionNum {
   321				return v, nil
   322			}
   323		}
   324		return nil, fmt.Errorf("version %d not found for model %q", versionNum, modelName)
   325	}
   326	
   327	// GetVersionByStage returns the version of a model currently in the specified stage.
   328	func (r *Registry) GetVersionByStage(modelName string, stage Stage) (*Version, error) {
   329		r.mu.RLock()
   330		defer r.mu.RUnlock()
   331	
   332		model, exists := r.models[modelName]
   333		if !exists {
   334			return nil, fmt.Errorf("model %q not found", modelName)
   335		}
   336	
   337		for _, v := range model.Versions {
   338			if v.Stage == stage {
   339				return v, nil
   340			}
   341		}
   342		return nil, fmt.Errorf("no version in stage %s for model %q", stage, modelName)
   343	}
   344	
   345	// ValidateAnnotationKey returns true if key is non-empty and contains only
   346	// letters, digits, and underscores.
   347	func ValidateAnnotationKey(key string) bool {
   348		return validateAnnotationKey(key)
   349	}
   350	
   351	// findVersionLocked returns the version pointer for the given model and version number.
   352	// The caller must hold an appropriate lock.
   353	func (r *Registry) findVersionLocked(modelName string, versionNum int) (*Model, *Version, error) {
   354		model, exists := r.models[modelName]
   355		if !exists {
   356			return nil, nil, fmt.Errorf("model %q not found", modelName)
   357		}
   358	
   359		for _, v := range model.Versions {
   360			if v.Number == versionNum {
   361				return model, v, nil
   362			}
   363		}
   364		return nil, nil, fmt.Errorf("version %d not found for model %q", versionNum, modelName)
   365	}
