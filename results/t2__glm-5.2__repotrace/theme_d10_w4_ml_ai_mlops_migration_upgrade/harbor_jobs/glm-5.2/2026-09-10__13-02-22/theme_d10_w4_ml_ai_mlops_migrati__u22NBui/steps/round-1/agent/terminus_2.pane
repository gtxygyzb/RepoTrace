   514	func (h *Handlers) Infer(w http.ResponseWriter, r *http.Request) {
   515		var req serving.InferenceRequest
   516		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   517			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   518			return
   519		}
   520		if req.ModelName == "" {
   521			h.Serving.RecordRequest(req.ModelName, false, 0)
   522			writeError(w, http.StatusBadRequest, "model_name is required")
   523			return
   524		}
   525	
   526		resp, err := h.Serving.Infer(&req)
   527		if err != nil {
   528			h.Serving.RecordRequest(req.ModelName, false, 0)
   529			writeError(w, http.StatusNotFound, "%v", err)
   530			return
   531		}
   532		h.Serving.RecordRequest(req.ModelName, true, resp.LatencyMs)
   533		writeJSON(w, http.StatusOK, resp)
   534	}
