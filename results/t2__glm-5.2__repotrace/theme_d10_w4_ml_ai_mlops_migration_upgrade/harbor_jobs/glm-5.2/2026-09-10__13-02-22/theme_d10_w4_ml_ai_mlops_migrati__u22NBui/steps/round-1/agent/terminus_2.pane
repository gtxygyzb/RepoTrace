   846	// --- Model Version Filtering Handler ---
   847	
   848	func (h *Handlers) ListModelVersions(w http.ResponseWriter, r *http.Request) {
   849		modelName := r.PathValue("name")
   850		stageFilter := r.URL.Query().Get("stage")
   851		minMetricParam := r.URL.Query().Get("min_metric")
   852	
   853		var metricName string
   854		var metricThreshold float64
   855		if minMetricParam != "" {
   856			parts := strings.SplitN(minMetricParam, ":", 2)
   857			if len(parts) != 2 || parts[0] == "" {
   858				writeError(w, http.StatusBadRequest, "invalid min_metric format, expected name:value")
   859				return
   860			}
   861			val, err := strconv.ParseFloat(parts[1], 64)
   862			if err != nil {
   863				writeError(w, http.StatusBadRequest, "invalid min_metric value: %v", err)
   864				return
   865			}
   866			metricName = parts[0]
   867			metricThreshold = val
   868		}
   869	
   870		model, err := h.Registry.GetModel(modelName)
   871		if err != nil {
   872			writeError(w, http.StatusNotFound, "%v", err)
   873			return
   874		}
   875	
   876		versions := make([]*registry.Version, 0, len(model.Versions))
   877		for _, v := range model.Versions {
   878			if stageFilter != "" && string(v.Stage) != stageFilter {
   879				continue
   880			}
   881			if metricName != "" {
   882				val, ok := v.Metrics[metricName]
   883				if !ok || val < metricThreshold {
   884					continue
   885				}
   886			}
   887			versions = append(versions, v)
   888		}
   889	
   890		sort.Slice(versions, func(i, j int) bool {
   891			return versions[i].Number > versions[j].Number
   892		})
   893	
   894		writeJSON(w, http.StatusOK, map[string]interface{}{
   895			"model":    modelName,
   896			"versions": versions,
   897			"count":    len(versions),
   898		})
   899	}
   900	
   901	// --- Model Lineage Handler ---
   902	
   903	func (h *Handlers) ModelLineage(w http.ResponseWriter, r *http.Request) {
   904		modelName := r.PathValue("name")
   905		model, err := h.Registry.GetModel(modelName)
   906		if err != nil {
   907			writeError(w, http.StatusNotFound, "%v", err)
   908			return
   909		}
   910	
   911		versions := make([]*registry.Version, len(model.Versions))
   912		copy(versions, model.Versions)
   913		sort.Slice(versions, func(i, j int) bool {
   914			return versions[i].Number < versions[j].Number
   915		})
   916	
   917		entries := make([]map[string]interface{}, 0, len(versions))
   918		for _, v := range versions {
   919			promotions := []registry.PromotionRecord{}
   920			if v.Lineage != nil {
   921				promotions = append(promotions, v.Lineage...)
   922			}
   923			entry := map[string]interface{}{
   924				"version":       v.Number,
   925				"current_stage": string(v.Stage),
   926				"promotions":    promotions,
   927			}
   928			if v.DemotedBy != 0 {
   929				entry["demoted_by"] = v.DemotedBy
   930			}
   931			entries = append(entries, entry)
   932		}
   933	
   934		writeJSON(w, http.StatusOK, map[string]interface{}{
   935			"model":    modelName,
   936			"versions": entries,
   937		})
   938	}
