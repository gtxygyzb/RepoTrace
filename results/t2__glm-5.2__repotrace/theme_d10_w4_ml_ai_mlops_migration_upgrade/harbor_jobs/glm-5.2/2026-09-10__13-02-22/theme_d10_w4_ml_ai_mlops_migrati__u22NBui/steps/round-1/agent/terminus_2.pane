    99	func (t *Tracker) GetExperiment(name string) (*Experiment, error) {
   100		t.mu.RLock()
   101		defer t.mu.RUnlock()
   102	
   103		exp, exists := t.experiments[name]
   104		if !exists {
   105			return nil, fmt.Errorf("experiment %q not found", name)
   106		}
   107		return exp, nil
