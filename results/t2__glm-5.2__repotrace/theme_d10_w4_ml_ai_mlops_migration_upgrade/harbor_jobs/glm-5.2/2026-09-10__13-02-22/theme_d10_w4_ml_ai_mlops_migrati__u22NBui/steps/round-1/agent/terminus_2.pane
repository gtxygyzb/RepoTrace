   190	// GetModel returns a model with its versions sorted by version number descending.
   191	func (r *Registry) GetModel(name string) (*Model, error) {
   192		r.mu.RLock()
   193		defer r.mu.RUnlock()
   194	
   195		model, exists := r.models[name]
   196		if !exists {
   197			return nil, fmt.Errorf("model %q not found", name)
   198		}
   199	
   200		// Return a copy with versions sorted
   201		result := *model
   202		result.Versions = make([]*Version, len(model.Versions))
   203		copy(result.Versions, model.Versions)
   204		sort.Slice(result.Versions, func(i, j int) bool {
   205			return result.Versions[i].Number > result.Versions[j].Number
   206		})
   207		return &result, nil
   208	}
