[?2004l   237	func (t *Tracker) loadAll() {
   238		entries, err := os.ReadDir(t.dataDir)
   239		if err != nil {
   240			return
   241		}
   242		for _, entry := range entries {
   243			if !entry.IsDir() && filepath.Ext(entry.Name()) == ".json" {
   244				data, err := os.ReadFile(filepath.Join(t.dataDir, entry.Name()))
   245				if err != nil {
   246					continue
   247				}
   248				var exp Experiment
   249				if err := json.Unmarshal(data, &exp); err != nil {
   250					continue
   251				}
   252				t.experiments[exp.Name] = &exp
   253				for _, r := range exp.Runs {
   254					_ = r
   255					t.runCounter++
   256				}
   257			}
   258		}
   259	}
   260	
   261	func (t *Tracker) saveExperiment(exp *Experiment) error {
   262		data, err := json.MarshalIndent(exp, "", "  ")
   263		if err != nil {
   264			return err
   265		}
   266		filename := filepath.Join(t.dataDir, exp.Name+".json")
   267		return os.WriteFile(filename, data, 0644)
   268	}
