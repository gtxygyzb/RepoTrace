// --- Serving Health Handler ---

func (h *Handlers) ServingHealth(w http.ResponseWriter, r *http.Request) {
\tmodelName := r.PathValue("name")
\tresult, err := h.Serving.HealthCheck(modelName)
\tif err != nil {
\t\twriteError(w, http.StatusNotFound, "%v", err)
\t\treturn
\t}
\twriteJSON(w, http.StatusOK, result)
}

// --- Experiment Correlation Handler ---

func (h *Handlers) ExperimentCorrelation(w http.ResponseWriter, r *http.Request) {
\texpName := r.PathValue("name")
\tmetricsParam := r.URL.Query().Get("metrics")
\tif metricsParam == "" {
\t\twriteError(w, http.StatusBadRequest, "metrics parameter is required")
\t\treturn
\t}
\tparts := strings.Split(metricsParam, ",")
\tif len(parts) != 2 {
\t\twriteError(w, http.StatusBadRequest, "metrics must contain exactly two metric names")
\t\treturn
\t}
\tmetricX := strings.TrimSpace(parts[0])
\tmetricY := strings.TrimSpace(parts[1])
\tif metricX == "" || metricY == "" {
\t\twriteError(w, http.StatusBadRequest, "metrics must contain exactly two metric names")
\t\treturn
\t}

\tresult, err := h.Experiment.Correlation(expName, metricX, metricY)
\tif err != nil {
\t\tif strings.Contains(err.Error(), "not found") {
\t\t\twriteError(w, http.StatusNotFound, "%v", err)
\t\t} else {
\t\t\twriteError(w, http.StatusBadRequest, "%v", err)
\t\t}
\t\treturn
\t}
\twriteJSON(w, http.StatusOK, result)
}

