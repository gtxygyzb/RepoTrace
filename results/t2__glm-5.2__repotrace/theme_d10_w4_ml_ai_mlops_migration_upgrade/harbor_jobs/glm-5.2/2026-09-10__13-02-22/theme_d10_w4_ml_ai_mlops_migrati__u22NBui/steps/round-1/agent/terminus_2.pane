    40	// NewTracker creates a new experiment tracker backed by the given data directory.
    41	func NewTracker(dataDir string) *Tracker {
    42		os.MkdirAll(dataDir, 0755)
    43		t := &Tracker{
    44			experiments: make(map[string]*Experiment),
    45			dataDir:     dataDir,
    46		}
    47		t.loadAll()
    48		return t
    49	}
    50	
    51	// CreateExperiment creates a new experiment with the given name.
    52	func (t *Tracker) CreateExperiment(name string) (*Experiment, error) {
    53		t.mu.Lock()
    54		defer t.mu.Unlock()
    55	
    56		if _, exists := t.experiments[name]; exists {
    57			return nil, fmt.Errorf("experiment %q already exists", name)
    58		}
    59	
    60		exp := &Experiment{
    61			Name:      name,
    62			Runs:      make([]*Run, 0),
    63			CreatedAt: time.Now(),
    64		}
    65		t.experiments[name] = exp
    66		if err := t.saveExperiment(exp); err != nil {
    67			delete(t.experiments, name)
    68			return nil, err
    69		}
    70		return exp, nil
    71	}
    72	
    73	// LogRun adds a new run to the specified experiment.
    74	func (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {
    75		t.mu.Lock()
    76		defer t.mu.Unlock()
    77	
    78		exp, exists := t.experiments[experimentName]
    79		if !exists {
    80			return nil, fmt.Errorf("experiment %q not found", experimentName)
    81		}
    82	
    83		t.runCounter++
    84		run := &Run{
    85			ID:         fmt.Sprintf("run_%d", t.runCounter),
    86			Parameters: params,
    87			Metrics:    metrics,
    88			Tags:       tags,
    89			CreatedAt:  time.Now(),
    90		}
    91		exp.Runs = append(exp.Runs, run)
    92	
    93		if err := t.saveExperiment(exp); err != nil {
    94			exp.Runs = exp.Runs[:len(exp.Runs)-1]
    95			return nil, err
    96		}
    97		return run, nil
    98	}
    99	
