   171		}
   172	
   173		switch aggType {
   174		case "mean":
   175			sum := 0.0
   176			for _, v := range values {
   177				sum += v
   178			}
   179			return sum / float64(len(values)), len(values), runIDs, nil
   180	
   181		case "median":
   182			sorted := sortedCopy(values)
   183			n := len(sorted)
