   127	// AggregateMetric computes an aggregate statistic for a given metric across all runs
   128	// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.
   129	// For weighted_mean, weightParam specifies which parameter to use as weight.
   130	func (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string, tagFilters map[string]string) (float64, int, []string, error) {
   131		t.mu.RLock()
   132		defer t.mu.RUnlock()
   133	
   134		exp, exists := t.experiments[experimentName]
   135		if !exists {
   136			return 0, 0, nil, fmt.Errorf("experiment %q not found", experimentName)
   137		}
   138	
   139		if len(exp.Runs) == 0 {
   140			return 0, 0, nil, fmt.Errorf("experiment %q has no runs", experimentName)
   141		}
   142	
   143		var values []float64
   144		var weights []float64
   145		var runIDs []string
   146		for _, run := range exp.Runs {
   147			if !matchTags(run.Tags, tagFilters) {
   148				continue
   149			}
   150			value, ok := run.Metrics[metricName]
   151			if !ok {
   152				continue
   153			}
   154			if aggType == "weighted_mean" {
   155				weight, ok := run.Metrics[weightParam]
   156				if !ok {
   157					continue
   158				}
   159				values = append(values, value)
   160				weights = append(weights, weight)
   161				runIDs = append(runIDs, run.ID)
   162			} else {
   163				values = append(values, value)
   164				runIDs = append(runIDs, run.ID)
   165			}
   166		}
   167	
   168		if len(values) == 0 {
   169			if len(tagFilters) > 0 {
   170				return 0, 0, nil, fmt.Errorf("no runs match tag filters for metric %q", metricName)
   171			}
   172			return 0, 0, nil, fmt.Errorf("no values found for metric %q", metricName)
   173		}
   174	
   175		switch aggType {
   176		case "mean":
   177			sum := 0.0
   178			for _, v := range values {
   179				sum += v
   180			}
   181			return sum / float64(len(values)), len(values), runIDs, nil
   182	
   183		case "median":
   184			sorted := sortedCopy(values)
   185			n := len(sorted)
   186			if n%2 == 0 {
   187				return (sorted[n/2-1] + sorted[n/2]) / 2, len(values), runIDs, nil
   188			}
   189			return sorted[n/2], len(values), runIDs, nil
   190	
   191		case "p95":
   192			sorted := sortedCopy(values)
   193			return percentile(sorted, 0.95), len(values), runIDs, nil
   194	
   195		case "p99":
   196			sorted := sortedCopy(values)
   197			return percentile(sorted, 0.99), len(values), runIDs, nil
   198	
   199		case "weighted_mean":
   200			if weightParam == "" {
   201				return 0, 0, nil, fmt.Errorf("weighted_mean requires weight parameter")
   202			}
   203			if len(weights) == 0 {
   204				return 0, 0, nil, fmt.Errorf("no runs with metric %q and weight metric %q", metricName, weightParam)
   205			}
   206			if len(weights) != len(values) {
   207				return 0, 0, nil, fmt.Errorf("mismatch between metric values and weights")
   208			}
   209			weightedSum := 0.0
   210			weightSum := 0.0
   211			for i, v := range values {
   212				weightedSum += v * weights[i]
   213				weightSum += weights[i]
   214			}
   215			if weightSum == 0 {
   216				return 0, 0, nil, fmt.Errorf("weighted_mean has zero total weight")
   217			}
   218			return weightedSum / weightSum, len(values), runIDs, nil
   219	
   220		default:
   221			return 0, 0, nil, fmt.Errorf("unknown aggregation type %q", aggType)
   222		}
   223	}
