    11	
    12	// Handlers holds references to all service components.
    13	type Handlers struct {
    14		Registry   *registry.Registry
    15		Pipeline   *pipeline.Engine
    16		Experiment *experiment.Tracker
    17		Serving    *serving.Server
    18		Templates  *TemplateStore
    19	}
    20	
    21	// NewRouter builds the HTTP route table and returns a handler.
    22	func NewRouter(reg *registry.Registry, eng *pipeline.Engine, tracker *experiment.Tracker, srv *serving.Server) http.Handler {
    23		h := &Handlers{
    24			Registry:   reg,
    25			Pipeline:   eng,
    26			Experiment: tracker,
    27			Serving:    srv,
    28			Templates:  NewTemplateStore(),
    29		}
    30	
    31		mux := http.NewServeMux()
    32	
