[?2004l     1	package main
     2	
     3	import (
     4		"encoding/json"
     5		"flag"
     6		"fmt"
     7		"log"
     8		"net/http"
     9		"os"
    10	
    11		"gomlops/internal/api"
    12		"gomlops/internal/experiment"
    13		"gomlops/internal/pipeline"
    14		"gomlops/internal/registry"
    15		"gomlops/internal/serving"
    16	)
    17	
    18	// Config holds the server configuration.
    19	type Config struct {
    20		Port    int    `json:"port"`
    21		DataDir string `json:"data_dir"`
    22	}
    23	
    24	func main() {
    25		configPath := flag.String("config", "/app/configs/config.json", "path to config file")
    26		flag.Parse()
    27	
    28		cfg, err := loadConfig(*configPath)
    29		if err != nil {
    30			log.Fatalf("Failed to load config: %v", err)
    31		}
    32	
    33		reg, err := registry.NewRegistry(cfg.DataDir + "/registry")
    34		if err != nil {
    35			log.Fatalf("Failed to initialize registry: %v", err)
    36		}
    37	
    38		eng := pipeline.NewEngine()
    39		tracker := experiment.NewTracker(cfg.DataDir + "/experiments")
    40		srv := serving.NewServer(reg)
    41	
    42		router := api.NewRouter(reg, eng, tracker, srv)
    43	
    44		addr := fmt.Sprintf(":%d", cfg.Port)
    45		log.Printf("gomlops server starting on %s", addr)
    46		log.Printf("data directory: %s", cfg.DataDir)
    47		if err := http.ListenAndServe(addr, router); err != nil {
    48			log.Fatalf("Server failed: %v", err)
    49		}
    50	}
    51	
    52	func loadConfig(path string) (*Config, error) {
    53		data, err := os.ReadFile(path)
    54		if err != nil {
    55			return &Config{Port: 8080, DataDir: "/app/data"}, nil
    56		}
    57		var cfg Config
    58		if err := json.Unmarshal(data, &cfg); err != nil {
    59			return nil, fmt.Errorf("parse config: %w", err)
    60		}
    61		if cfg.Port == 0 {
    62			cfg.Port = 8080
    63		}
    64		if cfg.DataDir == "" {
    65			cfg.DataDir = "/app/data"
    66		}
    67		return &cfg, nil
    68	}
