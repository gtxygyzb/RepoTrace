     9		"strings"
    10	
    11		"gomlops/internal/experiment"
    12		"gomlops/internal/pipeline"
    13		"gomlops/internal/registry"
    14		"gomlops/internal/serving"
    15	)
    16	
    17	// --- Model Registry Handlers ---
    18	
    19	func (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {
    20		var req struct {
    21			Name        string   `json:"name"`
    22			Framework   string   `json:"framework"`
    23			Description string   `json:"description"`
    24			Tags        []string `json:"tags"`
    25		}
    26		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
    27			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
    28			return
    29		}
    30		if req.Name == "" {
    31			writeError(w, http.StatusBadRequest, "name is required")
    32			return
    33		}
    34	
    35		model, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)
    36		if err != nil {
    37			writeError(w, http.StatusConflict, "%v", err)
    38			return
    39		}
    40		writeJSON(w, http.StatusCreated, model)
    41	}
    42	
    43	func (h *Handlers) ListModels(w http.ResponseWriter, r *http.Request) {
    44		var filter *registry.ModelFilter
    45		framework := r.URL.Query().Get("framework")
    46		tag := r.URL.Query().Get("tag")
    47		if framework != "" || tag != "" {
    48			filter = &registry.ModelFilter{Framework: framework, Tag: tag}
    49		}
    50	
    51		models, err := h.Registry.ListModels(filter)
    52		if err != nil {
    53			writeError(w, http.StatusInternalServerError, "%v", err)
    54			return
    55		}
    56		writeJSON(w, http.StatusOK, models)
    57	}
    58	
    59	func (h *Handlers) DeleteModel(w http.ResponseWriter, r *http.Request) {
    60		name := r.PathValue("name")
    61		if err := h.Registry.DeleteModel(name); err != nil {
    62			writeError(w, http.StatusNotFound, "%v", err)
    63			return
    64		}
    65		_ = h.Serving.UnloadModel(name)
    66		writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
    67	}
    68	
    69	func (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {
    70		name := r.PathValue("name")
    71		model, err := h.Registry.GetModel(name)
    72		if err != nil {
    73			writeError(w, http.StatusNotFound, "%v", err)
    74			return
    75		}
    76		stageSummary := map[string]int{
    77			"development": 0,
    78			"staging":     0,
    79			"production":  0,
    80			"archived":    0,
    81		}
    82		for _, v := range model.Versions {
    83			stageSummary[string(v.Stage)]++
    84		}
    85		writeJSON(w, http.StatusOK, map[string]interface{}{
    86			"name":          model.Name,
    87			"framework":     model.Framework,
    88			"description":   model.Description,
    89			"tags":          model.Tags,
    90			"versions":      model.Versions,
    91			"created_at":    model.CreatedAt,
    92			"updated_at":    model.UpdatedAt,
    93			"stage_summary": stageSummary,
    94		})
    95	}
    96	
    97	func (h *Handlers) CreateVersion(w http.ResponseWriter, r *http.Request) {
    98		modelName := r.PathValue("name")
    99	
   100		var req struct {
   101			Metrics     map[string]float64     `json:"metrics"`
   102			Tags        []string               `json:"tags"`
   103			ModelConfig map[string]interface{} `json:"model_config"`
   104		}
   105		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   106			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   107			return
   108		}
   109	
   110		version, err := h.Registry.CreateVersion(modelName, req.Metrics, req.Tags, req.ModelConfig)
   111		if err != nil {
   112			writeError(w, http.StatusNotFound, "%v", err)
   113			return
   114		}
   115		writeJSON(w, http.StatusCreated, version)
   116	}
   117	
   118	func (h *Handlers) GetVersion(w http.ResponseWriter, r *http.Request) {
   119		modelName := r.PathValue("name")
   120		numStr := r.PathValue("num")
   121		num, err := strconv.Atoi(numStr)
   122		if err != nil {
   123			writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
   124			return
   125		}
   126	
   127		version, err := h.Registry.GetVersion(modelName, num)
   128		if err != nil {
   129			writeError(w, http.StatusNotFound, "%v", err)
   130			return
   131		}
   132		writeJSON(w, http.StatusOK, version)
   133	}
   134	
   135	func (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {
   136		modelName := r.PathValue("name")
   137		numStr := r.PathValue("num")
   138		num, err := strconv.Atoi(numStr)
   139		if err != nil {
   140			writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
   141			return
   142		}
   143	
   144		var req struct {
   145			Stage string `json:"stage"`
   146		}
   147		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   148			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   149			return
   150		}
   151		if req.Stage == "" {
   152			writeError(w, http.StatusBadRequest, "stage is required")
   153			return
   154		}
   155	
   156		if err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {
   157			writeError(w, http.StatusBadRequest, "%v", err)
   158			return
   159		}
   160		writeJSON(w, http.StatusOK, map[string]string{"status": "promoted"})
   161	}
   162	
   163	// --- Pipeline Handlers ---
   164	
   165	func (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {
   166		var req struct {
   167			Name     string                 `json:"name"`
   168			Steps    []*pipeline.Step       `json:"steps"`
   169			Input    map[string]interface{} `json:"input"`
   170			Pipeline *pipeline.Pipeline     `json:"pipeline"`
   171		}
   172		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   173			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   174			return
   175		}
   176		p := req.Pipeline
   177		if p == nil {
   178			p = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}
   179		}
   180		if p == nil || len(p.Steps) == 0 {
   181			writeError(w, http.StatusBadRequest, "pipeline with at least one step is required")
   182			return
   183		}
   184		if req.Input == nil {
   185			req.Input = make(map[string]interface{})
   186		}
   187	
   188		result, err := h.Pipeline.Execute(p, req.Input)
   189		if err != nil {
   190			writeError(w, http.StatusBadRequest, "%v", err)
   191			return
   192		}
   193		writeJSON(w, http.StatusOK, result)
   194	}
