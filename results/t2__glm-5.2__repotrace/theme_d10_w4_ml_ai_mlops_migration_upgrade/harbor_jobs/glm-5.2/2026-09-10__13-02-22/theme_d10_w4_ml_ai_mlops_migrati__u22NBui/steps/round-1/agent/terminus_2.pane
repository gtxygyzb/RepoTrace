    11		"time"
    12	)
    13	
    14	// Experiment groups related runs together.
    15	type Experiment struct {
    16		Name      string    `json:"name"`
    17		Runs      []*Run    `json:"runs"`
    18		CreatedAt time.Time `json:"created_at"`
    19	}
    20	
    21	// Run records a single experiment execution with parameters and metrics.
    22	type Run struct {
    23		ID         string             `json:"id"`
    24		Parameters map[string]float64 `json:"parameters"`
    25		Metrics    map[string]float64 `json:"metrics"`
    26		Tags       map[string]string  `json:"tags"`
    27		CreatedAt  time.Time          `json:"created_at"`
    28	}
    29	
    30	// Tracker manages experiments and their runs.
    31	type Tracker struct {
    32		mu          sync.RWMutex
    33		experiments map[string]*Experiment
    34		dataDir     string
    35		runCounter  int
    36	}
    37	
    38	// NewTracker creates a new experiment tracker backed by the given data directory.
    39	func NewTracker(dataDir string) *Tracker {
    40		os.MkdirAll(dataDir, 0755)
    41		t := &Tracker{
    42			experiments: make(map[string]*Experiment),
    43			dataDir:     dataDir,
    44		}
    45		t.loadAll()
    46		return t
    47	}
    48	
    49	// CreateExperiment creates a new experiment with the given name.
    50	func (t *Tracker) CreateExperiment(name string) (*Experiment, error) {
    51		t.mu.Lock()
    52		defer t.mu.Unlock()
    53	
    54		if _, exists := t.experiments[name]; exists {
    55			return nil, fmt.Errorf("experiment %q already exists", name)
    56		}
    57	
    58		exp := &Experiment{
    59			Name:      name,
    60			Runs:      make([]*Run, 0),
    61			CreatedAt: time.Now(),
    62		}
    63		t.experiments[name] = exp
    64		if err := t.saveExperiment(exp); err != nil {
    65			delete(t.experiments, name)
    66			return nil, err
    67		}
    68		return exp, nil
    69	}
    70	
    71	// LogRun adds a new run to the specified experiment.
    72	func (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {
    73		t.mu.Lock()
    74		defer t.mu.Unlock()
    75	
    76		exp, exists := t.experiments[experimentName]
    77		if !exists {
    78			return nil, fmt.Errorf("experiment %q not found", experimentName)
    79		}
    80	
    81		t.runCounter++
    82		run := &Run{
    83			ID:         fmt.Sprintf("run_%d", t.runCounter),
    84			Parameters: params,
    85			Metrics:    metrics,
    86			Tags:       tags,
    87			CreatedAt:  time.Now(),
    88		}
    89		exp.Runs = append(exp.Runs, run)
    90	
    91		if err := t.saveExperiment(exp); err != nil {
    92			exp.Runs = exp.Runs[:len(exp.Runs)-1]
    93			return nil, err
    94		}
    95		return run, nil
    96	}
    97	
    98	// GetExperiment returns the experiment with the given name.
    99	func (t *Tracker) GetExperiment(name string) (*Experiment, error) {
   100		t.mu.RLock()
   101		defer t.mu.RUnlock()
   102	
   103		exp, exists := t.experiments[name]
   104		if !exists {
   105			return nil, fmt.Errorf("experiment %q not found", name)
   106		}
   107		return exp, nil
   108	}
   109	
   110	// ListExperiments returns all experiments.
   111	func (t *Tracker) ListExperiments() []*Experiment {
   112		t.mu.RLock()
   113		defer t.mu.RUnlock()
   114	
   115		result := make([]*Experiment, 0, len(t.experiments))
   116		for _, exp := range t.experiments {
   117			result = append(result, exp)
   118		}
   119		sort.Slice(result, func(i, j int) bool {
   120			return result[i].Name < result[j].Name
   121		})
   122		return result
   123	}
   124	
   125	// AggregateMetric computes an aggregate statistic for a given metric across all runs
   126	// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.
   127	// For weighted_mean, weightParam specifies which parameter to use as weight.
   128	func (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string, tagFilters map[string]string) (float64, int, []string, error) {
   129		t.mu.RLock()
   130		defer t.mu.RUnlock()
   131	
   132		exp, exists := t.experiments[experimentName]
   133		if !exists {
   134			return 0, 0, nil, fmt.Errorf("experiment %q not found", experimentName)
   135		}
   136	
   137		if len(exp.Runs) == 0 {
   138			return 0, 0, nil, fmt.Errorf("experiment %q has no runs", experimentName)
   139		}
   140	
   141		var values []float64
   142		var weights []float64
   143		var runIDs []string
   144		for _, run := range exp.Runs {
   145			if !matchTags(run.Tags, tagFilters) {
   146				continue
   147			}
   148			value, ok := run.Metrics[metricName]
   149			if !ok {
   150				continue
   151			}
   152			if aggType == "weighted_mean" {
   153				weight, ok := run.Parameters[weightParam]
   154				if !ok {
   155					continue
   156				}
   157				values = append(values, value)
   158				weights = append(weights, weight)
   159				runIDs = append(runIDs, run.ID)
   160			} else {
   161				values = append(values, value)
   162				runIDs = append(runIDs, run.ID)
   163			}
   164		}
   165	
   166		if len(values) == 0 {
   167			if len(tagFilters) > 0 {
   168				return 0, 0, nil, fmt.Errorf("no runs match tag filters for metric %q", metricName)
   169			}
   170			return 0, 0, nil, fmt.Errorf("no values found for metric %q", metricName)
   171		}
   172	
   173		switch aggType {
   174		case "mean":
   175			sum := 0.0
   176			for _, v := range values {
   177				sum += v
   178			}
   179			return sum / float64(len(values)), len(values), runIDs, nil
   180	
   181		case "median":
   182			sorted := sortedCopy(values)
   183			n := len(sorted)
   184			if n%2 == 0 {
   185				return (sorted[n/2-1] + sorted[n/2]) / 2, len(values), runIDs, nil
   186			}
   187			return sorted[n/2], len(values), runIDs, nil
   188	
   189		case "p95":
   190			sorted := sortedCopy(values)
   191			return percentile(sorted, 0.95), len(values), runIDs, nil
   192	
   193		case "p99":
   194			sorted := sortedCopy(values)
   195			return percentile(sorted, 0.99), len(values), runIDs, nil
   196	
   197		case "weighted_mean":
   198			if weightParam == "" {
   199				return 0, 0, nil, fmt.Errorf("weighted_mean requires weight parameter")
   200			}
   201			if len(weights) == 0 {
   202				return 0, 0, nil, fmt.Errorf("no runs with metric %q and weight parameter %q", metricName, weightParam)
   203			}
   204			if len(weights) != len(values) {
   205				return 0, 0, nil, fmt.Errorf("mismatch between metric values and weights")
   206			}
   207			weightedSum := 0.0
   208			weightSum := 0.0
   209			for i, v := range values {
   210				weightedSum += v * weights[i]
   211				weightSum += weights[i]
   212			}
   213			if weightSum == 0 {
   214				return 0, 0, nil, fmt.Errorf("weighted_mean has zero total weight")
   215			}
   216			return weightedSum / weightSum, len(values), runIDs, nil
   217	
   218		default:
   219			return 0, 0, nil, fmt.Errorf("unknown aggregation type %q", aggType)
   220		}
   221	}
   222	
   223	func matchTags(runTags map[string]string, filters map[string]string) bool {
   224		for k, v := range filters {
   225			if runTags[k] != v {
   226				return false
   227			}
   228		}
   229		return true
   230	}
   231	
   232	func (t *Tracker) DeleteRun(experimentName, runID string) error {
   233		t.mu.Lock()
   234		defer t.mu.Unlock()
   235	
   236		exp, exists := t.experiments[experimentName]
   237		if !exists {
   238			return fmt.Errorf("experiment %q not found", experimentName)
   239		}
   240	
   241		for i, run := range exp.Runs {
   242			if run.ID == runID {
   243				exp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)
   244				return t.saveExperiment(exp)
   245			}
   246		}
   247		return fmt.Errorf("run %q not found in experiment %q", runID, experimentName)
   248	}
   249	
   250	func percentile(sorted []float64, p float64) float64 {
   251		n := len(sorted)
   252		if n == 0 {
   253			return 0
   254		}
   255		if n == 1 {
   256			return sorted[0]
   257		}
   258		rank := p * float64(n-1)
   259		lower := int(math.Floor(rank))
   260		upper := int(math.Ceil(rank))
   261		if lower == upper {
   262			return sorted[lower]
   263		}
   264		frac := rank - float64(lower)
   265		return sorted[lower]*(1-frac) + sorted[upper]*frac
   266	}
   267	
   268	func sortedCopy(values []float64) []float64 {
   269		s := make([]float64, len(values))
   270		copy(s, values)
   271		sort.Float64s(s)
   272		return s
   273	}
