   198	
   199	// mergeOutputs collects and merges data arrays from the specified dependency outputs.
   200	func mergeOutputs(stepOutputs map[string]map[string]interface{}, deps []string) map[string]interface{} {
   201		merged := make(map[string]interface{})
   202		var mergedData []interface{}
   203	
   204		for _, dep := range deps {
   205			if output, ok := stepOutputs[dep]; ok {
   206				if data, ok := output["data"]; ok {
   207					switch d := data.(type) {
   208					case []interface{}:
   209						mergedData = append(mergedData, d...)
   210					case []float64:
   211						for _, v := range d {
   212							mergedData = append(mergedData, v)
   213						}
   214					default:
   215						mergedData = append(mergedData, data)
   216					}
   217				}
   218				// Also carry non-data fields keyed by dependency name
   219				for k, v := range output {
   220					if k != "data" {
   221						merged[dep+"_"+k] = v
   222					}
   223				}
   224			}
   225		}
   226	
   227		if len(mergedData) > 0 {
   228			merged["data"] = mergedData
   229		}
   230		return merged
   231	}
   232	
   233	
   234	// mergeDependencyOutputs concatenates the "data" arrays from all dependency outputs into a single input.
   235	func mergeDependencyOutputs(deps []string, outputs map[string]map[string]interface{}) map[string]interface{} {
   236		merged := make([]interface{}, 0)
   237		for _, dep := range deps {
   238			out, ok := outputs[dep]
   239			if !ok {
   240				continue
   241			}
   242			switch data := out["data"].(type) {
   243			case []interface{}:
   244				merged = append(merged, data...)
   245			case []float64:
   246				for _, v := range data {
   247					merged = append(merged, v)
   248				}
   249			}
   250		}
   251		return map[string]interface{}{"data": merged}
   252	}
