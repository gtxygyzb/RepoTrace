   131	// computePrediction evaluates a model against input data.
   132	// Supported model types: linear, polynomial.
   133	func computePrediction(modelConfig map[string]interface{}, input []float64) ([]float64, error) {
   134		if modelConfig == nil {
   135			return nil, fmt.Errorf("model has no configuration")
   136		}
   137	
   138		modelType, _ := modelConfig["model_type"].(string)
   139		switch modelType {
   140		case "linear":
   141			return linearPredict(modelConfig, input)
   142		case "polynomial":
   143			return polynomialPredict(modelConfig, input)
   144		default:
   145			return nil, fmt.Errorf("unsupported model type: %s", modelType)
   146		}
   147	}
   148	
   149	// linearPredict computes y = sum(weights[i] * input[i]) + bias
   150	func linearPredict(config map[string]interface{}, input []float64) ([]float64, error) {
   151		weightsRaw, ok := config["weights"].([]interface{})
   152		if !ok {
   153			return nil, fmt.Errorf("linear model missing weights")
   154		}
   155		bias, _ := config["bias"].(float64)
   156	
   157		weights := make([]float64, len(weightsRaw))
   158		for i, w := range weightsRaw {
   159			wf, ok := w.(float64)
   160			if !ok {
   161				return nil, fmt.Errorf("weight %d is not a number", i)
   162			}
   163			weights[i] = wf
   164		}
   165	
   166		prediction := bias
   167		for i := 0; i < len(weights) && i < len(input); i++ {
   168			prediction += weights[i] * input[i]
   169		}
   170	
   171		return []float64{prediction}, nil
   172	}
   173	
   174	// polynomialPredict computes y = sum(coefficients[i] * x^i) for each input x
   175	func polynomialPredict(config map[string]interface{}, input []float64) ([]float64, error) {
   176		coeffRaw, ok := config["coefficients"].([]interface{})
   177		if !ok {
   178			return nil, fmt.Errorf("polynomial model missing coefficients")
   179		}
   180	
