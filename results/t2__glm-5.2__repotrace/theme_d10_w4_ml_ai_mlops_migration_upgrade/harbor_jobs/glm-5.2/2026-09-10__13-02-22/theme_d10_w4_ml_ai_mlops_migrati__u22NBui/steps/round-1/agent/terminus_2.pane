\t\t\tweights = append(weights, weight)
\t\t\trunIDs = append(runIDs, run.ID)
\t\t} else {
\t\t\tvalues = append(values, value)
\t\t\trunIDs = append(runIDs, run.ID)
\t\t}
\t}

\tif len(values) == 0 {
\t\tif len(tagFilters) > 0 {
\t\t\treturn 0, 0, nil, fmt.Errorf("no runs match tag filters for metric %q", metricName)
\t\t}
\t\treturn 0, 0, nil, fmt.Errorf("no values found for metric %q", metricName)
\t}

\tswitch aggType {
\tcase "mean":
\t\tsum := 0.0
\t\tfor _, v := range values {
\t\t\tsum += v
\t\t}
\t\treturn sum / float64(len(values)), len(values), runIDs, nil

\tcase "median":
\t\tsorted := sortedCopy(values)
\t\tn := len(sorted)
\t\tif n%2 == 0 {
\t\t\treturn (sorted[n/2-1] + sorted[n/2]) / 2, len(values), runIDs, nil
\t\t}
\t\treturn sorted[n/2], len(values), runIDs, nil

\tcase "p95":
\t\tsorted := sortedCopy(values)
\t\treturn percentile(sorted, 0.95), len(values), runIDs, nil

\tcase "p99":
\t\tsorted := sortedCopy(values)
\t\treturn percentile(sorted, 0.99), len(values), runIDs, nil

\tcase "weighted_mean":
\t\tif weightParam == "" {
\t\t\treturn 0, 0, nil, fmt.Errorf("weighted_mean requires weight parameter")
\t\t}
\t\tif len(weights) == 0 {
\t\t\treturn 0, 0, nil, fmt.Errorf("no runs with metric %q and weight parameter %q", metricName, weightParam)
\t\t}
\t\tif len(weights) != len(values) {
\t\t\treturn 0, 0, nil, fmt.Errorf("mismatch between metric values and weights")
\t\t}
\t\tweightedSum := 0.0
\t\tweightSum := 0.0
\t\tfor i, v := range values {
\t\t\tweightedSum += v * weights[i]
\t\t\tweightSum += weights[i]
\t\t}
\t\tif weightSum == 0 {
\t\t\treturn 0, 0, nil, fmt.Errorf("weighted_mean has zero total weight")
\t\t}
\t\treturn weightedSum / weightSum, len(values), runIDs, nil

\tdefault:
\t\treturn 0, 0, nil, fmt.Errorf("unknown aggregation type %q", aggType)
\t}
}

func matchTags(runTags map[string]string, filters map[string]string) bool {
\tfor k, v := range filters {
\t\tif runTags[k] != v {
\t\t\treturn false
\t\t}
\t}
\treturn true
}

func (t *Tracker) DeleteRun(experimentName, runID string) error {
\tt.mu.Lock()
\tdefer t.mu.Unlock()

\texp, exists := t.experiments[experimentName]
\tif !exists {
\t\treturn fmt.Errorf("experiment %q not found", experimentName)
\t}

\tfor i, run := range exp.Runs {
\t\tif run.ID == runID {
\t\t\texp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)
\t\t\treturn t.saveExperiment(exp)
\t\t}
\t}
\treturn fmt.Errorf("run %q not found in experiment %q", runID, experimentName)
}

