   265	
   266	func computeTransitiveDependencies(steps []*Step) map[string]map[string]bool {
   267		stepMap := make(map[string]*Step)
   268		for _, s := range steps {
   269			stepMap[s.Name] = s
   270		}
   271	
   272		result := make(map[string]map[string]bool)
   273		var visit func(s *Step) map[string]bool
   274	
   275		visit = func(s *Step) map[string]bool {
   276			if deps, ok := result[s.Name]; ok {
   277				return deps
   278			}
   279			deps := make(map[string]bool)
   280			for _, dep := range s.Dependencies {
   281				deps[dep] = true
   282				if depStep, ok := stepMap[dep]; ok {
   283					for d := range visit(depStep) {
   284						deps[d] = true
   285					}
   286				}
   287			}
   288			result[s.Name] = deps
   289			return deps
   290		}
   291	
   292		for _, s := range steps {
   293			visit(s)
   294		}
   295		return result
   296	}
   297	
   298	func resolveVariables(config map[string]interface{}, variables map[string]float64, setter map[string]string, depSet map[string]bool) (map[string]interface{}, error) {
   299		resolved := make(map[string]interface{}, len(config))
   300		for k, v := range config {
   301			if s, ok := v.(string); ok {
   302				if strings.HasPrefix(s, "${") && strings.HasSuffix(s, "}") {
   303					varName := s[2 : len(s)-1]
   304					val, ok := variables[varName]
   305					if !ok {
   306						return nil, fmt.Errorf("undefined variable")
   307					}
   308					setterStep, ok := setter[varName]
   309					if !ok || !depSet[setterStep] {
   310						return nil, fmt.Errorf("variable not in dependency chain")
   311					}
   312					resolved[k] = val
   313					continue
   314				}
   315			}
   316			resolved[k] = v
   317		}
   318		return resolved, nil
   319	}
