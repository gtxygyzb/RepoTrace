   281	
   282	// ExecuteFilter selects elements from the data array based on a comparison condition.
   283	// Supported modes: gt, lt, gte, lte, eq, ne.
   284	func ExecuteFilter(config, input map[string]interface{}) (map[string]interface{}, error) {
   285		data, ok := input["data"].([]interface{})
   286		if !ok {
   287			return nil, fmt.Errorf("filter: missing or invalid 'data' field in input")
   288		}
   289	
   290		mode, _ := config["mode"].(string)
   291		if mode == "" {
   292			return nil, fmt.Errorf("filter: missing 'mode' in config")
   293		}
   294		threshold, _ := config["threshold"].(float64)
   295	
   296		var result []interface{}
   297		for _, v := range data {
   298			val, err := toFloat(v)
   299			if err != nil {
   300				continue
   301			}
   302			var keep bool
   303			switch mode {
   304			case "gt":
   305				keep = val > threshold
   306			case "lt":
   307				keep = val < threshold
   308			case "gte":
   309				keep = val >= threshold
   310			case "lte":
   311				keep = val <= threshold
   312			case "eq":
   313				keep = val == threshold
   314			case "ne":
   315				keep = val != threshold
   316			default:
   317				return nil, fmt.Errorf("filter: unknown mode %q", mode)
   318			}
   319			if keep {
   320				result = append(result, val)
   321			}
   322		}
   323	
   324		if result == nil {
   325			result = []interface{}{}
   326		}
   327		return map[string]interface{}{"data": result}, nil
   328	}
   329	
   330	// Helper functions
   331	
   332	func toFloat(v interface{}) (float64, error) {
   333		switch val := v.(type) {
   334		case float64:
   335			return val, nil
   336		case int:
   337			return float64(val), nil
   338		case int64:
   339			return float64(val), nil
   340		default:
   341			return 0, fmt.Errorf("cannot convert %T to float64", v)
   342		}
   343	}
