   102		t.mu.RLock()
   103		defer t.mu.RUnlock()
   104	
   105		exp, exists := t.experiments[name]
   106		if !exists {
   107			return nil, fmt.Errorf("experiment %q not found", name)
   108		}
   109		return exp, nil
   110	}
   111	
   112	// ListExperiments returns all experiments.
   113	func (t *Tracker) ListExperiments() []*Experiment {
   114		t.mu.RLock()
   115		defer t.mu.RUnlock()
   116	
   117		result := make([]*Experiment, 0, len(t.experiments))
   118		for _, exp := range t.experiments {
   119			result = append(result, exp)
   120		}
