[?2004l   128	func (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, int, error) {
   129		t.mu.RLock()
   130		defer t.mu.RUnlock()
   131	
   132		exp, exists := t.experiments[experimentName]
   133		if !exists {
   134			return 0, 0, fmt.Errorf("experiment %q not found", experimentName)
   135		}
   136	
   137		if len(exp.Runs) == 0 {
   138			return 0, 0, fmt.Errorf("experiment %q has no runs", experimentName)
   139		}
   140	
   141		var values []float64
   142		var weights []float64
   143		for _, run := range exp.Runs {
   144			value, ok := run.Metrics[metricName]
   145			if !ok {
   146				continue
   147			}
   148			values = append(values, value)
   149			if aggType == "weighted_mean" {
   150				weight, ok := run.Parameters[weightParam]
   151				if !ok {
   152					continue
   153				}
   154				weights = append(weights, weight)
   155			}
   156		}
   157	
   158		if len(values) == 0 {
   159			return 0, 0, fmt.Errorf("no values found for metric %q", metricName)
   160		}
   161	
   162		switch aggType {
   163		case "mean":
   164			sum := 0.0
   165			for _, v := range values {
   166				sum += v
   167			}
   168			return sum / float64(len(values)), len(values), nil
   169	
   170		case "median":
   171			sorted := sortedCopy(values)
   172			n := len(sorted)
   173			if n%2 == 0 {
   174				return (sorted[n/2-1] + sorted[n/2]) / 2, len(values), nil
   175			}
   176			return sorted[n/2], len(values), nil
   177	
   178		case "p95":
   179			sorted := sortedCopy(values)
   180			return percentile(sorted, 0.95), len(values), nil
   181	
   182		case "p99":
   183			sorted := sortedCopy(values)
   184			return percentile(sorted, 0.99), len(values), nil
   185	
   186		case "weighted_mean":
   187			if weightParam == "" {
   188				return 0, 0, fmt.Errorf("weighted_mean requires weight parameter")
   189			}
   190			if len(weights) == 0 {
   191				return 0, 0, fmt.Errorf("no runs with metric %q and weight parameter %q", metricName, weightParam)
   192			}
   193			if len(weights) != len(values) {
   194				return 0, 0, fmt.Errorf("mismatch between metric values and weights")
   195			}
   196			weightedSum := 0.0
   197			weightSum := 0.0
   198			for i, v := range values {
   199				weightedSum += v * weights[i]
   200				weightSum += weights[i]
   201			}
   202			if weightSum == 0 {
   203				return 0, 0, fmt.Errorf("weighted_mean has zero total weight")
   204			}
   205			return weightedSum / weightSum, len(values), nil
   206	
   207		default:
   208			return 0, 0, fmt.Errorf("unknown aggregation type %q", aggType)
   209		}
   210	}
