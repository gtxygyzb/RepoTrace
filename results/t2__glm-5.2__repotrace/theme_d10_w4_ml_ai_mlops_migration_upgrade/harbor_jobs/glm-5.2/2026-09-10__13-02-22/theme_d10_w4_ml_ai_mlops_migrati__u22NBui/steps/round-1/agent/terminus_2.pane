    69	// Server manages model loading and inference.
    70	type Server struct {
    71		mu       sync.RWMutex
    72		loaded   map[string]*LoadedModel
    73		registry *registry.Registry
    74		stats    Stats
    75	}
    76	
    77	// NewServer creates a new serving server backed by the given registry.
    78	func NewServer(reg *registry.Registry) *Server {
    79		return &Server{
    80			loaded:   make(map[string]*LoadedModel),
    81			registry: reg,
    82			stats: Stats{
    83				Models: make(map[string]*ModelStats),
    84			},
    85		}
    86	}
    87	
    88	// LoadModel loads a model version for serving. Specify either versionNum > 0
    89	// or a non-empty stage string (not both).
    90	func (s *Server) LoadModel(modelName string, versionNum int, stage string) error {
    91		var version *registry.Version
    92		var err error
    93	
    94		if versionNum > 0 {
    95			version, err = s.registry.GetVersion(modelName, versionNum)
    96		} else if stage != "" {
    97			version, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))
    98		} else {
    99			return fmt.Errorf("must specify version number or stage")
   100		}
   101	
   102		if err != nil {
   103			return fmt.Errorf("load model: %w", err)
   104		}
   105	
   106		s.mu.Lock()
   107		defer s.mu.Unlock()
   108	
   109		s.loaded[modelName] = &LoadedModel{
   110			ModelName:   modelName,
   111			VersionNum:  version.Number,
   112			Stage:       version.Stage,
   113			ModelConfig: version.ModelConfig,
   114			LoadedAt:    time.Now(),
   115		}
   116		return nil
   117	}
   118	
   119	// UnloadModel removes a model from the serving cache.
   120	func (s *Server) UnloadModel(modelName string) error {
   121		s.mu.Lock()
   122		defer s.mu.Unlock()
   123	
   124		if _, exists := s.loaded[modelName]; !exists {
   125			return fmt.Errorf("model %q is not loaded", modelName)
   126		}
   127		delete(s.loaded, modelName)
   128		return nil
   129	}
   130	
   131	// Infer runs inference on the loaded model and returns predictions.
   132	func (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {
   133		start := time.Now()
   134	
   135		s.mu.RLock()
   136		loaded, exists := s.loaded[req.ModelName]
   137		s.mu.RUnlock()
   138	
   139		if !exists {
   140			return nil, fmt.Errorf("model %q is not loaded for serving", req.ModelName)
   141		}
   142	
   143		predictions, err := computePrediction(loaded.ModelConfig, req.Input)
   144		if err != nil {
   145			return nil, fmt.Errorf("inference error: %w", err)
   146		}
   147	
   148		latency := float64(time.Since(start).Microseconds()) / 1000.0
   149	
   150		return &InferenceResponse{
   151			ModelName:   req.ModelName,
   152			Version:     loaded.VersionNum,
   153			Predictions: predictions,
   154			LatencyMs:   latency,
   155		}, nil
   156	}
   157	
   158	// RecordRequest updates serving statistics for a single inference request.
   159	func (s *Server) RecordRequest(modelName string, successful bool, latencyMs float64) {
   160		s.mu.Lock()
   161		defer s.mu.Unlock()
   162	
   163		s.stats.TotalRequests++
   164		if successful {
   165			s.stats.Successful++
   166			s.stats.LatencySum += latencyMs
   167		} else {
   168			s.stats.Failed++
   169		}
   170	
   171		model := s.stats.Models[modelName]
   172		if model == nil {
   173			model = &ModelStats{}
   174			s.stats.Models[modelName] = model
   175		}
   176		model.Requests++
   177		if successful {
   178			model.Successful++
   179			model.LatencySum += latencyMs
   180		} else {
   181			model.Failed++
   182		}
   183	}
   184	
   185	// GetStats returns a snapshot of accumulated serving statistics.
   186	func (s *Server) GetStats() StatsResponse {
   187		s.mu.RLock()
   188		defer s.mu.RUnlock()
   189	
   190		resp := StatsResponse{
   191			TotalRequests: s.stats.TotalRequests,
   192			Successful:    s.stats.Successful,
   193			Failed:        s.stats.Failed,
   194			Models:        make(map[string]ModelStatsResponse),
   195		}
   196		if s.stats.Successful > 0 {
   197			resp.AvgLatencyMs = s.stats.LatencySum / float64(s.stats.Successful)
   198		}
   199	
   200		for name, model := range s.stats.Models {
   201			m := ModelStatsResponse{
   202				Requests:   model.Requests,
   203				Successful: model.Successful,
   204				Failed:     model.Failed,
   205			}
   206			if model.Successful > 0 {
   207				m.AvgLatencyMs = model.LatencySum / float64(model.Successful)
   208			}
   209			if model.Requests > 0 {
   210				m.SuccessRate = float64(model.Successful) / float64(model.Requests)
   211			}
   212			resp.Models[name] = m
   213		}
   214		return resp
   215	}
   216	
   217	// ResetStats resets all serving statistics to zero.
   218	func (s *Server) ResetStats() {
   219		s.mu.Lock()
   220		defer s.mu.Unlock()
   221	
   222		s.stats = Stats{
   223			Models: make(map[string]*ModelStats),
   224		}
   225	}
   226	
   227	// ListLoaded returns all currently loaded models.
   228	func (s *Server) ListLoaded() []*LoadedModel {
   229		s.mu.RLock()
   230		defer s.mu.RUnlock()
   231	
   232		result := make([]*LoadedModel, 0, len(s.loaded))
   233		for _, lm := range s.loaded {
   234			result = append(result, lm)
   235		}
   236		return result
   237	}
