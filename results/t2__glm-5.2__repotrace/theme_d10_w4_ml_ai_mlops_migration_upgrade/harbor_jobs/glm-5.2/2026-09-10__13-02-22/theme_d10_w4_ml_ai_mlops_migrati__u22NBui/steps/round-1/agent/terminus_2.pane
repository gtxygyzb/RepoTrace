   144	// --- Pipeline Handlers ---
   145	
   146	func (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {
   147		var req struct {
   148			Name     string                 `json:"name"`
   149			Steps    []*pipeline.Step       `json:"steps"`
   150			Input    map[string]interface{} `json:"input"`
   151			Pipeline *pipeline.Pipeline     `json:"pipeline"`
   152		}
   153		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   154			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   155			return
   156		}
   157		p := req.Pipeline
   158		if p == nil {
   159			p = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}
   160		}
   161		if p == nil || len(p.Steps) == 0 {
   162			writeError(w, http.StatusBadRequest, "pipeline with at least one step is required")
   163			return
   164		}
   165		if req.Input == nil {
   166			req.Input = make(map[string]interface{})
   167		}
   168	
   169		result, err := h.Pipeline.Execute(p, req.Input)
   170		if err != nil {
   171			writeError(w, http.StatusBadRequest, "%v", err)
   172			return
   173		}
   174		writeJSON(w, http.StatusOK, result)
   175	}
