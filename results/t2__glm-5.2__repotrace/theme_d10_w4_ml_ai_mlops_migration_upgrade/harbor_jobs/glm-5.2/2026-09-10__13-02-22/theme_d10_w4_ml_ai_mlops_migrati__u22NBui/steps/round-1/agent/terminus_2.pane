   222	// ListModels returns all models matching the optional filter.
   223	func (r *Registry) ListModels(filter *ModelFilter) ([]*Model, error) {
   224		r.mu.RLock()
   225		defer r.mu.RUnlock()
   226	
   227		var result []*Model
   228		for _, model := range r.models {
   229			if filter != nil {
   230				if filter.Framework != "" && model.Framework != filter.Framework {
   231					continue
   232				}
   233				if filter.Tag != "" {
   234					hasTag := false
   235					for _, t := range model.Tags {
   236						if t == filter.Tag {
   237							hasTag = true
   238							break
   239						}
   240					}
   241					if !hasTag {
   242						continue
   243					}
   244				}
   245			}
   246			result = append(result, model)
   247		}
   248		sort.Slice(result, func(i, j int) bool {
   249			return result[i].Name < result[j].Name
   250		})
   251		return result, nil
   252	}
   253	
   254	// DeleteModel removes a model from the registry.
   255	func (r *Registry) DeleteModel(name string) error {
   256		r.mu.Lock()
   257		defer r.mu.Unlock()
   258	
   259		if _, exists := r.models[name]; !exists {
   260			return fmt.Errorf("model %q not found", name)
   261		}
   262	
   263		delete(r.models, name)
   264		filename := filepath.Join(r.dataDir, name+".json")
   265		os.Remove(filename)
   266		return nil
   267	}
   268	
   269	// GetVersion returns a specific version of a model.
   270	func (r *Registry) GetVersion(modelName string, versionNum int) (*Version, error) {
   271		r.mu.RLock()
   272		defer r.mu.RUnlock()
   273	
   274		model, exists := r.models[modelName]
   275		if !exists {
   276			return nil, fmt.Errorf("model %q not found", modelName)
   277		}
   278	
   279		for _, v := range model.Versions {
   280			if v.Number == versionNum {
   281				return v, nil
   282			}
   283		}
   284		return nil, fmt.Errorf("version %d not found for model %q", versionNum, modelName)
   285	}
   286	
   287	// GetVersionByStage returns the version of a model currently in the specified stage.
   288	func (r *Registry) GetVersionByStage(modelName string, stage Stage) (*Version, error) {
   289		r.mu.RLock()
   290		defer r.mu.RUnlock()
   291	
   292		model, exists := r.models[modelName]
   293		if !exists {
   294			return nil, fmt.Errorf("model %q not found", modelName)
   295		}
   296	
   297		for _, v := range model.Versions {
   298			if v.Stage == stage {
   299				return v, nil
   300			}
   301		}
   302		return nil, fmt.Errorf("no version in stage %s for model %q", stage, modelName)
   303	}
   304	
   305	// ValidateAnnotationKey returns true if key is non-empty and contains only
   306	// letters, digits, and underscores.
   307	func ValidateAnnotationKey(key string) bool {
   308		return validateAnnotationKey(key)
   309	}
   310	
   311	// findVersionLocked returns the version pointer for the given model and version number.
   312	// The caller must hold an appropriate lock.
   313	func (r *Registry) findVersionLocked(modelName string, versionNum int) (*Model, *Version, error) {
   314		model, exists := r.models[modelName]
   315		if !exists {
   316			return nil, nil, fmt.Errorf("model %q not found", modelName)
   317		}
   318	
   319		for _, v := range model.Versions {
   320			if v.Number == versionNum {
   321				return model, v, nil
   322			}
   323		}
   324		return nil, nil, fmt.Errorf("version %d not found for model %q", versionNum, modelName)
   325	}
   326	
   327	// validateAnnotationKey returns true if key is non-empty and contains only
   328	// letters, digits, and underscores.
   329	func validateAnnotationKey(key string) bool {
   330		return annotationKeyRegexp.MatchString(key)
   331	}
   332	
   333	// AddAnnotation attaches a new key-value annotation to a model version.
   334	func (r *Registry) AddAnnotation(modelName string, versionNum int, key, value string) (*Annotation, error) {
   335		r.mu.Lock()
   336		defer r.mu.Unlock()
   337	
   338		if _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {
   339			return nil, err
   340		}
   341		if !validateAnnotationKey(key) {
   342			return nil, fmt.Errorf("invalid annotation key")
   343		}
   344	
   345		if r.annotations[modelName] == nil {
   346			r.annotations[modelName] = make(map[int]map[string]*Annotation)
   347		}
   348		if r.annotations[modelName][versionNum] == nil {
   349			r.annotations[modelName][versionNum] = make(map[string]*Annotation)
   350		}
   351		if _, exists := r.annotations[modelName][versionNum][key]; exists {
   352			return nil, fmt.Errorf("annotation %q already exists", key)
   353		}
   354	
   355		annotation := &Annotation{
   356			Key:       key,
   357			Value:     value,
   358			CreatedAt: time.Now(),
   359		}
   360		r.annotations[modelName][versionNum][key] = annotation
   361		return annotation, nil
   362	}
   363	
   364	// ListAnnotations returns all annotations for a model version sorted by key.
   365	func (r *Registry) ListAnnotations(modelName string, versionNum int) ([]*Annotation, error) {
   366		r.mu.RLock()
   367		defer r.mu.RUnlock()
   368	
   369		if _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {
   370			return nil, err
   371		}
   372	
   373		var annotations []*Annotation
   374		if versions, ok := r.annotations[modelName]; ok {
   375			if keys, ok := versions[versionNum]; ok {
   376				for _, a := range keys {
   377					annotations = append(annotations, a)
   378				}
   379			}
   380		}
   381		sort.Slice(annotations, func(i, j int) bool {
   382			return annotations[i].Key < annotations[j].Key
   383		})
   384		if annotations == nil {
   385			annotations = []*Annotation{}
   386		}
   387		return annotations, nil
   388	}
   389	
   390	// DeleteAnnotation removes a specific annotation from a model version.
   391	func (r *Registry) DeleteAnnotation(modelName string, versionNum int, key string) error {
   392		r.mu.Lock()
   393		defer r.mu.Unlock()
   394	
   395		if _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {
   396			return err
   397		}
   398	
   399		if r.annotations[modelName] == nil || r.annotations[modelName][versionNum] == nil {
   400			return fmt.Errorf("annotation %q not found", key)
   401		}
   402		if _, exists := r.annotations[modelName][versionNum][key]; !exists {
   403			return fmt.Errorf("annotation %q not found", key)
   404		}
   405		delete(r.annotations[modelName][versionNum], key)
   406		return nil
   407	}
   408	
   409	// AnnotationsMap returns a map of annotation key to value for a model version.
   410	func (r *Registry) AnnotationsMap(modelName string, versionNum int) map[string]string {
   411		r.mu.RLock()
   412		defer r.mu.RUnlock()
   413	
   414		result := make(map[string]string)
   415		if versions, ok := r.annotations[modelName]; ok {
   416			if keys, ok := versions[versionNum]; ok {
   417				for k, a := range keys {
   418					result[k] = a.Value
   419				}
   420			}
   421		}
   422		return result
   423	}
   424	
   425	// loadAll reads all model files from the data directory.
   426	func (r *Registry) loadAll() error {
   427		entries, err := os.ReadDir(r.dataDir)
   428		if err != nil {
   429			if os.IsNotExist(err) {
   430				return nil
   431			}
   432			return err
   433		}
   434		for _, entry := range entries {
   435			if !entry.IsDir() && filepath.Ext(entry.Name()) == ".json" {
   436				data, err := os.ReadFile(filepath.Join(r.dataDir, entry.Name()))
   437				if err != nil {
   438					return err
   439				}
   440				var model Model
   441				if err := json.Unmarshal(data, &model); err != nil {
   442					return err
   443				}
   444				r.models[model.Name] = &model
   445			}
   446		}
   447		return nil
   448	}
   449	
   450	// saveModel writes a model's data to its JSON file.
   451	func (r *Registry) saveModel(model *Model) error {
   452		data, err := json.MarshalIndent(model, "", "  ")
   453		if err != nil {
   454			return err
   455		}
   456		filename := filepath.Join(r.dataDir, model.Name+".json")
   457		return os.WriteFile(filename, data, 0644)
   458	}
