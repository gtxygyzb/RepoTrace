   411	func (t *Tracker) saveExperiment(exp *Experiment) error {
   412		data, err := json.MarshalIndent(exp, "", "  ")
   413		if err != nil {
   414			return err
   415		}
   416		filename := filepath.Join(t.dataDir, exp.Name+".json")
   417		return os.WriteFile(filename, data, 0644)
