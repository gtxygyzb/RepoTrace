   239		if err != nil {
   240			writeError(w, http.StatusBadRequest, "%v", err)
   241			return
   242		}
   243	
   244		exp, _ := h.Experiment.GetExperiment(expName)
   245		runCount := 0
   246		if exp != nil {
   247			runCount = len(exp.Runs)
   248		}
   249		writeJSON(w, http.StatusOK, map[string]interface{}{
   250			"experiment": expName,
   251			"metric":     metricName,
   252			"type":       aggType,
   253			"value":      result,
   254			"count":      runCount,
   255		})
