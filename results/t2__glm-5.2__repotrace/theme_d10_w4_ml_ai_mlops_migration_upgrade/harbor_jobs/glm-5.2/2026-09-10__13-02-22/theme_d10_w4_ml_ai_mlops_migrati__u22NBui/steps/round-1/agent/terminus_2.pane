   213	func (h *Handlers) LogRun(w http.ResponseWriter, r *http.Request) {
   214		expName := r.PathValue("name")
   215	
   216		var req struct {
   217			Parameters map[string]float64 `json:"parameters"`
   218			Metrics    map[string]float64 `json:"metrics"`
   219			Tags       map[string]string  `json:"tags"`
   220		}
   221		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   222			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   223			return
   224		}
   225	
   226		run, err := h.Experiment.LogRun(expName, req.Parameters, req.Metrics, req.Tags)
   227		if err != nil {
   228			writeError(w, http.StatusNotFound, "%v", err)
   229			return
   230		}
   231		writeJSON(w, http.StatusCreated, run)
   232	}
   233	
   234	func (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {
   235		expName := r.PathValue("name")
   236		metricName := r.PathValue("metric")
   237		aggType := r.URL.Query().Get("type")
   238		weightParam := r.URL.Query().Get("weight_param")
   239	
   240		if aggType == "" {
   241			writeError(w, http.StatusBadRequest, "query parameter 'type' is required")
   242			return
   243		}
   244	
   245		result, count, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam)
   246		if err != nil {
   247			writeError(w, http.StatusBadRequest, "%v", err)
   248			return
   249		}
   250	
   251		writeJSON(w, http.StatusOK, map[string]interface{}{
   252			"experiment": expName,
   253			"metric":     metricName,
   254			"type":       aggType,
   255			"value":      result,
   256			"count":      count,
   257		})
   258	}
