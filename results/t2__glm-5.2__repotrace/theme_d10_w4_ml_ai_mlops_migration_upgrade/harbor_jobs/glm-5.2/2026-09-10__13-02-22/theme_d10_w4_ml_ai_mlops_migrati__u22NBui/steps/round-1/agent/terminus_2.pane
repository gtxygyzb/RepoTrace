   261	func (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {
   262		expName := r.PathValue("name")
   263		metricName := r.PathValue("metric")
   264		aggType := r.URL.Query().Get("type")
   265		weightParam := r.URL.Query().Get("weight_param")
   266		tagFilters := map[string]string{}
   267		for _, filter := range r.URL.Query()["tag_filter"] {
   268			parts := strings.SplitN(filter, ":", 2)
   269			if len(parts) != 2 {
   270				writeError(w, http.StatusBadRequest, "invalid tag_filter %q, expected key:value", filter)
   271				return
   272			}
   273			tagFilters[parts[0]] = parts[1]
   274		}
   275	
   276		if aggType == "" {
   277			writeError(w, http.StatusBadRequest, "query parameter 'type' is required")
   278			return
   279		}
   280	
   281		result, count, runIDs, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam, tagFilters)
   282		if err != nil {
   283			writeError(w, http.StatusBadRequest, "%v", err)
   284			return
   285		}
   286	
   287		writeJSON(w, http.StatusOK, map[string]interface{}{
   288			"experiment": expName,
   289			"metric":     metricName,
   290			"type":       aggType,
   291			"value":      result,
   292			"count":      count,
   293			"run_ids":    runIDs,
   294		})
   295	}
