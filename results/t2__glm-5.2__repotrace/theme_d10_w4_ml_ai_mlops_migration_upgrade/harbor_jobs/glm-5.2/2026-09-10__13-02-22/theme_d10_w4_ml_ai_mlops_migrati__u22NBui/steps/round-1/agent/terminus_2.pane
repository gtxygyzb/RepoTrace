   130	// Infer runs inference on the loaded model and returns predictions.
   131	func (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {
   132		start := time.Now()
   133	
   134		s.mu.RLock()
   135		loaded, exists := s.loaded[req.ModelName]
   136		s.mu.RUnlock()
   137	
   138		if !exists {
   139			return nil, fmt.Errorf("model %q is not loaded for serving", req.ModelName)
   140		}
   141	
   142		predictions, err := computePrediction(loaded.ModelConfig, req.Input)
   143		if err != nil {
   144			return nil, fmt.Errorf("inference error: %w", err)
   145		}
   146	
   147		latency := float64(time.Since(start).Microseconds()) / 1000.0
   148	
   149		return &InferenceResponse{
   150			ModelName:   req.ModelName,
   151			Version:     loaded.VersionNum,
   152			Predictions: predictions,
   153			LatencyMs:   latency,
   154		}, nil
   155	}
   156	
   157	// RecordRequest updates serving statistics for a single inference request.
   158	func (s *Server) RecordRequest(modelName string, successful bool, latencyMs float64) {
   159		s.mu.Lock()
   160		defer s.mu.Unlock()
   161	
   162		s.stats.TotalRequests++
   163		if successful {
   164			s.stats.Successful++
   165			s.stats.LatencySum += latencyMs
   166		} else {
   167			s.stats.Failed++
   168		}
   169	
   170		model := s.stats.Models[modelName]
   171		if model == nil {
   172			model = &ModelStats{}
   173			s.stats.Models[modelName] = model
   174		}
   175		model.Requests++
   176		if successful {
   177			model.Successful++
   178			model.LatencySum += latencyMs
   179		} else {
   180			model.Failed++
   181		}
   182	}
   183	
   184	// GetStats returns a snapshot of accumulated serving statistics.
   185	func (s *Server) GetStats() StatsResponse {
   186		s.mu.RLock()
   187		defer s.mu.RUnlock()
   188	
   189		resp := StatsResponse{
   190			TotalRequests: s.stats.TotalRequests,
   191			Successful:    s.stats.Successful,
   192			Failed:        s.stats.Failed,
   193			Models:        make(map[string]ModelStatsResponse),
   194		}
   195		if s.stats.Successful > 0 {
   196			resp.AvgLatencyMs = s.stats.LatencySum / float64(s.stats.Successful)
   197		}
   198	
   199		for name, model := range s.stats.Models {
   200			m := ModelStatsResponse{
   201				Requests:   model.Requests,
   202				Successful: model.Successful,
   203				Failed:     model.Failed,
   204			}
   205			if model.Successful > 0 {
   206				m.AvgLatencyMs = model.LatencySum / float64(model.Successful)
   207			}
   208			resp.Models[name] = m
   209		}
   210		return resp
   211	}
   212	
   213	// ResetStats resets all serving statistics to zero.
   214	func (s *Server) ResetStats() {
   215		s.mu.Lock()
   216		defer s.mu.Unlock()
   217	
   218		s.stats = Stats{
   219			Models: make(map[string]*ModelStats),
   220		}
   221	}
   222	
   223	// ListLoaded returns all currently loaded models.
   224	func (s *Server) ListLoaded() []*LoadedModel {
   225		s.mu.RLock()
   226		defer s.mu.RUnlock()
   227	
   228		result := make([]*LoadedModel, 0, len(s.loaded))
   229		for _, lm := range s.loaded {
   230			result = append(result, lm)
   231		}
   232		return result
   233	}
