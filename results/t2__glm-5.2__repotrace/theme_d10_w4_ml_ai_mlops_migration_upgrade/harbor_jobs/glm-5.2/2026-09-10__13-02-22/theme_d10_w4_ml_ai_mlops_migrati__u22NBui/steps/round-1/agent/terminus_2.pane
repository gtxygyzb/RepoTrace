    10	
    11	// LoadedModel tracks a model version currently loaded for serving.
    12	type LoadedModel struct {
    13		ModelName   string                 `json:"model_name"`
    14		VersionNum  int                    `json:"version_num"`
    15		Stage       registry.Stage         `json:"stage"`
    16		ModelConfig map[string]interface{} `json:"model_config"`
    17		LoadedAt    time.Time              `json:"loaded_at"`
    18	}
    19	
    20	// InferenceRequest contains the input data for model inference.
    21	type InferenceRequest struct {
    22		ModelName string    `json:"model_name"`
    23		Input     []float64 `json:"input"`
    24	}
    25	
    26	// InferenceResponse contains the model prediction results.
    27	type InferenceResponse struct {
    28		ModelName   string      `json:"model_name"`
    29		Version     interface{} `json:"version"`
    30		Predictions []float64   `json:"predictions"`
    31		LatencyMs   float64     `json:"latency_ms"`
    32	}
    33	
    34	// Server manages model loading and inference.
    35	type Server struct {
    36		mu       sync.RWMutex
    37		loaded   map[string]*LoadedModel
    38		registry *registry.Registry
    39	}
    40	
    41	// NewServer creates a new serving server backed by the given registry.
    42	func NewServer(reg *registry.Registry) *Server {
    43		return &Server{
    44			loaded:   make(map[string]*LoadedModel),
    45			registry: reg,
    46		}
    47	}
    48	
    49	// LoadModel loads a model version for serving. Specify either versionNum > 0
    50	// or a non-empty stage string (not both).
    51	func (s *Server) LoadModel(modelName string, versionNum int, stage string) error {
    52		var version *registry.Version
    53		var err error
    54	
    55		if versionNum > 0 {
    56			version, err = s.registry.GetVersion(modelName, versionNum)
    57		} else if stage != "" {
    58			version, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))
    59		} else {
    60			return fmt.Errorf("must specify version number or stage")
    61		}
    62	
    63		if err != nil {
    64			return fmt.Errorf("load model: %w", err)
    65		}
    66	
    67		s.mu.Lock()
    68		defer s.mu.Unlock()
    69	
    70		s.loaded[modelName] = &LoadedModel{
    71			ModelName:   modelName,
    72			VersionNum:  version.Number,
    73			Stage:       version.Stage,
    74			ModelConfig: version.ModelConfig,
    75			LoadedAt:    time.Now(),
    76		}
    77		return nil
    78	}
    79	
    80	// UnloadModel removes a model from the serving cache.
    81	func (s *Server) UnloadModel(modelName string) error {
    82		s.mu.Lock()
    83		defer s.mu.Unlock()
    84	
    85		if _, exists := s.loaded[modelName]; !exists {
    86			return fmt.Errorf("model %q is not loaded", modelName)
    87		}
    88		delete(s.loaded, modelName)
    89		return nil
    90	}
    91	
    92	// Infer runs inference on the loaded model and returns predictions.
    93	func (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {
    94		start := time.Now()
    95	
    96		s.mu.RLock()
    97		loaded, exists := s.loaded[req.ModelName]
    98		s.mu.RUnlock()
    99	
   100		if !exists {
   101			return nil, fmt.Errorf("model %q is not loaded for serving", req.ModelName)
   102		}
   103	
   104		predictions, err := computePrediction(loaded.ModelConfig, req.Input)
   105		if err != nil {
   106			return nil, fmt.Errorf("inference error: %w", err)
   107		}
   108	
   109		latency := float64(time.Since(start).Microseconds()) / 1000.0
   110	
   111		return &InferenceResponse{
   112			ModelName:   req.ModelName,
   113			Version:     string(loaded.Stage),
   114			Predictions: predictions,
   115			LatencyMs:   latency,
   116		}, nil
   117	}
   118	
   119	// ListLoaded returns all currently loaded models.
   120	func (s *Server) ListLoaded() []*LoadedModel {
   121		s.mu.RLock()
   122		defer s.mu.RUnlock()
   123	
   124		result := make([]*LoadedModel, 0, len(s.loaded))
   125		for _, lm := range s.loaded {
   126			result = append(result, lm)
   127		}
   128		return result
   129	}
   130	
   131	// computePrediction evaluates a model against input data.
   132	// Supported model types: linear, polynomial.
   133	func computePrediction(modelConfig map[string]interface{}, input []float64) ([]float64, error) {
   134		if modelConfig == nil {
   135			return nil, fmt.Errorf("model has no configuration")
   136		}
   137	
   138		modelType, _ := modelConfig["model_type"].(string)
   139		switch modelType {
   140		case "linear":
   141			return linearPredict(modelConfig, input)
   142		case "polynomial":
   143			return polynomialPredict(modelConfig, input)
   144		default:
   145			return nil, fmt.Errorf("unsupported model type: %s", modelType)
   146		}
   147	}
   148	
   149	// linearPredict computes y = sum(weights[i] * input[i]) + bias
   150	func linearPredict(config map[string]interface{}, input []float64) ([]float64, error) {
   151		weightsRaw, ok := config["weights"].([]interface{})
   152		if !ok {
   153			return nil, fmt.Errorf("linear model missing weights")
   154		}
   155		bias, _ := config["bias"].(float64)
   156	
   157		weights := make([]float64, len(weightsRaw))
   158		for i, w := range weightsRaw {
   159			wf, ok := w.(float64)
   160			if !ok {
   161				return nil, fmt.Errorf("weight %d is not a number", i)
   162			}
   163			weights[i] = wf
   164		}
   165	
   166		prediction := bias
   167		for i := 0; i < len(weights) && i < len(input); i++ {
   168			prediction += weights[i] * input[i]
   169		}
   170	
   171		return []float64{prediction}, nil
   172	}
   173	
   174	// polynomialPredict computes y = sum(coefficients[i] * x^i) for each input x
   175	func polynomialPredict(config map[string]interface{}, input []float64) ([]float64, error) {
   176		coeffRaw, ok := config["coefficients"].([]interface{})
   177		if !ok {
   178			return nil, fmt.Errorf("polynomial model missing coefficients")
   179		}
   180	
   181		coefficients := make([]float64, len(coeffRaw))
   182		for i, c := range coeffRaw {
   183			cf, ok := c.(float64)
   184			if !ok {
   185				return nil, fmt.Errorf("coefficient %d is not a number", i)
   186			}
   187			coefficients[i] = cf
   188		}
   189	
   190		predictions := make([]float64, len(input))
   191		for j, x := range input {
   192			y := 0.0
   193			xPow := x
   194			for _, c := range coefficients {
   195				y += c * xPow
   196				xPow *= x
   197			}
   198			predictions[j] = y
   199		}
   200	
   201		return predictions, nil
   202	}
