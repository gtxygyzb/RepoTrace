   540	// mergeDependencyOutputs concatenates the "data" arrays from all dependency outputs into a single input.
   541	func mergeDependencyOutputs(deps []string, outputs map[string]map[string]interface{}) map[string]interface{} {
   542		merged := make([]interface{}, 0)
   543		for _, dep := range deps {
   544			out, ok := outputs[dep]
   545			if !ok {
   546				continue
   547			}
   548			switch data := out["data"].(type) {
   549			case []interface{}:
   550				merged = append(merged, data...)
   551			case []float64:
   552				for _, v := range data {
   553					merged = append(merged, v)
   554				}
   555			}
   556		}
   557		return map[string]interface{}{"data": merged}
   558	}
