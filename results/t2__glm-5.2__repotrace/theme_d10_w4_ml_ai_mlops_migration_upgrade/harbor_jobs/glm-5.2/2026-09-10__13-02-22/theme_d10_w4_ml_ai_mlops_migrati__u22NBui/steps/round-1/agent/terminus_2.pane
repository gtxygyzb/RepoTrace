[?2004l[?2004h> s = p.read_text()
[?2004l[?2004h> insert = '''
[?2004l[?2004h> 
[?2004l[?2004h> // ExecuteSleep sleeps for a configured duration and passes input data through.
[?2004l[?2004h> func ExecuteSleep(config, input map[string]interface{}) (map[string]interface{}, error) {
[?2004l[?2004h> \tval, ok := config["duration_ms"]
[?2004l[?2004h> \tif !ok {
[?2004l[?2004h> \t\treturn nil, fmt.Errorf("sleep: missing 'duration_ms' in config")
[?2004l[?2004h> \t}
[?2004l[?2004h> \tdurationMs, err := toFloat(val)
[?2004l[?2004h> \tif err != nil {
[?2004l[?2004h> \t\treturn nil, fmt.Errorf("sleep: 'duration_ms' must be a number")
[?2004l[?2004h> \t}
[?2004l[?2004h> \tif durationMs < 0 {
[?2004l[?2004h> \t\treturn nil, fmt.Errorf("sleep: 'duration_ms' must be non-negative")
[?2004l[?2004h> \t}
[?2004l[?2004h> \ttime.Sleep(time.Duration(durationMs) * time.Millisecond)
[?2004l[?2004h> \treturn map[string]interface{}{"data": input["data"]}, nil
[?2004l[?2004h> }
[?2004l[?2004h> '''
