   289		}
   290		writeJSON(w, http.StatusOK, map[string]string{"status": "unloaded"})
   291	}
   292	
   293	func (h *Handlers) ListLoadedModels(w http.ResponseWriter, r *http.Request) {
   294		models := h.Serving.ListLoaded()
