   388		entries, err := os.ReadDir(t.dataDir)
   389		if err != nil {
   390			return
   391		}
   392		for _, entry := range entries {
   393			if !entry.IsDir() && filepath.Ext(entry.Name()) == ".json" {
   394				data, err := os.ReadFile(filepath.Join(t.dataDir, entry.Name()))
   395				if err != nil {
   396					continue
   397				}
   398				var exp Experiment
   399				if err := json.Unmarshal(data, &exp); err != nil {
   400					continue
   401				}
   402				t.experiments[exp.Name] = &exp
   403				for _, r := range exp.Runs {
   404					_ = r
   405					t.runCounter++
   406				}
   407			}
   408		}
   409	}
