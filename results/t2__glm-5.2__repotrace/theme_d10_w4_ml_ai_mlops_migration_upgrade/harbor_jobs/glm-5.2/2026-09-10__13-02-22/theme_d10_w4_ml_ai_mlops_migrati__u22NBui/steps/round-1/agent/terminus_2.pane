    14	// --- Model Registry Handlers ---
    15	
    16	func (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {
    17		var req struct {
    18			Name        string   `json:"name"`
    19			Framework   string   `json:"framework"`
    20			Description string   `json:"description"`
    21			Tags        []string `json:"tags"`
    22		}
    23		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
    24			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
    25			return
    26		}
    27		if req.Name == "" {
    28			writeError(w, http.StatusBadRequest, "name is required")
    29			return
    30		}
    31	
    32		model, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)
    33		if err != nil {
    34			writeError(w, http.StatusConflict, "%v", err)
    35			return
    36		}
    37		writeJSON(w, http.StatusCreated, model)
    38	}
    39	
    40	func (h *Handlers) ListModels(w http.ResponseWriter, r *http.Request) {
    41		var filter *registry.ModelFilter
    42		framework := r.URL.Query().Get("framework")
    43		tag := r.URL.Query().Get("tag")
    44		if framework != "" || tag != "" {
    45			filter = &registry.ModelFilter{Framework: framework, Tag: tag}
    46		}
    47	
    48		models, err := h.Registry.ListModels(filter)
    49		if err != nil {
    50			writeError(w, http.StatusInternalServerError, "%v", err)
    51			return
    52		}
    53		writeJSON(w, http.StatusOK, models)
    54	}
    55	
    56	func (h *Handlers) DeleteModel(w http.ResponseWriter, r *http.Request) {
    57		name := r.PathValue("name")
    58		if err := h.Registry.DeleteModel(name); err != nil {
    59			writeError(w, http.StatusNotFound, "%v", err)
    60			return
    61		}
    62		_ = h.Serving.UnloadModel(name)
    63		writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
    64	}
    65	
    66	func (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {
    67		name := r.PathValue("name")
    68		model, err := h.Registry.GetModel(name)
    69		if err != nil {
    70			writeError(w, http.StatusNotFound, "%v", err)
    71			return
    72		}
    73		writeJSON(w, http.StatusOK, model)
    74	}
    75	
    76	func (h *Handlers) CreateVersion(w http.ResponseWriter, r *http.Request) {
    77		modelName := r.PathValue("name")
    78	
    79		var req struct {
    80			Metrics     map[string]float64     `json:"metrics"`
    81			Tags        []string               `json:"tags"`
    82			ModelConfig map[string]interface{} `json:"model_config"`
    83		}
    84		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
    85			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
    86			return
    87		}
    88	
    89		version, err := h.Registry.CreateVersion(modelName, req.Metrics, req.Tags, req.ModelConfig)
    90		if err != nil {
    91			writeError(w, http.StatusNotFound, "%v", err)
    92			return
    93		}
    94		writeJSON(w, http.StatusCreated, version)
    95	}
    96	
    97	func (h *Handlers) GetVersion(w http.ResponseWriter, r *http.Request) {
    98		modelName := r.PathValue("name")
    99		numStr := r.PathValue("num")
   100		num, err := strconv.Atoi(numStr)
   101		if err != nil {
   102			writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
   103			return
   104		}
   105	
   106		version, err := h.Registry.GetVersion(modelName, num)
   107		if err != nil {
   108			writeError(w, http.StatusNotFound, "%v", err)
   109			return
   110		}
   111		writeJSON(w, http.StatusOK, version)
   112	}
   113	
   114	func (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {
   115		modelName := r.PathValue("name")
   116		numStr := r.PathValue("num")
   117		num, err := strconv.Atoi(numStr)
   118		if err != nil {
   119			writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
   120			return
   121		}
   122	
   123		var req struct {
   124			Stage string `json:"stage"`
   125		}
   126		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   127			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   128			return
   129		}
   130		if req.Stage == "" {
   131			writeError(w, http.StatusBadRequest, "stage is required")
   132			return
   133		}
   134	
   135		if err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {
   136			writeError(w, http.StatusBadRequest, "%v", err)
   137			return
   138		}
   139		writeJSON(w, http.StatusOK, map[string]string{"status": "promoted"})
   140	}
