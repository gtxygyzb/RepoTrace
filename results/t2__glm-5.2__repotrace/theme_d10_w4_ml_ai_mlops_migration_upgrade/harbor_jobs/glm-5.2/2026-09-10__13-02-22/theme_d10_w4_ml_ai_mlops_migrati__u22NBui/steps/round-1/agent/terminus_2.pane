   236	func (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {
   237		expName := r.PathValue("name")
   238		metricName := r.PathValue("metric")
   239		aggType := r.URL.Query().Get("type")
   240		weightParam := r.URL.Query().Get("weight_param")
   241		tagFilters := map[string]string{}
   242		for _, filter := range r.URL.Query()["tag_filter"] {
   243			parts := strings.SplitN(filter, ":", 2)
   244			if len(parts) != 2 {
   245				writeError(w, http.StatusBadRequest, "invalid tag_filter %q, expected key:value", filter)
   246				return
   247			}
   248			tagFilters[parts[0]] = parts[1]
   249		}
   250	
   251		if aggType == "" {
   252			writeError(w, http.StatusBadRequest, "query parameter 'type' is required")
   253			return
   254		}
   255	
   256		result, count, runIDs, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam, tagFilters)
   257		if err != nil {
   258			writeError(w, http.StatusBadRequest, "%v", err)
   259			return
   260		}
   261	
   262		writeJSON(w, http.StatusOK, map[string]interface{}{
   263			"experiment": expName,
   264			"metric":     metricName,
   265			"type":       aggType,
   266			"value":      result,
   267			"count":      count,
   268			"run_ids":    runIDs,
   269		})
   270	}
   271	
   272	// --- Model Version Comparison Handler ---
   273	
   274	func (h *Handlers) CompareVersionMetrics(w http.ResponseWriter, r *http.Request) {
   275		modelName := r.PathValue("name")
   276		versionParam := r.URL.Query().Get("versions")
   277		if versionParam == "" {
   278			writeError(w, http.StatusBadRequest, "query parameter 'versions' is required")
   279			return
   280		}
   281	
   282		parts := strings.Split(versionParam, ",")
   283		seen := map[int]bool{}
   284		versionNums := make([]int, 0, len(parts))
   285		for _, p := range parts {
   286			num, err := strconv.Atoi(strings.TrimSpace(p))
   287			if err != nil {
   288				writeError(w, http.StatusBadRequest, "invalid version number: %q", p)
   289				return
   290			}
   291			if seen[num] {
   292				writeError(w, http.StatusBadRequest, "duplicate version number: %d", num)
   293				return
   294			}
   295			seen[num] = true
   296			versionNums = append(versionNums, num)
   297		}
   298		if len(versionNums) < 2 {
   299			writeError(w, http.StatusBadRequest, "at least 2 versions are required for comparison")
   300			return
   301		}
   302	
   303		model, err := h.Registry.GetModel(modelName)
   304		if err != nil {
   305			writeError(w, http.StatusNotFound, "%v", err)
   306			return
   307		}
   308	
   309		sort.Ints(versionNums)
   310		versionMap := map[int]*registry.Version{}
   311		for _, v := range model.Versions {
   312			versionMap[v.Number] = v
   313		}
   314	
   315		versions := make([]map[string]interface{}, 0, len(versionNums))
   316		for _, num := range versionNums {
   317			v, ok := versionMap[num]
   318			if !ok {
   319				writeError(w, http.StatusBadRequest, "version %d does not exist for model %q", num, modelName)
   320				return
   321			}
   322			versions = append(versions, map[string]interface{}{
   323				"number":  v.Number,
   324				"stage":   v.Stage,
   325				"metrics": v.Metrics,
   326			})
   327		}
   328	
   329		metricSummary := map[string]map[string]interface{}{}
   330		metricValues := map[string][]float64{}
   331		for _, v := range versions {
   332			metrics, _ := v["metrics"].(map[string]float64)
   333			for name, val := range metrics {
   334				metricValues[name] = append(metricValues[name], val)
   335			}
   336		}
   337	
   338		for name, vals := range metricValues {
