import json, urllib.request, urllib.error
BASE = "http://localhost:8080/api/v1"
def req(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    r = urllib.request.Request(BASE+path, data=data, method=method, headers={"Content-Type":"application/json"})
    try:
        with urllib.request.urlopen(r, timeout=5) as resp:
            return resp.status, json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        return e.code, json.loads(e.read().decode())
for mode, threshold, expected in [("gt",5,[6]),("lt",5,[1]),("gte",5,[5,6]),("lte",5,[1,5]),("eq",5,[5]),("ne",5,[1,6])]:
    st, b = req("POST","/pipelines/execute", {"name":"p","input":{"data":[1,5,6]},"steps":[{"name":"f","type":"filter","config":{"mode":mode,"threshold":threshold},"dependencies":[]}]})
    print(mode, b["steps"][0]["output"]["data"], "expected", expected)
PY
