    10	
    11	type batchRequest struct {
    12		Requests []serving.InferenceRequest `json:"requests"`
    13		Strategy string                     `json:"strategy"`
    14	}
    15	
    16	func (h *Handlers) BatchInfer(w http.ResponseWriter, r *http.Request) {
    17		var req batchRequest
    18		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
    19			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
    20			return
    21		}
    22		if len(req.Requests) == 0 {
    23			writeError(w, http.StatusBadRequest, "requests array is required and cannot be empty")
    24			return
    25		}
    26		strategy := req.Strategy
    27		if strategy == "" {
    28			strategy = "independent"
    29		}
    30		if strategy != "independent" && strategy != "stop_on_error" {
    31			writeError(w, http.StatusBadRequest, "invalid strategy %q", strategy)
    32			return
    33		}
    34	
    35		start := time.Now()
    36		results := make([]map[string]interface{}, 0, len(req.Requests))
    37		succeeded := 0
    38		failed := 0
    39		skipped := 0
    40		stop := false
    41	
    42		for i, ir := range req.Requests {
    43			if stop {
    44				results = append(results, map[string]interface{}{
    45					"model_name": ir.ModelName,
    46					"status":     "skipped",
    47				})
    48				skipped++
    49				continue
    50			}
    51	
    52			if ir.ModelName == "" {
    53				results = append(results, map[string]interface{}{
    54					"model_name": ir.ModelName,
    55					"error":      "model_name is required",
    56				})
    57				failed++
    58				if strategy == "stop_on_error" {
    59					stop = true
    60				}
    61				continue
    62			}
    63	
    64			resp, err := h.Serving.Infer(&ir)
    65			if err != nil {
    66				results = append(results, map[string]interface{}{
    67					"model_name": ir.ModelName,
    68					"error":      err.Error(),
    69				})
    70				failed++
    71				if strategy == "stop_on_error" {
    72					stop = true
    73				}
    74				continue
    75			}
    76	
    77			results = append(results, map[string]interface{}{
    78				"model_name":  resp.ModelName,
    79				"version":     resp.Version,
    80				"predictions": resp.Predictions,
    81				"latency_ms":  resp.LatencyMs,
    82			})
    83			succeeded++
    84			_ = i
    85		}
    86	
    87		summary := map[string]int{
    88			"total":     len(req.Requests),
    89			"succeeded": succeeded,
    90			"failed":    failed,
    91		}
    92		if strategy == "stop_on_error" {
    93			summary["skipped"] = skipped
    94		}
    95	
    96		writeJSON(w, http.StatusOK, map[string]interface{}{
    97			"results":          results,
    98			"total_latency_ms": float64(time.Since(start).Microseconds()) / 1000.0,
    99			"summary":          summary,
   100		})
   101	}
