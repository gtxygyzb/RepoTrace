    14	// Stage represents the lifecycle stage of a model version.
    15	type Stage string
    16	
    17	const (
    18		StageDevelopment Stage = "development"
    19		StageStaging     Stage = "staging"
    20		StageProduction  Stage = "production"
    21		StageArchived    Stage = "archived"
    22	)
    23	
    24	var validTransitions = map[Stage][]Stage{
    25		StageDevelopment: {StageStaging, StageArchived},
    26		StageStaging:     {StageProduction, StageArchived},
    27		StageProduction:  {StageArchived},
    28		StageArchived:    {},
    29	}
    30	
    31	// PromotionRecord records a single stage transition in a version's lineage.
    32	type PromotionRecord struct {
    33		FromStage Stage  `json:"from_stage"`
    34		ToStage   Stage  `json:"to_stage"`
    35		Timestamp string `json:"timestamp"`
    36	}
    37	
    38	// Version represents a specific version of a model.
    39	type Version struct {
    40		Number      int                    `json:"number"`
    41		Stage       Stage                  `json:"stage"`
    42		Metrics     map[string]float64     `json:"metrics"`
    43		Tags        []string               `json:"tags"`
    44		ModelConfig map[string]interface{} `json:"model_config,omitempty"`
    45		CreatedAt   time.Time              `json:"created_at"`
    46		Lineage     []PromotionRecord      `json:"lineage"`
    47		DemotedBy   int                    `json:"demoted_by,omitempty"`
    48	}
    49	
    50	// Model represents a registered ML model.
    51	type Model struct {
    52		Name         string     `json:"name"`
    53		Framework    string     `json:"framework"`
    54		Description  string     `json:"description"`
    55		Tags         []string   `json:"tags"`
    56		Versions     []*Version `json:"versions"`
    57		Dependencies []string   `json:"dependencies"`
    58		CreatedAt    time.Time  `json:"created_at"`
    59		UpdatedAt    time.Time  `json:"updated_at"`
    60	}
    61	
    62	// ModelFilter defines filtering criteria for listing models.
    63	type ModelFilter struct {
    64		Framework string
    65		Tag       string
    66	}
    67	
    68	// Annotation represents a key-value annotation attached to a model version.
    69	type Annotation struct {
    70		Key       string    `json:"key"`
    71		Value     string    `json:"value"`
    72		CreatedAt time.Time `json:"created_at"`
    73	}
    74	
    75	var annotationKeyRegexp = regexp.MustCompile(`^[A-Za-z0-9_]+$`)
    76	
    77	// Registry manages model registration, versioning, and lifecycle.
    78	type Registry struct {
    79		mu           sync.RWMutex
    80		models       map[string]*Model
    81		dataDir      string
    82		annotations  map[string]map[int]map[string]*Annotation
    83		dependencies map[string][]string
    84	}
    85	
    86	// NewRegistry creates a new Registry backed by the given data directory.
    87	func NewRegistry(dataDir string) (*Registry, error) {
    88		if err := os.MkdirAll(dataDir, 0755); err != nil {
    89			return nil, fmt.Errorf("create data dir: %w", err)
    90		}
    91		r := &Registry{
    92			models:       make(map[string]*Model),
    93			dataDir:      dataDir,
    94			annotations:  make(map[string]map[int]map[string]*Annotation),
    95			dependencies: make(map[string][]string),
    96		}
    97		if err := r.loadAll(); err != nil {
    98			return nil, fmt.Errorf("load registry: %w", err)
    99		}
   100		return r, nil
   101	}
   102	
   103	// RegisterModel creates a new model entry in the registry.
   104	func (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {
   105		r.mu.Lock()
   106		defer r.mu.Unlock()
   107	
   108		if _, exists := r.models[name]; exists {
   109			return nil, fmt.Errorf("model %q already exists", name)
   110		}
   111	
   112		now := time.Now()
   113		if tags == nil {
   114			tags = []string{}
   115		}
   116		model := &Model{
   117			Name:         name,
   118			Framework:    framework,
   119			Description:  description,
   120			Tags:         tags,
   121			Versions:     make([]*Version, 0),
   122			Dependencies: []string{},
   123			CreatedAt:    now,
   124			UpdatedAt:    now,
   125		}
   126		r.models[name] = model
   127		r.dependencies[name] = []string{}
   128		if err := r.saveModel(model); err != nil {
   129			delete(r.models, name)
   130			return nil, err
   131		}
   132		return model, nil
   133	}
   134	
   135	// CreateVersion adds a new version to the specified model.
   136	func (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {
   137		r.mu.Lock()
   138		defer r.mu.Unlock()
   139	
   140		model, exists := r.models[modelName]
   141		if !exists {
   142			return nil, fmt.Errorf("model %q not found", modelName)
   143		}
   144	
   145		nextNum := 1
   146		for _, v := range model.Versions {
   147			if v.Number >= nextNum {
   148				nextNum = v.Number + 1
   149			}
   150		}
   151	
   152		if tags == nil {
   153			tags = []string{}
   154		}
   155		version := &Version{
   156			Number:      nextNum,
   157			Stage:       StageDevelopment,
   158			Metrics:     metrics,
   159			Tags:        tags,
   160			ModelConfig: modelConfig,
   161			CreatedAt:   time.Now(),
   162			Lineage:     []PromotionRecord{},
   163		}
   164		model.Versions = append(model.Versions, version)
   165		model.UpdatedAt = time.Now()
   166	
   167		if err := r.saveModel(model); err != nil {
   168			model.Versions = model.Versions[:len(model.Versions)-1]
   169			return nil, err
   170		}
   171		return version, nil
   172	}
   173	
   174	// PromoteVersion transitions a model version to the specified stage.
   175	func (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {
   176		r.mu.Lock()
   177		defer r.mu.Unlock()
   178	
   179		model, exists := r.models[modelName]
   180		if !exists {
   181			return fmt.Errorf("model %q not found", modelName)
   182		}
   183	
   184		var version *Version
   185		for _, v := range model.Versions {
   186			if v.Number == versionNum {
   187				version = v
   188				break
   189			}
   190		}
   191		if version == nil {
   192			return fmt.Errorf("version %d not found for model %q", versionNum, modelName)
   193		}
   194	
   195		// Validate stage transition
   196		allowed := validTransitions[version.Stage]
   197		valid := false
   198		for _, s := range allowed {
   199			if s == targetStage {
   200				valid = true
   201				break
   202			}
   203		}
   204		if !valid {
   205			return fmt.Errorf("invalid stage transition from %s to %s", version.Stage, targetStage)
   206		}
   207	
   208		promotionTime := time.Now().UTC().Format(time.RFC3339)
   209	
   210		// If promoting to production, demote current production version.
   211		if targetStage == StageProduction {
   212			for _, v := range model.Versions {
   213				if v.Stage == StageProduction && v.Number != versionNum {
   214					if v.Lineage == nil {
   215						v.Lineage = []PromotionRecord{}
   216					}
   217					v.Lineage = append(v.Lineage, PromotionRecord{
   218						FromStage: StageProduction,
   219						ToStage:   StageStaging,
   220						Timestamp: promotionTime,
   221					})
   222					v.DemotedBy = versionNum
   223					v.Stage = StageStaging
   224				}
   225			}
   226		}
   227	
   228		if version.Lineage == nil {
   229			version.Lineage = []PromotionRecord{}
   230		}
   231		version.Lineage = append(version.Lineage, PromotionRecord{
   232			FromStage: version.Stage,
   233			ToStage:   targetStage,
   234			Timestamp: promotionTime,
   235		})
   236		version.Stage = targetStage
   237		model.UpdatedAt = time.Now()
   238	
   239		return r.saveModel(model)
   240	}
   241	
   242	// GetModel returns a model with its versions sorted by version number descending.
   243	func (r *Registry) GetModel(name string) (*Model, error) {
   244		r.mu.RLock()
   245		defer r.mu.RUnlock()
   246	
   247		model, exists := r.models[name]
   248		if !exists {
   249			return nil, fmt.Errorf("model %q not found", name)
   250		}
   251	
   252		// Return a copy with versions sorted
   253		result := *model
   254		result.Versions = make([]*Version, len(model.Versions))
   255		copy(result.Versions, model.Versions)
   256		sort.Slice(result.Versions, func(i, j int) bool {
   257			return result.Versions[i].Number > result.Versions[j].Number
   258		})
   259		return &result, nil
   260	}
