   246	// mergeDependencyOutputs concatenates the "data" arrays from all dependency outputs into a single input.
   247	func mergeDependencyOutputs(deps []string, outputs map[string]map[string]interface{}) map[string]interface{} {
   248		merged := make([]interface{}, 0)
