[?2004l[?2004h> appendix = '''
[?2004l[?2004h> 
[?2004l[?2004h> // AddDependencies declares model dependencies.
[?2004l[?2004h> func (r *Registry) AddDependencies(modelName string, dependsOn []string) ([]string, error) {
[?2004l[?2004h> \tr.mu.Lock()
[?2004l[?2004h> \tdefer r.mu.Unlock()
[?2004l[?2004h> 
[?2004l[?2004h> \tmodel, exists := r.models[modelName]
[?2004l[?2004h> \tif !exists {
[?2004l[?2004h> \t\treturn nil, fmt.Errorf("model %q not found", modelName)
[?2004l[?2004h> \t}
[?2004l[?2004h> 
[?2004l[?2004h> \tfor _, dep := range dependsOn {
[?2004l[?2004h> \t\tif dep == modelName {
[?2004l[?2004h> \t\t\treturn nil, fmt.Errorf("model cannot depend on itself")
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t\tif _, exists := r.models[dep]; !exists {
[?2004l[?2004h> \t\t\treturn nil, fmt.Errorf("model %q not found", dep)
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t}
[?2004l[?2004h> 
[?2004l[?2004h> \tproposed := append([]string{}, r.dependencies[modelName]...)
[?2004l[?2004h> \tfor _, dep := range dependsOn {
[?2004l[?2004h> \t\tif !containsString(proposed, dep) {
[?2004l[?2004h> \t\t\tproposed = append(proposed, dep)
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t}
[?2004l[?2004h> 
[?2004l[?2004h> \tfor _, dep := range dependsOn {
[?2004l[?2004h> \t\tif r.createsCycleLocked(modelName, dep, proposed) {
[?2004l[?2004h> \t\t\treturn nil, fmt.Errorf("circular dependency detected")
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t}
[?2004l[?2004h> 
[?2004l[?2004h> \tsort.Strings(proposed)
[?2004l[?2004h> \tr.dependencies[modelName] = proposed
[?2004l[?2004h> \tmodel.Dependencies = append([]string{}, proposed...)
[?2004l[?2004h> \tif err := r.saveModel(model); err != nil {
[?2004l[?2004h> \t\treturn nil, err
[?2004l[?2004h> \t}
[?2004l[?2004h> \treturn model.Dependencies, nil
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // GetDependencies returns direct and transitive dependencies for a model.
[?2004l[?2004h> func (r *Registry) GetDependencies(modelName string) ([]string, []string, error) {
[?2004l[?2004h> \tr.mu.RLock()
[?2004l[?2004h> \tdefer r.mu.RUnlock()
[?2004l[?2004h> 
[?2004l[?2004h> \tif _, exists := r.models[modelName]; !exists {
[?2004l[?2004h> \t\treturn nil, nil, fmt.Errorf("model %q not found", modelName)
[?2004l[?2004h> \t}
[?2004l[?2004h> 
[?2004l[?2004h> \tdirect := append([]string{}, r.dependencies[modelName]...)
[?2004l[?2004h> \tsort.Strings(direct)
[?2004l[?2004h> \tif direct == nil {
[?2004l[?2004h> \t\tdirect = []string{}
[?2004l[?2004h> \t}
[?2004l[?2004h> 
[?2004l[?2004h> \ttransitive := r.transitiveDependenciesLocked(modelName)
[?2004l[?2004h> \tsort.Strings(transitive)
[?2004l[?2004h> \tif transitive == nil {
[?2004l[?2004h> \t\ttransitive = []string{}
[?2004l[?2004h> \t}
[?2004l[?2004h> 
[?2004l[?2004h> \treturn direct, transitive, nil
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // RemoveDependency removes a direct dependency from a model.
[?2004l[?2004h> func (r *Registry) RemoveDependency(modelName, dep string) error {
[?2004l[?2004h> \tr.mu.Lock()
[?2004l[?2004h> \tdefer r.mu.Unlock()
[?2004l[?2004h> 
[?2004l[?2004h> \tmodel, exists := r.models[modelName]
[?2004l[?2004h> \tif !exists {
[?2004l[?2004h> \t\treturn fmt.Errorf("model %q not found", modelName)
[?2004l[?2004h> \t}
[?2004l[?2004h> 
[?2004l[?2004h> \tdirect := r.dependencies[modelName]
[?2004l[?2004h> \tidx := -1
[?2004l[?2004h> \tfor i, d := range direct {
[?2004l[?2004h> \t\tif d == dep {
[?2004l[?2004h> \t\t\tidx = i
[?2004l[?2004h> \t\t\tbreak
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t}
[?2004l[?2004h> \tif idx == -1 {
[?2004l[?2004h> \t\treturn fmt.Errorf("dependency %q not found for model %q", dep, modelName)
[?2004l[?2004h> \t}
[?2004l[?2004h> 
[?2004l[?2004h> \tr.dependencies[modelName] = append(direct[:idx], direct[idx+1:]...)
[?2004l[?2004h> \tmodel.Dependencies = append([]string{}, r.dependencies[modelName]...)
[?2004l[?2004h> \tif model.Dependencies == nil {
[?2004l[?2004h> \t\tmodel.Dependencies = []string{}
[?2004l[?2004h> \t}
[?2004l[?2004h> \treturn r.saveModel(model)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> func (r *Registry) createsCycleLocked(modelName, dep string, proposedDirect []string) bool {
[?2004l[?2004h> \tvisited := make(map[string]bool)
[?2004l[?2004h> \tvar dfs func(node string) bool
[?2004l[?2004h> \tdfs = func(node string) bool {
[?2004l[?2004h> \t\tif node == modelName {
[?2004l[?2004h> \t\t\treturn true
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t\tif visited[node] {
[?2004l[?2004h> \t\t\treturn false
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t\tvisited[node] = true
[?2004l[?2004h> 
[?2004l[?2004h> \t\tvar deps []string
[?2004l[?2004h> \t\tif node == modelName {
[?2004l[?2004h> \t\t\tdeps = proposedDirect
[?2004l[?2004h> \t\t} else {
[?2004l[?2004h> \t\t\tdeps = r.dependencies[node]
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t\tfor _, d := range deps {
[?2004l[?2004h> \t\t\tif dfs(d) {
[?2004l[?2004h> \t\t\t\treturn true
[?2004l[?2004h> \t\t\t}
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t\treturn false
[?2004l[?2004h> \t}
[?2004l[?2004h> \treturn dfs(dep)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> func (r *Registry) transitiveDependenciesLocked(modelName string) []string {
[?2004l[?2004h> \tresult := make(map[string]bool)
[?2004l[?2004h> \tvar dfs func(node string)
[?2004l[?2004h> \tdfs = func(node string) {
[?2004l[?2004h> \t\tfor _, dep := range r.dependencies[node] {
[?2004l[?2004h> \t\t\tif !result[dep] {
[?2004l[?2004h> \t\t\t\tresult[dep] = true
[?2004l[?2004h> \t\t\t\tdfs(dep)
[?2004l[?2004h> \t\t\t}
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t}
[?2004l[?2004h> \tdfs(modelName)
[?2004l[?2004h> 
[?2004l[?2004h> \tout := make([]string, 0, len(result))
[?2004l[?2004h> \tfor dep := range result {
[?2004l[?2004h> \t\tout = append(out, dep)
[?2004l[?2004h> \t}
[?2004l[?2004h> \treturn out
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> func containsString(slice []string, s string) bool {
[?2004l[?2004h> \tfor _, v := range slice {
[?2004l[?2004h> \t\tif v == s {
