   142	// --- Pipeline Handlers ---
   143	
   144	func (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {
   145		var req struct {
   146			Name     string                 `json:"name"`
   147			Steps    []*pipeline.Step       `json:"steps"`
   148			Input    map[string]interface{} `json:"input"`
   149			Pipeline *pipeline.Pipeline     `json:"pipeline"`
   150		}
   151		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   152			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   153			return
   154		}
   155		p := req.Pipeline
   156		if p == nil {
   157			p = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}
   158		}
   159		if p == nil || len(p.Steps) == 0 {
   160			writeError(w, http.StatusBadRequest, "pipeline with at least one step is required")
   161			return
   162		}
   163		if req.Input == nil {
   164			req.Input = make(map[string]interface{})
   165		}
   166	
   167		result, err := h.Pipeline.Execute(p, req.Input)
   168		if err != nil {
   169			writeError(w, http.StatusBadRequest, "%v", err)
   170			return
   171		}
   172		writeJSON(w, http.StatusOK, result)
   173	}
   174	
   175	// --- Experiment Handlers ---
   176	
   177	func (h *Handlers) CreateExperiment(w http.ResponseWriter, r *http.Request) {
   178		var req struct {
   179			Name string `json:"name"`
   180		}
   181		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   182			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   183			return
   184		}
   185		if req.Name == "" {
   186			writeError(w, http.StatusBadRequest, "name is required")
   187			return
   188		}
   189	
   190		exp, err := h.Experiment.CreateExperiment(req.Name)
   191		if err != nil {
   192			writeError(w, http.StatusConflict, "%v", err)
   193			return
   194		}
   195		writeJSON(w, http.StatusCreated, exp)
   196	}
   197	
   198	func (h *Handlers) ListExperiments(w http.ResponseWriter, r *http.Request) {
   199		exps := h.Experiment.ListExperiments()
   200		writeJSON(w, http.StatusOK, exps)
   201	}
   202	
   203	func (h *Handlers) GetExperiment(w http.ResponseWriter, r *http.Request) {
   204		name := r.PathValue("name")
   205		exp, err := h.Experiment.GetExperiment(name)
   206		if err != nil {
   207			writeError(w, http.StatusNotFound, "%v", err)
