    96	func (h *Handlers) GetVersion(w http.ResponseWriter, r *http.Request) {
    97		modelName := r.PathValue("name")
    98		numStr := r.PathValue("num")
    99		num, err := strconv.Atoi(numStr)
   100		if err != nil {
   101			writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
   102			return
