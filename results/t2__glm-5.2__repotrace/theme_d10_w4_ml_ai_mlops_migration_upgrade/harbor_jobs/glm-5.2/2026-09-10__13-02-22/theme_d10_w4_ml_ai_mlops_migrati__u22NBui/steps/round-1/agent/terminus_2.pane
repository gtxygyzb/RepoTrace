    25			Pipeline:   eng,
    26			Experiment: tracker,
    27			Serving:    srv,
    28			Templates:  NewTemplateStore(),
    29		}
    30	
    31		mux := http.NewServeMux()
    32	
    33		// Model registry endpoints
    34		mux.HandleFunc("POST /api/v1/models", h.RegisterModel)
    35		mux.HandleFunc("GET /api/v1/models", h.ListModels)
    36		mux.HandleFunc("GET /api/v1/models/{name}", h.GetModel)
    37		mux.HandleFunc("POST /api/v1/models/{name}/versions", h.CreateVersion)
    38		mux.HandleFunc("GET /api/v1/models/{name}/versions/compare", h.CompareVersionMetrics)
    39		mux.HandleFunc("GET /api/v1/models/{name}/versions/{num}", h.GetVersion)
    40		mux.HandleFunc("PUT /api/v1/models/{name}/versions/{num}/promote", h.PromoteVersion)
    41		mux.HandleFunc("DELETE /api/v1/models/{name}", h.DeleteModel)
    42	
    43		// Model version annotations
    44		mux.HandleFunc("POST /api/v1/models/{name}/versions/{num}/annotations", h.AddAnnotation)
    45		mux.HandleFunc("GET /api/v1/models/{name}/versions/{num}/annotations", h.ListAnnotations)
    46		mux.HandleFunc("DELETE /api/v1/models/{name}/versions/{num}/annotations/{key}", h.DeleteAnnotation)
    47	
    48		// Pipeline endpoints
    49		mux.HandleFunc("POST /api/v1/pipelines/validate", h.ValidatePipeline)
    50		mux.HandleFunc("POST /api/v1/pipelines/execute", h.ExecutePipeline)
    51		mux.HandleFunc("POST /api/v1/pipelines/templates", h.CreateTemplate)
    52		mux.HandleFunc("GET /api/v1/pipelines/templates", h.ListTemplates)
    53		mux.HandleFunc("GET /api/v1/pipelines/templates/{name}", h.GetTemplate)
    54		mux.HandleFunc("PUT /api/v1/pipelines/templates/{name}", h.UpdateTemplate)
    55		mux.HandleFunc("DELETE /api/v1/pipelines/templates/{name}", h.DeleteTemplate)
    56		mux.HandleFunc("POST /api/v1/pipelines/templates/{name}/execute", h.ExecuteTemplate)
    57	
    58		// Experiment endpoints
    59		mux.HandleFunc("POST /api/v1/experiments", h.CreateExperiment)
    60		mux.HandleFunc("GET /api/v1/experiments", h.ListExperiments)
    61		mux.HandleFunc("GET /api/v1/experiments/{name}", h.GetExperiment)
    62		mux.HandleFunc("POST /api/v1/experiments/{name}/runs", h.LogRun)
    63		mux.HandleFunc("DELETE /api/v1/experiments/{name}/runs/{id}", h.DeleteRun)
    64		mux.HandleFunc("GET /api/v1/experiments/compare", h.CompareExperiments)
    65		mux.HandleFunc("GET /api/v1/experiments/{name}/metrics/{metric}/aggregate", h.AggregateMetric)
    66		mux.HandleFunc("GET /api/v1/experiments/{name}/metrics/{metric}/history", h.GetMetricHistory)
    67		mux.HandleFunc("PUT /api/v1/experiments/{name}/runs/{id}", h.UpdateRun)
    68		mux.HandleFunc("POST /api/v1/experiments/{name}/runs/search", h.SearchRuns)
    69	
    70		// Serving endpoints
    71		mux.HandleFunc("POST /api/v1/serving/load", h.LoadModel)
    72		mux.HandleFunc("DELETE /api/v1/serving/models/{name}", h.UnloadModel)
    73		mux.HandleFunc("GET /api/v1/serving/models", h.ListLoadedModels)
    74		mux.HandleFunc("POST /api/v1/serving/infer", h.Infer)
    75		mux.HandleFunc("POST /api/v1/serving/batch", h.BatchInfer)
