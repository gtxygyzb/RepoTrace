   144	// topologicalSort orders steps so that dependencies are executed first.
   145	// Returns an error if a cycle is detected.
   146	func topologicalSort(steps []*Step) ([]*Step, error) {
   147		stepMap := make(map[string]*Step)
   148		inDegree := make(map[string]int)
   149	
   150		for _, s := range steps {
   151			stepMap[s.Name] = s
   152			inDegree[s.Name] = 0
   153		}
   154	
   155		// Build in-degree counts
   156		for _, s := range steps {
   157			for _, dep := range s.Dependencies {
   158				if _, ok := stepMap[dep]; !ok {
   159					return nil, fmt.Errorf("step %q depends on unknown step %q", s.Name, dep)
   160				}
   161				inDegree[s.Name]++
   162			}
   163		}
   164	
   165		// Kahn's algorithm
   166		var queue []*Step
   167		for _, s := range steps {
   168			if inDegree[s.Name] == 0 {
   169				queue = append(queue, s)
   170			}
   171		}
   172	
   173		var ordered []*Step
   174		for len(queue) > 0 {
   175			current := queue[0]
   176			queue = queue[1:]
   177			ordered = append(ordered, current)
   178	
   179			// Find steps that depend on current
   180			for _, s := range steps {
   181				for _, dep := range s.Dependencies {
   182					if dep == current.Name {
   183						inDegree[s.Name]--
   184						if inDegree[s.Name] == 0 {
   185							queue = append(queue, s)
   186						}
   187					}
   188				}
   189			}
   190		}
   191	
   192		if len(ordered) != len(steps) {
   193			return nil, fmt.Errorf("cycle detected in pipeline dependencies")
   194		}
   195	
   196		return ordered, nil
   197	}
   198	
   199	// mergeOutputs collects and merges data arrays from the specified dependency outputs.
   200	func mergeOutputs(stepOutputs map[string]map[string]interface{}, deps []string) map[string]interface{} {
   201		merged := make(map[string]interface{})
   202		var mergedData []interface{}
   203	
   204		for _, dep := range deps {
   205			if output, ok := stepOutputs[dep]; ok {
   206				if data, ok := output["data"]; ok {
   207					switch d := data.(type) {
   208					case []interface{}:
   209						mergedData = append(mergedData, d...)
   210					case []float64:
   211						for _, v := range d {
   212							mergedData = append(mergedData, v)
   213						}
   214					default:
   215						mergedData = append(mergedData, data)
