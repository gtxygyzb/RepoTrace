   478	func (h *Handlers) LoadModel(w http.ResponseWriter, r *http.Request) {
   479		var req struct {
   480			ModelName  string `json:"model_name"`
   481			VersionNum int    `json:"version_num"`
   482			Stage      string `json:"stage"`
   483		}
   484		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   485			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   486			return
   487		}
   488		if req.ModelName == "" {
   489			writeError(w, http.StatusBadRequest, "model_name is required")
   490			return
   491		}
   492	
   493		if err := h.Serving.LoadModel(req.ModelName, req.VersionNum, req.Stage); err != nil {
   494			writeError(w, http.StatusBadRequest, "%v", err)
   495			return
   496		}
   497		writeJSON(w, http.StatusOK, map[string]string{"status": "loaded"})
   498	}
