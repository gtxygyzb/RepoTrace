   131	// Infer runs inference on the loaded model and returns predictions.
   132	func (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {
   133		start := time.Now()
   134	
   135		s.mu.RLock()
   136		loaded, exists := s.loaded[req.ModelName]
   137		s.mu.RUnlock()
   138	
   139		if !exists {
   140			return nil, fmt.Errorf("model %q is not loaded for serving", req.ModelName)
   141		}
   142	
   143		predictions, err := computePrediction(loaded.ModelConfig, req.Input)
   144		if err != nil {
   145			return nil, fmt.Errorf("inference error: %w", err)
   146		}
   147	
   148		latency := float64(time.Since(start).Microseconds()) / 1000.0
   149	
   150		return &InferenceResponse{
   151			ModelName:   req.ModelName,
   152			Version:     loaded.VersionNum,
   153			Predictions: predictions,
   154			LatencyMs:   latency,
   155		}, nil
   156	}
