   373	// AddAnnotation attaches a new key-value annotation to a model version.
   374	func (r *Registry) AddAnnotation(modelName string, versionNum int, key, value string) (*Annotation, error) {
   375		r.mu.Lock()
   376		defer r.mu.Unlock()
   377	
   378		if _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {
   379			return nil, err
   380		}
   381		if !validateAnnotationKey(key) {
   382			return nil, fmt.Errorf("invalid annotation key")
   383		}
   384	
   385		if r.annotations[modelName] == nil {
   386			r.annotations[modelName] = make(map[int]map[string]*Annotation)
   387		}
   388		if r.annotations[modelName][versionNum] == nil {
   389			r.annotations[modelName][versionNum] = make(map[string]*Annotation)
   390		}
   391		if _, exists := r.annotations[modelName][versionNum][key]; exists {
   392			return nil, fmt.Errorf("annotation %q already exists", key)
   393		}
   394	
   395		annotation := &Annotation{
   396			Key:       key,
   397			Value:     value,
   398			CreatedAt: time.Now(),
   399		}
   400		r.annotations[modelName][versionNum][key] = annotation
   401		return annotation, nil
   402	}
   403	
   404	// ListAnnotations returns all annotations for a model version sorted by key.
   405	func (r *Registry) ListAnnotations(modelName string, versionNum int) ([]*Annotation, error) {
   406		r.mu.RLock()
   407		defer r.mu.RUnlock()
   408	
   409		if _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {
   410			return nil, err
   411		}
   412	
   413		var annotations []*Annotation
   414		if versions, ok := r.annotations[modelName]; ok {
   415			if keys, ok := versions[versionNum]; ok {
   416				for _, a := range keys {
   417					annotations = append(annotations, a)
   418				}
   419			}
   420		}
   421		sort.Slice(annotations, func(i, j int) bool {
   422			return annotations[i].Key < annotations[j].Key
   423		})
   424		if annotations == nil {
   425			annotations = []*Annotation{}
   426		}
   427		return annotations, nil
   428	}
   429	
   430	// DeleteAnnotation removes a specific annotation from a model version.
   431	func (r *Registry) DeleteAnnotation(modelName string, versionNum int, key string) error {
   432		r.mu.Lock()
   433		defer r.mu.Unlock()
   434	
   435		if _, _, err := r.findVersionLocked(modelName, versionNum); err != nil {
   436			return err
   437		}
   438	
   439		if r.annotations[modelName] == nil || r.annotations[modelName][versionNum] == nil {
   440			return fmt.Errorf("annotation %q not found", key)
   441		}
   442		if _, exists := r.annotations[modelName][versionNum][key]; !exists {
   443			return fmt.Errorf("annotation %q not found", key)
   444		}
   445		delete(r.annotations[modelName][versionNum], key)
   446		return nil
   447	}
   448	
   449	// AnnotationsMap returns a map of annotation key to value for a model version.
   450	func (r *Registry) AnnotationsMap(modelName string, versionNum int) map[string]string {
   451		r.mu.RLock()
   452		defer r.mu.RUnlock()
   453	
   454		result := make(map[string]string)
   455		if versions, ok := r.annotations[modelName]; ok {
   456			if keys, ok := versions[versionNum]; ok {
   457				for k, a := range keys {
   458					result[k] = a.Value
   459				}
   460			}
   461		}
   462		return result
   463	}
