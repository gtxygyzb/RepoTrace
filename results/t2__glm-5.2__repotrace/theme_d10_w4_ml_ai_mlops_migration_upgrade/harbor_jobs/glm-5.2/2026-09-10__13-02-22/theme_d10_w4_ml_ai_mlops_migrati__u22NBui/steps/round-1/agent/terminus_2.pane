   296	}
   297	
   298	func (h *Handlers) Infer(w http.ResponseWriter, r *http.Request) {
   299		var req serving.InferenceRequest
   300		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   301			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   302			return
   303		}
   304		if req.ModelName == "" {
   305			writeError(w, http.StatusBadRequest, "model_name is required")
   306			return
   307		}
   308	
   309		resp, err := h.Serving.Infer(&req)
   310		if err != nil {
   311			writeError(w, http.StatusNotFound, "%v", err)
   312			return
   313		}
   314		writeJSON(w, http.StatusOK, resp)
   315	}
   316	
   317	// --- Helpers ---
   318	
   319	func writeJSON(w http.ResponseWriter, status int, data interface{}) {
   320		w.Header().Set("Content-Type", "application/json")
   321		w.WriteHeader(status)
   322		json.NewEncoder(w).Encode(data)
   323	}
   324	
   325	func writeError(w http.ResponseWriter, status int, format string, args ...interface{}) {
   326		w.Header().Set("Content-Type", "application/json")
   327		w.WriteHeader(status)
   328		msg := fmt.Sprintf(format, args...)
   329		json.NewEncoder(w).Encode(map[string]string{"error": msg})
   330	}
