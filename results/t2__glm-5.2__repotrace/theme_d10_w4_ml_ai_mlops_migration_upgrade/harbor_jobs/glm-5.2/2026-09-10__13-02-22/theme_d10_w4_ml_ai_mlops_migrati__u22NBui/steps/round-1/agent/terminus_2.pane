   594	func (h *Handlers) DeleteAnnotation(w http.ResponseWriter, r *http.Request) {
   595		modelName := r.PathValue("name")
   596		numStr := r.PathValue("num")
   597		num, err := strconv.Atoi(numStr)
   598		if err != nil {
