// BulkTagRuns merges tags into multiple runs in an experiment.
func (t *Tracker) BulkTagRuns(experimentName string, runIDs []string, tags map[string]string) (int, []string, error) {
\tt.mu.Lock()
\tdefer t.mu.Unlock()

\texp, exists := t.experiments[experimentName]
\tif !exists {
\t\treturn 0, nil, fmt.Errorf("experiment %q not found", experimentName)
\t}

\trunByID := make(map[string]*Run, len(exp.Runs))
\tfor _, run := range exp.Runs {
\t\trunByID[run.ID] = run
\t}

\tnotFound := make([]string, 0)
\tupdated := 0
\tfor _, id := range runIDs {
\t\trun, ok := runByID[id]
\t\tif !ok {
\t\t\tnotFound = append(notFound, id)
\t\t\tcontinue
\t\t}
\t\tif run.Tags == nil {
\t\t\trun.Tags = make(map[string]string)
\t\t}
\t\tfor k, v := range tags {
\t\t\trun.Tags[k] = v
\t\t}
\t\tupdated++
\t}

\tif updated > 0 {
\t\tif err := t.saveExperiment(exp); err != nil {
\t\t\treturn 0, nil, err
\t\t}
\t}
\treturn updated, notFound, nil
}

func copyFloatMap(m map[string]float64) map[string]float64 {
\tif m == nil {
\t\treturn map[string]float64{}
\t}
\tout := make(map[string]float64, len(m))
\tfor k, v := range m {
\t\tout[k] = v
\t}
\treturn out
}

func copyStringMap(m map[string]string) map[string]string {
\tif m == nil {
\t\treturn map[string]string{}
\t}
\tout := make(map[string]string, len(m))
\tfor k, v := range m {
\t\tout[k] = v
\t}
\treturn out
}
'''

marker = '\n// MetricHistoryEntry records a single metric value for a run.\n'
if marker not in s:
    raise SystemExit('marker not found')
s = s.replace(marker, insert + marker)
p.write_text(s)
