    16	func (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {
    17		var req struct {
    18			Name        string   `json:"name"`
    19			Framework   string   `json:"framework"`
    20			Description string   `json:"description"`
    21			Tags        []string `json:"tags"`
    22		}
    23		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
    24			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
    25			return
    26		}
    27		if req.Name == "" {
    28			writeError(w, http.StatusBadRequest, "name is required")
    29			return
    30		}
    31	
    32		model, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)
    33		if err != nil {
    34			writeError(w, http.StatusConflict, "%v", err)
    35			return
    36		}
    37		writeJSON(w, http.StatusCreated, model)
    38	}
