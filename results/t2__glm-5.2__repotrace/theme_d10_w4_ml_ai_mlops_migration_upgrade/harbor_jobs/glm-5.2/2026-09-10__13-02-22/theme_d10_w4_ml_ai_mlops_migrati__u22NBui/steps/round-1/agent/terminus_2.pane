   315	// --- Helpers ---
   316	
   317	func writeJSON(w http.ResponseWriter, status int, data interface{}) {
   318		w.Header().Set("Content-Type", "application/json")
   319		w.WriteHeader(status)
   320		json.NewEncoder(w).Encode(data)
   321	}
   322	
   323	func writeError(w http.ResponseWriter, status int, format string, args ...interface{}) {
   324		w.Header().Set("Content-Type", "application/json")
   325		w.WriteHeader(status)
   326		msg := fmt.Sprintf(format, args...)
   327		json.NewEncoder(w).Encode(map[string]string{"error": msg})
   328	}
