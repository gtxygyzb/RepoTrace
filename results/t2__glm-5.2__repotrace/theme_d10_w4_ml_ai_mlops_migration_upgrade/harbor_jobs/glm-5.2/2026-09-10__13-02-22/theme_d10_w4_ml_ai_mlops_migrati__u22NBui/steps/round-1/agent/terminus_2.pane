[?2004l   153	// PromoteVersion transitions a model version to the specified stage.
   154	func (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {
   155		r.mu.Lock()
   156		defer r.mu.Unlock()
   157	
   158		model, exists := r.models[modelName]
   159		if !exists {
   160			return fmt.Errorf("model %q not found", modelName)
   161		}
   162	
   163		var version *Version
   164		for _, v := range model.Versions {
   165			if v.Number == versionNum {
   166				version = v
   167				break
   168			}
   169		}
   170		if version == nil {
   171			return fmt.Errorf("version %d not found for model %q", versionNum, modelName)
   172		}
   173	
   174		// Validate stage transition
   175		allowed := validTransitions[version.Stage]
   176		valid := false
   177		for _, s := range allowed {
   178			if s == targetStage {
   179				valid = true
   180				break
   181			}
   182		}
   183		if !valid {
   184			return fmt.Errorf("invalid stage transition from %s to %s", version.Stage, targetStage)
   185		}
   186	
   187		// If promoting to production, demote current production version
   188		if targetStage == StageProduction {
   189			for _, v := range model.Versions {
   190				if v.Stage == StageProduction && v.Number != versionNum {
   191					v.Stage = StageStaging
   192				}
   193			}
   194		}
   195	
   196		version.Stage = targetStage
   197		model.UpdatedAt = time.Now()
   198	
   199		return r.saveModel(model)
   200	}
