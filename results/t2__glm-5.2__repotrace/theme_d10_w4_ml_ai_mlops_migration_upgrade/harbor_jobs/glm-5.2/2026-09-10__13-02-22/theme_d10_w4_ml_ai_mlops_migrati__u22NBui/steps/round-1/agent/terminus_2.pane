   248	func validateParameters(params []TemplateParameter) error {
   249		names := make(map[string]bool)
   250		for _, p := range params {
   251			if p.Name == "" {
   252				return fmt.Errorf("parameter name is required")
   253			}
   254			if names[p.Name] {
   255				return fmt.Errorf("duplicate parameter name %q", p.Name)
   256			}
   257			names[p.Name] = true
   258			if p.Type != "number" && p.Type != "string" {
   259				return fmt.Errorf("parameter %q type must be number or string", p.Name)
   260			}
   261			if p.Default != nil {
   262				switch p.Type {
   263				case "number":
   264					if _, ok := toFloat64(p.Default); !ok {
   265						return fmt.Errorf("parameter %q default must be a number", p.Name)
   266					}
   267				case "string":
   268					if _, ok := p.Default.(string); !ok {
   269						return fmt.Errorf("parameter %q default must be a string", p.Name)
   270					}
   271				}
   272			}
   273		}
   274		return nil
   275	}
   276	
   277	func toFloat64(v interface{}) (float64, bool) {
   278		switch val := v.(type) {
   279		case float64:
   280			return val, true
   281		case int:
   282			return float64(val), true
   283		case int64:
   284			return float64(val), true
   285		}
   286		return 0, false
   287	}
