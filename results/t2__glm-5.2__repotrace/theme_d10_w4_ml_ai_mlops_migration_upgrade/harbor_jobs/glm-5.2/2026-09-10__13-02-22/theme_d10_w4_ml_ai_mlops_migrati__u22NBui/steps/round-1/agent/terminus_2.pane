    16	const (
    17		StageDevelopment Stage = "development"
    18		StageStaging     Stage = "staging"
    19		StageProduction  Stage = "production"
    20		StageArchived    Stage = "archived"
    21	)
    22	
    23	var validTransitions = map[Stage][]Stage{
    24		StageDevelopment: {StageStaging, StageArchived},
    25		StageStaging:     {StageProduction, StageArchived},
    26		StageProduction:  {StageArchived},
    27		StageArchived:    {},
