   225			Input  map[string]interface{} `json:"input"`
   226			Params map[string]interface{} `json:"params"`
   227		}
   228		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   229			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   230			return
   231		}
   232		p, resolvedParams, defaultsUsed, err := substituteParameters(tmpl, req.Params)
   233		if err != nil {
   234			writeError(w, http.StatusBadRequest, "%v", err)
   235			return
   236		}
   237		if req.Input == nil {
   238			req.Input = make(map[string]interface{})
