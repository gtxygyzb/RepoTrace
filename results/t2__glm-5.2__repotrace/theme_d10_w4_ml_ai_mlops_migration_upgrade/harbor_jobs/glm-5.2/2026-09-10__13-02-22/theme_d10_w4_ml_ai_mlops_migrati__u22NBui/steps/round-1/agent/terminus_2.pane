[?2004l[?2004h> block = "\n".join(lines[start:end])
[?2004l[?2004h> new_block = """selfDependencyFound := false
[?2004l[?2004h> for _, step := range p.Steps {
[?2004l[?2004h> \tif step == nil {
[?2004l[?2004h> \t\tcontinue
[?2004l[?2004h> \t}
[?2004l[?2004h> \tif _, exists := e.stepExecutors[step.Type]; !exists {
[?2004l[?2004h> \t\tresult.Valid = false
[?2004l[?2004h> \t\tresult.Errors = append(result.Errors, fmt.Sprintf("unknown step type: %s", step.Type))
[?2004l[?2004h> \t}
[?2004l[?2004h> \tfor _, dep := range step.Dependencies {
[?2004l[?2004h> \t\tif dep == step.Name {
[?2004l[?2004h> \t\t\tresult.Valid = false
[?2004l[?2004h> \t\t\tresult.Errors = append(result.Errors, fmt.Sprintf("step %q depends on itself", step.Name))
[?2004l[?2004h> \t\t\tselfDependencyFound = true
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t\tif !seen[dep] {
[?2004l[?2004h> \t\t\tresult.Valid = false
[?2004l[?2004h> \t\t\tresult.Errors = append(result.Errors, fmt.Sprintf("step %s depends on unknown step: %s", step.Name, dep))
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t}
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> ordered, err := topologicalSort(p.Steps)
[?2004l[?2004h> if err != nil {
