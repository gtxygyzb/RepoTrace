   521	
   522	func (t *Tracker) DeleteRun(experimentName, runID string) error {
   523		t.mu.Lock()
   524		defer t.mu.Unlock()
   525	
   526		exp, exists := t.experiments[experimentName]
   527		if !exists {
   528			return fmt.Errorf("experiment %q not found", experimentName)
   529		}
   530	
   531		for i, run := range exp.Runs {
   532			if run.ID == runID {
   533				exp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)
   534				return t.saveExperiment(exp)
   535			}
   536		}
   537		return fmt.Errorf("run %q not found in experiment %q", runID, experimentName)
   538	}
