    11	)
    12	
    13	// Stage represents the lifecycle stage of a model version.
    14	type Stage string
    15	
    16	const (
    17		StageDevelopment Stage = "development"
    18		StageStaging     Stage = "staging"
    19		StageProduction  Stage = "production"
    20		StageArchived    Stage = "archived"
    21	)
    22	
    23	var validTransitions = map[Stage][]Stage{
    24		StageDevelopment: {StageStaging, StageArchived},
    25		StageStaging:     {StageProduction, StageArchived},
    26		StageProduction:  {StageArchived},
    27		StageArchived:    {},
    28	}
    29	
    30	// Version represents a specific version of a model.
    31	type Version struct {
    32		Number      int                    `json:"number"`
    33		Stage       Stage                  `json:"stage"`
    34		Metrics     map[string]float64     `json:"metrics"`
    35		Tags        []string               `json:"tags"`
    36		ModelConfig map[string]interface{} `json:"model_config,omitempty"`
    37		CreatedAt   time.Time              `json:"created_at"`
    38	}
    39	
    40	// Model represents a registered ML model.
    41	type Model struct {
    42		Name        string     `json:"name"`
    43		Framework   string     `json:"framework"`
    44		Description string     `json:"description"`
    45		Tags        []string   `json:"tags"`
    46		Versions    []*Version `json:"versions"`
    47		CreatedAt   time.Time  `json:"created_at"`
    48		UpdatedAt   time.Time  `json:"updated_at"`
    49	}
    50	
    51	// ModelFilter defines filtering criteria for listing models.
    52	type ModelFilter struct {
    53		Framework string
    54		Tag       string
    55	}
    56	
    57	// Registry manages model registration, versioning, and lifecycle.
    58	type Registry struct {
    59		mu      sync.RWMutex
    60		models  map[string]*Model
    61		dataDir string
    62	}
    63	
    64	// NewRegistry creates a new Registry backed by the given data directory.
    65	func NewRegistry(dataDir string) (*Registry, error) {
    66		if err := os.MkdirAll(dataDir, 0755); err != nil {
    67			return nil, fmt.Errorf("create data dir: %w", err)
    68		}
    69		r := &Registry{
    70			models:  make(map[string]*Model),
    71			dataDir: dataDir,
    72		}
    73		if err := r.loadAll(); err != nil {
    74			return nil, fmt.Errorf("load registry: %w", err)
    75		}
    76		return r, nil
    77	}
    78	
    79	// RegisterModel creates a new model entry in the registry.
    80	func (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {
    81		r.mu.Lock()
    82		defer r.mu.Unlock()
    83	
    84		if _, exists := r.models[name]; exists {
    85			return nil, fmt.Errorf("model %q already exists", name)
    86		}
    87	
    88		now := time.Now()
    89		model := &Model{
    90			Name:        name,
    91			Framework:   framework,
    92			Description: description,
    93			Tags:        tags,
    94			Versions:    make([]*Version, 0),
    95			CreatedAt:   now,
    96			UpdatedAt:   now,
    97		}
    98		r.models[name] = model
    99		if err := r.saveModel(model); err != nil {
   100			delete(r.models, name)
   101			return nil, err
   102		}
   103		return model, nil
   104	}
   105	
   106	// CreateVersion adds a new version to the specified model.
   107	func (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {
   108		r.mu.Lock()
   109		defer r.mu.Unlock()
   110	
   111		model, exists := r.models[modelName]
   112		if !exists {
   113			return nil, fmt.Errorf("model %q not found", modelName)
   114		}
   115	
   116		nextNum := 1
   117		for _, v := range model.Versions {
   118			if v.Number >= nextNum {
   119				nextNum = v.Number + 1
   120			}
   121		}
   122	
   123		version := &Version{
   124			Number:      nextNum,
   125			Stage:       StageDevelopment,
   126			Metrics:     metrics,
   127			Tags:        tags,
   128			ModelConfig: modelConfig,
   129			CreatedAt:   time.Now(),
   130		}
   131		model.Versions = append(model.Versions, version)
   132		model.UpdatedAt = time.Now()
   133	
   134		if err := r.saveModel(model); err != nil {
   135			model.Versions = model.Versions[:len(model.Versions)-1]
   136			return nil, err
   137		}
   138		return version, nil
   139	}
   140	
   141	// PromoteVersion transitions a model version to the specified stage.
   142	func (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {
   143		r.mu.Lock()
   144		defer r.mu.Unlock()
   145	
   146		model, exists := r.models[modelName]
   147		if !exists {
   148			return fmt.Errorf("model %q not found", modelName)
   149		}
   150	
   151		var version *Version
   152		for _, v := range model.Versions {
   153			if v.Number == versionNum {
   154				version = v
   155				break
   156			}
   157		}
   158		if version == nil {
   159			return fmt.Errorf("version %d not found for model %q", versionNum, modelName)
   160		}
   161	
   162		// Validate stage transition
   163		allowed := validTransitions[version.Stage]
   164		valid := false
   165		for _, s := range allowed {
   166			if s == targetStage {
   167				valid = true
   168				break
   169			}
   170		}
   171		if !valid {
   172			return fmt.Errorf("invalid stage transition from %s to %s", version.Stage, targetStage)
   173		}
   174	
   175		// If promoting to production, demote current production version
   176		if targetStage == StageProduction {
   177			for _, v := range model.Versions {
   178				if v.Stage == StageProduction && v.Number != versionNum {
   179					v.Stage = StageStaging
   180				}
   181			}
   182		}
   183	
   184		version.Stage = targetStage
   185		model.UpdatedAt = time.Now()
   186	
   187		return r.saveModel(model)
   188	}
   189	
   190	// GetModel returns a model with its versions sorted by version number descending.
   191	func (r *Registry) GetModel(name string) (*Model, error) {
   192		r.mu.RLock()
   193		defer r.mu.RUnlock()
   194	
   195		model, exists := r.models[name]
   196		if !exists {
   197			return nil, fmt.Errorf("model %q not found", name)
   198		}
   199	
   200		// Return a copy with versions sorted
   201		result := *model
   202		result.Versions = make([]*Version, len(model.Versions))
   203		copy(result.Versions, model.Versions)
   204		sort.Slice(result.Versions, func(i, j int) bool {
   205			return result.Versions[i].Number > result.Versions[j].Number
   206		})
   207		return &result, nil
   208	}
   209	
   210	// ListModels returns all models matching the optional filter.
   211	func (r *Registry) ListModels(filter *ModelFilter) ([]*Model, error) {
   212		r.mu.RLock()
   213		defer r.mu.RUnlock()
   214	
   215		var result []*Model
   216		for _, model := range r.models {
   217			if filter != nil {
   218				if filter.Framework != "" && model.Framework != filter.Framework {
   219					continue
   220				}
   221				if filter.Tag != "" {
   222					hasTag := false
   223					for _, t := range model.Tags {
   224						if t == filter.Tag {
   225							hasTag = true
   226							break
   227						}
   228					}
   229					if !hasTag {
   230						continue
   231					}
   232				}
   233			}
   234			result = append(result, model)
   235		}
   236		sort.Slice(result, func(i, j int) bool {
   237			return result[i].Name < result[j].Name
   238		})
   239		return result, nil
   240	}
   241	
   242	// DeleteModel removes a model from the registry.
   243	func (r *Registry) DeleteModel(name string) error {
   244		r.mu.Lock()
   245		defer r.mu.Unlock()
   246	
   247		if _, exists := r.models[name]; !exists {
   248			return fmt.Errorf("model %q not found", name)
   249		}
   250	
   251		delete(r.models, name)
   252		filename := filepath.Join(r.dataDir, name+".json")
   253		os.Remove(filename)
   254		return nil
   255	}
   256	
   257	// GetVersion returns a specific version of a model.
   258	func (r *Registry) GetVersion(modelName string, versionNum int) (*Version, error) {
   259		r.mu.RLock()
   260		defer r.mu.RUnlock()
