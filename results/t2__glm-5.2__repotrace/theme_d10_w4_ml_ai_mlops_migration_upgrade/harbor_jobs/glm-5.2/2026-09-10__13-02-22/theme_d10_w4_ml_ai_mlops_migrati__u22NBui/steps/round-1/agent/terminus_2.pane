[?2004hroot@n30009:/app# nl -ba internal/pipeline/engine.go | sed -n '360,415p'
[?2004l   360	// topologicalSort orders steps so that dependencies are executed first.
   361	// Returns an error if a cycle is detected.
   362	func topologicalSort(steps []*Step) ([]*Step, error) {
   363		stepMap := make(map[string]*Step)
   364		inDegree := make(map[string]int)
   365	
   366		for _, s := range steps {
   367			stepMap[s.Name] = s
   368			inDegree[s.Name] = 0
   369		}
   370	
   371		// Build in-degree counts
   372		for _, s := range steps {
   373			for _, dep := range s.Dependencies {
   374				if _, ok := stepMap[dep]; !ok {
   375					return nil, fmt.Errorf("step %q depends on unknown step %q", s.Name, dep)
   376				}
   377				inDegree[s.Name]++
   378			}
   379		}
   380	
   381		// Initialize queue with steps that have no dependencies
   382		queue := make([]*Step, 0)
   383		for _, s := range steps {
   384			if inDegree[s.Name] == 0 {
   385				queue = append(queue, s)
   386			}
   387		}
   388	
   389		// Process steps in topological order
   390		ordered := make([]*Step, 0, len(steps))
   391		for len(queue) > 0 {
   392			current := queue[0]
   393			queue = queue[1:]
   394			ordered = append(ordered, current)
   395	
   396			// Find steps that depend on current
   397			for _, s := range steps {
   398				for _, dep := range s.Dependencies {
   399					if dep == current.Name {
   400						inDegree[s.Name]--
   401						if inDegree[s.Name] == 0 {
   402							queue = append(queue, s)
   403						}
   404					}
   405				}
   406			}
   407		}
   408	
   409		if len(ordered) != len(steps) {
   410			return nil, fmt.Errorf("cycle detected in pipeline dependencies")
   411		}
   412	
   413		return ordered, nil
   414	}
   415	
