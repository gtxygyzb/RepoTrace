\tweightedSum += v * weights[i]\n\t\t\tweightSum += weights[i]\n\t\t}\n\t\tif weightSum == 0 {\n\t\t\treturn 0, 0, fmt.Errorf("weighted_mean has zero total weight")\n\t\t}\n\t\treturn weightedSum / weightSum, len(values), nil\n\n\tdefault:\n\t\treturn 0, 0, fmt.Errorf("unknown aggregation type %q", aggType)\n\t}\n}'''
