		return nil, fmt.Errorf("export: unknown format %q", format)
	}
}

// ExecuteFilter selects elements from the data array based on a comparison condition.
// Supported modes: gt, lt, gte, lte, eq, ne.
func ExecuteFilter(config, input map[string]interface{}) (map[string]interface{}, error) {
	data, ok := input["data"].([]interface{})
	if !ok {
		return nil, fmt.Errorf("filter: missing or invalid 'data' field in input")
	}

	mode, _ := config["mode"].(string)
	if mode == "" {
		return nil, fmt.Errorf("filter: missing 'mode' in config")
	}
	threshold, _ := config["threshold"].(float64)

	var result []interface{}
	for _, v := range data {
		val, err := toFloat(v)
		if err != nil {
			continue
		}
		var keep bool
		switch mode {
		case "gt":
			keep = val < threshold
		case "lt":
			keep = val > threshold
		case "gte":
			keep = val <= threshold
		case "lte":
			keep = val >= threshold
		case "eq":
			keep = val != threshold
		case "ne":
			keep = val == threshold
		default:
			return nil, fmt.Errorf("filter: unknown mode %q", mode)
		}
		if keep {
			result = append(result, val)
		}
	}

	if result == nil {
		result = []interface{}{}
	}
	return map[string]interface{}{"data": result}, nil
}

// Helper functions

func toFloat(v interface{}) (float64, error) {
	switch val := v.(type) {
	case float64:
		return val, nil
	case int:
		return float64(val), nil
	case int64:
		return float64(val), nil
	default:
		return 0, fmt.Errorf("cannot convert %T to float64", v)
	}
}

func findMinMax(data []interface{}) (float64, float64) {
	if len(data) == 0 {
		return 0, 0
	}
	minVal, _ := toFloat(data[0])
	maxVal := minVal
	for _, v := range data[1:] {
		val, err := toFloat(v)
		if err != nil {
			continue
		}
		if val < minVal {
			minVal = val
		}
		if val > maxVal {
			maxVal = val
		}
	}
	return minVal, maxVal
}

func sortedCopy(values []float64) []float64 {
	s := make([]float64, len(values))
	copy(s, values)
	sort.Float64s(s)
	return s
}
[?2004hroot@n30009:/app# sed -n '1,180p' internal/serving/serving.go
[?2004lpackage serving

import (
	"fmt"
	"sync"
	"time"

	"gomlops/internal/registry"
)

// LoadedModel tracks a model version currently loaded for serving.
type LoadedModel struct {
	ModelName   string                 `json:"model_name"`
	VersionNum  int                    `json:"version_num"`
	Stage       registry.Stage         `json:"stage"`
	ModelConfig map[string]interface{} `json:"model_config"`
	LoadedAt    time.Time              `json:"loaded_at"`
}

// InferenceRequest contains the input data for model inference.
type InferenceRequest struct {
	ModelName string    `json:"model_name"`
	Input     []float64 `json:"input"`
}

// InferenceResponse contains the model prediction results.
type InferenceResponse struct {
	ModelName   string      `json:"model_name"`
	Version     interface{} `json:"version"`
	Predictions []float64   `json:"predictions"`
	LatencyMs   float64     `json:"latency_ms"`
}

// Server manages model loading and inference.
type Server struct {
	mu       sync.RWMutex
	loaded   map[string]*LoadedModel
	registry *registry.Registry
}

// NewServer creates a new serving server backed by the given registry.
func NewServer(reg *registry.Registry) *Server {
	return &Server{
		loaded:   make(map[string]*LoadedModel),
		registry: reg,
	}
}

// LoadModel loads a model version for serving. Specify either versionNum > 0
// or a non-empty stage string (not both).
func (s *Server) LoadModel(modelName string, versionNum int, stage string) error {
	var version *registry.Version
	var err error

	if versionNum > 0 {
		version, err = s.registry.GetVersion(modelName, versionNum)
	} else if stage != "" {
		version, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))
	} else {
		return fmt.Errorf("must specify version number or stage")
	}

	if err != nil {
		return fmt.Errorf("load model: %w", err)
	}

	s.mu.Lock()
	defer s.mu.Unlock()

	s.loaded[modelName] = &LoadedModel{
		ModelName:   modelName,
		VersionNum:  version.Number,
		Stage:       version.Stage,
		ModelConfig: version.ModelConfig,
		LoadedAt:    time.Now(),
	}
	return nil
}

// UnloadModel removes a model from the serving cache.
func (s *Server) UnloadModel(modelName string) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	if _, exists := s.loaded[modelName]; !exists {
		return fmt.Errorf("model %q is not loaded", modelName)
	}
	delete(s.loaded, modelName)
	return nil
}

// Infer runs inference on the loaded model and returns predictions.
func (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {
	start := time.Now()

	s.mu.RLock()
	loaded, exists := s.loaded[req.ModelName]
	s.mu.RUnlock()

	if !exists {
		return nil, fmt.Errorf("model %q is not loaded for serving", req.ModelName)
	}

	predictions, err := computePrediction(loaded.ModelConfig, req.Input)
	if err != nil {
		return nil, fmt.Errorf("inference error: %w", err)
	}

	latency := float64(time.Since(start).Microseconds()) / 1000.0

	return &InferenceResponse{
		ModelName:   req.ModelName,
		Version:     string(loaded.Stage),
		Predictions: predictions,
		LatencyMs:   latency,
	}, nil
}

// ListLoaded returns all currently loaded models.
func (s *Server) ListLoaded() []*LoadedModel {
	s.mu.RLock()
	defer s.mu.RUnlock()

	result := make([]*LoadedModel, 0, len(s.loaded))
	for _, lm := range s.loaded {
		result = append(result, lm)
	}
	return result
}

// computePrediction evaluates a model against input data.
// Supported model types: linear, polynomial.
func computePrediction(modelConfig map[string]interface{}, input []float64) ([]float64, error) {
	if modelConfig == nil {
		return nil, fmt.Errorf("model has no configuration")
	}

	modelType, _ := modelConfig["model_type"].(string)
	switch modelType {
	case "linear":
		return linearPredict(modelConfig, input)
	case "polynomial":
		return polynomialPredict(modelConfig, input)
	default:
		return nil, fmt.Errorf("unsupported model type: %s", modelType)
	}
}

// linearPredict computes y = sum(weights[i] * input[i]) + bias
func linearPredict(config map[string]interface{}, input []float64) ([]float64, error) {
	weightsRaw, ok := config["weights"].([]interface{})
	if !ok {
		return nil, fmt.Errorf("linear model missing weights")
	}
	bias, _ := config["bias"].(float64)

	weights := make([]float64, len(weightsRaw))
	for i, w := range weightsRaw {
		wf, ok := w.(float64)
		if !ok {
			return nil, fmt.Errorf("weight %d is not a number", i)
		}
		weights[i] = wf
	}

	prediction := bias
	for i := 0; i < len(weights) && i < len(input); i++ {
		prediction += weights[i] * input[i]
	}

	return []float64{prediction}, nil
}

// polynomialPredict computes y = sum(coefficients[i] * x^i) for each input x
func polynomialPredict(config map[string]interface{}, input []float64) ([]float64, error) {
	coeffRaw, ok := config["coefficients"].([]interface{})
	if !ok {
		return nil, fmt.Errorf("polynomial model missing coefficients")
	}

