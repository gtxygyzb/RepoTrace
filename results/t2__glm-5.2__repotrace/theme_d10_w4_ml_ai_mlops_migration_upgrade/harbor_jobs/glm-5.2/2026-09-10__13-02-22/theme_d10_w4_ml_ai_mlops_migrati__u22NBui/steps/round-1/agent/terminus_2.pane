    49	// CreateExperiment creates a new experiment with the given name.
    50	func (t *Tracker) CreateExperiment(name string) (*Experiment, error) {
    51		t.mu.Lock()
    52		defer t.mu.Unlock()
    53	
    54		if _, exists := t.experiments[name]; exists {
    55			return nil, fmt.Errorf("experiment %q already exists", name)
    56		}
    57	
    58		exp := &Experiment{
    59			Name:      name,
    60			Runs:      make([]*Run, 0),
    61			CreatedAt: time.Now(),
    62		}
    63		t.experiments[name] = exp
    64		if err := t.saveExperiment(exp); err != nil {
    65			delete(t.experiments, name)
    66			return nil, err
    67		}
    68		return exp, nil
    69	}
    70	
    71	// LogRun adds a new run to the specified experiment.
    72	func (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {
    73		t.mu.Lock()
    74		defer t.mu.Unlock()
    75	
    76		exp, exists := t.experiments[experimentName]
    77		if !exists {
    78			return nil, fmt.Errorf("experiment %q not found", experimentName)
    79		}
    80	
    81		t.runCounter++
    82		run := &Run{
    83			ID:         fmt.Sprintf("run_%d", t.runCounter),
    84			Parameters: params,
    85			Metrics:    metrics,
    86			Tags:       tags,
    87			CreatedAt:  time.Now(),
    88		}
    89		exp.Runs = append(exp.Runs, run)
    90	
    91		if err := t.saveExperiment(exp); err != nil {
    92			exp.Runs = exp.Runs[:len(exp.Runs)-1]
    93			return nil, err
    94		}
    95		return run, nil
    96	}
