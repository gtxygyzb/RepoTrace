    11	
    12	// Handlers holds references to all service components.
    13	type Handlers struct {
    14		Registry   *registry.Registry
    15		Pipeline   *pipeline.Engine
    16		Experiment *experiment.Tracker
    17		Serving    *serving.Server
    18	}
    19	
    20	// NewRouter builds the HTTP route table and returns a handler.
    21	func NewRouter(reg *registry.Registry, eng *pipeline.Engine, tracker *experiment.Tracker, srv *serving.Server) http.Handler {
    22		h := &Handlers{
    23			Registry:   reg,
    24			Pipeline:   eng,
    25			Experiment: tracker,
    26			Serving:    srv,
    27		}
    28	
    29		mux := http.NewServeMux()
    30	
    31		// Model registry endpoints
    32		mux.HandleFunc("POST /api/v1/models", h.RegisterModel)
    33		mux.HandleFunc("GET /api/v1/models", h.ListModels)
    34		mux.HandleFunc("GET /api/v1/models/{name}", h.GetModel)
    35		mux.HandleFunc("POST /api/v1/models/{name}/versions", h.CreateVersion)
    36		mux.HandleFunc("GET /api/v1/models/{name}/versions/{num}", h.GetVersion)
    37		mux.HandleFunc("PUT /api/v1/models/{name}/versions/{num}/promote", h.PromoteVersion)
    38		mux.HandleFunc("DELETE /api/v1/models/{name}", h.DeleteModel)
    39	
    40		// Pipeline endpoints
    41		mux.HandleFunc("POST /api/v1/pipelines/execute", h.ExecutePipeline)
    42	
    43		// Experiment endpoints
    44		mux.HandleFunc("POST /api/v1/experiments", h.CreateExperiment)
    45		mux.HandleFunc("GET /api/v1/experiments", h.ListExperiments)
    46		mux.HandleFunc("GET /api/v1/experiments/{name}", h.GetExperiment)
    47		mux.HandleFunc("POST /api/v1/experiments/{name}/runs", h.LogRun)
    48		mux.HandleFunc("GET /api/v1/experiments/{name}/metrics/{metric}/aggregate", h.AggregateMetric)
    49	
    50		// Serving endpoints
    51		mux.HandleFunc("POST /api/v1/serving/load", h.LoadModel)
    52		mux.HandleFunc("DELETE /api/v1/serving/models/{name}", h.UnloadModel)
    53		mux.HandleFunc("GET /api/v1/serving/models", h.ListLoadedModels)
    54		mux.HandleFunc("POST /api/v1/serving/infer", h.Infer)
    55	
    56		// Health check
    57		mux.HandleFunc("GET /health", func(w http.ResponseWriter, r *http.Request) {
    58			w.WriteHeader(http.StatusOK)
    59			w.Write([]byte(`{"status":"ok"}`))
    60		})
    61	
    62		return mux
    63	}
