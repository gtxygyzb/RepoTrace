   144	func (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {
   145		var req struct {
   146			Pipeline *pipeline.Pipeline     `json:"pipeline"`
   147			Input    map[string]interface{} `json:"input"`
   148		}
   149		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   150			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   151			return
   152		}
   153		if req.Pipeline == nil || len(req.Pipeline.Steps) == 0 {
   154			writeError(w, http.StatusBadRequest, "pipeline with at least one step is required")
   155			return
   156		}
   157		if req.Input == nil {
   158			req.Input = make(map[string]interface{})
   159		}
   160	
   161		result, err := h.Pipeline.Execute(req.Pipeline, req.Input)
   162		if err != nil {
   163			writeError(w, http.StatusBadRequest, "%v", err)
   164			return
   165		}
   166		writeJSON(w, http.StatusOK, result)
   167	}
   168	
