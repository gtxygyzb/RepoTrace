    11		"time"
    12	)
    13	
    14	// Experiment groups related runs together.
    15	type Experiment struct {
    16		Name      string    `json:"name"`
    17		Runs      []*Run    `json:"runs"`
    18		CreatedAt time.Time `json:"created_at"`
    19	}
    20	
    21	// Run records a single experiment execution with parameters and metrics.
    22	type Run struct {
    23		ID         string             `json:"id"`
    24		Parameters map[string]float64 `json:"parameters"`
    25		Metrics    map[string]float64 `json:"metrics"`
    26		Tags       map[string]string  `json:"tags"`
    27		CreatedAt  time.Time          `json:"created_at"`
    28	}
    29	
    30	// Tracker manages experiments and their runs.
    31	type Tracker struct {
    32		mu          sync.RWMutex
    33		experiments map[string]*Experiment
    34		dataDir     string
    35		runCounter  int
    36	}
    37	
    38	// NewTracker creates a new experiment tracker backed by the given data directory.
    39	func NewTracker(dataDir string) *Tracker {
    40		os.MkdirAll(dataDir, 0755)
    41		t := &Tracker{
    42			experiments: make(map[string]*Experiment),
    43			dataDir:     dataDir,
    44		}
    45		t.loadAll()
    46		return t
    47	}
    48	
    49	// CreateExperiment creates a new experiment with the given name.
    50	func (t *Tracker) CreateExperiment(name string) (*Experiment, error) {
    51		t.mu.Lock()
    52		defer t.mu.Unlock()
    53	
    54		if _, exists := t.experiments[name]; exists {
    55			return nil, fmt.Errorf("experiment %q already exists", name)
    56		}
    57	
    58		exp := &Experiment{
    59			Name:      name,
    60			Runs:      make([]*Run, 0),
    61			CreatedAt: time.Now(),
    62		}
    63		t.experiments[name] = exp
    64		if err := t.saveExperiment(exp); err != nil {
    65			delete(t.experiments, name)
    66			return nil, err
    67		}
    68		return exp, nil
    69	}
    70	
    71	// LogRun adds a new run to the specified experiment.
    72	func (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {
    73		t.mu.Lock()
    74		defer t.mu.Unlock()
    75	
    76		exp, exists := t.experiments[experimentName]
    77		if !exists {
    78			return nil, fmt.Errorf("experiment %q not found", experimentName)
    79		}
    80	
    81		t.runCounter++
    82		run := &Run{
    83			ID:         fmt.Sprintf("run_%d", t.runCounter),
    84			Parameters: params,
    85			Metrics:    metrics,
    86			Tags:       tags,
    87			CreatedAt:  time.Now(),
    88		}
    89		exp.Runs = append(exp.Runs, run)
    90	
    91		if err := t.saveExperiment(exp); err != nil {
    92			exp.Runs = exp.Runs[:len(exp.Runs)-1]
    93			return nil, err
    94		}
    95		return run, nil
    96	}
    97	
    98	// GetExperiment returns the experiment with the given name.
    99	func (t *Tracker) GetExperiment(name string) (*Experiment, error) {
   100		t.mu.RLock()
   101		defer t.mu.RUnlock()
   102	
   103		exp, exists := t.experiments[name]
   104		if !exists {
   105			return nil, fmt.Errorf("experiment %q not found", name)
   106		}
   107		return exp, nil
   108	}
   109	
   110	// ListExperiments returns all experiments.
   111	func (t *Tracker) ListExperiments() []*Experiment {
   112		t.mu.RLock()
   113		defer t.mu.RUnlock()
   114	
   115		result := make([]*Experiment, 0, len(t.experiments))
   116		for _, exp := range t.experiments {
   117			result = append(result, exp)
   118		}
   119		sort.Slice(result, func(i, j int) bool {
   120			return result[i].Name < result[j].Name
   121		})
   122		return result
   123	}
   124	
   125	// AggregateMetric computes an aggregate statistic for a given metric across all runs
   126	// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.
   127	// For weighted_mean, weightParam specifies which parameter to use as weight.
   128	func (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, error) {
   129		t.mu.RLock()
   130		defer t.mu.RUnlock()
   131	
   132		exp, exists := t.experiments[experimentName]
   133		if !exists {
   134			return 0, fmt.Errorf("experiment %q not found", experimentName)
   135		}
   136	
   137		if len(exp.Runs) == 0 {
   138			return 0, fmt.Errorf("experiment %q has no runs", experimentName)
   139		}
   140	
   141		var values []float64
   142		var weights []float64
   143		for _, run := range exp.Runs {
   144			values = append(values, run.Metrics[metricName])
   145			if weightParam != "" {
   146				weights = append(weights, run.Parameters[weightParam])
   147			}
   148		}
   149	
   150		if len(values) == 0 {
   151			return 0, fmt.Errorf("no values found for metric %q", metricName)
   152		}
   153	
   154		switch aggType {
   155		case "mean":
   156			sum := 0.0
   157			for _, v := range values {
   158				sum += v
   159			}
   160			return sum / float64(len(values)), nil
   161	
   162		case "median":
   163			sorted := sortedCopy(values)
   164			n := len(sorted)
   165			if n%2 == 0 {
   166				return (sorted[n/2-1] + sorted[n/2]) / 2, nil
   167			}
   168			return sorted[n/2], nil
   169	
   170		case "p95":
   171			sorted := sortedCopy(values)
   172			return percentile(sorted, 0.95), nil
   173	
   174		case "p99":
   175			sorted := sortedCopy(values)
   176			return percentile(sorted, 0.99), nil
   177	
   178		case "weighted_mean":
   179			if len(weights) == 0 || len(weights) != len(values) {
   180				return 0, fmt.Errorf("weighted_mean requires weight parameter")
   181			}
   182			weightedSum := 0.0
   183			for i, v := range values {
   184				weightedSum += v * weights[i]
   185			}
   186			return weightedSum / float64(len(values)), nil
   187	
   188		default:
   189			return 0, fmt.Errorf("unknown aggregation type %q", aggType)
   190		}
   191	}
   192	
   193	func percentile(sorted []float64, p float64) float64 {
   194		n := len(sorted)
   195		if n == 0 {
   196			return 0
   197		}
   198		if n == 1 {
   199			return sorted[0]
   200		}
   201		rank := p * float64(n)
   202		lower := int(math.Floor(rank))
   203		upper := int(math.Ceil(rank))
   204		if lower == upper {
   205			return sorted[lower]
   206		}
   207		frac := rank - float64(lower)
   208		return sorted[lower]*(1-frac) + sorted[upper]*frac
   209	}
   210	
   211	func sortedCopy(values []float64) []float64 {
   212		s := make([]float64, len(values))
   213		copy(s, values)
   214		sort.Float64s(s)
   215		return s
   216	}
   217	
   218	func (t *Tracker) loadAll() {
   219		entries, err := os.ReadDir(t.dataDir)
   220		if err != nil {
   221			return
   222		}
   223		for _, entry := range entries {
   224			if !entry.IsDir() && filepath.Ext(entry.Name()) == ".json" {
   225				data, err := os.ReadFile(filepath.Join(t.dataDir, entry.Name()))
   226				if err != nil {
   227					continue
   228				}
   229				var exp Experiment
   230				if err := json.Unmarshal(data, &exp); err != nil {
   231					continue
   232				}
   233				t.experiments[exp.Name] = &exp
   234				for _, r := range exp.Runs {
   235					_ = r
   236					t.runCounter++
   237				}
   238			}
   239		}
   240	}
   241	
   242	func (t *Tracker) saveExperiment(exp *Experiment) error {
   243		data, err := json.MarshalIndent(exp, "", "  ")
   244		if err != nil {
   245			return err
   246		}
   247		filename := filepath.Join(t.dataDir, exp.Name+".json")
   248		return os.WriteFile(filename, data, 0644)
   249	}
[?2004hroot@n30009:/app# nl -ba internal/pipeline/engine.go | sed -n '1,280p'
[?2004l     1	package pipeline
     2	
     3	import (
     4		"fmt"
     5		"time"
     6	)
     7	
     8	// StepType identifies the kind of processing a pipeline step performs.
     9	type StepType string
    10	
    11	const (
    12		StepTransform StepType = "transform"
    13		StepValidate  StepType = "validate"
    14		StepAggregate StepType = "aggregate"
    15		StepExport    StepType = "export"
    16		StepFilter    StepType = "filter"
    17	)
    18	
    19	// Step defines a single unit of work in a pipeline.
    20	type Step struct {
    21		Name         string                 `json:"name"`
    22		Type         StepType               `json:"type"`
    23		Config       map[string]interface{} `json:"config"`
    24		Dependencies []string               `json:"dependencies"`
    25	}
    26	
    27	// Pipeline defines a named sequence of dependent steps.
    28	type Pipeline struct {
    29		Name  string  `json:"name"`
    30		Steps []*Step `json:"steps"`
    31	}
    32	
    33	// StepResult records the outcome of executing a single step.
    34	type StepResult struct {
    35		StepName   string                 `json:"step_name"`
    36		StepType   StepType               `json:"step_type"`
    37		Status     string                 `json:"status"`
    38		Output     map[string]interface{} `json:"output,omitempty"`
    39		Error      string                 `json:"error,omitempty"`
    40		DurationMs float64                `json:"duration_ms"`
    41	}
    42	
    43	// PipelineResult records the outcome of executing an entire pipeline.
    44	type PipelineResult struct {
    45		PipelineName string        `json:"pipeline_name"`
    46		Status       string        `json:"status"`
    47		Steps        []*StepResult `json:"steps"`
    48		TotalTimeMs  float64       `json:"total_time_ms"`
    49	}
    50	
    51	// Engine executes pipelines by resolving step dependencies and running each step.
    52	type Engine struct {
    53		stepExecutors map[StepType]StepExecutor
    54	}
    55	
    56	// StepExecutor is the function signature for executing a pipeline step.
    57	type StepExecutor func(config, input map[string]interface{}) (map[string]interface{}, error)
    58	
    59	// NewEngine creates a pipeline engine with built-in step executors.
    60	func NewEngine() *Engine {
    61		e := &Engine{
    62			stepExecutors: make(map[StepType]StepExecutor),
    63		}
    64		e.stepExecutors[StepTransform] = ExecuteTransform
    65		e.stepExecutors[StepValidate] = ExecuteValidate
    66		e.stepExecutors[StepAggregate] = ExecuteAggregate
    67		e.stepExecutors[StepExport] = ExecuteExport
    68		e.stepExecutors[StepFilter] = ExecuteFilter
    69		return e
    70	}
    71	
    72	// Execute runs a pipeline with the given initial input data.
    73	func (e *Engine) Execute(p *Pipeline, initialInput map[string]interface{}) (*PipelineResult, error) {
    74		ordered, err := topologicalSort(p.Steps)
    75		if err != nil {
    76			return nil, fmt.Errorf("dependency resolution failed: %w", err)
    77		}
    78	
    79		pipelineStart := time.Now()
    80		result := &PipelineResult{
    81			PipelineName: p.Name,
    82			Status:       "success",
    83			Steps:        make([]*StepResult, 0, len(ordered)),
    84		}
    85	
    86		stepOutputs := make(map[string]map[string]interface{})
    87		var lastOutput map[string]interface{}
    88	
    89		for _, step := range ordered {
    90			stepStart := time.Now()
    91	
    92			// Determine input for this step
    93			var input map[string]interface{}
    94			if len(step.Dependencies) == 0 {
    95				input = initialInput
    96			} else {
    97				input = lastOutput
    98			}
    99	
   100			// Find and run the executor
   101			executor, ok := e.stepExecutors[step.Type]
   102			if !ok {
   103				sr := &StepResult{
   104					StepName:   step.Name,
   105					StepType:   step.Type,
   106					Status:     "failed",
   107					Error:      fmt.Sprintf("unknown step type: %s", step.Type),
   108					DurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,
   109				}
   110				result.Steps = append(result.Steps, sr)
   111				result.Status = "failed"
   112				result.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0
   113				return result, nil
   114			}
   115	
   116			output, err := executor(step.Config, input)
   117			duration := float64(time.Since(stepStart).Microseconds()) / 1000.0
   118	
   119			sr := &StepResult{
   120				StepName:   step.Name,
   121				StepType:   step.Type,
   122				DurationMs: duration,
   123			}
   124	
   125			if err != nil {
   126				sr.Status = "failed"
   127				sr.Error = err.Error()
   128				result.Steps = append(result.Steps, sr)
   129				result.Status = "failed"
   130				result.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0
   131				return result, nil
   132			}
   133	
   134			sr.Status = "success"
   135			sr.Output = output
   136			result.Steps = append(result.Steps, sr)
   137	
   138			stepOutputs[step.Name] = output
   139			lastOutput = output
   140		}
   141	
   142		result.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0
   143		return result, nil
   144	}
   145	
   146	// topologicalSort orders steps so that dependencies are executed first.
   147	// Returns an error if a cycle is detected.
   148	func topologicalSort(steps []*Step) ([]*Step, error) {
   149		stepMap := make(map[string]*Step)
   150		inDegree := make(map[string]int)
   151	
   152		for _, s := range steps {
   153			stepMap[s.Name] = s
   154			inDegree[s.Name] = 0
   155		}
   156	
   157		// Build in-degree counts
   158		for _, s := range steps {
   159			for _, dep := range s.Dependencies {
   160				if _, ok := stepMap[dep]; !ok {
   161					return nil, fmt.Errorf("step %q depends on unknown step %q", s.Name, dep)
   162				}
   163				inDegree[s.Name]++
   164			}
   165		}
   166	
   167		// Kahn's algorithm
   168		var queue []*Step
   169		for _, s := range steps {
   170			if inDegree[s.Name] == 0 {
   171				queue = append(queue, s)
   172			}
   173		}
   174	
   175		var ordered []*Step
   176		for len(queue) > 0 {
   177			current := queue[0]
   178			queue = queue[1:]
   179			ordered = append(ordered, current)
   180	
   181			// Find steps that depend on current
   182			for _, s := range steps {
   183				for _, dep := range s.Dependencies {
   184					if dep == current.Name {
   185						inDegree[s.Name]--
   186						if inDegree[s.Name] == 0 {
   187							queue = append(queue, s)
   188						}
   189					}
   190				}
   191			}
   192		}
   193	
   194		if len(ordered) != len(steps) {
   195			return nil, fmt.Errorf("cycle detected in pipeline dependencies")
   196		}
   197	
   198		return ordered, nil
   199	}
   200	
   201	// mergeOutputs collects and merges data arrays from the specified dependency outputs.
   202	func mergeOutputs(stepOutputs map[string]map[string]interface{}, deps []string) map[string]interface{} {
   203		merged := make(map[string]interface{})
   204		var mergedData []interface{}
   205	
   206		for _, dep := range deps {
   207			if output, ok := stepOutputs[dep]; ok {
   208				if data, ok := output["data"]; ok {
   209					switch d := data.(type) {
   210					case []interface{}:
   211						mergedData = append(mergedData, d...)
   212					case []float64:
   213						for _, v := range d {
   214							mergedData = append(mergedData, v)
   215						}
   216					default:
   217						mergedData = append(mergedData, data)
   218					}
   219				}
   220				// Also carry non-data fields keyed by dependency name
   221				for k, v := range output {
   222					if k != "data" {
   223						merged[dep+"_"+k] = v
   224					}
   225				}
   226			}
   227		}
   228	
   229		if len(mergedData) > 0 {
   230			merged["data"] = mergedData
   231		}
   232		return merged
   233	}
