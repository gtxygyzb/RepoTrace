    42	func (h *Handlers) ListModels(w http.ResponseWriter, r *http.Request) {
    43		var filter *registry.ModelFilter
    44		framework := r.URL.Query().Get("framework")
    45		tag := r.URL.Query().Get("tag")
    46		if framework != "" || tag != "" {
    47			filter = &registry.ModelFilter{Framework: framework, Tag: tag}
    48		}
    49	
    50		models, err := h.Registry.ListModels(filter)
    51		if err != nil {
    52			writeError(w, http.StatusInternalServerError, "%v", err)
    53			return
