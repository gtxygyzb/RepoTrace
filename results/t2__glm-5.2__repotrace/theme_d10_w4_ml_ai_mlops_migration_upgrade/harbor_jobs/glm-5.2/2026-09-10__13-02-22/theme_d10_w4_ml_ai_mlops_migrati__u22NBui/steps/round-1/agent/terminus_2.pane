	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, struct {
		*registry.Version
		Annotations map[string]string `json:"annotations"`
	}{
		Version:     version,
		Annotations: h.Registry.AnnotationsMap(modelName, num),
	})
}

func (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {
	modelName := r.PathValue("name")
	numStr := r.PathValue("num")
	num, err := strconv.Atoi(numStr)
	if err != nil {
		writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
		return
	}

	var req struct {
		Stage string `json:"stage"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	if req.Stage == "" {
		writeError(w, http.StatusBadRequest, "stage is required")
		return
	}

	if err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {
		writeError(w, http.StatusBadRequest, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]string{"status": "promoted"})
}

// --- Pipeline Handlers ---

func (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Name     string                 `json:"name"`
		Steps    []*pipeline.Step       `json:"steps"`
		Input    map[string]interface{} `json:"input"`
		Pipeline *pipeline.Pipeline     `json:"pipeline"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	p := req.Pipeline
	if p == nil {
		p = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}
	}
	if p == nil || len(p.Steps) == 0 {
		writeError(w, http.StatusBadRequest, "pipeline with at least one step is required")
		return
	}
	if req.Input == nil {
		req.Input = make(map[string]interface{})
	}

	result, err := h.Pipeline.Execute(p, req.Input)
	if err != nil {
		writeError(w, http.StatusBadRequest, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, result)
}

// --- Experiment Handlers ---

func (h *Handlers) CreateExperiment(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Name string `json:"name"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	if req.Name == "" {
		writeError(w, http.StatusBadRequest, "name is required")
		return
	}

	exp, err := h.Experiment.CreateExperiment(req.Name)
	if err != nil {
		writeError(w, http.StatusConflict, "%v", err)
		return
	}
	writeJSON(w, http.StatusCreated, exp)
}

func (h *Handlers) ListExperiments(w http.ResponseWriter, r *http.Request) {
	exps := h.Experiment.ListExperiments()
	writeJSON(w, http.StatusOK, exps)
}

func (h *Handlers) GetExperiment(w http.ResponseWriter, r *http.Request) {
	name := r.PathValue("name")
	exp, err := h.Experiment.GetExperiment(name)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, exp)
}

func (h *Handlers) LogRun(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")

	var req struct {
		Parameters map[string]float64 `json:"parameters"`
		Metrics    map[string]float64 `json:"metrics"`
		Tags       map[string]string  `json:"tags"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}

	run, err := h.Experiment.LogRun(expName, req.Parameters, req.Metrics, req.Tags)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusCreated, run)
}

