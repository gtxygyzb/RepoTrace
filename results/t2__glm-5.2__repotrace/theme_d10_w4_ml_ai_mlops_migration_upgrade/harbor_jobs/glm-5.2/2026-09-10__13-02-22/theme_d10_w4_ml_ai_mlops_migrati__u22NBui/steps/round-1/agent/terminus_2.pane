   177	// Execute runs a pipeline with the given initial input data.
   178	func (e *Engine) Execute(p *Pipeline, initialInput map[string]interface{}) (*PipelineResult, error) {
   179		ordered, err := topologicalSort(p.Steps)
   180		if err != nil {
   181			return nil, fmt.Errorf("dependency resolution failed: %w", err)
   182		}
   183	
   184		pipelineStart := time.Now()
   185		result := &PipelineResult{
   186			PipelineName: p.Name,
   187			Status:       "success",
   188			Steps:        make([]*StepResult, 0, len(ordered)),
   189		}
   190	
   191		stepOutputs := make(map[string]map[string]interface{})
   192		variables := make(map[string]float64)
   193		variableSetter := make(map[string]string)
   194		allDeps := computeTransitiveDependencies(p.Steps)
   195	
   196		for _, step := range ordered {
   197			stepStart := time.Now()
   198	
   199			resolvedConfig, err := resolveVariables(step.Config, variables, variableSetter, allDeps[step.Name])
   200			if err != nil {
   201				sr := &StepResult{
   202					StepName:   step.Name,
   203					StepType:   step.Type,
   204					Status:     "failed",
   205					Error:      err.Error(),
   206					DurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,
   207				}
   208				result.Steps = append(result.Steps, sr)
   209				result.Status = "failed"
   210				result.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0
   211				return result, nil
   212			}
   213	
   214			// Determine input for this step
   215			var input map[string]interface{}
   216			if len(step.Dependencies) == 0 {
   217				input = initialInput
   218			} else {
   219				input = mergeDependencyOutputs(step.Dependencies, stepOutputs)
   220			}
   221	
   222			// Check skip condition before executing the step.
   223			skip, serr := shouldSkipStep(resolvedConfig, variables)
   224			if serr != nil {
   225				sr := &StepResult{
   226					StepName:   step.Name,
   227					StepType:   step.Type,
   228					Status:     "failed",
   229					Error:      serr.Error(),
   230					DurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,
   231				}
   232				result.Steps = append(result.Steps, sr)
   233				result.Status = "failed"
   234				result.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0
   235				return result, nil
   236			}
   237			if skip {
   238				duration := float64(time.Since(stepStart).Microseconds()) / 1000.0
   239				output := map[string]interface{}{"status": "skipped", "data": []interface{}{}}
   240				sr := &StepResult{
   241					StepName:   step.Name,
   242					StepType:   step.Type,
   243					Status:     "skipped",
   244					Output:     output,
   245					DurationMs: duration,
   246				}
   247				result.Steps = append(result.Steps, sr)
   248				stepOutputs[step.Name] = output
   249				continue
   250			}
   251	
   252			// Find and run the executor
   253			executor, ok := e.stepExecutors[step.Type]
   254			if !ok {
   255				sr := &StepResult{
   256					StepName:   step.Name,
   257					StepType:   step.Type,
   258					Status:     "failed",
   259					Error:      fmt.Sprintf("unknown step type: %s", step.Type),
   260					DurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,
