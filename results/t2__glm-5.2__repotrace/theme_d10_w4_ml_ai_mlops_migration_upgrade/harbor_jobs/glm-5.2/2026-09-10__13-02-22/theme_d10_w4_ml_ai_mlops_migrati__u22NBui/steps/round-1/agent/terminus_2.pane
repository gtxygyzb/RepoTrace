   106	// CreateVersion adds a new version to the specified model.
   107	func (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {
   108		r.mu.Lock()
   109		defer r.mu.Unlock()
   110	
   111		model, exists := r.models[modelName]
   112		if !exists {
   113			return nil, fmt.Errorf("model %q not found", modelName)
   114		}
   115	
   116		nextNum := 1
   117		for _, v := range model.Versions {
   118			if v.Number >= nextNum {
   119				nextNum = v.Number + 1
   120			}
   121		}
   122	
   123		version := &Version{
   124			Number:      nextNum,
   125			Stage:       StageDevelopment,
   126			Metrics:     metrics,
   127			Tags:        tags,
   128			ModelConfig: modelConfig,
   129			CreatedAt:   time.Now(),
   130		}
   131		model.Versions = append(model.Versions, version)
   132		model.UpdatedAt = time.Now()
   133	
   134		if err := r.saveModel(model); err != nil {
   135			model.Versions = model.Versions[:len(model.Versions)-1]
   136			return nil, err
   137		}
   138		return version, nil
   139	}
