   132		if len(duplicateNames) > 0 {
   133			result.Valid = false
   134			for name := range duplicateNames {
   135				result.Errors = append(result.Errors, fmt.Sprintf("duplicate step name: %s", name))
   136			}
   137		}
   138	
   139		for _, step := range p.Steps {
   140			if step == nil {
   141				continue
   142			}
   143			if _, exists := e.stepExecutors[step.Type]; !exists {
   144				result.Valid = false
   145				result.Errors = append(result.Errors, fmt.Sprintf("unknown step type: %s", step.Type))
   146			}
   147			for _, dep := range step.Dependencies {
   148				if !seen[dep] {
   149					result.Valid = false
   150					result.Errors = append(result.Errors, fmt.Sprintf("step %s depends on unknown step: %s", step.Name, dep))
   151				}
   152			}
   153		}
   154	
   155		ordered, err := topologicalSort(p.Steps)
   156		if err != nil {
   157			result.Valid = false
   158			if strings.Contains(err.Error(), "cycle") {
   159				result.Errors = append(result.Errors, "dependency cycle detected")
   160			}
   161		}
   162	
   163		if result.Valid && err == nil {
   164			for _, step := range ordered {
   165				result.ExecutionOrder = append(result.ExecutionOrder, step.Name)
   166			}
   167		}
   168	
   169		if len(result.Errors) > 0 {
   170			result.Valid = false
   171			result.ExecutionOrder = []string{}
   172		}
   173	
   174		return result
   175	}
