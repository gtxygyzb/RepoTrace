func (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")
	metricName := r.PathValue("metric")
	aggType := r.URL.Query().Get("type")
	weightParam := r.URL.Query().Get("weight_param")
	tagFilters := map[string]string{}
	for _, filter := range r.URL.Query()["tag_filter"] {
		parts := strings.SplitN(filter, ":", 2)
		if len(parts) != 2 {
			writeError(w, http.StatusBadRequest, "invalid tag_filter %q, expected key:value", filter)
			return
		}
		tagFilters[parts[0]] = parts[1]
	}

	if aggType == "" {
		writeError(w, http.StatusBadRequest, "query parameter 'type' is required")
		return
	}

	result, count, runIDs, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam, tagFilters)
	if err != nil {
		writeError(w, http.StatusBadRequest, "%v", err)
		return
	}

	writeJSON(w, http.StatusOK, map[string]interface{}{
		"experiment": expName,
		"metric":     metricName,
		"type":       aggType,
		"value":      result,
		"count":      count,
		"run_ids":    runIDs,
	})
}

func (h *Handlers) GetMetricHistory(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")
	metricName := r.PathValue("metric")
	history, err := h.Experiment.MetricHistory(expName, metricName)
	if err != nil {
		if strings.Contains(err.Error(), "not found") {
			writeError(w, http.StatusNotFound, "%v", err)
		} else {
			writeError(w, http.StatusBadRequest, "%v", err)
		}
		return
	}
	writeJSON(w, http.StatusOK, map[string]interface{}{
		"experiment": expName,
		"metric":     metricName,
		"history":    history,
		"count":      len(history),
	})
}

func (h *Handlers) UpdateRun(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")
	runID := r.PathValue("id")
	var req struct {
		Metrics map[string]float64 `json:"metrics"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	run, err := h.Experiment.UpdateRunMetrics(expName, runID, req.Metrics)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, run)
}

func (h *Handlers) SearchRuns(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")
	var req struct {
		Filters []experiment.MetricFilter `json:"filters"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	runs, err := h.Experiment.SearchRuns(expName, req.Filters)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]interface{}{
		"runs":  runs,
		"count": len(runs),
	})
}

// --- Model Version Comparison Handler ---

func (h *Handlers) CompareVersionMetrics(w http.ResponseWriter, r *http.Request) {
	modelName := r.PathValue("name")
	versionParam := r.URL.Query().Get("versions")
	if versionParam == "" {
		writeError(w, http.StatusBadRequest, "query parameter 'versions' is required")
		return
	}

	parts := strings.Split(versionParam, ",")
	seen := map[int]bool{}
	versionNums := make([]int, 0, len(parts))
	for _, p := range parts {
		num, err := strconv.Atoi(strings.TrimSpace(p))
		if err != nil {
			writeError(w, http.StatusBadRequest, "invalid version number: %q", p)
			return
		}
		if seen[num] {
			writeError(w, http.StatusBadRequest, "duplicate version number: %d", num)
			return
		}
		seen[num] = true
		versionNums = append(versionNums, num)
	}
	if len(versionNums) < 2 {
		writeError(w, http.StatusBadRequest, "at least 2 versions are required for comparison")
		return
	}

	model, err := h.Registry.GetModel(modelName)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}

	sort.Ints(versionNums)
	versionMap := map[int]*registry.Version{}
	for _, v := range model.Versions {
		versionMap[v.Number] = v
	}

	versions := make([]map[string]interface{}, 0, len(versionNums))
	for _, num := range versionNums {
		v, ok := versionMap[num]
		if !ok {
			writeError(w, http.StatusBadRequest, "version %d does not exist for model %q", num, modelName)
			return
		}
		versions = append(versions, map[string]interface{}{
			"number":  v.Number,
			"stage":   v.Stage,
			"metrics": v.Metrics,
		})
	}

	metricSummary := map[string]map[string]interface{}{}
	metricValues := map[string][]float64{}
	for _, v := range versions {
		metrics, _ := v["metrics"].(map[string]float64)
		for name, val := range metrics {
			metricValues[name] = append(metricValues[name], val)
		}
	}

	for name, vals := range metricValues {
		if len(vals) == 0 {
			continue
		}
		minVal := vals[0]
		maxVal := vals[0]
		sum := 0.0
		for _, val := range vals {
			if val < minVal {
				minVal = val
			}
			if val > maxVal {
				maxVal = val
			}
			sum += val
		}
		first := vals[0]
		last := vals[len(vals)-1]
		improvement := last - first
		trend := "stable"
		if improvement > 0 {
			trend = "improving"
		} else if improvement < 0 {
			trend = "degrading"
		}
		metricSummary[name] = map[string]interface{}{
			"min":         minVal,
			"max":         maxVal,
			"first":       first,
			"last":        last,
			"improvement": improvement,
			"mean":        sum / float64(len(vals)),
			"trend":       trend,
		}
	}

	writeJSON(w, http.StatusOK, map[string]interface{}{
		"model":          modelName,
		"versions":       versions,
		"metric_summary": metricSummary,
	})
}

