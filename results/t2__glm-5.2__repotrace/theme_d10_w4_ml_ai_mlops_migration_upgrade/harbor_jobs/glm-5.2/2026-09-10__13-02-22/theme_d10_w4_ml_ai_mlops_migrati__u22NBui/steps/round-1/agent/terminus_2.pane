// --- Model Registry Handlers ---

func (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Name        string   `json:"name"`
		Framework   string   `json:"framework"`
		Description string   `json:"description"`
		Tags        []string `json:"tags"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	if req.Name == "" {
		writeError(w, http.StatusBadRequest, "name is required")
		return
	}

	model, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)
	if err != nil {
		writeError(w, http.StatusConflict, "%v", err)
		return
	}
	writeJSON(w, http.StatusCreated, model)
}

func (h *Handlers) ListModels(w http.ResponseWriter, r *http.Request) {
	var filter *registry.ModelFilter
	framework := r.URL.Query().Get("framework")
	tag := r.URL.Query().Get("tag")
	if framework != "" || tag != "" {
		filter = &registry.ModelFilter{Framework: framework, Tag: tag}
	}

	models, err := h.Registry.ListModels(filter)
	if err != nil {
		writeError(w, http.StatusInternalServerError, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, models)
}

func (h *Handlers) DeleteModel(w http.ResponseWriter, r *http.Request) {
	name := r.PathValue("name")
	if err := h.Registry.DeleteModel(name); err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	_ = h.Serving.UnloadModel(name)
	writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
}

func (h *Handlers) GetModel(w http.ResponseWriter, r *http.Request) {
	name := r.PathValue("name")
	model, err := h.Registry.GetModel(name)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	stageSummary := map[string]int{
		"development": 0,
		"staging":     0,
		"production":  0,
		"archived":    0,
	}
	for _, v := range model.Versions {
		stageSummary[string(v.Stage)]++
	}
	writeJSON(w, http.StatusOK, map[string]interface{}{
		"name":          model.Name,
		"framework":     model.Framework,
		"description":   model.Description,
		"tags":          model.Tags,
		"versions":      model.Versions,
		"created_at":    model.CreatedAt,
		"updated_at":    model.UpdatedAt,
		"stage_summary": stageSummary,
	})
}

func (h *Handlers) CreateVersion(w http.ResponseWriter, r *http.Request) {
	modelName := r.PathValue("name")

	var req struct {
		Metrics     map[string]float64     `json:"metrics"`
		Tags        []string               `json:"tags"`
		ModelConfig map[string]interface{} `json:"model_config"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}

	version, err := h.Registry.CreateVersion(modelName, req.Metrics, req.Tags, req.ModelConfig)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusCreated, version)
}

func (h *Handlers) GetVersion(w http.ResponseWriter, r *http.Request) {
	modelName := r.PathValue("name")
	numStr := r.PathValue("num")
	num, err := strconv.Atoi(numStr)
	if err != nil {
		writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
		return
	}

	version, err := h.Registry.GetVersion(modelName, num)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, struct {
		*registry.Version
		Annotations map[string]string `json:"annotations"`
	}{
		Version:     version,
		Annotations: h.Registry.AnnotationsMap(modelName, num),
	})
}

func (h *Handlers) PromoteVersion(w http.ResponseWriter, r *http.Request) {
	modelName := r.PathValue("name")
	numStr := r.PathValue("num")
	num, err := strconv.Atoi(numStr)
	if err != nil {
		writeError(w, http.StatusBadRequest, "invalid version number: %v", err)
		return
	}

	var req struct {
		Stage string `json:"stage"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	if req.Stage == "" {
		writeError(w, http.StatusBadRequest, "stage is required")
		return
	}

	if err := h.Registry.PromoteVersion(modelName, num, registry.Stage(req.Stage)); err != nil {
		writeError(w, http.StatusBadRequest, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]string{"status": "promoted"})
}

// --- Pipeline Handlers ---

func (h *Handlers) ExecutePipeline(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Name     string                 `json:"name"`
		Steps    []*pipeline.Step       `json:"steps"`
		Input    map[string]interface{} `json:"input"`
		Pipeline *pipeline.Pipeline     `json:"pipeline"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	p := req.Pipeline
	if p == nil {
		p = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}
	}
	if p == nil || len(p.Steps) == 0 {
		writeError(w, http.StatusBadRequest, "pipeline with at least one step is required")
		return
	}
	if req.Input == nil {
		req.Input = make(map[string]interface{})
	}

	result, err := h.Pipeline.Execute(p, req.Input)
	if err != nil {
		writeError(w, http.StatusBadRequest, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, result)
}

// --- Experiment Handlers ---

func (h *Handlers) CreateExperiment(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Name string `json:"name"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	if req.Name == "" {
		writeError(w, http.StatusBadRequest, "name is required")
		return
	}

	exp, err := h.Experiment.CreateExperiment(req.Name)
	if err != nil {
		writeError(w, http.StatusConflict, "%v", err)
		return
[?2004hroot@n30009:/app# sed -n '220,520p' internal/api/handlers.go
[?2004l		return
	}
	writeJSON(w, http.StatusCreated, exp)
}

func (h *Handlers) ListExperiments(w http.ResponseWriter, r *http.Request) {
	exps := h.Experiment.ListExperiments()
	writeJSON(w, http.StatusOK, exps)
}

func (h *Handlers) GetExperiment(w http.ResponseWriter, r *http.Request) {
	name := r.PathValue("name")
	exp, err := h.Experiment.GetExperiment(name)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, exp)
}

func (h *Handlers) LogRun(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")

	var req struct {
		Parameters map[string]float64 `json:"parameters"`
		Metrics    map[string]float64 `json:"metrics"`
		Tags       map[string]string  `json:"tags"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}

	run, err := h.Experiment.LogRun(expName, req.Parameters, req.Metrics, req.Tags)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusCreated, run)
}

func (h *Handlers) AggregateMetric(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")
	metricName := r.PathValue("metric")
	aggType := r.URL.Query().Get("type")
	weightParam := r.URL.Query().Get("weight_param")
	tagFilters := map[string]string{}
	for _, filter := range r.URL.Query()["tag_filter"] {
		parts := strings.SplitN(filter, ":", 2)
		if len(parts) != 2 {
			writeError(w, http.StatusBadRequest, "invalid tag_filter %q, expected key:value", filter)
			return
		}
		tagFilters[parts[0]] = parts[1]
	}

	if aggType == "" {
		writeError(w, http.StatusBadRequest, "query parameter 'type' is required")
		return
	}

	result, count, runIDs, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam, tagFilters)
	if err != nil {
		writeError(w, http.StatusBadRequest, "%v", err)
		return
	}

	writeJSON(w, http.StatusOK, map[string]interface{}{
		"experiment": expName,
		"metric":     metricName,
		"type":       aggType,
		"value":      result,
		"count":      count,
		"run_ids":    runIDs,
	})
}

func (h *Handlers) GetMetricHistory(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")
	metricName := r.PathValue("metric")
	history, err := h.Experiment.MetricHistory(expName, metricName)
	if err != nil {
		if strings.Contains(err.Error(), "not found") {
			writeError(w, http.StatusNotFound, "%v", err)
		} else {
			writeError(w, http.StatusBadRequest, "%v", err)
		}
		return
	}
	writeJSON(w, http.StatusOK, map[string]interface{}{
		"experiment": expName,
		"metric":     metricName,
		"history":    history,
		"count":      len(history),
	})
}

func (h *Handlers) UpdateRun(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")
	runID := r.PathValue("id")
	var req struct {
		Metrics map[string]float64 `json:"metrics"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	run, err := h.Experiment.UpdateRunMetrics(expName, runID, req.Metrics)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, run)
}

func (h *Handlers) SearchRuns(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")
	var req struct {
		Filters []experiment.MetricFilter `json:"filters"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	runs, err := h.Experiment.SearchRuns(expName, req.Filters)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]interface{}{
		"runs":  runs,
		"count": len(runs),
	})
}

// --- Model Version Comparison Handler ---

func (h *Handlers) CompareVersionMetrics(w http.ResponseWriter, r *http.Request) {
	modelName := r.PathValue("name")
	versionParam := r.URL.Query().Get("versions")
	if versionParam == "" {
		writeError(w, http.StatusBadRequest, "query parameter 'versions' is required")
		return
	}

	parts := strings.Split(versionParam, ",")
	seen := map[int]bool{}
	versionNums := make([]int, 0, len(parts))
	for _, p := range parts {
		num, err := strconv.Atoi(strings.TrimSpace(p))
		if err != nil {
			writeError(w, http.StatusBadRequest, "invalid version number: %q", p)
			return
		}
		if seen[num] {
			writeError(w, http.StatusBadRequest, "duplicate version number: %d", num)
			return
		}
		seen[num] = true
		versionNums = append(versionNums, num)
	}
	if len(versionNums) < 2 {
		writeError(w, http.StatusBadRequest, "at least 2 versions are required for comparison")
		return
	}

	model, err := h.Registry.GetModel(modelName)
	if err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}

	sort.Ints(versionNums)
	versionMap := map[int]*registry.Version{}
	for _, v := range model.Versions {
		versionMap[v.Number] = v
	}

	versions := make([]map[string]interface{}, 0, len(versionNums))
	for _, num := range versionNums {
		v, ok := versionMap[num]
		if !ok {
			writeError(w, http.StatusBadRequest, "version %d does not exist for model %q", num, modelName)
			return
		}
		versions = append(versions, map[string]interface{}{
			"number":  v.Number,
			"stage":   v.Stage,
			"metrics": v.Metrics,
		})
	}

	metricSummary := map[string]map[string]interface{}{}
	metricValues := map[string][]float64{}
	for _, v := range versions {
		metrics, _ := v["metrics"].(map[string]float64)
		for name, val := range metrics {
			metricValues[name] = append(metricValues[name], val)
		}
	}

	for name, vals := range metricValues {
		if len(vals) == 0 {
			continue
		}
		minVal := vals[0]
		maxVal := vals[0]
		sum := 0.0
		for _, val := range vals {
			if val < minVal {
				minVal = val
			}
			if val > maxVal {
				maxVal = val
			}
			sum += val
		}
		first := vals[0]
		last := vals[len(vals)-1]
		improvement := last - first
		trend := "stable"
		if improvement > 0 {
			trend = "improving"
		} else if improvement < 0 {
			trend = "degrading"
		}
		metricSummary[name] = map[string]interface{}{
			"min":         minVal,
			"max":         maxVal,
			"first":       first,
			"last":        last,
			"improvement": improvement,
			"mean":        sum / float64(len(vals)),
			"trend":       trend,
		}
	}

	writeJSON(w, http.StatusOK, map[string]interface{}{
		"model":          modelName,
		"versions":       versions,
		"metric_summary": metricSummary,
	})
}

// --- Experiment Run Deletion Handler ---

func (h *Handlers) DeleteRun(w http.ResponseWriter, r *http.Request) {
	expName := r.PathValue("name")
	runID := r.PathValue("id")
	if err := h.Experiment.DeleteRun(expName, runID); err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
}

// --- Serving Handlers ---

func (h *Handlers) LoadModel(w http.ResponseWriter, r *http.Request) {
	var req struct {
		ModelName  string `json:"model_name"`
		VersionNum int    `json:"version_num"`
		Stage      string `json:"stage"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
		return
	}
	if req.ModelName == "" {
		writeError(w, http.StatusBadRequest, "model_name is required")
		return
	}

	if err := h.Serving.LoadModel(req.ModelName, req.VersionNum, req.Stage); err != nil {
		writeError(w, http.StatusBadRequest, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]string{"status": "loaded"})
}

func (h *Handlers) UnloadModel(w http.ResponseWriter, r *http.Request) {
	name := r.PathValue("name")
	if err := h.Serving.UnloadModel(name); err != nil {
		writeError(w, http.StatusNotFound, "%v", err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]string{"status": "unloaded"})
}

func (h *Handlers) ListLoadedModels(w http.ResponseWriter, r *http.Request) {
	models := h.Serving.ListLoaded()
	writeJSON(w, http.StatusOK, models)
}

