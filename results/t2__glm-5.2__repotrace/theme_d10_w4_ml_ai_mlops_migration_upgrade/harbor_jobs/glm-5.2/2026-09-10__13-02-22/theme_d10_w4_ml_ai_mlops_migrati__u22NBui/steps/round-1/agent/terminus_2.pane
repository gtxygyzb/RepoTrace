   217	func (h *Handlers) ExecuteTemplate(w http.ResponseWriter, r *http.Request) {
   218		name := r.PathValue("name")
   219		tmpl, ok := h.Templates.Get(name)
   220		if !ok {
   221			writeError(w, http.StatusNotFound, "template %q not found", name)
   222			return
   223		}
   224		var req struct {
   225			Input  map[string]interface{} `json:"input"`
   226			Params map[string]interface{} `json:"params"`
   227		}
   228		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   229			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   230			return
   231		}
   232		p, err := substituteParameters(tmpl, req.Params)
   233		if err != nil {
   234			writeError(w, http.StatusBadRequest, "%v", err)
   235			return
   236		}
   237		if req.Input == nil {
   238			req.Input = make(map[string]interface{})
   239		}
   240		result, err := h.Pipeline.Execute(p, req.Input)
   241		if err != nil {
   242			writeError(w, http.StatusBadRequest, "%v", err)
   243			return
   244		}
   245		writeJSON(w, http.StatusOK, result)
   246	}
