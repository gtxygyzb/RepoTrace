[?2004lpackage pipeline

import (
	"fmt"
	"time"
)

// StepType identifies the kind of processing a pipeline step performs.
type StepType string

const (
	StepTransform StepType = "transform"
	StepValidate  StepType = "validate"
	StepAggregate StepType = "aggregate"
	StepExport    StepType = "export"
	StepFilter    StepType = "filter"
)

// Step defines a single unit of work in a pipeline.
type Step struct {
	Name         string                 `json:"name"`
	Type         StepType               `json:"type"`
	Config       map[string]interface{} `json:"config"`
	Dependencies []string               `json:"dependencies"`
}

// Pipeline defines a named sequence of dependent steps.
type Pipeline struct {
	Name  string  `json:"name"`
	Steps []*Step `json:"steps"`
}

// StepResult records the outcome of executing a single step.
type StepResult struct {
	StepName   string                 `json:"step_name"`
	StepType   StepType               `json:"step_type"`
	Status     string                 `json:"status"`
	Output     map[string]interface{} `json:"output,omitempty"`
	Error      string                 `json:"error,omitempty"`
	DurationMs float64                `json:"duration_ms"`
}

// PipelineResult records the outcome of executing an entire pipeline.
type PipelineResult struct {
	PipelineName string        `json:"pipeline_name"`
	Status       string        `json:"status"`
	Steps        []*StepResult `json:"steps"`
	TotalTimeMs  float64       `json:"total_time_ms"`
}

// Engine executes pipelines by resolving step dependencies and running each step.
type Engine struct {
	stepExecutors map[StepType]StepExecutor
}

// StepExecutor is the function signature for executing a pipeline step.
type StepExecutor func(config, input map[string]interface{}) (map[string]interface{}, error)

// NewEngine creates a pipeline engine with built-in step executors.
func NewEngine() *Engine {
	e := &Engine{
		stepExecutors: make(map[StepType]StepExecutor),
	}
	e.stepExecutors[StepTransform] = ExecuteTransform
	e.stepExecutors[StepValidate] = ExecuteValidate
	e.stepExecutors[StepAggregate] = ExecuteAggregate
	e.stepExecutors[StepExport] = ExecuteExport
	e.stepExecutors[StepFilter] = ExecuteFilter
	return e
}

// Execute runs a pipeline with the given initial input data.
func (e *Engine) Execute(p *Pipeline, initialInput map[string]interface{}) (*PipelineResult, error) {
	ordered, err := topologicalSort(p.Steps)
	if err != nil {
		return nil, fmt.Errorf("dependency resolution failed: %w", err)
	}

	pipelineStart := time.Now()
	result := &PipelineResult{
		PipelineName: p.Name,
		Status:       "success",
		Steps:        make([]*StepResult, 0, len(ordered)),
	}

	stepOutputs := make(map[string]map[string]interface{})
	var lastOutput map[string]interface{}

	for _, step := range ordered {
		stepStart := time.Now()

		// Determine input for this step
		var input map[string]interface{}
		if len(step.Dependencies) == 0 {
			input = initialInput
		} else {
			input = lastOutput
		}

		// Find and run the executor
		executor, ok := e.stepExecutors[step.Type]
		if !ok {
			sr := &StepResult{
				StepName:   step.Name,
				StepType:   step.Type,
				Status:     "failed",
				Error:      fmt.Sprintf("unknown step type: %s", step.Type),
				DurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,
			}
			result.Steps = append(result.Steps, sr)
			result.Status = "failed"
			result.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0
			return result, nil
		}

		output, err := executor(step.Config, input)
		duration := float64(time.Since(stepStart).Microseconds()) / 1000.0

		sr := &StepResult{
			StepName:   step.Name,
			StepType:   step.Type,
			DurationMs: duration,
		}

		if err != nil {
			sr.Status = "failed"
			sr.Error = err.Error()
			result.Steps = append(result.Steps, sr)
			result.Status = "failed"
			result.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0
			return result, nil
		}

		sr.Status = "success"
		sr.Output = output
		result.Steps = append(result.Steps, sr)

		stepOutputs[step.Name] = output
		lastOutput = output
	}

	result.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0
	return result, nil
}

// topologicalSort orders steps so that dependencies are executed first.
// Returns an error if a cycle is detected.
func topologicalSort(steps []*Step) ([]*Step, error) {
	stepMap := make(map[string]*Step)
	inDegree := make(map[string]int)

	for _, s := range steps {
		stepMap[s.Name] = s
		inDegree[s.Name] = 0
	}

	// Build in-degree counts
	for _, s := range steps {
		for _, dep := range s.Dependencies {
			if _, ok := stepMap[dep]; !ok {
				return nil, fmt.Errorf("step %q depends on unknown step %q", s.Name, dep)
			}
			inDegree[s.Name]++
		}
	}

	// Kahn's algorithm
	var queue []*Step
	for _, s := range steps {
		if inDegree[s.Name] == 0 {
			queue = append(queue, s)
		}
	}

	var ordered []*Step
	for len(queue) > 0 {
		current := queue[0]
		queue = queue[1:]
		ordered = append(ordered, current)

		// Find steps that depend on current
		for _, s := range steps {
			for _, dep := range s.Dependencies {
				if dep == current.Name {
					inDegree[s.Name]--
					if inDegree[s.Name] == 0 {
						queue = append(queue, s)
					}
				}
			}
		}
	}

	if len(ordered) != len(steps) {
		return nil, fmt.Errorf("cycle detected in pipeline dependencies")
	}

	return ordered, nil
}

// mergeOutputs collects and merges data arrays from the specified dependency outputs.
func mergeOutputs(stepOutputs map[string]map[string]interface{}, deps []string) map[string]interface{} {
	merged := make(map[string]interface{})
	var mergedData []interface{}

	for _, dep := range deps {
		if output, ok := stepOutputs[dep]; ok {
			if data, ok := output["data"]; ok {
				switch d := data.(type) {
				case []interface{}:
					mergedData = append(mergedData, d...)
				case []float64:
					for _, v := range d {
						mergedData = append(mergedData, v)
					}
				default:
					mergedData = append(mergedData, data)
				}
			}
			// Also carry non-data fields keyed by dependency name
			for k, v := range output {
				if k != "data" {
					merged[dep+"_"+k] = v
				}
			}
		}
	}

	if len(mergedData) > 0 {
		merged["data"] = mergedData
	}
	return merged
}
