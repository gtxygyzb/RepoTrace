\tif err != nil {
\t\twriteError(w, http.StatusNotFound, "%v", err)
\t\treturn
\t}
\twriteJSON(w, http.StatusOK, map[string]interface{}{
\t\t"runs":  runs,
\t\t"count": len(runs),
\t})
}

