   540	func percentile(sorted []float64, p float64) float64 {
   541		n := len(sorted)
   542		if n == 0 {
   543			return 0
   544		}
   545		if n == 1 {
   546			return sorted[0]
   547		}
   548		rank := p * float64(n-1)
   549		lower := int(math.Floor(rank))
   550		upper := int(math.Ceil(rank))
   551		if lower == upper {
   552			return sorted[lower]
   553		}
   554		frac := rank - float64(lower)
   555		return sorted[lower]*(1-frac) + sorted[upper]*frac
   556	}
