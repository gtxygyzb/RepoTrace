   425	// loadAll reads all model files from the data directory.
   426	func (r *Registry) loadAll() error {
   427		entries, err := os.ReadDir(r.dataDir)
   428		if err != nil {
   429			if os.IsNotExist(err) {
   430				return nil
   431			}
   432			return err
   433		}
   434		for _, entry := range entries {
   435			if !entry.IsDir() && filepath.Ext(entry.Name()) == ".json" {
   436				data, err := os.ReadFile(filepath.Join(r.dataDir, entry.Name()))
   437				if err != nil {
   438					return err
   439				}
   440				var model Model
   441				if err := json.Unmarshal(data, &model); err != nil {
   442					return err
   443				}
   444				r.models[model.Name] = &model
   445			}
   446		}
   447		return nil
   448	}
   449	
   450	// saveModel writes a model's data to its JSON file.
   451	func (r *Registry) saveModel(model *Model) error {
   452		data, err := json.MarshalIndent(model, "", "  ")
   453		if err != nil {
   454			return err
   455		}
   456		filename := filepath.Join(r.dataDir, model.Name+".json")
   457		return os.WriteFile(filename, data, 0644)
   458	}
