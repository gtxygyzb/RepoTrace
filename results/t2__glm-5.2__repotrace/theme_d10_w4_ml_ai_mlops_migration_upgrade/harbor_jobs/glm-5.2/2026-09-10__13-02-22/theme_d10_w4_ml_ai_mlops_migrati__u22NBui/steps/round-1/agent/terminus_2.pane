   766		w.WriteHeader(status)
   767		json.NewEncoder(w).Encode(data)
   768	}
   769	
   770	func writeError(w http.ResponseWriter, status int, format string, args ...interface{}) {
   771		w.Header().Set("Content-Type", "application/json")
   772		w.WriteHeader(status)
   773		msg := fmt.Sprintf(format, args...)
   774		json.NewEncoder(w).Encode(map[string]string{"error": msg})
   775	}
