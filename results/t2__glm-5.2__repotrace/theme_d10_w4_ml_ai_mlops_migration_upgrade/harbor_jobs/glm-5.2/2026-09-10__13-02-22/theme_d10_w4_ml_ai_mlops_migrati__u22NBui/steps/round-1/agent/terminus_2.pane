    22		ModelName string    `json:"model_name"`
    23		Input     []float64 `json:"input"`
    24	}
    25	
    26	// InferenceResponse contains the model prediction results.
    27	type InferenceResponse struct {
    28		ModelName   string    `json:"model_name"`
    29		Version     int       `json:"version"`
    30		Predictions []float64 `json:"predictions"`
    31		LatencyMs   float64   `json:"latency_ms"`
    32	}
    33	
    34	// Server manages model loading and inference.
    35	type Server struct {
    36		mu       sync.RWMutex
    37		loaded   map[string]*LoadedModel
    38		registry *registry.Registry
    39	}
    40	
    41	// NewServer creates a new serving server backed by the given registry.
    42	func NewServer(reg *registry.Registry) *Server {
    43		return &Server{
    44			loaded:   make(map[string]*LoadedModel),
    45			registry: reg,
    46		}
    47	}
    48	
    49	// LoadModel loads a model version for serving. Specify either versionNum > 0
    50	// or a non-empty stage string (not both).
    51	func (s *Server) LoadModel(modelName string, versionNum int, stage string) error {
    52		var version *registry.Version
    53		var err error
    54	
    55		if versionNum > 0 {
    56			version, err = s.registry.GetVersion(modelName, versionNum)
    57		} else if stage != "" {
    58			version, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))
    59		} else {
    60			return fmt.Errorf("must specify version number or stage")
    61		}
    62	
    63		if err != nil {
    64			return fmt.Errorf("load model: %w", err)
    65		}
    66	
    67		s.mu.Lock()
    68		defer s.mu.Unlock()
    69	
    70		s.loaded[modelName] = &LoadedModel{
    71			ModelName:   modelName,
    72			VersionNum:  version.Number,
    73			Stage:       version.Stage,
    74			ModelConfig: version.ModelConfig,
    75			LoadedAt:    time.Now(),
    76		}
    77		return nil
    78	}
    79	
    80	// UnloadModel removes a model from the serving cache.
    81	func (s *Server) UnloadModel(modelName string) error {
    82		s.mu.Lock()
    83		defer s.mu.Unlock()
    84	
    85		if _, exists := s.loaded[modelName]; !exists {
    86			return fmt.Errorf("model %q is not loaded", modelName)
    87		}
    88		delete(s.loaded, modelName)
    89		return nil
    90	}
    91	
    92	// Infer runs inference on the loaded model and returns predictions.
    93	func (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {
    94		start := time.Now()
    95	
    96		s.mu.RLock()
    97		loaded, exists := s.loaded[req.ModelName]
    98		s.mu.RUnlock()
    99	
   100		if !exists {
   101			return nil, fmt.Errorf("model %q is not loaded for serving", req.ModelName)
   102		}
   103	
   104		predictions, err := computePrediction(loaded.ModelConfig, req.Input)
   105		if err != nil {
   106			return nil, fmt.Errorf("inference error: %w", err)
   107		}
   108	
   109		latency := float64(time.Since(start).Microseconds()) / 1000.0
   110	
   111		return &InferenceResponse{
   112			ModelName:   req.ModelName,
   113			Version:     loaded.VersionNum,
   114			Predictions: predictions,
   115			LatencyMs:   latency,
   116		}, nil
   117	}
