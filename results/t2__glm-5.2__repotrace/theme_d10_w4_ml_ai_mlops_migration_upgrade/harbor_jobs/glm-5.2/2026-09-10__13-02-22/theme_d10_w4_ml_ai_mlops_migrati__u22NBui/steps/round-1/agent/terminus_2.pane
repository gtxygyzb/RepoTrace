   261	
   262	func (h *Handlers) LoadModel(w http.ResponseWriter, r *http.Request) {
   263		var req struct {
   264			ModelName  string `json:"model_name"`
   265			VersionNum int    `json:"version_num"`
   266			Stage      string `json:"stage"`
   267		}
   268		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
   269			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
   270			return
   271		}
   272		if req.ModelName == "" {
   273			writeError(w, http.StatusBadRequest, "model_name is required")
   274			return
   275		}
   276	
   277		if err := h.Serving.LoadModel(req.ModelName, req.VersionNum, req.Stage); err != nil {
   278			writeError(w, http.StatusBadRequest, "%v", err)
   279			return
   280		}
   281		writeJSON(w, http.StatusOK, map[string]string{"status": "loaded"})
   282	}
   283	
   284	func (h *Handlers) UnloadModel(w http.ResponseWriter, r *http.Request) {
   285		name := r.PathValue("name")
   286		if err := h.Serving.UnloadModel(name); err != nil {
   287			writeError(w, http.StatusNotFound, "%v", err)
