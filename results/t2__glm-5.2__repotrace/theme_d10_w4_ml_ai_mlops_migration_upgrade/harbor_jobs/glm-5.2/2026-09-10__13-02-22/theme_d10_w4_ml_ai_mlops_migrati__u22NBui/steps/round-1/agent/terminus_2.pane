   281	func (t *Tracker) SearchRuns(experimentName string, filters []MetricFilter) ([]*Run, error) {
   282		t.mu.RLock()
   283		defer t.mu.RUnlock()
   284	
   285		exp, exists := t.experiments[experimentName]
   286		if !exists {
   287			return nil, fmt.Errorf("experiment %q not found", experimentName)
   288		}
   289	
   290		var result []*Run
   291		for _, run := range exp.Runs {
   292			match := true
   293			for _, f := range filters {
   294				value, ok := run.Metrics[f.Metric]
   295				if !ok {
   296					match = false
   297					break
   298				}
   299				if !compareMetric(value, f.Op, f.Value) {
   300					match = false
   301					break
   302				}
   303			}
   304			if match {
   305				result = append(result, run)
   306			}
   307		}
   308		return result, nil
   309	}
   310	
   311	// MetricFilter defines a metric condition for searching runs.
   312	type MetricFilter struct {
   313		Metric string  `json:"metric"`
   314		Op     string  `json:"op"`
   315		Value  float64 `json:"value"`
   316	}
   317	
   318	func compareMetric(value float64, op string, threshold float64) bool {
   319		switch op {
   320		case "gt":
   321			return value > threshold
   322		case "lt":
   323			return value < threshold
   324		case "gte":
   325			return value >= threshold
   326		case "lte":
   327			return value <= threshold
   328		case "eq":
   329			return value == threshold
   330		default:
   331			return false
   332		}
   333	}
   334	
   335	func matchTags(runTags map[string]string, filters map[string]string) bool {
   336		for k, v := range filters {
   337			if runTags[k] != v {
   338				return false
   339			}
   340		}
   341		return true
   342	}
   343	
   344	func (t *Tracker) DeleteRun(experimentName, runID string) error {
   345		t.mu.Lock()
   346		defer t.mu.Unlock()
   347	
   348		exp, exists := t.experiments[experimentName]
   349		if !exists {
   350			return fmt.Errorf("experiment %q not found", experimentName)
   351		}
   352	
   353		for i, run := range exp.Runs {
   354			if run.ID == runID {
   355				exp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)
   356				return t.saveExperiment(exp)
   357			}
   358		}
   359		return fmt.Errorf("run %q not found in experiment %q", runID, experimentName)
   360	}
