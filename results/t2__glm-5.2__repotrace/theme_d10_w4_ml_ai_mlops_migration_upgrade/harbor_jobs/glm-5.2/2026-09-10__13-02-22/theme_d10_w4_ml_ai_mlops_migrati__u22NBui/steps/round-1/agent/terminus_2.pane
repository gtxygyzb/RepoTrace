    19	func (h *Handlers) RegisterModel(w http.ResponseWriter, r *http.Request) {
    20		var req struct {
    21			Name        string   `json:"name"`
    22			Framework   string   `json:"framework"`
    23			Description string   `json:"description"`
    24			Tags        []string `json:"tags"`
    25		}
    26		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
    27			writeError(w, http.StatusBadRequest, "invalid request body: %v", err)
    28			return
    29		}
    30		if req.Name == "" {
    31			writeError(w, http.StatusBadRequest, "name is required")
    32			return
    33		}
    34	
    35		model, err := h.Registry.RegisterModel(req.Name, req.Framework, req.Description, req.Tags)
    36		if err != nil {
    37			writeError(w, http.StatusConflict, "%v", err)
    38			return
    39		}
    40		writeJSON(w, http.StatusCreated, model)
    41	}
