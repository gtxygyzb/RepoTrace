python3 - <<'PY'
from pathlib import Path
p = Path('internal/pipeline/engine.go')
s = p.read_text()
old = '''\t\t\tif step.Name == "" {
\t\t\t\tresult.Valid = false
\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf("step at index %d has empty name", i))
\t\t\t}
'''
new = '''\t\t\tif step.Name == "" {
\t\t\t\tresult.Valid = false
\t\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf("step at index %d has empty name", i))
\t\t\t\tcontinue
\t\t\t}
'''
if old not in s:
    raise SystemExit('empty name block not found')
s = s.replace(old, new)
p.write_text(s)
