[?2004lpackage api

import (
	"net/http"

	"gomlops/internal/experiment"
	"gomlops/internal/pipeline"
	"gomlops/internal/registry"
	"gomlops/internal/serving"
)

// Handlers holds references to all service components.
type Handlers struct {
	Registry   *registry.Registry
	Pipeline   *pipeline.Engine
	Experiment *experiment.Tracker
	Serving    *serving.Server
	Templates  *TemplateStore
}

// NewRouter builds the HTTP route table and returns a handler.
func NewRouter(reg *registry.Registry, eng *pipeline.Engine, tracker *experiment.Tracker, srv *serving.Server) http.Handler {
	h := &Handlers{
		Registry:   reg,
		Pipeline:   eng,
		Experiment: tracker,
		Serving:    srv,
		Templates:  NewTemplateStore(),
	}

	mux := http.NewServeMux()

	// Model registry endpoints
	mux.HandleFunc("POST /api/v1/models", h.RegisterModel)
	mux.HandleFunc("GET /api/v1/models", h.ListModels)
	mux.HandleFunc("GET /api/v1/models/{name}", h.GetModel)
	mux.HandleFunc("POST /api/v1/models/{name}/versions", h.CreateVersion)
	mux.HandleFunc("GET /api/v1/models/{name}/versions/compare", h.CompareVersionMetrics)
	mux.HandleFunc("GET /api/v1/models/{name}/versions/{num}", h.GetVersion)
	mux.HandleFunc("PUT /api/v1/models/{name}/versions/{num}/promote", h.PromoteVersion)
	mux.HandleFunc("DELETE /api/v1/models/{name}", h.DeleteModel)

	// Pipeline endpoints
	mux.HandleFunc("POST /api/v1/pipelines/execute", h.ExecutePipeline)
	mux.HandleFunc("POST /api/v1/pipelines/templates", h.CreateTemplate)
	mux.HandleFunc("GET /api/v1/pipelines/templates", h.ListTemplates)
	mux.HandleFunc("GET /api/v1/pipelines/templates/{name}", h.GetTemplate)
	mux.HandleFunc("PUT /api/v1/pipelines/templates/{name}", h.UpdateTemplate)
	mux.HandleFunc("DELETE /api/v1/pipelines/templates/{name}", h.DeleteTemplate)
	mux.HandleFunc("POST /api/v1/pipelines/templates/{name}/execute", h.ExecuteTemplate)

	// Experiment endpoints
	mux.HandleFunc("POST /api/v1/experiments", h.CreateExperiment)
	mux.HandleFunc("GET /api/v1/experiments", h.ListExperiments)
	mux.HandleFunc("GET /api/v1/experiments/{name}", h.GetExperiment)
	mux.HandleFunc("POST /api/v1/experiments/{name}/runs", h.LogRun)
	mux.HandleFunc("DELETE /api/v1/experiments/{name}/runs/{id}", h.DeleteRun)
	mux.HandleFunc("GET /api/v1/experiments/{name}/metrics/{metric}/aggregate", h.AggregateMetric)

	// Serving endpoints
	mux.HandleFunc("POST /api/v1/serving/load", h.LoadModel)
	mux.HandleFunc("DELETE /api/v1/serving/models/{name}", h.UnloadModel)
	mux.HandleFunc("GET /api/v1/serving/models", h.ListLoadedModels)
	mux.HandleFunc("POST /api/v1/serving/infer", h.Infer)
	mux.HandleFunc("POST /api/v1/serving/batch", h.BatchInfer)

	// Health check
	mux.HandleFunc("GET /health", func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusOK)
		w.Write([]byte(`{"status":"ok"}`))
	})

	return mux
}
[?2004hroot@n30009:/app# cat internal/pipeline/steps.go
[?2004lpackage pipeline

import (
	"fmt"
	"math"
	"sort"
)

// ExecuteTransform applies a data transformation.
// Supported modes: scale, offset, normalize, identity, clip, log.
func ExecuteTransform(config, input map[string]interface{}) (map[string]interface{}, error) {
	data, ok := input["data"].([]interface{})
	if !ok {
		return nil, fmt.Errorf("transform: missing or invalid 'data' field in input")
	}

	mode, _ := config["mode"].(string)
	if mode == "" {
		return nil, fmt.Errorf("transform: missing 'mode' in config")
	}

	result := make([]interface{}, len(data))

	switch mode {
	case "scale":
		factor, _ := config["factor"].(float64)
		for i, v := range data {
			val, err := toFloat(v)
			if err != nil {
				return nil, fmt.Errorf("transform scale: element %d: %w", i, err)
			}
			result[i] = val * factor
		}

	case "offset":
		offset, _ := config["offset"].(float64)
		for i, v := range data {
			val, err := toFloat(v)
			if err != nil {
				return nil, fmt.Errorf("transform offset: element %d: %w", i, err)
			}
			result[i] = val + offset
		}

	case "normalize":
		if len(data) == 0 {
			return map[string]interface{}{"data": result}, nil
		}
		minVal, maxVal := findMinMax(data)
		for i, v := range data {
			val, err := toFloat(v)
			if err != nil {
				return nil, fmt.Errorf("transform normalize: element %d: %w", i, err)
			}
			if maxVal == minVal {
				result[i] = 0.5
			} else {
				result[i] = (val - minVal) / (maxVal - minVal)
			}
		}

	case "identity":
		copy(result, data)

	case "clip":
		low, _ := config["low"].(float64)
		high, _ := config["high"].(float64)
		for i, v := range data {
			val, err := toFloat(v)
			if err != nil {
				return nil, fmt.Errorf("transform clip: element %d: %w", i, err)
			}
			if val < low {
				val = low
			}
			if val > high {
				val = high
			}
			result[i] = val
		}

	case "log":
		for i, v := range data {
			val, err := toFloat(v)
			if err != nil {
				return nil, fmt.Errorf("transform log: element %d: %w", i, err)
			}
			if val <= 0 {
				return nil, fmt.Errorf("transform log: element %d is non-positive (%f)", i, val)
			}
			result[i] = math.Log(val)
		}

	default:
		return nil, fmt.Errorf("transform: unknown mode %q", mode)
	}

	return map[string]interface{}{"data": result}, nil
}

// ExecuteValidate checks data against schema constraints.
func ExecuteValidate(config, input map[string]interface{}) (map[string]interface{}, error) {
	data, ok := input["data"].([]interface{})
	if !ok {
		return nil, fmt.Errorf("validate: missing or invalid 'data' field")
	}

	var errors []interface{}

	// Check min_value constraint
	if minVal, ok := config["min_value"].(float64); ok {
		for i, v := range data {
			val, err := toFloat(v)
			if err != nil {
				errors = append(errors, fmt.Sprintf("element %d: not a number", i))
				continue
			}
			if val < minVal {
				errors = append(errors, fmt.Sprintf("element %d: value %f below minimum %f", i, val, minVal))
			}
		}
	}

	// Check max_value constraint
	if maxVal, ok := config["max_value"].(float64); ok {
		for i, v := range data {
			val, err := toFloat(v)
			if err != nil {
				continue
			}
			if val > maxVal {
				errors = append(errors, fmt.Sprintf("element %d: value %f above maximum %f", i, val, maxVal))
			}
		}
	}

	// Check min_count constraint
	if minCount, ok := config["min_count"].(float64); ok {
		if float64(len(data)) < minCount {
			errors = append(errors, fmt.Sprintf("data has %d elements, minimum required is %d", len(data), int(minCount)))
		}
	}

	valid := len(errors) == 0
	return map[string]interface{}{
		"valid":  valid,
		"errors": errors,
		"data":   data,
	}, nil
}

// ExecuteAggregate computes aggregations over input data.
// Supported operations: sum, mean, count, min, max.
func ExecuteAggregate(config, input map[string]interface{}) (map[string]interface{}, error) {
	data, ok := input["data"].([]interface{})
	if !ok {
		return nil, fmt.Errorf("aggregate: missing or invalid 'data' field")
	}

	operation, _ := config["operation"].(string)
	if operation == "" {
		return nil, fmt.Errorf("aggregate: missing 'operation' in config")
	}

	values := make([]float64, 0, len(data))
	for _, v := range data {
		val, err := toFloat(v)
		if err != nil {
			continue
		}
		values = append(values, val)
	}

	if len(values) == 0 {
		return map[string]interface{}{"result": 0.0, "count": 0.0}, nil
	}

	var result float64
	switch operation {
	case "sum":
		for _, v := range values {
			result += v
		}
	case "mean":
		for _, v := range values {
			result += v
		}
		result /= float64(len(values))
	case "count":
		result = float64(len(values))
	case "min":
		result = values[0]
		for _, v := range values[1:] {
			if v < result {
				result = v
			}
		}
	case "max":
		result = values[0]
		for _, v := range values[1:] {
			if v > result {
				result = v
			}
		}
	case "range":
		if len(values) < 2 {
			result = 0.0
		} else {
			minVal := values[0]
			maxVal := values[0]
			for _, v := range values[1:] {
				if v < minVal {
					minVal = v
				}
				if v > maxVal {
					maxVal = v
				}
			}
			result = maxVal - minVal
		}
	default:
		return nil, fmt.Errorf("aggregate: unknown operation %q", operation)
	}

	return map[string]interface{}{
		"result": result,
		"count":  float64(len(values)),
		"data":   data,
	}, nil
}

// ExecuteExport formats data for output.
// Supported formats: json, csv, summary.
func ExecuteExport(config, input map[string]interface{}) (map[string]interface{}, error) {
	format, _ := config["format"].(string)
	if format == "" {
		format = "json"
	}

	switch format {
	case "json":
		return map[string]interface{}{
			"format": "json",
			"data":   input,
		}, nil

	case "summary":
		data, ok := input["data"].([]interface{})
		count := 0
		if ok {
			count = len(data)
		}
		return map[string]interface{}{
			"format": "summary",
			"count":  float64(count),
			"data":   input,
		}, nil

	case "csv":
		data, ok := input["data"].([]interface{})
		if !ok {
			return map[string]interface{}{"format": "csv", "content": ""}, nil
		}
		csv := ""
		for i, v := range data {
			if i > 0 {
				csv += ","
			}
			csv += fmt.Sprintf("%v", v)
		}
		return map[string]interface{}{
			"format":  "csv",
			"content": csv,
			"data":    data,
		}, nil

	default:
		return nil, fmt.Errorf("export: unknown format %q", format)
	}
}

// ExecuteFilter selects elements from the data array based on a comparison condition.
// Supported modes: gt, lt, gte, lte, eq, ne.
func ExecuteFilter(config, input map[string]interface{}) (map[string]interface{}, error) {
	data, ok := input["data"].([]interface{})
	if !ok {
		return nil, fmt.Errorf("filter: missing or invalid 'data' field in input")
	}

	mode, _ := config["mode"].(string)
	if mode == "" {
		return nil, fmt.Errorf("filter: missing 'mode' in config")
	}
	threshold, _ := config["threshold"].(float64)

	var result []interface{}
	for _, v := range data {
		val, err := toFloat(v)
		if err != nil {
			continue
		}
		var keep bool
		switch mode {
		case "gt":
			keep = val > threshold
		case "lt":
			keep = val < threshold
		case "gte":
			keep = val >= threshold
		case "lte":
			keep = val <= threshold
		case "eq":
			keep = val == threshold
		case "ne":
			keep = val != threshold
		default:
			return nil, fmt.Errorf("filter: unknown mode %q", mode)
		}
		if keep {
			result = append(result, val)
		}
	}

	if result == nil {
		result = []interface{}{}
	}
	return map[string]interface{}{"data": result}, nil
}

// Helper functions

func toFloat(v interface{}) (float64, error) {
	switch val := v.(type) {
	case float64:
		return val, nil
	case int:
		return float64(val), nil
	case int64:
		return float64(val), nil
	default:
		return 0, fmt.Errorf("cannot convert %T to float64", v)
	}
}

func findMinMax(data []interface{}) (float64, float64) {
	if len(data) == 0 {
		return 0, 0
	}
	minVal, _ := toFloat(data[0])
	maxVal := minVal
	for _, v := range data[1:] {
		val, err := toFloat(v)
		if err != nil {
			continue
		}
		if val < minVal {
			minVal = val
		}
		if val > maxVal {
			maxVal = val
		}
	}
	return minVal, maxVal
}

func sortedCopy(values []float64) []float64 {
	s := make([]float64, len(values))
	copy(s, values)
	sort.Float64s(s)
	return s
}
