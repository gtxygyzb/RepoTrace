[?2004lpackage experiment

import (
	"encoding/json"
	"fmt"
	"math"
	"os"
	"path/filepath"
	"sort"
	"sync"
	"time"
)

// Experiment groups related runs together.
type Experiment struct {
	Name      string    `json:"name"`
	Runs      []*Run    `json:"runs"`
	CreatedAt time.Time `json:"created_at"`
}

// Run records a single experiment execution with parameters and metrics.
type Run struct {
	ID         string             `json:"id"`
	Parameters map[string]float64 `json:"parameters"`
	Metrics    map[string]float64 `json:"metrics"`
	Tags       map[string]string  `json:"tags"`
	CreatedAt  time.Time          `json:"created_at"`
}

// Tracker manages experiments and their runs.
type Tracker struct {
	mu          sync.RWMutex
	experiments map[string]*Experiment
	dataDir     string
	runCounter  int
}

// NewTracker creates a new experiment tracker backed by the given data directory.
func NewTracker(dataDir string) *Tracker {
	os.MkdirAll(dataDir, 0755)
	t := &Tracker{
		experiments: make(map[string]*Experiment),
		dataDir:     dataDir,
	}
	t.loadAll()
	return t
}

// CreateExperiment creates a new experiment with the given name.
func (t *Tracker) CreateExperiment(name string) (*Experiment, error) {
	t.mu.Lock()
	defer t.mu.Unlock()

	if _, exists := t.experiments[name]; exists {
		return nil, fmt.Errorf("experiment %q already exists", name)
	}

	exp := &Experiment{
		Name:      name,
		Runs:      make([]*Run, 0),
		CreatedAt: time.Now(),
	}
	t.experiments[name] = exp
	if err := t.saveExperiment(exp); err != nil {
		delete(t.experiments, name)
		return nil, err
	}
	return exp, nil
}

// LogRun adds a new run to the specified experiment.
func (t *Tracker) LogRun(experimentName string, params map[string]float64, metrics map[string]float64, tags map[string]string) (*Run, error) {
	t.mu.Lock()
	defer t.mu.Unlock()

	exp, exists := t.experiments[experimentName]
	if !exists {
		return nil, fmt.Errorf("experiment %q not found", experimentName)
	}

	t.runCounter++
	run := &Run{
		ID:         fmt.Sprintf("run_%d", t.runCounter),
		Parameters: params,
		Metrics:    metrics,
		Tags:       tags,
		CreatedAt:  time.Now(),
	}
	exp.Runs = append(exp.Runs, run)

	if err := t.saveExperiment(exp); err != nil {
		exp.Runs = exp.Runs[:len(exp.Runs)-1]
		return nil, err
	}
	return run, nil
}

// GetExperiment returns the experiment with the given name.
func (t *Tracker) GetExperiment(name string) (*Experiment, error) {
	t.mu.RLock()
	defer t.mu.RUnlock()

	exp, exists := t.experiments[name]
	if !exists {
		return nil, fmt.Errorf("experiment %q not found", name)
	}
	return exp, nil
}

// ListExperiments returns all experiments.
func (t *Tracker) ListExperiments() []*Experiment {
	t.mu.RLock()
	defer t.mu.RUnlock()

	result := make([]*Experiment, 0, len(t.experiments))
	for _, exp := range t.experiments {
		result = append(result, exp)
	}
	sort.Slice(result, func(i, j int) bool {
		return result[i].Name < result[j].Name
	})
	return result
}

// AggregateMetric computes an aggregate statistic for a given metric across all runs
// in an experiment. Supported types: mean, median, p95, p99, weighted_mean.
// For weighted_mean, weightParam specifies which parameter to use as weight.
func (t *Tracker) AggregateMetric(experimentName, metricName, aggType, weightParam string) (float64, int, error) {
	t.mu.RLock()
	defer t.mu.RUnlock()

	exp, exists := t.experiments[experimentName]
	if !exists {
		return 0, 0, fmt.Errorf("experiment %q not found", experimentName)
	}

	if len(exp.Runs) == 0 {
		return 0, 0, fmt.Errorf("experiment %q has no runs", experimentName)
	}

	var values []float64
	var weights []float64
	for _, run := range exp.Runs {
		value, ok := run.Metrics[metricName]
		if !ok {
			continue
		}
		values = append(values, value)
		if aggType == "weighted_mean" {
			weight, ok := run.Parameters[weightParam]
			if !ok {
				continue
			}
			weights = append(weights, weight)
		}
	}

	if len(values) == 0 {
		return 0, 0, fmt.Errorf("no values found for metric %q", metricName)
	}

	switch aggType {
	case "mean":
		sum := 0.0
		for _, v := range values {
			sum += v
		}
		return sum / float64(len(values)), len(values), nil

	case "median":
		sorted := sortedCopy(values)
		n := len(sorted)
		if n%2 == 0 {
			return (sorted[n/2-1] + sorted[n/2]) / 2, len(values), nil
		}
		return sorted[n/2], len(values), nil

	case "p95":
		sorted := sortedCopy(values)
		return percentile(sorted, 0.95), len(values), nil

	case "p99":
		sorted := sortedCopy(values)
		return percentile(sorted, 0.99), len(values), nil

	case "weighted_mean":
		if weightParam == "" {
			return 0, 0, fmt.Errorf("weighted_mean requires weight parameter")
		}
		if len(weights) == 0 {
			return 0, 0, fmt.Errorf("no runs with metric %q and weight parameter %q", metricName, weightParam)
		}
		if len(weights) != len(values) {
			return 0, 0, fmt.Errorf("mismatch between metric values and weights")
		}
		weightedSum := 0.0
		weightSum := 0.0
		for i, v := range values {
			weightedSum += v * weights[i]
			weightSum += weights[i]
		}
		if weightSum == 0 {
			return 0, 0, fmt.Errorf("weighted_mean has zero total weight")
		}
		return weightedSum / weightSum, len(values), nil

	default:
		return 0, 0, fmt.Errorf("unknown aggregation type %q", aggType)
	}
}

func percentile(sorted []float64, p float64) float64 {
	n := len(sorted)
	if n == 0 {
		return 0
	}
	if n == 1 {
		return sorted[0]
	}
	rank := p * float64(n-1)
	lower := int(math.Floor(rank))
	upper := int(math.Ceil(rank))
	if lower == upper {
		return sorted[lower]
	}
	frac := rank - float64(lower)
	return sorted[lower]*(1-frac) + sorted[upper]*frac
}

func sortedCopy(values []float64) []float64 {
	s := make([]float64, len(values))
	copy(s, values)
	sort.Float64s(s)
	return s
}

func (t *Tracker) loadAll() {
	entries, err := os.ReadDir(t.dataDir)
	if err != nil {
		return
	}
	for _, entry := range entries {
		if !entry.IsDir() && filepath.Ext(entry.Name()) == ".json" {
			data, err := os.ReadFile(filepath.Join(t.dataDir, entry.Name()))
			if err != nil {
				continue
			}
			var exp Experiment
			if err := json.Unmarshal(data, &exp); err != nil {
				continue
			}
			t.experiments[exp.Name] = &exp
			for _, r := range exp.Runs {
				_ = r
				t.runCounter++
			}
		}
	}
}

