import (
	"fmt"
	"sync"
	"time"

	"gomlops/internal/registry"
)

// LoadedModel tracks a model version currently loaded for serving.
type LoadedModel struct {
	ModelName   string                 `json:"model_name"`
	VersionNum  int                    `json:"version_num"`
	Stage       registry.Stage         `json:"stage"`
	ModelConfig map[string]interface{} `json:"model_config"`
	LoadedAt    time.Time              `json:"loaded_at"`
}

// InferenceRequest contains the input data for model inference.
type InferenceRequest struct {
	ModelName string    `json:"model_name"`
	Input     []float64 `json:"input"`
}

// InferenceResponse contains the model prediction results.
type InferenceResponse struct {
	ModelName   string    `json:"model_name"`
	Version     int       `json:"version"`
	Predictions []float64 `json:"predictions"`
	LatencyMs   float64   `json:"latency_ms"`
}

// ModelStats tracks inference statistics for a single model.
type ModelStats struct {
	Requests   int     `json:"requests"`
	Successful int     `json:"successful"`
	Failed     int     `json:"failed"`
	LatencySum float64 `json:"-"`
}

// Stats tracks accumulated serving statistics.
type Stats struct {
	TotalRequests int
	Successful    int
	Failed        int
	LatencySum    float64
	Models        map[string]*ModelStats
}

// StatsResponse is the public serving statistics representation.
type StatsResponse struct {
	TotalRequests int                           `json:"total_requests"`
	Successful    int                           `json:"successful"`
	Failed        int                           `json:"failed"`
	AvgLatencyMs  float64                       `json:"avg_latency_ms"`
	Models        map[string]ModelStatsResponse `json:"models"`
}

// ModelStatsResponse is the public model statistics representation.
type ModelStatsResponse struct {
	Requests     int     `json:"requests"`
	Successful   int     `json:"successful"`
	Failed       int     `json:"failed"`
	AvgLatencyMs float64 `json:"avg_latency_ms"`
	SuccessRate  float64 `json:"success_rate"`
}

// Server manages model loading and inference.
type Server struct {
	mu       sync.RWMutex
	loaded   map[string]*LoadedModel
	registry *registry.Registry
	stats    Stats
}

// NewServer creates a new serving server backed by the given registry.
func NewServer(reg *registry.Registry) *Server {
	return &Server{
		loaded:   make(map[string]*LoadedModel),
		registry: reg,
		stats: Stats{
			Models: make(map[string]*ModelStats),
		},
	}
}

// LoadModel loads a model version for serving. Specify either versionNum > 0
// or a non-empty stage string (not both).
func (s *Server) LoadModel(modelName string, versionNum int, stage string) error {
	var version *registry.Version
	var err error

	if versionNum > 0 {
		version, err = s.registry.GetVersion(modelName, versionNum)
	} else if stage != "" {
		version, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))
	} else {
		return fmt.Errorf("must specify version number or stage")
	}

	if err != nil {
		return fmt.Errorf("load model: %w", err)
	}

	s.mu.Lock()
	defer s.mu.Unlock()

	s.loaded[modelName] = &LoadedModel{
		ModelName:   modelName,
		VersionNum:  version.Number,
		Stage:       version.Stage,
		ModelConfig: version.ModelConfig,
		LoadedAt:    time.Now(),
	}
	return nil
}

// UnloadModel removes a model from the serving cache.
func (s *Server) UnloadModel(modelName string) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	if _, exists := s.loaded[modelName]; !exists {
		return fmt.Errorf("model %q is not loaded", modelName)
	}
	delete(s.loaded, modelName)
	return nil
}

// Infer runs inference on the loaded model and returns predictions.
func (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {
	start := time.Now()

	s.mu.RLock()
	loaded, exists := s.loaded[req.ModelName]
	s.mu.RUnlock()

	if !exists {
		return nil, fmt.Errorf("model %q is not loaded for serving", req.ModelName)
	}

	predictions, err := computePrediction(loaded.ModelConfig, req.Input)
	if err != nil {
		return nil, fmt.Errorf("inference error: %w", err)
	}

	latency := float64(time.Since(start).Microseconds()) / 1000.0

	return &InferenceResponse{
		ModelName:   req.ModelName,
		Version:     loaded.VersionNum,
		Predictions: predictions,
		LatencyMs:   latency,
	}, nil
}

// RecordRequest updates serving statistics for a single inference request.
func (s *Server) RecordRequest(modelName string, successful bool, latencyMs float64) {
	s.mu.Lock()
	defer s.mu.Unlock()

	s.stats.TotalRequests++
	if successful {
		s.stats.Successful++
		s.stats.LatencySum += latencyMs
	} else {
		s.stats.Failed++
	}

