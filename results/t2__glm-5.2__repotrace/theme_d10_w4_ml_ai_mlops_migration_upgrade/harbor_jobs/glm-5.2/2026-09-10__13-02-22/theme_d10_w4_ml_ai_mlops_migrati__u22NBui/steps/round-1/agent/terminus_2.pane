[?2004lpackage registry

import (
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"regexp"
	"sort"
	"sync"
	"time"
)

// Stage represents the lifecycle stage of a model version.
type Stage string

const (
	StageDevelopment Stage = "development"
	StageStaging     Stage = "staging"
	StageProduction  Stage = "production"
	StageArchived    Stage = "archived"
)

var validTransitions = map[Stage][]Stage{
	StageDevelopment: {StageStaging, StageArchived},
	StageStaging:     {StageProduction, StageArchived},
	StageProduction:  {StageArchived},
	StageArchived:    {},
}

// PromotionRecord records a single stage transition in a version's lineage.
type PromotionRecord struct {
	FromStage Stage  `json:"from_stage"`
	ToStage   Stage  `json:"to_stage"`
	Timestamp string `json:"timestamp"`
}

// Version represents a specific version of a model.
type Version struct {
	Number      int                    `json:"number"`
	Stage       Stage                  `json:"stage"`
	Metrics     map[string]float64     `json:"metrics"`
	Tags        []string               `json:"tags"`
	ModelConfig map[string]interface{} `json:"model_config,omitempty"`
	CreatedAt   time.Time              `json:"created_at"`
	Lineage     []PromotionRecord      `json:"lineage"`
	DemotedBy   int                    `json:"demoted_by,omitempty"`
}

// Model represents a registered ML model.
type Model struct {
	Name         string     `json:"name"`
	Framework    string     `json:"framework"`
	Description  string     `json:"description"`
	Tags         []string   `json:"tags"`
	Versions     []*Version `json:"versions"`
	Dependencies []string   `json:"dependencies"`
	CreatedAt    time.Time  `json:"created_at"`
	UpdatedAt    time.Time  `json:"updated_at"`
}

// ModelFilter defines filtering criteria for listing models.
type ModelFilter struct {
	Framework string
	Tag       string
}

// Annotation represents a key-value annotation attached to a model version.
type Annotation struct {
	Key       string    `json:"key"`
	Value     string    `json:"value"`
	CreatedAt time.Time `json:"created_at"`
}

var annotationKeyRegexp = regexp.MustCompile(`^[A-Za-z0-9_]+$`)

// Registry manages model registration, versioning, and lifecycle.
type Registry struct {
	mu           sync.RWMutex
	models       map[string]*Model
	dataDir      string
	annotations  map[string]map[int]map[string]*Annotation
	dependencies map[string][]string
}

// NewRegistry creates a new Registry backed by the given data directory.
func NewRegistry(dataDir string) (*Registry, error) {
	if err := os.MkdirAll(dataDir, 0755); err != nil {
		return nil, fmt.Errorf("create data dir: %w", err)
	}
	r := &Registry{
		models:       make(map[string]*Model),
		dataDir:      dataDir,
		annotations:  make(map[string]map[int]map[string]*Annotation),
		dependencies: make(map[string][]string),
	}
	if err := r.loadAll(); err != nil {
		return nil, fmt.Errorf("load registry: %w", err)
	}
	return r, nil
}

// RegisterModel creates a new model entry in the registry.
func (r *Registry) RegisterModel(name, framework, description string, tags []string) (*Model, error) {
	r.mu.Lock()
	defer r.mu.Unlock()

	if _, exists := r.models[name]; exists {
		return nil, fmt.Errorf("model %q already exists", name)
	}

	now := time.Now()
	if tags == nil {
		tags = []string{}
	}
	model := &Model{
		Name:         name,
		Framework:    framework,
		Description:  description,
		Tags:         tags,
		Versions:     make([]*Version, 0),
		Dependencies: []string{},
		CreatedAt:    now,
		UpdatedAt:    now,
	}
	r.models[name] = model
	r.dependencies[name] = []string{}
	if err := r.saveModel(model); err != nil {
		delete(r.models, name)
		return nil, err
	}
	return model, nil
}

// CreateVersion adds a new version to the specified model.
func (r *Registry) CreateVersion(modelName string, metrics map[string]float64, tags []string, modelConfig map[string]interface{}) (*Version, error) {
	r.mu.Lock()
	defer r.mu.Unlock()

	model, exists := r.models[modelName]
	if !exists {
		return nil, fmt.Errorf("model %q not found", modelName)
	}

	nextNum := 1
	for _, v := range model.Versions {
		if v.Number >= nextNum {
			nextNum = v.Number + 1
		}
	}

	if tags == nil {
		tags = []string{}
	}
	version := &Version{
		Number:      nextNum,
		Stage:       StageDevelopment,
		Metrics:     metrics,
		Tags:        tags,
		ModelConfig: modelConfig,
		CreatedAt:   time.Now(),
		Lineage:     []PromotionRecord{},
	}
	model.Versions = append(model.Versions, version)
	model.UpdatedAt = time.Now()

	if err := r.saveModel(model); err != nil {
		model.Versions = model.Versions[:len(model.Versions)-1]
		return nil, err
	}
	return version, nil
}

// PromoteVersion transitions a model version to the specified stage.
func (r *Registry) PromoteVersion(modelName string, versionNum int, targetStage Stage) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	model, exists := r.models[modelName]
	if !exists {
		return fmt.Errorf("model %q not found", modelName)
	}

	var version *Version
	for _, v := range model.Versions {
		if v.Number == versionNum {
			version = v
			break
		}
	}
	if version == nil {
		return fmt.Errorf("version %d not found for model %q", versionNum, modelName)
	}

	// Validate stage transition
	allowed := validTransitions[version.Stage]
	valid := false
	for _, s := range allowed {
		if s == targetStage {
			valid = true
			break
		}
	}
	if !valid {
		return fmt.Errorf("invalid stage transition from %s to %s", version.Stage, targetStage)
	}

	promotionTime := time.Now().UTC().Format(time.RFC3339)

	// If promoting to production, demote current production version.
	if targetStage == StageProduction {
		for _, v := range model.Versions {
			if v.Stage == StageProduction && v.Number != versionNum {
				if v.Lineage == nil {
					v.Lineage = []PromotionRecord{}
				}
				v.Lineage = append(v.Lineage, PromotionRecord{
					FromStage: StageProduction,
					ToStage:   StageStaging,
					Timestamp: promotionTime,
				})
				v.DemotedBy = versionNum
				v.Stage = StageStaging
			}
		}
	}

	if version.Lineage == nil {
		version.Lineage = []PromotionRecord{}
	}
	version.Lineage = append(version.Lineage, PromotionRecord{
		FromStage: version.Stage,
		ToStage:   targetStage,
		Timestamp: promotionTime,
	})
	version.Stage = targetStage
	model.UpdatedAt = time.Now()

	return r.saveModel(model)
}

// GetModel returns a model with its versions sorted by version number descending.
func (r *Registry) GetModel(name string) (*Model, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	model, exists := r.models[name]
	if !exists {
		return nil, fmt.Errorf("model %q not found", name)
	}

	// Return a copy with versions sorted
	result := *model
	result.Versions = make([]*Version, len(model.Versions))
	copy(result.Versions, model.Versions)
	sort.Slice(result.Versions, func(i, j int) bool {
		return result.Versions[i].Number > result.Versions[j].Number
	})
	return &result, nil
}
[?2004hroot@n30009:/app# sed -n '1,260p' internal/serving/serving.go
[?2004lpackage serving

import (
	"fmt"
	"sync"
	"time"

	"gomlops/internal/registry"
)

// LoadedModel tracks a model version currently loaded for serving.
type LoadedModel struct {
	ModelName   string                 `json:"model_name"`
	VersionNum  int                    `json:"version_num"`
	Stage       registry.Stage         `json:"stage"`
	ModelConfig map[string]interface{} `json:"model_config"`
	LoadedAt    time.Time              `json:"loaded_at"`
}

// InferenceRequest contains the input data for model inference.
type InferenceRequest struct {
	ModelName string    `json:"model_name"`
	Input     []float64 `json:"input"`
}

// InferenceResponse contains the model prediction results.
type InferenceResponse struct {
	ModelName   string    `json:"model_name"`
	Version     int       `json:"version"`
	Predictions []float64 `json:"predictions"`
	LatencyMs   float64   `json:"latency_ms"`
}

// ModelStats tracks inference statistics for a single model.
type ModelStats struct {
	Requests   int     `json:"requests"`
	Successful int     `json:"successful"`
	Failed     int     `json:"failed"`
	LatencySum float64 `json:"-"`
}

// Stats tracks accumulated serving statistics.
type Stats struct {
	TotalRequests int
	Successful    int
	Failed        int
	LatencySum    float64
	Models        map[string]*ModelStats
}

// StatsResponse is the public serving statistics representation.
type StatsResponse struct {
	TotalRequests int                           `json:"total_requests"`
	Successful    int                           `json:"successful"`
	Failed        int                           `json:"failed"`
	AvgLatencyMs  float64                       `json:"avg_latency_ms"`
	Models        map[string]ModelStatsResponse `json:"models"`
}

// ModelStatsResponse is the public model statistics representation.
type ModelStatsResponse struct {
	Requests     int     `json:"requests"`
	Successful   int     `json:"successful"`
	Failed       int     `json:"failed"`
	AvgLatencyMs float64 `json:"avg_latency_ms"`
	SuccessRate  float64 `json:"success_rate"`
}

// Server manages model loading and inference.
type Server struct {
	mu       sync.RWMutex
	loaded   map[string]*LoadedModel
	registry *registry.Registry
	stats    Stats
}

// NewServer creates a new serving server backed by the given registry.
func NewServer(reg *registry.Registry) *Server {
	return &Server{
		loaded:   make(map[string]*LoadedModel),
		registry: reg,
		stats: Stats{
			Models: make(map[string]*ModelStats),
		},
	}
}

// LoadModel loads a model version for serving. Specify either versionNum > 0
// or a non-empty stage string (not both).
func (s *Server) LoadModel(modelName string, versionNum int, stage string) error {
	var version *registry.Version
	var err error

	if versionNum > 0 {
		version, err = s.registry.GetVersion(modelName, versionNum)
	} else if stage != "" {
		version, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))
	} else {
		return fmt.Errorf("must specify version number or stage")
	}

	if err != nil {
		return fmt.Errorf("load model: %w", err)
	}

	s.mu.Lock()
	defer s.mu.Unlock()

	s.loaded[modelName] = &LoadedModel{
		ModelName:   modelName,
		VersionNum:  version.Number,
		Stage:       version.Stage,
		ModelConfig: version.ModelConfig,
		LoadedAt:    time.Now(),
	}
	return nil
}

// UnloadModel removes a model from the serving cache.
func (s *Server) UnloadModel(modelName string) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	if _, exists := s.loaded[modelName]; !exists {
		return fmt.Errorf("model %q is not loaded", modelName)
	}
	delete(s.loaded, modelName)
	return nil
}

// Infer runs inference on the loaded model and returns predictions.
func (s *Server) Infer(req *InferenceRequest) (*InferenceResponse, error) {
	start := time.Now()

	s.mu.RLock()
	loaded, exists := s.loaded[req.ModelName]
	s.mu.RUnlock()

	if !exists {
		return nil, fmt.Errorf("model %q is not loaded for serving", req.ModelName)
	}

	predictions, err := computePrediction(loaded.ModelConfig, req.Input)
	if err != nil {
		return nil, fmt.Errorf("inference error: %w", err)
	}

	latency := float64(time.Since(start).Microseconds()) / 1000.0

	return &InferenceResponse{
		ModelName:   req.ModelName,
		Version:     loaded.VersionNum,
		Predictions: predictions,
		LatencyMs:   latency,
	}, nil
}

// RecordRequest updates serving statistics for a single inference request.
func (s *Server) RecordRequest(modelName string, successful bool, latencyMs float64) {
	s.mu.Lock()
	defer s.mu.Unlock()

	s.stats.TotalRequests++
	if successful {
		s.stats.Successful++
		s.stats.LatencySum += latencyMs
	} else {
		s.stats.Failed++
	}

	model := s.stats.Models[modelName]
	if model == nil {
		model = &ModelStats{}
		s.stats.Models[modelName] = model
	}
	model.Requests++
	if successful {
		model.Successful++
		model.LatencySum += latencyMs
	} else {
		model.Failed++
	}
}

// GetStats returns a snapshot of accumulated serving statistics.
func (s *Server) GetStats() StatsResponse {
	s.mu.RLock()
	defer s.mu.RUnlock()

	resp := StatsResponse{
		TotalRequests: s.stats.TotalRequests,
		Successful:    s.stats.Successful,
		Failed:        s.stats.Failed,
		Models:        make(map[string]ModelStatsResponse),
	}
	if s.stats.Successful > 0 {
		resp.AvgLatencyMs = s.stats.LatencySum / float64(s.stats.Successful)
	}

	for name, model := range s.stats.Models {
		m := ModelStatsResponse{
			Requests:   model.Requests,
			Successful: model.Successful,
			Failed:     model.Failed,
		}
		if model.Successful > 0 {
			m.AvgLatencyMs = model.LatencySum / float64(model.Successful)
		}
		if model.Requests > 0 {
			m.SuccessRate = float64(model.Successful) / float64(model.Requests)
		}
		resp.Models[name] = m
	}
	return resp
}

// ResetStats resets all serving statistics to zero.
func (s *Server) ResetStats() {
	s.mu.Lock()
	defer s.mu.Unlock()

	s.stats = Stats{
		Models: make(map[string]*ModelStats),
	}
}

// ListLoaded returns all currently loaded models.
func (s *Server) ListLoaded() []*LoadedModel {
	s.mu.RLock()
	defer s.mu.RUnlock()

	result := make([]*LoadedModel, 0, len(s.loaded))
	for _, lm := range s.loaded {
		result = append(result, lm)
	}
	return result
}

// computePrediction evaluates a model against input data.
// Supported model types: linear, polynomial.
func computePrediction(modelConfig map[string]interface{}, input []float64) ([]float64, error) {
	if modelConfig == nil {
		return nil, fmt.Errorf("model has no configuration")
	}

	modelType, _ := modelConfig["model_type"].(string)
	switch modelType {
	case "linear":
		return linearPredict(modelConfig, input)
	case "polynomial":
		return polynomialPredict(modelConfig, input)
	default:
		return nil, fmt.Errorf("unsupported model type: %s", modelType)
	}
}

// linearPredict computes y = sum(weights[i] * input[i]) + bias
func linearPredict(config map[string]interface{}, input []float64) ([]float64, error) {
	weightsRaw, ok := config["weights"].([]interface{})
	if !ok {
