    87	// LoadModel loads a model version for serving. Specify either versionNum > 0
    88	// or a non-empty stage string (not both).
    89	func (s *Server) LoadModel(modelName string, versionNum int, stage string) error {
    90		var version *registry.Version
    91		var err error
    92	
    93		if versionNum > 0 {
    94			version, err = s.registry.GetVersion(modelName, versionNum)
    95		} else if stage != "" {
    96			version, err = s.registry.GetVersionByStage(modelName, registry.Stage(stage))
    97		} else {
    98			return fmt.Errorf("must specify version number or stage")
    99		}
   100	
   101		if err != nil {
   102			return fmt.Errorf("load model: %w", err)
   103		}
   104	
   105		s.mu.Lock()
   106		defer s.mu.Unlock()
   107	
   108		s.loaded[modelName] = &LoadedModel{
   109			ModelName:   modelName,
   110			VersionNum:  version.Number,
   111			Stage:       version.Stage,
   112			ModelConfig: version.ModelConfig,
   113			LoadedAt:    time.Now(),
   114		}
   115		return nil
   116	}
