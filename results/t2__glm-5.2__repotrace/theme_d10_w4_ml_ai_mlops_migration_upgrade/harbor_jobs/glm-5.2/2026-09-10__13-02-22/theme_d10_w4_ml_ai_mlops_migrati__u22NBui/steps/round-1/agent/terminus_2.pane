   267		for _, filter := range r.URL.Query()["tag_filter"] {
   268			parts := strings.SplitN(filter, ":", 2)
   269			if len(parts) != 2 {
   270				writeError(w, http.StatusBadRequest, "invalid tag_filter %q, expected key:value", filter)
   271				return
   272			}
   273			tagFilters[parts[0]] = parts[1]
   274		}
   275	
   276		if aggType == "" {
   277			writeError(w, http.StatusBadRequest, "query parameter 'type' is required")
   278			return
   279		}
   280	
   281		result, count, runIDs, err := h.Experiment.AggregateMetric(expName, metricName, aggType, weightParam, tagFilters)
   282		if err != nil {
   283			writeError(w, http.StatusBadRequest, "%v", err)
   284			return
   285		}
   286	
   287		writeJSON(w, http.StatusOK, map[string]interface{}{
   288			"experiment": expName,
   289			"metric":     metricName,
   290			"type":       aggType,
   291			"value":      result,
   292			"count":      count,
   293			"run_ids":    runIDs,
   294		})
   295	}
   296	
   297	func (h *Handlers) GetMetricHistory(w http.ResponseWriter, r *http.Request) {
   298		expName := r.PathValue("name")
   299		metricName := r.PathValue("metric")
   300		history, err := h.Experiment.MetricHistory(expName, metricName)
   301		if err != nil {
   302			if strings.Contains(err.Error(), "not found") {
   303				writeError(w, http.StatusNotFound, "%v", err)
   304			} else {
   305				writeError(w, http.StatusBadRequest, "%v", err)
   306			}
   307			return
   308		}
   309		writeJSON(w, http.StatusOK, map[string]interface{}{
   310			"experiment": expName,
   311			"metric":     metricName,
   312			"history":    history,
   313			"count":      len(history),
   314		})
   315	}
