\t\t\t\tmatch = false
\t\t\t\tbreak
\t\t\t}
\t\t\tif !compareMetric(value, f.Op, f.Value) {
\t\t\t\tmatch = false
\t\t\t\tbreak
\t\t\t}
\t\t}
\t\tif match {
\t\t\tresult = append(result, run)
\t\t}
\t}
\treturn result, nil
}

// MetricFilter defines a metric condition for searching runs.
type MetricFilter struct {
\tMetric string  `json:"metric"`
\tOp     string  `json:"op"`
\tValue  float64 `json:"value"`
}

func compareMetric(value float64, op string, threshold float64) bool {
\tswitch op {
\tcase "gt":
\t\treturn value > threshold
\tcase "lt":
\t\treturn value < threshold
\tcase "gte":
\t\treturn value >= threshold
\tcase "lte":
\t\treturn value <= threshold
\tcase "eq":
\t\treturn value == threshold
\tdefault:
\t\treturn false
\t}
}

