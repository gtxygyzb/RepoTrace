gs == nil {\n\\t\\tv2Tags = []string{}\n\\t}\n\n\\twriteJSON(w, http.StatusOK, map[string]interface{}{\n\\t\\t"model":       modelName,\n\\t\\t"v1":           v1,\n\\t\\t"v2":           v2,\n\\t\\t"metric_diff":  metricDiff,\n\\t\\t"stage_diff":   map[string]interface{}{"v1": ver1.Stage, "v2": ver2.Stage},\n\\t\\t"tags_diff":    map[string]interface{}{"v1": v1Tags, "v2": v2Tags},\n\\t})\n}\n\n// --- Serving Health Handler ---\n\nfunc (h *Handlers) ServingHealth(w http.ResponseWriter, r *http.Request) {\n\\tmodelName := r.PathValue("name")\n\\tresult, err := h.Serving.HealthCheck(modelName)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusNotFound, "%v", err)\n\\t\\treturn\n\\t}\n\\twriteJSON(w, http.StatusOK, result)\n}\n\n// --- Experiment Correlation Handler ---\n\nfunc (h *Handlers) ExperimentCorrelation(w http.ResponseWriter, r *http.Request) {\n\\texpName := r.PathValue("name")\n\\tmetricsParam := r.URL.Query().Get("metrics")\n\\tif metricsParam == "" {\n\\t\\twriteError(w, http.StatusBadRequest, "metrics parameter is required")\n\\t\\treturn\n\\t}\n\\tparts := strings.Split(metricsParam, ",")\n\\tif len(parts) != 2 {\n\\t\\twriteError(w, http.StatusBadRequest, "metrics must contain exactly two metric names")\n\\t\\treturn\n\\t}\n\\tmetricX := strings.TrimSpace(parts[0])\n\\tmetricY := strings.TrimSpace(parts[1])\n\\tif metricX == "" || metricY == "" {\n\\t\\twriteError(w, http.StatusBadRequest, "metrics must contain exactly two metric names")\n\\t\\treturn\n\\t}\n\n\\tresult, err := h.Experiment.Correlation(expName, metricX, metricY)\n\\tif err != nil {\n\\t\\tif strings.Contains(err.Error(), "not found") {\n\\t\\t\\twriteError(w, http.StatusNotFound, "%v", err)\n\\t\\t} else {\n\\t\\t\\twriteError(w, http.StatusBadRequest, "%v", err)\n\\t\\t}\n\\t\\treturn\n\\t}\n\\twriteJSON(w, http.StatusOK, result)\n}\n\n// --- Pipeline History Handlers ---\n\nfunc (h *Handlers) RecordPipelineHistory(w http.ResponseWriter, r *http.Request) {\n\\tvar req struct {\n\\t\\tPipelineName string  `json:"pipeline_name"`\n\\t\\tStatus      string  `json:"status"`\n\\t\\tTotalTimeMs float64 `json:"total_time_ms"`\n\\t\\tStepCount   int     `json:"step_count"`\n\\t}\n\\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n\\t\\twriteError(w, http.StatusBadRequest, "invalid request body: %v", err)\n\\t\\treturn\n\\t}\n\\tif req.PipelineName == "" {\n\\t\\twriteError(w, http.StatusBadRequest, "pipeline_name is required")\n\\t\\treturn\n\\t}\n\n\\trecord := h.Pipeline.RecordExecution(req.PipelineName, req.Status, req.TotalTimeMs, req.StepCount)\n\\twriteJSON(w, http.StatusCreated, record)\n}\n\nfunc (h *Handlers) ListPipelineHistory(w http.ResponseWriter, r *http.Request) {\n\\tlimitStr := r.URL.Query().Get("limit")\n\\tlimit := 10\n\\tif limitStr != "" {\n\\t\\tparsed, err := strconv.Atoi(limitStr)\n\\t\\tif err != nil || parsed < 0 {\n\\t\\t\\twriteError(w, http.StatusBadRequest, "limit must be a non-negative integer")\n\\t\\t\\treturn\n\\t\\t}\n\\t\\tif parsed > 0 {\n\\t\\t\\tlimit = parsed\n\\t\\t}\n\\t}\n\n\\trecords, total := h.Pipeline.ListExecutionHistory(limit)\n\\tif records == nil {\n\\t\\trecords = []pipeline.PipelineExecutionRecord{}\n\\t}\n\\twriteJSON(w, http.StatusOK, map[string]interface{}{\n\\t\\t"records":  records,\n\\t\\t"total":   total,\n\\t\\t"returned": len(records),\n\\t})\n}\n\n// --- Model Version Rollback Handler ---\n\nfunc (h *Handlers) RollbackVersion(w http.ResponseWriter, r *http.Request) {\n\\tmodelName := r.PathValue("name")\n\\tnumStr := r.PathValue("num")\n\\tnum, err := strconv.Atoi(numStr)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusBadRequest, "invalid version number: %v", err)\n\\t\\treturn\n\\t}\n\n\\tif err := h.Registry.RollbackVersion(modelName, num); err != nil {\n\\t\\twriteError(w, http.StatusNotFound, "%v", err)\n\\t\\treturn\n\\t}\n\\twriteJSON(w, http.StatusOK, map[string]interface{}{\n\\t\\t"status":  "rolled_back",\n\\t\\t"model":   modelName,\n\\t\\t"version": num,\n\\t\\t"