}, stages)\ncheck("list filter framework", req("GET","/models?framework=linear")[0]==200)\ncheck("list filter tag", req("GET","/models?tag=t1")[0]==200)\ncheck("delete missing 404", req("DELETE","/models/nope")[0]==404)\n\n# Pipeline\nst, b = req("POST", "/pipelines/execute", {"name":"p","input":{"data":[1,2,3]},"steps":[\n    {"name":"a","type":"transform","config":{"mode":"scale","factor":2},"dependencies":[]},\n    {"name":"b","type":"transform","config":{"mode":"offset","offset":100},"dependencies":[]},\n    {"name":"c","type":"aggregate","config":{"operation":"sum"},"dependencies":["a","b"]}\n]})\nc = next(s for s in b["steps"] if s["step_name"]=="c")\ncheck("dependency merge", c["output"]["data"]==[2,4,6,101,102,103], c["output"])\ncheck("aggregate sum", c["output"]["result"]==318, c["output"])\nst, b = req("POST", "/pipelines/execute", {"name":"p","input":{"data":[0,10,20]},"steps":[{"name":"n","type":"transform","config":{"mode":"normalize"},"dependencies":[]}]})\ncheck("normalize", b["steps"][0]["output"]["data"]==[0,0.5,1], b)\ncheck("cycle reject", req("POST","/pipelines/execute", {"name":"p","input":{"data":[1]},"steps":[{"name":"a","type":"identity","config":{},"dependencies":["b"]},{"name":"b","type":"identity","config":{},"dependencies":["a"]}]})[0]==400)\ncheck("filter gt", req("POST","/pipelines/execute", {"name":"p","input":{"data":[1,5,6]},"steps":[{"name":"f","type":"filter","config":{"mode":"gt","threshold":5},"dependencies":[]}]})[1]["steps"][0]["output"]["data"]==[6])\ncheck("validate min_count fail", req("POST","/pipelines/execute", {"name":"p","input":{"data":[1,2]},"steps":[{"name":"v","type":"validate","config":{"min_count":3},"dependencies":[]}]})[1]["steps"][0]["output"]["valid"]==False)\n\n# Experiment\nexp = "exp"+suf\nreq("POST","/experiments",{"name":exp})\nreq("POST", f"/experiments/{exp}/runs", {"parameters":{"weight":1},"metrics":{"accuracy":10},"tags":{}})\nreq("POST", f"/experiments/{exp}/runs", {"parameters":{"weight":2},"metrics":{"accuracy":20},"tags":{}})\nreq("POST", f"/experiments/{exp}/runs", {"parameters":{"weight":3},"metrics":{"loss":0.5},"tags":{}})\nst, b = req("GET", f"/experiments/{exp}/metrics/accuracy/aggregate?type=mean")\ncheck("agg skip missing metric", b["count"]==2 and b["value"]==15, b)\nst, b = req("GET", f"/experiments/{exp}/metrics/accuracy/aggregate?type=weighted_mean&weight_param=weight")\ncheck("weighted mean", b["count"]==2 and abs(b["value"]-16.666666)<1e-6, b)\nexp2 = "exp2"+suf\nreq("POST","/experiments",{"name":exp2})\nfor v in [10,20,30,40,50]:\n    req("POST", f"/experiments/{exp2}/runs", {"parameters":{},"metrics":{"accuracy":v},"tags":{}})\nst, b = req("GET", f"/experiments/{exp2}/metrics/accuracy/aggregate?type=p95")\ncheck("p95 interpolation", b["value"]==48.0 and b["count"]==5, b)\n\n# Serving\nst, b = req("POST","/serving/load",{"model_name":m,"version_num":1})\ncheck("load version", st==200, b)\nst, b = req("POST","/serving/infer",{"model_name":m,"input":[1,2]})\ncheck("inference response", st==200 and b["version"]==1 and b["predictions"]==[9] and "latency_ms" in b, b)\nreq("DELETE", f"/serving/models/{m}")\ncheck("infer unloaded", req("POST","/serving/infer",{"model_name":m,"input":[1,2]})[0]==404)\npoly = "poly"+suf\nreq("POST","/models",{"name":poly,"framework":"polynomial","description":"d","tags":[]})\nreq("POST", f"/models/{poly}/versions", {"metrics":{},"tags":[],"model_config":{"model_type":"polynomial","coefficients":[1,2,3]}})\nreq("PUT", f"/models/{poly}/versions/1/promote", {"stage":"staging"})\nreq("POST","/serving/load",{"model_name":poly,"stage":"staging"})\nst, b = req("POST","/serving/infer",{"model_name":poly,"input":[1,2]})\ncheck("polynomial", b["version"]==1 and b["predictions"]==[6,17], b)\nreq("DELETE", f"/models/{poly}")\ncheck("delete unloads serving", req("POST","/serving/infer",{"model_name":poly,"input":[1,2]})[0]==404)\n\nprint("SUMMARY", sum(1 for _,c,_ in results if c), "/", len(results))\nPY\n'] min_timeout_sec: 1.0 