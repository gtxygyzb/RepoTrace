 AddAnnotation(w http.ResponseWriter, r *http.Request) {\n\\tmodelName := r.PathValue("name")\n\\tnumStr := r.PathValue("num")\n\\tnum, err := strconv.Atoi(numStr)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusBadRequest, "invalid version number: %v", err)\n\\t\\treturn\n\\t}\n\n\\tvar req struct {\n\\t\\tKey   string `json:"key"`\n\\t\\tValue string `json:"value"`\n\\t}\n\\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n\\t\\twriteError(w, http.StatusBadRequest, "invalid request body: %v", err)\n\\t\\treturn\n\\t}\n\\tif !registry.ValidateAnnotationKey(req.Key) {\n\\t\\twriteError(w, http.StatusBadRequest, "annotation key must contain only letters, digits, and underscores")\n\\t\\treturn\n\\t}\n\n\\tannotation, err := h.Registry.AddAnnotation(modelName, num, req.Key, req.Value)\n\\tif err != nil {\n\\t\\tif strings.Contains(err.Error(), "not found") {\n\\t\\t\\twriteError(w, http.StatusNotFound, "%v", err)\n\\t\\t} else if strings.Contains(err.Error(), "already exists") {\n\\t\\t\\twriteError(w, http.StatusConflict, "%v", err)\n\\t\\t} else {\n\\t\\t\\twriteError(w, http.StatusBadRequest, "%v", err)\n\\t\\t}\n\\t\\treturn\n\\t}\n\\twriteJSON(w, http.StatusCreated, annotation)\n}\n\nfunc (h *Handlers) ListAnnotations(w http.ResponseWriter, r *http.Request) {\n\\tmodelName := r.PathValue("name")\n\\tnumStr := r.PathValue("num")\n\\tnum, err := strconv.Atoi(numStr)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusBadRequest, "invalid version number: %v", err)\n\\t\\treturn\n\\t}\n\n\\tannotations, err := h.Registry.ListAnnotations(modelName, num)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusNotFound, "%v", err)\n\\t\\treturn\n\\t}\n\\twriteJSON(w, http.StatusOK, map[string]interface{}{\n\\t\\t"annotations": annotations,\n\\t\\t"count":       len(annotations),\n\\t})\n}\n\nfunc (h *Handlers) DeleteAnnotation(w http.ResponseWriter, r *http.Request) {\n\\tmodelName := r.PathValue("name")\n\\tnumStr := r.PathValue("num")\n\\tnum, err := strconv.Atoi(numStr)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusBadRequest, "invalid version number: %v", err)\n\\t\\treturn\n\\t}\n\\tkey := r.PathValue("key")\n\n\\tif err := h.Registry.DeleteAnnotation(modelName, num, key); err != nil {\n\\t\\twriteError(w, http.StatusNotFound, "%v", err)\n\\t\\treturn\n\\t}\n\\twriteJSON(w, http.StatusOK, map[string]string{"status": "deleted"})\n}\n\n// --- Pipeline Validation Handler ---\n\nfunc (h *Handlers) ValidatePipeline(w http.ResponseWriter, r *http.Request) {\n\\tvar req struct {\n\\t\\tName     string                 `json:"name"`\n\\t\\tSteps    []*pipeline.Step       `json:"steps"`\n\\t\\tInput    map[string]interface{} `json:"input"`\n\\t\\tPipeline *pipeline.Pipeline     `json:"pipeline"`\n\\t}\n\\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n\\t\\twriteError(w, http.StatusBadRequest, "invalid request body: %v", err)\n\\t\\treturn\n\\t}\n\\tp := req.Pipeline\n\\tif p == nil {\n\\t\\tp = &pipeline.Pipeline{Name: req.Name, Steps: req.Steps}\n\\t}\n\n\\tresult := h.Pipeline.Validate(p)\n\\twriteJSON(w, http.StatusOK, result)\n}\n\n// --- Serving Statistics Handlers ---\n\nfunc (h *Handlers) ServingStats(w http.ResponseWriter, r *http.Request) {\n\\twriteJSON(w, http.StatusOK, h.Serving.GetStats())\n}\n\nfunc (h *Handlers) ResetServingStats(w http.ResponseWriter, r *http.Request) {\n\\th.Serving.ResetStats()\n\\twriteJSON(w, http.StatusOK, map[string]string{"status": "reset"})\n}\n\n// --- Experiment Comparison Handler ---\n\ntype experimentComparisonEntry struct {\n\\tName  string  `json:"name"`\n\\tMean  float64 `json:"mean"`\n\\tMin   float64 `json:"min"`\n\\tMax   float64 `json:"max"`\n\\tCount int     `json:"count"`\n}\n\nfunc (h *Handlers) CompareExperiments(w http.ResponseWriter, r *http.Request) {\n\\texperimentsParam := r.URL.Query().Get("experiments")\n\\tmetric := r.URL.Query().Get("metric")\n\n\\tif metric == "" {\n\\t\\twriteError(w, http.StatusBadRequest, "metric parameter is required")\n\\t\\treturn\n\\t}\n\n\\tnames := strings.Split(experimentsParam, ",")\n\\tif len(names) < 2 {\n\\t\\twriteError(w, http.StatusBadRequest, "at least two experiment names are required")\n\\t\\treturn\n\\t}\n\\tfor i := range names {\n\\t\\tnames[i] = strings.TrimSpace(names[i])\n\\t}\n\n\\tfor _, name := range names {\n\\t\\tif _, err := h.Experiment.GetExperiment(name); err != nil {\n\\t\\t\\twriteError(w, http.StatusNotFound, "experiment %q not found", name)\n\\t\\t\\treturn\n\\t\\t}\n\\t}\n\n\\tvar entries []experimentComparisonEntry\n\\tvar means []float64\n\\ttotalRuns := 0\n\\tbest := ""\n\\tvar bestMean float64\n\n\\tfor _, name := range names {\n\\t\\texp, err := h.Experiment.GetExperiment(name)\n\\t\\tif err != nil {\n\\t\\t\\twriteError(w, http.StatusNotFound, "experiment %q not found", name)\n\\t\\t\\treturn\n\\t\\t}\n\n\\t\\tvar values []float64\n\\t\\tfor _, run := range exp.Runs {\n\\t\\t\\tif value, ok := run.Metrics[metric]; ok {\n\\t\\t\\t\\tvalues = append(values, value)\n\\t\\t\\t}\n\\t\\t}\n\\t\\tif len(values) == 0 {\n\\t\\t\\tcontinue\n\\t\\t}\n\n\\t\\tsum := 0.0\n\\t\\tminVal := values[0]\n\\t\\tmaxVal := values[0]\n\\t\\tfor _, value := range values {\n\\t\\t\\tsum += value\n\\t\\t\\tif value < minVal {\n\\t\\t\\t\\tminVal = value\n\\t\\t\\t}\n\\t\\t\\tif value > maxVal {\n\\t\\t\\t\\tmaxVal = value\n\\t\\t\\t}\n\\t\\t}\n\\t\\tmean := sum / float64(len(values))\n\\t\\tentries = append(entries, experimentComparisonEntry{\n\\t\\t\\tName:  name,\n\\t\\t\\tMean:  mean,\n\\t\\t\\tMin:   minVal,\n\\t\\t\\tMax:   maxVal,\n\\t\\t\\tCount: len(values),\n\\t\\t})\n\\t\\tmeans = append(means, mean)\n\\t\\ttotalRuns += len(values)\n\\t\\tif len(entries) == 1 || mean > bestMean {\n\\t\\t\\tbest = name\n\\t\\t\\tbestMean = mean\n\\t\\t}\n\\t}\n\n\\tif len(entries) == 0 {\n\\t\\twriteError(w, http.StatusBadRequest, "no data found for metric %q across specified experiments", metric)\n\\t\\treturn\n\\t}\n\n\\tspread := 0.0\n\\tif len(means) > 0 {\n\\t\\tminMean := means[0]\n\\t\\tmaxMean := means[0]\n\\t\\tfor _, mean := range means {\n\\t\\t\\tif mean < minMean {\n\\t\\t\\t\\tminMean = mean\n\\t\\t\\t}\n\\t\\t\\tif mean > maxMean {\n\\t\\t\\t\\tmaxMean = mean\n\\t\\t\\t}\n\\t\\t}\n\\t\\tspread = maxMean - minMean\n\\t}\n\n\\twriteJSON(w, http.StatusOK, map[string]interface{}{\n\\t\\t"metric": metric,\n\\t\\t"experiments": entries,\n\\t\\t"best": best,\n\\t\\t"summary": map[string]interface{}{\n\\t\\t\\t"spread":           spread,\n\\t\\t\\t"experiment_count": len(entries),\n\\t\\t\\t"total_runs":       totalRuns,\n\\t\\t},\n\\t})\n}\n\n\'\'\'\nif \'// --- Helpers ---\' not in s:\n    raise SystemExit(\'helpers marker not found\')\ns = s.replace(\'// --- Helpers ---\', insert + \'// --- Helpers ---\')\np.write_text(s)\nPY\ngofmt -w internal/api/handlers.go\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
