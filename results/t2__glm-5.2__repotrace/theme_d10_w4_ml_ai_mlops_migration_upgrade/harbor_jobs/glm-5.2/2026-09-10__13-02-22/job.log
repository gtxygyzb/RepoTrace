teNames {\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf("duplicate step name: %s", name))\n\t\t}\n\t}\n\n\tfor _, step := range p.Steps {\n\t\tif step == nil {\n\t\t\tcontinue\n\t\t}\n\t\tif _, exists := e.stepExecutors[step.Type]; !exists {\n\t\t\tresult.Valid = false\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf("unknown step type: %s", step.Type))\n\t\t}\n\t\tfor _, dep := range step.Dependencies {\n\t\t\tif !seen[dep] {\n\t\t\t\tresult.Valid = false\n\t\t\tresult.Errors = append(result.Errors, fmt.Sprintf("step %s depends on unknown step: %s", step.Name, dep))\n\t\t\t}\n\t\t}\n\t}\n\n\tordered, err := topologicalSort(p.Steps)\n\tif err != nil {\n\t\tresult.Valid = false\n\t\tresult.Errors = append(result.Errors, "dependency cycle detected")\n\t}\n\n\tif result.Valid && err == nil {\n\t\tfor _, step := range ordered {\n\t\t\tresult.ExecutionOrder = append(result.ExecutionOrder, step.Name)\n\t\t}\n\t}\n\n\tif len(result.Errors) > 0 {\n\t\tresult.Valid = false\n\t\tresult.ExecutionOrder = []string{}\n\t}\n\n\treturn result\n}\n\'\'\'\ns = s.replace(\'\\n// Execute runs a pipeline with the given initial input data.\', insert + \'\\n// Execute runs a pipeline with the given initial input data.\')\np.write_text(s)\nPY\ngofmt -w internal/pipeline/engine.go\ngo build ./internal/pipeline/\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
