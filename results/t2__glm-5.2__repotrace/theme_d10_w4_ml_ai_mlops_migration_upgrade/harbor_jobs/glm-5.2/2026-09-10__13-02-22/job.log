Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\n\ncontent = r\'\'\'package pipeline\n\nimport (\n\t"fmt"\n\t"sort"\n\t"strings"\n\t"time"\n)\n\n// StepType identifies the kind of processing a pipeline step performs.\ntype StepType string\n\nconst (\n\tStepTransform StepType = "transform"\n\tStepValidate  StepType = "validate"\n\tStepAggregate StepType = "aggregate"\n\tStepExport    StepType = "export"\n\tStepFilter    StepType = "filter"\n)\n\n// Step defines a single unit of work in a pipeline.\ntype Step struct {\n\tName            string                 `json:"name"`\n\tType            StepType               `json:"type"`\n\tConfig          map[string]interface{} `json:"config"`\n\tDependencies    []string               `json:"dependencies"`\n\tSetVars         map[string]string      `json:"set_vars,omitempty"`\n\tOutputTransform string                 `json:"output_transform,omitempty"`\n}\n\n// Pipeline defines a named sequence of dependent steps.\ntype Pipeline struct {\n\tName  string  `json:"name"`\n\tSteps []*Step `json:"steps"`\n}\n\n// StepResult records the outcome of executing a single step.\ntype StepResult struct {\n\tStepName   string                 `json:"step_name"`\n\tStepType   StepType               `json:"step_type"`\n\tStatus     string                 `json:"status"`\n\tOutput     map[string]interface{} `json:"output,omitempty"`\n\tError      string                 `json:"error,omitempty"`\n\tDurationMs float64                `json:"duration_ms"`\n}\n\n// PipelineResult records the outcome of executing an entire pipeline.\ntype PipelineResult struct {\n\tPipelineName string        `json:"pipeline_name"`\n\tStatus       string        `json:"status"`\n\tSteps        []*StepResult `json:"steps"`\n\tTotalTimeMs  float64       `json:"total_time_ms"`\n}\n\n// Engine executes pipelines by resolving step dependencies and running each step.\ntype Engine struct {\n\tstepExecutors map[StepType]StepExecutor\n}\n\n// StepExecutor is the function signature for executing a pipeline step.\ntype StepExecutor func(config, input map[string]interface{}) (map[string]interface{}, error)\n\n// NewEngine creates a pipeline engine with built-in step executors.\nfunc NewEngine() *Engine {\n\te := &Engine{\n\t\tstepExecutors: make(map[StepType]StepExecutor),\n\t}\n\te.stepExecutors[StepTransform] = ExecuteTransform\n\te.stepExecutors[StepValidate] = ExecuteValidate\n\te.stepExecutors[StepAggregate] = ExecuteAggregate\n\te.stepExecutors[StepExport] = ExecuteExport\n\te.stepExecutors[StepFilter] = ExecuteFilter\n\treturn e\n}\n\n// Execute runs a pipeline with the given initial input data.\nfunc (e *Engine) Execute(p *Pipeline, initialInput map[string]interface{}) (*PipelineResult, error) {\n\tordered, err := topologicalSort(p.Steps)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf("dependency resolution failed: %w", err)\n\t}\n\n\tpipelineStart := time.Now()\n\tresult := &PipelineResult{\n\t\tPipelineName: p.Name,\n\t\tStatus:       "success",\n\t\tSteps:        make([]*StepResult, 0, len(ordered)),\n\t}\n\n\tstepOutputs := make(map[string]map[string]interface{})\n\tvariables := make(map[string]float64)\n\tvariableSetter := make(map[string]string)\n\tallDeps := computeTransitiveDependencies(p.Steps)\n\n\tfor _, step := range ordered {\n\t\tstepStart := time.Now()\n\n\t\tresolvedConfig, err := resolveVariables(step.Config, variables, variableSetter, allDeps[step.Name])\n\t\tif err != nil {\n\t\t\tsr := &StepResult{\n\t\t\t\tStepName:   step.Name,\n\t\t\t\tStepType:   step.Type,\n\t\t\t\tStatus:     "failed",\n\t\t\t\tError:      err.Error(),\n\t\t\t\tDurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\n\t\t\t}\n\t\t\tresult.Steps = append(result.Steps, sr)\n\t\t\tresult.Status = "failed"\n\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\n\t\t\treturn result, nil\n\t\t}\n\n\t\t// Determine input for this step\n\t\tvar input map[string]interface{}\n\t\tif len(step.Dependencies) == 0 {\n\t\t\tinput = initialInput\n\t\t} else {\n\t\t\tinput = mergeDependencyOutputs(step.Dependencies, stepOutputs)\n\t\t}\n\n\t\t// Find and run the executor\n\t\texecutor, ok := e.stepExecutors[step.Type]\n\t\tif !ok {\n\t\t\tsr := &StepResult{\n\t\t\t\tStepName:   step.Name,\n\t\t\t\tStepType:   step.Type,\n\t\t\t\tStatus:     "failed",\n\t\t\t\tError:      fmt.Sprintf("unknown step type: %s", step.Type),\n\t\t\t\tDurationMs: float64(time.Since(stepStart).Microseconds()) / 1000.0,\n\t\t\t}\n\t\t\tresult.Steps = append(result.Steps, sr)\n\t\t\tresult.Status = "failed"\n\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\n\t\t\treturn result, nil\n\t\t}\n\n\t\toutput, err := executor(resolvedConfig, input)\n\t\tduration := float64(time.Since(stepStart).Microseconds()) / 1000.0\n\n\t\tsr := &StepResult{\n\t\t\tStepName:   step.Name,\n\t\t\tStepType:   step.Type,\n\t\t\tDurationMs: duration,\n\t\t}\n\n\t\tif err != nil {\n\t\t\tsr.Status = "failed"\n\t\t\tsr.Error = err.Error()\n\t\t\tresult.Steps = append(result.Steps, sr)\n\t\t\tresult.Status = "failed"\n\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\n\t\t\treturn result, nil\n\t\t}\n\n\t\tif step.OutputTransform != "" {\n\t\t\ttransformed, terr := applyOutputTransform(output, resolvedConfig, step.OutputTransform)\n\t\t\tif terr != nil {\n\t\t\t\tsr.Status = "failed"\n\t\t\t\tsr.Error = terr.Error()\n\t\t\t\tresult.Steps = append(result.Steps, sr)\n\t\t\t\tresult.Status = "failed"\n\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\n\t\t\t\treturn result, nil\n\t\t\t}\n\t\t\toutput = transformed\n\t\t}\n\n\t\tif len(step.SetVars) > 0 {\n\t\t\tif verr := setVariables(output, step.SetVars, variables, variableSetter, step.Name); verr != nil {\n\t\t\t\tsr.Status = "failed"\n\t\t\t\tsr.Error = verr.Error()\n\t\t\t\tresult.Steps = append(result.Steps, sr)\n\t\t\t\tresult.Status = "failed"\n\t\t\t\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\n\t\t\t\treturn result, nil\n\t\t\t}\n\t\t}\n\n\t\tsr.Status = "success"\n\t\tsr.Output = output\n\t\tresult.Steps = append(result.Steps, sr)\n\n\t\tstepOutputs[step.Name] = output\n\t}\n\n\tresult.TotalTimeMs = float64(time.Since(pipelineStart).Microseconds()) / 1000.0\n\treturn result, nil\n}\n\n// topologicalSort orders steps so that dependencies are executed first.\n// Returns an error if a cycle is detected.\nfunc topologicalSort(steps []*Step) ([]*Step, error) {\n\tstepMap := make(map[string]*Step)\n\tinDegree := make(map[string]int)\n\n\tfor _, s := range steps {\n\t\tstepMap[s.Name] = s\n\t\tinDegree[s.Name] = 0\n\t}\n\n\t// Build in-degree counts\n\tfor _, s := range steps {\n\t\tfor _, dep := range s.Dependencies {\n\t\t\tif _, ok := stepMap[dep]; !ok {\n\t\t\t\treturn nil, fmt.Errorf("step %q depends on unknown step %q", s.Name, dep)\n\t\t\t}\n\t\t\tinDegree[s.Name]++\n\t\t}\n\t}\n\n\t// Initialize queue with steps that have no dependencies\n\tqueue := make([]*Step, 0)\n\tfor _, s := range steps {\n\t\tif inDegree[s.Name] == 0 {\n\t\t\tqueue = append(queue, s)\n\t\t}\n\t}\n\n\t// Process steps in topological order\n\tordered := make([]*Step, 0, len(steps))\n\tfor len(queue) > 0 {\n\t\tcurrent := queue[0]\n\t\tqueue = queue[1:]\n\t\tordered = append(ordered, current)\n\n\t\t// Find steps that depend on current\n\t\tfor _, s := range steps {\n\t\t\tfor _, dep := range s.Dependencies {\n\t\t\t\tif dep == current.Name {\n\t\t\t\t\tinDegree[s.Name]--\n\t\t\t\t\tif inDegree[s.Name] == 0 {\n\t\t\t\t\t\tqueue = append(queue, s)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tif len(ordered) != len(steps) {\n\t\treturn nil, fmt.Errorf("cycle detected in pipeline dependencies")\n\t}\n\n\treturn ordered, nil\n}\n\n// mergeDependencyOutputs concatenates the "data" arrays from all dependency outputs into a single input.\nfunc mergeDependencyOutputs(deps []string, outputs map[string]map[string]interface{}) map[string]interface{} {\n\tmerged := make([]interface{}, 0)\n\tfor _, dep := range deps {\n\t\tout, ok := outputs[dep]\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tswitch data := out["data"].(type) {\n\t\tcase []interface{}:\n\t\t\tmerged = append(merged, data...)\n\t\tcase []float64:\n\t\t\tfor _, v := range data {\n\t\t\t\tmerged = append(merged, v)\n\t\t\t}\n\t\t}\n\t}\n\treturn map[string]interface{}{"data": merged}\n}\n\nfunc computeTransitiveDependencies(steps []*Step) map[string]map[string]bool {\n\tstepMap := make(map[string]*Step)\n\tfor _, s := range steps {\n\t\tstepMap[s.Name] = s\n\t}\n\n\tresult := make(map[string]map[string]bool)\n\tvar visit func(s *Step) map[string]bool\n\n\tvisit = func(s *Step) map[string]bool {\n\t\tif deps, ok := result[s.Name]; ok {\n\t\t\treturn deps\n\t\t}\n\t\tdeps := make(map[string]bool)\n\t\tfor _, dep := range s.Dependencies {\n\t\t\tdeps[dep] = true\n\t\t\tif depStep, ok := stepMap[dep]; ok {\n\t\t\t\tfor d := range visit(depStep) {\n\t\t\t\t\tdeps[d] = true\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tresult[s.Name] = deps\n\t\treturn deps\n\t}\n\n\tfor _, s := range steps {\n\t\tvisit(s)\n\t}\n\treturn result\n}\n\nfunc resolveVariables(config map[string]interface{}, variables map[string]float64, setter map[string]string, depSet map[string]bool) (map[string]interface{}, error) {\n\tif len(variables) == 0 {\n\t\treturn config, nil\n\t}\n\n\tresolved := make(map[string]interface{}, len(config))\n\tfor k, v := range config {\n\t\tif s, ok := v.(string); ok {\n\t\t\tif strings.HasPrefix(s, "${") && strings.HasSuffix(s, "}") {\n\t\t\t\tvarName := s[2 : len(s)-1]\n\t\t\t\tval, ok := variables[varName]\n\t\t\t\tif !ok {\n\t\t\t\t\treturn nil, fmt.Errorf("undefined variable")\n\t\t\t\t}\n\t\t\t\tsetterStep, ok := setter[varName]\n\t\t\t\tif !ok || !depSet[setterStep] {\n\t\t\t\t\treturn nil, fmt.Errorf("variable not in dependency chain")\n\t\t\t\t}\n\t\t\t\tresolved[k] = val\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tresolved[k] = v\n\t}\n\treturn resolved, nil\n}\n\nfunc applyOutputTransform(output map[string]interface{}, config map[string]interface{}, transform string) (map[string]interface{}, error) {\n\tdata, ok := output["data"]\n\tif !ok {\n\t\treturn output, nil\n\t}\n\n\tvar arr []interface{}\n\tswitch d := data.(type) {\n\tcase []interface{}:\n\t\tarr = d\n\tcase []float64:\n\t\tarr = make([]interface{}, len(d))\n\t\tfor i, v := range d {\n\t\t\tarr[i] = v\n\t\t}\n\tdefault:\n\t\treturn output, nil\n\t}\n\n\tswitch transform {\n\tcase "sort_asc":\n\t\tvals, err := toFloatSlice(arr)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tsort.Float64s(vals)\n\t\tarr = make([]interface{}, len(vals))\n\t\tfor i, v := range vals {\n\t\t\tarr[i] = v\n\t\t}\n\n\tcase "sort_desc":\n\t\tvals, err := toFloatSlice(arr)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tsort.Sort(sort.Reverse(sort.Float64Slice(vals)))\n\t\tarr = make([]interface{}, len(vals))\n\t\tfor i, v := range vals {\n\t\t\tarr[i] = v\n\t\t}\n\n\tcase "unique":\n\t\tseen := make(map[float64]bool)\n\t\tunique := make([]interface{}, 0, len(arr))\n\t\tfor _, v := range arr {\n\t\t\tval, err := toFloat(v)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, fmt.Errorf("output transform unique: non-numeric value: %w", err)\n\t\t\t}\n\t\t\tif !seen[val] {\n\t\t\t\tseen[val] = true\n\t\t\t\tunique = append(unique, v)\n\t\t\t}\n\t\t}\n\t\tarr = unique\n\n\tcase "reverse":\n\t\trev := make([]interface{}, len(arr))\n\t\tfor i, v := range arr {\n\t\t\trev[len(arr)-1-i] = v\n\t\t}\n\t\tarr = rev\n\n\tcase "take":\n\t\tn, err := takeCount(config)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif n > len(arr) {\n\t\t\tn = len(arr)\n\t\t}\n\t\tif n < 0 {\n\t\t\tn = 0\n\t\t}\n\t\tarr = arr[:n]\n\n\tdefault:\n\t\treturn nil, fmt.Errorf("unknown output transform: %q", transform)\n\t}\n\n\toutput["data"] = arr\n\treturn output, nil\n}\n\nfunc takeCount(config map[string]interface{}) (int, error) {\n\traw, ok := config["take_count"]\n\tif !ok {\n\t\treturn 0, fmt.Errorf("output transform take: take_count is required")\n\t}\n\tswitch v := raw.(type) {\n\tcase float64:\n\t\treturn int(v), nil\n\tcase int:\n\t\treturn v, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf("output transform take: take_count must be numeric")\n\t}\n}\n\nfunc setVariables(output map[string]interface{}, setVars map[string]string, variables map[string]float64, setter map[string]string, stepName string) error {\n\tfor varName, fieldName := range setVars {\n\t\tvalue, ok := output[fieldName]\n\t\tif !ok {\n\t\t\treturn fmt.Errorf("output field not found")\n\t\t}\n\t\tnum, err := toFloat(value)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf("non-numeric variable")\n\t\t}\n\t\tvariables[varName] = num\n\t\tsetter[varName] = stepName\n\t}\n\treturn nil\n}\n\nfunc toFloatSlice(arr []interface{}) ([]float64, error) {\n\tvals := make([]float64, 0, len(arr))\n\tfor i, v := range arr {\n\t\tval, err := toFloat(v)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf("element %d: %w", i, err)\n\t\t}\n\t\tvals = append(vals, val)\n\t}\n\treturn vals, nil\n}\n\'\'\'\nPath(\'internal/pipeline/engine.go\').write_text(content)\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
