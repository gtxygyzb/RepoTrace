", methods, 1)\np.write_text(text)\n\n# --- handlers ---\np = Path("internal/api/handlers.go")\ntext = p.read_text()\nold = \'\'\'if err := h.Experiment.DeleteRun(expName, runID); err != nil {\n\\t\\twriteError(w, http.StatusNotFound, "%v", err)\n\\t\\treturn\n\\t}\n\\twriteJSON(w, http.StatusOK, map[string]string{"status": "deleted"})\'\'\'\nnew = \'\'\'run, err := h.Experiment.DeleteRun(expName, runID)\n\\tif err != nil {\n\\t\\twriteError(w, http.StatusNotFound, "%v", err)\n\\t\\treturn\n\\t}\n\\twriteJSON(w, http.StatusOK, run)\'\'\'\nif old not in text:\n    raise SystemExit("DeleteRun handler block not found")\ntext = text.replace(old, new, 1)\nnew_handlers = \'\'\'func (h *Handlers) ExperimentLeaderboard(w http.ResponseWriter, r *http.Request) {\n\\texpName := r.PathValue("name")\n\\tmetric := r.URL.Query().Get("metric")\n\\tif metric == "" {\n\\t\\twriteError(w, http.StatusBadRequest, "metric query parameter is required")\n\\t\\treturn\n\\t}\n\n\\torder := r.URL.Query().Get("order")\n\\tif order == "" {\n\\t\\torder = "desc"\n\\t}\n\\tif order != "asc" && order != "desc" {\n\\t\\twriteError(w, http.StatusBadRequest, "order must be \\\\"asc\\\\" or \\\\"desc\\\\"")\n\\t\\treturn\n\\t}\n\n\\tlimit := 10\n\\tif limitStr := r.URL.Query().Get("limit"); limitStr != "" {\n\\t\\tn, err := strconv.Atoi(limitStr)\n\\t\\tif err != nil {\n\\t\\t\\twriteError(w, http.StatusBadRequest, "limit must be an integer")\n\\t\\t\\treturn\n\\t\\t}\n\\t\\tif n < 0 {\n\\t\\t\\tn = 0\n\\t\\t}\n\\t\\tlimit = n\n\\t}\n\n\\tresult, err := h.Experiment.Leaderboard(expName, metric, order, limit)\n\\tif err != nil {\n\\t\\tif strings.Contains(err.Error(), "not found") {\n\\t\\t\\twriteError(w, http.StatusNotFound, "%v", err)\n\\t\\t} else {\n\\t\\t\\twriteError(w, http.StatusBadRequest, "%v", err)\n\\t\\t}\n\\t\\treturn\n\\t}\n\n\\twriteJSON(w, http.StatusOK, result)\n}\n\nfunc (h *Handlers) ExperimentSummary(w http.ResponseWriter, r *http.Request) {\n\\texpName := r.PathValue("name")\n\\tmetric := r.URL.Query().Get("metric")\n\\tif metric == "" {\n\\t\\twriteError(w, http.StatusBadRequest, "metric query parameter is required")\n\\t\\treturn\n\\t}\n\n\\tresult, err := h.Experiment.Summary(expName, metric)\n\\tif err != nil {\n\\t\\tif strings.Contains(err.Error(), "not found") {\n\\t\\t\\twriteError(w, http.StatusNotFound, "%v", err)\n\\t\\t} else {\n\\t\\t\\twriteError(w, http.StatusBadRequest, "%v", err)\n\\t\\t}\n\\t\\treturn\n\\t}\n\n\\twriteJSON(w, http.StatusOK, result)\n}\n\nfunc (h *Handlers) ReloadModel(w http.ResponseWriter, r *http.Request) {\n\\tname := r.PathValue("name")\n\\tloaded, err := h.Serving.ReloadModel(name)\n\\tif err != nil {\n\\t\\tif strings.Contains(err.Error(), "is not loaded") {\n\\t\\t\\twriteError(w, http.StatusNotFound, "%v", err)\n\\t\\t} else {\n\\t\\t\\twriteError(w, http.StatusBadRequest, "%v", err)\n\\t\\t}\n\\t\\treturn\n\\t}\n\n\\twriteJSON(w, http.StatusOK, map[string]interface{}{\n\\t\\t"status":      "reloaded",\n\\t\\t"model_name":  loaded.ModelName,\n\\t\\t"version_num": loaded.VersionNum,\n\\t\\t"stage":       loaded.Stage,\n\\t})\n}\n\nfunc (h *Handlers) WarmupModel(w http.ResponseWriter, r *http.Request) {\n\\tname := r.PathValue("name")\n\\tresult, err := h.Serving.WarmupModel(name)\n\\tif err != nil {\n\\t\\tif strings.Contains(err.Error(), "is not loaded") {\n\\t\\t\\twriteError(w, http.StatusNotFound, "%v", err)\n\\t\\t} else {\n\\t\\t\\twriteError(w, http.StatusBadRequest, "%v", err)\n\\t\\t}\n\\t\\treturn\n\\t}\n\n\\twriteJSON(w, http.StatusOK, result)\n}\n\n\'\'\'\nidx = text.index("func writeJSON")\ntext = text[:idx] + new_handlers + "\\n" + text[idx:]\np.write_text(text)\n\n# --- router ---\np = Path("internal/api/router.go")\ntext = p.read_text()\ntext = text.replace(\n    \'mux.HandleFunc("POST /api/v1/experiments/{name}/runs/search", h.SearchRuns)\',\n    \'mux.HandleFunc("POST /api/v1/experiments/{name}/runs/search", h.SearchRuns)\\n\\tmux.HandleFunc("GET /api/v1/experiments/{name}/leaderboard", h.ExperimentLeaderboard)\\n\\tmux.HandleFunc("GET /api/v1/experiments/{name}/summary", h.ExperimentSummary)\',\n    1\n)\ntext = text.replace(\n    \'mux.HandleFunc("POST /api/v1/serving/stats/reset", h.ResetServingStats)\',\n    \'mux.HandleFunc("POST /api/v1/serving/stats/reset", h.ResetServingStats)\\n\\tmux.HandleFunc("POST /api/v1/serving/models/{name}/reload", h.ReloadModel)\\n\\tmux.HandleFunc("POST /api/v1/serving/models/{name}/warmup", h.WarmupModel)\',\n    1\n)\np.write_text(text)\n\nprint("patched")\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
