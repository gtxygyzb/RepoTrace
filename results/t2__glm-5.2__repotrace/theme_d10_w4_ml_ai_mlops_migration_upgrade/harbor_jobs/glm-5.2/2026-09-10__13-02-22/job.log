\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc toFloat64(v interface{}) (float64, bool) {\n\tswitch val := v.(type) {\n\tcase float64:\n\t\treturn val, true\n\tcase int:\n\t\treturn float64(val), true\n\tcase int64:\n\t\treturn float64(val), true\n\t}\n\treturn 0, false\n}\n\nfunc substituteParameters(tmpl *Template, params map[string]interface{}) (*pipeline.Pipeline, error) {\n\tdeclared := make(map[string]TemplateParameter)\n\tfor _, p := range tmpl.Parameters {\n\t\tdeclared[p.Name] = p\n\t}\n\tfor name := range params {\n\t\tif _, ok := declared[name]; !ok {\n\t\t\treturn nil, fmt.Errorf("unknown parameter %q", name)\n\t\t}\n\t}\n\tresolved := make(map[string]interface{})\n\tfor name, p := range declared {\n\t\tif val, ok := params[name]; ok {\n\t\t\tif err := validateParamValue(p, val); err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t\tresolved[name] = val\n\t\t} else if p.Default != nil {\n\t\t\tresolved[name] = p.Default\n\t\t} else {\n\t\t\treturn nil, fmt.Errorf("missing required parameter %q", name)\n\t\t}\n\t}\n\tdata, err := json.Marshal(tmpl.Pipeline)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar p pipeline.Pipeline\n\tif err := json.Unmarshal(data, &p); err != nil {\n\t\treturn nil, err\n\t}\n\tfor _, step := range p.Steps {\n\t\tif step.Config != nil {\n\t\t\tfor k, v := range step.Config {\n\t\t\t\tif s, ok := v.(string); ok {\n\t\t\t\t\tif strings.HasPrefix(s, "${param.") && strings.HasSuffix(s, "}") {\n\t\t\t\t\t\tparamName := s[8 : len(s)-1]\n\t\t\t\t\t\tval, ok := resolved[paramName]\n\t\t\t\t\t\tif !ok {\n\t\t\t\t\t\t\treturn nil, fmt.Errorf("unknown parameter %q", paramName)\n\t\t\t\t\t\t}\n\t\t\t\t\t\tstep.Config[k] = val\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn &p, nil\n}\n\nfunc validateParamValue(p TemplateParameter, val interface{}) error {\n\tswitch p.Type {\n\tcase "number":\n\t\tif _, ok := toFloat64(val); !ok {\n\t\t\treturn fmt.Errorf("parameter %q must be a number", p.Name)\n\t\t\t}\n\tcase "string"