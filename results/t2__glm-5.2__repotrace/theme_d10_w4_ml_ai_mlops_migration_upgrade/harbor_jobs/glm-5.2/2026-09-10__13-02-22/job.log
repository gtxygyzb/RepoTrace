.CreatedAt = time.Now()\n\tt.UpdatedAt = nil\n\ts.templates[t.Name] = t\n\treturn nil\n}\n\nfunc (s *TemplateStore) Update(t *Template) error {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\tif _, exists := s.templates[t.Name]; !exists {\n\t\treturn fmt.Errorf("template %q not found", t.Name)\n\t}\n\tnow := time.Now()\n\tt.UpdatedAt = &now\n\ts.templates[t.Name] = t\n\treturn nil\n}\n\nfunc (s *TemplateStore) Delete(name string) error {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\tif _, exists := s.templates[name]; !exists {\n\t\treturn fmt.Errorf("template %q not found", name)\n\t}\n\tdelete(s.templates, name)\n\treturn nil\n}\n\nfunc (h *Handlers) CreateTemplate(w http.ResponseWriter, r *http.Request) {\n\tvar req struct {\n\t\tName        string              `json:"name"`\n\t\tDescription string              `json:"description"`\n\t\tParameters []TemplateParameter `json:"parameters"`\n\t\tPipeline    *pipeline.Pipeline `json:"pipeline"`\n\t}\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n\t\twriteError(w, http.StatusBadRequest, "invalid request body: %v", err)\n\t\treturn\n\t}\n\tif !validateTemplateName(req.Name) {\n\t\twriteError(w, http.StatusBadRequest, "invalid template name")\n\t\treturn\n\t}\n\tif req.Pipeline == nil || len(req.Pipeline.Steps) == 0 {\n\t\twriteError(w, http.StatusBadRequest, "pipeline with at least one step is required")\n\t\treturn\n\t}\n\tparams := req.Parameters\n\tif params == nil {\n\t\tparams = []TemplateParameter{}\n\t}\n\tif err := validateParameters(params); err != nil {\n\t\twriteError(w, http.StatusBadRequest, "%v", err)\n\t\treturn\n\t}\n\ttmpl := &Template{\n\t\tName:        req.Name,\n\t\tDescription: req.Description,\n\t\tParameters:  params,\n\t\tPipeline:    req.Pipeline,\n\t}\n\tif err := h.Templates.Create(tmpl); err != nil {\n\t\twriteError(w, http.StatusConflict, "%v", err)\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusCreated, templateResponse(tmpl))\n}\n\nfunc (h *Handlers) ListTemplates(w http.ResponseWriter, r *http.Request) {\n\tsortBy := r.URL.Query().Get("sort")\n\twriteJSON(w, http.StatusOK, templateListResponse(h.Templates.List(sortBy)))\n}\n\nfunc (h *Handlers) GetTemplate(w http.ResponseWriter, r *http.Request) {\n\tname := r.PathValue("name")\n\ttmpl, ok := h.Templates.Get(name)\n\tif !ok {\n\t\twriteError(w, http.StatusNotFound, "template %q not found", name)\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, templateResponse(tmpl))\n}\n\nfunc (h *Handlers) UpdateTemplate(w http.ResponseWriter, r *http.Request) {\n\tname := r.PathValue("name")\n\ttmpl, ok := h.Templates.Get(name)\n\tif !ok {\n\t\twriteError(w, http.StatusNotFound, "template %q not found", name)\n\t\treturn\n\t}\n\tvar req struct {\n\t\tDescription *string              `json:"description"`\n\t\tParameters *[]TemplateParameter `json:"parameters"`\n\t\tPipeline   *pipeline.Pipeline   `json:"pipeline"`\n\t}\n\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n\t\twriteError(w, http.StatusBadRequest, "invalid request body: %v", err)\n\t\treturn\n\t}\n\tupdated := &Template{\n\t\tName:        tmpl.Name,\n\t\tDescription: tmpl.Description,\n\t\tParameters:  tmpl.Parameters,\n\t\tPipeline:    tmpl.Pipeline,\n\t\tCreatedAt:   tmpl.CreatedAt,\n\t}\n\tif req.Description != nil {\n\t\tupdated.Description = *req.Description\n\t}\n\tif req.Parameters != nil {\n\t\tif err := validateParameters(*req.Parameters); err != nil {\n\t\t\twriteError(w, http.StatusBadRequest, "%v", err)\n\t\t\treturn\n\t\t}\n\t\tupdated.Parameters = *req.Parameters\n\t}\n\tif req.Pipeline != nil {\n\t\tif len(req.Pipeline.Steps) == 0 {\n\t\t\twriteError(w, http.StatusBadRequest, "pipeline with at least one step is required")\n\t\t\treturn\n\t\t}\n\t\tupdated.Pipeline = req.Pipeline\n\t}\n\tif err := h.Templates.Update(updated); err != nil {\n\t\twriteError(w, http.StatusNotFound, "%v", err)\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, templateResponse(updated))\n}\n\nfunc (h *Handlers) DeleteTemplate(w http.ResponseWriter,