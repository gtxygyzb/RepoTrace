ost recent first.\nfunc (e *Engine) ListExecutionHistory(limit int) ([]PipelineExecutionRecord, int) {\n\\te.historyMu.Lock()\n\\tdefer e.historyMu.Unlock()\n\n\\ttotal := len(e.history)\n\\tif limit <= 0 {\n\\t\\tlimit = 10\n\\t}\n\\tif limit > total {\n\\t\\tlimit = total\n\\t}\n\\tstart := total - limit\n\\tresult := make([]PipelineExecutionRecord, limit)\n\\tcopy(result, e.history[start:])\n\\t// Reverse to most recent first\n\\tfor i, j := 0, len(result)-1; i < j; i, j = i+1, j-1 {\n\\t\\tresult[i], result[j] = result[j], result[i]\n\\t}\n\\treturn result, total\n}\n\'\'\'\nif old not in s:\n    raise SystemExit(\'NewEngine tail not found\')\ns = s.replace(old, new)\n\np.write_text(s)\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
