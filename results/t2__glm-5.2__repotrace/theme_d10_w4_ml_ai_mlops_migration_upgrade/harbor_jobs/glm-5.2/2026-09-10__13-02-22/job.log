il {\n\\t\\twriteError(w, http.StatusBadRequest, "%v", err)\n\\t\\treturn\n\\t}\n\\twriteJSON(w, http.StatusOK, map[string]interface{}{\n\\t\\t"template_info": map[string]interface{}{\n\\t\\t\\t"template_name":  name,\n\\t\\t\\t"resolved_params": resolvedParams,\n\\t\\t\\t"defaults_used":  defaultsUsed,\n\\t\\t},\n\\t\\t"pipeline_name": result.PipelineName,\n\\t\\t"status":        result.Status,\n\\t\\t"steps":         result.Steps,\n\\t\\t"total_time_ms": result.TotalTimeMs,\n\\t})\n}\'\'\'\nif old_exec not in s:\n    raise SystemExit(\'ExecuteTemplate block not found\')\ns = s.replace(old_exec, new_exec)\nold_sub = \'\'\'func substituteParameters(tmpl *Template, params map[string]interface{}) (*pipeline.Pipeline, error) {\n\\tdeclared := make(map[string]TemplateParameter)\n\\tfor _, p := range tmpl.Parameters {\n\\t\\tdeclared[p.Name] = p\n\\t}\n\\tfor name := range params {\n\\t\\tif _, ok := declared[name]; !ok {\n\\t\\t\\treturn nil, fmt.Errorf("unknown parameter %q", name)\n\\t\\t}\n\\t}\n\\tresolved := make(map[string]interface{})\n\\tfor name, p := range declared {\n\\t\\tif val, ok := params[name]; ok {\n\\t\\t\\tif err := validateParamValue(p, val); err != nil {\n\\t\\t\\t\\treturn nil, err\n\\t\\t\\t}\n\\t\\t\\tresolved[name] = val\n\\t\\t} else if p.Default != nil {\n\\t\\t\\tresolved[name] = p.Default\n\\t\\t} else {\n\\t\\t\\treturn nil, fmt.Errorf("missing required parameter %q", name)\n\\t\\t}\n\\t}\n\\tdata, err := json.Marshal(tmpl.Pipeline)\n\\tif err != nil {\n\\t\\t\\treturn nil, err\n\\t\\t}\n\\tvar p pipeline.Pipeline\n\\tif err := json.Unmarshal(data, &p); err != nil {\n\\t\\t\\treturn nil, err\n\\t\\t}\n\\tfor _, step := range p.Steps {\n\\t\\tif step.Config != nil {\n\\t\\t\\tfor k, v := range step.Config {\n\\t\\t\\t\\tif s, ok := v.(string); ok {\n\\t\\t\\t\\t\\tif strings.HasPrefix(s, "${param.") && strings.HasSuffix(s, "}") {\n\\t\\t\\t\\t\\t\\tparamName := s[8 : len(s)-1]\n\\t\\t\\t\\t\\t\\tval, ok := resolved[paramName]\n\\t\\t\\t\\t\