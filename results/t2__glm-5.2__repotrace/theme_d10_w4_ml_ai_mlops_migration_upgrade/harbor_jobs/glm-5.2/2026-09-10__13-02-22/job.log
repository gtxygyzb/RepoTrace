n = re.subn(dep_pattern, dep_replacement, text, count=1)\nif n != 1:\n    raise SystemExit("dependency validation block not replaced")\n\ncycle_pattern = r\'\'\'ordered, err := topologicalSort\\(p\\.Steps\\)\n\\tif err != nil \\{\n\\t\\tresult\\.Valid = false\n\\t\\tif strings\\.Contains\\(err\\.Error\\(\\), "cycle"\\) \\{\n\\t\\t\\tresult\\.Errors = append\\(result\\.Errors, "dependency cycle detected"\\)\n\\t\\t\\}\n\\t\\}\'\'\'\ncycle_replacement = \'\'\'ordered, err := topologicalSort(p.Steps)\n\tif err != nil {\n\t\tresult.Valid = false\n\t\tif strings.Contains(err.Error(), "cycle") && !selfDependencyFound {\n\t\t\tresult.Errors = append(result.Errors, "dependency cycle detected")\n\t\t}\n\t}\'\'\'\ntext, n = re.subn(cycle_pattern, cycle_replacement, text, count=1)\nif n != 1:\n    raise SystemExit("cycle validation block not replaced")\np.write_text(text)\n\n# --- experiment deletion + leaderboard + summary ---\np = Path("internal/experiment/experiment.go")\ntext = p.read_text()\nstart = text.index("func (t *Tracker) DeleteRun")\nend = text.index("\\n\\nfunc percentile", start)\nnew_block = \'\'\'func (t *Tracker) DeleteRun(experimentName, runID string) (*Run, error) {\n\\tt.mu.Lock()\n\\tdefer t.mu.Unlock()\n\n\\texp, exists := t.experiments[experimentName]\n\\tif !exists {\n\\t\\treturn nil, fmt.Errorf("experiment %q not found", experimentName)\n\\t}\n\n\\tfor i, run := range exp.Runs {\n\\t\\tif run.ID == runID {\n\\t\\t\\tdeleted := exp.Runs[i]\n\\t\\t\\texp.Runs = append(exp.Runs[:i], exp.Runs[i+1:]...)\n\\t\\t\\tif err := t.saveExperiment(exp); err != nil {\n\\t\\t\\t\\treturn nil, err\n\\t\\t\\t}\n\\t\\t\\treturn deleted, nil\n\\t\\t}\n\\t}\n\\treturn nil, fmt.Errorf("run %q not found in experiment %q", runID, experimentName)\n}\n\n// LeaderboardEntry represents a run in a metric leaderboard.\ntype LeaderboardEntry struct {\n\\tRank       int                    `json:"rank"`\n\\tRunID      string                 `json:"run_id"`\n\\tValue      float64   