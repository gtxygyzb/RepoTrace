dFailed) {\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\n\tdata, err := os.ReadFile(baselinePath)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\tfmt.Fprintf(os.Stderr, "error: baseline not found: %s\\n", baselinePath)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(os.Stderr, "error: invalid baseline: %v\\n", err)\n\t\treturn 1\n\t}\n\n\ttype baselineTarget struct {\n\t\tFingerprint string `json:"fingerprint"`\n\t\tOutputHash  string `json:"output_hash"`\n\t}\n\tvar baseline struct {\n\t\tChainHash *string                   `json:"chain_hash,omitempty"`\n\t\tTargets   map[string]baselineTarget `json:"targets"`\n\t}\n\tif err := json.Unmarshal(data, &baseline); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: invalid baseline: %v\\n", err)\n\t\treturn 1\n\t}\n\n\tchainHash := computeChainHash(results)\n\n\ttype extraJSON struct {\n\t\tName        string `json:"name"`\n\t\tFingerprint string `json:"fingerprint"`\n\t\tOutputHash  string `json:"output_hash"`\n\t}\n\ttype targetJSON struct {\n\t\tName                string `json:"name"`\n\t\tBaselineFingerprint string `json:"baseline_fingerprint"`\n\t\tCurrentFingerprint  string `json:"current_fingerprint"`\n\t\tFingerprintMatch    bool   `json:"fingerprint_match"`\n\t\tBaselineOutputHash  string `json:"baseline_output_hash"`\n\t\tCurrentOutputHash   string `json:"current_output_hash"`\n\t\tOutputMatch         bool   `json:"output_match"`\n\t}\n\n\tcurrentNames := make(map[string]bool, len(results))\n\tfor _, r := range results {\n\t\tcurrentNames[r.Target.Name] = true\n\t}\n\n\textraInBaseline := make([]extraJSON, 0)\n\tfor name, entry := range baseline.Targets {\n\t\tif !currentNames[name] {\n\t\t\textraInBaseline = append(extraInBaseline, extraJSON{\n\t\t\t\tName:        name,\n\t\t\t\tFingerprint: entry.Fingerprint,\n\t\t\t\tOutputHash:  entry.OutputHash,\n\t\t\t})\n\t\t}\n\t}\n\tsort.Slice(extraInBaseline, func(i, j int) bool { return extraInBaseline[j].Name > extraInBaseline[i].Name })\n\n\textraInCurrent := make([]extraJSON, 0)\n\tfor _, r := range results {\n\t\tif _, ok := baseline.Targets[r.Target.Name]; !ok {\n\t\t\textraInCurrent = append(extraInCurrent, extraJSON{\n\t\t\t\tName:        r.Target.Name,\n\t\t\t\tFingerprint: r.Fingerprint,\n\t\t\t\tOutputHash:  r.OutputHash,\n\t\t\t})\n\t\t}\n\t}\n\tsort.Slice(extraInCurrent, func(i, j int) bool { return extraInCurrent[j].Name > extraInCurrent[i].Name })\n\n\ttargets := make([]targetJSON, 0, len(results))\n\tallCommonMatch := true\n\tfor _, r := range results {\n\t\tentry, ok := baseline.Targets[r.Target.Name]\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tfpMatch := entry.Fingerprint == r.Fingerprint\n\t\toutMatch := entry.OutputHash == r.OutputHash\n\t\tif !fpMatch || !outMatch {\n\t\t\tallCommonMatch = false\n\t\t}\n\t\ttargets = append(targets, targetJSON{\n\t\t\tName:                r.Target.Name,\n\t\t\tBaselineFingerprint: entry.Fingerprint,\n\t\t\tCurrentFingerprint:  r.Fingerprint,\n\t\t\tFingerprintMatch:    fpMatch,\n\t\t\tBaselineOutputHash:  entry.OutputHash,\n\t\t\tCurrentOutputHash:   r.OutputHash,\n\t\t\tOutputMatch:         outMatch,\n\t\t})\n\t}\n\n\thasExtra := len(extraInBaseline) > 0 || len(extraInCurrent) > 0\n\tmatches := allCommonMatch && !hasExtra\n\n\ttype output struct {\n\t\tMatches         bool         `json:"matches"`\n\t\tChainHash       string       `json:"chain_hash"`\n\t\tChainMatch      *bool        `json:"chain_match,omitempty"`\n\t\tExtraInBaseline []extraJSON  `json:"extra_in_baseline"`\n\t\tExtraInCurrent  []extraJSON  `json:"extra_in_current"`\n\t\tTargets         []targetJSON `json:"targets"`\n\t}\n\n\tout := output{\n\t\tMatches:         matches,\n\t\tChainHash:       chainHash,\n\t\tExtraInBaseline: extraInBaseline,\n\t\tExtraInCurrent:  extraInCurrent,\n\t\tTargets:         targets,\n\t}\n\tif baseline.ChainHash != nil {\n\t\tchainMatch := *baseline.ChainHash == chainHash\n\t\tout.ChainMatch = &chainMatch\n\t\tif !chainMatch {\n\t\t\tmatches = false\n