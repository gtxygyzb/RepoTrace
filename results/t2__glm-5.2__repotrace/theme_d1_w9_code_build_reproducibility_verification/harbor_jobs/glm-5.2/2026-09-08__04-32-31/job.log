Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\np = Path("main.go")\ns = p.read_text()\n\ninsert = r\'\'\'\ntype lockfileTarget struct {\n        Fingerprint     string            `json:"fingerprint"`\n        OutputHash      string            `json:"output_hash"`\n        SourceHashes    map[string]string `json:"source_hashes"`\n        DepFingerprints map[string]string `json:"dep_fingerprints"`\n        EnvValues       map[string]string `json:"env_values"`\n        Compiler        string            `json:"compiler"`\n        Flags           []string          `json:"flags"`\n}\n\ntype lockfile struct {\n        Version int                          `json:"version"`\n        Created string                       `json:"created"`\n        Targets map[string]lockfileTarget    `json:"targets"`\n}\n\nfunc sha256File(path string) (string, error) {\n        data, err := os.ReadFile(path)\n        if err != nil {\n                return "", err\n        }\n        sum := sha256.Sum256(data)\n        return hex.EncodeToString(sum[:]), nil\n}\n\nfunc sourceHashesForTarget(t *Target, manifestDir string) (map[string]string, error) {\n        hashes := make(map[string]string, len(t.Sources))\n        for _, src := range t.Sources {\n                p := resolvePath(src, manifestDir)\n                h, err := sha256File(p)\n                if err != nil {\n                        return nil, fmt.Errorf("error: source file not found: %s (target \'%s\')", src, t.Name)\n                }\n                hashes[src] = h\n        }\n        return hashes, nil\n}\n\nfunc envValuesForTarget(t *Target) map[string]string {\n        vals := make(map[string]string, len(t.EnvCapture))\n        for _, e := range t.EnvCapture {\n                vals[e] = os.Getenv(e)\n        }\n        return vals\n}\n\nfunc depFingerprintsForTarget(results []buildResult, resultsByName map[string]buildResult, t *Target) map[string]string {\n        deps := make(map[string]string, len(t.Deps))\n        for _, d := range t.Deps {\n                if r, ok := resultsByName[d]; ok {\n                        deps[d] = r.Fingerprint\n                }\n        }\n        return deps\n}\n\nfunc readLockfile(path string) (*lockfile, error) {\n        data, err := os.ReadFile(path)\n        if err != nil {\n                if os.IsNotExist(err) {\n                        return nil, fmt.Errorf("error: lockfile not found: %s", path)\n                }\n                return nil, fmt.Errorf("error: lockfile not found: %s", path)\n        }\n        var lf lockfile\n        if err := json.Unmarshal(data, &lf); err != nil {\n                return nil, fmt.Errorf("error: invalid lockfile: %v", err)\n        }\n        if lf.Targets == nil {\n                lf.Targets = map[string]lockfileTarget{}\n        }\n        for name, tt := range lf.Targets {\n                if tt.SourceHashes == nil {\n                        tt.SourceHashes = map[string]string{}\n                        lf.Targets[name] = tt\n                }\n                if tt.DepFingerprints == nil {\n                        tt.DepFingerprints = map[string]string{}\n                        lf.Targets[name] = tt\n                }\n                if tt.EnvValues == nil {\n                        tt.EnvValues = map[string]string{}\n                        lf.Targets[name] = tt\n                }\n                if tt.Flags == nil {\n                        tt.Flags = []string{}\n                        lf.Targets[name] = tt\n                }\n        }\n        return &lf, nil\n}\n\nfunc sortedKeys(m map[string]string) []string {\n        res := make([]string, 0, len(m))\n        for k := range m {\n                res = append(res, k)\n        }\n        sort.Strings(res)\n        return res\n}\n\nfunc flagsEqual(a, b []string) bool {\n        if len(a) != len(b) {\n                return false\n        }\n        for i := range a {\n                if a[i] != b[i] {\n                        return false\n                }\n        }\n        return true\n}\n\nfunc mapEqual(a, b map[string]string) bool {\n        if len(a) != len(b) {\n                return false\n        }\n        for k, v := range a {\n                if bv, ok := b[k]; !ok || bv != v {\n                        return false\n                }\n        }\n        return true\n}\n\nfunc changeReasons(currentCompiler, lockCompiler string, currentFlags, lockFlags []string, currentSources, lockSources map[string]string, currentDeps, lockDeps map[string]string, currentEnv, lockEnv map[string]string) []string {\n        var reasons []string\n        if currentCompiler != lockCompiler {\n                reasons = append(reasons, "compiler_changed")\n        }\n        if !flagsEqual(currentFlags, lockFlags) {\n                reasons = append(reasons, "flags_changed")\n        }\n        if !mapEqual(currentSources, lockSources) {\n                reasons = append(reasons, "source_changed")\n        }\n        if !mapEqual(currentDeps, lockDeps) {\n                reasons = append(reasons, "dep_changed")\n        }\n        if !mapEqual(currentEnv, lockEnv) {\n                reasons = append(reasons, "env_changed")\n        }\n        sort.Strings(reasons)\n        return reasons\n}\n\nfunc transitiveDepsFromLock(lf *lockfile, target string) []string {\n        seen := make(map[string]bool)\n        var visit func(name string)\n        visit = func(name string) {\n                t, ok := lf.Targets[name]\n                if !ok {\n                        return\n                }\n                for dep := range t.DepFingerprints {\n                        if !seen[dep] {\n                                seen[dep] = true\n                                visit(dep)\n                        }\n                }\n        }\n        visit(target)\n        res := make([]string, 0, len(seen))\n        for k := range seen {\n                res = append(res, k)\n        }\n        sort.Strings(res)\n        return res\n}\n\nfunc transitiveDepsFromManifest(m *Manifest, target string) []string {\n        byName := make(map[string]*Target)\n        for _, t := range m.Targets {\n                byName[t.Name] = t\n        }\n        seen := make(map[string]bool)\n        var visit func(name string)\n        visit = func(name string) {\n                t, ok := byName[name]\n                if !ok {\n                        return\n                }\n                for _, d := range t.Deps {\n                        if !seen[d] {\n                                seen[d] = true\n                                visit(d)\n                        }\n                }\n        }\n        visit(target)\n        res := make([]string, 0, len(seen))\n        for k := range seen {\n                res = append(res, k)\n        }\n        sort.Strings(res)\n        return res\n}\n\nfunc impactedByForCurrent(lf *lockfile, resultsByName map[string]buildResult, t *Target) []string {\n        if fp, ok := lf.Targets[t.Name]; ok && fp.Fingerprint == resultsByName[t.Name].Fingerprint {\n                return []string{}\n        }\n        trans := transitiveDepsFromManifest(&Manifest{Targets: m.Targets}, t.Name)\n        var res []string\n        for _, dep := range trans {\n                lt, ok := lf.Targets[dep]\n                if !ok || lt.Fingerprint != resultsByName[dep].Fingerprint {\n                        res = append(res, dep)\n                }\n        }\n        sort.Strings(res)\n        return res\n}\n\nfunc impactedByForLockDiff(lfA, lfB *lockfile, target string) []string {\n        tb, ok := lfB.Targets[target]\n        if !ok {\n                return []string{}\n        }\n        trans := transitiveDepsFromLock(lfB, target)\n        var res []string\n        for _, dep := range trans {\n                ta, oka := lfA.Targets[dep]\n                tbDep, okb := lfB.Targets[dep]\n                if !oka || !okb || ta.Fingerprint != tbDep.Fingerprint {\n                        res = append(res, dep)\n        }\n        }\n        sort.Strings(res)\n        return res\n}\n\nfunc cmdLock(args []string) int {\n        if len(args) != 1 {\n                fmt.Fprintln(os.Stderr, "error: usage: buildvault lock <manifest_path>")\n                return 1\n        }\n\n        m, dir, err := loadManifest(args[0])\n        if err != nil {\n                fmt.Fprintln(os.Stderr, err)\n                return 1\n        }\n        if err := validateManifest(m, dir); err != nil {\n                fmt.Fprintln(os.Stderr, err)\n                return 1\n        }\n\n        results, err := runBuild(m, dir)\n        if err != nil {\n                if errors.Is(err, errBuildFailed) {\n                        return 1\n                }\n                fmt.Fprintln(os.Stderr, err)\n                return 1\n        }\n\n        resultsByName := make(map[string]buildResult, len(results))\n        for _, r := range results {\n                resultsByName[r.Target.Name] = r\n        }\n\n        targets := make(map[string]lockfileTarget, len(results))\n        for _, r := range results {\n                t := r.Target\n                srcHashes, err := sourceHashesForTarget(t, dir)\n                if err != nil {\n                        fmt.Fprintln(os.Stderr, err)\n                        return 1\n                }\n                targets[t.Name] = lockfileTarget{\n                        Fingerprint:     r.Fingerprint,\n                        OutputHash:      r.OutputHash,\n                        SourceHashes:    srcHashes,\n                        DepFingerprints: depFingerprintsForTarget(results, resultsByName, t),\n                        EnvValues:       envValuesForTarget(t),\n                        Compiler:        t.Compiler,\n                        Flags:           t.Flags,\n                }\n        }\n\n        lf := lockfile{\n                Version: 1,\n                Created: time.Now().UTC().Format(time.RFC3339),\n                Targets: targets,\n        }\n        printJSON(lf)\n        return 0\n}\n\nfunc cmdCheck(args []string) int {\n        if len(args) != 3 || args[1] != "--lockfile" {\n                fmt.Fprintln(os.Stderr, "error: usage: buildvault check <manifest_path> --lockfile <lockfile_path>")\n                return 1\n        }\n\n        manifestPath := args[0]\n        lockfilePath := args[2]\n\n        lf, err := readLockfile(lockfilePath)\n        if err != nil {\n                fmt.Fprintln(os.Stderr, err)\n                return 1\n        }\n\n        m, dir, err := loadManifest(manifestPath)\n        if err != nil {\n                fmt.Fprintln(os.Stderr, err)\n                return 1\n        }\n        if err := validateManifest(m, dir); err != nil {\n                fmt.Fprintln(os.Stderr, err)\n                return 1\n        }\n\n        results, err := runBuild(m, dir)\n        if err != nil {\n                if errors.Is(err, errBuildFailed) {\n                        return 1\n                }\n                fmt.Fprintln(os.Stderr, err)\n                return 1\n        }\n\n        resultsByName := make(map[string]buildResult, len(results))\n        for _, r := range results {\n                resultsByName[r.Target.Name] = r\n        }\n\n        type targetResult struct {\n                Name              string   `json:"name"`\n                FingerprintMatch  bool     `json:"fingerprint_match"`\n                OutputMatch       bool     `json:"output_match"`\n                ChangeReasons     []string `json:"change_reasons"`\n                ImpactedBy        []string `json:"impacted_by"`\n        }\n\n        allMatch := true\n        targets := make([]targetResult, 0, len(results))\n        for _, r := range results {\n                t := r.Target\n                lt, inLock := lf.Targets[t.Name]\n\n                fpMatch := inLock && r.Fingerprint == lt.Fingerprint\n                outMatch := inLock && r.OutputHash == lt.OutputHash\n                if !fpMatch || !outMatch {\n                        allMatch = false\n                }\n\n                var reasons []string\n                var impacted []string\n                if !inLock {\n                        reasons = []string{"new_target"}\n                        for _, dep := range transitiveDepsFromManifest(m, t.Name) {\n                                if _, depInLock := lf.Targets[dep]; !depInLock {\n                                        impacted = append(impacted, dep)\n                                }\n                        }\n                        sort.Strings(impacted)\n                } else {\n                        srcHashes, err := sourceHashesForTarget(t, dir)\n                        if err != nil {\n                                fmt.Fprintln(os.Stderr, err)\n                                return 1\n                        }\n                        currentDeps := depFingerprintsForTarget(results, resultsByName, t)\n                        currentEnv := envValuesForTarget(t)\n                        reasons = changeReasons(t.Compiler, lt.Compiler, t.Flags, lt.Flags, srcHashes, lt.SourceHashes, currentDeps, lt.DepFingerprints, currentEnv, lt.EnvValues)\n                        if fpMatch {\n                                reasons = []string{}\n                                impacted = []string{}\n                        } else {\n                                for _, dep := range transitiveDepsFromManifest(m, t.Name) {\n                                        rdep, ok := resultsByName[dep]\n                                        if !ok {\n                                                continue\n                                        }\n                                        ltdep, depInLock := lf.Targets[dep]\n                                        if !depInLock || ltdep.Fingerprint != rdep.Fingerprint {\n                                                impacted = append(impacted, dep)\n                                        }\n                                }\n                                sort.Strings(impacted)\n                        }\n                }\n\n                targets = append(targets, targetResult{\n                        Name:             t.Name,\n                        FingerprintMatch: fpMatch,\n                        OutputMatch:      outMatch,\n                        ChangeReasons:    reasons,\n                        ImpactedBy:       impacted,\n                })\n        }\n\n        printJSON(struct {\n                AllMatch bool           `json:"all_match"`\n                Targets  []targetResult `json:"targets"`\n        }{\n                AllMatch: allMatch,\n                Targets:  targets,\n        })\n        return 0\n}\n\nfunc cmdLockDiff(args []string) int {\n        if len(args) != 2 {\n                fmt.Fprintln(os.Stderr, "error: usage: buildvault lock-diff <lockfile_a_path> <lockfile_b_path>")\n                return 1\n        }\n\n        lfA, err := readLockfile(args[0])\n        if err != nil {\n                fmt.Fprintln(os.Stderr, err)\n                return 1\n        }\n        lfB, err := readLockfile(args[1])\n        if err != nil {\n                fmt.Fprintln(os.Stderr, err)\n                return 1\n        }\n\n        added := []string{}\n        removed := []string{}\n        var changed []struct {\n                Name        string   `json:"name"`\n                Reasons     []string `json:"reasons"`\n                ImpactedBy []string `json:"impacted_by"`\n        }\n        unchanged := []string{}\n\n        for name, ta := range lfA.Targets {\n                if _, ok := lfB.Targets[name]; !ok {\n                        removed = append(removed, name)\n                }\n        }\n        for name, tb := range lfB.Targets {\n                ta, ok := lfA.Targets[name]\n                if !ok {\n                        added = append(added, name)\n                        continue\n                }\n                if ta.Fingerprint == tb.Fingerprint {\n                        unchanged = append(unchanged, name)\n                        continue\n                }\n                reasons := changeReasons(tb.Compiler, ta.Compiler, tb.Flags, ta.Flags, tb.SourceHashes, ta.SourceHashes, tb.DepFingerprints, ta.DepFingerprints, tb.EnvValues, ta.EnvValues)\n                impacted := impactedByForLockDiff(lfA, lfB, name)\n                changed = append(changed, struct {\n                        Name        string   `json:"name"`\n                        Reasons     []string `json:"reasons"`\n                        ImpactedBy []string `json:"impacted_by"`\n                }{Name: name, Reasons: reasons, ImpactedBy: impacted})\n        }\n\n        sort.Strings(added)\n        sort.Strings(removed)\n        sort.Strings(unchanged)\n        sort.Slice(changed, func(i, j int) bool { return changed[i].Name < changed[j].Name })\n\n        printJSON(struct {\n                Added     []string `json:"added"`\n                Removed   []string `json:"removed"`\n                Changed   []struct {\n                        Name        string   `json:"name"`\n                        Reasons     []string `json:"reasons"`\n                        ImpactedBy []string `json:"impacted_by"`\n                } `json:"changed"`\n                Unchanged []string `json:"unchanged"`\n        }{\n                Added:     added,\n                Removed:   removed,\n                Changed:   changed,\n                Unchanged: unchanged,\n        })\n        return 0\n}\n\'\'\'\n\nmarker = \'func main() {\'\nidx = s.index(marker)\ns = s[:idx] + insert + \'\\n\' + s[idx:]\n\ns = s.replace(\'error: usage: buildvault <build|verify|inspect|audit|gc> ...\', \'error: usage: buildvault <build|verify|inspect|audit|gc|lock|check|lock-diff> ...\')\ns = s.replace(\'\'\'\\tcase "gc":\n\\t\\t\\tos.Exit(cmdGC(os.Args[2:]))\'\'\', \'\'\'\\tcase "gc":\n\\t