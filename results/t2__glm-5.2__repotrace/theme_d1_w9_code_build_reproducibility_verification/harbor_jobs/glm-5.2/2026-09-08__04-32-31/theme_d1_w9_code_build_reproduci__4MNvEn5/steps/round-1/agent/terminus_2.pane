   236	func decodeHash(s string) ([]byte, error) {
   237		b, err := hex.DecodeString(s)
   238		if err != nil {
   239			return nil, fmt.Errorf("invalid output hash: %v", err)
   240		}
   241		if len(b) != 32 {
   242			return nil, fmt.Errorf("invalid output hash length")
   243		}
   244		return b, nil
   245	}
   246	
   247	func computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {
   248		h := sha256.New()
   249	
   250		srcs := append([]string{}, t.Sources...)
   251		sort.Strings(srcs)
   252		for _, src := range srcs {
   253			p := resolvePath(src, manifestDir)
   254			data, err := os.ReadFile(p)
   255			if err != nil {
   256				return "", fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
   257			}
   258			h.Write(data)
   259		}
   260	
   261		h.Write([]byte(t.Compiler))
   262	
   263		flags := append([]string{}, t.Flags...)
   264		sort.Strings(flags)
   265		for _, f := range flags {
   266			h.Write([]byte(f))
   267			h.Write([]byte("\n"))
   268		}
   269	
   270		envs := append([]string{}, t.EnvCapture...)
   271		sort.Strings(envs)
   272		for _, e := range envs {
   273			h.Write([]byte(e + "=" + os.Getenv(e) + "\n"))
   274		}
   275	
   276		deps := append([]string{}, t.Deps...)
   277		sort.Strings(deps)
   278		for _, d := range deps {
   279			hash, ok := depHashes[d]
   280			if !ok {
   281				return "", fmt.Errorf("error: missing output hash for dependency '%s' (target '%s')", d, t.Name)
   282			}
   283			if len(hash) != 32 {
   284				return "", fmt.Errorf("error: invalid output hash for dependency '%s' (target '%s')", d, t.Name)
   285			}
   286			h.Write(hash)
   287		}
   288	
   289		return hex.EncodeToString(h.Sum(nil)), nil
   290	}
   291	
   292	func copyFile(src, dst string) error {
   293		in, err := os.Open(src)
   294		if err != nil {
   295			return err
   296		}
   297		defer in.Close()
   298	
   299		if err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {
   300			return err
   301		}
   302	
   303		out, err := os.Create(dst)
   304		if err != nil {
   305			return err
   306		}
   307		if _, err := io.Copy(out, in); err != nil {
   308			out.Close()
   309			return err
   310		}
   311		return out.Close()
   312	}
   313	
   314	func storeArtifact(t *Target, storeRoot, fingerprint, outputHashHex, artifactPath string) error {
   315		dir := filepath.Join(storeRoot, "objects", fingerprint[:2], fingerprint)
   316		if err := os.MkdirAll(dir, 0o755); err != nil {
   317			return err
   318		}
   319	
   320		artifactDst := filepath.Join(dir, "artifact")
   321		if err := copyFile(artifactPath, artifactDst); err != nil {
   322			return err
   323		}
   324	
   325		meta := StoredMetadata{
   326			Name:           t.Name,
   327			Fingerprint:    fingerprint,
   328			OutputHash:     outputHashHex,
   329			Compiler:       t.Compiler,
   330			Flags:          t.Flags,
   331			Sources:        t.Sources,
   332			BuildTimestamp: time.Now().UTC().Format(time.RFC3339),
   333		}
   334		data, err := jsonBytes(meta)
   335		if err != nil {
   336			return err
   337		}
   338		return os.WriteFile(filepath.Join(dir, "metadata.json"), data, 0o644)
   339	}
   340	
   341	func readMetadata(path string) (*StoredMetadata, error) {
   342		data, err := os.ReadFile(path)
   343		if err != nil {
   344			return nil, err
   345		}
   346		var meta StoredMetadata
   347		if err := json.Unmarshal(data, &meta); err != nil {
   348			return nil, err
   349		}
   350		if _, err := decodeHash(meta.OutputHash); err != nil {
   351			return nil, err
   352		}
   353		return &meta, nil
   354	}
   355	
   356	func compileTargetInDir(t *Target, sourceDir string) (scratchDir, outputPath, outputHash string, err error) {
   357		scratchDir, err = os.MkdirTemp("", "buildvault-build-*")
   358		if err != nil {
   359			return "", "", "", err
   360		}
   361	
   362		outputPath = filepath.Join(scratchDir, "out", t.Output)
   363		if err := os.MkdirAll(filepath.Dir(outputPath), 0o755); err != nil {
   364			return scratchDir, "", "", err
   365		}
   366	
   367		args := make([]string, 0, len(t.Flags)+len(t.Sources)+2)
   368		args = append(args, t.Flags...)
   369		args = append(args, "-o", outputPath)
   370		for _, src := range t.Sources {
   371			args = append(args, resolvePath(src, sourceDir))
   372		}
   373	
   374		cmd := exec.Command(t.Compiler, args...)
   375		cmd.Dir = sourceDir
   376		out, err := cmd.CombinedOutput()
   377		if err != nil {
   378			detail := strings.TrimSpace(string(out))
   379			if detail == "" {
   380				detail = err.Error()
   381			}
   382			return scratchDir, "", "", errors.New(detail)
   383		}
   384	
   385		data, err := os.ReadFile(outputPath)
   386		if err != nil {
   387			return scratchDir, "", "", fmt.Errorf("output artifact not found: %v", err)
   388		}
   389		sum := sha256.Sum256(data)
   390		outputHash = hex.EncodeToString(sum[:])
   391		return scratchDir, outputPath, outputHash, nil
   392	}
   393	
   394	func buildAndStoreTarget(t *Target, sourceDir, storeRoot, fingerprint string) (string, error) {
   395		scratch, outputPath, outHash, err := compileTargetInDir(t, sourceDir)
   396		if scratch != "" {
   397			defer os.RemoveAll(scratch)
   398		}
   399		if err != nil {
   400			return "", err
   401		}
   402		if err := storeArtifact(t, storeRoot, fingerprint, outHash, outputPath); err != nil {
   403			return "", err
   404		}
   405		return outHash, nil
   406	}
   407	
   408	func compileFresh(t *Target, sourceDir string) (string, error) {
   409		scratch, _, outHash, err := compileTargetInDir(t, sourceDir)
   410		if scratch != "" {
   411			defer os.RemoveAll(scratch)
   412		}
   413		return outHash, err
   414	}
   415	
   416	func runBuild(m *Manifest, manifestDir string) ([]buildResult, error) {
   417		order, err := topologicalOrder(m)
   418		if err != nil {
   419			return nil, err
   420		}
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '420,700p'
[?2004l   420		}
   421	
   422		depHashes := make(map[string][]byte)
   423		results := make([]buildResult, 0, len(order))
   424	
   425		for _, t := range order {
   426			fp, err := computeFingerprint(t, manifestDir, depHashes)
   427			if err != nil {
   428				return nil, err
   429			}
   430	
   431			metaPath := filepath.Join(m.StoreRoot, "objects", fp[:2], fp, "metadata.json")
   432			if _, err := os.Stat(metaPath); err == nil {
   433				meta, err := readMetadata(metaPath)
   434				if err != nil {
   435					return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
   436				}
   437				hash, err := decodeHash(meta.OutputHash)
   438				if err != nil {
   439					return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
   440				}
   441				fmt.Fprintf(os.Stderr, "[cache hit] %s\n", t.Name)
   442				depHashes[t.Name] = hash
   443				results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: meta.OutputHash, Cached: true})
   444				continue
   445			}
   446	
   447			fmt.Fprintf(os.Stderr, "[building] %s\n", t.Name)
   448			outHash, err := buildAndStoreTarget(t, manifestDir, m.StoreRoot, fp)
   449			if err != nil {
   450				fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
   451				return nil, errBuildFailed
   452			}
   453			fmt.Fprintf(os.Stderr, "[stored] %s %s\n", t.Name, fp)
   454	
   455			hash, err := decodeHash(outHash)
   456			if err != nil {
   457				return nil, err
   458			}
   459			depHashes[t.Name] = hash
   460			results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: outHash, Cached: false})
   461		}
   462	
   463		return results, nil
   464	}
   465	
   466	func copySources(m *Manifest, manifestDir string) (string, error) {
   467		tempDir, err := os.MkdirTemp("", "buildvault-verify-*")
   468		if err != nil {
   469			return "", err
   470		}
   471	
   472		for _, t := range m.Targets {
   473			for _, src := range t.Sources {
   474				srcAbs := resolvePath(src, manifestDir)
   475				dst := filepath.Join(tempDir, filepath.Clean(src))
   476				if err := copyFile(srcAbs, dst); err != nil {
   477					os.RemoveAll(tempDir)
   478					return "", err
   479				}
   480			}
   481		}
   482	
   483		return tempDir, nil
   484	}
   485	
   486	func dirSize(path string) int64 {
   487		var size int64
   488		filepath.Walk(path, func(_ string, info os.FileInfo, err error) error {
   489			if err != nil {
   490				return nil
   491			}
   492			if !info.IsDir() {
   493				size += info.Size()
   494			}
   495			return nil
   496		})
   497		return size
   498	}
   499	
   500	func gcStore(storeRoot string, referenced map[string]bool) (int, int, int64) {
   501		objectsDir := filepath.Join(storeRoot, "objects")
   502		entries, err := os.ReadDir(objectsDir)
   503		if err != nil {
   504			return 0, 0, 0
   505		}
   506	
   507		removed := 0
   508		retained := 0
   509		var freed int64
   510	
   511		for _, prefixEntry := range entries {
   512			if !prefixEntry.IsDir() {
   513				continue
   514			}
   515			prefixPath := filepath.Join(objectsDir, prefixEntry.Name())
   516			fps, err := os.ReadDir(prefixPath)
   517			if err != nil {
   518				continue
   519			}
   520			for _, fpEntry := range fps {
   521				if !fpEntry.IsDir() {
   522					continue
   523				}
   524				fp := fpEntry.Name()
   525				fpDir := filepath.Join(prefixPath, fp)
   526				if referenced[fp] {
   527					retained++
   528					continue
   529				}
   530				size := dirSize(fpDir)
   531				if err := os.RemoveAll(fpDir); err != nil {
   532					continue
   533				}
   534				removed++
   535				freed += size
   536			}
   537		}
   538	
   539		return removed, retained, freed
   540	}
   541	
   542	func jsonBytes(v interface{}) ([]byte, error) {
   543		var buf bytes.Buffer
   544		enc := json.NewEncoder(&buf)
   545		enc.SetEscapeHTML(false)
   546		if err := enc.Encode(v); err != nil {
   547			return nil, err
   548		}
   549		return bytes.TrimRight(buf.Bytes(), "\n"), nil
   550	}
   551	
   552	func printJSON(v interface{}) {
   553		data, err := jsonBytes(v)
   554		if err != nil {
   555			fmt.Fprintln(os.Stderr, "error:", err)
   556			os.Exit(1)
   557		}
   558		fmt.Println(string(data))
   559	}
   560	
   561	func cmdBuild(args []string) int {
   562		if len(args) != 1 {
   563			fmt.Fprintln(os.Stderr, "error: usage: buildvault build <manifest_path>")
   564			return 1
   565		}
   566	
   567		m, dir, err := loadManifest(args[0])
   568		if err != nil {
   569			fmt.Fprintln(os.Stderr, err)
   570			return 1
   571		}
   572		if err := validateManifest(m, dir); err != nil {
   573			fmt.Fprintln(os.Stderr, err)
   574			return 1
   575		}
   576	
   577		results, err := runBuild(m, dir)
   578		if err != nil {
   579			if errors.Is(err, errBuildFailed) {
   580				return 1
   581			}
   582			fmt.Fprintln(os.Stderr, err)
   583			return 1
   584		}
   585	
