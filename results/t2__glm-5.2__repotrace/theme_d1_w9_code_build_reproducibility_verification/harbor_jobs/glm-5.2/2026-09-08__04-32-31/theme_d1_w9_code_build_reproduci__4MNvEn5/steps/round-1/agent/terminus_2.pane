   412		}
   413		return outHash, err
   414	}
   415	
   416	func runBuild(m *Manifest, manifestDir string) ([]buildResult, error) {
   417		order, err := topologicalOrder(m)
   418		if err != nil {
   419			return nil, err
   420		}
   421	
   422		depHashes := make(map[string][]byte)
   423		results := make([]buildResult, 0, len(order))
   424	
   425		for _, t := range order {
   426			fp, err := computeFingerprint(t, manifestDir, depHashes)
   427			if err != nil {
   428				return nil, err
   429			}
   430	
   431			metaPath := filepath.Join(m.StoreRoot, "objects", fp[:2], fp, "metadata.json")
   432			if _, err := os.Stat(metaPath); err == nil {
   433				meta, err := readMetadata(metaPath)
   434				if err != nil {
   435					return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
   436				}
   437				hash, err := decodeHash(meta.OutputHash)
   438				if err != nil {
   439					return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
   440				}
   441				fmt.Fprintf(os.Stderr, "[cache hit] %s\n", t.Name)
   442				depHashes[t.Name] = hash
   443				results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: meta.OutputHash, Cached: true})
   444				continue
   445			}
   446	
   447			fmt.Fprintf(os.Stderr, "[building] %s\n", t.Name)
   448			outHash, err := buildAndStoreTarget(t, manifestDir, m.StoreRoot, fp)
   449			if err != nil {
   450				fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
   451				return nil, errBuildFailed
   452			}
   453			fmt.Fprintf(os.Stderr, "[stored] %s %s\n", t.Name, fp)
   454	
   455			hash, err := decodeHash(outHash)
   456			if err != nil {
   457				return nil, err
   458			}
   459			depHashes[t.Name] = hash
   460			results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: outHash, Cached: false})
   461		}
   462	
   463		return results, nil
   464	}
   465	
   466	func copySources(m *Manifest, manifestDir string) (string, error) {
   467		tempDir, err := os.MkdirTemp("", "buildvault-verify-*")
   468		if err != nil {
   469			return "", err
   470		}
   471	
   472		for _, t := range m.Targets {
   473			for _, src := range t.Sources {
   474				srcAbs := resolvePath(src, manifestDir)
   475				dst := filepath.Join(tempDir, filepath.Clean(src))
   476				if err := copyFile(srcAbs, dst); err != nil {
   477					os.RemoveAll(tempDir)
   478					return "", err
   479				}
   480			}
   481		}
   482	
   483		return tempDir, nil
   484	}
   485	
   486	func dirSize(path string) int64 {
   487		var size int64
   488		filepath.Walk(path, func(_ string, info os.FileInfo, err error) error {
   489			if err != nil {
   490				return nil
   491			}
   492			if !info.IsDir() {
   493				size += info.Size()
   494			}
   495			return nil
   496		})
   497		return size
   498	}
   499	
   500	func gcStore(storeRoot string, referenced map[string]bool) (int, int, int64) {
   501		objectsDir := filepath.Join(storeRoot, "objects")
   502		entries, err := os.ReadDir(objectsDir)
   503		if err != nil {
   504			return 0, 0, 0
   505		}
   506	
   507		removed := 0
   508		retained := 0
   509		var freed int64
   510	
   511		for _, prefixEntry := range entries {
   512			if !prefixEntry.IsDir() {
   513				continue
   514			}
   515			prefixPath := filepath.Join(objectsDir, prefixEntry.Name())
   516			fps, err := os.ReadDir(prefixPath)
   517			if err != nil {
   518				continue
   519			}
   520			for _, fpEntry := range fps {
   521				if !fpEntry.IsDir() {
   522					continue
   523				}
   524				fp := fpEntry.Name()
   525				fpDir := filepath.Join(prefixPath, fp)
   526				if referenced[fp] {
   527					retained++
   528					continue
   529				}
   530				size := dirSize(fpDir)
   531				if err := os.RemoveAll(fpDir); err != nil {
   532					continue
   533				}
   534				removed++
   535				freed += size
   536			}
   537		}
   538	
   539		return removed, retained, freed
   540	}
   541	
   542	func jsonBytes(v interface{}) ([]byte, error) {
   543		var buf bytes.Buffer
   544		enc := json.NewEncoder(&buf)
   545		enc.SetEscapeHTML(false)
   546		if err := enc.Encode(v); err != nil {
   547			return nil, err
   548		}
   549		return bytes.TrimRight(buf.Bytes(), "\n"), nil
   550	}
   551	
   552	func printJSON(v interface{}) {
   553		data, err := jsonBytes(v)
   554		if err != nil {
   555			fmt.Fprintln(os.Stderr, "error:", err)
   556			os.Exit(1)
   557		}
   558		fmt.Println(string(data))
   559	}
