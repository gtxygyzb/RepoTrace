  1042	func flagsEqual(a, b []string) bool {
  1043		if len(a) != len(b) {
  1044			return false
  1045		}
  1046		for i := range a {
  1047			if a[i] != b[i] {
  1048				return false
  1049			}
  1050		}
  1051		return true
  1052	}
  1053	
  1054	func mapEqual(a, b map[string]string) bool {
  1055		if len(a) != len(b) {
  1056			return false
  1057		}
  1058		for k, v := range a {
  1059			if bv, ok := b[k]; !ok || bv != v {
  1060				return false
  1061			}
  1062		}
  1063		return true
  1064	}
