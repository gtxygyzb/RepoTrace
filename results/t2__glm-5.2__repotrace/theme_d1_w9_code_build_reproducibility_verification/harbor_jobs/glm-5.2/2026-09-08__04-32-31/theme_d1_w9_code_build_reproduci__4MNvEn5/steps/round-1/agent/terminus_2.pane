  1033	func sortedKeys(m map[string]string) []string {
  1034		res := make([]string, 0, len(m))
  1035		for k := range m {
  1036			res = append(res, k)
  1037		}
  1038		sort.Strings(res)
  1039		return res
  1040	}
  1041	
  1042	func flagsEqual(a, b []string) bool {
  1043		if len(a) != len(b) {
  1044			return false
  1045		}
  1046		for i := range a {
  1047			if a[i] != b[i] {
  1048				return false
  1049			}
  1050		}
  1051		return true
  1052	}
  1053	
  1054	func mapEqual(a, b map[string]string) bool {
  1055		if len(a) != len(b) {
  1056			return false
  1057		}
  1058		for k, v := range a {
  1059			if bv, ok := b[k]; !ok || bv != v {
  1060				return false
  1061			}
  1062		}
  1063		return true
  1064	}
  1065	
  1066	func changeReasons(currentCompiler, lockCompiler string, currentFlags, lockFlags []string, currentSources, lockSources map[string]string, currentDeps, lockDeps map[string]string, currentEnv, lockEnv map[string]string) []string {
  1067		reasons := []string{}
  1068		if currentCompiler != lockCompiler {
  1069			reasons = append(reasons, "compiler_changed")
  1070		}
  1071		if !flagsEqual(currentFlags, lockFlags) {
  1072			reasons = append(reasons, "flags_changed")
  1073		}
  1074		if !mapEqual(currentSources, lockSources) {
  1075			reasons = append(reasons, "source_changed")
  1076		}
  1077		if !mapEqual(currentDeps, lockDeps) {
  1078			reasons = append(reasons, "dep_changed")
  1079		}
  1080		if !mapEqual(currentEnv, lockEnv) {
  1081			reasons = append(reasons, "env_changed")
  1082		}
  1083		sort.Strings(reasons)
  1084		return reasons
  1085	}
  1086	
  1087	func transitiveDepsFromLock(lf *lockfile, target string) []string {
  1088		seen := make(map[string]bool)
  1089		var visit func(name string)
  1090		visit = func(name string) {
  1091			t, ok := lf.Targets[name]
  1092			if !ok {
  1093				return
  1094			}
  1095			for dep := range t.DepFingerprints {
  1096				if !seen[dep] {
  1097					seen[dep] = true
  1098					visit(dep)
  1099				}
  1100			}
  1101		}
  1102		visit(target)
  1103		res := make([]string, 0, len(seen))
  1104		for k := range seen {
  1105			res = append(res, k)
  1106		}
  1107		sort.Strings(res)
  1108		return res
  1109	}
  1110	
  1111	func transitiveDepsFromManifest(m *Manifest, target string) []string {
  1112		byName := make(map[string]*Target)
  1113		for _, t := range m.Targets {
  1114			byName[t.Name] = t
  1115		}
  1116		seen := make(map[string]bool)
  1117		var visit func(name string)
  1118		visit = func(name string) {
  1119			t, ok := byName[name]
  1120			if !ok {
  1121				return
  1122			}
  1123			for _, d := range t.Deps {
  1124				if !seen[d] {
  1125					seen[d] = true
  1126					visit(d)
  1127				}
  1128			}
  1129		}
  1130		visit(target)
  1131		res := make([]string, 0, len(seen))
  1132		for k := range seen {
  1133			res = append(res, k)
  1134		}
  1135		sort.Strings(res)
  1136		return res
  1137	}
  1138	
  1139	func impactedByForLockDiff(lfA, lfB *lockfile, target string) []string {
  1140		trans := transitiveDepsFromLock(lfB, target)
  1141		res := []string{}
  1142		for _, dep := range trans {
  1143			ta, oka := lfA.Targets[dep]
  1144			tbDep, okb := lfB.Targets[dep]
  1145			if !oka || !okb || ta.Fingerprint != tbDep.Fingerprint {
  1146				res = append(res, dep)
  1147			}
  1148		}
  1149		sort.Strings(res)
  1150		return res
  1151	}
