   356	func compileTargetInDir(t *Target, sourceDir string) (scratchDir, outputPath, outputHash string, err error) {
   357		scratchDir, err = os.MkdirTemp("", "buildvault-build-*")
   358		if err != nil {
   359			return "", "", "", err
   360		}
   361	
   362		outputPath = filepath.Join(scratchDir, "out", t.Output)
   363		if err := os.MkdirAll(filepath.Dir(outputPath), 0o755); err != nil {
   364			return scratchDir, "", "", err
   365		}
   366	
   367		args := make([]string, 0, len(t.Flags)+len(t.Sources)+2)
   368		args = append(args, t.Flags...)
   369		args = append(args, "-o", outputPath)
   370		for _, src := range t.Sources {
   371			args = append(args, resolvePath(src, sourceDir))
   372		}
   373	
   374		cmd := exec.Command(t.Compiler, args...)
   375		cmd.Dir = sourceDir
   376		out, err := cmd.CombinedOutput()
   377		if err != nil {
   378			detail := strings.TrimSpace(string(out))
   379			if detail == "" {
   380				detail = err.Error()
   381			}
   382			return scratchDir, "", "", errors.New(detail)
   383		}
   384	
   385		data, err := os.ReadFile(outputPath)
   386		if err != nil {
   387			return scratchDir, "", "", fmt.Errorf("output artifact not found: %v", err)
   388		}
   389		sum := sha256.Sum256(data)
   390		outputHash = hex.EncodeToString(sum[:])
   391		return scratchDir, outputPath, outputHash, nil
   392	}
   393	
   394	func buildAndStoreTarget(t *Target, sourceDir, storeRoot, fingerprint string) (string, error) {
   395		scratch, outputPath, outHash, err := compileTargetInDir(t, sourceDir)
   396		if scratch != "" {
   397			defer os.RemoveAll(scratch)
   398		}
   399		if err != nil {
   400			return "", err
   401		}
   402		if err := storeArtifact(t, storeRoot, fingerprint, outHash, outputPath); err != nil {
   403			return "", err
   404		}
   405		return outHash, nil
   406	}
   407	
   408	func compileFresh(t *Target, sourceDir string) (string, error) {
   409		scratch, _, outHash, err := compileTargetInDir(t, sourceDir)
   410		if scratch != "" {
   411			defer os.RemoveAll(scratch)
   412		}
   413		return outHash, err
   414	}
   415	
   416	func runBuild(m *Manifest, manifestDir string) ([]buildResult, error) {
   417		order, err := topologicalOrder(m)
   418		if err != nil {
   419			return nil, err
   420		}
   421	
   422		depHashes := make(map[string][]byte)
   423		results := make([]buildResult, 0, len(order))
   424	
   425		for _, t := range order {
   426			fp, err := computeFingerprint(t, manifestDir, depHashes)
   427			if err != nil {
   428				return nil, err
   429			}
   430	
   431			metaPath := filepath.Join(m.StoreRoot, "objects", fp[:2], fp, "metadata.json")
   432			if _, err := os.Stat(metaPath); err == nil {
   433				meta, err := readMetadata(metaPath)
   434				if err != nil {
   435					return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
   436				}
   437				hash, err := decodeHash(meta.OutputHash)
   438				if err != nil {
   439					return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
   440				}
   441				fmt.Fprintf(os.Stderr, "[cache hit] %s\n", t.Name)
   442				depHashes[t.Name] = hash
   443				results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: meta.OutputHash, Cached: true})
   444				continue
   445			}
   446	
   447			fmt.Fprintf(os.Stderr, "[building] %s\n", t.Name)
   448			outHash, err := buildAndStoreTarget(t, manifestDir, m.StoreRoot, fp)
   449			if err != nil {
   450				fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
   451				return nil, errBuildFailed
   452			}
   453			fmt.Fprintf(os.Stderr, "[stored] %s %s\n", t.Name, fp)
   454	
   455			hash, err := decodeHash(outHash)
   456			if err != nil {
   457				return nil, err
   458			}
   459			depHashes[t.Name] = hash
   460			results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: outHash, Cached: false})
   461		}
   462	
   463		return results, nil
   464	}
