   341	func readMetadata(path string) (*StoredMetadata, error) {
   342		data, err := os.ReadFile(path)
   343		if err != nil {
   344			return nil, err
   345		}
   346		var meta StoredMetadata
   347		if err := json.Unmarshal(data, &meta); err != nil {
   348			return nil, err
   349		}
