  1399	func main() {
  1400		if len(os.Args) < 2 {
  1401			fmt.Fprintln(os.Stderr, "error: usage: buildvault <build|verify|inspect|audit|gc|lock|check|lock-diff> ...")
  1402			os.Exit(1)
  1403		}
  1404	
  1405		switch os.Args[1] {
  1406		case "build":
  1407			os.Exit(cmdBuild(os.Args[2:]))
  1408		case "verify":
  1409			os.Exit(cmdVerify(os.Args[2:]))
  1410		case "inspect":
  1411			os.Exit(cmdInspect(os.Args[2:]))
  1412		case "audit":
  1413			os.Exit(cmdAudit(os.Args[2:]))
  1414		case "gc":
  1415			os.Exit(cmdGC(os.Args[2:]))
  1416		case "lock":
  1417			os.Exit(cmdLock(os.Args[2:]))
  1418		case "check":
  1419			os.Exit(cmdCheck(os.Args[2:]))
  1420		case "lock-diff":
  1421			os.Exit(cmdLockDiff(os.Args[2:]))
  1422		default:
  1423			fmt.Fprintf(os.Stderr, "error: unknown subcommand: %s\n", os.Args[1])
  1424			os.Exit(1)
  1425		}
  1426	}
