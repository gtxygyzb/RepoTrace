   207	func extractProfile(args []string) ([]string, string, int) {
   208		profile := ""
   209		remaining := make([]string, 0, len(args))
   210		i := 0
   211		for i < len(args) {
   212			if args[i] == "--profile" {
   213				if i+1 >= len(args) {
   214					fmt.Fprintln(os.Stderr, "error: --profile requires a profile name")
   215					return nil, "", 1
   216				}
   217				profile = args[i+1]
   218				i += 2
   219			} else if strings.HasPrefix(args[i], "--profile=") {
   220				profile = args[i][len("--profile="):]
   221				i++
   222			} else {
   223				remaining = append(remaining, args[i])
   224				i++
   225			}
   226		}
   227		return remaining, profile, 0
   228	}
   229	
   230	func applyProfile(m *Manifest, profile string) error {
   231		if profile == "" {
   232			return nil
   233		}
   234		p, ok := m.Profiles[profile]
   235		if !ok {
   236			return fmt.Errorf("error: unknown profile: '%s'", profile)
   237		}
   238		for _, t := range m.Targets {
   239			if p.Compiler != nil {
   240				t.Compiler = *p.Compiler
   241			}
   242			if len(p.FlagsRemove) > 0 {
   243				removeSet := make(map[string]bool, len(p.FlagsRemove))
   244				for _, f := range p.FlagsRemove {
   245					removeSet[f] = true
   246				}
   247				filtered := make([]string, 0, len(t.Flags))
   248				for _, f := range t.Flags {
   249					if !removeSet[f] {
   250						filtered = append(filtered, f)
   251					}
   252				}
   253				t.Flags = filtered
   254			}
   255			t.Flags = append(t.Flags, p.FlagsAppend...)
   256			if len(p.EnvCaptureAppend) > 0 {
   257				seen := make(map[string]bool, len(t.EnvCapture))
   258				for _, e := range t.EnvCapture {
   259					seen[e] = true
   260				}
   261				for _, e := range p.EnvCaptureAppend {
   262					if !seen[e] {
   263						t.EnvCapture = append(t.EnvCapture, e)
   264						seen[e] = true
   265					}
   266				}
   267			}
   268			normalizeTarget(t)
   269		}
   270		return nil
   271	}
   272	
   273	func validateManifest(m *Manifest, manifestDir string) error {
   274		names := make(map[string]bool)
   275		for _, t := range m.Targets {
   276			if names[t.Name] {
   277				return fmt.Errorf("error: duplicate target name: '%s'", t.Name)
   278			}
   279			names[t.Name] = true
   280		}
   281	
   282		byName := make(map[string]*Target)
   283		for _, t := range m.Targets {
   284			byName[t.Name] = t
   285		}
   286	
   287		for _, t := range m.Targets {
   288			for _, dep := range t.Deps {
   289				if _, ok := byName[dep]; !ok {
   290					return fmt.Errorf("error: target '%s' depends on unknown target '%s'", t.Name, dep)
   291				}
   292			}
   293		}
   294	
   295		for _, t := range m.Targets {
   296			for _, src := range t.Sources {
   297				p := resolvePath(src, manifestDir)
   298				if _, err := os.Stat(p); err != nil {
   299					return fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
   300				}
   301			}
   302		}
   303	
   304		if _, err := topologicalOrder(m); err != nil {
   305			return err
   306		}
   307		return nil
   308	}
   309	
   310	func indexString(s []string, v string) int {
   311		for i, x := range s {
   312			if x == v {
   313				return i
   314			}
   315		}
   316		return -1
   317	}
   318	
   319	func topologicalOrder(m *Manifest) ([]*Target, error) {
   320		byName := make(map[string]*Target)
   321		for _, t := range m.Targets {
   322			byName[t.Name] = t
   323		}
   324	
   325		state := make(map[string]int)
   326		var path []string
   327		var order []*Target
   328	
   329		var dfs func(t *Target) error
   330		dfs = func(t *Target) error {
   331			state[t.Name] = 1
   332			path = append(path, t.Name)
   333	
   334			for _, dep := range t.Deps {
   335				d, ok := byName[dep]
   336				if !ok {
   337					return fmt.Errorf("error: target '%s' depends on unknown target '%s'", t.Name, dep)
   338				}
   339				if state[dep] == 1 {
   340					idx := indexString(path, dep)
   341					if idx < 0 {
   342						idx = 0
   343					}
   344					cycle := append([]string{}, path[idx:]...)
   345					cycle = append(cycle, dep)
   346					return fmt.Errorf("error: dependency cycle detected: %s", strings.Join(cycle, " -> "))
   347				}
   348				if state[dep] == 0 {
   349					if err := dfs(d); err != nil {
   350						return err
   351					}
   352				}
   353			}
   354	
   355			path = path[:len(path)-1]
   356			state[t.Name] = 2
   357			order = append(order, t)
   358			return nil
   359		}
   360	
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '361,540p'
[?2004l   361		for _, t := range m.Targets {
   362			if state[t.Name] == 0 {
   363				if err := dfs(t); err != nil {
   364					return nil, err
   365				}
   366			}
   367		}
   368	
   369		return order, nil
   370	}
   371	
   372	func transitiveDeps(t *Target, byName map[string]*Target) []string {
   373		seen := make(map[string]bool)
   374		var visit func(name string)
   375		visit = func(name string) {
   376			dep, ok := byName[name]
   377			if !ok {
   378				return
   379			}
   380			for _, d := range dep.Deps {
   381				if !seen[d] {
   382					seen[d] = true
   383					visit(d)
   384				}
   385			}
   386		}
   387		visit(t.Name)
   388	
   389		res := make([]string, 0, len(seen))
   390		for k := range seen {
   391			res = append(res, k)
   392		}
   393		sort.Strings(res)
   394		return res
   395	}
   396	
   397	func decodeHash(s string) ([]byte, error) {
   398		b, err := hex.DecodeString(s)
   399		if err != nil {
   400			return nil, fmt.Errorf("invalid output hash: %v", err)
   401		}
   402		if len(b) != 32 {
   403			return nil, fmt.Errorf("invalid output hash length")
   404		}
   405		return b, nil
   406	}
   407	
   408	func computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {
   409		h := sha256.New()
   410	
   411		srcs := append([]string{}, t.Sources...)
   412		sort.Strings(srcs)
   413		for _, src := range srcs {
   414			p := resolvePath(src, manifestDir)
   415			data, err := os.ReadFile(p)
   416			if err != nil {
   417				return "", fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
   418			}
   419			h.Write(data)
   420		}
   421	
   422		h.Write([]byte(t.Compiler))
   423	
   424		for _, f := range t.Flags {
   425			h.Write([]byte(f))
   426			h.Write([]byte("\n"))
   427		}
   428	
   429		envs := append([]string{}, t.EnvCapture...)
   430		sort.Strings(envs)
   431		for _, e := range envs {
   432			h.Write([]byte(e + "=" + os.Getenv(e) + "\n"))
   433		}
   434	
   435		deps := append([]string{}, t.Deps...)
   436		sort.Strings(deps)
   437		for _, d := range deps {
   438			hash, ok := depHashes[d]
   439			if !ok {
   440				return "", fmt.Errorf("error: missing output hash for dependency '%s' (target '%s')", d, t.Name)
   441			}
   442			if len(hash) != 32 {
   443				return "", fmt.Errorf("error: invalid output hash for dependency '%s' (target '%s')", d, t.Name)
   444			}
   445			h.Write(hash)
   446		}
   447	
   448		return hex.EncodeToString(h.Sum(nil)), nil
   449	}
   450	
   451	func copyFile(src, dst string) error {
   452		in, err := os.Open(src)
   453		if err != nil {
   454			return err
   455		}
   456		defer in.Close()
   457	
   458		if err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {
   459			return err
   460		}
   461	
   462		out, err := os.Create(dst)
   463		if err != nil {
   464			return err
   465		}
   466		if _, err := io.Copy(out, in); err != nil {
   467			out.Close()
   468			return err
   469		}
   470		return out.Close()
   471	}
   472	
   473	func storeArtifact(t *Target, storeRoot, fingerprint, outputHashHex, artifactPath string) error {
   474		dir := filepath.Join(storeRoot, "objects", fingerprint[:2], fingerprint)
   475		if err := os.MkdirAll(dir, 0o755); err != nil {
   476			return err
   477		}
   478	
   479		artifactDst := filepath.Join(dir, "artifact")
   480		if err := copyFile(artifactPath, artifactDst); err != nil {
   481			return err
   482		}
   483	
   484		meta := StoredMetadata{
   485			Name:           t.Name,
   486			Fingerprint:    fingerprint,
   487			OutputHash:     outputHashHex,
   488			Compiler:       t.Compiler,
   489			Flags:          t.Flags,
   490			Sources:        t.Sources,
   491			BuildTimestamp: time.Now().UTC().Format(time.RFC3339),
   492		}
   493		data, err := jsonBytes(meta)
   494		if err != nil {
   495			return err
   496		}
   497		return os.WriteFile(filepath.Join(dir, "metadata.json"), data, 0o644)
   498	}
   499	
   500	func readMetadata(path string) (*StoredMetadata, error) {
   501		data, err := os.ReadFile(path)
   502		if err != nil {
   503			return nil, err
   504		}
   505		var meta StoredMetadata
   506		if err := json.Unmarshal(data, &meta); err != nil {
   507			return nil, err
   508		}
   509		if _, err := decodeHash(meta.OutputHash); err != nil {
   510			return nil, err
   511		}
   512		return &meta, nil
   513	}
   514	
   515	func compileTargetInDir(t *Target, sourceDir string) (scratchDir, outputPath, outputHash string, err error) {
   516		scratchDir, err = os.MkdirTemp("", "buildvault-build-*")
   517		if err != nil {
   518			return "", "", "", err
   519		}
   520	
   521		outputPath = filepath.Join(scratchDir, "out", t.Output)
   522		if err := os.MkdirAll(filepath.Dir(outputPath), 0o755); err != nil {
   523			return scratchDir, "", "", err
   524		}
   525	
   526		args := make([]string, 0, len(t.Flags)+len(t.Sources)+2)
   527		args = append(args, t.Flags...)
   528		args = append(args, "-o", outputPath)
   529		for _, src := range t.Sources {
   530			args = append(args, resolvePath(src, sourceDir))
   531		}
   532	
   533		cmd := exec.Command(t.Compiler, args...)
   534		cmd.Dir = sourceDir
   535		out, err := cmd.CombinedOutput()
   536		if err != nil {
   537			detail := strings.TrimSpace(string(out))
   538			if detail == "" {
   539				detail = err.Error()
   540			}
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '541,760p'
[?2004l   541			return scratchDir, "", "", errors.New(detail)
   542		}
   543	
   544		data, err := os.ReadFile(outputPath)
   545		if err != nil {
   546			return scratchDir, "", "", fmt.Errorf("output artifact not found: %v", err)
   547		}
   548		sum := sha256.Sum256(data)
   549		outputHash = hex.EncodeToString(sum[:])
   550		return scratchDir, outputPath, outputHash, nil
   551	}
   552	
   553	func buildAndStoreTarget(t *Target, sourceDir, storeRoot, fingerprint string) (string, error) {
   554		scratch, outputPath, outHash, err := compileTargetInDir(t, sourceDir)
   555		if scratch != "" {
   556			defer os.RemoveAll(scratch)
   557		}
   558		if err != nil {
   559			return "", err
   560		}
   561		if err := storeArtifact(t, storeRoot, fingerprint, outHash, outputPath); err != nil {
   562			return "", err
   563		}
   564		return outHash, nil
   565	}
   566	
   567	func compileFresh(t *Target, sourceDir string) (string, error) {
   568		scratch, _, outHash, err := compileTargetInDir(t, sourceDir)
   569		if scratch != "" {
   570			defer os.RemoveAll(scratch)
   571		}
   572		return outHash, err
   573	}
   574	
   575	func runBuild(m *Manifest, manifestDir string) ([]buildResult, error) {
   576		order, err := topologicalOrder(m)
   577		if err != nil {
   578			return nil, err
   579		}
   580	
   581		depHashes := make(map[string][]byte)
   582		results := make([]buildResult, 0, len(order))
   583	
   584		for _, t := range order {
   585			fp, err := computeFingerprint(t, manifestDir, depHashes)
   586			if err != nil {
   587				return nil, err
   588			}
   589	
   590			metaPath := filepath.Join(m.StoreRoot, "objects", fp[:2], fp, "metadata.json")
   591			if _, err := os.Stat(metaPath); err == nil {
   592				meta, err := readMetadata(metaPath)
   593				if err != nil {
   594					return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
   595				}
   596				hash, err := decodeHash(meta.OutputHash)
   597				if err != nil {
   598					return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
   599				}
   600				fmt.Fprintf(os.Stderr, "[cache hit] %s\n", t.Name)
   601				depHashes[t.Name] = hash
   602				results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: meta.OutputHash, Cached: true})
   603				continue
   604			}
   605	
   606			fmt.Fprintf(os.Stderr, "[building] %s\n", t.Name)
   607			outHash, err := buildAndStoreTarget(t, manifestDir, m.StoreRoot, fp)
   608			if err != nil {
   609				fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
   610				return nil, errBuildFailed
   611			}
   612			fmt.Fprintf(os.Stderr, "[stored] %s %s\n", t.Name, fp)
   613	
   614			hash, err := decodeHash(outHash)
   615			if err != nil {
   616				return nil, err
   617			}
   618			depHashes[t.Name] = hash
   619			results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: outHash, Cached: false})
   620		}
   621	
   622		return results, nil
   623	}
   624	
   625	func copySources(m *Manifest, manifestDir string) (string, error) {
   626		tempDir, err := os.MkdirTemp("", "buildvault-verify-*")
   627		if err != nil {
   628			return "", err
   629		}
   630	
   631		for _, t := range m.Targets {
   632			for _, src := range t.Sources {
   633				srcAbs := resolvePath(src, manifestDir)
   634				dst := filepath.Join(tempDir, filepath.Clean(src))
   635				if err := copyFile(srcAbs, dst); err != nil {
   636					os.RemoveAll(tempDir)
   637					return "", err
   638				}
   639			}
   640		}
   641	
   642		return tempDir, nil
   643	}
   644	
   645	func dirSize(path string) int64 {
   646		var size int64
   647		filepath.Walk(path, func(_ string, info os.FileInfo, err error) error {
   648			if err != nil {
   649				return nil
   650			}
   651			if !info.IsDir() {
   652				size += info.Size()
   653			}
   654			return nil
   655		})
   656		return size
   657	}
   658	
   659	func gcStore(storeRoot string, referenced map[string]bool) (int, int, int64) {
   660		objectsDir := filepath.Join(storeRoot, "objects")
   661		entries, err := os.ReadDir(objectsDir)
   662		if err != nil {
   663			return 0, 0, 0
   664		}
   665	
   666		removed := 0
   667		retained := 0
   668		var freed int64
   669	
   670		for _, prefixEntry := range entries {
   671			if !prefixEntry.IsDir() {
   672				continue
   673			}
   674			prefixPath := filepath.Join(objectsDir, prefixEntry.Name())
   675			fps, err := os.ReadDir(prefixPath)
   676			if err != nil {
   677				continue
   678			}
   679			for _, fpEntry := range fps {
   680				if !fpEntry.IsDir() {
   681					continue
   682				}
   683				fp := fpEntry.Name()
   684				fpDir := filepath.Join(prefixPath, fp)
   685				if referenced[fp] {
   686					retained++
   687					continue
   688				}
   689				size := dirSize(fpDir)
   690				if err := os.RemoveAll(fpDir); err != nil {
   691					continue
   692				}
   693				removed++
   694				freed += size
   695			}
   696		}
   697	
   698		return removed, retained, freed
   699	}
   700	
   701	func jsonBytes(v interface{}) ([]byte, error) {
   702		var buf bytes.Buffer
   703		enc := json.NewEncoder(&buf)
   704		enc.SetEscapeHTML(false)
   705		if err := enc.Encode(v); err != nil {
   706			return nil, err
   707		}
   708		return bytes.TrimRight(buf.Bytes(), "\n"), nil
   709	}
   710	
   711	func printJSON(v interface{}) {
   712		data, err := jsonBytes(v)
   713		if err != nil {
   714			fmt.Fprintln(os.Stderr, "error:", err)
   715			os.Exit(1)
   716		}
   717		fmt.Println(string(data))
   718	}
