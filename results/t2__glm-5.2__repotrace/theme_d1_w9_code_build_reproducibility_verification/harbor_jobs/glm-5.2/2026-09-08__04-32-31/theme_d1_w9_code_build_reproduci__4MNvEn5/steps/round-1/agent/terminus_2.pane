   987	func depFingerprintsForTarget(results []buildResult, resultsByName map[string]buildResult, t *Target) map[string]string {
   988		deps := make(map[string]string, len(t.Deps))
   989		for _, d := range t.Deps {
   990			if r, ok := resultsByName[d]; ok {
   991				deps[d] = r.Fingerprint
   992			}
   993		}
   994		return deps
   995	}
