   997	func readLockfile(path string) (*lockfile, error) {
   998		data, err := os.ReadFile(path)
   999		if err != nil {
  1000			if os.IsNotExist(err) {
  1001				return nil, fmt.Errorf("error: lockfile not found: %s", path)
  1002			}
  1003			return nil, fmt.Errorf("error: lockfile not found: %s", path)
  1004		}
  1005		var lf lockfile
  1006		if err := json.Unmarshal(data, &lf); err != nil {
  1007			return nil, fmt.Errorf("error: invalid lockfile: %v", err)
  1008		}
  1009		if lf.Targets == nil {
  1010			lf.Targets = map[string]lockfileTarget{}
  1011		}
  1012		for name, tt := range lf.Targets {
  1013			if tt.SourceHashes == nil {
  1014				tt.SourceHashes = map[string]string{}
  1015				lf.Targets[name] = tt
  1016			}
  1017			if tt.DepFingerprints == nil {
  1018				tt.DepFingerprints = map[string]string{}
  1019				lf.Targets[name] = tt
  1020			}
  1021			if tt.EnvValues == nil {
  1022				tt.EnvValues = map[string]string{}
  1023				lf.Targets[name] = tt
  1024			}
  1025			if tt.Flags == nil {
  1026				tt.Flags = []string{}
  1027				lf.Targets[name] = tt
  1028			}
  1029		}
  1030		return &lf, nil
  1031	}
