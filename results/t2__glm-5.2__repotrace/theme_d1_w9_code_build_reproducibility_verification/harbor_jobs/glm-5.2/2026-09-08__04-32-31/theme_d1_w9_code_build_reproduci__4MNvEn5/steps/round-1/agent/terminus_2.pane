    86	func loadManifest(path string) (*Manifest, string, error) {
    87		data, err := os.ReadFile(path)
    88		if err != nil {
    89			if os.IsNotExist(err) {
    90				return nil, "", fmt.Errorf("error: manifest not found: %s", path)
    91			}
    92			return nil, "", fmt.Errorf("error: invalid manifest: %v", err)
    93		}
    94	
    95		var raw struct {
    96			StoreRoot string          `json:"store_root"`
    97			Profiles  json.RawMessage `json:"profiles"`
    98			Targets   []*Target       `json:"targets"`
    99		}
   100		if err := json.Unmarshal(data, &raw); err != nil {
   101			return nil, "", fmt.Errorf("error: invalid manifest: %v", err)
   102		}
   103	
   104		m := Manifest{
   105			StoreRoot: raw.StoreRoot,
   106			Targets:   raw.Targets,
   107		}
   108	
   109		if len(raw.Profiles) > 0 {
   110			var rawProfiles map[string]json.RawMessage
   111			if err := json.Unmarshal(raw.Profiles, &rawProfiles); err != nil {
   112				return nil, "", fmt.Errorf("error: invalid manifest: profiles must be an object")
   113			}
   114			m.Profiles = make(map[string]Profile, len(rawProfiles))
   115			for name, rawProfile := range rawProfiles {
   116				p, err := parseProfile(name, rawProfile)
   117				if err != nil {
   118					return nil, "", err
   119				}
   120				m.Profiles[name] = p
   121			}
   122		}
   123	
   124		manifestDir, err := filepath.Abs(filepath.Dir(path))
   125		if err != nil {
   126			return nil, "", fmt.Errorf("error: invalid manifest: %v", err)
   127		}
   128	
   129		if m.StoreRoot == "" {
   130			m.StoreRoot = "artifact_store"
   131		}
