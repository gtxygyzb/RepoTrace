   347		if err := json.Unmarshal(data, &meta); err != nil {
   348			return nil, err
   349		}
   350		if _, err := decodeHash(meta.OutputHash); err != nil {
   351			return nil, err
   352		}
   353		return &meta, nil
   354	}
