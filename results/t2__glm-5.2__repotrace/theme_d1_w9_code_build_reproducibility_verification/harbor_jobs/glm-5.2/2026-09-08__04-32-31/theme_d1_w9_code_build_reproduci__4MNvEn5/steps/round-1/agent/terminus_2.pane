   211	func transitiveDeps(t *Target, byName map[string]*Target) []string {
   212		seen := make(map[string]bool)
   213		var visit func(name string)
   214		visit = func(name string) {
   215			dep, ok := byName[name]
   216			if !ok {
   217				return
   218			}
   219			for _, d := range dep.Deps {
   220				if !seen[d] {
   221					seen[d] = true
   222					visit(d)
   223				}
   224			}
   225		}
   226		visit(t.Name)
   227	
   228		res := make([]string, 0, len(seen))
   229		for k := range seen {
   230			res = append(res, k)
   231		}
   232		sort.Strings(res)
   233		return res
   234	}
   235	
   236	func decodeHash(s string) ([]byte, error) {
   237		b, err := hex.DecodeString(s)
   238		if err != nil {
   239			return nil, fmt.Errorf("invalid output hash: %v", err)
   240		}
   241		if len(b) != 32 {
   242			return nil, fmt.Errorf("invalid output hash length")
   243		}
   244		return b, nil
   245	}
   246	
   247	func computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {
   248		h := sha256.New()
   249	
   250		srcs := append([]string{}, t.Sources...)
   251		sort.Strings(srcs)
   252		for _, src := range srcs {
   253			p := resolvePath(src, manifestDir)
   254			data, err := os.ReadFile(p)
   255			if err != nil {
   256				return "", fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
   257			}
   258			h.Write(data)
   259		}
   260	
   261		h.Write([]byte(t.Compiler))
   262	
   263		flags := append([]string{}, t.Flags...)
   264		sort.Strings(flags)
   265		for _, f := range flags {
   266			h.Write([]byte(f))
   267			h.Write([]byte("\n"))
   268		}
   269	
   270		envs := append([]string{}, t.EnvCapture...)
   271		sort.Strings(envs)
   272		for _, e := range envs {
   273			h.Write([]byte(e + "=" + os.Getenv(e) + "\n"))
   274		}
   275	
   276		deps := append([]string{}, t.Deps...)
   277		sort.Strings(deps)
   278		for _, d := range deps {
   279			hash, ok := depHashes[d]
   280			if !ok {
   281				return "", fmt.Errorf("error: missing output hash for dependency '%s' (target '%s')", d, t.Name)
   282			}
   283			if len(hash) != 32 {
   284				return "", fmt.Errorf("error: invalid output hash for dependency '%s' (target '%s')", d, t.Name)
   285			}
   286			h.Write(hash)
   287		}
   288	
   289		return hex.EncodeToString(h.Sum(nil)), nil
   290	}
