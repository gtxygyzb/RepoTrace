[?2004lfunc computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {
	h := sha256.New()

	srcs := append([]string{}, t.Sources...)
	sort.Strings(srcs)
	for _, src := range srcs {
		p := resolvePath(src, manifestDir)
		data, err := os.ReadFile(p)
		if err != nil {
			return "", fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
		}
		h.Write(data)
	}

	h.Write([]byte(t.Compiler))

	flags := append([]string{}, t.Flags...)
	sort.Strings(flags)
	for _, f := range flags {
		h.Write([]byte(f))
		h.Write([]byte("\n"))
	}

	envs := append([]string{}, t.EnvCapture...)
	sort.Strings(envs)
	for _, e := range envs {
		h.Write([]byte(e + "=" + os.Getenv(e) + "\n"))
	}

	deps := append([]string{}, t.Deps...)
	sort.Strings(deps)
	for _, d := range deps {
		hash, ok := depHashes[d]
		if !ok {
			return "", fmt.Errorf("error: missing output hash for dependency '%s' (target '%s')", d, t.Name)
		}
		if len(hash) != 32 {
			return "", fmt.Errorf("error: invalid output hash for dependency '%s' (target '%s')", d, t.Name)
		}
		h.Write(hash)
	}

	return hex.EncodeToString(h.Sum(nil)), nil
}

