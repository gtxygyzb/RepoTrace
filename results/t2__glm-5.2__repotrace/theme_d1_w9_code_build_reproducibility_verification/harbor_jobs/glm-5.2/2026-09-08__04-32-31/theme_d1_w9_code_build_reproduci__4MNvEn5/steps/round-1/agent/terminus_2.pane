   612	func cmdVerify(args []string) int {
   613		if len(args) != 1 {
   614			fmt.Fprintln(os.Stderr, "error: usage: buildvault verify <manifest_path>")
   615			return 1
   616		}
   617	
   618		m, dir, err := loadManifest(args[0])
   619		if err != nil {
   620			fmt.Fprintln(os.Stderr, err)
   621			return 1
   622		}
   623		if err := validateManifest(m, dir); err != nil {
   624			fmt.Fprintln(os.Stderr, err)
   625			return 1
   626		}
   627	
   628		order, err := topologicalOrder(m)
   629		if err != nil {
   630			fmt.Fprintln(os.Stderr, err)
   631			return 1
   632		}
   633	
   634		firstDir, err := copySources(m, dir)
   635		if err != nil {
   636			fmt.Fprintln(os.Stderr, err)
   637			return 1
   638		}
   639		defer os.RemoveAll(firstDir)
   640	
   641		secondDir, err := copySources(m, dir)
   642		if err != nil {
   643			fmt.Fprintln(os.Stderr, err)
   644			return 1
   645		}
   646		defer os.RemoveAll(secondDir)
   647	
   648		firstHashes := make(map[string]string)
   649		for _, t := range order {
   650			h, err := compileFresh(t, firstDir)
   651			if err != nil {
   652				fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
   653				return 1
   654			}
   655			firstHashes[t.Name] = h
   656		}
   657	
   658		secondHashes := make(map[string]string)
   659		for _, t := range order {
   660			h, err := compileFresh(t, secondDir)
   661			if err != nil {
   662				fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
   663				return 1
   664			}
   665			secondHashes[t.Name] = h
   666		}
   667	
   668		type targetJSON struct {
   669			Name         string `json:"name"`
   670			FirstHash    string `json:"first_hash"`
   671			SecondHash   string `json:"second_hash"`
   672			Reproducible bool   `json:"reproducible"`
   673		}
   674	
   675		targets := make([]targetJSON, 0, len(order))
   676		reproducible := true
   677		for _, t := range order {
   678			ok := firstHashes[t.Name] == secondHashes[t.Name]
   679			if !ok {
   680				reproducible = false
   681			}
   682			targets = append(targets, targetJSON{
   683				Name:         t.Name,
   684				FirstHash:    firstHashes[t.Name],
   685				SecondHash:   secondHashes[t.Name],
   686				Reproducible: ok,
   687			})
   688		}
   689	
   690		printJSON(struct {
   691			Reproducible bool         `json:"reproducible"`
   692			Targets      []targetJSON `json:"targets"`
   693		}{
   694			Reproducible: reproducible,
   695			Targets:      targets,
   696		})
   697		return 0
   698	}
