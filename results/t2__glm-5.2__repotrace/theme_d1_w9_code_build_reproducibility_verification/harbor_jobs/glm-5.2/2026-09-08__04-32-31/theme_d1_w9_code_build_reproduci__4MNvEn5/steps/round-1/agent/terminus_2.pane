			}
			fmt.Fprintf(os.Stderr, "[cache hit] %s\n", t.Name)
			depHashes[t.Name] = hash
			results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: meta.OutputHash, Cached: true})
			continue
		}

		fmt.Fprintf(os.Stderr, "[building] %s\n", t.Name)
		outHash, err := buildAndStoreTarget(t, manifestDir, m.StoreRoot, fp)
