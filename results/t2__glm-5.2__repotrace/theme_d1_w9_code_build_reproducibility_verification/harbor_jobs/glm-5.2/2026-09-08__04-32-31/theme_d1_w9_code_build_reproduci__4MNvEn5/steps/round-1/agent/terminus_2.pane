   957	func sha256File(path string) (string, error) {
   958		data, err := os.ReadFile(path)
   959		if err != nil {
   960			return "", err
   961		}
   962		sum := sha256.Sum256(data)
   963		return hex.EncodeToString(sum[:]), nil
   964	}
   965	
   966	func sourceHashesForTarget(t *Target, manifestDir string) (map[string]string, error) {
   967		hashes := make(map[string]string, len(t.Sources))
   968		for _, src := range t.Sources {
   969			p := resolvePath(src, manifestDir)
   970			h, err := sha256File(p)
   971			if err != nil {
   972				return nil, fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
   973			}
   974			hashes[src] = h
   975		}
   976		return hashes, nil
   977	}
