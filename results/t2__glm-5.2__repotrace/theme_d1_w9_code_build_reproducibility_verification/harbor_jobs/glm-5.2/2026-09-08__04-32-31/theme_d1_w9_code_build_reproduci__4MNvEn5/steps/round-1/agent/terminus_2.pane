[?2004lfunc validateManifest(m *Manifest, manifestDir string) error {
	names := make(map[string]bool)
	for _, t := range m.Targets {
		if names[t.Name] {
			return fmt.Errorf("error: duplicate target name: '%s'", t.Name)
		}
		names[t.Name] = true
	}

	byName := make(map[string]*Target)
	for _, t := range m.Targets {
		byName[t.Name] = t
	}

	for _, t := range m.Targets {
		for _, dep := range t.Deps {
			if _, ok := byName[dep]; !ok {
				return fmt.Errorf("error: target '%s' depends on unknown target '%s'", t.Name, dep)
			}
		}
	}

	for _, t := range m.Targets {
		for _, src := range t.Sources {
			p := resolvePath(src, manifestDir)
			if _, err := os.Stat(p); err != nil {
				return fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
			}
		}
	}

	if _, err := topologicalOrder(m); err != nil {
		return err
	}
	return nil
}

func indexString(s []string, v string) int {
	for i, x := range s {
		if x == v {
			return i
		}
	}
	return -1
}

func topologicalOrder(m *Manifest) ([]*Target, error) {
	byName := make(map[string]*Target)
	for _, t := range m.Targets {
		byName[t.Name] = t
	}

	state := make(map[string]int)
	var path []string
	var order []*Target

	var dfs func(t *Target) error
	dfs = func(t *Target) error {
		state[t.Name] = 1
		path = append(path, t.Name)

		for _, dep := range t.Deps {
			d, ok := byName[dep]
			if !ok {
				return fmt.Errorf("error: target '%s' depends on unknown target '%s'", t.Name, dep)
			}
			if state[dep] == 1 {
				idx := indexString(path, dep)
				if idx < 0 {
					idx = 0
				}
				cycle := append([]string{}, path[idx:]...)
				cycle = append(cycle, dep)
				return fmt.Errorf("error: dependency cycle detected: %s", strings.Join(cycle, " -> "))
			}
			if state[dep] == 0 {
				if err := dfs(d); err != nil {
					return err
				}
			}
		}

		path = path[:len(path)-1]
		state[t.Name] = 2
		order = append(order, t)
		return nil
	}

	for _, t := range m.Targets {
		if state[t.Name] == 0 {
			if err := dfs(t); err != nil {
				return nil, err
			}
		}
	}

	return order, nil
}

func transitiveDeps(t *Target, byName map[string]*Target) []string {
	seen := make(map[string]bool)
	var visit func(name string)
	visit = func(name string) {
		dep, ok := byName[name]
		if !ok {
			return
		}
		for _, d := range dep.Deps {
			if !seen[d] {
				seen[d] = true
				visit(d)
			}
		}
	}
	visit(t.Name)

	res := make([]string, 0, len(seen))
	for k := range seen {
		res = append(res, k)
	}
	sort.Strings(res)
	return res
}

