   812		results, err := runBuild(m, dir)
   813		if err != nil {
   814			if errors.Is(err, errBuildFailed) {
   815				return 1
   816			}
   817			fmt.Fprintln(os.Stderr, err)
   818			return 1
   819		}
   820	
   821		data, err := os.ReadFile(baselinePath)
   822		if err != nil {
   823			if os.IsNotExist(err) {
   824				fmt.Fprintf(os.Stderr, "error: baseline not found: %s\n", baselinePath)
   825				return 1
   826			}
   827			fmt.Fprintf(os.Stderr, "error: invalid baseline: %v\n", err)
   828			return 1
   829		}
   830	
   831		var baseline struct {
