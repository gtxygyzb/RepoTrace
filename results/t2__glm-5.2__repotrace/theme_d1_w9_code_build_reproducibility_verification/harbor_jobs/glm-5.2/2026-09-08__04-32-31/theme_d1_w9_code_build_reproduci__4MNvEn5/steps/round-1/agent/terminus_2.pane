[?2004lfunc compileTargetInDir(t *Target, sourceDir string) (scratchDir, outputPath, outputHash string, err error) {
	scratchDir, err = os.MkdirTemp("", "buildvault-build-*")
	if err != nil {
		return "", "", "", err
	}

	outputPath = filepath.Join(scratchDir, "out", t.Output)
	if err := os.MkdirAll(filepath.Dir(outputPath), 0o755); err != nil {
		return scratchDir, "", "", err
	}

	args := make([]string, 0, len(t.Flags)+len(t.Sources)+2)
	args = append(args, t.Flags...)
	args = append(args, "-o", outputPath)
	for _, src := range t.Sources {
		args = append(args, resolvePath(src, sourceDir))
	}

	cmd := exec.Command(t.Compiler, args...)
	cmd.Dir = sourceDir
	out, err := cmd.CombinedOutput()
	if err != nil {
		detail := strings.TrimSpace(string(out))
		if detail == "" {
			detail = err.Error()
		}
		return scratchDir, "", "", errors.New(detail)
	}

	data, err := os.ReadFile(outputPath)
	if err != nil {
		return scratchDir, "", "", fmt.Errorf("output artifact not found: %v", err)
	}
	sum := sha256.Sum256(data)
	outputHash = hex.EncodeToString(sum[:])
	return scratchDir, outputPath, outputHash, nil
}

func buildAndStoreTarget(t *Target, sourceDir, storeRoot, fingerprint string) (string, error) {
	scratch, outputPath, outHash, err := compileTargetInDir(t, sourceDir)
	if scratch != "" {
		defer os.RemoveAll(scratch)
	}
	if err != nil {
		return "", err
	}
	if err := storeArtifact(t, storeRoot, fingerprint, outHash, outputPath); err != nil {
		return "", err
	}
	return outHash, nil
}

func compileFresh(t *Target, sourceDir string) (string, error) {
	scratch, _, outHash, err := compileTargetInDir(t, sourceDir)
	if scratch != "" {
		defer os.RemoveAll(scratch)
	}
	return outHash, err
}

func runBuild(m *Manifest, manifestDir string) ([]buildResult, error) {
