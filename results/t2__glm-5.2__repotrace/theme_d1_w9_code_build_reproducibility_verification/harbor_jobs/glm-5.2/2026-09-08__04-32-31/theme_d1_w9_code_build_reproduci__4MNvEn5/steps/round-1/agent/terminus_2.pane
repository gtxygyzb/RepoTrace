    78	func loadManifest(path string) (*Manifest, string, error) {
    79		data, err := os.ReadFile(path)
    80		if err != nil {
    81			if os.IsNotExist(err) {
    82				return nil, "", fmt.Errorf("error: manifest not found: %s", path)
    83			}
    84			return nil, "", fmt.Errorf("error: invalid manifest: %v", err)
    85		}
    86	
    87		var m Manifest
    88		if err := json.Unmarshal(data, &m); err != nil {
    89			return nil, "", fmt.Errorf("error: invalid manifest: %v", err)
    90		}
    91	
    92		manifestDir, err := filepath.Abs(filepath.Dir(path))
    93		if err != nil {
    94			return nil, "", fmt.Errorf("error: invalid manifest: %v", err)
    95		}
    96	
    97		if m.StoreRoot == "" {
    98			m.StoreRoot = "artifact_store"
    99		}
   100		m.StoreRoot = resolvePath(m.StoreRoot, manifestDir)
   101	
   102		for _, t := range m.Targets {
   103			if t == nil {
   104				return nil, "", fmt.Errorf("error: invalid manifest: target is null")
   105			}
   106			normalizeTarget(t)
   107		}
   108	
   109		return &m, manifestDir, nil
   110	}
