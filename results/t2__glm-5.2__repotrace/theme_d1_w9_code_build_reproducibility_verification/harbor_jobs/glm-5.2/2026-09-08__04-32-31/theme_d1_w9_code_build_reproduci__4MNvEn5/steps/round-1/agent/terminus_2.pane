  1326	func cmdLockDiff(args []string) int {
  1327		if len(args) != 2 {
  1328			fmt.Fprintln(os.Stderr, "error: usage: buildvault lock-diff <lockfile_a_path> <lockfile_b_path>")
  1329			return 1
  1330		}
  1331	
  1332		lfA, err := readLockfile(args[0])
  1333		if err != nil {
  1334			fmt.Fprintln(os.Stderr, err)
  1335			return 1
  1336		}
  1337		lfB, err := readLockfile(args[1])
  1338		if err != nil {
  1339			fmt.Fprintln(os.Stderr, err)
  1340			return 1
  1341		}
  1342	
  1343		added := []string{}
  1344		removed := []string{}
  1345		changed := []struct {
  1346			Name       string   `json:"name"`
  1347			Reasons    []string `json:"reasons"`
  1348			ImpactedBy []string `json:"impacted_by"`
  1349		}{}
  1350		unchanged := []string{}
  1351	
  1352		for name := range lfA.Targets {
  1353			if _, ok := lfB.Targets[name]; !ok {
  1354				removed = append(removed, name)
  1355			}
  1356		}
  1357		for name, tb := range lfB.Targets {
  1358			ta, ok := lfA.Targets[name]
  1359			if !ok {
  1360				added = append(added, name)
  1361				continue
  1362			}
  1363			if ta.Fingerprint == tb.Fingerprint {
  1364				unchanged = append(unchanged, name)
  1365				continue
  1366			}
  1367			reasons := changeReasons(tb.Compiler, ta.Compiler, tb.Flags, ta.Flags, tb.SourceHashes, ta.SourceHashes, tb.DepFingerprints, ta.DepFingerprints, tb.EnvValues, ta.EnvValues)
  1368			impacted := impactedByForLockDiff(lfA, lfB, name)
  1369			changed = append(changed, struct {
  1370				Name       string   `json:"name"`
  1371				Reasons    []string `json:"reasons"`
  1372				ImpactedBy []string `json:"impacted_by"`
  1373			}{Name: name, Reasons: reasons, ImpactedBy: impacted})
  1374		}
  1375	
  1376		sort.Strings(added)
  1377		sort.Strings(removed)
  1378		sort.Strings(unchanged)
  1379		sort.Slice(changed, func(i, j int) bool { return changed[i].Name < changed[j].Name })
  1380	
  1381		printJSON(struct {
  1382			Added   []string `json:"added"`
  1383			Removed []string `json:"removed"`
  1384			Changed []struct {
  1385				Name       string   `json:"name"`
  1386				Reasons    []string `json:"reasons"`
  1387				ImpactedBy []string `json:"impacted_by"`
  1388			} `json:"changed"`
  1389			Unchanged []string `json:"unchanged"`
  1390		}{
  1391			Added:     added,
  1392			Removed:   removed,
  1393			Changed:   changed,
  1394			Unchanged: unchanged,
  1395		})
  1396		return 0
  1397	}
