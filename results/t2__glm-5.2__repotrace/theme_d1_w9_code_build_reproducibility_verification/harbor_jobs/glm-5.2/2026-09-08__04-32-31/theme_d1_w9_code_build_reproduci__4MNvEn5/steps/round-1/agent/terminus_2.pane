   112	func validateManifest(m *Manifest, manifestDir string) error {
   113		names := make(map[string]bool)
   114		for _, t := range m.Targets {
   115			if names[t.Name] {
   116				return fmt.Errorf("error: duplicate target name: '%s'", t.Name)
   117			}
   118			names[t.Name] = true
   119		}
   120	
   121		byName := make(map[string]*Target)
   122		for _, t := range m.Targets {
   123			byName[t.Name] = t
   124		}
   125	
   126		for _, t := range m.Targets {
   127			for _, dep := range t.Deps {
   128				if _, ok := byName[dep]; !ok {
   129					return fmt.Errorf("error: target '%s' depends on unknown target '%s'", t.Name, dep)
   130				}
   131			}
   132		}
   133	
   134		for _, t := range m.Targets {
   135			for _, src := range t.Sources {
   136				p := resolvePath(src, manifestDir)
   137				if _, err := os.Stat(p); err != nil {
   138					return fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
   139				}
   140			}
   141		}
   142	
   143		if _, err := topologicalOrder(m); err != nil {
   144			return err
   145		}
   146		return nil
   147	}
