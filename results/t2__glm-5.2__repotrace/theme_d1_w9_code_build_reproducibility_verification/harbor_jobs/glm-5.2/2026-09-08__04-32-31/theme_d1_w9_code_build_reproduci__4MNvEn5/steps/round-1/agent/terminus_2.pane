[?2004lfunc cmdBuild(args []string) int {
	args, profile, status := extractProfile(args)
	if status != 0 {
		return status
	}
	if len(args) != 1 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault build <manifest_path> [--profile <name>]")
		return 1
	}

	m, dir, err := loadManifest(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := applyProfile(m, profile); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	results, err := runBuild(m, dir)
	if err != nil {
		if errors.Is(err, errBuildFailed) {
			return 1
		}
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	type targetJSON struct {
		Name        string `json:"name"`
		Fingerprint string `json:"fingerprint"`
		OutputHash  string `json:"output_hash"`
		Cached      bool   `json:"cached"`
	}
	targets := make([]targetJSON, 0, len(results))
	for _, r := range results {
		targets = append(targets, targetJSON{
			Name:        r.Target.Name,
			Fingerprint: r.Fingerprint,
			OutputHash:  r.OutputHash,
			Cached:      r.Cached,
		})
	}

	printJSON(struct {
		Targets   []targetJSON `json:"targets"`
		StoreRoot string       `json:"store_root"`
	}{
		Targets:   targets,
		StoreRoot: m.StoreRoot,
	})
	return 0
}

func cmdVerify(args []string) int {
	args, profile, status := extractProfile(args)
	if status != 0 {
		return status
	}
	if len(args) != 1 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault verify <manifest_path> [--profile <name>]")
		return 1
	}

	m, dir, err := loadManifest(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := applyProfile(m, profile); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	order, err := topologicalOrder(m)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	firstDir, err := copySources(m, dir)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	defer os.RemoveAll(firstDir)

	secondDir, err := copySources(m, dir)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	defer os.RemoveAll(secondDir)

	firstHashes := make(map[string]string)
	for _, t := range order {
		h, err := compileFresh(t, firstDir)
		if err != nil {
			fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
			return 1
		}
		firstHashes[t.Name] = h
	}

	secondHashes := make(map[string]string)
	for _, t := range order {
		h, err := compileFresh(t, secondDir)
		if err != nil {
			fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
			return 1
		}
		secondHashes[t.Name] = h
	}

	type targetJSON struct {
		Name         string `json:"name"`
		FirstHash    string `json:"first_hash"`
		SecondHash   string `json:"second_hash"`
		Reproducible bool   `json:"reproducible"`
	}

	targets := make([]targetJSON, 0, len(order))
	reproducible := true
	for _, t := range order {
		ok := firstHashes[t.Name] == secondHashes[t.Name]
		if !ok {
			reproducible = false
		}
		targets = append(targets, targetJSON{
			Name:         t.Name,
			FirstHash:    firstHashes[t.Name],
			SecondHash:   secondHashes[t.Name],
			Reproducible: ok,
		})
	}

	printJSON(struct {
		Reproducible bool         `json:"reproducible"`
		Targets      []targetJSON `json:"targets"`
	}{
		Reproducible: reproducible,
		Targets:      targets,
	})
	return 0
}

func cmdInspect(args []string) int {
	args, profile, status := extractProfile(args)
	if status != 0 {
		return status
	}
	if len(args) != 1 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault inspect <manifest_path> [--profile <name>]")
		return 1
	}

	m, dir, err := loadManifest(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := applyProfile(m, profile); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	order, err := topologicalOrder(m)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	byName := make(map[string]*Target)
	for _, t := range m.Targets {
		byName[t.Name] = t
	}

	depHashes := make(map[string][]byte)
	for _, t := range m.Targets {
		depHashes[t.Name] = make([]byte, 32)
	}

	type targetJSON struct {
		Name           string   `json:"name"`
		Sources        []string `json:"sources"`
		Deps           []string `json:"deps"`
		TransitiveDeps []string `json:"transitive_deps"`
		Fingerprint    string   `json:"fingerprint"`
	}

	targets := make([]targetJSON, 0, len(order))
	for _, t := range order {
		fp, err := computeFingerprint(t, dir, depHashes)
		if err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 1
		}
		targets = append(targets, targetJSON{
			Name:           t.Name,
			Sources:        t.Sources,
			Deps:           t.Deps,
			TransitiveDeps: transitiveDeps(t, byName),
			Fingerprint:    fp,
		})
	}

	buildOrder := make([]string, 0, len(order))
	for _, t := range order {
		buildOrder = append(buildOrder, t.Name)
	}

	printJSON(struct {
		Targets    []targetJSON `json:"targets"`
		BuildOrder []string     `json:"build_order"`
	}{
		Targets:    targets,
		BuildOrder: buildOrder,
	})
	return 0
}

func cmdAudit(args []string) int {
	args, profile, status := extractProfile(args)
	if status != 0 {
