  1250		type targetResult struct {
  1251			Name             string   `json:"name"`
  1252			FingerprintMatch bool     `json:"fingerprint_match"`
  1253			OutputMatch      bool     `json:"output_match"`
  1254			ChangeReasons    []string `json:"change_reasons"`
  1255			ImpactedBy       []string `json:"impacted_by"`
  1256		}
  1257	
  1258		allMatch := true
  1259		targets := make([]targetResult, 0, len(results))
  1260		for _, r := range results {
  1261			t := r.Target
  1262			lt, inLock := lf.Targets[t.Name]
  1263	
  1264			fpMatch := inLock && r.Fingerprint == lt.Fingerprint
  1265			outMatch := inLock && r.OutputHash == lt.OutputHash
  1266			if !fpMatch || !outMatch {
  1267				allMatch = false
  1268			}
  1269	
  1270			reasons := []string{}
  1271			impacted := []string{}
  1272			if !inLock {
  1273				reasons = []string{"new_target"}
  1274				for _, dep := range transitiveDepsFromManifest(m, t.Name) {
  1275					if _, depInLock := lf.Targets[dep]; !depInLock {
  1276						impacted = append(impacted, dep)
  1277					}
  1278				}
  1279				sort.Strings(impacted)
  1280			} else {
  1281				srcHashes, err := sourceHashesForTarget(t, dir)
  1282				if err != nil {
  1283					fmt.Fprintln(os.Stderr, err)
  1284					return 1
  1285				}
  1286				currentDeps := depFingerprintsForTarget(results, resultsByName, t)
  1287				currentEnv := envValuesForTarget(t)
  1288				reasons = changeReasons(t.Compiler, lt.Compiler, t.Flags, lt.Flags, srcHashes, lt.SourceHashes, currentDeps, lt.DepFingerprints, currentEnv, lt.EnvValues)
  1289				if fpMatch {
  1290					reasons = []string{}
  1291					impacted = []string{}
  1292				} else {
  1293					for _, dep := range transitiveDepsFromManifest(m, t.Name) {
  1294						rdep, ok := resultsByName[dep]
  1295						if !ok {
  1296							continue
  1297						}
  1298						ltdep, depInLock := lf.Targets[dep]
  1299						if !depInLock || ltdep.Fingerprint != rdep.Fingerprint {
  1300							impacted = append(impacted, dep)
  1301						}
  1302					}
  1303					sort.Strings(impacted)
  1304				}
  1305			}
  1306	
  1307			targets = append(targets, targetResult{
  1308				Name:             t.Name,
  1309				FingerprintMatch: fpMatch,
  1310				OutputMatch:      outMatch,
  1311				ChangeReasons:    reasons,
  1312				ImpactedBy:       impacted,
  1313			})
  1314		}
  1315	
  1316		printJSON(struct {
  1317			AllMatch bool           `json:"all_match"`
  1318			Targets  []targetResult `json:"targets"`
  1319		}{
  1320			AllMatch: allMatch,
  1321			Targets:  targets,
  1322		})
  1323		return 0
  1324	}
