   771	func cmdAudit(args []string) int {
   772		if len(args) < 1 {
   773			fmt.Fprintln(os.Stderr, "error: usage: buildvault audit <manifest_path> --baseline <baseline_path>")
   774			return 1
   775		}
   776	
   777		manifestPath := args[0]
   778		rest := args[1:]
   779		baselinePath := ""
   780	
   781		for i := 0; i < len(rest); i++ {
   782			if rest[i] == "--baseline" {
   783				if i+1 >= len(rest) {
   784					fmt.Fprintln(os.Stderr, "error: audit requires --baseline <baseline_path>")
   785					return 1
   786				}
   787				baselinePath = rest[i+1]
   788				i++
   789			} else if strings.HasPrefix(rest[i], "--baseline=") {
   790				baselinePath = rest[i][len("--baseline="):]
   791			} else {
   792				fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", rest[i])
   793				return 1
   794			}
   795		}
   796	
   797		if baselinePath == "" {
   798			fmt.Fprintln(os.Stderr, "error: audit requires --baseline <baseline_path>")
   799			return 1
   800		}
   801	
   802		m, dir, err := loadManifest(manifestPath)
   803		if err != nil {
   804			fmt.Fprintln(os.Stderr, err)
   805			return 1
   806		}
   807		if err := validateManifest(m, dir); err != nil {
   808			fmt.Fprintln(os.Stderr, err)
   809			return 1
   810		}
   811	
   812		results, err := runBuild(m, dir)
   813		if err != nil {
   814			if errors.Is(err, errBuildFailed) {
   815				return 1
   816			}
   817			fmt.Fprintln(os.Stderr, err)
   818			return 1
   819		}
   820	
   821		data, err := os.ReadFile(baselinePath)
   822		if err != nil {
   823			if os.IsNotExist(err) {
   824				fmt.Fprintf(os.Stderr, "error: baseline not found: %s\n", baselinePath)
   825				return 1
   826			}
   827			fmt.Fprintf(os.Stderr, "error: invalid baseline: %v\n", err)
   828			return 1
   829		}
   830	
   831		var baseline struct {
   832			Targets map[string]struct {
   833				Fingerprint string `json:"fingerprint"`
   834				OutputHash  string `json:"output_hash"`
   835			} `json:"targets"`
   836		}
   837		if err := json.Unmarshal(data, &baseline); err != nil {
   838			fmt.Fprintf(os.Stderr, "error: invalid baseline: %v\n", err)
   839			return 1
   840		}
   841	
   842		type targetJSON struct {
   843			Name                string `json:"name"`
   844			BaselineFingerprint string `json:"baseline_fingerprint"`
   845			CurrentFingerprint  string `json:"current_fingerprint"`
   846			FingerprintMatch    bool   `json:"fingerprint_match"`
   847			BaselineOutputHash  string `json:"baseline_output_hash"`
   848			CurrentOutputHash   string `json:"current_output_hash"`
   849			OutputMatch         bool   `json:"output_match"`
   850		}
   851	
   852		targets := make([]targetJSON, 0, len(results))
   853		matches := true
   854		for _, r := range results {
   855			var bf, bo string
   856			entry, ok := baseline.Targets[r.Target.Name]
   857			if ok {
   858				bf = entry.Fingerprint
   859				bo = entry.OutputHash
   860			}
   861			fpMatch := ok && bf == r.Fingerprint
   862			outMatch := ok && bo == r.OutputHash
   863			if !fpMatch || !outMatch {
   864				matches = false
   865			}
   866			targets = append(targets, targetJSON{
   867				Name:                r.Target.Name,
   868				BaselineFingerprint: bf,
   869				CurrentFingerprint:  r.Fingerprint,
   870				FingerprintMatch:    fpMatch,
   871				BaselineOutputHash:  bo,
   872				CurrentOutputHash:   r.OutputHash,
   873				OutputMatch:         outMatch,
   874			})
   875		}
   876	
   877		printJSON(struct {
   878			Matches bool         `json:"matches"`
   879			Targets []targetJSON `json:"targets"`
   880		}{
   881			Matches: matches,
   882			Targets: targets,
   883		})
   884		return 0
   885	}
