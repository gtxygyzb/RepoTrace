   112	func validateManifest(m *Manifest, manifestDir string) error {
   113		names := make(map[string]bool)
   114		for _, t := range m.Targets {
   115			if names[t.Name] {
   116				return fmt.Errorf("error: duplicate target name: '%s'", t.Name)
   117			}
   118			names[t.Name] = true
   119		}
   120	
   121		byName := make(map[string]*Target)
   122		for _, t := range m.Targets {
   123			byName[t.Name] = t
   124		}
   125	
   126		for _, t := range m.Targets {
   127			for _, dep := range t.Deps {
   128				if _, ok := byName[dep]; !ok {
   129					return fmt.Errorf("error: target '%s' depends on unknown target '%s'", t.Name, dep)
   130				}
   131			}
   132		}
   133	
   134		for _, t := range m.Targets {
   135			for _, src := range t.Sources {
   136				p := resolvePath(src, manifestDir)
   137				if _, err := os.Stat(p); err != nil {
   138					return fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
   139				}
   140			}
   141		}
   142	
   143		if _, err := topologicalOrder(m); err != nil {
   144			return err
   145		}
   146		return nil
   147	}
   148	
   149	func indexString(s []string, v string) int {
   150		for i, x := range s {
   151			if x == v {
   152				return i
   153			}
   154		}
   155		return -1
   156	}
   157	
   158	func topologicalOrder(m *Manifest) ([]*Target, error) {
   159		byName := make(map[string]*Target)
   160		for _, t := range m.Targets {
   161			byName[t.Name] = t
   162		}
   163	
   164		state := make(map[string]int)
   165		var path []string
   166		var order []*Target
   167	
   168		var dfs func(t *Target) error
   169		dfs = func(t *Target) error {
   170			state[t.Name] = 1
   171			path = append(path, t.Name)
   172	
   173			for _, dep := range t.Deps {
   174				d, ok := byName[dep]
   175				if !ok {
   176					return fmt.Errorf("error: target '%s' depends on unknown target '%s'", t.Name, dep)
   177				}
   178				if state[dep] == 1 {
   179					idx := indexString(path, dep)
   180					if idx < 0 {
   181						idx = 0
   182					}
   183					cycle := append([]string{}, path[idx:]...)
   184					cycle = append(cycle, dep)
   185					return fmt.Errorf("error: dependency cycle detected: %s", strings.Join(cycle, " -> "))
   186				}
   187				if state[dep] == 0 {
   188					if err := dfs(d); err != nil {
   189						return err
   190					}
   191				}
   192			}
   193	
   194			path = path[:len(path)-1]
   195			state[t.Name] = 2
   196			order = append(order, t)
   197			return nil
   198		}
   199	
   200		for _, t := range m.Targets {
   201			if state[t.Name] == 0 {
   202				if err := dfs(t); err != nil {
   203					return nil, err
   204				}
   205			}
   206		}
   207	
   208		return order, nil
   209	}
