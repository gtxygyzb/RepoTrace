	for _, t := range order {
		fp, err := computeFingerprint(t, manifestDir, depHashes)
		if err != nil {
			return nil, err
		}

		metaPath := filepath.Join(m.StoreRoot, "objects", fp[:2], fp, "metadata.json")
		if _, err := os.Stat(metaPath); err == nil {
			meta, err := readMetadata(metaPath)
			if err != nil {
				return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
			}
			hash, err := decodeHash(meta.OutputHash)
			if err != nil {
