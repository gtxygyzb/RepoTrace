   292	func copyFile(src, dst string) error {
   293		in, err := os.Open(src)
   294		if err != nil {
   295			return err
   296		}
   297		defer in.Close()
   298	
   299		if err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {
   300			return err
   301		}
   302	
   303		out, err := os.Create(dst)
   304		if err != nil {
   305			return err
   306		}
   307		if _, err := io.Copy(out, in); err != nil {
   308			out.Close()
   309			return err
   310		}
   311		return out.Close()
   312	}
