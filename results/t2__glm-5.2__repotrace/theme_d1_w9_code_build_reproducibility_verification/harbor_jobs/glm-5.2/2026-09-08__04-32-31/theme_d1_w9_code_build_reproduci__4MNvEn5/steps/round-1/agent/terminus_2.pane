  1158		data, err := os.ReadFile(path)
  1159		if err != nil {
  1160			return "", err
  1161		}
  1162		sum := sha256.Sum256(data)
  1163		return hex.EncodeToString(sum[:]), nil
  1164	}
  1165	
  1166	func sourceHashesForTarget(t *Target, manifestDir string) (map[string]string, error) {
  1167		hashes := make(map[string]string, len(t.Sources))
  1168		for _, src := range t.Sources {
  1169			p := resolvePath(src, manifestDir)
  1170			h, err := sha256File(p)
  1171			if err != nil {
  1172				return nil, fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
  1173			}
  1174			hashes[src] = h
  1175		}
  1176		return hashes, nil
  1177	}
  1178	
  1179	func envValuesForTarget(t *Target) map[string]string {
  1180		vals := make(map[string]string, len(t.EnvCapture))
  1181		for _, e := range t.EnvCapture {
  1182			vals[e] = os.Getenv(e)
  1183		}
  1184		return vals
  1185	}
  1186	
  1187	func depFingerprintsForTarget(results []buildResult, resultsByName map[string]buildResult, t *Target) map[string]string {
  1188		deps := make(map[string]string, len(t.Deps))
  1189		for _, d := range t.Deps {
  1190			if r, ok := resultsByName[d]; ok {
  1191				deps[d] = r.Fingerprint
  1192			}
  1193		}
  1194		return deps
  1195	}
