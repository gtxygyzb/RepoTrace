   779	func clearStoreObjects(storeRoot string) error {
   780		return os.RemoveAll(filepath.Join(storeRoot, "objects"))
   781	}
   782	
   783	func artifactPath(storeRoot, fingerprint string) string {
   784		return filepath.Join(storeRoot, "objects", fingerprint[:2], fingerprint, "artifact")
   785	}
   786	
   787	func artifactSize(storeRoot, fingerprint string) (int64, error) {
   788		info, err := os.Stat(artifactPath(storeRoot, fingerprint))
   789		if err != nil {
   790			return 0, err
   791		}
   792		return info.Size(), nil
   793	}
   794	
   795	func computeChainHash(results []buildResult) string {
   796		h := sha256.New()
   797		for _, r := range results {
   798			h.Write([]byte(r.Fingerprint))
   799		}
   800		return hex.EncodeToString(h.Sum(nil))
   801	}
