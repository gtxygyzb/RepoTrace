[?2004lpackage main

import (
	"bytes"
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"os"
	"os/exec"
	"path/filepath"
	"sort"
	"strings"
	"time"
)

type Manifest struct {
	StoreRoot string    `json:"store_root"`
	Targets   []*Target `json:"targets"`
}

type Target struct {
	Name       string   `json:"name"`
	Sources    []string `json:"sources"`
	Compiler   string   `json:"compiler"`
	Flags      []string `json:"flags"`
	Output     string   `json:"output"`
	Deps       []string `json:"deps"`
	EnvCapture []string `json:"env_capture"`
}

type StoredMetadata struct {
	Name           string   `json:"name"`
	Fingerprint    string   `json:"fingerprint"`
	OutputHash     string   `json:"output_hash"`
	Compiler       string   `json:"compiler"`
	Flags          []string `json:"flags"`
	Sources        []string `json:"sources"`
	BuildTimestamp string   `json:"build_timestamp"`
}

type buildResult struct {
	Target      *Target
	Fingerprint string
	OutputHash  string
	Cached      bool
}

var errBuildFailed = errors.New("build failed")

func resolvePath(p, base string) string {
	if p == "" {
		return filepath.Clean(base)
	}
	if filepath.IsAbs(p) {
		return filepath.Clean(p)
	}
	return filepath.Clean(filepath.Join(base, p))
}

func normalizeTarget(t *Target) {
	if t.Sources == nil {
		t.Sources = []string{}
	}
	if t.Flags == nil {
		t.Flags = []string{}
	}
	if t.Deps == nil {
		t.Deps = []string{}
	}
	if t.EnvCapture == nil {
		t.EnvCapture = []string{}
	}
}

func loadManifest(path string) (*Manifest, string, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		if os.IsNotExist(err) {
			return nil, "", fmt.Errorf("error: manifest not found: %s", path)
		}
		return nil, "", fmt.Errorf("error: invalid manifest: %v", err)
	}

	var m Manifest
	if err := json.Unmarshal(data, &m); err != nil {
		return nil, "", fmt.Errorf("error: invalid manifest: %v", err)
	}

	manifestDir, err := filepath.Abs(filepath.Dir(path))
	if err != nil {
		return nil, "", fmt.Errorf("error: invalid manifest: %v", err)
	}

	if m.StoreRoot == "" {
		m.StoreRoot = "artifact_store"
	}
	m.StoreRoot = resolvePath(m.StoreRoot, manifestDir)

	for _, t := range m.Targets {
		if t == nil {
			return nil, "", fmt.Errorf("error: invalid manifest: target is null")
		}
		normalizeTarget(t)
	}

	return &m, manifestDir, nil
}

func validateManifest(m *Manifest, manifestDir string) error {
	names := make(map[string]bool)
	for _, t := range m.Targets {
		if names[t.Name] {
			return fmt.Errorf("error: duplicate target name: '%s'", t.Name)
		}
		names[t.Name] = true
	}

	byName := make(map[string]*Target)
	for _, t := range m.Targets {
		byName[t.Name] = t
	}

	for _, t := range m.Targets {
		for _, dep := range t.Deps {
			if _, ok := byName[dep]; !ok {
				return fmt.Errorf("error: target '%s' depends on unknown target '%s'", t.Name, dep)
			}
		}
	}

	for _, t := range m.Targets {
		for _, src := range t.Sources {
			p := resolvePath(src, manifestDir)
			if _, err := os.Stat(p); err != nil {
				return fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
			}
		}
	}

	if _, err := topologicalOrder(m); err != nil {
		return err
	}
	return nil
}

func indexString(s []string, v string) int {
	for i, x := range s {
		if x == v {
			return i
		}
	}
	return -1
}

func topologicalOrder(m *Manifest) ([]*Target, error) {
	byName := make(map[string]*Target)
	for _, t := range m.Targets {
		byName[t.Name] = t
	}

	state := make(map[string]int)
	var path []string
	var order []*Target

	var dfs func(t *Target) error
	dfs = func(t *Target) error {
		state[t.Name] = 1
		path = append(path, t.Name)

		for _, dep := range t.Deps {
			d, ok := byName[dep]
			if !ok {
				return fmt.Errorf("error: target '%s' depends on unknown target '%s'", t.Name, dep)
			}
			if state[dep] == 1 {
				idx := indexString(path, dep)
				if idx < 0 {
					idx = 0
				}
				cycle := append([]string{}, path[idx:]...)
				cycle = append(cycle, dep)
				return fmt.Errorf("error: dependency cycle detected: %s", strings.Join(cycle, " -> "))
			}
			if state[dep] == 0 {
				if err := dfs(d); err != nil {
					return err
				}
			}
		}

		path = path[:len(path)-1]
		state[t.Name] = 2
		order = append(order, t)
		return nil
	}

	for _, t := range m.Targets {
		if state[t.Name] == 0 {
			if err := dfs(t); err != nil {
				return nil, err
			}
		}
	}

	return order, nil
}

func transitiveDeps(t *Target, byName map[string]*Target) []string {
	seen := make(map[string]bool)
	var visit func(name string)
	visit = func(name string) {
		dep, ok := byName[name]
		if !ok {
			return
		}
		for _, d := range dep.Deps {
			if !seen[d] {
[?2004hroot@n30009:/app# sed -n '220,520p' main.go
[?2004l			if !seen[d] {
				seen[d] = true
				visit(d)
			}
		}
	}
	visit(t.Name)

	res := make([]string, 0, len(seen))
	for k := range seen {
		res = append(res, k)
	}
	sort.Strings(res)
	return res
}

func decodeHash(s string) ([]byte, error) {
	b, err := hex.DecodeString(s)
	if err != nil {
		return nil, fmt.Errorf("invalid output hash: %v", err)
	}
	if len(b) != 32 {
		return nil, fmt.Errorf("invalid output hash length")
	}
	return b, nil
}

func computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {
	h := sha256.New()

	srcs := append([]string{}, t.Sources...)
	sort.Strings(srcs)
	for _, src := range srcs {
		p := resolvePath(src, manifestDir)
		data, err := os.ReadFile(p)
		if err != nil {
			return "", fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
		}
		h.Write(data)
	}

	h.Write([]byte(t.Compiler))

	flags := append([]string{}, t.Flags...)
	sort.Strings(flags)
	for _, f := range flags {
		h.Write([]byte(f))
		h.Write([]byte("\n"))
	}

	envs := append([]string{}, t.EnvCapture...)
	sort.Strings(envs)
	for _, e := range envs {
		h.Write([]byte(e + "=" + os.Getenv(e) + "\n"))
	}

	deps := append([]string{}, t.Deps...)
	sort.Strings(deps)
	for _, d := range deps {
		hash, ok := depHashes[d]
		if !ok {
			return "", fmt.Errorf("error: missing output hash for dependency '%s' (target '%s')", d, t.Name)
		}
		if len(hash) != 32 {
			return "", fmt.Errorf("error: invalid output hash for dependency '%s' (target '%s')", d, t.Name)
		}
		h.Write(hash)
	}

	return hex.EncodeToString(h.Sum(nil)), nil
}

func copyFile(src, dst string) error {
	in, err := os.Open(src)
	if err != nil {
		return err
	}
	defer in.Close()

	if err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {
		return err
	}

	out, err := os.Create(dst)
	if err != nil {
		return err
	}
	if _, err := io.Copy(out, in); err != nil {
		out.Close()
		return err
	}
	return out.Close()
}

func storeArtifact(t *Target, storeRoot, fingerprint, outputHashHex, artifactPath string) error {
	dir := filepath.Join(storeRoot, "objects", fingerprint[:2], fingerprint)
	if err := os.MkdirAll(dir, 0o755); err != nil {
		return err
	}

	artifactDst := filepath.Join(dir, "artifact")
	if err := copyFile(artifactPath, artifactDst); err != nil {
		return err
	}

	meta := StoredMetadata{
		Name:           t.Name,
		Fingerprint:    fingerprint,
		OutputHash:     outputHashHex,
		Compiler:       t.Compiler,
		Flags:          t.Flags,
		Sources:        t.Sources,
		BuildTimestamp: time.Now().UTC().Format(time.RFC3339),
	}
	data, err := jsonBytes(meta)
	if err != nil {
		return err
	}
	return os.WriteFile(filepath.Join(dir, "metadata.json"), data, 0o644)
}

func readMetadata(path string) (*StoredMetadata, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	var meta StoredMetadata
	if err := json.Unmarshal(data, &meta); err != nil {
		return nil, err
	}
	if _, err := decodeHash(meta.OutputHash); err != nil {
		return nil, err
	}
	return &meta, nil
}

func compileTargetInDir(t *Target, sourceDir string) (scratchDir, outputPath, outputHash string, err error) {
	scratchDir, err = os.MkdirTemp("", "buildvault-build-*")
	if err != nil {
		return "", "", "", err
	}

	outputPath = filepath.Join(scratchDir, "out", t.Output)
	if err := os.MkdirAll(filepath.Dir(outputPath), 0o755); err != nil {
		return scratchDir, "", "", err
	}

	args := make([]string, 0, len(t.Flags)+len(t.Sources)+2)
	args = append(args, t.Flags...)
	args = append(args, "-o", outputPath)
	for _, src := range t.Sources {
		args = append(args, resolvePath(src, sourceDir))
	}

	cmd := exec.Command(t.Compiler, args...)
	cmd.Dir = sourceDir
	out, err := cmd.CombinedOutput()
	if err != nil {
		detail := strings.TrimSpace(string(out))
		if detail == "" {
			detail = err.Error()
		}
		return scratchDir, "", "", errors.New(detail)
	}

	data, err := os.ReadFile(outputPath)
	if err != nil {
		return scratchDir, "", "", fmt.Errorf("output artifact not found: %v", err)
	}
	sum := sha256.Sum256(data)
	outputHash = hex.EncodeToString(sum[:])
	return scratchDir, outputPath, outputHash, nil
}

func buildAndStoreTarget(t *Target, sourceDir, storeRoot, fingerprint string) (string, error) {
	scratch, outputPath, outHash, err := compileTargetInDir(t, sourceDir)
	if scratch != "" {
		defer os.RemoveAll(scratch)
	}
	if err != nil {
		return "", err
	}
	if err := storeArtifact(t, storeRoot, fingerprint, outHash, outputPath); err != nil {
		return "", err
	}
	return outHash, nil
}

func compileFresh(t *Target, sourceDir string) (string, error) {
	scratch, _, outHash, err := compileTargetInDir(t, sourceDir)
	if scratch != "" {
		defer os.RemoveAll(scratch)
	}
	return outHash, err
}

func runBuild(m *Manifest, manifestDir string) ([]buildResult, error) {
	order, err := topologicalOrder(m)
	if err != nil {
		return nil, err
	}

	depHashes := make(map[string][]byte)
	results := make([]buildResult, 0, len(order))

	for _, t := range order {
		fp, err := computeFingerprint(t, manifestDir, depHashes)
		if err != nil {
			return nil, err
		}

		metaPath := filepath.Join(m.StoreRoot, "objects", fp[:2], fp, "metadata.json")
		if _, err := os.Stat(metaPath); err == nil {
			meta, err := readMetadata(metaPath)
			if err != nil {
				return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
			}
			hash, err := decodeHash(meta.OutputHash)
			if err != nil {
				return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
			}
			fmt.Fprintf(os.Stderr, "[cache hit] %s\n", t.Name)
			depHashes[t.Name] = hash
			results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: meta.OutputHash, Cached: true})
			continue
		}

		fmt.Fprintf(os.Stderr, "[building] %s\n", t.Name)
		outHash, err := buildAndStoreTarget(t, manifestDir, m.StoreRoot, fp)
		if err != nil {
			fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
			return nil, errBuildFailed
		}
		fmt.Fprintf(os.Stderr, "[stored] %s %s\n", t.Name, fp)

		hash, err := decodeHash(outHash)
		if err != nil {
			return nil, err
		}
		depHashes[t.Name] = hash
		results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: outHash, Cached: false})
	}

	return results, nil
}

func copySources(m *Manifest, manifestDir string) (string, error) {
	tempDir, err := os.MkdirTemp("", "buildvault-verify-*")
	if err != nil {
		return "", err
	}

	for _, t := range m.Targets {
		for _, src := range t.Sources {
			srcAbs := resolvePath(src, manifestDir)
			dst := filepath.Join(tempDir, filepath.Clean(src))
			if err := copyFile(srcAbs, dst); err != nil {
				os.RemoveAll(tempDir)
				return "", err
			}
		}
	}

	return tempDir, nil
}

func dirSize(path string) int64 {
	var size int64
	filepath.Walk(path, func(_ string, info os.FileInfo, err error) error {
		if err != nil {
			return nil
		}
		if !info.IsDir() {
			size += info.Size()
		}
		return nil
	})
	return size
}

func gcStore(storeRoot string, referenced map[string]bool) (int, int, int64) {
	objectsDir := filepath.Join(storeRoot, "objects")
	entries, err := os.ReadDir(objectsDir)
	if err != nil {
		return 0, 0, 0
	}

	removed := 0
	retained := 0
	var freed int64

	for _, prefixEntry := range entries {
		if !prefixEntry.IsDir() {
			continue
		}
		prefixPath := filepath.Join(objectsDir, prefixEntry.Name())
		fps, err := os.ReadDir(prefixPath)
		if err != nil {
			continue
		}
		for _, fpEntry := range fps {
[?2004hroot@n30009:/app# sed -n '520,860p' main.go
[?2004l		for _, fpEntry := range fps {
			if !fpEntry.IsDir() {
				continue
			}
			fp := fpEntry.Name()
			fpDir := filepath.Join(prefixPath, fp)
			if referenced[fp] {
				retained++
				continue
			}
			size := dirSize(fpDir)
			if err := os.RemoveAll(fpDir); err != nil {
				continue
			}
			removed++
			freed += size
		}
	}

	return removed, retained, freed
}

func jsonBytes(v interface{}) ([]byte, error) {
	var buf bytes.Buffer
	enc := json.NewEncoder(&buf)
	enc.SetEscapeHTML(false)
	if err := enc.Encode(v); err != nil {
		return nil, err
	}
	return bytes.TrimRight(buf.Bytes(), "\n"), nil
}

func printJSON(v interface{}) {
	data, err := jsonBytes(v)
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		os.Exit(1)
	}
	fmt.Println(string(data))
}

func cmdBuild(args []string) int {
	if len(args) != 1 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault build <manifest_path>")
		return 1
	}

	m, dir, err := loadManifest(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	results, err := runBuild(m, dir)
	if err != nil {
		if errors.Is(err, errBuildFailed) {
			return 1
		}
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	type targetJSON struct {
		Name        string `json:"name"`
		Fingerprint string `json:"fingerprint"`
		OutputHash  string `json:"output_hash"`
		Cached      bool   `json:"cached"`
	}
	targets := make([]targetJSON, 0, len(results))
	for _, r := range results {
		targets = append(targets, targetJSON{
			Name:        r.Target.Name,
			Fingerprint: r.Fingerprint,
			OutputHash:  r.OutputHash,
			Cached:      r.Cached,
		})
	}

	printJSON(struct {
		Targets   []targetJSON `json:"targets"`
		StoreRoot string       `json:"store_root"`
	}{
		Targets:   targets,
		StoreRoot: m.StoreRoot,
	})
	return 0
}

func cmdVerify(args []string) int {
	if len(args) != 1 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault verify <manifest_path>")
		return 1
	}

	m, dir, err := loadManifest(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	order, err := topologicalOrder(m)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	firstDir, err := copySources(m, dir)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	defer os.RemoveAll(firstDir)

	secondDir, err := copySources(m, dir)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	defer os.RemoveAll(secondDir)

	firstHashes := make(map[string]string)
	for _, t := range order {
		h, err := compileFresh(t, firstDir)
		if err != nil {
			fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
			return 1
		}
		firstHashes[t.Name] = h
	}

	secondHashes := make(map[string]string)
	for _, t := range order {
		h, err := compileFresh(t, secondDir)
		if err != nil {
			fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
			return 1
		}
		secondHashes[t.Name] = h
	}

	type targetJSON struct {
		Name         string `json:"name"`
		FirstHash    string `json:"first_hash"`
		SecondHash   string `json:"second_hash"`
		Reproducible bool   `json:"reproducible"`
	}

	targets := make([]targetJSON, 0, len(order))
	reproducible := true
	for _, t := range order {
		ok := firstHashes[t.Name] == secondHashes[t.Name]
		if !ok {
			reproducible = false
		}
		targets = append(targets, targetJSON{
			Name:         t.Name,
			FirstHash:    firstHashes[t.Name],
			SecondHash:   secondHashes[t.Name],
			Reproducible: ok,
		})
	}

	printJSON(struct {
		Reproducible bool         `json:"reproducible"`
		Targets      []targetJSON `json:"targets"`
	}{
		Reproducible: reproducible,
		Targets:      targets,
	})
	return 0
}

func cmdInspect(args []string) int {
	if len(args) != 1 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault inspect <manifest_path>")
		return 1
	}

	m, dir, err := loadManifest(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	order, err := topologicalOrder(m)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	byName := make(map[string]*Target)
	for _, t := range m.Targets {
		byName[t.Name] = t
	}

	depHashes := make(map[string][]byte)
	for _, t := range m.Targets {
		depHashes[t.Name] = make([]byte, 32)
	}

	type targetJSON struct {
		Name           string   `json:"name"`
		Sources        []string `json:"sources"`
		Deps           []string `json:"deps"`
		TransitiveDeps []string `json:"transitive_deps"`
		Fingerprint    string   `json:"fingerprint"`
	}

	targets := make([]targetJSON, 0, len(order))
	for _, t := range order {
		fp, err := computeFingerprint(t, dir, depHashes)
		if err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 1
		}
		targets = append(targets, targetJSON{
			Name:           t.Name,
			Sources:        t.Sources,
			Deps:           t.Deps,
			TransitiveDeps: transitiveDeps(t, byName),
			Fingerprint:    fp,
		})
	}

	buildOrder := make([]string, 0, len(order))
	for _, t := range order {
		buildOrder = append(buildOrder, t.Name)
	}

	printJSON(struct {
		Targets    []targetJSON `json:"targets"`
		BuildOrder []string     `json:"build_order"`
	}{
		Targets:    targets,
		BuildOrder: buildOrder,
	})
	return 0
}

func cmdAudit(args []string) int {
	if len(args) < 1 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault audit <manifest_path> --baseline <baseline_path>")
		return 1
	}

	manifestPath := args[0]
	rest := args[1:]
	baselinePath := ""

	for i := 0; i < len(rest); i++ {
		if rest[i] == "--baseline" {
			if i+1 >= len(rest) {
				fmt.Fprintln(os.Stderr, "error: audit requires --baseline <baseline_path>")
				return 1
			}
			baselinePath = rest[i+1]
			i++
		} else if strings.HasPrefix(rest[i], "--baseline=") {
			baselinePath = rest[i][len("--baseline="):]
		} else {
			fmt.Fprintf(os.Stderr, "error: unexpected argument: %s\n", rest[i])
			return 1
		}
	}

	if baselinePath == "" {
		fmt.Fprintln(os.Stderr, "error: audit requires --baseline <baseline_path>")
		return 1
	}

	m, dir, err := loadManifest(manifestPath)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	results, err := runBuild(m, dir)
	if err != nil {
		if errors.Is(err, errBuildFailed) {
			return 1
		}
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	data, err := os.ReadFile(baselinePath)
	if err != nil {
		if os.IsNotExist(err) {
			fmt.Fprintf(os.Stderr, "error: baseline not found: %s\n", baselinePath)
			return 1
		}
		fmt.Fprintf(os.Stderr, "error: invalid baseline: %v\n", err)
		return 1
	}

	var baseline struct {
		Targets map[string]struct {
			Fingerprint string `json:"fingerprint"`
			OutputHash  string `json:"output_hash"`
		} `json:"targets"`
	}
	if err := json.Unmarshal(data, &baseline); err != nil {
		fmt.Fprintf(os.Stderr, "error: invalid baseline: %v\n", err)
		return 1
	}

	type targetJSON struct {
		Name                string `json:"name"`
		BaselineFingerprint string `json:"baseline_fingerprint"`
		CurrentFingerprint  string `json:"current_fingerprint"`
		FingerprintMatch    bool   `json:"fingerprint_match"`
		BaselineOutputHash  string `json:"baseline_output_hash"`
		CurrentOutputHash   string `json:"current_output_hash"`
		OutputMatch         bool   `json:"output_match"`
	}

	targets := make([]targetJSON, 0, len(results))
	matches := true
	for _, r := range results {
		var bf, bo string
		entry, ok := baseline.Targets[r.Target.Name]
		if ok {
			bf = entry.Fingerprint
			bo = entry.OutputHash
		}
[?2004hroot@n30009:/app# sed -n '860,1200p' main.go
[?2004l		}
		fpMatch := ok && bf == r.Fingerprint
		outMatch := ok && bo == r.OutputHash
		if !fpMatch || !outMatch {
			matches = false
		}
		targets = append(targets, targetJSON{
			Name:                r.Target.Name,
			BaselineFingerprint: bf,
			CurrentFingerprint:  r.Fingerprint,
			FingerprintMatch:    fpMatch,
			BaselineOutputHash:  bo,
			CurrentOutputHash:   r.OutputHash,
			OutputMatch:         outMatch,
		})
	}

	printJSON(struct {
		Matches bool         `json:"matches"`
		Targets []targetJSON `json:"targets"`
	}{
		Matches: matches,
		Targets: targets,
	})
	return 0
}

func cmdGC(args []string) int {
	if len(args) != 3 || args[0] != "--manifest" {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault gc --manifest <manifest_path> <store_root>")
		return 1
	}

	manifestPath := args[1]
	storeRootArg := args[2]

	m, dir, err := loadManifest(manifestPath)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	absStore, err := filepath.Abs(storeRootArg)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	m.StoreRoot = absStore

	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	results, err := runBuild(m, dir)
	if err != nil {
		if errors.Is(err, errBuildFailed) {
			return 1
		}
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	referenced := make(map[string]bool)
	for _, r := range results {
		referenced[r.Fingerprint] = true
	}

	removed, retained, freed := gcStore(m.StoreRoot, referenced)
	printJSON(struct {
		Removed    int   `json:"removed"`
		Retained   int   `json:"retained"`
		FreedBytes int64 `json:"freed_bytes"`
	}{
		Removed:    removed,
		Retained:   retained,
		FreedBytes: freed,
	})
	return 0
}

type lockfileTarget struct {
	Fingerprint     string            `json:"fingerprint"`
	OutputHash      string            `json:"output_hash"`
	SourceHashes    map[string]string `json:"source_hashes"`
	DepFingerprints map[string]string `json:"dep_fingerprints"`
	EnvValues       map[string]string `json:"env_values"`
	Compiler        string            `json:"compiler"`
	Flags           []string          `json:"flags"`
}

type lockfile struct {
	Version int                       `json:"version"`
	Created string                    `json:"created"`
	Targets map[string]lockfileTarget `json:"targets"`
}

func sha256File(path string) (string, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return "", err
	}
	sum := sha256.Sum256(data)
	return hex.EncodeToString(sum[:]), nil
}

func sourceHashesForTarget(t *Target, manifestDir string) (map[string]string, error) {
	hashes := make(map[string]string, len(t.Sources))
	for _, src := range t.Sources {
		p := resolvePath(src, manifestDir)
		h, err := sha256File(p)
		if err != nil {
			return nil, fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
		}
		hashes[src] = h
	}
	return hashes, nil
}

func envValuesForTarget(t *Target) map[string]string {
	vals := make(map[string]string, len(t.EnvCapture))
	for _, e := range t.EnvCapture {
		vals[e] = os.Getenv(e)
	}
	return vals
}

func depFingerprintsForTarget(results []buildResult, resultsByName map[string]buildResult, t *Target) map[string]string {
	deps := make(map[string]string, len(t.Deps))
	for _, d := range t.Deps {
		if r, ok := resultsByName[d]; ok {
			deps[d] = r.Fingerprint
		}
	}
	return deps
}

func readLockfile(path string) (*lockfile, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		if os.IsNotExist(err) {
			return nil, fmt.Errorf("error: lockfile not found: %s", path)
		}
		return nil, fmt.Errorf("error: lockfile not found: %s", path)
	}
	var lf lockfile
	if err := json.Unmarshal(data, &lf); err != nil {
		return nil, fmt.Errorf("error: invalid lockfile: %v", err)
	}
	if lf.Targets == nil {
		lf.Targets = map[string]lockfileTarget{}
	}
	for name, tt := range lf.Targets {
		if tt.SourceHashes == nil {
			tt.SourceHashes = map[string]string{}
			lf.Targets[name] = tt
		}
		if tt.DepFingerprints == nil {
			tt.DepFingerprints = map[string]string{}
			lf.Targets[name] = tt
		}
		if tt.EnvValues == nil {
			tt.EnvValues = map[string]string{}
			lf.Targets[name] = tt
		}
		if tt.Flags == nil {
			tt.Flags = []string{}
			lf.Targets[name] = tt
		}
	}
	return &lf, nil
}

func sortedKeys(m map[string]string) []string {
	res := make([]string, 0, len(m))
	for k := range m {
		res = append(res, k)
	}
	sort.Strings(res)
	return res
}

func flagsEqual(a, b []string) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func mapEqual(a, b map[string]string) bool {
	if len(a) != len(b) {
		return false
	}
	for k, v := range a {
		if bv, ok := b[k]; !ok || bv != v {
			return false
		}
	}
	return true
}

func changeReasons(currentCompiler, lockCompiler string, currentFlags, lockFlags []string, currentSources, lockSources map[string]string, currentDeps, lockDeps map[string]string, currentEnv, lockEnv map[string]string) []string {
	reasons := []string{}
	if currentCompiler != lockCompiler {
		reasons = append(reasons, "compiler_changed")
	}
	if !flagsEqual(currentFlags, lockFlags) {
		reasons = append(reasons, "flags_changed")
	}
	if !mapEqual(currentSources, lockSources) {
		reasons = append(reasons, "source_changed")
	}
	if !mapEqual(currentDeps, lockDeps) {
		reasons = append(reasons, "dep_changed")
	}
	if !mapEqual(currentEnv, lockEnv) {
		reasons = append(reasons, "env_changed")
	}
	sort.Strings(reasons)
	return reasons
}

func transitiveDepsFromLock(lf *lockfile, target string) []string {
	seen := make(map[string]bool)
	var visit func(name string)
	visit = func(name string) {
		t, ok := lf.Targets[name]
		if !ok {
			return
		}
		for dep := range t.DepFingerprints {
			if !seen[dep] {
				seen[dep] = true
				visit(dep)
			}
		}
	}
	visit(target)
	res := make([]string, 0, len(seen))
	for k := range seen {
		res = append(res, k)
	}
	sort.Strings(res)
	return res
}

func transitiveDepsFromManifest(m *Manifest, target string) []string {
	byName := make(map[string]*Target)
	for _, t := range m.Targets {
		byName[t.Name] = t
	}
	seen := make(map[string]bool)
	var visit func(name string)
	visit = func(name string) {
		t, ok := byName[name]
		if !ok {
			return
		}
		for _, d := range t.Deps {
			if !seen[d] {
				seen[d] = true
				visit(d)
			}
		}
	}
	visit(target)
	res := make([]string, 0, len(seen))
	for k := range seen {
		res = append(res, k)
	}
	sort.Strings(res)
	return res
}

func impactedByForLockDiff(lfA, lfB *lockfile, target string) []string {
	trans := transitiveDepsFromLock(lfB, target)
	res := []string{}
	for _, dep := range trans {
		ta, oka := lfA.Targets[dep]
		tbDep, okb := lfB.Targets[dep]
		if !oka || !okb || ta.Fingerprint != tbDep.Fingerprint {
			res = append(res, dep)
		}
	}
	sort.Strings(res)
	return res
}

func cmdLock(args []string) int {
	if len(args) != 1 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault lock <manifest_path>")
		return 1
	}

	m, dir, err := loadManifest(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	results, err := runBuild(m, dir)
	if err != nil {
		if errors.Is(err, errBuildFailed) {
			return 1
		}
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	resultsByName := make(map[string]buildResult, len(results))
	for _, r := range results {
		resultsByName[r.Target.Name] = r
	}

	targets := make(map[string]lockfileTarget, len(results))
	for _, r := range results {
		t := r.Target
		srcHashes, err := sourceHashesForTarget(t, dir)
		if err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 1
		}
		targets[t.Name] = lockfileTarget{
			Fingerprint:     r.Fingerprint,
			OutputHash:      r.OutputHash,
			SourceHashes:    srcHashes,
			DepFingerprints: depFingerprintsForTarget(results, resultsByName, t),
			EnvValues:       envValuesForTarget(t),
			Compiler:        t.Compiler,
			Flags:           t.Flags,
		}
	}
[?2004hroot@n30009:/app# sed -n '1200,1426p' main.go
[?2004l	}

	lf := lockfile{
		Version: 1,
		Created: time.Now().UTC().Format(time.RFC3339),
		Targets: targets,
	}
	printJSON(lf)
	return 0
}

func cmdCheck(args []string) int {
	if len(args) != 3 || args[1] != "--lockfile" {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault check <manifest_path> --lockfile <lockfile_path>")
		return 1
	}

	manifestPath := args[0]
	lockfilePath := args[2]

	lf, err := readLockfile(lockfilePath)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	m, dir, err := loadManifest(manifestPath)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	results, err := runBuild(m, dir)
	if err != nil {
		if errors.Is(err, errBuildFailed) {
			return 1
		}
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	resultsByName := make(map[string]buildResult, len(results))
	for _, r := range results {
		resultsByName[r.Target.Name] = r
	}

	type targetResult struct {
		Name             string   `json:"name"`
		FingerprintMatch bool     `json:"fingerprint_match"`
		OutputMatch      bool     `json:"output_match"`
		ChangeReasons    []string `json:"change_reasons"`
		ImpactedBy       []string `json:"impacted_by"`
	}

	allMatch := true
	targets := make([]targetResult, 0, len(results))
	for _, r := range results {
		t := r.Target
		lt, inLock := lf.Targets[t.Name]

		fpMatch := inLock && r.Fingerprint == lt.Fingerprint
		outMatch := inLock && r.OutputHash == lt.OutputHash
		if !fpMatch || !outMatch {
			allMatch = false
		}

		reasons := []string{}
		impacted := []string{}
		if !inLock {
			reasons = []string{"new_target"}
			for _, dep := range transitiveDepsFromManifest(m, t.Name) {
				if _, depInLock := lf.Targets[dep]; !depInLock {
					impacted = append(impacted, dep)
				}
			}
			sort.Strings(impacted)
		} else {
			srcHashes, err := sourceHashesForTarget(t, dir)
			if err != nil {
				fmt.Fprintln(os.Stderr, err)
				return 1
			}
			currentDeps := depFingerprintsForTarget(results, resultsByName, t)
			currentEnv := envValuesForTarget(t)
			reasons = changeReasons(t.Compiler, lt.Compiler, t.Flags, lt.Flags, srcHashes, lt.SourceHashes, currentDeps, lt.DepFingerprints, currentEnv, lt.EnvValues)
			if fpMatch {
				reasons = []string{}
				impacted = []string{}
			} else {
				for _, dep := range transitiveDepsFromManifest(m, t.Name) {
					rdep, ok := resultsByName[dep]
					if !ok {
						continue
					}
					ltdep, depInLock := lf.Targets[dep]
					if !depInLock || ltdep.Fingerprint != rdep.Fingerprint {
						impacted = append(impacted, dep)
					}
				}
				sort.Strings(impacted)
			}
		}

		targets = append(targets, targetResult{
			Name:             t.Name,
			FingerprintMatch: fpMatch,
			OutputMatch:      outMatch,
			ChangeReasons:    reasons,
			ImpactedBy:       impacted,
		})
	}

	printJSON(struct {
		AllMatch bool           `json:"all_match"`
		Targets  []targetResult `json:"targets"`
	}{
		AllMatch: allMatch,
		Targets:  targets,
	})
	return 0
}

func cmdLockDiff(args []string) int {
	if len(args) != 2 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault lock-diff <lockfile_a_path> <lockfile_b_path>")
		return 1
	}

	lfA, err := readLockfile(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	lfB, err := readLockfile(args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	added := []string{}
	removed := []string{}
	changed := []struct {
		Name       string   `json:"name"`
		Reasons    []string `json:"reasons"`
		ImpactedBy []string `json:"impacted_by"`
	}{}
	unchanged := []string{}

	for name := range lfA.Targets {
		if _, ok := lfB.Targets[name]; !ok {
			removed = append(removed, name)
		}
	}
	for name, tb := range lfB.Targets {
		ta, ok := lfA.Targets[name]
		if !ok {
			added = append(added, name)
			continue
		}
		if ta.Fingerprint == tb.Fingerprint {
			unchanged = append(unchanged, name)
			continue
		}
		reasons := changeReasons(tb.Compiler, ta.Compiler, tb.Flags, ta.Flags, tb.SourceHashes, ta.SourceHashes, tb.DepFingerprints, ta.DepFingerprints, tb.EnvValues, ta.EnvValues)
		impacted := impactedByForLockDiff(lfA, lfB, name)
		changed = append(changed, struct {
			Name       string   `json:"name"`
			Reasons    []string `json:"reasons"`
			ImpactedBy []string `json:"impacted_by"`
		}{Name: name, Reasons: reasons, ImpactedBy: impacted})
	}

	sort.Strings(added)
	sort.Strings(removed)
	sort.Strings(unchanged)
	sort.Slice(changed, func(i, j int) bool { return changed[i].Name < changed[j].Name })

	printJSON(struct {
		Added   []string `json:"added"`
		Removed []string `json:"removed"`
		Changed []struct {
			Name       string   `json:"name"`
			Reasons    []string `json:"reasons"`
			ImpactedBy []string `json:"impacted_by"`
		} `json:"changed"`
		Unchanged []string `json:"unchanged"`
	}{
		Added:     added,
		Removed:   removed,
		Changed:   changed,
		Unchanged: unchanged,
	})
	return 0
}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault <build|verify|inspect|audit|gc|lock|check|lock-diff> ...")
		os.Exit(1)
	}

	switch os.Args[1] {
	case "build":
		os.Exit(cmdBuild(os.Args[2:]))
	case "verify":
		os.Exit(cmdVerify(os.Args[2:]))
	case "inspect":
		os.Exit(cmdInspect(os.Args[2:]))
	case "audit":
		os.Exit(cmdAudit(os.Args[2:]))
	case "gc":
		os.Exit(cmdGC(os.Args[2:]))
	case "lock":
		os.Exit(cmdLock(os.Args[2:]))
	case "check":
		os.Exit(cmdCheck(os.Args[2:]))
	case "lock-diff":
		os.Exit(cmdLockDiff(os.Args[2:]))
	default:
		fmt.Fprintf(os.Stderr, "error: unknown subcommand: %s\n", os.Args[1])
		os.Exit(1)
	}
}
