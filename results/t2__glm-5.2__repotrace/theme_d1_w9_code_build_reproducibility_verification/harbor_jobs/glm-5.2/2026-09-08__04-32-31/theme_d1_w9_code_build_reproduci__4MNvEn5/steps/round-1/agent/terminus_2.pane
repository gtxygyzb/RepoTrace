    74		}
    75		if t.Flags == nil {
    76			t.Flags = []string{}
    77		}
    78		if t.Deps == nil {
    79			t.Deps = []string{}
    80		}
    81		if t.EnvCapture == nil {
    82			t.EnvCapture = []string{}
    83		}
    84	}
