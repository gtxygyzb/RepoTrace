func computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {
	h := sha256.New()

	srcs := append([]string{}, t.Sources...)
	sort.Strings(srcs)
	for _, src := range srcs {
		p := resolvePath(src, manifestDir)
		data, err := os.ReadFile(p)
		if err != nil {
			return "", fmt.Errorf("error: source file not found: %s (target '%s')", src, t.Name)
		}
		h.Write(data)
	}

	h.Write([]byte(t.Compiler))

	flags := append([]string{}, t.Flags...)
	sort.Strings(flags)
	for _, f := range flags {
		h.Write([]byte(f))
		h.Write([]byte("\n"))
	}

	envs := append([]string{}, t.EnvCapture...)
	sort.Strings(envs)
	for _, e := range envs {
		h.Write([]byte(e + "=" + os.Getenv(e) + "\n"))
	}

	deps := append([]string{}, t.Deps...)
	sort.Strings(deps)
	for _, d := range deps {
		hash, ok := depHashes[d]
		if !ok {
			return "", fmt.Errorf("error: missing output hash for dependency '%s' (target '%s')", d, t.Name)
		}
		if len(hash) != 32 {
			return "", fmt.Errorf("error: invalid output hash for dependency '%s' (target '%s')", d, t.Name)
		}
		h.Write(hash)
	}

	return hex.EncodeToString(h.Sum(nil)), nil
}

func copyFile(src, dst string) error {
	in, err := os.Open(src)
	if err != nil {
		return err
	}
	defer in.Close()

	if err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {
		return err
	}

	out, err := os.Create(dst)
	if err != nil {
		return err
	}
	if _, err := io.Copy(out, in); err != nil {
		out.Close()
		return err
	}
	return out.Close()
}

func storeArtifact(t *Target, storeRoot, fingerprint, outputHashHex, artifactPath string) error {
	dir := filepath.Join(storeRoot, "objects", fingerprint[:2], fingerprint)
	if err := os.MkdirAll(dir, 0o755); err != nil {
		return err
	}

	artifactDst := filepath.Join(dir, "artifact")
	if err := copyFile(artifactPath, artifactDst); err != nil {
		return err
	}

	meta := StoredMetadata{
		Name:           t.Name,
		Fingerprint:    fingerprint,
		OutputHash:     outputHashHex,
		Compiler:       t.Compiler,
		Flags:          t.Flags,
		Sources:        t.Sources,
		BuildTimestamp: time.Now().UTC().Format(time.RFC3339),
	}
	data, err := jsonBytes(meta)
	if err != nil {
		return err
	}
	return os.WriteFile(filepath.Join(dir, "metadata.json"), data, 0o644)
}

func readMetadata(path string) (*StoredMetadata, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	var meta StoredMetadata
	if err := json.Unmarshal(data, &meta); err != nil {
		return nil, err
	}
	if _, err := decodeHash(meta.OutputHash); err != nil {
		return nil, err
	}
	return &meta, nil
}

func compileTargetInDir(t *Target, sourceDir string) (scratchDir, outputPath, outputHash string, err error) {
	scratchDir, err = os.MkdirTemp("", "buildvault-build-*")
	if err != nil {
		return "", "", "", err
	}

	outputPath = filepath.Join(scratchDir, "out", t.Output)
	if err := os.MkdirAll(filepath.Dir(outputPath), 0o755); err != nil {
		return scratchDir, "", "", err
	}

	args := make([]string, 0, len(t.Flags)+len(t.Sources)+2)
	args = append(args, t.Flags...)
	args = append(args, "-o", outputPath)
	for _, src := range t.Sources {
		args = append(args, resolvePath(src, sourceDir))
	}

	cmd := exec.Command(t.Compiler, args...)
	cmd.Dir = sourceDir
	out, err := cmd.CombinedOutput()
	if err != nil {
		detail := strings.TrimSpace(string(out))
		if detail == "" {
			detail = err.Error()
		}
		return scratchDir, "", "", errors.New(detail)
	}

	data, err := os.ReadFile(outputPath)
	if err != nil {
		return scratchDir, "", "", fmt.Errorf("output artifact not found: %v", err)
	}
	sum := sha256.Sum256(data)
	outputHash = hex.EncodeToString(sum[:])
	return scratchDir, outputPath, outputHash, nil
}

func buildAndStoreTarget(t *Target, sourceDir, storeRoot, fingerprint string) (string, error) {
	scratch, outputPath, outHash, err := compileTargetInDir(t, sourceDir)
	if scratch != "" {
		defer os.RemoveAll(scratch)
	}
	if err != nil {
		return "", err
	}
	if err := storeArtifact(t, storeRoot, fingerprint, outHash, outputPath); err != nil {
		return "", err
	}
	return outHash, nil
}

func compileFresh(t *Target, sourceDir string) (string, error) {
	scratch, _, outHash, err := compileTargetInDir(t, sourceDir)
	if scratch != "" {
		defer os.RemoveAll(scratch)
	}
	return outHash, err
}

func runBuild(m *Manifest, manifestDir string) ([]buildResult, error) {
	order, err := topologicalOrder(m)
	if err != nil {
		return nil, err
	}

	depHashes := make(map[string][]byte)
	results := make([]buildResult, 0, len(order))

	for _, t := range order {
		fp, err := computeFingerprint(t, manifestDir, depHashes)
		if err != nil {
			return nil, err
		}

		metaPath := filepath.Join(m.StoreRoot, "objects", fp[:2], fp, "metadata.json")
		if _, err := os.Stat(metaPath); err == nil {
			meta, err := readMetadata(metaPath)
			if err != nil {
				return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
			}
			hash, err := decodeHash(meta.OutputHash)
			if err != nil {
				return nil, fmt.Errorf("error: cache metadata read failed for target '%s': %v", t.Name, err)
			}
[?2004hroot@n30009:/app# sed -n '441,760p' main.go
[?2004l			fmt.Fprintf(os.Stderr, "[cache hit] %s\n", t.Name)
			depHashes[t.Name] = hash
			results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: meta.OutputHash, Cached: true})
			continue
		}

		fmt.Fprintf(os.Stderr, "[building] %s\n", t.Name)
		outHash, err := buildAndStoreTarget(t, manifestDir, m.StoreRoot, fp)
		if err != nil {
			fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
			return nil, errBuildFailed
		}
		fmt.Fprintf(os.Stderr, "[stored] %s %s\n", t.Name, fp)

		hash, err := decodeHash(outHash)
		if err != nil {
			return nil, err
		}
		depHashes[t.Name] = hash
		results = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: outHash, Cached: false})
	}

	return results, nil
}

func copySources(m *Manifest, manifestDir string) (string, error) {
	tempDir, err := os.MkdirTemp("", "buildvault-verify-*")
	if err != nil {
		return "", err
	}

	for _, t := range m.Targets {
		for _, src := range t.Sources {
			srcAbs := resolvePath(src, manifestDir)
			dst := filepath.Join(tempDir, filepath.Clean(src))
			if err := copyFile(srcAbs, dst); err != nil {
				os.RemoveAll(tempDir)
				return "", err
			}
		}
	}

	return tempDir, nil
}

func dirSize(path string) int64 {
	var size int64
	filepath.Walk(path, func(_ string, info os.FileInfo, err error) error {
		if err != nil {
			return nil
		}
		if !info.IsDir() {
			size += info.Size()
		}
		return nil
	})
	return size
}

func gcStore(storeRoot string, referenced map[string]bool) (int, int, int64) {
	objectsDir := filepath.Join(storeRoot, "objects")
	entries, err := os.ReadDir(objectsDir)
	if err != nil {
		return 0, 0, 0
	}

	removed := 0
	retained := 0
	var freed int64

	for _, prefixEntry := range entries {
		if !prefixEntry.IsDir() {
			continue
		}
		prefixPath := filepath.Join(objectsDir, prefixEntry.Name())
		fps, err := os.ReadDir(prefixPath)
		if err != nil {
			continue
		}
		for _, fpEntry := range fps {
			if !fpEntry.IsDir() {
				continue
			}
			fp := fpEntry.Name()
			fpDir := filepath.Join(prefixPath, fp)
			if referenced[fp] {
				retained++
				continue
			}
			size := dirSize(fpDir)
			if err := os.RemoveAll(fpDir); err != nil {
				continue
			}
			removed++
			freed += size
		}
	}

	return removed, retained, freed
}

func jsonBytes(v interface{}) ([]byte, error) {
	var buf bytes.Buffer
	enc := json.NewEncoder(&buf)
	enc.SetEscapeHTML(false)
	if err := enc.Encode(v); err != nil {
		return nil, err
	}
	return bytes.TrimRight(buf.Bytes(), "\n"), nil
}

func printJSON(v interface{}) {
	data, err := jsonBytes(v)
	if err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		os.Exit(1)
	}
	fmt.Println(string(data))
}

func cmdBuild(args []string) int {
	if len(args) != 1 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault build <manifest_path>")
		return 1
	}

	m, dir, err := loadManifest(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	results, err := runBuild(m, dir)
	if err != nil {
		if errors.Is(err, errBuildFailed) {
			return 1
		}
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	type targetJSON struct {
		Name        string `json:"name"`
		Fingerprint string `json:"fingerprint"`
		OutputHash  string `json:"output_hash"`
		Cached      bool   `json:"cached"`
	}
	targets := make([]targetJSON, 0, len(results))
	for _, r := range results {
		targets = append(targets, targetJSON{
			Name:        r.Target.Name,
			Fingerprint: r.Fingerprint,
			OutputHash:  r.OutputHash,
			Cached:      r.Cached,
		})
	}

	printJSON(struct {
		Targets   []targetJSON `json:"targets"`
		StoreRoot string       `json:"store_root"`
	}{
		Targets:   targets,
		StoreRoot: m.StoreRoot,
	})
	return 0
}

func cmdVerify(args []string) int {
	if len(args) != 1 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault verify <manifest_path>")
		return 1
	}

	m, dir, err := loadManifest(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	order, err := topologicalOrder(m)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	firstDir, err := copySources(m, dir)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	defer os.RemoveAll(firstDir)

	secondDir, err := copySources(m, dir)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	defer os.RemoveAll(secondDir)

	firstHashes := make(map[string]string)
	for _, t := range order {
		h, err := compileFresh(t, firstDir)
		if err != nil {
			fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
			return 1
		}
		firstHashes[t.Name] = h
	}

	secondHashes := make(map[string]string)
	for _, t := range order {
		h, err := compileFresh(t, secondDir)
		if err != nil {
			fmt.Fprintf(os.Stderr, "[failed] %s: %s\n", t.Name, err.Error())
			return 1
		}
		secondHashes[t.Name] = h
	}

	type targetJSON struct {
		Name         string `json:"name"`
		FirstHash    string `json:"first_hash"`
		SecondHash   string `json:"second_hash"`
		Reproducible bool   `json:"reproducible"`
	}

	targets := make([]targetJSON, 0, len(order))
	reproducible := true
	for _, t := range order {
		ok := firstHashes[t.Name] == secondHashes[t.Name]
		if !ok {
			reproducible = false
		}
		targets = append(targets, targetJSON{
			Name:         t.Name,
			FirstHash:    firstHashes[t.Name],
			SecondHash:   secondHashes[t.Name],
			Reproducible: ok,
		})
	}

	printJSON(struct {
		Reproducible bool         `json:"reproducible"`
		Targets      []targetJSON `json:"targets"`
	}{
		Reproducible: reproducible,
		Targets:      targets,
	})
	return 0
}

