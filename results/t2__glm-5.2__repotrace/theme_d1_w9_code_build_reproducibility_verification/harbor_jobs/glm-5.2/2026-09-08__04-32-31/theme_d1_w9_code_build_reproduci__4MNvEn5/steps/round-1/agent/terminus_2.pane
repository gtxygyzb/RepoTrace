    61	func resolvePath(p, base string) string {
    62		if p == "" {
    63			return filepath.Clean(base)
    64		}
    65		if filepath.IsAbs(p) {
    66			return filepath.Clean(p)
    67		}
    68		return filepath.Clean(filepath.Join(base, p))
    69	}
