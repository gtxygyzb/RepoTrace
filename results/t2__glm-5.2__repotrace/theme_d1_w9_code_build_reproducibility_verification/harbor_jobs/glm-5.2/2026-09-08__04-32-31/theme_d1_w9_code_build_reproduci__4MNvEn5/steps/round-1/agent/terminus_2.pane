func resolvePath(p, base string) string {
	if p == "" {
		return filepath.Clean(base)
	}
	if filepath.IsAbs(p) {
		return filepath.Clean(p)
	}
	return filepath.Clean(filepath.Join(base, p))
}

func normalizeTarget(t *Target) {
	if t.Sources == nil {
		t.Sources = []string{}
	}
	if t.Flags == nil {
		t.Flags = []string{}
	}
	if t.Deps == nil {
		t.Deps = []string{}
	}
	if t.EnvCapture == nil {
		t.EnvCapture = []string{}
	}
}

func loadManifest(path string) (*Manifest, string, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		if os.IsNotExist(err) {
			return nil, "", fmt.Errorf("error: manifest not found: %s", path)
		}
		return nil, "", fmt.Errorf("error: invalid manifest: %v", err)
	}

	var raw struct {
		StoreRoot string          `json:"store_root"`
		Profiles  json.RawMessage `json:"profiles"`
		Targets   []*Target       `json:"targets"`
	}
	if err := json.Unmarshal(data, &raw); err != nil {
		return nil, "", fmt.Errorf("error: invalid manifest: %v", err)
	}

	m := Manifest{
		StoreRoot: raw.StoreRoot,
		Targets:   raw.Targets,
	}

	if len(raw.Profiles) > 0 {
		var rawProfiles map[string]json.RawMessage
		if err := json.Unmarshal(raw.Profiles, &rawProfiles); err != nil {
			return nil, "", fmt.Errorf("error: invalid manifest: profiles must be an object")
		}
		m.Profiles = make(map[string]Profile, len(rawProfiles))
		for name, rawProfile := range rawProfiles {
			p, err := parseProfile(name, rawProfile)
			if err != nil {
				return nil, "", err
			}
			m.Profiles[name] = p
		}
	}

	manifestDir, err := filepath.Abs(filepath.Dir(path))
	if err != nil {
		return nil, "", fmt.Errorf("error: invalid manifest: %v", err)
	}

	if m.StoreRoot == "" {
		m.StoreRoot = "artifact_store"
	}
	m.StoreRoot = resolvePath(m.StoreRoot, manifestDir)

	for _, t := range m.Targets {
		if t == nil {
			return nil, "", fmt.Errorf("error: invalid manifest: target is null")
		}
		normalizeTarget(t)
	}

	return &m, manifestDir, nil
}

func parseProfile(name string, raw json.RawMessage) (Profile, error) {
	var p Profile
	var m map[string]interface{}
	if err := json.Unmarshal(raw, &m); err != nil {
		return p, fmt.Errorf("error: invalid manifest: profile '%s' must be an object", name)
	}
	if m == nil {
		return p, fmt.Errorf("error: invalid manifest: profile '%s' must be an object", name)
	}

	if v, ok := m["compiler"]; ok {
		s, ok := v.(string)
		if !ok {
			return p, fmt.Errorf("error: invalid manifest: profile '%s' compiler must be a string", name)
		}
		p.Compiler = &s
	}

	if v, ok := m["flags_append"]; ok {
		arr, ok := v.([]interface{})
		if !ok {
			return p, fmt.Errorf("error: invalid manifest: profile '%s' flags_append must be an array", name)
		}
		for _, item := range arr {
			s, ok := item.(string)
			if !ok {
				return p, fmt.Errorf("error: invalid manifest: profile '%s' flags_append must be an array", name)
			}
			p.FlagsAppend = append(p.FlagsAppend, s)
		}
	}

	if v, ok := m["flags_remove"]; ok {
		arr, ok := v.([]interface{})
		if !ok {
			return p, fmt.Errorf("error: invalid manifest: profile '%s' flags_remove must be an array", name)
		}
		for _, item := range arr {
			s, ok := item.(string)
			if !ok {
				return p, fmt.Errorf("error: invalid manifest: profile '%s' flags_remove must be an array", name)
			}
			p.FlagsRemove = append(p.FlagsRemove, s)
		}
	}

	if v, ok := m["env_capture_append"]; ok {
		arr, ok := v.([]interface{})
		if !ok {
			return p, fmt.Errorf("error: invalid manifest: profile '%s' env_capture_append must be an array", name)
		}
		for _, item := range arr {
			s, ok := item.(string)
			if !ok {
				return p, fmt.Errorf("error: invalid manifest: profile '%s' env_capture_append must be an array", name)
			}
			p.EnvCaptureAppend = append(p.EnvCaptureAppend, s)
		}
	}

	return p, nil
}

