func cmdStatus(args []string) int {
	args, profile, status := extractProfile(args)
	if status != 0 {
		return status
	}
	if len(args) != 1 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault status <manifest_path> [--profile <name>]")
		return 1
	}

	m, dir, err := loadManifest(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := applyProfile(m, profile); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := checkConstraints(m, profile, nil); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	order, err := topologicalOrder(m)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	fingerprints, err := computeStatusFingerprints(m, dir)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	type targetJSON struct {
		Name         string `json:"name"`
		Fingerprint  string `json:"fingerprint"`
		Cached       bool   `json:"cached"`
		StaleEntries int    `json:"stale_entries"`
	}

	targets := make([]targetJSON, 0, len(order))
	totalCached := 0
	totalUncached := 0
	for _, t := range order {
		fp := fingerprints[t.Name]
		metaPath := filepath.Join(m.StoreRoot, "objects", fp[:2], fp, "metadata.json")
		cached := false
		if _, err := os.Stat(metaPath); err == nil {
			cached = true
		}
		if cached {
			totalCached++
		} else {
			totalUncached++
		}
		targets = append(targets, targetJSON{
			Name:         t.Name,
			Fingerprint:  fp,
			Cached:       cached,
			StaleEntries: staleEntriesForTarget(m.StoreRoot, t.Name, fp),
		})
	}

	printJSON(struct {
		Targets        []targetJSON `json:"targets"`
		TotalCached    int          `json:"total_cached"`
		TotalUncached  int          `json:"total_uncached"`
		StoreSizeBytes int64        `json:"store_size_bytes"`
	}{
		Targets:        targets,
		TotalCached:    totalCached,
		TotalUncached:  totalUncached,
		StoreSizeBytes: storeSize(m.StoreRoot),
	})
	return 0
}

func clearStoreObjects''', s, flags=re.S)

# Replace cmdBuild
s=re.sub(r'func cmdBuild\(args \[\]string\) int \{.*?\n\}\n\nfunc clearStoreObjects',
r'''func cmdBuild(args []string) int {
	args, profile, targetNames, status := extractProfileAndTargets(args, true)
	if status != 0 {
		return status
	}
	if len(args) != 1 {
		fmt.Fprintln(os.Stderr, "error: usage: buildvault build <manifest_path> [--profile <name>] [--targets <name1>,<name2>,...]")
		return 1
	}

	m, dir, err := loadManifest(args[0])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := validateManifest(m, dir); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if err := applyProfile(m, profile); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	var allowed map[string]bool
	if targetNames != nil {
		allowed, err = resolveBuildSet(m, targetNames)
		if err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 1
		}
	}
	if err := checkConstraints(m, profile, allowed); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
