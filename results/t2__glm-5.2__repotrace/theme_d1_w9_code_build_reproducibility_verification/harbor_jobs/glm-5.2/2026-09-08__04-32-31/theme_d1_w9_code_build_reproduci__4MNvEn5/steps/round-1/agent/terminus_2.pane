				}
			}
		}

		path = path[:len(path)-1]
		state[t.Name] = 2
		order = append(order, t)
		return nil
	}

	for _, t := range m.Targets {
		if state[t.Name] == 0 {
			if err := dfs(t); err != nil {
				return nil, err
			}
		}
	}

	return order, nil
}

