[4743.818794, "o", "\t\t\t\tseen[e] = true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tnormalizeTarget(t)\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc validateManifest(m *Manifest, manifestDir string) error {\r\n\tnames := make(map[string]bool)\r\n\tfor _, t := range m.Targets {\r\n\t\tif names[t.Name] {\r\n"]
[4743.818883, "o", "\t\t\treturn fmt.Errorf(\"error: duplicate target name: '%s'\", t.Name)\r\n\t\t}\r\n\t\tnames[t.Name] = true\r\n\t}\r\n\r\n\tbyName := make(map[string]*Target)\r\n\tfor _, t := range m.Targets {\r\n\t\tbyName[t.Name] = t\r\n\t}\r\n\r\n\tfor _, t := range m.Targets {\r\n\t\tfor _, dep := range t.Deps {\r\n\t\t\tif _, ok := byName[dep]; !ok {\r\n\t\t\t\treturn fmt.Errorf(\"error: target '%s' depends on unknown target '%s'\", t.Name, dep)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[4743.818968, "o", "\r\n\tfor _, t := range m.Targets {\r\n\t\tfor _, src := range t.Sources {\r\n\t\t\tp := resolvePath(src, manifestDir)\r\n\t\t\tif _, err := os.Stat(p); err != nil {\r\n\t\t\t\treturn fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif _, err := topologicalOrder(m); err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn nil\r\n"]
[4743.819049, "o", "}\r\n\r\nfunc indexString(s []string, v string) int {\r\n\tfor i, x := range s {\r\n\t\tif x == v {\r\n\t\t\treturn i\r\n\t\t}\r\n\t}\r\n\treturn -1\r\n}\r\n\r\nfunc topologicalOrder(m *Manifest) ([]*Target, error) {\r\n\tbyName := make(map[string]*Target)\r\n\tfor _, t := range m.Targets {\r\n"]
[4743.819132, "o", "\t\tbyName[t.Name] = t\r\n\t}\r\n\r\n\tstate := make(map[string]int)\r\n\tvar path []string\r\n\tvar order []*Target\r\n\r\n\tvar dfs func(t *Target) error\r\n\tdfs = func(t *Target) error {\r\n\t\tstate[t.Name] = 1\r\n\t\tpath = append(path, t.Name)\r\n\r\n\t\tfor _, dep := range t.Deps {\r\n\t\t\td, ok := byName[dep]\r\n"]
[4743.819213, "o", "\t\t\tif !ok {\r\n\t\t\t\treturn fmt.Errorf(\"error: target '%s' depends on unknown target '%s'\", t.Name, dep)\r\n\t\t\t}\r\n\t\t\tif state[dep] == 1 {\r\n\t\t\t\tidx := indexString(path, dep)\r\n\t\t\t\tif idx < 0 {\r\n\t\t\t\t\tidx = 0\r\n\t\t\t\t}\r\n\t\t\t\tcycle := append([]string{}, path[idx:]...)\r\n\t\t\t\tcycle = append(cycle, dep)\r\n"]
[4743.819295, "o", "\t\t\t\treturn fmt.Errorf(\"error: dependency cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n\t\t\t}\r\n\t\t\tif state[dep] == 0 {\r\n\t\t\t\tif err := dfs(d); err != nil {\r\n\t\t\t\t\treturn err\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tpath = path[:len(path)-1]\r\n\t\tstate[t.Name] = 2\r\n\t\torder = append(order, t)\r\n\t"]
[4743.819375, "o", "\treturn nil\r\n\t}\r\n\r\n\tfor _, t := range m.Targets {\r\n\t\tif state[t.Name] == 0 {\r\n\t\t\tif err := dfs(t); err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\treturn order, nil\r\n}\r\n"]
[4743.819461, "o", "\r\nfunc transitiveDeps(t *Target, byName map[string]*Target) []string {\r\n\tseen := make(map[string]bool)\r\n\tvar visit func(name string)\r\n\tvisit = func(name string) {\r\n\t\tdep, ok := byName[name]\r\n\t\tif !ok {\r\n\t\t\treturn\r\n\t\t}\r\n\t\tfor _, d := range dep.Deps {\r\n\t\t\tif !seen[d] {\r\n\t\t\t\tseen[d] = true\r\n\t\t\t\tvisit(d)\r\n\t\t\t}\r\n\t\t}\r\n"]
[4743.819543, "o", "\t}\r\n\tvisit(t.Name)\r\n\r\n\tres := make([]string, 0, len(seen))\r\n\tfor k := range seen {\r\n\t\tres = append(res, k)\r\n\t}\r\n\tsort.Strings(res)\r\n\treturn res\r\n}\r\n\r\nfunc decodeHash(s string) ([]byte, error) {\r\n\tb, err := hex.DecodeString(s)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"invalid output hash: %v\", err)\r\n\t}\r\n\t"]
[4743.819638, "o", "if len(b) != 32 {\r\n\t\treturn nil, fmt.Errorf(\"invalid output hash length\")\r\n\t}\r\n\treturn b, nil\r\n}\r\n\r\nfunc computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {\r\n\th := sha256.New()\r\n\r\n\tsrcs := append([]string{}, t.Sources...)\r\n\tsort.Strings(srcs)\r\n\tfor _, src := range srcs {\r\n\t\tp := resolvePath(src, manifestDir)\r\n\t\tdata, err := os.ReadFile(p)\r\n\t\tif err != nil {\r\n\t\t\treturn \"\", fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n"]
[4743.819741, "o", "\t\t}\r\n\t\th.Write(data)\r\n\t}\r\n\r\n\th.Write([]byte(t.Compiler))\r\n\r\n\tfor _, f := range t.Flags {\r\n\t\th.Write([]byte(f))\r\n\t\th.Write([]byte(\"\\n\"))\r\n\t}\r\n\r\n\tenvs := append([]string{}, t.EnvCapture...)\r\n\tsort.Strings(envs)\r\n\tfor _, e := range envs {\r\n\t\th.Write([]byte(e + \"=\" + os.Getenv(e) + \"\\n\"))\r\n\t}\r\n"]
[4743.819824, "o", "\r\n\tdeps := append([]string{}, t.Deps...)\r\n\tsort.Strings(deps)\r\n\tfor _, d := range deps {\r\n\t\thash, ok := depHashes[d]\r\n\t\tif !ok {\r\n\t\t\treturn \"\", fmt.Errorf(\"error: missing output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n\t\t}\r\n\t\tif len(hash) != 32 {\r\n\t\t\treturn \"\", fmt.Errorf(\"error: invalid output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n\t\t}\r\n\t\th.Write(hash)\r\n"]
[4743.819906, "o", "\t}\r\n\r\n\treturn hex.EncodeToString(h.Sum(nil)), nil\r\n}\r\n\r\nfunc copyFile(src, dst string) error {\r\n\tin, err := os.Open(src)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdefer in.Close()\r\n\r\n\tif err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {\r\n\t\treturn err\r\n\t}\r\n"]
