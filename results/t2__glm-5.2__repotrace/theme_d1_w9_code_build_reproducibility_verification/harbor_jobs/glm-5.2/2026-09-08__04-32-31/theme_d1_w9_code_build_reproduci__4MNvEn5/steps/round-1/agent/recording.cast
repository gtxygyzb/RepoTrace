[4744.104949, "o", "}\r\n\r\nfunc storeArtifact(t *Target, storeRoot, fingerprint, outputHashHex, artifactPath string) error {\r\n\tdir := filepath.Join(storeRoot, \"objects\", fingerprint[:2], fingerprint)\r\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n\tartifactDst := filepath.Join(dir, \"artifact\")\r\n\tif err := copyFile(artifactPath, artifactDst); err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n\tmeta := StoredMetadata{\r\n\t\tName:           t.Name,\r\n\t\tFingerprint:    fingerprint,\r\n\t\tOutputHash:     outputHashHex,\r\n\t\tCompiler:       t.Compiler,\r\n"]
[4744.105036, "o", "\t\tFlags:          t.Flags,\r\n\t\tSources:        t.Sources,\r\n\t\tBuildTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n\t}\r\n\tdata, err := jsonBytes(meta)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(filepath.Join(dir, \"metadata.json\"), data, 0o644)\r\n}\r\n\r\nfunc readMetadata(path string) (*StoredMetadata, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\t"]
[4744.105097, "o", "var meta StoredMetadata\r\n\tif err := json.Unmarshal(data, &meta); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif _, err := decodeHash(meta.OutputHash); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn &meta, nil\r\n}\r\n\r\n"]
[4744.105153, "o", "func compileTargetInDir(t *Target, sourceDir string) (scratchDir, outputPath, outputHash string, err error) {\r\n\tscratchDir, err = os.MkdirTemp(\"\", \"buildvault-build-*\")\r\n\tif err != nil {\r\n\t\treturn \"\", \"\", \"\", err\r\n\t}\r\n\r\n\toutputPath = filepath.Join(scratchDir, \"out\", t.Output)\r\n\tif err := os.MkdirAll(filepath.Dir(outputPath), 0o755); err != nil {\r\n\t\treturn scratchDir, \"\", \"\", err\r\n\t}\r\n"]
[4744.105211, "o", "\r\n\targs := make([]string, 0, len(t.Flags)+len(t.Sources)+2)\r\n\targs = append(args, t.Flags...)\r\n\targs = append(args, \"-o\", outputPath)\r\n\tfor _, src := range t.Sources {\r\n\t\targs = append(args, resolvePath(src, sourceDir))\r\n\t}\r\n\r\n\tcmd := exec.Command(t.Compiler, args...)\r\n\tcmd.Dir = sourceDir\r\n\tout, err := cmd.CombinedOutput()\r\n\tif err != nil {\r\n"]
[4744.105265, "o", "\t\tdetail := strings.TrimSpace(string(out))\r\n\t\tif detail == \"\" {\r\n\t\t\tdetail = err.Error()\r\n\t\t}\r\n\t\treturn scratchDir, \"\", \"\", errors.New(detail)\r\n\t}\r\n\r\n\tdata, err := os.ReadFile(outputPath)"]
[4744.10533, "o", "\r\n\tif err != nil {\r\n\t\treturn scratchDir, \"\", \"\", fmt.Errorf(\"output artifact not found: %v\", err)\r\n\t}\r\n\tsum := sha256.Sum256(data)\r\n\toutputHash = hex.EncodeToString(sum[:])\r\n\treturn scratchDir, outputPath, outputHash, nil\r\n}\r\n\r\nfunc buildAndStoreTarget(t *Target, sourceDir, storeRoot, fingerprint string) (string, error) {\r\n\tscratch, outputPath, outHash, err := compileTargetInDir(t, sourceDir)\r\n\tif scratch != \"\" {\r\n"]
[4744.105388, "o", "\t\tdefer os.RemoveAll(scratch)\r\n\t}\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tif err := storeArtifact(t, storeRoot, fingerprint, outHash, outputPath); err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\treturn outHash, nil\r\n}\r\n"]
[4744.105465, "o", "\r\nfunc compileFresh(t *Target, sourceDir string) (string, error) {\r\n\tscratch, _, outHash, err := compileTargetInDir(t, sourceDir)\r\n\tif scratch != \"\" {\r\n\t\tdefer os.RemoveAll(scratch)\r\n\t}\r\n\treturn outHash, err\r\n}\r\n\r\nfunc runBuild(m *Manifest, manifestDir string) ([]buildResult, error) {\r\n\torder, err := topologicalOrder(m)\r\n\tif err != nil {"]
[4744.105541, "o", "\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tdepHashes := make(map[string][]byte)\r\n\tresults := make([]buildResult, 0, len(order))\r\n\r\n\tfor _, t := range order {\r\n\t\tfp, err := computeFingerprint(t, manifestDir, depHashes)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\r\n\t\tmetaPath := filepath.Join(m.StoreRoot, \"objects\", fp[:2], fp, \"metadata.json\")\r\n"]
[4744.10562, "o", "\t\tif _, err := os.Stat(metaPath); err == nil {\r\n\t\t\tmeta, err := readMetadata(metaPath)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"error: cache metadata read failed for target '%s': %v\", t.Name, err)\r\n\t\t\t}\r\n\t\t\thash, err := decodeHash(meta.OutputHash)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"error: cache metadata read failed for target '%s': %v\", t.Name, err)\r\n\t\t\t}\r\n\t\t\tfmt.Fprintf(os.Stderr, \"[cache hit] %s\\n\", t.Name)\r\n\t\t\tdepHashes[t.Name] = hash\r\n\t\t\tresults = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: meta.OutputHash, Cached: true})\r\n\t\t\t"]
[4744.105718, "o", "continue\r\n\t\t}\r\n\r\n\t\tfmt.Fprintf(os.Stderr, \"[building] %s\\n\", t.Name)\r\n\t\toutHash, err := buildAndStoreTarget(t, manifestDir, m.StoreRoot, fp)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"[failed] %s: %s\\n\", t.Name, err.Error())\r\n\t\t\treturn nil, errBuildFailed\r\n\t\t}\r\n\t\tfmt.Fprintf(os.Stderr, \"[stored] %s %s\\n\", t.Name, fp)\r\n\r\n\t\thash, err := decodeHash(outHash)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n"]
[4744.105779, "o", "\t\t}\r\n\t\tdepHashes[t.Name] = hash\r\n\t\tresults = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: outHash, Cached: false})\r\n\t}\r\n\r\n\treturn results, nil\r\n}\r\n\r\n"]
[4744.105836, "o", "func copySources(m *Manifest, manifestDir string) (string, error) {\r\n\ttempDir, err := os.MkdirTemp(\"\", \"buildvault-verify-*\")\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\r\n\tfor _, t := range m.Targets {\r\n\t\tfor _, src := range t.Sources {\r\n\t\t\tsrcAbs := resolvePath(src, manifestDir)\r\n\t"]
[4744.105892, "o", "\t\tdst := filepath.Join(tempDir, filepath.Clean(src))\r\n\t\t\tif err := copyFile(srcAbs, dst); err != nil {\r\n\t\t\t\tos.RemoveAll(tempDir)\r\n\t\t\t\treturn \"\", err\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\treturn tempDir, nil\r\n}\r\n\r\n"]
[4744.105947, "o", "func dirSize(path string) int64 {\r\n\tvar size int64\r\n\tfilepath.Walk(path, func(_ string, info os.FileInfo, err error) error {\r\n\t\tif err != nil {\r\n\t\t\treturn nil\r\n\t\t}\r\n\t\tif !info.IsDir() {\r\n"]
[4744.106001, "o", "\t\t\tsize += info.Size()\r\n\t\t}\r\n\t\treturn nil\r\n\t})\r\n\treturn size\r\n}\r\n\r\nfunc gcStore(storeRoot string, referenced map[string]bool) (int, int, int64) {\r\n"]
[4744.106057, "o", "\tobjectsDir := filepath.Join(storeRoot, \"objects\")\r\n\tentries, err := os.ReadDir(objectsDir)\r\n\tif err != nil {\r\n\t\treturn 0, 0, 0\r\n\t}\r\n\r\n\tremoved := 0\r\n\tretained := 0\r\n\tvar freed int64\r\n\r\n\tfor _, prefixEntry := range entries {\r\n"]
[4744.106112, "o", "\t\tif !prefixEntry.IsDir() {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tprefixPath := filepath.Join(objectsDir, prefixEntry.Name())\r\n\t\tfps, err := os.ReadDir(prefixPath)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[4744.106172, "o", "\t\tfor _, fpEntry := range fps {\r\n\t\t\tif !fpEntry.IsDir() {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tfp := fpEntry.Name()\r\n\t\t\tfpDir := filepath.Join(prefixPath, fp)\r\n\t\t\tif referenced[fp] {\r\n\t\t\t\tretained++\r\n\t\t\t\tcontinue\r\n"]
[4744.106225, "o", "\t\t\t}\r\n\t\t\tsize := dirSize(fpDir)\r\n\t\t\tif err := os.RemoveAll(fpDir); err != nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tremoved++\r\n\t\t\tfreed += size\r\n"]
[4744.106282, "o", "\t\t}\r\n\t}\r\n\r\n\treturn removed, retained, freed\r\n}\r\n\r\nfunc jsonBytes(v interface{}) ([]byte, error) {\r\n\tvar buf bytes.Buffer\r\n\tenc := json.NewEncoder(&buf)\r\n\tenc.SetEscapeHTML(false)\r\n\tif err := enc.Encode(v); err != nil {\r\n"]
[4744.106346, "o", "\t\treturn nil, err\r\n\t}\r\n\treturn bytes.TrimRight(buf.Bytes(), \"\\n\"), nil\r\n}\r\n\r\nfunc printJSON(v interface{}) {\r\n\tdata, err := jsonBytes(v)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error:\", err)\r\n\t\tos.Exit(1)\r\n"]
[4744.106398, "o", "\t}\r\n\tfmt.Println(string(data))\r\n}\r\n\r\nfunc cmdBuild(args []string) int {\r\n\targs, profile, status := extractProfile(args)\r\n\tif status != 0 {\r\n\t\treturn status\r\n\t}\r\n"]
[4744.106461, "o", "\tif len(args) != 1 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: usage: buildvault build <manifest_path> [--profile <name>]\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\tm, dir, err := loadManifest(args[0])\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\tif err := validateManifest(m, dir); err != nil {\r\n"]
