[4737.267442, "o", "\t\t\t}\r\n\t\t\tp.EnvCaptureAppend = append(p.EnvCaptureAppend, s)\r\n\t\t}\r\n\t}\r\n\r\n\treturn p, nil\r\n}\r\n\r\nfunc extractProfile(args []string) ([]string, string, int) {\r\n\tprofile := \"\"\r\n\tremaining := make([]string, 0, len(args))\r\n\ti := 0\r\n\tfor i < len(args) {\r\n\t\tif args[i] == \"--profile\" {\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --profile requires a profile name\")\r\n\t\t\t\treturn nil, \"\", 1\r\n\t\t\t}\r\n\t\t\tprofile = args[i+1]\r\n\t"]
