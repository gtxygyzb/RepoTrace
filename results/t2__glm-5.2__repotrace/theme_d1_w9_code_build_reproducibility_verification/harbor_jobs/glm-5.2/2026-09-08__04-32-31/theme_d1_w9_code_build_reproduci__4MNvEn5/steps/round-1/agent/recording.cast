[3807.028694, "o", "   541\t\t\treturn scratchDir, \"\", \"\", errors.New(detail)\r\n   542\t\t}\r\n   543\t\r\n"]
[3807.02882, "o", "   544\t\tdata, err := os.ReadFile(outputPath)\r\n   545\t\tif err != nil {\r\n   546\t\t\treturn scratchDir, \"\", \"\", fmt.Errorf(\"output artifact not found: %v\", err)\r\n   547\t\t}\r\n   548\t\tsum := sha256.Sum256(data)\r\n   549\t\toutputHash = hex.EncodeToString(sum[:])\r\n   550\t\treturn scratchDir, outputPath, outputHash, nil\r\n   551\t}\r\n   552\t\r\n   553\tfunc buildAndStoreTarget(t *Target, sourceDir, storeRoot, fingerprint string) (string, error) {\r\n   554\t\tscratch, outputPath, outHash, err := compileTargetInDir(t, sourceDir)\r\n   555\t\tif scratch != \"\" {\r\n   556\t\t\tdefer os.RemoveAll(scratch)\r\n   557\t\t}\r\n   558\t\tif err != nil {\r\n   559\t\t\treturn \"\", err\r\n   560\t\t}\r\n   561\t\tif err := storeArtifact(t, storeRoot, fingerprint, outHash, outputPath); err != nil {\r\n   562\t\t\treturn \"\", err\r\n   563\t\t"]
