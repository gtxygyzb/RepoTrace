[2832.7517, "o", "sed -n '1,240p' main.go\r\n\u001b[?2004l\r"]
[2832.755177, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n"]
[2832.755312, "o", "\t\"errors\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\ntype Manifest struct {\r\n\tStoreRoot string    `json:\"store_root\"`\r\n\tTargets   []*Target `json:\"targets\"`\r\n}\r\n\r\ntype Target struct {\r\n\tName       string   `json:\"name\"`\r\n\tSources    []string `json:\"sources\"`\r\n\tCompiler   string   `json:\"compiler\"`\r\n\tFlags      []string `json:\"flags\"`\r\n\tOutput     string   `json:\"output\"`\r\n\tDeps       []string `json:\"deps\"`\r\n"]
[2832.755416, "o", "\tEnvCapture []string `json:\"env_capture\"`\r\n}\r\n\r\ntype StoredMetadata struct {\r\n\tName           string   `json:\"name\"`\r\n\tFingerprint    string   `json:\"fingerprint\"`\r\n\tOutputHash     string   `json:\"output_hash\"`\r\n\tCompiler       string   `json:\"compiler\"`\r\n\tFlags          []string `json:\"flags\"`\r\n\tSources        []string `json:\"sources\"`\r\n\tBuildTimestamp string   `json:\"build_timestamp\"`\r\n}\r\n\r\ntype buildResult struct {\r\n\tTarget      *Target\r\n\tFingerprint string\r\n\tOutputHash  string\r\n\tCached      bool\r\n}\r\n\r\n"]
[2832.755481, "o", "var errBuildFailed = errors.New(\"build failed\")\r\n\r\nfunc resolvePath(p, base string) string {\r\n\tif p == \"\" {\r\n\t\treturn filepath.Clean(base)\r\n\t}\r\n\tif filepath.IsAbs(p) {\r\n\t\treturn filepath.Clean(p)\r\n\t}\r\n\treturn filepath.Clean(filepath.Join(base, p))\r\n}\r\n"]
[2832.755548, "o", "\r\nfunc normalizeTarget(t *Target) {\r\n\tif t.Sources == nil {\r\n\t\tt.Sources = []string{}\r\n\t}\r\n\tif t.Flags == nil {\r\n\t\tt.Flags = []string{}\r\n\t}\r\n\tif t.Deps == nil {\r\n\t\tt.Deps = []string{}\r\n"]
[2832.755622, "o", "\t}\r\n\tif t.EnvCapture == nil {\r\n\t\tt.EnvCapture = []string{}\r\n\t}\r\n}\r\n\r\nfunc loadManifest(path string) (*Manifest, string, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, \"\", fmt.Errorf(\"error: manifest not found: %s\", path)\r\n\t\t}\r\n"]
[2832.755722, "o", "\t\treturn nil, \"\", fmt.Errorf(\"error: invalid manifest: %v\", err)\r\n\t}\r\n\r\n\tvar m Manifest\r\n\tif err := json.Unmarshal(data, &m); err != nil {\r\n\t\treturn nil, \"\", fmt.Errorf(\"error: invalid manifest: %v\", err)\r\n\t}\r\n\r\n\tmanifestDir, err := filepath.Abs(filepath.Dir(path))\r\n\tif err != nil {\r\n\t\treturn nil, \"\", fmt.Errorf(\"error: invalid manifest: %v\", err)\r\n\t}\r\n\r\n"]
[2832.755783, "o", "\tif m.StoreRoot == \"\" {\r\n\t\tm.StoreRoot = \"artifact_store\"\r\n\t}\r\n\tm.StoreRoot = resolvePath(m.StoreRoot, manifestDir)\r\n\r\n\tfor _, t := range m.Targets {\r\n\t\tif t == nil {\r\n\t\t\treturn nil, \"\", fmt.Errorf(\"error: invalid manifest: target is null\")\r\n\t\t}\r\n\t\tnormalizeTarget(t)\r\n\t}\r\n"]
[2832.755842, "o", "\r\n\treturn &m, manifestDir, nil\r\n}\r\n\r\nfunc validateManifest(m *Manifest, manifestDir string) error {\r\n\tnames := make(map[string]bool)\r\n\tfor _, t := range m.Targets {\r\n\t\tif names[t.Name] {\r\n\t\t\treturn fmt.Errorf(\"error: duplicate target name: '%s'\", t.Name)\r\n"]
[2832.755904, "o", "\t\t}\r\n\t\tnames[t.Name] = true\r\n\t}\r\n\r\n\tbyName := make(map[string]*Target)\r\n\tfor _, t := range m.Targets {\r\n\t\tbyName[t.Name] = t\r\n\t}\r\n\r\n\tfor _, t := range m.Targets {\r\n\t\tfor _, dep := range t.Deps {\r\n\t"]
[2832.755964, "o", "\t\tif _, ok := byName[dep]; !ok {\r\n\t\t\t\treturn fmt.Errorf(\"error: target '%s' depends on unknown target '%s'\", t.Name, dep)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, t := range m.Targets {\r\n\t\tfor _, src := range t.Sources {\r\n\t\t\tp := resolvePath(src, manifestDir)\r\n\t\t\tif _, err := os.Stat(p); err != nil {\r\n"]
[2832.756026, "o", "\t\t\t\treturn fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif _, err := topologicalOrder(m); err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n"]
[2832.756084, "o", "func indexString(s []string, v string) int {\r\n\tfor i, x := range s {\r\n\t\tif x == v {\r\n\t\t\treturn i\r\n\t\t}\r\n\t}\r\n\treturn -1\r\n}\r\n\r\n"]
[2832.756143, "o", "func topologicalOrder(m *Manifest) ([]*Target, error) {\r\n\tbyName := make(map[string]*Target)\r\n\tfor _, t := range m.Targets {\r\n\t\tbyName[t.Name] = t\r\n\t}\r\n\r\n\tstate := make(map[string]int)\r\n\tvar path []string\r\n\tvar order []*Target\r\n\r\n\tvar dfs func(t *Target) error\r\n"]
[2832.756202, "o", "\tdfs = func(t *Target) error {\r\n\t\tstate[t.Name] = 1\r\n\t\tpath = append(path, t.Name)\r\n\r\n\t\tfor _, dep := range t.Deps {\r\n\t\t\td, ok := byName[dep]\r\n\t\t\tif !ok {\r\n\t\t\t\treturn fmt.Errorf(\"error: target '%s' depends on unknown target '%s'\", t.Name, dep)\r\n\t\t\t}\r\n\t\t\tif state[dep] == 1 {\r\n\t"]
[2832.756271, "o", "\t\t\tidx := indexString(path, dep)\r\n\t\t\t\tif idx < 0 {\r\n\t\t\t\t\tidx = 0\r\n\t\t\t\t}\r\n\t\t\t\tcycle := append([]string{}, path[idx:]...)\r\n\t\t\t\tcycle = append(cycle, dep)\r\n"]
[2832.756347, "o", "\t\t\t\treturn fmt.Errorf(\"error: dependency cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n\t\t\t}\r\n\t\t\tif state[dep] == 0 {\r\n\t\t\t\tif err := dfs(d); err != nil {\r\n\t\t\t\t\treturn err\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tpath = path[:len(path)-1]\r\n\t\tstate[t.Name] = 2\r\n\t\torder = append(order, t)\r\n\t\treturn nil\r\n\t}\r\n"]
