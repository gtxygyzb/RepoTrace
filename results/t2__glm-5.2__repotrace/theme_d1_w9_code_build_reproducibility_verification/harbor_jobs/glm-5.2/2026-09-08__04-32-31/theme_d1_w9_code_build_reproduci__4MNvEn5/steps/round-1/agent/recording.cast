[2978.832076, "o", "\t\r\n  1054\tfunc mapEqual(a, b map[string]string) bool {\r\n  1055\t\tif len(a) != len(b) {\r\n  1056\t\t\treturn false\r\n  1057\t\t}\r\n  1058\t\tfor k, v := range a {\r\n  1059\t\t\tif bv, ok := b[k]; !ok || bv != v {\r\n  1060\t\t\t\treturn false\r\n  1061\t\t\t}\r\n"]
