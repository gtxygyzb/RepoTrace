[3794.673746, "o", "   954\tfunc cmdAudit(args []string) int {\r\n   955\t\targs, profile, status := extractProfile(args)\r\n   956\t\tif status != 0 {\r\n   957\t\t\treturn status\r\n   958\t\t}\r\n   959\t\tif len(args) < 1 {\r\n   960\t\t\tfmt.Fprintln(os.Stderr, \"error: usage: buildvault audit <manifest_path> --baseline <baseline_path> [--profile <name>]\")"]
[3794.673897, "o", "\r\n   961\t\t\treturn 1\r\n   962\t\t}\r\n   963\t\r\n   964\t\tmanifestPath := args[0]\r\n   965\t\trest := args[1:]\r\n   966\t\tbaselinePath := \"\"\r\n   967\t\r\n   968\t\tfor i := 0; i < len(rest); i++ {\r\n   969\t\t\tif rest[i] == \"--baseline\" {\r\n   970\t\t\t\tif i+1 >= len(rest) {\r\n   971\t\t\t\t\tfmt.Fprintln(os.Stderr, \"error: audit requires --baseline <baseline_path>\")\r\n   972\t\t\t\t\treturn 1\r\n   973\t\t\t\t}\r\n   974\t\t\t\tbaselinePath = rest[i+1]\r\n   975\t\t\t\ti++"]
[3794.673984, "o", "\r\n   976\t\t\t} else if strings.HasPrefix(rest[i], \"--baseline=\") {\r\n   977\t\t\t\tbaselinePath = rest[i][len(\"--baseline=\"):]\r\n   978\t\t\t} else {\r\n   979\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", rest[i])\r\n   980\t\t\t\treturn 1\r\n   981\t\t\t}\r\n"]
[3794.674071, "o", "   982\t\t}\r\n   983\t\r\n   984\t\tif baselinePath == \"\" {\r\n   985\t\t\tfmt.Fprintln(os.Stderr, \"error: audit requires --baseline <baseline_path>\")\r\n   986\t\t\treturn 1\r\n   987\t\t}\r\n   988\t\r\n   989\t\tm, dir, err := loadManifest(manifestPath)\r\n   990\t\tif err != nil {\r\n   991\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   992\t\t"]
