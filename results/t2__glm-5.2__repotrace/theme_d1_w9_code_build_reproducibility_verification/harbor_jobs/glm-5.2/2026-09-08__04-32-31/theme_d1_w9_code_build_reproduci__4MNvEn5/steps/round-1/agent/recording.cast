[1976.482918, "o", "   561\tfunc cmdBuild(args []string) int {\r\n   562\t\tif len(args) != 1 {\r\n   563\t\t\tfmt.Fprintln(os.Stderr, \"error: usage: buildvault build <manifest_path>\")\r\n   564\t\t\treturn 1\r\n   565\t\t}\r\n"]
[1976.483017, "o", "   566\t\r\n   567\t\tm, dir, err := loadManifest(args[0])\r\n   568\t\tif err != nil {\r\n   569\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   570\t\t\treturn 1\r\n   571\t\t}\r\n   572\t\tif err := validateManifest(m, dir); err != nil {\r\n   573\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   574\t\t\treturn 1\r\n   575\t\t}\r\n   576\t\r\n   577\t\tresults, err := runBuild(m, dir)\r\n   578\t\tif err != nil {\r\n   579\t\t\tif errors.Is(err, errBuildFailed) {\r\n   580\t\t\t\treturn 1\r\n   581\t\t\t}\r\n"]
