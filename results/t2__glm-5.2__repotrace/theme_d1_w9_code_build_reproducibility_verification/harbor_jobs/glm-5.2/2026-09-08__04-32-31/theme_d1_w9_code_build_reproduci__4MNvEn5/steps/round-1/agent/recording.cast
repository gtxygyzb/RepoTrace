[557.912821, "o", "tail -n 80 main.go\r\n\u001b[?2004l\r"]
[557.91534, "o", "\r\n\tprintJSON(map[string]interface{}{\r\n\t\t\"matches\": matches,\r\n\t\t\"targets\": targets,\r\n\t})\r\n\treturn 0\r\n}\r\n\r\nfunc cmdGC(args []string) int {\r\n\tif len(args) != 3 || args[0] != \"--manifest\" {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: usage: buildvault gc --manifest <manifest_path> <store_root>\")\r\n\t\treturn 1\r\n\t}\r\n\r\n\t"]
[557.915425, "o", "manifestPath := args[1]\r\n\tstoreRootArg := args[2]\r\n\r\n\tm, dir, err := loadManifest(manifestPath)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\r\n\tabsStore, err := filepath.Abs(storeRootArg)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\tm.StoreRoot = absStore\r\n\r\n\tif err := validateManifest(m, dir); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\r\n\tresults, err := runBuild(m, dir)\r\n\tif err != nil {\r\n\t\tif errors.Is(err, errBuildFailed) {\r\n\t\t\treturn 1\r\n\t\t}\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\r\n\t"]
[557.915496, "o", "referenced := make(map[string]bool)\r\n\tfor _, r := range results {\r\n\t\treferenced[r.Fingerprint] = true\r\n\t}\r\n\r\n\tremoved, retained, freed := gcStore(m.StoreRoot, referenced)\r\n\tprintJSON(map[string]interface{}{\r\n\t\t\"removed\":     removed,\r\n\t\t\"retained\":    retained,\r\n\t\t\"freed_bytes\": freed,\r\n\t})\r\n\treturn 0\r\n}\r\n\r\n"]
[557.915556, "o", "func main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: usage: buildvault <build|verify|inspect|audit|gc> ...\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n\tcase \"build\":\r\n\t\tos.Exit(cmdBuild(os.Args[2:]))\r\n\tcase \"verify\":\r\n\t\tos.Exit(cmdVerify(os.Args[2:]))\r\n"]
[557.915613, "o", "\tcase \"inspect\":\r\n\t\tos.Exit(cmdInspect(os.Args[2:]))\r\n\tcase \"audit\":\r\n\t\tos.Exit(cmdAudit(os.Args[2:]))\r\n\tcase \"gc\":\r\n\t\tos.Exit(cmdGC(os.Args[2:]))\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unknown subcommand: %s\\n\", os.Args[1])\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[557.915687, "o", "}\r\n"]
