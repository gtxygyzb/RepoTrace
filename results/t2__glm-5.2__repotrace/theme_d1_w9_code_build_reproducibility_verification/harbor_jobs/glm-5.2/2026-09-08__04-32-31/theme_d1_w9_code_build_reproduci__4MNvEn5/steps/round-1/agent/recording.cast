[1931.61377, "o", "func validateManifest(m *Manifest, manifestDir string) error {\r\n\tnames := make(map[string]bool)\r\n\tfor _, t := range m.Targets {\r\n\t\tif names[t.Name] {\r\n\t\t\treturn fmt.Errorf(\"error: duplicate target name: '%s'\", t.Name)\r\n"]
[1931.613854, "o", "\t\t}\r\n\t\tnames[t.Name] = true\r\n\t}\r\n\r\n\tbyName := make(map[string]*Target)\r\n\tfor _, t := range m.Targets {\r\n\t\tbyName[t.Name] = t\r\n\t}\r\n\r\n\tfor _, t := range m.Targets {\r\n\t\tfor _, dep := range t.Deps {\r\n"]
[1931.613927, "o", "\t\t\tif _, ok := byName[dep]; !ok {\r\n\t\t\t\treturn fmt.Errorf(\"error: target '%s' depends on unknown target '%s'\", t.Name, dep)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfor _, t := range m.Targets {\r\n\t\tfor _, src := range t.Sources {\r\n"]
[1931.613987, "o", "\t\t\tp := resolvePath(src, manifestDir)\r\n\t\t\tif _, err := os.Stat(p); err != nil {\r\n\t\t\t\treturn fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[1931.614045, "o", "\r\n\tif _, err := topologicalOrder(m); err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc indexString(s []string, v string) int {\r\n\tfor i, x := range s {\r\n"]
[1931.614102, "o", "\t\tif x == v {\r\n\t\t\treturn i\r\n\t\t}\r\n\t}\r\n\treturn -1\r\n}\r\n\r\nfunc topologicalOrder(m *Manifest) ([]*Target, error) {\r\n\tbyName := make(map[string]*Target)"]
[1931.61416, "o", "\r\n\tfor _, t := range m.Targets {\r\n\t\tbyName[t.Name] = t\r\n\t}\r\n\r\n\tstate := make(map[string]int)\r\n\tvar path []string\r\n\tvar order []*Target\r\n\r\n"]
[1931.614217, "o", "\tvar dfs func(t *Target) error\r\n\tdfs = func(t *Target) error {\r\n\t\tstate[t.Name] = 1\r\n\t\tpath = append(path, t.Name)\r\n\r\n\t\tfor _, dep := range t.Deps {\r\n\t\t\td, ok := byName[dep]\r\n\t"]
[1931.614274, "o", "\t\tif !ok {\r\n\t\t\t\treturn fmt.Errorf(\"error: target '%s' depends on unknown target '%s'\", t.Name, dep)\r\n\t\t\t}\r\n\t\t\tif state[dep] == 1 {\r\n\t\t\t\tidx := indexString(path, dep)\r\n"]
[1931.614337, "o", "\t\t\t\tif idx < 0 {\r\n\t\t\t\t\tidx = 0\r\n\t\t\t\t}\r\n\t\t\t\tcycle := append([]string{}, path[idx:]...)\r\n\t\t\t\tcycle = append(cycle, dep)\r\n\t\t\t\treturn fmt.Errorf(\"error: dependency cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n"]
[1931.614394, "o", "\t\t\t}\r\n\t\t\tif state[dep] == 0 {\r\n\t\t\t\tif err := dfs(d); err != nil {\r\n\t\t\t\t\treturn err\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t"]
[1931.614451, "o", "\t}\r\n\r\n\t\tpath = path[:len(path)-1]\r\n\t\tstate[t.Name] = 2\r\n\t\torder = append(order, t)\r\n\t\treturn nil\r\n\t}\r\n\r\n"]
[1931.614512, "o", "\tfor _, t := range m.Targets {\r\n\t\tif state[t.Name] == 0 {\r\n\t\t\tif err := dfs(t); err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t}\r\n"]
[1931.614576, "o", "\t}\r\n\r\n\treturn order, nil\r\n}\r\n\r\nfunc transitiveDeps(t *Target, byName map[string]*Target) []string {\r\n\tseen := make(map[string]bool)\r\n\tvar visit func(name string)\r\n\tvisit = func(name string) {\r\n\t\tdep, ok := byName[name]\r\n\t\tif !ok {\r\n"]
[1931.614662, "o", "\t\t\treturn\r\n\t\t}\r\n\t\tfor _, d := range dep.Deps {\r\n\t\t\tif !seen[d] {\r\n\t\t\t\tseen[d] = true\r\n\t\t\t\tvisit(d)\r\n\t\t\t}\r\n\t\t}\r\n"]
[1931.614722, "o", "\t}\r\n\tvisit(t.Name)\r\n\r\n\tres := make([]string, 0, len(seen))\r\n\tfor k := range seen {\r\n\t\tres = append(res, k)\r\n\t}\r\n\tsort.Strings(res)\r\n\treturn res\r\n"]
[1931.614783, "o", "}\r\n\r\n"]
