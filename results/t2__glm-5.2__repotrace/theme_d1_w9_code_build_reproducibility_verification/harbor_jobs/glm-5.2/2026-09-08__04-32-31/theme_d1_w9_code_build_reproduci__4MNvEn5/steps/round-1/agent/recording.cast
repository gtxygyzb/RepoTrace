[1851.909448, "o", "\r\n\tres := make([]string, 0, len(seen))\r\n\tfor k := range seen {\r\n\t\tres = append(res, k)\r\n\t}\r\n\tsort.Strings(res)\r\n\treturn res\r\n}\r\n\r\nfunc decodeHash(s string) ([]byte, error) {\r\n\tb, err := hex.DecodeString(s)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"invalid output hash: %v\", err)\r\n\t}\r\n\tif len(b) != 32 {\r\n\t\treturn nil, fmt.Errorf(\"invalid output hash length\")\r\n\t}\r\n"]
[1851.909529, "o", "\treturn b, nil\r\n}\r\n\r\nfunc computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {\r\n\th := sha256.New()\r\n\r\n\tsrcs := append([]string{}, t.Sources...)\r\n\tsort.Strings(srcs)\r\n\tfor _, src := range srcs {\r\n\t\tp := resolvePath(src, manifestDir)\r\n\t\tdata, err := os.ReadFile(p)\r\n\t\tif err != nil {\r\n\t\t\treturn \"\", fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n"]
[1851.909595, "o", "\t\t}\r\n\t\th.Write(data)\r\n\t}\r\n\r\n\th.Write([]byte(t.Compiler))\r\n\r\n\tflags := append([]string{}, t.Flags...)\r\n\tsort.Strings(flags)\r\n\tfor _, f := range flags {\r\n\t\th.Write([]byte(f))\r\n\t\th.Write([]byte(\"\\n\"))\r\n\t}\r\n\r\n"]
[1851.909714, "o", "\tenvs := append([]string{}, t.EnvCapture...)\r\n\tsort.Strings(envs)\r\n\tfor _, e := range envs {\r\n\t\th.Write([]byte(e + \"=\" + os.Getenv(e) + \"\\n\"))\r\n\t}\r\n\r\n\tdeps := append([]string{}, t.Deps...)\r\n\tsort.Strings(deps)\r\n\tfor _, d := range deps {\r\n\t\thash, ok := depHashes[d]\r\n\t\tif !ok {\r\n\t\t\treturn \"\", fmt.Errorf(\"error: missing output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n\t\t}\r\n\t\tif len(hash) != 32 {\r\n\t\t\treturn \"\", fmt.Errorf(\"error: invalid output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n\t\t}\r\n"]
[1851.909815, "o", "\t\th.Write(hash)\r\n\t}\r\n\r\n\treturn hex.EncodeToString(h.Sum(nil)), nil\r\n}\r\n\r\nfunc copyFile(src, dst string) error {\r\n\tin, err := os.Open(src)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdefer in.Close()\r\n\r\n\tif err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n\tout, err := os.Create(dst)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif _, err := io.Copy(out, in); err != nil {\r\n"]
[1851.909878, "o", "\t\tout.Close()\r\n\t\treturn err\r\n\t}\r\n\treturn out.Close()\r\n}\r\n\r\nfunc storeArtifact(t *Target, storeRoot, fingerprint, outputHashHex, artifactPath string) error {\r\n\tdir := filepath.Join(storeRoot, \"objects\", fingerprint[:2], fingerprint)\r\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n"]
[1851.909938, "o", "\tartifactDst := filepath.Join(dir, \"artifact\")\r\n\tif err := copyFile(artifactPath, artifactDst); err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n\tmeta := StoredMetadata{\r\n\t\tName:           t.Name,\r\n\t\tFingerprint:    fingerprint,\r\n\t\tOutputHash:     outputHashHex,\r\n\t\tCompiler:       t.Compiler,\r\n\t"]
[1851.909996, "o", "\tFlags:          t.Flags,\r\n\t\tSources:        t.Sources,\r\n\t\tBuildTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n\t}\r\n\tdata, err := jsonBytes(meta)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(filepath.Join(dir, \"metadata.json\"), data, 0o644)\r\n}\r\n"]
[1851.910072, "o", "\r\nfunc readMetadata(path string) (*StoredMetadata, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar meta StoredMetadata\r\n\tif err := json.Unmarshal(data, &meta); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif _, err := decodeHash(meta.OutputHash); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn &meta, nil\r\n"]
[1851.910138, "o", "}\r\n\r\nfunc compileTargetInDir(t *Target, sourceDir string) (scratchDir, outputPath, outputHash string, err error) {\r\n\tscratchDir, err = os.MkdirTemp(\"\", \"buildvault-build-*\")\r\n\tif err != nil {\r\n\t\treturn \"\", \"\", \"\", err\r\n\t}\r\n\r\n\toutputPath = filepath.Join(scratchDir, \"out\", t.Output)\r\n\t"]
[1851.910202, "o", "if err := os.MkdirAll(filepath.Dir(outputPath), 0o755); err != nil {\r\n\t\treturn scratchDir, \"\", \"\", err\r\n\t}\r\n\r\n\targs := make([]string, 0, len(t.Flags)+len(t.Sources)+2)\r\n\targs = append(args, t.Flags...)\r\n\targs = append(args, \"-o\", outputPath)\r\n\tfor _, src := range t.Sources {\r\n\t\targs = append(args, resolvePath(src, sourceDir))\r\n\t}\r\n"]
[1851.91026, "o", "\r\n\tcmd := exec.Command(t.Compiler, args...)\r\n\tcmd.Dir = sourceDir\r\n\tout, err := cmd.CombinedOutput()\r\n\tif err != nil {\r\n\t\tdetail := strings.TrimSpace(string(out))\r\n\t\tif detail == \"\" {\r\n\t\t\tdetail = err.Error()\r\n"]
[1851.910322, "o", "\t\t}\r\n\t\treturn scratchDir, \"\", \"\", errors.New(detail)\r\n\t}\r\n\r\n\tdata, err := os.ReadFile(outputPath)\r\n\tif err != nil {\r\n\t\treturn scratchDir, \"\", \"\", fmt.Errorf(\"output artifact not found: %v\", err)\r\n\t}\r\n\tsum := sha256.Sum256(data)\r\n\toutputHash = hex.EncodeToString(sum[:])\r\n\treturn scratchDir, outputPath, outputHash, nil\r\n}\r\n"]
[1851.910392, "o", "\r\nfunc buildAndStoreTarget(t *Target, sourceDir, storeRoot, fingerprint string) (string, error) {\r\n\tscratch, outputPath, outHash, err := compileTargetInDir(t, sourceDir)\r\n\tif scratch != \"\" {\r\n\t\tdefer os.RemoveAll(scratch)\r\n\t}\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tif err := storeArtifact(t, storeRoot, fingerprint, outHash, outputPath); err != nil {\r\n\t\treturn \"\", err\r\n\t}"]
[1851.910455, "o", "\r\n\treturn outHash, nil\r\n}\r\n\r\nfunc compileFresh(t *Target, sourceDir string) (string, error) {\r\n\tscratch, _, outHash, err := compileTargetInDir(t, sourceDir)\r\n\tif scratch != \"\" {\r\n\t\tdefer os.RemoveAll(scratch)\r\n\t}\r\n\treturn outHash, err\r\n}\r\n"]
