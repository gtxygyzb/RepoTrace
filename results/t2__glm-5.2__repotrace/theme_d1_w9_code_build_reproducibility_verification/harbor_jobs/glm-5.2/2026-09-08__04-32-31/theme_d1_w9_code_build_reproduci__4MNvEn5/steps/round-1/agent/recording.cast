[2851.348552, "o", "func changeReasons(currentCompiler, lockCompiler string, currentFlags, lockFlags []string, currentSources, lockSources map[string]string, currentDeps, lockDeps map[string]string, currentEnv, lockEnv map[string]string) []string {\r\n\treasons := []string{}\r\n\tif currentCompiler != lockCompiler {\r\n\t\treasons = append(reasons, \"compiler_changed\")\r\n\t}\r\n\tif !flagsEqual(currentFlags, lockFlags) {\r\n\t\treasons = append(reasons, \"flags_changed\")\r\n\t}\r\n\tif !mapEqual(currentSources, lockSources) {\r\n\t\treasons = append(reasons, \"source_changed\")\r\n\t}\r\n\tif !mapEqual(currentDeps, lockDeps) {\r\n\t\t"]
