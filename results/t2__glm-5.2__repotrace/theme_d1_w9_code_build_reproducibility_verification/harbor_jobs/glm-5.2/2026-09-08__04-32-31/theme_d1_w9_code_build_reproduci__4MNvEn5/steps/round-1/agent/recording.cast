[2851.34786, "o", "\tTargets map[string]lockfileTarget `json:\"targets\"`\r\n}\r\n\r\nfunc sha256File(path string) (string, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tsum := sha256.Sum256(data)\r\n\treturn hex.EncodeToString(sum[:]), nil\r\n}\r\n\r\nfunc sourceHashesForTarget(t *Target, manifestDir string) (map[string]string, error) {\r\n\thashes := make(map[string]string, len(t.Sources))\r\n\tfor _, src := range t.Sources {\r\n"]
[2851.347927, "o", "\t\tp := resolvePath(src, manifestDir)\r\n\t\th, err := sha256File(p)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n\t\t}\r\n\t\thashes[src] = h\r\n\t}\r\n\treturn hashes, nil\r\n}\r\n\r\n"]
[2851.348003, "o", "func envValuesForTarget(t *Target) map[string]string {\r\n\tvals := make(map[string]string, len(t.EnvCapture))\r\n\tfor _, e := range t.EnvCapture {\r\n\t\tvals[e] = os.Getenv(e)\r\n\t}\r\n\treturn vals\r\n"]
[2851.348102, "o", "}\r\n\r\nfunc depFingerprintsForTarget(results []buildResult, resultsByName map[string]buildResult, t *Target) map[string]string {\r\n\tdeps := make(map[string]string, len(t.Deps))\r\n\tfor _, d := range t.Deps {\r\n\t\tif r, ok := resultsByName[d]; ok {\r\n\t\t\tdeps[d] = r.Fingerprint\r\n\t\t}\r\n\t}\r\n\treturn deps\r\n}\r\n\r\nfunc readLockfile(path string) (*lockfile, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, fmt.Errorf(\"error: lockfile not found: %s\", path)\r\n\t\t}\r\n\t\treturn nil, fmt.Errorf(\"error: lockfile not found: %s\", path)\r\n\t}\r\n\tvar lf lockfile\r\n"]
