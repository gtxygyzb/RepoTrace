[1924.190553, "o", "func computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {\r\n\th := sha256.New()\r\n\r\n\tsrcs := append([]string{}, t.Sources...)\r\n\tsort.Strings(srcs)\r\n"]
[1924.190691, "o", "\tfor _, src := range srcs {\r\n\t\tp := resolvePath(src, manifestDir)\r\n\t\tdata, err := os.ReadFile(p)\r\n\t\tif err != nil {\r\n\t\t\treturn \"\", fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n\t\t}\r\n\t\th.Write(data)\r\n\t}\r\n\r\n\th.Write([]byte(t.Compiler))\r\n\r\n\tflags := append([]string{}, t.Flags...)\r\n\tsort.Strings(flags)\r\n\tfor _, f := range flags {\r\n\t\th.Write([]byte(f))\r\n\t\th.Write([]byte(\"\\n\"))\r\n"]
[1924.190763, "o", "\t}\r\n\r\n\tenvs := append([]string{}, t.EnvCapture...)\r\n\tsort.Strings(envs)\r\n\tfor _, e := range envs {\r\n\t\th.Write([]byte(e + \"=\" + os.Getenv(e) + \"\\n\"))\r\n\t}\r\n\r\n\tdeps := append([]string{}, t.Deps...)\r\n\tsort.Strings(deps)\r\n\tfor _, d := range deps {\r\n\t\thash, ok := depHashes[d]\r\n\t\tif !ok {\r\n\t"]
[1924.190824, "o", "\t\treturn \"\", fmt.Errorf(\"error: missing output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n\t\t}\r\n\t\tif len(hash) != 32 {\r\n\t\t\treturn \"\", fmt.Errorf(\"error: invalid output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n\t\t}\r\n\t\th.Write(hash)\r\n\t}\r\n\r\n\treturn hex.EncodeToString(h.Sum(nil)), nil\r\n"]
[1924.190887, "o", "}\r\n\r\n"]
