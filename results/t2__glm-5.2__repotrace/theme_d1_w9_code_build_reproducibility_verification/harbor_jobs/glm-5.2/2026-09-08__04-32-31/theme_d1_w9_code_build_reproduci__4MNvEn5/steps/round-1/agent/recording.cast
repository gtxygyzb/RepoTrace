[4751.984721, "o", "   667\t\tretained := 0\r\n   668\t\tvar freed int64\r\n   669\t\r\n   670\t\tfor _, prefixEntry := range entries {\r\n   671\t\t\tif !prefixEntry.IsDir() {\r\n   672\t\t\t\tcontinue\r\n   673\t\t\t}\r\n   674\t\t\tprefixPath := filepath.Join(objectsDir, prefixEntry.Name())\r\n   675\t\t\tfps, err := os.ReadDir(prefixPath)\r\n   676\t\t\tif err != nil {\r\n   677\t\t\t\tcontinue\r\n   678\t\t\t}\r\n   679\t\t\tfor _, fpEntry := range fps {\r\n   680\t\t\t\tif !fpEntry.IsDir() {\r\n   681\t\t\t\t\tcontinue\r\n   682\t\t\t\t}\r\n   683\t\t\t\tfp := fpEntry.Name()\r\n   684\t\t\t\tfpDir := filepath.Join(prefixPath, fp)\r\n   685\t\t\t\tif referenced[fp] {\r\n   686\t\t\t\t\tretained++\r\n   687\t\t\t\t\tcontinue\r\n   688\t\t\t\t}\r\n   689\t\t\t\tsize := dirSize(fpDir)\r\n   690\t\t\t\tif err := os.RemoveAll(fpDir); err != nil {\r\n   691\t\t\t\t\tcontinue\r\n   692\t\t\t\t}\r\n   693\t\t\t\tremoved++\r\n   694\t\t\t\tfreed += size\r\n   695\t\t\t}\r\n   696\t\t}\r\n   697\t\r\n   698\t\treturn removed, retained, freed\r\n   699\t}\r\n   700\t\r\n   701\tfunc jsonBytes(v interface{}) ([]byte, error) {\r\n   702\t\tvar buf bytes.Buffer\r\n   703\t\tenc := json.NewEncoder(&buf)\r\n   704\t\tenc.SetEs"]
