[3821.171718, "o", "   408\tfunc computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {\r\n   409\t\th := sha256.New()\r\n   410\t\r\n   411\t\tsrcs := append([]string{}, t.Sources...)\r\n   412\t\tsort.Strings(srcs)\r\n"]
[3821.171785, "o", "   413\t\tfor _, src := range srcs {\r\n   414\t\t\tp := resolvePath(src, manifestDir)\r\n   415\t\t\tdata, err := os.ReadFile(p)\r\n   416\t\t\tif err != nil {\r\n   417\t\t\t\treturn \"\", fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n   418\t\t\t}\r\n   419\t\t\th.Write(data)\r\n   420\t\t}\r\n   421\t\r\n   422\t\th.Write([]byte(t.Compiler))\r\n   423\t\r\n"]
[3821.17184, "o", "   424\t\tfor _, f := range t.Flags {\r\n   425\t\t\th.Write([]byte(f))\r\n   426\t\t\th.Write([]byte(\"\\n\"))\r\n   427\t\t}\r\n   428\t\r\n   429\t\tenvs := append([]string{}, t.EnvCapture...)\r\n   430\t\tsort.Strings(envs)\r\n   431\t\tfor _, e := range envs {\r\n   432\t\t\th.Write([]byte(e + \"=\" + os.Getenv(e) + \"\\n\"))\r\n"]
[3821.171892, "o", "   433\t\t}\r\n   434\t\r\n   435\t\tdeps := append([]string{}, t.Deps...)\r\n   436\t\tsort.Strings(deps)\r\n   437\t\tfor _, d := range deps {\r\n   438\t\t\thash, ok := depHashes[d]\r\n   439\t\t\tif !ok {\r\n   440\t\t\t\treturn \"\", fmt.Errorf(\"error: missing output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n"]
[3821.171943, "o", "   441\t\t\t}\r\n   442\t\t\tif len(hash) != 32 {\r\n   443\t\t\t\treturn \"\", fmt.Errorf(\"error: invalid output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n   444\t\t\t}\r\n   445\t\t\th.Write(hash)\r\n   446\t\t}\r\n   447\t\r\n   448\t\treturn hex.EncodeToString(h.Sum(nil)), nil\r\n   449\t"]
[3821.171997, "o", "}\r\n   450\t\r\n   451\tfunc copyFile(src, dst string) error {\r\n   452\t\tin, err := os.Open(src)\r\n   453\t\tif err != nil {\r\n   454\t\t\treturn err\r\n   455\t\t}\r\n   456\t\tdefer in.Close()\r\n   457\t\r\n   458"]
[3821.17205, "o", "\t\tif err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {\r\n   459\t\t\treturn err\r\n   460\t\t}\r\n   461\t\r\n   462\t\tout, err := os.Create(dst)\r\n   463\t\tif err != nil {\r\n   464\t\t\treturn err\r\n"]
[3821.17211, "o", "   465\t\t}\r\n   466\t\tif _, err := io.Copy(out, in); err != nil {\r\n   467\t\t\tout.Close()\r\n   468\t\t\treturn err\r\n   469\t\t}\r\n   470\t\treturn out.Close()\r\n   471\t}\r\n   472\t\r\n   473\tfunc storeArtifact(t *Target, storeRoot, fingerprint, outputHashHex, artifactPath string) error {\r\n"]
[3821.172161, "o", "   474\t\tdir := filepath.Join(storeRoot, \"objects\", fingerprint[:2], fingerprint)\r\n   475\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\r\n   476\t\t\treturn err\r\n   477\t\t}\r\n   478\t\r\n   479\t\tartifactDst := filepath.Join(dir, \"artifact\")\r\n   480\t\tif err := copyFile(artifactPath, artifactDst); err != nil {\r\n   481\t\t\treturn err\r\n   482\t\t}\r\n"]
[3821.172207, "o", "   483\t\r\n   484\t\tmeta := StoredMetadata{\r\n   485\t\t\tName:           t.Name,\r\n   486\t\t\tFingerprint:    fingerprint,\r\n   487\t\t\tOutputHash:     outputHashHex,\r\n   488\t\t\tCompiler:       t.Compiler,\r\n   489"]
[3821.172259, "o", "\t\t\tFlags:          t.Flags,\r\n   490\t\t\tSources:        t.Sources,\r\n   491\t\t\tBuildTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n   492\t\t}\r\n   493\t\tdata, err := jsonBytes(meta)\r\n   494\t\tif err != nil {\r\n   495\t\t\treturn err\r\n   496\t\t}\r\n"]
[3821.172308, "o", "   497\t\treturn os.WriteFile(filepath.Join(dir, \"metadata.json\"), data, 0o644)\r\n   498\t}\r\n   499\t\r\n   500\tfunc readMetadata(path string) (*StoredMetadata, error) {\r\n   501\t\tdata, err := os.ReadFile(path)\r\n   502\t\tif err != nil {\r\n   503\t\t\treturn nil, err\r\n"]
[3821.17236, "o", "   504\t\t}\r\n   505\t\tvar meta StoredMetadata\r\n   506\t\tif err := json.Unmarshal(data, &meta); err != nil {\r\n   507\t\t\treturn nil, err\r\n   508\t\t}\r\n   509\t\tif _, err := decodeHash(meta.OutputHash); err != nil {\r\n   510\t\t\treturn nil, err\r\n"]
[3821.172412, "o", "   511\t\t}\r\n   512\t\treturn &meta, nil\r\n   513\t}\r\n   514\t\r\n   515\tfunc compileTargetInDir(t *Target, sourceDir string) (scratchDir, outputPath, outputHash string, err error) {\r\n   516\t\tscratchDir, err = os.MkdirTemp(\"\", \"buildvault-build-*\")\r\n   517\t\tif err != nil {\r\n   518\t\t\treturn \"\", \"\", \"\", err\r\n"]
[3821.172463, "o", "   519\t\t}\r\n   520\t\r\n   521\t\toutputPath = filepath.Join(scratchDir, \"out\", t.Output)\r\n   522\t\tif err := os.MkdirAll(filepath.Dir(outputPath), 0o755); err != nil {\r\n   523\t\t\treturn scratchDir, \"\", \"\", err\r\n   524\t\t}\r\n   525\t\r\n   526\t\targs := make([]string, 0, len(t.Flags)+len(t.Sources)+2)\r\n   527\t\targs = append(args, t.Flags...)\r\n   528\t\targs = append(args, \"-o\", outputPath)\r\n"]
[3821.172512, "o", "   529\t\tfor _, src := range t.Sources {\r\n   530\t\t\targs = append(args, resolvePath(src, sourceDir))\r\n   531\t\t}\r\n   532\t\r\n   533\t\tcmd := exec.Command(t.Compiler, args...)\r\n   534\t\tcmd.Dir = sourceDir\r\n"]
[3821.172561, "o", "   535\t\tout, err := cmd.CombinedOutput()\r\n   536\t\tif err != nil {\r\n   537\t\t\tdetail := strings.TrimSpace(string(out))\r\n   538\t\t\tif detail == \"\" {\r\n   539\t\t\t\tdetail = err.Error()\r\n   540\t\t\t}\r\n   541\t\t\treturn scratchDir, \"\", \"\", errors.New(detail)\r\n   542\t"]
[3821.172614, "o", "\t}\r\n   543\t\r\n   544\t\tdata, err := os.ReadFile(outputPath)\r\n   545\t\tif err != nil {\r\n   546\t\t\treturn scratchDir, \"\", \"\", fmt.Errorf(\"output artifact not found: %v\", err)\r\n   547\t\t}\r\n   548\t\tsum := sha256.Sum256(data)\r\n   549\t\toutputHash = hex.EncodeToString(sum[:])\r\n"]
[3821.172696, "o", "   550\t\treturn scratchDir, outputPath, outputHash, nil\r\n   551\t}\r\n   552\t\r\n   553\tfunc buildAndStoreTarget(t *Target, sourceDir, storeRoot, fingerprint string) (string, error) {\r\n   554\t\tscratch, outputPath, outHash, err := compileTargetInDir(t, sourceDir)\r\n   555\t\tif scratch != \"\" {\r\n   556\t\t\tdefer os.RemoveAll(scratch)\r\n   557\t\t}\r\n   558\t\tif err != nil {\r\n   559\t\t\treturn \"\", err\r\n   560\t\t}\r\n"]
