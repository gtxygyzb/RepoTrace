[2886.381289, "o", "\tFlags:          t.Flags,\r\n   331\t\t\tSources:        t.Sources,\r\n   332\t\t\tBuildTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n   333\t\t}\r\n   334\t\tdata, err := jsonBytes(meta)\r\n   335\t\tif err != nil {\r\n   336\t\t\treturn err\r\n   337\t\t}\r\n   338\t\treturn os.WriteFile(filepath.Join(dir, \"metadata.json\"), data, 0o644)\r\n   339\t"]
