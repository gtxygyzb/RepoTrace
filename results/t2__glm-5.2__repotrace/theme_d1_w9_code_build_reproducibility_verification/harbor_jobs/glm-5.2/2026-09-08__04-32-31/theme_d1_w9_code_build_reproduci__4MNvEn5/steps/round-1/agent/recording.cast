[2983.837867, "o", "  1027\t\t\t\tlf.Targets[name] = tt\r\n  1028\t\t\t}\r\n  1029\t\t}\r\n  1030\t\treturn &lf, nil\r\n  1031\t}\r\n  1032\t\r\n  1033\tfunc sortedKeys(m map[string]string) []string {\r\n  1034\t\tres := make([]string, 0, len(m))\r\n  1035\t\tfor k := range m {\r\n  1036\t\t\tres = append(res, k)\r\n  1037\t\t}\r\n  1038\t\tsort.Strings(res)\r\n  1039\t\treturn res\r\n  1040\t}\r\n  1041\t\r\n  1042\tfunc flagsEqual(a, b []string) bool {\r\n  1043\t\tif len(a) != len(b) {\r\n  1044\t\t\treturn false\r\n  1045\t\t}\r\n  1046\t\tfor i := range a {\r\n  1047\t\t\tif a[i] != b[i] {\r\n  1048\t\t\t\treturn false\r\n  1049\t\t\t}\r\n  1050\t\t}\r\n  1051\t\treturn true\r\n  1052\t}\r\n  1053\t\r\n"]
[2983.837944, "o", "  1054\tfunc mapEqual(a, b map[string]string) bool {\r\n  1055\t\tif len(a) != len(b) {\r\n  1056\t\t\treturn false\r\n  1057\t\t}\r\n  1058\t\tfor k, v := range a {\r\n  1059\t\t\tif bv, ok := b[k]; !ok || bv != v {\r\n  1060\t\t\t\treturn false\r\n  1061\t\t\t}\r\n  1062\t\t}\r\n  1063\t\treturn true\r\n  1064\t}\r\n  1065\t\r\n"]
[2983.838005, "o", "  1066\tfunc changeReasons(currentCompiler, lockCompiler string, currentFlags, lockFlags []string, currentSources, lockSources map[string]string, currentDeps, lockDeps map[string]string, currentEnv, lockEnv map[string]string) []string {\r\n  1067\t\treasons := []string{}\r\n  1068\t\tif currentCompiler != lockCompiler {\r\n  1069\t\t\treasons = append(reasons, \"compiler_changed\")\r\n  1070\t\t}\r\n  1071\t\tif !flagsEqual(currentFlags, lockFlags) {\r\n  1072\t\t\treasons = append(reasons, \"flags_changed\")\r\n  1073\t\t}\r\n"]
