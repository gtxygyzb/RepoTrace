[4751.68864, "o", "   369\t\treturn order, nil\r\n   370\t}\r\n   371\t\r\n   372\tfunc transitiveDeps(t *Target, byName map[string]*Target) []string {\r\n   373\t\tseen := make(map[string]bool)\r\n   374\t\tvar visit func(name string)\r\n   375\t\tvisit = func(name string) {\r\n   376\t\t\tdep, ok := byName[name]\r\n   377\t\t\tif !ok {\r\n   378\t\t\t\treturn\r\n   379\t\t\t}\r\n   380\t\t\tfor _, d := range dep.Deps {\r\n   381\t\t\t\tif !seen[d] {\r\n   382\t\t\t\t\tseen[d] = true\r\n   383\t\t\t\t\tvisit(d)\r\n   384\t\t\t\t}\r\n   385\t\t\t}\r\n"]
[4751.688735, "o", "   386\t\t}\r\n   387\t\tvisit(t.Name)\r\n   388\t\r\n   389\t\tres := make([]string, 0, len(seen))\r\n   390\t\tfor k := range seen {\r\n   391\t\t\tres = append(res, k)\r\n   392\t\t}\r\n   393\t\tsort.Strings(res)\r\n   394\t\treturn res\r\n   395\t}\r\n   396\t\r\n   397\tfunc decodeHash(s string) ([]byte, error) {\r\n"]
[4751.688847, "o", "   398\t\tb, err := hex.DecodeString(s)\r\n   399\t\tif err != nil {\r\n   400\t\t\treturn nil, fmt.Errorf(\"invalid output hash: %v\", err)\r\n   401\t\t}\r\n   402\t\tif len(b) != 32 {\r\n   403\t\t\treturn nil, fmt.Errorf(\"invalid output hash length\")\r\n   404\t\t}\r\n   405\t\treturn b, nil\r\n   406\t}\r\n   407\t\r\n   408\tfunc computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {\r\n   409\t\th := sha256.New()\r\n   410\t\r\n   411\t\tsrcs := append([]string{}, t.Sources...)\r\n   412\t\tsort.Strings(srcs)\r\n"]
[4751.688925, "o", "   413\t\tfor _, src := range srcs {\r\n   414\t\t\tp := resolvePath(src, manifestDir)\r\n   415\t\t\tdata, err := os.ReadFile(p)\r\n   416\t\t\tif err != nil {\r\n   417\t\t\t\treturn \"\", fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n   418\t\t\t}\r\n   419\t\t\th.Write(data)\r\n   420\t\t}\r\n   421\t\r\n   422\t\th.Write([]byte(t.Compiler))\r\n   423\t\r\n   424"]
[4751.688996, "o", "\t\tfor _, f := range t.Flags {\r\n   425\t\t\th.Write([]byte(f))\r\n   426\t\t\th.Write([]byte(\"\\n\"))\r\n   427\t\t}\r\n   428\t\r\n   429\t\tenvs := append([]string{}, t.EnvCapture...)\r\n   430\t\tsort.Strings(envs)\r\n   431\t\tfor _, e := range envs {\r\n   432\t\t\th.Write([]byte(e + \"=\" + os.Getenv(e) + \"\\n\"))\r\n   433\t\t}\r\n   434\t\r\n   435"]
[4751.689064, "o", "\t\tdeps := append([]string{}, t.Deps...)\r\n   436\t\tsort.Strings(deps)\r\n   437\t\tfor _, d := range deps {\r\n   438\t\t\thash, ok := depHashes[d]\r\n   439\t\t\tif !ok {\r\n   440\t\t\t\treturn \"\", fmt.Errorf(\"error: missing output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n   441\t\t\t}\r\n   442\t\t\tif len(hash) != 32 {\r\n"]
[4751.689122, "o", "   443\t\t\t\treturn \"\", fmt.Errorf(\"error: invalid output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n   444\t\t\t}\r\n   445\t\t\th.Write(hash)\r\n   446\t\t}\r\n   447\t\r\n   448\t\treturn hex.EncodeToString(h.Sum(nil)), nil\r\n   449\t}\r\n"]
