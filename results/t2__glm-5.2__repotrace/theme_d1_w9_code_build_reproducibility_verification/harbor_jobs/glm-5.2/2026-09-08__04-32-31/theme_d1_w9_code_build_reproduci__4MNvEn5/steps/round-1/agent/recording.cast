[2851.632642, "o", "\t})\r\n\treturn 0\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: usage: buildvault <build|verify|inspect|audit|gc|lock|check|lock-diff> ...\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch os.Args[1] {\r\n"]
[2851.632716, "o", "\tcase \"build\":\r\n\t\tos.Exit(cmdBuild(os.Args[2:]))\r\n\tcase \"verify\":\r\n\t\tos.Exit(cmdVerify(os.Args[2:]))\r\n\tcase \"inspect\":\r\n\t\tos.Exit(cmdInspect(os.Args[2:]))\r\n\tcase \"audit\":\r\n\t\tos.Exit(cmdAudit(os.Args[2:]))\r\n\tcase \"gc\":\r\n"]
[2851.632776, "o", "\t\tos.Exit(cmdGC(os.Args[2:]))\r\n\tcase \"lock\":\r\n\t\tos.Exit(cmdLock(os.Args[2:]))\r\n\tcase \"check\":\r\n\t\tos.Exit(cmdCheck(os.Args[2:]))\r\n\tcase \"lock-diff\":\r\n\t\tos.Exit(cmdLockDiff(os.Args[2:]))\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unknown subcommand: %s\\n\", os.Args[1])\r\n\t"]
[2851.632838, "o", "\tos.Exit(1)\r\n\t}\r\n}\r\n"]
