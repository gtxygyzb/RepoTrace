[1976.483235, "o", "printJSON(struct {\r\n   603\t\t\tTargets   []targetJSON `json:\"targets\"`\r\n   604\t\t\tStoreRoot string       `json:\"store_root\"`\r\n   605\t\t}{\r\n   606\t\t\tTargets:   targets,\r\n   607\t\t\tStoreRoot: m.StoreRoot,\r\n   608\t\t})\r\n   609\t\treturn 0\r\n   610\t}\r\n"]
