[4751.389937, "o", "names := make(map[string]bool)\r\n   275\t\tfor _, t := range m.Targets {\r\n   276\t\t\tif names[t.Name] {\r\n   277\t\t\t\treturn fmt.Errorf(\"error: duplicate target name: '%s'\", t.Name)\r\n   278\t\t\t}\r\n   279\t\t\tnames[t.Name] = true\r\n   280\t\t}\r\n   281\t\r\n   282\t\tbyName := make(map[string]*Target)\r\n   283\t\tfor _, t := range m.Targets {\r\n   284\t\t\tbyName[t.Name] = t\r\n   285\t\t}\r\n   286\t"]
[4751.389998, "o", "\r\n   287\t\tfor _, t := range m.Targets {\r\n   288\t\t\tfor _, dep := range t.Deps {\r\n   289\t\t\t\tif _, ok := byName[dep]; !ok {\r\n   290\t\t\t\t\treturn fmt.Errorf(\"error: target '%s' depends on unknown target '%s'\", t.Name, dep)\r\n   291\t\t\t\t}\r\n   292\t\t\t}\r\n"]
[4751.390059, "o", "   293\t\t}\r\n   294\t\r\n   295\t\tfor _, t := range m.Targets {\r\n   296\t\t\tfor _, src := range t.Sources {\r\n   297\t\t\t\tp := resolvePath(src, manifestDir)\r\n   298\t\t\t\tif _, err := os.Stat(p); err != nil {\r\n   299\t\t\t\t\treturn fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n   300\t\t\t\t"]
