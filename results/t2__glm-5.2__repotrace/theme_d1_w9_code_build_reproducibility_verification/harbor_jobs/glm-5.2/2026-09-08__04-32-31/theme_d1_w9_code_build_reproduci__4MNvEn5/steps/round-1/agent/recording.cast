[4743.818535, "o", "}\r\n\r\nfunc applyProfile(m *Manifest, profile string) error {\r\n\tif profile == \"\" {\r\n\t\treturn nil\r\n\t}\r\n\tp, ok := m.Profiles[profile]\r\n\tif !ok {\r\n\t\treturn fmt.Errorf(\"error: unknown profile: '%s'\", profile)\r\n\t}\r\n\tfor _, t := range m.Targets {\r\n\t\tif p.Compiler != nil {\r\n\t\t\tt.Compiler = *p.Compiler\r\n\t\t}\r\n\t\tif len(p.FlagsRemove) > 0 {\r\n\t\t\tremoveSet := make(map[string]bool, len(p.FlagsRemove))\r\n\t\t\tfor _, f := range p.FlagsRemove {\r\n"]
