[2899.039893, "o", "   247\tfunc computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {\r\n   248\t\th := sha256.New()\r\n   249\t\r\n   250\t\tsrcs := append([]string{}, t.Sources...)\r\n   251\t\tsort.Strings(srcs)\r\n"]
[2899.040071, "o", "   252\t\tfor _, src := range srcs {\r\n   253\t\t\tp := resolvePath(src, manifestDir)\r\n   254\t\t\tdata, err := os.ReadFile(p)\r\n   255\t\t\tif err != nil {\r\n   256\t\t\t\treturn \"\", fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n   257\t\t\t}\r\n   258\t\t\th.Write(data)\r\n   259\t\t}\r\n   260\t\r\n   261\t\th.Write([]byte(t.Compiler))\r\n   262\t\r\n   263\t\tflags := append([]string{}, t.Flags...)\r\n   264\t\tsort.Strings(flags)\r\n   265\t\tfor _, f := range flags {\r\n   266\t\t\th.Write([]byte(f))\r\n   267\t\t\th.Write([]byte(\"\\n\"))\r\n   268\t\t}\r\n   269\t\r\n   270\t\tenvs := append([]string{}, t.EnvCapture...)\r\n   271\t\tsort.Strings(envs)\r\n   272\t\tfor _, e := range envs {\r\n   273\t\t\th.Write([]byte(e + \"=\" + os.Getenv(e) + \"\\n\"))\r\n   274\t\t}\r\n"]
[2899.040227, "o", "   275\t\r\n   276\t\tdeps := append([]string{}, t.Deps...)\r\n   277\t\tsort.Strings(deps)\r\n   278\t\tfor _, d := range deps {\r\n   279\t\t\thash, ok := depHashes[d]\r\n   280\t\t\tif !ok {\r\n   281\t\t\t\treturn \"\", fmt.Errorf(\"error: missing output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n   282\t\t\t}\r\n   283\t\t\tif len(hash) != 32 {\r\n   284\t\t\t\treturn \"\", fmt.Errorf(\"error: invalid output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n   285\t\t\t}\r\n   286\t\t\th.Write(hash)\r\n   287\t\t}\r\n   288\t\r\n   289\t\treturn hex.EncodeToString(h.Sum(nil)), nil\r\n   290\t}\r\n   291\t\r\n   292\tfunc copyFile(src, dst string) error {\r\n   293\t\tin, err := os.Open(src)\r\n   294\t\tif err != nil {\r\n   295\t\t\treturn err\r\n   296\t\t}\r\n   297\t\tdefer in.Close()\r\n   298\t\r\n   299\t\tif err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {\r\n"]
[2899.040308, "o", "   300\t\t\treturn err\r\n   301\t\t}\r\n   302\t\r\n   303\t\tout, err := os.Create(dst)\r\n   304\t\tif err != nil {\r\n   305\t\t\treturn err\r\n   306\t\t}\r\n   307\t\tif _, err := io.Copy(out, in); err != nil {\r\n   308\t\t\tout.Close()\r\n   309\t\t\treturn err\r\n"]
[2899.040383, "o", "   310\t\t}\r\n   311\t\treturn out.Close()\r\n   312\t}\r\n   313\t\r\n   314\tfunc storeArtifact(t *Target, storeRoot, fingerprint, outputHashHex, artifactPath string) error {\r\n   315\t\tdir := filepath.Join(storeRoot, \"objects\", fingerprint[:2], fingerprint)\r\n   316\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\r\n   317\t\t\treturn err\r\n   318\t\t}\r\n   319\t\r\n   320\t\tartifactDst := filepath.Join(dir, \"artifact\")\r\n   321\t\tif err := copyFile(artifactPath, artifactDst); err != nil {\r\n"]
[2899.040447, "o", "   322\t\t\treturn err\r\n   323\t\t}\r\n   324\t\r\n   325\t\tmeta := StoredMetadata{\r\n   326\t\t\tName:           t.Name,\r\n   327\t\t\tFingerprint:    fingerprint,\r\n   328\t\t\tOutputHash:     outputHashHex,\r\n   329\t\t\tCompiler:       t.Compiler,\r\n   330\t\t\tFlags:          t.Flags,\r\n"]
