[2851.348336, "o", "\r\nfunc sortedKeys(m map[string]string) []string {\r\n\tres := make([]string, 0, len(m))\r\n\tfor k := range m {\r\n\t\tres = append(res, k)\r\n\t}\r\n\tsort.Strings(res)\r\n\treturn res\r\n}\r\n\r\nfunc flagsEqual(a, b []string) bool {\r\n\tif len(a) != len(b) {\r\n\t\treturn false\r\n"]
