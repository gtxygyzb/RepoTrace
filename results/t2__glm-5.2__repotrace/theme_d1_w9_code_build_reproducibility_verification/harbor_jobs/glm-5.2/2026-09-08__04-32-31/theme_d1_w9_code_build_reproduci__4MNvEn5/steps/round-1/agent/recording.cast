[4751.390188, "o", "   309\t\r\n   310\tfunc indexString(s []string, v string) int {\r\n   311\t\tfor i, x := range s {\r\n   312\t\t\tif x == v {\r\n   313\t\t\t\treturn i\r\n   314\t\t\t}\r\n   315\t\t}\r\n   316\t\treturn -1\r\n   317\t}\r\n"]
[4751.390251, "o", "   318\t\r\n   319\tfunc topologicalOrder(m *Manifest) ([]*Target, error) {\r\n   320\t\tbyName := make(map[string]*Target)\r\n   321\t\tfor _, t := range m.Targets {\r\n   322\t\t\tbyName[t.Name] = t\r\n   323\t\t}\r\n   324\t\r\n   325\t\tstate := make(map[string]int)\r\n   326\t\tvar path []string\r\n   327\t\tvar order []*Target\r\n   328\t\r\n   329"]
[4751.390315, "o", "\t\tvar dfs func(t *Target) error\r\n   330\t\tdfs = func(t *Target) error {\r\n   331\t\t\tstate[t.Name] = 1\r\n   332\t\t\tpath = append(path, t.Name)\r\n   333\t\r\n   334\t\t\tfor _, dep := range t.Deps {\r\n   335\t\t\t\td, ok := byName[dep]\r\n   336\t\t\t\tif !ok {\r\n   337\t\t\t\t\treturn fmt.Errorf(\"error: target '%s' depends on unknown target '%s'\", t.Name, dep)\r\n   338\t\t\t\t}\r\n"]
[4751.390378, "o", "   339\t\t\t\tif state[dep] == 1 {\r\n   340\t\t\t\t\tidx := indexString(path, dep)\r\n   341\t\t\t\t\tif idx < 0 {\r\n   342\t\t\t\t\t\tidx = 0\r\n   343\t\t\t\t\t}\r\n   344\t\t\t\t\tcycle := append([]string{}, path[idx:]...)\r\n   345\t\t\t\t\tcycle = append(cycle, dep)\r\n"]
[4751.390436, "o", "   346\t\t\t\t\treturn fmt.Errorf(\"error: dependency cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n   347\t\t\t\t}\r\n   348\t\t\t\tif state[dep] == 0 {\r\n   349\t\t\t\t\tif err := dfs(d); err != nil {\r\n   350\t\t\t\t\t\treturn err\r\n   351\t\t\t\t\t}\r\n"]
[4751.390496, "o", "   352\t\t\t\t}\r\n   353\t\t\t}\r\n   354\t\r\n   355\t\t\tpath = path[:len(path)-1]\r\n   356\t\t\tstate[t.Name] = 2\r\n   357\t\t\torder = append(order, t)\r\n   358\t\t\treturn nil\r\n   359\t\t}\r\n   360\t\r\n"]
