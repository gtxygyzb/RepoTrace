[3147.556701, "o", "func computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {$\r\n^Ih := sha256.New()$\r\n$\r\n^Isrcs := append([]string{}, t.Sources...)$\r\n^Isort.Strings(srcs)$\r\n^Ifor _, src := range srcs {$\r\n^I^Ip := resolvePath(src, manifestDir)$\r\n^I^Idata, err := os.ReadFile(p)$\r\n^I^Iif err != nil {$\r\n^I^I^Ireturn \"\", fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)$\r\n^I^I}$\r\n^I^Ih.Write(data)$\r\n^I}$\r\n$\r\n^Ih.Write([]byte(t.Compiler))$\r\n$\r\n^Iflags := append([]string{}, t.Flags...)$\r\n^Isort.Strings(flags)$\r\n"]
[3147.55691, "o", "^Ifor _, f := range flags {$\r\n^I^Ih.Write([]byte(f))$\r\n^I^Ih.Write([]byte(\"\\n\"))$\r\n^I}$\r\n"]
