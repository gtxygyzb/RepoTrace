[1867.63218, "o", "   148\t\r\n   149\tfunc indexString(s []string, v string) int {\r\n   150\t\tfor i, x := range s {\r\n   151\t\t\tif x == v {\r\n   152\t\t\t\treturn i\r\n   153\t\t\t}\r\n   154\t\t}\r\n   155\t\treturn -1\r\n   156\t}\r\n"]
[1867.632235, "o", "   157\t\r\n   158\tfunc topologicalOrder(m *Manifest) ([]*Target, error) {\r\n   159\t\tbyName := make(map[string]*Target)\r\n   160\t\tfor _, t := range m.Targets {\r\n   161\t\t\tbyName[t.Name] = t\r\n   162\t\t}\r\n   163\t\r\n   164\t\t"]
[1867.632287, "o", "state := make(map[string]int)\r\n   165\t\tvar path []string\r\n   166\t\tvar order []*Target\r\n   167\t\r\n   168\t\tvar dfs func(t *Target) error\r\n   169\t\tdfs = func(t *Target) error {\r\n   170\t\t\tstate[t.Name] = 1\r\n   171"]
[1867.632336, "o", "\t\t\tpath = append(path, t.Name)\r\n   172\t\r\n   173\t\t\tfor _, dep := range t.Deps {\r\n   174\t\t\t\td, ok := byName[dep]\r\n   175\t\t\t\tif !ok {\r\n   176\t\t\t\t\treturn fmt.Errorf(\"error: target '%s' depends on unknown target '%s'\", t.Name, dep)\r\n"]
