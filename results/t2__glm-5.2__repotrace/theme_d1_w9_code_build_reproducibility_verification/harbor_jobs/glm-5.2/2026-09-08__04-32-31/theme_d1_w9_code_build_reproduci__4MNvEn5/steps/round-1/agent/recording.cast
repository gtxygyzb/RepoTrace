[1867.632441, "o", "   184\t\t\t\t\tcycle = append(cycle, dep)\r\n   185\t\t\t\t\treturn fmt.Errorf(\"error: dependency cycle detected: %s\", strings.Join(cycle, \" -> \"))\r\n   186\t\t\t\t}\r\n   187\t\t\t\tif state[dep] == 0 {\r\n   188\t\t\t\t\tif err := dfs(d); err != nil {\r\n   189\t\t\t\t\t\treturn err\r\n"]
