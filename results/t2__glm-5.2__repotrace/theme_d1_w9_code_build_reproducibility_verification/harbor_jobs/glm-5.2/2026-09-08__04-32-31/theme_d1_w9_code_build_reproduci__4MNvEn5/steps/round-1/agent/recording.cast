[2983.837628, "o", "  1007\t\t\treturn nil, fmt.Errorf(\"error: invalid lockfile: %v\", err)\r\n  1008\t\t}\r\n  1009\t\tif lf.Targets == nil {\r\n  1010\t\t\tlf.Targets = map[string]lockfileTarget{}\r\n  1011\t\t}\r\n  1012\t\tfor name, tt := range lf.Targets {\r\n  1013\t\t\tif tt.SourceHashes == nil {\r\n  1014\t\t\t\ttt.SourceHashes = map[string]string{}\r\n  1015\t\t\t\tlf.Targets[name] = tt\r\n  1016\t\t\t}\r\n  1017\t\t\tif tt.DepFingerprints == nil {\r\n  1018\t\t\t\ttt.DepFingerprints = map[string]string{}\r\n  1019\t\t\t\tlf.Targets[name] = tt\r\n"]
