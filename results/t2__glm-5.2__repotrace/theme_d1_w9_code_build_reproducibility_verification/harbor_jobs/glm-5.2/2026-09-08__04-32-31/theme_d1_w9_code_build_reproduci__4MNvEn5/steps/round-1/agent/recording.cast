[1860.116952, "o", "func cmdAudit(args []string) int {\r\n   772\t\tif len(args) < 1 {\r\n   773\t\t\tfmt.Fprintln(os.Stderr, \"error: usage: buildvault audit <manifest_path> --baseline <baseline_path>\")\r\n   774\t\t\treturn 1\r\n   775\t\t}\r\n   776\t\r\n   777\t\tmanifestPath := args[0]\r\n   778\t\trest := args[1:]\r\n   779\t\tbaselinePath := \"\"\r\n   780\t\r\n   781\t\tfor i := 0; i < len(rest); i++ {\r\n   782\t\t\tif rest[i] == \"--baseline\" {\r\n   783\t\t\t\tif i+1 >= len(rest) {\r\n   784\t\t\t\t\tfmt.Fprintln(os.Stderr, \"error: audit requires --baseline <baseline_path>\")\r\n   785\t\t\t\t\treturn 1\r\n"]
[1860.117048, "o", "   786\t\t\t\t}\r\n   787\t\t\t\tbaselinePath = rest[i+1]\r\n   788\t\t\t\ti++\r\n   789\t\t\t} else if strings.HasPrefix(rest[i], \"--baseline=\") {\r\n   790\t\t\t\tbaselinePath = rest[i][len(\"--baseline=\"):]\r\n   791\t\t\t} else {\r\n   792\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unexpected argument: %s\\n\", rest[i])\r\n   793\t\t\t\t"]
[1860.117136, "o", "return 1\r\n   794\t\t\t}\r\n   795\t\t}\r\n"]
[1860.117226, "o", "   796\t\r\n   797\t\tif baselinePath == \"\" {\r\n   798\t\t\tfmt.Fprintln(os.Stderr, \"error: audit requires --baseline <baseline_path>\")\r\n   799\t\t\treturn 1\r\n   800\t\t}\r\n   801\t\r\n   802\t\tm, dir, err := loadManifest(manifestPath)\r\n   803\t\tif err != nil {\r\n   804\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   805\t\t\treturn 1\r\n   806\t\t}\r\n   807\t\tif err := validateManifest(m, dir); err != nil {\r\n   808\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   809\t\t\treturn 1\r\n   810\t\t}\r\n"]
[1860.117326, "o", "   811\t\r\n   812\t\tresults, err := runBuild(m, dir)\r\n   813\t\tif err != nil {\r\n   814\t\t\tif errors.Is(err, errBuildFailed) {\r\n   815\t\t\t\treturn 1\r\n   816\t\t\t}\r\n   817\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   818\t\t\treturn 1\r\n   819\t\t}\r\n"]
[1860.117416, "o", "   820\t\r\n   821\t\tdata, err := os.ReadFile(baselinePath)\r\n   822\t\tif err != nil {\r\n   823\t\t\tif os.IsNotExist(err) {\r\n"]
[1860.117505, "o", "   824\t\t\t\tfmt.Fprintf(os.Stderr, \"error: baseline not found: %s\\n\", baselinePath)\r\n   825\t\t\t\treturn 1\r\n   826\t\t\t}\r\n   827\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid baseline: %v\\n\", err)\r\n   828\t\t\treturn 1\r\n   829\t\t}\r\n   830\t\r\n   831\t\tvar baseline struct {\r\n"]
[1860.117591, "o", "   832\t\t\tTargets map[string]struct {\r\n   833\t\t\t\tFingerprint string `json:\"fingerprint\"`\r\n   834\t\t\t\tOutputHash  string `json:\"output_hash\"`\r\n   835\t\t\t} `json:\"targets\"`\r\n   836\t\t}\r\n   837\t\tif err := json.Unmarshal(data, &baseline); err != nil {\r\n   838\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid baseline: %v\\n\", err)\r\n"]
[1860.117629, "o", "   839\t\t\treturn 1\r\n   840\t\t}\r\n   841\t\r\n   842\t\ttype targetJSON struct {\r\n   843\t\t\tName                string `json:\"name\"`\r\n   844\t\t\tBaselineFingerprint string `json:\"baseline_fingerprint\"`\r\n   845\t\t\tCurrentFingerprint  string `json:\"current_fingerprint\"`\r\n   846\t\t\tFingerprintMatch    bool   `json:\"fingerprint_match\"`\r\n   847\t\t\tBaselineOutputHash  string `json:\"baseline_output_hash\"`\r\n"]
[1860.11777, "o", "   848\t\t\tCurrentOutputHash   string `json:\"current_output_hash\"`\r\n   849\t\t\tOutputMatch         bool   `json:\"output_match\"`\r\n   850\t\t}\r\n   851\t\r\n   852\t\ttargets := make([]targetJSON, 0, len(results))\r\n   853\t\tmatches := true\r\n   854\t\tfor _, r := range results {\r\n   855\t\t\tvar bf, bo string\r\n   856\t\t\tentry, ok := baseline.Targets[r.Target.Name]\r\n   857\t\t\tif ok {\r\n   858\t\t\t\tbf = entry.Fingerprint\r\n   859\t\t\t\tbo = entry.OutputHash\r\n"]
[1860.117859, "o", "   860\t\t\t}\r\n   861\t\t\tfpMatch := ok && bf == r.Fingerprint\r\n   862\t\t\toutMatch := ok && bo == r.OutputHash\r\n"]
[1860.117951, "o", "   863\t\t\tif !fpMatch || !outMatch {\r\n   864\t\t\t\tmatches = false\r\n   865\t\t\t}\r\n   866\t\t\ttargets = append(targets, targetJSON{\r\n   867\t\t\t\tName:                r.Target.Name,\r\n   868\t\t\t\tBaselineFingerprint: bf,\r\n   869\t\t\t\tCurrentFingerprint:  r.Fingerprint,\r\n   870\t\t\t\tFingerprintMatch:    fpMatch,\r\n   871\t\t\t\tBaselineOutputHash:  bo,\r\n   872\t\t\t\tCurrentOutputHash:   r.OutputHash,\r\n   873\t\t\t\tOutputMatch:         outMatch,\r\n   874\t\t\t})\r\n   875\t\t}\r\n   876\t\r\n"]
[1860.118042, "o", "   877\t\tprintJSON(struct {\r\n   878\t\t\tMatches bool         `json:\"matches\"`\r\n   879\t\t\tTargets []targetJSON `json:\"targets\"`\r\n   880\t\t}{\r\n   881\t"]
[1860.118141, "o", "\t\tMatches: matches,\r\n   882\t\t\tTargets: targets,\r\n   883\t\t})\r\n   884\t\treturn 0\r\n   885\t}\r\n   886\t\r\n   887\tfunc cmdGC(args []string) int {\r\n   888\t\tif len(args) != 3 || args[0] != \"--manifest\" {\r\n"]
