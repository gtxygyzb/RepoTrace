[557.752932, "o", "package main\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n"]
[557.75302, "o", "\t\"encoding/json\"\r\n\t\"errors\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\ntype Manifest struct {\r\n\tStoreRoot string    `json:\"store_root\"`\r\n\tTargets   []*Target `json:\"targets\"`\r\n}\r\n"]
[557.753096, "o", "\r\ntype Target struct {\r\n\tName       string   `json:\"name\"`\r\n\tSources    []string `json:\"sources\"`\r\n\tCompiler   string   `json:\"compiler\"`\r\n\tFlags      []string `json:\"flags\"`\r\n\tOutput     string   `json:\"output\"`\r\n\tDeps       []string `json:\"deps\"`\r\n\tEnvCapture []string `json:\"env_capture\"`\r\n}\r\n\r\ntype StoredMetadata struct {\r\n\tName           string   `json:\"name\"`\r\n\tFingerprint    string   `json:\"fingerprint\"`\r\n"]
[557.753185, "o", "\tOutputHash     string   `json:\"output_hash\"`\r\n\tCompiler       string   `json:\"compiler\"`\r\n\tFlags          []string `json:\"flags\"`\r\n\tSources        []string `json:\"sources\"`\r\n\tBuildTimestamp string   `json:\"build_timestamp\"`\r\n}\r\n\r\ntype buildResult struct {\r\n\tTarget      *Target\r\n\tFingerprint string\r\n\tOutputHash  string\r\n\tCached      bool\r\n}\r\n\r\nvar errBuildFailed = errors.New(\"build failed\")\r\n\r\n"]
[557.753246, "o", "func resolvePath(p, base string) string {\r\n\tif p == \"\" {\r\n\t\treturn filepath.Clean(base)\r\n\t}\r\n\tif filepath.IsAbs(p) {\r\n\t\treturn filepath.Clean(p)\r\n\t}\r\n\treturn filepath.Clean(filepath.Join(base, p))\r\n}\r\n\r\nfunc normalizeTarget(t *Target) {\r\n\tif t.Sources == nil {\r\n"]
[557.753309, "o", "\t\tt.Sources = []string{}\r\n\t}\r\n\tif t.Flags == nil {\r\n\t\tt.Flags = []string{}\r\n\t}\r\n\tif t.Deps == nil {\r\n\t\tt.Deps = []string{}\r\n\t}\r\n\tif t.EnvCapture == nil {\r\n\t\tt.EnvCapture = []string{}\r\n\t}\r\n}\r\n"]
[557.753366, "o", "\r\nfunc loadManifest(path string) (*Manifest, string, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n"]
[557.753991, "o", "\u001b[?2004h"]
