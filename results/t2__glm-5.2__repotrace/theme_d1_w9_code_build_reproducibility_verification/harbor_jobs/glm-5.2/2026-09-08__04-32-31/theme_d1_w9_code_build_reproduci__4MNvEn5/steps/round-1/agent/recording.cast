[3811.678524, "o", "   609\t\t\t\tfmt.Fprintf(os.Stderr, \"[failed] %s: %s\\n\", t.Name, err.Error())\r\n   610\t\t\t\treturn nil, errBuildFailed\r\n   611\t\t\t}\r\n   612\t\t\tfmt.Fprintf(os.Stderr, \"[stored] %s %s\\n\", t.Name, fp)\r\n   613\t\r\n   614\t\t\thash, err := decodeHash(outHash)\r\n   615\t\t\tif err != nil {\r\n"]
[3811.678539, "o", "   616\t\t\t\treturn nil, err\r\n   617\t\t\t}\r\n   618\t\t\tdepHashes[t.Name] = hash\r\n   619\t\t\tresults = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: outHash, Cached: false})\r\n   620\t\t}\r\n   621\t\r\n   622\t\treturn results, nil\r\n   623\t}\r\n   624\t\r\n"]
