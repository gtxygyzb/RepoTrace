[3004.860376, "o", "\t\tif names[t.Name] {\r\n   116\t\t\t\treturn fmt.Errorf(\"error: duplicate target name: '%s'\", t.Name)\r\n   117\t\t\t}\r\n   118\t\t\tnames[t.Name] = true\r\n   119\t\t}\r\n   120\t\r\n   121\t\tbyName := make(map[string]*Target)\r\n   122\t\tfor _, t := range m.Targets {\r\n   123\t\t\tbyName[t.Name] = t\r\n   124\t\t}\r\n   125\t\r\n   126\t\tfor _, t := range m.Targets {\r\n   127\t\t\tfor _, dep := range t.Deps {\r\n   128\t\t\t\tif _, ok := byName[dep]; !ok {\r\n   129\t\t\t\t\treturn fmt.Errorf(\"error: target '%s' depends on unknown target '%s'\", t.Name, dep)\r\n   130\t\t\t\t}\r\n   131\t\t\t}\r\n   132\t\t}\r\n   133\t\r\n   134\t\t"]
