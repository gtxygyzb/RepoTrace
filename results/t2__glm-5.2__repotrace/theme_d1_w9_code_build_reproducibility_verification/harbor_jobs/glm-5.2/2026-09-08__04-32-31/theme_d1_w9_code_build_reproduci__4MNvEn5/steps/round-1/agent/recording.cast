[3794.674771, "o", "\tfor _, r := range results {\r\n  1046\t\t\tvar bf, bo string\r\n  1047\t\t\tentry, ok := baseline.Targets[r.Target.Name]\r\n  1048\t\t\tif ok {\r\n  1049\t\t\t\tbf = entry.Fingerprint\r\n  1050\t\t\t\tbo = entry.OutputHash\r\n  1051\t\t\t}\r\n  1052\t\t\tfpMatch := ok && bf == r.Fingerprint\r\n  1053\t\t\toutMatch := ok && bo == r.OutputHash\r\n  1054\t\t\tif !fpMatch || !outMatch {\r\n  1055\t\t"]
[3794.674853, "o", "\t\tmatches = false\r\n  1056\t\t\t}\r\n  1057\t\t\ttargets = append(targets, targetJSON{\r\n  1058\t\t\t\tName:                r.Target.Name,\r\n  1059\t\t\t\tBaselineFingerprint: bf,\r\n  1060\t\t\t\tCurrentFingerprint:  r.Fingerprint,\r\n"]
[3794.674932, "o", "  1061\t\t\t\tFingerprintMatch:    fpMatch,\r\n  1062\t\t\t\tBaselineOutputHash:  bo,\r\n  1063\t\t\t\tCurrentOutputHash:   r.OutputHash,\r\n  1064\t\t\t\tOutputMatch:         outMatch,\r\n"]
[3794.675011, "o", "  1065\t\t\t})\r\n  1066\t\t}\r\n  1067\t\r\n  1068\t\tprintJSON(struct {\r\n  1069\t\t\tMatches bool         `json:\"matches\"`\r\n  1070\t\t\tTargets []targetJSON `json:\"targets\"`\r\n  1071\t\t}{\r\n  1072\t\t\tMatches: matches,\r\n  1073\t\t\tTargets: targets,\r\n  1074\t\t})\r\n  1075\t\treturn 0\r\n"]
