[1903.812544, "o", "   247\tfunc computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {\r\n   248\t\th := sha256.New()\r\n   249\t\r\n   250\t\tsrcs := append([]string{}, t.Sources...)\r\n   251\t\tsort.Strings(srcs)\r\n   252\t\tfor _, src := range srcs {\r\n   253\t\t\tp := resolvePath(src, manifestDir)\r\n   254\t\t\tdata, err := os.ReadFile(p)\r\n"]
[1903.81273, "o", "   255\t\t\tif err != nil {\r\n   256\t\t\t\treturn \"\", fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n   257\t\t\t}\r\n   258\t\t\th.Write(data)\r\n   259\t\t}\r\n   260\t\r\n   261\t\th.Write([]byte(t.Compiler))\r\n   262\t\r\n   263\t\tflags := append([]string{}, t.Flags...)\r\n   264\t\tsort.Strings(flags)\r\n   265\t\tfor _, f := range flags {\r\n   266\t\t\th.Write([]byte(f))\r\n   267\t\t\th.Write([]byte(\"\\n\"))\r\n   268\t\t}\r\n   269\t\r\n   270\t\tenvs := append([]string{}, t.EnvCapture...)\r\n   271\t\tsort.Strings(envs)\r\n   272\t\tfor _, e := range envs {\r\n   273\t\t\th.Write([]byte(e + \"=\" + os.Getenv(e) + \"\\n\"))\r\n   274\t\t}\r\n   275\t\r\n   276\t\tdeps := append([]string{}, t.Deps...)\r\n   277\t\tsort.Strings(deps)\r\n   278\t\tfor _, d := range deps {\r\n"]
[1903.812835, "o", "   279\t\t\thash, ok := depHashes[d]\r\n   280\t\t\tif !ok {\r\n   281\t\t\t\treturn \"\", fmt.Errorf(\"error: missing output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n   282\t\t\t}\r\n   283\t\t\tif len(hash) != 32 {\r\n   284\t\t\t\treturn \"\", fmt.Errorf(\"error: invalid output hash for dependency '%s' (target '%s')\", d, t.Name)\r\n   285\t\t"]
[1903.812913, "o", "\t}\r\n   286\t\t\th.Write(hash)\r\n   287\t\t}\r\n   288\t\r\n   289\t\treturn hex.EncodeToString(h.Sum(nil)), nil\r\n   290\t}\r\n   291\t\r\n   292\tfunc copyFile(src, dst string) error {\r\n   293\t\tin, err := os.Open(src)\r\n   294\t\tif err != nil {\r\n   295\t\t\treturn err\r\n   296\t\t}\r\n   297\t\tdefer in.Close()\r\n   298\t\r\n   299\t\tif err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {\r\n   300\t\t\treturn err\r\n   301\t\t}\r\n   302\t\r\n"]
[1903.812978, "o", "   303\t\tout, err := os.Create(dst)\r\n   304\t\tif err != nil {\r\n   305\t\t\treturn err\r\n   306\t\t}\r\n   307\t\tif _, err := io.Copy(out, in); err != nil {\r\n   308\t\t\tout.Close()\r\n   309\t\t\treturn err\r\n   310\t\t}\r\n   311\t\treturn out.Close()\r\n   312\t}\r\n   313\t"]
[1903.813051, "o", "\r\n   314\tfunc storeArtifact(t *Target, storeRoot, fingerprint, outputHashHex, artifactPath string) error {\r\n   315\t\tdir := filepath.Join(storeRoot, \"objects\", fingerprint[:2], fingerprint)\r\n   316\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\r\n   317\t\t\treturn err\r\n   318\t\t}\r\n   319\t\r\n   320\t\tartifactDst := filepath.Join(dir, \"artifact\")\r\n   321\t"]
[1903.813114, "o", "\tif err := copyFile(artifactPath, artifactDst); err != nil {\r\n   322\t\t\treturn err\r\n   323\t\t}\r\n   324\t\r\n   325\t\tmeta := StoredMetadata{\r\n   326\t\t\tName:           t.Name,\r\n   327\t\t\tFingerprint:    fingerprint,\r\n   328\t\t\tOutputHash:     outputHashHex,\r\n"]
[1903.813173, "o", "   329\t\t\tCompiler:       t.Compiler,\r\n   330\t\t\tFlags:          t.Flags,\r\n   331\t\t\tSources:        t.Sources,\r\n   332\t\t\tBuildTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n   333\t\t}\r\n   334\t\tdata, err := jsonBytes(meta)\r\n   335\t\tif err != nil {\r\n   336\t\t\treturn err\r\n   337\t\t}\r\n   338\t\t"]
[1903.813232, "o", "return os.WriteFile(filepath.Join(dir, \"metadata.json\"), data, 0o644)\r\n   339\t}\r\n   340\t\r\n   341\tfunc readMetadata(path string) (*StoredMetadata, error) {\r\n   342\t\tdata, err := os.ReadFile(path)\r\n   343\t\tif err != nil {\r\n   344\t\t\treturn nil, err\r\n   345\t\t}\r\n   346\t\tvar meta StoredMetadata\r\n   347\t\tif err := json.Unmarshal(data, &meta); err != nil {\r\n"]
[1903.813295, "o", "   348\t\t\treturn nil, err\r\n   349\t\t}\r\n   350\t\tif _, err := decodeHash(meta.OutputHash); err != nil {\r\n   351\t\t\treturn nil, err\r\n   352\t\t}\r\n   353\t\treturn &meta, nil\r\n   354\t}\r\n   355\t\r\n   356\tfunc compileTargetInDir(t *Target, sourceDir string) (scratchDir, outputPath, outputHash string, err error) {\r\n   357\t\tscratchDir, err = os.MkdirTemp(\"\", \"buildvault-build-*\")\r\n"]
[1903.813353, "o", "   358\t\tif err != nil {\r\n   359\t\t\treturn \"\", \"\", \"\", err\r\n   360\t\t}\r\n   361\t\r\n   362\t\toutputPath = filepath.Join(scratchDir, \"out\", t.Output)\r\n   363\t\tif err := os.MkdirAll(filepath.Dir(outputPath), 0o755); err != nil {\r\n   364\t\t\treturn scratchDir, \"\", \"\", err\r\n   365\t\t}\r\n   366\t\r\n   367\t\t"]
[1903.813411, "o", "args := make([]string, 0, len(t.Flags)+len(t.Sources)+2)\r\n   368\t\targs = append(args, t.Flags...)\r\n   369\t\targs = append(args, \"-o\", outputPath)\r\n   370\t\tfor _, src := range t.Sources {\r\n   371\t\t\targs = append(args, resolvePath(src, sourceDir))\r\n   372\t\t}\r\n   373\t\r\n"]
[1903.813474, "o", "   374\t\tcmd := exec.Command(t.Compiler, args...)\r\n   375\t\tcmd.Dir = sourceDir\r\n   376\t\tout, err := cmd.CombinedOutput()\r\n   377\t\tif err != nil {\r\n   378\t\t\tdetail := strings.TrimSpace(string(out))\r\n   379\t\t\tif detail == \"\" {\r\n   380\t\t\t\tdetail = err.Error()\r\n   381\t\t\t}\r\n   382\t\t\treturn scratchDir, \"\", \"\", errors.New(detail)\r\n"]
[1903.813531, "o", "   383\t\t}\r\n   384\t\r\n   385\t\tdata, err := os.ReadFile(outputPath)\r\n   386\t\tif err != nil {\r\n   387\t\t\treturn scratchDir, \"\", \"\", fmt.Errorf(\"output artifact not found: %v\", err)\r\n   388\t\t}\r\n   389\t\tsum := sha256.Sum256(data)\r\n   390\t"]
[1903.813617, "o", "\toutputHash = hex.EncodeToString(sum[:])\r\n   391\t\treturn scratchDir, outputPath, outputHash, nil\r\n   392\t}\r\n   393\t\r\n   394\tfunc buildAndStoreTarget(t *Target, sourceDir, storeRoot, fingerprint string) (string, error) {\r\n   395\t\tscratch, outputPath, outHash, err := compileTargetInDir(t, sourceDir)\r\n   396\t\tif scratch != \"\" {\r\n"]
[1903.813754, "o", "   397\t\t\tdefer os.RemoveAll(scratch)\r\n   398\t\t}\r\n   399\t\tif err != nil {\r\n   400\t\t\treturn \"\", err\r\n   401\t\t}\r\n   402\t\tif err := storeArtifact(t, storeRoot, fingerprint, outHash, outputPath); err != nil {\r\n   403\t\t\treturn \"\", err\r\n   404\t\t}\r\n   405\t\treturn outHash, nil\r\n   406\t}\r\n   407\t\r\n   408\tfunc compileFresh(t *Target, sourceDir string) (string, error) {\r\n   409\t\tscratch, _, outHash, err := compileTargetInDir(t, sourceDir)\r\n   410\t\tif scratch != \"\" {\r\n   411\t\t\tdefer os.RemoveAll(scratch)\r\n   412\t\t}\r\n   413\t\treturn outHash, err\r\n   414\t}\r\n   415\t\r\n   416\tfunc runBuild(m *Manifest, manifestDir string) ([]buildResult, error) {\r\n   417\t\torder, err := topologicalOrder(m)\r\n   418\t\tif err != nil {\r\n   419\t\t\treturn nil, err\r\n   420\t\t}\r\n   421\t"]
[1903.813831, "o", "\r\n   422\t\tdepHashes := make(map[string][]byte)\r\n   423\t\tresults := make([]buildResult, 0, len(order))\r\n   424\t\r\n   425\t\tfor _, t := range order {\r\n   426\t\t\tfp, err := computeFingerprint(t, manifestDir, depHashes)\r\n   427\t\t\tif err != nil {\r\n   428\t\t\t\treturn nil, err\r\n   429\t\t\t}\r\n   430\t\r\n   431\t\t\t"]
[1903.813917, "o", "metaPath := filepath.Join(m.StoreRoot, \"objects\", fp[:2], fp, \"metadata.json\")\r\n   432\t\t\tif _, err := os.Stat(metaPath); err == nil {\r\n   433\t\t\t\tmeta, err := readMetadata(metaPath)\r\n   434\t\t\t\tif err != nil {\r\n   435\t\t\t\t\treturn nil, fmt.Errorf(\"error: cache metadata read failed for target '%s': %v\", t.Name, err)\r\n   436\t\t\t\t}\r\n   437\t\t\t\thash, err := decodeHash(meta.OutputHash)\r\n   438\t\t\t\tif err != nil {\r\n   439\t\t\t\t\treturn nil, fmt.Errorf(\"error: cache metadata read failed for target '%s': %v\", t.Name, err)\r\n   440\t\t\t\t}\r\n"]
[1903.813986, "o", "   441\t\t\t\tfmt.Fprintf(os.Stderr, \"[cache hit] %s\\n\", t.Name)\r\n   442\t\t\t\tdepHashes[t.Name] = hash\r\n   443\t\t\t\tresults = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: meta.OutputHash, Cached: true})\r\n   444\t\t\t\tcontinue\r\n   445\t\t\t}\r\n   446\t\r\n   447\t\t\tfmt.Fprintf(os.Stderr, \"[building] %s\\n\", t.Name)\r\n   448\t\t\toutHash, err := buildAndStoreTarget(t, manifestDir, m.StoreRoot, fp)\r\n"]
[1903.81406, "o", "   449\t\t\tif err != nil {\r\n   450\t\t\t\tfmt.Fprintf(os.Stderr, \"[failed] %s: %s\\n\", t.Name, err.Error())\r\n   451\t\t\t\treturn nil, errBuildFailed\r\n   452\t\t\t}\r\n   453\t\t\tfmt.Fprintf(os.Stderr, \"[stored] %s %s\\n\", t.Name, fp)\r\n   454\t\r\n   455\t\t\thash, err := decodeHash(outHash)\r\n   456\t\t\tif err != nil {\r\n   457\t\t\t\treturn nil, err\r\n   458\t\t\t}\r\n   459\t\t\t"]
[1903.814121, "o", "depHashes[t.Name] = hash\r\n   460\t\t\tresults = append(results, buildResult{Target: t, Fingerprint: fp, OutputHash: outHash, Cached: false})\r\n   461\t\t}\r\n   462\t\r\n   463\t\treturn results, nil\r\n   464\t}\r\n   465\t\r\n"]
