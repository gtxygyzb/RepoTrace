[3794.674317, "o", "  1007\t\t\t}\r\n  1008\t\t\tfmt.Fprintln(os.Stderr, err)\r\n  1009\t\t\treturn 1\r\n  1010\t\t}\r\n  1011\t\r\n  1012\t\tdata, err := os.ReadFile(baselinePath)\r\n  1013\t\tif err != nil {\r\n"]
[3794.674399, "o", "  1014\t\t\tif os.IsNotExist(err) {\r\n  1015\t\t\t\tfmt.Fprintf(os.Stderr, \"error: baseline not found: %s\\n\", baselinePath)\r\n  1016\t\t\t\treturn 1\r\n  1017\t\t\t}\r\n  1018\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid baseline: %v\\n\", err)\r\n  1019\t\t\treturn 1\r\n  1020\t\t}\r\n  1021\t\r\n  1022\t\tvar baseline struct {\r\n"]
[3794.674482, "o", "  1023\t\t\tTargets map[string]struct {\r\n  1024\t\t\t\tFingerprint string `json:\"fingerprint\"`\r\n  1025\t\t\t\tOutputHash  string `json:\"output_hash\"`\r\n  1026\t\t\t} `json:\"targets\"`\r\n  1027\t\t}\r\n  1028\t\tif err := json.Unmarshal(data, &baseline); err != nil {\r\n  1029\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid baseline: %v\\n\", err)\r\n"]
[3794.674564, "o", "  1030\t\t\treturn 1\r\n  1031\t\t}\r\n  1032\t\r\n  1033\t\ttype targetJSON struct {\r\n  1034\t\t\tName                string `json:\"name\"`\r\n  1035\t\t\tBaselineFingerprint string `json:\"baseline_fingerprint\"`\r\n  1036\t\t\tCurrentFingerprint  string `json:\"current_fingerprint\"`\r\n  1037\t\t\tFingerprintMatch    bool   `json:\"fingerprint_match\"`\r\n"]
