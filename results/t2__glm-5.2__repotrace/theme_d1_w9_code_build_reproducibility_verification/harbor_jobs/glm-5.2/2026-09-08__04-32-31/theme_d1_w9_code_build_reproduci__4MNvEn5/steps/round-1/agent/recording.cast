[3820.891911, "o", "     7\t\t\"encoding/json\"\r\n     8\t\t\"errors\"\r\n     9\t\t\"fmt\"\r\n    10\t\t\"io\"\r\n    11\t\t\"os\"\r\n    12\t\t\"os/exec\"\r\n    13\t\t\"path/filepath\"\r\n    14\t\t\"sort\"\r\n    15\t\t\"strings\"\r\n    16\t\t\"time\"\r\n    17\t)\r\n    18\t\r\n    19\ttype Manifest struct {\r\n    20\t\tStoreRoot string             `json:\"store_root\"`\r\n    21\t\tProfiles  map[string]Profile `json:\"profiles,omitempty\"`\r\n    22\t\tTargets   []*Target          `json:\"targets\"`\r\n    23\t}\r\n    24\t\r\n    25\ttype Target struct {\r\n    26\t\tName       string   `json:\"name\"`\r\n    27\t\tSources    []string `json:\"sources\"`\r\n    28\t\tCompiler   string   `json:\"compiler\"`\r\n"]
[3820.892032, "o", "    29\t\tFlags      []string `json:\"flags\"`\r\n    30\t\tOutput     string   `json:\"output\"`\r\n    31\t\tDeps       []string `json:\"deps\"`\r\n    32\t\tEnvCapture []string `json:\"env_capture\"`\r\n    33\t}\r\n    34\t\r\n    35\ttype Profile struct {\r\n    36\t\tCompiler         *string  `json:\"compiler,omitempty\"`\r\n    37\t\tFlagsAppend      []string `json:\"flags_append,omitempty\"`\r\n    38\t\tFlagsRemove      []string `json:\"flags_remove,omitempty\"`\r\n    39\t\tEnvCaptureAppend []string `json:\"env_capture_append,omitempty\"`\r\n    40\t}\r\n    41\t\r\n    42\ttype StoredMetadata struct {\r\n    43\t\tName           string   `json:\"name\"`\r\n    44\t\tFingerprint    string   `json:\"fingerprint\"`\r\n    45\t\t"]
[3820.892133, "o", "OutputHash     string   `json:\"output_hash\"`\r\n    46\t\tCompiler       string   `json:\"compiler\"`\r\n    47\t\tFlags          []string `json:\"flags\"`\r\n    48\t\tSources        []string `json:\"sources\"`\r\n    49\t\tBuildTimestamp string   `json:\"build_timestamp\"`\r\n    50\t}"]
[3820.89223, "o", "\r\n    51\t\r\n    52\ttype buildResult struct {\r\n    53\t\tTarget      *Target\r\n    54\t\tFingerprint string\r\n    55\t\tOutputHash  string\r\n    56\t\tCached      bool\r\n    57\t}\r\n    58\t\r\n    59\tvar errBuildFailed = errors.New(\"build failed\")\r\n    60\t\r\n    61\tfunc resolvePath(p, base string) string {\r\n    62\t\tif p == \"\" {\r\n    63\t\t\treturn filepath.Clean(base)\r\n    64\t\t}\r\n    65\t\tif filepath.IsAbs(p) {\r\n    66\t\t\treturn filepath.Clean(p)\r\n    67"]
[3820.892329, "o", "\t\t}\r\n    68\t\treturn filepath.Clean(filepath.Join(base, p))\r\n    69\t}\r\n    70\t\r\n    71\tfunc normalizeTarget(t *Target) {\r\n    72\t\tif t.Sources == nil {\r\n    73\t\t\tt.Sources = []string{}\r\n    74\t\t}\r\n    75\t\tif t.Flags == nil {\r\n    76\t\t\tt.Flags = []string{}\r\n    77\t\t}\r\n    78\t\tif t.Deps == nil {\r\n    79\t\t\tt.Deps = []string{}\r\n    80\t\t}\r\n"]
[3820.892429, "o", "    81\t\tif t.EnvCapture == nil {\r\n    82\t\t\tt.EnvCapture = []string{}\r\n    83\t\t}\r\n    84\t}\r\n    85\t\r\n    86\tfunc loadManifest(path string) (*Manifest, string, error) {\r\n    87\t\tdata, err := os.ReadFile(path)\r\n    88\t\tif err != nil {\r\n    89\t\t\tif os.IsNotExist(err) {\r\n    90\t\t\t\treturn nil, \"\", fmt.Errorf(\"error: manifest not found: %s\", path)\r\n    91\t\t\t}\r\n    92\t\t\treturn nil, \"\", fmt.Errorf(\"error: invalid manifest: %v\", err)\r\n    93\t\t}\r\n    94\t\r\n    95\t\tvar raw struct {\r\n    96\t\t\tStoreRoot string          `json:\"store_root\"`\r\n    97\t\t\tProfiles  json.RawMessage `json:\"profiles\"`\r\n    98\t\t\tTargets   []*Target       `json:\"targets\"`\r\n    99\t\t}\r\n   100\t\tif err := json.Unmarshal(data, &raw); err != nil {\r\n   101\t\t\treturn nil, \"\", fmt.Errorf(\"error: invalid manifest: %v\", err)\r\n   102\t\t}\r\n   103\t\r\n   104\t\tm := Manifest{\r\n   105\t\t\tStoreRoot: raw.StoreRoot,\r\n   106\t\t\tTargets:   raw.Targets,\r\n"]
[3820.892526, "o", "   107\t\t}\r\n   108\t\r\n   109\t\tif len(raw.Profiles) > 0 {\r\n   110\t\t\tvar rawProfiles map[string]json.RawMessage\r\n   111\t\t\tif err := json.Unmarshal(raw.Profiles, &rawProfiles); err != nil {\r\n   112\t\t\t\treturn nil, \"\", fmt.Errorf(\"error: invalid manifest: profiles must be an object\")\r\n   113\t\t\t}\r\n   114\t\t\tm.Profiles = make(map[string]Profile, len(rawProfiles))\r\n   115\t\t\tfor name, rawProfile := range rawProfiles {\r\n"]
