[2880.507163, "o", "   227\t\r\n   228\t\tres := make([]string, 0, len(seen))\r\n   229\t\tfor k := range seen {\r\n   230\t\t\tres = append(res, k)\r\n   231\t\t}\r\n   232\t\tsort.Strings(res)\r\n   233\t\treturn res\r\n   234\t}\r\n   235\t\r\n"]
[2880.507221, "o", "   236\tfunc decodeHash(s string) ([]byte, error) {\r\n   237\t\tb, err := hex.DecodeString(s)\r\n   238\t\tif err != nil {\r\n   239\t\t\treturn nil, fmt.Errorf(\"invalid output hash: %v\", err)\r\n   240\t\t}\r\n   241\t\tif len(b) != 32 {\r\n   242\t\t\treturn nil, fmt.Errorf(\"invalid output hash length\")\r\n"]
[2880.507286, "o", "   243\t\t}\r\n   244\t\treturn b, nil\r\n   245\t}\r\n   246\t\r\n   247\tfunc computeFingerprint(t *Target, manifestDir string, depHashes map[string][]byte) (string, error) {\r\n   248\t\th := sha256.New()\r\n   249\t\r\n   250\t\tsrcs := append([]string{}, t.Sources...)\r\n   251\t\tsort.Strings(srcs)\r\n   252\t\tfor _, src := range srcs {\r\n"]
[2880.507348, "o", "   253\t\t\tp := resolvePath(src, manifestDir)\r\n   254\t\t\tdata, err := os.ReadFile(p)\r\n   255\t\t\tif err != nil {\r\n   256\t\t\t\treturn \"\", fmt.Errorf(\"error: source file not found: %s (target '%s')\", src, t.Name)\r\n   257\t\t\t}\r\n   258\t\t\th.Write(data)\r\n   259\t\t}\r\n   260\t\r\n"]
