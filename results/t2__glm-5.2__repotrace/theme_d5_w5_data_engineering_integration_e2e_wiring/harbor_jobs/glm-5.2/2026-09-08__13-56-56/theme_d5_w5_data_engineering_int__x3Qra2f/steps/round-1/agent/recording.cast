[2263.969836, "o", "package record\r\n\r\ntype Record struct {\r\n\tOrder    []string\r\n\tValues   map[string]string\r\n\tInputRow int\r\n"]
[2263.969939, "o", "}\r\n\r\nfunc New() *Record {\r\n\treturn &Record{\r\n\t\tOrder:  []string{},\r\n"]
[2263.970008, "o", "\t\tValues: map[string]string{},\r\n\t}\r\n}\r\n\r\nfunc (r *Record) Set(key, val string) {\r\n\tif _, ok := r.Values[key]; !ok {\r\n\t\tr.Order = append(r.Order, key)\r\n\t}\r\n\tr.Values[key] = val\r\n}\r\n\r\nfunc (r *Record) Get(key string) (string, bool) {\r\n\tv, ok := r.Values[key]\r\n\treturn v, ok\r\n}\r\n\r\nfunc (r *Record) Has(key string) bool {\r\n\t_, ok := r.Values[key]\r\n\treturn ok\r\n}\r\n\r\nfunc (r *Record) Copy() *Record {\r\n\tnr := New()\r\n\tnr.InputRow = r.InputRow\r\n\tfor _, k := range r.Order {\r\n"]
[2263.970086, "o", "\t\tnr.Set(k, r.Values[k])\r\n\t}\r\n\treturn nr\r\n}\r\n"]
