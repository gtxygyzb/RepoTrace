[2275.407134, "o", "\t\"example.com/flowctl/internal/input\"\r\n     8\t\t\"example.com/flowctl/internal/output\"\r\n     9\t\t\"example.com/flowctl/internal/stage\"\r\n    10\t)\r\n    11\t\r\n    12\tfunc Run(cfg *config.Config) (*stage.Stats, error) {\r\n    13\t\tstats := &stage.Stats{}\r\n    14\t\r\n    15\t\tstages, err := stage.Build(cfg.Stages)\r\n    16\t\tif err != nil {\r\n    17\t\t\treturn stats, err\r\n    18\t\t}\r\n    19\t\r\n    20\t\trecords, err := input.Read(cfg.Input, cfg.Dir)\r\n"]
