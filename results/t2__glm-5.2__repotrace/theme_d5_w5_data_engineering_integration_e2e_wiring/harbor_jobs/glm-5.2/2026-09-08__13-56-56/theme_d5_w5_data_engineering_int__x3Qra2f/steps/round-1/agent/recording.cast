[2341.065916, "o", "package stage\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"math\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\r\n"]
[2341.066041, "o", "\t\"example.com/flowctl/internal/record\"\r\n)\r\n\r\ntype Stats struct {\r\n\tProcessed         int\r\n\tEmitted           int\r\n\tDroppedNonNumeric int\r\n\tDroppedMissing    int\r\n\tmissingReported   bool\r\n}\r\n\r\ntype Stage interface {\r\n\tApply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error)\r\n}\r\n\r\nfunc Build(rawStages []map[string]interface{}) ([]Stage, error) {\r\n\tstages := make([]Stage, 0, len(rawStages))\r\n\tfor i, sm := range rawStages {\r\n\t\ttyp, ok := getString(sm, \"type\")\r\n\t\tif !ok || typ == \"\" {\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: type is required\", i+1)\r\n\t\t}\r\n\r\n\t\tvar st Stage\r\n\t"]
[2341.066142, "o", "\tvar err error\r\n\t\tswitch typ {\r\n\t\tcase \"filter\":\r\n\t\t\tst, err = buildFilter(i+1, sm)\r\n\t\tcase \"project\":\r\n\t\t\tst, err = buildProject(i+1, sm)\r\n\t\tcase \"sort\":\r\n\t\t\tst, err = buildSort(i+1, sm)\r\n\t\tcase \"limit\":\r\n\t\t\tst, err = buildLimit(i+1, sm)\r\n\t\tdefault:\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: unknown stage type %q\", i+1, typ)\r\n\t\t}\r\n"]
[2341.066233, "o", "\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tstages = append(stages, st)\r\n\t}\r\n\treturn stages, nil\r\n}\r\n\r\ntype FilterStage struct {\r\n"]
[2341.066295, "o", "\tcolumn string\r\n\top     string\r\n\tvalue  string\r\n}\r\n\r\nfunc (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\r\n\tout := make([]*record.Record, 0, len(in))\r\n\r\n\tfor _, r := range in {\r\n\t\tv, ok := r.Get(s.column)\r\n\t\tif !ok {\r\n\t\t\tstats.DroppedMissing++\r\n\t\t\tif !stats.missingReported {\r\n\t\t\t\tfmt.Fprintf(stderr, \"flowctl: filter: missing column %s\\n\", s.column)\r\n"]
[2341.066354, "o", "\t\t\t\tstats.missingReported = true\r\n\t\t\t}\r\n\t\t\tif strict {\r\n\t\t\t\treturn nil, fmt.Errorf(\"filter: missing column %s\", s.column)\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[2341.066413, "o", "\r\n\t\tkeep := false\r\n\t\tswitch s.op {\r\n\t\tcase \"==\":\r\n\t\t\tkeep = v == s.value\r\n\t\tcase \"!=\":\r\n\t\t\tkeep = v != s.value\r\n\t\tdefault:\r\n\t\t\tleft, err := parseFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\tstats.DroppedNonNumeric++\r\n\t\t\t\tfmt.Fprintf(stderr, \"flowctl: filter: drop non-numeric row %d\\n\", r.InputRow)\r\n\t\t\t\tif strict {\r\n"]
[2341.066471, "o", "\t\t\t\t\treturn nil, fmt.Errorf(\"filter: drop non-numeric row %d\", r.InputRow)\r\n\t\t\t\t}\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tright, err := parseFloat(s.value)\r\n\t\t\tif err != nil {\r\n\t\t\t\tstats.DroppedNonNumeric++\r\n"]
[2341.066546, "o", "\t\t\t\tfmt.Fprintf(stderr, \"flowctl: filter: drop non-numeric row %d\\n\", r.InputRow)\r\n\t\t\t\tif strict {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"filter: drop non-numeric row %d\", r.InputRow)\r\n\t\t\t\t}\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tkeep = compareFloats(left, s.op, right)\r\n\t\t}\r\n\r\n\t\tif keep {\r\n\t\t\tout = append(out, r)\r\n\t\t}\r\n"]
[2341.066602, "o", "\t}\r\n\r\n\treturn out, nil\r\n}\r\n\r\ntype ProjectColumn struct {\r\n\tSource string\r\n\tTarget string\r\n}\r\n\r\ntype ProjectStage struct {\r\n"]
[2341.066659, "o", "\tcolumns []ProjectColumn\r\n}\r\n\r\nfunc (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\r\n\tout := make([]*record.Record, 0, len(in))\r\n\tfor _, r := range in {\r\n\t\tnr := record.New()\r\n\t\tnr.InputRow = r.InputRow\r\n\t\tfor _, c := range s.columns {\r\n"]
[2341.066717, "o", "\t\t\tval := \"\"\r\n\t\t\tif v, ok := r.Get(c.Source); ok {\r\n\t\t\t\tval = v\r\n\t\t\t}\r\n\t\t\tnr.Set(c.Target, val)\r\n\t\t}\r\n\t\tout = append(out, nr)\r\n\t}\r\n"]
[2341.066795, "o", "\treturn out, nil\r\n}\r\n\r\ntype SortKey struct {\r\n\tColumn string\r\n\tOrder  string\r\n\tAs     string\r\n}\r\n\r\ntype SortStage struct {\r\n\tkeys []SortKey\r\n}\r\n"]
[2341.066858, "o", "\r\nfunc (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\r\n\tfor _, key := range s.keys {\r\n\t\tif key.As == \"number\" {\r\n\t\t\tfor _, r := range in {\r\n\t\t\t\tv, ok := r.Get(key.Column)\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"sort: column %s is missing\", key.Column)\r\n\t\t\t\t}\r\n\t\t\t\tif _, err := parseFloat(v); err != nil {\r\n"]
[2341.066926, "o", "\t\t\t\t\treturn nil, fmt.Errorf(\"sort: column %s value %q is not a number\", key.Column, v)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tsort.SliceStable(in, func(i, j int) bool {\r\n\t\tfor _, key := range s.keys {\r\n\t\t\ta, _ := in[i].Get(key.Column)\r\n\t"]
[2341.066983, "o", "\t\tb, _ := in[j].Get(key.Column)\r\n\r\n\t\t\tif key.As == \"number\" {\r\n\t\t\t\taf, _ := parseFloat(a)\r\n\t\t\t\tbf, _ := parseFloat(b)\r\n\t\t\t\tif af != bf {\r\n\t"]
[2341.067039, "o", "\t\t\t\tif key.Order == \"desc\" {\r\n\t\t\t\t\t\treturn af > bf\r\n\t\t\t\t\t}\r\n\t\t\t\t\treturn af < bf\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tif a != b {\r\n"]
[2341.067093, "o", "\t\t\t\t\tif key.Order == \"desc\" {\r\n\t\t\t\t\t\treturn a > b\r\n\t\t\t\t\t}\r\n\t\t\t\t\treturn a < b\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn false\r\n"]
[2341.067148, "o", "\t})\r\n\r\n\treturn in, nil\r\n}\r\n\r\ntype LimitStage struct {\r\n\tcount int\r\n}\r\n\r\n"]
[2341.067205, "o", "func (s *LimitStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\r\n\tif s.count < len(in) {\r\n\t\treturn in[:s.count], nil\r\n\t}\r\n\treturn in, nil\r\n}\r\n\r\nfunc buildFilter(idx int, sm map[string]interface{}) (Stage, error) {\r\n\twhereRaw, ok := sm[\"where\"]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: filter.where is required\", idx)\r\n"]
[2341.067267, "o", "\t}\r\n\twhere, ok := whereRaw.(map[string]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: filter.where must be a mapping\", idx)\r\n\t}\r\n\r\n\tcolumn, ok := getString(where, \"column\")\r\n\tif !ok || column == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: filter.where.column is required\", idx)\r\n"]
[2341.067347, "o", "\t}\r\n\r\n\top, ok := getString(where, \"op\")\r\n\tif !ok || op == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: filter.where.op is required\", idx)\r\n\t}\r\n\tswitch op {\r\n\tcase \"==\", \"!=\", \"<\", \"<=\", \">\", \">=\":\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: filter.where.op is invalid\", idx)\r\n\t}\r\n\r\n\tvalue, ok := getString(where, \"value\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: filter.where.value is required\", idx)\r\n"]
[2341.067415, "o", "\t}\r\n\r\n\treturn &FilterStage{column: column, op: op, value: value}, nil\r\n}\r\n\r\nfunc buildProject(idx int, sm map[string]interface{}) (Stage, error) {\r\n\tcolsRaw, ok := sm[\"columns\"]\r\n\tif !ok {\r\n"]
[2341.06797, "o", "\u001b[?2004h"]
