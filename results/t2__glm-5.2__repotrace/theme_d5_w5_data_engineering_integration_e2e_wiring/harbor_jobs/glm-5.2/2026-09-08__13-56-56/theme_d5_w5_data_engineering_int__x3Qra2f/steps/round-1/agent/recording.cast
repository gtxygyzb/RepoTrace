[2612.732696, "o", "\\t\\t_ = st\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2612.732764, "o", "\\t\\tfor i, col := range s.by {\r\n\u001b[?2004l\r\u001b[?2004h> "]
