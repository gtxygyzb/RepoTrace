[1718.121589, "o", "        if !ok || column == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.121738, "o", "            return nil, fmt.Errorf(\"config: stage %d: sort key %d column is required\", idx, j+1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.121808, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.121873, "o", "        order, ok := getString(km, \"order\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.121922, "o", "        if !ok || order == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.121972, "o", "            order = \"asc\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.12203, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.12208, "o", "        if order != \"asc\" && order != \"desc\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.122238, "o", "            return nil, fmt.Errorf(\"config: stage %d: sort key %d order must be asc or desc\", idx, j+1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.122292, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.122351, "o", "        as, ok := getString(km, \"as\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.122407, "o", "        if !ok || as == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.122457, "o", "            as = \"string\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.122512, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.122577, "o", "        if as != \"string\" && as != \"number\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.122735, "o", "            return nil, fmt.Errorf(\"config: stage %d: sort key %d as must be string or number\", idx, j+1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
