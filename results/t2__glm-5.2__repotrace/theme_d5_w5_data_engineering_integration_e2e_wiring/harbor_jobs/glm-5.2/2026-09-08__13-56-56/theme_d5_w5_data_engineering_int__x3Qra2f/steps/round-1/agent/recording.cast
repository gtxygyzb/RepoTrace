[1080.596273, "o", "sed -n '1,80p' internal/record/record.go 2>/dev/null || true\r\n\u001b[?2004l\r"]
[1080.59946, "o", "package record\r\n\r\n// Record is an ordered string-to-string record.\r\n// Order preserves the first-seen field order for the record.\r\ntype Record struct {\r\nOrder   []string\r\nValues  map[string]string\r\nInputRow int\r\n"]
[1080.599613, "o", "}\r\n\r\nfunc New() *Record {\r\nreturn &Record{\r\nOrder:  []string{},\r\nValues: map[string]string{},\r\n}\r\n}\r\n\r\nfunc (r *Record) Set(key, val string) {\r\nif _, ok := r.Values[key]; !ok {\r\nr.Order = append(r.Order, key)\r\n}\r\nr.Values[key] = val\r\n}\r\n\r\nfunc (r *Record) Get(key string) (string, bool) {\r\nv, ok := r.Values[key]\r\nreturn v, ok\r\n}\r\n\r\nfunc (r *Record) Has(key string) bool {\r\n_, ok := r.Values[key]\r\nreturn ok\r\n}\r\n"]
[1080.599749, "o", "\r\nfunc (r *Record) Copy() *Record {\r\nnr := New()\r\nnr.InputRow = r.InputRow\r\nfor _, k := range r.Order {\r\nnr.Set(k, r.Values[k])\r\n}\r\nreturn nr\r\n}\r\n"]
[1080.600072, "o", "\u001b[?2004hroot@n30009:/app# "]
[1080.861055, "i", "sed -n '1,80p' internal/config/config.go 2>/dev/null || true\n"]
[1080.861292, "o", "sed -n '1,80p' internal/config/config.go 2>/dev/null || true\r\n\u001b[?2004l\r"]
[1080.864298, "o", "package config\r\n\r\nimport (\r\n\"bufio\"\r\n\"bytes\"\r\n"]
[1080.864419, "o", "\"fmt\"\r\n\"os\"\r\n\"path/filepath\"\r\n\"strconv\"\r\n\"strings\"\r\n)\r\n\r\ntype InputConfig struct {\r\nPath   string\r\nFormat string\r\n}\r\n\r\ntype OutputConfig struct {\r\nPath           string\r\nFormat         string\r\nColumns        []string\r\nColumnsPresent bool\r\n}\r\n\r\ntype Config struct {\r\nDir    string\r\nStrict bool\r\nInput  InputConfig\r\nStages []map[string]interface{}\r\nOutput OutputConfig\r\n}"]
[1080.86455, "o", "\r\n\r\nfunc Load(path string) (*Config, error) {\r\ndata, err := os.ReadFile(path)\r\nif err != nil {\r\nreturn nil, fmt.Errorf(\"config: %v\", err)\r\n}\r\n\r\nroot, err := parseYAML(data)\r\nif err != nil {\r\nreturn nil, fmt.Errorf(\"config: %v\", err)\r\n}\r\n\r\nm, ok := root.(map[string]interface{})\r\nif !ok {\r\nreturn nil, fmt.Errorf(\"config: top-level value must be a mapping\")\r\n}\r\n\r\ncfg := &Config{Dir: filepath.Dir(path)}\r\n\r\ninRaw, ok := m[\"input\"]\r\nif !ok {\r\nreturn nil, fmt.Errorf(\"config: input is required\")\r\n}\r\ninMap, ok := inRaw.(map[string]interface{})\r\nif !ok {\r\n"]
[1080.864649, "o", "return nil, fmt.Errorf(\"config: input must be a mapping\")\r\n}\r\ncfg.Input.Path = getString(inMap, \"path\")\r\nif cfg.Input.Path == \"\" {\r\nreturn nil, fmt.Errorf(\"config: input.path is required\")\r\n}\r\ncfg.Input.Format = getString(inMap, \"format\")\r\nif cfg.Input.Format == \"\" {\r\nreturn nil, fmt.Errorf(\"config: input.format is required\")\r\n}\r\nif cfg.Input.Format != \"csv\" && cfg.Input.Format != \"ndjson\" {\r\nreturn nil, fmt.Errorf(\"config: input.format must be csv or ndjson\")\r\n}\r\n\r\n"]
