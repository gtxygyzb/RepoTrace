[2274.523993, "o", "     1\tpackage record\r\n     2\t\r\n     3\ttype Record struct {\r\n     4\t\tOrder    []string\r\n     5\t\tValues   map[string]string\r\n     6\t\tInputRow int\r\n"]
[2274.52421, "o", "     7\t}\r\n     8\t\r\n     9\tfunc New() *Record {\r\n    10\t\treturn &Record{\r\n    11\t\t\tOrder:  []string{},\r\n    12\t\t\tValues: map[string]string{},\r\n    13\t\t}\r\n    14\t}\r\n    15\t\r\n    16\tfunc (r *Record) Set(key, val string) {\r\n    17\t\tif _, ok := r.Values[key]; !ok {\r\n    18\t\t\tr.Order = append(r.Order, key)\r\n    19\t\t}\r\n    20\t\tr.Values[key] = val\r\n    21\t}\r\n    22\t\r\n    23\tfunc (r *Record) Get(key string) (string, bool) {\r\n    24\t\tv, ok := r.Values[key]\r\n    25\t\treturn v, ok\r\n    26\t}\r\n    27\t\r\n    28\tfunc (r *Record) Has(key string) bool {\r\n    29\t\t_, ok := r.Values[key]\r\n    30\t\treturn ok\r\n    31\t}\r\n    32\t\r\n    33\tfunc (r *Record) Copy() *Record {\r\n    34\t\tnr := New()\r\n    35\t\tnr.InputRow = r.InputRow\r\n    36\t\tfor _, k := range r.Order {\r\n    37\t\t\tnr.Set(k, r.Values[k])\r\n    38\t\t}\r\n"]
