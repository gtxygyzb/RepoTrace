[2275.104231, "o", "   360\t\treturn f, nil\r\n   361\t}\r\n   362\t\r\n   363\tfunc compareFloats(left float64, op string, right float64) bool {\r\n   364\t\tswitch op {\r\n   365\t\tcase \"<\":\r\n   366\t\t\treturn left < right\r\n"]
