[1718.109149, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.109245, "o", "            if key.As == \"number\" {\r\n\u001b[?2004l\r"]
[1718.109306, "o", "\u001b[?2004h> "]
[1718.10941, "o", "                af, _ := parseFloat(a)\r\n\u001b[?2004l\rco"]
