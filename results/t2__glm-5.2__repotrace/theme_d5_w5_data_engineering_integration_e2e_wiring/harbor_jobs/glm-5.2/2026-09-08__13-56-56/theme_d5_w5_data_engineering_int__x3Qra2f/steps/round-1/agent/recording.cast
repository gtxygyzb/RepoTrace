[1718.10955, "o", "                bf, _ := parseFloat(b)\r\n\u001b[?2004l\r"]
[1718.109603, "o", "\u001b[?2004h> "]
[1718.109675, "o", "                if af != bf {\r\n\u001b[?2004l\rE\u001b[?2004h"]
