[1414.9258, "i", "ix(s, \"}\") {\n            return nil, fmt.Errorf(\"unterminated flow mapping\")\n        }\n        inner := s[1 : len(s)-1]\n        if strings.TrimSpace(inner) == \"\" {\n            return map[string]interface{}{}, nil\n        }\n        parts := splitFlow(inner)\n        m := map[string]interface{}{}\n        for _, p := range parts {\n            key, val, err := splitKeyValue(strings.TrimSpace(p))\n            if err != nil {\n                return nil, err\n            }\n            v, err := parseFlowOrScalar(strings.TrimSpace(val))\n            if err != nil {\n                return nil, err\n            }\n            m[key] = v\n        }\n        return m, nil\n    }\n    return parseScalar(s), nil\n}\n\nfunc splitFlow(s string) []string {\n    parts := []string{}\n    depth := 0\n    inSingle := false\n    inDouble := false\n    start := 0\n    for i := 0; i < len(s); i++ {\n        c := s[i]\n        switch c {\n        case '\\'':\n            if !inDouble {\n                inSingle = !inSingle\n            }\n        case '\"':\n   "]
[1414.925845, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1414.925899, "i", "         if !inSingle {\n                inDouble = !inDouble\n            }\n        case '[', '{':\n            if !inSingle && !inDouble {\n                depth++\n            }\n        case ']', '}':\n            if !inSingle && !inDouble {\n                depth--\n            }\n        case ',':\n            if depth == 0 && !inSingle && !inDouble {\n                parts = append(parts, s[start:i])\n                start = i + 1\n            }\n        }\n    }\n    parts = append(parts, s[start:])\n    return parts\n}\nEOF\n"]
