[2460.843463, "o", "     8\t\t\"strings\"\r\n     9\t\r\n    10\t\t\"example.com/flowctl/internal/config\"\r\n    11\t\t\"example.com/flowctl/internal/record\"\r\n    12\t)\r\n    13\t\r\n    14\tfunc Write(records []*record.Record, cfg config.OutputConfig, dir string) (int, error) {\r\n    15\t\tvar buf bytes.Buffer\r\n    16\t\r\n    17\t\tfor _, r := range records {\r\n    18\t\t\tif cfg.ColumnsPresent {\r\n    19\t\t\t\twriteObject(&buf, cfg.Columns, r)\r\n    20\t\t\t} else {\r\n    21\t\t\t\twriteObject(&buf, r.Order, r)\r\n    22\t\t\t}\r\n    23\t\t\tbuf.WriteByte('\\n')\r\n    24\t\t}\r\n    25\t\r\n    26\t\tif cfg.Path == \"-\" {\r\n    27\t\t\tif _, err := os.Stdout.Write(buf.Bytes()); err != nil {\r\n    28\t\t\t\treturn 0, fmt.Errorf(\"output: %v\", err)\r\n    29\t\t\t}\r\n    30\t\t\treturn len(records), nil\r\n    31\t\t}\r\n    32\t\r\n    33\t\tfull := config.ResolvePath(dir, cfg.Path)\r\n    34\t\tdirName := filepath.Dir(full)\r\n    35\t\r\n    36\t\ttmp, err := os.CreateTemp(dirName, \".flowctl-output-*\")\r\n    37\t\tif err != nil {\r\n    38\t\t\treturn 0, fmt.Errorf(\"output: %v\", err)\r\n    39\t\t}\r\n    40\t"]
[2460.843583, "o", "\r\n    41\t\tif _, err := tmp.Write(buf.Bytes()); err != nil {\r\n    42\t\t\ttmp.Close()\r\n    43\t\t\tos.Remove(tmp.Name())\r\n    44\t\t\treturn 0, fmt.Errorf(\"output: %v\", err)\r\n    45\t\t}\r\n    46\t\tif err := tmp.Close(); err != nil {\r\n    47\t\t\tos.Remove(tmp.Name())\r\n    48\t\t\treturn 0, fmt.Errorf(\"output: %v\", err)\r\n    49\t\t}\r\n    50\t\tif err := os.Rename(tmp.Name(), full); err != nil {\r\n    51\t\t\tos.Remove(tmp.Name())\r\n    52\t\t\treturn 0, fmt.Errorf(\"output: %v\", err)\r\n    53\t\t}\r\n    54\t\r\n    55\t\treturn len(records), nil\r\n    56\t}\r\n    57\t\r\n"]
[2460.8437, "o", "    58\tfunc writeObject(buf *bytes.Buffer, cols []string, r *record.Record) {\r\n    59\t\tbuf.WriteByte('{')\r\n    60\t\tfor i, col := range cols {\r\n    61\t\t\tif i > 0 {\r\n    62\t\t\t\tbuf.WriteByte(',')\r\n    63\t\t\t}\r\n    64\t\t\tbuf.WriteString(encodeJSONString(col))\r\n    65\t\t\tbuf.WriteByte(':')\r\n    66\t\t\tval := \"\"\r\n    67\t\t\tif v, ok := r.Get(col); ok {\r\n    68\t\t\t\tval = v\r\n    69\t\t\t}\r\n    70\t\t\tbuf.WriteString(encodeJSONString(val))\r\n    71\t\t}\r\n    72\t\tbuf.WriteByte('}')\r\n    73\t}\r\n    74\t\r\n    75\tfunc encodeJSONString(s string) string {\r\n"]
[2460.84385, "o", "    76\t\tvar b strings.Builder\r\n    77\t\tb.WriteByte('\"')\r\n    78\t\tfor i := 0; i < len(s); i++ {\r\n    79\t\t\tc := s[i]\r\n    80\t\t\tswitch c {\r\n    81\t\t\tcase '\\\\':\r\n    82\t\t\t\tb.WriteString(\"\\\\\\\\\")\r\n    83\t\t\tcase '\"':\r\n    84\t\t\t\tb.WriteString(\"\\\\\\\"\")\r\n    85\t\t\tcase '\\n':\r\n    86\t\t\t\tb.WriteString(\"\\\\n\")\r\n    87\t\t\tcase '\\r':\r\n    88\t\t\t\tb.WriteString(\"\\\\r\")\r\n    89\t\t\tcase '\\t':\r\n    90\t\t\t\tb.WriteString(\"\\\\t\")\r\n    91\t\t\tdefault:\r\n    92\t\t\t\tif c < 0x20 {\r\n    93\t\t\t\t\tfmt.Fprintf(&b, \"\\\\u%04x\", c)\r\n    94\t\t\t\t} else {\r\n"]
[2460.843946, "o", "    95\t\t\t\t\tb.WriteByte(c)\r\n    96\t\t\t\t}\r\n    97\t\t\t}\r\n    98\t\t}\r\n    99\t\tb.WriteByte('\"')\r\n   100\t\treturn b.String()\r\n   101\t}\r\n"]
