[1718.098318, "o", "\u001b[?2004h> "]
[1718.09837, "o", "                }\r\n\u001b[?2004l\r"]
[1718.098424, "o", "\u001b[?2004h> "]
[1718.098503, "o", "                continue\r\n\u001b[?2004l\r"]
[1718.098556, "o", "\u001b[?2004h> "]
[1718.098612, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.098822, "o", "            right, err := parseFloat(s.value)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1718.098876, "o", "> "]
[1718.098954, "o", "            if err != nil {\r\n\u001b[?2004l\r"]
[1718.099009, "o", "\u001b[?2004h> "]
[1718.099163, "o", "                stats.DroppedNonNumeric++\r\n\u001b[?2004l\r"]
[1718.099217, "o", "\u001b[?2004h> "]
[1718.099586, "o", "                fmt.Fprintf(stderr, \"flowctl: filter: drop non-numeric row %d\\n\", r.InputRow)\r\n\u001b[?2004l\r"]
[1718.099641, "o", "\u001b[?2004h> "]
[1718.099754, "o", "                if strict {\r\n\u001b[?2004l\r"]
[1718.099814, "o", "\u001b[?2004h> "]
[1718.100156, "o", "                    return nil, fmt.Errorf(\"filter: drop non-numeric row %d\", r.InputRow)\r\n\u001b[?2004l\r"]
[1718.10021, "o", "\u001b[?2004h> "]
[1718.100267, "o", "                }\r\n\u001b[?2004l\r"]
[1718.100322, "o", "\u001b[?2004h> "]
[1718.100403, "o", "                continue\r\n\u001b[?2004l\r"]
[1718.100457, "o", "\u001b[?2004h> "]
[1718.100503, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1718.100557, "o", "> "]
[1718.100735, "o", "            keep = compareFloats(left, s.op, right)\r\n\u001b[?2004l\r"]
[1718.100799, "o", "\u001b[?2004h> "]
[1718.100853, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r."]
[1718.100908, "o", "\u001b[?2004h> "]
[1718.10097, "o", "        if keep {\r\n\u001b[?2004l\r"]
[1718.101023, "o", "\u001b[?2004h> "]
[1718.10114, "o", "            out = append(out, r)\r\n\u001b[?2004l\r"]
[1718.101195, "o", "\u001b[?2004h> "]
[1718.101248, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.101315, "o", "    }\r\n\u001b[?2004l\rx\u001b[?2004h> \r\n\u001b[?2004l\r,"]
[1718.101369, "o", "\u001b[?2004h> "]
[1718.101421, "o", "    return out, nil\r\n\u001b[?2004l\r"]
[1718.101475, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
