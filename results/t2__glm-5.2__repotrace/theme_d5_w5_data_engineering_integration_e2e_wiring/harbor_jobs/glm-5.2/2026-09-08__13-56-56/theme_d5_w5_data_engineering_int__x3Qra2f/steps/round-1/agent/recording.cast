[1414.983637, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.983689, "o", "func splitFlow(s string) []string {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.983737, "o", "    parts := []string{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.983793, "o", "    depth := 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.983842, "o", "    inSingle := false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.983892, "o", "    inDouble := false\r\n\u001b[?2004l\r\u001b[?2004h>     start := 0\r\n\u001b[?2004l\r"]
[1414.983942, "o", "\u001b[?2004h> "]
[1414.983991, "o", "    for i := 0; i < len(s); i++ {\r\n\u001b[?2004l\r\u001b[?2004h>         c := s[i]\r\n\u001b[?2004l\r"]
[1414.98404, "o", "\u001b[?2004h>         switch c {\r\n\u001b[?2004l\r"]
[1414.98409, "o", "\u001b[?2004h>         case '\\'':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.98414, "o", "            if !inDouble {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.98421, "o", "                inSingle = !inSingle\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984261, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984311, "o", "        case '\"':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984362, "o", "            if !inSingle {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984411, "o", "                inDouble = !inDouble\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984479, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984533, "o", "        case '[', '{':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984584, "o", "            if !inSingle && !inDouble {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984633, "o", "                depth++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984684, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984733, "o", "        case ']', '}':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984788, "o", "            if !inSingle && !inDouble {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984838, "o", "                depth--\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.984889, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         case ',':\r\n\u001b[?2004l\r"]
[1414.984939, "o", "\u001b[?2004h> "]
[1414.984989, "o", "            if depth == 0 && !inSingle && !inDouble {\r\n\u001b[?2004l\r"]
[1414.985036, "o", "\u001b[?2004h> "]
[1414.985087, "o", "                parts = append(parts, s[start:i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.985136, "o", "                start = i + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.985184, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.985235, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.9853, "o", "    parts = append(parts, s[start:])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1414.98535, "o", "    return parts\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1414.985398, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1414.989002, "o", "\u001b[?2004hroot@n30009:/app# "]
[1717.784111, "i", "cat > internal/input/input.go <<'EOF'\npackage input\n\nimport (\n    \"bufio\"\n    \"encoding/csv\"\n    \"encoding/json\"\n    \"fmt\"\n    \"io\"\n    \"os\"\n    \"strings\"\n\n    \"example.com/flowctl/internal/config\"\n    \"example.com/flowctl/internal/record\"\n)\n\nfunc Read(cfg config.InputConfig, dir string) ([]*record.Record, error) {\n    switch cfg.Format {\n    case \"csv\":\n        return readCSV(cfg, dir)\n    case \"ndjson\":\n        return readNDJSON(cfg, dir)\n    default:\n        return nil, fmt.Errorf(\"input: unsupported format %q\", cfg.Format)\n    }\n}\n\nfunc readCSV(cfg config.InputConfig, dir string) ([]*record.Record, error) {\n    path := config.ResolvePath(dir, cfg.Path)\n    f, err := os.Open(path)\n    if err != nil {\n        return nil, fmt.Errorf(\"input: %v\", err)\n    }\n    defer f.Close()\n\n    r := csv.NewReader(f)\n    r.FieldsPerRecord = 0\n    r.TrimLeadingSpace = true\n\n    header, err := r.Read()\n    if err == io.EOF {\n        return nil, fmt.Errorf(\"input: empty CSV file\")\n    }\n    if err != nil {\n        return nil,"]
[1717.784406, "i", " fmt.Errorf(\"input: %v\", err)\n    }\n\n    records := []*record.Record{}\n    rowNum := 0\n    for {\n        row, err := r.Read()\n        if err == io.EOF {\n            break\n        }\n        if err != nil {\n            return nil, fmt.Errorf(\"input: row %d: %v\", rowNum+2, err)\n        }\n        rowNum++\n\n        if len(row) != len(header) {\n            return nil, fmt.Errorf(\"input: row %d: expected %d fields got %d\", rowNum+1, len(header), len(row))\n        }\n\n        rec := record.New()\n        rec.InputRow = rowNum\n        for i, col := range header {\n            rec.Set(col, row[i])\n        }\n        records = append(records, rec)\n    }\n\n    return records, nil\n}\n\nfunc readNDJSON(cfg config.InputConfig, dir string) ([]*record.Record, error) {\n    path := config.ResolvePath(dir, cfg.Path)\n    f, err := os.Open(path)\n    if err != nil {\n        return nil, fmt.Errorf(\"input: %v\", err)\n    }\n    defer f.Close()\n\n    scanner := bufio.NewScanner(f)\n    scanner.Buffer(make([]byte, 0, 1024*1024), 64*1024*1024)\n\n  "]
[1717.784532, "i", "  records := []*record.Record{}\n    lineNum := 0\n    recNum := 0\n    for scanner.Scan() {\n        lineNum++\n        line := scanner.Text()\n        if strings.TrimSpace(line) == \"\" {\n            continue\n        }\n\n        rec, err := parseNDJSONLine(line, lineNum)\n        if err != nil {\n            return nil, fmt.Errorf(\"input: line %d: %v\", lineNum, err)\n        }\n        recNum++\n        rec.InputRow = recNum\n        records = append(records, rec)\n    }\n    if err := scanner.Err(); err != nil {\n        return nil, fmt.Errorf(\"input: %v\", err)\n    }\n\n    return records, nil\n}\n\nfunc parseNDJSONLine(line string, lineNum int) (*record.Record, error) {\n    dec := json.NewDecoder(strings.NewReader(line))\n\n    t, err := dec.Token()\n    if err != nil {\n        return nil, fmt.Errorf(\"invalid JSON: %v\", err)\n    }\n    if t != json.Delim('{') {\n        return nil, fmt.Errorf(\"line is not a JSON object\")\n    }\n\n    rec := record.New()\n    for {\n        t, err := dec.Token()\n        if err == io.EOF {\n            ret"]
[1717.784594, "o", "cat > internal/input/input.go <<'EOF'\r\n\u001b[?2004l\r"]
[1717.784676, "i", "urn nil, fmt.Errorf(\"unexpected end of object\")\n        }\n        if err != nil {\n            return nil, fmt.Errorf(\"invalid JSON: %v\", err)\n        }\n        if t == json.Delim('}') {\n            break\n        }\n\n        key, ok := t.(string)\n        if !ok {\n            return nil, fmt.Errorf(\"object key is not a string\")\n        }\n\n        vt, err := dec.Token()\n        if err != nil {\n            return nil, fmt.Errorf(\"value for %q: %v\", key, err)\n        }\n        s, ok := vt.(string)\n        if !ok {\n            return nil, fmt.Errorf(\"value for %q is not a JSON string\", key)\n        }\n        rec.Set(key, s)\n    }\n\n    if dec.More() {\n        return nil, fmt.Errorf(\"unexpected trailing content\")\n    }\n\n    return rec, nil\n}\nEOF\n"]
