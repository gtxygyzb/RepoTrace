[2341.361615, "i", "sed -n '241,380p' internal/stage/stage.go\n"]
[2341.361995, "o", "sed -n '241,380p' internal/stage/stage.go\r\n\u001b[?2004l\r"]
[2341.365155, "o", "\t\treturn nil, fmt.Errorf(\"config: stage %d: project.columns is required\", idx)\r\n\t}\r\n\tlist, ok := colsRaw.([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: project.columns must be a list\", idx)\r\n\t}\r\n"]
[2341.365284, "o", "\r\n\tcolumns := make([]ProjectColumn, 0, len(list))\r\n\tseen := map[string]bool{}\r\n\tfor j, item := range list {\r\n\t\tswitch v := item.(type) {\r\n\t\tcase string:\r\n\t\t\tif seen[v] {\r\n\t\t\t\treturn nil, fmt.Errorf(\"config: stage %d: project output column %q duplicated\", idx, v)\r\n\t\t\t}\r\n\t\t\tseen[v] = true\r\n\t\t\tcolumns = append(columns, ProjectColumn{Source: v, Target: v})\r\n\t\tcase map[string]interface{}:\r\n\t\t\tname, ok := getString(v, \"name\")\r\n\t\t\tif !ok || name == \"\" {\r\n\t\t\t\treturn nil, fmt.Errorf(\"config: stage %d: project column %d name is required\", idx, j+1)\r\n\t\t\t}\r\n\t\t\tas, ok := getString(v, \"as\")\r\n\t\t\tif !ok || as == \"\" {\r\n\t\t\t\treturn nil, fmt.Errorf(\"config: stage %d: project column %d as is required\", idx, j+1)\r\n\t\t\t}\r\n\t"]
[2341.365334, "o", "\t\tif seen[as] {\r\n\t\t\t\treturn nil, fmt.Errorf(\"config: stage %d: project output column %q duplicated\", idx, as)\r\n\t\t\t}\r\n\t\t\tseen[as] = true\r\n\t\t\tcolumns = append(columns, ProjectColumn{Source: name, Target: as})\r\n\t\tdefault:\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: project column %d must be a string or mapping\", idx, j+1)\r\n"]
[2341.365444, "o", "\t\t}\r\n\t}\r\n\r\n\treturn &ProjectStage{columns: columns}, nil\r\n}\r\n\r\nfunc buildSort(idx int, sm map[string]interface{}) (Stage, error) {\r\n"]
[2341.365518, "o", "\tkeysRaw, ok := sm[\"keys\"]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: sort.keys is required\", idx)\r\n\t}\r\n\tlist, ok := keysRaw.([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: sort.keys must be a list\", idx)\r\n\t}\r\n\r\n\tkeys := make([]SortKey, 0, len(list))\r\n\tfor j, item := range list {\r\n\t\tkm, ok := item.(map[string]interface{})\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: sort key %d must be a mapping\", idx, j+1)\r\n\t\t}\r\n\r\n\t\tcolumn, ok := getString(km, \"column\")\r\n\t\tif !ok || column == \"\" {\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: sort key %d column is required\", idx, j+1)\r\n\t\t}\r\n\r\n\t\torder, ok := getString(km, \"order\")\r\n\t\t"]
[2341.365584, "o", "if !ok || order == \"\" {\r\n\t\t\torder = \"asc\"\r\n\t\t}\r\n\t\tif order != \"asc\" && order != \"desc\" {\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: sort key %d order must be asc or desc\", idx, j+1)\r\n\t\t}\r\n\r\n\t\tas, ok := getString(km, \"as\")\r\n\t\tif !ok || as == \"\" {\r\n\t\t\tas = \"string\"\r\n\t\t}\r\n"]
[2341.365649, "o", "\t\tif as != \"string\" && as != \"number\" {\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: sort key %d as must be string or number\", idx, j+1)\r\n\t\t}\r\n\r\n\t\tkeys = append(keys, SortKey{Column: column, Order: order, As: as})\r\n\t}\r\n\r\n\treturn &SortStage{keys: keys}, nil\r\n}\r\n\r\nfunc buildLimit(idx int, sm map[string]interface{}) (Stage, error) {\r\n\tcountRaw, ok := sm[\"count\"]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: limit.count is required\", idx)\r\n\t}"]
[2341.365712, "o", "\r\n\tcountStr, ok := countRaw.(string)\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: limit.count must be a non-negative integer\", idx)\r\n\t}\r\n\tn, err := strconv.Atoi(countStr)\r\n\tif err != nil || n < 0 {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: limit.count must be a non-negative integer\", idx)\r\n\t}\r\n\r\n"]
[2341.365784, "o", "\treturn &LimitStage{count: n}, nil\r\n}\r\n\r\nfunc getString(m map[string]interface{}, key string) (string, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn \"\", false\r\n\t}\r\n\tif s, ok := v.(string); ok {\r\n\t\treturn s, true\r\n\t}\r\n\treturn fmt.Sprintf(\"%v\", v), true"]
[2341.365854, "o", "\r\n}\r\n\r\nfunc parseFloat(s string) (float64, error) {\r\n\tf, err := strconv.ParseFloat(s, 64)\r\n\tif err != nil {\r\n\t\treturn 0, err\r\n\t}\r\n\tif math.IsNaN(f) || math.IsInf(f, 0) {\r\n\t\treturn 0, fmt.Errorf(\"not a finite number\")\r\n\t}\r\n"]
[2341.365917, "o", "\treturn f, nil\r\n}\r\n\r\nfunc compareFloats(left float64, op string, right float64) bool {\r\n\tswitch op {\r\n\tcase \"<\":\r\n\t\treturn left < right\r\n\tcase \"<=\":\r\n\t\treturn left <= right\r\n\tcase \">\":\r\n"]
[2341.365978, "o", "\t\treturn left > right\r\n\tcase \">=\":\r\n\t\treturn left >= right\r\n\t}\r\n\treturn false\r\n}\r\n"]
