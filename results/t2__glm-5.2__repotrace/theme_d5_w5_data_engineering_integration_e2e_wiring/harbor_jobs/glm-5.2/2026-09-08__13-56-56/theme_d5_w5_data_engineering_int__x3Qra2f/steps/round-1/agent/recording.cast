[2516.177029, "o", "\r\n    10\t\t\"example.com/flowctl/internal/record\"\r\n    11\t)\r\n    12\t\r\n    13\ttype Stats struct {\r\n    14\t\tProcessed         int\r\n    15\t\tEmitted           int\r\n    16\t\tDroppedNonNumeric int\r\n    17\t\tDroppedMissing    int\r\n    18\t\tmissingReported   bool\r\n    19\t}\r\n    20\t\r\n    21\ttype Stage interface {\r\n    22\t\tApply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error)\r\n    23\t}\r\n    24\t\r\n    25\tfunc Build(rawStages []map[string]interface{}) ([]Stage, error) {\r\n    26\t\tstages := make([]Stage, 0, len(rawStages))\r\n    27\t\tfor i, sm := range rawStages {\r\n    28\t\t\ttyp, ok := getString(sm, \"type\")\r\n    29\t\t\tif !ok || typ == \"\" {\r\n    30\t\t\t\treturn nil, fmt.Errorf(\"config: stage %d: type is required\", i+1)\r\n"]
