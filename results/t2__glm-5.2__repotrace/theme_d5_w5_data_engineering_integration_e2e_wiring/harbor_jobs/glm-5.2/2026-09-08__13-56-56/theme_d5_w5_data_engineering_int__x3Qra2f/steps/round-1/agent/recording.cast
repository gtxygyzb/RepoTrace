[2297.395747, "o", "package config\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"bytes\"\r\n\t\"fmt\"\r\n"]
[2297.395775, "o", "\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n"]
[2297.395888, "o", "\r\ntype InputConfig struct {\r\n\tPath   string\r\n\tFormat string\r\n}\r\n\r\ntype OutputConfig struct {\r\n\tPath           string\r\n\tFormat         string\r\n\tColumns        []string\r\n\tColumnsPresent bool\r\n}\r\n\r\ntype Config struct {\r\n\tDir    string\r\n\tStrict bool\r\n\tInput  InputConfig\r\n\tStages []map[string]interface{}\r\n\tOutput OutputConfig\r\n}\r\n\r\nfunc Load(path string) (*Config, error) {\r\n"]
[2297.395953, "o", "\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"config: %v\", err)\r\n\t}\r\n"]
[2297.396019, "o", "\r\n\troot, err := parseYAML(data)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"config: %v\", err)\r\n\t}\r\n\r\n\tm, ok := root.(map[string]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: top-level value must be a mapping\")\r\n\t}\r\n\r\n\tcfg := &Config{Dir: filepath.Dir(path)}\r\n\r\n\tinRaw, ok := m[\"input\"]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: input is required\")\r\n\t}\r\n\tinMap, ok := inRaw.(map[string]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: input must be a mapping\")\r\n\t}\r\n\tif p, ok := getString(inMap, \"path\"); ok {\r\n\t\tcfg.Input.Path = p\r\n"]
