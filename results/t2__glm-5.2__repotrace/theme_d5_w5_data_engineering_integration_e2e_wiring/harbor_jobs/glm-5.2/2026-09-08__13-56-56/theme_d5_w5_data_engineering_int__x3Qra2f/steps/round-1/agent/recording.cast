[2868.913548, "i", "cat > internal/input/sqlite.go <<'EOF'\npackage input\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"math\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"example.com/flowctl/internal/config\"\n\t\"example.com/flowctl/internal/record\"\n)\n\nfunc readSQLite(cfg config.InputConfig, dir string) ([]*record.Record, error) {\n\tpath := config.ResolvePath(dir, cfg.Path)\n\tif _, err := os.Stat(path); err != nil {\n\t\treturn nil, fmt.Errorf(\"input: %v\", err)\n\t}\n\n\tcmd := exec.Command(\"/usr/bin/sqlite3\", \"-cmd\", \".mode quote\", \"-cmd\", \".headers on\", path, cfg.Query)\n\tstdout, err := cmd.StdoutPipe()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"input: %v\", err)\n\t}\n\tvar stderr bytes.Buffer\n\tcmd.Stderr = &stderr\n\tif err := cmd.Start(); err != nil {\n\t\treturn nil, fmt.Errorf(\"input: %v\", err)\n\t}\n\n\tr := bufio.NewReader(stdout)\n\theaderRaw, err := readSQLiteRecord(r)\n\tif err == io.EOF {\n\t\tif werr := cmd.Wait(); werr != nil {\n\t\t\treturn nil, fmt.Errorf(\"input: %s\", firstSQLiteError(stderr.String()))\n\t\t}\n\t\treturn nil, fmt.Errorf(\"input: query returned no c"]
[2868.913873, "i", "olumns\")\n\t}\n\tif err != nil {\n\t\tif werr := cmd.Wait(); werr != nil {\n\t\t\treturn nil, fmt.Errorf(\"input: %s\", firstSQLiteError(stderr.String()))\n\t\t}\n\t\treturn nil, fmt.Errorf(\"input: %v\", err)\n\t}\n\n\theader := make([]string, len(headerRaw))\n\tfor i, raw := range headerRaw {\n\t\tname, err := renderSQLiteValue(raw)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"input: %v\", err)\n\t\t}\n\t\theader[i] = name\n\t}\n\n\trecords := []*record.Record{}\n\trecNum := 0\n\tfor {\n\t\tfields, err := readSQLiteRecord(r)\n\t\tif err == io.EOF {\n\t\t\tbreak\n\t\t}\n\t\tif err != nil {\n\t\t\tif werr := cmd.Wait(); werr != nil {\n\t\t\t\treturn nil, fmt.Errorf(\"input: %s\", firstSQLiteError(stderr.String()))\n\t\t\t}\n\t\t\treturn nil, fmt.Errorf(\"input: %v\", err)\n\t\t}\n\n\t\trecNum++\n\t\tif len(fields) != len(header) {\n\t\t\treturn nil, fmt.Errorf(\"input: row %d: expected %d columns got %d\", recNum, len(header), len(fields))\n\t\t}\n\n\t\trec := record.New()\n\t\trec.InputRow = recNum\n\t\tfor i, col := range header {\n\t\t\tval, err := renderSQLiteValue(fields[i])\n\t\t\tif err != nil {\n\t\t\t\treturn nil, fmt.Error"]
