[2359.50603, "o", "sed -n '101,200p' internal/input/input.go\r\n\u001b[?2004l\r"]
[2359.508749, "o", "\t\trecords = append(records, rec)\r\n\t}\r\n\tif err := scanner.Err(); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"input: %v\", err)\r\n\t}\r\n\r\n\treturn records, nil\r\n"]
[2359.508877, "o", "}\r\n\r\nfunc parseNDJSONLine(line string, lineNum int) (*record.Record, error) {\r\n\tdec := json.NewDecoder(strings.NewReader(line))\r\n\r\n\tt, err := dec.Token()\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"invalid JSON: %v\", err)\r\n\t}\r\n\tif t != json.Delim('{') {\r\n\t\treturn nil, fmt.Errorf(\"line is not a JSON object\")\r\n\t}\r\n\r\n\trec := record.New()\r\n\tfor {\r\n\t\tt, err := dec.Token()\r\n\t\tif err == io.EOF {\r\n\t\t\treturn nil, fmt.Errorf(\"unexpected end of object\")\r\n"]
[2359.508975, "o", "\t\t}\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"invalid JSON: %v\", err)\r\n\t\t}\r\n\t\tif t == json.Delim('}') {\r\n\t\t\tbreak\r\n\t\t}\r\n\r\n\t\tkey, ok := t.(string)\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"object key is not a string\")\r\n"]
[2359.509068, "o", "\t\t}\r\n\r\n\t\tvt, err := dec.Token()\r\n\t\tif err != nil {\r\n\t\t"]
[2359.509137, "o", "\treturn nil, fmt.Errorf(\"value for %q: %v\", key, err)\r\n\t\t}\r\n\t\ts, ok := vt.(string)\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"value for %q is not a JSON string\", key)\r\n\t\t}\r\n\t\trec.Set(key, s)\r\n\t}\r\n\r\n\tif dec.More() {\r\n"]
[2359.509201, "o", "\t\treturn nil, fmt.Errorf(\"unexpected trailing content\")\r\n\t}\r\n\r\n\treturn rec, nil\r\n}\r\n"]
[2359.509567, "o", "\u001b[?2004hroot@n30009:/app# "]
[2359.803683, "i", "sed -n '1,160p' internal/record/record.go\n"]
[2359.804072, "o", "sed -n '1,160p' internal/record/record.go\r\n\u001b[?2004l\r"]
[2359.807077, "o", "package record\r\n\r\ntype Record struct {\r\n\tOrder    []string\r\n\tValues   map[string]string\r\n"]
[2359.80719, "o", "\tInputRow int\r\n}\r\n\r\nfunc New() *Record {\r\n\treturn &Record{\r\n\t\tOrder:  []string{},\r\n\t\tValues: map[string]string{},\r\n\t}\r\n}\r\n\r\nfunc (r *Record) Set(key, val string) {\r\n\tif _, ok := r.Values[key]; !ok {\r\n\t\tr.Order = append(r.Order, key)\r\n\t}\r\n\tr.Values[key] = val\r\n}\r\n\r\nfunc (r *Record) Get(key string) (string, bool) {\r\n\tv, ok := r.Values[key]\r\n\treturn v, ok\r\n"]
[2359.807296, "o", "}\r\n\r\nfunc (r *Record) Has(key string) bool {\r\n\t_, ok := r.Values[key]\r\n\treturn ok\r\n}\r\n\r\nfunc (r *Record) Copy() *Record {\r\n\tnr := New()\r\n"]
[2359.807367, "o", "\tnr.InputRow = r.InputRow\r\n\tfor _, k := range r.Order {\r\n\t\tnr.Set(k, r.Values[k])\r\n\t}\r\n\treturn nr\r\n}\r\n"]
[2359.807801, "o", "\u001b[?2004h"]
[2359.807874, "o", "root@n30009:/app# "]
[2360.122503, "i", "sed -n '1,140p' internal/stage/stage.go\n"]
