[2284.942703, "o", "    54\t\t\tif err != nil {\r\n    55\t\t\t\treturn nil, fmt.Errorf(\"input: row %d: %v\", rowNum+2, err)\r\n    56\t\t\t}\r\n    57\t\t\trowNum++\r\n    58\t\r\n    59\t\t\tif len(row) != len(header) {\r\n    60\t\t\t\treturn nil, fmt.Errorf(\"input: row %d: expected %d fields got %d\", rowNum+1, len(header), len(row))\r\n    61\t\t\t}\r\n    62\t\r\n    63\t\t\trec := record.New()\r\n    64\t\t\trec.InputRow = rowNum\r\n    65"]
