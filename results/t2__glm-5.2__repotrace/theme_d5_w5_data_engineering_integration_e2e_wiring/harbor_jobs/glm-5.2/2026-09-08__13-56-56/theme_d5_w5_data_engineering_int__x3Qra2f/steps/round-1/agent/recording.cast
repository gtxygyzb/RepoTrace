[1718.076198, "i", "cat > internal/stage/stage.go <<'EOF'\npackage stage\n\nimport (\n    \"fmt\"\n    \"io\"\n    \"math\"\n    \"sort\"\n    \"strconv\"\n\n    \"example.com/flowctl/internal/record\"\n)\n\ntype Stats struct {\n    Processed          int\n    Emitted            int\n    DroppedNonNumeric  int\n    DroppedMissing     int\n    missingReported    bool\n}\n\ntype Stage interface {\n    Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error)\n}\n\nfunc Build(rawStages []map[string]interface{}) ([]Stage, error) {\n    stages := make([]Stage, 0, len(rawStages))\n    for i, sm := range rawStages {\n        typ, ok := getString(sm, \"type\")\n        if !ok || typ == \"\" {\n            return nil, fmt.Errorf(\"config: stage %d: type is required\", i+1)\n        }\n\n        var st Stage\n        var err error\n        switch typ {\n        case \"filter\":\n            st, err = buildFilter(i+1, sm)\n        case \"project\":\n            st, err = buildProject(i+1, sm)\n        case \"sort\":\n            st, err = buildSort(i+1, sm)\n      "]
[1718.076415, "i", "  case \"limit\":\n            st, err = buildLimit(i+1, sm)\n        default:\n            return nil, fmt.Errorf(\"config: stage %d: unknown stage type %q\", i+1, typ)\n        }\n        if err != nil {\n            return nil, err\n        }\n        stages = append(stages, st)\n    }\n    return stages, nil\n}\n\ntype FilterStage struct {\n    column string\n    op     string\n    value  string\n}\n\nfunc (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\n    out := make([]*record.Record, 0, len(in))\n\n    for _, r := range in {\n        v, ok := r.Get(s.column)\n        if !ok {\n            stats.DroppedMissing++\n            if !stats.missingReported {\n                fmt.Fprintf(stderr, \"flowctl: filter: missing column %s\\n\", s.column)\n                stats.missingReported = true\n            }\n            if strict {\n                return nil, fmt.Errorf(\"filter: missing column %s\", s.column)\n            }\n            continue\n        }\n\n        keep := false\n  "]
[1718.076528, "i", "      switch s.op {\n        case \"==\":\n            keep = v == s.value\n        case \"!=\":\n            keep = v != s.value\n        default:\n            left, err := parseFloat(v)\n            if err != nil {\n                stats.DroppedNonNumeric++\n                fmt.Fprintf(stderr, \"flowctl: filter: drop non-numeric row %d\\n\", r.InputRow)\n                if strict {\n                    return nil, fmt.Errorf(\"filter: drop non-numeric row %d\", r.InputRow)\n                }\n                continue\n            }\n            right, err := parseFloat(s.value)\n            if err != nil {\n                stats.DroppedNonNumeric++\n                fmt.Fprintf(stderr, \"flowctl: filter: drop non-numeric row %d\\n\", r.InputRow)\n                if strict {\n                    return nil, fmt.Errorf(\"filter: drop non-numeric row %d\", r.InputRow)\n                }\n                continue\n            }\n            keep = compareFloats(left, s.op, right)\n        }\n\n        if keep {\n            out = append(out, r)\n        "]
[1718.076603, "i", "}\n    }\n\n    return out, nil\n}\n\ntype ProjectColumn struct {\n    Source string\n    Target string\n}\n\ntype ProjectStage struct {\n    columns []ProjectColumn\n}\n\nfunc (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\n    out := make([]*record.Record, 0, len(in))\n    for _, r := range in {\n        nr := record.New()\n        nr.InputRow = r.InputRow\n        for _, c := range s.columns {\n            val := \"\"\n            if v, ok := r.Get(c.Source); ok {\n                val = v\n            }\n            nr.Set(c.Target, val)\n        }\n        out = append(out, nr)\n    }\n    return out, nil\n}\n\ntype SortKey struct {\n    Column string\n    Order  string\n    As     string\n}\n\ntype SortStage struct {\n    keys []SortKey\n}\n\nfunc (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\n    for _, key := range s.keys {\n        if key.As == \"number\" {\n            for _, r := range in {\n                v, "]
