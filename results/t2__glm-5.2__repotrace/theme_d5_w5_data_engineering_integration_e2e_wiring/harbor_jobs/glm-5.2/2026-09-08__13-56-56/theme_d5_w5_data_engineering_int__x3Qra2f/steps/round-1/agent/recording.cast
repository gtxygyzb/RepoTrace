[1718.091601, "o", "\u001b[?2004h> "]
[1718.091756, "o", "    for _, r := range in {\r\n\u001b[?2004l\r"]
[1718.09182, "o", "\u001b[?2004h> "]
[1718.092043, "o", "        v, ok := r.Get(s.column)\r\n\u001b[?2004l\r"]
[1718.092099, "o", "\u001b[?2004h> "]
[1718.09218, "o", "        if !ok {\r\n\u001b[?2004l\r"]
[1718.092235, "o", "\u001b[?2004h> "]
[1718.09244, "o", "            stats.DroppedMissing++\r\n\u001b[?2004l\r"]
[1718.092494, "o", "\u001b[?2004h> "]
[1718.092755, "o", "            if !stats.missingReported {\r\n\u001b[?2004l\r"]
[1718.09282, "o", "\u001b[?2004h> "]
[1718.093351, "o", "                fmt.Fprintf(stderr, \"flowctl: filter: missing column %s\\n\", s.column)\r\n\u001b[?2004l\r"]
[1718.093408, "o", "\u001b[?2004h> "]
[1718.093665, "o", "                stats.missingReported = true\r\n\u001b[?2004l\r"]
[1718.093721, "o", "\u001b[?2004h> "]
[1718.093808, "o", "            }\r\n\u001b[?2004l\r"]
[1718.093882, "o", "\u001b[?2004h> "]
[1718.093999, "o", "            if strict {\r\n\u001b[?2004l\r"]
[1718.094054, "o", "\u001b[?2004h> "]
[1718.094528, "o", "                return nil, fmt.Errorf(\"filter: missing column %s\", s.column)\r\n\u001b[?2004l\r"]
[1718.094584, "o", "\u001b[?2004h> "]
[1718.094661, "o", "            }\r\n\u001b[?2004l\r"]
[1718.094715, "o", "\u001b[?2004h> "]
[1718.094833, "o", "            continue\r\n\u001b[?2004l\r"]
[1718.094901, "o", "\u001b[?2004h> "]
[1718.09496, "o", "        }\r\n\u001b[?2004l\r"]
[1718.095014, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1718.095068, "o", "\u001b[?2004h> "]
[1718.095191, "o", "        keep := false\r\n\u001b[?2004l\r"]
[1718.095245, "o", "\u001b[?2004h> "]
[1718.095371, "o", "        switch s.op {\r\n\u001b[?2004l\r"]
[1718.095425, "o", "\u001b[?2004h> "]
[1718.095534, "o", "        case \"==\":\r\n\u001b[?2004l\r"]
[1718.095587, "o", "\u001b[?2004h> "]
