[1718.405137, "o", "\u001b[?2004h> "]
[1718.405201, "o", "        val := \"\"\r\n\u001b[?2004l\r"]
[1718.405254, "o", "\u001b[?2004h> "]
[1718.405392, "o", "        if v, ok := r.Get(col); ok {\r\n\u001b[?2004l\r"]
[1718.405446, "o", "\u001b[?2004h> "]
[1718.405516, "o", "            val = v\r\n\u001b[?2004l\r"]
[1718.405569, "o", "\u001b[?2004h> "]
[1718.405624, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.405837, "o", "        buf.WriteString(encodeJSONString(val))\r\n\u001b[?2004l\r"]
[1718.405909, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1718.405967, "o", "\u001b[?2004h> "]
[1718.406039, "o", "    buf.WriteByte('}')\r\n\u001b[?2004l\r"]
[1718.406093, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1718.406147, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1718.4062, "o", "> "]
[1718.406344, "o", "func encodeJSONString(s string) string {\r\n\u001b[?2004l\r"]
[1718.406398, "o", "\u001b[?2004h> "]
[1718.40649, "o", "    var b strings.Builder\r\n\u001b[?2004l\r"]
[1718.406544, "o", "\u001b[?2004h> "]
[1718.406617, "o", "    b.WriteByte('\"')\r\n\u001b[?2004l\r"]
[1718.406672, "o", "\u001b[?2004h> "]
[1718.406804, "o", "    for i := 0; i < len(s); i++ {\r\n\u001b[?2004l\r"]
[1718.406891, "o", "\u001b[?2004h> "]
[1718.40696, "o", "        c := s[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.407041, "o", "        switch c {\r\n\u001b[?2004l\r"]
[1718.407096, "o", "\u001b[?2004h> "]
[1718.407162, "o", "        case '\\\\':\r\n\u001b[?2004l\r"]
[1718.407216, "o", "\u001b[?2004h> "]
[1718.407341, "o", "            b.WriteString(\"\\\\\\\\\")\r\n\u001b[?2004l\r"]
[1718.407395, "o", "\u001b[?2004h> "]
[1718.407458, "o", "        case '\"':\r\n\u001b[?2004l\r"]
[1718.407512, "o", "\u001b[?2004h> "]
[1718.407637, "o", "            b.WriteString(\"\\\\\\\"\")\r\n\u001b[?2004l\r"]
[1718.4077, "o", "\u001b[?2004h> "]
[1718.407758, "o", "        case '\\n':\r\n\u001b[?2004l\r"]
[1718.407837, "o", "\u001b[?2004h> "]
[1718.407938, "o", "            b.WriteString(\"\\\\n\")\r\n\u001b[?2004l\r"]
[1718.407992, "o", "\u001b[?2004h> "]
[1718.408059, "o", "        case '\\r':\r\n\u001b[?2004l\r"]
[1718.408113, "o", "\u001b[?2004h> "]
[1718.408236, "o", "            b.WriteString(\"\\\\r\")\r\n\u001b[?2004l\r"]
[1718.408299, "o", "\u001b[?2004h> "]
[1718.408355, "o", "        case '\\t':\r\n\u001b[?2004l\r"]
[1718.40841, "o", "\u001b[?2004h> "]
[1718.40853, "o", "            b.WriteString(\"\\\\t\")\r\n\u001b[?2004l\r"]
[1718.408584, "o", "\u001b[?2004h> "]
[1718.408641, "o", "        default:\r\n\u001b[?2004l\r"]
[1718.408696, "o", "\u001b[?2004h> "]
[1718.408797, "o", "            if c < 0x20 {\r\n\u001b[?2004l\r"]
[1718.408853, "o", "\u001b[?2004h> "]
[1718.409037, "o", "                fmt.Fprintf(&b, \"\\\\u%04x\", c)\r\n\u001b[?2004l\r"]
[1718.409091, "o", "\u001b[?2004h> "]
[1718.409172, "o", "            } else {\r\n\u001b[?2004l\r"]
[1718.409226, "o", "\u001b[?2004h> "]
[1718.409342, "o", "                b.WriteByte(c)\r\n\u001b[?2004l\r"]
[1718.409396, "o", "\u001b[?2004h> "]
[1718.409458, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1718.409513, "o", ">         }\r\n\u001b[?2004l\r"]
[1718.409578, "o", "\u001b[?2004h> "]
[1718.409636, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.409724, "o", "    b.WriteByte('\"')\r\n\u001b[?2004l\r"]
[1718.409792, "o", "\u001b[?2004h> "]
[1718.409865, "o", "    return b.String()\r\n\u001b[?2004l\r"]
[1718.409919, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1718.409976, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1718.412858, "o", "\u001b[?2004h"]
[1718.412924, "o", "root@n30009:/app# "]
[1718.681462, "i", "cat > internal/pipeline/pipeline.go <<'EOF'\npackage pipeline\n\nimport (\n    \"os\"\n\n    \"example.com/flowctl/internal/config\"\n    \"example.com/flowctl/internal/input\"\n    \"example.com/flowctl/internal/output\"\n    \"example.com/flowctl/internal/stage\"\n)\n\nfunc Run(cfg *config.Config) (*stage.Stats, error) {\n    stats := &stage.Stats{}\n\n    stages, err := stage.Build(cfg.Stages)\n    if err != nil {\n        return stats, err\n    }\n\n    records, err := input.Read(cfg.Input, cfg.Dir)\n    if err != nil {\n        return stats, err\n    }\n    stats.Processed = len(records)\n\n    for _, st := range stages {\n        records, err = st.Apply(records, os.Stderr, cfg.Strict, stats)\n        if err != nil {\n            return stats, err\n        }\n    }\n\n    n, err := output.Write(records, cfg.Output, cfg.Dir)\n    if err != nil {\n        return stats, err\n    }\n    stats.Emitted = n\n\n    return stats, nil\n}\nEOF\n"]
