[1414.627031, "i", "cat > internal/record/record.go <<'EOF'\npackage record\n\ntype Record struct {\n    Order    []string\n    Values   map[string]string\n    InputRow int\n}\n\nfunc New() *Record {\n    return &Record{\n        Order:  []string{},\n        Values: map[string]string{},\n    }\n}\n\nfunc (r *Record) Set(key, val string) {\n    if _, ok := r.Values[key]; !ok {\n        r.Order = append(r.Order, key)\n    }\n    r.Values[key] = val\n}\n\nfunc (r *Record) Get(key string) (string, bool) {\n    v, ok := r.Values[key]\n    return v, ok\n}\n\nfunc (r *Record) Has(key string) bool {\n    _, ok := r.Values[key]\n    return ok\n}\n\nfunc (r *Record) Copy() *Record {\n    nr := New()\n    nr.InputRow = r.InputRow\n    for _, k := range r.Order {\n        nr.Set(k, r.Values[k])\n    }\n    return nr\n}\nEOF\n"]
