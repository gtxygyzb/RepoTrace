[2285.538059, "o", "    12\tfunc Run(cfg *config.Config) (*stage.Stats, error) {\r\n    13\t\tstats := &stage.Stats{}\r\n    14\t\r\n    15\t\tstages, err := stage.Build(cfg.Stages)\r\n    16\t\tif err != nil {\r\n    17\t\t\treturn stats, err\r\n    18\t\t}\r\n    19\t\r\n    20\t\trecords, err := input.Read(cfg.Input, cfg.Dir)\r\n    21\t\tif err != nil {\r\n    22\t\t\treturn stats, err\r\n    23\t\t}\r\n    24\t\tstats.Processed = len(records)\r\n    25\t\r\n    26\t\tfor _, st := range stages {\r\n    27\t\t\trecords, err = st.Apply(records, os.Stderr, cfg.Strict, stats)\r\n    28\t\t\tif err != nil {\r\n    29\t\t\t\treturn stats, err\r\n    30\t\t\t}\r\n"]
[2285.538133, "o", "    31\t\t}\r\n    32\t\r\n    33\t\tn, err := output.Write(records, cfg.Output, cfg.Dir)\r\n    34\t\tif err != nil {\r\n    35\t\t\treturn stats, err\r\n    36\t\t}\r\n    37\t\tstats.Emitted = n\r\n    38\t\r\n    39\t\treturn stats, nil\r\n    40\t}\r\n"]
