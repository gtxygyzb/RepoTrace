[2612.732114, "o", "\\tout := make([]*record.Record, 0, len(order))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2612.732189, "o", "\\tfor _, key := range order {\r\n\u001b[?2004l\r\u001b[?2004h> "]
