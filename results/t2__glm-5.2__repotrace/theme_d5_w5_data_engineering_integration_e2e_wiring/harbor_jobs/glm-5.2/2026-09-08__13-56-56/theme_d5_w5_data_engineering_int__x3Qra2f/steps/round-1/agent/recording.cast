[1718.106349, "o", "func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\r\n\u001b[?2004l\r"]
[1718.106411, "o", "\u001b[?2004h> "]
