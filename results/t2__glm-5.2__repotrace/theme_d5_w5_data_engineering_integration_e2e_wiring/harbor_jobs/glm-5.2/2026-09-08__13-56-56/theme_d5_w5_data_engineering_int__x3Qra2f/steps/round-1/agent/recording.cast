[2612.729345, "o", "\\t\\t\\tif !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2612.729483, "o", "\\t\\t\\t\\treturn nil, fmt.Errorf(\"group: missing column %s\", col)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2612.729549, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
