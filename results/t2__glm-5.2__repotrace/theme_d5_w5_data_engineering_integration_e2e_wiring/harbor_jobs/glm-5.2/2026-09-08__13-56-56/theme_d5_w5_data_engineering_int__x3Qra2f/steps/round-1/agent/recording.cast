[2264.275211, "o", "package input\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/csv\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"strings\"\r\n\r\n\t\"example.com/flowctl/internal/config\"\r\n\t\"example.com/flowctl/internal/record\"\r\n)\r\n"]
[2264.275354, "o", "\r\nfunc Read(cfg config.InputConfig, dir string) ([]*record.Record, error) {\r\n\tswitch cfg.Format {\r\n\tcase \"csv\":\r\n\t\treturn readCSV(cfg, dir)\r\n\tcase \"ndjson\":\r\n\t\treturn readNDJSON(cfg, dir)\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"input: unsupported format %q\", cfg.Format)\r\n\t}\r\n}\r\n\r\nfunc readCSV(cfg config.InputConfig, dir string) ([]*record.Record, error) {\r\n\tpath := config.ResolvePath(dir, cfg.Path)\r\n\tf, err := os.Open(path)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"input: %v\", err)\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tr := csv.NewReader(f)\r\n\tr.FieldsPerRecord = 0\r\n\tr.TrimLeadingSpace = true\r\n\r\n\theader, err := r.Read()\r\n\tif err == io.EOF {\r\n\t"]
[2264.275434, "o", "\treturn nil, fmt.Errorf(\"input: empty CSV file\")\r\n\t}\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"input: %v\", err)\r\n\t}\r\n\r\n\trecords := []*record.Record{}\r\n\trowNum := 0\r\n\tfor {\r\n\t\trow, err := r.Read()\r\n\t\tif err == io.EOF {\r\n\t\t\tbreak\r\n\t\t}\r\n\t"]
[2264.275504, "o", "\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"input: row %d: %v\", rowNum+2, err)\r\n\t\t}\r\n\t\trowNum++\r\n\r\n\t\tif len(row) != len(header) {\r\n\t\t\treturn nil, fmt.Errorf(\"input: row %d: expected %d fields got %d\", rowNum+1, len(header), len(row))\r\n\t\t}\r\n\r\n\t\trec := record.New()\r\n"]
[2264.275564, "o", "\t\trec.InputRow = rowNum\r\n\t\tfor i, col := range header {\r\n\t\t\trec.Set(col, row[i])\r\n\t\t}\r\n\t\trecords = append(records, rec)\r\n\t}\r\n\r\n\treturn records, nil\r\n}\r\n\r\nfunc readNDJSON(cfg config.InputConfig, dir string) ([]*record.Record, error) {\r\n\tpath := config.ResolvePath(dir, cfg.Path)\r\n"]
[2264.275622, "o", "\tf, err := os.Open(path)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"input: %v\", err)\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tscanner := bufio.NewScanner(f)\r\n\tscanner.Buffer(make([]byte, 0, 1024*1024), 64*1024*1024)\r\n\r\n\trecords := []*record.Record{}\r\n\tlineNum := 0\r\n\t"]
[2264.275678, "o", "recNum := 0\r\n\tfor scanner.Scan() {\r\n\t\tlineNum++\r\n\t\tline := scanner.Text()\r\n\t\tif strings.TrimSpace(line) == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\trec, err := parseNDJSONLine(line, lineNum)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"input: line %d: %v\", lineNum, err)"]
[2264.275738, "o", "\r\n\t\t}\r\n\t\trecNum++\r\n\t\trec.InputRow = recNum\r\n\t\trecords = append(records, rec)\r\n\t}\r\n\tif err := scanner.Err(); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"input: %v\", err)\r\n"]
[2264.275851, "o", "\t}\r\n\r\n\treturn records, nil\r\n}\r\n\r\nfunc parseNDJSONLine(line string, lineNum int) (*record.Record, error) {\r\n\tdec := json.NewDecoder(strings.NewReader(line))\r\n\r\n\tt, err := dec.Token()\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"invalid JSON: %v\", err)\r\n\t}\r\n\tif t != json.Delim('{') {\r\n\t\treturn nil, fmt.Errorf(\"line is not a JSON object\")\r\n\t}\r\n\r\n\trec := record.New()\r\n\tfor {\r\n\t\tt, err := dec.Token()\r\n\t\tif err == io.EOF {\r\n"]
[2264.275912, "o", "\t\t\treturn nil, fmt.Errorf(\"unexpected end of object\")\r\n\t\t}\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"invalid JSON: %v\", err)\r\n\t\t}\r\n\t\tif t == json.Delim('}') {\r\n\t\t\tbreak\r\n\t\t}\r\n\r\n\t\tkey, ok := t.(string)\r\n\t\tif !ok {\r\n"]
[2264.275982, "o", "\t\t\treturn nil, fmt.Errorf(\"object key is not a string\")\r\n\t\t}\r\n\r\n\t\tvt, err := dec.Token()\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"value for %q: %v\", key, err)\r\n\t\t}\r\n\t\ts, ok := vt.(string)\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"value for %q is not a JSON string\", key)\r\n\t\t}\r\n\t\t"]
[2264.27605, "o", "rec.Set(key, s)\r\n\t}\r\n\r\n\tif dec.More() {\r\n\t\treturn nil, fmt.Errorf(\"unexpected trailing content\")\r\n\t}\r\n\r\n\treturn rec, nil\r\n}\r\n"]
