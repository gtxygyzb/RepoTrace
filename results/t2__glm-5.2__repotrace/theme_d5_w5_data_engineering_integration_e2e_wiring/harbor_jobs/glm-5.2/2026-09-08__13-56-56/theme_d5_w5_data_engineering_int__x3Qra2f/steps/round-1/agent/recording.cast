[2468.152045, "o", "\tif filepath.IsAbs(path) {\r\n\t\treturn path\r\n\t}\r\n\treturn filepath.Join(dir, path)\r\n}\r\n\r\nfunc getString(m map[string]interface{}, key string) (string, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn \"\", false\r\n\t}\r\n\tif s, ok := v.(string); ok {\r\n\t\treturn s, true\r\n\t}\r\n\treturn \"\", true\r\n}\r\n\r\nfunc toStringList(v interface{}) ([]string, error) {\r\n\tlist, ok := v.([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"must be a list of strings\")\r\n\t}\r\n\tout := []string{}\r\n\tfor i, item := range list {\r\n\t\ts, ok := item.(string)\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"entry %d must be a string\", i+1)\r\n\t\t}\r\n\t\tout = append(out, s)\r\n\t}\r\n\treturn out, nil\r\n}\r\n\r\n"]
[2468.152185, "o", "type yamlLine struct {\r\n\tindent int\r\n\ttext   string\r\n}\r\n\r\nfunc parseYAML(data []byte) (interface{}, error) {\r\n\tlines := []yamlLine{}\r\n\tscanner := bufio.NewScanner(bytes.NewReader(data))\r\n\tfor scanner.Scan() {\r\n\t\traw := scanner.Text()\r\n\t\tline := stripComment(raw)\r\n\t\tif strings.TrimSpace(line) == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tindent := 0\r\n\t\tfor indent < len(line) && line[indent] == ' ' {\r\n\t\t\tindent++\r\n\t\t}\r\n\t\tif indent < len(line) && line[indent] == '\\t' {\r\n\t\t\treturn nil, fmt.Errorf(\"tabs are not allowed for indentation\")\r\n\t\t}\r\n\t\ttext := strings.TrimRight(line[indent:], \" \\t\")\r\n"]
[2468.152308, "o", "\t\tlines = append(lines, yamlLine{indent: indent, text: text})\r\n\t}\r\n\tif err := scanner.Err(); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif len(lines) == 0 {\r\n\t\treturn nil, nil\r\n\t}\r\n\tval, _, err := parseNode(lines, 0, lines[0].indent)\r\n\treturn val, err\r\n}\r\n\r\nfunc parseNode(lines []yamlLine, start, indent int) (interface{}, int, error) {\r\n\tif start >= len(lines) || lines[start].indent < indent {\r\n\t\treturn nil, start, nil\r\n\t}\r\n\tif isSequenceLine(lines[start].text) {\r\n\t\treturn parseSequence(lines, start, indent)\r\n\t}\r\n\treturn parseMapping(lines, start, indent)\r\n}\r\n"]
[2468.152421, "o", "\r\nfunc isSequenceLine(text string) bool {\r\n\treturn text == \"-\" || strings.HasPrefix(text, \"- \")\r\n}\r\n\r\nfunc parseMapping(lines []yamlLine, start, indent int) (map[string]interface{}, int, error) {\r\n\tm := map[string]interface{}{}\r\n\ti := start\r\n\tfor i < len(lines) {\r\n\t\tif lines[i].indent < indent {\r\n\t\t\tbreak\r\n\t\t}\r\n\t\tif lines[i].indent > indent {\r\n\t\t\treturn nil, i, fmt.Errorf(\"unexpected indentation in mapping\")\r\n\t\t}\r\n\t\tif isSequenceLine(lines[i].text) {\r\n"]
