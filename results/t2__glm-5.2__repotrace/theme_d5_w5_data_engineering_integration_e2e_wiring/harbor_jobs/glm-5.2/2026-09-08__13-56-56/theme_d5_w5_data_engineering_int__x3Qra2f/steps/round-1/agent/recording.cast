[2265.61237, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n\r\n\t\"example.com/flowctl/internal/config\"\r\n"]
[2265.61249, "o", "\t\"example.com/flowctl/internal/pipeline\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"flowctl: usage: flowctl run --config <path> [--strict]\\n\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n\tif os.Args[1] != \"run\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"flowctl: unknown command %q\\n\", os.Args[1])\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n\targs := os.Args[2:]\r\n\tconfigPath := \"\"\r\n\tstrict := false\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tswitch {\r\n"]
[2265.612585, "o", "\t\tcase arg == \"--config\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"flowctl: --config requires a value\\n\")\r\n\t\t\t\tos.Exit(2)\r\n\t\t\t}\r\n\t\t\tconfigPath = args[i+1]\r\n\t\t\ti++\r\n\t\tcase strings.HasPrefix(arg, \"--config=\"):\r\n\t\t\tconfigPath = strings.TrimPrefix(arg, \"--config=\")\r\n\t\tcase arg == \"--strict\":\r\n\t\t\tstrict = true\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"flowctl: unknown flag %q\\n\", arg)\r\n"]
[2265.612648, "o", "\t\t\tos.Exit(2)\r\n\t\t}\r\n\t}\r\n\r\n\tif configPath == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"flowctl: --config is required\\n\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n"]
[2265.612708, "o", "\tcfg, err := config.Load(configPath)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"flowctl: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tcfg.Strict = strict\r\n\r\n\tstats, err := pipeline.Run(cfg)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"flowctl: %v\\n\", err)\r\n"]
[2265.612765, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfmt.Fprintf(os.Stderr, \"flowctl: processed=%d emitted=%d dropped_nonnumeric=%d dropped_missing=%d\\n\",\r\n\t\tstats.Processed, stats.Emitted, stats.DroppedNonNumeric, stats.DroppedMissing)\r\n}\r\n"]
