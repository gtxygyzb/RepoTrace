[1067.840733, "i", "cat > internal/config/config.go <<'EOF'\npackage config\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n)\n\ntype InputConfig struct {\n\tPath   string\n\tFormat string\n}\n\ntype OutputConfig struct {\n\tPath           string\n\tFormat         string\n\tColumns        []string\n\tColumnsPresent bool\n}\n\ntype Config struct {\n\tDir    string\n\tStrict bool\n\tInput  InputConfig\n\tStages []map[string]interface{}\n\tOutput OutputConfig\n}\n\nfunc Load(path string) (*Config, error) {\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"config: %v\", err)\n\t}\n\n\troot, err := parseYAML(data)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"config: %v\", err)\n\t}\n\n\tm, ok := root.(map[string]interface{})\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"config: top-level value must be a mapping\")\n\t}\n\n\tcfg := &Config{Dir: filepath.Dir(path)}\n\n\tinRaw, ok := m[\"input\"]\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"config: input is required\")\n\t}\n\tinMap, ok := inRaw.(map[string]interface{})\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"config"]
[1067.840971, "i", ": input must be a mapping\")\n\t}\n\tcfg.Input.Path = getString(inMap, \"path\")\n\tif cfg.Input.Path == \"\" {\n\t\treturn nil, fmt.Errorf(\"config: input.path is required\")\n\t}\n\tcfg.Input.Format = getString(inMap, \"format\")\n\tif cfg.Input.Format == \"\" {\n\t\treturn nil, fmt.Errorf(\"config: input.format is required\")\n\t}\n\tif cfg.Input.Format != \"csv\" && cfg.Input.Format != \"ndjson\" {\n\t\treturn nil, fmt.Errorf(\"config: input.format must be csv or ndjson\")\n\t}\n\n\tstRaw, ok := m[\"stages\"]\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"config: stages is required\")\n\t}\n\tstList, ok := stRaw.([]interface{})\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"config: stages must be a list\")\n\t}\n\tcfg.Stages = []map[string]interface{}{}\n\tfor i, item := range stList {\n\t\tsm, ok := item.(map[string]interface{})\n\t\tif !ok {\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d must be a mapping\", i+1)\n\t\t}\n\t\tcfg.Stages = append(cfg.Stages, sm)\n\t}\n\n\toutRaw, ok := m[\"output\"]\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"config: output is required\")\n\t}\n\toutMap, ok := outRaw.(map[string]interface{}"]
[1067.841036, "i", ")\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"config: output must be a mapping\")\n\t}\n\tcfg.Output.Path = getString(outMap, \"path\")\n\tif cfg.Output.Path == \"\" {\n\t\treturn nil, fmt.Errorf(\"config: output.path is required\")\n\t}\n\tcfg.Output.Format = getString(outMap, \"format\")\n\tif cfg.Output.Format == \"\" {\n\t\treturn nil, fmt.Errorf(\"config: output.format is required\")\n\t}\n\tif cfg.Output.Format != \"jsonl\" {\n\t\treturn nil, fmt.Errorf(\"config: output.format must be jsonl\")\n\t}\n\tif colRaw, present := outMap[\"columns\"]; present {\n\t\tcfg.Output.ColumnsPresent = true\n\t\tcols, err := toStringList(colRaw)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"config: output.columns: %v\", err)\n\t\t}\n\t\tcfg.Output.Columns = cols\n\t}\n\n\treturn cfg, nil\n}\n\nfunc ResolvePath(dir, path string) string {\n\tif filepath.IsAbs(path) {\n\t\treturn path\n\t}\n\treturn filepath.Join(dir, path)\n}\n\nfunc getString(m map[string]interface{}, key string) string {\n\tif v, ok := m[key]; ok {\n\t\tif s, ok := v.(string); ok {\n\t\t\treturn s\n\t\t}\n\t\treturn fmt.Sprintf(\"%v\", v)\n\t}\n\treturn \"\"\n}\n\nfu"]
[1067.841093, "i", "nc toStringList(v interface{}) ([]string, error) {\n\tlist, ok := v.([]interface{})\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"must be a list of strings\")\n\t}\n\tout := []string{}\n\tfor i, item := range list {\n\t\ts, ok := item.(string)\n\t\tif !ok {\n\t\t\treturn nil, fmt.Errorf(\"entry %d must be a string\", i+1)\n\t\t}\n\t\tout = append(out, s)\n\t}\n\treturn out, nil\n}\n\ntype yamlLine struct {\n\tindent int\n\ttext   string\n}\n\nfunc parseYAML(data []byte) (interface{}, error) {\n\tlines := []yamlLine{}\n\tscanner := bufio.NewScanner(bytes.NewReader(data))\n\tfor scanner.Scan() {\n\t\traw := scanner.Text()\n\t\tline := stripComment(raw)\n\t\tif strings.TrimSpace(line) == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tindent := 0\n\t\tfor indent < len(line) && line[indent] == ' ' {\n\t\t\tindent++\n\t\t}\n\t\tif indent < len(line) && line[indent] == '\\t' {\n\t\t\treturn nil, fmt.Errorf(\"tabs are not allowed for indentation\")\n\t\t}\n\t\ttext := strings.TrimRight(line[indent:], \" \\t\")\n\t\tlines = append(lines, yamlLine{indent: indent, text: text})\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\treturn nil, err\n\t}\n"]
[1067.84114, "o", "cat > internal/config/config.go <<'EOF'\r\n\u001b[?2004l\rnc toStringList(v interface{}) ([]stri"]
