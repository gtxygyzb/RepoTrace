[1067.530076, "i", "cat > internal/record/record.go <<'EOF'\npackage record\n\n// Record is an ordered string-to-string record.\n// Order preserves the first-seen field order for the record.\ntype Record struct {\n\tOrder   []string\n\tValues  map[string]string\n\tInputRow int\n}\n\nfunc New() *Record {\n\treturn &Record{\n\t\tOrder:  []string{},\n\t\tValues: map[string]string{},\n\t}\n}\n\nfunc (r *Record) Set(key, val string) {\n\tif _, ok := r.Values[key]; !ok {\n\t\tr.Order = append(r.Order, key)\n\t}\n\tr.Values[key] = val\n}\n\nfunc (r *Record) Get(key string) (string, bool) {\n\tv, ok := r.Values[key]\n\treturn v, ok\n}\n\nfunc (r *Record) Has(key string) bool {\n\t_, ok := r.Values[key]\n\treturn ok\n}\n\nfunc (r *Record) Copy() *Record {\n\tnr := New()\n\tnr.InputRow = r.InputRow\n\tfor _, k := range r.Order {\n\t\tnr.Set(k, r.Values[k])\n\t}\n\treturn nr\n}\nEOF\n"]
