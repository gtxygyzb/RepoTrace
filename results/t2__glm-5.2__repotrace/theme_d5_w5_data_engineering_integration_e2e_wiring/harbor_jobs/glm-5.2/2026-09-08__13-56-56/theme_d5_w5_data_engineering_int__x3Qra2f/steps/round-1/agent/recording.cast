[1718.123068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.123159, "o", "func buildLimit(idx int, sm map[string]interface{}) (Stage, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.123221, "o", "    countRaw, ok := sm[\"count\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.123274, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.123384, "o", "        return nil, fmt.Errorf(\"config: stage %d: limit.count is required\", idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.123414, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.123549, "o", "    countStr, ok := countRaw.(string)\r\n\u001b[?2004l\r\u001b[?2004h>     if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.123661, "o", "        return nil, fmt.Errorf(\"config: stage %d: limit.count must be a non-negative integer\", idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.123726, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.12379, "o", "    n, err := strconv.Atoi(countStr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.123847, "o", "    if err != nil || n < 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.123965, "o", "        return nil, fmt.Errorf(\"config: stage %d: limit.count must be a non-negative integer\", idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.124022, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.124076, "o", "    return &LimitStage{count: n}, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1718.12413, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.124224, "o", "func getString(m map[string]interface{}, key string) (string, bool) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.124284, "o", "    v, ok := m[key]\r\n\u001b[?2004l\r\u001b[?2004h>     if !ok {\r\n\u001b[?2004l\r"]
[1718.124338, "o", "\u001b[?2004h>         return \"\", false\r\n\u001b[?2004l\r"]
[1718.124391, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.124446, "o", "    if s, ok := v.(string); ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.124513, "o", "        return s, true\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1718.124574, "o", ">     return fmt.Sprintf(\"%v\", v), true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.124628, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.124693, "o", "func parseFloat(s string) (float64, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.124763, "o", "    f, err := strconv.ParseFloat(s, 64)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.124827, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.124882, "o", "        return 0, err\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.124956, "o", "    if math.IsNaN(f) || math.IsInf(f, 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.125045, "o", "        return 0, fmt.Errorf(\"not a finite number\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.125098, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     return f, nil\r\n\u001b[?2004l\r"]
[1718.125152, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.125254, "o", "func compareFloats(left float64, op string, right float64) bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.125318, "o", "    switch op {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.125377, "o", "    case \"<\":\r\n\u001b[?2004l\r\u001b[?2004h>         return left < right\r\n\u001b[?2004l\r\u001b[?2004h"]
[1718.125431, "o", ">     case \"<=\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.125494, "o", "        return left <= right\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.125548, "o", "    case \">\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.125602, "o", "        return left > right\r\n\u001b[?2004l\r\u001b[?2004h>     case \">=\":\r\n\u001b[?2004l\r"]
[1718.125657, "o", "\u001b[?2004h>         return left >= right\r\n\u001b[?2004l\r"]
[1718.125715, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.125788, "o", "    return false\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1718.125834, "o", "> EOF\r\n\u001b[?2004l\r"]
[1718.128931, "o", "\u001b[?2004hroot@n30009:/app# "]
[1718.391875, "i", "cat > internal/output/output.go <<'EOF'\npackage output\n\nimport (\n    \"bytes\"\n    \"fmt\"\n    \"os\"\n    \"path/filepath\"\n    \"strings\"\n\n    \"example.com/flowctl/internal/config\"\n    \"example.com/flowctl/internal/record\"\n)\n\nfunc Write(records []*record.Record, cfg config.OutputConfig, dir string) (int, error) {\n    var buf bytes.Buffer\n\n    for _, r := range records {\n        if cfg.ColumnsPresent {\n            writeObject(&buf, cfg.Columns, r)\n        } else {\n            writeObject(&buf, r.Order, r)\n        }\n        buf.WriteByte('\\n')\n    }\n\n    if cfg.Path == \"-\" {\n        if _, err := os.Stdout.Write(buf.Bytes()); err != nil {\n            return 0, fmt.Errorf(\"output: %v\", err)\n        }\n        return len(records), nil\n    }\n\n    full := config.ResolvePath(dir, cfg.Path)\n    dirName := filepath.Dir(full)\n\n    tmp, err := os.CreateTemp(dirName, \".flowctl-output-*\")\n    if err != nil {\n        return 0, fmt.Errorf(\"output: %v\", err)\n    }\n\n    if _, err := tmp.Write(buf.Bytes()); err != nil {\n        tmp.Clos"]
[1718.392107, "i", "e()\n        os.Remove(tmp.Name())\n        return 0, fmt.Errorf(\"output: %v\", err)\n    }\n    if err := tmp.Close(); err != nil {\n        os.Remove(tmp.Name())\n        return 0, fmt.Errorf(\"output: %v\", err)\n    }\n    if err := os.Rename(tmp.Name(), full); err != nil {\n        os.Remove(tmp.Name())\n        return 0, fmt.Errorf(\"output: %v\", err)\n    }\n\n    return len(records), nil\n}\n\nfunc writeObject(buf *bytes.Buffer, cols []string, r *record.Record) {\n    buf.WriteByte('{')\n    for i, col := range cols {\n        if i > 0 {\n            buf.WriteByte(',')\n        }\n        buf.WriteString(encodeJSONString(col))\n        buf.WriteByte(':')\n        val := \"\"\n        if v, ok := r.Get(col); ok {\n            val = v\n        }\n        buf.WriteString(encodeJSONString(val))\n    }\n    buf.WriteByte('}')\n}\n\nfunc encodeJSONString(s string) string {\n    var b strings.Builder\n    b.WriteByte('\"')\n    for i := 0; i < len(s); i++ {\n        c := s[i]\n        switch c {\n        case '\\\\':\n            b.WriteString(\"\\\\\\\\\")\n    "]
[1718.392203, "i", "    case '\"':\n            b.WriteString(\"\\\\\\\"\")\n        case '\\n':\n            b.WriteString(\"\\\\n\")\n        case '\\r':\n            b.WriteString(\"\\\\r\")\n        case '\\t':\n            b.WriteString(\"\\\\t\")\n        default:\n            if c < 0x20 {\n                fmt.Fprintf(&b, \"\\\\u%04x\", c)\n            } else {\n                b.WriteByte(c)\n            }\n        }\n    }\n    b.WriteByte('\"')\n    return b.String()\n}\nEOF\n"]
