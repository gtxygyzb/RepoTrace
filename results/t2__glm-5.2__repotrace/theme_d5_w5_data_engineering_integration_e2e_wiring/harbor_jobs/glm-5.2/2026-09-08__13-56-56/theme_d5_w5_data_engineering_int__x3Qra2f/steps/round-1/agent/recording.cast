[1718.101651, "o", "type ProjectColumn struct {\r\n\u001b[?2004l\r"]
[1718.101705, "o", "\u001b[?2004h> "]
[1718.101778, "o", "    Source string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.101863, "o", "    Target string\r\n\u001b[?2004l\rj"]
[1718.101917, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
