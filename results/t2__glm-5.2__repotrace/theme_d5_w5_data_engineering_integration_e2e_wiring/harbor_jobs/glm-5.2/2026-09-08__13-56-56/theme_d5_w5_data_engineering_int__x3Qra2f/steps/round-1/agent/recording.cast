[2276.019077, "o", "\t\"strings\"\r\n     7\t\r\n     8\t\t\"example.com/flowctl/internal/config\"\r\n     9\t\t\"example.com/flowctl/internal/pipeline\"\r\n    10\t)\r\n    11\t\r\n    12\tfunc main() {\r\n    13\t\tif len(os.Args) < 2 {\r\n    14\t\t\tfmt.Fprintf(os.Stderr, \"flowctl: usage: flowctl run --config <path> [--strict]\\n\")\r\n    15\t\t\tos.Exit(2)\r\n    16\t\t}\r\n    17\t\r\n    18\t\tif os.Args[1] != \"run\" {\r\n    19\t\t\tfmt.Fprintf(os.Stderr, \"flowctl: unknown command %q\\n\", os.Args[1])\r\n    20\t\t\tos.Exit(2)\r\n    21\t\t}\r\n    22\t\r\n    23\t\targs := os.Args[2:]\r\n    24\t\tconfigPath := \"\"\r\n    25\t\tstrict := false\r\n"]
[2276.019162, "o", "    26\t\r\n    27\t\tfor i := 0; i < len(args); i++ {\r\n    28\t\t\targ := args[i]\r\n    29\t\t\tswitch {\r\n    30\t\t\tcase arg == \"--config\":\r\n    31\t\t\t\tif i+1 >= len(args) {\r\n    32\t\t\t\t\tfmt.Fprintf(os.Stderr, \"flowctl: --config requires a value\\n\")\r\n    33\t\t\t\t\tos.Exit(2)\r\n    34\t\t\t\t}\r\n    35\t\t\t\tconfigPath = args[i+1]\r\n    36\t\t\t\ti++\r\n    37\t\t\tcase strings.HasPrefix(arg, \"--config=\"):\r\n    38\t\t\t\t"]
[2276.01923, "o", "configPath = strings.TrimPrefix(arg, \"--config=\")\r\n    39\t\t\tcase arg == \"--strict\":\r\n    40\t\t\t\tstrict = true\r\n    41\t\t\tdefault:\r\n    42\t\t\t\tfmt.Fprintf(os.Stderr, \"flowctl: unknown flag %q\\n\", arg)\r\n    43\t\t\t\tos.Exit(2)\r\n    44\t\t\t}\r\n    45\t\t}\r\n    46\t\r\n    47\t\tif configPath == \"\" {\r\n"]
[2276.019339, "o", "    48\t\t\tfmt.Fprintf(os.Stderr, \"flowctl: --config is required\\n\")\r\n    49\t\t\tos.Exit(2)\r\n    50\t\t}\r\n    51\t\r\n    52\t\tcfg, err := config.Load(configPath)\r\n    53\t\tif err != nil {\r\n    54\t\t\tfmt.Fprintf(os.Stderr, \"flowctl: %v\\n\", err)\r\n"]
[2276.019417, "o", "    55\t\t\tos.Exit(1)\r\n    56\t\t}\r\n    57\t\tcfg.Strict = strict\r\n    58\t\r\n    59\t\tstats, err := pipeline.Run(cfg)\r\n    60\t\tif err != nil {\r\n    61\t\t\tfmt.Fprintf(os.Stderr, \"flowctl: %v\\n\", err)\r\n    62\t\t\tos.Exit(1)\r\n    63\t\t}\r\n    64\t\r\n    65\t\tfmt.Fprintf(os.Stderr, \"flowctl: processed=%d emitted=%d dropped_nonnumeric=%d dropped_missing=%d\\n\",\r\n    66\t\t\tstats.Processed, stats.Emitted, stats.DroppedNonNumeric, stats.DroppedMissing)\r\n    67\t}\r\n"]
