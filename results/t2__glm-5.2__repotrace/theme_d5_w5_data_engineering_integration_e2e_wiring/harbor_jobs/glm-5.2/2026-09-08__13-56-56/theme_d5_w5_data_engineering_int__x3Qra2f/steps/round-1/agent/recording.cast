[3264.027112, "i", "cd /app && go build -o /app/flowctl ./cmd/flowctl && go test ./... && go vet ./... && cd /tmp/flowctl_example && set -e\necho \"=== missing query ===\"\n/app/flowctl run --config missing_query.yaml; echo \"exit=$?\"\necho \"=== blob ===\"\n/app/flowctl run --config blob.yaml; echo \"exit=$?\"\necho \"=== missing db ===\"\n/app/flowctl run --config missing_db.yaml; echo \"exit=$?\"\necho \"=== query error ===\"\n/app/flowctl run --config query_error.yaml; echo \"exit=$?\"\necho \"=== sqlite values ===\"\n/app/flowctl run --config values.yaml; echo \"exit=$?\"; cat out_values.jsonl\necho \"=== csv compatibility ===\"\n/app/flowctl run --config csv.yaml; echo \"exit=$?\"; cat out_csv.jsonl\n"]
[3264.027969, "o", "cd /app && go build -o /app/flowctl ./cmd/flowctl && go test ./... && go vet ./... && cd /tmp/flowctl_example && set -e\r\n\u001b[?2004l\r"]
