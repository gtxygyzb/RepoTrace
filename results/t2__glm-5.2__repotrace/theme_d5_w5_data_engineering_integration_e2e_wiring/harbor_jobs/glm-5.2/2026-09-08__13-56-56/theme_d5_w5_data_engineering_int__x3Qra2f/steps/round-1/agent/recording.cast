[3177.803813, "o", "\u001b[?2004h> "]
[3177.803914, "o", "  format: jsonl\r\n\u001b[?2004l\r"]
[3177.803969, "o", "\u001b[?2004h> "]
[3177.804024, "o", "EOF\r\n\u001b[?2004l\r"]
[3177.806989, "o", "\u001b[?2004h"]
[3177.807056, "o", "root@n30009:/tmp/flowctl_example# "]
[3177.807343, "o", "/app/flowctl run --config bad_group.yaml; echo \"exit=$?\"\r\n\u001b[?2004l\r"]
[3177.812446, "o", "flowctl: config: stage 1: group.by must be non-empty\r\n"]
[3177.813109, "o", "exit=1\r\n"]
[3177.813199, "o", "\u001b[?2004h"]
[3177.813256, "o", "root@n30009:/tmp/flowctl_example# "]
[3177.813396, "o", "cat > bad_agg.yaml <<'EOF'\r\n\u001b[?2004l\r"]
[3177.813448, "o", "\u001b[?2004h> "]
[3177.813509, "o", "input:\r\n\u001b[?2004l\r"]
[3177.813564, "o", "\u001b[?2004h> "]
[3177.813668, "o", "  path: orders.db\r\n\u001b[?2004l\r"]
[3177.813728, "o", "\u001b[?2004h> "]
[3177.813842, "o", "  format: sqlite\r\n\u001b[?2004l\r"]
[3177.813897, "o", "\u001b[?2004h> "]
[3177.814013, "o", "  query: \"SELECT 1\"\r\n\u001b[?2004l\r"]
[3177.814068, "o", "\u001b[?2004h> "]
[3177.814127, "o", "stages:\r\n\u001b[?2004l\r"]
[3177.814182, "o", "\u001b[?2004h> "]
[3177.814263, "o", "  - type: group\r\n\u001b[?2004l\r"]
[3177.814318, "o", "\u001b[?2004h> "]
[3177.814418, "o", "    by: [status]\r\n\u001b[?2004l\r"]
[3177.814473, "o", "\u001b[?2004h> "]
[3177.814565, "o", "    aggregates:\r\n\u001b[?2004l\r"]
[3177.81462, "o", "\u001b[?2004h> "]
[3177.814706, "o", "      - as: n\r\n\u001b[?2004l\r"]
[3177.81476, "o", "\u001b[?2004h> "]
[3177.814876, "o", "        op: count\r\n\u001b[?2004l\r"]
[3177.814933, "o", "\u001b[?2004h> "]
[3177.815066, "o", "        column: amount\r\n\u001b[?2004l\r"]
[3177.81512, "o", "\u001b[?2004h> "]
[3177.815173, "o", "output:\r\n\u001b[?2004l\r"]
[3177.815227, "o", "\u001b[?2004h> "]
[3177.815331, "o", "  path: out.jsonl\r\n\u001b[?2004l\r"]
[3177.815386, "o", "\u001b[?2004h> "]
[3177.81548, "o", "  format: jsonl\r\n\u001b[?2004l\r"]
[3177.815546, "o", "\u001b[?2004h> "]
[3177.8156, "o", "EOF\r\n\u001b[?2004l\r"]
[3177.81813, "o", "\u001b[?2004h"]
[3177.8182, "o", "root@n30009:/tmp/flowctl_example# "]
[3177.818489, "o", "/app/flowctl run --config bad_agg.yaml; echo \"exit=$?\"\r\n\u001b[?2004l\r"]
[3177.823508, "o", "flowctl: config: stage 1: group.aggregates entry 1: column must not be present for count\r\n"]
[3177.824146, "o", "exit=1\r\n"]
[3177.824232, "o", "\u001b[?2004h"]
[3177.82429, "o", "root@n30009:/tmp/flowctl_example# "]
