[2265.039719, "o", "sed -n '1,260p' internal/pipeline/pipeline.go\r\n\u001b[?2004l\r"]
[2265.042639, "o", "package pipeline\r\n\r\nimport (\r\n\t\"os\"\r\n\r\n\t\"example.com/flowctl/internal/config\"\r\n\t\"example.com/flowctl/internal/input\"\r\n\t\"example.com/flowctl/internal/output\"\r\n\t\"example.com/flowctl/internal/stage\"\r\n"]
[2265.042802, "o", ")\r\n\r\nfunc Run(cfg *config.Config) (*stage.Stats, error) {\r\n\tstats := &stage.Stats{}\r\n\r\n\tstages, err := stage.Build(cfg.Stages)\r\n\tif err != nil {\r\n\t\treturn stats, err\r\n"]
[2265.042882, "o", "\t}\r\n\r\n\trecords, err := input.Read(cfg.Input, cfg.Dir)\r\n\tif err != nil {\r\n\t\treturn stats, err\r\n\t}\r\n\tstats.Processed = len(records)\r\n\r\n\tfor _, st := range stages {\r\n\t\trecords, err = st.Apply(records, os.Stderr, cfg.Strict, stats)\r\n\t\tif err != nil {\r\n\t\t\treturn stats, err\r\n\t\t}\r\n\t}\r\n\r\n\tn, err := output.Write(records, cfg.Output, cfg.Dir)\r\n\tif err != nil {\r\n\t\treturn stats, err\r\n\t}\r\n\tstats.Emitted = n\r\n\r\n\treturn stats, nil\r\n}\r\n"]
[2265.043353, "o", "\u001b[?2004h"]
[2265.043449, "o", "root@n30009:/app# "]
[2265.330305, "i", "sed -n '1,220p' internal/output/output.go\n"]
[2265.330646, "o", "sed -n '1,220p' internal/output/output.go\r\n\u001b[?2004l\r"]
[2265.333844, "o", "package output\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[2265.333966, "o", "\t\"path/filepath\"\r\n\t\"strings\"\r\n\r\n\t\"example.com/flowctl/internal/config\"\r\n\t\"example.com/flowctl/internal/record\"\r\n)\r\n"]
[2265.334041, "o", "\r\nfunc Write(records []*record.Record, cfg config.OutputConfig, dir string) (int, error) {\r\n\tvar buf bytes.Buffer\r\n\r\n\tfor _, r := range records {\r\n\t\tif cfg.ColumnsPresent {\r\n\t\t\twriteObject(&buf, cfg.Columns, r)\r\n\t\t} else {\r\n\t\t\twriteObject(&buf, r.Order, r)\r\n\t\t}\r\n\t\tbuf.WriteByte('\\n')\r\n\t}\r\n\r\n\tif cfg.Path == \"-\" {\r\n\t\tif _, err := os.Stdout.Write(buf.Bytes()); err != nil {\r\n\t\t\treturn 0, fmt.Errorf(\"output: %v\", err)\r\n\t\t}\r\n\t\treturn len(records), nil\r\n\t}\r\n\r\n\tfull := config.ResolvePath(dir, cfg.Path)\r\n\tdirName := filepath.Dir(full)\r\n\r\n\ttmp, err := os.CreateTemp(dirName, \".flowctl-output-*\")\r\n\tif err != nil {\r\n"]
[2265.33413, "o", "\t\treturn 0, fmt.Errorf(\"output: %v\", err)\r\n\t}\r\n\r\n\tif _, err := tmp.Write(buf.Bytes()); err != nil {\r\n\t\ttmp.Close()\r\n\t\tos.Remove(tmp.Name())\r\n\t\treturn 0, fmt.Errorf(\"output: %v\", err)\r\n\t}\r\n\tif err := tmp.Close(); err != nil {\r\n\t\tos.Remove(tmp.Name())\r\n\t\treturn 0, fmt.Errorf(\"output: %v\", err)\r\n\t"]
[2265.334237, "o", "}\r\n\tif err := os.Rename(tmp.Name(), full); err != nil {\r\n\t\tos.Remove(tmp.Name())\r\n\t\treturn 0, fmt.Errorf(\"output: %v\", err)\r\n\t}\r\n\r\n\treturn len(records), nil\r\n}\r\n\r\nfunc writeObject(buf *bytes.Buffer, cols []string, r *record.Record) {\r\n\tbuf.WriteByte('{')\r\n\tfor i, col := range cols {\r\n\t\tif i > 0 {\r\n\t\t\tbuf.WriteByte(',')\r\n\t\t}\r\n\t\tbuf.WriteString(encodeJSONString(col))\r\n\t\tbuf.WriteByte(':')\r\n\t\tval := \"\"\r\n"]
[2265.334297, "o", "\t\tif v, ok := r.Get(col); ok {\r\n\t\t\tval = v\r\n\t\t}\r\n\t\tbuf.WriteString(encodeJSONString(val))\r\n\t}\r\n\tbuf.WriteByte('}')\r\n}\r\n\r\nfunc encodeJSONString(s string) string {\r\n\tvar b strings.Builder\r\n\tb.WriteByte('\"')\r\n"]
[2265.334363, "o", "\tfor i := 0; i < len(s); i++ {\r\n\t\tc := s[i]\r\n\t\tswitch c {\r\n\t\tcase '\\\\':\r\n\t\t\tb.WriteString(\"\\\\\\\\\")\r\n\t\tcase '\"':\r\n\t\t\tb.WriteString(\"\\\\\\\"\")\r\n\t\tcase '\\n':\r\n\t\t\tb.WriteString(\"\\\\n\")\r\n"]
[2265.33445, "o", "\t\tcase '\\r':\r\n\t\t\tb.WriteString(\"\\\\r\")\r\n\t\tcase '\\t':\r\n\t\t\tb.WriteString(\"\\\\t\")\r\n\t\tdefault:\r\n\t\t\tif c < 0x20 {\r\n\t\t\t\tfmt.Fprintf(&b, \"\\\\u%04x\", c)\r\n\t\t\t} else {\r\n\t\t\t\tb.WriteByte(c)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tb.WriteByte('\"')\r\n\treturn b.String()\r\n}\r\n"]
