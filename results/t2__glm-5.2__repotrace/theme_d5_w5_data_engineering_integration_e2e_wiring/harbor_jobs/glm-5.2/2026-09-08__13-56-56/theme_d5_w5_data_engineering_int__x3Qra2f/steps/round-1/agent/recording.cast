[2889.916267, "i", "cat > /tmp/flowctl_example/pipeline.yaml <<'EOF'\ninput:\n  path: orders.db\n  format: sqlite\n  query: \"SELECT order_id, customer, amount, currency, status FROM orders ORDER BY order_id\"\nstages:\n  - type: filter\n    where:\n      column: status\n      op: \"==\"\n      value: paid\n  - type: group\n    by: [currency]\n    aggregates:\n      - as: n\n        op: count\n      - as: total\n        op: sum\n        column: amount\n      - as: avg_amount\n        op: avg\n        column: amount\n  - type: sort\n    keys:\n      - column: total\n        order: desc\n        as: number\noutput:\n  path: out.jsonl\n  format: jsonl\nEOF\n"]
