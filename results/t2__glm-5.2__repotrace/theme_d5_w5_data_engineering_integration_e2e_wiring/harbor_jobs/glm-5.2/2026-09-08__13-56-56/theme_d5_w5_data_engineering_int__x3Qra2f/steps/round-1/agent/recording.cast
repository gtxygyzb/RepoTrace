[1718.102822, "o", "func (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\r\n\u001b[?2004l\r"]
[1718.102879, "o", "\u001b[?2004h> "]
[1718.103044, "o", "    out := make([]*record.Record, 0, len(in))\r\n\u001b[?2004l\r"]
[1718.103099, "o", "\u001b[?2004h> "]
[1718.103199, "o", "    for _, r := range in {\r\n\u001b[?2004l\r"]
[1718.103253, "o", "\u001b[?2004h> "]
[1718.103337, "o", "        nr := record.New()\r\n\u001b[?2004l\r"]
[1718.103391, "o", "\u001b[?2004h> "]
