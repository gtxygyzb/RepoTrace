[1718.110039, "o", "> "]
[1718.110116, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.110222, "o", "                    return af < bf\r\n\u001b[?2004l\r"]
[1718.110282, "o", "\u001b[?2004h> "]
[1718.110337, "o", "                }\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[1718.110403, "o", "            } else {\r\n\u001b[?2004l\r\"\u001b[?2004h"]
[1718.110457, "o", "> "]
