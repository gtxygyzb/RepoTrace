[1718.111044, "o", "\u001b[?2004h> "]
[1718.111137, "o", "                    return a < b\r\n\u001b[?2004l\r\u001b[?2004h"]
[1718.111207, "o", "> "]
[1718.111262, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
