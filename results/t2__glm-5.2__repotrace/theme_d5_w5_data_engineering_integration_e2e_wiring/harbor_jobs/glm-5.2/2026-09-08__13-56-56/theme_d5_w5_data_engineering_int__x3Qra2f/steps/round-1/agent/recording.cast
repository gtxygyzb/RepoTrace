[2264.748692, "o", ")\r\n\r\ntype Stats struct {\r\n\tProcessed         int\r\n\tEmitted           int\r\n\tDroppedNonNumeric int\r\n\tDroppedMissing    int\r\n\tmissingReported   bool\r\n}\r\n\r\ntype Stage interface {\r\n\tApply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error)\r\n}\r\n\r\nfunc Build(rawStages []map[string]interface{}) ([]Stage, error) {\r\n\tstages := make([]Stage, 0, len(rawStages))\r\n\tfor i, sm := range rawStages {\r\n\t\ttyp, ok := getString(sm, \"type\")\r\n\t\tif !ok || typ == \"\" {\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: type is required\", i+1)\r\n\t\t}\r\n\r\n\t\tvar st Stage\r\n\t\tvar err error\r\n\t\tswitch typ {\r\n\t\tcase \"filter\":\r\n\t\t\tst, err = buildFilter(i+1, sm)\r\n\t\tcase \"project\":\r\n\t\t\tst, err = buildProject(i+1, sm)\r\n\t\tcase \"sort\":\r\n\t\t"]
[2264.748826, "o", "\tst, err = buildSort(i+1, sm)\r\n\t\tcase \"limit\":\r\n\t\t\tst, err = buildLimit(i+1, sm)\r\n\t\tdefault:\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: unknown stage type %q\", i+1, typ)\r\n\t\t}\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tstages = append(stages, st)\r\n\t}\r\n\treturn stages, nil\r\n}\r\n\r\ntype FilterStage struct {\r\n\tcolumn string\r\n\top     string\r\n\tvalue  string\r\n"]
[2264.748915, "o", "}\r\n\r\nfunc (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\r\n\tout := make([]*record.Record, 0, len(in))\r\n\r\n\tfor _, r := range in {\r\n\t\tv, ok := r.Get(s.column)\r\n\t\tif !ok {\r\n\t\t\tstats.DroppedMissing++\r\n\t\t\tif !stats.missingReported {\r\n\t\t\t\tfmt.Fprintf(stderr, \"flowctl: filter: missing column %s\\n\", s.column)\r\n\t\t\t\tstats.missingReported = true\r\n\t\t\t}\r\n\t\t\tif strict {\r\n\t\t\t\treturn nil, fmt.Errorf(\"filter: missing column %s\", s.column)\r\n\t\t\t}\r\n\t"]
[2264.749009, "o", "\t\tcontinue\r\n\t\t}\r\n\r\n\t\tkeep := false\r\n\t\tswitch s.op {\r\n\t\tcase \"==\":\r\n"]
[2264.749072, "o", "\t\t\tkeep = v == s.value\r\n\t\tcase \"!=\":\r\n\t\t\tkeep = v != s.value\r\n\t\tdefault:\r\n\t\t\tleft, err := parseFloat(v)\r\n\t\t\tif err != nil {\r\n\t\t\t\tstats.DroppedNonNumeric++\r\n\t\t\t\tfmt.Fprintf(stderr, \"flowctl: filter: drop non-numeric row %d\\n\", r.InputRow)\r\n\t\t\t\tif strict {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"filter: drop non-numeric row %d\", r.InputRow)\r\n\t\t\t\t}\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tright, err := parseFloat(s.value)\r\n\t\t\tif err != nil {\r\n\t\t\t\tstats.DroppedNonNumeric++\r\n\t\t\t\tfmt.Fprintf(stderr, \"flowctl: filter: drop non-numeric row %d\\n\", r.InputRow)\r\n"]
[2264.749131, "o", "\t\t\t\tif strict {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"filter: drop non-numeric row %d\", r.InputRow)\r\n\t\t\t\t}\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tkeep = compareFloats(left, s.op, right)\r\n\t\t}\r\n\r\n\t\tif keep {\r\n\t\t\tout = append(out, r)\r\n"]
[2264.749192, "o", "\t\t}\r\n\t}\r\n\r\n\treturn out, nil\r\n}\r\n\r\ntype ProjectColumn struct {\r\n\tSource string\r\n\tTarget string\r\n}\r\n\r\ntype ProjectStage struct {\r\n"]
[2264.749256, "o", "\tcolumns []ProjectColumn\r\n}\r\n\r\nfunc (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\r\n\tout := make([]*record.Record, 0, len(in))\r\n\tfor _, r := range in {\r\n\t\tnr := record.New()\r\n\t\tnr.InputRow = r.InputRow\r\n\t\tfor _, c := range s.columns {\r\n\t\t\tval := \"\"\r\n\t\t\tif v, ok := r.Get(c.Source); ok {\r\n"]
[2264.749311, "o", "\t\t\t\tval = v\r\n\t\t\t}\r\n\t\t\tnr.Set(c.Target, val)\r\n\t\t}\r\n\t\tout = append(out, nr)\r\n\t}\r\n\treturn out, nil\r\n}\r\n"]
[2264.749388, "o", "\r\ntype SortKey struct {\r\n\tColumn string\r\n\tOrder  string\r\n\tAs     string\r\n}\r\n\r\ntype SortStage struct {\r\n\tkeys []SortKey\r\n}\r\n\r\nfunc (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\r\n\tfor _, key := range s.keys {\r\n\t\tif key.As == \"number\" {\r\n\t\t\tfor _, r := range in {\r\n"]
[2264.749445, "o", "\t\t\t\tv, ok := r.Get(key.Column)\r\n\t\t\t\tif !ok {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"sort: column %s is missing\", key.Column)\r\n\t\t\t\t}\r\n\t\t\t\tif _, err := parseFloat(v); err != nil {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"sort: column %s value %q is not a number\", key.Column, v)\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[2264.749505, "o", "\t\t}\r\n\t}\r\n\r\n\tsort.SliceStable(in, func(i, j int) bool {\r\n\t\tfor _, key := range s.keys {\r\n\t\t\ta, _ := in[i].Get(key.Column)\r\n\t\t\tb, _ := in[j].Get(key.Column)\r\n\r\n\t\t\tif key.As == \"number\" {\r\n\t\t\t\taf, _ := parseFloat(a)\r\n"]
[2264.749566, "o", "\t\t\t\tbf, _ := parseFloat(b)\r\n\t\t\t\tif af != bf {\r\n\t\t\t\t\tif key.Order == \"desc\" {\r\n\t\t\t\t\t\treturn af > bf\r\n\t\t\t\t\t}\r\n\t\t\t\t\treturn af < bf\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tif a != b {\r\n"]
[2264.749624, "o", "\t\t\t\t\tif key.Order == \"desc\" {\r\n\t\t\t\t\t\treturn a > b\r\n\t\t\t\t\t}\r\n\t\t\t\t\treturn a < b\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn false\r\n\t})\r\n"]
[2264.74968, "o", "\r\n\treturn in, nil\r\n}\r\n\r\ntype LimitStage struct {\r\n\tcount int\r\n}\r\n\r\nfunc (s *LimitStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\r\n\tif s.count < len(in) {\r\n\t"]
[2264.749747, "o", "\treturn in[:s.count], nil\r\n\t}\r\n\treturn in, nil\r\n}\r\n\r\nfunc buildFilter(idx int, sm map[string]interface{}) (Stage, error) {\r\n\twhereRaw, ok := sm[\"where\"]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: filter.where is required\", idx)\r\n\t}\r\n\twhere, ok := whereRaw.(map[string]interface{})\r\n\tif !ok {"]
[2264.749836, "o", "\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: filter.where must be a mapping\", idx)\r\n\t}\r\n\r\n"]
[2264.749897, "o", "\tcolumn, ok := getString(where, \"column\")\r\n\tif !ok || column == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: filter.where.column is required\", idx)\r\n\t}\r\n\r\n\top, ok := getString(where, \"op\")\r\n\tif !ok || op == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: filter.where.op is required\", idx)\r\n\t}\r\n\tswitch op {\r\n\tcase \"==\", \"!=\", \"<\", \"<=\", \">\", \">=\":\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: filter.where.op is invalid\", idx)\r\n\t}\r\n\r\n\tvalue, ok := getString(where, \"value\")\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: filter.where.value is required\", idx)\r\n"]
[2264.749978, "o", "\t}\r\n\r\n\treturn &FilterStage{column: column, op: op, value: value}, nil\r\n}\r\n\r\nfunc buildProject(idx int, sm map[string]interface{}) (Stage, error) {\r\n\tcolsRaw, ok := sm[\"columns\"]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: project.columns is required\", idx)\r\n\t}\r\n\tlist, ok := colsRaw.([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: project.columns must be a list\", idx)\r\n\t}\r\n"]
[2264.750038, "o", "\r\n\tcolumns := make([]ProjectColumn, 0, len(list))\r\n\tseen := map[string]bool{}\r\n\tfor j, item := range list {\r\n\t\tswitch v := item.(type) {\r\n\t\tcase string:\r\n\t\t\tif seen[v] {\r\n\t\t\t\treturn nil, fmt.Errorf(\"config: stage %d: project output column %q duplicated\", idx, v)\r\n\t\t\t}\r\n\t\t\tseen[v] = true\r\n\t\t\tcolumns = append(columns, ProjectColumn{Source: v, Target: v})\r\n\t\t"]
[2264.7501, "o", "case map[string]interface{}:\r\n\t\t\tname, ok := getString(v, \"name\")\r\n\t\t\tif !ok || name == \"\" {\r\n\t\t\t\treturn nil, fmt.Errorf(\"config: stage %d: project column %d name is required\", idx, j+1)\r\n\t\t\t}\r\n\t\t\tas, ok := getString(v, \"as\")\r\n\t\t\tif !ok || as == \"\" {\r\n\t\t\t\treturn nil, fmt.Errorf(\"config: stage %d: project column %d as is required\", idx, j+1)\r\n\t\t\t}\r\n"]
[2264.750177, "o", "\t\t\tif seen[as] {\r\n\t\t\t\treturn nil, fmt.Errorf(\"config: stage %d: project output column %q duplicated\", idx, as)\r\n\t\t\t}\r\n\t\t\tseen[as] = true\r\n\t\t\tcolumns = append(columns, ProjectColumn{Source: name, Target: as})\r\n\t\tdefault:\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: project column %d must be a string or mapping\", idx, j+1)\r\n\t\t}\r\n"]
[2264.750249, "o", "\t}\r\n\r\n\treturn &ProjectStage{columns: columns}, nil\r\n}\r\n\r\nfunc buildSort(idx int, sm map[string]interface{}) (Stage, error) {\r\n\tkeysRaw, ok := sm[\"keys\"]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: sort.keys is required\", idx)\r\n\t}\r\n\tlist, ok := keysRaw.([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: sort.keys must be a list\", idx)\r\n\t}\r\n"]
[2264.750315, "o", "\r\n\tkeys := make([]SortKey, 0, len(list))\r\n\tfor j, item := range list {\r\n\t\tkm, ok := item.(map[string]interface{})\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: sort key %d must be a mapping\", idx, j+1)\r\n\t\t}\r\n\r\n\t\tcolumn, ok := getString(km, \"column\")\r\n\t\tif !ok || column == \"\" {\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: sort key %d column is required\", idx, j+1)\r\n"]
[2264.750399, "o", "\t\t}\r\n\r\n\t\torder, ok := getString(km, \"order\")\r\n\t\tif !ok || order == \"\" {\r\n\t\t\torder = \"asc\"\r\n\t\t}\r\n\t\tif order != \"asc\" && order != \"desc\" {\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: sort key %d order must be asc or desc\", idx, j+1)\r\n\t\t}\r\n\r\n\t\tas, ok := getString(km, \"as\")\r\n\t\tif !ok || as == \"\" {\r\n\t\t\tas = \"string\"\r\n"]
[2264.750466, "o", "\t\t}\r\n\t\tif as != \"string\" && as != \"number\" {\r\n\t\t\treturn nil, fmt.Errorf(\"config: stage %d: sort key %d as must be string or number\", idx, j+1)\r\n\t\t}\r\n\r\n\t\tkeys = append(keys, SortKey{Column: column, Order: order, As: as})\r\n\t}\r\n\r\n\treturn &SortStage{keys: keys}, nil\r\n}\r\n"]
[2264.750534, "o", "\r\nfunc buildLimit(idx int, sm map[string]interface{}) (Stage, error) {\r\n\tcountRaw, ok := sm[\"count\"]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: limit.count is required\", idx)\r\n\t}\r\n\tcountStr, ok := countRaw.(string)\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: limit.count must be a non-negative integer\", idx)\r\n\t}\r\n"]
[2264.750606, "o", "\tn, err := strconv.Atoi(countStr)\r\n\tif err != nil || n < 0 {\r\n\t\treturn nil, fmt.Errorf(\"config: stage %d: limit.count must be a non-negative integer\", idx)\r\n\t}\r\n\r\n\treturn &LimitStage{count: n}, nil\r\n}\r\n\r\nfunc getString(m map[string]interface{}, key string) (string, bool) {\r\n\tv, ok := m[key]\r\n\tif !ok {\r\n\t\treturn \"\", false\r\n\t}\r\n\tif s, ok := v.(string); ok {\r\n\t\treturn s, true\r\n"]
[2264.750667, "o", "\t}\r\n\treturn fmt.Sprintf(\"%v\", v), true\r\n}\r\n\r\nfunc parseFloat(s string) (float64, error) {\r\n\tf, err := strconv.ParseFloat(s, 64)\r\n\tif err != nil {\r\n\t\treturn 0, err\r\n\t}\r\n\tif math.IsNaN(f) || math.IsInf(f, 0) {\r\n\t\t"]
[2264.750731, "o", "return 0, fmt.Errorf(\"not a finite number\")\r\n\t}\r\n\treturn f, nil\r\n"]
