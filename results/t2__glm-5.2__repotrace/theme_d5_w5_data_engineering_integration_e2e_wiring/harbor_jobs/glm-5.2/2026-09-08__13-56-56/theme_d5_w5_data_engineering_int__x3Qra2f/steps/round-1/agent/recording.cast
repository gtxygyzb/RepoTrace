[1718.103564, "o", "\u001b[?2004h> "]
[1718.103682, "o", "        for _, c := range s.columns {\r\n\u001b[?2004l\r"]
[1718.103735, "o", "\u001b[?2004h> "]
[1718.103827, "o", "            val := \"\"\r\n\u001b[?2004l\r"]
[1718.103882, "o", "\u001b[?2004h> "]
[1718.104064, "o", "            if v, ok := r.Get(c.Source); ok {\r\n\u001b[?2004l\r"]
