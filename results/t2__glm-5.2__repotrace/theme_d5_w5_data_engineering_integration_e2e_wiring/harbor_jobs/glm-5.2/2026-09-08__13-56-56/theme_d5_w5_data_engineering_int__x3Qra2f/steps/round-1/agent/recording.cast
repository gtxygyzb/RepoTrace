[1718.077232, "i", "nt, sm map[string]interface{}) (Stage, error) {\n    keysRaw, ok := sm[\"keys\"]\n    if !ok {\n        return nil, fmt.Errorf(\"config: stage %d: sort.keys is required\", idx)\n    }\n    list, ok := keysRaw.([]interface{})\n    if !ok {\n        return nil, fmt.Errorf(\"config: stage %d: sort.keys must be a list\", idx)\n    }\n\n    keys := make([]SortKey, 0, len(list))\n    for j, item := range list {\n        km, ok := item.(map[string]interface{})\n        if !ok {\n            return nil, fmt.Errorf(\"config: stage %d: sort key %d must be a mapping\", idx, j+1)\n        }\n\n        column, ok := getString(km, \"column\")\n        if !ok || column == \"\" {\n            return nil, fmt.Errorf(\"config: stage %d: sort key %d column is required\", idx, j+1)\n        }\n\n        order, ok := getString(km, \"order\")\n        if !ok || order == \"\" {\n            order = \"asc\"\n        }\n        if order != \"asc\" && order != \"desc\" {\n            return nil, fmt.Errorf(\"config: stage %d: sort key %d order must be asc or desc\", idx, j+1)\n        }\n"]
[1718.077282, "o", "    \"fmt\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1718.077353, "i", "\n        as, ok := getString(km, \"as\")\n        if !ok || as == \"\" {\n            as = \"string\"\n        }\n        if as != \"string\" && as != \"number\" {\n            return nil, fmt.Errorf(\"config: stage %d: sort key %d as must be string or number\", idx, j+1)\n        }\n\n        keys = append(keys, SortKey{Column: column, Order: order, As: as})\n    }\n\n    return &SortStage{keys: keys}, nil\n}\n\nfunc buildLimit(idx int, sm map[string]interface{}) (Stage, error) {\n    countRaw, ok := sm[\"count\"]\n    if !ok {\n        return nil, fmt.Errorf(\"config: stage %d: limit.count is required\", idx)\n    }\n    countStr, ok := countRaw.(string)\n    if !ok {\n        return nil, fmt.Errorf(\"config: stage %d: limit.count must be a non-negative integer\", idx)\n    }\n    n, err := strconv.Atoi(countStr)\n    if err != nil || n < 0 {\n        return nil, fmt.Errorf(\"config: stage %d: limit.count must be a non-negative integer\", idx)\n    }\n\n    return &LimitStage{count: n}, nil\n}\n\nfunc getString(m map[string]interface{}, key string) (string,"]
[1718.077373, "o", "    \"io\"\r\n\u001b[?2004l\r"]
[1718.077456, "i", " bool) {\n    v, ok := m[key]\n    if !ok {\n        return \"\", false\n    }\n    if s, ok := v.(string); ok {\n        return s, true\n    }\n    return fmt.Sprintf(\"%v\", v), true\n}\n\nfunc parseFloat(s string) (float64, error) {\n    f, err := strconv.ParseFloat(s, 64)\n    if err != nil {\n        return 0, err\n    }\n    if math.IsNaN(f) || math.IsInf(f, 0) {\n        return 0, fmt.Errorf(\"not a finite number\")\n    }\n    return f, nil\n}\n\nfunc compareFloats(left float64, op string, right float64) bool {\n    switch op {\n    case \"<\":\n        return left < right\n    case \"<=\":\n        return left <= right\n    case \">\":\n        return left > right\n    case \">=\":\n        return left >= right\n    }\n    return false\n}\nEOF\n"]
