func ResolvePath(dir, path string) string {
	if path == "-" {
		return "-"
	}
	if filepath.IsAbs(path) {
		return path
	}
	return filepath.Join(dir, path)
}

func getString(m map[string]interface{}, key string) (string, bool) {
	v, ok := m[key]
	if !ok {
		return "", false
	}
	if s, ok := v.(string); ok {
		return s, true
	}
	return "", true
}

func toStringList(v interface{}) ([]string, error) {
	list, ok := v.([]interface{})
	if !ok {
		return nil, fmt.Errorf("must be a list of strings")
	}
	out := []string{}
	for i, item := range list {
		s, ok := item.(string)
		if !ok {
			return nil, fmt.Errorf("entry %d must be a string", i+1)
		}
		out = append(out, s)
	}
	return out, nil
}

type yamlLine struct {
	indent int
	text   string
}

func parseYAML(data []byte) (interface{}, error) {
	lines := []yamlLine{}
	scanner := bufio.NewScanner(bytes.NewReader(data))
	for scanner.Scan() {
		raw := scanner.Text()
		line := stripComment(raw)
		if strings.TrimSpace(line) == "" {
			continue
		}
		indent := 0
		for indent < len(line) && line[indent] == ' ' {
			indent++
		}
		if indent < len(line) && line[indent] == '\t' {
			return nil, fmt.Errorf("tabs are not allowed for indentation")
		}
		text := strings.TrimRight(line[indent:], " \t")
		lines = append(lines, yamlLine{indent: indent, text: text})
	}
	if err := scanner.Err(); err != nil {
		return nil, err
	}
	if len(lines) == 0 {
		return nil, nil
	}
	val, _, err := parseNode(lines, 0, lines[0].indent)
	return val, err
}

func parseNode(lines []yamlLine, start, indent int) (interface{}, int, error) {
	if start >= len(lines) || lines[start].indent < indent {
		return nil, start, nil
	}
	if isSequenceLine(lines[start].text) {
		return parseSequence(lines, start, indent)
	}
	return parseMapping(lines, start, indent)
}

func isSequenceLine(text string) bool {
	return text == "-" || strings.HasPrefix(text, "- ")
}

[?2004hroot@n30009:/app# sed -n '230,360p' internal/config/config.go
[?2004l
func parseMapping(lines []yamlLine, start, indent int) (map[string]interface{}, int, error) {
	m := map[string]interface{}{}
	i := start
	for i < len(lines) {
		if lines[i].indent < indent {
			break
		}
		if lines[i].indent > indent {
			return nil, i, fmt.Errorf("unexpected indentation in mapping")
		}
		if isSequenceLine(lines[i].text) {
			break
		}

		key, val, err := splitKeyValue(lines[i].text)
		if err != nil {
			return nil, i, err
		}

		if val == "" {
			if i+1 < len(lines) {
				next := lines[i+1]
				if next.indent > indent {
					child, next2, err := parseNode(lines, i+1, next.indent)
					if err != nil {
						return nil, 0, err
					}
					m[key] = child
					i = next2
					continue
				}
				if next.indent == indent && isSequenceLine(next.text) {
					child, next2, err := parseSequence(lines, i+1, indent)
					if err != nil {
						return nil, 0, err
					}
					m[key] = child
					i = next2
					continue
				}
			}
			m[key] = nil
			i++
			continue
		}

		v, err := parseFlowOrScalar(val)
		if err != nil {
			return nil, 0, err
		}
		m[key] = v
		i++
	}
	return m, i, nil
}

func parseSequence(lines []yamlLine, start, indent int) ([]interface{}, int, error) {
	items := []interface{}{}
	i := start
	for i < len(lines) {
		if lines[i].indent < indent {
			break
		}
		if lines[i].indent > indent {
			return nil, i, fmt.Errorf("unexpected indentation in sequence")
		}
		if !isSequenceLine(lines[i].text) {
			break
		}

		content := strings.TrimSpace(strings.TrimPrefix(lines[i].text, "-"))
		if content == "" {
			if i+1 < len(lines) && lines[i+1].indent > indent {
				child, next, err := parseNode(lines, i+1, lines[i+1].indent)
				if err != nil {
					return nil, 0, err
				}
				items = append(items, child)
				i = next
				continue
			}
			items = append(items, nil)
			i++
			continue
		}

		if strings.HasPrefix(content, "[") || strings.HasPrefix(content, "{") {
			v, err := parseFlow(content)
			if err != nil {
				return nil, 0, err
			}
			items = append(items, v)
			i++
			continue
		}

		if isMappingLine(content) {
			afterDash := strings.TrimPrefix(lines[i].text, "-")
			leading := len(afterDash) - len(strings.TrimLeft(afterDash, " "))
			effIndent := indent + 1 + leading
			sublines := []yamlLine{{indent: effIndent, text: content}}
			j := i + 1
			for j < len(lines) && lines[j].indent >= effIndent {
				sublines = append(sublines, lines[j])
				j++
			}
			child, _, err := parseMapping(sublines, 0, effIndent)
			if err != nil {
				return nil, 0, err
			}
			items = append(items, child)
			i = j
			continue
		}

		v, err := parseFlowOrScalar(content)
		if err != nil {
			return nil, 0, err
		}
		items = append(items, v)
		i++
	}
	return items, i, nil
}

func isMappingLine(text string) bool {
	_, _, err := splitKeyValue(text)
	return err == nil
}

