    11	
    12	func main() {
    13		if len(os.Args) < 2 {
    14			fmt.Fprintf(os.Stderr, "flowctl: usage: flowctl run --config <path> [--strict]\n")
    15			os.Exit(2)
    16		}
    17	
    18		if os.Args[1] != "run" {
    19			fmt.Fprintf(os.Stderr, "flowctl: unknown command %q\n", os.Args[1])
    20			os.Exit(2)
    21		}
    22	
    23		args := os.Args[2:]
    24		configPath := ""
    25		strict := false
    26	
    27		for i := 0; i < len(args); i++ {
    28			arg := args[i]
    29			switch {
    30			case arg == "--config":
    31				if i+1 >= len(args) {
    32					fmt.Fprintf(os.Stderr, "flowctl: --config requires a value\n")
    33					os.Exit(2)
    34				}
    35				configPath = args[i+1]
    36				i++
    37			case strings.HasPrefix(arg, "--config="):
    38				configPath = strings.TrimPrefix(arg, "--config=")
    39			case arg == "--strict":
    40				strict = true
    41			default:
    42				fmt.Fprintf(os.Stderr, "flowctl: unknown flag %q\n", arg)
    43				os.Exit(2)
    44			}
    45		}
    46	
    47		if configPath == "" {
    48			fmt.Fprintf(os.Stderr, "flowctl: --config is required\n")
    49			os.Exit(2)
    50		}
    51	
    52		cfg, err := config.Load(configPath)
    53		if err != nil {
    54			fmt.Fprintf(os.Stderr, "flowctl: %v\n", err)
    55			os.Exit(1)
    56		}
    57		cfg.Strict = strict
    58	
    59		stats, err := pipeline.Run(cfg)
    60		if err != nil {
    61			fmt.Fprintf(os.Stderr, "flowctl: %v\n", err)
    62			os.Exit(1)
    63		}
    64	
    65		fmt.Fprintf(os.Stderr, "flowctl: processed=%d emitted=%d dropped_nonnumeric=%d dropped_missing=%d\n",
    66			stats.Processed, stats.Emitted, stats.DroppedNonNumeric, stats.DroppedMissing)
    67	}
