   145	
   146	func ResolvePath(dir, path string) string {
   147		if path == "-" {
   148			return "-"
   149		}
   150		if filepath.IsAbs(path) {
   151			return path
   152		}
   153		return filepath.Join(dir, path)
   154	}
   155	
   156	func getString(m map[string]interface{}, key string) (string, bool) {
   157		v, ok := m[key]
   158		if !ok {
   159			return "", false
   160		}
   161		if s, ok := v.(string); ok {
   162			return s, true
   163		}
   164		return "", true
   165	}
   166	
   167	func toStringList(v interface{}) ([]string, error) {
   168		list, ok := v.([]interface{})
   169		if !ok {
   170			return nil, fmt.Errorf("must be a list of strings")
   171		}
   172		out := []string{}
   173		for i, item := range list {
   174			s, ok := item.(string)
   175			if !ok {
   176				return nil, fmt.Errorf("entry %d must be a string", i+1)
   177			}
   178			out = append(out, s)
   179		}
   180		return out, nil
   181	}
   182	
   183	type yamlLine struct {
   184		indent int
   185		text   string
   186	}
   187	
   188	func parseYAML(data []byte) (interface{}, error) {
   189		lines := []yamlLine{}
   190		scanner := bufio.NewScanner(bytes.NewReader(data))
   191		for scanner.Scan() {
   192			raw := scanner.Text()
   193			line := stripComment(raw)
   194			if strings.TrimSpace(line) == "" {
   195				continue
   196			}
   197			indent := 0
