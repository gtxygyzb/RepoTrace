   153	
   154	\t\tskip := false
   155	\t\tfor _, col := range s.on {
   156	\t\t\tif vals[col] == "" {
   157	\t\t\t\tskip = true
   158	\t\t\t\tbreak
   159	\t\t\t}
   160	\t\t}
   161	\t\tif skip {
   162	\t\t\tcontinue
   163	\t\t}
   164	
   165	\t\tkey := joinKey(s.on, vals)
   166	\t\tindex[key] = append(index[key], vals)
   167	\t}
   168	
   169	\tout := make([]*record.Record, 0, len(in))
   170	\tfor _, r := range in {
   171	\t\tfor _, col := range s.on {
   172	\t\t\tif !r.Has(col) {
   173	\t\t\t\treturn nil, fmt.Errorf("join: missing on column %s in left record", col)
   174	\t\t\t}
   175	\t\t}
   176	
   177	\t\tleftVals := map[string]string{}
   178	\t\tempty := false
   179	\t\tfor _, col := range s.on {
   180	\t\t\tv, _ := r.Get(col)
   181	\t\t\tleftVals[col] = v
   182	\t\t\tif v == "" {
   183	\t\t\t\tempty = true
   184	\t\t\t}
   185	\t\t}
   186	
   187	\t\tvar matches []map[string]string
   188	\t\tif !empty {
   189	\t\t\tmatches = index[joinKey(s.on, leftVals)]
   190	\t\t}
   191	
   192	\t\tif len(matches) == 0 {
   193	\t\t\tif s.kind == "left" {
   194	\t\t\t\tnr := r.Copy()
   195	\t\t\t\ts.addRightColumns(nr, nil, schema)
   196	\t\t\t\tout = append(out, nr)
   197	\t\t\t}
   198	\t\t\tcontinue
   199	\t\t}
   200	
   201	\t\tfor _, m := range matches {
   202	\t\t\tnr := r.Copy()
   203	\t\t\ts.addRightColumns(nr, m, schema)
   204	\t\t\tout = append(out, nr)
   205	\t\t}
   206	\t}
   207	
   208	\treturn out, nil
   209	}
   210	
   211	func (s *JoinStage) resolveRightSchema(rightRecords []*record.Record) ([]string, error) {
   212	\tif s.selectPresent {
   213	\t\treturn s.selectCols, nil
   214	\t}
   215	\tif len(rightRecords) == 0 {
   216	\t\treturn []string{}, nil
   217	\t}
   218	\treturn rightRecords[0].Order, nil
   219	}
   220	
   221	func (s *JoinStage) projectRight(rr *record.Record, schema []string) (map[string]string, error) {
   222	\tvals := make(map[string]string, len(schema))
   223	\tfor _, col := range schema {
   224	\t\tv, ok := rr.Get(col)
   225	\t\tif !ok {
   226	\t\t\tif s.isOn(col) {
   227	\t\t\t\treturn nil, fmt.Errorf("join: missing on column %s in right record", col)
   228	\t\t\t}
   229	\t\t\tv = ""
   230	\t\t}
   231	\t\tvals[col] = v
   232	\t}
   233	\treturn vals, nil
   234	}
   235	
   236	func (s *JoinStage) addRightColumns(nr *record.Record, vals map[string]string, schema []string) {
   237	\tfor _, col := range schema {
   238	\t\tif s.isOn(col) {
   239	\t\t\tcontinue
   240	\t\t}
   241	\t\tv := ""
   242	\t\tif vals != nil {
   243	\t\t\tv = vals[col]
   244	\t\t}
   245	\t\tnr.Set(s.prefix+col, v)
   246	\t}
   247	}
   248	
   249	func (s *JoinStage) isOn(col string) bool {
   250	\tfor _, c := range s.on {
   251	\t\tif c == col {
   252	\t\t\treturn true
   253	\t\t}
   254	\t}
   255	\treturn false
   256	}
   257	
   258	func joinKey(vals map[string]string) string {
   259	\tparts := make([]string, 0, len(vals))
   260	\t// The caller controls the on-column order via s.on.
   261	\tfor _, k := range orderedKeys(vals) {
   262	\t\tparts = append(parts, k, vals[k])
   263	\t}
   264	\treturn strings.Join(parts, "\x00")
   265	}
