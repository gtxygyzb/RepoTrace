    10	        "example.com/flowctl/internal/record"
    11	)
    12	
    13	type BucketStage struct {
    14	        column        string
    15	        into         string
    16	        edges        []float64
    17	        labels       []string
    18	        underLabel   string
    19	        overLabel    string
    20	        inclusive    string
    21	        onMissing    string
    22	        onNonNumeric string
    23	}
    24	
    25	func buildBucket(idx int, sm map[string]interface{}) (Stage, error) {
    26	        column, ok := getString(sm, "column")
    27	        if !ok || column == "" {
    28	                return nil, fmt.Errorf("config: stage %d: bucket: column must be a non-empty string", idx)
    29	        }
    30	        into, ok := getString(sm, "into")
    31	        if !ok || into == "" {
    32	                return nil, fmt.Errorf("config: stage %d: bucket: into must be a non-empty string", idx)
    33	        }
    34	        if into == column {
    35	                return nil, fmt.Errorf("config: stage %d: bucket: into must differ from column", idx)
    36	        }
    37	
    38	        inclusive, ok := getString(sm, "inclusive")
    39	        if !ok || inclusive == "" {
    40	                inclusive = "right"
    41	        }
    42	        if inclusive != "left" && inclusive != "right" {
    43	                return nil, fmt.Errorf("config: stage %d: bucket: inclusive must be left or right", idx)
    44	        }
    45	
    46	        onMissing, ok := getString(sm, "on_missing")
    47	        if !ok || onMissing == "" {
    48	                onMissing = "keep_empty"
    49	        }
    50	        if onMissing != "keep_empty" && onMissing != "drop" && onMissing != "error" {
    51	                return nil, fmt.Errorf("config: stage %d: bucket: on_missing must be keep_empty, drop, or error", idx)
    52	        }
    53	
    54	        onNonNumeric, ok := getString(sm, "on_non_numeric")
    55	        if !ok || onNonNumeric == "" {
    56	                onNonNumeric = "error"
    57	        }
    58	        if onNonNumeric != "error" && onNonNumeric != "drop" && onNonNumeric != "keep_empty" {
    59	                return nil, fmt.Errorf("config: stage %d: bucket: on_non_numeric must be error, drop, or keep_empty", idx)
    60	        }
    61	
    62	        _, hasEdges := sm["edges"]
    63	        _, hasWidth := sm["width"]
    64	        if hasEdges == hasWidth {
    65	                return nil, fmt.Errorf("config: stage %d: bucket: exactly one of edges or width is required", idx)
    66	        }
    67	
    68	        var (
    69	                edges       []float64
    70	                labelCount  int
    71	                autoLabels  []string
    72	                underAuto   string
    73	                overAuto    string
    74	        )
    75	
    76	        if hasWidth {
    77	                widthRaw, ok := sm["width"]
    78	                if !ok {
    79	                        return nil, fmt.Errorf("config: stage %d: bucket: exactly one of edges or width is required", idx)
    80	                }
    81	                wm, ok := widthRaw.(map[string]interface{})
    82	                if !ok {
    83	                        return nil, fmt.Errorf("config: stage %d: bucket: width must be a mapping", idx)
    84	                }
    85	                for k := range wm {
    86	                        if k != "step" && k != "start" && k != "count" {
    87	                                return nil, fmt.Errorf("config: stage %d: bucket: unknown key %s in width", idx, k)
    88	                        }
    89	                }
    90	
    91	                stepStr, ok := getString(wm, "step")
    92	                if !ok || stepStr == "" {
    93	                        return nil, fmt.Errorf("config: stage %d: bucket: width.step must be a positive finite number", idx)
    94	                }
    95	                step, err := parseFloat(stepStr)
    96	                if err != nil || math.IsNaN(step) || math.IsInf(step, 0) || step <= 0 {
    97	                        return nil, fmt.Errorf("config: stage %d: bucket: width.step must be a positive finite number", idx)
    98	                }
    99	
   100	                start := 0.0
   101	                if startStr, ok := getString(wm, "start"); ok && startStr != "" {
   102	                        var err error
   103	                        start, err = parseFloat(startStr)
   104	                        if err != nil || math.IsNaN(start) || math.IsInf(start, 0) {
   105	                                return nil, fmt.Errorf("config: stage %d: bucket: width.start must be a finite number", idx)
   106	                        }
   107	                }
   108	
   109	                countStr, ok := getString(wm, "count")
   110	                if !ok || countStr == "" {
   111	                        return nil, fmt.Errorf("config: stage %d: bucket: width.count must be a positive integer", idx)
   112	                }
   113	                countI, err := strconv.Atoi(countStr)
   114	                if err != nil || countI < 1 {
   115	                        return nil, fmt.Errorf("config: stage %d: bucket: width.count must be a positive integer", idx)
   116	                }
   117	
   118	                edges = make([]float64, 0, countI+1)
   119	                for i := 0; i <= countI; i++ {
   120	                        edges = append(edges, start+step*float64(i))
   121	                }
   122	                labelCount = countI
   123	        } else {
   124	                edgesRaw, ok := sm["edges"]
   125	                if !ok {
   126	                        return nil, fmt.Errorf("config: stage %d: bucket: edges must have at least two entries", idx)
   127	                }
   128	                list, ok := edgesRaw.([]interface{})
   129	                if !ok {
   130	                        return nil, fmt.Errorf("config: stage %d: bucket: edges must have at least two entries", idx)
   131	                }
   132	                if len(list) < 2 {
   133	                        return nil, fmt.Errorf("config: stage %d: bucket: edges must have at least two entries", idx)
   134	                }
   135	                edges = make([]float64, 0, len(list))
   136	                for i, item := range list {
   137	                        es, ok := item.(string)
   138	                        if !ok {
   139	                                es = fmt.Sprintf("%v", item)
   140	                        }
   141	                        f, err := parseFloat(es)
   142	                        if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {
   143	                                return nil, fmt.Errorf("config: stage %d: bucket: edges[%d] is not a finite number", idx, i)
   144	                        }
   145	                        if i > 0 && f <= edges[i-1] {
   146	                                return nil, fmt.Errorf("config: stage %d: bucket: edges must be strictly increasing", idx)
   147	                        }
   148	                        edges = append(edges, f)
   149	                }
   150	                labelCount = len(edges) - 1
   151	        }
   152	
   153	        for i := 1; i < len(edges); i++ {
   154	                if edges[i] <= edges[i-1] {
   155	                        return nil, fmt.Errorf("config: stage %d: bucket: edges must be strictly increasing", idx)
   156	        }
   157	        }
   158	
   159	        autoLabels = make([]string, labelCount)
   160	        for i := 0; i < labelCount; i++ {
   161	                a := formatFloat(edges[i])
   162	                b := formatFloat(edges[i+1])
   163	                if inclusive == "left" {
   164	                        autoLabels[i] = "[" + a + ", " + b + ")"
   165	                } else {
   166	                        autoLabels[i] = "(" + a + ", " + b + "]"
   167	                }
   168	        }
   169	        first := formatFloat(edges[0])
   170	        last := formatFloat(edges[len(edges)-1])
   171	        if inclusive == "left" {
   172	                underAuto = "(-inf, " + first + ")"
   173	                overAuto = "[" + last + ", +inf)"
   174	        } else {
   175	                underAuto = "(-inf, " + first + "]"
   176	                overAuto = "(" + last + ", +inf)"
   177	        }
   178	
   179	        labels := autoLabels
   180	        if labelsRaw, ok := sm["labels"]; ok {
   181	                list, ok := labelsRaw.([]interface{})
   182	                if !ok {
   183	                        return nil, fmt.Errorf("config: stage %d: bucket: labels length 0 does not match edges-1 %d", idx, labelCount)
   184	                }
   185	                if len(list) != labelCount {
   186	                        return nil, fmt.Errorf("config: stage %d: bucket: labels length %d does not match edges-1 %d", idx, len(list), labelCount)
   187	                }
   188	                labels = make([]string, labelCount)
   189	                seen := map[string]bool{}
   190	                for i, item := range list {
   191	                        ls, ok := item.(string)
   192	                        if !ok {
   193	                                ls = fmt.Sprintf("%v", item)
   194	                        }
   195	                        if ls == "" {
   196	                                return nil, fmt.Errorf("config: stage %d: bucket: labels[%d] must be a non-empty string", idx, i)
   197	                        }
   198	                        if seen[ls] {
   199	                                return nil, fmt.Errorf("config: stage %d: bucket: labels has duplicate entry %s", idx, ls)
   200	                        }
   201	                        seen[ls] = true
   202	                        labels[i] = ls
   203	                }
   204	        }
   205	
   206	        underLabel := underAuto
   207	        if s, ok := getString(sm, "under_label"); ok {
   208	                if s == "" {
   209	                        return nil, fmt.Errorf("config: stage %d: bucket: under_label must be a non-empty string", idx)
   210	                }
   211	                for _, label := range labels {
   212	                        if s == label {
   213	                                return nil, fmt.Errorf("config: stage %d: bucket: under_label collides with labels entry %s", idx, s)
   214	                        }
   215	                }
   216	                underLabel = s
   217	        }
   218	        overLabel := overAuto
   219	        if s, ok := getString(sm, "over_label"); ok {
   220	                if s == "" {
   221	                        return nil, fmt.Errorf("config: stage %d: bucket: over_label must be a non-empty string", idx)
   222	                }
   223	                for _, label := range labels {
   224	                        if s == label {
   225	                                return nil, fmt.Errorf("config: stage %d: bucket: over_label collides with labels entry %s", idx, s)
   226	                        }
   227	                }
   228	                overLabel = s
   229	        }
   230	
   231	        return &BucketStage{
   232	                column:        column,
   233	                into:          into,
   234	                edges:        edges,
   235	                labels:       labels,
   236	                underLabel:   underLabel,
   237	                overLabel:    overLabel,
   238	                inclusive:    inclusive,
   239	                onMissing:    onMissing,
   240	                onNonNumeric: onNonNumeric,
   241	        }, nil
   242	}
   243	
   244	func (s *BucketStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   245	        out := make([]*record.Record, 0, len(in))
   246	        for _, r := range in {
   247	                v, ok := r.Get(s.column)
   248	                missing := !ok || v == ""
   249	                if missing {
   250	                        switch s.onMissing {
   251	                        case "drop":
   252	                                stats.DroppedMissing++
   253	                                fmt.Fprintf(stderr, "flowctl: bucket: drop missing-column row %d\n", r.InputRow)
   254	                                if strict {
   255	                                        return nil, fmt.Errorf("strict: missing column %s", s.column)
   256	                                }
   257	                                continue
   258	                        case "error":
   259	                                return nil, fmt.Errorf("flowctl: bucket: missing column %s at row %d", s.column, r.InputRow)
   260	                        case "keep_empty":
   261	                                nr := r.Copy()
   262	                                if nr.Has(s.into) {
   263	                                        return nil, fmt.Errorf("flowctl: bucket: into column %s already present at row %d", s.into, r.InputRow)
   264	                                }
   265	                                nr.Set(s.into, "")
   266	                                out = append(out, nr)
   267	                                continue
   268	                        }
   269	                }
   270	
   271	                f, err := parseFloat(v)
   272	                if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {
   273	                        switch s.onNonNumeric {
   274	                        case "drop":
   275	                                stats.DroppedNonNumeric++
   276	                                fmt.Fprintf(stderr, "flowctl: bucket: drop non-numeric row %d\n", r.InputRow)
   277	                                if strict {
   278	                                        return nil, fmt.Errorf("strict: non-numeric row %d", r.InputRow)
   279	                                }
   280	                                continue
   281	                        case "error":
   282	                                return nil, fmt.Errorf("flowctl: bucket: non-numeric value in column %s at row %d", s.column, r.InputRow)
   283	                        case "keep_empty":
   284	                                nr := r.Copy()
   285	                                if nr.Has(s.into) {
   286	                                        return nil, fmt.Errorf("flowctl: bucket: into column %s already present at row %d", s.into, r.InputRow)
   287	                                }
   288	                                nr.Set(s.into, "")
   289	                                out = append(out, nr)
   290	                                continue
   291	                        }
   292	                }
   293	
   294	                label := s.bucketLabel(f)
   295	                nr := r.Copy()
   296	                if nr.Has(s.into) {
   297	                        return nil, fmt.Errorf("flowctl: bucket: into column %s already present at row %d", s.into, r.InputRow)
   298	                }
   299	                nr.Set(s.into, label)
   300	                out = append(out, nr)
   301	        }
   302	        return out, nil
   303	}
   304	
   305	func (s *BucketStage) bucketLabel(v float64) string {
   306	        first := s.edges[0]
   307	        last := s.edges[len(s.edges)-1]
   308	        if s.inclusive == "right" {
   309	                if v <= first {
   310	                        return s.underLabel
   311	                }
   312	                if v > last {
   313	                        return s.overLabel
   314	                }
   315	                for i := 0; i < len(s.edges)-1; i++ {
   316	                        if v > s.edges[i] && v <= s.edges[i+1] {
   317	                                return s.labels[i]
   318	                        }
   319	                }
   320	        } else {
   321	                if v < first {
   322	                        return s.underLabel
   323	                }
   324	                if v >= last {
   325	                        return s.overLabel
   326	                }
   327	                for i := 0; i < len(s.edges)-1; i++ {
   328	                        if v >= s.edges[i] && v < s.edges[i+1] {
   329	                                return s.labels[i]
   330	                        }
   331	                }
   332	        }
   333	        return s.overLabel
   334	}
   335	
   336	func formatBucketFloat(f float64) string {
   337	        if f == math.Trunc(f) && !math.IsInf(f, 0) && math.Abs(f) < 1e15 {
   338	                return strconv.FormatInt(int64(f), 10)
   339	        }
   340	        return strconv.FormatFloat(f, 'g', -1, 64)
   341	}
   342	
   343	func init() {
   344	        _ = strings.TrimSpace
   345	}
