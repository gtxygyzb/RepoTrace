   288	func buildSort(idx int, sm map[string]interface{}) (Stage, error) {
   289		keysRaw, ok := sm["keys"]
   290		if !ok {
   291			return nil, fmt.Errorf("config: stage %d: sort.keys is required", idx)
   292		}
   293		list, ok := keysRaw.([]interface{})
   294		if !ok {
   295			return nil, fmt.Errorf("config: stage %d: sort.keys must be a list", idx)
   296		}
   297	
   298		keys := make([]SortKey, 0, len(list))
   299		for j, item := range list {
   300			km, ok := item.(map[string]interface{})
   301			if !ok {
   302				return nil, fmt.Errorf("config: stage %d: sort key %d must be a mapping", idx, j+1)
   303			}
   304	
   305			column, ok := getString(km, "column")
   306			if !ok || column == "" {
   307				return nil, fmt.Errorf("config: stage %d: sort key %d column is required", idx, j+1)
   308			}
   309	
   310			order, ok := getString(km, "order")
   311			if !ok || order == "" {
   312				order = "asc"
   313			}
   314			if order != "asc" && order != "desc" {
   315				return nil, fmt.Errorf("config: stage %d: sort key %d order must be asc or desc", idx, j+1)
   316			}
   317	
   318			as, ok := getString(km, "as")
   319			if !ok || as == "" {
   320				as = "string"
   321			}
   322			if as != "string" && as != "number" {
   323				return nil, fmt.Errorf("config: stage %d: sort key %d as must be string or number", idx, j+1)
   324			}
   325	
   326			keys = append(keys, SortKey{Column: column, Order: order, As: as})
   327		}
   328	
   329		return &SortStage{keys: keys}, nil
   330	}
