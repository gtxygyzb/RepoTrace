   380					if text[i+1] == ' ' || text[i+1] == '\t' {
   381						return parseScalar(strings.TrimSpace(text[:i])), strings.TrimSpace(text[i+1:]), nil
   382					}
   383				}
   384			}
   385		}
   386		return "", "", fmt.Errorf("expected mapping key: %q", text)
   387	}
   388	
   389	func parseFlowOrScalar(s string) (interface{}, error) {
   390		s = strings.TrimSpace(s)
   391		if strings.HasPrefix(s, "[") || strings.HasPrefix(s, "{") {
   392			return parseFlow(s)
   393		}
   394		return parseScalar(s), nil
   395	}
   396	
   397	func parseScalar(s string) string {
   398		s = strings.TrimSpace(s)
   399		if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
   400			if q, err := strconv.Unquote(s); err == nil {
   401				return q
   402			}
   403			return s[1 : len(s)-1]
   404		}
   405		if len(s) >= 2 && s[0] == '\'' && s[len(s)-1] == '\'' {
   406			return strings.ReplaceAll(s[1:len(s)-1], "''", "'")
   407		}
   408		return s
   409	}
   410	
   411	func stripComment(line string) string {
   412		inSingle := false
   413		inDouble := false
   414		for i := 0; i < len(line); i++ {
   415			c := line[i]
   416			switch c {
   417			case '\'':
   418				if !inDouble {
   419					inSingle = !inSingle
   420				}
   421			case '"':
   422				if !inSingle {
   423					inDouble = !inDouble
   424				}
   425			case '#':
   426				if !inSingle && !inDouble && (i == 0 || line[i-1] == ' ' || line[i-1] == '\t') {
   427					return line[:i]
   428				}
   429			}
   430		}
   431		return line
   432	}
   433	
   434	func parseFlow(s string) (interface{}, error) {
   435		s = strings.TrimSpace(s)
   436		if strings.HasPrefix(s, "[") {
   437			if !strings.HasSuffix(s, "]") {
   438				return nil, fmt.Errorf("unterminated flow sequence")
   439			}
   440			inner := s[1 : len(s)-1]
   441			if strings.TrimSpace(inner) == "" {
   442				return []interface{}{}, nil
   443			}
   444			parts := splitFlow(inner)
   445			list := []interface{}{}
   446			for _, p := range parts {
   447				v, err := parseFlowOrScalar(strings.TrimSpace(p))
   448				if err != nil {
   449					return nil, err
   450				}
   451				list = append(list, v)
   452			}
   453			return list, nil
   454		}
   455		if strings.HasPrefix(s, "{") {
   456			if !strings.HasSuffix(s, "}") {
   457				return nil, fmt.Errorf("unterminated flow mapping")
   458			}
   459			inner := s[1 : len(s)-1]
   460			if strings.TrimSpace(inner) == "" {
   461				return map[string]interface{}{}, nil
   462			}
   463			parts := splitFlow(inner)
   464			m := map[string]interface{}{}
   465			for _, p := range parts {
   466				key, val, err := splitKeyValue(strings.TrimSpace(p))
   467				if err != nil {
   468					return nil, err
   469				}
   470				v, err := parseFlowOrScalar(strings.TrimSpace(val))
   471				if err != nil {
   472					return nil, err
   473				}
   474				m[key] = v
   475			}
   476			return m, nil
   477		}
   478		return parseScalar(s), nil
   479	}
