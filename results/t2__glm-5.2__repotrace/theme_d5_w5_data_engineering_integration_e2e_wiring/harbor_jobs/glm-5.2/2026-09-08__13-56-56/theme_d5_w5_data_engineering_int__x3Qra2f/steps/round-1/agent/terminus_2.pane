    73			v, ok := r.Get(s.column)
    74			if !ok {
    75				stats.DroppedMissing++
    76				if !stats.missingReported {
    77					fmt.Fprintf(stderr, "flowctl: filter: missing column %s\n", s.column)
    78					stats.missingReported = true
    79				}
    80				if strict {
    81					return nil, fmt.Errorf("filter: missing column %s", s.column)
    82				}
    83				continue
    84			}
    85	
    86			keep := false
    87			switch s.op {
    88			case "==":
    89				keep = v == s.value
    90			case "!=":
    91				keep = v != s.value
    92			default:
    93				left, err := parseFloat(v)
    94				if err != nil {
    95					stats.DroppedNonNumeric++
    96					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
    97					if strict {
    98						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
    99					}
   100					continue
   101				}
   102				right, err := parseFloat(s.value)
   103				if err != nil {
   104					stats.DroppedNonNumeric++
   105					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
   106					if strict {
   107						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   108					}
   109					continue
   110				}
   111				keep = compareFloats(left, s.op, right)
   112			}
   113	
   114			if keep {
   115				out = append(out, r)
   116			}
   117		}
   118	
   119		return out, nil
   120	}
   121	
   122	type ProjectColumn struct {
   123		Source string
   124		Target string
   125	}
   126	
   127	type ProjectStage struct {
   128		columns []ProjectColumn
   129	}
   130	
   131	func (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   132		out := make([]*record.Record, 0, len(in))
   133		for _, r := range in {
   134			nr := record.New()
   135			nr.InputRow = r.InputRow
   136			for _, c := range s.columns {
   137				val := ""
   138				if v, ok := r.Get(c.Source); ok {
   139					val = v
   140				}
   141				nr.Set(c.Target, val)
   142			}
   143			out = append(out, nr)
   144		}
   145		return out, nil
   146	}
   147	
   148	type SortKey struct {
   149		Column string
   150		Order  string
   151		As     string
   152	}
   153	
   154	type SortStage struct {
   155		keys []SortKey
   156	}
   157	
   158	func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   159		for _, key := range s.keys {
   160			if key.As == "number" {
   161				for _, r := range in {
   162					v, ok := r.Get(key.Column)
   163					if !ok {
   164						return nil, fmt.Errorf("sort: column %s is missing", key.Column)
   165					}
   166					if _, err := parseFloat(v); err != nil {
   167						return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
   168					}
   169				}
   170			}
   171		}
   172	
   173		sort.SliceStable(in, func(i, j int) bool {
   174			for _, key := range s.keys {
   175				a, _ := in[i].Get(key.Column)
   176				b, _ := in[j].Get(key.Column)
   177	
   178				if key.As == "number" {
   179					af, _ := parseFloat(a)
   180					bf, _ := parseFloat(b)
   181					if af != bf {
   182						if key.Order == "desc" {
   183							return af > bf
   184						}
   185						return af < bf
   186					}
   187				} else {
   188					if a != b {
   189						if key.Order == "desc" {
   190							return a > b
   191						}
   192						return a < b
   193					}
   194				}
   195			}
   196			return false
   197		})
   198	
   199		return in, nil
   200	}
   201	
   202	type LimitStage struct {
   203		count int
   204	}
   205	
   206	func (s *LimitStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   207		if s.count < len(in) {
   208			return in[:s.count], nil
   209		}
   210		return in, nil
   211	}
