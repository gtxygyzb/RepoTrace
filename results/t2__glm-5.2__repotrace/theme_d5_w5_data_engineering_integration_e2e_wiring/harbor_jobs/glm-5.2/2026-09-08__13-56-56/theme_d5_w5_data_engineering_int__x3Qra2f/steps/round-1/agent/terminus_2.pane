[?2004lpackage input

import (
	"bufio"
	"bytes"
	"fmt"
	"io"
	"math"
	"os"
	"os/exec"
	"strconv"
	"strings"

	"example.com/flowctl/internal/config"
	"example.com/flowctl/internal/record"
)

func readSQLite(cfg config.InputConfig, dir string) ([]*record.Record, error) {
	path := config.ResolvePath(dir, cfg.Path)
	if _, err := os.Stat(path); err != nil {
		return nil, fmt.Errorf("input: %v", err)
	}

	cmd := exec.Command("/usr/bin/sqlite3", "-cmd", ".mode quote", "-cmd", ".headers on", path, cfg.Query)
	stdout, err := cmd.StdoutPipe()
	if err != nil {
		return nil, fmt.Errorf("input: %v", err)
	}
	var stderr bytes.Buffer
	cmd.Stderr = &stderr
	if err := cmd.Start(); err != nil {
		return nil, fmt.Errorf("input: %v", err)
	}

	r := bufio.NewReader(stdout)
	headerRaw, err := readSQLiteRecord(r)
	if err == io.EOF {
		if werr := cmd.Wait(); werr != nil {
			return nil, fmt.Errorf("input: %s", firstSQLiteError(stderr.String()))
		}
		return nil, fmt.Errorf("input: query returned no columns")
	}
	if err != nil {
		if werr := cmd.Wait(); werr != nil {
			return nil, fmt.Errorf("input: %s", firstSQLiteError(stderr.String()))
		}
		return nil, fmt.Errorf("input: %v", err)
	}

	header := make([]string, len(headerRaw))
	for i, raw := range headerRaw {
		name, err := renderSQLiteValue(raw)
		if err != nil {
			return nil, fmt.Errorf("input: %v", err)
		}
		header[i] = name
	}

	records := []*record.Record{}
	recNum := 0
	for {
		fields, err := readSQLiteRecord(r)
		if err == io.EOF {
			break
		}
		if err != nil {
			if werr := cmd.Wait(); werr != nil {
				return nil, fmt.Errorf("input: %s", firstSQLiteError(stderr.String()))
			}
			return nil, fmt.Errorf("input: %v", err)
		}

		recNum++
		if len(fields) != len(header) {
			return nil, fmt.Errorf("input: row %d: expected %d columns got %d", recNum, len(header), len(fields))
		}

		rec := record.New()
		rec.InputRow = recNum
		for i, col := range header {
			val, err := renderSQLiteValue(fields[i])
			if err != nil {
				return nil, fmt.Errorf("input: row %d: %v", recNum, err)
			}
			rec.Set(col, val)
		}
		records = append(records, rec)
	}

	if err := cmd.Wait(); err != nil {
		return nil, fmt.Errorf("input: %s", firstSQLiteError(stderr.String()))
	}

	return records, nil
}

func readSQLiteRecord(r *bufio.Reader) ([]string, error) {
	fields := []string{}
	for {
		b, err := r.ReadByte()
		if err == io.EOF {
			if len(fields) == 0 {
				return nil, io.EOF
			}
			return fields, nil
		}
		if err != nil {
			return nil, err
		}
		if b == '\n' || b == '\r' {
			continue
		}
		if b == ' ' || b == '\t' {
			continue
		}

		if err := r.UnreadByte(); err != nil {
			return nil, err
		}

		field, err := readSQLiteField(r)
		if err != nil {
			return nil, err
		}
		fields = append(fields, field)

		for {
			b, err := r.ReadByte()
			if err == io.EOF {
				return fields, nil
			}
			if err != nil {
				return nil, err
			}
			if b == ' ' || b == '\t' {
				continue
			}
			if b == ',' {
				break
			}
			if b == '\n' || b == '\r' {
				if err := r.UnreadByte(); err != nil {
					return nil, err
				}
				return fields, nil
			}
			return nil, fmt.Errorf("expected comma or newline between fields")
		}
	}
}

func readSQLiteField(r *bufio.Reader) (string, error) {
	b, err := r.ReadByte()
	if err != nil {
		return "", err
	}

	if b == '\'' {
		var sb strings.Builder
		sb.WriteByte(b)
		for {
			c, err := r.ReadByte()
			if err != nil {
				return "", fmt.Errorf("unterminated string literal")
			}
			sb.WriteByte(c)
			if c != '\'' {
				continue
			}

			nb, err := r.ReadByte()
			if err == io.EOF {
				return sb.String(), nil
			}
			if err != nil {
				return "", err
			}
			if nb == '\'' {
				sb.WriteByte(nb)
				continue
			}
			if err := r.UnreadByte(); err != nil {
				return "", err
			}
			return sb.String(), nil
		}
	}

	if err := r.UnreadByte(); err != nil {
		return "", err
	}

	var sb strings.Builder
	for {
		c, err := r.ReadByte()
		if err == io.EOF {
			return sb.String(), nil
		}
		if err != nil {
			return "", err
		}
		if c == ',' || c == '\n' || c == '\r' || c == ' ' || c == '\t' {
			if err := r.UnreadByte(); err != nil {
				return "", err
			}
			return sb.String(), nil
		}
		sb.WriteByte(c)
	}
}

func renderSQLiteValue(raw string) (string, error) {
	if raw == "NULL" {
		return "", nil
	}
	if len(raw) >= 2 && (raw[0] == 'X' || raw[0] == 'x') && raw[1] == '\'' && raw[len(raw)-1] == '\'' {
		return "", fmt.Errorf("BLOB values are not supported")
	}
	if len(raw) > 0 && raw[0] == '\'' {
		return unquoteSQLiteString(raw)
	}

	if _, err := strconv.ParseInt(raw, 10, 64); err == nil {
		return raw, nil
	}

	if f, err := strconv.ParseFloat(raw, 64); err == nil {
		if math.IsNaN(f) || math.IsInf(f, 0) {
			return "", fmt.Errorf("non-finite numeric value")
		}
		return formatFloat(f), nil
	}

	return raw, nil
}

func unquoteSQLiteString(raw string) (string, error) {
	if len(raw) < 2 || raw[0] != '\'' || raw[len(raw)-1] != '\'' {
		return "", fmt.Errorf("invalid string literal")
	}

	var b strings.Builder
	i := 1
	for i < len(raw)-1 {
		if raw[i] == '\'' {
			if i+1 < len(raw)-1 && raw[i+1] == '\'' {
				b.WriteByte('\'')
				i += 2
				continue
			}
			return "", fmt.Errorf("invalid string literal")
		}
		b.WriteByte(raw[i])
		i++
	}
	return b.String(), nil
}

