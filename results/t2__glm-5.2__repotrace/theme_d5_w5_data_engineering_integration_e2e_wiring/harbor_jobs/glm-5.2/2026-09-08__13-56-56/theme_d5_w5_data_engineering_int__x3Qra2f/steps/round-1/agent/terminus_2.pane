    12	
    13	type PivotStage struct {
    14		index        []string
    15		columns      string
    16		values       string
    17		asType       string
    18		agg          string
    19		fill         string
    20		sortColumns  string
    21		columnPrefix string
    22		strictSchema bool
    23		dropEmpty    bool
    24		onConflict   string
    25	}
    26	
    27	type pivotCell struct {
    28		count    int
    29		sum      float64
    30		min      float64
    31		max      float64
    32		hasNum   bool
    33		first    string
    34		last     string
    35		hasStr   bool
    36		contribs int
    37	}
    38	
    39	func (s *PivotStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    40		order := []string{}
    41		rows := map[string]*pivotRow{}
    42		colOrder := []string{}
    43		cols := map[string]bool{}
    44	
    45		for _, r := range in {
    46			idxParts := make([]string, len(s.index))
    47			for i, col := range s.index {
    48				v, ok := r.Get(col)
    49				if !ok {
    50					v = ""
    51				}
    52				idxParts[i] = v
    53			}
    54			idxKey := strings.Join(idxParts, "\x00")
    55	
    56			col, ok := r.Get(s.columns)
    57			if !ok {
    58				col = ""
    59			}
    60	
    61			row, exists := rows[idxKey]
    62			if !exists {
    63				row = &pivotRow{
    64					idxParts: idxParts,
    65					cells:    map[string]*pivotCell{},
    66				}
    67				rows[idxKey] = row
    68				order = append(order, idxKey)
    69			}
    70	
    71			if !cols[col] {
    72				cols[col] = true
    73				colOrder = append(colOrder, col)
    74			}
    75	
    76			cell, exists := row.cells[col]
    77			if !exists {
    78				cell = &pivotCell{}
    79				row.cells[col] = cell
    80			}
    81			cell.contribs++
    82	
    83			switch s.agg {
    84			case "count":
    85				cell.count++
    86			case "sum", "min", "max", "avg":
    87				v, ok := r.Get(s.values)
    88				if !ok || v == "" {
    89					continue
    90				}
    91				f, err := parseFloat(v)
    92				if err != nil {
