type Stats struct {
	Processed         int
	Emitted           int
	DroppedNonNumeric int
	DroppedMissing    int
	missingReported   bool
}

type Stage interface {
	Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error)
}

func Build(rawStages []map[string]interface{}) ([]Stage, error) {
	stages := make([]Stage, 0, len(rawStages))
	for i, sm := range rawStages {
		typ, ok := getString(sm, "type")
		if !ok || typ == "" {
			return nil, fmt.Errorf("config: stage %d: type is required", i+1)
		}

		var st Stage
		var err error
		switch typ {
		case "filter":
			st, err = buildFilter(i+1, sm)
		case "project":
			st, err = buildProject(i+1, sm)
		case "sort":
			st, err = buildSort(i+1, sm)
		case "limit":
			st, err = buildLimit(i+1, sm)
		case "group":
			st, err = buildGroup(i+1, sm)
		default:
			return nil, fmt.Errorf("config: stage %d: unknown stage type %q", i+1, typ)
		}
		if err != nil {
			return nil, err
		}
		stages = append(stages, st)
	}
	return stages, nil
}

type FilterStage struct {
	column string
	op     string
	value  string
}

func (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	out := make([]*record.Record, 0, len(in))

	for _, r := range in {
		v, ok := r.Get(s.column)
		if !ok {
			stats.DroppedMissing++
			if !stats.missingReported {
				fmt.Fprintf(stderr, "flowctl: filter: missing column %s\n", s.column)
				stats.missingReported = true
			}
			if strict {
				return nil, fmt.Errorf("filter: missing column %s", s.column)
			}
			continue
		}

		keep := false
		switch s.op {
		case "==":
			keep = v == s.value
		case "!=":
			keep = v != s.value
		default:
			left, err := parseFloat(v)
			if err != nil {
				stats.DroppedNonNumeric++
				fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
				if strict {
					return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
				}
				continue
			}
			right, err := parseFloat(s.value)
			if err != nil {
				stats.DroppedNonNumeric++
				fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
				if strict {
					return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
				}
				continue
			}
			keep = compareFloats(left, s.op, right)
		}

		if keep {
			out = append(out, r)
		}
	}

	return out, nil
}

type ProjectColumn struct {
	Source string
	Target string
}

type ProjectStage struct {
	columns []ProjectColumn
}

func (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	out := make([]*record.Record, 0, len(in))
	for _, r := range in {
		nr := record.New()
		nr.InputRow = r.InputRow
		for _, c := range s.columns {
			val := ""
			if v, ok := r.Get(c.Source); ok {
				val = v
			}
			nr.Set(c.Target, val)
		}
		out = append(out, nr)
	}
	return out, nil
}

type SortKey struct {
	Column string
	Order  string
	As     string
}

type SortStage struct {
	keys []SortKey
}

func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	for _, key := range s.keys {
		if key.As == "number" {
			for _, r := range in {
				v, ok := r.Get(key.Column)
				if !ok {
					return nil, fmt.Errorf("sort: column %s is missing", key.Column)
				}
				if _, err := parseFloat(v); err != nil {
					return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
				}
			}
		}
	}

	sort.SliceStable(in, func(i, j int) bool {
		for _, key := range s.keys {
			a, _ := in[i].Get(key.Column)
			b, _ := in[j].Get(key.Column)

			if key.As == "number" {
				af, _ := parseFloat(a)
				bf, _ := parseFloat(b)
				if af != bf {
					if key.Order == "desc" {
						return af > bf
					}
					return af < bf
				}
			} else {
				if a != b {
					if key.Order == "desc" {
						return a > b
					}
					return a < b
				}
			}
		}
		return false
	})

	return in, nil
}

type LimitStage struct {
	count int
}

func (s *LimitStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	if s.count < len(in) {
		return in[:s.count], nil
	}
	return in, nil
}

func buildFilter(idx int, sm map[string]interface{}) (Stage, error) {
	whereRaw, ok := sm["where"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: filter.where is required", idx)
