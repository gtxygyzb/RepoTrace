   196	type LimitStage struct {
   197		count int
   198	}
   199	
   200	func (s *LimitStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   201		if s.count < len(in) {
   202			return in[:s.count], nil
   203		}
   204		return in, nil
   205	}
