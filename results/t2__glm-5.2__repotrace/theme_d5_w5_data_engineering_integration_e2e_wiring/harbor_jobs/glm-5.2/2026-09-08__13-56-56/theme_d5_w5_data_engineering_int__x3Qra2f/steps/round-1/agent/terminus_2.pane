   380	func getBool(m map[string]interface{}, key string) (bool, bool, error) {
   381		v, ok := m[key]
   382		if !ok {
   383			return false, false, nil
   384		}
   385		switch b := v.(type) {
   386		case bool:
   387			return b, true, nil
   388		case string:
   389			if b == "true" {
   390				return true, true, nil
   391			}
   392			if b == "false" {
   393				return false, true, nil
   394			}
   395			return false, true, fmt.Errorf("%s must be a boolean", key)
   396		default:
   397			return false, true, fmt.Errorf("%s must be a boolean", key)
   398		}
   399	}
   400	
   401	func parseFloat(s string) (float64, error) {
   402		f, err := strconv.ParseFloat(s, 64)
   403		if err != nil {
   404			return 0, err
   405		}
   406		if math.IsNaN(f) || math.IsInf(f, 0) {
   407			return 0, fmt.Errorf("not a finite number")
   408		}
   409		return f, nil
   410	}
   411	
   412	func compareFloats(left float64, op string, right float64) bool {
   413		switch op {
   414		case "<":
   415			return left < right
   416		case "<=":
   417			return left <= right
   418		case ">":
   419			return left > right
   420		case ">=":
   421			return left >= right
   422		}
   423		return false
   424	}
