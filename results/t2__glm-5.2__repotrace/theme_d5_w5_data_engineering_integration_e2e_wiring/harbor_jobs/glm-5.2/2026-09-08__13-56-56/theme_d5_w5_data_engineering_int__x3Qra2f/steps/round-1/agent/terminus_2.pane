   150		Order  string
   151		As     string
   152	}
   153	
   154	type SortStage struct {
   155		keys []SortKey
   156	}
   157	
   158	func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   159		for _, key := range s.keys {
   160			if key.As == "number" {
   161				for _, r := range in {
   162					v, ok := r.Get(key.Column)
   163					if !ok {
   164						return nil, fmt.Errorf("sort: column %s is missing", key.Column)
   165					}
   166					if _, err := parseFloat(v); err != nil {
   167						return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
   168					}
   169				}
   170			}
   171		}
   172	
   173		sort.SliceStable(in, func(i, j int) bool {
   174			for _, key := range s.keys {
   175				a, _ := in[i].Get(key.Column)
   176				b, _ := in[j].Get(key.Column)
   177	
   178				if key.As == "number" {
   179					af, _ := parseFloat(a)
   180					bf, _ := parseFloat(b)
   181					if af != bf {
   182						if key.Order == "desc" {
   183							return af > bf
   184						}
   185						return af < bf
   186					}
   187				} else {
   188					if a != b {
   189						if key.Order == "desc" {
   190							return a > b
   191						}
   192						return a < b
   193					}
   194				}
   195			}
   196			return false
   197		})
   198	
   199		return in, nil
   200	}
