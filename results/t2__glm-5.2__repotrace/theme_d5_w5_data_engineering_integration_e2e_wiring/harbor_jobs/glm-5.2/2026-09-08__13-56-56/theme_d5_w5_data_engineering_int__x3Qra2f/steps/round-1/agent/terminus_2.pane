   264				}
   265				as, ok := getString(v, "as")
   266				if !ok || as == "" {
   267					return nil, fmt.Errorf("config: stage %d: project column %d as is required", idx, j+1)
   268				}
   269				if seen[as] {
   270					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, as)
   271				}
   272				seen[as] = true
   273				columns = append(columns, ProjectColumn{Source: name, Target: as})
   274			default:
   275				return nil, fmt.Errorf("config: stage %d: project column %d must be a string or mapping", idx, j+1)
   276			}
   277		}
