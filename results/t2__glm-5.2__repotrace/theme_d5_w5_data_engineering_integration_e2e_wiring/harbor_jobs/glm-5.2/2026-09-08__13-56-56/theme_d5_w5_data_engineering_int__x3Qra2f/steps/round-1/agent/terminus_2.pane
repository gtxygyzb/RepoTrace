		"type":          true,
		"index":         true,
		"columns":       true,
		"values":        true,
		"as":            true,
		"agg":           true,
		"fill":          true,
		"sort_columns":  true,
		"column_prefix": true,
		"strict_schema": true,
		"drop_empty":    true,
		"on_conflict":   true,
	}
	for k := range sm {
		if !known[k] {
