    39	func (s *PivotStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    40		order := []string{}
    41		rows := map[string]*pivotRow{}
    42		colOrder := []string{}
    43		cols := map[string]bool{}
    44	
    45		for _, r := range in {
    46			idxParts := make([]string, len(s.index))
    47			for i, col := range s.index {
    48				v, ok := r.Get(col)
    49				if !ok {
    50					v = ""
    51				}
    52				idxParts[i] = v
    53			}
    54			idxKey := strings.Join(idxParts, "\x00")
    55	
    56			col, ok := r.Get(s.columns)
    57			if !ok {
    58				col = ""
    59			}
    60	
    61			row, exists := rows[idxKey]
    62			if !exists {
    63				row = &pivotRow{
    64					idxParts: idxParts,
    65					cells:    map[string]*pivotCell{},
    66				}
    67				rows[idxKey] = row
    68				order = append(order, idxKey)
    69			}
    70	
    71			if !cols[col] {
    72				cols[col] = true
    73				colOrder = append(colOrder, col)
    74			}
    75	
    76			cell, exists := row.cells[col]
    77			if !exists {
    78				cell = &pivotCell{}
    79				row.cells[col] = cell
    80			}
    81			cell.contribs++
    82	
    83			switch s.agg {
    84			case "count":
    85				cell.count++
    86			case "sum", "min", "max", "avg":
    87				v, ok := r.Get(s.values)
    88				if !ok || v == "" {
    89					continue
    90				}
    91				f, err := parseFloat(v)
    92				if err != nil {
    93					return nil, fmt.Errorf("pivot: non-numeric value in column %s at row %d", s.values, r.InputRow)
    94				}
    95				cell.count++
    96				cell.sum += f
    97				if !cell.hasNum || f < cell.min {
    98					cell.min = f
    99				}
   100				if !cell.hasNum || f > cell.max {
   101					cell.max = f
   102				}
   103				cell.hasNum = true
   104			case "first", "last":
   105				v, ok := r.Get(s.values)
   106				if !ok {
   107					v = ""
   108				}
   109				if s.onConflict == "error" && cell.contribs > 1 {
   110					return nil, fmt.Errorf("pivot: duplicate contributor for cell %s/%s", strings.Join(row.idxParts, "|"), col)
   111				}
   112				if !cell.hasStr {
   113					cell.first = v
   114					cell.hasStr = true
   115				}
   116				cell.last = v
   117			}
   118		}
   119	
   120		sortedCols := s.sortPivotColumns(colOrder)
