   304	func buildSort(idx int, sm map[string]interface{}) (Stage, error) {
   305		keysRaw, ok := sm["keys"]
   306		if !ok {
   307			return nil, fmt.Errorf("config: stage %d: sort.keys is required", idx)
   308		}
   309		list, ok := keysRaw.([]interface{})
   310		if !ok {
   311			return nil, fmt.Errorf("config: stage %d: sort.keys must be a list", idx)
