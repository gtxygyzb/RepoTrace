[?2004lpackage config

import (
	"bufio"
	"bytes"
	"fmt"
	"os"
	"path/filepath"
	"strconv"
	"strings"
)

type InputConfig struct {
	Path   string
	Format string
	Query  string
}

type OutputConfig struct {
	Path           string
	Format         string
	Columns        []string
	ColumnsPresent bool
}

type Config struct {
	Dir    string
	Strict bool
	Input  InputConfig
	Stages []map[string]interface{}
	Output OutputConfig
}

func Load(path string) (*Config, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, fmt.Errorf("config: %v", err)
	}

	root, err := parseYAML(data)
	if err != nil {
		return nil, fmt.Errorf("config: %v", err)
	}

	m, ok := root.(map[string]interface{})
	if !ok {
		return nil, fmt.Errorf("config: top-level value must be a mapping")
	}

	cfg := &Config{Dir: filepath.Dir(path)}

	inRaw, ok := m["input"]
	if !ok {
		return nil, fmt.Errorf("config: input is required")
	}
	inMap, ok := inRaw.(map[string]interface{})
	if !ok {
		return nil, fmt.Errorf("config: input must be a mapping")
	}
	if p, ok := getString(inMap, "path"); ok {
		cfg.Input.Path = p
	} else {
		return nil, fmt.Errorf("config: input.path is required")
	}
	if cfg.Input.Path == "" {
		return nil, fmt.Errorf("config: input.path is required")
	}
	if f, ok := getString(inMap, "format"); ok {
		cfg.Input.Format = f
	} else {
		return nil, fmt.Errorf("config: input.format is required")
	}
	if cfg.Input.Format == "" {
		return nil, fmt.Errorf("config: input.format is required")
	}
	if cfg.Input.Format != "csv" && cfg.Input.Format != "ndjson" && cfg.Input.Format != "sqlite" {
		return nil, fmt.Errorf("config: input.format must be csv, ndjson, or sqlite")
	}
	if cfg.Input.Format == "sqlite" {
		if q, ok := getString(inMap, "query"); ok {
			cfg.Input.Query = q
		} else {
			return nil, fmt.Errorf("config: input.query is required")
		}
		if cfg.Input.Query == "" {
			return nil, fmt.Errorf("config: input.query is required")
		}
	}

	stRaw, ok := m["stages"]
	if !ok {
		return nil, fmt.Errorf("config: stages is required")
	}
	stList, ok := stRaw.([]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stages must be a list")
	}
	cfg.Stages = []map[string]interface{}{}
	for i, item := range stList {
		sm, ok := item.(map[string]interface{})
		if !ok {
			return nil, fmt.Errorf("config: stage %d must be a mapping", i+1)
		}
		cfg.Stages = append(cfg.Stages, sm)
	}

	outRaw, ok := m["output"]
	if !ok {
		return nil, fmt.Errorf("config: output is required")
	}
	outMap, ok := outRaw.(map[string]interface{})
	if !ok {
		return nil, fmt.Errorf("config: output must be a mapping")
	}
	if p, ok := getString(outMap, "path"); ok {
		cfg.Output.Path = p
	} else {
		return nil, fmt.Errorf("config: output.path is required")
	}
	if cfg.Output.Path == "" {
		return nil, fmt.Errorf("config: output.path is required")
	}
	if f, ok := getString(outMap, "format"); ok {
		cfg.Output.Format = f
	} else {
		return nil, fmt.Errorf("config: output.format is required")
	}
	if cfg.Output.Format == "" {
		return nil, fmt.Errorf("config: output.format is required")
	}
	if cfg.Output.Format != "jsonl" {
		return nil, fmt.Errorf("config: output.format must be jsonl")
	}
	if colRaw, present := outMap["columns"]; present {
		cfg.Output.ColumnsPresent = true
		cols, err := toStringList(colRaw)
		if err != nil {
			return nil, fmt.Errorf("config: output.columns: %v", err)
		}
		cfg.Output.Columns = cols
	}

	return cfg, nil
}

func ResolvePath(dir, path string) string {
	if path == "-" {
		return "-"
	}
	if filepath.IsAbs(path) {
		return path
	}
	return filepath.Join(dir, path)
}

func getString(m map[string]interface{}, key string) (string, bool) {
	v, ok := m[key]
	if !ok {
		return "", false
	}
	if s, ok := v.(string); ok {
		return s, true
	}
	return "", true
}

func toStringList(v interface{}) ([]string, error) {
	list, ok := v.([]interface{})
	if !ok {
		return nil, fmt.Errorf("must be a list of strings")
	}
	out := []string{}
	for i, item := range list {
		s, ok := item.(string)
		if !ok {
			return nil, fmt.Errorf("entry %d must be a string", i+1)
		}
		out = append(out, s)
	}
	return out, nil
}

type yamlLine struct {
	indent int
	text   string
}

func parseYAML(data []byte) (interface{}, error) {
	lines := []yamlLine{}
	scanner := bufio.NewScanner(bytes.NewReader(data))
	for scanner.Scan() {
		raw := scanner.Text()
		line := stripComment(raw)
		if strings.TrimSpace(line) == "" {
			continue
		}
		indent := 0
		for indent < len(line) && line[indent] == ' ' {
			indent++
		}
		if indent < len(line) && line[indent] == '\t' {
			return nil, fmt.Errorf("tabs are not allowed for indentation")
		}
		text := strings.TrimRight(line[indent:], " \t")
		lines = append(lines, yamlLine{indent: indent, text: text})
	}
	if err := scanner.Err(); err != nil {
		return nil, err
	}
	if len(lines) == 0 {
		return nil, nil
	}
	val, _, err := parseNode(lines, 0, lines[0].indent)
	return val, err
}

func parseNode(lines []yamlLine, start, indent int) (interface{}, int, error) {
	if start >= len(lines) || lines[start].indent < indent {
		return nil, start, nil
	}
[?2004hroot@n30009:/app# sed -n '1,260p' internal/stage/stage.go
[?2004lpackage stage

import (
	"fmt"
	"io"
	"math"
	"sort"
	"strconv"

	"example.com/flowctl/internal/record"
)

type Stats struct {
	Processed         int
	Emitted           int
	DroppedNonNumeric int
	DroppedMissing    int
	missingReported   bool
}

type Stage interface {
	Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error)
}

func Build(rawStages []map[string]interface{}) ([]Stage, error) {
	return BuildWithDir(rawStages, "")
}

func BuildWithDir(rawStages []map[string]interface{}, dir string) ([]Stage, error) {
	stages := make([]Stage, 0, len(rawStages))
	for i, sm := range rawStages {
		typ, ok := getString(sm, "type")
		if !ok || typ == "" {
			return nil, fmt.Errorf("config: stage %d: type is required", i+1)
		}

		var st Stage
		var err error
		switch typ {
		case "filter":
			st, err = buildFilter(i+1, sm)
		case "project":
			st, err = buildProject(i+1, sm)
		case "sort":
			st, err = buildSort(i+1, sm)
		case "limit":
			st, err = buildLimit(i+1, sm)
		case "group":
			st, err = buildGroup(i+1, sm)
		case "join":
			st, err = buildJoin(i+1, sm, dir)
		case "dedup":
			st, err = buildDedup(i+1, sm)
		default:
			return nil, fmt.Errorf("config: stage %d: unknown stage type %q", i+1, typ)
		}
		if err != nil {
			return nil, err
		}
		stages = append(stages, st)
	}
	return stages, nil
}

type FilterStage struct {
	column string
	op     string
	value  string
}

func (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	out := make([]*record.Record, 0, len(in))

	for _, r := range in {
		v, ok := r.Get(s.column)
		if !ok {
			stats.DroppedMissing++
			if !stats.missingReported {
				fmt.Fprintf(stderr, "flowctl: filter: missing column %s\n", s.column)
				stats.missingReported = true
			}
			if strict {
				return nil, fmt.Errorf("filter: missing column %s", s.column)
			}
			continue
		}

		keep := false
		switch s.op {
		case "==":
			keep = v == s.value
		case "!=":
			keep = v != s.value
		default:
			left, err := parseFloat(v)
			if err != nil {
				stats.DroppedNonNumeric++
				fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
				if strict {
					return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
				}
				continue
			}
			right, err := parseFloat(s.value)
			if err != nil {
				stats.DroppedNonNumeric++
				fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
				if strict {
					return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
				}
				continue
			}
			keep = compareFloats(left, s.op, right)
		}

		if keep {
			out = append(out, r)
		}
	}

	return out, nil
}

type ProjectColumn struct {
	Source string
	Target string
}

type ProjectStage struct {
	columns []ProjectColumn
}

func (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	out := make([]*record.Record, 0, len(in))
	for _, r := range in {
		nr := record.New()
		nr.InputRow = r.InputRow
		for _, c := range s.columns {
			val := ""
			if v, ok := r.Get(c.Source); ok {
				val = v
			}
			nr.Set(c.Target, val)
		}
		out = append(out, nr)
	}
	return out, nil
}

type SortKey struct {
	Column string
	Order  string
	As     string
}

type SortStage struct {
	keys []SortKey
}

func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	for _, key := range s.keys {
		if key.As == "number" {
			for _, r := range in {
				v, ok := r.Get(key.Column)
				if !ok || v == "" {
					continue
				}
				if _, err := parseFloat(v); err != nil {
					return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
				}
			}
		}
	}

	sort.SliceStable(in, func(i, j int) bool {
		for _, key := range s.keys {
			a, aok := in[i].Get(key.Column)
			b, bok := in[j].Get(key.Column)

			if key.As == "number" {
				aMissing := !aok || a == ""
				bMissing := !bok || b == ""
				if aMissing != bMissing {
					if key.Order == "desc" {
						return bMissing
					}
					return aMissing
				}
				if aMissing {
					continue
				}
				af, errA := parseFloat(a)
				bf, errB := parseFloat(b)
				if errA != nil || errB != nil {
					return false
				}
				if af != bf {
					if key.Order == "desc" {
						return af > bf
					}
					return af < bf
				}
			} else {
				if a != b {
					if key.Order == "desc" {
						return a > b
					}
					return a < b
				}
			}
		}
		return false
	})

	return in, nil
}

type LimitStage struct {
	count int
}

func (s *LimitStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	if s.count < len(in) {
		return in[:s.count], nil
	}
	return in, nil
}

func buildFilter(idx int, sm map[string]interface{}) (Stage, error) {
	whereRaw, ok := sm["where"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: filter.where is required", idx)
	}
	where, ok := whereRaw.(map[string]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stage %d: filter.where must be a mapping", idx)
	}

	column, ok := getString(where, "column")
	if !ok || column == "" {
		return nil, fmt.Errorf("config: stage %d: filter.where.column is required", idx)
	}

	op, ok := getString(where, "op")
	if !ok || op == "" {
		return nil, fmt.Errorf("config: stage %d: filter.where.op is required", idx)
	}
	switch op {
	case "==", "!=", "<", "<=", ">", ">=":
	default:
		return nil, fmt.Errorf("config: stage %d: filter.where.op is invalid", idx)
	}

	value, ok := getString(where, "value")
	if !ok {
		return nil, fmt.Errorf("config: stage %d: filter.where.value is required", idx)
	}

	return &FilterStage{column: column, op: op, value: value}, nil
}
[?2004hroot@n30009:/app# sed -n '1,260p' internal/stage/group.go
[?2004lpackage stage

import (
	"fmt"
	"io"
	"math"
	"strconv"
	"strings"

	"example.com/flowctl/internal/record"
)

type GroupAggregate struct {
	As     string
	Op     string
	Column string
}

type GroupStage struct {
	by         []string
	aggregates []GroupAggregate
}

func (s *GroupStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	type groupState struct {
		keyParts []string
		firstRow int
		count    int
		sums     []float64
		mins     []float64
		maxs     []float64
		hasMin   []bool
		hasMax   []bool
	}

	order := []string{}
	keys := map[string]*groupState{}

	for _, r := range in {
		keyParts := make([]string, len(s.by))
		for i, col := range s.by {
			v, ok := r.Get(col)
			if !ok {
				return nil, fmt.Errorf("group: missing column %s", col)
			}
			keyParts[i] = v
		}
		key := strings.Join(keyParts, "\x00")

		st, exists := keys[key]
		if !exists {
			st = &groupState{
				keyParts: keyParts,
				firstRow: r.InputRow,
				sums:     make([]float64, len(s.aggregates)),
				mins:     make([]float64, len(s.aggregates)),
				maxs:     make([]float64, len(s.aggregates)),
				hasMin:   make([]bool, len(s.aggregates)),
				hasMax:   make([]bool, len(s.aggregates)),
			}
			keys[key] = st
			order = append(order, key)
		}
		st.count++

		for i, agg := range s.aggregates {
			if agg.Op == "count" {
				continue
			}

			v, ok := r.Get(agg.Column)
			if !ok {
				return nil, fmt.Errorf("group: missing column %s", agg.Column)
			}
			f, err := parseFloat(v)
			if err != nil {
				return nil, fmt.Errorf("group: non-numeric value in column %s at row %d", agg.Column, r.InputRow)
			}

			st.sums[i] += f
			if !st.hasMin[i] || f < st.mins[i] {
				st.mins[i] = f
				st.hasMin[i] = true
			}
			if !st.hasMax[i] || f > st.maxs[i] {
				st.maxs[i] = f
				st.hasMax[i] = true
			}
		}
	}

	out := make([]*record.Record, 0, len(order))
	for _, key := range order {
		st := keys[key]
		nr := record.New()
		nr.InputRow = st.firstRow

		for i, col := range s.by {
			nr.Set(col, st.keyParts[i])
		}

		for i, agg := range s.aggregates {
			switch agg.Op {
			case "count":
				nr.Set(agg.As, strconv.Itoa(st.count))
			case "sum":
				nr.Set(agg.As, formatFloat(st.sums[i]))
			case "min":
				nr.Set(agg.As, formatFloat(st.mins[i]))
			case "max":
				nr.Set(agg.As, formatFloat(st.maxs[i]))
			case "avg":
				if st.count == 0 {
					return nil, fmt.Errorf("group: avg of empty group")
				}
				nr.Set(agg.As, formatFloat(st.sums[i]/float64(st.count)))
			}
		}

		out = append(out, nr)
	}

	return out, nil
}

func buildGroup(idx int, sm map[string]interface{}) (Stage, error) {
	byRaw, ok := sm["by"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: group.by is required", idx)
	}
	by, err := toStringList(byRaw)
	if err != nil {
		return nil, fmt.Errorf("config: stage %d: group.by: %v", idx, err)
	}
	if len(by) == 0 {
		return nil, fmt.Errorf("config: stage %d: group.by must be non-empty", idx)
	}

	aggRaw, ok := sm["aggregates"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: group.aggregates is required", idx)
	}
	aggList, ok := aggRaw.([]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stage %d: group.aggregates must be a list", idx)
	}
	if len(aggList) == 0 {
		return nil, fmt.Errorf("config: stage %d: group.aggregates must be non-empty", idx)
	}

	aggregates := make([]GroupAggregate, 0, len(aggList))
	seen := map[string]bool{}
	for i, item := range aggList {
		am, ok := item.(map[string]interface{})
		if !ok {
			return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d must be a mapping", idx, i+1)
		}

		name, ok := getString(am, "as")
		if !ok || name == "" {
			return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: as is required", idx, i+1)
		}
		if seen[name] {
			return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: duplicate as %q", idx, i+1, name)
		}

		op, ok := getString(am, "op")
		if !ok || op == "" {
			return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: op is required", idx, i+1)
		}
		switch op {
		case "count", "sum", "min", "max", "avg":
		default:
			return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: op must be count, sum, min, max, or avg", idx, i+1)
		}

		col, hasCol := getString(am, "column")
		if op == "count" {
			if hasCol {
				return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: column must not be present for count", idx, i+1)
			}
		} else {
			if !hasCol || col == "" {
				return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: column is required", idx, i+1)
			}
		}

		aggregates = append(aggregates, GroupAggregate{As: name, Op: op, Column: col})
		seen[name] = true
	}

	return &GroupStage{by: by, aggregates: aggregates}, nil
}

func toStringList(v interface{}) ([]string, error) {
	list, ok := v.([]interface{})
	if !ok {
		return nil, fmt.Errorf("must be a list of strings")
	}
	out := []string{}
	for i, item := range list {
		s, ok := item.(string)
		if !ok {
			return nil, fmt.Errorf("entry %d must be a string", i+1)
		}
		out = append(out, s)
	}
	return out, nil
}

func formatFloat(f float64) string {
	if math.IsNaN(f) || math.IsInf(f, 0) {
		return strconv.FormatFloat(f, 'g', -1, 64)
	}
	if f == float64(int64(f)) {
		return strconv.FormatInt(int64(f), 10)
	}
	return strconv.FormatFloat(f, 'g', -1, 64)
}
