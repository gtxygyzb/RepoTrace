   272	                if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {
   273	                        switch s.onNonNumeric {
   274	                        case "drop":
   275	                                stats.DroppedNonNumeric++
   276	                                fmt.Fprintf(stderr, "flowctl: bucket: drop non-numeric row %d\n", r.InputRow)
   277	                                if strict {
   278	                                        return nil, fmt.Errorf("strict: non-numeric row %d", r.InputRow)
   279	                                }
   280	                                continue
   281	                        case "error":
   282	                                return nil, fmt.Errorf("flowctl: bucket: non-numeric value in column %s at row %d", s.column, r.InputRow)
   283	                        case "keep_empty":
   284	                                nr := r.Copy()
