    13	
    14	func Write(records []*record.Record, cfg config.OutputConfig, dir string) (int, error) {
    15		var buf bytes.Buffer
    16	
    17		for _, r := range records {
    18			if cfg.ColumnsPresent {
    19				writeObject(&buf, cfg.Columns, r)
    20			} else {
    21				writeObject(&buf, r.Order, r)
    22			}
    23			buf.WriteByte('\n')
    24		}
    25	
    26		if cfg.Path == "-" {
    27			if _, err := os.Stdout.Write(buf.Bytes()); err != nil {
    28				return 0, fmt.Errorf("output: %v", err)
    29			}
    30			return len(records), nil
    31		}
    32	
    33		full := config.ResolvePath(dir, cfg.Path)
    34		dirName := filepath.Dir(full)
    35	
    36		tmp, err := os.CreateTemp(dirName, ".flowctl-output-*")
    37		if err != nil {
    38			return 0, fmt.Errorf("output: %v", err)
    39		}
    40	
    41		if _, err := tmp.Write(buf.Bytes()); err != nil {
    42			tmp.Close()
    43			os.Remove(tmp.Name())
    44			return 0, fmt.Errorf("output: %v", err)
    45		}
    46		if err := tmp.Close(); err != nil {
    47			os.Remove(tmp.Name())
    48			return 0, fmt.Errorf("output: %v", err)
    49		}
    50		if err := os.Rename(tmp.Name(), full); err != nil {
    51			os.Remove(tmp.Name())
    52			return 0, fmt.Errorf("output: %v", err)
    53		}
    54	
    55		return len(records), nil
    56	}
    57	
    58	func writeObject(buf *bytes.Buffer, cols []string, r *record.Record) {
    59		buf.WriteByte('{')
    60		for i, col := range cols {
    61			if i > 0 {
    62				buf.WriteByte(',')
    63			}
    64			buf.WriteString(encodeJSONString(col))
    65			buf.WriteByte(':')
    66			val := ""
    67			if v, ok := r.Get(col); ok {
    68				val = v
    69			}
    70			buf.WriteString(encodeJSONString(val))
    71		}
    72		buf.WriteByte('}')
    73	}
    74	
    75	func encodeJSONString(s string) string {
    76		var b strings.Builder
    77		b.WriteByte('"')
    78		for i := 0; i < len(s); i++ {
    79			c := s[i]
    80			switch c {
    81			case '\\':
    82				b.WriteString("\\\\")
    83			case '"':
    84				b.WriteString("\\\"")
    85			case '\n':
    86				b.WriteString("\\n")
    87			case '\r':
    88				b.WriteString("\\r")
    89			case '\t':
    90				b.WriteString("\\t")
    91			default:
    92				if c < 0x20 {
    93					fmt.Fprintf(&b, "\\u%04x", c)
    94				} else {
    95					b.WriteByte(c)
    96				}
    97			}
    98		}
    99		b.WriteByte('"')
   100		return b.String()
   101	}
