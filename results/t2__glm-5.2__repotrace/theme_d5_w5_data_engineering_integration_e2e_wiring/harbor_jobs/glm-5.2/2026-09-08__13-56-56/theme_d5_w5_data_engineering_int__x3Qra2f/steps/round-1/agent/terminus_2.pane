[?2004l[?2004h> package pipeline
[?2004l[?2004h> 
[?2004l[?2004h> import (
[?2004l[?2004h>     "os"
[?2004l[?2004h> 
[?2004l[?2004h>     "example.com/flowctl/internal/config"
[?2004l[?2004h>     "example.com/flowctl/internal/input"
[?2004l[?2004h>     "example.com/flowctl/internal/output"
[?2004l[?2004h>     "example.com/flowctl/internal/stage"
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> func Run(cfg *config.Config) (*stage.Stats, error) {
[?2004l[?2004h>     stats := &stage.Stats{}
[?2004l[?2004h> 
[?2004l[?2004h>     stages, err := stage.Build(cfg.Stages)
[?2004l[?2004h>     if err != nil {
[?2004l[?2004h>         return stats, err
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     records, err := input.Read(cfg.Input, cfg.Dir)
[?2004l[?2004h>     if err != nil {
[?2004l[?2004h>         return stats, err
[?2004l[?2004h>     }
[?2004l[?2004h>     stats.Processed = len(records)
[?2004l[?2004h> 
[?2004l[?2004h>     for _, st := range stages {
[?2004l[?2004h>         records, err = st.Apply(records, os.Stderr, cfg.Strict, stats)
[?2004l[?2004h>         if err != nil {
[?2004l[?2004h>             return stats, err
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     n, err := output.Write(records, cfg.Output, cfg.Dir)
[?2004l[?2004h>     if err != nil {
[?2004l[?2004h>         return stats, err
[?2004l[?2004h>     }
[?2004l[?2004h>     stats.Emitted = n
[?2004l[?2004h> 
[?2004l[?2004h>     return stats, nil
[?2004l[?2004h> }
