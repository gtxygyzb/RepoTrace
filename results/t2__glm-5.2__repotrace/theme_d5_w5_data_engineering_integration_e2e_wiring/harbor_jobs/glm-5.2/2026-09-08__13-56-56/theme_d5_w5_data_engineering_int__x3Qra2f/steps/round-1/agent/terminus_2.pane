   283	                        case "keep_empty":
   284	                                nr := r.Copy()
   285	                                if nr.Has(s.into) {
   286	                                        return nil, fmt.Errorf("flowctl: bucket: into column %s already present at row %d", s.into, r.InputRow)
   287	                                }
   288	                                nr.Set(s.into, "")
   289	                                out = append(out, nr)
   290	                                continue
   291	                        }
   292	                }
   293	
   294	                label := s.bucketLabel(f)
   295	                nr := r.Copy()
   296	                if nr.Has(s.into) {
   297	                        return nil, fmt.Errorf("flowctl: bucket: into column %s already present at row %d", s.into, r.InputRow)
   298	                }
   299	                nr.Set(s.into, label)
   300	                out = append(out, nr)
