    34	func Load(path string) (*Config, error) {
    35		data, err := os.ReadFile(path)
    36		if err != nil {
    37			return nil, fmt.Errorf("config: %v", err)
    38		}
    39	
    40		root, err := parseYAML(data)
    41		if err != nil {
    42			return nil, fmt.Errorf("config: %v", err)
    43		}
    44	
    45		m, ok := root.(map[string]interface{})
    46		if !ok {
    47			return nil, fmt.Errorf("config: top-level value must be a mapping")
    48		}
    49	
    50		cfg := &Config{Dir: filepath.Dir(path)}
    51	
    52		inRaw, ok := m["input"]
    53		if !ok {
    54			return nil, fmt.Errorf("config: input is required")
    55		}
    56		inMap, ok := inRaw.(map[string]interface{})
    57		if !ok {
    58			return nil, fmt.Errorf("config: input must be a mapping")
    59		}
    60		if p, ok := getString(inMap, "path"); ok {
    61			cfg.Input.Path = p
    62		} else {
    63			return nil, fmt.Errorf("config: input.path is required")
    64		}
    65		if cfg.Input.Path == "" {
    66			return nil, fmt.Errorf("config: input.path is required")
    67		}
    68		if f, ok := getString(inMap, "format"); ok {
