   481	func splitFlow(s string) []string {
   482		parts := []string{}
   483		depth := 0
   484		inSingle := false
   485		inDouble := false
   486		start := 0
   487		for i := 0; i < len(s); i++ {
   488			c := s[i]
   489			switch c {
   490			case '\'':
   491				if !inDouble {
   492					inSingle = !inSingle
   493				}
   494			case '"':
   495				if !inSingle {
   496					inDouble = !inDouble
   497				}
   498			case '[', '{':
   499				if !inSingle && !inDouble {
   500					depth++
   501				}
   502			case ']', '}':
   503				if !inSingle && !inDouble {
   504					depth--
   505				}
   506			case ',':
   507				if depth == 0 && !inSingle && !inDouble {
   508					parts = append(parts, s[start:i])
   509					start = i + 1
   510				}
   511			}
   512		}
   513		parts = append(parts, s[start:])
   514		return parts
   515	}
