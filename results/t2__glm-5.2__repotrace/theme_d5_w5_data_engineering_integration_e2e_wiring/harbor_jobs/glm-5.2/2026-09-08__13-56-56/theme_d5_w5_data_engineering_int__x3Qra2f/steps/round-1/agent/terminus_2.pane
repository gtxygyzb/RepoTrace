   142	type SortKey struct {
   143		Column string
   144		Order  string
   145		As     string
   146	}
   147	
   148	type SortStage struct {
   149		keys []SortKey
   150	}
   151	
   152	func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   153		for _, key := range s.keys {
   154			if key.As == "number" {
   155				for _, r := range in {
   156					v, ok := r.Get(key.Column)
   157					if !ok {
   158						return nil, fmt.Errorf("sort: column %s is missing", key.Column)
   159					}
   160					if _, err := parseFloat(v); err != nil {
   161						return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
   162					}
   163				}
   164			}
   165		}
   166	
   167		sort.SliceStable(in, func(i, j int) bool {
   168			for _, key := range s.keys {
   169				a, _ := in[i].Get(key.Column)
   170				b, _ := in[j].Get(key.Column)
   171	
   172				if key.As == "number" {
   173					af, _ := parseFloat(a)
   174					bf, _ := parseFloat(b)
   175					if af != bf {
   176						if key.Order == "desc" {
   177							return af > bf
   178						}
   179						return af < bf
   180					}
   181				} else {
   182					if a != b {
   183						if key.Order == "desc" {
   184							return a > b
   185						}
   186						return a < b
   187					}
   188				}
   189			}
   190			return false
   191		})
   192	
   193		return in, nil
   194	}
