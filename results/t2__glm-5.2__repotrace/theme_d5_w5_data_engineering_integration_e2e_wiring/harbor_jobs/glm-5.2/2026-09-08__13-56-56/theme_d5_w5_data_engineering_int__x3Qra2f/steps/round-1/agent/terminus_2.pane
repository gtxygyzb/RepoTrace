   158	type SortStage struct {
   159		keys []SortKey
   160	}
   161	
   162	func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   163		for _, key := range s.keys {
   164			if key.As == "number" {
   165				for _, r := range in {
   166					v, ok := r.Get(key.Column)
   167					if !ok || v == "" {
   168						continue
   169					}
   170					if _, err := parseFloat(v); err != nil {
   171						return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
   172					}
   173				}
   174			}
   175		}
   176	
   177		sort.SliceStable(in, func(i, j int) bool {
   178			for _, key := range s.keys {
   179				a, aok := in[i].Get(key.Column)
   180				b, bok := in[j].Get(key.Column)
   181	
   182				if key.As == "number" {
   183					aMissing := !aok || a == ""
   184					bMissing := !bok || b == ""
   185					if aMissing != bMissing {
   186						if key.Order == "desc" {
   187							return bMissing
   188						}
   189						return aMissing
   190					}
   191					if aMissing {
   192						continue
   193					}
   194					af, errA := parseFloat(a)
   195					bf, errB := parseFloat(b)
   196					if errA != nil || errB != nil {
   197						return false
   198					}
   199					if af != bf {
   200						if key.Order == "desc" {
   201							return af > bf
   202						}
   203						return af < bf
   204					}
   205				} else {
   206					if a != b {
   207						if key.Order == "desc" {
   208							return a > b
   209						}
   210						return a < b
   211					}
   212				}
   213			}
   214			return false
   215		})
   216	
   217		return in, nil
   218	}
