    10	
    11	type dedupWhen struct {
    12		column string
    13		op     string
    14		value  string
    15	}
    16	
    17	type DedupStage struct {
    18		idx      int
    19		by       []string
    20		keep     string
    21		on       string
    22		fallback string
    23		when     *dedupWhen
    24	}
    25	
    26	type dedupItem struct {
    27		pos      int
    28		r        *record.Record
    29		sentinel bool
    30		finite   bool
    31		num      float64
    32	}
    33	
    34	type dedupGroup struct {
    35		key      string
    36		items    []dedupItem
    37		survivor *dedupItem
    38	}
    39	
    40	func (s *DedupStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    41		groups := map[string]*dedupGroup{}
    42		var groupOrder []*dedupGroup
    43	
    44		for pos, r := range in {
    45			if s.when != nil && !s.matchesWhen(r) {
    46				continue
    47			}
    48	
    49			key, err := s.groupKey(r)
    50			if err != nil {
    51				return nil, err
    52			}
    53	
    54			item := dedupItem{pos: pos, r: r}
    55			if s.keep == "min" || s.keep == "max" {
    56				v, ok := r.Get(s.on)
    57				if !ok || v == "" {
    58					item.sentinel = true
    59				} else {
    60					f, err := parseFloat(v)
    61					if err != nil {
    62						return nil, fmt.Errorf("dedup: column %s value %q is not a number", s.on, v)
    63					}
    64					item.finite = true
    65					item.num = f
    66				}
    67			}
    68	
    69			g, ok := groups[key]
    70			if !ok {
    71				g = &dedupGroup{key: key}
    72				groups[key] = g
    73				groupOrder = append(groupOrder, g)
    74			}
    75			g.items = append(g.items, item)
    76		}
    77	
    78		for _, g := range groupOrder {
    79			survivor, err := s.pickSurvivor(g)
    80			if err != nil {
    81				return nil, err
    82			}
    83			g.survivor = survivor
    84		}
    85	
    86		survivorsByPos := map[int]*record.Record{}
    87		for _, g := range groupOrder {
    88			if g.survivor != nil {
    89				survivorsByPos[g.survivor.pos] = g.survivor.r
    90			}
    91		}
    92	
    93		out := make([]*record.Record, 0, len(in))
    94		for i, r := range in {
    95			if s.when != nil && !s.matchesWhen(r) {
    96				out = append(out, r)
    97				continue
    98			}
    99			if sr, ok := survivorsByPos[i]; ok {
   100				out = append(out, sr)
   101			}
   102		}
   103		return out, nil
   104	}
   105	
   106	func (s *DedupStage) matchesWhen(r *record.Record) bool {
   107		v, ok := r.Get(s.when.column)
   108		if !ok {
   109			return false
   110		}
   111		switch s.when.op {
   112		case "==":
   113			return v == s.when.value
   114		case "!=":
   115			return v != s.when.value
   116		default:
   117			left, err := parseFloat(v)
   118			if err != nil {
   119				return false
   120			}
   121			right, err := parseFloat(s.when.value)
   122			if err != nil {
   123				return false
   124			}
   125			return compareFloats(left, s.when.op, right)
   126		}
   127	}
   128	
   129	func (s *DedupStage) groupKey(r *record.Record) (string, error) {
   130		parts := make([]string, len(s.by)*2)
   131		for i, col := range s.by {
   132			v, ok := r.Get(col)
   133			if !ok {
   134				return "", fmt.Errorf("dedup: missing by column %s", col)
   135			}
   136			parts[i*2] = col
   137			parts[i*2+1] = v
   138		}
   139		return strings.Join(parts, "\x00"), nil
   140	}
   141	
   142	func (s *DedupStage) pickSurvivor(g *dedupGroup) (*dedupItem, error) {
   143		switch s.keep {
   144		case "first":
   145			return &g.items[0], nil
   146		case "last":
   147			return &g.items[len(g.items)-1], nil
   148		case "unique":
   149			if len(g.items) == 1 {
   150				return &g.items[0], nil
   151			}
   152			return nil, nil
   153		case "min", "max":
   154			return s.pickNumeric(g)
   155		}
   156		return nil, nil
   157	}
   158	
   159	func (s *DedupStage) pickNumeric(g *dedupGroup) (*dedupItem, error) {
   160		var best *dedupItem
   161		for i := range g.items {
   162			item := &g.items[i]
   163			if !item.finite {
   164				continue
   165			}
   166			if best == nil || s.isBetterNumeric(item.num, best.num) {
   167				best = item
   168			} else if item.num == best.num {
   169				if s.fallback == "last" {
   170					best = item
   171				}
   172			}
   173		}
   174	
   175		if best != nil {
   176			return best, nil
   177		}
   178	
   179		if s.fallback == "last" {
   180			return &g.items[len(g.items)-1], nil
   181		}
   182		return &g.items[0], nil
   183	}
   184	
   185	func (s *DedupStage) isBetterNumeric(candidate, current float64) bool {
   186		if s.keep == "min" {
   187			return candidate < current
   188		}
   189		return candidate > current
   190	}
