    68	
    69	func (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    70		out := make([]*record.Record, 0, len(in))
    71	
    72		for _, r := range in {
    73			v, ok := r.Get(s.column)
    74			if !ok {
    75				stats.DroppedMissing++
    76				if !stats.missingReported {
    77					fmt.Fprintf(stderr, "flowctl: filter: missing column %s\n", s.column)
    78					stats.missingReported = true
    79				}
    80				if strict {
    81					return nil, fmt.Errorf("filter: missing column %s", s.column)
    82				}
    83				continue
    84			}
    85	
    86			keep := false
    87			switch s.op {
    88			case "==":
    89				keep = v == s.value
    90			case "!=":
    91				keep = v != s.value
    92			default:
    93				left, err := parseFloat(v)
    94				if err != nil {
    95					stats.DroppedNonNumeric++
    96					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
    97					if strict {
    98						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
    99					}
   100					continue
   101				}
   102				right, err := parseFloat(s.value)
   103				if err != nil {
   104					stats.DroppedNonNumeric++
   105					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
   106					if strict {
   107						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   108					}
   109					continue
   110				}
   111				keep = compareFloats(left, s.op, right)
   112			}
   113	
   114			if keep {
   115				out = append(out, r)
   116			}
   117		}
   118	
   119		return out, nil
   120	}
