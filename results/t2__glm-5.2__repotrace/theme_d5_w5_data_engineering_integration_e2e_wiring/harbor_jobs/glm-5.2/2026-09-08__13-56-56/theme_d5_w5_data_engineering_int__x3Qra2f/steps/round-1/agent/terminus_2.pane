   106	func (s *DedupStage) matchesWhen(r *record.Record) bool {
   107		v, ok := r.Get(s.when.column)
   108		if !ok {
   109			return false
   110		}
   111		switch s.when.op {
   112		case "==":
   113			return v == s.when.value
   114		case "!=":
   115			return v != s.when.value
   116		default:
   117			left, err := parseFloat(v)
   118			if err != nil {
   119				return false
   120			}
   121			right, err := parseFloat(s.when.value)
   122			if err != nil {
   123				return false
   124			}
   125			return compareFloats(left, s.when.op, right)
   126		}
   127	}
   128	
   129	func (s *DedupStage) groupKey(r *record.Record) (string, error) {
   130		parts := make([]string, len(s.by)*2)
   131		for i, col := range s.by {
   132			v, ok := r.Get(col)
   133			if !ok {
   134				return "", fmt.Errorf("dedup: missing by column %s", col)
   135			}
   136			parts[i*2] = col
   137			parts[i*2+1] = v
   138		}
   139		return strings.Join(parts, "\x00"), nil
   140	}
   141	
   142	func (s *DedupStage) pickSurvivor(g *dedupGroup) (*dedupItem, error) {
   143		switch s.keep {
   144		case "first":
   145			return &g.items[0], nil
   146		case "last":
   147			return &g.items[len(g.items)-1], nil
   148		case "unique":
   149			if len(g.items) == 1 {
   150				return &g.items[0], nil
   151			}
   152			return nil, nil
   153		case "min", "max":
   154			return s.pickNumeric(g)
   155		}
   156		return nil, nil
   157	}
   158	
   159	func (s *DedupStage) pickNumeric(g *dedupGroup) (*dedupItem, error) {
   160		var best *dedupItem
   161		for i := range g.items {
   162			item := &g.items[i]
   163			if !item.finite {
   164				continue
   165			}
   166			if best == nil || s.isBetterNumeric(item.num, best.num) {
   167				best = item
   168			} else if item.num == best.num {
   169				if s.fallback == "last" {
   170					best = item
   171				}
   172			}
   173		}
   174	
   175		if best != nil {
   176			return best, nil
   177		}
   178	
   179		if s.fallback == "last" {
   180			return &g.items[len(g.items)-1], nil
   181		}
   182		return &g.items[0], nil
   183	}
   184	
   185	func (s *DedupStage) isBetterNumeric(candidate, current float64) bool {
   186		if s.keep == "min" {
   187			return candidate < current
   188		}
   189		return candidate > current
   190	}
   191	
   192	func buildDedup(idx int, sm map[string]interface{}) (Stage, error) {
   193		byRaw, ok := sm["by"]
   194		if !ok {
   195			return nil, fmt.Errorf("config: dedup: by is required")
   196		}
   197		by, err := toStringList(byRaw)
   198		if err != nil {
   199			return nil, fmt.Errorf("config: dedup: by %v", err)
   200		}
   201		if len(by) == 0 {
   202			return nil, fmt.Errorf("config: dedup: by must be non-empty")
   203		}
   204		for _, col := range by {
   205			if col == "" {
   206				return nil, fmt.Errorf("config: dedup: by must be non-empty")
   207			}
   208		}
   209	
   210		keep := "first"
   211		if k, ok := getString(sm, "keep"); ok {
   212			if k == "" {
   213				return nil, fmt.Errorf("config: dedup: keep must be one of first, last, min, max, unique")
   214			}
   215			keep = k
   216		}
   217		switch keep {
   218		case "first", "last", "min", "max", "unique":
   219		default:
   220			return nil, fmt.Errorf("config: dedup: keep must be one of first, last, min, max, unique")
   221		}
   222	
   223		on := ""
   224		onPresent := false
   225		if onRaw, ok := sm["on"]; ok {
   226			onPresent = true
   227			if s, ok := onRaw.(string); ok {
   228				on = s
   229			} else {
   230				on = fmt.Sprintf("%v", onRaw)
   231			}
   232		}
   233		if keep == "min" || keep == "max" {
   234			if !onPresent || on == "" {
   235				return nil, fmt.Errorf("config: dedup: on is required for keep min or max")
   236			}
   237		} else if onPresent {
   238			return nil, fmt.Errorf("config: dedup: on is only allowed for keep min or max")
   239		}
   240	
   241		fallback := "first"
   242		fallbackPresent := false
   243		if fbRaw, ok := sm["fallback"]; ok {
   244			fallbackPresent = true
   245			fb, ok := fbRaw.(string)
   246			if !ok {
   247				fb = fmt.Sprintf("%v", fbRaw)
   248			}
   249			if fb == "" {
   250				return nil, fmt.Errorf("config: dedup: fallback must be first or last")
   251			}
   252			fallback = fb
   253		}
   254		if keep == "min" || keep == "max" {
   255			if fallback != "first" && fallback != "last" {
   256				return nil, fmt.Errorf("config: dedup: fallback must be first or last")
   257			}
   258		} else if fallbackPresent {
   259			return nil, fmt.Errorf("config: dedup: fallback is only allowed for keep min or max")
   260		}
