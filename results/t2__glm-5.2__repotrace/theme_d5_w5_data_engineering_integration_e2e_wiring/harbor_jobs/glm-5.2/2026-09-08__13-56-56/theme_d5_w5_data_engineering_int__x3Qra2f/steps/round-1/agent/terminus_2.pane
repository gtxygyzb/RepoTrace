				af, errA := parseFloat(a)
				bf, errB := parseFloat(b)
				if errA != nil || errB != nil {
					return false
				}
				if af != bf {
					if key.Order == "desc" {
						return af > bf
					}
					return af < bf
				}
			} else {
				aMissing := !aok || a == ""
				bMissing := !bok || b == ""
				if aMissing != bMissing {
					if key.Order == "desc" {
						return aMissing
					}
					return bMissing
				}
				if aMissing {
					continue
				}
				if a != b {
					if key.Order == "desc" {
						return a > b
					}
					return a < b
				}
			}
		}
		return false
	})
