[?2004l     1	package stage
     2	
     3	import (
     4		"fmt"
     5		"io"
     6		"math"
     7		"strconv"
     8		"strings"
     9	
    10		"example.com/flowctl/internal/record"
    11	)
    12	
    13	type GroupAggregate struct {
    14		As     string
    15		Op     string
    16		Column string
    17	}
    18	
    19	type GroupStage struct {
    20		by         []string
    21		aggregates []GroupAggregate
    22	}
    23	
    24	func (s *GroupStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    25		type groupState struct {
    26			keyParts []string
    27			firstRow int
    28			count    int
    29			numCount []int
    30			sums     []float64
    31			mins     []float64
    32			maxs     []float64
    33			hasMin   []bool
    34			hasMax   []bool
    35		}
    36	
    37		order := []string{}
    38		keys := map[string]*groupState{}
    39	
    40		for _, r := range in {
    41			keyParts := make([]string, len(s.by))
    42			for i, col := range s.by {
    43				v, ok := r.Get(col)
    44				if !ok {
    45					v = ""
    46				}
    47				keyParts[i] = v
    48			}
    49			key := strings.Join(keyParts, "\x00")
    50	
    51			st, exists := keys[key]
    52			if !exists {
    53				st = &groupState{
    54					keyParts: keyParts,
    55					firstRow: r.InputRow,
    56					sums:     make([]float64, len(s.aggregates)),
    57					mins:     make([]float64, len(s.aggregates)),
    58					maxs:     make([]float64, len(s.aggregates)),
    59					hasMin:   make([]bool, len(s.aggregates)),
    60					hasMax:   make([]bool, len(s.aggregates)),
    61					numCount: make([]int, len(s.aggregates)),
    62				}
    63				keys[key] = st
    64				order = append(order, key)
    65			}
    66			st.count++
    67	
    68			for i, agg := range s.aggregates {
    69				if agg.Op == "count" {
    70					continue
    71				}
    72	
    73				v, ok := r.Get(agg.Column)
    74				if !ok {
    75					continue
    76				}
    77				f, err := parseFloat(v)
    78				if err != nil {
    79					return nil, fmt.Errorf("group: non-numeric value in column %s at row %d", agg.Column, r.InputRow)
    80				}
    81	
    82				st.numCount[i]++
    83				st.numCount[i]++
    84				st.sums[i] += f
    85				if !st.hasMin[i] || f < st.mins[i] {
    86					st.mins[i] = f
    87					st.hasMin[i] = true
    88				}
    89				if !st.hasMax[i] || f > st.maxs[i] {
    90					st.maxs[i] = f
    91					st.hasMax[i] = true
    92				}
    93			}
    94		}
    95	
    96		out := make([]*record.Record, 0, len(order))
    97		for _, key := range order {
    98			st := keys[key]
    99			nr := record.New()
   100			nr.InputRow = st.firstRow
   101	
   102			for i, col := range s.by {
   103				nr.Set(col, st.keyParts[i])
   104			}
   105	
   106			for i, agg := range s.aggregates {
   107				switch agg.Op {
   108				case "count":
   109					nr.Set(agg.As, strconv.Itoa(st.count))
   110				case "sum":
   111					if st.numCount[i] == 0 {
   112						nr.Set(agg.As, "")
   113					} else {
   114						nr.Set(agg.As, formatFloat(st.sums[i]))
   115					}
   116				case "min":
   117					if st.numCount[i] == 0 {
   118						nr.Set(agg.As, "")
   119					} else {
   120						nr.Set(agg.As, formatFloat(st.mins[i]))
   121					}
   122				case "max":
   123					if st.numCount[i] == 0 {
   124						nr.Set(agg.As, "")
   125					} else {
   126						nr.Set(agg.As, formatFloat(st.maxs[i]))
   127					}
   128				case "avg":
   129					if st.numCount[i] == 0 {
   130						nr.Set(agg.As, "")
   131					} else {
   132						nr.Set(agg.As, formatFloat(st.sums[i]/float64(st.numCount[i])))
   133					}
   134				}
   135			}
   136	
   137			out = append(out, nr)
   138		}
   139	
   140		return out, nil
   141	}
   142	
   143	func buildGroup(idx int, sm map[string]interface{}) (Stage, error) {
   144		byRaw, ok := sm["by"]
   145		if !ok {
   146			return nil, fmt.Errorf("config: stage %d: group.by is required", idx)
   147		}
   148		by, err := toStringList(byRaw)
   149		if err != nil {
   150			return nil, fmt.Errorf("config: stage %d: group.by: %v", idx, err)
   151		}
   152		if len(by) == 0 {
   153			return nil, fmt.Errorf("config: stage %d: group.by must be non-empty", idx)
   154		}
   155	
   156		aggRaw, ok := sm["aggregates"]
   157		if !ok {
   158			return nil, fmt.Errorf("config: stage %d: group.aggregates is required", idx)
   159		}
   160		aggList, ok := aggRaw.([]interface{})
   161		if !ok {
   162			return nil, fmt.Errorf("config: stage %d: group.aggregates must be a list", idx)
   163		}
   164		if len(aggList) == 0 {
   165			return nil, fmt.Errorf("config: stage %d: group.aggregates must be non-empty", idx)
   166		}
   167	
   168		aggregates := make([]GroupAggregate, 0, len(aggList))
   169		seen := map[string]bool{}
   170		for i, item := range aggList {
   171			am, ok := item.(map[string]interface{})
   172			if !ok {
   173				return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d must be a mapping", idx, i+1)
   174			}
   175	
   176			name, ok := getString(am, "as")
   177			if !ok || name == "" {
   178				return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: as is required", idx, i+1)
   179			}
   180			if seen[name] {
   181				return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: duplicate as %q", idx, i+1, name)
   182			}
   183	
   184			op, ok := getString(am, "op")
   185			if !ok || op == "" {
   186				return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: op is required", idx, i+1)
   187			}
   188			switch op {
   189			case "count", "sum", "min", "max", "avg":
   190			default:
   191				return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: op must be count, sum, min, max, or avg", idx, i+1)
   192			}
   193	
   194			col, hasCol := getString(am, "column")
   195			if op == "count" {
   196				if hasCol {
   197					return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: column must not be present for count", idx, i+1)
   198				}
   199			} else {
   200				if !hasCol || col == "" {
   201					return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: column is required", idx, i+1)
   202				}
   203			}
   204	
   205			aggregates = append(aggregates, GroupAggregate{As: name, Op: op, Column: col})
   206			seen[name] = true
   207		}
   208	
   209		return &GroupStage{by: by, aggregates: aggregates}, nil
   210	}
   211	
   212	func toStringList(v interface{}) ([]string, error) {
   213		list, ok := v.([]interface{})
   214		if !ok {
   215			return nil, fmt.Errorf("must be a list of strings")
   216		}
   217		out := []string{}
   218		for i, item := range list {
   219			s, ok := item.(string)
   220			if !ok {
   221				return nil, fmt.Errorf("entry %d must be a string", i+1)
   222			}
   223			out = append(out, s)
   224		}
   225		return out, nil
   226	}
   227	
   228	func formatFloat(f float64) string {
   229		if math.IsNaN(f) || math.IsInf(f, 0) {
   230			return strconv.FormatFloat(f, 'g', -1, 64)
   231		}
   232		if f == float64(int64(f)) {
   233			return strconv.FormatInt(int64(f), 10)
   234		}
   235		return strconv.FormatFloat(f, 'g', -1, 64)
   236	}
