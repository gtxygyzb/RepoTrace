   308	func buildSort(idx int, sm map[string]interface{}) (Stage, error) {
   309		keysRaw, ok := sm["keys"]
   310		if !ok {
   311			return nil, fmt.Errorf("config: stage %d: sort.keys is required", idx)
   312		}
   313		list, ok := keysRaw.([]interface{})
   314		if !ok {
   315			return nil, fmt.Errorf("config: stage %d: sort.keys must be a list", idx)
   316		}
   317	
   318		keys := make([]SortKey, 0, len(list))
   319		for j, item := range list {
   320			km, ok := item.(map[string]interface{})
   321			if !ok {
   322				return nil, fmt.Errorf("config: stage %d: sort key %d must be a mapping", idx, j+1)
   323			}
   324	
   325			column, ok := getString(km, "column")
   326			if !ok || column == "" {
   327				return nil, fmt.Errorf("config: stage %d: sort key %d column is required", idx, j+1)
   328			}
   329	
   330			order, ok := getString(km, "order")
   331			if !ok || order == "" {
   332				order = "asc"
   333			}
   334			if order != "asc" && order != "desc" {
   335				return nil, fmt.Errorf("config: stage %d: sort key %d order must be asc or desc", idx, j+1)
   336			}
   337	
   338			as, ok := getString(km, "as")
   339			if !ok || as == "" {
   340				as = "string"
   341			}
   342			if as != "string" && as != "number" {
   343				return nil, fmt.Errorf("config: stage %d: sort key %d as must be string or number", idx, j+1)
   344			}
   345	
   346			keys = append(keys, SortKey{Column: column, Order: order, As: as})
   347		}
   348	
   349		return &SortStage{keys: keys}, nil
   350	}
