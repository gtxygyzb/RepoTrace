    65	type FilterStage struct {
    66		column string
    67		op     string
    68		value  string
    69	}
    70	
    71	func (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    72		out := make([]*record.Record, 0, len(in))
    73	
    74		for _, r := range in {
    75			v, ok := r.Get(s.column)
    76			if !ok {
    77				stats.DroppedMissing++
    78				if !stats.missingReported {
    79					fmt.Fprintf(stderr, "flowctl: filter: missing column %s\n", s.column)
    80					stats.missingReported = true
    81				}
    82				if strict {
    83					return nil, fmt.Errorf("filter: missing column %s", s.column)
    84				}
    85				continue
    86			}
    87	
    88			keep := false
    89			switch s.op {
    90			case "==":
    91				keep = v == s.value
    92			case "!=":
    93				keep = v != s.value
    94			default:
    95				left, err := parseFloat(v)
    96				if err != nil {
    97					stats.DroppedNonNumeric++
    98					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
    99					if strict {
   100						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   101					}
   102					continue
   103				}
   104				right, err := parseFloat(s.value)
   105				if err != nil {
   106					stats.DroppedNonNumeric++
   107					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
   108					if strict {
   109						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   110					}
   111					continue
   112				}
   113				keep = compareFloats(left, s.op, right)
   114			}
   115	
   116			if keep {
   117				out = append(out, r)
   118			}
   119		}
   120	
   121		return out, nil
   122	}
