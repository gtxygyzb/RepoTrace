   165	}
   166	
   167	func toStringList(v interface{}) ([]string, error) {
   168		list, ok := v.([]interface{})
   169		if !ok {
   170			return nil, fmt.Errorf("must be a list of strings")
   171		}
   172		out := []string{}
   173		for i, item := range list {
   174			s, ok := item.(string)
   175			if !ok {
   176				return nil, fmt.Errorf("entry %d must be a string", i+1)
   177			}
   178			out = append(out, s)
   179		}
   180		return out, nil
   181	}
