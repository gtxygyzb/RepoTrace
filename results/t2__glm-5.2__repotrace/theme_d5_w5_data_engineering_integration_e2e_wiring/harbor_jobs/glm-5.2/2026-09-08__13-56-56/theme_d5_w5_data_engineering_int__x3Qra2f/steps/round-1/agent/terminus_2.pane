   349	func getString(m map[string]interface{}, key string) (string, bool) {
   350		v, ok := m[key]
   351		if !ok {
   352			return "", false
   353		}
   354		if s, ok := v.(string); ok {
   355			return s, true
   356		}
   357		return fmt.Sprintf("%v", v), true
   358	}
   359	
   360	func parseFloat(s string) (float64, error) {
   361		f, err := strconv.ParseFloat(s, 64)
   362		if err != nil {
   363			return 0, err
   364		}
   365		if math.IsNaN(f) || math.IsInf(f, 0) {
   366			return 0, fmt.Errorf("not a finite number")
   367		}
   368		return f, nil
   369	}
   370	
   371	func compareFloats(left float64, op string, right float64) bool {
   372		switch op {
   373		case "<":
   374			return left < right
   375		case "<=":
   376			return left <= right
   377		case ">":
   378			return left > right
   379		case ">=":
   380			return left >= right
   381		}
   382		return false
   383	}
