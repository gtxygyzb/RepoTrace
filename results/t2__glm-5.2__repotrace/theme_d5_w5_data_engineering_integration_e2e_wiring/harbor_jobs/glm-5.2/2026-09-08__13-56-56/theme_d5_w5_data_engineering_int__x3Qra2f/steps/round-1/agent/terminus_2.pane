   159	
   160	func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   161		for _, key := range s.keys {
   162			if key.As == "number" {
   163				for _, r := range in {
   164					v, ok := r.Get(key.Column)
   165					if !ok || v == "" {
   166						continue
   167					}
   168					if _, err := parseFloat(v); err != nil {
   169						return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
   170					}
   171				}
   172			}
   173		}
   174	
   175		sort.SliceStable(in, func(i, j int) bool {
   176			for _, key := range s.keys {
   177				a, aok := in[i].Get(key.Column)
   178				b, bok := in[j].Get(key.Column)
   179	
   180				if key.As == "number" {
   181					aMissing := !aok || a == ""
   182					bMissing := !bok || b == ""
   183					if aMissing != bMissing {
   184						if key.Order == "desc" {
   185							return bMissing
   186						}
   187						return aMissing
   188					}
   189					if aMissing {
   190						continue
   191					}
   192					af, errA := parseFloat(a)
   193					bf, errB := parseFloat(b)
   194					if errA != nil || errB != nil {
   195						return false
   196					}
   197					if af != bf {
   198						if key.Order == "desc" {
   199							return af > bf
   200						}
   201						return af < bf
   202					}
   203				} else {
   204					if a != b {
   205						if key.Order == "desc" {
   206							return a > b
   207						}
   208						return a < b
   209					}
   210				}
   211			}
   212			return false
   213		})
   214	
   215		return in, nil
   216	}
