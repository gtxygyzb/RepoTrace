    12	
    13	type PivotStage struct {
    14		index        []string
    15		columns      string
    16		values       string
    17		asType       string
    18		agg          string
    19		fill         string
    20		sortColumns  string
    21		columnPrefix string
    22		strictSchema bool
    23		dropEmpty    bool
    24		onConflict   string
    25	}
    26	
    27	type pivotCell struct {
    28		count    int
    29		sum      float64
    30		min      float64
    31		max      float64
    32		hasNum   bool
    33		first    string
    34		last     string
    35		hasStr   bool
    36		contribs int
    37	}
    38	
    39	func (s *PivotStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    40		order := []string{}
    41		rows := map[string]*pivotRow{}
    42		colOrder := []string{}
    43		cols := map[string]bool{}
    44	
    45		for _, r := range in {
    46			idxParts := make([]string, len(s.index))
    47			for i, col := range s.index {
    48				v, ok := r.Get(col)
    49				if !ok {
    50					v = ""
    51				}
    52				idxParts[i] = v
    53			}
    54			idxKey := strings.Join(idxParts, "\x00")
    55	
    56			col, ok := r.Get(s.columns)
    57			if !ok {
    58				col = ""
    59			}
    60	
    61			row, exists := rows[idxKey]
    62			if !exists {
    63				row = &pivotRow{
    64					idxParts: idxParts,
    65					cells:    map[string]*pivotCell{},
    66				}
    67				rows[idxKey] = row
    68				order = append(order, idxKey)
    69			}
    70	
    71			if !cols[col] {
    72				cols[col] = true
    73				colOrder = append(colOrder, col)
    74			}
    75	
    76			cell, exists := row.cells[col]
    77			if !exists {
    78				cell = &pivotCell{}
    79				row.cells[col] = cell
    80			}
    81			cell.contribs++
    82	
    83			switch s.agg {
    84			case "count":
    85				cell.count++
    86			case "sum", "min", "max", "avg":
    87				v, ok := r.Get(s.values)
    88				if !ok || v == "" {
    89					continue
    90				}
    91				f, err := parseFloat(v)
    92				if err != nil {
    93					return nil, fmt.Errorf("pivot: non-numeric value in column %s at row %d", s.values, r.InputRow)
    94				}
    95				cell.count++
    96				cell.sum += f
    97				if !cell.hasNum || f < cell.min {
    98					cell.min = f
    99				}
   100				if !cell.hasNum || f > cell.max {
   101					cell.max = f
   102				}
   103				cell.hasNum = true
   104			case "first", "last":
   105				v, ok := r.Get(s.values)
   106				if !ok {
   107					v = ""
   108				}
   109				if s.onConflict == "error" && cell.contribs > 1 {
   110					return nil, fmt.Errorf("pivot: duplicate contributor for cell %s/%s", strings.Join(row.idxParts, "|"), col)
   111				}
   112				if !cell.hasStr {
   113					cell.first = v
   114					cell.hasStr = true
   115				}
   116				cell.last = v
   117			}
   118		}
   119	
   120		sortedCols := s.sortPivotColumns(colOrder)
   121	
   122		out := make([]*record.Record, 0, len(order))
   123		for _, idxKey := range order {
   124			row := rows[idxKey]
   125	
   126			allEmpty := true
   127			for _, col := range sortedCols {
   128				cell := row.cells[col]
   129				if cell != nil && cell.contribs > 0 {
   130					allEmpty = false
   131					break
   132				}
   133			}
   134			if s.dropEmpty && allEmpty {
   135				continue
   136			}
   137	
   138			nr := record.New()
   139			nr.InputRow = 0
   140			for i, col := range s.index {
   141				nr.Set(col, row.idxParts[i])
   142			}
   143	
   144			for _, col := range sortedCols {
   145				name := s.columnPrefix + col
   146				cell := row.cells[col]
   147				val, hadContrib := s.finalizeCell(cell)
   148				if s.strictSchema && !hadContrib {
   149					return nil, fmt.Errorf("pivot: row %s missing pivot value %s", strings.Join(row.idxParts, "|"), col)
   150				}
   151				if !hadContrib {
   152					val = s.fill
   153				}
   154				nr.Set(name, val)
   155			}
   156	
   157			out = append(out, nr)
   158		}
   159	
   160		return out, nil
   161	}
   162	
   163	type pivotRow struct {
   164		idxParts []string
   165		cells    map[string]*pivotCell
   166	}
   167	
   168	func (s *PivotStage) finalizeCell(cell *pivotCell) (string, bool) {
   169		if cell == nil || cell.contribs == 0 {
   170			return "", false
   171		}
   172		switch s.agg {
   173		case "count":
   174			return strconv.Itoa(cell.count), true
   175		case "sum":
   176			if cell.count == 0 {
   177				return "", false
   178			}
   179			return formatFloat(cell.sum), true
   180		case "min":
   181			if cell.count == 0 {
   182				return "", false
   183			}
   184			return formatFloat(cell.min), true
   185		case "max":
   186			if cell.count == 0 {
   187				return "", false
   188			}
   189			return formatFloat(cell.max), true
   190		case "avg":
   191			if cell.count == 0 {
   192				return "", false
   193			}
   194			return formatFloat(cell.sum / float64(cell.count)), true
   195		case "first":
   196			return cell.first, true
   197		case "last":
   198			return cell.last, true
   199		}
   200		return "", false
   201	}
   202	
   203	func (s *PivotStage) sortPivotColumns(colOrder []string) []string {
   204		out := make([]string, len(colOrder))
   205		copy(out, colOrder)
   206		switch s.sortColumns {
   207		case "asc":
   208			sort.Slice(out, func(i, j int) bool { return out[i] < out[j] })
   209		case "desc":
   210			sort.Slice(out, func(i, j int) bool { return out[i] > out[j] })
   211		case "ingest":
   212		}
   213		return out
   214	}
   215	
   216	func buildPivot(idx int, sm map[string]interface{}) (Stage, error) {
   217		indexRaw, ok := sm["index"]
   218		if !ok {
   219			return nil, fmt.Errorf("config: pivot: index must be a non-empty list")
   220		}
   221		index, err := toStringList(indexRaw)
   222		if err != nil {
   223			return nil, fmt.Errorf("config: pivot: index %v", err)
   224		}
   225		if len(index) == 0 {
   226			return nil, fmt.Errorf("config: pivot: index must be a non-empty list")
   227		}
   228		for _, col := range index {
   229			if col == "" {
   230				return nil, fmt.Errorf("config: pivot: index must be a non-empty list")
   231			}
   232		}
   233	
   234		columns, ok := getString(sm, "columns")
   235		if !ok || columns == "" {
   236			return nil, fmt.Errorf("config: pivot: columns is required")
   237		}
   238	
   239		values, ok := getString(sm, "values")
   240		if !ok || values == "" {
   241			return nil, fmt.Errorf("config: pivot: values is required")
   242		}
   243	
   244		asType, ok := getString(sm, "as")
   245		if !ok || asType == "" {
   246			return nil, fmt.Errorf("config: pivot: as is required")
   247		}
   248		if asType != "string" && asType != "number" {
   249			return nil, fmt.Errorf("config: pivot: as must be string or number")
   250		}
   251	
   252		agg, ok := getString(sm, "agg")
   253		if !ok || agg == "" {
   254			return nil, fmt.Errorf("config: pivot: agg is required")
   255		}
   256		switch agg {
   257		case "sum", "min", "max", "avg", "count", "first", "last":
   258		default:
   259			return nil, fmt.Errorf("config: pivot: unknown agg %q", agg)
   260		}
