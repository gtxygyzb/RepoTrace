[?2004hroot@n30009:/app# sed -n '1,64p' internal/stage/stage.go
[?2004lpackage stage

import (
	"fmt"
	"io"
	"math"
	"sort"
	"strconv"

	"example.com/flowctl/internal/record"
)

type Stats struct {
	Processed         int
	Emitted           int
	DroppedNonNumeric int
	DroppedMissing    int
	missingReported   bool
}

type Stage interface {
	Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error)
}

func Build(rawStages []map[string]interface{}) ([]Stage, error) {
	return BuildWithDir(rawStages, "")
}

func BuildWithDir(rawStages []map[string]interface{}, dir string) ([]Stage, error) {
	stages := make([]Stage, 0, len(rawStages))
	for i, sm := range rawStages {
		typ, ok := getString(sm, "type")
		if !ok || typ == "" {
			return nil, fmt.Errorf("config: stage %d: type is required", i+1)
		}

		var st Stage
		var err error
		switch typ {
		case "filter":
			st, err = buildFilter(i+1, sm)
		case "project":
			st, err = buildProject(i+1, sm)
		case "sort":
			st, err = buildSort(i+1, sm)
		case "limit":
			st, err = buildLimit(i+1, sm)
		case "group":
			st, err = buildGroup(i+1, sm)
		case "join":
			st, err = buildJoin(i+1, sm, dir)
		case "dedup":
			st, err = buildDedup(i+1, sm)
		default:
			return nil, fmt.Errorf("config: stage %d: unknown stage type %q", i+1, typ)
		}
		if err != nil {
			return nil, err
		}
		stages = append(stages, st)
	}
	return stages, nil
}

