   129	                if !ok {
   130	                        return nil, fmt.Errorf("config: stage %d: bucket: edges must have at least two entries", idx)
   131	                }
   132	                if len(list) < 2 {
   133	                        return nil, fmt.Errorf("config: stage %d: bucket: edges must have at least two entries", idx)
   134	                }
   135	                edges = make([]float64, 0, len(list))
   136	                for i, item := range list {
   137	                        es, ok := item.(string)
   138	                        if !ok {
   139	                                es = fmt.Sprintf("%v", item)
   140	                        }
   141	                        f, err := parseFloat(es)
   142	                        if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {
   143	                                return nil, fmt.Errorf("config: stage %d: bucket: edges[%d] is not a finite number", idx, i)
   144	                        }
   145	                        if i > 0 && f <= edges[i-1] {
   146	                                return nil, fmt.Errorf("config: stage %d: bucket: edges must be strictly increasing", idx)
   147	                        }
   148	                        edges = append(edges, f)
   149	                }
   150	                labelCount = len(edges) - 1
   151	        }
   152	
   153	        for i := 1; i < len(edges); i++ {
   154	                if edges[i] <= edges[i-1] {
   155	                        return nil, fmt.Errorf("config: stage %d: bucket: edges must be strictly increasing", idx)
   156	        }
   157	        }
   158	
   159	        autoLabels = make([]string, labelCount)
   160	        for i := 0; i < labelCount; i++ {
   161	                a := formatFloat(edges[i])
   162	                b := formatFloat(edges[i+1])
   163	                if inclusive == "left" {
   164	                        autoLabels[i] = "[" + a + ", " + b + ")"
   165	                } else {
   166	                        autoLabels[i] = "(" + a + ", " + b + "]"
   167	                }
   168	        }
   169	        first := formatFloat(edges[0])
   170	        last := formatFloat(edges[len(edges)-1])
   171	        if inclusive == "left" {
   172	                underAuto = "(-inf, " + first + ")"
   173	                overAuto = "[" + last + ", +inf)"
   174	        } else {
   175	                underAuto = "(-inf, " + first + "]"
   176	                overAuto = "(" + last + ", +inf)"
   177	        }
   178	
   179	        labels := autoLabels
   180	        if labelsRaw, ok := sm["labels"]; ok {
   181	                list, ok := labelsRaw.([]interface{})
   182	                if !ok {
   183	                        return nil, fmt.Errorf("config: stage %d: bucket: labels length 0 does not match edges-1 %d", idx, labelCount)
   184	                }
   185	                if len(list) != labelCount {
   186	                        return nil, fmt.Errorf("config: stage %d: bucket: labels length %d does not match edges-1 %d", idx, len(list), labelCount)
   187	                }
   188	                labels = make([]string, labelCount)
   189	                seen := map[string]bool{}
   190	                for i, item := range list {
   191	                        ls, ok := item.(string)
   192	                        if !ok {
   193	                                ls = fmt.Sprintf("%v", item)
   194	                        }
   195	                        if ls == "" {
   196	                                return nil, fmt.Errorf("config: stage %d: bucket: labels[%d] must be a non-empty string", idx, i)
   197	                        }
   198	                        if seen[ls] {
   199	                                return nil, fmt.Errorf("config: stage %d: bucket: labels has duplicate entry %s", idx, ls)
   200	                        }
   201	                        seen[ls] = true
   202	                        labels[i] = ls
   203	                }
   204	        }
   205	
   206	        underLabel := underAuto
   207	        if s, ok := getString(sm, "under_label"); ok {
   208	                if s == "" {
   209	                        return nil, fmt.Errorf("config: stage %d: bucket: under_label must be a non-empty string", idx)
   210	                }
   211	                for _, label := range labels {
   212	                        if s == label {
   213	                                return nil, fmt.Errorf("config: stage %d: bucket: under_label collides with labels entry %s", idx, s)
   214	                        }
   215	                }
   216	                underLabel = s
   217	        }
   218	        overLabel := overAuto
   219	        if s, ok := getString(sm, "over_label"); ok {
   220	                if s == "" {
   221	                        return nil, fmt.Errorf("config: stage %d: bucket: over_label must be a non-empty string", idx)
   222	                }
   223	                for _, label := range labels {
   224	                        if s == label {
   225	                                return nil, fmt.Errorf("config: stage %d: bucket: over_label collides with labels entry %s", idx, s)
   226	                        }
   227	                }
   228	                overLabel = s
   229	        }
   230	
   231	        return &BucketStage{
   232	                column:        column,
   233	                into:          into,
   234	                edges:        edges,
   235	                labels:       labels,
   236	                underLabel:   underLabel,
