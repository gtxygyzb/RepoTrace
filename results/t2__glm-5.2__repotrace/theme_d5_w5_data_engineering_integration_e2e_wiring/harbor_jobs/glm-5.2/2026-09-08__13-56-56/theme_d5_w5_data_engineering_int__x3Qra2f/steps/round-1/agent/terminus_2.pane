   182	
   183	type yamlLine struct {
   184		indent int
   185		text   string
   186	}
   187	
   188	func parseYAML(data []byte) (interface{}, error) {
   189		lines := []yamlLine{}
   190		scanner := bufio.NewScanner(bytes.NewReader(data))
   191		for scanner.Scan() {
   192			raw := scanner.Text()
   193			line := stripComment(raw)
   194			if strings.TrimSpace(line) == "" {
   195				continue
   196			}
   197			indent := 0
   198			for indent < len(line) && line[indent] == ' ' {
   199				indent++
   200			}
   201			if indent < len(line) && line[indent] == '\t' {
   202				return nil, fmt.Errorf("tabs are not allowed for indentation")
   203			}
   204			text := strings.TrimRight(line[indent:], " \t")
   205			lines = append(lines, yamlLine{indent: indent, text: text})
   206		}
   207		if err := scanner.Err(); err != nil {
   208			return nil, err
   209		}
   210		if len(lines) == 0 {
   211			return nil, nil
   212		}
   213		val, _, err := parseNode(lines, 0, lines[0].indent)
   214		return val, err
   215	}
   216	
   217	func parseNode(lines []yamlLine, start, indent int) (interface{}, int, error) {
   218		if start >= len(lines) || lines[start].indent < indent {
   219			return nil, start, nil
   220		}
   221		if isSequenceLine(lines[start].text) {
   222			return parseSequence(lines, start, indent)
   223		}
   224		return parseMapping(lines, start, indent)
   225	}
   226	
   227	func isSequenceLine(text string) bool {
   228		return text == "-" || strings.HasPrefix(text, "- ")
   229	}
   230	
   231	func parseMapping(lines []yamlLine, start, indent int) (map[string]interface{}, int, error) {
   232		m := map[string]interface{}{}
   233		i := start
   234		for i < len(lines) {
   235			if lines[i].indent < indent {
   236				break
   237			}
   238			if lines[i].indent > indent {
   239				return nil, i, fmt.Errorf("unexpected indentation in mapping")
   240			}
   241			if isSequenceLine(lines[i].text) {
   242				break
   243			}
   244	
   245			key, val, err := splitKeyValue(lines[i].text)
   246			if err != nil {
   247				return nil, i, err
   248			}
   249	
   250			if val == "" {
   251				if i+1 < len(lines) {
   252					next := lines[i+1]
   253					if next.indent > indent {
   254						child, next2, err := parseNode(lines, i+1, next.indent)
   255						if err != nil {
   256							return nil, 0, err
   257						}
   258						m[key] = child
   259						i = next2
   260						continue
   261					}
   262					if next.indent == indent && isSequenceLine(next.text) {
   263						child, next2, err := parseSequence(lines, i+1, indent)
   264						if err != nil {
   265							return nil, 0, err
   266						}
   267						m[key] = child
   268						i = next2
   269						continue
   270					}
   271				}
   272				m[key] = nil
   273				i++
   274				continue
   275			}
   276	
   277			v, err := parseFlowOrScalar(val)
   278			if err != nil {
   279				return nil, 0, err
   280			}
   281			m[key] = v
   282			i++
   283		}
   284		return m, i, nil
   285	}
   286	
   287	func parseSequence(lines []yamlLine, start, indent int) ([]interface{}, int, error) {
   288		items := []interface{}{}
   289		i := start
   290		for i < len(lines) {
   291			if lines[i].indent < indent {
   292				break
   293			}
   294			if lines[i].indent > indent {
   295				return nil, i, fmt.Errorf("unexpected indentation in sequence")
   296			}
   297			if !isSequenceLine(lines[i].text) {
   298				break
   299			}
   300	
   301			content := strings.TrimSpace(strings.TrimPrefix(lines[i].text, "-"))
   302			if content == "" {
   303				if i+1 < len(lines) && lines[i+1].indent > indent {
   304					child, next, err := parseNode(lines, i+1, lines[i+1].indent)
   305					if err != nil {
   306						return nil, 0, err
   307					}
   308					items = append(items, child)
   309					i = next
   310					continue
   311				}
   312				items = append(items, nil)
   313				i++
   314				continue
   315			}
   316	
   317			if strings.HasPrefix(content, "[") || strings.HasPrefix(content, "{") {
   318				v, err := parseFlow(content)
   319				if err != nil {
   320					return nil, 0, err
   321				}
   322				items = append(items, v)
   323				i++
   324				continue
   325			}
   326	
   327			if isMappingLine(content) {
   328				afterDash := strings.TrimPrefix(lines[i].text, "-")
   329				leading := len(afterDash) - len(strings.TrimLeft(afterDash, " "))
   330				effIndent := indent + 1 + leading
   331				sublines := []yamlLine{{indent: effIndent, text: content}}
   332				j := i + 1
   333				for j < len(lines) && lines[j].indent >= effIndent {
   334					sublines = append(sublines, lines[j])
   335					j++
   336				}
   337				child, _, err := parseMapping(sublines, 0, effIndent)
   338				if err != nil {
   339					return nil, 0, err
   340				}
   341				items = append(items, child)
   342				i = j
   343				continue
   344			}
   345	
   346			v, err := parseFlowOrScalar(content)
   347			if err != nil {
   348				return nil, 0, err
   349			}
   350			items = append(items, v)
   351			i++
   352		}
   353		return items, i, nil
   354	}
   355	
   356	func isMappingLine(text string) bool {
   357		_, _, err := splitKeyValue(text)
   358		return err == nil
   359	}
