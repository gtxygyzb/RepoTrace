func buildFilter(idx int, sm map[string]interface{}) (Stage, error) {
	whereRaw, ok := sm["where"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: filter.where is required", idx)
	}
	where, ok := whereRaw.(map[string]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stage %d: filter.where must be a mapping", idx)
	}

	column, ok := getString(where, "column")
	if !ok || column == "" {
		return nil, fmt.Errorf("config: stage %d: filter.where.column is required", idx)
	}

	op, ok := getString(where, "op")
	if !ok || op == "" {
		return nil, fmt.Errorf("config: stage %d: filter.where.op is required", idx)
	}
	switch op {
	case "==", "!=", "<", "<=", ">", ">=":
	default:
		return nil, fmt.Errorf("config: stage %d: filter.where.op is invalid", idx)
	}

	value, ok := getString(where, "value")
	if !ok {
		return nil, fmt.Errorf("config: stage %d: filter.where.value is required", idx)
	}

	return &FilterStage{column: column, op: op, value: value}, nil
}

func buildProject(idx int, sm map[string]interface{}) (Stage, error) {
	colsRaw, ok := sm["columns"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: project.columns is required", idx)
	}
	list, ok := colsRaw.([]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stage %d: project.columns must be a list", idx)
	}

	columns := make([]ProjectColumn, 0, len(list))
	seen := map[string]bool{}
	for j, item := range list {
		switch v := item.(type) {
		case string:
			if seen[v] {
				return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, v)
			}
			seen[v] = true
			columns = append(columns, ProjectColumn{Source: v, Target: v})
		case map[string]interface{}:
			name, ok := getString(v, "name")
			if !ok || name == "" {
				return nil, fmt.Errorf("config: stage %d: project column %d name is required", idx, j+1)
			}
			as, ok := getString(v, "as")
			if !ok || as == "" {
				return nil, fmt.Errorf("config: stage %d: project column %d as is required", idx, j+1)
			}
			if seen[as] {
				return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, as)
			}
			seen[as] = true
			columns = append(columns, ProjectColumn{Source: name, Target: as})
		default:
			return nil, fmt.Errorf("config: stage %d: project column %d must be a string or mapping", idx, j+1)
		}
	}

	return &ProjectStage{columns: columns}, nil
}

func buildSort(idx int, sm map[string]interface{}) (Stage, error) {
	keysRaw, ok := sm["keys"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: sort.keys is required", idx)
	}
	list, ok := keysRaw.([]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stage %d: sort.keys must be a list", idx)
	}

	keys := make([]SortKey, 0, len(list))
	for j, item := range list {
		km, ok := item.(map[string]interface{})
		if !ok {
			return nil, fmt.Errorf("config: stage %d: sort key %d must be a mapping", idx, j+1)
		}

		column, ok := getString(km, "column")
		if !ok || column == "" {
			return nil, fmt.Errorf("config: stage %d: sort key %d column is required", idx, j+1)
		}

		order, ok := getString(km, "order")
		if !ok || order == "" {
			order = "asc"
		}
		if order != "asc" && order != "desc" {
			return nil, fmt.Errorf("config: stage %d: sort key %d order must be asc or desc", idx, j+1)
		}

		as, ok := getString(km, "as")
		if !ok || as == "" {
			as = "string"
		}
		if as != "string" && as != "number" {
			return nil, fmt.Errorf("config: stage %d: sort key %d as must be string or number", idx, j+1)
		}

		keys = append(keys, SortKey{Column: column, Order: order, As: as})
	}

	return &SortStage{keys: keys}, nil
}

func buildLimit(idx int, sm map[string]interface{}) (Stage, error) {
	countRaw, ok := sm["count"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: limit.count is required", idx)
	}
	countStr, ok := countRaw.(string)
	if !ok {
		return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
	}
	n, err := strconv.Atoi(countStr)
	if err != nil || n < 0 {
		return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
	}

	return &LimitStage{count: n}, nil
}

func getString(m map[string]interface{}, key string) (string, bool) {
	v, ok := m[key]
	if !ok {
		return "", false
	}
	if s, ok := v.(string); ok {
		return s, true
	}
	return fmt.Sprintf("%v", v), true
}

func getBool(m map[string]interface{}, key string) (bool, bool, error) {
	v, ok := m[key]
	if !ok {
		return false, false, nil
	}
	switch b := v.(type) {
	case bool:
		return b, true, nil
	case string:
		if b == "true" {
			return true, true, nil
		}
		if b == "false" {
			return false, true, nil
		}
		return false, true, fmt.Errorf("%s must be a boolean", key)
	default:
		return false, true, fmt.Errorf("%s must be a boolean", key)
	}
}

func parseFloat(s string) (float64, error) {
	f, err := strconv.ParseFloat(s, 64)
	if err != nil {
		return 0, err
	}
	if math.IsNaN(f) || math.IsInf(f, 0) {
		return 0, fmt.Errorf("not a finite number")
	}
	return f, nil
}

func compareFloats(left float64, op string, right float64) bool {
	switch op {
	case "<":
		return left < right
	case "<=":
		return left <= right
