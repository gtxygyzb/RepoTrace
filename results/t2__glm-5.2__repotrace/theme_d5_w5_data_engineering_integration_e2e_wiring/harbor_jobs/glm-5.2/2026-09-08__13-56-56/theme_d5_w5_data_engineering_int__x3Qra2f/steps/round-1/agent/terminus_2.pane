    69			}
    70			buf.WriteString(encodeJSONString(val))
    71		}
    72		buf.WriteByte('}')
    73	}
    74	
    75	func encodeJSONString(s string) string {
    76		var b strings.Builder
    77		b.WriteByte('"')
    78		for i := 0; i < len(s); i++ {
    79			c := s[i]
    80			switch c {
    81			case '\\':
    82				b.WriteString("\\\\")
    83			case '"':
    84				b.WriteString("\\\"")
    85			case '\n':
    86				b.WriteString("\\n")
    87			case '\r':
    88				b.WriteString("\\r")
    89			case '\t':
    90				b.WriteString("\\t")
    91			default:
    92				if c < 0x20 {
    93					fmt.Fprintf(&b, "\\u%04x", c)
    94				} else {
    95					b.WriteByte(c)
    96				}
    97			}
    98		}
    99		b.WriteByte('"')
   100		return b.String()
   101	}
