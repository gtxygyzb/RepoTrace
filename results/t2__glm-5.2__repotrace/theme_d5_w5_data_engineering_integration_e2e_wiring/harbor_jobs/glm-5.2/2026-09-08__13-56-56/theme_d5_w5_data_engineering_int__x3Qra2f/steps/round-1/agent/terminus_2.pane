    15	
    16	func Read(cfg config.InputConfig, dir string) ([]*record.Record, error) {
    17		switch cfg.Format {
    18		case "csv":
    19			return readCSV(cfg, dir)
    20		case "ndjson":
    21			return readNDJSON(cfg, dir)
    22		case "sqlite":
    23			return readSQLite(cfg, dir)
    24		default:
    25			return nil, fmt.Errorf("input: unsupported format %q", cfg.Format)
    26		}
    27	}
    28	
    29	func readCSV(cfg config.InputConfig, dir string) ([]*record.Record, error) {
    30		path := config.ResolvePath(dir, cfg.Path)
    31		f, err := os.Open(path)
    32		if err != nil {
    33			return nil, fmt.Errorf("input: %v", err)
    34		}
    35		defer f.Close()
    36	
    37		r := csv.NewReader(f)
    38		r.FieldsPerRecord = 0
    39		r.TrimLeadingSpace = true
    40	
    41		header, err := r.Read()
    42		if err == io.EOF {
    43			return nil, fmt.Errorf("input: empty CSV file")
    44		}
    45		if err != nil {
    46			return nil, fmt.Errorf("input: %v", err)
    47		}
    48	
    49		records := []*record.Record{}
    50		rowNum := 0
    51		for {
    52			row, err := r.Read()
    53			if err == io.EOF {
    54				break
    55			}
    56			if err != nil {
    57				return nil, fmt.Errorf("input: row %d: %v", rowNum+2, err)
    58			}
    59			rowNum++
    60	
    61			if len(row) != len(header) {
    62				return nil, fmt.Errorf("input: row %d: expected %d fields got %d", rowNum+1, len(header), len(row))
    63			}
    64	
    65			rec := record.New()
    66			rec.InputRow = rowNum
    67			for i, col := range header {
    68				rec.Set(col, row[i])
    69			}
    70			records = append(records, rec)
    71		}
    72	
    73		return records, nil
    74	}
    75	
    76	func readNDJSON(cfg config.InputConfig, dir string) ([]*record.Record, error) {
    77		path := config.ResolvePath(dir, cfg.Path)
    78		f, err := os.Open(path)
    79		if err != nil {
    80			return nil, fmt.Errorf("input: %v", err)
    81		}
    82		defer f.Close()
    83	
    84		scanner := bufio.NewScanner(f)
    85		scanner.Buffer(make([]byte, 0, 1024*1024), 64*1024*1024)
    86	
    87		records := []*record.Record{}
    88		lineNum := 0
    89		recNum := 0
    90		for scanner.Scan() {
    91			lineNum++
    92			line := scanner.Text()
    93			if strings.TrimSpace(line) == "" {
    94				continue
    95			}
    96	
    97			rec, err := parseNDJSONLine(line, lineNum)
    98			if err != nil {
    99				return nil, fmt.Errorf("input: line %d: %v", lineNum, err)
   100			}
   101			recNum++
   102			rec.InputRow = recNum
   103			records = append(records, rec)
   104		}
   105		if err := scanner.Err(); err != nil {
   106			return nil, fmt.Errorf("input: %v", err)
   107		}
   108	
   109		return records, nil
   110	}
   111	
   112	func parseNDJSONLine(line string, lineNum int) (*record.Record, error) {
   113		dec := json.NewDecoder(strings.NewReader(line))
   114	
   115		t, err := dec.Token()
   116		if err != nil {
   117			return nil, fmt.Errorf("invalid JSON: %v", err)
   118		}
   119		if t != json.Delim('{') {
   120			return nil, fmt.Errorf("line is not a JSON object")
   121		}
   122	
   123		rec := record.New()
   124		for {
   125			t, err := dec.Token()
   126			if err == io.EOF {
   127				return nil, fmt.Errorf("unexpected end of object")
   128			}
   129			if err != nil {
   130				return nil, fmt.Errorf("invalid JSON: %v", err)
   131			}
   132			if t == json.Delim('}') {
   133				break
   134			}
   135	
   136			key, ok := t.(string)
   137			if !ok {
   138				return nil, fmt.Errorf("object key is not a string")
   139			}
   140	
   141			vt, err := dec.Token()
   142			if err != nil {
   143				return nil, fmt.Errorf("value for %q: %v", key, err)
   144			}
   145			s, ok := vt.(string)
   146			if !ok {
   147				return nil, fmt.Errorf("value for %q is not a JSON string", key)
   148			}
   149			rec.Set(key, s)
   150		}
   151	
   152		if dec.More() {
   153			return nil, fmt.Errorf("unexpected trailing content")
   154		}
   155	
   156		return rec, nil
   157	}
