[?2004hroot@n30009:/app# nl -ba internal/input/input.go
[?2004l     1	package input
     2	
     3	import (
     4		"bufio"
     5		"encoding/csv"
     6		"encoding/json"
     7		"fmt"
     8		"io"
     9		"os"
    10		"strings"
    11	
    12		"example.com/flowctl/internal/config"
    13		"example.com/flowctl/internal/record"
    14	)
    15	
    16	func Read(cfg config.InputConfig, dir string) ([]*record.Record, error) {
    17		switch cfg.Format {
    18		case "csv":
    19			return readCSV(cfg, dir)
    20		case "ndjson":
    21			return readNDJSON(cfg, dir)
    22		default:
    23			return nil, fmt.Errorf("input: unsupported format %q", cfg.Format)
    24		}
    25	}
    26	
    27	func readCSV(cfg config.InputConfig, dir string) ([]*record.Record, error) {
    28		path := config.ResolvePath(dir, cfg.Path)
    29		f, err := os.Open(path)
    30		if err != nil {
    31			return nil, fmt.Errorf("input: %v", err)
    32		}
    33		defer f.Close()
    34	
    35		r := csv.NewReader(f)
    36		r.FieldsPerRecord = 0
    37		r.TrimLeadingSpace = true
    38	
    39		header, err := r.Read()
    40		if err == io.EOF {
    41			return nil, fmt.Errorf("input: empty CSV file")
    42		}
    43		if err != nil {
    44			return nil, fmt.Errorf("input: %v", err)
    45		}
    46	
    47		records := []*record.Record{}
    48		rowNum := 0
    49		for {
    50			row, err := r.Read()
    51			if err == io.EOF {
    52				break
    53			}
    54			if err != nil {
    55				return nil, fmt.Errorf("input: row %d: %v", rowNum+2, err)
    56			}
    57			rowNum++
    58	
    59			if len(row) != len(header) {
    60				return nil, fmt.Errorf("input: row %d: expected %d fields got %d", rowNum+1, len(header), len(row))
    61			}
    62	
    63			rec := record.New()
    64			rec.InputRow = rowNum
    65			for i, col := range header {
    66				rec.Set(col, row[i])
    67			}
    68			records = append(records, rec)
    69		}
    70	
    71		return records, nil
    72	}
    73	
    74	func readNDJSON(cfg config.InputConfig, dir string) ([]*record.Record, error) {
    75		path := config.ResolvePath(dir, cfg.Path)
    76		f, err := os.Open(path)
    77		if err != nil {
    78			return nil, fmt.Errorf("input: %v", err)
    79		}
    80		defer f.Close()
    81	
    82		scanner := bufio.NewScanner(f)
    83		scanner.Buffer(make([]byte, 0, 1024*1024), 64*1024*1024)
    84	
    85		records := []*record.Record{}
    86		lineNum := 0
    87		recNum := 0
    88		for scanner.Scan() {
    89			lineNum++
    90			line := scanner.Text()
    91			if strings.TrimSpace(line) == "" {
    92				continue
    93			}
    94	
    95			rec, err := parseNDJSONLine(line, lineNum)
    96			if err != nil {
    97				return nil, fmt.Errorf("input: line %d: %v", lineNum, err)
    98			}
    99			recNum++
   100			rec.InputRow = recNum
   101			records = append(records, rec)
   102		}
   103		if err := scanner.Err(); err != nil {
   104			return nil, fmt.Errorf("input: %v", err)
   105		}
   106	
   107		return records, nil
   108	}
   109	
   110	func parseNDJSONLine(line string, lineNum int) (*record.Record, error) {
   111		dec := json.NewDecoder(strings.NewReader(line))
   112	
   113		t, err := dec.Token()
   114		if err != nil {
   115			return nil, fmt.Errorf("invalid JSON: %v", err)
   116		}
   117		if t != json.Delim('{') {
   118			return nil, fmt.Errorf("line is not a JSON object")
   119		}
   120	
   121		rec := record.New()
   122		for {
   123			t, err := dec.Token()
   124			if err == io.EOF {
   125				return nil, fmt.Errorf("unexpected end of object")
   126			}
   127			if err != nil {
   128				return nil, fmt.Errorf("invalid JSON: %v", err)
   129			}
   130			if t == json.Delim('}') {
   131				break
   132			}
   133	
   134			key, ok := t.(string)
   135			if !ok {
   136				return nil, fmt.Errorf("object key is not a string")
   137			}
   138	
   139			vt, err := dec.Token()
   140			if err != nil {
   141				return nil, fmt.Errorf("value for %q: %v", key, err)
   142			}
   143			s, ok := vt.(string)
   144			if !ok {
   145				return nil, fmt.Errorf("value for %q is not a JSON string", key)
   146			}
   147			rec.Set(key, s)
   148		}
   149	
   150		if dec.More() {
   151			return nil, fmt.Errorf("unexpected trailing content")
   152		}
   153	
   154		return rec, nil
   155	}
