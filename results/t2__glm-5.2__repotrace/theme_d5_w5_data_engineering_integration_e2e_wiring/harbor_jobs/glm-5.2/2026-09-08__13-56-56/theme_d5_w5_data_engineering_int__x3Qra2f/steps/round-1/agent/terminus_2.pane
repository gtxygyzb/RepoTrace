    65	type FilterStage struct {
    66		column string
    67		op     string
    68		value  string
    69	}
    70	
    71	func (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    72		out := make([]*record.Record, 0, len(in))
    73	
    74		for _, r := range in {
    75			v, ok := r.Get(s.column)
    76			if !ok {
    77				stats.DroppedMissing++
    78				if !stats.missingReported {
    79					fmt.Fprintf(stderr, "flowctl: filter: missing column %s\n", s.column)
    80					stats.missingReported = true
    81				}
    82				if strict {
    83					return nil, fmt.Errorf("filter: missing column %s", s.column)
    84				}
    85				continue
    86			}
    87	
    88			keep := false
    89			switch s.op {
    90			case "==":
    91				keep = v == s.value
    92			case "!=":
    93				keep = v != s.value
    94			default:
    95				left, err := parseFloat(v)
    96				if err != nil {
    97					stats.DroppedNonNumeric++
    98					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
    99					if strict {
   100						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   101					}
   102					continue
   103				}
   104				right, err := parseFloat(s.value)
   105				if err != nil {
   106					stats.DroppedNonNumeric++
   107					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
   108					if strict {
   109						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   110					}
   111					continue
   112				}
   113				keep = compareFloats(left, s.op, right)
   114			}
   115	
   116			if keep {
   117				out = append(out, r)
   118			}
   119		}
   120	
   121		return out, nil
   122	}
   123	
   124	type ProjectColumn struct {
   125		Source string
   126		Target string
   127	}
   128	
   129	type ProjectStage struct {
   130		columns []ProjectColumn
   131	}
   132	
   133	func (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   134		out := make([]*record.Record, 0, len(in))
   135		for _, r := range in {
   136			nr := record.New()
   137			nr.InputRow = r.InputRow
   138			for _, c := range s.columns {
   139				val := ""
   140				if v, ok := r.Get(c.Source); ok {
   141					val = v
   142				}
   143				nr.Set(c.Target, val)
   144			}
   145			out = append(out, nr)
   146		}
   147		return out, nil
   148	}
   149	
   150	type SortKey struct {
   151		Column string
   152		Order  string
   153		As     string
   154	}
   155	
   156	type SortStage struct {
   157		keys []SortKey
   158	}
   159	
   160	func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   161		for _, key := range s.keys {
   162			if key.As == "number" {
   163				for _, r := range in {
   164					v, ok := r.Get(key.Column)
   165					if !ok || v == "" {
   166						continue
   167					}
   168					if _, err := parseFloat(v); err != nil {
   169						return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
   170					}
   171				}
   172			}
   173		}
   174	
   175		sort.SliceStable(in, func(i, j int) bool {
   176			for _, key := range s.keys {
   177				a, aok := in[i].Get(key.Column)
   178				b, bok := in[j].Get(key.Column)
   179	
   180				if key.As == "number" {
   181					aMissing := !aok || a == ""
   182					bMissing := !bok || b == ""
   183					if aMissing != bMissing {
   184						if key.Order == "desc" {
   185							return bMissing
   186						}
   187						return aMissing
   188					}
   189					if aMissing {
   190						continue
   191					}
   192					af, errA := parseFloat(a)
   193					bf, errB := parseFloat(b)
   194					if errA != nil || errB != nil {
   195						return false
   196					}
   197					if af != bf {
   198						if key.Order == "desc" {
   199							return af > bf
   200						}
   201						return af < bf
   202					}
   203				} else {
   204					if a != b {
   205						if key.Order == "desc" {
   206							return a > b
   207						}
   208						return a < b
   209					}
   210				}
   211			}
   212			return false
   213		})
   214	
   215		return in, nil
   216	}
   217	
   218	type LimitStage struct {
   219		count int
   220	}
   221	
   222	func (s *LimitStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   223		if s.count < len(in) {
   224			return in[:s.count], nil
   225		}
   226		return in, nil
   227	}
   228	
   229	func buildFilter(idx int, sm map[string]interface{}) (Stage, error) {
   230		whereRaw, ok := sm["where"]
   231		if !ok {
   232			return nil, fmt.Errorf("config: stage %d: filter.where is required", idx)
   233		}
   234		where, ok := whereRaw.(map[string]interface{})
   235		if !ok {
   236			return nil, fmt.Errorf("config: stage %d: filter.where must be a mapping", idx)
   237		}
   238	
   239		column, ok := getString(where, "column")
   240		if !ok || column == "" {
   241			return nil, fmt.Errorf("config: stage %d: filter.where.column is required", idx)
   242		}
   243	
   244		op, ok := getString(where, "op")
   245		if !ok || op == "" {
   246			return nil, fmt.Errorf("config: stage %d: filter.where.op is required", idx)
   247		}
   248		switch op {
   249		case "==", "!=", "<", "<=", ">", ">=":
   250		default:
   251			return nil, fmt.Errorf("config: stage %d: filter.where.op is invalid", idx)
   252		}
   253	
   254		value, ok := getString(where, "value")
   255		if !ok {
   256			return nil, fmt.Errorf("config: stage %d: filter.where.value is required", idx)
   257		}
   258	
   259		return &FilterStage{column: column, op: op, value: value}, nil
   260	}
   261	
   262	func buildProject(idx int, sm map[string]interface{}) (Stage, error) {
   263		colsRaw, ok := sm["columns"]
   264		if !ok {
   265			return nil, fmt.Errorf("config: stage %d: project.columns is required", idx)
   266		}
   267		list, ok := colsRaw.([]interface{})
   268		if !ok {
   269			return nil, fmt.Errorf("config: stage %d: project.columns must be a list", idx)
   270		}
   271	
   272		columns := make([]ProjectColumn, 0, len(list))
   273		seen := map[string]bool{}
   274		for j, item := range list {
   275			switch v := item.(type) {
   276			case string:
   277				if seen[v] {
   278					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, v)
   279				}
   280				seen[v] = true
   281				columns = append(columns, ProjectColumn{Source: v, Target: v})
   282			case map[string]interface{}:
   283				name, ok := getString(v, "name")
   284				if !ok || name == "" {
   285					return nil, fmt.Errorf("config: stage %d: project column %d name is required", idx, j+1)
   286				}
   287				as, ok := getString(v, "as")
   288				if !ok || as == "" {
   289					return nil, fmt.Errorf("config: stage %d: project column %d as is required", idx, j+1)
   290				}
   291				if seen[as] {
   292					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, as)
   293				}
   294				seen[as] = true
