[?2004lpackage stage

import (
        "fmt"
        "io"
        "math"
        "strconv"
        "strings"

        "example.com/flowctl/internal/record"
)

type BucketStage struct {
        column        string
        into         string
        edges        []float64
        labels       []string
        underLabel   string
        overLabel    string
        inclusive    string
        onMissing    string
        onNonNumeric string
}

func buildBucket(idx int, sm map[string]interface{}) (Stage, error) {
        column, ok := getString(sm, "column")
        if !ok || column == "" {
                return nil, fmt.Errorf("config: stage %d: bucket: column must be a non-empty string", idx)
        }
        into, ok := getString(sm, "into")
        if !ok || into == "" {
                return nil, fmt.Errorf("config: stage %d: bucket: into must be a non-empty string", idx)
        }
        if into == column {
                return nil, fmt.Errorf("config: stage %d: bucket: into must differ from column", idx)
        }

        inclusive, ok := getString(sm, "inclusive")
        if !ok || inclusive == "" {
                inclusive = "right"
        }
        if inclusive != "left" && inclusive != "right" {
                return nil, fmt.Errorf("config: stage %d: bucket: inclusive must be left or right", idx)
        }

        onMissing, ok := getString(sm, "on_missing")
        if !ok || onMissing == "" {
                onMissing = "keep_empty"
        }
        if onMissing != "keep_empty" && onMissing != "drop" && onMissing != "error" {
                return nil, fmt.Errorf("config: stage %d: bucket: on_missing must be keep_empty, drop, or error", idx)
        }

        onNonNumeric, ok := getString(sm, "on_non_numeric")
        if !ok || onNonNumeric == "" {
                onNonNumeric = "error"
        }
        if onNonNumeric != "error" && onNonNumeric != "drop" && onNonNumeric != "keep_empty" {
                return nil, fmt.Errorf("config: stage %d: bucket: on_non_numeric must be error, drop, or keep_empty", idx)
        }

        _, hasEdges := sm["edges"]
        _, hasWidth := sm["width"]
        if hasEdges == hasWidth {
                return nil, fmt.Errorf("config: stage %d: bucket: exactly one of edges or width is required", idx)
        }

        var (
                edges       []float64
                labelCount  int
                autoLabels  []string
                underAuto   string
                overAuto    string
        )

        if hasWidth {
                widthRaw, ok := sm["width"]
                if !ok {
                        return nil, fmt.Errorf("config: stage %d: bucket: exactly one of edges or width is required", idx)
                }
                wm, ok := widthRaw.(map[string]interface{})
                if !ok {
                        return nil, fmt.Errorf("config: stage %d: bucket: width must be a mapping", idx)
                }
                for k := range wm {
                        if k != "step" && k != "start" && k != "count" {
                                return nil, fmt.Errorf("config: stage %d: bucket: unknown key %s in width", idx, k)
                        }
                }

                stepStr, ok := getString(wm, "step")
                if !ok || stepStr == "" {
                        return nil, fmt.Errorf("config: stage %d: bucket: width.step must be a positive finite number", idx)
                }
                step, err := parseFloat(stepStr)
                if err != nil || math.IsNaN(step) || math.IsInf(step, 0) || step <= 0 {
                        return nil, fmt.Errorf("config: stage %d: bucket: width.step must be a positive finite number", idx)
                }

                start := 0.0
                if startStr, ok := getString(wm, "start"); ok && startStr != "" {
                        var err error
                        start, err = parseFloat(startStr)
                        if err != nil || math.IsNaN(start) || math.IsInf(start, 0) {
                                return nil, fmt.Errorf("config: stage %d: bucket: width.start must be a finite number", idx)
                        }
                }

                countStr, ok := getString(wm, "count")
                if !ok || countStr == "" {
                        return nil, fmt.Errorf("config: stage %d: bucket: width.count must be a positive integer", idx)
                }
                countI, err := strconv.Atoi(countStr)
                if err != nil || countI < 1 {
                        return nil, fmt.Errorf("config: stage %d: bucket: width.count must be a positive integer", idx)
                }

                edges = make([]float64, 0, countI+1)
                for i := 0; i <= countI; i++ {
                        edges = append(edges, start+step*float64(i))
                }
                labelCount = countI
        } else {
                edgesRaw, ok := sm["edges"]
                if !ok {
                        return nil, fmt.Errorf("config: stage %d: bucket: edges must have at least two entries", idx)
                }
                list, ok := edgesRaw.([]interface{})
                if !ok {
                        return nil, fmt.Errorf("config: stage %d: bucket: edges must have at least two entries", idx)
                }
                if len(list) < 2 {
                        return nil, fmt.Errorf("config: stage %d: bucket: edges must have at least two entries", idx)
                }
                edges = make([]float64, 0, len(list))
                for i, item := range list {
                        es, ok := item.(string)
                        if !ok {
                                es = fmt.Sprintf("%v", item)
                        }
                        f, err := parseFloat(es)
                        if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {
                                return nil, fmt.Errorf("config: stage %d: bucket: edges[%d] is not a finite number", idx, i)
                        }
                        if i > 0 && f <= edges[i-1] {
                                return nil, fmt.Errorf("config: stage %d: bucket: edges must be strictly increasing", idx)
                        }
                        edges = append(edges, f)
                }
                labelCount = len(edges) - 1
        }

        for i := 1; i < len(edges); i++ {
                if edges[i] <= edges[i-1] {
                        return nil, fmt.Errorf("config: stage %d: bucket: edges must be strictly increasing", idx)
        }
        }

        autoLabels = make([]string, labelCount)
        for i := 0; i < labelCount; i++ {
                a := formatFloat(edges[i])
                b := formatFloat(edges[i+1])
                if inclusive == "left" {
                        autoLabels[i] = "[" + a + ", " + b + ")"
                } else {
                        autoLabels[i] = "(" + a + ", " + b + "]"
                }
        }
        first := formatFloat(edges[0])
        last := formatFloat(edges[len(edges)-1])
        if inclusive == "left" {
                underAuto = "(-inf, " + first + ")"
                overAuto = "[" + last + ", +inf)"
        } else {
                underAuto = "(-inf, " + first + "]"
                overAuto = "(" + last + ", +inf)"
        }

        labels := autoLabels
        if labelsRaw, ok := sm["labels"]; ok {
                list, ok := labelsRaw.([]interface{})
                if !ok {
                        return nil, fmt.Errorf("config: stage %d: bucket: labels length 0 does not match edges-1 %d", idx, labelCount)
                }
                if len(list) != labelCount {
                        return nil, fmt.Errorf("config: stage %d: bucket: labels length %d does not match edges-1 %d", idx, len(list), labelCount)
                }
                labels = make([]string, labelCount)
                seen := map[string]bool{}
                for i, item := range list {
                        ls, ok := item.(string)
                        if !ok {
                                ls = fmt.Sprintf("%v", item)
                        }
                        if ls == "" {
                                return nil, fmt.Errorf("config: stage %d: bucket: labels[%d] must be a non-empty string", idx, i)
                        }
                        if seen[ls] {
                                return nil, fmt.Errorf("config: stage %d: bucket: labels has duplicate entry %s", idx, ls)
                        }
                        seen[ls] = true
                        labels[i] = ls
                }
        }

        underLabel := underAuto
        if s, ok := getString(sm, "under_label"); ok {
                if s == "" {
                        return nil, fmt.Errorf("config: stage %d: bucket: under_label must be a non-empty string", idx)
                }
                for _, label := range labels {
                        if s == label {
                                return nil, fmt.Errorf("config: stage %d: bucket: under_label collides with labels entry %s", idx, s)
                        }
                }
                underLabel = s
        }
        overLabel := overAuto
        if s, ok := getString(sm, "over_label"); ok {
                if s == "" {
                        return nil, fmt.Errorf("config: stage %d: bucket: over_label must be a non-empty string", idx)
                }
                for _, label := range labels {
                        if s == label {
                                return nil, fmt.Errorf("config: stage %d: bucket: over_label collides with labels entry %s", idx, s)
                        }
                }
                overLabel = s
        }

        return &BucketStage{
                column:        column,
                into:          into,
                edges:        edges,
                labels:       labels,
                underLabel:   underLabel,
                overLabel:    overLabel,
                inclusive:    inclusive,
                onMissing:    onMissing,
                onNonNumeric: onNonNumeric,
        }, nil
}

