   246	func buildProject(idx int, sm map[string]interface{}) (Stage, error) {
   247		colsRaw, ok := sm["columns"]
   248		if !ok {
   249			return nil, fmt.Errorf("config: stage %d: project.columns is required", idx)
   250		}
   251		list, ok := colsRaw.([]interface{})
   252		if !ok {
   253			return nil, fmt.Errorf("config: stage %d: project.columns must be a list", idx)
   254		}
   255	
   256		columns := make([]ProjectColumn, 0, len(list))
   257		seen := map[string]bool{}
   258		for j, item := range list {
   259			switch v := item.(type) {
   260			case string:
   261				if seen[v] {
   262					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, v)
   263				}
   264				seen[v] = true
   265				columns = append(columns, ProjectColumn{Source: v, Target: v})
   266			case map[string]interface{}:
   267				name, ok := getString(v, "name")
   268				if !ok || name == "" {
   269					return nil, fmt.Errorf("config: stage %d: project column %d name is required", idx, j+1)
   270				}
   271				as, ok := getString(v, "as")
   272				if !ok || as == "" {
   273					return nil, fmt.Errorf("config: stage %d: project column %d as is required", idx, j+1)
   274				}
   275				if seen[as] {
   276					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, as)
   277				}
   278				seen[as] = true
   279				columns = append(columns, ProjectColumn{Source: name, Target: as})
   280			default:
   281				return nil, fmt.Errorf("config: stage %d: project column %d must be a string or mapping", idx, j+1)
   282			}
   283		}
   284	
   285		return &ProjectStage{columns: columns}, nil
   286	}
   287	
   288	func buildSort(idx int, sm map[string]interface{}) (Stage, error) {
   289		keysRaw, ok := sm["keys"]
   290		if !ok {
   291			return nil, fmt.Errorf("config: stage %d: sort.keys is required", idx)
   292		}
   293		list, ok := keysRaw.([]interface{})
   294		if !ok {
   295			return nil, fmt.Errorf("config: stage %d: sort.keys must be a list", idx)
   296		}
   297	
   298		keys := make([]SortKey, 0, len(list))
   299		for j, item := range list {
   300			km, ok := item.(map[string]interface{})
   301			if !ok {
   302				return nil, fmt.Errorf("config: stage %d: sort key %d must be a mapping", idx, j+1)
   303			}
   304	
   305			column, ok := getString(km, "column")
   306			if !ok || column == "" {
   307				return nil, fmt.Errorf("config: stage %d: sort key %d column is required", idx, j+1)
   308			}
   309	
   310			order, ok := getString(km, "order")
   311			if !ok || order == "" {
   312				order = "asc"
   313			}
   314			if order != "asc" && order != "desc" {
   315				return nil, fmt.Errorf("config: stage %d: sort key %d order must be asc or desc", idx, j+1)
   316			}
   317	
   318			as, ok := getString(km, "as")
   319			if !ok || as == "" {
   320				as = "string"
   321			}
   322			if as != "string" && as != "number" {
   323				return nil, fmt.Errorf("config: stage %d: sort key %d as must be string or number", idx, j+1)
   324			}
   325	
   326			keys = append(keys, SortKey{Column: column, Order: order, As: as})
   327		}
   328	
   329		return &SortStage{keys: keys}, nil
   330	}
   331	
   332	func buildLimit(idx int, sm map[string]interface{}) (Stage, error) {
   333		countRaw, ok := sm["count"]
   334		if !ok {
   335			return nil, fmt.Errorf("config: stage %d: limit.count is required", idx)
   336		}
   337		countStr, ok := countRaw.(string)
   338		if !ok {
   339			return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
   340		}
   341		n, err := strconv.Atoi(countStr)
   342		if err != nil || n < 0 {
   343			return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
   344		}
   345	
   346		return &LimitStage{count: n}, nil
   347	}
   348	
   349	func getString(m map[string]interface{}, key string) (string, bool) {
   350		v, ok := m[key]
   351		if !ok {
   352			return "", false
   353		}
   354		if s, ok := v.(string); ok {
   355			return s, true
   356		}
   357		return fmt.Sprintf("%v", v), true
   358	}
