   226	
   227	func isSequenceLine(text string) bool {
   228		return text == "-" || strings.HasPrefix(text, "- ")
   229	}
   230	
   231	func parseMapping(lines []yamlLine, start, indent int) (map[string]interface{}, int, error) {
   232		m := map[string]interface{}{}
   233		i := start
   234		for i < len(lines) {
   235			if lines[i].indent < indent {
   236				break
   237			}
   238			if lines[i].indent > indent {
   239				return nil, i, fmt.Errorf("unexpected indentation in mapping")
   240			}
   241			if isSequenceLine(lines[i].text) {
   242				break
   243			}
   244	
   245			key, val, err := splitKeyValue(lines[i].text)
   246			if err != nil {
   247				return nil, i, err
   248			}
   249	
   250			if val == "" {
   251				if i+1 < len(lines) {
   252					next := lines[i+1]
   253					if next.indent > indent {
   254						child, next2, err := parseNode(lines, i+1, next.indent)
   255						if err != nil {
   256							return nil, 0, err
   257						}
   258						m[key] = child
   259						i = next2
   260						continue
   261					}
   262					if next.indent == indent && isSequenceLine(next.text) {
   263						child, next2, err := parseSequence(lines, i+1, indent)
   264						if err != nil {
   265							return nil, 0, err
   266						}
   267						m[key] = child
   268						i = next2
   269						continue
   270					}
   271				}
   272				m[key] = nil
   273				i++
   274				continue
   275			}
   276	
   277			v, err := parseFlowOrScalar(val)
   278			if err != nil {
   279				return nil, 0, err
   280			}
   281			m[key] = v
   282			i++
   283		}
   284		return m, i, nil
   285	}
   286	
   287	func parseSequence(lines []yamlLine, start, indent int) ([]interface{}, int, error) {
   288		items := []interface{}{}
   289		i := start
   290		for i < len(lines) {
   291			if lines[i].indent < indent {
   292				break
   293			}
   294			if lines[i].indent > indent {
   295				return nil, i, fmt.Errorf("unexpected indentation in sequence")
   296			}
   297			if !isSequenceLine(lines[i].text) {
   298				break
   299			}
   300	
   301			content := strings.TrimSpace(strings.TrimPrefix(lines[i].text, "-"))
   302			if content == "" {
   303				if i+1 < len(lines) && lines[i+1].indent > indent {
   304					child, next, err := parseNode(lines, i+1, lines[i+1].indent)
   305					if err != nil {
   306						return nil, 0, err
   307					}
   308					items = append(items, child)
   309					i = next
   310					continue
   311				}
   312				items = append(items, nil)
   313				i++
   314				continue
   315			}
   316	
   317			if strings.HasPrefix(content, "[") || strings.HasPrefix(content, "{") {
   318				v, err := parseFlow(content)
   319				if err != nil {
   320					return nil, 0, err
   321				}
   322				items = append(items, v)
   323				i++
   324				continue
   325			}
   326	
   327			if isMappingLine(content) {
   328				afterDash := strings.TrimPrefix(lines[i].text, "-")
   329				leading := len(afterDash) - len(strings.TrimLeft(afterDash, " "))
   330				effIndent := indent + 1 + leading
   331				sublines := []yamlLine{{indent: effIndent, text: content}}
   332				j := i + 1
   333				for j < len(lines) && lines[j].indent >= effIndent {
   334					sublines = append(sublines, lines[j])
   335					j++
   336				}
   337				child, _, err := parseMapping(sublines, 0, effIndent)
   338				if err != nil {
   339					return nil, 0, err
   340				}
   341				items = append(items, child)
   342				i = j
   343				continue
   344			}
   345	
   346			v, err := parseFlowOrScalar(content)
   347			if err != nil {
   348				return nil, 0, err
   349			}
   350			items = append(items, v)
   351			i++
   352		}
   353		return items, i, nil
   354	}
   355	
   356	func isMappingLine(text string) bool {
   357		_, _, err := splitKeyValue(text)
   358		return err == nil
   359	}
   360	
   361	func splitKeyValue(text string) (string, string, error) {
   362		inSingle := false
   363		inDouble := false
   364		for i := 0; i < len(text); i++ {
   365			c := text[i]
   366			switch c {
   367			case '\'':
   368				if !inDouble {
   369					inSingle = !inSingle
   370				}
   371			case '"':
   372				if !inSingle {
   373					inDouble = !inDouble
   374				}
   375			case ':':
   376				if !inSingle && !inDouble {
   377					if i+1 >= len(text) {
   378						return parseScalar(strings.TrimSpace(text[:i])), "", nil
   379					}
   380					if text[i+1] == ' ' || text[i+1] == '\t' {
   381						return parseScalar(strings.TrimSpace(text[:i])), strings.TrimSpace(text[i+1:]), nil
   382					}
   383				}
   384			}
   385		}
   386		return "", "", fmt.Errorf("expected mapping key: %q", text)
   387	}
   388	
   389	func parseFlowOrScalar(s string) (interface{}, error) {
   390		s = strings.TrimSpace(s)
   391		if strings.HasPrefix(s, "[") || strings.HasPrefix(s, "{") {
   392			return parseFlow(s)
   393		}
   394		return parseScalar(s), nil
   395	}
   396	
   397	func parseScalar(s string) string {
   398		s = strings.TrimSpace(s)
   399		if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
   400			if q, err := strconv.Unquote(s); err == nil {
   401				return q
   402			}
   403			return s[1 : len(s)-1]
   404		}
   405		if len(s) >= 2 && s[0] == '\'' && s[len(s)-1] == '\'' {
   406			return strings.ReplaceAll(s[1:len(s)-1], "''", "'")
   407		}
   408		return s
   409	}
   410	
   411	func stripComment(line string) string {
   412		inSingle := false
   413		inDouble := false
   414		for i := 0; i < len(line); i++ {
   415			c := line[i]
   416			switch c {
   417			case '\'':
   418				if !inDouble {
   419					inSingle = !inSingle
   420				}
   421			case '"':
   422				if !inSingle {
   423					inDouble = !inDouble
   424				}
   425			case '#':
   426				if !inSingle && !inDouble && (i == 0 || line[i-1] == ' ' || line[i-1] == '\t') {
   427					return line[:i]
   428				}
   429			}
   430		}
   431		return line
   432	}
   433	
   434	func parseFlow(s string) (interface{}, error) {
   435		s = strings.TrimSpace(s)
