    25	type Config struct {
    26		Dir    string
    27		Strict bool
    28		Input  InputConfig
    29		Stages []map[string]interface{}
    30		Output OutputConfig
    31	}
    32	
    33	func Load(path string) (*Config, error) {
    34		data, err := os.ReadFile(path)
    35		if err != nil {
    36			return nil, fmt.Errorf("config: %v", err)
    37		}
    38	
    39		root, err := parseYAML(data)
    40		if err != nil {
    41			return nil, fmt.Errorf("config: %v", err)
    42		}
    43	
    44		m, ok := root.(map[string]interface{})
    45		if !ok {
    46			return nil, fmt.Errorf("config: top-level value must be a mapping")
    47		}
    48	
    49		cfg := &Config{Dir: filepath.Dir(path)}
    50	
    51		inRaw, ok := m["input"]
    52		if !ok {
    53			return nil, fmt.Errorf("config: input is required")
    54		}
    55		inMap, ok := inRaw.(map[string]interface{})
    56		if !ok {
    57			return nil, fmt.Errorf("config: input must be a mapping")
    58		}
    59		if p, ok := getString(inMap, "path"); ok {
    60			cfg.Input.Path = p
    61		} else {
    62			return nil, fmt.Errorf("config: input.path is required")
    63		}
    64		if cfg.Input.Path == "" {
    65			return nil, fmt.Errorf("config: input.path is required")
    66		}
    67		if f, ok := getString(inMap, "format"); ok {
    68			cfg.Input.Format = f
    69		} else {
    70			return nil, fmt.Errorf("config: input.format is required")
    71		}
    72		if cfg.Input.Format == "" {
    73			return nil, fmt.Errorf("config: input.format is required")
    74		}
    75		if cfg.Input.Format != "csv" && cfg.Input.Format != "ndjson" {
    76			return nil, fmt.Errorf("config: input.format must be csv or ndjson")
    77		}
    78	
    79		stRaw, ok := m["stages"]
    80		if !ok {
    81			return nil, fmt.Errorf("config: stages is required")
    82		}
    83		stList, ok := stRaw.([]interface{})
    84		if !ok {
    85			return nil, fmt.Errorf("config: stages must be a list")
    86		}
    87		cfg.Stages = []map[string]interface{}{}
    88		for i, item := range stList {
    89			sm, ok := item.(map[string]interface{})
    90			if !ok {
    91				return nil, fmt.Errorf("config: stage %d must be a mapping", i+1)
    92			}
    93			cfg.Stages = append(cfg.Stages, sm)
    94		}
    95	
    96		outRaw, ok := m["output"]
    97		if !ok {
    98			return nil, fmt.Errorf("config: output is required")
    99		}
   100		outMap, ok := outRaw.(map[string]interface{})
   101		if !ok {
   102			return nil, fmt.Errorf("config: output must be a mapping")
   103		}
   104		if p, ok := getString(outMap, "path"); ok {
   105			cfg.Output.Path = p
   106		} else {
   107			return nil, fmt.Errorf("config: output.path is required")
   108		}
   109		if cfg.Output.Path == "" {
   110			return nil, fmt.Errorf("config: output.path is required")
   111		}
   112		if f, ok := getString(outMap, "format"); ok {
   113			cfg.Output.Format = f
   114		} else {
   115			return nil, fmt.Errorf("config: output.format is required")
   116		}
   117		if cfg.Output.Format == "" {
   118			return nil, fmt.Errorf("config: output.format is required")
   119		}
   120		if cfg.Output.Format != "jsonl" {
   121			return nil, fmt.Errorf("config: output.format must be jsonl")
   122		}
   123		if colRaw, present := outMap["columns"]; present {
   124			cfg.Output.ColumnsPresent = true
   125			cols, err := toStringList(colRaw)
   126			if err != nil {
   127				return nil, fmt.Errorf("config: output.columns: %v", err)
   128			}
   129			cfg.Output.Columns = cols
   130		}
   131	
   132		return cfg, nil
   133	}
   134	
   135	func ResolvePath(dir, path string) string {
   136		if path == "-" {
   137			return "-"
   138		}
   139		if filepath.IsAbs(path) {
   140			return path
   141		}
   142		return filepath.Join(dir, path)
   143	}
   144	
   145	func getString(m map[string]interface{}, key string) (string, bool) {
   146		v, ok := m[key]
   147		if !ok {
   148			return "", false
   149		}
   150		if s, ok := v.(string); ok {
   151			return s, true
   152		}
   153		return "", true
   154	}
   155	
   156	func toStringList(v interface{}) ([]string, error) {
   157		list, ok := v.([]interface{})
   158		if !ok {
   159			return nil, fmt.Errorf("must be a list of strings")
   160		}
   161		out := []string{}
   162		for i, item := range list {
   163			s, ok := item.(string)
   164			if !ok {
   165				return nil, fmt.Errorf("entry %d must be a string", i+1)
   166			}
   167			out = append(out, s)
   168		}
   169		return out, nil
   170	}
   171	
   172	type yamlLine struct {
   173		indent int
   174		text   string
   175	}
   176	
   177	func parseYAML(data []byte) (interface{}, error) {
   178		lines := []yamlLine{}
   179		scanner := bufio.NewScanner(bytes.NewReader(data))
   180		for scanner.Scan() {
   181			raw := scanner.Text()
   182			line := stripComment(raw)
   183			if strings.TrimSpace(line) == "" {
   184				continue
   185			}
   186			indent := 0
   187			for indent < len(line) && line[indent] == ' ' {
   188				indent++
   189			}
   190			if indent < len(line) && line[indent] == '\t' {
   191				return nil, fmt.Errorf("tabs are not allowed for indentation")
   192			}
   193			text := strings.TrimRight(line[indent:], " \t")
   194			lines = append(lines, yamlLine{indent: indent, text: text})
   195		}
   196		if err := scanner.Err(); err != nil {
   197			return nil, err
   198		}
   199		if len(lines) == 0 {
   200			return nil, nil
   201		}
   202		val, _, err := parseNode(lines, 0, lines[0].indent)
   203		return val, err
   204	}
   205	
   206	func parseNode(lines []yamlLine, start, indent int) (interface{}, int, error) {
   207		if start >= len(lines) || lines[start].indent < indent {
   208			return nil, start, nil
   209		}
   210		if isSequenceLine(lines[start].text) {
   211			return parseSequence(lines, start, indent)
   212		}
   213		return parseMapping(lines, start, indent)
   214	}
   215	
   216	func isSequenceLine(text string) bool {
   217		return text == "-" || strings.HasPrefix(text, "- ")
   218	}
   219	
   220	func parseMapping(lines []yamlLine, start, indent int) (map[string]interface{}, int, error) {
   221		m := map[string]interface{}{}
   222		i := start
   223		for i < len(lines) {
   224			if lines[i].indent < indent {
   225				break
   226			}
   227			if lines[i].indent > indent {
   228				return nil, i, fmt.Errorf("unexpected indentation in mapping")
   229			}
   230			if isSequenceLine(lines[i].text) {
   231				break
   232			}
   233	
   234			key, val, err := splitKeyValue(lines[i].text)
   235			if err != nil {
   236				return nil, i, err
   237			}
   238	
   239			if val == "" {
   240				if i+1 < len(lines) {
   241					next := lines[i+1]
   242					if next.indent > indent {
   243						child, next2, err := parseNode(lines, i+1, next.indent)
   244						if err != nil {
   245							return nil, 0, err
   246						}
   247						m[key] = child
   248						i = next2
   249						continue
   250					}
   251					if next.indent == indent && isSequenceLine(next.text) {
   252						child, next2, err := parseSequence(lines, i+1, indent)
   253						if err != nil {
   254							return nil, 0, err
   255						}
   256						m[key] = child
   257						i = next2
   258						continue
   259					}
   260				}
   261				m[key] = nil
   262				i++
   263				continue
   264			}
   265	
   266			v, err := parseFlowOrScalar(val)
   267			if err != nil {
   268				return nil, 0, err
   269			}
   270			m[key] = v
   271			i++
   272		}
   273		return m, i, nil
   274	}
   275	
   276	func parseSequence(lines []yamlLine, start, indent int) ([]interface{}, int, error) {
   277		items := []interface{}{}
   278		i := start
   279		for i < len(lines) {
   280			if lines[i].indent < indent {
   281				break
   282			}
   283			if lines[i].indent > indent {
   284				return nil, i, fmt.Errorf("unexpected indentation in sequence")
   285			}
   286			if !isSequenceLine(lines[i].text) {
   287				break
   288			}
   289	
   290			content := strings.TrimSpace(strings.TrimPrefix(lines[i].text, "-"))
   291			if content == "" {
   292				if i+1 < len(lines) && lines[i+1].indent > indent {
   293					child, next, err := parseNode(lines, i+1, lines[i+1].indent)
   294					if err != nil {
   295						return nil, 0, err
   296					}
   297					items = append(items, child)
   298					i = next
   299					continue
   300				}
   301				items = append(items, nil)
   302				i++
   303				continue
   304			}
   305	
   306			if strings.HasPrefix(content, "[") || strings.HasPrefix(content, "{") {
   307				v, err := parseFlow(content)
   308				if err != nil {
   309					return nil, 0, err
   310				}
   311				items = append(items, v)
   312				i++
   313				continue
   314			}
   315	
   316			if isMappingLine(content) {
   317				afterDash := strings.TrimPrefix(lines[i].text, "-")
   318				leading := len(afterDash) - len(strings.TrimLeft(afterDash, " "))
   319				effIndent := indent + 1 + leading
   320				sublines := []yamlLine{{indent: effIndent, text: content}}
   321				j := i + 1
   322				for j < len(lines) && lines[j].indent >= effIndent {
   323					sublines = append(sublines, lines[j])
   324					j++
   325				}
   326				child, _, err := parseMapping(sublines, 0, effIndent)
   327				if err != nil {
   328					return nil, 0, err
   329				}
   330				items = append(items, child)
   331				i = j
   332				continue
   333			}
   334	
   335			v, err := parseFlowOrScalar(content)
   336			if err != nil {
   337				return nil, 0, err
   338			}
   339			items = append(items, v)
   340			i++
   341		}
   342		return items, i, nil
   343	}
   344	
   345	func isMappingLine(text string) bool {
   346		_, _, err := splitKeyValue(text)
   347		return err == nil
   348	}
   349	
   350	func splitKeyValue(text string) (string, string, error) {
   351		inSingle := false
   352		inDouble := false
   353		for i := 0; i < len(text); i++ {
   354			c := text[i]
   355			switch c {
   356			case '\'':
   357				if !inDouble {
   358					inSingle = !inSingle
   359				}
   360			case '"':
   361				if !inSingle {
   362					inDouble = !inDouble
   363				}
   364			case ':':
   365				if !inSingle && !inDouble {
   366					if i+1 >= len(text) {
   367						return parseScalar(strings.TrimSpace(text[:i])), "", nil
   368					}
   369					if text[i+1] == ' ' || text[i+1] == '\t' {
   370						return parseScalar(strings.TrimSpace(text[:i])), strings.TrimSpace(text[i+1:]), nil
   371					}
   372				}
   373			}
   374		}
   375		return "", "", fmt.Errorf("expected mapping key: %q", text)
   376	}
   377	
   378	func parseFlowOrScalar(s string) (interface{}, error) {
   379		s = strings.TrimSpace(s)
   380		if strings.HasPrefix(s, "[") || strings.HasPrefix(s, "{") {
   381			return parseFlow(s)
   382		}
   383		return parseScalar(s), nil
   384	}
   385	
   386	func parseScalar(s string) string {
   387		s = strings.TrimSpace(s)
   388		if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
   389			if q, err := strconv.Unquote(s); err == nil {
   390				return q
   391			}
   392			return s[1 : len(s)-1]
   393		}
   394		if len(s) >= 2 && s[0] == '\'' && s[len(s)-1] == '\'' {
   395			return strings.ReplaceAll(s[1:len(s)-1], "''", "'")
   396		}
   397		return s
   398	}
   399	
   400	func stripComment(line string) string {
   401		inSingle := false
   402		inDouble := false
   403		for i := 0; i < len(line); i++ {
   404			c := line[i]
   405			switch c {
   406			case '\'':
   407				if !inDouble {
   408					inSingle = !inSingle
   409				}
   410			case '"':
   411				if !inSingle {
   412					inDouble = !inDouble
   413				}
   414			case '#':
   415				if !inSingle && !inDouble && (i == 0 || line[i-1] == ' ' || line[i-1] == '\t') {
   416					return line[:i]
   417				}
   418			}
   419		}
   420		return line
   421	}
   422	
   423	func parseFlow(s string) (interface{}, error) {
   424		s = strings.TrimSpace(s)
   425		if strings.HasPrefix(s, "[") {
   426			if !strings.HasSuffix(s, "]") {
   427				return nil, fmt.Errorf("unterminated flow sequence")
   428			}
   429			inner := s[1 : len(s)-1]
   430			if strings.TrimSpace(inner) == "" {
   431				return []interface{}{}, nil
   432			}
   433			parts := splitFlow(inner)
   434			list := []interface{}{}
   435			for _, p := range parts {
   436				v, err := parseFlowOrScalar(strings.TrimSpace(p))
   437				if err != nil {
   438					return nil, err
   439				}
   440				list = append(list, v)
   441			}
   442			return list, nil
   443		}
   444		if strings.HasPrefix(s, "{") {
   445			if !strings.HasSuffix(s, "}") {
   446				return nil, fmt.Errorf("unterminated flow mapping")
   447			}
   448			inner := s[1 : len(s)-1]
   449			if strings.TrimSpace(inner) == "" {
   450				return map[string]interface{}{}, nil
   451			}
   452			parts := splitFlow(inner)
   453			m := map[string]interface{}{}
   454			for _, p := range parts {
   455				key, val, err := splitKeyValue(strings.TrimSpace(p))
   456				if err != nil {
   457					return nil, err
   458				}
   459				v, err := parseFlowOrScalar(strings.TrimSpace(val))
   460				if err != nil {
   461					return nil, err
   462				}
   463				m[key] = v
   464			}
   465			return m, nil
   466		}
   467		return parseScalar(s), nil
   468	}
   469	
   470	func splitFlow(s string) []string {
   471		parts := []string{}
   472		depth := 0
   473		inSingle := false
   474		inDouble := false
   475		start := 0
   476		for i := 0; i < len(s); i++ {
   477			c := s[i]
   478			switch c {
   479			case '\'':
   480				if !inDouble {
   481					inSingle = !inSingle
   482				}
   483			case '"':
   484				if !inSingle {
   485					inDouble = !inDouble
   486				}
   487			case '[', '{':
   488				if !inSingle && !inDouble {
   489					depth++
   490				}
   491			case ']', '}':
   492				if !inSingle && !inDouble {
   493					depth--
   494				}
   495			case ',':
   496				if depth == 0 && !inSingle && !inDouble {
   497					parts = append(parts, s[start:i])
   498					start = i + 1
   499				}
   500			}
   501		}
   502		parts = append(parts, s[start:])
   503		return parts
   504	}
