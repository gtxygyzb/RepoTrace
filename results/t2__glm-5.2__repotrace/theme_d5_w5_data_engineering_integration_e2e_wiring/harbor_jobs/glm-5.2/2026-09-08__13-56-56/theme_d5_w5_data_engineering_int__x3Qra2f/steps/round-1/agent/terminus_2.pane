type SortStage struct {
	keys []SortKey
}

func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	for _, key := range s.keys {
		if key.As == "number" {
			for _, r := range in {
				v, ok := r.Get(key.Column)
				if !ok || v == "" {
					continue
				}
				if _, err := parseFloat(v); err != nil {
					return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
				}
			}
		}
	}

	sort.SliceStable(in, func(i, j int) bool {
		for _, key := range s.keys {
			a, aok := in[i].Get(key.Column)
			b, bok := in[j].Get(key.Column)

			if key.As == "number" {
				aMissing := !aok || a == ""
				bMissing := !bok || b == ""
				if aMissing != bMissing {
					if key.Order == "desc" {
						return bMissing
					}
					return aMissing
				}
				if aMissing {
					continue
				}
				af, errA := parseFloat(a)
				bf, errB := parseFloat(b)
				if errA != nil || errB != nil {
					return false
				}
				if af != bf {
					if key.Order == "desc" {
						return af > bf
					}
					return af < bf
				}
			} else {
				aMissing := !aok || a == ""
				bMissing := !bok || b == ""
				if aMissing != bMissing {
					if key.Order == "desc" {
						return aMissing
					}
