[?2004l     1	package stage
     2	
     3	import (
     4		"fmt"
     5		"io"
     6		"math"
     7		"sort"
     8		"strconv"
     9	
    10		"example.com/flowctl/internal/record"
    11	)
    12	
    13	type Stats struct {
    14		Processed         int
    15		Emitted           int
    16		DroppedNonNumeric int
    17		DroppedMissing    int
    18		missingReported   bool
    19	}
    20	
    21	type Stage interface {
    22		Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error)
    23	}
    24	
    25	func Build(rawStages []map[string]interface{}) ([]Stage, error) {
    26		stages := make([]Stage, 0, len(rawStages))
    27		for i, sm := range rawStages {
    28			typ, ok := getString(sm, "type")
    29			if !ok || typ == "" {
    30				return nil, fmt.Errorf("config: stage %d: type is required", i+1)
    31			}
    32	
    33			var st Stage
    34			var err error
    35			switch typ {
    36			case "filter":
    37				st, err = buildFilter(i+1, sm)
    38			case "project":
    39				st, err = buildProject(i+1, sm)
    40			case "sort":
    41				st, err = buildSort(i+1, sm)
    42			case "limit":
    43				st, err = buildLimit(i+1, sm)
    44			default:
    45				return nil, fmt.Errorf("config: stage %d: unknown stage type %q", i+1, typ)
    46			}
    47			if err != nil {
    48				return nil, err
    49			}
    50			stages = append(stages, st)
    51		}
    52		return stages, nil
    53	}
    54	
    55	type FilterStage struct {
    56		column string
    57		op     string
    58		value  string
    59	}
    60	
    61	func (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    62		out := make([]*record.Record, 0, len(in))
    63	
    64		for _, r := range in {
    65			v, ok := r.Get(s.column)
    66			if !ok {
    67				stats.DroppedMissing++
    68				if !stats.missingReported {
    69					fmt.Fprintf(stderr, "flowctl: filter: missing column %s\n", s.column)
    70					stats.missingReported = true
    71				}
    72				if strict {
    73					return nil, fmt.Errorf("filter: missing column %s", s.column)
    74				}
    75				continue
    76			}
    77	
    78			keep := false
    79			switch s.op {
    80			case "==":
    81				keep = v == s.value
    82			case "!=":
    83				keep = v != s.value
    84			default:
    85				left, err := parseFloat(v)
    86				if err != nil {
    87					stats.DroppedNonNumeric++
    88					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
    89					if strict {
    90						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
    91					}
    92					continue
    93				}
    94				right, err := parseFloat(s.value)
    95				if err != nil {
    96					stats.DroppedNonNumeric++
    97					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
    98					if strict {
    99						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   100					}
   101					continue
   102				}
   103				keep = compareFloats(left, s.op, right)
   104			}
   105	
   106			if keep {
   107				out = append(out, r)
   108			}
   109		}
   110	
   111		return out, nil
   112	}
   113	
   114	type ProjectColumn struct {
   115		Source string
   116		Target string
   117	}
   118	
   119	type ProjectStage struct {
   120		columns []ProjectColumn
   121	}
   122	
   123	func (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   124		out := make([]*record.Record, 0, len(in))
   125		for _, r := range in {
   126			nr := record.New()
   127			nr.InputRow = r.InputRow
   128			for _, c := range s.columns {
   129				val := ""
   130				if v, ok := r.Get(c.Source); ok {
   131					val = v
   132				}
   133				nr.Set(c.Target, val)
   134			}
   135			out = append(out, nr)
   136		}
   137		return out, nil
   138	}
   139	
   140	type SortKey struct {
   141		Column string
   142		Order  string
   143		As     string
   144	}
   145	
   146	type SortStage struct {
   147		keys []SortKey
   148	}
   149	
   150	func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   151		for _, key := range s.keys {
   152			if key.As == "number" {
   153				for _, r := range in {
   154					v, ok := r.Get(key.Column)
   155					if !ok {
   156						return nil, fmt.Errorf("sort: column %s is missing", key.Column)
   157					}
   158					if _, err := parseFloat(v); err != nil {
   159						return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
   160					}
   161				}
   162			}
   163		}
   164	
   165		sort.SliceStable(in, func(i, j int) bool {
   166			for _, key := range s.keys {
   167				a, _ := in[i].Get(key.Column)
   168				b, _ := in[j].Get(key.Column)
   169	
   170				if key.As == "number" {
   171					af, _ := parseFloat(a)
   172					bf, _ := parseFloat(b)
   173					if af != bf {
   174						if key.Order == "desc" {
   175							return af > bf
   176						}
   177						return af < bf
   178					}
   179				} else {
   180					if a != b {
   181						if key.Order == "desc" {
   182							return a > b
   183						}
   184						return a < b
   185					}
   186				}
   187			}
   188			return false
   189		})
   190	
   191		return in, nil
   192	}
   193	
   194	type LimitStage struct {
   195		count int
   196	}
   197	
   198	func (s *LimitStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   199		if s.count < len(in) {
   200			return in[:s.count], nil
   201		}
   202		return in, nil
   203	}
   204	
   205	func buildFilter(idx int, sm map[string]interface{}) (Stage, error) {
   206		whereRaw, ok := sm["where"]
   207		if !ok {
   208			return nil, fmt.Errorf("config: stage %d: filter.where is required", idx)
   209		}
   210		where, ok := whereRaw.(map[string]interface{})
   211		if !ok {
   212			return nil, fmt.Errorf("config: stage %d: filter.where must be a mapping", idx)
   213		}
   214	
   215		column, ok := getString(where, "column")
   216		if !ok || column == "" {
   217			return nil, fmt.Errorf("config: stage %d: filter.where.column is required", idx)
   218		}
   219	
   220		op, ok := getString(where, "op")
   221		if !ok || op == "" {
   222			return nil, fmt.Errorf("config: stage %d: filter.where.op is required", idx)
   223		}
   224		switch op {
   225		case "==", "!=", "<", "<=", ">", ">=":
   226		default:
   227			return nil, fmt.Errorf("config: stage %d: filter.where.op is invalid", idx)
   228		}
   229	
   230		value, ok := getString(where, "value")
   231		if !ok {
   232			return nil, fmt.Errorf("config: stage %d: filter.where.value is required", idx)
   233		}
   234	
   235		return &FilterStage{column: column, op: op, value: value}, nil
   236	}
   237	
   238	func buildProject(idx int, sm map[string]interface{}) (Stage, error) {
   239		colsRaw, ok := sm["columns"]
   240		if !ok {
   241			return nil, fmt.Errorf("config: stage %d: project.columns is required", idx)
   242		}
   243		list, ok := colsRaw.([]interface{})
   244		if !ok {
   245			return nil, fmt.Errorf("config: stage %d: project.columns must be a list", idx)
   246		}
   247	
   248		columns := make([]ProjectColumn, 0, len(list))
   249		seen := map[string]bool{}
   250		for j, item := range list {
   251			switch v := item.(type) {
   252			case string:
   253				if seen[v] {
   254					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, v)
   255				}
   256				seen[v] = true
   257				columns = append(columns, ProjectColumn{Source: v, Target: v})
   258			case map[string]interface{}:
   259				name, ok := getString(v, "name")
   260				if !ok || name == "" {
   261					return nil, fmt.Errorf("config: stage %d: project column %d name is required", idx, j+1)
   262				}
   263				as, ok := getString(v, "as")
   264				if !ok || as == "" {
   265					return nil, fmt.Errorf("config: stage %d: project column %d as is required", idx, j+1)
   266				}
   267				if seen[as] {
   268					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, as)
   269				}
   270				seen[as] = true
   271				columns = append(columns, ProjectColumn{Source: name, Target: as})
   272			default:
   273				return nil, fmt.Errorf("config: stage %d: project column %d must be a string or mapping", idx, j+1)
   274			}
   275		}
   276	
   277		return &ProjectStage{columns: columns}, nil
   278	}
   279	
   280	func buildSort(idx int, sm map[string]interface{}) (Stage, error) {
   281		keysRaw, ok := sm["keys"]
   282		if !ok {
   283			return nil, fmt.Errorf("config: stage %d: sort.keys is required", idx)
   284		}
   285		list, ok := keysRaw.([]interface{})
   286		if !ok {
   287			return nil, fmt.Errorf("config: stage %d: sort.keys must be a list", idx)
   288		}
   289	
   290		keys := make([]SortKey, 0, len(list))
   291		for j, item := range list {
   292			km, ok := item.(map[string]interface{})
   293			if !ok {
   294				return nil, fmt.Errorf("config: stage %d: sort key %d must be a mapping", idx, j+1)
   295			}
   296	
   297			column, ok := getString(km, "column")
   298			if !ok || column == "" {
   299				return nil, fmt.Errorf("config: stage %d: sort key %d column is required", idx, j+1)
   300			}
   301	
   302			order, ok := getString(km, "order")
   303			if !ok || order == "" {
   304				order = "asc"
   305			}
   306			if order != "asc" && order != "desc" {
   307				return nil, fmt.Errorf("config: stage %d: sort key %d order must be asc or desc", idx, j+1)
   308			}
   309	
   310			as, ok := getString(km, "as")
   311			if !ok || as == "" {
   312				as = "string"
   313			}
   314			if as != "string" && as != "number" {
   315				return nil, fmt.Errorf("config: stage %d: sort key %d as must be string or number", idx, j+1)
   316			}
   317	
   318			keys = append(keys, SortKey{Column: column, Order: order, As: as})
   319		}
   320	
   321		return &SortStage{keys: keys}, nil
   322	}
   323	
   324	func buildLimit(idx int, sm map[string]interface{}) (Stage, error) {
   325		countRaw, ok := sm["count"]
   326		if !ok {
   327			return nil, fmt.Errorf("config: stage %d: limit.count is required", idx)
   328		}
   329		countStr, ok := countRaw.(string)
   330		if !ok {
   331			return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
   332		}
   333		n, err := strconv.Atoi(countStr)
   334		if err != nil || n < 0 {
   335			return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
   336		}
   337	
   338		return &LimitStage{count: n}, nil
   339	}
   340	
   341	func getString(m map[string]interface{}, key string) (string, bool) {
   342		v, ok := m[key]
   343		if !ok {
   344			return "", false
   345		}
   346		if s, ok := v.(string); ok {
   347			return s, true
   348		}
   349		return fmt.Sprintf("%v", v), true
   350	}
   351	
   352	func parseFloat(s string) (float64, error) {
   353		f, err := strconv.ParseFloat(s, 64)
   354		if err != nil {
   355			return 0, err
   356		}
   357		if math.IsNaN(f) || math.IsInf(f, 0) {
   358			return 0, fmt.Errorf("not a finite number")
   359		}
   360		return f, nil
   361	}
   362	
   363	func compareFloats(left float64, op string, right float64) bool {
   364		switch op {
   365		case "<":
   366			return left < right
   367		case "<=":
   368			return left <= right
   369		case ">":
   370			return left > right
   371		case ">=":
   372			return left >= right
   373		}
   374		return false
   375	}
