[?2004lpackage record

type Record struct {
	Order    []string
	Values   map[string]string
	InputRow int
}

func New() *Record {
	return &Record{
		Order:  []string{},
		Values: map[string]string{},
	}
}

func (r *Record) Set(key, val string) {
	if _, ok := r.Values[key]; !ok {
		r.Order = append(r.Order, key)
	}
	r.Values[key] = val
}

func (r *Record) Get(key string) (string, bool) {
	v, ok := r.Values[key]
	return v, ok
}

func (r *Record) Has(key string) bool {
	_, ok := r.Values[key]
	return ok
}

func (r *Record) Copy() *Record {
	nr := New()
	nr.InputRow = r.InputRow
	for _, k := range r.Order {
		nr.Set(k, r.Values[k])
	}
	return nr
}
[?2004hroot@n30009:/app# sed -n '1,320p' internal/input/input.go
[?2004lpackage input

import (
	"bufio"
	"encoding/csv"
	"encoding/json"
	"fmt"
	"io"
	"os"
	"strings"

	"example.com/flowctl/internal/config"
	"example.com/flowctl/internal/record"
)

func Read(cfg config.InputConfig, dir string) ([]*record.Record, error) {
	switch cfg.Format {
	case "csv":
		return readCSV(cfg, dir)
	case "ndjson":
		return readNDJSON(cfg, dir)
	default:
		return nil, fmt.Errorf("input: unsupported format %q", cfg.Format)
	}
}

func readCSV(cfg config.InputConfig, dir string) ([]*record.Record, error) {
	path := config.ResolvePath(dir, cfg.Path)
	f, err := os.Open(path)
	if err != nil {
		return nil, fmt.Errorf("input: %v", err)
	}
	defer f.Close()

	r := csv.NewReader(f)
	r.FieldsPerRecord = 0
	r.TrimLeadingSpace = true

	header, err := r.Read()
	if err == io.EOF {
		return nil, fmt.Errorf("input: empty CSV file")
	}
	if err != nil {
		return nil, fmt.Errorf("input: %v", err)
	}

	records := []*record.Record{}
	rowNum := 0
	for {
		row, err := r.Read()
		if err == io.EOF {
			break
		}
		if err != nil {
			return nil, fmt.Errorf("input: row %d: %v", rowNum+2, err)
		}
		rowNum++

		if len(row) != len(header) {
			return nil, fmt.Errorf("input: row %d: expected %d fields got %d", rowNum+1, len(header), len(row))
		}

		rec := record.New()
		rec.InputRow = rowNum
		for i, col := range header {
			rec.Set(col, row[i])
		}
		records = append(records, rec)
	}

	return records, nil
}

func readNDJSON(cfg config.InputConfig, dir string) ([]*record.Record, error) {
	path := config.ResolvePath(dir, cfg.Path)
	f, err := os.Open(path)
	if err != nil {
		return nil, fmt.Errorf("input: %v", err)
	}
	defer f.Close()

	scanner := bufio.NewScanner(f)
	scanner.Buffer(make([]byte, 0, 1024*1024), 64*1024*1024)

	records := []*record.Record{}
	lineNum := 0
	recNum := 0
	for scanner.Scan() {
		lineNum++
		line := scanner.Text()
		if strings.TrimSpace(line) == "" {
			continue
		}

		rec, err := parseNDJSONLine(line, lineNum)
		if err != nil {
			return nil, fmt.Errorf("input: line %d: %v", lineNum, err)
		}
		recNum++
		rec.InputRow = recNum
		records = append(records, rec)
	}
	if err := scanner.Err(); err != nil {
		return nil, fmt.Errorf("input: %v", err)
	}

	return records, nil
}

func parseNDJSONLine(line string, lineNum int) (*record.Record, error) {
	dec := json.NewDecoder(strings.NewReader(line))

	t, err := dec.Token()
	if err != nil {
		return nil, fmt.Errorf("invalid JSON: %v", err)
	}
	if t != json.Delim('{') {
		return nil, fmt.Errorf("line is not a JSON object")
	}

	rec := record.New()
	for {
		t, err := dec.Token()
		if err == io.EOF {
			return nil, fmt.Errorf("unexpected end of object")
		}
		if err != nil {
			return nil, fmt.Errorf("invalid JSON: %v", err)
		}
		if t == json.Delim('}') {
			break
		}

		key, ok := t.(string)
		if !ok {
			return nil, fmt.Errorf("object key is not a string")
		}

		vt, err := dec.Token()
		if err != nil {
			return nil, fmt.Errorf("value for %q: %v", key, err)
		}
		s, ok := vt.(string)
		if !ok {
			return nil, fmt.Errorf("value for %q is not a JSON string", key)
		}
		rec.Set(key, s)
	}

	if dec.More() {
		return nil, fmt.Errorf("unexpected trailing content")
	}

	return rec, nil
}
[?2004hroot@n30009:/app# sed -n '1,360p' internal/stage/stage.go
[?2004lpackage stage

import (
	"fmt"
	"io"
	"math"
	"sort"
	"strconv"

	"example.com/flowctl/internal/record"
)

type Stats struct {
	Processed         int
	Emitted           int
	DroppedNonNumeric int
	DroppedMissing    int
	missingReported   bool
}

type Stage interface {
	Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error)
}

func Build(rawStages []map[string]interface{}) ([]Stage, error) {
	stages := make([]Stage, 0, len(rawStages))
	for i, sm := range rawStages {
		typ, ok := getString(sm, "type")
		if !ok || typ == "" {
			return nil, fmt.Errorf("config: stage %d: type is required", i+1)
		}

		var st Stage
		var err error
		switch typ {
		case "filter":
			st, err = buildFilter(i+1, sm)
		case "project":
			st, err = buildProject(i+1, sm)
		case "sort":
			st, err = buildSort(i+1, sm)
		case "limit":
			st, err = buildLimit(i+1, sm)
		default:
			return nil, fmt.Errorf("config: stage %d: unknown stage type %q", i+1, typ)
		}
		if err != nil {
			return nil, err
		}
		stages = append(stages, st)
	}
	return stages, nil
}

type FilterStage struct {
	column string
	op     string
	value  string
}

func (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	out := make([]*record.Record, 0, len(in))

	for _, r := range in {
		v, ok := r.Get(s.column)
		if !ok {
			stats.DroppedMissing++
			if !stats.missingReported {
				fmt.Fprintf(stderr, "flowctl: filter: missing column %s\n", s.column)
				stats.missingReported = true
			}
			if strict {
				return nil, fmt.Errorf("filter: missing column %s", s.column)
			}
			continue
		}

		keep := false
		switch s.op {
		case "==":
			keep = v == s.value
		case "!=":
			keep = v != s.value
		default:
			left, err := parseFloat(v)
			if err != nil {
				stats.DroppedNonNumeric++
				fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
				if strict {
					return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
				}
				continue
			}
			right, err := parseFloat(s.value)
			if err != nil {
				stats.DroppedNonNumeric++
				fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
				if strict {
					return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
				}
				continue
			}
			keep = compareFloats(left, s.op, right)
		}

		if keep {
			out = append(out, r)
		}
	}

	return out, nil
}

type ProjectColumn struct {
	Source string
	Target string
}

type ProjectStage struct {
	columns []ProjectColumn
}

func (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	out := make([]*record.Record, 0, len(in))
	for _, r := range in {
		nr := record.New()
		nr.InputRow = r.InputRow
		for _, c := range s.columns {
			val := ""
			if v, ok := r.Get(c.Source); ok {
				val = v
			}
			nr.Set(c.Target, val)
		}
		out = append(out, nr)
	}
	return out, nil
}

type SortKey struct {
	Column string
	Order  string
	As     string
}

type SortStage struct {
	keys []SortKey
}

func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	for _, key := range s.keys {
		if key.As == "number" {
			for _, r := range in {
				v, ok := r.Get(key.Column)
				if !ok {
					return nil, fmt.Errorf("sort: column %s is missing", key.Column)
				}
				if _, err := parseFloat(v); err != nil {
					return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
				}
			}
		}
	}

	sort.SliceStable(in, func(i, j int) bool {
		for _, key := range s.keys {
			a, _ := in[i].Get(key.Column)
			b, _ := in[j].Get(key.Column)

			if key.As == "number" {
				af, _ := parseFloat(a)
				bf, _ := parseFloat(b)
				if af != bf {
					if key.Order == "desc" {
						return af > bf
					}
					return af < bf
				}
			} else {
				if a != b {
					if key.Order == "desc" {
						return a > b
					}
					return a < b
				}
			}
		}
		return false
	})

	return in, nil
}

type LimitStage struct {
	count int
}

func (s *LimitStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	if s.count < len(in) {
		return in[:s.count], nil
	}
	return in, nil
}

func buildFilter(idx int, sm map[string]interface{}) (Stage, error) {
	whereRaw, ok := sm["where"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: filter.where is required", idx)
	}
	where, ok := whereRaw.(map[string]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stage %d: filter.where must be a mapping", idx)
	}

	column, ok := getString(where, "column")
	if !ok || column == "" {
		return nil, fmt.Errorf("config: stage %d: filter.where.column is required", idx)
	}

	op, ok := getString(where, "op")
	if !ok || op == "" {
		return nil, fmt.Errorf("config: stage %d: filter.where.op is required", idx)
	}
	switch op {
	case "==", "!=", "<", "<=", ">", ">=":
	default:
		return nil, fmt.Errorf("config: stage %d: filter.where.op is invalid", idx)
	}

	value, ok := getString(where, "value")
	if !ok {
		return nil, fmt.Errorf("config: stage %d: filter.where.value is required", idx)
	}

	return &FilterStage{column: column, op: op, value: value}, nil
}

func buildProject(idx int, sm map[string]interface{}) (Stage, error) {
	colsRaw, ok := sm["columns"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: project.columns is required", idx)
	}
	list, ok := colsRaw.([]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stage %d: project.columns must be a list", idx)
	}

	columns := make([]ProjectColumn, 0, len(list))
	seen := map[string]bool{}
	for j, item := range list {
		switch v := item.(type) {
		case string:
			if seen[v] {
				return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, v)
			}
			seen[v] = true
			columns = append(columns, ProjectColumn{Source: v, Target: v})
		case map[string]interface{}:
			name, ok := getString(v, "name")
			if !ok || name == "" {
				return nil, fmt.Errorf("config: stage %d: project column %d name is required", idx, j+1)
			}
			as, ok := getString(v, "as")
			if !ok || as == "" {
				return nil, fmt.Errorf("config: stage %d: project column %d as is required", idx, j+1)
			}
			if seen[as] {
				return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, as)
			}
			seen[as] = true
			columns = append(columns, ProjectColumn{Source: name, Target: as})
		default:
			return nil, fmt.Errorf("config: stage %d: project column %d must be a string or mapping", idx, j+1)
		}
	}

	return &ProjectStage{columns: columns}, nil
}

func buildSort(idx int, sm map[string]interface{}) (Stage, error) {
	keysRaw, ok := sm["keys"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: sort.keys is required", idx)
	}
	list, ok := keysRaw.([]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stage %d: sort.keys must be a list", idx)
	}

	keys := make([]SortKey, 0, len(list))
	for j, item := range list {
		km, ok := item.(map[string]interface{})
		if !ok {
			return nil, fmt.Errorf("config: stage %d: sort key %d must be a mapping", idx, j+1)
		}

		column, ok := getString(km, "column")
		if !ok || column == "" {
			return nil, fmt.Errorf("config: stage %d: sort key %d column is required", idx, j+1)
		}

		order, ok := getString(km, "order")
		if !ok || order == "" {
			order = "asc"
		}
		if order != "asc" && order != "desc" {
			return nil, fmt.Errorf("config: stage %d: sort key %d order must be asc or desc", idx, j+1)
		}

		as, ok := getString(km, "as")
		if !ok || as == "" {
			as = "string"
		}
		if as != "string" && as != "number" {
			return nil, fmt.Errorf("config: stage %d: sort key %d as must be string or number", idx, j+1)
		}

		keys = append(keys, SortKey{Column: column, Order: order, As: as})
	}

	return &SortStage{keys: keys}, nil
}

func buildLimit(idx int, sm map[string]interface{}) (Stage, error) {
	countRaw, ok := sm["count"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: limit.count is required", idx)
	}
	countStr, ok := countRaw.(string)
	if !ok {
		return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
	}
	n, err := strconv.Atoi(countStr)
	if err != nil || n < 0 {
		return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
	}

	return &LimitStage{count: n}, nil
}

func getString(m map[string]interface{}, key string) (string, bool) {
	v, ok := m[key]
	if !ok {
		return "", false
	}
	if s, ok := v.(string); ok {
		return s, true
	}
	return fmt.Sprintf("%v", v), true
}

func parseFloat(s string) (float64, error) {
	f, err := strconv.ParseFloat(s, 64)
	if err != nil {
		return 0, err
	}
	if math.IsNaN(f) || math.IsInf(f, 0) {
		return 0, fmt.Errorf("not a finite number")
	}
	return f, nil
[?2004hroot@n30009:/app# sed -n '1,260p' internal/pipeline/pipeline.go
[?2004lpackage pipeline

import (
	"os"

	"example.com/flowctl/internal/config"
	"example.com/flowctl/internal/input"
	"example.com/flowctl/internal/output"
	"example.com/flowctl/internal/stage"
)

func Run(cfg *config.Config) (*stage.Stats, error) {
	stats := &stage.Stats{}

	stages, err := stage.Build(cfg.Stages)
	if err != nil {
		return stats, err
	}

	records, err := input.Read(cfg.Input, cfg.Dir)
	if err != nil {
		return stats, err
	}
	stats.Processed = len(records)

	for _, st := range stages {
		records, err = st.Apply(records, os.Stderr, cfg.Strict, stats)
		if err != nil {
			return stats, err
		}
	}

	n, err := output.Write(records, cfg.Output, cfg.Dir)
	if err != nil {
		return stats, err
	}
	stats.Emitted = n

	return stats, nil
}
[?2004hroot@n30009:/app# sed -n '1,220p' internal/output/output.go
[?2004lpackage output

import (
	"bytes"
	"fmt"
	"os"
	"path/filepath"
	"strings"

	"example.com/flowctl/internal/config"
	"example.com/flowctl/internal/record"
)

func Write(records []*record.Record, cfg config.OutputConfig, dir string) (int, error) {
	var buf bytes.Buffer

	for _, r := range records {
		if cfg.ColumnsPresent {
			writeObject(&buf, cfg.Columns, r)
		} else {
			writeObject(&buf, r.Order, r)
		}
		buf.WriteByte('\n')
	}

	if cfg.Path == "-" {
		if _, err := os.Stdout.Write(buf.Bytes()); err != nil {
			return 0, fmt.Errorf("output: %v", err)
		}
		return len(records), nil
	}

	full := config.ResolvePath(dir, cfg.Path)
	dirName := filepath.Dir(full)

	tmp, err := os.CreateTemp(dirName, ".flowctl-output-*")
	if err != nil {
		return 0, fmt.Errorf("output: %v", err)
	}

	if _, err := tmp.Write(buf.Bytes()); err != nil {
		tmp.Close()
		os.Remove(tmp.Name())
		return 0, fmt.Errorf("output: %v", err)
	}
	if err := tmp.Close(); err != nil {
		os.Remove(tmp.Name())
		return 0, fmt.Errorf("output: %v", err)
	}
	if err := os.Rename(tmp.Name(), full); err != nil {
		os.Remove(tmp.Name())
		return 0, fmt.Errorf("output: %v", err)
	}

	return len(records), nil
}

func writeObject(buf *bytes.Buffer, cols []string, r *record.Record) {
	buf.WriteByte('{')
	for i, col := range cols {
		if i > 0 {
			buf.WriteByte(',')
		}
		buf.WriteString(encodeJSONString(col))
		buf.WriteByte(':')
		val := ""
		if v, ok := r.Get(col); ok {
			val = v
		}
		buf.WriteString(encodeJSONString(val))
	}
	buf.WriteByte('}')
}

func encodeJSONString(s string) string {
	var b strings.Builder
	b.WriteByte('"')
	for i := 0; i < len(s); i++ {
		c := s[i]
		switch c {
		case '\\':
			b.WriteString("\\\\")
		case '"':
			b.WriteString("\\\"")
		case '\n':
			b.WriteString("\\n")
		case '\r':
			b.WriteString("\\r")
		case '\t':
			b.WriteString("\\t")
		default:
			if c < 0x20 {
				fmt.Fprintf(&b, "\\u%04x", c)
			} else {
				b.WriteByte(c)
			}
		}
	}
	b.WriteByte('"')
	return b.String()
}
[?2004hroot@n30009:/app# sed -n '1,220p' cmd/flowctl/main.go
[?2004lpackage main

import (
	"fmt"
	"os"
	"strings"

	"example.com/flowctl/internal/config"
	"example.com/flowctl/internal/pipeline"
)

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintf(os.Stderr, "flowctl: usage: flowctl run --config <path> [--strict]\n")
		os.Exit(2)
	}

	if os.Args[1] != "run" {
		fmt.Fprintf(os.Stderr, "flowctl: unknown command %q\n", os.Args[1])
		os.Exit(2)
	}

	args := os.Args[2:]
	configPath := ""
	strict := false

	for i := 0; i < len(args); i++ {
		arg := args[i]
		switch {
		case arg == "--config":
			if i+1 >= len(args) {
				fmt.Fprintf(os.Stderr, "flowctl: --config requires a value\n")
				os.Exit(2)
			}
			configPath = args[i+1]
			i++
		case strings.HasPrefix(arg, "--config="):
			configPath = strings.TrimPrefix(arg, "--config=")
		case arg == "--strict":
			strict = true
		default:
			fmt.Fprintf(os.Stderr, "flowctl: unknown flag %q\n", arg)
			os.Exit(2)
		}
	}

	if configPath == "" {
		fmt.Fprintf(os.Stderr, "flowctl: --config is required\n")
		os.Exit(2)
	}

	cfg, err := config.Load(configPath)
	if err != nil {
		fmt.Fprintf(os.Stderr, "flowctl: %v\n", err)
		os.Exit(1)
	}
	cfg.Strict = strict

	stats, err := pipeline.Run(cfg)
	if err != nil {
		fmt.Fprintf(os.Stderr, "flowctl: %v\n", err)
		os.Exit(1)
	}

	fmt.Fprintf(os.Stderr, "flowctl: processed=%d emitted=%d dropped_nonnumeric=%d dropped_missing=%d\n",
		stats.Processed, stats.Emitted, stats.DroppedNonNumeric, stats.DroppedMissing)
}
