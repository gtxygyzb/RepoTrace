   213	func buildFilter(idx int, sm map[string]interface{}) (Stage, error) {
   214		whereRaw, ok := sm["where"]
   215		if !ok {
   216			return nil, fmt.Errorf("config: stage %d: filter.where is required", idx)
   217		}
   218		where, ok := whereRaw.(map[string]interface{})
   219		if !ok {
   220			return nil, fmt.Errorf("config: stage %d: filter.where must be a mapping", idx)
   221		}
   222	
   223		column, ok := getString(where, "column")
   224		if !ok || column == "" {
   225			return nil, fmt.Errorf("config: stage %d: filter.where.column is required", idx)
   226		}
   227	
   228		op, ok := getString(where, "op")
   229		if !ok || op == "" {
   230			return nil, fmt.Errorf("config: stage %d: filter.where.op is required", idx)
   231		}
   232		switch op {
   233		case "==", "!=", "<", "<=", ">", ">=":
   234		default:
   235			return nil, fmt.Errorf("config: stage %d: filter.where.op is invalid", idx)
   236		}
   237	
   238		value, ok := getString(where, "value")
   239		if !ok {
   240			return nil, fmt.Errorf("config: stage %d: filter.where.value is required", idx)
   241		}
   242	
   243		return &FilterStage{column: column, op: op, value: value}, nil
   244	}
   245	
   246	func buildProject(idx int, sm map[string]interface{}) (Stage, error) {
   247		colsRaw, ok := sm["columns"]
   248		if !ok {
   249			return nil, fmt.Errorf("config: stage %d: project.columns is required", idx)
   250		}
   251		list, ok := colsRaw.([]interface{})
   252		if !ok {
   253			return nil, fmt.Errorf("config: stage %d: project.columns must be a list", idx)
   254		}
   255	
   256		columns := make([]ProjectColumn, 0, len(list))
   257		seen := map[string]bool{}
   258		for j, item := range list {
   259			switch v := item.(type) {
   260			case string:
   261				if seen[v] {
   262					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, v)
   263				}
   264				seen[v] = true
   265				columns = append(columns, ProjectColumn{Source: v, Target: v})
   266			case map[string]interface{}:
   267				name, ok := getString(v, "name")
   268				if !ok || name == "" {
   269					return nil, fmt.Errorf("config: stage %d: project column %d name is required", idx, j+1)
   270				}
   271				as, ok := getString(v, "as")
   272				if !ok || as == "" {
   273					return nil, fmt.Errorf("config: stage %d: project column %d as is required", idx, j+1)
   274				}
   275				if seen[as] {
   276					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, as)
   277				}
   278				seen[as] = true
   279				columns = append(columns, ProjectColumn{Source: name, Target: as})
   280			default:
   281				return nil, fmt.Errorf("config: stage %d: project column %d must be a string or mapping", idx, j+1)
   282			}
   283		}
   284	
   285		return &ProjectStage{columns: columns}, nil
   286	}
