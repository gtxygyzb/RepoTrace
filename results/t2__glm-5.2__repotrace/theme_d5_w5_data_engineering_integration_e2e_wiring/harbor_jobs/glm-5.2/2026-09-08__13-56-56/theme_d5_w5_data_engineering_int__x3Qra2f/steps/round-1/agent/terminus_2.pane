    69	type FilterStage struct {
    70		column string
    71		op     string
    72		value  string
    73	}
    74	
    75	func (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    76		out := make([]*record.Record, 0, len(in))
    77	
    78		for _, r := range in {
    79			v, ok := r.Get(s.column)
    80			if !ok {
    81				stats.DroppedMissing++
    82				if !stats.missingReported {
    83					fmt.Fprintf(stderr, "flowctl: filter: missing column %s\n", s.column)
    84					stats.missingReported = true
    85				}
    86				if strict {
    87					return nil, fmt.Errorf("filter: missing column %s", s.column)
    88				}
    89				continue
    90			}
    91	
    92			keep := false
    93			switch s.op {
    94			case "==":
    95				keep = v == s.value
    96			case "!=":
    97				keep = v != s.value
    98			default:
    99				left, err := parseFloat(v)
   100				if err != nil {
   101					stats.DroppedNonNumeric++
   102					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
   103					if strict {
   104						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   105					}
   106					continue
   107				}
   108				right, err := parseFloat(s.value)
   109				if err != nil {
   110					stats.DroppedNonNumeric++
   111					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
   112					if strict {
   113						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   114					}
   115					continue
   116				}
   117				keep = compareFloats(left, s.op, right)
   118			}
   119	
   120			if keep {
   121				out = append(out, r)
   122			}
   123		}
   124	
   125		return out, nil
   126	}
