   150	type SortKey struct {
   151		Column string
   152		Order  string
   153		As     string
   154	}
   155	
   156	type SortStage struct {
   157		keys []SortKey
   158	}
   159	
   160	func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   161		for _, key := range s.keys {
   162			if key.As == "number" {
   163				for _, r := range in {
   164					v, ok := r.Get(key.Column)
   165					if !ok || v == "" {
   166						continue
   167					}
   168					if _, err := parseFloat(v); err != nil {
   169						return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
   170					}
   171				}
   172			}
   173		}
   174	
   175		sort.SliceStable(in, func(i, j int) bool {
   176			for _, key := range s.keys {
   177				a, aok := in[i].Get(key.Column)
   178				b, bok := in[j].Get(key.Column)
   179	
   180				if key.As == "number" {
   181					aMissing := !aok || a == ""
   182					bMissing := !bok || b == ""
   183					if aMissing != bMissing {
   184						if key.Order == "desc" {
   185							return bMissing
   186						}
   187						return aMissing
   188					}
   189					if aMissing {
   190						continue
   191					}
   192					af, errA := parseFloat(a)
   193					bf, errB := parseFloat(b)
   194					if errA != nil || errB != nil {
   195						return false
   196					}
   197					if af != bf {
   198						if key.Order == "desc" {
   199							return af > bf
   200						}
   201						return af < bf
   202					}
   203				} else {
   204					if a != b {
   205						if key.Order == "desc" {
   206							return a > b
   207						}
   208						return a < b
   209					}
   210				}
   211			}
   212			return false
   213		})
   214	
   215		return in, nil
   216	}
   217	
   218	type LimitStage struct {
   219		count int
   220	}
   221	
   222	func (s *LimitStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   223		if s.count < len(in) {
   224			return in[:s.count], nil
   225		}
   226		return in, nil
   227	}
   228	
   229	func buildFilter(idx int, sm map[string]interface{}) (Stage, error) {
   230		whereRaw, ok := sm["where"]
   231		if !ok {
   232			return nil, fmt.Errorf("config: stage %d: filter.where is required", idx)
   233		}
   234		where, ok := whereRaw.(map[string]interface{})
   235		if !ok {
   236			return nil, fmt.Errorf("config: stage %d: filter.where must be a mapping", idx)
   237		}
   238	
   239		column, ok := getString(where, "column")
   240		if !ok || column == "" {
   241			return nil, fmt.Errorf("config: stage %d: filter.where.column is required", idx)
   242		}
   243	
   244		op, ok := getString(where, "op")
   245		if !ok || op == "" {
   246			return nil, fmt.Errorf("config: stage %d: filter.where.op is required", idx)
   247		}
   248		switch op {
   249		case "==", "!=", "<", "<=", ">", ">=":
   250		default:
   251			return nil, fmt.Errorf("config: stage %d: filter.where.op is invalid", idx)
   252		}
   253	
   254		value, ok := getString(where, "value")
   255		if !ok {
   256			return nil, fmt.Errorf("config: stage %d: filter.where.value is required", idx)
   257		}
   258	
   259		return &FilterStage{column: column, op: op, value: value}, nil
   260	}
