[?2004lpackage stage

import (
	"fmt"
	"io"
	"strings"

	"example.com/flowctl/internal/config"
	"example.com/flowctl/internal/input"
	"example.com/flowctl/internal/record"
)

type JoinStage struct {
	idx           int
	dir           string
	kind          string
	on            []string
	rightInput    config.InputConfig
	selectCols    []string
	selectPresent bool
	prefix        string
}

func buildJoin(idx int, sm map[string]interface{}, dir string) (Stage, error) {
	kind, ok := getString(sm, "kind")
	if !ok || kind == "" {
		return nil, fmt.Errorf("config: stage %d: join.kind is required", idx)
	}
	if kind != "inner" && kind != "left" {
		return nil, fmt.Errorf("config: stage %d: join.kind must be inner or left", idx)
	}

	onRaw, ok := sm["on"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: join.on is required", idx)
	}
	on, err := toStringList(onRaw)
	if err != nil {
		return nil, fmt.Errorf("config: stage %d: join.on %v", idx, err)
	}
	if len(on) == 0 {
		return nil, fmt.Errorf("config: stage %d: join.on must be non-empty", idx)
	}

	rightRaw, ok := sm["right"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: join.right is required", idx)
	}
	right, ok := rightRaw.(map[string]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stage %d: join.right must be a mapping", idx)
	}

	inRaw, ok := right["input"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: join.right.input is required", idx)
	}
	inMap, ok := inRaw.(map[string]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stage %d: join.right.input must be a mapping", idx)
	}
	ric, err := parseJoinInputConfig(idx, inMap)
	if err != nil {
		return nil, err
	}

	selectCols := []string{}
	selectPresent := false
	if selRaw, ok := right["select"]; ok {
		selectPresent = true
		selectCols, err = toStringList(selRaw)
		if err != nil {
			return nil, fmt.Errorf("config: stage %d: join.right.select %v", idx, err)
		}
	}

	prefix, _ := getString(right, "prefix")

	return &JoinStage{
		idx:           idx,
		dir:           dir,
		kind:          kind,
		on:            on,
		rightInput:    ric,
		selectCols:    selectCols,
		selectPresent: selectPresent,
		prefix:        prefix,
	}, nil
}

func parseJoinInputConfig(idx int, m map[string]interface{}) (config.InputConfig, error) {
	ic := config.InputConfig{}

	p, ok := getString(m, "path")
	if !ok || p == "" {
		return ic, fmt.Errorf("config: stage %d: join.right.input.path is required", idx)
	}
	ic.Path = p

	f, ok := getString(m, "format")
	if !ok || f == "" {
		return ic, fmt.Errorf("config: stage %d: join.right.input.format is required", idx)
	}
	ic.Format = f
	if ic.Format != "csv" && ic.Format != "ndjson" && ic.Format != "sqlite" {
		return ic, fmt.Errorf("config: stage %d: join.right.input.format must be csv, ndjson, or sqlite", idx)
	}

	if ic.Format == "sqlite" {
		q, ok := getString(m, "query")
		if !ok || q == "" {
			return ic, fmt.Errorf("config: stage %d: join.right.input.query is required", idx)
		}
		ic.Query = q
	}

	return ic, nil
}

func (s *JoinStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	rightRecords, err := input.Read(s.rightInput, s.dir)
	if err != nil {
		return nil, err
	}

	schema, err := s.resolveRightSchema(rightRecords)
	if err != nil {
		return nil, err
	}

	leftColumns := map[string]bool{}
	for _, r := range in {
		for _, k := range r.Order {
			leftColumns[k] = true
		}
	}
	for _, col := range schema {
		if s.isOn(col) {
			continue
		}
		name := s.prefix + col
		if leftColumns[name] {
			return nil, fmt.Errorf("config: join: column name collision: %s", name)
		}
	}

	index := map[string][]map[string]string{}
	for _, rr := range rightRecords {
		vals, err := s.projectRight(rr, schema)
		if err != nil {
			return nil, err
		}

		skip := false
		for _, col := range s.on {
			if vals[col] == "" {
				skip = true
				break
			}
		}
		if skip {
			continue
		}

		key := joinKey(s.on, vals)
		index[key] = append(index[key], vals)
	}

	out := make([]*record.Record, 0, len(in))
	for _, r := range in {
		for _, col := range s.on {
			if !r.Has(col) {
				return nil, fmt.Errorf("join: missing on column %s in left record", col)
			}
		}

		leftVals := map[string]string{}
		empty := false
		for _, col := range s.on {
			v, _ := r.Get(col)
			leftVals[col] = v
			if v == "" {
				empty = true
			}
		}

		var matches []map[string]string
		if !empty {
			matches = index[joinKey(s.on, leftVals)]
		}

		if len(matches) == 0 {
			if s.kind == "left" {
				nr := r.Copy()
				s.addRightColumns(nr, nil, schema)
				out = append(out, nr)
			}
			continue
		}

		for _, m := range matches {
			nr := r.Copy()
			s.addRightColumns(nr, m, schema)
			out = append(out, nr)
		}
	}

	return out, nil
}

func (s *JoinStage) resolveRightSchema(rightRecords []*record.Record) ([]string, error) {
	if s.selectPresent {
		return s.selectCols, nil
	}
	if len(rightRecords) == 0 {
		return []string{}, nil
	}
	return rightRecords[0].Order, nil
}

func (s *JoinStage) projectRight(rr *record.Record, schema []string) (map[string]string, error) {
	vals := make(map[string]string, len(schema))
	for _, col := range schema {
		v, ok := rr.Get(col)
		if !ok {
			if s.isOn(col) {
				return nil, fmt.Errorf("join: missing on column %s in right record", col)
			}
			v = ""
		}
		vals[col] = v
	}
	return vals, nil
}

func (s *JoinStage) addRightColumns(nr *record.Record, vals map[string]string, schema []string) {
	for _, col := range schema {
		if s.isOn(col) {
			continue
		}
		v := ""
		if vals != nil {
			v = vals[col]
		}
		nr.Set(s.prefix+col, v)
	}
}

func (s *JoinStage) isOn(col string) bool {
	for _, c := range s.on {
		if c == col {
			return true
		}
	}
	return false
}

func joinKey(on []string, vals map[string]string) string {
	parts := make([]string, 0, len(on)*2)
	for _, k := range on {
