type windowAggState struct {
	count    int
	sum      float64
	numVals  []float64
	distinct map[string]struct{}
	first    string
	last     string
	hasFirst bool
}

type windowRange struct {
	start float64
	end   float64
}

func (s *WindowStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	states := map[windowKey]*windowAggState{}
	var keyOrder []windowKey

	maxSeen := math.Inf(-1)

	ensureState := func(k windowKey) *windowAggState {
		if st, ok := states[k]; ok {
			return st
		}
		st := &windowAggState{distinct: map[string]struct{}{}}
		states[k] = st
		keyOrder = append(keyOrder, k)
		return st
	}

	for rowIdx, r := range in {
		rNum := rowIdx + 1
		tvStr, hasTime := r.Get(s.cfg.timeColumn)
		if !hasTime || tvStr == "" {
			switch s.cfg.onMissingTime {
			case "drop":
				stats.DroppedMissing++
				fmt.Fprintf(stderr, "flowctl: window: drop missing-time row %d\n", rNum)
				if strict {
					return nil, fmt.Errorf("strict: missing column %s", s.cfg.timeColumn)
				}
				continue
			default:
				return nil, fmt.Errorf("flowctl: window: missing column %s at row %d", s.cfg.timeColumn, rNum)
			}
		}

		tv, err := s.parseTime(tvStr)
		if err != nil {
			switch s.cfg.onNonParseable {
			case "drop":
				stats.DroppedNonNumeric++
				fmt.Fprintf(stderr, "flowctl: window: drop non-parseable-time row %d\n", rNum)
				if strict {
					return nil, fmt.Errorf("strict: non-parseable-time row %d", rNum)
				}
				continue
			default:
				return nil, fmt.Errorf("flowctl: window: non-parseable time value in column %s at row %d", s.cfg.timeColumn, rNum)
			}
		}

		late := tv < maxSeen-s.cfg.allowedLatenessVal
		if late {
			switch s.cfg.onLate {
[?2004hroot@n30009:/app# sed -n '145,225p' internal/stage/window.go
[?2004l		for i, col := range s.cfg.partitionBy {
			v, _ := r.Get(col)
			partVals[i] = v
		}
		partKey := strings.Join(partVals, "\x00")

		windows := s.windowsFor(tv, partVals, partKey, states, &keyOrder, ensureState, r, rNum, late)
		for _, w := range windows {
			k := windowKey{start: w.start, end: w.end, partition: partKey, partVals: partVals}
			st := ensureState(k)
			st.count++
			for _, agg := range s.cfg.aggregates {
				if err := s.applyAggregate(st, agg, r, rNum); err != nil {
					return nil, err
				}
			}
		}
	}

	keys := make([]windowKey, 0, len(states))
	for k := range states {
		keys = append(keys, k)
	}
	sort.Slice(keys, func(i, j int) bool {
		if keys[i].start != keys[j].start {
			return keys[i].start < keys[j].start
		}
		if keys[i].end != keys[j].end {
			return keys[i].end < keys[j].end
		}
		return keys[i].partition < keys[j].partition
	})

	out := make([]*record.Record, 0, len(keys)*len(s.cfg.aggregates))
	if s.cfg.emitSchema == "long" {
		if s.cfg.outOrder == "aggregate-first" {
			for _, agg := range s.cfg.aggregates {
				for _, k := range keys {
					st := states[k]
					val := s.renderOne(st, agg)
					out = append(out, s.buildLongRecord(k, partValsMap[k], agg.into, val))
				}
			}
		} else {
			for _, k := range keys {
				st := states[k]
				for _, agg := range s.cfg.aggregates {
					val := s.renderOne(st, agg)
					out = append(out, s.buildLongRecord(k, partValsMap[k], agg.into, val))
				}
			}
		}
	} else {
		for _, k := range keys {
			st := states[k]
			nr := record.New()
			for j, col := range s.cfg.partitionBy {
				nr.Set(col, partValsMap[k][j])
			}
			nr.Set(s.cfg.windowStartInto, s.renderTime(k.start))
			nr.Set(s.cfg.windowEndInto, s.renderTime(k.end))
			for _, agg := range s.cfg.aggregates {
				nr.Set(agg.into, s.renderOne(st, agg))
			}
			out = append(out, nr)
		}
	}

	return out, nil
}

func (s *WindowStage) buildLongRecord(k windowKey, name, val string) *record.Record {
	nr := record.New()
	for j, col := range s.cfg.partitionBy {
		nr.Set(col, partValsMap[k][j])
	}
	nr.Set(s.cfg.windowStartInto, s.renderTime(k.start))
	nr.Set(s.cfg.windowEndInto, s.renderTime(k.end))
	nr.Set(s.cfg.metricNameInto, name)
	nr.Set(s.cfg.metricValueInto, val)
	return nr
