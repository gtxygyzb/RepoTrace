   221	func (s *WindowStage) parseTime(v string) (float64, error) {
   222	switch s.cfg.timeFormat {
   223	case "unix_seconds":
   224	f, err := strconv.ParseFloat(v, 64)
   225	if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {
   226	return 0, fmt.Errorf("parse time")
   227	}
   228	return f, nil
   229	case "unix_millis":
   230	f, err := strconv.ParseFloat(v, 64)
   231	if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {
   232	return 0, fmt.Errorf("parse time")
   233	}
   234	return f, nil
