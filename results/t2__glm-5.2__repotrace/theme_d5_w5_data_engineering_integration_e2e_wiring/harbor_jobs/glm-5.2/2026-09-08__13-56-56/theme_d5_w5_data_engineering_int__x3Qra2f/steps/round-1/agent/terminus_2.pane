	op     string
	value  string
}

type DedupStage struct {
	idx      int
	by       []string
	keep     string
	on       string
	fallback string
	when     *dedupWhen
}

type dedupItem struct {
	pos      int
	r        *record.Record
	sentinel bool
	finite   bool
	num      float64
}

type dedupGroup struct {
	key      string
	items    []dedupItem
