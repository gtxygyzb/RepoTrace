    59		}
    60		if p, ok := getString(inMap, "path"); ok {
    61			cfg.Input.Path = p
    62		} else {
    63			return nil, fmt.Errorf("config: input.path is required")
    64		}
    65		if cfg.Input.Path == "" {
    66			return nil, fmt.Errorf("config: input.path is required")
    67		}
    68		if f, ok := getString(inMap, "format"); ok {
    69			cfg.Input.Format = f
    70		} else {
    71			return nil, fmt.Errorf("config: input.format is required")
    72		}
    73		if cfg.Input.Format == "" {
    74			return nil, fmt.Errorf("config: input.format is required")
    75		}
    76		if cfg.Input.Format != "csv" && cfg.Input.Format != "ndjson" && cfg.Input.Format != "sqlite" {
    77			return nil, fmt.Errorf("config: input.format must be csv, ndjson, or sqlite")
    78		}
    79		if cfg.Input.Format == "sqlite" {
    80			if q, ok := getString(inMap, "query"); ok {
    81				cfg.Input.Query = q
    82			} else {
    83				return nil, fmt.Errorf("config: input.query is required")
    84			}
    85			if cfg.Input.Query == "" {
    86				return nil, fmt.Errorf("config: input.query is required")
    87			}
    88		}
    89	
    90		stRaw, ok := m["stages"]
    91		if !ok {
    92			return nil, fmt.Errorf("config: stages is required")
    93		}
    94		stList, ok := stRaw.([]interface{})
    95		if !ok {
    96			return nil, fmt.Errorf("config: stages must be a list")
    97		}
    98		cfg.Stages = []map[string]interface{}{}
    99		for i, item := range stList {
   100			sm, ok := item.(map[string]interface{})
   101			if !ok {
   102				return nil, fmt.Errorf("config: stage %d must be a mapping", i+1)
   103			}
   104			cfg.Stages = append(cfg.Stages, sm)
   105		}
   106	
   107		outRaw, ok := m["output"]
   108		if !ok {
   109			return nil, fmt.Errorf("config: output is required")
   110		}
   111		outMap, ok := outRaw.(map[string]interface{})
   112		if !ok {
   113			return nil, fmt.Errorf("config: output must be a mapping")
   114		}
   115		if p, ok := getString(outMap, "path"); ok {
   116			cfg.Output.Path = p
   117		} else {
   118			return nil, fmt.Errorf("config: output.path is required")
   119		}
