   266	func buildProject(idx int, sm map[string]interface{}) (Stage, error) {
   267		colsRaw, ok := sm["columns"]
   268		if !ok {
   269			return nil, fmt.Errorf("config: stage %d: project.columns is required", idx)
   270		}
   271		list, ok := colsRaw.([]interface{})
   272		if !ok {
   273			return nil, fmt.Errorf("config: stage %d: project.columns must be a list", idx)
   274		}
   275	
   276		columns := make([]ProjectColumn, 0, len(list))
   277		seen := map[string]bool{}
   278		for j, item := range list {
   279			switch v := item.(type) {
   280			case string:
   281				if seen[v] {
   282					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, v)
   283				}
   284				seen[v] = true
   285				columns = append(columns, ProjectColumn{Source: v, Target: v})
   286			case map[string]interface{}:
   287				name, ok := getString(v, "name")
   288				if !ok || name == "" {
   289					return nil, fmt.Errorf("config: stage %d: project column %d name is required", idx, j+1)
   290				}
   291				as, ok := getString(v, "as")
   292				if !ok || as == "" {
   293					return nil, fmt.Errorf("config: stage %d: project column %d as is required", idx, j+1)
   294				}
   295				if seen[as] {
   296					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, as)
   297				}
   298				seen[as] = true
   299				columns = append(columns, ProjectColumn{Source: name, Target: as})
   300			default:
   301				return nil, fmt.Errorf("config: stage %d: project column %d must be a string or mapping", idx, j+1)
   302			}
   303		}
   304	
   305		return &ProjectStage{columns: columns}, nil
   306	}
