    17	
    18	func readSQLite(cfg config.InputConfig, dir string) ([]*record.Record, error) {
    19		path := config.ResolvePath(dir, cfg.Path)
    20		if _, err := os.Stat(path); err != nil {
    21			return nil, fmt.Errorf("input: %v", err)
    22		}
    23	
    24		cmd := exec.Command("/usr/bin/sqlite3", "-cmd", ".mode quote", "-cmd", ".headers on", path, cfg.Query)
    25		stdout, err := cmd.StdoutPipe()
    26		if err != nil {
    27			return nil, fmt.Errorf("input: %v", err)
    28		}
    29		var stderr bytes.Buffer
    30		cmd.Stderr = &stderr
    31		if err := cmd.Start(); err != nil {
    32			return nil, fmt.Errorf("input: %v", err)
    33		}
    34	
    35		r := bufio.NewReader(stdout)
    36		headerRaw, err := readSQLiteRecord(r)
    37		if err == io.EOF {
    38			if werr := cmd.Wait(); werr != nil {
    39				return nil, fmt.Errorf("input: %s", firstSQLiteError(stderr.String()))
    40			}
    41			return nil, fmt.Errorf("input: query returned no columns")
    42		}
    43		if err != nil {
    44			if werr := cmd.Wait(); werr != nil {
    45				return nil, fmt.Errorf("input: %s", firstSQLiteError(stderr.String()))
    46			}
    47			return nil, fmt.Errorf("input: %v", err)
    48		}
    49	
    50		header := make([]string, len(headerRaw))
    51		for i, raw := range headerRaw {
    52			name, err := renderSQLiteValue(raw)
    53			if err != nil {
    54				return nil, fmt.Errorf("input: %v", err)
    55			}
    56			header[i] = name
    57		}
    58	
    59		records := []*record.Record{}
    60		recNum := 0
    61		for {
    62			fields, err := readSQLiteRecord(r)
    63			if err == io.EOF {
    64				break
    65			}
    66			if err != nil {
    67				if werr := cmd.Wait(); werr != nil {
    68					return nil, fmt.Errorf("input: %s", firstSQLiteError(stderr.String()))
    69				}
    70				return nil, fmt.Errorf("input: %v", err)
    71			}
    72	
    73			recNum++
    74			if len(fields) != len(header) {
    75				return nil, fmt.Errorf("input: row %d: expected %d columns got %d", recNum, len(header), len(fields))
    76			}
    77	
    78			rec := record.New()
    79			rec.InputRow = recNum
    80			for i, col := range header {
    81				val, err := renderSQLiteValue(fields[i])
    82				if err != nil {
    83					return nil, fmt.Errorf("input: row %d: %v", recNum, err)
    84				}
    85				rec.Set(col, val)
    86			}
    87			records = append(records, rec)
    88		}
    89	
    90		if err := cmd.Wait(); err != nil {
    91			return nil, fmt.Errorf("input: %s", firstSQLiteError(stderr.String()))
    92		}
    93	
    94		return records, nil
    95	}
    96	
    97	func readSQLiteRecord(r *bufio.Reader) ([]string, error) {
    98		fields := []string{}
    99		for {
   100			b, err := r.ReadByte()
   101			if err == io.EOF {
   102				if len(fields) == 0 {
   103					return nil, io.EOF
   104				}
   105				return fields, nil
   106			}
   107			if err != nil {
   108				return nil, err
   109			}
   110			if b == '\n' || b == '\r' {
   111				continue
   112			}
   113			if b == ' ' || b == '\t' {
   114				continue
   115			}
   116	
   117			if err := r.UnreadByte(); err != nil {
   118				return nil, err
   119			}
   120	
   121			field, err := readSQLiteField(r)
   122			if err != nil {
   123				return nil, err
   124			}
   125			fields = append(fields, field)
   126	
   127			for {
   128				b, err := r.ReadByte()
   129				if err == io.EOF {
   130					return fields, nil
   131				}
   132				if err != nil {
   133					return nil, err
   134				}
   135				if b == ' ' || b == '\t' {
   136					continue
   137				}
   138				if b == ',' {
   139					break
   140				}
   141				if b == '\n' || b == '\r' {
   142					if err := r.UnreadByte(); err != nil {
   143						return nil, err
   144					}
   145					return fields, nil
   146				}
   147				return nil, fmt.Errorf("expected comma or newline between fields")
   148			}
   149		}
   150	}
   151	
   152	func readSQLiteField(r *bufio.Reader) (string, error) {
   153		b, err := r.ReadByte()
   154		if err != nil {
   155			return "", err
   156		}
   157	
   158		if b == '\'' {
   159			var sb strings.Builder
   160			sb.WriteByte(b)
   161			for {
   162				c, err := r.ReadByte()
   163				if err != nil {
   164					return "", fmt.Errorf("unterminated string literal")
   165				}
   166				sb.WriteByte(c)
   167				if c != '\'' {
   168					continue
   169				}
   170	
   171				nb, err := r.ReadByte()
   172				if err == io.EOF {
   173					return sb.String(), nil
   174				}
   175				if err != nil {
   176					return "", err
   177				}
   178				if nb == '\'' {
   179					sb.WriteByte(nb)
   180					continue
   181				}
   182				if err := r.UnreadByte(); err != nil {
   183					return "", err
   184				}
   185				return sb.String(), nil
   186			}
   187		}
   188	
   189		if err := r.UnreadByte(); err != nil {
   190			return "", err
   191		}
   192	
   193		var sb strings.Builder
   194		for {
   195			c, err := r.ReadByte()
   196			if err == io.EOF {
   197				return sb.String(), nil
   198			}
   199			if err != nil {
   200				return "", err
   201			}
   202			if c == ',' || c == '\n' || c == '\r' || c == ' ' || c == '\t' {
   203				if err := r.UnreadByte(); err != nil {
   204					return "", err
   205				}
   206				return sb.String(), nil
   207			}
   208			sb.WriteByte(c)
   209		}
   210	}
   211	
   212	func renderSQLiteValue(raw string) (string, error) {
   213		if raw == "NULL" {
   214			return "", nil
   215		}
   216		if len(raw) >= 2 && (raw[0] == 'X' || raw[0] == 'x') && raw[1] == '\'' && raw[len(raw)-1] == '\'' {
   217			return "", fmt.Errorf("BLOB values are not supported")
   218		}
   219		if len(raw) > 0 && raw[0] == '\'' {
   220			return unquoteSQLiteString(raw)
   221		}
   222	
   223		if _, err := strconv.ParseInt(raw, 10, 64); err == nil {
   224			return raw, nil
   225		}
   226	
   227		if f, err := strconv.ParseFloat(raw, 64); err == nil {
   228			if math.IsNaN(f) || math.IsInf(f, 0) {
   229				return "", fmt.Errorf("non-finite numeric value")
   230			}
   231			return formatFloat(f), nil
   232		}
   233	
   234		return raw, nil
   235	}
   236	
   237	func unquoteSQLiteString(raw string) (string, error) {
   238		if len(raw) < 2 || raw[0] != '\'' || raw[len(raw)-1] != '\'' {
   239			return "", fmt.Errorf("invalid string literal")
   240		}
   241	
   242		var b strings.Builder
   243		i := 1
   244		for i < len(raw)-1 {
   245			if raw[i] == '\'' {
   246				if i+1 < len(raw)-1 && raw[i+1] == '\'' {
   247					b.WriteByte('\'')
   248					i += 2
   249					continue
   250				}
   251				return "", fmt.Errorf("invalid string literal")
   252			}
   253			b.WriteByte(raw[i])
   254			i++
   255		}
   256		return b.String(), nil
   257	}
