    12	func Run(cfg *config.Config) (*stage.Stats, error) {
    13		stats := &stage.Stats{}
    14	
    15		stages, err := stage.BuildWithDir(cfg.Stages, cfg.Dir)
    16		if err != nil {
    17			return stats, err
    18		}
    19	
