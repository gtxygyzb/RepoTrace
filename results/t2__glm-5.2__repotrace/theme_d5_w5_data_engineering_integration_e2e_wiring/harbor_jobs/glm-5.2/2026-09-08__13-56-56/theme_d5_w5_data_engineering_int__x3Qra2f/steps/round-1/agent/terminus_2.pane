    21	type Stage interface {
    22		Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error)
    23	}
    24	
    25	func Build(rawStages []map[string]interface{}) ([]Stage, error) {
    26		return BuildWithDir(rawStages, "")
    27	}
    28	
    29	func BuildWithDir(rawStages []map[string]interface{}, dir string) ([]Stage, error) {
    30		stages := make([]Stage, 0, len(rawStages))
    31		for i, sm := range rawStages {
    32			typ, ok := getString(sm, "type")
    33			if !ok || typ == "" {
    34				return nil, fmt.Errorf("config: stage %d: type is required", i+1)
    35			}
    36	
    37			var st Stage
    38			var err error
    39			switch typ {
    40			case "filter":
    41				st, err = buildFilter(i+1, sm)
    42			case "project":
    43				st, err = buildProject(i+1, sm)
    44			case "sort":
    45				st, err = buildSort(i+1, sm)
    46			case "limit":
    47				st, err = buildLimit(i+1, sm)
    48			case "group":
    49				st, err = buildGroup(i+1, sm)
    50			case "join":
    51				st, err = buildJoin(i+1, sm, dir)
    52			case "dedup":
    53				st, err = buildDedup(i+1, sm)
    54			case "pivot":
    55				st, err = buildPivot(i+1, sm)
    56			case "unpivot":
    57				st, err = buildUnpivot(i+1, sm)
    58			default:
    59				return nil, fmt.Errorf("config: stage %d: unknown stage type %q", i+1, typ)
    60			}
    61			if err != nil {
    62				return nil, err
    63			}
    64			stages = append(stages, st)
    65		}
    66		return stages, nil
    67	}
