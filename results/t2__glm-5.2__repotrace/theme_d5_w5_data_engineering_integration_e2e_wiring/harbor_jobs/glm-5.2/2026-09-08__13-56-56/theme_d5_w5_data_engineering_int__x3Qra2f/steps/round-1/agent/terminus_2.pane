   207	func buildFilter(idx int, sm map[string]interface{}) (Stage, error) {
   208		whereRaw, ok := sm["where"]
   209		if !ok {
   210			return nil, fmt.Errorf("config: stage %d: filter.where is required", idx)
   211		}
   212		where, ok := whereRaw.(map[string]interface{})
   213		if !ok {
   214			return nil, fmt.Errorf("config: stage %d: filter.where must be a mapping", idx)
   215		}
   216	
   217		column, ok := getString(where, "column")
   218		if !ok || column == "" {
   219			return nil, fmt.Errorf("config: stage %d: filter.where.column is required", idx)
   220		}
   221	
   222		op, ok := getString(where, "op")
   223		if !ok || op == "" {
   224			return nil, fmt.Errorf("config: stage %d: filter.where.op is required", idx)
   225		}
   226		switch op {
   227		case "==", "!=", "<", "<=", ">", ">=":
   228		default:
   229			return nil, fmt.Errorf("config: stage %d: filter.where.op is invalid", idx)
   230		}
   231	
   232		value, ok := getString(where, "value")
   233		if !ok {
   234			return nil, fmt.Errorf("config: stage %d: filter.where.value is required", idx)
   235		}
   236	
   237		return &FilterStage{column: column, op: op, value: value}, nil
   238	}
