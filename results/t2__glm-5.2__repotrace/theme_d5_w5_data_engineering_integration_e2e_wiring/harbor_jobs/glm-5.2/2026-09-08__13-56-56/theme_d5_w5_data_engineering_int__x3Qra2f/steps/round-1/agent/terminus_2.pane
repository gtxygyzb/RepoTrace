   233	func buildFilter(idx int, sm map[string]interface{}) (Stage, error) {
   234		whereRaw, ok := sm["where"]
   235		if !ok {
   236			return nil, fmt.Errorf("config: stage %d: filter.where is required", idx)
   237		}
   238		where, ok := whereRaw.(map[string]interface{})
   239		if !ok {
   240			return nil, fmt.Errorf("config: stage %d: filter.where must be a mapping", idx)
   241		}
   242	
   243		column, ok := getString(where, "column")
   244		if !ok || column == "" {
   245			return nil, fmt.Errorf("config: stage %d: filter.where.column is required", idx)
   246		}
   247	
   248		op, ok := getString(where, "op")
   249		if !ok || op == "" {
   250			return nil, fmt.Errorf("config: stage %d: filter.where.op is required", idx)
   251		}
   252		switch op {
   253		case "==", "!=", "<", "<=", ">", ">=":
   254		default:
   255			return nil, fmt.Errorf("config: stage %d: filter.where.op is invalid", idx)
   256		}
   257	
   258		value, ok := getString(where, "value")
   259		if !ok {
   260			return nil, fmt.Errorf("config: stage %d: filter.where.value is required", idx)
   261		}
   262	
   263		return &FilterStage{column: column, op: op, value: value}, nil
   264	}
