   243	
   244	func (s *BucketStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   245	        out := make([]*record.Record, 0, len(in))
   246	        for _, r := range in {
   247	                v, ok := r.Get(s.column)
   248	                missing := !ok || v == ""
   249	                if missing {
   250	                        switch s.onMissing {
   251	                        case "drop":
   252	                                stats.DroppedMissing++
   253	                                fmt.Fprintf(stderr, "flowctl: bucket: drop missing-column row %d\n", r.InputRow)
   254	                                if strict {
   255	                                        return nil, fmt.Errorf("strict: missing column %s", s.column)
   256	                                }
   257	                                continue
   258	                        case "error":
   259	                                return nil, fmt.Errorf("flowctl: bucket: missing column %s at row %d", s.column, r.InputRow)
   260	                        case "keep_empty":
   261	                                nr := r.Copy()
   262	                                if nr.Has(s.into) {
   263	                                        return nil, fmt.Errorf("flowctl: bucket: into column %s already present at row %d", s.into, r.InputRow)
   264	                                }
   265	                                nr.Set(s.into, "")
   266	                                out = append(out, nr)
   267	                                continue
   268	                        }
   269	                }
   270	
   271	                f, err := parseFloat(v)
   272	                if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {
   273	                        switch s.onNonNumeric {
   274	                        case "drop":
   275	                                stats.DroppedNonNumeric++
   276	                                fmt.Fprintf(stderr, "flowctl: bucket: drop non-numeric row %d\n", r.InputRow)
   277	                                if strict {
   278	                                        return nil, fmt.Errorf("strict: non-numeric row %d", r.InputRow)
   279	                                }
   280	                                continue
   281	                        case "error":
   282	                                return nil, fmt.Errorf("flowctl: bucket: non-numeric value in column %s at row %d", s.column, r.InputRow)
   283	                        case "keep_empty":
   284	                                nr := r.Copy()
   285	                                if nr.Has(s.into) {
   286	                                        return nil, fmt.Errorf("flowctl: bucket: into column %s already present at row %d", s.into, r.InputRow)
   287	                                }
   288	                                nr.Set(s.into, "")
   289	                                out = append(out, nr)
   290	                                continue
   291	                        }
   292	                }
   293	
   294	                label := s.bucketLabel(f)
   295	                nr := r.Copy()
   296	                if nr.Has(s.into) {
   297	                        return nil, fmt.Errorf("flowctl: bucket: into column %s already present at row %d", s.into, r.InputRow)
   298	                }
   299	                nr.Set(s.into, label)
   300	                out = append(out, nr)
   301	        }
   302	        return out, nil
   303	}
   304	
   305	func (s *BucketStage) bucketLabel(v float64) string {
   306	        first := s.edges[0]
   307	        last := s.edges[len(s.edges)-1]
   308	        if s.inclusive == "right" {
   309	                if v <= first {
   310	                        return s.underLabel
   311	                }
   312	                if v > last {
   313	                        return s.overLabel
   314	                }
   315	                for i := 0; i < len(s.edges)-1; i++ {
   316	                        if v > s.edges[i] && v <= s.edges[i+1] {
   317	                                return s.labels[i]
   318	                        }
   319	                }
   320	        } else {
   321	                if v < first {
   322	                        return s.underLabel
   323	                }
   324	                if v >= last {
   325	                        return s.overLabel
   326	                }
   327	                for i := 0; i < len(s.edges)-1; i++ {
   328	                        if v >= s.edges[i] && v < s.edges[i+1] {
   329	                                return s.labels[i]
   330	                        }
   331	                }
   332	        }
   333	        return s.overLabel
   334	}
   335	
   336	func formatBucketFloat(f float64) string {
   337	        if f == math.Trunc(f) && !math.IsInf(f, 0) && math.Abs(f) < 1e15 {
   338	                return strconv.FormatInt(int64(f), 10)
   339	        }
   340	        return strconv.FormatFloat(f, 'g', -1, 64)
