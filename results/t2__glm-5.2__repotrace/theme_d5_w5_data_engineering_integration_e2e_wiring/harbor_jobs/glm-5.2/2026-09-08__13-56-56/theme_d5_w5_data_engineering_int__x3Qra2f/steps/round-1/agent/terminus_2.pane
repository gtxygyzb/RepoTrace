    67	type FilterStage struct {
    68		column string
    69		op     string
    70		value  string
    71	}
    72	
    73	func (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    74		out := make([]*record.Record, 0, len(in))
    75	
    76		for _, r := range in {
    77			v, ok := r.Get(s.column)
    78			if !ok {
    79				stats.DroppedMissing++
    80				if !stats.missingReported {
    81					fmt.Fprintf(stderr, "flowctl: filter: missing column %s\n", s.column)
    82					stats.missingReported = true
    83				}
    84				if strict {
    85					return nil, fmt.Errorf("filter: missing column %s", s.column)
    86				}
    87				continue
    88			}
    89	
    90			keep := false
    91			switch s.op {
    92			case "==":
    93				keep = v == s.value
    94			case "!=":
    95				keep = v != s.value
    96			default:
    97				left, err := parseFloat(v)
    98				if err != nil {
    99					stats.DroppedNonNumeric++
   100					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
   101					if strict {
   102						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   103					}
   104					continue
   105				}
   106				right, err := parseFloat(s.value)
   107				if err != nil {
   108					stats.DroppedNonNumeric++
   109					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
   110					if strict {
   111						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   112					}
   113					continue
   114				}
   115				keep = compareFloats(left, s.op, right)
   116			}
   117	
   118			if keep {
   119				out = append(out, r)
   120			}
   121		}
   122	
   123		return out, nil
   124	}
