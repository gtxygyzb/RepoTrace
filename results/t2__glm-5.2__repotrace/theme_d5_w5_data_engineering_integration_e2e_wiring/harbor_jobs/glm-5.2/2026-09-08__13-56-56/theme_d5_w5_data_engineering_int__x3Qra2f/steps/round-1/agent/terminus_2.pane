   246	func buildFilter(idx int, sm map[string]interface{}) (Stage, error) {
   247		whereRaw, ok := sm["where"]
   248		if !ok {
   249			return nil, fmt.Errorf("config: stage %d: filter.where is required", idx)
   250		}
   251		where, ok := whereRaw.(map[string]interface{})
   252		if !ok {
   253			return nil, fmt.Errorf("config: stage %d: filter.where must be a mapping", idx)
   254		}
   255	
   256		column, ok := getString(where, "column")
   257		if !ok || column == "" {
   258			return nil, fmt.Errorf("config: stage %d: filter.where.column is required", idx)
   259		}
   260	
   261		op, ok := getString(where, "op")
   262		if !ok || op == "" {
   263			return nil, fmt.Errorf("config: stage %d: filter.where.op is required", idx)
   264		}
   265		switch op {
   266		case "==", "!=", "<", "<=", ">", ">=":
   267		default:
   268			return nil, fmt.Errorf("config: stage %d: filter.where.op is invalid", idx)
   269		}
   270	
   271		value, ok := getString(where, "value")
   272		if !ok {
   273			return nil, fmt.Errorf("config: stage %d: filter.where.value is required", idx)
   274		}
   275	
   276		return &FilterStage{column: column, op: op, value: value}, nil
   277	}
   278	
   279	func buildProject(idx int, sm map[string]interface{}) (Stage, error) {
   280		colsRaw, ok := sm["columns"]
   281		if !ok {
   282			return nil, fmt.Errorf("config: stage %d: project.columns is required", idx)
   283		}
   284		list, ok := colsRaw.([]interface{})
   285		if !ok {
   286			return nil, fmt.Errorf("config: stage %d: project.columns must be a list", idx)
   287		}
   288	
   289		columns := make([]ProjectColumn, 0, len(list))
   290		seen := map[string]bool{}
   291		for j, item := range list {
   292			switch v := item.(type) {
   293			case string:
   294				if seen[v] {
   295					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, v)
   296				}
   297				seen[v] = true
   298				columns = append(columns, ProjectColumn{Source: v, Target: v})
   299			case map[string]interface{}:
   300				name, ok := getString(v, "name")
   301				if !ok || name == "" {
   302					return nil, fmt.Errorf("config: stage %d: project column %d name is required", idx, j+1)
   303				}
   304				as, ok := getString(v, "as")
   305				if !ok || as == "" {
   306					return nil, fmt.Errorf("config: stage %d: project column %d as is required", idx, j+1)
   307				}
   308				if seen[as] {
   309					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, as)
   310				}
   311				seen[as] = true
   312				columns = append(columns, ProjectColumn{Source: name, Target: as})
   313			default:
   314				return nil, fmt.Errorf("config: stage %d: project column %d must be a string or mapping", idx, j+1)
   315			}
   316		}
   317	
   318		return &ProjectStage{columns: columns}, nil
   319	}
   320	
   321	func buildSort(idx int, sm map[string]interface{}) (Stage, error) {
   322		keysRaw, ok := sm["keys"]
   323		if !ok {
   324			return nil, fmt.Errorf("config: stage %d: sort.keys is required", idx)
   325		}
   326		list, ok := keysRaw.([]interface{})
   327		if !ok {
   328			return nil, fmt.Errorf("config: stage %d: sort.keys must be a list", idx)
   329		}
   330	
   331		keys := make([]SortKey, 0, len(list))
   332		for j, item := range list {
   333			km, ok := item.(map[string]interface{})
   334			if !ok {
   335				return nil, fmt.Errorf("config: stage %d: sort key %d must be a mapping", idx, j+1)
   336			}
   337	
   338			column, ok := getString(km, "column")
   339			if !ok || column == "" {
   340				return nil, fmt.Errorf("config: stage %d: sort key %d column is required", idx, j+1)
   341			}
   342	
   343			order, ok := getString(km, "order")
   344			if !ok || order == "" {
   345				order = "asc"
   346			}
   347			if order != "asc" && order != "desc" {
   348				return nil, fmt.Errorf("config: stage %d: sort key %d order must be asc or desc", idx, j+1)
   349			}
   350	
   351			as, ok := getString(km, "as")
   352			if !ok || as == "" {
   353				as = "string"
   354			}
   355			if as != "string" && as != "number" {
   356				return nil, fmt.Errorf("config: stage %d: sort key %d as must be string or number", idx, j+1)
   357			}
   358	
   359			keys = append(keys, SortKey{Column: column, Order: order, As: as})
   360		}
   361	
   362		return &SortStage{keys: keys}, nil
   363	}
   364	
   365	func buildLimit(idx int, sm map[string]interface{}) (Stage, error) {
   366		countRaw, ok := sm["count"]
   367		if !ok {
   368			return nil, fmt.Errorf("config: stage %d: limit.count is required", idx)
   369		}
   370		countStr, ok := countRaw.(string)
   371		if !ok {
   372			return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
   373		}
   374		n, err := strconv.Atoi(countStr)
   375		if err != nil || n < 0 {
   376			return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
   377		}
   378	
   379		return &LimitStage{count: n}, nil
   380	}
   381	
   382	func getString(m map[string]interface{}, key string) (string, bool) {
   383		v, ok := m[key]
   384		if !ok {
   385			return "", false
   386		}
   387		if s, ok := v.(string); ok {
   388			return s, true
   389		}
   390		return fmt.Sprintf("%v", v), true
   391	}
   392	
   393	func getBool(m map[string]interface{}, key string) (bool, bool, error) {
