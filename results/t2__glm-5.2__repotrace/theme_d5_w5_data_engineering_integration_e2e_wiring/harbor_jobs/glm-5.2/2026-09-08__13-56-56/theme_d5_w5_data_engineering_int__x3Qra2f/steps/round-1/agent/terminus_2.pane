   150		if s, ok := v.(string); ok {
   151			return s, true
   152		}
   153		return "", true
   154	}
   155	
   156	func toStringList(v interface{}) ([]string, error) {
   157		list, ok := v.([]interface{})
   158		if !ok {
   159			return nil, fmt.Errorf("must be a list of strings")
   160		}
   161		out := []string{}
   162		for i, item := range list {
   163			s, ok := item.(string)
   164			if !ok {
   165				return nil, fmt.Errorf("entry %d must be a string", i+1)
   166			}
   167			out = append(out, s)
   168		}
   169		return out, nil
   170	}
   171	
   172	type yamlLine struct {
   173		indent int
   174		text   string
   175	}
   176	
   177	func parseYAML(data []byte) (interface{}, error) {
   178		lines := []yamlLine{}
   179		scanner := bufio.NewScanner(bytes.NewReader(data))
   180		for scanner.Scan() {
   181			raw := scanner.Text()
   182			line := stripComment(raw)
   183			if strings.TrimSpace(line) == "" {
   184				continue
   185			}
   186			indent := 0
   187			for indent < len(line) && line[indent] == ' ' {
   188				indent++
   189			}
   190			if indent < len(line) && line[indent] == '\t' {
   191				return nil, fmt.Errorf("tabs are not allowed for indentation")
   192			}
   193			text := strings.TrimRight(line[indent:], " \t")
   194			lines = append(lines, yamlLine{indent: indent, text: text})
   195		}
   196		if err := scanner.Err(); err != nil {
   197			return nil, err
   198		}
   199		if len(lines) == 0 {
   200			return nil, nil
   201		}
   202		val, _, err := parseNode(lines, 0, lines[0].indent)
   203		return val, err
   204	}
   205	
   206	func parseNode(lines []yamlLine, start, indent int) (interface{}, int, error) {
   207		if start >= len(lines) || lines[start].indent < indent {
   208			return nil, start, nil
   209		}
   210		if isSequenceLine(lines[start].text) {
   211			return parseSequence(lines, start, indent)
   212		}
   213		return parseMapping(lines, start, indent)
   214	}
   215	
   216	func isSequenceLine(text string) bool {
   217		return text == "-" || strings.HasPrefix(text, "- ")
   218	}
   219	
   220	func parseMapping(lines []yamlLine, start, indent int) (map[string]interface{}, int, error) {
   221		m := map[string]interface{}{}
   222		i := start
   223		for i < len(lines) {
   224			if lines[i].indent < indent {
   225				break
   226			}
   227			if lines[i].indent > indent {
   228				return nil, i, fmt.Errorf("unexpected indentation in mapping")
   229			}
   230			if isSequenceLine(lines[i].text) {
   231				break
   232			}
   233	
   234			key, val, err := splitKeyValue(lines[i].text)
   235			if err != nil {
   236				return nil, i, err
   237			}
   238	
   239			if val == "" {
   240				if i+1 < len(lines) {
   241					next := lines[i+1]
   242					if next.indent > indent {
   243						child, next2, err := parseNode(lines, i+1, next.indent)
   244						if err != nil {
   245							return nil, 0, err
   246						}
   247						m[key] = child
   248						i = next2
   249						continue
   250					}
   251					if next.indent == indent && isSequenceLine(next.text) {
   252						child, next2, err := parseSequence(lines, i+1, indent)
   253						if err != nil {
   254							return nil, 0, err
   255						}
   256						m[key] = child
   257						i = next2
   258						continue
   259					}
   260				}
