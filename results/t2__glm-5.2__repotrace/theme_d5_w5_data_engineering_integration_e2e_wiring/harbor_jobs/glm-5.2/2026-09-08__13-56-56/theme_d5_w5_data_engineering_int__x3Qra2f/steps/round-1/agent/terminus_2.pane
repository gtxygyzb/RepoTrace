   137	func (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   138		out := make([]*record.Record, 0, len(in))
   139		for _, r := range in {
   140			nr := record.New()
   141			nr.InputRow = r.InputRow
   142			for _, c := range s.columns {
   143				val := ""
   144				if v, ok := r.Get(c.Source); ok {
   145					val = v
   146				}
   147				nr.Set(c.Target, val)
   148			}
   149			out = append(out, nr)
   150		}
   151		return out, nil
   152	}
