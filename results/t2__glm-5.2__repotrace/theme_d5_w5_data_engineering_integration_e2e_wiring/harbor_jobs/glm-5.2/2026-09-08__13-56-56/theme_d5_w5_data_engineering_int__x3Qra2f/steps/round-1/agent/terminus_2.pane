    10	)
    11	
    12	func Run(cfg *config.Config) (*stage.Stats, error) {
    13		stats := &stage.Stats{}
    14	
    15		stages, err := stage.BuildWithDir(cfg.Stages, cfg.Dir)
    16		if err != nil {
    17			return stats, err
    18		}
    19	
    20		records, err := input.Read(cfg.Input, cfg.Dir)
    21		if err != nil {
    22			return stats, err
    23		}
    24		stats.Processed = len(records)
    25	
    26		for _, st := range stages {
    27			records, err = st.Apply(records, os.Stderr, cfg.Strict, stats)
    28			if err != nil {
    29				return stats, err
    30			}
    31		}
    32	
    33		n, err := output.Write(records, cfg.Output, cfg.Dir)
    34		if err != nil {
    35			return stats, err
    36		}
    37		stats.Emitted = n
    38	
    39		return stats, nil
    40	}
