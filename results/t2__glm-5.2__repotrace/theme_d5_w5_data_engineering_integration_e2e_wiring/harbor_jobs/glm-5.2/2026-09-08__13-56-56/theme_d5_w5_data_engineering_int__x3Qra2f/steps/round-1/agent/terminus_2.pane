[?2004hroot@n30009:/app# cat README.md
[?2004l# flowctl

`flowctl` is an in-house command-line tool the data platform team is building
to wire together small ETL pipelines. Analysts drop a YAML pipeline file onto
disk, point `flowctl run` at it, and get a transformed record stream out the
other side without needing to write bespoke glue every time.

The project lives in `/app/` and is built with Go (module path
`example.com/flowctl`). The binary is produced with `go build -o flowctl
./cmd/flowctl`.

## Scope

The first milestone of `flowctl` focuses on the integration wiring between:

- a single structured **input source** (a file on disk),
- an ordered list of **stages** that reshape each record, and
- a single **output sink** (also a file on disk, or stdout).

Everything runs in-process; there is no daemon, no network, no database.

## Layout

```
/app/
├── go.mod
├── cmd/flowctl/        # CLI entry point
├── internal/...        # pipeline building blocks
└── examples/           # sample pipelines the team uses for smoke tests
```

`examples/` ships a couple of tiny fixtures that predate this milestone. They
are only there so new hires can eyeball the file formats; the production
pipelines use larger files mounted in at runtime.

## Running

```
flowctl run --config path/to/pipeline.yaml
```

The command reads `--config`, opens the input file declared inside, runs each
record through the declared stages, and writes the survivors to the declared
output. A one-line summary is printed to stderr so it can be captured by the
surrounding job scheduler.

## Conventions

- All text is UTF-8.
- Record field names are case-sensitive.
- The tool must be deterministic: the same inputs always produce the same
  bytes on the output, in the same order.
- Empty output is legal (`0` records emitted is a successful run).
[?2004hroot@n30009:/app# sed -n '1,260p' internal/stage/rank.go
[?2004lpackage stage

import (
	"fmt"
	"io"
	"sort"
	"strconv"

	"example.com/flowctl/internal/record"
)

type RankKey struct {
	Column       string
	As           string
	Order        string
	NullPosition string
}

type RankStage struct {
	keys        []RankKey
	method      string
	into        string
	partitionBy []string
}

func (s *RankStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	if len(in) == 0 {
		return in, nil
	}

	indexed := make([]int, len(in))
	for i := range in {
		indexed[i] = i
	}

	sort.SliceStable(indexed, func(ai, bi int) bool {
		a := in[indexed[ai]]
		b := in[indexed[bi]]
		for _, key := range s.keys {
			av, aok := a.Get(key.Column)
			bv, bok := b.Get(key.Column)
			aMissing := !aok || av == ""
			bMissing := !bok || bv == ""
			nullLast := key.NullPosition == "" || key.NullPosition == "last"
			if aMissing != bMissing {
				if key.Order == "desc" {
					if nullLast {
						return bMissing
					}
					return aMissing
				}
				if nullLast {
					return aMissing
				}
				return bMissing
			}
			if aMissing {
				continue
			}
			if key.As == "number" {
				af, errA := parseFloat(av)
				bf, errB := parseFloat(bv)
				if errA != nil {
					return false
				}
				if errB != nil {
					return false
				}
				if af != bf {
					if key.Order == "desc" {
						return af > bf
					}
					return af < bf
				}
			} else {
				if av != bv {
					if key.Order == "desc" {
						return av > bv
					}
					return av < bv
				}
			}
		}
		return false
	})

	for _, idx := range indexed {
		in[idx].Set(s.into, "")
	}

	start := 0
	for start < len(indexed) {
		end := start
		for end < len(indexed) && sameRankPartition(in[indexed[start]], in[indexed[end]], s.partitionBy) {
			end++
		}

		gpos := 1
		i := start
		for i < end {
			j := i + 1
			for j < end && sameRankKey(in[indexed[i]], in[indexed[j]], s.keys) {
				j++
			}
			rankInt := gpos
			for k := i; k < j; k++ {
				in[indexed[k]].Set(s.into, s.renderValue(rankInt, end-start))
			}
			gpos += (j - i)
			i = j
		}
		start = end
	}

	return in, nil
}

func (s *RankStage) renderValue(rankInt, n_part int) string {
	switch s.method {
	case "dense":
		return strconv.Itoa(rankInt)
	case "rank":
		return strconv.Itoa(rankInt)
	case "row":
		return strconv.Itoa(rankInt)
	case "percent":
		return formatPercent(float64(rankInt-1) / float64(n_part))
	default:
		return strconv.Itoa(rankInt)
	}
}

func sameRankKey(a, b *record.Record, keys []RankKey) bool {
	for _, key := range keys {
		av, aok := a.Get(key.Column)
		bv, bok := b.Get(key.Column)
		aMissing := !aok || av == ""
		bMissing := !bok || bv == ""
		if aMissing != bMissing {
			return false
		}
		if aMissing {
			continue
		}
		if key.As == "number" {
			af, errA := parseFloat(av)
			bf, errB := parseFloat(bv)
			if errA != nil || errB != nil {
				return av == bv
			}
			if af != bf {
				return false
			}
		} else if av != bv {
			return false
		}
	}
	return true
}

func sameRankPartition(a, b *record.Record, partitionBy []string) bool {
	for _, col := range partitionBy {
		av, _ := a.Get(col)
		bv, _ := b.Get(col)
		if av != bv {
			return false
		}
	}
	return true
}

func formatPercent(f float64) string {
	return strconv.FormatFloat(f, 'f', 6, 64)
}

func buildRank(idx int, sm map[string]interface{}) (Stage, error) {
	keysRaw, ok := sm["order_by"]
	if !ok {
		return nil, fmt.Errorf("config: stage %d: rank.order_by is required", idx)
	}
	list, ok := keysRaw.([]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stage %d: rank.order_by must be a list", idx)
	}

	keys := make([]RankKey, 0, len(list))
	for j, item := range list {
		km, ok := item.(map[string]interface{})
		if !ok {
			return nil, fmt.Errorf("config: stage %d: rank.order_by entry %d must be a mapping", idx, j+1)
		}
		column, ok := getString(km, "column")
		if !ok || column == "" {
			return nil, fmt.Errorf("config: stage %d: rank.order_by entry %d column is required", idx, j+1)
		}
		order, ok := getString(km, "order")
		if !ok || order == "" {
			order = "asc"
		}
		if order != "asc" && order != "desc" {
			return nil, fmt.Errorf("config: stage %d: rank.order_by entry %d order must be asc or desc", idx, j+1)
		}
		as, ok := getString(km, "as")
		if !ok || as == "" {
			as = "string"
		}
		if as != "string" && as != "number" {
			return nil, fmt.Errorf("config: stage %d: rank.order_by entry %d as must be string or number", idx, j+1)
		}
		nullPos, _ := getString(km, "null_position")
		if nullPos == "" {
			nullPos = "last"
		}
		if nullPos != "last" && nullPos != "first" {
			return nil, fmt.Errorf("config: stage %d: rank.order_by entry %d null_position must be first or last", idx, j+1)
		}
		keys = append(keys, RankKey{Column: column, As: as, Order: order, NullPosition: nullPos})
	}

	method, ok := getString(sm, "method")
	if !ok || method == "" {
		method = "rank"
	}
	if method != "dense" && method != "rank" && method != "row" && method != "percent" {
		return nil, fmt.Errorf("config: stage %d: rank.method must be dense, rank, row, or percent", idx)
	}

	into, ok := getString(sm, "into")
	if !ok || into == "" {
		return nil, fmt.Errorf("config: stage %d: rank.into is required", idx)
	}

	partitionBy := []string{}
	if raw, ok := sm["partition_by"]; ok {
		plist, err := toStringList(raw)
		if err != nil {
			return nil, fmt.Errorf("config: stage %d: rank.partition_by %v", idx, err)
		}
		partitionBy = plist
	}

	return &RankStage{keys: keys, method: method, into: into, partitionBy: partitionBy}, nil
}
[?2004hroot@n30009:/app# sed -n '1,170p' internal/stage/rank.go
[?2004lpackage stage

import (
	"fmt"
	"io"
	"sort"
	"strconv"

	"example.com/flowctl/internal/record"
)

type RankKey struct {
	Column       string
	As           string
	Order        string
	NullPosition string
}

type RankStage struct {
	keys        []RankKey
	method      string
	into        string
	partitionBy []string
}

func (s *RankStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	if len(in) == 0 {
		return in, nil
	}

	indexed := make([]int, len(in))
	for i := range in {
		indexed[i] = i
	}

	sort.SliceStable(indexed, func(ai, bi int) bool {
		a := in[indexed[ai]]
		b := in[indexed[bi]]
		for _, key := range s.keys {
			av, aok := a.Get(key.Column)
			bv, bok := b.Get(key.Column)
			aMissing := !aok || av == ""
			bMissing := !bok || bv == ""
			nullLast := key.NullPosition == "" || key.NullPosition == "last"
			if aMissing != bMissing {
				if key.Order == "desc" {
					if nullLast {
						return bMissing
					}
					return aMissing
				}
				if nullLast {
					return aMissing
				}
				return bMissing
			}
			if aMissing {
				continue
			}
			if key.As == "number" {
				af, errA := parseFloat(av)
				bf, errB := parseFloat(bv)
				if errA != nil {
					return false
				}
				if errB != nil {
					return false
				}
				if af != bf {
					if key.Order == "desc" {
						return af > bf
					}
					return af < bf
				}
			} else {
				if av != bv {
					if key.Order == "desc" {
						return av > bv
					}
					return av < bv
				}
			}
		}
		return false
	})

	for _, idx := range indexed {
		in[idx].Set(s.into, "")
	}

	start := 0
	for start < len(indexed) {
		end := start
		for end < len(indexed) && sameRankPartition(in[indexed[start]], in[indexed[end]], s.partitionBy) {
			end++
		}

		gpos := 1
		i := start
		for i < end {
			j := i + 1
			for j < end && sameRankKey(in[indexed[i]], in[indexed[j]], s.keys) {
				j++
			}
			rankInt := gpos
			for k := i; k < j; k++ {
				in[indexed[k]].Set(s.into, s.renderValue(rankInt, end-start))
			}
			gpos += (j - i)
			i = j
		}
		start = end
	}

	return in, nil
}

func (s *RankStage) renderValue(rankInt, n_part int) string {
	switch s.method {
	case "dense":
		return strconv.Itoa(rankInt)
	case "rank":
		return strconv.Itoa(rankInt)
	case "row":
		return strconv.Itoa(rankInt)
	case "percent":
		return formatPercent(float64(rankInt-1) / float64(n_part))
	default:
		return strconv.Itoa(rankInt)
	}
}

func sameRankKey(a, b *record.Record, keys []RankKey) bool {
	for _, key := range keys {
		av, aok := a.Get(key.Column)
		bv, bok := b.Get(key.Column)
		aMissing := !aok || av == ""
		bMissing := !bok || bv == ""
		if aMissing != bMissing {
			return false
		}
		if aMissing {
			continue
		}
		if key.As == "number" {
			af, errA := parseFloat(av)
			bf, errB := parseFloat(bv)
			if errA != nil || errB != nil {
				return av == bv
			}
			if af != bf {
				return false
			}
		} else if av != bv {
			return false
		}
	}
	return true
}

func sameRankPartition(a, b *record.Record, partitionBy []string) bool {
	for _, col := range partitionBy {
		av, _ := a.Get(col)
		bv, _ := b.Get(col)
		if av != bv {
			return false
		}
	}
	return true
}
