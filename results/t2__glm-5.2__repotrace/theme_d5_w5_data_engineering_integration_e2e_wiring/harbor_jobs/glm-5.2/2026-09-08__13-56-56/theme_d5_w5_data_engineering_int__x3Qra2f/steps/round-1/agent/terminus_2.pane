    24	func (s *GroupStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    25		type groupState struct {
    26			keyParts []string
    27			firstRow int
    28			count    int
    29			sums     []float64
    30			mins     []float64
    31			maxs     []float64
    32			hasMin   []bool
    33			hasMax   []bool
    34		}
    35	
    36		order := []string{}
    37		keys := map[string]*groupState{}
    38	
    39		for _, r := range in {
    40			keyParts := make([]string, len(s.by))
    41			for i, col := range s.by {
    42				v, ok := r.Get(col)
    43				if !ok {
    44					return nil, fmt.Errorf("group: missing column %s", col)
    45				}
    46				keyParts[i] = v
    47			}
    48			key := strings.Join(keyParts, "\x00")
    49	
    50			st, exists := keys[key]
    51			if !exists {
    52				st = &groupState{
    53					keyParts: keyParts,
    54					firstRow: r.InputRow,
    55					sums:     make([]float64, len(s.aggregates)),
    56					mins:     make([]float64, len(s.aggregates)),
    57					maxs:     make([]float64, len(s.aggregates)),
    58					hasMin:   make([]bool, len(s.aggregates)),
    59					hasMax:   make([]bool, len(s.aggregates)),
    60					numCount: make([]int, len(s.aggregates)),
    61				}
    62				keys[key] = st
    63				order = append(order, key)
    64			}
    65			st.count++
    66	
    67			for i, agg := range s.aggregates {
    68				if agg.Op == "count" {
    69					continue
    70				}
    71	
    72				v, ok := r.Get(agg.Column)
    73				if !ok {
    74					continue
    75				}
    76				f, err := parseFloat(v)
    77				if err != nil {
    78					return nil, fmt.Errorf("group: non-numeric value in column %s at row %d", agg.Column, r.InputRow)
    79				}
    80	
    81				st.numCount[i]++
    82				st.sums[i] += f
    83				if !st.hasMin[i] || f < st.mins[i] {
    84					st.mins[i] = f
    85					st.hasMin[i] = true
    86				}
    87				if !st.hasMax[i] || f > st.maxs[i] {
    88					st.maxs[i] = f
    89					st.hasMax[i] = true
    90				}
    91			}
    92		}
    93	
    94		out := make([]*record.Record, 0, len(order))
    95		for _, key := range order {
    96			st := keys[key]
    97			nr := record.New()
    98			nr.InputRow = st.firstRow
    99	
   100			for i, col := range s.by {
   101				nr.Set(col, st.keyParts[i])
   102			}
   103	
   104			for i, agg := range s.aggregates {
   105				switch agg.Op {
   106				case "count":
   107					nr.Set(agg.As, strconv.Itoa(st.count))
   108				case "sum":
   109					nr.Set(agg.As, formatFloat(st.sums[i]))
   110				case "min":
   111					nr.Set(agg.As, formatFloat(st.mins[i]))
   112				case "max":
   113					nr.Set(agg.As, formatFloat(st.maxs[i]))
   114				case "avg":
   115					if st.count == 0 {
   116						return nil, fmt.Errorf("group: avg of empty group")
   117					}
   118					nr.Set(agg.As, formatFloat(st.sums[i]/float64(st.count)))
   119				}
   120			}
   121	
   122			out = append(out, nr)
   123		}
   124	
   125		return out, nil
   126	}
