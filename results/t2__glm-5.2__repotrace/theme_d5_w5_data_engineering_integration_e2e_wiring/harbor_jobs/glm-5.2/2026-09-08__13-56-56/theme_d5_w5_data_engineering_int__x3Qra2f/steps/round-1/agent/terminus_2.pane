   102	                        var err error
   103	                        start, err = parseFloat(startStr)
   104	                        if err != nil || math.IsNaN(start) || math.IsInf(start, 0) {
   105	                                return nil, fmt.Errorf("config: stage %d: bucket: width.start must be a finite number", idx)
   106	                        }
   107	                }
   108	
   109	                countStr, ok := getString(wm, "count")
   110	                if !ok || countStr == "" {
   111	                        return nil, fmt.Errorf("config: stage %d: bucket: width.count must be a positive integer", idx)
   112	                }
   113	                countI, err := strconv.Atoi(countStr)
   114	                if err != nil || countI < 1 {
   115	                        return nil, fmt.Errorf("config: stage %d: bucket: width.count must be a positive integer", idx)
   116	                }
