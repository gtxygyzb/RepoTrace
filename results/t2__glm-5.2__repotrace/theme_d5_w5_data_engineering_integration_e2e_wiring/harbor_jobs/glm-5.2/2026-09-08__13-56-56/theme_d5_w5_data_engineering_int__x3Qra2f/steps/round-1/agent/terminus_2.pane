   231	func buildFilter(idx int, sm map[string]interface{}) (Stage, error) {
   232		whereRaw, ok := sm["where"]
   233		if !ok {
   234			return nil, fmt.Errorf("config: stage %d: filter.where is required", idx)
   235		}
   236		where, ok := whereRaw.(map[string]interface{})
   237		if !ok {
   238			return nil, fmt.Errorf("config: stage %d: filter.where must be a mapping", idx)
   239		}
   240	
   241		column, ok := getString(where, "column")
   242		if !ok || column == "" {
   243			return nil, fmt.Errorf("config: stage %d: filter.where.column is required", idx)
   244		}
   245	
   246		op, ok := getString(where, "op")
   247		if !ok || op == "" {
   248			return nil, fmt.Errorf("config: stage %d: filter.where.op is required", idx)
   249		}
   250		switch op {
   251		case "==", "!=", "<", "<=", ">", ">=":
   252		default:
   253			return nil, fmt.Errorf("config: stage %d: filter.where.op is invalid", idx)
   254		}
   255	
   256		value, ok := getString(where, "value")
   257		if !ok {
   258			return nil, fmt.Errorf("config: stage %d: filter.where.value is required", idx)
   259		}
   260	
   261		return &FilterStage{column: column, op: op, value: value}, nil
   262	}
   263	
   264	func buildProject(idx int, sm map[string]interface{}) (Stage, error) {
   265		colsRaw, ok := sm["columns"]
   266		if !ok {
   267			return nil, fmt.Errorf("config: stage %d: project.columns is required", idx)
   268		}
   269		list, ok := colsRaw.([]interface{})
   270		if !ok {
   271			return nil, fmt.Errorf("config: stage %d: project.columns must be a list", idx)
   272		}
   273	
   274		columns := make([]ProjectColumn, 0, len(list))
   275		seen := map[string]bool{}
   276		for j, item := range list {
   277			switch v := item.(type) {
   278			case string:
   279				if seen[v] {
   280					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, v)
   281				}
   282				seen[v] = true
   283				columns = append(columns, ProjectColumn{Source: v, Target: v})
   284			case map[string]interface{}:
   285				name, ok := getString(v, "name")
   286				if !ok || name == "" {
   287					return nil, fmt.Errorf("config: stage %d: project column %d name is required", idx, j+1)
   288				}
   289				as, ok := getString(v, "as")
   290				if !ok || as == "" {
   291					return nil, fmt.Errorf("config: stage %d: project column %d as is required", idx, j+1)
   292				}
   293				if seen[as] {
   294					return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, as)
   295				}
   296				seen[as] = true
   297				columns = append(columns, ProjectColumn{Source: name, Target: as})
   298			default:
   299				return nil, fmt.Errorf("config: stage %d: project column %d must be a string or mapping", idx, j+1)
   300			}
   301		}
   302	
   303		return &ProjectStage{columns: columns}, nil
   304	}
   305	
   306	func buildSort(idx int, sm map[string]interface{}) (Stage, error) {
   307		keysRaw, ok := sm["keys"]
   308		if !ok {
   309			return nil, fmt.Errorf("config: stage %d: sort.keys is required", idx)
   310		}
   311		list, ok := keysRaw.([]interface{})
   312		if !ok {
   313			return nil, fmt.Errorf("config: stage %d: sort.keys must be a list", idx)
   314		}
   315	
   316		keys := make([]SortKey, 0, len(list))
   317		for j, item := range list {
   318			km, ok := item.(map[string]interface{})
   319			if !ok {
   320				return nil, fmt.Errorf("config: stage %d: sort key %d must be a mapping", idx, j+1)
   321			}
   322	
   323			column, ok := getString(km, "column")
   324			if !ok || column == "" {
   325				return nil, fmt.Errorf("config: stage %d: sort key %d column is required", idx, j+1)
   326			}
   327	
   328			order, ok := getString(km, "order")
   329			if !ok || order == "" {
   330				order = "asc"
   331			}
   332			if order != "asc" && order != "desc" {
   333				return nil, fmt.Errorf("config: stage %d: sort key %d order must be asc or desc", idx, j+1)
   334			}
   335	
   336			as, ok := getString(km, "as")
   337			if !ok || as == "" {
   338				as = "string"
   339			}
   340			if as != "string" && as != "number" {
   341				return nil, fmt.Errorf("config: stage %d: sort key %d as must be string or number", idx, j+1)
   342			}
   343	
   344			keys = append(keys, SortKey{Column: column, Order: order, As: as})
   345		}
   346	
   347		return &SortStage{keys: keys}, nil
   348	}
   349	
   350	func buildLimit(idx int, sm map[string]interface{}) (Stage, error) {
   351		countRaw, ok := sm["count"]
   352		if !ok {
   353			return nil, fmt.Errorf("config: stage %d: limit.count is required", idx)
   354		}
   355		countStr, ok := countRaw.(string)
   356		if !ok {
   357			return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
   358		}
   359		n, err := strconv.Atoi(countStr)
   360		if err != nil || n < 0 {
   361			return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
   362		}
   363	
   364		return &LimitStage{count: n}, nil
   365	}
   366	
   367	func getString(m map[string]interface{}, key string) (string, bool) {
   368		v, ok := m[key]
   369		if !ok {
   370			return "", false
   371		}
   372		if s, ok := v.(string); ok {
   373			return s, true
   374		}
   375		return fmt.Sprintf("%v", v), true
   376	}
   377	
   378	func getBool(m map[string]interface{}, key string) (bool, bool, error) {
   379		v, ok := m[key]
   380		if !ok {
   381			return false, false, nil
   382		}
   383		switch b := v.(type) {
   384		case bool:
   385			return b, true, nil
   386		case string:
   387			if b == "true" {
   388				return true, true, nil
   389			}
   390			if b == "false" {
   391				return false, true, nil
   392			}
   393			return false, true, fmt.Errorf("%s must be a boolean", key)
   394		default:
   395			return false, true, fmt.Errorf("%s must be a boolean", key)
   396		}
   397	}
   398	
   399	func parseFloat(s string) (float64, error) {
   400		f, err := strconv.ParseFloat(s, 64)
   401		if err != nil {
   402			return 0, err
   403		}
   404		if math.IsNaN(f) || math.IsInf(f, 0) {
   405			return 0, fmt.Errorf("not a finite number")
   406		}
   407		return f, nil
   408	}
   409	
   410	func compareFloats(left float64, op string, right float64) bool {
   411		switch op {
   412		case "<":
   413			return left < right
   414		case "<=":
   415			return left <= right
   416		case ">":
   417			return left > right
   418		case ">=":
   419			return left >= right
   420		}
   421		return false
   422	}
