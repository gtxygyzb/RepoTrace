   332	func buildLimit(idx int, sm map[string]interface{}) (Stage, error) {
   333		countRaw, ok := sm["count"]
   334		if !ok {
   335			return nil, fmt.Errorf("config: stage %d: limit.count is required", idx)
   336		}
   337		countStr, ok := countRaw.(string)
   338		if !ok {
   339			return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
   340		}
   341		n, err := strconv.Atoi(countStr)
   342		if err != nil || n < 0 {
   343			return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
   344		}
   345	
   346		return &LimitStage{count: n}, nil
   347	}
