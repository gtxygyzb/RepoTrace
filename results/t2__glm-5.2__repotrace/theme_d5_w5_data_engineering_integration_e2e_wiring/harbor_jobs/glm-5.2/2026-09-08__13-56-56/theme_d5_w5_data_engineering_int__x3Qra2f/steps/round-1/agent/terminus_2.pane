    44	
    45		rightRaw, ok := sm["right"]
    46		if !ok {
    47			return nil, fmt.Errorf("config: stage %d: join.right is required", idx)
    48		}
    49		right, ok := rightRaw.(map[string]interface{})
    50		if !ok {
    51			return nil, fmt.Errorf("config: stage %d: join.right must be a mapping", idx)
    52		}
    53	
    54		inRaw, ok := right["input"]
    55		if !ok {
    56			return nil, fmt.Errorf("config: stage %d: join.right.input is required", idx)
    57		}
    58		inMap, ok := inRaw.(map[string]interface{})
    59		if !ok {
    60			return nil, fmt.Errorf("config: stage %d: join.right.input must be a mapping", idx)
    61		}
    62		ric, err := parseJoinInputConfig(idx, inMap)
    63		if err != nil {
    64			return nil, err
    65		}
    66	
    67		selectCols := []string{}
    68		selectPresent := false
    69		if selRaw, ok := right["select"]; ok {
    70			selectPresent = true
    71			selectCols, err = toStringList(selRaw)
    72			if err != nil {
    73				return nil, fmt.Errorf("config: stage %d: join.right.select %v", idx, err)
    74			}
    75		}
    76	
    77		prefix, _ := getString(right, "prefix")
    78	
    79		return &JoinStage{
    80			idx:           idx,
    81			dir:           dir,
    82			kind:          kind,
    83			on:            on,
    84			rightInput:    ric,
    85			selectCols:    selectCols,
    86			selectPresent: selectPresent,
    87			prefix:        prefix,
    88		}, nil
    89	}
    90	
    91	func parseJoinInputConfig(idx int, m map[string]interface{}) (config.InputConfig, error) {
    92		ic := config.InputConfig{}
    93	
    94		p, ok := getString(m, "path")
    95		if !ok || p == "" {
    96			return ic, fmt.Errorf("config: stage %d: join.right.input.path is required", idx)
    97		}
    98		ic.Path = p
    99	
   100		f, ok := getString(m, "format")
   101		if !ok || f == "" {
   102			return ic, fmt.Errorf("config: stage %d: join.right.input.format is required", idx)
   103		}
   104		ic.Format = f
   105		if ic.Format != "csv" && ic.Format != "ndjson" && ic.Format != "sqlite" {
   106			return ic, fmt.Errorf("config: stage %d: join.right.input.format must be csv, ndjson, or sqlite", idx)
   107		}
   108	
   109		if ic.Format == "sqlite" {
   110			q, ok := getString(m, "query")
   111			if !ok || q == "" {
   112				return ic, fmt.Errorf("config: stage %d: join.right.input.query is required", idx)
   113			}
   114			ic.Query = q
   115		}
   116	
   117		return ic, nil
   118	}
   119	
   120	func (s *JoinStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   121		rightRecords, err := input.Read(s.rightInput, s.dir)
   122		if err != nil {
   123			return nil, err
   124		}
   125	
   126		schema, err := s.resolveRightSchema(rightRecords)
   127		if err != nil {
   128			return nil, err
   129		}
   130	
   131		if len(rightRecords) > 0 {
   132			for _, col := range s.on {
   133				if !schemaContains(schema, col) {
   134					return nil, fmt.Errorf("join: missing on column %s in right record", col)
   135				}
   136			}
   137		}
   138	
   139		leftColumns := map[string]bool{}
   140		for _, r := range in {
   141			for _, k := range r.Order {
   142				leftColumns[k] = true
   143			}
   144		}
   145		for _, col := range schema {
   146			if s.isOn(col) {
   147				continue
   148			}
   149			name := s.prefix + col
   150			if leftColumns[name] {
   151				return nil, fmt.Errorf("config: join: column name collision: %s", name)
   152			}
   153		}
   154	
   155		index := map[string][]map[string]string{}
   156		for _, rr := range rightRecords {
   157			vals, err := s.projectRight(rr, schema)
   158			if err != nil {
   159				return nil, err
   160			}
   161	
   162			skip := false
   163			for _, col := range s.on {
   164				if vals[col] == "" {
   165					skip = true
   166					break
   167				}
   168			}
   169			if skip {
   170				continue
   171			}
   172	
   173			key := joinKey(s.on, vals)
   174			index[key] = append(index[key], vals)
   175		}
   176	
   177		out := make([]*record.Record, 0, len(in))
   178		for _, r := range in {
   179			for _, col := range s.on {
   180				if !r.Has(col) {
   181					return nil, fmt.Errorf("join: missing on column %s in left record", col)
   182				}
   183			}
   184	
   185			leftVals := map[string]string{}
   186			empty := false
   187			for _, col := range s.on {
   188				v, _ := r.Get(col)
   189				leftVals[col] = v
   190				if v == "" {
   191					empty = true
   192				}
   193			}
   194	
   195			var matches []map[string]string
   196			if !empty {
   197				matches = index[joinKey(s.on, leftVals)]
   198			}
   199	
   200			if len(matches) == 0 {
   201				if s.kind == "left" {
   202					nr := r.Copy()
   203					s.addRightColumns(nr, nil, schema)
   204					out = append(out, nr)
   205				}
   206				continue
   207			}
   208	
   209			for _, m := range matches {
   210				nr := r.Copy()
   211				s.addRightColumns(nr, m, schema)
   212				out = append(out, nr)
   213			}
   214		}
   215	
   216		return out, nil
   217	}
   218	
   219	func (s *JoinStage) resolveRightSchema(rightRecords []*record.Record) ([]string, error) {
   220		if s.selectPresent {
   221			return s.selectCols, nil
   222		}
   223		if len(rightRecords) == 0 {
   224			return []string{}, nil
   225		}
   226		return rightRecords[0].Order, nil
   227	}
   228	
   229	func (s *JoinStage) projectRight(rr *record.Record, schema []string) (map[string]string, error) {
   230		vals := make(map[string]string, len(schema))
   231		for _, col := range schema {
   232			v, ok := rr.Get(col)
   233			if !ok {
   234				if s.isOn(col) {
   235					return nil, fmt.Errorf("join: missing on column %s in right record", col)
   236				}
   237				v = ""
   238			}
   239			vals[col] = v
   240		}
   241		return vals, nil
   242	}
   243	
   244	func (s *JoinStage) addRightColumns(nr *record.Record, vals map[string]string, schema []string) {
   245		for _, col := range schema {
   246			if s.isOn(col) {
   247				continue
   248			}
   249			v := ""
   250			if vals != nil {
   251				v = vals[col]
   252			}
   253			nr.Set(s.prefix+col, v)
   254		}
   255	}
   256	
   257	func (s *JoinStage) isOn(col string) bool {
   258		for _, c := range s.on {
   259			if c == col {
   260				return true
