    98		ic.Path = p
    99	
   100		f, ok := getString(m, "format")
   101		if !ok || f == "" {
   102			return ic, fmt.Errorf("config: stage %d: join.right.input.format is required", idx)
   103		}
   104		ic.Format = f
   105		if ic.Format != "csv" && ic.Format != "ndjson" && ic.Format != "sqlite" {
   106			return ic, fmt.Errorf("config: stage %d: join.right.input.format must be csv, ndjson, or sqlite", idx)
   107		}
   108	
   109		if ic.Format == "sqlite" {
   110			q, ok := getString(m, "query")
   111			if !ok || q == "" {
   112				return ic, fmt.Errorf("config: stage %d: join.right.input.query is required", idx)
   113			}
   114			ic.Query = q
   115		}
   116	
   117		return ic, nil
   118	}
