import subprocess
from pathlib import Path

base = Path('/tmp/fctltest')
flow = '/app/flowctl'

def run(cfg, csv, strict=False):
    (base/'in.csv').write_text(csv)
    (base/'cfg.yaml').write_text(cfg)
    cmd = [flow, 'run', '--config', 'cfg.yaml']
    if strict:
        cmd.append('--strict')
    p = subprocess.run(cmd, cwd=str(base), capture_output=True, text=True)
    out = (base/'out.jsonl').read_text() if (base/'out.jsonl').exists() else ''
    return p.returncode, out, p.stderr

cases = []
def check(name, cfg, csv, expect_code, expect_out=None, expect_stderr=None, strict=False):
    code, out, err = run(cfg, csv, strict)
    ok = code == expect_code
    if expect_out is not None:
        ok = ok and out == expect_out
    if expect_stderr is not None:
        ok = ok and expect_stderr in err
    if ok:
        print(f"PASS: {name}")
    else:
        print(f"FAIL: {name}")
        print(f"  code={code}")
        print(f"  out={out!r}")
        print(f"  err={err!r}")
        raise SystemExit(1)

sort_csv = "name,score\n,9\nalice,5\n,7\nbob,3\n"
check("sort asc empty last", """input:
  path: in.csv
  format: csv
stages:
  - type: sort
    keys:
      - {column: name, order: asc, as: string}
output:
  path: out.jsonl
  format: jsonl
""", sort_csv, 0, '{"name":"alice","score":"5"}\n{"name":"bob","score":"3"}\n{"name":"","score":"9"}\n{"name":"","score":"7"}\n')

check("sort desc empty first", """input:
  path: in.csv
  format: csv
stages:
  - type: sort
    keys:
      - {column: name, order: desc, as: string}
output:
  path: out.jsonl
  format: jsonl
""", sort_csv, 0, '{"name":"","score":"9"}\n{"name":"","score":"7"}\n{"name":"bob","score":"3"}\n{"name":"alice","score":"5"}\n')

bucket_edges_csv = "id,amount\n1,5\n2,42\n3,700\n4,9999\n5,\n"
