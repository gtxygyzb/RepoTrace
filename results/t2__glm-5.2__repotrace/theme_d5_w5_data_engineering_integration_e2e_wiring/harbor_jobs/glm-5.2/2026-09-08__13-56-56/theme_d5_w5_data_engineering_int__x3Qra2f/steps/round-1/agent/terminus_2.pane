		if order != "asc" && order != "desc" {
			return nil, fmt.Errorf("config: stage %d: sort key %d order must be asc or desc", idx, j+1)
		}

		as, ok := getString(km, "as")
		if !ok || as == "" {
			as = "string"
		}
		if as != "string" && as != "number" {
[?2004hroot@n30009:/app# sed -n '1,220p' internal/stage/dedup.go
[?2004lpackage stage

import (
	"fmt"
	"io"
	"strings"

	"example.com/flowctl/internal/record"
)

type dedupWhen struct {
	column string
	op     string
	value  string
}

type DedupStage struct {
	idx      int
	by       []string
	keep     string
	on       string
	fallback string
	when     *dedupWhen
}

type dedupItem struct {
	pos      int
	r        *record.Record
	sentinel bool
	finite   bool
	num      float64
}

type dedupGroup struct {
	key      string
	items    []dedupItem
	survivor *dedupItem
}

func (s *DedupStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	groups := map[string]*dedupGroup{}
	var groupOrder []*dedupGroup

	for pos, r := range in {
		if s.when != nil && !s.matchesWhen(r) {
			continue
		}

		key, err := s.groupKey(r)
		if err != nil {
			return nil, err
		}

		item := dedupItem{pos: pos, r: r}
		if s.keep == "min" || s.keep == "max" {
			v, ok := r.Get(s.on)
			if !ok || v == "" {
				item.sentinel = true
			} else {
				f, err := parseFloat(v)
				if err != nil {
					return nil, fmt.Errorf("dedup: column %s value %q is not a number", s.on, v)
				}
				item.finite = true
				item.num = f
			}
		}

		g, ok := groups[key]
		if !ok {
			g = &dedupGroup{key: key}
			groups[key] = g
			groupOrder = append(groupOrder, g)
		}
		g.items = append(g.items, item)
	}

	for _, g := range groupOrder {
		survivor, err := s.pickSurvivor(g)
		if err != nil {
			return nil, err
		}
		g.survivor = survivor
	}

	survivorsByPos := map[int]*record.Record{}
	for _, g := range groupOrder {
		if g.survivor != nil {
			survivorsByPos[g.survivor.pos] = g.survivor.r
		}
	}

	out := make([]*record.Record, 0, len(in))
	for i, r := range in {
		if s.when != nil && !s.matchesWhen(r) {
			out = append(out, r)
			continue
		}
		if sr, ok := survivorsByPos[i]; ok {
			out = append(out, sr)
		}
	}
	return out, nil
}

func (s *DedupStage) matchesWhen(r *record.Record) bool {
	v, ok := r.Get(s.when.column)
	if !ok {
		return false
	}
	switch s.when.op {
	case "==":
		return v == s.when.value
	case "!=":
		return v != s.when.value
	default:
		left, err := parseFloat(v)
		if err != nil {
			return false
		}
		right, err := parseFloat(s.when.value)
		if err != nil {
			return false
		}
		return compareFloats(left, s.when.op, right)
	}
}

func (s *DedupStage) groupKey(r *record.Record) (string, error) {
	parts := make([]string, len(s.by)*2)
	for i, col := range s.by {
		v, ok := r.Get(col)
		if !ok {
			return "", fmt.Errorf("dedup: missing by column %s", col)
		}
		parts[i*2] = col
		parts[i*2+1] = v
	}
	return strings.Join(parts, "\x00"), nil
}

func (s *DedupStage) pickSurvivor(g *dedupGroup) (*dedupItem, error) {
	switch s.keep {
	case "first":
		return &g.items[0], nil
	case "last":
		return &g.items[len(g.items)-1], nil
	case "unique":
		if len(g.items) == 1 {
			return &g.items[0], nil
		}
		return nil, nil
	case "min", "max":
		return s.pickNumeric(g)
	}
	return nil, nil
}

func (s *DedupStage) pickNumeric(g *dedupGroup) (*dedupItem, error) {
	var best *dedupItem
	for i := range g.items {
		item := &g.items[i]
		if !item.finite {
			continue
		}
		if best == nil || s.isBetterNumeric(item.num, best.num) {
			best = item
		} else if item.num == best.num {
			if s.fallback == "last" {
				best = item
			}
		}
	}

	if best != nil {
		return best, nil
	}

	if s.fallback == "last" {
		return &g.items[len(g.items)-1], nil
	}
	return &g.items[0], nil
}

func (s *DedupStage) isBetterNumeric(candidate, current float64) bool {
	if s.keep == "min" {
		return candidate < current
	}
	return candidate > current
}

