   164	func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   165		for _, key := range s.keys {
   166			if key.As == "number" {
   167				for _, r := range in {
   168					v, ok := r.Get(key.Column)
   169					if !ok || v == "" {
   170						continue
   171					}
   172					if _, err := parseFloat(v); err != nil {
   173						return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
   174					}
   175				}
   176			}
   177		}
   178	
   179		sort.SliceStable(in, func(i, j int) bool {
   180			for _, key := range s.keys {
   181				a, aok := in[i].Get(key.Column)
   182				b, bok := in[j].Get(key.Column)
   183	
   184				if key.As == "number" {
   185					aMissing := !aok || a == ""
   186					bMissing := !bok || b == ""
   187					if aMissing != bMissing {
   188						if key.Order == "desc" {
   189							return bMissing
   190						}
   191						return aMissing
   192					}
   193					if aMissing {
   194						continue
   195					}
   196					af, errA := parseFloat(a)
   197					bf, errB := parseFloat(b)
   198					if errA != nil || errB != nil {
   199						return false
   200					}
   201					if af != bf {
   202						if key.Order == "desc" {
   203							return af > bf
   204						}
   205						return af < bf
   206					}
   207				} else {
   208					if a != b {
   209						if key.Order == "desc" {
   210							return a > b
   211						}
   212						return a < b
   213					}
   214				}
   215			}
   216			return false
   217		})
   218	
   219		return in, nil
   220	}
