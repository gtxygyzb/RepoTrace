[?2004lpackage config

import (
	"bufio"
	"bytes"
	"fmt"
	"os"
	"path/filepath"
	"strconv"
	"strings"
)

type InputConfig struct {
	Path   string
	Format string
	Query  string
}

type OutputConfig struct {
	Path           string
	Format         string
	Columns        []string
	ColumnsPresent bool
}

type Config struct {
	Dir    string
	Strict bool
	Input  InputConfig
	Stages []map[string]interface{}
	Output OutputConfig
}

func Load(path string) (*Config, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, fmt.Errorf("config: %v", err)
	}

	root, err := parseYAML(data)
	if err != nil {
		return nil, fmt.Errorf("config: %v", err)
	}

	m, ok := root.(map[string]interface{})
	if !ok {
		return nil, fmt.Errorf("config: top-level value must be a mapping")
	}

	cfg := &Config{Dir: filepath.Dir(path)}

	inRaw, ok := m["input"]
	if !ok {
		return nil, fmt.Errorf("config: input is required")
	}
	inMap, ok := inRaw.(map[string]interface{})
	if !ok {
		return nil, fmt.Errorf("config: input must be a mapping")
	}
	if p, ok := getString(inMap, "path"); ok {
		cfg.Input.Path = p
	} else {
		return nil, fmt.Errorf("config: input.path is required")
	}
	if cfg.Input.Path == "" {
		return nil, fmt.Errorf("config: input.path is required")
	}
	if f, ok := getString(inMap, "format"); ok {
		cfg.Input.Format = f
	} else {
		return nil, fmt.Errorf("config: input.format is required")
	}
	if cfg.Input.Format == "" {
		return nil, fmt.Errorf("config: input.format is required")
	}
	if cfg.Input.Format != "csv" && cfg.Input.Format != "ndjson" && cfg.Input.Format != "sqlite" {
		return nil, fmt.Errorf("config: input.format must be csv, ndjson, or sqlite")
	}
	if cfg.Input.Format == "sqlite" {
		if q, ok := getString(inMap, "query"); ok {
			cfg.Input.Query = q
		} else {
			return nil, fmt.Errorf("config: input.query is required")
		}
		if cfg.Input.Query == "" {
			return nil, fmt.Errorf("config: input.query is required")
		}
	}

	stRaw, ok := m["stages"]
	if !ok {
		return nil, fmt.Errorf("config: stages is required")
	}
	stList, ok := stRaw.([]interface{})
	if !ok {
		return nil, fmt.Errorf("config: stages must be a list")
	}
	cfg.Stages = []map[string]interface{}{}
	for i, item := range stList {
		sm, ok := item.(map[string]interface{})
		if !ok {
			return nil, fmt.Errorf("config: stage %d must be a mapping", i+1)
		}
		cfg.Stages = append(cfg.Stages, sm)
	}

	outRaw, ok := m["output"]
	if !ok {
		return nil, fmt.Errorf("config: output is required")
	}
	outMap, ok := outRaw.(map[string]interface{})
	if !ok {
		return nil, fmt.Errorf("config: output must be a mapping")
	}
	if p, ok := getString(outMap, "path"); ok {
		cfg.Output.Path = p
	} else {
		return nil, fmt.Errorf("config: output.path is required")
	}
	if cfg.Output.Path == "" {
		return nil, fmt.Errorf("config: output.path is required")
	}
	if f, ok := getString(outMap, "format"); ok {
		cfg.Output.Format = f
	} else {
		return nil, fmt.Errorf("config: output.format is required")
	}
	if cfg.Output.Format == "" {
		return nil, fmt.Errorf("config: output.format is required")
	}
	if cfg.Output.Format != "jsonl" {
		return nil, fmt.Errorf("config: output.format must be jsonl")
	}
	if colRaw, present := outMap["columns"]; present {
		cfg.Output.ColumnsPresent = true
		cols, err := toStringList(colRaw)
		if err != nil {
			return nil, fmt.Errorf("config: output.columns: %v", err)
		}
		cfg.Output.Columns = cols
	}

	return cfg, nil
}

func ResolvePath(dir, path string) string {
	if path == "-" {
		return "-"
	}
	if filepath.IsAbs(path) {
		return path
	}
	return filepath.Join(dir, path)
}

func getString(m map[string]interface{}, key string) (string, bool) {
	v, ok := m[key]
	if !ok {
		return "", false
	}
	if s, ok := v.(string); ok {
		return s, true
	}
	return "", true
}

func toStringList(v interface{}) ([]string, error) {
	list, ok := v.([]interface{})
	if !ok {
		return nil, fmt.Errorf("must be a list of strings")
	}
	out := []string{}
	for i, item := range list {
		s, ok := item.(string)
		if !ok {
			return nil, fmt.Errorf("entry %d must be a string", i+1)
		}
		out = append(out, s)
	}
	return out, nil
}

type yamlLine struct {
	indent int
	text   string
}

func parseYAML(data []byte) (interface{}, error) {
	lines := []yamlLine{}
	scanner := bufio.NewScanner(bytes.NewReader(data))
	for scanner.Scan() {
		raw := scanner.Text()
		line := stripComment(raw)
		if strings.TrimSpace(line) == "" {
			continue
		}
		indent := 0
		for indent < len(line) && line[indent] == ' ' {
			indent++
		}
		if indent < len(line) && line[indent] == '\t' {
			return nil, fmt.Errorf("tabs are not allowed for indentation")
		}
		text := strings.TrimRight(line[indent:], " \t")
		lines = append(lines, yamlLine{indent: indent, text: text})
	}
	if err := scanner.Err(); err != nil {
		return nil, err
	}
	if len(lines) == 0 {
		return nil, nil
	}
	val, _, err := parseNode(lines, 0, lines[0].indent)
	return val, err
}

func parseNode(lines []yamlLine, start, indent int) (interface{}, int, error) {
	if start >= len(lines) || lines[start].indent < indent {
		return nil, start, nil
	}
	if isSequenceLine(lines[start].text) {
		return parseSequence(lines, start, indent)
	}
	return parseMapping(lines, start, indent)
}

func isSequenceLine(text string) bool {
	return text == "-" || strings.HasPrefix(text, "- ")
}

func parseMapping(lines []yamlLine, start, indent int) (map[string]interface{}, int, error) {
	m := map[string]interface{}{}
	i := start
	for i < len(lines) {
		if lines[i].indent < indent {
			break
		}
		if lines[i].indent > indent {
			return nil, i, fmt.Errorf("unexpected indentation in mapping")
		}
		if isSequenceLine(lines[i].text) {
			break
		}

		key, val, err := splitKeyValue(lines[i].text)
		if err != nil {
			return nil, i, err
		}

		if val == "" {
			if i+1 < len(lines) {
				next := lines[i+1]
				if next.indent > indent {
					child, next2, err := parseNode(lines, i+1, next.indent)
					if err != nil {
						return nil, 0, err
					}
					m[key] = child
					i = next2
					continue
[?2004hroot@n30009:/app# sed -n '260,620p' internal/config/config.go
[?2004l					continue
				}
				if next.indent == indent && isSequenceLine(next.text) {
					child, next2, err := parseSequence(lines, i+1, indent)
					if err != nil {
						return nil, 0, err
					}
					m[key] = child
					i = next2
					continue
				}
			}
			m[key] = nil
			i++
			continue
		}

		v, err := parseFlowOrScalar(val)
		if err != nil {
			return nil, 0, err
		}
		m[key] = v
		i++
	}
	return m, i, nil
}

func parseSequence(lines []yamlLine, start, indent int) ([]interface{}, int, error) {
	items := []interface{}{}
	i := start
	for i < len(lines) {
		if lines[i].indent < indent {
			break
		}
		if lines[i].indent > indent {
			return nil, i, fmt.Errorf("unexpected indentation in sequence")
		}
		if !isSequenceLine(lines[i].text) {
			break
		}

		content := strings.TrimSpace(strings.TrimPrefix(lines[i].text, "-"))
		if content == "" {
			if i+1 < len(lines) && lines[i+1].indent > indent {
				child, next, err := parseNode(lines, i+1, lines[i+1].indent)
				if err != nil {
					return nil, 0, err
				}
				items = append(items, child)
				i = next
				continue
			}
			items = append(items, nil)
			i++
			continue
		}

		if strings.HasPrefix(content, "[") || strings.HasPrefix(content, "{") {
			v, err := parseFlow(content)
			if err != nil {
				return nil, 0, err
			}
			items = append(items, v)
			i++
			continue
		}

		if isMappingLine(content) {
			afterDash := strings.TrimPrefix(lines[i].text, "-")
			leading := len(afterDash) - len(strings.TrimLeft(afterDash, " "))
			effIndent := indent + 1 + leading
			sublines := []yamlLine{{indent: effIndent, text: content}}
			j := i + 1
			for j < len(lines) && lines[j].indent >= effIndent {
				sublines = append(sublines, lines[j])
				j++
			}
			child, _, err := parseMapping(sublines, 0, effIndent)
			if err != nil {
				return nil, 0, err
			}
			items = append(items, child)
			i = j
			continue
		}

		v, err := parseFlowOrScalar(content)
		if err != nil {
			return nil, 0, err
		}
		items = append(items, v)
		i++
	}
	return items, i, nil
}

func isMappingLine(text string) bool {
	_, _, err := splitKeyValue(text)
	return err == nil
}

func splitKeyValue(text string) (string, string, error) {
	inSingle := false
	inDouble := false
	for i := 0; i < len(text); i++ {
		c := text[i]
		switch c {
		case '\'':
			if !inDouble {
				inSingle = !inSingle
			}
		case '"':
			if !inSingle {
				inDouble = !inDouble
			}
		case ':':
			if !inSingle && !inDouble {
				if i+1 >= len(text) {
					return parseScalar(strings.TrimSpace(text[:i])), "", nil
				}
				if text[i+1] == ' ' || text[i+1] == '\t' {
					return parseScalar(strings.TrimSpace(text[:i])), strings.TrimSpace(text[i+1:]), nil
				}
			}
		}
	}
	return "", "", fmt.Errorf("expected mapping key: %q", text)
}

func parseFlowOrScalar(s string) (interface{}, error) {
	s = strings.TrimSpace(s)
	if strings.HasPrefix(s, "[") || strings.HasPrefix(s, "{") {
		return parseFlow(s)
	}
	return parseScalar(s), nil
}

func parseScalar(s string) string {
	s = strings.TrimSpace(s)
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		if q, err := strconv.Unquote(s); err == nil {
			return q
		}
		return s[1 : len(s)-1]
	}
	if len(s) >= 2 && s[0] == '\'' && s[len(s)-1] == '\'' {
		return strings.ReplaceAll(s[1:len(s)-1], "''", "'")
	}
	return s
}

func stripComment(line string) string {
	inSingle := false
	inDouble := false
	for i := 0; i < len(line); i++ {
		c := line[i]
		switch c {
		case '\'':
			if !inDouble {
				inSingle = !inSingle
			}
		case '"':
			if !inSingle {
				inDouble = !inDouble
			}
		case '#':
			if !inSingle && !inDouble && (i == 0 || line[i-1] == ' ' || line[i-1] == '\t') {
				return line[:i]
			}
		}
	}
	return line
}

func parseFlow(s string) (interface{}, error) {
	s = strings.TrimSpace(s)
	if strings.HasPrefix(s, "[") {
		if !strings.HasSuffix(s, "]") {
			return nil, fmt.Errorf("unterminated flow sequence")
		}
		inner := s[1 : len(s)-1]
		if strings.TrimSpace(inner) == "" {
			return []interface{}{}, nil
		}
		parts := splitFlow(inner)
		list := []interface{}{}
		for _, p := range parts {
			v, err := parseFlowOrScalar(strings.TrimSpace(p))
			if err != nil {
				return nil, err
			}
			list = append(list, v)
		}
		return list, nil
	}
	if strings.HasPrefix(s, "{") {
		if !strings.HasSuffix(s, "}") {
			return nil, fmt.Errorf("unterminated flow mapping")
		}
		inner := s[1 : len(s)-1]
		if strings.TrimSpace(inner) == "" {
			return map[string]interface{}{}, nil
		}
		parts := splitFlow(inner)
		m := map[string]interface{}{}
		for _, p := range parts {
			key, val, err := splitKeyValue(strings.TrimSpace(p))
			if err != nil {
				return nil, err
			}
			v, err := parseFlowOrScalar(strings.TrimSpace(val))
			if err != nil {
				return nil, err
			}
			m[key] = v
		}
		return m, nil
	}
	return parseScalar(s), nil
}

func splitFlow(s string) []string {
	parts := []string{}
	depth := 0
	inSingle := false
	inDouble := false
	start := 0
	for i := 0; i < len(s); i++ {
		c := s[i]
		switch c {
		case '\'':
			if !inDouble {
				inSingle = !inSingle
			}
		case '"':
			if !inSingle {
				inDouble = !inDouble
			}
		case '[', '{':
			if !inSingle && !inDouble {
				depth++
			}
		case ']', '}':
			if !inSingle && !inDouble {
				depth--
			}
		case ',':
			if depth == 0 && !inSingle && !inDouble {
				parts = append(parts, s[start:i])
				start = i + 1
			}
		}
	}
	parts = append(parts, s[start:])
	return parts
}
