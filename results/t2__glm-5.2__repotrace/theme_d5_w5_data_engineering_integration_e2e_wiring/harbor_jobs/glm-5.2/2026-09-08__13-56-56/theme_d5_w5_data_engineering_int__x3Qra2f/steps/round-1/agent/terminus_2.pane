   130		columns []ProjectColumn
   131	}
   132	
   133	func (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   134		out := make([]*record.Record, 0, len(in))
   135		for _, r := range in {
   136			nr := record.New()
   137			nr.InputRow = r.InputRow
   138			for _, c := range s.columns {
   139				val := ""
   140				if v, ok := r.Get(c.Source); ok {
   141					val = v
   142				}
   143				nr.Set(c.Target, val)
   144			}
   145			out = append(out, nr)
   146		}
   147		return out, nil
   148	}
