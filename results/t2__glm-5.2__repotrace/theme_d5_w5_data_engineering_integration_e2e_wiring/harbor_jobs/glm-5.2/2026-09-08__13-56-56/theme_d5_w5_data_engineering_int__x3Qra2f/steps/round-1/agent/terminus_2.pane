[?2004l[?2004h> func percentile(vals []float64, p float64) string {
[?2004l[?2004h>     if len(vals) == 0 {
[?2004l[?2004h>         return ""
[?2004l[?2004h>     }
[?2004l[?2004h>     sorted := make([]float64, len(vals))
[?2004l[?2004h>     copy(sorted, vals)
[?2004lg[?2004h>     sort.Float64s(sorted)
[?2004l[?2004h>     if len(sorted) == 1 {
[?2004l[?2004h>         return formatFloat(sorted[0])
[?2004l[?2004h>     }
[?2004l[?2004h>     idx := float64(len(sorted)-1) * p
[?2004l[?2004h>     lo := math.Floor(idx)
[?2004l[?2004h>     hi := math.Ceil(idx)
[?2004l[?2004h>     frac := idx - lo
[?2004l[?2004h>     res := sorted[int(lo)] + frac*(sorted[int(hi)]-sorted[int(lo)])
[?2004lWi[?2004h>     return formatFloat(res)
[?2004l[?2004h> }
