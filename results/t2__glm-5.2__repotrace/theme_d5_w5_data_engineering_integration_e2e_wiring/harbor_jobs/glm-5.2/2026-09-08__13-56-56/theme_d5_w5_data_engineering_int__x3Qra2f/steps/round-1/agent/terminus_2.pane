   102				return nil, fmt.Errorf("config: stage %d must be a mapping", i+1)
   103			}
   104			cfg.Stages = append(cfg.Stages, sm)
   105		}
   106	
   107		outRaw, ok := m["output"]
   108		if !ok {
   109			return nil, fmt.Errorf("config: output is required")
   110		}
   111		outMap, ok := outRaw.(map[string]interface{})
   112		if !ok {
   113			return nil, fmt.Errorf("config: output must be a mapping")
   114		}
   115		if p, ok := getString(outMap, "path"); ok {
   116			cfg.Output.Path = p
   117		} else {
   118			return nil, fmt.Errorf("config: output.path is required")
   119		}
   120		if cfg.Output.Path == "" {
   121			return nil, fmt.Errorf("config: output.path is required")
   122		}
   123		if f, ok := getString(outMap, "format"); ok {
   124			cfg.Output.Format = f
   125		} else {
   126			return nil, fmt.Errorf("config: output.format is required")
   127		}
   128		if cfg.Output.Format == "" {
   129			return nil, fmt.Errorf("config: output.format is required")
   130		}
   131		if cfg.Output.Format != "jsonl" {
   132			return nil, fmt.Errorf("config: output.format must be jsonl")
   133		}
   134		if colRaw, present := outMap["columns"]; present {
   135			cfg.Output.ColumnsPresent = true
   136			cols, err := toStringList(colRaw)
   137			if err != nil {
   138				return nil, fmt.Errorf("config: output.columns: %v", err)
   139			}
   140			cfg.Output.Columns = cols
   141		}
   142	
   143		return cfg, nil
   144	}
   145	
   146	func ResolvePath(dir, path string) string {
   147		if path == "-" {
   148			return "-"
   149		}
   150		if filepath.IsAbs(path) {
   151			return path
   152		}
   153		return filepath.Join(dir, path)
   154	}
   155	
   156	func getString(m map[string]interface{}, key string) (string, bool) {
   157		v, ok := m[key]
   158		if !ok {
   159			return "", false
   160		}
   161		if s, ok := v.(string); ok {
   162			return s, true
   163		}
   164		return "", true
   165	}
   166	
   167	func toStringList(v interface{}) ([]string, error) {
   168		list, ok := v.([]interface{})
   169		if !ok {
   170			return nil, fmt.Errorf("must be a list of strings")
   171		}
   172		out := []string{}
   173		for i, item := range list {
   174			s, ok := item.(string)
   175			if !ok {
   176				return nil, fmt.Errorf("entry %d must be a string", i+1)
   177			}
   178			out = append(out, s)
   179		}
   180		return out, nil
   181	}
