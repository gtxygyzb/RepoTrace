    13	type Stats struct {
    14		Processed         int
    15		Emitted           int
    16		DroppedNonNumeric int
    17		DroppedMissing    int
    18		missingReported   bool
    19	}
    20	
    21	type Stage interface {
    22		Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error)
