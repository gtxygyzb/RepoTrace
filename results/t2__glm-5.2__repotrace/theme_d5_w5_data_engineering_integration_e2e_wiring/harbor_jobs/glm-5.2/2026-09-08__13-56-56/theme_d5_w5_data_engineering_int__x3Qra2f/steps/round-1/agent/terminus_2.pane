   288	func buildSort(idx int, sm map[string]interface{}) (Stage, error) {
   289		keysRaw, ok := sm["keys"]
   290		if !ok {
   291			return nil, fmt.Errorf("config: stage %d: sort.keys is required", idx)
   292		}
   293		list, ok := keysRaw.([]interface{})
   294		if !ok {
   295			return nil, fmt.Errorf("config: stage %d: sort.keys must be a list", idx)
   296		}
   297	
   298		keys := make([]SortKey, 0, len(list))
