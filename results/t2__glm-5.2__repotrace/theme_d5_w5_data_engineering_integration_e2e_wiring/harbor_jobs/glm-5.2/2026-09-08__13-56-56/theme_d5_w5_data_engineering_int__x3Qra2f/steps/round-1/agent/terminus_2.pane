type BucketStage struct {
	column       string
	into         string
	edges        []float64
	labels       []string
	underLabel   string
	overLabel    string
	inclusive    string
	onMissing    string
	onNonNumeric string
}

func buildBucket(idx int, sm map[string]interface{}) (Stage, error) {
	column, ok := getString(sm, "column")
	if !ok || column == "" {
		return nil, fmt.Errorf("config: bucket: column must be a non-empty string")
	}
	into, ok := getString(sm, "into")
	if !ok || into == "" {
		return nil, fmt.Errorf("config: bucket: into must be a non-empty string")
	}
	if into == column {
		return nil, fmt.Errorf("config: bucket: into must differ from column")
	}

	inclusive, ok := getString(sm, "inclusive")
	if !ok || inclusive == "" {
		inclusive = "right"
	}
	if inclusive != "left" && inclusive != "right" {
		return nil, fmt.Errorf("config: bucket: inclusive must be left or right")
	}

	onMissing, ok := getString(sm, "on_missing")
	if !ok || onMissing == "" {
		onMissing = "keep_empty"
	}
	if onMissing != "keep_empty" && onMissing != "drop" && onMissing != "error" {
		return nil, fmt.Errorf("config: bucket: on_missing must be keep_empty, drop, or error")
	}

	onNonNumeric, ok := getString(sm, "on_non_numeric")
	if !ok || onNonNumeric == "" {
		onNonNumeric = "error"
	}
	if onNonNumeric != "error" && onNonNumeric != "drop" && onNonNumeric != "keep_empty" {
		return nil, fmt.Errorf("config: bucket: on_non_numeric must be error, drop, or keep_empty")
	}

	_, hasEdges := sm["edges"]
	_, hasWidth := sm["width"]
	if hasEdges == hasWidth {
		return nil, fmt.Errorf("config: bucket: exactly one of edges or width is required")
	}

	var (
		edges      []float64
		labelCount int
		autoLabels []string
		underAuto  string
		overAuto   string
	)

	if hasWidth {
		widthRaw, ok := sm["width"]
		if !ok {
			return nil, fmt.Errorf("config: bucket: exactly one of edges or width is required")
		}
		wm, ok := widthRaw.(map[string]interface{})
		if !ok {
			return nil, fmt.Errorf("config: bucket: width must be a mapping")
		}
		for k := range wm {
			if k != "step" && k != "start" && k != "count" {
				return nil, fmt.Errorf("config: bucket: unknown key %s in width", k)
			}
		}

		stepStr, ok := getString(wm, "step")
		if !ok || stepStr == "" {
			return nil, fmt.Errorf("config: bucket: width.step must be a positive finite number")
		}
		step, err := parseFloat(stepStr)
		if err != nil || math.IsNaN(step) || math.IsInf(step, 0) || step <= 0 {
			return nil, fmt.Errorf("config: bucket: width.step must be a positive finite number")
		}

		start := 0.0
		if startStr, ok := getString(wm, "start"); ok && startStr != "" {
			var err error
			start, err = parseFloat(startStr)
			if err != nil || math.IsNaN(start) || math.IsInf(start, 0) {
				return nil, fmt.Errorf("config: bucket: width.start must be a finite number")
			}
		}

		countStr, ok := getString(wm, "count")
		if !ok || countStr == "" {
			return nil, fmt.Errorf("config: bucket: width.count must be a positive integer")
		}
		countI, err := strconv.Atoi(countStr)
		if err != nil || countI < 1 {
			return nil, fmt.Errorf("config: bucket: width.count must be a positive integer")
		}

		edges = make([]float64, 0, countI+1)
		for i := 0; i <= countI; i++ {
			edges = append(edges, start+step*float64(i))
		}
		labelCount = countI
	} else {
		edgesRaw, ok := sm["edges"]
		if !ok {
			return nil, fmt.Errorf("config: bucket: edges must have at least two entries")
		}
		list, ok := edgesRaw.([]interface{})
		if !ok {
			return nil, fmt.Errorf("config: bucket: edges must have at least two entries")
		}
		if len(list) < 2 {
			return nil, fmt.Errorf("config: bucket: edges must have at least two entries")
		}
		edges = make([]float64, 0, len(list))
		for i, item := range list {
			es, ok := item.(string)
			if !ok {
				es = fmt.Sprintf("%v", item)
			}
			f, err := parseFloat(es)
			if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {
				return nil, fmt.Errorf("config: bucket: edges[%d] is not a finite number", i)
			}
			if i > 0 && f <= edges[i-1] {
				return nil, fmt.Errorf("config: bucket: edges must be strictly increasing")
			}
			edges = append(edges, f)
		}
		labelCount = len(edges) - 1
	}

	for i := 1; i < len(edges); i++ {
		if edges[i] <= edges[i-1] {
			return nil, fmt.Errorf("config: bucket: edges must be strictly increasing")
		}
	}

	autoLabels = make([]string, labelCount)
	for i := 0; i < labelCount; i++ {
		a := formatFloat(edges[i])
		b := formatFloat(edges[i+1])
		if inclusive == "left" {
			autoLabels[i] = "[" + a + ", " + b + ")"
		} else {
			autoLabels[i] = "(" + a + ", " + b + "]"
		}
	}
	first := formatFloat(edges[0])
	last := formatFloat(edges[len(edges)-1])
	if inclusive == "left" {
		underAuto = "(-inf, " + first + ")"
		overAuto = "[" + last + ", +inf)"
	} else {
		underAuto = "(-inf, " + first + "]"
		overAuto = "(" + last + ", +inf)"
	}

	labels := autoLabels
	if labelsRaw, ok := sm["labels"]; ok {
		list, ok := labelsRaw.([]interface{})
		if !ok {
			return nil, fmt.Errorf("config: bucket: labels length 0 does not match edges-1 %d", labelCount)
		}
		if len(list) != labelCount {
			return nil, fmt.Errorf("config: bucket: labels length %d does not match edges-1 %d", len(list), labelCount)
		}
		labels = make([]string, labelCount)
		seen := map[string]bool{}
		for i, item := range list {
			ls, ok := item.(string)
			if !ok {
				ls = fmt.Sprintf("%v", item)
			}
			if ls == "" {
				return nil, fmt.Errorf("config: bucket: labels[%d] must be a non-empty string", i)
			}
			if seen[ls] {
				return nil, fmt.Errorf("config: bucket: labels has duplicate entry %s", ls)
			}
			seen[ls] = true
			labels[i] = ls
		}
	}

	underLabel := underAuto
	if s, ok := getString(sm, "under_label"); ok {
		if s == "" {
			return nil, fmt.Errorf("config: bucket: under_label must be a non-empty string")
		}
		for _, label := range labels {
			if s == label {
				return nil, fmt.Errorf("config: bucket: under_label collides with labels entry %s", s)
			}
		}
		underLabel = s
	}
	overLabel := overAuto
	if s, ok := getString(sm, "over_label"); ok {
		if s == "" {
			return nil, fmt.Errorf("config: bucket: over_label must be a non-empty string")
		}
		for _, label := range labels {
			if s == label {
				return nil, fmt.Errorf("config: bucket: over_label collides with labels entry %s", s)
			}
		}
		overLabel = s
	}

	return &BucketStage{
		column:       column,
		into:         into,
		edges:        edges,
		labels:       labels,
		underLabel:   underLabel,
		overLabel:    overLabel,
		inclusive:    inclusive,
		onMissing:    onMissing,
		onNonNumeric: onNonNumeric,
	}, nil
}

func (s *BucketStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
	out := make([]*record.Record, 0, len(in))
	for _, r := range in {
		v, ok := r.Get(s.column)
		missing := !ok || v == ""
		if missing {
			switch s.onMissing {
			case "drop":
				stats.DroppedMissing++
				fmt.Fprintf(stderr, "flowctl: bucket: drop missing-column row %d\n", r.InputRow)
				if strict {
					return nil, fmt.Errorf("strict: missing column %s", s.column)
				}
				continue
			case "error":
				return nil, fmt.Errorf("bucket: missing column %s at row %d", s.column, r.InputRow)
			case "keep_empty":
				nr := r.Copy()
				if nr.Has(s.into) {
					return nil, fmt.Errorf("bucket: into column %s already present at row %d", s.into, r.InputRow)
				}
				nr.Set(s.into, "")
				out = append(out, nr)
				continue
			}
		}

		f, err := parseFloat(v)
		if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {
			switch s.onNonNumeric {
			case "drop":
				stats.DroppedNonNumeric++
				fmt.Fprintf(stderr, "flowctl: bucket: drop non-numeric row %d\n", r.InputRow)
				if strict {
					return nil, fmt.Errorf("strict: non-numeric row %d", r.InputRow)
				}
				continue
			case "error":
				return nil, fmt.Errorf("bucket: non-numeric value in column %s at row %d", s.column, r.InputRow)
			case "keep_empty":
				nr := r.Copy()
				if nr.Has(s.into) {
					return nil, fmt.Errorf("bucket: into column %s already present at row %d", s.into, r.InputRow)
				}
				nr.Set(s.into, "")
				out = append(out, nr)
				continue
			}
		}

		label := s.bucketLabel(f)
		nr := r.Copy()
		if nr.Has(s.into) {
			return nil, fmt.Errorf("bucket: into column %s already present at row %d", s.into, r.InputRow)
		}
		nr.Set(s.into, label)
		out = append(out, nr)
	}
	return out, nil
}

func (s *BucketStage) bucketLabel(v float64) string {
	first := s.edges[0]
	last := s.edges[len(s.edges)-1]
	if s.inclusive == "right" {
		if v <= first {
			return s.underLabel
		}
		if v > last {
			return s.overLabel
		}
		for i := 0; i < len(s.edges)-1; i++ {
			if v > s.edges[i] && v <= s.edges[i+1] {
				return s.labels[i]
			}
		}
	} else {
		if v < first {
			return s.underLabel
		}
		if v >= last {
			return s.overLabel
		}
		for i := 0; i < len(s.edges)-1; i++ {
			if v >= s.edges[i] && v < s.edges[i+1] {
				return s.labels[i]
			}
		}
	}
	return s.overLabel
}
