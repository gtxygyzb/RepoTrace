   127	type ProjectStage struct {
   128		columns []ProjectColumn
   129	}
   130	
   131	func (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   132		out := make([]*record.Record, 0, len(in))
   133		for _, r := range in {
   134			nr := record.New()
   135			nr.InputRow = r.InputRow
   136			for _, c := range s.columns {
   137				val := ""
   138				if v, ok := r.Get(c.Source); ok {
   139					val = v
   140				}
   141				nr.Set(c.Target, val)
   142			}
   143			out = append(out, nr)
   144		}
   145		return out, nil
   146	}
