    24	func (s *GroupStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    25		type groupState struct {
    26			keyParts []string
    27			firstRow int
    28			count    int
    29			sums     []float64
    30			mins     []float64
    31			maxs     []float64
    32			hasMin   []bool
    33			hasMax   []bool
    34		}
    35	
    36		order := []string{}
    37		keys := map[string]*groupState{}
    38	
    39		for _, r := range in {
    40			keyParts := make([]string, len(s.by))
    41			for i, col := range s.by {
    42				v, ok := r.Get(col)
    43				if !ok {
    44					return nil, fmt.Errorf("group: missing column %s", col)
    45				}
    46				keyParts[i] = v
    47			}
    48			key := strings.Join(keyParts, "\x00")
    49	
    50			st, exists := keys[key]
    51			if !exists {
    52				st = &groupState{
    53					keyParts: keyParts,
    54					firstRow: r.InputRow,
    55					sums:     make([]float64, len(s.aggregates)),
    56					mins:     make([]float64, len(s.aggregates)),
    57					maxs:     make([]float64, len(s.aggregates)),
    58					hasMin:   make([]bool, len(s.aggregates)),
    59					hasMax:   make([]bool, len(s.aggregates)),
    60				}
    61				keys[key] = st
    62				order = append(order, key)
    63			}
    64			st.count++
    65	
    66			for i, agg := range s.aggregates {
    67				if agg.Op == "count" {
    68					continue
    69				}
    70	
    71				v, ok := r.Get(agg.Column)
    72				if !ok {
    73					return nil, fmt.Errorf("group: missing column %s", agg.Column)
    74				}
    75				f, err := parseFloat(v)
    76				if err != nil {
    77					return nil, fmt.Errorf("group: non-numeric value in column %s at row %d", agg.Column, r.InputRow)
    78				}
    79	
    80				st.sums[i] += f
    81				if !st.hasMin[i] || f < st.mins[i] {
    82					st.mins[i] = f
    83					st.hasMin[i] = true
    84				}
    85				if !st.hasMax[i] || f > st.maxs[i] {
    86					st.maxs[i] = f
    87					st.hasMax[i] = true
    88				}
    89			}
    90		}
    91	
    92		out := make([]*record.Record, 0, len(order))
    93		for _, key := range order {
    94			st := keys[key]
    95			nr := record.New()
    96			nr.InputRow = st.firstRow
    97	
    98			for i, col := range s.by {
    99				nr.Set(col, st.keyParts[i])
   100			}
   101	
   102			for i, agg := range s.aggregates {
   103				switch agg.Op {
   104				case "count":
   105					nr.Set(agg.As, strconv.Itoa(st.count))
   106				case "sum":
   107					nr.Set(agg.As, formatFloat(st.sums[i]))
   108				case "min":
   109					nr.Set(agg.As, formatFloat(st.mins[i]))
   110				case "max":
   111					nr.Set(agg.As, formatFloat(st.maxs[i]))
   112				case "avg":
   113					if st.count == 0 {
   114						return nil, fmt.Errorf("group: avg of empty group")
   115					}
   116					nr.Set(agg.As, formatFloat(st.sums[i]/float64(st.count)))
   117				}
   118			}
   119	
   120			out = append(out, nr)
   121		}
   122	
   123		return out, nil
   124	}
   125	
   126	func buildGroup(idx int, sm map[string]interface{}) (Stage, error) {
   127		byRaw, ok := sm["by"]
   128		if !ok {
   129			return nil, fmt.Errorf("config: stage %d: group.by is required", idx)
   130		}
   131		by, err := toStringList(byRaw)
   132		if err != nil {
   133			return nil, fmt.Errorf("config: stage %d: group.by: %v", idx, err)
   134		}
   135		if len(by) == 0 {
   136			return nil, fmt.Errorf("config: stage %d: group.by must be non-empty", idx)
   137		}
   138	
   139		aggRaw, ok := sm["aggregates"]
   140		if !ok {
   141			return nil, fmt.Errorf("config: stage %d: group.aggregates is required", idx)
   142		}
   143		aggList, ok := aggRaw.([]interface{})
   144		if !ok {
   145			return nil, fmt.Errorf("config: stage %d: group.aggregates must be a list", idx)
   146		}
   147		if len(aggList) == 0 {
   148			return nil, fmt.Errorf("config: stage %d: group.aggregates must be non-empty", idx)
   149		}
   150	
   151		aggregates := make([]GroupAggregate, 0, len(aggList))
   152		seen := map[string]bool{}
   153		for i, item := range aggList {
   154			am, ok := item.(map[string]interface{})
   155			if !ok {
   156				return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d must be a mapping", idx, i+1)
   157			}
   158	
   159			name, ok := getString(am, "as")
   160			if !ok || name == "" {
   161				return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: as is required", idx, i+1)
   162			}
   163			if seen[name] {
   164				return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: duplicate as %q", idx, i+1, name)
   165			}
   166	
   167			op, ok := getString(am, "op")
   168			if !ok || op == "" {
   169				return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: op is required", idx, i+1)
   170			}
   171			switch op {
   172			case "count", "sum", "min", "max", "avg":
   173			default:
   174				return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: op must be count, sum, min, max, or avg", idx, i+1)
   175			}
   176	
   177			col, hasCol := getString(am, "column")
   178			if op == "count" {
   179				if hasCol {
   180					return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: column must not be present for count", idx, i+1)
   181				}
   182			} else {
   183				if !hasCol || col == "" {
   184					return nil, fmt.Errorf("config: stage %d: group.aggregates entry %d: column is required", idx, i+1)
   185				}
   186			}
   187	
   188			aggregates = append(aggregates, GroupAggregate{As: name, Op: op, Column: col})
   189			seen[name] = true
   190		}
   191	
   192		return &GroupStage{by: by, aggregates: aggregates}, nil
   193	}
   194	
   195	func toStringList(v interface{}) ([]string, error) {
   196		list, ok := v.([]interface{})
   197		if !ok {
   198			return nil, fmt.Errorf("must be a list of strings")
   199		}
   200		out := []string{}
   201		for i, item := range list {
   202			s, ok := item.(string)
   203			if !ok {
   204				return nil, fmt.Errorf("entry %d must be a string", i+1)
   205			}
   206			out = append(out, s)
   207		}
   208		return out, nil
   209	}
   210	
   211	func formatFloat(f float64) string {
   212		if math.IsNaN(f) || math.IsInf(f, 0) {
   213			return strconv.FormatFloat(f, 'g', -1, 64)
   214		}
   215		if f == float64(int64(f)) {
   216			return strconv.FormatInt(int64(f), 10)
   217		}
   218		return strconv.FormatFloat(f, 'g', -1, 64)
   219	}
