   352	func buildLimit(idx int, sm map[string]interface{}) (Stage, error) {
   353		countRaw, ok := sm["count"]
   354		if !ok {
   355			return nil, fmt.Errorf("config: stage %d: limit.count is required", idx)
   356		}
   357		countStr, ok := countRaw.(string)
   358		if !ok {
   359			return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)
   360		}
   361		n, err := strconv.Atoi(countStr)
   362		if err != nil || n < 0 {
