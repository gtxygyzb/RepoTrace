    71	type FilterStage struct {
    72		column string
    73		op     string
    74		value  string
    75	}
    76	
    77	func (s *FilterStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
    78		out := make([]*record.Record, 0, len(in))
    79	
    80		for _, r := range in {
    81			v, ok := r.Get(s.column)
    82			if !ok {
    83				stats.DroppedMissing++
    84				if !stats.missingReported {
    85					fmt.Fprintf(stderr, "flowctl: filter: missing column %s\n", s.column)
    86					stats.missingReported = true
    87				}
    88				if strict {
    89					return nil, fmt.Errorf("filter: missing column %s", s.column)
    90				}
    91				continue
    92			}
    93	
    94			keep := false
    95			switch s.op {
    96			case "==":
    97				keep = v == s.value
    98			case "!=":
    99				keep = v != s.value
   100			default:
   101				left, err := parseFloat(v)
   102				if err != nil {
   103					stats.DroppedNonNumeric++
   104					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
   105					if strict {
   106						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   107					}
   108					continue
   109				}
   110				right, err := parseFloat(s.value)
   111				if err != nil {
   112					stats.DroppedNonNumeric++
   113					fmt.Fprintf(stderr, "flowctl: filter: drop non-numeric row %d\n", r.InputRow)
   114					if strict {
   115						return nil, fmt.Errorf("filter: drop non-numeric row %d", r.InputRow)
   116					}
   117					continue
   118				}
   119				keep = compareFloats(left, s.op, right)
   120			}
   121	
   122			if keep {
   123				out = append(out, r)
   124			}
   125		}
   126	
   127		return out, nil
   128	}
   129	
   130	type ProjectColumn struct {
   131		Source string
   132		Target string
   133	}
   134	
   135	type ProjectStage struct {
   136		columns []ProjectColumn
   137	}
   138	
   139	func (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   140		out := make([]*record.Record, 0, len(in))
   141		for _, r := range in {
   142			nr := record.New()
   143			nr.InputRow = r.InputRow
   144			for _, c := range s.columns {
   145				val := ""
   146				if v, ok := r.Get(c.Source); ok {
   147					val = v
   148				}
   149				nr.Set(c.Target, val)
   150			}
   151			out = append(out, nr)
   152		}
   153		return out, nil
   154	}
   155	
   156	type SortKey struct {
   157		Column string
   158		Order  string
   159		As     string
   160	}
   161	
   162	type SortStage struct {
   163		keys []SortKey
   164	}
   165	
   166	func (s *SortStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   167		for _, key := range s.keys {
   168			if key.As == "number" {
   169				for _, r := range in {
   170					v, ok := r.Get(key.Column)
   171					if !ok || v == "" {
   172						continue
   173					}
   174					if _, err := parseFloat(v); err != nil {
   175						return nil, fmt.Errorf("sort: column %s value %q is not a number", key.Column, v)
   176					}
   177				}
   178			}
   179		}
   180	
   181		sort.SliceStable(in, func(i, j int) bool {
   182			for _, key := range s.keys {
   183				a, aok := in[i].Get(key.Column)
   184				b, bok := in[j].Get(key.Column)
   185	
   186				if key.As == "number" {
   187					aMissing := !aok || a == ""
   188					bMissing := !bok || b == ""
   189					if aMissing != bMissing {
   190						if key.Order == "desc" {
   191							return bMissing
   192						}
   193						return aMissing
   194					}
   195					if aMissing {
   196						continue
   197					}
   198					af, errA := parseFloat(a)
   199					bf, errB := parseFloat(b)
   200					if errA != nil || errB != nil {
   201						return false
   202					}
   203					if af != bf {
   204						if key.Order == "desc" {
   205							return af > bf
   206						}
   207						return af < bf
   208					}
   209				} else {
   210					aMissing := !aok || a == ""
   211					bMissing := !bok || b == ""
   212					if aMissing != bMissing {
   213						if key.Order == "desc" {
   214							return aMissing
   215						}
   216						return bMissing
   217					}
   218					if aMissing {
   219						continue
   220					}
   221					if a != b {
   222						if key.Order == "desc" {
   223							return a > b
   224						}
   225						return a < b
   226					}
   227				}
   228			}
   229			return false
   230		})
   231	
   232		return in, nil
   233	}
   234	
   235	type LimitStage struct {
   236		count int
   237	}
   238	
   239	func (s *LimitStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   240		if s.count < len(in) {
   241			return in[:s.count], nil
   242		}
   243		return in, nil
   244	}
