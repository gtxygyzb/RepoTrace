   126	type ProjectColumn struct {
   127		Source string
   128		Target string
   129	}
   130	
   131	type ProjectStage struct {
   132		columns []ProjectColumn
   133	}
   134	
   135	func (s *ProjectStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {
   136		out := make([]*record.Record, 0, len(in))
   137		for _, r := range in {
   138			nr := record.New()
   139			nr.InputRow = r.InputRow
   140			for _, c := range s.columns {
   141				val := ""
   142				if v, ok := r.Get(c.Source); ok {
   143					val = v
   144				}
   145				nr.Set(c.Target, val)
   146			}
   147			out = append(out, nr)
   148		}
   149		return out, nil
   150	}
