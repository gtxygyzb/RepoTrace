der\n    b.WriteByte(\'"\')\n    for i := 0; i < len(s); i++ {\n        c := s[i]\n        switch c {\n        case \'\\\\\':\n            b.WriteString("\\\\\\\\")\n        case \'"\':\n            b.WriteString("\\\\\\"")\n        case \'\\n\':\n            b.WriteString("\\\\n")\n        case \'\\r\':\n            b.WriteString("\\\\r")\n        case \'\\t\':\n            b.WriteString("\\\\t")\n        default:\n            if c < 0x20 {\n                fmt.Fprintf(&b, "\\\\u%04x", c)\n            } else {\n                b.WriteByte(c)\n            }\n        }\n    }\n    b.WriteByte(\'"\')\n    return b.String()\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
