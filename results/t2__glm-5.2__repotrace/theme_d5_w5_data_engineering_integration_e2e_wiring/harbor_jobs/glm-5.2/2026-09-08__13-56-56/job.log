Sending keys: ['cat > internal/stage/bucket.go <<\'GO\'\npackage stage\n\nimport (\n        "fmt"\n        "io"\n        "math"\n        "strconv"\n        "strings"\n\n        "example.com/flowctl/internal/record"\n)\n\ntype BucketStage struct {\n        column        string\n        into         string\n        edges        []float64\n        labels       []string\n        underLabel   string\n        overLabel    string\n        inclusive    string\n        onMissing    string\n        onNonNumeric string\n}\n\nfunc buildBucket(idx int, sm map[string]interface{}) (Stage, error) {\n        column, ok := getString(sm, "column")\n        if !ok || column == "" {\n                return nil, fmt.Errorf("config: stage %d: bucket: column must be a non-empty string", idx)\n        }\n        into, ok := getString(sm, "into")\n        if !ok || into == "" {\n                return nil, fmt.Errorf("config: stage %d: bucket: into must be a non-empty string", idx)\n        }\n        if into == column {\n                return nil, fmt.Errorf("config: stage %d: bucket: into must differ from column", idx)\n        }\n\n        inclusive, ok := getString(sm, "inclusive")\n        if !ok || inclusive == "" {\n                inclusive = "right"\n        }\n        if inclusive != "left" && inclusive != "right" {\n                return nil, fmt.Errorf("config: stage %d: bucket: inclusive must be left or right", idx)\n        }\n\n        onMissing, ok := getString(sm, "on_missing")\n        if !ok || onMissing == "" {\n                onMissing = "keep_empty"\n        }\n        if onMissing != "keep_empty" && onMissing != "drop" && onMissing != "error" {\n                return nil, fmt.Errorf("config: stage %d: bucket: on_missing must be keep_empty, drop, or error", idx)\n        }\n\n        onNonNumeric, ok := getString(sm, "on_non_numeric")\n        if !ok || onNonNumeric == "" {\n                onNonNumeric = "error"\n        }\n        if onNonNumeric != "error" && onNonNumeric != "drop" && onNonNumeric != "keep_empty" {\n                return nil, fmt.Errorf("config: stage %d: bucket: on_non_numeric must be error, drop, or keep_empty", idx)\n        }\n\n        _, hasEdges := sm["edges"]\n        _, hasWidth := sm["width"]\n        if hasEdges == hasWidth {\n                return nil, fmt.Errorf("config: stage %d: bucket: exactly one of edges or width is required", idx)\n        }\n\n        var (\n                edges       []float64\n                labelCount  int\n                autoLabels  []string\n                underAuto   string\n                overAuto    string\n        )\n\n        if hasWidth {\n                widthRaw, ok := sm["width"]\n                if !ok {\n                        return nil, fmt.Errorf("config: stage %d: bucket: exactly one of edges or width is required", idx)\n                }\n                wm, ok := widthRaw.(map[string]interface{})\n                if !ok {\n                        return nil, fmt.Errorf("config: stage %d: bucket: width must be a mapping", idx)\n                }\n                for k := range wm {\n                        if k != "step" && k != "start" && k != "count" {\n                                return nil, fmt.Errorf("config: stage %d: bucket: unknown key %s in width", idx, k)\n                        }\n                }\n\n                stepStr, ok := getString(wm, "step")\n                if !ok || stepStr == "" {\n                        return nil, fmt.Errorf("config: stage %d: bucket: width.step must be a positive finite number", idx)\n                }\n                step, err := parseFloat(stepStr)\n                if err != nil || math.IsNaN(step) || math.IsInf(step, 0) || step <= 0 {\n                        return nil, fmt.Errorf("config: stage %d: bucket: width.step must be a positive finite number", idx)\n                }\n\n                start := 0.0\n                if startStr, ok := getString(wm, "start"); ok && startStr != "" {\n                        var err error\n                        start, err = parseFloat(startStr)\n                        if err != nil || math.IsNaN(start) || math.IsInf(start, 0) {\n                                return nil, fmt.Errorf("config: stage %d: bucket: width.start must be a finite number", idx)\n                        }\n                }\n\n                countStr, ok := getString(wm, "count")\n                if !ok || countStr == "" {\n                        return nil, fmt.Errorf("config: stage %d: bucket: width.count must be a positive integer", idx)\n                }\n                countI, err := strconv.Atoi(countStr)\n                if err != nil || countI < 1 {\n                        return nil, fmt.Errorf("config: stage %d: bucket: width.count must be a positive integer", idx)\n                }\n\n                edges = make([]float64, 0, countI+1)\n                for i := 0; i <= countI; i++ {\n                        edges = append(edges, start+step*float64(i))\n                }\n                labelCount = countI\n        } else {\n                edgesRaw, ok := sm["edges"]\n                if !ok {\n                        return nil, fmt.Errorf("config: stage %d: bucket: edges must have at least two entries", idx)\n                }\n                list, ok := edgesRaw.([]interface{})\n                if !ok {\n                        return nil, fmt.Errorf("config: stage %d: bucket: edges must have at least two entries", idx)\n                }\n                if len(list) < 2 {\n                        return nil, fmt.Errorf("config: stage %d: bucket: edges must have at least two entries", idx)\n                }\n                edges = make([]float64, 0, len(list))\n                for i, item := range list {\n                        es, ok := item.(string)\n                        if !ok {\n                                es = fmt.Sprintf("%v", item)\n                        }\n                        f, err := parseFloat(es)\n                        if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {\n                                return nil, fmt.Errorf("config: stage %d: bucket: edges[%d] is not a finite number", idx, i)\n                        }\n                        if i > 0 && f <= edges[i-1] {\n                                return nil, fmt.Errorf("config: stage %d: bucket: edges must be strictly increasing", idx)\n                        }\n                        edges = append(edges, f)\n                }\n                labelCount = len(edges) - 1\n        }\n\n        for i := 1; i < len(edges); i++ {\n                if edges[i] <= edges[i-1] {\n                        return nil, fmt.Errorf("config: stage %d: bucket: edges must be strictly increasing", idx)\n        }\n        }\n\n        autoLabels = make([]string, labelCount)\n        for i := 0; i < labelCount; i++ {\n                a := formatFloat(edges[i])\n                b := formatFloat(edges[i+1])\n                if inclusive == "left" {\n                        autoLabels[i] = "[" + a + ", " + b + ")"\n                } else {\n                        autoLabels[i] = "(" + a + ", " + b + "]"\n                }\n        }\n        first := formatFloat(edges[0])\n        last := formatFloat(edges[len(edges)-1])\n        if inclusive == "left" {\n                underAuto = "(-inf, " + first + ")"\n                overAuto = "[" + last + ", +inf)"\n        } else {\n                underAuto = "(-inf, " + first + "]"\n                overAuto = "(" + last + ", +inf)"\n        }\n\n        labels := autoLabels\n        if labelsRaw, ok := sm["labels"]; ok {\n                list, ok := labelsRaw.([]interface{})\n                if !ok {\n                        return nil, fmt.Errorf("config: stage %d: bucket: labels length 0 does not match edges-1 %d", idx, labelCount)\n                }\n                if len(list) != labelCount {\n                        return nil, fmt.Errorf("config: stage %d: bucket: labels length %d does not match edges-1 %d", idx, len(list), labelCount)\n                }\n                labels = make([]string, labelCount)\n                seen := map[string]bool{}\n                for i, item := range list {\n                        ls, ok := item.(string)\n                        if !ok {\n                                ls = fmt.Sprintf("%v", item)\n                        }\n                        if ls == "" {\n                                return nil, fmt.Errorf("config: stage %d: bucket: labels[%d] must be a non-empty string", idx, i)\n                        }\n                        if seen[ls] {\n                                return nil, fmt.Errorf("config: stage %d: bucket: labels has duplicate entry %s", idx, ls)\n                        }\n                        seen[ls] = true\n                        labels[i] = ls\n                }\n        }\n\n        underLabel := underAuto\n        if s, ok := getString(sm, "under_label"); ok {\n                if s == "" {\n                        return nil, fmt.Errorf("config: stage %d: bucket: under_label must be a non-empty string", idx)\n                }\n                for _, label := range labels {\n                        if s == label {\n                                return nil, fmt.Errorf("config: stage %d: bucket: under_label collides with labels entry %s", idx, s)\n                        }\n                }\n                underLabel = s\n        }\n        overLabel := overAuto\n        if s, ok := getString(sm, "over_label"); ok {\n                if s == "" {\n                        return nil, fmt.Errorf("config: stage %d: bucket: over_label must be a non-empty string", idx)\n                }\n                for _, label := range labels {\n                        if s == label {\n                                return nil, fmt.Errorf("config: stage %d: bucket: over_label collides with labels entry %s", idx, s)\n                        }\n                }\n                overLabel = s\n        }\n\n        return &BucketStage{\n                column:        column,\n                into:          into,\n                edges:        edges,\n                labels:       labels,\n                underLabel:   underLabel,\n                overLabel:    overLabel,\n                inclusive:    inclusive,\n                onMissing:    onMissing,\n                onNonNumeric: onNonNumeric,\n        }, nil\n}\n\nfunc (s *BucketStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\n        out := make([]*record.Record, 0, len(in))\n        for _, r := range in {\n                v, ok := r.Get(s.column)\n                missing := !ok || v == ""\n                if missing {\n                        switch s.onMissing {\n                        case "drop":\n                                stats.DroppedMissing++\n                                fmt.Fprintf(stderr, "flowctl: bucket: drop missing-column row %d\\n", r.InputRow)\n                                if strict {\n                                        return nil, fmt.Errorf("strict: missing column %s", s.column)\n                                }\n                                continue\n                        case "error":\n                                return nil, fmt.Errorf("flowctl: bucket: missing column %s at row %d", s.column, r.InputRow)\n                        case "keep_empty":\n                                nr := r.Copy()\n                                if nr.Has(s.into) {\n                                        return nil, fmt.Errorf("flowctl: bucket: into column %s already present at row %d", s.into, r.InputRow)\n                                }\n                                nr.Set(s.into, "")\n                                out = append(out, nr)\n                                continue\n                        }\n                }\n\n                f, err := parseFloat(v)\n                if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {\n                        switch s.onNonNumeric {\n                        case "drop":\n                                stats.DroppedNonNumeric++\n                                fmt.Fprintf(stderr, "flowctl: bucket: drop non-numeric row %d\\n", r.InputRow)\n                                if strict {\n                                        return nil, fmt.Errorf("strict: non-numeric row %d", r.InputRow)\n                                }\n                                continue\n                        case "error":\n                                return nil, fmt.Errorf("flowctl: bucket: non-numeric value in column %s at row %d", s.column, r.InputRow)\n                        case "keep_empty":\n                                nr := r.Copy()\n                                if nr.Has(s.into) {\n                                        return nil, fmt.Errorf("flowctl: bucket: into column %s already present at row %d", s.into, r.InputRow)\n                                }\n                                nr.Set(s.into, "")\n                                out = append(out, nr)\n                                continue\n                        }\n                }\n\n                label := s.bucketLabel(f)\n                nr := r.Copy()\n                if nr.Has(s.into) {\n                        return nil, fmt.Errorf("flowctl: bucket: into column %s already present at row %d", s.into, r.InputRow)\n                }\n                nr.Set(s.into, label)\n                out = append(out, nr)\n        }\n        return out, nil\n}\n\nfunc (s *BucketStage) bucketLabel(v float64) string {\n        first := s.edges[0]\n        last := s.edges[len(s.edges)-1]\n        if s.inclusive == "right" {\n                if v <= first {\n                        return s.underLabel\n                }\n                if v > last {\n                        return s.overLabel\n                }\n                for i := 0; i < len(s.edges)-1; i++ {\n                        if v > s.edges[i] && v <= s.edges[i+1] {\n                                return s.labels[i]\n                        }\n                }\n        } else {\n                if v < first {\n                        return s.underLabel\n                }\n                if v >= last {\n                        return s.overLabel\n                }\n                for i := 0; i < len(s.edges)-1; i++ {\n                        if v >= s.edges[i] && v < s.edges[i+1] {\n                                return s.labels[i]\n                        }\n                }\n        }\n        return s.overLabel\n}\n\nfunc formatBucketFloat(f float64) string {\n        if f == math.Trunc(f) && !math.IsInf(f, 0) && math.Abs(f) < 1e15 {\n                return strconv.FormatInt(int64(f), 10)\n        }\n        return strconv.FormatFloat(f, \'g\', -1, 64)\n}\n\nfunc init() {\n        _ = strings.TrimSpace\n}\nGO\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
