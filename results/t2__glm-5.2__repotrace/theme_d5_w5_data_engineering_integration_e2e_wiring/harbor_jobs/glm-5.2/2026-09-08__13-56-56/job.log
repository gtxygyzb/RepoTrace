art < len(indexed) {\n\t\tend := start\n\t\tfor end < len(indexed) && sameRankPartition(in[indexed[start]], in[indexed[end]], s.partitionBy) {\n\t\t\tend++\n\t\t}\n\n\t\tgpos := 1\n\t\ti := start\n\t\tfor i < end {\n\t\t\tj := i + 1\n\t\t\tfor j < end && sameRankKey(in[indexed[i]], in[indexed[j]], s.keys) {\n\t\t\t\tj++\n\t\t\t}\n\t\t\trankInt := gpos\n\t\t\tfor k := i; k < j; k++ {\n\t\t\t\tin[indexed[k]].Set(s.into, s.renderValue(rankInt, end-start))\n\t\t\t}\n\t\t\tgpos += (j - i)\n\t\t\ti = j\n\t\t}\n\t\tstart = end\n\t}\n\n\treturn in, nil\n}\n\nfunc (s *RankStage) renderValue(rankInt, n_part int) string {\n\tswitch s.method {\n\tcase "dense":\n\t\treturn strconv.Itoa(rankInt)\n\tcase "rank":\n\t\treturn strconv.Itoa(rankInt)\n\tcase "row":\n\t\treturn strconv.Itoa(rankInt)\n\tcase "percent":\n\t\treturn formatPercent(float64(rankInt-1) / float64(n_part))\n\tdefault:\n\t\treturn strconv.Itoa(rankInt)\n\t}\n}\n\nfunc sameRankKey(a, b *record.Record, keys []RankKey) bool {\n\tfor _, key := range keys {\n\t\tav, aok := a.Get(key.Column)\n\t\tbv, bok := b.Get(key.Column)\n\t\taMissing := !aok || av == ""\n\t\tbMissing := !bok || bv == ""\n\t\tif aMissing != bMissing {\n\t\t\treturn false\n\t\t}\n\t\tif aMissing {\n\t\t\tcontinue\n\t\t}\n\t\tif key.As == "number" {\n\t\t\taf, errA := parseFloat(av)\n\t\t\tbf, errB := parseFloat(bv)\n\t\t\tif errA != nil || errB != nil {\n\t\t\t\treturn av == bv\n\t\t\t}\n\t\t\tif af != bf {\n\t\t\t\treturn false\n\t\t\t}\n\t\t} else if av != bv {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc sameRankPartition(a, b *record.Record, partitionBy []string) bool {\n\tfor _, col := range partitionBy {\n\t\tav, _ := a.Get(col)\n\t\tbv, _ := b.Get(col)\n\t\tif av != bv {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc formatPercent(f float64) string {\n\treturn strconv.FormatFloat(f, \'f\', 6, 64)\n}\n\nfunc buildRank(idx int, sm map[string]interface{}) (Stage, error) {\n\tkeysRaw, ok := sm["order_by"]\n\tif !ok {\n\t\treturn nil, fmt.Errorf("config: stage %d: rank.order_by is required", idx)\n\t}\n\tlist, ok := keysRaw.([]interface{})\n\tif !ok {\n\t\treturn nil, fmt.Errorf("config: stage %d: rank.order_by must be a list", idx)\n\t}\n\n\tkeys := make([]RankKey, 0, len(list))\n\tfor j, item := range list {\n\t\tkm, ok := item.(map[string]interface{})\n\t\tif !ok {\n\t\t\treturn nil, fmt.Errorf("config: stage %d: rank.order_by entry %d must be a mapping", idx, j+1)\n\t\t}\n\t\tcolumn, ok := getString(km, "column")\n\t\tif !ok || column == "" {\n\t\t\treturn nil, fmt.Errorf("config: stage %d: rank.order_by entry %d column is required", idx, j+1)\n\t\t}\n\t\torder, ok := getString(km, "order")\n\t\tif !ok || order == "" {\n\t\t\torder = "asc"\n\t\t}\n\t\tif order != "asc" && order != "desc" {\n\t\t\treturn nil, fmt.Errorf("config: stage %d: rank.order_by entry %d order must be asc or desc", idx, j+1)\n\t\t}\n\t\tas, ok := getString(km, "as")\n\t\tif !ok || as == "" {\n\t\t\tas = "string"\n\t\t}\n\t\tif as != "string" && as != "number" {\n\t\t\treturn nil, fmt.Errorf("config: stage %d: rank.order_by entry %d as must be string or number", idx, j+1)\n\t\t}\n\t\tnullPos, _ := getString(km, "null_position")\n\t\tif nullPos == "" {\n\t\t\tnullPos = "last"\n\t\t}\n\t\tif nullPos != "last" && nullPos != "first" {\n\t\t\treturn nil, fmt.Errorf("config: stage %d: rank.order_by entry %d null_position must be first or last", idx, j+1)\n\t\t}\n\t\tkeys = append(keys, RankKey{Column: column, As: as, Order: order, NullPosition: nullPos})\n\t}\n\n\tmethod, ok := getString(sm, "method")\n\tif !ok || method == "" {\n\t\tmethod = "rank"\n\t}\n\tif method != "dense" && method != "rank" && method != "row" && method != "percent" {\n\t\treturn nil, fmt.Errorf("config: stage %d: rank.method must be dense, rank, row, or percent", idx)\n\t}\n\n\tinto, ok := getString(sm, "into")\n\tif !ok || into == "" {\n\t\treturn nil, fmt.Errorf("config: stage %d: rank.into is required", idx)\n\t}\n\n\tpartitionBy := []string{}\n\tif raw, ok := sm["partition_by"]; ok {\n\t\tplist, err := toStringList(raw)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf("config: stage %d: rank.partition_by %v", idx, err)\n\t\t}\n\t\tpartitionBy = plist\n\t}\n\n\treturn &RankStage{keys: keys, method: method, into: into, partitionBy: partitionBy}, nil\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
