age %d: filter.where must be a mapping", idx)\n    }\n\n    column, ok := getString(where, "column")\n    if !ok || column == "" {\n        return nil, fmt.Errorf("config: stage %d: filter.where.column is required", idx)\n    }\n\n    op, ok := getString(where, "op")\n    if !ok || op == "" {\n        return nil, fmt.Errorf("config: stage %d: filter.where.op is required", idx)\n    }\n    switch op {\n    case "==", "!=", "<", "<=", ">", ">=":\n    default:\n        return nil, fmt.Errorf("config: stage %d: filter.where.op is invalid", idx)\n    }\n\n    value, ok := getString(where, "value")\n    if !ok {\n        return nil, fmt.Errorf("config: stage %d: filter.where.value is required", idx)\n    }\n\n    return &FilterStage{column: column, op: op, value: value}, nil\n}\n\nfunc buildProject(idx int, sm map[string]interface{}) (Stage, error) {\n    colsRaw, ok := sm["columns"]\n    if !ok {\n        return nil, fmt.Errorf("config: stage %d: project.columns is required", idx)\n    }\n    list, ok := colsRaw.([]interface{})\n    if !ok {\n        return nil, fmt.Errorf("config: stage %d: project.columns must be a list", idx)\n    }\n\n    columns := make([]ProjectColumn, 0, len(list))\n    seen := map[string]bool{}\n    for j, item := range list {\n        switch v := item.(type) {\n        case string:\n            if seen[v] {\n                return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, v)\n            }\n            seen[v] = true\n            columns = append(columns, ProjectColumn{Source: v, Target: v})\n        case map[string]interface{}:\n            name, ok := getString(v, "name")\n            if !ok || name == "" {\n                return nil, fmt.Errorf("config: stage %d: project column %d name is required", idx, j+1)\n            }\n            as, ok := getString(v, "as")\n            if !ok || as == "" {\n                return nil, fmt.Errorf("config: stage %d: project column %d as is required", idx, j+1)\n            }\n            if seen[as] {\n                return nil, fmt.Errorf("config: stage %d: project output column %q duplicated", idx, as)\n            }\n            seen[as] = true\n            columns = append(columns, ProjectColumn{Source: name, Target: as})\n        default:\n            return nil, fmt.Errorf("config: stage %d: project column %d must be a string or mapping", idx, j+1)\n        }\n    }\n\n    return &ProjectStage{columns: columns}, nil\n}\n\nfunc buildSort(idx int, sm map[string]interface{}) (Stage, error) {\n    keysRaw, ok := sm["keys"]\n    if !ok {\n        return nil, fmt.Errorf("config: stage %d: sort.keys is required", idx)\n    }\n    list, ok := keysRaw.([]interface{})\n    if !ok {\n        return nil, fmt.Errorf("config: stage %d: sort.keys must be a list", idx)\n    }\n\n    keys := make([]SortKey, 0, len(list))\n    for j, item := range list {\n        km, ok := item.(map[string]interface{})\n        if !ok {\n            return nil, fmt.Errorf("config: stage %d: sort key %d must be a mapping", idx, j+1)\n        }\n\n        column, ok := getString(km, "column")\n        if !ok || column == "" {\n            return nil, fmt.Errorf("config: stage %d: sort key %d column is required", idx, j+1)\n        }\n\n        order, ok := getString(km, "order")\n        if !ok || order == "" {\n            order = "asc"\n        }\n        if order != "asc" && order != "desc" {\n            return nil, fmt.Errorf("config: stage %d: sort key %d order must be asc or desc", idx, j+1)\n        }\n\n        as, ok := getString(km, "as")\n        if !ok || as == "" {\n            as = "string"\n        }\n        if as != "string" && as != "number" {\n            return nil, fmt.Errorf("config: stage %d: sort key %d as must be string or number", idx, j+1)\n        }\n\n        keys = append(keys, SortKey{Column: column, Order: order, As: as})\n    }\n\n    return &SortStage{keys: keys}, nil\n}\n\nfunc buildLimit(idx int, sm map[string]interface{}) (Stage, error) {\n    countRaw, ok := sm["count"]\n    if !ok {\n        return nil, fmt.Errorf("config: stage %d: limit.count is required", idx)\n    }\n    countStr, ok := countRaw.(string)\n    if !ok {\n        return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)\n    }\n    n, err := strconv.Atoi(countStr)\n    if err != nil || n < 0 {\n        return nil, fmt.Errorf("config: stage %d: limit.count must be a non-negative integer", idx)\n    }\n\n    return &LimitStage{count: n}, nil\n}\n\nfunc getString(m map[string]interface{}, key string) (string, bool) {\n    v, ok := m[key]\n    if !ok {\n        return "", false\n    }\n    if s, ok := v.(string); ok {\n        return s, true\n    }\n    return fmt.Sprintf("%v", v), true\n}\n\nfunc parseFloat(s string) (float64, error) {\n    f, err := strconv.ParseFloat(s, 64)\n    if err != nil {\n        return 0, err\n    }\n    if math.IsNaN(f) || math.IsInf(f, 0) {\n        return 0, fmt.Errorf("not a finite number")\n    }\n    return f, nil\n}\n\nfunc compareFloats(left float64, op string, right float64) bool {\n    switch op {\n    case "<":\n        return left < right\n    case "<=":\n        return left <= right\n    case ">":\n        return left > right\n    case ">=":\n        return left >= right\n    }\n    return false\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
