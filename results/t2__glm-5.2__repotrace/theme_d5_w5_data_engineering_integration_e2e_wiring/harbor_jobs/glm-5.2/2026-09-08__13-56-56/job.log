tindex := map[string][]map[string]string{}\n\tfor _, rr := range rightRecords {\n\t\tvals, err := s.projectRight(rr, schema)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\n\t\tskip := false\n\t\tfor _, col := range s.on {\n\t\t\tif vals[col] == "" {\n\t\t\t\tskip = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif skip {\n\t\t\tcontinue\n\t\t}\n\n\t\tkey := joinKey(s.on, vals)\n\t\tindex[key] = append(index[key], vals)\n\t}\n\n\tout := make([]*record.Record, 0, len(in))\n\tfor _, r := range in {\n\t\tfor _, col := range s.on {\n\t\t\tif !r.Has(col) {\n\t\t\t\treturn nil, fmt.Errorf("join: missing on column %s in left record", col)\n\t\t\t}\n\t\t}\n\n\t\tleftVals := map[string]string{}\n\t\tempty := false\n\t\tfor _, col := range s.on {\n\t\t\tv, _ := r.Get(col)\n\t\t\tleftVals[col] = v\n\t\t\tif v == "" {\n\t\t\t\tempty = true\n\t\t\t}\n\t\t}\n\n\t\tvar matches []map[string]string\n\t\tif !empty {\n\t\t\tmatches = index[joinKey(s.on, leftVals)]\n\t\t}\n\n\t\tif len(matches) == 0 {\n\t\t\tif s.kind == "left" {\n\t\t\t\tnr := r.Copy()\n\t\t\t\ts.addRightColumns(nr, nil, schema)\n\t\t\t\tout = append(out, nr)\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\n\t\tfor _, m := range matches {\n\t\t\tnr := r.Copy()\n\t\t\ts.addRightColumns(nr, m, schema)\n\t\t\tout = append(out, nr)\n\t\t}\n\t}\n\n\treturn out, nil\n}\n\nfunc (s *JoinStage) resolveRightSchema(rightRecords []*record.Record) ([]string, error) {\n\tif s.selectPresent {\n\t\treturn s.selectCols, nil\n\t}\n\tif len(rightRecords) == 0 {\n\t\treturn []string{}, nil\n\t}\n\treturn rightRecords[0].Order, nil\n}\n\nfunc (s *JoinStage) projectRight(rr *record.Record, schema []string) (map[string]string, error) {\n\tvals := make(map[string]string, len(schema))\n\tfor _, col := range schema {\n\t\tv, ok := rr.Get(col)\n\t\tif !ok {\n\t\t\tif s.isOn(col) {\n\t\t\t\treturn nil, fmt.Errorf("join: missing on column %s in right record", col)\n\t\t\t}\n\t\t\tv = ""\n\t\t}\n\t\tvals[col] = v\n\t}\n\treturn vals, nil\n}\n\nfunc (s *JoinStage) addRightColumns(nr *record.Record, vals map[string]string, schema []string) {\n\tfor _, col := range schema {\n\t\tif s.isOn(col) {\n\t\t\tcontinue\n\t\t}\n\t\tv := ""\n\t\tif vals != nil {\n\t\t\tv = vals[col]\n\t\t}\n\t\tnr.Set(s.prefix+col, v)\n\t}\n}\n\nfunc (s *JoinStage) isOn(col string) bool {\n\tfor _, c := range s.on {\n\t\tif c == col {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc joinKey(on []string, vals map[string]string) string {\n\tparts := make([]string, 0, len(on)*2)\n\tfor _, k := range on {\n\t\tparts = append(parts, k, vals[k])\n\t}\n\treturn strings.Join(parts, "\\x00")\n}\nGO\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
