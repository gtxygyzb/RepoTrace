Sending keys: ['cat > internal/stage/pivot.go <<\'GO\'\npackage stage\n\nimport (\n\t"fmt"\n\t"io"\n\t"sort"\n\t"strconv"\n\t"strings"\n\n\t"example.com/flowctl/internal/record"\n)\n\ntype PivotStage struct {\n\tindex        []string\n\tcolumns      string\n\tvalues       string\n\tasType       string\n\tagg          string\n\tfill         string\n\tsortColumns  string\n\tcolumnPrefix string\n\tstrictSchema bool\n\tdropEmpty    bool\n\tonConflict   string\n}\n\ntype pivotCell struct {\n\tcount     int\n\tsum       float64\n\tmin       float64\n\tmax       float64\n\thasNum    bool\n\tfirst     string\n\tlast      string\n\thasStr    bool\n\tcontribs  int\n}\n\nfunc (s *PivotStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\n\torder := []string{}\n\trows := map[string]*pivotRow{}\n\tcolOrder := []string{}\n\tcols := map[string]bool{}\n\n\tfor _, r := range in {\n\t\tidxParts := make([]string, len(s.index))\n\t\tfor i, col := range s.index {\n\t\t\tv, ok := r.Get(col)\n\t\t\tif !ok {\n\t\t\t\tv = ""\n\t\t\t}\n\t\t\tidxParts[i] = v\n\t\t}\n\t\tidxKey := strings.Join(idxParts, "\\x00")\n\n\t\tcol, ok := r.Get(s.columns)\n\t\tif !ok {\n\t\t\tcol = ""\n\t\t}\n\n\t\trow, exists := rows[idxKey]\n\t\tif !exists {\n\t\t\trow = &pivotRow{\n\t\t\t\tidxParts: idxParts,\n\t\t\t\tcells:    map[string]*pivotCell{},\n\t\t\t}\n\t\t\trows[idxKey] = row\n\t\t\torder = append(order, idxKey)\n\t\t}\n\n\t\tif !cols[col] {\n\t\t\tcols[col] = true\n\t\t\tcolOrder = append(colOrder, col)\n\t\t}\n\n\t\tcell, exists := row.cells[col]\n\t\tif !exists {\n\t\t\tcell = &pivotCell{}\n\t\t\trow.cells[col] = cell\n\t\t}\n\t\tcell.contribs++\n\n\t\tswitch s.agg {\n\t\tcase "count":\n\t\t\tcell.count++\n\t\tcase "sum", "min", "max", "avg":\n\t\t\tv, ok := r.Get(s.values)\n\t\t\tif !ok || v == "" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tf, err := parseFloat(v)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, fmt.Errorf("pivot: non-numeric value in column %s at row %d", s.values, r.InputRow)\n\t\t\t}\n\t\t\tcell.count++\n\t\t\tcell.sum += f\n\t\t\tif !cell.hasNum || f < cell.min {\n\t\t\t\tcell.min = f\n\t\t\t}\n\t\t\tif !cell.hasNum || f > cell.max {\n\t\t\t\tcell.max = f\n\t\t\t}\n\t\t\tcell.hasNum = true\n\t\tcase "first", "last":\n\t\t\tv, ok := r.Get(s.values)\n\t\t\tif !ok {\n\t\t\t\tv = ""\n\t\t\t}\n\t\t\tif s.onConflict == "error" && cell.contribs > 1 {\n\t\t\t\treturn nil, fmt.Errorf("pivot: duplicate contributor for cell %s/%s", strings.Join(row.idxParts, "|"), col)\n\t\t\t}\n\t\t\tif !cell.hasStr {\n\t\t\t\tcell.first = v\n\t\t\t\tcell.hasStr = true\n\t\t\t}\n\t\t\tcell.last = v\n\t\t}\n\t}\n\n\tsortedCols := s.sortPivotColumns(colOrder)\n\n\tout := make([]*record.Record, 0, len(order))\n\tfor _, idxKey := range order {\n\t\trow := rows[idxKey]\n\n\t\tallEmpty := true\n\t\tfor _, col := range sortedCols {\n\t\t\tcell := row.cells[col]\n\t\t\tif cell != nil && cell.contribs > 0 {\n\t\t\t\tallEmpty = false\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif s.dropEmpty && allEmpty {\n\t\t\tcontinue\n\t\t}\n\n\t\tnr := record.New()\n\t\tnr.InputRow = 0\n\t\tfor i, col := range s.index {\n\t\t\tnr.Set(col, row.idxParts[i])\n\t\t}\n\n\t\tfor _, col := range sortedCols {\n\t\t\tname := s.columnPrefix + col\n\t\t\tcell := row.cells[col]\n\t\t\tval, hadContrib := s.finalizeCell(cell)\n\t\t\tif s.strictSchema && !hadContrib {\n\t\t\t\treturn nil, fmt.Errorf("pivot: row %s missing pivot value %s", strings.Join(row.idxParts, "|"), col)\n\t\t\t}\n\t\t\tif !hadContrib {\n\t\t\t\tval = s.fill\n\t\t\t}\n\t\t\tnr.Set(name, val)\n\t\t}\n\n\t\tout = append(out, nr)\n\t}\n\n\treturn out, nil\n}\n\ntype pivotRow struct {\n\tidxParts []string\n\tcells    map[string]*pivotCell\n}\n\nfunc (s *PivotStage) finalizeCell(cell *pivotCell) (string, bool) {\n\tif cell == nil || cell.contribs == 0 {\n\t\treturn "", false\n\t}\n\tswitch s.agg {\n\tcase "count":\n\t\treturn strconv.Itoa(cell.count), true\n\tcase "sum":\n\t\tif cell.count == 0 {\n\t\t\treturn "", false\n\t\t}\n\t\treturn formatFloat(cell.sum), true\n\tcase "min":\n\t\tif cell.count == 0 {\n\t\t\treturn "", false\n\t\t}\n\t\treturn formatFloat(cell.min), true\n\tcase "max":\n\t\tif cell.count == 0 {\n\t\t\treturn "", false\n\t\t}\n\t\treturn formatFloat(cell.max), true\n\tcase "avg":\n\t\tif cell.count == 0 {\n\t\t\treturn "", false\n\t\t}\n\t\treturn formatFloat(cell.sum / float64(cell.count)), true\n\tcase "first":\n\t\treturn cell.first, true\n\tcase "last":\n\t\treturn cell.last, true\n\t}\n\treturn "", false\n}\n\nfunc (s *PivotStage) sortPivotColumns(colOrder []string) []string {\n\tout := make([]string, len(colOrder))\n\tcopy(out, colOrder)\n\tswitch s.sortColumns {\n\tcase "asc":\n\t\tsort.Slice(out, func(i, j int) bool { return out[i] < out[j] })\n\tcase "desc":\n\t\tsort.Slice(out, func(i, j int) bool { return out[i] > out[j] })\n\tcase "ingest":\n\t}\n\treturn out\n}\n\nfunc buildPivot(idx int, sm map[string]interface{}) (Stage, error) {\n\tindexRaw, ok := sm["index"]\n\tif !ok {\n\t\treturn nil, fmt.Errorf("config: pivot: index must be a non-empty list")\n\t}\n\tindex, err := toStringList(indexRaw)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf("config: pivot: index %v", err)\n\t}\n\tif len(index) == 0 {\n\t\treturn nil, fmt.Errorf("config: pivot: index must be a non-empty list")\n\t}\n\tfor _, col := range index {\n\t\tif col == "" {\n\t\t\treturn nil, fmt.Errorf("config: pivot: index must be a non-empty list")\n\t\t}\n\t}\n\n\tcolumns, ok := getString(sm, "columns")\n\tif !ok || columns == "" {\n\t\treturn nil, fmt.Errorf("config: pivot: columns is required")\n\t}\n\n\tvalues, ok := getString(sm, "values")\n\tif !ok || values == "" {\n\t\treturn nil, fmt.Errorf("config: pivot: values is required")\n\t}\n\n\tasType, ok := getString(sm, "as")\n\tif !ok || asType == "" {\n\t\treturn nil, fmt.Errorf("config: pivot: as is required")\n\t}\n\tif asType != "string" && asType != "number" {\n\t\treturn nil, fmt.Errorf("config: pivot: as must be string or number")\n\t}\n\n\tagg, ok := getString(sm, "agg")\n\tif !ok || agg == "" {\n\t\treturn nil, fmt.Errorf("config: pivot: agg is required")\n\t}\n\tswitch agg {\n\tcase "sum", "min", "max", "avg", "count", "first", "last":\n\tdefault:\n\t\treturn nil, fmt.Errorf("config: pivot: unknown agg %q", agg)\n\t}\n\n\tswitch agg {\n\tcase "sum", "min", "max", "avg":\n\t\tif asType != "number" {\n\t\t\treturn nil, fmt.Errorf("config: pivot: agg %s requires as: number", agg)\n\t\t}\n\tcase "first", "last":\n\t\tif asType != "string" {\n\t\t\treturn nil, fmt.Errorf("config: pivot: agg %s requires as: string", agg)\n\t\t}\n\t}\n\n\tfill := ""\n\tif f, ok := getString(sm, "fill"); ok {\n\t\tfill = f\n\t}\n\n\tsortColumns := "asc"\n\tif sc, ok := getString(sm, "sort_columns"); ok {\n\t\tif sc == "" {\n\t\t\treturn nil, fmt.Errorf("config: pivot: sort_columns must be asc, desc, or ingest")\n\t\t}\n\t\tsortColumns = sc\n\t}\n\tswitch sortColumns {\n\tcase "asc", "desc", "ingest":\n\tdefault:\n\t\treturn nil, fmt.Errorf("config: pivot: sort_columns must be asc, desc, or ingest")\n\t}\n\n\tcolumnPrefix := ""\n\tif cp, ok := getString(sm, "column_prefix"); ok {\n\t\tcolumnPrefix = cp\n\t}\n\n\tstrictSchema := false\n\tif b, ok, err := getBool(sm, "strict_schema"); ok {\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf("config: pivot: strict_schema must be a boolean")\n\t\t}\n\t\tstrictSchema = b\n\t}\n\n\tdropEmpty := false\n\tif b, ok, err := getBool(sm, "drop_empty"); ok {\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf("config: pivot: drop_empty must be a boolean")\n\t\t}\n\t\tdropEmpty = b\n\t}\n\n\tonConflict := "error"\n\tif oc, ok := getString(sm, "on_conflict"); ok {\n\t\tif oc == "" {\n\t\t\treturn nil, fmt.Errorf("config: pivot: on_conflict must be error, keep_first, or keep_last")\n\t\t}\n\t\tonConflict = oc\n\t}\n\tswitch onConflict {\n\tcase "error", "keep_first", "keep_last":\n\tdefault:\n\t\treturn nil, fmt.Errorf("config: pivot: on_conflict must be error, ke