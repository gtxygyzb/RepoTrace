ult:\n\\t\\treturn nil, fmt.Errorf("input: unsupported format %q", cfg.Format)\n\\t}\n\'\'\'\n)\ninsert = r\'\'\'\nfunc readSQLite(cfg config.InputConfig, dir string) ([]*record.Record, error) {\n\tpath := config.ResolvePath(dir, cfg.Path)\n\tif _, err := os.Stat(path); err != nil {\n\t\treturn nil, fmt.Errorf("input: %v", err)\n\t}\n\n\tcmd := exec.Command("/usr/bin/sqlite3", "-cmd", ".mode quote", "-cmd", ".headers on", path, cfg.Query)\n\tstdout, err := cmd.StdoutPipe()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf("input: %v", err)\n\t}\n\tvar stderrBuf strings.Builder\n\tcmd.Stderr = &stderrBuf\n\tif err := cmd.Start(); err != nil {\n\t\treturn nil, fmt.Errorf("input: %v", err)\n\t}\n\n\tscanner := bufio.NewScanner(stdout)\n\tscanner.Buffer(make([]byte, 0, 1024*1024), 64*1024*1024)\n\n\tvar header []string\n\trecords := []*record.Record{}\n\trecNum := 0\n\tfor scanner.Scan() {\n\t\tline := scanner.Text()\n\t\tif strings.TrimSpace(line) == "" {\n\t\t\tcontinue\n\t\t}\n\t\tfields, err := parseSQLiteQuoteLine(line)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf("input: %v", err)\n\t\t}\n\t\tif header == nil {\n\t\t\theader = make([]string, len(fields))\n\t\t\tfor i, f := range fields {\n\t\t\t\theader[i] = f\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\trecNum++\n\t\tif len(fields) != len(header) {\n\t\t\treturn nil, fmt.Errorf("input: row %d: expected %d columns got %d", recNum, len(header), len(fields))\n\t\t}\n\t\trec := record.New()\n\t\trec.InputRow = recNum\n\t\tfor i, col := range header {\n\t\t\tval, err := renderSQLiteValue(fields[i])\n\t\t\tif err != nil {\n\t\t\t\treturn nil, fmt.Errorf("input: row %d: %v", recNum, err)\n\t\t\t}\n\t\t\trec.Set(col, val)\n\t\t}\n\t\trecords = append(records, rec)\n\t}\n\n\tif err := scanner.Err(); err != nil {\n\t\treturn nil, fmt.Errorf("input: %v", err)\n\t}\n\tif err := cmd.Wait(); err != nil {\n\t\tmsg := strings.TrimSpace(stderrBuf.String())\n\t\tif msg == "" {\n\t\t\tmsg = err.Error()\n\t\t}\n\t\treturn nil, fmt.Errorf