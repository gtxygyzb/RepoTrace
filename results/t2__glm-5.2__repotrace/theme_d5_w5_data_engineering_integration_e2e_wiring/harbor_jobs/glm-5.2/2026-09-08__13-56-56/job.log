v\n        }\n        partKey := strings.Join(partVals, "\\x00")\n\n        windows := s.windowsFor(tv, partVals, partKey, states, &keyOrder, ensureState, r, rNum, late)\n        for _, w := range windows {\n            k := windowKey{start: w.start, end: w.end, partition: partKey}\n            st := ensureState(k, partVals)\n            st.count++\n            for _, agg := range s.cfg.aggregates {\n                if err := s.applyAggregate(st, agg, r, rNum); err != nil {\n                    return nil, err\n                }\n            }\n        }\n    }\n\'\'\'\nnew=\'\'\'        partVals := make([]string, len(s.cfg.partitionBy))\n        for i, col := range s.cfg.partitionBy {\n            v, _ := r.Get(col)\n            partVals[i] = v\n        }\n        partKey := strings.Join(partVals, "\\x00")\n\n        if s.cfg.windowType == "session" {\n            if err := s.applySessionRecord(tv, partVals, partKey, r, rNum, late, states, partValsMap, &keyOrder, &maxSeen); err != nil {\n                return nil, err\n            }\n            continue\n        }\n\n        windows := s.windowsFor(tv, partVals, partKey, states, &keyOrder, ensureState, r, rNum, late)\n        for _, w := range windows {\n            k := windowKey{start: w.start, end: w.end, partition: partKey}\n            st := ensureState(k, partVals)\n            st.count++\n            for _, agg := range s.cfg.aggregates {\n                if err := s.applyAggregate(st, agg, r, rNum); err != nil {\n                    return nil, err\n                }\n            }\n        }\n    }\n\'\'\'\nif old in s:\n    s=s.replace(old,new)\nelse:\n    print(\'apply loop not found\')\n\n# Insert close open sessions and empty window synthesis before keys sort\nold_keys=\'\'\'    keys := make([]windowKey, 0, len(states))\n    for k := range states {\n        keys = append(keys, k)\n    }\n\'\'\'\nnew_keys=\'\'\'    if s.cfg.windowType == "session" {\n        for partKey, ss := range s.openSessions {\n            s.closeSession(ss, partKey, states, partValsMap, &keyOrder)\n        }\n    }\n    if s.cfg.emitEmptyWindows && (s.cfg.windowType == "tumble" || s.cfg.windowType == "slide") {\n        s.synthesizeEmptyWindows(states, partValsMap, &keyOrder)\n    }\n\n    keys := make([]windowKey, 0, len(states))\n    for k := range states {\n        keys = append(keys, k)\n    }\n\'\'\'\nif old_keys in s:\n    s=s.replace(old_keys,new_keys)\nelse:\n    print(\'keys sort not found\')\n\n# Add new methods before parseTime\ninsert=\'\'\'func (s *WindowStage) applySessionRecord(tv float64, partVals []string, partKey string, r *record.Record, rNum int, late bool, states map[windowKey]*windowAggState, partValsMap map[windowKey][]string, keyOrder *[]windowKey, maxSeen *float64) error {\n    if !late {\n        if tv > *maxSeen {\n            *maxSeen = tv\n        }\n    }\n    if late {\n        ss := &sessionState{start: tv, lastEvent: tv, st: &windowAggState{distinct: map[string]struct{}{}}, partVals: partVals}\n        ss.st.count++\n        for _, agg := range s.cfg.aggregates {\n            if err := s.applyAggregate(ss.st, agg, r, rNum); err != nil {\n                return err\n            }\n        }\n        s.closeSession(ss, partKey, states, partValsMap, keyOrder)\n        return nil\n    }\n\n    ss, ok := s.openSessions[partKey]\n    if !ok {\n        ss = &sessionState{start: tv, lastEvent: tv, st: &windowAggState{distinct: map[string]struct{}{}}, partVals: partVals}\n        s.openSessions[partKey] = ss\n    } else if tv-ss.lastEvent > s.cfg.sessionGap {\n        s.closeSession(ss, partKey, states, partValsMap, keyOrder)\n        ss = &sessionState{start: tv, lastEvent: tv, st: &windowAggState{distinct: map[string]struct{}{}}, partVals: partVals}\n        s.openSessions[partKey] = ss\n    } else if s.cfg.sessionHasMax && tv-ss.start >= s.cfg.sessionMaxDur {\n        ss.forced = true\n        ss.forcedEnd = ss.start + s.cfg.sessionMaxDur\n        s.closeSession(ss, partKey, states, partValsMap, keyOrder)\n        ss = &sessionState{start: tv, lastEvent: tv, st: &windowAggState{distinct: map[string]struct{}{}}, partVals: partVals}\n        s.openSessions[partKey] = ss\n    } else {\n        if tv > ss.lastEvent {\n            ss.lastEvent = tv\n        }\n    }\n\n    ss.st.count++\n    for _, agg := range s.cfg.aggregates {\n        if err := s.applyAggregate(ss.st, agg, r, rNum); err != nil {\n            return err\n        }\n    }\n    return nil\n}\n\nfunc (s *WindowStage) closeSession(ss *sessionState, partKey string, states map[windowKey]*windowAggState, partValsMap map[windowKey][]string, keyOrder *[]windowKey) {\n    end := ss.lastEvent\n    if ss.forced {\n        end = ss.forcedEnd\n    }\n    k := windowKey{start: ss.start, end: end, partition: partKey}\n    states[k] = ss.st\n    if _, ok := partValsMap[k]; !ok {\n        partValsMap[k] = ss.partVals\n    }\n    *keyOrder = append(*keyOrder, k)\n}\n\nfunc (s *WindowStage) synthesizeEmptyWindows(states map[windowKey]*windowAggState, partValsMap map[windowKey][]string, keyOrder *[]windowKey) {\n    partKeys := map[string]bool{}\n    for k := range states {\n        partKeys[k.partition] = true\n    }\n    for partKey := range partKeys {\n        var keys []windowKey\n        for k := range states {\n            if k.partition == partKey {\n                keys = append(keys, k)\n            }\n        }\n        if len(keys) < 2 {\n            continue\n        }\n        minStart := keys[0].start\n        maxStart := keys[0].start\n        var partVals []string\n        for _, k := range keys {\n            if k.start < minStart {\n                minStart = k.start\n            }\n            if k.start > maxStart {\n                maxStart = k.start\n            }\n            if pv, ok := partValsMap[k]; ok && len(pv) > 0 {\n                partVals = pv\n            }\n        }\n        if partVals == nil {\n            partVals = []string{}\n        }\n        switch s.cfg.windowType {\n        case "tumble":\n            size := s.cfg.tumbleSize\n            for start := minStart + size; start < maxStart; start += size {\n                k := windowKey{start: start, end: start + size, partition: partKey}\n                if _, ok := states[k]; !ok {\n                    states[k] = &windowAggState{distinct: map[string]struct{}{}}\n                    partValsMap[k] = partVals\n                    *keyOrder = append(*keyOrder, k)\n                }\n            }\n        case "slide":\n            size := s.cfg.slideSize\n                       step := s.cfg.slideStep\n            for start := minStart + step; start < maxStart; start += step {\n                k := windowKey{start: start, end: start + size, partition: partKey}\n                if _, ok := states[k]; !ok {\n                    states[k] = &windowAggState{distinct: map[string]struct{}{}}\n                    partValsMap[k] = partVals\n                    *keyOrder = append(*keyOrder, k)\n                }\n            }\n        }\n    }\n}\n\n\'\'\'\ns=s.replace(\'func (s *WindowStage) parseTime(v string) (float64, error) {\', insert + \'func (s *WindowStage) parseTime(v string) (float64, error) {\')\n\np.write_text(s)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
