Sending keys: ['cat > internal/stage/join.go <<\'GO\'\npackage stage\n\nimport (\n    "fmt"\n    "io"\n    "strings"\n\n    "example.com/flowctl/internal/config"\n    "example.com/flowctl/internal/input"\n    "example.com/flowctl/internal/record"\n)\n\ntype JoinStage struct {\n    idx           int\n    dir           string\n    kind          string\n    on            []string\n    rightInput    config.InputConfig\n    selectCols    []string\n    selectPresent bool\n    prefix        string\n}\n\nfunc buildJoin(idx int, sm map[string]interface{}, dir string) (Stage, error) {\n    kind, ok := getString(sm, "kind")\n    if !ok || kind == "" {\n        return nil, fmt.Errorf("config: stage %d: join.kind is required", idx)\n    }\n    if kind != "inner" && kind != "left" {\n        return nil, fmt.Errorf("config: stage %d: join.kind must be inner or left", idx)\n    }\n\n    onRaw, ok := sm["on"]\n    if !ok {\n        return nil, fmt.Errorf("config: stage %d: join.on is required", idx)\n    }\n    on, err := toStringList(onRaw)\n    if err != nil {\n        return nil, fmt.Errorf("config: stage %d: join.on %v", idx, err)\n    }\n    if len(on) == 0 {\n        return nil, fmt.Errorf("config: stage %d: join.on must be non-empty", idx)\n    }\n\n    rightRaw, ok := sm["right"]\n    if !ok {\n        return nil, fmt.Errorf("config: stage %d: join.right is required", idx)\n    }\n    right, ok := rightRaw.(map[string]interface{})\n    if !ok {\n        return nil, fmt.Errorf("config: stage %d: join.right must be a mapping", idx)\n    }\n\n    inRaw, ok := right["input"]\n    if !ok {\n        return nil, fmt.Errorf("config: stage %d: join.right.input is required", idx)\n    }\n    inMap, ok := inRaw.(map[string]interface{})\n    if !ok {\n        return nil, fmt.Errorf("config: stage %d: join.right.input must be a mapping", idx)\n    }\n    ric, err := parseJoinInputConfig(idx, inMap)\n    if err != nil {\n        return nil, err\n    }\n\n    selectCols := []string{}\n    selectPresent := false\n    if selRaw, ok := right["select"]; ok {\n        selectPresent = true\n        selectCols, err = toStringList(selRaw)\n        if err != nil {\n            return nil, fmt.Errorf("config: stage %d: join.right.select %v", idx, err)\n        }\n    }\n\n    prefix, _ := getString(right, "prefix")\n\n    return &JoinStage{\n        idx:           idx,\n        dir:           dir,\n        kind:          kind,\n        on:            on,\n        rightInput:    ric,\n        selectCols:    selectCols,\n        selectPresent: selectPresent,\n        prefix:        prefix,\n    }, nil\n}\n\nfunc parseJoinInputConfig(idx int, m map[string]interface{}) (config.InputConfig, error) {\n    ic := config.InputConfig{}\n\n    p, ok := getString(m, "path")\n    if !ok || p == "" {\n        return ic, fmt.Errorf("config: stage %d: join.right.input.path is required", idx)\n    }\n    ic.Path = p\n\n    f, ok := getString(m, "format")\n    if !ok || f == "" {\n        return ic, fmt.Errorf("config: stage %d: join.right.input.format is required", idx)\n    }\n    ic.Format = f\n    if ic.Format != "csv" && ic.Format != "ndjson" && ic.Format != "sqlite" {\n        return ic, fmt.Errorf("config: stage %d: join.right.input.format must be csv, ndjson, or sqlite", idx)\n    }\n\n    if ic.Format == "sqlite" {\n        q, ok := getString(m, "query")\n        if !ok || q == "" {\n            return ic, fmt.Errorf("config: stage %d: join.right.input.query is required", idx)\n        }\n        ic.Query = q\n    }\n\n    return ic, nil\n}\n\nfunc (s *JoinStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\n    rightRecords, err := input.Read(s.rightInput, s.dir)\n    if err != nil {\n        return nil, err\n    }\n\n    schema, err := s.resolveRightSchema(rightRecords)\n    if err != nil {\n        return nil, err\n    }\n\n    if len(rightRecords) > 0 {\n        for _, col := range s.on {\n            if !schemaContains(schema, col) {\n                return nil, fmt.Errorf("join: missing on column %s in right record", col)\n            }\n        }\n    }\n\n    leftColumns := map[string]bool{}\n    for _, r := range in {\n        for _, k := range r.Order {\n            leftColumns[k] = true\n        }\n    }\n    for _, col := range schema {\n        if s.isOn(col) {\n            continue\n        }\n        name := s.prefix + col\n        if leftColumns[name] {\n            return nil, fmt.Errorf("config: join: column name collision: %s", name)\n        }\n    }\n\n    index := map[string][]map[string]string{}\n    for _, rr := range rightRecords {\n        vals, err := s.projectRight(rr, schema)\n        if err != nil {\n            return nil, err\n        }\n\n        skip := false\n        for _, col := range s.on {\n            if vals[col] == "" {\n                skip = true\n                break\n            }\n        }\n        if skip {\n            continue\n        }\n\n        key := joinKey(s.on, vals)\n        index[key] = append(index[key], vals)\n    }\n\n    out := make([]*record.Record, 0, len(in))\n    for _, r := range in {\n        for _, col := range s.on {\n            if !r.Has(col) {\n                return nil, fmt.Errorf("join: missing on column %s in left record", col)\n            }\n        }\n\n        leftVals := map[string]string{}\n        empty := false\n        for _, col := range s.on {\n            v, _ := r.Get(col)\n            leftVals[col] = v\n            if v == "" {\n                empty = true\n            }\n        }\n\n        var matches []map[string]string\n        if !empty {\n            matches = index[joinKey(s.on, leftVals)]\n        }\n\n        if len(matches) == 0 {\n            if s.kind == "left" {\n                nr := r.Copy()\n                s.addRightColumns(nr, nil, schema)\n                out = append(out, nr)\n            }\n            continue\n        }\n\n        for _, m := range matches {\n            nr := r.Copy()\n            s.addRightColumns(nr, m, schema)\n            out = append(out, nr)\n        }\n    }\n\n    return out, nil\n}\n\nfunc (s *JoinStage) resolveRightSchema(rightRecords []*record.Record) ([]string, error) {\n    if s.selectPresent {\n        return s.selectCols, nil\n    }\n    if len(rightRecords) == 0 {\n        return []string{}, nil\n    }\n    return rightRecords[0].Order, nil\n}\n\nfunc (s *JoinStage) projectRight(rr *record.Record, schema []string) (map[string]string, error) {\n    vals := make(map[string]string, len(schema))\n    for _, col := range schema {\n        v, ok := rr.Get(col)\n        if !ok {\n            if s.isOn(col) {\n                return nil, fmt.Errorf("join: missing on column %s in right record", col)\n            }\n            v = ""\n        }\n        vals[col] = v\n    }\n    return vals, nil\n}\n\nfunc (s *JoinStage) addRightColumns(nr *record.Record, vals map[string]string, schema []string) {\n    for _, col := range schema {\n        if s.isOn(col) {\n            continue\n        }\n        v := ""\n        if vals != nil {\n            v = vals[col]\n        }\n        nr.Set(s.prefix+col, v)\n    }\n}\n\nfunc (s *JoinStage) isOn(col string) bool {\n    for _, c := range s.on {\n        if c == col {\n            return true\n        }\n    }\n    return false\n}\n\nfunc schemaContains(schema []string, col string) bool {\n    for _, c := range schema {\n        if c == col {\n            return true\n        }\n    }\n    return false\n}\n\nfunc joinKey(on []string, vals map[string]string) string {\n    parts := make([]string, 0, len(on)*2)\n    for _, k := range on {\n        parts = append(parts, k, vals[k])\n    }\n    return strings.Join(parts, "\\x00")\n}\nGO\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
