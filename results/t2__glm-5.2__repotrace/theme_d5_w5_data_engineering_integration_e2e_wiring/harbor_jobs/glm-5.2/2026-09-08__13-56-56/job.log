t: csv\nstages:\n  - type: bucket\n    column: amount\n    into: tier\n    edges: [0, 10, 100, 1000]\n    labels: [small, medium, large]\n    inclusive: right\n    under_label: below\n    over_label: above\noutput:\n  path: out.jsonl\n  format: jsonl\n""", bucket_edges_csv, 0, \'{"id":"1","amount":"5","tier":"small"}\\n{"id":"2","amount":"42","tier":"medium"}\\n{"id":"3","amount":"700","tier":"large"}\\n{"id":"4","amount":"9999","tier":"above"}\\n{"id":"5","amount":"","tier":""}\\n\', "flowctl: processed=5 emitted=5 dropped_nonnumeric=0 dropped_missing=0")\n\nbucket_width_csv = "id,score\\n1,5\\n2,15\\n3,25\\n4,35\\n"\ncheck("bucket width example", """input:\n  path: in.csv\n  format: csv\nstages:\n  - type: bucket\n    column: score\n    into: band\n    width:\n      step: 10\n      start: 0\n      count: 4\n    inclusive: left\noutput:\n  path: out.jsonl\n  format: jsonl\n""", bucket_width_csv, 0, \'{"id":"1","score":"5","band":"[0, 10)"}\\n{"id":"2","score":"15","band":"[10, 20)"}\\n{"id":"3","score":"25","band":"[20, 30)"}\\n{"id":"4","score":"35","band":"[30, 40)"}\\n\', "flowctl: processed=4 emitted=4 dropped_nonnumeric=0 dropped_missing=0")\n\nauto_csv = "id,v\\n1,-5\\n2,0\\n3,5\\n4,10\\n5,15\\n6,20\\n7,25\\n"\ncheck("bucket auto right boundaries", """input:\n  path: in.csv\n  format: csv\nstages:\n  - type: bucket\n    column: v\n    into: b\n    edges: [0, 10, 20]\noutput:\n  path: out.jsonl\n  format: jsonl\n""", auto_csv, 0, \'{"id":"1","v":"-5","b":"(-inf, 0]"}\\n{"id":"2","v":"0","b":"(-inf, 0]"}\\n{"id":"3","v":"5","b":"(0, 10]"}\\n{"id":"4","v":"10","b":"(0, 10]"}\\n{"id":"5","v":"15","b":"(10, 20]"}\\n{"id":"6","v":"20","b":"(10, 20]"}\\n{"id":"7","v":"25","b":"(20, +inf)"}\\n\')\n\ncheck("bucket auto left boundaries", """input:\n  path: in.csv\n  format: csv\nstages:\n  - type: bucket\n    column: v\n    into: b\n    edges: [0, 10, 20]\n    inclusive: left\noutput:\n  path: out.jsonl\n  format: jsonl\n""", auto_csv, 0, \'{"id":"1","v":"-5","b":"(-in