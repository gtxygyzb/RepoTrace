Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\ncode = r\'\'\'package stage\n\nimport (\n    "fmt"\n    "io"\n    "math"\n    "sort"\n    "strconv"\n    "strings"\n    "time"\n\n    "example.com/flowctl/internal/record"\n)\n\ntype windowAggConfig struct {\n    op     string\n    column string\n    into   string\n}\n\ntype windowConfig struct {\n    timeColumn         string\n    timeFormat         string\n    emitTimeFormat     string\n    windowType         string\n    tumbleSize         float64\n    tumbleOrigin       float64\n    slideSize          float64\n    slideStep          float64\n    slideOrigin        float64\n    sessionGap         float64\n    sessionMaxDur      float64\n    sessionHasMax      bool\n    partitionBy        []string\n    aggregates         []windowAggConfig\n    windowStartInto    string\n    windowEndInto      string\n    emitEmptyWindows   bool\n    onLate             string\n    onMissingTime      string\n    onNonParseable      string\n    emitSchema         string\n    metricNameInto     string\n    metricValueInto    string\n    emitMode           string\n    outOrder           string\n    allowedLatenessVal  float64\n}\n\ntype WindowStage struct {\n    cfg windowConfig\n}\n\ntype windowKey struct {\n    start     float64\n    end       float64\n    partition string\n}\n\ntype windowAggState struct {\n    count    int\n    sum      float64\n    numVals  []float64\n    distinct map[string]struct{}\n    first    string\n    last     string\n    hasFirst bool\n}\n\ntype windowRange struct {\n    start float64\n    end   float64\n}\n\nfunc (s *WindowStage) Apply(in []*record.Record, stderr io.Writer, strict bool, stats *Stats) ([]*record.Record, error) {\n    states := map[windowKey]*windowAggState{}\n    partValsMap := map[windowKey][]string{}\n    var keyOrder []windowKey\n\n    maxSeen := math.Inf(-1)\n\n    ensureState := func(k windowKey, partVals []string) *windowAggState {\n        if st, ok := states[k]; ok {\n            return st\n        }\n        st := &windowAggState{distinct: map[string]struct{}{}}\n        states[k] = st\n        keyOrder = append(keyOrder, k)\n        if _, ok := partValsMap[k]; !ok {\n            partValsMap[k] = partVals\n        }\n        return st\n    }\n\n    for rowIdx, r := range in {\n        rNum := rowIdx + 1\n        tvStr, hasTime := r.Get(s.cfg.timeColumn)\n        if !hasTime || tvStr == "" {\n            switch s.cfg.onMissingTime {\n            case "drop":\n                stats.DroppedMissing++\n                fmt.Fprintf(stderr, "flowctl: window: drop missing-time row %d\\n", rNum)\n                if strict {\n                    return nil, fmt.Errorf("strict: missing column %s", s.cfg.timeColumn)\n                }\n                continue\n            default:\n                return nil, fmt.Errorf("flowctl: window: missing column %s at row %d", s.cfg.timeColumn, rNum)\n            }\n        }\n\n        tv, err := s.parseTime(tvStr)\n        if err != nil {\n            switch s.cfg.onNonParseable {\n            case "drop":\n                stats.DroppedNonNumeric++\n                fmt.Fprintf(stderr, "flowctl: window: drop non-parseable-time row %d\\n", rNum)\n                if strict {\n                    return nil, fmt.Errorf("strict: non-parseable-time row %d", rNum)\n                }\n                continue\n            default:\n                return nil, fmt.Errorf("flowctl: window: non-parseable time value in column %s at row %d", s.cfg.timeColumn, rNum)\n            }\n        }\n\n        late := tv < maxSeen-s.cfg.allowedLatenessVal\n        if late {\n            switch s.cfg.onLate {\n            case "drop":\n                stats.DroppedLate++\n                fmt.Fprintf(stderr, "flowctl: window: drop late row %d\\n", rNum)\n                if strict {\n                    return nil, fmt.Errorf("strict: late row %d", rNum)\n                }\n                continue\n            case "error":\n                return nil, fmt.Errorf("flowctl: window: late row %d beyond allowed_lateness", rNum)\n            default:\n                // include\n            }\n        } else {\n            if tv > maxSeen {\n                maxSeen = tv\n            }\n        }\n\n        partVals := make([]string, len(s.cfg.partitionBy))\n        for i, col := range s.cfg.partitionBy {\n            v, _ := r.Get(col)\n            partVals[i] = v\n        }\n        partKey := strings.Join(partVals, "\\x00")\n\n        windows := s.windowsFor(tv, partVals, partKey, states, &keyOrder, ensureState, r, rNum, late)\n        for _, w := range windows {\n            k := windowKey{start: w.start, end: w.end, partition: partKey}\n            st := ensureState(k, partVals)\n            st.count++\n            for _, agg := range s.cfg.aggregates {\n                if err := s.applyAggregate(st, agg, r, rNum); err != nil {\n                    return nil, err\n                }\n            }\n        }\n    }\n\n    keys := make([]windowKey, 0, len(states))\n    for k := range states {\n        keys = append(keys, k)\n    }\n    sort.Slice(keys, func(i, j int) bool {\n        if keys[i].start != keys[j].start {\n            return keys[i].start < keys[j].start\n        }\n        if keys[i].end != keys[j].end {\n            return keys[i].end < keys[j].end\n        }\n        return keys[i].partition < keys[j].partition\n    })\n\n    out := make([]*record.Record, 0, len(keys)*len(s.cfg.aggregates))\n    if s.cfg.emitSchema == "long" {\n        if s.cfg.outOrder == "aggregate-first" {\n            for _, agg := range s.cfg.aggregates {\n                for _, k := range keys {\n                    st := states[k]\n                    val := s.renderOne(st, agg)\n                    out = append(out, s.buildLongRecord(k, partValsMap[k], agg.into, val))\n                }\n            }\n        } else {\n            for _, k := range keys {\n                st := states[k]\n                for _, agg := range s.cfg.aggregates {\n                    val := s.renderOne(st, agg)\n                    out = append(out, s.buildLongRecord(k, partValsMap[k], agg.into, val))\n                }\n            }\n        }\n    } else {\n        for _, k := range keys {\n            st := states[k]\n            nr := record.New()\n            for j, col := range s.cfg.partitionBy {\n                nr.Set(col, partValsMap[k][j])\n            }\n            nr.Set(s.cfg.windowStartInto, s.renderTime(k.start))\n            nr.Set(s.cfg.windowEndInto, s.renderTime(k.end))\n            for _, agg := range s.cfg.aggregates {\n                nr.Set(agg.into, s.renderOne(st, agg))\n            }\n            out = append(out, nr)\n        }\n    }\n\n    return out, nil\n}\n\nfunc (s *WindowStage) buildLongRecord(k windowKey, partVals []string, name, val string) *record.Record {\n    nr := record.New()\n    for j, col := range s.cfg.partitionBy {\n        nr.Set(col, partVals[j])\n    }\n    nr.Set(s.cfg.windowStartInto, s.renderTime(k.start))\n    nr.Set(s.cfg.windowEndInto, s.renderTime(k.end))\n    nr.Set(s.cfg.metricNameInto, name)\n    nr.Set(s.cfg.metricValueInto, val)\n    return nr\n}\n\nfunc (s *WindowStage) windowsFor(t float64, partVals []string, partKey string, states map[windowKey]*windowAggState, keyOrder *[]windowKey, ensureState func(windowKey, []string) *windowAggState, r *record.Record, rNum int, late bool) []windowRange {\n    switch s.cfg.windowType {\n    case "tumble":\n        size := s.cfg.tumbleSize\n        origin := s.cfg.tumbleOrigin\n        k := math.Floor((t - origin) / size)\n        start := origin + k*size\n        return []windowRange{{start: start, end: start + size}}\n    case "slide":\n        size := s.cfg.slideSize\n        step := s.cfg.slideStep\n        origin := s.cfg.slideOrigin\n        if t < origin {\n            return nil\n        }\n        k := math.Floor((t - origin) / step)\n        if k < 0 {\n            k = 0\n        }\n        var out []windowRange\n        for kk := k; ; kk-- {\n            start := origin + kk*step\n            if start < origin || start+size <= t {\n                break\n            }\n            if start <= t && t < start+size {\n                out = append(out, windowRange{start: start, end: start + size})\n            }\n        }\n        sort.Slice(out, func(i, j int) bool { return out[i].start < out[j].start })\n        return out\n    case "session":\n        return s.sessionWindows(t, partVals, partKey, states, keyOrder, ensureState, r, rNum, late)\n    }\n    return nil\n}\n\nfunc (s *WindowStage) sessionWindows(t float64, partVals []string, partKey string, states map[windowKey]*windowAggState, keyOrder *[]windowKey, ensureState func(windowKey, []string) *windowAggState, r *record.Record, rNum int, late bool) []windowRange {\n    // Simplified batched session handling for now.\n    return []windowRange{{start: t, end: t}}\n}\n\nfunc (s *WindowStage) parseTime(v string) (float64, error) {\n    switch s.cfg.timeFormat {\n    case "unix_seconds", "unix_millis":\n        f, err := strconv.ParseFloat(v, 64)\n        if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {\n            return 0, fmt.Errorf("parse time")\n        }\n        return f, nil\n    case "rfc3339":\n        t, err := time.Parse(time.RFC3339Nano, v)\n        if err != nil {\n            return 0, err\n        }\n        return float64(t.UnixNano()) / 1e9, nil\n    }\n    return 0, fmt.Errorf("parse time")\n}\n\nfunc (s *WindowStage) renderTime(t float64) string {\n    switch s.cfg.emitTimeFormat {\n    case "unix_seconds":\n        if t == math.Trunc(t) {\n            return strconv.FormatFloat(t, \'f\', 0, 64)\n        }\n        return strconv.FormatFloat(t, \'g\', -1, 64)\n    case "unix_millis":\n        ms := math.Floor(t)\n        if ms == math.Trunc(ms) {\n            return strconv.FormatFloat(ms, \'f\', 0, 64)\n        }\n        return strconv.FormatFloat(ms, \'g\', -1, 64)\n    case "rfc3339":\n        ns := int64(t * 1e9)\n        return time.Unix(0, ns).UTC().Format(time.RFC3339Nano)\n    }\n    return strconv.FormatFloat(t, \'f\', 0, 64)\n}\n\nfunc (s *WindowStage) applyAggregate(st *windowAggState, agg windowAggConfig, r *record.Record, rNum int) error {\n    switch agg.op {\n    case "count":\n        return nil\n    case "sum", "avg", "min", "max", "p50", "p95", "stddev":\n        v, ok := r.Get(agg.column)\n        if !ok || v == "" {\n            return nil\n        }\n        f, err := parseFloat(v)\n        if err != nil {\n            return fmt.Errorf("flowctl: window: non-numeric value in aggregate column %s at row %d", agg.column, rNum)\n        }\n        st.numVals = append(st.numVals, f)\n        if agg.op == "sum" {\n            st.sum += f\n        }\n    case "first", "last", "distinct":\n        v, ok := r.Get(agg.column)\n        if !ok || v == "" {\n            return nil\n        }\n        if agg.op == "first" && !st.hasFirst {\n            st.first = v\n            st.hasFirst = true\n        }\n        if agg.op == "last" {\n            st.last = v\n        }\n        if agg.op == "distinct" {\n            st.distinct[v] = struct{}{}\n        }\n    }\n    return nil\n}\n\nfunc (s *WindowStage) renderOne(st *windowAggState, agg windowAggConfig) string {\n    switch agg.op {\n    case "count":\n        return strconv.Itoa(st.count)\n    case "sum":\n        return formatFloat(st.sum)\n    case "avg":\n        if len(st.numVals) == 0 {\n            return ""\n        }\n        return formatFloat(st.sum / float64(len(st.numVals)))\n    case "min":\n        if len(st.numVals) == 0 {\n            return ""\n        }\n        m := st.numVals[0]\n        for _, v := range st.numVals[1:] {\n            if v < m {\n                m = v\n            }\n        }\n        return formatFloat(m)\n    case "max":\n        if len(st.numVals) == 0 {\n            return ""\n        }\n        m := st.numVals[0]\n        for _, v := range st.numVals[1:] {\n            if v > m {\n                m = v\n            }\n        }\n        return formatFloat(m)\n    case "first":\n        return st.first\n    case "last":\n        return st.last\n    case "p50":\n        return percentile(st.numVals, 0.5)\n    case "p95":\n        return percentile(st.numVals, 0.95)\n    case "stddev":\n        if len(st.numVals) <= 1 {\n            return ""\n        }\n        mean := 0.0\n        for _, v := range st.numVals {\n            mean += v\n        }\n        mean /= float64(len(st.numVals))\n        varSum := 0.0\n        for _, v := range st.numVals {\n            d := v - mean\n            varSum += d * d\n        }\n        return strconv.FormatFloat(math.Sqrt(varSum/float64(len(st.numVals)-1)), \'g\', 6, 64)\n    case "distinct":\n        return strconv.Itoa(len(st.distinct))\n    }\n    return ""\n}\n\nfunc percentile(vals []float64, p float64) string {\n    if len(vals) == 0 {\n        return ""\n    }\n    sorted := make([]float64, len(vals))\n    copy(sorted, vals)\n    sort.Float64s(sorted)\n    if len(sorted) == 1 {\n        return formatFloat(sorted[0])\n    }\n    idx := float64(len(sorted)-1) * p\n    lo := math.Floor(idx)\n    hi := math.Ceil(idx)\n    frac := idx - lo\n    res := sorted[int(lo)] + frac*(sorted[int(hi)]-sorted[int(lo)])\n    return formatFloat(res)\n}\n\nfunc buildWindow(idx int, sm map[string]interface{}) (Stage, error) {\n    cfg := windowConfig{}\n\n    tc, ok := getString(sm, "time_column")\n    if !ok || tc == "" {\n        return nil, fmt.Errorf("config: window: time_column must be a non-empty string")\n    }\n    cfg.timeColumn = tc\n\n    tf, ok := getString(sm, "time_format")\n    if !ok || tf == "" {\n        return nil, fmt.Errorf("config: window: time_format must be unix_seconds, unix_millis, or rfc3339")\n    }\n    if tf != "unix_seconds" && tf != "unix_millis" && tf != "rfc3339" {\n        return nil, fmt.Errorf("config: window: time_format must be unix_seconds, unix_millis, or rfc3339")\n    }\n    cfg.timeFormat = tf\n    cfg.emitTimeFormat = tf\n    if etf, ok := getString(sm, "emit_time_format"); ok {\n        if etf != "unix_seconds" && etf != "unix_millis" && etf != "rfc3339" {\n            return nil, fmt.Errorf("config: window: emit_time_format must be unix_seconds, unix_millis, or rfc3339")\n        }\n        cfg.emitTimeFormat = etf\n    }\n\n    windowRaw, ok := sm["window"]\n    if !ok {\n        return nil, fmt.Errorf("config: window: exactly one of window.tumble, window.slide, or window.session is required")\n    }\n    windowMap, ok := windowRaw.(map[string]interface{})\n    if !ok {\n        return nil, fmt.Errorf("config: window: exactly one of window.tumble, window.slide, or window.session is required")\n    }\n    hasTumble, hasSlide, hasSession := windowMap["tumble"] != nil, windowMap["slide"] != nil, windowMap["session"] != nil\n    cnt := 0\n    if hasTumble {\n        cnt++\n    }\n    if hasSlide {\n        cnt++\n    }\n    if hasSession {\n        cnt++\n    }\n    if cnt != 1 {\n        return nil, fmt.Errorf("config: window: exactly one of window.tumble, window.slide, or window.session is required")\n    }\n\n    if hasTumble {\n        cfg.windowType = "tumble"\n        tm, ok := windowMap["tumble"].(map[string]interface{})\n        if !ok {\n            return nil, fmt.Errorf("config: window: tumble must be a mapping")\n        }\n        sz, err := getWindowNumber(tm, "size")\n        if err != nil || sz <= 0 || math.IsNaN(sz) || math.IsInf(sz, 0) {\n            return nil, fmt.Errorf("config: window: tumble.size must be a positive finite number")\n        }\n        cfg.tumbleSize = sz\n        cfg.tumbleOrigin = 0\n        if origin, ok := tm["origin"]; ok {\n            o, err := parseWindowNumber(origin)\n            if err != nil || math.IsNaN(o) || math.IsInf(o, 0) {\n                return nil, fmt.Errorf("config: window: tumble.origin must be a finite number")\n            }\n            cfg.tumbleOrigin = o\n        }\n    }\n    if hasSlide {\n        cfg.windowType = "slide"\n        tm, ok := windowMap["slide"].(map[string]interface{})\n        if !ok {\n            return nil, fmt.Errorf("config: window: slide must be a mapping")\n        }\n        sz, err := getWindowNumber(tm, "size")\n        if err != nil || sz <= 0 || math.IsNaN(sz) || math.IsInf(sz, 0) {\n            return nil, fmt.Errorf("config: window: slide.size must be a positive finite number")\n        }\n        cfg.slideSize = sz\n        step, err := getWindowNumber(tm, "step")\n        if err != nil || step <= 0 || math.IsNaN(step) || math.IsInf(step, 0) {\n            return nil, fmt.Errorf("config: window: slide.step must be a positive finite number")\n        }\n        if step > sz {\n            return nil, fmt.Errorf("config: window: slide.step must be <= slide.size")\n        }\n        cfg.slideStep = step\n        cfg.slideOrigin = 0\n        if origin, ok := tm["origin"]; ok {\n            o, err := parseWindowNumber(origin)\n            if err != nil || math.IsNaN(o) || math.IsInf(o, 0) {\n                return nil, fmt.Errorf("config: window: slide.origin must be a finite number")\n            }\n            cfg.slideOrigin = o\n        }\n    }\n    if hasSession {\n        cfg.windowType = "session"\n        tm, ok := windowMap["session"].(map[string]interface{})\n        if !ok {\n            return nil, fmt.Errorf("config: window: session must be a mapping")\n        }\n        gap, err := getWindowNumber(tm, "gap")\n        if err != nil || gap <= 0 || math.IsNaN(gap) || math.IsInf(gap, 0) {\n            return nil, fmt.Errorf("config: window: session.gap must be a positive finite number")\n        }\n        cfg.sessionGap = gap\n        cfg.sessionHasMax = false\n        if md, ok := tm["max_duration"]; ok {\n            m, err := parseWindowNumber(md)\n            if err != nil || m <= 0 || math.IsNaN(m) || math.IsInf(m, 0) {\n                return nil, fmt.Errorf("config: window: session.max_duration must be a positive finite number")\n            }\n            if m < gap {\n                return nil, fmt.Errorf("config: window: session.max_duration must be >= session.gap")\n            }\n            cfg.sessionMaxDur = m\n            cfg.sessionHasMax = true\n        }\n    }\n\n    cfg.partitionBy = []string{}\n    if raw, ok := sm["partition_by"]; ok {\n        plist, err := toStringList(raw)\n        if err != nil {\n            return nil, fmt.Errorf("config: window: partition_by %v", err)\n        }\n        seen := map[string]bool{}\n        for _, col := range plist {\n            if seen[col] {\n                return nil, fmt.Errorf("config: window: partition_by has duplicate column %s", col)\n            }\n            seen[col] = true\n        }\n        cfg.partitionBy = plist\n    }\n\n    agesRaw, ok := sm["aggregates"]\n    if !ok {\n        return nil, fmt.Errorf("config: window: aggregates must be a non-empty list")\n    }\n    agesList, ok := agesRaw.([]interface{})\n    if !ok || len(agesList) == 0 {\n        return nil, fmt.Errorf("config: window: aggregates must be a non-empty list")\n    }\n    seenInto := map[string]bool{}\n    for i, item := range agesList {\n        am, ok := item.(map[string]interface{})\n        if !ok {\n            return nil, fmt.Errorf("config: window: aggregates[%d] must be a mapping", i)\n        }\n        op, ok := getString(am, "op")\n        if !ok || op == "" {\n            return nil, fmt.Errorf("config: window: aggregates[%d].op must be one of sum, count, avg, min, max, first, last, p50, p95, stddev, distinct", i)\n        }\n        validOps := map[string]bool{"sum": true, "count": true, "avg": true, "min": true, "max": true, "first": true, "last": true, "p50": true, "p95": true, "stddev": true, "distinct": true}\n        if !validOps[op] {\n            return nil, fmt.Errorf("config: window: aggregates[%d].op must be one of sum, count, avg, min, max, first, last, p50, p95, stddev, distinct", i)\n        }\n        col, hasCol := getString(am, "column")\n        if op == "count" {\n            if hasCol && col != "" {\n                return nil, fmt.Errorf("config: window: aggregates[%d] count does not accept column", i)\n            }\n        } else {\n            if !hasCol || col == "" {\n                return nil, fmt.Errorf("config: window: aggregates[%d] op %s requires column", i, op)\n            }\n        }\n        into, ok := getString(am, "into")\n        if !ok || into == "" {\n            return nil, fmt.Errorf("config: window: aggregates[%d].into must be a non-empty string", i)\n        }\n        if seenInto[into] {\n            return nil, fmt.Errorf("config: window: aggregates has duplicate into %s", into)\n        }\n        if into == cfg.windowStartInto || into == cfg.windowEndInto {\n            return nil, fmt.Errorf("config: window: aggregates[%d].into %s collides with window column", i, into)\n        }\n        for _, pcol := range cfg.partitionBy {\n            if into == pcol {\n                return nil, fmt.Errorf("config: window: aggregates[%d].into %s collides with partition_by column %s", i, into, pcol)\n            }\n        }\n        seenInto[into] = true\n        cfg.aggregates = append(cfg.aggregates, windowAggConfig{op: op, column: col, into: into})\n    }\n\n    wsi, ok := getString(sm, "window_start_into")\n    if !ok || wsi == "" {\n        return nil, fmt.Errorf("config: window: window_start_into must be a non-empty string")\n    }\n    wei, ok := getString(sm, "window_end_into")\n    if !ok || wei == "" {\n        return nil, fmt.Errorf("config: window: window_end_into must be a non-empty string")\n    }\n    if wsi == wei {\n        return nil, fmt.Errorf("config: window: window_start_into collides with window_end_into")\n    }\n    for _, into := range aggregateIntos(cfg.aggregates) {\n        if into == wsi {\n            return nil, fmt.Errorf("config: window: window_start_into collides with aggregate into %s", into)\n        }\n        if into == wei {\n            return nil, fmt.Errorf("config: window: window_end_into collides with aggregate into %s", into)\n        }\n    }\n    for _, pcol := range cfg.partitionBy {\n        if wsi == pcol {\n            return nil, fmt.Errorf("config: window: window_start_into collides with partition_by column %s", pcol)\n        }\n        if wei == pcol {\n            return nil, fmt.Errorf("config: window: window_end_into collides with partition_by column %s", pcol)\n        }\n    }\n    cfg.windowStartInto = wsi\n    cfg.windowEndInto = wei\n\n    if raw, ok := sm["allowed_lateness"]; ok {\n        al, err := parseWindowNumber(raw)\n        if err != nil || al < 0 || math.IsNaN(al) || math.IsInf(al, 0) {\n            return nil, fmt.Errorf("config: window: allowed_lateness must be a non-negative finite number")\n        }\n        cfg.allowedLatenessVal = al\n    }\n\n    cfg.onLate = "drop"\n    if v, ok := getString(sm, "on_late"); ok {\n        if v != "drop" && v != "include" && v != "error" {\n            return nil, fmt.Errorf("config: window: on_late must be drop, include, or error")\n        }\n        cfg.onLate = v\n    }\n    cfg.onMissingTime = "error"\n    if v, ok := getString(sm, "on_missing_time"); ok {\n        if v != "drop" && v != "error" {\n            return nil, fmt.Errorf("config: window: on_missing_time must be drop or error")\n        }\n        cfg.onMissingTime = v\n    }\n    cfg.onNonParseable = "error"\n    if v, ok := getString(sm, "on_non_parseable_time"); ok {\n        if v != "drop" && v != "error" {\n            return nil, fmt.Errorf("config: window: on_non_parseable_time must be drop or error")\n        }\n        cfg.onNonParseable = v\n    }\n\n    cfg.emitEmptyWindows = false\n    if v, ok, err := getBool(sm, "emit_empty_windows"); ok {\n        if err != nil {\n            return nil, fmt.Errorf("config: window: emit_empty_windows must be a boolean")\n        }\n        cfg.emitEmptyWindows = v\n    }\n\n    cfg.emitSchema = "wide"\n    if v, ok := getString(sm, "emit_schema"); ok {\n        if v != "wide" && v != "long" {\n            return nil, fmt.Errorf("config: window: emit_schema must be wide or long")\n        }\n        cfg.emitSchema = v\n    }\n    cfg.metricNameInto = ""\n    cfg.metricValueInto = ""\n    if cfg.emitSchema == "long" {\n        mn, ok1 := getString(sm, "metric_name_into")\n        mv, ok2 := getString(sm, "metric_value_into")\n        if !ok1 || mn == "" || !ok2 || mv == "" {\n            return nil, fmt.Errorf("config: window: emit_schema long requires metric_name_into and metric_value_into")\n        }\n        if mn == mv {\n            return nil, fmt.Errorf("config: window: metric_name_into collides with metric_value_into")\n        }\n        for _, col := range colsForLongCollision(cfg) {\n            if mn == col {\n                return nil, fmt.Errorf("config: window: metric_name_into collides with %s", col)\n            }\n            if mv == col {\n                return nil, fmt.Errorf("config: window: metric_value_into collides with %s", col)\n            }\n        }\n        cfg.metricNameInto = mn\n        cfg.metricValueInto = mv\n    } else {\n        if _, ok := sm["metric_name_into"]; ok {\n            return nil, fmt.Errorf("config: window: metric_name_into/value_into are only valid when emit_schema is long")\n        }\n        if _, ok := sm["metric_value_into"]; ok {\n            return nil, fmt.Errorf("config: window: metric_name_into/value_into are only valid when emit_schema is long")\n        }\n    }\n\n    cfg.emitMode = "batched_at_end"\n    if v, ok := getString(sm, "emit_mode"); ok {\n        if v != "batched_at_end" && v != "closed_on_advance" {\n            return nil, fmt.Errorf("config: window: emit_mode must be batched_at_end or closed_on_advance")\n        }\n        cfg.emitMode = v\n    }\n    if cfg.emitMode == "closed_on_advance" && cfg.windowType == "session" {\n        return nil, fmt.Errorf("config: window: emit_mode closed_on_advance is not compatible with session windows")\n    }\n\n    cfg.outOrder = "metric-first"\n    if v, ok := getString(sm, "out_order"); ok {\n        if cfg.emitSchema != "long" {\n            return nil, fmt.Errorf("config: window: out_order is only valid when emit_schema is long")\n        }\n        if v != "metric-first" && v != "aggregate-first" {\n            return nil, fmt.Errorf("config: window: out_order must be metric-first or aggregate-first")\n        }\n        cfg.outOrder = v\n    }\n\n    return &WindowStage{cfg: cfg}, nil\n}\n\nfunc aggregateIntos(aggregates []windowAggConfig) []string {\n    out := make([]string, len(aggregates))\n    for i, a := range aggregates {\n        out[i] = a.into\n    }\n    return out\n}\n\nfunc colsForLongCollision(cfg windowConfig) []string {\n    cols := append([]string{}, cfg.partitionBy...)\n    cols = append(cols, cfg.windowStartInto, cfg.windowEndInto)\n    cols = append(cols, aggregateIntos(cfg.aggregates)...)\n    return cols\n}\n\nfunc getWindowNumber(m map[string]interface{}, key string) (float64, error) {\n    v, ok := m[key]\n    if !ok {\n        return 0, fmt.Errorf("missing")\n    }\n    return parseWindowNumber(v)\n}\n\nfunc parseWindowNumber(v interface{}) (float64, error) {\n    switch n := v.(type) {\n    case int:\n        return float64(n), nil\n    case int64:\n        return float64(n), nil\n    case float64:\n        return n, nil\n    case string:\n        return strconv.ParseFloat(n, 64)\n    default:\n        return 0, fmt.Errorf("not a number")\n    }\n}\n\'\'\'\nPath(\'internal/stage/window.go\').write_text(code)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
