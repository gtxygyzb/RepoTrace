]int    `json:"step_range"`\n\tEpochRange []int   `json:"epoch_range"`\n\tTimeRange []string `json:"time_range"`\n}\n\ntype IngestConfig struct {\n\tFile      string `json:"file"`\n\tModelName string `json:"model_name"`\n\tDataset   string `json:"dataset"`\n}\n\ntype IngestOutput struct {\n\tStatus     string           `json:"status"`\n\tEvidenceDir string          `json:"evidence_dir"`\n\tArtifacts  struct {\n\t\tCheckpoints []IngestCheckpoint `json:"checkpoints"`\n\t\tLogShards   []IngestLogShard   `json:"log_shards"`\n\t\tConfigs     []IngestConfig     `json:"configs"`\n\t} `json:"artifacts"`\n\tTotals struct {\n\t\tCheckpoints int `json:"checkpoints"`\n\t\tLogShards   int `json:"log_shards"`\n\t\tConfigs     int `json:"configs"`\n\t} `json:"totals"`\n}\n\nfunc BuildIngest(dir string) (interface{}, error) {\n\tap, err := DiscoverArtifacts(dir)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif len(ap.Checkpoints) == 0 && len(ap.Logs) == 0 && len(ap.Configs) == 0 {\n\t\treturn nil, fmt.Errorf("no recognizable artifacts found in %s", dir)\n\t}\n\n\tvar out IngestOutput\n\tout.Status = "ok"\n\tout.EvidenceDir = dir\n\n\tfor _, p := range ap.Checkpoints {\n\t\tcf, err := checkpoint.Parse(p)\n\t\tif err != nil || cf == nil {\n\t\t\tcontinue\n\t\t}\n\t\tic := IngestCheckpoint{\n\t\t\tFile:       cf.Filename,\n\t\t\tFileHash:   cf.FileHash,\n\t\t\tVersion:    cf.Version,\n\t\t\tNumTensors: cf.NumTensors,\n\t\t\tNumMetadata: cf.NumMetadataKeys,\n\t\t\tSigned:     cf.Signed,\n\t\t\tCreationTimestamp: unixToISO(cf.CreationTimestamp),\n\t\t\tProvenance: provenanceToMap(cf.Provenance),\n\t\t}\n\t\tout.Artifacts.Checkpoints = append(out.Artifacts.Checkpoints, ic)\n\t}\n\tsort.Slice(out.Artifacts.Checkpoints, func(i, j int) bool {\n\t\treturn out.Artifacts.Checkpoints[i].CreationTimestamp < out.Artifacts.Checkpoints[j].CreationTimestamp\n\t})\n\n\tfor _, p := range ap.Logs {\n\t\tinfo, entries, err := parseShardRecursive(p)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tshar