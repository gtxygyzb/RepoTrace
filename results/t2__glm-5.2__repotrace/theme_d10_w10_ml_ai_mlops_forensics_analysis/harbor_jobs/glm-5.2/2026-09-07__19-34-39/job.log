Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\n\np = Path("internal/forensics/detect.go")\ns = p.read_text()\n\nnew_gradient = \'\'\'func detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\n\\tvar vals []float64\n\\tvar idx []int\n\\tfor i, e := range entries {\n\\t\\tif e.GradNorm != nil {\n\\t\\t\\tvals = append(vals, *e.GradNorm)\n\\t\\t\\tidx = append(idx, i)\n\\t\\t}\n\\t}\n\\tif len(vals) < 31 {\n\\t\\treturn nil\n\\t}\n\\tconst alpha = 0.1\n\\tmean := vals[0]\n\\tvariance := 0.0\n\\tvar anomalies []types.Anomaly\n\\tfor i := 1; i < len(vals); i++ {\n\\t\\tif i >= 30 {\n\\t\\t\\tobserved := vals[i]\n\\t\\t\\tstddev := math.Sqrt(variance)\n\\t\\t\\tz := 0.0\n\\t\\t\\tif stddev > 0 {\n\\t\\t\\t\\tz = (observed - mean) / stddev\n\\t\\t\\t}\n\\t\\t\\tif z > 2.5 {\n\\t\\t\\t\\tseverity := "medium"\n\\t\\t\\t\\tif z > 4.0 {\n\\t\\t\\t\\t\\tseverity = "high"\n\\t\\t\\t\\t}\n\\t\\t\\t\\tep := entries[idx[i]].Epoch\n\\t\\t\\t\\tst := entries[idx[i]].Step\n\\t\\t\\t\\tanomalies = append(anomalies, types.Anomaly{\n\\t\\t\\t\\t\\tType:     "gradient_spike",\n\\t\\t\\t\\t\\tSeverity: severity,\n\\t\\t\\t\\t\\tEpoch:    &ep,\n\\t\\t\\t\\t\\tStep:     &st,\n\\t\\t\\t\\t\\tDetails: map[string]interface{}{\n\\t\\t\\t\\t\\t\\t"observed":    observed,\n\\t\\t\\t\\t\\t\\t"ewma_mean":   mean,\n\\t\\t\\t\\t\\t\\t"ewma_stddev": stddev,\n\\t\\t\\t\\t\\t\\t"z_score":     z,\n\\t\\t\\t\\t\\t},\n\\t\\t\\t\\t\\tEvidence: map[string]interface{}{"window_values": lastValues(vals[:i], 5)},\n\\t\\t\\t\\t\\tSource:   firstSource(entries[idx[i]]),\n\\t\\t\\t\\t})\n\\t\\t\\t}\n\\t\\t}\n\\t\\tprevMean := mean\n\\t\\tmean = (1-alpha)*mean + alpha*vals[i]\n\\t\\tvariance = (1-alpha)*variance + alpha*(vals[i]-prevMean)*(vals[i]-prevMean)\n\\t}\n\\treturn anomalies\n}\n\n\'\'\'\n\ng_start = s.index("func detectGradientSpikes")\ng_end = s.index("func detectLrAnomalies", g_start)\ns = s[:g_start] + new_gradient + s[g_end:]\n\nnew_loss = \'\'\'func detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\n\\tvar lossEntries []int\n\\tfor i, e := range entries {\n\\t\\tif e.Loss != nil {\n\\t\\t\\tlossEntries = append(lossEntries, i)\n\\t\\t}\n\\t}\n\\tif len(lossEntries) < 2 {\n\\t\\treturn nil\n\\t}\n\\tconst alpha = 0.05\n\\temaLoss := *entries[lossEntries[0]].Loss\n\\tvar anomalies []types.Anomaly\n\\tfor i := 1; i < len(lossEntries); i++ {\n\\t\\tcurrentLoss := *entries[lossEntries[i]].Loss\n\\t\\tif math.Abs(emaLoss) > 1e-6 {\n\\t\\t\\tratio := currentLoss / emaLoss\n\\t\\t\\tif currentLoss > 2.0*emaLoss {\n\\t\\t\\t\\tseverity := "high"\n\\t\\t\\t\\tif ratio > 5.0 {\n\\t\\t\\t\\t\\tseverity = "critical"\n\\t\\t\\t\\t}\n\\t\\t\\t\\tep := entries[lossEntries[i]].Epoch\n\\t\\t\\t\\tst := entries[lossEntries[i]].Step\n\\t\\t\\t\\tanomalies = append(anomalies, types.Anomaly{\n\\t\\t\\t\\t\\tType:     "loss_divergence",\n\\t\\t\\t\\t\\tSeverity: severity,\n\\t\\t\\t\\t\\tEpoch:    &ep,\n\\t\\t\\t\\t\\tStep:     &st,\n\\t\\t\\t\\t\\tDetails: map[string]interface{}{\n\\t\\t\\t\\t\\t\\t"current_loss": currentLoss,\n\\t\\t\\t\\t\\t\\t"ema_loss":     emaLoss,\n\\t\\t\\t\\t\\t\\t"ratio":        ratio,\n\\t\\t\\t\\t\\t},\n\\t\\t\\t\\t\\tEvidence: map[string]interface{}{"window_values": precedingLossValues(entries, lossEntries, i, 5)},\n\\t\\t\\t\\t\\tSource:   firstSource(entries[lossEntries[i]]),\n\\t\\t\\t\\t})\n\\t\\t\\t}\n\\t\\t}\n\\t\\temaLoss = (1-alpha)*emaLoss + alpha*currentLoss\n\\t}\n\\treturn anomalies\n}\n\n\'\'\'\n\nl_start = s.index("func detectLossDivergence")\nl_end = s.index("func detectLrAnomalies", l_start)\ns = s[:l_start] + new_loss + s[l_end:]\n\np.write_text(s)\n\n# Update analysis_rules.md sections 2.1 and 2.2\ndp = Path("docs/analysis_rules.md")\nds = dp.read_text()\nold = """### 2.1 Gradient Norm Spike\n\n- **Window**: Sliding window of 50 steps\n- **Method**: Compute mean and standard deviation of `grad_norm` over the window\n- **Trigger**: `grad_norm > mean + 3.0 * stddev` (Z-score > 3.0)\n- **Severity**: `high` if Z-score > 5.0, else `medium`\n- **Required data**: At least 50 entries with `grad_norm` before detection begins\n- **Output fields**: `observed`, `window_mean`, `window_stddev`, `z_score`\n\n### 2.2 Loss Divergence\n\n- **Window**: Sliding window of 50 steps\n- **Method**: Compare loss at window start vs window end\n- **Trigger**: `(loss_end - loss_start) / |loss_start| > 1.0` (>100% increase)\n- **Severity**: `critical` if increase > 5.0 (500%), else `high`\n- **Guard**: Only trigger if `|loss_start| > 1e-6` (avoid division by near-zero)\n- **Output fields**: `loss_start`, `loss_end`, `increase_ratio`, `window_start_step`, `window_end_step`\n"""\nnew = """### 2.1 Gradient Norm Spike\n\n- **Method**: Exponential Weighted Moving Average (EWMA) over `grad_norm` values in timeline order\n- **Parameters**: `alpha = 0.1`; tracks EWMA mean and EWMA variance\n- **Warmup**: At least 30 entries with `grad_norm` before detection begins\n- **Trigger**: `z_score > 2.5`, where `z_score = (grad_norm - ewma_mean) / ewma_stddev`\n- **Severity**: `high` when `z_score > 4.0`, otherwise `medium`\n- **Output fields**: `observed`, `ewma_mean`, `ewma_stddev`, `z_score`\n- **Evidence**: `window_values` contains up to 5 preceding `grad_norm` values\n\n### 2.2 Loss Divergence\n\n- **Method**: Exponential Moving Average (EMA) over `loss` values in timeline order\n- **Parameters**: `alpha = 0.05`\n- **Trigger**: `current_loss > 2.0 * ema_loss`\n- **Guard**: Ignore detection when `abs(ema_loss) <= 1e-6`\n- **Severity**: `critical` when `current_loss / ema_loss > 5.0`, otherwise `high`\n- **Output fields**: `current_loss`, `ema_loss`, `ratio`\n- **Evidence**: `window_values` contains up to 5 preceding `loss` values\n"""\nif old not in ds:\n    raise SystemExit("analysis_rules.md section block not found")\ndp.write_text(ds.replace(old, new))\n\n# Update output_schema.md example fields for consistency\nop = Path("docs/output_schema.md")\nos = op.read_text()\nos = os.replace(\'"window_mean": 1.2,\', \'"ewma_mean": 1.2,\')\nos = os.replace(\'"window_stddev": 0.3,\', \'"ewma_stddev": 0.3,\')\nop.write_text(os)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
