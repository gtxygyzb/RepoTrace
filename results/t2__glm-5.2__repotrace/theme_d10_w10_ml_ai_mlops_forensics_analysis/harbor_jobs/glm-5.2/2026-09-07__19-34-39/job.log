Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\nimport re\n\np = Path(\'internal/forensics/detect.go\')\ns = p.read_text()\n\n# Replace BuildDetect/buildDetectWithDir with filter-aware implementation.\nold = re.compile(r\'func BuildDetect\\(dir string\\) \\(interface\\{\\}, error\\) \\{.*?\\n\\}\\n\\nfunc detectTimelineAnomalies\', re.S)\nnew = \'\'\'func BuildDetect(dir string) (interface{}, error) {\n\\treturn BuildDetectFiltered(dir, "")\n}\n\nfunc BuildDetectFiltered(dir, filterSeverity string) (DetectOutput, error) {\n\\tvar out DetectOutput\n\\tout.Status = "ok"\n\\tvar anomalies []types.Anomaly\n\n\\tentries, _, err := loadTimelineEntries(dir)\n\\tif err == nil {\n\\t\\tmerged, _ := mergeTimeline(entries)\n\\t\\tsortTimeline(merged)\n\\t\\tanomalies = append(anomalies, detectTimelineAnomalies(merged)...)\n\\t}\n\n\\tcps, err := loadCheckpoints(dir)\n\\tif err == nil {\n\\t\\tanomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\n\\t}\n\n\\tif filterSeverity != "" {\n\\t\\twantedRank, ok := severityRankValue(filterSeverity)\n\\t\\tif !ok {\n\\t\\t\\treturn out, fmt.Errorf("invalid severity level %q: must be critical, high, medium, or low", filterSeverity)\n\\t\\t}\n\\t\\tfiltered := anomalies[:0]\n\\t\\tfor _, a := range anomalies {\n\\t\\t\\tif severityRank(a.Severity) <= wantedRank {\n\\t\\t\\t\\tfiltered = append(filtered, a)\n\\t\\t\\t}\n\\t\\t}\n\\t\\tanomalies = filtered\n\\t}\n\n\\tfor i := range anomalies {\n\\t\\tanomalies[i].ID = fmt.Sprintf("ANOM-%03d", i+1)\n\\t}\n\\tsortAnomalies(anomalies)\n\n\\tout.Anomalies = anomalies\n\\tif out.Anomalies == nil {\n\\t\\tout.Anomalies = []types.Anomaly{}\n\\t}\n\\tout.Summary.Total = len(anomalies)\n\\tout.Summary.BySeverity = map[string]int{"critical": 0, "high": 0, "medium": 0, "low": 0}\n\\tout.Summary.ByType = map[string]int{}\n\\tfor _, a := range anomalies {\n\\t\\tout.Summary.BySeverity[a.Severity]++\n\\t\\tout.Summary.ByType[a.Type]++\n\\t}\n\\treturn out, nil\n}\n\nfunc severityRank(s string) int {\n\\tswitch s {\n\\tcase "critical":\n\\t\\treturn 0\n\\tcase "high":\n\\t\\treturn 1\n\\tcase "medium":\n\\t\\treturn 2\n\\tdefault:\n\\t\\treturn 3\n\\t}\n}\n\nfunc severityRankValue(s string) (int, bool) {\n\\tswitch s {\n\\tcase "critical":\n\\t\\treturn 0, true\n\\tcase "high":\n\\t\\treturn 1, true\n\\tcase "medium":\n\\t\\treturn 2, true\n\\tcase "low":\n\\t\\treturn 3, true\n\\tdefault:\n\\t\\treturn 4, false\n\\t}\n}\n\nfunc detectTimelineAnomalies\'\'\'\ns = old.sub(new, s, count=1)\n\n# Add evidence to gradient_spike.\nold = \'\\t\\t\\t\\t\\tSource: firstSource(entries[idx[i]]),\'\nnew = \'\\t\\t\\t\\t\\tEvidence: map[string]interface{}{"window_values": lastValues(window, 5)},\\n\\t\\t\\t\\t\\tSource: firstSource(entries[idx[i]]),\'\ns = s.replace(old, new, 1)\n\n# Add evidence to loss_divergence.\nold = \'\\t\\t\\t\\t\\tSource: firstSource(entries[endIdx]),\'\nnew = \'\\t\\t\\t\\t\\tEvidence: map[string]interface{}{"window_values": precedingLossValues(entries, lossEntries, i, 5)},\\n\\t\\t\\t\\t\\tSource: firstSource(entries[endIdx]),\'\ns = s.replace(old, new, 1)\n\n# Add evidence to remaining timeline anomalies using firstSource(cur).\nold = \'\\t\\t\\t\\t\\tSource: firstSource(cur),\'\nnew = \'\\t\\t\\t\\t\\tEvidence: map[string]interface{}{"window_values": []float64{}},\\n\\t\\t\\t\\t\\tSource: firstSource(cur),\'\ns = s.replace(old, new)\n\n# Add empty evidence to checkpoint-based anomalies.\nlines = s.split(\'\\n\')\nout = []\nfor line in lines:\n    if (\'Source:     cf.Filename,\' in line) or (\'Source: chain[0],\' in line):\n        indent = line[:len(line)-len(line.lstrip())]\n        if out and \'Evidence:\' in out[-1]:\n            out.append(line)\n        else:\n            if \'cf.Filename\' in line:\n                out.append(indent + \'Evidence:   map[string]interface{}{},\')\n            else:\n                out.append(indent + \'Evidence: map[string]interface{}{},\')\n            out.append(line)\n    else:\n        out.append(line)\ns = \'\\n\'.join(out)\n\n# Add helper functions for evidence windows.\nold = \'func firstSource(e types.TimelineEntry) string {\'\nnew = \'\'\'func lastValues(v []float64, n int) []float64 {\n\\tif len(v) > n {\n\\t\\tv = v[len(v)-n:]\n\\t}\n\\tif v == nil {\n\\t\\tv = []float64{}\n\\t}\n\\treturn v\n}\n\nfunc precedingLossValues(entries []types.TimelineEntry, indices []int, pos, n int) []float64 {\n\\tvals := []float64{}\n\\tstart := pos - n\n\\tif start < 0 {\n\\t\\tstart = 0\n\\t}\n\\tfor j := start; j < pos; j++ {\n\\t\\tif j >= 0 && j < len(indices) && entries[indices[j]].Loss != nil {\n\\t\\t\\tvals = append(vals, *entries[indices[j]].Loss)\n\\t\\t}\n\\t}\n\\treturn vals\n}\n\nfunc firstSource(e types.TimelineEntry) string {\'\'\'\ns = s.replace(old, new, 1)\n\np.write_text(s)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
