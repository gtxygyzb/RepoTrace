Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\nimport re\n\n# 1. Update timeline conflict resolution from latest to earliest.\np = Path(\'internal/forensics/forensics.go\')\ns = p.read_text()\ns = s.replace(\n\'\'\'                if metricsEqual(a.entry, e) {\n                        if e.Ts > a.entry.Ts {\n                                a.entry = e\n                        }\n                        continue\n                }\n                a.conflict = true\n                if e.Ts > a.entry.Ts {\n                        a.entry = e\n                }\'\'\',\n\'\'\'                if metricsEqual(a.entry, e) {\n                        if e.Ts < a.entry.Ts {\n                                a.entry = e\n                        }\n                        continue\n                }\n                a.conflict = true\n                if e.Ts < a.entry.Ts {\n                        a.entry = e\n                }\'\'\')\np.write_text(s)\n\n# 2. Add diff implementation.\nPath(\'internal/forensics/diff.go\').write_text(r\'\'\'package forensics\n\nimport (\n        "encoding/binary"\n        "fmt"\n        "math"\n        "path/filepath"\n        "sort"\n\n        "mlforge/internal/checkpoint"\n)\n\n// diffTensorResult describes one tensor in the diff output.\ntype diffTensorResult struct {\n        Name        string   `json:"name"`\n        ShapeMatch  bool     `json:"shape_match"`\n        ShapeA      []uint32 `json:"shape_a"`\n        ShapeB      []uint32 `json:"shape_b"`\n        MaxAbsDiff  *float64 `json:"max_abs_diff,omitempty"`\n        MeanAbsDiff *float64 `json:"mean_abs_diff,omitempty"`\n}\n\n// diffSummary summarizes tensor presence and shape compatibility.\ntype diffSummary struct {\n        TotalTensorsA  int      `json:"total_tensors_a"`\n        TotalTensorsB  int      `json:"total_tensors_b"`\n        CommonTensors  int      `json:"common_tensors"`\n        ShapeMismatches int     `json:"shape_mismatches"`\n        OnlyInA        []string `json:"only_in_a"`\n        OnlyInB        []string `json:"only_in_b"`\n}\n\n// diffOutput is the JSON output for the diff command.\ntype diffOutput struct {\n        Status      string             `json:"status"`\n        FileA       string             `json:"file_a"`\n        FileB       string             `json:"file_b"`\n        TensorDiffs []diffTensorResult `json:"tensor_diffs"`\n        Summary     diffSummary        `json:"summary"`\n}\n\nconst float32Dtype byte = 0\n\n// BuildDiff compares two checkpoint files inside evidenceDir tensor by tensor.\nfunc BuildDiff(evidenceDir, file1, file2 string) (interface{}, error) {\n        pathA := filepath.Join(evidenceDir, file1)\n        pathB := filepath.Join(evidenceDir, file2)\n\n        cfA, err := checkpoint.Parse(pathA)\n        if err != nil {\n                return nil, fmt.Errorf("diff: %s: %w", file1, err)\n        }\n        if cfA == nil {\n                return nil, fmt.Errorf("diff: %s: not found", file1)\n        }\n        cfB, err := checkpoint.Parse(pathB)\n        if err != nil {\n                return nil, fmt.Errorf("diff: %s: %w", file2, err)\n        }\n        if cfB == nil {\n                return nil, fmt.Errorf("diff: %s: not found", file2)\n        }\n\n        tensorsA := make(map[string]types.TensorInfo, len(cfA.Tensors))\n        for _, t := range cfA.Tensors {\n                tensorsA[t.Name] = t\n        }\n        tensorsB := make(map[string]types.TensorInfo, len(cfB.Tensors))\n        for _, t := range cfB.Tensors {\n                tensorsB[t.Name] = t\n        }\n\n        names := map[string]struct{}{}\n        for name := range tensorsA {\n                names[name] = struct{}{}\n        }\n        for name := range tensorsB {\n                names[name] = struct{}{}\n        }\n        sortedNames := make([]string, 0, len(names))\n        for name := range names {\n                sortedNames = append(sortedNames, name)\n        }\n        sort.Strings(sortedNames)\n\n        onlyInA := []string{}\n        onlyInB := []string{}\n        common := 0\n        shapeMismatches := 0\n        tensorDiffs := make([]diffTensorResult, 0, len(sortedNames))\n\n        for _, name := range sortedNames {\n                ta, okA := tensorsA[name]\n                tb, okB := tensorsB[name]\n\n                var shapeA []uint32\n                var shapeB []uint32\n                if okA {\n                        shapeA = ta.Shape\n                }\n                if okB {\n                        shapeB = tb.Shape\n                }\n\n                shapeMatch := okA && okB && shapesEqual(ta.Shape, tb.Shape)\n                result := diffTensorResult{\n                        Name:       name,\n                        ShapeMatch: shapeMatch,\n                        ShapeA:     shapeA,\n                        ShapeB:     shapeB,\n                }\n\n                if okA && okB {\n                        common++\n                        if !shapeMatch {\n                                shapeMismatches++\n                        } else {\n                                maxDiff, meanDiff, err := float32DiffStats(ta, tb)\n                                if err != nil {\n                                        return nil, fmt.Errorf("diff: tensor %s: %w", name, err)\n                                }\n                                result.MaxAbsDiff = &maxDiff\n                                result.MeanAbsDiff = &meanDiff\n                        }\n                } else if okA {\n                        onlyInA = append(onlyInA, name)\n                } else {\n                        onlyInB = append(onlyInB, name)\n                }\n\n                tensorDiffs = append(tensorDiffs, result)\n        }\n\n        return diffOutput{\n                Status: "ok",\n                FileA:  filepath.Base(file1),\n                FileB:  filepath.Base(file2),\n                TensorDiffs: tensorDiffs,\n                Summary: diffSummary{\n                        TotalTensorsA:  len(tensorsA),\n                        TotalTensorsB:  len(tensorsB),\n                        CommonTensors:  common,\n                        ShapeMismatches: shapeMismatches,\n                        OnlyInA:        onlyInA,\n                        OnlyInB:        onlyInB,\n                },\n        }, nil\n}\n\nfunc shapesEqual(a, b []uint32) bool {\n        if len(a) != len(b) {\n                return false\n        }\n        for i := range a {\n                if a[i] != b[i] {\n                        return false\n                }\n        }\n        return true\n}\n\nfunc float32DiffStats(a, b types.TensorInfo) (float64, float64, error) {\n        if a.Dtype != float32Dtype || b.Dtype != float32Dtype {\n                return 0, 0, fmt.Errorf("unsupported dtype %d/%d; only float32 tensors are supported", a.Dtype, b.Dtype)\n        }\n        if len(a.Data) != len(b.Data) {\n                return 0, 0, fmt.Errorf("data length mismatch %d/%d", len(a.Data), len(b.Data))\n        }\n        if len(a.Data)%4 != 0 {\n                return 0, 0, fmt.Errorf("non-float32 data length %d", len(a.Data))\n        }\n\n        n := len(a.Data) / 4\n        if n == 0 {\n                return 0, 0, nil\n        }\n\n        var maxDiff, sumDiff float64\n        for i := 0; i < n; i++ {\n                fa := math.Float32frombits(binary.LittleEndian.Uint32(a.Data[i*4 : i*4+4]))\n                fb := math.Float32frombits(binary.LittleEndian.Uint32(b.Data[i*4 : i*4+4]))\n                d := math.Abs(float64(fa - fb))\n                if d > maxDiff {\n                        maxDiff = d\n                }\n                sumDiff += d\n        }\n        return maxDiff, sumDiff / float64(n), nil\n}\n\'\'\')\n\n# 3. Add diff CLI case.\np = Path(\'cmd/mlforge/main.go\')\ns = p.read_text()\ns = s.replace(\n\'\'\'        case "query":\n                if len(positional) < 3 {\n                        fmt.Fprintf(os.Stderr, "Usage: mlforge query <dir> \\"<expression>\\"\\n")\n                        os.Exit(1)\n                }\n                result, err = forensics.BuildQuery(dir, positional[2])\n        case "report":\'\'\',\n\'\'\'        case "query":\n                if len(positional) < 3 {\n                        fmt.Fprintf(os.Stderr, "Usage: mlforge query <dir> \\"<expression>\\"\\n")\n                        os.Exit(1)\n                }\n                result, err = forensics.BuildQuery(dir, positional[2])\n        case "diff":\n                if len(positional) < 4 {\n                        fmt.Fprintf(os.Stderr, "Usage: mlforge diff <dir> <file1> <file2>\\n")\n                        os.Exit(1)\n                }\n                result, err = forensics.BuildDiff(dir, positional[2], positional[3])\n        case "report":\'\'\')\np.write_text(s)\n\n# 4. Update docs.\np = Path(\'docs/analysis_rules.md\')\ns = p.read_text()\ns = s.replace(\n   \'If values differ, this is a **conflict**. Resolution: keep the entry with the **latest** `ts` timestamp. Record the conflict.\',\n   \'If values differ, this is a **conflict**. Resolution: keep the entry with the **earliest** `ts` timestamp. Record the conflict.\')\np.write_text(s)\n\np = Path(\'docs/spec.md\')\ns = p.read_text()\ns = s.replace(\n\'\'\'#### `report`\n\nGenerate a comprehensive forensic report by running all analyses (ingest, timeline, verify, detect, lineage) and combining results.\n\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section "Report Output".\n\'\'\',\n\'\'\'#### `diff`\n\n```\nmlforge diff <evidence-dir> <file1> <file2>\n```\n\nCompare two checkpoint files inside `<evidence-dir>` tensor by tensor and write JSON to stdout. `file1` and `file2` are checkpoint filenames relative to `<evidence-dir>`.\n\nFor every tensor name present in either file, include one entry in `tensor_diffs`, sorted by tensor name lexicographically. `max_abs_diff` and `mean_abs_diff` are included only when both files contain the tensor and their shapes match.\n\nIf either checkpoint filename does not exist under `<evidence-dir>`, exit non-zero and print an error to stderr.\n\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section "Diff Output".\n\n#### `report`\n\nGenerate a comprehensive forensic report by running all analyses (ingest, timeline, verify, detect, lineage) and combining results.\n\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section "Report Output".\n\'\'\')\np.write_text(s)\n\np = Path(\'docs/output_schema.md\')\ns = p.read_text()\ns += r\'\'\'\n\n## 8. Diff Output\n\n```json\n{\n  "status": "ok",\n  "file_a": "model_epoch1.mlck",\n  "file_b": "model_epoch2.mlck",\n  "tensor_diffs": [\n    {\n      "name": "layer1.weight",\n      "shape_match": true,\n      "shape_a": [4, 3],\n      "shape_b": [4, 3],\n      "max_abs_diff": 1.234,\n      "mean_abs_diff": 0.567\n    },\n    {\n      "name": "layer2.weight",\n      "shape_match": false,\n      "shape_a": [4, 3],\n      "shape_b": [8, 3]\n    },\n    {\n      "name": "layer3.bias",\n      "shape_match": false,\n      "shape_a": null,\n      "shape_b": [3]\n    }\n  ],\n  "summary": {\n    "total_tensors_a": 2,\n    "total_tensors_b": 2,\n    "common_tensors": 2,\n    "shape_mismatches": 0,\n    "only_in_a": [],\n    "only_in_b": []\n  }\n}\n```\n\n**Field rules:**\n- `file_a` and `file_b` are the basenames of `file1` and `file2`.\n- `tensor_diffs`: sorted by tensor name lexicographically.\n- `shape_a` and `shape_b`: tensor shapes from each file, or `null` if absent from that file.\n- `shape_match`: `true` only when the tensor exists in both files and the shapes are identical.\n- `max_abs_diff` and `mean_abs_diff`: present only for tensors with `shape_match: true`, computed over float32 element-wise absolute differences.\n- `summary.total_tensors_a` and `summary.total_tensors_b`: tensor counts in each file.\n- `summary.common_tensors`: number of tensor names present in both files.\n- `summary.shape_mismatches`: number of common tensors with different shapes.\n- `summary.only_in_a` and `summary.only_in_b`: tensor names present in only one file, sorted lexicographically.\n\'\'\'\np.write_text(s)\nPY\ngofmt -w internal/forensics/forensics.go internal/forensics/diff.go cmd/mlforge/main.go\ngo build ./...\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
