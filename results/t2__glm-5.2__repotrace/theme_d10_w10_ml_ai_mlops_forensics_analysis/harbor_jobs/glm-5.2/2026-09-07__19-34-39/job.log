ify(dir string) (interface{}, error) {\n\tap, err := DiscoverArtifacts(dir)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif len(ap.Checkpoints) == 0 {\n\t\treturn nil, fmt.Errorf("no checkpoint files found")\n\t}\n\tvar out VerifyOutput\n\tout.Status = "ok"\n\tfor _, p := range ap.Checkpoints {\n\t\tvc := verifyCheckpoint(p)\n\t\tout.Checkpoints = append(out.Checkpoints, vc)\n\t}\n\tsort.Slice(out.Checkpoints, func(i, j int) bool {\n\t\treturn out.Checkpoints[i].File < out.Checkpoints[j].File\n\t})\n\tout.Summary.Total = len(out.Checkpoints)\n\tfor _, c := range out.Checkpoints {\n\t\tif c.Valid {\n\t\t\tout.Summary.Valid++\n\t\t} else {\n\t\t\tout.Summary.Invalid++\n\t\t}\n\t}\n\treturn out, nil\n}\n\nfunc verifyCheckpoint(path string) VerifyCheckpoint {\n\tvc := VerifyCheckpoint{\n\t\tFile:   filepath.Base(path),\n\t\tIssues: []string{},\n\t}\n\tcf, err := checkpoint.Parse(path)\n\tif err != nil || cf == nil {\n\t\tvc.HeaderChecksumValid = false\n\t\tvc.TensorChecksumsValid = false\n\t\tvc.ProvenanceValid = false\n\t\tvc.Valid = false\n\t\tvc.Issues = append(vc.Issues, fmt.Sprintf("parse_error:%s", err))\n\t\treturn vc\n\t}\n\tvc.HeaderChecksumValid = cf.HeaderValid\n\tif !cf.HeaderValid {\n\t\tvc.Issues = append(vc.Issues, "header_checksum_mismatch")\n\t}\n\tvc.TensorChecksumsValid = true\n\tfor _, t := range cf.Tensors {\n\t\tif !t.Valid {\n\t\t\tvc.TensorChecksumsValid = false\n\t\t\tvc.Issues = append(vc.Issues, fmt.Sprintf("tensor_checksum_mismatch:%s", t.Name))\n\t\t}\n\t}\n\tif cf.Signed {\n\t\tvalid, _ := validateSignature(path)\n\t\tvc.SignatureValid = &valid\n\t\tif !valid {\n\t\t\tvc.Issues = append(vc.Issues, "signature_invalid")\n\t\t}\n\t}\n\tvc.ProvenanceValid = validateProvenance(cf)\n\tif !vc.ProvenanceValid {\n\t\tvc.Issues = append(vc.Issues, "provenance_invalid")\n\t}\n\tvc.Valid = vc.HeaderChecksumValid && vc.TensorChecksumsValid && vc.ProvenanceValid && (!cf.Signed || (vc.SignatureValid != nil && *vc.SignatureValid))\n\treturn vc\n}\n\nfun