Sending keys: ['cat > internal/forensics/query.go <<\'EOF\'\npackage forensics\n\nimport (\n\t"fmt"\n\t"strconv"\n\t"strings"\n\t"time"\n\n\t"mlforge/internal/types"\n)\n\ntype QueryOutput struct {\n\tStatus  string                `json:"status"`\n\tQuery   string                `json:"query"`\n\tMatches int                   `json:"matches"`\n\tEntries []types.TimelineEntry `json:"entries"`\n}\n\nfunc BuildQuery(dir, expr string) (interface{}, error) {\n\tentries, _, err := loadTimelineEntries(dir)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmerged, _ := mergeTimeline(entries)\n\tsortTimeline(merged)\n\n\tq, err := parseQuery(expr)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmatches := []types.TimelineEntry{}\n\tfor _, e := range merged {\n\t\tif q.eval(e) {\n\t\t\tmatches = append(matches, e)\n\t\t}\n\t}\n\treturn QueryOutput{\n\t\tStatus:  "ok",\n\t\tQuery:   expr,\n\t\tMatches: len(matches),\n\t\tEntries: matches,\n\t}, nil\n}\n\ntype condition struct {\n\tfield string\n\top    string\n\tsval  string\n\tfval  float64\n\tisNum bool\n}\n\ntype node interface {\n\teval(e types.TimelineEntry) bool\n}\n\ntype conditionNode struct {\n\tcondition condition\n}\n\ntype notNode struct {\n\tchild node\n}\n\ntype andNode struct {\n\tchildren []node\n}\n\ntype orNode struct {\n\tchildren []node\n}\n\nfunc (c conditionNode) eval(e types.TimelineEntry) bool {\n\treturn c.condition.eval(e)\n}\n\nfunc (n notNode) eval(e types.TimelineEntry) bool {\n\treturn !n.child.eval(e)\n}\n\nfunc (a andNode) eval(e types.TimelineEntry) bool {\n\tfor _, child := range a.children {\n\t\tif !child.eval(e) {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc (o orNode) eval(e types.TimelineEntry) bool {\n\tfor _, child := range o.children {\n\t\tif child.eval(e) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc (c condition) eval(e types.TimelineEntry) bool {\n\tswitch c.field {\n\tcase "step":\n\t\treturn compareNum(float64(e.Step), c)\n\tcase "epoch":\n\t\treturn compareNum(float64(e.Epoch), c)\n\tcase "loss":\n\t\treturn ptrCompareNum(e.Loss, c)\n\tcase "lr":\n\t\treturn ptrCompareNum(e.Lr, c)\n\tcase "grad_norm":\n\t\treturn ptrCompareNum(e.GradNorm, c)\n\tcase "acc":\n\t\treturn ptrCompareNum(e.Acc, c)\n\tcase "event":\n\t\treturn compareStr(e.Event, c)\n\tcase "ts":\n\t\treturn compareTs(e.Ts, c)\n\t}\n\treturn false\n}\n\nfunc compareNum(val float64, c condition) bool {\n\tif !c.isNum {\n\t\treturn false\n\t}\n\tswitch c.op {\n\tcase ">":\n\t\treturn val > c.fval\n\tcase "<":\n\t\treturn val < c.fval\n\tcase ">=":\n\t\treturn val >= c.fval\n\tcase "<=":\n\t\treturn val <= c.fval\n\tcase "==":\n\t\treturn absFloat(val-c.fval) <= 1e-9\n\tcase "!=":\n\t\treturn absFloat(val-c.fval) > 1e-9\n\t}\n\treturn false\n}\n\nfunc ptrCompareNum(p *float64, c condition) bool {\n\tif p == nil {\n\t\treturn false\n\t}\n\treturn compareNum(*p, c)\n}\n\nfunc compareStr(val string, c condition) bool {\n\tif c.isNum {\n\t\treturn false\n\t}\n\tswitch c.op {\n\tcase "==":\n\t\treturn val == c.sval\n\tcase "!=":\n\t\treturn val != c.sval\n\t}\n\treturn false\n}\n\nfunc compareTs(val string, c condition) bool {\n\tlt, err := time.Parse(time.RFC3339, val)\n\tif err != nil {\n\t\treturn false\n\t}\n\trt, err := time.Parse(time.RFC3339, c.sval)\n\tif err != nil {\n\t\treturn false\n\t}\n\tswitch c.op {\n\tcase ">":\n\t\treturn lt.After(rt)\n\tcase "<":\n\t\treturn lt.Before(rt)\n\tcase ">=":\n\t\treturn lt.After(rt) || lt.Equal(rt)\n\tcase "<=":\n\t\treturn lt.Before(rt) || lt.Equal(rt)\n\tcase "==":\n\t\treturn lt.Equal(rt)\n\tcase "!=":\n\t\treturn !lt.Equal(rt)\n\t}\n\treturn false\n}\n\nfunc absFloat(x float64) float64 {\n\tif x < 0 {\n\t\treturn -x\n\t}\n\treturn x\n}\n\ntype parser struct {\n\ttokens []string\n\tpos    int\n}\n\nfunc parseQuery(expr string) (node, error) {\n\ttokens, err := tokenizeQuery(expr)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif len(tokens) == 0 {\n\t\treturn nil, fmt.Errorf("empty query")\n\t}\n\tp := &parser{tokens: tokens}\n\tn, err := p.parseOr()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif p.pos != len(p.tokens) {\n\t\treturn nil, fmt.Errorf("unexpected token: %s", p.current())\n\t}\n\treturn n, nil\n}\n\nfunc (p *parser) current() string {\n\tif p.pos < len(p.tokens) {\n\t\treturn p.tokens[p.pos]\n\t}\n\treturn ""\n}\n\nfunc (p *parser) match(tok string) bool {\n\tif p.current() == tok {\n\t\tp.pos++\n\t\treturn true\n\t}\n\treturn false\n}\n\nfunc (p *parser) parseOr() (node, error) {\n\tleft, err := p.parseAnd()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tfor {\n\t\tif !p.match("OR") {\n\t\t\tbreak\n\t\t}\n\t\tright, err := p.parseAnd()\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif or, ok := left.(orNode); ok {\n\t\t\tor.children = append(or.children, right)\n\t\t\tleft = or\n\t\t} else {\n\t\t\tleft = orNode{children: []node{left, right}}\n\t\t}\n\t}\n\treturn left, nil\n}\n\nfunc (p *parser) parseAnd() (node, error) {\n\tleft, err := p.parseNot()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tfor {\n\t\tif !p.match("AND") {\n\t\t\tbreak\n\t\t}\n\t\tright, err := p.parseNot()\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif and, ok := left.(andNode); ok {\n\t\t\tand.children = append(and.children, right)\n\t\t\tleft = and\n\t\t} else {\n\t\t\tleft = andNode{children: []node{left, right}}\n\t\t}\n\t}\n\treturn left, nil\n}\n\nfunc (p *parser) parseNot() (node, error) {\n\tif p.match("NOT") {\n\t\tchild, err := p.parseNot()\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\treturn notNode{child: child}, nil\n\t}\n\treturn p.parseAtom()\n}\n\nfunc (p *parser) parseAtom() (node, error) {\n\tif p.match("(") {\n\t\texpr, err := p.parseOr()\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif !p.match(")") {\n\t\t\treturn nil, fmt.Errorf("missing closing parenthesis")\n\t\t}\n\t\treturn expr, nil\n\t}\n\tcond, err := p.parseCondition()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn conditionNode{condition: cond}, nil\n}\n\nfunc (p *parser) parseCondition() (condition, error) {\n\tif p.pos+2 >= len(p.tokens) {\n\t\treturn condition{}, fmt.Errorf("invalid query syntax")\n\t}\n\n\tfield := p.tokens[p.pos]\n\top := p.tokens[p.pos+1]\n\tvalueTok := p.tokens[p.pos+2]\n\n\tvalidFields := map[string]bool{"step": true, "epoch": true, "loss": true, "lr": true, "grad_norm": true, "acc": true, "event": true, "ts": true}\n\tif !validFields[field] {\n\t\treturn condition{}, fmt.Errorf("unknown field: %s", field)\n\t}\n\tvalidOps := map[string]bool{">": true, "<": true, ">=": true, "<=": true, "==": true, "!=": true}\n\tif !validOps[op] {\n\t\treturn condition{}, fmt.Errorf("invalid operator: %s", op)\n\t}\n\n\tc := condition{field: field, op: op, sval: valueTok}\n\tif field == "event" {\n\t\tif op != "==" && op != "!=" {\n\t\t\treturn condition{}, fmt.Errorf("type mismatch: event only supports == or !=")\n\t\t}\n\t\tif !isQuotedString(valueTok) {\n\t\t\treturn condition{}, fmt.Errorf("type mismatch: event requires string value")\n\t\t}\n\t\tc.sval = unquote(valueTok)\n\t\treturn c, p.pos + 3, nil\n\t}\n\tif field == "ts" {\n\t\tif _, err := time.Parse(time.RFC3339, unquote(valueTok)); err != nil {\n\t\t\treturn condition{}, fmt.Errorf("invalid timestamp: %s", valueTok)\n\t\t}\n\t\tc.sval = unquote(valueTok)\n\t\treturn c, p.pos + 3, nil\n\t}\n\tnum, err := strconv.ParseFloat(valueTok, 64)\n\tif err != nil {\n\t\treturn condition{}, fmt.Errorf("type mismatch: %s requires numeric value", field)\n\t}\n\tc.fval = num\n\tc.isNum = true\n\treturn c, p.pos + 3, nil\n}\n\nfunc tokenizeQuery(s string) ([]string, error) {\n\tvar tokens []string\n\ti := 0\n\tfor i < len(s) {\n\t\tch := s[i]\n\t\tif ch == \' \' || ch == \'\\t\' || ch == \'\\n\' || ch == \'\\r\' {\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tif ch == \'"\' {\n\t\t\tj := i + 1\n\t\t\tfor j < len(s) && s[j] != \'"\' {\n\t\t\t\tj++\n\t\t\t}\n\t\t\tif j >= len(s) {\n\t\t\t\treturn nil, fmt.Errorf("unterminated string")\n\t\t\t}\n\t\t\ttokens = append