### 2.9 Training Gap

- **Method**: Consecutive timeline entries (after merge sort) have timestamps more than 2 hours apart
- **Trigger**: `time_diff > 7200 seconds` between consecutive entries within the same epoch
- **Severity**: `low`
- **Output fields**: `after_step`, `before_step`, `after_ts`, `before_ts`, `gap_seconds`

### 2.10 Dataset Hash Inconsistency

- **Method**: Compare `DatasetHash` across all checkpoints in the same lineage chain
- **Trigger**: Different `DatasetHash` values within the same chain
- **Severity**: `high`
- **Output fields**: `files`, `hashes` (list of unique hex hashes)

---

## 3. Query Language

### 3.1 Grammar

```
query      := condition (BOOL_OP condition)*
condition  := field COMP_OP value
BOOL_OP    := "AND" | "OR"
COMP_OP    := ">" | "<" | ">=" | "<=" | "==" | "!="
field      := "step" | "epoch" | "loss" | "lr" | "grad_norm" | "acc" | "event" | "ts"
value      := NUMBER | QUOTED_STRING | TIMESTAMP
NUMBER     := integer or float literal
QUOTED_STRING := '"' ... '"' (double-quoted string)
TIMESTAMP  := ISO 8601 format (e.g., 2024-01-15T10:30:00Z)
```

### 3.2 Operator Precedence

- `AND` binds tighter than `OR`
- Parentheses are NOT supported (keep the grammar simple)
- Evaluation: left to right with AND having higher precedence

Example: `loss > 1.0 OR grad_norm > 5.0 AND epoch == 3`
Parses as: `loss > 1.0 OR (grad_norm > 5.0 AND epoch == 3)`

### 3.3 Type Rules

[?2004hroot@n30009:/app# cat > internal/forensics/query.go <<'EOF'
[?2004lpareStr(e.Event, c)
	case "ts":
		return compareTs(e.Ts, c)
	}
	return false
}

func compareNum(val float64, c condition) bool {
	if !c.isNum {
		return false
	}
	switch c.op {
	case ">":
		return val > c.fval
	case "<":
		return val < c.fval
	case ">=":
		return val >= c.fval
	case "<=":
		return val <= c.fval
	case "==":
		return absFloat(val-c.fval) <= 1e-9
	case "!=":
		return absFloat(val-c.fval) > 1e-9
	}
	return false
}

func ptrCompareNum(p *float64, c condition) bool {
	if p == nil {
		return false
	}
	return compareNum(*p, c)
}

func compareStr(val string, c condition) bool {
	if c.isNum {
		return false
	}
	switch c.op {
	case "==":
		return val == c.sval
	case "!=":
		return val != c.sval
	}
	return false
}

func compareTs(val string, c condition) bool {
	lt, err := time.Parse(time.RFC3339, val)
	if err != nil {
		return false
	}
	rt, err := time.Parse(time.RFC3339, c.sval)
	if err != nil {
		return false
	}
	switch c.op {
	case ">":
		return lt.After(rt)
	case "<":
		return lt.Before(rt)
	case ">=":
		return lt.After(rt) || lt.Equal(rt)
	case "<=":
		return lt.Before(rt) || lt.Equal(rt)
	case "==":
		return lt.Equal(rt)
	case "!=":
		return !lt.Equal(rt)
	}
	return false
}

func absFloat(x float64) float64 {
	if x < 0 {
		return -x
	}
	return x
}

type parser struct {
	tokens []string
	pos    int
}

func parseQuery(expr string) (node, error) {
	tokens, err := tokenizeQuery(expr)
	if err != nil {
		return nil, err
	}
	if len(tokens) == 0 {
		return nil, fmt.Errorf("empty query")
	}
	p := &parser{tokens: tokens}
	n, err := p.parseOr()
	if err != nil {
		return nil, err
	}
	if p.pos != len(p.tokens) {
		return nil, fmt.Errorf("unexpected token: %s", p.current())
	}
	return n, nil
}

func (p *parser) current() string {
	if p.pos < len(p.tokens) {
		return p.tokens[p.pos]
	}
	return ""
}

func (p *parser) match(tok string) bool {
	if p.current() == tok {
		p.pos++
		return true
	}
	return false
}

func (p *parser) parseOr() (node, error) {
	left, err := p.parseAnd()
	if err != nil {
		return nil, err
	}
	for {
		if !p.match("OR") {
			break
		}
