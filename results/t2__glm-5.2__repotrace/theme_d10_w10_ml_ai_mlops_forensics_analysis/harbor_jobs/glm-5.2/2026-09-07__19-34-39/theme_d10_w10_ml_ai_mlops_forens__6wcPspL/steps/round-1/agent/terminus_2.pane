   300	func verifyCheckpoint(path string) VerifyCheckpoint {
   301		vc := VerifyCheckpoint{
   302			File:   filepath.Base(path),
   303			Issues: []VerifyIssue{},
   304		}
   305		cf, err := checkpoint.Parse(path)
   306		if err != nil || cf == nil {
   307			vc.HeaderChecksumValid = false
   308			vc.TensorChecksumsValid = false
   309			vc.ProvenanceValid = false
   310			vc.Valid = false
   311			vc.Issues = append(vc.Issues, VerifyIssue{Type: "parse_error", Detail: err.Error()})
   312			return vc
   313		}
   314		vc.HeaderChecksumValid = cf.HeaderValid
   315		if !cf.HeaderValid {
   316			vc.Issues = append(vc.Issues, VerifyIssue{Type: "header_checksum_mismatch", Detail: ""})
   317		}
   318		vc.TensorChecksumsValid = true
   319		for _, t := range cf.Tensors {
   320			if !t.Valid {
   321				vc.TensorChecksumsValid = false
   322				vc.Issues = append(vc.Issues, VerifyIssue{Type: "tensor_checksum_mismatch", Detail: t.Name})
   323			}
   324		}
   325		if cf.Signed {
   326			valid, _ := validateSignature(path)
   327			vc.SignatureValid = &valid
   328			if !valid {
   329				vc.Issues = append(vc.Issues, VerifyIssue{Type: "signature_invalid", Detail: ""})
   330			}
   331		}
   332		vc.ProvenanceValid = validateProvenance(cf)
   333		if !vc.ProvenanceValid {
   334			vc.Issues = append(vc.Issues, VerifyIssue{Type: "provenance_invalid", Detail: ""})
   335		}
