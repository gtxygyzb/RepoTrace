   290				j++
   291			}
   292			if j == i {
   293				return nil, fmt.Errorf("invalid character in query: %c", ch)
   294			}
   295			tokens = append(tokens, s[i:j])
   296			i = j
   297		}
   298		return tokens, nil
   299	}
