	s := 0.0
	for _, x := range v {
		d := x - mean
		s += d * d
	}
	return math.Sqrt(s / float64(len(v)))
}

func sortAnomalies(a []types.Anomaly) {
	rank := map[string]int{"critical": 0, "high": 1, "medium": 2, "low": 3}
	sort.Slice(a, func(i, j int) bool {
		ri := rank[a[i].Severity]
		rj := rank[a[j].Severity]
		if ri != rj {
			return ri < rj
		}
		ei := -1
		ej := -1
		if a[i].Epoch != nil {
			ei = *a[i].Epoch
		}
		ej = -1
		if a[j].Epoch != nil {
			ej = *a[j].Epoch
		}
		if ei != ej {
			return ei < ej
		}
		si := -1
		if a[i].Step != nil {
			si = *a[i].Step
		}
		sj := -1
		if a[j].Step != nil {
			sj = *a[j].Step
		}
		return si < sj
	})
}
