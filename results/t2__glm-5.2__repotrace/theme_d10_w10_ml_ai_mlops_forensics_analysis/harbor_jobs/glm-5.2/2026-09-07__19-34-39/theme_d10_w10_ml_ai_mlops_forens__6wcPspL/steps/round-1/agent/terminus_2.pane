func detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {$
^Ivar anomalies []types.Anomaly$
^Ifor i := 1; i < len(entries); i++ {$
^I^Iprev := entries[i-1]$
^I^Icur := entries[i]$
^I^Iif prev.Lr == nil || cur.Lr == nil {$
^I^I^Icontinue$
^I^I}$
^I^Iif *cur.Lr > *prev.Lr {$
^I^I^Iif cur.Event == "epoch_end" {$
^I^I^I^Icontinue$
^I^I^I}$
^I^I^Iep := cur.Epoch$
^I^I^Ist := cur.Step$
^I^I^Ianomalies = append(anomalies, types.Anomaly{$
^I^I^I^IType:     "lr_anomaly",$
^I^I^I^ISeverity: "medium",$
^I^I^I^IEpoch:    &ep,$
^I^I^I^IStep:     &st,$
^I^I^I^IDetails: map[string]interface{}{$
^I^I^I^I^I"prev_lr": *prev.Lr,$
^I^I^I^I^I"curr_lr": *cur.Lr,$
^I^I^I^I^I"step":    cur.Step,$
^I^I^I^I},$
^I^I^I^ISource: firstSource(cur),$
^I^I^I})$
^I^I}$
^I}$
^Ireturn anomalies$
}$
$
func detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {$
^Ivar anomalies []types.Anomaly$
^Ifor i := 1; i < len(entries); i++ {$
^I^Iprev := entries[i-1]$
^I^Icur := entries[i]$
^I^Iif prev.Epoch != cur.Epoch {$
^I^I^Icontinue$
^I^I}$
^I^IprevT, err1 := time.Parse(time.RFC3339, prev.Ts)$
^I^IcurT, err2 := time.Parse(time.RFC3339, cur.Ts)$
^I^Iif err1 != nil || err2 != nil {$
^I^I^Icontinue$
^I^I}$
^I^Idiff := curT.Sub(prevT).Seconds()$
^I^Iif diff > 3600 {$
^I^I^Iep := cur.Epoch$
^I^I^Ist := cur.Step$
^I^I^Ianomalies = append(anomalies, types.Anomaly{$
^I^I^I^IType:     "training_gap",$
^I^I^I^ISeverity: "low",$
^I^I^I^IEpoch:    &ep,$
^I^I^I^IStep:     &st,$
^I^I^I^IDetails: map[string]interface{}{$
^I^I^I^I^I"after_step":  prev.Step,$
^I^I^I^I^I"before_step": cur.Step,$
^I^I^I^I^I"after_ts":    prev.Ts,$
^I^I^I^I^I"before_ts":   cur.Ts,$
^I^I^I^I^I"gap_seconds": diff,$
^I^I^I^I},$
^I^I^I^ISource: firstSource(cur),$
^I^I^I})$
^I^I}$
^I}$
^Ireturn anomalies$
}$
$
