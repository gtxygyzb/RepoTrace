func severityRank(s string) int {
\tswitch s {
\tcase "critical":
\t\treturn 0
\tcase "high":
\t\treturn 1
\tcase "medium":
\t\treturn 2
\tdefault:
\t\treturn 3
\t}
}

func severityRankValue(s string) (int, bool) {
\tswitch s {
\tcase "critical":
\t\treturn 0, true
\tcase "high":
\t\treturn 1, true
\tcase "medium":
\t\treturn 2, true
\tcase "low":
\t\treturn 3, true
\tdefault:
\t\treturn 4, false
\t}
}

