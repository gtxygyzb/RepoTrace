   186				})
   187			}
   188		}
   189		return anomalies
   190	}
   191	
   192	func detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {
   193		var lossEntries []int
   194		for i, e := range entries {
   195			if e.Loss != nil {
   196				lossEntries = append(lossEntries, i)
   197			}
   198		}
   199		if len(lossEntries) < 51 {
   200			return nil
   201		}
   202		var anomalies []types.Anomaly
   203		for i := 50; i < len(lossEntries); i++ {
   204			startIdx := lossEntries[i-50]
   205			endIdx := lossEntries[i]
   206			start := *entries[startIdx].Loss
   207			end := *entries[endIdx].Loss
   208			if math.Abs(start) <= 1e-6 {
   209				continue
   210			}
   211			ratio := (end - start) / math.Abs(start)
   212			if ratio > 1.0 {
   213				severity := "high"
   214				if ratio > 5.0 {
   215					severity = "critical"
   216				}
   217				ep := entries[endIdx].Epoch
   218				st := entries[endIdx].Step
   219				anomalies = append(anomalies, types.Anomaly{
   220					Type:     "loss_divergence",
   221					Severity: severity,
   222					Epoch:    &ep,
   223					Step:     &st,
   224					Details: map[string]interface{}{
   225						"loss_start":        start,
   226						"loss_end":          end,
   227						"increase_ratio":    ratio,
   228						"window_start_step": entries[startIdx].Step,
   229						"window_end_step":   entries[endIdx].Step,
   230					},
   231					Evidence: map[string]interface{}{"window_values": precedingLossValues(entries, lossEntries, i, 5)},
   232					Source:   firstSource(entries[endIdx]),
   233				})
   234			}
   235		}
   236		return anomalies
   237	}
