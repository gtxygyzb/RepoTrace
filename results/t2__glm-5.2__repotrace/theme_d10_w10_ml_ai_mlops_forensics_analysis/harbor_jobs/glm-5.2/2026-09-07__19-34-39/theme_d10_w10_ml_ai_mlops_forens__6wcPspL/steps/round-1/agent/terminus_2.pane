    69		for i := range anomalies {
    70			anomalies[i].ID = fmt.Sprintf("ANOM-%03d", i+1)
    71		}
    72		sortAnomalies(anomalies)
    73	
    74		out.Anomalies = anomalies
    75		if out.Anomalies == nil {
    76			out.Anomalies = []types.Anomaly{}
    77		}
    78		out.Summary.Total = len(anomalies)
    79		out.Summary.BySeverity = map[string]int{"critical": 0, "high": 0, "medium": 0, "low": 0}
    80		out.Summary.ByType = map[string]int{}
    81		for _, a := range anomalies {
    82			out.Summary.BySeverity[a.Severity]++
    83			out.Summary.ByType[a.Type]++
    84		}
    85		return out, nil
    86	}
    87	
    88	func detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {
    89		var anomalies []types.Anomaly
    90		anomalies = append(anomalies, detectGradientSpikes(entries)...)
    91		anomalies = append(anomalies, detectLossDivergence(entries)...)
    92		anomalies = append(anomalies, detectLrAnomalies(entries)...)
    93		anomalies = append(anomalies, detectTrainingGaps(entries)...)
    94		anomalies = append(anomalies, detectMetricRegression(entries)...)
    95		return anomalies
    96	}
    97	
    98	func detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {
    99		var vals []float64
   100		var idx []int
   101		for i, e := range entries {
   102			if e.GradNorm != nil {
   103				vals = append(vals, *e.GradNorm)
   104				idx = append(idx, i)
   105			}
   106		}
   107		if len(vals) < 31 {
   108			return nil
   109		}
   110		var anomalies []types.Anomaly
   111		for i := 30; i < len(vals); i++ {
   112			window := vals[i-30 : i]
   113			mean := meanFloats(window)
   114			std := stddevFloats(window, mean)
   115			observed := vals[i]
   116			z := 0.0
   117			if std > 0 {
   118				z = (observed - mean) / std
   119			}
   120			if observed > mean+2.5*std && z > 2.5 {
   121				severity := "medium"
   122				if z > 4.0 {
   123					severity = "high"
   124				}
   125				ep := entries[idx[i]].Epoch
   126				st := entries[idx[i]].Step
   127				anomalies = append(anomalies, types.Anomaly{
   128					Type:     "gradient_spike",
   129					Severity: severity,
   130					Epoch:    &ep,
   131					Step:     &st,
   132					Details: map[string]interface{}{
   133						"observed":      observed,
   134						"window_mean":   mean,
   135						"window_stddev": std,
   136						"z_score":       z,
   137					},
   138					Source: firstSource(entries[idx[i]]),
   139				})
   140			}
   141		}
   142		return anomalies
   143	}
