   559	func lastValues(v []float64, n int) []float64 {
   560		if len(v) > n {
   561			v = v[len(v)-n:]
   562		}
   563		if v == nil {
   564			v = []float64{}
   565		}
   566		return v
   567	}
   568	
   569	func precedingLossValues(entries []types.TimelineEntry, indices []int, pos, n int) []float64 {
   570		vals := []float64{}
   571		start := pos - n
   572		if start < 0 {
   573			start = 0
   574		}
   575		for j := start; j < pos; j++ {
   576			if j >= 0 && j < len(indices) && entries[indices[j]].Loss != nil {
   577				vals = append(vals, *entries[indices[j]].Loss)
   578			}
   579		}
   580		return vals
   581	}
