   152	func detectCycles(nodeByHash map[string]*LineageNode, children map[string][]string) [][]string {
   153		const (
   154			white = 0
   155			gray  = 1
   156			black = 2
   157		)
   158		color := map[string]int{}
   159		stack := []string{}
   160		var cycles [][]string
   161		seen := map[string]bool{}
   162	
   163		var dfs func(u string)
   164		dfs = func(u string) {
   165			color[u] = gray
   166			stack = append(stack, u)
   167			for _, v := range children[u] {
   168				if color[v] == gray {
   169					for i := len(stack) - 1; i >= 0; i-- {
   170						if stack[i] == v {
   171							cycle := append([]string{}, stack[i:]...)
   172							sort.Strings(cycle)
   173							key := strings.Join(cycle, ",")
   174							if !seen[key] {
   175								seen[key] = true
   176								cycles = append(cycles, cycle)
   177							}
   178							break
   179						}
   180					}
