   222		if !validOps[op] {
   223			return condition{}, i, fmt.Errorf("invalid operator: %s", op)
   224		}
   225	
   226		c := condition{field: field, op: op, sval: valueTok}
   227		if field == "event" {
   228			if op != "==" && op != "!=" {
   229				return condition{}, i, fmt.Errorf("type mismatch: event only supports == or !=")
   230			}
