    55	type CheckpointFile struct {
    56		Path              string            `json:"-"`
    57		Filename          string            `json:"-"` // base filename
    58		Version           uint32            `json:"version"`
    59		Flags             uint16            `json:"-"`
    60		NumTensors        uint32            `json:"-"`
    61		NumMetadataKeys   uint32            `json:"-"`
    62		CreationTimestamp int64             `json:"-"`         // unix seconds
    63		HeaderValid       bool              `json:"-"`         // header checksum valid?
    64		FileHash          string            `json:"file_hash"` // SHA-256 hex of entire file
    65		Signed            bool              `json:"-"`
    66		Tensors           []TensorInfo      `json:"tensors"`
    67		MetadataMap       map[string]string `json:"-"` // key-value pairs from metadata section
    68		Provenance        *Provenance       `json:"-"`
    69		HasParent         bool              `json:"has_parent"`
    70		ParentHex         string            `json:"parent_hash"` // same as Provenance.ParentHash
    71	}
