   322						"actual_checksum":   fmt.Sprintf("%016x", computed),
   323					},
   324					Source:     cf.Filename,
   325					Checkpoint: cf.Filename,
   326				})
   327			}
   328	
   329			for _, t := range cf.Tensors {
   330				if !t.Valid {
   331					computed := sha256.Sum256(t.Data)
   332					anomalies = append(anomalies, types.Anomaly{
   333						Type:     "tensor_checksum_mismatch",
   334						Severity: "critical",
   335						Details: map[string]interface{}{
