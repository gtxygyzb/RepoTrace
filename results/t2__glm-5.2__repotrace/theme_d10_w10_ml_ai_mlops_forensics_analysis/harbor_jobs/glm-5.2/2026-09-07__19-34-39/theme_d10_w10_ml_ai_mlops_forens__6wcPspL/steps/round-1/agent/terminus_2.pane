   252	type VerifyCheckpoint struct {
   253		File                 string        `json:"file"`
   254		Valid                bool          `json:"valid"`
   255		HeaderChecksumValid  bool          `json:"header_checksum_valid"`
   256		TensorChecksumsValid bool          `json:"tensor_checksums_valid"`
   257		SignatureValid       *bool         `json:"signature_valid"`
   258		ProvenanceValid      bool          `json:"provenance_valid"`
   259		Issues               []VerifyIssue `json:"issues"`
   260	}
   261	
   262	type VerifyOutput struct {
   263		Status      string             `json:"status"`
   264		Checkpoints []VerifyCheckpoint `json:"checkpoints"`
   265		Summary     struct {
   266			Total   int `json:"total"`
   267			Valid   int `json:"valid"`
   268			Invalid int `json:"invalid"`
   269		} `json:"summary"`
