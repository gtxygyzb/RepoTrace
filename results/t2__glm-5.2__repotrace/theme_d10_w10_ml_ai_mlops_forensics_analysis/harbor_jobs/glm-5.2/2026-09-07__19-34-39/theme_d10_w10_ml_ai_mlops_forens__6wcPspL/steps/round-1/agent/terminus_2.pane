   134	func detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {
   135		var anomalies []types.Anomaly
   136		anomalies = append(anomalies, detectGradientSpikes(entries)...)
   137		anomalies = append(anomalies, detectLossDivergence(entries)...)
   138		anomalies = append(anomalies, detectLrAnomalies(entries)...)
   139		anomalies = append(anomalies, detectTrainingGaps(entries)...)
   140		anomalies = append(anomalies, detectMetricRegression(entries)...)
   141		return anomalies
   142	}
