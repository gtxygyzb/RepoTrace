[?2004l# Output Schemas

All commands output JSON to stdout. This document defines the exact JSON structure for each command.

---

## 1. Ingest Output

```json
{
  "status": "ok",
  "evidence_dir": "/path/to/evidence",
  "artifacts": {
    "checkpoints": [
      {
        "file": "model_epoch1.mlck",
        "file_hash": "a1b2c3...",
        "version": 1,
        "num_tensors": 12,
        "num_metadata": 3,
        "signed": false,
        "creation_timestamp": "2024-01-15T10:00:00Z",
        "provenance": {
          "epoch": 1,
          "global_step": 5000,
          "framework": "PyTorch",
          "framework_version": "2.1.0",
          "parent_hash": ""
        }
      }
    ],
    "log_shards": [
      {
        "file": "shard_001.jsonl",
        "entries": 500,
        "step_range": [0, 5000],
        "epoch_range": [0, 1],
        "time_range": ["2024-01-15T08:00:00Z", "2024-01-15T10:00:00Z"]
      }
    ],
    "configs": [
      {
        "file": "config_train.json",
        "model_name": "resnet50",
        "dataset": "imagenet-1k"
      }
    ]
  },
  "totals": {
    "checkpoints": 3,
    "log_shards": 4,
    "configs": 1
  }
}
```

**Field rules:**
- `file_hash`: SHA-256 hex of the entire `.mlck` file content.
- `checkpoints` array: sorted by `creation_timestamp` ascending.
- `log_shards` array: sorted by `file` name lexicographically.
- `configs` array: sorted by `file` name lexicographically.
- `step_range`: `[min_step, max_step]` across all entries in the shard.
- `epoch_range`: `[min_epoch, max_epoch]` across all entries.
- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.

---

## 2. Timeline Output

```json
{
  "status": "ok",
  "total_entries": 1200,
  "total_epochs": 5,
  "step_range": [0, 50000],
  "time_range": ["2024-01-15T08:00:00Z", "2024-01-17T14:00:00Z"],
  "conflicts_resolved": 3,
  "gaps": [
    {
      "after_step": 5000,
      "before_step": 5200,
      "epoch": 1,
      "gap_steps": 200,
      "after_ts": "2024-01-15T10:00:00Z",
      "before_ts": "2024-01-15T13:00:00Z"
    }
  ],
  "entries": [
    {
      "ts": "2024-01-15T08:00:00Z",
      "epoch": 0,
      "step": 0,
      "loss": 6.9078,
      "lr": 0.001,
      "grad_norm": 12.34,
      "acc": 0.001,
      "event": "step",
      "sources": ["shard_001.jsonl"],
      "conflict": false
    }
  ]
}
```

**Field rules:**
- `entries`: sorted by `(epoch ASC, step ASC)`.
- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.
- `conflict`: `true` if this entry was chosen by conflict resolution.
- `gaps`: only gaps where `gap_steps > 100` within the same epoch.
- Entries with missing optional fields omit them from the JSON (do not include null).

---

## 3. Verify Output

```json
{
  "status": "ok",
  "checkpoints": [
    {
      "file": "model_epoch1.mlck",
      "valid": true,
      "header_checksum_valid": true,
      "tensor_checksums_valid": true,
      "signature_valid": null,
      "provenance_valid": true,
      "issues": []
    },
    {
      "file": "model_epoch3.mlck",
      "valid": false,
      "header_checksum_valid": true,
      "tensor_checksums_valid": false,
      "signature_valid": true,
      "provenance_valid": true,
      "issues": [
        {"type": "tensor_checksum_mismatch", "detail": "encoder.layer2.weight"}
      ]
    }
  ],
  "summary": {
    "total": 3,
    "valid": 2,
    "invalid": 1
  }
}
```

**Field rules:**
- `checkpoints`: sorted by `file` name lexicographically.
- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.
- `issues`: list of issue objects with `type` (string) and `detail` (string). For example, a tensor checksum mismatch appears as `{"type": "tensor_checksum_mismatch", "detail": "<tensor_name>"}`.
- `valid`: `true` only if all applicable checks pass.

---

## 4. Detect Output

```json
{
  "status": "ok",
  "anomalies": [
    {
      "id": "ANOM-001",
      "type": "gradient_spike",
      "severity": "high",
      "epoch": 2,
      "step": 3456,
      "details": {
        "observed": 15.3,
        "window_mean": 1.2,
        "window_stddev": 0.3,
        "z_score": 47.0
      },
      "evidence": {
        "window_values": [1.1, 1.3, 1.0, 1.2, 1.4]
      },
      "source": "shard_002.jsonl"
    },
    {
      "id": "ANOM-002",
      "type": "tensor_checksum_mismatch",
      "severity": "critical",
      "details": {
        "file": "model_epoch3.mlck",
        "tensor_name": "encoder.layer2.weight",
        "expected_checksum": "abcd1234...",
        "actual_checksum": "efgh5678..."
      },
      "evidence": {},
      "source": "model_epoch3.mlck",
      "checkpoint": "model_epoch3.mlck"
    }
  ],
  "summary": {
    "total": 5,
    "by_severity": {
      "critical": 1,
      "high": 2,
      "medium": 1,
      "low": 1
    },
    "by_type": {
      "gradient_spike": 1,
      "loss_divergence": 1,
      "tensor_checksum_mismatch": 1,
      "training_gap": 1,
      "lr_anomaly": 1
    }
  }
}
```

**Field rules:**
- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.
- `anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.
- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.
- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.
- `evidence`: sibling of `id`, `type`, `severity`, `details`, and `source`; never nested inside `details`. Timeline-based anomalies include `window_values`, an array of up to 5 preceding metric values at the point of anomaly detection. `gradient_spike` uses preceding `grad_norm` values, `loss_divergence` uses preceding `loss` values, and other timeline-based anomalies may use an empty array when no meaningful preceding window is available. Checkpoint-based anomalies, such as `tensor_checksum_mismatch`, must have an empty evidence object: `{}`.
- `source`: the artifact file where the anomaly was detected.
- `epoch` and `step`: present only for timeline-based anomalies.
- `checkpoint`: present when the anomaly is related to a specific checkpoint file; omitted for timeline-based anomalies that are not checkpoint-specific.
- `summary`: reflects the filtered anomaly list when `--filter-severity` is supplied.
- If no anomalies are detected, `anomalies` is an empty array.

### Detect CSV Output

When `--format csv` is used with `detect`, the command outputs CSV instead of JSON. The CSV header is exactly:

```text
id,type,severity,epoch,step,source,checkpoint
```

One header row is followed by one data row per anomaly. Each data row has 7 comma-separated fields in that order. Leave `epoch`, `step`, or `checkpoint` empty when the anomaly does not have that field. Severity filtering with `--filter-severity LEVEL` applies before CSV output, so the rows reflect only the filtered anomaly list.

---

## 5. Lineage Output

```json
{
  "status": "ok",
  "nodes": [
    {
      "file": "model_epoch1.mlck",
      "file_hash": "a1b2c3...",
      "epoch": 1,
      "global_step": 5000,
      "creation_timestamp": "2024-01-15T10:00:00Z",
      "parent_hash": "",
      "is_root": true,
      "is_leaf": false,
      "is_orphan": false
    }
  ],
  "edges": [
    {
      "from": "a1b2c3...",
      "to": "d4e5f6...",
      "from_file": "model_epoch1.mlck",
      "to_file": "model_epoch2.mlck"
    }
  ],
  "roots": ["a1b2c3..."],
  "leaves": ["g7h8i9..."],
  "orphans": [],
  "topological_order": ["a1b2c3...", "d4e5f6...", "g7h8i9..."],
  "cycles": []
}
```

**Field rules:**
- `nodes`: sorted by `creation_timestamp` ascending.
- `edges`: sorted by `from` hash then `to` hash lexicographically.
- `roots`: file hashes of root nodes (no parent), sorted.
- `leaves`: file hashes of leaf nodes (no children), sorted.
- `orphans`: file hashes of orphan nodes (parent not found), sorted.
- `topological_order`: valid topological sort of non-orphan nodes, ties broken by `creation_timestamp`.
- `cycles`: if cycles exist, each cycle is a list of file hashes. Empty if DAG is valid.

[?2004hroot@n30009:/app# sed -n '1,680p' internal/forensics/detect.go
[?2004lpackage forensics

import (
	"crypto/hmac"
	"crypto/sha256"
	"encoding/binary"
	"encoding/hex"
	"fmt"
	"hash/fnv"
	"math"
	"os"
	"sort"
	"time"

	"mlforge/internal/checkpoint"
	"mlforge/internal/types"
)

func loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {
	ap, err := DiscoverArtifacts(dir)
	if err != nil {
		return nil, err
	}
	var cps []*types.CheckpointFile
	for _, p := range ap.Checkpoints {
		cf, err := checkpoint.Parse(p)
		if err != nil || cf == nil {
			continue
		}
		cps = append(cps, cf)
	}
	sort.Slice(cps, func(i, j int) bool {
		return cps[i].Filename < cps[j].Filename
	})
	return cps, nil
}

type DetectOutput struct {
	Status    string          `json:"status"`
	Anomalies []types.Anomaly `json:"anomalies"`
	Summary   struct {
		Total      int            `json:"total"`
		BySeverity map[string]int `json:"by_severity"`
		ByType     map[string]int `json:"by_type"`
	} `json:"summary"`
}

func BuildDetect(dir string) (interface{}, error) {
	return BuildDetectFiltered(dir, "")
}

func BuildDetectFiltered(dir, filterSeverity string) (DetectOutput, error) {
	var out DetectOutput
	out.Status = "ok"
	var anomalies []types.Anomaly

	entries, _, err := loadTimelineEntries(dir)
	if err == nil {
		merged, _ := mergeTimeline(entries)
		sortTimeline(merged)
		anomalies = append(anomalies, detectTimelineAnomalies(merged)...)
	}

	cps, err := loadCheckpoints(dir)
	if err == nil {
		anomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)
	}

	if filterSeverity != "" {
		wantedRank, ok := severityRankValue(filterSeverity)
		if !ok {
			return out, fmt.Errorf("invalid severity level %q: must be critical, high, medium, or low", filterSeverity)
		}
		filtered := anomalies[:0]
		for _, a := range anomalies {
			if severityRank(a.Severity) <= wantedRank {
				filtered = append(filtered, a)
			}
		}
		anomalies = filtered
	}

	for i := range anomalies {
		anomalies[i].ID = fmt.Sprintf("ANOM-%03d", i+1)
	}
	sortAnomalies(anomalies)

	out.Anomalies = anomalies
	if out.Anomalies == nil {
		out.Anomalies = []types.Anomaly{}
	}
	out.Summary.Total = len(anomalies)
	out.Summary.BySeverity = map[string]int{"critical": 0, "high": 0, "medium": 0, "low": 0}
	out.Summary.ByType = map[string]int{}
	for _, a := range anomalies {
		out.Summary.BySeverity[a.Severity]++
		out.Summary.ByType[a.Type]++
	}
	return out, nil
}

func severityRank(s string) int {
	switch s {
	case "critical":
		return 0
	case "high":
		return 1
	case "medium":
		return 2
	default:
		return 3
	}
}

func severityRankValue(s string) (int, bool) {
	switch s {
	case "critical":
		return 0, true
	case "high":
		return 1, true
	case "medium":
		return 2, true
	case "low":
		return 3, true
	default:
		return 4, false
	}
}

func detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {
	var anomalies []types.Anomaly
	anomalies = append(anomalies, detectGradientSpikes(entries)...)
	anomalies = append(anomalies, detectLossDivergence(entries)...)
	anomalies = append(anomalies, detectLrAnomalies(entries)...)
	anomalies = append(anomalies, detectTrainingGaps(entries)...)
	anomalies = append(anomalies, detectMetricRegression(entries)...)
	return anomalies
}

func detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {
	var vals []float64
	var idx []int
	for i, e := range entries {
		if e.GradNorm != nil {
			vals = append(vals, *e.GradNorm)
			idx = append(idx, i)
		}
	}
	if len(vals) < 31 {
		return nil
	}
	var anomalies []types.Anomaly
	for i := 30; i < len(vals); i++ {
		window := vals[i-30 : i]
		mean := meanFloats(window)
		std := stddevFloats(window, mean)
		observed := vals[i]
		z := 0.0
		if std > 0 {
			z = (observed - mean) / std
		}
		if observed > mean+2.5*std && z > 2.5 {
			severity := "medium"
			if z > 4.0 {
				severity = "high"
			}
			ep := entries[idx[i]].Epoch
			st := entries[idx[i]].Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "gradient_spike",
				Severity: severity,
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"observed":      observed,
					"window_mean":   mean,
					"window_stddev": std,
					"z_score":       z,
				},
				Evidence: map[string]interface{}{"window_values": lastValues(window, 5)},
				Source:   firstSource(entries[idx[i]]),
			})
		}
	}
	return anomalies
}

func detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {
	var lossEntries []int
	for i, e := range entries {
		if e.Loss != nil {
			lossEntries = append(lossEntries, i)
		}
	}
	if len(lossEntries) < 51 {
		return nil
	}
	var anomalies []types.Anomaly
	for i := 50; i < len(lossEntries); i++ {
		startIdx := lossEntries[i-50]
		endIdx := lossEntries[i]
		start := *entries[startIdx].Loss
		end := *entries[endIdx].Loss
		if math.Abs(start) <= 1e-6 {
			continue
		}
		ratio := (end - start) / math.Abs(start)
		if ratio > 1.0 {
			severity := "high"
			if ratio > 5.0 {
				severity = "critical"
			}
			ep := entries[endIdx].Epoch
			st := entries[endIdx].Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "loss_divergence",
				Severity: severity,
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"loss_start":        start,
					"loss_end":          end,
					"increase_ratio":    ratio,
					"window_start_step": entries[startIdx].Step,
					"window_end_step":   entries[endIdx].Step,
				},
				Evidence: map[string]interface{}{"window_values": precedingLossValues(entries, lossEntries, i, 5)},
				Source:   firstSource(entries[endIdx]),
			})
		}
	}
	return anomalies
}

func detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {
	var anomalies []types.Anomaly
	for i := 1; i < len(entries); i++ {
		prev := entries[i-1]
		cur := entries[i]
		if prev.Lr == nil || cur.Lr == nil {
			continue
		}
		if *cur.Lr > *prev.Lr {
			if cur.Event == "epoch_end" {
				continue
			}
			ep := cur.Epoch
			st := cur.Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "lr_anomaly",
				Severity: "medium",
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"prev_lr": *prev.Lr,
					"curr_lr": *cur.Lr,
					"step":    cur.Step,
				},
				Evidence: map[string]interface{}{"window_values": []float64{}},
				Source:   firstSource(cur),
			})
		}
	}
	return anomalies
}

func detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {
	var anomalies []types.Anomaly
	for i := 1; i < len(entries); i++ {
		prev := entries[i-1]
		cur := entries[i]
		if prev.Epoch != cur.Epoch {
			continue
		}
		prevT, err1 := time.Parse(time.RFC3339, prev.Ts)
		curT, err2 := time.Parse(time.RFC3339, cur.Ts)
		if err1 != nil || err2 != nil {
			continue
		}
		diff := curT.Sub(prevT).Seconds()
		if diff > 3600 {
			ep := cur.Epoch
			st := cur.Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "training_gap",
				Severity: "low",
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"after_step":  prev.Step,
					"before_step": cur.Step,
					"after_ts":    prev.Ts,
					"before_ts":   cur.Ts,
					"gap_seconds": diff,
				},
				Evidence: map[string]interface{}{"window_values": []float64{}},
				Source:   firstSource(cur),
			})
		}
	}
	return anomalies
}

func detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {
	var cps []types.TimelineEntry
	for _, e := range entries {
		if e.Event == "checkpoint" {
			cps = append(cps, e)
		}
	}
	sortTimeline(cps)
	var anomalies []types.Anomaly
	for i := 1; i < len(cps); i++ {
		prev := cps[i-1]
		cur := cps[i]
		if prev.Acc == nil || cur.Acc == nil {
			continue
		}
		drop := *prev.Acc - *cur.Acc
		if drop > 0.15 {
			ep := cur.Epoch
			st := cur.Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "metric_regression",
				Severity: "high",
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"prev_acc":        *prev.Acc,
					"curr_acc":        *cur.Acc,
					"drop":            drop,
					"prev_checkpoint": prev.Step,
					"curr_checkpoint": cur.Step,
				},
				Evidence: map[string]interface{}{"window_values": []float64{}},
				Source:   firstSource(cur),
			})
		}
	}
	return anomalies
}

func detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {
	var anomalies []types.Anomaly
	hashSet := map[string]*types.CheckpointFile{}
	for _, cf := range cps {
		hashSet[cf.FileHash] = cf
	}

	for _, cf := range cps {
		raw, err := os.ReadFile(cf.Path)
		if err != nil {
			continue
		}
		if !cf.HeaderValid {
			stored := uint64(0)
			if len(raw) >= 56 {
				stored = binary.LittleEndian.Uint64(raw[48:56])
			}
			h := fnv.New64a()
			h.Write(raw[:48])
			computed := h.Sum64()
			anomalies = append(anomalies, types.Anomaly{
				Type:     "header_checksum_mismatch",
				Severity: "critical",
				Details: map[string]interface{}{
					"file":              cf.Filename,
					"expected_checksum": fmt.Sprintf("%016x", stored),
					"actual_checksum":   fmt.Sprintf("%016x", computed),
				},
				Evidence:   map[string]interface{}{},
				Source:     cf.Filename,
				Checkpoint: cf.Filename,
			})
		}

		for _, t := range cf.Tensors {
			if !t.Valid {
				computed := sha256.Sum256(t.Data)
				anomalies = append(anomalies, types.Anomaly{
					Type:     "tensor_checksum_mismatch",
					Severity: "critical",
					Details: map[string]interface{}{
						"file":              cf.Filename,
						"tensor_name":       t.Name,
						"expected_checksum": hex.EncodeToString(t.Hash[:]),
						"actual_checksum":   hex.EncodeToString(computed[:]),
					},
					Evidence:   map[string]interface{}{},
					Source:     cf.Filename,
					Checkpoint: cf.Filename,
				})
			}
		}

		if cf.Signed {
			valid, signer := signatureDetails(cf.Path)
			if !valid {
				anomalies = append(anomalies, types.Anomaly{
					Type:     "signature_invalid",
					Severity: "critical",
					Details: map[string]interface{}{
						"file":      cf.Filename,
						"signer_id": signer,
						"valid":     false,
					},
					Evidence:   map[string]interface{}{},
					Source:     cf.Filename,
					Checkpoint: cf.Filename,
				})
			}
		}

		if cf.Provenance != nil && cf.Provenance.ParentHash != "" {
			_, found := hashSet[cf.Provenance.ParentHash]
			if !found {
				anomalies = append(anomalies, types.Anomaly{
					Type:     "provenance_chain_break",
					Severity: "high",
					Details: map[string]interface{}{
						"file":        cf.Filename,
						"parent_hash": cf.Provenance.ParentHash,
						"found":       false,
					},
					Evidence:   map[string]interface{}{},
					Source:     cf.Filename,
					Checkpoint: cf.Filename,
				})
			}
		}
	}

	anomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)
	return anomalies
}

func detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {
	byHash := map[string]*types.CheckpointFile{}
	for _, cf := range cps {
		byHash[cf.FileHash] = cf
	}
	children := map[string][]string{}
	for _, cf := range cps {
		if cf.Provenance != nil && cf.Provenance.ParentHash != "" {
			if _, ok := byHash[cf.Provenance.ParentHash]; ok {
				children[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)
			}
		}
	}

	var anomalies []types.Anomaly
	seen := map[string]bool{}
	for _, cf := range cps {
		if cf.Provenance == nil {
			continue
		}
		root := cf.FileHash
		for root != "" {
			parent, ok := byHash[root]
			if !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == "" {
				break
			}
			root = parent.Provenance.ParentHash
		}
		if seen[root] {
			continue
		}
		seen[root] = true

		chain := []string{}
		queue := []string{root}
		visited := map[string]bool{}
		for len(queue) > 0 {
			cur := queue[0]
			queue = queue[1:]
			if visited[cur] {
				continue
			}
			visited[cur] = true
			node, ok := byHash[cur]
			if !ok || node == nil {
				continue
			}
			chain = append(chain, node.Filename)
			queue = append(queue, children[cur]...)
		}
		sort.Strings(chain)

		hashes := map[string]struct{}{}
		for _, h := range chain {
			if node, ok := byHashFile(cps, h); ok && node.Provenance != nil {
				hashes[node.Provenance.DatasetHash] = struct{}{}
			}
		}
		if len(hashes) > 1 {
			unique := make([]string, 0, len(hashes))
			for h := range hashes {
				unique = append(unique, h)
			}
			sort.Strings(unique)
			anomalies = append(anomalies, types.Anomaly{
				Type:     "dataset_hash_inconsistency",
				Severity: "high",
				Details: map[string]interface{}{
					"files":  chain,
					"hashes": unique,
				},
				Evidence: map[string]interface{}{},
				Source:   chain[0],
			})
		}
	}
	return anomalies
}

func byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {
	for _, cf := range cps {
		if cf.Filename == file {
			return cf, true
		}
	}
	return nil, false
}

func signatureDetails(path string) (bool, string) {
	raw, err := os.ReadFile(path)
	if err != nil || len(raw) < 56 {
		return false, ""
	}
	sigOff := binary.LittleEndian.Uint64(raw[32:40])
	if sigOff == 0 || int(sigOff) >= len(raw) || int(sigOff)+5 > len(raw) {
		return false, ""
	}
	off := int(sigOff)
	off++ // algorithm
	signerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
	off += 2
	if off+signerLen+2 > len(raw) {
		return false, ""
	}
	signerID := string(raw[off : off+signerLen])
	off += signerLen
	sigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
	off += 2
	if off+sigLen > len(raw) {
		return false, signerID
	}
	stored := raw[off : off+sigLen]
	mac := hmac.New(sha256.New, []byte(signerID))
	mac.Write(raw[:sigOff])
	expected := mac.Sum(nil)
	return hmac.Equal(expected, stored), signerID
}

func lastValues(v []float64, n int) []float64 {
	if len(v) > n {
		v = v[len(v)-n:]
	}
	if v == nil {
		v = []float64{}
	}
	return v
}

func precedingLossValues(entries []types.TimelineEntry, indices []int, pos, n int) []float64 {
	vals := []float64{}
	start := pos - n
	if start < 0 {
		start = 0
	}
	for j := start; j < pos; j++ {
		if j >= 0 && j < len(indices) && entries[indices[j]].Loss != nil {
			vals = append(vals, *entries[indices[j]].Loss)
		}
	}
	return vals
}

func firstSource(e types.TimelineEntry) string {
	if len(e.Sources) > 0 {
		return e.Sources[0]
	}
	return ""
}

func meanFloats(v []float64) float64 {
	if len(v) == 0 {
		return 0
	}
	s := 0.0
	for _, x := range v {
		s += x
	}
	return s / float64(len(v))
}

func stddevFloats(v []float64, mean float64) float64 {
	if len(v) == 0 {
		return 0
	}
	s := 0.0
	for _, x := range v {
		d := x - mean
		s += d * d
	}
	return math.Sqrt(s / float64(len(v)))
}

func sortAnomalies(a []types.Anomaly) {
	rank := map[string]int{"critical": 0, "high": 1, "medium": 2, "low": 3}
	sort.Slice(a, func(i, j int) bool {
		ri := rank[a[i].Severity]
		rj := rank[a[j].Severity]
		if ri != rj {
			return ri < rj
		}
		ei := -1
		ej := -1
		if a[i].Epoch != nil {
			ei = *a[i].Epoch
		}
		ej = -1
		if a[j].Epoch != nil {
			ej = *a[j].Epoch
		}
		if ei != ej {
			return ei < ej
		}
		si := -1
		if a[i].Step != nil {
			si = *a[i].Step
		}
		sj := -1
		if a[j].Step != nil {
			sj = *a[j].Step
		}
		return si < sj
	})
}
