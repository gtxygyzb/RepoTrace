[?2004hroot@n30009:/app# sed -n '1,260p' internal/checkpoint/parser.go
[?2004lpackage checkpoint

import (
	"crypto/sha256"
	"encoding/binary"
	"encoding/hex"
	"fmt"
	"hash/fnv"
	"math"
	"os"
	"path/filepath"
	"strings"

	"mlforge/internal/types"
)

const (
	magicMLCK  = "MLCK"
	headerSize = 56
)

// Parse reads and validates a single .mlck checkpoint file according to the
// MLCK binary format specification (see /app/docs/formats.md).
func Parse(path string) (*types.CheckpointFile, error) {
	raw, err := os.ReadFile(path)
	if err != nil {
		return nil, fmt.Errorf("checkpoint: read %s: %w", path, err)
	}
	if len(raw) < headerSize {
		return nil, fmt.Errorf("checkpoint: file too small (%d bytes)", len(raw))
	}

	// --- magic (offset 0, 4 bytes) ---
	if string(raw[0:4]) != magicMLCK {
		return nil, fmt.Errorf("checkpoint: bad magic %q", raw[0:4])
	}

	// --- header fields ---
	version := binary.LittleEndian.Uint16(raw[4:6])
	flags := binary.LittleEndian.Uint16(raw[6:8])
	numTensors := binary.LittleEndian.Uint32(raw[8:12])
	numMetadata := binary.LittleEndian.Uint32(raw[12:16])
	metadataOffset := binary.LittleEndian.Uint64(raw[16:24])
	provenanceOffset := binary.LittleEndian.Uint64(raw[24:32])
	_ = binary.LittleEndian.Uint64(raw[32:40]) // signatureOffset (unused for now)
	creationTimestamp := int64(binary.LittleEndian.Uint64(raw[40:48]))
	storedChecksum := binary.LittleEndian.Uint64(raw[48:56])

	// --- verify header checksum: FNV-1a of bytes [0..48) ---
	h := fnv.New64a()
	h.Write(raw[:48])
	computedChecksum := h.Sum64()
	headerValid := computedChecksum == storedChecksum

	// --- SHA-256 file hash ---
	fileHashBytes := sha256.Sum256(raw)
	fileHash := hex.EncodeToString(fileHashBytes[:])

	signed := flags&1 != 0

	cf := &types.CheckpointFile{
		Path:              path,
		Filename:          filepath.Base(path),
		Version:           uint32(version),
		Flags:             flags,
		NumTensors:        numTensors,
		NumMetadataKeys:   numMetadata,
		CreationTimestamp:  creationTimestamp,
		HeaderValid:       headerValid,
		FileHash:          fileHash,
		Signed:            signed,
	}

	// --- parse tensor blocks (start at offset 56) ---
	off := headerSize
	tensors := make([]types.TensorInfo, 0, numTensors)
	for i := uint32(0); i < numTensors; i++ {
		ti, newOff, err := parseTensor(raw, off, i)
		if err != nil {
			return nil, err
		}
		tensors = append(tensors, ti)
		off = newOff
	}
	cf.Tensors = tensors

	// --- parse metadata section ---
	if numMetadata > 0 && metadataOffset > 0 && int(metadataOffset) < len(raw) {
		md, err := parseMetadata(raw, int(metadataOffset), numMetadata)
		if err == nil {
			cf.MetadataMap = md
		}
	}

	// --- parse provenance section ---
	if provenanceOffset > 0 && int(provenanceOffset) < len(raw) {
		prov, err := parseProvenance(raw, int(provenanceOffset))
		if err == nil {
			cf.Provenance = prov
			cf.HasParent = prov.ParentHash != ""
			cf.ParentHex = prov.ParentHash
		}
	}

	return cf, nil
}

// parseTensor parses one tensor block starting at off and returns the
// TensorInfo plus the new offset after the block.
func parseTensor(raw []byte, off int, idx uint32) (types.TensorInfo, int, error) {
	fail := func(msg string) (types.TensorInfo, int, error) {
		return types.TensorInfo{}, 0, fmt.Errorf("checkpoint: tensor %d: %s", idx, msg)
	}

	// name_len (uint16 LE)
	if off+2 > len(raw) {
		return fail("unexpected EOF reading name_len")
	}
	nameLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
	off += 2

	// name
	if off+nameLen > len(raw) {
		return fail("unexpected EOF reading name")
	}
	name := string(raw[off : off+nameLen])
	off += nameLen

	// dtype (1 byte)
	if off+1 > len(raw) {
		return fail("unexpected EOF reading dtype")
	}
	dtype := raw[off]
	off++

	// num_dims (1 byte)
	if off+1 > len(raw) {
		return fail("unexpected EOF reading num_dims")
	}
	numDims := int(raw[off])
	off++

	// shape (num_dims * uint32 LE)
	shapeBytes := numDims * 4
	if off+shapeBytes > len(raw) {
		return fail("unexpected EOF reading shape")
	}
	shape := make([]uint32, numDims)
	for d := 0; d < numDims; d++ {
		shape[d] = binary.LittleEndian.Uint32(raw[off : off+4])
		off += 4
	}

	// data_size (uint64 LE)
	if off+8 > len(raw) {
		return fail("unexpected EOF reading data_size")
	}
	dataSize := binary.LittleEndian.Uint64(raw[off : off+8])
	off += 8

	// data
	if off+int(dataSize) > len(raw) {
		return fail("unexpected EOF reading data")
	}
	data := raw[off : off+int(dataSize)]
	off += int(dataSize)

	// hash (32 bytes SHA-256)
	if off+32 > len(raw) {
		return fail("unexpected EOF reading hash")
	}
	var storedHash [32]byte
	copy(storedHash[:], raw[off:off+32])
	off += 32

	// verify SHA-256
	computedHash := sha256.Sum256(data)
	valid := computedHash == storedHash

	return types.TensorInfo{
		Name:  name,
		Dtype: dtype,
		Shape: shape,
		Data:  data,
		Hash:  storedHash,
		Valid: valid,
	}, off, nil
}

// parseMetadata parses the metadata section: numMeta key-value pairs.
func parseMetadata(raw []byte, off int, numMeta uint32) (map[string]string, error) {
	md := make(map[string]string, numMeta)
	for i := uint32(0); i < numMeta; i++ {
		// key_len (uint16)
		if off+2 > len(raw) {
			return md, fmt.Errorf("metadata: unexpected EOF at key_len %d", i)
		}
		keyLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
		off += 2

		if off+keyLen > len(raw) {
			return md, fmt.Errorf("metadata: unexpected EOF at key %d", i)
		}
		key := string(raw[off : off+keyLen])
		off += keyLen

		// value_len (uint32)
		if off+4 > len(raw) {
			return md, fmt.Errorf("metadata: unexpected EOF at value_len %d", i)
		}
		valLen := int(binary.LittleEndian.Uint32(raw[off : off+4]))
		off += 4

		if off+valLen > len(raw) {
			return md, fmt.Errorf("metadata: unexpected EOF at value %d", i)
		}
		val := string(raw[off : off+valLen])
		off += valLen

		md[key] = val
	}
	return md, nil
}

// parseProvenance parses the provenance section.
func parseProvenance(raw []byte, off int) (*types.Provenance, error) {
	p := &types.Provenance{}

	// GitCommit: 40 bytes ASCII
	if off+40 > len(raw) {
		return nil, fmt.Errorf("provenance: unexpected EOF at git_commit")
	}
	p.GitCommit = strings.TrimRight(string(raw[off:off+40]), "\x00")
	off += 40

	// DatasetHash: 32 bytes raw → hex
	if off+32 > len(raw) {
		return nil, fmt.Errorf("provenance: unexpected EOF at dataset_hash")
	}
	p.DatasetHash = hex.EncodeToString(raw[off : off+32])
	off += 32

	// ConfigHash: 32 bytes raw → hex
	if off+32 > len(raw) {
		return nil, fmt.Errorf("provenance: unexpected EOF at config_hash")
	}
	p.ConfigHash = hex.EncodeToString(raw[off : off+32])
	off += 32

	// TrainingTimestamp: int64
	if off+8 > len(raw) {
		return nil, fmt.Errorf("provenance: unexpected EOF at training_timestamp")
	}
	p.TrainingTimestamp = int64(binary.LittleEndian.Uint64(raw[off : off+8]))
	off += 8

	// TrainingDuration: float64
	if off+8 > len(raw) {
		return nil, fmt.Errorf("provenance: unexpected EOF at training_duration")
	}
[?2004hroot@n30009:/app# for f in docs/analysis_rules.md docs/spec.md docs/output_schema.md; do echo "===== $f"; nl -ba "$f" | sed -n '1,260p'; done
[?2004l===== docs/analysis_rules.md
     1	# Analysis Rules and Query Language
     2	
     3	## 1. Timeline Reconstruction
     4	
     5	### 1.1 Merge Algorithm
     6	
     7	Given multiple `.jsonl` shard files, the timeline is reconstructed as follows:
     8	
     9	1. **Parse**: Read all entries from all shard files. Skip malformed JSON lines.
    10	2. **Deduplicate**: Entries are keyed by `(epoch, step)`. When multiple entries share the same key:
    11	   - If all numeric metric values (loss, lr, grad_norm, acc) are identical (within 1e-9 tolerance), keep one copy.
    12	   - If values differ, this is a **conflict**. Resolution: keep the entry with the **latest** `ts` timestamp. Record the conflict.
    13	3. **Sort**: Sort the unified timeline by `(epoch ASC, step ASC)`.
    14	4. **Gap Detection**: A gap exists when consecutive entries (after sorting) satisfy:
    15	   - Same epoch: `step_diff = next.step - curr.step > 1` AND `step_diff > 100`
    16	   - Cross-epoch boundary: not a gap (step resets are normal at epoch boundaries)
    17	
    18	### 1.2 Timeline Entry Output
    19	
    20	After merge, each entry in the timeline has:
    21	- All original fields from the winning entry
    22	- An additional `"sources"` array listing which shard files contained this `(epoch, step)`
    23	- If this entry was a conflict resolution, an additional `"conflict": true` field
    24	
    25	---
    26	
    27	## 2. Anomaly Detection Rules
    28	
    29	Anomalies are classified by severity: `critical`, `high`, `medium`, `low`.
    30	
    31	### 2.1 Gradient Norm Spike
    32	
    33	- **Window**: Sliding window of 50 steps
    34	- **Method**: Compute mean and standard deviation of `grad_norm` over the window
    35	- **Trigger**: `grad_norm > mean + 3.0 * stddev` (Z-score > 3.0)
    36	- **Severity**: `high` if Z-score > 5.0, else `medium`
    37	- **Required data**: At least 50 entries with `grad_norm` before detection begins
    38	- **Output fields**: `observed`, `window_mean`, `window_stddev`, `z_score`
    39	
    40	### 2.2 Loss Divergence
    41	
    42	- **Window**: Sliding window of 50 steps
    43	- **Method**: Compare loss at window start vs window end
    44	- **Trigger**: `(loss_end - loss_start) / |loss_start| > 1.0` (>100% increase)
    45	- **Severity**: `critical` if increase > 5.0 (500%), else `high`
    46	- **Guard**: Only trigger if `|loss_start| > 1e-6` (avoid division by near-zero)
    47	- **Output fields**: `loss_start`, `loss_end`, `increase_ratio`, `window_start_step`, `window_end_step`
    48	
    49	### 2.3 Learning Rate Anomaly
    50	
    51	- **Method**: Analyze the sequence of `lr` values across sorted timeline
    52	- **Trigger**: `lr` increases between consecutive entries UNLESS:
    53	  - The increase coincides with an `epoch_end` event (warmup restart pattern)
    54	  - The increase is the first entry (no previous to compare)
    55	- **Severity**: `medium`
    56	- **Output fields**: `prev_lr`, `curr_lr`, `step`
    57	
    58	### 2.4 Metric Regression
    59	
    60	- **Scope**: Between consecutive checkpoints (entries with `event == "checkpoint"` or between .mlck files sorted by epoch/step)
    61	- **Trigger**: `acc` drops by more than 0.15 (absolute, not relative) between consecutive checkpoints
    62	- **Severity**: `high`
    63	- **Output fields**: `prev_acc`, `curr_acc`, `drop`, `prev_checkpoint`, `curr_checkpoint`
    64	
    65	### 2.5 Checkpoint Integrity - Tensor Checksum
    66	
    67	- **Method**: For each tensor in a `.mlck` file, compute SHA-256 of the data bytes and compare with stored checksum
    68	- **Trigger**: Mismatch
    69	- **Severity**: `critical`
    70	- **Output fields**: `file`, `tensor_name`, `expected_checksum` (hex), `actual_checksum` (hex)
    71	
    72	### 2.6 Checkpoint Integrity - Header Checksum
    73	
    74	- **Method**: Compute FNV-1a 64-bit of bytes [0..48) and compare with stored value at offset 48
    75	- **Trigger**: Mismatch
    76	- **Severity**: `critical`
    77	- **Output fields**: `file`, `expected_checksum` (hex), `actual_checksum` (hex)
    78	
    79	### 2.7 Checkpoint Integrity - Signature
    80	
    81	- **Method**: For signed checkpoints (Flags bit 0), compute HMAC-SHA256 of bytes [0..SignatureOffset) using SignerId as key, compare with stored signature
    82	- **Trigger**: Mismatch
    83	- **Severity**: `critical`
    84	- **Output fields**: `file`, `signer_id`, `valid` (bool)
    85	
    86	### 2.8 Provenance Chain Break
    87	
    88	- **Method**: For each checkpoint with a non-empty `parent_hash`, verify that a checkpoint with that file hash exists in the evidence set
    89	- **Trigger**: Parent checkpoint not found
    90	- **Severity**: `high`
    91	- **Output fields**: `file`, `parent_hash`, `found` (bool)
    92	
    93	### 2.9 Training Gap
    94	
    95	- **Method**: Consecutive timeline entries (after merge sort) have timestamps more than 2 hours apart
    96	- **Trigger**: `time_diff > 7200 seconds` between consecutive entries within the same epoch
    97	- **Severity**: `low`
    98	- **Output fields**: `after_step`, `before_step`, `after_ts`, `before_ts`, `gap_seconds`
    99	
   100	### 2.10 Dataset Hash Inconsistency
   101	
   102	- **Method**: Compare `DatasetHash` across all checkpoints in the same lineage chain
   103	- **Trigger**: Different `DatasetHash` values within the same chain
   104	- **Severity**: `high`
   105	- **Output fields**: `files`, `hashes` (list of unique hex hashes)
   106	
   107	---
   108	
   109	## 3. Query Language
   110	
   111	### 3.1 Grammar
   112	
   113	```
   114	query      := condition (BOOL_OP condition)*
   115	condition  := field COMP_OP value
   116	BOOL_OP    := "AND" | "OR"
   117	COMP_OP    := ">" | "<" | ">=" | "<=" | "==" | "!="
   118	field      := "step" | "epoch" | "loss" | "lr" | "grad_norm" | "acc" | "event" | "ts"
   119	value      := NUMBER | QUOTED_STRING | TIMESTAMP
   120	NUMBER     := integer or float literal
   121	QUOTED_STRING := '"' ... '"' (double-quoted string)
   122	TIMESTAMP  := ISO 8601 format (e.g., 2024-01-15T10:30:00Z)
   123	```
   124	
   125	### 3.2 Operator Precedence
   126	
   127	- `AND` binds tighter than `OR`
   128	- Parentheses are NOT supported (keep the grammar simple)
   129	- Evaluation: left to right with AND having higher precedence
   130	
   131	Example: `loss > 1.0 OR grad_norm > 5.0 AND epoch == 3`
   132	Parses as: `loss > 1.0 OR (grad_norm > 5.0 AND epoch == 3)`
   133	
   134	### 3.3 Type Rules
   135	
   136	- `step`, `epoch`: integer comparisons
   137	- `loss`, `lr`, `grad_norm`, `acc`: float comparisons (tolerance 1e-9 for `==`)
   138	- `event`: string comparisons (`==`, `!=` only)
   139	- `ts`: timestamp comparisons (parse both sides as time, compare chronologically)
   140	
   141	### 3.4 Output
   142	
   143	JSON array of matching timeline entries (after reconstruction), sorted by `(epoch ASC, step ASC)`.
   144	
   145	### 3.5 Error Handling
   146	
   147	- Invalid query syntax: exit code 1, error message to stderr
   148	- Unknown field name: exit code 1, error message to stderr
   149	- Type mismatch (e.g., `event > 5`): exit code 1, error message to stderr
   150	
   151	---
   152	
   153	## 4. Lineage Graph Construction
   154	
   155	### 4.1 Node Identification
   156	
   157	Each `.mlck` checkpoint file is identified by the SHA-256 hash of its entire file content (hex-encoded).
   158	
   159	### 4.2 Edge Construction
   160	
   161	For each checkpoint with a non-empty `ParentHash` in the provenance section:
   162	- If a checkpoint with that SHA-256 file hash exists in the evidence set, create a directed edge from parent to child.
   163	- If no matching parent is found, the checkpoint is classified as an **orphan**.
   164	
   165	### 4.3 Graph Validation
   166	
   167	- The lineage graph must be a DAG. If a cycle is detected, report each cycle's member nodes.
   168	- Roots: nodes with no incoming edges and empty `ParentHash`.
   169	- Leaves: nodes with no outgoing edges.
   170	
   171	### 4.4 Topological Sort
   172	
   173	The lineage output includes a topological ordering of all non-orphan nodes, from root to leaf. If multiple valid orderings exist, sort by `CreationTimestamp` ascending as tiebreaker.
===== docs/spec.md
     1	# mlforge - ML Model Artifact Forensics Engine
     2	
     3	## Overview
     4	
     5	`mlforge` is a command-line tool for forensic analysis of machine learning model artifacts. Given a directory of evidence (model checkpoints, training log shards, configuration files), mlforge reconstructs training timelines, detects anomalies, verifies artifact integrity, builds model lineage graphs, and produces evidence-backed forensic reports.
     6	
     7	## CLI Interface
     8	
     9	The binary is built as `mlforge` and placed at `/app/mlforge` (or on `$PATH` after `go install`).
    10	
    11	```
    12	mlforge <command> <evidence-dir> [flags]
    13	```
    14	
    15	### Commands
    16	
    17	| Command | Description |
    18	|---------|-------------|
    19	| `ingest` | Scan evidence directory, index all artifacts, print summary to stdout |
    20	| `timeline` | Reconstruct unified training timeline from log shards |
    21	| `verify` | Verify integrity of all checkpoint files |
    22	| `detect` | Run anomaly detection across all evidence |
    23	| `lineage` | Build and output model lineage DAG |
    24	| `query` | Query the unified timeline with filter expressions |
    25	| `report` | Generate full forensic report combining all analyses |
    26	
    27	### Global Flags
    28	
    29	| Flag | Type | Default | Description |
    30	|------|------|---------|-------------|
    31	| `--format` | string | `json` | Output format: `json` or `text` |
    32	| `--verbose` | bool | false | Enable verbose diagnostic output to stderr |
    33	
    34	### Command-Specific Behavior
    35	
    36	#### `ingest`
    37	
    38	Scan `<evidence-dir>` recursively for:
    39	- `.mlck` files (model checkpoints)
    40	- `.jsonl` files (training log shards)
    41	- `.json` files matching `config_*.json` (training configurations)
    42	
    43	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Ingest Output".
    44	
    45	If the evidence directory does not exist or contains no recognizable artifacts, exit with code 1 and print an error to stderr.
    46	
    47	#### `timeline`
    48	
    49	Parse all `.jsonl` log shards in `<evidence-dir>`, merge entries into a unified timeline.
    50	
    51	**Merge Rules** (detailed in `/app/docs/analysis_rules.md` section "Timeline Reconstruction"):
    52	- Entries are identified by `(epoch, step)` tuple
    53	- When multiple shards contain the same `(epoch, step)`, apply conflict resolution
    54	- Gaps in the step sequence are detected and reported
    55	
    56	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Timeline Output".
    57	
    58	#### `verify`
    59	
    60	For each `.mlck` file in `<evidence-dir>`:
    61	1. Parse the file according to the MLCK format (see `/app/docs/formats.md`)
    62	2. Validate the header checksum
    63	3. Validate each tensor's SHA-256 data checksum
    64	4. If the file is signed (Flags bit 0), validate the HMAC-SHA256 signature
    65	5. Validate provenance fields are well-formed
    66	
    67	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Verify Output".
    68	
    69	#### `detect`
    70	
    71	Run all anomaly detection rules (defined in `/app/docs/analysis_rules.md`) across the evidence:
    72	- Timeline-based anomalies (from log shards)
    73	- Checkpoint integrity anomalies (from .mlck files)
    74	- Cross-artifact anomalies (correlating checkpoints with logs)
    75	
    76	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Detect Output".
    77	
    78	#### `lineage`
    79	
    80	Build a directed acyclic graph of model checkpoint relationships using the `parent_hash` field from each checkpoint's provenance section.
    81	
    82	**Rules**:
    83	- Each checkpoint is a node identified by its SHA-256 file hash
    84	- An edge `A -> B` exists if B's `parent_hash` matches A's file hash
    85	- Root nodes have empty `parent_hash`
    86	- Orphan nodes reference a parent not present in the evidence set
    87	- If a cycle is detected, report it as an anomaly (the graph should be a DAG)
    88	
    89	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Lineage Output".
    90	
    91	#### `query`
    92	
    93	```
    94	mlforge query <evidence-dir> "<expression>"
    95	```
    96	
    97	Filter the unified timeline using the query expression language defined in `/app/docs/analysis_rules.md` section "Query Language".
    98	
    99	Output (JSON to stdout): list of matching timeline entries.
   100	
   101	#### `report`
   102	
   103	Generate a comprehensive forensic report by running all analyses (ingest, timeline, verify, detect, lineage) and combining results.
   104	
   105	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Report Output".
   106	
   107	## Exit Codes
   108	
   109	| Code | Meaning |
   110	|------|---------|
   111	| 0 | Success |
   112	| 1 | Input error (missing directory, no artifacts, invalid arguments) |
   113	| 2 | Parse error (corrupt or unreadable artifact) |
   114	
   115	When a parse error occurs for individual artifacts within a batch operation (e.g., one corrupt checkpoint among several), the tool should continue processing remaining artifacts, report the error in the output, and exit with code 0. Exit code 2 is only for cases where the error prevents any meaningful output.
   116	
   117	## Build
   118	
   119	```bash
   120	cd /app && go build -o mlforge ./cmd/mlforge
   121	```
   122	
   123	## Cross-References
   124	
   125	- Binary formats: `/app/docs/formats.md`
   126	- Detection algorithms and query language: `/app/docs/analysis_rules.md`
   127	- JSON output schemas: `/app/docs/output_schema.md`
===== docs/output_schema.md
     1	# Output Schemas
     2	
     3	All commands output JSON to stdout. This document defines the exact JSON structure for each command.
     4	
     5	---
     6	
     7	## 1. Ingest Output
     8	
     9	```json
    10	{
    11	  "status": "ok",
    12	  "evidence_dir": "/path/to/evidence",
    13	  "artifacts": {
    14	    "checkpoints": [
    15	      {
    16	        "file": "model_epoch1.mlck",
    17	        "file_hash": "a1b2c3...",
    18	        "version": 1,
    19	        "num_tensors": 12,
    20	        "num_metadata": 3,
    21	        "signed": false,
    22	        "creation_timestamp": "2024-01-15T10:00:00Z",
    23	        "provenance": {
    24	          "epoch": 1,
    25	          "global_step": 5000,
    26	          "framework": "PyTorch",
    27	          "framework_version": "2.1.0",
    28	          "parent_hash": ""
    29	        }
    30	      }
    31	    ],
    32	    "log_shards": [
    33	      {
    34	        "file": "shard_001.jsonl",
    35	        "entries": 500,
    36	        "step_range": [0, 5000],
    37	        "epoch_range": [0, 1],
    38	        "time_range": ["2024-01-15T08:00:00Z", "2024-01-15T10:00:00Z"]
    39	      }
    40	    ],
    41	    "configs": [
    42	      {
    43	        "file": "config_train.json",
    44	        "model_name": "resnet50",
    45	        "dataset": "imagenet-1k"
    46	      }
    47	    ]
    48	  },
    49	  "totals": {
    50	    "checkpoints": 3,
    51	    "log_shards": 4,
    52	    "configs": 1
    53	  }
    54	}
    55	```
    56	
    57	**Field rules:**
    58	- `file_hash`: SHA-256 hex of the entire `.mlck` file content.
    59	- `checkpoints` array: sorted by `creation_timestamp` ascending.
    60	- `log_shards` array: sorted by `file` name lexicographically.
    61	- `configs` array: sorted by `file` name lexicographically.
    62	- `step_range`: `[min_step, max_step]` across all entries in the shard.
    63	- `epoch_range`: `[min_epoch, max_epoch]` across all entries.
    64	- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.
    65	
    66	---
    67	
    68	## 2. Timeline Output
    69	
    70	```json
    71	{
    72	  "status": "ok",
    73	  "total_entries": 1200,
    74	  "total_epochs": 5,
    75	  "step_range": [0, 50000],
    76	  "time_range": ["2024-01-15T08:00:00Z", "2024-01-17T14:00:00Z"],
    77	  "conflicts_resolved": 3,
    78	  "gaps": [
    79	    {
    80	      "after_step": 5000,
    81	      "before_step": 5200,
    82	      "epoch": 1,
    83	      "gap_steps": 200,
    84	      "after_ts": "2024-01-15T10:00:00Z",
    85	      "before_ts": "2024-01-15T13:00:00Z"
    86	    }
    87	  ],
    88	  "entries": [
    89	    {
    90	      "ts": "2024-01-15T08:00:00Z",
    91	      "epoch": 0,
    92	      "step": 0,
    93	      "loss": 6.9078,
    94	      "lr": 0.001,
    95	      "grad_norm": 12.34,
    96	      "acc": 0.001,
    97	      "event": "step",
    98	      "sources": ["shard_001.jsonl"],
    99	      "conflict": false
   100	    }
   101	  ]
   102	}
   103	```
   104	
   105	**Field rules:**
   106	- `entries`: sorted by `(epoch ASC, step ASC)`.
   107	- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.
   108	- `conflict`: `true` if this entry was chosen by conflict resolution.
   109	- `gaps`: only gaps where `gap_steps > 100` within the same epoch.
   110	- Entries with missing optional fields omit them from the JSON (do not include null).
   111	
   112	---
   113	
   114	## 3. Verify Output
   115	
   116	```json
   117	{
   118	  "status": "ok",
   119	  "checkpoints": [
   120	    {
   121	      "file": "model_epoch1.mlck",
   122	      "valid": true,
   123	      "header_checksum_valid": true,
   124	      "tensor_checksums_valid": true,
   125	      "signature_valid": null,
   126	      "provenance_valid": true,
   127	      "issues": []
   128	    },
   129	    {
   130	      "file": "model_epoch3.mlck",
   131	      "valid": false,
   132	      "header_checksum_valid": true,
   133	      "tensor_checksums_valid": false,
   134	      "signature_valid": true,
   135	      "provenance_valid": true,
   136	      "issues": [
   137	        {"type": "tensor_checksum_mismatch", "detail": "encoder.layer2.weight"}
   138	      ]
   139	    }
   140	  ],
   141	  "summary": {
   142	    "total": 3,
   143	    "valid": 2,
   144	    "invalid": 1
   145	  }
   146	}
   147	```
   148	
   149	**Field rules:**
   150	- `checkpoints`: sorted by `file` name lexicographically.
   151	- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.
   152	- `issues`: list of issue objects with `type` (string) and `detail` (string). For example, a tensor checksum mismatch appears as `{"type": "tensor_checksum_mismatch", "detail": "<tensor_name>"}`.
   153	- `valid`: `true` only if all applicable checks pass.
   154	
   155	---
   156	
   157	## 4. Detect Output
   158	
   159	```json
   160	{
   161	  "status": "ok",
   162	  "anomalies": [
   163	    {
   164	      "id": "ANOM-001",
   165	      "type": "gradient_spike",
   166	      "severity": "high",
   167	      "epoch": 2,
   168	      "step": 3456,
   169	      "details": {
   170	        "observed": 15.3,
   171	        "window_mean": 1.2,
   172	        "window_stddev": 0.3,
   173	        "z_score": 47.0
   174	      },
   175	      "source": "shard_002.jsonl"
   176	    },
   177	    {
   178	      "id": "ANOM-002",
   179	      "type": "tensor_checksum_mismatch",
   180	      "severity": "critical",
   181	      "details": {
   182	        "file": "model_epoch3.mlck",
   183	        "tensor_name": "encoder.layer2.weight",
   184	        "expected_checksum": "abcd1234...",
   185	        "actual_checksum": "efgh5678..."
   186	      },
   187	      "source": "model_epoch3.mlck",
   188	        "checkpoint": "model_epoch3.mlck"
   189	    }
   190	  ],
   191	  "summary": {
   192	    "total": 5,
   193	    "by_severity": {
   194	      "critical": 1,
   195	      "high": 2,
   196	      "medium": 1,
   197	      "low": 1
   198	    },
   199	    "by_type": {
   200	      "gradient_spike": 1,
   201	      "loss_divergence": 1,
   202	      "tensor_checksum_mismatch": 1,
   203	      "training_gap": 1,
   204	      "lr_anomaly": 1
   205	    }
   206	  }
   207	}
   208	```
   209	
   210	**Field rules:**
   211	- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.
   212	- `anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.
   213	- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.
   214	- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.
   215	- `source`: the artifact file where the anomaly was detected.
   216	- `epoch` and `step`: present only for timeline-based anomalies.
   217	- `checkpoint`: present when the anomaly is related to a specific checkpoint file; omitted for timeline-based anomalies that are not checkpoint-specific.
   218	- If no anomalies are detected, `anomalies` is an empty array.
   219	
   220	---
   221	
   222	## 5. Lineage Output
   223	
   224	```json
   225	{
   226	  "status": "ok",
   227	  "nodes": [
   228	    {
   229	      "file": "model_epoch1.mlck",
   230	      "file_hash": "a1b2c3...",
   231	      "epoch": 1,
   232	      "global_step": 5000,
   233	      "creation_timestamp": "2024-01-15T10:00:00Z",
   234	      "parent_hash": "",
   235	      "is_root": true,
   236	      "is_leaf": false,
   237	      "is_orphan": false
   238	    }
   239	  ],
   240	  "edges": [
   241	    {
   242	      "from": "a1b2c3...",
   243	      "to": "d4e5f6...",
   244	      "from_file": "model_epoch1.mlck",
   245	      "to_file": "model_epoch2.mlck"
   246	    }
   247	  ],
   248	  "roots": ["a1b2c3..."],
   249	  "leaves": ["g7h8i9..."],
   250	  "orphans": [],
   251	  "topological_order": ["a1b2c3...", "d4e5f6...", "g7h8i9..."],
   252	  "cycles": []
   253	}
   254	```
   255	
   256	**Field rules:**
   257	- `nodes`: sorted by `creation_timestamp` ascending.
   258	- `edges`: sorted by `from` hash then `to` hash lexicographically.
   259	- `roots`: file hashes of root nodes (no parent), sorted.
   260	- `leaves`: file hashes of leaf nodes (no children), sorted.
