    19	func loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {
    20		ap, err := DiscoverArtifacts(dir)
    21		if err != nil {
    22			return nil, err
    23		}
    24		var cps []*types.CheckpointFile
    25		for _, p := range ap.Checkpoints {
    26			cf, err := checkpoint.Parse(p)
    27			if err != nil || cf == nil {
    28				continue
    29			}
    30			cps = append(cps, cf)
    31		}
    32		sort.Slice(cps, func(i, j int) bool {
    33			return cps[i].Filename < cps[j].Filename
    34		})
    35		return cps, nil
    36	}
    37	
    38	type DetectOutput struct {
    39		Status    string          `json:"status"`
    40		Anomalies []types.Anomaly `json:"anomalies"`
    41		Summary   struct {
    42			Total      int            `json:"total"`
    43			BySeverity map[string]int `json:"by_severity"`
    44			ByType     map[string]int `json:"by_type"`
    45		} `json:"summary"`
    46	}
    47	
    48	func BuildDetect(dir string) (interface{}, error) {
    49		return BuildDetectFiltered(dir, "")
    50	}
    51	
    52	func BuildDetectFiltered(dir, filterSeverity string) (DetectOutput, error) {
    53		var out DetectOutput
    54		out.Status = "ok"
    55		var anomalies []types.Anomaly
    56	
    57		entries, _, err := loadTimelineEntries(dir)
    58		if err == nil {
    59			merged, _ := mergeTimeline(entries)
    60			sortTimeline(merged)
    61			anomalies = append(anomalies, detectTimelineAnomalies(merged)...)
    62		}
    63	
    64		cps, err := loadCheckpoints(dir)
    65		if err == nil {
    66			anomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)
    67		}
    68	
    69		if filterSeverity != "" {
    70			wantedRank, ok := severityRankValue(filterSeverity)
    71			if !ok {
    72				return out, fmt.Errorf("invalid severity level %q: must be critical, high, medium, low, or info", filterSeverity)
    73			}
    74			filtered := anomalies[:0]
    75			for _, a := range anomalies {
    76				if severityRank(a.Severity) <= wantedRank {
    77					filtered = append(filtered, a)
    78				}
    79			}
    80			anomalies = filtered
    81		}
    82	
    83		for i := range anomalies {
    84			anomalies[i].ID = fmt.Sprintf("ANOM-%03d", i+1)
    85		}
    86		sortAnomalies(anomalies)
    87	
    88		out.Anomalies = anomalies
    89		if out.Anomalies == nil {
    90			out.Anomalies = []types.Anomaly{}
    91		}
    92		out.Summary.Total = len(anomalies)
    93		out.Summary.BySeverity = map[string]int{}
    94		out.Summary.ByType = map[string]int{}
    95		for _, a := range anomalies {
    96			out.Summary.BySeverity[a.Severity]++
    97			out.Summary.ByType[a.Type]++
    98		}
    99		return out, nil
   100	}
   101	
   102	func severityRank(s string) int {
   103		switch s {
   104		case "critical":
   105			return 0
   106		case "high":
   107			return 1
   108		case "medium":
   109			return 2
   110		case "low":
   111			return 3
   112		case "info":
   113			return 4
   114		}
   115		return 4
   116	}
   117	
   118	func severityRankValue(s string) (int, bool) {
   119		switch s {
   120		case "critical":
   121			return 0, true
   122		case "high":
   123			return 1, true
   124		case "medium":
   125			return 2, true
   126		case "low":
   127			return 3, true
   128		case "info":
   129			return 4, true
   130		}
   131		return 0, false
   132	}
   133	
   134	func detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {
   135		var anomalies []types.Anomaly
   136		anomalies = append(anomalies, detectGradientSpikes(entries)...)
   137		anomalies = append(anomalies, detectLossDivergence(entries)...)
   138		anomalies = append(anomalies, detectLrAnomalies(entries)...)
   139		anomalies = append(anomalies, detectTrainingGaps(entries)...)
   140		anomalies = append(anomalies, detectMetricRegression(entries)...)
   141		return anomalies
   142	}
   143	
   144	func detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {
   145		var vals []float64
   146		var idx []int
   147		for i, e := range entries {
   148			if e.GradNorm != nil {
   149				vals = append(vals, *e.GradNorm)
   150				idx = append(idx, i)
   151			}
   152		}
   153		if len(vals) < 31 {
   154			return nil
   155		}
   156		var anomalies []types.Anomaly
   157		for i := 30; i < len(vals); i++ {
   158			window := vals[i-30 : i]
   159			mean := meanFloats(window)
   160			std := stddevFloats(window, mean)
   161			observed := vals[i]
   162			z := 0.0
   163			if std > 0 {
   164				z = (observed - mean) / std
   165			}
   166			if observed > mean+2.5*std && z > 2.5 {
   167				severity := "medium"
   168				if z > 4.0 {
   169					severity = "high"
   170				}
   171				ep := entries[idx[i]].Epoch
   172				st := entries[idx[i]].Step
   173				anomalies = append(anomalies, types.Anomaly{
   174					Type:     "gradient_spike",
   175					Severity: severity,
   176					Epoch:    &ep,
   177					Step:     &st,
   178					Details: map[string]interface{}{
   179						"observed":      observed,
   180						"window_mean":   mean,
   181						"window_stddev": std,
   182						"z_score":       z,
   183					},
   184					Evidence: map[string]interface{}{"window_values": lastValues(window, 5)},
   185					Source:   firstSource(entries[idx[i]]),
   186				})
   187			}
   188		}
   189		return anomalies
   190	}
   191	
   192	func detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {
   193		var lossEntries []int
   194		for i, e := range entries {
   195			if e.Loss != nil {
   196				lossEntries = append(lossEntries, i)
   197			}
   198		}
   199		if len(lossEntries) < 51 {
   200			return nil
   201		}
   202		var anomalies []types.Anomaly
   203		for i := 50; i < len(lossEntries); i++ {
   204			startIdx := lossEntries[i-50]
   205			endIdx := lossEntries[i]
   206			start := *entries[startIdx].Loss
   207			end := *entries[endIdx].Loss
   208			if math.Abs(start) <= 1e-6 {
   209				continue
   210			}
   211			ratio := (end - start) / math.Abs(start)
   212			if ratio > 1.0 {
   213				severity := "high"
   214				if ratio > 5.0 {
   215					severity = "critical"
   216				}
   217				ep := entries[endIdx].Epoch
   218				st := entries[endIdx].Step
   219				anomalies = append(anomalies, types.Anomaly{
   220					Type:     "loss_divergence",
[?2004hroot@n30009:/app# nl -ba docs/analysis_rules.md | sed -n '1,260p'
[?2004l     1	# Analysis Rules and Query Language
     2	
     3	## 1. Timeline Reconstruction
     4	
     5	### 1.1 Merge Algorithm
     6	
     7	Given multiple `.jsonl` shard files, the timeline is reconstructed as follows:
     8	
     9	1. **Parse**: Read all entries from all shard files. Skip malformed JSON lines.
    10	2. **Deduplicate**: Entries are keyed by `(epoch, step)`. When multiple entries share the same key:
    11	   - If all numeric metric values (loss, lr, grad_norm, acc) are identical (within 1e-9 tolerance), keep one copy.
    12	   - If values differ, this is a **conflict**. Resolution: keep the entry with the **earliest** `ts` timestamp. Record the conflict.
    13	3. **Sort**: Sort the unified timeline by `(epoch ASC, step ASC)`.
    14	4. **Gap Detection**: A gap exists when consecutive entries (after sorting) satisfy:
    15	   - Same epoch: `step_diff = next.step - curr.step > 1` AND `step_diff > 100`
    16	   - Cross-epoch boundary: not a gap (step resets are normal at epoch boundaries)
    17	
    18	### 1.2 Timeline Entry Output
    19	
    20	After merge, each entry in the timeline has:
    21	- All original fields from the winning entry
    22	- An additional `"sources"` array listing which shard files contained this `(epoch, step)`
    23	- If this entry was a conflict resolution, an additional `"conflict": true` field
    24	
    25	---
    26	
    27	## 2. Anomaly Detection Rules
    28	
    29	Anomalies are classified by severity: `critical`, `high`, `medium`, `low`, `info`.
    30	
    31	Severity order, from most severe to least severe, is `critical` > `high` > `medium` > `low` > `info`. Anomalies are sorted by severity, then `type` alphabetically, then `epoch` ascending, then `step` ascending.
    32	
    33	### 2.1 Gradient Norm Spike
    34	
    35	- **Window**: Sliding window of 50 steps
    36	- **Method**: Compute mean and standard deviation of `grad_norm` over the window
    37	- **Trigger**: `grad_norm > mean + 3.0 * stddev` (Z-score > 3.0)
    38	- **Severity**: `high` if Z-score > 5.0, else `medium`
    39	- **Required data**: At least 50 entries with `grad_norm` before detection begins
    40	- **Output fields**: `observed`, `window_mean`, `window_stddev`, `z_score`
    41	
    42	### 2.2 Loss Divergence
    43	
    44	- **Window**: Sliding window of 50 steps
    45	- **Method**: Compare loss at window start vs window end
    46	- **Trigger**: `(loss_end - loss_start) / |loss_start| > 1.0` (>100% increase)
    47	- **Severity**: `critical` if increase > 5.0 (500%), else `high`
    48	- **Guard**: Only trigger if `|loss_start| > 1e-6` (avoid division by near-zero)
    49	- **Output fields**: `loss_start`, `loss_end`, `increase_ratio`, `window_start_step`, `window_end_step`
    50	
    51	### 2.3 Learning Rate Anomaly
    52	
    53	- **Method**: Analyze the sequence of `lr` values across sorted timeline
    54	- **Trigger**: `lr` increases between consecutive entries UNLESS:
    55	  - The increase coincides with an `epoch_end` event (warmup restart pattern)
    56	  - The increase is the first entry (no previous to compare)
    57	- **Severity**: `info`
    58	- **Output fields**: `prev_lr`, `curr_lr`, `step`
    59	
    60	### 2.4 Metric Regression
    61	
    62	- **Scope**: Between consecutive checkpoints (entries with `event == "checkpoint"` or between .mlck files sorted by epoch/step)
    63	- **Trigger**: `acc` drops by more than 0.15 (absolute, not relative) between consecutive checkpoints
    64	- **Severity**: `high`
    65	- **Output fields**: `prev_acc`, `curr_acc`, `drop`, `prev_checkpoint`, `curr_checkpoint`
    66	
    67	### 2.5 Checkpoint Integrity - Tensor Checksum
    68	
    69	- **Method**: For each tensor in a `.mlck` file, compute SHA-256 of the data bytes and compare with stored checksum
    70	- **Trigger**: Mismatch
    71	- **Severity**: `critical`
    72	- **Output fields**: `file`, `tensor_name`, `expected_checksum` (hex), `actual_checksum` (hex)
    73	
    74	### 2.6 Checkpoint Integrity - Header Checksum
    75	
    76	- **Method**: Compute FNV-1a 64-bit of bytes [0..48) and compare with stored value at offset 48
    77	- **Trigger**: Mismatch
    78	- **Severity**: `critical`
    79	- **Output fields**: `file`, `expected_checksum` (hex), `actual_checksum` (hex)
    80	
    81	### 2.7 Checkpoint Integrity - Signature
    82	
    83	- **Method**: For signed checkpoints (Flags bit 0), compute HMAC-SHA256 of bytes [0..SignatureOffset) using SignerId as key, compare with stored signature
    84	- **Trigger**: Mismatch
    85	- **Severity**: `critical`
    86	- **Output fields**: `file`, `signer_id`, `valid` (bool)
    87	
    88	### 2.8 Provenance Chain Break
    89	
    90	- **Method**: For each checkpoint with a non-empty `parent_hash`, verify that a checkpoint with that file hash exists in the evidence set
    91	- **Trigger**: Parent checkpoint not found
    92	- **Severity**: `medium`
    93	- **Output fields**: `file`, `parent_hash`, `found` (bool)
    94	
    95	### 2.9 Training Gap
    96	
    97	- **Method**: Consecutive timeline entries (after merge sort) have timestamps more than 2 hours apart
    98	- **Trigger**: `time_diff > 7200 seconds` between consecutive entries within the same epoch
    99	- **Severity**: `info`
   100	- **Output fields**: `after_step`, `before_step`, `after_ts`, `before_ts`, `gap_seconds`
   101	
   102	### 2.10 Dataset Hash Inconsistency
   103	
   104	- **Method**: Compare `DatasetHash` across all checkpoints in the same lineage chain
   105	- **Trigger**: Different `DatasetHash` values within the same chain
   106	- **Severity**: `high`
   107	- **Output fields**: `files`, `hashes` (list of unique hex hashes)
