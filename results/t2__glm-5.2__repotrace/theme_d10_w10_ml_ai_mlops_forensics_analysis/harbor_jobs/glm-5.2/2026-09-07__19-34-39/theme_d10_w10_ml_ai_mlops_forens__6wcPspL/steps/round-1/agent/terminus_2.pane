   122			return false
   123		}
   124		return compareNum(*p, c)
   125	}
   126	
   127	func compareStr(val string, c condition) bool {
   128		if c.isNum {
   129			return false
   130		}
   131		switch c.op {
   132		case "==":
   133			return val == c.sval
   134		case "!=":
   135			return val != c.sval
   136		}
   137		return false
   138	}
   139	
   140	func compareTs(val string, c condition) bool {
   141		lt, err := time.Parse(time.RFC3339, val)
   142		if err != nil {
   143			return false
   144		}
   145		rt, err := time.Parse(time.RFC3339, c.sval)
   146		if err != nil {
   147			return false
   148		}
   149		switch c.op {
   150		case ">":
   151			return lt.After(rt)
   152		case "<":
   153			return lt.Before(rt)
   154		case ">=":
   155			return lt.After(rt) || lt.Equal(rt)
   156		case "<=":
   157			return lt.Before(rt) || lt.Equal(rt)
   158		case "==":
   159			return lt.Equal(rt)
   160		case "!=":
   161			return !lt.Equal(rt)
   162		}
   163		return false
   164	}
   165	
   166	func absFloat(x float64) float64 {
   167		if x < 0 {
   168			return -x
   169		}
   170		return x
   171	}
