	return anomalies
}

func detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {
	var anomalies []types.Anomaly
	for i := 1; i < len(entries); i++ {
		prev := entries[i-1]
		cur := entries[i]
		if prev.Epoch != cur.Epoch {
			continue
		}
		prevT, err1 := time.Parse(time.RFC3339, prev.Ts)
		curT, err2 := time.Parse(time.RFC3339, cur.Ts)
		if err1 != nil || err2 != nil {
			continue
		}
		diff := curT.Sub(prevT).Seconds()
		if diff > 3600 {
			ep := cur.Epoch
			st := cur.Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "training_gap",
				Severity: "low",
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"after_step":  prev.Step,
					"before_step": cur.Step,
					"after_ts":    prev.Ts,
					"before_ts":   cur.Ts,
					"gap_seconds": diff,
				},
[?2004hroot@n30009:/app# sed -n '410,425p' internal/forensics/detect.go
[?2004l				})
			}
		}

		if cf.Provenance != nil && cf.Provenance.ParentHash != "" {
			_, found := hashSet[cf.Provenance.ParentHash]
			if !found {
				anomalies = append(anomalies, types.Anomaly{
					Type:     "provenance_chain_break",
					Severity: "high",
					Details: map[string]interface{}{
						"file":        cf.Filename,
						"parent_hash": cf.Provenance.ParentHash,
						"found":       false,
					},
					Evidence:   map[string]interface{}{},
[?2004hroot@n30009:/app# sed -n '95,130p' internal/forensics/detect.go
[?2004l	for _, a := range anomalies {
		out.Summary.BySeverity[a.Severity]++
		out.Summary.ByType[a.Type]++
	}
	return out, nil
}

func severityRank(s string) int {
	switch s {
	case "critical":
		return 0
	case "high":
		return 1
	case "medium":
		return 2
	default:
		return 3
	}
}

func severityRankValue(s string) (int, bool) {
	switch s {
	case "critical":
		return 0, true
	case "high":
		return 1, true
	case "medium":
		return 2, true
	case "low":
		return 3, true
	default:
		return 4, false
	}
}

