[?2004l# Output Schemas

All commands output JSON to stdout. This document defines the exact JSON structure for each command.

---

## 1. Ingest Output

```json
{
  "status": "ok",
  "evidence_dir": "/path/to/evidence",
  "artifacts": {
    "checkpoints": [
      {
        "file": "model_epoch1.mlck",
        "file_hash": "a1b2c3...",
        "version": 1,
        "num_tensors": 12,
        "num_metadata": 3,
        "signed": false,
        "creation_timestamp": "2024-01-15T10:00:00Z",
        "provenance": {
          "epoch": 1,
          "global_step": 5000,
          "framework": "PyTorch",
          "framework_version": "2.1.0",
          "parent_hash": ""
        }
      }
    ],
    "log_shards": [
      {
        "file": "shard_001.jsonl",
        "entries": 500,
        "step_range": [0, 5000],
        "epoch_range": [0, 1],
        "time_range": ["2024-01-15T08:00:00Z", "2024-01-15T10:00:00Z"]
      }
    ],
    "configs": [
      {
        "file": "config_train.json",
        "model_name": "resnet50",
        "dataset": "imagenet-1k"
      }
    ]
  },
  "totals": {
    "checkpoints": 3,
    "log_shards": 4,
    "configs": 1
  }
}
```

**Field rules:**
- `file_hash`: SHA-256 hex of the entire `.mlck` file content.
- `checkpoints` array: sorted by `creation_timestamp` ascending.
- `log_shards` array: sorted by `file` name lexicographically.
- `configs` array: sorted by `file` name lexicographically.
- `step_range`: `[min_step, max_step]` across all entries in the shard.
- `epoch_range`: `[min_epoch, max_epoch]` across all entries.
- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.

---

## 2. Timeline Output

```json
{
  "status": "ok",
  "total_entries": 1200,
  "total_epochs": 5,
  "step_range": [0, 50000],
  "time_range": ["2024-01-15T08:00:00Z", "2024-01-17T14:00:00Z"],
  "conflicts_resolved": 3,
  "gaps": [
    {
      "after_step": 5000,
      "before_step": 5200,
      "epoch": 1,
      "gap_steps": 200,
      "after_ts": "2024-01-15T10:00:00Z",
      "before_ts": "2024-01-15T13:00:00Z"
    }
  ],
  "entries": [
    {
      "ts": "2024-01-15T08:00:00Z",
      "epoch": 0,
      "step": 0,
      "loss": 6.9078,
      "lr": 0.001,
      "grad_norm": 12.34,
      "acc": 0.001,
      "event": "step",
      "sources": ["shard_001.jsonl"],
      "conflict": false
    }
  ]
}
```

**Field rules:**
- `entries`: sorted by `(epoch ASC, step ASC)`.
- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.
- `conflict`: `true` if this entry was chosen by conflict resolution.
- `gaps`: only gaps where `gap_steps > 100` within the same epoch.
- Entries with missing optional fields omit them from the JSON (do not include null).

---

## 3. Verify Output

```json
{
  "status": "ok",
  "checkpoints": [
    {
      "file": "model_epoch1.mlck",
      "valid": true,
      "header_checksum_valid": true,
      "tensor_checksums_valid": true,
      "signature_valid": null,
      "provenance_valid": true,
      "issues": []
    },
    {
      "file": "model_epoch3.mlck",
      "valid": false,
      "header_checksum_valid": true,
      "tensor_checksums_valid": false,
      "signature_valid": true,
      "provenance_valid": true,
      "issues": [
        "tensor_checksum_mismatch:encoder.layer2.weight"
      ]
    }
  ],
  "summary": {
    "total": 3,
    "valid": 2,
    "invalid": 1
  }
}
```

**Field rules:**
- `checkpoints`: sorted by `file` name lexicographically.
- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.
- `issues`: list of human-readable issue descriptions. Format for tensor checksum mismatch: `"tensor_checksum_mismatch:<tensor_name>"`.
- `valid`: `true` only if all applicable checks pass.

---

## 4. Detect Output

```json
{
  "status": "ok",
  "anomalies": [
    {
      "id": "ANOM-001",
      "type": "gradient_spike",
      "severity": "high",
      "epoch": 2,
      "step": 3456,
      "details": {
        "observed": 15.3,
        "window_mean": 1.2,
        "window_stddev": 0.3,
        "z_score": 47.0
      },
      "source": "shard_002.jsonl"
    },
    {
      "id": "ANOM-002",
      "type": "tensor_checksum_mismatch",
      "severity": "critical",
      "details": {
        "file": "model_epoch3.mlck",
        "tensor_name": "encoder.layer2.weight",
        "expected_checksum": "abcd1234...",
        "actual_checksum": "efgh5678..."
      },
      "source": "model_epoch3.mlck"
    }
  ],
  "summary": {
    "total": 5,
    "by_severity": {
      "critical": 1,
      "high": 2,
      "medium": 1,
      "low": 1
    },
    "by_type": {
      "gradient_spike": 1,
      "loss_divergence": 1,
      "tensor_checksum_mismatch": 1,
      "training_gap": 1,
      "lr_anomaly": 1
    }
  }
}
```

**Field rules:**
- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.
- `anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.
- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.
- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.
- `source`: the artifact file where the anomaly was detected.
- `epoch` and `step`: present only for timeline-based anomalies.
- If no anomalies are detected, `anomalies` is an empty array.

---

## 5. Lineage Output
[?2004hroot@n30009:/app# sed -n '221,440p' docs/output_schema.md
[?2004l
```json
{
  "status": "ok",
  "nodes": [
    {
      "file": "model_epoch1.mlck",
      "file_hash": "a1b2c3...",
      "epoch": 1,
      "global_step": 5000,
      "creation_timestamp": "2024-01-15T10:00:00Z",
      "parent_hash": "",
      "is_root": true,
      "is_leaf": false,
      "is_orphan": false
    }
  ],
  "edges": [
    {
      "from": "a1b2c3...",
      "to": "d4e5f6...",
      "from_file": "model_epoch1.mlck",
      "to_file": "model_epoch2.mlck"
    }
  ],
  "roots": ["a1b2c3..."],
  "leaves": ["g7h8i9..."],
  "orphans": [],
  "topological_order": ["a1b2c3...", "d4e5f6...", "g7h8i9..."],
  "cycles": []
}
```

**Field rules:**
- `nodes`: sorted by `creation_timestamp` ascending.
- `edges`: sorted by `from` hash then `to` hash lexicographically.
- `roots`: file hashes of root nodes (no parent), sorted.
- `leaves`: file hashes of leaf nodes (no children), sorted.
- `orphans`: file hashes of orphan nodes (parent not found), sorted.
- `topological_order`: valid topological sort of non-orphan nodes, ties broken by `creation_timestamp`.
- `cycles`: if cycles exist, each cycle is a list of file hashes. Empty if DAG is valid.

---

## 6. Report Output

```json
{
  "version": "1.0",
  "generated_at": "2024-01-18T12:00:00Z",
  "evidence_dir": "/path/to/evidence",
  "ingest": { ... },
  "timeline": { ... },
  "verify": { ... },
  "detect": { ... },
  "lineage": { ... }
}
```

**Field rules:**
- `version`: always `"1.0"`.
- `generated_at`: ISO 8601 UTC timestamp of report generation.
- Each section (`ingest`, `timeline`, `verify`, `detect`, `lineage`) contains the exact same JSON structure as the corresponding standalone command output.
- The report runs all analyses; if any individual analysis encounters an error, that section contains `{"status": "error", "message": "..."}` and the report still completes.

---

## 7. Query Output

```json
{
  "status": "ok",
  "query": "loss > 1.0 AND epoch == 3",
  "matches": 42,
  "entries": [
    {
      "ts": "2024-01-16T08:00:00Z",
      "epoch": 3,
      "step": 15000,
      "loss": 1.234,
      "lr": 0.0001,
      "grad_norm": 2.1,
      "acc": 0.75,
      "event": "step",
      "sources": ["shard_003.jsonl"],
      "conflict": false
    }
  ]
}
```

**Field rules:**
- `entries`: matching timeline entries sorted by `(epoch ASC, step ASC)`.
- `matches`: count of matching entries.
- `query`: the original query string echoed back.
[?2004hroot@n30009:/app# sed -n '1,260p' cmd/mlforge/main.go
[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"strings"
)

func main() {
	// --- Parse flags ---------------------------------------------------
	format := "json"
	verbose := false
	var positional []string

	for _, arg := range os.Args[1:] {
		switch {
		case arg == "--verbose":
			verbose = true
		case strings.HasPrefix(arg, "--format="):
			format = strings.TrimPrefix(arg, "--format=")
		case arg == "--format":
			// handled below as two-token flag
		default:
			positional = append(positional, arg)
		}
	}

	// Handle "--format json" (two separate tokens)
	for i := 1; i < len(os.Args)-1; i++ {
		if os.Args[i] == "--format" {
			format = os.Args[i+1]
			// Remove the value from positional args
			filtered := positional[:0]
			for _, p := range positional {
				if p != os.Args[i+1] {
					filtered = append(filtered, p)
				}
			}
			positional = filtered
			break
		}
	}

	if format != "json" && format != "text" {
		fmt.Fprintf(os.Stderr, "invalid format %q: must be json or text\n", format)
		os.Exit(1)
	}

	_ = verbose // will be used by command implementations later

	// --- Validate positional args --------------------------------------
	if len(positional) < 2 {
		fmt.Fprintf(os.Stderr, "Usage: mlforge <command> <evidence-dir> [args...]\n")
		os.Exit(1)
	}

	cmd := positional[0]
	dir := positional[1]

	// --- Route to command handler --------------------------------------
	var result interface{}
	var err error

	switch cmd {
	case "ingest":
		result, err = buildIngest(dir)
	case "timeline":
		result, err = buildTimeline(dir)
	case "verify":
		result, err = buildVerify(dir)
	case "detect":
		result, err = buildDetect(dir)
	case "lineage":
		result, err = buildLineage(dir)
	case "query":
		if len(positional) < 3 {
			fmt.Fprintf(os.Stderr, "Usage: mlforge query <dir> \"<expression>\"\n")
			os.Exit(1)
		}
		result, err = buildQuery(dir, positional[2])
	case "report":
		result, err = buildReport(dir)
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
		os.Exit(1)
	}

	// --- Output --------------------------------------------------------
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	out, marshalErr := json.MarshalIndent(result, "", "  ")
	if marshalErr != nil {
		fmt.Fprintf(os.Stderr, "error marshalling result: %v\n", marshalErr)
		os.Exit(1)
	}
	fmt.Println(string(out))
}

