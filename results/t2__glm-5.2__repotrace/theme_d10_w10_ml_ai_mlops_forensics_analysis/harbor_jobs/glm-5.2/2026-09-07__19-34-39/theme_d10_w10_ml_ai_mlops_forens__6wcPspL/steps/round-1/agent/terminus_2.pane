   385	
   386	func detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {
   387		byHash := map[string]*types.CheckpointFile{}
   388		for _, cf := range cps {
   389			byHash[cf.FileHash] = cf
   390		}
   391		children := map[string][]string{}
   392		for _, cf := range cps {
   393			if cf.Provenance != nil && cf.Provenance.ParentHash != "" {
   394				if _, ok := byHash[cf.Provenance.ParentHash]; ok {
   395					children[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)
   396				}
   397			}
   398		}
   399	
   400		var anomalies []types.Anomaly
   401		seen := map[string]bool{}
   402		for _, cf := range cps {
   403			if cf.Provenance == nil {
   404				continue
   405			}
   406			root := cf.FileHash
   407			for root != "" {
   408				parent, ok := byHash[root]
   409				if !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == "" {
   410					break
   411				}
   412				root = parent.Provenance.ParentHash
   413			}
   414			if seen[root] {
   415				continue
   416			}
   417			seen[root] = true
   418	
   419			chain := []string{}
   420			queue := []string{root}
   421			visited := map[string]bool{}
   422			for len(queue) > 0 {
   423				cur := queue[0]
   424				queue = queue[1:]
   425				if visited[cur] {
   426					continue
   427				}
   428				visited[cur] = true
   429				node, ok := byHash[cur]
   430				if !ok || node == nil {
   431					continue
   432				}
   433				chain = append(chain, node.Filename)
   434				queue = append(queue, children[cur]...)
   435			}
   436			sort.Strings(chain)
   437	
   438			hashes := map[string]struct{}{}
   439			for _, h := range chain {
   440				if node, ok := byHashFile(cps, h); ok && node.Provenance != nil {
   441					hashes[node.Provenance.DatasetHash] = struct{}{}
   442				}
   443			}
   444			if len(hashes) > 1 {
   445				unique := make([]string, 0, len(hashes))
   446				for h := range hashes {
   447					unique = append(unique, h)
   448				}
   449				sort.Strings(unique)
   450				anomalies = append(anomalies, types.Anomaly{
   451					Type:     "dataset_hash_inconsistency",
   452					Severity: "high",
   453					Details: map[string]interface{}{
   454						"files":  chain,
   455						"hashes": unique,
   456					},
   457					Source: chain[0],
   458				})
   459			}
   460		}
   461		return anomalies
   462	}
   463	
   464	func byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {
   465		for _, cf := range cps {
   466			if cf.Filename == file {
   467				return cf, true
   468			}
   469		}
   470		return nil, false
   471	}
   472	
   473	func signatureDetails(path string) (bool, string) {
   474		raw, err := os.ReadFile(path)
   475		if err != nil || len(raw) < 56 {
   476			return false, ""
   477		}
   478		sigOff := binary.LittleEndian.Uint64(raw[32:40])
   479		if sigOff == 0 || int(sigOff) >= len(raw) || int(sigOff)+5 > len(raw) {
   480			return false, ""
   481		}
   482		off := int(sigOff)
   483		off++ // algorithm
   484		signerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   485		off += 2
   486		if off+signerLen+2 > len(raw) {
   487			return false, ""
   488		}
   489		signerID := string(raw[off : off+signerLen])
   490		off += signerLen
   491		sigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   492		off += 2
   493		if off+sigLen > len(raw) {
   494			return false, signerID
   495		}
   496		stored := raw[off : off+sigLen]
   497		mac := hmac.New(sha256.New, []byte(signerID))
   498		mac.Write(raw[:sigOff])
   499		expected := mac.Sum(nil)
   500		return hmac.Equal(expected, stored), signerID
   501	}
   502	
   503	func firstSource(e types.TimelineEntry) string {
   504		if len(e.Sources) > 0 {
   505			return e.Sources[0]
   506		}
   507		return ""
   508	}
   509	
   510	func meanFloats(v []float64) float64 {
   511		if len(v) == 0 {
   512			return 0
   513		}
   514		s := 0.0
   515		for _, x := range v {
   516			s += x
   517		}
   518		return s / float64(len(v))
   519	}
   520	
   521	func stddevFloats(v []float64, mean float64) float64 {
   522		if len(v) == 0 {
   523			return 0
   524		}
   525		s := 0.0
   526		for _, x := range v {
   527			d := x - mean
   528			s += d * d
   529		}
   530		return math.Sqrt(s / float64(len(v)))
   531	}
   532	
   533	func sortAnomalies(a []types.Anomaly) {
   534		rank := map[string]int{"critical": 0, "high": 1, "medium": 2, "low": 3}
   535		sort.Slice(a, func(i, j int) bool {
   536			ri := rank[a[i].Severity]
   537			rj := rank[a[j].Severity]
   538			if ri != rj {
   539				return ri < rj
   540			}
   541			ei := -1
   542			ej := -1
   543			if a[i].Epoch != nil {
   544				ei = *a[i].Epoch
   545			}
   546			ej = -1
   547			if a[j].Epoch != nil {
   548				ej = *a[j].Epoch
   549			}
   550			if ei != ej {
   551				return ei < ej
   552			}
   553			si := -1
   554			if a[i].Step != nil {
   555				si = *a[i].Step
   556			}
   557			sj := -1
   558			if a[j].Step != nil {
   559				sj = *a[j].Step
   560			}
   561			return si < sj
   562		})
   563	}
