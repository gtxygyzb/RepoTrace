    19	func loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {
    20		ap, err := DiscoverArtifacts(dir)
    21		if err != nil {
    22			return nil, err
    23		}
    24		var cps []*types.CheckpointFile
    25		for _, p := range ap.Checkpoints {
    26			cf, err := checkpoint.Parse(p)
    27			if err != nil || cf == nil {
    28				continue
    29			}
    30			cps = append(cps, cf)
    31		}
    32		sort.Slice(cps, func(i, j int) bool {
    33			return cps[i].Filename < cps[j].Filename
    34		})
    35		return cps, nil
    36	}
