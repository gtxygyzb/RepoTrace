   385	
   386	func detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {
   387		byHash := map[string]*types.CheckpointFile{}
   388		for _, cf := range cps {
   389			byHash[cf.FileHash] = cf
   390		}
   391		children := map[string][]string{}
   392		for _, cf := range cps {
   393			if cf.Provenance != nil && cf.Provenance.ParentHash != "" {
   394				if _, ok := byHash[cf.Provenance.ParentHash]; ok {
   395					children[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)
   396				}
   397			}
   398		}
   399	
   400		var anomalies []types.Anomaly
   401		seen := map[string]bool{}
   402		for _, cf := range cps {
   403			if cf.Provenance == nil {
   404				continue
   405			}
   406			root := cf.FileHash
   407			for root != "" {
   408				parent, ok := byHash[root]
   409				if !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == "" {
   410					break
   411				}
   412				root = parent.Provenance.ParentHash
   413			}
   414			if seen[root] {
   415				continue
   416			}
   417			seen[root] = true
   418	
   419			chain := []string{}
   420			queue := []string{root}
   421			visited := map[string]bool{}
   422			for len(queue) > 0 {
   423				cur := queue[0]
   424				queue = queue[1:]
   425				if visited[cur] {
   426					continue
   427				}
   428				visited[cur] = true
   429				node, ok := byHash[cur]
   430				if !ok || node == nil {
   431					continue
   432				}
   433				chain = append(chain, node.Filename)
   434				queue = append(queue, children[cur]...)
   435			}
   436			sort.Strings(chain)
   437	
   438			hashes := map[string]struct{}{}
   439			for _, h := range chain {
   440				if node, ok := byHashFile(cps, h); ok && node.Provenance != nil {
   441					hashes[node.Provenance.DatasetHash] = struct{}{}
   442				}
   443			}
   444			if len(hashes) > 1 {
   445				unique := make([]string, 0, len(hashes))
   446				for h := range hashes {
   447					unique = append(unique, h)
   448				}
   449				sort.Strings(unique)
   450				anomalies = append(anomalies, types.Anomaly{
   451					Type:     "dataset_hash_inconsistency",
   452					Severity: "high",
   453					Details: map[string]interface{}{
   454						"files":  chain,
   455						"hashes": unique,
   456					},
   457					Source: chain[0],
   458				})
   459			}
   460		}
   461		return anomalies
   462	}
   463	
   464	func byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {
   465		for _, cf := range cps {
   466			if cf.Filename == file {
   467				return cf, true
   468			}
   469		}
   470		return nil, false
