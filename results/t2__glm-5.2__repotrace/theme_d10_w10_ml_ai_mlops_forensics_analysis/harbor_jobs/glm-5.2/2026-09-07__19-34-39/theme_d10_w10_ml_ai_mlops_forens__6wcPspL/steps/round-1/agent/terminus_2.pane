   247	type VerifyCheckpoint struct {
   248		File                 string   `json:"file"`
   249		Valid                bool     `json:"valid"`
   250		HeaderChecksumValid  bool     `json:"header_checksum_valid"`
   251		TensorChecksumsValid bool     `json:"tensor_checksums_valid"`
   252		SignatureValid       *bool    `json:"signature_valid"`
   253		ProvenanceValid      bool     `json:"provenance_valid"`
   254		Issues               []string `json:"issues"`
   255	}
   256	
   257	type VerifyOutput struct {
   258		Status      string             `json:"status"`
   259		Checkpoints []VerifyCheckpoint `json:"checkpoints"`
   260		Summary     struct {
   261			Total   int `json:"total"`
   262			Valid   int `json:"valid"`
   263			Invalid int `json:"invalid"`
   264		} `json:"summary"`
   265	}
   266	
   267	func BuildVerify(dir string) (interface{}, error) {
   268		ap, err := DiscoverArtifacts(dir)
   269		if err != nil {
   270			return nil, err
   271		}
   272		if len(ap.Checkpoints) == 0 {
   273			return nil, fmt.Errorf("no checkpoint files found")
   274		}
   275		var out VerifyOutput
   276		out.Status = "ok"
   277		for _, p := range ap.Checkpoints {
   278			vc := verifyCheckpoint(p)
   279			out.Checkpoints = append(out.Checkpoints, vc)
   280		}
   281		sort.Slice(out.Checkpoints, func(i, j int) bool {
   282			return out.Checkpoints[i].File < out.Checkpoints[j].File
   283		})
   284		out.Summary.Total = len(out.Checkpoints)
   285		for _, c := range out.Checkpoints {
   286			if c.Valid {
   287				out.Summary.Valid++
   288			} else {
   289				out.Summary.Invalid++
   290			}
   291		}
   292		return out, nil
   293	}
   294	
   295	func verifyCheckpoint(path string) VerifyCheckpoint {
   296		vc := VerifyCheckpoint{
   297			File:   filepath.Base(path),
   298			Issues: []string{},
   299		}
   300		cf, err := checkpoint.Parse(path)
   301		if err != nil || cf == nil {
   302			vc.HeaderChecksumValid = false
   303			vc.TensorChecksumsValid = false
   304			vc.ProvenanceValid = false
   305			vc.Valid = false
   306			vc.Issues = append(vc.Issues, fmt.Sprintf("parse_error:%s", err))
   307			return vc
   308		}
   309		vc.HeaderChecksumValid = cf.HeaderValid
   310		if !cf.HeaderValid {
   311			vc.Issues = append(vc.Issues, "header_checksum_mismatch")
   312		}
   313		vc.TensorChecksumsValid = true
   314		for _, t := range cf.Tensors {
   315			if !t.Valid {
   316				vc.TensorChecksumsValid = false
   317				vc.Issues = append(vc.Issues, fmt.Sprintf("tensor_checksum_mismatch:%s", t.Name))
   318			}
   319		}
   320		if cf.Signed {
   321			valid, _ := validateSignature(path)
   322			vc.SignatureValid = &valid
   323			if !valid {
   324				vc.Issues = append(vc.Issues, "signature_invalid")
   325			}
   326		}
   327		vc.ProvenanceValid = validateProvenance(cf)
   328		if !vc.ProvenanceValid {
   329			vc.Issues = append(vc.Issues, "provenance_invalid")
   330		}
   331		vc.Valid = vc.HeaderChecksumValid && vc.TensorChecksumsValid && vc.ProvenanceValid && (!cf.Signed || (vc.SignatureValid != nil && *vc.SignatureValid))
   332		return vc
   333	}
   334	
   335	func validateSignature(path string) (bool, error) {
   336		raw, err := os.ReadFile(path)
   337		if err != nil || len(raw) < 56 {
   338			return false, err
   339		}
   340		sigOff := binary.LittleEndian.Uint64(raw[32:40])
   341		if sigOff == 0 || int(sigOff) >= len(raw) {
   342			return false, nil
   343		}
   344		if int(sigOff)+5 > len(raw) {
   345			return false, nil
   346		}
   347		off := int(sigOff)
   348		_ = raw[off] // algorithm
   349		off++
   350		signerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   351		off += 2
   352		if off+signerLen+2 > len(raw) {
   353			return false, nil
   354		}
   355		signerID := string(raw[off : off+signerLen])
   356		off += signerLen
   357		sigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   358		off += 2
   359		if off+sigLen > len(raw) {
   360			return false, nil
   361		}
   362		storedSig := raw[off : off+sigLen]
   363		mac := hmac.New(sha256.New, []byte(signerID))
   364		mac.Write(raw[:sigOff])
   365		expected := mac.Sum(nil)
   366		return hmac.Equal(expected, storedSig), nil
   367	}
   368	
   369	func validateProvenance(cf *types.CheckpointFile) bool {
   370		if cf.Provenance == nil {
   371			return false
   372		}
   373		p := cf.Provenance
   374		if p.Framework == "" || p.FrameworkVersion == "" {
   375			return false
   376		}
   377		if len(p.GitCommit) != 40 || !isHex(p.GitCommit) {
   378			return false
   379		}
   380		if len(p.DatasetHash) != 64 || !isHex(p.DatasetHash) {
   381			return false
   382		}
   383		if len(p.ConfigHash) != 64 || !isHex(p.ConfigHash) {
   384			return false
   385		}
   386		if p.ParentHash != "" && (len(p.ParentHash) != 64 || !isHex(p.ParentHash)) {
   387			return false
   388		}
   389		return true
   390	}
