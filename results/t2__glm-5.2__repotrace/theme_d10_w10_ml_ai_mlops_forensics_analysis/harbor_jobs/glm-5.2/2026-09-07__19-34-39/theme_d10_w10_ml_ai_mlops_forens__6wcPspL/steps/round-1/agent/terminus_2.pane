    73			os.Exit(1)
    74		}
    75	
    76		// --- Route to command handler --------------------------------------
    77		var result interface{}
    78		var err error
    79	
    80		switch cmd {
    81		case "ingest":
    82			result, err = forensics.BuildIngest(dir)
    83		case "timeline":
    84			result, err = forensics.BuildTimeline(dir)
    85		case "verify":
    86			result, err = forensics.BuildVerify(dir)
    87		case "detect":
    88			detectResult, detectErr := forensics.BuildDetectFiltered(dir, filterSeverity)
    89			if detectErr != nil {
    90				err = detectErr
    91			} else {
    92				if format == "csv" {
    93					printDetectCSV(detectResult)
    94					return
    95				}
    96				result = detectResult
    97			}
    98		case "lineage":
    99			result, err = forensics.BuildLineage(dir)
   100		case "query":
   101			if len(positional) < 3 {
   102				fmt.Fprintf(os.Stderr, "Usage: mlforge query <dir> \"<expression>\"\n")
   103				os.Exit(1)
   104			}
   105			result, err = forensics.BuildQuery(dir, positional[2])
   106		case "diff":
   107			if len(positional) < 4 {
   108				fmt.Fprintf(os.Stderr, "Usage: mlforge diff <dir> <file1> <file2>\n")
   109				os.Exit(1)
   110			}
   111			result, err = forensics.BuildDiff(dir, positional[2], positional[3])
   112		case "report":
   113			result, err = forensics.BuildReport(dir)
   114		default:
   115			fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
   116			os.Exit(1)
   117		}
   118	
   119		// --- Output --------------------------------------------------------
   120		if err != nil {
   121			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   122			os.Exit(1)
   123		}
   124	
   125		if format == "text" {
   126			printText(result)
   127			return
   128		}
   129	
   130		out, marshalErr := json.MarshalIndent(result, "", "  ")
   131		if marshalErr != nil {
   132			fmt.Fprintf(os.Stderr, "error marshalling result: %v\n", marshalErr)
   133			os.Exit(1)
   134		}
   135		fmt.Println(string(out))
   136	}
   137	
   138	func printDetectCSV(result forensics.DetectOutput) {
   139		fmt.Println("id,type,severity,epoch,step,source,checkpoint")
   140		for _, a := range result.Anomalies {
   141			epoch := ""
   142			if a.Epoch != nil {
   143				epoch = strconv.Itoa(*a.Epoch)
   144			}
   145			step := ""
   146			if a.Step != nil {
   147				step = strconv.Itoa(*a.Step)
   148			}
   149			fmt.Printf("%s,%s,%s,%s,%s,%s,%s\n", a.ID, a.Type, a.Severity, epoch, step, a.Source, a.Checkpoint)
   150		}
   151	}
   152	
   153	func printText(v interface{}) {
   154		b, err := json.MarshalIndent(v, "", "  ")
   155		if err != nil {
   156			fmt.Fprintln(os.Stderr, "error rendering text output")
   157			return
   158		}
   159		fmt.Println(string(b))
   160	}
