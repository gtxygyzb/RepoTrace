    19	func BuildQuery(dir, expr string) (interface{}, error) {
    20		entries, _, err := loadTimelineEntries(dir)
    21		if err != nil {
    22			return nil, err
    23		}
    24		merged, _ := mergeTimeline(entries)
    25		sortTimeline(merged)
    26	
    27		q, err := parseQuery(expr)
    28		if err != nil {
    29			return nil, err
    30		}
    31		matches := []types.TimelineEntry{}
    32		for _, e := range merged {
    33			if q.eval(e) {
    34				matches = append(matches, e)
    35			}
    36		}
    37		return QueryOutput{
    38			Status:  "ok",
    39			Query:   expr,
    40			Matches: len(matches),
    41			Entries: matches,
    42		}, nil
    43	}
