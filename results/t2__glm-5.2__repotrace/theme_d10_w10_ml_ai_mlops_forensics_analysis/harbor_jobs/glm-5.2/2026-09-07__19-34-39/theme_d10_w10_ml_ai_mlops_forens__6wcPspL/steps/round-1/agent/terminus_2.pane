   280					Epoch:    &ep,
   281					Step:     &st,
   282					Details: map[string]interface{}{
   283						"prev_acc":        *prev.Acc,
   284						"curr_acc":        *cur.Acc,
   285						"drop":            drop,
   286						"prev_checkpoint": prev.Step,
   287						"curr_checkpoint": cur.Step,
   288					},
   289					Source: firstSource(cur),
   290				})
   291			}
   292		}
   293		return anomalies
   294	}
   295	
   296	func detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {
   297		var anomalies []types.Anomaly
   298		hashSet := map[string]*types.CheckpointFile{}
   299		for _, cf := range cps {
   300			hashSet[cf.FileHash] = cf
   301		}
   302	
   303		for _, cf := range cps {
   304			raw, err := os.ReadFile(cf.Path)
   305			if err != nil {
   306				continue
   307			}
   308			if !cf.HeaderValid {
   309				stored := uint64(0)
   310				if len(raw) >= 56 {
   311					stored = binary.LittleEndian.Uint64(raw[48:56])
   312				}
   313				h := fnv.New64a()
   314				h.Write(raw[:48])
   315				computed := h.Sum64()
   316				anomalies = append(anomalies, types.Anomaly{
   317					Type:     "header_checksum_mismatch",
   318					Severity: "critical",
   319					Details: map[string]interface{}{
   320						"file":              cf.Filename,
   321						"expected_checksum": fmt.Sprintf("%016x", stored),
   322						"actual_checksum":   fmt.Sprintf("%016x", computed),
   323					},
   324					Source:     cf.Filename,
   325					Checkpoint: cf.Filename,
   326				})
   327			}
   328	
   329			for _, t := range cf.Tensors {
   330				if !t.Valid {
   331					computed := sha256.Sum256(t.Data)
   332					anomalies = append(anomalies, types.Anomaly{
   333						Type:     "tensor_checksum_mismatch",
   334						Severity: "critical",
   335						Details: map[string]interface{}{
   336							"file":              cf.Filename,
   337							"tensor_name":       t.Name,
   338							"expected_checksum": hex.EncodeToString(t.Hash[:]),
   339							"actual_checksum":   hex.EncodeToString(computed[:]),
   340						},
   341						Source:     cf.Filename,
   342						Checkpoint: cf.Filename,
   343					})
   344				}
   345			}
   346	
   347			if cf.Signed {
   348				valid, signer := signatureDetails(cf.Path)
   349				if !valid {
   350					anomalies = append(anomalies, types.Anomaly{
   351						Type:     "signature_invalid",
   352						Severity: "critical",
   353						Details: map[string]interface{}{
   354							"file":      cf.Filename,
   355							"signer_id": signer,
   356							"valid":     false,
   357						},
   358						Source:     cf.Filename,
   359						Checkpoint: cf.Filename,
   360					})
   361				}
   362			}
   363	
   364			if cf.Provenance != nil && cf.Provenance.ParentHash != "" {
   365				_, found := hashSet[cf.Provenance.ParentHash]
   366				if !found {
   367					anomalies = append(anomalies, types.Anomaly{
   368						Type:     "provenance_chain_break",
   369						Severity: "high",
   370						Details: map[string]interface{}{
   371							"file":        cf.Filename,
   372							"parent_hash": cf.Provenance.ParentHash,
   373							"found":       false,
   374						},
   375						Source:     cf.Filename,
   376						Checkpoint: cf.Filename,
   377					})
   378				}
   379			}
   380		}
   381	
   382		anomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)
   383		return anomalies
   384	}
   385	
   386	func detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {
   387		byHash := map[string]*types.CheckpointFile{}
   388		for _, cf := range cps {
   389			byHash[cf.FileHash] = cf
   390		}
   391		children := map[string][]string{}
   392		for _, cf := range cps {
   393			if cf.Provenance != nil && cf.Provenance.ParentHash != "" {
   394				if _, ok := byHash[cf.Provenance.ParentHash]; ok {
   395					children[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)
   396				}
   397			}
   398		}
   399	
   400		var anomalies []types.Anomaly
   401		seen := map[string]bool{}
   402		for _, cf := range cps {
   403			if cf.Provenance == nil {
   404				continue
   405			}
   406			root := cf.FileHash
   407			for root != "" {
   408				parent, ok := byHash[root]
   409				if !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == "" {
   410					break
   411				}
   412				root = parent.Provenance.ParentHash
   413			}
   414			if seen[root] {
   415				continue
   416			}
   417			seen[root] = true
   418	
   419			chain := []string{}
   420			queue := []string{root}
   421			visited := map[string]bool{}
   422			for len(queue) > 0 {
   423				cur := queue[0]
   424				queue = queue[1:]
   425				if visited[cur] {
   426					continue
   427				}
   428				visited[cur] = true
   429				node, ok := byHash[cur]
   430				if !ok || node == nil {
   431					continue
   432				}
   433				chain = append(chain, node.Filename)
   434				queue = append(queue, children[cur]...)
   435			}
   436			sort.Strings(chain)
   437	
   438			hashes := map[string]struct{}{}
   439			for _, h := range chain {
   440				if node, ok := byHashFile(cps, h); ok && node.Provenance != nil {
   441					hashes[node.Provenance.DatasetHash] = struct{}{}
   442				}
   443			}
   444			if len(hashes) > 1 {
   445				unique := make([]string, 0, len(hashes))
   446				for h := range hashes {
   447					unique = append(unique, h)
   448				}
   449				sort.Strings(unique)
   450				anomalies = append(anomalies, types.Anomaly{
   451					Type:     "dataset_hash_inconsistency",
   452					Severity: "high",
   453					Details: map[string]interface{}{
   454						"files":  chain,
   455						"hashes": unique,
   456					},
   457					Source: chain[0],
   458				})
   459			}
   460		}
   461		return anomalies
   462	}
   463	
   464	func byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {
   465		for _, cf := range cps {
   466			if cf.Filename == file {
   467				return cf, true
   468			}
   469		}
   470		return nil, false
   471	}
   472	
   473	func signatureDetails(path string) (bool, string) {
   474		raw, err := os.ReadFile(path)
   475		if err != nil || len(raw) < 56 {
   476			return false, ""
   477		}
   478		sigOff := binary.LittleEndian.Uint64(raw[32:40])
   479		if sigOff == 0 || int(sigOff) >= len(raw) || int(sigOff)+5 > len(raw) {
   480			return false, ""
   481		}
   482		off := int(sigOff)
   483		off++ // algorithm
   484		signerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   485		off += 2
   486		if off+signerLen+2 > len(raw) {
   487			return false, ""
   488		}
   489		signerID := string(raw[off : off+signerLen])
   490		off += signerLen
   491		sigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   492		off += 2
   493		if off+sigLen > len(raw) {
   494			return false, signerID
   495		}
   496		stored := raw[off : off+sigLen]
   497		mac := hmac.New(sha256.New, []byte(signerID))
   498		mac.Write(raw[:sigOff])
   499		expected := mac.Sum(nil)
   500		return hmac.Equal(expected, stored), signerID
   501	}
   502	
   503	func firstSource(e types.TimelineEntry) string {
   504		if len(e.Sources) > 0 {
   505			return e.Sources[0]
   506		}
   507		return ""
   508	}
   509	
   510	func meanFloats(v []float64) float64 {
   511		if len(v) == 0 {
   512			return 0
   513		}
   514		s := 0.0
   515		for _, x := range v {
   516			s += x
   517		}
   518		return s / float64(len(v))
   519	}
