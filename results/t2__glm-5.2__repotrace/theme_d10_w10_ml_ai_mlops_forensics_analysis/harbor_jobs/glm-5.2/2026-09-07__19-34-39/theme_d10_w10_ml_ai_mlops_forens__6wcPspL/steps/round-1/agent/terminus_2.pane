    21	
    22	type ArtifactPaths struct {
    23		Checkpoints []string
    24		Logs        []string
    25		Configs     []string
    26	}
    27	
    28	func DiscoverArtifacts(dir string) (ArtifactPaths, error) {
    29		var ap ArtifactPaths
    30		err := filepath.WalkDir(dir, func(path string, d os.DirEntry, err error) error {
    31			if err != nil {
    32				return err
    33			}
    34			if d.IsDir() {
    35				return nil
    36			}
    37			name := d.Name()
    38			lower := strings.ToLower(name)
    39			switch {
    40			case strings.HasSuffix(lower, ".mlck"):
    41				ap.Checkpoints = append(ap.Checkpoints, path)
    42			case strings.HasSuffix(lower, ".jsonl"):
    43				ap.Logs = append(ap.Logs, path)
    44			case strings.HasPrefix(name, "config_") && strings.HasSuffix(lower, ".json"):
    45				ap.Configs = append(ap.Configs, path)
    46			}
    47			return nil
    48		})
    49		if err != nil {
    50			return ap, err
    51		}
    52		sort.Strings(ap.Checkpoints)
    53		sort.Strings(ap.Logs)
    54		sort.Strings(ap.Configs)
    55		return ap, nil
    56	}
    57	
    58	type IngestCheckpoint struct {
    59		File              string                 `json:"file"`
    60		FileHash          string                 `json:"file_hash"`
    61		Version           uint32                 `json:"version"`
    62		NumTensors        uint32                 `json:"num_tensors"`
    63		NumMetadata       uint32                 `json:"num_metadata"`
    64		Signed            bool                   `json:"signed"`
    65		CreationTimestamp string                 `json:"creation_timestamp"`
    66		Provenance        map[string]interface{} `json:"provenance"`
    67	}
    68	
    69	type IngestLogShard struct {
    70		File       string   `json:"file"`
    71		Entries    int      `json:"entries"`
    72		StepRange  []int    `json:"step_range"`
    73		EpochRange []int    `json:"epoch_range"`
    74		TimeRange  []string `json:"time_range"`
    75	}
    76	
    77	type IngestConfig struct {
    78		File      string `json:"file"`
    79		ModelName string `json:"model_name"`
    80		Dataset   string `json:"dataset"`
    81	}
    82	
    83	type IngestOutput struct {
    84		Status      string `json:"status"`
    85		EvidenceDir string `json:"evidence_dir"`
    86		Artifacts   struct {
    87			Checkpoints []IngestCheckpoint `json:"checkpoints"`
    88			LogShards   []IngestLogShard   `json:"log_shards"`
    89			Configs     []IngestConfig     `json:"configs"`
    90		} `json:"artifacts"`
    91		Totals struct {
    92			Checkpoints int `json:"checkpoints"`
    93			LogShards   int `json:"log_shards"`
    94			Configs     int `json:"configs"`
    95		} `json:"totals"`
    96	}
    97	
    98	func BuildIngest(dir string) (interface{}, error) {
    99		ap, err := DiscoverArtifacts(dir)
   100		if err != nil {
   101			return nil, err
   102		}
   103		if len(ap.Checkpoints) == 0 && len(ap.Logs) == 0 && len(ap.Configs) == 0 {
   104			return nil, fmt.Errorf("no recognizable artifacts found in %s", dir)
   105		}
   106	
   107		var out IngestOutput
   108		out.Status = "ok"
   109		out.EvidenceDir = dir
   110		out.Artifacts.Checkpoints = []IngestCheckpoint{}
   111		out.Artifacts.LogShards = []IngestLogShard{}
   112		out.Artifacts.Configs = []IngestConfig{}
   113	
   114		for _, p := range ap.Checkpoints {
   115			cf, err := checkpoint.Parse(p)
   116			if err != nil || cf == nil {
   117				continue
   118			}
   119			ic := IngestCheckpoint{
   120				File:              cf.Filename,
   121				FileHash:          cf.FileHash,
   122				Version:           cf.Version,
   123				NumTensors:        cf.NumTensors,
   124				NumMetadata:       cf.NumMetadataKeys,
   125				Signed:            cf.Signed,
   126				CreationTimestamp: unixToISO(cf.CreationTimestamp),
   127				Provenance:        provenanceToMap(cf.Provenance),
   128			}
   129			out.Artifacts.Checkpoints = append(out.Artifacts.Checkpoints, ic)
   130		}
   131		sort.Slice(out.Artifacts.Checkpoints, func(i, j int) bool {
   132			return out.Artifacts.Checkpoints[i].CreationTimestamp < out.Artifacts.Checkpoints[j].CreationTimestamp
   133		})
   134	
   135		for _, p := range ap.Logs {
   136			info, entries, err := parseShardRecursive(p)
   137			if err != nil {
   138				continue
   139			}
   140			shard := IngestLogShard{
   141				File:    info.File,
   142				Entries: info.Entries,
   143			}
   144			if info.Entries > 0 {
   145				shard.StepRange = []int{info.MinStep, info.MaxStep}
   146				shard.EpochRange = []int{info.MinEpoch, info.MaxEpoch}
   147				if info.MinTs != "" || info.MaxTs != "" {
   148					shard.TimeRange = []string{info.MinTs, info.MaxTs}
   149				}
   150			}
   151			_ = entries
   152			out.Artifacts.LogShards = append(out.Artifacts.LogShards, shard)
   153		}
   154		sort.Slice(out.Artifacts.LogShards, func(i, j int) bool {
   155			return out.Artifacts.LogShards[i].File < out.Artifacts.LogShards[j].File
   156		})
   157	
   158		for _, p := range ap.Configs {
   159			cfg, err := readConfigSummary(p)
   160			if err != nil {
   161				continue
   162			}
   163			out.Artifacts.Configs = append(out.Artifacts.Configs, cfg)
   164		}
   165		sort.Slice(out.Artifacts.Configs, func(i, j int) bool {
   166			return out.Artifacts.Configs[i].File < out.Artifacts.Configs[j].File
   167		})
   168	
   169		out.Totals.Checkpoints = len(out.Artifacts.Checkpoints)
   170		out.Totals.LogShards = len(out.Artifacts.LogShards)
   171		out.Totals.Configs = len(out.Artifacts.Configs)
   172		return out, nil
   173	}
   174	
   175	type TimelineGap struct {
   176		AfterStep  int    `json:"after_step"`
   177		BeforeStep int    `json:"before_step"`
   178		Epoch      int    `json:"epoch"`
   179		GapSteps   int    `json:"gap_steps"`
   180		AfterTs    string `json:"after_ts"`
   181		BeforeTs   string `json:"before_ts"`
   182	}
   183	
   184	type TimelineOutput struct {
   185		Status            string                `json:"status"`
   186		TotalEntries      int                   `json:"total_entries"`
   187		TotalEpochs       int                   `json:"total_epochs"`
   188		StepRange         []int                 `json:"step_range"`
   189		TimeRange         []string              `json:"time_range"`
   190		ConflictsResolved int                   `json:"conflicts_resolved"`
   191		Gaps              []TimelineGap         `json:"gaps"`
   192		Entries           []types.TimelineEntry `json:"entries"`
   193	}
   194	
   195	func BuildTimeline(dir string) (interface{}, error) {
   196		entries, shards, err := loadTimelineEntries(dir)
   197		if err != nil {
   198			return nil, err
   199		}
   200		return buildTimelineFromEntries(entries, shards), nil
   201	}
   202	
   203	func buildTimelineFromEntries(entries []types.TimelineEntry, shards []logparser.ShardInfo) TimelineOutput {
   204		merged, conflicts := mergeTimeline(entries)
   205		sortTimeline(merged)
   206		gaps := detectGaps(merged)
   207	
   208		out := TimelineOutput{
   209			Status:            "ok",
   210			TotalEntries:      len(merged),
   211			ConflictsResolved: conflicts,
   212			Gaps:              gaps,
   213			Entries:           merged,
   214		}
   215		if len(merged) > 0 {
   216			minStep, maxStep := merged[0].Step, merged[0].Step
   217			minTs, maxTs := merged[0].Ts, merged[0].Ts
   218			epochSet := map[int]struct{}{}
   219			for _, e := range merged {
   220				epochSet[e.Epoch] = struct{}{}
   221				if e.Step < minStep {
   222					minStep = e.Step
   223				}
   224				if e.Step > maxStep {
   225					maxStep = e.Step
   226				}
   227				if e.Ts < minTs {
   228					minTs = e.Ts
   229				}
   230				if e.Ts > maxTs {
   231					maxTs = e.Ts
   232				}
   233			}
   234			out.TotalEpochs = len(epochSet)
   235			out.StepRange = []int{minStep, maxStep}
   236			out.TimeRange = []string{minTs, maxTs}
   237		}
   238		if out.Gaps == nil {
   239			out.Gaps = []TimelineGap{}
   240		}
   241		if out.Entries == nil {
   242			out.Entries = []types.TimelineEntry{}
   243		}
   244		return out
   245	}
