   157		mean := vals[0]
   158		variance := 0.0
   159		var anomalies []types.Anomaly
   160		for i := 1; i < len(vals); i++ {
   161			if i >= 30 {
   162				observed := vals[i]
   163				stddev := math.Sqrt(variance)
   164				z := 0.0
   165				if stddev > 0 {
   166					z = (observed - mean) / stddev
   167				}
   168				if z > 2.5 {
