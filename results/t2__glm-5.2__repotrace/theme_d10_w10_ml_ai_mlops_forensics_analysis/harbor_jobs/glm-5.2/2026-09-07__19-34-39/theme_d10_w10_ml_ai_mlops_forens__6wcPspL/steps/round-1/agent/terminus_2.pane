[?2004l     1	package main
     2	
     3	import (
     4		"encoding/json"
     5		"fmt"
     6		"os"
     7		"strings"
     8	
     9		"mlforge/internal/forensics"
    10	)
    11	
    12	func main() {
    13		// --- Parse flags ---------------------------------------------------
    14		format := "json"
    15		verbose := false
    16		var positional []string
    17	
    18		for _, arg := range os.Args[1:] {
    19			switch {
    20			case arg == "--verbose":
    21				verbose = true
    22			case strings.HasPrefix(arg, "--format="):
    23				format = strings.TrimPrefix(arg, "--format=")
    24			case arg == "--format":
    25			// handled below as two-token flag
    26			default:
    27				positional = append(positional, arg)
    28			}
    29		}
    30	
    31		// Handle "--format json" (two separate tokens)
    32		for i := 1; i < len(os.Args)-1; i++ {
    33			if os.Args[i] == "--format" {
    34				format = os.Args[i+1]
    35				// Remove the value from positional args
    36				filtered := positional[:0]
    37				for _, p := range positional {
    38					if p != os.Args[i+1] {
    39						filtered = append(filtered, p)
    40					}
    41				}
    42				positional = filtered
    43				break
    44			}
    45		}
    46	
    47		if format != "json" && format != "text" {
    48			fmt.Fprintf(os.Stderr, "invalid format %q: must be json or text\n", format)
    49			os.Exit(1)
    50		}
    51	
    52		_ = verbose // reserved for diagnostic output
    53	
    54		// --- Validate positional args --------------------------------------
    55		if len(positional) < 2 {
    56			fmt.Fprintf(os.Stderr, "Usage: mlforge <command> <evidence-dir> [args...]\n")
    57			os.Exit(1)
    58		}
    59	
    60		cmd := positional[0]
    61		dir := positional[1]
    62	
    63		// --- Route to command handler --------------------------------------
    64		var result interface{}
    65		var err error
    66	
    67		switch cmd {
    68		case "ingest":
    69			result, err = forensics.BuildIngest(dir)
    70		case "timeline":
    71			result, err = forensics.BuildTimeline(dir)
    72		case "verify":
    73			result, err = forensics.BuildVerify(dir)
    74		case "detect":
    75			result, err = forensics.BuildDetect(dir)
    76		case "lineage":
    77			result, err = forensics.BuildLineage(dir)
    78		case "query":
    79			if len(positional) < 3 {
    80				fmt.Fprintf(os.Stderr, "Usage: mlforge query <dir> \"<expression>\"\n")
    81				os.Exit(1)
    82			}
    83			result, err = forensics.BuildQuery(dir, positional[2])
    84		case "diff":
    85			if len(positional) < 4 {
    86				fmt.Fprintf(os.Stderr, "Usage: mlforge diff <dir> <file1> <file2>\n")
    87				os.Exit(1)
    88			}
    89			result, err = forensics.BuildDiff(dir, positional[2], positional[3])
    90		case "report":
    91			result, err = forensics.BuildReport(dir)
    92		default:
    93			fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
    94			os.Exit(1)
    95		}
    96	
    97		// --- Output --------------------------------------------------------
    98		if err != nil {
    99			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   100			os.Exit(1)
   101		}
   102	
   103		if format == "text" {
   104			printText(result)
   105			return
   106		}
   107	
   108		out, marshalErr := json.MarshalIndent(result, "", "  ")
   109		if marshalErr != nil {
   110			fmt.Fprintf(os.Stderr, "error marshalling result: %v\n", marshalErr)
   111			os.Exit(1)
   112		}
   113		fmt.Println(string(out))
   114	}
   115	
   116	func printText(v interface{}) {
   117		b, err := json.MarshalIndent(v, "", "  ")
   118		if err != nil {
   119			fmt.Fprintln(os.Stderr, "error rendering text output")
   120			return
   121		}
   122		fmt.Println(string(b))
   123	}
[?2004hroot@n30009:/app# cat -n docs/output_schema.md
[?2004l     1	# Output Schemas
     2	
     3	All commands output JSON to stdout. This document defines the exact JSON structure for each command.
     4	
     5	---
     6	
     7	## 1. Ingest Output
     8	
     9	```json
    10	{
    11	  "status": "ok",
    12	  "evidence_dir": "/path/to/evidence",
    13	  "artifacts": {
    14	    "checkpoints": [
    15	      {
    16	        "file": "model_epoch1.mlck",
    17	        "file_hash": "a1b2c3...",
    18	        "version": 1,
    19	        "num_tensors": 12,
    20	        "num_metadata": 3,
    21	        "signed": false,
    22	        "creation_timestamp": "2024-01-15T10:00:00Z",
    23	        "provenance": {
    24	          "epoch": 1,
    25	          "global_step": 5000,
    26	          "framework": "PyTorch",
    27	          "framework_version": "2.1.0",
    28	          "parent_hash": ""
    29	        }
    30	      }
    31	    ],
    32	    "log_shards": [
    33	      {
    34	        "file": "shard_001.jsonl",
    35	        "entries": 500,
    36	        "step_range": [0, 5000],
    37	        "epoch_range": [0, 1],
    38	        "time_range": ["2024-01-15T08:00:00Z", "2024-01-15T10:00:00Z"]
    39	      }
    40	    ],
    41	    "configs": [
    42	      {
    43	        "file": "config_train.json",
    44	        "model_name": "resnet50",
    45	        "dataset": "imagenet-1k"
    46	      }
    47	    ]
    48	  },
    49	  "totals": {
    50	    "checkpoints": 3,
    51	    "log_shards": 4,
    52	    "configs": 1
    53	  }
    54	}
    55	```
    56	
    57	**Field rules:**
    58	- `file_hash`: SHA-256 hex of the entire `.mlck` file content.
    59	- `checkpoints` array: sorted by `creation_timestamp` ascending.
    60	- `log_shards` array: sorted by `file` name lexicographically.
    61	- `configs` array: sorted by `file` name lexicographically.
    62	- `step_range`: `[min_step, max_step]` across all entries in the shard.
    63	- `epoch_range`: `[min_epoch, max_epoch]` across all entries.
    64	- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.
    65	
    66	---
    67	
    68	## 2. Timeline Output
    69	
    70	```json
    71	{
    72	  "status": "ok",
    73	  "total_entries": 1200,
    74	  "total_epochs": 5,
    75	  "step_range": [0, 50000],
    76	  "time_range": ["2024-01-15T08:00:00Z", "2024-01-17T14:00:00Z"],
    77	  "conflicts_resolved": 3,
    78	  "gaps": [
    79	    {
    80	      "after_step": 5000,
    81	      "before_step": 5200,
    82	      "epoch": 1,
    83	      "gap_steps": 200,
    84	      "after_ts": "2024-01-15T10:00:00Z",
    85	      "before_ts": "2024-01-15T13:00:00Z"
    86	    }
    87	  ],
    88	  "entries": [
    89	    {
    90	      "ts": "2024-01-15T08:00:00Z",
    91	      "epoch": 0,
    92	      "step": 0,
    93	      "loss": 6.9078,
    94	      "lr": 0.001,
    95	      "grad_norm": 12.34,
    96	      "acc": 0.001,
    97	      "event": "step",
    98	      "sources": ["shard_001.jsonl"],
    99	      "conflict": false
   100	    }
   101	  ]
   102	}
   103	```
   104	
   105	**Field rules:**
   106	- `entries`: sorted by `(epoch ASC, step ASC)`.
   107	- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.
   108	- `conflict`: `true` if this entry was chosen by conflict resolution.
   109	- `gaps`: only gaps where `gap_steps > 100` within the same epoch.
   110	- Entries with missing optional fields omit them from the JSON (do not include null).
   111	
   112	---
   113	
   114	## 3. Verify Output
   115	
   116	```json
   117	{
   118	  "status": "ok",
   119	  "checkpoints": [
   120	    {
   121	      "file": "model_epoch1.mlck",
   122	      "valid": true,
   123	      "header_checksum_valid": true,
   124	      "tensor_checksums_valid": true,
   125	      "signature_valid": null,
   126	      "provenance_valid": true,
   127	      "issues": []
   128	    },
   129	    {
   130	      "file": "model_epoch3.mlck",
   131	      "valid": false,
   132	      "header_checksum_valid": true,
   133	      "tensor_checksums_valid": false,
   134	      "signature_valid": true,
   135	      "provenance_valid": true,
   136	      "issues": [
   137	        {"type": "tensor_checksum_mismatch", "detail": "encoder.layer2.weight"}
   138	      ]
   139	    }
   140	  ],
   141	  "summary": {
   142	    "total": 3,
   143	    "valid": 2,
   144	    "invalid": 1
   145	  }
   146	}
   147	```
   148	
   149	**Field rules:**
   150	- `checkpoints`: sorted by `file` name lexicographically.
   151	- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.
   152	- `issues`: list of issue objects with `type` (string) and `detail` (string). For example, a tensor checksum mismatch appears as `{"type": "tensor_checksum_mismatch", "detail": "<tensor_name>"}`.
   153	- `valid`: `true` only if all applicable checks pass.
   154	
   155	---
   156	
   157	## 4. Detect Output
   158	
   159	```json
   160	{
   161	  "status": "ok",
   162	  "anomalies": [
   163	    {
   164	      "id": "ANOM-001",
   165	      "type": "gradient_spike",
   166	      "severity": "high",
   167	      "epoch": 2,
   168	      "step": 3456,
   169	      "details": {
   170	        "observed": 15.3,
   171	        "window_mean": 1.2,
   172	        "window_stddev": 0.3,
   173	        "z_score": 47.0
   174	      },
   175	      "source": "shard_002.jsonl"
   176	    },
   177	    {
   178	      "id": "ANOM-002",
   179	      "type": "tensor_checksum_mismatch",
   180	      "severity": "critical",
   181	      "details": {
   182	        "file": "model_epoch3.mlck",
   183	        "tensor_name": "encoder.layer2.weight",
   184	        "expected_checksum": "abcd1234...",
   185	        "actual_checksum": "efgh5678..."
   186	      },
   187	      "source": "model_epoch3.mlck",
   188	        "checkpoint": "model_epoch3.mlck"
   189	    }
   190	  ],
   191	  "summary": {
   192	    "total": 5,
   193	    "by_severity": {
   194	      "critical": 1,
   195	      "high": 2,
   196	      "medium": 1,
   197	      "low": 1
   198	    },
   199	    "by_type": {
   200	      "gradient_spike": 1,
   201	      "loss_divergence": 1,
   202	      "tensor_checksum_mismatch": 1,
   203	      "training_gap": 1,
   204	      "lr_anomaly": 1
   205	    }
   206	  }
   207	}
   208	```
   209	
   210	**Field rules:**
   211	- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.
   212	- `anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.
   213	- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.
   214	- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.
   215	- `source`: the artifact file where the anomaly was detected.
   216	- `epoch` and `step`: present only for timeline-based anomalies.
   217	- `checkpoint`: present when the anomaly is related to a specific checkpoint file; omitted for timeline-based anomalies that are not checkpoint-specific.
   218	- If no anomalies are detected, `anomalies` is an empty array.
   219	
   220	---
   221	
   222	## 5. Lineage Output
   223	
   224	```json
   225	{
   226	  "status": "ok",
   227	  "nodes": [
   228	    {
   229	      "file": "model_epoch1.mlck",
   230	      "file_hash": "a1b2c3...",
   231	      "epoch": 1,
   232	      "global_step": 5000,
   233	      "creation_timestamp": "2024-01-15T10:00:00Z",
   234	      "parent_hash": "",
   235	      "is_root": true,
   236	      "is_leaf": false,
   237	      "is_orphan": false
   238	    }
   239	  ],
   240	  "edges": [
   241	    {
   242	      "from": "a1b2c3...",
   243	      "to": "d4e5f6...",
   244	      "from_file": "model_epoch1.mlck",
   245	      "to_file": "model_epoch2.mlck"
   246	    }
   247	  ],
   248	  "roots": ["a1b2c3..."],
   249	  "leaves": ["g7h8i9..."],
   250	  "orphans": [],
   251	  "topological_order": ["a1b2c3...", "d4e5f6...", "g7h8i9..."],
   252	  "cycles": []
   253	}
   254	```
   255	
   256	**Field rules:**
   257	- `nodes`: sorted by `creation_timestamp` ascending.
   258	- `edges`: sorted by `from` hash then `to` hash lexicographically.
   259	- `roots`: file hashes of root nodes (no parent), sorted.
   260	- `leaves`: file hashes of leaf nodes (no children), sorted.
   261	- `orphans`: file hashes of orphan nodes (parent not found), sorted.
   262	- `topological_order`: valid topological sort of non-orphan nodes, ties broken by `creation_timestamp`.
   263	- `cycles`: if cycles exist, each cycle is a list of file hashes. Empty if DAG is valid.
   264	
   265	---
   266	
   267	## 6. Report Output
   268	
   269	```json
   270	{
   271	  "version": "1.0",
   272	  "generated_at": "2024-01-18T12:00:00Z",
   273	  "evidence_dir": "/path/to/evidence",
   274	  "ingest": { ... },
   275	  "timeline": { ... },
   276	  "verify": { ... },
   277	  "detect": { ... },
   278	  "lineage": { ... }
   279	}
   280	```
   281	
   282	**Field rules:**
   283	- `version`: always `"1.0"`.
   284	- `generated_at`: ISO 8601 UTC timestamp of report generation.
   285	- Each section (`ingest`, `timeline`, `verify`, `detect`, `lineage`) contains the exact same JSON structure as the corresponding standalone command output.
   286	- The report runs all analyses; if any individual analysis encounters an error, that section contains `{"status": "error", "message": "..."}` and the report still completes.
   287	
   288	---
   289	
   290	## 7. Query Output
   291	
   292	```json
   293	{
   294	  "status": "ok",
   295	  "query": "loss > 1.0 AND epoch == 3",
   296	  "matches": 42,
   297	  "entries": [
   298	    {
   299	      "ts": "2024-01-16T08:00:00Z",
   300	      "epoch": 3,
   301	      "step": 15000,
   302	      "loss": 1.234,
   303	      "lr": 0.0001,
   304	      "grad_norm": 2.1,
   305	      "acc": 0.75,
   306	      "event": "step",
   307	      "sources": ["shard_003.jsonl"],
   308	      "conflict": false
   309	    }
   310	  ]
   311	}
   312	```
   313	
   314	**Field rules:**
   315	- `entries`: matching timeline entries sorted by `(epoch ASC, step ASC)`.
   316	- `matches`: count of matching entries.
   317	- `query`: the original query string echoed back.
   318	
   319	
   320	## 8. Diff Output
   321	
   322	```json
   323	{
   324	  "status": "ok",
   325	  "file_a": "model_epoch1.mlck",
   326	  "file_b": "model_epoch2.mlck",
   327	  "tensor_diffs": [
   328	    {
   329	      "name": "layer1.weight",
   330	      "shape_match": true,
   331	      "shape_a": [4, 3],
   332	      "shape_b": [4, 3],
   333	      "max_abs_diff": 1.234,
   334	      "mean_abs_diff": 0.567
   335	    },
   336	    {
   337	      "name": "layer2.bias",
   338	      "shape_match": false,
   339	      "shape_a": [3],
   340	      "shape_b": [6]
   341	    },
   342	    {
   343	      "name": "layer3.weight",
   344	      "shape_match": false,
   345	      "shape_a": null,
   346	      "shape_b": [2, 2]
   347	    }
   348	  ],
   349	  "summary": {
   350	    "total_tensors_a": 2,
   351	    "total_tensors_b": 3,
   352	    "common_tensors": 2,
   353	    "shape_mismatches": 1,
   354	    "only_in_a": [],
   355	    "only_in_b": ["layer3.weight"]
   356	  }
   357	}
   358	```
   359	
   360	**Field rules:**
   361	- `file_a` and `file_b` are the basenames of `file1` and `file2`.
   362	- `tensor_diffs`: sorted by tensor name lexicographically.
   363	- `shape_a` and `shape_b`: tensor shapes from each file, or `null` if absent from that file.
   364	- `shape_match`: `true` only when the tensor exists in both files and the shapes are identical.
   365	- `max_abs_diff` and `mean_abs_diff`: present only for tensors with `shape_match: true`, computed over float32 element-wise absolute differences.
   366	- `summary.total_tensors_a` and `summary.total_tensors_b`: tensor counts in each file.
   367	- `summary.common_tensors`: number of tensor names present in both files.
   368	- `summary.shape_mismatches`: number of common tensors with different shapes.
   369	- `summary.only_in_a` and `summary.only_in_b`: tensor names present in only one file, sorted lexicographically.
[?2004hroot@n30009:/app# cat -n docs/spec.md
[?2004l     1	# mlforge - ML Model Artifact Forensics Engine
     2	
     3	## Overview
     4	
     5	`mlforge` is a command-line tool for forensic analysis of machine learning model artifacts. Given a directory of evidence (model checkpoints, training log shards, configuration files), mlforge reconstructs training timelines, detects anomalies, verifies artifact integrity, builds model lineage graphs, and produces evidence-backed forensic reports.
     6	
     7	## CLI Interface
     8	
     9	The binary is built as `mlforge` and placed at `/app/mlforge` (or on `$PATH` after `go install`).
    10	
    11	```
    12	mlforge <command> <evidence-dir> [flags]
    13	```
    14	
    15	### Commands
    16	
    17	| Command | Description |
    18	|---------|-------------|
    19	| `ingest` | Scan evidence directory, index all artifacts, print summary to stdout |
    20	| `timeline` | Reconstruct unified training timeline from log shards |
    21	| `verify` | Verify integrity of all checkpoint files |
    22	| `detect` | Run anomaly detection across all evidence |
    23	| `lineage` | Build and output model lineage DAG |
    24	| `query` | Query the unified timeline with filter expressions |
    25	| `report` | Generate full forensic report combining all analyses |
    26	
    27	### Global Flags
    28	
    29	| Flag | Type | Default | Description |
    30	|------|------|---------|-------------|
    31	| `--format` | string | `json` | Output format: `json` or `text` |
    32	| `--verbose` | bool | false | Enable verbose diagnostic output to stderr |
    33	
    34	### Command-Specific Behavior
    35	
    36	#### `ingest`
    37	
    38	Scan `<evidence-dir>` recursively for:
    39	- `.mlck` files (model checkpoints)
    40	- `.jsonl` files (training log shards)
    41	- `.json` files matching `config_*.json` (training configurations)
    42	
    43	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Ingest Output".
    44	
    45	If the evidence directory does not exist or contains no recognizable artifacts, exit with code 1 and print an error to stderr.
    46	
    47	#### `timeline`
    48	
    49	Parse all `.jsonl` log shards in `<evidence-dir>`, merge entries into a unified timeline.
    50	
    51	**Merge Rules** (detailed in `/app/docs/analysis_rules.md` section "Timeline Reconstruction"):
    52	- Entries are identified by `(epoch, step)` tuple
    53	- When multiple shards contain the same `(epoch, step)`, apply conflict resolution
    54	- Gaps in the step sequence are detected and reported
    55	
    56	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Timeline Output".
    57	
    58	#### `verify`
    59	
    60	For each `.mlck` file in `<evidence-dir>`:
    61	1. Parse the file according to the MLCK format (see `/app/docs/formats.md`)
    62	2. Validate the header checksum
    63	3. Validate each tensor's SHA-256 data checksum
    64	4. If the file is signed (Flags bit 0), validate the HMAC-SHA256 signature
    65	5. Validate provenance fields are well-formed
    66	
    67	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Verify Output".
    68	
    69	#### `detect`
    70	
    71	Run all anomaly detection rules (defined in `/app/docs/analysis_rules.md`) across the evidence:
    72	- Timeline-based anomalies (from log shards)
    73	- Checkpoint integrity anomalies (from .mlck files)
    74	- Cross-artifact anomalies (correlating checkpoints with logs)
    75	
    76	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Detect Output".
    77	
    78	#### `lineage`
    79	
    80	Build a directed acyclic graph of model checkpoint relationships using the `parent_hash` field from each checkpoint's provenance section.
    81	
    82	**Rules**:
    83	- Each checkpoint is a node identified by its SHA-256 file hash
    84	- An edge `A -> B` exists if B's `parent_hash` matches A's file hash
    85	- Root nodes have empty `parent_hash`
    86	- Orphan nodes reference a parent not present in the evidence set
    87	- If a cycle is detected, report it as an anomaly (the graph should be a DAG)
    88	
    89	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Lineage Output".
    90	
    91	#### `query`
    92	
    93	```
    94	mlforge query <evidence-dir> "<expression>"
    95	```
    96	
    97	Filter the unified timeline using the query expression language defined in `/app/docs/analysis_rules.md` section "Query Language".
    98	
    99	Output (JSON to stdout): list of matching timeline entries.
   100	
   101	#### `diff`
   102	
   103	```
   104	mlforge diff <evidence-dir> <file1> <file2>
   105	```
   106	
   107	Compare two checkpoint files inside `<evidence-dir>` tensor by tensor and write JSON to stdout. `file1` and `file2` are checkpoint filenames relative to `<evidence-dir>`.
   108	
   109	For every tensor name present in either file, include one entry in `tensor_diffs`, sorted by tensor name lexicographically. `max_abs_diff` and `mean_abs_diff` are included only when both files contain the tensor and their shapes match.
   110	
   111	If either checkpoint filename does not exist under `<evidence-dir>`, exit non-zero and print an error to stderr.
   112	
   113	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Diff Output".
   114	
   115	#### `report`
   116	
   117	Generate a comprehensive forensic report by running all analyses (ingest, timeline, verify, detect, lineage) and combining results.
   118	
   119	Output (JSON to stdout): see `/app/docs/output_schema.md` section "Report Output".
   120	
   121	## Exit Codes
   122	
   123	| Code | Meaning |
   124	|------|---------|
   125	| 0 | Success |
   126	| 1 | Input error (missing directory, no artifacts, invalid arguments) |
   127	| 2 | Parse error (corrupt or unreadable artifact) |
   128	
   129	When a parse error occurs for individual artifacts within a batch operation (e.g., one corrupt checkpoint among several), the tool should continue processing remaining artifacts, report the error in the output, and exit with code 0. Exit code 2 is only for cases where the error prevents any meaningful output.
   130	
   131	## Build
   132	
   133	```bash
   134	cd /app && go build -o mlforge ./cmd/mlforge
   135	```
   136	
   137	## Cross-References
   138	
   139	- Binary formats: `/app/docs/formats.md`
   140	- Detection algorithms and query language: `/app/docs/analysis_rules.md`
   141	- JSON output schemas: `/app/docs/output_schema.md`
