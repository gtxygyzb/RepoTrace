    45	// BuildDiff compares two checkpoint files inside evidenceDir tensor by tensor.
    46	func BuildDiff(evidenceDir, file1, file2 string) (interface{}, error) {
    47		pathA := filepath.Join(evidenceDir, file1)
    48		pathB := filepath.Join(evidenceDir, file2)
    49	
    50		cfA, err := checkpoint.Parse(pathA)
    51		if err != nil {
    52			return nil, fmt.Errorf("diff: %s: %w", file1, err)
    53		}
    54		if cfA == nil {
    55			return nil, fmt.Errorf("diff: %s: not found", file1)
    56		}
    57		cfB, err := checkpoint.Parse(pathB)
    58		if err != nil {
    59			return nil, fmt.Errorf("diff: %s: %w", file2, err)
    60		}
    61		if cfB == nil {
    62			return nil, fmt.Errorf("diff: %s: not found", file2)
    63		}
    64	
    65		tensorsA := make(map[string]types.TensorInfo, len(cfA.Tensors))
    66		for _, t := range cfA.Tensors {
    67			tensorsA[t.Name] = t
    68		}
    69		tensorsB := make(map[string]types.TensorInfo, len(cfB.Tensors))
    70		for _, t := range cfB.Tensors {
    71			tensorsB[t.Name] = t
    72		}
    73	
    74		names := map[string]struct{}{}
    75		for name := range tensorsA {
    76			names[name] = struct{}{}
    77		}
    78		for name := range tensorsB {
    79			names[name] = struct{}{}
    80		}
    81		sortedNames := make([]string, 0, len(names))
    82		for name := range names {
    83			sortedNames = append(sortedNames, name)
    84		}
    85		sort.Strings(sortedNames)
    86	
    87		onlyInA := []string{}
    88		onlyInB := []string{}
    89		common := 0
    90		shapeMismatches := 0
    91		tensorDiffs := make([]diffTensorResult, 0, len(sortedNames))
    92	
    93		for _, name := range sortedNames {
    94			ta, okA := tensorsA[name]
    95			tb, okB := tensorsB[name]
    96	
    97			var shapeA []uint32
    98			var shapeB []uint32
    99			if okA {
   100				shapeA = ta.Shape
   101			}
   102			if okB {
   103				shapeB = tb.Shape
   104			}
   105	
   106			shapeMatch := okA && okB && shapesEqual(ta.Shape, tb.Shape)
   107			result := diffTensorResult{
   108				Name:       name,
   109				ShapeMatch: shapeMatch,
   110				ShapeA:     shapeA,
   111				ShapeB:     shapeB,
   112			}
   113	
   114			if okA && okB {
   115				common++
   116				if !shapeMatch {
   117					shapeMismatches++
   118				} else {
   119					maxDiff, meanDiff, err := float32DiffStats(ta, tb)
   120					if err != nil {
   121						return nil, fmt.Errorf("diff: tensor %s: %w", name, err)
   122					}
   123					result.MaxAbsDiff = &maxDiff
   124					result.MeanAbsDiff = &meanDiff
   125				}
   126			} else if okA {
   127				onlyInA = append(onlyInA, name)
   128			} else {
   129				onlyInB = append(onlyInB, name)
   130			}
   131	
   132			tensorDiffs = append(tensorDiffs, result)
   133		}
   134	
   135		return diffOutput{
   136			Status:      "ok",
   137			FileA:       filepath.Base(file1),
   138			FileB:       filepath.Base(file2),
   139			TensorDiffs: tensorDiffs,
   140			Summary: diffSummary{
   141				TotalTensorsA:   len(tensorsA),
   142				TotalTensorsB:   len(tensorsB),
   143				CommonTensors:   common,
   144				ShapeMismatches: shapeMismatches,
   145				OnlyInA:         onlyInA,
   146				OnlyInB:         onlyInB,
   147			},
   148		}, nil
   149	}
   150	
   151	func shapesEqual(a, b []uint32) bool {
   152		if len(a) != len(b) {
   153			return false
   154		}
   155		for i := range a {
   156			if a[i] != b[i] {
   157				return false
   158			}
   159		}
   160		return true
