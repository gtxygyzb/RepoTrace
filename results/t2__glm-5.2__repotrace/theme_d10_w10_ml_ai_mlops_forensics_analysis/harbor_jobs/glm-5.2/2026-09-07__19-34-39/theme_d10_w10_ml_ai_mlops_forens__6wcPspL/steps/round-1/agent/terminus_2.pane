func loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {
	ap, err := DiscoverArtifacts(dir)
	if err != nil {
		return nil, err
	}
	var cps []*types.CheckpointFile
	for _, p := range ap.Checkpoints {
		cf, err := checkpoint.Parse(p)
		if err != nil || cf == nil {
			continue
		}
		cps = append(cps, cf)
	}
	sort.Slice(cps, func(i, j int) bool {
		return cps[i].Filename < cps[j].Filename
	})
	return cps, nil
}

type DetectOutput struct {
	Status    string          `json:"status"`
	Anomalies []types.Anomaly `json:"anomalies"`
	Summary   struct {
		Total      int            `json:"total"`
		BySeverity map[string]int `json:"by_severity"`
		ByType     map[string]int `json:"by_type"`
	} `json:"summary"`
}

func BuildDetect(dir string) (interface{}, error) {
	return buildDetectWithDir(dir)
}

func buildDetectWithDir(dir string) (DetectOutput, error) {
	var out DetectOutput
	out.Status = "ok"
	var anomalies []types.Anomaly

	entries, _, err := loadTimelineEntries(dir)
	if err == nil {
		merged, _ := mergeTimeline(entries)
		sortTimeline(merged)
		anomalies = append(anomalies, detectTimelineAnomalies(merged)...)
	}

	cps, err := loadCheckpoints(dir)
	if err == nil {
		anomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)
	}

	for i := range anomalies {
		anomalies[i].ID = fmt.Sprintf("ANOM-%03d", i+1)
	}
	sortAnomalies(anomalies)

	out.Anomalies = anomalies
	if out.Anomalies == nil {
		out.Anomalies = []types.Anomaly{}
	}
	out.Summary.Total = len(anomalies)
	out.Summary.BySeverity = map[string]int{"critical": 0, "high": 0, "medium": 0, "low": 0}
	out.Summary.ByType = map[string]int{}
	for _, a := range anomalies {
		out.Summary.BySeverity[a.Severity]++
		out.Summary.ByType[a.Type]++
	}
	return out, nil
}

func detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {
	var anomalies []types.Anomaly
	anomalies = append(anomalies, detectGradientSpikes(entries)...)
	anomalies = append(anomalies, detectLossDivergence(entries)...)
	anomalies = append(anomalies, detectLrAnomalies(entries)...)
	anomalies = append(anomalies, detectTrainingGaps(entries)...)
	anomalies = append(anomalies, detectMetricRegression(entries)...)
	return anomalies
}

func detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {
	var vals []float64
	var idx []int
	for i, e := range entries {
		if e.GradNorm != nil {
			vals = append(vals, *e.GradNorm)
			idx = append(idx, i)
		}
	}
	if len(vals) < 31 {
		return nil
	}
	var anomalies []types.Anomaly
	for i := 30; i < len(vals); i++ {
		window := vals[i-30 : i]
		mean := meanFloats(window)
		std := stddevFloats(window, mean)
		observed := vals[i]
		z := 0.0
		if std > 0 {
			z = (observed - mean) / std
		}
		if observed > mean+2.5*std && z > 2.5 {
[?2004hroot@n30009:/app# sed -n '120,230p' internal/forensics/detect.go
[?2004l		if observed > mean+2.5*std && z > 2.5 {
			severity := "medium"
			if z > 4.0 {
				severity = "high"
			}
			ep := entries[idx[i]].Epoch
			st := entries[idx[i]].Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "gradient_spike",
				Severity: severity,
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"observed":      observed,
					"window_mean":   mean,
					"window_stddev": std,
					"z_score":       z,
				},
				Source: firstSource(entries[idx[i]]),
			})
		}
	}
	return anomalies
}

func detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {
	var lossEntries []int
	for i, e := range entries {
		if e.Loss != nil {
			lossEntries = append(lossEntries, i)
		}
	}
	if len(lossEntries) < 51 {
		return nil
	}
	var anomalies []types.Anomaly
	for i := 50; i < len(lossEntries); i++ {
		startIdx := lossEntries[i-50]
		endIdx := lossEntries[i]
		start := *entries[startIdx].Loss
		end := *entries[endIdx].Loss
		if math.Abs(start) <= 1e-6 {
			continue
		}
		ratio := (end - start) / math.Abs(start)
		if ratio > 1.0 {
			severity := "high"
			if ratio > 5.0 {
				severity = "critical"
			}
			ep := entries[endIdx].Epoch
			st := entries[endIdx].Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "loss_divergence",
				Severity: severity,
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"loss_start":        start,
					"loss_end":          end,
					"increase_ratio":    ratio,
					"window_start_step": entries[startIdx].Step,
					"window_end_step":   entries[endIdx].Step,
				},
				Source: firstSource(entries[endIdx]),
			})
		}
	}
	return anomalies
}

func detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {
	var anomalies []types.Anomaly
	for i := 1; i < len(entries); i++ {
		prev := entries[i-1]
		cur := entries[i]
		if prev.Lr == nil || cur.Lr == nil {
			continue
		}
		if *cur.Lr > *prev.Lr {
			if cur.Event == "epoch_end" {
				continue
			}
			ep := cur.Epoch
			st := cur.Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "lr_anomaly",
				Severity: "medium",
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"prev_lr": *prev.Lr,
					"curr_lr": *cur.Lr,
					"step":    cur.Step,
				},
				Source: firstSource(cur),
			})
		}
	}
	return anomalies
}

func detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {
	var anomalies []types.Anomaly
	for i := 1; i < len(entries); i++ {
		prev := entries[i-1]
		cur := entries[i]
		if prev.Epoch != cur.Epoch {
			continue
		}
		prevT, err1 := time.Parse(time.RFC3339, prev.Ts)
[?2004hroot@n30009:/app# sed -n '231,340p' internal/forensics/detect.go
[?2004l		curT, err2 := time.Parse(time.RFC3339, cur.Ts)
		if err1 != nil || err2 != nil {
			continue
		}
		diff := curT.Sub(prevT).Seconds()
		if diff > 3600 {
			ep := cur.Epoch
			st := cur.Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "training_gap",
				Severity: "low",
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"after_step":  prev.Step,
					"before_step": cur.Step,
					"after_ts":    prev.Ts,
					"before_ts":   cur.Ts,
					"gap_seconds": diff,
				},
				Source: firstSource(cur),
			})
		}
	}
	return anomalies
}

func detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {
	var cps []types.TimelineEntry
	for _, e := range entries {
		if e.Event == "checkpoint" {
			cps = append(cps, e)
		}
	}
	sortTimeline(cps)
	var anomalies []types.Anomaly
	for i := 1; i < len(cps); i++ {
		prev := cps[i-1]
		cur := cps[i]
		if prev.Acc == nil || cur.Acc == nil {
			continue
		}
		drop := *prev.Acc - *cur.Acc
		if drop > 0.15 {
			ep := cur.Epoch
			st := cur.Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "metric_regression",
				Severity: "high",
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"prev_acc":        *prev.Acc,
					"curr_acc":        *cur.Acc,
					"drop":            drop,
					"prev_checkpoint": prev.Step,
					"curr_checkpoint": cur.Step,
				},
				Source: firstSource(cur),
			})
		}
	}
	return anomalies
}

func detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {
	var anomalies []types.Anomaly
	hashSet := map[string]*types.CheckpointFile{}
	for _, cf := range cps {
		hashSet[cf.FileHash] = cf
	}

	for _, cf := range cps {
		raw, err := os.ReadFile(cf.Path)
		if err != nil {
			continue
		}
		if !cf.HeaderValid {
			stored := uint64(0)
			if len(raw) >= 56 {
				stored = binary.LittleEndian.Uint64(raw[48:56])
			}
			h := fnv.New64a()
			h.Write(raw[:48])
			computed := h.Sum64()
			anomalies = append(anomalies, types.Anomaly{
				Type:     "header_checksum_mismatch",
				Severity: "critical",
				Details: map[string]interface{}{
					"file":              cf.Filename,
					"expected_checksum": fmt.Sprintf("%016x", stored),
					"actual_checksum":   fmt.Sprintf("%016x", computed),
				},
				Source:     cf.Filename,
				Checkpoint: cf.Filename,
			})
		}

		for _, t := range cf.Tensors {
			if !t.Valid {
				computed := sha256.Sum256(t.Data)
				anomalies = append(anomalies, types.Anomaly{
					Type:     "tensor_checksum_mismatch",
					Severity: "critical",
					Details: map[string]interface{}{
						"file":              cf.Filename,
						"tensor_name":       t.Name,
						"expected_checksum": hex.EncodeToString(t.Hash[:]),
						"actual_checksum":   hex.EncodeToString(computed[:]),
					},
[?2004hroot@n30009:/app# sed -n '341,470p' internal/forensics/detect.go
[?2004l					Source:     cf.Filename,
					Checkpoint: cf.Filename,
				})
			}
		}

		if cf.Signed {
			valid, signer := signatureDetails(cf.Path)
			if !valid {
				anomalies = append(anomalies, types.Anomaly{
					Type:     "signature_invalid",
					Severity: "critical",
					Details: map[string]interface{}{
						"file":      cf.Filename,
						"signer_id": signer,
						"valid":     false,
					},
					Source:     cf.Filename,
					Checkpoint: cf.Filename,
				})
			}
		}

		if cf.Provenance != nil && cf.Provenance.ParentHash != "" {
			_, found := hashSet[cf.Provenance.ParentHash]
			if !found {
				anomalies = append(anomalies, types.Anomaly{
					Type:     "provenance_chain_break",
					Severity: "high",
					Details: map[string]interface{}{
						"file":        cf.Filename,
						"parent_hash": cf.Provenance.ParentHash,
						"found":       false,
					},
					Source:     cf.Filename,
					Checkpoint: cf.Filename,
				})
			}
		}
	}

	anomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)
	return anomalies
}

func detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {
	byHash := map[string]*types.CheckpointFile{}
	for _, cf := range cps {
		byHash[cf.FileHash] = cf
	}
	children := map[string][]string{}
	for _, cf := range cps {
		if cf.Provenance != nil && cf.Provenance.ParentHash != "" {
			if _, ok := byHash[cf.Provenance.ParentHash]; ok {
				children[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)
			}
		}
	}

	var anomalies []types.Anomaly
	seen := map[string]bool{}
	for _, cf := range cps {
		if cf.Provenance == nil {
			continue
		}
		root := cf.FileHash
		for root != "" {
			parent, ok := byHash[root]
			if !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == "" {
				break
			}
			root = parent.Provenance.ParentHash
		}
		if seen[root] {
			continue
		}
		seen[root] = true

		chain := []string{}
		queue := []string{root}
		visited := map[string]bool{}
		for len(queue) > 0 {
			cur := queue[0]
			queue = queue[1:]
			if visited[cur] {
				continue
			}
			visited[cur] = true
			node, ok := byHash[cur]
			if !ok || node == nil {
				continue
			}
			chain = append(chain, node.Filename)
			queue = append(queue, children[cur]...)
		}
		sort.Strings(chain)

		hashes := map[string]struct{}{}
		for _, h := range chain {
			if node, ok := byHashFile(cps, h); ok && node.Provenance != nil {
				hashes[node.Provenance.DatasetHash] = struct{}{}
			}
		}
		if len(hashes) > 1 {
			unique := make([]string, 0, len(hashes))
			for h := range hashes {
				unique = append(unique, h)
			}
			sort.Strings(unique)
			anomalies = append(anomalies, types.Anomaly{
				Type:     "dataset_hash_inconsistency",
				Severity: "high",
				Details: map[string]interface{}{
					"files":  chain,
					"hashes": unique,
				},
				Source: chain[0],
			})
		}
	}
	return anomalies
}

func byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {
	for _, cf := range cps {
		if cf.Filename == file {
			return cf, true
		}
	}
	return nil, false
