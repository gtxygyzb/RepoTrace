[?2004lpackage forensics

import (
	"crypto/hmac"
	"crypto/sha256"
	"encoding/binary"
	"encoding/hex"
	"fmt"
	"hash/fnv"
	"math"
	"os"
	"sort"
	"time"

	"mlforge/internal/checkpoint"
	"mlforge/internal/types"
)

func loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {
	ap, err := DiscoverArtifacts(dir)
	if err != nil {
		return nil, err
	}
	var cps []*types.CheckpointFile
	for _, p := range ap.Checkpoints {
		cf, err := checkpoint.Parse(p)
		if err != nil || cf == nil {
			continue
		}
		cps = append(cps, cf)
	}
	sort.Slice(cps, func(i, j int) bool {
		return cps[i].Filename < cps[j].Filename
	})
	return cps, nil
}

type DetectOutput struct {
	Status    string          `json:"status"`
	Anomalies []types.Anomaly `json:"anomalies"`
	Summary   struct {
		Total      int            `json:"total"`
		BySeverity map[string]int `json:"by_severity"`
		ByType     map[string]int `json:"by_type"`
	} `json:"summary"`
}

func BuildDetect(dir string) (interface{}, error) {
	return buildDetectWithDir(dir)
}

func buildDetectWithDir(dir string) (DetectOutput, error) {
	var out DetectOutput
	out.Status = "ok"
	var anomalies []types.Anomaly

	entries, _, err := loadTimelineEntries(dir)
	if err == nil {
		merged, _ := mergeTimeline(entries)
		sortTimeline(merged)
		anomalies = append(anomalies, detectTimelineAnomalies(merged)...)
	}

	cps, err := loadCheckpoints(dir)
	if err == nil {
		anomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)
	}

	for i := range anomalies {
		anomalies[i].ID = fmt.Sprintf("ANOM-%03d", i+1)
	}
	sortAnomalies(anomalies)

	out.Anomalies = anomalies
	if out.Anomalies == nil {
		out.Anomalies = []types.Anomaly{}
	}
	out.Summary.Total = len(anomalies)
	out.Summary.BySeverity = map[string]int{"critical": 0, "high": 0, "medium": 0, "low": 0}
	out.Summary.ByType = map[string]int{}
	for _, a := range anomalies {
		out.Summary.BySeverity[a.Severity]++
		out.Summary.ByType[a.Type]++
	}
	return out, nil
}

func detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {
	var anomalies []types.Anomaly
	anomalies = append(anomalies, detectGradientSpikes(entries)...)
	anomalies = append(anomalies, detectLossDivergence(entries)...)
	anomalies = append(anomalies, detectLrAnomalies(entries)...)
	anomalies = append(anomalies, detectTrainingGaps(entries)...)
	anomalies = append(anomalies, detectMetricRegression(entries)...)
	return anomalies
}

func detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {
	var vals []float64
	var idx []int
	for i, e := range entries {
		if e.GradNorm != nil {
			vals = append(vals, *e.GradNorm)
			idx = append(idx, i)
		}
	}
	if len(vals) < 31 {
		return nil
	}
	var anomalies []types.Anomaly
	for i := 30; i < len(vals); i++ {
		window := vals[i-30 : i]
		mean := meanFloats(window)
		std := stddevFloats(window, mean)
		observed := vals[i]
		z := 0.0
		if std > 0 {
			z = (observed - mean) / std
		}
		if observed > mean+2.5*std && z > 2.5 {
			severity := "medium"
			if z > 4.0 {
				severity = "high"
			}
			ep := entries[idx[i]].Epoch
			st := entries[idx[i]].Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "gradient_spike",
				Severity: severity,
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"observed":      observed,
					"window_mean":   mean,
					"window_stddev": std,
					"z_score":       z,
				},
				Source: firstSource(entries[idx[i]]),
			})
		}
	}
	return anomalies
}

func detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {
	var lossEntries []int
	for i, e := range entries {
		if e.Loss != nil {
			lossEntries = append(lossEntries, i)
		}
	}
	if len(lossEntries) < 51 {
		return nil
	}
	var anomalies []types.Anomaly
	for i := 50; i < len(lossEntries); i++ {
		startIdx := lossEntries[i-50]
		endIdx := lossEntries[i]
		start := *entries[startIdx].Loss
		end := *entries[endIdx].Loss
		if math.Abs(start) <= 1e-6 {
			continue
		}
		ratio := (end - start) / math.Abs(start)
		if ratio > 1.0 {
			severity := "high"
			if ratio > 5.0 {
				severity = "critical"
			}
			ep := entries[endIdx].Epoch
			st := entries[endIdx].Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "loss_divergence",
				Severity: severity,
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"loss_start":        start,
					"loss_end":          end,
					"increase_ratio":    ratio,
					"window_start_step": entries[startIdx].Step,
					"window_end_step":   entries[endIdx].Step,
				},
				Source: firstSource(entries[endIdx]),
			})
		}
	}
	return anomalies
}

func detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {
	var anomalies []types.Anomaly
	for i := 1; i < len(entries); i++ {
		prev := entries[i-1]
		cur := entries[i]
		if prev.Lr == nil || cur.Lr == nil {
			continue
		}
		if *cur.Lr > *prev.Lr {
			if cur.Event == "epoch_end" {
				continue
			}
			ep := cur.Epoch
			st := cur.Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "lr_anomaly",
				Severity: "medium",
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"prev_lr": *prev.Lr,
					"curr_lr": *cur.Lr,
					"step":    cur.Step,
				},
				Source: firstSource(cur),
			})
		}
	}
	return anomalies
}

func detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {
	var anomalies []types.Anomaly
	for i := 1; i < len(entries); i++ {
		prev := entries[i-1]
		cur := entries[i]
		if prev.Epoch != cur.Epoch {
			continue
		}
		prevT, err1 := time.Parse(time.RFC3339, prev.Ts)
		curT, err2 := time.Parse(time.RFC3339, cur.Ts)
		if err1 != nil || err2 != nil {
			continue
		}
		diff := curT.Sub(prevT).Seconds()
		if diff > 3600 {
			ep := cur.Epoch
			st := cur.Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "training_gap",
				Severity: "low",
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"after_step":  prev.Step,
					"before_step": cur.Step,
					"after_ts":    prev.Ts,
					"before_ts":   cur.Ts,
					"gap_seconds": diff,
				},
				Source: firstSource(cur),
			})
		}
	}
	return anomalies
}

func detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {
	var cps []types.TimelineEntry
	for _, e := range entries {
		if e.Event == "checkpoint" {
			cps = append(cps, e)
		}
	}
	sortTimeline(cps)
	var anomalies []types.Anomaly
	for i := 1; i < len(cps); i++ {
		prev := cps[i-1]
		cur := cps[i]
		if prev.Acc == nil || cur.Acc == nil {
			continue
		}
		drop := *prev.Acc - *cur.Acc
		if drop > 0.15 {
			ep := cur.Epoch
			st := cur.Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "metric_regression",
				Severity: "high",
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"prev_acc":        *prev.Acc,
					"curr_acc":        *cur.Acc,
					"drop":            drop,
					"prev_checkpoint": prev.Step,
					"curr_checkpoint": cur.Step,
				},
				Source: firstSource(cur),
			})
		}
	}
	return anomalies
}

func detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {
	var anomalies []types.Anomaly
	hashSet := map[string]*types.CheckpointFile{}
	for _, cf := range cps {
		hashSet[cf.FileHash] = cf
	}

	for _, cf := range cps {
		raw, err := os.ReadFile(cf.Path)
		if err != nil {
			continue
		}
		if !cf.HeaderValid {
			stored := uint64(0)
			if len(raw) >= 56 {
				stored = binary.LittleEndian.Uint64(raw[48:56])
			}
			h := fnv.New64a()
			h.Write(raw[:48])
			computed := h.Sum64()
			anomalies = append(anomalies, types.Anomaly{
				Type:     "header_checksum_mismatch",
				Severity: "critical",
				Details: map[string]interface{}{
					"file":              cf.Filename,
[?2004hroot@n30009:/app# sed -n '1,320p' cmd/mlforge/main.go
[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"strings"

	"mlforge/internal/forensics"
)

func main() {
	// --- Parse flags ---------------------------------------------------
	format := "json"
	verbose := false
	var positional []string

	for _, arg := range os.Args[1:] {
		switch {
		case arg == "--verbose":
			verbose = true
		case strings.HasPrefix(arg, "--format="):
			format = strings.TrimPrefix(arg, "--format=")
		case arg == "--format":
		// handled below as two-token flag
		default:
			positional = append(positional, arg)
		}
	}

	// Handle "--format json" (two separate tokens)
	for i := 1; i < len(os.Args)-1; i++ {
		if os.Args[i] == "--format" {
			format = os.Args[i+1]
			// Remove the value from positional args
			filtered := positional[:0]
			for _, p := range positional {
				if p != os.Args[i+1] {
					filtered = append(filtered, p)
				}
			}
			positional = filtered
			break
		}
	}

	if format != "json" && format != "text" {
		fmt.Fprintf(os.Stderr, "invalid format %q: must be json or text\n", format)
		os.Exit(1)
	}

	_ = verbose // reserved for diagnostic output

	// --- Validate positional args --------------------------------------
	if len(positional) < 2 {
		fmt.Fprintf(os.Stderr, "Usage: mlforge <command> <evidence-dir> [args...]\n")
		os.Exit(1)
	}

	cmd := positional[0]
	dir := positional[1]

	// --- Route to command handler --------------------------------------
	var result interface{}
	var err error

	switch cmd {
	case "ingest":
		result, err = forensics.BuildIngest(dir)
	case "timeline":
		result, err = forensics.BuildTimeline(dir)
	case "verify":
		result, err = forensics.BuildVerify(dir)
	case "detect":
		result, err = forensics.BuildDetect(dir)
	case "lineage":
		result, err = forensics.BuildLineage(dir)
	case "query":
		if len(positional) < 3 {
			fmt.Fprintf(os.Stderr, "Usage: mlforge query <dir> \"<expression>\"\n")
			os.Exit(1)
		}
		result, err = forensics.BuildQuery(dir, positional[2])
	case "diff":
		if len(positional) < 4 {
			fmt.Fprintf(os.Stderr, "Usage: mlforge diff <dir> <file1> <file2>\n")
			os.Exit(1)
		}
		result, err = forensics.BuildDiff(dir, positional[2], positional[3])
	case "report":
		result, err = forensics.BuildReport(dir)
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
		os.Exit(1)
	}

	// --- Output --------------------------------------------------------
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	if format == "text" {
		printText(result)
		return
	}

	out, marshalErr := json.MarshalIndent(result, "", "  ")
	if marshalErr != nil {
		fmt.Fprintf(os.Stderr, "error marshalling result: %v\n", marshalErr)
		os.Exit(1)
	}
	fmt.Println(string(out))
}

func printText(v interface{}) {
	b, err := json.MarshalIndent(v, "", "  ")
	if err != nil {
		fmt.Fprintln(os.Stderr, "error rendering text output")
		return
	}
	fmt.Println(string(b))
}
