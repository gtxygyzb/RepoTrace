   549			si := -1
   550			if a[i].Step != nil {
   551				si = *a[i].Step
   552			}
   553			sj := -1
   554			if a[j].Step != nil {
   555				sj = *a[j].Step
   556			}
   557			return si < sj
   558		})
   559	}
