   183	        "tensor_name": "encoder.layer2.weight",
   184	        "expected_checksum": "abcd1234...",
   185	        "actual_checksum": "efgh5678..."
   186	      },
   187	      "source": "model_epoch3.mlck"
   188	    }
   189	  ],
   190	  "summary": {
   191	    "total": 5,
   192	    "by_severity": {
   193	      "critical": 1,
   194	      "high": 2,
   195	      "medium": 1,
   196	      "low": 1
   197	    },
   198	    "by_type": {
   199	      "gradient_spike": 1,
   200	      "loss_divergence": 1,
   201	      "tensor_checksum_mismatch": 1,
   202	      "training_gap": 1,
   203	      "lr_anomaly": 1
   204	    }
   205	  }
   206	}
   207	```
   208	
   209	**Field rules:**
   210	- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.
   211	- `anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.
   212	- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.
   213	- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.
   214	- `source`: the artifact file where the anomaly was detected.
   215	- `epoch` and `step`: present only for timeline-based anomalies.
   216	- If no anomalies are detected, `anomalies` is an empty array.
   217	
