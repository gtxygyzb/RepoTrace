     7		"strconv"
     8		"strings"
     9	
    10		"mlforge/internal/forensics"
    11	)
    12	
    13	func main() {
    14		// --- Parse flags ---------------------------------------------------
    15		format := "json"
    16		verbose := false
    17		filterSeverity := ""
    18		var positional []string
    19	
    20		args := os.Args[1:]
    21		for i := 0; i < len(args); i++ {
    22			arg := args[i]
    23			switch {
    24			case arg == "--verbose":
    25				verbose = true
    26			case strings.HasPrefix(arg, "--format="):
    27				format = strings.TrimPrefix(arg, "--format=")
    28			case arg == "--format":
    29				if i+1 >= len(args) {
    30					fmt.Fprintf(os.Stderr, "flag --format requires a value\n")
    31					os.Exit(1)
    32				}
    33				i++
    34				format = args[i]
    35			case strings.HasPrefix(arg, "--filter-severity="):
    36				filterSeverity = strings.TrimPrefix(arg, "--filter-severity=")
    37			case arg == "--filter-severity":
    38				if i+1 >= len(args) {
    39					fmt.Fprintf(os.Stderr, "flag --filter-severity requires a value\n")
    40					os.Exit(1)
    41				}
    42				i++
    43				filterSeverity = args[i]
    44			default:
    45				positional = append(positional, arg)
    46			}
    47		}
    48	
    49		switch format {
    50		case "json", "text", "csv":
    51		default:
    52			fmt.Fprintf(os.Stderr, "invalid format %q: must be json, text, or csv\n", format)
    53			os.Exit(1)
    54		}
    55	
    56		_ = verbose // reserved for diagnostic output
    57	
    58		// --- Validate positional args --------------------------------------
    59		if len(positional) < 2 {
    60			fmt.Fprintf(os.Stderr, "Usage: mlforge <command> <evidence-dir> [args...]\n")
    61			os.Exit(1)
    62		}
    63	
    64		cmd := positional[0]
    65		dir := positional[1]
    66	
    67		if format == "csv" && cmd != "detect" {
    68			fmt.Fprintf(os.Stderr, "invalid format csv: csv output is only supported for detect\n")
    69			os.Exit(1)
    70		}
    71		if filterSeverity != "" && cmd != "detect" {
    72			fmt.Fprintf(os.Stderr, "--filter-severity is only supported for detect\n")
    73			os.Exit(1)
    74		}
    75	
    76		// --- Route to command handler --------------------------------------
    77		var result interface{}
    78		var err error
    79	
    80		switch cmd {
    81		case "ingest":
    82			result, err = forensics.BuildIngest(dir)
    83		case "timeline":
    84			result, err = forensics.BuildTimeline(dir)
    85		case "verify":
    86			result, err = forensics.BuildVerify(dir)
    87		case "detect":
    88			detectResult, detectErr := forensics.BuildDetectFiltered(dir, filterSeverity)
    89			if detectErr != nil {
    90				err = detectErr
    91			} else {
    92				if format == "csv" {
    93					printDetectCSV(detectResult)
    94					return
    95				}
    96				result = detectResult
    97			}
    98		case "lineage":
    99			result, err = forensics.BuildLineage(dir)
   100		case "query":
   101			if len(positional) < 3 {
   102				fmt.Fprintf(os.Stderr, "Usage: mlforge query <dir> \"<expression>\"\n")
   103				os.Exit(1)
   104			}
   105			result, err = forensics.BuildQuery(dir, positional[2])
   106		case "diff":
   107			if len(positional) < 4 {
   108				fmt.Fprintf(os.Stderr, "Usage: mlforge diff <dir> <file1> <file2>\n")
   109				os.Exit(1)
   110			}
   111			result, err = forensics.BuildDiff(dir, positional[2], positional[3])
   112		case "report":
   113			result, err = forensics.BuildReport(dir)
   114		default:
   115			fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
   116			os.Exit(1)
   117		}
   118	
   119		// --- Output --------------------------------------------------------
   120		if err != nil {
   121			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   122			os.Exit(1)
   123		}
   124	
   125		if format == "text" {
   126			printText(result)
   127			return
   128		}
   129	
   130		out, marshalErr := json.MarshalIndent(result, "", "  ")
   131		if marshalErr != nil {
   132			fmt.Fprintf(os.Stderr, "error marshalling result: %v\n", marshalErr)
   133			os.Exit(1)
   134		}
   135		fmt.Println(string(out))
   136	}
