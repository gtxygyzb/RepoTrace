[?2004l     1	package main
     2	
     3	import (
     4		"encoding/json"
     5		"fmt"
     6		"os"
     7		"strings"
     8	
     9		"mlforge/internal/forensics"
    10	)
    11	
    12	func main() {
    13		// --- Parse flags ---------------------------------------------------
    14		format := "json"
    15		verbose := false
    16		var positional []string
    17	
    18		for _, arg := range os.Args[1:] {
    19			switch {
    20			case arg == "--verbose":
    21				verbose = true
    22			case strings.HasPrefix(arg, "--format="):
    23				format = strings.TrimPrefix(arg, "--format=")
    24			case arg == "--format":
    25			// handled below as two-token flag
    26			default:
    27				positional = append(positional, arg)
    28			}
    29		}
    30	
    31		// Handle "--format json" (two separate tokens)
    32		for i := 1; i < len(os.Args)-1; i++ {
    33			if os.Args[i] == "--format" {
    34				format = os.Args[i+1]
    35				// Remove the value from positional args
    36				filtered := positional[:0]
    37				for _, p := range positional {
    38					if p != os.Args[i+1] {
    39						filtered = append(filtered, p)
    40					}
    41				}
    42				positional = filtered
    43				break
    44			}
    45		}
    46	
    47		if format != "json" && format != "text" {
    48			fmt.Fprintf(os.Stderr, "invalid format %q: must be json or text\n", format)
    49			os.Exit(1)
    50		}
    51	
    52		_ = verbose // reserved for diagnostic output
    53	
    54		// --- Validate positional args --------------------------------------
    55		if len(positional) < 2 {
    56			fmt.Fprintf(os.Stderr, "Usage: mlforge <command> <evidence-dir> [args...]\n")
    57			os.Exit(1)
    58		}
    59	
    60		cmd := positional[0]
    61		dir := positional[1]
    62	
    63		// --- Route to command handler --------------------------------------
    64		var result interface{}
    65		var err error
    66	
    67		switch cmd {
