   295	
   296	func detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {
   297		var anomalies []types.Anomaly
   298		hashSet := map[string]*types.CheckpointFile{}
   299		for _, cf := range cps {
   300			hashSet[cf.FileHash] = cf
   301		}
   302	
   303		for _, cf := range cps {
   304			raw, err := os.ReadFile(cf.Path)
   305			if err != nil {
   306				continue
   307			}
   308			if !cf.HeaderValid {
   309				stored := uint64(0)
   310				if len(raw) >= 56 {
   311					stored = binary.LittleEndian.Uint64(raw[48:56])
   312				}
   313				h := fnv.New64a()
   314				h.Write(raw[:48])
   315				computed := h.Sum64()
   316				anomalies = append(anomalies, types.Anomaly{
   317					Type:     "header_checksum_mismatch",
   318					Severity: "critical",
   319					Details: map[string]interface{}{
   320						"file":              cf.Filename,
   321						"expected_checksum": fmt.Sprintf("%016x", stored),
   322						"actual_checksum":   fmt.Sprintf("%016x", computed),
   323					},
   324					Source: cf.Filename,
   325				})
   326			}
   327	
   328			for _, t := range cf.Tensors {
   329				if !t.Valid {
   330					computed := sha256.Sum256(t.Data)
   331					anomalies = append(anomalies, types.Anomaly{
   332						Type:     "tensor_checksum_mismatch",
   333						Severity: "critical",
   334						Details: map[string]interface{}{
   335							"file":              cf.Filename,
   336							"tensor_name":       t.Name,
   337							"expected_checksum": hex.EncodeToString(t.Hash[:]),
   338							"actual_checksum":   hex.EncodeToString(computed[:]),
   339						},
   340						Source: cf.Filename,
   341					})
   342				}
   343			}
   344	
   345			if cf.Signed {
   346				valid, signer := signatureDetails(cf.Path)
   347				if !valid {
   348					anomalies = append(anomalies, types.Anomaly{
   349						Type:     "signature_invalid",
   350						Severity: "critical",
   351						Details: map[string]interface{}{
   352							"file":      cf.Filename,
   353							"signer_id": signer,
   354							"valid":     false,
   355						},
   356						Source: cf.Filename,
   357					})
   358				}
   359			}
   360	
   361			if cf.Provenance != nil && cf.Provenance.ParentHash != "" {
   362				_, found := hashSet[cf.Provenance.ParentHash]
   363				if !found {
   364					anomalies = append(anomalies, types.Anomaly{
   365						Type:     "provenance_chain_break",
   366						Severity: "high",
   367						Details: map[string]interface{}{
   368							"file":        cf.Filename,
   369							"parent_hash": cf.Provenance.ParentHash,
   370							"found":       false,
   371						},
   372						Source: cf.Filename,
   373					})
   374				}
   375			}
   376		}
   377	
   378		anomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)
   379		return anomalies
   380	}
   381	
   382	func detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {
   383		byHash := map[string]*types.CheckpointFile{}
   384		for _, cf := range cps {
   385			byHash[cf.FileHash] = cf
   386		}
   387		children := map[string][]string{}
   388		for _, cf := range cps {
   389			if cf.Provenance != nil && cf.Provenance.ParentHash != "" {
   390				if _, ok := byHash[cf.Provenance.ParentHash]; ok {
   391					children[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)
   392				}
   393			}
   394		}
   395	
   396		var anomalies []types.Anomaly
   397		seen := map[string]bool{}
   398		for _, cf := range cps {
   399			if cf.Provenance == nil {
   400				continue
   401			}
   402			root := cf.FileHash
   403			for root != "" {
   404				parent, ok := byHash[root]
   405				if !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == "" {
   406					break
   407				}
   408				root = parent.Provenance.ParentHash
   409			}
   410			if seen[root] {
   411				continue
   412			}
   413			seen[root] = true
   414	
   415			chain := []string{}
   416			queue := []string{root}
   417			visited := map[string]bool{}
   418			for len(queue) > 0 {
   419				cur := queue[0]
   420				queue = queue[1:]
   421				if visited[cur] {
   422					continue
   423				}
   424				visited[cur] = true
   425				node, ok := byHash[cur]
   426				if !ok || node == nil {
   427					continue
   428				}
   429				chain = append(chain, node.Filename)
   430				queue = append(queue, children[cur]...)
   431			}
   432			sort.Strings(chain)
   433	
   434			hashes := map[string]struct{}{}
   435			for _, h := range chain {
   436				if node, ok := byHashFile(cps, h); ok && node.Provenance != nil {
   437					hashes[node.Provenance.DatasetHash] = struct{}{}
   438				}
   439			}
   440			if len(hashes) > 1 {
   441				unique := make([]string, 0, len(hashes))
   442				for h := range hashes {
   443					unique = append(unique, h)
   444				}
   445				sort.Strings(unique)
   446				anomalies = append(anomalies, types.Anomaly{
   447					Type:     "dataset_hash_inconsistency",
   448					Severity: "high",
   449					Details: map[string]interface{}{
   450						"files":  chain,
   451						"hashes": unique,
   452					},
   453					Source: chain[0],
   454				})
   455			}
   456		}
   457		return anomalies
   458	}
   459	
   460	func byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {
   461		for _, cf := range cps {
   462			if cf.Filename == file {
   463				return cf, true
   464			}
   465		}
   466		return nil, false
   467	}
   468	
   469	func signatureDetails(path string) (bool, string) {
   470		raw, err := os.ReadFile(path)
   471		if err != nil || len(raw) < 56 {
   472			return false, ""
   473		}
   474		sigOff := binary.LittleEndian.Uint64(raw[32:40])
   475		if sigOff == 0 || int(sigOff) >= len(raw) || int(sigOff)+5 > len(raw) {
   476			return false, ""
   477		}
   478		off := int(sigOff)
   479		off++ // algorithm
   480		signerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   481		off += 2
   482		if off+signerLen+2 > len(raw) {
   483			return false, ""
   484		}
   485		signerID := string(raw[off : off+signerLen])
   486		off += signerLen
   487		sigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   488		off += 2
   489		if off+sigLen > len(raw) {
   490			return false, signerID
   491		}
   492		stored := raw[off : off+sigLen]
   493		mac := hmac.New(sha256.New, []byte(signerID))
   494		mac.Write(raw[:sigOff])
   495		expected := mac.Sum(nil)
   496		return hmac.Equal(expected, stored), signerID
   497	}
   498	
   499	func firstSource(e types.TimelineEntry) string {
   500		if len(e.Sources) > 0 {
   501			return e.Sources[0]
   502		}
   503		return ""
   504	}
   505	
   506	func meanFloats(v []float64) float64 {
   507		if len(v) == 0 {
   508			return 0
   509		}
   510		s := 0.0
   511		for _, x := range v {
   512			s += x
   513		}
   514		return s / float64(len(v))
   515	}
   516	
   517	func stddevFloats(v []float64, mean float64) float64 {
   518		if len(v) == 0 {
   519			return 0
   520		}
   521		s := 0.0
   522		for _, x := range v {
   523			d := x - mean
   524			s += d * d
   525		}
   526		return math.Sqrt(s / float64(len(v)))
   527	}
   528	
   529	func sortAnomalies(a []types.Anomaly) {
   530		rank := map[string]int{"critical": 0, "high": 1, "medium": 2, "low": 3}
   531		sort.Slice(a, func(i, j int) bool {
   532			ri := rank[a[i].Severity]
   533			rj := rank[a[j].Severity]
   534			if ri != rj {
   535				return ri < rj
   536			}
   537			ei := -1
   538			ej := -1
   539			if a[i].Epoch != nil {
   540				ei = *a[i].Epoch
   541			}
   542			ej = -1
   543			if a[j].Epoch != nil {
   544				ej = *a[j].Epoch
   545			}
   546			if ei != ej {
   547				return ei < ej
   548			}
   549			si := -1
   550			if a[i].Step != nil {
   551				si = *a[i].Step
   552			}
   553			sj := -1
   554			if a[j].Step != nil {
   555				sj = *a[j].Step
   556			}
   557			return si < sj
   558		})
   559	}
