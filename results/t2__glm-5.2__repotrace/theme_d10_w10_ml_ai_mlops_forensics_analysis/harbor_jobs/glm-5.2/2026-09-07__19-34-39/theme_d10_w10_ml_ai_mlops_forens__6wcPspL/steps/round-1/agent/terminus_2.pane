   334	func validateSignature(path string) (bool, error) {
   335		raw, err := os.ReadFile(path)
   336		if err != nil || len(raw) < 56 {
   337			return false, err
   338		}
   339		sigOff := binary.LittleEndian.Uint64(raw[32:40])
   340		if sigOff == 0 || int(sigOff) >= len(raw) {
   341			return false, nil
   342		}
   343		if int(sigOff)+5 > len(raw) {
   344			return false, nil
   345		}
   346		off := int(sigOff)
   347		_ = raw[off] // algorithm
   348		off++
   349		signerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   350		off += 2
   351		if off+signerLen+2 > len(raw) {
   352			return false, nil
   353		}
   354		signerID := string(raw[off : off+signerLen])
   355		off += signerLen
   356		sigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   357		off += 2
   358		if off+sigLen > len(raw) {
   359			return false, nil
   360		}
   361		storedSig := raw[off : off+sigLen]
   362		mac := hmac.New(sha256.New, []byte(signerID))
   363		mac.Write(raw[:sigOff])
   364		expected := mac.Sum(nil)
   365		return hmac.Equal(expected, storedSig), nil
   366	}
