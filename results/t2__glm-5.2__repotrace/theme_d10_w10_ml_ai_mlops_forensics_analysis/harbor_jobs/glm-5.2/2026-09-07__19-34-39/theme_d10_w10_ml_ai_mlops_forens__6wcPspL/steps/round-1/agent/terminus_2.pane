\t\t\t\t\t},
\t\t\t\t\tEvidence: map[string]interface{}{"window_values": precedingLossValues(entries, lossEntries, i, 5)},
\t\t\t\t\tSource:   firstSource(entries[lossEntries[i]]),
\t\t\t\t})
\t\t\t}
\t\t}
\t\temaLoss = (1-alpha)*emaLoss + alpha*currentLoss
\t}
\treturn anomalies
}

'''

