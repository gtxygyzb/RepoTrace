   184	type TimelineOutput struct {
   185		Status            string                `json:"status"`
   186		TotalEntries      int                   `json:"total_entries"`
   187		TotalEpochs       int                   `json:"total_epochs"`
   188		StepRange         []int                 `json:"step_range"`
   189		TimeRange         []string              `json:"time_range"`
   190		ConflictsResolved int                   `json:"conflicts_resolved"`
   191		Gaps              []TimelineGap         `json:"gaps"`
   192		Entries           []types.TimelineEntry `json:"entries"`
   193	}
   194	
   195	func BuildTimeline(dir string) (interface{}, error) {
   196		entries, shards, err := loadTimelineEntries(dir)
   197		if err != nil {
   198			return nil, err
   199		}
   200		return buildTimelineFromEntries(entries, shards), nil
   201	}
   202	
   203	func buildTimelineFromEntries(entries []types.TimelineEntry, shards []logparser.ShardInfo) TimelineOutput {
   204		merged, conflicts := mergeTimeline(entries)
   205		sortTimeline(merged)
   206		gaps := detectGaps(merged)
   207	
   208		out := TimelineOutput{
   209			Status:            "ok",
   210			TotalEntries:      len(merged),
   211			ConflictsResolved: conflicts,
   212			Gaps:              gaps,
   213			Entries:           merged,
   214		}
   215		if len(merged) > 0 {
   216			minStep, maxStep := merged[0].Step, merged[0].Step
   217			minTs, maxTs := merged[0].Ts, merged[0].Ts
   218			epochSet := map[int]struct{}{}
   219			for _, e := range merged {
   220				epochSet[e.Epoch] = struct{}{}
   221				if e.Step < minStep {
   222					minStep = e.Step
   223				}
   224				if e.Step > maxStep {
   225					maxStep = e.Step
   226				}
   227				if e.Ts < minTs {
   228					minTs = e.Ts
   229				}
   230				if e.Ts > maxTs {
   231					maxTs = e.Ts
   232				}
   233			}
   234			out.TotalEpochs = len(epochSet)
   235			out.StepRange = []int{minStep, maxStep}
   236			out.TimeRange = []string{minTs, maxTs}
   237		}
   238		if out.Gaps == nil {
   239			out.Gaps = []TimelineGap{}
   240		}
   241		if out.Entries == nil {
   242			out.Entries = []types.TimelineEntry{}
   243		}
   244		return out
   245	}
