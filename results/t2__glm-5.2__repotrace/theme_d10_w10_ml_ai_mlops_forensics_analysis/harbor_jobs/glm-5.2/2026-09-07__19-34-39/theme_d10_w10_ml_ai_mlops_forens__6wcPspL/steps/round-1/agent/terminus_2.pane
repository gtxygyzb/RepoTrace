    77	func (c condition) eval(e types.TimelineEntry) bool {
    78		switch c.field {
    79		case "step":
    80			return compareNum(float64(e.Step), c)
    81		case "epoch":
    82			return compareNum(float64(e.Epoch), c)
    83		case "loss":
    84			return ptrCompareNum(e.Loss, c)
    85		case "lr":
    86			return ptrCompareNum(e.Lr, c)
    87		case "grad_norm":
    88			return ptrCompareNum(e.GradNorm, c)
    89		case "acc":
    90			return ptrCompareNum(e.Acc, c)
    91		case "event":
    92			return compareStr(e.Event, c)
    93		case "ts":
    94			return compareTs(e.Ts, c)
    95		}
    96		return false
    97	}
    98	
    99	func compareNum(val float64, c condition) bool {
   100		if !c.isNum {
   101			return false
   102		}
   103		switch c.op {
   104		case ">":
   105			return val > c.fval
   106		case "<":
   107			return val < c.fval
   108		case ">=":
   109			return val >= c.fval
   110		case "<=":
   111			return val <= c.fval
   112		case "==":
   113			return absFloat(val-c.fval) <= 1e-9
   114		case "!=":
   115			return absFloat(val-c.fval) > 1e-9
   116		}
   117		return false
   118	}
