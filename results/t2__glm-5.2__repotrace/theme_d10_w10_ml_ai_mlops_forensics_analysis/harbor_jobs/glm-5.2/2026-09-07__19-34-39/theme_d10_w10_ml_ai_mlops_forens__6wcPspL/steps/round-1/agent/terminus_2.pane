    10	func main() {
    11		// --- Parse flags ---------------------------------------------------
    12		format := "json"
    13		verbose := false
    14		var positional []string
    15	
    16		for _, arg := range os.Args[1:] {
    17			switch {
    18			case arg == "--verbose":
    19				verbose = true
    20			case strings.HasPrefix(arg, "--format="):
    21				format = strings.TrimPrefix(arg, "--format=")
    22			case arg == "--format":
    23				// handled below as two-token flag
    24			default:
    25				positional = append(positional, arg)
    26			}
    27		}
    28	
    29		// Handle "--format json" (two separate tokens)
    30		for i := 1; i < len(os.Args)-1; i++ {
    31			if os.Args[i] == "--format" {
    32				format = os.Args[i+1]
    33				// Remove the value from positional args
    34				filtered := positional[:0]
    35				for _, p := range positional {
    36					if p != os.Args[i+1] {
    37						filtered = append(filtered, p)
    38					}
    39				}
    40				positional = filtered
    41				break
    42			}
    43		}
    44	
    45		if format != "json" && format != "text" {
    46			fmt.Fprintf(os.Stderr, "invalid format %q: must be json or text\n", format)
    47			os.Exit(1)
    48		}
    49	
    50		_ = verbose // will be used by command implementations later
    51	
    52		// --- Validate positional args --------------------------------------
    53		if len(positional) < 2 {
    54			fmt.Fprintf(os.Stderr, "Usage: mlforge <command> <evidence-dir> [args...]\n")
    55			os.Exit(1)
    56		}
    57	
    58		cmd := positional[0]
    59		dir := positional[1]
    60	
    61		// --- Route to command handler --------------------------------------
    62		var result interface{}
    63		var err error
    64	
    65		switch cmd {
    66		case "ingest":
    67			result, err = buildIngest(dir)
    68		case "timeline":
    69			result, err = buildTimeline(dir)
    70		case "verify":
    71			result, err = buildVerify(dir)
    72		case "detect":
    73			result, err = buildDetect(dir)
    74		case "lineage":
    75			result, err = buildLineage(dir)
    76		case "query":
    77			if len(positional) < 3 {
    78				fmt.Fprintf(os.Stderr, "Usage: mlforge query <dir> \"<expression>\"\n")
    79				os.Exit(1)
    80			}
    81			result, err = buildQuery(dir, positional[2])
    82		case "report":
    83			result, err = buildReport(dir)
    84		default:
    85			fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
    86			os.Exit(1)
    87		}
    88	
    89		// --- Output --------------------------------------------------------
    90		if err != nil {
    91			fmt.Fprintf(os.Stderr, "error: %v\n", err)
    92			os.Exit(1)
    93		}
    94	
    95		out, marshalErr := json.MarshalIndent(result, "", "  ")
    96		if marshalErr != nil {
    97			fmt.Fprintf(os.Stderr, "error marshalling result: %v\n", marshalErr)
    98			os.Exit(1)
    99		}
   100		fmt.Println(string(out))
   101	}
