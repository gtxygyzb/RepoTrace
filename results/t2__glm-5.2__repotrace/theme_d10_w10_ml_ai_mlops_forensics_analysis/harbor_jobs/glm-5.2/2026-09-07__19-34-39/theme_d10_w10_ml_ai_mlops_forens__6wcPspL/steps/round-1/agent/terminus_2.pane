[?2004lpackage logparser

import (
	"bufio"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"strings"

	"mlforge/internal/types"
)

// RawEntry is the JSON structure of a single line in a .jsonl training log shard.
type RawEntry struct {
	Ts       string   `json:"ts"`
	Epoch    int      `json:"epoch"`
	Step     int      `json:"step"`
	Loss     *float64 `json:"loss,omitempty"`
	Lr       *float64 `json:"lr,omitempty"`
	GradNorm *float64 `json:"grad_norm,omitempty"`
	Acc      *float64 `json:"acc,omitempty"`
	Event    string   `json:"event,omitempty"`
}

// ShardInfo holds summary info about one parsed shard.
type ShardInfo struct {
	File     string // base filename
	Entries  int
	MinStep  int
	MaxStep  int
	MinEpoch int
	MaxEpoch int
	MinTs    string
	MaxTs    string
}

// ParseResult holds all entries from a directory of log shards.
type ParseResult struct {
	Entries []types.TimelineEntry
	Shards  []ShardInfo
}

// ParseAll reads every .jsonl file in dir and returns all entries with source
// annotations and per-shard summaries. Malformed JSON lines are silently skipped.
func ParseAll(dir string) (*ParseResult, error) {
	dirEntries, err := os.ReadDir(dir)
	if err != nil {
		return nil, fmt.Errorf("logparser: read dir %s: %w", dir, err)
	}

	result := &ParseResult{}

	for _, de := range dirEntries {
		if de.IsDir() || !strings.HasSuffix(strings.ToLower(de.Name()), ".jsonl") {
			continue
		}
		shard, entries, err := ParseShard(filepath.Join(dir, de.Name()), de.Name())
		if err != nil {
			return nil, err
		}
		result.Shards = append(result.Shards, shard)
		result.Entries = append(result.Entries, entries...)
	}

	return result, nil
}

func ParseShard(path, filename string) (ShardInfo, []types.TimelineEntry, error) {
	f, err := os.Open(path)
	if err != nil {
		return ShardInfo{}, nil, fmt.Errorf("logparser: open %s: %w", path, err)
	}
	defer f.Close()

	info := ShardInfo{
		File:     filename,
		MinStep:  1<<31 - 1,
		MaxStep:  -(1 << 31),
		MinEpoch: 1<<31 - 1,
		MaxEpoch: -(1 << 31),
	}

	var entries []types.TimelineEntry
	scanner := bufio.NewScanner(f)
	scanner.Buffer(make([]byte, 1024*1024), 1024*1024)

	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" {
			continue
		}
		var raw RawEntry
		if err := json.Unmarshal([]byte(line), &raw); err != nil {
			continue // skip malformed lines
		}

		te := types.TimelineEntry{
			Ts:       raw.Ts,
			Epoch:    raw.Epoch,
			Step:     raw.Step,
			Loss:     raw.Loss,
			Lr:       raw.Lr,
			GradNorm: raw.GradNorm,
			Acc:      raw.Acc,
			Event:    raw.Event,
			Sources:  []string{filename},
		}
		entries = append(entries, te)

		info.Entries++
		if raw.Step < info.MinStep {
			info.MinStep = raw.Step
		}
		if raw.Step > info.MaxStep {
			info.MaxStep = raw.Step
		}
		if raw.Epoch < info.MinEpoch {
			info.MinEpoch = raw.Epoch
		}
		if raw.Epoch > info.MaxEpoch {
			info.MaxEpoch = raw.Epoch
		}
		if info.MinTs == "" || raw.Ts < info.MinTs {
			info.MinTs = raw.Ts
		}
		if info.MaxTs == "" || raw.Ts > info.MaxTs {
			info.MaxTs = raw.Ts
		}
	}

	return info, entries, nil
}
