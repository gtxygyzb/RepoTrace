    30		MinStep    int
    31		MaxStep    int
    32		MinEpoch   int
    33		MaxEpoch   int
    34		MinTs      string
    35		MaxTs      string
    36	}
    37	
    38	// ParseResult holds all entries from a directory of log shards.
    39	type ParseResult struct {
    40		Entries []types.TimelineEntry
    41		Shards  []ShardInfo
    42	}
    43	
    44	// ParseAll reads every .jsonl file in dir and returns all entries with source
    45	// annotations and per-shard summaries. Malformed JSON lines are silently skipped.
    46	func ParseAll(dir string) (*ParseResult, error) {
    47		dirEntries, err := os.ReadDir(dir)
    48		if err != nil {
    49			return nil, fmt.Errorf("logparser: read dir %s: %w", dir, err)
    50		}
    51	
    52		result := &ParseResult{}
    53	
    54		for _, de := range dirEntries {
    55			if de.IsDir() || !strings.HasSuffix(strings.ToLower(de.Name()), ".jsonl") {
    56				continue
    57			}
    58			shard, entries, err := parseShard(filepath.Join(dir, de.Name()), de.Name())
    59			if err != nil {
    60				return nil, err
    61			}
    62			result.Shards = append(result.Shards, shard)
    63			result.Entries = append(result.Entries, entries...)
    64		}
    65	
    66		return result, nil
    67	}
    68	
    69	func parseShard(path, filename string) (ShardInfo, []types.TimelineEntry, error) {
    70		f, err := os.Open(path)
    71		if err != nil {
    72			return ShardInfo{}, nil, fmt.Errorf("logparser: open %s: %w", path, err)
    73		}
    74		defer f.Close()
    75	
    76		info := ShardInfo{
    77			File:     filename,
    78			MinStep:  1<<31 - 1,
    79			MaxStep:  -(1 << 31),
    80			MinEpoch: 1<<31 - 1,
    81			MaxEpoch: -(1 << 31),
    82		}
    83	
    84		var entries []types.TimelineEntry
    85		scanner := bufio.NewScanner(f)
    86		scanner.Buffer(make([]byte, 1024*1024), 1024*1024)
    87	
    88		for scanner.Scan() {
    89			line := strings.TrimSpace(scanner.Text())
    90			if line == "" {
    91				continue
    92			}
    93			var raw RawEntry
    94			if err := json.Unmarshal([]byte(line), &raw); err != nil {
    95				continue // skip malformed lines
    96			}
    97	
    98			te := types.TimelineEntry{
    99				Ts:       raw.Ts,
   100				Epoch:    raw.Epoch,
   101				Step:     raw.Step,
   102				Loss:     raw.Loss,
   103				Lr:       raw.Lr,
   104				GradNorm: raw.GradNorm,
   105				Acc:      raw.Acc,
   106				Event:    raw.Event,
   107				Sources:  []string{filename},
   108			}
   109			entries = append(entries, te)
   110	
   111			info.Entries++
   112			if raw.Step < info.MinStep {
   113				info.MinStep = raw.Step
   114			}
   115			if raw.Step > info.MaxStep {
   116				info.MaxStep = raw.Step
   117			}
   118			if raw.Epoch < info.MinEpoch {
   119				info.MinEpoch = raw.Epoch
   120			}
   121			if raw.Epoch > info.MaxEpoch {
   122				info.MaxEpoch = raw.Epoch
   123			}
   124			if info.MinTs == "" || raw.Ts < info.MinTs {
   125				info.MinTs = raw.Ts
   126			}
   127			if info.MaxTs == "" || raw.Ts > info.MaxTs {
   128				info.MaxTs = raw.Ts
   129			}
   130		}
   131	
   132		return info, entries, nil
   133	}
