[?2004l   240	      "from": "a1b2c3...",
   241	      "to": "d4e5f6...",
   242	      "from_file": "model_epoch1.mlck",
   243	      "to_file": "model_epoch2.mlck"
   244	    }
   245	  ],
   246	  "roots": ["a1b2c3..."],
