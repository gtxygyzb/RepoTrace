   271	
   272	func BuildVerify(dir string) (interface{}, error) {
   273		ap, err := DiscoverArtifacts(dir)
   274		if err != nil {
   275			return nil, err
   276		}
   277		if len(ap.Checkpoints) == 0 {
   278			return nil, fmt.Errorf("no checkpoint files found")
   279		}
   280		var out VerifyOutput
   281		out.Status = "ok"
   282		for _, p := range ap.Checkpoints {
   283			vc := verifyCheckpoint(p)
   284			out.Checkpoints = append(out.Checkpoints, vc)
   285		}
   286		sort.Slice(out.Checkpoints, func(i, j int) bool {
   287			return out.Checkpoints[i].File < out.Checkpoints[j].File
   288		})
   289		out.Summary.Total = len(out.Checkpoints)
   290		for _, c := range out.Checkpoints {
   291			if c.Valid {
   292				out.Summary.Valid++
   293			} else {
   294				out.Summary.Invalid++
   295			}
   296		}
   297		return out, nil
   298	}
   299	
   300	func verifyCheckpoint(path string) VerifyCheckpoint {
   301		vc := VerifyCheckpoint{
   302			File:   filepath.Base(path),
   303			Issues: []VerifyIssue{},
   304		}
   305		cf, err := checkpoint.Parse(path)
   306		if err != nil || cf == nil {
   307			vc.HeaderChecksumValid = false
   308			vc.TensorChecksumsValid = false
   309			vc.ProvenanceValid = false
   310			vc.Valid = false
   311			detail := "unknown parse error"
   312			if err != nil {
   313				detail = err.Error()
   314			}
   315			vc.Issues = append(vc.Issues, VerifyIssue{Type: "parse_error", Detail: detail})
   316			return vc
   317		}
   318		vc.HeaderChecksumValid = cf.HeaderValid
   319		if !cf.HeaderValid {
   320			vc.Issues = append(vc.Issues, VerifyIssue{Type: "header_checksum_mismatch", Detail: ""})
   321		}
   322		vc.TensorChecksumsValid = true
   323		for _, t := range cf.Tensors {
   324			if !t.Valid {
   325				vc.TensorChecksumsValid = false
   326				vc.Issues = append(vc.Issues, VerifyIssue{Type: "tensor_checksum_mismatch", Detail: t.Name})
   327			}
   328		}
   329		if cf.Signed {
   330			valid, _ := validateSignature(path)
   331			vc.SignatureValid = &valid
   332			if !valid {
   333				vc.Issues = append(vc.Issues, VerifyIssue{Type: "signature_invalid", Detail: ""})
   334			}
   335		}
   336		vc.ProvenanceValid = validateProvenance(cf)
   337		if !vc.ProvenanceValid {
   338			vc.Issues = append(vc.Issues, VerifyIssue{Type: "provenance_invalid", Detail: ""})
   339		}
   340		vc.Valid = vc.HeaderChecksumValid && vc.TensorChecksumsValid && vc.ProvenanceValid && (!cf.Signed || (vc.SignatureValid != nil && *vc.SignatureValid))
   341		return vc
   342	}
   343	
   344	func validateSignature(path string) (bool, error) {
   345		raw, err := os.ReadFile(path)
   346		if err != nil || len(raw) < 56 {
   347			return false, err
   348		}
   349		sigOff := binary.LittleEndian.Uint64(raw[32:40])
   350		if sigOff == 0 || int(sigOff) >= len(raw) {
   351			return false, nil
   352		}
   353		if int(sigOff)+5 > len(raw) {
   354			return false, nil
   355		}
   356		off := int(sigOff)
   357		_ = raw[off] // algorithm
   358		off++
   359		signerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   360		off += 2
   361		if off+signerLen+2 > len(raw) {
   362			return false, nil
   363		}
   364		signerID := string(raw[off : off+signerLen])
   365		off += signerLen
   366		sigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   367		off += 2
   368		if off+sigLen > len(raw) {
   369			return false, nil
   370		}
   371		storedSig := raw[off : off+sigLen]
   372		mac := hmac.New(sha256.New, []byte(signerID))
   373		mac.Write(raw[:sigOff])
   374		expected := mac.Sum(nil)
   375		return hmac.Equal(expected, storedSig), nil
   376	}
   377	
   378	func validateProvenance(cf *types.CheckpointFile) bool {
   379		if cf.Provenance == nil {
   380			return false
   381		}
   382		p := cf.Provenance
   383		if p.Framework == "" || p.FrameworkVersion == "" {
   384			return false
   385		}
   386		if len(p.GitCommit) != 40 || !isHex(p.GitCommit) {
   387			return false
   388		}
   389		if len(p.DatasetHash) != 64 || !isHex(p.DatasetHash) {
   390			return false
   391		}
   392		if len(p.ConfigHash) != 64 || !isHex(p.ConfigHash) {
   393			return false
   394		}
   395		if p.ParentHash != "" && (len(p.ParentHash) != 64 || !isHex(p.ParentHash)) {
   396			return false
   397		}
   398		return true
   399	}
   400	
   401	func isHex(s string) bool {
   402		_, err := hex.DecodeString(s)
   403		return err == nil
   404	}
   405	
   406	func parseShardRecursive(path string) (logparser.ShardInfo, []types.TimelineEntry, error) {
   407		return logparser.ParseShard(path, filepath.Base(path))
   408	}
   409	
   410	func loadTimelineEntries(dir string) ([]types.TimelineEntry, []logparser.ShardInfo, error) {
   411		ap, err := DiscoverArtifacts(dir)
   412		if err != nil {
   413			return nil, nil, err
   414		}
   415		if len(ap.Logs) == 0 {
   416			return nil, nil, fmt.Errorf("no log shard files found")
   417		}
   418		var allEntries []types.TimelineEntry
   419		var shards []logparser.ShardInfo
   420		for _, p := range ap.Logs {
   421			info, entries, err := parseShardRecursive(p)
   422			if err != nil {
   423				continue
   424			}
   425			shards = append(shards, info)
   426			allEntries = append(allEntries, entries...)
   427		}
   428		if len(allEntries) == 0 {
   429			return nil, shards, fmt.Errorf("no log entries found")
   430		}
   431		return allEntries, shards, nil
   432	}
   433	
   434	func mergeTimeline(entries []types.TimelineEntry) ([]types.TimelineEntry, int) {
   435		type agg struct {
   436			entry    types.TimelineEntry
   437			sources  map[string]struct{}
   438			conflict bool
   439		}
   440		m := map[string]*agg{}
   441		for _, e := range entries {
   442			key := fmt.Sprintf("%d:%d", e.Epoch, e.Step)
   443			a, ok := m[key]
   444			if !ok {
   445				src := map[string]struct{}{}
   446				for _, s := range e.Sources {
   447					src[s] = struct{}{}
   448				}
   449				m[key] = &agg{entry: e, sources: src}
   450				continue
   451			}
   452			for _, s := range e.Sources {
   453				a.sources[s] = struct{}{}
   454			}
   455			if metricsEqual(a.entry, e) {
   456				if e.Ts < a.entry.Ts {
   457					a.entry = e
   458				}
   459				continue
   460			}
   461			a.conflict = true
   462			if e.Ts < a.entry.Ts {
   463				a.entry = e
   464			}
   465		}
   466		result := make([]types.TimelineEntry, 0, len(m))
   467		conflicts := 0
   468		for _, a := range m {
   469			e := a.entry
   470			srcs := make([]string, 0, len(a.sources))
   471			for s := range a.sources {
   472				srcs = append(srcs, s)
   473			}
   474			sort.Strings(srcs)
   475			e.Sources = srcs
   476			e.Conflict = a.conflict
   477			if a.conflict {
   478				conflicts++
   479			}
   480			result = append(result, e)
   481		}
   482		return result, conflicts
   483	}
   484	
   485	func metricsEqual(a, b types.TimelineEntry) bool {
   486		return floatPtrEqual(a.Loss, b.Loss) &&
   487			floatPtrEqual(a.Lr, b.Lr) &&
   488			floatPtrEqual(a.GradNorm, b.GradNorm) &&
   489			floatPtrEqual(a.Acc, b.Acc)
   490	}
   491	
   492	func floatPtrEqual(a, b *float64) bool {
   493		if a == nil || b == nil {
   494			return a == b
   495		}
   496		return math.Abs(*a-*b) <= 1e-9
   497	}
   498	
   499	func sortTimeline(entries []types.TimelineEntry) {
   500		sort.Slice(entries, func(i, j int) bool {
   501			if entries[i].Epoch != entries[j].Epoch {
   502				return entries[i].Epoch < entries[j].Epoch
   503			}
   504			return entries[i].Step < entries[j].Step
   505		})
   506	}
   507	
   508	func detectGaps(entries []types.TimelineEntry) []TimelineGap {
   509		var gaps []TimelineGap
   510		for i := 1; i < len(entries); i++ {
   511			prev := entries[i-1]
   512			cur := entries[i]
   513			if prev.Epoch != cur.Epoch {
   514				continue
   515			}
   516			diff := cur.Step - prev.Step
   517			if diff > 50 {
   518				gaps = append(gaps, TimelineGap{
   519					AfterStep:  prev.Step,
   520					BeforeStep: cur.Step,
   521					Epoch:      prev.Epoch,
   522					GapSteps:   diff,
   523					AfterTs:    prev.Ts,
   524					BeforeTs:   cur.Ts,
   525				})
   526			}
   527		}
   528		return gaps
   529	}
