   253	func tokenizeQuery(s string) ([]string, error) {
   254		var tokens []string
   255		i := 0
   256		for i < len(s) {
   257			ch := s[i]
   258			if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' {
   259				i++
   260				continue
