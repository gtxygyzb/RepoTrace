   190	// parseMetadata parses the metadata section: numMeta key-value pairs.
   191	func parseMetadata(raw []byte, off int, numMeta uint32) (map[string]string, error) {
   192		md := make(map[string]string, numMeta)
   193		for i := uint32(0); i < numMeta; i++ {
   194			// key_len (uint16)
   195			if off+2 > len(raw) {
   196				return md, fmt.Errorf("metadata: unexpected EOF at key_len %d", i)
   197			}
   198			keyLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   199			off += 2
   200	
   201			if off+keyLen > len(raw) {
   202				return md, fmt.Errorf("metadata: unexpected EOF at key %d", i)
   203			}
   204			key := string(raw[off : off+keyLen])
   205			off += keyLen
   206	
   207			// value_len (uint32)
   208			if off+4 > len(raw) {
   209				return md, fmt.Errorf("metadata: unexpected EOF at value_len %d", i)
   210			}
