   613	func sortAnomalies(a []types.Anomaly) {
   614		rank := map[string]int{"critical": 0, "high": 1, "medium": 2, "low": 3, "info": 4}
   615		sort.Slice(a, func(i, j int) bool {
   616			ri := rank[a[i].Severity]
   617			rj := rank[a[j].Severity]
   618			if ri != rj {
   619				return ri < rj
   620			}
