[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"strings"

	"mlforge/internal/forensics"
)

func main() {
	// --- Parse flags ---------------------------------------------------
	format := "json"
	verbose := false
	var positional []string

	for _, arg := range os.Args[1:] {
		switch {
		case arg == "--verbose":
			verbose = true
		case strings.HasPrefix(arg, "--format="):
			format = strings.TrimPrefix(arg, "--format=")
		case arg == "--format":
		// handled below as two-token flag
		default:
			positional = append(positional, arg)
		}
	}

	// Handle "--format json" (two separate tokens)
	for i := 1; i < len(os.Args)-1; i++ {
		if os.Args[i] == "--format" {
			format = os.Args[i+1]
			// Remove the value from positional args
			filtered := positional[:0]
			for _, p := range positional {
				if p != os.Args[i+1] {
					filtered = append(filtered, p)
				}
			}
			positional = filtered
			break
		}
	}

	if format != "json" && format != "text" {
		fmt.Fprintf(os.Stderr, "invalid format %q: must be json or text\n", format)
		os.Exit(1)
	}

	_ = verbose // reserved for diagnostic output

	// --- Validate positional args --------------------------------------
	if len(positional) < 2 {
		fmt.Fprintf(os.Stderr, "Usage: mlforge <command> <evidence-dir> [args...]\n")
		os.Exit(1)
	}

	cmd := positional[0]
	dir := positional[1]

	// --- Route to command handler --------------------------------------
	var result interface{}
	var err error

	switch cmd {
	case "ingest":
		result, err = forensics.BuildIngest(dir)
	case "timeline":
		result, err = forensics.BuildTimeline(dir)
	case "verify":
		result, err = forensics.BuildVerify(dir)
	case "detect":
		result, err = forensics.BuildDetect(dir)
	case "lineage":
		result, err = forensics.BuildLineage(dir)
	case "query":
		if len(positional) < 3 {
			fmt.Fprintf(os.Stderr, "Usage: mlforge query <dir> \"<expression>\"\n")
			os.Exit(1)
		}
		result, err = forensics.BuildQuery(dir, positional[2])
	case "diff":
		if len(positional) < 4 {
			fmt.Fprintf(os.Stderr, "Usage: mlforge diff <dir> <file1> <file2>\n")
			os.Exit(1)
		}
		result, err = forensics.BuildDiff(dir, positional[2], positional[3])
	case "report":
		result, err = forensics.BuildReport(dir)
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
		os.Exit(1)
	}

	// --- Output --------------------------------------------------------
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	if format == "text" {
		printText(result)
		return
	}

	out, marshalErr := json.MarshalIndent(result, "", "  ")
	if marshalErr != nil {
		fmt.Fprintf(os.Stderr, "error marshalling result: %v\n", marshalErr)
		os.Exit(1)
	}
	fmt.Println(string(out))
}

func printText(v interface{}) {
	b, err := json.MarshalIndent(v, "", "  ")
	if err != nil {
		fmt.Fprintln(os.Stderr, "error rendering text output")
		return
	}
	fmt.Println(string(b))
}
[?2004hroot@n30009:/app# sed -n '92,135p' docs/analysis_rules.md
[?2004l
### 2.9 Training Gap

- **Method**: Consecutive timeline entries (after merge sort) have timestamps more than 2 hours apart
- **Trigger**: `time_diff > 7200 seconds` between consecutive entries within the same epoch
- **Severity**: `low`
- **Output fields**: `after_step`, `before_step`, `after_ts`, `before_ts`, `gap_seconds`

### 2.10 Dataset Hash Inconsistency

- **Method**: Compare `DatasetHash` across all checkpoints in the same lineage chain
- **Trigger**: Different `DatasetHash` values within the same chain
- **Severity**: `high`
- **Output fields**: `files`, `hashes` (list of unique hex hashes)

---

## 3. Query Language

### 3.1 Grammar

```
query      := or_expr
or_expr    := and_expr ("OR" and_expr)*
and_expr   := not_expr ("AND" not_expr)*
not_expr   := "NOT" not_expr | atom
atom       := "(" or_expr ")" | condition
condition  := field COMP_OP value
COMP_OP    := ">" | "<" | ">=" | "<=" | "==" | "!="
field      := "step" | "epoch" | "loss" | "lr" | "grad_norm" | "acc" | "event" | "ts"
value      := NUMBER | QUOTED_STRING | TIMESTAMP
NUMBER     := integer or float literal
QUOTED_STRING := '"' ... '"' (double-quoted string)
TIMESTAMP  := ISO 8601 format (e.g., 2024-01-15T10:30:00Z)
```

### 3.2 Operator Precedence

- `NOT` is a prefix operator with the highest precedence.
- `AND` binds tighter than `OR`.
- Parentheses `(` `)` override the default precedence.
- Malformed parenthesized queries, such as `(step < 5` or `step < 5)`, are invalid query syntax.

Examples:
