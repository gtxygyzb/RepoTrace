[?2004lpackage forensics

import (
	"encoding/binary"
	"fmt"
	"math"
	"path/filepath"
	"sort"

	"mlforge/internal/checkpoint"
	"mlforge/internal/types"
)

// diffTensorResult describes one tensor in the diff output.
type diffTensorResult struct {
	Name        string   `json:"name"`
	ShapeMatch  bool     `json:"shape_match"`
	ShapeA      []uint32 `json:"shape_a"`
	ShapeB      []uint32 `json:"shape_b"`
	MaxAbsDiff  *float64 `json:"max_abs_diff,omitempty"`
	MeanAbsDiff *float64 `json:"mean_abs_diff,omitempty"`
}

// diffSummary summarizes tensor presence and shape compatibility.
type diffSummary struct {
	TotalTensorsA   int      `json:"total_tensors_a"`
	TotalTensorsB   int      `json:"total_tensors_b"`
	CommonTensors   int      `json:"common_tensors"`
	ShapeMismatches int      `json:"shape_mismatches"`
	OnlyInA         []string `json:"only_in_a"`
	OnlyInB         []string `json:"only_in_b"`
}

// diffOutput is the JSON output for the diff command.
type diffOutput struct {
	Status      string             `json:"status"`
	FileA       string             `json:"file_a"`
	FileB       string             `json:"file_b"`
	TensorDiffs []diffTensorResult `json:"tensor_diffs"`
	Summary     diffSummary        `json:"summary"`
}

const float32Dtype byte = 0

// BuildDiff compares two checkpoint files inside evidenceDir tensor by tensor.
func BuildDiff(evidenceDir, file1, file2 string) (interface{}, error) {
	pathA := filepath.Join(evidenceDir, file1)
	pathB := filepath.Join(evidenceDir, file2)

	cfA, err := checkpoint.Parse(pathA)
	if err != nil {
		return nil, fmt.Errorf("diff: %s: %w", file1, err)
	}
	if cfA == nil {
		return nil, fmt.Errorf("diff: %s: not found", file1)
	}
	cfB, err := checkpoint.Parse(pathB)
	if err != nil {
		return nil, fmt.Errorf("diff: %s: %w", file2, err)
	}
	if cfB == nil {
		return nil, fmt.Errorf("diff: %s: not found", file2)
	}

	tensorsA := make(map[string]types.TensorInfo, len(cfA.Tensors))
	for _, t := range cfA.Tensors {
		tensorsA[t.Name] = t
	}
	tensorsB := make(map[string]types.TensorInfo, len(cfB.Tensors))
	for _, t := range cfB.Tensors {
		tensorsB[t.Name] = t
	}

	names := map[string]struct{}{}
	for name := range tensorsA {
		names[name] = struct{}{}
	}
	for name := range tensorsB {
		names[name] = struct{}{}
	}
	sortedNames := make([]string, 0, len(names))
	for name := range names {
		sortedNames = append(sortedNames, name)
	}
	sort.Strings(sortedNames)

	onlyInA := []string{}
	onlyInB := []string{}
	common := 0
	shapeMismatches := 0
	tensorDiffs := make([]diffTensorResult, 0, len(sortedNames))

	for _, name := range sortedNames {
		ta, okA := tensorsA[name]
		tb, okB := tensorsB[name]

		var shapeA []uint32
		var shapeB []uint32
		if okA {
			shapeA = ta.Shape
		}
		if okB {
			shapeB = tb.Shape
		}

		shapeMatch := okA && okB && shapesEqual(ta.Shape, tb.Shape)
		result := diffTensorResult{
			Name:       name,
			ShapeMatch: shapeMatch,
			ShapeA:     shapeA,
			ShapeB:     shapeB,
		}

		if okA && okB {
			common++
			if !shapeMatch {
				shapeMismatches++
			} else {
				maxDiff, meanDiff, err := float32DiffStats(ta, tb)
				if err != nil {
					return nil, fmt.Errorf("diff: tensor %s: %w", name, err)
				}
				result.MaxAbsDiff = &maxDiff
				result.MeanAbsDiff = &meanDiff
			}
		} else if okA {
			onlyInA = append(onlyInA, name)
		} else {
			onlyInB = append(onlyInB, name)
		}

		tensorDiffs = append(tensorDiffs, result)
	}

	return diffOutput{
		Status:      "ok",
		FileA:       filepath.Base(file1),
		FileB:       filepath.Base(file2),
		TensorDiffs: tensorDiffs,
		Summary: diffSummary{
			TotalTensorsA:   len(tensorsA),
			TotalTensorsB:   len(tensorsB),
			CommonTensors:   common,
			ShapeMismatches: shapeMismatches,
			OnlyInA:         onlyInA,
			OnlyInB:         onlyInB,
		},
	}, nil
}

func shapesEqual(a, b []uint32) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func float32DiffStats(a, b types.TensorInfo) (float64, float64, error) {
	if a.Dtype != float32Dtype || b.Dtype != float32Dtype {
		return 0, 0, fmt.Errorf("unsupported dtype %d/%d; only float32 tensors are supported", a.Dtype, b.Dtype)
	}
	if len(a.Data) != len(b.Data) {
		return 0, 0, fmt.Errorf("data length mismatch %d/%d", len(a.Data), len(b.Data))
	}
	if len(a.Data)%4 != 0 {
		return 0, 0, fmt.Errorf("non-float32 data length %d", len(a.Data))
	}

	n := len(a.Data) / 4
	if n == 0 {
		return 0, 0, nil
	}

	var maxDiff, sumDiff float64
	for i := 0; i < n; i++ {
		fa := math.Float32frombits(binary.LittleEndian.Uint32(a.Data[i*4 : i*4+4]))
		fb := math.Float32frombits(binary.LittleEndian.Uint32(b.Data[i*4 : i*4+4]))
		d := math.Abs(float64(fa - fb))
		if d > maxDiff {
			maxDiff = d
		}
		sumDiff += d
	}
	return maxDiff, sumDiff / float64(n), nil
}
