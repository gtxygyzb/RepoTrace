[?2004lpackage forensics

import (
"crypto/hmac"
"crypto/sha256"
"encoding/binary"
"encoding/hex"
"encoding/json"
"fmt"
"math"
"os"
"path/filepath"
"sort"
"strings"
"time"

"mlforge/internal/checkpoint"
"mlforge/internal/logparser"
"mlforge/internal/types"
)

type ArtifactPaths struct {
Checkpoints []string
Logs        []string
Configs     []string
}

func DiscoverArtifacts(dir string) (ArtifactPaths, error) {
var ap ArtifactPaths
err := filepath.WalkDir(dir, func(path string, d os.DirEntry, err error) error {
if err != nil {
return err
}
if d.IsDir() {
return nil
}
name := d.Name()
lower := strings.ToLower(name)
switch {
case strings.HasSuffix(lower, ".mlck"):
ap.Checkpoints = append(ap.Checkpoints, path)
case strings.HasSuffix(lower, ".jsonl"):
ap.Logs = append(ap.Logs, path)
case strings.HasPrefix(name, "config_") && strings.HasSuffix(lower, ".json"):
ap.Configs = append(ap.Configs, path)
}
return nil
})
if err != nil {
return ap, err
}
sort.Strings(ap.Checkpoints)
sort.Strings(ap.Logs)
sort.Strings(ap.Configs)
return ap, nil
}

type IngestCheckpoint struct {
File               string                 `json:"file"`
FileHash           string                 `json:"file_hash"`
Version            uint32                 `json:"version"`
NumTensors         uint32                 `json:"num_tensors"`
NumMetadata        uint32                 `json:"num_metadata"`
Signed             bool                   `json:"signed"`
CreationTimestamp  string                 `json:"creation_timestamp"`
Provenance         map[string]interface{} `json:"provenance"`
}

type IngestLogShard struct {
File      string   `json:"file"`
Entries   int      `json:"entries"`
StepRange []int    `json:"step_range"`
EpochRange []int   `json:"epoch_range"`
TimeRange []string `json:"time_range"`
}

type IngestConfig struct {
File      string `json:"file"`
ModelName string `json:"model_name"`
Dataset   string `json:"dataset"`
[?2004hroot@n30009:/app# cat >> internal/forensics/forensics.go <<'EOF'
[?2004l b.GradNorm) &&
		floatPtrEqual(a.Acc, b.Acc)
}

func floatPtrEqual(a, b *float64) bool {
	if a == nil || b == nil {
		return a == b
	}
	return math.Abs(*a-*b) <= 1e-9
}

func sortTimeline(entries []types.TimelineEntry) {
	sort.Slice(entries, func(i, j int) bool {
		if entries[i].Epoch != entries[j].Epoch {
			return entries[i].Epoch < entries[j].Epoch
		}
		return entries[i].Step < entries[j].Step
	})
}

func detectGaps(entries []types.TimelineEntry) []TimelineGap {
	var gaps []TimelineGap
	for i := 1; i < len(entries); i++ {
		prev := entries[i-1]
		cur := entries[i]
		if prev.Epoch != cur.Epoch {
			continue
		}
		diff := cur.Step - prev.Step
		if diff > 100 {
			gaps = append(gaps, TimelineGap{
				AfterStep:  prev.Step,
				BeforeStep: cur.Step,
				Epoch:      prev.Epoch,
				GapSteps:   diff,
				AfterTs:    prev.Ts,
				BeforeTs:   cur.Ts,
			})
		}
	}
	return gaps
}

func readConfigSummary(path string) (IngestConfig, error) {
	raw, err := os.ReadFile(path)
	if err != nil {
		return IngestConfig{}, err
	}
	var cfg struct {
		ModelName string `json:"model_name"`
		Dataset   string `json:"dataset"`
	}
	if err := json.Unmarshal(raw, &cfg); err != nil {
		return IngestConfig{}, err
	}
	return IngestConfig{File: filepath.Base(path), ModelName: cfg.ModelName, Dataset: cfg.Dataset}, nil
}

func provenanceToMap(p *types.Provenance) map[string]interface{} {
	if p == nil {
		return map[string]interface{}{}
	}
	return map[string]interface{}{
		"epoch":             p.Epoch,
		"global_step":       p.GlobalStep,
		"framework":         p.Framework,
		"framework_version": p.FrameworkVersion,
		"parent_hash":       p.ParentHash,
	}
}

func unixToISO(ts int64) string {
	return time.Unix(ts, 0).UTC().Format(time.RFC3339)
}
