   222	func detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {
   223		var anomalies []types.Anomaly
   224		for i := 1; i < len(entries); i++ {
   225			prev := entries[i-1]
   226			cur := entries[i]
   227			if prev.Epoch != cur.Epoch {
   228				continue
   229			}
   230			prevT, err1 := time.Parse(time.RFC3339, prev.Ts)
   231			curT, err2 := time.Parse(time.RFC3339, cur.Ts)
   232			if err1 != nil || err2 != nil {
   233				continue
   234			}
   235			diff := curT.Sub(prevT).Seconds()
   236			if diff > 3600 {
   237				ep := cur.Epoch
   238				st := cur.Step
   239				anomalies = append(anomalies, types.Anomaly{
   240					Type:     "training_gap",
   241					Severity: "low",
   242					Epoch:    &ep,
   243					Step:     &st,
   244					Details: map[string]interface{}{
   245						"after_step":  prev.Step,
   246						"before_step": cur.Step,
   247						"after_ts":    prev.Ts,
   248						"before_ts":   cur.Ts,
   249						"gap_seconds": diff,
   250					},
   251					Source: firstSource(cur),
   252				})
   253			}
   254		}
   255		return anomalies
   256	}
