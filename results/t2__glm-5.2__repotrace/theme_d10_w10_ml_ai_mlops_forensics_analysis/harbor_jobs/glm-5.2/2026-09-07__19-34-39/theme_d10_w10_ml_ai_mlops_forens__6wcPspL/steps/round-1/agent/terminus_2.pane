   531	func readConfigSummary(path string) (IngestConfig, error) {
   532		raw, err := os.ReadFile(path)
   533		if err != nil {
   534			return IngestConfig{}, err
   535		}
   536		var cfg struct {
   537			ModelName string `json:"model_name"`
   538			Dataset   string `json:"dataset"`
   539		}
   540		if err := json.Unmarshal(raw, &cfg); err != nil {
   541			return IngestConfig{}, err
   542		}
   543		return IngestConfig{File: filepath.Base(path), ModelName: cfg.ModelName, Dataset: cfg.Dataset}, nil
   544	}
