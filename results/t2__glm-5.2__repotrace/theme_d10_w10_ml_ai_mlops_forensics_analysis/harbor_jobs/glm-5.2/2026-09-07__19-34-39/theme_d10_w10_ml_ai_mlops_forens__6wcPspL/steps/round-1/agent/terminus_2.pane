[?2004lpackage checkpoint

import (
	"crypto/sha256"
	"encoding/binary"
	"encoding/hex"
	"fmt"
	"hash/fnv"
	"math"
	"os"
	"path/filepath"
	"strings"

	"mlforge/internal/types"
)

const (
	magicMLCK  = "MLCK"
	headerSize = 56
)

// Parse reads and validates a single .mlck checkpoint file according to the
// MLCK binary format specification (see /app/docs/formats.md).
func Parse(path string) (*types.CheckpointFile, error) {
	raw, err := os.ReadFile(path)
	if err != nil {
		return nil, fmt.Errorf("checkpoint: read %s: %w", path, err)
	}
	if len(raw) < headerSize {
		return nil, fmt.Errorf("checkpoint: file too small (%d bytes)", len(raw))
	}

	// --- magic (offset 0, 4 bytes) ---
	if string(raw[0:4]) != magicMLCK {
		return nil, fmt.Errorf("checkpoint: bad magic %q", raw[0:4])
	}

	// --- header fields ---
	version := binary.LittleEndian.Uint16(raw[4:6])
	flags := binary.LittleEndian.Uint16(raw[6:8])
	numTensors := binary.LittleEndian.Uint32(raw[8:12])
	numMetadata := binary.LittleEndian.Uint32(raw[12:16])
	metadataOffset := binary.LittleEndian.Uint64(raw[16:24])
	provenanceOffset := binary.LittleEndian.Uint64(raw[24:32])
	_ = binary.LittleEndian.Uint64(raw[32:40]) // signatureOffset (unused for now)
	creationTimestamp := int64(binary.LittleEndian.Uint64(raw[40:48]))
	storedChecksum := binary.LittleEndian.Uint64(raw[48:56])

	// --- verify header checksum: FNV-1a of bytes [0..48) ---
	h := fnv.New64a()
	h.Write(raw[:48])
	computedChecksum := h.Sum64()
	headerValid := computedChecksum == storedChecksum

	// --- SHA-256 file hash ---
	fileHashBytes := sha256.Sum256(raw)
	fileHash := hex.EncodeToString(fileHashBytes[:])

	signed := flags&1 != 0

	cf := &types.CheckpointFile{
		Path:              path,
		Filename:          filepath.Base(path),
		Version:           uint32(version),
		Flags:             flags,
		NumTensors:        numTensors,
		NumMetadataKeys:   numMetadata,
		CreationTimestamp:  creationTimestamp,
		HeaderValid:       headerValid,
		FileHash:          fileHash,
		Signed:            signed,
	}

	// --- parse tensor blocks (start at offset 56) ---
	off := headerSize
	tensors := make([]types.TensorInfo, 0, numTensors)
	for i := uint32(0); i < numTensors; i++ {
		ti, newOff, err := parseTensor(raw, off, i)
		if err != nil {
			return nil, err
		}
		tensors = append(tensors, ti)
		off = newOff
	}
	cf.Tensors = tensors

	// --- parse metadata section ---
	if numMetadata > 0 && metadataOffset > 0 && int(metadataOffset) < len(raw) {
		md, err := parseMetadata(raw, int(metadataOffset), numMetadata)
		if err == nil {
			cf.MetadataMap = md
		}
	}

	// --- parse provenance section ---
	if provenanceOffset > 0 && int(provenanceOffset) < len(raw) {
		prov, err := parseProvenance(raw, int(provenanceOffset))
		if err == nil {
			cf.Provenance = prov
			cf.HasParent = prov.ParentHash != ""
			cf.ParentHex = prov.ParentHash
		}
	}

	return cf, nil
}

// parseTensor parses one tensor block starting at off and returns the
// TensorInfo plus the new offset after the block.
func parseTensor(raw []byte, off int, idx uint32) (types.TensorInfo, int, error) {
	fail := func(msg string) (types.TensorInfo, int, error) {
		return types.TensorInfo{}, 0, fmt.Errorf("checkpoint: tensor %d: %s", idx, msg)
	}

	// name_len (uint16 LE)
	if off+2 > len(raw) {
		return fail("unexpected EOF reading name_len")
	}
	nameLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
	off += 2

	// name
	if off+nameLen > len(raw) {
		return fail("unexpected EOF reading name")
	}
	name := string(raw[off : off+nameLen])
	off += nameLen

	// dtype (1 byte)
	if off+1 > len(raw) {
		return fail("unexpected EOF reading dtype")
	}
	dtype := raw[off]
	off++

	// num_dims (1 byte)
	if off+1 > len(raw) {
		return fail("unexpected EOF reading num_dims")
	}
	numDims := int(raw[off])
[?2004hroot@n30009:/app# sed -n '140,260p' internal/checkpoint/parser.go
[?2004l	numDims := int(raw[off])
	off++

	// shape (num_dims * uint32 LE)
	shapeBytes := numDims * 4
	if off+shapeBytes > len(raw) {
		return fail("unexpected EOF reading shape")
	}
	shape := make([]uint32, numDims)
	for d := 0; d < numDims; d++ {
		shape[d] = binary.LittleEndian.Uint32(raw[off : off+4])
		off += 4
	}

	// data_size (uint64 LE)
	if off+8 > len(raw) {
		return fail("unexpected EOF reading data_size")
	}
	dataSize := binary.LittleEndian.Uint64(raw[off : off+8])
	off += 8

	// data
	if off+int(dataSize) > len(raw) {
		return fail("unexpected EOF reading data")
	}
	data := raw[off : off+int(dataSize)]
	off += int(dataSize)

	// hash (32 bytes SHA-256)
	if off+32 > len(raw) {
		return fail("unexpected EOF reading hash")
	}
	var storedHash [32]byte
	copy(storedHash[:], raw[off:off+32])
	off += 32

	// verify SHA-256
	computedHash := sha256.Sum256(data)
	valid := computedHash == storedHash

	return types.TensorInfo{
		Name:  name,
		Dtype: dtype,
		Shape: shape,
		Data:  data,
		Hash:  storedHash,
		Valid: valid,
	}, off, nil
}

// parseMetadata parses the metadata section: numMeta key-value pairs.
func parseMetadata(raw []byte, off int, numMeta uint32) (map[string]string, error) {
	md := make(map[string]string, numMeta)
	for i := uint32(0); i < numMeta; i++ {
		// key_len (uint16)
		if off+2 > len(raw) {
			return md, fmt.Errorf("metadata: unexpected EOF at key_len %d", i)
		}
		keyLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
		off += 2

		if off+keyLen > len(raw) {
			return md, fmt.Errorf("metadata: unexpected EOF at key %d", i)
		}
		key := string(raw[off : off+keyLen])
		off += keyLen

		// value_len (uint32)
		if off+4 > len(raw) {
			return md, fmt.Errorf("metadata: unexpected EOF at value_len %d", i)
		}
		valLen := int(binary.LittleEndian.Uint32(raw[off : off+4]))
		off += 4

		if off+valLen > len(raw) {
			return md, fmt.Errorf("metadata: unexpected EOF at value %d", i)
		}
		val := string(raw[off : off+valLen])
		off += valLen

		md[key] = val
	}
	return md, nil
}

// parseProvenance parses the provenance section.
func parseProvenance(raw []byte, off int) (*types.Provenance, error) {
	p := &types.Provenance{}

	// GitCommit: 40 bytes ASCII
	if off+40 > len(raw) {
		return nil, fmt.Errorf("provenance: unexpected EOF at git_commit")
	}
	p.GitCommit = strings.TrimRight(string(raw[off:off+40]), "\x00")
	off += 40

	// DatasetHash: 32 bytes raw → hex
	if off+32 > len(raw) {
		return nil, fmt.Errorf("provenance: unexpected EOF at dataset_hash")
	}
	p.DatasetHash = hex.EncodeToString(raw[off : off+32])
	off += 32

	// ConfigHash: 32 bytes raw → hex
	if off+32 > len(raw) {
		return nil, fmt.Errorf("provenance: unexpected EOF at config_hash")
	}
	p.ConfigHash = hex.EncodeToString(raw[off : off+32])
	off += 32

	// TrainingTimestamp: int64
	if off+8 > len(raw) {
		return nil, fmt.Errorf("provenance: unexpected EOF at training_timestamp")
	}
	p.TrainingTimestamp = int64(binary.LittleEndian.Uint64(raw[off : off+8]))
	off += 8

	// TrainingDuration: float64
	if off+8 > len(raw) {
		return nil, fmt.Errorf("provenance: unexpected EOF at training_duration")
	}
