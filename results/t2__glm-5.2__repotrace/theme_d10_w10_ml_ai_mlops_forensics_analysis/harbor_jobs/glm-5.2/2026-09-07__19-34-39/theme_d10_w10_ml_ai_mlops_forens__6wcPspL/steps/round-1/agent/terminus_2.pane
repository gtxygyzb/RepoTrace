[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"strconv"
	"strings"

	"mlforge/internal/forensics"
)

func main() {
	// --- Parse flags ---------------------------------------------------
	format := "json"
	verbose := false
	filterSeverity := ""
	var positional []string

	args := os.Args[1:]
	for i := 0; i < len(args); i++ {
		arg := args[i]
		switch {
		case arg == "--verbose":
			verbose = true
		case strings.HasPrefix(arg, "--format="):
			format = strings.TrimPrefix(arg, "--format=")
		case arg == "--format":
			if i+1 >= len(args) {
				fmt.Fprintf(os.Stderr, "flag --format requires a value\n")
				os.Exit(1)
			}
			i++
			format = args[i]
		case strings.HasPrefix(arg, "--filter-severity="):
			filterSeverity = strings.TrimPrefix(arg, "--filter-severity=")
		case arg == "--filter-severity":
			if i+1 >= len(args) {
				fmt.Fprintf(os.Stderr, "flag --filter-severity requires a value\n")
				os.Exit(1)
			}
			i++
			filterSeverity = args[i]
		default:
			positional = append(positional, arg)
		}
	}

	switch format {
	case "json", "text", "csv":
	default:
		fmt.Fprintf(os.Stderr, "invalid format %q: must be json, text, or csv\n", format)
		os.Exit(1)
	}

	_ = verbose // reserved for diagnostic output

	// --- Validate positional args --------------------------------------
	if len(positional) < 2 {
		fmt.Fprintf(os.Stderr, "Usage: mlforge <command> <evidence-dir> [args...]\n")
		os.Exit(1)
	}

	cmd := positional[0]
	dir := positional[1]

	if format == "csv" && cmd != "detect" {
		fmt.Fprintf(os.Stderr, "invalid format csv: csv output is only supported for detect\n")
		os.Exit(1)
	}
	if filterSeverity != "" && cmd != "detect" {
		fmt.Fprintf(os.Stderr, "--filter-severity is only supported for detect\n")
		os.Exit(1)
	}

	// --- Route to command handler --------------------------------------
	var result interface{}
	var err error

	switch cmd {
	case "ingest":
		result, err = forensics.BuildIngest(dir)
	case "timeline":
		result, err = forensics.BuildTimeline(dir)
	case "verify":
		result, err = forensics.BuildVerify(dir)
	case "detect":
		detectResult, detectErr := forensics.BuildDetectFiltered(dir, filterSeverity)
		if detectErr != nil {
			err = detectErr
		} else {
			if format == "csv" {
				printDetectCSV(detectResult)
				return
			}
			result = detectResult
		}
	case "lineage":
		result, err = forensics.BuildLineage(dir)
	case "query":
		if len(positional) < 3 {
			fmt.Fprintf(os.Stderr, "Usage: mlforge query <dir> \"<expression>\"\n")
			os.Exit(1)
		}
		result, err = forensics.BuildQuery(dir, positional[2])
	case "diff":
		if len(positional) < 4 {
			fmt.Fprintf(os.Stderr, "Usage: mlforge diff <dir> <file1> <file2>\n")
			os.Exit(1)
		}
		result, err = forensics.BuildDiff(dir, positional[2], positional[3])
	case "report":
		result, err = forensics.BuildReport(dir)
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
		os.Exit(1)
	}

	// --- Output --------------------------------------------------------
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	if format == "text" {
		printText(result)
		return
	}

	out, marshalErr := json.MarshalIndent(result, "", "  ")
	if marshalErr != nil {
		fmt.Fprintf(os.Stderr, "error marshalling result: %v\n", marshalErr)
		os.Exit(1)
	}
	fmt.Println(string(out))
}

func printDetectCSV(result forensics.DetectOutput) {
	fmt.Println("id,type,severity,epoch,step,source,checkpoint")
	for _, a := range result.Anomalies {
		epoch := ""
		if a.Epoch != nil {
			epoch = strconv.Itoa(*a.Epoch)
		}
		step := ""
		if a.Step != nil {
			step = strconv.Itoa(*a.Step)
		}
		fmt.Printf("%s,%s,%s,%s,%s,%s,%s\n", a.ID, a.Type, a.Severity, epoch, step, a.Source, a.Checkpoint)
	}
}

func printText(v interface{}) {
	b, err := json.MarshalIndent(v, "", "  ")
	if err != nil {
		fmt.Fprintln(os.Stderr, "error rendering text output")
		return
	}
	fmt.Println(string(b))
}
