   337							"tensor_name":       t.Name,
   338							"expected_checksum": hex.EncodeToString(t.Hash[:]),
   339							"actual_checksum":   hex.EncodeToString(computed[:]),
   340						},
   341						Source:     cf.Filename,
   342						Checkpoint: cf.Filename,
   343					})
   344				}
   345			}
