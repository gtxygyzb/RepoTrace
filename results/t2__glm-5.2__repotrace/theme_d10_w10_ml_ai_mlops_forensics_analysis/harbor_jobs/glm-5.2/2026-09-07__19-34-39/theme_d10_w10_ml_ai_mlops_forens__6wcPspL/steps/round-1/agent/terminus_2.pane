   108	// parseTensor parses one tensor block starting at off and returns the
   109	// TensorInfo plus the new offset after the block.
   110	func parseTensor(raw []byte, off int, idx uint32) (types.TensorInfo, int, error) {
   111		fail := func(msg string) (types.TensorInfo, int, error) {
   112			return types.TensorInfo{}, 0, fmt.Errorf("checkpoint: tensor %d: %s", idx, msg)
   113		}
   114	
   115		// name_len (uint16 LE)
   116		if off+2 > len(raw) {
   117			return fail("unexpected EOF reading name_len")
   118		}
   119		nameLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   120		off += 2
   121	
   122		// name
   123		if off+nameLen > len(raw) {
   124			return fail("unexpected EOF reading name")
   125		}
   126		name := string(raw[off : off+nameLen])
   127		off += nameLen
   128	
   129		// dtype (1 byte)
   130		if off+1 > len(raw) {
   131			return fail("unexpected EOF reading dtype")
   132		}
   133		dtype := raw[off]
   134		off++
   135	
   136		// num_dims (1 byte)
   137		if off+1 > len(raw) {
   138			return fail("unexpected EOF reading num_dims")
   139		}
   140		numDims := int(raw[off])
   141		off++
   142	
   143		// shape (num_dims * uint32 LE)
   144		shapeBytes := numDims * 4
   145		if off+shapeBytes > len(raw) {
   146			return fail("unexpected EOF reading shape")
   147		}
   148		shape := make([]uint32, numDims)
   149		for d := 0; d < numDims; d++ {
   150			shape[d] = binary.LittleEndian.Uint32(raw[off : off+4])
   151			off += 4
   152		}
   153	
   154		// data_size (uint64 LE)
   155		if off+8 > len(raw) {
   156			return fail("unexpected EOF reading data_size")
   157		}
   158		dataSize := binary.LittleEndian.Uint64(raw[off : off+8])
   159		off += 8
   160	
   161		// data
   162		if off+int(dataSize) > len(raw) {
   163			return fail("unexpected EOF reading data")
   164		}
   165		data := raw[off : off+int(dataSize)]
   166		off += int(dataSize)
   167	
   168		// hash (32 bytes SHA-256)
   169		if off+32 > len(raw) {
   170			return fail("unexpected EOF reading hash")
   171		}
   172		var storedHash [32]byte
   173		copy(storedHash[:], raw[off:off+32])
   174		off += 32
   175	
   176		// verify SHA-256
   177		computedHash := sha256.Sum256(data)
   178		valid := computedHash == storedHash
   179	
   180		return types.TensorInfo{
   181			Name:  name,
   182			Dtype: dtype,
   183			Shape: shape,
   184			Data:  data,
   185			Hash:  storedHash,
   186			Valid: valid,
   187		}, off, nil
   188	}
   189	
   190	// parseMetadata parses the metadata section: numMeta key-value pairs.
   191	func parseMetadata(raw []byte, off int, numMeta uint32) (map[string]string, error) {
   192		md := make(map[string]string, numMeta)
   193		for i := uint32(0); i < numMeta; i++ {
   194			// key_len (uint16)
   195			if off+2 > len(raw) {
   196				return md, fmt.Errorf("metadata: unexpected EOF at key_len %d", i)
   197			}
   198			keyLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   199			off += 2
   200	
[?2004hroot@n30009:/app# nl -ba internal/checkpoint/parser.go | sed -n '200,349p'
[?2004l   200	
   201			if off+keyLen > len(raw) {
   202				return md, fmt.Errorf("metadata: unexpected EOF at key %d", i)
   203			}
   204			key := string(raw[off : off+keyLen])
   205			off += keyLen
   206	
   207			// value_len (uint32)
   208			if off+4 > len(raw) {
   209				return md, fmt.Errorf("metadata: unexpected EOF at value_len %d", i)
   210			}
   211			valLen := int(binary.LittleEndian.Uint32(raw[off : off+4]))
   212			off += 4
   213	
   214			if off+valLen > len(raw) {
   215				return md, fmt.Errorf("metadata: unexpected EOF at value %d", i)
   216			}
   217			val := string(raw[off : off+valLen])
   218			off += valLen
   219	
   220			md[key] = val
   221		}
   222		return md, nil
   223	}
   224	
   225	// parseProvenance parses the provenance section.
   226	func parseProvenance(raw []byte, off int) (*types.Provenance, error) {
   227		p := &types.Provenance{}
   228	
   229		// GitCommit: 40 bytes ASCII
   230		if off+40 > len(raw) {
   231			return nil, fmt.Errorf("provenance: unexpected EOF at git_commit")
   232		}
   233		p.GitCommit = strings.TrimRight(string(raw[off:off+40]), "\x00")
   234		off += 40
   235	
   236		// DatasetHash: 32 bytes raw → hex
   237		if off+32 > len(raw) {
   238			return nil, fmt.Errorf("provenance: unexpected EOF at dataset_hash")
   239		}
   240		p.DatasetHash = hex.EncodeToString(raw[off : off+32])
   241		off += 32
   242	
   243		// ConfigHash: 32 bytes raw → hex
   244		if off+32 > len(raw) {
   245			return nil, fmt.Errorf("provenance: unexpected EOF at config_hash")
   246		}
   247		p.ConfigHash = hex.EncodeToString(raw[off : off+32])
   248		off += 32
   249	
   250		// TrainingTimestamp: int64
   251		if off+8 > len(raw) {
   252			return nil, fmt.Errorf("provenance: unexpected EOF at training_timestamp")
   253		}
   254		p.TrainingTimestamp = int64(binary.LittleEndian.Uint64(raw[off : off+8]))
   255		off += 8
   256	
   257		// TrainingDuration: float64
   258		if off+8 > len(raw) {
   259			return nil, fmt.Errorf("provenance: unexpected EOF at training_duration")
   260		}
   261		p.TrainingDuration = math.Float64frombits(binary.LittleEndian.Uint64(raw[off : off+8]))
   262		off += 8
   263	
   264		// Framework: uint16 len + bytes
   265		if off+2 > len(raw) {
   266			return nil, fmt.Errorf("provenance: unexpected EOF at framework_len")
   267		}
   268		fwLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   269		off += 2
   270		if off+fwLen > len(raw) {
   271			return nil, fmt.Errorf("provenance: unexpected EOF at framework")
   272		}
   273		p.Framework = string(raw[off : off+fwLen])
   274		off += fwLen
   275	
   276		// FrameworkVersion: uint16 len + bytes
   277		if off+2 > len(raw) {
   278			return nil, fmt.Errorf("provenance: unexpected EOF at framework_version_len")
   279		}
   280		fvLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   281		off += 2
   282		if off+fvLen > len(raw) {
   283			return nil, fmt.Errorf("provenance: unexpected EOF at framework_version")
   284		}
   285		p.FrameworkVersion = string(raw[off : off+fvLen])
   286		off += fvLen
   287	
   288		// Epoch: uint32
   289		if off+4 > len(raw) {
   290			return nil, fmt.Errorf("provenance: unexpected EOF at epoch")
   291		}
   292		p.Epoch = binary.LittleEndian.Uint32(raw[off : off+4])
   293		off += 4
   294	
   295		// GlobalStep: uint64
   296		if off+8 > len(raw) {
   297			return nil, fmt.Errorf("provenance: unexpected EOF at global_step")
   298		}
   299		p.GlobalStep = binary.LittleEndian.Uint64(raw[off : off+8])
   300		off += 8
   301	
   302		// LearningRate: float64
   303		if off+8 > len(raw) {
   304			return nil, fmt.Errorf("provenance: unexpected EOF at learning_rate")
   305		}
   306		p.LearningRate = math.Float64frombits(binary.LittleEndian.Uint64(raw[off : off+8]))
   307		off += 8
   308	
   309		// ParentHash: uint16 len + bytes (ASCII hex SHA-256 of parent file)
   310		if off+2 > len(raw) {
   311			return nil, fmt.Errorf("provenance: unexpected EOF at parent_hash_len")
   312		}
   313		phLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   314		off += 2
   315		if phLen > 0 {
   316			if off+phLen > len(raw) {
   317				return nil, fmt.Errorf("provenance: unexpected EOF at parent_hash")
   318			}
   319			p.ParentHash = string(raw[off : off+phLen])
   320			off += phLen
   321		}
   322	
   323		return p, nil
   324	}
   325	
   326	// ParseAll finds and parses every .mlck file in the given directory
   327	// (non-recursive). Files are returned in lexicographic order by filename.
   328	func ParseAll(dir string) ([]*types.CheckpointFile, error) {
   329		entries, err := os.ReadDir(dir)
   330		if err != nil {
   331			return nil, fmt.Errorf("checkpoint: read dir %s: %w", dir, err)
   332		}
   333	
   334		var results []*types.CheckpointFile
   335		for _, e := range entries {
   336			if e.IsDir() {
   337				continue
   338			}
   339			if !strings.HasSuffix(strings.ToLower(e.Name()), ".mlck") {
   340				continue
   341			}
   342			cf, err := Parse(filepath.Join(dir, e.Name()))
   343			if err != nil {
   344				return nil, err
   345			}
   346			results = append(results, cf)
   347		}
   348		return results, nil
   349	}
