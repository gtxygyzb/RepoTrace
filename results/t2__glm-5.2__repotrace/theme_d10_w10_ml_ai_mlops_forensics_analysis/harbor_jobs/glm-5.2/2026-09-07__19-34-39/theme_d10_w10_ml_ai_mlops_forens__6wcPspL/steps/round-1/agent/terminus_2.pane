   331		}
   332		vc.ProvenanceValid = validateProvenance(cf)
   333		if !vc.ProvenanceValid {
   334			vc.Issues = append(vc.Issues, VerifyIssue{Type: "provenance_invalid", Detail: ""})
   335		}
[?2004hroot@n30009:/app# nl -ba docs/output_schema.md | sed -n '100,230p'
[?2004l   100	    }
   101	  ]
   102	}
   103	```
   104	
   105	**Field rules:**
   106	- `entries`: sorted by `(epoch ASC, step ASC)`.
   107	- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.
   108	- `conflict`: `true` if this entry was chosen by conflict resolution.
   109	- `gaps`: only gaps where `gap_steps > 100` within the same epoch.
   110	- Entries with missing optional fields omit them from the JSON (do not include null).
   111	
   112	---
   113	
   114	## 3. Verify Output
   115	
   116	```json
   117	{
   118	  "status": "ok",
   119	  "checkpoints": [
   120	    {
   121	      "file": "model_epoch1.mlck",
   122	      "valid": true,
   123	      "header_checksum_valid": true,
   124	      "tensor_checksums_valid": true,
   125	      "signature_valid": null,
   126	      "provenance_valid": true,
   127	      "issues": []
   128	    },
   129	    {
   130	      "file": "model_epoch3.mlck",
   131	      "valid": false,
   132	      "header_checksum_valid": true,
   133	      "tensor_checksums_valid": false,
   134	      "signature_valid": true,
   135	      "provenance_valid": true,
   136	      "issues": [
   137	        "tensor_checksum_mismatch:encoder.layer2.weight"
   138	      ]
   139	    }
   140	  ],
   141	  "summary": {
   142	    "total": 3,
   143	    "valid": 2,
   144	    "invalid": 1
   145	  }
   146	}
   147	```
   148	
   149	**Field rules:**
   150	- `checkpoints`: sorted by `file` name lexicographically.
   151	- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.
   152	- `issues`: list of human-readable issue descriptions. Format for tensor checksum mismatch: `"tensor_checksum_mismatch:<tensor_name>"`.
   153	- `valid`: `true` only if all applicable checks pass.
   154	
   155	---
   156	
   157	## 4. Detect Output
   158	
   159	```json
   160	{
   161	  "status": "ok",
   162	  "anomalies": [
   163	    {
   164	      "id": "ANOM-001",
   165	      "type": "gradient_spike",
   166	      "severity": "high",
   167	      "epoch": 2,
   168	      "step": 3456,
   169	      "details": {
   170	        "observed": 15.3,
   171	        "window_mean": 1.2,
   172	        "window_stddev": 0.3,
   173	        "z_score": 47.0
   174	      },
   175	      "source": "shard_002.jsonl"
   176	    },
   177	    {
   178	      "id": "ANOM-002",
   179	      "type": "tensor_checksum_mismatch",
   180	      "severity": "critical",
   181	      "details": {
   182	        "file": "model_epoch3.mlck",
   183	        "tensor_name": "encoder.layer2.weight",
   184	        "expected_checksum": "abcd1234...",
   185	        "actual_checksum": "efgh5678..."
   186	      },
   187	      "source": "model_epoch3.mlck"
   188	    }
   189	  ],
   190	  "summary": {
   191	    "total": 5,
   192	    "by_severity": {
   193	      "critical": 1,
   194	      "high": 2,
   195	      "medium": 1,
   196	      "low": 1
   197	    },
   198	    "by_type": {
   199	      "gradient_spike": 1,
   200	      "loss_divergence": 1,
   201	      "tensor_checksum_mismatch": 1,
   202	      "training_gap": 1,
   203	      "lr_anomaly": 1
   204	    }
   205	  }
   206	}
   207	```
   208	
   209	**Field rules:**
   210	- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.
   211	- `anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.
   212	- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.
   213	- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.
   214	- `source`: the artifact file where the anomaly was detected.
   215	- `epoch` and `step`: present only for timeline-based anomalies.
   216	- If no anomalies are detected, `anomalies` is an empty array.
   217	
   218	---
