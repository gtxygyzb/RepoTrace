    61	func (q query) eval(e types.TimelineEntry) bool {
    62		for _, g := range q.ors {
    63			ok := true
    64			for _, c := range g.ands {
    65				if !c.eval(e) {
    66					ok = false
    67					break
    68				}
    69			}
    70			if ok {
    71				return true
    72			}
    73		}
    74		return false
    75	}
    76	
    77	func (c condition) eval(e types.TimelineEntry) bool {
    78		switch c.field {
    79		case "step":
    80			return compareNum(float64(e.Step), c)
    81		case "epoch":
    82			return compareNum(float64(e.Epoch), c)
    83		case "loss":
    84			return ptrCompareNum(e.Loss, c)
    85		case "lr":
    86			return ptrCompareNum(e.Lr, c)
    87		case "grad_norm":
    88			return ptrCompareNum(e.GradNorm, c)
    89		case "acc":
    90			return ptrCompareNum(e.Acc, c)
    91		case "event":
    92			return compareStr(e.Event, c)
    93		case "ts":
    94			return compareTs(e.Ts, c)
    95		}
    96		return false
    97	}
    98	
    99	func compareNum(val float64, c condition) bool {
   100		if !c.isNum {
   101			return false
   102		}
   103		switch c.op {
   104		case ">":
   105			return val > c.fval
   106		case "<":
   107			return val < c.fval
   108		case ">=":
   109			return val >= c.fval
   110		case "<=":
   111			return val <= c.fval
   112		case "==":
   113			return absFloat(val-c.fval) <= 1e-9
   114		case "!=":
   115			return absFloat(val-c.fval) > 1e-9
   116		}
   117		return false
   118	}
   119	
   120	func ptrCompareNum(p *float64, c condition) bool {
   121		if p == nil {
   122			return false
   123		}
   124		return compareNum(*p, c)
   125	}
   126	
   127	func compareStr(val string, c condition) bool {
   128		if c.isNum {
   129			return false
   130		}
   131		switch c.op {
   132		case "==":
   133			return val == c.sval
   134		case "!=":
   135			return val != c.sval
   136		}
   137		return false
   138	}
   139	
   140	func compareTs(val string, c condition) bool {
   141		lt, err := time.Parse(time.RFC3339, val)
   142		if err != nil {
   143			return false
   144		}
   145		rt, err := time.Parse(time.RFC3339, c.sval)
   146		if err != nil {
   147			return false
   148		}
   149		switch c.op {
   150		case ">":
   151			return lt.After(rt)
   152		case "<":
   153			return lt.Before(rt)
   154		case ">=":
   155			return lt.After(rt) || lt.Equal(rt)
   156		case "<=":
   157			return lt.Before(rt) || lt.Equal(rt)
   158		case "==":
   159			return lt.Equal(rt)
   160		case "!=":
   161			return !lt.Equal(rt)
   162		}
   163		return false
   164	}
   165	
   166	func absFloat(x float64) float64 {
   167		if x < 0 {
   168			return -x
   169		}
   170		return x
   171	}
