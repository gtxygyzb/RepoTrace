\t\tif e.Loss != nil {
\t\t\tlossEntries = append(lossEntries, i)
\t\t}
\t}
\tif len(lossEntries) < 2 {
\t\treturn nil
\t}
\tconst alpha = 0.05
\temaLoss := *entries[lossEntries[0]].Loss
\tvar anomalies []types.Anomaly
\tfor i := 1; i < len(lossEntries); i++ {
\t\tcurrentLoss := *entries[lossEntries[i]].Loss
\t\tif math.Abs(emaLoss) > 1e-6 {
\t\t\tratio := currentLoss / emaLoss
\t\t\tif currentLoss > 2.0*emaLoss {
\t\t\t\tseverity := "high"
