[?2004l     1	package checkpoint
     2	
     3	import (
     4		"crypto/sha256"
     5		"encoding/binary"
     6		"encoding/hex"
     7		"fmt"
     8		"hash/fnv"
     9		"math"
    10		"os"
    11		"path/filepath"
    12		"strings"
    13	
    14		"mlforge/internal/types"
    15	)
    16	
    17	const (
    18		magicMLCK  = "MLCK"
    19		headerSize = 56
    20	)
    21	
    22	// Parse reads and validates a single .mlck checkpoint file according to the
    23	// MLCK binary format specification (see /app/docs/formats.md).
    24	func Parse(path string) (*types.CheckpointFile, error) {
    25		raw, err := os.ReadFile(path)
    26		if err != nil {
    27			return nil, fmt.Errorf("checkpoint: read %s: %w", path, err)
    28		}
    29		if len(raw) < headerSize {
    30			return nil, fmt.Errorf("checkpoint: file too small (%d bytes)", len(raw))
    31		}
    32	
    33		// --- magic (offset 0, 4 bytes) ---
    34		if string(raw[0:4]) != magicMLCK {
    35			return nil, fmt.Errorf("checkpoint: bad magic %q", raw[0:4])
    36		}
    37	
    38		// --- header fields ---
    39		version := binary.LittleEndian.Uint16(raw[4:6])
    40		flags := binary.LittleEndian.Uint16(raw[6:8])
    41		numTensors := binary.LittleEndian.Uint32(raw[8:12])
    42		numMetadata := binary.LittleEndian.Uint32(raw[12:16])
    43		metadataOffset := binary.LittleEndian.Uint64(raw[16:24])
    44		provenanceOffset := binary.LittleEndian.Uint64(raw[24:32])
    45		_ = binary.LittleEndian.Uint64(raw[32:40]) // signatureOffset (unused for now)
    46		creationTimestamp := int64(binary.LittleEndian.Uint64(raw[40:48]))
    47		storedChecksum := binary.LittleEndian.Uint64(raw[48:56])
    48	
    49		// --- verify header checksum: FNV-1a of bytes [0..48) ---
    50		h := fnv.New64a()
    51		h.Write(raw[:48])
    52		computedChecksum := h.Sum64()
    53		headerValid := computedChecksum == storedChecksum
    54	
    55		// --- SHA-256 file hash ---
    56		fileHashBytes := sha256.Sum256(raw)
    57		fileHash := hex.EncodeToString(fileHashBytes[:])
    58	
    59		signed := flags&1 != 0
    60	
    61		cf := &types.CheckpointFile{
    62			Path:              path,
    63			Filename:          filepath.Base(path),
    64			Version:           uint32(version),
    65			Flags:             flags,
    66			NumTensors:        numTensors,
    67			NumMetadataKeys:   numMetadata,
    68			CreationTimestamp:  creationTimestamp,
    69			HeaderValid:       headerValid,
    70			FileHash:          fileHash,
    71			Signed:            signed,
    72		}
    73	
    74		// --- parse tensor blocks (start at offset 56) ---
    75		off := headerSize
    76		tensors := make([]types.TensorInfo, 0, numTensors)
    77		for i := uint32(0); i < numTensors; i++ {
    78			ti, newOff, err := parseTensor(raw, off, i)
    79			if err != nil {
    80				return nil, err
    81			}
    82			tensors = append(tensors, ti)
    83			off = newOff
    84		}
    85		cf.Tensors = tensors
    86	
    87		// --- parse metadata section ---
    88		if numMetadata > 0 && metadataOffset > 0 && int(metadataOffset) < len(raw) {
    89			md, err := parseMetadata(raw, int(metadataOffset), numMetadata)
    90			if err == nil {
    91				cf.MetadataMap = md
    92			}
    93		}
    94	
    95		// --- parse provenance section ---
    96		if provenanceOffset > 0 && int(provenanceOffset) < len(raw) {
    97			prov, err := parseProvenance(raw, int(provenanceOffset))
    98			if err == nil {
    99				cf.Provenance = prov
   100				cf.HasParent = prov.ParentHash != ""
   101				cf.ParentHex = prov.ParentHash
   102			}
   103		}
   104	
   105		return cf, nil
   106	}
   107	
   108	// parseTensor parses one tensor block starting at off and returns the
   109	// TensorInfo plus the new offset after the block.
   110	func parseTensor(raw []byte, off int, idx uint32) (types.TensorInfo, int, error) {
   111		fail := func(msg string) (types.TensorInfo, int, error) {
   112			return types.TensorInfo{}, 0, fmt.Errorf("checkpoint: tensor %d: %s", idx, msg)
   113		}
   114	
   115		// name_len (uint16 LE)
   116		if off+2 > len(raw) {
   117			return fail("unexpected EOF reading name_len")
   118		}
   119		nameLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))
   120		off += 2
   121	
   122		// name
   123		if off+nameLen > len(raw) {
   124			return fail("unexpected EOF reading name")
   125		}
   126		name := string(raw[off : off+nameLen])
   127		off += nameLen
   128	
   129		// dtype (1 byte)
   130		if off+1 > len(raw) {
[?2004hroot@n30009:/app# nl -ba internal/checkpoint/parser.go | sed -n '130,230p'
[?2004l   130		if off+1 > len(raw) {
   131			return fail("unexpected EOF reading dtype")
   132		}
   133		dtype := raw[off]
   134		off++
   135	
   136		// num_dims (1 byte)
   137		if off+1 > len(raw) {
   138			return fail("unexpected EOF reading num_dims")
   139		}
   140		numDims := int(raw[off])
   141		off++
   142	
   143		// shape (num_dims * uint32 LE)
   144		shapeBytes := numDims * 4
   145		if off+shapeBytes > len(raw) {
   146			return fail("unexpected EOF reading shape")
   147		}
   148		shape := make([]uint32, numDims)
   149		for d := 0; d < numDims; d++ {
   150			shape[d] = binary.LittleEndian.Uint32(raw[off : off+4])
   151			off += 4
   152		}
   153	
   154		// data_size (uint64 LE)
   155		if off+8 > len(raw) {
   156			return fail("unexpected EOF reading data_size")
   157		}
   158		dataSize := binary.LittleEndian.Uint64(raw[off : off+8])
   159		off += 8
   160	
   161		// data
   162		if off+int(dataSize) > len(raw) {
   163			return fail("unexpected EOF reading data")
   164		}
   165		data := raw[off : off+int(dataSize)]
   166		off += int(dataSize)
   167	
   168		// hash (32 bytes SHA-256)
   169		if off+32 > len(raw) {
   170			return fail("unexpected EOF reading hash")
   171		}
   172		var storedHash [32]byte
   173		copy(storedHash[:], raw[off:off+32])
   174		off += 32
   175	
   176		// verify SHA-256
   177		computedHash := sha256.Sum256(data)
   178		valid := computedHash == storedHash
   179	
   180		return types.TensorInfo{
   181			Name:  name,
   182			Dtype: dtype,
   183			Shape: shape,
   184			Data:  data,
   185			Hash:  storedHash,
   186			Valid: valid,
   187		}, off, nil
   188	}
