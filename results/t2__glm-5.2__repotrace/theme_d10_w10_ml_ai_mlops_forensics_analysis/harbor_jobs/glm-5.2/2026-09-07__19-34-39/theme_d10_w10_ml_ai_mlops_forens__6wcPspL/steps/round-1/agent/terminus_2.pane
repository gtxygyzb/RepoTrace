    38	type DetectOutput struct {
    39		Status    string          `json:"status"`
    40		Anomalies []types.Anomaly `json:"anomalies"`
    41		Summary   struct {
    42			Total      int            `json:"total"`
    43			BySeverity map[string]int `json:"by_severity"`
    44			ByType     map[string]int `json:"by_type"`
    45		} `json:"summary"`
    46	}
    47	
    48	func BuildDetect(dir string) (interface{}, error) {
    49		return buildDetectWithDir(dir)
    50	}
    51	
    52	func buildDetectWithDir(dir string) (DetectOutput, error) {
    53		var out DetectOutput
    54		out.Status = "ok"
    55		var anomalies []types.Anomaly
    56	
    57		entries, _, err := loadTimelineEntries(dir)
    58		if err == nil {
    59			merged, _ := mergeTimeline(entries)
    60			sortTimeline(merged)
    61			anomalies = append(anomalies, detectTimelineAnomalies(merged)...)
    62		}
    63	
    64		cps, err := loadCheckpoints(dir)
    65		if err == nil {
    66			anomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)
    67		}
    68	
    69		for i := range anomalies {
    70			anomalies[i].ID = fmt.Sprintf("ANOM-%03d", i+1)
    71		}
    72		sortAnomalies(anomalies)
    73	
    74		out.Anomalies = anomalies
    75		if out.Anomalies == nil {
    76			out.Anomalies = []types.Anomaly{}
    77		}
    78		out.Summary.Total = len(anomalies)
    79		out.Summary.BySeverity = map[string]int{"critical": 0, "high": 0, "medium": 0, "low": 0}
    80		out.Summary.ByType = map[string]int{}
    81		for _, a := range anomalies {
    82			out.Summary.BySeverity[a.Severity]++
    83			out.Summary.ByType[a.Type]++
    84		}
    85		return out, nil
    86	}
    87	
    88	func detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {
    89		var anomalies []types.Anomaly
    90		anomalies = append(anomalies, detectGradientSpikes(entries)...)
    91		anomalies = append(anomalies, detectLossDivergence(entries)...)
    92		anomalies = append(anomalies, detectLrAnomalies(entries)...)
    93		anomalies = append(anomalies, detectTrainingGaps(entries)...)
    94		anomalies = append(anomalies, detectMetricRegression(entries)...)
    95		return anomalies
    96	}
    97	
    98	func detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {
    99		var vals []float64
   100		var idx []int
   101		for i, e := range entries {
   102			if e.GradNorm != nil {
   103				vals = append(vals, *e.GradNorm)
   104				idx = append(idx, i)
   105			}
   106		}
   107		if len(vals) < 31 {
   108			return nil
   109		}
   110		var anomalies []types.Anomaly
   111		for i := 30; i < len(vals); i++ {
   112			window := vals[i-30 : i]
   113			mean := meanFloats(window)
   114			std := stddevFloats(window, mean)
   115			observed := vals[i]
   116			z := 0.0
   117			if std > 0 {
   118				z = (observed - mean) / std
   119			}
   120			if observed > mean+2.5*std && z > 2.5 {
   121				severity := "medium"
   122				if z > 4.0 {
   123					severity = "high"
   124				}
   125				ep := entries[idx[i]].Epoch
   126				st := entries[idx[i]].Step
   127				anomalies = append(anomalies, types.Anomaly{
   128					Type:     "gradient_spike",
   129					Severity: severity,
   130					Epoch:    &ep,
   131					Step:     &st,
   132					Details: map[string]interface{}{
   133						"observed":      observed,
   134						"window_mean":   mean,
   135						"window_stddev": std,
   136						"z_score":       z,
   137					},
   138					Source: firstSource(entries[idx[i]]),
   139				})
   140			}
   141		}
   142		return anomalies
   143	}
   144	
   145	func detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {
   146		var lossEntries []int
   147		for i, e := range entries {
   148			if e.Loss != nil {
   149				lossEntries = append(lossEntries, i)
   150			}
   151		}
   152		if len(lossEntries) < 51 {
   153			return nil
   154		}
   155		var anomalies []types.Anomaly
   156		for i := 50; i < len(lossEntries); i++ {
   157			startIdx := lossEntries[i-50]
   158			endIdx := lossEntries[i]
   159			start := *entries[startIdx].Loss
   160			end := *entries[endIdx].Loss
   161			if math.Abs(start) <= 1e-6 {
   162				continue
   163			}
   164			ratio := (end - start) / math.Abs(start)
   165			if ratio > 1.0 {
   166				severity := "high"
   167				if ratio > 5.0 {
   168					severity = "critical"
   169				}
   170				ep := entries[endIdx].Epoch
   171				st := entries[endIdx].Step
   172				anomalies = append(anomalies, types.Anomaly{
   173					Type:     "loss_divergence",
   174					Severity: severity,
   175					Epoch:    &ep,
   176					Step:     &st,
   177					Details: map[string]interface{}{
   178						"loss_start":        start,
   179						"loss_end":          end,
   180						"increase_ratio":    ratio,
   181						"window_start_step": entries[startIdx].Step,
   182						"window_end_step":   entries[endIdx].Step,
   183					},
   184					Source: firstSource(entries[endIdx]),
   185				})
   186			}
   187		}
   188		return anomalies
   189	}
   190	
   191	func detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {
   192		var anomalies []types.Anomaly
   193		for i := 1; i < len(entries); i++ {
   194			prev := entries[i-1]
   195			cur := entries[i]
   196			if prev.Lr == nil || cur.Lr == nil {
   197				continue
   198			}
   199			if *cur.Lr > *prev.Lr {
   200				if cur.Event == "epoch_end" {
   201					continue
   202				}
   203				ep := cur.Epoch
   204				st := cur.Step
   205				anomalies = append(anomalies, types.Anomaly{
   206					Type:     "lr_anomaly",
   207					Severity: "medium",
   208					Epoch:    &ep,
   209					Step:     &st,
   210					Details: map[string]interface{}{
   211						"prev_lr": *prev.Lr,
   212						"curr_lr": *cur.Lr,
   213						"step":    cur.Step,
   214					},
   215					Source: firstSource(cur),
   216				})
   217			}
   218		}
   219		return anomalies
   220	}
   221	
   222	func detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {
   223		var anomalies []types.Anomaly
   224		for i := 1; i < len(entries); i++ {
   225			prev := entries[i-1]
   226			cur := entries[i]
   227			if prev.Epoch != cur.Epoch {
   228				continue
   229			}
   230			prevT, err1 := time.Parse(time.RFC3339, prev.Ts)
   231			curT, err2 := time.Parse(time.RFC3339, cur.Ts)
   232			if err1 != nil || err2 != nil {
   233				continue
   234			}
   235			diff := curT.Sub(prevT).Seconds()
   236			if diff > 3600 {
   237				ep := cur.Epoch
   238				st := cur.Step
   239				anomalies = append(anomalies, types.Anomaly{
   240					Type:     "training_gap",
   241					Severity: "low",
   242					Epoch:    &ep,
   243					Step:     &st,
   244					Details: map[string]interface{}{
   245						"after_step":  prev.Step,
   246						"before_step": cur.Step,
   247						"after_ts":    prev.Ts,
   248						"before_ts":   cur.Ts,
   249						"gap_seconds": diff,
   250					},
   251					Source: firstSource(cur),
   252				})
   253			}
   254		}
   255		return anomalies
   256	}
   257	
