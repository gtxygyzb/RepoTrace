[?2004l[?2004h> path = Path("docs/analysis_rules.md")
[?2004l[?2004h> text = path.read_text()
[?2004l[?2004h> 
[?2004l[?2004h> old = """### 3.1 Grammar
[?2004l[?2004h> 
[?2004l[?2004h> ```
[?2004l[?2004h> query      := condition (BOOL_OP condition)*
[?2004l[?2004h> condition  := field COMP_OP value
[?2004l[?2004h> BOOL_OP    := "AND" | "OR"
[?2004l[?2004h> COMP_OP    := ">" | "<" | ">=" | "<=" | "==" | "!="
[?2004l[?2004h> field      := "step" | "epoch" | "loss" | "lr" | "grad_norm" | "acc" | "event" | "ts"
[?2004l[?2004h> value      := NUMBER | QUOTED_STRING | TIMESTAMP
[?2004l[?2004h> NUMBER     := integer or float literal
[?2004l[?2004h> QUOTED_STRING := '"' ... '"' (double-quoted string)
[?2004l[?2004h> TIMESTAMP  := ISO 8601 format (e.g., 2024-01-15T10:30:00Z)
[?2004l[?2004h> ```
[?2004l[?2004h> 
[?2004l[?2004h> ### 3.2 Operator Precedence
[?2004l[?2004h> 
[?2004l[?2004h> - `AND` binds tighter than `OR`
[?2004l[?2004h> - Parentheses are NOT supported (keep the grammar simple)
[?2004l[?2004h> - Evaluation: left to right with AND having higher precedence
[?2004l[?2004h> 
[?2004l[?2004h> Example: `loss > 1.0 OR grad_norm > 5.0 AND epoch == 3`
[?2004l[?2004h> Parses as: `loss > 1.0 OR (grad_norm > 5.0 AND epoch == 3)`
[?2004l[?2004h> """
