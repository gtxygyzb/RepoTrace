    22	type ArtifactPaths struct {
    23		Checkpoints []string
    24		Logs        []string
    25		Configs     []string
    26	}
    27	
    28	func DiscoverArtifacts(dir string) (ArtifactPaths, error) {
    29		var ap ArtifactPaths
    30		err := filepath.WalkDir(dir, func(path string, d os.DirEntry, err error) error {
    31			if err != nil {
    32				return err
    33			}
    34			if d.IsDir() {
    35				return nil
    36			}
    37			name := d.Name()
    38			lower := strings.ToLower(name)
    39			switch {
    40			case strings.HasSuffix(lower, ".mlck"):
    41				ap.Checkpoints = append(ap.Checkpoints, path)
    42			case strings.HasSuffix(lower, ".jsonl"):
    43				ap.Logs = append(ap.Logs, path)
    44			case strings.HasPrefix(name, "config_") && strings.HasSuffix(lower, ".json"):
    45				ap.Configs = append(ap.Configs, path)
    46			}
    47			return nil
    48		})
    49		if err != nil {
    50			return ap, err
    51		}
    52		sort.Strings(ap.Checkpoints)
    53		sort.Strings(ap.Logs)
    54		sort.Strings(ap.Configs)
    55		return ap, nil
    56	}
