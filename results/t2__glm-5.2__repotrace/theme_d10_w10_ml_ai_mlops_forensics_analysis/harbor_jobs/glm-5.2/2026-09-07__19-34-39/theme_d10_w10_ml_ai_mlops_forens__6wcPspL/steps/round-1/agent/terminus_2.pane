    12	func main() {
    13		// --- Parse flags ---------------------------------------------------
    14		format := "json"
    15		verbose := false
    16		var positional []string
    17	
    18		for _, arg := range os.Args[1:] {
    19			switch {
    20			case arg == "--verbose":
    21				verbose = true
    22			case strings.HasPrefix(arg, "--format="):
    23				format = strings.TrimPrefix(arg, "--format=")
    24			case arg == "--format":
    25			// handled below as two-token flag
    26			default:
    27				positional = append(positional, arg)
    28			}
    29		}
    30	
    31		// Handle "--format json" (two separate tokens)
    32		for i := 1; i < len(os.Args)-1; i++ {
    33			if os.Args[i] == "--format" {
    34				format = os.Args[i+1]
    35				// Remove the value from positional args
    36				filtered := positional[:0]
    37				for _, p := range positional {
    38					if p != os.Args[i+1] {
    39						filtered = append(filtered, p)
    40					}
    41				}
    42				positional = filtered
    43				break
    44			}
    45		}
    46	
    47		if format != "json" && format != "text" {
    48			fmt.Fprintf(os.Stderr, "invalid format %q: must be json or text\n", format)
    49			os.Exit(1)
    50		}
    51	
    52		_ = verbose // reserved for diagnostic output
    53	
    54		// --- Validate positional args --------------------------------------
    55		if len(positional) < 2 {
    56			fmt.Fprintf(os.Stderr, "Usage: mlforge <command> <evidence-dir> [args...]\n")
    57			os.Exit(1)
    58		}
    59	
    60		cmd := positional[0]
    61		dir := positional[1]
    62	
    63		// --- Route to command handler --------------------------------------
    64		var result interface{}
    65		var err error
    66	
    67		switch cmd {
    68		case "ingest":
    69			result, err = forensics.BuildIngest(dir)
    70		case "timeline":
    71			result, err = forensics.BuildTimeline(dir)
    72		case "verify":
    73			result, err = forensics.BuildVerify(dir)
    74		case "detect":
    75			result, err = forensics.BuildDetect(dir)
    76		case "lineage":
    77			result, err = forensics.BuildLineage(dir)
    78		case "query":
    79			if len(positional) < 3 {
    80				fmt.Fprintf(os.Stderr, "Usage: mlforge query <dir> \"<expression>\"\n")
    81				os.Exit(1)
    82			}
    83			result, err = forensics.BuildQuery(dir, positional[2])
    84		case "diff":
    85			if len(positional) < 4 {
    86				fmt.Fprintf(os.Stderr, "Usage: mlforge diff <dir> <file1> <file2>\n")
    87				os.Exit(1)
    88			}
    89			result, err = forensics.BuildDiff(dir, positional[2], positional[3])
    90		case "report":
    91			result, err = forensics.BuildReport(dir)
    92		default:
    93			fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
    94			os.Exit(1)
    95		}
    96	
    97		// --- Output --------------------------------------------------------
    98		if err != nil {
    99			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   100			os.Exit(1)
   101		}
   102	
   103		if format == "text" {
   104			printText(result)
   105			return
   106		}
   107	
   108		out, marshalErr := json.MarshalIndent(result, "", "  ")
   109		if marshalErr != nil {
   110			fmt.Fprintf(os.Stderr, "error marshalling result: %v\n", marshalErr)
   111			os.Exit(1)
   112		}
   113		fmt.Println(string(out))
   114	}
   115	
   116	func printText(v interface{}) {
   117		b, err := json.MarshalIndent(v, "", "  ")
   118		if err != nil {
   119			fmt.Fprintln(os.Stderr, "error rendering text output")
   120			return
   121		}
   122		fmt.Println(string(b))
   123	}
