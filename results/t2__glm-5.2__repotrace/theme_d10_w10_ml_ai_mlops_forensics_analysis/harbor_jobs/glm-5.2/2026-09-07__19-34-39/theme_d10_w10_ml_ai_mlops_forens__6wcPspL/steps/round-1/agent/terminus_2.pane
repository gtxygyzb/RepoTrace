    98	func BuildIngest(dir string) (interface{}, error) {
    99		ap, err := DiscoverArtifacts(dir)
   100		if err != nil {
   101			return nil, err
   102		}
   103		if len(ap.Checkpoints) == 0 && len(ap.Logs) == 0 && len(ap.Configs) == 0 {
   104			return nil, fmt.Errorf("no recognizable artifacts found in %s", dir)
   105		}
   106	
   107		var out IngestOutput
   108		out.Status = "ok"
   109		out.EvidenceDir = dir
   110		out.Artifacts.Checkpoints = []IngestCheckpoint{}
   111		out.Artifacts.LogShards = []IngestLogShard{}
   112		out.Artifacts.Configs = []IngestConfig{}
   113	
   114		for _, p := range ap.Checkpoints {
   115			cf, err := checkpoint.Parse(p)
   116			if err != nil || cf == nil {
   117				continue
   118			}
   119			ic := IngestCheckpoint{
   120				File:              cf.Filename,
   121				FileHash:          cf.FileHash,
   122				Version:           cf.Version,
   123				NumTensors:        cf.NumTensors,
   124				NumMetadata:       cf.NumMetadataKeys,
   125				Signed:            cf.Signed,
   126				CreationTimestamp: unixToISO(cf.CreationTimestamp),
   127				Provenance:        provenanceToMap(cf.Provenance),
   128			}
   129			out.Artifacts.Checkpoints = append(out.Artifacts.Checkpoints, ic)
   130		}
   131		sort.Slice(out.Artifacts.Checkpoints, func(i, j int) bool {
   132			return out.Artifacts.Checkpoints[i].CreationTimestamp < out.Artifacts.Checkpoints[j].CreationTimestamp
   133		})
   134	
   135		for _, p := range ap.Logs {
   136			info, entries, err := parseShardRecursive(p)
   137			if err != nil {
   138				continue
   139			}
   140			shard := IngestLogShard{
   141				File:    info.File,
   142				Entries: info.Entries,
   143			}
   144			if info.Entries > 0 {
   145				shard.StepRange = []int{info.MinStep, info.MaxStep}
   146				shard.EpochRange = []int{info.MinEpoch, info.MaxEpoch}
   147				if info.MinTs != "" || info.MaxTs != "" {
   148					shard.TimeRange = []string{info.MinTs, info.MaxTs}
   149				}
   150			}
   151			_ = entries
   152			out.Artifacts.LogShards = append(out.Artifacts.LogShards, shard)
   153		}
   154		sort.Slice(out.Artifacts.LogShards, func(i, j int) bool {
   155			return out.Artifacts.LogShards[i].File < out.Artifacts.LogShards[j].File
   156		})
   157	
   158		for _, p := range ap.Configs {
   159			cfg, err := readConfigSummary(p)
   160			if err != nil {
   161				continue
   162			}
   163			out.Artifacts.Configs = append(out.Artifacts.Configs, cfg)
   164		}
   165		sort.Slice(out.Artifacts.Configs, func(i, j int) bool {
   166			return out.Artifacts.Configs[i].File < out.Artifacts.Configs[j].File
   167		})
   168	
   169		out.Totals.Checkpoints = len(out.Artifacts.Checkpoints)
   170		out.Totals.LogShards = len(out.Artifacts.LogShards)
   171		out.Totals.Configs = len(out.Artifacts.Configs)
   172		return out, nil
   173	}
