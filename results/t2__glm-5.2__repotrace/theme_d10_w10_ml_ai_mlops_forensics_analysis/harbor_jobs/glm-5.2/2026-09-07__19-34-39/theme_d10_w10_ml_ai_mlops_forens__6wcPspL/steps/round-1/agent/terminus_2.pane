   266	
   267	func BuildVerify(dir string) (interface{}, error) {
   268		ap, err := DiscoverArtifacts(dir)
   269		if err != nil {
   270			return nil, err
   271		}
   272		if len(ap.Checkpoints) == 0 {
   273			return nil, fmt.Errorf("no checkpoint files found")
   274		}
   275		var out VerifyOutput
   276		out.Status = "ok"
   277		for _, p := range ap.Checkpoints {
   278			vc := verifyCheckpoint(p)
   279			out.Checkpoints = append(out.Checkpoints, vc)
   280		}
   281		sort.Slice(out.Checkpoints, func(i, j int) bool {
   282			return out.Checkpoints[i].File < out.Checkpoints[j].File
   283		})
   284		out.Summary.Total = len(out.Checkpoints)
   285		for _, c := range out.Checkpoints {
   286			if c.Valid {
   287				out.Summary.Valid++
   288			} else {
   289				out.Summary.Invalid++
   290			}
   291		}
   292		return out, nil
   293	}
