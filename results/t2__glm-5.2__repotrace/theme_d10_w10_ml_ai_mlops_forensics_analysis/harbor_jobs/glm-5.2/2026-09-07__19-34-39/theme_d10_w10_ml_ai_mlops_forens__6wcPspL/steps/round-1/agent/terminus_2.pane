   194	
   195	func BuildTimeline(dir string) (interface{}, error) {
   196		entries, shards, err := loadTimelineEntries(dir)
   197		if err != nil {
   198			return nil, err
   199		}
   200		return buildTimelineFromEntries(entries, shards), nil
   201	}
   202	
   203	func buildTimelineFromEntries(entries []types.TimelineEntry, shards []logparser.ShardInfo) TimelineOutput {
   204		merged, conflicts := mergeTimeline(entries)
