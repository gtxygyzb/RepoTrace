    38	type DetectOutput struct {
    39		Status    string          `json:"status"`
    40		Anomalies []types.Anomaly `json:"anomalies"`
    41		Summary   struct {
    42			Total      int            `json:"total"`
    43			BySeverity map[string]int `json:"by_severity"`
    44			ByType     map[string]int `json:"by_type"`
    45		} `json:"summary"`
    46	}
    47	
    48	func BuildDetect(dir string) (interface{}, error) {
    49		return buildDetectWithDir(dir)
    50	}
    51	
    52	func buildDetectWithDir(dir string) (DetectOutput, error) {
    53		var out DetectOutput
    54		out.Status = "ok"
    55		var anomalies []types.Anomaly
    56	
    57		entries, _, err := loadTimelineEntries(dir)
    58		if err == nil {
    59			merged, _ := mergeTimeline(entries)
    60			sortTimeline(merged)
    61			anomalies = append(anomalies, detectTimelineAnomalies(merged)...)
    62		}
    63	
    64		cps, err := loadCheckpoints(dir)
    65		if err == nil {
    66			anomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)
    67		}
    68	
    69		for i := range anomalies {
    70			anomalies[i].ID = fmt.Sprintf("ANOM-%03d", i+1)
    71		}
    72		sortAnomalies(anomalies)
    73	
    74		out.Anomalies = anomalies
    75		if out.Anomalies == nil {
    76			out.Anomalies = []types.Anomaly{}
    77		}
    78		out.Summary.Total = len(anomalies)
    79		out.Summary.BySeverity = map[string]int{"critical": 0, "high": 0, "medium": 0, "low": 0}
    80		out.Summary.ByType = map[string]int{}
    81		for _, a := range anomalies {
    82			out.Summary.BySeverity[a.Severity]++
    83			out.Summary.ByType[a.Type]++
    84		}
    85		return out, nil
    86	}
    87	
    88	func detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {
    89		var anomalies []types.Anomaly
    90		anomalies = append(anomalies, detectGradientSpikes(entries)...)
    91		anomalies = append(anomalies, detectLossDivergence(entries)...)
    92		anomalies = append(anomalies, detectLrAnomalies(entries)...)
    93		anomalies = append(anomalies, detectTrainingGaps(entries)...)
    94		anomalies = append(anomalies, detectMetricRegression(entries)...)
    95		return anomalies
    96	}
