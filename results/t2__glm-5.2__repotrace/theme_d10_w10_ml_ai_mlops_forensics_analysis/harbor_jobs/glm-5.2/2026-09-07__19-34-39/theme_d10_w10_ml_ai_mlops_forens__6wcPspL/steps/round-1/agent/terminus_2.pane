    11	
    12	type QueryOutput struct {
    13		Status  string                `json:"status"`
    14		Query   string                `json:"query"`
    15		Matches int                   `json:"matches"`
    16		Entries []types.TimelineEntry `json:"entries"`
    17	}
    18	
    19	func BuildQuery(dir, expr string) (interface{}, error) {
    20		entries, _, err := loadTimelineEntries(dir)
    21		if err != nil {
    22			return nil, err
    23		}
    24		merged, _ := mergeTimeline(entries)
    25		sortTimeline(merged)
    26	
    27		q, err := parseQuery(expr)
    28		if err != nil {
    29			return nil, err
    30		}
    31		matches := []types.TimelineEntry{}
    32		for _, e := range merged {
    33			if q.eval(e) {
    34				matches = append(matches, e)
    35			}
    36		}
    37		return QueryOutput{
    38			Status:  "ok",
    39			Query:   expr,
    40			Matches: len(matches),
    41			Entries: matches,
    42		}, nil
    43	}
    44	
    45	type condition struct {
    46		field string
    47		op    string
    48		sval  string
    49		fval  float64
    50		isNum bool
    51	}
    52	
    53	type orGroup struct {
    54		ands []condition
    55	}
    56	
    57	type query struct {
    58		ors []orGroup
    59	}
    60	
    61	func (q query) eval(e types.TimelineEntry) bool {
    62		for _, g := range q.ors {
    63			ok := true
    64			for _, c := range g.ands {
    65				if !c.eval(e) {
    66					ok = false
    67					break
    68				}
    69			}
    70			if ok {
    71				return true
    72			}
    73		}
    74		return false
    75	}
    76	
    77	func (c condition) eval(e types.TimelineEntry) bool {
    78		switch c.field {
    79		case "step":
    80			return compareNum(float64(e.Step), c)
    81		case "epoch":
    82			return compareNum(float64(e.Epoch), c)
    83		case "loss":
    84			return ptrCompareNum(e.Loss, c)
    85		case "lr":
    86			return ptrCompareNum(e.Lr, c)
    87		case "grad_norm":
    88			return ptrCompareNum(e.GradNorm, c)
    89		case "acc":
    90			return ptrCompareNum(e.Acc, c)
    91		case "event":
    92			return compareStr(e.Event, c)
    93		case "ts":
    94			return compareTs(e.Ts, c)
    95		}
    96		return false
    97	}
    98	
    99	func compareNum(val float64, c condition) bool {
   100		if !c.isNum {
   101			return false
   102		}
   103		switch c.op {
   104		case ">":
   105			return val > c.fval
   106		case "<":
   107			return val < c.fval
   108		case ">=":
   109			return val >= c.fval
   110		case "<=":
   111			return val <= c.fval
   112		case "==":
   113			return absFloat(val-c.fval) <= 1e-9
   114		case "!=":
   115			return absFloat(val-c.fval) > 1e-9
   116		}
   117		return false
   118	}
