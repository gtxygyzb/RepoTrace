package forensics

import (
	"crypto/hmac"
	"crypto/sha256"
	"encoding/binary"
	"encoding/hex"
	"fmt"
	"hash/fnv"
	"math"
	"os"
	"sort"
	"time"

	"mlforge/internal/checkpoint"
	"mlforge/internal/types"
)

func loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {
	ap, err := DiscoverArtifacts(dir)
	if err != nil {
		return nil, err
	}
	var cps []*types.CheckpointFile
	for _, p := range ap.Checkpoints {
		cf, err := checkpoint.Parse(p)
		if err != nil || cf == nil {
			continue
		}
		cps = append(cps, cf)
	}
	sort.Slice(cps, func(i, j int) bool {
		return cps[i].Filename < cps[j].Filename
	})
	return cps, nil
}

type DetectOutput struct {
	Status    string          `json:"status"`
	Anomalies []types.Anomaly `json:"anomalies"`
	Summary   struct {
		Total      int            `json:"total"`
		BySeverity map[string]int `json:"by_severity"`
		ByType     map[string]int `json:"by_type"`
	} `json:"summary"`
}

func BuildDetect(dir string) (interface{}, error) {
	return buildDetectWithDir(dir)
}

func buildDetectWithDir(dir string) (DetectOutput, error) {
	var out DetectOutput
	out.Status = "ok"
	var anomalies []types.Anomaly

	entries, _, err := loadTimelineEntries(dir)
	if err == nil {
		merged, _ := mergeTimeline(entries)
		sortTimeline(merged)
		anomalies = append(anomalies, detectTimelineAnomalies(merged)...)
	}

	cps, err := loadCheckpoints(dir)
	if err == nil {
		anomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)
	}

	for i := range anomalies {
		anomalies[i].ID = fmt.Sprintf("ANOM-%03d", i+1)
	}
	sortAnomalies(anomalies)

	out.Anomalies = anomalies
	if out.Anomalies == nil {
		out.Anomalies = []types.Anomaly{}
	}
	out.Summary.Total = len(anomalies)
	out.Summary.BySeverity = map[string]int{"critical": 0, "high": 0, "medium": 0, "low": 0}
	out.Summary.ByType = map[string]int{}
	for _, a := range anomalies {
		out.Summary.BySeverity[a.Severity]++
		out.Summary.ByType[a.Type]++
	}
	return out, nil
}

func detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {
	var anomalies []types.Anomaly
	anomalies = append(anomalies, detectGradientSpikes(entries)...)
	anomalies = append(anomalies, detectLossDivergence(entries)...)
	anomalies = append(anomalies, detectLrAnomalies(entries)...)
	anomalies = append(anomalies, detectTrainingGaps(entries)...)
	anomalies = append(anomalies, detectMetricRegression(entries)...)
	return anomalies
}

func detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {
	var vals []float64
	var idx []int
	for i, e := range entries {
		if e.GradNorm != nil {
			vals = append(vals, *e.GradNorm)
			idx = append(idx, i)
		}
	}
	if len(vals) < 31 {
		return nil
	}
	var anomalies []types.Anomaly
	for i := 30; i < len(vals); i++ {
		window := vals[i-30 : i]
		mean := meanFloats(window)
		std := stddevFloats(window, mean)
		observed := vals[i]
		z := 0.0
		if std > 0 {
			z = (observed - mean) / std
		}
		if observed > mean+2.5*std && z > 2.5 {
			severity := "medium"
			if z > 4.0 {
				severity = "high"
			}
			ep := entries[idx[i]].Epoch
			st := entries[idx[i]].Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "gradient_spike",
				Severity: severity,
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"observed":      observed,
					"window_mean":   mean,
					"window_stddev": std,
					"z_score":       z,
				},
				Source: firstSource(entries[idx[i]]),
			})
		}
	}
	return anomalies
}

func detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {
	var lossEntries []int
	for i, e := range entries {
		if e.Loss != nil {
			lossEntries = append(lossEntries, i)
		}
	}
	if len(lossEntries) < 51 {
		return nil
	}
	var anomalies []types.Anomaly
	for i := 50; i < len(lossEntries); i++ {
		startIdx := lossEntries[i-50]
		endIdx := lossEntries[i]
		start := *entries[startIdx].Loss
		end := *entries[endIdx].Loss
		if math.Abs(start) <= 1e-6 {
			continue
		}
		ratio := (end - start) / math.Abs(start)
		if ratio > 1.0 {
			severity := "high"
			if ratio > 5.0 {
				severity = "critical"
			}
			ep := entries[endIdx].Epoch
			st := entries[endIdx].Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "loss_divergence",
				Severity: severity,
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"loss_start":        start,
					"loss_end":          end,
					"increase_ratio":    ratio,
					"window_start_step": entries[startIdx].Step,
					"window_end_step":   entries[endIdx].Step,
				},
				Source: firstSource(entries[endIdx]),
			})
		}
	}
	return anomalies
}

func detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {
	var anomalies []types.Anomaly
	for i := 1; i < len(entries); i++ {
		prev := entries[i-1]
		cur := entries[i]
		if prev.Lr == nil || cur.Lr == nil {
			continue
		}
		if *cur.Lr > *prev.Lr {
			if cur.Event == "epoch_end" {
				continue
			}
			ep := cur.Epoch
			st := cur.Step
			anomalies = append(anomalies, types.Anomaly{
				Type:     "lr_anomaly",
				Severity: "medium",
				Epoch:    &ep,
				Step:     &st,
				Details: map[string]interface{}{
					"prev_lr": *prev.Lr,
					"curr_lr": *cur.Lr,
					"step":    cur.Step,
				},
				Source: firstSource(cur),
			})
		}
	}
	return anomalies
}
