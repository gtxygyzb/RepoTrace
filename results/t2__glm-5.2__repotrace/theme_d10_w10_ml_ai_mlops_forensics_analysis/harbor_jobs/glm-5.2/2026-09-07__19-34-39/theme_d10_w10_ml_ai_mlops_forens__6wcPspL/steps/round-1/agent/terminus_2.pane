   590	func meanFloats(v []float64) float64 {
   591		if len(v) == 0 {
   592			return 0
   593		}
   594		s := 0.0
   595		for _, x := range v {
   596			s += x
   597		}
   598		return s / float64(len(v))
   599	}
   600	
   601	func stddevFloats(v []float64, mean float64) float64 {
   602		if len(v) == 0 {
   603			return 0
   604		}
   605		s := 0.0
   606		for _, x := range v {
   607			d := x - mean
   608			s += d * d
   609		}
   610		return math.Sqrt(s / float64(len(v)))
   611	}
