[1157.112396, "o", "\u001b[?2004h"]
[1157.112451, "o", "> "]
[1157.112805, "o", "        h = (h * 0x100000001b3) & 0xffffffffffffffff\r\n\u001b[?2004l\r"]
[1157.112871, "o", "\u001b[?2004h> "]
[1157.113023, "o", "    return h\r\n\u001b[?2004l\r"]
