[6173.513367, "o", "     1\tpackage forensics\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/hmac\"\r\n     5\t\t\"crypto/sha256\"\r\n     6\t\t\"encoding/binary\"\r\n     7\t\t\"encoding/hex\"\r\n"]
[6173.513483, "o", "     8\t\t\"fmt\"\r\n     9\t\t\"hash/fnv\"\r\n    10\t\t\"math\"\r\n    11\t\t\"os\"\r\n    12\t\t\"sort\"\r\n    13\t\t\"time\"\r\n    14\t\r\n    15\t\t\"mlforge/internal/checkpoint\"\r\n    16\t\t\"mlforge/internal/types\"\r\n    17\t)\r\n    18\t\r\n    19\tfunc loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {\r\n    20\t\tap, err := DiscoverArtifacts(dir)\r\n    21\t\tif err != nil {\r\n    22\t\t\treturn nil, err\r\n    23\t\t}"]
[6173.513587, "o", "\r\n    24\t\tvar cps []*types.CheckpointFile\r\n    25\t\tfor _, p := range ap.Checkpoints {\r\n    26\t\t\tcf, err := checkpoint.Parse(p)\r\n    27\t\t\tif err != nil || cf == nil {\r\n    28\t\t\t\tcontinue\r\n"]
[6173.513661, "o", "    29\t\t\t}\r\n    30\t\t\tcps = append(cps, cf)\r\n    31\t\t}\r\n    32\t\tsort.Slice(cps, func(i, j int) bool {\r\n    33\t\t\treturn cps[i].Filename < cps[j].Filename\r\n    34\t\t})\r\n    35\t\treturn cps, nil\r\n    36\t}\r\n    37\t\r\n    38\ttype DetectOutput struct {\r\n    39\t\tStatus    string          `json:\"status\"`\r\n    40\t\tAnomalies []types.Anomaly `json:\"anomalies\"`\r\n    41\t\tSummary   struct {\r\n    42\t\t\tTotal      int            `json:\"total\"`\r\n    43\t\t\tBySeverity map[string]int `json:\"by_severity\"`\r\n    44\t\t\tByType     map[string]int `json:\"by_type\"`\r\n"]
[6173.513738, "o", "    45\t\t} `json:\"summary\"`\r\n    46\t}\r\n    47\t\r\n    48\tfunc BuildDetect(dir string) (interface{}, error) {\r\n    49\t\treturn BuildDetectFiltered(dir, \"\")\r\n    50\t}\r\n    51\t\r\n    52\tfunc BuildDetectFiltered(dir, filterSeverity string) (DetectOutput, error) {\r\n    53\t\tvar out DetectOutput\r\n    54\t\tout.Status = \"ok\"\r\n    55\t\tvar anomalies []types.Anomaly\r\n"]
[6173.513809, "o", "    56\t\r\n    57\t\tentries, _, err := loadTimelineEntries(dir)\r\n    58\t\tif err == nil {\r\n    59\t\t\tmerged, _ := mergeTimeline(entries)\r\n    60\t\t\tsortTimeline(merged)\r\n    61\t\t\tanomalies = append(anomalies, detectTimelineAnomalies(merged)...)\r\n    62\t\t}\r\n    63\t\r\n    64\t\tcps, err := loadCheckpoints(dir)\r\n    65\t\tif err == nil {\r\n"]
[6173.51388, "o", "    66\t\t\tanomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\r\n    67\t\t}\r\n    68\t\r\n    69\t\tif filterSeverity != \"\" {\r\n    70\t\t\twantedRank, ok := severityRankValue(filterSeverity)\r\n    71\t\t\tif !ok {\r\n    72\t\t\t\treturn out, fmt.Errorf(\"invalid severity level %q: must be critical, high, medium, low, or info\", filterSeverity)\r\n    73\t\t\t}\r\n    74\t\t\tfiltered := anomalies[:0]\r\n    75\t\t\tfor _, a := range anomalies {\r\n    76\t\t\t\tif severityRank(a.Severity) <= wantedRank {\r\n"]
[6173.514193, "o", "    77\t\t\t\t\tfiltered = append(filtered, a)\r\n    78\t\t\t\t}\r\n    79\t\t\t}\r\n    80\t\t\tanomalies = filtered\r\n    81\t\t}\r\n    82\t\r\n    83\t\tfor i := range anomalies {\r\n    84\t\t\tanomalies[i].ID = fmt.Sprintf(\"ANOM-%03d\", i+1)\r\n    85\t\t}\r\n    86\t\tsortAnomalies(anomalies)\r\n    87\t\r\n    88\t\tout.Anomalies = anomalies\r\n    89\t\tif out.Anomalies == nil {\r\n    90\t\t\tout.Anomalies = []types.Anomaly{}\r\n    91\t\t}\r\n    92\t\tout.Summary.Total = len(anomalies)\r\n    93\t\tout.Summary.BySeverity = map[string]int{}\r\n    94\t\tout.Summary.ByType = map[string]int{}\r\n    95\t\tfor _, a := range anomalies {\r\n    96\t\t\tout.Summary.BySeverity[a.Severity]++\r\n    97\t\t\tout.Summary.ByType[a.Type]++\r\n    98\t\t}\r\n    99\t\treturn out, nil\r\n   100\t}\r\n   101\t\r\n   102\tfunc severityRank(s string) int {\r\n   103\t\tswitch s {\r\n   104\t\tcase \"critical\":\r\n   105\t\t\treturn 0\r\n   106\t\tcase \"high\":\r\n   107\t\t\treturn 1\r\n   108\t\tcase \"medium\":\r\n   109\t\t\treturn 2\r\n   110\t\tcase \"low\":\r\n   111\t\t\treturn 3\r\n   112\t\tcase \"info\":\r\n"]
[6173.514374, "o", "   113\t\t\treturn 4\r\n   114\t\t}\r\n   115\t\treturn 4\r\n   116\t}\r\n   117\t\r\n   118\tfunc severityRankValue(s string) (int, bool) {\r\n   119\t\tswitch s {\r\n   120\t\tcase \"critical\":\r\n   121\t\t\treturn 0, true\r\n   122\t\tcase \"high\":\r\n   123\t\t\treturn 1, true\r\n   124\t\tcase \"medium\":\r\n   125\t\t\treturn 2, true\r\n   126\t\tcase \"low\":\r\n   127\t\t\treturn 3, true\r\n   128\t\tcase \"info\":\r\n   129\t\t\treturn 4, true\r\n   130\t\t}\r\n   131\t\treturn 0, false\r\n   132\t}\r\n   133\t\r\n   134\tfunc detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n   135\t\tvar anomalies []types.Anomaly\r\n   136\t\tanomalies = append(anomalies, detectGradientSpikes(entries)...)\r\n   137\t\tanomalies = append(anomalies, detectLossDivergence(entries)...)\r\n   138\t\tanomalies = append(anomalies, detectLrAnomalies(entries)...)\r\n   139\t\tanomalies = append(anomalies, detectTrainingGaps(entries)...)\r\n   140\t\tanomalies = append(anomalies, detectMetricRegression(entries)...)\r\n   141\t\treturn anomalies\r\n   142\t}\r\n   143\t\r\n   144\tfunc detectGradientSpikes(entries []types.Timeli"]
[6173.514459, "o", "neEntry) []types.Anomaly {\r\n   145\t\tvar vals []float64\r\n   146\t\tvar idx []int\r\n   147\t\tfor i, e := range entries {\r\n   148\t\t\tif e.GradNorm != nil {\r\n   149\t\t\t\tvals = append(vals, *e.GradNorm)\r\n   150\t\t\t\tidx = append(idx, i)\r\n   151\t\t\t}\r\n   152\t\t}\r\n   153\t\tif len(vals) < 31 {\r\n   154\t\t\treturn nil\r\n   155\t\t}\r\n   156\t\tvar anomalies []types.Anomaly\r\n   157\t\tfor i := 30; i < len(vals); i++ {\r\n   158\t\t\twindow := vals[i-30 : i]\r\n   159\t\t\tmean := meanFloats(window)\r\n   160\t\t\tstd := stddevFloats(window, mean)\r\n"]
[6173.514531, "o", "   161\t\t\tobserved := vals[i]\r\n   162\t\t\tz := 0.0\r\n   163\t\t\tif std > 0 {\r\n   164\t\t\t\tz = (observed - mean) / std\r\n   165\t\t\t}\r\n   166\t\t\tif observed > mean+2.5*std && z > 2.5 {\r\n   167\t\t\t\tseverity := \"medium\"\r\n   168\t\t\t\tif z > 4.0 {\r\n"]
[6173.514596, "o", "   169\t\t\t\t\tseverity = \"high\"\r\n   170\t\t\t\t}\r\n   171\t\t\t\tep := entries[idx[i]].Epoch\r\n   172\t\t\t\tst := entries[idx[i]].Step\r\n   173\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   174\t\t\t\t\tType:     \"gradient_spike\",\r\n   175\t\t\t\t\tSeverity: severity,\r\n   176\t\t\t\t\tEpoch:    &ep,\r\n   177\t\t\t\t\tStep:     &st,\r\n   178\t\t\t\t\tDetails: map[string]interface{}{\r\n"]
[6173.51466, "o", "   179\t\t\t\t\t\t\"observed\":      observed,\r\n   180\t\t\t\t\t\t\"window_mean\":   mean,\r\n   181\t\t\t\t\t\t\"window_stddev\": std,\r\n   182\t\t\t\t\t\t\"z_score\":       z,\r\n   183\t\t\t\t\t},\r\n   184\t\t\t\t\tEvidence: map[string]interface{}{\"window_values\": lastValues(window, 5)},\r\n"]
[6173.514719, "o", "   185\t\t\t\t\tSource:   firstSource(entries[idx[i]]),\r\n   186\t\t\t\t})\r\n   187\t\t\t}\r\n   188\t\t}\r\n   189\t\treturn anomalies\r\n   190\t}\r\n   191\t\r\n   192\tfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n   193\t\tvar lossEntries []int\r\n"]
[6173.514778, "o", "   194\t\tfor i, e := range entries {\r\n   195\t\t\tif e.Loss != nil {\r\n   196\t\t\t\tlossEntries = append(lossEntries, i)\r\n   197\t\t\t}\r\n   198\t\t}\r\n   199\t\tif len(lossEntries) < 51 {\r\n   200\t\t\treturn nil\r\n   201\t\t}\r\n   202\t\tvar anomalies []types.Anomaly\r\n"]
[6173.514858, "o", "   203\t\tfor i := 50; i < len(lossEntries); i++ {\r\n   204\t\t\tstartIdx := lossEntries[i-50]\r\n   205\t\t\tendIdx := lossEntries[i]\r\n   206\t\t\tstart := *entries[startIdx].Loss\r\n   207\t\t\tend := *entries[endIdx].Loss\r\n   208\t\t\tif math.Abs(start) <= 1e-6 {\r\n   209\t\t\t\tcontinue\r\n   210\t\t\t}\r\n   211\t\t\tratio := (end - start) / math.Abs(start)\r\n   212\t\t\tif ratio > 1.0 {\r\n"]
[6173.514919, "o", "   213\t\t\t\tseverity := \"high\"\r\n   214\t\t\t\tif ratio > 5.0 {\r\n   215\t\t\t\t\tseverity = \"critical\"\r\n   216\t\t\t\t}\r\n   217\t\t\t\tep := entries[endIdx].Epoch\r\n   218\t\t\t\tst := entries[endIdx].Step\r\n"]
[6173.515, "o", "   219\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   220\t\t\t\t\tType:     \"loss_divergence\",\r\n"]
