[3708.750247, "o", "\r\n### 2.9 Training Gap\r\n\r\n- **Method**: Consecutive timeline entries (after merge sort) have timestamps more than 2 hours apart\r\n- **Trigger**: `time_diff > 7200 seconds` between consecutive entries within the same epoch\r\n- **Severity**: `low`\r\n- **Output fields**: `after_step`, `before_step`, `after_ts`, `before_ts`, `gap_seconds`\r\n"]
[3708.750355, "o", "\r\n### 2.10 Dataset Hash Inconsistency\r\n\r\n- **Method**: Compare `DatasetHash` across all checkpoints in the same lineage chain\r\n- **Trigger**: Different `DatasetHash` values within the same chain\r\n- **Severity**: `high`\r\n- **Output fields**: `files`, `hashes` (list of unique hex hashes)\r\n\r\n---\r\n\r\n## 3. Query Language\r\n\r\n### 3.1 Grammar\r\n\r\n```\r\nquery      := condition (BOOL_OP condition)*\r\ncondition  := field COMP_OP value\r\nBOOL_OP    := \"AND\" | \"OR\"\r\nCOMP_OP    := \">\" | \"<\" | \">=\" | \"<=\" | \"==\" | \"!=\"\r\nfield      := \"step\" | \"epoch\" | \"loss\" | \"lr\" | \"grad_norm\" | \"acc\" | \"event\" | \"ts\"\r\n"]
[3708.75043, "o", "value      := NUMBER | QUOTED_STRING | TIMESTAMP\r\nNUMBER     := integer or float literal\r\nQUOTED_STRING := '\"' ... '\"' (double-quoted string)\r\nTIMESTAMP  := ISO 8601 format (e.g., 2024-01-15T10:30:00Z)\r\n```\r\n\r\n### 3.2 Operator Precedence\r\n\r\n- `AND` binds tighter than `OR`\r\n- Parentheses are NOT supported (keep the grammar simple)\r\n- Evaluation: left to right with AND having higher precedence\r\n\r\nExample: `loss > 1.0 OR grad_norm > 5.0 AND epoch == 3`\r\nParses as: `loss > 1.0 OR (grad_norm > 5.0 AND epoch == 3)`\r\n"]
[3708.750496, "o", "\r\n### 3.3 Type Rules\r\n\r\n"]
[3708.750955, "o", "\u001b[?2004h"]
[3708.751017, "o", "root@n30009:/app# "]
[3846.796036, "i", "cat > internal/forensics/query.go <<'EOF'\npackage forensics\n\nimport (\n\t\"fmt\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"mlforge/internal/types\"\n)\n\ntype QueryOutput struct {\n\tStatus  string                `json:\"status\"`\n\tQuery   string                `json:\"query\"`\n\tMatches int                   `json:\"matches\"`\n\tEntries []types.TimelineEntry `json:\"entries\"`\n}\n\nfunc BuildQuery(dir, expr string) (interface{}, error) {\n\tentries, _, err := loadTimelineEntries(dir)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmerged, _ := mergeTimeline(entries)\n\tsortTimeline(merged)\n\n\tq, err := parseQuery(expr)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmatches := []types.TimelineEntry{}\n\tfor _, e := range merged {\n\t\tif q.eval(e) {\n\t\t\tmatches = append(matches, e)\n\t\t}\n\t}\n\treturn QueryOutput{\n\t\tStatus:  \"ok\",\n\t\tQuery:   expr,\n\t\tMatches: len(matches),\n\t\tEntries: matches,\n\t}, nil\n}\n\ntype condition struct {\n\tfield string\n\top    string\n\tsval  string\n\tfval  float64\n\tisNum bool\n}\n\ntype node interface {\n\teval(e types.TimelineEntry) bool\n}\n\ntype conditionNod"]
[3846.796323, "i", "e struct {\n\tcondition condition\n}\n\ntype notNode struct {\n\tchild node\n}\n\ntype andNode struct {\n\tchildren []node\n}\n\ntype orNode struct {\n\tchildren []node\n}\n\nfunc (c conditionNode) eval(e types.TimelineEntry) bool {\n\treturn c.condition.eval(e)\n}\n\nfunc (n notNode) eval(e types.TimelineEntry) bool {\n\treturn !n.child.eval(e)\n}\n\nfunc (a andNode) eval(e types.TimelineEntry) bool {\n\tfor _, child := range a.children {\n\t\tif !child.eval(e) {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc (o orNode) eval(e types.TimelineEntry) bool {\n\tfor _, child := range o.children {\n\t\tif child.eval(e) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc (c condition) eval(e types.TimelineEntry) bool {\n\tswitch c.field {\n\tcase \"step\":\n\t\treturn compareNum(float64(e.Step), c)\n\tcase \"epoch\":\n\t\treturn compareNum(float64(e.Epoch), c)\n\tcase \"loss\":\n\t\treturn ptrCompareNum(e.Loss, c)\n\tcase \"lr\":\n\t\treturn ptrCompareNum(e.Lr, c)\n\tcase \"grad_norm\":\n\t\treturn ptrCompareNum(e.GradNorm, c)\n\tcase \"acc\":\n\t\treturn ptrCompareNum(e.Acc, c)\n\tcase \"event\":\n\t\treturn com"]
[3846.796422, "i", "pareStr(e.Event, c)\n\tcase \"ts\":\n\t\treturn compareTs(e.Ts, c)\n\t}\n\treturn false\n}\n\nfunc compareNum(val float64, c condition) bool {\n\tif !c.isNum {\n\t\treturn false\n\t}\n\tswitch c.op {\n\tcase \">\":\n\t\treturn val > c.fval\n\tcase \"<\":\n\t\treturn val < c.fval\n\tcase \">=\":\n\t\treturn val >= c.fval\n\tcase \"<=\":\n\t\treturn val <= c.fval\n\tcase \"==\":\n\t\treturn absFloat(val-c.fval) <= 1e-9\n\tcase \"!=\":\n\t\treturn absFloat(val-c.fval) > 1e-9\n\t}\n\treturn false\n}\n\nfunc ptrCompareNum(p *float64, c condition) bool {\n\tif p == nil {\n\t\treturn false\n\t}\n\treturn compareNum(*p, c)\n}\n\nfunc compareStr(val string, c condition) bool {\n\tif c.isNum {\n\t\treturn false\n\t}\n\tswitch c.op {\n\tcase \"==\":\n\t\treturn val == c.sval\n\tcase \"!=\":\n\t\treturn val != c.sval\n\t}\n\treturn false\n}\n\nfunc compareTs(val string, c condition) bool {\n\tlt, err := time.Parse(time.RFC3339, val)\n\tif err != nil {\n\t\treturn false\n\t}\n\trt, err := time.Parse(time.RFC3339, c.sval)\n\tif err != nil {\n\t\treturn false\n\t}\n\tswitch c.op {\n\tcase \">\":\n\t\treturn lt.After(rt)\n\tcase \"<\":\n\t\treturn lt.Before(rt)\n\tcase \">"]
