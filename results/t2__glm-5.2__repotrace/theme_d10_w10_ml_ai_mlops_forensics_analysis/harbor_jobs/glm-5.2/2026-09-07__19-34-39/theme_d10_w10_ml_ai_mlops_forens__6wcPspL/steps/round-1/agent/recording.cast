[3607.50124, "o", "if field == \"ts\" {\r\n   238\t\t\tif _, err := time.Parse(time.RFC3339, unquote(valueTok)); err != nil {\r\n   239\t\t\t\treturn condition{}, i, fmt.Errorf(\"invalid timestamp: %s\", valueTok)\r\n   240\t\t\t}\r\n   241\t\t\tc.sval = unquote(valueTok)\r\n   242\t\t\treturn c, i + 3, nil\r\n   243\t\t}\r\n   244\t\tnum, err := strconv.ParseFloat(valueTok, 64)\r\n   245\t\tif err != nil {\r\n   246\t\t\treturn condition{}, i, fmt.Errorf(\"type mismatch: %s requires numeric value\", field)\r\n   247\t\t}\r\n   248\t\tc.fval = num\r\n   249\t\tc.isNum = true\r\n   250\t\treturn c, i + 3, nil\r\n   251\t}\r\n   252\t\r\n   253\tfunc tokenizeQuery(s string) ([]string, error) {\r\n   254\t\tvar tokens []string\r\n"]
[3607.501319, "o", "   255\t\ti := 0\r\n   256\t\tfor i < len(s) {\r\n   257\t\t\tch := s[i]\r\n   258\t\t\tif ch == ' ' || ch == '\\t' || ch == '\\n' || ch == '\\r' {\r\n   259\t\t\t\ti++\r\n   260\t\t\t\tcontinue\r\n   261\t\t\t}\r\n   262\t\t\tif ch == '\"' {\r\n   263\t\t\t\tj := i + 1\r\n   264\t\t\t\tfor j < len(s) && s[j] != '\"' {\r\n   265\t\t\t\t\tj++\r\n"]
[3607.501383, "o", "   266\t\t\t\t}\r\n   267\t\t\t\tif j >= len(s) {\r\n   268\t\t\t\t\treturn nil, fmt.Errorf(\"unterminated string\")\r\n   269\t\t\t\t}\r\n   270\t\t\t\ttokens = append(tokens, s[i:j+1])\r\n   271\t\t\t\ti = j + 1\r\n   272\t\t\t\tcontinue\r\n   273\t\t\t}\r\n"]
[3607.501442, "o", "   274\t\t\tif strings.HasPrefix(s[i:], \">=\") || strings.HasPrefix(s[i:], \"<=\") || strings.HasPrefix(s[i:], \"==\") || strings.HasPrefix(s[i:], \"!=\") {\r\n   275\t\t\t\ttokens = append(tokens, s[i:i+2])\r\n   276\t\t\t\ti += 2\r\n   277\t\t\t\tcontinue\r\n   278\t\t\t}\r\n   279\t\t\tif ch == '>' || ch == '<' {\r\n   280\t\t\t\ttokens = append(tokens, string(ch))\r\n   281\t\t\t\ti++\r\n"]
[3607.501513, "o", "   282\t\t\t\tcontinue\r\n   283\t\t\t}\r\n   284\t\t\tj := i\r\n   285\t\t\tfor j < len(s) {\r\n   286\t\t\t\tc := s[j]\r\n   287\t\t\t\tif c == ' ' || c == '\\t' || c == '\\n' || c == '\\r' || c == '>' || c == '<' || c == '=' || c == '!' || c == '\"' {\r\n   288\t\t\t\t\tbreak\r\n   289\t\t\t\t}\r\n   290\t\t\t\tj++\r\n   291\t\t\t}\r\n   292"]
[3607.501581, "o", "\t\t\tif j == i {\r\n   293\t\t\t\treturn nil, fmt.Errorf(\"invalid character in query: %c\", ch)\r\n   294\t\t\t}\r\n   295\t\t\ttokens = append(tokens, s[i:j])\r\n   296\t\t\ti = j\r\n   297\t\t}\r\n"]
[3607.501643, "o", "   298\t\treturn tokens, nil\r\n   299\t}\r\n   300\t\r\n   301\tfunc isQuotedString(s string) bool {\r\n   302\t\treturn len(s) >= 2 && s[0] == '\"' && s[len(s)-1] == '\"'\r\n   303\t}\r\n   304\t\r\n"]
[3607.501705, "o", "   305\tfunc unquote(s string) string {\r\n   306\t\tif isQuotedString(s) {\r\n   307\t\t\treturn s[1 : len(s)-1]\r\n   308\t\t}\r\n   309\t\treturn s\r\n   310\t}\r\n"]
