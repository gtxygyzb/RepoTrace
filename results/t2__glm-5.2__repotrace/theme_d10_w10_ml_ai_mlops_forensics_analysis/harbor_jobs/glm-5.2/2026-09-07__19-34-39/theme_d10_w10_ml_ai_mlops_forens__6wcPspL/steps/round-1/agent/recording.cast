[4456.968783, "o", "\treturn false, \"\"\r\n   477\t\t}\r\n   478\t\tsigOff := binary.LittleEndian.Uint64(raw[32:40])\r\n   479\t\tif sigOff == 0 || int(sigOff) >= len(raw) || int(sigOff)+5 > len(raw) {\r\n   480\t\t\treturn false, \"\"\r\n   481\t\t}\r\n   482\t\toff := int(sigOff)\r\n   483\t\toff++ // algorithm\r\n   484\t\tsignerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n"]
