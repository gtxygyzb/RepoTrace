[3542.122132, "o", "   258\t\t\tif ch == ' ' || ch == '\\t' || ch == '\\n' || ch == '\\r' {\r\n   259\t\t\t\ti++\r\n   260\t\t\t\tcontinue\r\n   261\t\t\t}\r\n   262\t\t\tif ch == '\"' {\r\n   263\t\t\t\tj := i + 1\r\n"]
[3542.122199, "o", "   264\t\t\t\tfor j < len(s) && s[j] != '\"' {\r\n   265\t\t\t\t\tj++\r\n   266\t\t\t\t}\r\n   267\t\t\t\tif j >= len(s) {\r\n   268\t\t\t\t\treturn nil, fmt.Errorf(\"unterminated string\")\r\n   269\t\t\t\t}\r\n   270\t\t\t\t"]
