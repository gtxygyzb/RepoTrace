[716.887505, "i", "  `json:\"orphans\"`\n\tTopologicalOrder []string      `json:\"topological_order\"`\n\tCycles           [][]string    `json:\"cycles\"`\n}\n\nfunc BuildLineage(dir string) (interface{}, error) {\n\tcps, err := loadCheckpoints(dir)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif len(cps) == 0 {\n\t\treturn nil, fmt.Errorf(\"no checkpoint files found\")\n\t}\n\treturn buildLineage(cps), nil\n}\n\nfunc buildLineage(cps []*types.CheckpointFile) LineageOutput {\n\tout := LineageOutput{Status: \"ok\"}\n\tnodeByHash := map[string]*LineageNode{}\n\tcfByHash := map[string]*types.CheckpointFile{}\n\n\tfor _, cf := range cps {\n\t\tcfByHash[cf.FileHash] = cf\n\t\tn := LineageNode{\n\t\t\tFile:              cf.Filename,\n\t\t\tFileHash:          cf.FileHash,\n\t\t\tCreationTimestamp: unixToISO(cf.CreationTimestamp),\n\t\t\tParentHash:        \"\",\n\t\t}\n\t\tif cf.Provenance != nil {\n\t\t\tn.Epoch = cf.Provenance.Epoch\n\t\t\tn.GlobalStep = cf.Provenance.GlobalStep\n\t\t\tn.ParentHash = cf.Provenance.ParentHash\n\t\t}\n\t\tnodeByHash[cf.FileHash] = &n\n\t\tout.Nodes = append(out.Nodes, *n)\n\t}\n\n\tchildren := map[s"]
