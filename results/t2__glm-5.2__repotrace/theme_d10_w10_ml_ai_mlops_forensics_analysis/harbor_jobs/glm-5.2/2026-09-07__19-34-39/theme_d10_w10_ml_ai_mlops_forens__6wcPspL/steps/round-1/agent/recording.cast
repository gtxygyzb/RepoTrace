[3234.523671, "o", "sed -n '40,100p' internal/forensics/diff.go\r\n\u001b[?2004l\r"]
[3234.601783, "o", "\tSummary     diffSummary        `json:\"summary\"`\r\n}\r\n\r\nconst float32Dtype byte = 0\r\n\r\n// BuildDiff compares two checkpoint files inside evidenceDir tensor by tensor.\r\nfunc BuildDiff(evidenceDir, file1, file2 string) (interface{}, error) {\r\n\tpathA := filepath.Join(evidenceDir, file1)\r\n\tpathB := filepath.Join(evidenceDir, file2)\r\n\r\n\tcfA, err := checkpoint.Parse(pathA)\r\n"]
[3234.602009, "o", "\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"diff: %s: %w\", file1, err)\r\n\t}\r\n\tif cfA == nil {\r\n\t\treturn nil, fmt.Errorf(\"diff: %s: not found\", file1)\r\n\t}\r\n\tcfB, err := checkpoint.Parse(pathB)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"diff: %s: %w\", file2, err)\r\n\t}\r\n\tif cfB == nil {\r\n\t\treturn nil, fmt.Errorf(\"diff: %s: not found\", file2)\r\n\t}\r\n\r\n\ttensorsA := make(map[string]types.TensorInfo, len(cfA.Tensors))\r\n\tfor _, t := range cfA.Tensors {\r\n\t\ttensorsA[t.Name] = t\r\n\t}\r\n\ttensorsB := make(map[string]types.TensorInfo, len(cfB.Tensors))\r\n\tfor _, t := range cfB.Tensors {\r\n\t\ttensorsB[t.Name] = t\r\n\t}\r\n\r\n\tnames := map[string]struct{}{}\r\n\tfor name := range tensorsA {\r\n\t\tnames[name] = struct{}{}\r\n\t}\r\n\tfor name := range tensorsB {\r\n\t\tnames[name] = struct{}{}\r\n\t}\r\n\tsortedNames := make([]string, 0, len(names))\r\n\t"]
[3234.602061, "o", "for name := range names {\r\n\t\tsortedNames = append(sortedNames, name)\r\n\t}\r\n\tsort.Strings(sortedNames)\r\n\r\n\tonlyInA := []string{}\r\n\tonlyInB := []string{}\r\n\tcommon := 0\r\n\tshapeMismatches := 0\r\n\ttensorDiffs := make([]diffTensorResult, 0, len(sortedNames))\r\n\r\n"]
[3234.602163, "o", "\tfor _, name := range sortedNames {\r\n\t\tta, okA := tensorsA[name]\r\n\t\ttb, okB := tensorsB[name]\r\n\r\n\t\tvar shapeA []uint32\r\n\t\tvar shapeB []uint32\r\n\t\tif okA {\r\n\t\t\tshapeA = ta.Shape\r\n"]
[3234.602667, "o", "\u001b[?2004h"]
[3234.602726, "o", "root@n30009:/app# "]
[3234.602984, "o", "sed -n '100,190p' internal/forensics/diff.go\r\n\u001b[?2004l\r"]
[3234.60589, "o", "\t\t\tshapeA = ta.Shape\r\n\t\t}\r\n\t\tif okB {\r\n\t\t\tshapeB = tb.Shape\r\n"]
[3234.605971, "o", "\t\t}\r\n\r\n\t\tshapeMatch := okA && okB && shapesEqual(ta.Shape, tb.Shape)\r\n\t\tresult := diffTensorResult{\r\n\t\t\tName:       name,\r\n\t\t\tShapeMatch: shapeMatch,\r\n\t\t\tShapeA:     shapeA,\r\n\t\t\tShapeB:     shapeB,\r\n\t\t}\r\n\r\n\t\tif okA && okB {\r\n"]
[3234.606042, "o", "\t\t\tcommon++\r\n\t\t\tif !shapeMatch {\r\n\t\t\t\tshapeMismatches++\r\n\t\t\t} else {\r\n\t\t\t\tmaxDiff, meanDiff, err := float32DiffStats(ta, tb)\r\n\t\t\t\tif err != nil {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"diff: tensor %s: %w\", name, err)\r\n\t\t\t\t}\r\n\t\t\t\tresult.MaxAbsDiff = &maxDiff\r\n\t"]
[3234.6061, "o", "\t\t\tresult.MeanAbsDiff = &meanDiff\r\n\t\t\t}\r\n\t\t} else if okA {\r\n\t\t\tonlyInA = append(onlyInA, name)\r\n\t\t} else {\r\n\t\t\tonlyInB = append(onlyInB, name)\r\n\t\t}\r\n\r\n\t\ttensorDiffs = append(tensorDiffs, result)\r\n"]
[3234.606165, "o", "\t}\r\n\r\n\treturn diffOutput{\r\n\t\tStatus:      \"ok\",\r\n\t\tFileA:       filepath.Base(file1),\r\n\t\tFileB:       filepath.Base(file2),\r\n\t\tTensorDiffs: tensorDiffs,\r\n\t\tSummary: diffSummary{\r\n\t\t\tTotalTensorsA:   len(tensorsA),\r\n\t\t"]
[3234.606229, "o", "\tTotalTensorsB:   len(tensorsB),\r\n\t\t\tCommonTensors:   common,\r\n\t\t\tShapeMismatches: shapeMismatches,\r\n\t\t\tOnlyInA:         onlyInA,\r\n\t\t\tOnlyInB:         onlyInB,\r\n\t\t},\r\n\t}, nil\r\n}\r\n\r\nfunc shapesEqual(a, b []uint32) bool {\r\n\tif len(a) != len(b) {\r\n"]
[3234.60629, "o", "\t\treturn false\r\n\t}\r\n\tfor i := range a {\r\n\t\tif a[i] != b[i] {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n"]
[3234.606356, "o", "\treturn true\r\n}\r\n\r\nfunc float32DiffStats(a, b types.TensorInfo) (float64, float64, error) {\r\n\tif a.Dtype != float32Dtype || b.Dtype != float32Dtype {\r\n\t\treturn 0, 0, fmt.Errorf(\"unsupported dtype %d/%d; only float32 tensors are supported\", a.Dtype, b.Dtype)\r\n\t}\r\n\tif len(a.Data) != len(b.Data) {\r\n\t\treturn 0, 0, fmt.Errorf(\"data length mismatch %d/%d\", len(a.Data), len(b.Data))\r\n\t}\r\n\tif len(a.Data)%4 != 0 {\r\n\t\treturn 0, 0, fmt.Errorf(\"non-float32 data length %d\", len(a.Data))\r\n\t"]
[3234.606429, "o", "}\r\n\r\n\tn := len(a.Data) / 4\r\n\tif n == 0 {\r\n\t\treturn 0, 0, nil\r\n\t}\r\n\r\n\tvar maxDiff, sumDiff float64\r\n\tfor i := 0; i < n; i++ {\r\n\t\tfa := math.Float32frombits(binary.LittleEndian.Uint32(a.Data[i*4 : i*4+4]))\r\n\t\tfb := math.Float32frombits(binary.LittleEndian.Uint32(b.Data[i*4 : i*4+4]))\r\n\t\td := math.Abs(float64(fa - fb))\r\n\t\tif d > maxDiff {\r\n"]
[3234.606486, "o", "\t\t\tmaxDiff = d\r\n\t\t}\r\n\t\tsumDiff += d\r\n\t}\r\n\treturn maxDiff, sumDiff / float64(n), nil\r\n}\r\n"]
[3234.606948, "o", "\u001b[?2004h"]
[3234.607011, "o", "root@n30009:/app# "]
