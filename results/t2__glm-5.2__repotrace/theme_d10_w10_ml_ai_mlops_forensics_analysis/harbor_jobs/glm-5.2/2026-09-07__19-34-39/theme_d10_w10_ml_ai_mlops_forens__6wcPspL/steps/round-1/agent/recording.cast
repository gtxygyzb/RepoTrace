[4404.382656, "o", "./AGENTS.md\r\n./cmd/mlforge/main.go\r\n./docs/analysis_rules.md\r\n./docs/formats.md\r\n./docs/output_schema.md\r\n./docs/spec.md\r\n./go.mod\r\n./internal/checkpoint/parser.go\r\n./internal/forensics/detect.go\r\n./internal/forensics/diff.go\r\n./internal/forensics/forensics.go\r\n./internal/forensics/lineage.go\r\n./internal/forensics/query.go\r\n./internal/forensics/report.go\r\n./internal/logparser/logparser.go\r\n./internal/types/types.go\r\n./mlforge\r\n"]
