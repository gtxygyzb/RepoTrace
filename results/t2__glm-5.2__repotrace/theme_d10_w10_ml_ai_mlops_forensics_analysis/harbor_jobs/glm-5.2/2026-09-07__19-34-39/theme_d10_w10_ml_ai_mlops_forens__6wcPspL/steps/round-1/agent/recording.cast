[5046.456733, "o", "sed -n '160,230p' internal/forensics/detect.go | cat -A\r\n\u001b[?2004l\r"]
[5046.460427, "o", "^I^I^Iz = (observed - mean) / std$\r\n^I^I}$\r\n^I^Iif observed > mean+2.5*std && z > 2.5 {$\r\n^I^I^Iseverity := \"medium\"$\r\n^I^I^Iif z > 4.0 {$\r\n^I^I^I^Iseverity = \"high\"$\r\n^I^I^I}$\r\n^I^I^Iep := entries[idx[i]].Epoch$\r\n^I^I^Ist := entries[idx[i]].Step$\r\n^I^I^Ianomalies = append(anomalies, types.Anomaly{$\r\n^I^I^I^IType:     \"gradient_spike\",$\r\n^I^I^I^ISeverity: severity,$\r\n^I^I^I^IEpoch:    &ep,$\r\n^I^I^I^IStep:     &st,$\r\n^I^I^I^IDetails: map[string]interface{}{$\r\n^I^I^I^I^I\"observed\":      observed,$\r\n^I^I^I^I^I\"window_mean\":   mean,$\r\n^I^I^I^I^I\"window_stddev\": std,$\r\n^I^I^I^I^I\"z_score\":       z,$\r\n^I^I^I^I},$\r\n^I^I^I^ISource: firstSource(entries[idx[i]]),$\r\n^I^I^I})$\r\n^I^I}$\r\n^I}$\r\n^Ireturn anomalies$\r\n}$\r\n$\r\nfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {$\r\n^Ivar lossEntries []int$\r\n^Ifor i, e := range entries {$\r\n^I^Iif e.Loss != nil {$\r\n^I^I^IlossEntries = append(lossEntries, i)$\r\n^I^I}$\r\n^I}$\r\n^Iif len(lossEntries) < 51 {$\r\n^I^Ireturn nil$\r\n^I}$\r\n^Ivar anomalies []types.Anomaly$\r\n"]
[5046.460572, "o", "^Ifor i := 50; i < len(lossEntries); i++ {$\r\n^I^IstartIdx := lossEntries[i-50]$\r\n^I^IendIdx := lossEntries[i]$\r\n^I^Istart := *entries[startIdx].Loss$\r\n^I^Iend := *entries[endIdx].Loss$\r\n^I^Iif math.Abs(start) <= 1e-6 {$\r\n^I^I^Icontinue$\r\n^I^I}$\r\n^I^Iratio := (end - start) / math.Abs(start)$\r\n^I^Iif ratio > 1.0 {$\r\n^I^I^Iseverity := \"high\"$\r\n^I^I^Iif ratio > 5.0 {$\r\n^I^I^I^Iseverity = \"critical\"$\r\n^I^I^I}$\r\n^I^I^Iep := entries[endIdx].Epoch$\r\n^I^I^Ist := entries[endIdx].Step$\r\n^I^I^Ianomalies = append(anomalies, types.Anomaly{$\r\n^I^I^I^IType:     \"loss_divergence\",$\r\n^I^I^I^ISeverity: severity,$\r\n^I^I^I^IEpoch:    &ep,$\r\n^I^I^I^IStep:     &st,$\r\n^I^I^I^IDetails: map[string]interface{}{$\r\n^I^I^I^I^I\"loss_start\":        start,$\r\n^I^I^I^I^I\"loss_end\":          end,$\r\n^I^I^I^I^I\"increase_ratio\":    ratio,$\r\n^I^I^I^I^I\"window_start_step\": entries[startIdx].Step,$\r\n^I^I^I^I^I\"window_end_step\":   entries[endIdx].Step,$\r\n^I^I^I^I},$\r\n^I^I^I^ISource: firstSource(entries[endIdx]),$\r\n^I^I^I})$\r\n^I^I}$\r\n^I}$\r\n^Ireturn ano"]
[5046.460645, "o", "malies$\r\n"]
