[3567.809046, "o", "\t\t\t\tcur = orGroup{}\r\n   187\t\t\t\t} else if tok == \"AND\" {\r\n   188\t\t\t\t\t// continue adding to cur\r\n   189\t\t\t\t}\r\n   190\t\t\t\ti++\r\n   191\t\t\t\tcontinue\r\n"]
[3567.809105, "o", "   192\t\t\t}\r\n   193\t\t\tcond, next, err := parseCondition(tokens, i)\r\n   194\t\t\tif err != nil {\r\n   195\t\t\t\treturn query{}, err\r\n   196\t\t\t}\r\n   197\t\t\tcur.ands = append(cur.ands, cond)\r\n   198\t\t\ti = next\r\n   199\t\t}\r\n   200\t\tif len(cur.ands) > 0 || len(q.ors) == 0 {\r\n"]
[3567.809166, "o", "   201\t\t\tq.ors = append(q.ors, cur)\r\n   202\t\t}\r\n   203\t\tif len(q.ors) == 0 || len(q.ors[0].ands) == 0 {\r\n   204\t\t\treturn query{}, fmt.Errorf(\"empty query\")\r\n   205\t\t}\r\n   206\t\treturn q, nil\r\n   207\t}\r\n   208\t\r\n   209\tfunc parseCondition(tokens []string, i int) (condition, int, error) {\r\n   210\t\tif i+2 >= len(tokens) {"]
[3567.809225, "o", "\r\n   211\t\t\treturn condition{}, i, fmt.Errorf(\"invalid query syntax\")\r\n   212\t\t}\r\n   213\t\tfield := tokens[i]\r\n   214\t\top := tokens[i+1]\r\n   215\t\tvalueTok := tokens[i+2]\r\n   216\t\r\n   217\t\t"]
[3567.809283, "o", "validFields := map[string]bool{\"step\": true, \"epoch\": true, \"loss\": true, \"lr\": true, \"grad_norm\": true, \"acc\": true, \"event\": true, \"ts\": true}\r\n   218\t\tif !validFields[field] {\r\n   219\t\t\treturn condition{}, i, fmt.Errorf(\"unknown field: %s\", field)\r\n   220\t\t}\r\n"]
[3567.809342, "o", "   221\t\tvalidOps := map[string]bool{\">\": true, \"<\": true, \">=\": true, \"<=\": true, \"==\": true, \"!=\": true}\r\n   222\t\tif !validOps[op] {\r\n   223\t\t\treturn condition{}, i, fmt.Errorf(\"invalid operator: %s\", op)\r\n   224\t\t}\r\n   225\t\r\n   226\t\tc := condition{field: field, op: op, sval: valueTok}\r\n   227\t\tif field == \"event\" {\r\n   228\t\t\tif op != \"==\" && op != \"!=\" {\r\n   229\t\t\t\treturn condition{}, i, fmt.Errorf(\"type mismatch: event only supports == or !=\")\r\n   230\t\t\t}\r\n   231\t\t\tif !isQuotedString(valueTok) {\r\n"]
[3567.809401, "o", "   232\t\t\t\treturn condition{}, i, fmt.Errorf(\"type mismatch: event requires string value\")\r\n   233\t\t\t}\r\n   234\t\t\tc.sval = unquote(valueTok)\r\n   235\t\t\treturn c, i + 3, nil\r\n   236\t\t}\r\n   237\t\tif field == \"ts\" {\r\n   238\t\t\tif _, err := time.Parse(time.RFC3339, unquote(valueTok)); err != nil {\r\n"]
[3567.809475, "o", "   239\t\t\t\treturn condition{}, i, fmt.Errorf(\"invalid timestamp: %s\", valueTok)\r\n   240\t\t\t}\r\n   241\t\t\tc.sval = unquote(valueTok)\r\n   242\t\t\treturn c, i + 3, nil\r\n   243\t\t}\r\n   244\t\tnum, err := strconv.ParseFloat(valueTok, 64)\r\n   245\t\tif err != nil {\r\n   246\t\t\treturn condition{}, i, fmt.Errorf(\"type mismatch: %s requires numeric value\", field)\r\n   247\t\t}\r\n"]
[3567.809535, "o", "   248\t\tc.fval = num\r\n   249\t\tc.isNum = true\r\n   250\t\treturn c, i + 3, nil\r\n   251\t}\r\n   252\t\r\n   253\tfunc tokenizeQuery(s string) ([]string, error) {\r\n   254\t\tvar tokens []string\r\n   255\t\t"]
[3567.809591, "o", "i := 0\r\n   256\t\tfor i < len(s) {\r\n   257\t\t\tch := s[i]\r\n   258\t\t\tif ch == ' ' || ch == '\\t' || ch == '\\n' || ch == '\\r' {\r\n   259\t\t\t\ti++\r\n   260\t\t\t\tcontinue\r\n   261\t\t\t}\r\n"]
[3567.809649, "o", "   262\t\t\tif ch == '\"' {\r\n   263\t\t\t\tj := i + 1\r\n   264\t\t\t\tfor j < len(s) && s[j] != '\"' {\r\n   265\t\t\t\t\tj++\r\n   266\t\t\t\t}\r\n   267\t\t\t\tif j >= len(s) {\r\n   268\t\t\t\t\treturn nil, fmt.Errorf(\"unterminated string\")\r\n"]
[3567.809706, "o", "   269\t\t\t\t}\r\n   270\t\t\t\ttokens = append(tokens, s[i:j+1])\r\n   271\t\t\t\ti = j + 1\r\n   272\t\t\t\tcontinue\r\n   273\t\t\t}\r\n   274\t\t\tif strings.HasPrefix(s[i:], \">=\") || strings.HasPrefix(s[i:], \"<=\") || strings.HasPrefix(s[i:], \"==\") || strings.HasPrefix(s[i:], \"!=\") {\r\n   275\t\t\t\ttokens = append(tokens, s[i:i+2])\r\n   276\t\t\t\ti += 2\r\n   277\t\t\t\tcontinue\r\n"]
[3567.809772, "o", "   278\t\t\t}\r\n   279\t\t\tif ch == '>' || ch == '<' {\r\n   280\t\t\t\ttokens = append(tokens, string(ch))\r\n"]
