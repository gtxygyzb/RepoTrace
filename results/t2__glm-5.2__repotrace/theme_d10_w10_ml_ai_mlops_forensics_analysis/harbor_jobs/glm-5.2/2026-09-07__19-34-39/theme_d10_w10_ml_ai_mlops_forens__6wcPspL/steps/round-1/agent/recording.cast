[1224.487631, "o", "        ts = int(time.time())\r\n\u001b[?2004l\r"]
[1224.487703, "o", "\u001b[?2004h> "]
[1224.487775, "o", "    name = b'w'\r\n\u001b[?2004l\r"]
[1224.487848, "o", "\u001b[?2004h> "]
[1224.488024, "o", "    data = b'\\x00\\x00\\x80\\x3f'\r\n\u001b[?2004l\r"]
[1224.488099, "o", "\u001b[?2004h> "]
[1224.488353, "o", "    tensor_hash = hashlib.sha256(data).digest()\r\n\u001b[?2004l\r"]
[1224.488427, "o", "\u001b[?2004h> "]
[1224.48943, "o", "    tensor_block = struct.pack('<H', len(name)) + name + struct.pack('<B', 0) + struct.pack('<B', 1) + struct.pack('<I', 1) + struct.pack('<Q', len(data)) + data + tensor_hash\r\n\u001b[?2004l\r"]
[1224.489497, "o", "\u001b[?2004h> "]
[1224.489601, "o", "    git = b'0'*40\r\n\u001b[?2004l\r"]
[1224.489673, "o", "\u001b[?2004h> "]
[1224.489825, "o", "    config_hash = b'\\xcc'*32\r\n\u001b[?2004l\r"]
[1224.489898, "o", "\u001b[?2004h> "]
[1224.49005, "o", "    framework = b'PyTorch'\r\n\u001b[?2004l\r"]
[1224.490122, "o", "\u001b[?2004h> "]
[1224.490319, "o", "    framework_version = b'2.1.0'\r\n\u001b[?2004l\r"]
[1224.49039, "o", "\u001b[?2004h> "]
[1224.492306, "o", "    prov = git + dataset + config_hash + struct.pack('<q', ts) + struct.pack('<d', 1.0) + struct.pack('<H', len(framework)) + framework + struct.pack('<H', len(framework_version)) + framework_version + struct.pack('<I', 1) + struct.pack('<Q', 5000) + struct.pack('<d', 0.1) + struct.pack('<H', len(parent_hash)) + parent_hash.encode()\r\n\u001b[?2004l\r"]
[1224.492422, "o", "\u001b[?2004h> "]
[1224.492515, "o", "    metadata_offset = 0\r\n\u001b[?2004l\r"]
[1224.492591, "o", "\u001b[?2004h> "]
[1224.492842, "o", "    provenance_offset = 56 + len(tensor_block)\r\n\u001b[?2004l\r"]
[1224.492918, "o", "\u001b[?2004h> "]
[1224.493062, "o", "    signature_offset = 0\r\n\u001b[?2004l\r"]
[1224.493138, "o", "\u001b[?2004h> "]
[1224.493858, "o", "    header_no_checksum = struct.pack('<4sHHIIQQQq', b'MLCK', 1, 0, 1, 0, metadata_offset, provenance_offset, signature_offset, ts)\r\n\u001b[?2004l\r"]
[1224.493943, "o", "\u001b[?2004h> "]
[1224.494162, "o", "    checksum = fnv64a(header_no_checksum)\r\n\u001b[?2004l\r"]
[1224.494221, "o", "\u001b[?2004h"]
[1224.494275, "o", "> "]
[1224.494584, "o", "    header = header_no_checksum + struct.pack('<Q', checksum)\r\n\u001b[?2004l\r"]
[1224.494638, "o", "\u001b[?2004h> "]
[1224.494866, "o", "    raw = header + tensor_block + prov\r\n\u001b[?2004l\r"]
[1224.494921, "o", "\u001b[?2004h> "]
[1224.495118, "o", "    with open(path, 'wb') as f:\r\n\u001b[?2004l\r"]
[1224.495176, "o", "\u001b[?2004h> "]
[1224.495296, "o", "        f.write(raw)\r\n\u001b[?2004l\r"]
[1224.495365, "o", "\u001b[?2004h> "]
[1224.495596, "o", "    return hashlib.sha256(raw).hexdigest()\r\n\u001b[?2004l\r"]
