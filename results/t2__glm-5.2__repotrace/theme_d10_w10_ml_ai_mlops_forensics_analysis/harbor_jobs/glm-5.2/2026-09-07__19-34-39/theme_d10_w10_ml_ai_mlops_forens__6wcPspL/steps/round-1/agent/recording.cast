[4433.982965, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"strings\"\r\n"]
[4433.983071, "o", "     8\t\r\n     9\t\t\"mlforge/internal/forensics\"\r\n    10\t)\r\n    11\t\r\n    12\tfunc main() {\r\n    13\t\t// --- Parse flags ---------------------------------------------------\r\n    14\t\tformat := \"json\"\r\n    15\t\tverbose := false\r\n    16\t\tvar positional []string\r\n    17\t\r\n    18\t\tfor _, arg := range os.Args[1:] {\r\n    19\t\t\tswitch {\r\n    20\t\t\tcase arg == \"--verbose\":\r\n    21\t\t\t\tverbose = true\r\n"]
[4433.983173, "o", "    22\t\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n    23\t\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n    24\t\t\tcase arg == \"--format\":\r\n    25\t\t\t// handled below as two-token flag\r\n    26\t\t\tdefault:\r\n    27\t\t\t\tpositional = append(positional, arg)\r\n    28\t\t\t}\r\n    29\t\t}\r\n    30\t\r\n"]
[4433.983242, "o", "    31\t\t// Handle \"--format json\" (two separate tokens)\r\n    32\t\tfor i := 1; i < len(os.Args)-1; i++ {\r\n    33\t\t\tif os.Args[i] == \"--format\" {\r\n    34\t\t\t\tformat = os.Args[i+1]\r\n    35\t\t\t\t// Remove the value from positional args\r\n    36\t\t\t\tfiltered := positional[:0]\r\n    37\t\t\t\tfor _, p := range positional {\r\n    38\t\t\t\t\tif p != os.Args[i+1] {\r\n    39\t\t\t\t\t\tfiltered = append(filtered, p)\r\n    40\t\t\t\t\t}\r\n    41\t\t\t\t}\r\n    42\t\t\t\tpositional = filtered\r\n    43\t\t\t\tbreak\r\n"]
[4433.983312, "o", "    44\t\t\t}\r\n    45\t\t}\r\n    46\t\r\n    47\t\tif format != \"json\" && format != \"text\" {\r\n    48\t\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json or text\\n\", format)\r\n    49\t\t\tos.Exit(1)\r\n    50\t\t}\r\n    51\t\r\n    52\t\t_ = verbose // reserved for diagnostic output\r\n    53\t\r\n    54\t\t// --- Validate positional args --------------------------------------\r\n    55\t\tif len(positional) < 2 {\r\n    56\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n    57\t\t\tos.Exit(1)\r\n"]
[4433.983374, "o", "    58\t\t}\r\n    59\t\r\n    60\t\tcmd := positional[0]\r\n    61\t\tdir := positional[1]\r\n    62\t\r\n    63\t\t// --- Route to command handler --------------------------------------\r\n    64\t\tvar result interface{}\r\n    65\t\tvar err error\r\n"]
[4433.983435, "o", "    66\t\r\n    67\t\tswitch cmd {\r\n    68\t\tcase \"ingest\":\r\n    69\t\t\tresult, err = forensics.BuildIngest(dir)\r\n    70\t\tcase \"timeline\":\r\n    71\t\t\tresult, err = forensics.BuildTimeline(dir)\r\n    72\t\tcase \"verify\":\r\n"]
[4433.983544, "o", "    73\t\t\tresult, err = forensics.BuildVerify(dir)\r\n    74\t\tcase \"detect\":\r\n    75\t\t\tresult, err = forensics.BuildDetect(dir)\r\n    76\t\tcase \"lineage\":\r\n    77\t\t\tresult, err = forensics.BuildLineage(dir)\r\n    78\t\tcase \"query\":\r\n    79\t\t\tif len(positional) < 3 {\r\n    80\t\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n    81\t\t\t\tos.Exit(1)\r\n    82\t\t\t}\r\n    83\t\t\tresult, err = forensics.BuildQuery(dir, positional[2])\r\n    84\t\tcase \"diff\":\r\n    85\t\t\tif len(positional) < 4 {\r\n    86\t\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge diff <dir> <file1> <file2>\\n\")\r\n    87\t\t\t\tos.Exit(1)\r\n"]
[4433.983663, "o", "    88\t\t\t}\r\n    89\t\t\tresult, err = forensics.BuildDiff(dir, positional[2], positional[3])\r\n    90\t\tcase \"report\":\r\n    91\t\t\tresult, err = forensics.BuildReport(dir)\r\n    92\t\tdefault:\r\n    93\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n    94\t\t\tos.Exit(1)\r\n    95\t\t}\r\n    96\t\r\n    97\t\t// --- Output --------------------------------------------------------\r\n    98\t\tif err != nil {\r\n    99\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   100\t\t\tos.Exit(1)\r\n   101\t\t}\r\n   102\t\r\n   103\t\tif format == \"text\" {\r\n   104"]
[4433.983735, "o", "\t\t\tprintText(result)\r\n   105\t\t\treturn\r\n   106\t\t}\r\n   107\t\r\n   108\t\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n   109\t\tif marshalErr != nil {\r\n   110\t\t\tfmt.Fprintf(os.Stderr, \"error marshalling result: %v\\n\", marshalErr)\r\n   111\t\t\tos.Exit(1)\r\n   112\t\t}\r\n"]
[4433.983812, "o", "   113\t\tfmt.Println(string(out))\r\n   114\t}\r\n   115\t\r\n   116\tfunc printText(v interface{}) {\r\n   117\t\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n   118\t\tif err != nil {\r\n   119\t\t\tfmt.Fprintln(os.Stderr, \"error rendering text output\")\r\n   120\t\t\treturn\r\n   121\t\t}\r\n   122\t\tfmt.Println(string(b))\r\n   123\t}\r\n"]
[4433.984411, "o", "\u001b[?2004h"]
[4433.984474, "o", "root@n30009:/app# "]
[4434.279093, "i", "cat -n docs/output_schema.md\n"]
[4434.279355, "o", "cat -n docs/output_schema.md\r\n\u001b[?2004l\r"]
[4434.281701, "o", "     1\t# Output Schemas\r\n     2\t\r\n     3\tAll commands output JSON to stdout. This document defines the exact JSON structure for each command.\r\n     4\t\r\n     5\t---\r\n     6\t\r\n     7\t## 1. Ingest Output\r\n     8\t\r\n     9\t```json\r\n    10\t{\r\n    11\t  \"status\": \"ok\",\r\n    12\t  \"evidence_dir\": \"/path/to/evidence\",\r\n    13\t  \"artifacts\": {\r\n    14\t"]
[4434.281763, "o", "    \"checkpoints\": [\r\n    15\t      {\r\n    16\t        \"file\": \"model_epoch1.mlck\",\r\n    17\t        \"file_hash\": \"a1b2c3...\",\r\n    18\t        \"version\": 1,\r\n    19\t        \"num_tensors\": 12,\r\n    20\t        \"num_metadata\": 3,\r\n    21\t        \"signed\": false,\r\n    22\t        \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n    23\t        \"provenance\": {\r\n    24\t          \"epoch\": 1,\r\n    25\t          \"global_step\": 5000,\r\n    26\t          \"framework\": \"PyTorch\",\r\n    27\t          \"framework_version\": \"2.1.0\",\r\n    28\t          \"parent_hash\": \"\"\r\n    29\t        }\r\n    30\t      }\r\n    31\t    ],\r\n    32\t    \"log_shards\": [\r\n    33\t      {\r\n    34\t        \"file\": \"shard_001.jsonl\",\r\n    35\t"]
[4434.281824, "o", "        \"entries\": 500,\r\n    36\t        \"step_range\": [0, 5000],\r\n    37\t        \"epoch_range\": [0, 1],\r\n    38\t        \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-15T10:00:00Z\"]\r\n    39\t      }\r\n    40\t    ],\r\n    41\t    \"configs\": [\r\n    42\t      {\r\n    43\t        \"file\": \"config_train.json\",\r\n    44\t        \"model_name\": \"resnet50\",\r\n    45\t        \"dataset\": \"imagenet-1k\"\r\n    46\t      }\r\n    47\t    ]\r\n    48\t  },\r\n    49\t  \"totals\": {\r\n    50\t    \"checkpoints\": 3,\r\n    51\t    \"log_shards\": 4,\r\n    52\t    \"configs\": 1\r\n    53\t  }\r\n    54\t}\r\n    55\t```\r\n    56\t\r\n    57\t**Field rules:**\r\n    58\t- `file_hash`: SHA-256 hex of the entire `.mlck` file content.\r\n    59\t"]
[4434.281873, "o", "- `checkpoints` array: sorted by `creation_timestamp` ascending.\r\n    60\t- `log_shards` array: sorted by `file` name lexicographically.\r\n    61\t- `configs` array: sorted by `file` name lexicographically.\r\n    62\t- `step_range`: `[min_step, max_step]` across all entries in the shard.\r\n    63\t- `epoch_range`: `[min_epoch, max_epoch]` across all entries.\r\n    64\t- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.\r\n    65\t\r\n    66\t---\r\n    67\t\r\n    68\t## 2. Timeline Output\r\n    69\t\r\n    70\t```json\r\n    71\t{\r\n    72\t  \"status\": \"ok\",\r\n    73\t  \"total_entries\": 1200,\r\n    74\t  \"total_epochs\": 5,\r\n    75\t  \"step_range\": [0, 50000],\r\n    76\t  \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-17T14:00:00Z\"],\r\n    77\t  \"conflicts_resolved\": 3,\r\n    78\t  \"gaps\": [\r\n    79\t    {"]
[4434.281922, "o", "\r\n    80\t      \"after_step\": 5000,\r\n    81\t      \"before_step\": 5200,\r\n    82\t      \"epoch\": 1,\r\n    83\t      \"gap_steps\": 200,\r\n    84\t      \"after_ts\": \"2024-01-15T10:00:00Z\",\r\n    85\t      \"before_ts\": \"2024-01-15T13:00:00Z\"\r\n    86\t    }\r\n    87\t  ],\r\n    88\t  \"entries\": [\r\n    89\t    {\r\n    90\t      \"ts\": \"2024-01-15T08:00:00Z\",\r\n    91\t      \"epoch\": 0,\r\n    92\t      \"step\": 0,\r\n    93\t"]
[4434.281991, "o", "      \"loss\": 6.9078,\r\n    94\t      \"lr\": 0.001,\r\n    95\t      \"grad_norm\": 12.34,\r\n    96\t      \"acc\": 0.001,\r\n    97\t      \"event\": \"step\",\r\n    98\t      \"sources\": [\"shard_001.jsonl\"],\r\n    99\t      \"conflict\": false\r\n   100\t    }\r\n   101\t  ]\r\n   102\t}\r\n   103\t```\r\n   104\t\r\n   105\t**Field rules:**\r\n   106\t- `entries`: sorted by `(epoch ASC, step ASC)`.\r\n   107\t"]
[4434.282035, "o", "- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.\r\n   108\t- `conflict`: `true` if this entry was chosen by conflict resolution.\r\n   109\t- `gaps`: only gaps where `gap_steps > 100` within the same epoch.\r\n   110\t- Entries with missing optional fields omit them from the JSON (do not include null).\r\n   111\t\r\n   112\t---\r\n   113\t\r\n   114\t## 3. Verify Output\r\n   115\t\r\n   116\t```json\r\n   117\t{\r\n   118\t  \"status\": \"ok\",\r\n   119\t  \"checkpoints\": [\r\n   120\t    {\r\n   121"]
[4434.282078, "o", "\t      \"file\": \"model_epoch1.mlck\",\r\n   122\t      \"valid\": true,\r\n   123\t      \"header_checksum_valid\": true,\r\n   124\t      \"tensor_checksums_valid\": true,\r\n   125\t      \"signature_valid\": null,\r\n   126\t      \"provenance_valid\": true,\r\n   127\t      \"issues\": []\r\n   128\t    },\r\n   129\t    {\r\n   130\t      \"file\": \"model_epoch3.mlck\",\r\n   131\t      \"valid\": false,\r\n   132\t      \"header_checksum_valid\": true,\r\n   133\t      \"tensor_checksums_valid\": false,\r\n"]
[4434.282122, "o", "   134\t      \"signature_valid\": true,\r\n   135\t      \"provenance_valid\": true,\r\n   136\t      \"issues\": [\r\n   137\t        {\"type\": \"tensor_checksum_mismatch\", \"detail\": \"encoder.layer2.weight\"}\r\n   138\t      ]\r\n   139\t    }\r\n   140\t  ],\r\n   141\t  \"summary\": {\r\n   142\t    \"total\": 3,\r\n   143\t    \"valid\": 2,"]
[4434.282167, "o", "\r\n   144\t    \"invalid\": 1\r\n   145\t  }\r\n   146\t}\r\n   147\t```\r\n   148\t\r\n   149\t**Field rules:**\r\n   150\t- `checkpoints`: sorted by `file` name lexicographically.\r\n   151\t- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.\r\n   152\t- `issues`: list of issue objects with `type` (string) and `detail` (string). For example, a tensor checksum mismatch appears as `{\"type\": \"tensor_checksum_mismatch\", \"detail\": \"<tensor_name>\"}`.\r\n   153\t- `valid`: `true` only if all applicable checks pass.\r\n   154\t\r\n   155\t---\r\n   156"]
[4434.282218, "o", "\t\r\n   157\t## 4. Detect Output\r\n   158\t\r\n   159\t```json\r\n   160\t{\r\n   161\t  \"status\": \"ok\",\r\n   162\t  \"anomalies\": [\r\n   163\t    {\r\n   164\t      \"id\": \"ANOM-001\",\r\n   165\t      \"type\": \"gradient_spike\",\r\n   166\t      \"severity\": \"high\",\r\n   167\t      \"epoch\": 2,\r\n   168\t      \"step\": 3456,\r\n   169\t      \"details\": {"]
[4434.282263, "o", "\r\n   170\t        \"observed\": 15.3,\r\n   171\t        \"window_mean\": 1.2,\r\n   172\t        \"window_stddev\": 0.3,\r\n   173\t        \"z_score\": 47.0\r\n   174\t      },\r\n   175\t      \"source\": \"shard_002.jsonl\"\r\n   176\t    },\r\n   177\t    {\r\n   178\t      \"id\": \"ANOM-002\",\r\n   179\t      \"type\": \"tensor_checksum_mismatch\",\r\n   180\t      \"severity\": \"critical\",\r\n   181\t      \"details\": {\r\n   182\t        \"file\": \"model_epoch3.mlck\",\r\n   183\t        \"tensor_name\": \"encoder.layer2.weight\","]
[4434.282306, "o", "\r\n   184\t        \"expected_checksum\": \"abcd1234...\",\r\n   185\t        \"actual_checksum\": \"efgh5678...\"\r\n   186\t      },\r\n   187\t      \"source\": \"model_epoch3.mlck\",\r\n   188\t        \"checkpoint\": \"model_epoch3.mlck\"\r\n   189\t    }\r\n   190\t  ],\r\n   191\t  \"summary\": {\r\n   192\t    \"total\": 5,\r\n   193\t    \"by_severity\": {\r\n   194\t      \"critical\": 1,\r\n"]
[4434.28235, "o", "   195\t      \"high\": 2,\r\n   196\t      \"medium\": 1,\r\n   197\t      \"low\": 1\r\n   198\t    },\r\n   199\t    \"by_type\": {\r\n   200\t      \"gradient_spike\": 1,\r\n   201\t      \"loss_divergence\": 1,\r\n   202\t      \"tensor_checksum_mismatch\": 1,\r\n   203\t      \"training_gap\": 1,\r\n   204\t      \"lr_anomaly\": 1\r\n   205\t    }\r\n   206\t  }\r\n   207\t}\r\n   208\t```\r\n   209\t\r\n   210\t"]
[4434.282393, "o", "**Field rules:**\r\n   211\t- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.\r\n   212\t- `anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.\r\n   213\t- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.\r\n   214\t- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.\r\n   215\t- `source`: the artifact file where the anomaly was detected.\r\n   216\t- `epoch` and `step`: present only for timeline-based anomalies.\r\n   217\t- `checkpoint`: present when the anomaly is related to a specific checkpoint file; omitted for timeline-based anomalies that are not checkpoint-specific.\r\n   218\t- If no anomalies are detected, `anomalies` is an empty array.\r\n   219\t\r\n   220\t"]
[4434.282438, "o", "---\r\n   221\t\r\n   222\t## 5. Lineage Output\r\n   223\t\r\n   224\t```json\r\n   225\t{\r\n   226\t  \"status\": \"ok\",\r\n   227\t  \"nodes\": [\r\n   228\t    {\r\n   229\t      \"file\": \"model_epoch1.mlck\",\r\n   230\t      \"file_hash\": \"a1b2c3...\",\r\n   231\t"]
[4434.282477, "o", "      \"epoch\": 1,\r\n   232\t      \"global_step\": 5000,\r\n   233\t      \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n   234\t      \"parent_hash\": \"\",\r\n   235\t      \"is_root\": true,\r\n   236\t      \"is_leaf\": false,\r\n   237\t      \"is_orphan\": false\r\n   238\t    }\r\n   239\t  ],"]
[4434.282519, "o", "\r\n   240\t  \"edges\": [\r\n   241\t    {\r\n   242\t      \"from\": \"a1b2c3...\",\r\n   243\t      \"to\": \"d4e5f6...\",\r\n   244\t      \"from_file\": \"model_epoch1.mlck\",\r\n   245\t      \"to_file\": \"model_epoch2.mlck\"\r\n   246\t    }\r\n   247\t  ],\r\n   248\t  \"roots\": [\"a1b2c3...\"],\r\n   249\t  \"leaves\": [\"g7h8i9...\"],\r\n   250\t  \"orphans\": [],\r\n   251\t"]
[4434.28256, "o", "  \"topological_order\": [\"a1b2c3...\", \"d4e5f6...\", \"g7h8i9...\"],\r\n   252\t  \"cycles\": []\r\n   253\t}\r\n   254\t```\r\n   255\t\r\n   256\t**Field rules:**\r\n   257\t- `nodes`: sorted by `creation_timestamp` ascending.\r\n   258\t- `edges`: sorted by `from` hash then `to` hash lexicographically.\r\n   259\t- `roots`: file hashes of root nodes (no parent), sorted.\r\n   260\t- `leaves`: file hashes of leaf nodes (no children), sorted.\r\n   261\t- `orphans`: file hashes of orphan nodes (parent not found), sorted.\r\n   262\t"]
[4434.282603, "o", "- `topological_order`: valid topological sort of non-orphan nodes, ties broken by `creation_timestamp`.\r\n   263\t- `cycles`: if cycles exist, each cycle is a list of file hashes. Empty if DAG is valid.\r\n   264\t\r\n   265\t---\r\n   266\t\r\n   267\t## 6. Report Output\r\n   268\t\r\n   269\t```json\r\n   270\t{\r\n   271\t  \"version\": \"1.0\",\r\n   272\t  \"generated_at\": \"2024-01-18T12:00:00Z\",\r\n   273\t  \"evidence_dir\": \"/path/to/evidence\",\r\n   274\t  \"ingest\": { ... },\r\n   275\t  \"timeline\": { ... },\r\n   276"]
[4434.282643, "o", "\t  \"verify\": { ... },\r\n   277\t  \"detect\": { ... },\r\n   278\t  \"lineage\": { ... }\r\n   279\t}\r\n   280\t```\r\n   281\t\r\n   282\t**Field rules:**\r\n   283\t- `version`: always `\"1.0\"`.\r\n   284\t- `generated_at`: ISO 8601 UTC timestamp of report generation.\r\n   285\t"]
[4434.282686, "o", "- Each section (`ingest`, `timeline`, `verify`, `detect`, `lineage`) contains the exact same JSON structure as the corresponding standalone command output.\r\n   286\t- The report runs all analyses; if any individual analysis encounters an error, that section contains `{\"status\": \"error\", \"message\": \"...\"}` and the report still completes.\r\n   287\t\r\n   288\t---\r\n   289\t\r\n   290\t## 7. Query Output\r\n   291\t\r\n   292\t```json\r\n   293\t{\r\n   294\t  \"status\": \"ok\",\r\n   295\t  \"query\": \"loss > 1.0 AND epoch == 3\",\r\n   296\t  \"matches\": 42,\r\n   297\t  \"entries\": [\r\n   298\t    {\r\n"]
[4434.282725, "o", "   299\t      \"ts\": \"2024-01-16T08:00:00Z\",\r\n   300\t      \"epoch\": 3,\r\n   301\t      \"step\": 15000,\r\n   302\t      \"loss\": 1.234,\r\n   303\t      \"lr\": 0.0001,\r\n   304\t      \"grad_norm\": 2.1,\r\n   305\t      \"acc\": 0.75,\r\n   306\t      \"event\": \"step\",\r\n   307\t      \"sources\": [\"shard_003.jsonl\"],\r\n   308\t      \"conflict\": false\r\n   309\t    }\r\n   310\t  ]\r\n   311\t"]
[4434.282767, "o", "}\r\n   312\t```\r\n   313\t\r\n   314\t**Field rules:**\r\n   315\t- `entries`: matching timeline entries sorted by `(epoch ASC, step ASC)`.\r\n   316\t- `matches`: count of matching entries.\r\n   317\t- `query`: the original query string echoed back.\r\n   318\t\r\n   319\t\r\n   320\t## 8. Diff Output\r\n   321\t\r\n   322\t```json\r\n   323\t{\r\n   324\t"]
[4434.282809, "o", "  \"status\": \"ok\",\r\n   325\t  \"file_a\": \"model_epoch1.mlck\",\r\n   326\t  \"file_b\": \"model_epoch2.mlck\",\r\n   327\t  \"tensor_diffs\": [\r\n   328\t    {\r\n   329\t      \"name\": \"layer1.weight\",\r\n   330\t      \"shape_match\": true,\r\n   331\t      \"shape_a\": [4, 3],\r\n   332\t      \"shape_b\": [4, 3],\r\n   333\t      \"max_abs_diff\": 1.234,\r\n   334\t      \"mean_abs_diff\": 0.567\r\n   335\t    },\r\n   336\t    {\r\n   337\t      \"name\": \"layer2.bias\","]
[4434.282862, "o", "\r\n   338\t      \"shape_match\": false,\r\n   339\t      \"shape_a\": [3],\r\n   340\t      \"shape_b\": [6]\r\n   341\t    },\r\n   342\t    {\r\n   343\t      \"name\": \"layer3.weight\",\r\n   344\t      \"shape_match\": false,\r\n   345\t      \"shape_a\": null,\r\n   346\t      \"shape_b\": [2, 2]\r\n   347\t    }\r\n   348\t  ],\r\n   349\t  \"summary\": {\r\n   350\t    \"total_tensors_a\": 2,\r\n   351\t    \"total_tensors_b\": 3,\r\n   352\t    \"common_tensors\": 2,\r\n   353\t    \"shape_mismatches\": 1,\r\n   354\t    \"only_in_a\": [],"]
[4434.282919, "o", "\r\n   355\t    \"only_in_b\": [\"layer3.weight\"]\r\n   356\t  }\r\n   357\t}\r\n   358\t```\r\n   359\t\r\n   360\t**Field rules:**\r\n   361\t- `file_a` and `file_b` are the basenames of `file1` and `file2`.\r\n   362\t- `tensor_diffs`: sorted by tensor name lexicographically.\r\n   363\t- `shape_a` and `shape_b`: tensor shapes from each file, or `null` if absent from that file.\r\n   364\t- `shape_match`: `true` only when the tensor exists in both files and the shapes are identical.\r\n   365\t- `max_abs_diff` and `mean_abs_diff`: present only for tensors with `shape_match: true`, computed over float32 element-wise absolute differences.\r\n   366\t- `summary.total_tensors_a` and `summary.total_tensors_b`: tensor counts in each file.\r\n   367\t- `summary.common_tensors`: number of tensor names present in both files.\r\n   368\t- `summary.shape_mismatches`: number of common tensors with different shapes.\r\n   369\t- `summary.only_in_a` and `summary.only_in_b`: tensor names present in only one file, sorted lexicographically.\r\n"]
