[7944.759202, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('docs/output_schema.md')\ns = p.read_text()\nneedle = 'Generate a comprehensive forensic report by running all analyses (ingest, timeline, verify, detect, lineage) and combining results.'\nif needle in s and 'Nested report sections do not include their own `metadata` objects.' not in s:\n    s = s.replace(needle, needle + ' The report output includes top-level `metadata` with `command: \\\"report\\\"`. Nested report sections (`ingest`, `timeline`, `verify`, `detect`, `lineage`) do not include their own `metadata` objects.', 1)\np.write_text(s)\n\np = Path('docs/spec.md')\ns = p.read_text()\nneedle = 'Generate a comprehensive forensic report by running all analyses (ingest, timeline, verify, detect, lineage) and combining results.'\nif needle in s and 'Nested report sections do not include their own metadata objects.' not in s:\n    s = s.replace(needle, needle + ' The report output includes top-level metadata with `command: \\\"report\\\"`; nested report sections do not include"]
[7944.759303, "i", " their own metadata objects.', 1)\np.write_text(s)\nPY\n"]
