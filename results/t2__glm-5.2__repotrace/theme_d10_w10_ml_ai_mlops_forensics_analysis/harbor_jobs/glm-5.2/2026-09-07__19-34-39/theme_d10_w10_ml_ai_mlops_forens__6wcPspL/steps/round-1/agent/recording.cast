[627.638358, "i", "\",\n\t\t\t\tEpoch:    &ep,\n\t\t\t\tStep:     &st,\n\t\t\t\tDetails: map[string]interface{}{\n\t\t\t\t\t\"prev_lr\": *prev.Lr,\n\t\t\t\t\t\"curr_lr\": *cur.Lr,\n\t\t\t\t\t\"step\":    cur.Step,\n\t\t\t\t},\n\t\t\t\tSource: firstSource(cur),\n\t\t\t})\n\t\t}\n\t}\n\treturn anomalies\n}\n\nfunc detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\n\tvar anomalies []types.Anomaly\n\tfor i := 1; i < len(entries); i++ {\n\t\tprev := entries[i-1]\n\t\tcur := entries[i]\n\t\tif prev.Epoch != cur.Epoch {\n\t\t\tcontinue\n\t\t}\n\t\tprevT, err1 := time.Parse(time.RFC3339, prev.Ts)\n\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\n\t\tif err1 != nil || err2 != nil {\n\t\t\tcontinue\n\t\t}\n\t\tdiff := curT.Sub(prevT).Seconds()\n\t\tif diff > 7200 {\n\t\t\tep := cur.Epoch\n\t\t\tst := cur.Step\n\t\t\tanomalies = append(anomalies, types.Anomaly{\n\t\t\t\tType:     \"training_gap\",\n\t\t\t\tSeverity: \"low\",\n\t\t\t\tEpoch:    &ep,\n\t\t\t\tStep:     &st,\n\t\t\t\tDetails: map[string]interface{}{\n\t\t\t\t\t\"after_step\":  prev.Step,\n\t\t\t\t\t\"before_step\": cur.Step,\n\t\t\t\t\t\"after_ts\":    prev.Ts,\n\t\t\t\t\t\"before_ts\":   cur.Ts,\n\t\t\t\t\t\"gap_seconds\": diff,\n\t\t\t\t},\n"]
