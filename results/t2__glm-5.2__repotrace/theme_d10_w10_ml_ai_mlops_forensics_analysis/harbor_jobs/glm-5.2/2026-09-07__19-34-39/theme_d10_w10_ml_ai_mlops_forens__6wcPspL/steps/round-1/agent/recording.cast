[5587.397969, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/forensics/detect.go')\ns = p.read_text()\n\n# Patch exact anomaly severity assignments.\ns = s.replace('Type:     \"lr_anomaly\",\\n\\t\\t\\t\\t\\tSeverity: \"medium\",',\n              'Type:     \"lr_anomaly\",\\n\\t\\t\\t\\t\\tSeverity: \"info\",')\ns = s.replace('Type:     \"training_gap\",\\n\\t\\t\\t\\t\\tSeverity: \"low\",',\n              'Type:     \"training_gap\",\\n\\t\\t\\t\\t\\tSeverity: \"info\",')\ns = s.replace('Type:     \"provenance_chain_break\",\\n\\t\\t\\t\\t\\t\\tSeverity: \"high\",',\n              'Type:     \"provenance_chain_break\",\\n\\t\\t\\t\\t\\t\\tSeverity: \"medium\",')\n\n# Replace severityRank function.\nold = '''func severityRank(s string) int {\n\\tswitch s {\n\\tcase \"critical\":\n\\t\\treturn 0\n\\tcase \"high\":\n\\t\\treturn 1\n\\tcase \"medium\":\n\\t\\treturn 2\n\\tdefault:\n\\t\\treturn 3\n\\t}\n}'''\nnew = '''func severityRank(s string) int {\n\\tswitch s {\n\\tcase \"critical\":\n\\t\\treturn 0\n\\tcase \"high\":\n\\t\\treturn 1\n\\tcase \"medium\":\n\\t\\treturn 2\n\\tcase \"low\":\n\\t\\treturn 3\n\\tcase \"info\":\n\\t\\treturn 4\n\\t}\n\\tret"]
[5587.398272, "i", "urn 4\n}'''\ns = s.replace(old, new)\n\n# Replace severityRankValue function.\nold = '''func severityRankValue(s string) (int, bool) {\n\\tswitch s {\n\\tcase \"critical\":\n\\t\\treturn 0, true\n\\tcase \"high\":\n\\t\\treturn 1, true\n\\tcase \"medium\":\n\\t\\treturn 2, true\n\\tcase \"low\":\n\\t\\treturn 3, true\n\\tdefault:\n\\t\\treturn 4, false\n\\t}\n}'''\nnew = '''func severityRankValue(s string) (int, bool) {\n\\tswitch s {\n\\tcase \"critical\":\n\\t\\treturn 0, true\n\\tcase \"high\":\n\\t\\treturn 1, true\n\\tcase \"medium\":\n\\t\\treturn 2, true\n\\tcase \"low\":\n\\t\\treturn 3, true\n\\tcase \"info\":\n\\t\\treturn 4, true\n\\t}\n\\treturn 0, false\n}'''\ns = s.replace(old, new)\n\np.write_text(s)\nPY\n"]
