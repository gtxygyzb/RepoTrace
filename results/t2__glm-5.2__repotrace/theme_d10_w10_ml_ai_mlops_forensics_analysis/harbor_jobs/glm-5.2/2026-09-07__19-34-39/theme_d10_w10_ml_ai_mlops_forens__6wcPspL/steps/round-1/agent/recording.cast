[2951.93768, "o", "\u001b[35m\u001b[Kinternal/types/types.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KDtype\u001b[m\u001b[K byte     `json:\"\u001b[01;31m\u001b[Kdtype\u001b[m\u001b[K\"`\r\n"]
