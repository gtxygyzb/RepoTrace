[2810.659288, "o", "   180\t\tAfterTs    string `json:\"after_ts\"`\r\n   181\t\tBeforeTs   string `json:\"before_ts\"`\r\n   182\t}\r\n   183\t\r\n   184\ttype TimelineOutput struct {\r\n   185\t\tStatus            string                `json:\"status\"`\r\n"]
[2810.659387, "o", "   186\t\tTotalEntries      int                   `json:\"total_entries\"`\r\n   187\t\tTotalEpochs       int                   `json:\"total_epochs\"`\r\n   188\t\tStepRange         []int                 `json:\"step_range\"`\r\n   189\t\tTimeRange         []string              `json:\"time_range\"`\r\n   190\t\tConflictsResolved int                   `json:\"conflicts_resolved\"`\r\n   191\t\tGaps              []TimelineGap         `json:\"gaps\"`\r\n   192\t\tEntries           []types.TimelineEntry `json:\"entries\"`\r\n   193\t}\r\n   194\t\r\n   195\tfunc BuildTimeline(dir string) (interface{}, error) {\r\n   196\t\tentries, shards, err := loadTimelineEntries(dir)\r\n   197\t\tif err != nil {\r\n"]
[2810.659475, "o", "   198\t\t\treturn nil, err\r\n   199\t\t}\r\n   200\t\treturn buildTimelineFromEntries(entries, shards), nil\r\n   201\t}\r\n   202\t\r\n   203\tfunc buildTimelineFromEntries(entries []types.TimelineEntry, shards []logparser.ShardInfo) TimelineOutput {\r\n   204\t\tmerged, conflicts := mergeTimeline(entries)\r\n   205\t\tsortTimeline(merged)\r\n   206\t\tgaps := detectGaps(merged)\r\n   207\t\r\n   208\t\tout := TimelineOutput{\r\n   209\t\t\tStatus:            \"ok\",\r\n   210\t\t\tTotalEntries:      len(merged),\r\n"]
[2810.659561, "o", "   211\t\t\tConflictsResolved: conflicts,\r\n   212\t\t\tGaps:              gaps,\r\n   213\t\t\tEntries:           merged,\r\n   214\t\t}\r\n   215\t\tif len(merged) > 0 {\r\n   216\t\t\tminStep, maxStep := merged[0].Step, merged[0].Step\r\n   217\t\t\tminTs, maxTs := merged[0].Ts, merged[0].Ts\r\n   218\t\t\tepochSet := map[int]struct{}{}\r\n   219\t\t\tfor _, e := range merged {\r\n   220\t\t\t\tepochSet[e.Epoch] = struct{}{}\r\n   221\t\t\t\tif e.Step < minStep {\r\n   222\t\t\t\t\tminStep = e.Step\r\n"]
[2810.659637, "o", "   223\t\t\t\t}\r\n   224\t\t\t\tif e.Step > maxStep {\r\n   225\t\t\t\t\tmaxStep = e.Step\r\n   226\t\t\t\t}\r\n   227\t\t\t\tif e.Ts < minTs {\r\n   228\t\t\t\t\tminTs = e.Ts\r\n   229\t\t\t\t}\r\n   230\t\t\t\tif e.Ts > maxTs {\r\n"]
