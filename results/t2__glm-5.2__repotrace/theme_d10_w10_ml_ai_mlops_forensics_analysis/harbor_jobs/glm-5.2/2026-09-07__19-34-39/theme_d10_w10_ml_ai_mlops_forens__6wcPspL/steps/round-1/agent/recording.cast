[2887.4174, "o", "\t}\r\n\treturn allEntries, shards, nil\r\n}\r\n\r\nfunc mergeTimeline(entries []types.TimelineEntry) ([]types.TimelineEntry, int) {\r\n\ttype agg struct {\r\n"]
[2887.41753, "o", "\t\tentry    types.TimelineEntry\r\n\t\tsources  map[string]struct{}\r\n\t\tconflict bool\r\n\t}\r\n\tm := map[string]*agg{}\r\n\tfor _, e := range entries {\r\n\t\tkey := fmt.Sprintf(\"%d:%d\", e.Epoch, e.Step)\r\n\t\ta, ok := m[key]\r\n\t\tif !ok {\r\n\t\t\tsrc := map[string]struct{}{}\r\n\t\t\tfor _, s := range e.Sources {\r\n"]
[2887.417615, "o", "\t\t\t\tsrc[s] = struct{}{}\r\n\t\t\t}\r\n\t\t\tm[key] = &agg{entry: e, sources: src}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfor _, s := range e.Sources {\r\n\t\t\ta.sources[s] = struct{}{}\r\n\t\t}\r\n\t\tif metricsEqual(a.entry, e) {\r\n\t\t\tif e.Ts > a.entry.Ts {\r\n\t\t\t\ta.entry = e\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\ta.conflict = true\r\n\t\tif e.Ts > a.entry.Ts {\r\n\t\t\ta.entry = e\r\n\t\t}\r\n\t}\r\n\tresult := make([]types.TimelineEntry, 0, len(m))\r\n\tconflicts := 0\r\n\tfor _, a := range m {\r\n\t\te := a.entry\r\n\t\t"]
[2887.417693, "o", "srcs := make([]string, 0, len(a.sources))\r\n\t\tfor s := range a.sources {\r\n\t\t\tsrcs = append(srcs, s)\r\n\t\t}\r\n\t\tsort.Strings(srcs)\r\n\t\te.Sources = srcs\r\n\t\te.Conflict = a.conflict\r\n\t\tif a.conflict {\r\n\t\t\tconflicts++\r\n\t\t}\r\n\t\tresult = append(result, e)\r\n\t}\r\n\treturn result, conflicts\r\n"]
[2887.417778, "o", "}\r\n\r\nfunc metricsEqual(a, b types.TimelineEntry) bool {\r\n\treturn floatPtrEqual(a.Loss, b.Loss) &&\r\n\t\tfloatPtrEqual(a.Lr, b.Lr) &&\r\n\t\tfloatPtrEqual(a.GradNorm, b.GradNorm) &&\r\n\t\tfloatPtrEqual(a.Acc, b.Acc)\r\n}\r\n\r\nfunc floatPtrEqual(a, b *float64) bool {\r\n\tif a == nil || b == nil {\r\n\t\treturn a == b\r\n\t}\r\n\treturn math.Abs(*a-*b) <= 1e-9\r\n}\r\n\r\nfunc sortTimeline(entries []types.TimelineEntry) {\r\n"]
[2887.417866, "o", "\tsort.Slice(entries, func(i, j int) bool {\r\n"]
[2887.418313, "o", "\u001b[?2004h"]
[2887.418384, "o", "root@n30009:/app# "]
[2887.70886, "i", "sed -n '1,70p' internal/types/types.go\n"]
[2887.709234, "o", "sed -n '1,70p' internal/types/types.go\r\n\u001b[?2004l\r"]
[2887.712309, "o", "package types\r\n\r\n// TimelineEntry represents one log entry from a JSONL shard.\r\ntype TimelineEntry struct {\r\n\tTs       string   `json:\"ts\"`\r\n\tEpoch    int      `json:\"epoch\"`\r\n\tStep     int      `json:\"step\"`\r\n\tLoss     *float64 `json:\"loss,omitempty\"`\r\n\tLr       *float64 `json:\"lr,omitempty\"`\r\n"]
[2887.712459, "o", "\tGradNorm *float64 `json:\"grad_norm,omitempty\"`\r\n\tAcc      *float64 `json:\"acc,omitempty\"`\r\n\tEvent    string   `json:\"event,omitempty\"`\r\n\tSources  []string `json:\"sources,omitempty\"`\r\n\tConflict bool     `json:\"conflict\"`\r\n}\r\n\r\n// Anomaly represents one detected anomaly in the detect command.\r\ntype Anomaly struct {\r\n\tID         string                 `json:\"id\"`\r\n\tType       string                 `json:\"type\"`\r\n\tSeverity   string                 `json:\"severity\"`\r\n\tEpoch      *int                   `json:\"epoch,omitempty\"`\r\n\tStep       *int                   `json:\"step,omitempty\"`\r\n\tDetails    map[string]interface{} `json:\"details,omitempty\"`\r\n\tSource     string                 `json:\"source,omitempty\"`\r\n\tCheckpoint string                 `json:\"checkpoint,omitempty\"`\r\n}\r\n\r\n// TensorInfo holds metadata for one tensor in a checkpoint.\r\ntype TensorInfo struct {\r\n"]
[2887.712539, "o", "\tName  string   `json:\"name\"`\r\n\tDtype byte     `json:\"dtype\"`\r\n\tShape []uint32 `json:\"shape\"`\r\n\tData  []byte   `json:\"-\"`\r\n\tHash  [32]byte `json:\"-\"` // Stored SHA-256\r\n\tValid bool     `json:\"valid\"`\r\n}\r\n\r\n// Provenance holds the provenance section data from an MLCK checkpoint.\r\ntype Provenance struct {\r\n\tGitCommit         string  `json:\"git_commit\"`\r\n\tDatasetHash       string  `json:\"dataset_hash\"` // hex-encoded raw bytes\r\n\tConfigHash        string  `json:\"config_hash\"`  // hex-encoded raw bytes\r\n\tTrainingTimestamp int64   `json:\"training_timestamp\"`\r\n\tTrainingDuration  float64 `json:\"training_duration\"`\r\n"]
[2887.712619, "o", "\tFramework         string  `json:\"framework\"`\r\n\tFrameworkVersion  string  `json:\"framework_version\"`\r\n\tEpoch             uint32  `json:\"epoch\"`\r\n\tGlobalStep        uint64  `json:\"global_step\"`\r\n\tLearningRate      float64 `json:\"learning_rate\"`\r\n\tParentHash        string  `json:\"parent_hash\"` // hex SHA-256 of parent file, empty if root\r\n}\r\n\r\n// CheckpointFile represents a parsed .mlck checkpoint.\r\ntype CheckpointFile struct {\r\n\tPath              string            `json:\"-\"`\r\n\tFilename          string            `json:\"-\"` // base filename\r\n"]
[2887.712703, "o", "\tVersion           uint32            `json:\"version\"`\r\n\tFlags             uint16            `json:\"-\"`\r\n\tNumTensors        uint32            `json:\"-\"`\r\n\tNumMetadataKeys   uint32            `json:\"-\"`\r\n\tCreationTimestamp int64             `json:\"-\"`         // unix seconds\r\n\tHeaderValid       bool              `json:\"-\"`         // header checksum valid?\r\n\tFileHash          string            `json:\"file_hash\"` // SHA-256 hex of entire file\r\n\tSigned            bool              `json:\"-\"`\r\n\tTensors           []TensorInfo      `json:\"tensors\"`\r\n\tMetadataMap       map[string]string `json:\"-\"` // key-value pairs from metadata section\r\n\tProvenance        *Provenance       `json:\"-\"`\r\n"]
[2887.712774, "o", "\tHasParent         bool              `json:\"has_parent\"`\r\n\tParentHex         string            `json:\"parent_hash\"` // same as Provenance.ParentHash\r\n"]
[2887.713253, "o", "\u001b[?2004h"]
[2887.713325, "o", "root@n30009:/app# "]
[2887.99947, "i", "sed -n '1,190p' internal/checkpoint/parser.go\n"]
[2887.999924, "o", "sed -n '1,190p' internal/checkpoint/parser.go\r\n\u001b[?2004l\r"]
[2888.003044, "o", "package checkpoint\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n\t"]
[2888.003172, "o", "\"encoding/hex\"\r\n\t\"fmt\"\r\n\t\"hash/fnv\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\r\n\t\"mlforge/internal/types\"\r\n)\r\n\r\nconst (\r\n\tmagicMLCK  = \"MLCK\"\r\n\theaderSize = 56\r\n)\r\n\r\n// Parse reads and validates a single .mlck checkpoint file according to the\r\n// MLCK binary format specification (see /app/docs/formats.md).\r\nfunc Parse(path string) (*types.CheckpointFile, error) {\r\n\traw, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: read %s: %w\", path, err)\r\n"]
[2888.003254, "o", "\t}\r\n\tif len(raw) < headerSize {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: file too small (%d bytes)\", len(raw))\r\n\t}\r\n\r\n\t// --- magic (offset 0, 4 bytes) ---\r\n\tif string(raw[0:4]) != magicMLCK {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: bad magic %q\", raw[0:4])\r\n\t}\r\n\r\n\t// --- header fields ---\r\n\tversion := binary.LittleEndian.Uint16(raw[4:6])\r\n\tflags := binary.LittleEndian.Uint16(raw[6:8])\r\n\t"]
[2888.003328, "o", "numTensors := binary.LittleEndian.Uint32(raw[8:12])\r\n\tnumMetadata := binary.LittleEndian.Uint32(raw[12:16])\r\n\tmetadataOffset := binary.LittleEndian.Uint64(raw[16:24])\r\n\tprovenanceOffset := binary.LittleEndian.Uint64(raw[24:32])\r\n\t_ = binary.LittleEndian.Uint64(raw[32:40]) // signatureOffset (unused for now)\r\n\tcreationTimestamp := int64(binary.LittleEndian.Uint64(raw[40:48]))\r\n\tstoredChecksum := binary.LittleEndian.Uint64(raw[48:56])\r\n\r\n\t// --- verify header checksum: FNV-1a of bytes [0..48) ---\r\n\th := fnv.New64a()\r\n\th.Write(raw[:48])\r\n\tcomputedChecksum := h.Sum64()\r\n"]
[2888.003402, "o", "\theaderValid := computedChecksum == storedChecksum\r\n\r\n\t// --- SHA-256 file hash ---\r\n\tfileHashBytes := sha256.Sum256(raw)\r\n\tfileHash := hex.EncodeToString(fileHashBytes[:])\r\n\r\n\tsigned := flags&1 != 0\r\n\r\n\tcf := &types.CheckpointFile{\r\n\t\tPath:              path,\r\n\t\tFilename:          filepath.Base(path),\r\n\t\tVersion:           uint32(version),\r\n\t"]
[2888.003472, "o", "\tFlags:             flags,\r\n\t\tNumTensors:        numTensors,\r\n\t\tNumMetadataKeys:   numMetadata,\r\n\t\tCreationTimestamp:  creationTimestamp,\r\n\t\tHeaderValid:       headerValid,\r\n\t\tFileHash:          fileHash,\r\n\t\tSigned:            signed,\r\n\t}\r\n\r\n\t// --- parse tensor blocks (start at offset 56) ---\r\n\toff := headerSize\r\n"]
[2888.003541, "o", "\ttensors := make([]types.TensorInfo, 0, numTensors)\r\n\tfor i := uint32(0); i < numTensors; i++ {\r\n\t\tti, newOff, err := parseTensor(raw, off, i)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\ttensors = append(tensors, ti)\r\n\t\toff = newOff\r\n\t}\r\n\tcf.Tensors = tensors\r\n\r\n"]
[2888.003613, "o", "\t// --- parse metadata section ---\r\n\tif numMetadata > 0 && metadataOffset > 0 && int(metadataOffset) < len(raw) {\r\n\t\tmd, err := parseMetadata(raw, int(metadataOffset), numMetadata)\r\n\t\tif err == nil {\r\n\t\t\tcf.MetadataMap = md\r\n\t\t}\r\n\t}\r\n\r\n\t// --- parse provenance section ---\r\n\tif provenanceOffset > 0 && int(provenanceOffset) < len(raw) {\r\n\t\tprov, err := parseProvenance(raw, int(provenanceOffset))\r\n\t\tif err == nil {\r\n"]
[2888.00369, "o", "\t\t\tcf.Provenance = prov\r\n\t\t\tcf.HasParent = prov.ParentHash != \"\"\r\n\t\t\tcf.ParentHex = prov.ParentHash\r\n\t\t}\r\n\t}\r\n\r\n\treturn cf, nil\r\n}\r\n\r\n// parseTensor parses one tensor block starting at off and returns the\r\n// TensorInfo plus the new offset after the block.\r\nfunc parseTensor(raw []byte, off int, idx uint32) (types.TensorInfo, int, error) {\r\n\tfail := func(msg string) (types.TensorInfo, int, error) {\r\n\t\treturn types.TensorInfo{}, 0, fmt.Errorf(\"checkpoint: tensor %d: %s\", idx, msg)\r\n"]
[2888.003759, "o", "\t}\r\n\r\n\t// name_len (uint16 LE)\r\n\tif off+2 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading name_len\")\r\n\t}\r\n\tnameLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n\r\n\t// name\r\n\tif off+nameLen > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading name\")\r\n\t}\r\n\tname := string(raw[off : off+nameLen])"]
[2888.003828, "o", "\r\n\toff += nameLen\r\n\r\n\t// dtype (1 byte)\r\n\tif off+1 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading dtype\")\r\n\t}\r\n\tdtype := raw[off]\r\n\toff++\r\n\r\n\t// num_dims (1 byte)\r\n\tif off+1 > len(raw) {\r\n"]
[2888.003899, "o", "\t\treturn fail(\"unexpected EOF reading num_dims\")\r\n\t}\r\n\tnumDims := int(raw[off])\r\n\toff++\r\n\r\n\t// shape (num_dims * uint32 LE)\r\n\tshapeBytes := numDims * 4\r\n\tif off+shapeBytes > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading shape\")\r\n\t}\r\n\tshape := make([]uint32, numDims)\r\n\tfor d := 0; d < numDims; d++ {\r\n\t\tshape[d] = binary.LittleEndian.Uint32(raw[off : off+4])\r\n\t\toff += 4\r\n"]
[2888.003991, "o", "\t}\r\n\r\n\t// data_size (uint64 LE)\r\n\tif off+8 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading data_size\")\r\n\t}\r\n\tdataSize := binary.LittleEndian.Uint64(raw[off : off+8])\r\n\toff += 8\r\n\r\n\t// data\r\n\tif off+int(dataSize) > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading data\")\r\n\t}\r\n\tdata := raw[off : off+int(dataSize)]\r\n"]
[2888.004073, "o", "\toff += int(dataSize)\r\n\r\n\t// hash (32 bytes SHA-256)\r\n\tif off+32 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading hash\")\r\n\t}\r\n\tvar storedHash [32]byte\r\n\tcopy(storedHash[:], raw[off:off+32])\r\n\toff += 32\r\n\r\n\t// verify SHA-256\r\n\tcomputedHash := sha256.Sum256(data)\r\n\tvalid := computedHash == storedHash\r\n\r\n\treturn types.TensorInfo{\r\n\t\tName:  name,\r\n"]
[2888.004147, "o", "\t\tDtype: dtype,\r\n\t\tShape: shape,\r\n\t\tData:  data,\r\n\t\tHash:  storedHash,\r\n\t\tValid: valid,\r\n\t}, off, nil\r\n}\r\n\r\n// parseMetadata parses the metadata section: numMeta key-value pairs.\r\n"]
[2888.00468, "o", "\u001b[?2004h"]
[2888.004751, "o", "root@n30009:/app# "]
[2888.288274, "i", "nl -ba docs/analysis_rules.md | sed -n '1,30p'\n"]
[2888.288664, "o", "nl -ba docs/analysis_rules.md | sed -n '1,30p'\r\n\u001b[?2004l\r"]
[2888.292535, "o", "     1\t# Analysis Rules and Query Language\r\n     2\t\r\n     3\t## 1. Timeline Reconstruction\r\n     4\t\r\n     5\t### 1.1 Merge Algorithm\r\n"]
[2888.292669, "o", "     6\t\r\n     7\tGiven multiple `.jsonl` shard files, the timeline is reconstructed as follows:\r\n     8\t\r\n     9\t1. **Parse**: Read all entries from all shard files. Skip malformed JSON lines.\r\n    10\t2. **Deduplicate**: Entries are keyed by `(epoch, step)`. When multiple entries share the same key:\r\n    11\t   - If all numeric metric values (loss, lr, grad_norm, acc) are identical (within 1e-9 tolerance), keep one copy.\r\n    12\t   - If values differ, this is a **conflict**. Resolution: keep the entry with the **latest** `ts` timestamp. Record the conflict.\r\n    13\t3. **Sort**: Sort the unified timeline by `(epoch ASC, step ASC)`.\r\n    14\t4. **Gap Detection**: A gap exists when consecutive entries (after sorting) satisfy:\r\n    15\t   - Same epoch: `step_diff = next.step - curr.step > 1` AND `step_diff > 100`\r\n    16\t   - Cross-epoch boundary: not a gap (step resets are normal at epoch boundaries)\r\n    17\t\r\n    18\t### 1.2 Timeline Entry Output\r\n    19\t\r\n    20\tAfter merge, each entry in the timeline has:\r\n    21\t"]
[2888.292766, "o", "- All original fields from the winning entry\r\n    22\t- An additional `\"sources\"` array listing which shard files contained this `(epoch, step)`\r\n    23\t- If this entry was a conflict resolution, an additional `\"conflict\": true` field\r\n    24\t\r\n    25\t---\r\n    26\t\r\n    27\t## 2. Anomaly Detection Rules\r\n    28\t\r\n    29\tAnomalies are classified by severity: `critical`, `high`, `medium`, `low`.\r\n    30\t\r\n"]
[2888.293303, "o", "\u001b[?2004h"]
[2888.29339, "o", "root@n30009:/app# "]
[2888.574074, "i", "nl -ba docs/spec.md | sed -n '1,80p'\n"]
[2888.574421, "o", "nl -ba docs/spec.md | sed -n '1,80p'\r\n\u001b[?2004l\r"]
[2888.578269, "o", "     1\t# mlforge - ML Model Artifact Forensics Engine\r\n     2\t\r\n     3\t## Overview\r\n     4\t\r\n     5\t`mlforge` is a command-line tool for forensic analysis of machine learning model artifacts. Given a directory of evidence (model checkpoints, training log shards, configuration files), mlforge reconstructs training timelines, detects anomalies, verifies artifact integrity, builds model lineage graphs, and produces evidence-backed forensic reports.\r\n     6\t\r\n     7\t## CLI Interface\r\n"]
[2888.578394, "o", "     8\t\r\n     9\tThe binary is built as `mlforge` and placed at `/app/mlforge` (or on `$PATH` after `go install`).\r\n    10\t\r\n    11\t```\r\n    12\tmlforge <command> <evidence-dir> [flags]\r\n    13\t```\r\n    14\t\r\n    15\t### Commands\r\n    16\t\r\n    17\t| Command | Description |\r\n    18\t|---------|-------------|\r\n    19\t| `ingest` | Scan evidence directory, index all artifacts, print summary to stdout |\r\n    20\t"]
[2888.578517, "o", "| `timeline` | Reconstruct unified training timeline from log shards |\r\n    21\t| `verify` | Verify integrity of all checkpoint files |\r\n    22\t| `detect` | Run anomaly detection across all evidence |\r\n    23\t| `lineage` | Build and output model lineage DAG |\r\n    24\t| `query` | Query the unified timeline with filter expressions |\r\n    25\t| `report` | Generate full forensic report combining all analyses |\r\n    26\t\r\n    27\t### Global Flags\r\n    28\t\r\n    29\t| Flag | Type | Default | Description |\r\n    30\t|------|------|---------|-------------|\r\n    31\t| `--format` | string | `json` | Output format: `json` or `text` |\r\n    32\t| `--verbose` | bool | false | Enable verbose diagnostic output to stderr |\r\n    33\t\r\n    34\t### Command-Specific Behavior\r\n    35\t\r\n    36\t#### `ingest`\r\n"]
[2888.578685, "o", "    37\t\r\n    38\tScan `<evidence-dir>` recursively for:\r\n    39\t- `.mlck` files (model checkpoints)\r\n    40\t- `.jsonl` files (training log shards)\r\n    41\t- `.json` files matching `config_*.json` (training configurations)\r\n    42\t\r\n    43\tOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Ingest Output\".\r\n    44\t\r\n    45\tIf the evidence directory does not exist or contains no recognizable artifacts, exit with code 1 and print an error to stderr.\r\n    46\t\r\n    47\t#### `timeline`\r\n    48\t\r\n    49\tParse all `.jsonl` log shards in `<evidence-dir>`, merge entries into a unified timeline.\r\n    50\t\r\n    51\t**Merge Rules** (detailed in `/app/docs/analysis_rules.md` section \"Timeline Reconstruction\"):\r\n    52\t- Entries are identified by `(epoch, step)` tuple\r\n    53\t- When multiple shards contain the same `(epoch, step)`, apply conflict resolution\r\n    54\t- Gaps in the step sequence are detected and reported\r\n    55\t\r\n    56\tOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Timeline Out"]
[2888.578791, "o", "put\".\r\n    57\t\r\n    58\t#### `verify`\r\n    59\t\r\n    60\tFor each `.mlck` file in `<evidence-dir>`:\r\n    61\t1. Parse the file according to the MLCK format (see `/app/docs/formats.md`)\r\n    62\t2. Validate the header checksum\r\n    63\t3. Validate each tensor's SHA-256 data checksum\r\n    64\t4. If the file is signed (Flags bit 0), validate the HMAC-SHA256 signature\r\n    65\t5. Validate provenance fields are well-formed\r\n    66\t\r\n    67\tOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Verify Output\".\r\n    68\t\r\n    69\t#### `detect`\r\n    70\t\r\n    71\tRun all anomaly detection rules (defined in `/app/docs/analysis_rules.md`) across the evidence:\r\n    72\t- Timeline-based anomalies (from log shards)\r\n    73\t- Checkpoint integrity anomalies (from .mlck files)\r\n    74\t- Cross-artifact anomalies (correlating checkpoints with logs)\r\n    75\t\r\n    76\tOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Detect Output\".\r\n    77\t\r\n    78\t#### `lineage`\r\n    79\t\r\n    80\tBuild a directed acyclic graph of"]
[2888.578875, "o", " model checkpoint relationships using the `parent_hash` field from each checkpoint's provenance section.\r\n"]
[2888.579358, "o", "\u001b[?2004h"]
[2888.579393, "o", "root@n30009:/app# "]
[2888.848459, "i", "nl -ba docs/output_schema.md | sed -n '1,120p'\n"]
[2888.848895, "o", "nl -ba docs/output_schema.md | sed -n '1,120p'\r\n\u001b[?2004l\r"]
[2888.8529, "o", "     1\t# Output Schemas\r\n     2\t\r\n     3\tAll commands output JSON to stdout. This document defines the exact JSON structure for each command.\r\n     4\t\r\n     5\t---\r\n     6\t\r\n"]
[2888.853025, "o", "     7\t## 1. Ingest Output\r\n     8\t\r\n     9\t```json\r\n    10\t{\r\n    11\t  \"status\": \"ok\",\r\n    12\t  \"evidence_dir\": \"/path/to/evidence\",\r\n    13\t  \"artifacts\": {\r\n    14\t    \"checkpoints\": [\r\n    15\t      {\r\n    16\t        \"file\": \"model_epoch1.mlck\",\r\n    17\t        \"file_hash\": \"a1b2c3...\",\r\n    18\t        \"version\": 1,\r\n    19\t        \"num_tensors\": 12,\r\n    20\t        \"num_metadata\": 3,\r\n    21\t        \"signed\": false,\r\n    22\t        \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n"]
[2888.85311, "o", "    23\t        \"provenance\": {\r\n    24\t          \"epoch\": 1,\r\n    25\t          \"global_step\": 5000,\r\n    26\t          \"framework\": \"PyTorch\",\r\n    27\t          \"framework_version\": \"2.1.0\",\r\n    28\t          \"parent_hash\": \"\"\r\n    29\t        }\r\n    30\t      }\r\n    31\t    ],\r\n    32\t    \"log_shards\": [\r\n    33\t      {\r\n    34\t        \"file\": \"shard_001.jsonl\",\r\n    35\t        \"entries\": 500,\r\n"]
[2888.85319, "o", "    36\t        \"step_range\": [0, 5000],\r\n    37\t        \"epoch_range\": [0, 1],\r\n    38\t        \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-15T10:00:00Z\"]\r\n    39\t      }\r\n    40\t    ],\r\n    41\t    \"configs\": [\r\n    42\t      {\r\n    43\t        \"file\": \"config_train.json\",\r\n    44\t        \"model_name\": \"resnet50\",\r\n    45\t        \"dataset\": \"imagenet-1k\"\r\n    46\t      }\r\n    47\t    ]\r\n    48\t"]
[2888.853271, "o", "  },\r\n    49\t  \"totals\": {\r\n    50\t    \"checkpoints\": 3,\r\n    51\t    \"log_shards\": 4,\r\n    52\t    \"configs\": 1\r\n    53\t  }\r\n    54\t}\r\n    55\t```\r\n    56\t\r\n    57\t**Field rules:**\r\n    58\t- `file_hash`: SHA-256 hex of the entire `.mlck` file content.\r\n    59\t- `checkpoints` array: sorted by `creation_timestamp` ascending.\r\n    60\t- `log_shards` array: sorted by `file` name lexicographically.\r\n    61"]
[2888.85334, "o", "\t- `configs` array: sorted by `file` name lexicographically.\r\n    62\t- `step_range`: `[min_step, max_step]` across all entries in the shard.\r\n    63\t- `epoch_range`: `[min_epoch, max_epoch]` across all entries.\r\n    64\t- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.\r\n    65\t\r\n    66\t---\r\n    67\t\r\n    68\t## 2. Timeline Output\r\n    69\t\r\n    70\t```json\r\n    71\t{\r\n"]
[2888.85341, "o", "    72\t  \"status\": \"ok\",\r\n    73\t  \"total_entries\": 1200,\r\n    74\t  \"total_epochs\": 5,\r\n    75\t  \"step_range\": [0, 50000],\r\n    76\t  \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-17T14:00:00Z\"],\r\n    77\t  \"conflicts_resolved\": 3,\r\n    78\t  \"gaps\": [\r\n    79\t    {\r\n    80\t      \"after_step\": 5000,\r\n    81\t      \"before_step\": 5200,\r\n    82\t      \"epoch\": 1,\r\n    83\t      \"gap_steps\": 200,"]
[2888.853488, "o", "\r\n    84\t      \"after_ts\": \"2024-01-15T10:00:00Z\",\r\n    85\t      \"before_ts\": \"2024-01-15T13:00:00Z\"\r\n    86\t    }\r\n    87\t  ],\r\n    88\t  \"entries\": [\r\n    89\t    {\r\n    90\t      \"ts\": \"2024-01-15T08:00:00Z\",\r\n    91\t      \"epoch\": 0,\r\n    92\t      \"step\": 0,\r\n    93\t      \"loss\": 6.9078,\r\n"]
[2888.853565, "o", "    94\t      \"lr\": 0.001,\r\n    95\t      \"grad_norm\": 12.34,\r\n    96\t      \"acc\": 0.001,\r\n    97\t      \"event\": \"step\",\r\n    98\t      \"sources\": [\"shard_001.jsonl\"],\r\n    99\t      \"conflict\": false\r\n   100\t    }\r\n   101\t  ]\r\n   102\t}\r\n   103\t```\r\n   104\t\r\n   105\t**Field rules:**\r\n"]
[2888.853635, "o", "   106\t- `entries`: sorted by `(epoch ASC, step ASC)`.\r\n   107\t- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.\r\n   108\t- `conflict`: `true` if this entry was chosen by conflict resolution.\r\n   109\t- `gaps`: only gaps where `gap_steps > 100` within the same epoch.\r\n   110\t- Entries with missing optional fields omit them from the JSON (do not include null).\r\n   111\t\r\n   112\t---\r\n   113\t\r\n   114\t## 3. Verify Output\r\n"]
[2888.853703, "o", "   115\t\r\n   116\t```json\r\n   117\t{\r\n   118\t  \"status\": \"ok\",\r\n   119\t  \"checkpoints\": [\r\n   120\t    {\r\n"]
[2888.854355, "o", "\u001b[?2004h"]
[2888.854436, "o", "root@n30009:/app# "]
[2894.851899, "i", "sed -n '1,130p' internal/forensics/forensics.go\n"]
[2894.852535, "o", "sed -n '1,130p' internal/forensics/forensics.go\r\n\u001b[?2004l\r"]
[2894.855784, "o", "package forensics\r\n\r\nimport (\r\n\t\"crypto/hmac\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n"]
[2894.855964, "o", "\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"mlforge/internal/checkpoint\"\r\n\t\"mlforge/internal/logparser\"\r\n\t\"mlforge/internal/types\"\r\n)\r\n\r\ntype ArtifactPaths struct {\r\n\tCheckpoints []string\r\n\tLogs        []string\r\n\tConfigs     []string\r\n}\r\n\r\nfunc DiscoverArtifacts(dir string) (ArtifactPaths, error) {\r\n\tvar ap ArtifactPaths\r\n\terr := filepath.WalkDir(dir, func(path string, d os.DirEntry, err error) error {\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t\tif d.IsDir() {\r\n\t\t\treturn nil\r\n"]
[2894.856058, "o", "\t\t}\r\n\t\tname := d.Name()\r\n\t\tlower := strings.ToLower(name)\r\n\t\tswitch {\r\n\t\tcase strings.HasSuffix(lower, \".mlck\"):\r\n\t\t\tap.Checkpoints = append(ap.Checkpoints, path)\r\n\t\tcase strings.HasSuffix(lower, \".jsonl\"):\r\n"]
[2894.856157, "o", "\t\t\tap.Logs = append(ap.Logs, path)\r\n\t\tcase strings.HasPrefix(name, \"config_\") && strings.HasSuffix(lower, \".json\"):\r\n\t\t\tap.Configs = append(ap.Configs, path)\r\n\t\t}\r\n\t\treturn nil\r\n\t})\r\n\tif err != nil {\r\n\t\treturn ap, err\r\n\t}\r\n\tsort.Strings(ap.Checkpoints)\r\n\tsort.Strings(ap.Logs)\r\n\tsort.Strings(ap.Configs)\r\n\treturn ap, nil\r\n}\r\n\r\ntype IngestCheckpoint struct {\r\n\tFile              string                 `json:\"file\"`\r\n\tFileHash          string                 `json:\"file_hash\"`\r\n\tVersion           uint32                 `json:\"version\"`\r\n\tNumTensors        uint32                 `json:\"num_tensors\"`\r\n\tNumMetadata       uint32                 `json:\"num_metadata\"`\r\n\tSigned            bool                   `json:\"signed\"`\r\n\tCreationTimestamp string                 `json:\"creation_timestamp\"`\r\n\tProvenance        map[string]interface{} `json:\"provenance\"`\r\n}\r\n"]
[2894.856238, "o", "\r\ntype IngestLogShard struct {\r\n\tFile       string   `json:\"file\"`\r\n\tEntries    int      `json:\"entries\"`\r\n\tStepRange  []int    `json:\"step_range\"`\r\n\tEpochRange []int    `json:\"epoch_range\"`\r\n\tTimeRange  []string `json:\"time_range\"`\r\n}\r\n\r\ntype IngestConfig struct {\r\n\tFile      string `json:\"file\"`\r\n\tModelName string `json:\"model_name\"`\r\n\tDataset   string `json:\"dataset\"`\r\n}\r\n"]
[2894.856314, "o", "\r\ntype IngestOutput struct {\r\n\tStatus      string `json:\"status\"`\r\n\tEvidenceDir string `json:\"evidence_dir\"`\r\n\tArtifacts   struct {\r\n\t\tCheckpoints []IngestCheckpoint `json:\"checkpoints\"`\r\n\t\tLogShards   []IngestLogShard   `json:\"log_shards\"`\r\n\t\tConfigs     []IngestConfig     `json:\"configs\"`\r\n\t} `json:\"artifacts\"`\r\n\tTotals struct {\r\n\t\tCheckpoints int `json:\"checkpoints\"`\r\n\t\tLogShards   int `json:\"log_shards\"`\r\n\t"]
[2894.856394, "o", "\tConfigs     int `json:\"configs\"`\r\n\t} `json:\"totals\"`\r\n}\r\n\r\nfunc BuildIngest(dir string) (interface{}, error) {\r\n\tap, err := DiscoverArtifacts(dir)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif len(ap.Checkpoints) == 0 && len(ap.Logs) == 0 && len(ap.Configs) == 0 {\r\n\t\treturn nil, fmt.Errorf(\"no recognizable artifacts found in %s\", dir)\r\n\t}\r\n\r\n"]
[2894.856477, "o", "\tvar out IngestOutput\r\n\tout.Status = \"ok\"\r\n\tout.EvidenceDir = dir\r\n\tout.Artifacts.Checkpoints = []IngestCheckpoint{}\r\n\tout.Artifacts.LogShards = []IngestLogShard{}\r\n\tout.Artifacts.Configs = []IngestConfig{}\r\n\r\n\tfor _, p := range ap.Checkpoints {\r\n\t\tcf, err := checkpoint.Parse(p)\r\n\t\tif err != nil || cf == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tic := IngestCheckpoint{\r\n\t\t\tFile:              cf.Filename,\r\n\t\t"]
[2894.856562, "o", "\tFileHash:          cf.FileHash,\r\n\t\t\tVersion:           cf.Version,\r\n\t\t\tNumTensors:        cf.NumTensors,\r\n\t\t\tNumMetadata:       cf.NumMetadataKeys,\r\n\t\t\tSigned:            cf.Signed,\r\n\t\t\tCreationTimestamp: unixToISO(cf.CreationTimestamp),\r\n\t\t\tProvenance:        provenanceToMap(cf.Provenance),\r\n\t\t}\r\n\t\tout.Artifacts.Checkpoints = append(out.Artifacts.Checkpoints, ic)\r\n\t}\r\n"]
[2894.857192, "o", "\u001b[?2004h"]
[2894.857279, "o", "root@n30009:/app# "]
