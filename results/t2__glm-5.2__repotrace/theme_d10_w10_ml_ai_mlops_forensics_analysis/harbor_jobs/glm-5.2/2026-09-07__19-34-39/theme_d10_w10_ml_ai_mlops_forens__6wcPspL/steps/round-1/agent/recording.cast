[5454.375839, "o", "   543\t\tsigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   544\t\toff += 2\r\n   545\t\tif off+sigLen > len(raw) {\r\n   546\t\t\treturn false, signerID\r\n   547\t\t}\r\n   548\t\tstored := raw[off : off+sigLen]\r\n   549\t\tmac := hmac.New(sha256.New, []byte(signerID))\r\n   550\t\tmac.Write(raw[:sigOff])\r\n   551\t\texpected := mac.Sum(nil)\r\n   552\t\treturn hmac.Equal(expected, stored), signerID\r\n   553\t}\r\n   554\t\r\n   555\tfunc lastValues(v []float64, n int) []float64 {\r\n   556\t\tif len(v) > n {\r\n   557\t\t\tv = v[len(v)-n:]\r\n   558\t\t}\r\n   559\t\tif v == nil {\r\n   560\t\t\tv = []float64{}\r\n   561\t\t}\r\n   562\t\treturn v\r\n   563\t}\r\n   564\t\r\n   565\tfunc precedingLossValues(entries []types.TimelineEntry, indices []int, pos, n int) []float64 {\r\n   566\t\tvals := []float64{}\r\n   567\t\tstart := pos - n\r\n   568\t\tif start < 0 {\r\n   569\t\t"]
