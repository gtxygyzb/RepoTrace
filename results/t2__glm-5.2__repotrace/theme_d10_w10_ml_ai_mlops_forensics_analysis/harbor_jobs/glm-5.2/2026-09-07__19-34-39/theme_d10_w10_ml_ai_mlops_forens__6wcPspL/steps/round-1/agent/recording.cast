[5472.426515, "o", "\t}\r\n\ts := 0.0\r\n\tfor _, x := range v {\r\n\t\td := x - mean\r\n"]
[5472.426603, "o", "\t\ts += d * d\r\n\t}\r\n\treturn math.Sqrt(s / float64(len(v)))\r\n}\r\n\r\nfunc sortAnomalies(a []types.Anomaly) {\r\n\trank := map[string]int{\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3}\r\n\tsort.Slice(a, func(i, j int) bool {\r\n\t\tri := rank[a[i].Severity]\r\n\t\trj := rank[a[j].Severity]\r\n\t\tif ri != rj {\r\n\t\t\treturn ri < rj\r\n\t\t}\r\n\t\tei := -1\r\n\t\tej := -1\r\n"]
[5472.426665, "o", "\t\tif a[i].Epoch != nil {\r\n\t\t\tei = *a[i].Epoch\r\n\t\t}\r\n\t\tej = -1\r\n\t\tif a[j].Epoch != nil {\r\n\t\t\tej = *a[j].Epoch\r\n\t\t}\r\n\t\tif ei != ej {\r\n\t\t\treturn ei < ej\r\n\t"]
[5472.426718, "o", "\t}\r\n\t\tsi := -1\r\n\t\tif a[i].Step != nil {\r\n\t\t\tsi = *a[i].Step\r\n\t\t}\r\n\t\tsj := -1\r\n\t\tif a[j].Step != nil {\r\n\t\t\tsj = *a[j].Step\r\n\t\t}\r\n\t\treturn si < sj\r\n"]
[5472.426769, "o", "\t})\r\n}\r\n"]
