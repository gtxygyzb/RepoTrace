[4423.484126, "o", "bash: printf: --: invalid option\r\nprintf: usage: printf [-v var] format [arguments]\r\n"]
[4423.487092, "o", "package forensics\r\n\r\nimport (\r\n\t\"crypto/hmac\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n"]
[4423.487158, "o", "\t\"encoding/hex\"\r\n\t\"fmt\"\r\n\t\"hash/fnv\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"time\"\r\n\r\n\t\"mlforge/internal/checkpoint\"\r\n\t\"mlforge/internal/types\"\r\n)\r\n\r\n"]
[4423.487217, "o", "func loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {\r\n\tap, err := DiscoverArtifacts(dir)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar cps []*types.CheckpointFile\r\n\tfor _, p := range ap.Checkpoints {\r\n\t\tcf, err := checkpoint.Parse(p)\r\n\t\tif err != nil || cf == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t"]
[4423.487279, "o", "\tcps = append(cps, cf)\r\n\t}\r\n\tsort.Slice(cps, func(i, j int) bool {\r\n\t\treturn cps[i].Filename < cps[j].Filename\r\n\t})\r\n\treturn cps, nil\r\n}\r\n\r\ntype DetectOutput struct {\r\n\tStatus    string          `json:\"status\"`\r\n\tAnomalies []types.Anomaly `json:\"anomalies\"`\r\n\tSummary   struct {\r\n"]
[4423.487336, "o", "\t\tTotal      int            `json:\"total\"`\r\n\t\tBySeverity map[string]int `json:\"by_severity\"`\r\n\t\tByType     map[string]int `json:\"by_type\"`\r\n\t} `json:\"summary\"`\r\n}\r\n\r\nfunc BuildDetect(dir string) (interface{}, error) {\r\n\treturn buildDetectWithDir(dir)\r\n}\r\n\r\nfunc buildDetectWithDir(dir string) (DetectOutput, error) {\r\n\t"]
[4423.487395, "o", "var out DetectOutput\r\n\tout.Status = \"ok\"\r\n\tvar anomalies []types.Anomaly\r\n\r\n\tentries, _, err := loadTimelineEntries(dir)\r\n\tif err == nil {\r\n\t\tmerged, _ := mergeTimeline(entries)\r\n\t\tsortTimeline(merged)\r\n\t\tanomalies = append(anomalies, detectTimelineAnomalies(merged)...)\r\n\t}\r\n"]
[4423.487453, "o", "\r\n\tcps, err := loadCheckpoints(dir)\r\n\tif err == nil {\r\n\t\tanomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\r\n\t}\r\n\r\n\tfor i := range anomalies {\r\n\t\tanomalies[i].ID = fmt.Sprintf(\"ANOM-%03d\", i+1)\r\n\t}\r\n\tsortAnomalies(anomalies)\r\n"]
[4423.487509, "o", "\r\n\tout.Anomalies = anomalies\r\n\tif out.Anomalies == nil {\r\n\t\tout.Anomalies = []types.Anomaly{}\r\n\t}\r\n\tout.Summary.Total = len(anomalies)\r\n\tout.Summary.BySeverity = map[string]int{\"critical\": 0, \"high\": 0, \"medium\": 0, \"low\": 0}\r\n\tout.Summary.ByType = map[string]int{}\r\n\tfor _, a := range anomalies {\r\n\t\tout.Summary.BySeverity[a.Severity]++\r\n\t\tout.Summary.ByType[a.Type]++\r\n"]
[4423.487568, "o", "\t}\r\n\treturn out, nil\r\n}\r\n\r\nfunc detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tanomalies = append(anomalies, detectGradientSpikes(entries)...)\r\n\tanomalies = append(anomalies, detectLossDivergence(entries)...)\r\n\tanomalies = append(anomalies, detectLrAnomalies(entries)...)\r\n\tanomalies = append(anomalies, detectTrainingGaps(entries)...)\r\n\tanomalies = append(anomalies, detectMetricRegression(entries)...)\r\n\treturn anomalies\r\n"]
[4423.487623, "o", "}\r\n\r\nfunc detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar vals []float64\r\n\tvar idx []int\r\n\tfor i, e := range entries {\r\n\t\tif e.GradNorm != nil {\r\n\t\t\tvals = append(vals, *e.GradNorm)\r\n\t\t\tidx = append(idx, i)\r\n"]
[4423.48769, "o", "\t\t}\r\n\t}\r\n\tif len(vals) < 31 {\r\n\t\treturn nil\r\n\t}\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 30; i < len(vals); i++ {\r\n\t\twindow := vals[i-30 : i]\r\n\t\tmean := meanFloats(window)\r\n\t\tstd := stddevFloats(window, mean)\r\n"]
[4423.487746, "o", "\t\tobserved := vals[i]\r\n\t\tz := 0.0\r\n\t\tif std > 0 {\r\n\t\t\tz = (observed - mean) / std\r\n\t\t}\r\n\t\tif observed > mean+2.5*std && z > 2.5 {\r\n\t\t\tseverity := \"medium\"\r\n\t\t\tif z > 4.0 {\r\n\t\t\t\tseverity = \"high\"\r\n"]
[4423.487803, "o", "\t\t\t}\r\n\t\t\tep := entries[idx[i]].Epoch\r\n\t\t\tst := entries[idx[i]].Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"gradient_spike\",\r\n\t\t\t\tSeverity: severity,\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n"]
[4423.487859, "o", "\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"observed\":      observed,\r\n\t\t\t\t\t\"window_mean\":   mean,\r\n\t\t\t\t\t\"window_stddev\": std,\r\n\t\t\t\t\t\"z_score\":       z,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(entries[idx[i]]),\r\n\t\t\t})\r\n"]
[4423.487917, "o", "\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar lossEntries []int\r\n\tfor i, e := range entries {\r\n\t\tif e.Loss != nil {\r\n\t\t\tlossEntries = append(lossEntries, i)\r\n\t\t}\r\n\t}\r\n"]
[4423.487999, "o", "\tif len(lossEntries) < 51 {\r\n\t\treturn nil\r\n\t}\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 50; i < len(lossEntries); i++ {\r\n\t\tstartIdx := lossEntries[i-50]\r\n\t\tendIdx := lossEntries[i]\r\n\t\tstart := *entries[startIdx].Loss\r\n\t\tend := *entries[endIdx].Loss\r\n\t\tif math.Abs(start) <= 1e-6 {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[4423.48806, "o", "\t\tratio := (end - start) / math.Abs(start)\r\n\t\tif ratio > 1.0 {\r\n\t\t\tseverity := \"high\"\r\n\t\t\tif ratio > 5.0 {\r\n\t\t\t\tseverity = \"critical\"\r\n\t\t\t}\r\n\t\t\tep := entries[endIdx].Epoch\r\n\t\t\tst := entries[endIdx].Step\r\n"]
[4423.488117, "o", "\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"loss_divergence\",\r\n\t\t\t\tSeverity: severity,\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"loss_start\":        start,\r\n\t\t\t\t\t\"loss_end\":          end,\r\n\t\t\t\t\t\"increase_ratio\":    ratio,\r\n\t\t\t\t\t\"window_start_step\": entries[startIdx].Step,\r\n"]
[4423.488175, "o", "\t\t\t\t\t\"window_end_step\":   entries[endIdx].Step,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(entries[endIdx]),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\n"]
[4423.48823, "o", "func detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]\r\n\t\tif prev.Lr == nil || cur.Lr == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif *cur.Lr > *prev.Lr {\r\n\t"]
[4423.488288, "o", "\t\tif cur.Event == \"epoch_end\" {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"lr_anomaly\",\r\n\t\t\t\tSeverity: \"medium\",\r\n\t\t\t\tEpoch:    &ep,\r\n\t"]
[4423.488343, "o", "\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"prev_lr\": *prev.Lr,\r\n\t\t\t\t\t\"curr_lr\": *cur.Lr,\r\n\t\t\t\t\t\"step\":    cur.Step,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(cur),\r\n\t\t\t})\r\n"]
[4423.488398, "o", "\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n"]
[4423.48893, "o", "\u001b[?2004h"]
