[2506.513873, "o", "\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\"mlforge/internal/\u001b[01;31m\u001b[Kcheckpoint\u001b[m\u001b[K\"\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks []string\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tap.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks = append(ap.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks, path)\r\n"]
[2506.513968, "o", "\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tsort.Strings(ap.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks)\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktype Ingest\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[K struct {\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks []Ingest\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[K `json:\"\u001b[01;31m\u001b[Kcheckpoint\u001b[m\u001b[Ks\"`\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks int `json:\"\u001b[01;31m\u001b[Kcheckpoint\u001b[m\u001b[Ks\"`\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif len(ap.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks) == 0 && len(ap.Logs) == 0 && len(ap.Configs) == 0 {\r\n"]
[2506.514051, "o", "\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tout.Artifacts.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks = []Ingest\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[K{}\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, p := range ap.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks {\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcf, err := \u001b[01;31m\u001b[Kcheckpoint\u001b[m\u001b[K.Parse(p)\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tic := Ingest\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[K{\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tout.Artifacts.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks = append(out.Artifacts.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks, ic)\r\n"]
[2506.514164, "o", "\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tsort.Slice(out.Artifacts.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks, func(i, j int) bool {\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn out.Artifacts.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks[i].CreationTimestamp < out.Artifacts.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks[j].CreationTimestamp\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tout.Totals.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks = len(out.Artifacts.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks)\r\n"]
[2506.514225, "o", "\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktype \u001b[01;31m\u001b[KVerifyIssue\u001b[m\u001b[K struct {\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktype Verify\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[K struct {\r\n"]
