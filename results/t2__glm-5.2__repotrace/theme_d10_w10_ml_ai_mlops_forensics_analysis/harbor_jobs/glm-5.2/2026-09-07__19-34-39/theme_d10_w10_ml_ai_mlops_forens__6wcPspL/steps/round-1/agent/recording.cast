[4449.499464, "o", "   386\tfunc detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {\r\n   387\t\tbyHash := map[string]*types.CheckpointFile{}\r\n   388\t\tfor _, cf := range cps {\r\n   389\t\t\tbyHash[cf.FileHash] = cf\r\n   390\t\t}\r\n   391\t\tchildren := map[string][]string{}\r\n   392\t\tfor _, cf := range cps {\r\n   393\t\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n   394\t\t\t\tif _, ok := byHash[cf.Provenance.ParentHash]; ok {\r\n   395\t\t\t\t\tchildren[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)\r\n   396\t\t\t\t}\r\n   397\t\t\t}\r\n   398\t\t}\r\n   399"]
[4449.499544, "o", "\t\r\n   400\t\tvar anomalies []types.Anomaly\r\n   401\t\tseen := map[string]bool{}\r\n   402\t\tfor _, cf := range cps {\r\n   403\t\t\tif cf.Provenance == nil {\r\n   404\t\t\t\tcontinue\r\n   405\t\t\t}\r\n   406\t\t\troot := cf.FileHash\r\n   407\t\t\tfor root != \"\" {\r\n   408\t\t\t\tparent, ok := byHash[root]\r\n   409\t\t\t\t"]
[4449.499609, "o", "if !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == \"\" {\r\n   410\t\t\t\t\tbreak\r\n   411\t\t\t\t}\r\n   412\t\t\t\troot = parent.Provenance.ParentHash\r\n   413\t\t\t}\r\n   414\t\t\tif seen[root] {\r\n   415\t\t\t\tcontinue\r\n   416\t\t\t}\r\n   417\t\t\tseen[root] = true\r\n"]
[4449.49967, "o", "   418\t\r\n   419\t\t\tchain := []string{}\r\n   420\t\t\tqueue := []string{root}\r\n   421\t\t\tvisited := map[string]bool{}\r\n   422\t\t\tfor len(queue) > 0 {\r\n   423\t\t\t\tcur := queue[0]\r\n   424\t\t\t\tqueue = queue[1:]\r\n   425\t\t\t\tif visited[cur] {\r\n"]
[4449.499728, "o", "   426\t\t\t\t\tcontinue\r\n   427\t\t\t\t}\r\n   428\t\t\t\tvisited[cur] = true\r\n   429\t\t\t\tnode, ok := byHash[cur]\r\n   430\t\t\t\tif !ok || node == nil {\r\n   431\t\t\t\t\tcontinue\r\n   432"]
[4449.499788, "o", "\t\t\t\t}\r\n   433\t\t\t\tchain = append(chain, node.Filename)\r\n   434\t\t\t\tqueue = append(queue, children[cur]...)\r\n   435\t\t\t}\r\n   436\t\t\tsort.Strings(chain)\r\n   437\t\r\n   438\t\t\thashes := map[string]struct{}{}\r\n   439\t\t\tfor _, h := range chain {\r\n   440\t\t\t\tif node, ok := byHashFile(cps, h); ok && node.Provenance != nil {\r\n"]
[4449.499854, "o", "   441\t\t\t\t\thashes[node.Provenance.DatasetHash] = struct{}{}\r\n   442\t\t\t\t}\r\n   443\t\t\t}\r\n   444\t\t\tif len(hashes) > 1 {\r\n   445\t\t\t\tunique := make([]string, 0, len(hashes))\r\n   446\t\t\t\tfor h := range hashes {\r\n   447\t\t\t\t\tunique = append(unique, h)\r\n   448\t\t\t\t}\r\n   449\t\t\t\tsort.Strings(unique)\r\n"]
[4449.499912, "o", "   450\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   451\t\t\t\t\tType:     \"dataset_hash_inconsistency\",\r\n   452\t\t\t\t\tSeverity: \"high\",\r\n   453\t\t\t\t\tDetails: map[string]interface{}{\r\n   454\t\t\t\t\t\t\"files\":  chain,\r\n   455\t\t\t\t\t\t\"hashes\": unique,\r\n"]
