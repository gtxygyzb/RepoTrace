[5454.088174, "o", "   395\t\r\n   396\t\t\tif cf.Signed {\r\n   397\t\t\t\tvalid, signer := signatureDetails(cf.Path)\r\n   398\t\t\t\tif !valid {\r\n   399\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   400\t\t\t\t\t\tType:     \"signature_invalid\",\r\n   401\t\t\t\t\t\tSeverity: \"critical\",\r\n   402\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   403\t\t\t\t\t\t\t\"file\":      cf.Filename,\r\n   404\t\t\t\t\t\t\t\"signer_id\": signer,\r\n"]
[5454.088237, "o", "   405\t\t\t\t\t\t\t\"valid\":     false,\r\n   406\t\t\t\t\t\t},\r\n   407\t\t\t\t\t\tEvidence:   map[string]interface{}{},\r\n   408\t\t\t\t\t\tSource:     cf.Filename,\r\n   409\t\t\t\t\t\tCheckpoint: cf.Filename,\r\n   410\t\t\t\t\t})\r\n   411\t\t\t\t}\r\n"]
[5454.088313, "o", "   412\t\t\t}\r\n   413\t\r\n   414\t\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n   415\t\t\t\t_, found := hashSet[cf.Provenance.ParentHash]\r\n   416\t\t\t\tif !found {\r\n   417\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   418\t\t\t\t\t\tType:     \"provenance_chain_break\",\r\n   419\t\t\t\t\t\tSeverity: \"high\",\r\n   420\t\t\t\t\t\tDetails: map[string]interface{}{\r\n"]
