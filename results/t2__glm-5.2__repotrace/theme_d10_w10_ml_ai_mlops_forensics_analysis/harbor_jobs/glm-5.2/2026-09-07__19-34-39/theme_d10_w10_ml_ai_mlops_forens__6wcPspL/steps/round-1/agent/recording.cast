[5472.119718, "o", "\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar cps []types.TimelineEntry\r\n\tfor _, e := range entries {\r\n\t"]
[5472.119814, "o", "\tif e.Event == \"checkpoint\" {\r\n\t\t\tcps = append(cps, e)\r\n\t\t}\r\n\t}\r\n\tsortTimeline(cps)\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(cps); i++ {\r\n\t\tprev := cps[i-1]\r\n\t\tcur := cps[i]\r\n\t\tif prev.Acc == nil || cur.Acc == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tdrop := *prev.Acc - *cur.Acc\r\n"]
[5472.119875, "o", "\t\tif drop > 0.15 {\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"metric_regression\",\r\n\t\t\t\tSeverity: \"high\",\r\n\t\t\t\tEpoch:    &ep,\r\n\t"]
[5472.119931, "o", "\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"prev_acc\":        *prev.Acc,\r\n\t\t\t\t\t\"curr_acc\":        *cur.Acc,\r\n\t\t\t\t\t\"drop\":            drop,\r\n\t\t\t\t\t\"prev_checkpoint\": prev.Step,\r\n\t\t\t\t\t\"curr_checkpoint\": cur.Step,\r\n\t\t\t\t},\r\n"]
[5472.119994, "o", "\t\t\t\tEvidence: map[string]interface{}{\"window_values\": []float64{}},\r\n\t\t\t\tSource:   firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n"]
[5472.120045, "o", "}\r\n\r\nfunc detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\thashSet := map[string]*types.CheckpointFile{}\r\n\tfor _, cf := range cps {\r\n\t\thashSet[cf.FileHash] = cf\r\n"]
[5472.120097, "o", "\t}\r\n\r\n\tfor _, cf := range cps {\r\n\t\traw, err := os.ReadFile(cf.Path)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif !cf.HeaderValid {\r\n\t\t\tstored := uint64(0)\r\n"]
[5472.120152, "o", "\t\t\tif len(raw) >= 56 {\r\n\t\t\t\tstored = binary.LittleEndian.Uint64(raw[48:56])\r\n\t\t\t}\r\n\t\t\th := fnv.New64a()\r\n\t\t\th.Write(raw[:48])\r\n\t\t\tcomputed := h.Sum64()\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"header_checksum_mismatch\",\r\n\t\t\t\tSeverity: \"critical\",\r\n"]
[5472.120205, "o", "\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"file\":              cf.Filename,\r\n\t\t\t\t\t\"expected_checksum\": fmt.Sprintf(\"%016x\", stored),\r\n\t\t\t\t\t\"actual_checksum\":   fmt.Sprintf(\"%016x\", computed),\r\n\t\t\t\t},\r\n\t\t\t\tEvidence:   map[string]interface{}{},\r\n"]
[5472.120255, "o", "\t\t\t\tSource:     cf.Filename,\r\n\t\t\t\tCheckpoint: cf.Filename,\r\n\t\t\t})\r\n\t\t}\r\n\r\n\t\tfor _, t := range cf.Tensors {\r\n\t\t\tif !t.Valid {\r\n"]
[5472.120306, "o", "\t\t\t\tcomputed := sha256.Sum256(t.Data)\r\n\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\t\tType:     \"tensor_checksum_mismatch\",\r\n\t\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":              cf.Filename,\r\n\t\t\t\t\t\t\"tensor_name\":       t.Name,\r\n"]
[5472.120357, "o", "\t\t\t\t\t\t\"expected_checksum\": hex.EncodeToString(t.Hash[:]),\r\n\t\t\t\t\t\t\"actual_checksum\":   hex.EncodeToString(computed[:]),\r\n\t\t\t\t\t},\r\n\t\t\t\t\tEvidence:   map[string]interface{}{},\r\n\t\t\t\t\tSource:     cf.Filename,\r\n\t\t\t\t\tCheckpoint: cf.Filename,\r\n\t\t\t\t})\r\n"]
[5472.120408, "o", "\t\t\t}\r\n\t\t}\r\n\r\n\t\tif cf.Signed {\r\n\t\t\tvalid, signer := signatureDetails(cf.Path)\r\n\t\t\tif !valid {\r\n"]
[5472.120458, "o", "\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\t\tType:     \"signature_invalid\",\r\n\t\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":      cf.Filename,\r\n\t\t\t\t\t"]
[5472.120509, "o", "\t\"signer_id\": signer,\r\n\t\t\t\t\t\t\"valid\":     false,\r\n\t\t\t\t\t},\r\n\t\t\t\t\tEvidence:   map[string]interface{}{},\r\n\t\t\t\t\tSource:     cf.Filename,\r\n\t\t\t\t\tCheckpoint: cf.Filename,\r\n\t\t\t\t})\r\n"]
[5472.120559, "o", "\t\t\t}\r\n\t\t}\r\n\r\n\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n\t\t\t_, found := hashSet[cf.Provenance.ParentHash]\r\n\t\t\tif !found {\r\n\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n"]
[5472.120609, "o", "\t\t\t\t\tType:     \"provenance_chain_break\",\r\n\t\t\t\t\tSeverity: \"high\",\r\n\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":        cf.Filename,\r\n\t\t\t\t\t\t\"parent_hash\": cf.Provenance.ParentHash,\r\n\t\t\t\t\t\t\"found\":       false,\r\n\t\t\t\t\t},\r\n"]
[5472.120658, "o", "\t\t\t\t\tEvidence:   map[string]interface{}{},\r\n\t\t\t\t\tSource:     cf.Filename,\r\n\t\t\t\t\tCheckpoint: cf.Filename,\r\n\t\t\t\t})\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[5472.120709, "o", "\tanomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {\r\n\tbyHash := map[string]*types.CheckpointFile{}\r\n\tfor _, cf := range cps {\r\n\t\tbyHash[cf.FileHash] = cf\r\n\t}\r\n"]
[5472.120761, "o", "\tchildren := map[string][]string{}\r\n\tfor _, cf := range cps {\r\n\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n\t\t\tif _, ok := byHash[cf.Provenance.ParentHash]; ok {\r\n\t\t\t\tchildren[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[5472.12081, "o", "\tvar anomalies []types.Anomaly\r\n\tseen := map[string]bool{}\r\n\tfor _, cf := range cps {\r\n\t\tif cf.Provenance == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\troot := cf.FileHash\r\n\t\tfor root != \"\" {\r\n\t\t\tparent, ok := byHash[root]\r\n"]
[5472.12086, "o", "\t\t\tif !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == \"\" {\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\troot = parent.Provenance.ParentHash\r\n\t\t}\r\n\t\tif seen[root] {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[5472.120908, "o", "\t\tseen[root] = true\r\n\r\n\t\tchain := []string{}\r\n\t\tqueue := []string{root}\r\n\t\tvisited := map[string]bool{}\r\n\t\tfor len(queue) > 0 {\r\n"]
[5472.120965, "o", "\t\t\tcur := queue[0]\r\n\t\t\tqueue = queue[1:]\r\n\t\t\tif visited[cur] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvisited[cur] = true\r\n\t\t\tnode, ok := byHash[cur]\r\n"]
[5472.121014, "o", "\t\t\tif !ok || node == nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tchain = append(chain, node.Filename)\r\n\t\t\tqueue = append(queue, children[cur]...)\r\n\t\t}\r\n\t"]
[5472.121063, "o", "\tsort.Strings(chain)\r\n\r\n\t\thashes := map[string]struct{}{}\r\n\t\tfor _, h := range chain {\r\n\t\t\tif node, ok := byHashFile(cps, h); ok && node.Provenance != nil {\r\n\t\t\t\thashes[node.Provenance.DatasetHash] = struct{}{}\r\n\t\t\t"]
[5472.121116, "o", "}\r\n\t\t}\r\n\t\tif len(hashes) > 1 {\r\n\t\t\tunique := make([]string, 0, len(hashes))\r\n\t\t\tfor h := range hashes {\r\n\t\t\t\tunique = append(unique, h)\r\n\t\t\t}\r\n"]
[5472.121166, "o", "\t\t\tsort.Strings(unique)\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"dataset_hash_inconsistency\",\r\n\t\t\t\tSeverity: \"high\",\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"files\":  chain,\r\n"]
[5472.121216, "o", "\t\t\t\t\t\"hashes\": unique,\r\n\t\t\t\t},\r\n\t\t\t\tEvidence: map[string]interface{}{},\r\n\t\t\t\tSource:   chain[0],\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n"]
[5472.121266, "o", "\r\nfunc byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {\r\n\tfor _, cf := range cps {\r\n\t\tif cf.Filename == file {\r\n\t\t\treturn cf, true\r\n\t\t}\r\n\t}\r\n\treturn nil, false\r\n}\r\n"]
[5472.121314, "o", "\r\nfunc signatureDetails(path string) (bool, string) {\r\n\traw, err := os.ReadFile(path)\r\n\tif err != nil || len(raw) < 56 {\r\n\t\treturn false, \"\"\r\n\t}\r\n\tsigOff := binary.LittleEndian.Uint64(raw[32:40])\r\n\t"]
[5472.121367, "o", "if sigOff == 0 || int(sigOff) >= len(raw) || int(sigOff)+5 > len(raw) {\r\n\t\treturn false, \"\"\r\n\t}\r\n\toff := int(sigOff)\r\n\toff++ // algorithm\r\n\tsignerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n\tif off+signerLen+2 > len(raw) {\r\n\t\treturn false, \"\""]
[5472.121418, "o", "\r\n\t}\r\n"]
