[6670.947854, "o", "   144\tfunc detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n   145\t\tvar vals []float64\r\n   146\t\tvar idx []int\r\n   147\t\tfor i, e := range entries {\r\n   148\t\t\tif e.GradNorm != nil {\r\n   149\t\t\t\tvals = append(vals, *e.GradNorm)\r\n   150\t\t\t\tidx = append(idx, i)\r\n"]
[6670.947975, "o", "   151\t\t\t}\r\n   152\t\t}\r\n   153\t\tif len(vals) < 31 {\r\n   154\t\t\treturn nil\r\n   155\t\t}\r\n   156\t\tconst alpha = 0.1\r\n   157\t"]
[6670.94805, "o", "\tmean := vals[0]\r\n   158\t\tvariance := 0.0\r\n   159\t\tvar anomalies []types.Anomaly\r\n   160\t\tfor i := 1; i < len(vals); i++ {\r\n   161\t\t\tif i >= 30 {\r\n   162\t\t\t\tobserved := vals[i]\r\n   163\t\t\t\tstddev := math.Sqrt(variance)\r\n   164\t\t\t\tz := 0.0\r\n   165\t\t\t\tif stddev > 0 {\r\n   166\t\t\t\t\tz = (observed - mean) / stddev\r\n   167\t\t\t\t}\r\n   168\t\t\t\tif z > 2.5 {\r\n   169\t\t\t\t\tseverity := \"medium\"\r\n"]
[6670.948146, "o", "   170\t\t\t\t\tif z > 4.0 {\r\n   171\t\t\t\t\t\tseverity = \"high\"\r\n   172\t\t\t\t\t}\r\n   173\t\t\t\t\tep := entries[idx[i]].Epoch\r\n   174\t\t\t\t\tst := entries[idx[i]].Step\r\n   175\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   176\t\t\t\t\t\tType:     \"gradient_spike\",\r\n   177\t\t\t\t\t\tSeverity: severity,\r\n   178\t\t\t\t\t\tEpoch:    &ep,\r\n   179\t\t\t\t\t\tStep:     &st,\r\n   180\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   181\t\t\t\t\t\t\t\"observed\":    observed,\r\n   182\t\t\t\t\t\t\t\"ewma_mean\":   mean,\r\n   183\t\t\t\t\t\t\t\"ewma_stddev\": stddev,\r\n   184\t\t\t\t\t\t\t\"z_score\":     z,\r\n"]
[6670.948219, "o", "   185\t\t\t\t\t\t},\r\n   186\t\t\t\t\t\tEvidence: map[string]interface{}{\"window_values\": lastValues(vals[:i], 5)},\r\n   187\t\t\t\t\t\tSource:   firstSource(entries[idx[i]]),\r\n   188\t\t\t\t\t})\r\n"]
[6670.948293, "o", "   189\t\t\t\t}\r\n   190\t\t\t}\r\n   191\t\t\tprevMean := mean\r\n   192\t\t\tmean = (1-alpha)*mean + alpha*vals[i]\r\n   193\t\t\tvariance = (1-alpha)*variance + alpha*(vals[i]-prevMean)*(vals[i]-prevMean)\r\n   194\t\t}\r\n   195\t\treturn anomalies\r\n   196\t}\r\n   197\t\r\n   198\tfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n   199\t\tvar lossEntries []int\r\n   200\t\tfor i, e := range entries {\r\n   201\t\t\tif e.Loss != nil {\r\n   202\t\t\t\tlossEntries = append(lossEntries, i)\r\n   203\t\t\t}\r\n"]
[6670.94836, "o", "   204\t\t}\r\n   205\t\tif len(lossEntries) < 2 {\r\n   206\t\t\treturn nil\r\n   207\t\t}\r\n   208\t\tconst alpha = 0.05\r\n   209\t\temaLoss := *entries[lossEntries[0]].Loss\r\n   210\t\tvar anomalies []types.Anomaly\r\n"]
[6670.948431, "o", "   211\t\tfor i := 1; i < len(lossEntries); i++ {\r\n   212\t\t\tcurrentLoss := *entries[lossEntries[i]].Loss\r\n   213\t\t\tif math.Abs(emaLoss) > 1e-6 {\r\n   214\t\t\t\tratio := currentLoss / emaLoss\r\n   215\t\t\t\tif currentLoss > 2.0*emaLoss {\r\n   216\t\t\t\t\tseverity := \"high\"\r\n   217\t\t\t\t\tif ratio > 5.0 {\r\n   218\t\t\t\t\t\tseverity = \"critical\"\r\n   219\t\t\t\t\t}\r\n   220\t\t\t\t\tep := entries[lossEntries[i]].Epoch\r\n   221\t\t\t\t\tst := entries[lossEntries[i]].Step\r\n"]
[6670.948501, "o", "   222\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   223\t\t\t\t\t\tType:     \"loss_divergence\",\r\n   224\t\t\t\t\t\tSeverity: severity,\r\n   225\t\t\t\t\t\tEpoch:    &ep,\r\n   226\t\t\t\t\t\tStep:     &st,\r\n   227\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   228\t\t\t\t\t\t\t\"current_loss\": currentLoss,\r\n"]
[6670.94856, "o", "   229\t\t\t\t\t\t\t\"ema_loss\":     emaLoss,\r\n   230\t\t\t\t\t\t\t\"ratio\":        ratio,\r\n   231\t\t\t\t\t\t},\r\n   232\t\t\t\t\t\tEvidence: map[string]interface{}{\"window_values\": precedingLossValues(entries, lossEntries, i, 5)},\r\n   233\t\t\t\t\t\tSource:   firstSource(entries[lossEntries[i]]),\r\n   234\t\t\t\t\t})\r\n"]
[6670.948619, "o", "   235\t\t\t\t}\r\n   236\t\t\t}\r\n   237\t\t\temaLoss = (1-alpha)*emaLoss + alpha*currentLoss\r\n   238\t\t}\r\n   239\t\treturn anomalies\r\n   240\t}\r\n   241\t\r\n   242\tfunc detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n   243"]
[6670.948682, "o", "\t\tvar anomalies []types.Anomaly\r\n   244\t\tfor i := 1; i < len(entries); i++ {\r\n   245\t\t\tprev := entries[i-1]\r\n"]
