[7807.748714, "o", "\u001b[?2004l\r"]
[7807.752676, "o", "     1\t# Output Schemas\r\n     2\t\r\n     3\tAll commands output JSON to stdout. This document defines the exact JSON structure for each command.\r\n     4\t\r\n"]
[7807.752796, "o", "     5\t---\r\n     6\t\r\n     7\t## 1. Ingest Output\r\n     8\t\r\n     9\t```json\r\n    10\t{\r\n    11\t  \"status\": \"ok\",\r\n    12\t  \"evidence_dir\": \"/path/to/evidence\",\r\n    13\t  \"artifacts\": {\r\n    14\t    \"checkpoints\": [\r\n    15\t      {\r\n    16\t        \"file\": \"model_epoch1.mlck\",\r\n    17\t        \"file_hash\": \"a1b2c3...\",\r\n    18\t        \"version\": 1,\r\n    19\t        \"num_tensors\": 12,\r\n    20\t        \"num_metadata\": 3,\r\n    21\t        \"signed\": false,\r\n    22\t        \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n    23\t        \"provenance\": {\r\n    24\t          \"epoch\": 1,\r\n    25"]
[7807.752882, "o", "\t          \"global_step\": 5000,\r\n    26\t          \"framework\": \"PyTorch\",\r\n    27\t          \"framework_version\": \"2.1.0\",\r\n    28\t          \"parent_hash\": \"\"\r\n    29\t        }\r\n    30\t      }\r\n    31\t    ],\r\n    32\t    \"log_shards\": [\r\n    33\t      {\r\n    34\t        \"file\": \"shard_001.jsonl\",\r\n    35\t        \"entries\": 500,\r\n    36\t        \"step_range\": [0, 5000],\r\n"]
