[2765.470622, "o", "sed -n '1,560p' internal/forensics/forensics.go\r\n\u001b[?2004l\r"]
[2765.473524, "o", "package forensics\r\n\r\nimport (\r\n\t\"crypto/hmac\"\r\n\t\"crypto/sha256\"\r\n"]
[2765.473639, "o", "\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"mlforge/internal/checkpoint\"\r\n\t\"mlforge/internal/logparser\"\r\n\t\"mlforge/internal/types\"\r\n)\r\n\r\ntype ArtifactPaths struct {\r\n\tCheckpoints []string\r\n\tLogs        []string\r\n\tConfigs     []string\r\n}\r\n\r\nfunc DiscoverArtifacts(dir string) (ArtifactPaths, error) {\r\n\tvar ap ArtifactPaths\r\n\terr := filepath.WalkDir(dir, func(path string, d os.DirEntry, err error) error {\r\n\t"]
[2765.473738, "o", "\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t\tif d.IsDir() {\r\n\t\t\treturn nil\r\n\t\t}\r\n\t\tname := d.Name()\r\n\t\tlower := strings.ToLower(name)\r\n\t\tswitch {\r\n\t\tcase strings.HasSuffix(lower, \".mlck\"):\r\n\t\t\tap.Checkpoints = append(ap.Checkpoints, path)\r\n\t\tcase strings.HasSuffix(lower, \".jsonl\"):\r\n\t\t\t"]
[2765.473817, "o", "ap.Logs = append(ap.Logs, path)\r\n\t\tcase strings.HasPrefix(name, \"config_\") && strings.HasSuffix(lower, \".json\"):\r\n\t\t\tap.Configs = append(ap.Configs, path)\r\n\t\t}\r\n\t\treturn nil\r\n\t})\r\n\tif err != nil {\r\n\t\treturn ap, err\r\n\t}\r\n\tsort.Strings(ap.Checkpoints)\r\n\tsort.Strings(ap.Logs)\r\n"]
[2765.473903, "o", "\tsort.Strings(ap.Configs)\r\n\treturn ap, nil\r\n}\r\n\r\ntype IngestCheckpoint struct {\r\n\tFile              string                 `json:\"file\"`\r\n\tFileHash          string                 `json:\"file_hash\"`\r\n\tVersion           uint32                 `json:\"version\"`\r\n\tNumTensors        uint32                 `json:\"num_tensors\"`\r\n\tNumMetadata       uint32                 `json:\"num_metadata\"`\r\n\tSigned            bool                   `json:\"signed\"`\r\n\tCreationTimestamp string                 `json:\"creation_timestamp\"`\r\n\tProvenance        map[string]interface{} `json:\"provenance\"`\r\n}\r\n\r\ntype IngestLogShard struct {\r\n"]
[2765.474002, "o", "\tFile       string   `json:\"file\"`\r\n\tEntries    int      `json:\"entries\"`\r\n\tStepRange  []int    `json:\"step_range\"`\r\n\tEpochRange []int    `json:\"epoch_range\"`\r\n\tTimeRange  []string `json:\"time_range\"`\r\n}\r\n"]
[2765.474087, "o", "\r\ntype IngestConfig struct {\r\n\tFile      string `json:\"file\"`\r\n\tModelName string `json:\"model_name\"`\r\n\tDataset   string `json:\"dataset\"`\r\n}\r\n\r\ntype IngestOutput struct {\r\n\tStatus      string `json:\"status\"`\r\n\tEvidenceDir string `json:\"evidence_dir\"`\r\n\tArtifacts   struct {\r\n\t\tCheckpoints []IngestCheckpoint `json:\"checkpoints\"`\r\n\t\tLogShards   []IngestLogShard   `json:\"log_shards\"`\r\n\t\tConfigs     []IngestConfig     `json:\"configs\"`\r\n\t} `json:\"artifacts\"`\r\n\tTotals struct {\r\n\t\tCheckpoints int `json:\"checkpoints\"`\r\n\t\tLogShards   int `json:\"log_shards\"`\r\n\t\tConfigs     int `json:\"configs\"`\r\n\t} `json:\"totals\"`\r\n}\r\n\r\nfunc BuildIngest(dir string) (interface{}, error) {\r\n\tap, err := DiscoverArtifacts(dir)\r\n"]
[2765.474155, "o", "\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif len(ap.Checkpoints) == 0 && len(ap.Logs) == 0 && len(ap.Configs) == 0 {\r\n\t\treturn nil, fmt.Errorf(\"no recognizable artifacts found in %s\", dir)\r\n\t}\r\n\r\n\tvar out IngestOutput\r\n\tout.Status = \"ok\"\r\n\tout.EvidenceDir = dir\r\n\tout.Artifacts.Checkpoints = []IngestCheckpoint{}\r\n\tout.Artifacts.LogShards = []IngestLogShard{}\r\n"]
[2765.474215, "o", "\tout.Artifacts.Configs = []IngestConfig{}\r\n\r\n\tfor _, p := range ap.Checkpoints {\r\n\t\tcf, err := checkpoint.Parse(p)\r\n\t\tif err != nil || cf == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tic := IngestCheckpoint{\r\n\t\t\tFile:              cf.Filename,\r\n\t\t\t"]
[2765.474272, "o", "FileHash:          cf.FileHash,\r\n\t\t\tVersion:           cf.Version,\r\n\t\t\tNumTensors:        cf.NumTensors,\r\n\t\t\tNumMetadata:       cf.NumMetadataKeys,\r\n\t\t\tSigned:            cf.Signed,\r\n\t\t\tCreationTimestamp: unixToISO(cf.CreationTimestamp),\r\n\t\t\tProvenance:        provenanceToMap(cf.Provenance),\r\n\t\t}\r\n"]
[2765.474335, "o", "\t\tout.Artifacts.Checkpoints = append(out.Artifacts.Checkpoints, ic)\r\n\t}\r\n\tsort.Slice(out.Artifacts.Checkpoints, func(i, j int) bool {\r\n\t\treturn out.Artifacts.Checkpoints[i].CreationTimestamp < out.Artifacts.Checkpoints[j].CreationTimestamp\r\n\t})\r\n\r\n\tfor _, p := range ap.Logs {\r\n\t\tinfo, entries, err := parseShardRecursive(p)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n"]
[2765.474395, "o", "\t\t}\r\n\t\tshard := IngestLogShard{\r\n\t\t\tFile:    info.File,\r\n\t\t\tEntries: info.Entries,\r\n\t\t}\r\n\t\tif info.Entries > 0 {\r\n\t\t\tshard.StepRange = []int{info.MinStep, info.MaxStep}\r\n\t\t\tshard.EpochRange = []int{info.MinEpoch, info.MaxEpoch}\r\n"]
[2765.474455, "o", "\t\t\tif info.MinTs != \"\" || info.MaxTs != \"\" {\r\n\t\t\t\tshard.TimeRange = []string{info.MinTs, info.MaxTs}\r\n\t\t\t}\r\n\t\t}\r\n\t\t_ = entries\r\n\t\tout.Artifacts.LogShards = append(out.Artifacts.LogShards, shard)\r\n\t}\r\n\tsort.Slice(out.Artifacts.LogShards, func(i, j int) bool {\r\n\t\treturn out.Artifacts.LogShards[i].File < out.Artifacts.LogShards[j].File\r\n"]
[2765.474536, "o", "\t})\r\n\r\n\tfor _, p := range ap.Configs {\r\n\t\tcfg, err := readConfigSummary(p)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tout.Artifacts.Configs = append(out.Artifacts.Configs, cfg)\r\n\t}\r\n\tsort.Slice(out.Artifacts.Configs, func(i, j int) bool {\r\n\t\treturn out.Artifacts.Configs[i].File < out.Artifacts.Configs[j].File\r\n\t})\r\n\r\n"]
[2765.474595, "o", "\tout.Totals.Checkpoints = len(out.Artifacts.Checkpoints)\r\n\tout.Totals.LogShards = len(out.Artifacts.LogShards)\r\n\tout.Totals.Configs = len(out.Artifacts.Configs)\r\n\treturn out, nil\r\n}\r\n\r\ntype TimelineGap struct {\r\n\tAfterStep  int    `json:\"after_step\"`\r\n\tBeforeStep int    `json:\"before_step\"`\r\n\tEpoch      int    `json:\"epoch\"`\r\n\tGapSteps   int    `json:\"gap_steps\"`\r\n"]
[2765.474653, "o", "\tAfterTs    string `json:\"after_ts\"`\r\n\tBeforeTs   string `json:\"before_ts\"`\r\n}\r\n\r\ntype TimelineOutput struct {\r\n\tStatus            string                `json:\"status\"`\r\n\tTotalEntries      int                   `json:\"total_entries\"`\r\n\tTotalEpochs       int                   `json:\"total_epochs\"`\r\n\tStepRange         []int                 `json:\"step_range\"`\r\n"]
[2765.474723, "o", "\tTimeRange         []string              `json:\"time_range\"`\r\n\tConflictsResolved int                   `json:\"conflicts_resolved\"`\r\n\tGaps              []TimelineGap         `json:\"gaps\"`\r\n\tEntries           []types.TimelineEntry `json:\"entries\"`\r\n}\r\n\r\nfunc BuildTimeline(dir string) (interface{}, error) {\r\n\tentries, shards, err := loadTimelineEntries(dir)\r\n"]
[2765.474788, "o", "\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn buildTimelineFromEntries(entries, shards), nil\r\n}\r\n\r\nfunc buildTimelineFromEntries(entries []types.TimelineEntry, shards []logparser.ShardInfo) TimelineOutput {\r\n\tmerged, conflicts := mergeTimeline(entries)\r\n\tsortTimeline(merged)\r\n\tgaps := detectGaps(merged)\r\n\r\n\tout := TimelineOutput{\r\n\t\tStatus:            \"ok\",\r\n\t\tTotalEntries:      len(merged),\r\n\t\tConflictsResolved: conflicts,\r\n\t\tGaps:              gaps,\r\n\t\tEntries:           merged,\r\n\t"]
[2765.47485, "o", "}\r\n\tif len(merged) > 0 {\r\n\t\tminStep, maxStep := merged[0].Step, merged[0].Step\r\n\t\tminTs, maxTs := merged[0].Ts, merged[0].Ts\r\n\t\tepochSet := map[int]struct{}{}\r\n\t\tfor _, e := range merged {\r\n\t\t\tepochSet[e.Epoch] = struct{}{}\r\n\t\t\tif e.Step < minStep {\r\n"]
[2765.474908, "o", "\t\t\t\tminStep = e.Step\r\n\t\t\t}\r\n\t\t\tif e.Step > maxStep {\r\n\t\t\t\tmaxStep = e.Step\r\n\t\t\t}\r\n\t\t\tif e.Ts < minTs {\r\n\t\t\t\tminTs = e.Ts\r\n\t\t\t}\r\n\t"]
[2765.474987, "o", "\t\tif e.Ts > maxTs {\r\n\t\t\t\tmaxTs = e.Ts\r\n\t\t\t}\r\n\t\t}\r\n\t\tout.TotalEpochs = len(epochSet)\r\n\t\tout.StepRange = []int{minStep, maxStep}\r\n\t\tout.TimeRange = []string{minTs, maxTs}\r\n\t}\r\n\tif out.Gaps == nil {\r\n\t\tout.Gaps = []TimelineGap{}\r\n\t}\r\n"]
[2765.475053, "o", "\tif out.Entries == nil {\r\n\t\tout.Entries = []types.TimelineEntry{}\r\n\t}\r\n\treturn out\r\n}\r\n\r\ntype VerifyIssue struct {\r\n\tType   string `json:\"type\"`\r\n\tDetail string `json:\"detail\"`\r\n}\r\n\r\ntype VerifyCheckpoint struct {\r\n\tFile                 string        `json:\"file\"`\r\n\tValid                bool          `json:\"valid\"`\r\n"]
[2765.475117, "o", "\tHeaderChecksumValid  bool          `json:\"header_checksum_valid\"`\r\n\tTensorChecksumsValid bool          `json:\"tensor_checksums_valid\"`\r\n\tSignatureValid       *bool         `json:\"signature_valid\"`\r\n\tProvenanceValid      bool          `json:\"provenance_valid\"`\r\n\tIssues               []VerifyIssue `json:\"issues\"`\r\n}\r\n\r\ntype VerifyOutput struct {\r\n\tStatus      string             `json:\"status\"`\r\n\tCheckpoints []VerifyCheckpoint `json:\"checkpoints\"`\r\n"]
[2765.475175, "o", "\tSummary     struct {\r\n\t\tTotal   int `json:\"total\"`\r\n\t\tValid   int `json:\"valid\"`\r\n\t\tInvalid int `json:\"invalid\"`\r\n\t} `json:\"summary\"`\r\n}\r\n\r\nfunc BuildVerify(dir string) (interface{}, error) {\r\n\tap, err := DiscoverArtifacts(dir)\r\n\tif err != nil {\r\n"]
[2765.475233, "o", "\t\treturn nil, err\r\n\t}\r\n\tif len(ap.Checkpoints) == 0 {\r\n\t\treturn nil, fmt.Errorf(\"no checkpoint files found\")\r\n\t}\r\n\tvar out VerifyOutput\r\n\tout.Status = \"ok\"\r\n\tfor _, p := range ap.Checkpoints {\r\n"]
[2765.475297, "o", "\t\tvc := verifyCheckpoint(p)\r\n\t\tout.Checkpoints = append(out.Checkpoints, vc)\r\n\t}\r\n\tsort.Slice(out.Checkpoints, func(i, j int) bool {\r\n\t\treturn out.Checkpoints[i].File < out.Checkpoints[j].File\r\n\t})\r\n"]
[2765.475355, "o", "\tout.Summary.Total = len(out.Checkpoints)\r\n\tfor _, c := range out.Checkpoints {\r\n\t\tif c.Valid {\r\n\t\t\tout.Summary.Valid++\r\n\t\t} else {\r\n\t\t\tout.Summary.Invalid++\r\n\t\t}\r\n\t}\r\n\treturn out, nil\r\n}\r\n\r\nfunc verifyCheckpoint(path string) VerifyCheckpoint {\r\n\tvc := VerifyCheckpoint{\r\n\t\tFile:   filepath.Base(path),\r\n\t\tIssues: []VerifyIssue{},\r\n\t}\r\n"]
[2765.475397, "o", "\tcf, err := checkpoint.Parse(path)\r\n\tif err != nil || cf == nil {\r\n\t\tvc.HeaderChecksumValid = false\r\n\t\tvc.TensorChecksumsValid = false\r\n\t\tvc.ProvenanceValid = false\r\n\t\tvc.Valid = false\r\n"]
[2765.475482, "o", "\t\tdetail := \"unknown parse error\"\r\n\t\tif err != nil {\r\n\t\t\tdetail = err.Error()\r\n\t\t}\r\n\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"parse_error\", Detail: detail})\r\n\t\treturn vc\r\n\t}\r\n\tvc.HeaderChecksumValid = cf.HeaderValid\r\n\tif !cf.HeaderValid {\r\n\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"header_checksum_mismatch\", Detail: \"\"})\r\n\t}\r\n\tvc.TensorChecksumsValid = true\r\n\tfor _, t := range cf.Tensors {\r\n\t\tif !t.Valid {\r\n"]
[2765.47554, "o", "\t\t\tvc.TensorChecksumsValid = false\r\n\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"tensor_checksum_mismatch\", Detail: t.Name})\r\n\t\t}\r\n\t}\r\n\tif cf.Signed {\r\n\t\tvalid, _ := validateSignature(path)\r\n\t\tvc.SignatureValid = &valid\r\n\t\tif !valid {\r\n\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"signature_invalid\", Detail: \"\"})\r\n"]
[2765.475605, "o", "\t\t}\r\n\t}\r\n\tvc.ProvenanceValid = validateProvenance(cf)\r\n\tif !vc.ProvenanceValid {\r\n\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"provenance_invalid\", Detail: \"\"})\r\n\t}\r\n\tvc.Valid = vc.HeaderChecksumValid && vc.TensorChecksumsValid && vc.ProvenanceValid && (!cf.Signed || (vc.SignatureValid != nil && *vc.SignatureValid))\r\n\treturn vc\r\n}\r\n\r\nfunc validateSignature(path string) (bool, error) {\r\n\traw, err := os.ReadFile(path)\r\n\tif err != nil || len(raw) < 56 {\r\n"]
[2765.475661, "o", "\t\treturn false, err\r\n\t}\r\n\tsigOff := binary.LittleEndian.Uint64(raw[32:40])\r\n\tif sigOff == 0 || int(sigOff) >= len(raw) {\r\n\t\treturn false, nil\r\n\t}\r\n\tif int(sigOff)+5 > len(raw) {\r\n"]
[2765.475726, "o", "\t\treturn false, nil\r\n\t}\r\n\toff := int(sigOff)\r\n\t_ = raw[off] // algorithm\r\n\toff++\r\n\t"]
[2765.475787, "o", "signerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n\tif off+signerLen+2 > len(raw) {\r\n\t\treturn false, nil\r\n\t}\r\n\tsignerID := string(raw[off : off+signerLen])\r\n\toff += signerLen\r\n\tsigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n\tif off+sigLen > len(raw) {\r\n\t\treturn false, nil\r\n\t}\r\n\tstoredSig := raw[off : off+sigLen]\r\n"]
[2765.475854, "o", "\tmac := hmac.New(sha256.New, []byte(signerID))\r\n\tmac.Write(raw[:sigOff])\r\n\texpected := mac.Sum(nil)\r\n\treturn hmac.Equal(expected, storedSig), nil\r\n}\r\n\r\nfunc validateProvenance(cf *types.CheckpointFile) bool {\r\n"]
[2765.475911, "o", "\tif cf.Provenance == nil {\r\n\t\treturn false\r\n\t}\r\n\tp := cf.Provenance\r\n\tif p.Framework == \"\" || p.FrameworkVersion == \"\" {\r\n\t\treturn false\r\n\t}\r\n\tif len(p.GitCommit) != 40 || !isHex(p.GitCommit) {\r\n\t\treturn false\r\n\t}\r\n\tif len(p.DatasetHash) != 64 || !isHex(p.DatasetHash) {\r\n\t\treturn false\r\n\t}\r\n\tif len(p.ConfigHash) != 64 || !isHex(p.ConfigHash) {\r\n\t\treturn false\r\n"]
[2765.475995, "o", "\t}\r\n\tif p.ParentHash != \"\" && (len(p.ParentHash) != 64 || !isHex(p.ParentHash)) {\r\n\t\treturn false\r\n\t}\r\n\treturn true\r\n}\r\n\r\n"]
[2765.476061, "o", "func isHex(s string) bool {\r\n\t_, err := hex.DecodeString(s)\r\n\treturn err == nil\r\n}\r\n\r\nfunc parseShardRecursive(path string) (logparser.ShardInfo, []types.TimelineEntry, error) {\r\n\treturn logparser.ParseShard(path, filepath.Base(path))\r\n}\r\n\r\nfunc loadTimelineEntries(dir string) ([]types.TimelineEntry, []logparser.ShardInfo, error) {\r\n\tap, err := DiscoverArtifacts(dir)\r\n\tif err != nil {\r\n\t\treturn nil, nil, err\r\n\t}\r\n\tif len(ap.Logs) == 0 {\r\n\t\t"]
[2765.476126, "o", "return nil, nil, fmt.Errorf(\"no log shard files found\")\r\n\t}\r\n\tvar allEntries []types.TimelineEntry\r\n\tvar shards []logparser.ShardInfo\r\n\tfor _, p := range ap.Logs {\r\n\t\tinfo, entries, err := parseShardRecursive(p)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\t"]
[2765.476187, "o", "shards = append(shards, info)\r\n\t\tallEntries = append(allEntries, entries...)\r\n\t}\r\n\tif len(allEntries) == 0 {\r\n\t\treturn nil, shards, fmt.Errorf(\"no log entries found\")\r\n\t}\r\n\treturn allEntries, shards, nil\r\n}\r\n\r\nfunc mergeTimeline(entries []types.TimelineEntry) ([]types.TimelineEntry, int) {\r\n\ttype agg struct {\r\n"]
[2765.476251, "o", "\t\tentry    types.TimelineEntry\r\n\t\tsources  map[string]struct{}\r\n\t\tconflict bool\r\n\t}\r\n\tm := map[string]*agg{}\r\n\tfor _, e := range entries {\r\n\t\tkey := fmt.Sprintf(\"%d:%d\", e.Epoch, e.Step)\r\n\t\ta, ok := m[key]\r\n\t\tif !ok {\r\n\t"]
[2765.476307, "o", "\t\tsrc := map[string]struct{}{}\r\n\t\t\tfor _, s := range e.Sources {\r\n\t\t\t\tsrc[s] = struct{}{}\r\n\t\t\t}\r\n\t\t\tm[key] = &agg{entry: e, sources: src}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfor _, s := range e.Sources {\r\n\t"]
[2765.476363, "o", "\t\ta.sources[s] = struct{}{}\r\n\t\t}\r\n\t\tif metricsEqual(a.entry, e) {\r\n\t\t\tif e.Ts > a.entry.Ts {\r\n\t\t\t\ta.entry = e\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t"]
[2765.47642, "o", "}\r\n\t\ta.conflict = true\r\n\t\tif e.Ts > a.entry.Ts {\r\n\t\t\ta.entry = e\r\n\t\t}\r\n\t}\r\n\tresult := make([]types.TimelineEntry, 0, len(m))\r\n\tconflicts := 0\r\n\tfor _, a := range m {\r\n\t"]
[2765.47648, "o", "\te := a.entry\r\n\t\tsrcs := make([]string, 0, len(a.sources))\r\n\t\tfor s := range a.sources {\r\n\t\t\tsrcs = append(srcs, s)\r\n\t\t}\r\n\t\tsort.Strings(srcs)\r\n\t\te.Sources = srcs\r\n\t\te.Conflict = a.conflict\r\n\t\tif a.conflict {\r\n\t"]
[2765.476542, "o", "\t\tconflicts++\r\n\t\t}\r\n\t\tresult = append(result, e)\r\n\t}\r\n\treturn result, conflicts\r\n}\r\n\r\nfunc metricsEqual(a, b types.TimelineEntry) bool {\r\n\treturn floatPtrEqual(a.Loss, b.Loss) &&\r\n\t\tfloatPtrEqual(a.Lr, b.Lr) &&\r\n\t\tfloatPtrEqual(a.GradNorm, b.GradNorm) &&\r\n"]
[2765.476599, "o", "\t\tfloatPtrEqual(a.Acc, b.Acc)\r\n}\r\n\r\nfunc floatPtrEqual(a, b *float64) bool {\r\n\tif a == nil || b == nil {\r\n\t\treturn a == b\r\n\t}\r\n\treturn math.Abs(*a-*b) <= 1e-9\r\n}\r\n\r\nfunc sortTimeline(entries []types.TimelineEntry) {\r\n\tsort.Slice(entries, func(i, j int) bool {\r\n\t\t"]
[2765.476661, "o", "if entries[i].Epoch != entries[j].Epoch {\r\n\t\t\treturn entries[i].Epoch < entries[j].Epoch\r\n\t\t}\r\n\t\treturn entries[i].Step < entries[j].Step\r\n\t})\r\n}\r\n\r\nfunc detectGaps(entries []types.TimelineEntry) []TimelineGap {\r\n\tvar gaps []TimelineGap\r\n\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n"]
[2765.476732, "o", "\t\tcur := entries[i]\r\n\t\tif prev.Epoch != cur.Epoch {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tdiff := cur.Step - prev.Step\r\n\t\tif diff > 50 {\r\n\t\t\tgaps = append(gaps, TimelineGap{\r\n\t\t\t\tAfterStep:  prev.Step,\r\n\t\t\t\tBeforeStep: cur.Step,\r\n\t\t\t\tEpoch:      prev.Epoch,\r\n"]
[2765.476793, "o", "\t\t\t\tGapSteps:   diff,\r\n\t\t\t\tAfterTs:    prev.Ts,\r\n\t\t\t\tBeforeTs:   cur.Ts,\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn gaps\r\n}\r\n\r\nfunc readConfigSummary(path string) (IngestConfig, error) {\r\n\traw, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn IngestConfig{}, err\r\n"]
[2765.476861, "o", "\t}\r\n\tvar cfg struct {\r\n\t\tModelName string `json:\"model_name\"`\r\n\t\tDataset   string `json:\"dataset\"`\r\n\t}\r\n\tif err := json.Unmarshal(raw, &cfg); err != nil {\r\n\t\treturn IngestConfig{}, err\r\n\t}\r\n\treturn IngestConfig{File: filepath.Base(path), ModelName: cfg.ModelName, Dataset: cfg.Dataset}, nil\r\n}\r\n"]
[2765.47693, "o", "\r\nfunc provenanceToMap(p *types.Provenance) map[string]interface{} {\r\n\tif p == nil {\r\n\t\treturn map[string]interface{}{}\r\n\t}\r\n\treturn map[string]interface{}{\r\n\t\t\"epoch\":             p.Epoch,\r\n\t\t\"global_step\":       p.GlobalStep,\r\n"]
[2765.477005, "o", "\t\t\"framework\":         p.Framework,\r\n\t\t\"framework_version\": p.FrameworkVersion,\r\n\t\t\"parent_hash\":       p.ParentHash,\r\n\t}\r\n}\r\n\r\nfunc unixToISO(ts int64) string {\r\n\treturn time.Unix(ts, 0).UTC().Format(time.RFC3339)\r\n"]
[2765.477401, "o", "\u001b[?2004hroot@n30009:/app# "]
[2765.774304, "i", "sed -n '1,380p' internal/checkpoint/parser.go\n"]
[2765.774565, "o", "sed -n '1,380p' internal/checkpoint/parser.go\r\n\u001b[?2004l\r"]
[2765.777857, "o", "package checkpoint\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n\t\"fmt\"\r\n\t\"hash/fnv\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\r\n\t\"mlforge/internal/types\"\r\n"]
[2765.778033, "o", ")\r\n\r\nconst (\r\n\tmagicMLCK  = \"MLCK\"\r\n\theaderSize = 56\r\n)\r\n\r\n// Parse reads and validates a single .mlck checkpoint file according to the\r\n// MLCK binary format specification (see /app/docs/formats.md).\r\nfunc Parse(path string) (*types.CheckpointFile, error) {\r\n\traw, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: read %s: %w\", path, err)\r\n\t}\r\n\tif len(raw) < headerSize {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: file too small (%d bytes)\", len(raw))\r\n\t}\r\n\r\n\t// --- magic (offset 0, 4 bytes) ---\r\n\tif string(raw[0:4]) != magicMLCK {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: bad magic %q\", raw[0:4])\r\n\t}\r\n\r\n\t// --- header fields ---\r\n\tversion := binary.LittleEndian.Uint16(raw[4:6])\r\n\t"]
[2765.778133, "o", "flags := binary.LittleEndian.Uint16(raw[6:8])\r\n\tnumTensors := binary.LittleEndian.Uint32(raw[8:12])\r\n\tnumMetadata := binary.LittleEndian.Uint32(raw[12:16])\r\n\tmetadataOffset := binary.LittleEndian.Uint64(raw[16:24])\r\n\tprovenanceOffset := binary.LittleEndian.Uint64(raw[24:32])\r\n\t_ = binary.LittleEndian.Uint64(raw[32:40]) // signatureOffset (unused for now)\r\n\tcreationTimestamp := int64(binary.LittleEndian.Uint64(raw[40:48]))\r\n\tstoredChecksum := binary.LittleEndian.Uint64(raw[48:56])\r\n\r\n\t// --- verify header checksum: FNV-1a of bytes [0..48) ---\r\n\th := fnv.New64a()\r\n\th.Write(raw[:48])\r\n\tcomputedChecksum := h.Sum64()\r\n\theaderValid := computedChecksum == storedChecksum\r\n\r\n\t// --- SHA-256 file hash ---\r\n\t"]
[2765.778211, "o", "fileHashBytes := sha256.Sum256(raw)\r\n\tfileHash := hex.EncodeToString(fileHashBytes[:])\r\n\r\n\tsigned := flags&1 != 0\r\n\r\n\tcf := &types.CheckpointFile{\r\n\t\tPath:              path,\r\n"]
[2765.778287, "o", "\t\tFilename:          filepath.Base(path),\r\n\t\tVersion:           uint32(version),\r\n\t\tFlags:             flags,\r\n\t\tNumTensors:        numTensors,\r\n\t\tNumMetadataKeys:   numMetadata,\r\n\t\tCreationTimestamp:  creationTimestamp,\r\n\t\tHeaderValid:       headerValid,\r\n\t\tFileHash:          fileHash,\r\n"]
[2765.77837, "o", "\t\tSigned:            signed,\r\n\t}\r\n\r\n\t// --- parse tensor blocks (start at offset 56) ---\r\n\toff := headerSize\r\n\ttensors := make([]types.TensorInfo, 0, numTensors)\r\n\tfor i := uint32(0); i < numTensors; i++ {\r\n\t\tti, newOff, err := parseTensor(raw, off, i)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\ttensors = append(tensors, ti)\r\n\t\toff = newOff\r\n\t}\r\n\tcf.Tensors = tensors\r\n\r\n\t// --- parse metadata section ---\r\n"]
[2765.778454, "o", "\tif numMetadata > 0 && metadataOffset > 0 && int(metadataOffset) < len(raw) {\r\n\t\tmd, err := parseMetadata(raw, int(metadataOffset), numMetadata)\r\n\t\tif err == nil {\r\n\t\t\tcf.MetadataMap = md\r\n\t\t}\r\n\t}\r\n\r\n\t// --- parse provenance section ---\r\n\tif provenanceOffset > 0 && int(provenanceOffset) < len(raw) {\r\n\t\tprov, err := parseProvenance(raw, int(provenanceOffset))\r\n\t\tif err == nil {\r\n\t\t\tcf.Provenance = prov\r\n\t\t\t"]
[2765.778526, "o", "cf.HasParent = prov.ParentHash != \"\"\r\n\t\t\tcf.ParentHex = prov.ParentHash\r\n\t\t}\r\n\t}\r\n\r\n\treturn cf, nil\r\n}\r\n\r\n// parseTensor parses one tensor block starting at off and returns the\r\n// TensorInfo plus the new offset after the block.\r\nfunc parseTensor(raw []byte, off int, idx uint32) (types.TensorInfo, int, error) {\r\n\tfail := func(msg string) (types.TensorInfo, int, error) {\r\n\t\treturn types.TensorInfo{}, 0, fmt.Errorf(\"checkpoint: tensor %d: %s\", idx, msg)\r\n"]
[2765.778594, "o", "\t}\r\n\r\n\t// name_len (uint16 LE)\r\n\tif off+2 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading name_len\")\r\n\t}\r\n\tnameLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n\r\n\t// name\r\n\tif off+nameLen > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading name\")\r\n\t}\r\n"]
[2765.77867, "o", "\tname := string(raw[off : off+nameLen])\r\n\toff += nameLen\r\n\r\n\t// dtype (1 byte)\r\n\tif off+1 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading dtype\")\r\n\t}\r\n\t"]
[2765.778739, "o", "dtype := raw[off]\r\n\toff++\r\n\r\n\t// num_dims (1 byte)\r\n\tif off+1 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading num_dims\")\r\n\t}\r\n\tnumDims := int(raw[off])\r\n\toff++\r\n\r\n\t// shape (num_dims * uint32 LE)\r\n\tshapeBytes := numDims * 4\r\n\tif off+shapeBytes > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading shape\")\r\n\t}\r\n\tshape := make([]uint32, numDims)\r\n\tfor d := 0; d < numDims; d++ {\r\n"]
[2765.778808, "o", "\t\tshape[d] = binary.LittleEndian.Uint32(raw[off : off+4])\r\n\t\toff += 4\r\n\t}\r\n\r\n\t// data_size (uint64 LE)\r\n\tif off+8 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading data_size\")\r\n\t}\r\n\tdataSize := binary.LittleEndian.Uint64(raw[off : off+8])\r\n\toff += 8\r\n\r\n\t"]
[2765.778877, "o", "// data\r\n\tif off+int(dataSize) > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading data\")\r\n\t}\r\n\tdata := raw[off : off+int(dataSize)]\r\n\toff += int(dataSize)\r\n\r\n\t// hash (32 bytes SHA-256)\r\n\tif off+32 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading hash\")\r\n\t}\r\n"]
[2765.778958, "o", "\tvar storedHash [32]byte\r\n\tcopy(storedHash[:], raw[off:off+32])\r\n\toff += 32\r\n\r\n\t// verify SHA-256\r\n\tcomputedHash := sha256.Sum256(data)\r\n\tvalid := computedHash == storedHash\r\n\r\n\treturn types.TensorInfo{\r\n\t\tName:  name,\r\n\t\tDtype: dtype,\r\n"]
[2765.779058, "o", "\t\tShape: shape,\r\n\t\tData:  data,\r\n\t\tHash:  storedHash,\r\n\t\tValid: valid,\r\n\t}, off, nil\r\n}\r\n\r\n// parseMetadata parses the metadata section: numMeta key-value pairs.\r\nfunc parseMetadata(raw []byte, off int, numMeta uint32) (map[string]string, error) {\r\n\tmd := make(map[string]string, numMeta)\r\n\tfor i := uint32(0); i < numMeta; i++ {\r\n\t\t// key_len (uint16)\r\n\t\tif off+2 > len(raw) {\r\n\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at key_len %d\", i)\r\n\t\t}\r\n"]
[2765.779132, "o", "\t\tkeyLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\t\toff += 2\r\n\r\n\t\tif off+keyLen > len(raw) {\r\n\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at key %d\", i)\r\n\t\t}\r\n\t\tkey := string(raw[off : off+keyLen])\r\n"]
[2765.779207, "o", "\t\toff += keyLen\r\n\r\n\t\t// value_len (uint32)\r\n\t\tif off+4 > len(raw) {\r\n\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at value_len %d\", i)\r\n\t\t}\r\n\t\tvalLen := int(binary.LittleEndian.Uint32(raw[off : off+4]))\r\n\t\toff += 4\r\n\r\n\t\tif off+valLen > len(raw) {\r\n\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at value %d\", i)\r\n\t\t}\r\n\t\tval := string(raw[off : off+valLen])\r\n\t\toff += valLen\r\n\r\n\t\tmd[key] = val\r\n\t}\r\n\treturn md, nil\r\n"]
[2765.779279, "o", "}\r\n\r\n// parseProvenance parses the provenance section.\r\nfunc parseProvenance(raw []byte, off int) (*types.Provenance, error) {\r\n\tp := &types.Provenance{}\r\n\r\n\t// GitCommit: 40 bytes ASCII\r\n\tif off+40 > len(raw) {\r\n"]
[2765.779349, "o", "\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at git_commit\")\r\n\t}\r\n\tp.GitCommit = strings.TrimRight(string(raw[off:off+40]), \"\\x00\")\r\n\toff += 40\r\n\r\n\t// DatasetHash: 32 bytes raw → hex\r\n\tif off+32 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at dataset_hash\")\r\n\t}\r\n\tp.DatasetHash = hex.EncodeToString(raw[off : off+32])\r\n\toff += 32\r\n\r\n\t// ConfigHash: 32 bytes raw → hex\r\n\tif off+32 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at config_hash\")\r\n\t}\r\n\tp.ConfigHash = hex.EncodeToString(raw[off : off+32])\r\n\toff += 32\r\n"]
[2765.779423, "o", "\r\n\t// TrainingTimestamp: int64\r\n\tif off+8 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at training_timestamp\")\r\n\t}\r\n\tp.TrainingTimestamp = int64(binary.LittleEndian.Uint64(raw[off : off+8]))\r\n\toff += 8\r\n"]
[2765.779496, "o", "\r\n\t// TrainingDuration: float64\r\n\tif off+8 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at training_duration\")\r\n\t}\r\n\tp.TrainingDuration = math.Float64frombits(binary.LittleEndian.Uint64(raw[off : off+8]))\r\n\toff += 8\r\n\r\n\t// Framework: uint16 len + bytes\r\n\tif off+2 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at framework_len\")\r\n\t}\r\n\tfwLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\t"]
[2765.779567, "o", "off += 2\r\n\tif off+fwLen > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at framework\")\r\n\t}\r\n\tp.Framework = string(raw[off : off+fwLen])\r\n\toff += fwLen\r\n\r\n\t// FrameworkVersion: uint16 len + bytes\r\n\tif off+2 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at framework_version_len\")\r\n\t}\r\n\tfvLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n\tif off+fvLen > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at framework_version\")\r\n\t}\r\n\tp.FrameworkVersion = string(raw[off : off+fvLen])\r\n"]
[2765.77964, "o", "\toff += fvLen\r\n\r\n\t// Epoch: uint32\r\n\tif off+4 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at epoch\")\r\n\t}\r\n\tp.Epoch = binary.LittleEndian.Uint32(raw[off : off+4])\r\n\toff += 4\r\n\r\n\t// GlobalStep: uint64\r\n\tif off+8 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at global_step\")\r\n\t}\r\n\tp.GlobalStep = binary.LittleEndian.Uint64(raw[off : off+8])\r\n\toff += 8\r\n"]
[2765.779712, "o", "\r\n\t// LearningRate: float64\r\n\tif off+8 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at learning_rate\")\r\n\t}\r\n\tp.LearningRate = math.Float64frombits(binary.LittleEndian.Uint64(raw[off : off+8]))\r\n\toff += 8\r\n\r\n\t// ParentHash: uint16 len + bytes (ASCII hex SHA-256 of parent file)\r\n\tif off+2 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at parent_hash_len\")\r\n\t}\r\n"]
[2765.779781, "o", "\tphLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n\tif phLen > 0 {\r\n\t\tif off+phLen > len(raw) {\r\n\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at parent_hash\")\r\n\t\t}\r\n\t\tp.ParentHash = string(raw[off : off+phLen])\r\n\t\toff += phLen\r\n\t}\r\n\r\n\treturn p, nil\r\n}\r\n"]
[2765.779877, "o", "\r\n// ParseAll finds and parses every .mlck file in the given directory\r\n// (non-recursive). Files are returned in lexicographic order by filename.\r\nfunc ParseAll(dir string) ([]*types.CheckpointFile, error) {\r\n\tentries, err := os.ReadDir(dir)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: read dir %s: %w\", dir, err)\r\n\t}\r\n\r\n\tvar results []*types.CheckpointFile\r\n\tfor _, e := range entries {\r\n\t\tif e.IsDir() {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif !strings.HasSuffix(strings.ToLower(e.Name()), \".mlck\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[2765.779967, "o", "\t\tcf, err := Parse(filepath.Join(dir, e.Name()))\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tresults = append(results, cf)\r\n\t}\r\n\t"]
[2765.780037, "o", "return results, nil\r\n}\r\n"]
[2765.780377, "o", "\u001b[?2004hroot@n30009:/app# "]
[2766.067473, "i", "sed -n '1,160p' internal/types/types.go\n"]
[2766.067721, "o", "sed -n '1,160p' internal/types/types.go\r\n\u001b[?2004l\r"]
[2766.070538, "o", "package types\r\n\r\n// TimelineEntry represents one log entry from a JSONL shard.\r\ntype TimelineEntry struct {\r\n\tTs       string   `json:\"ts\"`\r\n\tEpoch    int      `json:\"epoch\"`\r\n"]
[2766.070649, "o", "\tStep     int      `json:\"step\"`\r\n\tLoss     *float64 `json:\"loss,omitempty\"`\r\n\tLr       *float64 `json:\"lr,omitempty\"`\r\n\tGradNorm *float64 `json:\"grad_norm,omitempty\"`\r\n\tAcc      *float64 `json:\"acc,omitempty\"`\r\n\tEvent    string   `json:\"event,omitempty\"`\r\n\tSources  []string `json:\"sources,omitempty\"`\r\n\tConflict bool     `json:\"conflict\"`\r\n}\r\n\r\n// Anomaly represents one detected anomaly in the detect command.\r\ntype Anomaly struct {\r\n\tID         string                 `json:\"id\"`\r\n"]
[2766.070733, "o", "\tType       string                 `json:\"type\"`\r\n\tSeverity   string                 `json:\"severity\"`\r\n\tEpoch      *int                   `json:\"epoch,omitempty\"`\r\n\tStep       *int                   `json:\"step,omitempty\"`\r\n\tDetails    map[string]interface{} `json:\"details,omitempty\"`\r\n\tSource     string                 `json:\"source,omitempty\"`\r\n\tCheckpoint string                 `json:\"checkpoint,omitempty\"`\r\n}\r\n\r\n// TensorInfo holds metadata for one tensor in a checkpoint.\r\ntype TensorInfo struct {\r\n\tName  string   `json:\"name\"`\r\n\tDtype byte     `json:\"dtype\"`\r\n\tShape []uint32 `json:\"shape\"`\r\n\tData  []byte   `json:\"-\"`\r\n\tHash  [32]byte `json:\"-\"` // Stored SHA-256\r\n"]
[2766.070813, "o", "\tValid bool     `json:\"valid\"`\r\n}\r\n\r\n// Provenance holds the provenance section data from an MLCK checkpoint.\r\ntype Provenance struct {\r\n\tGitCommit         string  `json:\"git_commit\"`\r\n\tDatasetHash       string  `json:\"dataset_hash\"` // hex-encoded raw bytes\r\n\tConfigHash        string  `json:\"config_hash\"`  // hex-encoded raw bytes\r\n\tTrainingTimestamp int64   `json:\"training_timestamp\"`\r\n\tTrainingDuration  float64 `json:\"training_duration\"`\r\n\tFramework         string  `json:\"framework\"`\r\n\tFrameworkVersion  string  `json:\"framework_version\"`\r\n\tEpoch             uint32  `json:\"epoch\"`\r\n\tGlobalStep        uint64  `json:\"global_step\"`\r\n\tLearningRate      float64 `json:\"learning_rate\"`\r\n\tParentHash        string  `json:\"parent_hash\"` // hex SHA-256 of parent file, empty if root\r\n}\r\n\r\n// CheckpointFile represents a parsed .mlck checkpoint.\r\ntype CheckpointFile struct {\r\n\t"]
[2766.070887, "o", "Path              string            `json:\"-\"`\r\n\tFilename          string            `json:\"-\"` // base filename\r\n\tVersion           uint32            `json:\"version\"`\r\n\tFlags             uint16            `json:\"-\"`\r\n\tNumTensors        uint32            `json:\"-\"`\r\n\tNumMetadataKeys   uint32            `json:\"-\"`\r\n\tCreationTimestamp int64             `json:\"-\"`         // unix seconds\r\n\tHeaderValid       bool              `json:\"-\"`         // header checksum valid?\r\n\tFileHash          string            `json:\"file_hash\"` // SHA-256 hex of entire file\r\n\tSigned            bool              `json:\"-\"`\r\n\tTensors           []TensorInfo      `json:\"tensors\"`\r\n\tMetadataMap       map[string]string `json:\"-\"` // key-value pairs from metadata section\r\n\tProvenance        *Provenance       `json:\"-\"`\r\n"]
[2766.070989, "o", "\tHasParent         bool              `json:\"has_parent\"`\r\n\tParentHex         string            `json:\"parent_hash\"` // same as Provenance.ParentHash\r\n}\r\n"]
