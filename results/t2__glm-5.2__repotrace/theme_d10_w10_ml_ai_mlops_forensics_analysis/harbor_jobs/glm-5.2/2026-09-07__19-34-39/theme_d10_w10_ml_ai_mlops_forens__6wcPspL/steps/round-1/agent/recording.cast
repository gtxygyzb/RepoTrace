[6161.563572, "o", "   185\t\t\t\t\tSource:   firstSource(entries[idx[i]]),\r\n   186\t\t\t\t})\r\n   187\t\t\t}\r\n   188\t\t}\r\n   189\t\treturn anomalies\r\n   190\t}\r\n   191\t\r\n   192\tfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n   193\t\tvar lossEntries []int\r\n"]
[6161.563625, "o", "   194\t\tfor i, e := range entries {\r\n   195\t\t\tif e.Loss != nil {\r\n   196\t\t\t\tlossEntries = append(lossEntries, i)\r\n   197\t\t\t}\r\n   198\t\t}\r\n   199\t\tif len(lossEntries) < 51 {\r\n   200\t\t\treturn nil\r\n   201\t\t}\r\n"]
[6161.563677, "o", "   202\t\tvar anomalies []types.Anomaly\r\n   203\t\tfor i := 50; i < len(lossEntries); i++ {\r\n   204\t\t\tstartIdx := lossEntries[i-50]\r\n   205\t\t\tendIdx := lossEntries[i]\r\n   206\t\t\tstart := *entries[startIdx].Loss\r\n   207\t\t\tend := *entries[endIdx].Loss\r\n   208\t\t\t"]
[6161.563743, "o", "if math.Abs(start) <= 1e-6 {\r\n   209\t\t\t\tcontinue\r\n   210\t\t\t}\r\n   211\t\t\tratio := (end - start) / math.Abs(start)\r\n   212\t\t\tif ratio > 1.0 {\r\n   213\t\t\t\tseverity := \"high\"\r\n   214\t\t\t\tif ratio > 5.0 {\r\n"]
[6161.563795, "o", "   215\t\t\t\t\tseverity = \"critical\"\r\n   216\t\t\t\t}\r\n   217\t\t\t\tep := entries[endIdx].Epoch\r\n   218\t\t\t\tst := entries[endIdx].Step\r\n   219\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   220\t\t\t\t\tType:     \"loss_divergence\",\r\n   221\t\t"]
[6161.563855, "o", "\t\t\tSeverity: severity,\r\n   222\t\t\t\t\tEpoch:    &ep,\r\n   223\t\t\t\t\tStep:     &st,\r\n   224\t\t\t\t\tDetails: map[string]interface{}{\r\n   225\t\t\t\t\t\t\"loss_start\":        start,\r\n"]
[6161.563907, "o", "   226\t\t\t\t\t\t\"loss_end\":          end,\r\n   227\t\t\t\t\t\t\"increase_ratio\":    ratio,\r\n   228\t\t\t\t\t\t\"window_start_step\": entries[startIdx].Step,\r\n   229\t\t\t\t\t\t\"window_end_step\":   entries[endIdx].Step,\r\n   230\t\t\t\t\t},\r\n"]
[6161.563967, "o", "   231\t\t\t\t\tEvidence: map[string]interface{}{\"window_values\": precedingLossValues(entries, lossEntries, i, 5)},\r\n   232\t\t\t\t\tSource:   firstSource(entries[endIdx]),\r\n   233\t\t\t\t})\r\n   234\t\t\t}\r\n   235\t\t}\r\n   236\t\treturn anomalies\r\n   237\t}\r\n"]
[6161.564019, "o", "   238\t\r\n   239\tfunc detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n   240\t\tvar anomalies []types.Anomaly\r\n   241\t\tfor i := 1; i < len(entries); i++ {\r\n   242\t\t\tprev := entries[i-1]\r\n   243\t\t\tcur := entries[i]\r\n   244\t\t\tif prev.Lr == nil || cur.Lr == nil {\r\n"]
[6161.564066, "o", "   245\t\t\t\tcontinue\r\n   246\t\t\t}\r\n   247\t\t\tif *cur.Lr > *prev.Lr {\r\n   248\t\t\t\tif cur.Event == \"epoch_end\" {\r\n   249\t\t\t\t\tcontinue\r\n   250\t\t\t\t}\r\n   251\t\t\t\tep := cur.Epoch\r\n   252\t\t\t\tst := cur.Step\r\n"]
[6161.564114, "o", "   253\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   254\t\t\t\t\tType:     \"lr_anomaly\",\r\n   255\t\t\t\t\tSeverity: \"info\",\r\n   256\t\t\t\t\tEpoch:    &ep,\r\n"]
[6161.564161, "o", "   257\t\t\t\t\tStep:     &st,\r\n   258\t\t\t\t\tDetails: map[string]interface{}{\r\n   259\t\t\t\t\t\t\"prev_lr\": *prev.Lr,\r\n   260\t\t\t\t\t\t\"curr_lr\": *cur.Lr,\r\n"]
