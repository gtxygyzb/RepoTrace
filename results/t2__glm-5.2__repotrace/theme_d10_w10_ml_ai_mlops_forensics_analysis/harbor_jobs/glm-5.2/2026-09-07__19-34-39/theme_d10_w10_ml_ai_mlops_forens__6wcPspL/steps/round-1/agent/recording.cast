[5441.453576, "o", "   419\t\t\t\t\t\tSeverity: \"high\",\r\n   420\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   421\t\t\t\t\t\t\t\"file\":        cf.Filename,\r\n   422\t\t\t\t\t\t\t\"parent_hash\": cf.Provenance.ParentHash,\r\n   423\t\t\t\t\t\t\t\"found\":       false,\r\n   424\t\t\t\t\t\t},\r\n   425\t\t\t\t\t\tEvidence:   map[string]interface{}{},\r\n   426\t\t\t\t\t\tSource:     cf.Filename,"]
