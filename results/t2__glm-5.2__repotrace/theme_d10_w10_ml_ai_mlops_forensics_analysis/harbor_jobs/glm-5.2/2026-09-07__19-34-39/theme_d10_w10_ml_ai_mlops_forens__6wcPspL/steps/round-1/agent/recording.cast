[3542.122348, "o", "   274\t\t\tif strings.HasPrefix(s[i:], \">=\") || strings.HasPrefix(s[i:], \"<=\") || strings.HasPrefix(s[i:], \"==\") || strings.HasPrefix(s[i:], \"!=\") {\r\n   275\t\t\t\ttokens = append(tokens, s[i:i+2])\r\n   276\t\t\t\ti += 2\r\n   277\t\t\t\tcontinue\r\n   278\t\t\t}\r\n   279\t\t\tif ch == '>' || ch == '<' {\r\n   280\t\t\t\ttokens = append(tokens, string(ch))\r\n   281\t\t\t\ti++\r\n   282\t\t\t\tcontinue\r\n   283\t\t\t}\r\n   284\t\t\tj := i\r\n   285"]
