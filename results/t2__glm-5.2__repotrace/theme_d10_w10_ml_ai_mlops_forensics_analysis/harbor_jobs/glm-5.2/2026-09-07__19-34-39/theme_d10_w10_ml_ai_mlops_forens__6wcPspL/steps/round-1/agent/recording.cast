[7296.119905, "o", "   124\t\t\t\tNumMetadata:       cf.NumMetadataKeys,\r\n   125\t\t\t\tSigned:            cf.Signed,\r\n   126\t\t\t\tCreationTimestamp: unixToISO(cf.CreationTimestamp),\r\n   127\t\t\t\tProvenance:        provenanceToMap(cf.Provenance),\r\n   128\t\t\t}\r\n   129\t\t\tout.Artifacts.Checkpoints = append(out.Artifacts.Checkpoints, ic)\r\n   130\t\t}\r\n   131\t\tsort.Slice(out.Artifacts.Checkpoints, func(i, j int) bool {\r\n   132\t\t\treturn out.Artifacts.Checkpoints[i].CreationTimestamp < out.Artifacts.Checkpoints[j].CreationTimestamp\r\n   133\t\t})\r\n   134\t\r\n   135\t"]
[7296.120016, "o", "\tfor _, p := range ap.Logs {\r\n   136\t\t\tinfo, entries, err := parseShardRecursive(p)\r\n   137\t\t\tif err != nil {\r\n   138\t\t\t\tcontinue\r\n   139\t\t\t}\r\n   140\t\t\tshard := IngestLogShard{\r\n   141\t\t\t\tFile:    info.File,\r\n   142\t\t\t\tEntries: info.Entries,\r\n   143\t\t\t}\r\n   144\t\t\tif info.Entries > 0 {\r\n   145\t\t\t\tshard.StepRange = []int{info.MinStep, info.MaxStep}\r\n   146\t\t\t\tshard.EpochRange = []int{info.MinEpoch, info.MaxEpoch}\r\n"]
[7296.12008, "o", "   147\t\t\t\tif info.MinTs != \"\" || info.MaxTs != \"\" {\r\n   148\t\t\t\t\tshard.TimeRange = []string{info.MinTs, info.MaxTs}\r\n   149\t\t\t\t}\r\n   150\t\t\t}\r\n   151\t\t\t_ = entries\r\n   152\t\t\tout.Artifacts.LogShards = append(out.Artifacts.LogShards, shard)\r\n"]
