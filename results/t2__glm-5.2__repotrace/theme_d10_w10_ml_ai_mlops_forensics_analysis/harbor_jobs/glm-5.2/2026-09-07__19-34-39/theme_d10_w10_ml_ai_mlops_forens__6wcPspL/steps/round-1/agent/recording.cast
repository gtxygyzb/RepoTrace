[3559.645379, "o", "package forensics\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n"]
[3559.645519, "o", "\t\"mlforge/internal/types\"\r\n)\r\n\r\ntype QueryOutput struct {\r\n\tStatus  string                `json:\"status\"`\r\n\tQuery   string                `json:\"query\"`\r\n\tMatches int                   `json:\"matches\"`\r\n\tEntries []types.TimelineEntry `json:\"entries\"`\r\n}\r\n\r\nfunc BuildQuery(dir, expr string) (interface{}, error) {\r\n\tentries, _, err := loadTimelineEntries(dir)\r\n"]
[3559.645607, "o", "\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tmerged, _ := mergeTimeline(entries)\r\n\tsortTimeline(merged)\r\n\r\n\tq, err := parseQuery(expr)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tmatches := []types.TimelineEntry{}\r\n\tfor _, e := range merged {\r\n\t\tif q.eval(e) {\r\n\t\t\tmatches = append(matches, e)\r\n\t\t}\r\n\t}\r\n\treturn QueryOutput{\r\n\t\tStatus:  \"ok\",\r\n\t\tQuery:   expr,\r\n\t\tMatches: len(matches),\r\n\t\tEntries: matches,\r\n\t}, nil\r\n}\r\n\r\ntype condition struct {\r\n\tfield string\r\n\top    string\r\n\tsval  string\r\n"]
[3559.645672, "o", "\tfval  float64\r\n\tisNum bool\r\n}\r\n\r\ntype orGroup struct {\r\n\tands []condition\r\n}\r\n\r\ntype query struct {\r\n\tors []orGroup\r\n}\r\n\r\nfunc (q query) eval(e types.TimelineEntry) bool {\r\n"]
[3559.645738, "o", "\tfor _, g := range q.ors {\r\n\t\tok := true\r\n\t\tfor _, c := range g.ands {\r\n\t\t\tif !c.eval(e) {\r\n\t\t\t\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif ok {\r\n\t\t\treturn true\r\n"]
[3559.645802, "o", "\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc (c condition) eval(e types.TimelineEntry) bool {\r\n\tswitch c.field {\r\n\tcase \"step\":\r\n\t\treturn compareNum(float64(e.Step), c)\r\n\tcase \"epoch\":\r\n\t\treturn compareNum(float64(e.Epoch), c)\r\n\t"]
[3559.645874, "o", "case \"loss\":\r\n\t\treturn ptrCompareNum(e.Loss, c)\r\n\tcase \"lr\":\r\n\t\treturn ptrCompareNum(e.Lr, c)\r\n\tcase \"grad_norm\":\r\n\t\treturn ptrCompareNum(e.GradNorm, c)\r\n\tcase \"acc\":\r\n\t\treturn ptrCompareNum(e.Acc, c)\r\n\tcase \"event\":\r\n\t\treturn compareStr(e.Event, c)\r\n\tcase \"ts\":\r\n"]
[3559.646009, "o", "\t\treturn compareTs(e.Ts, c)\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc compareNum(val float64, c condition) bool {\r\n\tif !c.isNum {\r\n\t\treturn false\r\n\t}\r\n\tswitch c.op {\r\n\tcase \">\":\r\n\t\treturn val > c.fval\r\n\tcase \"<\":\r\n\t\treturn val < c.fval\r\n\tcase \">=\":\r\n\t\treturn val >= c.fval\r\n\tcase \"<=\":\r\n\t\treturn val <= c.fval\r\n"]
[3559.646083, "o", "\tcase \"==\":\r\n\t\treturn absFloat(val-c.fval) <= 1e-9\r\n\tcase \"!=\":\r\n\t\treturn absFloat(val-c.fval) > 1e-9\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc ptrCompareNum(p *float64, c condition) bool {\r\n\tif p == nil {\r\n\t\treturn false\r\n\t}\r\n\treturn compareNum(*p, c)\r\n}\r\n"]
[3559.646154, "o", "\r\nfunc compareStr(val string, c condition) bool {\r\n\tif c.isNum {\r\n\t\treturn false\r\n\t}\r\n\tswitch c.op {\r\n\tcase \"==\":\r\n\t\treturn val == c.sval\r\n\tcase \"!=\":\r\n\t\treturn val != c.sval\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc compareTs(val string, c condition) bool {\r\n"]
[3559.646235, "o", "\tlt, err := time.Parse(time.RFC3339, val)\r\n\tif err != nil {\r\n\t\treturn false\r\n\t}\r\n\trt, err := time.Parse(time.RFC3339, c.sval)\r\n\tif err != nil {\r\n\t\treturn false\r\n\t}\r\n\tswitch c.op {\r\n\tcase \">\":\r\n\t\treturn lt.After(rt)\r\n\tcase \"<\":\r\n\t\treturn lt.Before(rt)\r\n\tcase \">=\":\r\n\t\treturn lt.After(rt) || lt.Equal(rt)\r\n"]
[3559.646313, "o", "\tcase \"<=\":\r\n\t\treturn lt.Before(rt) || lt.Equal(rt)\r\n\tcase \"==\":\r\n\t\treturn lt.Equal(rt)\r\n\tcase \"!=\":\r\n\t\treturn !lt.Equal(rt)\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc absFloat(x float64) float64 {\r\n\tif x < 0 {\r\n\t\treturn -x\r\n\t}\r\n\treturn x\r\n"]
[3559.646381, "o", "}\r\n\r\nfunc parseQuery(expr string) (query, error) {\r\n\ttokens, err := tokenizeQuery(expr)\r\n\tif err != nil {\r\n\t\treturn query{}, err\r\n\t}\r\n\tvar q query\r\n\tvar cur orGroup\r\n\ti := 0\r\n\tfor i < len(tokens) {\r\n\t\ttok := tokens[i]\r\n\t\tif tok == \"AND\" || tok == \"OR\" {\r\n\t\t\tif tok == \"OR\" {\r\n"]
[3559.646464, "o", "\t\t\t\tq.ors = append(q.ors, cur)\r\n\t\t\t\tcur = orGroup{}\r\n\t\t\t} else if tok == \"AND\" {\r\n\t\t\t\t// continue adding to cur\r\n\t\t\t}\r\n\t\t\ti++\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tcond, next, err := parseCondition(tokens, i)\r\n\t\tif err != nil {\r\n\t\t\treturn query{}, err\r\n\t\t}\r\n\t\tcur.ands = append(cur.ands, cond)\r\n"]
[3559.646545, "o", "\t\ti = next\r\n\t}\r\n\tif len(cur.ands) > 0 || len(q.ors) == 0 {\r\n\t\tq.ors = append(q.ors, cur)\r\n\t}\r\n\tif len(q.ors) == 0 || len(q.ors[0].ands) == 0 {\r\n\t\treturn query{}, fmt.Errorf(\"empty query\")\r\n\t}\r\n\treturn q, nil\r\n}\r\n\r\nfunc parseCondition(tokens []string, i int) (condition, int, error) {\r\n\tif i+2 >= len(tokens) {\r\n"]
[3559.646621, "o", "\t\treturn condition{}, i, fmt.Errorf(\"invalid query syntax\")\r\n\t}\r\n\tfield := tokens[i]\r\n\top := tokens[i+1]\r\n\tvalueTok := tokens[i+2]\r\n\r\n\tvalidFields := map[string]bool{\"step\": true, \"epoch\": true, \"loss\": true, \"lr\": true, \"grad_norm\": true, \"acc\": true, \"event\": true, \"ts\": true}\r\n\tif !validFields[field] {\r\n\t\treturn condition{}, i, fmt.Errorf(\"unknown field: %s\", field)\r\n\t}\r\n"]
