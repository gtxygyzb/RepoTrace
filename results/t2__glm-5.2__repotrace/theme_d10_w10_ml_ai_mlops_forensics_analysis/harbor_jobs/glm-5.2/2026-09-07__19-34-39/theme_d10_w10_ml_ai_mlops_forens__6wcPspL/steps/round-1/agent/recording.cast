[6226.621549, "o", "   540\t\tsignerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   541\t\toff += 2\r\n   542\t\tif off+signerLen+2 > len(raw) {\r\n   543\t\t\treturn false, \"\"\r\n   544\t\t}\r\n"]
[6226.621624, "o", "   545\t\tsignerID := string(raw[off : off+signerLen])\r\n   546\t\toff += signerLen\r\n   547\t\tsigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   548\t\toff += 2\r\n   549\t\tif off+sigLen > len(raw) {\r\n   550\t\t\treturn false, signerID\r\n   551\t\t}\r\n   552\t\tstored := raw[off : off+sigLen]\r\n   553\t\tmac := hmac.New(sha256.New, []byte(signerID))\r\n   554\t\tmac.Write(raw[:sigOff])\r\n   555"]
[6226.621707, "o", "\t\texpected := mac.Sum(nil)\r\n   556\t\treturn hmac.Equal(expected, stored), signerID\r\n   557\t}\r\n   558\t\r\n   559\tfunc lastValues(v []float64, n int) []float64 {\r\n   560"]
[6226.621768, "o", "\t\tif len(v) > n {\r\n   561\t\t\tv = v[len(v)-n:]\r\n   562\t\t}\r\n   563\t\tif v == nil {\r\n   564\t\t\tv = []float64{}\r\n   565\t\t}\r\n   566\t\treturn v\r\n   567\t}\r\n   568\t\r\n   569\tfunc precedingLossValues(entries []types.TimelineEntry, indices []int, pos, n int) []float64 {\r\n   570\t\tvals := []float64{}\r\n   571\t\tstart := pos - n\r\n   572\t\tif start < 0 {\r\n   573\t\t\tstart = 0\r\n   574\t"]
[6226.621834, "o", "\t}\r\n   575\t\tfor j := start; j < pos; j++ {\r\n   576\t\t\tif j >= 0 && j < len(indices) && entries[indices[j]].Loss != nil {\r\n   577\t\t\t\tvals = append(vals, *entries[indices[j]].Loss)\r\n   578\t\t\t}\r\n   579\t\t}\r\n   580\t\treturn vals\r\n   581\t}\r\n   582\t\r\n   583\tfunc firstSource(e types.TimelineEntry) string {\r\n"]
[6226.621876, "o", "   584\t\tif len(e.Sources) > 0 {\r\n   585\t\t\treturn e.Sources[0]\r\n   586\t\t}\r\n   587\t\treturn \"\"\r\n   588\t}\r\n   589\t\r\n"]
[6226.621996, "o", "   590\tfunc meanFloats(v []float64) float64 {\r\n   591\t\tif len(v) == 0 {\r\n   592\t\t\treturn 0\r\n   593\t\t}\r\n   594\t\ts := 0.0\r\n   595\t\tfor _, x := range v {\r\n   596\t\t\ts += x\r\n   597\t\t}\r\n   598\t\treturn s / float64(len(v))\r\n   599\t}\r\n   600\t\r\n   601\tfunc stddevFloats(v []float64, mean float64) float64 {\r\n   602\t\tif len(v) == 0 {\r\n   603\t\t\treturn 0\r\n"]
[6226.622061, "o", "   604\t\t}\r\n   605\t\ts := 0.0\r\n   606\t\tfor _, x := range v {\r\n   607\t\t\td := x - mean\r\n   608\t\t\ts += d * d\r\n   609\t\t}\r\n   610\t\treturn math.Sqrt(s / float64(len(v)))\r\n   611\t}\r\n   612\t"]
[6226.622125, "o", "\r\n   613\tfunc sortAnomalies(a []types.Anomaly) {\r\n   614\t\trank := map[string]int{\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3, \"info\": 4}\r\n   615\t\tsort.Slice(a, func(i, j int) bool {\r\n   616\t\t\tri := rank[a[i].Severity]\r\n   617\t\t\trj := rank[a[j].Severity]\r\n   618\t\t\tif ri != rj {\r\n   619\t\t\t\treturn ri < rj\r\n   620\t\t\t}\r\n"]
