[1157.115038, "o", "    tensor_hash = hashlib.sha256(data).digest()\r\n\u001b[?2004l\r"]
[1157.115133, "o", "\u001b[?2004h> "]
[1157.116175, "o", "    tensor_block = struct.pack('<H', len(name)) + name + struct.pack('<B', 0) + struct.pack('<B', 1) + struct.pack('<I', 1) + struct.pack('<Q', len(data)) + data + tensor_hash\r\n\u001b[?2004l\r"]
[1157.116251, "o", "\u001b[?2004h> "]
