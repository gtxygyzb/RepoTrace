[1407.86076, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\n# Patch BuildIngest to initialize empty artifact slices.\np = Path('internal/forensics/forensics.go')\ns = p.read_text()\nold = '''\\tvar out IngestOutput\n\\tout.Status = \"ok\"\n\\tout.EvidenceDir = dir\n\n\\tfor _, p := range ap.Checkpoints {'''\nnew = '''\\tvar out IngestOutput\n\\tout.Status = \"ok\"\n\\tout.EvidenceDir = dir\n\\tout.Artifacts.Checkpoints = []IngestCheckpoint{}\n\\tout.Artifacts.LogShards = []IngestLogShard{}\n\\tout.Artifacts.Configs = []IngestConfig{}\n\n\\tfor _, p := range ap.Checkpoints {'''\nif old not in s:\n    raise SystemExit('BuildIngest block not found')\ns = s.replace(old, new)\n\n# Add encoding/hex import for provenance validation.\ns = s.replace('\"encoding/binary\"\\n\"encoding/json\"', '\"encoding/binary\"\\n\"encoding/hex\"\\n\"encoding/json\"')\n\n# Replace validateProvenance with a stricter implementation.\nstart = s.index('func validateProvenance(cf *types.CheckpointFile) bool {')\nend = s.index('func validateSignature(path string) (bool, error) {')\nnew_func = '''fun"]
[1407.861071, "i", "c validateProvenance(cf *types.CheckpointFile) bool {\n\\tif cf.Provenance == nil {\n\\t\\treturn false\n\\t}\n\\tp := cf.Provenance\n\\tif p.Framework == \"\" || p.FrameworkVersion == \"\" {\n\\t\\treturn false\n\\t}\n\\tif len(p.GitCommit) != 40 || !isHex(p.GitCommit) {\n\\t\\treturn false\n\\t}\n\\tif len(p.DatasetHash) != 64 || !isHex(p.DatasetHash) {\n\\t\\treturn false\n\\t}\n\\tif len(p.ConfigHash) != 64 || !isHex(p.ConfigHash) {\n\\t\\treturn false\n\\t}\n\\tif p.ParentHash != \"\" && (len(p.ParentHash) != 64 || !isHex(p.ParentHash)) {\n\\t\\treturn false\n\\t}\n\\treturn true\n}\n\nfunc isHex(s string) bool {\n\\t_, err := hex.DecodeString(s)\n\\treturn err == nil\n}\n\n'''\ns = s[:start] + new_func + s[end:]\np.write_text(s)\n\n# Patch QueryOutput entries initialization.\np = Path('internal/forensics/query.go')\ns = p.read_text()\nold = '''\\tvar matches []types.TimelineEntry\n\\tfor _, e := range merged {\n\\t\\tif q.eval(e) {\n\\t\\t\\tmatches = append(matches, e)\n\\t\\t}\n\\t}\n\\treturn QueryOutput{'''\nnew = '''\\tmatches := []types.TimelineEntry{}\n\\tfor _, e := range merged {\n\\t"]
[1407.86117, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[1407.861272, "i", "\\tif q.eval(e) {\n\\t\\t\\tmatches = append(matches, e)\n\\t\\t}\n\\t}\n\\treturn QueryOutput{'''\nif old not in s:\n    raise SystemExit('Query matches block not found')\ns = s.replace(old, new)\np.write_text(s)\n\n# Patch topoSort to ignore incoming edges from orphan parents.\np = Path('internal/forensics/lineage.go')\ns = p.read_text()\nold = '''func topoSort(nodeByHash map[string]*LineageNode, children map[string][]string, incoming map[string]int) []string {\n\\tindeg := map[string]int{}\n\\tfor h, n := range nodeByHash {\n\\t\\tif n.IsOrphan {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tindeg[h] = incoming[h]\n\\t}\n\n\\tvar ready []string\n\\tfor h, n := range nodeByHash {\n\\t\\tif n.IsOrphan {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif indeg[h] == 0 {\n\\t\\t\\tready = append(ready, h)\n\\t\\t}\n\\t}\n'''\nnew = '''func topoSort(nodeByHash map[string]*LineageNode, children map[string][]string, incoming map[string]int) []string {\n\\tindeg := map[string]int{}\n\\tfor h, n := range nodeByHash {\n\\t\\tif n.IsOrphan {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tindeg[h] = 0\n\\t}\n\\tfor parent, childHashes := ran"]
[1407.861296, "o", "\u001b[?2004h> "]
[1407.86139, "i", "ge children {\n\\t\\tif pn, ok := nodeByHash[parent]; ok && pn.IsOrphan {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tfor _, child := range childHashes {\n\\t\\t\\tif cn, ok := nodeByHash[child]; ok && !cn.IsOrphan {\n\\t\\t\\t\\tindeg[child]++\n\\t\\t\\t}\n\\t\\t}\n\\t}\n\n\\tvar ready []string\n\\tfor h, n := range nodeByHash {\n\\t\\tif n.IsOrphan {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif indeg[h] == 0 {\n\\t\\t\\tready = append(ready, h)\n\\t\\t}\n\\t}\n'''\nif old not in s:\n    raise SystemExit('topoSort block not found')\ns = s.replace(old, new)\np.write_text(s)\nPY\ngofmt -w internal/forensics cmd/mlforge\ngo build ./...\n"]
