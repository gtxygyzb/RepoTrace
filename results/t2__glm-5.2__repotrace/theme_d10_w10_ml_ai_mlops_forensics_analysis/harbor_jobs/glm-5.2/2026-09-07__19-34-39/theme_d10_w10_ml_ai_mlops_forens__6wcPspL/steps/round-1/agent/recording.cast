[5046.743995, "o", "^Ireturn anomalies$\r\n}$\r\n$\r\nfunc detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {$\r\n^Ivar anomalies []types.Anomaly$\r\n^Ifor i := 1; i < len(entries); i++ {$\r\n^I^Iprev := entries[i-1]$\r\n^I^Icur := entries[i]$\r\n^I^Iif prev.Lr == nil || cur.Lr == nil {$\r\n^I^I^Icontinue$\r\n^I^I}$\r\n^I^Iif *cur.Lr > *prev.Lr {$\r\n^I^I^Iif cur.Event == \"epoch_end\" {$\r\n^I^I^I^Icontinue$\r\n^I^I^I}$\r\n^I^I^Iep := cur.Epoch$\r\n^I^I^Ist := cur.Step$\r\n^I^I^Ianomalies = append(anomalies, types.Anomaly{$\r\n^I^I^I^IType:     \"lr_anomaly\",$\r\n^I^I^I^ISeverity: \"medium\",$\r\n^I^I^I^IEpoch:    &ep,$\r\n^I^I^I^IStep:     &st,$\r\n^I^I^I^IDetails: map[string]interface{}{$\r\n^I^I^I^I^I\"prev_lr\": *prev.Lr,$\r\n^I^I^I^I^I\"curr_lr\": *cur.Lr,$\r\n"]
[5046.744103, "o", "^I^I^I^I^I\"step\":    cur.Step,$\r\n^I^I^I^I},$\r\n^I^I^I^ISource: firstSource(cur),$\r\n^I^I^I})$\r\n^I^I}$\r\n^I}$\r\n^Ireturn anomalies$\r\n}$\r\n$\r\nfunc detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {$\r\n^Ivar anomalies []types.Anomaly$\r\n^Ifor i := 1; i < len(entries); i++ {$\r\n^I^Iprev := entries[i-1]$\r\n^I^Icur := entries[i]$\r\n^I^Iif prev.Epoch != cur.Epoch {$\r\n^I^I^Icontinue$\r\n^I^I}$\r\n^I^IprevT, err1 := time.Parse(time.RFC3339, prev.Ts)$\r\n^I^IcurT, err2 := time.Parse(time.RFC3339, cur.Ts)$\r\n^I^Iif err1 != nil || err2 != nil {$\r\n^I^I^Icontinue$\r\n^I^I}$\r\n^I^Idiff := curT.Sub(prevT).Seconds()$\r\n^I^Iif diff > 3600 {$\r\n^I^I^Iep := cur.Epoch$\r\n^I^I^Ist := cur.Step$\r\n^I^I^Ianomalies = append(anomalies, types.Anomaly{$\r\n^I^I^I^IType:     \"training_gap\",$\r\n^I^I^I^ISeverity: \"low\",$\r\n^I^I^I^IEpoch:    &ep,$\r\n^I^I^I^IStep:     &st,$\r\n^I^I^I^IDetails: map[string]interface{}{$\r\n^I^I^I^I^I\"after_step\":  prev.Step,$\r\n^I^I^I^I^I\"before_step\": cur.Step,$\r\n^I^I^I^I^I\"after_ts\":    prev.Ts,$\r\n^I^I^I^I^I\"before_ts\":   cur"]
[5046.744169, "o", ".Ts,$\r\n^I^I^I^I^I\"gap_seconds\": diff,$\r\n^I^I^I^I},$\r\n^I^I^I^ISource: firstSource(cur),$\r\n^I^I^I})$\r\n^I^I}$\r\n^I}$\r\n^Ireturn anomalies$\r\n}$\r\n$\r\nfunc detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {$\r\n"]
[5046.744413, "o", "\u001b[?2004h"]
