[1134.440039, "i", "python3 - <<'PY'\nimport struct, hashlib, os, time\nos.makedirs('/tmp/evidence', exist_ok=True)\n\ndef fnv64a(data):\n    h = 0xcbf29ce484222325\n    for b in data:\n        h ^= b\n        h = (h * 0x100000001b3) & 0xffffffffffffffff\n    return h\n\ndef make_mlck(path, parent_hash='', dataset=b'\\x01'*32, ts=None):\n    if ts is None:\n        ts = int(time.time())\n    name = b'w'\n    data = b'\\x00\\x00\\x80\\x3f'\n    tensor_hash = hashlib.sha256(data).digest()\n    tensor_block = struct.pack('<H', len(name)) + name + struct.pack('<B', 0) + struct.pack('<B', 1) + struct.pack('<I', 1) + struct.pack('<Q', len(data)) + data + tensor_hash\n    git = b'0'*40\n    config_hash = b'\\xcc'*32\n    framework = b'PyTorch'\n    framework_version = b'2.1.0'\n    prov = git + dataset + config_hash + struct.pack('<q', ts) + struct.pack('<d', 1.0) + struct.pack('<H', len(framework)) + framework + struct.pack('<H', len(framework_version)) + framework_version + struct.pack('<I', 1) + struct.pack('<Q', 5000) + struct.pack('<d', 0.1) + struct.pack('<"]
[1134.440322, "i", "H', len(parent_hash)) + parent_hash.encode()\n    metadata_offset = 0\n    provenance_offset = 56 + len(tensor_block)\n    signature_offset = 0\n    header_no_checksum = struct.pack('<4sHHIIQQQQq', b'MLCK', 1, 0, 1, 0, metadata_offset, provenance_offset, signature_offset, ts)\n    checksum = fnv64a(header_no_checksum)\n    header = header_no_checksum + struct.pack('<Q', checksum)\n    raw = header + tensor_block + prov\n    with open(path, 'wb') as f:\n        f.write(raw)\n    return hashlib.sha256(raw).hexdigest()\n\nroot_hash = make_mlck('/tmp/evidence/model_epoch1.mlck')\nchild_hash = make_mlck('/tmp/evidence/model_epoch2.mlck', parent_hash=root_hash)\nprint('root', root_hash)\nprint('child', child_hash)\nPY\n./mlforge verify /tmp/evidence\n"]
