[3232.406562, "o", "go build -o /tmp/mlforge ./cmd/mlforge && /tmp/mlforge diff /tmp/nonexistent_evidence a.mlck b.mlck; echo \"exit=$?\"\r\n\u001b[?2004l\r"]
[3232.710247, "i", "sed -n '100,190p' internal/forensics/diff.go\n"]
[3232.710508, "o", "sed -n '100,190p' internal/forensics/diff.go\r\n"]
[3234.52253, "o", "error: diff: a.mlck: checkpoint: read /tmp/nonexistent_evidence/a.mlck: open /tmp/nonexistent_evidence/a.mlck: no such file or directory\r\n"]
