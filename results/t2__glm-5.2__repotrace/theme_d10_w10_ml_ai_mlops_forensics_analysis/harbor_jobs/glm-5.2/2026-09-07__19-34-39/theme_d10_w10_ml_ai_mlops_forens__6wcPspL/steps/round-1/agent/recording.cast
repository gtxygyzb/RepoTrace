[5471.51762, "o", "\tvar anomalies []types.Anomaly\r\n\r\n\tentries, _, err := loadTimelineEntries(dir)\r\n\tif err == nil {\r\n\t\tmerged, _ := mergeTimeline(entries)\r\n\t"]
[5471.517658, "o", "\tsortTimeline(merged)\r\n\t\tanomalies = append(anomalies, detectTimelineAnomalies(merged)...)\r\n\t}\r\n\r\n\tcps, err := loadCheckpoints(dir)\r\n\tif err == nil {\r\n"]
[5471.517757, "o", "\t\tanomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\r\n\t}\r\n\r\n\tif filterSeverity != \"\" {\r\n\t\twantedRank, ok := severityRankValue(filterSeverity)\r\n\t\tif !ok {\r\n"]
[5471.517815, "o", "\t\t\treturn out, fmt.Errorf(\"invalid severity level %q: must be critical, high, medium, or low\", filterSeverity)\r\n\t\t}\r\n\t\tfiltered := anomalies[:0]\r\n\t\tfor _, a := range anomalies {\r\n\t\t\tif severityRank(a.Severity) <= wantedRank {\r\n\t\t\t\tfiltered = append(filtered, a)\r\n\t\t\t}\r\n\t\t}\r\n\t\tanomalies = filtered\r\n\t}\r\n\r\n\tfor i := range anomalies {\r\n\t\tanomalies[i].ID = fmt.Sprintf(\"ANOM-%03d\", i+1)\r\n\t}\r\n\tsortAnomalies(anomalies)\r\n\r\n\tout.Anomalies = anomalies\r\n\tif out.Anomalies == nil {\r\n\t\tout.Anomalies = []types.Anomaly{}\r\n\t}\r\n\tout.Summary.Total = len(anomalies)\r\n\tout.Summary.BySeverity = map[string]int{\"critical\": 0, \"high\": 0, \"medium\": 0, \"low\": 0}\r\n"]
[5471.517873, "o", "\tout.Summary.ByType = map[string]int{}\r\n\tfor _, a := range anomalies {\r\n\t\tout.Summary.BySeverity[a.Severity]++\r\n\t\tout.Summary.ByType[a.Type]++\r\n\t}\r\n\treturn out, nil\r\n}\r\n\r\nfunc severityRank(s string) int {\r\n\tswitch s {\r\n\tcase \"critical\":\r\n"]
[5471.517929, "o", "\t\treturn 0\r\n\tcase \"high\":\r\n\t\treturn 1\r\n\tcase \"medium\":\r\n\t\treturn 2\r\n\tdefault:\r\n\t\treturn 3\r\n\t}\r\n}\r\n\r\n"]
[5471.518029, "o", "func severityRankValue(s string) (int, bool) {\r\n\tswitch s {\r\n\tcase \"critical\":\r\n\t\treturn 0, true\r\n\tcase \"high\":\r\n\t\treturn 1, true\r\n\tcase \"medium\":\r\n\t\treturn 2, true\r\n\tcase \"low\":\r\n\t\treturn 3, true\r\n\tdefault:\r\n\t\treturn 4, false\r\n\t}\r\n}\r\n\r\nfunc detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n"]
[5471.518081, "o", "\tvar anomalies []types.Anomaly\r\n\tanomalies = append(anomalies, detectGradientSpikes(entries)...)\r\n\tanomalies = append(anomalies, detectLossDivergence(entries)...)\r\n\tanomalies = append(anomalies, detectLrAnomalies(entries)...)\r\n\tanomalies = append(anomalies, detectTrainingGaps(entries)...)\r\n"]
