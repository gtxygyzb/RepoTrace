[7195.011506, "i", "sed -n '1,240p' cmd/mlforge/main.go\n"]
[7195.011808, "o", "sed -n '1,240p' cmd/mlforge/main.go\r\n"]
[7195.011878, "o", "\u001b[?2004l\r"]
[7195.014811, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n"]
[7195.014892, "o", "\r\n\t\"mlforge/internal/forensics\"\r\n)\r\n\r\nfunc main() {\r\n\t// --- Parse flags ---------------------------------------------------\r\n\tformat := \"json\"\r\n"]
[7195.014975, "o", "\tverbose := false\r\n\tfilterSeverity := \"\"\r\n\tvar positional []string\r\n\r\n\targs := os.Args[1:]\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tswitch {\r\n\t\tcase arg == \"--verbose\":\r\n\t\t\tverbose = true\r\n\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n\t\tcase arg == \"--format\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"flag --format requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ti++\r\n\t\t"]
[7195.015024, "o", "\tformat = args[i]\r\n\t\tcase strings.HasPrefix(arg, \"--filter-severity=\"):\r\n\t\t\tfilterSeverity = strings.TrimPrefix(arg, \"--filter-severity=\")\r\n\t\tcase arg == \"--filter-severity\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"flag --filter-severity requires a value\\n\")\r\n"]
[7195.015065, "o", "\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ti++\r\n\t\t\tfilterSeverity = args[i]\r\n\t\tdefault:\r\n\t\t\tpositional = append(positional, arg)\r\n"]
[7195.015098, "o", "\t\t}\r\n\t}\r\n\r\n\tswitch format {\r\n\tcase \"json\", \"text\", \"csv\":\r\n\tdefault:\r\n"]
[7195.015132, "o", "\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json, text, or csv\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t"]
[7195.015167, "o", "_ = verbose // reserved for diagnostic output\r\n\r\n\t// --- Validate positional args --------------------------------------\r\n\tif len(positional) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := positional[0]"]
[7195.015203, "o", "\r\n\tdir := positional[1]\r\n\r\n\tif format == \"csv\" && cmd != \"detect\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid format csv: csv output is only supported for detect\\n\")\r\n"]
[7195.01524, "o", "\t\tos.Exit(1)\r\n\t}\r\n\tif filterSeverity != \"\" && cmd != \"detect\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"--filter-severity is only supported for detect\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[7195.01527, "o", "\r\n\t// --- Route to command handler --------------------------------------\r\n\tvar result interface{}\r\n\tvar err error\r\n"]
[7195.015302, "o", "\r\n\tswitch cmd {\r\n\tcase \"ingest\":\r\n\t\tresult, err = forensics.BuildIngest(dir)\r\n\tcase \"timeline\":\r\n\t\tresult, err = forensics.BuildTimeline(dir)\r\n"]
[7195.015337, "o", "\tcase \"verify\":\r\n\t\tresult, err = forensics.BuildVerify(dir)\r\n\tcase \"detect\":\r\n\t\tdetectResult, detectErr := forensics.BuildDetectFiltered(dir, filterSeverity)\r\n\t\tif detectErr != nil {\r\n\t\t\terr = detectErr\r\n"]
[7195.015378, "o", "\t\t} else {\r\n\t\t\tif format == \"csv\" {\r\n\t\t\t\tprintDetectCSV(detectResult)\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t"]
[7195.015409, "o", "\t\tresult = detectResult\r\n\t\t}\r\n\tcase \"lineage\":\r\n\t\tresult, err = forensics.BuildLineage(dir)\r\n\tcase \"query\":\r\n\t\t"]
[7195.015443, "o", "if len(positional) < 3 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
[7195.015479, "o", "\t\tresult, err = forensics.BuildQuery(dir, positional[2])\r\n\tcase \"diff\":\r\n\t\tif len(positional) < 4 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge diff <dir> <file1> <file2>\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
[7195.015512, "o", "\t\tresult, err = forensics.BuildDiff(dir, positional[2], positional[3])\r\n\tcase \"report\":\r\n\t\tresult, err = forensics.BuildReport(dir)\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n"]
[7195.015545, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\t// --- Output --------------------------------------------------------\r\n\tif err != nil {\r\n"]
[7195.015576, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif format == \"text\" {\r\n\t\tprintText(result)\r\n"]
[7195.01561, "o", "\t\treturn\r\n\t}\r\n\r\n\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n\tif marshalErr != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error marshalling result: %v\\n\", marshalErr)\r\n\t\tos.Exit(1)\r\n"]
[7195.015653, "o", "\t}\r\n\tfmt.Println(string(out))\r\n}\r\n\r\nfunc printDetectCSV(result forensics.DetectOutput) {\r\n\tfmt.Println(\"id,type,severity,epoch,step,source,checkpoint\")\r\n\tfor _, a := range result.Anomalies {\r\n"]
[7195.015686, "o", "\t\tepoch := \"\"\r\n\t\tif a.Epoch != nil {\r\n\t\t\tepoch = strconv.Itoa(*a.Epoch)\r\n\t\t}\r\n"]
[7195.015719, "o", "\t\tstep := \"\"\r\n\t\tif a.Step != nil {\r\n\t\t\tstep = strconv.Itoa(*a.Step)\r\n\t\t}\r\n\t\tfmt.Printf(\"%s,%s,%s,%s,%s,%s,%s\\n\", a.ID, a.Type, a.Severity, epoch, step, a.Source, a.Checkpoint)\r\n\t"]
[7195.015749, "o", "}\r\n}\r\n\r\nfunc printText(v interface{}) {\r\n\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n\tif err != nil {\r\n"]
[7195.015787, "o", "\t\tfmt.Fprintln(os.Stderr, \"error rendering text output\")\r\n\t\treturn\r\n\t}\r\n\tfmt.Println(string(b))"]
[7195.015805, "o", "\r\n}\r\n"]
[7195.016278, "o", "\u001b[?2004h"]
[7195.016348, "o", "root@n30009:/app# "]
[7195.290243, "i", "sed -n '1,260p' internal/types/types.go\n"]
[7195.290572, "o", "sed -n '1,260p' internal/types/types.go\r\n"]
[7195.29069, "o", "\u001b[?2004l\r"]
[7195.293444, "o", "package types\r\n\r\n// TimelineEntry represents one log entry from a JSONL shard.\r\ntype TimelineEntry struct {\r\n\tTs       string   `json:\"ts\"`\r\n\tEpoch    int      `json:\"epoch\"`\r\n"]
[7195.29353, "o", "\tStep     int      `json:\"step\"`\r\n\tLoss     *float64 `json:\"loss,omitempty\"`\r\n\tLr       *float64 `json:\"lr,omitempty\"`\r\n\tGradNorm *float64 `json:\"grad_norm,omitempty\"`\r\n\tAcc      *float64 `json:\"acc,omitempty\"`\r\n\tEvent    string   `json:\"event,omitempty\"`\r\n\tSources  []string `json:\"sources,omitempty\"`\r\n\tConflict bool     `json:\"conflict\"`\r\n}\r\n\r\n// Anomaly represents one detected anomaly in the detect command.\r\ntype Anomaly struct {\r\n\tID         string                 `json:\"id\"`\r\n\tType       string                 `json:\"type\"`\r\n\tSeverity   string                 `json:\"severity\"`\r\n"]
[7195.293594, "o", "\tEpoch      *int                   `json:\"epoch,omitempty\"`\r\n\tStep       *int                   `json:\"step,omitempty\"`\r\n\tDetails    map[string]interface{} `json:\"details,omitempty\"`\r\n\tEvidence   map[string]interface{} `json:\"evidence\"`\r\n\tSource     string                 `json:\"source,omitempty\"`\r\n\tCheckpoint string                 `json:\"checkpoint,omitempty\"`\r\n}\r\n\r\n// TensorInfo holds metadata for one tensor in a checkpoint.\r\ntype TensorInfo struct {\r\n\tName  string   `json:\"name\"`\r\n\tDtype byte     `json:\"dtype\"`\r\n"]
[7195.293668, "o", "\tShape []uint32 `json:\"shape\"`\r\n\tData  []byte   `json:\"-\"`\r\n\tHash  [32]byte `json:\"-\"` // Stored SHA-256\r\n\tValid bool     `json:\"valid\"`\r\n}\r\n\r\n// Provenance holds the provenance section data from an MLCK checkpoint.\r\ntype Provenance struct {\r\n\tGitCommit         string  `json:\"git_commit\"`\r\n\tDatasetHash       string  `json:\"dataset_hash\"` // hex-encoded raw bytes\r\n\tConfigHash        string  `json:\"config_hash\"`  // hex-encoded raw bytes\r\n\tTrainingTimestamp int64   `json:\"training_timestamp\"`\r\n"]
[7195.293722, "o", "\tTrainingDuration  float64 `json:\"training_duration\"`\r\n\tFramework         string  `json:\"framework\"`\r\n\tFrameworkVersion  string  `json:\"framework_version\"`\r\n\tEpoch             uint32  `json:\"epoch\"`\r\n\tGlobalStep        uint64  `json:\"global_step\"`\r\n\tLearningRate      float64 `json:\"learning_rate\"`\r\n\tParentHash        string  `json:\"parent_hash\"` // hex SHA-256 of parent file, empty if root\r\n}\r\n"]
[7195.293784, "o", "\r\n// CheckpointFile represents a parsed .mlck checkpoint.\r\ntype CheckpointFile struct {\r\n\tPath              string            `json:\"-\"`\r\n\tFilename          string            `json:\"-\"` // base filename\r\n\tVersion           uint32            `json:\"version\"`\r\n\tFlags             uint16            `json:\"-\"`\r\n\tNumTensors        uint32            `json:\"-\"`\r\n\tNumMetadataKeys   uint32            `json:\"-\"`\r\n\tCreationTimestamp int64             `json:\"-\"`         // unix seconds\r\n\tHeaderValid       bool              `json:\"-\"`         // header checksum valid?\r\n\t"]
[7195.293837, "o", "FileHash          string            `json:\"file_hash\"` // SHA-256 hex of entire file\r\n\tSigned            bool              `json:\"-\"`\r\n\tTensors           []TensorInfo      `json:\"tensors\"`\r\n\tMetadataMap       map[string]string `json:\"-\"` // key-value pairs from metadata section\r\n\tProvenance        *Provenance       `json:\"-\"`\r\n\tHasParent         bool              `json:\"has_parent\"`\r\n\tParentHex         string            `json:\"parent_hash\"` // same as Provenance.ParentHash\r\n}\r\n"]
[7195.294346, "o", "\u001b[?2004h"]
[7195.294429, "o", "root@n30009:/app# "]
[7195.57284, "i", "sed -n '1,260p' internal/forensics/forensics.go\n"]
[7195.573297, "o", "sed -n '1,260p' internal/forensics/forensics.go\r\n\u001b[?2004l\r"]
[7195.576691, "o", "package forensics\r\n\r\nimport (\r\n\t\"crypto/hmac\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n"]
[7195.576846, "o", "\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"mlforge/internal/checkpoint\"\r\n\t\"mlforge/internal/logparser\"\r\n\t\"mlforge/internal/types\"\r\n)\r\n\r\ntype ArtifactPaths struct {\r\n\tCheckpoints []string\r\n\tLogs        []string\r\n\tConfigs     []string\r\n}\r\n\r\nfunc DiscoverArtifacts(dir string) (ArtifactPaths, error) {\r\n\tvar ap ArtifactPaths\r\n\terr := filepath.WalkDir(dir, func(path string, d os.DirEntry, err error) error {\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t\tif d.IsDir() {\r\n\t\t\treturn nil\r\n\t\t}\r\n\t\tname := d.Name()\r\n\t\tlower := strings.ToLower(name)\r\n\t\tswitch {\r\n\t\tcase strings.HasSuffix(lower, \".mlck\"):\r\n\t\t\tap.Checkpoints = append(ap.Checkpoints, path)\r\n\t\tcase strings.HasSuffix(lower, \".jsonl\"):\r\n"]
[7195.576926, "o", "\t\t\tap.Logs = append(ap.Logs, path)\r\n\t\tcase strings.HasPrefix(name, \"config_\") && strings.HasSuffix(lower, \".json\"):\r\n\t\t\tap.Configs = append(ap.Configs, path)\r\n\t\t}\r\n\t\treturn nil\r\n\t})\r\n\tif err != nil {\r\n\t\treturn ap, err"]
[7195.577059, "o", "\r\n\t}\r\n\tsort.Strings(ap.Checkpoints)\r\n\tsort.Strings(ap.Logs)\r\n\tsort.Strings(ap.Configs)\r\n\treturn ap, nil\r\n}\r\n\r\ntype IngestCheckpoint struct {\r\n\tFile              string                 `json:\"file\"`\r\n\tFileHash          string                 `json:\"file_hash\"`\r\n\tVersion           uint32                 `json:\"version\"`\r\n"]
[7195.577145, "o", "\tNumTensors        uint32                 `json:\"num_tensors\"`\r\n\tNumMetadata       uint32                 `json:\"num_metadata\"`\r\n\tSigned            bool                   `json:\"signed\"`\r\n\tCreationTimestamp string                 `json:\"creation_timestamp\"`\r\n\tProvenance        map[string]interface{} `json:\"provenance\"`\r\n}\r\n\r\ntype IngestLogShard struct {\r\n\tFile       string   `json:\"file\"`\r\n\tEntries    int      `json:\"entries\"`\r\n\tStepRange  []int    `json:\"step_range\"`\r\n\tEpochRange []int    `json:\"epoch_range\"`\r\n\tTimeRange  []string `json:\"time_range\"`\r\n}\r\n\r\ntype IngestConfig struct {\r\n\tFile      string `json:\"file\"`\r\n\tModelName string `json:\"model_name\"`\r\n\tDataset   string `json:\"dataset\"`\r\n"]
[7195.577229, "o", "}\r\n\r\ntype IngestOutput struct {\r\n\tStatus      string `json:\"status\"`\r\n\tEvidenceDir string `json:\"evidence_dir\"`\r\n\tArtifacts   struct {\r\n\t\tCheckpoints []IngestCheckpoint `json:\"checkpoints\"`\r\n\t\tLogShards   []IngestLogShard   `json:\"log_shards\"`\r\n\t\tConfigs     []IngestConfig     `json:\"configs\"`\r\n\t} `json:\"artifacts\"`\r\n\tTotals struct {\r\n\t\tCheckpoints int `json:\"checkpoints\"`\r\n\t\tLogShards   int `json:\"log_shards\"`\r\n"]
[7195.577305, "o", "\t\tConfigs     int `json:\"configs\"`\r\n\t} `json:\"totals\"`\r\n}\r\n\r\nfunc BuildIngest(dir string) (interface{}, error) {\r\n\tap, err := DiscoverArtifacts(dir)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif len(ap.Checkpoints) == 0 && len(ap.Logs) == 0 && len(ap.Configs) == 0 {\r\n\t\treturn nil, fmt.Errorf(\"no recognizable artifacts found in %s\", dir)\r\n\t}\r\n\r\n"]
[7195.577382, "o", "\tvar out IngestOutput\r\n\tout.Status = \"ok\"\r\n\tout.EvidenceDir = dir\r\n\tout.Artifacts.Checkpoints = []IngestCheckpoint{}\r\n\tout.Artifacts.LogShards = []IngestLogShard{}\r\n\tout.Artifacts.Configs = []IngestConfig{}\r\n\r\n\tfor _, p := range ap.Checkpoints {\r\n\t\tcf, err := checkpoint.Parse(p)\r\n\t\tif err != nil || cf == nil {\r\n\t\t"]
[7195.577451, "o", "\tcontinue\r\n\t\t}\r\n\t\tic := IngestCheckpoint{\r\n\t\t\tFile:              cf.Filename,\r\n\t\t\tFileHash:          cf.FileHash,\r\n\t\t\tVersion:           cf.Version,\r\n\t\t\tNumTensors:        cf.NumTensors,\r\n\t\t\tNumMetadata:       cf.NumMetadataKeys,\r\n\t\t\tSigned:            cf.Signed,\r\n\t\t\tCreationTimestamp: unixToISO(cf.CreationTimestamp),\r\n"]
[7195.577516, "o", "\t\t\tProvenance:        provenanceToMap(cf.Provenance),\r\n\t\t}\r\n\t\tout.Artifacts.Checkpoints = append(out.Artifacts.Checkpoints, ic)\r\n\t}\r\n\tsort.Slice(out.Artifacts.Checkpoints, func(i, j int) bool {\r\n\t\treturn out.Artifacts.Checkpoints[i].CreationTimestamp < out.Artifacts.Checkpoints[j].CreationTimestamp\r\n\t})\r\n\r\n\tfor _, p := range ap.Logs {\r\n\t\tinfo, entries, err := parseShardRecursive(p)\r\n\t\tif err != nil {\r\n"]
[7195.577584, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tshard := IngestLogShard{\r\n\t\t\tFile:    info.File,\r\n\t\t\tEntries: info.Entries,\r\n\t\t}\r\n\t\tif info.Entries > 0 {\r\n\t\t\tshard.StepRange = []int{info.MinStep, info.MaxStep}\r\n\t\t\tshard.EpochRange = []int{info.MinEpoch, info.MaxEpoch}\r\n\t\t\tif info.MinTs != \"\" || info.MaxTs != \"\" {\r\n\t\t\t\tshard.TimeRange = []string{info.MinTs, info.MaxTs}\r\n"]
[7195.577652, "o", "\t\t\t}\r\n\t\t}\r\n\t\t_ = entries\r\n\t\tout.Artifacts.LogShards = append(out.Artifacts.LogShards, shard)\r\n\t}\r\n\tsort.Slice(out.Artifacts.LogShards, func(i, j int) bool {\r\n\t\treturn out.Artifacts.LogShards[i].File < out.Artifacts.LogShards[j].File\r\n\t})\r\n\r\n\tfor _, p := range ap.Configs {\r\n"]
[7195.577717, "o", "\t\tcfg, err := readConfigSummary(p)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tout.Artifacts.Configs = append(out.Artifacts.Configs, cfg)\r\n\t}\r\n\tsort.Slice(out.Artifacts.Configs, func(i, j int) bool {\r\n\t\treturn out.Artifacts.Configs[i].File < out.Artifacts.Configs[j].File\r\n\t})\r\n\r\n\tout.Totals.Checkpoints = len(out.Artifacts.Checkpoints)\r\n\tout.Totals.LogShards = len(out.Artifacts.LogShards)\r\n"]
[7195.577782, "o", "\tout.Totals.Configs = len(out.Artifacts.Configs)\r\n\treturn out, nil\r\n}\r\n\r\ntype TimelineGap struct {\r\n\tAfterStep  int    `json:\"after_step\"`\r\n\tBeforeStep int    `json:\"before_step\"`\r\n\tEpoch      int    `json:\"epoch\"`\r\n\tGapSteps   int    `json:\"gap_steps\"`\r\n\tAfterTs    string `json:\"after_ts\"`\r\n\tBeforeTs   string `json:\"before_ts\"`\r\n}\r\n\r\ntype TimelineOutput struct {\r\n"]
[7195.577849, "o", "\tStatus            string                `json:\"status\"`\r\n\tTotalEntries      int                   `json:\"total_entries\"`\r\n\tTotalEpochs       int                   `json:\"total_epochs\"`\r\n\tStepRange         []int                 `json:\"step_range\"`\r\n\tTimeRange         []string              `json:\"time_range\"`\r\n\tConflictsResolved int                   `json:\"conflicts_resolved\"`\r\n\tGaps              []TimelineGap         `json:\"gaps\"`\r\n\tEntries           []types.TimelineEntry `json:\"entries\"`\r\n}\r\n\r\nfunc BuildTimeline(dir string) (interface{}, error) {\r\n\tentries, shards, err := loadTimelineEntries(dir)\r\n"]
[7195.578096, "o", "\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn buildTimelineFromEntries(entries, shards), nil\r\n}\r\n\r\nfunc buildTimelineFromEntries(entries []types.TimelineEntry, shards []logparser.ShardInfo) TimelineOutput {\r\n\tmerged, conflicts := mergeTimeline(entries)\r\n\tsortTimeline(merged)\r\n\tgaps := detectGaps(merged)\r\n\r\n\tout := TimelineOutput{\r\n\t\tStatus:            \"ok\",\r\n\t\tTotalEntries:      len(merged),\r\n\t\tConflictsResolved: conflicts,\r\n\t\tGaps:              gaps,\r\n\t\tEntries:           merged,\r\n\t}\r\n\tif len(merged) > 0 {\r\n\t\tminStep, maxStep := merged[0].Step, merged[0].Step\r\n\t\tminTs, maxTs := merged[0].Ts, merged[0].Ts\r\n\t\tepochSet := map[int]struct{}{}\r\n\t\tfor _, e := range merged {\r\n\t\t\tepochSet[e.Epoch] = struct{}{}\r\n\t\t\tif e.Step < minStep {\r\n\t\t\t\tminStep = e.Step\r\n\t\t\t}\r\n\t\t\tif e.Step > maxStep {\r\n\t\t\t\tmaxStep = e.Step\r\n\t\t\t}\r\n\t\t\tif e.Ts < minTs {\r\n\t\t\t\tminTs = e.Ts\r\n\t\t\t}\r\n\t\t\tif e.Ts > maxTs {\r\n"]
[7195.578266, "o", "\t\t\t\tmaxTs = e.Ts\r\n\t\t\t}\r\n\t\t}\r\n\t\tout.TotalEpochs = len(epochSet)\r\n\t\tout.StepRange = []int{minStep, maxStep}\r\n\t\tout.TimeRange = []string{minTs, maxTs}\r\n\t}\r\n\tif out.Gaps == nil {\r\n\t\tout.Gaps = []TimelineGap{}\r\n\t}\r\n\tif out.Entries == nil {\r\n\t\tout.Entries = []types.TimelineEntry{}\r\n\t}\r\n\treturn out\r\n}\r\n\r\ntype VerifyIssue struct {\r\n\tType   string `json:\"type\"`\r\n\tDetail string `json:\"detail\"`\r\n}\r\n\r\ntype VerifyCheckpoint struct {\r\n\tFile                 string        `json:\"file\"`\r\n\tValid                bool          `json:\"valid\"`\r\n\tHeaderChecksumValid  bool          `json:\"header_checksum_valid\"`\r\n\tTensorChecksumsValid bool          `json:\"tensor_checksums_valid\"`\r\n\tSignatureValid       *bool         `json:\"signature_valid\"`\r\n\tProvenanceValid      bool          `json:\"provenance_valid\"`\r\n\tIssues               []VerifyIssue `json:\"issues\"`\r\n}\r\n"]
[7195.578861, "o", "\u001b[?2004h"]
[7195.578964, "o", "root@n30009:/app# "]
[7195.883049, "i", "sed -n '1,260p' docs/output_schema.md\n"]
[7195.883406, "o", "sed -n '1,260p' docs/output_schema.md\r\n\u001b[?2004l\r"]
[7195.88624, "o", "# Output Schemas\r\n\r\nAll commands output JSON to stdout. This document defines the exact JSON structure for each command.\r\n\r\n---\r\n\r\n## 1. Ingest Output\r\n\r\n```json\r\n{"]
[7195.886477, "o", "\r\n  \"status\": \"ok\",\r\n  \"evidence_dir\": \"/path/to/evidence\",\r\n  \"artifacts\": {\r\n    \"checkpoints\": [\r\n      {\r\n        \"file\": \"model_epoch1.mlck\",\r\n        \"file_hash\": \"a1b2c3...\",\r\n        \"version\": 1,\r\n        \"num_tensors\": 12,\r\n        \"num_metadata\": 3,\r\n        \"signed\": false,\r\n        \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n        \"provenance\": {\r\n          \"epoch\": 1,\r\n          \"global_step\": 5000,\r\n          \"framework\": \"PyTorch\",\r\n          \"framework_version\": \"2.1.0\",\r\n          \"parent_hash\": \"\"\r\n        }\r\n      }\r\n    ],\r\n    \"log_shards\": [\r\n      {\r\n        \"file\": \"shard_001.jsonl\",\r\n        \"entries\": 500,\r\n        \"step_range\": [0, 5000],\r\n        \"epoch_range\": [0, 1],\r\n        \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-15T10:00:00Z\"]\r\n      }\r\n    ],\r\n    \"configs\": [\r\n      {\r\n        \"file\": \"config_train.json\",\r\n        \"model_name\": \"resnet50\",\r\n"]
[7195.886585, "o", "        \"dataset\": \"imagenet-1k\"\r\n      }\r\n    ]\r\n  },\r\n  \"totals\": {\r\n    \"checkpoints\": 3,\r\n    \"log_shards\": 4,\r\n    \"configs\": 1\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `file_hash`: SHA-256 hex of the entire `.mlck` file content.\r\n- `checkpoints` array: sorted by `creation_timestamp` ascending.\r\n- `log_shards` array: sorted by `file` name lexicographically.\r\n- `configs` array: sorted by `file` name lexicographically.\r\n- `step_range`: `[min_step, max_step]` across all entries in the shard.\r\n"]
[7195.88668, "o", "- `epoch_range`: `[min_epoch, max_epoch]` across all entries.\r\n- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.\r\n\r\n---\r\n\r\n## 2. Timeline Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"total_entries\": 1200,\r\n  \"total_epochs\": 5,\r\n  \"step_range\": [0, 50000],\r\n  \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-17T14:00:00Z\"],\r\n  \"conflicts_resolved\": 3,\r\n  \"gaps\": [\r\n    {\r\n      \"after_step\": 5000,\r\n      \"before_step\": 5200,\r\n      \"epoch\": 1,\r\n      \"gap_steps\": 200,\r\n      \"after_ts\": \"2024-01-15T10:00:00Z\",\r\n      \"before_ts\": \"2024-01-15T13:00:00Z\"\r\n    }"]
[7195.886747, "o", "\r\n  ],\r\n  \"entries\": [\r\n    {\r\n      \"ts\": \"2024-01-15T08:00:00Z\",\r\n      \"epoch\": 0,\r\n      \"step\": 0,\r\n      \"loss\": 6.9078,\r\n      \"lr\": 0.001,\r\n      \"grad_norm\": 12.34,\r\n      \"acc\": 0.001,\r\n      \"event\": \"step\",\r\n      \"sources\": [\"shard_001.jsonl\"],\r\n      \"conflict\": false\r\n"]
[7195.886817, "o", "    }\r\n  ]\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `entries`: sorted by `(epoch ASC, step ASC)`.\r\n- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.\r\n- `conflict`: `true` if this entry was chosen by conflict resolution.\r\n- `gaps`: only gaps where `gap_steps > 100` within the same epoch.\r\n- Entries with missing optional fields omit them from the JSON (do not include null).\r\n\r\n---\r\n"]
[7195.886875, "o", "\r\n## 3. Verify Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"checkpoints\": [\r\n    {\r\n      \"file\": \"model_epoch1.mlck\",\r\n      \"valid\": true,\r\n      \"header_checksum_valid\": true,\r\n      \"tensor_checksums_valid\": true,\r\n      \"signature_valid\": null,\r\n      \"provenance_valid\": true,\r\n      \"issues\": []\r\n    },\r\n"]
[7195.886946, "o", "    {\r\n      \"file\": \"model_epoch3.mlck\",\r\n      \"valid\": false,\r\n      \"header_checksum_valid\": true,\r\n      \"tensor_checksums_valid\": false,\r\n      \"signature_valid\": true,\r\n      \"provenance_valid\": true,\r\n      \"issues\": [\r\n        {\"type\": \"tensor_checksum_mismatch\", \"detail\": \"encoder.layer2.weight\"}\r\n      ]\r\n    }\r\n  ],"]
[7195.88698, "o", "\r\n  \"summary\": {\r\n    \"total\": 3,\r\n    \"valid\": 2,\r\n    \"invalid\": 1\r\n  }\r\n}\r\n```\r\n"]
[7195.887039, "o", "\r\n**Field rules:**\r\n- `checkpoints`: sorted by `file` name lexicographically.\r\n- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.\r\n"]
[7195.887092, "o", "- `issues`: list of issue objects with `type` (string) and `detail` (string). For example, a tensor checksum mismatch appears as `{\"type\": \"tensor_checksum_mismatch\", \"detail\": \"<tensor_name>\"}`.\r\n- `valid`: `true` only if all applicable checks pass.\r\n\r\n---\r\n\r\n## 4. Detect Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n"]
[7195.887144, "o", "  \"anomalies\": [\r\n    {\r\n      \"id\": \"ANOM-001\",\r\n      \"type\": \"gradient_spike\",\r\n      \"severity\": \"high\",\r\n      \"epoch\": 2,\r\n      \"step\": 3456,\r\n      \"details\": {\r\n        \"observed\": 15.3,\r\n        \"ewma_mean\": 1.2,\r\n"]
[7195.887195, "o", "        \"ewma_stddev\": 0.3,\r\n        \"z_score\": 47.0\r\n      },\r\n      \"evidence\": {\r\n        \"window_values\": [1.1, 1.3, 1.0, 1.2, 1.4]\r\n      },\r\n      \"source\": \"shard_002.jsonl\"\r\n    },\r\n    {\r\n      \"id\": \"ANOM-002\",\r\n"]
[7195.887247, "o", "      \"type\": \"tensor_checksum_mismatch\",\r\n      \"severity\": \"critical\",\r\n      \"details\": {\r\n        \"file\": \"model_epoch3.mlck\",\r\n        \"tensor_name\": \"encoder.layer2.weight\",\r\n        \"expected_checksum\": \"abcd1234...\",\r\n        \"actual_checksum\": \"efgh5678...\"\r\n      },\r\n      \"evidence\": {},\r\n      \"source\": \"model_epoch3.mlck\",\r\n      \"checkpoint\": \"model_epoch3.mlck\"\r\n"]
[7195.887299, "o", "    }\r\n  ],\r\n  \"summary\": {\r\n    \"total\": 5,\r\n    \"by_severity\": {\r\n      \"critical\": 1,\r\n      \"high\": 2,\r\n      \"medium\": 1,\r\n      \"info\": 1\r\n    },\r\n"]
[7195.88735, "o", "    \"by_type\": {\r\n      \"gradient_spike\": 1,\r\n      \"loss_divergence\": 1,\r\n      \"tensor_checksum_mismatch\": 1,\r\n      \"training_gap\": 1,\r\n      \"lr_anomaly\": 1\r\n    }\r\n  }\r\n}\r\n```\r\n"]
[7195.887405, "o", "\r\n**Field rules:**\r\n- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.\r\n- `anomalies`: sorted by severity (`critical` > `high` > `medium` > `low` > `info`), then `type` alphabetically, then `epoch` ascending, then `step` ascending.\r\n- Severity order is `critical` > `high` > `medium` > `low` > `info`. `--filter-severity LEVEL` returns anomalies at the specified severity level or above: `critical` returns only `critical`; `high` returns `critical` and `high`; `medium` returns `critical`, `high`, and `medium`; `low` returns `critical`, `high`, `medium`, and `low`; `info` returns all severities.\r\n- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.\r\n- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.\r\n"]
[7195.887464, "o", "- `evidence`: sibling of `id`, `type`, `severity`, `details`, and `source`; never nested inside `details`. Timeline-based anomalies include `window_values`, an array of up to 5 preceding metric values at the point of anomaly detection. `gradient_spike` uses preceding `grad_norm` values, `loss_divergence` uses preceding `loss` values, and other timeline-based anomalies may use an empty array when no meaningful preceding window is available. Checkpoint-based anomalies, such as `tensor_checksum_mismatch`, must have an empty evidence object: `{}`.\r\n- `source`: the artifact file where the anomaly was detected.\r\n- `epoch` and `step`: present only for timeline-based anomalies.\r\n- `checkpoint`: present when the anomaly is related to a specific checkpoint file; omitted for timeline-based anomalies that are not checkpoint-specific.\r\n- `summary.by_severity` includes counts only for severities present in the returned anomaly list, including `info` when info-level anomalies are returned.\r\n- `summary`: reflects the filtere"]
[7195.88752, "o", "d anomaly list when `--filter-severity` is supplied.\r\n- If no anomalies are detected, `anomalies` is an empty array.\r\n\r\n### Detect CSV Output\r\n\r\nWhen `--format csv` is used with `detect`, the command outputs CSV instead of JSON. The CSV header is exactly:\r\n\r\n```text\r\nid,type,severity,epoch,step,source,checkpoint\r\n```\r\n\r\nOne header row is followed by one data row per anomaly. Each data row has 7 comma-separated fields in that order. Leave `epoch`, `step`, or `checkpoint` empty when the anomaly does not have that field. Severity filtering with `--filter-severity LEVEL` applies before CSV output, so the rows reflect only the filtered anomaly list.\r\n\r\n---\r\n\r\n## 5. Lineage Output\r\n\r\n```json"]
[7195.887571, "o", "\r\n{\r\n  \"status\": \"ok\",\r\n  \"nodes\": [\r\n    {\r\n      \"file\": \"model_epoch1.mlck\",\r\n      \"file_hash\": \"a1b2c3...\",\r\n      \"epoch\": 1,\r\n      \"global_step\": 5000,\r\n"]
[7195.887623, "o", "      \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n      \"parent_hash\": \"\",\r\n      \"is_root\": true,\r\n      \"is_leaf\": false,\r\n      \"is_orphan\": false\r\n    }\r\n  ],\r\n  \"edges\": [\r\n    {\r\n"]
[7195.887673, "o", "      \"from\": \"a1b2c3...\",\r\n"]
[7195.888187, "o", "\u001b[?2004h"]
[7195.888222, "o", "root@n30009:/app# "]
[7196.176812, "i", "sed -n '1,260p' docs/spec.md\n"]
[7196.177137, "o", "sed -n '1,260p' docs/spec.md\r\n\u001b[?2004l\r"]
[7196.178947, "o", "# mlforge - ML Model Artifact Forensics Engine\r\n\r\n## Overview\r\n\r\n`mlforge` is a command-line tool for forensic analysis of machine learning model artifacts. Given a directory of evidence (model checkpoints, training log shards, configuration files), mlforge reconstructs training timelines, detects anomalies, verifies artifact integrity, builds model lineage graphs, and produces evidence-backed forensic reports.\r\n\r\n## CLI Interface\r\n\r\nThe binary is built as `mlforge` and placed at `/app/mlforge` (or on `$PATH` after `go install`).\r\n\r\n```\r\nmlforge <command> <evidence-dir> [flags]\r\n```\r\n\r\n### Commands\r\n\r\n"]
[7196.179081, "o", "| Command | Description |\r\n|---------|-------------|\r\n| `ingest` | Scan evidence directory, index all artifacts, print summary to stdout |\r\n| `timeline` | Reconstruct unified training timeline from log shards |\r\n| `verify` | Verify integrity of all checkpoint files |\r\n| `detect` | Run anomaly detection across all evidence |\r\n| `lineage` | Build and output model lineage DAG |\r\n| `query` | Query the unified timeline with filter expressions |\r\n| `report` | Generate full forensic report combining all analyses |\r\n\r\n### Global Flags\r\n\r\n| Flag | Type | Default | Description |\r\n|------|------|---------|-------------|\r\n| `--format` | string | `json` | Output format: `json`, `text`, or `csv` (`csv` is supported only by `detect`) |\r\n| `--verbose` | bool | false | Enable verbose diagnostic output to stderr |\r\n\r\n### Command-Specific Behavior\r\n\r\n#### `ingest`\r\n\r\nScan `<evidence-dir>` recursively for:\r\n- `.mlck` files (model checkpoints)\r\n- `.jsonl` files (training log shards)\r\n- `.json` files matching `config_*.json` (trai"]
[7196.179178, "o", "ning configurations)\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Ingest Output\".\r\n\r\nIf the evidence directory does not exist or contains no recognizable artifacts, exit with code 1 and print an error to stderr.\r\n\r\n#### `timeline`\r\n\r\nParse all `.jsonl` log shards in `<evidence-dir>`, merge entries into a unified timeline.\r\n\r\n**Merge Rules** (detailed in `/app/docs/analysis_rules.md` section \"Timeline Reconstruction\"):\r\n- Entries are identified by `(epoch, step)` tuple\r\n- When multiple shards contain the same `(epoch, step)`, apply conflict resolution\r\n- Gaps in the step sequence are detected and reported\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Timeline Output\".\r\n\r\n#### `verify`\r\n\r\nFor each `.mlck` file in `<evidence-dir>`:\r\n1. Parse the file according to the MLCK format (see `/app/docs/formats.md`)\r\n2. Validate the header checksum\r\n3. Validate each tensor's SHA-256 data checksum\r\n4. If the file is signed (Flags bit 0), validate the HMAC-SHA256 signature\r\n"]
[7196.179261, "o", "5. Validate provenance fields are well-formed\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Verify Output\".\r\n\r\n#### `detect`\r\n\r\nRun all anomaly detection rules (defined in `/app/docs/analysis_rules.md`) across the evidence:\r\n- Timeline-based anomalies (from log shards)\r\n- Checkpoint integrity anomalies (from .mlck files)\r\n- Cross-artifact anomalies (correlating checkpoints with logs)\r\n\r\nEvery anomaly object includes a top-level `evidence` field. Timeline-based anomalies include `window_values` with up to 5 preceding metric values at the point of detection. `gradient_spike` uses preceding `grad_norm` values, `loss_divergence` uses preceding `loss` values, and other timeline-based anomalies may use an empty array when no meaningful preceding window is available. Checkpoint-based anomalies have an empty `evidence` object.\r\n\r\nDetect-specific flags:\r\n- `--format csv`: output CSV instead of JSON. The CSV header is exactly `id,type,severity,epoch,step,source,checkpoint`; one data row is emitt"]
[7196.179337, "o", "ed per anomaly. Leave `epoch`, `step`, or `checkpoint` empty when the anomaly does not have that field.\r\n- `--filter-severity LEVEL`: filter anomalies to show only those at the specified severity level or above. Severity order is `critical > high > medium > low > info`. For example, `--filter-severity high` shows only `critical` and `high` anomalies, while `--filter-severity critical` shows only `critical` anomalies. The returned JSON summary reflects the filtered anomaly list.\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Detect Output\".\r\n\r\n#### `lineage`\r\n\r\nBuild a directed acyclic graph of model checkpoint relationships using the `parent_hash` field from each checkpoint's provenance section.\r\n\r\n**Rules**:\r\n- Each checkpoint is a node identified by its SHA-256 file hash\r\n- An edge `A -> B` exists if B's `parent_hash` matches A's file hash\r\n- Root nodes have empty `parent_hash`\r\n- Orphan nodes reference a parent not present in the evidence set\r\n- If a cycle is detected, report it as a"]
[7196.179405, "o", "n anomaly (the graph should be a DAG)\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Lineage Output\".\r\n\r\n#### `query`\r\n\r\n```\r\nmlforge query <evidence-dir> \"<expression>\"\r\n```\r\n\r\nFilter the unified timeline using the query expression language defined in `/app/docs/analysis_rules.md` section \"Query Language\".\r\n\r\nOutput (JSON to stdout): list of matching timeline entries.\r\n\r\n#### `diff`\r\n\r\n```\r\nmlforge diff <evidence-dir> <file1> <file2>\r\n```\r\n\r\nCompare two checkpoint files inside `<evidence-dir>` tensor by tensor and write JSON to stdout. `file1` and `file2` are checkpoint filenames relative to `<evidence-dir>`.\r\n\r\nFor every tensor name present in either file, include one entry in `tensor_diffs`, sorted by tensor name lexicographically. `max_abs_diff` and `mean_abs_diff` are included only when both files contain the tensor and their shapes match.\r\n\r\nIf either checkpoint filename does not exist under `<evidence-dir>`, exit non-zero and print an error to stderr.\r\n\r\nOutput (JSON to stdout): "]
[7196.179473, "o", "see `/app/docs/output_schema.md` section \"Diff Output\".\r\n\r\n#### `report`\r\n\r\nGenerate a comprehensive forensic report by running all analyses (ingest, timeline, verify, detect, lineage) and combining results.\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Report Output\".\r\n\r\n## Exit Codes\r\n\r\n| Code | Meaning |\r\n|------|---------|\r\n| 0 | Success |\r\n| 1 | Input error (missing directory, no artifacts, invalid arguments) |\r\n| 2 | Parse error (corrupt or unreadable artifact) |\r\n\r\nWhen a parse error occurs for individual artifacts within a batch operation (e.g., one corrupt checkpoint among several), the tool should continue processing remaining artifacts, report the error in the output, and exit with code 0. Exit code 2 is only for cases where the error prevents any meaningful output.\r\n\r\n## Build\r\n\r\n```bash\r\ncd /app && go build -o mlforge ./cmd/mlforge\r\n```\r\n\r\n## Cross-References\r\n\r\n- Binary formats: `/app/docs/formats.md`\r\n- Detection algorithms and query language: `/app/docs/analysis_rules.m"]
[7196.179536, "o", "d`\r\n- JSON output schemas: `/app/docs/output_schema.md`\r\n"]
[7196.179752, "o", "\u001b[?2004h"]
[7196.179825, "o", "root@n30009:/app# "]
[7204.718491, "i", "sed -n '1,220p' cmd/mlforge/main.go\n"]
[7204.718804, "o", "sed -n '1,220p' cmd/mlforge/main.go\r\n\u001b[?2004l\r"]
[7204.721729, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[7204.721766, "o", "\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\r\n\t\"mlforge/internal/forensics\"\r\n)\r\n\r\nfunc main() {\r\n"]
[7204.721868, "o", "\t// --- Parse flags ---------------------------------------------------\r\n\tformat := \"json\"\r\n\tverbose := false\r\n\tfilterSeverity := \"\"\r\n\tvar positional []string\r\n\r\n\targs := os.Args[1:]\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tswitch {\r\n\t\tcase arg == \"--verbose\":\r\n\t\t\tverbose = true\r\n\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n"]
[7204.721929, "o", "\t\tcase arg == \"--format\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"flag --format requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ti++\r\n\t\t\tformat = args[i]\r\n\t\tcase strings.HasPrefix(arg, \"--filter-severity=\"):\r\n\t\t\tfilterSeverity = strings.TrimPrefix(arg, \"--filter-severity=\")\r\n"]
[7204.722023, "o", "\t\tcase arg == \"--filter-severity\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"flag --filter-severity requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ti++\r\n"]
[7204.722078, "o", "\t\t\tfilterSeverity = args[i]\r\n\t\tdefault:\r\n\t\t\tpositional = append(positional, arg)\r\n\t\t}\r\n\t}\r\n\r\n\tswitch format {\r\n\tcase \"json\", \"text\", \"csv\":\r\n\tdefault:\r\n"]
[7204.722132, "o", "\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json, text, or csv\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t_ = verbose // reserved for diagnostic output\r\n\r\n\t// --- Validate positional args --------------------------------------\r\n\tif len(positional) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n\t\tos.Exit(1)\r\n"]
[7204.722194, "o", "\t}\r\n\r\n\tcmd := positional[0]\r\n\tdir := positional[1]\r\n\r\n\tif format == \"csv\" && cmd != \"detect\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid format csv: csv output is only supported for detect\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif filterSeverity != \"\" && cmd != \"detect\" {\r\n"]
[7204.722256, "o", "\t\tfmt.Fprintf(os.Stderr, \"--filter-severity is only supported for detect\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t// --- Route to command handler --------------------------------------\r\n\tvar result interface{}\r\n\tvar err error\r\n\r\n\tswitch cmd {\r\n\tcase \"ingest\":\r\n\t\tresult, err = forensics.BuildIngest(dir)\r\n\tcase \"timeline\":\r\n"]
[7204.722309, "o", "\t\tresult, err = forensics.BuildTimeline(dir)\r\n\tcase \"verify\":\r\n\t\tresult, err = forensics.BuildVerify(dir)\r\n\tcase \"detect\":\r\n\t\tdetectResult, detectErr := forensics.BuildDetectFiltered(dir, filterSeverity)\r\n\t\tif detectErr != nil {\r\n\t\t\terr = detectErr\r\n"]
[7204.722362, "o", "\t\t} else {\r\n\t\t\tif format == \"csv\" {\r\n\t\t\t\tprintDetectCSV(detectResult)\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tresult = detectResult\r\n\t\t}\r\n\tcase \"lineage\":\r\n\t\tresult, err = forensics.BuildLineage(dir)\r\n"]
[7204.722415, "o", "\tcase \"query\":\r\n\t\tif len(positional) < 3 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tresult, err = forensics.BuildQuery(dir, positional[2])\r\n\tcase \"diff\":\r\n\t\tif len(positional) < 4 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge diff <dir> <file1> <file2>\\n\")\r\n"]
[7204.722467, "o", "\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tresult, err = forensics.BuildDiff(dir, positional[2], positional[3])\r\n\tcase \"report\":\r\n\t\tresult, err = forensics.BuildReport(dir)\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\t\tos.Exit(1)\r\n\t"]
[7204.722518, "o", "}\r\n\r\n\t// --- Output --------------------------------------------------------\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[7204.722569, "o", "\tif format == \"text\" {\r\n\t\tprintText(result)\r\n\t\treturn\r\n\t}\r\n\r\n\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n\tif marshalErr != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error marshalling result: %v\\n\", marshalErr)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[7204.722621, "o", "\tfmt.Println(string(out))\r\n}\r\n\r\nfunc printDetectCSV(result forensics.DetectOutput) {\r\n\tfmt.Println(\"id,type,severity,epoch,step,source,checkpoint\")\r\n\tfor _, a := range result.Anomalies {\r\n\t\tepoch := \"\"\r\n"]
[7204.722673, "o", "\t\tif a.Epoch != nil {\r\n\t\t\tepoch = strconv.Itoa(*a.Epoch)\r\n\t\t}\r\n\t\tstep := \"\"\r\n\t\tif a.Step != nil {\r\n\t\t\tstep = strconv.Itoa(*a.Step)\r\n\t\t}\r\n\t\tfmt.Printf(\"%s,%s,%s,%s,%s,%s,%s\\n\", a.ID, a.Type, a.Severity, epoch, step, a.Source, a.Checkpoint)\r\n\t}\r\n}\r\n"]
[7204.722724, "o", "\r\nfunc printText(v interface{}) {\r\n\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error rendering text output\")\r\n\t\treturn\r\n"]
[7204.72278, "o", "\t}\r\n\tfmt.Println(string(b))\r\n}\r\n"]
[7204.723228, "o", "\u001b[?2004h"]
