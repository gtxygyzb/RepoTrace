[3402.324899, "o", "\t\ta, ok := m[key]\r\n\t\tif !ok {\r\n\t\t\tsrc := map[string]struct{}{}\r\n\t\t\tfor _, s := range e.Sources {\r\n"]
[3402.324982, "o", "\t\t\t\tsrc[s] = struct{}{}\r\n\t\t\t}\r\n\t\t\tm[key] = &agg{entry: e, sources: src}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfor _, s := range e.Sources {\r\n\t\t\ta.sources[s] = struct{}{}\r\n\t\t}\r\n\t\tif metricsEqual(a.entry, e) {\r\n\t\t\tif e.Ts < a.entry.Ts {\r\n\t\t\t\ta.entry = e\r\n"]
[3402.325041, "o", "\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\ta.conflict = true\r\n\t\tif e.Ts < a.entry.Ts {\r\n\t\t\ta.entry = e\r\n\t\t}\r\n\t}\r\n"]
[3402.32551, "o", "\u001b[?2004h"]
