[6232.425687, "o", "   569\tfunc precedingLossValues(entries []types.TimelineEntry, indices []int, pos, n int) []float64 {\r\n   570\t\tvals := []float64{}\r\n   571\t\tstart := pos - n\r\n   572\t\tif start < 0 {\r\n   573\t\t\tstart = 0\r\n   574\t\t}\r\n   575\t\tfor j := start; j < pos; j++ {\r\n   576\t\t\tif j >= 0 && j < len(indices) && entries[indices[j]].Loss != nil {\r\n   577\t\t\t\tvals = append(vals, *entries[indices[j]].Loss)\r\n   578\t\t\t}\r\n   579\t\t}\r\n   580\t\treturn vals\r\n"]
