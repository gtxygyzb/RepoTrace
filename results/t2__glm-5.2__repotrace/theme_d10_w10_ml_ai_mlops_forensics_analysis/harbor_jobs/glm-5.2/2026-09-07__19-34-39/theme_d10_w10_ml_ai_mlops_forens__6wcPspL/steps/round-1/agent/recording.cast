[6211.442031, "o", "   134\tfunc detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n   135\t\tvar anomalies []types.Anomaly\r\n   136\t\tanomalies = append(anomalies, detectGradientSpikes(entries)...)\r\n   137\t\tanomalies = append(anomalies, detectLossDivergence(entries)...)\r\n   138\t\tanomalies = append(anomalies, detectLrAnomalies(entries)...)\r\n   139\t\tanomalies = append(anomalies, detectTrainingGaps(entries)...)\r\n"]
[6211.44213, "o", "   140\t\tanomalies = append(anomalies, detectMetricRegression(entries)...)\r\n   141\t\treturn anomalies\r\n   142\t}\r\n   143\t\r\n   144\tfunc detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n   145\t\tvar vals []float64\r\n   146\t\tvar idx []int\r\n   147\t\tfor i, e := range entries {\r\n   148\t\t\tif e.GradNorm != nil {\r\n   149\t\t\t\tvals = append(vals, *e.GradNorm)\r\n   150\t\t\t\tidx = append(idx, i)\r\n   151\t\t\t}\r\n   152\t\t}\r\n   153\t\tif len(vals) < 31 {\r\n   154\t\t\treturn nil\r\n   155\t\t}\r\n   156\t\tvar anomalies []types.Anomaly\r\n   157\t\tfor i := 30; i < len(vals); i++ {\r\n   158\t\t\twindow := vals[i-30 : i]\r\n   159\t\t\tmean := meanFloats(window)\r\n   160\t\t\tstd := stddevFloats(window, mean)\r\n   161\t\t\tobserved := vals[i]\r\n   162\t\t\tz := 0.0\r\n   163\t\t\tif std > 0 {\r\n   164\t\t\t\tz = (observed - mean) / std\r\n   165\t\t\t}\r\n   166\t\t\tif observed > mean+2.5*std && z > 2.5 {\r\n   167\t\t\t\tseverity := \"medium\"\r\n"]
[6211.4422, "o", "   168\t\t\t\tif z > 4.0 {\r\n   169\t\t\t\t\tseverity = \"high\"\r\n   170\t\t\t\t}\r\n   171\t\t\t\tep := entries[idx[i]].Epoch\r\n   172\t\t\t\tst := entries[idx[i]].Step\r\n   173\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   174\t\t\t\t\tType:     \"gradient_spike\",\r\n   175\t\t\t\t\tSeverity: severity,\r\n   176\t\t\t\t\tEpoch:    &ep,\r\n   177\t\t\t\t\tStep:     &st,\r\n   178\t\t\t\t\tDetails: map[string]interface{}{\r\n   179\t\t\t\t\t\t\"observed\":      observed,"]
[6211.442266, "o", "\r\n   180\t\t\t\t\t\t\"window_mean\":   mean,\r\n   181\t\t\t\t\t\t\"window_stddev\": std,\r\n   182\t\t\t\t\t\t\"z_score\":       z,\r\n   183\t\t\t\t\t},\r\n   184\t\t\t\t\t"]
[6211.442328, "o", "Evidence: map[string]interface{}{\"window_values\": lastValues(window, 5)},\r\n   185\t\t\t\t\tSource:   firstSource(entries[idx[i]]),\r\n   186\t\t\t\t})\r\n   187\t\t\t}\r\n   188\t\t}\r\n   189\t\treturn anomalies\r\n   190\t}\r\n   191\t\r\n   192\tfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n   193\t"]
[6211.442389, "o", "\tvar lossEntries []int\r\n   194\t\tfor i, e := range entries {\r\n   195\t\t\tif e.Loss != nil {\r\n   196\t\t\t\tlossEntries = append(lossEntries, i)\r\n   197\t\t\t}\r\n   198\t\t}\r\n   199\t\tif len(lossEntries) < 51 {\r\n   200\t\t\treturn nil\r\n   201\t\t}\r\n   202"]
[6211.442448, "o", "\t\tvar anomalies []types.Anomaly\r\n   203\t\tfor i := 50; i < len(lossEntries); i++ {\r\n   204\t\t\tstartIdx := lossEntries[i-50]\r\n   205\t\t\tendIdx := lossEntries[i]\r\n   206\t\t\tstart := *entries[startIdx].Loss\r\n   207\t\t\tend := *entries[endIdx].Loss\r\n   208\t\t\tif math.Abs(start) <= 1e-6 {\r\n"]
[6211.442516, "o", "   209\t\t\t\tcontinue\r\n   210\t\t\t}\r\n   211\t\t\tratio := (end - start) / math.Abs(start)\r\n   212\t\t\tif ratio > 1.0 {\r\n   213\t\t\t\tseverity := \"high\"\r\n   214\t\t\t\tif ratio > 5.0 {\r\n   215\t\t\t\t\tseverity = \"critical\"\r\n"]
[6211.442576, "o", "   216\t\t\t\t}\r\n   217\t\t\t\tep := entries[endIdx].Epoch\r\n   218\t\t\t\tst := entries[endIdx].Step\r\n   219\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   220\t\t\t\t\tType:     \"loss_divergence\",\r\n   221\t\t\t\t\tSeverity: severity,\r\n   222\t\t\t\t\tEpoch:    &ep,\r\n   223\t\t\t\t\tStep:     &st,\r\n   224\t\t\t\t\tDetails: map[string]interface{}{\r\n   225\t\t\t\t\t\t\"loss_start\":        start,\r\n   226\t\t\t\t\t\t\"loss_end\":          end,\r\n   227\t\t\t\t\t\t\"increase_ratio\":    ratio,\r\n   228\t\t\t\t\t\t"]
[6211.442637, "o", "\"window_start_step\": entries[startIdx].Step,\r\n   229\t\t\t\t\t\t\"window_end_step\":   entries[endIdx].Step,\r\n   230\t\t\t\t\t},\r\n   231\t\t\t\t\tEvidence: map[string]interface{}{\"window_values\": precedingLossValues(entries, lossEntries, i, 5)},\r\n   232\t\t\t\t\tSource:   firstSource(entries[endIdx]),\r\n   233\t\t\t\t})\r\n   234\t\t\t}\r\n   235"]
[6211.4427, "o", "\t\t}\r\n   236\t\treturn anomalies\r\n   237\t}\r\n   238\t\r\n   239\tfunc detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n   240\t\tvar anomalies []types.Anomaly\r\n   241\t\tfor i := 1; i < len(entries); i++ {\r\n   242\t\t\tprev := entries[i-1]\r\n   243\t\t\tcur := entries[i]\r\n"]
