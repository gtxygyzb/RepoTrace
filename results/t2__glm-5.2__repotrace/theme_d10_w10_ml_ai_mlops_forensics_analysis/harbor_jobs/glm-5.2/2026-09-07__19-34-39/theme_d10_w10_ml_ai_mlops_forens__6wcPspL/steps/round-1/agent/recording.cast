[5454.088482, "o", "\r\n   429\t\t\t\t}\r\n   430\t\t\t}\r\n   431\t\t}\r\n   432\t\r\n   433\t\tanomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)\r\n   434\t\treturn anomalies\r\n   435\t}\r\n   436\t\r\n   437\tfunc detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {\r\n   438\t\tbyHash := map[string]*types.CheckpointFile{}\r\n   439\t\tfor _, cf := range cps {\r\n   440\t\t\tbyHash[cf.FileHash] = cf\r\n"]
