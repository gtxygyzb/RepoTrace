[7347.392794, "o", "   134\t\r\n   135\t\tfor _, p := range ap.Logs {\r\n   136\t\t\tinfo, entries, err := parseShardRecursive(p)\r\n   137\t\t\tif err != nil {\r\n   138\t\t\t\tcontinue\r\n   139\t\t\t}\r\n   140\t\t\tshard := IngestLogShard{\r\n   141\t\t\t\tFile:    info.File,\r\n   142\t\t\t\tEntries: info.Entries,\r\n   143\t\t\t}\r\n   144\t\t\tif info.Entries > 0 {\r\n   145\t\t\t\tshard.StepRange = []int{info.MinStep, info.MaxStep}\r\n   146\t\t\t\tshard.EpochRange = []int{info.MinEpoch, info.MaxEpoch}\r\n   147\t\t\t\tif info.MinTs != \"\" || info.MaxTs != \"\" {\r\n   148\t\t\t\t\tshard.TimeRange = []string{info.MinTs, info.MaxTs}\r\n   149\t\t\t\t}\r\n   150\t\t\t}\r\n   151\t\t\t_ = entries\r\n   152\t\t\tout.Artifacts.LogShards = append(out.Artifacts.LogShards, shard)\r\n   153\t\t}\r\n   154\t\tsort.Slice(out.Artifacts.LogShards, func(i, j int) bool {\r\n   155\t\t\treturn out.Artifacts.LogShards[i].File < out.Artifacts.LogShards[j].File\r\n   156\t\t})\r\n   157\t\r\n   158\t\tfor _, p := range ap.Configs {\r\n   159"]
[7347.392866, "o", "\t\t\tcfg, err := readConfigSummary(p)\r\n   160\t\t\tif err != nil {\r\n   161\t\t\t\tcontinue\r\n   162\t\t\t}\r\n   163\t\t\tout.Artifacts.Configs = append(out.Artifacts.Configs, cfg)\r\n   164\t\t}\r\n   165\t\tsort.Slice(out.Artifacts.Configs, func(i, j int) bool {\r\n   166\t\t\treturn out.Artifacts.Configs[i].File < out.Artifacts.Configs[j].File\r\n   167\t\t})\r\n"]
[7347.393011, "o", "   168\t\r\n   169\t\tout.Totals.Checkpoints = len(out.Artifacts.Checkpoints)\r\n   170\t\tout.Totals.LogShards = len(out.Artifacts.LogShards)\r\n   171\t\tout.Totals.Configs = len(out.Artifacts.Configs)\r\n   172\t\treturn out, nil\r\n   173\t}\r\n   174\t\r\n   175\ttype TimelineGap struct {\r\n   176\t\tAfterStep  int    `json:\"after_step\"`\r\n   177\t\tBeforeStep int    `json:\"before_step\"`\r\n   178\t\tEpoch      int    `json:\"epoch\"`\r\n   179\t\tGapSteps   int    `json:\"gap_steps\"`\r\n   180\t\tAfterTs    string `json:\"after_ts\"`\r\n   181\t\tBeforeTs   string `json:\"before_ts\"`\r\n   182\t}\r\n   183\t\r\n"]
[7347.393085, "o", "   184\ttype TimelineOutput struct {\r\n   185\t\tStatus            string                `json:\"status\"`\r\n   186\t\tTotalEntries      int                   `json:\"total_entries\"`\r\n   187\t\tTotalEpochs       int                   `json:\"total_epochs\"`\r\n   188\t\tStepRange         []int                 `json:\"step_range\"`\r\n   189\t\tTimeRange         []string              `json:\"time_range\"`\r\n   190\t\tConflictsResolved int                   `json:\"conflicts_resolved\"`\r\n   191\t\tGaps              []TimelineGap         `json:\"gaps\"`\r\n   192\t\tEntries           []types.TimelineEntry `json:\"entries\"`\r\n   193\t}\r\n   194\t\r\n   195\tfunc BuildTimeline(dir string) (interface{}, error) {\r\n"]
[7347.393151, "o", "   196\t\tentries, shards, err := loadTimelineEntries(dir)\r\n   197\t\tif err != nil {\r\n   198\t\t\treturn nil, err\r\n   199\t\t}\r\n   200\t\treturn buildTimelineFromEntries(entries, shards), nil\r\n   201\t}\r\n   202\t\r\n   203\tfunc buildTimelineFromEntries(entries []types.TimelineEntry, shards []logparser.ShardInfo) TimelineOutput {\r\n"]
[7347.393211, "o", "   204\t\tmerged, conflicts := mergeTimeline(entries)\r\n   205\t\tsortTimeline(merged)\r\n   206\t\tgaps := detectGaps(merged)\r\n   207\t\r\n   208\t\tout := TimelineOutput{\r\n   209\t\t\tStatus:            \"ok\",\r\n   210\t\t\tTotalEntries:      len(merged),\r\n   211\t\t\tConflictsResolved: conflicts,\r\n"]
[7347.39327, "o", "   212\t\t\tGaps:              gaps,\r\n   213\t\t\tEntries:           merged,\r\n   214\t\t}\r\n   215\t\tif len(merged) > 0 {\r\n   216\t\t\tminStep, maxStep := merged[0].Step, merged[0].Step\r\n   217\t\t\tminTs, maxTs := merged[0].Ts, merged[0].Ts\r\n   218\t\t\tepochSet := map[int]struct{}{}\r\n   219\t\t\tfor _, e := range merged {\r\n   220\t\t\t\tepochSet[e.Epoch] = struct{}{}\r\n"]
