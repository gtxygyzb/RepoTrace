[5705.846026, "o", "\u001b[32m\u001b[K425\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t\t\"file\":        cf.Filename,\r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t\t\"parent_hash\": cf.Provenance.ParentHash,\r\n\u001b[32m\u001b[K427\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t\t\"found\":       false,\r\n"]
[5705.846083, "o", "\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t},\r\n\u001b[32m\u001b[K429\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tEvidence:   map[string]interface{}{},\r\n\u001b[32m\u001b[K430\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tSource:     cf.Filename,\r\n\u001b[32m\u001b[K431\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tCheckpoint: cf.Filename,"]
