[1963.979264, "o", "   160\t\t\tend := *entries[endIdx].Loss\r\n   161\t\t\tif math.Abs(start) <= 1e-6 {\r\n   162\t\t\t\tcontinue\r\n   163\t\t\t}\r\n   164\t\t\tratio := (end - start) / math.Abs(start)\r\n   165"]
[1963.979382, "o", "\t\t\tif ratio > 1.0 {\r\n   166\t\t\t\tseverity := \"high\"\r\n   167\t\t\t\tif ratio > 5.0 {\r\n   168\t\t\t\t\tseverity = \"critical\"\r\n   169\t\t\t\t}\r\n   170\t\t\t\tep := entries[endIdx].Epoch\r\n   171\t\t\t\tst := entries[endIdx].Step\r\n   172\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   173\t\t\t\t\tType:     \"loss_divergence\",\r\n   174\t\t\t\t\tSeverity: severity,\r\n   175\t\t\t\t\tEpoch:    &ep,\r\n   176\t\t\t\t\tStep:     &st,\r\n   177\t\t\t\t\tDetails: map[string]interface{}{\r\n   178\t\t\t\t\t\t\"loss_start\":        start,\r\n   179\t\t\t\t\t\t\"loss_end\":          end,\r\n"]
[1963.979459, "o", "   180\t\t\t\t\t\t\"increase_ratio\":    ratio,\r\n   181\t\t\t\t\t\t\"window_start_step\": entries[startIdx].Step,\r\n   182\t\t\t\t\t\t\"window_end_step\":   entries[endIdx].Step,\r\n   183\t\t\t\t\t},\r\n   184\t\t\t\t\tSource: firstSource(entries[endIdx]),\r\n   185\t\t\t\t})\r\n   186\t\t\t}\r\n   187\t\t}\r\n   188\t\treturn anomalies\r\n   189\t}\r\n   190\t"]
[1963.979524, "o", "\r\n   191\tfunc detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n   192\t\tvar anomalies []types.Anomaly\r\n   193\t\tfor i := 1; i < len(entries); i++ {\r\n   194\t\t\tprev := entries[i-1]\r\n   195\t\t\tcur := entries[i]\r\n   196\t\t\tif prev.Lr == nil || cur.Lr == nil {\r\n   197\t\t\t\tcontinue\r\n   198\t\t\t}\r\n"]
[1963.979589, "o", "   199\t\t\tif *cur.Lr > *prev.Lr {\r\n   200\t\t\t\tif cur.Event == \"epoch_end\" {\r\n   201\t\t\t\t\tcontinue\r\n   202\t\t\t\t}\r\n   203\t\t\t\tep := cur.Epoch\r\n   204\t\t\t\tst := cur.Step\r\n   205\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   206\t\t\t\t\tType:     \"lr_anomaly\",\r\n   207\t\t\t\t\tSeverity: \"medium\",\r\n"]
[1963.979647, "o", "   208\t\t\t\t\tEpoch:    &ep,\r\n   209\t\t\t\t\tStep:     &st,\r\n   210\t\t\t\t\tDetails: map[string]interface{}{\r\n   211\t\t\t\t\t\t\"prev_lr\": *prev.Lr,\r\n   212\t\t\t\t\t\t\"curr_lr\": *cur.Lr,\r\n   213\t\t\t\t\t\t\"step\":    cur.Step,\r\n   214\t\t\t\t\t},\r\n   215\t\t\t\t\tSource: firstSource(cur),\r\n"]
[1963.979711, "o", "   216\t\t\t\t})\r\n   217\t\t\t}\r\n   218\t\t}\r\n   219\t\treturn anomalies\r\n   220\t}\r\n   221\t\r\n   222\tfunc detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\r\n   223\t\tvar anomalies []types.Anomaly\r\n   224\t\tfor i := 1; i < len(entries); i++ {\r\n   225\t\t\tprev := entries[i-1]"]
[1963.979776, "o", "\r\n   226\t\t\tcur := entries[i]\r\n   227\t\t\tif prev.Epoch != cur.Epoch {\r\n   228\t\t\t\tcontinue\r\n   229\t\t\t}\r\n   230\t\t\tprevT, err1 := time.Parse(time.RFC3339, prev.Ts)\r\n   231\t\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\r\n   232\t\t\tif err1 != nil || err2 != nil {\r\n   233\t\t\t\tcontinue\r\n   234\t\t\t}\r\n   235"]
[1963.979832, "o", "\t\t\tdiff := curT.Sub(prevT).Seconds()\r\n   236\t\t\tif diff > 3600 {\r\n   237\t\t\t\tep := cur.Epoch\r\n   238\t\t\t\tst := cur.Step\r\n   239\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   240\t\t\t\t\tType:     \"training_gap\",\r\n   241\t\t\t\t\tSeverity: \"low\",\r\n"]
[1963.979889, "o", "   242\t\t\t\t\tEpoch:    &ep,\r\n   243\t\t\t\t\tStep:     &st,\r\n   244\t\t\t\t\tDetails: map[string]interface{}{\r\n   245\t\t\t\t\t\t\"after_step\":  prev.Step,\r\n   246\t\t\t\t\t\t\"before_step\": cur.Step,\r\n   247\t\t\t\t\t\t\"after_ts\":    prev.Ts,\r\n   248\t\t\t\t\t\t\"before_ts\":   cur.Ts,\r\n"]
[1963.979997, "o", "   249\t\t\t\t\t\t\"gap_seconds\": diff,\r\n   250\t\t\t\t\t},\r\n   251\t\t\t\t\tSource: firstSource(cur),\r\n   252\t\t\t\t})\r\n   253\t\t\t}\r\n   254\t\t}\r\n   255\t\treturn anomalies\r\n   256\t}\r\n   257\t\r\n   258\tfunc detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {\r\n   259\t\tvar cps []types.TimelineEntry\r\n   260\t\tfor _, e := range entries {\r\n   261\t\t\tif e.Event == \"checkpoint\" {\r\n   262\t\t\t\tcps = append(cps, e)\r\n"]
[1963.980056, "o", "   263\t\t\t}\r\n   264\t\t}\r\n   265\t\tsortTimeline(cps)\r\n   266\t\tvar anomalies []types.Anomaly\r\n   267\t\tfor i := 1; i < len(cps); i++ {\r\n   268\t\t\tprev := cps[i-1]\r\n   269\t\t\tcur := cps[i]\r\n   270\t\t\tif prev.Acc == nil || cur.Acc == nil {\r\n   271\t\t\t\tcontinue\r\n"]
[1963.980124, "o", "   272\t\t\t}\r\n   273\t\t\tdrop := *prev.Acc - *cur.Acc\r\n   274\t\t\tif drop > 0.15 {\r\n   275\t\t\t\tep := cur.Epoch\r\n   276\t\t\t\tst := cur.Step\r\n   277\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   278\t\t\t\t\tType:     \"metric_regression\",\r\n   279\t\t\t\t\tSeverity: \"high\",\r\n   280\t\t"]
[1963.980206, "o", "\t\t\tEpoch:    &ep,\r\n   281\t\t\t\t\tStep:     &st,\r\n   282\t\t\t\t\tDetails: map[string]interface{}{\r\n   283\t\t\t\t\t\t\"prev_acc\":        *prev.Acc,\r\n   284\t\t\t\t\t\t\"curr_acc\":        *cur.Acc,\r\n   285\t\t\t\t\t\t\"drop\":            drop,\r\n   286\t\t\t\t\t\t\"prev_checkpoint\": prev.Step,\r\n   287\t\t\t\t\t\t\"curr_checkpoint\": cur.Step,\r\n   288\t\t\t\t\t},\r\n"]
[1963.980286, "o", "   289\t\t\t\t\tSource: firstSource(cur),\r\n   290\t\t\t\t})\r\n   291\t\t\t}\r\n   292\t\t}\r\n   293\t\treturn anomalies\r\n   294\t}\r\n   295\t\r\n   296\tfunc detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {\r\n   297\t\tvar anomalies []types.Anomaly\r\n   298\t\thashSet := map[string]*types.CheckpointFile{}\r\n   299\t\tfor _, cf := range cps {\r\n   300\t\t\thashSet[cf.FileHash] = cf\r\n   301\t\t}\r\n"]
[1963.980367, "o", "   302\t\r\n   303\t\tfor _, cf := range cps {\r\n   304\t\t\traw, err := os.ReadFile(cf.Path)\r\n   305\t\t\tif err != nil {\r\n   306\t\t\t\tcontinue\r\n   307\t\t\t}\r\n   308\t\t\tif !cf.HeaderValid {\r\n   309\t\t\t\tstored := uint64(0)\r\n   310\t\t\t\tif len(raw) >= 56 {\r\n   311\t\t\t\t\tstored = binary.LittleEndian.Uint64(raw[48:56])\r\n   312\t\t\t\t}\r\n   313\t\t\t\th := fnv.New64a()\r\n   314"]
[1963.98045, "o", "\t\t\t\th.Write(raw[:48])\r\n   315\t\t\t\tcomputed := h.Sum64()\r\n   316\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   317\t\t\t\t\tType:     \"header_checksum_mismatch\",\r\n   318\t\t\t\t\tSeverity: \"critical\",\r\n   319\t\t\t\t\tDetails: map[string]interface{}{\r\n   320\t\t\t\t\t\t\"file\":              cf.Filename,\r\n   321\t\t\t\t\t\t\"expected_checksum\": fmt.Sprintf(\"%016x\", stored),\r\n"]
[1963.980531, "o", "   322\t\t\t\t\t\t\"actual_checksum\":   fmt.Sprintf(\"%016x\", computed),\r\n   323\t\t\t\t\t},\r\n   324\t\t\t\t\tSource: cf.Filename,\r\n   325\t\t\t\t})\r\n   326\t\t\t}\r\n   327\t\r\n   328\t\t\tfor _, t := range cf.Tensors {\r\n   329\t\t\t\tif !t.Valid {\r\n   330\t\t\t\t\tcomputed := sha256.Sum256(t.Data)\r\n   331\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n"]
[1963.980616, "o", "   332\t\t\t\t\t\tType:     \"tensor_checksum_mismatch\",\r\n   333\t\t\t\t\t\tSeverity: \"critical\",\r\n   334\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   335\t\t\t\t\t\t\t\"file\":              cf.Filename,\r\n   336\t\t\t\t\t\t\t\"tensor_name\":       t.Name,\r\n   337\t\t\t\t\t\t\t\"expected_checksum\": hex.EncodeToString(t.Hash[:]),\r\n   338\t\t\t\t\t\t\t\"actual_checksum\":   hex.EncodeToString(computed[:]),\r\n   339\t\t\t\t\t\t},\r\n   340\t\t\t\t\t\tSource: cf.Filename,\r\n"]
