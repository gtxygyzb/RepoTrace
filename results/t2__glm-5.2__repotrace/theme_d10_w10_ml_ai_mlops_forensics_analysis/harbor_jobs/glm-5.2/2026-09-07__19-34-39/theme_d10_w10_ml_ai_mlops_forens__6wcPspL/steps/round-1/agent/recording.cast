[3615.13382, "o", "   201\t\t\tq.ors = append(q.ors, cur)\r\n   202\t\t}\r\n   203\t\tif len(q.ors) == 0 || len(q.ors[0].ands) == 0 {\r\n   204\t\t\treturn query{}, fmt.Errorf(\"empty query\")\r\n   205\t\t}\r\n   206\t"]
[3615.133877, "o", "\treturn q, nil\r\n   207\t}\r\n   208\t\r\n   209\tfunc parseCondition(tokens []string, i int) (condition, int, error) {\r\n   210\t\tif i+2 >= len(tokens) {\r\n   211\t\t\treturn condition{}, i, fmt.Errorf(\"invalid query syntax\")\r\n   212\t\t}\r\n"]
[3615.13395, "o", "   213\t\tfield := tokens[i]\r\n   214\t\top := tokens[i+1]\r\n   215\t\tvalueTok := tokens[i+2]\r\n   216\t\r\n   217\t\tvalidFields := map[string]bool{\"step\": true, \"epoch\": true, \"loss\": true, \"lr\": true, \"grad_norm\": true, \"acc\": true, \"event\": true, \"ts\": true}\r\n   218\t\tif !validFields[field] {\r\n"]
[3615.134017, "o", "   219\t\t\treturn condition{}, i, fmt.Errorf(\"unknown field: %s\", field)\r\n   220\t\t}\r\n   221\t\tvalidOps := map[string]bool{\">\": true, \"<\": true, \">=\": true, \"<=\": true, \"==\": true, \"!=\": true}\r\n"]
