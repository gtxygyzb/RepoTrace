[2755.766546, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kdiff\u001b[m\u001b[K := curT.Sub(prevT).Seconds()\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif \u001b[01;31m\u001b[Kdiff\u001b[m\u001b[K > 3600 {\r\n"]
[2755.766622, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\"gap_seconds\": \u001b[01;31m\u001b[Kdiff\u001b[m\u001b[K,\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif e.Event == \"\u001b[01;31m\u001b[Kcheckpoint\u001b[m\u001b[K\" {\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K286\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\"prev_\u001b[01;31m\u001b[Kcheckpoint\u001b[m\u001b[K\": prev.Step,\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K287\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\"curr_\u001b[01;31m\u001b[Kcheckpoint\u001b[m\u001b[K\": cur.Step,\r\n"]
