[4433.682887, "o", "sort.Strings(chain)\r\n   437\t\r\n   438\t\t\thashes := map[string]struct{}{}\r\n   439\t\t\tfor _, h := range chain {\r\n   440\t\t\t\tif node, ok := byHashFile(cps, h); ok && node.Provenance != nil {\r\n   441\t\t\t\t\thashes[node.Provenance.DatasetHash] = struct{}{}\r\n   442\t\t\t\t}\r\n"]
