[3567.808722, "o", "   145\t\trt, err := time.Parse(time.RFC3339, c.sval)\r\n   146\t\tif err != nil {\r\n   147\t\t\treturn false\r\n   148\t\t}\r\n   149\t\tswitch c.op {\r\n   150\t\tcase \">\":\r\n   151\t\t\treturn lt.After(rt)\r\n   152\t\tcase \"<\":\r\n   153\t\t\treturn lt.Before(rt)\r\n   154\t\tcase \">=\":\r\n   155\t\t\treturn lt.After(rt) || lt.Equal(rt)\r\n   156\t\tcase \"<=\":\r\n   157\t\t\treturn lt.Before(rt) || lt.Equal(rt)\r\n   158\t\tcase \"==\":\r\n   159\t\t"]
[3567.808814, "o", "\treturn lt.Equal(rt)\r\n   160\t\tcase \"!=\":\r\n   161\t\t\treturn !lt.Equal(rt)\r\n   162\t\t}\r\n   163\t\treturn false\r\n"]
[3567.808878, "o", "   164\t}\r\n   165\t\r\n   166\tfunc absFloat(x float64) float64 {\r\n   167\t\tif x < 0 {\r\n   168\t\t\treturn -x\r\n   169\t\t}\r\n   170\t\treturn x\r\n   171\t}\r\n   172\t\r\n   173\tfunc parseQuery(expr string) (query, error) {\r\n   174\t\ttokens, err := tokenizeQuery(expr)\r\n   175\t\tif err != nil {\r\n   176\t\t\treturn query{}, err\r\n   177\t\t}\r\n   178\t\tvar q query\r\n   179\t\t"]
