[4479.559583, "o", "},\r\n\t\t\t\tSource: firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\thashSet := map[string]*types.CheckpointFile{}\r\n\tfor _, cf := range cps {\r\n\t\thashSet[cf.FileHash] = cf\r\n\t}\r\n\r\n\tfor _, cf := range cps {\r\n"]
[4479.55964, "o", "\t\traw, err := os.ReadFile(cf.Path)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif !cf.HeaderValid {\r\n\t\t\tstored := uint64(0)\r\n"]
[4479.559659, "o", "\t\t\tif len(raw) >= 56 {\r\n\t\t\t\tstored = binary.LittleEndian.Uint64(raw[48:56])\r\n\t\t\t}\r\n"]
