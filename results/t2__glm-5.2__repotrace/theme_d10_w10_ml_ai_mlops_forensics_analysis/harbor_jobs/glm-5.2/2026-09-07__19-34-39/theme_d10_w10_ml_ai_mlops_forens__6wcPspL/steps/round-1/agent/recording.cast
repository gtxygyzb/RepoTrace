[4512.615349, "o", "   329\t\t\tfor _, t := range cf.Tensors {\r\n   330\t\t\t\tif !t.Valid {\r\n   331\t\t\t\t\tcomputed := sha256.Sum256(t.Data)\r\n   332\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   333\t\t\t\t\t\tType:     \"tensor_checksum_mismatch\",\r\n   334\t"]
[4512.615466, "o", "\t\t\t\t\tSeverity: \"critical\",\r\n   335\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   336\t\t\t\t\t\t\t\"file\":              cf.Filename,\r\n   337\t\t\t\t\t\t\t\"tensor_name\":       t.Name,\r\n   338\t\t\t\t\t\t\t\"expected_checksum\": hex.EncodeToString(t.Hash[:]),\r\n   339\t\t\t\t\t\t\t\"actual_checksum\":   hex.EncodeToString(computed[:]),\r\n   340\t\t\t\t\t\t},\r\n   341\t\t\t\t\t\tSource:     cf.Filename,\r\n   342\t\t\t\t\t\tCheckpoint: cf.Filename,\r\n   343\t\t\t\t\t})\r\n   344\t\t\t\t}\r\n   345\t\t\t}\r\n   346\t\r\n   347\t\t\tif cf.Signed {\r\n   348\t\t\t\tvalid, signer := signatureDetails(cf.Path)\r\n   349"]
[4512.615544, "o", "\t\t\t\tif !valid {\r\n   350\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   351\t\t\t\t\t\tType:     \"signature_invalid\",\r\n   352\t\t\t\t\t\tSeverity: \"critical\",\r\n   353\t\t\t\t\t\tDetails: map[string]interface{}{\r\n"]
[4512.615611, "o", "   354\t\t\t\t\t\t\t\"file\":      cf.Filename,\r\n   355\t\t\t\t\t\t\t\"signer_id\": signer,\r\n   356\t\t\t\t\t\t\t\"valid\":     false,\r\n   357\t\t\t\t\t\t},\r\n   358\t\t\t\t\t\tSource:     cf.Filename,\r\n   359\t\t\t\t\t\tCheckpoint: cf.Filename,\r\n   360\t\t\t\t\t})\r\n   361\t\t\t\t}\r\n   362\t\t\t}\r\n   363\t\r\n   364\t\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n   365\t\t\t\t_, found := hashSet[cf.Provenance.ParentHash]\r\n"]
[4512.615679, "o", "   366\t\t\t\tif !found {\r\n   367\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   368\t\t\t\t\t\tType:     \"provenance_chain_break\",\r\n   369\t\t\t\t\t\tSeverity: \"high\",\r\n   370\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   371\t\t\t\t\t\t\t\"file\":        cf.Filename,\r\n   372\t\t\t\t\t\t\t\"parent_hash\": cf.Provenance.ParentHash,\r\n   373\t\t\t\t\t\t\t\"found\":       false,\r\n"]
[4512.615754, "o", "   374\t\t\t\t\t\t},\r\n   375\t\t\t\t\t\tSource:     cf.Filename,\r\n   376\t\t\t\t\t\tCheckpoint: cf.Filename,\r\n   377\t\t\t\t\t})\r\n   378\t\t\t\t}\r\n   379\t\t\t}\r\n   380\t\t}\r\n   381\t\r\n   382\t\tanomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)\r\n   383\t\treturn anomalies\r\n"]
[4512.615824, "o", "   384\t}\r\n   385\t\r\n   386\tfunc detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {\r\n   387\t\tbyHash := map[string]*types.CheckpointFile{}\r\n   388\t\tfor _, cf := range cps {\r\n"]
[4512.615884, "o", "   389\t\t\tbyHash[cf.FileHash] = cf\r\n   390\t\t}\r\n   391\t\tchildren := map[string][]string{}\r\n   392\t\tfor _, cf := range cps {\r\n   393\t\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n   394\t\t\t\tif _, ok := byHash[cf.Provenance.ParentHash]; ok {\r\n   395\t\t\t\t\tchildren[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)\r\n   396\t\t\t\t}\r\n   397\t\t\t}\r\n   398\t\t}\r\n   399\t\r\n   400\t\tvar anomalies []types.Anomaly\r\n   401\t\tseen := map[string]bool{}\r\n   402\t\tfor _, cf := range cps {\r\n   403"]
[4512.615996, "o", "\t\t\tif cf.Provenance == nil {\r\n   404\t\t\t\tcontinue\r\n   405\t\t\t}\r\n   406\t\t\troot := cf.FileHash\r\n   407\t\t\tfor root != \"\" {\r\n   408\t\t\t\tparent, ok := byHash[root]\r\n   409\t\t\t\tif !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == \"\" {\r\n   410\t\t\t\t\tbreak\r\n   411\t\t\t\t}\r\n   412\t\t\t\troot = parent.Provenance.ParentHash\r\n   413\t\t\t}\r\n   414\t\t\tif seen[root] {\r\n   415\t\t\t\tcontinue\r\n   416\t\t\t}\r\n"]
[4512.616064, "o", "   417\t\t\tseen[root] = true\r\n   418\t\r\n   419\t\t\tchain := []string{}\r\n   420\t\t\tqueue := []string{root}\r\n   421\t\t\tvisited := map[string]bool{}\r\n   422\t\t\tfor len(queue) > 0 {\r\n   423\t\t\t\tcur := queue[0]\r\n"]
[4512.616126, "o", "   424\t\t\t\tqueue = queue[1:]\r\n   425\t\t\t\tif visited[cur] {\r\n   426\t\t\t\t\tcontinue\r\n   427\t\t\t\t}\r\n   428\t\t\t\tvisited[cur] = true\r\n   429\t\t\t\tnode, ok := byHash[cur]\r\n   430\t\t\t\tif !ok || node == nil {\r\n   431\t\t\t\t\tcontinue\r\n   432\t\t\t\t}\r\n"]
