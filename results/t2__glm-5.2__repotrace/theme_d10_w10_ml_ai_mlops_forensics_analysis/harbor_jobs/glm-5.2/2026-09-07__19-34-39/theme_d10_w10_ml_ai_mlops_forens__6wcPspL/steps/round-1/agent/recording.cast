[7297.549174, "o", "     9\t\r\n    10\t\t\"mlforge/internal/checkpoint\"\r\n    11\t\t\"mlforge/internal/types\"\r\n    12\t)\r\n    13\t\r\n    14\t// diffTensorResult describes one tensor in the diff output.\r\n    15\ttype diffTensorResult struct {\r\n    16\t\tName        string   `json:\"name\"`\r\n    17\t\tShapeMatch  bool     `json:\"shape_match\"`\r\n    18\t\tShapeA      []uint32 `json:\"shape_a\"`\r\n    19\t\tShapeB      []uint32 `json:\"shape_b\"`\r\n    20\t\tMaxAbsDiff  *float64 `json:\"max_abs_diff,omitempty\"`\r\n    21\t\tMeanAbsDiff *float64 `json:\"mean_abs_diff,omitempty\"`\r\n    22\t}\r\n    23\t\r\n    24\t// diffSummary summarizes tensor presence and shape compatibility.\r\n    25\ttype diffSummary struct {\r\n    26\t\tTotalTensorsA   int      `json:\"total_tensors_a\"`\r\n    27\t\tTotalTensorsB   int      `json:\"total_tensors_b\"`\r\n    28\t\tCommonTensors   int      `json:\"common_tensors\"`\r\n    29\t\tShapeMismatches int      `json:\"shape_mismatches\"`\r\n    30\t\tOnlyInA         []string `json:\"only_in_a\"`\r\n    31\t\tOnlyInB         []string `json:\"only_in_b\"`\r\n    32\t}\r\n    33\t\r\n"]
[7297.549247, "o", "    34\t// diffOutput is the JSON output for the diff command.\r\n    35\ttype diffOutput struct {\r\n    36\t\tStatus      string             `json:\"status\"`\r\n    37\t\tFileA       string             `json:\"file_a\"`\r\n    38\t\tFileB       string             `json:\"file_b\"`\r\n    39\t\tTensorDiffs []diffTensorResult `json:\"tensor_diffs\"`\r\n    40\t\tSummary     diffSummary        `json:\"summary\"`\r\n    41\t}\r\n    42\t\r\n    43\tconst float32Dtype byte = 0\r\n"]
[7297.549308, "o", "    44\t\r\n    45\t// BuildDiff compares two checkpoint files inside evidenceDir tensor by tensor.\r\n    46\tfunc BuildDiff(evidenceDir, file1, file2 string) (interface{}, error) {\r\n    47\t\tpathA := filepath.Join(evidenceDir, file1)\r\n    48\t\tpathB := filepath.Join(evidenceDir, file2)\r\n"]
[7297.549368, "o", "    49\t\r\n    50\t\tcfA, err := checkpoint.Parse(pathA)\r\n    51\t\tif err != nil {\r\n    52\t\t\treturn nil, fmt.Errorf(\"diff: %s: %w\", file1, err)\r\n    53\t\t}\r\n    54\t\tif cfA == nil {\r\n    55\t\t\treturn nil, fmt.Errorf(\"diff: %s: not found\", file1)\r\n    56\t\t}\r\n    57\t\tcfB, err := checkpoint.Parse(pathB)\r\n    58\t\tif err != nil {\r\n    59\t\t\treturn nil, fmt.Errorf(\"diff: %s: %w\", file2, err)\r\n    60\t\t}\r\n    61\t\tif cfB == nil {\r\n"]
[7297.549424, "o", "    62\t\t\treturn nil, fmt.Errorf(\"diff: %s: not found\", file2)\r\n    63\t\t}\r\n    64\t\r\n    65\t\ttensorsA := make(map[string]types.TensorInfo, len(cfA.Tensors))\r\n    66\t\tfor _, t := range cfA.Tensors {\r\n    67"]
[7297.54948, "o", "\t\t\ttensorsA[t.Name] = t\r\n    68\t\t}\r\n    69\t\ttensorsB := make(map[string]types.TensorInfo, len(cfB.Tensors))\r\n    70\t\tfor _, t := range cfB.Tensors {\r\n    71\t\t\ttensorsB[t.Name] = t\r\n    72\t\t}\r\n    73\t\r\n    74\t\tnames := map[string]struct{}{}\r\n    75\t\tfor name := range tensorsA {\r\n    76\t\t\tnames[name] = struct{}{}"]
[7297.549537, "o", "\r\n    77\t\t}\r\n    78\t\tfor name := range tensorsB {\r\n    79\t\t\tnames[name] = struct{}{}\r\n    80\t\t}\r\n"]
