[4508.356025, "o", "hashes[node.Provenance.DatasetHash] = struct{}{}\r\n   442\t\t\t\t}\r\n   443\t\t\t}\r\n   444\t\t\tif len(hashes) > 1 {\r\n   445\t\t\t\tunique := make([]string, 0, len(hashes))\r\n   446\t\t\t\tfor h := range hashes {\r\n   447\t\t\t\t\tunique = append(unique, h)\r\n   448\t\t\t\t}\r\n   449\t\t\t\tsort.Strings(unique)\r\n   450\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   451\t\t\t\t\tType:     \"dataset_hash_inconsistency\",\r\n   452\t\t\t"]
