[333.83773, "o", "   206\t\r\n   207\t\t\t// value_len (uint32)\r\n   208\t\t\tif off+4 > len(raw) {\r\n   209\t\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at value_len %d\", i)\r\n   210\t\t\t}\r\n   211\t\t\tvalLen := int(binary.LittleEndian.Uint32(raw[off : off+4]))\r\n   212\t\t\toff += 4\r\n   213\t\r\n   214\t\t\tif off+valLen > len(raw) {\r\n   215\t\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at value %d\", i)\r\n   216\t\t\t}\r\n   217\t\t\tval := string(raw[off : off+valLen])\r\n   218\t\t\toff += valLen\r\n   219\t\r\n   220\t\t\tmd[key] = val\r\n   221\t\t}\r\n   222\t\treturn md, nil\r\n   223\t}"]
[333.837809, "o", "\r\n   224\t\r\n   225\t// parseProvenance parses the provenance section.\r\n   226\tfunc parseProvenance(raw []byte, off int) (*types.Provenance, error) {\r\n   227\t\tp := &types.Provenance{}\r\n   228\t\r\n   229\t\t// GitCommit: 40 bytes ASCII\r\n   230\t\tif off+40 > len(raw) {\r\n   231\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at git_commit\")\r\n   232\t\t}\r\n   233\t\tp.GitCommit = strings.TrimRight(string(raw[off:off+40]), \"\\x00\")\r\n   234\t\toff += 40\r\n"]
[333.837954, "o", "   235\t\r\n   236\t\t// DatasetHash: 32 bytes raw → hex\r\n   237\t\tif off+32 > len(raw) {\r\n   238\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at dataset_hash\")\r\n   239\t\t}\r\n   240\t\tp.DatasetHash = hex.EncodeToString(raw[off : off+32])\r\n   241\t\toff += 32\r\n   242\t\r\n   243\t\t// ConfigHash: 32 bytes raw → hex\r\n   244\t\tif off+32 > len(raw) {\r\n   245\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at config_hash\")\r\n   246\t\t}\r\n   247\t\tp.ConfigHash = hex.EncodeToString(raw[off : off+32])\r\n   248\t\toff += 32\r\n   249\t\r\n   250\t\t// TrainingTimestamp: int64\r\n   251\t\tif off+8 > len(raw) {\r\n"]
[333.838029, "o", "   252\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at training_timestamp\")\r\n   253\t\t}\r\n   254\t\tp.TrainingTimestamp = int64(binary.LittleEndian.Uint64(raw[off : off+8]))\r\n   255\t\toff += 8\r\n   256\t\r\n   257\t\t// TrainingDuration: float64\r\n   258\t\tif off+8 > len(raw) {\r\n   259\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at training_duration\")\r\n"]
[333.838106, "o", "   260\t\t}\r\n   261\t\tp.TrainingDuration = math.Float64frombits(binary.LittleEndian.Uint64(raw[off : off+8]))\r\n   262\t\toff += 8\r\n   263\t\r\n   264\t\t// Framework: uint16 len + bytes\r\n   265\t\tif off+2 > len(raw) {\r\n   266\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at framework_len\")\r\n   267\t\t}\r\n   268\t\tfwLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   269\t\toff += 2\r\n   270\t\tif off+fwLen > len(raw) {\r\n"]
[333.838169, "o", "   271\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at framework\")\r\n   272\t\t}\r\n   273\t\tp.Framework = string(raw[off : off+fwLen])\r\n   274\t\toff += fwLen\r\n   275\t\r\n   276\t\t// FrameworkVersion: uint16 len + bytes\r\n   277\t\tif off+2 > len(raw) {\r\n   278\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at framework_version_len\")\r\n"]
[333.838228, "o", "   279\t\t}\r\n   280\t\tfvLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   281\t\toff += 2\r\n   282\t\tif off+fvLen > len(raw) {\r\n   283\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at framework_version\")\r\n   284\t\t}\r\n   285\t\tp.FrameworkVersion = string(raw[off : off+fvLen])\r\n   286\t\toff += fvLen"]
[333.838292, "o", "\r\n   287\t\r\n   288\t\t// Epoch: uint32\r\n   289\t\tif off+4 > len(raw) {\r\n   290\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at epoch\")\r\n   291\t\t}\r\n   292\t\tp.Epoch = binary.LittleEndian.Uint32(raw[off : off+4])\r\n   293\t\toff += 4\r\n   294\t\r\n   295\t\t// GlobalStep: uint64\r\n"]
[333.838356, "o", "   296\t\tif off+8 > len(raw) {\r\n   297\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at global_step\")\r\n   298\t\t}\r\n   299\t\tp.GlobalStep = binary.LittleEndian.Uint64(raw[off : off+8])\r\n   300\t\toff += 8\r\n   301\t\r\n   302\t\t// LearningRate: float64\r\n   303\t\tif off+8 > len(raw) {\r\n   304\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at learning_rate\")\r\n   305\t"]
[333.838414, "o", "\t}\r\n   306\t\tp.LearningRate = math.Float64frombits(binary.LittleEndian.Uint64(raw[off : off+8]))\r\n   307\t\toff += 8\r\n   308\t\r\n   309\t\t// ParentHash: uint16 len + bytes (ASCII hex SHA-256 of parent file)\r\n   310\t\tif off+2 > len(raw) {\r\n   311\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at parent_hash_len\")\r\n   312\t\t}\r\n"]
[333.838472, "o", "   313\t\tphLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   314\t\toff += 2\r\n   315\t\tif phLen > 0 {\r\n   316\t\t\tif off+phLen > len(raw) {\r\n   317\t\t\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at parent_hash\")\r\n   318\t\t\t}\r\n   319\t\t\tp.ParentHash = string(raw[off : off+phLen])\r\n   320\t\t\toff += phLen\r\n"]
[333.83853, "o", "   321\t\t}\r\n   322\t\r\n   323\t\treturn p, nil\r\n   324\t}\r\n   325\t\r\n   326\t// ParseAll finds and parses every .mlck file in the given directory\r\n   327\t// (non-recursive). Files are returned in lexicographic order by filename.\r\n   328\tfunc ParseAll(dir string) ([]*types.CheckpointFile, error) {\r\n   329\t\tentries, err := os.ReadDir(dir)\r\n"]
[333.838587, "o", "   330\t\tif err != nil {\r\n   331\t\t\treturn nil, fmt.Errorf(\"checkpoint: read dir %s: %w\", dir, err)\r\n   332\t\t}\r\n   333\t\r\n   334\t\tvar results []*types.CheckpointFile\r\n   335\t\tfor _, e := range entries {\r\n   336\t\t\tif e.IsDir() {\r\n   337\t\t\t\tcontinue\r\n   338\t\t\t}\r\n"]
[333.838645, "o", "   339\t\t\tif !strings.HasSuffix(strings.ToLower(e.Name()), \".mlck\") {\r\n   340\t\t\t\tcontinue\r\n   341\t\t\t}\r\n   342\t\t\tcf, err := Parse(filepath.Join(dir, e.Name()))\r\n   343\t\t\tif err != nil {\r\n   344\t\t\t\treturn nil, err\r\n   345\t\t\t}\r\n   346\t\t\tresults = append(results, cf)\r\n   347\t\t}\r\n"]
[333.8387, "o", "   348\t\treturn results, nil\r\n   349\t}\r\n"]
