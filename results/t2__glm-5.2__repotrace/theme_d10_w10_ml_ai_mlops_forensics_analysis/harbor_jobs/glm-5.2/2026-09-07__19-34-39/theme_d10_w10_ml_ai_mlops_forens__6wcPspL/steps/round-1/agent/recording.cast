[1952.62616, "o", "   429\t\t\t\tchain = append(chain, node.Filename)\r\n   430\t\t\t\tqueue = append(queue, children[cur]...)\r\n   431\t\t\t}\r\n   432\t\t\tsort.Strings(chain)\r\n   433\t\r\n   434\t\t\thashes := map[string]struct{}{}\r\n   435\t\t\tfor _, h := range chain {\r\n   436\t\t\t\tif node, ok := byHashFile(cps, h); ok && node.Provenance != nil {\r\n   437\t\t\t\t\thashes[node.Provenance.DatasetHash] = struct{}{}\r\n   438\t\t\t\t}\r\n   439\t\t\t}\r\n"]
[1952.62625, "o", "   440\t\t\tif len(hashes) > 1 {\r\n   441\t\t\t\tunique := make([]string, 0, len(hashes))\r\n   442\t\t\t\tfor h := range hashes {\r\n   443\t\t\t\t\tunique = append(unique, h)\r\n   444\t\t\t\t}\r\n   445\t\t\t\tsort.Strings(unique)\r\n   446\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   447\t\t\t\t\tType:     \"dataset_hash_inconsistency\",\r\n   448\t\t\t\t\tSeverity: \"high\",\r\n   449\t\t\t\t\tDetails: map[string]interface{}{\r\n   450\t\t\t\t\t\t\"files\":  chain,\r\n   451\t\t\t\t\t\t\"hashes\": unique,\r\n"]
[1952.626339, "o", "   452\t\t\t\t\t},\r\n   453\t\t\t\t\tSource: chain[0],\r\n   454\t\t\t\t})\r\n   455\t\t\t}\r\n   456\t\t}\r\n   457\t\treturn anomalies\r\n   458\t}\r\n   459\t\r\n   460\tfunc byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {\r\n"]
