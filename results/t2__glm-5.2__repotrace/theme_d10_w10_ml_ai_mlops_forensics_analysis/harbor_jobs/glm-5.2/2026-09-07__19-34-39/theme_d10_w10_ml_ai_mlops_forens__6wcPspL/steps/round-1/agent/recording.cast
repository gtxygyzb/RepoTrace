[2787.515364, "o", "\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc parseShardRecursive(path string) (logparser.ShardInfo, []types.Timeline\u001b[m\u001b[KEntry, error) {\r\n\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc loadTimelineEntries(dir string) ([]types.Timeline\u001b[m\u001b[KEntry, []logparser.ShardInfo, error) {\r\n"]
[2787.515496, "o", "\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc mergeTimeline(entries []types.TimelineEntry) ([]types.Timeline\u001b[m\u001b[KEntry, int) {\r\n\u001b[32m\u001b[K438\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kconflict\u001b[m\u001b[K bool\r\n"]
[2787.515565, "o", "\u001b[32m\u001b[K461\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\ta.\u001b[01;31m\u001b[Kconflict\u001b[m\u001b[K = true\r\n\u001b[32m\u001b[K467\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kconflict\u001b[m\u001b[Ks := 0\r\n\u001b[32m\u001b[K476\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\te.\u001b[01;31m\u001b[KConflict\u001b[m\u001b[K = a.\u001b[01;31m\u001b[Kconflict\u001b[m\u001b[K\r\n\u001b[32m\u001b[K477\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif a.\u001b[01;31m\u001b[Kconflict\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K478\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t"]
[2787.515632, "o", "\u001b[01;31m\u001b[Kconflict\u001b[m\u001b[Ks++\r\n\u001b[32m\u001b[K482\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn result, \u001b[01;31m\u001b[Kconflict\u001b[m\u001b[Ks\r\n\u001b[32m\u001b[K485\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc metricsEqual(a, b types.Timeline\u001b[m\u001b[KEntry) bool {\r\n\u001b[32m\u001b[K499\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc sortTimeline(entries []types.Timeline\u001b[m\u001b[KEntry) {\r\n"]
