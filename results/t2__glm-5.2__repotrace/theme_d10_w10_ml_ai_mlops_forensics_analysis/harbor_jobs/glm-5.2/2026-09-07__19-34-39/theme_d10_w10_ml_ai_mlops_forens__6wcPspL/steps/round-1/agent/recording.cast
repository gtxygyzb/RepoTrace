[3203.147227, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('cmd/mlforge/main.go')\nlines = p.read_text().splitlines()\nout = []\nfor line in lines:\n    if line.strip() == 'case \"report\":':\n        out.append('\\tcase \"diff\":')\n        out.append('\\t\\tif len(positional) < 4 {')\n        out.append('\\t\\t\\tfmt.Fprintf(os.Stderr, \"Usage: mlforge diff <dir> <file1> <file2>\\\\n\")')\n        out.append('\\t\\t\\tos.Exit(1)')\n        out.append('\\t\\t}')\n        out.append('\\t\\tresult, err = forensics.BuildDiff(dir, positional[2], positional[3])')\n    out.append(line)\np.write_text('\\n'.join(out) + '\\n')\nPY\ngofmt -w cmd/mlforge/main.go\ngo build ./...\n"]
