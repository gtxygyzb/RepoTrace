[1897.549217, "o", "root@n30009:/app# "]
[1897.820709, "i", "sed -n '280,560p' internal/forensics/detect.go\n"]
[1897.821117, "o", "sed -n '280,560p' internal/forensics/detect.go\r\n\u001b[?2004l\r"]
[1897.824038, "o", "\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"prev_acc\":        *prev.Acc,\r\n\t\t\t\t\t\"curr_acc\":        *cur.Acc,\r\n\t\t\t\t"]
[1897.824149, "o", "\t\"drop\":            drop,\r\n\t\t\t\t\t\"prev_checkpoint\": prev.Step,\r\n\t\t\t\t\t\"curr_checkpoint\": cur.Step,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\thashSet := map[string]*types.CheckpointFile{}\r\n\tfor _, cf := range cps {\r\n\t\thashSet[cf.FileHash] = cf\r\n\t}\r\n\r\n"]
[1897.824244, "o", "\tfor _, cf := range cps {\r\n\t\traw, err := os.ReadFile(cf.Path)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif !cf.HeaderValid {\r\n\t\t\tstored := uint64(0)\r\n\t\t\tif len(raw) >= 56 {\r\n\t\t\t\tstored = binary.LittleEndian.Uint64(raw[48:56])\r\n\t\t\t}\r\n\t\t\th := fnv.New64a()\r\n\t\t\th.Write(raw[:48])\r\n\t\t\tcomputed := h.Sum64()\r\n\t"]
[1897.824338, "o", "\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"header_checksum_mismatch\",\r\n\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"file\":              cf.Filename,\r\n\t\t\t\t\t\"expected_checksum\": fmt.Sprintf(\"%016x\", stored),\r\n\t\t\t\t\t\"actual_checksum\":   fmt.Sprintf(\"%016x\", computed),\r\n\t\t\t\t},\r\n\t\t\t\tSource: cf.Filename,\r\n\t\t\t})\r\n\t\t}\r\n\r\n"]
[1897.824426, "o", "\t\tfor _, t := range cf.Tensors {\r\n\t\t\tif !t.Valid {\r\n\t\t\t\tcomputed := sha256.Sum256(t.Data)\r\n\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\t\tType:     \"tensor_checksum_mismatch\",\r\n\t\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":              cf.Filename,\r\n\t\t\t\t\t\t\"tensor_name\":       t.Name,\r\n\t\t\t\t\t\t\"expected_checksum\": hex.EncodeToString(t.Hash[:]),\r\n\t\t\t\t\t\t\"actual_checksum\":   hex.EncodeToString(computed[:]),\r\n"]
[1897.824509, "o", "\t\t\t\t\t},\r\n\t\t\t\t\tSource: cf.Filename,\r\n\t\t\t\t})\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif cf.Signed {\r\n\t\t\tvalid, signer := signatureDetails(cf.Path)\r\n\t\t\tif !valid {\r\n\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\t\tType:     \"signature_invalid\",\r\n\t\t\t\t\tSeverity: \"critical\",\r\n"]
[1897.824598, "o", "\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":      cf.Filename,\r\n\t\t\t\t\t\t\"signer_id\": signer,\r\n\t\t\t\t\t\t\"valid\":     false,\r\n\t\t\t\t\t},\r\n\t\t\t\t\tSource: cf.Filename,\r\n\t\t\t\t})\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n"]
[1897.824682, "o", "\t\t\t_, found := hashSet[cf.Provenance.ParentHash]\r\n\t\t\tif !found {\r\n\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\t\tType:     \"provenance_chain_break\",\r\n\t\t\t\t\tSeverity: \"high\",\r\n\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":        cf.Filename,\r\n\t\t\t\t\t\t\"parent_hash\": cf.Provenance.ParentHash,\r\n\t\t\t\t\t\t\"found\":       false,\r\n\t\t\t\t\t},\r\n"]
[1897.824769, "o", "\t\t\t\t\tSource: cf.Filename,\r\n\t\t\t\t})\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tanomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {\r\n\tbyHash := map[string]*types.CheckpointFile{}\r\n\tfor _, cf := range cps {\r\n\t\tbyHash[cf.FileHash] = cf\r\n\t}\r\n\tchildren := map[string][]string{}\r\n\tfor _, cf := range cps {\r\n"]
[1897.824855, "o", "\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n\t\t\tif _, ok := byHash[cf.Provenance.ParentHash]; ok {\r\n\t\t\t\tchildren[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tvar anomalies []types.Anomaly\r\n\tseen := map[string]bool{}\r\n\tfor _, cf := range cps {\r\n\t\tif cf.Provenance == nil {\r\n\t\t\tcontinue\r\n"]
[1897.824993, "o", "\t\t}\r\n\t\troot := cf.FileHash\r\n\t\tfor root != \"\" {\r\n\t\t\tparent, ok := byHash[root]\r\n\t\t\tif !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == \"\" {\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\troot = parent.Provenance.ParentHash\r\n\t\t}\r\n\t\tif seen[root] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tseen[root] = true\r\n\r\n\t\tchain := []string{}\r\n\t\tqueue := []string{root}\r\n\t\tvisited := map[string]bool{}\r\n\t\tfor len(queue) > 0 {\r\n\t\t\tcur := queue[0]\r\n"]
[1897.825083, "o", "\t\t\tqueue = queue[1:]\r\n\t\t\tif visited[cur] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvisited[cur] = true\r\n\t\t\tnode, ok := byHash[cur]\r\n\t\t\tif !ok || node == nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tchain = append(chain, node.Filename)\r\n\t\t\tqueue = append(queue, children[cur]...)\r\n\t\t}\r\n"]
[1897.82517, "o", "\t\tsort.Strings(chain)\r\n\r\n\t\thashes := map[string]struct{}{}\r\n\t\tfor _, h := range chain {\r\n\t\t\tif node, ok := byHashFile(cps, h); ok && node.Provenance != nil {\r\n\t\t\t\thashes[node.Provenance.DatasetHash] = struct{}{}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif len(hashes) > 1 {\r\n\t\t\tunique := make([]string, 0, len(hashes))\r\n\t\t\tfor h := range hashes {\r\n\t\t\t\tunique = append(unique, h)\r\n"]
[1897.825258, "o", "\t\t\t}\r\n\t\t\tsort.Strings(unique)\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"dataset_hash_inconsistency\",\r\n\t\t\t\tSeverity: \"high\",\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"files\":  chain,\r\n\t\t\t\t\t\"hashes\": unique,\r\n\t\t\t\t},\r\n\t\t\t\tSource: chain[0],\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n"]
[1897.825343, "o", "\r\nfunc byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {\r\n\tfor _, cf := range cps {\r\n\t\tif cf.Filename == file {\r\n\t\t\treturn cf, true\r\n\t\t}\r\n\t}\r\n\treturn nil, false\r\n}\r\n\r\nfunc signatureDetails(path string) (bool, string) {\r\n\traw, err := os.ReadFile(path)\r\n"]
[1897.825432, "o", "\tif err != nil || len(raw) < 56 {\r\n\t\treturn false, \"\"\r\n\t}\r\n\tsigOff := binary.LittleEndian.Uint64(raw[32:40])\r\n\tif sigOff == 0 || int(sigOff) >= len(raw) || int(sigOff)+5 > len(raw) {\r\n\t\treturn false, \"\"\r\n\t}\r\n\toff := int(sigOff)\r\n\toff++ // algorithm\r\n\tsignerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n\tif off+signerLen+2 > len(raw) {\r\n\t\treturn false, \"\"\r\n\t}\r\n\tsignerID := string(raw[off : off+signerLen])\r\n"]
[1897.825516, "o", "\toff += signerLen\r\n\tsigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n\tif off+sigLen > len(raw) {\r\n\t\treturn false, signerID\r\n\t}\r\n\tstored := raw[off : off+sigLen]\r\n\tmac := hmac.New(sha256.New, []byte(signerID))\r\n\tmac.Write(raw[:sigOff])\r\n\texpected := mac.Sum(nil)\r\n\treturn hmac.Equal(expected, stored), signerID\r\n}\r\n\r\nfunc firstSource(e types.TimelineEntry) string {\r\n"]
[1897.8256, "o", "\tif len(e.Sources) > 0 {\r\n\t\treturn e.Sources[0]\r\n\t}\r\n\treturn \"\"\r\n}\r\n\r\nfunc meanFloats(v []float64) float64 {\r\n\tif len(v) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\ts := 0.0\r\n\tfor _, x := range v {\r\n"]
[1897.825682, "o", "\t\ts += x\r\n\t}\r\n\treturn s / float64(len(v))\r\n}\r\n\r\nfunc stddevFloats(v []float64, mean float64) float64 {\r\n\tif len(v) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\ts := 0.0\r\n\tfor _, x := range v {\r\n\t\td := x - mean\r\n\t\ts += d * d\r\n"]
[1897.825771, "o", "\t}\r\n\treturn math.Sqrt(s / float64(len(v)))\r\n}\r\n\r\nfunc sortAnomalies(a []types.Anomaly) {\r\n\trank := map[string]int{\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3}\r\n\tsort.Slice(a, func(i, j int) bool {\r\n\t\tri := rank[a[i].Severity]\r\n\t\trj := rank[a[j].Severity]\r\n\t\tif ri != rj {\r\n\t\t\treturn ri < rj\r\n\t\t}\r\n\t\tei := -1\r\n\t\tej := -1\r\n\t"]
[1897.825854, "o", "\tif a[i].Epoch != nil {\r\n\t\t\tei = *a[i].Epoch\r\n\t\t}\r\n\t\tej = -1\r\n\t\tif a[j].Epoch != nil {\r\n\t\t\tej = *a[j].Epoch\r\n\t\t}\r\n\t\tif ei != ej {\r\n\t\t\treturn ei < ej\r\n\t\t}\r\n\t\tsi := -1\r\n\t\tif a[i].Step != nil {\r\n\t\t\tsi = *a[i].Step\r\n\t"]
[1897.825958, "o", "\t}\r\n\t\tsj := -1\r\n\t\tif a[j].Step != nil {\r\n\t\t\tsj = *a[j].Step\r\n\t\t}\r\n\t\treturn si < sj\r\n\t})\r\n}\r\n"]
