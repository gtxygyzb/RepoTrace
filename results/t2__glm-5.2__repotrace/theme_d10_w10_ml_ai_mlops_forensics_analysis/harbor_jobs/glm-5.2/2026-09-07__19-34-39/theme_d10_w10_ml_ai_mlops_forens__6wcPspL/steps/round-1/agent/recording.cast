[7228.797188, "o", "   260\t}\r\n   261\t\r\n   262\ttype VerifyOutput struct {\r\n   263\t\tStatus      string             `json:\"status\"`\r\n   264\t\tCheckpoints []VerifyCheckpoint `json:\"checkpoints\"`\r\n   265\t\tSummary     struct {\r\n   266\t\t\tTotal   int `json:\"total\"`\r\n   267\t\t\tValid   int `json:\"valid\"`\r\n   268\t\t"]
[7228.797331, "o", "\tInvalid int `json:\"invalid\"`\r\n   269\t\t} `json:\"summary\"`\r\n   270\t}\r\n   271\t\r\n   272\tfunc BuildVerify(dir string) (interface{}, error) {\r\n   273\t\tap, err := DiscoverArtifacts(dir)\r\n   274\t\tif err != nil {\r\n   275\t\t\treturn nil, err\r\n   276\t\t}\r\n   277\t\tif len(ap.Checkpoints) == 0 {\r\n   278\t\t\treturn nil, fmt.Errorf(\"no checkpoint files found\")\r\n   279\t\t}\r\n   280\t\tvar out VerifyOutput\r\n   281\t\tout.Status = \"ok\"\r\n   282\t\tfor _, p := range ap.Checkpoints {\r\n   283\t\t\tvc := verifyCheckpoint(p)\r\n   284\t\t\tout.Checkpoints = append(out.Checkpoints, vc)\r\n   285\t\t}\r\n   286\t\tsort.Slice(out.Checkpoints, func(i, j int) bool {\r\n   287\t\t\treturn out.Checkpoints[i].File < out.Checkpoints[j].File\r\n"]
[7228.7974, "o", "   288\t\t})\r\n   289\t\tout.Summary.Total = len(out.Checkpoints)\r\n   290\t\tfor _, c := range out.Checkpoints {\r\n   291\t\t\tif c.Valid {\r\n   292\t\t\t\tout.Summary.Valid++\r\n   293\t\t\t} else {\r\n   294\t\t\t\tout.Summary.Invalid++\r\n   295\t\t\t}\r\n   296\t\t}\r\n   297\t\treturn out, nil\r\n   298\t}\r\n"]
[7228.797464, "o", "   299\t\r\n   300\tfunc verifyCheckpoint(path string) VerifyCheckpoint {\r\n   301\t\tvc := VerifyCheckpoint{\r\n   302\t\t\tFile:   filepath.Base(path),\r\n   303\t\t\tIssues: []VerifyIssue{},\r\n   304\t\t}\r\n   305\t\tcf, err := checkpoint.Parse(path)\r\n   306\t\tif err != nil || cf == nil {\r\n   307\t"]
[7228.797519, "o", "\t\tvc.HeaderChecksumValid = false\r\n   308\t\t\tvc.TensorChecksumsValid = false\r\n   309\t\t\tvc.ProvenanceValid = false\r\n   310\t\t\tvc.Valid = false\r\n   311\t\t\tdetail := \"unknown parse error\"\r\n   312\t\t\tif err != nil {\r\n   313\t\t\t\tdetail = err.Error()\r\n   314\t\t\t}\r\n   315\t"]
[7228.797573, "o", "\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"parse_error\", Detail: detail})\r\n   316\t\t\treturn vc\r\n   317\t\t}\r\n   318\t\tvc.HeaderChecksumValid = cf.HeaderValid\r\n   319\t\tif !cf.HeaderValid {\r\n   320\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"header_checksum_mismatch\", Detail: \"\"})\r\n   321\t\t}\r\n   322\t\tvc.TensorChecksumsValid = true\r\n   323"]
[7228.797623, "o", "\t\tfor _, t := range cf.Tensors {\r\n   324\t\t\tif !t.Valid {\r\n   325\t\t\t\tvc.TensorChecksumsValid = false\r\n   326\t\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"tensor_checksum_mismatch\", Detail: t.Name})\r\n   327\t\t\t}\r\n   328\t\t}\r\n   329\t\tif cf.Signed {\r\n"]
[7228.797678, "o", "   330\t\t\tvalid, _ := validateSignature(path)\r\n   331\t\t\tvc.SignatureValid = &valid\r\n   332\t\t\tif !valid {\r\n   333\t\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"signature_invalid\", Detail: \"\"})\r\n   334\t\t\t}\r\n   335\t\t}\r\n   336\t\tvc.ProvenanceValid = validateProvenance(cf)\r\n   337\t\tif !vc.ProvenanceValid {\r\n"]
[7228.797729, "o", "   338\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"provenance_invalid\", Detail: \"\"})\r\n   339\t\t}\r\n   340\t\tvc.Valid = vc.HeaderChecksumValid && vc.TensorChecksumsValid && vc.ProvenanceValid && (!cf.Signed || (vc.SignatureValid != nil && *vc.SignatureValid))\r\n   341\t\treturn vc\r\n   342\t}\r\n   343\t\r\n   344\tfunc validateSignature(path string) (bool, error) {\r\n   345\t\t"]
[7228.79778, "o", "raw, err := os.ReadFile(path)\r\n   346\t\tif err != nil || len(raw) < 56 {\r\n   347\t\t\treturn false, err\r\n   348\t\t}\r\n   349\t\tsigOff := binary.LittleEndian.Uint64(raw[32:40])\r\n   350\t\tif sigOff == 0 || int(sigOff) >= len(raw) {\r\n   351\t\t\treturn false, nil\r\n"]
[7228.797833, "o", "   352\t\t}\r\n   353\t\tif int(sigOff)+5 > len(raw) {\r\n   354\t\t\treturn false, nil\r\n   355\t\t}\r\n   356\t\toff := int(sigOff)\r\n   357\t\t_ = raw[off] // algorithm\r\n   358\t\toff++\r\n   359\t\tsignerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   360\t\toff += 2\r\n"]
[7228.797886, "o", "   361\t\tif off+signerLen+2 > len(raw) {\r\n   362\t\t\treturn false, nil\r\n   363\t\t}\r\n   364\t\tsignerID := string(raw[off : off+signerLen])\r\n   365\t\toff += signerLen\r\n   366\t\tsigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   367\t\toff += 2\r\n   368\t\tif off+sigLen > len(raw) {\r\n   369"]
[7228.797951, "o", "\t\t\treturn false, nil\r\n   370\t\t}\r\n   371\t\tstoredSig := raw[off : off+sigLen]\r\n   372\t\tmac := hmac.New(sha256.New, []byte(signerID))\r\n   373\t\tmac.Write(raw[:sigOff])\r\n   374\t\texpected := mac.Sum(nil)\r\n   375\t\treturn hmac.Equal(expected, storedSig), nil\r\n   376\t}\r\n"]
[7228.798011, "o", "   377\t\r\n   378\tfunc validateProvenance(cf *types.CheckpointFile) bool {\r\n   379\t\tif cf.Provenance == nil {\r\n   380\t\t\treturn false\r\n   381\t\t}\r\n   382\t\tp := cf.Provenance\r\n   383\t\tif p.Framework == \"\" || p.FrameworkVersion == \"\" {\r\n   384\t\t\treturn false\r\n"]
[7228.79806, "o", "   385\t\t}\r\n   386\t\tif len(p.GitCommit) != 40 || !isHex(p.GitCommit) {\r\n   387\t\t\treturn false\r\n   388\t\t}\r\n   389\t\tif len(p.DatasetHash) != 64 || !isHex(p.DatasetHash) {\r\n   390\t\t\treturn false\r\n   391\t\t}\r\n"]
[7228.798114, "o", "   392\t\tif len(p.ConfigHash) != 64 || !isHex(p.ConfigHash) {\r\n   393\t\t\treturn false\r\n   394\t\t}\r\n   395\t\tif p.ParentHash != \"\" && (len(p.ParentHash) != 64 || !isHex(p.ParentHash)) {\r\n   396\t\t\treturn false\r\n   397\t\t}\r\n   398\t\treturn true\r\n   399\t}\r\n   400\t\r\n"]
[7228.798167, "o", "   401\tfunc isHex(s string) bool {\r\n   402\t\t_, err := hex.DecodeString(s)\r\n   403\t\treturn err == nil\r\n   404\t}\r\n   405\t\r\n   406\tfunc parseShardRecursive(path string) (logparser.ShardInfo, []types.TimelineEntry, error) {\r\n   407\t\t"]
[7228.798218, "o", "return logparser.ParseShard(path, filepath.Base(path))\r\n   408\t}\r\n   409\t\r\n   410\tfunc loadTimelineEntries(dir string) ([]types.TimelineEntry, []logparser.ShardInfo, error) {\r\n   411\t\tap, err := DiscoverArtifacts(dir)\r\n   412\t\tif err != nil {\r\n   413\t\t\treturn nil, nil, err\r\n"]
[7228.798268, "o", "   414\t\t}\r\n   415\t\tif len(ap.Logs) == 0 {\r\n   416\t\t\treturn nil, nil, fmt.Errorf(\"no log shard files found\")\r\n   417\t\t}\r\n   418\t\tvar allEntries []types.TimelineEntry\r\n   419\t\tvar shards []logparser.ShardInfo\r\n"]
[7228.798321, "o", "   420\t\tfor _, p := range ap.Logs {\r\n   421\t\t\tinfo, entries, err := parseShardRecursive(p)\r\n   422\t\t\tif err != nil {\r\n   423\t\t\t\tcontinue\r\n   424\t\t\t}\r\n   425\t\t\tshards = append(shards, info)\r\n   426\t\t\tallEntries = append(allEntries, entries...)\r\n   427\t\t}\r\n"]
[7228.79837, "o", "   428\t\tif len(allEntries) == 0 {\r\n   429\t\t\treturn nil, shards, fmt.Errorf(\"no log entries found\")\r\n   430\t\t}\r\n   431\t\treturn allEntries, shards, nil\r\n   432\t}\r\n"]
[7228.79842, "o", "   433\t\r\n   434\tfunc mergeTimeline(entries []types.TimelineEntry) ([]types.TimelineEntry, int) {\r\n   435\t\ttype agg struct {\r\n   436\t\t\tentry    types.TimelineEntry\r\n   437\t\t\tsources  map[string]struct{}\r\n"]
[7228.79847, "o", "   438\t\t\tconflict bool\r\n   439\t\t}\r\n   440\t\tm := map[string]*agg{}\r\n   441\t\tfor _, e := range entries {\r\n   442\t\t\tkey := fmt.Sprintf(\"%d:%d\", e.Epoch, e.Step)\r\n   443\t\t\ta, ok := m[key]\r\n   444\t\t\tif !ok {\r\n   445\t\t\t\tsrc := map[string]struct{}{}\r\n"]
[7228.798522, "o", "   446\t\t\t\tfor _, s := range e.Sources {\r\n   447\t\t\t\t\tsrc[s] = struct{}{}\r\n   448\t\t\t\t}\r\n   449\t\t\t\tm[key] = &agg{entry: e, sources: src}\r\n   450\t\t\t\tcontinue"]
[7228.798573, "o", "\r\n   451\t\t\t}\r\n   452\t\t\tfor _, s := range e.Sources {\r\n   453\t\t\t\ta.sources[s] = struct{}{}\r\n   454\t\t\t}\r\n   455\t\t\tif metricsEqual(a.entry, e) {\r\n   456\t\t\t\tif e.Ts < a.entry.Ts {\r\n"]
[7228.798624, "o", "   457\t\t\t\t\ta.entry = e\r\n   458\t\t\t\t}\r\n   459\t\t\t\tcontinue\r\n   460\t\t\t}\r\n   461\t\t\ta.conflict = true\r\n   462\t\t\tif e.Ts < a.entry.Ts {\r\n   463\t\t\t\ta.entry = e\r\n   464\t\t\t}\r\n"]
[7228.798675, "o", "   465\t\t}\r\n   466\t\tresult := make([]types.TimelineEntry, 0, len(m))\r\n   467\t\tconflicts := 0\r\n   468\t\tfor _, a := range m {\r\n   469\t\t\te := a.entry\r\n   470\t\t\tsrcs := make([]string, 0, len(a.sources))\r\n   471\t\t\tfor s := range a.sources {\r\n"]
[7228.798724, "o", "   472\t\t\t\tsrcs = append(srcs, s)\r\n   473\t\t\t}\r\n   474\t\t\tsort.Strings(srcs)\r\n   475\t\t\te.Sources = srcs\r\n   476\t\t\te.Conflict = a.conflict\r\n   477\t\t\tif a.conflict {\r\n   478\t\t\t\tconflicts++\r\n"]
[7228.798775, "o", "   479\t\t\t}\r\n   480\t\t\tresult = append(result, e)\r\n   481\t\t}\r\n   482\t\treturn result, conflicts\r\n   483\t}\r\n   484\t\r\n"]
[7228.798827, "o", "   485\tfunc metricsEqual(a, b types.TimelineEntry) bool {\r\n   486\t\treturn floatPtrEqual(a.Loss, b.Loss) &&\r\n   487\t\t\tfloatPtrEqual(a.Lr, b.Lr) &&\r\n   488\t\t\tfloatPtrEqual(a.GradNorm, b.GradNorm) &&\r\n   489\t\t\tfloatPtrEqual(a.Acc, b.Acc)\r\n   490\t}\r\n   491\t\r\n   492"]
[7228.79888, "o", "\tfunc floatPtrEqual(a, b *float64) bool {\r\n   493\t\tif a == nil || b == nil {\r\n   494\t\t\treturn a == b\r\n   495\t\t}\r\n   496\t\treturn math.Abs(*a-*b) <= 1e-9\r\n   497\t}\r\n   498\t\r\n   499\tfunc sortTimeline(entries []types.TimelineEntry) {\r\n"]
[7228.79893, "o", "   500\t\tsort.Slice(entries, func(i, j int) bool {\r\n   501\t\t\tif entries[i].Epoch != entries[j].Epoch {\r\n   502\t\t\t\treturn entries[i].Epoch < entries[j].Epoch\r\n   503\t\t\t}\r\n   504\t\t\t"]
[7228.798993, "o", "return entries[i].Step < entries[j].Step\r\n   505\t\t})\r\n   506\t}\r\n   507\t\r\n   508\tfunc detectGaps(entries []types.TimelineEntry) []TimelineGap {\r\n   509\t\tvar gaps []TimelineGap\r\n   510\t\tfor i := 1; i < len(entries); i++ {\r\n   511\t\t\tprev := entries[i-1]\r\n"]
[7228.799023, "o", "   512\t\t\tcur := entries[i]\r\n   513\t\t\tif prev.Epoch != cur.Epoch {\r\n   514\t\t\t\tcontinue\r\n   515\t\t\t}\r\n   516\t\t\tdiff := cur.Step - prev.Step\r\n   517\t"]
[7228.799167, "o", "\t\tif diff > 50 {\r\n   518\t\t\t\tgaps = append(gaps, TimelineGap{\r\n   519\t\t\t\t\tAfterStep:  prev.Step,\r\n   520\t\t\t\t\tBeforeStep: cur.Step,\r\n   521\t\t\t\t\tEpoch:      prev.Epoch,\r\n   522\t\t\t\t\tGapSteps:   diff,\r\n   523\t\t\t\t\tAfterTs:    prev.Ts,\r\n   524\t\t\t\t\tBeforeTs:   cur.Ts,\r\n   525\t\t\t\t})\r\n   526\t\t\t}\r\n   527\t\t}\r\n   528\t\treturn gaps\r\n   529\t}\r\n   530\t\r\n   531\tfunc readConfigSummary(path string) (IngestConfig, error) {\r\n   532\t\traw, err := os.ReadFile(path)\r\n   533\t\tif err != nil {\r\n   534\t\t\treturn IngestConfig{}, err\r\n"]
[7228.799298, "o", "   535\t\t}\r\n   536\t\tvar cfg struct {\r\n   537\t\t\tModelName string `json:\"model_name\"`\r\n   538\t\t\tDataset   string `json:\"dataset\"`\r\n   539\t\t}\r\n   540\t\tif err := json.Unmarshal(raw, &cfg); err != nil {\r\n   541\t\t\treturn IngestConfig{}, err\r\n   542\t\t}\r\n   543\t\treturn IngestConfig{File: filepath.Base(path), ModelName: cfg.ModelName, Dataset: cfg.Dataset}, nil\r\n   544\t}\r\n   545\t\r\n   546\tfunc provenanceToMap(p *types.Provenance) map[string]interface{} {\r\n   547\t\tif p == nil {\r\n   548\t\t\treturn map[string]interface{}{}\r\n   549\t\t}\r\n   550\t\treturn map[string]interface{}{\r\n   551\t\t\t\"epoch\":             p.Epoch,\r\n   552\t\t\t\"global_step\":       p.GlobalStep,\r\n"]
[7228.799389, "o", "   553\t\t\t\"framework\":         p.Framework,\r\n   554\t\t\t\"framework_version\": p.FrameworkVersion,\r\n   555\t\t\t\"parent_hash\":       p.ParentHash,\r\n   556\t\t}\r\n   557\t}\r\n   558\t\r\n   559\tfunc unixToISO(ts int64) string {\r\n   560\t\treturn time.Unix(ts, 0).UTC().Format(time.RFC3339)\r\n"]
