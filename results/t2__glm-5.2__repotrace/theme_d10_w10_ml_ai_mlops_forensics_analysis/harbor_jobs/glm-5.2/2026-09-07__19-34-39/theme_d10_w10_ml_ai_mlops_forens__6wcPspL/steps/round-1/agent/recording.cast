[6669.668664, "o", "tep\r\n\\t\\t\\t\\tanomalies = append(anomalies, types.Anomaly{\r\n\\t\\t\\t\\t\\tType:     \"loss_divergence\",\r\n\\t\\t\\t\\t\\tSeverity: severit"]
[6669.668727, "o", "y,\r\n\\t\\t\\t\\t\\tEpoch:    &ep,\r\n\\t\\t\\t\\t\\tStep:     &st,\r\n\\t\\t\\t\\t\\tDetails: map[string]interface{}{\r\n\\t\\t\\t\\t\\t\\t\"current_loss\": currentLoss,\r\n\\t\\t\\t\\t\\t\\t\"ema_loss\":     emaLoss,\r\n\\t\\t\\t\\t"]
[6669.668797, "o", "\\t\\t\"ratio\":        ratio,\r\n\\t\\t\\t\\t\\t},\r\n\\t\\t\\t\\t\\tEvidence: map[string]inter"]
[6669.668854, "o", "face{}{\"window_values\": precedingLossValues(entries, lossEntries, i, 5)},\r\n\\t\\t\\t\\t\\tSource:   firstSource(entries[lossEntries[i]]),\r\n\\t\\t\\t\\t})\r\n\\t\\t\\t}\r\n\\t\\t}\r\n\\t"]
[6669.668911, "o", "\\temaLoss = (1-alpha)*emaLoss + alpha*currentLoss\r\n\\t}\r\n\\tre"]
[6669.668979, "o", "turn anomalies\r\n}\r\n\r\n'''\r\n\r\nl_start = s.index(\"func detectLossDivergence\")\r\nl_end = s.index(\"func detectLrAnomalies\", l_start)\r\ns = s[:l_start] + new_loss + s[l_end:]\r\n\r\n"]
[6669.669036, "o", "p.write_text(s)\r\nPY\r\n\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6669.669101, "o", "\u001b[?2004h> "]
[6669.669202, "o", "p = Path(\"internal/forensics/detect.go\")\r\n\u001b[?2004l\r"]
[6669.669259, "o", "\u001b[?2004h> "]
[6669.669315, "o", "s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6669.669377, "o", "\u001b[?2004h> "]
[6669.669638, "o", "new_gradient = '''func detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n\u001b[?2004l\r"]
[6669.669695, "o", "\u001b[?2004h> "]
[6669.669747, "o", "\\tvar vals []float64\r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.669802, "o", "> "]
[6669.669859, "o", "\\tvar idx []int\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.669962, "o", "\\tfor i, e := range entries {\r\n\u001b[?2004l\r"]
[6669.670041, "o", "\u001b[?2004h> "]
[6669.670116, "o", "\\t\\tif e.GradNorm != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.670244, "o", "\\t\\t\\tvals = append(vals, *e.GradNorm)\r\n\u001b[?2004l\r"]
[6669.6703, "o", "\u001b[?2004h> "]
[6669.670362, "o", "\\t\\t\\tidx = append(idx, i)\r\n\u001b[?2004l\r"]
[6669.670417, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[6669.670474, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.67053, "o", "> "]
[6669.670587, "o", "\\tif len(vals) < 31 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.670651, "o", "\\t\\treturn nil\r\n\u001b[?2004l\r"]
[6669.670708, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.670763, "o", "> "]
[6669.670823, "o", "\\tconst alpha = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.670882, "o", "\\tmean := vals[0]\r\n\u001b[?2004l\r"]
[6669.670964, "o", "\u001b[?2004h> \\tvariance := 0.0\r\n\u001b[?2004l\r"]
[6669.671023, "o", "\u001b[?2004h> "]
[6669.671107, "o", "\\tvar anomalies []types.Anomaly\r\n\u001b[?2004l\r"]
[6669.671168, "o", "\u001b[?2004h> "]
[6669.671245, "o", "\\tfor i := 1; i < len(vals); i++ {\r\n\u001b[?2004l\r"]
[6669.671299, "o", "\u001b[?2004h> "]
[6669.671359, "o", "\\t\\tif i >= 30 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.671447, "o", "\\t\\t\\tobserved := vals[i]\r\n\u001b[?2004l\r"]
[6669.671508, "o", "\u001b[?2004h> "]
[6669.671587, "o", "\\t\\t\\tstddev := math.Sqrt(variance)\r\n\u001b[?2004l\r"]
[6669.671642, "o", "\u001b[?2004h> "]
[6669.671697, "o", "\\t\\t\\tz := 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.671767, "o", "\\t\\t\\tif stddev > 0 {\r\n\u001b[?2004l\r"]
[6669.671822, "o", "\u001b[?2004h> "]
[6669.671919, "o", "\\t\\t\\t\\tz = (observed - mean) / stddev\r\n\u001b[?2004l\r"]
[6669.67199, "o", "\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.672045, "o", "> "]
[6669.672107, "o", "\\t\\t\\tif z > 2.5 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.672199, "o", "\\t\\t\\t\\tseverity := \"medium\"\r\n\u001b[?2004l\r"]
[6669.672254, "o", "\u001b[?2004h> "]
[6669.672317, "o", "\\t\\t\\t\\tif z > 4.0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.672413, "o", "\\t\\t\\t\\t\\tseverity = \"high\"\r\n\u001b[?2004l\r"]
[6669.672472, "o", "\u001b[?2004h> \\t\\t\\t\\t}\r\n\u001b[?2004l\r"]
[6669.672529, "o", "\u001b[?2004h> "]
[6669.672621, "o", "\\t\\t\\t\\tep := entries[idx[i]].Epoch\r\n\u001b[?2004l\r"]
[6669.672678, "o", "\u001b[?2004h> "]
[6669.672758, "o", "\\t\\t\\t\\tst := entries[idx[i]].Step\r\n\u001b[?2004l\r"]
[6669.672814, "o", "\u001b[?2004h> "]
[6669.672967, "o", "\\t\\t\\t\\tanomalies = append(anomalies, types.Anomaly{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.673118, "o", "\\t\\t\\t\\t\\tType:     \"gradient_spike\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.673182, "o", "> "]
[6669.673243, "o", "\\t\\t\\t\\t\\tSeverity: severity,\r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.673306, "o", "> "]
[6669.673374, "o", "\\t\\t\\t\\t\\tEpoch:    &ep,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.673454, "o", "\\t\\t\\t\\t\\tStep:     &st,\r\n\u001b[?2004l\r"]
[6669.673509, "o", "\u001b[?2004h> "]
[6669.673616, "o", "\\t\\t\\t\\t\\tDetails: map[string]interface{}{\r\n\u001b[?2004l\r"]
[6669.673672, "o", "\u001b[?2004h> "]
[6669.673764, "o", "\\t\\t\\t\\t\\t\\t\"observed\":    observed,\r\n\u001b[?2004l\r"]
[6669.673819, "o", "\u001b[?2004h> "]
[6669.673945, "o", "\\t\\t\\t\\t\\t\\t\"ewma_mean\":   mean,\r\n\u001b[?2004l\r"]
[6669.674002, "o", "\u001b[?2004h> "]
[6669.674133, "o", "\\t\\t\\t\\t\\t\\t\"ewma_stddev\": stddev,\r\n\u001b[?2004l\r"]
[6669.674189, "o", "\u001b[?2004h> "]
[6669.674303, "o", "\\t\\t\\t\\t\\t\\t\"z_score\":     z,\r\n\u001b[?2004l\r"]
[6669.674358, "o", "\u001b[?2004h> "]
[6669.67441, "o", "\\t\\t\\t\\t\\t},\r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.674465, "o", "> "]
[6669.674794, "o", "\\t\\t\\t\\t\\tEvidence: map[string]interface{}{\"window_values\": lastValues(vals[:i], 5)},\r\n\u001b[?2004l\r"]
[6669.674849, "o", "\u001b[?2004h> "]
[6669.675055, "o", "\\t\\t\\t\\t\\tSource:   firstSource(entries[idx[i]]),\r\n\u001b[?2004l\r"]
[6669.675112, "o", "\u001b[?2004h> "]
[6669.675167, "o", "\\t\\t\\t\\t})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.675227, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[6669.675283, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[6669.675338, "o", "\u001b[?2004h> "]
[6669.675421, "o", "\\t\\tprevMean := mean\r\n\u001b[?2004l\r"]
[6669.675477, "o", "\u001b[?2004h> "]
[6669.675636, "o", "\\t\\tmean = (1-alpha)*mean + alpha*vals[i]\r\n\u001b[?2004l\r"]
[6669.67569, "o", "\u001b[?2004h> "]
[6669.676013, "o", "\\t\\tvariance = (1-alpha)*variance + alpha*(vals[i]-prevMean)*(vals[i]-prevMean)\r\n\u001b[?2004l\r"]
[6669.676069, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6669.676099, "o", "\u001b[?2004h"]
[6669.676326, "o", "> \\treturn anomalies\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.6764, "o", "'''\r\n\u001b[?2004l\r"]
[6669.676461, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.676641, "o", "g_start = s.index(\"func detectGradientSpikes\")\r\n\u001b[?2004l\r"]
[6669.676697, "o", "\u001b[?2004h> "]
[6669.676906, "o", "g_end = s.index(\"func detectLossDivergence\", g_start)\r\n\u001b[?2004l\r"]
[6669.676986, "o", "\u001b[?2004h> "]
[6669.677132, "o", "s = s[:g_start] + new_gradient + s[g_end:]\r\n\u001b[?2004l\r"]
[6669.677187, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.677243, "o", "> "]
[6669.677582, "o", "new_loss = '''func detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n\u001b[?2004l\r"]
[6669.677639, "o", "\u001b[?2004h> "]
[6669.677726, "o", "\\tvar lossEntries []int\r\n\u001b[?2004l\r"]
[6669.677782, "o", "\u001b[?2004h> "]
[6669.677895, "o", "\\tfor i, e := range entries {\r\n\u001b[?2004l\r"]
[6669.677964, "o", "\u001b[?2004h> "]
[6669.678054, "o", "\\t\\tif e.Loss != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.678111, "o", "> "]
[6669.678261, "o", "\\t\\t\\tlossEntries = append(lossEntries, i)\r\n\u001b[?2004l\r"]
[6669.678317, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[6669.678377, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[6669.678426, "o", "\u001b[?2004h> "]
[6669.678549, "o", "\\tif len(lossEntries) < 2 {\r\n\u001b[?2004l\r"]
[6669.678605, "o", "\u001b[?2004h> "]
[6669.678668, "o", "\\t\\treturn nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.678723, "o", "> \\t}\r\n\u001b[?2004l\r"]
[6669.678777, "o", "\u001b[?2004h> "]
[6669.678852, "o", "\\tconst alpha = 0.05\r\n\u001b[?2004l\r"]
[6669.678906, "o", "\u001b[?2004h> "]
[6669.679076, "o", "\\temaLoss := *entries[lossEntries[0]].Loss\r\n\u001b[?2004l\r"]
[6669.679132, "o", "\u001b[?2004h> "]
[6669.679254, "o", "\\tvar anomalies []types.Anomaly\r\n\u001b[?2004l\r"]
[6669.679309, "o", "\u001b[?2004h> "]
[6669.679468, "o", "\\tfor i := 1; i < len(lossEntries); i++ {\r\n\u001b[?2004l\r"]
[6669.679524, "o", "\u001b[?2004h> "]
[6669.679712, "o", "\\t\\tcurrentLoss := *entries[lossEntries[i]].Loss\r\n\u001b[?2004l\r"]
[6669.679768, "o", "\u001b[?2004h> "]
[6669.679894, "o", "\\t\\tif math.Abs(emaLoss) > 1e-6 {\r\n\u001b[?2004l\r"]
[6669.679966, "o", "\u001b[?2004h> "]
[6669.6801, "o", "\\t\\t\\tratio := currentLoss / emaLoss\r\n\u001b[?2004l\r"]
[6669.680155, "o", "\u001b[?2004h> "]
[6669.680297, "o", "\\t\\t\\tif currentLoss > 2.0*emaLoss {\r\n\u001b[?2004l\r"]
[6669.680352, "o", "\u001b[?2004h> "]
[6669.680451, "o", "\\t\\t\\t\\tseverity := \"high\"\r\n\u001b[?2004l\r"]
[6669.680506, "o", "\u001b[?2004h> "]
[6669.680598, "o", "\\t\\t\\t\\tif ratio > 5.0 {\r\n\u001b[?2004l\r"]
[6669.680652, "o", "\u001b[?2004h> "]
[6669.680772, "o", "\\t\\t\\t\\t\\tseverity = \"critical\"\r\n\u001b[?2004l\r"]
[6669.680826, "o", "\u001b[?2004h> "]
[6669.680881, "o", "\\t\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.680945, "o", "> "]
[6669.681087, "o", "\\t\\t\\t\\tep := entries[lossEntries[i]].Epoch\r\n\u001b[?2004l\r"]
[6669.681143, "o", "\u001b[?2004h> "]
[6669.681304, "o", "\\t\\t\\t\\tst := entries[lossEntries[i]].Step\r\n\u001b[?2004l\r"]
[6669.681387, "o", "\u001b[?2004h"]
[6669.681444, "o", "> "]
[6669.681563, "o", "\\t\\t\\t\\tanomalies = append(anomalies, types.Anomaly{\r\n\u001b[?2004l\r"]
[6669.681619, "o", "\u001b[?2004h> "]
[6669.681767, "o", "\\t\\t\\t\\t\\tType:     \"loss_divergence\",\r\n\u001b[?2004l\r"]
[6669.681821, "o", "\u001b[?2004h> "]
[6669.681943, "o", "\\t\\t\\t\\t\\tSeverity: severity,\r\n\u001b[?2004l\r"]
[6669.681999, "o", "\u001b[?2004h> "]
[6669.682087, "o", "\\t\\t\\t\\t\\tEpoch:    &ep,\r\n\u001b[?2004l\r"]
[6669.682142, "o", "\u001b[?2004h> "]
[6669.682236, "o", "\\t\\t\\t\\t\\tStep:     &st,\r\n\u001b[?2004l\r"]
[6669.682292, "o", "\u001b[?2004h> "]
[6669.682454, "o", "\\t\\t\\t\\t\\tDetails: map[string]interface{}{\r\n\u001b[?2004l\r"]
[6669.682509, "o", "\u001b[?2004h> "]
[6669.682665, "o", "\\t\\t\\t\\t\\t\\t\"current_loss\": currentLoss,\r\n\u001b[?2004l\r"]
[6669.68272, "o", "\u001b[?2004h> "]
[6669.682858, "o", "\\t\\t\\t\\t\\t\\t\"ema_loss\":     emaLoss,\r\n\u001b[?2004l\r"]
[6669.682913, "o", "\u001b[?2004h> "]
[6669.683057, "o", "\\t\\t\\t\\t\\t\\t\"ratio\":        ratio,\r\n\u001b[?2004l\r"]
[6669.683118, "o", "\u001b[?2004h> "]
[6669.683187, "o", "\\t\\t\\t\\t\\t},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.683645, "o", "\\t\\t\\t\\t\\tEvidence: map[string]interface{}{\"window_values\": precedingLossValues(entries, lossEntries, i, 5)},\r\n\u001b[?2004l\r"]
[6669.683671, "o", "\u001b[?2004h"]
[6669.683691, "o", "> "]
[6669.683925, "o", "\\t\\t\\t\\t\\tSource:   firstSource(entries[lossEntries[i]]),\r\n\u001b[?2004l\r"]
[6669.684, "o", "\u001b[?2004h"]
[6669.701258, "o", "> \\t\\t\\t\\t})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.701324, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[6669.701391, "o", "\u001b[?2004h> "]
[6669.701444, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.701469, "o", "> "]
[6669.701756, "o", "\\t\\temaLoss = (1-alpha)*emaLoss + alpha*currentLoss\r\n\u001b[?2004l\r"]
[6669.701828, "o", "\u001b[?2004h> "]
[6669.701892, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6669.702023, "o", "\\treturn anomalies\r\n\u001b[?2004l\r"]
[6669.702087, "o", "\u001b[?2004h> "]
[6669.70215, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.702203, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[6669.702277, "o", "> '''\r\n\u001b[?2004l\r"]
[6669.702303, "o", "\u001b[?2004h> "]
