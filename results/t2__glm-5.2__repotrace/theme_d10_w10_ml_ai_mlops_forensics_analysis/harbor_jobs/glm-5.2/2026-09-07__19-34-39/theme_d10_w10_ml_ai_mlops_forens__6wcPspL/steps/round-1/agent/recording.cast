[5424.496452, "o", "rity: \"medium\",\r\ninternal/forensics/detect.go:286:\t\t\t\tSeverity: \"low\",\r\ninternal/forensics/detect.go:325:\t\t\t\tSeverity: \"high\",\r\ninternal/forensics/detect.go:365:\t\t\t\tSeverity: \"critical\",\r\ninternal/forensics/detect.go:382:\t\t\t\t\tSeverity: \"critical\",\r\ninternal/forensics/detect.go:401:\t\t\t\t\tSeverity: \"critical\",\r\ninternal/forensics/detect.go:419:\t\t\t\t\tSeverity: \"high\",\r\ninternal/forensics/detect.go:503:\t\t\t\tSeverity: \"high\",\r\ninternal/forensics/detect.go:610:\trank := map[string]int{\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3}\r\ninternal/forensics/detect.go:612:\t\tri := rank[a[i].Severity]\r\ninternal/forensics/detect.go:613:\t\trj := rank[a[j].Severity]\r\ninternal/forensics/forensics.go:38:\t\tlower := strings.ToLower(name)\r\ninternal/forensics/forensics.go:40:\t\tcase strings.HasSuffix(lower, \".mlck\"):\r\ninternal/forensics/forensics.go:42:\t\tcase strings.HasSuffix(lower, \".jsonl\"):\r\ninternal/forensics/forensics.go:44:\t\tcase strings.HasPrefix(name, \"config_\") && strings.HasSuffix(lower, \".json\"):\r\ninternal/forensics/forensics"]
[5424.496577, "o", ".go:136:\t\tinfo, entries, err := parseShardRecursive(p)\r\ninternal/forensics/forensics.go:141:\t\t\tFile:    info.File,\r\ninternal/forensics/forensics.go:142:\t\t\tEntries: info.Entries,\r\ninternal/forensics/forensics.go:144:\t\tif info.Entries > 0 {\r\ninternal/forensics/forensics.go:145:\t\t\tshard.StepRange = []int{info.MinStep, info.MaxStep}\r\ninternal/forensics/forensics.go:146:\t\t\tshard.EpochRange = []int{info.MinEpoch, info.MaxEpoch}\r\ninternal/forensics/forensics.go:147:\t\t\tif info.MinTs != \"\" || info.MaxTs != \"\" {\r\ninternal/forensics/forensics.go:148:\t\t\t\tshard.TimeRange = []string{info.MinTs, info.MaxTs}\r\ninternal/forensics/forensics.go:421:\t\tinfo, entries, err := parseShardRecursive(p)\r\ninternal/forensics/forensics.go:425:\t\tshards = append(shards, info)\r\ncmd/mlforge/main.go:17:\tfilterSeverity := \"\"\r\ncmd/mlforge/main.go:35:\t\tcase strings.HasPrefix(arg, \"--filter-severity=\"):\r\ncmd/mlforge/main.go:36:\t\t\tfilterSeverity = strings.TrimPrefix(arg, \"--filter-severity=\")\r\ncmd/mlforge/main.go:37:\t\tcase arg == \"--filter-severity\":"]
