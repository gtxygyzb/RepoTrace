[4423.785244, "o", "bash: printf: --: invalid option\r\nprintf: usage: printf [-v var] format [arguments]\r\n"]
[4423.788258, "o", "\r\nfunc detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]"]
[4423.788347, "o", "\r\n\t\tif prev.Epoch != cur.Epoch {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tprevT, err1 := time.Parse(time.RFC3339, prev.Ts)\r\n\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\r\n\t\tif err1 != nil || err2 != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tdiff := curT.Sub(prevT).Seconds()\r\n\t\tif diff > 3600 {\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n"]
[4423.788427, "o", "\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"training_gap\",\r\n\t\t\t\tSeverity: \"low\",\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"after_step\":  prev.Step,\r\n\t\t\t\t\t\"before_step\": cur.Step,\r\n\t\t\t\t\t\"after_ts\":    prev.Ts,\r\n\t\t\t\t\t\"before_ts\":   cur.Ts,\r\n\t\t\t\t\t\"gap_seconds\": diff,\r\n"]
[4423.788504, "o", "\t\t\t\t},\r\n\t\t\t\tSource: firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n"]
[4423.78858, "o", "}\r\n\r\nfunc detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar cps []types.TimelineEntry\r\n\tfor _, e := range entries {\r\n\t\tif e.Event == \"checkpoint\" {\r\n\t\t\tcps = append(cps, e)\r\n\t\t}\r\n\t}\r\n\tsortTimeline(cps)\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(cps); i++ {\r\n\t\tprev := cps[i-1]\r\n\t\tcur := cps[i]\r\n\t\tif prev.Acc == nil || cur.Acc == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tdrop := *prev.Acc - *cur.Acc\r\n\t\tif drop > 0.15 {\r\n"]
[4423.788653, "o", "\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"metric_regression\",\r\n\t\t\t\tSeverity: \"high\",\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"prev_acc\":        *prev.Acc,\r\n\t\t\t\t\t\"curr_acc\":        *cur.Acc,\r\n\t\t\t\t\t\"drop\":            drop,\r\n"]
[4423.788731, "o", "\t\t\t\t\t\"prev_checkpoint\": prev.Step,\r\n\t\t\t\t\t\"curr_checkpoint\": cur.Step,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\thashSet := map[string]*types.CheckpointFile{}\r\n"]
[4423.788799, "o", "\tfor _, cf := range cps {\r\n\t\thashSet[cf.FileHash] = cf\r\n\t}\r\n\r\n\tfor _, cf := range cps {\r\n\t\traw, err := os.ReadFile(cf.Path)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif !cf.HeaderValid {\r\n\t\t\tstored := uint64(0)\r\n"]
[4423.788868, "o", "\t\t\tif len(raw) >= 56 {\r\n\t\t\t\tstored = binary.LittleEndian.Uint64(raw[48:56])\r\n\t\t\t}\r\n\t\t\th := fnv.New64a()\r\n\t\t\th.Write(raw[:48])\r\n\t\t\tcomputed := h.Sum64()\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"header_checksum_mismatch\",\r\n"]
[4423.788981, "o", "\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"file\":              cf.Filename,\r\n\t\t\t\t\t\"expected_checksum\": fmt.Sprintf(\"%016x\", stored),\r\n\t\t\t\t\t\"actual_checksum\":   fmt.Sprintf(\"%016x\", computed),\r\n\t\t\t\t},\r\n\t\t\t\tSource:     cf.Filename,\r\n\t\t\t\tCheckpoint: cf.Filename,\r\n\t\t\t})\r\n\t\t}\r\n\r\n\t\tfor _, t := range cf.Tensors {\r\n"]
[4423.789059, "o", "\t\t\tif !t.Valid {\r\n\t\t\t\tcomputed := sha256.Sum256(t.Data)\r\n\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\t\tType:     \"tensor_checksum_mismatch\",\r\n\t\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":              cf.Filename,\r\n\t\t\t\t\t\t\"tensor_name\":       t.Name,\r\n\t\t\t\t\t\t\"expected_checksum\": hex.EncodeToString(t.Hash[:]),\r\n\t\t\t\t\t\t\"actual_checksum\":   hex.EncodeToString(computed[:]),\r\n\t\t\t\t\t},\r\n\t\t\t\t\tSource:     cf.Filename,\r\n"]
[4423.789131, "o", "\t\t\t\t\tCheckpoint: cf.Filename,\r\n\t\t\t\t})\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif cf.Signed {\r\n\t\t\tvalid, signer := signatureDetails(cf.Path)\r\n"]
[4423.789202, "o", "\t\t\tif !valid {\r\n\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\t\tType:     \"signature_invalid\",\r\n\t\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":      cf.Filename,\r\n\t\t\t\t\t\t\"signer_id\": signer,\r\n\t\t\t\t\t\t\"valid\":     false,\r\n\t\t\t\t\t},\r\n\t\t\t\t\tSource:     cf.Filename,\r\n\t\t\t\t\tCheckpoint: cf.Filename,\r\n\t\t\t\t})\r\n\t\t\t}\r\n\t\t}\r\n\r\n"]
[4423.789275, "o", "\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n\t\t\t_, found := hashSet[cf.Provenance.ParentHash]\r\n\t\t\tif !found {\r\n\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\t\tType:     \"provenance_chain_break\",\r\n\t\t\t\t\tSeverity: \"high\",\r\n\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":        cf.Filename,\r\n\t\t\t\t\t\t\"parent_hash\": cf.Provenance.ParentHash,\r\n\t\t\t\t\t\t\"found\":       false,\r\n"]
[4423.789345, "o", "\t\t\t\t\t},\r\n\t\t\t\t\tSource:     cf.Filename,\r\n\t\t\t\t\tCheckpoint: cf.Filename,\r\n\t\t\t\t})\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tanomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)\r\n\treturn anomalies\r\n}\r\n\r\n"]
[4423.789413, "o", "func detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {\r\n\tbyHash := map[string]*types.CheckpointFile{}\r\n\tfor _, cf := range cps {\r\n\t\tbyHash[cf.FileHash] = cf\r\n\t}\r\n\tchildren := map[string][]string{}\r\n\tfor _, cf := range cps {\r\n\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n\t\t\tif _, ok := byHash[cf.Provenance.ParentHash]; ok {\r\n\t\t\t\tchildren[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)\r\n\t\t\t}\r\n"]
[4423.78949, "o", "\t\t}\r\n\t}\r\n\r\n\tvar anomalies []types.Anomaly\r\n\tseen := map[string]bool{}\r\n\tfor _, cf := range cps {\r\n\t\tif cf.Provenance == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\troot := cf.FileHash\r\n\t\tfor root != \"\" {\r\n\t\t\tparent, ok := byHash[root]\r\n\t\t\tif !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == \"\" {\r\n"]
[4423.789568, "o", "\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\troot = parent.Provenance.ParentHash\r\n\t\t}\r\n\t\tif seen[root] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tseen[root] = true\r\n\r\n\t\tchain := []string{}\r\n\t\tqueue := []string{root}\r\n\t\tvisited := map[string]bool{}\r\n\t"]
[4423.789652, "o", "\tfor len(queue) > 0 {\r\n\t\t\tcur := queue[0]\r\n\t\t\tqueue = queue[1:]\r\n\t\t\tif visited[cur] {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvisited[cur] = true\r\n\t\t\tnode, ok := byHash[cur]\r\n\t\t\tif !ok || node == nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tchain = append(chain, node.Filename)\r\n"]
[4423.789726, "o", "\t\t\tqueue = append(queue, children[cur]...)\r\n\t\t}\r\n\t\tsort.Strings(chain)\r\n\r\n\t\thashes := map[string]struct{}{}\r\n\t\tfor _, h := range chain {\r\n\t\t\tif node, ok := byHashFile(cps, h); ok && node.Provenance != nil {\r\n\t\t\t\thashes[node.Provenance.DatasetHash] = struct{}{}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif len(hashes) > 1 {\r\n"]
[4423.789795, "o", "\t\t\tunique := make([]string, 0, len(hashes))\r\n\t\t\tfor h := range hashes {\r\n\t\t\t\tunique = append(unique, h)\r\n\t\t\t}\r\n\t\t\tsort.Strings(unique)\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"dataset_hash_inconsistency\",\r\n\t\t\t\tSeverity: \"high\",\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"files\":  chain,\r\n"]
[4423.789862, "o", "\t\t\t\t\t\"hashes\": unique,\r\n\t\t\t\t},\r\n\t\t\t\tSource: chain[0],\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n"]
