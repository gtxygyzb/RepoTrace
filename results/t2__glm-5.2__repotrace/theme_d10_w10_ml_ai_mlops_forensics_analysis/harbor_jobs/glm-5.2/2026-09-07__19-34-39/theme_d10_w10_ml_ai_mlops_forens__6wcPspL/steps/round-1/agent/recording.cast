[5605.222265, "o", "\r\nfunc sortAnomalies(a []types.Anomaly) {\r\n\trank := map[string]int{\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3, \"info\": 4}\r\n\tsort.Slice(a, func(i, j int) bool {\r\n\t\tri := rank[a[i].Severity]\r\n\t\trj := rank[a[j].Severity]\r\n\t\tif ri != rj {\r\n\t\t\treturn ri < rj\r\n\t\t}\r\n\t\tif a[i].Type != a[j].Type {\r\n\t\t\treturn a[i].Type < a[j].Type\r\n\t\t}\r\n\t\tei := -1\r\n\t\tif a[i].Epoch != nil {\r\n\t\t\tei = *a[i].Epoch\r\n"]
[5605.222413, "o", "\t\t}\r\n\t\tej := -1\r\n\t\tif a[j].Epoch != nil {\r\n\t\t\tej = *a[j].Epoch\r\n\t\t}\r\n\t\tif ei != ej {\r\n\t\t\treturn ei < ej\r\n\t\t}\r\n\t\tsi := -1\r\n\t\tif a[i].Step != nil {\r\n\t\t\tsi = *a[i].Step\r\n\t\t}\r\n\t\tsj := -1\r\n\t\tif a[j].Step != nil {\r\n\t\t\tsj = *a[j].Step\r\n\t\t}\r\n\t\treturn si < sj\r\n\t})\r\n}\r\n"]
