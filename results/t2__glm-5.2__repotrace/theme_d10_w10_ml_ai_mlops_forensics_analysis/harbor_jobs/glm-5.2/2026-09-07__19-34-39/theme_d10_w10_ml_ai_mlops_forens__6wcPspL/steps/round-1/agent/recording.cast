[1096.297619, "i", "python3 - <<'PY'\nimport struct, hashlib, os, time\nos.makedirs('/tmp/evidence', exist_ok=True)\n\ndef fnv64a(data):\n    h = 0xcbf29ce484222325\n    for b in data:\n        h ^= b\n        h = (h * 0x100000001b3) & 0xffffffffffffffff\n    return h\n\ndef make_mlck(path, parent_hash='', dataset=b'\\x01'*32, ts=None):\n    if ts is None:\n        ts = int(time.time())\n    # tensor data\n    name = b'w'\n    data = b'\\x00\\x00\\x80\\x3f'  # float32 1.0\n    tensor_hash = hashlib.sha256(data).digest()\n    tensor_block = struct.pack('<H', len(name)) + name + struct.pack('<B', 0) + struct.pack('<B', 1) + struct.pack('<I', 1) + struct.pack('<Q', len(data)) + data + tensor_hash\n    # provenance\n    git = b'0'*40\n    config_hash = b'\\xcc'*32\n    framework = b'PyTorch'\n    framework_version = b'2.1.0'\n    prov = git + dataset + config_hash + struct.pack('<q', ts) + struct.pack('<d', 1.0) + struct.pack('<H', len(framework)) + framework + struct.pack('<H', len(framework_version)) + framework_version + struct.pack('<I', 1) + struct.pack('<Q"]
