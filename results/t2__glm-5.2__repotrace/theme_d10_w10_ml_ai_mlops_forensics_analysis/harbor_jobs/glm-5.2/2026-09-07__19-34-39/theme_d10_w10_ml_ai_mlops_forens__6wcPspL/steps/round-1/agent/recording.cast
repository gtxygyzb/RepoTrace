[7995.786116, "o", "\u001b[?2004hroot@n30009:/app# "]
[7995.786973, "o", "./mlforge detect --format=json \"$tmpdir\" | tee /tmp/detect.json | python3 -m json.tool >/dev/null && grep -q '\"command\": \"detect\"' /tmp/detect.json"]
[7995.80117, "o", "\r\n\u001b[?2004l\r"]
[7995.858696, "o", "\u001b[?2004hroot@n30009:/app# "]
