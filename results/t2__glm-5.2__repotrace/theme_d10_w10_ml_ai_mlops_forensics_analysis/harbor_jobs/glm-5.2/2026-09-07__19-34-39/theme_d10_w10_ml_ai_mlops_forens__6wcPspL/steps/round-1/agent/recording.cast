[2917.890513, "o", "\t}\r\n\treturn allEntries, shards, nil\r\n}\r\n\r\n"]
[2917.890615, "o", "func mergeTimeline(entries []types.TimelineEntry) ([]types.TimelineEntry, int) {\r\n\ttype agg struct {\r\n\t\tentry    types.TimelineEntry\r\n\t\tsources  map[string]struct{}\r\n\t\tconflict bool\r\n\t}\r\n\tm := map[string]*agg{}\r\n\tfor _, e := range entries {\r\n\t\tkey := fmt.Sprintf(\"%d:%d\", e.Epoch, e.Step)\r\n\t\ta, ok := m[key]\r\n\t\tif !ok {\r\n\t\t\tsrc := map[string]struct{}{}\r\n\t\t\tfor _, s := range e.Sources {\r\n\t\t\t\tsrc[s] = struct{}{}\r\n\t\t\t}\r\n\t\t\tm[key] = &agg{entry: e, sources: src}\r\n"]
[2917.890705, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tfor _, s := range e.Sources {\r\n\t\t\ta.sources[s] = struct{}{}\r\n\t\t}\r\n\t\tif metricsEqual(a.entry, e) {\r\n\t\t\tif e.Ts > a.entry.Ts {\r\n\t\t\t\ta.entry = e\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\ta.conflict = true\r\n"]
[2917.890767, "o", "\t\tif e.Ts > a.entry.Ts {\r\n\t\t\ta.entry = e\r\n\t\t}\r\n\t}\r\n"]
