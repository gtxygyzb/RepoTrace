[1808.932591, "o", "   500\t\tvar gaps []TimelineGap\r\n   501\t\tfor i := 1; i < len(entries); i++ {\r\n   502\t\t\tprev := entries[i-1]\r\n   503\t\t\tcur := entries[i]\r\n"]
[1808.932659, "o", "   504\t\t\tif prev.Epoch != cur.Epoch {\r\n   505\t\t\t\t"]
[1808.932713, "o", "continue\r\n   506\t\t\t}\r\n   507\t\t\tdiff := cur.Step - prev.Step\r\n   508\t\t\tif diff > 50 {\r\n   509\t\t\t\tgaps = append(gaps, TimelineGap{\r\n   510\t\t\t\t\tAfterStep:  prev.Step,\r\n   511\t\t\t\t\tBeforeStep: cur.Step,\r\n   512\t\t\t\t\tEpoch:      prev.Epoch,\r\n"]
[1808.932772, "o", "   513\t\t\t\t\tGapSteps:   diff,\r\n   514\t\t\t\t\tAfterTs:    prev.Ts,\r\n   515\t\t\t\t\tBeforeTs:   cur.Ts,\r\n   516\t\t\t\t})\r\n   517\t\t\t}\r\n   518\t\t}\r\n   519\t\treturn gaps\r\n   520\t}\r\n"]
