[5031.502033, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KBuildDetectFiltered\u001b[m\u001b[K(dir, filterSeverity string) (DetectOutput, error) {\r\n"]
[5031.502091, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\twantedRank, ok := \u001b[01;31m\u001b[KseverityRank\u001b[m\u001b[KValue(filterSeverity)\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif \u001b[01;31m\u001b[KseverityRank\u001b[m\u001b[K(a.Severity) <= wantedRank {\r\n"]
[5031.502147, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KseverityRank\u001b[m\u001b[K(s string) int {\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KseverityRank\u001b[m\u001b[KValue(s string) (int, bool) {\r\n"]
[5031.502296, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K366\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[KEvidence\u001b[m\u001b[K:   map[string]interface{}{},\r\n"]
[5031.50236, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K384\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\u001b[01;31m\u001b[KEvidence\u001b[m\u001b[K:   map[string]interface{}{},\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\u001b[01;31m\u001b[KEvidence\u001b[m\u001b[K:   map[string]interface{}{},\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\u001b[01;31m\u001b[KEvidence\u001b[m\u001b[K:   map[string]interface{}{},\r\n"]
