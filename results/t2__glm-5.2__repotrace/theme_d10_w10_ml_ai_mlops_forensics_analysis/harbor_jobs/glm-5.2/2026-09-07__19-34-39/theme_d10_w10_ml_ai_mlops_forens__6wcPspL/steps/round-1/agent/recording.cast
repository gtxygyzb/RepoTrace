[7777.077133, "o", "def patch(path, transforms):\r\n\u001b[?2004l\r"]
[7777.077195, "o", "\u001b[?2004h> "]
[7777.077404, "o", "    s = open(path).read()\r\n\u001b[?2004l\r"]
[7777.077465, "o", "\u001b[?2004h> "]
[7777.077754, "o", "    for kind, pattern, repl in transforms:\r\n\u001b[?2004l\r"]
[7777.07782, "o", "\u001b[?2004h> "]
[7777.078013, "o", "        if kind == 'sub':\r\n\u001b[?2004l\r"]
[7777.078079, "o", "\u001b[?2004h> "]
[7777.078404, "o", "            s = re.sub(pattern, repl, s, count=1)\r\n\u001b[?2004l\r"]
[7777.078458, "o", "\u001b[?2004h> "]
[7777.078647, "o", "        elif kind == 'replace':\r\n\u001b[?2004l\r"]
[7777.078695, "o", "\u001b[?2004h> "]
[7777.078896, "o", "            if pattern not in s:\r\n\u001b[?2004l\r"]
[7777.078962, "o", "\u001b[?2004h> "]
[7777.079416, "o", "                raise ValueError(f'pattern not found in {path}: {pattern!r}')\r\n\u001b[?2004l\r"]
[7777.079464, "o", "\u001b[?2004h"]
[7777.079509, "o", "> "]
[7777.079733, "o", "            s = s.replace(pattern, repl, 1)\r\n\u001b[?2004l\r"]
[7777.079779, "o", "\u001b[?2004h> "]
[7777.079967, "o", "    open(path, 'w').write(s)\r\n\u001b[?2004l\r"]
