[3270.191102, "o", "sed -n '1,120p' docs/formats.md\r\n\u001b[?2004l\r"]
[3270.1944, "o", "# File Format Specifications\r\n\r\n## 1. MLCK Checkpoint Format (`.mlck`)\r\n\r\nAll multi-byte integer and floating-point values are **little-endian**.\r\n\r\n"]
[3270.194511, "o", "### File Layout\r\n\r\n```\r\n[Header (56 bytes)]\r\n[Tensor Block 0]\r\n[Tensor Block 1]\r\n...\r\n[Tensor Block N-1]\r\n[Metadata Section]\r\n[Provenance Section]\r\n[Signature Block]      (only if Header.Flags bit 0 is set)\r\n```\r\n\r\n### 1.1 Header (56 bytes)\r\n\r\n| Offset | Size | Type | Field | Description |\r\n|--------|------|------|-------|-------------|\r\n| 0 | 4 | bytes | Magic | Must be `MLCK` (0x4D 0x4C 0x43 0x4B) |\r\n| 4 | 2 | uint16 | Version | Must be `1` |\r\n| 6 | 2 | uint16 | Flags | Bit 0: signed (has signature block). Bits 1-15: reserved (must be 0) |\r\n| 8 | 4 | uint32 | NumTensors | Number of tensor blocks |\r\n| 12 | 4 | uint32 | NumMetadata | Number of metadata key-value pairs |\r\n| 16 | 8 | uint64 | MetadataOffset | Byte offset of metadata section from file start |\r\n| 24 | 8 | uint64 | ProvenanceOffset | Byte offset of provenance section from file start |\r\n| 32 | 8 | uint64 | SignatureOffset | Byte offset of signature block (0 if unsigned) |"]
[3270.194595, "o", "\r\n| 40 | 8 | int64 | CreationTimestamp | Unix timestamp (seconds) when checkpoint was created |\r\n| 48 | 8 | uint64 | HeaderChecksum | FNV-1a 64-bit hash of bytes [0..48) |\r\n\r\n### 1.2 Tensor Blocks\r\n\r\nTensor blocks start immediately after the header (offset 56). Each tensor block has variable length:\r\n\r\n| Size | Type | Field | Description |\r\n|------|------|-------|-------------|\r\n| 2 | uint16 | NameLen | Length of tensor name in bytes |\r\n| NameLen | bytes | Name | UTF-8 tensor name (e.g., `encoder.layer0.weight`) |\r\n| 1 | uint8 | Dtype | Data type enum (see below) |\r\n| 1 | uint8 | NumDims | Number of dimensions (1-8) |\r\n| 4 * NumDims | uint32[] | Shape | Dimension sizes |\r\n| 8 | uint64 | DataSize | Size of raw tensor data in bytes |\r\n"]
[3270.19467, "o", "| DataSize | bytes | Data | Raw tensor data |\r\n| 32 | bytes | Checksum | SHA-256 hash of the Data bytes |\r\n\r\n**Dtype values:**\r\n\r\n| Value | Type | Byte size per element |\r\n|-------|------|----------------------|\r\n| 0 | float32 | 4 |\r\n| 1 | float64 | 8 |\r\n| 2 | float16 | 2 |\r\n| 3 | int32 | 4 |\r\n| 4 | int64 | 8 |\r\n| 5 | bfloat16 | 2 |\r\n\r\n**Validation**: `DataSize` must equal `product(Shape) * element_byte_size`. If it does not match, the tensor block is malformed.\r\n"]
[3270.194744, "o", "\r\n### 1.3 Metadata Section\r\n\r\nLocated at `MetadataOffset`. Contains `NumMetadata` key-value pairs:\r\n\r\n| Size | Type | Field | Description |\r\n|------|------|-------|-------------|\r\n| 2 | uint16 | KeyLen | Length of key |\r\n| KeyLen | bytes | Key | UTF-8 key string |\r\n"]
[3270.194813, "o", "| 4 | uint32 | ValueLen | Length of value |\r\n| ValueLen | bytes | Value | UTF-8 value (JSON-encoded) |\r\n\r\nCommon metadata keys:\r\n- `model_name`: string, the model architecture name\r\n- `dataset`: string, training dataset identifier\r\n- `training_config`: JSON object with hyperparameters\r\n- `notes`: string, free-form notes\r\n\r\n### 1.4 Provenance Section\r\n\r\nLocated at `ProvenanceOffset`. Fixed structure followed by variable-length fields:\r\n\r\n| Size | Type | Field | Description |\r\n|------|------|-------|-------------|\r\n| 40 | bytes | GitCommit | ASCII hex string of git commit hash (zero-padded if absent) |\r\n| 32 | bytes | DatasetHash | Raw SHA-256 of the training dataset manifest |\r\n| 32 | bytes | ConfigHash | Raw SHA-256 of the training configuration |\r\n| 8 | int64 | TrainingTimestamp | Unix timestamp when training started |\r\n"]
[3270.194876, "o", "| 8 | float64 | TrainingDuration | Training duration in seconds |\r\n| 2 | uint16 | FrameworkLen | Length of framework name |\r\n| FrameworkLen | bytes | Framework | UTF-8 framework name (e.g., `PyTorch`, `JAX`) |\r\n| 2 | uint16 | FrameworkVersionLen | Length of framework version string |\r\n| FrameworkVersionLen | bytes | FrameworkVersion | UTF-8 version (e.g., `2.1.0`) |\r\n| 4 | uint32 | Epoch | Training epoch at checkpoint time |\r\n| 8 | uint64 | GlobalStep | Global training step |\r\n| 8 | float64 | LearningRate | Learning rate at checkpoint time |\r\n| 2 | uint16 | ParentHashLen | Length of parent hash string (0 = no parent) |\r\n| ParentHashLen | bytes | ParentHash | ASCII hex SHA-256 of the parent checkpoint file (for lineage) |\r\n"]
[3270.194947, "o", "\r\n### 1.5 Signature Block\r\n\r\nLocated at `SignatureOffset` (only present if `Flags` bit 0 is set):\r\n\r\n| Size | Type | Field | Description |\r\n|------|------|-------|-------------|\r\n| 1 | uint8 | Algorithm | 0 = HMAC-SHA256 |\r\n| 2 | uint16 | SignerIdLen | Length of signer identifier |\r\n| SignerIdLen | bytes | SignerId | UTF-8 signer identifier (used as HMAC key) |\r\n| 2 | uint16 | SignatureLen | Length of signature |\r\n| SignatureLen | bytes | Signature | The signature bytes |\r\n"]
[3270.19501, "o", "\r\n**HMAC-SHA256 computation**: The HMAC is computed over all bytes from offset 0 to `SignatureOffset` (exclusive), using `SignerId` as the HMAC key.\r\n\r\n---\r\n\r\n## 2. Training Log Shard Format (`.jsonl`)\r\n\r\nEach `.jsonl` file contains one JSON object per line. Each object represents a training step event:\r\n\r\n"]
[3270.195519, "o", "\u001b[?2004h"]
[3270.195575, "o", "root@n30009:/app# "]
[3270.47577, "i", "sed -n '1,110p' internal/forensics/diff.go\n"]
[3270.476149, "o", "sed -n '1,110p' internal/forensics/diff.go\r\n"]
[3270.476232, "o", "\u001b[?2004l\r"]
[3270.479137, "o", "package forensics\r\n\r\nimport (\r\n\t\"encoding/binary\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"path/filepath\"\r\n"]
[3270.479219, "o", "\t\"sort\"\r\n\r\n\t\"mlforge/internal/checkpoint\"\r\n\t\"mlforge/internal/types\"\r\n)\r\n\r\n// diffTensorResult describes one tensor in the diff output.\r\ntype diffTensorResult struct {\r\n\tName        string   `json:\"name\"`\r\n\tShapeMatch  bool     `json:\"shape_match\"`\r\n\tShapeA      []uint32 `json:\"shape_a\"`\r\n\tShapeB      []uint32 `json:\"shape_b\"`\r\n\tMaxAbsDiff  *float64 `json:\"max_abs_diff,omitempty\"`\r\n\tMeanAbsDiff *float64 `json:\"mean_abs_diff,omitempty\"`\r\n}\r\n"]
[3270.479302, "o", "\r\n// diffSummary summarizes tensor presence and shape compatibility.\r\ntype diffSummary struct {\r\n\tTotalTensorsA   int      `json:\"total_tensors_a\"`\r\n\tTotalTensorsB   int      `json:\"total_tensors_b\"`\r\n\tCommonTensors   int      `json:\"common_tensors\"`\r\n\tShapeMismatches int      `json:\"shape_mismatches\"`\r\n\tOnlyInA         []string `json:\"only_in_a\"`\r\n\tOnlyInB         []string `json:\"only_in_b\"`\r\n}\r\n\r\n// diffOutput is the JSON output for the diff command.\r\ntype diffOutput struct {\r\n\tStatus      string             `json:\"status\"`\r\n\t"]
[3270.479378, "o", "FileA       string             `json:\"file_a\"`\r\n\tFileB       string             `json:\"file_b\"`\r\n\tTensorDiffs []diffTensorResult `json:\"tensor_diffs\"`\r\n\tSummary     diffSummary        `json:\"summary\"`\r\n}\r\n\r\nconst float32Dtype byte = 0\r\n\r\n"]
[3270.479448, "o", "// BuildDiff compares two checkpoint files inside evidenceDir tensor by tensor.\r\nfunc BuildDiff(evidenceDir, file1, file2 string) (interface{}, error) {\r\n\tpathA := filepath.Join(evidenceDir, file1)\r\n\tpathB := filepath.Join(evidenceDir, file2)\r\n\r\n\tcfA, err := checkpoint.Parse(pathA)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"diff: %s: %w\", file1, err)\r\n\t}\r\n\tif cfA == nil {\r\n\t\treturn nil, fmt.Errorf(\"diff: %s: not found\", file1)\r\n\t}\r\n\tcfB, err := checkpoint.Parse(pathB)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"diff: %s: %w\", file2, err)\r\n\t}\r\n\tif cfB == nil {\r\n\t\treturn nil, fmt.Errorf(\"diff: %s: not found\", file2)\r\n\t}\r\n\r\n\ttensorsA := make(map[string]types.TensorInfo, len(cfA.Tensors))\r\n"]
[3270.479514, "o", "\tfor _, t := range cfA.Tensors {\r\n\t\ttensorsA[t.Name] = t\r\n\t}\r\n\ttensorsB := make(map[string]types.TensorInfo, len(cfB.Tensors))\r\n\tfor _, t := range cfB.Tensors {\r\n\t\ttensorsB[t.Name] = t\r\n\t}\r\n\r\n\tnames := map[string]struct{}{}\r\n\tfor name := range tensorsA {\r\n\t\tnames[name] = struct{}{}\r\n\t}\r\n"]
[3270.479579, "o", "\tfor name := range tensorsB {\r\n\t\tnames[name] = struct{}{}\r\n\t}\r\n\tsortedNames := make([]string, 0, len(names))\r\n\tfor name := range names {\r\n\t\tsortedNames = append(sortedNames, name)\r\n\t}\r\n\tsort.Strings(sortedNames)\r\n\r\n\tonlyInA := []string{}\r\n\tonlyInB := []string{}\r\n\tcommon := 0\r\n\t"]
[3270.479645, "o", "shapeMismatches := 0\r\n\ttensorDiffs := make([]diffTensorResult, 0, len(sortedNames))\r\n\r\n\tfor _, name := range sortedNames {\r\n\t\tta, okA := tensorsA[name]\r\n\t\ttb, okB := tensorsB[name]\r\n"]
[3270.479708, "o", "\r\n\t\tvar shapeA []uint32\r\n\t\tvar shapeB []uint32\r\n\t\tif okA {\r\n\t\t\tshapeA = ta.Shape\r\n\t\t}\r\n\t\tif okB {\r\n\t\t\tshapeB = tb.Shape\r\n\t\t}\r\n\r\n\t\tshapeMatch := okA && okB && shapesEqual(ta.Shape, tb.Shape)\r\n\t\tresult := diffTensorResult{\r\n\t\t\tName:       name,\r\n\t"]
[3270.479764, "o", "\t\tShapeMatch: shapeMatch,\r\n\t\t\tShapeA:     shapeA,\r\n"]
[3270.48025, "o", "\u001b[?2004h"]
[3270.480294, "o", "root@n30009:/app# "]
