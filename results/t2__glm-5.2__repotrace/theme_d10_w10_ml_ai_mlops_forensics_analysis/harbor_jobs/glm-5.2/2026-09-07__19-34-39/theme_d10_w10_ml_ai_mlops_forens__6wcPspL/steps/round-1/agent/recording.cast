[3606.652792, "o", "\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc compareStr(\u001b[m\u001b[Kval string, c condition) bool {\r\n\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc compareTs(\u001b[m\u001b[Kval string, c condition) bool {\r\n\u001b[32m\u001b[K166\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc absFloat(\u001b[m\u001b[Kx float64) float64 {\r\n\u001b[32m\u001b[K173\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc parseQuery(expr string) (\u001b[m\u001b[Kquery, error) {\r\n\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc parseCondition(tokens []string, i int) (\u001b[m\u001b[Kcondition, int, error) {\r\n\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc tokenizeQuery(s string) (\u001b[m\u001b[K[]string, error) {\r\n\u001b[32m\u001b[K301\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc isQuotedString(\u001b[m\u001b[Ks string) bool {\r\n\u001b[32m\u001b[K305\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc unquote(\u001b[m\u001b[Ks string) string {\r\n"]
