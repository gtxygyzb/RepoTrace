[5741.419889, "o", "\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t_, found := hashSet[cf.Provenance.ParentHash]\r\n\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif !found {\r\n\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n"]
