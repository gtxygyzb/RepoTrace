[5741.702199, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KBySeverity\u001b[m\u001b[K map[string]int `json:\"by_severity\"`\r\n"]
[5741.702268, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\twantedRank, ok := \u001b[01;31m\u001b[KseverityRank\u001b[m\u001b[KValue(filterSeverity)\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif \u001b[01;31m\u001b[KseverityRank\u001b[m\u001b[K(a.Severity) <= wantedRank {\r\n"]
[5741.702361, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KsortAnomalies\u001b[m\u001b[K(anomalies)\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tout.Summary.\u001b[01;31m\u001b[KBySeverity\u001b[m\u001b[K = map[string]int{}\r\n"]
[5741.702425, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tout.Summary.\u001b[01;31m\u001b[KBySeverity\u001b[m\u001b[K[a.Severity]++\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KseverityRank\u001b[m\u001b[K(s string) int {\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KseverityRank\u001b[m\u001b[KValue(s string) (int, bool) {\r\n"]
[5741.702568, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K613\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KsortAnomalies\u001b[m\u001b[K(a []types.Anomaly) {\r\n"]
