[3999.389252, "o", "internal/forensics/forensics.go:42:\t\tcase strings.HasSuffix(lower, \".jsonl\"):\r\ninternal/forensics/forensics.go:410:func loadTimelineEntries(dir string) ([]types.TimelineEntry, []logparser.ShardInfo, error) {\r\ninternal/forensics/forensics.go:434:func mergeTimeline(entries []types.TimelineEntry) ([]types.TimelineEntry, int) {\r\ninternal/logparser/logparser.go:14:// RawEntry is the JSON structure of a single line in a .jsonl training log shard.\r\ninternal/logparser/logparser.go:44:// ParseAll reads every .jsonl file in dir and returns all entries with source\r\ninternal/logparser/logparser.go:55:\t\tif de.IsDir() || !strings.HasSuffix(strings.ToLower(de.Name()), \".jsonl\") {\r\n"]
