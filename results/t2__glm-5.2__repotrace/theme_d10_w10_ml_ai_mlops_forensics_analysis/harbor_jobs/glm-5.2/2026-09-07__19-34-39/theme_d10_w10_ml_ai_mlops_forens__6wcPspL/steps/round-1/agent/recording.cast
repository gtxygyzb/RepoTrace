[7228.443331, "o", "\t\tGaps:              gaps,\r\n   213\t\t\tEntries:           merged,\r\n   214\t\t}\r\n   215\t\tif len(merged) > 0 {\r\n   216\t\t\tminStep, maxStep := merged[0].Step, merged[0].Step\r\n"]
[7228.443382, "o", "   217\t\t\tminTs, maxTs := merged[0].Ts, merged[0].Ts\r\n   218\t\t\tepochSet := map[int]struct{}{}\r\n   219\t\t\tfor _, e := range merged {\r\n   220\t\t\t\tepochSet[e.Epoch] = struct{}{}\r\n   221\t\t\t\tif e.Step < minStep {\r\n   222\t\t\t\t\tminStep = e.Step\r\n"]
