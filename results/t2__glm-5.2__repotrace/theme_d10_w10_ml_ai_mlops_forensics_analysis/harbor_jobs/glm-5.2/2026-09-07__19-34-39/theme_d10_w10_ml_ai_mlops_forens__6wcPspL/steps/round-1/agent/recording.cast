[3115.288277, "o", "        ShapeB      []uint32 `json:\"shape_b\"`\r\n\u001b[?2004l\r"]
[3115.288333, "o", "\u001b[?2004h> "]
[3115.288769, "o", "        MaxAbsDiff  *float64 `json:\"max_abs_diff,omitempty\"`\r\n\u001b[?2004l\r"]
[3115.288826, "o", "\u001b[?2004h> "]
[3115.301445, "o", "        MeanAbsDiff *float64 `json:\"mean_abs_diff,omitempty\"`\r\n\u001b[?2004l\r"]
[3115.301555, "o", "\u001b[?2004h"]
[3115.301626, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.301683, "o", "\u001b[?2004h> "]
[3115.302106, "o", "// diffSummary summarizes tensor presence and shape compatibility.\r\n\u001b[?2004l\r"]
[3115.302192, "o", "\u001b[?2004h> "]
[3115.302348, "o", "type diffSummary struct {\r\n\u001b[?2004l\r"]
[3115.302411, "o", "\u001b[?2004h> "]
[3115.302796, "o", "        TotalTensorsA  int      `json:\"total_tensors_a\"`\r\n\u001b[?2004l\r"]
[3115.302853, "o", "\u001b[?2004h> "]
[3115.303252, "o", "        TotalTensorsB  int      `json:\"total_tensors_b\"`\r\n\u001b[?2004l\r"]
[3115.303359, "o", "\u001b[?2004h"]
[3115.303418, "o", "> "]
[3115.303701, "o", "        CommonTensors  int      `json:\"common_tensors\"`\r\n\u001b[?2004l\r"]
[3115.303769, "o", "\u001b[?2004h"]
[3115.303825, "o", "> "]
[3115.304173, "o", "        ShapeMismatches int     `json:\"shape_mismatches\"`\r\n\u001b[?2004l\r"]
[3115.304231, "o", "\u001b[?2004h> "]
[3115.304585, "o", "        OnlyInA        []string `json:\"only_in_a\"`\r\n\u001b[?2004l\r"]
[3115.304649, "o", "\u001b[?2004h> "]
[3115.304999, "o", "        OnlyInB        []string `json:\"only_in_b\"`\r\n\u001b[?2004l\r"]
[3115.305057, "o", "\u001b[?2004h> }\r\n"]
[3115.305117, "o", "\u001b[?2004l\r\u001b[?2004h"]
[3115.305172, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.305242, "o", "> "]
[3115.305577, "o", "// diffOutput is the JSON output for the diff command.\r\n\u001b[?2004l\r"]
[3115.305646, "o", "\u001b[?2004h> "]
[3115.30581, "o", "type diffOutput struct {\r\n\u001b[?2004l\r"]
[3115.305874, "o", "\u001b[?2004h> "]
[3115.306271, "o", "        Status      string             `json:\"status\"`\r\n\u001b[?2004l\r"]
[3115.306338, "o", "\u001b[?2004h> "]
[3115.306726, "o", "        FileA       string             `json:\"file_a\"`\r\n\u001b[?2004l\r"]
[3115.306784, "o", "\u001b[?2004h> "]
[3115.307172, "o", "        FileB       string             `json:\"file_b\"`\r\n\u001b[?2004l\r"]
[3115.307236, "o", "\u001b[?2004h"]
[3115.307295, "o", "> "]
[3115.307645, "o", "        TensorDiffs []diffTensorResult `json:\"tensor_diffs\"`\r\n\u001b[?2004l\r"]
[3115.307701, "o", "\u001b[?2004h> "]
[3115.308091, "o", "        Summary     diffSummary        `json:\"summary\"`\r\n\u001b[?2004l\r"]
[3115.308151, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[3115.30821, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.308277, "o", "\u001b[?2004h> "]
[3115.308553, "o", "const float32Dtype byte = 0\r\n\u001b[?2004l\r"]
[3115.308616, "o", "\u001b[?2004h"]
[3115.308678, "o", "> \r\n\u001b[?2004l\r"]
[3115.308735, "o", "\u001b[?2004h> "]
[3115.309657, "o", "// BuildDiff compares two checkpoint files inside evidenceDir tensor by tensor.\r\n\u001b[?2004l\r"]
[3115.309725, "o", "\u001b[?2004h"]
[3115.309781, "o", "> "]
[3115.310249, "o", "func BuildDiff(evidenceDir, file1, file2 string) (interface{}, error) {\r\n\u001b[?2004l\r"]
[3115.310306, "o", "\u001b[?2004h> "]
[3115.310653, "o", "        pathA := filepath.Join(evidenceDir, file1)\r\n\u001b[?2004l\r"]
[3115.310743, "o", "\u001b[?2004h> "]
[3115.311049, "o", "        pathB := filepath.Join(evidenceDir, file2)\r\n\u001b[?2004l\r"]
[3115.311097, "o", "\u001b[?2004h> \r\n"]
[3115.31115, "o", "\u001b[?2004l\r"]
[3115.311206, "o", "\u001b[?2004h> "]
[3115.311468, "o", "        cfA, err := checkpoint.Parse(pathA)\r\n\u001b[?2004l\r"]
[3115.311525, "o", "\u001b[?2004h> "]
[3115.31168, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[3115.311736, "o", "\u001b[?2004h> "]
[3115.312174, "o", "                return nil, fmt.Errorf(\"diff: %s: %w\", file1, err)\r\n\u001b[?2004l\r"]
[3115.312237, "o", "\u001b[?2004h> "]
[3115.312303, "o", "        }\r\n\u001b[?2004l\r"]
[3115.312361, "o", "\u001b[?2004h> "]
[3115.312511, "o", "        if cfA == nil {\r\n\u001b[?2004l\r"]
[3115.312568, "o", "\u001b[?2004h> "]
[3115.313008, "o", "                return nil, fmt.Errorf(\"diff: %s: not found\", file1)\r\n\u001b[?2004l\r"]
[3115.313065, "o", "\u001b[?2004h> "]
[3115.313123, "o", "        }\r\n\u001b[?2004l\r"]
[3115.313179, "o", "\u001b[?2004h"]
[3115.31325, "o", "> "]
[3115.313463, "o", "        cfB, err := checkpoint.Parse(pathB)\r\n\u001b[?2004l\r"]
[3115.313519, "o", "\u001b[?2004h> "]
[3115.313666, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[3115.313722, "o", "\u001b[?2004h> "]
[3115.314153, "o", "                return nil, fmt.Errorf(\"diff: %s: %w\", file2, err)\r\n\u001b[?2004l\r"]
[3115.314216, "o", "\u001b[?2004h> "]
[3115.314265, "o", "        }\r\n\u001b[?2004l\r"]
[3115.314316, "o", "\u001b[?2004h> "]
[3115.314486, "o", "        if cfB == nil {\r\n\u001b[?2004l\r"]
[3115.314542, "o", "\u001b[?2004h> "]
[3115.314986, "o", "                return nil, fmt.Errorf(\"diff: %s: not found\", file2)\r\n\u001b[?2004l\r"]
[3115.315043, "o", "\u001b[?2004h> "]
[3115.315106, "o", "        }\r\n\u001b[?2004l\r"]
[3115.315166, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.31522, "o", "\u001b[?2004h> "]
[3115.315668, "o", "        tensorsA := make(map[string]types.TensorInfo, len(cfA.Tensors))\r\n\u001b[?2004l\r"]
[3115.315724, "o", "\u001b[?2004h> "]
[3115.31598, "o", "        for _, t := range cfA.Tensors {\r\n\u001b[?2004l\r"]
[3115.316037, "o", "\u001b[?2004h> "]
[3115.316255, "o", "                tensorsA[t.Name] = t\r\n\u001b[?2004l\r"]
[3115.316321, "o", "\u001b[?2004h> "]
[3115.316386, "o", "        }\r\n\u001b[?2004l\r"]
[3115.316442, "o", "\u001b[?2004h> "]
[3115.316919, "o", "        tensorsB := make(map[string]types.TensorInfo, len(cfB.Tensors))\r\n\u001b[?2004l\r"]
[3115.316996, "o", "\u001b[?2004h> "]
[3115.317241, "o", "        for _, t := range cfB.Tensors {\r\n\u001b[?2004l\r"]
[3115.317297, "o", "\u001b[?2004h> "]
[3115.317536, "o", "                tensorsB[t.Name] = t\r\n\u001b[?2004l\r"]
[3115.317591, "o", "\u001b[?2004h> "]
[3115.31765, "o", "        }\r\n\u001b[?2004l\r"]
[3115.317713, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.317768, "o", "\u001b[?2004h> "]
[3115.31802, "o", "        names := map[string]struct{}{}\r\n\u001b[?2004l\r"]
[3115.318076, "o", "\u001b[?2004h> "]
[3115.318303, "o", "        for name := range tensorsA {\r\n\u001b[?2004l\r"]
[3115.31835, "o", "\u001b[?2004h> "]
[3115.318606, "o", "                names[name] = struct{}{}\r\n\u001b[?2004l\r"]
[3115.31867, "o", "\u001b[?2004h> "]
[3115.318744, "o", "        }\r\n\u001b[?2004l\r"]
[3115.318817, "o", "\u001b[?2004h> "]
[3115.319017, "o", "        for name := range tensorsB {\r\n\u001b[?2004l\r"]
[3115.319065, "o", "\u001b[?2004h> "]
[3115.319321, "o", "                names[name] = struct{}{}\r\n\u001b[?2004l\r"]
[3115.319368, "o", "\u001b[?2004h> "]
[3115.31945, "o", "        }\r\n\u001b[?2004l\r"]
[3115.319505, "o", "\u001b[?2004h> "]
[3115.319841, "o", "        sortedNames := make([]string, 0, len(names))\r\n\u001b[?2004l\r"]
[3115.319897, "o", "\u001b[?2004h> "]
[3115.320122, "o", "        for name := range names {\r\n\u001b[?2004l\r"]
[3115.320178, "o", "\u001b[?2004h> "]
[3115.320526, "o", "                sortedNames = append(sortedNames, name)\r\n\u001b[?2004l\r"]
[3115.320582, "o", "\u001b[?2004h> "]
[3115.320646, "o", "        }\r\n\u001b[?2004l\r"]
[3115.320704, "o", "\u001b[?2004h> "]
[3115.320851, "o", "        sort.Strings(sortedNames)\r\n\u001b[?2004l\r"]
[3115.320906, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.320971, "o", "> "]
[3115.321068, "o", "        onlyInA := []string{}\r\n\u001b[?2004l\r"]
[3115.321123, "o", "\u001b[?2004h> "]
[3115.321253, "o", "        onlyInB := []string{}\r\n\u001b[?2004l\r"]
[3115.321308, "o", "\u001b[?2004h> "]
[3115.32138, "o", "        common := 0\r\n\u001b[?2004l\r"]
[3115.321436, "o", "\u001b[?2004h> "]
[3115.32155, "o", "        shapeMismatches := 0\r\n\u001b[?2004l\r"]
[3115.321605, "o", "\u001b[?2004h> "]
[3115.321914, "o", "        tensorDiffs := make([]diffTensorResult, 0, len(sortedNames))\r\n\u001b[?2004l\r"]
[3115.321982, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rx\u001b[?2004h> "]
[3115.322196, "o", "        for _, name := range sortedNames {\r\n\u001b[?2004l\r"]
[3115.322251, "o", "\u001b[?2004h> "]
[3115.322432, "o", "                ta, okA := tensorsA[name]\r\n\u001b[?2004l\r"]
[3115.322522, "o", "\u001b[?2004h> "]
[3115.322639, "o", "                tb, okB := tensorsB[name]\r\n\u001b[?2004l\r"]
[3115.322701, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[3115.322889, "o", "                var shapeA []uint32\r\n\u001b[?2004l\r"]
[3115.322964, "o", "\u001b[?2004h> "]
[3115.323081, "o", "                var shapeB []uint32\r\n\u001b[?2004l\r"]
[3115.323136, "o", "\u001b[?2004h> "]
[3115.323229, "o", "                if okA {\r\n\u001b[?2004l\r"]
[3115.323284, "o", "\u001b[?2004h> "]
[3115.323459, "o", "                        shapeA = ta.Shape\r\n\u001b[?2004l\r"]
[3115.323514, "o", "\u001b[?2004h> "]
[3115.323583, "o", "                }\r\n\u001b[?2004l\r"]
[3115.323638, "o", "\u001b[?2004h> "]
[3115.323725, "o", "                if okB {\r\n\u001b[?2004l\r"]
[3115.323779, "o", "\u001b[?2004h> "]
[3115.32396, "o", "                        shapeB = tb.Shape\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.324021, "o", "> "]
[3115.324083, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.324138, "o", "> \r\n\u001b[?2004l\r2\u001b[?2004h> "]
[3115.324495, "o", "                shapeMatch := okA && okB && shapesEqual(ta.Shape, tb.Shape)\r\n\u001b[?2004l\r"]
[3115.324551, "o", "\u001b[?2004h> "]
[3115.324727, "o", "                result := diffTensorResult{\r\n\u001b[?2004l\r"]
[3115.324782, "o", "\u001b[?2004h> "]
[3115.324969, "o", "                        Name:       name,\r\n\u001b[?2004l\r"]
[3115.325025, "o", "\u001b[?2004h> "]
[3115.325207, "o", "                        ShapeMatch: shapeMatch,\r\n\u001b[?2004l\r"]
[3115.325263, "o", "\u001b[?2004h> "]
[3115.325437, "o", "                        ShapeA:     shapeA,\r\n\u001b[?2004l\r"]
[3115.325491, "o", "\u001b[?2004h> "]
[3115.325668, "o", "                        ShapeB:     shapeB,\r\n\u001b[?2004l\r"]
[3115.325724, "o", "\u001b[?2004h> "]
[3115.325796, "o", "                }\r\n\u001b[?2004l\r"]
[3115.325852, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h"]
[3115.325907, "o", "> "]
[3115.326035, "o", "                if okA && okB {\r\n\u001b[?2004l\r"]
[3115.326091, "o", "\u001b[?2004h> "]
[3115.326219, "o", "                        common++\r\n\u001b[?2004l\r"]
[3115.326274, "o", "\u001b[?2004h> "]
[3115.326453, "o", "                        if !shapeMatch {\r\n\u001b[?2004l\r"]
[3115.326508, "o", "\u001b[?2004h> "]
[3115.326699, "o", "                                shapeMismatches++\r\n\u001b[?2004l\r"]
[3115.326755, "o", "\u001b[?2004h> "]
[3115.326911, "o", "                        } else {\r\n\u001b[?2004l\r"]
[3115.326974, "o", "\u001b[?2004h> "]
[3115.327337, "o", "                                maxDiff, meanDiff, err := float32DiffStats(ta, tb)\r\n\u001b[?2004l\r"]
[3115.327393, "o", "\u001b[?2004h> "]
[3115.327569, "o", "                                if err != nil {\r\n\u001b[?2004l\r"]
[3115.327625, "o", "\u001b[?2004h> "]
[3115.328053, "o", "                                        return nil, fmt.Errorf(\"diff: tensor %s: %w\", name, err)\r\n\u001b[?2004l\r"]
[3115.32811, "o", "\u001b[?2004h> "]
[3115.328237, "o", "                                }\r\n\u001b[?2004l\r"]
[3115.328298, "o", "\u001b[?2004h> "]
[3115.328556, "o", "                                result.MaxAbsDiff = &maxDiff\r\n\u001b[?2004l\r"]
[3115.328604, "o", "\u001b[?2004h> "]
[3115.328889, "o", "                                result.MeanAbsDiff = &meanDiff\r\n\u001b[?2004l\r"]
[3115.32895, "o", "\u001b[?2004h> "]
[3115.329082, "o", "                        }\r\n\u001b[?2004l\r"]
[3115.329137, "o", "\u001b[?2004h> "]
[3115.329269, "o", "                } else if okA {\r\n\u001b[?2004l\r"]
[3115.329323, "o", "\u001b[?2004h> "]
[3115.329572, "o", "                        onlyInA = append(onlyInA, name)\r\n\u001b[?2004l\r"]
[3115.329628, "o", "\u001b[?2004h> "]
[3115.329732, "o", "                } else {\r\n\u001b[?2004l\r"]
[3115.329794, "o", "\u001b[?2004h> "]
[3115.330021, "o", "                        onlyInB = append(onlyInB, name)\r\n\u001b[?2004l\r"]
[3115.330078, "o", "\u001b[?2004h> "]
[3115.330138, "o", "                }\r\n\u001b[?2004l\r"]
[3115.330205, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rf\u001b[?2004h> "]
[3115.330466, "o", "                tensorDiffs = append(tensorDiffs, result)\r\n\u001b[?2004l\r"]
[3115.330523, "o", "\u001b[?2004h> "]
[3115.330587, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.330641, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.330763, "o", "        return diffOutput{\r\n\u001b[?2004l\r"]
[3115.330818, "o", "\u001b[?2004h> "]
[3115.330961, "o", "                Status: \"ok\",\r\n\u001b[?2004l\r"]
[3115.331016, "o", "\u001b[?2004h> "]
[3115.33121, "o", "                FileA:  filepath.Base(file1),\r\n\u001b[?2004l\r"]
[3115.331266, "o", "\u001b[?2004h> "]
[3115.331427, "o", "                FileB:  filepath.Base(file2),\r\n\u001b[?2004l\r"]
[3115.331522, "o", "\u001b[?2004h> "]
[3115.331621, "o", "                TensorDiffs: tensorDiffs,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.331766, "o", "                Summary: diffSummary{\r\n\u001b[?2004l\r#\u001b[?2004h"]
[3115.331823, "o", "> "]
[3115.331995, "o", "                        TotalTensorsA:  len(tensorsA),\r\n\u001b[?2004l\rport b\u001b[?2004h> "]
[3115.332231, "o", "                        TotalTensorsB:  len(tensorsB),\r\n\u001b[?2004l\r"]
[3115.332298, "o", "\u001b[?2004h> "]
[3115.332428, "o", "                        CommonTensors:  common,\r\n\u001b[?2004l\r"]
[3115.332515, "o", "\u001b[?2004h> "]
[3115.332635, "o", "                        ShapeMismatches: shapeMismatches,\r\n\u001b[?2004l\r"]
[3115.332706, "o", "\u001b[?2004h> "]
[3115.332828, "o", "                        OnlyInA:        onlyInA,\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.332906, "o", "> "]
[3115.333036, "o", "                        OnlyInB:        onlyInB,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.333128, "o", "                },\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[3115.33321, "o", "        }, nil\r\n\u001b[?2004l\r"]
[3115.333266, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.333322, "o", "u\u001b[?2004h> "]
[3115.333452, "o", "func shapesEqual(a, b []uint32) bool {\r\n\u001b[?2004l\r"]
[3115.33351, "o", "\u001b[?2004h> "]
[3115.333591, "o", "        if len(a) != len(b) {\r\n\u001b[?2004l\r"]
[3115.333646, "o", "\u001b[?2004h> "]
[3115.333714, "o", "                return false\r\n\u001b[?2004l\r"]
[3115.33377, "o", "\u001b[?2004h> "]
[3115.333826, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.333912, "o", "        for i := range a {\r\n\u001b[?2004l\r"]
[3115.333987, "o", "\u001b[?2004h> "]
[3115.334059, "o", "                if a[i] != b[i] {\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.334114, "o", "> "]
[3115.334212, "o", "                        return false\r\n\u001b[?2004l\r "]
[3115.334294, "o", "\u001b[?2004h>                 }\r\n\u001b[?2004l\r"]
[3115.334355, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[3115.33441, "o", "\u001b[?2004h> "]
[3115.334461, "o", "        return true\r\n\u001b[?2004l\r"]
[3115.334523, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ri"]
[3115.334579, "o", "\u001b[?2004h> "]
[3115.334819, "o", "func float32DiffStats(a, b types.TensorInfo) (float64, float64, error) {\r\n\u001b[?2004l\r"]
[3115.334874, "o", "\u001b[?2004h> "]
[3115.335064, "o", "        if a.Dtype != float32Dtype || b.Dtype != float32Dtype {\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.33512, "o", "> "]
[3115.335476, "o", "                return 0, 0, fmt.Errorf(\"unsupported dtype %d/%d; only float32 tensors are supported\", a.Dtype, b.Dtype)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.335541, "o", "        }\r\n\u001b[?2004l\r"]
[3115.335596, "o", "\u001b[?2004h> "]
[3115.335706, "o", "        if len(a.Data) != len(b.Data) {\r\n\u001b[?2004l\r"]
[3115.33576, "o", "\u001b[?2004h> "]
[3115.336073, "o", "                return 0, 0, fmt.Errorf(\"data length mismatch %d/%d\", len(a.Data), len(b.Data))\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.336131, "o", ">         }\r\n\u001b[?2004l\r"]
[3115.336186, "o", "\u001b[?2004h> "]
[3115.336276, "o", "        if len(a.Data)%4 != 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.336339, "o", "> "]
[3115.336582, "o", "                return 0, 0, fmt.Errorf(\"non-float32 data length %d\", len(a.Data))\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.336639, "o", ">         }\r\n\u001b[?2004l\r"]
[3115.336694, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.336799, "o", "        n := len(a.Data) / 4\r\n\u001b[?2004l\r"]
[3115.336855, "o", "\u001b[?2004h> "]
[3115.336911, "o", "        if n == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.337042, "o", "                return 0, 0, nil\r\n\u001b[?2004l\r"]
[3115.3371, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[3115.337155, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.33729, "o", "        var maxDiff, sumDiff float64\r\n\u001b[?2004l\r"]
[3115.337345, "o", "\u001b[?2004h> "]
[3115.337442, "o", "        for i := 0; i < n; i++ {\r\n\u001b[?2004l\r"]
[3115.337496, "o", "\u001b[?2004h> "]
[3115.33778, "o", "                fa := math.Float32frombits(binary.LittleEndian.Uint32(a.Data[i*4 : i*4+4]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.337836, "o", "> "]
[3115.338129, "o", "                fb := math.Float32frombits(binary.LittleEndian.Uint32(b.Data[i*4 : i*4+4]))\r\n\u001b[?2004l\r"]
[3115.338188, "o", "\u001b[?2004h> "]
[3115.33832, "o", "                d := math.Abs(float64(fa - fb))\r\n\u001b[?2004l\r"]
[3115.338375, "o", "\u001b[?2004h> "]
[3115.338453, "o", "                if d > maxDiff {\r\n\u001b[?2004l\r"]
[3115.338507, "o", "\u001b[?2004h> "]
[3115.338606, "o", "                        maxDiff = d\r\n\u001b[?2004l\r"]
[3115.33866, "o", "\u001b[?2004h> "]
[3115.338716, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.338812, "o", "                sumDiff += d\r\n\u001b[?2004l\r"]
[3115.338867, "o", "\u001b[?2004h>         }\r\n"]
[3115.338922, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3115.339086, "o", "        return maxDiff, sumDiff / float64(n), nil\r\n\u001b[?2004l\r"]
[3115.339142, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.339197, "o", "''')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rr"]
[3115.339253, "o", "\u001b[?2004h> "]
[3115.339309, "o", "# 3. Add diff CLI case.\r\n\u001b[?2004l\r"]
[3115.339364, "o", "\u001b[?2004h> "]
[3115.339462, "o", "p = Path('cmd/mlforge/main.go')\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.339516, "o", "> "]
[3115.339572, "o", "s = p.read_text()\r\n\u001b[?2004l\re\u001b[?2004h> "]
[3115.339625, "o", "s = s.replace(\r\n\u001b[?2004l\r"]
[3115.339683, "o", "\u001b[?2004h> "]
[3115.339743, "o", "'''        case \"query\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.339914, "o", "                if len(positional) < 3 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.33998, "o", "> "]
[3115.340247, "o", "                        fmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n\u001b[?2004l\r"]
[3115.340304, "o", "\u001b[?2004h> "]
[3115.340377, "o", "                        os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.340432, "o", ">                 }\r\n\u001b[?2004l\r"]
[3115.340487, "o", "\u001b[?2004h> "]
[3115.340642, "o", "                result, err = forensics.BuildQuery(dir, positional[2])\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.340698, "o", "> "]
[3115.340723, "o", "        case \"report\":''',\r\n\u001b[?2004l\r"]
[3115.340744, "o", "\u001b[?2004h> "]
[3115.340819, "o", "'''        case \"query\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.34084, "o", "> "]
[3115.34095, "o", "                if len(positional) < 3 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.34097, "o", "> "]
[3115.401366, "o", "                        fmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>                         os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h>                 result, err = forensics.BuildQuery(dir, positional[2])\r\n\u001b[?2004l\r\u001b[?2004h>         case \"diff\":\r\n\u001b[?2004l\r\u001b[?2004h>                 if len(positional) < 4 {\r\n\u001b[?2004l\r\u001b[?2004h>                         fmt.Fprintf(os.Stderr, \"Usage: mlforge diff <dir> <file1> <file2>\\n\")\r\n\u001b[?2004l\r"]
[3115.401492, "o", "\u001b[?2004h> "]
[3115.401621, "o", "                        os.Exit(1)\r\n\u001b[?2004l\r"]
[3115.401679, "o", "\u001b[?2004h> "]
[3115.40179, "o", "                }\r\n\u001b[?2004l\r"]
[3115.401849, "o", "\u001b[?2004h> "]
[3115.402365, "o", "                result, err = forensics.BuildDiff(dir, positional[2], positional[3])\r\n\u001b[?2004l\r"]
[3115.402427, "o", "\u001b[?2004h> "]
[3115.40257, "o", "        case \"report\":''')\r\n\u001b[?2004l\r"]
[3115.40262, "o", "\u001b[?2004h> "]
[3115.402725, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[3115.40278, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.402844, "o", "\u001b[?2004h> "]
[3115.402978, "o", "# 4. Update docs.\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.403034, "o", "> "]
[3115.403209, "o", "p = Path('docs/analysis_rules.md')\r\n\u001b[?2004l\r"]
[3115.403256, "o", "\u001b[?2004h> "]
[3115.403372, "o", "s = p.read_text()\r\n\u001b[?2004l\r"]
[3115.403417, "o", "\u001b[?2004h> "]
[3115.403518, "o", "s = s.replace(\r\n\u001b[?2004l\r"]
[3115.403565, "o", "\u001b[?2004h> "]
[3115.40433, "o", "   'If values differ, this is a **conflict**. Resolution: keep the entry with the **latest** `ts` timestamp. Record the conflict.',\r\n\u001b[?2004l\r"]
[3115.404393, "o", "\u001b[?2004h> "]
[3115.405151, "o", "   'If values differ, this is a **conflict**. Resolution: keep the entry with the **earliest** `ts` timestamp. Record the conflict.')\r\n\u001b[?2004l\r"]
[3115.405215, "o", "\u001b[?2004h> "]
[3115.405299, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[3115.40537, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.405426, "o", "\u001b[?2004h> "]
[3115.405561, "o", "p = Path('docs/spec.md')\r\n\u001b[?2004l\r"]
[3115.405617, "o", "\u001b[?2004h> "]
[3115.405722, "o", "s = p.read_text()\r\n\u001b[?2004l\r"]
[3115.405777, "o", "\u001b[?2004h"]
[3115.405832, "o", "> "]
[3115.405882, "o", "s = s.replace(\r\n\u001b[?2004l\r"]
[3115.405946, "o", "\u001b[?2004h> "]
[3115.40605, "o", "'''#### `report`\r\n\u001b[?2004l\r"]
[3115.406106, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.406172, "o", "\u001b[?2004h> "]
[3115.406906, "o", "Generate a comprehensive forensic report by running all analyses (ingest, timeline, verify, detect, lineage) and combining results.\r\n\u001b[?2004l\r"]
[3115.406977, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.407034, "o", "\u001b[?2004h> "]
[3115.407505, "o", "Output (JSON to stdout): see `/app/docs/output_schema.md` section \"Report Output\".\r\n\u001b[?2004l\r"]
[3115.407568, "o", "\u001b[?2004h> "]
[3115.407622, "o", "''',\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.407676, "o", "> "]
[3115.407737, "o", "'''#### `diff`\r\n\u001b[?2004l\r"]
[3115.407801, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.407856, "o", "\u001b[?2004h> "]
[3115.407911, "o", "```\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.407975, "o", "> "]
[3115.4082, "o", "mlforge diff <evidence-dir> <file1> <file2>\r\n\u001b[?2004l\r"]
[3115.408261, "o", "\u001b[?2004h> "]
[3115.408316, "o", "```\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.408371, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.408444, "o", "> "]
[3115.409376, "o", "Compare two checkpoint files inside `<evidence-dir>` tensor by tensor and write JSON to stdout. `file1` and `file2` are checkpoint filenames relative to `<evidence-dir>`.\r\n\u001b[?2004l\r"]
[3115.40944, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.409499, "o", "\u001b[?2004h> "]
[3115.411372, "o", "For every tensor name present in either file, include one entry in `tensor_diffs`, sorted by tensor name lexicographically. `max_abs_diff` and `mean_abs_diff` are included only when both files contain the tensor and their shapes match.\r\n\u001b[?2004l\r"]
[3115.411438, "o", "\u001b[?2004h"]
[3115.411494, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.41155, "o", "> "]
[3115.41216, "o", "If either checkpoint filename does not exist under `<evidence-dir>`, exit non-zero and print an error to stderr.\r\n\u001b[?2004l\r"]
[3115.412219, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.412285, "o", "\u001b[?2004h> "]
[3115.412734, "o", "Output (JSON to stdout): see `/app/docs/output_schema.md` section \"Diff Output\".\r\n\u001b[?2004l\r"]
[3115.412806, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.412874, "o", "\u001b[?2004h> "]
[3115.412943, "o", "#### `report`\r\n\u001b[?2004l\r"]
[3115.412998, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.413061, "o", "\u001b[?2004h> "]
[3115.413802, "o", "Generate a comprehensive forensic report by running all analyses (ingest, timeline, verify, detect, lineage) and combining results.\r\n\u001b[?2004l\r"]
[3115.413861, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.413919, "o", "\u001b[?2004h> "]
[3115.414393, "o", "Output (JSON to stdout): see `/app/docs/output_schema.md` section \"Report Output\".\r\n\u001b[?2004l\r"]
[3115.414444, "o", "\u001b[?2004h> "]
[3115.414491, "o", "''')\r\n\u001b[?2004l\r"]
[3115.414543, "o", "\u001b[?2004h> "]
[3115.414633, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[3115.414697, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.414752, "o", "\u001b[?2004h> "]
[3115.414957, "o", "p = Path('docs/output_schema.md')\r\n\u001b[?2004l\r"]
[3115.415013, "o", "\u001b[?2004h> "]
[3115.415115, "o", "s = p.read_text()\r\n\u001b[?2004l\r"]
[3115.415163, "o", "\u001b[?2004h> "]
[3115.415236, "o", "s += r'''\r\n\u001b[?2004l\r"]
[3115.415293, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.415349, "o", "\u001b[?2004h> "]
[3115.415459, "o", "## 8. Diff Output\r\n\u001b[?2004l\r"]
[3115.415514, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.41556, "o", "\u001b[?2004h> "]
[3115.415626, "o", "```json\r\n\u001b[?2004l\r"]
[3115.415684, "o", "\u001b[?2004h> {\r\n"]
[3115.415739, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3115.41586, "o", "  \"status\": \"ok\",\r\n\u001b[?2004l\r"]
[3115.415906, "o", "\u001b[?2004h> "]
[3115.416117, "o", "  \"file_a\": \"model_epoch1.mlck\",\r\n\u001b[?2004l\r"]
[3115.416182, "o", "\u001b[?2004h> "]
[3115.416365, "o", "  \"file_b\": \"model_epoch2.mlck\",\r\n\u001b[?2004l\r"]
[3115.416427, "o", "\u001b[?2004h> "]
[3115.416536, "o", "  \"tensor_diffs\": [\r\n\u001b[?2004l\r"]
[3115.416599, "o", "\u001b[?2004h> "]
[3115.416661, "o", "    {\r\n\u001b[?2004l\r"]
[3115.416716, "o", "\u001b[?2004h> "]
[3115.416824, "o", "      \"name\": \"layer1.weight\",\r\n\u001b[?2004l\r"]
[3115.416878, "o", "\u001b[?2004h> "]
[3115.416982, "o", "      \"shape_match\": true,\r\n\u001b[?2004l\r"]
[3115.417037, "o", "\u001b[?2004h> "]
[3115.417133, "o", "      \"shape_a\": [4, 3],\r\n\u001b[?2004l\r"]
[3115.417187, "o", "\u001b[?2004h> "]
[3115.417274, "o", "      \"shape_b\": [4, 3],\r\n\u001b[?2004l\r"]
[3115.417309, "o", "\u001b[?2004h> "]
[3115.417443, "o", "      \"max_abs_diff\": 1.234,\r\n\u001b[?2004l\r"]
[3115.417497, "o", "\u001b[?2004h> "]
[3115.417598, "o", "      \"mean_abs_diff\": 0.567\r\n\u001b[?2004l\r"]
[3115.417653, "o", "\u001b[?2004h> "]
[3115.41771, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.417766, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h"]
[3115.417821, "o", "> "]
[3115.417911, "o", "      \"name\": \"layer2.weight\",\r\n\u001b[?2004l\r"]
[3115.417974, "o", "\u001b[?2004h> "]
[3115.41808, "o", "      \"shape_match\": false,\r\n\u001b[?2004l\r"]
[3115.418135, "o", "\u001b[?2004h> "]
[3115.418225, "o", "      \"shape_a\": [4, 3],\r\n\u001b[?2004l\r"]
[3115.418298, "o", "\u001b[?2004h> "]
[3115.418369, "o", "      \"shape_b\": [8, 3]\r\n\u001b[?2004l\r"]
[3115.418424, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[3115.418486, "o", "\u001b[?2004h> "]
[3115.418542, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.418673, "o", "      \"name\": \"layer3.bias\",\r\n\u001b[?2004l\r"]
[3115.418746, "o", "\u001b[?2004h> "]
[3115.418826, "o", "      \"shape_match\": false,\r\n\u001b[?2004l\r"]
[3115.418909, "o", "\u001b[?2004h"]
[3115.418976, "o", ">       \"shape_a\": null,\r\n\u001b[?2004l\r"]
[3115.419032, "o", "\u001b[?2004h> "]
[3115.419109, "o", "      \"shape_b\": [3]\r\n\u001b[?2004l\r"]
[3115.419164, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[3115.419219, "o", "\u001b[?2004h> "]
[3115.419274, "o", "  ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3115.419347, "o", "  \"summary\": {\r\n\u001b[?2004l\r"]
[3115.419403, "o", "\u001b[?2004h> "]
[3115.419495, "o", "    \"total_tensors_a\": 2,\r\n\u001b[?2004l\r"]
[3115.419549, "o", "\u001b[?2004h> "]
[3115.419648, "o", "    \"total_tensors_b\": 2,\r\n\u001b[?2004l\r"]
[3115.419704, "o", "\u001b[?2004h> "]
[3115.419791, "o", "    \"common_tensors\": 2,\r\n\u001b[?2004l\r"]
[3115.419847, "o", "\u001b[?2004h> "]
[3115.419957, "o", "    \"shape_mismatches\": 0,\r\n\u001b[?2004l\r"]
[3115.420013, "o", "\u001b[?2004h> "]
[3115.420081, "o", "    \"only_in_a\": [],\r\n\u001b[?2004l\r"]
[3115.420136, "o", "\u001b[?2004h> "]
[3115.42021, "o", "    \"only_in_b\": []\r\n\u001b[?2004l\r"]
[3115.420264, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[3115.420319, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[3115.420373, "o", "\u001b[?2004h> ```\r\n\u001b[?2004l\r"]
[3115.420429, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3115.420484, "o", "\u001b[?2004h> "]
[3115.420541, "o", "**Field rules:**\r\n\u001b[?2004l\r"]
[3115.420597, "o", "\u001b[?2004h> "]
[3115.420854, "o", "- `file_a` and `file_b` are the basenames of `file1` and `file2`.\r\n\u001b[?2004l\r"]
[3115.420909, "o", "\u001b[?2004h> "]
[3115.421144, "o", "- `tensor_diffs`: sorted by tensor name lexicographically.\r\n\u001b[?2004l\r"]
[3115.421201, "o", "\u001b[?2004h> "]
[3115.421565, "o", "- `shape_a` and `shape_b`: tensor shapes from each file, or `null` if absent from that file.\r\n\u001b[?2004l\r"]
[3115.42162, "o", "\u001b[?2004h> "]
[3115.422005, "o", "- `shape_match`: `true` only when the tensor exists in both files and the shapes are identical.\r\n\u001b[?2004l\r"]
[3115.422064, "o", "\u001b[?2004h> "]
[3115.42264, "o", "- `max_abs_diff` and `mean_abs_diff`: present only for tensors with `shape_match: true`, computed over float32 element-wise absolute differences.\r\n\u001b[?2004l\r"]
[3115.422716, "o", "\u001b[?2004h> "]
[3115.423043, "o", "- `summary.total_tensors_a` and `summary.total_tensors_b`: tensor counts in each file.\r\n\u001b[?2004l\r"]
[3115.4231, "o", "\u001b[?2004h> "]
[3115.423388, "o", "- `summary.common_tensors`: number of tensor names present in both files.\r\n\u001b[?2004l\r"]
[3115.423444, "o", "\u001b[?2004h> "]
[3115.423748, "o", "- `summary.shape_mismatches`: number of common tensors with different shapes.\r\n\u001b[?2004l\r"]
[3115.423805, "o", "\u001b[?2004h> "]
[3115.424259, "o", "- `summary.only_in_a` and `summary.only_in_b`: tensor names present in only one file, sorted lexicographically.\r\n\u001b[?2004l\r"]
[3115.424316, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
