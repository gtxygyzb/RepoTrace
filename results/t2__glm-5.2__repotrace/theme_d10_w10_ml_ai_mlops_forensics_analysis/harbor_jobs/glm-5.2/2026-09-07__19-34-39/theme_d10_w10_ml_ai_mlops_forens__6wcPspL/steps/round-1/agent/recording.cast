[4449.500405, "o", "   517\t\t}\r\n   518\t\treturn s / float64(len(v))\r\n   519\t}\r\n   520\t\r\n   521\tfunc stddevFloats(v []float64, mean float64) float64 {\r\n   522\t\tif len(v) == 0 {\r\n   523\t\t\treturn 0\r\n   524\t\t}\r\n   525\t\ts := 0.0\r\n"]
