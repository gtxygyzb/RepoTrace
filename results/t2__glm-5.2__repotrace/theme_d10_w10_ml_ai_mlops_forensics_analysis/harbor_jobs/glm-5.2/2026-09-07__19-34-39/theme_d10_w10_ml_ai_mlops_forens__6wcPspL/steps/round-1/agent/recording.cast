[7265.176943, "o", "    12\ttype LineageNode struct {\r\n    13\t\tFile              string `json:\"file\"`\r\n    14\t\tFileHash          string `json:\"file_hash\"`\r\n    15\t\tEpoch             uint32 `json:\"epoch\"`\r\n    16\t\tGlobalStep        uint64 `json:\"global_step\"`\r\n    17\t\tCreationTimestamp string `json:\"creation_timestamp\"`\r\n    18\t\tParentHash        string `json:\"parent_hash\"`\r\n    19\t\tIsRoot            bool   `json:\"is_root\"`\r\n    20\t\tIsLeaf            bool   `json:\"is_leaf\"`\r\n    21\t\tIsOrphan          bool   `json:\"is_orphan\"`\r\n    22\t}\r\n    23\t\r\n    24\ttype LineageEdge struct {\r\n    25\t\tFrom     string `json:\"from\"`\r\n    26\t\tTo       string `json:\"to\"`\r\n    27\t\tFromFile string `json:\"from_file\"`\r\n    28\t\tToFile   string `json:\"to_file\"`\r\n    29\t}\r\n    30\t\r\n    31\ttype LineageOutput struct {\r\n    32\t\tStatus           string        `json:\"status\"`\r\n    33\t\tNodes            []LineageNode `json:\"nodes\"`\r\n    34\t\tEdges            []LineageEdge `json:\"edges\"`\r\n"]
[7265.177041, "o", "    35\t\tRoots            []string      `json:\"roots\"`\r\n    36\t\tLeaves           []string      `json:\"leaves\"`\r\n    37\t\tOrphans          []string      `json:\"orphans\"`\r\n    38\t\tTopologicalOrder []string      `json:\"topological_order\"`\r\n    39\t\tCycles           [][]string    `json:\"cycles\"`\r\n    40\t}\r\n    41\t\r\n    42\tfunc BuildLineage(dir string) (interface{}, error) {\r\n    43\t\tcps, err := loadCheckpoints(dir)\r\n    44\t\tif err != nil {\r\n    45\t\t\treturn nil, err\r\n    46\t\t}\r\n    47\t\tif len(cps) == 0 {\r\n    48\t\t\treturn nil, fmt.Errorf(\"no checkpoint files found\")\r\n    49\t\t}\r\n"]
[7265.177063, "o", "    50\t\treturn buildLineage(cps), nil\r\n    51\t}\r\n    52\t\r\n"]
[7265.177167, "o", "    53\tfunc buildLineage(cps []*types.CheckpointFile) LineageOutput {\r\n    54\t\tout := LineageOutput{Status: \"ok\"}\r\n    55\t\tnodeByHash := map[string]*LineageNode{}\r\n    56\t\tcfByHash := map[string]*types.CheckpointFile{}\r\n    57\t\r\n    58\t\tfor _, cf := range cps {\r\n    59\t\t\tcfByHash[cf.FileHash] = cf\r\n    60\t\t\tn := &LineageNode{\r\n    61\t\t\t\tFile:              cf.Filename,\r\n    62\t\t\t\tFileHash:          cf.FileHash,\r\n    63\t\t\t\tCreationTimestamp: unixToISO(cf.CreationTimestamp),\r\n    64\t\t\t\tParentHash:        \"\",\r\n    65\t\t\t}\r\n    66\t\t\tif cf.Provenance != nil {\r\n"]
[7265.177244, "o", "    67\t\t\t\tn.Epoch = cf.Provenance.Epoch\r\n    68\t\t\t\tn.GlobalStep = cf.Provenance.GlobalStep\r\n    69\t\t\t\tn.ParentHash = cf.Provenance.ParentHash\r\n    70\t\t"]
[7265.177264, "o", "\t}\r\n    71\t\t\tnodeByHash[cf.FileHash] = n\r\n    72\t\t\tout.Nodes = append(out.Nodes, *n)\r\n    73\t\t}\r\n    74\t\r\n    75\t\tchildren := map[string][]string{}\r\n    76\t\tincoming := map[string]int{}\r\n    77\t\tfor _, cf := range cps {\r\n    78\t\t\tif cf.Provenance == nil || cf.Provenance.ParentHash == \"\" {\r\n    79\t\t\t\tcontinue\r\n"]
[7265.177281, "o", "    80\t\t\t}\r\n"]
