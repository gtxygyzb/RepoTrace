[7870.352371, "o", "n  \"file_a\":', '\"metadata\": {\\n    \"tool\": \"mlforge\",\\n    \"version\": \"1.0\",\\n    \"command\": \"diff\",\\n    \"evi"]
[7870.352426, "o", "dence_dir\": \"/path/to/evidence\",\\n    \"timestamp\": \"2024-01-15T10:30:00Z\""]
