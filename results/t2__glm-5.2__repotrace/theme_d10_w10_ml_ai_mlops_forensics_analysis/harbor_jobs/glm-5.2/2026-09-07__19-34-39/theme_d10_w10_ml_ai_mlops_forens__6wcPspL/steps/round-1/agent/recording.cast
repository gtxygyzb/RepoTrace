[3977.652212, "i", "sed -n '1,130p' cmd/mlforge/main.go\n"]
[3977.652527, "o", "sed -n '1,130p' cmd/mlforge/main.go\r\n"]
[3977.65274, "o", "\u001b[?2004l\r"]
[3977.65551, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[3977.655636, "o", "\t\"os\"\r\n\t\"strings\"\r\n\r\n\t\"mlforge/internal/forensics\"\r\n)\r\n\r\nfunc main() {\r\n"]
[3977.655706, "o", "\t// --- Parse flags ---------------------------------------------------\r\n\tformat := \"json\"\r\n\tverbose := false\r\n\tvar positional []string\r\n\r\n\tfor _, arg := range os.Args[1:] {\r\n\t\tswitch {\r\n\t\tcase arg == \"--verbose\":\r\n\t\t\tverbose = true\r\n\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n\t\tcase arg == \"--format\":\r\n\t\t// handled below as two-token flag\r\n\t\tdefault:\r\n\t\t\tpositional = append(positional, arg)\r\n\t\t}\r\n\t}\r\n\r\n\t// Handle \"--format json\" (two separate tokens)\r\n\tfor i := 1; i < len(os.Args)-1; i++ {\r\n\t\tif os.Args[i] == \"--format\" {\r\n\t\t\tformat = os.Args[i+1]\r\n\t\t\t// Remove the value from positional args\r\n\t\t\tfiltered := positional[:0]\r\n\t\t\tfor _, p := range positional {\r\n"]
[3977.655805, "o", "\t\t\t\tif p != os.Args[i+1] {\r\n\t\t\t\t\tfiltered = append(filtered, p)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tpositional = filtered\r\n"]
[3977.655873, "o", "\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n\tif format != \"json\" && format != \"text\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json or text\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t_ = verbose // reserved for diagnostic output\r\n\r\n\t// --- Validate positional args --------------------------------------\r\n\tif len(positional) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := positional[0]\r\n\tdir := positional[1]\r\n\r\n\t// --- Route to command handler --------------------------------------\r\n\tvar result interface{}\r\n\tvar err error\r\n\r\n"]
[3977.655971, "o", "\tswitch cmd {\r\n\tcase \"ingest\":\r\n\t\tresult, err = forensics.BuildIngest(dir)\r\n\tcase \"timeline\":\r\n\t\tresult, err = forensics.BuildTimeline(dir)\r\n\tcase \"verify\":\r\n\t\tresult, err = forensics.BuildVerify(dir)\r\n\tcase \"detect\":\r\n\t\tresult, err = forensics.BuildDetect(dir)\r\n\tcase \"lineage\":\r\n\t\tresult, err = forensics.BuildLineage(dir)\r\n"]
[3977.65604, "o", "\tcase \"query\":\r\n\t\tif len(positional) < 3 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tresult, err = forensics.BuildQuery(dir, positional[2])\r\n\tcase \"diff\":\r\n\t\tif len(positional) < 4 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge diff <dir> <file1> <file2>\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\t"]
[3977.656105, "o", "result, err = forensics.BuildDiff(dir, positional[2], positional[3])\r\n\tcase \"report\":\r\n\t\tresult, err = forensics.BuildReport(dir)\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t// --- Output --------------------------------------------------------\r\n\tif err != nil {\r\n\t\t"]
[3977.656185, "o", "fmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif format == \"text\" {\r\n\t\tprintText(result)\r\n\t\treturn\r\n\t}\r\n\r\n\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n\tif marshalErr != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error marshalling result: %v\\n\", marshalErr)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[3977.656246, "o", "\tfmt.Println(string(out))\r\n}\r\n\r\nfunc printText(v interface{}) {\r\n\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error rendering text output\")\r\n\t\treturn\r\n\t}\r\n\tfmt.Println(string(b))\r\n}\r\n"]
[3977.656755, "o", "\u001b[?2004h"]
[3977.656815, "o", "root@n30009:/app# "]
[3977.910613, "i", "sed -n '92,135p' docs/analysis_rules.md\n"]
[3977.910986, "o", "sed -n '92,135p' docs/analysis_rules.md"]
[3977.911078, "o", "\r\n\u001b[?2004l\r"]
[3977.91439, "o", "\r\n### 2.9 Training Gap\r\n\r\n- **Method**: Consecutive timeline entries (after merge sort) have timestamps more than 2 hours apart\r\n- **Trigger**: `time_diff > 7200 seconds` between consecutive entries within the same epoch\r\n"]
[3977.914524, "o", "- **Severity**: `low`\r\n- **Output fields**: `after_step`, `before_step`, `after_ts`, `before_ts`, `gap_seconds`\r\n\r\n### 2.10 Dataset Hash Inconsistency\r\n\r\n- **Method**: Compare `DatasetHash` across all checkpoints in the same lineage chain\r\n- **Trigger**: Different `DatasetHash` values within the same chain\r\n- **Severity**: `high`\r\n- **Output fields**: `files`, `hashes` (list of unique hex hashes)\r\n\r\n---\r\n\r\n## 3. Query Language\r\n\r\n### 3.1 Grammar\r\n\r\n```\r\nquery      := or_expr\r\nor_expr    := and_expr (\"OR\" and_expr)*\r\nand_expr   := not_expr (\"AND\" not_expr)*\r\nnot_expr   := \"NOT\" not_expr | atom\r\natom       := \"(\" or_expr \")\" | condition\r\ncondition  := field COMP_OP value\r\nCOMP_OP    := \">\" | \"<\" | \">=\" | \"<=\" | \"==\" | \"!=\"\r\nfield      := \"step\" | \"epoch\" | \"loss\" | \"lr\" | \"grad_norm\" | \"acc\" | \"event\" | \"ts\"\r\nvalue      := NUMBER | QUOTED_STRING | TIMESTAMP\r\nNUMBER     := integer or float literal\r\nQUOTED_STRING := '\"' ... '\"' (double-quoted string)\r\n"]
[3977.914604, "o", "TIMESTAMP  := ISO 8601 format (e.g., 2024-01-15T10:30:00Z)\r\n```\r\n\r\n### 3.2 Operator Precedence\r\n\r\n- `NOT` is a prefix operator with the highest precedence.\r\n- `AND` binds tighter than `OR`.\r\n- Parentheses `(` `)` override the default precedence.\r\n- Malformed parenthesized queries, such as `(step < 5` or `step < 5)`, are invalid query syntax.\r\n\r\nExamples:\r\n"]
[3977.915109, "o", "\u001b[?2004h"]
[3977.915174, "o", "root@n30009:/app# "]
