[4479.559783, "o", "\t\t\th.Write(raw[:48])\r\n\t\t\tcomputed := h.Sum64()\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"header_checksum_mismatch\",\r\n\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"file\":              cf.Filename,\r\n\t\t\t\t\t\"expected_checksum\": fmt.Sprintf(\"%016x\", stored),\r\n\t\t\t\t\t\"actual_checksum\":   fmt.Sprintf(\"%016x\", computed),\r\n\t\t\t\t},\r\n\t\t\t\tSource:     cf.Filename,\r\n\t\t\t\tCheckpoint: cf.Filename,\r\n"]
[4479.559836, "o", "\t\t\t})\r\n\t\t}\r\n\r\n\t\tfor _, t := range cf.Tensors {\r\n\t\t\tif !t.Valid {\r\n\t\t\t\tcomputed := sha256.Sum256(t.Data)\r\n\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t"]
[4479.559888, "o", "\t\tType:     \"tensor_checksum_mismatch\",\r\n\t\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":              cf.Filename,\r\n\t\t\t\t\t\t\"tensor_name\":       t.Name,\r\n\t\t\t\t"]
