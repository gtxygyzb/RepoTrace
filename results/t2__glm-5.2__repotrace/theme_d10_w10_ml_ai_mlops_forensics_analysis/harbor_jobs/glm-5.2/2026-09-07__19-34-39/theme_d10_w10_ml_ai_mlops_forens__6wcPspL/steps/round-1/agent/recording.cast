[325.073438, "o", "    32\t\r\n    33\t\t// --- magic (offset 0, 4 bytes) ---\r\n    34\t\tif string(raw[0:4]) != magicMLCK {\r\n    35\t\t\treturn nil, fmt.Errorf(\"checkpoint: bad magic %q\", raw[0:4])\r\n    36\t\t}\r\n    37\t\r\n    38\t\t// --- header fields ---\r\n    39\t\tversion := binary.LittleEndian.Uint16(raw[4:6])\r\n    40\t\tflags := binary.LittleEndian.Uint16(raw[6:8])\r\n    41\t\tnumTensors := binary.LittleEndian.Uint32(raw[8:12])\r\n    42\t\tnumMetadata := binary.LittleEndian.Uint32(raw[12:16])\r\n    43\t\tmetadataOffset := binary.LittleEndian.Uint64(raw[16:24])\r\n    44\t\tprovenanceOffset := binary.LittleEndian.Uint64(raw[24:32])\r\n    45\t\t_ = binary.LittleEndian.Uint64(raw[32:40]) // signatureOffset (unused for now)\r\n    46\t\tcreationTimestamp := int64(binary.LittleEndian.Uint64(raw[40:48]))\r\n    47\t\tstoredChecksum := binary.LittleEndian.Uint64(raw[48:56])\r\n    48"]
[325.073505, "o", "\t\r\n    49\t\t// --- verify header checksum: FNV-1a of bytes [0..48) ---\r\n    50\t\th := fnv.New64a()\r\n    51\t\th.Write(raw[:48])\r\n    52\t\tcomputedChecksum := h.Sum64()\r\n    53\t\theaderValid := computedChecksum == storedChecksum\r\n    54\t\r\n    55\t\t// --- SHA-256 file hash ---\r\n"]
[325.073563, "o", "    56\t\tfileHashBytes := sha256.Sum256(raw)\r\n    57\t\tfileHash := hex.EncodeToString(fileHashBytes[:])\r\n    58\t\r\n    59\t\tsigned := flags&1 != 0\r\n    60\t\r\n    61\t\tcf := &types.CheckpointFile{\r\n    62\t\t\tPath:              path,\r\n    63\t\t\tFilename:          filepath.Base(path),\r\n"]
[325.073621, "o", "    64\t\t\tVersion:           uint32(version),\r\n    65\t\t\tFlags:             flags,\r\n    66\t\t\tNumTensors:        numTensors,\r\n    67\t\t\tNumMetadataKeys:   numMetadata,\r\n    68\t\t\tCreationTimestamp:  creationTimestamp,\r\n    69\t\t\tHeaderValid:       headerValid,\r\n    70\t\t\tFileHash:          fileHash,\r\n"]
[325.073678, "o", "    71\t\t\tSigned:            signed,\r\n    72\t\t}\r\n    73\t\r\n    74\t\t// --- parse tensor blocks (start at offset 56) ---\r\n    75\t\toff := headerSize\r\n    76\t\ttensors := make([]types.TensorInfo, 0, numTensors)\r\n    77\t\tfor i := uint32(0); i < numTensors; i++ {\r\n    78\t\t\tti, newOff, err := parseTensor(raw, off, i)\r\n"]
