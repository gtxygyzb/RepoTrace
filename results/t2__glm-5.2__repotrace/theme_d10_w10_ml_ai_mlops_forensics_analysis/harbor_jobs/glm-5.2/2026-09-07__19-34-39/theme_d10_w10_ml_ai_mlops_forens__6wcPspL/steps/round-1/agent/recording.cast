[5093.52573, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/forensics/detect.go')\nlines = p.read_text().split('\\n')\nout = []\nfor line in lines:\n    if 'Source: firstSource(entries[idx[i]]),' in line:\n        indent = line[:len(line)-len(line.lstrip())]\n        out.append(indent + 'Evidence: map[string]interface{}{\"window_values\": lastValues(window, 5)},')\n        out.append(line)\n    elif 'Source: firstSource(entries[endIdx]),' in line:\n        indent = line[:len(line)-len(line.lstrip())]\n        out.append(indent + 'Evidence: map[string]interface{}{\"window_values\": precedingLossValues(entries, lossEntries, i, 5)},')\n        out.append(line)\n    elif 'Source: firstSource(cur),' in line:\n        indent = line[:len(line)-len(line.lstrip())]\n        out.append(indent + 'Evidence: map[string]interface{}{\"window_values\": []float64{}},')\n        out.append(line)\n    else:\n        out.append(line)\np.write_text('\\n'.join(out))\nPY\n"]
