[3396.15834, "o", "\u001b[?2004h> "]
[3396.15844, "o", "s = p.read_text()\r\n\u001b[?2004l\r"]
[3396.158498, "o", "\u001b[?2004h> "]
[3396.159487, "o", "s = s.replace('\"total_tensors_b\": 2,\\n    \"common_tensors\": 2,\\n    \"shape_mismatches\": 1,', '\"total_tensors_b\": 3,\\n    \"common_tensors\": 2,\\n    \"shape_mismatches\": 1,')\r\n\u001b[?2004l\r"]
[3396.159518, "o", "\u001b[?2004h"]
