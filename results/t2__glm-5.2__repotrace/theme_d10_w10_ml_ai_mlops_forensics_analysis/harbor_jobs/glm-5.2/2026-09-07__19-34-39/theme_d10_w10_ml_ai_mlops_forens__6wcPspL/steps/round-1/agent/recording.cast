[5433.237775, "o", "severity := \"medium\"\r\ninternal/forensics/detect.go:165:\t\t\t\tseverity = \"high\"\r\ninternal/forensics/detect.go:171:\t\t\t\tSeverity: severity,\r\ninternal/forensics/detect.go:209:\t\t\tseverity := \"high\"\r\ninternal/forensics/detect.go:211:\t\t\t\tseverity = \"critical\"\r\ninternal/forensics/detect.go:217:\t\t\t\tSeverity: severity,\r\ninternal/forensics/detect.go:250:\t\t\t\tType:     \"lr_anomaly\",\r\ninternal/forensics/detect.go:251:\t\t\t\tSeverity: \"medium\",\r\ninternal/forensics/detect.go:285:\t\t\t\tType:     \"training_gap\",\r\ninternal/forensics/detect.go:286:\t\t\t\tSeverity: \"low\",\r\ninternal/forensics/detect.go:325:\t\t\t\tSeverity: \"high\",\r\ninternal/forensics/detect.go:365:\t\t\t\tSeverity: \"critical\",\r\ninternal/forensics/detect.go:382:\t\t\t\t\tSeverity: \"critical\",\r\ninternal/forensics/detect.go:401:\t\t\t\t\tSeverity: \"critical\",\r\ninternal/forensics/detect.go:418:\t\t\t\t\tType:     \"provenance_chain_break\",\r\ninternal/forensics/detect.go:419:\t\t\t\t\tSeverity: \"high\",\r\ninternal/forensics/detect.go:503:\t\t\t\tSeverity: \"high\",\r\ninternal/forensics/detect.go:612:\t\tri := rank[a[i"]
[5433.237875, "o", "].Severity]\r\ninternal/forensics/detect.go:613:\t\trj := rank[a[j].Severity]\r\ncmd/mlforge/main.go:17:\tfilterSeverity := \"\"\r\ncmd/mlforge/main.go:35:\t\tcase strings.HasPrefix(arg, \"--filter-severity=\"):\r\ncmd/mlforge/main.go:36:\t\t\tfilterSeverity = strings.TrimPrefix(arg, \"--filter-severity=\")\r\ncmd/mlforge/main.go:37:\t\tcase arg == \"--filter-severity\":\r\ncmd/mlforge/main.go:39:\t\t\t\tfmt.Fprintf(os.Stderr, \"flag --filter-severity requires a value\\n\")\r\ncmd/mlforge/main.go:43:\t\t\tfilterSeverity = args[i]\r\ncmd/mlforge/main.go:71:\tif filterSeverity != \"\" && cmd != \"detect\" {\r\ncmd/mlforge/main.go:72:\t\tfmt.Fprintf(os.Stderr, \"--filter-severity is only supported for detect\\n\")\r\ncmd/mlforge/main.go:88:\t\tdetectResult, detectErr := forensics.BuildDetectFiltered(dir, filterSeverity)\r\ncmd/mlforge/main.go:139:\tfmt.Println(\"id,type,severity,epoch,step,source,checkpoint\")\r\ncmd/mlforge/main.go:149:\t\tfmt.Printf(\"%s,%s,%s,%s,%s,%s,%s\\n\", a.ID, a.Type, a.Severity, epoch, step, a.Source, a.Checkpoint)\r\n"]
