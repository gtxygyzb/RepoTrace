[5471.81614, "o", "\t\treturn nil\r\n\t}\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 30; i < len(vals); i++ {\r\n"]
[5471.816238, "o", "\t\twindow := vals[i-30 : i]\r\n\t\tmean := meanFloats(window)\r\n\t\tstd := stddevFloats(window, mean)\r\n\t\tobserved := vals[i]\r\n\t\tz := 0.0\r\n\t\tif std > 0 {\r\n\t\t\tz = (observed - mean) / std\r\n\t\t}\r\n\t\tif observed > mean+2.5*std && z > 2.5 {\r\n\t\t\tseverity := \"medium\"\r\n\t\t\tif z > 4.0 {\r\n\t\t\t\tseverity = \"high\"\r\n\t\t\t}\r\n\t"]
[5471.816305, "o", "\t\tep := entries[idx[i]].Epoch\r\n\t\t\tst := entries[idx[i]].Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"gradient_spike\",\r\n\t\t\t\tSeverity: severity,\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"observed\":      observed,\r\n"]
[5471.816362, "o", "\t\t\t\t\t\"window_mean\":   mean,\r\n\t\t\t\t\t\"window_stddev\": std,\r\n\t\t\t\t\t\"z_score\":       z,\r\n\t\t\t\t},\r\n\t\t\t\tEvidence: map[string]interface{}{\"window_values\": lastValues(window, 5)},\r\n"]
[5471.816419, "o", "\t\t\t\tSource:   firstSource(entries[idx[i]]),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar lossEntries []int\r\n\tfor i, e := range entries {\r\n\t\tif e.Loss != nil {\r\n\t\t\t"]
[5471.816473, "o", "lossEntries = append(lossEntries, i)\r\n\t\t}\r\n\t}\r\n\tif len(lossEntries) < 51 {\r\n\t\treturn nil\r\n\t}\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 50; i < len(lossEntries); i++ {\r\n\t\tstartIdx := lossEntries[i-50]\r\n"]
[5471.816524, "o", "\t\tendIdx := lossEntries[i]\r\n\t\tstart := *entries[startIdx].Loss\r\n\t\tend := *entries[endIdx].Loss\r\n\t\tif math.Abs(start) <= 1e-6 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tratio := (end - start) / math.Abs(start)\r\n"]
[5471.816575, "o", "\t\tif ratio > 1.0 {\r\n\t\t\tseverity := \"high\"\r\n\t\t\tif ratio > 5.0 {\r\n\t\t\t\tseverity = \"critical\"\r\n\t\t\t}\r\n"]
[5471.816625, "o", "\t\t\tep := entries[endIdx].Epoch\r\n\t\t\tst := entries[endIdx].Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"loss_divergence\",\r\n\t\t\t\tSeverity: severity,\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n"]
[5471.81668, "o", "\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"loss_start\":        start,\r\n\t\t\t\t\t\"loss_end\":          end,\r\n\t\t\t\t\t\"increase_ratio\":    ratio,\r\n\t\t\t\t\t\"window_start_step\": entries[startIdx].Step,\r\n\t\t\t\t\t\"window_end_step\":   entries[endIdx].Step,\r\n\t\t\t\t},\r\n\t\t\t"]
[5471.816734, "o", "\tEvidence: map[string]interface{}{\"window_values\": precedingLossValues(entries, lossEntries, i, 5)},\r\n\t\t\t\tSource:   firstSource(entries[endIdx]),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n"]
[5471.816784, "o", "\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]\r\n\t\tif prev.Lr == nil || cur.Lr == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif *cur.Lr > *prev.Lr {\r\n\t"]
[5471.816835, "o", "\t\tif cur.Event == \"epoch_end\" {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"lr_anomaly\",\r\n\t\t\t\tSeverity: \"medium\",\r\n"]
[5471.816887, "o", "\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"prev_lr\": *prev.Lr,\r\n\t\t\t\t\t\"curr_lr\": *cur.Lr,\r\n\t\t\t\t\t\"step\":    cur.Step,\r\n\t\t\t\t},\r\n"]
[5471.816969, "o", "\t\t\t\tEvidence: map[string]interface{}{\"window_values\": []float64{}},\r\n\t\t\t\tSource:   firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]\r\n"]
[5471.817027, "o", "\t\tif prev.Epoch != cur.Epoch {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tprevT, err1 := time.Parse(time.RFC3339, prev.Ts)\r\n\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\r\n\t\tif err1 != nil || err2 != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[5471.817079, "o", "\t\tdiff := curT.Sub(prevT).Seconds()\r\n\t\tif diff > 3600 {\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"training_gap\",\r\n\t\t\t\tSeverity: \"low\",\r\n"]
[5471.817133, "o", "\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"after_step\":  prev.Step,\r\n\t\t\t\t\t\"before_step\": cur.Step,\r\n\t\t\t\t\t\"after_ts\":    prev.Ts,\r\n\t\t\t\t\t\"before_ts\":   cur.Ts,\r\n"]
[5471.817183, "o", "\t\t\t\t\t\"gap_seconds\": diff,\r\n\t\t\t\t},\r\n\t\t\t\tEvidence: map[string]interface{}{\"window_values\": []float64{}},\r\n\t\t\t\tSource:   firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n"]
