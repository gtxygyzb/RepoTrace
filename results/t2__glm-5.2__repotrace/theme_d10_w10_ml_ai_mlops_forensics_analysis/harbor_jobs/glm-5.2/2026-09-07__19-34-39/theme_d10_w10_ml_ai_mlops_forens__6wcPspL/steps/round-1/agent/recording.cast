[5441.454374, "o", "return cf, true\r\n   520\t\t\t}\r\n   521\t\t}\r\n   522\t\treturn nil, false\r\n   523\t}\r\n   524\t\r\n   525\tfunc signatureDetails(path string) (bool, string) {\r\n   526\t\traw, err := os.ReadFile(path)\r\n   527\t\tif err != nil || len(raw) < 56 {\r\n   528\t\t\treturn false, \"\"\r\n   529\t\t}\r\n"]
[5441.454464, "o", "   530\t\tsigOff := binary.LittleEndian.Uint64(raw[32:40])\r\n   531\t\tif sigOff == 0 || int(sigOff) >= len(raw) || int(sigOff)+5 > len(raw) {\r\n   532\t\t\treturn false, \"\"\r\n   533\t\t}\r\n   534\t\toff := int(sigOff)\r\n   535\t\toff++ // algorithm\r\n   536\t\tsignerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   537\t\toff += 2\r\n   538\t\tif off+signerLen+2 > len(raw) {\r\n   539\t\t\treturn false, \"\"\r\n   540\t\t}\r\n   541\t\tsignerID := string(raw[off : off+signerLen])\r\n   542\t\toff += signerLen\r\n"]
[5441.454551, "o", "   543\t\tsigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   544\t\toff += 2\r\n   545\t\tif off+sigLen > len(raw) {\r\n   546\t\t\treturn false, signerID\r\n   547\t\t}\r\n   548\t\tstored := raw[off : off+sigLen]\r\n   549\t\tmac := hmac.New(sha256.New, []byte(signerID))\r\n   550\t\tmac.Write(raw[:sigOff])\r\n   551\t\texpected := mac.Sum(nil)\r\n   552\t\treturn hmac.Equal(expected, stored), signerID\r\n   553\t}\r\n   554\t\r\n   555\tfunc lastValues(v []float64, n int) []float64 {\r\n   556\t\t"]
[5441.454641, "o", "if len(v) > n {\r\n   557\t\t\tv = v[len(v)-n:]\r\n   558\t\t}\r\n   559\t\tif v == nil {\r\n   560\t\t\tv = []float64{}\r\n   561\t\t}\r\n   562\t\treturn v\r\n   563\t}\r\n   564\t\r\n   565\tfunc precedingLossValues(entries []types.TimelineEntry, indices []int, pos, n int) []float64 {\r\n   566\t\tvals := []float64{}\r\n   567\t\tstart := pos - n\r\n   568\t\tif start < 0 {\r\n   569\t\t\tstart = 0\r\n   570\t"]
[5441.454726, "o", "\t}\r\n   571\t\tfor j := start; j < pos; j++ {\r\n   572\t\t\tif j >= 0 && j < len(indices) && entries[indices[j]].Loss != nil {\r\n   573\t\t\t\tvals = append(vals, *entries[indices[j]].Loss)\r\n   574\t\t\t}\r\n   575\t\t}\r\n   576\t\treturn vals\r\n   577\t}\r\n   578\t\r\n   579\tfunc firstSource(e types.TimelineEntry) string {\r\n   580\t\tif len(e.Sources) > 0 {\r\n"]
[5441.45481, "o", "   581\t\t\treturn e.Sources[0]\r\n   582\t\t}\r\n   583\t\treturn \"\"\r\n   584\t}\r\n   585\t\r\n   586\tfunc meanFloats(v []float64) float64 {\r\n   587\t\tif len(v) == 0 {\r\n   588\t\t\treturn 0\r\n   589\t\t}\r\n   590\t\ts := 0.0\r\n   591\t\tfor _, x := range v {\r\n   592\t\t\ts += x\r\n   593\t\t}\r\n   594\t"]
[5441.454905, "o", "\treturn s / float64(len(v))\r\n   595\t}\r\n   596\t\r\n   597\tfunc stddevFloats(v []float64, mean float64) float64 {\r\n   598\t\tif len(v) == 0 {\r\n   599\t\t\treturn 0\r\n"]
[5441.455013, "o", "   600\t\t}\r\n   601\t\ts := 0.0\r\n   602\t\tfor _, x := range v {\r\n   603\t\t\td := x - mean\r\n   604\t\t\ts += d * d\r\n   605\t\t}\r\n   606\t\treturn math.Sqrt(s / float64(len(v)))\r\n   607\t}\r\n   608\t\r\n   609\tfunc sortAnomalies(a []types.Anomaly) {\r\n   610\t\trank := map[string]int{\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3}\r\n   611\t\tsort.Slice(a, func(i, j int) bool {\r\n"]
[5441.455098, "o", "   612\t\t\tri := rank[a[i].Severity]\r\n   613\t\t\trj := rank[a[j].Severity]\r\n   614\t\t\tif ri != rj {\r\n   615\t\t\t\treturn ri < rj\r\n   616\t\t\t}\r\n   617\t\t\tei := -1\r\n   618\t\t\tej := -1\r\n   619\t\t\tif a[i].Epoch != nil {\r\n   620\t\t\t\tei = *a[i].Epoch\r\n   621\t\t\t}\r\n   622\t\t\tej = -1\r\n   623\t\t\tif a[j].Epoch != nil {\r\n"]
[5441.455188, "o", "   624\t\t\t\tej = *a[j].Epoch\r\n   625\t\t\t}\r\n   626\t\t\tif ei != ej {\r\n   627\t\t\t\treturn ei < ej\r\n   628\t\t\t}\r\n   629\t\t\tsi := -1\r\n   630\t\t\tif a[i].Step != nil {\r\n   631\t\t\t\tsi = *a[i].Step\r\n   632\t\t\t}\r\n   633\t\t\tsj := -1\r\n   634\t\t\tif a[j].Step != nil {\r\n   635\t\t\t\tsj = *a[j].Step\r\n   636\t\t"]
[5441.455276, "o", "\t}\r\n   637\t\t\treturn si < sj\r\n   638\t\t})\r\n   639\t}\r\n"]
