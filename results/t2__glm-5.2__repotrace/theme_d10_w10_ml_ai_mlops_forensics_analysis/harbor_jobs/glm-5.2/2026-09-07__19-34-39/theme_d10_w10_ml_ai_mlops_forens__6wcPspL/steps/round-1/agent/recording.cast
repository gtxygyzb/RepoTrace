[4413.395376, "i", "sed -n '1,240p' internal/types/types.go\n"]
[4413.395728, "o", "sed -n '1,240p' internal/types/types.go\r\n\u001b[?2004l\r"]
[4413.398921, "o", "package types\r\n\r\n// TimelineEntry represents one log entry from a JSONL shard.\r\ntype TimelineEntry struct {\r\n\tTs       string   `json:\"ts\"`\r\n\tEpoch    int      `json:\"epoch\"`\r\n\tStep     int      `json:\"step\"`\r\n\tLoss     *float64 `json:\"loss,omitempty\"`\r\n\tLr       *float64 `json:\"lr,omitempty\"`\r\n"]
[4413.3991, "o", "\tGradNorm *float64 `json:\"grad_norm,omitempty\"`\r\n\tAcc      *float64 `json:\"acc,omitempty\"`\r\n\tEvent    string   `json:\"event,omitempty\"`\r\n\tSources  []string `json:\"sources,omitempty\"`\r\n\tConflict bool     `json:\"conflict\"`\r\n}\r\n\r\n// Anomaly represents one detected anomaly in the detect command.\r\ntype Anomaly struct {\r\n\tID         string                 `json:\"id\"`\r\n\tType       string                 `json:\"type\"`\r\n\tSeverity   string                 `json:\"severity\"`\r\n\tEpoch      *int                   `json:\"epoch,omitempty\"`\r\n\tStep       *int                   `json:\"step,omitempty\"`\r\n\tDetails    map[string]interface{} `json:\"details,omitempty\"`\r\n\tSource     string                 `json:\"source,omitempty\"`\r\n\tCheckpoint string                 `json:\"checkpoint,omitempty\"`\r\n}\r\n\r\n// TensorInfo holds metadata for one tensor in a checkpoint.\r\ntype TensorInfo struct {\r\n\tName  string   `json:\"name\"`\r\n\tDtype byte     `json:\"dtype\"`\r\n\tShape []uint32 `json:\"shape\"`\r\n\tData  []byte   `json:\"-\"`\r\n\tHash  [32]byte `json:\"-\"` "]
[4413.399186, "o", "// Stored SHA-256\r\n\tValid bool     `json:\"valid\"`\r\n}\r\n\r\n// Provenance holds the provenance section data from an MLCK checkpoint.\r\ntype Provenance struct {\r\n\tGitCommit         string  `json:\"git_commit\"`\r\n\tDatasetHash       string  `json:\"dataset_hash\"` // hex-encoded raw bytes\r\n\tConfigHash        string  `json:\"config_hash\"`  // hex-encoded raw bytes\r\n\tTrainingTimestamp int64   `json:\"training_timestamp\"`\r\n\tTrainingDuration  float64 `json:\"training_duration\"`\r\n\tFramework         string  `json:\"framework\"`\r\n\tFrameworkVersion  string  `json:\"framework_version\"`\r\n\tEpoch             uint32  `json:\"epoch\"`\r\n\tGlobalStep        uint64  `json:\"global_step\"`\r\n\tLearningRate      float64 `json:\"learning_rate\"`\r\n\tParentHash        string  `json:\"parent_hash\"` // hex SHA-256 of parent file, empty if root\r\n}\r\n\r\n"]
[4413.399264, "o", "// CheckpointFile represents a parsed .mlck checkpoint.\r\ntype CheckpointFile struct {\r\n\tPath              string            `json:\"-\"`\r\n\tFilename          string            `json:\"-\"` // base filename\r\n\tVersion           uint32            `json:\"version\"`\r\n\tFlags             uint16            `json:\"-\"`\r\n\tNumTensors        uint32            `json:\"-\"`\r\n\tNumMetadataKeys   uint32            `json:\"-\"`\r\n\tCreationTimestamp int64             `json:\"-\"`         // unix seconds\r\n\tHeaderValid       bool              `json:\"-\"`         // header checksum valid?\r\n\tFileHash          string            `json:\"file_hash\"` // SHA-256 hex of entire file\r\n\tSigned            bool              `json:\"-\"`\r\n\t"]
[4413.399327, "o", "Tensors           []TensorInfo      `json:\"tensors\"`\r\n\tMetadataMap       map[string]string `json:\"-\"` // key-value pairs from metadata section\r\n\tProvenance        *Provenance       `json:\"-\"`\r\n\tHasParent         bool              `json:\"has_parent\"`\r\n\tParentHex         string            `json:\"parent_hash\"` // same as Provenance.ParentHash\r\n}\r\n"]
[4413.399823, "o", "\u001b[?2004h"]
[4413.399901, "o", "root@n30009:/app# "]
[4413.681799, "i", "sed -n '1,320p' internal/forensics/detect.go\n"]
[4413.682208, "o", "sed -n '1,320p' internal/forensics/detect.go\r\n\u001b[?2004l\r"]
[4413.685434, "o", "package forensics\r\n\r\nimport (\r\n\t\"crypto/hmac\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n"]
[4413.685547, "o", "\t\"encoding/hex\"\r\n\t\"fmt\"\r\n\t\"hash/fnv\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"time\"\r\n\r\n\t\"mlforge/internal/checkpoint\"\r\n\t\"mlforge/internal/types\"\r\n)\r\n\r\nfunc loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {\r\n\tap, err := DiscoverArtifacts(dir)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar cps []*types.CheckpointFile\r\n\tfor _, p := range ap.Checkpoints {\r\n\t\tcf, err := checkpoint.Parse(p)\r\n\t\tif err != nil || cf == nil {\r\n"]
[4413.685625, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tcps = append(cps, cf)\r\n\t}\r\n\tsort.Slice(cps, func(i, j int) bool {\r\n\t\treturn cps[i].Filename < cps[j].Filename\r\n\t})\r\n\treturn cps, nil\r\n}\r\n\r\ntype DetectOutput struct {\r\n\tStatus    string          `json:\"status\"`\r\n\tAnomalies []types.Anomaly `json:\"anomalies\"`\r\n\t"]
[4413.685689, "o", "Summary   struct {\r\n\t\tTotal      int            `json:\"total\"`\r\n\t\tBySeverity map[string]int `json:\"by_severity\"`\r\n\t\tByType     map[string]int `json:\"by_type\"`\r\n\t} `json:\"summary\"`\r\n}\r\n\r\nfunc BuildDetect(dir string) (interface{}, error) {\r\n\treturn buildDetectWithDir(dir)\r\n}\r\n"]
[4413.685753, "o", "\r\nfunc buildDetectWithDir(dir string) (DetectOutput, error) {\r\n\tvar out DetectOutput\r\n\tout.Status = \"ok\"\r\n\tvar anomalies []types.Anomaly\r\n\r\n\tentries, _, err := loadTimelineEntries(dir)\r\n\tif err == nil {\r\n\t\tmerged, _ := mergeTimeline(entries)\r\n\t\tsortTimeline(merged)\r\n\t\tanomalies = append(anomalies, detectTimelineAnomalies(merged)...)\r\n\t}\r\n"]
[4413.685817, "o", "\r\n\tcps, err := loadCheckpoints(dir)\r\n\tif err == nil {\r\n\t\tanomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\r\n\t}\r\n\r\n\tfor i := range anomalies {\r\n\t\tanomalies[i].ID = fmt.Sprintf(\"ANOM-%03d\", i+1)\r\n\t}\r\n\tsortAnomalies(anomalies)\r\n\r\n"]
[4413.685875, "o", "\tout.Anomalies = anomalies\r\n\tif out.Anomalies == nil {\r\n\t\tout.Anomalies = []types.Anomaly{}\r\n\t}\r\n\tout.Summary.Total = len(anomalies)\r\n\tout.Summary.BySeverity = map[string]int{\"critical\": 0, \"high\": 0, \"medium\": 0, \"low\": 0}\r\n\tout.Summary.ByType = map[string]int{}\r\n\tfor _, a := range anomalies {\r\n\t\t"]
[4413.685951, "o", "out.Summary.BySeverity[a.Severity]++\r\n\t\tout.Summary.ByType[a.Type]++\r\n\t}\r\n\treturn out, nil\r\n}\r\n\r\nfunc detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tanomalies = append(anomalies, detectGradientSpikes(entries)...)\r\n"]
[4413.686018, "o", "\tanomalies = append(anomalies, detectLossDivergence(entries)...)\r\n\tanomalies = append(anomalies, detectLrAnomalies(entries)...)\r\n\tanomalies = append(anomalies, detectTrainingGaps(entries)...)\r\n\tanomalies = append(anomalies, detectMetricRegression(entries)...)\r\n\treturn anomalies\r\n}\r\n\r\n"]
[4413.686076, "o", "func detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar vals []float64\r\n\tvar idx []int\r\n\tfor i, e := range entries {\r\n\t\tif e.GradNorm != nil {\r\n\t\t\tvals = append(vals, *e.GradNorm)\r\n\t\t\tidx = append(idx, i)\r\n\t\t}\r\n\t}\r\n\tif len(vals) < 31 {\r\n\t\treturn nil\r\n\t}\r\n\tvar anomalies []types.Anomaly\r\n"]
[4413.686133, "o", "\tfor i := 30; i < len(vals); i++ {\r\n\t\twindow := vals[i-30 : i]\r\n\t\tmean := meanFloats(window)\r\n\t\tstd := stddevFloats(window, mean)\r\n\t\tobserved := vals[i]\r\n\t\tz := 0.0\r\n\t\tif std > 0 {\r\n\t\t\tz = (observed - mean) / std\r\n"]
[4413.686198, "o", "\t\t}\r\n\t\tif observed > mean+2.5*std && z > 2.5 {\r\n\t\t\tseverity := \"medium\"\r\n\t\t\tif z > 4.0 {\r\n\t\t\t\tseverity = \"high\"\r\n\t\t\t}\r\n\t\t\tep := entries[idx[i]].Epoch\r\n\t\t"]
[4413.686256, "o", "\tst := entries[idx[i]].Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"gradient_spike\",\r\n\t\t\t\tSeverity: severity,\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"observed\":      observed,\r\n"]
[4413.686311, "o", "\t\t\t\t\t\"window_mean\":   mean,\r\n\t\t\t\t\t\"window_stddev\": std,\r\n\t\t\t\t\t\"z_score\":       z,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(entries[idx[i]]),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n"]
[4413.686369, "o", "\r\nfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar lossEntries []int\r\n\tfor i, e := range entries {\r\n\t\tif e.Loss != nil {\r\n\t\t\tlossEntries = append(lossEntries, i)\r\n\t\t}\r\n\t}\r\n"]
[4413.686438, "o", "\tif len(lossEntries) < 51 {\r\n\t\treturn nil\r\n\t}\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 50; i < len(lossEntries); i++ {\r\n\t\tstartIdx := lossEntries[i-50]\r\n\t\tendIdx := lossEntries[i]\r\n\t\tstart := *entries[startIdx].Loss\r\n\t\tend := *entries[endIdx].Loss\r\n\t\tif math.Abs(start) <= 1e-6 {\r\n\t\t\tcontinue\r\n"]
[4413.686506, "o", "\t\t}\r\n\t\tratio := (end - start) / math.Abs(start)\r\n\t\tif ratio > 1.0 {\r\n\t\t\tseverity := \"high\"\r\n\t\t\tif ratio > 5.0 {\r\n\t\t\t\tseverity = \"critical\"\r\n\t\t\t}\r\n\t\t\tep := entries[endIdx].Epoch\r\n\t\t\tst := entries[endIdx].Step\r\n"]
[4413.686565, "o", "\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"loss_divergence\",\r\n\t\t\t\tSeverity: severity,\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"loss_start\":        start,\r\n\t\t\t\t\t\"loss_end\":          end,\r\n\t\t\t\t\t\"increase_ratio\":    ratio,\r\n\t\t\t\t\t\"window_start_step\": entries[startIdx].Step,\r\n\t"]
[4413.686626, "o", "\t\t\t\t\"window_end_step\":   entries[endIdx].Step,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(entries[endIdx]),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n"]
[4413.686683, "o", "\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]\r\n\t\tif prev.Lr == nil || cur.Lr == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif *cur.Lr > *prev.Lr {\r\n\t\t\tif cur.Event == \"epoch_end\" {\r\n\t"]
[4413.686744, "o", "\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"lr_anomaly\",\r\n\t\t\t\tSeverity: \"medium\",\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t"]
[4413.6868, "o", "\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"prev_lr\": *prev.Lr,\r\n\t\t\t\t\t\"curr_lr\": *cur.Lr,\r\n\t\t\t\t\t\"step\":    cur.Step,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n"]
[4413.686869, "o", "\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]\r\n\t\tif prev.Epoch != cur.Epoch {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[4413.686928, "o", "\t\tprevT, err1 := time.Parse(time.RFC3339, prev.Ts)\r\n\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\r\n\t\tif err1 != nil || err2 != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tdiff := curT.Sub(prevT).Seconds()\r\n\t\tif diff > 3600 {\r\n\t\t\tep := cur.Epoch\r\n"]
[4413.687004, "o", "\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"training_gap\",\r\n\t\t\t\tSeverity: \"low\",\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n"]
[4413.687061, "o", "\t\t\t\t\t\"after_step\":  prev.Step,\r\n\t\t\t\t\t\"before_step\": cur.Step,\r\n\t\t\t\t\t\"after_ts\":    prev.Ts,\r\n\t\t\t\t\t\"before_ts\":   cur.Ts,\r\n\t\t\t\t\t\"gap_seconds\": diff,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(cur),\r\n"]
[4413.687116, "o", "\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar cps []types.TimelineEntry\r\n\tfor _, e := range entries {\r\n"]
[4413.687173, "o", "\t\tif e.Event == \"checkpoint\" {\r\n\t\t\tcps = append(cps, e)\r\n\t\t}\r\n\t}\r\n\tsortTimeline(cps)\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(cps); i++ {\r\n\t\tprev := cps[i-1]\r\n"]
[4413.687232, "o", "\t\tcur := cps[i]\r\n\t\tif prev.Acc == nil || cur.Acc == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tdrop := *prev.Acc - *cur.Acc\r\n\t\tif drop > 0.15 {\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n"]
[4413.687293, "o", "\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"metric_regression\",\r\n\t\t\t\tSeverity: \"high\",\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"prev_acc\":        *prev.Acc,\r\n\t\t\t\t\t\"curr_acc\":        *cur.Acc,\r\n\t\t\t\t\t\"drop\":            drop,\r\n"]
[4413.687358, "o", "\t\t\t\t\t\"prev_checkpoint\": prev.Step,\r\n\t\t\t\t\t\"curr_checkpoint\": cur.Step,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n"]
[4413.687419, "o", "\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\thashSet := map[string]*types.CheckpointFile{}\r\n\tfor _, cf := range cps {\r\n\t\thashSet[cf.FileHash] = cf\r\n\t}\r\n\r\n\tfor _, cf := range cps {\r\n\t\traw, err := os.ReadFile(cf.Path)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n"]
[4413.68748, "o", "\t\t}\r\n\t\tif !cf.HeaderValid {\r\n\t\t\tstored := uint64(0)\r\n\t\t\tif len(raw) >= 56 {\r\n\t\t\t\tstored = binary.LittleEndian.Uint64(raw[48:56])\r\n\t\t\t}\r\n\t\t\th := fnv.New64a()\r\n\t\t\th.Write(raw[:48])\r\n\t\t\tcomputed := h.Sum64()\r\n"]
[4413.687535, "o", "\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"header_checksum_mismatch\",\r\n\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"file\":              cf.Filename,\r\n"]
[4413.688107, "o", "\u001b[?2004h"]
[4413.688163, "o", "root@n30009:/app# "]
[4413.982728, "i", "sed -n '1,320p' cmd/mlforge/main.go\n"]
[4413.983083, "o", "sed -n '1,320p' cmd/mlforge/main.go\r\n\u001b[?2004l\r"]
[4413.986216, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n"]
[4413.986313, "o", "\r\n\t\"mlforge/internal/forensics\"\r\n)\r\n\r\nfunc main() {\r\n\t// --- Parse flags ---------------------------------------------------\r\n\tformat := \"json\"\r\n\tverbose := false\r\n\tvar positional []string\r\n\r\n\tfor _, arg := range os.Args[1:] {\r\n"]
[4413.986382, "o", "\t\tswitch {\r\n\t\tcase arg == \"--verbose\":\r\n\t\t\tverbose = true\r\n\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n\t\tcase arg == \"--format\":\r\n\t\t// handled below as two-token flag\r\n\t\tdefault:\r\n"]
[4413.986441, "o", "\t\t\tpositional = append(positional, arg)\r\n\t\t}\r\n\t}\r\n\r\n\t// Handle \"--format json\" (two separate tokens)\r\n\tfor i := 1; i < len(os.Args)-1; i++ {\r\n\t\tif os.Args[i] == \"--format\" {\r\n"]
[4413.986507, "o", "\t\t\tformat = os.Args[i+1]\r\n\t\t\t// Remove the value from positional args\r\n\t\t\tfiltered := positional[:0]\r\n\t\t\tfor _, p := range positional {\r\n\t\t\t\tif p != os.Args[i+1] {\r\n\t\t\t\t\tfiltered = append(filtered, p)\r\n\t"]
[4413.986567, "o", "\t\t\t}\r\n\t\t\t}\r\n\t\t\tpositional = filtered\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n"]
[4413.98663, "o", "\tif format != \"json\" && format != \"text\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json or text\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t_ = verbose // reserved for diagnostic output\r\n\r\n\t// --- Validate positional args --------------------------------------"]
[4413.986709, "o", "\r\n\tif len(positional) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := positional[0]\r\n\tdir := positional[1]\r\n\r\n\t// --- Route to command handler --------------------------------------\r\n"]
[4413.986766, "o", "\tvar result interface{}\r\n\tvar err error\r\n\r\n\tswitch cmd {\r\n\tcase \"ingest\":\r\n\t\tresult, err = forensics.BuildIngest(dir)\r\n\tcase \"timeline\":\r\n\t\t"]
[4413.986825, "o", "result, err = forensics.BuildTimeline(dir)\r\n\tcase \"verify\":\r\n\t\tresult, err = forensics.BuildVerify(dir)\r\n\tcase \"detect\":\r\n\t\tresult, err = forensics.BuildDetect(dir)\r\n\tcase \"lineage\":\r\n\t\tresult, err = forensics.BuildLineage(dir)\r\n"]
[4413.986882, "o", "\tcase \"query\":\r\n\t\tif len(positional) < 3 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tresult, err = forensics.BuildQuery(dir, positional[2])\r\n"]
[4413.986962, "o", "\tcase \"diff\":\r\n\t\tif len(positional) < 4 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge diff <dir> <file1> <file2>\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tresult, err = forensics.BuildDiff(dir, positional[2], positional[3])\r\n\tcase \"report\":\r\n\t\tresult, err = forensics.BuildReport(dir)\r\n"]
[4413.987026, "o", "\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t// --- Output --------------------------------------------------------\r\n\tif err != nil {\r\n"]
[4413.987082, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif format == \"text\" {\r\n\t\tprintText(result)\r\n\t\treturn\r\n"]
[4413.98715, "o", "\t}\r\n\r\n\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n\tif marshalErr != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error marshalling result: %v\\n\", marshalErr)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Println(string(out))\r\n"]
[4413.987221, "o", "}\r\n\r\nfunc printText(v interface{}) {\r\n\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error rendering text output\")\r\n\t\treturn\r\n\t}\r\n\t"]
[4413.987286, "o", "fmt.Println(string(b))\r\n}\r\n"]
[4413.987767, "o", "\u001b[?2004h"]
[4413.987825, "o", "root@n30009:/app# "]
[4414.266221, "i", "sed -n '1,260p' docs/output_schema.md\n"]
[4414.266556, "o", "sed -n '1,260p' docs/output_schema.md\r\n\u001b[?2004l\r"]
[4414.268175, "o", "# Output Schemas\r\n\r\nAll commands output JSON to stdout. This document defines the exact JSON structure for each command.\r\n\r\n---\r\n\r\n## 1. Ingest Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"evidence_dir\": \"/path/to/evidence\",\r\n  \"artifacts\": {\r\n    \"checkpoints\": [\r\n      {\r\n        \"file\": \"model_epoch1.mlck\",\r\n        \"file_hash\": \"a1b2c3...\",\r\n        \"version\": 1,\r\n        \"num_tensors\": 12,\r\n        \"num_metadata\": 3,\r\n        \"signed\": false,\r\n        \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n        \"provenance\": {\r\n          \"epoch\": 1,\r\n          \"global_step\": 5000,\r\n          \"framework\": \"PyTorch\",\r\n          \"framework_version\": \"2.1.0\",\r\n          \"parent_hash\": \"\"\r\n        }\r\n      }\r\n    ],\r\n    \"log_shards\": [\r\n      {\r\n        \"file\": \"shard_001.jsonl\",\r\n        \"entries\": 500,\r\n        \"step_range\": [0, 5000],\r\n        \"epoch_range\": [0, 1],\r\n        \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-15T10:00:00Z\"]\r\n      }\r\n    ],\r\n    \"configs\": [\r\n"]
[4414.268358, "o", "      {\r\n        \"file\": \"config_train.json\",\r\n        \"model_name\": \"resnet50\",\r\n        \"dataset\": \"imagenet-1k\"\r\n      }\r\n    ]\r\n  },\r\n  \"totals\": {\r\n    \"checkpoints\": 3,\r\n    \"log_shards\": 4,\r\n    \"configs\": 1\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `file_hash`: SHA-256 hex of the entire `.mlck` file content.\r\n- `checkpoints` array: sorted by `creation_timestamp` ascending.\r\n- `log_shards` array: sorted by `file` name lexicographically.\r\n- `configs` array: sorted by `file` name lexicographically.\r\n- `step_range`: `[min_step, max_step]` across all entries in the shard.\r\n- `epoch_range`: `[min_epoch, max_epoch]` across all entries.\r\n- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.\r\n\r\n---\r\n\r\n## 2. Timeline Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"total_entries\": 1200,\r\n  \"total_epochs\": 5,\r\n  \"step_range\": [0, 50000],\r\n  \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-17T14:00:00Z\"],\r\n  \"conflicts_resolved\": 3,\r\n  \"gaps\": [\r\n    {\r\n      \"after_step\": 5000,\r\n      \"before_step\": 5200,\r\n      \""]
[4414.268469, "o", "epoch\": 1,\r\n      \"gap_steps\": 200,\r\n      \"after_ts\": \"2024-01-15T10:00:00Z\",\r\n      \"before_ts\": \"2024-01-15T13:00:00Z\"\r\n    }\r\n  ],\r\n  \"entries\": [\r\n    {\r\n      \"ts\": \"2024-01-15T08:00:00Z\",\r\n      \"epoch\": 0,\r\n      \"step\": 0,\r\n      \"loss\": 6.9078,\r\n      \"lr\": 0.001,\r\n      \"grad_norm\": 12.34,\r\n      \"acc\": 0.001,\r\n      \"event\": \"step\",\r\n      \"sources\": [\"shard_001.jsonl\"],\r\n      \"conflict\": false\r\n    }\r\n  ]\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `entries`: sorted by `(epoch ASC, step ASC)`.\r\n- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.\r\n- `conflict`: `true` if this entry was chosen by conflict resolution.\r\n- `gaps`: only gaps where `gap_steps > 100` within the same epoch.\r\n- Entries with missing optional fields omit them from the JSON (do not include null).\r\n\r\n---\r\n\r\n## 3. Verify Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"checkpoints\": [\r\n    {\r\n      \"file\": \"model_epoch1.mlck\",\r\n      \"valid\": true,\r\n      \"header_checksum_valid\": true,\r\n      \"tensor_checksums_"]
[4414.268558, "o", "valid\": true,\r\n      \"signature_valid\": null,\r\n      \"provenance_valid\": true,\r\n      \"issues\": []\r\n    },\r\n    {\r\n      \"file\": \"model_epoch3.mlck\",\r\n      \"valid\": false,\r\n      \"header_checksum_valid\": true,\r\n      \"tensor_checksums_valid\": false,\r\n      \"signature_valid\": true,\r\n      \"provenance_valid\": true,\r\n      \"issues\": [\r\n        {\"type\": \"tensor_checksum_mismatch\", \"detail\": \"encoder.layer2.weight\"}\r\n      ]\r\n    }\r\n  ],\r\n  \"summary\": {\r\n    \"total\": 3,\r\n    \"valid\": 2,\r\n    \"invalid\": 1\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `checkpoints`: sorted by `file` name lexicographically.\r\n- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.\r\n- `issues`: list of issue objects with `type` (string) and `detail` (string). For example, a tensor checksum mismatch appears as `{\"type\": \"tensor_checksum_mismatch\", \"detail\": \"<tensor_name>\"}`.\r\n- `valid`: `true` only if all applicable checks pass.\r\n\r\n---\r\n\r\n## 4. Detect Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"anomalies\": [\r\n    {\r"]
[4414.268647, "o", "\n      \"id\": \"ANOM-001\",\r\n      \"type\": \"gradient_spike\",\r\n      \"severity\": \"high\",\r\n      \"epoch\": 2,\r\n      \"step\": 3456,\r\n      \"details\": {\r\n        \"observed\": 15.3,\r\n        \"window_mean\": 1.2,\r\n        \"window_stddev\": 0.3,\r\n        \"z_score\": 47.0\r\n      },\r\n      \"source\": \"shard_002.jsonl\"\r\n    },\r\n    {\r\n      \"id\": \"ANOM-002\",\r\n      \"type\": \"tensor_checksum_mismatch\",\r\n      \"severity\": \"critical\",\r\n      \"details\": {\r\n        \"file\": \"model_epoch3.mlck\",\r\n        \"tensor_name\": \"encoder.layer2.weight\",\r\n        \"expected_checksum\": \"abcd1234...\",\r\n        \"actual_checksum\": \"efgh5678...\"\r\n      },\r\n      \"source\": \"model_epoch3.mlck\",\r\n        \"checkpoint\": \"model_epoch3.mlck\"\r\n    }\r\n  ],\r\n  \"summary\": {\r\n    \"total\": 5,\r\n    \"by_severity\": {\r\n      \"critical\": 1,\r\n      \"high\": 2,\r\n      \"medium\": 1,\r\n      \"low\": 1\r\n    },\r\n    \"by_type\": {\r\n      \"gradient_spike\": 1,\r\n      \"loss_divergence\": 1,\r\n      \"tensor_checksum_mismatch\": 1,\r\n      \"training_gap\": 1,\r\n      \"lr_anomaly\": 1\r\n    }\r\n "]
[4414.268739, "o", " }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.\r\n- `anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.\r\n- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.\r\n- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.\r\n- `source`: the artifact file where the anomaly was detected.\r\n- `epoch` and `step`: present only for timeline-based anomalies.\r\n- `checkpoint`: present when the anomaly is related to a specific checkpoint file; omitted for timeline-based anomalies that are not checkpoint-specific.\r\n- If no anomalies are detected, `anomalies` is an empty array.\r\n\r\n---\r\n\r\n## 5. Lineage Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"nodes\": [\r\n    {\r\n      \"file\": \"model_epoch1.mlck\",\r\n      \"file_hash\": \"a1b2c3...\",\r\n      \"e"]
[4414.268846, "o", "poch\": 1,\r\n      \"global_step\": 5000,\r\n      \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n      \"parent_hash\": \"\",\r\n      \"is_root\": true,\r\n      \"is_leaf\": false,\r\n      \"is_orphan\": false\r\n    }\r\n  ],\r\n  \"edges\": [\r\n    {\r\n      \"from\": \"a1b2c3...\",\r\n      \"to\": \"d4e5f6...\",\r\n      \"from_file\": \"model_epoch1.mlck\",\r\n      \"to_file\": \"model_epoch2.mlck\"\r\n    }\r\n  ],\r\n  \"roots\": [\"a1b2c3...\"],\r\n  \"leaves\": [\"g7h8i9...\"],\r\n  \"orphans\": [],\r\n  \"topological_order\": [\"a1b2c3...\", \"d4e5f6...\", \"g7h8i9...\"],\r\n  \"cycles\": []\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `nodes`: sorted by `creation_timestamp` ascending.\r\n- `edges`: sorted by `from` hash then `to` hash lexicographically.\r\n- `roots`: file hashes of root nodes (no parent), sorted.\r\n- `leaves`: file hashes of leaf nodes (no children), sorted.\r\n"]
