[329.619803, "o", "    84\t\t}\r\n    85\t\tcf.Tensors = tensors\r\n    86\t\r\n    87\t\t// --- parse metadata section ---\r\n    88\t\tif numMetadata > 0 && metadataOffset > 0 && int(metadataOffset) < len(raw) {\r\n    89\t\t\tmd, err := parseMetadata(raw, int(metadataOffset), numMetadata)\r\n    90\t\t\tif err == nil {\r\n    91\t\t\t\tcf.MetadataMap = md\r\n    92\t\t\t}\r\n    93\t\t}\r\n    94\t\r\n    95\t\t// --- parse provenance section ---\r\n    96\t\tif provenanceOffset > 0 && int(provenanceOffset) < len(raw) {\r\n"]
[329.619903, "o", "    97\t\t\tprov, err := parseProvenance(raw, int(provenanceOffset))\r\n    98\t\t\tif err == nil {\r\n    99\t\t\t\tcf.Provenance = prov\r\n   100\t\t\t\tcf.HasParent = prov.ParentHash != \"\"\r\n   101\t\t\t\tcf.ParentHex = prov.ParentHash\r\n   102\t\t\t}\r\n   103\t\t}\r\n   104\t\r\n   105\t\treturn cf, nil\r\n   106\t}\r\n   107\t\r\n   108\t// parseTensor parses one tensor block starting at off and returns the\r\n   109\t// TensorInfo plus the new offset after the block.\r\n   110\tfunc parseTensor(raw []byte, off int, idx uint32) (types.TensorInfo, int, error) {\r\n   111\t\tfail := func(msg string) (types.TensorInfo, int, error) {\r\n   112\t"]
[329.620023, "o", "\t\treturn types.TensorInfo{}, 0, fmt.Errorf(\"checkpoint: tensor %d: %s\", idx, msg)\r\n   113\t\t}\r\n   114\t\r\n   115\t\t// name_len (uint16 LE)\r\n   116\t\tif off+2 > len(raw) {\r\n   117\t\t\treturn fail(\"unexpected EOF reading name_len\")\r\n   118\t\t}\r\n   119\t\tnameLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   120\t\toff += 2\r\n   121\t\r\n   122\t\t// name\r\n   123\t\tif off+nameLen > len(raw) {\r\n   124\t\t\treturn fail(\"unexpected EOF reading name\")\r\n   125\t\t}\r\n   126\t\tname := string(raw[off : off+nameLen])\r\n"]
[329.620091, "o", "   127\t\toff += nameLen\r\n   128\t\r\n   129\t\t// dtype (1 byte)\r\n   130\t\tif off+1 > len(raw) {\r\n   131\t\t\treturn fail(\"unexpected EOF reading dtype\")\r\n   132\t\t}\r\n   133\t\tdtype := raw[off]\r\n"]
[329.620152, "o", "   134\t\toff++\r\n   135\t\r\n   136\t\t// num_dims (1 byte)\r\n   137\t\tif off+1 > len(raw) {\r\n   138\t\t\treturn fail(\"unexpected EOF reading num_dims\")\r\n   139\t\t}\r\n   140\t\tnumDims := int(raw[off])\r\n   141\t\toff++\r\n   142\t\r\n   143\t\t// shape (num_dims * uint32 LE)\r\n"]
[329.620212, "o", "   144\t\tshapeBytes := numDims * 4\r\n   145\t\tif off+shapeBytes > len(raw) {\r\n   146\t\t\treturn fail(\"unexpected EOF reading shape\")\r\n   147\t\t}\r\n   148\t\tshape := make([]uint32, numDims)\r\n   149\t\tfor d := 0; d < numDims; d++ {\r\n   150\t\t\tshape[d] = binary.LittleEndian.Uint32(raw[off : off+4])\r\n"]
[329.620272, "o", "   151\t\t\toff += 4\r\n   152\t\t}\r\n   153\t\r\n   154\t\t// data_size (uint64 LE)\r\n   155\t\tif off+8 > len(raw) {\r\n   156\t\t\treturn fail(\"unexpected EOF reading data_size\")\r\n   157\t\t}\r\n   158\t\tdataSize := binary.LittleEndian.Uint64(raw[off : off+8])\r\n   159\t\toff += 8\r\n   160\t\r\n"]
[329.620333, "o", "   161\t\t// data\r\n   162\t\tif off+int(dataSize) > len(raw) {\r\n   163\t\t\treturn fail(\"unexpected EOF reading data\")\r\n   164\t\t}\r\n   165\t\tdata := raw[off : off+int(dataSize)]\r\n   166\t\toff += int(dataSize)\r\n   167\t\r\n   168\t\t// hash (32 bytes SHA-256)\r\n"]
[329.620392, "o", "   169\t\tif off+32 > len(raw) {\r\n   170\t\t\treturn fail(\"unexpected EOF reading hash\")\r\n   171\t\t}\r\n   172\t\tvar storedHash [32]byte\r\n   173\t\tcopy(storedHash[:], raw[off:off+32])\r\n   174\t\toff += 32\r\n   175\t\r\n   176\t\t// verify SHA-256"]
[329.620453, "o", "\r\n   177\t\tcomputedHash := sha256.Sum256(data)\r\n   178\t\tvalid := computedHash == storedHash\r\n   179\t\r\n   180\t\treturn types.TensorInfo{\r\n   181\t\t\tName:  name,\r\n   182\t\t\tDtype: dtype,\r\n   183\t\t\tShape: shape,\r\n   184\t\t\tData:  data,\r\n"]
[329.620511, "o", "   185\t\t\tHash:  storedHash,\r\n   186\t\t\tValid: valid,\r\n   187\t\t}, off, nil\r\n   188\t}\r\n   189\t\r\n   190\t// parseMetadata parses the metadata section: numMeta key-value pairs.\r\n   191\tfunc parseMetadata(raw []byte, off int, numMeta uint32) (map[string]string, error) {\r\n   192\t\tmd := make(map[string]string, numMeta)\r\n"]
[329.620574, "o", "   193\t\tfor i := uint32(0); i < numMeta; i++ {\r\n   194\t\t\t// key_len (uint16)\r\n   195\t\t\tif off+2 > len(raw) {\r\n   196\t\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at key_len %d\", i)\r\n   197\t\t\t}\r\n   198\t\t\tkeyLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   199\t\t\toff += 2\r\n"]
[329.620629, "o", "   200\t\r\n"]
