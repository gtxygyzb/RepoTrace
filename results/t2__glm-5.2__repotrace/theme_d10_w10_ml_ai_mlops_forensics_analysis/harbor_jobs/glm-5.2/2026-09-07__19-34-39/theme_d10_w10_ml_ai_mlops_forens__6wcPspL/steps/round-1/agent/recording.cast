[2811.85337, "o", "   130\t\tif off+1 > len(raw) {\r\n   131\t\t\treturn fail(\"unexpected EOF reading dtype\")\r\n   132\t\t}\r\n   133\t\tdtype := raw[off]\r\n   134\t\toff++\r\n   135\t\r\n   136\t\t// num_dims (1 byte)\r\n   137"]
[2811.853511, "o", "\t\tif off+1 > len(raw) {\r\n   138\t\t\treturn fail(\"unexpected EOF reading num_dims\")\r\n   139\t\t}\r\n   140\t\tnumDims := int(raw[off])\r\n   141\t\toff++\r\n   142\t\r\n   143\t\t// shape (num_dims * uint32 LE)\r\n   144\t\tshapeBytes := numDims * 4\r\n   145\t\tif off+shapeBytes > len(raw) {\r\n   146\t\t\treturn fail(\"unexpected EOF reading shape\")\r\n   147\t\t}\r\n   148\t\tshape := make([]uint32, numDims)\r\n   149\t\tfor d := 0; d < numDims; d++ {\r\n   150\t\t\tshape[d] = binary.LittleEndian.Uint32(raw[off : off+4])\r\n   151\t\t\toff += 4\r\n   152\t\t}\r\n   153\t\r\n   154\t\t// data_size (uint64 LE)\r\n   155\t\tif off+8 > len(raw) {\r\n   156\t\t\treturn fail(\"unexpected EOF reading data_size\")\r\n   157\t\t}\r\n"]
[2811.853624, "o", "   158\t\tdataSize := binary.LittleEndian.Uint64(raw[off : off+8])\r\n   159\t\toff += 8\r\n   160\t\r\n   161\t\t// data\r\n   162\t\tif off+int(dataSize) > len(raw) {\r\n   163\t\t\treturn fail(\"unexpected EOF reading data\")\r\n   164\t\t}\r\n   165\t\tdata := raw[off : off+int(dataSize)]\r\n   166\t\toff += int(dataSize)\r\n"]
[2811.853697, "o", "   167\t\r\n   168\t\t// hash (32 bytes SHA-256)\r\n   169\t\tif off+32 > len(raw) {\r\n   170\t\t\treturn fail(\"unexpected EOF reading hash\")\r\n   171\t\t}\r\n   172\t\tvar storedHash [32]byte\r\n   173\t\tcopy(storedHash[:], raw[off:off+32])\r\n   174\t\toff += 32\r\n   175\t\r\n   176\t\t// verify SHA-256\r\n   177\t\tcomputedHash := sha256.Sum256(data)\r\n   178\t\tvalid := computedHash == storedHash\r\n   179\t\r\n   180\t\treturn types.TensorInfo{\r\n   181\t\t\tName:  name,\r\n   182\t\t\tDtype: dtype,\r\n   183\t\t\tShape: shape,\r\n   184\t\t\tData:  data,\r\n   185\t\t\tHash:  storedHash,\r\n"]
[2811.85376, "o", "   186\t\t\tValid: valid,\r\n   187\t\t}, off, nil\r\n   188\t}\r\n   189\t\r\n   190\t// parseMetadata parses the metadata section: numMeta key-value pairs.\r\n"]
[2811.853829, "o", "   191\tfunc parseMetadata(raw []byte, off int, numMeta uint32) (map[string]string, error) {\r\n   192\t\tmd := make(map[string]string, numMeta)\r\n   193\t\tfor i := uint32(0); i < numMeta; i++ {\r\n   194\t\t\t// key_len (uint16)\r\n   195\t\t\tif off+2 > len(raw) {\r\n   196\t\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at key_len %d\", i)\r\n   197\t\t\t}\r\n   198\t\t\tkeyLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   199\t\t\toff += 2\r\n   200\t\r\n   201\t\t\tif off+keyLen > len(raw) {\r\n   202\t\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at key %d\", i)\r\n   203\t\t\t}\r\n"]
[2811.853926, "o", "   204\t\t\tkey := string(raw[off : off+keyLen])\r\n   205\t\t\toff += keyLen\r\n   206\t\r\n   207"]
[2811.854013, "o", "\t\t\t// value_len (uint32)\r\n   208\t\t\tif off+4 > len(raw) {\r\n   209\t\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at value_len %d\", i)\r\n   210\t\t\t}\r\n   211\t\t\tvalLen := int(binary.LittleEndian.Uint32(raw[off : off+4]))\r\n   212\t\t\toff += 4\r\n   213\t\r\n   214\t\t\tif off+valLen > len(raw) {\r\n   215\t\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at value %d\", i)\r\n   216\t\t\t}\r\n   217\t\t\tval := string(raw[off : off+valLen])\r\n   218\t\t\toff += valLen\r\n   219\t\r\n   220\t\t\tmd[key] = val\r\n   221\t\t}\r\n   222\t\treturn md, nil\r\n   223\t}\r\n   224\t\r\n   225\t// parseProvenance parses the provenance section.\r\n   226\tfunc parseProvenance(raw []byte, off int) (*types.Provenance, error) {\r\n   227\t\tp := &types.Provenance{}\r\n"]
[2811.854086, "o", "   228\t\r\n   229\t\t// GitCommit: 40 bytes ASCII\r\n   230\t\tif off+40 > len(raw) {\r\n"]
