[779.128798, "i", "cat > internal/forensics/query.go <<'EOF'\npackage forensics\n\nimport (\n\t\"fmt\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"mlforge/internal/types\"\n)\n\ntype QueryOutput struct {\n\tStatus  string                 `json:\"status\"`\n\tQuery   string                 `json:\"query\"`\n\tMatches int                    `json:\"matches\"`\n\tEntries []types.TimelineEntry   `json:\"entries\"`\n}\n\nfunc BuildQuery(dir, expr string) (interface{}, error) {\n\tentries, _, err := loadTimelineEntries(dir)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmerged, _ := mergeTimeline(entries)\n\tsortTimeline(merged)\n\n\tq, err := parseQuery(expr)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar matches []types.TimelineEntry\n\tfor _, e := range merged {\n\t\tif q.eval(e) {\n\t\t\tmatches = append(matches, e)\n\t\t}\n\t}\n\treturn QueryOutput{\n\t\tStatus:  \"ok\",\n\t\tQuery:   expr,\n\t\tMatches: len(matches),\n\t\tEntries: matches,\n\t}, nil\n}\n\ntype condition struct {\n\tfield string\n\top    string\n\tsval  string\n\tfval  float64\n\tisNum bool\n}\n\ntype orGroup struct {\n\tands []condition\n}\n\ntype query struct {\n\tors []or"]
[779.129146, "i", "Group\n}\n\nfunc (q query) eval(e types.TimelineEntry) bool {\n\tfor _, g := range q.ors {\n\t\tok := true\n\t\tfor _, c := range g.ands {\n\t\t\tif !c.eval(e) {\n\t\t\t\tok = false\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif ok {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc (c condition) eval(e types.TimelineEntry) bool {\n\tswitch c.field {\n\tcase \"step\":\n\t\treturn compareNum(float64(e.Step), c)\n\tcase \"epoch\":\n\t\treturn compareNum(float64(e.Epoch), c)\n\tcase \"loss\":\n\t\treturn ptrCompareNum(e.Loss, c)\n\tcase \"lr\":\n\t\treturn ptrCompareNum(e.Lr, c)\n\tcase \"grad_norm\":\n\t\treturn ptrCompareNum(e.GradNorm, c)\n\tcase \"acc\":\n\t\treturn ptrCompareNum(e.Acc, c)\n\tcase \"event\":\n\t\treturn compareStr(e.Event, c)\n\tcase \"ts\":\n\t\treturn compareTs(e.Ts, c)\n\t}\n\treturn false\n}\n\nfunc compareNum(val float64, c condition) bool {\n\tif !c.isNum {\n\t\treturn false\n\t}\n\tswitch c.op {\n\tcase \">\":\n\t\treturn val > c.fval\n\tcase \"<\":\n\t\treturn val < c.fval\n\tcase \">=\":\n\t\treturn val >= c.fval\n\tcase \"<=\":\n\t\treturn val <= c.fval\n\tcase \"==\":\n\t\treturn absFloat(val-c.fval) <= 1e-9\n\tcase \"!=\":\n\t\treturn absFlo"]
