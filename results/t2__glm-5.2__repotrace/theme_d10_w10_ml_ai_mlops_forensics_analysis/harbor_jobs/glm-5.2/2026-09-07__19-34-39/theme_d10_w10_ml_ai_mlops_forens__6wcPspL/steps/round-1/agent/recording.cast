[4449.500526, "o", "   533\tfunc sortAnomalies(a []types.Anomaly) {\r\n   534\t\trank := map[string]int{\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3}\r\n   535\t\tsort.Slice(a, func(i, j int) bool {\r\n   536\t\t\tri := rank[a[i].Severity]\r\n   537\t\t\trj := rank[a[j].Severity]\r\n   538\t\t\tif ri != rj {\r\n   539\t\t\t\treturn ri < rj\r\n   540\t\t\t}\r\n   541\t\t\tei := -1\r\n"]
