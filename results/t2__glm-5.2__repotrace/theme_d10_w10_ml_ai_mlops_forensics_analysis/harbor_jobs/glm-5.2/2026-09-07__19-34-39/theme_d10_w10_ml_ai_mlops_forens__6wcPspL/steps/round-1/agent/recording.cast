[1808.539891, "o", "var vals []float64\r\n   100\t\tvar idx []int\r\n   101\t\tfor i, e := range entries {\r\n   102\t\t\tif e.GradNorm != nil {\r\n"]
[1808.539991, "o", "   103\t\t\t\tvals = append(vals, *e.GradNorm)\r\n   104\t\t\t\tidx = append(idx, i)\r\n   105\t\t\t}\r\n   106\t\t}\r\n   107\t\tif len(vals) < 31 {\r\n   108\t\t\treturn nil\r\n   109\t\t}\r\n   110\t\tvar anomalies []types.Anomaly\r\n"]
[1808.540047, "o", "   111\t\tfor i := 30; i < len(vals); i++ {\r\n   112\t\t\twindow := vals[i-30 : i]\r\n   113\t\t\tmean := meanFloats(window)\r\n   114\t\t\tstd := stddevFloats(window, mean)\r\n   115\t\t\tobserved := vals[i]\r\n   116\t\t\tz := 0.0\r\n   117\t\t\tif std > 0 {\r\n   118\t\t\t\tz = (observed - mean) / std\r\n   119\t\t\t}\r\n   120\t\t\tif observed > mean+2.5*std && z > 2.5 {\r\n   121\t\t\t\tseverity := \"medium\"\r\n"]
[1808.54012, "o", "   122\t\t\t\tif z > 4.0 {\r\n   123\t\t\t\t\tseverity = \"high\"\r\n   124\t\t\t\t}\r\n   125\t\t\t\tep := entries[idx[i]].Epoch\r\n   126\t\t\t\tst := entries[idx[i]].Step\r\n   127\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   128\t\t\t\t\tType:     \"gradient_spike\",\r\n   129\t"]
[1808.540173, "o", "\t\t\t\tSeverity: severity,\r\n   130\t\t\t\t\tEpoch:    &ep,\r\n   131\t\t\t\t\tStep:     &st,\r\n   132\t\t\t\t\tDetails: map[string]interface{}{\r\n   133\t\t\t\t\t\t\"observed\":      observed,\r\n   134\t\t\t\t\t\t\"window_mean\":   mean,\r\n   135\t\t"]
[1808.540224, "o", "\t\t\t\t\"window_stddev\": std,\r\n   136\t\t\t\t\t\t\"z_score\":       z,\r\n   137\t\t\t\t\t},\r\n   138\t\t\t\t\tSource: firstSource(entries[idx[i]]),\r\n   139\t\t\t\t})\r\n   140\t\t\t}\r\n   141\t"]
[1808.540275, "o", "\t}\r\n   142\t\treturn anomalies\r\n   143\t}\r\n   144\t\r\n   145\tfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n"]
[1808.540324, "o", "   230\t\t\tprevT, err1 := time.Parse(time.RFC3339, prev.Ts)\r\n   231\t\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\r\n   232\t\t\tif err1 != nil || err2 != nil {\r\n   233\t\t\t\tcontinue\r\n   234\t\t\t}\r\n   235\t\t\tdiff := curT.Sub(prevT).Seconds()\r\n"]
[1808.540374, "o", "   236\t\t\tif diff > 3600 {\r\n   237\t\t\t\tep := cur.Epoch\r\n   238\t\t\t\tst := cur.Step\r\n   239\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   240\t\t\t\t\tType:     \"training_gap\",\r\n   241\t\t\t\t\tSeverity: \"low\",\r\n   242\t\t\t\t\tEpoch:    &ep,\r\n   243\t\t\t\t\tStep:     &st,\r\n"]
[1808.540425, "o", "   244\t\t\t\t\tDetails: map[string]interface{}{\r\n   245\t\t\t\t\t\t\"after_step\":  prev.Step,\r\n"]
[1808.540958, "o", "\u001b[?2004h"]
