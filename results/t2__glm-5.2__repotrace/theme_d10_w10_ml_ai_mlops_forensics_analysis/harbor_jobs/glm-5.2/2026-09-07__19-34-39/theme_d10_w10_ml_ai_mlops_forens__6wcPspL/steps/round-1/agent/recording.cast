[4479.858198, "o", "\tanomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {\r\n\tbyHash := map[string]*types.CheckpointFile{}\r\n\tfor _, cf := range cps {\r\n\t\tbyHash[cf.FileHash] = cf\r\n\t}\r\n\tchildren := map[string][]string{}\r\n\tfor _, cf := range cps {\r\n\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n\t\t"]
[4479.858252, "o", "\tif _, ok := byHash[cf.Provenance.ParentHash]; ok {\r\n\t\t\t\tchildren[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tvar anomalies []types.Anomaly\r\n\tseen := map[string]bool{}\r\n\tfor _, cf := range cps {\r\n"]
[4479.858267, "o", "\t\tif cf.Provenance == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\troot := cf.FileHash\r\n\t\tfor root != \"\" {\r\n\t\t\tparent, ok := byHash[root]\r\n\t\t\tif !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == \"\" {\r\n\t\t\t\tbreak\r\n"]
[4479.858341, "o", "\t\t\t}\r\n\t\t\troot = parent.Provenance.ParentHash\r\n\t\t}\r\n\t\tif seen[root] {\r\n\t"]
[4479.858395, "o", "\t\tcontinue\r\n\t\t}\r\n\t\tseen[root] = true\r\n\r\n\t\tchain := []string{}\r\n\t\tqueue := []string{root}\r\n\t\tvisited := map[string]bool{}\r\n\t\tfor len(queue) > 0 {\r\n\t\t\tcur := queue[0]\r\n\t\t\tqueue = queue[1:]\r\n\t\t\tif visited[cur] {\r\n\t\t\t\tcontinue\r\n"]
[4479.85841, "o", "\t\t\t}\r\n\t\t\tvisited[cur] = true\r\n\t\t\tnode, ok := byHash[cur]\r\n\t\t\tif !ok || node == nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n"]
[4479.85849, "o", "\t\t\tchain = append(chain, node.Filename)\r\n\t\t\tqueue = append(queue, children[cur]...)\r\n\t\t}\r\n\t\tsort.Strings(chain)\r\n\r\n\t\thashes := map[string]struct{}{}\r\n\t\tfor _, h := range chain {\r\n\t\t\tif node, ok := byHashFile(cps, h); ok && node.Provenance != nil {\r\n\t\t\t\thashes[node.Provenance.DatasetHash] = struct{}{}\r\n\t\t\t}\r\n\t\t}\r\n"]
[4479.858541, "o", "\t\tif len(hashes) > 1 {\r\n\t\t\tunique := make([]string, 0, len(hashes))\r\n\t\t\tfor h := range hashes {"]
[4479.858557, "o", "\r\n\t\t\t\tunique = append(unique, h)\r\n\t\t\t}\r\n\t\t\tsort.Strings(unique)\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"dataset_hash_inconsistency\",\r\n\t\t\t\tSeverity: \"high\",\r\n"]
[4479.858567, "o", "\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"files\":  chain,\r\n"]
[4479.858653, "o", "\t\t\t\t\t\"hashes\": unique,\r\n\t\t\t\t},\r\n\t\t\t\tSource: chain[0],\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {\r\n\tfor _, cf := range cps {\r\n\t\tif cf.Filename == file {\r\n\t\t\treturn cf, true\r\n"]
[4479.858667, "o", "\t\t}\r\n\t}\r\n\t"]
