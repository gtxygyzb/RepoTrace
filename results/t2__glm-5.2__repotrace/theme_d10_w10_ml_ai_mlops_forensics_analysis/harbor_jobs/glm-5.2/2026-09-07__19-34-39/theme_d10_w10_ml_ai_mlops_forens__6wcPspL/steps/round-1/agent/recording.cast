[4456.370377, "o", "\t\tvar anomalies []types.Anomaly\r\n   193\t\tfor i := 1; i < len(entries); i++ {\r\n"]
[4456.370433, "o", "   194\t\t\tprev := entries[i-1]\r\n   195\t\t\tcur := entries[i]\r\n   196\t\t\tif prev.Lr == nil || cur.Lr == nil {\r\n   197\t\t\t\tcontinue\r\n   198\t\t\t}\r\n   199\t\t\tif *cur.Lr > *prev.Lr {\r\n   200\t\t\t\tif cur.Event == \"epoch_end\" {\r\n   201\t\t\t\t\tcontinue\r\n"]
[4456.370493, "o", "   202\t\t\t\t}\r\n   203\t\t\t\tep := cur.Epoch\r\n   204\t\t\t\tst := cur.Step\r\n   205\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   206\t\t\t\t\tType:     \"lr_anomaly\",\r\n   207\t\t\t\t\tSeverity: \"medium\",\r\n   208\t\t\t\t\tEpoch:    &ep,\r\n   209\t\t\t\t\tStep:     &st,\r\n   210\t\t\t\t\tDetails: map[string]interface{}{\r\n   211\t\t\t\t\t\t\"prev_lr\": *prev.Lr,\r\n   212\t\t\t\t\t\t\"curr_lr\": *cur.Lr,\r\n   213\t\t\t\t\t\t\"step\":    cur.Step,\r\n   214\t\t\t\t\t},\r\n"]
[4456.370548, "o", "   215\t\t\t\t\tSource: firstSource(cur),\r\n   216\t\t\t\t})\r\n   217\t\t\t}\r\n"]
