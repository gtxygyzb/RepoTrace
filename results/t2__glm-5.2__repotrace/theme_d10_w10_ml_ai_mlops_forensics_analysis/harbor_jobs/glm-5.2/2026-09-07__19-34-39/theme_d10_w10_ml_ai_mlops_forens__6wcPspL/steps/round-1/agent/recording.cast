[5032.097969, "o", "\tdefault:\r\n\t\treturn 4, false\r\n\t}\r\n"]
[5032.098049, "o", "}\r\n\r\nfunc detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tanomalies = append(anomalies, detectGradientSpikes(entries)...)\r\n\tanomalies = append(anomalies, detectLossDivergence(entries)...)\r\n\tanomalies = append(anomalies, detectLrAnomalies(entries)...)\r\n\tanomalies = append(anomalies, detectTrainingGaps(entries)...)\r\n\tanomalies = append(anomalies, detectMetricRegression(entries)...)\r\n"]
[5032.098166, "o", "\treturn anomalies\r\n}\r\n\r\nfunc detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar vals []float64\r\n\tvar idx []int\r\n\tfor i, e := range entries {\r\n\t\tif e.GradNorm != nil {\r\n\t\t\tvals = append(vals, *e.GradNorm)\r\n"]
[5032.098707, "o", "\u001b[?2004h"]
