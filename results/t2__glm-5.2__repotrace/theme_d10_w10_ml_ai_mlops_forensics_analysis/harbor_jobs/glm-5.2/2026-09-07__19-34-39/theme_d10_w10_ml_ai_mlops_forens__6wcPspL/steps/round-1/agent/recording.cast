[5454.376098, "o", "\t}\r\n   594\t\treturn s / float64(len(v))\r\n   595\t}\r\n   596\t\r\n   597\tfunc stddevFloats(v []float64, mean float64) float64 {\r\n   598\t\tif len(v) == 0 {\r\n   599\t\t\treturn 0\r\n   600\t\t}\r\n   601\t\ts := 0.0\r\n   602\t\tfor _, x := range v {\r\n   603"]
[5454.376159, "o", "\t\t\td := x - mean\r\n   604\t\t\ts += d * d\r\n   605\t\t}\r\n   606\t\treturn math.Sqrt(s / float64(len(v)))\r\n   607\t}\r\n   608\t\r\n   609\tfunc sortAnomalies(a []types.Anomaly) {\r\n   610\t\trank := map[string]int{\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3}\r\n"]
[5454.376215, "o", "   611\t\tsort.Slice(a, func(i, j int) bool {\r\n   612\t\t\tri := rank[a[i].Severity]\r\n   613\t\t\trj := rank[a[j].Severity]\r\n   614\t\t\tif ri != rj {\r\n   615\t\t\t\treturn ri < rj\r\n   616\t\t\t}\r\n   617\t\t\tei := -1\r\n"]
