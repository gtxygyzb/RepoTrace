[2959.431459, "o", "\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K3\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K## 1. MLCK Checkpo\u001b[01;31m\u001b[Kint\u001b[m\u001b[K Format (`.mlck`)\r\n"]
[2959.431659, "o", "\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K5\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KAll multi-byte \u001b[01;31m\u001b[Kint\u001b[m\u001b[Keger and floating-po\u001b[01;31m\u001b[Kint\u001b[m\u001b[K values are **little-endian**.\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 4 | 2 | u\u001b[01;31m\u001b[Kint\u001b[m\u001b[K16 | Version | Must be `1` |\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 6 | 2 | u\u001b[01;31m\u001b[Kint\u001b[m\u001b[K16 | Flags | Bit 0: signed (has signature block). Bits 1-15: reserved (must be 0) |\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 8 | 4 | u\u001b[01;31m\u001b[Kint\u001b[m\u001b[K32 | NumTensors | Number of tensor blocks |\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 12 | 4 | u\u001b[01;31m\u001b[Kint\u001b[m\u001b[K32 | NumMetadata | Number of metadata key-value pairs |\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 16 | 8 | u\u001b[01;31m\u001b[Kint\u001b[m\u001b[K64 | MetadataOffset | Byte offset of metadata section from file start |\r\n\u001b[35m\u001b[Kdocs/formats."]
[2959.431762, "o", "md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 24 | 8 | u\u001b[01;31m\u001b[Kint\u001b[m\u001b[K64 | ProvenanceOffset | Byte offset of provenance section from file start |\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 32 | 8 | u\u001b[01;31m\u001b[Kint\u001b[m\u001b[K64 | SignatureOffset | Byte offset of signature block (0 if unsigned) |\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 40 | 8 | \u001b[01;31m\u001b[Kint\u001b[m\u001b[K64 | CreationTimestamp | Unix timestamp (seconds) when checkpo\u001b[01;31m\u001b[Kint\u001b[m\u001b[K was created |\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 48 | 8 | u\u001b[01;31m\u001b[Kint\u001b[m\u001b[K64 | HeaderChecksum | FNV-1a 64-bit hash of bytes [0..48) |\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 2 | u\u001b[01;31m\u001b[Kint\u001b[m\u001b[K16 | NameLen | Length of tensor name in bytes |\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 1 | u\u001b[01;31m\u001b[Kint\u001b[m\u001b[K8 | Dtype | Data type enum (see below) |\r\n\u001b[35m\u001b[Kdocs/f"]
