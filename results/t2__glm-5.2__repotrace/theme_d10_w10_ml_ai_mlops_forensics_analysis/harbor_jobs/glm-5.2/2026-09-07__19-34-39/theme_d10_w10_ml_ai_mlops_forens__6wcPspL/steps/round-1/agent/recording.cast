[2126.418106, "o", "   317\t\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"tensor_checksum_mismatch\", Detail: t.Name})\r\n   318\t\t\t}\r\n   319\t\t}\r\n   320\t\tif cf.Signed {\r\n   321\t\t\tvalid, _ := validateSignature(path)\r\n   322\t\t\tvc.SignatureValid = &valid\r\n   323\t\t\tif !valid {\r\n   324\t\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"signature_invalid\", Detail: \"\"})\r\n   325\t\t\t}\r\n   326\t\t}\r\n   327\t\tvc.ProvenanceValid = validateProvenance(cf)\r\n   328\t\tif !vc.ProvenanceValid {\r\n   329\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"provenance_invalid\", Detail: \"\"})\r\n   330\t\t}\r\n   331\t\tvc.Valid = vc.HeaderChecksumValid && vc.TensorChecksumsValid && vc.ProvenanceValid && (!cf.Signed || (vc.SignatureValid != nil && *vc.SignatureValid))\r\n   332\t\treturn vc\r\n"]
