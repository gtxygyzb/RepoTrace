[5432.648956, "o", "sed -n '1,280p' docs/output_schema.md\r\n"]
[5432.649042, "o", "\u001b[?2004l\r"]
[5432.651983, "o", "# Output Schemas\r\n\r\nAll commands output JSON to stdout. This document defines the exact JSON structure for each command.\r\n\r\n---\r\n\r\n## 1. Ingest Output\r\n\r\n```json\r\n"]
[5432.652079, "o", "{\r\n  \"status\": \"ok\",\r\n  \"evidence_dir\": \"/path/to/evidence\",\r\n  \"artifacts\": {\r\n    \"checkpoints\": [\r\n      {\r\n        \"file\": \"model_epoch1.mlck\",\r\n        \"file_hash\": \"a1b2c3...\",\r\n        \"version\": 1,\r\n        \"num_tensors\": 12,\r\n        \"num_metadata\": 3,\r\n        \"signed\": false,\r\n        \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n        \"provenance\": {\r\n          \"epoch\": 1,\r\n          \"global_step\": 5000,\r\n          \"framework\": \"PyTorch\",\r\n          \"framework_version\": \"2.1.0\",\r\n          \"parent_hash\": \"\"\r\n        }\r\n      }\r\n"]
[5432.652154, "o", "    ],\r\n    \"log_shards\": [\r\n      {\r\n        \"file\": \"shard_001.jsonl\",\r\n        \"entries\": 500,\r\n        \"step_range\": [0, 5000],\r\n        \"epoch_range\": [0, 1],\r\n        \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-15T10:00:00Z\"]\r\n      }\r\n    ],\r\n    \"configs\": [\r\n      {\r\n        \"file\": \"config_train.json\",\r\n        \"model_name\": \"resnet50\",\r\n        \"dataset\": \"imagenet-1k\"\r\n      }\r\n    ]\r\n  },"]
[5432.652227, "o", "\r\n  \"totals\": {\r\n    \"checkpoints\": 3,\r\n    \"log_shards\": 4,\r\n    \"configs\": 1\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `file_hash`: SHA-256 hex of the entire `.mlck` file content.\r\n- `checkpoints` array: sorted by `creation_timestamp` ascending.\r\n- `log_shards` array: sorted by `file` name lexicographically.\r\n- `configs` array: sorted by `file` name lexicographically.\r\n- `step_range`: `[min_step, max_step]` across all entries in the shard.\r\n- `epoch_range`: `[min_epoch, max_epoch]` across all entries.\r\n"]
[5432.652286, "o", "- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.\r\n\r\n---\r\n\r\n## 2. Timeline Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"total_entries\": 1200,\r\n  \"total_epochs\": 5,\r\n"]
[5432.65235, "o", "  \"step_range\": [0, 50000],\r\n  \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-17T14:00:00Z\"],\r\n  \"conflicts_resolved\": 3,\r\n  \"gaps\": [\r\n    {\r\n      \"after_step\": 5000,\r\n      \"before_step\": 5200,\r\n      \"epoch\": 1,\r\n      \"gap_steps\": 200,\r\n      \"after_ts\": \"2024-01-15T10:00:00Z\",\r\n      \"before_ts\": \"2024-01-15T13:00:00Z\"\r\n    }\r\n  ],\r\n  \"entries\": [\r\n    {"]
[5432.652425, "o", "\r\n      \"ts\": \"2024-01-15T08:00:00Z\",\r\n      \"epoch\": 0,\r\n      \"step\": 0,\r\n      \"loss\": 6.9078,\r\n      \"lr\": 0.001,\r\n      \"grad_norm\": 12.34,\r\n      \"acc\": 0.001,\r\n      \"event\": \"step\",\r\n      \"sources\": [\"shard_001.jsonl\"],\r\n      \"conflict\": false\r\n    }\r\n  ]\r\n}\r\n```\r\n"]
[5432.652485, "o", "\r\n**Field rules:**\r\n- `entries`: sorted by `(epoch ASC, step ASC)`.\r\n- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.\r\n- `conflict`: `true` if this entry was chosen by conflict resolution.\r\n- `gaps`: only gaps where `gap_steps > 100` within the same epoch.\r\n- Entries with missing optional fields omit them from the JSON (do not include null).\r\n\r\n---\r\n\r\n## 3. Verify Output\r\n\r\n```json\r\n{\r\n"]
[5432.652544, "o", "  \"status\": \"ok\",\r\n  \"checkpoints\": [\r\n    {\r\n      \"file\": \"model_epoch1.mlck\",\r\n      \"valid\": true,\r\n      \"header_checksum_valid\": true,\r\n      \"tensor_checksums_valid\": true,\r\n      \"signature_valid\": null,\r\n      \"provenance_valid\": true,\r\n      \"issues\": []\r\n    },\r\n    {\r\n"]
[5432.652603, "o", "      \"file\": \"model_epoch3.mlck\",\r\n      \"valid\": false,\r\n      \"header_checksum_valid\": true,\r\n      \"tensor_checksums_valid\": false,\r\n      \"signature_valid\": true,\r\n      \"provenance_valid\": true,\r\n      \"issues\": [\r\n        {\"type\": \"tensor_checksum_mismatch\", \"detail\": \"encoder.layer2.weight\"}\r\n      ]\r\n    }\r\n  ],\r\n  \"summary\": {\r\n    \"total\": 3,\r\n"]
[5432.652667, "o", "    \"valid\": 2,\r\n    \"invalid\": 1\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `checkpoints`: sorted by `file` name lexicographically.\r\n- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.\r\n- `issues`: list of issue objects with `type` (string) and `detail` (string). For example, a tensor checksum mismatch appears as `{\"type\": \"tensor_checksum_mismatch\", \"detail\": \"<tensor_name>\"}`.\r\n- `valid`: `true` only if all applicable checks pass.\r\n\r\n"]
[5432.652727, "o", "---\r\n\r\n## 4. Detect Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"anomalies\": [\r\n    {\r\n      \"id\": \"ANOM-001\",\r\n      \"type\": \"gradient_spike\",\r\n      \"severity\": \"high\",\r\n      \"epoch\": 2,\r\n"]
[5432.652786, "o", "      \"step\": 3456,\r\n      \"details\": {\r\n        \"observed\": 15.3,\r\n        \"window_mean\": 1.2,\r\n        \"window_stddev\": 0.3,\r\n        \"z_score\": 47.0\r\n      },\r\n      \"evidence\": {\r\n        \"window_values\": [1.1, 1.3, 1.0, 1.2, 1.4]\r\n      },\r\n      \"source\": \"shard_002.jsonl\"\r\n    },\r\n"]
[5432.65285, "o", "    {\r\n      \"id\": \"ANOM-002\",\r\n      \"type\": \"tensor_checksum_mismatch\",\r\n      \"severity\": \"critical\",\r\n      \"details\": {\r\n        \"file\": \"model_epoch3.mlck\",\r\n        \"tensor_name\": \"encoder.layer2.weight\",\r\n        \"expected_checksum\": \"abcd1234...\",\r\n        \"actual_checksum\": \"efgh5678...\"\r\n      },\r\n      \"evidence\": {},\r\n      \"source\": \"model_epoch3.mlck\",\r\n      \"checkpoint\": \"model_epoch3.mlck\"\r\n"]
[5432.652907, "o", "    }\r\n  ],\r\n  \"summary\": {\r\n    \"total\": 5,\r\n    \"by_severity\": {\r\n      \"critical\": 1,\r\n      \"high\": 2,\r\n      \"medium\": 1,\r\n      \"low\": 1\r\n    },\r\n    \"by_type\": {"]
[5432.652994, "o", "\r\n      \"gradient_spike\": 1,\r\n      \"loss_divergence\": 1,\r\n      \"tensor_checksum_mismatch\": 1,\r\n      \"training_gap\": 1,\r\n      \"lr_anomaly\": 1\r\n    }\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.\r\n- `anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.\r\n- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.\r\n- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.\r\n"]
[5432.653059, "o", "- `evidence`: sibling of `id`, `type`, `severity`, `details`, and `source`; never nested inside `details`. Timeline-based anomalies include `window_values`, an array of up to 5 preceding metric values at the point of anomaly detection. `gradient_spike` uses preceding `grad_norm` values, `loss_divergence` uses preceding `loss` values, and other timeline-based anomalies may use an empty array when no meaningful preceding window is available. Checkpoint-based anomalies, such as `tensor_checksum_mismatch`, must have an empty evidence object: `{}`.\r\n- `source`: the artifact file where the anomaly was detected.\r\n- `epoch` and `step`: present only for timeline-based anomalies.\r\n- `checkpoint`: present when the anomaly is related to a specific checkpoint file; omitted for timeline-based anomalies that are not checkpoint-specific.\r\n- `summary`: reflects the filtered anomaly list when `--filter-severity` is supplied.\r\n- If no anomalies are detected, `anomalies` is an empty array.\r\n\r\n### Detect CSV Output\r\n"]
[5432.653128, "o", "\r\nWhen `--format csv` is used with `detect`, the command outputs CSV instead of JSON. The CSV header is exactly:\r\n\r\n```text\r\nid,type,severity,epoch,step,source,checkpoint\r\n```\r\n\r\nOne header row is followed by one data row per anomaly. Each data row has 7 comma-separated fields in that order. Leave `epoch`, `step`, or `checkpoint` empty when the anomaly does not have that field. Severity filtering with `--filter-severity LEVEL` applies before CSV output, so the rows reflect only the filtered anomaly list.\r\n\r\n"]
[5432.653191, "o", "---\r\n\r\n## 5. Lineage Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"nodes\": [\r\n    {\r\n      \"file\": \"model_epoch1.mlck\",\r\n      \"file_hash\": \"a1b2c3...\",\r\n      \"epoch\": 1,\r\n      \"global_step\": 5000,\r\n      \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n      \"parent_hash\": \"\",\r\n      \"is_root\": true,\r\n      \"is_leaf\": false,\r\n      \"is_orphan\": false\r\n    }\r\n  ],\r\n  \"edges\": [\r\n    {\r\n"]
[5432.65325, "o", "      \"from\": \"a1b2c3...\",\r\n      \"to\": \"d4e5f6...\",\r\n      \"from_file\": \"model_epoch1.mlck\",\r\n      \"to_file\": \"model_epoch2.mlck\"\r\n    }\r\n  ],\r\n  \"roots\": [\"a1b2c3...\"],\r\n  \"leaves\": [\"g7h8i9...\"],\r\n  \"orphans\": [],\r\n  \"topological_order\": [\"a1b2c3...\", \"d4e5f6...\", \"g7h8i9...\"],\r\n  \"cycles\": []\r\n}\r\n```\r\n\r\n"]
[5432.653314, "o", "**Field rules:**\r\n- `nodes`: sorted by `creation_timestamp` ascending.\r\n- `edges`: sorted by `from` hash then `to` hash lexicographically.\r\n- `roots`: file hashes of root nodes (no parent), sorted.\r\n- `leaves`: file hashes of leaf nodes (no children), sorted.\r\n- `orphans`: file hashes of orphan nodes (parent not found), sorted.\r\n- `topological_order`: valid topological sort of non-orphan nodes, ties broken by `creation_timestamp`.\r\n- `cycles`: if cycles exist, each cycle is a list of file hashes. Empty if DAG is valid.\r\n\r\n"]
[5432.653824, "o", "\u001b[?2004h"]
[5432.653883, "o", "root@n30009:/app# "]
[5432.940177, "i", "sed -n '1,680p' internal/forensics/detect.go\n"]
[5432.940545, "o", "sed -n '1,680p' internal/forensics/detect.go\r\n\u001b[?2004l\r"]
[5432.943532, "o", "package forensics\r\n\r\nimport (\r\n\t\"crypto/hmac\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n\t\"fmt\"\r\n"]
[5432.943643, "o", "\t\"hash/fnv\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"time\"\r\n\r\n\t\"mlforge/internal/checkpoint\"\r\n\t\"mlforge/internal/types\"\r\n)\r\n\r\nfunc loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {\r\n\tap, err := DiscoverArtifacts(dir)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar cps []*types.CheckpointFile\r\n\tfor _, p := range ap.Checkpoints {\r\n\t\tcf, err := checkpoint.Parse(p)\r\n\t\tif err != nil || cf == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tcps = append(cps, cf)"]
[5432.94373, "o", "\r\n\t}\r\n\tsort.Slice(cps, func(i, j int) bool {\r\n\t\treturn cps[i].Filename < cps[j].Filename\r\n\t})\r\n\treturn cps, nil\r\n}\r\n\r\n"]
[5432.943802, "o", "type DetectOutput struct {\r\n\tStatus    string          `json:\"status\"`\r\n\tAnomalies []types.Anomaly `json:\"anomalies\"`\r\n\tSummary   struct {\r\n\t\tTotal      int            `json:\"total\"`\r\n\t\tBySeverity map[string]int `json:\"by_severity\"`\r\n\t\tByType     map[string]int `json:\"by_type\"`\r\n\t} `json:\"summary\"`\r\n}\r\n\r\nfunc BuildDetect(dir string) (interface{}, error) {\r\n\treturn BuildDetectFiltered(dir, \"\")\r\n}\r\n\r\nfunc BuildDetectFiltered(dir, filterSeverity string) (DetectOutput, error) {\r\n\tvar out DetectOutput\r\n\tout.Status = \"ok\"\r\n\tvar anomalies []types.Anomaly\r\n\r\n"]
[5432.943868, "o", "\tentries, _, err := loadTimelineEntries(dir)\r\n\tif err == nil {\r\n\t\tmerged, _ := mergeTimeline(entries)\r\n\t\tsortTimeline(merged)\r\n\t\tanomalies = append(anomalies, detectTimelineAnomalies(merged)...)\r\n\t}\r\n\r\n\tcps, err := loadCheckpoints(dir)\r\n\tif err == nil {\r\n\t\tanomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\r\n\t}\r\n\r\n\tif filterSeverity != \"\" {\r\n"]
[5432.943973, "o", "\t\twantedRank, ok := severityRankValue(filterSeverity)\r\n\t\tif !ok {\r\n\t\t\treturn out, fmt.Errorf(\"invalid severity level %q: must be critical, high, medium, or low\", filterSeverity)\r\n\t\t}\r\n\t\tfiltered := anomalies[:0]\r\n\t\tfor _, a := range anomalies {\r\n\t\t\tif severityRank(a.Severity) <= wantedRank {\r\n\t\t\t\tfiltered = append(filtered, a)\r\n\t\t\t}\r\n"]
[5432.944033, "o", "\t\t}\r\n\t\tanomalies = filtered\r\n\t}\r\n\r\n\tfor i := range anomalies {\r\n\t\tanomalies[i].ID = fmt.Sprintf(\"ANOM-%03d\", i+1)\r\n\t}\r\n\tsortAnomalies(anomalies)\r\n\r\n\tout.Anomalies = anomalies\r\n\tif out.Anomalies == nil {\r\n\t\tout.Anomalies = []types.Anomaly{}\r\n\t}\r\n\tout.Summary.Total = len(anomalies)\r\n\tout.Summary.BySeverity = map[string]int{\"critical\": 0, \"high\": 0, \"medium\": 0, \"low\": 0}\r\n\tout.Summary.ByType = map[string]int{}\r\n"]
[5432.94409, "o", "\tfor _, a := range anomalies {\r\n\t\tout.Summary.BySeverity[a.Severity]++\r\n\t\tout.Summary.ByType[a.Type]++\r\n\t}\r\n\treturn out, nil\r\n}\r\n\r\nfunc severityRank(s string) int {\r\n\tswitch s {\r\n\tcase \"critical\":\r\n"]
[5432.944149, "o", "\t\treturn 0\r\n\tcase \"high\":\r\n\t\treturn 1\r\n\tcase \"medium\":\r\n\t\treturn 2\r\n\tdefault:\r\n\t\treturn 3\r\n\t}\r\n}\r\n\r\n"]
[5432.944208, "o", "func severityRankValue(s string) (int, bool) {\r\n\tswitch s {\r\n\tcase \"critical\":\r\n\t\treturn 0, true\r\n\tcase \"high\":\r\n\t\treturn 1, true\r\n\tcase \"medium\":\r\n\t\treturn 2, true\r\n\tcase \"low\":\r\n"]
[5432.944267, "o", "\t\treturn 3, true\r\n\tdefault:\r\n\t\treturn 4, false\r\n\t}\r\n}\r\n\r\nfunc detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tanomalies = append(anomalies, detectGradientSpikes(entries)...)\r\n\tanomalies = append(anomalies, detectLossDivergence(entries)...)\r\n"]
[5432.94433, "o", "\tanomalies = append(anomalies, detectLrAnomalies(entries)...)\r\n\tanomalies = append(anomalies, detectTrainingGaps(entries)...)\r\n\tanomalies = append(anomalies, detectMetricRegression(entries)...)\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar vals []float64\r\n\tvar idx []int\r\n\tfor i, e := range entries {\r\n\t\tif e.GradNorm != nil {\r\n\t\t\tvals = append(vals, *e.GradNorm)\r\n\t\t"]
[5432.9444, "o", "\tidx = append(idx, i)\r\n\t\t}\r\n\t}\r\n\tif len(vals) < 31 {\r\n\t\treturn nil\r\n\t}\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 30; i < len(vals); i++ {\r\n"]
[5432.944462, "o", "\t\twindow := vals[i-30 : i]\r\n\t\tmean := meanFloats(window)\r\n\t\tstd := stddevFloats(window, mean)\r\n\t\tobserved := vals[i]\r\n\t\tz := 0.0\r\n\t\tif std > 0 {\r\n\t\t\tz = (observed - mean) / std\r\n\t\t}\r\n\t\tif observed > mean+2.5*std && z > 2.5 {\r\n\t\t\tseverity := \"medium\"\r\n\t\t\tif z > 4.0 {\r\n"]
[5432.944518, "o", "\t\t\t\tseverity = \"high\"\r\n\t\t\t}\r\n\t\t\tep := entries[idx[i]].Epoch\r\n\t\t\tst := entries[idx[i]].Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"gradient_spike\",\r\n\t\t\t\tSeverity: severity,\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n"]
[5432.94458, "o", "\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"observed\":      observed,\r\n\t\t\t\t\t\"window_mean\":   mean,\r\n\t\t\t\t\t\"window_stddev\": std,\r\n\t\t\t\t\t\"z_score\":       z,\r\n\t\t\t\t},\r\n\t\t\t\tEvidence: map[string]interface{}{\"window_values\": lastValues(window, 5)},\r\n"]
[5432.944637, "o", "\t\t\t\tSource:   firstSource(entries[idx[i]]),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar lossEntries []int\r\n"]
[5432.944698, "o", "\tfor i, e := range entries {\r\n\t\tif e.Loss != nil {\r\n\t\t\tlossEntries = append(lossEntries, i)\r\n\t\t}\r\n\t}\r\n\tif len(lossEntries) < 51 {\r\n\t\treturn nil\r\n\t}\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 50; i < len(lossEntries); i++ {\r\n\t\tstartIdx := lossEntries[i-50]\r\n\t\t"]
[5432.94476, "o", "endIdx := lossEntries[i]\r\n\t\tstart := *entries[startIdx].Loss\r\n\t\tend := *entries[endIdx].Loss\r\n\t\tif math.Abs(start) <= 1e-6 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tratio := (end - start) / math.Abs(start)\r\n\t\tif ratio > 1.0 {\r\n\t\t\tseverity := \"high\"\r\n\t\t\tif ratio > 5.0 {\r\n"]
[5432.944816, "o", "\t\t\t\tseverity = \"critical\"\r\n\t\t\t}\r\n\t\t\tep := entries[endIdx].Epoch\r\n\t\t\tst := entries[endIdx].Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"loss_divergence\",\r\n\t\t\t\tSeverity: severity,\r\n"]
[5432.944878, "o", "\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"loss_start\":        start,\r\n\t\t\t\t\t\"loss_end\":          end,\r\n\t\t\t\t\t\"increase_ratio\":    ratio,\r\n\t\t\t\t\t\"window_start_step\": entries[startIdx].Step,\r\n\t\t\t\t\t\"window_end_step\":   entries[endIdx].Step,\r\n\t\t\t\t},\r\n\t\t\t\tEvidence: map[string]interface{}{\"window_values\": precedingLossValues(entries, lossEntries, i, 5)},\r\n\t\t\t\tSource:   firstSource(entries[endIdx]),"]
[5432.944956, "o", "\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n"]
[5432.945018, "o", "\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]\r\n\t\tif prev.Lr == nil || cur.Lr == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif *cur.Lr > *prev.Lr {\r\n\t\t\tif cur.Event == \"epoch_end\" {\r\n\t"]
[5432.945076, "o", "\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"lr_anomaly\",\r\n\t\t\t"]
[5432.945144, "o", "\tSeverity: \"medium\",\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"prev_lr\": *prev.Lr,\r\n\t\t\t\t\t\"curr_lr\": *cur.Lr,\r\n\t\t\t\t\t\"step\":    cur.Step,\r\n\t\t\t\t},\r\n"]
[5432.945224, "o", "\t\t\t\tEvidence: map[string]interface{}{\"window_values\": []float64{}},\r\n\t\t\t\tSource:   firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]\r\n\t\tif prev.Epoch != cur.Epoch {\r\n\t\t\tcontinue\r\n"]
[5432.945306, "o", "\t\t}\r\n\t\tprevT, err1 := time.Parse(time.RFC3339, prev.Ts)\r\n\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\r\n\t\tif err1 != nil || err2 != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tdiff := curT.Sub(prevT).Seconds()\r\n\t\tif diff > 3600 {\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n"]
[5432.945388, "o", "\t\t\t\tType:     \"training_gap\",\r\n\t\t\t\tSeverity: \"low\",\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"after_step\":  prev.Step,\r\n\t\t\t\t\t\"before_step\": cur.Step,\r\n\t\t\t\t\t\"after_ts\":    prev.Ts,\r\n\t\t\t\t\t\"before_ts\":   cur.Ts,\r\n\t\t\t\t\t\"gap_seconds\": diff,\r\n\t\t\t\t},\r\n\t\t\t\tEvidence: map[string]interface{}{\"window_values\": []float64{}},\r\n"]
[5432.945468, "o", "\t\t\t\tSource:   firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar cps []types.TimelineEntry\r\n\tfor _, e := range entries {\r\n\t\tif e.Event == \"checkpoint\" {\r\n\t\t\tcps = append(cps, e)\r\n\t"]
[5432.945558, "o", "\t}\r\n\t}\r\n\tsortTimeline(cps)\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(cps); i++ {\r\n\t\tprev := cps[i-1]\r\n\t\tcur := cps[i]\r\n\t\tif prev.Acc == nil || cur.Acc == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tdrop := *prev.Acc - *cur.Acc\r\n\t\tif drop > 0.15 {\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t"]
[5432.945641, "o", "\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"metric_regression\",\r\n\t\t\t\tSeverity: \"high\",\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"prev_acc\":        *prev.Acc,\r\n\t\t\t\t\t\"curr_acc\":        *cur.Acc,\r\n\t\t\t\t\t\"drop\":            drop,\r\n\t\t\t\t\t\"prev_checkpoint\": prev.Step,\r\n\t\t\t\t\t\"curr_checkpoint\": cur.Step,\r\n"]
[5432.945725, "o", "\t\t\t\t},\r\n\t\t\t\tEvidence: map[string]interface{}{\"window_values\": []float64{}},\r\n\t\t\t\tSource:   firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\thashSet := map[string]*types.CheckpointFile{}\r\n\tfor _, cf := range cps {\r\n\t\thashSet[cf.FileHash] = cf\r\n"]
[5432.945809, "o", "\t}\r\n\r\n\tfor _, cf := range cps {\r\n\t\traw, err := os.ReadFile(cf.Path)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif !cf.HeaderValid {\r\n\t\t\tstored := uint64(0)\r\n\t\t\tif len(raw) >= 56 {\r\n\t\t\t\tstored = binary.LittleEndian.Uint64(raw[48:56])\r\n\t\t\t}\r\n"]
[5432.945894, "o", "\t\t\th := fnv.New64a()\r\n\t\t\th.Write(raw[:48])\r\n\t\t\tcomputed := h.Sum64()\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"header_checksum_mismatch\",\r\n\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"file\":              cf.Filename,\r\n"]
[5432.945993, "o", "\t\t\t\t\t\"expected_checksum\": fmt.Sprintf(\"%016x\", stored),\r\n\t\t\t\t\t\"actual_checksum\":   fmt.Sprintf(\"%016x\", computed),\r\n\t\t\t\t},\r\n\t\t\t\tEvidence:   map[string]interface{}{},\r\n\t\t\t\tSource:     cf.Filename,\r\n\t\t\t\tCheckpoint: cf.Filename,\r\n\t\t\t})\r\n\t\t}\r\n\r\n\t\tfor _, t := range cf.Tensors {\r\n\t\t\tif !t.Valid {\r\n\t\t\t\tcomputed := sha256.Sum256(t.Data)\r\n\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n"]
[5432.946084, "o", "\t\t\t\t\tType:     \"tensor_checksum_mismatch\",\r\n\t\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":              cf.Filename,\r\n\t\t\t\t\t\t\"tensor_name\":       t.Name,\r\n\t\t\t\t\t\t\"expected_checksum\": hex.EncodeToString(t.Hash[:]),\r\n\t\t\t\t\t\t\"actual_checksum\":   hex.EncodeToString(computed[:]),\r\n\t\t\t\t\t},\r\n\t\t\t\t\tEvidence:   map[string]interface{}{},\r\n\t\t\t\t\tSource:     cf.Filename,\r\n\t\t\t\t\tCheckpoint: cf.Filename,\r\n"]
[5432.946168, "o", "\t\t\t\t})\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif cf.Signed {\r\n\t\t\tvalid, signer := signatureDetails(cf.Path)\r\n\t\t\tif !valid {\r\n\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\t\tType:     \"signature_invalid\",\r\n\t\t\t\t\tSeverity: \"critical\",\r\n\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":      cf.Filename,\r\n\t\t\t\t\t\t\"signer_id\": signer,\r\n\t\t"]
[5432.946254, "o", "\t\t\t\t\"valid\":     false,\r\n\t\t\t\t\t},\r\n\t\t\t\t\tEvidence:   map[string]interface{}{},\r\n\t\t\t\t\tSource:     cf.Filename,\r\n\t\t\t\t\tCheckpoint: cf.Filename,\r\n\t\t\t\t})\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n\t\t\t_, found := hashSet[cf.Provenance.ParentHash]\r\n\t\t\tif !found {\r\n\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\t\tType:     \"provenance_chain_break\",\r\n"]
[5432.946338, "o", "\t\t\t\t\tSeverity: \"high\",\r\n\t\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\t\"file\":        cf.Filename,\r\n\t\t\t\t\t\t\"parent_hash\": cf.Provenance.ParentHash,\r\n\t\t\t\t\t\t\"found\":       false,\r\n\t\t\t\t\t},\r\n\t\t\t\t\tEvidence:   map[string]interface{}{},\r\n\t\t\t\t\tSource:     cf.Filename,\r\n\t\t\t\t\tCheckpoint: cf.Filename,\r\n\t\t\t\t})\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[5432.946424, "o", "\tanomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {\r\n\tbyHash := map[string]*types.CheckpointFile{}\r\n\tfor _, cf := range cps {\r\n\t\tbyHash[cf.FileHash] = cf\r\n\t}\r\n\tchildren := map[string][]string{}\r\n\tfor _, cf := range cps {\r\n\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n\t\t\tif _, ok := byHash[cf.Provenance.ParentHash]; ok {\r\n\t\t\t\tchildren[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)\r\n\t\t\t}\r\n"]
[5432.946513, "o", "\t\t}\r\n\t}\r\n\r\n\tvar anomalies []types.Anomaly\r\n\tseen := map[string]bool{}\r\n\tfor _, cf := range cps {\r\n\t\tif cf.Provenance == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\troot := cf.FileHash\r\n\t\tfor root != \"\" {\r\n\t\t\tparent, ok := byHash[root]\r\n\t\t\tif !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == \"\" {\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t"]
[5432.946606, "o", "\troot = parent.Provenance.ParentHash\r\n\t\t}\r\n\t\tif seen[root] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tseen[root] = true\r\n\r\n\t\tchain := []string{}\r\n\t\tqueue := []string{root}\r\n\t\tvisited := map[string]bool{}\r\n\t\tfor len(queue) > 0 {\r\n\t\t\tcur := queue[0]\r\n\t\t\tqueue = queue[1:]\r\n\t\t\tif visited[cur] {\r\n"]
[5432.946691, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tvisited[cur] = true\r\n\t\t\tnode, ok := byHash[cur]\r\n\t\t\tif !ok || node == nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tchain = append(chain, node.Filename)\r\n\t\t\tqueue = append(queue, children[cur]...)\r\n\t\t}\r\n\t\tsort.Strings(chain)\r\n\r\n\t\thashes := map[string]struct{}{}\r\n\t\tfor _, h := range chain {\r\n\t\t\t"]
[5432.946776, "o", "if node, ok := byHashFile(cps, h); ok && node.Provenance != nil {\r\n\t\t\t\thashes[node.Provenance.DatasetHash] = struct{}{}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif len(hashes) > 1 {\r\n\t\t\tunique := make([]string, 0, len(hashes))\r\n\t\t\tfor h := range hashes {\r\n\t\t\t\tunique = append(unique, h)\r\n\t\t\t}\r\n\t\t\tsort.Strings(unique)\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"dataset_hash_inconsistency\",\r\n\t\t\t\tSeverity: \"high\",\r\n\t\t\t\tDetails: map[string]interface{}{\r\n"]
[5432.946863, "o", "\t\t\t\t\t\"files\":  chain,\r\n\t\t\t\t\t\"hashes\": unique,\r\n\t\t\t\t},\r\n\t\t\t\tEvidence: map[string]interface{}{},\r\n\t\t\t\tSource:   chain[0],\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {\r\n\tfor _, cf := range cps {\r\n"]
[5432.946961, "o", "\t\tif cf.Filename == file {\r\n\t\t\treturn cf, true\r\n\t\t}\r\n\t}\r\n\treturn nil, false\r\n}\r\n\r\nfunc signatureDetails(path string) (bool, string) {\r\n\traw, err := os.ReadFile(path)\r\n\tif err != nil || len(raw) < 56 {\r\n\t\treturn false, \"\"\r\n\t}\r\n\tsigOff := binary.LittleEndian.Uint64(raw[32:40])\r\n\tif sigOff == 0 || int(sigOff) >= len(raw) || int(sigOff)+5 > len(raw) {\r\n\t\t"]
[5432.94705, "o", "return false, \"\"\r\n\t}\r\n\toff := int(sigOff)\r\n\toff++ // algorithm\r\n\tsignerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n\tif off+signerLen+2 > len(raw) {\r\n\t\treturn false, \"\"\r\n\t}\r\n\tsignerID := string(raw[off : off+signerLen])\r\n\toff += signerLen\r\n\tsigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n\tif off+sigLen > len(raw) {\r\n\t\treturn false, signerID\r\n"]
[5432.947138, "o", "\t}\r\n\tstored := raw[off : off+sigLen]\r\n\tmac := hmac.New(sha256.New, []byte(signerID))\r\n\tmac.Write(raw[:sigOff])\r\n\texpected := mac.Sum(nil)\r\n\treturn hmac.Equal(expected, stored), signerID\r\n}\r\n\r\nfunc lastValues(v []float64, n int) []float64 {\r\n\tif len(v) > n {\r\n\t\tv = v[len(v)-n:]\r\n\t}\r\n\tif v == nil {\r\n\t\tv = []float64{}\r\n\t}\r\n\treturn v\r\n"]
[5432.947228, "o", "}\r\n\r\nfunc precedingLossValues(entries []types.TimelineEntry, indices []int, pos, n int) []float64 {\r\n\tvals := []float64{}\r\n\tstart := pos - n\r\n\tif start < 0 {\r\n\t\tstart = 0\r\n\t}\r\n\tfor j := start; j < pos; j++ {\r\n\t\tif j >= 0 && j < len(indices) && entries[indices[j]].Loss != nil {\r\n\t\t\tvals = append(vals, *entries[indices[j]].Loss)\r\n\t\t}\r\n\t}\r\n\treturn vals\r\n}\r\n\r\n"]
[5432.947316, "o", "func firstSource(e types.TimelineEntry) string {\r\n\tif len(e.Sources) > 0 {\r\n\t\treturn e.Sources[0]\r\n\t}\r\n\treturn \"\"\r\n}\r\n\r\nfunc meanFloats(v []float64) float64 {\r\n\tif len(v) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\ts := 0.0\r\n\tfor _, x := range v {\r\n\t\ts += x\r\n\t}\r\n\treturn s / float64(len(v))\r\n}\r\n"]
[5432.947405, "o", "\r\nfunc stddevFloats(v []float64, mean float64) float64 {\r\n\tif len(v) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\ts := 0.0\r\n\tfor _, x := range v {\r\n\t\td := x - mean\r\n\t\ts += d * d\r\n\t}\r\n\treturn math.Sqrt(s / float64(len(v)))\r\n}\r\n\r\nfunc sortAnomalies(a []types.Anomaly) {\r\n\trank := map[string]int{\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3}\r\n\tsort.Slice(a, func(i, j int) bool {\r\n"]
[5432.947491, "o", "\t\tri := rank[a[i].Severity]\r\n\t\trj := rank[a[j].Severity]\r\n\t\tif ri != rj {\r\n\t\t\treturn ri < rj\r\n\t\t}\r\n\t\tei := -1\r\n\t\tej := -1\r\n\t\tif a[i].Epoch != nil {\r\n\t\t\tei = *a[i].Epoch\r\n\t\t}\r\n\t\tej = -1\r\n\t\tif a[j].Epoch != nil {\r\n"]
[5432.947579, "o", "\t\t\tej = *a[j].Epoch\r\n\t\t}\r\n\t\tif ei != ej {\r\n\t\t\treturn ei < ej\r\n\t\t}\r\n\t\tsi := -1\r\n\t\tif a[i].Step != nil {\r\n\t\t\tsi = *a[i].Step\r\n\t\t}\r\n\t\tsj := -1\r\n\t\tif a[j].Step != nil {\r\n\t\t\tsj = *a[j].Step\r\n\t\t}\r\n\t"]
[5432.947662, "o", "\treturn si < sj\r\n\t})\r\n}\r\n"]
