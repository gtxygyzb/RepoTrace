[6191.910514, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tType:     \"\u001b[01;31m\u001b[Kloss_divergence\u001b[m\u001b[K\",\r\n"]
[6191.910794, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K569\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc precedingLossValues\u001b[m\u001b[K(entries []types.TimelineEntry, indices []int, pos, n int) []float64 {\r\n"]
