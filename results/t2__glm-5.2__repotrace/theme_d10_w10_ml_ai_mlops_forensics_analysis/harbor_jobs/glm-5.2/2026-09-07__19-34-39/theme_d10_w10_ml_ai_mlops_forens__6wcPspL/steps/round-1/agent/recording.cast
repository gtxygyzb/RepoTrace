[3318.491468, "o", "if old not in s:\r\n\u001b[?2004l\r"]
[3318.49153, "o", "\u001b[?2004h> "]
[3318.491829, "o", "    raise SystemExit('old diff example not found')\r\n\u001b[?2004l\r"]
[3318.49189, "o", "\u001b[?2004h> "]
[3318.492046, "o", "s = s.replace(old, new)\r\n\u001b[?2004l\r"]
[3318.492103, "o", "\u001b[?2004h> "]
[3318.492199, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
