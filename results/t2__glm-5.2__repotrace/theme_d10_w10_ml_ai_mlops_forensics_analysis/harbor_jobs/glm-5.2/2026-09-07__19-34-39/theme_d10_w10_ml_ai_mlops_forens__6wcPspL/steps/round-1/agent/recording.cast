[339.500323, "o", "     1\tpackage logparser\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n"]
[339.500458, "o", "     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"strings\"\r\n    10\t\r\n    11\t\t\"mlforge/internal/types\"\r\n    12\t)\r\n    13\t\r\n    14\t// RawEntry is the JSON structure of a single line in a .jsonl training log shard.\r\n    15\ttype RawEntry struct {\r\n    16\t\tTs       string   `json:\"ts\"`\r\n    17\t\tEpoch    int      `json:\"epoch\"`\r\n    18\t\tStep     int      `json:\"step\"`\r\n    19\t\tLoss     *float64 `json:\"loss,omitempty\"`\r\n    20\t\tLr       *float64 `json:\"lr,omitempty\"`\r\n    21\t\tGradNorm *float64 `json:\"grad_norm,omitempty\"`\r\n    22\t\tAcc      *float64 `json:\"acc,omitempty\"`\r\n    23\t\tEvent    string   `json:\"event,omitempty\"`\r\n"]
[339.500556, "o", "    24\t}\r\n    25\t\r\n    26\t// ShardInfo holds summary info about one parsed shard.\r\n    27\ttype ShardInfo struct {\r\n    28\t\tFile       string // base filename\r\n    29\t\tEntries    int\r\n    30\t\tMinStep    int\r\n    31\t\tMaxStep    int\r\n    32\t\tMinEpoch   int\r\n    33\t\tMaxEpoch   int\r\n    34\t\tMinTs      string\r\n    35\t\tMaxTs      string\r\n"]
[339.500629, "o", "    36\t}\r\n    37\t\r\n    38\t// ParseResult holds all entries from a directory of log shards.\r\n    39\ttype ParseResult struct {\r\n    40\t\tEntries []types.TimelineEntry\r\n    41\t\tShards  []ShardInfo\r\n    42\t}\r\n    43\t\r\n    44\t// ParseAll reads every .jsonl file in dir and returns all entries with source\r\n    45\t// annotations and per-shard summaries. Malformed JSON lines are silently skipped.\r\n    46\tfunc ParseAll(dir string) (*ParseResult, error) {\r\n"]
[339.500691, "o", "    47\t\tdirEntries, err := os.ReadDir(dir)\r\n    48\t\tif err != nil {\r\n    49\t\t\treturn nil, fmt.Errorf(\"logparser: read dir %s: %w\", dir, err)\r\n    50\t\t}\r\n    51\t\r\n    52\t\tresult := &ParseResult{}\r\n    53\t\r\n    54\t\tfor _, de := range dirEntries {\r\n    55\t\t\tif de.IsDir() || !strings.HasSuffix(strings.ToLower(de.Name()), \".jsonl\") {\r\n    56\t\t\t\tcontinue\r\n    57\t\t\t}"]
[339.500754, "o", "\r\n    58\t\t\tshard, entries, err := parseShard(filepath.Join(dir, de.Name()), de.Name())\r\n    59\t\t\tif err != nil {\r\n    60\t\t\t\treturn nil, err\r\n    61\t\t\t}\r\n    62\t\t\tresult.Shards = append(result.Shards, shard)\r\n    63\t\t\tresult.Entries = append(result.Entries, entries...)\r\n    64\t\t}\r\n    65\t\r\n    66\t\treturn result, nil\r\n    67"]
[339.50081, "o", "\t}\r\n    68\t\r\n    69\tfunc parseShard(path, filename string) (ShardInfo, []types.TimelineEntry, error) {\r\n    70\t\tf, err := os.Open(path)\r\n    71\t\tif err != nil {\r\n    72\t\t\treturn ShardInfo{}, nil, fmt.Errorf(\"logparser: open %s: %w\", path, err)\r\n    73\t\t}\r\n    74\t\tdefer f.Close()\r\n    75\t"]
[339.500868, "o", "\r\n    76\t\tinfo := ShardInfo{\r\n    77\t\t\tFile:     filename,\r\n    78\t\t\tMinStep:  1<<31 - 1,\r\n    79\t\t\tMaxStep:  -(1 << 31),\r\n    80\t\t\tMinEpoch: 1<<31 - 1,\r\n    81\t\t\tMaxEpoch: -(1 << 31),\r\n    82\t\t}\r\n    83\t\r\n    84"]
[339.500981, "o", "\t\tvar entries []types.TimelineEntry\r\n    85\t\tscanner := bufio.NewScanner(f)\r\n    86\t\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n    87\t\r\n    88\t\tfor scanner.Scan() {\r\n    89\t\t\tline := strings.TrimSpace(scanner.Text())\r\n"]
[339.501043, "o", "    90\t\t\tif line == \"\" {\r\n    91\t\t\t\tcontinue\r\n    92\t\t\t}\r\n    93\t\t\tvar raw RawEntry\r\n    94\t\t\tif err := json.Unmarshal([]byte(line), &raw); err != nil {\r\n    95\t\t\t\tcontinue // skip malformed lines\r\n    96\t\t\t}\r\n    97\t\r\n    98\t\t\tte := types.TimelineEntry{\r\n    99\t\t\t\tTs:       raw.Ts,\r\n   100\t\t\t\tEpoch:    raw.Epoch,\r\n   101\t\t\t\tStep:     raw.Step,\r\n   102\t\t\t\tLoss:     raw.Loss,\r\n   103\t\t\t\tLr:       raw.Lr,\r\n   104\t\t\t\tGradNorm: raw.GradNorm,\r\n   105\t\t\t\tAcc:      raw.Acc,\r\n   106\t\t\t\tEvent:    raw.Event,\r\n   107\t\t"]
[339.501106, "o", "\t\tSources:  []string{filename},\r\n   108\t\t\t}\r\n   109\t\t\tentries = append(entries, te)\r\n   110\t\r\n   111\t\t\tinfo.Entries++\r\n   112\t\t\tif raw.Step < info.MinStep {\r\n   113\t\t\t\tinfo.MinStep = raw.Step\r\n   114\t\t\t}\r\n"]
[339.501163, "o", "   115\t\t\tif raw.Step > info.MaxStep {\r\n   116\t\t\t\tinfo.MaxStep = raw.Step\r\n   117\t\t\t}\r\n   118\t\t\tif raw.Epoch < info.MinEpoch {\r\n   119\t\t\t\tinfo.MinEpoch = raw.Epoch\r\n   120\t\t\t}\r\n   121\t\t\tif raw.Epoch > info.MaxEpoch {\r\n   122\t\t\t\tinfo.MaxEpoch = raw.Epoch\r\n   123\t\t\t}\r\n"]
[339.501227, "o", "   124\t\t\tif info.MinTs == \"\" || raw.Ts < info.MinTs {\r\n   125\t\t\t\tinfo.MinTs = raw.Ts\r\n   126\t\t\t}\r\n   127\t\t\tif info.MaxTs == \"\" || raw.Ts > info.MaxTs {\r\n   128\t\t\t\tinfo.MaxTs = raw.Ts\r\n   129\t\t\t}\r\n   130\t\t}\r\n   131\t\r\n   132\t\treturn info, entries, nil\r\n   133\t}\r\n"]
