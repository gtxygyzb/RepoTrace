[1715.808219, "o", "\t\t\t\t\"window_end_step\":   entries[endIdx].Step,\r\ninternal/forensics/detect.go:240:\t\t\t\tType:     \"training_gap\",\r\ninternal/forensics/detect.go:249:\t\t\t\t\t\"gap_seconds\": diff,\r\ninternal/forensics/forensics.go:179:\tGapSteps   int    `json:\"gap_steps\"`\r\ninternal/forensics/forensics.go:191:\tGaps              []TimelineGap         `json:\"gaps\"`\r\ninternal/forensics/forensics.go:206:\tgaps := detectGaps(merged)\r\ninternal/forensics/forensics.go:212:\t\tGaps:              gaps,\r\ninternal/forensics/forensics.go:479:\t\tfloatPtrEqual(a.GradNorm, b.GradNorm) &&\r\ninternal/forensics/forensics.go:500:\tvar gaps []TimelineGap\r\ninternal/forensics/forensics.go:509:\t\t\tgaps = append(gaps, TimelineGap{\r\ninternal/forensics/forensics.go:519:\treturn gaps\r\n"]
