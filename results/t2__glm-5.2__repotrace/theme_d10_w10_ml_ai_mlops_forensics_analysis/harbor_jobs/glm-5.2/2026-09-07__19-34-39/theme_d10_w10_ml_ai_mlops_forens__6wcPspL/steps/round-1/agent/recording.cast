[7228.441743, "o", "     1\tpackage forensics\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/hmac\"\r\n     5\t\t\"crypto/sha256\"\r\n     6\t\t\"encoding/binary\"\r\n"]
[7228.441837, "o", "     7\t\t\"encoding/hex\"\r\n     8\t\t\"encoding/json\"\r\n     9\t\t\"fmt\"\r\n    10\t\t\"math\"\r\n    11\t\t\"os\"\r\n    12\t\t\"path/filepath\"\r\n    13\t\t\"sort\"\r\n    14\t\t\"strings\"\r\n    15\t\t\"time\"\r\n    16\t\r\n    17\t\t\"mlforge/internal/checkpoint\"\r\n    18\t\t\"mlforge/internal/logparser\"\r\n    19\t"]
[7228.4419, "o", "\t\"mlforge/internal/types\"\r\n    20\t)\r\n    21\t\r\n    22\ttype ArtifactPaths struct {\r\n    23\t\tCheckpoints []string\r\n    24\t\tLogs        []string\r\n    25\t\tConfigs     []string\r\n    26\t}\r\n"]
[7228.441961, "o", "    27\t\r\n    28\tfunc DiscoverArtifacts(dir string) (ArtifactPaths, error) {\r\n    29\t\tvar ap ArtifactPaths\r\n    30\t\terr := filepath.WalkDir(dir, func(path string, d os.DirEntry, err error) error {\r\n    31\t\t\tif err != nil {\r\n    32\t\t\t\treturn err\r\n    33\t\t\t}\r\n    34\t\t\tif d.IsDir() {\r\n"]
[7228.442017, "o", "    35\t\t\t\treturn nil\r\n    36\t\t\t}\r\n    37\t\t\tname := d.Name()\r\n    38\t\t\tlower := strings.ToLower(name)\r\n    39\t\t\tswitch {\r\n    40\t\t\tcase strings.HasSuffix(lower, \".mlck\"):\r\n    41\t\t\t\tap.Checkpoints = append(ap.Checkpoints, path)\r\n"]
[7228.442072, "o", "    42\t\t\tcase strings.HasSuffix(lower, \".jsonl\"):\r\n    43\t\t\t\tap.Logs = append(ap.Logs, path)\r\n    44\t\t\tcase strings.HasPrefix(name, \"config_\") && strings.HasSuffix(lower, \".json\"):\r\n    45\t\t\t\tap.Configs = append(ap.Configs, path)\r\n    46\t\t\t}\r\n    47\t\t\treturn nil\r\n    48\t\t})\r\n    49\t\tif err != nil {\r\n    50\t\t\treturn ap, err"]
[7228.442122, "o", "\r\n    51\t\t}\r\n    52\t\tsort.Strings(ap.Checkpoints)\r\n    53\t\tsort.Strings(ap.Logs)\r\n    54\t\tsort.Strings(ap.Configs)\r\n    55\t\treturn ap, nil\r\n    56\t}\r\n    57\t\r\n"]
[7228.442178, "o", "    58\ttype IngestCheckpoint struct {\r\n    59\t\tFile              string                 `json:\"file\"`\r\n    60\t\tFileHash          string                 `json:\"file_hash\"`\r\n    61\t\tVersion           uint32                 `json:\"version\"`\r\n    62\t\tNumTensors        uint32                 `json:\"num_tensors\"`\r\n    63\t\t"]
[7228.442232, "o", "NumMetadata       uint32                 `json:\"num_metadata\"`\r\n    64\t\tSigned            bool                   `json:\"signed\"`\r\n    65\t\tCreationTimestamp string                 `json:\"creation_timestamp\"`\r\n    66\t\tProvenance        map[string]interface{} `json:\"provenance\"`\r\n    67\t}\r\n    68\t\r\n    69\ttype IngestLogShard struct {\r\n    70\t\tFile       string   `json:\"file\"`\r\n    71\t\tEntries    int      `json:\"entries\"`\r\n"]
[7228.442287, "o", "    72\t\tStepRange  []int    `json:\"step_range\"`\r\n    73\t\tEpochRange []int    `json:\"epoch_range\"`\r\n    74\t\tTimeRange  []string `json:\"time_range\"`\r\n    75\t}\r\n    76\t\r\n    77\ttype IngestConfig struct {\r\n    78\t\tFile      string `json:\"file\"`\r\n    79\t\tModelName string `json:\"model_name\"`\r\n    80\t\tDataset   string `json:\"dataset\"`\r\n"]
[7228.442341, "o", "    81\t}\r\n    82\t\r\n    83\ttype IngestOutput struct {\r\n    84\t\tStatus      string `json:\"status\"`\r\n    85\t\tEvidenceDir string `json:\"evidence_dir\"`\r\n    86\t\tArtifacts   struct {\r\n    87\t\t\tCheckpoints []IngestCheckpoint `json:\"checkpoints\"`\r\n    88"]
[7228.442392, "o", "\t\t\tLogShards   []IngestLogShard   `json:\"log_shards\"`\r\n    89\t\t\tConfigs     []IngestConfig     `json:\"configs\"`\r\n    90\t\t} `json:\"artifacts\"`\r\n    91\t\tTotals struct {\r\n    92\t\t\tCheckpoints int `json:\"checkpoints\"`\r\n    93\t\t\tLogShards   int `json:\"log_shards\"`\r\n"]
[7228.442442, "o", "    94\t\t\tConfigs     int `json:\"configs\"`\r\n    95\t\t} `json:\"totals\"`\r\n    96\t}\r\n    97\t\r\n    98\tfunc BuildIngest(dir string) (interface{}, error) {\r\n    99\t\tap, err := DiscoverArtifacts(dir)\r\n   100\t\tif err != nil {\r\n   101\t\t\treturn nil, err\r\n"]
[7228.442492, "o", "   102\t\t}\r\n   103\t\tif len(ap.Checkpoints) == 0 && len(ap.Logs) == 0 && len(ap.Configs) == 0 {\r\n   104\t\t\treturn nil, fmt.Errorf(\"no recognizable artifacts found in %s\", dir)\r\n   105\t\t}\r\n   106\t\r\n   107\t\tvar out IngestOutput\r\n   108\t\tout.Status = \"ok\"\r\n   109"]
[7228.442544, "o", "\t\tout.EvidenceDir = dir\r\n   110\t\tout.Artifacts.Checkpoints = []IngestCheckpoint{}\r\n   111\t\tout.Artifacts.LogShards = []IngestLogShard{}\r\n   112\t\tout.Artifacts.Configs = []IngestConfig{}\r\n   113\t\r\n   114\t\tfor _, p := range ap.Checkpoints {\r\n   115\t\t\tcf, err := checkpoint.Parse(p)\r\n"]
[7228.442595, "o", "   116\t\t\tif err != nil || cf == nil {\r\n   117\t\t\t\tcontinue\r\n   118\t\t\t}\r\n   119\t\t\tic := IngestCheckpoint{\r\n   120\t\t\t\tFile:              cf.Filename,\r\n   121\t\t\t\tFileHash:          cf.FileHash,\r\n"]
[7228.442647, "o", "   122\t\t\t\tVersion:           cf.Version,\r\n   123\t\t\t\tNumTensors:        cf.NumTensors,\r\n   124\t\t\t\tNumMetadata:       cf.NumMetadataKeys,\r\n   125\t\t\t\tSigned:            cf.Signed,\r\n   126\t\t\t\tCreationTimestamp: unixToISO(cf.CreationTimestamp),\r\n   127\t\t\t\tProvenance:        provenanceToMap(cf.Provenance),\r\n"]
[7228.442701, "o", "   128\t\t\t}\r\n   129\t\t\tout.Artifacts.Checkpoints = append(out.Artifacts.Checkpoints, ic)\r\n   130\t\t}\r\n   131\t\tsort.Slice(out.Artifacts.Checkpoints, func(i, j int) bool {\r\n   132\t\t\treturn out.Artifacts.Checkpoints[i].CreationTimestamp < out.Artifacts.Checkpoints[j].CreationTimestamp\r\n   133\t\t})\r\n   134\t\r\n   135\t\tfor _, p := range ap.Logs {\r\n"]
[7228.44275, "o", "   136\t\t\tinfo, entries, err := parseShardRecursive(p)\r\n   137\t\t\tif err != nil {\r\n   138\t\t\t\tcontinue\r\n   139\t\t\t}\r\n   140\t\t\tshard := IngestLogShard{\r\n   141\t\t\t\tFile:    info.File,\r\n"]
[7228.442801, "o", "   142\t\t\t\tEntries: info.Entries,\r\n   143\t\t\t}\r\n   144\t\t\tif info.Entries > 0 {\r\n   145\t\t\t\tshard.StepRange = []int{info.MinStep, info.MaxStep}\r\n   146\t\t\t\tshard.EpochRange = []int{info.MinEpoch, info.MaxEpoch}\r\n"]
