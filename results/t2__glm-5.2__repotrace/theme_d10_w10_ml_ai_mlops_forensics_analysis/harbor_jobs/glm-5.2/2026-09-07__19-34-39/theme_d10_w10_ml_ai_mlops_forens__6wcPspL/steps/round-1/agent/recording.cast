[2810.351651, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n"]
[2810.351752, "o", "     7\t\t\"strings\"\r\n     8\t\r\n     9\t\t\"mlforge/internal/forensics\"\r\n    10\t)\r\n    11\t\r\n    12\tfunc main() {\r\n    13\t\t// --- Parse flags ---------------------------------------------------\r\n    14\t\tformat := \"json\"\r\n    15\t\tverbose := false\r\n    16\t\tvar positional []string\r\n    17\t\r\n    18\t\tfor _, arg := range os.Args[1:] {\r\n    19\t\t\tswitch {\r\n    20\t\t\tcase arg == \"--verbose\":\r\n    21\t\t\t\tverbose = true\r\n"]
[2810.351836, "o", "    22\t\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n    23\t\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n    24\t\t\tcase arg == \"--format\":\r\n    25\t\t\t// handled below as two-token flag\r\n    26\t\t\tdefault:\r\n    27\t\t\t\tpositional = append(positional, arg)\r\n    28\t\t\t}\r\n    29\t\t}\r\n    30\t\r\n    31\t\t// Handle \"--format json\" (two separate tokens)\r\n    32\t\tfor i := 1; i < len(os.Args)-1; i++ {\r\n"]
[2810.351926, "o", "    33\t\t\tif os.Args[i] == \"--format\" {\r\n    34\t\t\t\tformat = os.Args[i+1]\r\n    35\t\t\t\t// Remove the value from positional args\r\n    36\t\t\t\tfiltered := positional[:0]\r\n    37\t\t\t\tfor _, p := range positional {\r\n    38\t\t\t\t\tif p != os.Args[i+1] {\r\n    39\t\t\t\t\t\tfiltered = append(filtered, p)\r\n    40\t\t\t\t\t}\r\n    41\t\t\t\t}\r\n    42\t\t\t\tpositional = filtered\r\n    43\t\t\t\tbreak\r\n    44\t\t\t}\r\n    45\t\t}\r\n    46\t\r\n"]
[2810.352034, "o", "    47\t\tif format != \"json\" && format != \"text\" {\r\n    48\t\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json or text\\n\", format)\r\n    49\t\t\tos.Exit(1)\r\n    50\t\t}\r\n    51\t\r\n    52\t\t_ = verbose // reserved for diagnostic output\r\n    53\t\r\n    54\t\t// --- Validate positional args --------------------------------------\r\n    55\t\tif len(positional) < 2 {\r\n    56\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n    57\t\t\tos.Exit(1)\r\n    58\t\t}\r\n    59\t\r\n"]
[2810.352112, "o", "    60\t\tcmd := positional[0]\r\n    61\t\tdir := positional[1]\r\n    62\t\r\n    63\t\t// --- Route to command handler --------------------------------------\r\n    64\t\tvar result interface{}\r\n    65\t\tvar err error\r\n    66\t\r\n    67\t\tswitch cmd {\r\n    68\t\tcase \"ingest\":\r\n    69\t\t\tresult, err = forensics.BuildIngest(dir)\r\n    70"]
[2810.352196, "o", "\t\tcase \"timeline\":\r\n    71\t\t\tresult, err = forensics.BuildTimeline(dir)\r\n    72\t\tcase \"verify\":\r\n    73\t\t\tresult, err = forensics.BuildVerify(dir)\r\n    74\t\tcase \"detect\":\r\n    75\t\t\tresult, err = forensics.BuildDetect(dir)\r\n    76\t\tcase \"lineage\":\r\n    77\t\t\tresult, err = forensics.BuildLineage(dir)\r\n    78\t\tcase \"query\":\r\n    79\t\t\tif len(positional) < 3 {\r\n    80\t\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n    81\t\t\t\tos.Exit(1)\r\n"]
[2810.352268, "o", "    82\t\t\t}\r\n    83\t\t\tresult, err = forensics.BuildQuery(dir, positional[2])\r\n    84\t\tcase \"report\":\r\n    85\t\t\tresult, err = forensics.BuildReport(dir)\r\n    86\t\tdefault:\r\n    87\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n    88\t\t\tos.Exit(1)\r\n    89\t\t}\r\n    90\t\r\n    91\t\t// --- Output --------------------------------------------------------\r\n"]
[2810.352339, "o", "    92\t\tif err != nil {\r\n    93\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    94\t\t\tos.Exit(1)\r\n    95\t\t}\r\n    96\t\r\n    97\t\tif format == \"text\" {\r\n    98\t\t\tprintText(result)\r\n    99\t\t\treturn\r\n   100\t\t}\r\n   101\t\r\n"]
[2810.352428, "o", "   102\t\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n   103\t\tif marshalErr != nil {\r\n   104\t\t\tfmt.Fprintf(os.Stderr, \"error marshalling result: %v\\n\", marshalErr)\r\n   105\t\t\tos.Exit(1)\r\n   106\t\t}\r\n   107\t\tfmt.Println(string(out))\r\n   108\t}\r\n   109\t\r\n   110\tfunc printText(v interface{}) {\r\n   111\t\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n   112\t\tif err != nil {\r\n   113\t\t\tfmt.Fprintln(os.Stderr, \"error rendering text output\")\r\n   114\t\t\treturn\r\n   115"]
[2810.352508, "o", "\t\t}\r\n   116\t\tfmt.Println(string(b))\r\n   117\t}\r\n"]
