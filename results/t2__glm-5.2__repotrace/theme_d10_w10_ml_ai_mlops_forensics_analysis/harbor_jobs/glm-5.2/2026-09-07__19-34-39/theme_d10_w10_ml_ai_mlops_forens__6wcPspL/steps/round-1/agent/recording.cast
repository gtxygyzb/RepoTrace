[7406.779539, "o", "     9\t\r\n    10\t\t\"mlforge/internal/checkpoint\"\r\n    11\t\t\"mlforge/internal/types\"\r\n    12\t)\r\n    13\t\r\n    14\t// diffTensorResult describes one tensor in the diff output.\r\n    15\ttype diffTensorResult struct {\r\n    16\t\tName        string   `json:\"name\"`\r\n    17\t\tShapeMatch  bool     `json:\"shape_match\"`\r\n    18\t\tShapeA      []uint32 `json:\"shape_a\"`\r\n    19\t\tShapeB      []uint32 `json:\"shape_b\"`\r\n    20\t\tMaxAbsDiff  *float64 `json:\"max_abs_diff,omitempty\"`\r\n    21\t\tMeanAbsDiff *float64 `json:\"mean_abs_diff,omitempty\"`\r\n    22\t}\r\n    23\t\r\n    24\t// diffSummary summarizes tensor presence and shape compatibility.\r\n    25\ttype diffSummary struct {\r\n    26\t\tTotalTensorsA   int      `json:\"total_tensors_a\"`\r\n    27\t"]
[7406.779627, "o", "\tTotalTensorsB   int      `json:\"total_tensors_b\"`\r\n    28\t\tCommonTensors   int      `json:\"common_tensors\"`\r\n    29\t\tShapeMismatches int      `json:\"shape_mismatches\"`\r\n    30\t\tOnlyInA         []string `json:\"only_in_a\"`\r\n    31\t\tOnlyInB         []string `json:\"only_in_b\"`\r\n    32\t}\r\n    33\t\r\n    34\t// diffOutput is the JSON output for the diff command.\r\n    35\ttype diffOutput struct {\r\n    36\t\tStatus      string             `json:\"status\"`\r\n    37\t\tFileA       string             `json:\"file_a\"`\r\n"]
[7406.779696, "o", "    38\t\tFileB       string             `json:\"file_b\"`\r\n    39\t\tTensorDiffs []diffTensorResult `json:\"tensor_diffs\"`\r\n    40\t\tSummary     diffSummary        `json:\"summary\"`\r\n    41\t}\r\n    42\t\r\n    43\tconst float32Dtype byte = 0\r\n    44\t\r\n    45\t// BuildDiff compares two checkpoint files inside evidenceDir tensor by tensor.\r\n    46\tfunc BuildDiff(evidenceDir, file1, file2 string) (interface{}, error) {\r\n    47\t\tpathA := filepath.Join(evidenceDir, file1)\r\n    48\t\tpathB := filepath.Join(evidenceDir, file2)\r\n    49\t"]
[7406.779758, "o", "\r\n    50\t\tcfA, err := checkpoint.Parse(pathA)\r\n    51\t\tif err != nil {\r\n    52\t\t\treturn nil, fmt.Errorf(\"diff: %s: %w\", file1, err)\r\n    53\t\t}\r\n    54\t\tif cfA == nil {\r\n    55\t\t\treturn nil, fmt.Errorf(\"diff: %s: not found\", file1)\r\n    56\t\t}\r\n    57\t\t"]
[7406.779821, "o", "cfB, err := checkpoint.Parse(pathB)\r\n    58\t\tif err != nil {\r\n    59\t\t\treturn nil, fmt.Errorf(\"diff: %s: %w\", file2, err)\r\n    60\t\t}\r\n    61\t\tif cfB == nil {\r\n    62\t\t\treturn nil, fmt.Errorf(\"diff: %s: not found\", file2)\r\n    63\t\t}\r\n    64\t\r\n    65\t\ttensorsA := make(map[string]types.TensorInfo, len(cfA.Tensors))\r\n    66\t\tfor _, t := range cfA.Tensors {\r\n"]
[7406.779879, "o", "    67\t\t\ttensorsA[t.Name] = t\r\n    68\t\t}\r\n    69\t\ttensorsB := make(map[string]types.TensorInfo, len(cfB.Tensors))\r\n    70\t\tfor _, t := range cfB.Tensors {\r\n    71\t\t\ttensorsB[t.Name] = t\r\n    72\t\t}\r\n    73\t\r\n"]
[7406.779988, "o", "    74\t\tnames := map[string]struct{}{}\r\n    75\t\tfor name := range tensorsA {\r\n    76\t\t\tnames[name] = struct{}{}\r\n    77\t\t}\r\n    78\t\tfor name := range tensorsB {\r\n    79\t\t\tnames[name] = struct{}{}\r\n    80\t\t}\r\n    81\t\tsortedNames := make([]string, 0, len(names))\r\n    82\t\tfor name := range names {\r\n    83\t\t\tsortedNames = append(sortedNames, name)\r\n    84\t\t}\r\n    85\t\tsort.Strings(sortedNames)\r\n    86\t\r\n"]
[7406.780051, "o", "    87\t\tonlyInA := []string{}\r\n    88\t\tonlyInB := []string{}\r\n    89\t\tcommon := 0\r\n    90\t\tshapeMismatches := 0\r\n    91\t\ttensorDiffs := make([]diffTensorResult, 0, len(sortedNames))\r\n    92\t\r\n    93\t\tfor _, name := range sortedNames {\r\n    94\t\t\tta, okA := tensorsA[name]\r\n    95\t\t\ttb, okB := tensorsB[name]\r\n    96\t\r\n    97\t\t\tvar shapeA []uint32\r\n"]
[7406.780108, "o", "    98\t\t\tvar shapeB []uint32\r\n    99\t\t\tif okA {\r\n   100\t\t\t\tshapeA = ta.Shape\r\n   101\t\t\t}\r\n   102\t\t\tif okB {\r\n   103\t\t\t\tshapeB = tb.Shape\r\n"]
[7406.780166, "o", "   104\t\t\t}\r\n   105\t\r\n   106\t\t\tshapeMatch := okA && okB && shapesEqual(ta.Shape, tb.Shape)\r\n   107\t\t\tresult := diffTensorResult{\r\n   108\t\t\t\tName:       name,\r\n   109\t\t\t\tShapeMatch: shapeMatch,\r\n   110\t\t\t\tShapeA:     shapeA,\r\n   111\t\t\t\tShapeB:     shapeB,\r\n   112\t\t\t}\r\n   113"]
[7406.780278, "o", "\t\r\n   114\t\t\tif okA && okB {\r\n   115\t\t\t\tcommon++\r\n   116\t\t\t\tif !shapeMatch {\r\n   117\t\t\t\t\tshapeMismatches++\r\n   118\t\t\t\t} else {\r\n   119\t\t\t\t\tmaxDiff, meanDiff, err := float32DiffStats(ta, tb)\r\n   120\t\t\t\t\tif err != nil {\r\n"]
[7406.780408, "o", "   121\t\t\t\t\t\treturn nil, fmt.Errorf(\"diff: tensor %s: %w\", name, err)\r\n   122\t\t\t\t\t}\r\n   123\t\t\t\t\tresult.MaxAbsDiff = &maxDiff\r\n   124\t\t\t\t\tresult.MeanAbsDiff = &meanDiff\r\n   125\t\t\t\t}\r\n   126\t\t\t} else if okA {\r\n   127\t\t\t\tonlyInA = append(onlyInA, name)\r\n   128\t\t\t} else {\r\n   129\t\t\t\tonlyInB = append(onlyInB, name)\r\n   130\t\t\t}\r\n   131\t\r\n   132\t\t\ttensorDiffs = append(tensorDiffs, result)\r\n   133\t\t}\r\n   134\t\r\n   135\t\treturn diffOutput{\r\n   136\t\t\tStatus:      \"ok\",\r\n"]
[7406.780487, "o", "   137\t\t\tFileA:       filepath.Base(file1),\r\n   138\t\t\tFileB:       filepath.Base(file2),\r\n   139\t\t\tTensorDiffs: tensorDiffs,\r\n   140\t\t\tSummary: diffSummary{\r\n   141\t\t\t\tTotalTensorsA:   len(tensorsA),\r\n   142\t\t\t\tTotalTensorsB:   len(tensorsB),\r\n   143\t\t\t\tCommonTensors:   common,\r\n"]
[7406.780563, "o", "   144\t\t\t\tShapeMismatches: shapeMismatches,\r\n   145\t\t\t\tOnlyInA:         onlyInA,\r\n   146\t\t\t\tOnlyInB:         onlyInB,\r\n   147\t\t\t},\r\n   148\t\t}, nil\r\n   149\t}\r\n   150\t\r\n   151\tfunc shapesEqual(a, b []uint32) bool {\r\n   152\t\tif len(a) != len(b) {\r\n   153\t\t\treturn false\r\n   154\t\t}\r\n"]
[7406.780644, "o", "   155\t\tfor i := range a {\r\n   156\t\t\tif a[i] != b[i] {\r\n   157\t\t\t\treturn false\r\n   158\t\t\t}\r\n   159\t\t}\r\n   160\t\treturn true\r\n"]
