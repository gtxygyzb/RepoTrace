[3231.206325, "o", "go build -o /tmp/mlforge ./cmd/mlforge && /tmp/mlforge diff /tmp/nonexistent_evidence a.mlck b.mlck; echo \"exit=$?\"\r\n"]
[3232.106038, "i", "sed -n '40,100p' internal/forensics/diff.go\n"]
[3232.106307, "o", "sed -n '40,100p' internal/forensics/diff.go\r\n"]
