[143.541322, "i", "sed -n '1,220p' docs/output_schema.md\n"]
[143.541675, "o", "sed -n '1,220p' docs/output_schema.md\r\n\u001b[?2004l\r"]
[143.544224, "o", "# Output Schemas\r\n\r\nAll commands output JSON to stdout. This document defines the exact JSON structure for each command.\r\n\r\n---\r\n\r\n## 1. Ingest Output\r\n\r\n```json\r\n{\r\n"]
[143.544333, "o", "  \"status\": \"ok\",\r\n  \"evidence_dir\": \"/path/to/evidence\",\r\n  \"artifacts\": {\r\n    \"checkpoints\": [\r\n      {\r\n        \"file\": \"model_epoch1.mlck\",\r\n        \"file_hash\": \"a1b2c3...\",\r\n        \"version\": 1,\r\n        \"num_tensors\": 12,\r\n        \"num_metadata\": 3,\r\n        \"signed\": false,\r\n        \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n        \"provenance\": {\r\n          \"epoch\": 1,\r\n          \"global_step\": 5000,\r\n          \"framework\": \"PyTorch\",\r\n          \"framework_version\": \"2.1.0\",\r\n          \"parent_hash\": \"\"\r\n        }\r\n      }\r\n    ],\r\n    \"log_shards\": [\r\n      {\r\n        \"file\": \"shard_001.jsonl\",\r\n        \"entries\": 500,\r\n"]
[143.544434, "o", "        \"step_range\": [0, 5000],\r\n        \"epoch_range\": [0, 1],\r\n        \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-15T10:00:00Z\"]\r\n      }\r\n    ],\r\n    \"configs\": [\r\n      {\r\n        \"file\": \"config_train.json\",\r\n        \"model_name\": \"resnet50\",\r\n"]
[143.544511, "o", "        \"dataset\": \"imagenet-1k\"\r\n      }\r\n    ]\r\n  },\r\n  \"totals\": {\r\n    \"checkpoints\": 3,\r\n    \"log_shards\": 4,\r\n    \"configs\": 1\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `file_hash`: SHA-256 hex of the entire `.mlck` file content.\r\n- `checkpoints` array: sorted by `creation_timestamp` ascending.\r\n- `log_shards` array: sorted by `file` name lexicographically.\r\n- `configs` array: sorted by `file` name lexicographically.\r\n- `step_range`: `[min_step, max_step]` across all entries in the shard.\r\n- `epoch_range`: `[min_epoch, max_epoch]` across all entries.\r\n- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.\r\n\r\n---\r\n\r\n## 2. Timeline Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"total_entries\": 1200,\r\n  \"total_epochs\": 5,\r\n"]
[143.544593, "o", "  \"step_range\": [0, 50000],\r\n  \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-17T14:00:00Z\"],\r\n  \"conflicts_resolved\": 3,\r\n  \"gaps\": [\r\n    {\r\n      \"after_step\": 5000,\r\n      \"before_step\": 5200,\r\n      \"epoch\": 1,\r\n      \"gap_steps\": 200,\r\n      \"after_ts\": \"2024-01-15T10:00:00Z\",\r\n      \"before_ts\": \"2024-01-15T13:00:00Z\"\r\n    }\r\n  ],\r\n  \"entries\": [\r\n    {\r\n      \"ts\": \"2024-01-15T08:00:00Z\",\r\n      \"epoch\": 0,\r\n      \"step\": 0,\r\n"]
[143.544661, "o", "      \"loss\": 6.9078,\r\n      \"lr\": 0.001,\r\n      \"grad_norm\": 12.34,\r\n      \"acc\": 0.001,\r\n      \"event\": \"step\",\r\n      \"sources\": [\"shard_001.jsonl\"],\r\n      \"conflict\": false\r\n    }\r\n  ]\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `entries`: sorted by `(epoch ASC, step ASC)`.\r\n"]
[143.544734, "o", "- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.\r\n- `conflict`: `true` if this entry was chosen by conflict resolution.\r\n- `gaps`: only gaps where `gap_steps > 100` within the same epoch.\r\n- Entries with missing optional fields omit them from the JSON (do not include null).\r\n\r\n---\r\n\r\n## 3. Verify Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"checkpoints\": [\r\n    {\r\n      \"file\": \"model_epoch1.mlck\",\r\n      \"valid\": true,\r\n      \"header_checksum_valid\": true,\r\n      \"tensor_checksums_valid\": true,\r\n      \"signature_valid\": null,\r\n"]
[143.544808, "o", "      \"provenance_valid\": true,\r\n      \"issues\": []\r\n    },\r\n    {\r\n      \"file\": \"model_epoch3.mlck\",\r\n      \"valid\": false,\r\n      \"header_checksum_valid\": true,\r\n      \"tensor_checksums_valid\": false,\r\n      \"signature_valid\": true,\r\n      \"provenance_valid\": true,\r\n      \"issues\": [\r\n        \"tensor_checksum_mismatch:encoder.layer2.weight\"\r\n      ]\r\n    }\r\n  ],\r\n  \"summary\": {\r\n    \"total\": 3,\r\n"]
[143.544878, "o", "    \"valid\": 2,\r\n    \"invalid\": 1\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `checkpoints`: sorted by `file` name lexicographically.\r\n- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.\r\n- `issues`: list of human-readable issue descriptions. Format for tensor checksum mismatch: `\"tensor_checksum_mismatch:<tensor_name>\"`.\r\n- `valid`: `true` only if all applicable checks pass.\r\n\r\n---\r\n\r\n## 4. Detect Output\r\n\r\n"]
[143.545004, "o", "```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"anomalies\": [\r\n    {\r\n      \"id\": \"ANOM-001\",\r\n      \"type\": \"gradient_spike\",\r\n      \"severity\": \"high\",\r\n      \"epoch\": 2,\r\n      \"step\": 3456,\r\n      \"details\": {\r\n        \"observed\": 15.3,\r\n        \"window_mean\": 1.2,\r\n        \"window_stddev\": 0.3,\r\n        \"z_score\": 47.0\r\n      },\r\n      \"source\": \"shard_002.jsonl\"\r\n    },\r\n    {\r\n      \"id\": \"ANOM-002\",\r\n      \"type\": \"tensor_checksum_mismatch\",\r\n      \"severity\": \"critical\",\r\n      \"details\": {\r\n        \"file\": \"model_epoch3.mlck\",\r\n        \"tensor_name\": \"encoder.layer2.weight\",\r\n        \"expected_checksum\": \"abcd1234...\",\r\n"]
[143.545087, "o", "        \"actual_checksum\": \"efgh5678...\"\r\n      },\r\n      \"source\": \"model_epoch3.mlck\"\r\n    }\r\n  ],\r\n  \"summary\": {\r\n    \"total\": 5,\r\n    \"by_severity\": {\r\n      \"critical\": 1,\r\n      \"high\": 2,\r\n      \"medium\": 1,\r\n      \"low\": 1\r\n    },\r\n    \"by_type\": {\r\n      \"gradient_spike\": 1,\r\n      \"loss_divergence\": 1,\r\n      \"tensor_checksum_mismatch\": 1,\r\n      \"training_gap\": 1,\r\n      \"lr_anomaly\": 1\r\n"]
[143.545168, "o", "    }\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.\r\n- `anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.\r\n- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.\r\n- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.\r\n- `source`: the artifact file where the anomaly was detected.\r\n- `epoch` and `step`: present only for timeline-based anomalies.\r\n- If no anomalies are detected, `anomalies` is an empty array.\r\n\r\n---\r\n\r\n## 5. Lineage Output\r\n"]
[143.54567, "o", "\u001b[?2004h"]
[143.545738, "o", "root@n30009:/app# "]
[143.831315, "i", "sed -n '221,440p' docs/output_schema.md\n"]
[143.831654, "o", "sed -n '221,440p' docs/output_schema.md\r\n\u001b[?2004l\r"]
[143.834808, "o", "\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"nodes\": [\r\n    {\r\n      \"file\": \"model_epoch1.mlck\",\r\n      \"file_hash\": \"a1b2c3...\",\r\n      \"epoch\": 1,\r\n      \"global_step\": 5000,\r\n      \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n"]
[143.834902, "o", "      \"parent_hash\": \"\",\r\n      \"is_root\": true,\r\n      \"is_leaf\": false,\r\n      \"is_orphan\": false\r\n    }\r\n  ],\r\n  \"edges\": [\r\n    {\r\n      \"from\": \"a1b2c3...\",\r\n      \"to\": \"d4e5f6...\",\r\n      \"from_file\": \"model_epoch1.mlck\",\r\n      \"to_file\": \"model_epoch2.mlck\"\r\n    }\r\n  ],\r\n  \"roots\": [\"a1b2c3...\"],\r\n  \"leaves\": [\"g7h8i9...\"],\r\n  \"orphans\": [],\r\n"]
[143.835013, "o", "  \"topological_order\": [\"a1b2c3...\", \"d4e5f6...\", \"g7h8i9...\"],\r\n  \"cycles\": []\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `nodes`: sorted by `creation_timestamp` ascending.\r\n- `edges`: sorted by `from` hash then `to` hash lexicographically.\r\n- `roots`: file hashes of root nodes (no parent), sorted.\r\n- `leaves`: file hashes of leaf nodes (no children), sorted.\r\n- `orphans`: file hashes of orphan nodes (parent not found), sorted.\r\n- `topological_order`: valid topological sort of non-orphan nodes, ties broken by `creation_timestamp`.\r\n"]
[143.835103, "o", "- `cycles`: if cycles exist, each cycle is a list of file hashes. Empty if DAG is valid.\r\n\r\n---\r\n\r\n## 6. Report Output\r\n\r\n```json\r\n{\r\n  \"version\": \"1.0\",\r\n  \"generated_at\": \"2024-01-18T12:00:00Z\",\r\n  \"evidence_dir\": \"/path/to/evidence\",\r\n  \"ingest\": { ... },\r\n  \"timeline\": { ... },\r\n  \"verify\": { ... },\r\n  \"detect\": { ... },\r\n  \"lineage\": { ... }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n"]
[143.835182, "o", "- `version`: always `\"1.0\"`.\r\n- `generated_at`: ISO 8601 UTC timestamp of report generation.\r\n- Each section (`ingest`, `timeline`, `verify`, `detect`, `lineage`) contains the exact same JSON structure as the corresponding standalone command output.\r\n- The report runs all analyses; if any individual analysis encounters an error, that section contains `{\"status\": \"error\", \"message\": \"...\"}` and the report still completes.\r\n\r\n---\r\n\r\n## 7. Query Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"query\": \"loss > 1.0 AND epoch == 3\",\r\n  \"matches\": 42,\r\n"]
[143.835268, "o", "  \"entries\": [\r\n    {\r\n      \"ts\": \"2024-01-16T08:00:00Z\",\r\n      \"epoch\": 3,\r\n      \"step\": 15000,\r\n      \"loss\": 1.234,\r\n      \"lr\": 0.0001,\r\n      \"grad_norm\": 2.1,\r\n      \"acc\": 0.75,\r\n      \"event\": \"step\",\r\n      \"sources\": [\"shard_003.jsonl\"],\r\n      \"conflict\": false\r\n    }\r\n  ]\r\n}\r\n```\r\n\r\n**Field rules:**\r\n"]
[143.835357, "o", "- `entries`: matching timeline entries sorted by `(epoch ASC, step ASC)`.\r\n- `matches`: count of matching entries.\r\n- `query`: the original query string echoed back.\r\n"]
[143.83581, "o", "\u001b[?2004h"]
[143.835877, "o", "root@n30009:/app# "]
[144.116405, "i", "sed -n '1,260p' cmd/mlforge/main.go\n"]
[144.116716, "o", "sed -n '1,260p' cmd/mlforge/main.go\r\n\u001b[?2004l\r"]
[144.119807, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t"]
[144.120108, "o", "\"strings\"\r\n)\r\n\r\nfunc main() {\r\n\t// --- Parse flags ---------------------------------------------------\r\n\tformat := \"json\"\r\n\tverbose := false\r\n\tvar positional []string\r\n\r\n\tfor _, arg := range os.Args[1:] {\r\n\t\tswitch {\r\n\t\tcase arg == \"--verbose\":\r\n\t\t\tverbose = true\r\n\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n\t\tcase arg == \"--format\":\r\n\t\t\t// handled below as two-token flag\r\n\t\tdefault:\r\n\t\t\tpositional = append(positional, arg)\r\n\t\t}\r\n\t}\r\n\r\n\t// Handle \"--format json\" (two separate tokens)\r\n\tfor i := 1; i < len(os.Args)-1; i++ {\r\n\t\tif os.Args[i] == \"--format\" {\r\n\t\t\tformat = os.Args[i+1]\r\n\t\t\t// Remove the value from positional args\r\n\t\t\tfiltered := positional[:0]\r\n\t\t\tfor _, p := range positional {\r\n\t\t\t\tif p != os.Args[i+1] {\r\n\t\t\t\t\tfiltered = append(filtered, p)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tpositional = filtered\r\n\t\t\tbreak\r\n\t"]
[144.120216, "o", "\t}\r\n\t}\r\n\r\n\tif format != \"json\" && format != \"text\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json or text\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t_ = verbose // will be used by command implementations later\r\n\r\n\t// --- Validate positional args --------------------------------------\r\n\tif len(positional) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := positional[0]\r\n\tdir := positional[1]\r\n\r\n\t// --- Route to command handler --------------------------------------\r\n\tvar result interface{}\r\n\tvar err error\r\n\r\n\tswitch cmd {\r\n"]
[144.120306, "o", "\tcase \"ingest\":\r\n\t\tresult, err = buildIngest(dir)\r\n\tcase \"timeline\":\r\n\t\tresult, err = buildTimeline(dir)\r\n\tcase \"verify\":\r\n\t\tresult, err = buildVerify(dir)\r\n\tcase \"detect\":\r\n\t\tresult, err = buildDetect(dir)\r\n\tcase \"lineage\":\r\n\t\tresult, err = buildLineage(dir)\r\n\tcase \"query\":\r\n\t\tif len(positional) < 3 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n\t\t\tos.Exit(1)\r\n"]
[144.120375, "o", "\t\t}\r\n\t\tresult, err = buildQuery(dir, positional[2])\r\n\tcase \"report\":\r\n\t\tresult, err = buildReport(dir)\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t// --- Output --------------------------------------------------------\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[144.12044, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n\tif marshalErr != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error marshalling result: %v\\n\", marshalErr)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Println(string(out))\r\n}\r\n"]
[144.120514, "o", "\r\n// ---------------------------------------------------------------------------\r\n// Stub builder functions -- each will be replaced with a real implementation.\r\n// ---------------------------------------------------------------------------\r\n\r\nfunc buildIngest(dir string) (interface{}, error) {\r\n\treturn nil, fmt.Errorf(\"not implemented: ingest\")\r\n}\r\n\r\nfunc buildTimeline(dir string) (interface{}, error) {\r\n\treturn nil, fmt.Errorf(\"not implemented: timeline\")\r\n}\r\n\r\nfunc buildVerify(dir string) (interface{}, error) {\r\n\treturn nil, fmt.Errorf(\"not implemented: verify\")\r\n"]
[144.120583, "o", "}\r\n\r\nfunc buildDetect(dir string) (interface{}, error) {\r\n\treturn nil, fmt.Errorf(\"not implemented: detect\")\r\n}\r\n\r\nfunc buildLineage(dir string) (interface{}, error) {\r\n\treturn nil, fmt.Errorf(\"not implemented: lineage\")\r\n}\r\n\r\nfunc buildQuery(dir string, expr string) (interface{}, error) {\r\n\treturn nil, fmt.Errorf(\"not implemented: query\")\r\n}\r\n"]
[144.12065, "o", "\r\nfunc buildReport(dir string) (interface{}, error) {\r\n\treturn nil, fmt.Errorf(\"not implemented: report\")\r\n}\r\n"]
[144.121139, "o", "\u001b[?2004h"]
