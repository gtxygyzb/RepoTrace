[2755.483993, "o", "\u001b[35m\u001b[K./internal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn \u001b[01;31m\u001b[KbuildTimelineFromEntries\u001b[m\u001b[K(entries, shards), nil\r\n\u001b[35m\u001b[K./internal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KbuildTimelineFromEntries\u001b[m\u001b[K(entries []types.TimelineEntry, shards []logparser.ShardInfo) TimelineOutput {\r\n"]
[2755.48407, "o", "\u001b[35m\u001b[K./internal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmerged, conflicts := \u001b[01;31m\u001b[KmergeTimeline\u001b[m\u001b[K(entries)\r\n\u001b[35m\u001b[K./internal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KloadTimelineEntries\u001b[m\u001b[K(dir string) ([]types.TimelineEntry, []logparser.ShardInfo, error) {\r\n\u001b[35m\u001b[K./internal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KmergeTimeline\u001b[m\u001b[K(entries []types.TimelineEntry) ([]types.TimelineEntry, int) {\r\n"]
