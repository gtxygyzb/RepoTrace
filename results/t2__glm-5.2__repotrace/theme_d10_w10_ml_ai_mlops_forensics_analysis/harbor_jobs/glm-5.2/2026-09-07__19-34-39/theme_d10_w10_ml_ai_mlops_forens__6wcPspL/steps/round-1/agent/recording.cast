[7205.012542, "o", "\u001b[?2004hroot@n30009:/app# "]
[7205.295489, "i", "sed -n '1,260p' internal/types/types.go\n"]
[7205.295835, "o", "sed -n '1,260p' internal/types/types.go\r\n"]
[7205.295924, "o", "\u001b[?2004l\r"]
[7205.298879, "o", "package types\r\n\r\n// TimelineEntry represents one log entry from a JSONL shard.\r\ntype TimelineEntry struct {\r\n\tTs       string   `json:\"ts\"`\r\n\tEpoch    int      `json:\"epoch\"`\r\n\tStep     int      `json:\"step\"`\r\n"]
[7205.299005, "o", "\tLoss     *float64 `json:\"loss,omitempty\"`\r\n\tLr       *float64 `json:\"lr,omitempty\"`\r\n\tGradNorm *float64 `json:\"grad_norm,omitempty\"`\r\n\tAcc      *float64 `json:\"acc,omitempty\"`\r\n\tEvent    string   `json:\"event,omitempty\"`\r\n\tSources  []string `json:\"sources,omitempty\"`\r\n\tConflict bool     `json:\"conflict\"`\r\n}\r\n\r\n// Anomaly represents one detected anomaly in the detect command.\r\ntype Anomaly struct {\r\n\tID         string                 `json:\"id\"`\r\n\tType       string                 `json:\"type\"`\r\n\tSeverity   string                 `json:\"severity\"`\r\n\tEpoch      *int                   `json:\"epoch,omitempty\"`\r\n\tStep       *int                   `json:\"step,omitempty\"`\r\n\tDetails    map[string]interface{} `json:\"details,omitempty\"`\r\n\tEvidence   map[string]interface{} `json:\"evidence\"`\r\n\tSource     string                 `json:\"source,omitempty\"`\r\n\tCheckpoint string                 `json:\"checkpoint,omitempty\"`\r\n}\r\n\r\n"]
[7205.299076, "o", "// TensorInfo holds metadata for one tensor in a checkpoint.\r\ntype TensorInfo struct {\r\n\tName  string   `json:\"name\"`\r\n\tDtype byte     `json:\"dtype\"`\r\n\tShape []uint32 `json:\"shape\"`\r\n\tData  []byte   `json:\"-\"`\r\n\tHash  [32]byte `json:\"-\"` // Stored SHA-256\r\n\tValid bool     `json:\"valid\"`\r\n}\r\n\r\n// Provenance holds the provenance section data from an MLCK checkpoint.\r\ntype Provenance struct {"]
[7205.299157, "o", "\r\n\tGitCommit         string  `json:\"git_commit\"`\r\n\tDatasetHash       string  `json:\"dataset_hash\"` // hex-encoded raw bytes\r\n\tConfigHash        string  `json:\"config_hash\"`  // hex-encoded raw bytes\r\n\tTrainingTimestamp int64   `json:\"training_timestamp\"`\r\n\tTrainingDuration  float64 `json:\"training_duration\"`\r\n\tFramework         string  `json:\"framework\"`\r\n\tFrameworkVersion  string  `json:\"framework_version\"`\r\n\tEpoch             uint32  `json:\"epoch\"`\r\n\tGlobalStep        uint64  `json:\"global_step\"`\r\n\tLearningRate      float64 `json:\"learning_rate\"`\r\n\tParentHash        string  `json:\"parent_hash\"` // hex SHA-256 of parent file, empty if root\r\n}\r\n\r\n"]
[7205.299232, "o", "// CheckpointFile represents a parsed .mlck checkpoint.\r\ntype CheckpointFile struct {\r\n\tPath              string            `json:\"-\"`\r\n\tFilename          string            `json:\"-\"` // base filename\r\n\tVersion           uint32            `json:\"version\"`\r\n\tFlags             uint16            `json:\"-\"`\r\n\tNumTensors        uint32            `json:\"-\"`\r\n\tNumMetadataKeys   uint32            `json:\"-\"`\r\n\tCreationTimestamp int64             `json:\"-\"`         // unix seconds\r\n\tHeaderValid       bool              `json:\"-\"`         // header checksum valid?\r\n\tFileHash          string            `json:\"file_hash\"` // SHA-256 hex of entire file\r\n\tSigned            bool              `json:\"-\"`\r\n"]
[7205.299298, "o", "\tTensors           []TensorInfo      `json:\"tensors\"`\r\n\tMetadataMap       map[string]string `json:\"-\"` // key-value pairs from metadata section\r\n\tProvenance        *Provenance       `json:\"-\"`\r\n\tHasParent         bool              `json:\"has_parent\"`\r\n\tParentHex         string            `json:\"parent_hash\"` // same as Provenance.ParentHash\r\n}\r\n"]
[7205.299784, "o", "\u001b[?2004h"]
[7205.299853, "o", "root@n30009:/app# "]
[7205.586394, "i", "sed -n '1,260p' internal/forensics/forensics.go\n"]
[7205.586779, "o", "sed -n '1,260p' internal/forensics/forensics.go\r\n\u001b[?2004l\r"]
[7205.589878, "o", "package forensics\r\n\r\nimport (\r\n\t\"crypto/hmac\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"fmt\""]
[7205.59003, "o", "\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"mlforge/internal/checkpoint\"\r\n\t\"mlforge/internal/logparser\"\r\n\t\"mlforge/internal/types\"\r\n)\r\n\r\ntype ArtifactPaths struct {\r\n\tCheckpoints []string\r\n\tLogs        []string\r\n\tConfigs     []string\r\n}\r\n\r\nfunc DiscoverArtifacts(dir string) (ArtifactPaths, error) {\r\n\tvar ap ArtifactPaths\r\n\terr := filepath.WalkDir(dir, func(path string, d os.DirEntry, err error) error {\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n"]
[7205.590108, "o", "\t\t}\r\n\t\tif d.IsDir() {\r\n\t\t\treturn nil\r\n\t\t}\r\n\t\tname := d.Name()\r\n\t\tlower := strings.ToLower(name)\r\n\t\tswitch {\r\n\t\tcase strings.HasSuffix(lower, \".mlck\"):\r\n\t\t\tap.Checkpoints = append(ap.Checkpoints, path)\r\n\t\tcase strings.HasSuffix(lower, \".jsonl\"):\r\n\t\t\tap.Logs = append(ap.Logs, path)\r\n"]
[7205.590206, "o", "\t\tcase strings.HasPrefix(name, \"config_\") && strings.HasSuffix(lower, \".json\"):\r\n\t\t\tap.Configs = append(ap.Configs, path)\r\n\t\t}\r\n\t\treturn nil\r\n\t})\r\n\tif err != nil {\r\n\t\treturn ap, err\r\n\t}\r\n\tsort.Strings(ap.Checkpoints)\r\n\tsort.Strings(ap.Logs)\r\n\tsort.Strings(ap.Configs)\r\n\treturn ap, nil\r\n}\r\n\r\ntype IngestCheckpoint struct {\r\n\tFile              string                 `json:\"file\"`\r\n\tFileHash          string                 `json:\"file_hash\"`\r\n"]
[7205.590282, "o", "\tVersion           uint32                 `json:\"version\"`\r\n\tNumTensors        uint32                 `json:\"num_tensors\"`\r\n\tNumMetadata       uint32                 `json:\"num_metadata\"`\r\n\tSigned            bool                   `json:\"signed\"`\r\n\tCreationTimestamp string                 `json:\"creation_timestamp\"`\r\n\tProvenance        map[string]interface{} `json:\"provenance\"`\r\n}\r\n\r\ntype IngestLogShard struct {\r\n\tFile       string   `json:\"file\"`\r\n\tEntries    int      `json:\"entries\"`\r\n\tStepRange  []int    `json:\"step_range\"`\r\n\tEpochRange []int    `json:\"epoch_range\"`\r\n"]
[7205.59034, "o", "\tTimeRange  []string `json:\"time_range\"`\r\n}\r\n\r\ntype IngestConfig struct {\r\n\tFile      string `json:\"file\"`\r\n\tModelName string `json:\"model_name\"`\r\n\tDataset   string `json:\"dataset\"`\r\n}\r\n\r\ntype IngestOutput struct {\r\n\tStatus      string `json:\"status\"`\r\n"]
[7205.590398, "o", "\tEvidenceDir string `json:\"evidence_dir\"`\r\n\tArtifacts   struct {\r\n\t\tCheckpoints []IngestCheckpoint `json:\"checkpoints\"`\r\n\t\tLogShards   []IngestLogShard   `json:\"log_shards\"`\r\n\t\tConfigs     []IngestConfig     `json:\"configs\"`\r\n\t} `json:\"artifacts\"`\r\n\tTotals struct {\r\n\t\tCheckpoints int `json:\"checkpoints\"`\r\n\t\t"]
[7205.590451, "o", "LogShards   int `json:\"log_shards\"`\r\n\t\tConfigs     int `json:\"configs\"`\r\n\t} `json:\"totals\"`\r\n}\r\n\r\nfunc BuildIngest(dir string) (interface{}, error) {\r\n\tap, err := DiscoverArtifacts(dir)\r\n\tif err != nil {\r\n"]
[7205.590508, "o", "\t\treturn nil, err\r\n\t}\r\n\tif len(ap.Checkpoints) == 0 && len(ap.Logs) == 0 && len(ap.Configs) == 0 {\r\n\t\treturn nil, fmt.Errorf(\"no recognizable artifacts found in %s\", dir)\r\n\t}\r\n\r\n\tvar out IngestOutput\r\n\tout.Status = \"ok\"\r\n\tout.EvidenceDir = dir\r\n\tout.Artifacts.Checkpoints = []IngestCheckpoint{}\r\n\tout.Artifacts.LogShards = []IngestLogShard{}\r\n\tout.Artifacts.Configs = []IngestConfig{}\r\n"]
[7205.59056, "o", "\r\n\tfor _, p := range ap.Checkpoints {\r\n\t\tcf, err := checkpoint.Parse(p)\r\n\t\tif err != nil || cf == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tic := IngestCheckpoint{\r\n"]
[7205.590615, "o", "\t\t\tFile:              cf.Filename,\r\n\t\t\tFileHash:          cf.FileHash,\r\n\t\t\tVersion:           cf.Version,\r\n\t\t\tNumTensors:        cf.NumTensors,\r\n\t\t\tNumMetadata:       cf.NumMetadataKeys,\r\n\t\t\tSigned:            cf.Signed,\r\n\t\t\tCreationTimestamp: unixToISO(cf.CreationTimestamp),\r\n"]
[7205.590666, "o", "\t\t\tProvenance:        provenanceToMap(cf.Provenance),\r\n\t\t}\r\n\t\tout.Artifacts.Checkpoints = append(out.Artifacts.Checkpoints, ic)\r\n\t}\r\n\tsort.Slice(out.Artifacts.Checkpoints, func(i, j int) bool {\r\n\t\treturn out.Artifacts.Checkpoints[i].CreationTimestamp < out.Artifacts.Checkpoints[j].CreationTimestamp\r\n\t})\r\n\r\n\tfor _, p := range ap.Logs {\r\n"]
[7205.590716, "o", "\t\tinfo, entries, err := parseShardRecursive(p)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tshard := IngestLogShard{\r\n"]
[7205.590766, "o", "\t\t\tFile:    info.File,\r\n\t\t\tEntries: info.Entries,\r\n\t\t}\r\n\t\tif info.Entries > 0 {\r\n\t\t\tshard.StepRange = []int{info.MinStep, info.MaxStep}\r\n"]
[7205.590818, "o", "\t\t\tshard.EpochRange = []int{info.MinEpoch, info.MaxEpoch}\r\n\t\t\tif info.MinTs != \"\" || info.MaxTs != \"\" {\r\n\t\t\t\tshard.TimeRange = []string{info.MinTs, info.MaxTs}\r\n\t\t\t}\r\n\t\t}\r\n\t\t_ = entries\r\n\t\tout.Artifacts.LogShards = append(out.Artifacts.LogShards, shard)\r\n\t}\r\n\tsort.Slice(out.Artifacts.LogShards, func(i, j int) bool {\r\n"]
[7205.590868, "o", "\t\treturn out.Artifacts.LogShards[i].File < out.Artifacts.LogShards[j].File\r\n\t})\r\n\r\n\tfor _, p := range ap.Configs {\r\n\t\tcfg, err := readConfigSummary(p)\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t"]
[7205.59092, "o", "\t}\r\n\t\tout.Artifacts.Configs = append(out.Artifacts.Configs, cfg)\r\n\t}\r\n\tsort.Slice(out.Artifacts.Configs, func(i, j int) bool {\r\n\t\treturn out.Artifacts.Configs[i].File < out.Artifacts.Configs[j].File\r\n\t})\r\n\r\n\tout.Totals.Checkpoints = len(out.Artifacts.Checkpoints)\r\n"]
[7205.590978, "o", "\tout.Totals.LogShards = len(out.Artifacts.LogShards)\r\n\tout.Totals.Configs = len(out.Artifacts.Configs)\r\n\treturn out, nil\r\n}\r\n\r\ntype TimelineGap struct {\r\n"]
[7205.591032, "o", "\tAfterStep  int    `json:\"after_step\"`\r\n\tBeforeStep int    `json:\"before_step\"`\r\n\tEpoch      int    `json:\"epoch\"`\r\n\tGapSteps   int    `json:\"gap_steps\"`\r\n\tAfterTs    string `json:\"after_ts\"`\r\n\tBeforeTs   string `json:\"before_ts\"`\r\n}\r\n\r\ntype TimelineOutput struct {\r\n\t"]
[7205.591082, "o", "Status            string                `json:\"status\"`\r\n\tTotalEntries      int                   `json:\"total_entries\"`\r\n\tTotalEpochs       int                   `json:\"total_epochs\"`\r\n\tStepRange         []int                 `json:\"step_range\"`\r\n\tTimeRange         []string              `json:\"time_range\"`\r\n\tConflictsResolved int                   `json:\"conflicts_resolved\"`\r\n\tGaps              []TimelineGap         `json:\"gaps\"`\r\n"]
[7205.591135, "o", "\tEntries           []types.TimelineEntry `json:\"entries\"`\r\n}\r\n\r\nfunc BuildTimeline(dir string) (interface{}, error) {\r\n\tentries, shards, err := loadTimelineEntries(dir)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn buildTimelineFromEntries(entries, shards), nil\r\n"]
[7205.591186, "o", "}\r\n\r\nfunc buildTimelineFromEntries(entries []types.TimelineEntry, shards []logparser.ShardInfo) TimelineOutput {\r\n\tmerged, conflicts := mergeTimeline(entries)\r\n\tsortTimeline(merged)\r\n\tgaps := detectGaps(merged)\r\n\r\n\tout := TimelineOutput{\r\n\t\tStatus:            \"ok\",\r\n"]
[7205.591237, "o", "\t\tTotalEntries:      len(merged),\r\n\t\tConflictsResolved: conflicts,\r\n\t\tGaps:              gaps,\r\n\t\tEntries:           merged,\r\n\t}\r\n\tif len(merged) > 0 {\r\n\t\tminStep, maxStep := merged[0].Step, merged[0].Step\r\n"]
[7205.591287, "o", "\t\tminTs, maxTs := merged[0].Ts, merged[0].Ts\r\n\t\tepochSet := map[int]struct{}{}\r\n\t\tfor _, e := range merged {\r\n\t\t\tepochSet[e.Epoch] = struct{}{}\r\n\t\t\tif e.Step < minStep {\r\n\t\t\t\tminStep = e.Step\r\n"]
[7205.591336, "o", "\t\t\t}\r\n\t\t\tif e.Step > maxStep {\r\n\t\t\t\tmaxStep = e.Step\r\n\t\t\t}\r\n\t\t\tif e.Ts < minTs {\r\n\t\t\t\tminTs = e.Ts\r\n\t\t\t}\r\n\t"]
[7205.591387, "o", "\t\tif e.Ts > maxTs {\r\n\t\t\t\tmaxTs = e.Ts\r\n\t\t\t}\r\n\t\t}\r\n\t\tout.TotalEpochs = len(epochSet)\r\n\t\tout.StepRange = []int{minStep, maxStep}\r\n\t\tout.TimeRange = []string{minTs, maxTs}\r\n\t"]
[7205.591437, "o", "}\r\n\tif out.Gaps == nil {\r\n\t\tout.Gaps = []TimelineGap{}\r\n\t}\r\n\tif out.Entries == nil {\r\n\t\tout.Entries = []types.TimelineEntry{}\r\n\t}\r\n\treturn out\r\n"]
[7205.591488, "o", "}\r\n\r\ntype VerifyIssue struct {\r\n\tType   string `json:\"type\"`\r\n\tDetail string `json:\"detail\"`\r\n}\r\n\r\ntype VerifyCheckpoint struct {\r\n\tFile                 string        `json:\"file\"`\r\n\tValid                bool          `json:\"valid\"`\r\n\t"]
[7205.591538, "o", "HeaderChecksumValid  bool          `json:\"header_checksum_valid\"`\r\n\tTensorChecksumsValid bool          `json:\"tensor_checksums_valid\"`\r\n\tSignatureValid       *bool         `json:\"signature_valid\"`\r\n\tProvenanceValid      bool          `json:\"provenance_valid\"`\r\n\tIssues               []VerifyIssue `json:\"issues\"`\r\n}\r\n"]
[7205.59213, "o", "\u001b[?2004h"]
[7205.592201, "o", "root@n30009:/app# "]
[7205.876325, "i", "sed -n '1,220p' docs/output_schema.md\n"]
[7205.876642, "o", "sed -n '1,220p' docs/output_schema.md\r\n\u001b[?2004l\r"]
[7205.87966, "o", "# Output Schemas\r\n\r\nAll commands output JSON to stdout. This document defines the exact JSON structure for each command.\r\n\r\n---\r\n\r\n## 1. Ingest Output\r\n"]
[7205.879755, "o", "\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"evidence_dir\": \"/path/to/evidence\",\r\n  \"artifacts\": {\r\n    \"checkpoints\": [\r\n      {\r\n        \"file\": \"model_epoch1.mlck\",\r\n        \"file_hash\": \"a1b2c3...\",\r\n        \"version\": 1,\r\n        \"num_tensors\": 12,\r\n        \"num_metadata\": 3,\r\n        \"signed\": false,\r\n        \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n        \"provenance\": {\r\n          \"epoch\": 1,\r\n          \"global_step\": 5000,\r\n          \"framework\": \"PyTorch\",\r\n"]
[7205.879818, "o", "          \"framework_version\": \"2.1.0\",\r\n          \"parent_hash\": \"\"\r\n        }\r\n      }\r\n    ],\r\n    \"log_shards\": [\r\n      {\r\n        \"file\": \"shard_001.jsonl\",\r\n        \"entries\": 500,\r\n        \"step_range\": [0, 5000],\r\n        \"epoch_range\": [0, 1],\r\n        \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-15T10:00:00Z\"]\r\n      }\r\n    ],\r\n    \"configs\": [\r\n"]
[7205.879875, "o", "      {\r\n        \"file\": \"config_train.json\",\r\n        \"model_name\": \"resnet50\",\r\n        \"dataset\": \"imagenet-1k\"\r\n      }\r\n    ]\r\n  },\r\n  \"totals\": {\r\n    \"checkpoints\": 3,\r\n    \"log_shards\": 4,\r\n    \"configs\": 1\r\n"]
[7205.87993, "o", "  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `file_hash`: SHA-256 hex of the entire `.mlck` file content.\r\n- `checkpoints` array: sorted by `creation_timestamp` ascending.\r\n- `log_shards` array: sorted by `file` name lexicographically.\r\n- `configs` array: sorted by `file` name lexicographically.\r\n- `step_range`: `[min_step, max_step]` across all entries in the shard.\r\n"]
[7205.880032, "o", "- `epoch_range`: `[min_epoch, max_epoch]` across all entries.\r\n- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.\r\n\r\n---\r\n\r\n## 2. Timeline Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"total_entries\": 1200,\r\n  \"total_epochs\": 5,\r\n"]
[7205.880087, "o", "  \"step_range\": [0, 50000],\r\n  \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-17T14:00:00Z\"],\r\n  \"conflicts_resolved\": 3,\r\n  \"gaps\": [\r\n    {\r\n      \"after_step\": 5000,\r\n      \"before_step\": 5200,\r\n      \"epoch\": 1,\r\n      \"gap_steps\": 200,\r\n      \"after_ts\": \"2024-01-15T10:00:00Z\",\r\n      \"before_ts\": \"2024-01-15T13:00:00Z\"\r\n    }\r\n  ],\r\n  \"entries\": [\r\n    {\r\n      \"ts\": \"2024-01-15T08:00:00Z\",\r\n"]
[7205.880152, "o", "      \"epoch\": 0,\r\n      \"step\": 0,\r\n      \"loss\": 6.9078,\r\n      \"lr\": 0.001,\r\n      \"grad_norm\": 12.34,\r\n      \"acc\": 0.001,\r\n      \"event\": \"step\",\r\n      \"sources\": [\"shard_001.jsonl\"],\r\n      \"conflict\": false\r\n    }\r\n  ]\r\n}\r\n```\r\n"]
[7205.880214, "o", "\r\n**Field rules:**\r\n- `entries`: sorted by `(epoch ASC, step ASC)`.\r\n- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.\r\n- `conflict`: `true` if this entry was chosen by conflict resolution.\r\n- `gaps`: only gaps where `gap_steps > 100` within the same epoch.\r\n- Entries with missing optional fields omit them from the JSON (do not include null).\r\n\r\n---\r\n\r\n## 3. Verify Output\r\n\r\n```json\r\n"]
[7205.880269, "o", "{\r\n  \"status\": \"ok\",\r\n  \"checkpoints\": [\r\n    {\r\n      \"file\": \"model_epoch1.mlck\",\r\n      \"valid\": true,\r\n      \"header_checksum_valid\": true,\r\n      \"tensor_checksums_valid\": true,\r\n      \"signature_valid\": null,\r\n      \"provenance_valid\": true,\r\n      \"issues\": []\r\n    },\r\n    {\r\n"]
[7205.880322, "o", "      \"file\": \"model_epoch3.mlck\",\r\n      \"valid\": false,\r\n      \"header_checksum_valid\": true,\r\n      \"tensor_checksums_valid\": false,\r\n      \"signature_valid\": true,\r\n      \"provenance_valid\": true,\r\n      \"issues\": [\r\n        {\"type\": \"tensor_checksum_mismatch\", \"detail\": \"encoder.layer2.weight\"}\r\n      ]\r\n    }\r\n  ],\r\n  \"summary\": {\r\n"]
[7205.880371, "o", "    \"total\": 3,\r\n    \"valid\": 2,\r\n    \"invalid\": 1\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `checkpoints`: sorted by `file` name lexicographically.\r\n"]
[7205.880421, "o", "- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.\r\n- `issues`: list of issue objects with `type` (string) and `detail` (string). For example, a tensor checksum mismatch appears as `{\"type\": \"tensor_checksum_mismatch\", \"detail\": \"<tensor_name>\"}`.\r\n- `valid`: `true` only if all applicable checks pass.\r\n\r\n---\r\n\r\n## 4. Detect Output\r\n\r\n```json\r\n"]
[7205.880473, "o", "{\r\n  \"status\": \"ok\",\r\n  \"anomalies\": [\r\n    {\r\n      \"id\": \"ANOM-001\",\r\n      \"type\": \"gradient_spike\",\r\n      \"severity\": \"high\",\r\n      \"epoch\": 2,\r\n      \"step\": 3456,\r\n      \"details\": {\r\n        \"observed\": 15.3,\r\n        \"ewma_mean\": 1.2,\r\n"]
[7205.880524, "o", "        \"ewma_stddev\": 0.3,\r\n        \"z_score\": 47.0\r\n      },\r\n      \"evidence\": {\r\n        \"window_values\": [1.1, 1.3, 1.0, 1.2, 1.4]\r\n      },\r\n      \"source\": \"shard_002.jsonl\"\r\n    },\r\n    {\r\n      \"id\": \"ANOM-002\",\r\n      \"type\": \"tensor_checksum_mismatch\",\r\n"]
[7205.880578, "o", "      \"severity\": \"critical\",\r\n      \"details\": {\r\n        \"file\": \"model_epoch3.mlck\",\r\n        \"tensor_name\": \"encoder.layer2.weight\",\r\n        \"expected_checksum\": \"abcd1234...\",\r\n        \"actual_checksum\": \"efgh5678...\"\r\n      },\r\n      \"evidence\": {},\r\n      \"source\": \"model_epoch3.mlck\",\r\n      \"checkpoint\": \"model_epoch3.mlck\"\r\n    }\r\n"]
[7205.880629, "o", "  ],\r\n  \"summary\": {\r\n    \"total\": 5,\r\n    \"by_severity\": {\r\n      \"critical\": 1,\r\n      \"high\": 2,\r\n      \"medium\": 1,\r\n      \"info\": 1\r\n    },\r\n    \"by_type\": {\r\n"]
[7205.880682, "o", "      \"gradient_spike\": 1,\r\n      \"loss_divergence\": 1,\r\n      \"tensor_checksum_mismatch\": 1,\r\n      \"training_gap\": 1,\r\n      \"lr_anomaly\": 1\r\n    }\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n"]
[7205.880737, "o", "- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.\r\n- `anomalies`: sorted by severity (`critical` > `high` > `medium` > `low` > `info`), then `type` alphabetically, then `epoch` ascending, then `step` ascending.\r\n- Severity order is `critical` > `high` > `medium` > `low` > `info`. `--filter-severity LEVEL` returns anomalies at the specified severity level or above: `critical` returns only `critical`; `high` returns `critical` and `high`; `medium` returns `critical`, `high`, and `medium`; `low` returns `critical`, `high`, `medium`, and `low`; `info` returns all severities.\r\n- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.\r\n- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.\r\n- `evidence`: sibling of `id`, `type`, `severity`, `details`, and `source`; never nested inside `detail"]
[7205.88079, "o", "s`. Timeline-based anomalies include `window_values`, an array of up to 5 preceding metric values at the point of anomaly detection. `gradient_spike` uses preceding `grad_norm` values, `loss_divergence` uses preceding `loss` values, and other timeline-based anomalies may use an empty array when no meaningful preceding window is available. Checkpoint-based anomalies, such as `tensor_checksum_mismatch`, must have an empty evidence object: `{}`.\r\n"]
[7205.881284, "o", "\u001b[?2004h"]
[7205.88136, "o", "root@n30009:/app# "]
[7206.161638, "i", "sed -n '1,220p' docs/spec.md\n"]
[7206.161913, "o", "sed -n '1,220p' docs/spec.md\r\n"]
[7206.162024, "o", "\u001b[?2004l\r"]
[7206.164812, "o", "# mlforge - ML Model Artifact Forensics Engine\r\n\r\n## Overview\r\n\r\n"]
[7206.164909, "o", "`mlforge` is a command-line tool for forensic analysis of machine learning model artifacts. Given a directory of evidence (model checkpoints, training log shards, configuration files), mlforge reconstructs training timelines, detects anomalies, verifies artifact integrity, builds model lineage graphs, and produces evidence-backed forensic reports.\r\n\r\n## CLI Interface\r\n\r\nThe binary is built as `mlforge` and placed at `/app/mlforge` (or on `$PATH` after `go install`).\r\n\r\n```\r\nmlforge <command> <evidence-dir> [flags]\r\n```\r\n\r\n### Commands\r\n\r\n| Command | Description |\r\n|---------|-------------|\r\n| `ingest` | Scan evidence directory, index all artifacts, print summary to stdout |\r\n| `timeline` | Reconstruct unified training timeline from log shards |\r\n| `verify` | Verify integrity of all checkpoint files |\r\n| `detect` | Run anomaly detection across all evidence |\r\n| `lineage` | Build and output model lineage DAG |\r\n"]
[7206.164992, "o", "| `query` | Query the unified timeline with filter expressions |\r\n| `report` | Generate full forensic report combining all analyses |\r\n\r\n### Global Flags\r\n\r\n| Flag | Type | Default | Description |\r\n|------|------|---------|-------------|\r\n| `--format` | string | `json` | Output format: `json`, `text`, or `csv` (`csv` is supported only by `detect`) |\r\n| `--verbose` | bool | false | Enable verbose diagnostic output to stderr |\r\n\r\n### Command-Specific Behavior\r\n\r\n#### `ingest`\r\n"]
[7206.165053, "o", "\r\nScan `<evidence-dir>` recursively for:\r\n- `.mlck` files (model checkpoints)\r\n- `.jsonl` files (training log shards)\r\n- `.json` files matching `config_*.json` (training configurations)\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Ingest Output\".\r\n\r\nIf the evidence directory does not exist or contains no recognizable artifacts, exit with code 1 and print an error to stderr.\r\n\r\n#### `timeline`\r\n\r\n"]
[7206.165112, "o", "Parse all `.jsonl` log shards in `<evidence-dir>`, merge entries into a unified timeline.\r\n\r\n**Merge Rules** (detailed in `/app/docs/analysis_rules.md` section \"Timeline Reconstruction\"):\r\n- Entries are identified by `(epoch, step)` tuple\r\n- When multiple shards contain the same `(epoch, step)`, apply conflict resolution\r\n- Gaps in the step sequence are detected and reported\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Timeline Output\".\r\n\r\n#### `verify`\r\n\r\nFor each `.mlck` file in `<evidence-dir>`:\r\n"]
[7206.165167, "o", "1. Parse the file according to the MLCK format (see `/app/docs/formats.md`)\r\n2. Validate the header checksum\r\n3. Validate each tensor's SHA-256 data checksum\r\n4. If the file is signed (Flags bit 0), validate the HMAC-SHA256 signature\r\n5. Validate provenance fields are well-formed\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Verify Output\".\r\n\r\n#### `detect`\r\n\r\n"]
[7206.165226, "o", "Run all anomaly detection rules (defined in `/app/docs/analysis_rules.md`) across the evidence:\r\n- Timeline-based anomalies (from log shards)\r\n- Checkpoint integrity anomalies (from .mlck files)\r\n- Cross-artifact anomalies (correlating checkpoints with logs)\r\n\r\nEvery anomaly object includes a top-level `evidence` field. Timeline-based anomalies include `window_values` with up to 5 preceding metric values at the point of detection. `gradient_spike` uses preceding `grad_norm` values, `loss_divergence` uses preceding `loss` values, and other timeline-based anomalies may use an empty array when no meaningful preceding window is available. Checkpoint-based anomalies have an empty `evidence` object.\r\n\r\nDetect-specific flags:\r\n- `--format csv`: output CSV instead of JSON. The CSV header is exactly `id,type,severity,epoch,step,source,checkpoint`; one data row is emitted per anomaly. Leave `epoch`, `step`, or `checkpoint` empty when the anomaly does not have that field.\r\n"]
[7206.165285, "o", "- `--filter-severity LEVEL`: filter anomalies to show only those at the specified severity level or above. Severity order is `critical > high > medium > low > info`. For example, `--filter-severity high` shows only `critical` and `high` anomalies, while `--filter-severity critical` shows only `critical` anomalies. The returned JSON summary reflects the filtered anomaly list.\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Detect Output\".\r\n\r\n#### `lineage`\r\n\r\nBuild a directed acyclic graph of model checkpoint relationships using the `parent_hash` field from each checkpoint's provenance section.\r\n\r\n**Rules**:\r\n- Each checkpoint is a node identified by its SHA-256 file hash\r\n"]
[7206.165337, "o", "- An edge `A -> B` exists if B's `parent_hash` matches A's file hash\r\n- Root nodes have empty `parent_hash`\r\n- Orphan nodes reference a parent not present in the evidence set\r\n- If a cycle is detected, report it as an anomaly (the graph should be a DAG)\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Lineage Output\".\r\n\r\n#### `query`\r\n\r\n```\r\nmlforge query <evidence-dir> \"<expression>\"\r\n```\r\n\r\n"]
[7206.165388, "o", "Filter the unified timeline using the query expression language defined in `/app/docs/analysis_rules.md` section \"Query Language\".\r\n\r\nOutput (JSON to stdout): list of matching timeline entries.\r\n\r\n#### `diff`\r\n\r\n```\r\n"]
[7206.165442, "o", "mlforge diff <evidence-dir> <file1> <file2>\r\n```\r\n\r\nCompare two checkpoint files inside `<evidence-dir>` tensor by tensor and write JSON to stdout. `file1` and `file2` are checkpoint filenames relative to `<evidence-dir>`.\r\n\r\nFor every tensor name present in either file, include one entry in `tensor_diffs`, sorted by tensor name lexicographically. `max_abs_diff` and `mean_abs_diff` are included only when both files contain the tensor and their shapes match.\r\n\r\nIf either checkpoint filename does not exist under `<evidence-dir>`, exit non-zero and print an error to stderr.\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Diff Output\".\r\n\r\n"]
[7206.165509, "o", "#### `report`\r\n\r\nGenerate a comprehensive forensic report by running all analyses (ingest, timeline, verify, detect, lineage) and combining results.\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Report Output\".\r\n\r\n## Exit Codes\r\n\r\n| Code | Meaning |\r\n|------|---------|\r\n| 0 | Success |\r\n| 1 | Input error (missing directory, no artifacts, invalid arguments) |\r\n| 2 | Parse error (corrupt or unreadable artifact) |\r\n\r\n"]
[7206.165572, "o", "When a parse error occurs for individual artifacts within a batch operation (e.g., one corrupt checkpoint among several), the tool should continue processing remaining artifacts, report the error in the output, and exit with code 0. Exit code 2 is only for cases where the error prevents any meaningful output.\r\n\r\n## Build\r\n\r\n```bash\r\ncd /app && go build -o mlforge ./cmd/mlforge\r\n```\r\n\r\n## Cross-References\r\n\r\n- Binary formats: `/app/docs/formats.md`\r\n- Detection algorithms and query language: `/app/docs/analysis_rules.md`\r\n- JSON output schemas: `/app/docs/output_schema.md`\r\n"]
[7206.166082, "o", "\u001b[?2004h"]
[7206.166153, "o", "root@n30009:/app# "]
