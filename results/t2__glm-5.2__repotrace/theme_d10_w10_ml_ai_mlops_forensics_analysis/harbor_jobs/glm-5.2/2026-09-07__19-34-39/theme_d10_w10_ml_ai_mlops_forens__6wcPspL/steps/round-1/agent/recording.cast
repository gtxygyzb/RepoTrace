[1907.485862, "o", "     1\tpackage forensics\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/hmac\"\r\n     5\t\t"]
[1907.485976, "o", "\"crypto/sha256\"\r\n     6\t\t\"encoding/binary\"\r\n     7\t\t\"encoding/hex\"\r\n     8\t\t\"fmt\"\r\n     9\t\t\"hash/fnv\"\r\n    10\t\t\"math\"\r\n    11\t\t\"os\"\r\n    12\t\t\"sort\"\r\n    13\t\t\"time\"\r\n    14\t\r\n    15\t\t\"mlforge/internal/checkpoint\"\r\n    16\t\t\"mlforge/internal/types\"\r\n    17\t)\r\n    18\t\r\n    19\tfunc loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {\r\n    20\t"]
[1907.486063, "o", "\tap, err := DiscoverArtifacts(dir)\r\n    21\t\tif err != nil {\r\n    22\t\t\treturn nil, err\r\n    23\t\t}\r\n    24\t\tvar cps []*types.CheckpointFile\r\n    25\t\tfor _, p := range ap.Checkpoints {\r\n    26\t\t\tcf, err := checkpoint.Parse(p)\r\n    27\t\t\tif err != nil || cf == nil {\r\n    28\t\t\t\tcontinue\r\n    29\t\t\t}\r\n    30\t\t\tcps = append(cps, cf)\r\n    31\t\t}\r\n    32\t\t"]
[1907.486138, "o", "sort.Slice(cps, func(i, j int) bool {\r\n    33\t\t\treturn cps[i].Filename < cps[j].Filename\r\n    34\t\t})\r\n    35\t\treturn cps, nil\r\n    36\t}\r\n    37\t\r\n    38\ttype DetectOutput struct {\r\n"]
[1907.486201, "o", "    39\t\tStatus    string          `json:\"status\"`\r\n    40\t\tAnomalies []types.Anomaly `json:\"anomalies\"`\r\n    41\t\tSummary   struct {\r\n    42\t\t\tTotal      int            `json:\"total\"`\r\n    43\t\t\tBySeverity map[string]int `json:\"by_severity\"`\r\n    44\t\t\tByType     map[string]int `json:\"by_type\"`\r\n    45\t\t} `json:\"summary\"`\r\n    46\t}\r\n    47\t\r\n    48\tfunc BuildDetect(dir string) (interface{}, error) {\r\n    49\t\treturn buildDetectWithDir(dir)\r\n    50\t}\r\n    51\t\r\n    52\t"]
[1907.486266, "o", "func buildDetectWithDir(dir string) (DetectOutput, error) {\r\n    53\t\tvar out DetectOutput\r\n    54\t\tout.Status = \"ok\"\r\n    55\t\tvar anomalies []types.Anomaly\r\n    56\t\r\n    57\t\tentries, _, err := loadTimelineEntries(dir)\r\n    58\t\tif err == nil {\r\n    59\t\t\tmerged, _ := mergeTimeline(entries)\r\n    60\t\t\tsortTimeline(merged)\r\n    61\t"]
[1907.486328, "o", "\t\tanomalies = append(anomalies, detectTimelineAnomalies(merged)...)\r\n    62\t\t}\r\n    63\t\r\n    64\t\tcps, err := loadCheckpoints(dir)\r\n    65\t\tif err == nil {\r\n    66\t\t\tanomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\r\n    67\t\t}\r\n    68\t\r\n    69\t\t"]
[1907.486385, "o", "for i := range anomalies {\r\n    70\t\t\tanomalies[i].ID = fmt.Sprintf(\"ANOM-%03d\", i+1)\r\n    71\t\t}\r\n    72\t\tsortAnomalies(anomalies)\r\n    73\t\r\n    74\t\tout.Anomalies = anomalies\r\n    75\t\t"]
[1907.486441, "o", "if out.Anomalies == nil {\r\n    76\t\t\tout.Anomalies = []types.Anomaly{}\r\n    77\t\t}\r\n    78\t\tout.Summary.Total = len(anomalies)\r\n    79\t\tout.Summary.BySeverity = map[string]int{\"critical\": 0, \"high\": 0, \"medium\": 0, \"low\": 0}\r\n    80\t\tout.Summary.ByType = map[string]int{}\r\n    81\t\tfor _, a := range anomalies {\r\n    82\t\t\tout.Summary.BySeverity[a.Severity]++\r\n"]
[1907.486497, "o", "    83\t\t\tout.Summary.ByType[a.Type]++\r\n    84\t\t}\r\n    85\t\treturn out, nil\r\n    86\t}\r\n    87\t\r\n    88\tfunc detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n    89\t\tvar anomalies []types.Anomaly\r\n    90\t\tanomalies = append(anomalies, detectGradientSpikes(entries)...)\r\n    91\t\t"]
[1907.486556, "o", "anomalies = append(anomalies, detectLossDivergence(entries)...)\r\n    92\t\tanomalies = append(anomalies, detectLrAnomalies(entries)...)\r\n    93\t\tanomalies = append(anomalies, detectTrainingGaps(entries)...)\r\n    94\t\tanomalies = append(anomalies, detectMetricRegression(entries)...)\r\n    95\t\treturn anomalies\r\n    96\t}\r\n    97\t\r\n    98\tfunc detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n    99\t"]
[1907.486614, "o", "\tvar vals []float64\r\n   100\t\tvar idx []int\r\n   101\t\tfor i, e := range entries {\r\n   102\t\t\tif e.GradNorm != nil {\r\n   103\t\t\t\tvals = append(vals, *e.GradNorm)\r\n   104\t\t\t\tidx = append(idx, i)\r\n"]
[1907.486672, "o", "   105\t\t\t}\r\n   106\t\t}\r\n   107\t\tif len(vals) < 31 {\r\n   108\t\t\treturn nil\r\n   109\t\t}\r\n   110\t\tvar anomalies []types.Anomaly\r\n   111\t\tfor i := 30; i < len(vals); i++ {\r\n"]
[1907.486735, "o", "   112\t\t\twindow := vals[i-30 : i]\r\n   113\t\t\tmean := meanFloats(window)\r\n   114\t\t\tstd := stddevFloats(window, mean)\r\n   115\t\t\tobserved := vals[i]\r\n   116\t\t\tz := 0.0\r\n   117\t\t\tif std > 0 {\r\n   118\t\t\t\tz = (observed - mean) / std\r\n   119\t\t\t}\r\n"]
[1907.486791, "o", "   120\t\t\tif observed > mean+2.5*std && z > 2.5 {\r\n   121\t\t\t\tseverity := \"medium\"\r\n   122\t\t\t\tif z > 4.0 {\r\n   123\t\t\t\t\tseverity = \"high\"\r\n   124\t\t\t\t}\r\n   125\t\t\t\tep := entries[idx[i]].Epoch\r\n   126\t\t\t\t"]
[1907.486848, "o", "st := entries[idx[i]].Step\r\n   127\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   128\t\t\t\t\tType:     \"gradient_spike\",\r\n   129\t\t\t\t\tSeverity: severity,\r\n   130\t\t\t\t\tEpoch:    &ep,\r\n   131\t\t\t\t\tStep:     &st,\r\n   132\t\t\t\t\tDetails: map[string]interface{}{\r\n"]
[1907.48691, "o", "   133\t\t\t\t\t\t\"observed\":      observed,\r\n   134\t\t\t\t\t\t\"window_mean\":   mean,\r\n   135\t\t\t\t\t\t\"window_stddev\": std,\r\n   136\t\t\t\t\t\t\"z_score\":       z,\r\n   137\t\t\t\t\t},\r\n   138\t\t\t\t\tSource: firstSource(entries[idx[i]]),\r\n   139\t\t\t\t})\r\n   140\t\t\t}\r\n   141\t\t"]
[1907.486986, "o", "}\r\n   142\t\treturn anomalies\r\n   143\t}\r\n   144\t\r\n   145\tfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n   146\t\tvar lossEntries []int\r\n   147\t\tfor i, e := range entries {\r\n   148\t\t\tif e.Loss != nil {\r\n   149"]
[1907.487067, "o", "\t\t\t\tlossEntries = append(lossEntries, i)\r\n   150\t\t\t}\r\n   151\t\t}\r\n   152\t\tif len(lossEntries) < 51 {\r\n   153\t\t\treturn nil\r\n   154\t\t}\r\n   155\t\tvar anomalies []types.Anomaly\r\n   156\t\tfor i := 50; i < len(lossEntries); i++ {\r\n   157\t\t\tstartIdx := lossEntries[i-50]\r\n   158\t\t\tendIdx := lossEntries[i]\r\n   159\t\t\tstart := *entries[startIdx].Loss\r\n"]
[1907.487129, "o", "   160\t\t\tend := *entries[endIdx].Loss\r\n   161\t\t\tif math.Abs(start) <= 1e-6 {\r\n   162\t\t\t\tcontinue\r\n   163\t\t\t}\r\n   164\t\t\tratio := (end - start) / math.Abs(start)\r\n   165\t\t\tif ratio > 1.0 {\r\n   166\t\t\t\tseverity := \"high\"\r\n   167"]
[1907.487185, "o", "\t\t\t\tif ratio > 5.0 {\r\n   168\t\t\t\t\tseverity = \"critical\"\r\n   169\t\t\t\t}\r\n   170\t\t\t\tep := entries[endIdx].Epoch\r\n   171\t\t\t\tst := entries[endIdx].Step\r\n   172\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   173\t\t\t\t\tType:     \"loss_divergence\",\r\n   174\t\t\t\t\tSeverity: severity,\r\n"]
[1907.487242, "o", "   175\t\t\t\t\tEpoch:    &ep,\r\n   176\t\t\t\t\tStep:     &st,\r\n   177\t\t\t\t\tDetails: map[string]interface{}{\r\n   178\t\t\t\t\t\t\"loss_start\":        start,\r\n   179\t\t\t\t\t\t\"loss_end\":          end,\r\n   180\t\t\t\t\t\t\"increase_ratio\":    ratio,\r\n"]
[1907.487306, "o", "   181\t\t\t\t\t\t\"window_start_step\": entries[startIdx].Step,\r\n   182\t\t\t\t\t\t\"window_end_step\":   entries[endIdx].Step,\r\n   183\t\t\t\t\t},\r\n   184\t\t\t\t\tSource: firstSource(entries[endIdx]),\r\n   185\t\t\t\t})\r\n   186\t\t\t}\r\n   187\t\t}\r\n   188\t"]
[1907.487391, "o", "\treturn anomalies\r\n   189\t}\r\n   190\t\r\n   191\tfunc detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n   192\t\tvar anomalies []types.Anomaly\r\n   193\t\tfor i := 1; i < len(entries); i++ {\r\n   194\t\t\tprev := entries[i-1]\r\n   195\t\t\tcur := entries[i]\r\n   196\t\t\tif prev.Lr == nil || cur.Lr == nil {\r\n   197\t\t\t\tcontinue\r\n   198\t\t\t}\r\n   199\t\t\tif *cur.Lr > *prev.Lr {\r\n   200\t\t"]
[1907.487452, "o", "\t\tif cur.Event == \"epoch_end\" {\r\n   201\t\t\t\t\tcontinue\r\n   202\t\t\t\t}\r\n   203\t\t\t\tep := cur.Epoch\r\n   204\t\t\t\tst := cur.Step\r\n   205\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   206\t\t\t\t\tType:     \"lr_anomaly\",\r\n   207\t\t\t\t\tSeverity: \"medium\",\r\n   208\t\t\t\t\tEpoch:    &ep,\r\n   209\t\t\t\t\tStep:     &st,\r\n   210"]
[1907.487508, "o", "\t\t\t\t\tDetails: map[string]interface{}{\r\n   211\t\t\t\t\t\t\"prev_lr\": *prev.Lr,\r\n   212\t\t\t\t\t\t\"curr_lr\": *cur.Lr,\r\n   213\t\t\t\t\t\t\"step\":    cur.Step,\r\n   214\t\t\t\t\t},\r\n   215\t\t\t\t\tSource: firstSource(cur),\r\n"]
[1907.487564, "o", "   216\t\t\t\t})\r\n   217\t\t\t}\r\n   218\t\t}\r\n   219\t\treturn anomalies\r\n   220\t}\r\n   221\t\r\n   222\tfunc detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\r\n   223"]
[1907.487628, "o", "\t\tvar anomalies []types.Anomaly\r\n   224\t\tfor i := 1; i < len(entries); i++ {\r\n   225\t\t\tprev := entries[i-1]\r\n   226\t\t\tcur := entries[i]\r\n   227\t\t\tif prev.Epoch != cur.Epoch {\r\n   228\t\t\t\tcontinue\r\n   229\t\t\t}\r\n"]
[1907.487684, "o", "   230\t\t\tprevT, err1 := time.Parse(time.RFC3339, prev.Ts)\r\n   231\t\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\r\n   232\t\t\tif err1 != nil || err2 != nil {\r\n   233\t\t\t\tcontinue\r\n   234\t\t\t}\r\n   235\t\t\tdiff := curT.Sub(prevT).Seconds()\r\n   236\t\t\tif diff > 3600 {\r\n"]
[1907.487742, "o", "   237\t\t\t\tep := cur.Epoch\r\n   238\t\t\t\tst := cur.Step\r\n   239\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   240\t\t\t\t\tType:     \"training_gap\",\r\n   241\t\t\t\t\tSeverity: \"low\",\r\n   242\t\t\t\t\tEpoch:    &ep,\r\n   243\t\t\t\t\tStep:     &st,\r\n   244\t\t\t"]
[1907.487798, "o", "\t\tDetails: map[string]interface{}{\r\n   245\t\t\t\t\t\t\"after_step\":  prev.Step,\r\n   246\t\t\t\t\t\t\"before_step\": cur.Step,\r\n   247\t\t\t\t\t\t\"after_ts\":    prev.Ts,\r\n   248\t\t\t\t\t\t\"before_ts\":   cur.Ts,\r\n   249\t\t\t\t\t\t\"gap_seconds\": diff,\r\n   250\t\t\t\t\t},\r\n"]
[1907.487861, "o", "   251\t\t\t\t\tSource: firstSource(cur),\r\n   252\t\t\t\t})\r\n   253\t\t\t}\r\n   254\t\t}\r\n   255\t\treturn anomalies\r\n   256\t}\r\n   257\t\r\n   258\tfunc detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {\r\n   259\t\tvar cps []types.TimelineEntry\r\n   260\t\tfor _, e := range entries {"]
