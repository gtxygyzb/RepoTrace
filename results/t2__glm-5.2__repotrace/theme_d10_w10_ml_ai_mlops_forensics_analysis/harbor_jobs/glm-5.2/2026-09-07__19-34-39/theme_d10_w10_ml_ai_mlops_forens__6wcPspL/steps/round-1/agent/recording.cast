[7430.743174, "o", "\t\tQuery   string                `json:\"query\"`\r\n    15\t\tMatches int                   `json:\"matches\"`\r\n    16\t\tEntries []types.TimelineEntry `json:\"entries\"`\r\n    17\t}\r\n    18\t\r\n    19\tfunc BuildQuery(dir, expr string) (interface{}, error) {\r\n    20\t\tentries, _, err := loadTimelineEntries(dir)\r\n    21\t\tif err != nil {\r\n    22\t\t\treturn nil, err\r\n    23\t\t}\r\n    24\t\tmerged, _ := mergeTimeline(entries)\r\n    25\t\tsortTimeline(merged)\r\n    26\t\r\n    27\t\tq, err := parseQuery(expr)\r\n    28\t\tif err != nil {\r\n    29\t\t\treturn nil, err\r\n    30\t\t}\r\n    31\t\tmatches := []types.TimelineEntry{}\r\n    32\t\tfor _, e := range merged {\r\n    33\t\t\tif q.eval(e) {\r\n    34\t\t\t\tmatches = append(matches, e)\r\n    35\t\t\t}\r\n    36\t\t}\r\n    37\t\treturn QueryOutput{\r\n    38\t\t\tStatus:  \"ok\",\r\n    39\t\t\tQuery:   expr,\r\n    40\t\t\tMatches: len(matches),\r\n    41\t\t\tEntries: matches,\r\n    42\t\t}, nil\r\n    43\t}\r\n    44\t\r\n    45\ttype condition struct {\r\n    46\t\tfield string\r\n    47\t\top    string\r\n    48\t\tsval  string\r\n    49\t\tfval  float64\r\n    50\t\tisNum bool\r"]
[7430.743268, "o", "\n    51\t}\r\n    52\t\r\n    53\ttype node interface {\r\n    54\t\teval(e types.TimelineEntry) bool\r\n    55\t}\r\n    56\t\r\n    57\ttype conditionNode struct {\r\n    58\t\tcondition condition\r\n    59\t}\r\n    60\t\r\n    61\ttype notNode struct {\r\n    62\t\tchild node\r\n    63\t}\r\n    64\t\r\n    65\ttype andNode struct {\r\n    66"]
[7430.743334, "o", "\t\tchildren []node\r\n    67\t}\r\n    68\t\r\n    69\ttype orNode struct {\r\n    70\t\tchildren []node\r\n    71\t}\r\n    72\t\r\n    73\tfunc (c conditionNode) eval(e types.TimelineEntry) bool {\r\n    74\t\treturn c.condition.eval(e)\r\n    75\t}\r\n"]
