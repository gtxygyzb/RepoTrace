[7385.065231, "o", "    70\t\t\twantedRank, ok := severityRankValue(filterSeverity)\r\n    71\t\t\tif !ok {\r\n"]
[7385.065341, "o", "    72\t\t\t\treturn out, fmt.Errorf(\"invalid severity level %q: must be critical, high, medium, low, or info\", filterSeverity)\r\n    73\t\t\t}\r\n    74\t\t\tfiltered := anomalies[:0]\r\n    75\t\t\tfor _, a := range anomalies {\r\n    76\t\t\t\tif severityRank(a.Severity) <= wantedRank {\r\n    77\t\t\t\t\tfiltered = append(filtered, a)\r\n    78\t\t\t\t}\r\n    79\t\t\t}\r\n    80\t\t\tanomalies = filtered\r\n    81\t\t}\r\n    82\t\r\n    83\t\tfor i := range anomalies {\r\n    84\t\t\tanomalies[i].ID = fmt.Sprintf(\"ANOM-%03d\", i+1)\r\n    85\t\t}\r\n    86\t\t"]
[7385.065443, "o", "sortAnomalies(anomalies)\r\n    87\t\r\n    88\t\tout.Anomalies = anomalies\r\n    89\t\tif out.Anomalies == nil {\r\n    90\t\t\tout.Anomalies = []types.Anomaly{}\r\n    91\t\t}\r\n    92\t\tout.Summary.Total = len(anomalies)\r\n    93\t\tout.Summary.BySeverity = map[string]int{}\r\n    94\t\tout.Summary.ByType = map[string]int{}\r\n    95\t\tfor _, a := range anomalies {\r\n    96\t\t\tout.Summary.BySeverity[a.Severity]++\r\n    97\t\t\tout.Summary.ByType[a.Type]++\r\n    98\t\t}\r\n    99\t\treturn out, nil\r\n   100"]
[7385.065506, "o", "\t}\r\n   101\t\r\n   102\tfunc severityRank(s string) int {\r\n   103\t\tswitch s {\r\n   104\t\tcase \"critical\":\r\n   105\t\t\treturn 0\r\n   106\t\tcase \"high\":\r\n   107\t\t\treturn 1\r\n   108\t\tcase \"medium\":\r\n"]
[7385.065575, "o", "   109\t\t\treturn 2\r\n   110\t\tcase \"low\":\r\n   111\t\t\treturn 3\r\n   112\t\tcase \"info\":\r\n   113\t\t\treturn 4\r\n   114\t\t}\r\n   115\t\treturn 4\r\n   116\t}"]
[7385.065633, "o", "\r\n   117\t\r\n   118\tfunc severityRankValue(s string) (int, bool) {\r\n   119\t\tswitch s {\r\n   120\t\tcase \"critical\":\r\n   121\t\t\treturn 0, true\r\n   122\t\tcase \"high\":\r\n   123\t\t\treturn 1, true\r\n   124\t\tcase \"medium\":\r\n   125\t\t\treturn 2, true\r\n   126\t\tcase \"low\":\r\n   127\t\t\treturn 3, true\r\n   128\t\tcase \"info\":\r\n   129\t\t\treturn 4, true\r\n   130\t\t}\r\n"]
