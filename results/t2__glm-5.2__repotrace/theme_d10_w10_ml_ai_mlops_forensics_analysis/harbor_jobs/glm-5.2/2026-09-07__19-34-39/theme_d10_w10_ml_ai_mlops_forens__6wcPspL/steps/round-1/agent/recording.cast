[5454.086159, "o", "   140\tfunc detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n   141\t\tvar vals []float64\r\n   142\t\tvar idx []int\r\n   143\t\tfor i, e := range entries {\r\n   144\t\t\tif e.GradNorm != nil {\r\n"]
[5454.086304, "o", "   145\t\t\t\tvals = append(vals, *e.GradNorm)\r\n   146\t\t\t\tidx = append(idx, i)\r\n   147\t\t\t}\r\n   148\t\t}\r\n   149\t\tif len(vals) < 31 {\r\n   150\t"]
[5454.086405, "o", "\t\treturn nil\r\n   151\t\t}\r\n   152\t\tvar anomalies []types.Anomaly\r\n   153\t\tfor i := 30; i < len(vals); i++ {\r\n   154\t\t\twindow := vals[i-30 : i]\r\n   155\t\t\tmean := meanFloats(window)\r\n   156\t\t\tstd := stddevFloats(window, mean)\r\n   157\t\t\tobserved := vals[i]\r\n   158\t\t\tz := 0.0\r\n   159\t\t\tif std > 0 {\r\n   160\t\t\t\tz = (observed - mean) / std\r\n   161\t\t\t}\r\n   162\t\t\tif observed > mean+2.5*std && z > 2.5 {\r\n   163\t\t\t\tseverity := \"medium\"\r\n   164\t\t\t\tif z > 4.0 {\r\n   165\t\t\t\t\tseverity = \"high\"\r\n   166\t\t\t\t}\r\n   167\t\t\t\tep := entries[idx[i]].Epoch\r\n   168\t\t\t\tst := entries[idx[i]].Step\r\n   169\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   170\t\t\t\t\tType:     \"gradient_spike\",\r\n   171\t\t\t\t\tSeverity: severity,\r\n   172\t\t\t\t\tEpoch:    &ep,\r\n   173\t\t\t\t\tStep:     &st,\r\n   174\t\t\t\t\tDetails: map[string]interface{}{\r\n   175\t\t\t\t\t\t\"observed\":      observed,\r\n   176\t\t\t\t\t\t\"window_mean\":   mean,\r\n   177\t\t\t\t\t\t\"window_stddev\": std,\r\n   178\t\t\t\t\t\t\"z_score\":       z,\r\n"]
[5454.086509, "o", "   179\t\t\t\t\t},\r\n   180\t\t\t\t\tEvidence: map[string]interface{}{\"window_values\": lastValues(window, 5)},\r\n   181\t\t\t\t\tSource:   firstSource(entries[idx[i]]),\r\n   182\t\t\t\t})\r\n   183\t\t\t}\r\n   184\t\t}\r\n   185\t\treturn anomalies\r\n   186\t}\r\n   187\t\r\n   188\tfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n   189\t\tvar lossEntries []int\r\n   190\t\tfor i, e := range entries {\r\n   191\t\t\tif e.Loss != nil {\r\n"]
[5454.086597, "o", "   192\t\t\t\tlossEntries = append(lossEntries, i)\r\n   193\t\t\t}\r\n   194\t\t}\r\n   195\t\tif len(lossEntries) < 51 {\r\n   196\t\t\treturn nil\r\n   197\t\t}\r\n   198\t\tvar anomalies []types.Anomaly\r\n   199\t\tfor i := 50; i < len(lossEntries); i++ {\r\n   200\t\t\tstartIdx := lossEntries[i-50]\r\n   201\t\t\tendIdx := lossEntries[i]\r\n   202\t\t\tstart := *entries[startIdx].Loss\r\n   203\t\t\t"]
[5454.086683, "o", "end := *entries[endIdx].Loss\r\n   204\t\t\tif math.Abs(start) <= 1e-6 {\r\n   205\t\t\t\tcontinue\r\n   206\t\t\t}\r\n   207\t\t\tratio := (end - start) / math.Abs(start)\r\n   208\t\t\tif ratio > 1.0 {\r\n   209\t\t\t\tseverity := \"high\"\r\n   210\t\t\t\tif ratio > 5.0 {\r\n   211\t\t\t\t\tseverity = \"critical\"\r\n   212\t\t\t\t}\r\n"]
[5454.086768, "o", "   213\t\t\t\tep := entries[endIdx].Epoch\r\n   214\t\t\t\tst := entries[endIdx].Step\r\n   215\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   216\t\t\t\t\tType:     \"loss_divergence\",\r\n   217\t\t\t\t\tSeverity: severity,\r\n   218\t\t\t\t\tEpoch:    &ep,\r\n   219\t\t\t\t\tStep:     &st,\r\n   220\t\t\t\t\tDetails: map[string]interface{}{\r\n   221\t\t\t\t\t\t\"loss_start\":        start,\r\n   222\t\t\t\t\t\t\"loss_end\":          end,\r\n   223\t\t\t\t\t\t\"increase_ratio\":    ratio,\r\n"]
[5454.086861, "o", "   224\t\t\t\t\t\t\"window_start_step\": entries[startIdx].Step,\r\n   225\t\t\t\t\t\t\"window_end_step\":   entries[endIdx].Step,\r\n   226\t\t\t\t\t},\r\n   227\t\t\t\t\tEvidence: map[string]interface{}{\"window_values\": precedingLossValues(entries, lossEntries, i, 5)},\r\n   228\t\t\t\t\tSource:   firstSource(entries[endIdx]),\r\n   229\t\t\t\t})\r\n   230\t\t\t}\r\n   231\t\t}\r\n   232\t\treturn anomalies\r\n   233\t}\r\n   234\t\r\n   235\t"]
[5454.086978, "o", "func detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n   236\t\tvar anomalies []types.Anomaly\r\n   237\t\tfor i := 1; i < len(entries); i++ {\r\n   238\t\t\tprev := entries[i-1]\r\n   239\t\t\tcur := entries[i]\r\n   240\t\t\tif prev.Lr == nil || cur.Lr == nil {\r\n"]
[5454.08701, "o", "   241\t\t\t\tcontinue\r\n   242\t\t\t}\r\n   243\t\t\tif *cur.Lr > *prev.Lr {\r\n   244\t\t\t\tif cur.Event == \"epoch_end\" {\r\n   245\t\t\t\t\tcontinue\r\n   246\t\t\t\t}\r\n   247\t\t\t\tep := cur.Epoch\r\n   248\t\t\t\tst := cur.Step\r\n   249\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   250\t\t\t\t\tType:     \"lr_anomaly\",\r\n   251\t\t\t\t\tSeverity: \"medium\",\r\n   252\t\t\t\t\tEpoch:    &ep,\r\n"]
[5454.087108, "o", "   253\t\t\t\t\tStep:     &st,\r\n   254\t\t\t\t\tDetails: map[string]interface{}{\r\n   255\t\t\t\t\t\t\"prev_lr\": *prev.Lr,\r\n   256\t\t\t\t\t\t\"curr_lr\": *cur.Lr,\r\n   257\t\t\t\t\t\t\"step\":    cur.Step,\r\n   258\t\t\t\t\t},\r\n   259\t\t\t\t\tEvidence: map[string]interface{}{\"window_values\": []float64{}},\r\n   260\t\t\t\t\tSource:   firstSource(cur),\r\n   261\t\t\t\t})\r\n   262\t\t\t}\r\n   263\t\t}\r\n   264\t\treturn anomalies\r\n   265"]
[5454.087173, "o", "\t}\r\n   266\t\r\n   267\tfunc detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\r\n   268\t\tvar anomalies []types.Anomaly\r\n"]
[5454.087251, "o", "   269\t\tfor i := 1; i < len(entries); i++ {\r\n   270\t\t\tprev := entries[i-1]\r\n   271\t\t\tcur := entries[i]\r\n   272\t\t\tif prev.Epoch != cur.Epoch {\r\n   273\t\t\t\tcontinue\r\n   274\t\t\t}\r\n   275\t\t\tprevT, err1 := time.Parse(time.RFC3339, prev.Ts)\r\n   276\t\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\r\n   277\t\t\tif err1 != nil || err2 != nil {\r\n   278\t\t\t\tcontinue\r\n   279\t\t\t}\r\n   280\t\t\tdiff := curT.Sub(prevT).Seconds()\r\n   281\t\t\tif diff > 3600 {\r\n   282\t\t\t\tep := cur.Epoch\r\n   283\t\t\t\tst := cur.Step\r\n"]
[5454.087335, "o", "   284\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   285\t\t\t\t\tType:     \"training_gap\",\r\n   286\t\t\t\t\tSeverity: \"low\",\r\n   287\t\t\t\t\tEpoch:    &ep,\r\n   288\t\t\t\t\tStep:     &st,\r\n   289\t\t\t\t\tDetails: map[string]interface{}{\r\n   290\t\t\t\t\t\t\"after_step\":  prev.Step,\r\n   291\t\t\t\t\t\t\"before_step\": cur.Step,\r\n   292\t\t\t\t\t\t\"after_ts\":    prev.Ts,\r\n   293\t\t\t\t\t\t\"before_ts\":   cur.Ts,\r\n"]
[5454.087414, "o", "   294\t\t\t\t\t\t\"gap_seconds\": diff,\r\n   295\t\t\t\t\t},\r\n   296\t\t\t\t\tEvidence: map[string]interface{}{\"window_values\": []float64{}},\r\n   297\t\t\t\t\tSource:   firstSource(cur),\r\n   298\t\t\t\t})\r\n   299\t\t\t}\r\n   300\t\t}\r\n   301\t\treturn anomalies\r\n   302\t}\r\n   303\t\r\n"]
[5454.087478, "o", "   304\tfunc detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {\r\n   305\t\tvar cps []types.TimelineEntry\r\n   306\t\tfor _, e := range entries {\r\n   307\t\t\tif e.Event == \"checkpoint\" {\r\n   308\t\t\t\tcps = append(cps, e)\r\n   309\t\t\t}\r\n   310\t\t}\r\n   311\t\tsortTimeline(cps)\r\n   312\t\tvar anomalies []types.Anomaly\r\n   313\t\tfor i := 1; i < len(cps); i++ {\r\n"]
[5454.087538, "o", "   314\t\t\tprev := cps[i-1]\r\n   315\t\t\tcur := cps[i]\r\n   316\t\t\tif prev.Acc == nil || cur.Acc == nil {\r\n   317\t\t\t\tcontinue\r\n   318\t\t\t}\r\n   319\t\t\tdrop := *prev.Acc - *cur.Acc\r\n   320\t\t\tif drop > 0.15 {\r\n   321\t\t\t\tep := cur.Epoch\r\n   322\t\t\t\tst := cur.Step\r\n"]
[5454.087613, "o", "   323\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   324\t\t\t\t\tType:     \"metric_regression\",\r\n   325\t\t\t\t\tSeverity: \"high\",\r\n   326\t\t\t\t\tEpoch:    &ep,\r\n   327\t\t\t\t\tStep:     &st,\r\n   328\t\t\t\t\tDetails: map[string]interface{}{\r\n   329\t\t\t\t\t\t\"prev_acc\":        *prev.Acc,\r\n   330\t\t\t\t\t\t\"curr_acc\":        *cur.Acc,\r\n   331\t\t\t\t\t\t\"drop\":            drop,\r\n   332\t\t\t\t\t\t\"prev_checkpoint\": prev.Step,\r\n   333\t\t\t\t\t\t"]
[5454.087694, "o", "\"curr_checkpoint\": cur.Step,\r\n   334\t\t\t\t\t},\r\n   335\t\t\t\t\tEvidence: map[string]interface{}{\"window_values\": []float64{}},\r\n   336\t\t\t\t\tSource:   firstSource(cur),\r\n   337\t\t\t\t})\r\n   338\t\t\t}\r\n   339\t\t}\r\n   340\t\treturn anomalies\r\n   341\t}\r\n   342\t\r\n   343\tfunc detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {\r\n"]
[5454.087775, "o", "   344\t\tvar anomalies []types.Anomaly\r\n   345\t\thashSet := map[string]*types.CheckpointFile{}\r\n   346\t\tfor _, cf := range cps {\r\n   347\t\t\thashSet[cf.FileHash] = cf\r\n   348\t\t}\r\n   349\t\r\n   350\t\tfor _, cf := range cps {\r\n   351\t\t\traw, err := os.ReadFile(cf.Path)\r\n   352\t\t\tif err != nil {\r\n   353\t\t\t\tcontinue\r\n   354\t\t\t}\r\n"]
[5454.087851, "o", "   355\t\t\tif !cf.HeaderValid {\r\n   356\t\t\t\tstored := uint64(0)\r\n   357\t\t\t\tif len(raw) >= 56 {\r\n   358\t\t\t\t\tstored = binary.LittleEndian.Uint64(raw[48:56])\r\n   359\t\t\t\t}\r\n   360\t\t\t\th := fnv.New64a()\r\n   361\t\t\t\th.Write(raw[:48])\r\n   362\t\t\t\tcomputed := h.Sum64()\r\n   363\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   364\t\t\t\t\tType:     \"header_checksum_mismatch\",\r\n   365\t\t\t\t\tSeverity: \"critical\",\r\n   366\t\t\t\t\tDetails: map[string]interface{}{\r\n"]
[5454.08791, "o", "   367\t\t\t\t\t\t\"file\":              cf.Filename,\r\n   368\t\t\t\t\t\t\"expected_checksum\": fmt.Sprintf(\"%016x\", stored),\r\n   369\t\t\t\t\t\t\"actual_checksum\":   fmt.Sprintf(\"%016x\", computed),\r\n   370\t\t\t\t\t},\r\n   371\t\t\t\t\tEvidence:   map[string]interface{}{},\r\n   372\t\t\t\t\tSource:     cf.Filename,\r\n   373\t\t\t\t\tCheckpoint: cf.Filename,\r\n   374\t\t\t\t})\r\n   375\t\t\t}\r\n"]
[5454.087988, "o", "   376\t\r\n   377\t\t\tfor _, t := range cf.Tensors {\r\n   378\t\t\t\tif !t.Valid {\r\n   379\t\t\t\t\tcomputed := sha256.Sum256(t.Data)\r\n   380\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   381\t\t\t\t\t\tType:     \"tensor_checksum_mismatch\",\r\n   382\t\t\t\t\t\tSeverity: \"critical\",\r\n"]
[5454.088056, "o", "   383\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   384\t\t\t\t\t\t\t\"file\":              cf.Filename,\r\n   385\t\t\t\t\t\t\t\"tensor_name\":       t.Name,\r\n   386\t\t\t\t\t\t\t\"expected_checksum\": hex.EncodeToString(t.Hash[:]),\r\n   387\t\t\t\t\t\t\t\"actual_checksum\":   hex.EncodeToString(computed[:]),\r\n   388\t\t\t\t\t\t},\r\n   389\t\t\t\t\t\tEvidence:   map[string]interface{}{},\r\n   390\t\t\t\t\t\tSource:     cf.Filename,\r\n"]
