[3607.226104, "o", "   177\t\t}\r\n   178\t\tvar q query\r\n   179\t\tvar cur orGroup\r\n   180\t\ti := 0\r\n   181\t\tfor i < len(tokens) {\r\n   182\t\t\ttok := tokens[i]\r\n   183\t\t\tif tok == \"AND\" || tok == \"OR\" {\r\n   184\t\t\t\tif tok == \"OR\" {\r\n   185\t\t\t\t\tq.ors = append(q.ors, cur)\r\n   186\t\t\t\t\tcur = orGroup{}\r\n   187\t\t\t\t} else if tok == \"AND\" {\r\n   188\t\t\t\t\t// continue adding to cur\r\n   189\t\t\t\t}\r\n   190\t\t\t\ti++\r\n   191\t\t\t\tcontinue\r\n   192\t\t\t}\r\n"]
[3607.226202, "o", "   193\t\t\tcond, next, err := parseCondition(tokens, i)\r\n   194\t\t\tif err != nil {\r\n   195\t\t\t\treturn query{}, err\r\n   196\t\t\t}\r\n   197\t\t\tcur.ands = append(cur.ands, cond)\r\n   198\t\t\ti = next\r\n   199\t\t}\r\n   200\t\tif len(cur.ands) > 0 || len(q.ors) == 0 {\r\n   201\t\t\tq.ors = append(q.ors, cur)\r\n   202\t\t}\r\n   203\t\tif len(q.ors) == 0 || len(q.ors[0].ands) == 0 {\r\n   204\t\t\treturn query{}, fmt.Errorf(\"empty query\")\r\n   205\t\t}\r\n   206\t\treturn q, nil\r\n"]
[3607.226304, "o", "   207\t}\r\n   208\t\r\n   209\tfunc parseCondition(tokens []string, i int) (condition, int, error) {\r\n   210\t\tif i+2 >= len(tokens) {\r\n   211\t\t\treturn condition{}, i, fmt.Errorf(\"invalid query syntax\")\r\n   212\t\t}\r\n   213\t\tfield := tokens[i]\r\n   214\t\top := tokens[i+1]\r\n   215\t\tvalueTok := tokens[i+2]\r\n   216\t\r\n   217\t\tvalidFields := map[string]bool{\"step\": true, \"epoch\": true, \"loss\": true, \"lr\": true, \"grad_norm\": true, \"acc\": true, \"event\": true, \"ts\": true}\r\n   218\t\tif !validFields[field] {\r\n   219\t\t\treturn condition{}, i, fmt.Errorf(\"unknown field: %s\", field)\r\n"]
[3607.226388, "o", "   220\t\t}\r\n   221\t\tvalidOps := map[string]bool{\">\": true, \"<\": true, \">=\": true, \"<=\": true, \"==\": true, \"!=\": true}\r\n   222\t\tif !validOps[op] {\r\n   223\t\t\treturn condition{}, i, fmt.Errorf(\"invalid operator: %s\", op)\r\n   224\t\t}\r\n   225\t\r\n   226\t\tc := condition{field: field, op: op, sval: valueTok}\r\n   227\t\tif field == \"event\" {\r\n   228\t\t\tif op != \"==\" && op != \"!=\" {\r\n   229\t\t\t\treturn condition{}, i, fmt.Errorf(\"type mismatch: event only supports == or !=\")\r\n   230\t\t\t}\r\n"]
