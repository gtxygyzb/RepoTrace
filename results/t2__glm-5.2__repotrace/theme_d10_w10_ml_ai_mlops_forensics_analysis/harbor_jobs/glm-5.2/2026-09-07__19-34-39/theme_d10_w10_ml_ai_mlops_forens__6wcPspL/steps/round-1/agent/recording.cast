[1898.375853, "o", "\u001b[?2004l\r"]
[1898.378626, "o", "package forensics\r\n\r\nimport (\r\n"]
[1898.378638, "o", "\t\"time\"\r\n)\r\n\r\n"]
[1898.378696, "o", "type ReportOutput struct {\r\n\tVersion     string      `json:\"version\"`\r\n\tGeneratedAt string      `json:\"generated_at\"`\r\n\tEvidenceDir string      `json:\"evidence_dir\"`\r\n\tIngest      interface{} `json:\"ingest\"`\r\n\tTimeline    interface{} `json:\"timeline\"`\r\n\tVerify      interface{} `json:\"verify\"`\r\n"]
[1898.378772, "o", "\tDetect      interface{} `json:\"detect\"`\r\n\tLineage     interface{} `json:\"lineage\"`\r\n}\r\n\r\nfunc BuildReport(dir string) (interface{}, error) {\r\n\tvar report ReportOutput\r\n\treport.Version = \"1.0\"\r\n\treport.GeneratedAt = time.Now().UTC().Format(time.RFC3339)\r\n\treport.EvidenceDir = dir\r\n\r\n\treport.Ingest = safeBuild(func() (interface{}, error) { return BuildIngest(dir) })\r\n\treport.Timeline = safeBuild(func() (interface{}, error) { return BuildTimeline(dir) })\r\n\treport.Verify = safeBuild(func() (interface{}, error) { return BuildVerify(dir) })\r\n"]
[1898.378784, "o", "\treport.Detect = safeBuild(func() (interface{}, error) { return BuildDetect(dir) })\r\n\treport.Lineage = safeBuild(func() (interface{}, error) { return BuildLineage(dir) })\r\n"]
[1898.378852, "o", "\r\n\treturn report, nil\r\n}\r\n\r\nfunc safeBuild(fn func() (interface{}, error)) interface{} {\r\n\tv, err := fn()\r\n\tif err != nil {\r\n\t\treturn map[string]interface{}{\"status\": \"error\", \"message\": err.Error()}\r\n\t}\r\n\treturn v\r\n}\r\n"]
[1898.379364, "o", "\u001b[?2004h"]
[1898.379419, "o", "root@n30009:/app# "]
[1906.911249, "i", "nl -ba docs/output_schema.md | sed -n '1,240p'\n"]
[1906.911612, "o", "nl -ba docs/output_schema.md | sed -n '1,240p'\r\n"]
[1906.911701, "o", "\u001b[?2004l\r"]
[1906.915226, "o", "     1\t# Output Schemas\r\n     2\t\r\n     3\tAll commands output JSON to stdout. This document defines the exact JSON structure for each command.\r\n     4\t\r\n     5\t---\r\n"]
[1906.915303, "o", "     6\t\r\n     7\t## 1. Ingest Output\r\n     8\t\r\n     9\t```json\r\n    10\t{\r\n    11\t  \"status\": \"ok\",\r\n    12\t  \"evidence_dir\": \"/path/to/evidence\",\r\n    13\t  \"artifacts\": {\r\n    14\t    \"checkpoints\": [\r\n    15\t      {\r\n    16\t        \"file\": \"model_epoch1.mlck\",\r\n    17\t        \"file_hash\": \"a1b2c3...\",\r\n    18\t        \"version\": 1,\r\n"]
[1906.915375, "o", "    19\t        \"num_tensors\": 12,\r\n    20\t        \"num_metadata\": 3,\r\n    21\t        \"signed\": false,\r\n    22\t        \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n    23\t        \"provenance\": {\r\n    24\t          \"epoch\": 1,\r\n    25"]
[1906.915434, "o", "\t          \"global_step\": 5000,\r\n    26\t          \"framework\": \"PyTorch\",\r\n    27\t          \"framework_version\": \"2.1.0\",\r\n    28\t          \"parent_hash\": \"\"\r\n    29\t        }\r\n    30\t      }\r\n    31\t    ],\r\n    32\t    \"log_shards\": [\r\n    33\t      {\r\n    34\t        \"file\": \"shard_001.jsonl\","]
[1906.9155, "o", "\r\n    35\t        \"entries\": 500,\r\n    36\t        \"step_range\": [0, 5000],\r\n    37\t        \"epoch_range\": [0, 1],\r\n"]
[1906.91556, "o", "    38\t        \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-15T10:00:00Z\"]\r\n    39\t      }\r\n    40\t    ],\r\n    41\t    \"configs\": [\r\n    42\t      {\r\n    43\t        \"file\": \"config_train.json\",\r\n    44\t        \"model_name\": \"resnet50\",\r\n    45\t        \"dataset\": \"imagenet-1k\"\r\n    46\t      }\r\n    47\t    ]\r\n    48\t  },\r\n    49\t  \"totals\": {\r\n    50\t    \"checkpoints\": 3,\r\n    51\t    \"log_shards\": 4,\r\n    52\t    \"configs\": 1\r\n    53\t  }\r\n"]
[1906.915619, "o", "    54\t}\r\n    55\t```\r\n    56\t\r\n    57\t**Field rules:**\r\n    58\t- `file_hash`: SHA-256 hex of the entire `.mlck` file content.\r\n    59\t- `checkpoints` array: sorted by `creation_timestamp` ascending.\r\n    60\t- `log_shards` array: sorted by `file` name lexicographically.\r\n    61\t- `configs` array: sorted by `file` name lexicographically.\r\n    62\t- `step_range`: `[min_step, max_step]` across all entries in the shard.\r\n"]
[1906.915676, "o", "    63\t- `epoch_range`: `[min_epoch, max_epoch]` across all entries.\r\n    64\t- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.\r\n    65\t\r\n    66\t---\r\n    67\t\r\n    68\t## 2. Timeline Output\r\n    69\t\r\n    70\t```json\r\n    71\t{\r\n    72\t  \"status\": \"ok\",\r\n"]
[1906.915744, "o", "    73\t  \"total_entries\": 1200,\r\n    74\t  \"total_epochs\": 5,\r\n    75\t  \"step_range\": [0, 50000],\r\n    76\t  \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-17T14:00:00Z\"],\r\n    77\t  \"conflicts_resolved\": 3,\r\n    78\t  \"gaps\": [\r\n    79\t    {\r\n    80\t      \"after_step\": 5000,\r\n    81\t      \"before_step\": 5200,\r\n"]
[1906.915815, "o", "    82\t      \"epoch\": 1,\r\n    83\t      \"gap_steps\": 200,\r\n    84\t      \"after_ts\": \"2024-01-15T10:00:00Z\",\r\n    85\t      \"before_ts\": \"2024-01-15T13:00:00Z\"\r\n    86\t    }\r\n    87\t  ],\r\n    88\t  \"entries\": [\r\n    89\t    {\r\n    90\t      \"ts\": \"2024-01-15T08:00:00Z\",\r\n    91\t      \"epoch\": 0,\r\n    92\t      \"step\": 0,\r\n    93\t      \"loss\": 6.9078,\r\n"]
[1906.915882, "o", "    94\t      \"lr\": 0.001,\r\n    95\t      \"grad_norm\": 12.34,\r\n    96\t      \"acc\": 0.001,\r\n    97\t      \"event\": \"step\",\r\n    98\t      \"sources\": [\"shard_001.jsonl\"],\r\n    99\t"]
[1906.915984, "o", "      \"conflict\": false\r\n   100\t    }\r\n   101\t  ]\r\n   102\t}\r\n   103\t```\r\n   104\t\r\n   105\t**Field rules:**\r\n   106\t- `entries`: sorted by `(epoch ASC, step ASC)`.\r\n   107\t- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.\r\n   108\t- `conflict`: `true` if this entry was chosen by conflict resolution.\r\n   109\t- `gaps`: only gaps where `gap_steps > 100` within the same epoch.\r\n   110\t- Entries with missing optional fields omit them from the JSON (do not include null).\r\n   111\t\r\n   112\t---\r\n   113\t\r\n   114\t## 3. Verify Output\r\n   115\t\r\n"]
[1906.916111, "o", "   116\t```json\r\n   117\t{\r\n   118\t  \"status\": \"ok\",\r\n   119\t  \"checkpoints\": [\r\n   120\t    {\r\n   121\t      \"file\": \"model_epoch1.mlck\",\r\n   122\t      \"valid\": true,\r\n   123\t      \"header_checksum_valid\": true,\r\n   124\t      \"tensor_checksums_valid\": true,\r\n   125\t      \"signature_valid\": null,\r\n   126\t      \"provenance_valid\": true,\r\n   127\t      \"issues\": []\r\n   128\t    },\r\n   129\t    {\r\n   130\t      \"file\": \"model_epoch3.mlck\",\r\n   131\t      \"valid\": false,\r\n   132\t      \"header_checksum_valid\": true,\r\n   133\t      \"tensor_checksums_valid\": false,\r\n"]
[1906.916247, "o", "   134\t      \"signature_valid\": true,\r\n   135\t      \"provenance_valid\": true,\r\n   136\t      \"issues\": [\r\n   137\t        \"tensor_checksum_mismatch:encoder.layer2.weight\"\r\n   138\t      ]\r\n   139\t    }\r\n   140\t  ],\r\n   141\t  \"summary\": {\r\n   142\t    \"total\": 3,\r\n   143\t    \"valid\": 2,\r\n   144\t    \"invalid\": 1\r\n   145\t  }\r\n   146\t}\r\n   147\t```\r\n   148\t\r\n   149\t**Field rules:**\r\n   150\t- `checkpoints`: sorted by `file` name lexicographically.\r\n   151\t- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.\r\n   152\t- `issues`: list of human-readable issue descriptions. Format for tensor checksum mismatch: `\"tensor_checksum_mismatch:<tensor_name>\"`.\r\n   153\t- `valid`: `true` only if all applicable checks pass.\r\n   154\t\r\n"]
[1906.916331, "o", "   155\t---\r\n   156\t\r\n   157\t## 4. Detect Output\r\n   158\t\r\n   159\t```json\r\n   160\t{\r\n   161\t  \"status\": \"ok\",\r\n   162\t  \"anomalies\": [\r\n   163\t    {\r\n   164\t      \"id\": \"ANOM-001\",\r\n   165\t      \"type\": \"gradient_spike\",\r\n   166\t      \"severity\": \"high\",\r\n   167\t      \"epoch\": 2,\r\n   168\t      \"step\": 3456,\r\n   169\t"]
[1906.91639, "o", "      \"details\": {\r\n   170\t        \"observed\": 15.3,\r\n   171\t        \"window_mean\": 1.2,\r\n   172\t        \"window_stddev\": 0.3,\r\n   173\t        \"z_score\": 47.0\r\n   174\t      },\r\n   175\t      \"source\": \"shard_002.jsonl\"\r\n   176\t    },\r\n"]
[1906.916448, "o", "   177\t    {\r\n   178\t      \"id\": \"ANOM-002\",\r\n   179\t      \"type\": \"tensor_checksum_mismatch\",\r\n   180\t      \"severity\": \"critical\",\r\n   181\t      \"details\": {\r\n   182\t        \"file\": \"model_epoch3.mlck\",\r\n   183\t        \"tensor_name\": \"encoder.layer2.weight\",\r\n   184\t        \"expected_checksum\": \"abcd1234...\",\r\n   185\t        \"actual_checksum\": \"efgh5678...\"\r\n"]
[1906.916508, "o", "   186\t      },\r\n   187\t      \"source\": \"model_epoch3.mlck\"\r\n   188\t    }\r\n   189\t  ],\r\n   190\t  \"summary\": {\r\n   191\t    \"total\": 5,\r\n   192\t    \"by_severity\": {\r\n   193\t      \"critical\": 1,\r\n   194\t      \"high\": 2,\r\n"]
[1906.916573, "o", "   195\t      \"medium\": 1,\r\n   196\t      \"low\": 1\r\n   197\t    },\r\n   198\t    \"by_type\": {\r\n   199\t      \"gradient_spike\": 1,\r\n   200\t      \"loss_divergence\": 1,\r\n   201\t      \"tensor_checksum_mismatch\": 1,\r\n   202\t      \"training_gap\": 1,\r\n   203\t      \"lr_anomaly\": 1\r\n   204\t    }\r\n"]
[1906.916637, "o", "   205\t  }\r\n   206\t}\r\n   207\t```\r\n   208\t\r\n"]
[1906.916698, "o", "   209\t**Field rules:**\r\n   210\t- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.\r\n   211\t- `anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.\r\n   212\t- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.\r\n   213\t- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.\r\n   214\t- `source`: the artifact file where the anomaly was detected.\r\n   215\t- `epoch` and `step`: present only for timeline-based anomalies.\r\n   216\t- If no anomalies are detected, `anomalies` is an empty array.\r\n   217\t\r\n   218\t---\r\n   219\t\r\n   220\t## 5. Lineage Output\r\n   221\t\r\n   222\t```json\r\n   223"]
[1906.916737, "o", "\t{\r\n   224\t  \"status\": \"ok\",\r\n   225\t  \"nodes\": [\r\n   226\t    {\r\n"]
[1906.916862, "o", "   227\t      \"file\": \"model_epoch1.mlck\",\r\n   228\t      \"file_hash\": \"a1b2c3...\",\r\n   229\t      \"epoch\": 1,\r\n   230\t      \"global_step\": 5000,\r\n   231\t      \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n   232\t      \"parent_hash\": \"\",\r\n   233\t      \"is_root\": true,\r\n   234\t      \"is_leaf\": false,\r\n   235\t      \"is_orphan\": false\r\n   236\t    }\r\n   237\t  ],\r\n   238\t  \"edges\": [\r\n   239\t    {\r\n   240\t      \"from\": \"a1b2c3...\",\r\n"]
