[6181.146153, "o", "\u001b[32m\u001b[K569\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc precedingLossValues\u001b[m\u001b[K(entries []types.TimelineEntry, indices []int, pos, n int) []float64 {\r\n"]
