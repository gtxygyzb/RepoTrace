[2904.313566, "o", "sed -n '430,465p' internal/forensics/forensics.go\r\n\u001b[?2004l\r"]
[2904.315171, "o", "\t}\r\n\treturn allEntries, shards, nil\r\n}\r\n\r\nfunc mergeTimeline(entries []types.TimelineEntry) ([]types.TimelineEntry, int) {\r\n\ttype agg struct {\r\n\t\tentry    types.TimelineEntry\r\n\t\tsources  map[string]struct{}\r\n\t\tconflict bool\r\n\t}\r\n\tm := map[string]*agg{}\r\n\tfor _, e := range entries {\r\n\t\tkey := fmt.Sprintf(\"%d:%d\", e.Epoch, e.Step)\r\n\t\ta, ok := m[key]\r\n\t\tif !ok {\r\n\t\t\tsrc := map[string]struct{}{}\r\n"]
[2904.315265, "o", "\t\t\tfor _, s := range e.Sources {\r\n\t\t\t\tsrc[s] = struct{}{}\r\n\t\t\t}\r\n\t\t\tm[key] = &agg{entry: e, sources: src}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfor _, s := range e.Sources {\r\n\t\t\ta.sources[s] = struct{}{}\r\n\t\t}\r\n\t\tif metricsEqual(a.entry, e) {\r\n\t\t\tif e.Ts > a.entry.Ts {\r\n\t\t\t\ta.entry = e\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\ta.conflict = true\r\n\t\tif e.Ts > a.entry.Ts {\r\n\t\t\ta.entry = e\r\n\t\t}\r\n\t}\r\n"]
[2904.315656, "o", "\u001b[?2004h"]
