[3530.692673, "o", "package forensics\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n"]
[3530.692775, "o", "\t\"mlforge/internal/types\"\r\n)\r\n\r\ntype QueryOutput struct {\r\n\tStatus  string                `json:\"status\"`\r\n\tQuery   string                `json:\"query\"`\r\n\tMatches int                   `json:\"matches\"`\r\n\tEntries []types.TimelineEntry `json:\"entries\"`\r\n}\r\n\r\nfunc BuildQuery(dir, expr string) (interface{}, error) {\r\n\tentries, _, err := loadTimelineEntries(dir)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tmerged, _ := mergeTimeline(entries)\r\n\tsortTimeline(merged)\r\n\r\n"]
[3530.692873, "o", "\tq, err := parseQuery(expr)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tmatches := []types.TimelineEntry{}\r\n\tfor _, e := range merged {\r\n\t\tif q.eval(e) {\r\n\t\t\tmatches = append(matches, e)\r\n\t\t}\r\n\t}\r\n\treturn QueryOutput{\r\n\t\tStatus:  \"ok\",\r\n\t\tQuery:   expr,\r\n\t\tMatches: len(matches),\r\n"]
[3530.692998, "o", "\t\tEntries: matches,\r\n\t}, nil\r\n}\r\n\r\ntype condition struct {\r\n\tfield string\r\n\top    string\r\n\tsval  string\r\n\tfval  float64\r\n\tisNum bool\r\n}\r\n\r\ntype orGroup struct {\r\n\tands []condition\r\n}\r\n\r\ntype query struct {\r\n\tors []orGroup\r\n"]
[3530.693065, "o", "}\r\n\r\nfunc (q query) eval(e types.TimelineEntry) bool {\r\n\tfor _, g := range q.ors {\r\n\t\tok := true\r\n\t\tfor _, c := range g.ands {\r\n\t\t\tif !c.eval(e) {\r\n\t\t\t\tok = false\r\n\t\t\t\tbreak\r\n\t\t\t}"]
[3530.69313, "o", "\r\n\t\t}\r\n\t\tif ok {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc (c condition) eval(e types.TimelineEntry) bool {\r\n\tswitch c.field {\r\n\t"]
[3530.693188, "o", "case \"step\":\r\n\t\treturn compareNum(float64(e.Step), c)\r\n\tcase \"epoch\":\r\n\t\treturn compareNum(float64(e.Epoch), c)\r\n\tcase \"loss\":\r\n\t\treturn ptrCompareNum(e.Loss, c)\r\n\tcase \"lr\":\r\n\t\treturn ptrCompareNum(e.Lr, c)\r\n\tcase \"grad_norm\":\r\n"]
[3530.693245, "o", "\t\treturn ptrCompareNum(e.GradNorm, c)\r\n\tcase \"acc\":\r\n\t\treturn ptrCompareNum(e.Acc, c)\r\n\tcase \"event\":\r\n\t\treturn compareStr(e.Event, c)\r\n\tcase \"ts\":\r\n\t\treturn compareTs(e.Ts, c)\r\n\t}\r\n\treturn false\r\n}\r\n\r\n"]
[3530.693307, "o", "func compareNum(val float64, c condition) bool {\r\n\tif !c.isNum {\r\n\t\treturn false\r\n\t}\r\n\tswitch c.op {\r\n\tcase \">\":\r\n\t\treturn val > c.fval\r\n\tcase \"<\":\r\n\t\treturn val < c.fval\r\n\tcase \">=\":\r\n"]
[3530.693372, "o", "\t\treturn val >= c.fval\r\n\tcase \"<=\":\r\n\t\treturn val <= c.fval\r\n\tcase \"==\":\r\n\t\treturn absFloat(val-c.fval) <= 1e-9\r\n\tcase \"!=\":\r\n"]
[3530.693449, "o", "\t\treturn absFloat(val-c.fval) > 1e-9\r\n\t}\r\n\treturn false\r\n}\r\n\r\n"]
[3530.693524, "o", "func ptrCompareNum(p *float64, c condition) bool {\r\n\tif p == nil {\r\n\t\treturn false\r\n\t}\r\n\treturn compareNum(*p, c)\r\n}\r\n\r\nfunc compareStr(val string, c condition) bool {\r\n\tif c.isNum {\r\n\t\treturn false\r\n\t}\r\n\tswitch c.op {\r\n\tcase \"==\":\r\n\t\treturn val == c.sval\r\n\tcase \"!=\":\r\n\t\treturn val != c.sval\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc compareTs(val string, c condition) bool {"]
[3530.693588, "o", "\r\n\tlt, err := time.Parse(time.RFC3339, val)\r\n\tif err != nil {\r\n\t\treturn false\r\n\t}\r\n\trt, err := time.Parse(time.RFC3339, c.sval)\r\n\tif err != nil {\r\n\t\treturn false\r\n\t}\r\n\tswitch c.op {\r\n\tcase \">\":\r\n\t\t"]
[3530.693644, "o", "return lt.After(rt)\r\n\tcase \"<\":\r\n\t\treturn lt.Before(rt)\r\n\tcase \">=\":\r\n\t\treturn lt.After(rt) || lt.Equal(rt)\r\n\tcase \"<=\":\r\n\t\treturn lt.Before(rt) || lt.Equal(rt)\r\n\tcase \"==\":\r\n\t\t"]
[3530.693706, "o", "return lt.Equal(rt)\r\n\tcase \"!=\":\r\n\t\treturn !lt.Equal(rt)\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc absFloat(x float64) float64 {\r\n\tif x < 0 {\r\n\t\treturn -x\r\n\t}\r\n\treturn x\r\n}\r\n"]
[3530.693763, "o", "\r\nfunc parseQuery(expr string) (query, error) {\r\n\ttokens, err := tokenizeQuery(expr)\r\n\tif err != nil {\r\n\t\treturn query{}, err\r\n\t}\r\n\tvar q query\r\n\tvar cur orGroup\r\n\ti := 0\r\n\tfor i < len(tokens) {\r\n\t\ttok := tokens[i]\r\n"]
[3530.69382, "o", "\t\tif tok == \"AND\" || tok == \"OR\" {\r\n\t\t\tif tok == \"OR\" {\r\n\t\t\t\tq.ors = append(q.ors, cur)\r\n\t\t\t\tcur = orGroup{}\r\n\t\t\t} else if tok == \"AND\" {\r\n\t\t\t\t// continue adding to cur\r\n\t\t\t}\r\n\t\t\ti++\r\n"]
[3530.693882, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tcond, next, err := parseCondition(tokens, i)\r\n\t\tif err != nil {\r\n\t\t\treturn query{}, err\r\n\t\t}\r\n\t\tcur.ands = append(cur.ands, cond)\r\n\t\ti = next\r\n\t}\r\n\tif len(cur.ands) > 0 || len(q.ors) == 0 {\r\n\t\tq.ors = append(q.ors, cur)\r\n"]
[3530.693957, "o", "\t}\r\n\tif len(q.ors) == 0 || len(q.ors[0].ands) == 0 {\r\n\t\treturn query{}, fmt.Errorf(\"empty query\")\r\n\t}\r\n\treturn q, nil\r\n}\r\n\r\nfunc parseCondition(tokens []string, i int) (condition, int, error) {\r\n\tif i+2 >= len(tokens) {\r\n\t\treturn condition{}, i, fmt.Errorf(\"invalid query syntax\")\r\n\t}"]
[3530.694036, "o", "\r\n\tfield := tokens[i]\r\n\top := tokens[i+1]\r\n\tvalueTok := tokens[i+2]\r\n\r\n\tvalidFields := map[string]bool{\"step\": true, \"epoch\": true, \"loss\": true, \"lr\": true, \"grad_norm\": true, \"acc\": true, \"event\": true, \"ts\": true}\r\n\tif !validFields[field] {\r\n\t\treturn condition{}, i, fmt.Errorf(\"unknown field: %s\", field)\r\n\t}\r\n\tvalidOps := map[string]bool{\">\": true, \"<\": true, \">=\": true, \"<=\": true, \"==\": true, \"!=\": true}\r\n\tif !validOps[op] {\r\n\t\treturn condition{}, i, fmt.Errorf(\"invalid operator: %s\", op)\r\n"]
[3530.694097, "o", "\t}\r\n\r\n\tc := condition{field: field, op: op, sval: valueTok}\r\n\tif field == \"event\" {\r\n\t\tif op != \"==\" && op != \"!=\" {\r\n\t\t\treturn condition{}, i, fmt.Errorf(\"type mismatch: event only supports == or !=\")\r\n\t\t}\r\n\t\tif !isQuotedString(valueTok) {\r\n\t\t\treturn condition{}, i, fmt.Errorf(\"type mismatch: event requires string value\")\r\n\t\t}\r\n\t\tc.sval = unquote(valueTok)\r\n\t"]
[3530.69416, "o", "\treturn c, i + 3, nil\r\n\t}\r\n\tif field == \"ts\" {\r\n\t\tif _, err := time.Parse(time.RFC3339, unquote(valueTok)); err != nil {\r\n\t\t\treturn condition{}, i, fmt.Errorf(\"invalid timestamp: %s\", valueTok)\r\n\t\t}\r\n\t\tc.sval = unquote(valueTok)\r\n\t\treturn c, i + 3, nil\r\n\t}\r\n\tnum, err := strconv.ParseFloat(valueTok, 64)\r\n"]
[3530.69419, "o", "\tif err != nil {\r\n\t\treturn condition{}, i, fmt.Errorf(\"type mismatch: %s requires numeric value\", field)\r\n\t}\r\n\tc.fval = num\r\n\tc.isNum = true\r\n\treturn c, i + 3, nil"]
[3530.694273, "o", "\r\n}\r\n\r\nfunc tokenizeQuery(s string) ([]string, error) {\r\n\tvar tokens []string\r\n\ti := 0\r\n\tfor i < len(s) {\r\n\t\tch := s[i]\r\n\t\tif ch == ' ' || ch == '\\t' || ch == '\\n' || ch == '\\r' {\r\n\t\t\ti++\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif ch == '\"' {\r\n"]
[3530.694331, "o", "\t\t\tj := i + 1\r\n\t\t\tfor j < len(s) && s[j] != '\"' {\r\n\t\t\t\tj++\r\n\t\t\t}\r\n\t\t\tif j >= len(s) {\r\n\t\t\t\treturn nil, fmt.Errorf(\"unterminated string\")\r\n\t\t\t}\r\n\t"]
[3530.694388, "o", "\t\ttokens = append(tokens, s[i:j+1])\r\n\t\t\ti = j + 1\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif strings.HasPrefix(s[i:], \">=\") || strings.HasPrefix(s[i:], \"<=\") || strings.HasPrefix(s[i:], \"==\") || strings.HasPrefix(s[i:], \"!=\") {\r\n\t\t\ttokens = append(tokens, s[i:i+2])\r\n\t\t\ti += 2\r\n\t"]
[3530.694444, "o", "\t\tcontinue\r\n\t\t}\r\n\t\tif ch == '>' || ch == '<' {\r\n\t\t\ttokens = append(tokens, string(ch))\r\n\t\t\ti++\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tj := i\r\n\t\tfor j < len(s) {\r\n\t\t\t"]
[3530.694502, "o", "c := s[j]\r\n\t\t\tif c == ' ' || c == '\\t' || c == '\\n' || c == '\\r' || c == '>' || c == '<' || c == '=' || c == '!' || c == '\"' {\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t\tj++\r\n\t\t}\r\n\t\tif j == i {\r\n\t\t\treturn nil, fmt.Errorf(\"invalid character in query: %c\", ch)\r\n\t\t}"]
[3530.694557, "o", "\r\n\t\ttokens = append(tokens, s[i:j])\r\n\t\ti = j\r\n\t}\r\n\treturn tokens, nil\r\n}\r\n\r\nfunc isQuotedString(s string) bool {\r\n\treturn len(s) >= 2 && s[0] == '\"' && s[len(s)-1] == '\"'\r\n}\r\n"]
[3530.694612, "o", "\r\nfunc unquote(s string) string {\r\n\tif isQuotedString(s) {\r\n\t\treturn s[1 : len(s)-1]\r\n\t}\r\n\treturn s\r\n}\r\n"]
