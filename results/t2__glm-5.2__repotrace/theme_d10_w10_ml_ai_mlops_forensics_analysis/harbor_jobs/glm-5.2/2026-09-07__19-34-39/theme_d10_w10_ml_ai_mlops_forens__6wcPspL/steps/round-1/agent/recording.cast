[5797.641906, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\n# Update analysis_rules.md\np = Path('docs/analysis_rules.md')\ns = p.read_text()\ns = s.replace('Anomalies are classified by severity: `critical`, `high`, `medium`, `low`.',\n              'Anomalies are classified by severity: `critical`, `high`, `medium`, `low`, `info`.')\ns = s.replace('`critical` > `high` > `medium` > `low`',\n              '`critical` > `high` > `medium` > `low` > `info`')\ns = s.replace('**Severity**: `medium`\\n- **Detection**', '**Severity**: `info`\\n- **Detection**')\ns = s.replace('**Severity**: `low`\\n- **Detection**', '**Severity**: `info`\\n- **Detection**')\ns = s.replace('**Severity**: `high`\\n- **Detection**', '**Severity**: `medium`\\n- **Detection**')\n# If the above is too broad, restore metric_regression/dataset_hash_inconsistency by matching exact type context below.\np.write_text(s)\n\n# More targeted replacements for analysis_rules.md\ns = p.read_text()\ns = s.replace('### `lr_anomaly`\\n\\n- **Severity**: `info`', '### `lr_anomaly`\\n\\n- **Severi"]
[5797.64223, "i", "ty**: `info`')\ns = s.replace('### `training_gap`\\n\\n- **Severity**: `info`', '### `training_gap`\\n\\n- **Severity**: `info`')\ns = s.replace('### `provenance_chain_break`\\n\\n- **Severity**: `medium`', '### `provenance_chain_break`\\n\\n- **Severity**: `medium`')\np.write_text(s)\n\n# Update output_schema.md\np = Path('docs/output_schema.md')\ns = p.read_text()\ns = s.replace('\"low\": 1\\n    }', '\"info\": 1\\n    }')\ns = s.replace('`anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.',\n              '`anomalies`: sorted by severity (`critical` > `high` > `medium` > `low` > `info`), then `type` alphabetically, then `epoch` ascending, then `step` ascending.')\ns = s.replace('Severity order is `critical > high > medium > low`.',\n              'Severity order is `critical > high > medium > low > info`.')\ns = s.replace('`--filter-severity high` shows only `critical` and `high` anomalies',\n              '`--filter-severity high` shows only `critical` and `high` anomalies')\np.write_text(s)\nPY\n"]
