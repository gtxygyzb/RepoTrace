[2176.110856, "o", "   300\tfunc verifyCheckpoint(path string) VerifyCheckpoint {\r\n   301\t\tvc := VerifyCheckpoint{\r\n   302\t\t\tFile:   filepath.Base(path),\r\n   303\t\t\tIssues: []VerifyIssue{},\r\n   304\t\t}\r\n   305\t\tcf, err := checkpoint.Parse(path)\r\n   306\t\tif err != nil || cf == nil {\r\n   307\t\t\tvc.HeaderChecksumValid = false\r\n   308\t\t\tvc.TensorChecksumsValid = false\r\n   309\t\t\tvc.ProvenanceValid = false\r\n   310\t\t\tvc.Valid = false\r\n   311\t"]
