[3541.836421, "o", "\u001b[35m\u001b[K./internal/forensics/query.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcond, next, err := \u001b[01;31m\u001b[KparseCondition\u001b[m\u001b[K(tokens, i)\r\n\u001b[35m\u001b[K./internal/forensics/query.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KparseCondition\u001b[m\u001b[K(tokens []string, i int) (condition, int, error) {\r\n"]
[3541.836509, "o", "\u001b[35m\u001b[K./internal/forensics/query.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KtokenizeQuery\u001b[m\u001b[K(s string) ([]string, error) {\r\n"]
[3541.83723, "o", "\u001b[35m\u001b[K./cmd/mlforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult, err = forensics.\u001b[01;31m\u001b[KBuildQuery\u001b[m\u001b[K(dir, positional[2])\r\n"]
