[4433.683159, "o", "   467\t\t\t\treturn cf, true\r\n   468\t\t\t}\r\n   469\t\t}\r\n   470\t\treturn nil, false\r\n   471\t}\r\n   472\t\r\n   473\tfunc signatureDetails(path string) (bool, string) {\r\n   474\t\traw, err := os.ReadFile(path)\r\n   475\t\tif err != nil || len(raw) < 56 {\r\n   476\t\t\treturn false, \"\"\r\n   477\t\t}\r\n   478\t\tsigOff := binary.LittleEndian.Uint64(raw[32:40])\r\n   479\t\t"]
[4433.683225, "o", "if sigOff == 0 || int(sigOff) >= len(raw) || int(sigOff)+5 > len(raw) {\r\n   480\t\t\treturn false, \"\"\r\n   481\t\t}\r\n   482\t\toff := int(sigOff)\r\n   483\t\toff++ // algorithm\r\n   484\t\tsignerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   485\t\toff += 2\r\n   486\t\tif off+signerLen+2 > len(raw) {\r\n   487\t\t\treturn false, \"\"\r\n"]
[4433.683296, "o", "   488\t\t}\r\n   489\t\tsignerID := string(raw[off : off+signerLen])\r\n   490\t\toff += signerLen\r\n   491\t\tsigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   492\t\toff += 2\r\n   493\t\tif off+sigLen > len(raw) {\r\n   494\t\t\treturn false, signerID\r\n   495\t\t}\r\n   496\t\tstored := raw[off : off+sigLen]\r\n   497\t\tmac := hmac.New(sha256.New, []byte(signerID))\r\n   498\t\tmac.Write(raw[:sigOff])\r\n"]
[4433.683362, "o", "   499\t\texpected := mac.Sum(nil)\r\n   500\t\treturn hmac.Equal(expected, stored), signerID\r\n   501\t}\r\n   502\t\r\n   503\tfunc firstSource(e types.TimelineEntry) string {\r\n   504\t\tif len(e.Sources) > 0 {\r\n   505\t\t\treturn e.Sources[0]\r\n   506\t\t}\r\n   507\t\treturn \"\"\r\n   508\t}\r\n"]
