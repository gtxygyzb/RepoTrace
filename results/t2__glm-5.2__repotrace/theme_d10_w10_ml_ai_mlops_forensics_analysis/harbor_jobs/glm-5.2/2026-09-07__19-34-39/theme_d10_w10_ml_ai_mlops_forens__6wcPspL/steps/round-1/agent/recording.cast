[2799.679767, "i", "grep -n \"mergeTimeline\\|conflict\\|Conflict\\|func BuildTimeline\" internal/forensics/forensics.go\n"]
[2799.68047, "o", "grep -n \"mergeTimeline\\|conflict\\|Conflict\\|func BuildTimeline\" internal/forensics/forensics.go\r\n\u001b[?2004l\r"]
[2799.683899, "o", "\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KConflict\u001b[m\u001b[KsResolved int                   `json:\"\u001b[01;31m\u001b[Kconflict\u001b[m\u001b[Ks_resolved\"`\r\n"]
[2799.684141, "o", "\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc BuildTimeline\u001b[m\u001b[K(dir string) (interface{}, error) {\r\n"]
[2799.684299, "o", "\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmerged, \u001b[01;31m\u001b[Kconflict\u001b[m\u001b[Ks := \u001b[01;31m\u001b[KmergeTimeline\u001b[m\u001b[K(entries)\r\n\u001b[32m\u001b[K211\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KConflict\u001b[m\u001b[KsResolved: \u001b[01;31m\u001b[Kconflict\u001b[m\u001b[Ks,\r\n\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KmergeTimeline\u001b[m\u001b[K(entries []types.TimelineEntry) ([]types.TimelineEntry, int) {\r\n"]
