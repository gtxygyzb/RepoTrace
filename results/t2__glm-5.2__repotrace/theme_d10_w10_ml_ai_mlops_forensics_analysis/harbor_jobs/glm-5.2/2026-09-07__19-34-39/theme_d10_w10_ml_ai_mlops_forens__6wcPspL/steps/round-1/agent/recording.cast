[1157.113609, "o", "def make_mlck(path, parent_hash='', dataset=b'\\x01'*32, ts=None):\r\n\u001b[?2004l\r"]
[1157.113656, "o", "\u001b[?2004h"]
[1157.113714, "o", "> "]
[1157.113844, "o", "    if ts is None:\r\n\u001b[?2004l\r"]
[1157.113907, "o", "\u001b[?2004h> "]
[1157.114134, "o", "        ts = int(time.time())\r\n\u001b[?2004l\r"]
[1157.11419, "o", "\u001b[?2004h> "]
[1157.114332, "o", "    name = b'w'\r\n\u001b[?2004l\r"]
[1157.114388, "o", "\u001b[?2004h> "]
[1157.114648, "o", "    data = b'\\x00\\x00\\x80\\x3f'\r\n\u001b[?2004l\r"]
