[6669.667456, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path(\"internal/forensics/detect.go\")\ns = p.read_text()\n\nnew_gradient = '''func detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\n\\tvar vals []float64\n\\tvar idx []int\n\\tfor i, e := range entries {\n\\t\\tif e.GradNorm != nil {\n\\t\\t\\tvals = append(vals, *e.GradNorm)\n\\t\\t\\tidx = append(idx, i)\n\\t\\t}\n\\t}\n\\tif len(vals) < 31 {\n\\t\\treturn nil\n\\t}\n\\tconst alpha = 0.1\n\\tmean := vals[0]\n\\tvariance := 0.0\n\\tvar anomalies []types.Anomaly\n\\tfor i := 1; i < len(vals); i++ {\n\\t\\tif i >= 30 {\n\\t\\t\\tobserved := vals[i]\n\\t\\t\\tstddev := math.Sqrt(variance)\n\\t\\t\\tz := 0.0\n\\t\\t\\tif stddev > 0 {\n\\t\\t\\t\\tz = (observed - mean) / stddev\n\\t\\t\\t}\n\\t\\t\\tif z > 2.5 {\n\\t\\t\\t\\tseverity := \"medium\"\n\\t\\t\\t\\tif z > 4.0 {\n\\t\\t\\t\\t\\tseverity = \"high\"\n\\t\\t\\t\\t}\n\\t\\t\\t\\tep := entries[idx[i]].Epoch\n\\t\\t\\t\\tst := entries[idx[i]].Step\n\\t\\t\\t\\tanomalies = append(anomalies, types.Anomaly{\n\\t\\t\\t\\t\\tType:     \"gradient_spike\",\n\\t\\t\\t\\t\\tSeverity: severity,\n\\t\\t\\t\\t\\tEpoch:    &ep,\n\\t\\t\\t\\"]
[6669.667766, "i", "t\\tStep:     &st,\n\\t\\t\\t\\t\\tDetails: map[string]interface{}{\n\\t\\t\\t\\t\\t\\t\"observed\":    observed,\n\\t\\t\\t\\t\\t\\t\"ewma_mean\":   mean,\n\\t\\t\\t\\t\\t\\t\"ewma_stddev\": stddev,\n\\t\\t\\t\\t\\t\\t\"z_score\":     z,\n\\t\\t\\t\\t\\t},\n\\t\\t\\t\\t\\tEvidence: map[string]interface{}{\"window_values\": lastValues(vals[:i], 5)},\n\\t\\t\\t\\t\\tSource:   firstSource(entries[idx[i]]),\n\\t\\t\\t\\t})\n\\t\\t\\t}\n\\t\\t}\n\\t\\tprevMean := mean\n\\t\\tmean = (1-alpha)*mean + alpha*vals[i]\n\\t\\tvariance = (1-alpha)*variance + alpha*(vals[i]-prevMean)*(vals[i]-prevMean)\n\\t}\n\\treturn anomalies\n}\n\n'''\n\ng_start = s.index(\"func detectGradientSpikes\")\ng_end = s.index(\"func detectLossDivergence\", g_start)\ns = s[:g_start] + new_gradient + s[g_end:]\n\nnew_loss = '''func detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\n\\tvar lossEntries []int\n\\tfor i, e := range entries {\n\\t\\tif e.Loss != nil {\n\\t\\t\\tlossEntries = append(lossEntries, i)\n\\t\\t}\n\\t}\n\\tif len(lossEntries) < 2 {\n\\t\\treturn nil\n\\t}\n\\tconst alpha = 0.05\n\\temaLoss := *entries[lossEntries[0]].Loss\n\\tvar"]
[6669.667857, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r"]
[6669.667992, "i", " anomalies []types.Anomaly\n\\tfor i := 1; i < len(lossEntries); i++ {\n\\t\\tcurrentLoss := *entries[lossEntries[i]].Loss\n\\t\\tif math.Abs(emaLoss) > 1e-6 {\n\\t\\t\\tratio := currentLoss / emaLoss\n\\t\\t\\tif currentLoss > 2.0*emaLoss {\n\\t\\t\\t\\tseverity := \"high\"\n\\t\\t\\t\\tif ratio > 5.0 {\n\\t\\t\\t\\t\\tseverity = \"critical\"\n\\t\\t\\t\\t}\n\\t\\t\\t\\tep := entries[lossEntries[i]].Epoch\n\\t\\t\\t\\tst := entries[lossEntries[i]].Step\n\\t\\t\\t\\tanomalies = append(anomalies, types.Anomaly{\n\\t\\t\\t\\t\\tType:     \"loss_divergence\",\n\\t\\t\\t\\t\\tSeverity: severity,\n\\t\\t\\t\\t\\tEpoch:    &ep,\n\\t\\t\\t\\t\\tStep:     &st,\n\\t\\t\\t\\t\\tDetails: map[string]interface{}{\n\\t\\t\\t\\t\\t\\t\"current_loss\": currentLoss,\n\\t\\t\\t\\t\\t\\t\"ema_loss\":     emaLoss,\n\\t\\t\\t\\t\\t\\t\"ratio\":        ratio,\n\\t\\t\\t\\t\\t},\n\\t\\t\\t\\t\\tEvidence: map[string]interface{}{\"window_values\": precedingLossValues(entries, lossEntries, i, 5)},\n\\t\\t\\t\\t\\tSource:   firstSource(entries[lossEntries[i]]),\n\\t\\t\\t\\t})\n\\t\\t\\t}\n\\t\\t}\n\\t\\temaLoss = (1-alpha)*emaLoss + alpha*currentLoss\n\\t}\n\\treturn anomalies\n}\n\n'''\n\n"]
[6669.668043, "o", "t\\tStep:     &st,\r\n\\t\\t\\t\\t\\tDetails: map[string]interface{}{\r\n\\t\\t\\t\\t\\t\\t\"observed\":    observed,\r\n\\t\\t\\t\\t\\t\\t\"ewma_mean\":   mean,\r\n\\t\\t\\t\\t\\t\\t\"ewma_stddev\": stddev,\r\n\\t\\t\\t\\t\\t\\t\"z_score\":     z,\r\n\\t\\t\\t\\t\\t},\r\n\\t\\t\\t\\t\\tEvidence: map[string]interface{}{\"window_values\": lastValues(vals[:i], 5)},\r\n\\t\\t\\t\\t\\tSource:   firstSource(entries[idx[i]]),\r\n\\t\\t\\t\\t})\r\n\\t\\t\\t}\r\n\\t\\t}\r\n\\t\\tprevMean := mean\r\n\\t\\tmean = (1-alpha)*mean + alpha*vals[i]\r\n\\t\\"]
