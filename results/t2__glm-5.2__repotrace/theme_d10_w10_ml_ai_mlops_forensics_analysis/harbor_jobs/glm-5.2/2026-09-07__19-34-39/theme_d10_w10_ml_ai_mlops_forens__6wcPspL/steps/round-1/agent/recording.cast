[3846.796593, "i", "=\":\n\t\treturn lt.After(rt) || lt.Equal(rt)\n\tcase \"<=\":\n\t\treturn lt.Before(rt) || lt.Equal(rt)\n\tcase \"==\":\n\t\treturn lt.Equal(rt)\n\tcase \"!=\":\n\t\treturn !lt.Equal(rt)\n\t}\n\treturn false\n}\n\nfunc absFloat(x float64) float64 {\n\tif x < 0 {\n\t\treturn -x\n\t}\n\treturn x\n}\n\ntype parser struct {\n\ttokens []string\n\tpos    int\n}\n\nfunc parseQuery(expr string) (node, error) {\n\ttokens, err := tokenizeQuery(expr)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif len(tokens) == 0 {\n\t\treturn nil, fmt.Errorf(\"empty query\")\n\t}\n\tp := &parser{tokens: tokens}\n\tn, err := p.parseOr()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif p.pos != len(p.tokens) {\n\t\treturn nil, fmt.Errorf(\"unexpected token: %s\", p.current())\n\t}\n\treturn n, nil\n}\n\nfunc (p *parser) current() string {\n\tif p.pos < len(p.tokens) {\n\t\treturn p.tokens[p.pos]\n\t}\n\treturn \"\"\n}\n\nfunc (p *parser) match(tok string) bool {\n\tif p.current() == tok {\n\t\tp.pos++\n\t\treturn true\n\t}\n\treturn false\n}\n\nfunc (p *parser) parseOr() (node, error) {\n\tleft, err := p.parseAnd()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\t"]
