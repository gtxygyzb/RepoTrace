[3550.111168, "o", "\r\n   212\t\t}\r\n   213\t\tfield := tokens[i]\r\n   214\t\top := tokens[i+1]\r\n   215\t\tvalueTok := tokens[i+2]\r\n   216\t\r\n   217\t\tvalidFields := map[string]bool{\"step\": true, \"epoch\": true, \"loss\": true, \"lr\": true, \"grad_norm\": true, \"acc\": true, \"event\": true, \"ts\": true}\r\n   218\t\tif !validFields[field] {\r\n   219\t\t\treturn condition{}, i, fmt.Errorf(\"unknown field: %s\", field)\r\n   220\t\t}\r\n   221\t\tvalidOps := map[string]bool{\">\": true, \"<\": true, \">=\": true, \"<=\": true, \"==\": true, \"!=\": true}\r\n   222\t\tif !validOps[op] {\r\n"]
[3550.111251, "o", "   223\t\t\treturn condition{}, i, fmt.Errorf(\"invalid operator: %s\", op)\r\n   224\t\t}\r\n   225\t\r\n   226\t\tc := condition{field: field, op: op, sval: valueTok}\r\n   227\t\tif field == \"event\" {\r\n   228\t\t\tif op != \"==\" && op != \"!=\" {\r\n   229\t\t\t\treturn condition{}, i, fmt.Errorf(\"type mismatch: event only supports == or !=\")\r\n   230\t\t\t}\r\n   231\t\t\tif !isQuotedString(valueTok) {\r\n   232\t\t\t\treturn condition{}, i, fmt.Errorf(\"type mismatch: event requires string value\")\r\n   233\t\t\t}\r\n   234\t\t\tc.sval = unquote(valueTok)\r\n   235"]
[3550.111375, "o", "\t\t\treturn c, i + 3, nil\r\n   236\t\t}\r\n   237\t\tif field == \"ts\" {\r\n   238\t\t\tif _, err := time.Parse(time.RFC3339, unquote(valueTok)); err != nil {\r\n   239\t\t\t\treturn condition{}, i, fmt.Errorf(\"invalid timestamp: %s\", valueTok)\r\n   240\t\t\t}\r\n   241\t\t\tc.sval = unquote(valueTok)\r\n   242\t\t\treturn c, i + 3, nil\r\n   243\t\t}\r\n   244\t\tnum, err := strconv.ParseFloat(valueTok, 64)\r\n   245\t\tif err != nil {\r\n   246\t\t\treturn condition{}, i, fmt.Errorf(\"type mismatch: %s requires numeric value\", field)\r\n   247\t\t}\r\n   248\t\tc.fval = num\r\n   249\t\tc.isNum = true\r\n   250\t\treturn c, i + 3, nil\r\n   251\t}\r\n   252"]
[3550.111512, "o", "\t\r\n   253\tfunc tokenizeQuery(s string) ([]string, error) {\r\n   254\t\tvar tokens []string\r\n   255\t\ti := 0\r\n   256\t\tfor i < len(s) {\r\n   257\t\t\tch := s[i]\r\n   258\t\t\tif ch == ' ' || ch == '\\t' || ch == '\\n' || ch == '\\r' {\r\n   259\t\t\t\ti++\r\n   260\t\t\t\tcontinue\r\n   261\t\t\t}\r\n   262\t\t\tif ch == '\"' {\r\n   263\t\t\t\tj := i + 1\r\n   264\t\t\t\tfor j < len(s) && s[j] != '\"' {\r\n   265\t\t\t\t\tj++\r\n   266\t\t\t\t}\r\n   267\t\t\t\tif j >= len(s) {\r\n   268\t\t\t\t\treturn nil, fmt.Errorf(\"unterminated string\")\r\n   269\t\t\t\t}\r\n   270\t\t\t\ttokens = append(tokens, s[i:j+1])\r\n   271\t\t\t\ti = j + 1\r\n   272\t\t\t\tcontinue"]
[3550.111592, "o", "\r\n   273\t\t\t}\r\n   274\t\t\tif strings.HasPrefix(s[i:], \">=\") || strings.HasPrefix(s[i:], \"<=\") || strings.HasPrefix(s[i:], \"==\") || strings.HasPrefix(s[i:], \"!=\") {\r\n   275\t\t\t\ttokens = append(tokens, s[i:i+2])\r\n   276\t\t\t\ti += 2\r\n   277\t\t\t\tcontinue\r\n   278\t\t\t}\r\n   279\t\t\tif ch == '>' || ch == '<' {\r\n   280\t\t\t\ttokens = append(tokens, string(ch))\r\n   281\t\t\t\ti++\r\n   282\t\t\t\tcontinue\r\n   283\t\t\t}\r\n"]
[3550.111659, "o", "   284\t\t\tj := i\r\n   285\t\t\tfor j < len(s) {\r\n   286\t\t\t\tc := s[j]\r\n   287\t\t\t\tif c == ' ' || c == '\\t' || c == '\\n' || c == '\\r' || c == '>' || c == '<' || c == '=' || c == '!' || c == '\"' {\r\n   288\t\t\t\t\tbreak\r\n   289\t\t\t\t}\r\n   290\t\t\t\tj++\r\n   291\t\t\t}\r\n   292\t\t\tif j == i {\r\n"]
[3550.111717, "o", "   293\t\t\t\treturn nil, fmt.Errorf(\"invalid character in query: %c\", ch)\r\n   294\t\t\t}\r\n   295\t\t\ttokens = append(tokens, s[i:j])\r\n   296\t\t\ti = j\r\n   297\t\t}\r\n   298\t\treturn tokens, nil\r\n   299\t}\r\n   300\t\r\n   301\tfunc isQuotedString(s string) bool {\r\n"]
[3550.111786, "o", "   302\t\treturn len(s) >= 2 && s[0] == '\"' && s[len(s)-1] == '\"'\r\n   303\t}\r\n   304\t\r\n   305\tfunc unquote(s string) string {\r\n   306\t\tif isQuotedString(s) {\r\n   307\t\t\treturn s[1 : len(s)-1]\r\n   308\t\t}\r\n"]
[3550.111848, "o", "   309\t\treturn s\r\n   310\t}\r\n"]
