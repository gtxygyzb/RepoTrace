[2041.415816, "o", "\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K344\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif cf.Signed {\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tvalid, signer := signatureDetails(cf.Path)\r\n\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif !valid {\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\u001b[32m\u001b[K349\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\u001b[01;31m\u001b[KType:\u001b[m\u001b[K     \"signature_invalid\",\r\n"]
[2041.415883, "o", "\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tSeverity: \"critical\",\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tDetails: map[string]interface{}{\r\n\u001b[32m\u001b[K352\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t\t\"file\":      cf.Filename,\r\n\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t\t\"signer_id\": signer,\r\n\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t\t\"valid\":     false,\r\n\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t},\r\n\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tSource: cf.Filename,\r\n"]
[2041.415949, "o", "\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t})\r\n\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K360\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K361\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t_, found := hashSet[cf.Provenance.ParentHash]\r\n"]
[2041.416042, "o", "\u001b[32m\u001b[K363\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif !found {\r\n\u001b[32m\u001b[K364\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\u001b[32m\u001b[K365\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\u001b[01;31m\u001b[KType:\u001b[m\u001b[K     \"provenance_chain_break\",\r\n\u001b[32m\u001b[K366\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tSeverity: \"high\",\r\n\u001b[32m\u001b[K367\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tDetails: map[string]interface{}{\r\n\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t\t\"file\":        cf.Filename,\r\n\u001b[32m\u001b[K369\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t\t\"parent_hash\": cf.Provenance.ParentHash,\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t\t\"found\":       false,\r\n\u001b[32m\u001b[K371\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t},\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tSource: cf.Filename,\r\n\u001b[32m\u001b[K373\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t})"]
[2041.416102, "o", "\r\n\u001b[32m\u001b[K374\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K443\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tunique = append(unique, h)\r\n\u001b[32m\u001b[K444\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n"]
[2041.416162, "o", "\u001b[32m\u001b[K445\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tsort.Strings(unique)\r\n\u001b[32m\u001b[K446\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\u001b[32m\u001b[K447\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[KType:\u001b[m\u001b[K     \"dataset_hash_inconsistency\",\r\n\u001b[32m\u001b[K448\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tSeverity: \"high\",\r\n\u001b[32m\u001b[K449\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tDetails: map[string]interface{}{\r\n\u001b[32m\u001b[K450\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t\"files\":  chain,\r\n"]
[2041.41622, "o", "\u001b[32m\u001b[K451\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\t\"hashes\": unique,\r\n\u001b[32m\u001b[K452\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t},\r\n\u001b[32m\u001b[K453\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tSource: chain[0],\r\n\u001b[32m\u001b[K454\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t})\r\n\u001b[32m\u001b[K455\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K456\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[2041.416281, "o", "\u001b[32m\u001b[K457\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn anomalies\r\n\u001b[32m\u001b[K458\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K459\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
