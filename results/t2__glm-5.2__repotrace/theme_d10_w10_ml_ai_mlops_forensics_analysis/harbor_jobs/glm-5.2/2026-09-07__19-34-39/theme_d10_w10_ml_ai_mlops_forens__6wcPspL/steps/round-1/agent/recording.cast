[5441.451712, "o", "   200\t\t\tstartIdx := lossEntries[i-50]\r\n   201\t\t\tendIdx := lossEntries[i]\r\n   202\t\t\tstart := *entries[startIdx].Loss\r\n   203\t\t\tend := *entries[endIdx].Loss\r\n   204\t\t\tif math.Abs(start) <= 1e-6 {\r\n   205\t\t\t\tcontinue\r\n   206\t\t\t}\r\n   207\t\t\tratio := (end - start) / math.Abs(start)\r\n   208\t\t\tif ratio > 1.0 {\r\n   209\t\t\t\tseverity := \"high\"\r\n   210\t\t\t\tif ratio > 5.0 {\r\n   211\t\t\t\t\tseverity = \"critical\"\r\n"]
