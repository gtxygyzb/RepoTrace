[5441.453747, "o", "   437\tfunc detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {\r\n   438\t\tbyHash := map[string]*types.CheckpointFile{}\r\n   439\t\tfor _, cf := range cps {\r\n   440\t\t\tbyHash[cf.FileHash] = cf\r\n   441\t\t}\r\n   442\t\tchildren := map[string][]string{}\r\n   443\t\tfor _, cf := range cps {\r\n   444\t\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n   445\t\t\t\tif _, ok := byHash[cf.Provenance.ParentHash]; ok {\r\n   446\t\t\t\t\tchildren[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)\r\n   447\t\t\t\t}\r\n   448\t\t\t}\r\n   449\t\t}\r\n   450\t\r\n   451\t\tvar anomalies []types.Anomaly\r\n"]
[5441.453836, "o", "   452\t\tseen := map[string]bool{}\r\n   453\t\tfor _, cf := range cps {\r\n   454\t\t\tif cf.Provenance == nil {\r\n   455\t\t\t\tcontinue\r\n   456\t\t\t}\r\n   457\t\t\troot := cf.FileHash\r\n   458\t\t\tfor root != \"\" {\r\n   459\t\t\t\tparent, ok := byHash[root]\r\n   460\t\t\t\tif !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == \"\" {\r\n   461\t\t\t\t\tbreak\r\n   462\t\t\t\t}\r\n"]
[5441.453927, "o", "   463\t\t\t\troot = parent.Provenance.ParentHash\r\n   464\t\t\t}\r\n   465\t\t\tif seen[root] {\r\n   466\t\t\t\tcontinue\r\n   467\t\t\t}\r\n   468\t\t\tseen[root] = true\r\n   469\t\r\n   470\t\t\tchain := []string{}\r\n   471\t\t\tqueue := []string{root}\r\n   472\t\t\tvisited := map[string]bool{}\r\n   473\t\t\tfor len(queue) > 0 {\r\n   474\t\t\t\tcur := queue[0]\r\n   475\t\t\t\tqueue = queue[1:]\r\n   476"]
[5441.454029, "o", "\t\t\t\tif visited[cur] {\r\n   477\t\t\t\t\tcontinue\r\n   478\t\t\t\t}\r\n   479\t\t\t\tvisited[cur] = true\r\n   480\t\t\t\tnode, ok := byHash[cur]\r\n   481\t\t\t\tif !ok || node == nil {\r\n   482\t\t\t\t\tcontinue\r\n   483\t\t\t\t}\r\n   484\t\t\t\tchain = append(chain, node.Filename)\r\n   485\t\t\t\tqueue = append(queue, children[cur]...)\r\n   486\t\t\t}\r\n   487\t\t\tsort.Strings(chain)\r\n"]
[5441.454115, "o", "   488\t\r\n   489\t\t\thashes := map[string]struct{}{}\r\n   490\t\t\tfor _, h := range chain {\r\n   491\t\t\t\tif node, ok := byHashFile(cps, h); ok && node.Provenance != nil {\r\n   492\t\t\t\t\thashes[node.Provenance.DatasetHash] = struct{}{}\r\n   493\t\t\t\t}\r\n   494\t\t\t}\r\n   495\t\t\tif len(hashes) > 1 {\r\n   496\t\t\t\tunique := make([]string, 0, len(hashes))\r\n   497\t\t\t\tfor h := range hashes {\r\n   498\t\t\t\t\tunique = append(unique, h)\r\n"]
[5441.454201, "o", "   499\t\t\t\t}\r\n   500\t\t\t\tsort.Strings(unique)\r\n   501\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   502\t\t\t\t\tType:     \"dataset_hash_inconsistency\",\r\n   503\t\t\t\t\tSeverity: \"high\",\r\n   504\t\t\t\t\tDetails: map[string]interface{}{\r\n   505\t\t\t\t\t\t\"files\":  chain,\r\n   506\t\t\t\t\t\t\"hashes\": unique,\r\n   507\t\t\t\t\t},\r\n   508\t\t\t\t\tEvidence: map[string]interface{}{},\r\n   509\t\t\t\t\tSource:   chain[0],\r\n"]
