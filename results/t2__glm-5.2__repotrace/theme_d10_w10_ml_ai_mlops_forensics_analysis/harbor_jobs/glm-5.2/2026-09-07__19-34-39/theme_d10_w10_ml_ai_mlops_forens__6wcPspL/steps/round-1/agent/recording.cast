[1723.33542, "o", "func sortTimeline(entries []types.TimelineEntry) {\r\n\tsort.Slice(entries, func(i, j int) bool {\r\n\t\tif entries[i].Epoch != entries[j].Epoch {\r\n\t\t\treturn entries[i].Epoch < entries[j].Epoch\r\n\t"]
[1723.335529, "o", "\t}\r\n\t\treturn entries[i].Step < entries[j].Step\r\n\t})\r\n}\r\n\r\nfunc detectGaps(entries []types.TimelineEntry) []TimelineGap {\r\n\tvar gaps []TimelineGap\r\n\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]\r\n\t\tif prev.Epoch != cur.Epoch {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tdiff := cur.Step - prev.Step\r\n\t\tif diff > 100 {\r\n\t\t\tgaps = append(gaps, TimelineGap{\r\n\t\t\t\tAfterStep:  prev.Step,\r\n\t\t\t\tBeforeStep: cur.Step,\r\n"]
[1723.335599, "o", "\t\t\t\tEpoch:      prev.Epoch,\r\n\t\t\t\tGapSteps:   diff,\r\n\t\t\t\tAfterTs:    prev.Ts,\r\n\t\t\t\tBeforeTs:   cur.Ts,\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn gaps\r\n}\r\n\r\nfunc readConfigSummary(path string) (IngestConfig, error) {\r\n\traw, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn IngestConfig{}, err\r\n"]
[1723.336147, "o", "\u001b[?2004h"]
[1723.336209, "o", "root@n30009:/app# "]
[1729.593103, "i", "sed -n '90,260p' internal/forensics/detect.go\n"]
[1729.593364, "o", "sed -n '90,260p' internal/forensics/detect.go\r\n\u001b[?2004l\r"]
[1729.596157, "o", "\tanomalies = append(anomalies, detectGradientSpikes(entries)...)\r\n\tanomalies = append(anomalies, detectLossDivergence(entries)...)\r\n\tanomalies = append(anomalies, detectLrAnomalies(entries)...)\r\n\tanomalies = append(anomalies, detectTrainingGaps(entries)...)\r\n\tanomalies = append(anomalies, detectMetricRegression(entries)...)\r\n\treturn anomalies\r\n"]
[1729.596263, "o", "}\r\n\r\nfunc detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar vals []float64\r\n\tvar idx []int\r\n\tfor i, e := range entries {\r\n\t\tif e.GradNorm != nil {\r\n\t\t\tvals = append(vals, *e.GradNorm)\r\n\t\t\tidx = append(idx, i)\r\n\t\t}\r\n\t}\r\n\tif len(vals) < 51 {\r\n\t\treturn nil\r\n\t}\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 50; i < len(vals); i++ {\r\n\t\twindow := vals[i-50 : i]\r\n\t\tmean := meanFloats(window)\r\n\t\tstd := stddevFloats(window, mean)\r\n\t\tobserved := vals[i]\r\n"]
[1729.596326, "o", "\t\tz := 0.0\r\n\t\tif std > 0 {\r\n\t\t\tz = (observed - mean) / std\r\n\t\t}\r\n\t\tif observed > mean+3.0*std && z > 3.0 {\r\n\t\t\tseverity := \"medium\"\r\n\t\t\tif z > 5.0 {\r\n\t\t\t\tseverity = \"high\"\r\n\t\t\t}\r\n\t\t\tep := entries[idx[i]].Epoch\r\n"]
[1729.596394, "o", "\t\t\tst := entries[idx[i]].Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"gradient_spike\",\r\n\t\t\t\tSeverity: severity,\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"observed\":      observed,\r\n\t\t\t\t\t\"window_mean\":   mean,\r\n\t\t\t\t\t\"window_stddev\": std,\r\n"]
[1729.596457, "o", "\t\t\t\t\t\"z_score\":       z,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(entries[idx[i]]),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar lossEntries []int\r\n\tfor i, e := range entries {\r\n"]
[1729.596516, "o", "\t\tif e.Loss != nil {\r\n\t\t\tlossEntries = append(lossEntries, i)\r\n\t\t}\r\n\t}\r\n\tif len(lossEntries) < 51 {\r\n\t\treturn nil\r\n\t}\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 50; i < len(lossEntries); i++ {\r\n\t\tstartIdx := lossEntries[i-50]\r\n\t\tendIdx := lossEntries[i]\r\n"]
[1729.596572, "o", "\t\tstart := *entries[startIdx].Loss\r\n\t\tend := *entries[endIdx].Loss\r\n\t\tif math.Abs(start) <= 1e-6 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tratio := (end - start) / math.Abs(start)\r\n\t\tif ratio > 1.0 {\r\n\t\t\tseverity := \"high\"\r\n\t\t\tif ratio > 5.0 {\r\n\t\t\t\tseverity = \"critical\"\r\n"]
[1729.596633, "o", "\t\t\t}\r\n\t\t\tep := entries[endIdx].Epoch\r\n\t\t\tst := entries[endIdx].Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"loss_divergence\",\r\n\t\t\t\tSeverity: severity,\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"loss_start\":        start,\r\n"]
[1729.59669, "o", "\t\t\t\t\t\"loss_end\":          end,\r\n\t\t\t\t\t\"increase_ratio\":    ratio,\r\n\t\t\t\t\t\"window_start_step\": entries[startIdx].Step,\r\n\t\t\t\t\t\"window_end_step\":   entries[endIdx].Step,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(entries[endIdx]),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n"]
[1729.596746, "o", "\treturn anomalies\r\n}\r\n\r\nfunc detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]\r\n\t\tif prev.Lr == nil || cur.Lr == nil {\r\n\t\t\tcontinue\r\n"]
[1729.596801, "o", "\t\t}\r\n\t\tif *cur.Lr > *prev.Lr {\r\n\t\t\tif cur.Event == \"epoch_end\" {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"lr_anomaly\",\r\n\t\t\t\tSeverity: \"medium\",\r\n"]
[1729.596856, "o", "\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"prev_lr\": *prev.Lr,\r\n\t\t\t\t\t\"curr_lr\": *cur.Lr,\r\n\t\t\t\t\t\"step\":    cur.Step,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(cur),\r\n\t\t\t})\r\n"]
[1729.596913, "o", "\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]\r\n\t"]
[1729.597009, "o", "\tif prev.Epoch != cur.Epoch {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tprevT, err1 := time.Parse(time.RFC3339, prev.Ts)\r\n\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\r\n\t\tif err1 != nil || err2 != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tdiff := curT.Sub(prevT).Seconds()\r\n\t\tif diff > 7200 {\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"training_gap\",\r\n"]
[1729.597071, "o", "\t\t\t\tSeverity: \"low\",\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"after_step\":  prev.Step,\r\n\t\t\t\t\t\"before_step\": cur.Step,\r\n"]
[1729.597144, "o", "\t\t\t\t\t\"after_ts\":    prev.Ts,\r\n\t\t\t\t\t\"before_ts\":   cur.Ts,\r\n\t\t\t\t\t\"gap_seconds\": diff,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n"]
[1729.597199, "o", "\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar cps []types.TimelineEntry\r\n\tfor _, e := range entries {\r\n"]
