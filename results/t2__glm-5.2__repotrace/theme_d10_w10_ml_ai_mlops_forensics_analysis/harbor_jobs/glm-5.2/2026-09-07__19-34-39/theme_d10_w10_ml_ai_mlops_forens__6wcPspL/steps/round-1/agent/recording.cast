[282.684761, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"strings\"\r\n     8\t)\r\n     9\t\r\n    10\tfunc main() {\r\n    11\t\t// --- Parse flags ---------------------------------------------------\r\n    12\t\tformat := \"json\"\r\n    13"]
[282.684891, "o", "\t\tverbose := false\r\n    14\t\tvar positional []string\r\n    15\t\r\n    16\t\tfor _, arg := range os.Args[1:] {\r\n    17\t\t\tswitch {\r\n    18\t\t\tcase arg == \"--verbose\":\r\n    19\t\t\t\tverbose = true\r\n    20\t\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n    21\t\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n    22\t\t\tcase arg == \"--format\":\r\n    23\t\t\t\t// handled below as two-token flag\r\n    24\t\t\tdefault:\r\n    25\t\t\t\tpositional = append(positional, arg)\r\n    26\t\t\t}\r\n    27\t\t}\r\n    28\t\r\n    29\t\t// Handle \"--format json\" (two separate tokens)\r\n    30\t\tfor i := 1; i < len(os.Args)-1; i++ {\r\n    31\t\t\tif os.Args[i] == \"--format\" {\r\n    32\t\t\t\tformat = os.Args[i+1]\r\n    33\t\t\t\t// Remove the value from positional args\r\n"]
[282.684974, "o", "    34\t\t\t\tfiltered := positional[:0]\r\n    35\t\t\t\tfor _, p := range positional {\r\n    36\t\t\t\t\tif p != os.Args[i+1] {\r\n    37\t\t\t\t\t\tfiltered = append(filtered, p)\r\n    38\t\t\t\t\t}\r\n    39\t\t\t\t}\r\n"]
[282.685095, "o", "    40\t\t\t\tpositional = filtered\r\n    41\t\t\t\tbreak\r\n    42\t\t\t}\r\n    43\t\t}\r\n    44\t\r\n    45\t\tif format != \"json\" && format != \"text\" {\r\n    46\t\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json or text\\n\", format)\r\n    47\t\t\tos.Exit(1)\r\n    48\t\t}\r\n    49\t\r\n    50\t\t_ = verbose // will be used by command implementations later\r\n    51\t\r\n    52\t\t// --- Validate positional args --------------------------------------\r\n    53\t\tif len(positional) < 2 {\r\n    54\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n    55\t\t\tos.Exit(1)\r\n    56\t\t}\r\n    57\t\r\n    58\t\tcmd := positional[0]\r\n    59\t\tdir := positional[1]\r\n    60\t"]
[282.685159, "o", "\r\n    61\t\t// --- Route to command handler --------------------------------------\r\n    62\t\tvar result interface{}\r\n    63\t\tvar err error\r\n    64\t\r\n    65\t\tswitch cmd {\r\n    66\t\tcase \"ingest\":\r\n    67\t\t\tresult, err = buildIngest(dir)\r\n    68\t\tcase \"timeline\":\r\n    69\t\t\tresult, err = buildTimeline(dir)\r\n"]
[282.685218, "o", "    70\t\tcase \"verify\":\r\n    71\t\t\tresult, err = buildVerify(dir)\r\n    72\t\tcase \"detect\":\r\n    73\t\t\tresult, err = buildDetect(dir)\r\n    74\t\tcase \"lineage\":\r\n    75\t\t\tresult, err = buildLineage(dir)\r\n    76\t\tcase \"query\":\r\n    77"]
[282.685277, "o", "\t\t\tif len(positional) < 3 {\r\n    78\t\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n    79\t\t\t\tos.Exit(1)\r\n    80\t\t\t}\r\n    81\t\t\tresult, err = buildQuery(dir, positional[2])\r\n    82\t\tcase \"report\":\r\n    83\t\t\tresult, err = buildReport(dir)\r\n    84\t\tdefault:\r\n"]
[282.68534, "o", "    85\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n    86\t\t\tos.Exit(1)\r\n    87\t\t}\r\n    88\t\r\n    89\t\t// --- Output --------------------------------------------------------\r\n    90\t\tif err != nil {\r\n    91\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n    92\t\t\tos.Exit(1)\r\n    93\t\t}\r\n"]
