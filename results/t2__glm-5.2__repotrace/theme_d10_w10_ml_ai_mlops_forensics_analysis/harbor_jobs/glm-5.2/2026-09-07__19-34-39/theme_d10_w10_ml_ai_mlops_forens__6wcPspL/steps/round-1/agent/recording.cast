[4479.559408, "o", "\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n"]
[4479.559476, "o", "\t\t\t\t\t\"prev_acc\":        *prev.Acc,\r\n\t\t\t\t\t\"curr_acc\":        *cur.Acc,\r\n"]
