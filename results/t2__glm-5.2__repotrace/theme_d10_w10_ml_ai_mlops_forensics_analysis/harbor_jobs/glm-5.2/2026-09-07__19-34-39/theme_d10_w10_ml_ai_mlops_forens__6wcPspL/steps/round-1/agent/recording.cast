[2942.832509, "o", "grep -R \"Dtype\\|dtype\\|float32\\|0x\\|byte(\" -n internal/types internal/checkpoint | head -80\r\n\u001b[?2004l\r"]
[2942.836706, "o", "internal/types/types.go:32:\tDtype byte     `json:\"dtype\"`\r\ninternal/checkpoint/parser.go:129:\t// dtype (1 byte)\r\ninternal/checkpoint/parser.go:131:\t\treturn fail(\"unexpected EOF reading dtype\")\r\ninternal/checkpoint/parser.go:133:\tdtype := raw[off]\r\ninternal/checkpoint/parser.go:182:\t\tDtype: dtype,\r\n"]
[2942.837188, "o", "\u001b[?2004h"]
[2942.837283, "o", "root@n30009:/app# "]
[2943.118525, "i", "sed -n '1,120p' internal/checkpoint/parser.go\n"]
[2943.118903, "o", "sed -n '1,120p' internal/checkpoint/parser.go\r\n\u001b[?2004l\r"]
[2943.12183, "o", "package checkpoint\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n"]
[2943.121993, "o", "\t\"fmt\"\r\n\t\"hash/fnv\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\r\n\t\"mlforge/internal/types\"\r\n)\r\n"]
[2943.12207, "o", "\r\nconst (\r\n\tmagicMLCK  = \"MLCK\"\r\n\theaderSize = 56\r\n)\r\n\r\n// Parse reads and validates a single .mlck checkpoint file according to the\r\n// MLCK binary format specification (see /app/docs/formats.md).\r\nfunc Parse(path string) (*types.CheckpointFile, error) {\r\n\traw, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: read %s: %w\", path, err)\r\n\t}\r\n\tif len(raw) < headerSize {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: file too small (%d bytes)\", len(raw))\r\n\t}\r\n\r\n\t// --- magic (offset 0, 4 bytes) ---\r\n\tif string(raw[0:4]) != magicMLCK {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: bad magic %q\", raw[0:4])\r\n\t}\r\n\r\n\t// --- header fields ---\r\n\tversion := binary.LittleEndian.Uint16(raw[4:6])\r\n\tflags := binary.LittleEndian.Uint16(raw[6:8])\r\n\tnumTensors := binary.LittleEndian.Uint32(raw[8:12])\r\n\tnumMetadata := binary.LittleEndian.Uint32(raw[12:16])\r\n\tmetadataOffset := binary.LittleEndian.Uint64(raw[16:24])\r\n\tprovenanceOffset := binary.LittleEndian.Uint64(raw[24:32])\r\n\t_ = binary.LittleEndian.Uint64(raw["]
[2943.122159, "o", "32:40]) // signatureOffset (unused for now)\r\n\tcreationTimestamp := int64(binary.LittleEndian.Uint64(raw[40:48]))\r\n\tstoredChecksum := binary.LittleEndian.Uint64(raw[48:56])\r\n\r\n\t// --- verify header checksum: FNV-1a of bytes [0..48) ---\r\n\th := fnv.New64a()\r\n\th.Write(raw[:48])\r\n\tcomputedChecksum := h.Sum64()\r\n\theaderValid := computedChecksum == storedChecksum\r\n\r\n\t// --- SHA-256 file hash ---\r\n\tfileHashBytes := sha256.Sum256(raw)\r\n\tfileHash := hex.EncodeToString(fileHashBytes[:])\r\n\r\n\tsigned := flags&1 != 0\r\n\r\n\tcf := &types.CheckpointFile{\r\n\t\tPath:              path,\r\n\t\tFilename:          filepath.Base(path),\r\n\t\tVersion:           uint32(version),\r\n\t\tFlags:             flags,\r\n"]
[2943.122226, "o", "\t\tNumTensors:        numTensors,\r\n\t\tNumMetadataKeys:   numMetadata,\r\n\t\tCreationTimestamp:  creationTimestamp,\r\n\t\tHeaderValid:       headerValid,\r\n\t\tFileHash:          fileHash,\r\n\t\tSigned:            signed,\r\n\t}\r\n\r\n\t// --- parse tensor blocks (start at offset 56) ---\r\n\toff := headerSize\r\n\ttensors := make([]types.TensorInfo, 0, numTensors)\r\n\tfor i := uint32(0); i < numTensors; i++ {\r\n"]
[2943.122292, "o", "\t\tti, newOff, err := parseTensor(raw, off, i)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\ttensors = append(tensors, ti)\r\n\t\toff = newOff\r\n\t}\r\n\tcf.Tensors = tensors\r\n\r\n\t// --- parse metadata section ---\r\n\t"]
[2943.122354, "o", "if numMetadata > 0 && metadataOffset > 0 && int(metadataOffset) < len(raw) {\r\n\t\tmd, err := parseMetadata(raw, int(metadataOffset), numMetadata)\r\n\t\tif err == nil {\r\n\t\t\tcf.MetadataMap = md\r\n\t\t}\r\n\t}\r\n\r\n\t// --- parse provenance section ---\r\n\tif provenanceOffset > 0 && int(provenanceOffset) < len(raw) {\r\n\t\t"]
[2943.122411, "o", "prov, err := parseProvenance(raw, int(provenanceOffset))\r\n\t\tif err == nil {\r\n\t\t\tcf.Provenance = prov\r\n\t\t\tcf.HasParent = prov.ParentHash != \"\"\r\n\t\t\tcf.ParentHex = prov.ParentHash\r\n\t\t}\r\n\t}\r\n\r\n\treturn cf, nil\r\n}\r\n"]
[2943.122476, "o", "\r\n// parseTensor parses one tensor block starting at off and returns the\r\n// TensorInfo plus the new offset after the block.\r\nfunc parseTensor(raw []byte, off int, idx uint32) (types.TensorInfo, int, error) {\r\n\tfail := func(msg string) (types.TensorInfo, int, error) {\r\n\t\treturn types.TensorInfo{}, 0, fmt.Errorf(\"checkpoint: tensor %d: %s\", idx, msg)\r\n\t}\r\n\r\n\t// name_len (uint16 LE)\r\n\tif off+2 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading name_len\")\r\n\t}\r\n"]
[2943.122535, "o", "\tnameLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n"]
[2943.123034, "o", "\u001b[?2004h"]
[2943.123099, "o", "root@n30009:/app# "]
[2943.403305, "i", "nl -ba docs/spec.md | sed -n '1,120p'\n"]
[2943.403631, "o", "nl -ba docs/spec.md | sed -n '1,120p'\r\n"]
[2943.403721, "o", "\u001b[?2004l\r"]
[2943.407277, "o", "     1\t# mlforge - ML Model Artifact Forensics Engine\r\n     2\t\r\n     3\t## Overview\r\n     4\t\r\n     5\t"]
[2943.407375, "o", "`mlforge` is a command-line tool for forensic analysis of machine learning model artifacts. Given a directory of evidence (model checkpoints, training log shards, configuration files), mlforge reconstructs training timelines, detects anomalies, verifies artifact integrity, builds model lineage graphs, and produces evidence-backed forensic reports.\r\n     6\t\r\n     7\t## CLI Interface\r\n     8\t\r\n     9\tThe binary is built as `mlforge` and placed at `/app/mlforge` (or on `$PATH` after `go install`).\r\n    10\t\r\n    11\t```\r\n    12\tmlforge <command> <evidence-dir> [flags]\r\n    13\t```\r\n    14\t\r\n    15\t### Commands\r\n    16\t\r\n    17\t| Command | Description |\r\n    18\t|---------|-------------|\r\n    19\t| `ingest` | Scan evidence directory, index all artifacts, print summary to stdout |\r\n    20\t| `timeline` | Reconstruct unified training timeline from log shards |\r\n"]
[2943.407453, "o", "    21\t| `verify` | Verify integrity of all checkpoint files |\r\n    22\t| `detect` | Run anomaly detection across all evidence |\r\n    23\t| `lineage` | Build and output model lineage DAG |\r\n    24\t| `query` | Query the unified timeline with filter expressions |\r\n    25\t| `report` | Generate full forensic report combining all analyses |\r\n    26\t\r\n    27\t### Global Flags\r\n    28\t\r\n    29\t| Flag | Type | Default | Description |\r\n    30\t|------|------|---------|-------------|\r\n    31\t| `--format` | string | `json` | Output format: `json` or `text` |\r\n    32\t"]
[2943.407518, "o", "| `--verbose` | bool | false | Enable verbose diagnostic output to stderr |\r\n    33\t\r\n    34\t### Command-Specific Behavior\r\n    35\t\r\n    36\t#### `ingest`\r\n    37\t\r\n    38\tScan `<evidence-dir>` recursively for:\r\n    39\t- `.mlck` files (model checkpoints)\r\n    40\t- `.jsonl` files (training log shards)\r\n    41\t- `.json` files matching `config_*.json` (training configurations)\r\n    42\t\r\n    43\t"]
[2943.40758, "o", "Output (JSON to stdout): see `/app/docs/output_schema.md` section \"Ingest Output\".\r\n    44\t\r\n    45\tIf the evidence directory does not exist or contains no recognizable artifacts, exit with code 1 and print an error to stderr.\r\n    46\t\r\n    47\t#### `timeline`\r\n    48\t\r\n    49\tParse all `.jsonl` log shards in `<evidence-dir>`, merge entries into a unified timeline.\r\n    50\t\r\n    51\t**Merge Rules** (detailed in `/app/docs/analysis_rules.md` section \"Timeline Reconstruction\"):\r\n    52\t- Entries are identified by `(epoch, step)` tuple\r\n"]
[2943.407649, "o", "    53\t- When multiple shards contain the same `(epoch, step)`, apply conflict resolution\r\n    54\t- Gaps in the step sequence are detected and reported\r\n    55\t\r\n    56\tOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Timeline Output\".\r\n    57\t\r\n    58\t#### `verify`\r\n    59\t\r\n    60\tFor each `.mlck` file in `<evidence-dir>`:\r\n    61\t1. Parse the file according to the MLCK format (see `/app/docs/formats.md`)\r\n    62\t2. Validate the header checksum\r\n    63\t3. Validate each tensor's SHA-256 data checksum\r\n    64\t4. If the file is signed (Flags bit 0), validate the HMAC-SHA256 signature\r\n    65\t5. Validate provenance fields are well-formed\r\n"]
[2943.407714, "o", "    66\t\r\n    67\tOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Verify Output\".\r\n    68\t\r\n    69\t#### `detect`\r\n    70\t\r\n    71\tRun all anomaly detection rules (defined in `/app/docs/analysis_rules.md`) across the evidence:\r\n    72\t- Timeline-based anomalies (from log shards)\r\n    73\t- Checkpoint integrity anomalies (from .mlck files)\r\n    74\t- Cross-artifact anomalies (correlating checkpoints with logs)\r\n"]
[2943.407826, "o", "    75\t\r\n    76\tOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Detect Output\".\r\n    77\t\r\n    78\t#### `lineage`\r\n    79\t\r\n    80\tBuild a directed acyclic graph of model checkpoint relationships using the `parent_hash` field from each checkpoint's provenance section.\r\n    81\t\r\n    82\t**Rules**:\r\n    83\t- Each checkpoint is a node identified by its SHA-256 file hash\r\n    84\t- An edge `A -> B` exists if B's `parent_hash` matches A's file hash\r\n    85\t- Root nodes have empty `parent_hash`\r\n    86\t- Orphan nodes reference a parent not present in the evidence set\r\n    87\t- If a cycle is detected, report it as an anomaly (the graph should be a DAG)\r\n    88\t\r\n    89\tOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Lineage Output\".\r\n    90\t\r\n    91\t#### `query`\r\n"]
[2943.407893, "o", "    92\t\r\n    93\t```\r\n    94\tmlforge query <evidence-dir> \"<expression>\"\r\n    95\t```\r\n    96\t\r\n    97\tFilter the unified timeline using the query expression language defined in `/app/docs/analysis_rules.md` section \"Query Language\".\r\n    98\t\r\n    99\tOutput (JSON to stdout): list of matching timeline entries.\r\n   100\t\r\n   101\t#### `report`\r\n   102\t\r\n"]
[2943.407987, "o", "   103\tGenerate a comprehensive forensic report by running all analyses (ingest, timeline, verify, detect, lineage) and combining results.\r\n   104\t\r\n   105\tOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Report Output\".\r\n   106\t\r\n   107\t## Exit Codes\r\n   108\t\r\n   109\t| Code | Meaning |\r\n   110\t|------|---------|\r\n   111\t| 0 | Success |\r\n   112\t| 1 | Input error (missing directory, no artifacts, invalid arguments) |\r\n   113\t| 2 | Parse error (corrupt or unreadable artifact) |\r\n   114\t\r\n   115\t"]
[2943.408051, "o", "When a parse error occurs for individual artifacts within a batch operation (e.g., one corrupt checkpoint among several), the tool should continue processing remaining artifacts, report the error in the output, and exit with code 0. Exit code 2 is only for cases where the error prevents any meaningful output.\r\n   116\t\r\n   117\t## Build\r\n   118\t\r\n   119\t```bash\r\n   120\tcd /app && go build -o mlforge ./cmd/mlforge\r\n"]
[2943.408567, "o", "\u001b[?2004h"]
