[2951.937475, "o", "\u001b[35m\u001b[Kinternal/checkpoint/parser.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// \u001b[01;31m\u001b[Kdtype\u001b[m\u001b[K (1 byte)\r\n\u001b[35m\u001b[Kinternal/checkpoint/parser.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn fail(\"unexpected EOF reading \u001b[01;31m\u001b[Kdtype\u001b[m\u001b[K\")\r\n\u001b[35m\u001b[Kinternal/checkpoint/parser.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kdtype\u001b[m\u001b[K := raw[off]\r\n"]
