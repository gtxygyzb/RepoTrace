[3549.816704, "o", "     1\tpackage forensics\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n"]
[3549.816801, "o", "     5\t\t\"strconv\"\r\n     6\t\t\"strings\"\r\n     7\t\t\"time\"\r\n     8\t\r\n     9\t\t\"mlforge/internal/types\"\r\n    10\t)\r\n    11\t\r\n    12\ttype QueryOutput struct {\r\n    13\t\tStatus  string                `json:\"status\"`\r\n    14\t\tQuery   string                `json:\"query\"`\r\n    15\t\tMatches int                   `json:\"matches\"`\r\n    16\t\tEntries []types.TimelineEntry `json:\"entries\"`\r\n    17\t}\r\n    18\t\r\n"]
[3549.816893, "o", "    19\tfunc BuildQuery(dir, expr string) (interface{}, error) {\r\n    20\t\tentries, _, err := loadTimelineEntries(dir)\r\n    21\t\tif err != nil {\r\n    22\t\t\treturn nil, err\r\n    23\t\t}\r\n    24\t\tmerged, _ := mergeTimeline(entries)\r\n    25\t\tsortTimeline(merged)\r\n    26\t\r\n    27\t\tq, err := parseQuery(expr)\r\n    28\t\tif err != nil {\r\n    29\t\t\treturn nil, err\r\n    30\t\t}\r\n    31\t"]
[3549.816993, "o", "\tmatches := []types.TimelineEntry{}\r\n    32\t\tfor _, e := range merged {\r\n    33\t\t\tif q.eval(e) {\r\n    34\t\t\t\tmatches = append(matches, e)\r\n    35\t\t\t}\r\n    36\t\t}\r\n    37\t\treturn QueryOutput{\r\n    38\t\t\tStatus:  \"ok\",\r\n    39\t\t\tQuery:   expr,\r\n    40\t\t\tMatches: len(matches),\r\n    41\t\t\tEntries: matches,\r\n    42\t\t}, nil\r\n"]
[3549.817066, "o", "    43\t}\r\n    44\t\r\n    45\ttype condition struct {\r\n    46\t\tfield string\r\n    47\t\top    string\r\n    48\t\tsval  string\r\n    49\t\tfval  float64\r\n    50\t\tisNum bool\r\n    51\t}\r\n    52\t\r\n    53\ttype orGroup struct {\r\n    54\t\tands []condition\r\n"]
[3549.817137, "o", "    55\t}\r\n    56\t\r\n    57\ttype query struct {\r\n    58\t\tors []orGroup\r\n    59\t}\r\n    60\t\r\n    61\tfunc (q query) eval(e types.TimelineEntry) bool {\r\n    62\t\tfor _, g := range q.ors {\r\n    63\t\t\tok := true\r\n    64\t\t\tfor _, c := range g.ands {\r\n    65\t\t\t\tif !c.eval(e) {\r\n    66\t\t\t\t\tok = false\r\n"]
[3549.817207, "o", "    67\t\t\t\t\tbreak\r\n    68\t\t\t\t}\r\n    69\t\t\t}\r\n    70\t\t\tif ok {\r\n    71\t\t\t\treturn true\r\n    72\t\t\t}\r\n    73\t\t}\r\n    74\t\treturn false\r\n    75\t}\r\n    76\t\r\n"]
[3549.81728, "o", "    77\tfunc (c condition) eval(e types.TimelineEntry) bool {\r\n    78\t\tswitch c.field {\r\n    79\t\tcase \"step\":\r\n    80\t\t\treturn compareNum(float64(e.Step), c)\r\n    81\t\tcase \"epoch\":\r\n    82\t\t\treturn compareNum(float64(e.Epoch), c)\r\n    83\t\tcase \"loss\":\r\n    84\t\t\treturn ptrCompareNum(e.Loss, c)\r\n    85\t\tcase \"lr\":\r\n    86\t\t\treturn ptrCompareNum(e.Lr, c)\r\n    87\t\tcase \"grad_norm\":\r\n"]
[3549.817355, "o", "    88\t\t\treturn ptrCompareNum(e.GradNorm, c)\r\n    89\t\tcase \"acc\":\r\n    90\t\t\treturn ptrCompareNum(e.Acc, c)\r\n    91\t\tcase \"event\":\r\n    92\t\t\treturn compareStr(e.Event, c)"]
[3549.817423, "o", "\r\n    93\t\tcase \"ts\":\r\n    94\t\t\treturn compareTs(e.Ts, c)\r\n    95\t\t}\r\n    96\t\treturn false\r\n    97\t}\r\n    98\t\r\n    99\tfunc compareNum(val float64, c condition) bool {\r\n   100\t\tif !c.isNum {\r\n   101\t\t\treturn false\r\n   102\t\t}\r\n   103\t\tswitch c.op {\r\n   104\t\tcase \">\":\r\n   105\t\t\treturn val > c.fval\r\n"]
[3549.817491, "o", "   106\t\tcase \"<\":\r\n   107\t\t\treturn val < c.fval\r\n   108\t\tcase \">=\":\r\n   109\t\t\treturn val >= c.fval\r\n   110\t\tcase \"<=\":\r\n   111\t\t\treturn val <= c.fval\r\n   112\t\tcase \"==\":\r\n   113\t\t\treturn absFloat(val-c.fval) <= 1e-9\r\n   114\t\tcase \"!=\":\r\n"]
[3549.81756, "o", "   115\t\t\treturn absFloat(val-c.fval) > 1e-9\r\n   116\t\t}\r\n   117\t\treturn false\r\n   118\t}\r\n   119\t\r\n   120\tfunc ptrCompareNum(p *float64, c condition) bool {\r\n   121\t\tif p == nil {\r\n   122\t\t\treturn false\r\n   123\t\t}\r\n   124\t\treturn compareNum(*p, c)\r\n   125\t}\r\n   126\t"]
[3549.817628, "o", "\r\n   127\tfunc compareStr(val string, c condition) bool {\r\n   128\t\tif c.isNum {\r\n   129\t\t\treturn false\r\n   130\t\t}\r\n   131\t\tswitch c.op {\r\n   132\t\tcase \"==\":\r\n   133\t\t\treturn val == c.sval\r\n   134\t\tcase \"!=\":\r\n   135\t\t\treturn val != c.sval\r\n   136"]
