[1875.674359, "o", "internal/checkpoint/parser.go:1:package checkpoint\r\ninternal/checkpoint/parser.go:22:// Parse reads and validates a single .mlck checkpoint file according to the\r\ninternal/checkpoint/parser.go:24:func Parse(path string) (*types.CheckpointFile, error) {\r\ninternal/checkpoint/parser.go:27:\t\treturn nil, fmt.Errorf(\"checkpoint: read %s: %w\", path, err)\r\ninternal/checkpoint/parser.go:30:\t\treturn nil, fmt.Errorf(\"checkpoint: file too small (%d bytes)\", len(raw))\r\ninternal/checkpoint/parser.go:35:\t\treturn nil, fmt.Errorf(\"checkpoint: bad magic %q\", raw[0:4])\r\ninternal/checkpoint/parser.go:61:\tcf := &types.CheckpointFile{\r\ninternal/checkpoint/parser.go:112:\t\treturn types.TensorInfo{}, 0, fmt.Errorf(\"checkpoint: tensor %d: %s\", idx, msg)\r\ninternal/checkpoint/parser.go:328:func ParseAll(dir string) ([]*types.CheckpointFile, error) {\r\ninternal/checkpoint/parser.go:331:\t\treturn nil, fmt.Errorf(\"checkpoint: read dir %s: %w\", dir, err)\r\ninternal/checkpoint/parser.go:334:\tvar results []*types.CheckpointFile\r\ninternal/types/t"]
[1875.67445, "o", "ypes.go:17:// Anomaly represents one detected anomaly in the detect command.\r\ninternal/types/types.go:18:type Anomaly struct {\r\ninternal/types/types.go:28:// TensorInfo holds metadata for one tensor in a checkpoint.\r\ninternal/types/types.go:38:// Provenance holds the provenance section data from an MLCK checkpoint.\r\ninternal/types/types.go:53:// CheckpointFile represents a parsed .mlck checkpoint.\r\ninternal/types/types.go:54:type CheckpointFile struct {\r\ninternal/forensics/detect.go:15:\t\"mlforge/internal/checkpoint\"\r\ninternal/forensics/detect.go:19:func loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {\r\ninternal/forensics/detect.go:24:\tvar cps []*types.CheckpointFile\r\ninternal/forensics/detect.go:25:\tfor _, p := range ap.Checkpoints {\r\ninternal/forensics/detect.go:26:\t\tcf, err := checkpoint.Parse(p)\r\ninternal/forensics/detect.go:40:\tAnomalies []types.Anomaly `json:\"anomalies\"`\r\ninternal/forensics/detect.go:55:\tvar anomalies []types.Anomaly\r\ninternal/forensics/detect.go:64:\tcps, err := loadCheckpo"]
[1875.674533, "o", "ints(dir)\r\ninternal/forensics/detect.go:66:\t\tanomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\r\ninternal/forensics/detect.go:76:\t\tout.Anomalies = []types.Anomaly{}\r\ninternal/forensics/detect.go:88:func detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\ninternal/forensics/detect.go:89:\tvar anomalies []types.Anomaly\r\ninternal/forensics/detect.go:98:func detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\ninternal/forensics/detect.go:110:\tvar anomalies []types.Anomaly\r\ninternal/forensics/detect.go:127:\t\t\tanomalies = append(anomalies, types.Anomaly{\r\ninternal/forensics/detect.go:145:func detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\ninternal/forensics/detect.go:155:\tvar anomalies []types.Anomaly\r\ninternal/forensics/detect.go:172:\t\t\tanomalies = append(anomalies, types.Anomaly{\r\ninternal/forensics/detect.go:191:func detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\ninternal/forensics/detect.go:192:\tvar anomalies"]
[1875.674609, "o", " []types.Anomaly\r\ninternal/forensics/detect.go:205:\t\t\tanomalies = append(anomalies, types.Anomaly{\r\ninternal/forensics/detect.go:222:func detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\r\ninternal/forensics/detect.go:223:\tvar anomalies []types.Anomaly\r\ninternal/forensics/detect.go:239:\t\t\tanomalies = append(anomalies, types.Anomaly{\r\ninternal/forensics/detect.go:258:func detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {\r\ninternal/forensics/detect.go:261:\t\tif e.Event == \"checkpoint\" {\r\ninternal/forensics/detect.go:266:\tvar anomalies []types.Anomaly\r\ninternal/forensics/detect.go:277:\t\t\tanomalies = append(anomalies, types.Anomaly{\r\ninternal/forensics/detect.go:286:\t\t\t\t\t\"prev_checkpoint\": prev.Step,\r\ninternal/forensics/detect.go:287:\t\t\t\t\t\"curr_checkpoint\": cur.Step,\r\ninternal/forensics/detect.go:296:func detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {\r\ninternal/forensics/detect.go:297:\tvar anomalies []types.Anomaly\r\ninternal/forensics/de"]
