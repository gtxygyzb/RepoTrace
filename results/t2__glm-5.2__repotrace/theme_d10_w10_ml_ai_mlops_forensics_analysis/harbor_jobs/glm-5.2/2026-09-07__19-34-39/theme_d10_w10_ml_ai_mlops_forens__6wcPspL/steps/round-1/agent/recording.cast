[2842.427021, "o", "     1\tpackage checkpoint\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/sha256\"\r\n     5\t\t\"encoding/binary\"\r\n     6\t\t"]
[2842.427104, "o", "\"encoding/hex\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"hash/fnv\"\r\n     9\t\t\"math\"\r\n    10\t\t\"os\"\r\n    11\t\t\"path/filepath\"\r\n    12\t\t\"strings\"\r\n    13\t\r\n    14\t\t\"mlforge/internal/types\"\r\n    15\t)\r\n    16\t\r\n    17\tconst (\r\n"]
[2842.427188, "o", "    18\t\tmagicMLCK  = \"MLCK\"\r\n    19\t\theaderSize = 56\r\n    20\t)\r\n    21\t\r\n    22\t// Parse reads and validates a single .mlck checkpoint file according to the\r\n    23\t// MLCK binary format specification (see /app/docs/formats.md).\r\n    24\tfunc Parse(path string) (*types.CheckpointFile, error) {\r\n"]
[2842.427262, "o", "    25\t\traw, err := os.ReadFile(path)\r\n    26\t\tif err != nil {\r\n    27\t\t\treturn nil, fmt.Errorf(\"checkpoint: read %s: %w\", path, err)\r\n    28\t\t}\r\n    29\t\tif len(raw) < headerSize {\r\n    30\t\t\treturn nil, fmt.Errorf(\"checkpoint: file too small (%d bytes)\", len(raw))\r\n    31\t\t}\r\n    32\t\r\n    33\t\t// --- magic (offset 0, 4 bytes) ---\r\n    34\t\tif string(raw[0:4]) != magicMLCK {\r\n    35\t\t\treturn nil, fmt.Errorf(\"checkpoint: bad magic %q\", raw[0:4])\r\n"]
[2842.427332, "o", "    36\t\t}\r\n    37\t\r\n    38\t\t// --- header fields ---\r\n    39\t\tversion := binary.LittleEndian.Uint16(raw[4:6])\r\n    40\t\tflags := binary.LittleEndian.Uint16(raw[6:8])\r\n    41\t\tnumTensors := binary.LittleEndian.Uint32(raw[8:12])\r\n    42\t\tnumMetadata := binary.LittleEndian.Uint32(raw[12:16])\r\n    43\t\tmetadataOffset := binary.LittleEndian.Uint64(raw[16:24])\r\n    44\t\tprovenanceOffset := binary.LittleEndian.Uint64(raw[24:32])\r\n    45\t\t_ = binary.LittleEndian.Uint64(raw[32:40]) // signatureOffset (unused for now)\r\n    46\t\tcreationTimestamp := int64(binary.LittleEndian.Uint64(raw[40:48]))\r\n    47\t\tstoredChecksum := binary.LittleEndian.Uint64(raw[48:56])\r\n    48\t\r\n    49\t\t// --- verify header checksum: FNV-1a of bytes [0..48) ---\r\n    50"]
[2842.4274, "o", "\t\th := fnv.New64a()\r\n    51\t\th.Write(raw[:48])\r\n    52\t\tcomputedChecksum := h.Sum64()\r\n    53\t\theaderValid := computedChecksum == storedChecksum\r\n    54\t\r\n    55\t"]
[2842.427468, "o", "\t// --- SHA-256 file hash ---\r\n    56\t\tfileHashBytes := sha256.Sum256(raw)\r\n    57\t\tfileHash := hex.EncodeToString(fileHashBytes[:])\r\n    58\t\r\n    59\t\tsigned := flags&1 != 0\r\n    60\t\r\n    61\t\tcf := &types.CheckpointFile{\r\n    62\t\t\tPath:              path,\r\n    63\t\t\tFilename:          filepath.Base(path),\r\n    64\t\t\tVersion:           uint32(version),\r\n    65\t\t\tFlags:             flags,\r\n    66\t\t\tNumTensors:        numTensors,\r\n    67\t\t\tNumMetadataKeys:   numMetadata,\r\n    68\t\t\tCreationTimestamp:  creationTimestamp,\r\n    69\t\t\tHeaderValid:       headerValid,\r\n    70"]
[2842.427527, "o", "\t\t\tFileHash:          fileHash,\r\n    71\t\t\tSigned:            signed,\r\n    72\t\t}\r\n    73\t\r\n    74\t\t// --- parse tensor blocks (start at offset 56) ---\r\n    75\t\toff := headerSize\r\n    76\t\ttensors := make([]types.TensorInfo, 0, numTensors)\r\n    77\t\tfor i := uint32(0); i < numTensors; i++ {\r\n"]
[2842.427592, "o", "    78\t\t\tti, newOff, err := parseTensor(raw, off, i)\r\n    79\t\t\tif err != nil {\r\n    80\t\t\t\treturn nil, err\r\n    81\t\t\t}\r\n    82\t\t\ttensors = append(tensors, ti)\r\n    83\t\t\toff = newOff\r\n    84\t\t}\r\n    85\t\tcf.Tensors = tensors\r\n    86\t\r\n    87\t\t// --- parse metadata section ---\r\n    88"]
[2842.427652, "o", "\t\tif numMetadata > 0 && metadataOffset > 0 && int(metadataOffset) < len(raw) {\r\n    89\t\t\tmd, err := parseMetadata(raw, int(metadataOffset), numMetadata)\r\n    90\t\t\tif err == nil {\r\n    91\t\t\t\tcf.MetadataMap = md\r\n    92\t\t\t}\r\n    93\t\t}\r\n    94\t\r\n    95\t\t// --- parse provenance section ---\r\n    96\t\tif provenanceOffset > 0 && int(provenanceOffset) < len(raw) {\r\n"]
[2842.42771, "o", "    97\t\t\tprov, err := parseProvenance(raw, int(provenanceOffset))\r\n    98\t\t\tif err == nil {\r\n    99\t\t\t\tcf.Provenance = prov\r\n   100\t\t\t\tcf.HasParent = prov.ParentHash != \"\"\r\n   101\t\t\t\tcf.ParentHex = prov.ParentHash\r\n   102\t\t\t}\r\n   103\t\t}\r\n   104\t\r\n"]
[2842.427772, "o", "   105\t\treturn cf, nil\r\n   106\t}\r\n   107\t\r\n   108\t// parseTensor parses one tensor block starting at off and returns the\r\n   109\t// TensorInfo plus the new offset after the block.\r\n   110\tfunc parseTensor(raw []byte, off int, idx uint32) (types.TensorInfo, int, error) {\r\n   111\t\tfail := func(msg string) (types.TensorInfo, int, error) {\r\n   112\t\t\treturn types.TensorInfo{}, 0, fmt.Errorf(\"checkpoint: tensor %d: %s\", idx, msg)\r\n"]
[2842.427834, "o", "   113\t\t}\r\n   114\t\r\n   115\t\t// name_len (uint16 LE)\r\n   116\t\tif off+2 > len(raw) {\r\n   117\t\t\treturn fail(\"unexpected EOF reading name_len\")\r\n   118\t\t}\r\n   119\t\tnameLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   120\t\toff += 2\r\n"]
[2842.428411, "o", "\u001b[?2004h"]
