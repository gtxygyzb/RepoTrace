[3568.074645, "o", "   281\t\t\t\ti++\r\n   282\t\t\t\tcontinue\r\n   283\t\t\t}\r\n   284\t\t\tj := i\r\n"]
[3568.074729, "o", "   285\t\t\tfor j < len(s) {\r\n   286\t\t\t\tc := s[j]\r\n   287\t\t\t\tif c == ' ' || c == '\\t' || c == '\\n' || c == '\\r' || c == '>' || c == '<' || c == '=' || c == '!' || c == '\"' {\r\n   288\t\t\t\t\tbreak\r\n   289\t\t\t\t}\r\n   290\t\t\t\tj++\r\n   291\t\t\t}\r\n   292\t\t\tif j == i {\r\n   293\t\t\t\treturn nil, fmt.Errorf(\"invalid character in query: %c\", ch)\r\n   294\t\t\t}\r\n   295\t\t\ttokens = append(tokens, s[i:j])\r\n"]
[3568.074798, "o", "   296\t\t\ti = j\r\n   297\t\t}\r\n   298\t\treturn tokens, nil\r\n   299\t}\r\n   300\t\r\n   301\tfunc isQuotedString(s string) bool {\r\n   302\t\treturn len(s) >= 2 && s[0] == '\"' && s[len(s)-1] == '\"'\r\n   303\t}\r\n   304\t\r\n   305\tfunc unquote(s string) string {\r\n   306\t\tif isQuotedString(s) {\r\n   307\t"]
[3568.07488, "o", "\t\treturn s[1 : len(s)-1]\r\n   308\t\t}\r\n   309\t\treturn s\r\n   310\t}\r\n"]
