[4433.382907, "o", "     1\tpackage forensics\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/hmac\"\r\n"]
[4433.383075, "o", "     5\t\t\"crypto/sha256\"\r\n     6\t\t\"encoding/binary\"\r\n     7\t\t\"encoding/hex\"\r\n     8\t\t\"fmt\"\r\n     9\t\t\"hash/fnv\"\r\n    10\t\t\"math\"\r\n    11\t\t\"os\"\r\n    12\t\t\"sort\"\r\n    13\t\t\"time\"\r\n    14\t\r\n    15\t\t\"mlforge/internal/checkpoint\"\r\n    16\t\t\"mlforge/internal/types\"\r\n    17\t)\r\n    18\t\r\n    19\tfunc loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {\r\n    20\t\tap, err := DiscoverArtifacts(dir)\r\n    21\t\tif err != nil {\r\n    22\t\t\treturn nil, err\r\n    23\t\t}\r\n    24\t\tvar cps []*types.CheckpointFile\r\n    25\t\tfor _, p := range ap.Checkpoints {\r\n    26\t\t\tcf, err := checkpoint.Parse(p)\r\n"]
[4433.38316, "o", "    27\t\t\tif err != nil || cf == nil {\r\n    28\t\t\t\tcontinue\r\n    29\t\t\t}\r\n    30\t\t\tcps = append(cps, cf)\r\n    31\t\t}\r\n    32\t\tsort.Slice(cps, func(i, j int) bool {\r\n    33\t\t\treturn cps[i].Filename < cps[j].Filename\r\n    34\t\t})\r\n    35\t\treturn cps, nil\r\n    36\t}\r\n    37\t\r\n    38\ttype DetectOutput struct {"]
[4433.383239, "o", "\r\n    39\t\tStatus    string          `json:\"status\"`\r\n    40\t\tAnomalies []types.Anomaly `json:\"anomalies\"`\r\n    41\t\tSummary   struct {\r\n    42\t\t\tTotal      int            `json:\"total\"`\r\n    43\t\t\tBySeverity map[string]int `json:\"by_severity\"`\r\n    44\t\t\tByType     map[string]int `json:\"by_type\"`\r\n    45\t\t} `json:\"summary\"`\r\n    46\t}\r\n    47\t\r\n    48\tfunc BuildDetect(dir string) (interface{}, error) {\r\n"]
[4433.383324, "o", "    49\t\treturn buildDetectWithDir(dir)\r\n    50\t}\r\n    51\t\r\n    52\tfunc buildDetectWithDir(dir string) (DetectOutput, error) {\r\n    53\t\tvar out DetectOutput\r\n    54\t\tout.Status = \"ok\"\r\n"]
[4433.383385, "o", "    55\t\tvar anomalies []types.Anomaly\r\n    56\t\r\n    57\t\tentries, _, err := loadTimelineEntries(dir)\r\n    58\t\tif err == nil {\r\n    59\t\t\tmerged, _ := mergeTimeline(entries)\r\n    60\t\t\tsortTimeline(merged)\r\n    61\t\t\tanomalies = append(anomalies, detectTimelineAnomalies(merged)...)\r\n    62\t\t}\r\n    63\t\r\n    64\t\tcps, err := loadCheckpoints(dir)\r\n    65\t\tif err == nil {\r\n    66\t\t\tanomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\r\n    67\t\t"]
[4433.383442, "o", "}\r\n    68\t\r\n    69\t\tfor i := range anomalies {\r\n    70\t\t\tanomalies[i].ID = fmt.Sprintf(\"ANOM-%03d\", i+1)\r\n    71\t\t}\r\n    72\t\tsortAnomalies(anomalies)\r\n    73\t\r\n    74\t\tout.Anomalies = anomalies\r\n    75\t\tif out.Anomalies == nil {\r\n    76\t"]
[4433.3835, "o", "\t\tout.Anomalies = []types.Anomaly{}\r\n    77\t\t}\r\n    78\t\tout.Summary.Total = len(anomalies)\r\n    79\t\tout.Summary.BySeverity = map[string]int{\"critical\": 0, \"high\": 0, \"medium\": 0, \"low\": 0}\r\n    80\t\tout.Summary.ByType = map[string]int{}\r\n    81\t\tfor _, a := range anomalies {\r\n    82\t\t\tout.Summary.BySeverity[a.Severity]++\r\n    83\t\t\tout.Summary.ByType[a.Type]++\r\n    84\t"]
[4433.383561, "o", "\t}\r\n    85\t\treturn out, nil\r\n    86\t}\r\n    87\t\r\n    88\tfunc detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n    89\t\tvar anomalies []types.Anomaly\r\n    90\t\tanomalies = append(anomalies, detectGradientSpikes(entries)...)\r\n    91\t\tanomalies = append(anomalies, detectLossDivergence(entries)...)\r\n    92\t\tanomalies = append(anomalies, detectLrAnomalies(entries)...)"]
[4433.383625, "o", "\r\n    93\t\tanomalies = append(anomalies, detectTrainingGaps(entries)...)\r\n    94\t\tanomalies = append(anomalies, detectMetricRegression(entries)...)\r\n    95\t\treturn anomalies\r\n    96\t}\r\n    97\t\r\n    98\tfunc detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n    99\t\tvar vals []float64\r\n"]
[4433.383696, "o", "   100\t\tvar idx []int\r\n   101\t\tfor i, e := range entries {\r\n   102\t\t\tif e.GradNorm != nil {\r\n   103\t\t\t\tvals = append(vals, *e.GradNorm)\r\n   104\t\t\t\tidx = append(idx, i)\r\n   105\t\t\t}\r\n   106\t\t}\r\n   107\t\tif len(vals) < 31 {\r\n   108\t\t\treturn nil\r\n"]
[4433.383754, "o", "   109\t\t}\r\n   110\t\tvar anomalies []types.Anomaly\r\n   111\t\tfor i := 30; i < len(vals); i++ {\r\n   112\t\t\twindow := vals[i-30 : i]\r\n   113\t\t\tmean := meanFloats(window)\r\n   114\t\t\tstd := stddevFloats(window, mean)\r\n   115\t\t\tobserved := vals[i]\r\n   116\t\t\tz := 0.0\r\n   117\t\t\tif std > 0 {\r\n   118"]
[4433.383811, "o", "\t\t\t\tz = (observed - mean) / std\r\n   119\t\t\t}\r\n   120\t\t\tif observed > mean+2.5*std && z > 2.5 {\r\n   121\t\t\t\tseverity := \"medium\"\r\n   122\t\t\t\tif z > 4.0 {\r\n   123\t\t\t\t\tseverity = \"high\"\r\n   124\t\t\t\t}\r\n   125\t\t\t\tep := entries[idx[i]].Epoch\r\n"]
[4433.383868, "o", "   126\t\t\t\tst := entries[idx[i]].Step\r\n   127\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   128\t\t\t\t\tType:     \"gradient_spike\",\r\n   129\t\t\t\t\tSeverity: severity,\r\n   130\t\t\t\t\tEpoch:    &ep,\r\n   131\t\t\t\t\tStep:     &st,\r\n   132\t\t\t\t\tDetails: map[string]interface{}{\r\n"]
[4433.383926, "o", "   133\t\t\t\t\t\t\"observed\":      observed,\r\n   134\t\t\t\t\t\t\"window_mean\":   mean,\r\n   135\t\t\t\t\t\t\"window_stddev\": std,\r\n   136\t\t\t\t\t\t\"z_score\":       z,\r\n   137\t\t\t\t\t},\r\n   138\t\t\t\t\tSource: firstSource(entries[idx[i]]),\r\n"]
[4433.384008, "o", "   139\t\t\t\t})\r\n   140\t\t\t}\r\n   141\t\t}\r\n   142\t\treturn anomalies\r\n   143\t}\r\n   144\t\r\n   145\tfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n   146\t\tvar lossEntries []int\r\n   147\t\tfor i, e := range entries {\r\n   148\t\t\tif e.Loss != nil {\r\n   149\t\t\t\tlossEntries = append(lossEntries, i)\r\n"]
[4433.38407, "o", "   150\t\t\t}\r\n   151\t\t}\r\n   152\t\tif len(lossEntries) < 51 {\r\n   153\t\t\treturn nil\r\n   154\t\t}\r\n   155\t\tvar anomalies []types.Anomaly\r\n   156\t\tfor i := 50; i < len(lossEntries); i++ {\r\n   157\t\t\tstartIdx := lossEntries[i-50]\r\n   158\t\t\tendIdx := lossEntries[i]\r\n"]
[4433.384128, "o", "   159\t\t\tstart := *entries[startIdx].Loss\r\n   160\t\t\tend := *entries[endIdx].Loss\r\n   161\t\t\tif math.Abs(start) <= 1e-6 {\r\n   162\t\t\t\tcontinue\r\n   163\t\t\t}\r\n   164\t\t\tratio := (end - start) / math.Abs(start)\r\n   165\t\t\tif ratio > 1.0 {\r\n   166\t\t\t\tseverity := \"high\"\r\n   167\t"]
