[5592.503543, "o", "\treturn out, nil\r\n}\r\n\r\nfunc severityRank(s string) int {\r\n\tswitch s {\r\n\tcase \"critical\":\r\n\t\treturn 0\r\n\t"]
[5592.503579, "o", "case \"high\":\r\n\t\treturn 1\r\n\tcase \"medium\":\r\n\t\treturn 2\r\n\tcase \"low\":\r\n\t\treturn 3\r\n"]
[5592.50369, "o", "\tcase \"info\":\r\n\t\treturn 4\r\n\t}\r\n\treturn 4\r\n"]
[5592.503707, "o", "}\r\n\r\nfunc severityRankValue(s string) (int, bool) {\r\n\tswitch s {\r\n\tcase \"critical\":\r\n\t\treturn 0, true\r\n\tcase \"high\":\r\n\t\treturn 1, true\r\n\tcase \"medium\":\r\n\t\treturn 2, true\r\n\tcase \"low\":\r\n\t\treturn 3, true\r\n\tcase \"info\":\r\n\t\treturn 4, true\r\n\t}\r\n"]
