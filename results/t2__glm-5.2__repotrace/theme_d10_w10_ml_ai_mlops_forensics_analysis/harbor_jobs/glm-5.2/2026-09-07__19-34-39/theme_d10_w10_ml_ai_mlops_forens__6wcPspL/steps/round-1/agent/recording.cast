[4508.356179, "o", "   458\t\t\t\t})\r\n   459\t\t\t}\r\n   460\t\t}\r\n   461\t\treturn anomalies\r\n   462\t}\r\n   463\t\r\n   464\tfunc byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {\r\n   465\t\tfor _, cf := range cps {\r\n   466\t\t\tif cf.Filename == file {\r\n   467\t\t\t\treturn cf, true\r\n   468\t\t\t}\r\n   469"]
