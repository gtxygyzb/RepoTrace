[2755.767234, "o", "\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K461\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\ta.\u001b[01;31m\u001b[Kconflict\u001b[m\u001b[K = true\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K467\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kconflict\u001b[m\u001b[Ks := 0\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K476\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\te.Conflict = a.\u001b[01;31m\u001b[Kconflict\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K477\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif a.\u001b[01;31m\u001b[Kconflict\u001b[m\u001b[K {\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K478\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kconflict\u001b[m\u001b[Ks++\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K482\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn result, \u001b[01;31m\u001b[Kconflict\u001b[m\u001b[Ks\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K516\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kdiff\u001b[m\u001b[K := cur.Step - prev.Step\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K517\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif \u001b[01;"]
[2755.767303, "o", "31m\u001b[Kdiff\u001b[m\u001b[K > 50 {\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K522\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tGapSteps:   \u001b[01;31m\u001b[Kdiff\u001b[m\u001b[K,\r\n"]
[2755.767443, "o", "\u001b[35m\u001b[Kcmd/mlforge/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Ktimeline\u001b[m\u001b[K\":\r\n"]
