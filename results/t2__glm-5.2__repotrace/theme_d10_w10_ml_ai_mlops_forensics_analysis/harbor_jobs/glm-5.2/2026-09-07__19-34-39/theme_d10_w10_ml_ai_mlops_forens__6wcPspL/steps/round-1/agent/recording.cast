[7297.836929, "o", "     9\t\tGeneratedAt string      `json:\"generated_at\"`\r\n    10\t\tEvidenceDir string      `json:\"evidence_dir\"`\r\n    11\t\tIngest      interface{} `json:\"ingest\"`\r\n    12\t\tTimeline    interface{} `json:\"timeline\"`\r\n    13\t\tVerify      interface{} `json:\"verify\"`\r\n    14\t\tDetect      interface{} `json:\"detect\"`\r\n    15\t\tLineage     interface{} `json:\"lineage\"`\r\n    16\t}\r\n    17\t\r\n    18\tfunc BuildReport(dir string) (interface{}, error) {\r\n    19\t\tvar report ReportOutput\r\n    20\t\treport.Version = \"1.0\"\r\n    21\t\treport.GeneratedAt = time.Now().UTC().Format(time.RFC3339)\r\n    22\t\treport.EvidenceDir = dir\r\n    23\t\r\n"]
[7297.837012, "o", "    24\t\treport.Ingest = safeBuild(func() (interface{}, error) { return BuildIngest(dir) })\r\n    25\t\treport.Timeline = safeBuild(func() (interface{}, error) { return BuildTimeline(dir) })\r\n    26\t\treport.Verify = safeBuild(func() (interface{}, error) { return BuildVerify(dir) })\r\n    27\t\treport.Detect = safeBuild(func() (interface{}, error) { return BuildDetect(dir) })\r\n    28\t\treport.Lineage = safeBuild(func() (interface{}, error) { return BuildLineage(dir) })\r\n    29\t\r\n    30\t\treturn report, nil\r\n    31\t}\r\n    32\t\r\n    33\tfunc safeBuild(fn func() (interface{}, error)) interface{} {\r\n    34\t\tv, err := fn()\r\n"]
[7297.837074, "o", "    35\t\tif err != nil {\r\n    36\t\t\treturn map[string]interface{}{\"status\": \"error\", \"message\": err.Error()}\r\n    37\t\t}\r\n    38\t\treturn v\r\n    39\t}\r\n"]
