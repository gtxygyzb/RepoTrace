[2049.572355, "o", "   296\tfunc detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {\r\n   297\t\tvar anomalies []types.Anomaly\r\n   298\t\thashSet := map[string]*types.CheckpointFile{}\r\n   299\t\tfor _, cf := range cps {\r\n   300\t\t\thashSet[cf.FileHash] = cf\r\n   301\t\t}\r\n   302\t\r\n   303\t\tfor _, cf := range cps {\r\n   304\t\t\traw, err := os.ReadFile(cf.Path)\r\n"]
[2049.572624, "o", "   305\t\t\tif err != nil {\r\n   306\t\t\t\tcontinue\r\n   307\t\t\t}\r\n   308\t\t\tif !cf.HeaderValid {\r\n   309\t\t\t\tstored := uint64(0)\r\n   310\t\t\t\tif len(raw) >= 56 {\r\n   311\t\t\t\t\tstored = binary.LittleEndian.Uint64(raw[48:56])\r\n   312\t\t\t\t}\r\n   313\t\t\t\th := fnv.New64a()\r\n   314\t\t\t\th.Write(raw[:48])\r\n   315\t\t\t\tcomputed := h.Sum64()\r\n   316\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   317\t\t\t\t\tType:     \"header_checksum_mismatch\",\r\n   318\t\t\t\t\tSeverity: \"critical\",\r\n   319\t\t\t\t\tDetails: map[string]interface{}{\r\n   320\t\t\t\t\t\t\"file\":              cf.Filename,\r\n   321\t\t\t\t\t\t\"expected_checksum\": fmt.Sprintf(\"%016x\", stored),\r\n   322\t\t\t\t\t\t\"actual_checksum\":   fmt.Sprintf(\"%016x\", computed),\r\n   323\t\t\t\t\t},\r\n   324\t\t\t\t\tSource: cf.Filename,\r\n   325\t\t\t\t})\r\n   326\t\t\t}\r\n   327\t\r\n"]
[2049.57275, "o", "   328\t\t\tfor _, t := range cf.Tensors {\r\n   329\t\t\t\tif !t.Valid {\r\n   330\t\t\t\t\tcomputed := sha256.Sum256(t.Data)\r\n   331\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   332\t\t\t\t\t\tType:     \"tensor_checksum_mismatch\",\r\n   333\t\t\t\t\t\tSeverity: \"critical\",\r\n   334\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   335\t\t\t\t\t\t\t\"file\":              cf.Filename,\r\n   336\t\t\t\t\t\t\t\"tensor_name\":       t.Name,\r\n   337\t\t\t\t\t\t\t\"expected_checksum\": hex.EncodeToString(t.Hash[:]),\r\n   338\t\t\t\t\t\t\t\"actual_checksum\":   hex.EncodeToString(computed[:]),\r\n   339\t\t\t\t\t\t},\r\n   340\t\t\t\t\t\tSource: cf.Filename,\r\n   341\t\t\t\t\t})\r\n   342\t\t\t\t}\r\n   343\t\t\t}\r\n   344\t\r\n   345\t\t\tif cf.Signed {\r\n   346\t\t\t\tvalid, signer := signatureDetails(cf.Path)\r\n   347\t\t\t\tif !valid {\r\n   348\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   349\t\t\t\t\t\tType:     \"signature_invalid\",\r\n   350\t\t\t\t\t\tSeverity: \"critical\",\r\n   351\t\t\t\t\t\tDetails: map[string]interface{}{\r\n"]
[2049.572964, "o", "   352\t\t\t\t\t\t\t\"file\":      cf.Filename,\r\n   353\t\t\t\t\t\t\t\"signer_id\": signer,\r\n   354\t\t\t\t\t\t\t\"valid\":     false,\r\n   355\t\t\t\t\t\t},\r\n   356\t\t\t\t\t\tSource: cf.Filename,\r\n   357\t\t\t\t\t})\r\n   358\t\t\t\t}\r\n   359\t\t\t}\r\n   360\t\r\n   361\t\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n   362\t\t\t\t_, found := hashSet[cf.Provenance.ParentHash]\r\n   363\t\t\t\tif !found {\r\n   364\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   365\t\t\t\t\t\tType:     \"provenance_chain_break\",\r\n   366\t\t\t\t\t\tSeverity: \"high\",\r\n   367\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   368\t\t\t\t\t\t\t\"file\":        cf.Filename,\r\n   369\t\t\t\t\t\t\t\"parent_hash\": cf.Provenance.ParentHash,\r\n   370\t\t\t\t\t\t\t\"found\":       false,\r\n   371\t\t\t\t\t\t},\r\n   372\t\t\t\t\t\tSource: cf.Filename,\r\n   373\t\t\t\t\t})\r\n   374\t\t\t\t}\r\n   375\t\t\t}\r\n   376\t\t}\r\n   377\t\r\n   378"]
[2049.573087, "o", "\t\tanomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)\r\n   379\t\treturn anomalies\r\n   380\t}\r\n"]
