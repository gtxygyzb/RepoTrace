[2966.93014, "o", "\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K|--------|------|------|-------|-------------|\r\n\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 0 | 4 | bytes | Magic | Must be `MLCK` (0x4D 0x4C 0x43 0x4B) |\r\n\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 4 | 2 | uint16 | Version | Must be `1` |\r\n\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 6 | 2 | uint16 | Flags | Bit 0: signed (has signature block). Bits 1-15: reserved (must be 0) |\r\n"]
[2966.930251, "o", "\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 8 | 4 | uint32 | NumTensors | Number of \u001b[01;31m\u001b[Ktensor\u001b[m\u001b[K blocks |\r\n\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 12 | 4 | uint32 | NumMetadata | Number of metadata key-value pairs |\r\n\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 16 | 8 | uint64 | MetadataOffset | Byte offset of metadata section from file start |\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 24 | 8 | uint64 | ProvenanceOffset | Byte offset of provenance section from file start |\r\n\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 32 | 8 | uint64 | SignatureOffset | Byte offset of signature block (0 if unsigned) |\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 40 | 8 | int64 | CreationTimestamp | Unix timestamp (seconds) when checkpoint was created |\r\n"]
[2966.930318, "o", "\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 48 | 8 | uint64 | HeaderChecksum | FNV-1a 64-bit hash of bytes [0..48) |\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K### 1.2 Tensor Blocks\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KTensor blocks start immediately after the header (offset 56). Each \u001b[01;31m\u001b[Ktensor\u001b[m\u001b[K block has variable length:\r\n\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| Size | Type | Field | Description |\r\n\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K|------|------|-------|-------------|\r\n"]
[2966.930375, "o", "\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 2 | uint16 | NameLen | Length of \u001b[01;31m\u001b[Ktensor\u001b[m\u001b[K name in bytes |\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| NameLen | bytes | Name | UTF-8 \u001b[01;31m\u001b[Ktensor\u001b[m\u001b[K name (e.g., `encoder.layer0.weight`) |\r\n"]
[2966.930432, "o", "\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 1 | uint8 | \u001b[01;31m\u001b[KDtype\u001b[m\u001b[K | Data type enum (see below) |\r\n\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 1 | uint8 | NumDims | Number of dimensions (1-8) |\r\n\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 4 * NumDims | uint32[] | Shape | Dimension sizes |\r\n\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 8 | uint64 | DataSize | Size of raw \u001b[01;31m\u001b[Ktensor\u001b[m\u001b[K data in bytes |\r\n\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| DataSize | bytes | Data | Raw \u001b[01;31m\u001b[Ktensor\u001b[m\u001b[K data |\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 32 | bytes | Checksum | SHA-256 hash of the Data bytes |\r\n"]
[2966.930486, "o", "\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K**\u001b[01;31m\u001b[KDtype\u001b[m\u001b[K values:**\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| Value | Type | Byte size per element |\r\n\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K|-------|------|----------------------|\r\n"]
[2966.93054, "o", "\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 0 | \u001b[01;31m\u001b[Kfloat32\u001b[m\u001b[K | 4 |\r\n\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 1 | float64 | 8 |\r\n\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 2 | float16 | 2 |\r\n\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 3 | int32 | 4 |\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 4 | int64 | 8 |\r\n\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 5 | bfloat16 | 2 |\r\n\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[2966.930592, "o", "\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K**Validation**: `DataSize` must equal `product(Shape) * element_byte_size`. If it does not match, the \u001b[01;31m\u001b[Ktensor\u001b[m\u001b[K block is malformed.\r\n"]
[2966.930645, "o", "\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K### 1.3 Metadata Section\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KLocated at `MetadataOffset`. Contains `NumMetadata` key-value pairs:\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| Size | Type | Field | Description |\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K|------|------|-------|-------------|\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K| 2 | uint16 | KeyLen | Length of key |\r\n"]
[2966.931182, "o", "\u001b[?2004h"]
[2966.931252, "o", "root@n30009:/app# "]
[2967.224498, "i", "sed -n '1,120p' docs/formats.md\n"]
[2967.224765, "o", "sed -n '1,120p' docs/formats.md\r\n"]
[2967.224843, "o", "\u001b[?2004l\r"]
[2967.227833, "o", "# File Format Specifications\r\n\r\n## 1. MLCK Checkpoint Format (`.mlck`)\r\n\r\nAll multi-byte integer and floating-point values are **little-endian**.\r\n\r\n### File Layout\r\n\r\n```\r\n"]
[2967.227967, "o", "[Header (56 bytes)]\r\n[Tensor Block 0]\r\n[Tensor Block 1]\r\n...\r\n[Tensor Block N-1]\r\n[Metadata Section]\r\n[Provenance Section]\r\n[Signature Block]      (only if Header.Flags bit 0 is set)\r\n```\r\n\r\n### 1.1 Header (56 bytes)\r\n\r\n| Offset | Size | Type | Field | Description |\r\n|--------|------|------|-------|-------------|\r\n| 0 | 4 | bytes | Magic | Must be `MLCK` (0x4D 0x4C 0x43 0x4B) |\r\n| 4 | 2 | uint16 | Version | Must be `1` |\r\n| 6 | 2 | uint16 | Flags | Bit 0: signed (has signature block). Bits 1-15: reserved (must be 0) |\r\n| 8 | 4 | uint32 | NumTensors | Number of tensor blocks |\r\n"]
[2967.22804, "o", "| 12 | 4 | uint32 | NumMetadata | Number of metadata key-value pairs |\r\n| 16 | 8 | uint64 | MetadataOffset | Byte offset of metadata section from file start |\r\n| 24 | 8 | uint64 | ProvenanceOffset | Byte offset of provenance section from file start |\r\n| 32 | 8 | uint64 | SignatureOffset | Byte offset of signature block (0 if unsigned) |\r\n| 40 | 8 | int64 | CreationTimestamp | Unix timestamp (seconds) when checkpoint was created |\r\n| 48 | 8 | uint64 | HeaderChecksum | FNV-1a 64-bit hash of bytes [0..48) |\r\n\r\n### 1.2 Tensor Blocks\r\n\r\nTensor blocks start immediately after the header (offset 56). Each tensor block has variable length:\r\n\r\n| Size | Type | Field | Description |\r\n|------|------|-------|-------------|\r\n| 2 | uint16 | NameLen | Length of tensor name in bytes |\r\n| NameLen | bytes | Name | UTF-8 tensor name (e.g., `encoder.layer0.weight`) |\r\n| 1 | uint8 | Dtype | Data type enum (see below) |\r\n| 1 | uint8 | NumDims | Number of dimensions (1-8) |\r\n| 4 * NumDims | uint32[] | Shape | Dimension sizes |\r\n| 8 |"]
[2967.228101, "o", " uint64 | DataSize | Size of raw tensor data in bytes |\r\n| DataSize | bytes | Data | Raw tensor data |\r\n| 32 | bytes | Checksum | SHA-256 hash of the Data bytes |\r\n\r\n**Dtype values:**\r\n\r\n| Value | Type | Byte size per element |\r\n|-------|------|----------------------|\r\n| 0 | float32 | 4 |\r\n| 1 | float64 | 8 |\r\n| 2 | float16 | 2 |\r\n| 3 | int32 | 4 |\r\n"]
[2967.228158, "o", "| 4 | int64 | 8 |\r\n| 5 | bfloat16 | 2 |\r\n\r\n**Validation**: `DataSize` must equal `product(Shape) * element_byte_size`. If it does not match, the tensor block is malformed.\r\n\r\n### 1.3 Metadata Section\r\n\r\nLocated at `MetadataOffset`. Contains `NumMetadata` key-value pairs:\r\n\r\n| Size | Type | Field | Description |\r\n|------|------|-------|-------------|\r\n| 2 | uint16 | KeyLen | Length of key |\r\n| KeyLen | bytes | Key | UTF-8 key string |\r\n| 4 | uint32 | ValueLen | Length of value |\r\n| ValueLen | bytes | Value | UTF-8 value (JSON-encoded) |\r\n"]
[2967.228213, "o", "\r\nCommon metadata keys:\r\n- `model_name`: string, the model architecture name\r\n- `dataset`: string, training dataset identifier\r\n- `training_config`: JSON object with hyperparameters\r\n- `notes`: string, free-form notes\r\n\r\n### 1.4 Provenance Section\r\n\r\nLocated at `ProvenanceOffset`. Fixed structure followed by variable-length fields:\r\n\r\n"]
[2967.22827, "o", "| Size | Type | Field | Description |\r\n|------|------|-------|-------------|\r\n| 40 | bytes | GitCommit | ASCII hex string of git commit hash (zero-padded if absent) |\r\n| 32 | bytes | DatasetHash | Raw SHA-256 of the training dataset manifest |\r\n| 32 | bytes | ConfigHash | Raw SHA-256 of the training configuration |\r\n| 8 | int64 | TrainingTimestamp | Unix timestamp when training started |\r\n| 8 | float64 | TrainingDuration | Training duration in seconds |\r\n| 2 | uint16 | FrameworkLen | Length of framework name |\r\n| FrameworkLen | bytes | Framework | UTF-8 framework name (e.g., `PyTorch`, `JAX`) |\r\n| 2 | uint16 | FrameworkVersionLen | Length of framework version string |\r\n"]
[2967.228325, "o", "| FrameworkVersionLen | bytes | FrameworkVersion | UTF-8 version (e.g., `2.1.0`) |\r\n| 4 | uint32 | Epoch | Training epoch at checkpoint time |\r\n| 8 | uint64 | GlobalStep | Global training step |\r\n| 8 | float64 | LearningRate | Learning rate at checkpoint time |\r\n| 2 | uint16 | ParentHashLen | Length of parent hash string (0 = no parent) |\r\n| ParentHashLen | bytes | ParentHash | ASCII hex SHA-256 of the parent checkpoint file (for lineage) |\r\n\r\n### 1.5 Signature Block\r\n\r\n"]
[2967.228383, "o", "Located at `SignatureOffset` (only present if `Flags` bit 0 is set):\r\n\r\n| Size | Type | Field | Description |\r\n|------|------|-------|-------------|\r\n| 1 | uint8 | Algorithm | 0 = HMAC-SHA256 |\r\n| 2 | uint16 | SignerIdLen | Length of signer identifier |\r\n| SignerIdLen | bytes | SignerId | UTF-8 signer identifier (used as HMAC key) |\r\n| 2 | uint16 | SignatureLen | Length of signature |\r\n| SignatureLen | bytes | Signature | The signature bytes |\r\n\r\n**HMAC-SHA256 computation**: The HMAC is computed over all bytes from offset 0 to `SignatureOffset` (exclusive), using `SignerId` as the HMAC key.\r\n"]
[2967.228434, "o", "\r\n---\r\n\r\n## 2. Training Log Shard Format (`.jsonl`)\r\n\r\nEach `.jsonl` file contains one JSON object per line. Each object represents a training step event:\r\n\r\n"]
[2967.228919, "o", "\u001b[?2004h"]
[2967.229, "o", "root@n30009:/app# "]
[2967.529894, "i", "sed -n '120,260p' docs/formats.md\n"]
[2967.530217, "o", "sed -n '120,260p' docs/formats.md\r\n"]
[2967.530305, "o", "\u001b[?2004l\r"]
[2967.533085, "o", "\r\n```json\r\n{\r\n  \"ts\": \"2024-01-15T10:30:00Z\",\r\n  \"epoch\": 1,\r\n  \"step\": 1000,\r\n  \"loss\": 0.5234,\r\n  \"lr\": 0.001,\r\n"]
[2967.533192, "o", "  \"grad_norm\": 1.23,\r\n  \"acc\": 0.8200,\r\n  \"event\": \"step\"\r\n}\r\n```\r\n\r\n### Required Fields\r\n\r\n| Field | Type | Description |\r\n|-------|------|-------------|\r\n| `ts` | string | ISO 8601 timestamp (UTC, `Z` suffix required) |\r\n| `epoch` | integer | Current training epoch (0-indexed) |\r\n| `step` | integer | Global training step (monotonically increasing within an epoch) |\r\n\r\n### Optional Metric Fields\r\n\r\n| Field | Type | Description |\r\n|-------|------|-------------|\r\n| `loss` | float | Training loss |\r\n| `lr` | float | Learning rate |\r\n"]
[2967.533271, "o", "| `grad_norm` | float | Gradient L2 norm |\r\n| `acc` | float | Accuracy metric (0.0 to 1.0) |\r\n| `event` | string | Event type: `step`, `epoch_end`, `checkpoint`, `eval` |\r\n\r\n### Shard Semantics\r\n\r\n- Multiple shard files may exist in the same evidence directory\r\n- Shards may have overlapping `(epoch, step)` ranges\r\n- Shards are named arbitrarily (any `.jsonl` filename is valid)\r\n- Lines within a single shard are not guaranteed to be in chronological order\r\n- Malformed lines (invalid JSON) should be silently skipped with a count in verbose output\r\n\r\n---\r\n\r\n## 3. Configuration File Format (`config_*.json`)\r\n\r\nTraining configuration files follow the naming pattern `config_*.json`:\r\n\r\n"]
[2967.533345, "o", "```json\r\n{\r\n  \"model_name\": \"resnet50\",\r\n  \"dataset\": \"imagenet-1k\",\r\n  \"batch_size\": 256,\r\n  \"learning_rate\": 0.1,\r\n  \"lr_schedule\": \"cosine\",\r\n  \"weight_decay\": 0.0001,\r\n  \"epochs\": 90,\r\n  \"optimizer\": \"sgd\",\r\n  \"momentum\": 0.9,\r\n  \"seed\": 42\r\n}\r\n```\r\n\r\n"]
[2967.533408, "o", "These files are used by the anomaly detector to cross-reference declared hyperparameters with observed training behavior.\r\n"]
[2967.53382, "o", "\u001b[?2004h"]
[2967.533903, "o", "root@n30009:/app# "]
[3065.580763, "i", "grep -n '^## ' docs/output_schema.md docs/spec.md\n"]
[3065.581083, "o", "grep -n '^## ' docs/output_schema.md docs/spec.md\r\n\u001b[?2004l\r"]
[3065.583949, "o", "\u001b[35m\u001b[Kdocs/output_schema.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K7\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[K1. Ingest Output\r\n\u001b[35m\u001b[Kdocs/output_schema.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[K2. Timeline Output\r\n"]
[3065.584128, "o", "\u001b[35m\u001b[Kdocs/output_schema.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[K3. Verify Output\r\n\u001b[35m\u001b[Kdocs/output_schema.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[K4. Detect Output\r\n\u001b[35m\u001b[Kdocs/output_schema.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[K5. Lineage Output\r\n\u001b[35m\u001b[Kdocs/output_schema.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[K6. Report Output\r\n\u001b[35m\u001b[Kdocs/output_schema.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[K7. Query Output\r\n\u001b[35m\u001b[Kdocs/spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K3\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[KOverview\r\n\u001b[35m\u001b[Kdocs/spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K7\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[KCLI Interface\r\n"]
[3065.584263, "o", "\u001b[35m\u001b[Kdocs/spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[KExit Codes\r\n\u001b[35m\u001b[Kdocs/spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[KBuild\r\n\u001b[35m\u001b[Kdocs/spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[KCross-References\r\n"]
[3065.584547, "o", "\u001b[?2004hroot@n30009:/app# "]
[3065.874789, "i", "tail -20 docs/output_schema.md\n"]
