[4449.500164, "o", "   481\t\t}\r\n   482\t\toff := int(sigOff)\r\n   483\t\toff++ // algorithm\r\n   484\t\tsignerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   485\t\toff += 2\r\n   486\t\tif off+signerLen+2 > len(raw) {\r\n   487\t\t\treturn false, \"\"\r\n   488\t\t}\r\n   489\t\tsignerID := string(raw[off : off+signerLen])\r\n   490\t\toff += signerLen\r\n"]
[4449.500228, "o", "   491\t\tsigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   492\t\toff += 2\r\n   493\t\tif off+sigLen > len(raw) {\r\n   494\t\t\treturn false, signerID\r\n   495\t\t}\r\n   496\t\tstored := raw[off : off+sigLen]\r\n   497\t\tmac := hmac.New(sha256.New, []byte(signerID))\r\n   498\t\tmac.Write(raw[:sigOff])\r\n   499"]
[4449.500288, "o", "\t\texpected := mac.Sum(nil)\r\n   500\t\treturn hmac.Equal(expected, stored), signerID\r\n   501\t}\r\n   502\t\r\n   503\tfunc firstSource(e types.TimelineEntry) string {\r\n   504\t\tif len(e.Sources) > 0 {\r\n   505\t\t\treturn e.Sources[0]\r\n   506\t\t}\r\n   507\t\treturn \"\"\r\n   508\t}\r\n   509\t\r\n"]
