[7264.631376, "o", "   246\t\r\n   247\ttype VerifyIssue struct {\r\n   248\t\tType   string `json:\"type\"`\r\n   249\t\tDetail string `json:\"detail\"`\r\n   250\t}\r\n   251\t\r\n   252\ttype VerifyCheckpoint struct {\r\n   253\t"]
[7264.631428, "o", "\tFile                 string        `json:\"file\"`\r\n   254\t\tValid                bool          `json:\"valid\"`\r\n   255\t\tHeaderChecksumValid  bool          `json:\"header_checksum_valid\"`\r\n   256\t\tTensorChecksumsValid bool          `json:\"tensor_checksums_valid\"`\r\n   257\t\tSignatureValid       *bool         `json:\"signature_valid\"`\r\n   258\t\tProvenanceValid      bool          `json:\"provenance_valid\"`\r\n   259\t\t"]
[7264.631474, "o", "Issues               []VerifyIssue `json:\"issues\"`\r\n   260\t}\r\n   261\t\r\n   262\ttype VerifyOutput struct {\r\n   263\t\tStatus      string             `json:\"status\"`\r\n   264\t\tCheckpoints []VerifyCheckpoint `json:\"checkpoints\"`\r\n   265\t\tSummary     struct {\r\n   266\t\t\tTotal   int `json:\"total\"`\r\n"]
[7264.631492, "o", "   267\t\t\tValid   int `json:\"valid\"`\r\n   268\t\t\tInvalid int `json:\"invalid\"`\r\n   269\t\t} `json:\"summary\"`\r\n   270\t}\r\n   271\t\r\n   272\tfunc BuildVerify(dir string) (interface{}, error) {\r\n   273\t\tap, err := DiscoverArtifacts(dir)\r\n   274\t\tif err != nil {\r\n"]
[7264.631572, "o", "   275\t\t\treturn nil, err\r\n   276\t\t}\r\n   277\t\tif len(ap.Checkpoints) == 0 {\r\n   278\t\t\treturn nil, fmt.Errorf(\"no checkpoint files found\")\r\n   279\t\t}\r\n   280\t\tvar out VerifyOutput\r\n   281\t\tout.Status = \"ok\"\r\n   282\t\tfor _, p := range ap.Checkpoints {\r\n   283\t\t\tvc := verifyCheckpoint(p)\r\n   284\t\t\tout.Checkpoints = append(out.Checkpoints, vc)\r\n   285\t\t}\r\n   286\t\tsort.Slice(out.Checkpoints, func(i, j int) bool {\r\n   287"]
[7264.631627, "o", "\t\t\treturn out.Checkpoints[i].File < out.Checkpoints[j].File\r\n   288\t\t})\r\n   289\t\tout.Summary.Total = len(out.Checkpoints)\r\n"]
[7264.631685, "o", "   290\t\tfor _, c := range out.Checkpoints {\r\n   291\t\t\tif c.Valid {\r\n   292\t\t\t\tout.Summary.Valid++\r\n   293\t\t\t} else {\r\n   294\t\t\t\tout.Summary.Invalid++\r\n   295\t\t\t}\r\n   296\t\t}\r\n   297\t\treturn out, nil\r\n   298\t}\r\n   299\t\r\n   300\tfunc verifyCheckpoint(path string) VerifyCheckpoint {\r\n   301\t\tvc := VerifyCheckpoint{\r\n   302\t\t\tFile:   filepath.Base(path),\r\n"]
[7264.63174, "o", "   303\t\t\tIssues: []VerifyIssue{},\r\n   304\t\t}\r\n   305\t\tcf, err := checkpoint.Parse(path)\r\n"]
[7264.631794, "o", "   306\t\tif err != nil || cf == nil {\r\n   307\t\t\tvc.HeaderChecksumValid = false\r\n   308\t\t\tvc.TensorChecksumsValid = false\r\n   309\t\t\tvc.ProvenanceValid = false\r\n   310\t\t\tvc.Valid = false\r\n   311\t\t\tdetail := \"unknown parse error\"\r\n   312\t\t\tif err != nil {\r\n   313\t\t\t\tdetail = err.Error()\r\n   314\t\t\t}\r\n"]
[7264.63185, "o", "   315\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"parse_error\", Detail: detail})\r\n   316\t\t\treturn vc\r\n   317\t\t}\r\n   318\t\tvc.HeaderChecksumValid = cf.HeaderValid\r\n   319\t\tif !cf.HeaderValid {\r\n   320\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"header_checksum_mismatch\", Detail: \"\"})\r\n   321\t\t}\r\n   322\t\tvc.TensorChecksumsValid = true\r\n"]
[7264.631907, "o", "   323\t\tfor _, t := range cf.Tensors {\r\n   324\t\t\tif !t.Valid {\r\n   325\t\t\t\tvc.TensorChecksumsValid = false\r\n   326\t\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"tensor_checksum_mismatch\", Detail: t.Name})\r\n   327\t\t\t}\r\n   328\t\t}\r\n   329\t\tif cf.Signed {\r\n   330\t\t\tvalid, _ := validateSignature(path)\r\n   331\t\t\tvc.SignatureValid = &valid\r\n"]
[7264.631993, "o", "   332\t\t\tif !valid {\r\n   333\t\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"signature_invalid\", Detail: \"\"})\r\n   334\t\t\t}\r\n   335\t\t}\r\n   336\t\tvc.ProvenanceValid = validateProvenance(cf)\r\n   337\t\tif !vc.ProvenanceValid {\r\n   338\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"provenance_invalid\", Detail: \"\"})\r\n   339\t\t}\r\n"]
[7264.63205, "o", "   340\t\tvc.Valid = vc.HeaderChecksumValid && vc.TensorChecksumsValid && vc.ProvenanceValid && (!cf.Signed || (vc.SignatureValid != nil && *vc.SignatureValid))\r\n"]
