[3269.892352, "o", "grep -n \"float32\\|float64\\|dtype\\|Dtype\" docs/formats.md internal/checkpoint/parser.go internal/types/types.go || true\r\n\u001b[?2004l\r"]
[3269.895578, "o", "\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 1 | uint8 | \u001b[01;31m\u001b[KDtype\u001b[m\u001b[K | Data type enum (see below) |\r\n"]
[3269.895681, "o", "\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K**\u001b[01;31m\u001b[KDtype\u001b[m\u001b[K values:**\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 0 | \u001b[01;31m\u001b[Kfloat32\u001b[m\u001b[K | 4 |\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 1 | \u001b[01;31m\u001b[Kfloat64\u001b[m\u001b[K | 8 |\r\n"]
[3269.895762, "o", "\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 8 | \u001b[01;31m\u001b[Kfloat64\u001b[m\u001b[K | TrainingDuration | Training duration in seconds |\r\n\u001b[35m\u001b[Kdocs/formats.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| 8 | \u001b[01;31m\u001b[Kfloat64\u001b[m\u001b[K | LearningRate | Learning rate at checkpoint time |\r\n"]
[3269.895895, "o", "\u001b[35m\u001b[Kinternal/checkpoint/parser.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// \u001b[01;31m\u001b[Kdtype\u001b[m\u001b[K (1 byte)\r\n\u001b[35m\u001b[Kinternal/checkpoint/parser.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn fail(\"unexpected EOF reading \u001b[01;31m\u001b[Kdtype\u001b[m\u001b[K\")\r\n"]
[3269.896001, "o", "\u001b[35m\u001b[Kinternal/checkpoint/parser.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kdtype\u001b[m\u001b[K := raw[off]\r\n\u001b[35m\u001b[Kinternal/checkpoint/parser.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KDtype\u001b[m\u001b[K: \u001b[01;31m\u001b[Kdtype\u001b[m\u001b[K,\r\n\u001b[35m\u001b[Kinternal/checkpoint/parser.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K257\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// TrainingDuration: \u001b[01;31m\u001b[Kfloat64\u001b[m\u001b[K\r\n"]
[3269.896068, "o", "\u001b[35m\u001b[Kinternal/checkpoint/parser.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// LearningRate: \u001b[01;31m\u001b[Kfloat64\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kinternal/types/types.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K8\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tLoss     *\u001b[01;31m\u001b[Kfloat64\u001b[m\u001b[K `json:\"loss,omitempty\"`\r\n"]
[3269.896134, "o", "\u001b[35m\u001b[Kinternal/types/types.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K9\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tLr       *\u001b[01;31m\u001b[Kfloat64\u001b[m\u001b[K `json:\"lr,omitempty\"`\r\n\u001b[35m\u001b[Kinternal/types/types.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tGradNorm *\u001b[01;31m\u001b[Kfloat64\u001b[m\u001b[K `json:\"grad_norm,omitempty\"`\r\n\u001b[35m\u001b[Kinternal/types/types.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K11\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tAcc      *\u001b[01;31m\u001b[Kfloat64\u001b[m\u001b[K `json:\"acc,omitempty\"`\r\n\u001b[35m\u001b[Kinternal/types/types.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KDtype\u001b[m\u001b[K byte     `json:\"\u001b[01;31m\u001b[Kdtype\u001b[m\u001b[K\"`\r\n"]
[3269.896204, "o", "\u001b[35m\u001b[Kinternal/types/types.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tTrainingDuration  \u001b[01;31m\u001b[Kfloat64\u001b[m\u001b[K `json:\"training_duration\"`\r\n\u001b[35m\u001b[Kinternal/types/types.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tLearningRate      \u001b[01;31m\u001b[Kfloat64\u001b[m\u001b[K `json:\"learning_rate\"`\r\n"]
