[1941.451157, "o", "\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tap.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks = append(ap.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks, path)\r\n\u001b[35m\u001b[Kinternal/forensics/forensics.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tsort.Strings(ap.\u001b[01;31m\u001b[KCheckpoint\u001b[m\u001b[Ks)\r\n"]
