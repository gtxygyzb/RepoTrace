[1169.54786, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/tmp/evidence/model_epoch2.mlck')\ndata = bytearray(p.read_bytes())\n# flip a byte in tensor data after header and tensor name/metadata; find first data byte\n# header is 56 bytes, tensor block: 2 len + 1 name +1 dtype+4 shape+8 datasize => data starts at 56+16=72\nif data[72] == 0:\n    data[72] = 1\nelse:\n    data[72] = 0\np.write_bytes(data)\nPY\n./mlforge verify /tmp/evidence\n"]
