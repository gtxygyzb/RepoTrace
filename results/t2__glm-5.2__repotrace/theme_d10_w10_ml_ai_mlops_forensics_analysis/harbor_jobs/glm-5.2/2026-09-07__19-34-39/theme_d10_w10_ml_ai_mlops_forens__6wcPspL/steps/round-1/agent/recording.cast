[5441.451994, "o", "\tfunc detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n   236\t\tvar anomalies []types.Anomaly\r\n   237\t\tfor i := 1; i < len(entries); i++ {\r\n   238\t\t\tprev := entries[i-1]\r\n   239\t\t\tcur := entries[i]\r\n   240\t\t\tif prev.Lr == nil || cur.Lr == nil {\r\n   241\t\t\t\tcontinue\r\n   242\t\t\t}\r\n   243\t\t\tif *cur.Lr > *prev.Lr {\r\n   244\t\t\t"]
[5441.452078, "o", "\tif cur.Event == \"epoch_end\" {\r\n   245\t\t\t\t\tcontinue\r\n   246\t\t\t\t}\r\n   247\t\t\t\tep := cur.Epoch\r\n   248\t\t\t\tst := cur.Step\r\n   249\t\t"]
