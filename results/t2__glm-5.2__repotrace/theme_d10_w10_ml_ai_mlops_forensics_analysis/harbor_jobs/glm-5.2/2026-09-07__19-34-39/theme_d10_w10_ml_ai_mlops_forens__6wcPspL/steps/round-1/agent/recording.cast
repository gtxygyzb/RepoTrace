[1907.19222, "o", "   233\t\t\t}\r\n   234\t\t\tout.TotalEpochs = len(epochSet)\r\n   235\t\t\tout.StepRange = []int{minStep, maxStep}\r\n   236\t\t\tout.TimeRange = []string{minTs, maxTs}\r\n   237\t\t}\r\n   238\t\tif out.Gaps == nil {\r\n   239\t\t\tout.Gaps = []TimelineGap{}\r\n   240\t\t}\r\n"]
[1907.192288, "o", "   241\t\tif out.Entries == nil {\r\n   242\t\t\tout.Entries = []types.TimelineEntry{}\r\n   243\t\t}\r\n   244\t\treturn out\r\n   245\t}\r\n   246\t\r\n   247\ttype VerifyCheckpoint struct {\r\n   248\t\tFile                 string   `json:\"file\"`\r\n   249\t\tValid                bool     `json:\"valid\"`\r\n   250\t\tHeaderChecksumValid  bool     `json:\"header_checksum_valid\"`\r\n   251\t\tTensorChecksumsValid bool     `json:\"tensor_checksums_valid\"`\r\n   252\t\tSignatureValid       *bool    `json:\"signature_valid\"`\r\n"]
[1907.192358, "o", "   253\t\tProvenanceValid      bool     `json:\"provenance_valid\"`\r\n   254\t\tIssues               []string `json:\"issues\"`\r\n   255\t}\r\n   256\t\r\n   257\ttype VerifyOutput struct {\r\n   258\t\tStatus      string             `json:\"status\"`\r\n"]
[1907.192418, "o", "   259\t\tCheckpoints []VerifyCheckpoint `json:\"checkpoints\"`\r\n   260\t\tSummary     struct {\r\n   261\t\t\tTotal   int `json:\"total\"`\r\n   262\t\t\tValid   int `json:\"valid\"`\r\n   263\t\t\tInvalid int `json:\"invalid\"`\r\n   264\t\t} `json:\"summary\"`\r\n   265\t}\r\n   266\t\r\n   267\tfunc BuildVerify(dir string) (interface{}, error) {\r\n   268\t\tap, err := DiscoverArtifacts(dir)\r\n"]
[1907.192481, "o", "   269\t\tif err != nil {\r\n   270\t\t\treturn nil, err\r\n   271\t\t}\r\n   272\t\tif len(ap.Checkpoints) == 0 {\r\n   273\t\t\t"]
[1907.192543, "o", "return nil, fmt.Errorf(\"no checkpoint files found\")\r\n   274\t\t}\r\n   275\t\tvar out VerifyOutput\r\n   276\t\tout.Status = \"ok\"\r\n   277\t\tfor _, p := range ap.Checkpoints {\r\n   278\t\t\tvc := verifyCheckpoint(p)\r\n   279\t\t\tout.Checkpoints = append(out.Checkpoints, vc)\r\n   280\t\t}\r\n   281\t\tsort.Slice(out.Checkpoints, func(i, j int) bool {\r\n   282\t\t\treturn out.Checkpoints[i].File < out.Checkpoints[j].File\r\n   283\t\t})\r\n   284\t\tout.Summary.Total = len(out.Checkpoints)\r\n   285\t\tfor _, c := range out.Checkpoints {\r\n"]
[1907.192601, "o", "   286\t\t\tif c.Valid {\r\n   287\t\t\t\tout.Summary.Valid++\r\n   288\t\t\t} else {\r\n   289\t\t\t\tout.Summary.Invalid++\r\n   290\t\t\t}\r\n   291\t\t}\r\n   292\t\treturn out, nil\r\n   293\t}\r\n   294\t\r\n"]
[1907.192667, "o", "   295\tfunc verifyCheckpoint(path string) VerifyCheckpoint {\r\n   296\t\tvc := VerifyCheckpoint{\r\n   297\t\t\tFile:   filepath.Base(path),\r\n   298\t\t"]
[1907.192749, "o", "\tIssues: []string{},\r\n   299\t\t}\r\n   300\t\tcf, err := checkpoint.Parse(path)\r\n   301\t\tif err != nil || cf == nil {\r\n   302\t\t\tvc.HeaderChecksumValid = false\r\n   303\t\t\tvc.TensorChecksumsValid = false\r\n   304\t\t\tvc.ProvenanceValid = false\r\n   305\t\t\tvc.Valid = false\r\n   306"]
[1907.192812, "o", "\t\t\tvc.Issues = append(vc.Issues, fmt.Sprintf(\"parse_error:%s\", err))\r\n   307\t\t\treturn vc\r\n   308\t\t}\r\n   309\t\tvc.HeaderChecksumValid = cf.HeaderValid\r\n   310\t\tif !cf.HeaderValid {\r\n   311\t\t\tvc.Issues = append(vc.Issues, \"header_checksum_mismatch\")\r\n   312\t\t}\r\n   313\t\tvc.TensorChecksumsValid = true\r\n   314\t\tfor _, t := range cf.Tensors {\r\n   315\t\t\tif !t.Valid {\r\n   316\t\t\t\tvc.TensorChecksumsValid = false\r\n   317\t\t\t\tvc.Issues = append(vc.Issues, fmt.Sprintf(\"tensor_checksum_mismatch:%s\", t.Name))\r\n   318\t\t\t}\r\n   319\t\t}\r\n   320\t\tif cf.Signed {\r\n"]
[1907.19287, "o", "   321\t\t\tvalid, _ := validateSignature(path)\r\n   322\t\t\tvc.SignatureValid = &valid\r\n   323\t\t\tif !valid {\r\n   324\t\t\t\tvc.Issues = append(vc.Issues, \"signature_invalid\")\r\n   325\t\t\t}\r\n   326\t\t}\r\n   327\t\tvc.ProvenanceValid = validateProvenance(cf)\r\n   328\t\tif !vc.ProvenanceValid {\r\n   329\t\t\tvc.Issues = append(vc.Issues, \"provenance_invalid\")\r\n"]
[1907.192964, "o", "   330\t\t}\r\n   331\t\tvc.Valid = vc.HeaderChecksumValid && vc.TensorChecksumsValid && vc.ProvenanceValid && (!cf.Signed || (vc.SignatureValid != nil && *vc.SignatureValid))\r\n   332\t\treturn vc\r\n   333\t}\r\n   334\t\r\n   335\tfunc validateSignature(path string) (bool, error) {\r\n   336\t\traw, err := os.ReadFile(path)\r\n   337\t\tif err != nil || len(raw) < 56 {\r\n"]
[1907.193024, "o", "   338\t\t\treturn false, err\r\n   339\t\t}\r\n   340\t\tsigOff := binary.LittleEndian.Uint64(raw[32:40])\r\n   341\t\tif sigOff == 0 || int(sigOff) >= len(raw) {\r\n   342\t\t\treturn false, nil\r\n   343\t\t}\r\n   344\t\tif int(sigOff)+5 > len(raw) {\r\n   345\t\t\treturn false, nil\r\n   346\t\t}\r\n   347\t\toff := int(sigOff)\r\n   348\t\t_ = raw[off] // algorithm\r\n   349\t\t"]
[1907.193081, "o", "off++\r\n   350\t\tsignerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   351\t\toff += 2\r\n   352\t\tif off+signerLen+2 > len(raw) {\r\n   353\t\t\treturn false, nil\r\n   354\t\t}\r\n   355\t\tsignerID := string(raw[off : off+signerLen])\r\n   356"]
[1907.193142, "o", "\t\toff += signerLen\r\n   357\t\tsigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   358\t\toff += 2\r\n   359\t\tif off+sigLen > len(raw) {\r\n   360\t\t\treturn false, nil\r\n   361\t\t}\r\n   362\t\tstoredSig := raw[off : off+sigLen]\r\n   363\t\tmac := hmac.New(sha256.New, []byte(signerID))\r\n   364\t\t"]
[1907.193198, "o", "mac.Write(raw[:sigOff])\r\n   365\t\texpected := mac.Sum(nil)\r\n   366\t\treturn hmac.Equal(expected, storedSig), nil\r\n   367\t}\r\n   368\t\r\n   369\tfunc validateProvenance(cf *types.CheckpointFile) bool {\r\n   370\t\tif cf.Provenance == nil {\r\n   371\t\t\treturn false\r\n   372\t"]
[1907.193272, "o", "\t}\r\n   373\t\tp := cf.Provenance\r\n   374\t\tif p.Framework == \"\" || p.FrameworkVersion == \"\" {\r\n   375\t\t\treturn false\r\n"]
[1907.193329, "o", "   376\t\t}\r\n   377\t\tif len(p.GitCommit) != 40 || !isHex(p.GitCommit) {\r\n   378\t\t\treturn false\r\n   379\t\t}\r\n   380\t\tif len(p.DatasetHash) != 64 || !isHex(p.DatasetHash) {\r\n   381\t\t\treturn false\r\n   382\t\t}\r\n   383\t\tif len(p.ConfigHash) != 64 || !isHex(p.ConfigHash) {\r\n   384\t\t\treturn false\r\n   385\t\t}\r\n   386\t\tif p.ParentHash != \"\" && (len(p.ParentHash) != 64 || !isHex(p.ParentHash)) {\r\n   387\t\t\treturn false\r\n   388\t\t}\r\n   389\t\treturn true\r\n"]
