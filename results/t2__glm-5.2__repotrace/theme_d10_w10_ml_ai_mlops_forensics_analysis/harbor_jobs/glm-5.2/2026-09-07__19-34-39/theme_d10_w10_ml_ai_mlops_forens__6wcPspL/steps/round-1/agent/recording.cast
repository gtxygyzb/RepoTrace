[789.726654, "i", "rface{}, error) { return BuildLineage(dir) })\n\n\treturn report, nil\n}\n\nfunc safeBuild(fn func() (interface{}, error)) interface{} {\n\tv, err := fn()\n\tif err != nil {\n\t\treturn map[string]interface{}{\"status\": \"error\", \"message\": err.Error()}\n\t}\n\treturn v\n}\nEOF\necho \"wrote report.go\"\n"]
