[7227.783595, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n"]
[7227.783628, "o", "     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"strconv\"\r\n     8\t\t\"strings\"\r\n     9\t\r\n"]
[7227.783716, "o", "    10\t\t\"mlforge/internal/forensics\"\r\n    11\t)\r\n    12\t\r\n    13\tfunc main() {\r\n    14\t\t// --- Parse flags ---------------------------------------------------\r\n    15\t\tformat := \"json\"\r\n    16\t\tverbose := false\r\n    17\t\tfilterSeverity := \"\"\r\n    18\t\tvar positional []string\r\n    19\t\r\n    20\t\targs := os.Args[1:]\r\n"]
[7227.78377, "o", "    21\t\tfor i := 0; i < len(args); i++ {\r\n    22\t\t\targ := args[i]\r\n    23\t\t\tswitch {\r\n    24\t\t\tcase arg == \"--verbose\":\r\n    25\t\t\t\tverbose = true\r\n    26\t\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n    27\t\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n"]
[7227.783821, "o", "    28\t\t\tcase arg == \"--format\":\r\n    29\t\t\t\tif i+1 >= len(args) {\r\n    30\t\t\t\t\tfmt.Fprintf(os.Stderr, \"flag --format requires a value\\n\")\r\n    31\t\t\t\t\tos.Exit(1)\r\n    32\t\t\t\t}\r\n    33\t\t\t\ti++\r\n    34\t\t\t\tformat = args[i]\r\n"]
[7227.78387, "o", "    35\t\t\tcase strings.HasPrefix(arg, \"--filter-severity=\"):\r\n    36\t\t\t\tfilterSeverity = strings.TrimPrefix(arg, \"--filter-severity=\")\r\n    37\t\t\tcase arg == \"--filter-severity\":\r\n    38\t\t\t\tif i+1 >= len(args) {\r\n    39\t\t\t\t\tfmt.Fprintf(os.Stderr, \"flag --filter-severity requires a value\\n\")\r\n    40\t\t\t\t\tos.Exit(1)\r\n"]
[7227.783917, "o", "    41\t\t\t\t}\r\n    42\t\t\t\ti++\r\n    43\t\t\t\tfilterSeverity = args[i]\r\n    44\t\t\tdefault:\r\n    45\t\t\t\tpositional = append(positional, arg)\r\n    46\t\t\t}\r\n    47\t\t}\r\n    48\t\r\n"]
[7227.783976, "o", "    49\t\tswitch format {\r\n    50\t\tcase \"json\", \"text\", \"csv\":\r\n    51\t\tdefault:\r\n    52\t\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json, text, or csv\\n\", format)\r\n    53\t\t\tos.Exit(1)\r\n"]
[7227.784026, "o", "    54\t\t}\r\n    55\t\r\n    56\t\t_ = verbose // reserved for diagnostic output\r\n    57\t\r\n    58\t\t// --- Validate positional args --------------------------------------\r\n    59\t\tif len(positional) < 2 {\r\n    60\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n    61\t\t\tos.Exit(1)\r\n    62"]
[7227.784074, "o", "\t\t}\r\n    63\t\r\n    64\t\tcmd := positional[0]\r\n    65\t\tdir := positional[1]\r\n    66\t\r\n    67\t\tif format == \"csv\" && cmd != \"detect\" {\r\n"]
[7227.784122, "o", "    68\t\t\tfmt.Fprintf(os.Stderr, \"invalid format csv: csv output is only supported for detect\\n\")\r\n    69\t\t\tos.Exit(1)\r\n    70\t\t}\r\n    71\t\tif filterSeverity != \"\" && cmd != \"detect\" {\r\n    72\t\t\tfmt.Fprintf(os.Stderr, \"--filter-severity is only supported for detect\\n\")\r\n    73\t\t\tos.Exit(1)\r\n    74\t"]
[7227.78417, "o", "\t}\r\n    75\t\r\n    76\t\t// --- Route to command handler --------------------------------------\r\n    77\t\tvar result interface{}\r\n    78\t\tvar err error\r\n    79\t\r\n    80\t\tswitch cmd {\r\n"]
[7227.784218, "o", "    81\t\tcase \"ingest\":\r\n    82\t\t\tresult, err = forensics.BuildIngest(dir)\r\n    83\t\tcase \"timeline\":\r\n    84\t\t\tresult, err = forensics.BuildTimeline(dir)\r\n    85\t\tcase \"verify\":\r\n    86\t\t\tresult, err = forensics.BuildVerify(dir)\r\n    87\t"]
[7227.784265, "o", "\tcase \"detect\":\r\n    88\t\t\tdetectResult, detectErr := forensics.BuildDetectFiltered(dir, filterSeverity)\r\n    89\t\t\tif detectErr != nil {\r\n    90\t\t\t\terr = detectErr\r\n    91\t\t\t} else {\r\n    92\t\t\t\tif format == \"csv\" {\r\n"]
[7227.784311, "o", "    93\t\t\t\t\tprintDetectCSV(detectResult)\r\n    94\t\t\t\t\treturn\r\n    95\t\t\t\t}\r\n    96\t\t\t\tresult = detectResult\r\n    97\t\t\t}\r\n    98\t\t"]
[7227.784359, "o", "case \"lineage\":\r\n    99\t\t\tresult, err = forensics.BuildLineage(dir)\r\n   100\t\tcase \"query\":\r\n   101\t\t\tif len(positional) < 3 {\r\n   102\t\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n   103\t\t\t\tos.Exit(1)\r\n   104\t\t\t}\r\n"]
[7227.784407, "o", "   105\t\t\tresult, err = forensics.BuildQuery(dir, positional[2])\r\n   106\t\tcase \"diff\":\r\n   107\t\t\tif len(positional) < 4 {\r\n   108\t\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge diff <dir> <file1> <file2>\\n\")\r\n   109\t\t\t\tos.Exit(1)\r\n   110\t\t\t}\r\n   111\t\t\tresult, err = forensics.BuildDiff(dir, positional[2], positional[3])\r\n"]
[7227.784456, "o", "   112\t\tcase \"report\":\r\n   113\t\t\tresult, err = forensics.BuildReport(dir)\r\n   114\t\tdefault:\r\n   115\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n   116\t\t\tos.Exit(1)\r\n   117\t\t"]
[7227.784503, "o", "}\r\n   118\t\r\n   119\t\t// --- Output --------------------------------------------------------\r\n   120\t\tif err != nil {\r\n   121\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   122\t\t\tos.Exit(1)\r\n"]
[7227.784549, "o", "   123\t\t}\r\n   124\t\r\n   125\t\tif format == \"text\" {\r\n   126\t\t\tprintText(result)\r\n   127\t\t\treturn\r\n   128\t\t}\r\n   129\t\r\n   130"]
[7227.784597, "o", "\t\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n   131\t\tif marshalErr != nil {\r\n   132\t\t\tfmt.Fprintf(os.Stderr, \"error marshalling result: %v\\n\", marshalErr)\r\n   133\t\t\tos.Exit(1)\r\n   134\t\t}\r\n   135\t\tfmt.Println(string(out))\r\n   136"]
[7227.784649, "o", "\t}\r\n   137\t\r\n   138\tfunc printDetectCSV(result forensics.DetectOutput) {\r\n   139\t\tfmt.Println(\"id,type,severity,epoch,step,source,checkpoint\")\r\n   140\t\tfor _, a := range result.Anomalies {\r\n   141\t\t\tepoch := \"\"\r\n"]
[7227.784695, "o", "   142\t\t\tif a.Epoch != nil {\r\n   143\t\t\t\tepoch = strconv.Itoa(*a.Epoch)\r\n   144\t\t\t}\r\n   145\t\t\tstep := \"\"\r\n   146\t\t\tif a.Step != nil {\r\n   147\t\t\t\tstep = strconv.Itoa(*a.Step)\r\n   148\t\t\t}\r\n"]
[7227.784742, "o", "   149\t\t\tfmt.Printf(\"%s,%s,%s,%s,%s,%s,%s\\n\", a.ID, a.Type, a.Severity, epoch, step, a.Source, a.Checkpoint)\r\n   150\t\t}\r\n   151\t}\r\n   152\t\r\n   153\tfunc printText(v interface{}) {\r\n   154\t\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n   155\t\tif err != nil {\r\n"]
[7227.784787, "o", "   156\t\t\tfmt.Fprintln(os.Stderr, \"error rendering text output\")\r\n   157\t\t\treturn\r\n   158\t\t}\r\n   159\t\tfmt.Println(string(b))\r\n   160\t}\r\n"]
