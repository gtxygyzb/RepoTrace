[1907.767179, "o", "   265\t\tsortTimeline(cps)\r\n   266\t\tvar anomalies []types.Anomaly\r\n   267\t\tfor i := 1; i < len(cps); i++ {\r\n   268\t\t\tprev := cps[i-1]\r\n   269\t\t\tcur := cps[i]\r\n   270\t\t\tif prev.Acc == nil || cur.Acc == nil {\r\n   271\t\t\t\tcontinue\r\n   272\t\t\t}\r\n   273\t\t\tdrop := *prev.Acc - *cur.Acc\r\n   274\t\t\tif drop > 0.15 {\r\n   275\t\t\t\tep := cur.Epoch\r\n   276\t\t\t\tst := cur.Step\r\n   277"]
[1907.767252, "o", "\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   278\t\t\t\t\tType:     \"metric_regression\",\r\n   279\t\t\t\t\tSeverity: \"high\",\r\n   280\t\t\t\t\tEpoch:    &ep,\r\n   281\t\t\t\t\tStep:     &st,\r\n   282\t\t\t\t\tDetails: map[string]interface{}{\r\n   283\t\t\t\t\t\t\"prev_acc\":        *prev.Acc,\r\n"]
[1907.767317, "o", "   284\t\t\t\t\t\t\"curr_acc\":        *cur.Acc,\r\n   285\t\t\t\t\t\t\"drop\":            drop,\r\n   286\t\t\t\t\t\t\"prev_checkpoint\": prev.Step,\r\n   287\t\t\t\t\t\t\"curr_checkpoint\": cur.Step,\r\n   288\t\t\t\t\t},\r\n   289\t\t\t\t\tSource: firstSource(cur),\r\n   290\t\t\t\t})\r\n   291\t\t\t}\r\n   292"]
[1907.767382, "o", "\t\t}\r\n   293\t\treturn anomalies\r\n   294\t}\r\n   295\t\r\n   296\tfunc detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {\r\n   297\t\tvar anomalies []types.Anomaly\r\n   298\t\thashSet := map[string]*types.CheckpointFile{}\r\n   299\t\tfor _, cf := range cps {\r\n   300\t\t\thashSet[cf.FileHash] = cf\r\n   301\t\t}\r\n   302\t\r\n   303\t\t"]
[1907.767453, "o", "for _, cf := range cps {\r\n   304\t\t\traw, err := os.ReadFile(cf.Path)\r\n   305\t\t\tif err != nil {\r\n   306\t\t\t\tcontinue\r\n   307"]
[1907.767515, "o", "\t\t\t}\r\n   308\t\t\tif !cf.HeaderValid {\r\n   309\t\t\t\tstored := uint64(0)\r\n   310\t\t\t\tif len(raw) >= 56 {\r\n   311\t\t\t\t\tstored = binary.LittleEndian.Uint64(raw[48:56])\r\n   312\t\t\t\t}\r\n   313\t\t\t\th := fnv.New64a()\r\n   314\t\t\t\th.Write(raw[:48])\r\n   315\t\t\t\tcomputed := h.Sum64()\r\n   316\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   317\t\t\t\t\tType:     \"header_checksum_mismatch\",\r\n   318\t\t\t\t\tSeverity: \"critical\",\r\n"]
[1907.767572, "o", "   319\t\t\t\t\tDetails: map[string]interface{}{\r\n   320\t\t\t\t\t\t\"file\":              cf.Filename,\r\n   321\t\t\t\t\t\t\"expected_checksum\": fmt.Sprintf(\"%016x\", stored),\r\n   322\t\t\t\t\t\t\"actual_checksum\":   fmt.Sprintf(\"%016x\", computed),\r\n   323\t\t\t\t\t},\r\n   324\t\t\t\t\tSource: cf.Filename,\r\n   325\t\t\t\t})\r\n   326\t\t\t}\r\n"]
[1907.767635, "o", "   327\t\r\n   328\t\t\tfor _, t := range cf.Tensors {\r\n   329\t\t\t\tif !t.Valid {\r\n   330\t\t\t\t\tcomputed := sha256.Sum256(t.Data)\r\n   331\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   332\t\t\t\t\t\tType:     \"tensor_checksum_mismatch\",\r\n   333\t\t\t\t\t\tSeverity: \"critical\",\r\n   334\t\t\t"]
[1907.767692, "o", "\t\t\tDetails: map[string]interface{}{\r\n   335\t\t\t\t\t\t\t\"file\":              cf.Filename,\r\n   336\t\t\t\t\t\t\t\"tensor_name\":       t.Name,\r\n   337\t\t\t\t\t\t\t\"expected_checksum\": hex.EncodeToString(t.Hash[:]),\r\n   338\t\t\t\t\t\t\t\"actual_checksum\":   hex.EncodeToString(computed[:]),\r\n"]
[1907.767749, "o", "   339\t\t\t\t\t\t},\r\n   340\t\t\t\t\t\tSource: cf.Filename,\r\n   341\t\t\t\t\t})\r\n   342\t\t\t\t}\r\n   343\t\t\t}\r\n   344\t\r\n   345\t\t\tif cf.Signed {\r\n   346\t\t\t\t"]
[1907.76781, "o", "valid, signer := signatureDetails(cf.Path)\r\n   347\t\t\t\tif !valid {\r\n   348\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   349\t\t\t\t\t\tType:     \"signature_invalid\",\r\n   350\t\t\t\t\t\tSeverity: \"critical\",\r\n   351\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   352\t\t\t\t\t\t\t\"file\":      cf.Filename,\r\n"]
[1907.767878, "o", "   353\t\t\t\t\t\t\t\"signer_id\": signer,\r\n   354\t\t\t\t\t\t\t\"valid\":     false,\r\n   355\t\t\t\t\t\t},\r\n   356\t\t\t\t\t\tSource: cf.Filename,\r\n   357\t\t\t\t\t})\r\n   358\t\t\t\t}\r\n   359\t\t\t}\r\n   360\t\r\n   361\t\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n   362\t\t\t\t"]
[1907.767971, "o", "_, found := hashSet[cf.Provenance.ParentHash]\r\n   363\t\t\t\tif !found {\r\n   364\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   365\t\t\t\t\t\tType:     \"provenance_chain_break\",\r\n   366\t\t\t\t\t\tSeverity: \"high\",\r\n   367\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   368\t\t\t\t"]
[1907.768033, "o", "\t\t\t\"file\":        cf.Filename,\r\n   369\t\t\t\t\t\t\t\"parent_hash\": cf.Provenance.ParentHash,\r\n   370\t\t\t\t\t\t\t\"found\":       false,\r\n   371\t\t\t\t\t\t},\r\n   372\t\t\t\t\t\tSource: cf.Filename,\r\n   373\t\t\t\t\t})\r\n   374\t\t\t\t}\r\n   375\t\t\t}\r\n   376\t\t}\r\n   377\t\r\n"]
[1907.768096, "o", "   378\t\tanomalies = append(anomalies, detectDatasetHashInconsistency(cps)...)\r\n   379\t\treturn anomalies\r\n   380\t}\r\n   381\t\r\n"]
[1907.768167, "o", "   382\tfunc detectDatasetHashInconsistency(cps []*types.CheckpointFile) []types.Anomaly {\r\n   383\t\tbyHash := map[string]*types.CheckpointFile{}\r\n   384\t\tfor _, cf := range cps {\r\n   385\t\t\tbyHash[cf.FileHash] = cf\r\n   386\t\t}\r\n   387\t\tchildren := map[string][]string{}\r\n   388\t\tfor _, cf := range cps {\r\n   389\t\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n   390\t\t\t\tif _, ok := byHash[cf.Provenance.ParentHash]; ok {\r\n   391\t\t\t\t\tchildren[cf.Provenance.ParentHash] = append(children[cf.Provenance.ParentHash], cf.FileHash)\r\n   392\t\t\t\t}\r\n   393\t\t\t}\r\n   394\t\t}\r\n   395\t"]
[1907.768243, "o", "\r\n   396\t\tvar anomalies []types.Anomaly\r\n   397\t\tseen := map[string]bool{}\r\n   398\t\tfor _, cf := range cps {\r\n   399\t\t\tif cf.Provenance == nil {\r\n   400\t\t\t\tcontinue\r\n   401\t\t\t}\r\n   402\t\t\troot := cf.FileHash\r\n   403\t\t\tfor root != \"\" {\r\n   404\t\t\t\tparent, ok := byHash[root]\r\n   405\t\t\t\tif !ok || parent == nil || parent.Provenance == nil || parent.Provenance.ParentHash == \"\" {\r\n"]
[1907.768302, "o", "   406\t\t\t\t\tbreak\r\n   407\t\t\t\t}\r\n   408\t\t\t\troot = parent.Provenance.ParentHash\r\n   409\t\t\t}\r\n   410\t\t\tif seen[root] {\r\n   411\t\t\t\tcontinue\r\n   412\t\t\t}\r\n   413\t\t\tseen[root] = true\r\n"]
[1907.768362, "o", "   414\t\r\n   415\t\t\tchain := []string{}\r\n   416\t\t\tqueue := []string{root}\r\n   417\t\t\tvisited := map[string]bool{}\r\n   418\t\t\tfor len(queue) > 0 {\r\n   419\t\t\t\tcur := queue[0]\r\n   420\t\t\t\tqueue = queue[1:]\r\n   421\t\t\t\tif visited[cur] {\r\n   422\t\t\t\t\tcontinue\r\n"]
[1907.768419, "o", "   423\t\t\t\t}\r\n   424\t\t\t\tvisited[cur] = true\r\n   425\t\t\t\tnode, ok := byHash[cur]\r\n   426\t\t\t\tif !ok || node == nil {\r\n   427\t\t\t\t\tcontinue\r\n   428\t\t\t\t}\r\n   429\t\t\t\tchain = append(chain, node.Filename)\r\n   430\t\t\t\tqueue = append(queue, children[cur]...)\r\n"]
[1907.768474, "o", "   431\t\t\t}\r\n   432\t\t\tsort.Strings(chain)\r\n   433\t\r\n   434\t\t\thashes := map[string]struct{}{}\r\n   435\t\t\tfor _, h := range chain {\r\n   436\t\t\t\tif node, ok := byHashFile(cps, h); ok && node.Provenance != nil {\r\n   437\t\t\t\t\thashes[node.Provenance.DatasetHash] = struct{}{}\r\n   438\t\t\t\t}\r\n   439\t\t\t}\r\n"]
[1907.76854, "o", "   440\t\t\tif len(hashes) > 1 {\r\n   441\t\t\t\tunique := make([]string, 0, len(hashes))\r\n   442\t\t\t\tfor h := range hashes {\r\n   443\t\t\t\t\tunique = append(unique, h)\r\n   444\t\t\t\t}\r\n"]
[1907.768606, "o", "   445\t\t\t\tsort.Strings(unique)\r\n   446\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   447\t\t\t\t\tType:     \"dataset_hash_inconsistency\",\r\n   448\t\t\t\t\tSeverity: \"high\",\r\n   449\t\t\t\t\tDetails: map[string]interface{}{\r\n   450\t\t\t\t\t\t\"files\":  chain,\r\n   451\t\t\t\t\t\t\"hashes\": unique,\r\n   452\t\t\t\t\t},\r\n   453\t\t\t\t\tSource: chain[0],\r\n   454\t\t\t\t})\r\n   455\t\t\t}\r\n   456\t\t}\r\n"]
[1907.768662, "o", "   457\t\treturn anomalies\r\n   458\t}\r\n   459\t\r\n   460\tfunc byHashFile(cps []*types.CheckpointFile, file string) (*types.CheckpointFile, bool) {\r\n   461\t\tfor _, cf := range cps {\r\n   462\t\t\tif cf.Filename == file {\r\n   463\t\t\t\treturn cf, true\r\n   464\t\t\t}\r\n   465"]
[1907.768723, "o", "\t\t}\r\n   466\t\treturn nil, false\r\n   467\t}\r\n   468\t\r\n   469\tfunc signatureDetails(path string) (bool, string) {\r\n   470\t\traw, err := os.ReadFile(path)\r\n   471\t\tif err != nil || len(raw) < 56 {\r\n   472\t\t\treturn false, \"\"\r\n   473\t\t}\r\n   474\t"]
[1907.768778, "o", "\tsigOff := binary.LittleEndian.Uint64(raw[32:40])\r\n   475\t\tif sigOff == 0 || int(sigOff) >= len(raw) || int(sigOff)+5 > len(raw) {\r\n   476\t\t\treturn false, \"\"\r\n   477\t\t}\r\n   478\t\toff := int(sigOff)\r\n   479\t\toff++ // algorithm\r\n   480\t\tsignerLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n"]
[1907.768835, "o", "   481\t\toff += 2\r\n   482\t\tif off+signerLen+2 > len(raw) {\r\n   483\t\t\treturn false, \"\"\r\n   484\t\t}\r\n   485\t\tsignerID := string(raw[off : off+signerLen])\r\n   486\t\toff += signerLen\r\n   487\t\tsigLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n   488\t\toff += 2\r\n   489\t\tif off+sigLen > len(raw) {"]
[1907.768891, "o", "\r\n   490\t\t\treturn false, signerID\r\n   491\t\t}\r\n   492\t\tstored := raw[off : off+sigLen]\r\n   493\t\tmac := hmac.New(sha256.New, []byte(signerID))\r\n   494\t\tmac.Write(raw[:sigOff])\r\n   495\t\texpected := mac.Sum(nil)\r\n   496\t\treturn hmac.Equal(expected, stored), signerID\r\n   497"]
[1907.768965, "o", "\t}\r\n   498\t\r\n   499\tfunc firstSource(e types.TimelineEntry) string {\r\n   500\t\tif len(e.Sources) > 0 {\r\n   501\t\t\treturn e.Sources[0]\r\n   502\t\t}\r\n   503\t\treturn \"\"\r\n   504\t}\r\n   505\t\r\n"]
[1907.769028, "o", "   506\tfunc meanFloats(v []float64) float64 {\r\n   507\t\tif len(v) == 0 {\r\n   508\t\t\treturn 0\r\n   509\t\t}\r\n   510\t\ts := 0.0\r\n   511\t\tfor _, x := range v {\r\n   512\t\t\ts += x\r\n   513\t\t}\r\n   514\t\treturn s / float64(len(v))\r\n   515\t"]
[1907.769085, "o", "}\r\n   516\t\r\n   517\tfunc stddevFloats(v []float64, mean float64) float64 {\r\n   518\t\tif len(v) == 0 {\r\n   519\t\t\treturn 0\r\n   520\t\t}\r\n   521\t\ts := 0.0\r\n   522\t\t"]
[1907.76914, "o", "for _, x := range v {\r\n   523\t\t\td := x - mean\r\n   524\t\t\ts += d * d\r\n   525\t\t}\r\n   526\t\treturn math.Sqrt(s / float64(len(v)))\r\n   527\t}\r\n   528\t\r\n   529\tfunc sortAnomalies(a []types.Anomaly) {\r\n"]
[1907.769209, "o", "   530\t\trank := map[string]int{\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3}\r\n   531\t\tsort.Slice(a, func(i, j int) bool {\r\n   532\t\t\tri := rank[a[i].Severity]\r\n   533\t\t\trj := rank[a[j].Severity]\r\n   534\t\t\tif ri != rj {\r\n   535\t\t\t\treturn ri < rj\r\n   536\t\t\t}\r\n   537\t\t\tei := -1\r\n   538\t\t\tej := -1\r\n"]
[1907.769244, "o", "   539\t\t\tif a[i].Epoch != nil {\r\n   540\t\t\t\tei = *a[i].Epoch\r\n   541\t\t\t}\r\n   542\t\t\tej = -1\r\n   543\t\t"]
[1907.769327, "o", "\tif a[j].Epoch != nil {\r\n   544\t\t\t\tej = *a[j].Epoch\r\n   545\t\t\t}\r\n   546\t\t\tif ei != ej {\r\n   547\t\t\t\treturn ei < ej\r\n   548\t\t\t}\r\n   549\t\t\tsi := -1\r\n   550\t\t\tif a[i].Step != nil {\r\n   551\t\t\t\tsi = *a[i].Step\r\n   552\t\t\t}\r\n   553\t\t\tsj := -1\r\n   554"]
[1907.769383, "o", "\t\t\tif a[j].Step != nil {\r\n   555\t\t\t\tsj = *a[j].Step\r\n   556\t\t\t}\r\n   557\t\t\treturn si < sj\r\n   558\t\t})\r\n   559\t}\r\n"]
