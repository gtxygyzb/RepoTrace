[2765.183374, "o", "sed -n '1,260p' cmd/mlforge/main.go\r\n\u001b[?2004l\r"]
[2765.186405, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n\r\n"]
[2765.186538, "o", "\t\"mlforge/internal/forensics\"\r\n)\r\n\r\nfunc main() {\r\n\t// --- Parse flags ---------------------------------------------------\r\n\tformat := \"json\"\r\n\tverbose := false\r\n\tvar positional []string\r\n\r\n\tfor _, arg := range os.Args[1:] {\r\n\t\tswitch {\r\n\t\tcase arg == \"--verbose\":\r\n\t\t\tverbose = true\r\n\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n\t\tcase arg == \"--format\":\r\n\t\t// handled below as two-token flag\r\n\t\tdefault:\r\n\t\t\tpositional = append(positional, arg)\r\n\t\t}\r\n\t}\r\n\r\n\t// Handle \"--format json\" (two separate tokens)\r\n\tfor i := 1; i < len(os.Args)-1; i++ {\r\n\t\tif os.Args[i] == \"--format\" {\r\n"]
[2765.186632, "o", "\t\t\tformat = os.Args[i+1]\r\n\t\t\t// Remove the value from positional args\r\n\t\t\tfiltered := positional[:0]\r\n\t\t\tfor _, p := range positional {\r\n\t\t\t\tif p != os.Args[i+1] {\r\n\t\t\t\t\tfiltered = append(filtered, p)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tpositional = filtered\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n\tif format != \"json\" && format != \"text\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json or text\\n\", format)\r\n"]
[2765.18671, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\t_ = verbose // reserved for diagnostic output\r\n\r\n\t// --- Validate positional args --------------------------------------\r\n\tif len(positional) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := positional[0]\r\n\tdir := positional[1]\r\n\r\n\t// --- Route to command handler --------------------------------------\r\n\tvar result interface{}\r\n\tvar err error\r\n\r\n"]
[2765.186783, "o", "\tswitch cmd {\r\n\tcase \"ingest\":\r\n\t\tresult, err = forensics.BuildIngest(dir)\r\n\tcase \"timeline\":\r\n\t\tresult, err = forensics.BuildTimeline(dir)\r\n\tcase \"verify\":\r\n\t\tresult, err = forensics.BuildVerify(dir)\r\n\tcase \"detect\":\r\n\t\tresult, err = forensics.BuildDetect(dir)\r\n\tcase \"lineage\":\r\n\t\tresult, err = forensics.BuildLineage(dir)\r\n\tcase \"query\":\r\n"]
[2765.186857, "o", "\t\tif len(positional) < 3 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tresult, err = forensics.BuildQuery(dir, positional[2])\r\n\tcase \"report\":\r\n\t\tresult, err = forensics.BuildReport(dir)\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t// --- Output --------------------------------------------------------\r\n"]
[2765.186928, "o", "\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif format == \"text\" {\r\n\t\tprintText(result)\r\n\t\treturn\r\n\t}\r\n\r\n\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n\t"]
[2765.187017, "o", "if marshalErr != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error marshalling result: %v\\n\", marshalErr)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Println(string(out))\r\n}\r\n\r\nfunc printText(v interface{}) {\r\n\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n\tif err != nil {\r\n"]
[2765.187085, "o", "\t\tfmt.Fprintln(os.Stderr, \"error rendering text output\")\r\n\t\treturn\r\n\t}\r\n\tfmt.Println(string(b))\r\n}\r\n"]
