[4449.216015, "o", "\t\t\tif prev.Lr == nil || cur.Lr == nil {\r\n   197\t\t\t\tcontinue\r\n   198\t\t\t}\r\n   199\t\t\tif *cur.Lr > *prev.Lr {\r\n   200\t\t\t\tif cur.Event == \"epoch_end\" {\r\n   201\t\t\t\t\tcontinue\r\n"]
[4449.216101, "o", "   202\t\t\t\t}\r\n   203\t\t\t\tep := cur.Epoch\r\n   204\t\t\t\tst := cur.Step\r\n   205\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   206\t\t\t\t\tType:     \"lr_anomaly\",\r\n   207\t\t\t\t\tSeverity: \"medium\",\r\n   208\t\t\t\t\tEpoch:    &ep,\r\n   209\t\t\t\t\tStep:     &st,\r\n   210\t\t\t\t\tDetails: map[string]interface{}{\r\n   211\t\t\t\t\t\t\"prev_lr\": *prev.Lr,\r\n   212\t\t\t\t\t\t\"curr_lr\": *cur.Lr,\r\n   213\t\t\t\t\t\t\"step\":    cur.Step,\r\n   214\t\t\t\t\t},\r\n   215\t\t\t\t\tSource: firstSource(cur),\r\n   216\t\t\t\t})\r\n   217\t\t\t}\r\n   218\t\t}\r\n   219\t\treturn anomalies\r\n   220\t}\r\n   221\t\r\n   222\tfunc detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\r\n   223\t\tvar anomalies []types.Anomaly\r\n   224\t\tfor i := 1; i < len(entries); i++ {\r\n   225\t\t\tprev := entries[i-1]\r\n   226\t\t\tcur := entries[i]\r\n   227\t\t\tif prev.Epoch != cur.Epoch {\r\n"]
[4449.216191, "o", "   228\t\t\t\tcontinue\r\n   229\t\t\t}\r\n   230\t\t\tprevT, err1 := time.Parse(time.RFC3339, prev.Ts)\r\n   231\t\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\r\n   232\t\t\tif err1 != nil || err2 != nil {\r\n   233\t\t\t\tcontinue\r\n   234\t\t\t}\r\n"]
[4449.216265, "o", "   235\t\t\tdiff := curT.Sub(prevT).Seconds()\r\n   236\t\t\tif diff > 3600 {\r\n   237\t\t\t\tep := cur.Epoch\r\n   238\t\t\t\tst := cur.Step\r\n   239\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   240\t\t\t\t\tType:     \"training_gap\",\r\n   241\t\t\t\t\tSeverity: \"low\",\r\n   242\t\t\t\t\tEpoch:    &ep,\r\n   243\t\t\t\t\tStep:     &st,\r\n   244\t\t\t\t\tDetails: map[string]interface{}{\r\n   245\t\t\t\t\t\t\"after_step\":  prev.Step,\r\n   246\t\t\t\t\t\t\"before_step\": cur.Step,\r\n   247\t\t\t\t\t\t\"after_ts\":    prev.Ts,\r\n   248\t\t\t\t\t\t\"before_ts\":   cur.Ts,\r\n   249\t\t\t\t\t\t\"gap_seconds\": diff,\r\n   250\t\t\t\t\t},\r\n   251\t\t\t\t\tSource: firstSource(cur),\r\n"]
[4449.216338, "o", "   252\t\t\t\t})\r\n   253\t\t\t}\r\n   254\t\t}\r\n   255\t\treturn anomalies\r\n   256\t}\r\n   257\t\r\n   258\tfunc detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {\r\n   259\t\tvar cps []types.TimelineEntry\r\n   260\t\tfor _, e := range entries {\r\n   261\t\t\tif e.Event == \"checkpoint\" {\r\n"]
[4449.216411, "o", "   262\t\t\t\tcps = append(cps, e)\r\n   263\t\t\t}\r\n   264\t\t}\r\n   265\t\tsortTimeline(cps)\r\n   266\t\tvar anomalies []types.Anomaly\r\n   267\t\tfor i := 1; i < len(cps); i++ {\r\n   268\t\t\tprev := cps[i-1]\r\n   269\t\t\tcur := cps[i]\r\n   270\t\t\tif prev.Acc == nil || cur.Acc == nil {\r\n   271\t\t\t\tcontinue\r\n   272"]
[4449.216487, "o", "\t\t\t}\r\n   273\t\t\tdrop := *prev.Acc - *cur.Acc\r\n   274\t\t\tif drop > 0.15 {\r\n   275\t\t\t\tep := cur.Epoch\r\n   276\t\t\t\tst := cur.Step\r\n   277\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   278\t\t\t\t\tType:     \"metric_regression\",\r\n   279\t\t\t\t\tSeverity: \"high\",\r\n   280\t\t\t\t\tEpoch:    &ep,\r\n"]
[4449.216561, "o", "   281\t\t\t\t\tStep:     &st,\r\n   282\t\t\t\t\tDetails: map[string]interface{}{\r\n   283\t\t\t\t\t\t\"prev_acc\":        *prev.Acc,\r\n   284\t\t\t\t\t\t\"curr_acc\":        *cur.Acc,\r\n   285\t\t\t\t\t\t\"drop\":            drop,\r\n   286\t\t\t\t\t\t\"prev_checkpoint\": prev.Step,\r\n   287\t\t\t\t\t\t\"curr_checkpoint\": cur.Step,\r\n   288\t\t\t\t\t},\r\n"]
[4449.21664, "o", "   289\t\t\t\t\tSource: firstSource(cur),\r\n   290\t\t\t\t})\r\n   291\t\t\t}\r\n   292\t\t}\r\n   293\t\treturn anomalies\r\n   294\t}\r\n   295\t\r\n   296\tfunc detectCheckpointAnomalies(dir string, cps []*types.CheckpointFile) []types.Anomaly {\r\n   297\t\tvar anomalies []types.Anomaly\r\n   298\t\thashSet := map[string]*types.CheckpointFile{}\r\n   299\t\tfor _, cf := range cps {\r\n   300\t"]
[4449.216712, "o", "\t\thashSet[cf.FileHash] = cf\r\n   301\t\t}\r\n   302\t\r\n   303\t\tfor _, cf := range cps {\r\n   304\t\t\traw, err := os.ReadFile(cf.Path)\r\n   305\t\t\tif err != nil {\r\n   306\t\t\t\tcontinue\r\n   307\t\t\t}\r\n   308\t\t\tif !cf.HeaderValid {\r\n   309\t\t\t\tstored := uint64(0)\r\n"]
[4449.216781, "o", "   310\t\t\t\tif len(raw) >= 56 {\r\n   311\t\t\t\t\tstored = binary.LittleEndian.Uint64(raw[48:56])\r\n   312\t\t\t\t}\r\n   313\t\t\t\th := fnv.New64a()\r\n   314\t\t\t\th.Write(raw[:48])\r\n   315\t\t\t\tcomputed := h.Sum64()\r\n   316\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   317\t\t\t\t\tType:     \"header_checksum_mismatch\",\r\n   318\t\t\t\t\tSeverity: \"critical\",\r\n"]
[4449.216851, "o", "   319\t\t\t\t\tDetails: map[string]interface{}{\r\n   320\t\t\t\t\t\t\"file\":              cf.Filename,\r\n   321\t\t\t\t\t\t\"expected_checksum\": fmt.Sprintf(\"%016x\", stored),\r\n   322\t\t\t\t\t\t\"actual_checksum\":   fmt.Sprintf(\"%016x\", computed),\r\n   323\t\t\t\t\t},\r\n   324\t\t\t\t\tSource:     cf.Filename,\r\n   325\t\t\t\t\tCheckpoint: cf.Filename,\r\n   326\t\t\t\t})\r\n   327\t\t\t}\r\n"]
[4449.216929, "o", "   328\t\r\n   329\t\t\tfor _, t := range cf.Tensors {\r\n   330\t\t\t\tif !t.Valid {\r\n   331\t\t\t\t\tcomputed := sha256.Sum256(t.Data)\r\n   332\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   333\t\t\t\t\t"]
[4449.217012, "o", "\tType:     \"tensor_checksum_mismatch\",\r\n   334\t\t\t\t\t\tSeverity: \"critical\",\r\n   335\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   336\t\t\t\t\t\t\t\"file\":              cf.Filename,\r\n   337\t\t\t\t\t\t\t\"tensor_name\":       t.Name,\r\n   338\t\t\t\t\t\t\t\"expected_checksum\": hex.EncodeToString(t.Hash[:]),\r\n   339\t\t\t\t\t\t\t\"actual_checksum\":   hex.EncodeToString(computed[:]),\r\n   340\t\t\t"]
[4449.217083, "o", "\t\t\t},\r\n   341\t\t\t\t\t\tSource:     cf.Filename,\r\n   342\t\t\t\t\t\tCheckpoint: cf.Filename,\r\n   343"]
[4449.217158, "o", "\t\t\t\t\t})\r\n   344\t\t\t\t}\r\n   345\t\t\t}\r\n   346\t\r\n   347\t\t\tif cf.Signed {\r\n   348\t\t\t\tvalid, signer := signatureDetails(cf.Path)\r\n   349\t\t\t\tif !valid {\r\n   350\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   351\t\t\t\t\t\tType:     \"signature_invalid\",\r\n   352\t\t\t\t\t\tSeverity: \"critical\",\r\n   353\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   354\t\t\t\t\t\t\t\"file\":      cf.Filename,\r\n   355\t\t\t\t\t\t\t\"signer_id\": signer,\r\n   356\t\t\t\t\t\t\t\"valid\":     false,\r\n"]
[4449.217228, "o", "   357\t\t\t\t\t\t},\r\n   358\t\t\t\t\t\tSource:     cf.Filename,\r\n   359\t\t\t\t\t\tCheckpoint: cf.Filename,\r\n   360\t\t\t\t\t})\r\n   361\t\t\t\t}\r\n   362\t\t\t}\r\n   363\t\r\n   364\t\t\tif cf.Provenance != nil && cf.Provenance.ParentHash != \"\" {\r\n   365\t\t\t\t"]
[4449.217296, "o", "_, found := hashSet[cf.Provenance.ParentHash]\r\n   366\t\t\t\tif !found {\r\n   367\t\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   368\t\t\t\t\t\tType:     \"provenance_chain_break\",\r\n   369\t\t\t\t\t\tSeverity: \"high\",\r\n   370\t\t\t\t\t\tDetails: map[string]interface{}{\r\n   371\t\t\t\t\t\t\t\"file\":        cf.Filename,\r\n   372\t\t\t\t\t\t"]
