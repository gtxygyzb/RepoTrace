[7264.891769, "o", "\"encoding/binary\"\r\n     7\t\t\"encoding/hex\"\r\n     8\t\t\"fmt\"\r\n     9\t\t\"hash/fnv\"\r\n    10\t\t\"math\"\r\n    11\t\t\"os\"\r\n    12\t\t\"sort\"\r\n    13\t\t\"time\"\r\n    14\t\r\n    15\t\t\"mlforge/internal/checkpoint\"\r\n    16\t\t\"mlforge/internal/types\"\r\n    17\t)\r\n"]
[7264.891834, "o", "    18\t\r\n    19\tfunc loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {\r\n    20\t\tap, err := DiscoverArtifacts(dir)\r\n    21\t\tif err != nil {\r\n    22\t\t\treturn nil, err\r\n    23\t\t}\r\n    24\t\tvar cps []*types.CheckpointFile\r\n    25\t\tfor _, p := range ap.Checkpoints {\r\n    26\t\t\tcf, err := checkpoint.Parse(p)\r\n"]
[7264.891864, "o", "    27\t\t\tif err != nil || cf == nil {\r\n    28\t\t\t\tcontinue\r\n    29\t\t\t}\r\n    30\t\t\tcps = append(cps, cf)"]
[7264.891975, "o", "\r\n    31\t\t}\r\n    32\t\tsort.Slice(cps, func(i, j int) bool {\r\n    33\t\t\treturn cps[i].Filename < cps[j].Filename\r\n    34\t\t})\r\n    35\t\treturn cps, nil\r\n    36\t}\r\n    37\t\r\n    38\ttype DetectOutput struct {\r\n    39\t\tStatus    string          `json:\"status\"`\r\n    40\t\tAnomalies []types.Anomaly `json:\"anomalies\"`\r\n    41\t\tSummary   struct {\r\n    42\t\t\tTotal      int            `json:\"total\"`\r\n    43\t\t\tBySeverity map[string]int `json:\"by_severity\"`\r\n"]
[7264.891995, "o", "    44\t\t\tByType     map[string]int `json:\"by_type\"`\r\n    45\t\t} `json:\"summary\"`\r\n    46\t}\r\n"]
[7264.892072, "o", "    47\t\r\n    48\t"]
[7264.892103, "o", "func BuildDetect(dir string) (interface{}, error) {\r\n    49\t\treturn BuildDetectFiltered(dir, \"\")\r\n    50\t}\r\n    51\t\r\n    52\tfunc BuildDetectFiltered(dir, filterSeverity string) (DetectOutput, error) {\r\n    53\t\tvar out DetectOutput\r\n    54\t\tout.Status = \"ok\"\r\n    55\t\tvar anomalies []types.Anomaly\r\n    56\t\r\n    57\t\tentries, _, err := loadTimelineEntries(dir)\r\n    58\t\tif err == nil {\r\n    59\t\t\tmerged, _ := mergeTimeline(entries)\r\n    60\t\t\tsortTimeline(merged)\r\n    61\t\t\tanomalies = append(anomalies, detectTimelineAnomalies(merged)...)\r\n    62\t\t}\r\n"]
[7264.892177, "o", "    63\t\r\n    64\t\tcps, err := loadCheckpoints(dir)\r\n    65\t\tif err == nil {\r\n    66\t\t\tanomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\r\n    67\t\t}\r\n    68\t\r\n    69\t\tif filterSeverity != \"\" {\r\n    70\t\t\twantedRank, ok := severityRankValue(filterSeverity)\r\n    71\t\t\tif !ok {\r\n    72\t\t\t\treturn out, fmt.Errorf(\"invalid severity level %q: must be critical, high, medium, low, or info\", filterSeverity)\r\n    73\t\t"]
[7264.892247, "o", "\t}\r\n    74\t\t\tfiltered := anomalies[:0]\r\n    75\t\t"]
[7264.892303, "o", "\tfor _, a := range anomalies {\r\n    76\t\t\t\tif severityRank(a.Severity) <= wantedRank {\r\n    77\t\t\t\t\tfiltered = append(filtered, a)\r\n    78\t\t\t\t}\r\n    79\t\t\t}\r\n    80\t\t\tanomalies = filtered\r\n"]
