[2775.590365, "i", "sed -n '1,140p' internal/checkpoint/parser.go\n"]
[2775.590752, "o", "sed -n '1,140p' internal/checkpoint/parser.go\r\n\u001b[?2004l\r"]
[2775.593784, "o", "package checkpoint\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n\t\"fmt\"\r\n\t\"hash/fnv\"\r\n\t\"math\"\r\n"]
[2775.593894, "o", "\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\r\n\t\"mlforge/internal/types\"\r\n)\r\n\r\nconst (\r\n\tmagicMLCK  = \"MLCK\"\r\n\theaderSize = 56\r\n)\r\n\r\n// Parse reads and validates a single .mlck checkpoint file according to the\r\n// MLCK binary format specification (see /app/docs/formats.md).\r\nfunc Parse(path string) (*types.CheckpointFile, error) {\r\n\traw, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: read %s: %w\", path, err)\r\n\t}\r\n\tif len(raw) < headerSize {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: file too small (%d bytes)\", len(raw))\r\n"]
[2775.594023, "o", "\t}\r\n\r\n\t// --- magic (offset 0, 4 bytes) ---\r\n\tif string(raw[0:4]) != magicMLCK {\r\n\t\treturn nil, fmt.Errorf(\"checkpoint: bad magic %q\", raw[0:4])\r\n\t}\r\n\r\n\t// --- header fields ---\r\n\tversion := binary.LittleEndian.Uint16(raw[4:6])\r\n\tflags := binary.LittleEndian.Uint16(raw[6:8])\r\n\tnumTensors := binary.LittleEndian.Uint32(raw[8:12])\r\n\tnumMetadata := binary.LittleEndian.Uint32(raw[12:16])\r\n\tmetadataOffset := binary.LittleEndian.Uint64(raw[16:24])\r\n\tprovenanceOffset := binary.LittleEndian.Uint64(raw[24:32])\r\n\t_ = binary.LittleEndian.Uint64(raw[32:40]) // signatureOffset (unused for now)\r\n\tcreationTimestamp := int64(binary.LittleEndian.Uint64(raw[40:48]))\r\n\tstoredChecksum := binary.LittleEndian.Uint64(raw[48:56])\r\n\r\n\t// --- verify header checksum: FNV-1a of bytes [0..48) ---\r\n\th := fnv.New64a()\r\n\th.Write(raw[:48])\r\n\tcomputedChecksum := h.Sum64()\r\n\theaderValid := computedChecksum == storedChecksum\r\n"]
[2775.5941, "o", "\r\n\t// --- SHA-256 file hash ---\r\n\tfileHashBytes := sha256.Sum256(raw)\r\n\tfileHash := hex.EncodeToString(fileHashBytes[:])\r\n\r\n\tsigned := flags&1 != 0\r\n\r\n\tcf := &types.CheckpointFile{\r\n\t\tPath:              path,\r\n\t\tFilename:          filepath.Base(path),\r\n\t\tVersion:           uint32(version),\r\n\t\tFlags:             flags,\r\n\t\tNumTensors:        numTensors,\r\n"]
[2775.59418, "o", "\t\tNumMetadataKeys:   numMetadata,\r\n\t\tCreationTimestamp:  creationTimestamp,\r\n\t\tHeaderValid:       headerValid,\r\n\t\tFileHash:          fileHash,\r\n\t\tSigned:            signed,\r\n\t}\r\n\r\n\t// --- parse tensor blocks (start at offset 56) ---\r\n\toff := headerSize\r\n\ttensors := make([]types.TensorInfo, 0, numTensors)\r\n\tfor i := uint32(0); i < numTensors; i++ {\r\n\t\tti, newOff, err := parseTensor(raw, off, i)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n"]
[2775.594251, "o", "\t\ttensors = append(tensors, ti)\r\n\t\toff = newOff\r\n\t}\r\n\tcf.Tensors = tensors\r\n\r\n\t// --- parse metadata section ---\r\n\tif numMetadata > 0 && metadataOffset > 0 && int(metadataOffset) < len(raw) {\r\n\t\tmd, err := parseMetadata(raw, int(metadataOffset), numMetadata)\r\n\t\tif err == nil {\r\n\t\t\tcf.MetadataMap = md\r\n\t\t}\r\n"]
[2775.594323, "o", "\t}\r\n\r\n\t// --- parse provenance section ---\r\n\tif provenanceOffset > 0 && int(provenanceOffset) < len(raw) {\r\n\t\tprov, err := parseProvenance(raw, int(provenanceOffset))\r\n\t\tif err == nil {\r\n\t\t\tcf.Provenance = prov\r\n\t\t\tcf.HasParent = prov.ParentHash != \"\"\r\n\t\t\tcf.ParentHex = prov.ParentHash\r\n\t\t}\r\n\t}\r\n\r\n\treturn cf, nil\r\n"]
[2775.594396, "o", "}\r\n\r\n// parseTensor parses one tensor block starting at off and returns the\r\n// TensorInfo plus the new offset after the block.\r\nfunc parseTensor(raw []byte, off int, idx uint32) (types.TensorInfo, int, error) {\r\n\tfail := func(msg string) (types.TensorInfo, int, error) {\r\n\t\treturn types.TensorInfo{}, 0, fmt.Errorf(\"checkpoint: tensor %d: %s\", idx, msg)\r\n\t}\r\n\r\n\t// name_len (uint16 LE)\r\n\tif off+2 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading name_len\")\r\n"]
[2775.594473, "o", "\t}\r\n\tnameLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\toff += 2\r\n\r\n\t// name\r\n\tif off+nameLen > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading name\")\r\n\t}\r\n\tname := string(raw[off : off+nameLen])\r\n\toff += nameLen\r\n\r\n\t// dtype (1 byte)\r\n\tif off+1 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading dtype\")\r\n"]
[2775.594512, "o", "\t}\r\n\tdtype := raw[off]\r\n\toff++\r\n\r\n\t// num_dims (1 byte)\r\n\tif off+1 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading num_dims\")\r\n\t}\r\n\tnumDims := int(raw[off])\r\n"]
[2775.595079, "o", "\u001b[?2004h"]
[2775.595153, "o", "root@n30009:/app# "]
[2775.883877, "i", "sed -n '140,260p' internal/checkpoint/parser.go\n"]
[2775.884308, "o", "sed -n '140,260p' internal/checkpoint/parser.go\r\n\u001b[?2004l\r"]
[2775.887424, "o", "\tnumDims := int(raw[off])\r\n\toff++\r\n\r\n\t// shape (num_dims * uint32 LE)\r\n\tshapeBytes := numDims * 4\r\n\tif off+shapeBytes > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading shape\")\r\n\t}"]
[2775.887544, "o", "\r\n\tshape := make([]uint32, numDims)\r\n\tfor d := 0; d < numDims; d++ {\r\n\t\tshape[d] = binary.LittleEndian.Uint32(raw[off : off+4])\r\n\t\toff += 4\r\n\t}\r\n\r\n\t// data_size (uint64 LE)\r\n\tif off+8 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading data_size\")\r\n\t}\r\n\tdataSize := binary.LittleEndian.Uint64(raw[off : off+8])\r\n\toff += 8\r\n\r\n\t// data\r\n\tif off+int(dataSize) > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading data\")\r\n\t}\r\n\tdata := raw[off : off+int(dataSize)]\r\n\toff += int(dataSize)\r\n"]
[2775.887642, "o", "\r\n\t// hash (32 bytes SHA-256)\r\n\tif off+32 > len(raw) {\r\n\t\treturn fail(\"unexpected EOF reading hash\")\r\n\t}\r\n\tvar storedHash [32]byte\r\n\tcopy(storedHash[:], raw[off:off+32])\r\n\toff += 32\r\n\r\n\t// verify SHA-256\r\n\tcomputedHash := sha256.Sum256(data)\r\n\tvalid := computedHash == storedHash\r\n\r\n\treturn types.TensorInfo{\r\n\t\tName:  name,\r\n\t\tDtype: dtype,\r\n\t\tShape: shape,\r\n\t\tData:  data,\r\n\t\tHash:  storedHash,\r\n\t\tValid: valid,\r\n\t}, off, nil\r\n"]
[2775.887722, "o", "}\r\n\r\n// parseMetadata parses the metadata section: numMeta key-value pairs.\r\nfunc parseMetadata(raw []byte, off int, numMeta uint32) (map[string]string, error) {\r\n\tmd := make(map[string]string, numMeta)\r\n\tfor i := uint32(0); i < numMeta; i++ {\r\n\t\t// key_len (uint16)\r\n\t\tif off+2 > len(raw) {\r\n\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at key_len %d\", i)\r\n\t\t}\r\n\t\tkeyLen := int(binary.LittleEndian.Uint16(raw[off : off+2]))\r\n\t\toff += 2\r\n\r\n\t\tif off+keyLen > len(raw) {\r\n\t\t"]
[2775.887802, "o", "\treturn md, fmt.Errorf(\"metadata: unexpected EOF at key %d\", i)\r\n\t\t}\r\n\t\tkey := string(raw[off : off+keyLen])\r\n\t\toff += keyLen\r\n\r\n\t\t// value_len (uint32)\r\n\t\tif off+4 > len(raw) {\r\n\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at value_len %d\", i)\r\n\t\t}\r\n\t\tvalLen := int(binary.LittleEndian.Uint32(raw[off : off+4]))\r\n\t\toff += 4\r\n"]
[2775.88789, "o", "\r\n\t\tif off+valLen > len(raw) {\r\n\t\t\treturn md, fmt.Errorf(\"metadata: unexpected EOF at value %d\", i)\r\n\t\t}\r\n\t\tval := string(raw[off : off+valLen])\r\n\t\toff += valLen\r\n\r\n\t\tmd[key] = val\r\n\t}\r\n\treturn md, nil\r\n}\r\n\r\n// parseProvenance parses the provenance section.\r\nfunc parseProvenance(raw []byte, off int) (*types.Provenance, error) {\r\n\tp := &types.Provenance{}\r\n\r\n\t"]
[2775.887981, "o", "// GitCommit: 40 bytes ASCII\r\n\tif off+40 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at git_commit\")\r\n\t}\r\n\tp.GitCommit = strings.TrimRight(string(raw[off:off+40]), \"\\x00\")\r\n\toff += 40\r\n\r\n\t// DatasetHash: 32 bytes raw → hex\r\n\tif off+32 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at dataset_hash\")\r\n\t}\r\n\tp.DatasetHash = hex.EncodeToString(raw[off : off+32])\r\n\toff += 32\r\n\r\n\t// ConfigHash: 32 bytes raw → hex\r\n\tif off+32 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at config_hash\")\r\n\t"]
[2775.888033, "o", "}\r\n\tp.ConfigHash = hex.EncodeToString(raw[off : off+32])\r\n\toff += 32\r\n\r\n\t// TrainingTimestamp: int64\r\n\tif off+8 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at training_timestamp\")\r\n\t}\r\n\tp.TrainingTimestamp = int64(binary.LittleEndian.Uint64(raw[off : off+8]))\r\n"]
[2775.888128, "o", "\toff += 8\r\n\r\n\t// TrainingDuration: float64\r\n\tif off+8 > len(raw) {\r\n\t\treturn nil, fmt.Errorf(\"provenance: unexpected EOF at training_duration\")\r\n\t}\r\n"]
[2775.88861, "o", "\u001b[?2004h"]
[2775.888679, "o", "root@n30009:/app# "]
[2776.187971, "i", "for f in docs/*; do echo \"===== $f\"; sed -n '1,220p' \"$f\"; done\n"]
[2776.188447, "o", "for f in docs/*; do echo \"===== $f\"; sed -n '1,220p' \"$f\"; done\r\n\u001b[?2004l\r"]
[2776.188755, "o", "===== docs/analysis_rules.md\r\n"]
[2776.19158, "o", "# Analysis Rules and Query Language\r\n\r\n## 1. Timeline Reconstruction\r\n\r\n### 1.1 Merge Algorithm\r\n\r\nGiven multiple `.jsonl` shard files, the timeline is reconstructed as follows:\r\n\r\n"]
[2776.191676, "o", "1. **Parse**: Read all entries from all shard files. Skip malformed JSON lines.\r\n2. **Deduplicate**: Entries are keyed by `(epoch, step)`. When multiple entries share the same key:\r\n   - If all numeric metric values (loss, lr, grad_norm, acc) are identical (within 1e-9 tolerance), keep one copy.\r\n   - If values differ, this is a **conflict**. Resolution: keep the entry with the **latest** `ts` timestamp. Record the conflict.\r\n3. **Sort**: Sort the unified timeline by `(epoch ASC, step ASC)`.\r\n4. **Gap Detection**: A gap exists when consecutive entries (after sorting) satisfy:\r\n   - Same epoch: `step_diff = next.step - curr.step > 1` AND `step_diff > 100`\r\n   - Cross-epoch boundary: not a gap (step resets are normal at epoch boundaries)\r\n\r\n### 1.2 Timeline Entry Output\r\n\r\nAfter merge, each entry in the timeline has:\r\n- All original fields from the winning entry\r\n- An additional `\"sources\"` array listing which shard files contained this `(epoch, step)`\r\n- If this entry was a conflict resolution, an additional `"]
[2776.191761, "o", "\"conflict\": true` field\r\n\r\n---\r\n\r\n## 2. Anomaly Detection Rules\r\n\r\nAnomalies are classified by severity: `critical`, `high`, `medium`, `low`.\r\n\r\n### 2.1 Gradient Norm Spike\r\n\r\n- **Window**: Sliding window of 50 steps\r\n"]
[2776.191832, "o", "- **Method**: Compute mean and standard deviation of `grad_norm` over the window\r\n- **Trigger**: `grad_norm > mean + 3.0 * stddev` (Z-score > 3.0)\r\n- **Severity**: `high` if Z-score > 5.0, else `medium`\r\n- **Required data**: At least 50 entries with `grad_norm` before detection begins\r\n- **Output fields**: `observed`, `window_mean`, `window_stddev`, `z_score`\r\n\r\n### 2.2 Loss Divergence\r\n\r\n- **Window**: Sliding window of 50 steps\r\n- **Method**: Compare loss at window start vs window end\r\n- **Trigger**: `(loss_end - loss_start) / |loss_start| > 1.0` (>100% increase)\r\n- **Severity**: `critical` if increase > 5.0 (500%), else `high`\r\n- **Guard**: Only trigger if `|loss_start| > 1e-6` (avoid division by near-zero)\r\n- **Output fields**: `loss_start`, `loss_end`, `increase_ratio`, `window_start_step`, `window_end_step`\r\n"]
[2776.19191, "o", "\r\n### 2.3 Learning Rate Anomaly\r\n\r\n- **Method**: Analyze the sequence of `lr` values across sorted timeline\r\n- **Trigger**: `lr` increases between consecutive entries UNLESS:\r\n  - The increase coincides with an `epoch_end` event (warmup restart pattern)\r\n  - The increase is the first entry (no previous to compare)\r\n- **Severity**: `medium`\r\n- **Output fields**: `prev_lr`, `curr_lr`, `step`\r\n\r\n### 2.4 Metric Regression\r\n\r\n- **Scope**: Between consecutive checkpoints (entries with `event == \"checkpoint\"` or between .mlck files sorted by epoch/step)\r\n- **Trigger**: `acc` drops by more than 0.15 (absolute, not relative) between consecutive checkpoints\r\n- **Severity**: `high`\r\n"]
[2776.191996, "o", "- **Output fields**: `prev_acc`, `curr_acc`, `drop`, `prev_checkpoint`, `curr_checkpoint`\r\n\r\n### 2.5 Checkpoint Integrity - Tensor Checksum\r\n\r\n- **Method**: For each tensor in a `.mlck` file, compute SHA-256 of the data bytes and compare with stored checksum\r\n- **Trigger**: Mismatch\r\n- **Severity**: `critical`\r\n- **Output fields**: `file`, `tensor_name`, `expected_checksum` (hex), `actual_checksum` (hex)\r\n\r\n### 2.6 Checkpoint Integrity - Header Checksum\r\n\r\n- **Method**: Compute FNV-1a 64-bit of bytes [0..48) and compare with stored value at offset 48\r\n- **Trigger**: Mismatch\r\n- **Severity**: `critical`\r\n- **Output fields**: `file`, `expected_checksum` (hex), `actual_checksum` (hex)\r\n\r\n"]
[2776.192074, "o", "### 2.7 Checkpoint Integrity - Signature\r\n\r\n- **Method**: For signed checkpoints (Flags bit 0), compute HMAC-SHA256 of bytes [0..SignatureOffset) using SignerId as key, compare with stored signature\r\n- **Trigger**: Mismatch\r\n- **Severity**: `critical`\r\n- **Output fields**: `file`, `signer_id`, `valid` (bool)\r\n\r\n### 2.8 Provenance Chain Break\r\n\r\n- **Method**: For each checkpoint with a non-empty `parent_hash`, verify that a checkpoint with that file hash exists in the evidence set\r\n- **Trigger**: Parent checkpoint not found\r\n- **Severity**: `high`\r\n- **Output fields**: `file`, `parent_hash`, `found` (bool)\r\n\r\n### 2.9 Training Gap\r\n\r\n"]
[2776.192149, "o", "- **Method**: Consecutive timeline entries (after merge sort) have timestamps more than 2 hours apart\r\n- **Trigger**: `time_diff > 7200 seconds` between consecutive entries within the same epoch\r\n- **Severity**: `low`\r\n- **Output fields**: `after_step`, `before_step`, `after_ts`, `before_ts`, `gap_seconds`\r\n\r\n### 2.10 Dataset Hash Inconsistency\r\n\r\n- **Method**: Compare `DatasetHash` across all checkpoints in the same lineage chain\r\n- **Trigger**: Different `DatasetHash` values within the same chain\r\n- **Severity**: `high`\r\n- **Output fields**: `files`, `hashes` (list of unique hex hashes)\r\n\r\n---\r\n\r\n## 3. Query Language\r\n\r\n"]
[2776.192219, "o", "### 3.1 Grammar\r\n\r\n```\r\nquery      := condition (BOOL_OP condition)*\r\ncondition  := field COMP_OP value\r\nBOOL_OP    := \"AND\" | \"OR\"\r\nCOMP_OP    := \">\" | \"<\" | \">=\" | \"<=\" | \"==\" | \"!=\"\r\nfield      := \"step\" | \"epoch\" | \"loss\" | \"lr\" | \"grad_norm\" | \"acc\" | \"event\" | \"ts\"\r\nvalue      := NUMBER | QUOTED_STRING | TIMESTAMP\r\nNUMBER     := integer or float literal\r\nQUOTED_STRING := '\"' ... '\"' (double-quoted string)\r\nTIMESTAMP  := ISO 8601 format (e.g., 2024-01-15T10:30:00Z)\r\n```\r\n\r\n"]
[2776.192304, "o", "### 3.2 Operator Precedence\r\n\r\n- `AND` binds tighter than `OR`\r\n- Parentheses are NOT supported (keep the grammar simple)\r\n- Evaluation: left to right with AND having higher precedence\r\n\r\nExample: `loss > 1.0 OR grad_norm > 5.0 AND epoch == 3`\r\nParses as: `loss > 1.0 OR (grad_norm > 5.0 AND epoch == 3)`\r\n\r\n### 3.3 Type Rules\r\n\r\n- `step`, `epoch`: integer comparisons\r\n- `loss`, `lr`, `grad_norm`, `acc`: float comparisons (tolerance 1e-9 for `==`)\r\n- `event`: string comparisons (`==`, `!=` only)\r\n- `ts`: timestamp comparisons (parse both sides as time, compare chronologically)\r\n\r\n### 3.4 Output\r\n"]
[2776.192372, "o", "\r\nJSON array of matching timeline entries (after reconstruction), sorted by `(epoch ASC, step ASC)`.\r\n\r\n### 3.5 Error Handling\r\n\r\n- Invalid query syntax: exit code 1, error message to stderr\r\n- Unknown field name: exit code 1, error message to stderr\r\n- Type mismatch (e.g., `event > 5`): exit code 1, error message to stderr\r\n\r\n---\r\n\r\n## 4. Lineage Graph Construction\r\n\r\n### 4.1 Node Identification\r\n\r\n"]
[2776.192488, "o", "Each `.mlck` checkpoint file is identified by the SHA-256 hash of its entire file content (hex-encoded).\r\n\r\n### 4.2 Edge Construction\r\n\r\nFor each checkpoint with a non-empty `ParentHash` in the provenance section:\r\n- If a checkpoint with that SHA-256 file hash exists in the evidence set, create a directed edge from parent to child.\r\n- If no matching parent is found, the checkpoint is classified as an **orphan**.\r\n\r\n### 4.3 Graph Validation\r\n\r\n- The lineage graph must be a DAG. If a cycle is detected, report each cycle's member nodes.\r\n- Roots: nodes with no incoming edges and empty `ParentHash`.\r\n- Leaves: nodes with no outgoing edges.\r\n\r\n### 4.4 Topological Sort\r\n\r\nThe lineage output includes a topological ordering of all non-orphan nodes, from root to leaf. If multiple valid orderings exist, sort by `CreationTimestamp` ascending as tiebreaker.\r\n"]
[2776.19291, "o", "===== docs/formats.md\r\n"]
[2776.195655, "o", "# File Format Specifications\r\n\r\n## 1. MLCK Checkpoint Format (`.mlck`)\r\n\r\nAll multi-byte integer and floating-point values are **little-endian**.\r\n\r\n### File Layout\r\n"]
[2776.195739, "o", "\r\n```\r\n[Header (56 bytes)]\r\n[Tensor Block 0]\r\n[Tensor Block 1]\r\n...\r\n[Tensor Block N-1]\r\n[Metadata Section]\r\n[Provenance Section]\r\n[Signature Block]      (only if Header.Flags bit 0 is set)\r\n```\r\n\r\n### 1.1 Header (56 bytes)\r\n\r\n"]
[2776.195815, "o", "| Offset | Size | Type | Field | Description |\r\n|--------|------|------|-------|-------------|\r\n| 0 | 4 | bytes | Magic | Must be `MLCK` (0x4D 0x4C 0x43 0x4B) |\r\n| 4 | 2 | uint16 | Version | Must be `1` |\r\n| 6 | 2 | uint16 | Flags | Bit 0: signed (has signature block). Bits 1-15: reserved (must be 0) |\r\n| 8 | 4 | uint32 | NumTensors | Number of tensor blocks |\r\n| 12 | 4 | uint32 | NumMetadata | Number of metadata key-value pairs |\r\n| 16 | 8 | uint64 | MetadataOffset | Byte offset of metadata section from file start |\r\n| 24 | 8 | uint64 | ProvenanceOffset | Byte offset of provenance section from file start |\r\n"]
[2776.19589, "o", "| 32 | 8 | uint64 | SignatureOffset | Byte offset of signature block (0 if unsigned) |\r\n| 40 | 8 | int64 | CreationTimestamp | Unix timestamp (seconds) when checkpoint was created |\r\n| 48 | 8 | uint64 | HeaderChecksum | FNV-1a 64-bit hash of bytes [0..48) |\r\n\r\n### 1.2 Tensor Blocks\r\n\r\nTensor blocks start immediately after the header (offset 56). Each tensor block has variable length:\r\n\r\n| Size | Type | Field | Description |\r\n|------|------|-------|-------------|\r\n| 2 | uint16 | NameLen | Length of tensor name in bytes |\r\n| NameLen | bytes | Name | UTF-8 tensor name (e.g., `encoder.layer0.weight`) |\r\n| 1 | uint8 | Dtype | Data type enum (see below) |\r\n| 1 | uint8 | NumDims | Number of dimensions (1-8) |\r\n| 4 * NumDims | uint32[] | Shape | Dimension sizes |\r\n| 8 | uint64 | DataSize | Size of raw tensor data in bytes |\r\n| DataSize | bytes | Data | Raw tensor data |\r\n| 32 | bytes | Checksum | SHA-256 hash of the Data bytes |\r\n\r\n**Dtype values:**\r\n\r\n| Value | Type | Byte size per element |\r\n|-------|------|-------"]
[2776.195983, "o", "---------------|\r\n| 0 | float32 | 4 |\r\n| 1 | float64 | 8 |\r\n| 2 | float16 | 2 |\r\n| 3 | int32 | 4 |\r\n| 4 | int64 | 8 |\r\n| 5 | bfloat16 | 2 |\r\n\r\n**Validation**: `DataSize` must equal `product(Shape) * element_byte_size`. If it does not match, the tensor block is malformed.\r\n\r\n### 1.3 Metadata Section\r\n\r\nLocated at `MetadataOffset`. Contains `NumMetadata` key-value pairs:\r\n\r\n| Size | Type | Field | Description |\r\n|------|------|-------|-------------|\r\n"]
[2776.196057, "o", "| 2 | uint16 | KeyLen | Length of key |\r\n| KeyLen | bytes | Key | UTF-8 key string |\r\n| 4 | uint32 | ValueLen | Length of value |\r\n| ValueLen | bytes | Value | UTF-8 value (JSON-encoded) |\r\n\r\nCommon metadata keys:\r\n- `model_name`: string, the model architecture name\r\n- `dataset`: string, training dataset identifier\r\n- `training_config`: JSON object with hyperparameters\r\n"]
[2776.196142, "o", "- `notes`: string, free-form notes\r\n\r\n### 1.4 Provenance Section\r\n\r\nLocated at `ProvenanceOffset`. Fixed structure followed by variable-length fields:\r\n\r\n| Size | Type | Field | Description |\r\n|------|------|-------|-------------|\r\n| 40 | bytes | GitCommit | ASCII hex string of git commit hash (zero-padded if absent) |\r\n| 32 | bytes | DatasetHash | Raw SHA-256 of the training dataset manifest |\r\n| 32 | bytes | ConfigHash | Raw SHA-256 of the training configuration |\r\n| 8 | int64 | TrainingTimestamp | Unix timestamp when training started |\r\n| 8 | float64 | TrainingDuration | Training duration in seconds |\r\n| 2 | uint16 | FrameworkLen | Length of framework name |\r\n"]
[2776.196222, "o", "| FrameworkLen | bytes | Framework | UTF-8 framework name (e.g., `PyTorch`, `JAX`) |\r\n| 2 | uint16 | FrameworkVersionLen | Length of framework version string |\r\n| FrameworkVersionLen | bytes | FrameworkVersion | UTF-8 version (e.g., `2.1.0`) |\r\n| 4 | uint32 | Epoch | Training epoch at checkpoint time |\r\n| 8 | uint64 | GlobalStep | Global training step |\r\n| 8 | float64 | LearningRate | Learning rate at checkpoint time |\r\n| 2 | uint16 | ParentHashLen | Length of parent hash string (0 = no parent) |\r\n| ParentHashLen | bytes | ParentHash | ASCII hex SHA-256 of the parent checkpoint file (for lineage) |\r\n\r\n### 1.5 Signature Block\r\n\r\n"]
[2776.196295, "o", "Located at `SignatureOffset` (only present if `Flags` bit 0 is set):\r\n\r\n| Size | Type | Field | Description |\r\n|------|------|-------|-------------|\r\n| 1 | uint8 | Algorithm | 0 = HMAC-SHA256 |\r\n| 2 | uint16 | SignerIdLen | Length of signer identifier |\r\n| SignerIdLen | bytes | SignerId | UTF-8 signer identifier (used as HMAC key) |\r\n| 2 | uint16 | SignatureLen | Length of signature |\r\n| SignatureLen | bytes | Signature | The signature bytes |\r\n\r\n**HMAC-SHA256 computation**: The HMAC is computed over all bytes from offset 0 to `SignatureOffset` (exclusive), using `SignerId` as the HMAC key.\r\n\r\n---\r\n\r\n## 2. Training Log Shard Format (`.jsonl`)\r\n\r\nEach `.jsonl` file contains one JSON object per line. Each object represents a training step event:\r\n\r\n```json\r\n"]
[2776.196368, "o", "{\r\n  \"ts\": \"2024-01-15T10:30:00Z\",\r\n  \"epoch\": 1,\r\n  \"step\": 1000,\r\n  \"loss\": 0.5234,\r\n  \"lr\": 0.001,\r\n  \"grad_norm\": 1.23,\r\n  \"acc\": 0.8200,\r\n  \"event\": \"step\"\r\n}\r\n```\r\n\r\n### Required Fields\r\n\r\n| Field | Type | Description |\r\n|-------|------|-------------|\r\n"]
[2776.196441, "o", "| `ts` | string | ISO 8601 timestamp (UTC, `Z` suffix required) |\r\n| `epoch` | integer | Current training epoch (0-indexed) |\r\n| `step` | integer | Global training step (monotonically increasing within an epoch) |\r\n\r\n### Optional Metric Fields\r\n\r\n| Field | Type | Description |\r\n|-------|------|-------------|\r\n| `loss` | float | Training loss |\r\n| `lr` | float | Learning rate |\r\n| `grad_norm` | float | Gradient L2 norm |\r\n| `acc` | float | Accuracy metric (0.0 to 1.0) |\r\n| `event` | string | Event type: `step`, `epoch_end`, `checkpoint`, `eval` |\r\n\r\n### Shard Semantics\r\n\r\n- Multiple shard files may exist in the same evidence directory\r\n- Shards may have overlapping `(epoch, step)` ranges"]
[2776.19652, "o", "\r\n- Shards are named arbitrarily (any `.jsonl` filename is valid)\r\n- Lines within a single shard are not guaranteed to be in chronological order\r\n- Malformed lines (invalid JSON) should be silently skipped with a count in verbose output\r\n\r\n---\r\n\r\n## 3. Configuration File Format (`config_*.json`)\r\n\r\nTraining configuration files follow the naming pattern `config_*.json`:\r\n\r\n```json\r\n{\r\n  \"model_name\": \"resnet50\",\r\n  \"dataset\": \"imagenet-1k\",\r\n"]
[2776.196589, "o", "  \"batch_size\": 256,\r\n  \"learning_rate\": 0.1,\r\n  \"lr_schedule\": \"cosine\",\r\n  \"weight_decay\": 0.0001,\r\n  \"epochs\": 90,\r\n  \"optimizer\": \"sgd\",\r\n  \"momentum\": 0.9,\r\n  \"seed\": 42\r\n}\r\n```\r\n\r\nThese files are used by the anomaly detector to cross-reference declared hyperparameters with observed training behavior.\r\n"]
[2776.197023, "o", "===== docs/output_schema.md\r\n"]
[2776.199728, "o", "# Output Schemas\r\n\r\nAll commands output JSON to stdout. This document defines the exact JSON structure for each command.\r\n\r\n---\r\n"]
[2776.199818, "o", "\r\n## 1. Ingest Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"evidence_dir\": \"/path/to/evidence\",\r\n  \"artifacts\": {\r\n    \"checkpoints\": [\r\n      {\r\n        \"file\": \"model_epoch1.mlck\",\r\n        \"file_hash\": \"a1b2c3...\",\r\n        \"version\": 1,\r\n        \"num_tensors\": 12,\r\n        \"num_metadata\": 3,\r\n"]
[2776.199892, "o", "        \"signed\": false,\r\n        \"creation_timestamp\": \"2024-01-15T10:00:00Z\",\r\n        \"provenance\": {\r\n          \"epoch\": 1,\r\n          \"global_step\": 5000,\r\n          \"framework\": \"PyTorch\",\r\n          \"framework_version\": \"2.1.0\",\r\n          \"parent_hash\": \"\"\r\n        }\r\n      }\r\n    ],\r\n    \"log_shards\": [\r\n      {\r\n        \"file\": \"shard_001.jsonl\",\r\n        \"entries\": 500,\r\n        \"step_range\": [0, 5000],\r\n"]
[2776.199979, "o", "        \"epoch_range\": [0, 1],\r\n        \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-15T10:00:00Z\"]\r\n      }\r\n    ],\r\n    \"configs\": [\r\n      {\r\n        \"file\": \"config_train.json\",\r\n        \"model_name\": \"resnet50\",\r\n        \"dataset\": \"imagenet-1k\"\r\n"]
[2776.20007, "o", "      }\r\n    ]\r\n  },\r\n  \"totals\": {\r\n    \"checkpoints\": 3,\r\n    \"log_shards\": 4,\r\n    \"configs\": 1\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `file_hash`: SHA-256 hex of the entire `.mlck` file content.\r\n- `checkpoints` array: sorted by `creation_timestamp` ascending.\r\n- `log_shards` array: sorted by `file` name lexicographically.\r\n- `configs` array: sorted by `file` name lexicographically.\r\n"]
[2776.200151, "o", "- `step_range`: `[min_step, max_step]` across all entries in the shard.\r\n- `epoch_range`: `[min_epoch, max_epoch]` across all entries.\r\n- `time_range`: `[earliest_ts, latest_ts]` as ISO 8601 strings.\r\n\r\n---\r\n\r\n## 2. Timeline Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"total_entries\": 1200,\r\n  \"total_epochs\": 5,\r\n  \"step_range\": [0, 50000],\r\n  \"time_range\": [\"2024-01-15T08:00:00Z\", \"2024-01-17T14:00:00Z\"],\r\n  \"conflicts_resolved\": 3,\r\n  \"gaps\": [\r\n    {\r\n      \"after_step\": 5000,\r\n      \"before_step\": 5200,\r\n      \"epoch\": 1,\r\n      \"gap_steps\": 200,\r\n      \"after_ts\": \"2024-01-15T10:00:00Z\",\r\n      \"before_ts\": \"2024-01-15T13:00:00Z\"\r\n    }\r\n"]
[2776.200226, "o", "  ],\r\n  \"entries\": [\r\n    {\r\n      \"ts\": \"2024-01-15T08:00:00Z\",\r\n      \"epoch\": 0,\r\n      \"step\": 0,\r\n      \"loss\": 6.9078,\r\n      \"lr\": 0.001,\r\n      \"grad_norm\": 12.34,\r\n      \"acc\": 0.001,\r\n      \"event\": \"step\",\r\n      \"sources\": [\"shard_001.jsonl\"],\r\n      \"conflict\": false\r\n    }\r\n  ]\r\n}\r\n```\r\n\r\n"]
[2776.200296, "o", "**Field rules:**\r\n- `entries`: sorted by `(epoch ASC, step ASC)`.\r\n- `sources`: list of shard filenames (basenames) that contained this `(epoch, step)`.\r\n- `conflict`: `true` if this entry was chosen by conflict resolution.\r\n- `gaps`: only gaps where `gap_steps > 100` within the same epoch.\r\n- Entries with missing optional fields omit them from the JSON (do not include null).\r\n\r\n---\r\n\r\n## 3. Verify Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"checkpoints\": [\r\n    {\r\n"]
[2776.200365, "o", "      \"file\": \"model_epoch1.mlck\",\r\n      \"valid\": true,\r\n      \"header_checksum_valid\": true,\r\n      \"tensor_checksums_valid\": true,\r\n      \"signature_valid\": null,\r\n      \"provenance_valid\": true,\r\n      \"issues\": []\r\n    },\r\n    {\r\n      \"file\": \"model_epoch3.mlck\",\r\n      \"valid\": false,\r\n      \"header_checksum_valid\": true,\r\n      \"tensor_checksums_valid\": false,\r\n      \"signature_valid\": true,\r\n      \"provenance_valid\": true,\r\n"]
[2776.20044, "o", "      \"issues\": [\r\n        {\"type\": \"tensor_checksum_mismatch\", \"detail\": \"encoder.layer2.weight\"}\r\n      ]\r\n    }\r\n  ],\r\n  \"summary\": {\r\n    \"total\": 3,\r\n    \"valid\": 2,\r\n    \"invalid\": 1\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `checkpoints`: sorted by `file` name lexicographically.\r\n"]
[2776.200515, "o", "- `signature_valid`: `null` if the checkpoint is unsigned, `true`/`false` if signed.\r\n- `issues`: list of issue objects with `type` (string) and `detail` (string). For example, a tensor checksum mismatch appears as `{\"type\": \"tensor_checksum_mismatch\", \"detail\": \"<tensor_name>\"}`.\r\n- `valid`: `true` only if all applicable checks pass.\r\n\r\n---\r\n\r\n## 4. Detect Output\r\n\r\n```json\r\n{\r\n  \"status\": \"ok\",\r\n  \"anomalies\": [\r\n    {\r\n      \"id\": \"ANOM-001\",\r\n      \"type\": \"gradient_spike\",\r\n      \"severity\": \"high\",\r\n      \"epoch\": 2,\r\n"]
[2776.200586, "o", "      \"step\": 3456,\r\n      \"details\": {\r\n        \"observed\": 15.3,\r\n        \"window_mean\": 1.2,\r\n        \"window_stddev\": 0.3,\r\n        \"z_score\": 47.0\r\n      },\r\n      \"source\": \"shard_002.jsonl\"\r\n    },\r\n    {\r\n      \"id\": \"ANOM-002\",\r\n      \"type\": \"tensor_checksum_mismatch\",\r\n      \"severity\": \"critical\",\r\n      \"details\": {\r\n"]
[2776.200656, "o", "        \"file\": \"model_epoch3.mlck\",\r\n        \"tensor_name\": \"encoder.layer2.weight\",\r\n        \"expected_checksum\": \"abcd1234...\",\r\n        \"actual_checksum\": \"efgh5678...\"\r\n      },\r\n      \"source\": \"model_epoch3.mlck\",\r\n        \"checkpoint\": \"model_epoch3.mlck\"\r\n    }\r\n  ],\r\n  \"summary\": {\r\n    \"total\": 5,\r\n    \"by_severity\": {\r\n      \"critical\": 1,\r\n"]
[2776.200735, "o", "      \"high\": 2,\r\n      \"medium\": 1,\r\n      \"low\": 1\r\n    },\r\n    \"by_type\": {\r\n      \"gradient_spike\": 1,\r\n      \"loss_divergence\": 1,\r\n      \"tensor_checksum_mismatch\": 1,\r\n      \"training_gap\": 1,\r\n      \"lr_anomaly\": 1\r\n    }\r\n  }\r\n}\r\n```\r\n\r\n**Field rules:**\r\n- `id`: Sequential ID in format `ANOM-NNN`, assigned in detection order.\r\n- `anomalies`: sorted by severity (critical > high > medium > low), then by step/epoch.\r\n"]
[2776.200806, "o", "- `type` values: `gradient_spike`, `loss_divergence`, `lr_anomaly`, `metric_regression`, `tensor_checksum_mismatch`, `header_checksum_mismatch`, `signature_invalid`, `provenance_chain_break`, `training_gap`, `dataset_hash_inconsistency`.\r\n- `details`: type-specific fields as defined in `/app/docs/analysis_rules.md`.\r\n- `source`: the artifact file where the anomaly was detected.\r\n- `epoch` and `step`: present only for timeline-based anomalies.\r\n- `checkpoint`: present when the anomaly is related to a specific checkpoint file; omitted for timeline-based anomalies that are not checkpoint-specific.\r\n- If no anomalies are detected, `anomalies` is an empty array.\r\n\r\n---\r\n"]
[2776.201226, "o", "===== docs/spec.md\r\n"]
[2776.203796, "o", "# mlforge - ML Model Artifact Forensics Engine\r\n\r\n## Overview\r\n\r\n"]
[2776.203881, "o", "`mlforge` is a command-line tool for forensic analysis of machine learning model artifacts. Given a directory of evidence (model checkpoints, training log shards, configuration files), mlforge reconstructs training timelines, detects anomalies, verifies artifact integrity, builds model lineage graphs, and produces evidence-backed forensic reports.\r\n\r\n## CLI Interface\r\n\r\nThe binary is built as `mlforge` and placed at `/app/mlforge` (or on `$PATH` after `go install`).\r\n\r\n```\r\nmlforge <command> <evidence-dir> [flags]\r\n```\r\n\r\n### Commands\r\n\r\n| Command | Description |\r\n|---------|-------------|\r\n| `ingest` | Scan evidence directory, index all artifacts, print summary to stdout |\r\n| `timeline` | Reconstruct unified training timeline from log shards |\r\n| `verify` | Verify integrity of all checkpoint files |\r\n"]
[2776.203962, "o", "| `detect` | Run anomaly detection across all evidence |\r\n| `lineage` | Build and output model lineage DAG |\r\n| `query` | Query the unified timeline with filter expressions |\r\n| `report` | Generate full forensic report combining all analyses |\r\n\r\n### Global Flags\r\n\r\n| Flag | Type | Default | Description |\r\n"]
[2776.20404, "o", "|------|------|---------|-------------|\r\n| `--format` | string | `json` | Output format: `json` or `text` |\r\n| `--verbose` | bool | false | Enable verbose diagnostic output to stderr |\r\n\r\n### Command-Specific Behavior\r\n\r\n#### `ingest`\r\n\r\nScan `<evidence-dir>` recursively for:\r\n- `.mlck` files (model checkpoints)\r\n- `.jsonl` files (training log shards)\r\n- `.json` files matching `config_*.json` (training configurations)\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Ingest Output\".\r\n\r\nIf the evidence directory does not exist or contains no recognizable artifacts, exit with code 1 and print an error to stderr.\r\n\r\n#### `timeline`\r\n\r\n"]
[2776.204113, "o", "Parse all `.jsonl` log shards in `<evidence-dir>`, merge entries into a unified timeline.\r\n\r\n**Merge Rules** (detailed in `/app/docs/analysis_rules.md` section \"Timeline Reconstruction\"):\r\n- Entries are identified by `(epoch, step)` tuple\r\n- When multiple shards contain the same `(epoch, step)`, apply conflict resolution\r\n- Gaps in the step sequence are detected and reported\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Timeline Output\".\r\n\r\n#### `verify`\r\n\r\nFor each `.mlck` file in `<evidence-dir>`:\r\n1. Parse the file according to the MLCK format (see `/app/docs/formats.md`)\r\n2. Validate the header checksum\r\n3. Validate each tensor's SHA-256 data checksum\r\n"]
[2776.204189, "o", "4. If the file is signed (Flags bit 0), validate the HMAC-SHA256 signature\r\n5. Validate provenance fields are well-formed\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Verify Output\".\r\n\r\n#### `detect`\r\n\r\nRun all anomaly detection rules (defined in `/app/docs/analysis_rules.md`) across the evidence:\r\n- Timeline-based anomalies (from log shards)\r\n- Checkpoint integrity anomalies (from .mlck files)\r\n- Cross-artifact anomalies (correlating checkpoints with logs)\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Detect Output\".\r\n\r\n#### `lineage`\r\n\r\nBuild a directed acyclic graph of model checkpoint relationships using the `parent_hash` field from each checkpoint's provenance section.\r\n"]
[2776.20426, "o", "\r\n**Rules**:\r\n- Each checkpoint is a node identified by its SHA-256 file hash\r\n- An edge `A -> B` exists if B's `parent_hash` matches A's file hash\r\n- Root nodes have empty `parent_hash`\r\n- Orphan nodes reference a parent not present in the evidence set\r\n- If a cycle is detected, report it as an anomaly (the graph should be a DAG)\r\n\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Lineage Output\".\r\n\r\n#### `query`\r\n\r\n```\r\nmlforge query <evidence-dir> \"<expression>\"\r\n```\r\n"]
[2776.204337, "o", "\r\nFilter the unified timeline using the query expression language defined in `/app/docs/analysis_rules.md` section \"Query Language\".\r\n\r\nOutput (JSON to stdout): list of matching timeline entries.\r\n\r\n#### `report`\r\n\r\nGenerate a comprehensive forensic report by running all analyses (ingest, timeline, verify, detect, lineage) and combining results.\r\n"]
[2776.204412, "o", "\r\nOutput (JSON to stdout): see `/app/docs/output_schema.md` section \"Report Output\".\r\n\r\n## Exit Codes\r\n\r\n| Code | Meaning |\r\n|------|---------|\r\n| 0 | Success |\r\n| 1 | Input error (missing directory, no artifacts, invalid arguments) |\r\n| 2 | Parse error (corrupt or unreadable artifact) |\r\n\r\nWhen a parse error occurs for individual artifacts within a batch operation (e.g., one corrupt checkpoint among several), the tool should continue processing remaining artifacts, report the error in the output, and exit with code 0. Exit code 2 is only for cases where the error prevents any meaningful output.\r\n\r\n## Build\r\n\r\n```bash\r\ncd /app && go build -o mlforge ./cmd/mlforge\r\n```\r\n\r\n## Cross-References\r\n\r\n"]
[2776.20448, "o", "- Binary formats: `/app/docs/formats.md`\r\n- Detection algorithms and query language: `/app/docs/analysis_rules.md`\r\n- JSON output schemas: `/app/docs/output_schema.md`\r\n"]
[2776.204912, "o", "\u001b[?2004h"]
[2776.205, "o", "root@n30009:/app# "]
[2786.607745, "i", "grep -n \"func main\\|case \\|func run\\|os.Args\\|subcommand\" cmd/mlforge/main.go\n"]
[2786.60839, "o", "grep -n \"func main\\|case \\|func run\\|os.Args\\|subcommand\" cmd/mlforge/main.go\r\n\u001b[?2004l\r"]
[2786.61175, "o", "\u001b[32m\u001b[K12\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc main\u001b[m\u001b[K() {\r\n"]
[2786.611875, "o", "\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, arg := range \u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K[1:] {\r\n"]
[2786.611964, "o", "\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Karg == \"--verbose\":\r\n\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Kstrings.HasPrefix(arg, \"--format=\"):\r\n\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Karg == \"--format\":\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor i := 1; i < len(\u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K)-1; i++ {\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif \u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K[i] == \"--format\" {\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tformat = \u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K[i+1]\r\n\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif p != \u001b[01;31m\u001b[Kos.Args\u001b[m\u001b[K[i+1] {\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"ingest\":\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"timeline\":\r\n"]
[2786.612048, "o", "\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"verify\":\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"detect\":\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"lineage\":\r\n"]
[2786.612118, "o", "\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"query\":\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"report\":\r\n"]
[2786.612555, "o", "\u001b[?2004h"]
[2786.612614, "o", "root@n30009:/app# "]
[2786.904167, "i", "sed -n '1,130p' cmd/mlforge/main.go\n"]
[2786.904495, "o", "sed -n '1,130p' cmd/mlforge/main.go\r\n\u001b[?2004l\r"]
[2786.907493, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[2786.907621, "o", "\t\"strings\"\r\n\r\n\t\"mlforge/internal/forensics\"\r\n)\r\n\r\nfunc main() {\r\n\t// --- Parse flags ---------------------------------------------------\r\n\tformat := \"json\"\r\n\tverbose := false\r\n\tvar positional []string\r\n\r\n\tfor _, arg := range os.Args[1:] {\r\n\t\tswitch {\r\n\t\tcase arg == \"--verbose\":\r\n\t\t\tverbose = true\r\n\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n"]
[2786.907665, "o", "\t\tcase arg == \"--format\":\r\n\t\t// handled below as two-token flag\r\n\t\tdefault:\r\n\t\t\tpositional = append(positional, arg)\r\n"]
[2786.907767, "o", "\t\t}\r\n\t}\r\n\r\n\t// Handle \"--format json\" (two separate tokens)\r\n\tfor i := 1; i < len(os.Args)-1; i++ {\r\n\t\tif os.Args[i] == \"--format\" {\r\n\t\t\tformat = os.Args[i+1]\r\n\t\t\t// Remove the value from positional args\r\n\t\t\tfiltered := positional[:0]\r\n\t\t\tfor _, p := range positional {\r\n\t\t\t\tif p != os.Args[i+1] {\r\n\t\t\t\t\tfiltered = append(filtered, p)\r\n"]
[2786.907842, "o", "\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tpositional = filtered\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n\tif format != \"json\" && format != \"text\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json or text\\n\", format)\r\n"]
[2786.907902, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\t_ = verbose // reserved for diagnostic output\r\n\r\n\t// --- Validate positional args --------------------------------------\r\n\tif len(positional) < 2 {\r\n\t\t"]
[2786.908009, "o", "fmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := positional[0]\r\n\tdir := positional[1]\r\n\r\n\t// --- Route to command handler --------------------------------------\r\n\tvar result interface{}\r\n\tvar err error\r\n\r\n"]
[2786.908071, "o", "\tswitch cmd {\r\n\tcase \"ingest\":\r\n\t\tresult, err = forensics.BuildIngest(dir)\r\n\tcase \"timeline\":\r\n\t\tresult, err = forensics.BuildTimeline(dir)\r\n\tcase \"verify\":\r\n\t"]
[2786.908134, "o", "\tresult, err = forensics.BuildVerify(dir)\r\n\tcase \"detect\":\r\n\t\tresult, err = forensics.BuildDetect(dir)\r\n\tcase \"lineage\":\r\n\t\tresult, err = forensics.BuildLineage(dir)\r\n\tcase \"query\":\r\n\t\tif len(positional) < 3 {\r\n"]
[2786.908197, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tresult, err = forensics.BuildQuery(dir, positional[2])\r\n\tcase \"report\":\r\n\t\tresult, err = forensics.BuildReport(dir)\r\n\tdefault:\r\n\t\t"]
[2786.908275, "o", "fmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t// --- Output --------------------------------------------------------\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[2786.908339, "o", "\r\n\tif format == \"text\" {\r\n\t\tprintText(result)\r\n\t\treturn\r\n\t}\r\n\r\n\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n\tif marshalErr != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error marshalling result: %v\\n\", marshalErr)\r\n"]
[2786.908395, "o", "\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Println(string(out))\r\n}\r\n\r\nfunc printText(v interface{}) {\r\n\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n"]
[2786.908472, "o", "\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error rendering text output\")\r\n\t\treturn\r\n\t}\r\n\tfmt.Println(string(b))\r\n}\r\n"]
