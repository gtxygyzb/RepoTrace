[4992.854048, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\np = Path('internal/forensics/detect.go')\ns = p.read_text()\n\n# Replace BuildDetect/buildDetectWithDir with filter-aware implementation.\nold = re.compile(r'func BuildDetect\\(dir string\\) \\(interface\\{\\}, error\\) \\{.*?\\n\\}\\n\\nfunc detectTimelineAnomalies', re.S)\nnew = '''func BuildDetect(dir string) (interface{}, error) {\n\\treturn BuildDetectFiltered(dir, \"\")\n}\n\nfunc BuildDetectFiltered(dir, filterSeverity string) (DetectOutput, error) {\n\\tvar out DetectOutput\n\\tout.Status = \"ok\"\n\\tvar anomalies []types.Anomaly\n\n\\tentries, _, err := loadTimelineEntries(dir)\n\\tif err == nil {\n\\t\\tmerged, _ := mergeTimeline(entries)\n\\t\\tsortTimeline(merged)\n\\t\\tanomalies = append(anomalies, detectTimelineAnomalies(merged)...)\n\\t}\n\n\\tcps, err := loadCheckpoints(dir)\n\\tif err == nil {\n\\t\\tanomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\n\\t}\n\n\\tif filterSeverity != \"\" {\n\\t\\twantedRank, ok := severityRankValue(filterSeverity)\n\\t\\tif !ok {\n\\t\\t\\treturn out, fmt.E"]
