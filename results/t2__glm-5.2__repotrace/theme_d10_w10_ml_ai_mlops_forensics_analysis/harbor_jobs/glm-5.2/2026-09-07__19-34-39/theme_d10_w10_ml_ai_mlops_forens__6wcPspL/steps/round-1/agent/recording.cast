[7407.074654, "o", "\t\tconst (\r\n   154\t\t\twhite = 0\r\n   155\t\t\tgray  = 1\r\n   156\t\t\tblack = 2\r\n   157\t\t)\r\n   158\t\tcolor := map[string]int{}\r\n   159\t\tstack := []string{}\r\n"]
[7407.074718, "o", "   160\t\tvar cycles [][]string\r\n   161\t\tseen := map[string]bool{}\r\n   162\t\r\n   163\t\tvar dfs func(u string)\r\n   164\t\tdfs = func(u string) {\r\n   165\t\t\tcolor[u] = gray\r\n   166\t\t\tstack = append(stack, u)\r\n   167\t\t\tfor _, v := range children[u] {\r\n   168\t\t\t\tif color[v] == gray {\r\n   169\t\t\t\t\tfor i := len(stack) - 1; i >= 0; i-- {\r\n"]
[7407.074775, "o", "   170\t\t\t\t\t\tif stack[i] == v {\r\n   171\t\t\t\t\t\t\tcycle := append([]string{}, stack[i:]...)\r\n   172\t\t\t\t\t\t\tsort.Strings(cycle)\r\n   173\t\t\t\t\t\t\tkey := strings.Join(cycle, \",\")\r\n   174\t\t\t\t\t\t\tif !seen[key] {\r\n   175\t\t\t"]
[7407.074829, "o", "\t\t\t\t\tseen[key] = true\r\n   176\t\t\t\t\t\t\t\tcycles = append(cycles, cycle)\r\n   177\t\t\t\t\t\t\t}\r\n   178\t\t\t\t\t\t\tbreak\r\n   179\t\t\t\t\t\t}\r\n   180\t\t\t\t\t}\r\n"]
