[2798.781282, "o", "\u001b[32m\u001b[K12\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc main\u001b[m\u001b[K() {\r\n"]
[2798.781385, "o", "\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Karg == \"--verbose\":\r\n\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Kstrings.HasPrefix(arg, \"--format=\"):\r\n\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Karg == \"--format\":\r\n"]
[2798.781451, "o", "\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"ingest\":\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"\u001b[01;31m\u001b[Ktimeline\u001b[m\u001b[K\":\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"verify\":\r\n"]
[2798.781507, "o", "\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"detect\":\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"lineage\":\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"\u001b[01;31m\u001b[Kquery\u001b[m\u001b[K\":\r\n"]
[2798.781559, "o", "\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K <dir> \\\"<expression>\\\"\\n\")\r\n"]
[2798.781609, "o", "\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"\u001b[01;31m\u001b[Kreport\u001b[m\u001b[K\":\r\n"]
[2798.782136, "o", "\u001b[?2004h"]
[2798.782207, "o", "root@n30009:/app# "]
[2799.077849, "i", "sed -n '1,120p' cmd/mlforge/main.go\n"]
[2799.078201, "o", "sed -n '1,120p' cmd/mlforge/main.go\r\n\u001b[?2004l\r"]
[2799.081185, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n\r\n\t\"mlforge/internal/forensics\"\r\n)\r\n\r\n"]
[2799.081297, "o", "func main() {\r\n\t// --- Parse flags ---------------------------------------------------\r\n\tformat := \"json\"\r\n\tverbose := false\r\n\tvar positional []string\r\n\r\n\tfor _, arg := range os.Args[1:] {\r\n\t\tswitch {\r\n\t\tcase arg == \"--verbose\":\r\n\t\t\tverbose = true\r\n\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n\t\tcase arg == \"--format\":\r\n\t\t// handled below as two-token flag\r\n\t\tdefault:\r\n\t\t\tpositional = append(positional, arg)\r\n\t\t}\r\n\t}\r\n\r\n\t// Handle \"--format json\" (two separate tokens)\r\n\t"]
[2799.081368, "o", "for i := 1; i < len(os.Args)-1; i++ {\r\n\t\tif os.Args[i] == \"--format\" {\r\n\t\t\tformat = os.Args[i+1]\r\n\t\t\t// Remove the value from positional args\r\n\t\t\tfiltered := positional[:0]\r\n\t\t\tfor _, p := range positional {\r\n\t\t\t\tif p != os.Args[i+1] {\r\n\t\t\t\t\tfiltered = append(filtered, p)\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[2799.081433, "o", "\t\t\tpositional = filtered\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\r\n\tif format != \"json\" && format != \"text\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json or text\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[2799.081496, "o", "\t_ = verbose // reserved for diagnostic output\r\n\r\n\t// --- Validate positional args --------------------------------------\r\n\tif len(positional) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := positional[0]\r\n\tdir := positional[1]\r\n\r\n\t// --- Route to command handler --------------------------------------\r\n\tvar result interface{}\r\n"]
[2799.081557, "o", "\tvar err error\r\n\r\n\tswitch cmd {\r\n\tcase \"ingest\":\r\n\t\tresult, err = forensics.BuildIngest(dir)\r\n\tcase \"timeline\":\r\n\t\tresult, err = forensics.BuildTimeline(dir)\r\n\tcase \"verify\":\r\n\t\tresult, err = forensics.BuildVerify(dir)\r\n"]
[2799.08162, "o", "\tcase \"detect\":\r\n\t\tresult, err = forensics.BuildDetect(dir)\r\n\tcase \"lineage\":\r\n\t\tresult, err = forensics.BuildLineage(dir)\r\n\tcase \"query\":\r\n\t\tif len(positional) < 3 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tresult, err = forensics.BuildQuery(dir, positional[2])\r\n"]
[2799.081683, "o", "\tcase \"report\":\r\n\t\tresult, err = forensics.BuildReport(dir)\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t// --- Output --------------------------------------------------------\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[2799.081754, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif format == \"text\" {\r\n\t\tprintText(result)\r\n\t\treturn\r\n\t}\r\n\r\n\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n\tif marshalErr != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error marshalling result: %v\\n\", marshalErr)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[2799.081823, "o", "\tfmt.Println(string(out))\r\n}\r\n\r\nfunc printText(v interface{}) {\r\n\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"error rendering text output\")\r\n\t\treturn\r\n\t}\r\n\tfmt.Println(string(b))\r\n}\r\n"]
[2799.082391, "o", "\u001b[?2004h"]
[2799.082476, "o", "root@n30009:/app# "]
