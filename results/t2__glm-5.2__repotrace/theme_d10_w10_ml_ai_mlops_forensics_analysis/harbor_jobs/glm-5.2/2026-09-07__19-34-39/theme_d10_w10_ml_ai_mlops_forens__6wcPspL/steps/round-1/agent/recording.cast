[5019.76478, "o", "\u001b[?2004l\r"]
[5019.768165, "o", "// Anomaly represents one detected anomaly in the detect command.\r\ntype Anomaly struct {\r\n\tID         string                 `json:\"id\"`\r\n\tType       string                 `json:\"type\"`\r\n"]
[5019.768257, "o", "\tSeverity   string                 `json:\"severity\"`\r\n\tEpoch      *int                   `json:\"epoch,omitempty\"`\r\n\tStep       *int                   `json:\"step,omitempty\"`\r\n\tDetails    map[string]interface{} `json:\"details,omitempty\"`\r\n\tEvidence   map[string]interface{} `json:\"evidence\"`\r\n\tSource     string                 `json:\"source,omitempty\"`\r\n\tCheckpoint string                 `json:\"checkpoint,omitempty\"`\r\n}\r\n\r\n// TensorInfo holds metadata for one tensor in a checkpoint.\r\n"]
[5019.768803, "o", "\u001b[?2004h"]
[5019.768837, "o", "root@n30009:/app# "]
[5020.059538, "i", "sed -n '46,120p' internal/forensics/detect.go\n"]
[5020.059894, "o", "sed -n '46,120p' internal/forensics/detect.go\r\n"]
[5020.060009, "o", "\u001b[?2004l\r"]
[5020.063012, "o", "}\r\n\r\nfunc BuildDetect(dir string) (interface{}, error) {\r\n\treturn BuildDetectFiltered(dir, \"\")\r\n}\r\n\r\n"]
[5020.063111, "o", "func BuildDetectFiltered(dir, filterSeverity string) (DetectOutput, error) {\r\n\tvar out DetectOutput\r\n\tout.Status = \"ok\"\r\n\tvar anomalies []types.Anomaly\r\n\r\n\tentries, _, err := loadTimelineEntries(dir)\r\n\tif err == nil {\r\n\t\tmerged, _ := mergeTimeline(entries)\r\n\t\tsortTimeline(merged)\r\n\t\tanomalies = append(anomalies, detectTimelineAnomalies(merged)...)\r\n\t}\r\n\r\n\tcps, err := loadCheckpoints(dir)\r\n\tif err == nil {\r\n\t\t"]
[5020.063175, "o", "anomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\r\n\t}\r\n\r\n\tif filterSeverity != \"\" {\r\n\t\twantedRank, ok := severityRankValue(filterSeverity)\r\n\t\tif !ok {\r\n\t\t\treturn out, fmt.Errorf(\"invalid severity level %q: must be critical, high, medium, or low\", filterSeverity)\r\n\t\t}\r\n\t\tfiltered := anomalies[:0]\r\n\t\tfor _, a := range anomalies {\r\n\t\t\tif severityRank(a.Severity) <= wantedRank {\r\n"]
[5020.063231, "o", "\t\t\t\tfiltered = append(filtered, a)\r\n\t\t\t}\r\n\t\t}\r\n\t\tanomalies = filtered\r\n\t}\r\n\r\n\tfor i := range anomalies {\r\n\t\tanomalies[i].ID = fmt.Sprintf(\"ANOM-%03d\", i+1)\r\n"]
[5020.063286, "o", "\t}\r\n\tsortAnomalies(anomalies)\r\n\r\n\tout.Anomalies = anomalies\r\n\tif out.Anomalies == nil {\r\n\t\tout.Anomalies = []types.Anomaly{}\r\n\t}\r\n\tout.Summary.Total = len(anomalies)\r\n\tout.Summary.BySeverity = map[string]int{\"critical\": 0, \"high\": 0, \"medium\": 0, \"low\": 0}\r\n"]
[5020.063339, "o", "\tout.Summary.ByType = map[string]int{}\r\n\tfor _, a := range anomalies {\r\n\t\tout.Summary.BySeverity[a.Severity]++\r\n\t\tout.Summary.ByType[a.Type]++\r\n\t}\r\n\treturn out, nil\r\n}\r\n\r\nfunc severityRank(s string) int {\r\n\tswitch s {\r\n\tcase \"critical\":\r\n"]
[5020.06339, "o", "\t\treturn 0\r\n\tcase \"high\":\r\n\t\treturn 1\r\n\tcase \"medium\":\r\n\t\treturn 2\r\n\tdefault:\r\n\t\treturn 3\r\n"]
[5020.063441, "o", "\t}\r\n}\r\n\r\nfunc severityRankValue(s string) (int, bool) {\r\n\tswitch s {\r\n\tcase \"critical\":\r\n\t\treturn 0, true\r\n\tcase \"high\":\r\n\t\treturn 1, true\r\n"]
[5020.064042, "o", "\u001b[?2004h"]
[5020.064113, "o", "root@n30009:/app# "]
[5020.376011, "i", "sed -n '120,200p' internal/forensics/detect.go\n"]
[5020.376385, "o", "sed -n '120,200p' internal/forensics/detect.go\r\n\u001b[?2004l\r"]
[5020.379548, "o", "\t\treturn 1, true\r\n\tcase \"medium\":\r\n\t\treturn 2, true\r\n\tcase \"low\":\r\n\t\treturn 3, true\r\n"]
[5020.379637, "o", "\tdefault:\r\n\t\treturn 4, false\r\n\t}\r\n}\r\n\r\nfunc detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tanomalies = append(anomalies, detectGradientSpikes(entries)...)\r\n\tanomalies = append(anomalies, detectLossDivergence(entries)...)\r\n\tanomalies = append(anomalies, detectLrAnomalies(entries)...)\r\n\tanomalies = append(anomalies, detectTrainingGaps(entries)...)\r\n\tanomalies = append(anomalies, detectMetricRegression(entries)...)\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n"]
[5020.379702, "o", "\tvar vals []float64\r\n\tvar idx []int\r\n\tfor i, e := range entries {\r\n\t\tif e.GradNorm != nil {\r\n\t\t\tvals = append(vals, *e.GradNorm)\r\n\t\t\tidx = append(idx, i)\r\n\t\t}\r\n\t}\r\n\tif len(vals) < 31 {\r\n\t\treturn nil\r\n\t}\r\n"]
[5020.379761, "o", "\tvar anomalies []types.Anomaly\r\n\tfor i := 30; i < len(vals); i++ {\r\n\t\twindow := vals[i-30 : i]\r\n\t\tmean := meanFloats(window)\r\n\t\tstd := stddevFloats(window, mean)\r\n\t\tobserved := vals[i]\r\n\t\tz := 0.0\r\n\t\tif std > 0 {\r\n\t"]
[5020.379815, "o", "\t\tz = (observed - mean) / std\r\n\t\t}\r\n\t\tif observed > mean+2.5*std && z > 2.5 {\r\n\t\t\tseverity := \"medium\"\r\n\t\t\tif z > 4.0 {\r\n\t\t\t\tseverity = \"high\"\r\n\t\t\t}"]
[5020.379868, "o", "\r\n\t\t\tep := entries[idx[i]].Epoch\r\n\t\t\tst := entries[idx[i]].Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"gradient_spike\",\r\n\t\t\t\tSeverity: severity,\r\n\t\t\t\tEpoch:    &ep,\r\n"]
[5020.379918, "o", "\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"observed\":      observed,\r\n\t\t\t\t\t\"window_mean\":   mean,\r\n\t\t\t\t\t\"window_stddev\": std,\r\n\t\t\t\t\t\"z_score\":       z,\r\n"]
[5020.379974, "o", "\t\t\t\t},\r\n\t\t\t\tSource: firstSource(entries[idx[i]]),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\n"]
[5020.380026, "o", "func detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar lossEntries []int\r\n\tfor i, e := range entries {\r\n\t\tif e.Loss != nil {\r\n\t\t\tlossEntries = append(lossEntries, i)\r\n\t\t}\r\n\t}\r\n\tif len(lossEntries) < 51 {\r\n\t\treturn nil\r\n"]
[5020.380077, "o", "\t}\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 50; i < len(lossEntries); i++ {\r\n\t\tstartIdx := lossEntries[i-50]\r\n\t\tendIdx := lossEntries[i]\r\n"]
[5020.380666, "o", "\u001b[?2004h"]
[5020.380735, "o", "root@n30009:/app# "]
[5020.656442, "i", "sed -n '1,130p' cmd/mlforge/main.go\n"]
[5020.656751, "o", "sed -n '1,130p' cmd/mlforge/main.go\r\n\u001b[?2004l\r"]
[5020.659913, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\r\n"]
[5020.660051, "o", "\t\"mlforge/internal/forensics\"\r\n)\r\n\r\nfunc main() {\r\n\t// --- Parse flags ---------------------------------------------------\r\n\tformat := \"json\"\r\n\tverbose := false\r\n\tfilterSeverity := \"\"\r\n\tvar positional []string\r\n\r\n\targs := os.Args[1:]\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tswitch {\r\n\t\tcase arg == \"--verbose\":\r\n\t\t\tverbose = true\r\n\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n"]
[5020.660121, "o", "\t\tcase arg == \"--format\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"flag --format requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ti++\r\n\t\t\tformat = args[i]\r\n\t\tcase strings.HasPrefix(arg, \"--filter-severity=\"):\r\n\t\t\tfilterSeverity = strings.TrimPrefix(arg, \"--filter-severity=\")\r\n\t\tcase arg == \"--filter-severity\":\r\n\t\t\tif i+1 >= len(args) {\r\n\t"]
[5020.660182, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"flag --filter-severity requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ti++\r\n\t\t\tfilterSeverity = args[i]\r\n\t\tdefault:\r\n\t\t\tpositional = append(positional, arg)\r\n"]
[5020.660239, "o", "\t\t}\r\n\t}\r\n\r\n\tswitch format {\r\n\tcase \"json\", \"text\", \"csv\":\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json, text, or csv\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t_ = verbose // reserved for diagnostic output\r\n\r\n"]
[5020.660295, "o", "\t// --- Validate positional args --------------------------------------\r\n\tif len(positional) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := positional[0]\r\n\tdir := positional[1]\r\n\r\n"]
[5020.660353, "o", "\tif format == \"csv\" && cmd != \"detect\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"invalid format csv: csv output is only supported for detect\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif filterSeverity != \"\" && cmd != \"detect\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"--filter-severity is only supported for detect\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t// --- Route to command handler --------------------------------------\r\n\tvar result interface{}\r\n\t"]
[5020.660409, "o", "var err error\r\n\r\n\tswitch cmd {\r\n\tcase \"ingest\":\r\n\t\tresult, err = forensics.BuildIngest(dir)\r\n\tcase \"timeline\":\r\n\t\tresult, err = forensics.BuildTimeline(dir)\r\n\tcase \"verify\":\r\n"]
[5020.660463, "o", "\t\tresult, err = forensics.BuildVerify(dir)\r\n\tcase \"detect\":\r\n\t\tdetectResult, detectErr := forensics.BuildDetectFiltered(dir, filterSeverity)\r\n\t\tif detectErr != nil {\r\n\t\t\terr = detectErr\r\n\t\t} else {\r\n\t\t\tif format == \"csv\" {\r\n"]
[5020.660515, "o", "\t\t\t\tprintDetectCSV(detectResult)\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tresult = detectResult\r\n\t\t}\r\n\tcase \"lineage\":\r\n\t\tresult, err = forensics.BuildLineage(dir)\r\n\tcase \"query\":\r\n"]
[5020.660569, "o", "\t\tif len(positional) < 3 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tresult, err = forensics.BuildQuery(dir, positional[2])\r\n\tcase \"diff\":\r\n\t\tif len(positional) < 4 {\r\n"]
[5020.660622, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge diff <dir> <file1> <file2>\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tresult, err = forensics.BuildDiff(dir, positional[2], positional[3])\r\n\tcase \"report\":\r\n\t\tresult, err = forensics.BuildReport(dir)\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n"]
[5020.660674, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\t// --- Output --------------------------------------------------------\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif format == \"text\" {\r\n\t\tprintText(result)\r\n"]
[5020.660723, "o", "\t\treturn\r\n\t}\r\n\r\n\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n"]
[5020.661256, "o", "\u001b[?2004h"]
[5020.661329, "o", "root@n30009:/app# "]
