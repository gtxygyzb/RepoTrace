[1964.542131, "o", "     1\tpackage types\r\n     2\t\r\n     3\t// TimelineEntry represents one log entry from a JSONL shard.\r\n     4\ttype TimelineEntry struct {\r\n     5\t\tTs       string   `json:\"ts\"`\r\n     6\t\tEpoch    int      `json:\"epoch\"`\r\n"]
[1964.542194, "o", "     7\t\tStep     int      `json:\"step\"`\r\n     8\t\tLoss     *float64 `json:\"loss,omitempty\"`\r\n     9\t\tLr       *float64 `json:\"lr,omitempty\"`\r\n    10\t\tGradNorm *float64 `json:\"grad_norm,omitempty\"`\r\n    11\t\tAcc      *float64 `json:\"acc,omitempty\"`\r\n    12\t\tEvent    string   `json:\"event,omitempty\"`\r\n    13\t\tSources  []string `json:\"sources,omitempty\"`\r\n    14\t\tConflict bool     `json:\"conflict\"`\r\n    15\t}\r\n    16\t\r\n"]
[1964.542333, "o", "    17\t// Anomaly represents one detected anomaly in the detect command.\r\n    18\ttype Anomaly struct {\r\n    19\t\tID       string                 `json:\"id\"`\r\n    20\t\tType     string                 `json:\"type\"`\r\n    21\t\tSeverity string                 `json:\"severity\"`\r\n    22\t\tEpoch    *int                   `json:\"epoch,omitempty\"`\r\n    23\t\tStep     *int                   `json:\"step,omitempty\"`\r\n    24\t\tDetails  map[string]interface{} `json:\"details,omitempty\"`\r\n    25\t\tSource   string                 `json:\"source,omitempty\"`\r\n    26\t}\r\n    27\t\r\n    28\t// TensorInfo holds metadata for one tensor in a checkpoint.\r\n    29\ttype TensorInfo struct {\r\n    30\t\tName  string   `json:\"name\"`\r\n    31\t\tDtype byte     `json:\"dtype\"`\r\n    32\t\tShape []uint32 `json:\"shape\"`\r\n    33\t\tData  []byte   `json:\"-\"`\r\n    34\t\tHash  [32]byte `json:\"-\"` // Stored SHA-256\r\n    35\t\tValid bool     `json:\"valid\"`\r\n    36\t}\r\n"]
[1964.542424, "o", "    37\t\r\n    38\t// Provenance holds the provenance section data from an MLCK checkpoint.\r\n    39\ttype Provenance struct {\r\n    40\t\tGitCommit         string  `json:\"git_commit\"`\r\n    41\t\tDatasetHash       string  `json:\"dataset_hash\"` // hex-encoded raw bytes\r\n    42\t\tConfigHash        string  `json:\"config_hash\"`  // hex-encoded raw bytes\r\n    43\t\tTrainingTimestamp int64   `json:\"training_timestamp\"`\r\n    44\t\tTrainingDuration  float64 `json:\"training_duration\"`\r\n    45\t\tFramework         string  `json:\"framework\"`\r\n    46\t\tFrameworkVersion  string  `json:\"framework_version\"`\r\n    47\t\tEpoch             uint32  `json:\"epoch\"`\r\n"]
[1964.542511, "o", "    48\t\tGlobalStep        uint64  `json:\"global_step\"`\r\n    49\t\tLearningRate      float64 `json:\"learning_rate\"`\r\n    50\t\tParentHash        string  `json:\"parent_hash\"` // hex SHA-256 of parent file, empty if root\r\n    51\t}\r\n    52\t\r\n    53\t// CheckpointFile represents a parsed .mlck checkpoint.\r\n    54\ttype CheckpointFile struct {\r\n    55\t\tPath              string            `json:\"-\"`\r\n    56\t\tFilename          string            `json:\"-\"` // base filename\r\n    57\t\tVersion           uint32            `json:\"version\"`\r\n    58\t\tFlags             uint16            `json:\"-\"`\r\n    59\t\tNumTensors        uint32            `json:\"-\"`\r\n    60\t\tNumMetadataKeys   uint32            `json:\"-\"`\r\n"]
[1964.542587, "o", "    61\t\tCreationTimestamp int64             `json:\"-\"`         // unix seconds\r\n    62\t\tHeaderValid       bool              `json:\"-\"`         // header checksum valid?\r\n    63\t\tFileHash          string            `json:\"file_hash\"` // SHA-256 hex of entire file\r\n    64\t\tSigned            bool              `json:\"-\"`\r\n    65\t\tTensors           []TensorInfo      `json:\"tensors\"`\r\n    66\t\tMetadataMap       map[string]string `json:\"-\"` // key-value pairs from metadata section\r\n    67\t\tProvenance        *Provenance       `json:\"-\"`\r\n    68\t\tHasParent         bool              `json:\"has_parent\"`\r\n    69\t\tParentHex         string            `json:\"parent_hash\"` // same as Provenance.ParentHash\r\n    70\t}\r\n"]
