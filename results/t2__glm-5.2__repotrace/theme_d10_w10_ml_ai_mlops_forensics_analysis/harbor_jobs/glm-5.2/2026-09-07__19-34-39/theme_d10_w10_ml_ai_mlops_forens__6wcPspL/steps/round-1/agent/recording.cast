[5611.106107, "o", "\treturn out, nil\r\n}\r\n\r\nfunc severityRank(s string) int {\r\n\tswitch s {\r\n\tcase \"critical\":\r\n\t\treturn 0\r\n\tcase \"high\":\r\n\t\treturn 1\r\n\tcase \"medium\":\r\n\t\treturn 2\r\n\tcase \"low\":\r\n\t\treturn 3\r\n\tcase \"info\":\r\n\t\treturn 4\r\n\t}\r\n\treturn 4\r\n}\r\n\r\n"]
[5611.106188, "o", "func severityRankValue(s string) (int, bool) {\r\n\tswitch s {\r\n\tcase \"critical\":\r\n\t\treturn 0, true\r\n\tcase \"high\":\r\n\t\treturn 1, true\r\n\tcase \"medium\":\r\n\t\treturn 2, true\r\n\tcase \"low\":\r\n\t\treturn 3, true\r\n\tcase \"info\":\r\n\t\treturn 4, true\r\n\t}\r\n"]
