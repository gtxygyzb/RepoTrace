[1984.518759, "o", "   307\t\t\t}\r\n   308\t\t\tif !cf.HeaderValid {\r\n   309\t\t\t\tstored := uint64(0)\r\n   310\t\t\t\tif len(raw) >= 56 {\r\n"]
