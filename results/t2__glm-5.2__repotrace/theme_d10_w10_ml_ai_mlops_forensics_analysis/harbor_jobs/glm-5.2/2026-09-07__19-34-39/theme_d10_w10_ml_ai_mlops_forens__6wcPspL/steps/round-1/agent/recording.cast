[779.12973, "i", "unc tokenizeQuery(s string) ([]string, error) {\n\tvar tokens []string\n\ti := 0\n\tfor i < len(s) {\n\t\tch := s[i]\n\t\tif ch == ' ' || ch == '\\t' || ch == '\\n' || ch == '\\r' {\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tif ch == '\"' {\n\t\t\tj := i + 1\n\t\t\tfor j < len(s) && s[j] != '\"' {\n\t\t\t\tj++\n\t\t\t}\n\t\t\tif j >= len(s) {\n\t\t\t\treturn nil, fmt.Errorf(\"unterminated string\")\n\t\t\t}\n\t\t\ttokens = append(tokens, s[i:j+1])\n\t\t\ti = j + 1\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(s[i:], \">=\") || strings.HasPrefix(s[i:], \"<=\") || strings.HasPrefix(s[i:], \"==\") || strings.HasPrefix(s[i:], \"!=\") {\n\t\t\ttokens = append(tokens, s[i:i+2])\n\t\t\ti += 2\n\t\t\tcontinue\n\t\t}\n\t\tif ch == '>' || ch == '<' {\n\t\t\ttokens = append(tokens, string(ch))\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tj := i\n\t\tfor j < len(s) {\n\t\t\tc := s[j]\n\t\t\tif c == ' ' || c == '\\t' || c == '\\n' || c == '\\r' || c == '>' || c == '<' || c == '=' || c == '!' || c == '\"' {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tj++\n\t\t}\n\t\tif j == i {\n\t\t\treturn nil, fmt.Errorf(\"invalid character in query: %c\", ch)\n\t\t}\n\t\ttokens = append(tokens, s[i:j])\n\t\ti = j\n\t}\n\treturn t"]
