[4508.355734, "o", "\t\t\tqueue := []string{root}\r\n   421\t\t\tvisited := map[string]bool{}\r\n   422\t\t\tfor len(queue) > 0 {\r\n   423\t\t\t\tcur := queue[0]\r\n   424\t\t\t\tqueue = queue[1:]\r\n   425\t\t\t\t"]
