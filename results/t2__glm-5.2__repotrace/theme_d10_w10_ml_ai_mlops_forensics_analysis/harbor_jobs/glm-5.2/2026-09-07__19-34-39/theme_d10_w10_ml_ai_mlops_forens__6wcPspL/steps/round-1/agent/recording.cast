[4014.02009, "o", "package logparser\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[4014.020227, "o", "\t\"path/filepath\"\r\n\t\"strings\"\r\n\r\n\t\"mlforge/internal/types\"\r\n)\r\n\r\n// RawEntry is the JSON structure of a single line in a .jsonl training log shard.\r\ntype RawEntry struct {\r\n\tTs       string   `json:\"ts\"`\r\n\tEpoch    int      `json:\"epoch\"`\r\n\tStep     int      `json:\"step\"`\r\n\tLoss     *float64 `json:\"loss,omitempty\"`\r\n\tLr       *float64 `json:\"lr,omitempty\"`\r\n\tGradNorm *float64 `json:\"grad_norm,omitempty\"`\r\n\tAcc      *float64 `json:\"acc,omitempty\"`\r\n\tEvent    string   `json:\"event,omitempty\"`\r\n}\r\n\r\n// ShardInfo holds summary info about one parsed shard.\r\ntype ShardInfo struct {\r\n\tFile     string // base filename\r\n\tEntries  int\r\n\tMinStep  int\r\n\tMaxStep  int\r\n\t"]
[4014.020319, "o", "MinEpoch int\r\n\tMaxEpoch int\r\n\tMinTs    string\r\n\tMaxTs    string\r\n}\r\n\r\n// ParseResult holds all entries from a directory of log shards.\r\ntype ParseResult struct {\r\n\tEntries []types.TimelineEntry\r\n\tShards  []ShardInfo\r\n}\r\n\r\n// ParseAll reads every .jsonl file in dir and returns all entries with source\r\n// annotations and per-shard summaries. Malformed JSON lines are silently skipped.\r\nfunc ParseAll(dir string) (*ParseResult, error) {\r\n\tdirEntries, err := os.ReadDir(dir)\r\n"]
[4014.020398, "o", "\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"logparser: read dir %s: %w\", dir, err)\r\n\t}\r\n\r\n\tresult := &ParseResult{}\r\n\r\n\tfor _, de := range dirEntries {\r\n\t\tif de.IsDir() || !strings.HasSuffix(strings.ToLower(de.Name()), \".jsonl\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tshard, entries, err := ParseShard(filepath.Join(dir, de.Name()), de.Name())\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t"]
[4014.020468, "o", "\tresult.Shards = append(result.Shards, shard)\r\n\t\tresult.Entries = append(result.Entries, entries...)\r\n\t}\r\n\r\n\treturn result, nil\r\n}\r\n\r\nfunc ParseShard(path, filename string) (ShardInfo, []types.TimelineEntry, error) {\r\n\tf, err := os.Open(path)\r\n\tif err != nil {\r\n\t\treturn ShardInfo{}, nil, fmt.Errorf(\"logparser: open %s: %w\", path, err)\r\n\t}\r\n\tdefer f.Close()"]
[4014.020543, "o", "\r\n\r\n\tinfo := ShardInfo{\r\n\t\tFile:     filename,\r\n\t\tMinStep:  1<<31 - 1,\r\n\t\tMaxStep:  -(1 << 31),\r\n\t\tMinEpoch: 1<<31 - 1,\r\n\t\tMaxEpoch: -(1 << 31),\r\n\t}\r\n\r\n\tvar entries []types.TimelineEntry\r\n\tscanner := bufio.NewScanner(f)\r\n\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n\r\n\t"]
[4014.020611, "o", "for scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tvar raw RawEntry\r\n\t\tif err := json.Unmarshal([]byte(line), &raw); err != nil {\r\n\t\t\tcontinue // skip malformed lines\r\n\t\t}\r\n\r\n\t\tte := types.TimelineEntry{\r\n\t\t\tTs:       raw.Ts,\r\n\t\t"]
[4014.020692, "o", "\tEpoch:    raw.Epoch,\r\n\t\t\tStep:     raw.Step,\r\n\t\t\tLoss:     raw.Loss,\r\n\t\t\tLr:       raw.Lr,\r\n\t\t\tGradNorm: raw.GradNorm,\r\n\t\t\tAcc:      raw.Acc,\r\n\t\t\tEvent:    raw.Event,\r\n\t\t\tSources:  []string{filename},\r\n\t\t}\r\n\t\tentries = append(entries, te)\r\n\r\n\t\tinfo.Entries++\r\n\t\tif raw.Step < info.MinStep {\r\n"]
[4014.020759, "o", "\t\t\tinfo.MinStep = raw.Step\r\n\t\t}\r\n\t\tif raw.Step > info.MaxStep {\r\n\t\t\tinfo.MaxStep = raw.Step\r\n\t\t}\r\n\t\tif raw.Epoch < info.MinEpoch {\r\n\t\t\tinfo.MinEpoch = raw.Epoch\r\n\t\t}\r\n\t\tif raw.Epoch > info.MaxEpoch {\r\n\t\t\tinfo.MaxEpoch = raw.Epoch\r\n\t\t}\r\n\t\tif info.MinTs == \"\" || raw.Ts < info.MinTs {\r\n"]
[4014.020824, "o", "\t\t\tinfo.MinTs = raw.Ts\r\n\t\t}\r\n\t\tif info.MaxTs == \"\" || raw.Ts > info.MaxTs {\r\n\t\t\tinfo.MaxTs = raw.Ts\r\n\t\t}\r\n\t}\r\n\r\n\treturn info, entries, nil\r\n}\r\n"]
