[7228.443484, "o", "   230\t\t\t\tif e.Ts > maxTs {\r\n   231\t\t\t\t\tmaxTs = e.Ts\r\n   232\t\t\t\t}\r\n   233\t\t\t}\r\n   234\t\t\tout.TotalEpochs = len(epochSet)\r\n   235\t\t\tout.StepRange = []int{minStep, maxStep}\r\n   236"]
[7228.443535, "o", "\t\t\tout.TimeRange = []string{minTs, maxTs}\r\n   237\t\t}\r\n   238\t\tif out.Gaps == nil {\r\n   239\t\t\tout.Gaps = []TimelineGap{}\r\n   240\t\t}\r\n   241\t\tif out.Entries == nil {\r\n   242\t\t\tout.Entries = []types.TimelineEntry{}\r\n"]
