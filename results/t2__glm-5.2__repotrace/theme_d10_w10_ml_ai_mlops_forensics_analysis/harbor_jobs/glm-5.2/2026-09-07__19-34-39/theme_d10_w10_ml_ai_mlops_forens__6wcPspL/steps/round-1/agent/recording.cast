[3999.997398, "o", "(entries []types.TimelineEntry) []types.Anomaly {\r\ninternal/forensics/detect.go:222:func detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\r\ninternal/forensics/detect.go:258:func detectMetricRegression(entries []types.TimelineEntry) []types.Anomaly {\r\ninternal/forensics/detect.go:259:\tvar cps []types.TimelineEntry\r\ninternal/forensics/detect.go:503:func firstSource(e types.TimelineEntry) string {\r\ninternal/forensics/forensics.go:192:\tEntries           []types.TimelineEntry `json:\"entries\"`\r\ninternal/forensics/forensics.go:203:func buildTimelineFromEntries(entries []types.TimelineEntry, shards []logparser.ShardInfo) TimelineOutput {\r\ninternal/forensics/forensics.go:242:\t\tout.Entries = []types.TimelineEntry{}\r\ninternal/forensics/forensics.go:406:func parseShardRecursive(path string) (logparser.ShardInfo, []types.TimelineEntry, error) {\r\ninternal/forensics/forensics.go:410:func loadTimelineEntries(dir string) ([]types.TimelineEntry, []logparser.ShardInfo, error) {\r\ninternal/forensics/forensics.go"]
[3999.997479, "o", ":418:\tvar allEntries []types.TimelineEntry\r\ninternal/forensics/forensics.go:434:func mergeTimeline(entries []types.TimelineEntry) ([]types.TimelineEntry, int) {\r\ninternal/forensics/forensics.go:436:\t\tentry    types.TimelineEntry\r\ninternal/forensics/forensics.go:466:\tresult := make([]types.TimelineEntry, 0, len(m))\r\ninternal/forensics/forensics.go:485:func metricsEqual(a, b types.TimelineEntry) bool {\r\ninternal/forensics/forensics.go:499:func sortTimeline(entries []types.TimelineEntry) {\r\ninternal/forensics/forensics.go:508:func detectGaps(entries []types.TimelineEntry) []TimelineGap {\r\ninternal/logparser/logparser.go:40:\tEntries []types.TimelineEntry\r\ninternal/logparser/logparser.go:69:func ParseShard(path, filename string) (ShardInfo, []types.TimelineEntry, error) {\r\ninternal/logparser/logparser.go:84:\tvar entries []types.TimelineEntry\r\ninternal/logparser/logparser.go:98:\t\tte := types.TimelineEntry{\r\n"]
