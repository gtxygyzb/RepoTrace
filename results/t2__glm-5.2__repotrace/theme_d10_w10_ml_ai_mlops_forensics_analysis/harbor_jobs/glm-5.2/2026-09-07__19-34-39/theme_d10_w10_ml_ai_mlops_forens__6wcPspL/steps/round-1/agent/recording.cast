[3620.302581, "o", "   260\t\t\t\tcontinue\r\n   261\t\t\t}\r\n   262\t\t\tif ch == '\"' {\r\n   263\t\t\t\tj := i + 1\r\n   264\t\t\t\tfor j < len(s) && s[j] != '\"' {\r\n   265\t\t\t\t\tj++\r\n   266\t\t\t\t}\r\n   267\t\t\t\tif j >= len(s) {\r\n"]
[3620.302644, "o", "   268\t\t\t\t\treturn nil, fmt.Errorf(\"unterminated string\")\r\n   269\t\t\t\t}\r\n   270\t\t\t\ttokens = append(tokens, s[i:j+1])\r\n   271\t\t\t\ti = j + 1\r\n   272\t\t\t\tcontinue\r\n   273\t\t\t}\r\n   274\t\t\tif strings.HasPrefix(s[i:], \">=\") || strings.HasPrefix(s[i:], \"<=\") || strings.HasPrefix(s[i:], \"==\") || strings.HasPrefix(s[i:], \"!=\") {\r\n   275\t\t\t\ttokens = append(tokens, s[i:i+2])\r\n   276\t\t\t\ti += 2\r\n"]
[3620.302704, "o", "   277\t\t\t\tcontinue\r\n   278\t\t\t}\r\n   279\t\t\tif ch == '>' || ch == '<' {\r\n   280\t\t\t\ttokens = append(tokens, string(ch))\r\n   281\t\t\t\ti++\r\n   282\t\t\t\tcontinue\r\n   283\t\t\t}\r\n"]
[3620.302765, "o", "   284\t\t\tj := i\r\n   285\t\t\tfor j < len(s) {\r\n   286\t\t\t\tc := s[j]\r\n   287\t\t\t\tif c == ' ' || c == '\\t' || c == '\\n' || c == '\\r' || c == '>' || c == '<' || c == '=' || c == '!' || c == '\"' {\r\n   288\t\t\t\t\tbreak\r\n   289\t\t\t\t}\r\n   290\t\t\t\tj++\r\n   291\t\t\t}\r\n   292\t\t\tif j == i {\r\n   293\t\t\t\treturn nil, fmt.Errorf(\"invalid character in query: %c\", ch)\r\n"]
