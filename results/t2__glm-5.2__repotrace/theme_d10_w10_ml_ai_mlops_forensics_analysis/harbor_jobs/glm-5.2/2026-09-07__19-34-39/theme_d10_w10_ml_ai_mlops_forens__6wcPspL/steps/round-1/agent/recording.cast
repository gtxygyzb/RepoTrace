[3606.939624, "o", "   120\tfunc ptrCompareNum(p *float64, c condition) bool {\r\n   121\t\tif p == nil {\r\n   122\t\t\treturn false\r\n   123\t\t}\r\n   124\t\treturn compareNum(*p, c)\r\n   125\t}\r\n   126\t\r\n   127\tfunc compareStr(val string, c condition) bool {\r\n   128\t\tif c.isNum {\r\n   129\t\t\treturn false\r\n   130\t\t}\r\n   131\t\tswitch c.op {\r\n   132\t\tcase \"==\":\r\n"]
[3606.939725, "o", "   133\t\t\treturn val == c.sval\r\n   134\t\tcase \"!=\":\r\n   135\t\t\treturn val != c.sval\r\n   136\t\t}\r\n   137\t\treturn false\r\n   138\t}\r\n   139\t\r\n   140\tfunc compareTs(val string, c condition) bool {\r\n   141\t\tlt, err := time.Parse(time.RFC3339, val)\r\n   142\t\tif err != nil {\r\n   143\t\t\treturn false\r\n   144\t\t}\r\n   145\t\trt, err := time.Parse(time.RFC3339, c.sval)\r\n   146\t\tif err != nil {\r\n   147\t\t\treturn false\r\n   148\t\t}\r\n   149\t\tswitch c.op {\r\n   150\t\tcase \">\":\r\n   151\t\t\treturn lt.After(rt)\r\n   152\t\tcase \"<\":\r\n   153\t\t\treturn lt.Before(rt)\r\n   154\t\tcase \">=\":\r\n   155\t\t\treturn lt.After(rt) || lt.Equal(rt)\r\n   156\t\tcase \"<=\":\r\n   157\t\t\treturn lt.Before(rt) || lt.Equal(rt)\r\n   158\t\tcase \"==\":\r\n   159\t\t\treturn lt.Equal(rt)\r\n   160\t\tcase \"!=\":"]
[3606.939792, "o", "\r\n   161\t\t\treturn !lt.Equal(rt)\r\n   162\t\t}\r\n   163\t\treturn false\r\n   164\t}\r\n   165\t\r\n   166\tfunc absFloat(x float64) float64 {\r\n   167\t\tif x < 0 {\r\n   168\t\t\treturn -x\r\n   169\t\t}\r\n   170\t\treturn x\r\n"]
