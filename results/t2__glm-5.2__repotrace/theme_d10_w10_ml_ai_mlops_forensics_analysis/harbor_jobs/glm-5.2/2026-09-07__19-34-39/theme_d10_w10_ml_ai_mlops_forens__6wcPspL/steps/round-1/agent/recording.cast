[2126.417731, "o", "   272\t\tif len(ap.Checkpoints) == 0 {\r\n   273\t\t\treturn nil, fmt.Errorf(\"no checkpoint files found\")\r\n   274\t\t}\r\n   275\t\tvar out VerifyOutput\r\n   276\t\tout.Status = \"ok\"\r\n   277\t\tfor _, p := range ap.Checkpoints {\r\n   278\t\t\tvc := verifyCheckpoint(p)\r\n   279\t\t\tout.Checkpoints = append(out.Checkpoints, vc)\r\n   280\t\t}\r\n   281\t\tsort.Slice(out.Checkpoints, func(i, j int) bool {\r\n   282\t\t\treturn out.Checkpoints[i].File < out.Checkpoints[j].File\r\n   283\t\t})\r\n"]
[2126.417815, "o", "   284\t\tout.Summary.Total = len(out.Checkpoints)\r\n   285\t\tfor _, c := range out.Checkpoints {\r\n   286\t\t\tif c.Valid {\r\n   287\t\t\t\tout.Summary.Valid++\r\n   288\t\t\t} else {\r\n   289\t\t\t\tout.Summary.Invalid++\r\n   290\t\t\t}\r\n   291\t\t}\r\n   292\t\treturn out, nil\r\n   293\t}\r\n   294\t\r\n   295\tfunc verifyCheckpoint(path string) VerifyCheckpoint {\r\n"]
[2126.417896, "o", "   296\t\tvc := VerifyCheckpoint{\r\n   297\t\t\tFile:   filepath.Base(path),\r\n   298\t\t\tIssues: []VerifyIssue{},\r\n   299\t\t}\r\n   300\t\tcf, err := checkpoint.Parse(path)\r\n   301\t\tif err != nil || cf == nil {\r\n   302\t\t\tvc.HeaderChecksumValid = false\r\n   303\t\t\tvc.TensorChecksumsValid = false\r\n   304\t\t\tvc.ProvenanceValid = false\r\n   305\t\t\tvc.Valid = false\r\n   306\t\t\tvc.Issues = append(vc.Issues, VerifyIssue{Type: \"parse_error\", Detail: err.Error()})\r\n"]
