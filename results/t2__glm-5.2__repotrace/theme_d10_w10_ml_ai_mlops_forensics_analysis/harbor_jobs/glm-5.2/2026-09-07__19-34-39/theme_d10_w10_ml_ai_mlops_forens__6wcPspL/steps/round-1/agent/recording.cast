[2810.961785, "o", "   435\t\ttype agg struct {\r\n   436\t\t\tentry    types.TimelineEntry\r\n   437\t\t\tsources  map[string]struct{}\r\n   438\t\t\tconflict bool\r\n   439\t\t}\r\n   440\t\tm := map[string]*agg{}\r\n   441\t\tfor _, e := range entries {\r\n   442\t\t\tkey := fmt.Sprintf(\"%d:%d\", e.Epoch, e.Step)\r\n   443\t\t\ta, ok := m[key]\r\n   444\t\t\tif !ok {\r\n   445\t\t\t\tsrc := map[string]struct{}{}\r\n   446\t\t\t\tfor _, s := range e.Sources {\r\n   447\t\t\t\t\tsrc[s] = struct{}{}\r\n"]
[2810.961869, "o", "   448\t\t\t\t}\r\n   449\t\t\t\tm[key] = &agg{entry: e, sources: src}\r\n   450\t\t\t\tcontinue\r\n   451\t\t\t}\r\n   452\t\t\tfor _, s := range e.Sources {\r\n   453\t\t\t\ta.sources[s] = struct{}{}\r\n   454\t\t\t}\r\n   455\t\t\tif metricsEqual(a.entry, e) {\r\n   456\t\t\t\tif e.Ts > a.entry.Ts {\r\n   457\t\t\t\t\ta.entry = e\r\n   458\t\t\t\t}\r\n   459\t\t\t\tcontinue\r\n   460\t\t\t}\r\n   461\t"]
[2810.961964, "o", "\t\ta.conflict = true\r\n   462\t\t\tif e.Ts > a.entry.Ts {\r\n   463\t\t\t\ta.entry = e\r\n   464\t\t\t}\r\n   465\t\t}\r\n   466\t\tresult := make([]types.TimelineEntry, 0, len(m))\r\n   467\t\tconflicts := 0\r\n   468\t\tfor _, a := range m {\r\n   469\t\t\te := a.entry\r\n   470\t\t\tsrcs := make([]string, 0, len(a.sources))\r\n   471\t\t\tfor s := range a.sources {\r\n"]
[2810.962038, "o", "   472\t\t\t\tsrcs = append(srcs, s)\r\n   473\t\t\t}\r\n   474\t\t\tsort.Strings(srcs)\r\n   475\t\t\te.Sources = srcs\r\n   476\t\t\te.Conflict = a.conflict\r\n   477\t\t\tif a.conflict {\r\n   478\t\t\t\tconflicts++\r\n   479\t\t\t}\r\n"]
[2810.96211, "o", "   480\t\t\tresult = append(result, e)\r\n   481\t\t}\r\n   482\t\treturn result, conflicts\r\n   483\t}\r\n   484\t\r\n   485\tfunc metricsEqual(a, b types.TimelineEntry) bool {\r\n"]
[2810.962188, "o", "   486\t\treturn floatPtrEqual(a.Loss, b.Loss) &&\r\n   487\t\t\tfloatPtrEqual(a.Lr, b.Lr) &&\r\n   488\t\t\tfloatPtrEqual(a.GradNorm, b.GradNorm) &&\r\n   489\t\t\tfloatPtrEqual(a.Acc, b.Acc)\r\n   490\t}\r\n   491\t\r\n   492\tfunc floatPtrEqual(a, b *float64) bool {\r\n   493\t\tif a == nil || b == nil {\r\n   494\t\t\treturn a == b\r\n   495"]
[2810.962258, "o", "\t\t}\r\n   496\t\treturn math.Abs(*a-*b) <= 1e-9\r\n   497\t}\r\n   498\t\r\n   499\tfunc sortTimeline(entries []types.TimelineEntry) {\r\n   500\t\tsort.Slice(entries, func(i, j int) bool {\r\n   501\t\t\tif entries[i].Epoch != entries[j].Epoch {\r\n   502\t\t\t\treturn entries[i].Epoch < entries[j].Epoch\r\n   503\t\t\t}\r\n   504\t\t\treturn entries[i].Step < entries[j].Step\r\n   505\t\t})\r\n"]
[2810.962321, "o", "   506\t}\r\n   507\t\r\n   508\tfunc detectGaps(entries []types.TimelineEntry) []TimelineGap {\r\n   509\t\tvar gaps []TimelineGap\r\n   510\t\tfor i := 1; i < len(entries); i++ {\r\n   511\t\t\tprev := entries[i-1]\r\n   512\t\t\tcur := entries[i]\r\n   513\t\t\tif prev.Epoch != cur.Epoch {\r\n   514\t\t\t\tcontinue\r\n"]
[2810.962394, "o", "   515\t\t\t}\r\n   516\t\t\tdiff := cur.Step - prev.Step\r\n   517\t\t\tif diff > 50 {\r\n   518\t\t\t\tgaps = append(gaps, TimelineGap{\r\n   519\t\t\t\t\tAfterStep:  prev.Step,\r\n   520\t\t\t\t\tBeforeStep: cur.Step,\r\n"]
