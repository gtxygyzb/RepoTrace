[5835.279569, "o", "\u001b[35m\u001b[Kdocs/analysis_rules.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K- **\u001b[01;31m\u001b[KSeverity**: `low\u001b[m\u001b[K`\r\n\u001b[35m\u001b[Kdocs/analysis_rules.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K- **\u001b[01;31m\u001b[KSeverity**: `high\u001b[m\u001b[K`\r\n"]
[5835.279915, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[KSeverity: \"info\u001b[m\u001b[K\",\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[KSeverity: \"info\u001b[m\u001b[K\",\r\n"]
[5835.280008, "o", "\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[KSeverity: \"high\u001b[m\u001b[K\",\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\u001b[01;31m\u001b[KSeverity: \"medium\u001b[m\u001b[K\",\r\n\u001b[35m\u001b[Kinternal/forensics/detect.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K507\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[KSeverity: \"high\u001b[m\u001b[K\",\r\n"]
[5835.280532, "o", "\u001b[?2004h"]
