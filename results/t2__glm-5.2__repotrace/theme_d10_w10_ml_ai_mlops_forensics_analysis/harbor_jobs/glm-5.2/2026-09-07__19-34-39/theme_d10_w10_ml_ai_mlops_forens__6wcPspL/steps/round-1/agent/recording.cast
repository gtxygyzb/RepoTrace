[4463.929904, "o", "grep -nE 'detect|format|filter|severity|flag\\.|fs\\.|command|positional|json|csv' cmd/mlforge/main.go\r\n\u001b[?2004l\r"]
[4463.933318, "o", "\u001b[32m\u001b[K4\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\"encoding/\u001b[01;31m\u001b[Kjson\u001b[m\u001b[K\"\r\n"]
[4463.93345, "o", "\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K := \"\u001b[01;31m\u001b[Kjson\u001b[m\u001b[K\"\r\n"]
[4463.933538, "o", "\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar \u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K []string\r\n"]
[4463.933637, "o", "\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase strings.HasPrefix(arg, \"--\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K=\"):\r\n\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K = strings.TrimPrefix(arg, \"--\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K=\")\r\n\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase arg == \"--\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K\":\r\n\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K = append(\u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K, arg)\r\n\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// Handle \"--\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K \u001b[01;31m\u001b[Kjson\u001b[m\u001b[K\" (two separate tokens)\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif os.Args[i] == \"--\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K\" {\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kformat\u001b[m\u001b[K = os.Args[i+1]\r\n"]
[4463.933731, "o", "\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t// Remove the value from \u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K args\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kfilter\u001b[m\u001b[Ked := \u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K[:0]\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor _, p := range \u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\t\u001b[01;31m\u001b[Kfilter\u001b[m\u001b[Ked = append(\u001b[01;31m\u001b[Kfilter\u001b[m\u001b[Ked, p)\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K = \u001b[01;31m\u001b[Kfilter\u001b[m\u001b[Ked\r\n"]
[4463.933822, "o", "\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif \u001b[01;31m\u001b[Kformat\u001b[m\u001b[K != \"\u001b[01;31m\u001b[Kjson\u001b[m\u001b[K\" && \u001b[01;31m\u001b[Kformat\u001b[m\u001b[K != \"text\" {\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"invalid \u001b[01;31m\u001b[Kformat\u001b[m\u001b[K %q: must be \u001b[01;31m\u001b[Kjson\u001b[m\u001b[K or text\\n\", \u001b[01;31m\u001b[Kformat\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// --- Validate \u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K args --------------------------------------\r\n\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif len(\u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K) < 2 {\r\n"]
[4463.933907, "o", "\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <\u001b[01;31m\u001b[Kcommand\u001b[m\u001b[K> <evidence-dir> [args...]\\n\")\r\n\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcmd := \u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K[0]\r\n\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tdir := \u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K[1]\r\n\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// --- Route to \u001b[01;31m\u001b[Kcommand\u001b[m\u001b[K handler --------------------------------------\r\n"]
[4463.934006, "o", "\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kdetect\u001b[m\u001b[K\":\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif len(\u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K) < 3 {\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult, err = forensics.BuildQuery(dir, \u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K[2])\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif len(\u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K) < 4 {\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult, err = forensics.BuildDiff(dir, \u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K[2], \u001b[01;31m\u001b[Kpositional\u001b[m\u001b[K[3])\r\n"]
[4463.934085, "o", "\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"unknown \u001b[01;31m\u001b[Kcommand\u001b[m\u001b[K: %s\\n\", cmd)\r\n\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif \u001b[01;31m\u001b[Kformat\u001b[m\u001b[K == \"text\" {\r\n\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tout, marshalErr := \u001b[01;31m\u001b[Kjson\u001b[m\u001b[K.MarshalIndent(result, \"\", \"  \")\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tb, err := \u001b[01;31m\u001b[Kjson\u001b[m\u001b[K.MarshalIndent(v, \"\", \"  \")\r\n"]
[4463.93459, "o", "\u001b[?2004h"]
[4463.934687, "o", "root@n30009:/app# "]
[4472.725652, "i", "sed -n '1,120p' internal/forensics/detect.go\n"]
[4472.726147, "o", "sed -n '1,120p' internal/forensics/detect.go\r\n\u001b[?2004l\r"]
[4472.729277, "o", "package forensics\r\n\r\nimport (\r\n\t\"crypto/hmac\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/binary\"\r\n\t\"encoding/hex\"\r\n\t\"fmt\"\r\n"]
[4472.729457, "o", "\t\"hash/fnv\"\r\n\t\"math\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"time\"\r\n\r\n\t\"mlforge/internal/checkpoint\"\r\n\t\"mlforge/internal/types\"\r\n)\r\n\r\nfunc loadCheckpoints(dir string) ([]*types.CheckpointFile, error) {\r\n\tap, err := DiscoverArtifacts(dir)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar cps []*types.CheckpointFile\r\n\tfor _, p := range ap.Checkpoints {\r\n\t\tcf, err := checkpoint.Parse(p)\r\n\t\tif err != nil || cf == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tcps = append(cps, cf)\r\n\t}\r\n\tsort.Slice(cps, func(i, j int) bool {\r\n\t\treturn cps[i].Filename < cps[j].Filename\r\n\t})\r\n\treturn cps, nil\r\n}\r\n"]
[4472.729555, "o", "\r\ntype DetectOutput struct {\r\n\tStatus    string          `json:\"status\"`\r\n\tAnomalies []types.Anomaly `json:\"anomalies\"`\r\n\tSummary   struct {\r\n\t\tTotal      int            `json:\"total\"`\r\n\t\tBySeverity map[string]int `json:\"by_severity\"`\r\n\t\tByType     map[string]int `json:\"by_type\"`\r\n\t} `json:\"summary\"`\r\n}\r\n\r\nfunc BuildDetect(dir string) (interface{}, error) {\r\n\treturn buildDetectWithDir(dir)\r\n}\r\n\r\nfunc buildDetectWithDir(dir string) (DetectOutput, error) {\r\n\tvar out DetectOutput\r\n"]
[4472.729652, "o", "\tout.Status = \"ok\"\r\n\tvar anomalies []types.Anomaly\r\n\r\n\tentries, _, err := loadTimelineEntries(dir)\r\n\tif err == nil {\r\n\t\tmerged, _ := mergeTimeline(entries)\r\n\t\tsortTimeline(merged)\r\n\t\tanomalies = append(anomalies, detectTimelineAnomalies(merged)...)\r\n\t}\r\n\r\n\tcps, err := loadCheckpoints(dir)\r\n\tif err == nil {\r\n\t\tanomalies = append(anomalies, detectCheckpointAnomalies(dir, cps)...)\r\n\t}\r\n\r\n\tfor i := range anomalies {\r\n\t\tanomalies[i].ID = fmt.Sprintf(\"ANOM-%03d\", i+1)\r\n"]
[4472.72974, "o", "\t}\r\n\tsortAnomalies(anomalies)\r\n\r\n\tout.Anomalies = anomalies\r\n\tif out.Anomalies == nil {\r\n\t\tout.Anomalies = []types.Anomaly{}\r\n\t}\r\n\tout.Summary.Total = len(anomalies)\r\n\tout.Summary.BySeverity = map[string]int{\"critical\": 0, \"high\": 0, \"medium\": 0, \"low\": 0}\r\n\tout.Summary.ByType = map[string]int{}\r\n\tfor _, a := range anomalies {\r\n\t\tout.Summary.BySeverity[a.Severity]++\r\n\t\tout.Summary.ByType[a.Type]++\r\n\t}\r\n\treturn out, nil\r\n}\r\n"]
[4472.729827, "o", "\r\nfunc detectTimelineAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tanomalies = append(anomalies, detectGradientSpikes(entries)...)\r\n\tanomalies = append(anomalies, detectLossDivergence(entries)...)\r\n\tanomalies = append(anomalies, detectLrAnomalies(entries)...)\r\n\tanomalies = append(anomalies, detectTrainingGaps(entries)...)\r\n\tanomalies = append(anomalies, detectMetricRegression(entries)...)\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectGradientSpikes(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar vals []float64"]
[4472.729909, "o", "\r\n\tvar idx []int\r\n\tfor i, e := range entries {\r\n\t\tif e.GradNorm != nil {\r\n\t\t\tvals = append(vals, *e.GradNorm)\r\n\t\t\tidx = append(idx, i)\r\n\t\t}\r\n\t}\r\n\tif len(vals) < 31 {\r\n\t\treturn nil\r\n"]
[4472.730028, "o", "\t}\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 30; i < len(vals); i++ {\r\n\t\twindow := vals[i-30 : i]\r\n\t\tmean := meanFloats(window)\r\n\t\tstd := stddevFloats(window, mean)\r\n\t\tobserved := vals[i]\r\n\t\tz := 0.0\r\n\t\tif std > 0 {\r\n\t\t\tz = (observed - mean) / std\r\n\t\t}\r\n\t\tif observed > mean+2.5*std && z > 2.5 {\r\n"]
[4472.730659, "o", "\u001b[?2004h"]
[4472.730748, "o", "root@n30009:/app# "]
[4479.261213, "i", "sed -n '120,230p' internal/forensics/detect.go\n"]
[4479.261676, "o", "sed -n '120,230p' internal/forensics/detect.go\r\n"]
[4479.261704, "o", "\u001b[?2004l\r"]
[4479.264674, "o", "\t\tif observed > mean+2.5*std && z > 2.5 {\r\n\t\t\tseverity := \"medium\"\r\n\t\t\tif z > 4.0 {\r\n\t\t\t\tseverity = \"high\"\r\n"]
[4479.264699, "o", "\t\t\t}\r\n\t\t\tep := entries[idx[i]].Epoch\r\n\t\t\tst := entries[idx[i]].Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{"]
[4479.264781, "o", "\r\n\t\t\t\tType:     \"gradient_spike\",\r\n\t\t\t\tSeverity: severity,\r\n"]
[4479.264798, "o", "\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"observed\":      observed,\r\n\t\t\t\t\t\"window_mean\":   mean,\r\n\t\t\t\t\t\"window_stddev\": std,\r\n\t\t\t\t\t\"z_score\":       z,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(entries[idx[i]]),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n"]
[4479.264905, "o", "\treturn anomalies\r\n}\r\n\r\nfunc detectLossDivergence(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar lossEntries []int\r\n\tfor i, e := range entries {\r\n\t\tif e.Loss != nil {\r\n\t\t\tlossEntries = append(lossEntries, i)\r\n\t\t}\r\n\t}\r\n\tif len(lossEntries) < 51 {\r\n\t\treturn nil\r\n\t}\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 50; i < len(lossEntries); i++ {\r\n\t\tstartIdx := lossEntries[i-50]\r\n\t\tendIdx := lossEntries[i]\r\n\t\tstart := *entries[startIdx].Loss\r\n\t\t"]
[4479.265007, "o", "end := *entries[endIdx].Loss\r\n\t\tif math.Abs(start) <= 1e-6 {\r\n\t\t\tcontinue\r\n"]
[4479.265066, "o", "\t\t}\r\n\t\tratio := (end - start) / math.Abs(start)\r\n\t\tif ratio > 1.0 {\r\n\t\t\tseverity := \"high\"\r\n\t\t\tif ratio > 5.0 {\r\n\t\t\t\tseverity = \"critical\"\r\n\t\t\t}\r\n\t\t\tep := entries[endIdx].Epoch\r\n\t\t\tst := entries[endIdx].Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"loss_divergence\",\r\n\t\t\t\tSeverity: severity,\r\n\t\t\t\tEpoch:    &ep,\r\n"]
[4479.265119, "o", "\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"loss_start\":        start,\r\n\t\t\t\t\t\"loss_end\":          end,\r\n\t\t\t\t\t\"increase_ratio\":    ratio,\r\n\t\t\t\t\t\"window_start_step\": entries[startIdx].Step,\r\n\t\t\t\t\t\"window_end_step\":   entries[endIdx].Step,\r\n\t\t\t\t},\r\n"]
[4479.265134, "o", "\t\t\t\tSource: firstSource(entries[endIdx]),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectLrAnomalies(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n"]
[4479.265207, "o", "\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]\r\n\t\tif prev.Lr == nil || cur.Lr == nil {\r\n\t\t\tcontinue\r\n"]
[4479.26526, "o", "\t\t}\r\n\t\tif *cur.Lr > *prev.Lr {\r\n\t\t\tif cur.Event == \"epoch_end\" {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"lr_anomaly\",\r\n\t\t\t\tSeverity: \"medium\",\r\n\t\t\t\tEpoch:    &ep,\r\n"]
[4479.265276, "o", "\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"prev_lr\": *prev.Lr,\r\n\t\t\t\t\t\"curr_lr\": *cur.Lr,\r\n\t\t\t\t\t\"step\":    cur.Step,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(cur),\r\n"]
[4479.265345, "o", "\t\t\t})\r\n\t\t}\r\n\t}\r\n\treturn anomalies\r\n}\r\n\r\nfunc detectTrainingGaps(entries []types.TimelineEntry) []types.Anomaly {\r\n\tvar anomalies []types.Anomaly\r\n\tfor i := 1; i < len(entries); i++ {\r\n\t\tprev := entries[i-1]\r\n\t\tcur := entries[i]\r\n\t\tif prev.Epoch != cur.Epoch {\r\n\t\t\tcontinue\r\n\t"]
[4479.265358, "o", "\t}\r\n"]
[4479.265423, "o", "\t\tprevT, err1 := time.Parse(time.RFC3339, prev.Ts)\r\n"]
[4479.265942, "o", "\u001b[?2004h"]
[4479.266027, "o", "root@n30009:/app# "]
[4479.55557, "i", "sed -n '231,340p' internal/forensics/detect.go\n"]
[4479.556022, "o", "sed -n '231,340p' internal/forensics/detect.go\r\n"]
[4479.556042, "o", "\u001b[?2004l\r"]
[4479.558923, "o", "\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\r\n\t\tif err1 != nil || err2 != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[4479.559049, "o", "\t\tdiff := curT.Sub(prevT).Seconds()\r\n\t\tif diff > 3600 {\r\n\t\t\tep := cur.Epoch\r\n\t\t\tst := cur.Step\r\n\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n\t\t\t\tType:     \"training_gap\",\r\n\t\t\t\tSeverity: \"low\",\r\n\t\t\t\tEpoch:    &ep,\r\n\t\t\t\tStep:     &st,\r\n\t\t\t\tDetails: map[string]interface{}{\r\n\t\t\t\t\t\"after_step\":  prev.Step,\r\n\t\t\t\t\t\"before_step\": cur.Step,\r\n\t\t"]
[4479.559127, "o", "\t\t\t\"after_ts\":    prev.Ts,\r\n"]
[4479.559184, "o", "\t\t\t\t\t\"before_ts\":   cur.Ts,\r\n\t\t\t\t\t\"gap_seconds\": diff,\r\n\t\t\t\t},\r\n\t\t\t\tSource: firstSource(cur),\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n"]
