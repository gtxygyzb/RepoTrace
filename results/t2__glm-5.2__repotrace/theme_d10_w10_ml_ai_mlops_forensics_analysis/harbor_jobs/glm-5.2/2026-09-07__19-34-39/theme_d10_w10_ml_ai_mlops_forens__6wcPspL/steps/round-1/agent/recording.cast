[4508.355862, "o", "\t\t\t\tif !ok || node == nil {\r\n   431\t\t\t\t\tcontinue\r\n   432\t\t\t\t}\r\n   433\t\t\t\tchain = append(chain, node.Filename)\r\n   434\t\t\t\tqueue = append(queue, children[cur]...)\r\n"]
