[7870.352853, "o", "> "]
[7870.353054, "o", "from pathlib import Path\r\n"]
[7870.353152, "o", "\u001b[?2004l\r"]
[7870.353248, "o", "\u001b[?2004h> "]
[7870.353464, "o", "p = Path('docs/output_schema.md')\r\n\u001b[?2004l\r"]
[7870.353558, "o", "\u001b[?2004h"]
[7870.353649, "o", "> "]
[7870.353738, "o", "s = p.read_text()\r\n"]
[7870.35383, "o", "\u001b[?2004l\r"]
[7870.353921, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7870.354027, "o", "\u001b[?2004h> "]
[7870.354273, "o", "# Insert metadata contract after intro.\r\n\u001b[?2004l\r"]
[7870.354369, "o", "\u001b[?2004h> "]
[7870.355077, "o", "old = \"All commands output JSON to stdout. This document defines the exact JSON structure for each command.\\n\\n---\"\r\n\u001b[?2004l\r"]
[7870.355176, "o", "\u001b[?2004h> "]
[7870.355839, "o", "new = \"\"\"All commands output JSON to stdout. This document defines the exact JSON structure for each command.\r\n\u001b[?2004l\r"]
[7870.355948, "o", "\u001b[?2004h"]
[7870.356045, "o", "> \r\n\u001b[?2004l\r"]
[7870.356134, "o", "\u001b[?2004h> "]
[7870.356272, "o", "## Execution Metadata\r\n\u001b[?2004l\r"]
[7870.356361, "o", "\u001b[?2004h"]
[7870.356452, "o", "> \r\n\u001b[?2004l\r"]
[7870.356542, "o", "\u001b[?2004h> "]
[7870.35742, "o", "Every JSON command output includes a top-level `metadata` object alongside the command-specific fields. The metadata object is not added to CSV output.\r\n\u001b[?2004l\r"]
[7870.357526, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7870.357612, "o", "\u001b[?2004h"]
[7870.357707, "o", "> "]
[7870.357797, "o", "```json\r\n\u001b[?2004l\r"]
[7870.357885, "o", "\u001b[?2004h> {\r\n"]
[7870.357989, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[7870.358101, "o", "  \"metadata\": {\r\n\u001b[?2004l\r"]
[7870.358192, "o", "\u001b[?2004h> "]
[7870.358365, "o", "    \"tool\": \"mlforge\",\r\n\u001b[?2004l\r"]
[7870.358457, "o", "\u001b[?2004h"]
[7870.358546, "o", "> "]
[7870.358665, "o", "    \"version\": \"1.0\",\r\n\u001b[?2004l\r"]
[7870.35875, "o", "\u001b[?2004h"]
[7870.358839, "o", "> "]
[7870.359, "o", "    \"command\": \"detect\",\r\n\u001b[?2004l\r"]
[7870.359086, "o", "\u001b[?2004h> "]
[7870.35939, "o", "    \"evidence_dir\": \"/tmp/test_evidence\",\r\n\u001b[?2004l\r"]
[7870.35949, "o", "\u001b[?2004h> "]
[7870.359754, "o", "    \"timestamp\": \"2024-01-15T10:30:00Z\"\r\n\u001b[?2004l\r"]
[7870.359843, "o", "\u001b[?2004h"]
[7870.35996, "o", ">   }\r\n\u001b[?2004l\r"]
[7870.360056, "o", "\u001b[?2004h> "]
[7870.360156, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[7870.360246, "o", "> ```\r\n\u001b[?2004l\r"]
[7870.360335, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7870.360428, "o", "\u001b[?2004h> "]
[7870.360557, "o", "Field requirements:\r\n\u001b[?2004l\r"]
[7870.360646, "o", "\u001b[?2004h> "]
[7870.360736, "o", "\r\n\u001b[?2004l\r"]
[7870.360826, "o", "\u001b[?2004h> "]
[7870.361014, "o", "- `tool`: always `\"mlforge\"`.\r\n\u001b[?2004l\r"]
[7870.361116, "o", "\u001b[?2004h> "]
[7870.361313, "o", "- `version`: always `\"1.0\"`.\r\n\u001b[?2004l\r"]
[7870.361406, "o", "\u001b[?2004h> "]
[7870.362278, "o", "- `command`: the subcommand name, such as `\"ingest\"`, `\"timeline\"`, `\"verify\"`, `\"detect\"`, `\"lineage\"`, `\"query\"`, `\"diff\"`, or `\"report\"`.\r\n\u001b[?2004l\r"]
[7870.362386, "o", "\u001b[?2004h> "]
[7870.362801, "o", "- `evidence_dir`: the evidence directory path passed to the command.\r\n\u001b[?2004l\r"]
[7870.362891, "o", "\u001b[?2004h"]
[7870.362993, "o", "> "]
[7870.363446, "o", "- `timestamp`: the command execution time as an ISO 8601 / RFC3339 UTC timestamp.\r\n\u001b[?2004l\r"]
[7870.363538, "o", "\u001b[?2004h"]
[7870.363629, "o", "> \r\n\u001b[?2004l\r"]
[7870.363719, "o", "\u001b[?2004h> "]
[7870.364367, "o", "The examples below show `metadata` with placeholder values. Actual timestamps are generated at execution time.\r\n\u001b[?2004l\r"]
[7870.36447, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7870.364564, "o", "\u001b[?2004h> "]
[7870.364653, "o", "---\"\"\"\r\n\u001b[?2004l\r"]
[7870.364743, "o", "\u001b[?2004h> "]
[7870.364877, "o", "if old not in s:\r\n\u001b[?2004l\r"]
[7870.364989, "o", "\u001b[?2004h> "]
[7870.365254, "o", "    raise ValueError('intro not found')\r\n\u001b[?2004l\r"]
[7870.365347, "o", "\u001b[?2004h> "]
[7870.365521, "o", "s = s.replace(old, new, 1)\r\n\u001b[?2004l\r"]
[7870.365587, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7870.365651, "o", "\u001b[?2004h> "]
[7870.36586, "o", "# Add metadata to Ingest Output example.\r\n\u001b[?2004l\r"]
[7870.365946, "o", "\u001b[?2004h> "]
[7870.36741, "o", "s = s.replace('\"status\": \"ok\",\\n  \"evidence_dir\": \"/path/to/evidence\",\\n  \"artifacts\": {', '\"metadata\": {\\n    \"tool\": \"mlforge\",\\n    \"version\": \"1.0\",\\n    \"command\": \"ingest\",\\n    \"evidence_dir\": \"/path/to/evidence\",\\n    \"timestamp\": \"2024-01-15T10:30:00Z\"\\n  },\\n  \"status\": \"ok\",\\n  \"evidence_dir\": \"/path/to/evidence\",\\n  \"artifacts\": {', 1)\r\n\u001b[?2004l\r"]
[7870.367515, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7870.367582, "o", "> "]
[7870.367763, "o", "# Add metadata to Timeline Output example.\r\n\u001b[?2004l\r"]
[7870.367836, "o", "\u001b[?2004h> "]
[7870.369102, "o", "s = s.replace('\"status\": \"ok\",\\n  \"total_entries\": 1200,', '\"metadata\": {\\n    \"tool\": \"mlforge\",\\n    \"version\": \"1.0\",\\n    \"command\": \"timeline\",\\n    \"evidence_dir\": \"/path/to/evidence\",\\n    \"timestamp\": \"2024-01-15T10:30:00Z\"\\n  },\\n  \"status\": \"ok\",\\n  \"total_entries\": 1200,', 1)\r\n\u001b[?2004l\r"]
[7870.369208, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7870.369284, "o", "> "]
[7870.369449, "o", "# Add metadata to Verify Output example.\r\n\u001b[?2004l\r"]
[7870.369523, "o", "\u001b[?2004h> "]
[7870.370694, "o", "s = s.replace('\"status\": \"ok\",\\n  \"checkpoints\": [', '\"metadata\": {\\n    \"tool\": \"mlforge\",\\n    \"version\": \"1.0\",\\n    \"command\": \"verify\",\\n    \"evidence_dir\": \"/path/to/evidence\",\\n    \"timestamp\": \"2024-01-15T10:30:00Z\"\\n  },\\n  \"status\": \"ok\",\\n  \"checkpoints\": [', 1)\r\n\u001b[?2004l\r"]
[7870.3708, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7870.370878, "o", "> "]
[7870.371053, "o", "# Add metadata to Detect Output example.\r\n\u001b[?2004l\r"]
[7870.371132, "o", "\u001b[?2004h> "]
[7870.372272, "o", "s = s.replace('\"status\": \"ok\",\\n  \"anomalies\": [', '\"metadata\": {\\n    \"tool\": \"mlforge\",\\n    \"version\": \"1.0\",\\n    \"command\": \"detect\",\\n    \"evidence_dir\": \"/path/to/evidence\",\\n    \"timestamp\": \"2024-01-15T10:30:00Z\"\\n  },\\n  \"status\": \"ok\",\\n  \"anomalies\": [', 1)\r\n\u001b[?2004l\r"]
[7870.372373, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7870.372451, "o", "\u001b[?2004h> "]
[7870.372643, "o", "# Add metadata to Lineage Output example.\r\n\u001b[?2004l\r"]
[7870.372714, "o", "\u001b[?2004h> "]
[7870.373813, "o", "s = s.replace('\"status\": \"ok\",\\n  \"nodes\": [', '\"metadata\": {\\n    \"tool\": \"mlforge\",\\n    \"version\": \"1.0\",\\n    \"command\": \"lineage\",\\n    \"evidence_dir\": \"/path/to/evidence\",\\n    \"timestamp\": \"2024-01-15T10:30:00Z\"\\n  },\\n  \"status\": \"ok\",\\n  \"nodes\": [', 1)\r\n\u001b[?2004l\r"]
[7870.37391, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7870.374001, "o", "> "]
[7870.374393, "o", "# Add metadata to Query Output example if present; otherwise generic insertion after status.\r\n\u001b[?2004l\r"]
[7870.374472, "o", "\u001b[?2004h"]
[7870.374536, "o", "> "]
[7870.375561, "o", "s = s.replace('\"status\": \"ok\",\\n  \"query\":', '\"metadata\": {\\n    \"tool\": \"mlforge\",\\n    \"version\": \"1.0\",\\n    \"command\": \"query\",\\n    \"evidence_dir\": \"/path/to/evidence\",\\n    \"timestamp\": \"2024-01-15T10:30:00Z\"\\n  },\\n  \"status\": \"ok\",\\n  \"query\":', 1)\r\n\u001b[?2004l\r"]
[7870.375622, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7870.375677, "o", "\u001b[?2004h> "]
[7870.375811, "o", "# Add metadata to Diff Output example.\r\n\u001b[?2004l\r"]
[7870.375866, "o", "\u001b[?2004h> "]
[7870.376611, "o", "s = s.replace('\"status\": \"ok\",\\n  \"file_a\":', '\"metadata\": {\\n    \"tool\": \"mlforge\",\\n    \"version\": \"1.0\",\\n    \"command\": \"diff\",\\n    \"evidence_dir\": \"/path/to/evidence\",\\n    \"timestamp\": \"2024-01-15T10:30:00Z\"\\n  },\\n  \"status\": \"ok\",\\n  \"file_a\":', 1)\r\n\u001b[?2004l\r"]
[7870.376675, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7870.376735, "o", "\u001b[?2004h> "]
[7870.376852, "o", "# Add metadata to Report Output example.\r\n\u001b[?2004l\r"]
[7870.376905, "o", "\u001b[?2004h> "]
[7870.377713, "o", "s = s.replace('\"version\": \"1.0\",\\n  \"generated_at\":', '\"metadata\": {\\n    \"tool\": \"mlforge\",\\n    \"version\": \"1.0\",\\n    \"command\": \"report\",\\n    \"evidence_dir\": \"/path/to/evidence\",\\n    \"timestamp\": \"2024-01-15T10:30:00Z\"\\n  },\\n  \"version\": \"1.0\",\\n  \"generated_at\":', 1)\r\n\u001b[?2004l\r"]
[7870.377775, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7870.377837, "o", "\u001b[?2004h> "]
[7870.377869, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
