[4456.370666, "o", "\t\tcurT, err2 := time.Parse(time.RFC3339, cur.Ts)\r\n   232\t\t\tif err1 != nil || err2 != nil {\r\n   233\t\t\t\tcontinue\r\n   234\t\t\t}\r\n   235"]
[4456.370722, "o", "\t\t\tdiff := curT.Sub(prevT).Seconds()\r\n   236\t\t\tif diff > 3600 {\r\n   237\t\t\t\tep := cur.Epoch\r\n   238\t\t\t\tst := cur.Step\r\n   239\t\t\t\tanomalies = append(anomalies, types.Anomaly{\r\n   240\t\t\t\t\tType:     \"training_gap\",\r\n   241\t\t\t\t\tSeverity: \"low\",\r\n"]
