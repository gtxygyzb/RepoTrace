[7273.367325, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"strconv\"\r\n     8"]
[7273.36737, "o", "\t\t\"strings\"\r\n     9\t\r\n    10\t\t\"mlforge/internal/forensics\"\r\n    11\t)\r\n    12\t\r\n    13\tfunc main() {\r\n    14\t\t// --- Parse flags ---------------------------------------------------\r\n    15\t\tformat := \"json\"\r\n"]
[7273.367538, "o", "    16\t\tverbose := false\r\n    17\t\tfilterSeverity := \"\"\r\n    18\t\tvar positional []string\r\n    19\t\r\n    20\t\targs := os.Args[1:]\r\n    21\t\tfor i := 0; i < len(args); i++ {\r\n    22\t\t\targ := args[i]\r\n    23\t\t\tswitch {\r\n    24\t\t\tcase arg == \"--verbose\":\r\n    25\t\t\t\tverbose = true\r\n    26\t\t\tcase strings.HasPrefix(arg, \"--format=\"):\r\n    27\t\t\t\tformat = strings.TrimPrefix(arg, \"--format=\")\r\n    28\t\t\tcase arg == \"--format\":\r\n    29\t\t\t\tif i+1 >= len(args) {\r\n    30\t\t\t\t\tfmt.Fprintf(os.Stderr, \"flag --format requires a value\\n\")\r\n    31\t\t\t\t\tos.Exit(1)\r\n    32\t\t\t\t}\r\n    33\t\t\t\ti++\r\n    34\t\t\t\tformat = args[i]\r\n    35\t\t\tcase strings.HasPrefix(arg, \"--filter-severity=\"):\r\n    36\t\t\t\tfilterSeverity = strings.TrimPrefix(arg, \"--filter-severity=\")\r\n    37\t\t\tcase arg == \"--filter-severity\":\r\n    38\t\t\t\tif i+1 >= len(args) {\r\n    39\t\t\t\t\tfmt.Fprintf(os.Stderr, \"flag --filter-severity requires a value\\n\")\r\n"]
[7273.367619, "o", "    40\t\t\t\t\tos.Exit(1)\r\n    41\t\t\t\t}\r\n    42\t\t\t\ti++\r\n    43\t\t\t\tfilterSeverity = args[i]\r\n    44\t\t\tdefault:\r\n    45\t\t\t\tpositional = append(positional, arg)\r\n    46\t\t\t}\r\n    47\t\t}\r\n    48\t\r\n    49\t\tswitch format {\r\n    50\t\tcase \"json\", \"text\", \"csv\":\r\n    51\t\tdefault:\r\n    52\t\t\tfmt.Fprintf(os.Stderr, \"invalid format %q: must be json, text, or csv\\n\", format)\r\n    53\t\t\tos.Exit(1)\r\n"]
[7273.367698, "o", "    54\t\t}\r\n    55\t\r\n    56\t\t_ = verbose // reserved for diagnostic output\r\n    57\t\r\n    58\t\t// --- Validate positional args --------------------------------------\r\n    59\t\tif len(positional) < 2 {\r\n    60\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge <command> <evidence-dir> [args...]\\n\")\r\n    61\t\t\tos.Exit(1)\r\n    62\t\t}\r\n    63\t\r\n    64\t\tcmd := positional[0]\r\n"]
[7273.367756, "o", "    65\t\tdir := positional[1]\r\n    66\t\r\n    67\t\tif format == \"csv\" && cmd != \"detect\" {\r\n"]
[7273.367815, "o", "    68\t\t\tfmt.Fprintf(os.Stderr, \"invalid format csv: csv output is only supported for detect\\n\")\r\n    69\t\t\tos.Exit(1)\r\n    70\t\t}\r\n    71\t\tif filterSeverity != \"\" && cmd != \"detect\" {\r\n    72\t\t\tfmt.Fprintf(os.Stderr, \"--filter-severity is only supported for detect\\n\")\r\n    73\t\t\tos.Exit(1)\r\n    74\t\t}\r\n    75\t\r\n    76\t\t// --- Route to command handler --------------------------------------\r\n    77\t\tvar result interface{}\r\n    78\t\tvar err error\r\n    79\t\r\n    80\t\tswitch cmd {\r\n    81\t\tcase \"ingest\":\r\n    82\t\t\tresult, err = forensics.BuildIngest(dir)\r\n    83\t\t"]
[7273.367871, "o", "case \"timeline\":\r\n    84\t\t\tresult, err = forensics.BuildTimeline(dir)\r\n    85\t\t"]
[7273.367897, "o", "case \"verify\":\r\n    86\t\t\tresult, err = forensics.BuildVerify(dir)\r\n    87\t\tcase \"detect\":\r\n    88\t\t\tdetectResult, detectErr := forensics.BuildDetectFiltered(dir, filterSeverity)\r\n    89\t\t\tif detectErr != nil {\r\n    90\t\t\t\terr = detectErr\r\n    91\t\t\t} else {\r\n    92\t\t\t\tif format == \"csv\" {\r\n    93\t\t\t\t\tprintDetectCSV(detectResult)\r\n    94\t\t\t\t\treturn\r\n"]
[7273.367987, "o", "    95\t\t\t\t}\r\n    96\t\t\t\tresult = detectResult\r\n    97\t\t\t}\r\n    98\t\tcase \"lineage\":\r\n    99\t\t\tresult, err = forensics.BuildLineage(dir)\r\n   100\t\tcase \"query\":\r\n   101\t\t\tif len(positional) < 3 {\r\n   102\t\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge query <dir> \\\"<expression>\\\"\\n\")\r\n   103\t\t\t\tos.Exit(1)\r\n   104\t\t\t}\r\n   105\t\t\tresult, err = forensics.BuildQuery(dir, positional[2])\r\n"]
[7273.368044, "o", "   106\t\tcase \"diff\":\r\n   107\t\t\tif len(positional) < 4 {\r\n   108\t\t\t\tfmt.Fprintf(os.Stderr, \"Usage: mlforge diff <dir> <file1> <file2>\\n\")\r\n"]
[7273.368105, "o", "   109\t\t\t\tos.Exit(1)\r\n   110\t\t\t}\r\n   111\t\t\tresult, err = forensics.BuildDiff(dir, positional[2], positional[3])\r\n   112\t\tcase \"report\":\r\n   113\t\t\tresult, err = forensics.BuildReport(dir)\r\n   114\t\tdefault:\r\n   115\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n   116\t\t\tos.Exit(1)\r\n   117\t\t}\r\n   118\t\r\n   119\t\t// --- Output --------------------------------------------------------\r\n   120\t\tif err != nil {\r\n   121\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   122"]
[7273.368168, "o", "\t\t\tos.Exit(1)\r\n   123\t\t}\r\n   124\t\r\n   125\t\tif format == \"text\" {\r\n   126\t\t\tprintText(result)\r\n   127\t\t\treturn\r\n   128\t\t}\r\n   129\t\r\n   130\t\tout, marshalErr := json.MarshalIndent(result, \"\", \"  \")\r\n"]
