is required\\n")\n\t\tos.Exit(1)\n\t}\n\tif outputDir == "" {\n\t\toutputDir = "./results"\n\t}\n\n\tparams, err := config.ParseParams(paramStrs)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "parameter error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tfn, err := engine.Get(experimentName)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tif !seedProvided {\n\t\tseed = time.Now().UnixNano()\n\t}\n\n\trng := engine.NewRNG(seed)\n\n\tresult, err := fn(experimentName, params, rng)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "experiment error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tif result.Metadata == nil {\n\t\tresult.Metadata = map[string]string{}\n\t}\n\tif _, ok := result.Metadata["seed"]; !ok {\n\t\tresult.Metadata["seed"] = strconv.FormatInt(seed, 10)\n\t}\n\tif seedProvided {\n\t\tresult.Metadata["seed_source"] = "provided"\n\t} else {\n\t\tresult.Metadata["seed_source"] = "auto-generated"\n\t}\n\n\tstore, err := storage.NewStore(outputDir)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "storage error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tid, err := store.Save(result)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "save error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tfmt.Printf("Experiment: %s\\n", experimentName)\n\tfmt.Printf("Result ID: %s\\n", id)\n\tfmt.Printf("Values:\\n")\n\tfor i, v := range result.Values {\n\t\tlabel := fmt.Sprintf("[%d]", i)\n\t\tif i < len(result.Labels) {\n\t\t\tlabel = result.Labels[i]\n\t\t}\n\t\tfmt.Printf("  %s = %.15e\\n", label, v)\n\t}\n}\n\nfunc cmdCompare(args []string) {\n\tif len(args) < 2 {\n\t\tfmt.Fprintf(os.Stderr, "usage: numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\\n")\n\t\tos.Exit(1)\n\t}\n\n\tid1 := args[0]\n\tid2 := args[1]\n\tstoreDir := "./results"\n\tmode := "exact"\n\ttol := compare.DefaultTolerance()\n\n\tfor i := 2; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase "--store-dir":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, "error: --store-dir requires a value\\n")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tstoreDir = args[i]\n\t\tcase "--mode":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, "error: --mode requires a value\\n")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tmode = args[i]\n\t\tcase "--abs-tol":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, "error: --abs-tol requires a value\\n")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tv, err := strconv.ParseFloat(args[i], 64)\n\t\t\tif err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, "error: invalid absolute tolerance: %v\\n", err)\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\ttol.Absolute = v\n\t\tcase "--rel-tol":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, "error: --rel-tol requires a value\\n")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tv, err := strconv.ParseFloat(args[i], 64)\n\t\t\tif err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, "error: invalid relative tolerance: %v\\n", err)\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\ttol.Relative = v\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, "error: unknown flag: %s\\n", args[i])\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\n\tstore, err := storage.NewStore(storeDir)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "storage error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\ta, err := store.Load(id1)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "load error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tb, err := store.Load(id2)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "load error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tvar comparisonMode compare.ComparisonMode\n\tswitch mode {\n\tcase "exact":\n\t\tcomparisonMode = compare.ModeExact\n\tcase "tolerance":\n\t\tcomparisonMode = compare.ModeTolerance\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, "error: invalid comparison mode: %s\\n", mode)\n\t\tos.Exit(1)\n\t}\n\n\tcr := compare.Compare(a, b, comparisonMode, tol)\n\tfmt.Print(compare.FormatReport(cr))\n\n\tif cr.Match {\n\t\tos.Exit(0)\n\t} else {\n\t\tos.Exit(1)\n\t}\n}\n\nfunc cmdList(args []string) {\n\tstoreDir := "./results"\n\texperimentFilter := ""\n\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase "--store-dir":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, "error: --store-dir requires a value\\n")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tstoreDir = args[i]\n\t\tcase "--experiment":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, "error: --experiment requires a value\\n")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\texperimentFilter = args[i]\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, "error: unknown flag: %s\\n", args[i])\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\n\tstore, err := storage.NewStore(storeDir)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "storage error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tentries, err := store.ListResults(experimentFilter)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "list error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tif len(entries) == 0 {\n\t\tfmt.Println("No results found.")\n\t\treturn\n\t}\n\n\tfmt.Printf("%-40s %-25s %s\\n", "ID", "Experiment", "Timestamp")\n\tfmt.Println(strings.Repeat("-", 80))\n\tfor _, entry := range entries {\n\t\tfmt.Printf("%-40s %-25s %s\\n", entry.ID, entry.ExperimentName, entry.Timestamp.Format("2006-01-02 15:04:05"))\n\t}\n}\n\nfunc cmdExport(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, "usage: numeriforge export <id> --store-dir <dir> [--format json|csv]\\n")\n\t\tos.Exit(1)\n\t}\n\n\tid := args[0]\n\tstoreDir := "./results"\n\tformat := "json"\n\n\tfor i := 1; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase "--store-dir":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, "error: --store-dir requires a value\\n")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tstoreDir = args[i]\n\t\tcase "--format":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, "error: --format requires a value\\n")\n\t\t\t\tos.Exit(1)\n\t\t