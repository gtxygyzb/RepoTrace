.Println("No results found.")\n                return\n        }\n\n        fmt.Println("=== NumeriForge Reproducibility Report ===")\n\n        groups := make(map[string][]storage.IndexEntry)\n        for _, entry := range entries {\n                groups[entry.ExperimentName] = append(groups[entry.ExperimentName], entry)\n        }\n\n        names := make([]string, 0, len(groups))\n        for name := range groups {\n                names = append(names, name)\n        }\n        sort.Strings(names)\n\n        for _, name := range names {\n                group := groups[name]\n                earliest := group[0].Timestamp\n                latest := group[len(group)-1].Timestamp\n                fmt.Println("Experiment:", name, "("+strconv.Itoa(len(group))+" results)")\n                fmt.Println("Date range:", earliest.Format(time.RFC3339), "to", latest.Format(time.RFC3339))\n        }\n\n        envSet := make(map[string]bool)\n        for _, entry := range entries {\n                stored, err := store.Load(entry.ID)\n                if err != nil {\n                        envSet["unknown/unknown"] = true\n                        continue\n                }\n                osVal := stored.Metadata["env_os"]\n                if osVal == "" {\n                        osVal = "unknown"\n                }\n                archVal := stored.Metadata["env_arch"]\n                if archVal == "" {\n                        archVal = "unknown"\n                }\n                envSet[osVal+"/"+archVal] = true\n        }\n\n        fmt.Println("Environment summary:")\n        envKeys := make([]string, 0, len(envSet))\n        for key := range envSet {\n                envKeys = append(envKeys, key)\n        }\n        sort.Strings(envKeys)\n        if len(envKeys) == 0 {\n                fmt.Println("  none")\n        } else {\n                for _, key := range envKeys {\n                        fmt.Println("  " + key)\n                }\n        }\n\n        ok := 0\n        fail := 0\n        noChecksum := 0\n        for _, entry := range entries {\n                status, _, _, err := store.Verify(entry.ID)\n                if err != nil {\n                        fail++\n                        fmt.Fprintln(os.Stderr, "verify error:", entry.ID, err)\n                        continue\n                }\n                switch status {\n                case storage.StatusVerified:\n                        ok++\n                case storage.StatusCorrupted:\n                        fail++\n                case storage.StatusNoChecksum:\n                        noChecksum++\n                default:\n                        fail++\n                }\n        }\n\n        fmt.Println("Integrity summary:")\n        fmt.Println("  OK:", ok)\n        fmt.Println("  FAIL:", fail)\n        fmt.Println("  NO_CHECKSUM:", noChecksum)\n        fmt.Println("Report complete:", len(entries), "results across", len(names), "experiments")\n}\n\n\'\'\'\nmain = main.replace(\'func cmdAudit(args []string) {\', func + \'func cmdAudit(args []string) {\', 1)\n\nopen(\'main.go\', \'w\').write(main)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
