rr := storage.NewStore(storeDir)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "storage error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tentries, err := store.ListResults("")\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "storage error: %v\\n", err)\n\t\tos.Exit(1)\n\t}\n\n\tpassed := 0\n\tfailed := 0\n\ttotal := len(entries)\n\tfor _, entry := range entries {\n\t\tok, details := auditStoredResult(store, entry.ID)\n\t\tfmt.Print(details)\n\t\tif ok {\n\t\t\tpassed++\n\t\t} else {\n\t\t\tfailed++\n\t\t}\n\t}\n\n\tfmt.Printf("Audit Summary: %d passed, %d failed out of %d total\\n", passed, failed, total)\n\tif failed > 0 {\n\t\tos.Exit(1)\n\t}\n}\n\nfunc auditStoredResult(store *storage.Store, id string) (bool, string) {\n\tstored, err := store.Load(id)\n\tif err != nil {\n\t\treturn false, fmt.Sprintf("AUDIT_FAIL: %s (reason: load error: %v)\\n", id, err)\n\t}\n\n\twarnEnvMismatch(stored)\n\n\tstatus, expected, computed, err := store.Verify(id)\n\tif err != nil {\n\t\treturn false, fmt.Sprintf("AUDIT_FAIL: %s (reason: checksum verification error: %v)\\n", id, err)\n\t}\n\tif status == storage.StatusNoChecksum {\n\t\treturn false, fmt.Sprintf("AUDIT_FAIL: %s (reason: checksum missing)\\n", id)\n\t}\n\tif status == storage.StatusCorrupted {\n\t\treturn false, fmt.Sprintf("AUDIT_FAIL: %s (reason: checksum mismatch expected=%s computed=%s)\\n", id, expected, computed)\n\t}\n\n\tseedStr, ok := stored.Metadata["seed"]\n\tif !ok {\n\t\treturn false, fmt.Sprintf("AUDIT_FAIL: %s (reason: missing seed in metadata)\\n", id)\n\t}\n\tseed, err := strconv.ParseInt(seedStr, 10, 64)\n\tif err != nil {\n\t\treturn false, fmt.Sprintf("AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\\n", id, err)\n\t}\n\n\tfn, err := engine.Get(stored.ExperimentName)\n\tif err != nil {\n\t\treturn false, fmt.Sprintf("AUDIT_FAIL: %s (reason: experiment error: %v)\\n", id, err)\n\t}\n\n\trng := engine.NewRNG(seed)\n\treexec, err := fn(stored.ExperimentName, stored.Parameters, rng)\n\tif err != nil {\n\t\treturn false, fmt.Sprintf("AUDIT_FAIL: %s (reason: experiment error: %v)\\n", id, err)\n\t}\n\n\tmaxLen := len(stored.Values)\n\tif len(reexec.Values) > maxLen {\n\t\tmaxLen = len(reexec.Values)\n\t}\n\n\tvar mismatches []string\n\tfor i := 0; i < maxLen; i++ {\n\t\tstoredMissing := i >= len(stored.Values)\n\t\treexecMissing := i >= len(reexec.Values)\n\n\t\tvar storedVal, reexecVal string\n\t\tif storedMissing {\n\t\t\tstoredVal = "<missing>"\n\t\t} else {\n\t\t\tstoredVal = strconv.FormatFloat(stored.Values[i], \'g\', -1, 64)\n\t\t}\n\t\tif reexecMissing {\n\t\t\treexecVal = "<missing>"\n\t\t} else {\n\t\t\treexecVal = strconv.FormatFloat(reexec.Values[i], \'g\', -1, 64)\n\t\t}\n\n\t\tif storedMissing || reexecMissing || math.Float64bits(stored.Values[i]) != math.Float64bits(reexec.Values[i]) {\n\t\t\tmismatches = append(mismatches, fmt.Sprintf("  value[%d]: stored=%s, re-executed=%s", i, storedVal, reexecVal))\n\t\t}\n\t}\n\n\tif len(mismatches) == 0 {\n\t\treturn true, fmt.Sprintf("AUDIT_PASS: %s\\n", id)\n\t}\n\n\tvar sb strings.Builder\n\tsb.WriteString(fmt.Sprintf("AUDIT_FAIL: %s\\n", id))\n\tfor _, m := range mismatches {\n\t\tsb.WriteString(m)\n\t\tsb.WriteByte(\'\\n\')\n\t}\n\treturn false, sb.String()\n}\n\nfunc warnEnvMismatch(stored *storage.StoredResult) {\n\tmsg, ok := envMismatchWarning(stored.Metadata)\n\tif ok {\n\t\tfmt.Fprintln(os.Stderr, msg)\n\t}\n}\n\nfunc envMismatchWarning(metadata map[string]string) (string, bool) {\n\tcurrent := environmentMetadata()\n\tfields := []string{"env_go_version", "env_os", "env_arch", "env_hostname"}\n\n\tvar diffs []string\n\tfor _, field := range fields {\n\t\tif metadata[field] != current[field] {\n\t\t\tdiffs = append(diffs, fmt.Sprintf("%s stored=%q current=%q", field, metadata[field], current[field]))\n\t\t}\n\t}\n\n\tif len(diffs) == 0 {\n\t\treturn "", false\n\t}\n\treturn fmt.Sprintf("WARNING: ENV_MISMATCH (%s)", strings.Join(diffs, ", ")), true\n}\n\'\'\'\np.write_text(s)\nPY\n'] min_timeout_sec: 