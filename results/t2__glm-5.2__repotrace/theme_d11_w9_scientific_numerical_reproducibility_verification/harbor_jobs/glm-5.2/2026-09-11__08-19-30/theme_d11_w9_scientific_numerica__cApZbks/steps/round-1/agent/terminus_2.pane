[?2004lpackage compare

import (
	"fmt"
	"math"
	"strings"

	"numeriforge/storage"
)

// ComparisonMode determines how results are compared.
type ComparisonMode int

const (
	// ModeExact uses exact float equality (legacy, broken for scientific use).
	ModeExact ComparisonMode = iota
	// ModeTolerance uses configurable absolute and relative tolerance.
	// TODO: Implement tolerance-based comparison.
	ModeTolerance
)

// Tolerance defines comparison thresholds.
type Tolerance struct {
	Absolute float64
	Relative float64
}

// DefaultTolerance returns a reasonable default for scientific comparisons.
func DefaultTolerance() Tolerance {
	return Tolerance{
		Absolute: 1e-10,
		Relative: 1e-8,
	}
}

// ComparisonResult holds the outcome of comparing two experiment results.
type ComparisonResult struct {
	Match       bool
	TotalPairs  int
	MatchedPairs int
	Mismatches  []Mismatch
	Mode        ComparisonMode
	Summary     string
}

// Mismatch records a single value pair that didn't match.
type Mismatch struct {
	Index    int
	Label    string
	ValueA   float64
	ValueB   float64
	AbsDiff  float64
	RelDiff  float64
}

// Compare compares two stored results.
// Currently only supports ModeExact (legacy behavior).
// TODO: Implement ModeTolerance for proper scientific comparison.
func Compare(a, b *storage.StoredResult, mode ComparisonMode, tol Tolerance) *ComparisonResult {
	result := &ComparisonResult{
		Mode: mode,
	}

	if a.ExperimentName != b.ExperimentName {
		result.Match = false
		result.Summary = fmt.Sprintf("experiment name mismatch: %s vs %s", a.ExperimentName, b.ExperimentName)
		return result
	}

	minLen := len(a.Values)
	if len(b.Values) < minLen {
		minLen = len(b.Values)
	}

	if len(a.Values) != len(b.Values) {
		result.Match = false
		result.Summary = fmt.Sprintf("value count mismatch: %d vs %d", len(a.Values), len(b.Values))
		return result
	}

	result.TotalPairs = minLen

	switch mode {
	case ModeExact:
		result.Match = true
		for i := 0; i < minLen; i++ {
			label := fmt.Sprintf("value[%d]", i)
			if i < len(a.Labels) {
				label = a.Labels[i]
			}
			// Legacy: exact float equality comparison
			if a.Values[i] != b.Values[i] {
				result.Match = false
				result.Mismatches = append(result.Mismatches, Mismatch{
					Index:   i,
					Label:   label,
					ValueA:  a.Values[i],
					ValueB:  b.Values[i],
					AbsDiff: math.Abs(a.Values[i] - b.Values[i]),
					RelDiff: relDiff(a.Values[i], b.Values[i]),
				})
			} else {
				result.MatchedPairs++
			}
		}
	case ModeTolerance:
		// TODO: Implement tolerance-based comparison.
		// For each value pair, should check:
		// 1. If both values are zero (within absolute tolerance), they match.
		// 2. Otherwise, check both absolute and relative tolerance:
		//    |a - b| <= tol.Absolute  OR  |a - b| / max(|a|, |b|) <= tol.Relative
		// 3. Handle NaN and Inf specially: NaN matches NaN, Inf matches Inf.
		result.Match = false
		result.Summary = "tolerance comparison not yet implemented"
	}

	if result.Summary == "" {
		if result.Match {
			result.Summary = fmt.Sprintf("all %d value pairs match", result.TotalPairs)
		} else {
			result.Summary = fmt.Sprintf("%d of %d value pairs mismatch", len(result.Mismatches), result.TotalPairs)
		}
	}

	return result
}

// FormatReport generates a human-readable comparison report.
func FormatReport(cr *ComparisonResult) string {
	var sb strings.Builder
	sb.WriteString("=== Comparison Report ===\n")
	sb.WriteString(fmt.Sprintf("Mode: %s\n", modeString(cr.Mode)))
	sb.WriteString(fmt.Sprintf("Match: %v\n", cr.Match))
	sb.WriteString(fmt.Sprintf("Total pairs: %d\n", cr.TotalPairs))
	sb.WriteString(fmt.Sprintf("Matched: %d\n", cr.MatchedPairs))
	sb.WriteString(fmt.Sprintf("Summary: %s\n", cr.Summary))

	if len(cr.Mismatches) > 0 {
		sb.WriteString("\nMismatches:\n")
		for _, m := range cr.Mismatches {
			sb.WriteString(fmt.Sprintf("  [%d] %s: %.15e vs %.15e (abs=%.6e, rel=%.6e)\n",
				m.Index, m.Label, m.ValueA, m.ValueB, m.AbsDiff, m.RelDiff))
		}
	}

	return sb.String()
}

func relDiff(a, b float64) float64 {
	denom := math.Max(math.Abs(a), math.Abs(b))
	if denom < 1e-300 {
		return 0
	}
	return math.Abs(a-b) / denom
}

func modeString(m ComparisonMode) string {
	switch m {
	case ModeExact:
		return "exact"
	case ModeTolerance:
		return "tolerance"
	default:
		return "unknown"
	}
}
[?2004hroot@n30009:/app# sed -n '1,260p' config/config.go
[?2004lpackage config

import (
	"bufio"
	"fmt"
	"os"
	"strconv"
	"strings"

	"numeriforge/engine"
)

// Config represents parsed experiment configuration.
type Config struct {
	Experiment string
	OutputDir  string
	Params     []engine.Parameter
	Raw        map[string]string
}

// ParseINI reads a simple INI-style configuration file.
// Format:
//   experiment = mc-estimate-pi
//   output_dir = ./results
//   param.samples = 100000
//   param.lower_bound = 0.0
func ParseINI(path string) (*Config, error) {
	f, err := os.Open(path)
	if err != nil {
		return nil, fmt.Errorf("cannot open config: %w", err)
	}
	defer f.Close()

	cfg := &Config{
		Raw: make(map[string]string),
	}

	scanner := bufio.NewScanner(f)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, ";") {
			continue
		}

		parts := strings.SplitN(line, "=", 2)
		if len(parts) != 2 {
			continue
		}

		key := strings.TrimSpace(parts[0])
		value := strings.TrimSpace(parts[1])
		cfg.Raw[key] = value

		switch key {
		case "experiment":
			cfg.Experiment = value
		case "output_dir":
			cfg.OutputDir = value
		default:
			if strings.HasPrefix(key, "param.") {
				paramName := strings.TrimPrefix(key, "param.")
				paramValue, err := strconv.ParseFloat(value, 64)
				if err != nil {
					return nil, fmt.Errorf("invalid parameter value for %s: %s", paramName, value)
				}
				cfg.Params = append(cfg.Params, engine.Parameter{
					Name:  paramName,
					Value: paramValue,
				})
			}
		}
	}

	if err := scanner.Err(); err != nil {
		return nil, fmt.Errorf("read error: %w", err)
	}

	if cfg.Experiment == "" {
		return nil, fmt.Errorf("missing required field: experiment")
	}
	if cfg.OutputDir == "" {
		cfg.OutputDir = "./results"
	}

	return cfg, nil
}

// ParseParams converts a param string slice (key=value pairs) into Parameters.
func ParseParams(raw []string) ([]engine.Parameter, error) {
	var params []engine.Parameter
	for _, kv := range raw {
		parts := strings.SplitN(kv, "=", 2)
		if len(parts) != 2 {
			return nil, fmt.Errorf("invalid parameter: %s (expected key=value)", kv)
		}
		val, err := strconv.ParseFloat(parts[1], 64)
		if err != nil {
			return nil, fmt.Errorf("invalid parameter value for %s: %s", parts[0], parts[1])
		}
		params = append(params, engine.Parameter{Name: parts[0], Value: val})
	}
	return params, nil
}
[?2004hroot@n30009:/app# sed -n '1,260p' engine/engine.go
[?2004lpackage engine

import (
	"fmt"
	"math/rand"
	"time"
)

// ExperimentType enumerates supported experiment categories.
type ExperimentType string

const (
	TypeMonteCarlo ExperimentType = "montecarlo"
	TypeMatrix     ExperimentType = "matrix"
	TypeODE        ExperimentType = "ode"
	TypeStats      ExperimentType = "stats"
)

// Parameter holds a single experiment parameter.
type Parameter struct {
	Name  string
	Value float64
}

// Result holds raw experiment output.
type Result struct {
	ExperimentName string
	Timestamp      time.Time
	Parameters     []Parameter
	Values         []float64
	Labels         []string
	Metadata       map[string]string
}

// ExperimentFunc is the signature for all experiment backends.
// It takes a name, parameters, and returns a Result or error.
type ExperimentFunc func(name string, params []Parameter) (*Result, error)

// Global registry of experiment backends.
var registry = map[string]ExperimentFunc{}

// Global random source used by all experiments (legacy: not reproducible).
var GlobalRand = rand.New(rand.NewSource(time.Now().UnixNano()))

// Register adds an experiment backend to the registry.
func Register(name string, fn ExperimentFunc) {
	registry[name] = fn
}

// Get retrieves an experiment backend by name.
func Get(name string) (ExperimentFunc, error) {
	fn, ok := registry[name]
	if !ok {
		return nil, fmt.Errorf("unknown experiment: %s", name)
	}
	return fn, nil
}

// List returns all registered experiment names.
func List() []string {
	names := make([]string, 0, len(registry))
	for k := range registry {
		names = append(names, k)
	}
	return names
}

// GetParam finds a parameter by name, returning its value and whether it was found.
func GetParam(params []Parameter, name string) (float64, bool) {
	for _, p := range params {
		if p.Name == name {
			return p.Value, true
		}
	}
	return 0, false
}

// RequireParam finds a parameter by name or returns an error.
func RequireParam(params []Parameter, name string) (float64, error) {
	v, ok := GetParam(params, name)
	if !ok {
		return 0, fmt.Errorf("missing required parameter: %s", name)
	}
	return v, nil
}

func init() {
	registerMonteCarloExperiments()
	registerMatrixExperiments()
	registerODEExperiments()
	registerStatsExperiments()
}
