			i++
			if i < len(args) {
				storeDir = args[i]
			}
		case "--mode":
			i++
			if i < len(args) {
				switch args[i] {
				case "exact":
					mode = compare.ModeExact
				case "tolerance":
					mode = compare.ModeTolerance
				default:
					fmt.Fprintf(os.Stderr, "unknown comparison mode: %s\n", args[i])
					os.Exit(1)
				}
			}
