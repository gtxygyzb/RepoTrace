    16	// StoredResult is the on-disk representation of an experiment result.
    17	type StoredResult struct {
    18		ID             string             `json:"id"`
    19		ExperimentName string             `json:"experiment_name"`
    20		Timestamp      time.Time          `json:"timestamp"`
    21		Parameters     []engine.Parameter `json:"parameters"`
    22		Values         []float64          `json:"values"`
    23		Labels         []string           `json:"labels"`
    24		Metadata       map[string]string  `json:"metadata"`
    25		Checksum       string             `json:"checksum,omitempty"`
    26	}
    27	
    28	// VerifyStatus reports the outcome of integrity verification.
    29	type VerifyStatus string
    30	
    31	const (
    32		StatusVerified   VerifyStatus = "verified"
    33		StatusCorrupted  VerifyStatus = "corrupted"
    34		StatusNoChecksum VerifyStatus = "no_checksum"
    35	)
    36	
    37	// IndexEntry is a stored result index record.
    38	type IndexEntry struct {
    39		ID             string
    40		ExperimentName string
    41		Timestamp      time.Time
    42	}
    43	
    44	// Store manages experiment result persistence.
    45	type Store struct {
    46		BaseDir string
    47	}
    48	
    49	// NewStore creates a store at the given directory.
    50	func NewStore(baseDir string) (*Store, error) {
    51		if err := os.MkdirAll(baseDir, 0755); err != nil {
    52			return nil, fmt.Errorf("cannot create store directory: %w", err)
    53		}
    54		return &Store{BaseDir: baseDir}, nil
    55	}
    56	
    57	// ComputeChecksum returns the SHA-256 checksum of the canonical value
    58	// representation defined by the reproducibility specification.
    59	func ComputeChecksum(values []float64) string {
    60		var sb strings.Builder
    61		for i, v := range values {
    62			if i > 0 {
    63				sb.WriteByte('\n')
    64			}
    65			fmt.Fprintf(&sb, "%.17e", v)
    66		}
    67		sum := sha256.Sum256([]byte(sb.String()))
    68		return fmt.Sprintf("%x", sum)
    69	}
    70	
    71	// Save persists an experiment result to disk.
    72	func (s *Store) Save(result *engine.Result) (string, error) {
    73		id := fmt.Sprintf("%s_%s", result.ExperimentName, result.Timestamp.Format("20060102_150405"))
    74	
    75		checksum := ComputeChecksum(result.Values)
    76	
    77		if result.Metadata == nil {
    78			result.Metadata = map[string]string{}
    79		}
    80		result.Metadata["values_checksum"] = checksum
    81	
    82		stored := StoredResult{
    83			ID:             id,
    84			ExperimentName: result.ExperimentName,
    85			Timestamp:      result.Timestamp,
    86			Parameters:     result.Parameters,
    87			Values:         result.Values,
    88			Labels:         result.Labels,
    89			Metadata:       result.Metadata,
    90			Checksum:       checksum,
    91		}
    92	
    93		data, err := json.MarshalIndent(stored, "", "  ")
    94		if err != nil {
    95			return "", fmt.Errorf("marshal error: %w", err)
    96		}
    97	
    98		resultDir := filepath.Join(s.BaseDir, result.ExperimentName)
    99		if err := os.MkdirAll(resultDir, 0755); err != nil {
   100			return "", fmt.Errorf("cannot create result directory: %w", err)
   101		}
   102	
   103		path := filepath.Join(resultDir, id+".json")
   104		if err := os.WriteFile(path, data, 0644); err != nil {
   105			return "", fmt.Errorf("write error: %w", err)
   106		}
   107	
   108		if err := s.updateIndex(id, result.ExperimentName, result.Timestamp); err != nil {
   109			return "", fmt.Errorf("index update error: %w", err)
   110		}
   111	
   112		return id, nil
   113	}
   114	
   115	// Load reads a stored result by ID.
   116	func (s *Store) Load(id string) (*StoredResult, error) {
   117		var resultPath string
   118		err := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {
   119			if err != nil {
   120				return err
   121			}
   122			if !info.IsDir() && strings.TrimSuffix(info.Name(), ".json") == id {
   123				resultPath = path
   124				return filepath.SkipAll
   125			}
   126			return nil
   127		})
   128		if err != nil {
   129			return nil, err
   130		}
   131		if resultPath == "" {
   132			return nil, fmt.Errorf("result not found: %s", id)
   133		}
   134	
   135		data, err := os.ReadFile(resultPath)
   136		if err != nil {
   137			return nil, fmt.Errorf("read error: %w", err)
   138		}
   139	
   140		var stored StoredResult
   141		if err := json.Unmarshal(data, &stored); err != nil {
   142			return nil, fmt.Errorf("unmarshal error: %w", err)
   143		}
   144		return &stored, nil
   145	}
   146	
   147	// ListResults returns all stored result IDs, optionally filtered by experiment name.
   148	func (s *Store) ListResults(experimentFilter string) ([]IndexEntry, error) {
   149		entries, err := s.readIndex()
   150		if err != nil {
   151			return nil, err
   152		}
   153	
   154		if experimentFilter == "" {
   155			return entries, nil
   156		}
   157	
   158		filtered := make([]IndexEntry, 0)
   159		for _, entry := range entries {
   160			if entry.ExperimentName == experimentFilter {
   161				filtered = append(filtered, entry)
   162			}
   163		}
   164		return filtered, nil
   165	}
   166	
