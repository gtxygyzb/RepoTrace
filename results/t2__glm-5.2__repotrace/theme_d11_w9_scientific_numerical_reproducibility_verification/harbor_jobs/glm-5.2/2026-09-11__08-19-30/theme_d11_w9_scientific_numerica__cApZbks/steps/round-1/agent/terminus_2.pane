   265	func cmdCompare(args []string) {
   266		if len(args) < 2 {
   267			fmt.Fprintf(os.Stderr, "usage: numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\n")
   268			os.Exit(1)
   269		}
   270	
   271		id1 := args[0]
   272		id2 := args[1]
   273		storeDir := "./results"
   274		mode := "exact"
   275		tol := compare.DefaultTolerance()
   276	
   277		for i := 2; i < len(args); i++ {
   278			switch args[i] {
   279			case "--store-dir":
   280				i++
   281				if i >= len(args) {
   282					fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
   283					os.Exit(1)
   284				}
   285				storeDir = args[i]
   286			case "--mode":
   287				i++
   288				if i >= len(args) {
   289					fmt.Fprintf(os.Stderr, "error: --mode requires a value\n")
   290					os.Exit(1)
   291				}
   292				mode = args[i]
   293			case "--abs-tol":
   294				i++
   295				if i >= len(args) {
   296					fmt.Fprintf(os.Stderr, "error: --abs-tol requires a value\n")
   297					os.Exit(1)
   298				}
   299				v, err := strconv.ParseFloat(args[i], 64)
   300				if err != nil {
   301					fmt.Fprintf(os.Stderr, "error: invalid absolute tolerance: %v\n", err)
   302					os.Exit(1)
   303				}
   304				tol.Absolute = v
   305			case "--rel-tol":
   306				i++
   307				if i >= len(args) {
   308					fmt.Fprintf(os.Stderr, "error: --rel-tol requires a value\n")
   309					os.Exit(1)
   310				}
   311				v, err := strconv.ParseFloat(args[i], 64)
   312				if err != nil {
   313					fmt.Fprintf(os.Stderr, "error: invalid relative tolerance: %v\n", err)
   314					os.Exit(1)
   315				}
   316				tol.Relative = v
   317			default:
   318				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   319				os.Exit(1)
   320			}
   321		}
   322	
   323		store, err := storage.NewStore(storeDir)
   324		if err != nil {
   325			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   326			os.Exit(1)
   327		}
   328	
   329		a, err := store.Load(id1)
   330		if err != nil {
   331			fmt.Fprintf(os.Stderr, "load error: %v\n", err)
   332			os.Exit(1)
   333		}
   334	
   335		b, err := store.Load(id2)
   336		if err != nil {
   337			fmt.Fprintf(os.Stderr, "load error: %v\n", err)
   338			os.Exit(1)
   339		}
   340	
   341		var comparisonMode compare.ComparisonMode
   342		switch mode {
   343		case "exact":
   344			comparisonMode = compare.ModeExact
   345		case "tolerance":
   346			comparisonMode = compare.ModeTolerance
   347		default:
   348			fmt.Fprintf(os.Stderr, "error: invalid comparison mode: %s\n", mode)
   349			os.Exit(1)
   350		}
   351	
   352		cr := compare.Compare(a, b, comparisonMode, tol)
   353		fmt.Print(compare.FormatReport(cr))
   354	
   355		if cr.Match {
   356			os.Exit(0)
   357		} else {
   358			os.Exit(1)
   359		}
   360	}
