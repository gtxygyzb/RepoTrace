    91		sysIdx := int(sysIdxF)
    92		steps := int(stepsF)
    93	
    94		sysNames := []string{"exponential_decay", "harmonic_oscillator", "lorenz", "van_der_pol", "stiff_decay"}
    95		if sysIdx < 0 || sysIdx >= len(sysNames) {
    96			return nil, fmt.Errorf("system_index must be 0-%d, got %d", len(sysNames)-1, sysIdx)
    97		}
