   115	// tagsFromMetadata collects tag_<key> metadata entries into an export-friendly
   116	// map without the tag_ prefix. It returns nil when no tags are present.
   117	func tagsFromMetadata(metadata map[string]string) map[string]string {
   118		if metadata == nil {
   119			return nil
   120		}
   121		tags := map[string]string{}
   122		for k, v := range metadata {
   123			if strings.HasPrefix(k, "tag_") {
   124				tags[k[len("tag_"):]] = v
   125			}
   126		}
   127		if len(tags) == 0 {
   128			return nil
   129		}
   130		return tags
   131	}
   132	
   133	// parseTagFlag parses a --tag key=value argument and returns the metadata key
   134	// and value. It prints an error and exits when the argument is malformed.
   135	func parseTagFlag(arg string) (string, string) {
   136		parts := strings.SplitN(arg, "=", 2)
   137		if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
   138			fmt.Fprintf(os.Stderr, "error: invalid tag, expected key=value: %s\n", arg)
   139			os.Exit(1)
   140		}
   141		return "tag_" + parts[0], parts[1]
   142	}
   143	
   144	// hasMatchingTags reports whether metadata contains all requested tag filters.
   145	func hasMatchingTags(metadata map[string]string, tags map[string]string) bool {
   146		for k, v := range tags {
   147			if metadata["tag_"+k] != v {
   148				return false
   149			}
   150		}
   151		return true
   152	}
