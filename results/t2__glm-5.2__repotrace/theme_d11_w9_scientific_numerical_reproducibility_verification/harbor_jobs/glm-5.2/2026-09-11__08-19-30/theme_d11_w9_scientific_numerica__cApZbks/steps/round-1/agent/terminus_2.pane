    19	func usage() {
    20		fmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform
    21	
    22	Usage:
    23	  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]
    24	  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]
    25	  numeriforge list [--experiment <name>] [--store-dir <dir>]
    26	  numeriforge export <result_id> --store-dir <dir> [--format json|csv]
    27	  numeriforge verify <result_id> --store-dir <dir>
    28	  numeriforge audit <result_id> --store-dir <dir>
    29	
    30	Commands:
    31	  run       Run an experiment and store the result
    32	  compare   Compare two stored results
    33	  list      List stored experiment results
    34	  export    Export a result to a different format
    35	  verify    Verify result integrity
    36	  audit     Audit a stored result for reproducibility
    37	
    38	Available experiments:
    39	`)
    40		for _, name := range engine.List() {
    41			fmt.Fprintf(os.Stderr, "  %s\n", name)
    42		}
    43	}
    44	
    45	func main() {
    46		if len(os.Args) < 2 {
    47			usage()
    48			os.Exit(1)
    49		}
    50	
    51		cmd := os.Args[1]
    52	
    53		switch cmd {
    54		case "run":
    55			cmdRun(os.Args[2:])
    56		case "compare":
    57			cmdCompare(os.Args[2:])
    58		case "list":
    59			cmdList(os.Args[2:])
    60		case "export":
    61			cmdExport(os.Args[2:])
    62		case "verify":
    63			cmdVerify(os.Args[2:])
    64		case "audit":
    65			cmdAudit(os.Args[2:])
    66		case "help", "--help", "-h":
    67			usage()
    68		default:
    69			fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
    70			usage()
    71			os.Exit(1)
    72		}
    73	}
