    64		case "audit":
    65			cmdAudit(os.Args[2:])
    66		case "help", "--help", "-h":
    67			usage()
    68		default:
    69			fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
    70			usage()
    71			os.Exit(1)
    72		}
    73	}
