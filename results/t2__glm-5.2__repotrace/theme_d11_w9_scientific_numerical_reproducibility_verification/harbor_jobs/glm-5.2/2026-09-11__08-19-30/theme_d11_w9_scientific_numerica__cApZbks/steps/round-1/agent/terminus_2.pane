func cmdAuditAll(storeDir string) {
	store, err := storage.NewStore(storeDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	entries, err := store.ListResults("")
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	passed := 0
	failed := 0
	skipped := 0
	total := len(entries)
	for _, entry := range entries {
		status, details := auditStoredResult(store, entry.ID)
		fmt.Print(details)
		switch status {
		case auditPass:
			passed++
		case auditFail:
			failed++
		case auditSkip:
			skipped++
		}
	}

	fmt.Printf("Audit Summary: %d passed, %d failed, %d skipped out of %d total\n", passed, failed, skipped, total)
	if failed > 0 {
		os.Exit(1)
	}
}

type auditStatus int

const (
	auditPass auditStatus = iota
	auditFail
	auditSkip
)

func auditStoredResult(store *storage.Store, id string) (auditStatus, string) {
	stored, err := store.Load(id)
	if err != nil {
		return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: load error: %v)\n", id, err)
	}

	warnEnvMismatch(stored)

	var seed int64
	seedStr, ok := stored.Metadata["seed"]
	if !ok {
		if seedParam, ok := engine.GetParam(stored.Parameters, "seed"); ok {
			seed = int64(seedParam)
		} else {
			return auditSkip, fmt.Sprintf("AUDIT_SKIP: %s (no seed)\n", id)
		}
	} else {
		seed, err = strconv.ParseInt(seedStr, 10, 64)
		if err != nil {
			return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\n", id, err)
		}
	}

	status, expected, computed, err := store.Verify(id)
	if err != nil {
		return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check error: %v)\n", id, err)
	}
	if status == storage.StatusNoChecksum {
		return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check failed: no checksum)\n", id)
	}
	if status == storage.StatusCorrupted {
		return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check failed: expected=%s computed=%s)\n", id, expected, computed)
	}

	fn, err := engine.Get(stored.ExperimentName)
	if err != nil {
		return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: experiment error: %v)\n", id, err)
	}

	rng := engine.NewRNG(seed)
	reexec, err := fn(stored.ExperimentName, stored.Parameters, rng)
	if err != nil {
		return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: experiment error: %v)\n", id, err)
	}

