   105	
   106		// Store trajectory at regular intervals
   107		storeInterval := steps / 20
   108		if storeInterval < 1 {
   109			storeInterval = 1
   110		}
   111	
   112		allValues := []float64{}
   113		allLabels := []string{}
   114	
   115		for step := 0; step <= steps; step++ {
   116			if step%storeInterval == 0 || step == steps {
   117				allValues = append(allValues, t)
