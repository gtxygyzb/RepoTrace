   114	func cmdRun(args []string) {
   115		var experimentName, outputDir, configPath string
   116		var paramStrs []string
   117		var seed int64
   118		seedProvided := false
   119	
   120		for i := 0; i < len(args); i++ {
   121			switch args[i] {
   122			case "--experiment":
   123				i++
   124				if i >= len(args) {
   125					fmt.Fprintf(os.Stderr, "error: --experiment requires a value\n")
   126					os.Exit(1)
   127				}
   128				experimentName = args[i]
   129			case "--output-dir":
   130				i++
   131				if i >= len(args) {
   132					fmt.Fprintf(os.Stderr, "error: --output-dir requires a value\n")
   133					os.Exit(1)
   134				}
   135				outputDir = args[i]
   136			case "--config":
   137				i++
   138				if i >= len(args) {
   139					fmt.Fprintf(os.Stderr, "error: --config requires a value\n")
   140					os.Exit(1)
   141				}
   142				configPath = args[i]
   143			case "--param":
   144				i++
   145				if i >= len(args) {
   146					fmt.Fprintf(os.Stderr, "error: --param requires a value\n")
   147					os.Exit(1)
   148				}
   149				paramStrs = append(paramStrs, args[i])
   150			case "--seed":
   151				i++
   152				if i >= len(args) {
   153					fmt.Fprintf(os.Stderr, "error: --seed requires a value\n")
   154					os.Exit(1)
   155				}
   156				parsed, err := strconv.ParseInt(args[i], 10, 64)
   157				if err != nil {
   158					fmt.Fprintf(os.Stderr, "error: invalid seed: %v\n", err)
   159					os.Exit(1)
   160				}
   161				seed = parsed
   162				seedProvided = true
   163			default:
   164				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   165				os.Exit(1)
   166			}
   167		}
   168	
   169		if configPath != "" {
   170			cfg, err := config.ParseINI(configPath)
   171			if err != nil {
   172				fmt.Fprintf(os.Stderr, "config error: %v\n", err)
   173				os.Exit(1)
   174			}
   175			if experimentName == "" {
   176				experimentName = cfg.Experiment
   177			}
   178			if outputDir == "" {
   179				outputDir = cfg.OutputDir
   180			}
   181	
   182			cliParams, _ := config.ParseParams(paramStrs)
   183			cliParamMap := make(map[string]float64)
   184			for _, p := range cliParams {
   185				cliParamMap[p.Name] = p.Value
   186			}
   187			for _, p := range cfg.Params {
   188				if _, exists := cliParamMap[p.Name]; !exists {
   189					cliParams = append(cliParams, p)
   190				}
   191			}
   192			paramStrs = nil
   193			for _, p := range cliParams {
   194				paramStrs = append(paramStrs, fmt.Sprintf("%s=%g", p.Name, p.Value))
   195			}
   196		}
   197	
   198		if experimentName == "" {
   199			fmt.Fprintf(os.Stderr, "error: --experiment is required\n")
   200			os.Exit(1)
   201		}
   202		if outputDir == "" {
   203			outputDir = "./results"
   204		}
   205	
   206		params, err := config.ParseParams(paramStrs)
   207		if err != nil {
   208			fmt.Fprintf(os.Stderr, "parameter error: %v\n", err)
   209			os.Exit(1)
   210		}
   211	
   212		fn, err := engine.Get(experimentName)
   213		if err != nil {
   214			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   215			os.Exit(1)
   216		}
   217	
   218		if !seedProvided {
   219			seed = time.Now().UnixNano()
   220		}
