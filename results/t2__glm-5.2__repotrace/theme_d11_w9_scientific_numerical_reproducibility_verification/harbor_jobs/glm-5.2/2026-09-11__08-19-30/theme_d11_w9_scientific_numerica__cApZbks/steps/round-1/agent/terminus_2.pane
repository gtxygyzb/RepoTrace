     8	
     9	// ExperimentType enumerates supported experiment categories.
    10	type ExperimentType string
    11	
    12	const (
    13		TypeMonteCarlo ExperimentType = "montecarlo"
    14		TypeMatrix     ExperimentType = "matrix"
    15		TypeODE        ExperimentType = "ode"
    16		TypeStats      ExperimentType = "stats"
    17	)
    18	
    19	// Parameter holds a single experiment parameter.
    20	type Parameter struct {
    21		Name  string
    22		Value float64
    23	}
    24	
    25	// Result holds raw experiment output.
    26	type Result struct {
    27		ExperimentName string
    28		Timestamp      time.Time
    29		Parameters     []Parameter
    30		Values         []float64
    31		Labels         []string
    32		Metadata       map[string]string
    33	}
    34	
    35	// ExperimentFunc is the signature for all experiment backends.
    36	// It takes a name, parameters, and returns a Result or error.
    37	type ExperimentFunc func(name string, params []Parameter, rng RNG) (*Result, error)
    38	
    39	// Global registry of experiment backends.
    40	var registry = map[string]ExperimentFunc{}
    41	
    42	// RNG is an isolated random number generator type for experiment backends.
    43	type RNG = *rand.Rand
    44	
    45	// NewRNG creates an isolated random source for a single experiment invocation.
    46	func NewRNG(seed int64) RNG {
    47		return rand.New(rand.NewSource(seed))
    48	}
    49	
    50	// Register adds an experiment backend to the registry.
    51	func Register(name string, fn ExperimentFunc) {
    52		registry[name] = fn
    53	}
    54	
    55	// Get retrieves an experiment backend by name.
    56	func Get(name string) (ExperimentFunc, error) {
    57		fn, ok := registry[name]
    58		if !ok {
    59			return nil, fmt.Errorf("unknown experiment: %s", name)
    60		}
    61		return fn, nil
    62	}
    63	
    64	// List returns all registered experiment names.
    65	func List() []string {
    66		names := make([]string, 0, len(registry))
    67		for k := range registry {
    68			names = append(names, k)
    69		}
    70		return names
    71	}
    72	
    73	// GetParam finds a parameter by name, returning its value and whether it was found.
    74	func GetParam(params []Parameter, name string) (float64, bool) {
    75		for _, p := range params {
    76			if p.Name == name {
    77				return p.Value, true
    78			}
    79		}
    80		return 0, false
    81	}
    82	
    83	// RequireParam finds a parameter by name or returns an error.
    84	func RequireParam(params []Parameter, name string) (float64, error) {
    85		v, ok := GetParam(params, name)
    86		if !ok {
    87			return 0, fmt.Errorf("missing required parameter: %s", name)
    88		}
    89		return v, nil
    90	}
    91	
