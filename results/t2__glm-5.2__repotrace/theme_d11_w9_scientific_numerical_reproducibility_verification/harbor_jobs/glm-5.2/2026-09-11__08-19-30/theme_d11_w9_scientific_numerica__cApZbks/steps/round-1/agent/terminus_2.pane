func usage() {
	fmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform

Usage:
  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]
  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]
  numeriforge list [--experiment <name>] [--store-dir <dir>]
  numeriforge export <result_id> --store-dir <dir> [--format json|csv]
  numeriforge verify <result_id> --store-dir <dir> [--verbose]
  numeriforge audit <result_id> --store-dir <dir>
  numeriforge audit --all --store-dir <dir>

Commands:
  run       Run an experiment and store the result
  compare   Compare two stored results
  list      List stored experiment results
  export    Export a result to a different format
  verify    Verify result integrity
  audit     Audit stored result(s) for reproducibility

Available experiments:
`)
	for _, name := range engine.List() {
		fmt.Fprintf(os.Stderr, "  %s\n", name)
	}
}

func main() {
	if len(os.Args) < 2 {
		usage()
		os.Exit(1)
	}

	cmd := os.Args[1]

	switch cmd {
	case "run":
		cmdRun(os.Args[2:])
	case "compare":
		cmdCompare(os.Args[2:])
	case "list":
		cmdList(os.Args[2:])
	case "export":
		cmdExport(os.Args[2:])
	case "verify":
		cmdVerify(os.Args[2:])
	case "audit":
		cmdAudit(os.Args[2:])
	case "help", "--help", "-h":
		usage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
		usage()
		os.Exit(1)
	}
}

// environmentMetadata returns the environment fingerprint metadata required for
// reproducible experiment traces.
func environmentMetadata() map[string]string {
	hostname, err := os.Hostname()
	if err != nil {
		hostname = "unknown"
	}
	return map[string]string{
		"env_go_version": runtime.Version(),
		"env_os":         runtime.GOOS,
		"env_arch":       runtime.GOARCH,
		"env_hostname":   hostname,
	}
}

// environmentFromMetadata aggregates stored environment fingerprint metadata
// into an export-friendly object.
type environmentInfo struct {
	GoVersion string `json:"go_version"`
	OS        string `json:"os"`
	Arch      string `json:"arch"`
	Hostname  string `json:"hostname"`
}

func environmentFromMetadata(metadata map[string]string) environmentInfo {
	return environmentInfo{
		GoVersion: metadata["env_go_version"],
		OS:        metadata["env_os"],
		Arch:      metadata["env_arch"],
		Hostname:  metadata["env_hostname"],
	}
}

type exportPayload struct {
	*storage.StoredResult
	Environment environmentInfo   `json:"environment"`
	Tags        map[string]string `json:"tags,omitempty"`
}

// tagsFromMetadata collects tag_<key> metadata entries into an export-friendly
// map without the tag_ prefix. It returns nil when no tags are present.
func tagsFromMetadata(metadata map[string]string) map[string]string {
	if metadata == nil {
		return nil
	}
	tags := map[string]string{}
	for k, v := range metadata {
		if strings.HasPrefix(k, "tag_") {
			tags[k[len("tag_"):]] = v
		}
	}
	if len(tags) == 0 {
		return nil
	}
	return tags
}

// parseTagFlag parses a --tag key=value argument and returns the metadata key
// and value. It prints an error and exits when the argument is malformed.
func parseTagFlag(arg string) (string, string) {
	parts := strings.SplitN(arg, "=", 2)
	if len(parts) != 2 || parts[0] == "" {
		fmt.Fprintf(os.Stderr, "error: invalid tag, expected key=value: %s\n", arg)
		os.Exit(1)
	}
	return "tag_" + parts[0], parts[1]
}

// hasMatchingTags reports whether metadata contains all requested tag filters.
func hasMatchingTags(metadata map[string]string, tags map[string]string) bool {
	for k, v := range tags {
		if metadata["tag_"+k] != v {
			return false
		}
	}
	return true
}

func cmdRun(args []string) {
	var experimentName, outputDir, configPath string
	var paramStrs []string
	var tagStrs []string
	var seed int64
	seedProvided := false

	for i := 0; i < len(args); i++ {
		switch args[i] {
		case "--experiment":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --experiment requires a value\n")
				os.Exit(1)
			}
			experimentName = args[i]
		case "--output-dir":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --output-dir requires a value\n")
				os.Exit(1)
			}
			outputDir = args[i]
		case "--config":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --config requires a value\n")
				os.Exit(1)
			}
			configPath = args[i]
		case "--param":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --param requires a value\n")
				os.Exit(1)
			}
			paramStrs = append(paramStrs, args[i])
		case "--seed":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --seed requires a value\n")
				os.Exit(1)
			}
			parsed, err := strconv.ParseInt(args[i], 10, 64)
			if err != nil {
				fmt.Fprintf(os.Stderr, "error: invalid seed: %v\n", err)
				os.Exit(1)
			}
			seed = parsed
			seedProvided = true
		case "--tag":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --tag requires a value\n")
				os.Exit(1)
			}
			tagStrs = append(tagStrs, args[i])
		default:
			fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
			os.Exit(1)
		}
	}

	if configPath != "" {
		cfg, err := config.ParseINI(configPath)
		if err != nil {
			fmt.Fprintf(os.Stderr, "config error: %v\n", err)
			os.Exit(1)
		}
		if experimentName == "" {
			experimentName = cfg.Experiment
		}
		if outputDir == "" {
			outputDir = cfg.OutputDir
		}

		cliParams, _ := config.ParseParams(paramStrs)
		cliParamMap := make(map[string]float64)
		for _, p := range cliParams {
			cliParamMap[p.Name] = p.Value
		}
		for _, p := range cfg.Params {
			if _, exists := cliParamMap[p.Name]; !exists {
				cliParams = append(cliParams, p)
			}
		}
		paramStrs = nil
		for _, p := range cliParams {
			paramStrs = append(paramStrs, fmt.Sprintf("%s=%g", p.Name, p.Value))
		}
	}

	if experimentName == "" {
		fmt.Fprintf(os.Stderr, "error: --experiment is required\n")
		os.Exit(1)
	}
	if outputDir == "" {
		outputDir = "./results"
	}

	params, err := config.ParseParams(paramStrs)
	if err != nil {
		fmt.Fprintf(os.Stderr, "parameter error: %v\n", err)
		os.Exit(1)
	}

	fn, err := engine.Get(experimentName)
