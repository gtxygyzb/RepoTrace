func cmdExport(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: numeriforge export <id> --store-dir <dir> [--format json|csv|markdown]\n")
		os.Exit(1)
	}

	id := args[0]
	storeDir := "./results"
	format := "json"

	for i := 1; i < len(args); i++ {
		switch args[i] {
		case "--store-dir":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
				os.Exit(1)
			}
			storeDir = args[i]
		case "--format":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --format requires a value\n")
				os.Exit(1)
			}
			format = args[i]
		default:
			fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
			os.Exit(1)
		}
	}

	store, err := storage.NewStore(storeDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	result, err := store.Load(id)
	if err != nil {
		fmt.Fprintf(os.Stderr, "load error: %v\n", err)
		os.Exit(1)
	}

	switch format {
	case "json":
		payload := exportPayload{
			StoredResult: result,
			Environment:  environmentFromMetadata(result.Metadata),
			Tags:         tagsFromMetadata(result.Metadata),
		}
		data, err := json.MarshalIndent(payload, "", "  ")
		if err != nil {
			fmt.Fprintf(os.Stderr, "marshal error: %v\n", err)
			os.Exit(1)
		}
		fmt.Println(string(data))
	case "csv":
		fmt.Printf("# id: %s\n", result.ID)
		fmt.Printf("# experiment: %s\n", result.ExperimentName)
		fmt.Printf("# timestamp: %s\n", result.Timestamp.Format("2006-01-02 15:04:05"))
		if seed, ok := result.Metadata["seed"]; ok {
			fmt.Printf("# seed: %s\n", seed)
		}
		fmt.Println("label,value")
		for i, v := range result.Values {
			label := fmt.Sprintf("value_%d", i)
			if i < len(result.Labels) {
				label = result.Labels[i]
			}
			fmt.Printf("%s,%.15e\n", label, v)
		}
	case "markdown":
		fmt.Printf("# %s (%s)\n", result.ExperimentName, result.ID)
		fmt.Println()
		fmt.Println("## Metadata")
		fmt.Printf("- timestamp: %s\n", result.Timestamp.Format("2006-01-02 15:04:05"))
		if seed, ok := result.Metadata["seed"]; ok {
			fmt.Printf("- seed: %s\n", seed)
		} else {
			fmt.Println("- seed: ")
		}
		fmt.Printf("- go_version: %s\n", metadataOrDefault(result.Metadata, "env_go_version", "unknown"))
		fmt.Printf("- os: %s\n", metadataOrDefault(result.Metadata, "env_os", "unknown"))
		fmt.Printf("- arch: %s\n", metadataOrDefault(result.Metadata, "env_arch", "unknown"))
		fmt.Printf("- hostname: %s\n", metadataOrDefault(result.Metadata, "env_hostname", "unknown"))
		fmt.Println()
		fmt.Println("## Results")
		fmt.Println("| Label | Value |")
		fmt.Println("|---|---|")
		for i, v := range result.Values {
			label := fmt.Sprintf("value_%d", i)
			if i < len(result.Labels) {
				label = result.Labels[i]
			}
			fmt.Printf("| %s | %.15g |\n", label, v)
		}
	default:
		fmt.Fprintf(os.Stderr, "unknown format: %s\n", format)
		os.Exit(1)
	}
}

func metadataOrDefault(metadata map[string]string, key, fallback string) string {
	if value, ok := metadata[key]; ok && value != "" {
		return value
	}
	return fallback
}

func cmdVerify(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\n")
		os.Exit(1)
	}

	id := args[0]
	storeDir := "./results"
	verbose := false

	for i := 1; i < len(args); i++ {
		switch args[i] {
		case "--verbose":
			verbose = true
		case "--store-dir":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
				os.Exit(1)
			}
			storeDir = args[i]
		default:
			fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
			os.Exit(1)
		}
	}

	store, err := storage.NewStore(storeDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	status, expected, computed, err := store.Verify(id)
	if err != nil {
		fmt.Fprintf(os.Stderr, "verify error: %v\n", err)
		os.Exit(1)
	}

	switch status {
	case storage.StatusVerified:
		fmt.Printf("INTEGRITY_OK: %s\n", id)
		if verbose {
			fmt.Printf("Stored checksum: %s\n", expected)
			fmt.Printf("Computed checksum: %s\n", computed)
		}
		os.Exit(0)
	case storage.StatusCorrupted:
		fmt.Printf("INTEGRITY_FAIL: %s\n", id)
		if verbose {
			fmt.Printf("Stored checksum: %s\n", expected)
			fmt.Printf("Computed checksum: %s\n", computed)
		}
		os.Exit(1)
	case storage.StatusNoChecksum:
		fmt.Printf("NO_CHECKSUM: %s\n", id)
		os.Exit(2)
	default:
		fmt.Fprintf(os.Stderr, "unknown verification status: %s\n", status)
		os.Exit(1)
	}
}
func cmdAudit(args []string) {
	all := false
	var positionals []string
	storeDir := "./results"

	for i := 0; i < len(args); i++ {
		switch args[i] {
		case "--all":
			all = true
		case "--store-dir":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
				os.Exit(1)
			}
			storeDir = args[i]
		default:
			if strings.HasPrefix(args[i], "-") {
				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
				os.Exit(1)
			}
			positionals = append(positionals, args[i])
		}
	}

	if all {
		if len(positionals) != 0 {
			fmt.Fprintf(os.Stderr, "error: --all does not accept result IDs\n")
			os.Exit(1)
		}
		cmdAuditAll(storeDir)
		return
	}

	if len(positionals) < 1 {
		fmt.Fprintf(os.Stderr, "usage: numeriforge audit <result_id> --store-dir <dir>\n")
		fmt.Fprintf(os.Stderr, "       numeriforge audit --all --store-dir <dir>\n")
		os.Exit(1)
	}
	if len(positionals) > 1 {
		fmt.Fprintf(os.Stderr, "error: too many arguments\n")
		os.Exit(1)
	}

	store, err := storage.NewStore(storeDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	status, details := auditStoredResult(store, positionals[0])
	fmt.Print(details)
	if status == auditFail {
		os.Exit(1)
	}
}

func cmdAuditAll(storeDir string) {
	store, err := storage.NewStore(storeDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	entries, err := store.ListResults("")
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	passed := 0
	failed := 0
	skipped := 0
	total := len(entries)
	for _, entry := range entries {
		status, details := auditStoredResult(store, entry.ID)
		fmt.Print(details)
		switch status {
		case auditPass:
			passed++
		case auditFail:
			failed++
		case auditSkip:
			skipped++
		}
	}

	fmt.Printf("Audit Summary: %d passed, %d failed, %d skipped out of %d total\n", passed, failed, skipped, total)
	if failed > 0 {
		os.Exit(1)
	}
}

type auditStatus int

const (
[?2004hroot@n30009:/app# sed -n '1,260p' storage/storage.go
[?2004lpackage storage

import (
	"crypto/sha256"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"strings"
	"time"

	"numeriforge/engine"
)

// StoredResult is the on-disk representation of an experiment result.
type StoredResult struct {
	ID             string             `json:"id"`
	ExperimentName string             `json:"experiment_name"`
	Timestamp      time.Time          `json:"timestamp"`
	Parameters     []engine.Parameter `json:"parameters"`
	Values         []float64          `json:"values"`
	Labels         []string           `json:"labels"`
	Metadata       map[string]string  `json:"metadata"`
	Checksum       string             `json:"checksum,omitempty"`
}

// VerifyStatus reports the outcome of integrity verification.
type VerifyStatus string

const (
	StatusVerified   VerifyStatus = "verified"
	StatusCorrupted  VerifyStatus = "corrupted"
	StatusNoChecksum VerifyStatus = "no_checksum"
)

// IndexEntry is a stored result index record.
type IndexEntry struct {
	ID             string
	ExperimentName string
	Timestamp      time.Time
}

// Store manages experiment result persistence.
type Store struct {
	BaseDir string
}

// NewStore creates a store at the given directory.
func NewStore(baseDir string) (*Store, error) {
	if err := os.MkdirAll(baseDir, 0755); err != nil {
		return nil, fmt.Errorf("cannot create store directory: %w", err)
	}
	return &Store{BaseDir: baseDir}, nil
}

// ComputeChecksum returns the SHA-256 checksum of the canonical value
// representation defined by the reproducibility specification.
func ComputeChecksum(values []float64) string {
	var sb strings.Builder
	for i, v := range values {
		if i > 0 {
			sb.WriteByte('\n')
		}
		fmt.Fprintf(&sb, "%.17e", v)
	}
	sum := sha256.Sum256([]byte(sb.String()))
	return fmt.Sprintf("%x", sum)
}

// Save persists an experiment result to disk.
func (s *Store) Save(result *engine.Result) (string, error) {
	id := fmt.Sprintf("%s_%s", result.ExperimentName, result.Timestamp.Format("20060102_150405"))

	checksum := ComputeChecksum(result.Values)

	if result.Metadata == nil {
		result.Metadata = map[string]string{}
	}
	result.Metadata["values_checksum"] = checksum

	stored := StoredResult{
		ID:             id,
		ExperimentName: result.ExperimentName,
		Timestamp:      result.Timestamp,
		Parameters:     result.Parameters,
		Values:         result.Values,
		Labels:         result.Labels,
		Metadata:       result.Metadata,
		Checksum:       checksum,
	}

	data, err := json.MarshalIndent(stored, "", "  ")
	if err != nil {
		return "", fmt.Errorf("marshal error: %w", err)
	}

	resultDir := filepath.Join(s.BaseDir, result.ExperimentName)
	if err := os.MkdirAll(resultDir, 0755); err != nil {
		return "", fmt.Errorf("cannot create result directory: %w", err)
	}

	path := filepath.Join(resultDir, id+".json")
	if err := os.WriteFile(path, data, 0644); err != nil {
		return "", fmt.Errorf("write error: %w", err)
	}

	if err := s.updateIndex(id, result.ExperimentName, result.Timestamp); err != nil {
		return "", fmt.Errorf("index update error: %w", err)
	}

	return id, nil
}

// Load reads a stored result by ID.
func (s *Store) Load(id string) (*StoredResult, error) {
	var resultPath string
	err := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {
		if err != nil {
			return err
		}
		if !info.IsDir() && strings.TrimSuffix(info.Name(), ".json") == id {
			resultPath = path
			return filepath.SkipAll
		}
		return nil
	})
	if err != nil {
		return nil, err
	}
	if resultPath == "" {
		return nil, fmt.Errorf("result not found: %s", id)
	}

	data, err := os.ReadFile(resultPath)
	if err != nil {
		return nil, fmt.Errorf("read error: %w", err)
	}

	var stored StoredResult
	if err := json.Unmarshal(data, &stored); err != nil {
		return nil, fmt.Errorf("unmarshal error: %w", err)
	}
	return &stored, nil
}

// ListResults returns all stored result IDs, optionally filtered by experiment name.
func (s *Store) ListResults(experimentFilter string) ([]IndexEntry, error) {
	entries, err := s.readIndex()
	if err != nil {
		return nil, err
	}

	if experimentFilter == "" {
		return entries, nil
	}

	filtered := make([]IndexEntry, 0)
	for _, entry := range entries {
		if entry.ExperimentName == experimentFilter {
			filtered = append(filtered, entry)
		}
	}
	return filtered, nil
}

// Verify checks stored result integrity by recomputing the canonical checksum.
func (s *Store) Verify(id string) (VerifyStatus, string, string, error) {
	stored, err := s.Load(id)
	if err != nil {
		return "", "", "", err
	}

	if stored.Checksum == "" {
		return StatusNoChecksum, "", "", nil
	}

	computed := ComputeChecksum(stored.Values)
	if computed == stored.Checksum {
		return StatusVerified, stored.Checksum, computed, nil
	}
	return StatusCorrupted, stored.Checksum, computed, nil
}

func (s *Store) indexPath() string {
	return filepath.Join(s.BaseDir, "index.txt")
}

func (s *Store) updateIndex(id, experimentName string, timestamp time.Time) error {
	if err := os.MkdirAll(s.BaseDir, 0755); err != nil {
		return err
	}

	f, err := os.OpenFile(s.indexPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
	if err != nil {
		return err
	}
	defer f.Close()

	_, err = fmt.Fprintf(f, "%s|%s|%s\n", id, experimentName, timestamp.Format(time.RFC3339))
	return err
}

func (s *Store) readIndex() ([]IndexEntry, error) {
	data, err := os.ReadFile(s.indexPath())
	if err != nil {
		if os.IsNotExist(err) {
			return nil, nil
		}
		return nil, err
	}

	var entries []IndexEntry
	for _, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
		if line == "" {
			continue
		}
		parts := strings.SplitN(line, "|", 3)
		if len(parts) != 3 {
			continue
		}
		ts, _ := time.Parse(time.RFC3339, parts[2])
		entries = append(entries, IndexEntry{
			ID:             parts[0],
			ExperimentName: parts[1],
			Timestamp:      ts,
		})
	}

	sort.Slice(entries, func(i, j int) bool {
		return entries[i].Timestamp.Before(entries[j].Timestamp)
	})

	return entries, nil
}
