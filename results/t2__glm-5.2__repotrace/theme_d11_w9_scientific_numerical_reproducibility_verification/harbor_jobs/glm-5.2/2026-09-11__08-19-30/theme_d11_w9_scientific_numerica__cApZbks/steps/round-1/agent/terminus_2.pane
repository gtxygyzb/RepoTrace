    47		if len(os.Args) < 2 {
    48			usage()
    49			os.Exit(1)
    50		}
    51	
    52		cmd := os.Args[1]
    53	
    54		switch cmd {
    55		case "run":
    56			cmdRun(os.Args[2:])
    57		case "compare":
    58			cmdCompare(os.Args[2:])
    59		case "list":
    60			cmdList(os.Args[2:])
    61		case "export":
    62			cmdExport(os.Args[2:])
    63		case "verify":
    64			cmdVerify(os.Args[2:])
    65		case "audit":
    66			cmdAudit(os.Args[2:])
    67		case "help", "--help", "-h":
    68			usage()
    69		default:
    70			fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
    71			usage()
    72			os.Exit(1)
    73		}
    74	}
    75	
    76	// environmentMetadata returns the environment fingerprint metadata required for
    77	// reproducible experiment traces.
    78	func environmentMetadata() map[string]string {
    79		hostname, err := os.Hostname()
    80		if err != nil {
    81			hostname = "unknown"
    82		}
    83		return map[string]string{
    84			"env_go_version": runtime.Version(),
    85			"env_os":         runtime.GOOS,
    86			"env_arch":       runtime.GOARCH,
    87			"env_hostname":   hostname,
    88		}
    89	}
    90	
    91	// environmentFromMetadata aggregates stored environment fingerprint metadata
    92	// into an export-friendly object.
    93	type environmentInfo struct {
    94		GoVersion string `json:"go_version"`
    95		OS        string `json:"os"`
    96		Arch      string `json:"arch"`
    97		Hostname  string `json:"hostname"`
    98	}
    99	
   100	func environmentFromMetadata(metadata map[string]string) environmentInfo {
   101		return environmentInfo{
   102			GoVersion: metadata["env_go_version"],
   103			OS:        metadata["env_os"],
   104			Arch:      metadata["env_arch"],
   105			Hostname:  metadata["env_hostname"],
   106		}
   107	}
   108	
   109	type exportPayload struct {
   110		*storage.StoredResult
   111		Environment environmentInfo   `json:"environment"`
   112		Tags        map[string]string `json:"tags,omitempty"`
   113	}
   114	
   115	// tagsFromMetadata collects tag_<key> metadata entries into an export-friendly
   116	// map without the tag_ prefix. It returns nil when no tags are present.
   117	func tagsFromMetadata(metadata map[string]string) map[string]string {
   118		if metadata == nil {
   119			return nil
   120		}
   121		tags := map[string]string{}
   122		for k, v := range metadata {
   123			if strings.HasPrefix(k, "tag_") {
   124				tags[k[len("tag_"):]] = v
   125			}
   126		}
   127		if len(tags) == 0 {
   128			return nil
   129		}
   130		return tags
   131	}
   132	
   133	// parseTagFlag parses a --tag key=value argument and returns the metadata key
   134	// and value. It prints an error and exits when the argument is malformed.
   135	func parseTagFlag(arg string) (string, string) {
   136		parts := strings.SplitN(arg, "=", 2)
   137		if len(parts) != 2 || parts[0] == "" {
   138			fmt.Fprintf(os.Stderr, "error: invalid tag, expected key=value: %s\n", arg)
   139			os.Exit(1)
   140		}
   141		return "tag_" + parts[0], parts[1]
   142	}
   143	
   144	// hasMatchingTags reports whether metadata contains all requested tag filters.
   145	func hasMatchingTags(metadata map[string]string, tags map[string]string) bool {
   146		for k, v := range tags {
   147			if metadata["tag_"+k] != v {
   148				return false
   149			}
   150		}
   151		return true
   152	}
   153	
   154	func cmdRun(args []string) {
   155		var experimentName, outputDir, configPath string
   156		var paramStrs []string
   157		var tagStrs []string
   158		var seed int64
   159		seedProvided := false
   160	
   161		for i := 0; i < len(args); i++ {
   162			switch args[i] {
   163			case "--experiment":
   164				i++
   165				if i >= len(args) {
   166					fmt.Fprintf(os.Stderr, "error: --experiment requires a value\n")
   167					os.Exit(1)
   168				}
   169				experimentName = args[i]
   170			case "--output-dir":
   171				i++
   172				if i >= len(args) {
   173					fmt.Fprintf(os.Stderr, "error: --output-dir requires a value\n")
   174					os.Exit(1)
   175				}
   176				outputDir = args[i]
   177			case "--config":
   178				i++
   179				if i >= len(args) {
   180					fmt.Fprintf(os.Stderr, "error: --config requires a value\n")
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '181,360p'
[?2004l   181					os.Exit(1)
   182				}
   183				configPath = args[i]
   184			case "--param":
   185				i++
   186				if i >= len(args) {
   187					fmt.Fprintf(os.Stderr, "error: --param requires a value\n")
   188					os.Exit(1)
   189				}
   190				paramStrs = append(paramStrs, args[i])
   191			case "--seed":
   192				i++
   193				if i >= len(args) {
   194					fmt.Fprintf(os.Stderr, "error: --seed requires a value\n")
   195					os.Exit(1)
   196				}
   197				parsed, err := strconv.ParseInt(args[i], 10, 64)
   198				if err != nil {
   199					fmt.Fprintf(os.Stderr, "error: invalid seed: %v\n", err)
   200					os.Exit(1)
   201				}
   202				seed = parsed
   203				seedProvided = true
   204			case "--tag":
   205				i++
   206				if i >= len(args) {
   207					fmt.Fprintf(os.Stderr, "error: --tag requires a value\n")
   208					os.Exit(1)
   209				}
   210				tagStrs = append(tagStrs, args[i])
   211			default:
   212				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   213				os.Exit(1)
   214			}
   215		}
   216	
   217		if configPath != "" {
   218			cfg, err := config.ParseINI(configPath)
   219			if err != nil {
   220				fmt.Fprintf(os.Stderr, "config error: %v\n", err)
   221				os.Exit(1)
   222			}
   223			if experimentName == "" {
   224				experimentName = cfg.Experiment
   225			}
   226			if outputDir == "" {
   227				outputDir = cfg.OutputDir
   228			}
   229	
   230			cliParams, _ := config.ParseParams(paramStrs)
   231			cliParamMap := make(map[string]float64)
   232			for _, p := range cliParams {
   233				cliParamMap[p.Name] = p.Value
   234			}
   235			for _, p := range cfg.Params {
   236				if _, exists := cliParamMap[p.Name]; !exists {
   237					cliParams = append(cliParams, p)
   238				}
   239			}
   240			paramStrs = nil
   241			for _, p := range cliParams {
   242				paramStrs = append(paramStrs, fmt.Sprintf("%s=%g", p.Name, p.Value))
   243			}
   244		}
   245	
   246		if experimentName == "" {
   247			fmt.Fprintf(os.Stderr, "error: --experiment is required\n")
   248			os.Exit(1)
   249		}
   250		if outputDir == "" {
   251			outputDir = "./results"
   252		}
   253	
   254		params, err := config.ParseParams(paramStrs)
   255		if err != nil {
   256			fmt.Fprintf(os.Stderr, "parameter error: %v\n", err)
   257			os.Exit(1)
   258		}
   259	
   260		fn, err := engine.Get(experimentName)
   261		if err != nil {
   262			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   263			os.Exit(1)
   264		}
   265	
   266		if !seedProvided {
   267			seed = time.Now().UnixNano()
   268		}
   269	
   270		rng := engine.NewRNG(seed)
   271	
   272		result, err := fn(experimentName, params, rng)
   273		if err != nil {
   274			fmt.Fprintf(os.Stderr, "experiment error: %v\n", err)
   275			os.Exit(1)
   276		}
   277	
   278		if result.Metadata == nil {
   279			result.Metadata = map[string]string{}
   280		}
   281		if _, ok := result.Metadata["seed"]; !ok {
   282			result.Metadata["seed"] = strconv.FormatInt(seed, 10)
   283		}
   284		if seedProvided {
   285			result.Metadata["seed_source"] = "provided"
   286		} else {
   287			result.Metadata["seed_source"] = "auto-generated"
   288		}
   289	
   290		for k, v := range environmentMetadata() {
   291			result.Metadata[k] = v
   292		}
   293		for _, tag := range tagStrs {
   294			k, v := parseTagFlag(tag)
   295			result.Metadata[k] = v
   296		}
   297	
   298		store, err := storage.NewStore(outputDir)
   299		if err != nil {
   300			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   301			os.Exit(1)
   302		}
   303	
   304		id, err := store.Save(result)
   305		if err != nil {
   306			fmt.Fprintf(os.Stderr, "save error: %v\n", err)
   307			os.Exit(1)
   308		}
   309	
   310		fmt.Printf("Experiment: %s\n", experimentName)
   311		fmt.Printf("Result ID: %s\n", id)
   312		fmt.Printf("Values:\n")
   313		for i, v := range result.Values {
   314			label := fmt.Sprintf("[%d]", i)
   315			if i < len(result.Labels) {
   316				label = result.Labels[i]
   317			}
   318			fmt.Printf("  %s = %.15e\n", label, v)
   319		}
   320	}
