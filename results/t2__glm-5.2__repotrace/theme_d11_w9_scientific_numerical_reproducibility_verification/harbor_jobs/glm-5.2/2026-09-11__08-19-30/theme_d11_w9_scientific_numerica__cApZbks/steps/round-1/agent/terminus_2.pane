    10		"time"
    11	
    12		"numeriforge/engine"
    13	)
    14	
    15	// StoredResult is the on-disk representation of an experiment result.
    16	type StoredResult struct {
    17		ID             string            `json:"id"`
    18		ExperimentName string            `json:"experiment_name"`
    19		Timestamp      time.Time         `json:"timestamp"`
    20		Parameters     []engine.Parameter `json:"parameters"`
    21		Values         []float64         `json:"values"`
    22		Labels         []string          `json:"labels"`
    23		Metadata       map[string]string `json:"metadata"`
    24		// TODO: Add Checksum field for result integrity verification.
    25		// The checksum should be a SHA-256 hash of the canonical representation
    26		// of the Values array.
    27	}
    28	
    29	// Store manages experiment result persistence.
    30	type Store struct {
    31		BaseDir string
    32	}
    33	
    34	// NewStore creates a store at the given directory.
    35	func NewStore(baseDir string) (*Store, error) {
    36		if err := os.MkdirAll(baseDir, 0755); err != nil {
    37			return nil, fmt.Errorf("cannot create store directory: %w", err)
    38		}
    39		return &Store{BaseDir: baseDir}, nil
    40	}
    41	
    42	// Save persists an experiment result to disk.
    43	func (s *Store) Save(result *engine.Result) (string, error) {
    44		id := fmt.Sprintf("%s_%s", result.ExperimentName, result.Timestamp.Format("20060102_150405"))
    45	
    46		stored := StoredResult{
    47			ID:             id,
    48			ExperimentName: result.ExperimentName,
    49			Timestamp:      result.Timestamp,
    50			Parameters:     result.Parameters,
    51			Values:         result.Values,
    52			Labels:         result.Labels,
    53			Metadata:       result.Metadata,
    54		}
    55	
    56		// TODO: Compute and store checksum here.
    57		// Should hash the canonical representation of Values.
    58	
    59		data, err := json.MarshalIndent(stored, "", "  ")
    60		if err != nil {
    61			return "", fmt.Errorf("marshal error: %w", err)
    62		}
    63	
    64		resultDir := filepath.Join(s.BaseDir, result.ExperimentName)
    65		if err := os.MkdirAll(resultDir, 0755); err != nil {
    66			return "", fmt.Errorf("cannot create result directory: %w", err)
    67		}
    68	
    69		path := filepath.Join(resultDir, id+".json")
    70		if err := os.WriteFile(path, data, 0644); err != nil {
    71			return "", fmt.Errorf("write error: %w", err)
    72		}
    73	
    74		// Update index
    75		if err := s.updateIndex(id, result.ExperimentName, result.Timestamp); err != nil {
    76			return "", fmt.Errorf("index update error: %w", err)
    77		}
    78	
    79		return id, nil
    80	}
    81	
    82	// Load reads a stored result by ID.
    83	func (s *Store) Load(id string) (*StoredResult, error) {
    84		// Parse experiment name from ID
    85		parts := strings.SplitN(id, "_", 2)
    86		if len(parts) < 2 {
    87			return nil, fmt.Errorf("invalid result ID: %s", id)
    88		}
    89		// The experiment name may contain underscores, so we need to find the right file
    90		var resultPath string
    91		err := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {
    92			if err != nil {
    93				return err
    94			}
    95			if !info.IsDir() && strings.TrimSuffix(info.Name(), ".json") == id {
    96				resultPath = path
    97				return filepath.SkipAll
    98			}
    99			return nil
   100		})
   101		if err != nil {
   102			return nil, err
   103		}
   104		if resultPath == "" {
   105			return nil, fmt.Errorf("result not found: %s", id)
   106		}
   107	
   108		data, err := os.ReadFile(resultPath)
   109		if err != nil {
   110			return nil, fmt.Errorf("read error: %w", err)
   111		}
   112	
   113		var stored StoredResult
   114		if err := json.Unmarshal(data, &stored); err != nil {
   115			return nil, fmt.Errorf("unmarshal error: %w", err)
   116		}
   117		return &stored, nil
   118	}
   119	
   120	// ListResults returns all stored result IDs, optionally filtered by experiment name.
   121	func (s *Store) ListResults(experimentFilter string) ([]IndexEntry, error) {
   122		index, err := s.readIndex()
   123		if err != nil {
   124			return nil, err
   125		}
   126	
   127		if experimentFilter == "" {
   128			return index, nil
   129		}
   130	
   131		var filtered []IndexEntry
   132		for _, entry := range index {
   133			if entry.ExperimentName == experimentFilter {
   134				filtered = append(filtered, entry)
   135			}
   136		}
   137		return filtered, nil
   138	}
   139	
   140	// IndexEntry represents one line in the result index.
   141	type IndexEntry struct {
   142		ID             string
   143		ExperimentName string
   144		Timestamp      time.Time
   145	}
   146	
   147	func (s *Store) indexPath() string {
   148		return filepath.Join(s.BaseDir, "index.txt")
   149	}
   150	
   151	func (s *Store) updateIndex(id, experimentName string, timestamp time.Time) error {
   152		f, err := os.OpenFile(s.indexPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
   153		if err != nil {
   154			return err
   155		}
   156		defer f.Close()
   157	
   158		_, err = fmt.Fprintf(f, "%s|%s|%s\n", id, experimentName, timestamp.Format(time.RFC3339))
   159		return err
   160	}
