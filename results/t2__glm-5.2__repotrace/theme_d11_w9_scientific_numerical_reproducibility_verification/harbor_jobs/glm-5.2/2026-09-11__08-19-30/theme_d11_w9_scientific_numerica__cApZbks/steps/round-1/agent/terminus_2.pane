   699			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   700			os.Exit(1)
   701		}
   702	
   703		passed := 0
   704		failed := 0
   705		total := len(entries)
   706		for _, entry := range entries {
   707			ok, details := auditStoredResult(store, entry.ID)
   708			fmt.Print(details)
   709			if ok {
   710				passed++
   711			} else {
   712				failed++
   713			}
   714		}
   715	
   716		fmt.Printf("Audit Summary: %d passed, %d failed out of %d total\n", passed, failed, total)
   717		if failed > 0 {
   718			os.Exit(1)
   719		}
   720	}
