   113	func cmdRun(args []string) {
   114		var experimentName, outputDir, configPath string
   115		var paramStrs []string
   116		var seed int64
   117		seedProvided := false
   118	
   119		for i := 0; i < len(args); i++ {
   120			switch args[i] {
   121			case "--experiment":
   122				i++
   123				if i >= len(args) {
   124					fmt.Fprintf(os.Stderr, "error: --experiment requires a value\n")
   125					os.Exit(1)
   126				}
   127				experimentName = args[i]
   128			case "--output-dir":
   129				i++
   130				if i >= len(args) {
   131					fmt.Fprintf(os.Stderr, "error: --output-dir requires a value\n")
   132					os.Exit(1)
   133				}
   134				outputDir = args[i]
   135			case "--config":
   136				i++
   137				if i >= len(args) {
   138					fmt.Fprintf(os.Stderr, "error: --config requires a value\n")
   139					os.Exit(1)
   140				}
   141				configPath = args[i]
   142			case "--param":
   143				i++
   144				if i >= len(args) {
   145					fmt.Fprintf(os.Stderr, "error: --param requires a value\n")
   146					os.Exit(1)
   147				}
   148				paramStrs = append(paramStrs, args[i])
   149			case "--seed":
   150				i++
   151				if i >= len(args) {
   152					fmt.Fprintf(os.Stderr, "error: --seed requires a value\n")
   153					os.Exit(1)
   154				}
   155				parsed, err := strconv.ParseInt(args[i], 10, 64)
   156				if err != nil {
   157					fmt.Fprintf(os.Stderr, "error: invalid seed: %v\n", err)
   158					os.Exit(1)
   159				}
   160				seed = parsed
   161				seedProvided = true
   162			default:
   163				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   164				os.Exit(1)
   165			}
   166		}
   167	
   168		if configPath != "" {
   169			cfg, err := config.ParseINI(configPath)
   170			if err != nil {
   171				fmt.Fprintf(os.Stderr, "config error: %v\n", err)
   172				os.Exit(1)
   173			}
   174			if experimentName == "" {
   175				experimentName = cfg.Experiment
   176			}
   177			if outputDir == "" {
   178				outputDir = cfg.OutputDir
   179			}
   180	
   181			cliParams, _ := config.ParseParams(paramStrs)
   182			cliParamMap := make(map[string]float64)
   183			for _, p := range cliParams {
   184				cliParamMap[p.Name] = p.Value
   185			}
   186			for _, p := range cfg.Params {
   187				if _, exists := cliParamMap[p.Name]; !exists {
   188					cliParams = append(cliParams, p)
   189				}
   190			}
   191			paramStrs = nil
   192			for _, p := range cliParams {
   193				paramStrs = append(paramStrs, fmt.Sprintf("%s=%g", p.Name, p.Value))
   194			}
   195		}
   196	
   197		if experimentName == "" {
   198			fmt.Fprintf(os.Stderr, "error: --experiment is required\n")
   199			os.Exit(1)
   200		}
   201		if outputDir == "" {
   202			outputDir = "./results"
   203		}
   204	
   205		params, err := config.ParseParams(paramStrs)
   206		if err != nil {
   207			fmt.Fprintf(os.Stderr, "parameter error: %v\n", err)
   208			os.Exit(1)
   209		}
   210	
   211		fn, err := engine.Get(experimentName)
   212		if err != nil {
   213			fmt.Fprintf(os.Stderr, "error: %v\n", err)
   214			os.Exit(1)
   215		}
   216	
   217		if !seedProvided {
   218			seed = time.Now().UnixNano()
   219		}
   220	
   221		rng := engine.NewRNG(seed)
   222	
   223		result, err := fn(experimentName, params, rng)
   224		if err != nil {
   225			fmt.Fprintf(os.Stderr, "experiment error: %v\n", err)
   226			os.Exit(1)
   227		}
   228	
   229		if result.Metadata == nil {
   230			result.Metadata = map[string]string{}
   231		}
   232		if _, ok := result.Metadata["seed"]; !ok {
   233			result.Metadata["seed"] = strconv.FormatInt(seed, 10)
   234		}
   235		if seedProvided {
   236			result.Metadata["seed_source"] = "provided"
   237		} else {
   238			result.Metadata["seed_source"] = "auto-generated"
   239		}
   240	
   241		for k, v := range environmentMetadata() {
   242			result.Metadata[k] = v
   243		}
   244	
   245		store, err := storage.NewStore(outputDir)
   246		if err != nil {
   247			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   248			os.Exit(1)
   249		}
   250	
   251		id, err := store.Save(result)
   252		if err != nil {
   253			fmt.Fprintf(os.Stderr, "save error: %v\n", err)
   254			os.Exit(1)
   255		}
   256	
   257		fmt.Printf("Experiment: %s\n", experimentName)
   258		fmt.Printf("Result ID: %s\n", id)
   259		fmt.Printf("Values:\n")
   260		for i, v := range result.Values {
   261			label := fmt.Sprintf("[%d]", i)
   262			if i < len(result.Labels) {
   263				label = result.Labels[i]
   264			}
   265			fmt.Printf("  %s = %.15e\n", label, v)
   266		}
   267	}
