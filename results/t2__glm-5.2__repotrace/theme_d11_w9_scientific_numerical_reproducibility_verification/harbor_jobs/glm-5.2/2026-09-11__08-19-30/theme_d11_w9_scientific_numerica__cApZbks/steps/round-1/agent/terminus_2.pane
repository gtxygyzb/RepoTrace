[?2004l     1	package compare
     2	
     3	import (
     4		"fmt"
     5		"math"
     6		"strings"
     7	
     8		"numeriforge/storage"
     9	)
    10	
    11	// ComparisonMode determines how results are compared.
    12	type ComparisonMode int
    13	
    14	const (
    15		// ModeExact uses exact float equality (legacy, broken for scientific use).
    16		ModeExact ComparisonMode = iota
    17		// ModeTolerance uses configurable absolute and relative tolerance.
    18		// TODO: Implement tolerance-based comparison.
    19		ModeTolerance
    20	)
    21	
    22	// Tolerance defines comparison thresholds.
    23	type Tolerance struct {
    24		Absolute float64
    25		Relative float64
    26	}
    27	
    28	// DefaultTolerance returns a reasonable default for scientific comparisons.
    29	func DefaultTolerance() Tolerance {
    30		return Tolerance{
    31			Absolute: 1e-10,
    32			Relative: 1e-8,
    33		}
    34	}
    35	
    36	// ComparisonResult holds the outcome of comparing two experiment results.
    37	type ComparisonResult struct {
    38		Match       bool
    39		TotalPairs  int
    40		MatchedPairs int
    41		Mismatches  []Mismatch
    42		Mode        ComparisonMode
    43		Summary     string
    44	}
    45	
    46	// Mismatch records a single value pair that didn't match.
    47	type Mismatch struct {
    48		Index    int
    49		Label    string
    50		ValueA   float64
    51		ValueB   float64
    52		AbsDiff  float64
    53		RelDiff  float64
    54	}
    55	
    56	// Compare compares two stored results.
    57	// Currently only supports ModeExact (legacy behavior).
    58	// TODO: Implement ModeTolerance for proper scientific comparison.
    59	func Compare(a, b *storage.StoredResult, mode ComparisonMode, tol Tolerance) *ComparisonResult {
    60		result := &ComparisonResult{
    61			Mode: mode,
    62		}
    63	
    64		if a.ExperimentName != b.ExperimentName {
    65			result.Match = false
    66			result.Summary = fmt.Sprintf("experiment name mismatch: %s vs %s", a.ExperimentName, b.ExperimentName)
    67			return result
    68		}
    69	
    70		minLen := len(a.Values)
    71		if len(b.Values) < minLen {
    72			minLen = len(b.Values)
    73		}
    74	
    75		if len(a.Values) != len(b.Values) {
    76			result.Match = false
    77			result.Summary = fmt.Sprintf("value count mismatch: %d vs %d", len(a.Values), len(b.Values))
    78			return result
    79		}
    80	
    81		result.TotalPairs = minLen
    82	
    83		switch mode {
    84		case ModeExact:
    85			result.Match = true
    86			for i := 0; i < minLen; i++ {
    87				label := fmt.Sprintf("value[%d]", i)
    88				if i < len(a.Labels) {
    89					label = a.Labels[i]
    90				}
    91				// Legacy: exact float equality comparison
    92				if a.Values[i] != b.Values[i] {
    93					result.Match = false
    94					result.Mismatches = append(result.Mismatches, Mismatch{
    95						Index:   i,
    96						Label:   label,
    97						ValueA:  a.Values[i],
    98						ValueB:  b.Values[i],
    99						AbsDiff: math.Abs(a.Values[i] - b.Values[i]),
   100						RelDiff: relDiff(a.Values[i], b.Values[i]),
   101					})
   102				} else {
   103					result.MatchedPairs++
   104				}
   105			}
   106		case ModeTolerance:
   107			// TODO: Implement tolerance-based comparison.
   108			// For each value pair, should check:
   109			// 1. If both values are zero (within absolute tolerance), they match.
   110			// 2. Otherwise, check both absolute and relative tolerance:
   111			//    |a - b| <= tol.Absolute  OR  |a - b| / max(|a|, |b|) <= tol.Relative
   112			// 3. Handle NaN and Inf specially: NaN matches NaN, Inf matches Inf.
   113			result.Match = false
   114			result.Summary = "tolerance comparison not yet implemented"
   115		}
   116	
   117		if result.Summary == "" {
   118			if result.Match {
   119				result.Summary = fmt.Sprintf("all %d value pairs match", result.TotalPairs)
   120			} else {
   121				result.Summary = fmt.Sprintf("%d of %d value pairs mismatch", len(result.Mismatches), result.TotalPairs)
   122			}
   123		}
   124	
   125		return result
   126	}
   127	
   128	// FormatReport generates a human-readable comparison report.
   129	func FormatReport(cr *ComparisonResult) string {
   130		var sb strings.Builder
   131		sb.WriteString("=== Comparison Report ===\n")
   132		sb.WriteString(fmt.Sprintf("Mode: %s\n", modeString(cr.Mode)))
   133		sb.WriteString(fmt.Sprintf("Match: %v\n", cr.Match))
   134		sb.WriteString(fmt.Sprintf("Total pairs: %d\n", cr.TotalPairs))
   135		sb.WriteString(fmt.Sprintf("Matched: %d\n", cr.MatchedPairs))
   136		sb.WriteString(fmt.Sprintf("Summary: %s\n", cr.Summary))
   137	
   138		if len(cr.Mismatches) > 0 {
   139			sb.WriteString("\nMismatches:\n")
   140			for _, m := range cr.Mismatches {
   141				sb.WriteString(fmt.Sprintf("  [%d] %s: %.15e vs %.15e (abs=%.6e, rel=%.6e)\n",
   142					m.Index, m.Label, m.ValueA, m.ValueB, m.AbsDiff, m.RelDiff))
   143			}
   144		}
   145	
   146		return sb.String()
   147	}
   148	
   149	func relDiff(a, b float64) float64 {
   150		denom := math.Max(math.Abs(a), math.Abs(b))
   151		if denom < 1e-300 {
   152			return 0
   153		}
   154		return math.Abs(a-b) / denom
   155	}
   156	
   157	func modeString(m ComparisonMode) string {
   158		switch m {
   159		case ModeExact:
   160			return "exact"
   161		case ModeTolerance:
   162			return "tolerance"
   163		default:
   164			return "unknown"
   165		}
   166	}
