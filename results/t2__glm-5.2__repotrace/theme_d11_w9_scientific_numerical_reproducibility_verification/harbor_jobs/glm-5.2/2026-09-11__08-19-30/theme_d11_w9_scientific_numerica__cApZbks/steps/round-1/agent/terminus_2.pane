   177			if len(parts) != 3 {
   178				continue
   179			}
   180			ts, _ := time.Parse(time.RFC3339, parts[2])
   181			entries = append(entries, IndexEntry{
   182				ID:             parts[0],
   183				ExperimentName: parts[1],
   184				Timestamp:      ts,
   185			})
   186		}
   187	
   188		sort.Slice(entries, func(i, j int) bool {
   189			return entries[i].Timestamp.Before(entries[j].Timestamp)
   190		})
   191	
   192		return entries, nil
   193	}
