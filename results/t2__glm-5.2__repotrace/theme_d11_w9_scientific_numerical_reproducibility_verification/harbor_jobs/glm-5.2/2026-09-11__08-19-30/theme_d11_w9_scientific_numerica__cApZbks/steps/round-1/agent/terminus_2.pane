func registerMonteCarloExperiments() {
	Register("mc-estimate-pi", mcEstimatePi)
	Register("mc-integral", mcIntegral)
	Register("mc-importance-sampling", mcImportanceSampling)
}

// mcEstimatePi estimates pi using the classic circle/square Monte Carlo method.
// Parameters: samples (int)
// TODO: This uses GlobalRand which makes results non-reproducible.
//       Need to accept a seed parameter and create a local random source.
func mcEstimatePi(name string, params []Parameter) (*Result, error) {
	samplesF, err := RequireParam(params, "samples")
	if err != nil {
		return nil, err
	}
	samples := int(samplesF)
	if samples <= 0 {
		samples = 100000
	}

	inside := 0
	for i := 0; i < samples; i++ {
		x := GlobalRand.Float64()
		y := GlobalRand.Float64()
		if x*x+y*y <= 1.0 {
			inside++
		}
	}

	piEstimate := 4.0 * float64(inside) / float64(samples)
	errorMargin := math.Abs(piEstimate - math.Pi)

	return &Result{
		ExperimentName: name,
		Timestamp:      time.Now(),
		Parameters:     params,
		Values:         []float64{piEstimate, errorMargin, float64(inside), float64(samples)},
		Labels:         []string{"pi_estimate", "error_margin", "inside_count", "total_samples"},
		Metadata:       map[string]string{"method": "circle_square"},
	}, nil
}

// mcIntegral performs numerical integration of f(x) = sin(x)*exp(-x^2/2) over [a,b]
// using simple Monte Carlo sampling.
// Parameters: samples (int), lower_bound (float), upper_bound (float)
// TODO: Uses GlobalRand - not reproducible.
func mcIntegral(name string, params []Parameter) (*Result, error) {
	samplesF, err := RequireParam(params, "samples")
	if err != nil {
		return nil, err
	}
	lower, err := RequireParam(params, "lower_bound")
	if err != nil {
		return nil, err
	}
	upper, err := RequireParam(params, "upper_bound")
	if err != nil {
		return nil, err
	}

	samples := int(samplesF)
	if samples <= 0 {
		samples = 100000
	}

	width := upper - lower
	sum := 0.0
	sumSq := 0.0
	for i := 0; i < samples; i++ {
		x := lower + GlobalRand.Float64()*width
		fx := math.Sin(x) * math.Exp(-x*x/2.0)
		sum += fx
		sumSq += fx * fx
	}

	mean := sum / float64(samples)
	integral := width * mean
	variance := (sumSq/float64(samples) - mean*mean) / float64(samples)
	stdErr := math.Sqrt(math.Abs(variance)) * width

	return &Result{
		ExperimentName: name,
		Timestamp:      time.Now(),
		Parameters:     params,
		Values:         []float64{integral, stdErr, mean, variance},
		Labels:         []string{"integral", "std_error", "mean_value", "variance"},
		Metadata:       map[string]string{"method": "simple_mc", "integrand": "sin(x)*exp(-x^2/2)"},
	}, nil
}

// mcImportanceSampling performs Monte Carlo integration using importance sampling
// with a Gaussian proposal distribution.
// Parameters: samples (int), lower_bound (float), upper_bound (float), proposal_mean (float), proposal_std (float)
// TODO: Uses GlobalRand - not reproducible.
func mcImportanceSampling(name string, params []Parameter) (*Result, error) {
	samplesF, err := RequireParam(params, "samples")
	if err != nil {
		return nil, err
	}
	lower, err := RequireParam(params, "lower_bound")
	if err != nil {
		return nil, err
	}
	upper, err := RequireParam(params, "upper_bound")
	if err != nil {
		return nil, err
	}
	pMean, err := RequireParam(params, "proposal_mean")
	if err != nil {
		return nil, err
	}
	pStd, err := RequireParam(params, "proposal_std")
	if err != nil {
		return nil, err
	}

	samples := int(samplesF)
	if samples <= 0 {
		samples = 100000
	}

	// Target: f(x) = sin(x)*exp(-x^2/2) on [lower, upper]
	// Proposal: truncated Gaussian N(pMean, pStd^2) on [lower, upper]
	sum := 0.0
	sumSq := 0.0
	accepted := 0

	for i := 0; i < samples; i++ {
		// Generate from truncated Gaussian via rejection
		var x float64
		for {
			x = GlobalRand.NormFloat64()*pStd + pMean
			if x >= lower && x <= upper {
				break
			}
		}

		// Target function
		fx := math.Sin(x) * math.Exp(-x*x/2.0)

		// Proposal density (unnormalized Gaussian)
		qx := math.Exp(-(x-pMean)*(x-pMean) / (2.0 * pStd * pStd))

		if qx > 1e-300 {
			w := fx / qx
			sum += w
			sumSq += w * w
			accepted++
		}
	}

	if accepted == 0 {
		return &Result{
			ExperimentName: name,
			Timestamp:      time.Now(),
			Parameters:     params,
			Values:         []float64{0, 0, 0, 0},
			Labels:         []string{"integral", "std_error", "effective_samples", "acceptance_rate"},
			Metadata:       map[string]string{"method": "importance_sampling", "status": "no_accepted_samples"},
		}, nil
	}

	mean := sum / float64(accepted)
	variance := (sumSq/float64(accepted) - mean*mean) / float64(accepted)
	stdErr := math.Sqrt(math.Abs(variance))
	// Normalize: the integral estimate needs scaling by the proposal normalization constant
	// For simplicity, we report the weighted mean as the integral estimate
	integral := mean * pStd * math.Sqrt(2.0*math.Pi)
	accRate := float64(accepted) / float64(samples)

	return &Result{
		ExperimentName: name,
		Timestamp:      time.Now(),
		Parameters:     params,
		Values:         []float64{integral, stdErr, float64(accepted), accRate},
		Labels:         []string{"integral", "std_error", "effective_samples", "acceptance_rate"},
		Metadata:       map[string]string{"method": "importance_sampling", "integrand": "sin(x)*exp(-x^2/2)"},
	}, nil
}
