   362	func cmdList(args []string) {
   363		storeDir := "./results"
   364		experimentFilter := ""
   365	
   366		for i := 0; i < len(args); i++ {
   367			switch args[i] {
   368			case "--store-dir":
   369				i++
   370				if i >= len(args) {
   371					fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
   372					os.Exit(1)
   373				}
   374				storeDir = args[i]
   375			case "--experiment":
   376				i++
   377				if i >= len(args) {
   378					fmt.Fprintf(os.Stderr, "error: --experiment requires a value\n")
   379					os.Exit(1)
   380				}
   381				experimentFilter = args[i]
   382			default:
   383				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   384				os.Exit(1)
   385			}
   386		}
   387	
   388		store, err := storage.NewStore(storeDir)
   389		if err != nil {
   390			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   391			os.Exit(1)
   392		}
   393	
