   759		}
   760	
   761		maxLen := len(stored.Values)
   762		if len(reexec.Values) > maxLen {
   763			maxLen = len(reexec.Values)
   764		}
   765	
   766		var mismatches []string
   767		for i := 0; i < maxLen; i++ {
   768			storedMissing := i >= len(stored.Values)
   769			reexecMissing := i >= len(reexec.Values)
   770	
   771			var storedVal, reexecVal string
   772			if storedMissing {
   773				storedVal = "<missing>"
   774			} else {
   775				storedVal = strconv.FormatFloat(stored.Values[i], 'g', -1, 64)
   776			}
   777			if reexecMissing {
