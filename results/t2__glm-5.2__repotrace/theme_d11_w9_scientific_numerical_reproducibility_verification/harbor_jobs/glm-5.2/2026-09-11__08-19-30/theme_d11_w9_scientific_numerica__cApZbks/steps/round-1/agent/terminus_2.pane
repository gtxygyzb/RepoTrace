   766	func auditStoredResult(store *storage.Store, id string) (auditStatus, string) {
   767		stored, err := store.Load(id)
   768		if err != nil {
   769			return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: load error: %v)\n", id, err)
   770		}
   771	
   772		warnEnvMismatch(stored)
   773	
   774		status, expected, computed, err := store.Verify(id)
   775		if err != nil {
   776			return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check error: %v)\n", id, err)
   777		}
   778		if status == storage.StatusNoChecksum {
   779			return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check failed: no checksum)\n", id)
   780		}
   781		if status == storage.StatusCorrupted {
   782			return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check failed: expected=%s computed=%s)\n", id, expected, computed)
   783		}
   784	
   785		var seed int64
   786		seedStr, ok := stored.Metadata["seed"]
