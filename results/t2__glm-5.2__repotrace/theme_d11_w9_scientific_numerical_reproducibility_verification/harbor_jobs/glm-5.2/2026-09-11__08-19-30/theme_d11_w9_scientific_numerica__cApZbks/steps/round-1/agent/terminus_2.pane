func cmdExport(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: numeriforge export <id> --store-dir <dir> [--format json|csv]\n")
		os.Exit(1)
	}

	id := args[0]
	storeDir := "./results"
	format := "json"

	for i := 1; i < len(args); i++ {
		switch args[i] {
		case "--store-dir":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
				os.Exit(1)
			}
			storeDir = args[i]
		case "--format":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --format requires a value\n")
				os.Exit(1)
			}
			format = args[i]
		default:
			fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
			os.Exit(1)
		}
	}

	store, err := storage.NewStore(storeDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	result, err := store.Load(id)
	if err != nil {
		fmt.Fprintf(os.Stderr, "load error: %v\n", err)
		os.Exit(1)
	}

	switch format {
	case "json":
		payload := exportPayload{
			StoredResult: result,
			Environment:  environmentFromMetadata(result.Metadata),
			Tags:         tagsFromMetadata(result.Metadata),
		}
		data, err := json.MarshalIndent(payload, "", "  ")
		if err != nil {
			fmt.Fprintf(os.Stderr, "marshal error: %v\n", err)
			os.Exit(1)
		}
		fmt.Println(string(data))
	case "csv":
		fmt.Printf("# id: %s\n", result.ID)
		fmt.Printf("# experiment: %s\n", result.ExperimentName)
		fmt.Printf("# timestamp: %s\n", result.Timestamp.Format("2006-01-02 15:04:05"))
		if seed, ok := result.Metadata["seed"]; ok {
			fmt.Printf("# seed: %s\n", seed)
		}
		fmt.Println("label,value")
		for i, v := range result.Values {
			label := fmt.Sprintf("value_%d", i)
			if i < len(result.Labels) {
				label = result.Labels[i]
			}
			fmt.Printf("%s,%.15e\n", label, v)
		}
	default:
		fmt.Fprintf(os.Stderr, "unknown format: %s\n", format)
		os.Exit(1)
	}
}

func cmdVerify(args []string) {
	if len(args) < 1 {
		fmt.Fprintf(os.Stderr, "usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\n")
		os.Exit(1)
	}

	id := args[0]
	storeDir := "./results"
	verbose := false

	for i := 1; i < len(args); i++ {
		switch args[i] {
		case "--verbose":
			verbose = true
		case "--store-dir":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
				os.Exit(1)
			}
			storeDir = args[i]
		default:
			fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
			os.Exit(1)
		}
	}

	store, err := storage.NewStore(storeDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	status, expected, computed, err := store.Verify(id)
	if err != nil {
		fmt.Fprintf(os.Stderr, "verify error: %v\n", err)
		os.Exit(1)
	}

	switch status {
	case storage.StatusVerified:
		fmt.Printf("INTEGRITY_OK: %s\n", id)
		if verbose {
			fmt.Printf("Stored checksum: %s\n", expected)
			fmt.Printf("Computed checksum: %s\n", computed)
		}
		os.Exit(0)
	case storage.StatusCorrupted:
		fmt.Printf("INTEGRITY_FAIL: %s\n", id)
		if verbose {
			fmt.Printf("Stored checksum: %s\n", expected)
			fmt.Printf("Computed checksum: %s\n", computed)
		}
		os.Exit(1)
	case storage.StatusNoChecksum:
		fmt.Printf("NO_CHECKSUM: %s\n", id)
		os.Exit(2)
	default:
		fmt.Fprintf(os.Stderr, "unknown verification status: %s\n", status)
		os.Exit(1)
	}
}
func cmdAudit(args []string) {
	all := false
	var positionals []string
	storeDir := "./results"

	for i := 0; i < len(args); i++ {
		switch args[i] {
		case "--all":
			all = true
		case "--store-dir":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
				os.Exit(1)
			}
			storeDir = args[i]
		default:
			if strings.HasPrefix(args[i], "-") {
				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
				os.Exit(1)
			}
			positionals = append(positionals, args[i])
		}
	}

	if all {
		if len(positionals) != 0 {
			fmt.Fprintf(os.Stderr, "error: --all does not accept result IDs\n")
			os.Exit(1)
		}
		cmdAuditAll(storeDir)
		return
	}

	if len(positionals) < 1 {
		fmt.Fprintf(os.Stderr, "usage: numeriforge audit <result_id> --store-dir <dir>\n")
		fmt.Fprintf(os.Stderr, "       numeriforge audit --all --store-dir <dir>\n")
		os.Exit(1)
	}
	if len(positionals) > 1 {
		fmt.Fprintf(os.Stderr, "error: too many arguments\n")
		os.Exit(1)
	}

	store, err := storage.NewStore(storeDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	passed, details := auditStoredResult(store, positionals[0])
	fmt.Print(details)
	if !passed {
		os.Exit(1)
	}
}

func cmdAuditAll(storeDir string) {
	store, err := storage.NewStore(storeDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	entries, err := store.ListResults("")
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	passed := 0
	failed := 0
	total := len(entries)
	for _, entry := range entries {
		ok, details := auditStoredResult(store, entry.ID)
		fmt.Print(details)
		if ok {
			passed++
		} else {
			failed++
		}
	}

	fmt.Printf("Audit Summary: %d passed, %d failed out of %d total\n", passed, failed, total)
	if failed > 0 {
		os.Exit(1)
	}
}

func auditStoredResult(store *storage.Store, id string) (bool, string) {
	stored, err := store.Load(id)
	if err != nil {
		return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: load error: %v)\n", id, err)
	}

	warnEnvMismatch(stored)

	status, expected, computed, err := store.Verify(id)
	if err != nil {
		return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check error: %v)\n", id, err)
	}
	if status == storage.StatusNoChecksum {
		return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check failed: no checksum)\n", id)
	}
	if status == storage.StatusCorrupted {
		return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check failed: expected=%s computed=%s)\n", id, expected, computed)
	}

	seedStr, ok := stored.Metadata["seed"]
	if !ok {
		return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: missing seed in metadata)\n", id)
	}
	seed, err := strconv.ParseInt(seedStr, 10, 64)
	if err != nil {
		return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\n", id, err)
	}

	fn, err := engine.Get(stored.ExperimentName)
	if err != nil {
		return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: experiment error: %v)\n", id, err)
	}

	rng := engine.NewRNG(seed)
	reexec, err := fn(stored.ExperimentName, stored.Parameters, rng)
	if err != nil {
		return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: experiment error: %v)\n", id, err)
	}

	maxLen := len(stored.Values)
	if len(reexec.Values) > maxLen {
		maxLen = len(reexec.Values)
	}

	var mismatches []string
	for i := 0; i < maxLen; i++ {
		storedMissing := i >= len(stored.Values)
		reexecMissing := i >= len(reexec.Values)

		var storedVal, reexecVal string
		if storedMissing {
			storedVal = "<missing>"
		} else {
			storedVal = strconv.FormatFloat(stored.Values[i], 'g', -1, 64)
		}
		if reexecMissing {
			reexecVal = "<missing>"
		} else {
			reexecVal = strconv.FormatFloat(reexec.Values[i], 'g', -1, 64)
		}

		if storedMissing || reexecMissing || math.Float64bits(stored.Values[i]) != math.Float64bits(reexec.Values[i]) {
			mismatches = append(mismatches, fmt.Sprintf("  value[%d]: stored=%s, re-executed=%s", i, storedVal, reexecVal))
		}
	}

	if len(mismatches) == 0 {
		return true, fmt.Sprintf("AUDIT_PASS: %s\n", id)
	}

	var sb strings.Builder
	sb.WriteString(fmt.Sprintf("AUDIT_FAIL: %s\n", id))
	for _, m := range mismatches {
		sb.WriteString(m)
		sb.WriteByte('\n')
	}
	return false, sb.String()
}

func warnEnvMismatch(stored *storage.StoredResult) {
	msg, ok := envMismatchWarning(stored.Metadata)
	if ok {
		fmt.Fprintln(os.Stderr, msg)
	}
}

