   529	
   530		switch status {
   531		case storage.StatusVerified:
   532			fmt.Printf("INTEGRITY_OK: %s\n", id)
   533			if verbose {
   534				fmt.Printf("Stored checksum: %s\n", expected)
   535				fmt.Printf("Computed checksum: %s\n", computed)
