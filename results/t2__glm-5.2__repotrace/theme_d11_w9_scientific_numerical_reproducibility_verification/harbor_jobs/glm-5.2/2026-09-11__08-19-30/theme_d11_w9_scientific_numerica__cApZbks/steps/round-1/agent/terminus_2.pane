    76	// Parameters: system (string mapped via index), t_end (float), steps (int)
    77	func odeEuler(name string, params []Parameter, rng RNG) (*Result, error) {
    78		sysIdxF, err := RequireParam(params, "system_index")
    79		if err != nil {
    80			return nil, err
    81		}
    82		tEnd, err := RequireParam(params, "t_end")
    83		if err != nil {
