func cmdReport(args []string) {
	storeDir := "./results"

	for i := 0; i < len(args); i++ {
		switch args[i] {
		case "--store-dir":
			i++
			if i >= len(args) {
				fmt.Fprintln(os.Stderr, "error: --store-dir requires a value")
				os.Exit(1)
			}
			storeDir = args[i]
		default:
			fmt.Fprintln(os.Stderr, "error: unknown flag:", args[i])
			os.Exit(1)
		}
	}

	store, err := storage.NewStore(storeDir)
	if err != nil {
		fmt.Fprintln(os.Stderr, "storage error:", err)
		os.Exit(1)
	}

	entries, err := store.ListResults("")
	if err != nil {
		fmt.Fprintln(os.Stderr, "storage error:", err)
		os.Exit(1)
	}

	if len(entries) == 0 {
		fmt.Println("No results found.")
		return
	}

	fmt.Println("=== NumeriForge Reproducibility Report ===")

	groups := make(map[string][]storage.IndexEntry)
	for _, entry := range entries {
		groups[entry.ExperimentName] = append(groups[entry.ExperimentName], entry)
	}

	names := make([]string, 0, len(groups))
	for name := range groups {
		names = append(names, name)
	}
	sort.Strings(names)

	for _, name := range names {
		group := groups[name]
		earliest := group[0].Timestamp
		latest := group[len(group)-1].Timestamp
		fmt.Println("Experiment:", name, "("+strconv.Itoa(len(group))+" results)")
		fmt.Println("Date range:", earliest.Format(time.RFC3339), "to", latest.Format(time.RFC3339))
	}

	envSet := make(map[string]bool)
	for _, entry := range entries {
		stored, err := store.Load(entry.ID)
		if err != nil {
			envSet["unknown/unknown"] = true
			continue
		}
		osVal := stored.Metadata["env_os"]
		if osVal == "" {
			osVal = "unknown"
		}
		archVal := stored.Metadata["env_arch"]
		if archVal == "" {
			archVal = "unknown"
		}
		envSet[osVal+"/"+archVal] = true
	}

	fmt.Println("Environment summary:")
	envKeys := make([]string, 0, len(envSet))
	for key := range envSet {
		envKeys = append(envKeys, key)
	}
	sort.Strings(envKeys)
	if len(envKeys) == 0 {
		fmt.Println("  none")
	} else {
		for _, key := range envKeys {
			fmt.Println("  " + key)
		}
	}

	ok := 0
	fail := 0
	noChecksum := 0
	for _, entry := range entries {
		status, _, _, err := store.Verify(entry.ID)
		if err != nil {
			fail++
			fmt.Fprintln(os.Stderr, "verify error:", entry.ID, err)
			continue
		}
		switch status {
		case storage.StatusVerified:
			ok++
		case storage.StatusCorrupted:
			fail++
		case storage.StatusNoChecksum:
			noChecksum++
		default:
			fail++
		}
	}

	fmt.Println("Integrity summary:")
