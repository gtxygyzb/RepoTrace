   418		if len(args) < 1 {
   419			fmt.Fprintf(os.Stderr, "usage: numeriforge export <id> --store-dir <dir> [--format json|csv]\n")
   420			os.Exit(1)
   421		}
   422	
   423		id := args[0]
   424		storeDir := "./results"
   425		format := "json"
   426	
   427		for i := 1; i < len(args); i++ {
   428			switch args[i] {
   429			case "--store-dir":
   430				i++
   431				if i >= len(args) {
   432					fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
   433					os.Exit(1)
   434				}
   435				storeDir = args[i]
   436			case "--format":
   437				i++
   438				if i >= len(args) {
   439					fmt.Fprintf(os.Stderr, "error: --format requires a value\n")
   440					os.Exit(1)
   441				}
   442				format = args[i]
   443			default:
   444				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   445				os.Exit(1)
   446			}
   447		}
   448	
   449		store, err := storage.NewStore(storeDir)
   450		if err != nil {
   451			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   452			os.Exit(1)
   453		}
   454	
   455		result, err := store.Load(id)
   456		if err != nil {
   457			fmt.Fprintf(os.Stderr, "load error: %v\n", err)
   458			os.Exit(1)
   459		}
   460	
   461		switch format {
   462		case "json":
   463			payload := exportPayload{
   464				StoredResult: result,
   465				Environment:  environmentFromMetadata(result.Metadata),
   466			}
   467			data, err := json.MarshalIndent(payload, "", "  ")
   468			if err != nil {
   469				fmt.Fprintf(os.Stderr, "marshal error: %v\n", err)
   470				os.Exit(1)
   471			}
   472			fmt.Println(string(data))
   473		case "csv":
   474			fmt.Printf("# id: %s\n", result.ID)
   475			fmt.Printf("# experiment: %s\n", result.ExperimentName)
   476			fmt.Printf("# timestamp: %s\n", result.Timestamp.Format("2006-01-02 15:04:05"))
   477			if seed, ok := result.Metadata["seed"]; ok {
   478				fmt.Printf("# seed: %s\n", seed)
   479			}
   480			fmt.Println("label,value")
   481			for i, v := range result.Values {
   482				label := fmt.Sprintf("value_%d", i)
   483				if i < len(result.Labels) {
   484					label = result.Labels[i]
   485				}
   486				fmt.Printf("%s,%.15e\n", label, v)
   487			}
   488		default:
   489			fmt.Fprintf(os.Stderr, "unknown format: %s\n", format)
   490			os.Exit(1)
   491		}
   492	}
