   147	// ListResults returns all stored result IDs, optionally filtered by experiment name.
   148	func (s *Store) ListResults(experimentFilter string) ([]IndexEntry, error) {
   149		entries, err := s.readIndex()
   150		if err != nil {
   151			return nil, err
   152		}
   153	
   154		if experimentFilter == "" {
   155			return entries, nil
   156		}
   157	
   158		filtered := make([]IndexEntry, 0)
   159		for _, entry := range entries {
   160			if entry.ExperimentName == experimentFilter {
   161				filtered = append(filtered, entry)
   162			}
   163		}
   164		return filtered, nil
   165	}
   166	
   167	// Verify checks stored result integrity by recomputing the canonical checksum.
   168	func (s *Store) Verify(id string) (VerifyStatus, string, string, error) {
   169		stored, err := s.Load(id)
   170		if err != nil {
   171			return "", "", "", err
   172		}
   173	
   174		if stored.Checksum == "" {
   175			return StatusNoChecksum, "", "", nil
   176		}
   177	
   178		computed := ComputeChecksum(stored.Values)
   179		if computed == stored.Checksum {
   180			return StatusVerified, stored.Checksum, computed, nil
   181		}
   182		return StatusCorrupted, stored.Checksum, computed, nil
   183	}
   184	
   185	func (s *Store) indexPath() string {
   186		return filepath.Join(s.BaseDir, "index.txt")
   187	}
   188	
   189	func (s *Store) updateIndex(id, experimentName string, timestamp time.Time) error {
   190		if err := os.MkdirAll(s.BaseDir, 0755); err != nil {
   191			return err
   192		}
   193	
   194		f, err := os.OpenFile(s.indexPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
   195		if err != nil {
   196			return err
   197		}
   198		defer f.Close()
   199	
   200		_, err = fmt.Fprintf(f, "%s|%s|%s\n", id, experimentName, timestamp.Format(time.RFC3339))
   201		return err
   202	}
   203	
   204	func (s *Store) readIndex() ([]IndexEntry, error) {
   205		data, err := os.ReadFile(s.indexPath())
   206		if err != nil {
   207			if os.IsNotExist(err) {
   208				return nil, nil
   209			}
   210			return nil, err
   211		}
   212	
   213		var entries []IndexEntry
   214		for _, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
   215			if line == "" {
   216				continue
   217			}
   218			parts := strings.SplitN(line, "|", 3)
   219			if len(parts) != 3 {
   220				continue
   221			}
   222			ts, _ := time.Parse(time.RFC3339, parts[2])
   223			entries = append(entries, IndexEntry{
   224				ID:             parts[0],
   225				ExperimentName: parts[1],
   226				Timestamp:      ts,
   227			})
   228		}
   229	
   230		sort.Slice(entries, func(i, j int) bool {
   231			return entries[i].Timestamp.Before(entries[j].Timestamp)
   232		})
   233	
   234		return entries, nil
   235	}
