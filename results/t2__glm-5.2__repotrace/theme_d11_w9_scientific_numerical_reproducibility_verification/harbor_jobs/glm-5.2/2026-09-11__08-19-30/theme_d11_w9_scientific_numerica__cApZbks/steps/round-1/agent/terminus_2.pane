   545	func cmdAudit(args []string) {
   546		all := false
   547		var positionals []string
   548		storeDir := "./results"
   549	
   550		for i := 0; i < len(args); i++ {
   551			switch args[i] {
   552			case "--all":
   553				all = true
   554			case "--store-dir":
   555				i++
   556				if i >= len(args) {
   557					fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
   558					os.Exit(1)
   559				}
   560				storeDir = args[i]
   561			default:
   562				if strings.HasPrefix(args[i], "-") {
   563					fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   564					os.Exit(1)
   565				}
   566				positionals = append(positionals, args[i])
   567			}
   568		}
   569	
   570		if all {
   571			if len(positionals) != 0 {
   572				fmt.Fprintf(os.Stderr, "error: --all does not accept result IDs\n")
   573				os.Exit(1)
   574			}
   575			cmdAuditAll(storeDir)
   576			return
   577		}
   578	
   579		if len(positionals) < 1 {
   580			fmt.Fprintf(os.Stderr, "usage: numeriforge audit <result_id> --store-dir <dir>\n")
   581			fmt.Fprintf(os.Stderr, "       numeriforge audit --all --store-dir <dir>\n")
   582			os.Exit(1)
   583		}
   584		if len(positionals) > 1 {
   585			fmt.Fprintf(os.Stderr, "error: too many arguments\n")
   586			os.Exit(1)
   587		}
   588	
   589		store, err := storage.NewStore(storeDir)
   590		if err != nil {
   591			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   592			os.Exit(1)
   593		}
   594	
   595		passed, details := auditStoredResult(store, positionals[0])
   596		fmt.Print(details)
   597		if !passed {
   598			os.Exit(1)
   599		}
   600	}
   601	
   602	func cmdAuditAll(storeDir string) {
   603		store, err := storage.NewStore(storeDir)
   604		if err != nil {
   605			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   606			os.Exit(1)
   607		}
   608	
   609		entries, err := store.ListResults("")
   610		if err != nil {
   611			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   612			os.Exit(1)
   613		}
   614	
   615		passed := 0
   616		failed := 0
   617		total := len(entries)
   618		for _, entry := range entries {
   619			ok, details := auditStoredResult(store, entry.ID)
   620			fmt.Print(details)
   621			if ok {
   622				passed++
   623			} else {
   624				failed++
   625			}
   626		}
   627	
   628		fmt.Printf("Audit Summary: %d passed, %d failed out of %d total\n", passed, failed, total)
   629		if failed > 0 {
   630			os.Exit(1)
   631		}
   632	}
   633	
   634	func auditStoredResult(store *storage.Store, id string) (bool, string) {
   635		stored, err := store.Load(id)
   636		if err != nil {
   637			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: load error: %v)\n", id, err)
   638		}
   639	
   640		warnEnvMismatch(stored)
   641	
   642		status, expected, computed, err := store.Verify(id)
   643		if err != nil {
   644			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: checksum verification error: %v)\n", id, err)
   645		}
   646		if status == storage.StatusNoChecksum {
   647			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: checksum missing)\n", id)
   648		}
   649		if status == storage.StatusCorrupted {
   650			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: checksum mismatch expected=%s computed=%s)\n", id, expected, computed)
   651		}
   652	
   653		seedStr, ok := stored.Metadata["seed"]
   654		if !ok {
   655			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: missing seed in metadata)\n", id)
   656		}
   657		seed, err := strconv.ParseInt(seedStr, 10, 64)
   658		if err != nil {
   659			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\n", id, err)
   660		}
   661	
   662		fn, err := engine.Get(stored.ExperimentName)
   663		if err != nil {
   664			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: experiment error: %v)\n", id, err)
   665		}
   666	
   667		rng := engine.NewRNG(seed)
   668		reexec, err := fn(stored.ExperimentName, stored.Parameters, rng)
   669		if err != nil {
   670			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: experiment error: %v)\n", id, err)
   671		}
   672	
   673		maxLen := len(stored.Values)
   674		if len(reexec.Values) > maxLen {
   675			maxLen = len(reexec.Values)
   676		}
   677	
   678		var mismatches []string
   679		for i := 0; i < maxLen; i++ {
   680			storedMissing := i >= len(stored.Values)
   681			reexecMissing := i >= len(reexec.Values)
   682	
   683			var storedVal, reexecVal string
   684			if storedMissing {
   685				storedVal = "<missing>"
   686			} else {
   687				storedVal = strconv.FormatFloat(stored.Values[i], 'g', -1, 64)
   688			}
   689			if reexecMissing {
   690				reexecVal = "<missing>"
   691			} else {
   692				reexecVal = strconv.FormatFloat(reexec.Values[i], 'g', -1, 64)
   693			}
   694	
   695			if storedMissing || reexecMissing || math.Float64bits(stored.Values[i]) != math.Float64bits(reexec.Values[i]) {
   696				mismatches = append(mismatches, fmt.Sprintf("  value[%d]: stored=%s, re-executed=%s", i, storedVal, reexecVal))
   697			}
   698		}
   699	
   700		if len(mismatches) == 0 {
