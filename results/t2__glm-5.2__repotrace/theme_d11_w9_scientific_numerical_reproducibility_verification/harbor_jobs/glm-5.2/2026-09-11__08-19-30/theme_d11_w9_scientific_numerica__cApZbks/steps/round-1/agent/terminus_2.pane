[?2004lpackage engine

import (
	"fmt"
	"math"
	"time"
)

func registerMatrixExperiments() {
	Register("matrix-lu-decompose", matrixLUDecompose)
	Register("matrix-qr-decompose", matrixQRDecompose)
	Register("matrix-eigenvalue", matrixEigenvalue)
}

// Matrix is a simple dense matrix representation.
type Matrix struct {
	Rows, Cols int
	Data       []float64
}

// NewMatrix creates a zero matrix.
func NewMatrix(rows, cols int) *Matrix {
	return &Matrix{Rows: rows, Cols: cols, Data: make([]float64, rows*cols)}
}

// At returns the element at (i, j).
func (m *Matrix) At(i, j int) float64 {
	return m.Data[i*m.Cols+j]
}

// Set sets the element at (i, j).
func (m *Matrix) Set(i, j int, v float64) {
	m.Data[i*m.Cols+j] = v
}

// generateRandomMatrix creates a matrix with random entries.
// TODO: Uses GlobalRand - not reproducible. Need seed parameter.
func generateRandomMatrix(rows, cols int, scale float64) *Matrix {
	m := NewMatrix(rows, cols)
	for i := 0; i < rows*cols; i++ {
		m.Data[i] = (GlobalRand.Float64()*2 - 1) * scale
	}
	return m
}

// generateSPDMatrix creates a symmetric positive-definite matrix.
// TODO: Uses GlobalRand - not reproducible.
func generateSPDMatrix(size int, scale float64) *Matrix {
	a := generateRandomMatrix(size, size, scale)
	result := NewMatrix(size, size)
	// A^T * A + diagonal dominance
	for i := 0; i < size; i++ {
		for j := 0; j < size; j++ {
			sum := 0.0
			for k := 0; k < size; k++ {
				sum += a.At(k, i) * a.At(k, j)
			}
			result.Set(i, j, sum)
		}
		result.Set(i, i, result.At(i, i)+float64(size)*scale)
	}
	return result
}

// flattenMatrix returns a flat slice of matrix data with row-major labeling.
func flattenMatrix(m *Matrix, prefix string) ([]float64, []string) {
	values := make([]float64, 0, m.Rows*m.Cols)
	labels := make([]string, 0, m.Rows*m.Cols)
	for i := 0; i < m.Rows; i++ {
		for j := 0; j < m.Cols; j++ {
			values = append(values, m.At(i, j))
			labels = append(labels, fmt.Sprintf("%s[%d][%d]", prefix, i, j))
		}
	}
	return values, labels
}

