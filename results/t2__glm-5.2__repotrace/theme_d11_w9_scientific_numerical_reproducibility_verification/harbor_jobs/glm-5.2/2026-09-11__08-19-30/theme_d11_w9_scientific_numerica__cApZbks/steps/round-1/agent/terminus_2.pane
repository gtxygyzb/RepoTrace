   788			if seedParam, ok := engine.GetParam(stored.Parameters, "seed"); ok {
   789				seed = int64(seedParam)
   790			} else {
   791				return auditSkip, fmt.Sprintf("AUDIT_SKIP: %s (no seed)\n", id)
   792			}
   793		} else {
   794			seed, err = strconv.ParseInt(seedStr, 10, 64)
   795			if err != nil {
   796				return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\n", id, err)
   797			}
   798		}
   799	
   800		fn, err := engine.Get(stored.ExperimentName)
   801		if err != nil {
   802			return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: experiment error: %v)\n", id, err)
   803		}
   804	
   805		rng := engine.NewRNG(seed)
   806		reexec, err := fn(stored.ExperimentName, stored.Parameters, rng)
   807		if err != nil {
   808			return auditFail, fmt.Sprintf("AUDIT_FAIL: %s (reason: experiment error: %v)\n", id, err)
   809		}
   810	
   811		maxLen := len(stored.Values)
   812		if len(reexec.Values) > maxLen {
   813			maxLen = len(reexec.Values)
   814		}
   815	
   816		var mismatches []string
   817		for i := 0; i < maxLen; i++ {
   818			storedMissing := i >= len(stored.Values)
   819			reexecMissing := i >= len(reexec.Values)
   820	
