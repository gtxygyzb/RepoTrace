   428			switch args[i] {
   429			case "--store-dir":
   430				i++
   431				if i >= len(args) {
   432					fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
   433					os.Exit(1)
   434				}
   435				storeDir = args[i]
   436			case "--format":
   437				i++
   438				if i >= len(args) {
   439					fmt.Fprintf(os.Stderr, "error: --format requires a value\n")
   440					os.Exit(1)
