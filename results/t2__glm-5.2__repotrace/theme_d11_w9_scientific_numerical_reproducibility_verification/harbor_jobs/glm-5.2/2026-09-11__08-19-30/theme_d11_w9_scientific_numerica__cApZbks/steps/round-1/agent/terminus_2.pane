   322	func cmdCompare(args []string) {
   323		if len(args) < 2 {
   324			fmt.Fprintf(os.Stderr, "usage: numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\n")
   325			os.Exit(1)
   326		}
   327	
   328		id1 := args[0]
   329		id2 := args[1]
   330		storeDir := "./results"
   331		mode := "exact"
   332		tol := compare.DefaultTolerance()
   333	
   334		for i := 2; i < len(args); i++ {
   335			switch args[i] {
   336			case "--store-dir":
   337				i++
   338				if i >= len(args) {
   339					fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
   340					os.Exit(1)
   341				}
   342				storeDir = args[i]
   343			case "--mode":
   344				i++
   345				if i >= len(args) {
   346					fmt.Fprintf(os.Stderr, "error: --mode requires a value\n")
   347					os.Exit(1)
   348				}
   349				mode = args[i]
   350			case "--abs-tol":
   351				i++
   352				if i >= len(args) {
   353					fmt.Fprintf(os.Stderr, "error: --abs-tol requires a value\n")
   354					os.Exit(1)
   355				}
   356				v, err := strconv.ParseFloat(args[i], 64)
   357				if err != nil {
   358					fmt.Fprintf(os.Stderr, "error: invalid absolute tolerance: %v\n", err)
   359					os.Exit(1)
   360				}
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '361,660p'
[?2004l   361				tol.Absolute = v
   362			case "--rel-tol":
   363				i++
   364				if i >= len(args) {
   365					fmt.Fprintf(os.Stderr, "error: --rel-tol requires a value\n")
   366					os.Exit(1)
   367				}
   368				v, err := strconv.ParseFloat(args[i], 64)
   369				if err != nil {
   370					fmt.Fprintf(os.Stderr, "error: invalid relative tolerance: %v\n", err)
   371					os.Exit(1)
   372				}
   373				tol.Relative = v
   374			default:
   375				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   376				os.Exit(1)
   377			}
   378		}
   379	
   380		store, err := storage.NewStore(storeDir)
   381		if err != nil {
   382			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   383			os.Exit(1)
   384		}
   385	
   386		a, err := store.Load(id1)
   387		if err != nil {
   388			fmt.Fprintf(os.Stderr, "load error: %v\n", err)
   389			os.Exit(1)
   390		}
   391	
   392		b, err := store.Load(id2)
   393		if err != nil {
   394			fmt.Fprintf(os.Stderr, "load error: %v\n", err)
   395			os.Exit(1)
   396		}
   397	
   398		var comparisonMode compare.ComparisonMode
   399		switch mode {
   400		case "exact":
   401			comparisonMode = compare.ModeExact
   402		case "tolerance":
   403			comparisonMode = compare.ModeTolerance
   404		default:
   405			fmt.Fprintf(os.Stderr, "error: invalid comparison mode: %s\n", mode)
   406			os.Exit(1)
   407		}
   408	
   409		cr := compare.Compare(a, b, comparisonMode, tol)
   410		fmt.Print(compare.FormatReport(cr))
   411	
   412		if cr.Match {
   413			os.Exit(0)
   414		} else {
   415			os.Exit(1)
   416		}
   417	}
   418	
   419	func cmdList(args []string) {
   420		storeDir := "./results"
   421		experimentFilter := ""
   422		tagFilters := map[string]string{}
   423	
   424		for i := 0; i < len(args); i++ {
   425			switch args[i] {
   426			case "--store-dir":
   427				i++
   428				if i >= len(args) {
   429					fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
   430					os.Exit(1)
   431				}
   432				storeDir = args[i]
   433			case "--experiment":
   434				i++
   435				if i >= len(args) {
   436					fmt.Fprintf(os.Stderr, "error: --experiment requires a value\n")
   437					os.Exit(1)
   438				}
   439				experimentFilter = args[i]
   440			case "--tag":
   441				i++
   442				if i >= len(args) {
   443					fmt.Fprintf(os.Stderr, "error: --tag requires a value\n")
   444					os.Exit(1)
   445				}
   446				k, v := parseTagFlag(args[i])
   447				tagFilters[strings.TrimPrefix(k, "tag_")] = v
   448			default:
   449				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   450				os.Exit(1)
   451			}
   452		}
   453	
   454		store, err := storage.NewStore(storeDir)
   455		if err != nil {
   456			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   457			os.Exit(1)
   458		}
   459	
   460		entries, err := store.ListResults(experimentFilter)
   461		if err != nil {
   462			fmt.Fprintf(os.Stderr, "list error: %v\n", err)
   463			os.Exit(1)
   464		}
   465	
   466		if len(tagFilters) > 0 {
   467			filtered := make([]storage.IndexEntry, 0, len(entries))
   468			for _, entry := range entries {
   469				result, err := store.Load(entry.ID)
   470				if err != nil {
   471					fmt.Fprintf(os.Stderr, "load error: %v\n", err)
   472					os.Exit(1)
   473				}
   474				if hasMatchingTags(result.Metadata, tagFilters) {
   475					filtered = append(filtered, entry)
   476				}
   477			}
   478			entries = filtered
   479		}
   480	
   481		if len(entries) == 0 {
   482			fmt.Println("No results found.")
   483			return
   484		}
   485	
   486		fmt.Printf("%-40s %-25s %s\n", "ID", "Experiment", "Timestamp")
   487		fmt.Println(strings.Repeat("-", 80))
   488		for _, entry := range entries {
   489			fmt.Printf("%-40s %-25s %s\n", entry.ID, entry.ExperimentName, entry.Timestamp.Format("2006-01-02 15:04:05"))
   490		}
   491	}
   492	
   493	func cmdExport(args []string) {
   494		if len(args) < 1 {
   495			fmt.Fprintf(os.Stderr, "usage: numeriforge export <id> --store-dir <dir> [--format json|csv|markdown]\n")
   496			os.Exit(1)
   497		}
   498	
   499		id := args[0]
   500		storeDir := "./results"
   501		format := "json"
   502	
   503		for i := 1; i < len(args); i++ {
   504			switch args[i] {
   505			case "--store-dir":
   506				i++
   507				if i >= len(args) {
   508					fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
   509					os.Exit(1)
   510				}
   511				storeDir = args[i]
   512			case "--format":
   513				i++
   514				if i >= len(args) {
   515					fmt.Fprintf(os.Stderr, "error: --format requires a value\n")
   516					os.Exit(1)
   517				}
   518				format = args[i]
   519			default:
   520				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   521				os.Exit(1)
   522			}
   523		}
   524	
   525		store, err := storage.NewStore(storeDir)
   526		if err != nil {
   527			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   528			os.Exit(1)
   529		}
   530	
   531		result, err := store.Load(id)
   532		if err != nil {
   533			fmt.Fprintf(os.Stderr, "load error: %v\n", err)
   534			os.Exit(1)
   535		}
   536	
   537		switch format {
   538		case "json":
   539			payload := exportPayload{
   540				StoredResult: result,
   541				Environment:  environmentFromMetadata(result.Metadata),
   542				Tags:         tagsFromMetadata(result.Metadata),
   543			}
   544			data, err := json.MarshalIndent(payload, "", "  ")
   545			if err != nil {
   546				fmt.Fprintf(os.Stderr, "marshal error: %v\n", err)
   547				os.Exit(1)
   548			}
   549			fmt.Println(string(data))
   550		case "csv":
   551			fmt.Printf("# id: %s\n", result.ID)
   552			fmt.Printf("# experiment: %s\n", result.ExperimentName)
   553			fmt.Printf("# timestamp: %s\n", result.Timestamp.Format("2006-01-02 15:04:05"))
   554			if seed, ok := result.Metadata["seed"]; ok {
   555				fmt.Printf("# seed: %s\n", seed)
   556			}
   557			fmt.Println("label,value")
   558			for i, v := range result.Values {
   559				label := fmt.Sprintf("value_%d", i)
   560				if i < len(result.Labels) {
   561					label = result.Labels[i]
   562				}
   563				fmt.Printf("%s,%.15e\n", label, v)
   564			}
   565		case "markdown":
   566			fmt.Printf("# %s (%s)\n", result.ExperimentName, result.ID)
   567			fmt.Println()
   568			fmt.Println("## Metadata")
   569			fmt.Printf("- timestamp: %s\n", result.Timestamp.Format("2006-01-02 15:04:05"))
   570			if seed, ok := result.Metadata["seed"]; ok {
   571				fmt.Printf("- seed: %s\n", seed)
   572			} else {
   573				fmt.Println("- seed: ")
   574			}
   575			fmt.Printf("- go_version: %s\n", metadataOrDefault(result.Metadata, "env_go_version", "unknown"))
   576			fmt.Printf("- os: %s\n", metadataOrDefault(result.Metadata, "env_os", "unknown"))
   577			fmt.Printf("- arch: %s\n", metadataOrDefault(result.Metadata, "env_arch", "unknown"))
   578			fmt.Printf("- hostname: %s\n", metadataOrDefault(result.Metadata, "env_hostname", "unknown"))
   579			fmt.Println()
   580			fmt.Println("## Results")
   581			fmt.Println("| Label | Value |")
   582			fmt.Println("|---|---|")
   583			for i, v := range result.Values {
   584				label := fmt.Sprintf("value_%d", i)
   585				if i < len(result.Labels) {
   586					label = result.Labels[i]
   587				}
   588				fmt.Printf("| %s | %.15g |\n", label, v)
   589			}
   590		default:
   591			fmt.Fprintf(os.Stderr, "unknown format: %s\n", format)
   592			os.Exit(1)
   593		}
   594	}
   595	
   596	func metadataOrDefault(metadata map[string]string, key, fallback string) string {
   597		if value, ok := metadata[key]; ok && value != "" {
   598			return value
   599		}
   600		return fallback
   601	}
   602	
   603	func cmdVerify(args []string) {
   604		if len(args) < 1 {
   605			fmt.Fprintf(os.Stderr, "usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\n")
   606			os.Exit(1)
   607		}
   608	
   609		id := args[0]
   610		storeDir := "./results"
   611		verbose := false
   612	
   613		for i := 1; i < len(args); i++ {
   614			switch args[i] {
   615			case "--verbose":
   616				verbose = true
   617			case "--store-dir":
   618				i++
   619				if i >= len(args) {
   620					fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
   621					os.Exit(1)
   622				}
   623				storeDir = args[i]
   624			default:
   625				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   626				os.Exit(1)
   627			}
   628		}
   629	
   630		store, err := storage.NewStore(storeDir)
   631		if err != nil {
   632			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   633			os.Exit(1)
   634		}
   635	
   636		status, expected, computed, err := store.Verify(id)
   637		if err != nil {
   638			fmt.Fprintf(os.Stderr, "verify error: %v\n", err)
   639			os.Exit(1)
   640		}
   641	
   642		switch status {
   643		case storage.StatusVerified:
   644			fmt.Printf("INTEGRITY_OK: %s\n", id)
   645			if verbose {
   646				fmt.Printf("Stored checksum: %s\n", expected)
   647				fmt.Printf("Computed checksum: %s\n", computed)
   648			}
