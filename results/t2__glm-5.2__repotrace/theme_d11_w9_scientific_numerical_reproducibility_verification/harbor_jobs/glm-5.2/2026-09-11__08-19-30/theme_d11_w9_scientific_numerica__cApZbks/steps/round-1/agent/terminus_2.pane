   571	func cmdVerify(args []string) {
   572		if len(args) < 1 {
   573			fmt.Fprintf(os.Stderr, "usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\n")
   574			os.Exit(1)
   575		}
   576	
   577		id := args[0]
   578		storeDir := "./results"
   579		verbose := false
   580	
   581		for i := 1; i < len(args); i++ {
   582			switch args[i] {
   583			case "--verbose":
   584				verbose = true
   585			case "--store-dir":
   586				i++
   587				if i >= len(args) {
   588					fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
   589					os.Exit(1)
   590				}
   591				storeDir = args[i]
   592			default:
   593				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   594				os.Exit(1)
   595			}
   596		}
   597	
   598		store, err := storage.NewStore(storeDir)
   599		if err != nil {
   600			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   601			os.Exit(1)
   602		}
   603	
   604		status, expected, computed, err := store.Verify(id)
   605		if err != nil {
   606			fmt.Fprintf(os.Stderr, "verify error: %v\n", err)
   607			os.Exit(1)
   608		}
   609	
   610		switch status {
   611		case storage.StatusVerified:
   612			fmt.Printf("INTEGRITY_OK: %s\n", id)
   613			if verbose {
   614				fmt.Printf("Stored checksum: %s\n", expected)
   615				fmt.Printf("Computed checksum: %s\n", computed)
   616			}
   617			os.Exit(0)
   618		case storage.StatusCorrupted:
   619			fmt.Printf("INTEGRITY_FAIL: %s\n", id)
   620			if verbose {
   621				fmt.Printf("Stored checksum: %s\n", expected)
   622				fmt.Printf("Computed checksum: %s\n", computed)
   623			}
   624			os.Exit(1)
   625		case storage.StatusNoChecksum:
   626			fmt.Printf("NO_CHECKSUM: %s\n", id)
   627			os.Exit(2)
   628		default:
   629			fmt.Fprintf(os.Stderr, "unknown verification status: %s\n", status)
   630			os.Exit(1)
   631		}
   632	}
