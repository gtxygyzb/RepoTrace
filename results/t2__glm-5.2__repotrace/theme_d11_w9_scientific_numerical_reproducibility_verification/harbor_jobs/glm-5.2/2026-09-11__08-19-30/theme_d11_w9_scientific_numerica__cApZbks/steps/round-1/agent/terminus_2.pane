   722	func cmdAuditAll(storeDir string) {
   723		store, err := storage.NewStore(storeDir)
   724		if err != nil {
   725			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   726			os.Exit(1)
   727		}
   728	
   729		entries, err := store.ListResults("")
   730		if err != nil {
   731			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   732			os.Exit(1)
   733		}
   734	
   735		passed := 0
   736		failed := 0
   737		skipped := 0
   738		total := len(entries)
   739		for _, entry := range entries {
   740			status, details := auditStoredResult(store, entry.ID)
   741			fmt.Print(details)
   742			switch status {
   743			case auditPass:
   744				passed++
   745			case auditFail:
   746				failed++
   747			case auditSkip:
   748				skipped++
   749			}
   750		}
   751	
   752		fmt.Printf("Audit Summary: %d passed, %d failed, %d skipped out of %d total\n", passed, failed, skipped, total)
   753		if failed > 0 {
   754			os.Exit(1)
   755		}
   756	}
