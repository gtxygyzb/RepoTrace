func registerMatrixExperiments() {
	Register("matrix-lu-decompose", matrixLUDecompose)
	Register("matrix-qr-decompose", matrixQRDecompose)
	Register("matrix-eigenvalue", matrixEigenvalue)
}

// Matrix is a simple dense matrix representation.
type Matrix struct {
	Rows, Cols int
	Data       []float64
}

// NewMatrix creates a zero matrix.
func NewMatrix(rows, cols int) *Matrix {
	return &Matrix{Rows: rows, Cols: cols, Data: make([]float64, rows*cols)}
}

// At returns the element at (i, j).
func (m *Matrix) At(i, j int) float64 {
	return m.Data[i*m.Cols+j]
}

// Set sets the element at (i, j).
func (m *Matrix) Set(i, j int, v float64) {
	m.Data[i*m.Cols+j] = v
}

// generateRandomMatrix creates a matrix with random entries.
// TODO: Uses GlobalRand - not reproducible. Need seed parameter.
func generateRandomMatrix(rows, cols int, scale float64) *Matrix {
	m := NewMatrix(rows, cols)
	for i := 0; i < rows*cols; i++ {
		m.Data[i] = (GlobalRand.Float64()*2 - 1) * scale
	}
	return m
}

// generateSPDMatrix creates a symmetric positive-definite matrix.
// TODO: Uses GlobalRand - not reproducible.
func generateSPDMatrix(size int, scale float64) *Matrix {
	a := generateRandomMatrix(size, size, scale)
	result := NewMatrix(size, size)
	// A^T * A + diagonal dominance
	for i := 0; i < size; i++ {
		for j := 0; j < size; j++ {
			sum := 0.0
			for k := 0; k < size; k++ {
				sum += a.At(k, i) * a.At(k, j)
			}
			result.Set(i, j, sum)
		}
		result.Set(i, i, result.At(i, i)+float64(size)*scale)
	}
	return result
}

// flattenMatrix returns a flat slice of matrix data with row-major labeling.
func flattenMatrix(m *Matrix, prefix string) ([]float64, []string) {
	values := make([]float64, 0, m.Rows*m.Cols)
	labels := make([]string, 0, m.Rows*m.Cols)
	for i := 0; i < m.Rows; i++ {
		for j := 0; j < m.Cols; j++ {
			values = append(values, m.At(i, j))
			labels = append(labels, fmt.Sprintf("%s[%d][%d]", prefix, i, j))
		}
	}
	return values, labels
}

// matrixLUDecompose performs LU decomposition with partial pivoting.
// Parameters: size (int), scale (float)
func matrixLUDecompose(name string, params []Parameter) (*Result, error) {
	sizeF, err := RequireParam(params, "size")
	if err != nil {
		return nil, err
	}
	scale, _ := GetParam(params, "scale")
	if scale == 0 {
		scale = 10.0
	}

	size := int(sizeF)
	if size <= 0 || size > 100 {
		return nil, fmt.Errorf("matrix size must be between 1 and 100, got %d", size)
	}

	a := generateRandomMatrix(size, size, scale)

	// LU decomposition with partial pivoting
	l := NewMatrix(size, size)
	u := NewMatrix(size, size)
	perm := make([]int, size)
	for i := 0; i < size; i++ {
		perm[i] = i
	}

	// Copy a into u
	copy(u.Data, a.Data)

	for k := 0; k < size; k++ {
		// Find pivot
		maxVal := math.Abs(u.At(k, k))
		maxIdx := k
		for i := k + 1; i < size; i++ {
			if math.Abs(u.At(i, k)) > maxVal {
				maxVal = math.Abs(u.At(i, k))
				maxIdx = i
			}
		}

		// Swap rows in u, l, and permutation
		if maxIdx != k {
[?2004hroot@n30009:/app# sed -n '121,380p' engine/matrix.go
[?2004l			perm[k], perm[maxIdx] = perm[maxIdx], perm[k]
			for j := 0; j < size; j++ {
				u.Data[k*size+j], u.Data[maxIdx*size+j] = u.Data[maxIdx*size+j], u.Data[k*size+j]
			}
			for j := 0; j < k; j++ {
				l.Data[k*size+j], l.Data[maxIdx*size+j] = l.Data[maxIdx*size+j], l.Data[k*size+j]
			}
		}

		l.Set(k, k, 1.0)

		if math.Abs(u.At(k, k)) < 1e-12 {
			continue
		}

		for i := k + 1; i < size; i++ {
			factor := u.At(i, k) / u.At(k, k)
			l.Set(i, k, factor)
			for j := k; j < size; j++ {
				u.Set(i, j, u.At(i, j)-factor*u.At(k, j))
			}
		}
	}

	// Compute residual: ||PA - LU|| / ||A||
	residual := computeLUResidual(a, l, u, perm)

	// Flatten all matrices into result
	lValues, lLabels := flattenMatrix(l, "L")
	uValues, uLabels := flattenMatrix(u, "U")

	allValues := append([]float64{residual, float64(size)}, lValues...)
	allValues = append(allValues, uValues...)
	allLabels := append([]string{"residual_norm", "matrix_size"}, lLabels...)
	allLabels = append(allLabels, uLabels...)

	return &Result{
		ExperimentName: name,
		Timestamp:      time.Now(),
		Parameters:     params,
		Values:         allValues,
		Labels:         allLabels,
		Metadata:       map[string]string{"method": "partial_pivoting", "matrix_type": "random_dense"},
	}, nil
}

func computeLUResidual(a, l, u *Matrix, perm []int) float64 {
	size := a.Rows
	normA := 0.0
	normDiff := 0.0
	for i := 0; i < size; i++ {
		for j := 0; j < size; j++ {
			// Compute (LU)[i][j]
			lu := 0.0
			for k := 0; k < size; k++ {
				lu += l.At(i, k) * u.At(k, j)
			}
			// Compare with PA[i][j]
			pa := a.At(perm[i], j)
			normDiff += (pa - lu) * (pa - lu)
			normA += pa * pa
		}
	}
	if normA < 1e-300 {
		return 0
	}
	return math.Sqrt(normDiff) / math.Sqrt(normA)
}

// matrixQRDecompose performs QR decomposition via modified Gram-Schmidt.
// Parameters: rows (int), cols (int), scale (float)
func matrixQRDecompose(name string, params []Parameter) (*Result, error) {
	rowsF, err := RequireParam(params, "rows")
	if err != nil {
		return nil, err
	}
	colsF, err := RequireParam(params, "cols")
	if err != nil {
		return nil, err
	}
	scale, _ := GetParam(params, "scale")
	if scale == 0 {
		scale = 10.0
	}

	rows := int(rowsF)
	cols := int(colsF)
	if rows <= 0 || cols <= 0 || rows > 50 || cols > 50 {
		return nil, fmt.Errorf("matrix dimensions must be between 1 and 50")
	}

	a := generateRandomMatrix(rows, cols, scale)

	// Modified Gram-Schmidt QR
	q := NewMatrix(rows, cols)
	r := NewMatrix(cols, cols)

	// Copy columns of A
	for j := 0; j < cols; j++ {
		for i := 0; i < rows; i++ {
			q.Set(i, j, a.At(i, j))
		}
	}

	for j := 0; j < cols; j++ {
		// Orthogonalize against previous columns
		for k := 0; k < j; k++ {
			dot := 0.0
			for i := 0; i < rows; i++ {
				dot += q.At(i, k) * q.At(i, j)
			}
			r.Set(k, j, dot)
			for i := 0; i < rows; i++ {
				q.Set(i, j, q.At(i, j)-dot*q.At(i, k))
			}
		}

		// Normalize
		norm := 0.0
		for i := 0; i < rows; i++ {
			norm += q.At(i, j) * q.At(i, j)
		}
		norm = math.Sqrt(norm)
		r.Set(j, j, norm)

		if norm > 1e-12 {
			for i := 0; i < rows; i++ {
				q.Set(i, j, q.At(i, j)/norm)
			}
		}
	}

	// Compute residual ||A - QR||/||A||
	normA := 0.0
	normDiff := 0.0
	for i := 0; i < rows; i++ {
		for j := 0; j < cols; j++ {
			qr := 0.0
			for k := 0; k < cols; k++ {
				qr += q.At(i, k) * r.At(k, j)
			}
			diff := a.At(i, j) - qr
			normDiff += diff * diff
			normA += a.At(i, j) * a.At(i, j)
		}
	}
	residual := 0.0
	if normA > 1e-300 {
		residual = math.Sqrt(normDiff) / math.Sqrt(normA)
	}

	// Orthogonality check: ||Q^T Q - I||
	orthoErr := 0.0
	for i := 0; i < cols; i++ {
		for j := 0; j < cols; j++ {
			dot := 0.0
			for k := 0; k < rows; k++ {
				dot += q.At(k, i) * q.At(k, j)
			}
			target := 0.0
			if i == j {
				target = 1.0
			}
			orthoErr += (dot - target) * (dot - target)
		}
	}
	orthoErr = math.Sqrt(orthoErr)

	allValues := []float64{residual, orthoErr, float64(rows), float64(cols)}
	allLabels := []string{"residual_norm", "orthogonality_error", "rows", "cols"}

	return &Result{
		ExperimentName: name,
		Timestamp:      time.Now(),
		Parameters:     params,
		Values:         allValues,
		Labels:         allLabels,
		Metadata:       map[string]string{"method": "modified_gram_schmidt", "matrix_type": "random_dense"},
	}, nil
}

// matrixEigenvalue estimates the dominant eigenvalue using power iteration.
// Parameters: size (int), scale (float), iterations (int)
func matrixEigenvalue(name string, params []Parameter) (*Result, error) {
	sizeF, err := RequireParam(params, "size")
	if err != nil {
		return nil, err
	}
	scale, _ := GetParam(params, "scale")
	if scale == 0 {
		scale = 10.0
	}
	itersF, _ := GetParam(params, "iterations")
	if itersF == 0 {
		itersF = 1000
	}

	size := int(sizeF)
	iters := int(itersF)

	spd := generateSPDMatrix(size, scale)

	// Power iteration
	v := make([]float64, size)
	for i := range v {
		v[i] = GlobalRand.Float64()
	}
	// Normalize
	norm := 0.0
	for _, x := range v {
		norm += x * x
	}
	norm = math.Sqrt(norm)
	for i := range v {
		v[i] /= norm
	}

	eigenvalue := 0.0
	converged := false
	var convergenceIter int

	for iter := 0; iter < iters; iter++ {
		// w = A*v
		w := make([]float64, size)
		for i := 0; i < size; i++ {
			for j := 0; j < size; j++ {
				w[i] += spd.At(i, j) * v[j]
			}
		}

		// Rayleigh quotient
		newEig := 0.0
		for i := 0; i < size; i++ {
			newEig += v[i] * w[i]
		}

		// Normalize w
		norm = 0.0
		for _, x := range w {
			norm += x * x
		}
		norm = math.Sqrt(norm)
		for i := range w {
			w[i] /= norm
		}

		if math.Abs(newEig-eigenvalue) < 1e-12 {
			converged = true
			convergenceIter = iter
			eigenvalue = newEig
			break
		}

		eigenvalue = newEig
		v = w
	}

	if !converged {
		convergenceIter = iters
	}
