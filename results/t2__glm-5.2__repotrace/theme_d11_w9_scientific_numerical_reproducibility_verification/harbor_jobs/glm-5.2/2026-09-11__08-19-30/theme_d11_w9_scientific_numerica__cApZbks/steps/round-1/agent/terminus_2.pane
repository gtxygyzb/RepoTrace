    46	func main() {
    47		if len(os.Args) < 2 {
    48			usage()
    49			os.Exit(1)
    50		}
    51	
    52		cmd := os.Args[1]
    53	
    54		switch cmd {
    55		case "run":
    56			cmdRun(os.Args[2:])
    57		case "compare":
    58			cmdCompare(os.Args[2:])
    59		case "list":
    60			cmdList(os.Args[2:])
    61		case "export":
    62			cmdExport(os.Args[2:])
    63		case "verify":
