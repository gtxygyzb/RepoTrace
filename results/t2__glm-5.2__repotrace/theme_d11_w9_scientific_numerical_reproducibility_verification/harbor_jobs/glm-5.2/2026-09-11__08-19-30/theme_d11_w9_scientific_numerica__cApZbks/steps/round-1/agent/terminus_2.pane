   729	
   730		status, expected, computed, err := store.Verify(id)
   731		if err != nil {
   732			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check error: %v)\n", id, err)
   733		}
   734		if status == storage.StatusNoChecksum {
   735			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check failed: no checksum)\n", id)
   736		}
   737		if status == storage.StatusCorrupted {
   738			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check failed: expected=%s computed=%s)\n", id, expected, computed)
   739		}
   740	
