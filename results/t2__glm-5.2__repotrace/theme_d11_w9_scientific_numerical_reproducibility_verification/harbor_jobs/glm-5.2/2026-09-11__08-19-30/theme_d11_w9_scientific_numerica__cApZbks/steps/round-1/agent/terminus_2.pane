[?2004l     1	package config
     2	
     3	import (
     4		"bufio"
     5		"fmt"
     6		"os"
     7		"strconv"
     8		"strings"
     9	
    10		"numeriforge/engine"
    11	)
    12	
    13	// Config represents parsed experiment configuration.
    14	type Config struct {
    15		Experiment string
    16		OutputDir  string
    17		Params     []engine.Parameter
    18		Raw        map[string]string
    19	}
    20	
    21	// ParseINI reads a simple INI-style configuration file.
    22	// Format:
    23	//   experiment = mc-estimate-pi
    24	//   output_dir = ./results
    25	//   param.samples = 100000
    26	//   param.lower_bound = 0.0
    27	func ParseINI(path string) (*Config, error) {
    28		f, err := os.Open(path)
    29		if err != nil {
    30			return nil, fmt.Errorf("cannot open config: %w", err)
    31		}
    32		defer f.Close()
    33	
    34		cfg := &Config{
    35			Raw: make(map[string]string),
    36		}
    37	
    38		scanner := bufio.NewScanner(f)
    39		for scanner.Scan() {
    40			line := strings.TrimSpace(scanner.Text())
    41			if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, ";") {
    42				continue
    43			}
    44	
    45			parts := strings.SplitN(line, "=", 2)
    46			if len(parts) != 2 {
    47				continue
    48			}
    49	
    50			key := strings.TrimSpace(parts[0])
    51			value := strings.TrimSpace(parts[1])
    52			cfg.Raw[key] = value
    53	
    54			switch key {
    55			case "experiment":
    56				cfg.Experiment = value
    57			case "output_dir":
    58				cfg.OutputDir = value
    59			default:
    60				if strings.HasPrefix(key, "param.") {
    61					paramName := strings.TrimPrefix(key, "param.")
    62					paramValue, err := strconv.ParseFloat(value, 64)
    63					if err != nil {
    64						return nil, fmt.Errorf("invalid parameter value for %s: %s", paramName, value)
    65					}
    66					cfg.Params = append(cfg.Params, engine.Parameter{
    67						Name:  paramName,
    68						Value: paramValue,
    69					})
    70				}
    71			}
    72		}
    73	
    74		if err := scanner.Err(); err != nil {
    75			return nil, fmt.Errorf("read error: %w", err)
    76		}
    77	
    78		if cfg.Experiment == "" {
    79			return nil, fmt.Errorf("missing required field: experiment")
    80		}
    81		if cfg.OutputDir == "" {
    82			cfg.OutputDir = "./results"
    83		}
    84	
    85		return cfg, nil
    86	}
    87	
    88	// ParseParams converts a param string slice (key=value pairs) into Parameters.
    89	func ParseParams(raw []string) ([]engine.Parameter, error) {
    90		var params []engine.Parameter
    91		for _, kv := range raw {
    92			parts := strings.SplitN(kv, "=", 2)
    93			if len(parts) != 2 {
    94				return nil, fmt.Errorf("invalid parameter: %s (expected key=value)", kv)
    95			}
    96			val, err := strconv.ParseFloat(parts[1], 64)
    97			if err != nil {
    98				return nil, fmt.Errorf("invalid parameter value for %s: %s", parts[0], parts[1])
    99			}
   100			params = append(params, engine.Parameter{Name: parts[0], Value: val})
   101		}
   102		return params, nil
   103	}
