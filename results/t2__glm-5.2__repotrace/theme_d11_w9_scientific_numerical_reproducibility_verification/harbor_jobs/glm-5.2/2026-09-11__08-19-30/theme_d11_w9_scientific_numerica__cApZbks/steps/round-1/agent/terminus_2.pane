    75	// environmentMetadata returns the environment fingerprint metadata required for
    76	// reproducible experiment traces.
    77	func environmentMetadata() map[string]string {
    78		hostname, err := os.Hostname()
    79		if err != nil {
    80			hostname = "unknown"
    81		}
    82		return map[string]string{
    83			"env_go_version": runtime.Version(),
    84			"env_os":         runtime.GOOS,
    85			"env_arch":       runtime.GOARCH,
    86			"env_hostname":   hostname,
    87		}
    88	}
    89	
    90	// environmentFromMetadata aggregates stored environment fingerprint metadata
    91	// into an export-friendly object.
    92	type environmentInfo struct {
    93		GoVersion string `json:"go_version"`
    94		OS        string `json:"os"`
    95		Arch      string `json:"arch"`
    96		Hostname  string `json:"hostname"`
    97	}
    98	
    99	func environmentFromMetadata(metadata map[string]string) environmentInfo {
   100		return environmentInfo{
   101			GoVersion: metadata["env_go_version"],
   102			OS:        metadata["env_os"],
   103			Arch:      metadata["env_arch"],
   104			Hostname:  metadata["env_hostname"],
   105		}
   106	}
   107	
   108	type exportPayload struct {
   109		*storage.StoredResult
   110		Environment environmentInfo `json:"environment"`
   111	}
