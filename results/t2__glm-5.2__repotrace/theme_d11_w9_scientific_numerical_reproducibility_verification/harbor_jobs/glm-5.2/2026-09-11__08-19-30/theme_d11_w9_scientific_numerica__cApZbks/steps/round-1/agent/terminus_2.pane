   722	func auditStoredResult(store *storage.Store, id string) (bool, string) {
   723		stored, err := store.Load(id)
   724		if err != nil {
   725			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: load error: %v)\n", id, err)
   726		}
   727	
   728		warnEnvMismatch(stored)
   729	
   730		status, expected, computed, err := store.Verify(id)
   731		if err != nil {
   732			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check error: %v)\n", id, err)
   733		}
   734		if status == storage.StatusNoChecksum {
   735			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check failed: no checksum)\n", id)
   736		}
   737		if status == storage.StatusCorrupted {
   738			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: integrity check failed: expected=%s computed=%s)\n", id, expected, computed)
   739		}
   740	
   741		seedStr, ok := stored.Metadata["seed"]
   742		if !ok {
   743			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: missing seed in metadata)\n", id)
   744		}
   745		seed, err := strconv.ParseInt(seedStr, 10, 64)
   746		if err != nil {
   747			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\n", id, err)
   748		}
   749	
   750		fn, err := engine.Get(stored.ExperimentName)
   751		if err != nil {
   752			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: experiment error: %v)\n", id, err)
   753		}
   754	
   755		rng := engine.NewRNG(seed)
   756		reexec, err := fn(stored.ExperimentName, stored.Parameters, rng)
   757		if err != nil {
   758			return false, fmt.Sprintf("AUDIT_FAIL: %s (reason: experiment error: %v)\n", id, err)
   759		}
   760	
   761		maxLen := len(stored.Values)
   762		if len(reexec.Values) > maxLen {
   763			maxLen = len(reexec.Values)
   764		}
   765	
   766		var mismatches []string
   767		for i := 0; i < maxLen; i++ {
   768			storedMissing := i >= len(stored.Values)
   769			reexecMissing := i >= len(reexec.Values)
   770	
   771			var storedVal, reexecVal string
   772			if storedMissing {
   773				storedVal = "<missing>"
   774			} else {
   775				storedVal = strconv.FormatFloat(stored.Values[i], 'g', -1, 64)
   776			}
   777			if reexecMissing {
   778				reexecVal = "<missing>"
   779			} else {
   780				reexecVal = strconv.FormatFloat(reexec.Values[i], 'g', -1, 64)
   781			}
   782	
   783			if storedMissing || reexecMissing || math.Float64bits(stored.Values[i]) != math.Float64bits(reexec.Values[i]) {
   784				mismatches = append(mismatches, fmt.Sprintf("  value[%d]: stored=%s, re-executed=%s", i, storedVal, reexecVal))
   785			}
   786		}
   787	
   788		if len(mismatches) == 0 {
   789			return true, fmt.Sprintf("AUDIT_PASS: %s\n", id)
   790		}
   791	
   792		var sb strings.Builder
   793		sb.WriteString(fmt.Sprintf("AUDIT_FAIL: %s\n", id))
   794		for _, m := range mismatches {
   795			sb.WriteString(m)
   796			sb.WriteByte('\n')
   797		}
   798		return false, sb.String()
   799	}
