   494	func cmdVerify(args []string) {
   495		if len(args) < 1 {
   496			fmt.Fprintf(os.Stderr, "usage: numeriforge verify <result_id> --store-dir <dir>\n")
   497			os.Exit(1)
   498		}
   499	
   500		id := args[0]
   501		storeDir := "./results"
   502	
   503		for i := 1; i < len(args); i++ {
   504			switch args[i] {
   505			case "--store-dir":
   506				i++
   507				if i >= len(args) {
   508					fmt.Fprintf(os.Stderr, "error: --store-dir requires a value\n")
   509					os.Exit(1)
   510				}
   511				storeDir = args[i]
   512			default:
   513				fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
   514				os.Exit(1)
   515			}
   516		}
   517	
   518		store, err := storage.NewStore(storeDir)
   519		if err != nil {
   520			fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
   521			os.Exit(1)
   522		}
   523	
   524		status, expected, computed, err := store.Verify(id)
   525		if err != nil {
   526			fmt.Fprintf(os.Stderr, "verify error: %v\n", err)
   527			os.Exit(1)
   528		}
   529	
   530		switch status {
   531		case storage.StatusVerified:
   532			fmt.Printf("VERIFIED: %s\n", id)
   533			os.Exit(0)
   534		case storage.StatusCorrupted:
   535			fmt.Printf("CORRUPTED: %s (expected=%s, computed=%s)\n", id, expected, computed)
   536			os.Exit(1)
   537		case storage.StatusNoChecksum:
   538			fmt.Printf("NO_CHECKSUM: %s\n", id)
   539			os.Exit(2)
   540		default:
   541			fmt.Fprintf(os.Stderr, "unknown verification status: %s\n", status)
   542			os.Exit(1)
   543		}
   544	}
