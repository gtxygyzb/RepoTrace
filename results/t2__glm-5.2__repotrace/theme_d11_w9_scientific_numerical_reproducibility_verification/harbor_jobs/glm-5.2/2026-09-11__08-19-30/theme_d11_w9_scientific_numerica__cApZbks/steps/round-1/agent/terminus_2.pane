[?2004l     1	package engine
     2	
     3	import (
     4		"math"
     5		"time"
     6	)
     7	
     8	func registerMonteCarloExperiments() {
     9		Register("mc-estimate-pi", mcEstimatePi)
    10		Register("mc-integral", mcIntegral)
    11		Register("mc-importance-sampling", mcImportanceSampling)
    12	}
    13	
    14	// mcEstimatePi estimates pi using the classic circle/square Monte Carlo method.
    15	// Parameters: samples (int)
    16	// TODO: This uses GlobalRand which makes results non-reproducible.
    17	//       Need to accept a seed parameter and create a local random source.
    18	func mcEstimatePi(name string, params []Parameter) (*Result, error) {
    19		samplesF, err := RequireParam(params, "samples")
    20		if err != nil {
    21			return nil, err
    22		}
    23		samples := int(samplesF)
    24		if samples <= 0 {
    25			samples = 100000
    26		}
    27	
    28		inside := 0
    29		for i := 0; i < samples; i++ {
    30			x := GlobalRand.Float64()
    31			y := GlobalRand.Float64()
    32			if x*x+y*y <= 1.0 {
    33				inside++
    34			}
    35		}
    36	
    37		piEstimate := 4.0 * float64(inside) / float64(samples)
    38		errorMargin := math.Abs(piEstimate - math.Pi)
    39	
    40		return &Result{
    41			ExperimentName: name,
    42			Timestamp:      time.Now(),
    43			Parameters:     params,
    44			Values:         []float64{piEstimate, errorMargin, float64(inside), float64(samples)},
    45			Labels:         []string{"pi_estimate", "error_margin", "inside_count", "total_samples"},
    46			Metadata:       map[string]string{"method": "circle_square"},
    47		}, nil
    48	}
    49	
    50	// mcIntegral performs numerical integration of f(x) = sin(x)*exp(-x^2/2) over [a,b]
    51	// using simple Monte Carlo sampling.
    52	// Parameters: samples (int), lower_bound (float), upper_bound (float)
    53	// TODO: Uses GlobalRand - not reproducible.
    54	func mcIntegral(name string, params []Parameter) (*Result, error) {
    55		samplesF, err := RequireParam(params, "samples")
    56		if err != nil {
    57			return nil, err
    58		}
    59		lower, err := RequireParam(params, "lower_bound")
    60		if err != nil {
    61			return nil, err
    62		}
    63		upper, err := RequireParam(params, "upper_bound")
    64		if err != nil {
    65			return nil, err
    66		}
    67	
    68		samples := int(samplesF)
    69		if samples <= 0 {
    70			samples = 100000
    71		}
    72	
    73		width := upper - lower
    74		sum := 0.0
    75		sumSq := 0.0
    76		for i := 0; i < samples; i++ {
    77			x := lower + GlobalRand.Float64()*width
    78			fx := math.Sin(x) * math.Exp(-x*x/2.0)
    79			sum += fx
    80			sumSq += fx * fx
    81		}
    82	
    83		mean := sum / float64(samples)
    84		integral := width * mean
    85		variance := (sumSq/float64(samples) - mean*mean) / float64(samples)
    86		stdErr := math.Sqrt(math.Abs(variance)) * width
    87	
    88		return &Result{
    89			ExperimentName: name,
    90			Timestamp:      time.Now(),
    91			Parameters:     params,
    92			Values:         []float64{integral, stdErr, mean, variance},
    93			Labels:         []string{"integral", "std_error", "mean_value", "variance"},
    94			Metadata:       map[string]string{"method": "simple_mc", "integrand": "sin(x)*exp(-x^2/2)"},
    95		}, nil
    96	}
    97	
    98	// mcImportanceSampling performs Monte Carlo integration using importance sampling
    99	// with a Gaussian proposal distribution.
   100	// Parameters: samples (int), lower_bound (float), upper_bound (float), proposal_mean (float), proposal_std (float)
   101	// TODO: Uses GlobalRand - not reproducible.
   102	func mcImportanceSampling(name string, params []Parameter) (*Result, error) {
   103		samplesF, err := RequireParam(params, "samples")
   104		if err != nil {
   105			return nil, err
   106		}
   107		lower, err := RequireParam(params, "lower_bound")
   108		if err != nil {
   109			return nil, err
   110		}
   111		upper, err := RequireParam(params, "upper_bound")
   112		if err != nil {
   113			return nil, err
   114		}
   115		pMean, err := RequireParam(params, "proposal_mean")
   116		if err != nil {
   117			return nil, err
   118		}
   119		pStd, err := RequireParam(params, "proposal_std")
   120		if err != nil {
   121			return nil, err
   122		}
   123	
   124		samples := int(samplesF)
   125		if samples <= 0 {
   126			samples = 100000
   127		}
   128	
   129		// Target: f(x) = sin(x)*exp(-x^2/2) on [lower, upper]
   130		// Proposal: truncated Gaussian N(pMean, pStd^2) on [lower, upper]
   131		sum := 0.0
   132		sumSq := 0.0
   133		accepted := 0
   134	
   135		for i := 0; i < samples; i++ {
   136			// Generate from truncated Gaussian via rejection
   137			var x float64
   138			for {
   139				x = GlobalRand.NormFloat64()*pStd + pMean
   140				if x >= lower && x <= upper {
   141					break
   142				}
   143			}
   144	
   145			// Target function
   146			fx := math.Sin(x) * math.Exp(-x*x/2.0)
   147	
   148			// Proposal density (unnormalized Gaussian)
   149			qx := math.Exp(-(x-pMean)*(x-pMean) / (2.0 * pStd * pStd))
   150	
   151			if qx > 1e-300 {
   152				w := fx / qx
   153				sum += w
   154				sumSq += w * w
   155				accepted++
   156			}
   157		}
   158	
   159		if accepted == 0 {
   160			return &Result{
   161				ExperimentName: name,
   162				Timestamp:      time.Now(),
   163				Parameters:     params,
   164				Values:         []float64{0, 0, 0, 0},
   165				Labels:         []string{"integral", "std_error", "effective_samples", "acceptance_rate"},
   166				Metadata:       map[string]string{"method": "importance_sampling", "status": "no_accepted_samples"},
   167			}, nil
   168		}
   169	
   170		mean := sum / float64(accepted)
   171		variance := (sumSq/float64(accepted) - mean*mean) / float64(accepted)
   172		stdErr := math.Sqrt(math.Abs(variance))
   173		// Normalize: the integral estimate needs scaling by the proposal normalization constant
   174		// For simplicity, we report the weighted mean as the integral estimate
   175		integral := mean * pStd * math.Sqrt(2.0*math.Pi)
   176		accRate := float64(accepted) / float64(samples)
   177	
   178		return &Result{
   179			ExperimentName: name,
   180			Timestamp:      time.Now(),
   181			Parameters:     params,
   182			Values:         []float64{integral, stdErr, float64(accepted), accRate},
   183			Labels:         []string{"integral", "std_error", "effective_samples", "acceptance_rate"},
   184			Metadata:       map[string]string{"method": "importance_sampling", "integrand": "sin(x)*exp(-x^2/2)"},
   185		}, nil
   186	}
