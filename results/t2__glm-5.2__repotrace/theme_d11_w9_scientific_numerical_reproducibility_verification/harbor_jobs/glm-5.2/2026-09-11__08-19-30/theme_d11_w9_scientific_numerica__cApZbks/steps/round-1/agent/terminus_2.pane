[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"strings"

	"numeriforge/compare"
	"numeriforge/config"
	"numeriforge/engine"
	"numeriforge/storage"
)

func usage() {
	fmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform

Usage:
  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>]
  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]
  numeriforge list [--experiment <name>] [--store-dir <dir>]
  numeriforge export <result_id> --store-dir <dir> [--format json|csv]
  numeriforge verify <result_id> --store-dir <dir>

Commands:
  run       Run an experiment and store the result
  compare   Compare two stored results
  list      List stored experiment results
  export    Export a result to a different format
  verify    Verify result integrity (TODO: not yet implemented)

Available experiments:
`)
	for _, name := range engine.List() {
		fmt.Fprintf(os.Stderr, "  %s\n", name)
	}
}

func main() {
	if len(os.Args) < 2 {
		usage()
		os.Exit(1)
	}

	cmd := os.Args[1]

	switch cmd {
	case "run":
		cmdRun(os.Args[2:])
	case "compare":
		cmdCompare(os.Args[2:])
	case "list":
		cmdList(os.Args[2:])
	case "export":
		cmdExport(os.Args[2:])
	case "verify":
		cmdVerify(os.Args[2:])
	case "help", "--help", "-h":
		usage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
		usage()
		os.Exit(1)
	}
}

func cmdRun(args []string) {
	var experimentName, outputDir, configPath string
	var paramStrs []string

	// TODO: Add --seed flag for reproducible experiments.
	// Currently there is no way to set a seed, making all stochastic
	// experiments non-reproducible.

	for i := 0; i < len(args); i++ {
		switch args[i] {
		case "--experiment":
			i++
			if i < len(args) {
				experimentName = args[i]
			}
		case "--output-dir":
			i++
			if i < len(args) {
				outputDir = args[i]
			}
		case "--config":
			i++
			if i < len(args) {
				configPath = args[i]
			}
		case "--param":
			i++
			if i < len(args) {
				paramStrs = append(paramStrs, args[i])
			}
		}
	}

	// Load config file if specified
	if configPath != "" {
		cfg, err := config.ParseINI(configPath)
		if err != nil {
			fmt.Fprintf(os.Stderr, "config error: %v\n", err)
			os.Exit(1)
		}
		if experimentName == "" {
			experimentName = cfg.Experiment
		}
		if outputDir == "" {
			outputDir = cfg.OutputDir
		}
		// Config params are used as defaults; CLI params override
		cliParams, _ := config.ParseParams(paramStrs)
		cliParamMap := make(map[string]float64)
		for _, p := range cliParams {
			cliParamMap[p.Name] = p.Value
		}
		for _, p := range cfg.Params {
			if _, exists := cliParamMap[p.Name]; !exists {
				cliParams = append(cliParams, p)
			}
		}
		paramStrs = nil
		for _, p := range cliParams {
			paramStrs = append(paramStrs, fmt.Sprintf("%s=%f", p.Name, p.Value))
		}
	}

	if experimentName == "" {
		fmt.Fprintf(os.Stderr, "error: --experiment is required\n")
		os.Exit(1)
	}
	if outputDir == "" {
		outputDir = "./results"
	}

	params, err := config.ParseParams(paramStrs)
	if err != nil {
		fmt.Fprintf(os.Stderr, "parameter error: %v\n", err)
		os.Exit(1)
	}

	fn, err := engine.Get(experimentName)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	result, err := fn(experimentName, params)
	if err != nil {
		fmt.Fprintf(os.Stderr, "experiment error: %v\n", err)
		os.Exit(1)
	}

	store, err := storage.NewStore(outputDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	id, err := store.Save(result)
	if err != nil {
		fmt.Fprintf(os.Stderr, "save error: %v\n", err)
		os.Exit(1)
	}

	fmt.Printf("Experiment: %s\n", experimentName)
	fmt.Printf("Result ID: %s\n", id)
	fmt.Printf("Values:\n")
	for i, v := range result.Values {
		label := fmt.Sprintf("[%d]", i)
		if i < len(result.Labels) {
			label = result.Labels[i]
		}
		fmt.Printf("  %s = %.15e\n", label, v)
	}
}

func cmdCompare(args []string) {
	if len(args) < 2 {
		fmt.Fprintf(os.Stderr, "usage: numeriforge compare <id1> <id2> --store-dir <dir> [--mode exact|tolerance]\n")
		os.Exit(1)
	}

	id1, id2 := args[0], args[1]
	storeDir := "./results"
	mode := compare.ModeExact
	tol := compare.DefaultTolerance()

	for i := 2; i < len(args); i++ {
		switch args[i] {
		case "--store-dir":
			i++
			if i < len(args) {
				storeDir = args[i]
			}
		case "--mode":
			i++
			if i < len(args) {
				switch args[i] {
				case "exact":
					mode = compare.ModeExact
				case "tolerance":
					mode = compare.ModeTolerance
				default:
					fmt.Fprintf(os.Stderr, "unknown comparison mode: %s\n", args[i])
					os.Exit(1)
				}
			}
		case "--abs-tol":
			i++
			if i < len(args) {
				fmt.Sscanf(args[i], "%f", &tol.Absolute)
			}
		case "--rel-tol":
			i++
			if i < len(args) {
				fmt.Sscanf(args[i], "%f", &tol.Relative)
			}
		}
	}

	store, err := storage.NewStore(storeDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	a, err := store.Load(id1)
	if err != nil {
		fmt.Fprintf(os.Stderr, "load error for %s: %v\n", id1, err)
		os.Exit(1)
	}
	b, err := store.Load(id2)
	if err != nil {
		fmt.Fprintf(os.Stderr, "load error for %s: %v\n", id2, err)
		os.Exit(1)
	}

	cr := compare.Compare(a, b, mode, tol)
	fmt.Print(compare.FormatReport(cr))

	if cr.Match {
		os.Exit(0)
	} else {
		os.Exit(1)
	}
}

