[?2004l     1	package main
     2	
     3	import (
     4		"encoding/json"
     5		"fmt"
     6		"os"
     7		"strings"
     8	
     9		"numeriforge/compare"
    10		"numeriforge/config"
    11		"numeriforge/engine"
    12		"numeriforge/storage"
    13	)
    14	
    15	func usage() {
    16		fmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform
    17	
    18	Usage:
    19	  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>]
    20	  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]
    21	  numeriforge list [--experiment <name>] [--store-dir <dir>]
    22	  numeriforge export <result_id> --store-dir <dir> [--format json|csv]
    23	  numeriforge verify <result_id> --store-dir <dir>
    24	
    25	Commands:
    26	  run       Run an experiment and store the result
    27	  compare   Compare two stored results
    28	  list      List stored experiment results
    29	  export    Export a result to a different format
    30	  verify    Verify result integrity (TODO: not yet implemented)
    31	
    32	Available experiments:
    33	`)
    34		for _, name := range engine.List() {
    35			fmt.Fprintf(os.Stderr, "  %s\n", name)
    36		}
    37	}
    38	
    39	func main() {
    40		if len(os.Args) < 2 {
    41			usage()
    42			os.Exit(1)
    43		}
    44	
    45		cmd := os.Args[1]
    46	
    47		switch cmd {
    48		case "run":
    49			cmdRun(os.Args[2:])
    50		case "compare":
    51			cmdCompare(os.Args[2:])
    52		case "list":
    53			cmdList(os.Args[2:])
    54		case "export":
    55			cmdExport(os.Args[2:])
    56		case "verify":
    57			cmdVerify(os.Args[2:])
    58		case "help", "--help", "-h":
    59			usage()
    60		default:
    61			fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
    62			usage()
    63			os.Exit(1)
    64		}
    65	}
    66	
    67	func cmdRun(args []string) {
    68		var experimentName, outputDir, configPath string
    69		var paramStrs []string
    70	
    71		// TODO: Add --seed flag for reproducible experiments.
    72		// Currently there is no way to set a seed, making all stochastic
    73		// experiments non-reproducible.
    74	
    75		for i := 0; i < len(args); i++ {
    76			switch args[i] {
    77			case "--experiment":
    78				i++
    79				if i < len(args) {
    80					experimentName = args[i]
    81				}
    82			case "--output-dir":
    83				i++
    84				if i < len(args) {
    85					outputDir = args[i]
    86				}
    87			case "--config":
    88				i++
    89				if i < len(args) {
    90					configPath = args[i]
    91				}
    92			case "--param":
    93				i++
    94				if i < len(args) {
    95					paramStrs = append(paramStrs, args[i])
    96				}
    97			}
    98		}
    99	
   100		// Load config file if specified
   101		if configPath != "" {
   102			cfg, err := config.ParseINI(configPath)
   103			if err != nil {
   104				fmt.Fprintf(os.Stderr, "config error: %v\n", err)
   105				os.Exit(1)
   106			}
   107			if experimentName == "" {
   108				experimentName = cfg.Experiment
   109			}
   110			if outputDir == "" {
   111				outputDir = cfg.OutputDir
   112			}
   113			// Config params are used as defaults; CLI params override
   114			cliParams, _ := config.ParseParams(paramStrs)
   115			cliParamMap := make(map[string]float64)
   116			for _, p := range cliParams {
   117				cliParamMap[p.Name] = p.Value
   118			}
   119			for _, p := range cfg.Params {
   120				if _, exists := cliParamMap[p.Name]; !exists {
   121					cliParams = append(cliParams, p)
   122				}
   123			}
   124			paramStrs = nil
   125			for _, p := range cliParams {
   126				paramStrs = append(paramStrs, fmt.Sprintf("%s=%f", p.Name, p.Value))
   127			}
   128		}
   129	
   130		if experimentName == "" {
   131			fmt.Fprintf(os.Stderr, "error: --experiment is required\n")
   132			os.Exit(1)
   133		}
   134		if outputDir == "" {
   135			outputDir = "./results"
   136		}
   137	
   138		params, err := config.ParseParams(paramStrs)
