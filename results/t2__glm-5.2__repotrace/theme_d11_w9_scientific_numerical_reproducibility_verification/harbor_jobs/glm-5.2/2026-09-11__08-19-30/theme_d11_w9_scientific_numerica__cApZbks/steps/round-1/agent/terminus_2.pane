[?2004l     1	package compare
     2	
     3	import (
     4		"fmt"
     5		"math"
     6		"strings"
     7	
     8		"numeriforge/storage"
     9	)
    10	
    11	// ComparisonMode determines how results are compared.
    12	type ComparisonMode int
    13	
    14	const (
    15		// ModeExact uses exact float equality (legacy behavior).
    16		ModeExact ComparisonMode = iota
    17		// ModeTolerance uses configurable absolute and relative tolerance.
    18		ModeTolerance
    19	)
    20	
    21	// Tolerance defines comparison thresholds.
    22	type Tolerance struct {
    23		Absolute float64
    24		Relative float64
    25	}
    26	
    27	// DefaultTolerance returns the spec defaults for scientific comparisons.
    28	func DefaultTolerance() Tolerance {
    29		return Tolerance{
    30			Absolute: 1e-10,
    31			Relative: 1e-8,
    32		}
    33	}
    34	
    35	// ComparisonResult holds the outcome of comparing two experiment results.
    36	type ComparisonResult struct {
    37		Match        bool
    38		TotalPairs   int
    39		MatchedPairs int
    40		Mismatches   []Mismatch
    41		Mode         ComparisonMode
    42		Tolerance    Tolerance
    43		Summary      string
    44	}
    45	
    46	// Mismatch records a single value pair that didn't match.
    47	type Mismatch struct {
    48		Index   int
    49		Label   string
    50		ValueA  float64
    51		ValueB  float64
    52		AbsDiff float64
    53		RelDiff float64
    54	}
    55	
    56	// Compare compares two stored results.
    57	func Compare(a, b *storage.StoredResult, mode ComparisonMode, tol Tolerance) *ComparisonResult {
    58		result := &ComparisonResult{
    59			Mode:      mode,
    60			Tolerance: tol,
    61		}
    62	
    63		if a.ExperimentName != b.ExperimentName {
    64			result.Match = false
    65			result.Summary = fmt.Sprintf("experiment name mismatch: %s vs %s", a.ExperimentName, b.ExperimentName)
    66			return result
    67		}
    68	
    69		minLen := len(a.Values)
    70		if len(b.Values) < minLen {
    71			minLen = len(b.Values)
    72		}
    73	
    74		if len(a.Values) != len(b.Values) {
    75			result.Match = false
    76			result.Summary = fmt.Sprintf("value count mismatch: %d vs %d", len(a.Values), len(b.Values))
    77			return result
    78		}
    79	
    80		result.TotalPairs = minLen
    81	
    82		switch mode {
    83		case ModeExact:
    84			result.Match = true
    85			for i := 0; i < minLen; i++ {
    86				label := fmt.Sprintf("value[%d]", i)
    87				if i < len(a.Labels) {
    88					label = a.Labels[i]
    89				}
    90				if a.Values[i] != b.Values[i] {
    91					result.Match = false
    92					result.Mismatches = append(result.Mismatches, Mismatch{
    93						Index:   i,
    94						Label:   label,
    95						ValueA:  a.Values[i],
    96						ValueB:  b.Values[i],
    97						AbsDiff: math.Abs(a.Values[i] - b.Values[i]),
    98						RelDiff: relDiff(a.Values[i], b.Values[i]),
    99					})
   100				} else {
   101					result.MatchedPairs++
   102				}
   103			}
   104		case ModeTolerance:
   105			result.Match = true
   106			for i := 0; i < minLen; i++ {
   107				label := fmt.Sprintf("value[%d]", i)
   108				if i < len(a.Labels) {
   109					label = a.Labels[i]
   110				}
   111				if !valuesMatch(a.Values[i], b.Values[i], tol) {
   112					result.Match = false
   113					result.Mismatches = append(result.Mismatches, Mismatch{
   114						Index:   i,
   115						Label:   label,
   116						ValueA:  a.Values[i],
   117						ValueB:  b.Values[i],
   118						AbsDiff: math.Abs(a.Values[i] - b.Values[i]),
   119						RelDiff: relDiff(a.Values[i], b.Values[i]),
   120					})
   121				} else {
   122					result.MatchedPairs++
   123				}
   124			}
   125		default:
   126			result.Match = false
   127			result.Summary = "unknown comparison mode"
   128			return result
   129		}
   130	
   131		if result.Summary == "" {
   132			if result.Match {
   133				result.Summary = fmt.Sprintf("all %d value pairs match", result.TotalPairs)
   134			} else {
   135				result.Summary = fmt.Sprintf("%d of %d value pairs mismatch", len(result.Mismatches), result.TotalPairs)
   136			}
   137		}
   138	
   139		return result
   140	}
   141	
   142	// valuesMatch implements the spec's tolerance comparison rules.
   143	func valuesMatch(a, b float64, tol Tolerance) bool {
   144		if math.IsNaN(a) && math.IsNaN(b) {
   145			return true
   146		}
   147		if math.IsNaN(a) || math.IsNaN(b) {
   148			return false
   149		}
   150	
   151		if math.IsInf(a, 1) && math.IsInf(b, 1) {
   152			return true
   153		}
   154		if math.IsInf(a, -1) && math.IsInf(b, -1) {
   155			return true
   156		}
   157		if math.IsInf(a, 0) || math.IsInf(b, 0) {
   158			return false
   159		}
   160	
   161		if math.Abs(a) < tol.Absolute && math.Abs(b) < tol.Absolute {
   162			return true
   163		}
   164	
   165		diff := math.Abs(a - b)
   166		if diff <= tol.Absolute {
   167			return true
   168		}
   169	
   170		denom := math.Max(math.Abs(a), math.Abs(b))
   171		if denom > 0 && diff/denom <= tol.Relative {
   172			return true
   173		}
   174	
   175		return false
   176	}
   177	
   178	// FormatReport generates a human-readable comparison report.
   179	func FormatReport(cr *ComparisonResult) string {
   180		var sb strings.Builder
   181		sb.WriteString("=== Comparison Report ===\n")
   182		sb.WriteString(fmt.Sprintf("Mode: %s\n", modeString(cr.Mode)))
   183		if cr.Mode == ModeTolerance {
   184			sb.WriteString(fmt.Sprintf("Absolute tolerance: %g\n", cr.Tolerance.Absolute))
   185			sb.WriteString(fmt.Sprintf("Relative tolerance: %g\n", cr.Tolerance.Relative))
   186		}
   187		sb.WriteString(fmt.Sprintf("Match: %v\n", cr.Match))
   188		sb.WriteString(fmt.Sprintf("Total pairs: %d\n", cr.TotalPairs))
   189		sb.WriteString(fmt.Sprintf("Matched: %d\n", cr.MatchedPairs))
   190		sb.WriteString(fmt.Sprintf("Summary: %s\n", cr.Summary))
   191	
   192		if len(cr.Mismatches) > 0 {
   193			sb.WriteString("\nMismatches:\n")
   194			for _, m := range cr.Mismatches {
   195				sb.WriteString(fmt.Sprintf("  [%d] %s: %.15e vs %.15e (abs=%.6e, rel=%.6e)\n",
   196					m.Index, m.Label, m.ValueA, m.ValueB, m.AbsDiff, m.RelDiff))
   197			}
   198		}
   199	
   200		return sb.String()
   201	}
   202	
   203	func relDiff(a, b float64) float64 {
   204		denom := math.Max(math.Abs(a), math.Abs(b))
   205		if denom < 1e-300 {
   206			return 0
   207		}
   208		return math.Abs(a-b) / denom
   209	}
   210	
   211	func modeString(m ComparisonMode) string {
   212		switch m {
   213		case ModeExact:
   214			return "exact"
   215		case ModeTolerance:
   216			return "tolerance"
   217		default:
   218			return "unknown"
   219		}
   220	}
