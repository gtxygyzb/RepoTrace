[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"math"
	"os"
	"runtime"
	"strconv"
	"strings"
	"time"

	"numeriforge/compare"
	"numeriforge/config"
	"numeriforge/engine"
	"numeriforge/storage"
)

func usage() {
	fmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform

Usage:
  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]
  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]
  numeriforge list [--experiment <name>] [--store-dir <dir>]
  numeriforge export <result_id> --store-dir <dir> [--format json|csv]
  numeriforge verify <result_id> --store-dir <dir>
  numeriforge audit <result_id> --store-dir <dir>

Commands:
  run       Run an experiment and store the result
  compare   Compare two stored results
  list      List stored experiment results
  export    Export a result to a different format
  verify    Verify result integrity
  audit     Audit a stored result for reproducibility

Available experiments:
`)
	for _, name := range engine.List() {
		fmt.Fprintf(os.Stderr, "  %s\n", name)
	}
}

func main() {
	if len(os.Args) < 2 {
		usage()
		os.Exit(1)
	}

	cmd := os.Args[1]

	switch cmd {
	case "run":
		cmdRun(os.Args[2:])
	case "compare":
		cmdCompare(os.Args[2:])
	case "list":
		cmdList(os.Args[2:])
	case "export":
		cmdExport(os.Args[2:])
	case "verify":
		cmdVerify(os.Args[2:])
	case "audit":
		cmdAudit(os.Args[2:])
	case "help", "--help", "-h":
		usage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
		usage()
		os.Exit(1)
	}
}

// environmentMetadata returns the environment fingerprint metadata required for
// reproducible experiment traces.
func environmentMetadata() map[string]string {
	hostname, err := os.Hostname()
	if err != nil {
		hostname = "unknown"
	}
	return map[string]string{
		"env_go_version": runtime.Version(),
		"env_os":         runtime.GOOS,
		"env_arch":       runtime.GOARCH,
		"env_hostname":   hostname,
	}
}

// environmentFromMetadata aggregates stored environment fingerprint metadata
// into an export-friendly object.
type environmentInfo struct {
	GoVersion string `json:"go_version"`
	OS        string `json:"os"`
	Arch      string `json:"arch"`
	Hostname  string `json:"hostname"`
}

func environmentFromMetadata(metadata map[string]string) environmentInfo {
	return environmentInfo{
		GoVersion: metadata["env_go_version"],
		OS:        metadata["env_os"],
		Arch:      metadata["env_arch"],
		Hostname:  metadata["env_hostname"],
	}
}

type exportPayload struct {
	*storage.StoredResult
	Environment environmentInfo `json:"environment"`
}

func cmdRun(args []string) {
	var experimentName, outputDir, configPath string
	var paramStrs []string
	var seed int64
	seedProvided := false

	for i := 0; i < len(args); i++ {
		switch args[i] {
		case "--experiment":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --experiment requires a value\n")
				os.Exit(1)
			}
			experimentName = args[i]
		case "--output-dir":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --output-dir requires a value\n")
				os.Exit(1)
			}
			outputDir = args[i]
		case "--config":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --config requires a value\n")
				os.Exit(1)
			}
			configPath = args[i]
		case "--param":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --param requires a value\n")
				os.Exit(1)
			}
			paramStrs = append(paramStrs, args[i])
		case "--seed":
			i++
			if i >= len(args) {
				fmt.Fprintf(os.Stderr, "error: --seed requires a value\n")
				os.Exit(1)
			}
			parsed, err := strconv.ParseInt(args[i], 10, 64)
			if err != nil {
				fmt.Fprintf(os.Stderr, "error: invalid seed: %v\n", err)
				os.Exit(1)
			}
			seed = parsed
			seedProvided = true
		default:
			fmt.Fprintf(os.Stderr, "error: unknown flag: %s\n", args[i])
			os.Exit(1)
		}
	}

	if configPath != "" {
		cfg, err := config.ParseINI(configPath)
		if err != nil {
			fmt.Fprintf(os.Stderr, "config error: %v\n", err)
			os.Exit(1)
		}
		if experimentName == "" {
			experimentName = cfg.Experiment
		}
		if outputDir == "" {
			outputDir = cfg.OutputDir
		}

		cliParams, _ := config.ParseParams(paramStrs)
		cliParamMap := make(map[string]float64)
		for _, p := range cliParams {
			cliParamMap[p.Name] = p.Value
		}
		for _, p := range cfg.Params {
			if _, exists := cliParamMap[p.Name]; !exists {
				cliParams = append(cliParams, p)
			}
		}
		paramStrs = nil
		for _, p := range cliParams {
			paramStrs = append(paramStrs, fmt.Sprintf("%s=%g", p.Name, p.Value))
		}
	}

	if experimentName == "" {
		fmt.Fprintf(os.Stderr, "error: --experiment is required\n")
		os.Exit(1)
	}
	if outputDir == "" {
		outputDir = "./results"
	}

	params, err := config.ParseParams(paramStrs)
	if err != nil {
		fmt.Fprintf(os.Stderr, "parameter error: %v\n", err)
		os.Exit(1)
	}

	fn, err := engine.Get(experimentName)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}

	if !seedProvided {
		seed = time.Now().UnixNano()
	}

	rng := engine.NewRNG(seed)

	result, err := fn(experimentName, params, rng)
	if err != nil {
		fmt.Fprintf(os.Stderr, "experiment error: %v\n", err)
		os.Exit(1)
	}

	if result.Metadata == nil {
		result.Metadata = map[string]string{}
	}
	if _, ok := result.Metadata["seed"]; !ok {
		result.Metadata["seed"] = strconv.FormatInt(seed, 10)
	}
	if seedProvided {
		result.Metadata["seed_source"] = "provided"
	} else {
		result.Metadata["seed_source"] = "auto-generated"
	}

	for k, v := range environmentMetadata() {
		result.Metadata[k] = v
	}

	store, err := storage.NewStore(outputDir)
	if err != nil {
		fmt.Fprintf(os.Stderr, "storage error: %v\n", err)
		os.Exit(1)
	}

	id, err := store.Save(result)
	if err != nil {
		fmt.Fprintf(os.Stderr, "save error: %v\n", err)
		os.Exit(1)
	}

	fmt.Printf("Experiment: %s\n", experimentName)
	fmt.Printf("Result ID: %s\n", id)
	fmt.Printf("Values:\n")
	for i, v := range result.Values {
[?2004hroot@n30009:/app# sed -n '1,260p' /app/storage/storage.go
[?2004lpackage storage

import (
	"crypto/sha256"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"strings"
	"time"

	"numeriforge/engine"
)

// StoredResult is the on-disk representation of an experiment result.
type StoredResult struct {
	ID             string             `json:"id"`
	ExperimentName string             `json:"experiment_name"`
	Timestamp      time.Time          `json:"timestamp"`
	Parameters     []engine.Parameter `json:"parameters"`
	Values         []float64          `json:"values"`
	Labels         []string           `json:"labels"`
	Metadata       map[string]string  `json:"metadata"`
	Checksum       string             `json:"checksum,omitempty"`
}

// VerifyStatus reports the outcome of integrity verification.
type VerifyStatus string

const (
	StatusVerified   VerifyStatus = "verified"
	StatusCorrupted  VerifyStatus = "corrupted"
	StatusNoChecksum VerifyStatus = "no_checksum"
)

// IndexEntry is a stored result index record.
type IndexEntry struct {
	ID             string
	ExperimentName string
	Timestamp      time.Time
}

// Store manages experiment result persistence.
type Store struct {
	BaseDir string
}

// NewStore creates a store at the given directory.
func NewStore(baseDir string) (*Store, error) {
	if err := os.MkdirAll(baseDir, 0755); err != nil {
		return nil, fmt.Errorf("cannot create store directory: %w", err)
	}
	return &Store{BaseDir: baseDir}, nil
}

// ComputeChecksum returns the SHA-256 checksum of the canonical value
// representation defined by the reproducibility specification.
func ComputeChecksum(values []float64) string {
	var sb strings.Builder
	for i, v := range values {
		if i > 0 {
			sb.WriteByte('\n')
		}
		fmt.Fprintf(&sb, "%.17e", v)
	}
	sum := sha256.Sum256([]byte(sb.String()))
	return fmt.Sprintf("%x", sum)
}

// Save persists an experiment result to disk.
func (s *Store) Save(result *engine.Result) (string, error) {
	id := fmt.Sprintf("%s_%s", result.ExperimentName, result.Timestamp.Format("20060102_150405"))

	checksum := ComputeChecksum(result.Values)

	if result.Metadata == nil {
		result.Metadata = map[string]string{}
	}
	result.Metadata["values_checksum"] = checksum

	stored := StoredResult{
		ID:             id,
		ExperimentName: result.ExperimentName,
		Timestamp:      result.Timestamp,
		Parameters:     result.Parameters,
		Values:         result.Values,
		Labels:         result.Labels,
		Metadata:       result.Metadata,
		Checksum:       checksum,
	}

	data, err := json.MarshalIndent(stored, "", "  ")
	if err != nil {
		return "", fmt.Errorf("marshal error: %w", err)
	}

	resultDir := filepath.Join(s.BaseDir, result.ExperimentName)
	if err := os.MkdirAll(resultDir, 0755); err != nil {
		return "", fmt.Errorf("cannot create result directory: %w", err)
	}

	path := filepath.Join(resultDir, id+".json")
	if err := os.WriteFile(path, data, 0644); err != nil {
		return "", fmt.Errorf("write error: %w", err)
	}

	if err := s.updateIndex(id, result.ExperimentName, result.Timestamp); err != nil {
		return "", fmt.Errorf("index update error: %w", err)
	}

	return id, nil
}

// Load reads a stored result by ID.
func (s *Store) Load(id string) (*StoredResult, error) {
	var resultPath string
	err := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {
		if err != nil {
			return err
		}
		if !info.IsDir() && strings.TrimSuffix(info.Name(), ".json") == id {
			resultPath = path
			return filepath.SkipAll
		}
		return nil
	})
	if err != nil {
		return nil, err
	}
	if resultPath == "" {
		return nil, fmt.Errorf("result not found: %s", id)
	}

	data, err := os.ReadFile(resultPath)
	if err != nil {
		return nil, fmt.Errorf("read error: %w", err)
	}

	var stored StoredResult
	if err := json.Unmarshal(data, &stored); err != nil {
		return nil, fmt.Errorf("unmarshal error: %w", err)
	}
	return &stored, nil
}

// ListResults returns all stored result IDs, optionally filtered by experiment name.
func (s *Store) ListResults(experimentFilter string) ([]IndexEntry, error) {
	entries, err := s.readIndex()
	if err != nil {
		return nil, err
	}

	if experimentFilter == "" {
		return entries, nil
	}

	filtered := make([]IndexEntry, 0)
	for _, entry := range entries {
		if entry.ExperimentName == experimentFilter {
			filtered = append(filtered, entry)
		}
	}
	return filtered, nil
}

// Verify checks stored result integrity by recomputing the canonical checksum.
func (s *Store) Verify(id string) (VerifyStatus, string, string, error) {
	stored, err := s.Load(id)
	if err != nil {
		return "", "", "", err
	}

	if stored.Checksum == "" {
		return StatusNoChecksum, "", "", nil
	}

	computed := ComputeChecksum(stored.Values)
	if computed == stored.Checksum {
		return StatusVerified, stored.Checksum, computed, nil
	}
	return StatusCorrupted, stored.Checksum, computed, nil
}

func (s *Store) indexPath() string {
	return filepath.Join(s.BaseDir, "index.txt")
}

func (s *Store) updateIndex(id, experimentName string, timestamp time.Time) error {
	if err := os.MkdirAll(s.BaseDir, 0755); err != nil {
		return err
	}

	f, err := os.OpenFile(s.indexPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
	if err != nil {
		return err
	}
	defer f.Close()

	_, err = fmt.Fprintf(f, "%s|%s|%s\n", id, experimentName, timestamp.Format(time.RFC3339))
	return err
}

func (s *Store) readIndex() ([]IndexEntry, error) {
	data, err := os.ReadFile(s.indexPath())
	if err != nil {
		if os.IsNotExist(err) {
			return nil, nil
		}
		return nil, err
	}

	var entries []IndexEntry
	for _, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
		if line == "" {
			continue
		}
		parts := strings.SplitN(line, "|", 3)
		if len(parts) != 3 {
			continue
		}
		ts, _ := time.Parse(time.RFC3339, parts[2])
		entries = append(entries, IndexEntry{
			ID:             parts[0],
			ExperimentName: parts[1],
			Timestamp:      ts,
		})
	}

	sort.Slice(entries, func(i, j int) bool {
		return entries[i].Timestamp.Before(entries[j].Timestamp)
	})

	return entries, nil
}
[?2004hroot@n30009:/app# sed -n '1,260p' /app/engine/engine.go
[?2004lpackage engine

import (
	"fmt"
	"math/rand"
	"time"
)

// ExperimentType enumerates supported experiment categories.
type ExperimentType string

const (
	TypeMonteCarlo ExperimentType = "montecarlo"
	TypeMatrix     ExperimentType = "matrix"
	TypeODE        ExperimentType = "ode"
	TypeStats      ExperimentType = "stats"
)

// Parameter holds a single experiment parameter.
type Parameter struct {
	Name  string
	Value float64
}

// Result holds raw experiment output.
type Result struct {
	ExperimentName string
	Timestamp      time.Time
	Parameters     []Parameter
	Values         []float64
	Labels         []string
	Metadata       map[string]string
}

// ExperimentFunc is the signature for all experiment backends.
// It takes a name, parameters, and returns a Result or error.
type ExperimentFunc func(name string, params []Parameter, rng RNG) (*Result, error)

// Global registry of experiment backends.
var registry = map[string]ExperimentFunc{}

// RNG is an isolated random number generator type for experiment backends.
type RNG = *rand.Rand

// NewRNG creates an isolated random source for a single experiment invocation.
func NewRNG(seed int64) RNG {
	return rand.New(rand.NewSource(seed))
}

// Register adds an experiment backend to the registry.
func Register(name string, fn ExperimentFunc) {
	registry[name] = fn
}

// Get retrieves an experiment backend by name.
func Get(name string) (ExperimentFunc, error) {
	fn, ok := registry[name]
	if !ok {
		return nil, fmt.Errorf("unknown experiment: %s", name)
	}
	return fn, nil
}

// List returns all registered experiment names.
func List() []string {
	names := make([]string, 0, len(registry))
	for k := range registry {
		names = append(names, k)
	}
	return names
}

// GetParam finds a parameter by name, returning its value and whether it was found.
func GetParam(params []Parameter, name string) (float64, bool) {
	for _, p := range params {
		if p.Name == name {
			return p.Value, true
		}
	}
	return 0, false
}

// RequireParam finds a parameter by name or returns an error.
func RequireParam(params []Parameter, name string) (float64, error) {
	v, ok := GetParam(params, name)
	if !ok {
		return 0, fmt.Errorf("missing required parameter: %s", name)
	}
	return v, nil
}

func init() {
	registerMonteCarloExperiments()
	registerMatrixExperiments()
	registerODEExperiments()
	registerStatsExperiments()
}
[?2004hroot@n30009:/app# sed -n '1,220p' /app/compare/compare.go
[?2004lpackage compare

import (
	"fmt"
	"math"
	"strings"

	"numeriforge/storage"
)

// ComparisonMode determines how results are compared.
type ComparisonMode int

const (
	// ModeExact uses exact float equality (legacy behavior).
	ModeExact ComparisonMode = iota
	// ModeTolerance uses configurable absolute and relative tolerance.
	ModeTolerance
)

// Tolerance defines comparison thresholds.
type Tolerance struct {
	Absolute float64
	Relative float64
}

// DefaultTolerance returns the spec defaults for scientific comparisons.
func DefaultTolerance() Tolerance {
	return Tolerance{
		Absolute: 1e-10,
		Relative: 1e-8,
	}
}

// ComparisonResult holds the outcome of comparing two experiment results.
type ComparisonResult struct {
	Match        bool
	TotalPairs   int
	MatchedPairs int
	Mismatches   []Mismatch
	Mode         ComparisonMode
	Tolerance    Tolerance
	Summary      string
}

// Mismatch records a single value pair that didn't match.
type Mismatch struct {
	Index   int
	Label   string
	ValueA  float64
	ValueB  float64
	AbsDiff float64
	RelDiff float64
}

// Compare compares two stored results.
func Compare(a, b *storage.StoredResult, mode ComparisonMode, tol Tolerance) *ComparisonResult {
	result := &ComparisonResult{
		Mode:      mode,
		Tolerance: tol,
	}

	if a.ExperimentName != b.ExperimentName {
		result.Match = false
		result.Summary = fmt.Sprintf("experiment name mismatch: %s vs %s", a.ExperimentName, b.ExperimentName)
		return result
	}

	minLen := len(a.Values)
	if len(b.Values) < minLen {
		minLen = len(b.Values)
	}

	if len(a.Values) != len(b.Values) {
		result.Match = false
		result.Summary = fmt.Sprintf("value count mismatch: %d vs %d", len(a.Values), len(b.Values))
		return result
	}

	result.TotalPairs = minLen

	switch mode {
	case ModeExact:
		result.Match = true
		for i := 0; i < minLen; i++ {
			label := fmt.Sprintf("value[%d]", i)
			if i < len(a.Labels) {
				label = a.Labels[i]
			}
			if a.Values[i] != b.Values[i] {
				result.Match = false
				result.Mismatches = append(result.Mismatches, Mismatch{
					Index:   i,
					Label:   label,
					ValueA:  a.Values[i],
					ValueB:  b.Values[i],
					AbsDiff: math.Abs(a.Values[i] - b.Values[i]),
					RelDiff: relDiff(a.Values[i], b.Values[i]),
				})
			} else {
				result.MatchedPairs++
			}
		}
	case ModeTolerance:
		result.Match = true
		for i := 0; i < minLen; i++ {
			label := fmt.Sprintf("value[%d]", i)
			if i < len(a.Labels) {
				label = a.Labels[i]
			}
			if !valuesMatch(a.Values[i], b.Values[i], tol) {
				result.Match = false
				result.Mismatches = append(result.Mismatches, Mismatch{
					Index:   i,
					Label:   label,
					ValueA:  a.Values[i],
					ValueB:  b.Values[i],
					AbsDiff: math.Abs(a.Values[i] - b.Values[i]),
					RelDiff: relDiff(a.Values[i], b.Values[i]),
				})
			} else {
				result.MatchedPairs++
			}
		}
	default:
		result.Match = false
		result.Summary = "unknown comparison mode"
		return result
	}

	if result.Summary == "" {
		if result.Match {
			result.Summary = fmt.Sprintf("all %d value pairs match", result.TotalPairs)
		} else {
			result.Summary = fmt.Sprintf("%d of %d value pairs mismatch", len(result.Mismatches), result.TotalPairs)
		}
	}

	return result
}

// valuesMatch implements the spec's tolerance comparison rules.
func valuesMatch(a, b float64, tol Tolerance) bool {
	if math.IsNaN(a) && math.IsNaN(b) {
		return true
	}
	if math.IsNaN(a) || math.IsNaN(b) {
		return false
	}

	if math.IsInf(a, 1) && math.IsInf(b, 1) {
		return true
	}
	if math.IsInf(a, -1) && math.IsInf(b, -1) {
		return true
	}
	if math.IsInf(a, 0) || math.IsInf(b, 0) {
		return false
	}

	if math.Abs(a) < tol.Absolute && math.Abs(b) < tol.Absolute {
		return true
	}

	diff := math.Abs(a - b)
	if diff <= tol.Absolute {
		return true
	}

	denom := math.Max(math.Abs(a), math.Abs(b))
	if denom > 0 && diff/denom <= tol.Relative {
		return true
	}

	return false
}

// FormatReport generates a human-readable comparison report.
func FormatReport(cr *ComparisonResult) string {
	var sb strings.Builder
	sb.WriteString("=== Comparison Report ===\n")
	sb.WriteString(fmt.Sprintf("Mode: %s\n", modeString(cr.Mode)))
	if cr.Mode == ModeTolerance {
		sb.WriteString(fmt.Sprintf("Absolute tolerance: %g\n", cr.Tolerance.Absolute))
		sb.WriteString(fmt.Sprintf("Relative tolerance: %g\n", cr.Tolerance.Relative))
	}
	sb.WriteString(fmt.Sprintf("Match: %v\n", cr.Match))
	sb.WriteString(fmt.Sprintf("Total pairs: %d\n", cr.TotalPairs))
	sb.WriteString(fmt.Sprintf("Matched: %d\n", cr.MatchedPairs))
	sb.WriteString(fmt.Sprintf("Summary: %s\n", cr.Summary))

	if len(cr.Mismatches) > 0 {
		sb.WriteString("\nMismatches:\n")
		for _, m := range cr.Mismatches {
			sb.WriteString(fmt.Sprintf("  [%d] %s: %.15e vs %.15e (abs=%.6e, rel=%.6e)\n",
				m.Index, m.Label, m.ValueA, m.ValueB, m.AbsDiff, m.RelDiff))
		}
	}

	return sb.String()
}

func relDiff(a, b float64) float64 {
	denom := math.Max(math.Abs(a), math.Abs(b))
	if denom < 1e-300 {
		return 0
	}
	return math.Abs(a-b) / denom
}

func modeString(m ComparisonMode) string {
	switch m {
	case ModeExact:
		return "exact"
	case ModeTolerance:
		return "tolerance"
	default:
		return "unknown"
	}
}
