   779			} else {
   780				reexecVal = strconv.FormatFloat(reexec.Values[i], 'g', -1, 64)
   781			}
   782	
   783			if storedMissing || reexecMissing || math.Float64bits(stored.Values[i]) != math.Float64bits(reexec.Values[i]) {
   784				mismatches = append(mismatches, fmt.Sprintf("  value[%d]: stored=%s, re-executed=%s", i, storedVal, reexecVal))
   785			}
   786		}
   787	
   788		if len(mismatches) == 0 {
   789			return true, fmt.Sprintf("AUDIT_PASS: %s\n", id)
   790		}
   791	
   792		var sb strings.Builder
   793		sb.WriteString(fmt.Sprintf("AUDIT_FAIL: %s\n", id))
   794		for _, m := range mismatches {
   795			sb.WriteString(m)
   796			sb.WriteByte('\n')
   797		}
   798		return false, sb.String()
   799	}
