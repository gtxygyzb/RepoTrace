    18	
    19	func usage() {
    20		fmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform
    21	
    22	Usage:
    23	  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]
    24	  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]
    25	  numeriforge list [--experiment <name>] [--store-dir <dir>]
    26	  numeriforge export <result_id> --store-dir <dir> [--format json|csv]
    27	  numeriforge verify <result_id> --store-dir <dir> [--verbose]
    28	  numeriforge audit <result_id> --store-dir <dir>
    29	  numeriforge audit --all --store-dir <dir>
    30	
    31	Commands:
    32	  run       Run an experiment and store the result
    33	  compare   Compare two stored results
    34	  list      List stored experiment results
    35	  export    Export a result to a different format
    36	  verify    Verify result integrity
    37	  audit     Audit stored result(s) for reproducibility
    38	
    39	Available experiments:
    40	`)
    41		for _, name := range engine.List() {
    42			fmt.Fprintf(os.Stderr, "  %s\n", name)
    43		}
    44	}
    45	
    46	func main() {
    47		if len(os.Args) < 2 {
    48			usage()
    49			os.Exit(1)
    50		}
    51	
    52		cmd := os.Args[1]
    53	
    54		switch cmd {
    55		case "run":
    56			cmdRun(os.Args[2:])
    57		case "compare":
    58			cmdCompare(os.Args[2:])
    59		case "list":
    60			cmdList(os.Args[2:])
    61		case "export":
    62			cmdExport(os.Args[2:])
    63		case "verify":
    64			cmdVerify(os.Args[2:])
    65		case "audit":
    66			cmdAudit(os.Args[2:])
    67		case "help", "--help", "-h":
    68			usage()
    69		default:
    70			fmt.Fprintf(os.Stderr, "unknown command: %s\n", cmd)
    71			usage()
    72			os.Exit(1)
    73		}
    74	}
    75	
    76	// environmentMetadata returns the environment fingerprint metadata required for
    77	// reproducible experiment traces.
    78	func environmentMetadata() map[string]string {
    79		hostname, err := os.Hostname()
    80		if err != nil {
    81			hostname = "unknown"
    82		}
    83		return map[string]string{
    84			"env_go_version": runtime.Version(),
    85			"env_os":         runtime.GOOS,
    86			"env_arch":       runtime.GOARCH,
    87			"env_hostname":   hostname,
    88		}
    89	}
    90	
    91	// environmentFromMetadata aggregates stored environment fingerprint metadata
    92	// into an export-friendly object.
    93	type environmentInfo struct {
    94		GoVersion string `json:"go_version"`
    95		OS        string `json:"os"`
    96		Arch      string `json:"arch"`
    97		Hostname  string `json:"hostname"`
    98	}
    99	
   100	func environmentFromMetadata(metadata map[string]string) environmentInfo {
   101		return environmentInfo{
   102			GoVersion: metadata["env_go_version"],
   103			OS:        metadata["env_os"],
   104			Arch:      metadata["env_arch"],
   105			Hostname:  metadata["env_hostname"],
   106		}
   107	}
   108	
   109	type exportPayload struct {
   110		*storage.StoredResult
   111		Environment environmentInfo `json:"environment"`
   112	}
