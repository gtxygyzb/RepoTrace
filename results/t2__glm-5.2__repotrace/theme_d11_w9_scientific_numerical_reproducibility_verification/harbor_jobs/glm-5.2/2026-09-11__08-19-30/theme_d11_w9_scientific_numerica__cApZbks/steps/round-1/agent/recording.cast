[5501.516386, "o", "\t\t}\r\n\t\tos.Exit(1)\r\n\tcase storage.StatusNoChecksum:\r\n\t\tfmt.Printf(\"NO_CHECKSUM: %s\\n\", id)\r\n\t\tos.Exit(2)\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown verification status: %s\\n\", status)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[5501.516514, "o", "}\r\nfunc cmdReport(args []string) {\r\n\tstoreDir := \"./results\"\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --store-dir requires a value\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintln(os.Stderr, \"error: unknown flag:\", args[i])\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n"]
[5501.516596, "o", "\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"storage error:\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := store.ListResults(\"\")\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, \"storage error:\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[5501.516661, "o", "\tif len(entries) == 0 {\r\n\t\tfmt.Println(\"No results found.\")\r\n\t\treturn\r\n\t}\r\n\r\n\tfmt.Println(\"=== NumeriForge Reproducibility Report ===\")\r\n\r\n\tgroups := make(map[string][]storage.IndexEntry)\r\n\tfor _, entry := range entries {\r\n\t\tgroups[entry.ExperimentName] = append(groups[entry.ExperimentName], entry)\r\n\t}\r\n"]
[5501.516722, "o", "\r\n\tnames := make([]string, 0, len(groups))\r\n\tfor name := range groups {\r\n\t\tnames = append(names, name)\r\n\t}\r\n\tsort.Strings(names)\r\n\r\n\tfor _, name := range names {\r\n\t\tgroup := groups[name]\r\n\t\tearliest := group[0].Timestamp\r\n\t\tlatest := group[len(group)-1].Timestamp\r\n"]
[5501.516791, "o", "\t\tfmt.Println(\"Experiment:\", name, \"(\"+strconv.Itoa(len(group))+\" results)\")\r\n\t\tfmt.Println(\"Date range:\", earliest.Format(time.RFC3339), \"to\", latest.Format(time.RFC3339))\r\n\t}\r\n\r\n\tenvSet := make(map[string]bool)\r\n"]
[5501.51685, "o", "\tfor _, entry := range entries {\r\n\t\tstored, err := store.Load(entry.ID)\r\n\t\tif err != nil {\r\n\t\t\tenvSet[\"unknown/unknown\"] = true\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tosVal := stored.Metadata[\"env_os\"]\r\n\t\tif osVal == \"\" {\r\n\t\t\tosVal = \"unknown\"\r\n\t\t}\r\n\t\tarchVal := stored.Metadata[\"env_arch\"]\r\n\t\tif archVal == \"\" {\r\n\t\t\tarchVal = \"unknown\"\r\n"]
[5501.516907, "o", "\t\t}\r\n\t\tenvSet[osVal+\"/\"+archVal] = true\r\n\t}\r\n\r\n\tfmt.Println(\"Environment summary:\")\r\n\tenvKeys := make([]string, 0, len(envSet))\r\n\tfor key := range envSet {\r\n\t\tenvKeys = append(envKeys, key)\r\n\t}\r\n"]
[5501.516963, "o", "\tsort.Strings(envKeys)\r\n\tif len(envKeys) == 0 {\r\n\t\tfmt.Println(\"  none\")\r\n\t} else {\r\n\t\tfor _, key := range envKeys {\r\n\t\t\tfmt.Println(\"  \" + key)\r\n\t\t}\r\n\t}\r\n\r\n\tok := 0\r\n\tfail := 0\r\n"]
[5501.51702, "o", "\tnoChecksum := 0\r\n\tfor _, entry := range entries {\r\n\t\tstatus, _, _, err := store.Verify(entry.ID)\r\n\t\tif err != nil {\r\n\t\t\tfail++\r\n\t\t\tfmt.Fprintln(os.Stderr, \"verify error:\", entry.ID, err)\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[5501.517077, "o", "\t\tswitch status {\r\n\t\tcase storage.StatusVerified:\r\n\t\t\tok++\r\n\t\tcase storage.StatusCorrupted:\r\n\t\t\tfail++\r\n\t\tcase storage.StatusNoChecksum:\r\n\t\t\tnoChecksum++\r\n\t\tdefault:\r\n\t\t\tfail++\r\n\t\t"]
[5501.517132, "o", "}\r\n\t}\r\n\r\n\tfmt.Println(\"Integrity summary:\")\r\n"]
[5501.517679, "o", "\u001b[?2004h"]
