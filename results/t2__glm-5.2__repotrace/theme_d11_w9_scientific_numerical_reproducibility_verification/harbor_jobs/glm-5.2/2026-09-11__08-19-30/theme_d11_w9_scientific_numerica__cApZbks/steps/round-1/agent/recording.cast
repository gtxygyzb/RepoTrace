[3926.846185, "o", "   442\t\t\t\tformat = args[i]\r\n   443\t\t\tdefault:\r\n   444\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   445\t\t\t\tos.Exit(1)\r\n   446\t\t\t}\r\n   447\t\t}\r\n   448\t\r\n   449\t\tstore, err := storage.NewStore(storeDir)\r\n   450\t\tif err != nil {\r\n   451\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n"]
