[5448.821051, "o", "\tcase \"export\":\r\n\t\tcmdExport(os.Args[2:])\r\n\tcase \"verify\":\r\n\t\tcmdVerify(os.Args[2:])\r\n\tcase \"audit\":\r\n\tcase \"report\":\r\n\t\tcmdReport(os.Args[2:])\r\n\t\tcmdAudit(os.Args[2:])\r\n\tcase \"help\", \"--help\", \"-h\":\r\n\t\tusage()\r\n\tdefault:\r\n"]
