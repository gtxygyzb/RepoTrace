[2821.804947, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2821.805001, "o", "\u001b[?2004h> "]
[2821.805075, "o", "cmd_audit = '''\r\n\u001b[?2004l\r"]
[2821.80513, "o", "\u001b[?2004h> "]
[2821.80528, "o", "func cmdAudit(args []string) {\r\n\u001b[?2004l\r"]
[2821.805335, "o", "\u001b[?2004h> "]
[2821.805437, "o", "\\tif len(args) < 1 {\r\n\u001b[?2004l\r"]
[2821.8055, "o", "\u001b[?2004h> "]
[2821.805936, "o", "\\t\\tfmt.Fprintf(os.Stderr, \"usage: numeriforge audit <result_id> --store-dir <dir>\\\\n\")\r\n\u001b[?2004l\r"]
[2821.805992, "o", "\u001b[?2004h> "]
[2821.806067, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[2821.806122, "o", "\u001b[?2004h> "]
[2821.806177, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[2821.806231, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[2821.806327, "o", "\\tid := args[0]\r\n\u001b[?2004l\r"]
[2821.806381, "o", "\u001b[?2004h> "]
