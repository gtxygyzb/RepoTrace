[2582.690695, "o", "sed -n '1,60p' engine/engine.go\r\n\u001b[?2004l\r"]
[2582.693506, "o", "package engine\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math/rand\"\r\n"]
[2582.693641, "o", "\t\"time\"\r\n)\r\n\r\n// ExperimentType enumerates supported experiment categories.\r\ntype ExperimentType string\r\n\r\n"]
[2582.693722, "o", "const (\r\n\tTypeMonteCarlo ExperimentType = \"montecarlo\"\r\n\tTypeMatrix     ExperimentType = \"matrix\"\r\n\tTypeODE        ExperimentType = \"ode\"\r\n\tTypeStats      ExperimentType = \"stats\"\r\n)\r\n\r\n// Parameter holds a single experiment parameter.\r\ntype Parameter struct {\r\n\tName  string\r\n\tValue float64\r\n}\r\n\r\n// Result holds raw experiment output.\r\ntype Result struct {\r\n\tExperimentName string\r\n\tTimestamp      time.Time\r\n\tParameters     []Parameter\r\n\tValues         []float64\r\n\tLabels         []string\r\n\tMetadata       map[string]string\r\n}\r\n\r\n// ExperimentFunc is the signature for all experiment backends.\r\n// It takes a name, parameters, and returns a Result or error.\r\ntype ExperimentFunc func(name string, params []Parameter, rng RNG) (*Result, error)\r\n\r\n// Global registry of experiment backends.\r\nvar registry = map[string]ExperimentFunc{}\r\n\r\n// RNG is an isolated random number generator type for experiment backends.\r\ntype RNG = *rand.Rand\r\n\r\n"]
[2582.693806, "o", "// NewRNG creates an isolated random source for a single experiment invocation.\r\nfunc NewRNG(seed int64) RNG {\r\n\treturn rand.New(rand.NewSource(seed))\r\n}\r\n\r\n// Register adds an experiment backend to the registry.\r\nfunc Register(name string, fn ExperimentFunc) {\r\n\tregistry[name] = fn\r\n}\r\n"]
[2582.693873, "o", "\r\n// Get retrieves an experiment backend by name.\r\nfunc Get(name string) (ExperimentFunc, error) {\r\n\tfn, ok := registry[name]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"unknown experiment: %s\", name)\r\n\t}\r\n"]
[2582.694218, "o", "\u001b[?2004h"]
[2582.694274, "o", "root@n30009:/app# "]
[2582.967873, "i", "sed -n '412,470p' main.go\n"]
[2582.96815, "o", "sed -n '412,470p' main.go\r\n\u001b[?2004l\r"]
[2582.971255, "o", "func cmdExport(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge export <id> --store-dir <dir> [--format json|csv]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid := args[0]\r\n"]
[2582.971379, "o", "\tstoreDir := \"./results\"\r\n\tformat := \"json\"\r\n\r\n\tfor i := 1; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tcase \"--format\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --format requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n"]
[2582.971465, "o", "\t\t\tformat = args[i]\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tresult, err := store.Load(id)\r\n"]
[2582.971632, "o", "\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"load error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch format {\r\n\tcase \"json\":\r\n\t\tpayload := exportPayload{\r\n\t\t\tStoredResult: result,\r\n\t\t\tEnvironment:  environmentFromMetadata(result.Metadata),\r\n\t\t}\r\n\t\tdata, err := json.MarshalIndent(payload, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"marshal error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(string(data))\r\n\tcase \"csv\":\r\n\t\tfmt.Println(\"label,value\")\r\n\t\tfor i, v := range result.Values {\r\n"]
[2582.972143, "o", "\u001b[?2004h"]
[2582.972187, "o", "root@n30009:/app# "]
