[3182.216173, "o", "     1\tpackage storage\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/sha256\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t"]
[3182.21627, "o", "\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"strings\"\r\n    11\t\t\"time\"\r\n    12\t\r\n    13\t\t\"numeriforge/engine\"\r\n    14\t)\r\n    15\t\r\n    16\t// StoredResult is the on-disk representation of an experiment result.\r\n    17\ttype StoredResult struct {\r\n    18\t\tID             string             `json:\"id\"`\r\n    19\t\tExperimentName string             `json:\"experiment_name\"`\r\n    20\t\tTimestamp      time.Time          `json:\"timestamp\"`\r\n    21\t\tParameters     []engine.Parameter `json:\"parameters\"`\r\n"]
[3182.216369, "o", "    22\t\tValues         []float64          `json:\"values\"`\r\n    23\t\tLabels         []string           `json:\"labels\"`\r\n    24\t\tMetadata       map[string]string  `json:\"metadata\"`\r\n    25\t\tChecksum       string             `json:\"checksum,omitempty\"`\r\n    26\t}\r\n    27\t\r\n    28\t// VerifyStatus reports the outcome of integrity verification.\r\n    29\ttype VerifyStatus string\r\n    30\t\r\n    31\tconst (\r\n    32\t\tStatusVerified   VerifyStatus = \"verified\"\r\n    33\t\tStatusCorrupted  VerifyStatus = \"corrupted\"\r\n    34\t\tStatusNoChecksum VerifyStatus = \"no_checksum\"\r\n    35\t)\r\n    36\t\r\n    37\t// IndexEntry is a stored result index record.\r\n"]
[3182.21646, "o", "    38\ttype IndexEntry struct {\r\n    39\t\tID             string\r\n    40\t\tExperimentName string\r\n    41\t\tTimestamp      time.Time\r\n    42\t}\r\n    43\t\r\n    44\t// Store manages experiment result persistence.\r\n    45\ttype Store struct {\r\n    46\t\tBaseDir string\r\n    47\t}\r\n    48\t\r\n    49\t// NewStore creates a store at the given directory.\r\n    50\tfunc NewStore(baseDir string) (*Store, error) {\r\n"]
[3182.216596, "o", "    51\t\tif err := os.MkdirAll(baseDir, 0755); err != nil {\r\n    52\t\t\treturn nil, fmt.Errorf(\"cannot create store directory: %w\", err)\r\n    53\t\t}\r\n    54\t\treturn &Store{BaseDir: baseDir}, nil\r\n    55\t}\r\n    56\t\r\n    57\t// ComputeChecksum returns the SHA-256 checksum of the canonical value\r\n    58\t// representation defined by the reproducibility specification.\r\n    59\tfunc ComputeChecksum(values []float64) string {\r\n    60\t\tvar sb strings.Builder\r\n    61\t\tfor i, v := range values {\r\n    62\t\t\tif i > 0 {\r\n    63\t\t\t\tsb.WriteByte('\\n')\r\n    64\t\t\t}\r\n    65\t\t\tfmt.Fprintf(&sb, \"%.17e\", v)\r\n    66\t\t}\r\n    67\t\tsum := sha256.Sum256([]byte(sb.String()))\r\n"]
[3182.216683, "o", "    68\t\treturn fmt.Sprintf(\"%x\", sum)\r\n    69\t}\r\n    70\t\r\n    71\t// Save persists an experiment result to disk.\r\n    72\tfunc (s *Store) Save(result *engine.Result) (string, error) {\r\n    73\t\tid := fmt.Sprintf(\"%s_%s\", result.ExperimentName, result.Timestamp.Format(\"20060102_150405\"))\r\n    74\t\r\n    75\t\tchecksum := ComputeChecksum(result.Values)\r\n    76\t\r\n    77\t\tif result.Metadata == nil {\r\n    78\t\t\tresult.Metadata = map[string]string{}\r\n"]
[3182.216763, "o", "    79\t\t}\r\n    80\t\tresult.Metadata[\"values_checksum\"] = checksum\r\n"]
