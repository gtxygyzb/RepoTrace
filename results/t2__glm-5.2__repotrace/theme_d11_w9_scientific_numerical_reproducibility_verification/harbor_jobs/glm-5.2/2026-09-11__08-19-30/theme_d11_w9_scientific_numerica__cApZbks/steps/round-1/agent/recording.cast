[3076.750663, "o", "grep -RIn \"audit\\|Audit\\|env_go\\|env_os\\|env_arch\\|env_hostname\\|environmentMetadata\\|EnvironmentMetadata\" /app --include=*.go\r\n\u001b[?2004l\r"]
[3076.754699, "o", "\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  numeriforge \u001b[01;31m\u001b[Kaudit\u001b[m\u001b[K <result_id> --store-dir <dir>\r\n"]
[3076.754798, "o", "\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  \u001b[01;31m\u001b[Kaudit\u001b[m\u001b[K     \u001b[01;31m\u001b[KAudit\u001b[m\u001b[K a stored result for reproducibility\r\n\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kaudit\u001b[m\u001b[K\":\r\n\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcmd\u001b[01;31m\u001b[KAudit\u001b[m\u001b[K(os.Args[2:])\r\n"]
[3076.754976, "o", "\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KenvironmentMetadata\u001b[m\u001b[K returns the environment fingerprint metadata required for\r\n\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KenvironmentMetadata\u001b[m\u001b[K() map[string]string {\r\n"]
[3076.755037, "o", "\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\"\u001b[01;31m\u001b[Kenv_go\u001b[m\u001b[K_version\": runtime.Version(),\r\n"]
[3076.755097, "o", "\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\"\u001b[01;31m\u001b[Kenv_os\u001b[m\u001b[K\":         runtime.GOOS,\r\n\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\"\u001b[01;31m\u001b[Kenv_arch\u001b[m\u001b[K\":       runtime.GOARCH,\r\n"]
[3076.75519, "o", "\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\"\u001b[01;31m\u001b[Kenv_hostname\u001b[m\u001b[K\":   hostname,\r\n"]
[3076.75525, "o", "\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tGoVersion: metadata[\"\u001b[01;31m\u001b[Kenv_go\u001b[m\u001b[K_version\"],\r\n\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tOS:        metadata[\"\u001b[01;31m\u001b[Kenv_os\u001b[m\u001b[K\"],\r\n\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tArch:      metadata[\"\u001b[01;31m\u001b[Kenv_arch\u001b[m\u001b[K\"],\r\n\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tHostname:  metadata[\"\u001b[01;31m\u001b[Kenv_hostname\u001b[m\u001b[K\"],\r\n"]
[3076.755362, "o", "\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor k, v := range \u001b[01;31m\u001b[KenvironmentMetadata\u001b[m\u001b[K() {\r\n"]
[3076.75545, "o", "\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K544\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc cmd\u001b[01;31m\u001b[KAudit\u001b[m\u001b[K(args []string) {\r\n\u001b[35m\u001b[K/app/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K546\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge \u001b[01;31m\u001b[Kaudit\u001b[m\u001b[K <result_id> --store-dir <dir>\\n\")\r\n"]
