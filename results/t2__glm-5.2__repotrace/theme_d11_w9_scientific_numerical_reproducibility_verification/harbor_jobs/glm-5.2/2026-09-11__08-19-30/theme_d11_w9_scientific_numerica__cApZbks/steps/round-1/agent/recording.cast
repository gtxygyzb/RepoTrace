[3919.106536, "o", "\u001b[35m\u001b[K./engine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"simple_mc\", \"integrand\": \"sin(x)*exp(-x^2/2)\"},\r\n\u001b[35m\u001b[K./engine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"importance_sampling\", \"status\": \"no_accepted_samples\"},\r\n\u001b[35m\u001b[K./engine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"importance_sampling\", \"integrand\": \"sin(x)*exp(-x^2/2)\"},\r\n"]
