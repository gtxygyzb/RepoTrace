[4297.633948, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4297.634014, "o", "\u001b[?2004h> "]
[4297.634188, "o", "Lists stored experiment results.\r\n\u001b[?2004l\r"]
[4297.634256, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4297.634325, "o", "\u001b[?2004h> ```\r\n"]
[4297.634399, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4297.634735, "o", "numeriforge list [--experiment <name>] [--store-dir <dir>]\r\n\u001b[?2004l\r"]
[4297.634805, "o", "\u001b[?2004h> ```\r\n\u001b[?2004l\r"]
[4297.634883, "o", "\u001b[?2004h> "]
[4297.63495, "o", "\"\"\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4297.635118, "o", "\"\"\"### `numeriforge list`\r\n\u001b[?2004l\r"]
[4297.635185, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4297.635251, "o", "\u001b[?2004h> "]
[4297.635424, "o", "Lists stored experiment results.\r\n\u001b[?2004l\r"]
[4297.635517, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4297.635585, "o", "> ```\r\n\u001b[?2004l\r"]
[4297.635651, "o", "\u001b[?2004h> "]
[4297.636096, "o", "numeriforge list [--experiment <name>] [--store-dir <dir>] [--tag key=value ...]\r\n\u001b[?2004l\r"]
[4297.636155, "o", "\u001b[?2004h> "]
