[3926.56373, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6"]
[3926.563865, "o", "\t\t\"math\"\r\n     7\t\t\"os\"\r\n     8\t\t\"runtime\"\r\n     9\t\t\"strconv\"\r\n    10\t\t\"strings\"\r\n    11\t\t\"time\"\r\n    12\t\r\n    13\t\t\"numeriforge/compare\"\r\n"]
[3926.563945, "o", "    14\t\t\"numeriforge/config\"\r\n    15\t\t\"numeriforge/engine\"\r\n    16\t\t\"numeriforge/storage\"\r\n    17\t)\r\n    18\t\r\n    19\tfunc usage() {\r\n    20\t\tfmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform\r\n    21\t\r\n    22\tUsage:\r\n    23\t  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]\r\n    24\t  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\r\n    25\t  numeriforge list [--experiment <name>] [--store-dir <dir>]\r\n    26\t  numeriforge export <result_id> --store-dir <dir> [--format json|csv]\r\n    27\t  numeriforge verify <result_id> --store-dir <dir> [--verbose]\r\n    28\t  numeriforge audit <result_id> --store-dir <dir>\r\n    29\t  numeriforge audit --all --store-dir <dir>\r\n    30\t\r\n    31\tCommands:\r\n    32\t  run       Run an experiment and store the result\r\n    33\t  compare   Compare two stored results\r\n    34\t  list      List stored experiment results\r\n "]
[3926.564029, "o", "   35\t  export    Export a result to a different format\r\n    36\t  verify    Verify result integrity\r\n    37\t  audit     Audit stored result(s) for reproducibility\r\n    38\t\r\n    39\tAvailable experiments:\r\n    40\t`)\r\n    41\t"]
[3926.564097, "o", "\tfor _, name := range engine.List() {\r\n    42\t\t\tfmt.Fprintf(os.Stderr, \"  %s\\n\", name)\r\n    43\t\t}\r\n    44\t}\r\n    45\t\r\n    46\tfunc main() {\r\n    47\t\tif len(os.Args) < 2 {\r\n    48\t\t\tusage()\r\n    49\t\t\tos.Exit(1)\r\n    50\t\t}\r\n    51\t\r\n    52\t\tcmd := os.Args[1]\r\n    53\t\r\n"]
[3926.564163, "o", "    54\t\tswitch cmd {\r\n    55\t\tcase \"run\":\r\n    56\t\t\tcmdRun(os.Args[2:])\r\n    57\t\tcase \"compare\":\r\n    58\t\t\tcmdCompare(os.Args[2:])\r\n    59\t\tcase \"list\":\r\n    60\t\t\tcmdList(os.Args[2:])\r\n    61\t\tcase \"export\":\r\n    62\t\t\tcmdExport(os.Args[2:])\r\n    63\t\tcase \"verify\":\r\n    64\t\t\tcmdVerify(os.Args[2:])\r\n    65\t\tcase \"audit\":\r\n    66\t\t\tcmdAudit(os.Args[2:])\r\n"]
[3926.564224, "o", "    67\t\tcase \"help\", \"--help\", \"-h\":\r\n    68\t\t\tusage()\r\n    69\t\tdefault:\r\n    70\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n    71\t\t\tusage()\r\n    72\t\t\tos.Exit(1)\r\n    73\t\t}\r\n    74\t}\r\n    75\t\r\n"]
[3926.564288, "o", "    76\t// environmentMetadata returns the environment fingerprint metadata required for\r\n    77\t// reproducible experiment traces.\r\n    78\tfunc environmentMetadata() map[string]string {\r\n    79\t\thostname, err := os.Hostname()\r\n    80\t\tif err != nil {\r\n"]
[3926.564348, "o", "    81\t\t\thostname = \"unknown\"\r\n    82\t\t}\r\n    83\t\treturn map[string]string{\r\n    84\t\t\t\"env_go_version\": runtime.Version(),\r\n    85\t\t\t\"env_os\":         runtime.GOOS,\r\n    86\t\t\t\"env_arch\":       runtime.GOARCH,\r\n    87\t\t\t\"env_hostname\":   hostname,\r\n    88\t\t}\r\n    89\t}\r\n    90\t\r\n    91\t// environmentFromMetadata aggregates stored environment fingerprint metadata\r\n    92\t// into an export-friendly object.\r\n"]
[3926.564414, "o", "    93\ttype environmentInfo struct {\r\n    94\t\tGoVersion string `json:\"go_version\"`\r\n    95\t\tOS        string `json:\"os\"`\r\n    96\t\tArch      string `json:\"arch\"`\r\n    97\t\tHostname  string `json:\"hostname\"`\r\n    98\t}\r\n    99\t\r\n   100\tfunc environmentFromMetadata(metadata map[string]string) environmentInfo {\r\n   101\t\treturn environmentInfo{\r\n   102\t"]
[3926.564497, "o", "\t\tGoVersion: metadata[\"env_go_version\"],\r\n   103\t\t\tOS:        metadata[\"env_os\"],\r\n   104\t\t\tArch:      metadata[\"env_arch\"],\r\n   105\t\t\tHostname:  metadata[\"env_hostname\"],\r\n   106\t\t}\r\n   107\t}\r\n   108\t\r\n   109\ttype exportPayload struct {\r\n   110\t\t*storage.StoredResult\r\n   111\t\tEnvironment environmentInfo `json:\"environment\"`\r\n   112"]
[3926.564562, "o", "\t}\r\n   113\t\r\n   114\tfunc cmdRun(args []string) {\r\n   115\t\tvar experimentName, outputDir, configPath string\r\n   116\t\tvar paramStrs []string\r\n   117\t\tvar seed int64\r\n   118\t\tseedProvided := false\r\n   119\t\r\n   120\t\tfor i := 0; i < len(args); i++ {\r\n   121\t\t\tswitch args[i] {\r\n"]
[3926.564618, "o", "   122\t\t\tcase \"--experiment\":\r\n   123\t\t\t\ti++\r\n   124\t\t\t\tif i >= len(args) {\r\n   125\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment requires a value\\n\")\r\n   126\t\t\t\t\tos.Exit(1)\r\n   127\t\t\t\t}\r\n"]
[3926.564683, "o", "   128\t\t\t\texperimentName = args[i]\r\n   129\t\t\tcase \"--output-dir\":\r\n   130\t\t\t\ti++\r\n   131\t\t\t\tif i >= len(args) {\r\n   132\t\t\t\t\t"]
[3926.56474, "o", "fmt.Fprintf(os.Stderr, \"error: --output-dir requires a value\\n\")\r\n   133\t\t\t\t\tos.Exit(1)\r\n   134\t\t\t\t}\r\n   135\t\t\t\toutputDir = args[i]\r\n   136\t\t\tcase \"--config\":\r\n   137\t\t\t\ti++\r\n   138\t\t\t\tif i >= len(args) {\r\n   139\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --config requires a value\\n\")\r\n   140\t\t\t\t\tos.Exit(1)\r\n   141\t\t\t\t}\r\n   142\t\t\t\tconfigPath = args[i]\r\n   143\t\t\tcase \"--param\":\r\n   144\t"]
[3926.564803, "o", "\t\t\ti++\r\n   145\t\t\t\tif i >= len(args) {\r\n   146\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --param requires a value\\n\")\r\n   147\t\t\t\t\tos.Exit(1)\r\n   148\t\t\t\t}\r\n"]
[3926.564864, "o", "   149\t\t\t\tparamStrs = append(paramStrs, args[i])\r\n   150\t\t\tcase \"--seed\":\r\n   151\t\t\t\ti++\r\n   152\t\t\t\tif i >= len(args) {\r\n   153\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --seed requires a value\\n\")\r\n   154\t\t\t\t\tos.Exit(1)\r\n   155\t\t\t\t}\r\n   156\t\t\t\tparsed, err := strconv.ParseInt(args[i], 10, 64)\r\n   157\t\t\t\tif err != nil {\r\n   158\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid seed: %v\\n\", err)\r\n   159\t\t\t\t\tos.Exit(1)\r\n   160\t\t\t\t}\r\n   161\t\t\t\tseed = parsed\r\n"]
[3926.564922, "o", "   162\t\t\t\tseedProvided = true\r\n   163\t\t\tdefault:\r\n   164\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   165\t\t\t\tos.Exit(1)\r\n   166\t\t\t}\r\n   167\t\t}\r\n   168\t\r\n   169\t\tif configPath != \"\" {\r\n   170\t\t\tcfg, err := config.ParseINI(configPath)\r\n   171\t"]
[3926.564983, "o", "\t\tif err != nil {\r\n   172\t\t\t\tfmt.Fprintf(os.Stderr, \"config error: %v\\n\", err)\r\n   173\t\t\t\tos.Exit(1)\r\n   174\t\t\t}\r\n   175\t\t\tif experimentName == \"\" {\r\n   176\t\t\t\texperimentName = cfg.Experiment\r\n   177\t\t\t}\r\n   178\t\t\tif outputDir == \"\" {\r\n   179\t\t\t\toutputDir = cfg.OutputDir\r\n"]
[3926.565041, "o", "   180\t\t\t}\r\n   181\t\r\n   182\t\t\tcliParams, _ := config.ParseParams(paramStrs)\r\n   183\t\t\tcliParamMap := make(map[string]float64)\r\n   184\t\t\tfor _, p := range cliParams {\r\n   185\t\t\t\tcliParamMap[p.Name] = p.Value\r\n   186\t\t\t}\r\n   187\t\t\tfor _, p := range cfg.Params {\r\n"]
[3926.565096, "o", "   188\t\t\t\tif _, exists := cliParamMap[p.Name]; !exists {\r\n   189\t\t\t\t\tcliParams = append(cliParams, p)\r\n   190\t\t\t\t}\r\n   191\t\t\t}\r\n   192\t\t\tparamStrs = nil\r\n   193\t\t\tfor _, p := range cliParams {\r\n   194\t\t\t\tparamStrs = append(paramStrs, fmt.Sprintf(\"%s=%g\", p.Name, p.Value))\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197\t"]
[3926.565159, "o", "\r\n   198\t\tif experimentName == \"\" {\r\n   199\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment is required\\n\")\r\n   200\t\t\tos.Exit(1)\r\n   201\t\t}\r\n"]
[3926.565216, "o", "   202\t\tif outputDir == \"\" {\r\n   203\t\t\toutputDir = \"./results\"\r\n   204\t\t}\r\n   205\t\r\n   206\t\tparams, err := config.ParseParams(paramStrs)\r\n   207\t\tif err != nil {\r\n   208\t\t\tfmt.Fprintf(os.Stderr, \"parameter error: %v\\n\", err)\r\n   209\t\t\tos.Exit(1)\r\n   210\t\t}\r\n   211\t\r\n   212\t\tfn, err := engine.Get(experimentName)\r\n   213\t\tif err != nil {\r\n"]
[3926.565277, "o", "   214\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   215\t\t\tos.Exit(1)\r\n   216\t\t}\r\n   217\t\r\n   218\t\tif !seedProvided {\r\n   219\t\t\tseed = time.Now().UnixNano()\r\n   220\t\t}\r\n   221\t\r\n   222\t\trng := engine.NewRNG(seed)\r\n   223\t\r\n"]
[3926.56534, "o", "   224\t\tresult, err := fn(experimentName, params, rng)\r\n   225\t\tif err != nil {\r\n   226\t\t\tfmt.Fprintf(os.Stderr, \"experiment error: %v\\n\", err)\r\n   227\t\t\tos.Exit(1)\r\n   228\t\t}\r\n   229\t\r\n   230\t\tif result.Metadata == nil {\r\n   231\t\t\tresult.Metadata = map[string]string{}\r\n   232\t\t}\r\n   233"]
[3926.565417, "o", "\t\tif _, ok := result.Metadata[\"seed\"]; !ok {\r\n   234\t\t\tresult.Metadata[\"seed\"] = strconv.FormatInt(seed, 10)\r\n   235\t\t}\r\n   236\t\tif seedProvided {\r\n   237\t\t\tresult.Metadata[\"seed_source\"] = \"provided\"\r\n"]
[3926.565501, "o", "   238\t\t} else {\r\n   239\t\t\tresult.Metadata[\"seed_source\"] = \"auto-generated\"\r\n   240\t\t}\r\n"]
