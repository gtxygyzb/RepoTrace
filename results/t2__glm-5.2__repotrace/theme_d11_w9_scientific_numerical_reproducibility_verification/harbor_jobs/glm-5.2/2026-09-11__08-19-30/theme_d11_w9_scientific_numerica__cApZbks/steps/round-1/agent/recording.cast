[2273.556692, "o", "   105\t\t\tcase \"--seed\":\r\n   106\t\t\t\ti++\r\n   107\t\t\t\tif i >= len(args) {\r\n   108\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --seed requires a value\\n\")\r\n   109\t\t\t\t\tos.Exit(1)\r\n   110\t\t\t\t}\r\n   111\t\t\t\tparsed, err := strconv.ParseInt(args[i], 10, 64)\r\n   112\t\t\t\tif err != nil {\r\n   113\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid seed: %v\\n\", err)\r\n   114\t\t\t\t\tos.Exit(1)\r\n   115\t\t\t\t}\r\n   116\t\t\t\tseed = parsed\r\n   117\t\t\t\tseedProvided = true\r\n   118\t\t\tdefault:\r\n   119\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   120\t\t\t\tos.Exit(1)\r\n"]
[2273.556756, "o", "   121\t\t\t}\r\n   122\t\t}\r\n   123\t\r\n   124\t\tif configPath != \"\" {\r\n   125\t\t\tcfg, err := config.ParseINI(configPath)\r\n   126\t\t\tif err != nil {\r\n   127\t\t\t\tfmt.Fprintf(os.Stderr, \"config error: %v\\n\", err)\r\n   128\t\t\t\tos.Exit(1)\r\n   129\t\t\t}\r\n"]
