[283.726865, "i", "nl -ba engine/montecarlo.go | sed -n '1,260p'\n"]
[283.727216, "o", "nl -ba engine/montecarlo.go | sed -n '1,260p'\r\n\u001b[?2004l\r"]
[283.730583, "o", "     1\tpackage engine\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"math\"\r\n     5\t\t\"time\"\r\n"]
[283.730683, "o", "     6\t)\r\n     7\t\r\n     8\tfunc registerMonteCarloExperiments() {\r\n     9\t\tRegister(\"mc-estimate-pi\", mcEstimatePi)\r\n    10\t\tRegister(\"mc-integral\", mcIntegral)\r\n"]
[283.730761, "o", "    11\t\tRegister(\"mc-importance-sampling\", mcImportanceSampling)\r\n    12\t}\r\n    13\t\r\n    14\t// mcEstimatePi estimates pi using the classic circle/square Monte Carlo method.\r\n    15\t// Parameters: samples (int)\r\n    16\t// TODO: This uses GlobalRand which makes results non-reproducible.\r\n    17\t//       Need to accept a seed parameter and create a local random source.\r\n    18\tfunc mcEstimatePi(name string, params []Parameter) (*Result, error) {\r\n    19\t\tsamplesF, err := RequireParam(params, \"samples\")\r\n    20\t\tif err != nil {\r\n    21\t\t\treturn nil, err\r\n    22\t\t}\r\n    23\t\tsamples := int(samplesF)\r\n    24\t\tif samples <= 0 {\r\n    25\t\t\tsamples = 100000\r\n    26\t\t}\r\n    27\t\r\n    28\t\tinside := 0\r\n    29\t\tfor i := 0; i < samples; i++ {\r\n    30\t\t\tx := GlobalRand.Float64()"]
[283.730839, "o", "\r\n    31\t\t\ty := GlobalRand.Float64()\r\n    32\t\t\tif x*x+y*y <= 1.0 {\r\n    33\t\t\t\tinside++\r\n    34\t\t\t}\r\n    35\t\t}\r\n    36\t\r\n    37\t\tpiEstimate := 4.0 * float64(inside) / float64(samples)\r\n    38\t\terrorMargin := math.Abs(piEstimate - math.Pi)\r\n    39\t\r\n    40\t\treturn &Result{\r\n    41"]
[283.730921, "o", "\t\t\tExperimentName: name,\r\n    42\t\t\tTimestamp:      time.Now(),\r\n    43\t\t\tParameters:     params,\r\n    44\t\t\tValues:         []float64{piEstimate, errorMargin, float64(inside), float64(samples)},\r\n    45\t\t\tLabels:         []string{\"pi_estimate\", \"error_margin\", \"inside_count\", \"total_samples\"},\r\n    46\t\t\tMetadata:       map[string]string{\"method\": \"circle_square\"},\r\n    47\t\t}, nil\r\n    48\t}\r\n    49\t\r\n    50\t// mcIntegral performs numerical integration of f(x) = sin(x)*exp(-x^2/2) over [a,b]\r\n    51\t// using simple Monte Carlo sampling.\r\n"]
[283.730984, "o", "    52\t// Parameters: samples (int), lower_bound (float), upper_bound (float)\r\n    53\t// TODO: Uses GlobalRand - not reproducible.\r\n    54\tfunc mcIntegral(name string, params []Parameter) (*Result, error) {\r\n    55\t\tsamplesF, err := RequireParam(params, \"samples\")\r\n    56\t\tif err != nil {\r\n    57\t\t\treturn nil, err\r\n    58\t\t}\r\n    59\t\tlower, err := RequireParam(params, \"lower_bound\")\r\n    60\t\tif err != nil {\r\n"]
[283.731043, "o", "    61\t\t\treturn nil, err\r\n    62\t\t}\r\n    63\t\tupper, err := RequireParam(params, \"upper_bound\")\r\n    64\t\tif err != nil {\r\n    65\t\t\treturn nil, err\r\n    66\t\t}\r\n    67\t\r\n    68\t"]
[283.731103, "o", "\tsamples := int(samplesF)\r\n    69\t\tif samples <= 0 {\r\n    70\t\t\tsamples = 100000\r\n    71\t\t}\r\n    72\t\r\n    73\t\twidth := upper - lower\r\n    74\t\tsum := 0.0\r\n    75\t\tsumSq := 0.0\r\n"]
[283.731168, "o", "    76\t\tfor i := 0; i < samples; i++ {\r\n    77\t\t\tx := lower + GlobalRand.Float64()*width\r\n    78\t\t\tfx := math.Sin(x) * math.Exp(-x*x/2.0)\r\n    79\t\t\tsum += fx\r\n    80\t\t\tsumSq += fx * fx\r\n    81\t\t}\r\n    82\t\r\n    83\t\tmean := sum / float64(samples)\r\n    84\t\tintegral := width * mean\r\n"]
[283.731226, "o", "    85\t\tvariance := (sumSq/float64(samples) - mean*mean) / float64(samples)\r\n    86\t\tstdErr := math.Sqrt(math.Abs(variance)) * width\r\n    87\t\r\n    88\t\treturn &Result{\r\n    89\t\t\tExperimentName: name,\r\n    90\t\t\tTimestamp:      time.Now(),\r\n    91\t\t\tParameters:     params,\r\n    92\t\t\tValues:         []float64{integral, stdErr, mean, variance},\r\n    93\t\t\tLabels:         []string{\"integral\", \"std_error\", \"mean_value\", \"variance\"},\r\n"]
[283.731293, "o", "    94\t\t\tMetadata:       map[string]string{\"method\": \"simple_mc\", \"integrand\": \"sin(x)*exp(-x^2/2)\"},\r\n    95\t\t}, nil\r\n    96\t}\r\n    97\t\r\n    98\t// mcImportanceSampling performs Monte Carlo integration using importance sampling\r\n    99\t// with a Gaussian proposal distribution.\r\n   100\t// Parameters: samples (int), lower_bound (float), upper_bound (float), proposal_mean (float), proposal_std (float)\r\n   101\t// TODO: Uses GlobalRand - not reproducible.\r\n   102\tfunc mcImportanceSampling(name string, params []Parameter) (*Result, error) {\r\n   103\t\tsamplesF, err := RequireParam(params, \"samples\")\r\n"]
[283.731355, "o", "   104\t\tif err != nil {\r\n   105\t\t\treturn nil, err\r\n   106\t\t}\r\n   107\t\tlower, err := RequireParam(params, \"lower_bound\")\r\n   108\t\tif err != nil {\r\n   109\t\t\treturn nil, err\r\n   110\t\t}\r\n   111\t\tupper, err := RequireParam(params, \"upper_bound\")\r\n"]
[283.731417, "o", "   112\t\tif err != nil {\r\n   113\t\t\treturn nil, err\r\n   114\t\t}\r\n   115\t\tpMean, err := RequireParam(params, \"proposal_mean\")\r\n   116\t\tif err != nil {\r\n   117\t\t\treturn nil, err\r\n   118\t\t}\r\n   119\t\tpStd, err := RequireParam(params, \"proposal_std\")\r\n   120\t\tif err != nil {\r\n   121\t\t"]
[283.731525, "o", "\treturn nil, err\r\n   122\t\t}\r\n   123\t\r\n   124\t\tsamples := int(samplesF)\r\n   125\t\tif samples <= 0 {\r\n   126\t\t\tsamples = 100000\r\n"]
[283.731589, "o", "   127\t\t}\r\n   128\t\r\n   129\t\t// Target: f(x) = sin(x)*exp(-x^2/2) on [lower, upper]\r\n   130\t\t// Proposal: truncated Gaussian N(pMean, pStd^2) on [lower, upper]\r\n   131\t\tsum := 0.0\r\n   132\t\tsumSq := 0.0\r\n   133\t\taccepted := 0\r\n   134\t\r\n   135\t\tfor i := 0; i < samples; i++ {\r\n   136\t\t\t// Generate from truncated Gaussian via rejection\r\n   137\t\t\tvar x float64\r\n   138\t\t\tfor {\r\n   139\t\t\t\tx = GlobalRand.NormFloat64()*pStd + pMean\r\n   140\t\t\t\tif x >= lower && x <= upper {\r\n   141\t\t\t"]
[283.731673, "o", "\t\tbreak\r\n   142\t\t\t\t}\r\n   143\t\t\t}\r\n   144\t\r\n   145\t\t\t// Target function\r\n   146\t\t\tfx := math.Sin(x) * math.Exp(-x*x/2.0)\r\n   147\t\r\n   148\t\t\t// Proposal density (unnormalized Gaussian)\r\n   149\t\t\tqx := math.Exp(-(x-pMean)*(x-pMean) / (2.0 * pStd * pStd))\r\n   150\t"]
[283.731736, "o", "\r\n   151\t\t\tif qx > 1e-300 {\r\n   152\t\t\t\tw := fx / qx\r\n   153\t\t\t\tsum += w\r\n   154\t\t\t\tsumSq += w * w\r\n   155\t\t\t\taccepted++\r\n   156\t\t\t}\r\n   157\t\t}\r\n"]
[283.731794, "o", "   158\t\r\n   159\t\tif accepted == 0 {\r\n   160\t\t\treturn &Result{\r\n   161\t\t\t\tExperimentName: name,\r\n   162\t\t\t\tTimestamp:      time.Now(),\r\n   163\t\t\t\tParameters:     params,\r\n   164\t\t\t\tValues:         []float64{0, 0, 0, 0},\r\n   165\t\t\t\tLabels:         []string{\"integral\", \"std_error\", \"effective_samples\", \"acceptance_rate\"},\r\n"]
[283.731857, "o", "   166\t\t\t\tMetadata:       map[string]string{\"method\": \"importance_sampling\", \"status\": \"no_accepted_samples\"},\r\n   167\t\t\t}, nil\r\n   168\t\t}\r\n   169\t\r\n   170\t\tmean := sum / float64(accepted)\r\n   171\t\tvariance := (sumSq/float64(accepted) - mean*mean) / float64(accepted)\r\n   172\t\tstdErr := math.Sqrt(math.Abs(variance))\r\n   173\t\t// Normalize: the integral estimate needs scaling by the proposal normalization constant\r\n   174\t\t// For simplicity, we report the weighted mean as the integral estimate\r\n"]
[283.731934, "o", "   175\t\tintegral := mean * pStd * math.Sqrt(2.0*math.Pi)\r\n   176\t\taccRate := float64(accepted) / float64(samples)\r\n   177\t\r\n   178\t\treturn &Result{\r\n   179\t\t\tExperimentName: name,\r\n   180\t\t\tTimestamp:      time.Now(),\r\n   181\t\t\tParameters:     params,\r\n   182\t\t\tValues:         []float64{integral, stdErr, float64(accepted), accRate},\r\n   183\t\t\tLabels:         []string{\"integral\", \"std_error\", \"effective_samples\", \"acceptance_rate\"},\r\n   184\t\t\tMetadata:       map[string]string{\"method\": \"importance_sampling\", \"integrand\": \"sin(x)*exp(-x^2/2)\"},\r\n   185\t\t}, nil\r\n   186"]
[283.731972, "o", "\t}\r\n"]
