[445.071277, "o", "\u001b[35m\u001b[Kengine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KRegister(\u001b[m\u001b[K\"mc-integral\", mcIntegral)\r\n\u001b[35m\u001b[Kengine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K11\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KRegister(\u001b[m\u001b[K\"mc-importance-sampling\", mcImportanceSampling)\r\n\u001b[35m\u001b[Kengine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// TODO: This uses \u001b[01;31m\u001b[KGlobalRand\u001b[m\u001b[K which makes results non-reproducible.\r\n\u001b[35m\u001b[Kengine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KmcEstimatePi(name string, params []Parameter) (*Result, error) {\r\n\u001b[35m\u001b[Kengine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tx := \u001b[01;31m\u001b[KGlobalRand\u001b[m\u001b[K.Float64()\r\n\u001b[35m\u001b[Kengine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\ty := \u001b[01;31m\u001b[KGlobalRand\u001b[m\u001b[K.Float64()\r\n"]
[445.071347, "o", "\u001b[35m\u001b[Kengine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// TODO: Uses \u001b[01;31m\u001b[KGlobalRand\u001b[m\u001b[K - not reproducible.\r\n\u001b[35m\u001b[Kengine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KmcIntegral(name string, params []Parameter) (*Result, error) {\r\n\u001b[35m\u001b[Kengine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tx := lower + \u001b[01;31m\u001b[KGlobalRand\u001b[m\u001b[K.Float64()*width\r\n\u001b[35m\u001b[Kengine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// TODO: Uses \u001b[01;31m\u001b[KGlobalRand\u001b[m\u001b[K - not reproducible.\r\n\u001b[35m\u001b[Kengine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KmcImportanceSampling(name string, params []Parameter) (*Result, error) {\r\n\u001b[35m\u001b[Kengine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K139\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tx = \u001b[01;31m\u001b[KGlobalRand\u001b[m\u001b[K.NormFloat64()*pStd + pMean\r\n"]
