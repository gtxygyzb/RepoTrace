[385.446384, "o", "\t\t\t\t\tValueA:  a.Values[i],\r\n\t\t\t\t\tValueB:  b.Values[i],\r\n\t\t\t\t\tAbsDiff: math.Abs(a.Values[i] - b.Values[i]),\r\n\t\t\t\t\tRelDiff: relDiff(a.Values[i], b.Values[i]),\r\n\t\t\t\t})\r\n"]
[385.446457, "o", "\t\t\t} else {\r\n\t\t\t\tresult.MatchedPairs++\r\n\t\t\t}\r\n\t\t}\r\n\tcase ModeTolerance:\r\n\t\t// TODO: Implement tolerance-based comparison.\r\n\t\t// For each value pair, should check:\r\n\t\t// 1. If both values are zero (within absolute tolerance), they match.\r\n\t\t// 2. Otherwise, check both absolute and relative tolerance:\r\n\t\t//    |a - b| <= tol.Absolute  OR  |a - b| / max(|a|, |b|) <= tol.Relative\r\n\t\t// 3. Handle NaN and Inf specially: NaN matches NaN, Inf matches Inf.\r\n\t\tresult.Match = false\r\n\t\tresult.Summary = \"tolerance comparison not yet implemented\"\r\n\t}\r\n\r\n\tif result.Summary == \"\" {\r\n\t\tif result.Match {\r\n\t\t\tresult.Summary = fmt.Sprintf(\"all %d value pairs match\", result.TotalPairs)\r\n\t\t} else {\r\n\t\t\tresult.Summary = fmt.Sprintf(\"%d of %d value pairs mismatch\", len(result.Mismatches), result.TotalPairs)\r\n\t\t}\r\n\t}\r\n\r\n\treturn result\r\n}\r\n\r\n"]
