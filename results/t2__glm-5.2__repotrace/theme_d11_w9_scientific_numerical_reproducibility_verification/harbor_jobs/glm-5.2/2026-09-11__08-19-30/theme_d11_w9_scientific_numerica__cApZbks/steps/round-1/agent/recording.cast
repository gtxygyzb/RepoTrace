[314.726679, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KcmdVerify\u001b[m\u001b[K(os.Args[2:])\r\n"]
[314.726762, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcmdVerify\u001b[m\u001b[K(args []string) {\r\n"]
[314.72682, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// 2. Recompute the \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[K from the stored values\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K360\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// 3. Compare with the stored \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[K\r\n"]
[314.726937, "o", "\u001b[35m\u001b[K./compare/compare.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc Compare\u001b[m\u001b[K(a, b *storage.StoredResult, mode ComparisonMode, tol Tolerance) *ComparisonResult {\r\n"]
[314.72704, "o", "\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K5\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KThis document defines the reproducibility guarantees that NumeriForge provides. It covers seed management for deterministic execution, result integrity via \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[Ks, and tolerance-based comparison for scientific value matching.\r\n"]
[314.727132, "o", "\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K### 3.1 \u001b[01;31m\u001b[KChecksum\u001b[m\u001b[K Computation\r\n\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KEvery stored result must include a SHA-256 \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[K of the canonical value representation.\r\n\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K- The \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[K must be stored in the `StoredResult` JSON under the key `\"\u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[K\"`.\r\n\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K- The \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[K must also be stored in the result metadata under the key `\"values_\u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[K\"`.\r\n\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K2. Recompute the \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[K from the stored values using the canonical algorithm.\r\n\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K54\u001b[m"]
[314.727218, "o", "\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K3. Compare with the stored \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[K.\r\n\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K4. Print `VERIFIED: <id>` and exit 0 if \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[Ks match.\r\n\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K6. Print `NO_CHECKSUM: <id>` and exit 2 if the stored result has no \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[K field.\r\n\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KResults stored without \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[Ks (pre-reproducibility) remain loadable. The verify command reports `NO_CHECKSUM` for such results rather than treating them as corrupt.\r\n"]
[314.727284, "o", "\u001b[35m\u001b[K./docs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K**Known limitation:** Results do not include integrity \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[Ks. There is no way to verify that stored values have not been corrupted or tampered with.\r\n\u001b[35m\u001b[K./docs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K3. **No integrity verification**: Results are stored without \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[Ks. The `verify` command is a stub.\r\n"]
[314.727434, "o", "\u001b[35m\u001b[K./docs/architecture.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K1. **Global random state**: All stochastic experiments share `engine.\u001b[01;31m\u001b[KGlobalRand\u001b[m\u001b[K`, which is seeded with `time.Now().UnixNano()` at package init. This was originally a simplicity choice but prevents reproducibility.\r\n\u001b[35m\u001b[K./docs/architecture.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K2. **Flat result format**: Results are plain JSON files with no schema versioning, no \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[Ks, and no provenance metadata.\r\n"]
[314.727565, "o", "\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype Stored\u001b[m\u001b[KResult struct {\r\n\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// TODO: Add \u001b[01;31m\u001b[KChecksum\u001b[m\u001b[K field for result integrity verification.\r\n"]
[314.727636, "o", "\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// The \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[K should be a SHA-256 hash of the canonical representation\r\n\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// TODO: Compute and store \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[K here.\r\n"]
[314.727692, "o", "\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// TODO: Add Verify function that checks result integrity using \u001b[01;31m\u001b[Kchecksum\u001b[m\u001b[Ks.\r\n"]
[314.72824, "o", "\u001b[?2004h"]
[314.728308, "o", "root@n30009:/app# "]
[314.981398, "i", "sed -n '1,170p' storage/storage.go\n"]
[314.981723, "o", "sed -n '1,170p' storage/storage.go\r\n\u001b[?2004l\r"]
[314.985225, "o", "package storage\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[314.985317, "o", "\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"numeriforge/engine\"\r\n)\r\n\r\n"]
[314.985386, "o", "// StoredResult is the on-disk representation of an experiment result.\r\ntype StoredResult struct {\r\n\tID             string            `json:\"id\"`\r\n\tExperimentName string            `json:\"experiment_name\"`\r\n\tTimestamp      time.Time         `json:\"timestamp\"`\r\n\tParameters     []engine.Parameter `json:\"parameters\"`\r\n\tValues         []float64         `json:\"values\"`\r\n\tLabels         []string          `json:\"labels\"`\r\n\tMetadata       map[string]string `json:\"metadata\"`\r\n\t// TODO: Add Checksum field for result integrity verification.\r\n\t// The checksum should be a SHA-256 hash of the canonical representation\r\n"]
[314.985464, "o", "\t// of the Values array.\r\n}\r\n\r\n// Store manages experiment result persistence.\r\ntype Store struct {\r\n\tBaseDir string\r\n}\r\n\r\n// NewStore creates a store at the given directory.\r\nfunc NewStore(baseDir string) (*Store, error) {\r\n\tif err := os.MkdirAll(baseDir, 0755); err != nil {"]
[314.985558, "o", "\r\n\t\treturn nil, fmt.Errorf(\"cannot create store directory: %w\", err)\r\n\t}\r\n\treturn &Store{BaseDir: baseDir}, nil\r\n}\r\n\r\n// Save persists an experiment result to disk.\r\nfunc (s *Store) Save(result *engine.Result) (string, error) {\r\n\tid := fmt.Sprintf(\"%s_%s\", result.ExperimentName, result.Timestamp.Format(\"20060102_150405\"))"]
[314.98562, "o", "\r\n\r\n\tstored := StoredResult{\r\n\t\tID:             id,\r\n\t\tExperimentName: result.ExperimentName,\r\n\t\tTimestamp:      result.Timestamp,\r\n\t\tParameters:     result.Parameters,\r\n\t"]
[314.985679, "o", "\tValues:         result.Values,\r\n\t\tLabels:         result.Labels,\r\n\t\tMetadata:       result.Metadata,\r\n\t}\r\n\r\n\t// TODO: Compute and store checksum here.\r\n"]
[314.985736, "o", "\t// Should hash the canonical representation of Values.\r\n\r\n\tdata, err := json.MarshalIndent(stored, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"marshal error: %w\", err)\r\n\t}\r\n\r\n\tresultDir := filepath.Join(s.BaseDir, result.ExperimentName)"]
[314.985801, "o", "\r\n\tif err := os.MkdirAll(resultDir, 0755); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"cannot create result directory: %w\", err)\r\n\t}\r\n\r\n\tpath := filepath.Join(resultDir, id+\".json\")\r\n\tif err := os.WriteFile(path, data, 0644); err != nil {\r\n\t\t"]
[314.985861, "o", "return \"\", fmt.Errorf(\"write error: %w\", err)\r\n\t}\r\n\r\n\t// Update index\r\n\tif err := s.updateIndex(id, result.ExperimentName, result.Timestamp); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"index update error: %w\", err)\r\n\t}\r\n"]
[314.985935, "o", "\r\n\treturn id, nil\r\n}\r\n\r\n// Load reads a stored result by ID.\r\nfunc (s *Store) Load(id string) (*StoredResult, error) {\r\n\t// Parse experiment name from ID\r\n\tparts := strings.SplitN(id, \"_\", 2)\r\n\tif len(parts) < 2 {\r\n"]
[314.985997, "o", "\t\treturn nil, fmt.Errorf(\"invalid result ID: %s\", id)\r\n\t}\r\n\t// The experiment name may contain underscores, so we need to find the right file\r\n\tvar resultPath string\r\n\terr := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {\r\n\t\tif err != nil {\r\n"]
[314.986064, "o", "\t\t\treturn err\r\n\t\t}\r\n\t\tif !info.IsDir() && strings.TrimSuffix(info.Name(), \".json\") == id {\r\n\t\t\tresultPath = path\r\n"]
[314.986127, "o", "\t\t\treturn filepath.SkipAll\r\n\t\t}\r\n\t\treturn nil\r\n\t})\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif resultPath == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"result not found: %s\", id)\r\n\t}\r\n\r\n"]
[314.986187, "o", "\tdata, err := os.ReadFile(resultPath)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"read error: %w\", err)\r\n\t}\r\n\r\n\tvar stored StoredResult\r\n\tif err := json.Unmarshal(data, &stored); err != nil {\r\n"]
[314.986246, "o", "\t\treturn nil, fmt.Errorf(\"unmarshal error: %w\", err)\r\n\t}\r\n\treturn &stored, nil\r\n}\r\n\r\n// ListResults returns all stored result IDs, optionally filtered by experiment name.\r\nfunc (s *Store) ListResults(experimentFilter string) ([]IndexEntry, error) {"]
[314.986309, "o", "\r\n\tindex, err := s.readIndex()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tif experimentFilter == \"\" {\r\n"]
[314.98637, "o", "\t\treturn index, nil\r\n\t}\r\n\r\n\tvar filtered []IndexEntry\r\n\tfor _, entry := range index {\r\n\t\tif entry.ExperimentName == experimentFilter {\r\n\t\t\tfiltered = append(filtered, entry)\r\n\t\t}\r\n"]
[314.986427, "o", "\t}\r\n\treturn filtered, nil\r\n}\r\n\r\n// IndexEntry represents one line in the result index.\r\ntype IndexEntry struct {\r\n\tID             string\r\n\tExperimentName string\r\n\tTimestamp      time.Time"]
[314.986516, "o", "\r\n}\r\n\r\nfunc (s *Store) indexPath() string {\r\n\treturn filepath.Join(s.BaseDir, \"index.txt\")\r\n}\r\n\r\nfunc (s *Store) updateIndex(id, experimentName string, timestamp time.Time) error {\r\n\tf, err := os.OpenFile(s.indexPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)\r\n"]
[314.986575, "o", "\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\t_, err = fmt.Fprintf(f, \"%s|%s|%s\\n\", id, experimentName, timestamp.Format(time.RFC3339))\r\n\treturn err\r\n}"]
[314.986666, "o", "\r\n\r\nfunc (s *Store) readIndex() ([]IndexEntry, error) {\r\n\tdata, err := os.ReadFile(s.indexPath())\r\n"]
[314.986727, "o", "\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, nil\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\r\n"]
[314.987363, "o", "\u001b[?2004h"]
[314.987428, "o", "root@n30009:/app# "]
[315.253344, "i", "sed -n '1,170p' compare/compare.go\n"]
[315.253681, "o", "sed -n '1,170p' compare/compare.go\r\n\u001b[?2004l\r"]
[315.256371, "o", "package compare\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"strings\"\r\n\r\n"]
[315.256513, "o", "\t\"numeriforge/storage\"\r\n)\r\n\r\n// ComparisonMode determines how results are compared.\r\ntype ComparisonMode int\r\n\r\nconst (\r\n\t// ModeExact uses exact float equality (legacy, broken for scientific use).\r\n\tModeExact ComparisonMode = iota\r\n\t// ModeTolerance uses configurable absolute and relative tolerance.\r\n\t// TODO: Implement tolerance-based comparison.\r\n\tModeTolerance\r\n)\r\n\r\n// Tolerance defines comparison thresholds.\r\ntype Tolerance struct {\r\n\tAbsolute float64\r\n\tRelative float64\r\n}\r\n\r\n// DefaultTolerance returns a reasonable default for scientific comparisons.\r\nfunc DefaultTolerance() Tolerance {\r\n"]
[315.256625, "o", "\treturn Tolerance{\r\n\t\tAbsolute: 1e-10,\r\n\t\tRelative: 1e-8,\r\n\t}\r\n}\r\n\r\n// ComparisonResult holds the outcome of comparing two experiment results.\r\ntype ComparisonResult struct {\r\n\tMatch       bool\r\n"]
[315.256655, "o", "\tTotalPairs  int\r\n\tMatchedPairs int\r\n\tMismatches  []Mismatch\r\n\tMode        ComparisonMode\r\n\tSummary     string\r\n}\r\n\r\n// Mismatch records a single value pair that didn't match.\r\n"]
[315.256817, "o", "type Mismatch struct {\r\n\tIndex    int\r\n\tLabel    string\r\n\tValueA   float64\r\n\tValueB   float64\r\n\tAbsDiff  float64\r\n"]
[315.256896, "o", "\tRelDiff  float64\r\n}\r\n\r\n// Compare compares two stored results.\r\n// Currently only supports ModeExact (legacy behavior).\r\n// TODO: Implement ModeTolerance for proper scientific comparison.\r\nfunc Compare(a, b *storage.StoredResult, mode ComparisonMode, tol Tolerance) *ComparisonResult {\r\n"]
[315.256992, "o", "\tresult := &ComparisonResult{\r\n\t\tMode: mode,\r\n\t}\r\n\r\n\tif a.ExperimentName != b.ExperimentName {\r\n\t\tresult.Match = false\r\n\t\tresult.Summary = fmt.Sprintf(\"experiment name mismatch: %s vs %s\", a.ExperimentName, b.ExperimentName)\r\n\t\treturn result\r\n\t}\r\n\r\n\tminLen := len(a.Values)\r\n\tif len(b.Values) < minLen {\r\n\t\tminLen = len(b.Values)\r\n\t}\r\n\r\n\tif len(a.Values) != len(b.Values) {\r\n\t\tresult.Match = false\r\n"]
[315.257085, "o", "\t\tresult.Summary = fmt.Sprintf(\"value count mismatch: %d vs %d\", len(a.Values), len(b.Values))\r\n\t\treturn result\r\n\t}\r\n\r\n\tresult.TotalPairs = minLen\r\n\r\n\tswitch mode {\r\n\tcase ModeExact:\r\n\t\tresult.Match = true\r\n\t\tfor i := 0; i < minLen; i++ {\r\n\t\t\tlabel := fmt.Sprintf(\"value[%d]\", i)\r\n\t\t\tif i < len(a.Labels) {\r\n\t\t\t\tlabel = a.Labels[i]\r\n\t\t"]
[315.257161, "o", "\t}\r\n\t\t\t// Legacy: exact float equality comparison\r\n\t\t\tif a.Values[i] != b.Values[i] {\r\n\t\t\t\t"]
[315.257223, "o", "result.Match = false\r\n\t\t\t\tresult.Mismatches = append(result.Mismatches, Mismatch{\r\n\t\t\t\t\tIndex:   i,\r\n\t\t\t\t\tLabel:   label,\r\n\t\t\t\t\tValueA:  a.Values[i],\r\n\t\t\t\t\tValueB:  b.Values[i],\r\n\t\t\t\t\tAbsDiff: math.Abs(a.Values[i] - b.Values[i]),\r\n\t\t\t\t\tRelDiff: relDiff(a.Values[i], b.Values[i]),\r\n\t\t\t\t})\r\n\t\t\t} else {\r\n\t\t\t\tresult.MatchedPairs++\r\n\t\t\t}\r\n\t\t}\r\n\tcase ModeTolerance:\r\n\t\t// TODO: Implement tolerance-based comparison.\r\n\t\t// For each value pair, should check:\r\n"]
[315.257318, "o", "\t\t// 1. If both values are zero (within absolute tolerance), they match.\r\n\t\t// 2. Otherwise, check both absolute and relative tolerance:\r\n\t\t//    |a - b| <= tol.Absolute  OR  |a - b| / max(|a|, |b|) <= tol.Relative\r\n\t\t// 3. Handle NaN and Inf specially: NaN matches NaN, Inf matches Inf.\r\n\t\tresult.Match = false\r\n\t\tresult.Summary = \"tolerance comparison not yet implemented\"\r\n\t}\r\n\r\n\tif result.Summary == \"\" {\r\n\t\tif result.Match {\r\n\t\t\tresult.Summary = fmt.Sprintf(\"all %d value pairs match\", result.TotalPairs)\r\n\t\t} else {\r\n"]
[315.257432, "o", "\t\t\tresult.Summary = fmt.Sprintf(\"%d of %d value pairs mismatch\", len(result.Mismatches), result.TotalPairs)\r\n\t\t}\r\n\t}\r\n\r\n\treturn result\r\n}\r\n\r\n// FormatReport generates a human-readable comparison report.\r\nfunc FormatReport(cr *ComparisonResult) string {\r\n\tvar sb strings.Builder\r\n\tsb.WriteString(\"=== Comparison Report ===\\n\")\r\n\tsb.WriteString(fmt.Sprintf(\"Mode: %s\\n\", modeString(cr.Mode)))\r\n\tsb.WriteString(fmt.Sprintf(\"Match: %v\\n\", cr.Match))\r\n\tsb.WriteString(fmt.Sprintf(\"Total pairs: %d\\n\", cr.TotalPairs))\r\n\tsb.WriteString(fmt.Sprintf(\"Matched: %d\\n\", cr.MatchedPairs))\r\n\tsb.WriteString(fmt.Sprintf(\"Summary: %s\\n\", cr.Summary))\r\n\r\n\tif len(cr.Mismatches) > 0 {\r\n\t\tsb.WriteString(\"\\nMismatches:\\n\")\r\n\t\tfor _, m := range cr.Mismatches {\r\n\t\t\tsb.WriteString(fmt.Sprintf(\"  [%d] %s: %.15e vs %.15e (abs=%.6e, rel=%.6e)\\n\",\r\n\t\t\t\tm.Index, m.Label, m.ValueA, m.ValueB, m.AbsDiff, m.RelDiff))\r\n\t\t}\r\n\t}\r\n\r\n"]
[315.257552, "o", "\treturn sb.String()\r\n}\r\n\r\nfunc relDiff(a, b float64) float64 {\r\n\tdenom := math.Max(math.Abs(a), math.Abs(b))\r\n"]
[315.257581, "o", "\tif denom < 1e-300 {\r\n\t\treturn 0\r\n\t}\r\n\treturn math.Abs(a-b) / denom\r\n}\r\n\r\nfunc modeString(m ComparisonMode) string {\r\n\tswitch m {\r\n\tcase ModeExact:\r\n\t\treturn \"exact\"\r\n\tcase ModeTolerance:\r\n\t\treturn \"tolerance\"\r\n\tdefault:\r\n\t\treturn \"unknown\"\r\n\t}\r\n}\r\n"]
