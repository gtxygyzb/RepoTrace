[2821.813058, "o", "\u001b[?2004h> "]
[2821.813131, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[2821.813185, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
