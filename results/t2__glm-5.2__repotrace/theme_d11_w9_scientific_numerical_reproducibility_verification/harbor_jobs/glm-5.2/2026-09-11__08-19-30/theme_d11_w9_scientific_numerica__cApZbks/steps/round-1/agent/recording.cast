[282.654021, "o", "\tstore, err := storage.NewStore(outputDir)\r\n   157\t\tif err != nil {\r\n   158\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   159\t\t\tos.Exit(1)\r\n   160\t\t}\r\n   161\t\r\n   162\t\tid, err := store.Save(result)\r\n   163\t\tif err != nil {\r\n"]
[282.654079, "o", "   164\t\t\tfmt.Fprintf(os.Stderr, \"save error: %v\\n\", err)\r\n   165\t\t\tos.Exit(1)\r\n   166\t\t}\r\n   167\t\r\n   168\t\tfmt.Printf(\"Experiment: %s\\n\", experimentName)\r\n   169\t\tfmt.Printf(\"Result ID: %s\\n\", id)\r\n   170\t\tfmt.Printf(\"Values:\\n\")\r\n   171\t\tfor i, v := range result.Values {\r\n   172\t\t\tlabel := fmt.Sprintf(\"[%d]\", i)\r\n   173\t\t\tif i < len(result.Labels) {\r\n"]
