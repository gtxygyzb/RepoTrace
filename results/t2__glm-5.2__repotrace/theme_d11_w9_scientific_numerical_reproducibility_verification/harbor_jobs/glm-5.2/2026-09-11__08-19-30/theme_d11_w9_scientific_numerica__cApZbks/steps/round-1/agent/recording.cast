[2713.518208, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"runtime\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t"]
[2713.518286, "o", "\"time\"\r\n\r\n\t\"numeriforge/compare\"\r\n\t\"numeriforge/config\"\r\n\t\"numeriforge/engine\"\r\n\t\"numeriforge/storage\"\r\n)\r\n\r\nfunc usage() {\r\n\tfmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform\r\n\r\nUsage:\r\n  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]\r\n"]
[2713.518365, "o", "  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\r\n  numeriforge list [--experiment <name>] [--store-dir <dir>]\r\n  numeriforge export <result_id> --store-dir <dir> [--format json|csv]\r\n  numeriforge verify <result_id> --store-dir <dir>\r\n\r\nCommands:\r\n  run       Run an experiment and store the result\r\n"]
[2713.518435, "o", "  compare   Compare two stored results\r\n  list      List stored experiment results\r\n  export    Export a result to a different format\r\n  verify    Verify result integrity\r\n\r\nAvailable experiments:\r\n`)\r\n\tfor _, name := range engine.List() {\r\n\t\tfmt.Fprintf(os.Stderr, \"  %s\\n\", name)\r\n\t}\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tusage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\r\n\tswitch cmd {\r\n"]
[2713.518509, "o", "\tcase \"run\":\r\n\t\tcmdRun(os.Args[2:])\r\n\tcase \"compare\":\r\n\t\tcmdCompare(os.Args[2:])\r\n\tcase \"list\":\r\n"]
[2713.5191, "o", "\u001b[?2004h"]
[2713.519157, "o", "root@n30009:/app# "]
[2821.793015, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path(\"main.go\")\ns = p.read_text()\n\nif '\"math\"' not in s:\n    s = s.replace('\"fmt\"\\n\\t\"os\"', '\"fmt\"\\n\\t\"math\"\\n\\t\"os\"')\n\ns = s.replace(\n    '  numeriforge verify <result_id> --store-dir <dir>\\n\\nCommands:',\n    '  numeriforge verify <result_id> --store-dir <dir>\\n  numeriforge audit <result_id> --store-dir <dir>\\n\\nCommands:'\n)\ns = s.replace(\n    '  verify    Verify result integrity\\n',\n    '  verify    Verify result integrity\\n  audit     Audit a stored result for reproducibility\\n'\n)\n\ns = s.replace(\n    'case \"verify\":\\n\\t\\tcmdVerify(os.Args[2:])',\n    'case \"verify\":\\n\\t\\tcmdVerify(os.Args[2:])\\n\\tcase \"audit\":\\n\\t\\tcmdAudit(os.Args[2:])'\n)\n\nstart = s.index('case \"csv\":')\nend = s.index('default:', start)\nnew_csv = '''case \"csv\":\n\\tfmt.Printf(\"# id: %s\\\\n\", result.ID)\n\\tfmt.Printf(\"# experiment: %s\\\\n\", result.ExperimentName)\n\\tfmt.Printf(\"# timestamp: %s\\\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\n\\tif seed, ok := result.Metadata[\"seed\"]; ok {\n\\t\\tfmt.P"]
[2821.793313, "i", "rintf(\"# seed: %s\\\\n\", seed)\n\\t}\n\\tfmt.Println(\"label,value\")\n\\tfor i, v := range result.Values {\n\\t\\tlabel := fmt.Sprintf(\"value_%d\", i)\n\\t\\tif i < len(result.Labels) {\n\\t\\t\\tlabel = result.Labels[i]\n\\t\\t}\n\\t\\tfmt.Printf(\"%s,%.15e\\\\n\", label, v)\n\\t}\n'''\ns = s[:start] + new_csv + s[end:]\n\ncmd_audit = '''\nfunc cmdAudit(args []string) {\n\\tif len(args) < 1 {\n\\t\\tfmt.Fprintf(os.Stderr, \"usage: numeriforge audit <result_id> --store-dir <dir>\\\\n\")\n\\t\\tos.Exit(1)\n\\t}\n\n\\tid := args[0]\n\\tstoreDir := \"./results\"\n\n\\tfor i := 1; i < len(args); i++ {\n\\t\\tswitch args[i] {\n\\t\\tcase \"--store-dir\":\n\\t\\t\\ti++\n\\t\\t\\tif i >= len(args) {\n\\t\\t\\t\\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\\\n\")\n\\t\\t\\t\\tos.Exit(1)\n\\t\\t\\t}\n\\t\\t\\tstoreDir = args[i]\n\\t\\tdefault:\n\\t\\t\\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\\\n\", args[i])\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\\t}\n\n\\tstore, err := storage.NewStore(storeDir)\n\\tif err != nil {\n\\t\\tfmt.Fprintf(os.Stderr, \"storage error: %v\\\\n\", err)\n\\t\\tos.Exit(1)\n\\t}\n\n\\tstored, err := store.Load("]
