[421.303639, "o", "\t\tfmt.Println(\"No results found.\")\r\n\t\treturn\r\n\t}\r\n\r\n\tfmt.Printf(\"%-40s %-25s %s\\n\", \"ID\", \"Experiment\", \"Timestamp\")\r\n\tfmt.Println(strings.Repeat(\"-\", 80))\r\n\tfor _, entry := range entries {\r\n\t\tfmt.Printf(\"%-40s %-25s %s\\n\", entry.ID, entry.ExperimentName, entry.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n\t}\r\n}\r\n\r\n"]
[421.303698, "o", "func cmdExport(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge export <id> --store-dir <dir> [--format json|csv]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid := args[0]\r\n\tstoreDir := \"./results\"\r\n\tformat := \"json\"\r\n\r\n\tfor i := 1; i < len(args); i++ {\r\n\t"]
[421.303755, "o", "\tswitch args[i] {\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i < len(args) {\r\n\t\t\t\tstoreDir = args[i]\r\n\t\t\t}\r\n\t\tcase \"--format\":\r\n\t\t\ti++\r\n\t\t"]
[421.303813, "o", "\tif i < len(args) {\r\n\t\t\t\tformat = args[i]\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\t"]
[421.303868, "o", "os.Exit(1)\r\n\t}\r\n\r\n\tresult, err := store.Load(id)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"load error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[421.303933, "o", "\tswitch format {\r\n\tcase \"json\":\r\n\t\tdata, err := json.MarshalIndent(result, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"marshal error: %v\\n\", err)\r\n\t\t\t"]
[421.303993, "o", "os.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(string(data))\r\n\tcase \"csv\":\r\n\t\t// Header\r\n\t\tfmt.Println(\"label,value\")\r\n\t\tfor i, v := range result.Values {\r\n\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n\t\t\tif i < len(result.Labels) {\r\n\t\t\t\tlabel = result.Labels[i]\r\n\t\t\t}\r\n\t\t\tfmt.Printf(\"%s,%.15e\\n\", label, v)\r\n"]
[421.304052, "o", "\t\t}\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown format: %s\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc cmdVerify(args []string) {\r\n\t// TODO: Implement result integrity verification.\r\n\t// Should:\r\n\t// 1. Load the stored result\r\n"]
[421.304107, "o", "\t// 2. Recompute the checksum from the stored values\r\n\t// 3. Compare with the stored checksum\r\n"]
