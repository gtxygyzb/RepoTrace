[4432.17464, "o", "\t\tif err != nil {\r\n   747\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\\n\", id, err)\r\n   748\t\t}\r\n   749\t\r\n   750\t\tfn, err := engine.Get(stored.ExperimentName)\r\n   751\t\tif err != nil {\r\n   752\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n   753\t\t}\r\n   754\t\r\n   755\t\trng := engine.NewRNG(seed)\r\n   756\t"]
[4432.174709, "o", "\treexec, err := fn(stored.ExperimentName, stored.Parameters, rng)\r\n   757\t\tif err != nil {\r\n   758\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n   759\t\t}\r\n   760\t\r\n   761\t\tmaxLen := len(stored.Values)\r\n   762\t\tif len(reexec.Values) > maxLen {\r\n   763\t\t\tmaxLen = len(reexec.Values)\r\n   764\t\t}\r\n   765\t\r\n   766\t\t"]
[4432.174778, "o", "var mismatches []string\r\n   767\t\tfor i := 0; i < maxLen; i++ {\r\n   768\t\t\tstoredMissing := i >= len(stored.Values)\r\n   769\t\t\treexecMissing := i >= len(reexec.Values)\r\n   770\t\r\n   771\t\t\tvar storedVal, reexecVal string\r\n   772\t\t\tif storedMissing {\r\n   773\t\t\t\tstoredVal = \"<missing>\"\r\n   774\t\t\t} else {\r\n   775\t\t\t\tstoredVal = strconv.FormatFloat(stored.Values[i], 'g', -1, 64)\r\n   776\t\t\t}\r\n"]
[4432.174847, "o", "   777\t\t\tif reexecMissing {\r\n   778\t\t\t\treexecVal = \"<missing>\"\r\n   779\t\t\t} else {\r\n   780\t\t\t\treexecVal = strconv.FormatFloat(reexec.Values[i], 'g', -1, 64)\r\n   781\t\t\t}\r\n   782\t\r\n   783\t\t\tif storedMissing || reexecMissing || math.Float64bits(stored.Values[i]) != math.Float64bits(reexec.Values[i]) {\r\n   784\t\t\t\tmismatches = append(mismatches, fmt.Sprintf(\"  value[%d]: stored=%s, re-executed=%s\", i, storedVal, reexecVal))\r\n   785\t\t\t}\r\n   786\t\t}\r\n"]
[4432.174919, "o", "   787\t\r\n   788\t\tif len(mismatches) == 0 {\r\n   789\t\t\treturn true, fmt.Sprintf(\"AUDIT_PASS: %s\\n\", id)\r\n   790\t\t}\r\n   791\t\r\n   792\t\tvar sb strings.Builder\r\n   793\t\tsb.WriteString(fmt.Sprintf(\"AUDIT_FAIL: %s\\n\", id))\r\n   794\t\tfor _, m := range mismatches {\r\n   795\t\t\tsb.WriteString(m)\r\n   796\t\t\tsb.WriteByte('\\n')\r\n   797"]
