[4633.210335, "o", "\t}\r\n   708\t\r\n   709\t\tstore, err := storage.NewStore(storeDir)\r\n   710\t\tif err != nil {\r\n   711\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   712\t\t\tos.Exit(1)\r\n   713\t\t}\r\n   714\t\r\n   715\t\tstatus, details := auditStoredResult(store, positionals[0])\r\n   716\t\tfmt.Print(details)\r\n   717\t\tif status == auditFail {\r\n   718\t\t\tos.Exit(1)\r\n   719\t\t}\r\n   720\t}\r\n   721\t\r\n   722\tfunc cmdAuditAll(storeDir string) {\r\n   723\t\tstore, err := storage.NewStore(storeDir)\r\n   724\t\tif err != nil {\r\n   725\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   726\t\t\tos.Exit(1)\r\n   727\t\t}\r\n"]
[4633.21043, "o", "   728\t\r\n   729\t\tentries, err := store.ListResults(\"\")\r\n   730\t\tif err != nil {\r\n   731\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   732\t\t\tos.Exit(1)\r\n   733\t\t}\r\n   734\t\r\n   735\t\tpassed := 0\r\n   736\t\tfailed := 0\r\n   737\t\tskipped := 0\r\n   738\t\ttotal := len(entries)\r\n   739\t\tfor _, entry := range entries {\r\n   740\t\t\tstatus, details := auditStoredResult(store, entry.ID)\r\n   741\t\t\t"]
[4633.210527, "o", "fmt.Print(details)\r\n   742\t\t\tswitch status {\r\n   743\t\t\tcase auditPass:\r\n   744\t\t\t\tpassed++\r\n   745\t\t\tcase auditFail:\r\n   746\t\t\t\tfailed++\r\n   747\t\t\tcase auditSkip:\r\n   748\t\t\t\tskipped++\r\n   749\t\t\t}\r\n   750\t\t}\r\n   751\t\r\n   752\t\t"]
[4633.210621, "o", "fmt.Printf(\"Audit Summary: %d passed, %d failed, %d skipped out of %d total\\n\", passed, failed, skipped, total)\r\n   753\t\tif failed > 0 {\r\n   754\t\t\tos.Exit(1)\r\n   755\t\t}\r\n   756\t}\r\n   757\t\r\n   758\ttype auditStatus int\r\n   759\t\r\n   760\tconst (\r\n   761\t\tauditPass auditStatus = iota\r\n   762\t\tauditFail\r\n   763\t\tauditSkip\r\n   764\t)\r\n   765\t\r\n   766\tfunc auditStoredResult(store *storage.Store, id string) (auditStatus, string) {\r\n   767"]
[4633.210713, "o", "\t\tstored, err := store.Load(id)\r\n   768\t\tif err != nil {\r\n   769\t\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: load error: %v)\\n\", id, err)\r\n   770\t\t}\r\n   771\t\r\n   772\t\twarnEnvMismatch(stored)\r\n   773\t\r\n   774\t\tstatus, expected, computed, err := store.Verify(id)\r\n   775\t\tif err != nil {\r\n   776\t\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: integrity check error: %v)\\n\", id, err)\r\n   777\t\t}\r\n   778\t\t"]
[4633.210802, "o", "if status == storage.StatusNoChecksum {\r\n   779\t\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: integrity check failed: no checksum)\\n\", id)\r\n   780\t\t}\r\n   781\t\tif status == storage.StatusCorrupted {\r\n   782\t\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: integrity check failed: expected=%s computed=%s)\\n\", id, expected, computed)\r\n   783\t\t}\r\n   784\t\r\n   785\t\tvar seed int64\r\n   786\t\tseedStr, ok := stored.Metadata[\"seed\"]\r\n   787\t\tif !ok {\r\n   788\t\t\tif seedParam, ok := engine.GetParam(stored.Parameters, \"seed\"); ok {\r\n   789\t\t\t"]
[4633.210889, "o", "\tseed = int64(seedParam)\r\n   790\t\t\t} else {\r\n   791\t\t\t\treturn auditSkip, fmt.Sprintf(\"AUDIT_SKIP: %s (no seed)\\n\", id)\r\n   792\t\t\t}\r\n   793\t\t} else {\r\n   794\t\t\tseed, err = strconv.ParseInt(seedStr, 10, 64)\r\n   795\t\t\tif err != nil {\r\n   796\t\t\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\\n\", id, err)\r\n   797\t\t\t}\r\n   798\t\t}\r\n   799\t\r\n   800\t"]
[4633.210975, "o", "\tfn, err := engine.Get(stored.ExperimentName)\r\n   801\t\tif err != nil {\r\n   802\t\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n   803\t\t}\r\n   804\t\r\n   805\t\trng := engine.NewRNG(seed)\r\n   806\t\treexec, err := fn(stored.ExperimentName, stored.Parameters, rng)\r\n   807\t\tif err != nil {\r\n   808\t\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n   809\t\t}\r\n   810\t\r\n   811\t\tmaxLen := len(stored.Values)\r\n   812\t\tif len(reexec.Values) > maxLen {\r\n"]
