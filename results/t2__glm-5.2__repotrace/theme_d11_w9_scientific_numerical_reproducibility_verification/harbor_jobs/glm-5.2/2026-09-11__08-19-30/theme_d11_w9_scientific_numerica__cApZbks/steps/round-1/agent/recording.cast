[445.070643, "o", "\u001b[35m\u001b[Kengine/matrix.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KgenerateRandomMatrix(rows, cols int, scale float64) *Matrix {\r\n\u001b[35m\u001b[Kengine/matrix.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tm.Data[i] = (\u001b[01;31m\u001b[KGlobalRand\u001b[m\u001b[K.Float64()*2 - 1) * scale\r\n\u001b[35m\u001b[Kengine/matrix.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// TODO: Uses \u001b[01;31m\u001b[KGlobalRand\u001b[m\u001b[K - not reproducible.\r\n\u001b[35m\u001b[Kengine/matrix.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KgenerateSPDMatrix(size int, scale float64) *Matrix {\r\n\u001b[35m\u001b[Kengine/matrix.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KflattenMatrix(m *Matrix, prefix string) ([]float64, []string) {\r\n\u001b[35m\u001b[Kengine/matrix.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KmatrixLUDecompose(name string, params []Parameter) (*Result, error) {\r\n"]
