[5112.389693, "o", "\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K indexPath() string {\r\n\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K updateIndex(id, experimentName string, timestamp time.Time) error {\r\n\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store)\u001b[m\u001b[K readIndex() ([]IndexEntry, error) {\r\n"]
