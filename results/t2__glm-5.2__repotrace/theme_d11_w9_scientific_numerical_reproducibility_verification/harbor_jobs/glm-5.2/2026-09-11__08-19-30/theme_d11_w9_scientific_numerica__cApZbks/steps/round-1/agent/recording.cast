[3077.028839, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n"]
[3077.028919, "o", "     5\t\t\"fmt\"\r\n     6\t\t\"math\"\r\n     7\t\t\"os\"\r\n     8\t\t\"runtime\"\r\n     9\t\t\"strconv\"\r\n    10\t\t\"strings\"\r\n    11\t\t\"time\"\r\n    12\t\r\n    13\t\t\"numeriforge/compare\"\r\n    14\t\t\"numeriforge/config\"\r\n    15\t\t\"numeriforge/engine\"\r\n    16\t\t"]
[3077.028982, "o", "\"numeriforge/storage\"\r\n    17\t)\r\n    18\t\r\n    19\tfunc usage() {\r\n    20\t\tfmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform\r\n    21\t\r\n    22\tUsage:\r\n    23\t  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]\r\n"]
[3077.029066, "o", "    24\t  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\r\n    25\t  numeriforge list [--experiment <name>] [--store-dir <dir>]\r\n    26\t  numeriforge export <result_id> --store-dir <dir> [--format json|csv]\r\n    27\t  numeriforge verify <result_id> --store-dir <dir>\r\n    28\t  numeriforge audit <result_id> --store-dir <dir>\r\n    29\t\r\n"]
[3077.029131, "o", "    30\tCommands:\r\n    31\t  run       Run an experiment and store the result\r\n    32\t  compare   Compare two stored results\r\n    33\t  list      List stored experiment results\r\n    34\t  export    Export a result to a different format\r\n    35\t  verify    Verify result integrity\r\n    36\t  audit     Audit a stored result for reproducibility\r\n    37\t\r\n    38\tAvailable experiments:\r\n    39\t`)\r\n    40\t\tfor _, name := range engine.List() {\r\n    41\t\t\tfmt.Fprintf(os.Stderr, \"  %s\\n\", name)\r\n    42\t\t}\r\n    43"]
[3077.02919, "o", "\t}\r\n    44\t\r\n    45\tfunc main() {\r\n    46\t\tif len(os.Args) < 2 {\r\n    47\t\t\tusage()\r\n    48\t\t\tos.Exit(1)\r\n    49\t\t}\r\n    50\t\r\n    51\t"]
[3077.02925, "o", "\tcmd := os.Args[1]\r\n    52\t\r\n    53\t\tswitch cmd {\r\n    54\t\tcase \"run\":\r\n    55\t\t\tcmdRun(os.Args[2:])\r\n    56\t\tcase \"compare\":\r\n    57\t\t\tcmdCompare(os.Args[2:])\r\n    58\t\tcase \"list\":\r\n    59\t\t\tcmdList(os.Args[2:])\r\n    60\t\tcase \"export\":\r\n"]
[3077.02931, "o", "    61\t\t\tcmdExport(os.Args[2:])\r\n    62\t\tcase \"verify\":\r\n    63\t\t\tcmdVerify(os.Args[2:])\r\n    64\t\tcase \"audit\":\r\n    65\t\t\tcmdAudit(os.Args[2:])\r\n    66\t\tcase \"help\", \"--help\", \"-h\":\r\n    67\t\t\tusage()\r\n    68\t\tdefault:\r\n    69\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n    70"]
[3077.02938, "o", "\t\t\tusage()\r\n    71\t\t\tos.Exit(1)\r\n    72\t\t}\r\n    73\t}\r\n    74\t\r\n    75\t// environmentMetadata returns the environment fingerprint metadata required for\r\n"]
[3077.029437, "o", "    76\t// reproducible experiment traces.\r\n    77\tfunc environmentMetadata() map[string]string {\r\n    78\t\thostname, err := os.Hostname()\r\n    79\t\tif err != nil {\r\n    80\t\t\thostname = \"unknown\"\r\n    81\t\t}\r\n    82\t\treturn map[string]string{\r\n    83\t\t\t\"env_go_version\": runtime.Version(),\r\n    84\t\t\t\"env_os\":         runtime.GOOS,\r\n    85\t\t\t\"env_arch\":       runtime.GOARCH,\r\n    86\t\t\t\"env_hostname\":   hostname,\r\n    87\t\t}\r\n    88\t}\r\n"]
[3077.029534, "o", "    89\t\r\n    90\t// environmentFromMetadata aggregates stored environment fingerprint metadata\r\n    91\t// into an export-friendly object.\r\n    92\ttype environmentInfo struct {\r\n    93\t\tGoVersion string `json:\"go_version\"`\r\n"]
[3077.029594, "o", "    94\t\tOS        string `json:\"os\"`\r\n    95\t\tArch      string `json:\"arch\"`\r\n    96\t\tHostname  string `json:\"hostname\"`\r\n    97\t}\r\n    98\t\r\n    99\tfunc environmentFromMetadata(metadata map[string]string) environmentInfo {\r\n   100\t\treturn environmentInfo{\r\n   101\t\t\tGoVersion: metadata[\"env_go_version\"],\r\n   102\t\t\tOS:        metadata[\"env_os\"],\r\n   103\t\t\tArch:      metadata[\"env_arch\"],\r\n   104\t\t\tHostname:  metadata[\"env_hostname\"],\r\n   105\t\t}\r\n   106\t}\r\n   107\t\r\n   108\ttype exportPayload struct {\r\n"]
[3077.029652, "o", "   109\t\t*storage.StoredResult\r\n   110\t\tEnvironment environmentInfo `json:\"environment\"`\r\n   111\t}\r\n   112\t\r\n   113\tfunc cmdRun(args []string) {\r\n   114\t\tvar experimentName, outputDir, configPath string\r\n   115\t\tvar paramStrs []string\r\n   116\t\tvar seed int64\r\n   117\t\tseedProvided := false\r\n   118\t"]
[3077.02971, "o", "\r\n   119\t\tfor i := 0; i < len(args); i++ {\r\n   120\t\t\tswitch args[i] {\r\n   121\t\t\tcase \"--experiment\":\r\n   122\t\t\t\ti++\r\n   123\t\t\t\tif i >= len(args) {\r\n   124\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment requires a value\\n\")\r\n   125\t\t\t\t\tos.Exit(1)\r\n   126\t\t\t\t}\r\n"]
[3077.029767, "o", "   127\t\t\t\texperimentName = args[i]\r\n   128\t\t\tcase \"--output-dir\":\r\n   129\t\t\t\ti++\r\n   130\t\t\t\tif i >= len(args) {\r\n   131\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --output-dir requires a value\\n\")\r\n   132\t\t\t\t\tos.Exit(1)\r\n   133\t\t"]
[3077.029829, "o", "\t\t}\r\n   134\t\t\t\toutputDir = args[i]\r\n   135\t\t\tcase \"--config\":\r\n   136\t\t\t\ti++\r\n   137\t\t\t\tif i >= len(args) {\r\n   138\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --config requires a value\\n\")\r\n   139\t\t\t\t\tos.Exit(1)\r\n"]
[3077.029891, "o", "   140\t\t\t\t}\r\n   141\t\t\t\tconfigPath = args[i]\r\n   142\t\t\tcase \"--param\":\r\n   143\t\t\t\ti++\r\n   144\t\t\t\tif i >= len(args) {\r\n   145\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --param requires a value\\n\")\r\n   146\t\t\t\t\tos.Exit(1)\r\n   147\t\t\t\t}\r\n   148"]
[3077.029947, "o", "\t\t\t\tparamStrs = append(paramStrs, args[i])\r\n   149\t\t\tcase \"--seed\":\r\n   150\t\t\t\ti++\r\n   151\t\t\t\tif i >= len(args) {\r\n   152\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --seed requires a value\\n\")\r\n   153\t\t\t\t\tos.Exit(1)\r\n"]
[3077.030007, "o", "   154\t\t\t\t}\r\n   155\t\t\t\tparsed, err := strconv.ParseInt(args[i], 10, 64)\r\n   156\t\t\t\tif err != nil {\r\n   157\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid seed: %v\\n\", err)\r\n   158\t\t\t\t\tos.Exit(1)\r\n   159\t\t\t\t}\r\n   160\t\t\t\tseed = parsed\r\n"]
[3077.030068, "o", "   161\t\t\t\tseedProvided = true\r\n   162\t\t\tdefault:\r\n   163\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   164\t\t\t\tos.Exit(1)\r\n   165\t\t\t}\r\n   166\t\t}\r\n   167\t\r\n   168\t\tif configPath != \"\" {\r\n"]
[3077.030142, "o", "   169\t\t\tcfg, err := config.ParseINI(configPath)\r\n   170\t\t\tif err != nil {\r\n   171\t\t\t\tfmt.Fprintf(os.Stderr, \"config error: %v\\n\", err)\r\n   172\t\t\t\tos.Exit(1)\r\n   173\t\t\t}\r\n   174\t\t\tif experimentName == \"\" {\r\n   175\t\t\t\texperimentName = cfg.Experiment\r\n   176\t\t\t}\r\n   177\t\t\tif outputDir == \"\" {\r\n   178\t\t\t\toutputDir = cfg.OutputDir\r\n   179\t\t\t}\r\n"]
[3077.030211, "o", "   180\t\r\n   181\t\t\tcliParams, _ := config.ParseParams(paramStrs)\r\n   182\t\t\tcliParamMap := make(map[string]float64)\r\n   183\t\t\tfor _, p := range cliParams {\r\n   184\t\t\t\tcliParamMap[p.Name] = p.Value\r\n   185\t\t\t}\r\n   186\t\t\tfor _, p := range cfg.Params {\r\n   187\t\t\t\tif _, exists := cliParamMap[p.Name]; !exists {\r\n   188\t\t\t\t\tcliParams = append(cliParams, p)\r\n   189\t\t\t\t}\r\n   190\t\t\t}\r\n   191"]
[3077.030268, "o", "\t\t\tparamStrs = nil\r\n   192\t\t\tfor _, p := range cliParams {\r\n   193\t\t\t\tparamStrs = append(paramStrs, fmt.Sprintf(\"%s=%g\", p.Name, p.Value))\r\n   194\t\t\t}\r\n   195\t\t}\r\n   196\t\r\n   197\t\tif experimentName == \"\" {\r\n   198\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment is required\\n\")\r\n"]
[3077.030329, "o", "   199\t\t\tos.Exit(1)\r\n   200\t\t}\r\n   201\t\tif outputDir == \"\" {\r\n   202\t\t\toutputDir = \"./results\"\r\n   203\t\t}\r\n   204\t\r\n   205\t\tparams, err := config.ParseParams(paramStrs)\r\n   206\t\tif err != nil {\r\n   207\t\t\tfmt.Fprintf(os.Stderr, \"parameter error: %v\\n\", err)\r\n"]
[3077.030387, "o", "   208\t\t\tos.Exit(1)\r\n   209\t\t}\r\n   210\t\r\n   211\t\tfn, err := engine.Get(experimentName)\r\n   212\t\tif err != nil {\r\n   213\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   214\t\t\tos.Exit(1)\r\n   215\t\t}\r\n"]
[3077.030445, "o", "   216\t\r\n   217\t\tif !seedProvided {\r\n   218\t\t\tseed = time.Now().UnixNano()\r\n   219\t\t}\r\n   220\t\r\n   221\t\trng := engine.NewRNG(seed)\r\n   222\t\r\n   223\t\tresult, err := fn(experimentName, params, rng)\r\n   224\t\tif err != nil {\r\n   225\t\t"]
[3077.030518, "o", "\tfmt.Fprintf(os.Stderr, \"experiment error: %v\\n\", err)\r\n   226\t\t\tos.Exit(1)\r\n   227\t\t}\r\n   228\t\r\n   229\t\tif result.Metadata == nil {\r\n   230\t\t\tresult.Metadata = map[string]string{}\r\n   231\t\t}\r\n   232\t\tif _, ok := result.Metadata[\"seed\"]; !ok {\r\n   233\t\t\tresult.Metadata[\"seed\"] = strconv.FormatInt(seed, 10)\r\n"]
[3077.03058, "o", "   234\t\t}\r\n   235\t\tif seedProvided {\r\n   236\t\t\tresult.Metadata[\"seed_source\"] = \"provided\"\r\n   237\t\t} else {\r\n   238\t\t\tresult.Metadata[\"seed_source\"] = \"auto-generated\"\r\n   239\t\t}\r\n   240\t\r\n   241\t\tfor k, v := range environmentMetadata() {\r\n   242\t\t\tresult.Metadata[k] = v\r\n   243\t\t}\r\n   244\t\r\n"]
[3077.030638, "o", "   245\t\tstore, err := storage.NewStore(outputDir)\r\n   246\t\tif err != nil {\r\n   247\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   248\t\t\tos.Exit(1)\r\n   249\t\t}\r\n   250\t\r\n   251\t\tid, err := store.Save(result)\r\n   252\t\tif err != nil {\r\n"]
[3077.030707, "o", "   253\t\t\tfmt.Fprintf(os.Stderr, \"save error: %v\\n\", err)\r\n   254\t\t\tos.Exit(1)\r\n   255\t\t}\r\n   256\t\r\n   257\t\tfmt.Printf(\"Experiment: %s\\n\", experimentName)\r\n   258\t\tfmt.Printf(\"Result ID: %s\\n\", id)\r\n   259\t\tfmt.Printf(\"Values:\\n\")\r\n   260\t\tfor i, v := range result.Values {\r\n   261\t\t\tlabel := fmt.Sprintf(\"[%d]\", i)\r\n"]
[3077.030764, "o", "   262\t\t\tif i < len(result.Labels) {\r\n   263\t\t\t\tlabel = result.Labels[i]\r\n   264\t\t\t}\r\n   265\t\t\tfmt.Printf(\"  %s = %.15e\\n\", label, v)\r\n   266\t\t}\r\n   267\t}\r\n   268\t\r\n   269\tfunc cmdCompare(args []string) {\r\n   270\t\tif len(args) < 2 {\r\n"]
[3077.03083, "o", "   271\t\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\\n\")\r\n   272\t\t\tos.Exit(1)\r\n   273\t\t}\r\n   274\t\r\n   275\t\tid1 := args[0]\r\n"]
[3077.030886, "o", "   276\t\tid2 := args[1]\r\n   277\t\tstoreDir := \"./results\"\r\n   278\t\tmode := \"exact\"\r\n   279\t\ttol := compare.DefaultTolerance()\r\n   280\t\r\n   281\t\tfor i := 2; i < len(args); i++ {\r\n   282\t\t\tswitch args[i] {\r\n   283\t\t\tcase \"--store-dir\":\r\n   284\t\t\t\ti++\r\n   285\t\t\t\tif i >= len(args) {\r\n   286\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n   287\t\t\t\t\tos.Exit(1)\r\n"]
[3077.030942, "o", "   288\t\t\t\t}\r\n   289\t\t\t\tstoreDir = args[i]\r\n   290\t\t\tcase \"--mode\":\r\n   291\t\t\t\ti++\r\n   292\t\t\t\tif i >= len(args) {\r\n   293\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --mode requires a value\\n\")\r\n   294\t\t\t\t\tos.Exit(1)\r\n"]
[3077.031003, "o", "   295\t\t\t\t}\r\n   296\t\t\t\tmode = args[i]\r\n   297\t\t\tcase \"--abs-tol\":\r\n   298\t\t\t\ti++\r\n   299\t\t\t\tif i >= len(args) {\r\n   300\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --abs-tol requires a value\\n\")\r\n   301\t\t\t\t\tos.Exit(1)\r\n   302\t\t\t\t}\r\n"]
[3077.031058, "o", "   303\t\t\t\tv, err := strconv.ParseFloat(args[i], 64)\r\n   304\t\t\t\tif err != nil {\r\n   305\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid absolute tolerance: %v\\n\", err)\r\n   306\t\t\t\t\tos.Exit(1)\r\n   307\t\t\t\t}\r\n   308\t\t\t\ttol.Absolute = v\r\n   309\t\t\tcase \"--rel-tol\":\r\n   310\t\t\t\ti++\r\n   311\t\t\t\tif i >= len(args) {\r\n"]
[3077.031115, "o", "   312\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --rel-tol requires a value\\n\")\r\n   313\t\t\t\t\tos.Exit(1)\r\n   314\t\t\t\t}\r\n   315\t\t\t\tv, err := strconv.ParseFloat(args[i], 64)\r\n   316\t\t\t\tif err != nil {\r\n   317\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid relative tolerance: %v\\n\", err)\r\n   318\t\t\t\t\tos.Exit(1)\r\n"]
[3077.031174, "o", "   319\t\t\t\t}\r\n   320\t\t\t\ttol.Relative = v\r\n"]
