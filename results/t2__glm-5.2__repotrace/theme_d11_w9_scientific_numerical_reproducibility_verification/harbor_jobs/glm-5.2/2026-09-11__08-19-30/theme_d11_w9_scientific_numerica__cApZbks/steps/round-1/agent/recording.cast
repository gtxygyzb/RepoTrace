[282.654322, "o", "   201\t\t\t\t\tswitch args[i] {\r\n   202\t\t\t\t\tcase \"exact\":\r\n   203\t\t\t\t\t\tmode = compare.ModeExact\r\n   204\t\t\t\t\tcase \"tolerance\":\r\n   205\t\t\t\t\t\tmode = compare.ModeTolerance\r\n   206\t\t\t\t\tdefault:\r\n   207\t\t\t\t\t\tfmt.Fprintf(os.Stderr, \"unknown comparison mode: %s\\n\", args[i])\r\n   208\t\t\t\t\t\tos.Exit(1)\r\n   209\t\t\t\t\t}\r\n   210\t\t"]
