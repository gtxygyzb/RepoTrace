[3109.543446, "o", "   550\t\tid := args[0]\r\n   551\t\tstoreDir := \"./results\"\r\n   552\t\r\n   553\t\tfor i := 1; i < len(args); i++ {\r\n   554\t\t\tswitch args[i] {\r\n   555\t\t\tcase \"--store-dir\":\r\n   556\t\t\t\ti++\r\n   557\t\t\t\tif i >= len(args) {\r\n   558\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n   559\t\t\t\t\tos.Exit(1)\r\n   560\t\t\t\t}\r\n   561\t\t\t\tstoreDir = args[i]\r\n   562\t\t\tdefault:\r\n   563\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   564\t\t\t\tos.Exit(1)\r\n   565\t\t\t}\r\n   566"]
