[3816.465522, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K538\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Printf(\"\u001b[01;31m\u001b[KComputed checksum\u001b[m\u001b[K: %s\\n\", computed)\r\n"]
