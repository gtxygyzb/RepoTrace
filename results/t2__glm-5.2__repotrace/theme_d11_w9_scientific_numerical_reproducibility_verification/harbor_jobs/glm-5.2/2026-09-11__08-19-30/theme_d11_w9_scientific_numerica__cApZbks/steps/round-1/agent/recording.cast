[5129.727776, "o", "\r\n// environmentFromMetadata aggregates stored environment fingerprint metadata\r\n// into an export-friendly object.\r\ntype environmentInfo struct {\r\n\tGoVersion string `json:\"go_version\"`\r\n\tOS        string `json:\"os\"`\r\n"]
[5129.72788, "o", "\tArch      string `json:\"arch\"`\r\n\tHostname  string `json:\"hostname\"`\r\n}\r\n\r\nfunc environmentFromMetadata(metadata map[string]string) environmentInfo {\r\n\treturn environmentInfo{\r\n\t\tGoVersion: metadata[\"env_go_version\"],\r\n\t\t"]
[5129.727953, "o", "OS:        metadata[\"env_os\"],\r\n\t\tArch:      metadata[\"env_arch\"],\r\n\t\tHostname:  metadata[\"env_hostname\"],\r\n\t}\r\n}\r\n\r\ntype exportPayload struct {\r\n\t*storage.StoredResult\r\n\tEnvironment environmentInfo   `json:\"environment\"`\r\n\tTags        map[string]string `json:\"tags,omitempty\"`\r\n}\r\n\r\n// tagsFromMetadata collects tag_<key> metadata entries into an export-friendly\r\n// map without the tag_ prefix. It returns nil when no tags are present.\r\nfunc tagsFromMetadata(metadata map[string]string) map[string]string {\r\n\tif metadata == nil {\r\n\t\treturn nil\r\n\t}\r\n\ttags := map[string]string{}\r\n\tfor k, v := range metadata {\r\n\t\tif strings.HasPrefix(k, \"tag_\") {\r\n\t\t\ttags[k[len(\"tag_\"):]] = v\r\n\t\t}\r\n\t}\r\n\tif len(tags) == 0 {\r\n"]
[5129.728032, "o", "\t\treturn nil\r\n\t}\r\n\treturn tags\r\n}\r\n\r\n// parseTagFlag parses a --tag key=value argument and returns the metadata key\r\n// and value. It prints an error and exits when the argument is malformed.\r\nfunc parseTagFlag(arg string) (string, string) {\r\n\tparts := strings.SplitN(arg, \"=\", 2)\r\n\tif len(parts) != 2 || parts[0] == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid tag, expected key=value: %s\\n\", arg)\r\n\t\tos.Exit(1)\r\n\t}\r\n\treturn \"tag_\" + parts[0], parts[1]\r\n}\r\n\r\n"]
[5129.728096, "o", "// hasMatchingTags reports whether metadata contains all requested tag filters.\r\nfunc hasMatchingTags(metadata map[string]string, tags map[string]string) bool {\r\n\tfor k, v := range tags {\r\n\t\tif metadata[\"tag_\"+k] != v {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\n"]
[5129.728155, "o", "func cmdRun(args []string) {\r\n\tvar experimentName, outputDir, configPath string\r\n\tvar paramStrs []string\r\n\tvar tagStrs []string\r\n\tvar seed int64\r\n\tseedProvided := false\r\n\r\n"]
