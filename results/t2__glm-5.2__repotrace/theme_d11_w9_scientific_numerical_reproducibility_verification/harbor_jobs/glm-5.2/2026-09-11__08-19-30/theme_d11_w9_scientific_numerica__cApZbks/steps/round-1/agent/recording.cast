[2821.811705, "o", "\u001b[?2004h> "]
[2821.812146, "o", "\\t\\tfmt.Printf(\"AUDIT_FAIL: %s (reason: checksum verification error: %v)\\\\n\", id, err)\r\n\u001b[?2004l\r"]
[2821.812201, "o", "\u001b[?2004h> "]
