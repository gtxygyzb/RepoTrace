[4450.575884, "o", "if len(positionals) < 1 {\r\n   668\t\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge audit <result_id> --store-dir <dir>\\n\")\r\n   669\t\t\tfmt.Fprintf(os.Stderr, \"       numeriforge audit --all --store-dir <dir>\\n\")\r\n   670\t\t\tos.Exit(1)\r\n   671\t\t}\r\n   672"]
