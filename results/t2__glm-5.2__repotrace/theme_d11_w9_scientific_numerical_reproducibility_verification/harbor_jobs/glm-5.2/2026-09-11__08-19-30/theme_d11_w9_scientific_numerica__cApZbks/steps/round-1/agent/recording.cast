[3955.243071, "o", "\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge \u001b[01;31m\u001b[Kexport\u001b[m\u001b[K <id> --store-dir <dir> [--format \u001b[01;31m\u001b[Kjson\u001b[m\u001b[K|csv]\\n\")\r\n\u001b[32m\u001b[K425\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tformat := \"\u001b[01;31m\u001b[Kjson\u001b[m\u001b[K\"\r\n\u001b[32m\u001b[K429\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n\u001b[32m\u001b[K436\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--format\":\r\n\u001b[32m\u001b[K462\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"\u001b[01;31m\u001b[Kjson\u001b[m\u001b[K\":\r\n\u001b[32m\u001b[K463\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tpayload := \u001b[01;31m\u001b[Kexport\u001b[m\u001b[KPayload{\r\n"]
[3955.243135, "o", "\u001b[32m\u001b[K465\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tEnvironment:  environmentFrom\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K(result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K),\r\n\u001b[32m\u001b[K467\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tdata, err := \u001b[01;31m\u001b[Kjson\u001b[m\u001b[K.MarshalIndent(payload, \"\", \"  \")\r\n\u001b[32m\u001b[K473\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"csv\":\r\n"]
[3955.243254, "o", "\u001b[32m\u001b[K477\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif seed, ok := result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed\"]; ok {\r\n\u001b[32m\u001b[K494\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KcmdVerify(args []string) {\r\n\u001b[32m\u001b[K506\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--verbose\":\r\n\u001b[32m\u001b[K508\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n\u001b[32m\u001b[K534\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Kstorage.StatusVerified:\r\n\u001b[32m\u001b[K541\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Kstorage.StatusCorrupted:\r\n\u001b[32m\u001b[K548\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Kstorage.StatusNoChecksum:\r\n\u001b[32m\u001b[K556\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KcmdAudit(args []string) {\r\n\u001b[32m\u001b[K563\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--all\":\r\n\u001b[32m\u001b[K565\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n\u001b[32m\u001b[K613\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KcmdAuditAll(storeDir string) {\r\n"]
[3955.24332, "o", "\u001b[32m\u001b[K645\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KauditStoredResult(store *storage.Store, id string) (bool, string) {\r\n\u001b[32m\u001b[K664\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tseedStr, ok := stored.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed\"]\r\n\u001b[32m\u001b[K666\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: missing seed in \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K)\\n\", id)\r\n"]
[3955.243375, "o", "\u001b[32m\u001b[K670\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: invalid seed in \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K: %v)\\n\", id, err)\r\n\u001b[32m\u001b[K724\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KwarnEnvMismatch(stored *storage.StoredResult) {\r\n"]
[3955.243432, "o", "\u001b[32m\u001b[K725\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmsg, ok := envMismatchWarning(stored.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K731\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KenvMismatchWarning(\u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K map[string]string) (string, bool) {\r\n\u001b[32m\u001b[K732\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcurrent := environment\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K()\r\n\u001b[32m\u001b[K737\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K[field] != current[field] {\r\n\u001b[32m\u001b[K738\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tdiffs = append(diffs, fmt.Sprintf(\"%s stored=%q current=%q\", field, \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K[field], current[field]))\r\n"]
