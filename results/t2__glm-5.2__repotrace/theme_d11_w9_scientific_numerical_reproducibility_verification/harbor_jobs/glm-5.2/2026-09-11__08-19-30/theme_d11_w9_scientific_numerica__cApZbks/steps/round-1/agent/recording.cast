[2266.859847, "o", "\tcr := compare.Compare(a, b, comparisonMode, tol)\r\n\tfmt.Print(compare.FormatReport(cr))\r\n\r\n\tif cr.Match {\r\n\t\tos.Exit(0)\r\n\t} else {\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc cmdList(args []string) {\r\n\tstoreDir := \"./results\"\r\n\texperimentFilter := \"\"\r\n"]
