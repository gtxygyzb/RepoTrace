[2611.146382, "o", "package compare\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"strings\"\r\n\r\n\t\"numeriforge/storage\"\r\n)\r\n\r\n// ComparisonMode determines how results are compared.\r\ntype ComparisonMode int\r\n"]
[2611.146545, "o", "\r\nconst (\r\n\t// ModeExact uses exact float equality (legacy behavior).\r\n\tModeExact ComparisonMode = iota\r\n\t// ModeTolerance uses configurable absolute and relative tolerance.\r\n\tModeTolerance\r\n)\r\n\r\n// Tolerance defines comparison thresholds.\r\ntype Tolerance struct {\r\n\tAbsolute float64\r\n\tRelative float64\r\n}\r\n\r\n"]
[2611.14662, "o", "// DefaultTolerance returns the spec defaults for scientific comparisons.\r\nfunc DefaultTolerance() Tolerance {\r\n\treturn Tolerance{\r\n\t\tAbsolute: 1e-10,\r\n\t\tRelative: 1e-8,\r\n\t}\r\n}\r\n\r\n// ComparisonResult holds the outcome of comparing two experiment results.\r\ntype ComparisonResult struct {\r\n\tMatch        bool\r\n\tTotalPairs   int\r\n\tMatchedPairs int\r\n\tMismatches   []Mismatch\r\n\tMode         ComparisonMode\r\n\tTolerance    Tolerance\r\n\tSummary      string\r\n}\r\n\r\n// Mismatch records a single value pair that didn't match.\r\ntype Mismatch struct {\r\n\tIndex   int\r\n\tLabel   string\r\n\tValueA  float64\r\n\tValueB  float64\r\n\tAbsDiff float64\r\n\tRelDiff float64\r\n}\r\n"]
[2611.146688, "o", "\r\n// Compare compares two stored results.\r\nfunc Compare(a, b *storage.StoredResult, mode ComparisonMode, tol Tolerance) *ComparisonResult {\r\n\tresult := &ComparisonResult{\r\n\t\tMode:      mode,\r\n\t\tTolerance: tol,"]
[2611.146754, "o", "\r\n\t}\r\n\r\n\tif a.ExperimentName != b.ExperimentName {\r\n\t\tresult.Match = false\r\n\t\tresult.Summary = fmt.Sprintf(\"experiment name mismatch: %s vs %s\", a.ExperimentName, b.ExperimentName)\r\n\t\treturn result\r\n\t}\r\n\r\n\tminLen := len(a.Values)\r\n\tif len(b.Values) < minLen {\r\n\t\tminLen = len(b.Values)\r\n"]
[2611.146818, "o", "\t}\r\n\r\n\tif len(a.Values) != len(b.Values) {\r\n\t\tresult.Match = false\r\n\t\tresult.Summary = fmt.Sprintf(\"value count mismatch: %d vs %d\", len(a.Values), len(b.Values))\r\n\t\treturn result\r\n\t}\r\n\r\n\tresult.TotalPairs = minLen\r\n\r\n\tswitch mode {\r\n\tcase ModeExact:\r\n\t\tresult.Match = true\r\n"]
[2611.146883, "o", "\t\tfor i := 0; i < minLen; i++ {\r\n\t\t\tlabel := fmt.Sprintf(\"value[%d]\", i)\r\n\t\t\tif i < len(a.Labels) {\r\n\t\t\t\tlabel = a.Labels[i]\r\n\t\t\t}\r\n"]
[2611.146938, "o", "\t\t\tif a.Values[i] != b.Values[i] {\r\n\t\t\t\tresult.Match = false\r\n\t\t\t\tresult.Mismatches = append(result.Mismatches, Mismatch{\r\n\t\t\t\t\tIndex:   i,\r\n\t\t\t\t\tLabel:   label,\r\n\t\t\t\t\tValueA:  a.Values[i],\r\n\t\t\t\t\tValueB:  b.Values[i],\r\n\t\t\t\t\tAbsDiff: math.Abs(a.Values[i] - b.Values[i]),\r\n\t\t\t\t\tRelDiff: relDiff(a.Values[i], b.Values[i]),\r\n"]
[2611.147, "o", "\t\t\t\t})\r\n\t\t\t} else {\r\n\t\t\t\tresult.MatchedPairs++\r\n\t\t\t}\r\n\t\t}\r\n\tcase ModeTolerance:\r\n\t\tresult.Match = true\r\n\t"]
[2611.147067, "o", "\tfor i := 0; i < minLen; i++ {\r\n\t\t\tlabel := fmt.Sprintf(\"value[%d]\", i)\r\n\t\t\tif i < len(a.Labels) {\r\n\t\t\t\tlabel = a.Labels[i]\r\n\t\t\t}\r\n"]
[2611.14713, "o", "\t\t\tif !valuesMatch(a.Values[i], b.Values[i], tol) {\r\n\t\t\t\tresult.Match = false\r\n\t\t\t\tresult.Mismatches = append(result.Mismatches, Mismatch{\r\n\t\t\t\t\tIndex:   i,\r\n\t\t\t\t\tLabel:   label,\r\n\t\t\t\t\tValueA:  a.Values[i],\r\n\t\t\t\t\t"]
[2611.147193, "o", "ValueB:  b.Values[i],\r\n\t\t\t\t\tAbsDiff: math.Abs(a.Values[i] - b.Values[i]),\r\n\t\t\t\t\tRelDiff: relDiff(a.Values[i], b.Values[i]),\r\n\t\t\t\t})\r\n"]
