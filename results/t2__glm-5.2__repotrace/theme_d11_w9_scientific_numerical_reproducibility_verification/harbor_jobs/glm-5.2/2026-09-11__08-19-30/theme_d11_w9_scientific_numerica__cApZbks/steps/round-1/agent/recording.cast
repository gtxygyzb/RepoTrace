[4467.769023, "o", "   588\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n   589\t\t\t\t\tos.Exit(1)\r\n   590\t\t\t\t}\r\n   591\t\t\t\tstoreDir = args[i]\r\n   592\t\t\tdefault:\r\n   593\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   594\t\t\t\tos.Exit(1)\r\n   595\t\t\t}\r\n   596\t\t}\r\n   597\t\r\n   598\t\tstore, err := storage.NewStore(storeDir)\r\n   599\t\tif err != nil {\r\n   600\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   601\t\t\tos.Exit(1)\r\n   602\t\t}\r\n   603\t\r\n   604\t\tstatus, expected, computed, err := store.Verify(id)\r\n   605\t\tif err != nil {\r\n   606\t\t\tfmt.Fprintf(os.Stderr, \"verify error: %v\\n\", err)\r\n   607\t\t\tos.Exit(1)\r\n   608\t\t}\r\n   609\t\r\n   610\t"]
