[3409.65804, "o", "   572\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --all does not accept result IDs\\n\")\r\n   573\t\t\t\tos.Exit(1)\r\n   574\t\t\t}\r\n   575\t\t\tcmdAuditAll(storeDir)\r\n   576\t\t\treturn\r\n   577\t\t}\r\n   578\t\r\n   579\t\tif len(positionals) < 1 {\r\n   580\t\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge audit <result_id> --store-dir <dir>\\n\")\r\n   581\t"]
[3409.658105, "o", "\t\tfmt.Fprintf(os.Stderr, \"       numeriforge audit --all --store-dir <dir>\\n\")\r\n   582\t\t\tos.Exit(1)\r\n   583\t\t}\r\n   584\t\tif len(positionals) > 1 {\r\n   585\t\t\t"]
[3409.658164, "o", "fmt.Fprintf(os.Stderr, \"error: too many arguments\\n\")\r\n   586\t\t\tos.Exit(1)\r\n   587\t\t}\r\n   588\t\r\n   589\t\tstore, err := storage.NewStore(storeDir)\r\n   590\t\tif err != nil {\r\n   591\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   592\t\t\tos.Exit(1)\r\n   593\t\t}\r\n   594\t\r\n   595\t\tpassed, details := auditStoredResult(store, positionals[0])\r\n   596\t\tfmt.Print(details)\r\n   597\t\tif !passed {\r\n   598\t\t\tos.Exit(1)\r\n"]
