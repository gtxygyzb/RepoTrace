[378.004709, "o", "package compare\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"strings\"\r\n\r\n"]
[378.00476, "o", "\t\"numeriforge/storage\"\r\n)\r\n\r\n"]
[378.004813, "o", "// ComparisonMode determines how results are compared.\r\ntype ComparisonMode int\r\n\r\nconst (\r\n\t// ModeExact uses exact float equality (legacy, broken for scientific use).\r\n\tModeExact ComparisonMode = iota\r\n\t// ModeTolerance uses configurable absolute and relative tolerance.\r\n\t// TODO: Implement tolerance-based comparison.\r\n"]
[378.004827, "o", "\tModeTolerance\r\n)\r\n\r\n// Tolerance defines comparison thresholds.\r\ntype Tolerance struct {\r\n\tAbsolute float64\r\n\tRelative float64\r\n}\r\n\r\n"]
[378.004898, "o", "// DefaultTolerance returns a reasonable default for scientific comparisons.\r\nfunc DefaultTolerance() Tolerance {\r\n\treturn Tolerance{\r\n\t\tAbsolute: 1e-10,\r\n\t\tRelative: 1e-8,\r\n\t}\r\n}\r\n\r\n// ComparisonResult holds the outcome of comparing two experiment results.\r\ntype ComparisonResult struct {\r\n\tMatch       bool\r\n\tTotalPairs  int\r\n"]
[378.004908, "o", "\tMatchedPairs int\r\n"]
[378.005424, "o", "\u001b[?2004h"]
