[402.428063, "i", "sed -n '1,220p' engine/montecarlo.go\n"]
[402.428395, "o", "sed -n '1,220p' engine/montecarlo.go\r\n\u001b[?2004l\r"]
[402.431226, "o", "package engine\r\n\r\nimport (\r\n\t\"math\"\r\n\t\"time\"\r\n)\r\n\r\nfunc registerMonteCarloExperiments() {\r\n\tRegister(\"mc-estimate-pi\", mcEstimatePi)\r\n\tRegister(\"mc-integral\", mcIntegral)\r\n"]
[402.43139, "o", "\tRegister(\"mc-importance-sampling\", mcImportanceSampling)\r\n}\r\n\r\n// mcEstimatePi estimates pi using the classic circle/square Monte Carlo method.\r\n// Parameters: samples (int)\r\n// TODO: This uses GlobalRand which makes results non-reproducible.\r\n//       Need to accept a seed parameter and create a local random source.\r\nfunc mcEstimatePi(name string, params []Parameter) (*Result, error) {\r\n\tsamplesF, err := RequireParam(params, \"samples\")\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tsamples := int(samplesF)\r\n\tif samples <= 0 {\r\n\t\tsamples = 100000\r\n\t}\r\n\r\n\tinside := 0\r\n\tfor i := 0; i < samples; i++ {\r\n\t\tx := GlobalRand.Float64()\r\n\t\ty := GlobalRand.Float64()\r\n\t\tif x*x+y*y <= 1.0 {\r\n\t\t\tinside++\r\n\t\t}\r\n\t}\r\n\r\n\tpiEstimate := 4.0 * float64(inside) / float64(samples)\r\n\terrorMargin := math.Abs(piEstimate - math.Pi)\r\n\r\n\treturn &Result{\r\n\t\tExperimentName: name,"]
[402.43152, "o", "\r\n\t\tTimestamp:      time.Now(),\r\n\t\tParameters:     params,\r\n\t\tValues:         []float64{piEstimate, errorMargin, float64(inside), float64(samples)},\r\n\t\tLabels:         []string{\"pi_estimate\", \"error_margin\", \"inside_count\", \"total_samples\"},\r\n\t\tMetadata:       map[string]string{\"method\": \"circle_square\"},\r\n\t}, nil\r\n}\r\n\r\n// mcIntegral performs numerical integration of f(x) = sin(x)*exp(-x^2/2) over [a,b]\r\n// using simple Monte Carlo sampling.\r\n// Parameters: samples (int), lower_bound (float), upper_bound (float)\r\n// TODO: Uses GlobalRand - not reproducible.\r\nfunc mcIntegral(name string, params []Parameter) (*Result, error) {\r\n\tsamplesF, err := RequireParam(params, \"samples\")\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tlower, err := RequireParam(params, \"lower_bound\")\r\n\tif err != nil {\r\n\t\t"]
[402.431622, "o", "return nil, err\r\n\t}\r\n\tupper, err := RequireParam(params, \"upper_bound\")\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tsamples := int(samplesF)\r\n\tif samples <= 0 {\r\n\t\tsamples = 100000\r\n\t}\r\n\r\n\twidth := upper - lower\r\n\tsum := 0.0\r\n\tsumSq := 0.0\r\n\tfor i := 0; i < samples; i++ {\r\n\t\tx := lower + GlobalRand.Float64()*width\r\n\t\tfx := math.Sin(x) * math.Exp(-x*x/2.0)\r\n"]
[402.431718, "o", "\t\tsum += fx\r\n\t\tsumSq += fx * fx\r\n\t}\r\n\r\n\tmean := sum / float64(samples)\r\n\tintegral := width * mean\r\n\tvariance := (sumSq/float64(samples) - mean*mean) / float64(samples)\r\n\tstdErr := math.Sqrt(math.Abs(variance)) * width\r\n\r\n\treturn &Result{\r\n\t\tExperimentName: name,\r\n\t\tTimestamp:      time.Now(),\r\n\t\tParameters:     params,\r\n\t\tValues:         []float64{integral, stdErr, mean, variance},\r\n\t\tLabels:         []string{\"integral\", \"std_error\", \"mean_value\", \"variance\"},\r\n\t\tMetadata:       map[string]string{\"method\": \"simple_mc\", \"integrand\": \"sin(x)*exp(-x^2/2)\"},\r\n\t}, nil\r\n"]
[402.431815, "o", "}\r\n\r\n// mcImportanceSampling performs Monte Carlo integration using importance sampling\r\n// with a Gaussian proposal distribution.\r\n// Parameters: samples (int), lower_bound (float), upper_bound (float), proposal_mean (float), proposal_std (float)\r\n"]
[402.431896, "o", "// TODO: Uses GlobalRand - not reproducible.\r\nfunc mcImportanceSampling(name string, params []Parameter) (*Result, error) {\r\n\tsamplesF, err := RequireParam(params, \"samples\")\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tlower, err := RequireParam(params, \"lower_bound\")\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tupper, err := RequireParam(params, \"upper_bound\")\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tpMean, err := RequireParam(params, \"proposal_mean\")\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t"]
[402.431972, "o", "}\r\n\tpStd, err := RequireParam(params, \"proposal_std\")\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tsamples := int(samplesF)\r\n\tif samples <= 0 {\r\n\t\tsamples = 100000\r\n\t}\r\n\r\n\t// Target: f(x) = sin(x)*exp(-x^2/2) on [lower, upper]\r\n\t// Proposal: truncated Gaussian N(pMean, pStd^2) on [lower, upper]\r\n\tsum := 0.0\r\n\tsumSq := 0.0\r\n\taccepted := 0\r\n\r\n\tfor i := 0; i < samples; i++ {\r\n\t\t// Generate from truncated Gaussian via rejection\r\n\t\tvar x float64\r\n\t\tfor {\r\n\t\t\tx = GlobalRand.NormFloat64()*pStd + pMean\r\n"]
[402.432096, "o", "\t\t\tif x >= lower && x <= upper {\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t// Target function\r\n\t\tfx := math.Sin(x) * math.Exp(-x*x/2.0)\r\n\r\n\t\t// Proposal density (unnormalized Gaussian)\r\n\t\tqx := math.Exp(-(x-pMean)*(x-pMean) / (2.0 * pStd * pStd))\r\n\r\n\t\tif qx > 1e-300 {\r\n\t\t\tw := fx / qx\r\n\t\t\tsum += w\r\n\t\t\tsumSq += w * w\r\n\t\t\taccepted++\r\n\t\t}\r\n\t}\r\n"]
[402.43216, "o", "\r\n\tif accepted == 0 {\r\n\t\treturn &Result{\r\n\t\t\tExperimentName: name,\r\n\t\t\tTimestamp:      time.Now(),\r\n\t\t\tParameters:     params,\r\n\t\t\tValues:         []float64{0, 0, 0, 0},\r\n\t\t\tLabels:         []string{\"integral\", \"std_error\", \"effective_samples\", \"acceptance_rate\"},\r\n\t\t\tMetadata:       map[string]string{\"method\": \"importance_sampling\", \"status\": \"no_accepted_samples\"},\r\n\t\t}, nil\r\n"]
[402.432261, "o", "\t}\r\n\r\n\tmean := sum / float64(accepted)\r\n\tvariance := (sumSq/float64(accepted) - mean*mean) / float64(accepted)\r\n\tstdErr := math.Sqrt(math.Abs(variance))\r\n"]
[402.43233, "o", "\t// Normalize: the integral estimate needs scaling by the proposal normalization constant\r\n\t// For simplicity, we report the weighted mean as the integral estimate\r\n\tintegral := mean * pStd * math.Sqrt(2.0*math.Pi)\r\n\taccRate := float64(accepted) / float64(samples)\r\n\r\n\treturn &Result{\r\n\t\tExperimentName: name,\r\n\t\tTimestamp:      time.Now(),\r\n\t\tParameters:     params,\r\n\t\tValues:         []float64{integral, stdErr, float64(accepted), accRate},\r\n\t\tLabels:         []string{\"integral\", \"std_error\", \"effective_samples\", \"acceptance_rate\"},\r\n\t\tMetadata:       map[string]string{\"method\": \"importance_sampling\", \"integrand\": \"sin(x)*exp(-x^2/2)\"},\r\n\t}, nil\r\n}\r\n"]
[402.43277, "o", "\u001b[?2004h"]
[402.432831, "o", "root@n30009:/app# "]
[402.678547, "i", "sed -n '1,120p' engine/matrix.go\n"]
[402.678854, "o", "sed -n '1,120p' engine/matrix.go\r\n\u001b[?2004l\r"]
[402.681638, "o", "package engine\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"time\"\r\n)\r\n\r\nfunc registerMatrixExperiments() {\r\n"]
[402.681741, "o", "\tRegister(\"matrix-lu-decompose\", matrixLUDecompose)\r\n\tRegister(\"matrix-qr-decompose\", matrixQRDecompose)\r\n\tRegister(\"matrix-eigenvalue\", matrixEigenvalue)\r\n}\r\n\r\n// Matrix is a simple dense matrix representation.\r\ntype Matrix struct {\r\n\tRows, Cols int\r\n\tData       []float64\r\n}\r\n\r\n// NewMatrix creates a zero matrix.\r\nfunc NewMatrix(rows, cols int) *Matrix {\r\n\treturn &Matrix{Rows: rows, Cols: cols, Data: make([]float64, rows*cols)}\r\n}\r\n\r\n// At returns the element at (i, j).\r\nfunc (m *Matrix) At(i, j int) float64 {\r\n\treturn m.Data[i*m.Cols+j]\r\n}\r\n\r\n// Set sets the element at (i, j).\r\n"]
[402.681813, "o", "func (m *Matrix) Set(i, j int, v float64) {\r\n\tm.Data[i*m.Cols+j] = v\r\n}\r\n\r\n// generateRandomMatrix creates a matrix with random entries.\r\n// TODO: Uses GlobalRand - not reproducible. Need seed parameter.\r\nfunc generateRandomMatrix(rows, cols int, scale float64) *Matrix {\r\n\tm := NewMatrix(rows, cols)\r\n\tfor i := 0; i < rows*cols; i++ {\r\n\t\tm.Data[i] = (GlobalRand.Float64()*2 - 1) * scale\r\n\t}\r\n\treturn m\r\n}\r\n"]
[402.68188, "o", "\r\n// generateSPDMatrix creates a symmetric positive-definite matrix.\r\n// TODO: Uses GlobalRand - not reproducible.\r\nfunc generateSPDMatrix(size int, scale float64) *Matrix {\r\n\ta := generateRandomMatrix(size, size, scale)\r\n\tresult := NewMatrix(size, size)\r\n\t// A^T * A + diagonal dominance\r\n\tfor i := 0; i < size; i++ {\r\n\t\tfor j := 0; j < size; j++ {\r\n\t\t\tsum := 0.0\r\n\t\t\tfor k := 0; k < size; k++ {\r\n\t"]
[402.681939, "o", "\t\t\tsum += a.At(k, i) * a.At(k, j)\r\n\t\t\t}\r\n\t\t\tresult.Set(i, j, sum)\r\n\t\t}\r\n\t\tresult.Set(i, i, result.At(i, i)+float64(size)*scale)\r\n\t}\r\n\treturn result\r\n}\r\n\r\n"]
[402.681999, "o", "// flattenMatrix returns a flat slice of matrix data with row-major labeling.\r\nfunc flattenMatrix(m *Matrix, prefix string) ([]float64, []string) {\r\n\tvalues := make([]float64, 0, m.Rows*m.Cols)\r\n\tlabels := make([]string, 0, m.Rows*m.Cols)\r\n\tfor i := 0; i < m.Rows; i++ {\r\n\t\tfor j := 0; j < m.Cols; j++ {\r\n\t\t\tvalues = append(values, m.At(i, j))\r\n\t\t\tlabels = append(labels, fmt.Sprintf(\"%s[%d][%d]\", prefix, i, j))\r\n\t\t}\r\n\t}\r\n\treturn values, labels"]
[402.682059, "o", "\r\n}\r\n\r\n// matrixLUDecompose performs LU decomposition with partial pivoting.\r\n// Parameters: size (int), scale (float)\r\nfunc matrixLUDecompose(name string, params []Parameter) (*Result, error) {\r\n\tsizeF, err := RequireParam(params, \"size\")\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tscale, _ := GetParam(params, \"scale\")\r\n"]
[402.682118, "o", "\tif scale == 0 {\r\n\t\tscale = 10.0\r\n\t}\r\n\r\n\tsize := int(sizeF)\r\n\tif size <= 0 || size > 100 {\r\n\t\treturn nil, fmt.Errorf(\"matrix size must be between 1 and 100, got %d\", size)\r\n\t}\r\n\r\n"]
[402.682177, "o", "\ta := generateRandomMatrix(size, size, scale)\r\n\r\n\t// LU decomposition with partial pivoting\r\n\tl := NewMatrix(size, size)\r\n\tu := NewMatrix(size, size)\r\n\tperm := make([]int, size)\r\n\tfor i := 0; i < size; i++ {\r\n\t\tperm[i] = i\r\n\t}\r\n\r\n\t// Copy a into u\r\n\tcopy(u.Data, a.Data)\r\n\r\n\tfor k := 0; k < size; k++ {\r\n"]
[402.682238, "o", "\t\t// Find pivot\r\n\t\tmaxVal := math.Abs(u.At(k, k))\r\n\t\tmaxIdx := k\r\n\t\tfor i := k + 1; i < size; i++ {\r\n\t\t\tif math.Abs(u.At(i, k)) > maxVal {\r\n\t\t\t\tmaxVal = math.Abs(u.At(i, k))\r\n\t\t\t\tmaxIdx = i\r\n\t\t\t}\r\n\t\t}\r\n\r\n"]
[402.682293, "o", "\t\t// Swap rows in u, l, and permutation\r\n\t\tif maxIdx != k {\r\n"]
[402.68279, "o", "\u001b[?2004h"]
[402.682853, "o", "root@n30009:/app# "]
[402.961136, "i", "sed -n '121,380p' engine/matrix.go\n"]
[402.961427, "o", "sed -n '121,380p' engine/matrix.go\r\n\u001b[?2004l\r"]
[402.964397, "o", "\t\t\tperm[k], perm[maxIdx] = perm[maxIdx], perm[k]\r\n\t\t\tfor j := 0; j < size; j++ {\r\n\t\t\t\tu.Data[k*size+j], u.Data[maxIdx*size+j] = u.Data[maxIdx*size+j], u.Data[k*size+j]\r\n\t\t\t}\r\n\t\t\tfor j := 0; j < k; j++ {\r\n\t\t\t\tl.Data[k*size+j], l.Data[maxIdx*size+j] = l.Data[maxIdx*size+j], l.Data[k*size+j]\r\n"]
[402.964525, "o", "\t\t\t}\r\n\t\t}\r\n\r\n\t\tl.Set(k, k, 1.0)\r\n\r\n\t\tif math.Abs(u.At(k, k)) < 1e-12 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tfor i := k + 1; i < size; i++ {\r\n\t\t\tfactor := u.At(i, k) / u.At(k, k)\r\n\t\t\tl.Set(i, k, factor)\r\n\t\t\tfor j := k; j < size; j++ {\r\n\t\t\t\tu.Set(i, j, u.At(i, j)-factor*u.At(k, j))\r\n\t\t\t}\r\n"]
[402.964607, "o", "\t\t}\r\n\t}\r\n\r\n\t// Compute residual: ||PA - LU|| / ||A||\r\n\tresidual := computeLUResidual(a, l, u, perm)\r\n\r\n\t// Flatten all matrices into result\r\n\tlValues, lLabels := flattenMatrix(l, \"L\")\r\n\tuValues, uLabels := flattenMatrix(u, \"U\")\r\n\r\n\tallValues := append([]float64{residual, float64(size)}, lValues...)\r\n\tallValues = append(allValues, uValues...)\r\n\tallLabels := append([]string{\"residual_norm\", \"matrix_size\"}, lLabels...)\r\n\tallLabels = append(allLabels, uLabels...)\r\n\r\n"]
[402.964674, "o", "\treturn &Result{\r\n\t\tExperimentName: name,\r\n\t\tTimestamp:      time.Now(),\r\n\t\tParameters:     params,\r\n\t\tValues:         allValues,\r\n\t\tLabels:         allLabels,\r\n\t\tMetadata:       map[string]string{\"method\": \"partial_pivoting\", \"matrix_type\": \"random_dense\"},\r\n\t}, nil\r\n}\r\n\r\nfunc computeLUResidual(a, l, u *Matrix, perm []int) float64 {\r\n\tsize := a.Rows\r\n\tnormA := 0.0\r\n"]
[402.964741, "o", "\tnormDiff := 0.0\r\n\tfor i := 0; i < size; i++ {\r\n\t\tfor j := 0; j < size; j++ {\r\n\t\t\t// Compute (LU)[i][j]\r\n\t\t\tlu := 0.0\r\n\t\t\tfor k := 0; k < size; k++ {\r\n\t\t\t\tlu += l.At(i, k) * u.At(k, j)\r\n\t\t\t}\r\n\t\t"]
[402.9648, "o", "\t// Compare with PA[i][j]\r\n\t\t\tpa := a.At(perm[i], j)\r\n\t\t\tnormDiff += (pa - lu) * (pa - lu)\r\n\t\t\tnormA += pa * pa\r\n\t\t}\r\n\t}\r\n\tif normA < 1e-300 {\r\n\t\treturn 0\r\n\t}\r\n"]
[402.96486, "o", "\treturn math.Sqrt(normDiff) / math.Sqrt(normA)\r\n}\r\n\r\n// matrixQRDecompose performs QR decomposition via modified Gram-Schmidt.\r\n// Parameters: rows (int), cols (int), scale (float)\r\nfunc matrixQRDecompose(name string, params []Parameter) (*Result, error) {\r\n\trowsF, err := RequireParam(params, \"rows\")\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tcolsF, err := RequireParam(params, \"cols\")\r\n\tif err != nil {\r\n"]
[402.964921, "o", "\t\treturn nil, err\r\n\t}\r\n\tscale, _ := GetParam(params, \"scale\")\r\n\tif scale == 0 {\r\n\t\tscale = 10.0\r\n\t}\r\n\r\n\trows := int(rowsF)\r\n\tcols := int(colsF)\r\n\tif rows <= 0 || cols <= 0 || rows > 50 || cols > 50 {\r\n"]
[402.964978, "o", "\t\treturn nil, fmt.Errorf(\"matrix dimensions must be between 1 and 50\")\r\n\t}\r\n\r\n\ta := generateRandomMatrix(rows, cols, scale)\r\n\r\n\t// Modified Gram-Schmidt QR\r\n\tq := NewMatrix(rows, cols)\r\n\tr := NewMatrix(cols, cols)\r\n\r\n\t// Copy columns of A\r\n"]
[402.965035, "o", "\tfor j := 0; j < cols; j++ {\r\n\t\tfor i := 0; i < rows; i++ {\r\n\t\t\tq.Set(i, j, a.At(i, j))\r\n\t\t}\r\n\t}\r\n\r\n\tfor j := 0; j < cols; j++ {\r\n\t\t// Orthogonalize against previous columns\r\n\t\tfor k := 0; k < j; k++ {\r\n"]
[402.965098, "o", "\t\t\tdot := 0.0\r\n\t\t\tfor i := 0; i < rows; i++ {\r\n\t\t\t\tdot += q.At(i, k) * q.At(i, j)\r\n\t\t\t}\r\n\t\t\tr.Set(k, j, dot)\r\n\t\t\tfor i := 0; i < rows; i++ {\r\n\t\t\t\tq.Set(i, j, q.At(i, j)-dot*q.At(i, k))\r\n\t\t\t}\r\n\t\t}\r\n"]
[402.965153, "o", "\r\n\t\t// Normalize\r\n\t\tnorm := 0.0\r\n\t\tfor i := 0; i < rows; i++ {\r\n\t\t\tnorm += q.At(i, j) * q.At(i, j)\r\n\t\t}\r\n\t\tnorm = math.Sqrt(norm)\r\n\t\tr.Set(j, j, norm)\r\n"]
[402.965209, "o", "\r\n\t\tif norm > 1e-12 {\r\n\t\t\tfor i := 0; i < rows; i++ {\r\n\t\t\t\tq.Set(i, j, q.At(i, j)/norm)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[402.965266, "o", "\t// Compute residual ||A - QR||/||A||\r\n\tnormA := 0.0\r\n\tnormDiff := 0.0\r\n\tfor i := 0; i < rows; i++ {\r\n\t\tfor j := 0; j < cols; j++ {\r\n\t\t\tqr := 0.0\r\n\t\t\tfor k := 0; k < cols; k++ {\r\n\t\t\t\tqr += q.At(i, k) * r.At(k, j)\r\n\t\t\t}\r\n"]
[402.965324, "o", "\t\t\tdiff := a.At(i, j) - qr\r\n\t\t\tnormDiff += diff * diff\r\n\t\t\tnormA += a.At(i, j) * a.At(i, j)\r\n\t\t}\r\n\t}\r\n\tresidual := 0.0\r\n\tif normA > 1e-300 {\r\n\t\tresidual = math.Sqrt(normDiff) / math.Sqrt(normA)\r\n\t}\r\n"]
[402.96538, "o", "\r\n\t// Orthogonality check: ||Q^T Q - I||\r\n\torthoErr := 0.0\r\n\tfor i := 0; i < cols; i++ {\r\n\t\tfor j := 0; j < cols; j++ {\r\n\t\t\tdot := 0.0\r\n\t\t\tfor k := 0; k < rows; k++ {\r\n\t\t\t\tdot += q.At(k, i) * q.At(k, j)\r\n"]
[402.965436, "o", "\t\t\t}\r\n\t\t\ttarget := 0.0\r\n\t\t\tif i == j {\r\n\t\t\t\ttarget = 1.0\r\n\t\t\t}\r\n\t\t\torthoErr += (dot - target) * (dot - target)\r\n\t\t}\r\n\t}\r\n"]
[402.965502, "o", "\torthoErr = math.Sqrt(orthoErr)\r\n\r\n\tallValues := []float64{residual, orthoErr, float64(rows), float64(cols)}\r\n\tallLabels := []string{\"residual_norm\", \"orthogonality_error\", \"rows\", \"cols\"}\r\n\r\n\treturn &Result{\r\n\t\tExperimentName: name,\r\n\t\tTimestamp:      time.Now(),\r\n"]
[402.965563, "o", "\t\tParameters:     params,\r\n\t\tValues:         allValues,\r\n\t\tLabels:         allLabels,\r\n\t\tMetadata:       map[string]string{\"method\": \"modified_gram_schmidt\", \"matrix_type\": \"random_dense\"},\r\n\t}, nil\r\n}\r\n\r\n// matrixEigenvalue estimates the dominant eigenvalue using power iteration.\r\n// Parameters: size (int), scale (float), iterations (int)\r\nfunc matrixEigenvalue(name string, params []Parameter) (*Result, error) {\r\n\tsizeF, err := RequireParam(params, \"size\")\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n"]
[402.965624, "o", "\t}\r\n\tscale, _ := GetParam(params, \"scale\")\r\n\tif scale == 0 {\r\n\t\tscale = 10.0\r\n\t}\r\n\titersF, _ := GetParam(params, \"iterations\")\r\n\tif itersF == 0 {\r\n\t\titersF = 1000\r\n\t}\r\n\r\n"]
[402.965682, "o", "\tsize := int(sizeF)\r\n\titers := int(itersF)\r\n\r\n\tspd := generateSPDMatrix(size, scale)\r\n\r\n\t// Power iteration\r\n\tv := make([]float64, size)\r\n\tfor i := range v {\r\n\t\tv[i] = GlobalRand.Float64()\r\n\t}\r\n\t// Normalize\r\n\tnorm := 0.0\r\n"]
[402.965739, "o", "\tfor _, x := range v {\r\n\t\tnorm += x * x\r\n\t}\r\n\tnorm = math.Sqrt(norm)\r\n\tfor i := range v {\r\n\t\tv[i] /= norm\r\n\t}\r\n\r\n\teigenvalue := 0.0\r\n"]
[402.965798, "o", "\tconverged := false\r\n\tvar convergenceIter int\r\n\r\n\tfor iter := 0; iter < iters; iter++ {\r\n\t\t// w = A*v\r\n\t\tw := make([]float64, size)\r\n\t\tfor i := 0; i < size; i++ {\r\n\t\t\tfor j := 0; j < size; j++ {\r\n\t\t\t\t"]
[402.965854, "o", "w[i] += spd.At(i, j) * v[j]\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t// Rayleigh quotient\r\n\t\tnewEig := 0.0\r\n\t\tfor i := 0; i < size; i++ {\r\n\t\t\tnewEig += v[i] * w[i]\r\n"]
[402.965911, "o", "\t\t}\r\n\r\n\t\t// Normalize w\r\n\t\tnorm = 0.0\r\n\t\tfor _, x := range w {\r\n\t\t\tnorm += x * x\r\n\t\t}\r\n\t\tnorm = math.Sqrt(norm)\r\n\t\tfor i := range w {\r\n\t\t\tw[i] /= norm\r\n"]
[402.965967, "o", "\t\t}\r\n\r\n\t\tif math.Abs(newEig-eigenvalue) < 1e-12 {\r\n\t\t\tconverged = true\r\n\t\t\tconvergenceIter = iter\r\n\t\t\teigenvalue = newEig\r\n\t\t\tbreak\r\n\t\t}\r\n\r\n"]
[402.966022, "o", "\t\teigenvalue = newEig\r\n\t\tv = w\r\n\t}\r\n\r\n\tif !converged {\r\n\t\tconvergenceIter = iters\r\n\t}\r\n"]
