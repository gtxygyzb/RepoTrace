[2563.954123, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"runtime\"\r\n"]
[2563.954233, "o", "\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"numeriforge/compare\"\r\n\t\"numeriforge/config\"\r\n\t\"numeriforge/engine\"\r\n\t\"numeriforge/storage\"\r\n)\r\n\r\nfunc usage() {\r\n\tfmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform\r\n\r\nUsage:\r\n  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]\r\n  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\r\n  numeriforge list [--experiment <name>] [--store-dir <dir>]\r\n  numeriforge export <result_id> --store-dir <dir> [--format json|csv]\r\n  numeriforge verify <result_id> --store-dir <dir>\r\n\r\nCommands:\r\n  run       Run an experiment and store the result\r\n"]
[2563.95432, "o", "  compare   Compare two stored results\r\n  list      List stored experiment results\r\n  export    Export a result to a different format\r\n  verify    Verify result integrity\r\n\r\nAvailable experiments:\r\n`)\r\n\tfor _, name := range engine.List() {\r\n\t\tfmt.Fprintf(os.Stderr, \"  %s\\n\", name)\r\n\t}\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tusage()\r\n"]
[2563.954399, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(os.Args[2:])\r\n\tcase \"compare\":\r\n\t\tcmdCompare(os.Args[2:])\r\n\tcase \"list\":\r\n\t\tcmdList(os.Args[2:])\r\n\tcase \"export\":\r\n"]
[2563.954528, "o", "\t\tcmdExport(os.Args[2:])\r\n\tcase \"verify\":\r\n\t\tcmdVerify(os.Args[2:])\r\n\tcase \"help\", \"--help\", \"-h\":\r\n\t\tusage()\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\t\tusage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\n"]
[2563.954602, "o", "\r\n// environmentMetadata returns the environment fingerprint metadata required for\r\n// reproducible experiment traces.\r\nfunc environmentMetadata() map[string]string {\r\n\thostname, err := os.Hostname()\r\n\tif err != nil {\r\n\t\thostname = \"unknown\"\r\n\t}\r\n\treturn map[string]string{\r\n\t\t\"env_go_version\": runtime.Version(),\r\n\t\t\"env_os\":         runtime.GOOS,\r\n\t\t\"env_arch\":       runtime.GOARCH,\r\n\t\t\"env_hostname\":   hostname,\r\n"]
[2563.954675, "o", "\t}\r\n}\r\n\r\n// environmentFromMetadata aggregates stored environment fingerprint metadata\r\n// into an export-friendly object.\r\ntype environmentInfo struct {\r\n\tGoVersion string `json:\"go_version\"`\r\n\tOS        string `json:\"os\"`\r\n\tArch      string `json:\"arch\"`\r\n\tHostname  string `json:\"hostname\"`\r\n}\r\n\r\nfunc environmentFromMetadata(metadata map[string]string) environmentInfo {\r\n"]
[2563.954743, "o", "\treturn environmentInfo{\r\n\t\tGoVersion: metadata[\"env_go_version\"],\r\n\t\tOS:        metadata[\"env_os\"],\r\n\t\tArch:      metadata[\"env_arch\"],\r\n\t\tHostname:  metadata[\"env_hostname\"],\r\n\t}\r\n}\r\n\r\ntype exportPayload struct {\r\n\t*storage.StoredResult\r\n\tEnvironment environmentInfo `json:\"environment\"`\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n"]
[2563.954811, "o", "\tvar experimentName, outputDir, configPath string\r\n\tvar paramStrs []string\r\n\tvar seed int64\r\n\tseedProvided := false\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--experiment\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n"]
[2563.954887, "o", "\t\t\t}\r\n\t\t\texperimentName = args[i]\r\n\t\tcase \"--output-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --output-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\toutputDir = args[i]\r\n\t\tcase \"--config\":\r\n\t\t\ti++"]
[2563.954961, "o", "\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --config requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tconfigPath = args[i]\r\n\t\tcase \"--param\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n"]
[2563.955549, "o", "\u001b[?2004h"]
