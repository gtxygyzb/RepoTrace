[3955.24295, "o", "\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"tolerance\":\r\n\u001b[32m\u001b[K367\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KcmdList(args []string) {\r\n\u001b[32m\u001b[K373\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n\u001b[32m\u001b[K380\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"\u001b[01;31m\u001b[K--experiment\u001b[m\u001b[K\":\r\n\u001b[32m\u001b[K383\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tfmt.Fprintf(os.Stderr, \"error: \u001b[01;31m\u001b[K--experiment\u001b[m\u001b[K requires a value\\n\")\r\n"]
