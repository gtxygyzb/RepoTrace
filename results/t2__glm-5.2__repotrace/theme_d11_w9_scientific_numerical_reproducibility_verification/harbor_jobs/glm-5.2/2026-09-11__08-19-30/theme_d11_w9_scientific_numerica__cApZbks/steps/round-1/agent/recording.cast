[798.713313, "i", "cat > main.go <<'EOF'\npackage main\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"numeriforge/compare\"\n\t\"numeriforge/config\"\n\t\"numeriforge/engine\"\n\t\"numeriforge/storage\"\n)\n\nfunc usage() {\n\tfmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform\n\nUsage:\n  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]\n  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\n  numeriforge list [--experiment <name>] [--store-dir <dir>]\n  numeriforge export <result_id> --store-dir <dir> [--format json|csv]\n  numeriforge verify <result_id> --store-dir <dir>\n\nCommands:\n  run       Run an experiment and store the result\n  compare   Compare two stored results\n  list      List stored experiment results\n  export    Export a result to a different format\n  verify    Verify result integrity\n\nAvailable experiments:\n`)\n\tfor _, name := range engine.List"]
[798.713338, "i", "() {\n\t\tfmt.Fprintf(os.Stderr, \"  %s\\n\", name)\n\t}\n}\n\nfunc main() {\n\tif len(os.Args) < 2 {\n\t\tusage()\n\t\tos.Exit(1)\n\t}\n\n\tcmd := os.Args[1]\n\n\tswitch cmd {\n\tcase \"run\":\n\t\tcmdRun(os.Args[2:])\n\tcase \"compare\":\n\t\tcmdCompare(os.Args[2:])\n\tcase \"list\":\n\t\tcmdList(os.Args[2:])\n\tcase \"export\":\n\t\tcmdExport(os.Args[2:])\n\tcase \"verify\":\n\t\tcmdVerify(os.Args[2:])\n\tcase \"help\", \"--help\", \"-h\":\n\t\tusage()\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\n\t\tusage()\n\t\tos.Exit(1)\n\t}\n}\n\nfunc cmdRun(args []string) {\n\tvar experimentName, outputDir, configPath string\n\tvar paramStrs []string\n\tvar seed int64\n\tseedProvided := false\n\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--experiment\":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment requires a value\\n\")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\texperimentName = args[i]\n\t\tcase \"--output-dir\":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --output-dir requires a value\\n\")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\toutputDir = args[i]\n\t\tcase \"--co"]
[798.713411, "i", "nfig\":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --config requires a value\\n\")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tconfigPath = args[i]\n\t\tcase \"--param\":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --param requires a value\\n\")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tparamStrs = append(paramStrs, args[i])\n\t\tcase \"--seed\":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --seed requires a value\\n\")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tparsed, err := strconv.ParseInt(args[i], 10, 64)\n\t\t\tif err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid seed: %v\\n\", err)\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tseed = parsed\n\t\t\tseedProvided = true\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\n\tif configPath != \"\" {\n\t\tcfg, err := config.ParseINI(configPath)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"config error: %v\\n\", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tif experimentName == \"\" {\n\t\t\texperimentName = cfg.Experiment\n\t\t}\n\t\tif outputDir == \"\" {\n\t\t\toutputDir = cfg.OutputDir\n\t\t}\n\n\t\tcliPa"]
[798.713519, "i", "rams, _ := config.ParseParams(paramStrs)\n\t\tcliParamMap := make(map[string]float64)\n\t\tfor _, p := range cliParams {\n\t\t\tcliParamMap[p.Name] = p.Value\n\t\t}\n\t\tfor _, p := range cfg.Params {\n\t\t\tif _, exists := cliParamMap[p.Name]; !exists {\n\t\t\t\tcliParams = append(cliParams, p)\n\t\t\t}\n\t\t}\n\t\tparamStrs = nil\n\t\tfor _, p := range cliParams {\n\t\t\tparamStrs = append(paramStrs, fmt.Sprintf(\"%s=%g\", p.Name, p.Value))\n\t\t}\n\t}\n\n\tif experimentName == \"\" {\n\t\tfmt.Fprintf(os.Stderr, \"error: --experiment is required\\n\")\n\t\tos.Exit(1)\n\t}\n\tif outputDir == \"\" {\n\t\toutputDir = \"./results\"\n\t}\n\n\tparams, err := config.ParseParams(paramStrs)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"parameter error: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tfn, err := engine.Get(experimentName)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tif !seedProvided {\n\t\tseed = time.Now().UnixNano()\n\t}\n\n\trng := engine.NewRNG(seed)\n\n\tresult, err := fn(experimentName, params, rng)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"experiment error: %v\\n\", err"]
