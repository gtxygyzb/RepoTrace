[5188.05761, "o", "603 func cmdVerify(args []string) {\r\n604 \tif len(args) < 1 {\r\n605 \t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\\n\")\r\n606 \t\tos.Exit(1)\r\n607 \t}\r\n"]
[5188.057643, "o", "608 \r\n609 \tid := args[0]\r\n610 \tstoreDir := \"./results\"\r\n611 \tverbose := false\r\n612 "]
[5188.05774, "o", "\r\n613 \tfor i := 1; i < len(args); i++ {\r\n614 \t\tswitch args[i] {\r\n615 \t\tcase \"--verbose\":\r\n616 \t\t\tverbose = true\r\n617 \t\tcase \"--store-dir\":\r\n618 \t\t\ti++\r\n619 \t\t\tif i >= len(args) {\r\n620 \t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n621 \t\t\t\tos.Exit(1)\r\n622 \t\t\t}\r\n623 \t\t\tstoreDir = args[i]\r\n624 \t\tdefault:\r\n625 \t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n"]
[5188.057805, "o", "626 \t\t\tos.Exit(1)\r\n627 \t\t}\r\n628 \t}\r\n629 \r\n630 \tstore, err := storage.NewStore(storeDir)\r\n631 \tif err != nil {\r\n632 \t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n633 \t\tos.Exit(1)\r\n634 \t}\r\n"]
[5188.057865, "o", "635 \r\n636 \tstatus, expected, computed, err := store.Verify(id)\r\n637 \tif err != nil {\r\n638 \t\tfmt.Fprintf(os.Stderr, \"verify error: %v\\n\", err)\r\n639 \t\tos.Exit(1)\r\n640 \t}\r\n641 \r\n642 \tswitch status {\r\n643 \tcase storage.StatusVerified:"]
[5188.057924, "o", "\r\n644 \t\tfmt.Printf(\"INTEGRITY_OK: %s\\n\", id)\r\n645 \t\tif verbose {\r\n646 \t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n647 \t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n648 \t\t}\r\n649 \t\tos.Exit(0)\r\n"]
[5188.057983, "o", "650 \tcase storage.StatusCorrupted:\r\n651 \t\tfmt.Printf(\"INTEGRITY_FAIL: %s\\n\", id)\r\n652 \t\tif verbose {\r\n653 \t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n654 \t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n655 \t\t}\r\n656 \t\tos.Exit(1)\r\n657 \tcase storage.StatusNoChecksum:\r\n658 \t\tfmt.Printf(\"NO_CHECKSUM: %s\\n\", id)\r\n659 "]
[5188.05804, "o", "\t\tos.Exit(2)\r\n660 \tdefault:\r\n661 \t\tfmt.Fprintf(os.Stderr, \"unknown verification status: %s\\n\", status)\r\n662 \t\tos.Exit(1)\r\n663 \t}\r\n664 }\r\n665 func cmdAudit(args []string) {\r\n"]
