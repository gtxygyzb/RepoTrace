[4461.153943, "o", "   799\t}\r\n   800\t\r\n   801\tfunc warnEnvMismatch(stored *storage.StoredResult) {\r\n   802\t\tmsg, ok := envMismatchWarning(stored.Metadata)\r\n   803\t\tif ok {\r\n   804\t\t\tfmt.Fprintln(os.Stderr, msg)\r\n   805\t\t}\r\n   806\t}\r\n   807\t\r\n   808\tfunc envMismatchWarning(metadata map[string]string) (string, bool) {\r\n   809\t\tcurrent := environmentMetadata()\r\n   810\t\tfields := []string{\"env_go_version\", \"env_os\", \"env_arch\", \"env_hostname\"}\r\n"]
[4461.154013, "o", "   811\t\r\n   812\t\tvar diffs []string\r\n   813\t\tfor _, field := range fields {\r\n   814\t\t\tif metadata[field] != current[field] {\r\n   815\t\t\t\tdiffs = append(diffs, fmt.Sprintf(\"%s stored=%q current=%q\", field, metadata[field], current[field]))\r\n   816\t\t\t}\r\n   817\t\t}\r\n   818\t\r\n   819\t\tif len(diffs) == 0 {\r\n   820\t\t\treturn \"\", false\r\n"]
