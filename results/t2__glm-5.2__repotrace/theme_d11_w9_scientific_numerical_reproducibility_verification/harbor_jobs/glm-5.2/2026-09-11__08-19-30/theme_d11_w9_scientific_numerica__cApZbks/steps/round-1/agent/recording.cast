[3816.465643, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K544\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Printf(\"\u001b[01;31m\u001b[KStored checksum\u001b[m\u001b[K: %s\\n\", expected)\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K545\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Printf(\"\u001b[01;31m\u001b[KComputed checksum\u001b[m\u001b[K: %s\\n\", computed)\r\n"]
[3816.46573, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K549\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Printf(\"\u001b[01;31m\u001b[KNO_CHECKSUM:\u001b[m\u001b[K %s\\n\", id)\r\n"]
[3816.465842, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K655\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: \u001b[01;31m\u001b[Kintegrity check\u001b[m\u001b[K error: %v)\\n\", id, err)\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K658\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: \u001b[01;31m\u001b[Kintegrity check\u001b[m\u001b[K failed: no checksum)\\n\", id)\r\n"]
[3816.465901, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K661\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: \u001b[01;31m\u001b[Kintegrity check\u001b[m\u001b[K failed expected=%s computed=%s)\\n\", id, expected, computed)\r\n"]
[3816.466156, "o", "\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K4. Print `\u001b[01;31m\u001b[KINTEGRITY_OK:\u001b[m\u001b[K <id>` and exit 0 if checksums match.\r\n\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K5. Print `\u001b[01;31m\u001b[KINTEGRITY_FAIL:\u001b[m\u001b[K <id>` and exit 1 if they differ.\r\n"]
[3816.466217, "o", "\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K6. Print `\u001b[01;31m\u001b[KNO_CHECKSUM:\u001b[m\u001b[K <id>` and exit 2 if the stored result has no checksum field.\r\n\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K7. When `--\u001b[01;31m\u001b[Kverbose\u001b[m\u001b[K` is supplied, after the `INTEGRITY_OK` or `INTEGRITY_FAIL` line, also print:\r\n\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   - `\u001b[01;31m\u001b[KStored checksum\u001b[m\u001b[K: <hex>`\r\n\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   - `\u001b[01;31m\u001b[KComputed checksum\u001b[m\u001b[K: <hex>`\r\n"]
[3816.466297, "o", "\u001b[35m\u001b[Kdocs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Knumeriforge verify <id> --store-dir <dir> [--\u001b[01;31m\u001b[Kverbose\u001b[m\u001b[K]\r\n"]
[3816.466355, "o", "\u001b[35m\u001b[Kdocs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K**Known limitation:** Results do not include \u001b[01;31m\u001b[Kintegrity check\u001b[m\u001b[Ksums. There is no way to verify that stored values have not been corrupted or tampered with.\r\n"]
[3816.466887, "o", "\u001b[?2004h"]
[3816.466946, "o", "root@n30009:/app# "]
[3816.739108, "i", "grep -n \"verify\" -A2 -B2 main.go | sed -n '1,80p'\n"]
[3816.739528, "o", "grep -n \"verify\" -A2 -B2 main.go | sed -n '1,80p'"]
[3816.739606, "o", "\r\n\u001b[?2004l\r"]
[3816.74346, "o", "25-  numeriforge list [--experiment <name>] [--store-dir <dir>]\r\n26-  numeriforge export <result_id> --store-dir <dir> [--format json|csv]\r\n27:  numeriforge verify <result_id> --store-dir <dir>\r\n28-  numeriforge audit <result_id> --store-dir <dir>\r\n29-  numeriforge audit --all --store-dir <dir>\r\n"]
[3816.74358, "o", "--\r\n34-  list      List stored experiment results\r\n35-  export    Export a result to a different format\r\n36:  verify    Verify result integrity\r\n37-  audit     Audit stored result(s) for reproducibility\r\n38-\r\n--\r\n61-\tcase \"export\":\r\n62-\t\tcmdExport(os.Args[2:])\r\n63:\tcase \"verify\":\r\n64-\t\tcmdVerify(os.Args[2:])\r\n65-\tcase \"audit\":\r\n--\r\n494-func cmdVerify(args []string) {\r\n495-\tif len(args) < 1 {\r\n496:\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\\n\")\r\n497-\t\tos.Exit(1)\r\n498-\t}\r\n"]
[3816.743649, "o", "--\r\n527-\tstatus, expected, computed, err := store.Verify(id)\r\n528-\tif err != nil {\r\n529:\t\tfmt.Fprintf(os.Stderr, \"verify error: %v\\n\", err)\r\n530-\t\tos.Exit(1)\r\n531-\t}\r\n"]
[3816.744299, "o", "\u001b[?2004h"]
[3816.744361, "o", "root@n30009:/app# "]
[3832.093832, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('main.go')\ns = p.read_text()\ns = s.replace('  numeriforge verify <result_id> --store-dir <dir>\\n', '  numeriforge verify <result_id> --store-dir <dir> [--verbose]\\n')\ns = s.replace('reason: integrity check failed expected=%s computed=%s', 'reason: integrity check failed: expected=%s computed=%s')\np.write_text(s)\nPY\n"]
[3832.0941, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
