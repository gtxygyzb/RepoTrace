[3067.250921, "i", "sed -n '1,260p' /app/storage/storage.go\n"]
[3067.251306, "o", "sed -n '1,260p' /app/storage/storage.go\r\n\u001b[?2004l\r"]
[3067.254114, "o", "package storage\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[3067.254196, "o", "\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n"]
[3067.254262, "o", "\r\n\t\"numeriforge/engine\"\r\n)\r\n\r\n// StoredResult is the on-disk representation of an experiment result.\r\ntype StoredResult struct {\r\n\tID             string             `json:\"id\"`\r\n\tExperimentName string             `json:\"experiment_name\"`\r\n\tTimestamp      time.Time          `json:\"timestamp\"`\r\n\tParameters     []engine.Parameter `json:\"parameters\"`\r\n\tValues         []float64          `json:\"values\"`\r\n\tLabels         []string           `json:\"labels\"`\r\n\tMetadata       map[string]string  `json:\"metadata\"`\r\n\tChecksum       string             `json:\"checksum,omitempty\"`\r\n}\r\n\r\n// VerifyStatus reports the outcome of integrity verification.\r\ntype VerifyStatus string\r\n\r\nconst (\r\n\tStatusVerified   VerifyStatus = \"verified\"\r\n\tStatusCorrupted  VerifyStatus = \"corrupted\"\r\n\tStatusNoChecksum VerifyStatus = \"no_checksum\""]
[3067.254336, "o", "\r\n)\r\n\r\n// IndexEntry is a stored result index record.\r\ntype IndexEntry struct {\r\n\tID             string\r\n\tExperimentName string\r\n\tTimestamp      time.Time\r\n}\r\n\r\n// Store manages experiment result persistence.\r\ntype Store struct {\r\n\tBaseDir string\r\n}\r\n\r\n"]
[3067.254402, "o", "// NewStore creates a store at the given directory.\r\nfunc NewStore(baseDir string) (*Store, error) {\r\n\tif err := os.MkdirAll(baseDir, 0755); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"cannot create store directory: %w\", err)\r\n\t}\r\n\treturn &Store{BaseDir: baseDir}, nil\r\n}\r\n\r\n// ComputeChecksum returns the SHA-256 checksum of the canonical value\r\n// representation defined by the reproducibility specification.\r\nfunc ComputeChecksum(values []float64) string {\r\n\tvar sb strings.Builder\r\n"]
[3067.254462, "o", "\tfor i, v := range values {\r\n\t\tif i > 0 {\r\n\t\t\tsb.WriteByte('\\n')\r\n\t\t}\r\n\t\tfmt.Fprintf(&sb, \"%.17e\", v)\r\n\t}\r\n\tsum := sha256.Sum256([]byte(sb.String()))\r\n\treturn fmt.Sprintf(\"%x\", sum)\r\n}\r\n\r\n"]
[3067.25455, "o", "// Save persists an experiment result to disk.\r\nfunc (s *Store) Save(result *engine.Result) (string, error) {\r\n\tid := fmt.Sprintf(\"%s_%s\", result.ExperimentName, result.Timestamp.Format(\"20060102_150405\"))\r\n\r\n\tchecksum := ComputeChecksum(result.Values)\r\n\r\n\tif result.Metadata == nil {\r\n\t\tresult.Metadata = map[string]string{}\r\n\t}\r\n\tresult.Metadata[\"values_checksum\"] = checksum\r\n\r\n\tstored := StoredResult{\r\n\t\tID:             id,\r\n\t"]
[3067.254608, "o", "\tExperimentName: result.ExperimentName,\r\n\t\tTimestamp:      result.Timestamp,\r\n\t\tParameters:     result.Parameters,\r\n\t\tValues:         result.Values,\r\n\t\tLabels:         result.Labels,\r\n\t\tMetadata:       result.Metadata,\r\n\t\tChecksum:       checksum,\r\n\t}\r\n\r\n"]
[3067.254672, "o", "\tdata, err := json.MarshalIndent(stored, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"marshal error: %w\", err)\r\n\t}\r\n\r\n\tresultDir := filepath.Join(s.BaseDir, result.ExperimentName)\r\n\tif err := os.MkdirAll(resultDir, 0755); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"cannot create result directory: %w\", err)\r\n\t}\r\n"]
[3067.254728, "o", "\r\n\tpath := filepath.Join(resultDir, id+\".json\")\r\n\tif err := os.WriteFile(path, data, 0644); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"write error: %w\", err)\r\n\t}\r\n\r\n\tif err := s.updateIndex(id, result.ExperimentName, result.Timestamp); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"index update error: %w\", err)\r\n"]
[3067.254792, "o", "\t}\r\n\r\n\treturn id, nil\r\n}\r\n\r\n// Load reads a stored result by ID.\r\nfunc (s *Store) Load(id string) (*StoredResult, error) {\r\n\tvar resultPath string\r\n\terr := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t\tif !info.IsDir() && strings.TrimSuffix(info.Name(), \".json\") == id {\r\n"]
[3067.254849, "o", "\t\t\tresultPath = path\r\n\t\t\treturn filepath.SkipAll\r\n\t\t}\r\n\t\treturn nil\r\n\t})\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n"]
[3067.254905, "o", "\tif resultPath == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"result not found: %s\", id)\r\n\t}\r\n\r\n\tdata, err := os.ReadFile(resultPath)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"read error: %w\", err)\r\n\t}\r\n\r\n"]
[3067.254961, "o", "\tvar stored StoredResult\r\n\tif err := json.Unmarshal(data, &stored); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"unmarshal error: %w\", err)\r\n\t}\r\n\treturn &stored, nil\r\n}\r\n\r\n// ListResults returns all stored result IDs, optionally filtered by experiment name.\r\nfunc (s *Store) ListResults(experimentFilter string) ([]IndexEntry, error) {\r\n\tentries, err := s.readIndex()\r\n"]
[3067.255022, "o", "\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tif experimentFilter == \"\" {\r\n\t\treturn entries, nil\r\n\t}\r\n\r\n\tfiltered := make([]IndexEntry, 0)\r\n\tfor _, entry := range entries {\r\n"]
[3067.255084, "o", "\t\tif entry.ExperimentName == experimentFilter {\r\n\t\t\tfiltered = append(filtered, entry)\r\n\t\t}\r\n\t}\r\n\treturn filtered, nil\r\n}\r\n\r\n// Verify checks stored result integrity by recomputing the canonical checksum.\r\nfunc (s *Store) Verify(id string) (VerifyStatus, string, string, error) {\r\n"]
[3067.255141, "o", "\tstored, err := s.Load(id)\r\n\tif err != nil {\r\n\t\treturn \"\", \"\", \"\", err\r\n\t}\r\n\r\n\tif stored.Checksum == \"\" {\r\n\t\treturn StatusNoChecksum, \"\", \"\", nil\r\n\t}\r\n\r\n\tcomputed := ComputeChecksum(stored.Values)\r\n"]
[3067.2552, "o", "\tif computed == stored.Checksum {\r\n\t\treturn StatusVerified, stored.Checksum, computed, nil\r\n\t}\r\n\treturn StatusCorrupted, stored.Checksum, computed, nil\r\n}\r\n\r\nfunc (s *Store) indexPath() string {\r\n\treturn filepath.Join(s.BaseDir, \"index.txt\")\r\n}\r\n\r\nfunc (s *Store) updateIndex(id, experimentName string, timestamp time.Time) error {\r\n\tif err := os.MkdirAll(s.BaseDir, 0755); err != nil {\r\n"]
[3067.25527, "o", "\t\treturn err\r\n\t}\r\n\r\n\tf, err := os.OpenFile(s.indexPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n"]
[3067.255327, "o", "\tdefer f.Close()\r\n\r\n\t_, err = fmt.Fprintf(f, \"%s|%s|%s\\n\", id, experimentName, timestamp.Format(time.RFC3339))\r\n\treturn err\r\n}\r\n\r\nfunc (s *Store) readIndex() ([]IndexEntry, error) {\r\n\tdata, err := os.ReadFile(s.indexPath())\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, nil\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\r\n"]
[3067.255383, "o", "\tvar entries []IndexEntry\r\n\tfor _, line := range strings.Split(strings.TrimSpace(string(data)), \"\\n\") {\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.SplitN(line, \"|\", 3)\r\n\t\tif len(parts) != 3 {\r\n"]
[3067.25544, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tts, _ := time.Parse(time.RFC3339, parts[2])\r\n\t\tentries = append(entries, IndexEntry{\r\n\t\t\tID:             parts[0],\r\n\t\t\tExperimentName: parts[1],\r\n\t\t\tTimestamp:      ts,\r\n\t\t})\r\n\t}\r\n"]
[3067.255515, "o", "\r\n\tsort.Slice(entries, func(i, j int) bool {\r\n\t\treturn entries[i].Timestamp.Before(entries[j].Timestamp)\r\n\t})\r\n\r\n\treturn entries, nil\r\n}\r\n"]
[3067.255984, "o", "\u001b[?2004h"]
[3067.256039, "o", "root@n30009:/app# "]
[3067.518804, "i", "sed -n '1,260p' /app/engine/engine.go\n"]
[3067.519165, "o", "sed -n '1,260p' /app/engine/engine.go\r\n"]
[3067.51926, "o", "\u001b[?2004l\r"]
[3067.522006, "o", "package engine\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math/rand\"\r\n"]
[3067.522088, "o", "\t\"time\"\r\n)\r\n\r\n// ExperimentType enumerates supported experiment categories.\r\ntype ExperimentType string\r\n\r\nconst (\r\n\tTypeMonteCarlo ExperimentType = \"montecarlo\"\r\n\tTypeMatrix     ExperimentType = \"matrix\"\r\n\tTypeODE        ExperimentType = \"ode\"\r\n\tTypeStats      ExperimentType = \"stats\"\r\n)\r\n\r\n// Parameter holds a single experiment parameter.\r\ntype Parameter struct {\r\n\tName  string"]
[3067.522167, "o", "\r\n\tValue float64\r\n}\r\n\r\n// Result holds raw experiment output.\r\ntype Result struct {\r\n\tExperimentName string\r\n\tTimestamp      time.Time\r\n\tParameters     []Parameter\r\n\tValues         []float64\r\n\tLabels         []string\r\n\tMetadata       map[string]string\r\n}\r\n\r\n// ExperimentFunc is the signature for all experiment backends.\r\n"]
[3067.522228, "o", "// It takes a name, parameters, and returns a Result or error.\r\ntype ExperimentFunc func(name string, params []Parameter, rng RNG) (*Result, error)\r\n\r\n// Global registry of experiment backends.\r\nvar registry = map[string]ExperimentFunc{}\r\n\r\n// RNG is an isolated random number generator type for experiment backends.\r\ntype RNG = *rand.Rand\r\n\r\n// NewRNG creates an isolated random source for a single experiment invocation.\r\nfunc NewRNG(seed int64) RNG {\r\n\treturn rand.New(rand.NewSource(seed))\r\n}\r\n\r\n"]
[3067.522295, "o", "// Register adds an experiment backend to the registry.\r\nfunc Register(name string, fn ExperimentFunc) {\r\n\tregistry[name] = fn\r\n}\r\n\r\n// Get retrieves an experiment backend by name.\r\nfunc Get(name string) (ExperimentFunc, error) {\r\n\tfn, ok := registry[name]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"unknown experiment: %s\", name)\r\n\t}\r\n\treturn fn, nil\r\n}\r\n"]
[3067.522358, "o", "\r\n// List returns all registered experiment names.\r\nfunc List() []string {\r\n\tnames := make([]string, 0, len(registry))\r\n\tfor k := range registry {\r\n\t\tnames = append(names, k)\r\n\t}\r\n\treturn names\r\n}\r\n\r\n// GetParam finds a parameter by name, returning its value and whether it was found.\r\nfunc GetParam(params []Parameter, name string) (float64, bool) {\r\n"]
[3067.522418, "o", "\tfor _, p := range params {\r\n\t\tif p.Name == name {\r\n\t\t\treturn p.Value, true\r\n\t\t}\r\n\t}\r\n\treturn 0, false\r\n}\r\n\r\n// RequireParam finds a parameter by name or returns an error.\r\n"]
[3067.522502, "o", "func RequireParam(params []Parameter, name string) (float64, error) {\r\n\tv, ok := GetParam(params, name)\r\n\tif !ok {\r\n\t\treturn 0, fmt.Errorf(\"missing required parameter: %s\", name)\r\n\t}\r\n\treturn v, nil\r\n}\r\n\r\nfunc init() {\r\n\tregisterMonteCarloExperiments()\r\n"]
[3067.52256, "o", "\tregisterMatrixExperiments()\r\n\tregisterODEExperiments()\r\n\tregisterStatsExperiments()\r\n}\r\n"]
[3067.522983, "o", "\u001b[?2004h"]
[3067.523038, "o", "root@n30009:/app# "]
[3067.790369, "i", "sed -n '1,220p' /app/compare/compare.go\n"]
[3067.790711, "o", "sed -n '1,220p' /app/compare/compare.go\r\n\u001b[?2004l\r"]
[3067.79356, "o", "package compare\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"strings\"\r\n\r\n\t\"numeriforge/storage\"\r\n)\r\n\r\n// ComparisonMode determines how results are compared."]
[3067.793701, "o", "\r\ntype ComparisonMode int\r\n\r\nconst (\r\n\t// ModeExact uses exact float equality (legacy behavior).\r\n\tModeExact ComparisonMode = iota\r\n\t// ModeTolerance uses configurable absolute and relative tolerance.\r\n\tModeTolerance\r\n)\r\n\r\n// Tolerance defines comparison thresholds.\r\ntype Tolerance struct {\r\n\tAbsolute float64\r\n\tRelative float64\r\n}\r\n\r\n// DefaultTolerance returns the spec defaults for scientific comparisons.\r\nfunc DefaultTolerance() Tolerance {\r\n\treturn Tolerance{\r\n\t\tAbsolute: 1e-10,\r\n\t\tRelative: 1e-8,\r\n\t}\r\n}\r\n\r\n// ComparisonResult holds the outcome of comparing two experiment results.\r\ntype ComparisonResult struct {\r\n\tMatch        bool\r\n\tTotalPairs   int\r\n\tMatchedPairs int\r\n\tMismatches   []Mismatch\r\n\tMode         ComparisonMode\r\n\tTolerance    Tolerance\r\n\tSummary      string\r\n"]
[3067.793738, "o", "}\r\n\r\n// Mismatch records a single value pair that didn't match.\r\ntype Mismatch struct {\r\n\tIndex   int\r\n"]
[3067.793886, "o", "\tLabel   string\r\n\tValueA  float64\r\n\tValueB  float64\r\n\tAbsDiff float64\r\n\tRelDiff float64\r\n}\r\n\r\n// Compare compares two stored results.\r\nfunc Compare(a, b *storage.StoredResult, mode ComparisonMode, tol Tolerance) *ComparisonResult {\r\n\tresult := &ComparisonResult{\r\n\t\tMode:      mode,\r\n\t\tTolerance: tol,\r\n\t}\r\n\r\n\tif a.ExperimentName != b.ExperimentName {\r\n\t\tresult.Match = false\r\n\t\tresult.Summary = fmt.Sprintf(\"experiment name mismatch: %s vs %s\", a.ExperimentName, b.ExperimentName)\r\n\t\treturn result\r\n\t}\r\n\r\n\tminLen := len(a.Values)\r\n\tif len(b.Values) < minLen {\r\n\t\tminLen = len(b.Values)\r\n\t}\r\n\r\n\tif len(a.Values) != len(b.Values) {\r\n\t\tresult.Match = false\r\n\t\tresult.Summary = fmt.Sprintf(\"value count mismatch: %d vs %d\", len(a.Values), len(b.Values))\r\n\t\treturn result\r\n"]
[3067.793962, "o", "\t}\r\n\r\n\tresult.TotalPairs = minLen\r\n\r\n\tswitch mode {\r\n\tcase ModeExact:\r\n\t\tresult.Match = true\r\n\t\tfor i := 0; i < minLen; i++ {\r\n\t\t\tlabel := fmt.Sprintf(\"value[%d]\", i)\r\n\t\t\tif i < len(a.Labels) {\r\n\t\t\t\tlabel = a.Labels[i]\r\n\t\t\t}\r\n\t\t\tif a.Values[i] != b.Values[i] {\r\n\t\t\t\tresult.Match = false\r\n"]
[3067.794022, "o", "\t\t\t\tresult.Mismatches = append(result.Mismatches, Mismatch{\r\n\t\t\t\t\tIndex:   i,\r\n\t\t\t\t\tLabel:   label,\r\n\t\t\t\t\tValueA:  a.Values[i],\r\n\t\t\t\t\tValueB:  b.Values[i],\r\n\t\t\t\t\tAbsDiff: math.Abs(a.Values[i] - b.Values[i]),\r\n\t\t\t\t\tRelDiff: relDiff(a.Values[i], b.Values[i]),\r\n"]
[3067.79409, "o", "\t\t\t\t})\r\n\t\t\t} else {\r\n\t\t\t\tresult.MatchedPairs++\r\n\t\t\t}\r\n\t\t}\r\n"]
[3067.794148, "o", "\tcase ModeTolerance:\r\n\t\tresult.Match = true\r\n\t\tfor i := 0; i < minLen; i++ {\r\n\t\t\tlabel := fmt.Sprintf(\"value[%d]\", i)\r\n\t\t\tif i < len(a.Labels) {\r\n\t\t\t\tlabel = a.Labels[i]\r\n\t\t\t}\r\n\t\t\tif !valuesMatch(a.Values[i], b.Values[i], tol) {\r\n\t\t\t\tresult.Match = false\r\n\t\t\t\tresult.Mismatches = append(result.Mismatches, Mismatch{\r\n\t\t\t\t\tIndex:   i,\r\n\t\t\t\t\tLabel:   label,\r\n\t\t\t\t\tValueA:  a.Values[i],\r\n"]
[3067.794209, "o", "\t\t\t\t\tValueB:  b.Values[i],\r\n\t\t\t\t\tAbsDiff: math.Abs(a.Values[i] - b.Values[i]),\r\n\t\t\t\t\tRelDiff: relDiff(a.Values[i], b.Values[i]),\r\n\t\t\t\t})\r\n\t\t\t} else {\r\n\t\t\t\tresult.MatchedPairs++\r\n\t\t\t}\r\n\t\t}\r\n"]
[3067.794273, "o", "\tdefault:\r\n\t\tresult.Match = false\r\n\t\tresult.Summary = \"unknown comparison mode\"\r\n\t\treturn result\r\n\t}\r\n\r\n\tif result.Summary == \"\" {\r\n\t\tif result.Match {\r\n\t\t\tresult.Summary = fmt.Sprintf(\"all %d value pairs match\", result.TotalPairs)\r\n\t\t} else {\r\n\t\t\t"]
[3067.794334, "o", "result.Summary = fmt.Sprintf(\"%d of %d value pairs mismatch\", len(result.Mismatches), result.TotalPairs)\r\n\t\t}\r\n\t}\r\n\r\n\treturn result\r\n}\r\n\r\n// valuesMatch implements the spec's tolerance comparison rules.\r\nfunc valuesMatch(a, b float64, tol Tolerance) bool {\r\n\tif math.IsNaN(a) && math.IsNaN(b) {\r\n\t\treturn true\r\n\t}\r\n\tif math.IsNaN(a) || math.IsNaN(b) {"]
[3067.7944, "o", "\r\n\t\treturn false\r\n\t}\r\n\r\n\tif math.IsInf(a, 1) && math.IsInf(b, 1) {\r\n\t\treturn true\r\n\t}\r\n\tif math.IsInf(a, -1) && math.IsInf(b, -1) {\r\n\t\treturn true\r\n\t}\r\n"]
[3067.794457, "o", "\tif math.IsInf(a, 0) || math.IsInf(b, 0) {\r\n\t\treturn false\r\n\t}\r\n\r\n\tif math.Abs(a) < tol.Absolute && math.Abs(b) < tol.Absolute {\r\n\t\treturn true\r\n\t}\r\n\r\n\tdiff := math.Abs(a - b)\r\n\tif diff <= tol.Absolute {\r\n\t\t"]
[3067.794538, "o", "return true\r\n\t}\r\n\r\n\tdenom := math.Max(math.Abs(a), math.Abs(b))\r\n\tif denom > 0 && diff/denom <= tol.Relative {\r\n\t\treturn true\r\n\t}\r\n\r\n\treturn false\r\n"]
[3067.794603, "o", "}\r\n\r\n// FormatReport generates a human-readable comparison report.\r\nfunc FormatReport(cr *ComparisonResult) string {\r\n\tvar sb strings.Builder\r\n\tsb.WriteString(\"=== Comparison Report ===\\n\")\r\n\tsb.WriteString(fmt.Sprintf(\"Mode: %s\\n\", modeString(cr.Mode)))\r\n\tif cr.Mode == ModeTolerance {\r\n\t\tsb.WriteString(fmt.Sprintf(\"Absolute tolerance: %g\\n\", cr.Tolerance.Absolute))\r\n\t\tsb.WriteString(fmt.Sprintf(\"Relative tolerance: %g\\n\", cr.Tolerance.Relative))\r\n\t}\r\n"]
[3067.794673, "o", "\tsb.WriteString(fmt.Sprintf(\"Match: %v\\n\", cr.Match))\r\n\tsb.WriteString(fmt.Sprintf(\"Total pairs: %d\\n\", cr.TotalPairs))\r\n\tsb.WriteString(fmt.Sprintf(\"Matched: %d\\n\", cr.MatchedPairs))\r\n\tsb.WriteString(fmt.Sprintf(\"Summary: %s\\n\", cr.Summary))\r\n\r\n\tif len(cr.Mismatches) > 0 {\r\n\t\tsb.WriteString(\"\\nMismatches:\\n\")\r\n\t\tfor _, m := range cr.Mismatches {\r\n\t\t\tsb.WriteString(fmt.Sprintf(\"  [%d] %s: %.15e vs %.15e (abs=%.6e, rel=%.6e)\\n\",\r\n\t\t\t\tm.Index, m.Label, m.ValueA, m.ValueB, m.AbsDiff, m.RelDiff))\r\n\t\t}\r\n\t}\r\n"]
[3067.794734, "o", "\r\n\treturn sb.String()\r\n}\r\n\r\nfunc relDiff(a, b float64) float64 {\r\n\tdenom := math.Max(math.Abs(a), math.Abs(b))\r\n\tif denom < 1e-300 {\r\n\t\treturn 0\r\n\t}\r\n\treturn math.Abs(a-b) / denom\r\n}\r\n\r\nfunc modeString(m ComparisonMode) string {\r\n\tswitch m {\r\n\tcase ModeExact:\r\n\t\treturn \"exact\"\r\n"]
[3067.794795, "o", "\tcase ModeTolerance:\r\n\t\treturn \"tolerance\"\r\n\tdefault:\r\n\t\treturn \"unknown\"\r\n\t}\r\n}\r\n"]
