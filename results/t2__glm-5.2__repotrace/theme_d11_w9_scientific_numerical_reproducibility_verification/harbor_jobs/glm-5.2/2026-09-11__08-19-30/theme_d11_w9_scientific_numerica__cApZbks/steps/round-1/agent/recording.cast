[2821.802182, "o", "\u001b[?2004h"]
[2821.802233, "o", "> "]
[2821.802466, "o", "\\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n\u001b[?2004l\r"]
[2821.802557, "o", "\u001b[?2004h"]
