[4777.888811, "o", "   214\t\tfor _, line := range strings.Split(strings.TrimSpace(string(data)), \"\\n\") {\r\n   215\t\t\tif line == \"\" {\r\n   216\t\t\t\tcontinue\r\n   217\t\t\t}\r\n   218\t\t\tparts := strings.SplitN(line, \"|\", 3)\r\n   219\t\t\tif len(parts) != 3 {\r\n   220\t\t\t\tcontinue\r\n   221\t\t\t}\r\n   222\t\t\tts, _ := time.Parse(time.RFC3339, parts[2])\r\n"]
[4777.888874, "o", "   223\t\t\tentries = append(entries, IndexEntry{\r\n   224\t\t\t\tID:             parts[0],\r\n   225\t\t\t\tExperimentName: parts[1],\r\n   226\t\t\t\tTimestamp:      ts,\r\n   227\t\t\t})\r\n   228\t\t}\r\n   229\t\r\n   230\t\tsort.Slice(entries, func(i, j int) bool {\r\n"]
[4777.888929, "o", "   231\t\t\treturn entries[i].Timestamp.Before(entries[j].Timestamp)\r\n   232\t\t})\r\n   233\t\r\n   234\t\treturn entries, nil\r\n   235\t}\r\n"]
