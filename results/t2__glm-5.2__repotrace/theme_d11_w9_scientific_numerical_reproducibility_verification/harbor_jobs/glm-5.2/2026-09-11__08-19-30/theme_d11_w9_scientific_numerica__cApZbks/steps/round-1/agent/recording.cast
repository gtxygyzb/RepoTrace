[5081.726586, "o", "   549\t\t\tfmt.Println(string(data))\r\n   550\t\tcase \"csv\":\r\n   551\t\t\tfmt.Printf(\"# id: %s\\n\", result.ID)\r\n   552\t\t\tfmt.Printf(\"# experiment: %s\\n\", result.ExperimentName)\r\n"]
[5081.726643, "o", "   553\t\t\tfmt.Printf(\"# timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n   554\t\t\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n   555\t\t\t\tfmt.Printf(\"# seed: %s\\n\", seed)\r\n   556\t\t\t}\r\n   557\t\t\tfmt.Println(\"label,value\")\r\n   558\t\t\tfor i, v := range result.Values {\r\n   559\t\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n   560\t\t\t\tif i < len(result.Labels) {\r\n   561\t\t\t\t\tlabel = result.Labels[i]\r\n   562\t\t\t\t}\r\n   563\t\t\t\tfmt.Printf(\"%s,%.15e\\n\", label, v)\r\n"]
[5081.726703, "o", "   564\t\t\t}\r\n   565\t\tcase \"markdown\":\r\n   566\t\t\tfmt.Printf(\"# %s (%s)\\n\", result.ExperimentName, result.ID)\r\n   567\t\t\tfmt.Println()\r\n   568\t\t\tfmt.Println(\"## Metadata\")\r\n   569\t\t\tfmt.Printf(\"- timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n   570\t\t\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n   571\t\t\t\tfmt.Printf(\"- seed: %s\\n\", seed)\r\n   572\t\t"]
[5081.72678, "o", "\t} else {\r\n   573\t\t\t\tfmt.Println(\"- seed: \")\r\n   574\t\t\t}\r\n   575\t\t\tfmt.Printf(\"- go_version: %s\\n\", metadataOrDefault(result.Metadata, \"env_go_version\", \"unknown\"))\r\n   576\t\t\tfmt.Printf(\"- os: %s\\n\", metadataOrDefault(result.Metadata, \"env_os\", \"unknown\"))\r\n   577\t\t\tfmt.Printf(\"- arch: %s\\n\", metadataOrDefault(result.Metadata, \"env_arch\", \"unknown\"))\r\n   578\t\t\tfmt.Printf(\"- hostname: %s\\n\", metadataOrDefault(result.Metadata, \"env_hostname\", \"unknown\"))\r\n   579\t\t\tfmt.Println()\r\n   580\t\t\tfmt.Println(\"## Results\")\r\n   581\t\t\tfmt.Println(\"| Label | Value |\")"]
[5081.726842, "o", "\r\n   582\t\t\tfmt.Println(\"|---|---|\")\r\n   583\t\t\tfor i, v := range result.Values {\r\n   584\t\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n   585\t\t\t\tif i < len(result.Labels) {\r\n   586\t\t\t\t\tlabel = result.Labels[i]\r\n   587\t\t\t\t}\r\n   588\t\t\t\tfmt.Printf(\"| %s | %.15g |\\n\", label, v)\r\n   589\t\t\t}\r\n   590"]
[5081.727097, "o", "\t\tdefault:\r\n   591\t\t\tfmt.Fprintf(os.Stderr, \"unknown format: %s\\n\", format)\r\n   592\t\t\tos.Exit(1)\r\n   593\t\t}\r\n   594\t}\r\n   595\t\r\n"]
[5081.727207, "o", "   596\tfunc metadataOrDefault(metadata map[string]string, key, fallback string) string {\r\n   597\t\tif value, ok := metadata[key]; ok && value != \"\" {\r\n   598\t\t\treturn value\r\n   599\t\t}\r\n   600\t\treturn fallback\r\n   601\t}\r\n   602\t\r\n   603\tfunc cmdVerify(args []string) {\r\n   604\t\tif len(args) < 1 {\r\n   605\t\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\\n\")\r\n   606\t\t\tos.Exit(1)\r\n   607\t\t}\r\n   608\t\r\n   609\t\tid := args[0]\r\n   610\t\tstoreDir := \"./results\"\r\n   611\t\tverbose := false\r\n   612\t\r\n   613\t\tfor i := 1; i < len(args); i++ {\r\n   614\t\t\tswitch args[i] {\r\n   615\t\t\tcase \"--verbose\":\r\n   616\t\t\t\tverbose = true\r\n   617\t\t\tcase \"--store-dir\":\r\n   618\t\t\t\ti++\r\n   619\t\t\t\tif i >= len(args) {\r\n   620\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n   621\t\t\t\t\tos.Exit(1)\r\n   622\t\t\t\t}\r\n   623\t\t\t\tstoreDir = args[i]\r\n   624\t\t\tdefault:\r\n   625\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n"]
[5081.727306, "o", "   626\t\t\t\tos.Exit(1)\r\n   627\t\t\t}\r\n   628\t\t}\r\n   629\t\r\n   630"]
[5081.72737, "o", "\t\tstore, err := storage.NewStore(storeDir)\r\n   631\t\tif err != nil {\r\n   632\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   633\t\t\tos.Exit(1)\r\n   634\t\t}\r\n   635\t\r\n   636\t\tstatus, expected, computed, err := store.Verify(id)\r\n   637\t\tif err != nil {\r\n   638\t\t\tfmt.Fprintf(os.Stderr, \"verify error: %v\\n\", err)\r\n   639\t\t\tos.Exit(1)\r\n   640\t\t}\r\n   641\t\r\n   642\t\tswitch status {\r\n   643\t\tcase storage.StatusVerified:\r\n"]
[5081.72743, "o", "   644\t\t\tfmt.Printf(\"INTEGRITY_OK: %s\\n\", id)\r\n   645\t\t\tif verbose {\r\n   646\t\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n   647\t\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n   648\t\t\t}\r\n   649\t\t\tos.Exit(0)\r\n   650\t\tcase storage.StatusCorrupted:\r\n   651\t\t\tfmt.Printf(\"INTEGRITY_FAIL: %s\\n\", id)\r\n   652\t\t\tif verbose {\r\n"]
[5081.727504, "o", "   653\t\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n   654\t\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n   655\t\t\t}\r\n   656\t\t\tos.Exit(1)\r\n   657\t\tcase storage.StatusNoChecksum:\r\n   658\t\t\tfmt.Printf(\"NO_CHECKSUM: %s\\n\", id)\r\n   659\t\t\tos.Exit(2)\r\n"]
