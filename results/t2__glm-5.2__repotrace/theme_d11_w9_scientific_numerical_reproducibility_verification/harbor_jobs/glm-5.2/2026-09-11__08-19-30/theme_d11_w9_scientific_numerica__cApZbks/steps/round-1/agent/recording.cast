[5128.340553, "o", "\tresult.Metadata[\"values_checksum\"] = checksum\r\n\r\n\tstored := StoredResult{\r\n\t\tID:             id,\r\n\t\tExperimentName: result.ExperimentName,\r\n\t\tTimestamp:      result.Timestamp,\r\n"]
[5128.340668, "o", "\t\tParameters:     result.Parameters,\r\n\t\tValues:         result.Values,\r\n\t\tLabels:         result.Labels,\r\n\t\tMetadata:       result.Metadata,\r\n\t\tChecksum:       checksum,\r\n"]
[5128.340739, "o", "\t}\r\n\r\n\tdata, err := json.MarshalIndent(stored, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"marshal error: %w\", err)\r\n\t}\r\n\r\n\tresultDir := filepath.Join(s.BaseDir, result.ExperimentName)\r\n\tif err := os.MkdirAll(resultDir, 0755); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"cannot create result directory: %w\", err)\r\n\t}\r\n\r\n\tpath := filepath.Join(resultDir, id+\".json\")\r\n\tif err := os.WriteFile(path, data, 0644); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"write error: %w\", err)\r\n\t}\r\n\r\n\tif err := s.updateIndex(id, result.ExperimentName, result.Timestamp); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"index update error: %w\", err)\r\n\t}\r\n\r\n\treturn id, nil\r\n}\r\n\r\n"]
[5128.34082, "o", "// Load reads a stored result by ID.\r\nfunc (s *Store) Load(id string) (*StoredResult, error) {\r\n\tvar resultPath string\r\n\terr := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t\tif !info.IsDir() && strings.TrimSuffix(info.Name(), \".json\") == id {\r\n\t\t\tresultPath = path\r\n\t\t\treturn filepath.SkipAll\r\n\t\t}\r\n\t\treturn nil\r\n\t})\r\n"]
[5128.340861, "o", "\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif resultPath == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"result not found: %s\", id)\r\n"]
[5128.340964, "o", "\t}\r\n\r\n\tdata, err := os.ReadFile(resultPath)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"read error: %w\", err)\r\n\t}\r\n\r\n\tvar stored StoredResult\r\n\tif err := json.Unmarshal(data, &stored); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"unmarshal error: %w\", err)\r\n\t}\r\n\treturn &stored, nil\r\n}\r\n\r\n// ListResults returns all stored result IDs, optionally filtered by experiment name.\r\nfunc (s *Store) ListResults(experimentFilter string) ([]IndexEntry, error) {\r\n\tentries, err := s.readIndex()\r\n\tif err != nil {\r\n"]
[5128.341029, "o", "\t\treturn nil, err\r\n\t}\r\n\r\n\tif experimentFilter == \"\" {\r\n\t\treturn entries, nil\r\n\t}\r\n\r\n\tfiltered := make([]IndexEntry, 0)\r\n\tfor _, entry := range entries {\r\n\t\tif entry.ExperimentName == experimentFilter {\r\n\t\t\tfiltered = append(filtered, entry)\r\n\t\t}\r\n"]
[5128.341117, "o", "\t}\r\n\treturn filtered, nil\r\n}\r\n\r\n// Verify checks stored result integrity by recomputing the canonical checksum.\r\nfunc (s *Store) Verify(id string) (VerifyStatus, string, string, error) {\r\n\tstored, err := s.Load(id)\r\n\tif err != nil {\r\n\t\treturn \"\", \"\", \"\", err\r\n\t}\r\n\r\n\tif stored.Checksum == \"\" {\r\n\t\treturn StatusNoChecksum, \"\", \"\", nil\r\n\t}\r\n\r\n\tcomputed := ComputeChecksum(stored.Values)\r\n\tif computed == stored.Checksum {\r\n"]
[5128.341208, "o", "\t\treturn StatusVerified, stored.Checksum, computed, nil\r\n"]
