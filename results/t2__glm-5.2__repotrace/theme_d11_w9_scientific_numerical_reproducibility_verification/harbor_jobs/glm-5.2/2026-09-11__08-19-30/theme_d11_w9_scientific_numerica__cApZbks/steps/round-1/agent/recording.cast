[306.348607, "o", "    81\t\r\n    82\t// Load reads a stored result by ID.\r\n    83\tfunc (s *Store) Load(id string) (*StoredResult, error) {\r\n    84\t\t// Parse experiment name from ID\r\n    85\t\tparts := strings.SplitN(id, \"_\", 2)\r\n    86\t\tif len(parts) < 2 {\r\n    87\t\t\treturn nil, fmt.Errorf(\"invalid result ID: %s\", id)\r\n    88\t\t}\r\n    89\t\t// The experiment name may contain underscores, so we need to find the right file\r\n    90\t\tvar resultPath string\r\n    91\t\terr := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {\r\n    92\t\t\tif err != nil {\r\n"]
[306.348662, "o", "    93\t\t\t\treturn err\r\n    94\t\t\t}\r\n    95\t\t\tif !info.IsDir() && strings.TrimSuffix(info.Name(), \".json\") == id {\r\n    96\t\t\t\tresultPath = path\r\n    97\t\t\t\treturn filepath.SkipAll\r\n    98\t\t\t}\r\n"]
[306.34872, "o", "    99\t\t\treturn nil\r\n   100\t\t})\r\n   101\t\tif err != nil {\r\n   102\t\t\treturn nil, err\r\n   103\t\t}\r\n   104\t\tif resultPath == \"\" {\r\n   105\t\t\treturn nil, fmt.Errorf(\"result not found: %s\", id)\r\n   106\t\t}\r\n"]
