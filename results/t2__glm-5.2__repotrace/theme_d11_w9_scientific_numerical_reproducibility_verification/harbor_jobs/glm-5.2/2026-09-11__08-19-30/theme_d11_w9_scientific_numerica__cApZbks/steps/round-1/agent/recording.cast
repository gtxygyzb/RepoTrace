[289.801526, "o", "    10\t\t\"numeriforge/config\"\r\n    11\t\t\"numeriforge/engine\"\r\n    12\t\t\"numeriforge/storage\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc usage() {\r\n    16\t\tfmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform\r\n    17\t\r\n    18\tUsage:\r\n    19\t  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>]\r\n    20\t  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\r\n    21\t  numeriforge list [--experiment <name>] [--store-dir <dir>]\r\n    22\t  numeriforge export <result_id> --store-dir <dir> [--format json|csv]\r\n    23\t  numeriforge verify <result_id> --store-dir <dir>\r\n    24\t\r\n    25\tCommands:\r\n    26\t  run       Run an experiment and store the result\r\n    27\t  compare   Compare two stored results\r\n    28\t  list      List stored experiment results\r\n    29\t  export    Export a result to a different format\r\n    30\t  verify    Verify result integrity (TODO: not yet implemented)\r\n    31\t\r\n"]
