[3961.875453, "o", "\u001b[32m\u001b[K444\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K: %s\\n\", args[i])\r\n\u001b[32m\u001b[K462\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"\u001b[01;31m\u001b[Kjson\u001b[m\u001b[K\":\r\n\u001b[32m\u001b[K465\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tEnvironment:  environmentFrom\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K(result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K),\r\n\u001b[32m\u001b[K467\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tdata, err := \u001b[01;31m\u001b[Kjson\u001b[m\u001b[K.MarshalIndent(payload, \"\", \"  \")\r\n"]
