[299.16291, "o", "   130\t\tvar sb strings.Builder\r\n   131\t\tsb.WriteString(\"=== Comparison Report ===\\n\")\r\n   132\t\tsb.WriteString(fmt.Sprintf(\"Mode: %s\\n\", modeString(cr.Mode)))\r\n   133\t\tsb.WriteString(fmt.Sprintf(\"Match: %v\\n\", cr.Match))\r\n   134\t\tsb.WriteString(fmt.Sprintf(\"Total pairs: %d\\n\", cr.TotalPairs))\r\n   135\t\tsb.WriteString(fmt.Sprintf(\"Matched: %d\\n\", cr.MatchedPairs))\r\n   136\t\tsb.WriteString(fmt.Sprintf(\"Summary: %s\\n\", cr.Summary))\r\n   137\t\r\n"]
[299.162967, "o", "   138\t\tif len(cr.Mismatches) > 0 {\r\n   139\t\t\tsb.WriteString(\"\\nMismatches:\\n\")\r\n   140\t\t\tfor _, m := range cr.Mismatches {\r\n   141\t\t\t\tsb.WriteString(fmt.Sprintf(\"  [%d] %s: %.15e vs %.15e (abs=%.6e, rel=%.6e)\\n\",\r\n   142\t\t\t\t\tm.Index, m.Label, m.ValueA, m.ValueB, m.AbsDiff, m.RelDiff))\r\n   143\t\t\t}\r\n   144\t\t}\r\n   145\t\r\n   146\t\t"]
[299.163023, "o", "return sb.String()\r\n   147\t}\r\n   148\t\r\n   149\tfunc relDiff(a, b float64) float64 {\r\n   150\t\tdenom := math.Max(math.Abs(a), math.Abs(b))\r\n   151\t\tif denom < 1e-300 {\r\n   152\t\t\treturn 0\r\n   153\t\t}\r\n"]
[299.163082, "o", "   154\t\treturn math.Abs(a-b) / denom\r\n   155\t}\r\n   156\t\r\n   157\tfunc modeString(m ComparisonMode) string {\r\n   158\t\tswitch m {\r\n   159\t\tcase ModeExact:\r\n   160\t\t\treturn \"exact\"\r\n   161\t\tcase ModeTolerance:\r\n   162\t\t\treturn \"tolerance\"\r\n   163\t\tdefault:\r\n   164\t\t"]
