[4002.312144, "o", "   417\tfunc cmdExport(args []string) {\r\n   418\t\tif len(args) < 1 {\r\n   419\t\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge export <id> --store-dir <dir> [--format json|csv]\\n\")\r\n   420\t\t\tos.Exit(1)\r\n   421\t\t}\r\n   422\t\r\n   423\t\tid := args[0]\r\n   424"]
[4002.312241, "o", "\t\tstoreDir := \"./results\"\r\n   425\t\tformat := \"json\"\r\n   426\t\r\n   427\t\tfor i := 1; i < len(args); i++ {\r\n   428\t\t\tswitch args[i] {\r\n   429\t\t\tcase \"--store-dir\":\r\n   430\t\t\t\ti++\r\n   431\t\t\t\tif i >= len(args) {\r\n   432\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n   433\t\t\t\t\tos.Exit(1)\r\n   434\t\t\t\t}\r\n   435\t\t\t\tstoreDir = args[i]\r\n   436\t\t\tcase \"--format\":\r\n"]
[4002.312313, "o", "   437\t\t\t\ti++\r\n   438\t\t\t\tif i >= len(args) {\r\n   439\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --format requires a value\\n\")\r\n   440\t\t\t\t\tos.Exit(1)\r\n   441\t\t\t\t}\r\n   442\t\t\t\tformat = args[i]\r\n   443\t\t\tdefault:\r\n"]
[4002.312385, "o", "   444\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   445\t\t\t\tos.Exit(1)\r\n   446\t\t\t}\r\n   447\t\t}\r\n   448\t\r\n   449\t\tstore, err := storage.NewStore(storeDir)\r\n   450\t\tif err != nil {\r\n   451\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   452\t\t\tos.Exit(1)\r\n   453\t\t}\r\n   454\t\r\n   455\t\tresult, err := store.Load(id)\r\n"]
[4002.312456, "o", "   456\t\tif err != nil {\r\n   457\t\t\tfmt.Fprintf(os.Stderr, \"load error: %v\\n\", err)\r\n   458\t\t\tos.Exit(1)\r\n   459\t\t}\r\n   460\t\r\n   461\t\tswitch format {\r\n   462\t\tcase \"json\":\r\n   463\t\t\tpayload := exportPayload{\r\n   464\t\t\t\tStoredResult: result,\r\n   465\t\t\t\tEnvironment:  environmentFromMetadata(result.Metadata),\r\n   466\t\t\t}\r\n   467\t\t\tdata, err := json.MarshalIndent(payload, \"\", \"  \")\r\n"]
[4002.312536, "o", "   468\t\t\tif err != nil {\r\n   469\t\t\t\tfmt.Fprintf(os.Stderr, \"marshal error: %v\\n\", err)\r\n   470\t\t\t\tos.Exit(1)\r\n   471\t\t\t}\r\n   472\t\t\tfmt.Println(string(data))\r\n   473\t\tcase \"csv\":\r\n   474\t\t\tfmt.Printf(\"# id: %s\\n\", result.ID)\r\n   475\t\t\tfmt.Printf(\"# experiment: %s\\n\", result.ExperimentName)\r\n   476\t\t\tfmt.Printf(\"# timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n"]
[4002.312606, "o", "   477\t\t\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n   478\t\t\t\tfmt.Printf(\"# seed: %s\\n\", seed)\r\n   479\t\t\t}\r\n   480\t\t\tfmt.Println(\"label,value\")\r\n   481\t\t\tfor i, v := range result.Values {\r\n   482\t\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n   483\t\t\t\tif i < len(result.Labels) {\r\n   484\t\t\t\t\tlabel = result.Labels[i]\r\n   485\t\t\t\t}\r\n   486\t\t\t\tfmt.Printf(\"%s,%.15e\\n\", label, v)\r\n   487\t\t\t}\r\n"]
[4002.312697, "o", "   488\t\tdefault:\r\n   489\t\t\tfmt.Fprintf(os.Stderr, \"unknown format: %s\\n\", format)\r\n   490\t\t\tos.Exit(1)\r\n   491\t\t}\r\n   492\t}\r\n   493\t\r\n"]
