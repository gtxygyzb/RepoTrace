[4425.657459, "o", "\r\n\tif len(entries) == 0 {\r\n\t\tfmt.Println(\"No results found.\")\r\n\t\treturn\r\n\t}\r\n"]
[4425.657568, "o", "\r\n\tfmt.Printf(\"%-40s %-25s %s\\n\", \"ID\", \"Experiment\", \"Timestamp\")\r\n\tfmt.Println(strings.Repeat(\"-\", 80))\r\n\tfor _, entry := range entries {\r\n\t\tfmt.Printf(\"%-40s %-25s %s\\n\", entry.ID, entry.ExperimentName, entry.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n\t}\r\n}\r\n\r\nfunc cmdExport(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge export <id> --store-dir <dir> [--format json|csv]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid := args[0]\r\n"]
[4425.657659, "o", "\tstoreDir := \"./results\"\r\n\tformat := \"json\"\r\n\r\n\tfor i := 1; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--store-dir\":\r\n\t\t"]
[4425.65774, "o", "\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tcase \"--format\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --format requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tformat = args[i]\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n"]
[4425.65782, "o", "\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tresult, err := store.Load(id)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"load error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch format {\r\n\tcase \"json\":\r\n\t\tpayload := exportPayload{\r\n\t\t"]
[4425.657918, "o", "\tStoredResult: result,\r\n\t\t\tEnvironment:  environmentFromMetadata(result.Metadata),\r\n\t\t\tTags:         tagsFromMetadata(result.Metadata),\r\n\t\t}\r\n\t\tdata, err := json.MarshalIndent(payload, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"marshal error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(string(data))\r\n\tcase \"csv\":\r\n\t\tfmt.Printf(\"# id: %s\\n\", result.ID)\r\n\t\tfmt.Printf(\"# experiment: %s\\n\", result.ExperimentName)\r\n\t\tfmt.Printf(\"# timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n"]
[4425.65799, "o", "\t\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n\t\t\tfmt.Printf(\"# seed: %s\\n\", seed)\r\n\t\t}\r\n\t\tfmt.Println(\"label,value\")\r\n\t\tfor i, v := range result.Values {\r\n\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n\t\t\tif i < len(result.Labels) {\r\n\t\t\t\tlabel = result.Labels[i]\r\n\t\t\t}\r\n\t\t\tfmt.Printf(\"%s,%.15e\\n\", label, v)\r\n\t\t}\r\n"]
[4425.658063, "o", "\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown format: %s\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc cmdVerify(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid := args[0]\r\n"]
[4425.658139, "o", "\tstoreDir := \"./results\"\r\n\tverbose := false\r\n\r\n\tfor i := 1; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--verbose\":\r\n\t\t\tverbose = true\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\t"]
[4425.658217, "o", "fmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[4425.658292, "o", "\tstatus, expected, computed, err := store.Verify(id)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"verify error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[4425.658367, "o", "\tswitch status {\r\n\tcase storage.StatusVerified:\r\n\t\tfmt.Printf(\"INTEGRITY_OK: %s\\n\", id)\r\n\t\tif verbose {\r\n\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n\t\t}\r\n\t\tos.Exit(0)\r\n\tcase storage.StatusCorrupted:\r\n\t\tfmt.Printf(\"INTEGRITY_FAIL: %s\\n\", id)\r\n\t\tif verbose {\r\n\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n\t\t}\r\n\t\tos.Exit(1)\r\n\tcase storage.StatusNoChecksum:\r\n\t\tfmt.Printf(\"NO_CHECKSUM: %s\\n\", id)\r\n\t\tos.Exit(2)\r\n"]
[4425.658439, "o", "\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown verification status: %s\\n\", status)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\nfunc cmdAudit(args []string) {\r\n\tall := false\r\n\tvar positionals []string\r\n\tstoreDir := \"./results\"\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--all\":\r\n"]
[4425.658524, "o", "\t\t\tall = true\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tdefault:\r\n\t\t\tif strings.HasPrefix(args[i], \"-\") {\r\n"]
[4425.658599, "o", "\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tpositionals = append(positionals, args[i])\r\n\t\t}\r\n\t}\r\n\r\n\tif all {\r\n\t\tif len(positionals) != 0 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: --all does not accept result IDs\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
[4425.658673, "o", "\t\tcmdAuditAll(storeDir)\r\n\t\treturn\r\n\t}\r\n\r\n\tif len(positionals) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge audit <result_id> --store-dir <dir>\\n\")\r\n\t\tfmt.Fprintf(os.Stderr, \"       numeriforge audit --all --store-dir <dir>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif len(positionals) > 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: too many arguments\\n\")\r\n"]
[4425.658749, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tpassed, details := auditStoredResult(store, positionals[0])\r\n\tfmt.Print(details)\r\n\tif !passed {\r\n\t\tos.Exit(1)\r\n\t}"]
[4425.658816, "o", "\r\n}\r\n\r\nfunc cmdAuditAll(storeDir string) {\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := store.ListResults(\"\")\r\n\tif err != nil {\r\n\t\t"]
[4425.658884, "o", "fmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tpassed := 0\r\n\tfailed := 0\r\n\ttotal := len(entries)\r\n\tfor _, entry := range entries {\r\n\t\tok, details := auditStoredResult(store, entry.ID)\r\n\t\tfmt.Print(details)\r\n\t\tif ok {\r\n\t\t\tpassed++\r\n"]
[4425.658956, "o", "\t\t} else {\r\n\t\t\tfailed++\r\n\t\t}\r\n\t}\r\n\r\n\tfmt.Printf(\"Audit Summary: %d passed, %d failed out of %d total\\n\", passed, failed, total)\r\n\tif failed > 0 {\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc auditStoredResult(store *storage.Store, id string) (bool, string) {\r\n\tstored, err := store.Load(id)"]
[4425.659028, "o", "\r\n\tif err != nil {\r\n\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: load error: %v)\\n\", id, err)\r\n\t}\r\n\r\n\twarnEnvMismatch(stored)\r\n\r\n\tstatus, expected, computed, err := store.Verify(id)\r\n\tif err != nil {\r\n\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: integrity check error: %v)\\n\", id, err)\r\n\t}\r\n\tif status == storage.StatusNoChecksum {\r\n\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: integrity check failed: no checksum)\\n\", id)\r\n\t}\r\n"]
[4425.659101, "o", "\tif status == storage.StatusCorrupted {\r\n\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: integrity check failed: expected=%s computed=%s)\\n\", id, expected, computed)\r\n\t}\r\n\r\n\tseedStr, ok := stored.Metadata[\"seed\"]\r\n\tif !ok {\r\n\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: missing seed in metadata)\\n\", id)\r\n\t}\r\n\tseed, err := strconv.ParseInt(seedStr, 10, 64)\r\n\tif err != nil {\r\n\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\\n\", id, err)\r\n\t}\r\n\r\n"]
[4425.659175, "o", "\tfn, err := engine.Get(stored.ExperimentName)\r\n\tif err != nil {\r\n\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n\t}\r\n\r\n\trng := engine.NewRNG(seed)\r\n\treexec, err := fn(stored.ExperimentName, stored.Parameters, rng)\r\n"]
[4425.659254, "o", "\tif err != nil {\r\n\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n\t}\r\n\r\n\tmaxLen := len(stored.Values)\r\n\tif len(reexec.Values) > maxLen {\r\n\t\tmaxLen = len(reexec.Values)\r\n\t}\r\n\r\n\tvar mismatches []string\r\n\tfor i := 0; i < maxLen; i++ {\r\n\t\tstoredMissing := i >= len(stored.Values)\r\n\t\treexecMissing := i >= len(reexec.Values)\r\n\r\n\t\tvar storedVal, reexecVal string\r\n\t\tif storedMissing {\r\n\t\t\tstoredVal = \"<missing>\"\r\n\t\t} else {\r\n\t\t\tstoredVal = strconv.FormatFloat(stored.Values[i], 'g', -1, 64)\r\n"]
[4425.659328, "o", "\t\t}\r\n\t\tif reexecMissing {\r\n\t\t\treexecVal = \"<missing>\"\r\n\t\t} else {\r\n\t\t\treexecVal = strconv.FormatFloat(reexec.Values[i], 'g', -1, 64)\r\n\t\t}\r\n\r\n\t\tif storedMissing || reexecMissing || math.Float64bits(stored.Values[i]) != math.Float64bits(reexec.Values[i]) {\r\n\t\t\tmismatches = append(mismatches, fmt.Sprintf(\"  value[%d]: stored=%s, re-executed=%s\", i, storedVal, reexecVal))\r\n\t\t}\r\n"]
[4425.659398, "o", "\t}\r\n\r\n\tif len(mismatches) == 0 {\r\n\t\treturn true, fmt.Sprintf(\"AUDIT_PASS: %s\\n\", id)\r\n\t}\r\n\r\n\tvar sb strings.Builder\r\n\tsb.WriteString(fmt.Sprintf(\"AUDIT_FAIL: %s\\n\", id))\r\n\tfor _, m := range mismatches {\r\n\t\tsb.WriteString(m)\r\n\t\tsb.WriteByte('\\n')\r\n\t}\r\n\treturn false, sb.String()\r\n"]
[4425.659467, "o", "}\r\n\r\nfunc warnEnvMismatch(stored *storage.StoredResult) {\r\n\tmsg, ok := envMismatchWarning(stored.Metadata)\r\n\tif ok {\r\n\t\tfmt.Fprintln(os.Stderr, msg)\r\n\t}\r\n}\r\n\r\nfunc envMismatchWarning(metadata map[string]string) (string, bool) {\r\n\tcurrent := environmentMetadata()\r\n\tfields := []string{\"env_go_version\", \"env_os\", \"env_arch\", \"env_hostname\"}\r\n\r\n"]
[4425.659553, "o", "\tvar diffs []string\r\n\tfor _, field := range fields {\r\n\t\tif metadata[field] != current[field] {\r\n\t\t\tdiffs = append(diffs, fmt.Sprintf(\"%s stored=%q current=%q\", field, metadata[field], current[field]))\r\n\t\t}\r\n\t}\r\n\r\n\tif len(diffs) == 0 {\r\n\t\treturn \"\", false\r\n"]
