[4660.813979, "o", "\tswitch format {\r\n\tcase \"json\":\r\n\t\tpayload := exportPayload{\r\n\t\t\tStoredResult: result,\r\n\t\t\tEnvironment:  environmentFromMetadata(result.Metadata),\r\n"]
[4660.814076, "o", "\t\t\tTags:         tagsFromMetadata(result.Metadata),\r\n\t\t}\r\n\t\tdata, err := json.MarshalIndent(payload, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"marshal error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(string(data))\r\n\tcase \"csv\":\r\n\t\tfmt.Printf(\"# id: %s\\n\", result.ID)\r\n\t\tfmt.Printf(\"# experiment: %s\\n\", result.ExperimentName)\r\n\t\tfmt.Printf(\"# timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n\t\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n"]
[4660.814173, "o", "\t\t\tfmt.Printf(\"# seed: %s\\n\", seed)\r\n\t\t}\r\n\t\tfmt.Println(\"label,value\")\r\n\t\tfor i, v := range result.Values {\r\n\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n\t\t\tif i < len(result.Labels) {\r\n\t\t\t\tlabel = result.Labels[i]\r\n\t\t\t}\r\n\t\t\tfmt.Printf(\"%s,%.15e\\n\", label, v)\r\n\t\t}\r\n\tcase \"markdown\":\r\n\t\tfmt.Printf(\"# %s (%s)\\n\", result.ExperimentName, result.ID)\r\n\t\tfmt.Println()\r\n\t\tfmt.Println(\"## Metadata\")\r\n\t\tfmt.Printf(\"- timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n\t"]
[4660.814269, "o", "\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n\t\t\tfmt.Printf(\"- seed: %s\\n\", seed)\r\n\t\t} else {\r\n\t\t\tfmt.Println(\"- seed: \")\r\n\t\t}\r\n\t\tfmt.Printf(\"- go_version: %s\\n\", metadataOrDefault(result.Metadata, \"env_go_version\", \"unknown\"))\r\n\t\tfmt.Printf(\"- os: %s\\n\", metadataOrDefault(result.Metadata, \"env_os\", \"unknown\"))\r\n\t\tfmt.Printf(\"- arch: %s\\n\", metadataOrDefault(result.Metadata, \"env_arch\", \"unknown\"))\r\n\t\tfmt.Printf(\"- hostname: %s\\n\", metadataOrDefault(result.Metadata, \"env_hostname\", \"unknown\"))\r\n\t\tfmt.Println()\r\n\t\tfmt.Println(\"## Results\")\r\n\t\tfmt.Println(\"| Label | Value |\")\r\n"]
[4660.81436, "o", "\t\tfmt.Println(\"|---|---|\")\r\n\t\tfor i, v := range result.Values {\r\n\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n\t\t\tif i < len(result.Labels) {\r\n\t\t\t\tlabel = result.Labels[i]\r\n\t\t\t}\r\n\t\t\tfmt.Printf(\"| %s | %.15g |\\n\", label, v)\r\n\t\t}\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown format: %s\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n"]
[4660.814412, "o", "\r\nfunc metadataOrDefault(metadata map[string]string, key, fallback string) string {\r\n\tif value, ok := metadata[key]; ok && value != \"\" {\r\n\t\treturn value\r\n\t}\r\n\treturn fallback\r\n"]
