[3948.018456, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"math\"\r\n     7\t\t\"os\"\r\n     8\t\t\"runtime\"\r\n     9\t\t\"strconv\"\r\n"]
[3948.018589, "o", "    10\t\t\"strings\"\r\n    11\t\t\"time\"\r\n    12\t\r\n    13\t\t\"numeriforge/compare\"\r\n    14\t\t\"numeriforge/config\"\r\n    15\t\t\"numeriforge/engine\"\r\n    16\t\t\"numeriforge/storage\"\r\n    17\t)\r\n    18\t\r\n    19\tfunc usage() {\r\n    20\t\tfmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform\r\n    21\t\r\n    22\tUsage:\r\n    23\t  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]\r\n    24\t  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\r\n    25\t"]
[3948.018668, "o", "  numeriforge list [--experiment <name>] [--store-dir <dir>]\r\n    26\t  numeriforge export <result_id> --store-dir <dir> [--format json|csv]\r\n    27\t  numeriforge verify <result_id> --store-dir <dir> [--verbose]\r\n    28\t  numeriforge audit <result_id> --store-dir <dir>\r\n    29\t  numeriforge audit --all --store-dir <dir>\r\n    30\t\r\n    31\tCommands:\r\n    32\t  run       Run an experiment and store the result\r\n    33\t  compare   Compare two stored results\r\n"]
[3948.018735, "o", "    34\t  list      List stored experiment results\r\n    35\t  export    Export a result to a different format\r\n    36\t  verify    Verify result integrity\r\n    37\t  audit     Audit stored result(s) for reproducibility\r\n    38\t\r\n    39\tAvailable experiments:\r\n    40\t`)\r\n    41\t\tfor _, name := range engine.List() {\r\n    42\t\t\tfmt.Fprintf(os.Stderr, \"  %s\\n\", name)\r\n    43\t\t}\r\n"]
[3948.018804, "o", "    44\t}\r\n    45\t\r\n    46\tfunc main() {\r\n    47\t\tif len(os.Args) < 2 {\r\n    48\t\t\tusage()\r\n    49\t"]
[3948.018869, "o", "\t\tos.Exit(1)\r\n    50\t\t}\r\n    51\t\r\n    52\t\tcmd := os.Args[1]\r\n    53\t\r\n    54\t\tswitch cmd {\r\n    55\t\tcase \"run\":\r\n    56\t\t\tcmdRun(os.Args[2:])\r\n    57\t\tcase \"compare\":\r\n    58\t\t\tcmdCompare(os.Args[2:])\r\n    59\t\tcase \"list\":\r\n    60\t\t\tcmdList(os.Args[2:])\r\n    61\t\tcase \"export\":\r\n    62\t\t\tcmdExport(os.Args[2:])\r\n"]
[3948.018939, "o", "    63\t\tcase \"verify\":\r\n    64\t\t\tcmdVerify(os.Args[2:])\r\n    65\t\tcase \"audit\":\r\n    66\t\t\tcmdAudit(os.Args[2:])\r\n    67\t\tcase \"help\", \"--help\", \"-h\":\r\n    68\t\t\tusage()\r\n    69\t\tdefault:\r\n    70\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n    71\t\t"]
[3948.019023, "o", "\tusage()\r\n    72\t\t\tos.Exit(1)\r\n    73\t\t}\r\n    74\t}\r\n    75\t\r\n    76\t// environmentMetadata returns the environment fingerprint metadata required for\r\n    77\t// reproducible experiment traces.\r\n    78\t"]
[3948.019087, "o", "func environmentMetadata() map[string]string {\r\n    79\t\thostname, err := os.Hostname()\r\n    80\t\tif err != nil {\r\n    81\t\t\thostname = \"unknown\"\r\n"]
[3948.019155, "o", "    82\t\t}\r\n    83\t\treturn map[string]string{\r\n    84\t\t\t\"env_go_version\": runtime.Version(),\r\n    85\t\t\t\"env_os\":         runtime.GOOS,\r\n    86\t\t\t\"env_arch\":       runtime.GOARCH,\r\n    87\t\t\t\"env_hostname\":   hostname,\r\n    88\t\t}\r\n    89\t}\r\n    90\t\r\n    91\t// environmentFromMetadata aggregates stored environment fingerprint metadata\r\n    92\t// into an export-friendly object.\r\n    93\ttype environmentInfo struct {\r\n    94\t\tGoVersion string `json:\"go_version\"`\r\n    95\t\tOS        string `json:\"os\"`\r\n    96\t\t"]
[3948.019224, "o", "Arch      string `json:\"arch\"`\r\n    97\t\tHostname  string `json:\"hostname\"`\r\n    98\t}\r\n    99\t\r\n   100\tfunc environmentFromMetadata(metadata map[string]string) environmentInfo {\r\n   101\t\treturn environmentInfo{\r\n   102\t\t\tGoVersion: metadata[\"env_go_version\"],\r\n   103\t\t\tOS:        metadata[\"env_os\"],\r\n   104\t\t\tArch:      metadata[\"env_arch\"],\r\n   105\t\t\tHostname:  metadata[\"env_hostname\"],\r\n   106\t\t}\r\n   107\t}\r\n"]
