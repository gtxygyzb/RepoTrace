[3919.12125, "o", "root@n30009:/app# "]
[3919.382741, "i", "sed -n '1,220p' main.go\n"]
[3919.382995, "o", "sed -n '1,220p' main.go\r\n"]
[3919.383112, "o", "\u001b[?2004l\r"]
[3919.385937, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[3919.386014, "o", "\t\"math\"\r\n\t\"os\"\r\n\t\"runtime\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"numeriforge/compare\"\r\n\t\"numeriforge/config\"\r\n\t\"numeriforge/engine\"\r\n\t\"numeriforge/storage\"\r\n)\r\n\r\nfunc usage() {\r\n"]
[3919.386078, "o", "\tfmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform\r\n\r\nUsage:\r\n  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]\r\n  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\r\n  numeriforge list [--experiment <name>] [--store-dir <dir>]\r\n  numeriforge export <result_id> --store-dir <dir> [--format json|csv]\r\n  numeriforge verify <result_id> --store-dir <dir> [--verbose]\r\n  numeriforge audit <result_id> --store-dir <dir>\r\n"]
[3919.386152, "o", "  numeriforge audit --all --store-dir <dir>\r\n\r\nCommands:\r\n  run       Run an experiment and store the result\r\n  compare   Compare two stored results\r\n  list      List stored experiment results\r\n  export    Export a result to a different format\r\n  verify    Verify result integrity\r\n  audit     Audit stored result(s) for reproducibility\r\n\r\n"]
[3919.386214, "o", "Available experiments:\r\n`)\r\n\tfor _, name := range engine.List() {\r\n\t\tfmt.Fprintf(os.Stderr, \"  %s\\n\", name)\r\n\t}\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tusage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(os.Args[2:])\r\n"]
[3919.386274, "o", "\tcase \"compare\":\r\n\t\tcmdCompare(os.Args[2:])\r\n\tcase \"list\":\r\n\t\tcmdList(os.Args[2:])\r\n\tcase \"export\":\r\n\t\tcmdExport(os.Args[2:])\r\n\tcase \"verify\":\r\n\t\tcmdVerify(os.Args[2:])\r\n\tcase \"audit\":\r\n\t\tcmdAudit(os.Args[2:])\r\n"]
[3919.386341, "o", "\tcase \"help\", \"--help\", \"-h\":\r\n\t\tusage()\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\t\tusage()\r\n"]
[3919.386404, "o", "\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\n// environmentMetadata returns the environment fingerprint metadata required for\r\n// reproducible experiment traces.\r\nfunc environmentMetadata() map[string]string {\r\n\thostname, err := os.Hostname()\r\n\tif err != nil {\r\n\t\thostname = \"unknown\"\r\n\t}\r\n\treturn map[string]string{\r\n\t\t\"env_go_version\": runtime.Version(),\r\n\t\t\"env_os\":         runtime.GOOS,\r\n\t\t\"env_arch\":       runtime.GOARCH,\r\n\t\t\"env_hostname\":   hostname,\r\n\t"]
[3919.386532, "o", "}\r\n}\r\n\r\n// environmentFromMetadata aggregates stored environment fingerprint metadata\r\n// into an export-friendly object.\r\ntype environmentInfo struct {\r\n\tGoVersion string `json:\"go_version\"`\r\n\tOS        string `json:\"os\"`\r\n\tArch      string `json:\"arch\"`\r\n\tHostname  string `json:\"hostname\"`\r\n}\r\n\r\nfunc environmentFromMetadata(metadata map[string]string) environmentInfo {\r\n\treturn environmentInfo{\r\n\t\tGoVersion: metadata[\"env_go_version\"],\r\n\t\tOS:        metadata[\"env_os\"],\r\n\t\tArch:      metadata[\"env_arch\"],\r\n\t\tHostname:  metadata[\"env_hostname\"],\r\n\t}\r\n"]
[3919.386596, "o", "}\r\n\r\ntype exportPayload struct {\r\n\t*storage.StoredResult\r\n\tEnvironment environmentInfo `json:\"environment\"`\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n\tvar experimentName, outputDir, configPath string\r\n\tvar paramStrs []string\r\n\tvar seed int64\r\n\tseedProvided := false\r\n"]
[3919.386666, "o", "\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--experiment\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t"]
[3919.386723, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\texperimentName = args[i]\r\n\t\tcase \"--output-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --output-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\toutputDir = args[i]\r\n\t\tcase \"--config\":\r\n"]
[3919.38678, "o", "\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --config requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tconfigPath = args[i]\r\n\t\tcase \"--param\":\r\n\t\t\ti++\r\n"]
[3919.386839, "o", "\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --param requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tparamStrs = append(paramStrs, args[i])\r\n\t\tcase \"--seed\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n"]
[3919.386897, "o", "\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --seed requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tparsed, err := strconv.ParseInt(args[i], 10, 64)\r\n\t\t\tif err != nil {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid seed: %v\\n\", err)\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tseed = parsed\r\n"]
[3919.386953, "o", "\t\t\tseedProvided = true\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\r\n\tif configPath != \"\" {\r\n\t"]
[3919.38701, "o", "\tcfg, err := config.ParseINI(configPath)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"config error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tif experimentName == \"\" {\r\n\t\t\texperimentName = cfg.Experiment\r\n\t\t}\r\n\t\tif outputDir == \"\" {\r\n"]
[3919.387067, "o", "\t\t\toutputDir = cfg.OutputDir\r\n\t\t}\r\n\r\n\t\tcliParams, _ := config.ParseParams(paramStrs)\r\n\t\tcliParamMap := make(map[string]float64)\r\n\t\tfor _, p := range cliParams {\r\n\t\t\tcliParamMap[p.Name] = p.Value\r\n\t\t}\r\n\t\tfor _, p := range cfg.Params {\r\n"]
[3919.387122, "o", "\t\t\tif _, exists := cliParamMap[p.Name]; !exists {\r\n\t\t\t\tcliParams = append(cliParams, p)\r\n\t\t\t}\r\n\t\t}\r\n\t\tparamStrs = nil\r\n\t\tfor _, p := range cliParams {\r\n\t\t\tparamStrs = append(paramStrs, fmt.Sprintf(\"%s=%g\", p.Name, p.Value))\r\n\t\t}\r\n"]
[3919.387178, "o", "\t}\r\n\r\n\tif experimentName == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: --experiment is required\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif outputDir == \"\" {\r\n\t\toutputDir = \"./results\"\r\n\t}\r\n\r\n"]
[3919.387235, "o", "\tparams, err := config.ParseParams(paramStrs)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"parameter error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfn, err := engine.Get(experimentName)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[3919.387291, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif !seedProvided {\r\n\t\tseed = time.Now().UnixNano()\r\n\t}\r\n"]
[3919.387892, "o", "\u001b[?2004h"]
[3919.387949, "o", "root@n30009:/app# "]
[3919.665602, "i", "sed -n '220,520p' main.go\n"]
[3919.665861, "o", "sed -n '220,520p' main.go\r\n\u001b[?2004l\r"]
[3919.668937, "o", "\t}\r\n\r\n\trng := engine.NewRNG(seed)\r\n\r\n\tresult, err := fn(experimentName, params, rng)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"experiment error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[3919.669024, "o", "\tif result.Metadata == nil {\r\n\t\tresult.Metadata = map[string]string{}\r\n\t}\r\n\tif _, ok := result.Metadata[\"seed\"]; !ok {\r\n\t\tresult.Metadata[\"seed\"] = strconv.FormatInt(seed, 10)\r\n\t}\r\n\tif seedProvided {\r\n\t\tresult.Metadata[\"seed_source\"] = \"provided\"\r\n\t} else {\r\n\t\tresult.Metadata[\"seed_source\"] = \"auto-generated\"\r\n\t}\r\n\r\n\tfor k, v := range environmentMetadata() {\r\n\t\tresult.Metadata[k] = v\r\n\t}\r\n"]
[3919.669129, "o", "\r\n\tstore, err := storage.NewStore(outputDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid, err := store.Save(result)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"save error: %v\\n\", err)\r\n"]
[3919.669192, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfmt.Printf(\"Experiment: %s\\n\", experimentName)\r\n\tfmt.Printf(\"Result ID: %s\\n\", id)\r\n\tfmt.Printf(\"Values:\\n\")\r\n\tfor i, v := range result.Values {\r\n\t\tlabel := fmt.Sprintf(\"[%d]\", i)\r\n\t\tif i < len(result.Labels) {\r\n\t\t\tlabel = result.Labels[i]\r\n\t\t}\r\n\t\tfmt.Printf(\"  %s = %.15e\\n\", label, v)\r\n\t}\r\n}\r\n\r\nfunc cmdCompare(args []string) {\r\n\tif len(args) < 2 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\\n\")\r\n\t\tos.Exit(1)\r\n"]
[3919.669254, "o", "\t}\r\n\r\n\tid1 := args[0]\r\n\tid2 := args[1]\r\n\tstoreDir := \"./results\"\r\n\tmode := \"exact\"\r\n\ttol := compare.DefaultTolerance()\r\n\r\n\tfor i := 2; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n"]
[3919.669314, "o", "\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tcase \"--mode\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\t"]
[3919.669374, "o", "fmt.Fprintf(os.Stderr, \"error: --mode requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tmode = args[i]\r\n\t\tcase \"--abs-tol\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --abs-tol requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}"]
[3919.669429, "o", "\r\n\t\t\tv, err := strconv.ParseFloat(args[i], 64)\r\n\t\t\tif err != nil {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid absolute tolerance: %v\\n\", err)\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ttol.Absolute = v\r\n"]
[3919.669514, "o", "\t\tcase \"--rel-tol\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --rel-tol requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tv, err := strconv.ParseFloat(args[i], 64)\r\n\t\t\tif err != nil {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid relative tolerance: %v\\n\", err)\r\n\t\t\t\tos.Exit(1)\r\n"]
