[3974.231267, "o", "   158\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid seed: %v\\n\", err)\r\n   159\t\t\t\t\tos.Exit(1)\r\n   160\t\t\t\t}\r\n   161\t\t\t\tseed = parsed\r\n   162\t\t\t\tseedProvided = true\r\n   163\t\t\tdefault:\r\n   164\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   165\t\t\t\tos.Exit(1)\r\n   166\t"]
[3974.231329, "o", "\t\t}\r\n   167\t\t}\r\n   168\t\r\n   169\t\tif configPath != \"\" {\r\n   170\t\t\tcfg, err := config.ParseINI(configPath)\r\n   171\t\t\tif err != nil {\r\n   172\t\t\t\tfmt.Fprintf(os.Stderr, \"config error: %v\\n\", err)\r\n   173\t\t\t\tos.Exit(1)\r\n"]
[3974.2314, "o", "   174\t\t\t}\r\n   175\t\t\tif experimentName == \"\" {\r\n   176\t\t\t\texperimentName = cfg.Experiment\r\n   177\t\t"]
[3974.231469, "o", "\t}\r\n   178\t\t\tif outputDir == \"\" {\r\n   179\t\t\t\toutputDir = cfg.OutputDir\r\n   180\t\t\t}\r\n   181\t\r\n   182\t\t\tcliParams, _ := config.ParseParams(paramStrs)\r\n   183\t\t\tcliParamMap := make(map[string]float64)\r\n   184\t\t\tfor _, p := range cliParams {\r\n   185\t\t\t\tcliParamMap[p.Name] = p.Value\r\n   186\t\t\t}\r\n   187\t\t\tfor _, p := range cfg.Params {\r\n"]
[3974.231565, "o", "   188\t\t\t\tif _, exists := cliParamMap[p.Name]; !exists {\r\n   189\t\t\t\t\tcliParams = append(cliParams, p)\r\n   190\t\t\t\t}\r\n   191\t\t\t}\r\n   192\t\t\tparamStrs = nil\r\n   193\t\t\tfor _, p := range cliParams {\r\n   194\t\t\t\tparamStrs = append(paramStrs, fmt.Sprintf(\"%s=%g\", p.Name, p.Value))\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197\t\r\n   198\t\t"]
[3974.231635, "o", "if experimentName == \"\" {\r\n   199\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment is required\\n\")\r\n   200\t\t\tos.Exit(1)\r\n   201\t\t}\r\n   202\t\tif outputDir == \"\" {\r\n   203\t\t\toutputDir = \"./results\"\r\n   204\t\t}\r\n   205\t\r\n   206\t\tparams, err := config.ParseParams(paramStrs)\r\n"]
[3974.231695, "o", "   207\t\tif err != nil {\r\n   208\t\t\tfmt.Fprintf(os.Stderr, \"parameter error: %v\\n\", err)\r\n   209\t\t\tos.Exit(1)\r\n   210\t\t}\r\n   211\t\r\n   212\t\tfn, err := engine.Get(experimentName)\r\n   213\t\tif err != nil {\r\n   214\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n"]
[3974.231762, "o", "   215\t\t\tos.Exit(1)\r\n   216\t\t}\r\n   217\t\r\n   218\t\tif !seedProvided {\r\n   219\t\t\tseed = time.Now().UnixNano()\r\n   220\t\t}\r\n   221\t\r\n   222\t\trng := engine.NewRNG(seed)\r\n   223\t\r\n   224\t\tresult, err := fn(experimentName, params, rng)\r\n   225\t\tif err != nil {\r\n"]
[3974.231829, "o", "   226\t\t\tfmt.Fprintf(os.Stderr, \"experiment error: %v\\n\", err)\r\n   227\t\t\tos.Exit(1)\r\n   228\t\t}\r\n   229\t\r\n   230\t\tif result.Metadata == nil {\r\n   231\t\t\tresult.Metadata = map[string]string{}\r\n   232\t\t}\r\n   233\t\tif _, ok := result.Metadata[\"seed\"]; !ok {\r\n   234\t\t\tresult.Metadata[\"seed\"] = strconv.FormatInt(seed, 10)\r\n"]
[3974.231894, "o", "   235\t\t}\r\n   236\t\tif seedProvided {\r\n   237\t\t\tresult.Metadata[\"seed_source\"] = \"provided\"\r\n   238\t\t} else {\r\n   239\t\t\tresult.Metadata[\"seed_source\"] = \"auto-generated\"\r\n   240\t\t}\r\n   241\t\r\n   242\t\tfor k, v := range environmentMetadata() {\r\n   243\t\t"]
