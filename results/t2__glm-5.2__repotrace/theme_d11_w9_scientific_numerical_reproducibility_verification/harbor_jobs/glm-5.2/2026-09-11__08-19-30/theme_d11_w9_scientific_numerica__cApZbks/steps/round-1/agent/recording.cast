[4432.72029, "o", "     1\tpackage engine\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"math/rand\"\r\n     6\t\t\"time\"\r\n     7\t)\r\n     8\t\r\n"]
[4432.720427, "o", "     9\t// ExperimentType enumerates supported experiment categories.\r\n    10\ttype ExperimentType string\r\n    11\t\r\n    12\tconst (\r\n    13\t\tTypeMonteCarlo ExperimentType = \"montecarlo\"\r\n    14\t\tTypeMatrix     ExperimentType = \"matrix\"\r\n    15\t\tTypeODE        ExperimentType = \"ode\"\r\n    16\t\tTypeStats      ExperimentType = \"stats\"\r\n    17\t)\r\n    18\t\r\n    19\t// Parameter holds a single experiment parameter.\r\n    20\ttype Parameter struct {\r\n    21\t\tName  string\r\n    22\t\tValue float64\r\n    23\t}\r\n    24\t\r\n    25\t// Result holds raw experiment output.\r\n    26\ttype Result struct {\r\n    27\t\tExperimentName string\r\n"]
[4432.720561, "o", "    28\t\tTimestamp      time.Time\r\n    29\t\tParameters     []Parameter\r\n    30\t\tValues         []float64\r\n    31\t\tLabels         []string\r\n    32\t\tMetadata       map[string]string\r\n    33\t}\r\n    34\t\r\n    35\t// ExperimentFunc is the signature for all experiment backends.\r\n    36\t// It takes a name, parameters, and returns a Result or error.\r\n    37\ttype ExperimentFunc func(name string, params []Parameter, rng RNG) (*Result, error)\r\n    38\t\r\n    39\t// Global registry of experiment backends.\r\n    40\tvar registry = map[string]ExperimentFunc{}\r\n    41\t\r\n    42\t// RNG is an isolated random number generator type for experiment backends.\r\n    43\ttype RNG = *rand.Rand\r\n    44\t\r\n    45\t// NewRNG creates an isolated random source for a single experiment invocation.\r\n    46\tfunc NewRNG(seed int64) RNG {"]
[4432.720638, "o", "\r\n    47\t\treturn rand.New(rand.NewSource(seed))\r\n    48\t}\r\n    49\t\r\n    50\t// Register adds an experiment backend to the registry.\r\n    51\tfunc Register(name string, fn ExperimentFunc) {\r\n    52\t\tregistry[name] = fn\r\n    53\t}\r\n    54\t\r\n    55\t// Get retrieves an experiment backend by name.\r\n    56\tfunc Get(name string) (ExperimentFunc, error) {\r\n"]
[4432.720718, "o", "    57\t\tfn, ok := registry[name]\r\n    58\t\tif !ok {\r\n    59\t\t\treturn nil, fmt.Errorf(\"unknown experiment: %s\", name)\r\n    60\t\t}\r\n    61\t\treturn fn, nil\r\n    62\t}\r\n    63\t\r\n    64\t// List returns all registered experiment names.\r\n    65\tfunc List() []string {\r\n    66\t\tnames := make([]string, 0, len(registry))\r\n    67\t\tfor k := range registry {\r\n"]
[4432.720795, "o", "    68\t\t\tnames = append(names, k)\r\n    69\t\t}\r\n    70\t\treturn names\r\n    71\t}\r\n    72\t\r\n    73\t// GetParam finds a parameter by name, returning its value and whether it was found.\r\n    74\tfunc GetParam(params []Parameter, name string) (float64, bool) {\r\n    75\t\tfor _, p := range params {\r\n    76\t\t\tif p.Name == name {\r\n    77\t\t\t\treturn p.Value, true\r\n    78\t\t\t}\r\n    79\t\t}"]
[4432.720865, "o", "\r\n    80\t\treturn 0, false\r\n    81\t}\r\n    82\t\r\n    83\t// RequireParam finds a parameter by name or returns an error.\r\n    84\tfunc RequireParam(params []Parameter, name string) (float64, error) {\r\n    85\t\tv, ok := GetParam(params, name)\r\n    86\t\tif !ok {\r\n    87\t\t\treturn 0, fmt.Errorf(\"missing required parameter: %s\", name)\r\n    88\t\t}\r\n"]
[4432.720931, "o", "    89\t\treturn v, nil\r\n    90\t}\r\n    91\t\r\n    92\tfunc init() {\r\n    93\t\tregisterMonteCarloExperiments()\r\n    94\t\tregisterMatrixExperiments()\r\n    95\t\tregisterODEExperiments()\r\n    96\t\tregisterStatsExperiments()\r\n    97\t}\r\n"]
