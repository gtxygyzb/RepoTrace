[5082.00146, "o", "   118\t\terr := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {\r\n   119\t\t\tif err != nil {\r\n   120\t\t\t\treturn err\r\n   121\t\t\t}\r\n   122\t\t\tif !info.IsDir() && strings.TrimSuffix(info.Name(), \".json\") == id {\r\n   123\t\t\t\tresultPath = path\r\n   124\t\t\t\treturn filepath.SkipAll\r\n   125\t\t\t}\r\n"]
[5082.001559, "o", "   126\t\t\treturn nil\r\n   127\t\t})\r\n   128\t\tif err != nil {\r\n   129\t\t\treturn nil, err\r\n   130\t\t}\r\n   131\t\tif resultPath == \"\" {\r\n"]
[5082.001617, "o", "   132\t\t\treturn nil, fmt.Errorf(\"result not found: %s\", id)\r\n   133\t\t}\r\n   134\t\r\n   135\t\tdata, err := os.ReadFile(resultPath)\r\n   136\t\tif err != nil {\r\n   137\t\t\treturn nil, fmt.Errorf(\"read error: %w\", err)\r\n   138\t\t}\r\n   139\t\r\n   140\t"]
