[3832.09565, "o", "\u001b[?2004h> "]
[3832.096383, "o", "s = s.replace('reason: integrity check failed expected=%s computed=%s', 'reason: integrity check failed: expected=%s computed=%s')\r\n\u001b[?2004l\r"]
[3832.09646, "o", "\u001b[?2004h> "]
[3832.096557, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
