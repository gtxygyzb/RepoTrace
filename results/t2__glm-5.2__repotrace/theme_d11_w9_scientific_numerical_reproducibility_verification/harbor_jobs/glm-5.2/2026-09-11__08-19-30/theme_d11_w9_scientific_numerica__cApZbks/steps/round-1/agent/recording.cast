[5214.057382, "o", "   851\tfunc warnEnvMismatch(stored *storage.StoredResult) {\r\n   852\t\tmsg, ok := envMismatchWarning(stored.Metadata)\r\n   853\t\tif ok {\r\n   854\t\t\tfmt.Fprintln(os.Stderr, msg)\r\n   855\t\t}\r\n"]
[5214.057421, "o", "   856\t}\r\n   857\t\r\n   858\tfunc envMismatchWarning(metadata map[string]string) (string, bool) {\r\n   859\t\tcurrent := environmentMetadata()\r\n   860\t\tfields := []string{\"env_go_version\", \"env_os\", \"env_arch\", \"env_hostname\"}\r\n   861\t\r\n"]
[5214.057623, "o", "   862\t\tvar diffs []string\r\n   863\t\tfor _, field := range fields {\r\n   864\t\t\tif metadata[field] != current[field] {\r\n   865\t\t\t\tdiffs = append(diffs, fmt.Sprintf(\"%s stored=%q current=%q\", field, metadata[field], current[field]))\r\n   866\t\t\t}\r\n   867\t\t}\r\n   868\t\r\n   869\t\tif len(diffs) == 0 {\r\n   870\t\t\treturn \"\", false\r\n   871\t\t}\r\n   872\t\treturn fmt.Sprintf(\"WARNING: ENV_MISMATCH (%s)\", strings.Join(diffs, \", \")), true\r\n   873\t}\r\n"]
