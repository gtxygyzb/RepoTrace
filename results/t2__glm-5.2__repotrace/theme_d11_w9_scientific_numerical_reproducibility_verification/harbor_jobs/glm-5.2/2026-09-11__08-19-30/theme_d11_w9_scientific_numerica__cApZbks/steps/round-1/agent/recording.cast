[4467.769251, "o", "   614\t\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n   615\t\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n   616\t\t\t}\r\n   617\t\t\tos.Exit(0)\r\n   618\t\tcase storage.StatusCorrupted:\r\n   619\t\t\tfmt.Printf(\"INTEGRITY_FAIL: %s\\n\", id)\r\n   620\t\t\tif verbose {\r\n   621\t\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n   622\t\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n   623\t\t\t}\r\n   624\t\t\tos.Exit(1)\r\n   625\t\tcase storage.StatusNoChecksum:\r\n   626\t\t\tfmt.Printf(\"NO_CHECKSUM: %s\\n\", id)\r\n   627\t\t\tos.Exit(2)\r\n   628\t\tdefault:\r\n   629"]
[4467.76936, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"unknown verification status: %s\\n\", status)\r\n   630\t\t\tos.Exit(1)\r\n   631\t\t}\r\n   632\t}\r\n   633\tfunc cmdAudit(args []string) {\r\n   634\t\tall := false\r\n   635\t\tvar positionals []string\r\n   636\t\tstoreDir := \"./results\"\r\n   637\t\r\n   638\t\tfor i := 0; i < len(args); i++ {\r\n   639\t\t\tswitch args[i] {\r\n   640\t\t\tcase \"--all\":\r\n"]
