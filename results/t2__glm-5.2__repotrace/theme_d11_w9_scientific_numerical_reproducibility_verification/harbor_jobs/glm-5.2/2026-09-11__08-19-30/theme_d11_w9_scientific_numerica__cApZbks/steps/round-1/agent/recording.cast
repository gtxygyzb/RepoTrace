[5130.000767, "o", "\t\tfmt.Println(\"## Results\")\r\n\t\tfmt.Println(\"| Label | Value |\")\r\n\t\tfmt.Println(\"|---|---|\")\r\n\t\tfor i, v := range result.Values {\r\n\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n"]
[5130.000803, "o", "\t\t\tif i < len(result.Labels) {\r\n\t\t\t\tlabel = result.Labels[i]\r\n\t\t\t}\r\n\t\t\tfmt.Printf(\"| %s | %.15g |\\n\", label, v)\r\n\t\t}\r\n"]
[5130.000902, "o", "\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown format: %s\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc metadataOrDefault(metadata map[string]string, key, fallback string) string {\r\n\tif value, ok := metadata[key]; ok && value != \"\" {\r\n\t\treturn value\r\n\t}\r\n\treturn fallback\r\n}\r\n\r\nfunc cmdVerify(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\\n\")\r\n"]
[5130.00098, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid := args[0]\r\n\tstoreDir := \"./results\"\r\n\tverbose := false\r\n\r\n\tfor i := 1; i < len(args); i++ {\r\n\t"]
[5130.001043, "o", "\tswitch args[i] {\r\n\t\tcase \"--verbose\":\r\n\t\t\tverbose = true\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\tos.Exit(1)\r\n"]
[5130.001107, "o", "\t\t}\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tstatus, expected, computed, err := store.Verify(id)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"verify error: %v\\n\", err)\r\n\t\t"]
[5130.001166, "o", "os.Exit(1)\r\n\t}\r\n\r\n\tswitch status {\r\n\tcase storage.StatusVerified:\r\n\t\tfmt.Printf(\"INTEGRITY_OK: %s\\n\", id)\r\n\t\tif verbose {\r\n\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n\t\t}\r\n"]
[5130.001225, "o", "\t\tos.Exit(0)\r\n\tcase storage.StatusCorrupted:\r\n\t\tfmt.Printf(\"INTEGRITY_FAIL: %s\\n\", id)\r\n\t\tif verbose {\r\n\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n\t\t}\r\n\t\tos.Exit(1)\r\n\tcase storage.StatusNoChecksum:\r\n"]
[5130.00128, "o", "\t\tfmt.Printf(\"NO_CHECKSUM: %s\\n\", id)\r\n\t\tos.Exit(2)\r\n\tdefault:\r\n"]
