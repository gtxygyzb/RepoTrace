[5113.808582, "o", "\t}\r\n\ttags := map[string]string{}\r\n\tfor k, v := range metadata {\r\n\t\tif strings.HasPrefix(k, \"tag_\") {\r\n\t\t\ttags[k[len(\"tag_\"):]] = v\r\n\t\t}\r\n\t}\r\n\tif len(tags) == 0 {\r\n"]
[5113.808722, "o", "\t\treturn nil\r\n\t}\r\n\treturn tags\r\n}\r\n\r\n// parseTagFlag parses a --tag key=value argument and returns the metadata key\r\n// and value. It prints an error and exits when the argument is malformed.\r\nfunc parseTagFlag(arg string) (string, string) {\r\n\tparts := strings.SplitN(arg, \"=\", 2)\r\n\tif len(parts) != 2 || parts[0] == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid tag, expected key=value: %s\\n\", arg)\r\n\t\tos.Exit(1)\r\n\t}\r\n\treturn \"tag_\" + parts[0], parts[1]\r\n}\r\n\r\n// hasMatchingTags reports whether metadata contains all requested tag filters.\r\nfunc hasMatchingTags(metadata map[string]string, tags map[string]string) bool {\r\n\tfor k, v := range tags {\r\n\t\tif metadata[\"tag_\"+k] != v {\r\n\t\t\treturn false\r\n\t\t}\r\n"]
[5113.808841, "o", "\t}\r\n\treturn true\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n"]
[5113.808915, "o", "\tvar experimentName, outputDir, configPath string\r\n\tvar paramStrs []string\r\n\tvar tagStrs []string\r\n\tvar seed int64\r\n\tseedProvided := false\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--experiment\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\texperimentName = args[i]\r\n\t\tcase \"--output-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --output-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\toutputDir = args[i]\r\n\t\tcase \"--config\":\r\n\t\t\ti++\r\n\t"]
[5113.808977, "o", "\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --config requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tconfigPath = args[i]\r\n\t\tcase \"--param\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --param requires a value\\n\")\r\n\t\t"]
[5113.809096, "o", "\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tparamStrs = append(paramStrs, args[i])\r\n\t\tcase \"--seed\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --seed requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tparsed, err := strconv.ParseInt(args[i], 10, 64)\r\n\t\t\tif err != nil {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid seed: %v\\n\", err)\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tseed = parsed\r\n\t\t\tseedProvided = true\r\n\t\t"]
[5113.809165, "o", "case \"--tag\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --tag requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\ttagStrs = append(tagStrs, args[i])\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
[5113.809223, "o", "\t}\r\n\r\n\tif configPath != \"\" {\r\n\t\tcfg, err := config.ParseINI(configPath)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"config error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
[5113.809283, "o", "\t\tif experimentName == \"\" {\r\n\t\t\texperimentName = cfg.Experiment\r\n\t\t}\r\n\t\tif outputDir == \"\" {\r\n\t\t\toutputDir = cfg.OutputDir\r\n\t\t}\r\n\r\n\t\tcliParams, _ := config.ParseParams(paramStrs)\r\n\t\tcliParamMap := make(map[string]float64)\r\n\t"]
[5113.809344, "o", "\tfor _, p := range cliParams {\r\n\t\t\tcliParamMap[p.Name] = p.Value\r\n\t\t}\r\n\t\tfor _, p := range cfg.Params {\r\n\t\t\tif _, exists := cliParamMap[p.Name]; !exists {\r\n\t\t\t\tcliParams = append(cliParams, p)\r\n\t\t\t}\r\n\t\t}\r\n\t\tparamStrs = nil\r\n"]
[5113.809402, "o", "\t\tfor _, p := range cliParams {\r\n\t\t\tparamStrs = append(paramStrs, fmt.Sprintf(\"%s=%g\", p.Name, p.Value))\r\n\t\t}\r\n\t}\r\n\r\n\tif experimentName == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: --experiment is required\\n\")\r\n\t\tos.Exit(1)\r\n"]
[5113.809463, "o", "\t}\r\n\tif outputDir == \"\" {\r\n\t\toutputDir = \"./results\"\r\n\t}\r\n\r\n\tparams, err := config.ParseParams(paramStrs)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"parameter error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[5113.809541, "o", "\r\n\tfn, err := engine.Get(experimentName)\r\n"]
