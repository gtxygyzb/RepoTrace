[5413.635285, "o", "\u001b[?2004h> "]
[5413.635412, "o", "                fmt.Println(\"  none\")\r\n\u001b[?2004l\r"]
[5413.635469, "o", "\u001b[?2004h> "]
[5413.635536, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5413.635593, "o", "> "]
[5413.635736, "o", "                for _, key := range envKeys {\r\n\u001b[?2004l\r"]
[5413.635792, "o", "\u001b[?2004h> "]
