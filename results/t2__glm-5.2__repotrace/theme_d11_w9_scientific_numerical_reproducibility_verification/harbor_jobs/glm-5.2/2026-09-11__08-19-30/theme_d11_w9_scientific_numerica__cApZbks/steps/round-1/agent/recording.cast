[283.450366, "o", "nl -ba config/config.go | sed -n '1,220p'\r\n\u001b[?2004l\r"]
[283.453842, "o", "     1\tpackage config\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n"]
[283.453925, "o", "     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"strconv\"\r\n     8\t\t\"strings\"\r\n     9\t\r\n    10\t\t\"numeriforge/engine\"\r\n    11\t)\r\n    12\t\r\n    13\t// Config represents parsed experiment configuration.\r\n    14\ttype Config struct {\r\n    15\t\tExperiment string\r\n    16\t\tOutputDir  string\r\n    17\t\tParams     []engine.Parameter\r\n    18\t\tRaw        map[string]string"]
[283.453996, "o", "\r\n    19\t}\r\n    20\t\r\n    21\t// ParseINI reads a simple INI-style configuration file.\r\n    22\t// Format:\r\n    23\t//   experiment = mc-estimate-pi\r\n    24\t//   output_dir = ./results\r\n    25\t//   param.samples = 100000\r\n    26\t//   param.lower_bound = 0.0\r\n    27\tfunc ParseINI(path string) (*Config, error) {\r\n    28\t\tf, err := os.Open(path)\r\n    29\t\tif err != nil {"]
[283.454064, "o", "\r\n    30\t\t\treturn nil, fmt.Errorf(\"cannot open config: %w\", err)\r\n    31\t\t}\r\n    32\t\tdefer f.Close()\r\n    33\t\r\n    34\t\tcfg := &Config{\r\n    35\t\t\tRaw: make(map[string]string),\r\n    36\t\t}\r\n    37\t\r\n    38\t\tscanner := bufio.NewScanner(f)\r\n    39\t"]
[283.454124, "o", "\tfor scanner.Scan() {\r\n    40\t\t\tline := strings.TrimSpace(scanner.Text())\r\n    41\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") || strings.HasPrefix(line, \";\") {\r\n    42\t\t\t\tcontinue\r\n    43\t\t\t}\r\n    44\t\r\n    45\t\t\tparts := strings.SplitN(line, \"=\", 2)\r\n"]
[283.454183, "o", "    46\t\t\tif len(parts) != 2 {\r\n    47\t\t\t\tcontinue\r\n    48\t\t\t}\r\n    49\t\r\n    50\t\t\tkey := strings.TrimSpace(parts[0])\r\n    51\t\t\tvalue := strings.TrimSpace(parts[1])\r\n    52\t\t\tcfg.Raw[key] = value\r\n    53\t\r\n    54\t\t\tswitch key {\r\n"]
[283.454248, "o", "    55\t\t\tcase \"experiment\":\r\n    56\t\t\t\tcfg.Experiment = value\r\n    57\t\t\tcase \"output_dir\":\r\n    58\t\t\t\tcfg.OutputDir = value\r\n    59\t\t\tdefault:\r\n    60\t\t\t\tif strings.HasPrefix(key, \"param.\") {\r\n    61\t\t\t\t\tparamName := strings.TrimPrefix(key, \"param.\")\r\n    62\t\t\t\t\tparamValue, err := strconv.ParseFloat(value, 64)\r\n    63\t\t\t\t\tif err != nil {\r\n"]
[283.454315, "o", "    64\t\t\t\t\t\treturn nil, fmt.Errorf(\"invalid parameter value for %s: %s\", paramName, value)\r\n    65\t\t\t\t\t}\r\n    66\t\t\t\t\tcfg.Params = append(cfg.Params, engine.Parameter{\r\n    67\t\t\t\t\t\tName:  paramName,\r\n    68\t\t\t\t\t\tValue: paramValue,\r\n    69\t\t\t\t\t})\r\n    70\t\t\t\t}\r\n    71\t\t\t}\r\n    72\t\t}\r\n"]
[283.454378, "o", "    73\t\r\n    74\t\tif err := scanner.Err(); err != nil {\r\n    75\t\t\treturn nil, fmt.Errorf(\"read error: %w\", err)\r\n    76\t\t}\r\n    77\t\r\n    78\t\tif cfg.Experiment == \"\" {\r\n    79\t\t\treturn nil, fmt.Errorf(\"missing required field: experiment\")\r\n    80\t\t"]
[283.454443, "o", "}\r\n    81\t\tif cfg.OutputDir == \"\" {\r\n    82\t\t\tcfg.OutputDir = \"./results\"\r\n    83\t\t}\r\n    84\t\r\n    85\t"]
[283.454585, "o", "\treturn cfg, nil\r\n    86\t}\r\n    87\t\r\n    88\t// ParseParams converts a param string slice (key=value pairs) into Parameters.\r\n    89\tfunc ParseParams(raw []string) ([]engine.Parameter, error) {\r\n    90\t\tvar params []engine.Parameter\r\n    91\t\tfor _, kv := range raw {\r\n    92\t\t\tparts := strings.SplitN(kv, \"=\", 2)\r\n    93\t\t\tif len(parts) != 2 {\r\n    94\t\t\t\treturn nil, fmt.Errorf(\"invalid parameter: %s (expected key=value)\", kv)\r\n    95\t\t\t}\r\n    96\t\t\tval, err := strconv.ParseFloat(parts[1], 64)\r\n    97\t\t\tif err != nil {\r\n    98\t\t\t\treturn nil, fmt.Errorf(\"invalid parameter value for %s: %s\", parts[0], parts[1])\r\n    99\t\t\t}\r\n   100\t\t\tparams = append(params, engine.Parameter{Name: parts[0], Value: val})\r\n   101\t\t}\r\n   102\t\treturn params, nil\r\n   103\t}\r\n"]
[283.455059, "o", "\u001b[?2004h"]
