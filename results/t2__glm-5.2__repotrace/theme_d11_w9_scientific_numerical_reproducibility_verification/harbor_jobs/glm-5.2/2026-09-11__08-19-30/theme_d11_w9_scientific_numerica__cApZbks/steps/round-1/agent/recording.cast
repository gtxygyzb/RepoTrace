[2925.301501, "o", "func cmdAudit(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge audit <result_id> --store-dir <dir>\\n\")\r\n\t"]
[2925.301575, "o", "\tos.Exit(1)\r\n\t}\r\n\r\n\tid := args[0]\r\n\tstoreDir := \"./results\"\r\n\r\n\tfor i := 1; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n"]
[2925.301651, "o", "\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n"]
[2925.301719, "o", "\t}\r\n\r\n\tstored, err := store.Load(id)\r\n\tif err != nil {\r\n\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: load error: %v)\\n\", id, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[2925.301782, "o", "\r\n\tstatus, expected, computed, err := store.Verify(id)\r\n\tif err != nil {\r\n\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: checksum verification error: %v)\\n\", id, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif status == storage.StatusNoChecksum {\r\n\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: checksum missing)\\n\", id)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif status == storage.StatusCorrupted {\r\n\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: checksum mismatch expected=%s computed=%s)\\n\", id, expected, computed)\r\n\t\tos.Exit(1)\r\n"]
[2925.301848, "o", "\t}\r\n\r\n\tseedStr, ok := stored.Metadata[\"seed\"]\r\n\tif !ok {\r\n\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: missing seed in metadata)\\n\", id)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tseed, err := strconv.ParseInt(seedStr, 10, 64)\r\n\tif err != nil {\r\n\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\\n\", id, err)\r\n"]
[2925.301916, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfn, err := engine.Get(stored.ExperimentName)\r\n\tif err != nil {\r\n\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\trng := engine.NewRNG(seed)\r\n\treexec, err := fn(stored.ExperimentName, stored.Parameters, rng)\r\n\tif err != nil {\r\n"]
[2925.301974, "o", "\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tmaxLen := len(stored.Values)\r\n\tif len(reexec.Values) > maxLen {\r\n\t\tmaxLen = len(reexec.Values)\r\n\t}\r\n"]
[2925.302037, "o", "\r\n\tvar mismatches []string\r\n\tfor i := 0; i < maxLen; i++ {\r\n\t\tstoredMissing := i >= len(stored.Values)\r\n\t\treexecMissing := i >= len(reexec.Values)\r\n\r\n\t\tvar storedVal, reexecVal string\r\n\t\tif storedMissing {\r\n\t\t\tstoredVal = \"<missing>\"\r\n\t\t} else {\r\n"]
[2925.302099, "o", "\t\t\tstoredVal = strconv.FormatFloat(stored.Values[i], 'g', -1, 64)\r\n\t\t}\r\n\t\tif reexecMissing {\r\n\t\t\treexecVal = \"<missing>\"\r\n\t\t} else {\r\n\t\t\treexecVal = strconv.FormatFloat(reexec.Values[i], 'g', -1, 64)\r\n\t\t}\r\n\r\n\t\tif storedMissing || reexecMissing || math.Float64bits(stored.Values[i]) != math.Float64bits(reexec.Values[i]) {\r\n"]
[2925.302161, "o", "\t\t\tmismatches = append(mismatches, fmt.Sprintf(\"  value[%d]: stored=%s, re-executed=%s\", i, storedVal, reexecVal))\r\n\t\t}\r\n\t}\r\n\r\n\tif len(mismatches) == 0 {\r\n\t\tfmt.Printf(\"AUDIT_PASS: %s\\n\", id)\r\n\t\tos.Exit(0)\r\n\t}\r\n\r\n\tfmt.Printf(\"AUDIT_FAIL: %s\\n\", id)\r\n\tfor _, m := range mismatches {\r\n\t\tfmt.Println(m)\r\n"]
[2925.302215, "o", "\t}\r\n\tos.Exit(1)\r\n}\r\n"]
[2925.302696, "o", "\u001b[?2004h"]
[2925.302755, "o", "root@n30009:/app# "]
