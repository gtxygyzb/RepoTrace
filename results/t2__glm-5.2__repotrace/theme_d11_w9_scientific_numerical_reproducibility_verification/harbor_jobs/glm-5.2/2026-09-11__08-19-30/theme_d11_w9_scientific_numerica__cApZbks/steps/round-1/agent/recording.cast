[4209.95453, "o", "    82\t\ttEnd, err := RequireParam(params, \"t_end\")\r\n    83\t\tif err != nil {\r\n    84\t\t\treturn nil, err\r\n    85\t\t}\r\n    86\t\tstepsF, err := RequireParam(params, \"steps\")\r\n    87\t\tif err != nil {\r\n    88\t\t\treturn nil, err\r\n    89\t\t}\r\n    90\t\r\n    91\t\tsysIdx := int(sysIdxF)\r\n    92\t\tsteps := int(stepsF)\r\n    93\t\r\n    94\t\tsysNames := []string{\"exponential_decay\", \"harmonic_oscillator\", \"lorenz\", \"van_der_pol\", \"stiff_decay\"}\r\n    95\t\tif sysIdx < 0 || sysIdx >= len(sysNames) {\r\n    96\t\t\treturn nil, fmt.Errorf(\"system_index must be 0-%d, got %d\", len(sysNames)-1, sysIdx)\r\n    97\t\t}\r\n    98\t\r\n    99\t\tsys := odeSystems[sysNames[sysIdx]]\r\n   100\t\tdt := tEnd / float64(steps)\r\n   101\t\r\n   102\t\ty := make([]float64, len(sys.Y0))\r\n   103\t"]
[4209.95465, "o", "\tcopy(y, sys.Y0)\r\n   104\t\tt := 0.0\r\n   105\t\r\n   106\t\t// Store trajectory at regular intervals\r\n   107\t\tstoreInterval := steps / 20\r\n   108\t\tif storeInterval < 1 {\r\n   109\t\t\tstoreInterval = 1\r\n   110\t\t}\r\n   111\t\r\n   112\t\tallValues := []float64{}\r\n   113\t\tallLabels := []string{}\r\n   114\t\r\n   115\t\tfor step := 0; step <= steps; step++ {\r\n   116\t\t\tif step%storeInterval == 0 || step == steps {\r\n   117\t\t\t\tallValues = append(allValues, t)\r\n   118\t\t\t\tallLabels = append(allLabels, fmt.Sprintf(\"t_%d\", step))\r\n"]
