[2821.806646, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2821.806807, "o", "\\tfor i := 1; i < len(args); i++ {\r\n\u001b[?2004l\r"]
[2821.806863, "o", "\u001b[?2004h> "]
[2821.806961, "o", "\\t\\tswitch args[i] {\r\n\u001b[?2004l\r"]
[2821.807015, "o", "\u001b[?2004h> "]
