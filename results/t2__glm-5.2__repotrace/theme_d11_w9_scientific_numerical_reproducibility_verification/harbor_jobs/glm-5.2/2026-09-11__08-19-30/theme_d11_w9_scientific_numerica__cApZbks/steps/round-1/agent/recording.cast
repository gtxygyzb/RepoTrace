[282.903723, "o", "     8\t\t\"sort\"\r\n     9\t\t\"strings\"\r\n    10\t\t\"time\"\r\n    11\t\r\n    12\t\t\"numeriforge/engine\"\r\n    13\t)\r\n    14\t\r\n    15\t// StoredResult is the on-disk representation of an experiment result.\r\n    16\ttype StoredResult struct {\r\n    17\t\tID             string            `json:\"id\"`\r\n    18\t\tExperimentName string            `json:\"experiment_name\"`\r\n    19\t\tTimestamp      time.Time         `json:\"timestamp\"`\r\n    20\t\tParameters     []engine.Parameter `json:\"parameters\"`\r\n    21\t\t"]
[282.903897, "o", "Values         []float64         `json:\"values\"`\r\n    22\t\tLabels         []string          `json:\"labels\"`\r\n    23\t\tMetadata       map[string]string `json:\"metadata\"`\r\n    24\t\t// TODO: Add Checksum field for result integrity verification.\r\n    25\t\t// The checksum should be a SHA-256 hash of the canonical representation\r\n    26\t\t// of the Values array.\r\n    27\t}\r\n    28\t\r\n    29\t// Store manages experiment result persistence.\r\n    30\ttype Store struct {\r\n    31\t\tBaseDir string\r\n    32\t}\r\n    33\t\r\n    34\t// NewStore creates a store at the given directory.\r\n    35\tfunc NewStore(baseDir string) (*Store, error) {\r\n    36\t\tif err := os.MkdirAll(baseDir, 0755); err != nil {\r\n    37\t\t\treturn nil, fmt.Errorf(\"cannot create store directory: %w\", err)\r\n    38\t\t}\r\n    39\t\treturn &Store{BaseDir: baseDir}, nil\r\n    40\t}\r\n    41\t\r\n    42\t// Save persists an experiment result to disk.\r\n    43\tfunc (s *Store) Save(result *engine.Result) (string, error) {\r\n    44\t\tid := fmt.Sprintf(\"%s_%s\", result.ExperimentName, result.Timest"]
[282.90398, "o", "amp.Format(\"20060102_150405\"))\r\n    45\t\r\n    46\t\tstored := StoredResult{\r\n    47\t\t\tID:             id,\r\n    48\t\t\tExperimentName: result.ExperimentName,\r\n    49\t\t\tTimestamp:      result.Timestamp,\r\n    50\t\t\tParameters:     result.Parameters,\r\n    51\t\t\tValues:         result.Values,\r\n    52\t\t\tLabels:         result.Labels,\r\n    53\t\t\tMetadata:       result.Metadata,\r\n    54\t\t}\r\n    55\t\r\n"]
[282.904043, "o", "    56\t\t// TODO: Compute and store checksum here.\r\n    57\t\t// Should hash the canonical representation of Values.\r\n    58\t\r\n    59\t\tdata, err := json.MarshalIndent(stored, \"\", \"  \")\r\n    60\t\tif err != nil {\r\n    61\t\t\treturn \"\", fmt.Errorf(\"marshal error: %w\", err)\r\n    62\t\t}\r\n    63\t\r\n    64\t"]
[282.904102, "o", "\tresultDir := filepath.Join(s.BaseDir, result.ExperimentName)\r\n    65\t\tif err := os.MkdirAll(resultDir, 0755); err != nil {\r\n    66\t\t\treturn \"\", fmt.Errorf(\"cannot create result directory: %w\", err)\r\n    67\t\t}\r\n    68\t\r\n    69\t\tpath := filepath.Join(resultDir, id+\".json\")\r\n    70\t\tif err := os.WriteFile(path, data, 0644); err != nil {\r\n"]
[282.90418, "o", "    71\t\t\treturn \"\", fmt.Errorf(\"write error: %w\", err)\r\n    72\t\t}\r\n    73\t\r\n    74\t\t// Update index\r\n    75\t\tif err := s.updateIndex(id, result.ExperimentName, result.Timestamp); err != nil {\r\n    76\t\t\treturn \"\", fmt.Errorf(\"index update error: %w\", err)\r\n    77\t\t}\r\n    78\t\r\n    79\t\treturn id, nil\r\n    80\t}\r\n    81\t\r\n"]
[282.90425, "o", "    82\t// Load reads a stored result by ID.\r\n    83\tfunc (s *Store) Load(id string) (*StoredResult, error) {\r\n    84\t\t// Parse experiment name from ID\r\n    85\t\tparts := strings.SplitN(id, \"_\", 2)\r\n    86\t\tif len(parts) < 2 {\r\n    87\t\t\treturn nil, fmt.Errorf(\"invalid result ID: %s\", id)\r\n    88\t\t}\r\n    89\t\t// The experiment name may contain underscores, so we need to find the right file\r\n    90\t\tvar resultPath string\r\n"]
[282.904307, "o", "    91\t\terr := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {\r\n    92\t\t\tif err != nil {\r\n    93\t\t\t\treturn err\r\n    94\t\t\t}\r\n    95\t\t\tif !info.IsDir() && strings.TrimSuffix(info.Name(), \".json\") == id {\r\n    96\t\t\t\tresultPath = path\r\n    97\t\t\t\treturn filepath.SkipAll\r\n"]
[282.904363, "o", "    98\t\t\t}\r\n    99\t\t\treturn nil\r\n   100\t\t})\r\n   101\t\tif err != nil {\r\n   102\t\t\treturn nil, err\r\n   103\t\t}\r\n   104\t\tif resultPath == \"\" {\r\n"]
[282.90442, "o", "   105\t\t\treturn nil, fmt.Errorf(\"result not found: %s\", id)\r\n   106\t\t}\r\n   107\t\r\n   108\t\tdata, err := os.ReadFile(resultPath)\r\n   109\t\tif err != nil {\r\n   110\t\t\treturn nil, fmt.Errorf(\"read error: %w\", err)\r\n"]
[282.904505, "o", "   111\t\t}\r\n   112\t\r\n   113\t\tvar stored StoredResult\r\n   114\t\tif err := json.Unmarshal(data, &stored); err != nil {\r\n   115\t\t\treturn nil, fmt.Errorf(\"unmarshal error: %w\", err)\r\n   116\t\t}\r\n   117\t\treturn &stored, nil\r\n   118\t}\r\n"]
[282.904567, "o", "   119\t\r\n   120\t// ListResults returns all stored result IDs, optionally filtered by experiment name.\r\n   121\tfunc (s *Store) ListResults(experimentFilter string) ([]IndexEntry, error) {\r\n   122\t\tindex, err := s.readIndex()\r\n   123\t\tif err != nil {\r\n   124\t\t\treturn nil, err\r\n   125\t\t}\r\n   126\t\r\n   127\t\tif experimentFilter == \"\" {\r\n   128\t\t\treturn index, nil\r\n   129\t\t}\r\n"]
[282.904636, "o", "   130\t\r\n   131\t\tvar filtered []IndexEntry\r\n   132\t\tfor _, entry := range index {\r\n   133\t\t\tif entry.ExperimentName == experimentFilter {\r\n   134\t\t\t\tfiltered = append(filtered, entry)\r\n   135\t\t\t}\r\n   136\t\t}\r\n   137\t\treturn filtered, nil\r\n   138\t}\r\n   139\t\r\n   140\t// IndexEntry represents one line in the result index."]
[282.904693, "o", "\r\n   141\ttype IndexEntry struct {\r\n   142\t\tID             string\r\n   143\t\tExperimentName string\r\n   144\t\tTimestamp      time.Time\r\n   145\t}\r\n   146\t\r\n   147\tfunc (s *Store) indexPath() string {\r\n   148\t\t"]
[282.904754, "o", "return filepath.Join(s.BaseDir, \"index.txt\")\r\n   149\t}\r\n   150\t\r\n   151\tfunc (s *Store) updateIndex(id, experimentName string, timestamp time.Time) error {\r\n   152\t\tf, err := os.OpenFile(s.indexPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)\r\n   153\t\tif err != nil {\r\n   154\t\t\treturn err\r\n   155\t"]
[282.904819, "o", "\t}\r\n   156\t\tdefer f.Close()\r\n   157\t\r\n   158\t\t_, err = fmt.Fprintf(f, \"%s|%s|%s\\n\", id, experimentName, timestamp.Format(time.RFC3339))\r\n   159\t\treturn err\r\n   160\t}\r\n   161\t\r\n   162\tfunc (s *Store) readIndex() ([]IndexEntry, error) {\r\n   163\t\tdata, err := os.ReadFile(s.indexPath())\r\n   164\t\tif err != nil {"]
[282.904874, "o", "\r\n   165\t\t\tif os.IsNotExist(err) {\r\n   166\t\t\t\treturn nil, nil\r\n   167\t\t\t}\r\n   168\t\t\treturn nil, err\r\n   169\t\t}\r\n   170\t\r\n   171\t\tvar entries []IndexEntry\r\n   172\t\tfor _, line := range strings.Split(strings.TrimSpace(string(data)), \"\\n\") {\r\n"]
[282.904935, "o", "   173\t\t\tif line == \"\" {\r\n   174\t\t\t\tcontinue\r\n   175\t\t\t}\r\n   176\t\t\tparts := strings.SplitN(line, \"|\", 3)\r\n   177\t\t\tif len(parts) != 3 {\r\n   178\t\t\t\tcontinue\r\n   179\t\t\t}\r\n   180\t\t\tts, _ := time.Parse(time.RFC3339, parts[2])\r\n   181\t\t\tentries = append(entries, IndexEntry{\r\n"]
[282.905002, "o", "   182\t\t\t\tID:             parts[0],\r\n   183\t\t\t\tExperimentName: parts[1],\r\n   184\t\t\t\tTimestamp:      ts,\r\n   185\t\t\t})\r\n   186\t\t}\r\n   187\t\r\n"]
[282.905061, "o", "   188\t\tsort.Slice(entries, func(i, j int) bool {\r\n   189\t\t\treturn entries[i].Timestamp.Before(entries[j].Timestamp)\r\n   190\t\t})\r\n   191\t\r\n   192\t\treturn entries, nil\r\n   193\t}\r\n   194\t\r\n   195\t// TODO: Add Verify function that checks result integrity using checksums.\r\n   196\t// func (s *Store) Verify(id string) (bool, error) { ... }\r\n"]
