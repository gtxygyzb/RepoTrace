[3955.242764, "o", "\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K == nil {\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K = map[string]string{}\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif _, ok := result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed\"]; !ok {\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed\"] = strconv.FormatInt(seed, 10)\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed_source\"] = \"provided\"\r\n"]
