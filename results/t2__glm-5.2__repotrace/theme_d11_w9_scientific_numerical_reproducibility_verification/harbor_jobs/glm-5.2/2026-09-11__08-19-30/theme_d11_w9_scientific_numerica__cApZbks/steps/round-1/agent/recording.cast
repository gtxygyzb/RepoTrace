[3792.419129, "o", "   494\tfunc cmdVerify(args []string) {\r\n   495\t\tif len(args) < 1 {\r\n   496\t\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\\n\")\r\n"]
[3792.419159, "o", "   497\t\t\tos.Exit(1)\r\n   498\t\t}\r\n   499\t\r\n   500\t\tid := args[0]\r\n   501\t\tstoreDir := \"./results\"\r\n"]
[3792.419266, "o", "   502\t\tverbose := false\r\n   503\t\r\n   504\t\tfor i := 1; i < len(args); i++ {\r\n   505\t\t\tswitch args[i] {\r\n   506\t\t\tcase \"--verbose\":\r\n   507\t\t\t\tverbose = true\r\n   508\t\t\tcase \"--store-dir\":\r\n   509\t\t\t\ti++\r\n   510\t\t\t\tif i >= len(args) {\r\n   511\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n   512\t\t\t\t\tos.Exit(1)\r\n   513\t\t\t\t}\r\n"]
[3792.419327, "o", "   514\t\t\t\tstoreDir = args[i]\r\n   515\t\t\tdefault:\r\n   516\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   517\t\t\t\tos.Exit(1)\r\n   518\t\t\t}\r\n   519\t\t}\r\n   520\t\r\n   521\t\tstore, err := storage.NewStore(storeDir)\r\n   522\t\tif err != nil {\r\n"]
[3792.41938, "o", "   523\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   524\t\t\tos.Exit(1)\r\n   525\t\t}\r\n   526\t\r\n   527\t\tstatus, expected, computed, err := store.Verify(id)\r\n   528\t\tif err != nil {\r\n   529\t\t\tfmt.Fprintf(os.Stderr, \"verify error: %v\\n\", err)\r\n   530\t\t\tos.Exit(1)\r\n"]
[3792.419433, "o", "   531\t\t}\r\n   532\t\r\n   533\t\tswitch status {\r\n   534\t\tcase storage.StatusVerified:\r\n   535\t\t\tfmt.Printf(\"INTEGRITY_OK: %s\\n\", id)\r\n   536\t\t\tif verbose {\r\n   537\t\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n"]
[3792.419533, "o", "   538\t\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n   539\t\t\t}\r\n   540\t\t\tos.Exit(0)\r\n   541\t\tcase storage.StatusCorrupted:\r\n   542\t\t\tfmt.Printf(\"INTEGRITY_FAIL: %s\\n\", id)\r\n   543\t\t\tif verbose {\r\n   544\t\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n   545\t\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n   546\t\t\t}\r\n   547\t\t\tos.Exit(1)\r\n   548\t\tcase storage.StatusNoChecksum:\r\n   549\t\t\tfmt.Printf(\"NO_CHECKSUM: %s\\n\", id)\r\n   550\t\t"]
[3792.419645, "o", "\tos.Exit(2)\r\n   551\t\tdefault:\r\n   552\t\t\tfmt.Fprintf(os.Stderr, \"unknown verification status: %s\\n\", status)\r\n"]
