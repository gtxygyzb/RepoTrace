[2280.253278, "o", "\tdata, err := json.MarshalIndent(result, \"\", \"  \")\r\n   415\t\t\tif err != nil {\r\n   416\t\t\t\tfmt.Fprintf(os.Stderr, \"marshal error: %v\\n\", err)\r\n   417\t\t\t\tos.Exit(1)\r\n   418\t\t\t}\r\n   419\t\t\tfmt.Println(string(data))\r\n   420\t\tcase \"csv\":\r\n   421\t\t\tfmt.Println(\"label,value\")\r\n   422\t\t\tfor i, v := range result.Values {\r\n   423\t\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n"]
