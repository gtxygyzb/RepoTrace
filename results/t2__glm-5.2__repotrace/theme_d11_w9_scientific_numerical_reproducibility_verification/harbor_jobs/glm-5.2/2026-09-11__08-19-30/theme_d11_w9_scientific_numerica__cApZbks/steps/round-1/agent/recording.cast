[4450.57553, "o", "\r\n   634\t\tall := false\r\n   635\t\tvar positionals []string\r\n   636\t\tstoreDir := \"./results\"\r\n   637\t\r\n   638\t\tfor i := 0; i < len(args); i++ {\r\n   639\t\t\tswitch args[i] {\r\n   640\t\t\tcase \"--all\":\r\n   641\t\t\t\tall = true\r\n   642\t\t\tcase \"--store-dir\":\r\n"]
