[3409.658403, "o", "\t}\r\n   626\t\t}\r\n   627\t\r\n   628\t\tfmt.Printf(\"Audit Summary: %d passed, %d failed out of %d total\\n\", passed, failed, total)\r\n   629\t\tif failed > 0 {\r\n   630\t\t\tos.Exit(1)\r\n   631\t\t}\r\n   632\t}\r\n   633\t\r\n"]
[3409.65846, "o", "   634\tfunc auditStoredResult(store *storage.Store, id string) (bool, string) {\r\n   635\t\tstored, err := store.Load(id)\r\n   636\t\tif err != nil {\r\n   637\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: load error: %v)\\n\", id, err)\r\n   638\t\t}\r\n   639\t\r\n"]
[3409.658535, "o", "   640\t\twarnEnvMismatch(stored)\r\n   641\t\r\n   642\t\tstatus, expected, computed, err := store.Verify(id)\r\n   643\t\tif err != nil {\r\n   644\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: checksum verification error: %v)\\n\", id, err)\r\n   645\t\t}\r\n   646\t\tif status == storage.StatusNoChecksum {\r\n   647\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: checksum missing)\\n\", id)\r\n   648\t\t"]
[3409.658599, "o", "}\r\n   649\t\tif status == storage.StatusCorrupted {\r\n   650\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: checksum mismatch expected=%s computed=%s)\\n\", id, expected, computed)\r\n   651\t\t}\r\n   652\t\r\n   653\t\tseedStr, ok := stored.Metadata[\"seed\"]\r\n   654\t\tif !ok {\r\n   655\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: missing seed in metadata)\\n\", id)\r\n   656\t\t}\r\n"]
[3409.658657, "o", "   657\t\tseed, err := strconv.ParseInt(seedStr, 10, 64)\r\n   658\t\tif err != nil {\r\n   659\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\\n\", id, err)\r\n   660\t\t}\r\n   661\t\r\n   662\t\tfn, err := engine.Get(stored.ExperimentName)\r\n   663\t\tif err != nil {\r\n   664\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n"]
[3409.658728, "o", "   665\t\t}\r\n   666\t\r\n   667\t\trng := engine.NewRNG(seed)\r\n   668\t\treexec, err := fn(stored.ExperimentName, stored.Parameters, rng)\r\n   669\t\tif err != nil {\r\n   670"]
[3409.658786, "o", "\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n   671\t\t}\r\n   672\t\r\n   673\t\tmaxLen := len(stored.Values)\r\n   674\t\tif len(reexec.Values) > maxLen {\r\n   675\t\t\tmaxLen = len(reexec.Values)\r\n   676\t\t}\r\n   677\t\r\n   678\t\tvar mismatches []string\r\n   679\t\tfor i := 0; i < maxLen; i++ {\r\n   680\t\t\tstoredMissing := i >= len(stored.Values)\r\n   681\t\t\treexecMissing := i >= len(reexec.Values)\r\n   682\t\r\n"]
[3409.658854, "o", "   683\t\t\tvar storedVal, reexecVal string\r\n   684\t\t\tif storedMissing {\r\n   685\t\t\t\tstoredVal = \"<missing>\"\r\n   686\t\t\t} else {\r\n   687\t\t\t\tstoredVal = strconv.FormatFloat(stored.Values[i], 'g', -1, 64)\r\n   688\t\t\t}\r\n"]
[3409.658913, "o", "   689\t\t\tif reexecMissing {\r\n   690\t\t\t\treexecVal = \"<missing>\"\r\n   691\t\t\t} else {\r\n   692\t\t\t\treexecVal = strconv.FormatFloat(reexec.Values[i], 'g', -1, 64)\r\n   693\t\t\t}\r\n   694\t\r\n   695\t\t\tif storedMissing || reexecMissing || math.Float64bits(stored.Values[i]) != math.Float64bits(reexec.Values[i]) {\r\n   696\t\t\t\tmismatches = append(mismatches, fmt.Sprintf(\"  value[%d]: stored=%s, re-executed=%s\", i, storedVal, reexecVal))\r\n   697\t\t\t}\r\n   698\t\t}\r\n   699\t\r\n   700\t\tif len(mismatches) == 0 {"]
[3409.658974, "o", "\r\n"]
