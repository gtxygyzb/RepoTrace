[3109.54364, "o", "stored, err := store.Load(id)\r\n   575\t\tif err != nil {\r\n   576\t\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: load error: %v)\\n\", id, err)\r\n   577\t\t\tos.Exit(1)\r\n   578\t\t}\r\n   579\t\r\n   580\t\tstatus, expected, computed, err := store.Verify(id)\r\n   581\t\tif err != nil {\r\n   582\t\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: checksum verification error: %v)\\n\", id, err)\r\n   583\t\t\tos.Exit(1)\r\n   584\t\t}\r\n   585\t\tif status == storage.StatusNoChecksum {\r\n   586\t\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: checksum missing)\\n\", id)\r\n   587\t\t\tos.Exit(1)\r\n   588\t\t}\r\n   589\t\tif status == storage.StatusCorrupted {\r\n   590\t\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: checksum mismatch expected=%s computed=%s)\\n\", id, expected, computed)\r\n"]
[3109.54371, "o", "   591\t\t\tos.Exit(1)\r\n   592\t\t}\r\n   593\t\r\n   594\t\tseedStr, ok := stored.Metadata[\"seed\"]\r\n   595\t\tif !ok {\r\n   596\t\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: missing seed in metadata)\\n\", id)\r\n   597\t\t\tos.Exit(1)\r\n   598\t\t}\r\n   599\t\tseed, err := strconv.ParseInt(seedStr, 10, 64)\r\n"]
[3109.543771, "o", "   600\t\tif err != nil {\r\n   601\t\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\\n\", id, err)\r\n   602\t\t\tos.Exit(1)\r\n   603\t\t}\r\n   604\t\r\n   605\t\tfn, err := engine.Get(stored.ExperimentName)\r\n   606\t\tif err != nil {\r\n   607\t\t\tfmt.Printf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n   608\t\t\tos.Exit(1)\r\n"]
