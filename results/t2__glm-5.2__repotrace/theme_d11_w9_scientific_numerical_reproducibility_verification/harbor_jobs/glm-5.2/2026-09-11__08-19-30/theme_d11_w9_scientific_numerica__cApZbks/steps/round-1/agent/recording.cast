[3675.110163, "o", "for doc in ['docs/reproducibility_spec.md', 'docs/legacy_api.md']:\r\n\u001b[?2004l\r"]
[3675.110228, "o", "\u001b[?2004h> "]
[3675.110298, "o", "    q = Path(doc)\r\n\u001b[?2004l\r"]
[3675.110365, "o", "\u001b[?2004h> "]
