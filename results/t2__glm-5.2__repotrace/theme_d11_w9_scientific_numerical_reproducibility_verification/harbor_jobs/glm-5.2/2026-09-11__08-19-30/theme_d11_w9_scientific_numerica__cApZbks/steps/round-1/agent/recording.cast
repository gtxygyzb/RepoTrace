[4533.200773, "o", "\u001b[?2004h> "]
[4533.201015, "o", "new_default = '''\\tcase \"markdown\":\r\n\u001b[?2004l\r"]
[4533.201071, "o", "\u001b[?2004h> "]
[4533.201519, "o", "\\t\\tfmt.Printf(\"# %s (%s)\\\\n\", result.ExperimentName, result.ID)\r\n\u001b[?2004l\r"]
[4533.201578, "o", "\u001b[?2004h> "]
[4533.201705, "o", "\\t\\tfmt.Println()\r\n\u001b[?2004l\r"]
[4533.201769, "o", "\u001b[?2004h> "]
[4533.201981, "o", "\\t\\tfmt.Println(\"## Metadata\")\r\n\u001b[?2004l\r"]
[4533.202044, "o", "\u001b[?2004h> "]
[4533.202623, "o", "\\t\\tfmt.Printf(\"- timestamp: %s\\\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n\u001b[?2004l\r"]
[4533.202689, "o", "\u001b[?2004h> "]
[4533.203019, "o", "\\t\\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n\u001b[?2004l\r"]
[4533.203076, "o", "\u001b[?2004h> "]
[4533.203351, "o", "\\t\\t\\tfmt.Printf(\"- seed: %s\\\\n\", seed)\r\n\u001b[?2004l\r"]
[4533.203401, "o", "\u001b[?2004h"]
[4533.203457, "o", "> "]
[4533.203521, "o", "\\t\\t} else {\r\n\u001b[?2004l\r"]
[4533.203583, "o", "\u001b[?2004h> "]
[4533.203787, "o", "\\t\\t\\tfmt.Println(\"- seed: \")\r\n\u001b[?2004l\r"]
[4533.203843, "o", "\u001b[?2004h> "]
[4533.203893, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[4533.203955, "o", "\u001b[?2004h> "]
[4533.204649, "o", "\\t\\tfmt.Printf(\"- go_version: %s\\\\n\", metadataOrDefault(result.Metadata, \"env_go_version\", \"unknown\"))\r\n\u001b[?2004l\r"]
[4533.20472, "o", "\u001b[?2004h> "]
[4533.205293, "o", "\\t\\tfmt.Printf(\"- os: %s\\\\n\", metadataOrDefault(result.Metadata, \"env_os\", \"unknown\"))\r\n\u001b[?2004l\r"]
[4533.205354, "o", "\u001b[?2004h> "]
[4533.20596, "o", "\\t\\tfmt.Printf(\"- arch: %s\\\\n\", metadataOrDefault(result.Metadata, \"env_arch\", \"unknown\"))\r\n\u001b[?2004l\r"]
[4533.20601, "o", "\u001b[?2004h> "]
[4533.206697, "o", "\\t\\tfmt.Printf(\"- hostname: %s\\\\n\", metadataOrDefault(result.Metadata, \"env_hostname\", \"unknown\"))\r\n\u001b[?2004l\r"]
[4533.206761, "o", "\u001b[?2004h> "]
[4533.206878, "o", "\\t\\tfmt.Println()\r\n"]
[4533.20694, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4533.207147, "o", "\\t\\tfmt.Println(\"## Results\")\r\n\u001b[?2004l\r"]
[4533.207206, "o", "\u001b[?2004h> "]
[4533.207456, "o", "\\t\\tfmt.Println(\"| Label | Value |\")\r\n\u001b[?2004l\r"]
[4533.207527, "o", "\u001b[?2004h> "]
[4533.20772, "o", "\\t\\tfmt.Println(\"|---|---|\")\r\n\u001b[?2004l\r"]
[4533.207775, "o", "\u001b[?2004h> "]
[4533.208039, "o", "\\t\\tfor i, v := range result.Values {\r\n\u001b[?2004l\r"]
[4533.208095, "o", "\u001b[?2004h> "]
[4533.208384, "o", "\\t\\t\\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n\u001b[?2004l\r"]
[4533.208439, "o", "\u001b[?2004h> "]
[4533.208693, "o", "\\t\\t\\tif i < len(result.Labels) {\r\n\u001b[?2004l\r"]
[4533.208749, "o", "\u001b[?2004h> "]
[4533.208977, "o", "\\t\\t\\t\\tlabel = result.Labels[i]\r\n\u001b[?2004l\r"]
[4533.209031, "o", "\u001b[?2004h> "]
[4533.209093, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[4533.209148, "o", "\u001b[?2004h> "]
[4533.209492, "o", "\\t\\t\\tfmt.Printf(\"| %s | %.15g |\\\\n\", label, v)\r\n\u001b[?2004l\r"]
[4533.209557, "o", "\u001b[?2004h> "]
[4533.209622, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.209682, "o", "> "]
[4533.209743, "o", "\\tdefault:\r\n\u001b[?2004l\r"]
[4533.209794, "o", "\u001b[?2004h> "]
[4533.210248, "o", "\\t\\tfmt.Fprintf(os.Stderr, \"unknown format: %s\\\\n\", format)\r\n\u001b[?2004l\r"]
[4533.210297, "o", "\u001b[?2004h> "]
[4533.210422, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[4533.210495, "o", "\u001b[?2004h> "]
[4533.210563, "o", "\\t}\r\n\u001b[?2004l\r"]
[4533.210625, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.210688, "o", "> \r\n\u001b[?2004l\rs\u001b[?2004h"]
[4533.210774, "o", "> "]
[4533.211159, "o", "func metadataOrDefault(metadata map[string]string, key, fallback string) string {\r\n\u001b[?2004l\r"]
[4533.211217, "o", "\u001b[?2004h> "]
[4533.211467, "o", "\\tif value, ok := metadata[key]; ok && value != \"\" {\r\n\u001b[?2004l\r"]
[4533.211545, "o", "\u001b[?2004h> "]
[4533.211608, "o", "\\t\\treturn value\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.211673, "o", "> \\t}\r\n\u001b[?2004l\r"]
[4533.211736, "o", "\u001b[?2004h> "]
[4533.211805, "o", "\\treturn fallback\r\n\u001b[?2004l\r"]
[4533.211865, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[4533.211924, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.212125, "o", "func cmdVerify(args []string) {'''\r\n\u001b[?2004l\r"]
[4533.212193, "o", "\u001b[?2004h> "]
[4533.212313, "o", "if old_default not in s:\r\n\u001b[?2004l\r"]
[4533.212371, "o", "\u001b[?2004h> "]
[4533.21269, "o", "    raise SystemExit('export default marker not found')\r\n\u001b[?2004l\r"]
[4533.212752, "o", "\u001b[?2004h> "]
[4533.212936, "o", "s = s.replace(old_default, new_default)\r\n\u001b[?2004l\r"]
[4533.212991, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r(\u001b[?2004h"]
[4533.213047, "o", "> "]
[4533.213451, "o", "old_single_audit = '''\\tpassed, details := auditStoredResult(store, positionals[0])\r\n\u001b[?2004l\r"]
[4533.213525, "o", "\u001b[?2004h> "]
[4533.21359, "o", "\\tfmt.Print(details)\r\n\u001b[?2004l\r"]
[4533.213642, "o", "\u001b[?2004h> "]
[4533.213725, "o", "\\tif !passed {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.213812, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[4533.213871, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\rt"]
[4533.21393, "o", "\u001b[?2004h> }'''\r\n\u001b[?2004l\r"]
[4533.213989, "o", "\u001b[?2004h> "]
[4533.214376, "o", "new_single_audit = '''\\tstatus, details := auditStoredResult(store, positionals[0])\r\n\u001b[?2004l\r"]
[4533.214435, "o", "\u001b[?2004h> "]
[4533.214539, "o", "\\tfmt.Print(details)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.214618, "o", "> "]
[4533.214684, "o", "\\tif status == auditFail {\r\n\u001b[?2004l\r"]
[4533.214746, "o", "\u001b[?2004h> "]
[4533.21482, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[4533.21488, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[4533.214981, "o", "\u001b[?2004h> }'''\r\n\u001b[?2004l\r"]
[4533.215071, "o", "\u001b[?2004h> "]
[4533.215173, "o", "if old_single_audit not in s:\r\n\u001b[?2004l\r"]
[4533.215231, "o", "\u001b[?2004h> "]
[4533.2155, "o", "    raise SystemExit('single audit block not found')\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.215561, "o", "> "]
[4533.215775, "o", "s = s.replace(old_single_audit, new_single_audit)\r\n\u001b[?2004l\r"]
[4533.215834, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rN\u001b[?2004h> "]
[4533.216026, "o", "old_audit_all = '''\\tpassed := 0\r\n\u001b[?2004l\r"]
[4533.216084, "o", "\u001b[?2004h> "]
[4533.216165, "o", "\\tfailed := 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.216301, "o", "\\ttotal := len(entries)\r\n\u001b[?2004l\r"]
[4533.216358, "o", "\u001b[?2004h> "]
[4533.216508, "o", "\\tfor _, entry := range entries {\r\n\u001b[?2004l\r"]
[4533.216568, "o", "\u001b[?2004h> "]
[4533.216826, "o", "\\t\\tok, details := auditStoredResult(store, entry.ID)\r\n\u001b[?2004l\r"]
[4533.216882, "o", "\u001b[?2004h> "]
[4533.216992, "o", "\\t\\tfmt.Print(details)\r\n\u001b[?2004l\r"]
[4533.217048, "o", "\u001b[?2004h> "]
[4533.217107, "o", "\\t\\tif ok {\r\n\u001b[?2004l\r"]
[4533.217163, "o", "\u001b[?2004h> "]
[4533.217216, "o", "\\t\\t\\tpassed++\r\n\u001b[?2004l\r"]
[4533.217271, "o", "\u001b[?2004h> "]
[4533.217328, "o", "\\t\\t} else {\r\n\u001b[?2004l\r"]
[4533.217383, "o", "\u001b[?2004h> "]
[4533.21745, "o", "\\t\\t\\tfailed++\r\n\u001b[?2004l\r"]
[4533.217526, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[4533.217587, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[4533.217645, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.217702, "o", "> "]
[4533.218163, "o", "\\tfmt.Printf(\"Audit Summary: %d passed, %d failed out of %d total\\\\n\", passed, failed, total)\r\n\u001b[?2004l\r"]
[4533.218228, "o", "\u001b[?2004h> "]
[4533.218288, "o", "\\tif failed > 0 {\r\n\u001b[?2004l\r"]
[4533.218342, "o", "\u001b[?2004h> "]
[4533.218394, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[4533.218453, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[4533.21852, "o", "\u001b[?2004h> }'''\r\n\u001b[?2004l\r"]
[4533.218577, "o", "\u001b[?2004h> "]
[4533.218753, "o", "new_audit_all = '''\\tpassed := 0\r\n\u001b[?2004l\r"]
[4533.218807, "o", "\u001b[?2004h> "]
[4533.218869, "o", "\\tfailed := 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.218925, "o", "> "]
[4533.218977, "o", "\\tskipped := 0\r\n\u001b[?2004l\r"]
[4533.219033, "o", "\u001b[?2004h> "]
[4533.219131, "o", "\\ttotal := len(entries)\r\n\u001b[?2004l\r"]
[4533.219186, "o", "\u001b[?2004h> "]
[4533.219335, "o", "\\tfor _, entry := range entries {\r\n\u001b[?2004l\r"]
[4533.219391, "o", "\u001b[?2004h> "]
[4533.219674, "o", "\\t\\tstatus, details := auditStoredResult(store, entry.ID)\r\n\u001b[?2004l\r"]
[4533.219734, "o", "\u001b[?2004h> "]
[4533.219819, "o", "\\t\\tfmt.Print(details)\r\n\u001b[?2004l\r"]
[4533.219874, "o", "\u001b[?2004h> "]
[4533.219959, "o", "\\t\\tswitch status {\r\n\u001b[?2004l\r"]
[4533.220014, "o", "\u001b[?2004h> "]
[4533.2201, "o", "\\t\\tcase auditPass:\r\n\u001b[?2004l\r"]
[4533.220156, "o", "\u001b[?2004h> "]
[4533.220214, "o", "\\t\\t\\tpassed++\r\n\u001b[?2004l\r"]
[4533.220269, "o", "\u001b[?2004h> "]
[4533.220347, "o", "\\t\\tcase auditFail:\r\n\u001b[?2004l\r"]
[4533.220402, "o", "\u001b[?2004h> "]
[4533.220455, "o", "\\t\\t\\tfailed++\r\n\u001b[?2004l\r"]
[4533.220522, "o", "\u001b[?2004h> "]
[4533.220612, "o", "\\t\\tcase auditSkip:\r\n\u001b[?2004l\r"]
[4533.220666, "o", "\u001b[?2004h> "]
[4533.220736, "o", "\\t\\t\\tskipped++\r\n\u001b[?2004l\r"]
[4533.220791, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[4533.22085, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[4533.220909, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4533.220975, "o", "\u001b[?2004h> "]
[4533.221367, "o", "\\tfmt.Printf(\"Audit Summary: %d passed, %d failed, %d skipped out of %d total\\\\n\", passed, failed, skipped, total)\r\n\u001b[?2004l\r"]
[4533.221423, "o", "\u001b[?2004h> "]
[4533.221488, "o", "\\tif failed > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.22155, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[4533.221604, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[4533.221665, "o", "\u001b[?2004h> }'''\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.221727, "o", "> "]
[4533.221784, "o", "if old_audit_all not in s:\r\n\u001b[?2004l\r"]
[4533.221838, "o", "\u001b[?2004h> "]
[4533.221991, "o", "    raise SystemExit('audit all block not found')\r\n\u001b[?2004l\r"]
[4533.222047, "o", "\u001b[?2004h> "]
[4533.222183, "o", "s = s.replace(old_audit_all, new_audit_all)\r\n\u001b[?2004l\r"]
[4533.222238, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.222547, "o", "old_fn = '''func auditStoredResult(store *storage.Store, id string) (bool, string) {\r\n\u001b[?2004l\r"]
[4533.222609, "o", "\u001b[?2004h> "]
[4533.22272, "o", "\\tstored, err := store.Load(id)\r\n\u001b[?2004l\r"]
[4533.222775, "o", "\u001b[?2004h> "]
[4533.222852, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[4533.222909, "o", "\u001b[?2004h> "]
[4533.223179, "o", "\\t\\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: load error: %v)\\\\n\", id, err)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.223237, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4533.223294, "o", "\u001b[?2004h> "]
[4533.223384, "o", "\\twarnEnvMismatch(stored)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.223438, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.223633, "o", "\\tstatus, expected, computed, err := store.Verify(id)\r\n\u001b[?2004l\r"]
[4533.22369, "o", "\u001b[?2004h> "]
[4533.223741, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
[4533.223796, "o", "\u001b[?2004h> "]
[4533.224127, "o", "\\t\\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: integrity check error: %v)\\\\n\", id, err)\r\n\u001b[?2004l\r"]
[4533.224182, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.224354, "o", "\\tif status == storage.StatusNoChecksum {\r\n\u001b[?2004l\r"]
[4533.224408, "o", "\u001b[?2004h> "]
[4533.224758, "o", "\\t\\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: integrity check failed: no checksum)\\\\n\", id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.224816, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.224987, "o", "\\tif status == storage.StatusCorrupted {\r\n\u001b[?2004l\r"]
[4533.225043, "o", "\u001b[?2004h> "]
[4533.225513, "o", "\\t\\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: integrity check failed: expected=%s computed=%s)\\\\n\", id, expected, computed)\r\n\u001b[?2004l\r"]
[4533.225571, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[4533.225627, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4533.225763, "o", "\\tseedStr, ok := stored.Metadata[\"seed\"]\r\n\u001b[?2004l\r"]
[4533.225818, "o", "\u001b[?2004h> \\tif !ok {\r\n\u001b[?2004l\r"]
[4533.225874, "o", "\u001b[?2004h> "]
[4533.226171, "o", "\\t\\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: missing seed in metadata)\\\\n\", id)\r\n\u001b[?2004l\r"]
[4533.226227, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.226421, "o", "\\tseed, err := strconv.ParseInt(seedStr, 10, 64)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.226484, "o", "> "]
[4533.226549, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.226893, "o", "\\t\\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\\\\n\", id, err)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.226949, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.227002, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.227166, "o", "\\tfn, err := engine.Get(stored.ExperimentName)\r\n\u001b[?2004l\r"]
[4533.227221, "o", "\u001b[?2004h> "]
[4533.22728, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.22762, "o", "\\t\\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\\\n\", id, err)\r\n\u001b[?2004l\r\u001b[?2004h"]
[4533.227679, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[4533.227733, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[4533.227823, "o", "\\trng := engine.NewRNG(seed)\r\n\u001b[?2004l\r"]
[4533.227877, "o", "\u001b[?2004h> "]
[4533.228094, "o", "\\treexec, err := fn(stored.ExperimentName, stored.Parameters, rng)\r\n\u001b[?2004l\r"]
[4533.22815, "o", "\u001b[?2004h> "]
[4533.228209, "o", "\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4533.228481, "o", "\\t\\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\\\n\", id, err)\r\n\u001b[?2004l\r"]
[4533.228537, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
