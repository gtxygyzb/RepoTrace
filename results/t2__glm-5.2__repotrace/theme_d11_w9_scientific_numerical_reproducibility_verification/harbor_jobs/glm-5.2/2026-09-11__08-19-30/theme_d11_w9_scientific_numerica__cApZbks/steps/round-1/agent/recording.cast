[5168.613445, "o", "\u001b[32m\u001b[K615\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \"\u001b[m\u001b[K--verbose\":\r\n\u001b[32m\u001b[K617\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \"\u001b[m\u001b[K--store-dir\":\r\n\u001b[32m\u001b[K672\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \"\u001b[m\u001b[K--all\":\r\n"]
