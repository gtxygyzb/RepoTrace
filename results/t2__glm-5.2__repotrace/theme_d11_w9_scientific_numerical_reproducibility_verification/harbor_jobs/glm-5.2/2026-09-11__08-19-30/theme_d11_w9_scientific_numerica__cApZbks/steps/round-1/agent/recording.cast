[5065.758565, "i", "grep -R \"func .*Verify\\|verify\\|Report\\|report\" -n .\n"]
[5065.758971, "o", "grep -R \"func .*Verify\\|verify\\|Report\\|report\" -n .\r\n\u001b[?2004l\r"]
[5065.762623, "o", "\u001b[35m\u001b[K./engine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t// For simplicity, we \u001b[01;31m\u001b[Kreport\u001b[m\u001b[K the weighted mean as the integral estimate\r\n"]
[5065.762828, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  numeriforge \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K <result_id> --store-dir <dir> [--verbose]\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K    Verify result integrity\r\n"]
[5065.76292, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"\u001b[01;31m\u001b[Kverify\u001b[m\u001b[K\":\r\n"]
[5065.762991, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// hasMatchingTags \u001b[01;31m\u001b[Kreport\u001b[m\u001b[Ks whether metadata contains all requested tag filters.\r\n"]
[5065.76306, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Print(compare.Format\u001b[01;31m\u001b[KReport\u001b[m\u001b[K(cr))\r\n"]
[5065.763209, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K603\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmdVerify\u001b[m\u001b[K(args []string) {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K605\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K <result_id> --store-dir <dir> [--verbose]\\n\")\r\n"]
[5065.76328, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K638\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"\u001b[01;31m\u001b[Kverify\u001b[m\u001b[K error: %v\\n\", err)\r\n"]
[5065.763502, "o", "\u001b[35m\u001b[K./compare/compare.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// Format\u001b[01;31m\u001b[KReport\u001b[m\u001b[K generates a human-readable comparison \u001b[01;31m\u001b[Kreport\u001b[m\u001b[K.\r\n"]
[5065.763573, "o", "\u001b[35m\u001b[K./compare/compare.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K179\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc Format\u001b[01;31m\u001b[KReport\u001b[m\u001b[K(cr *ComparisonResult) string {\r\n\u001b[35m\u001b[K./compare/compare.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K181\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tsb.WriteString(\"=== Comparison \u001b[01;31m\u001b[KReport\u001b[m\u001b[K ===\\n\")\r\n"]
[5065.7637, "o", "\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KThe `numeriforge \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K` command must:\r\n"]
[5065.763769, "o", "\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KThe comparison \u001b[01;31m\u001b[Kreport\u001b[m\u001b[K for tolerance mode must include:\r\n\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KResults stored without checksums (pre-reproducibility) remain loadable. The \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K command \u001b[01;31m\u001b[Kreport\u001b[m\u001b[Ks `NO_CHECKSUM` for such results rather than treating them as corrupt.\r\n"]
[5065.763831, "o", "\u001b[35m\u001b[K./docs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K### `numeriforge \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K`\r\n\u001b[35m\u001b[K./docs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Knumeriforge \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K <id> --store-dir <dir> [--verbose]\r\n"]
[5065.763904, "o", "\u001b[35m\u001b[K./docs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K**Known limitation:** Results do not include integrity checksums. There is no way to \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K that stored values have not been corrupted or tampered with.\r\n"]
[5065.763979, "o", "\u001b[35m\u001b[K./docs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K2. **Broken comparison**: The `exact` comparison mode uses strict float equality (`==`), which almost always \u001b[01;31m\u001b[Kreport\u001b[m\u001b[Ks mismatches for scientific computations due to floating-point rounding. The `tolerance` mode is defined in the code but not implemented.\r\n\u001b[35m\u001b[K./docs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K3. **No integrity verification**: Results are stored without checksums. The `\u001b[01;31m\u001b[Kverify\u001b[m\u001b[K` command is a stub.\r\n\u001b[35m\u001b[K./docs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K4. **No environment tracking**: There is no record of the runtime environment (Go version, OS, architecture, CPU features) that produced a result. This makes cross-platform reproducibility impossible to \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K.\r\n"]
[5065.764057, "o", "\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// VerifyStatus \u001b[01;31m\u001b[Kreport\u001b[m\u001b[Ks the outcome of integrity verification.\r\n"]
[5065.764138, "o", "\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc (s *Store) Verify(id string) (Verify\u001b[m\u001b[KStatus, string, string, error) {\r\n"]
[5065.771384, "o", "grep: ./numeriforge: binary file matches\r\n"]
[5065.772122, "o", "\u001b[?2004h"]
[5065.772196, "o", "root@n30009:/app# "]
[5072.711568, "i", "sed -n '1,220p' main.go\n"]
[5072.711823, "o", "sed -n '1,220p' main.go\r\n\u001b[?2004l\r"]
[5072.714624, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t"]
[5072.714715, "o", "\"math\"\r\n\t\"os\"\r\n\t\"runtime\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"numeriforge/compare\"\r\n\t\"numeriforge/config\"\r\n\t\"numeriforge/engine\"\r\n\t\"numeriforge/storage\"\r\n)\r\n\r\nfunc usage() {\r\n"]
[5072.714793, "o", "\tfmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform\r\n\r\nUsage:\r\n  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]\r\n  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\r\n  numeriforge list [--experiment <name>] [--store-dir <dir>]\r\n  numeriforge export <result_id> --store-dir <dir> [--format json|csv]\r\n  numeriforge verify <result_id> --store-dir <dir> [--verbose]\r\n  numeriforge audit <result_id> --store-dir <dir>\r\n  numeriforge audit --all --store-dir <dir>\r\n\r\nCommands:\r\n  run       Run an experiment and store the result\r\n  compare   Compare two stored results\r\n  list      List stored experiment results\r\n  export    Export a result to a different format\r\n"]
[5072.714876, "o", "  verify    Verify result integrity\r\n  audit     Audit stored result(s) for reproducibility\r\n\r\nAvailable experiments:\r\n`)\r\n\tfor _, name := range engine.List() {\r\n\t"]
[5072.71495, "o", "\tfmt.Fprintf(os.Stderr, \"  %s\\n\", name)\r\n\t}\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tusage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(os.Args[2:])\r\n\tcase \"compare\":\r\n\t\tcmdCompare(os.Args[2:])\r\n\tcase \"list\":\r\n\t\tcmdList(os.Args[2:])\r\n\tcase \"export\":\r\n\t\tcmdExport(os.Args[2:])\r\n\tcase \"verify\":\r\n"]
[5072.715021, "o", "\t\tcmdVerify(os.Args[2:])\r\n\tcase \"audit\":\r\n\t\tcmdAudit(os.Args[2:])\r\n\tcase \"help\", \"--help\", \"-h\":\r\n\t\tusage()\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\t\tusage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\n// environmentMetadata returns the environment fingerprint metadata required for\r\n"]
[5072.71509, "o", "// reproducible experiment traces.\r\nfunc environmentMetadata() map[string]string {\r\n\thostname, err := os.Hostname()\r\n\tif err != nil {\r\n\t\thostname = \"unknown\"\r\n\t}\r\n\treturn map[string]string{\r\n\t\t\"env_go_version\": runtime.Version(),\r\n\t\t\"env_os\":         runtime.GOOS,\r\n\t\t\"env_arch\":       runtime.GOARCH,\r\n\t\t\"env_hostname\":   hostname,\r\n\t}\r\n}\r\n"]
[5072.715161, "o", "\r\n// environmentFromMetadata aggregates stored environment fingerprint metadata\r\n// into an export-friendly object.\r\ntype environmentInfo struct {\r\n\tGoVersion string `json:\"go_version\"`\r\n\tOS        string `json:\"os\"`\r\n\tArch      string `json:\"arch\"`\r\n\tHostname  string `json:\"hostname\"`\r\n}\r\n\r\nfunc environmentFromMetadata(metadata map[string]string) environmentInfo {\r\n\treturn environmentInfo{\r\n\t\tGoVersion: metadata[\"env_go_version\"],\r\n\t\t"]
[5072.715237, "o", "OS:        metadata[\"env_os\"],\r\n\t\tArch:      metadata[\"env_arch\"],\r\n\t\tHostname:  metadata[\"env_hostname\"],\r\n\t}\r\n}\r\n\r\ntype exportPayload struct {\r\n\t*storage.StoredResult\r\n"]
[5072.715306, "o", "\tEnvironment environmentInfo   `json:\"environment\"`\r\n\tTags        map[string]string `json:\"tags,omitempty\"`\r\n}\r\n\r\n// tagsFromMetadata collects tag_<key> metadata entries into an export-friendly\r\n// map without the tag_ prefix. It returns nil when no tags are present.\r\nfunc tagsFromMetadata(metadata map[string]string) map[string]string {\r\n\tif metadata == nil {\r\n\t\treturn nil\r\n\t}\r\n\ttags := map[string]string{}\r\n\tfor k, v := range metadata {\r\n\t\tif strings.HasPrefix(k, \"tag_\") {\r\n\t\t\ttags[k[len(\"tag_\"):]] = v\r\n\t\t}\r\n\t}\r\n\tif len(tags) == 0 {\r\n\t\t"]
[5072.715388, "o", "return nil\r\n\t}\r\n\treturn tags\r\n}\r\n\r\n// parseTagFlag parses a --tag key=value argument and returns the metadata key\r\n// and value. It prints an error and exits when the argument is malformed.\r\nfunc parseTagFlag(arg string) (string, string) {\r\n\tparts := strings.SplitN(arg, \"=\", 2)\r\n\tif len(parts) != 2 || parts[0] == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid tag, expected key=value: %s\\n\", arg)\r\n\t\tos.Exit(1)\r\n\t}\r\n\treturn \"tag_\" + parts[0], parts[1]\r\n"]
[5072.715466, "o", "}\r\n\r\n// hasMatchingTags reports whether metadata contains all requested tag filters.\r\nfunc hasMatchingTags(metadata map[string]string, tags map[string]string) bool {\r\n\tfor k, v := range tags {\r\n\t\tif metadata[\"tag_\"+k] != v {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc cmdRun(args []string) {\r\n\tvar experimentName, outputDir, configPath string"]
[5072.715581, "o", "\r\n\tvar paramStrs []string\r\n\tvar tagStrs []string\r\n\tvar seed int64\r\n\tseedProvided := false\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--experiment\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\texperimentName = args[i]\r\n\t\tcase \"--output-dir\":\r\n\t\t"]
[5072.715646, "o", "\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --output-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\toutputDir = args[i]\r\n\t\tcase \"--config\":\r\n\t\t\ti++\r\n\t\t"]
[5072.715714, "o", "\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --config requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tconfigPath = args[i]\r\n\t\tcase \"--param\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --param requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n"]
[5072.715781, "o", "\t\t\tparamStrs = append(paramStrs, args[i])\r\n\t\tcase \"--seed\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --seed requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tparsed, err := strconv.ParseInt(args[i], 10, 64)\r\n\t\t\tif err != nil {\r\n"]
[5072.71585, "o", "\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid seed: %v\\n\", err)\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tseed = parsed\r\n\t\t\tseedProvided = true\r\n\t\tcase \"--tag\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --tag requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n"]
[5072.715916, "o", "\t\t\t}\r\n\t\t\ttagStrs = append(tagStrs, args[i])\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\r\n\tif configPath != \"\" {\r\n\t\tcfg, err := config.ParseINI(configPath)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"config error: %v\\n\", err)\r\n"]
[5072.716538, "o", "\u001b[?2004h"]
[5072.716605, "o", "root@n30009:/app# "]
[5072.983163, "i", "sed -n '221,460p' main.go\n"]
[5072.983402, "o", "sed -n '221,460p' main.go\r\n\u001b[?2004l\r"]
[5072.986225, "o", "\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tif experimentName == \"\" {\r\n\t\t\texperimentName = cfg.Experiment\r\n\t\t}\r\n\t\t"]
[5072.986313, "o", "if outputDir == \"\" {\r\n\t\t\toutputDir = cfg.OutputDir\r\n\t\t}\r\n\r\n\t\tcliParams, _ := config.ParseParams(paramStrs)\r\n\t\tcliParamMap := make(map[string]float64)\r\n\t\tfor _, p := range cliParams {\r\n\t\t\tcliParamMap[p.Name] = p.Value\r\n\t\t}\r\n\t\tfor _, p := range cfg.Params {\r\n\t\t\tif _, exists := cliParamMap[p.Name]; !exists {\r\n"]
[5072.986391, "o", "\t\t\t\tcliParams = append(cliParams, p)\r\n\t\t\t}\r\n\t\t}\r\n\t\tparamStrs = nil\r\n\t\tfor _, p := range cliParams {\r\n\t\t\tparamStrs = append(paramStrs, fmt.Sprintf(\"%s=%g\", p.Name, p.Value))\r\n\t\t}\r\n\t}\r\n\r\n\tif experimentName == \"\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: --experiment is required\\n\")\r\n\t\tos.Exit(1)\r\n"]
[5072.98647, "o", "\t}\r\n\tif outputDir == \"\" {\r\n\t\toutputDir = \"./results\"\r\n\t}\r\n\r\n\tparams, err := config.ParseParams(paramStrs)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"parameter error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfn, err := engine.Get(experimentName)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[5072.98655, "o", "\r\n\tif !seedProvided {\r\n\t\tseed = time.Now().UnixNano()\r\n\t}\r\n\r\n\trng := engine.NewRNG(seed)\r\n\r\n\tresult, err := fn(experimentName, params, rng)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"experiment error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[5072.986619, "o", "\tif result.Metadata == nil {\r\n\t\tresult.Metadata = map[string]string{}\r\n\t}\r\n\tif _, ok := result.Metadata[\"seed\"]; !ok {\r\n\t\tresult.Metadata[\"seed\"] = strconv.FormatInt(seed, 10)\r\n\t}\r\n\tif seedProvided {\r\n\t\tresult.Metadata[\"seed_source\"] = \"provided\"\r\n\t} else {\r\n\t\tresult.Metadata[\"seed_source\"] = \"auto-generated\"\r\n\t}\r\n"]
[5072.986691, "o", "\r\n\tfor k, v := range environmentMetadata() {\r\n\t\tresult.Metadata[k] = v\r\n\t}\r\n\tfor _, tag := range tagStrs {\r\n\t\tk, v := parseTagFlag(tag)\r\n\t\tresult.Metadata[k] = v\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(outputDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n"]
[5072.986761, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid, err := store.Save(result)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"save error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tfmt.Printf(\"Experiment: %s\\n\", experimentName)\r\n\tfmt.Printf(\"Result ID: %s\\n\", id)\r\n\tfmt.Printf(\"Values:\\n\")\r\n\tfor i, v := range result.Values {\r\n"]
[5072.986826, "o", "\t\tlabel := fmt.Sprintf(\"[%d]\", i)\r\n\t\tif i < len(result.Labels) {\r\n\t\t\tlabel = result.Labels[i]\r\n\t\t}\r\n\t\tfmt.Printf(\"  %s = %.15e\\n\", label, v)\r\n\t}\r\n}\r\n\r\nfunc cmdCompare(args []string) {\r\n\tif len(args) < 2 {\r\n"]
[5072.986894, "o", "\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid1 := args[0]\r\n\tid2 := args[1]\r\n\tstoreDir := \"./results\"\r\n\tmode := \"exact\"\r\n\ttol := compare.DefaultTolerance()\r\n\r\n\tfor i := 2; i < len(args); i++ {\r\n"]
[5072.986969, "o", "\t\tswitch args[i] {\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\t"]
[5072.987036, "o", "fmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tcase \"--mode\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --mode requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tmode = args[i]\r\n\t\tcase \"--abs-tol\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n"]
