[2273.556557, "o", "\t\tif i >= len(args) {\r\n    94\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --config requires a value\\n\")\r\n    95\t\t\t\t\tos.Exit(1)\r\n    96\t\t\t\t}\r\n    97\t\t\t\tconfigPath = args[i]\r\n    98\t\t\tcase \"--param\":\r\n    99\t\t\t\ti++\r\n   100\t\t\t\tif i >= len(args) {\r\n   101\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --param requires a value\\n\")\r\n"]
