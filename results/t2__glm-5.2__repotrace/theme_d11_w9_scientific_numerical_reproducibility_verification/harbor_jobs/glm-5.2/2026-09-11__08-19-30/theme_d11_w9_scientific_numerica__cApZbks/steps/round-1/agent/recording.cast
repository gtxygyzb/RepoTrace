[306.34813, "o", "\r\n    17\t\tID             string            `json:\"id\"`\r\n    18\t\tExperimentName string            `json:\"experiment_name\"`\r\n    19\t\tTimestamp      time.Time         `json:\"timestamp\"`\r\n    20\t\tParameters     []engine.Parameter `json:\"parameters\"`\r\n    21\t\tValues         []float64         `json:\"values\"`\r\n    22\t\tLabels         []string          `json:\"labels\"`\r\n    23\t\tMetadata       map[string]string `json:\"metadata\"`\r\n    24\t\t// TODO: Add Checksum field for result integrity verification.\r\n"]
