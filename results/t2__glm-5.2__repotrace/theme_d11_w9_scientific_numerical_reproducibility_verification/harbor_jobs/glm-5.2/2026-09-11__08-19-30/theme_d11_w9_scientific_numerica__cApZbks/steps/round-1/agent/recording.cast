[3652.777947, "o", "   658\t\tif err != nil {\r\n   659\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\\n\", id, err)\r\n   660\t\t}\r\n   661\t\r\n   662\t\tfn, err := engine.Get(stored.ExperimentName)\r\n   663\t\tif err != nil {\r\n   664\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n   665\t\t}\r\n   666\t\r\n   667\t\trng := engine.NewRNG(seed)\r\n"]
[3652.77801, "o", "   668\t\treexec, err := fn(stored.ExperimentName, stored.Parameters, rng)\r\n   669\t\tif err != nil {\r\n   670\t\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n   671\t\t}\r\n   672\t\r\n   673\t\tmaxLen := len(stored.Values)\r\n   674\t\tif len(reexec.Values) > maxLen {\r\n   675\t\t\tmaxLen = len(reexec.Values)\r\n"]
[3652.778072, "o", "   676\t\t}\r\n   677\t\r\n   678\t\tvar mismatches []string\r\n   679\t\tfor i := 0; i < maxLen; i++ {\r\n   680\t\t\tstoredMissing := i >= len(stored.Values)\r\n   681\t\t\treexecMissing := i >= len(reexec.Values)\r\n   682\t\r\n   683\t\t\tvar storedVal, reexecVal string\r\n   684\t\t\tif storedMissing {\r\n"]
[3652.778138, "o", "   685\t\t\t\tstoredVal = \"<missing>\"\r\n   686\t\t\t} else {\r\n   687\t\t\t\tstoredVal = strconv.FormatFloat(stored.Values[i], 'g', -1, 64)\r\n   688\t\t\t}\r\n   689\t\t\tif reexecMissing {\r\n   690\t\t\t\treexecVal = \"<missing>\"\r\n   691\t\t\t} else {\r\n   692\t\t\t\treexecVal = strconv.FormatFloat(reexec.Values[i], 'g', -1, 64)\r\n   693\t\t\t}\r\n   694"]
[3652.778204, "o", "\t\r\n   695\t\t\tif storedMissing || reexecMissing || math.Float64bits(stored.Values[i]) != math.Float64bits(reexec.Values[i]) {\r\n   696\t\t\t\tmismatches = append(mismatches, fmt.Sprintf(\"  value[%d]: stored=%s, re-executed=%s\", i, storedVal, reexecVal))\r\n   697\t\t\t}\r\n   698\t\t}\r\n   699\t\r\n   700\t\tif len(mismatches) == 0 {\r\n   701\t\t\treturn true, fmt.Sprintf(\"AUDIT_PASS: %s\\n\", id)\r\n   702\t\t}\r\n   703\t\r\n"]
[3652.778269, "o", "   704\t\tvar sb strings.Builder\r\n   705\t\tsb.WriteString(fmt.Sprintf(\"AUDIT_FAIL: %s\\n\", id))\r\n   706\t\tfor _, m := range mismatches {\r\n   707\t\t\tsb.WriteString(m)\r\n   708\t\t\tsb.WriteByte('\\n')\r\n   709\t\t}\r\n   710\t\treturn false, sb.String()\r\n   711\t}\r\n   712\t"]
[3652.778333, "o", "\r\n   713\tfunc warnEnvMismatch(stored *storage.StoredResult) {\r\n   714\t\tmsg, ok := envMismatchWarning(stored.Metadata)\r\n   715\t\tif ok {\r\n   716\t\t\tfmt.Fprintln(os.Stderr, msg)\r\n   717\t\t}\r\n   718\t}\r\n   719\t\r\n   720\tfunc envMismatchWarning(metadata map[string]string) (string, bool) {\r\n   721\t\tcurrent := environmentMetadata()\r\n"]
[3652.7784, "o", "   722\t\tfields := []string{\"env_go_version\", \"env_os\", \"env_arch\", \"env_hostname\"}\r\n   723\t\r\n   724\t\tvar diffs []string\r\n   725\t\tfor _, field := range fields {\r\n"]
[3652.778462, "o", "   726\t\t\tif metadata[field] != current[field] {\r\n   727\t\t\t\tdiffs = append(diffs, fmt.Sprintf(\"%s stored=%q current=%q\", field, metadata[field], current[field]))\r\n   728\t\t\t}\r\n   729\t\t}\r\n   730\t\r\n   731\t\tif len(diffs) == 0 {\r\n   732\t\t\treturn \"\", false\r\n   733\t\t}\r\n   734\t\treturn fmt.Sprintf(\"WARNING: ENV_MISMATCH (%s)\", strings.Join(diffs, \", \")), true\r\n   735\t}\r\n"]
