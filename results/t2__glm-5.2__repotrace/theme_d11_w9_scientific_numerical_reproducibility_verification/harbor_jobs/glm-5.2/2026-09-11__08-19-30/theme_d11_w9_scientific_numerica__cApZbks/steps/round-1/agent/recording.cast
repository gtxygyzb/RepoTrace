[5213.769017, "o", "    76\t// environmentMetadata returns the environment fingerprint metadata required for\r\n    77\t// reproducible experiment traces.\r\n    78\tfunc environmentMetadata() map[string]string {\r\n    79\t\thostname, err := os.Hostname()\r\n    80\t\tif err != nil {\r\n    81\t\t\thostname = \"unknown\"\r\n    82\t\t}\r\n    83\t\treturn map[string]string{\r\n    84\t\t\t\"env_go_version\": runtime.Version(),\r\n    85\t\t\t\"env_os\":         runtime.GOOS,\r\n    86\t\t\t\"env_arch\":       runtime.GOARCH,\r\n"]
[5213.769191, "o", "    87\t\t\t\"env_hostname\":   hostname,\r\n    88\t\t}\r\n    89\t}\r\n    90\t\r\n    91\t// environmentFromMetadata aggregates stored environment fingerprint metadata\r\n    92\t// into an export-friendly object.\r\n    93\ttype environmentInfo struct {\r\n    94\t\tGoVersion string `json:\"go_version\"`\r\n    95\t\tOS        string `json:\"os\"`\r\n    96\t\tArch      string `json:\"arch\"`\r\n    97\t\tHostname  string `json:\"hostname\"`\r\n    98\t}\r\n    99\t\r\n   100\tfunc environmentFromMetadata(metadata map[string]string) environmentInfo {\r\n   101\t\treturn environmentInfo{\r\n   102\t\t\tGoVersion: metadata[\"env_go_version\"],\r\n   103\t\t\tOS:        metadata[\"env_os\"],\r\n   104\t\t\tArch:      metadata[\"env_arch\"],\r\n   105\t\t\tHostname:  metadata[\"env_hostname\"],\r\n   106\t\t}\r\n   107\t}\r\n   108\t\r\n   109\ttype exportPayload struct {\r\n   110\t\t*storage.StoredResult\r\n   111\t\tEnvironment environmentInfo   `json:\"environment\"`\r\n   112\t\tTags        map[string]string `json:\"tags,omitempty\"`\r\n"]
[5213.769275, "o", "   113\t}\r\n   114\t\r\n   115\t// tagsFromMetadata collects tag_<key> metadata entries into an export-friendly\r\n   116\t// map without the tag_ prefix. It returns nil when no tags are present.\r\n   117\tfunc tagsFromMetadata(metadata map[string]string) map[string]string {\r\n   118\t\tif metadata == nil {\r\n   119\t\t\treturn nil\r\n   120\t\t}\r\n"]
