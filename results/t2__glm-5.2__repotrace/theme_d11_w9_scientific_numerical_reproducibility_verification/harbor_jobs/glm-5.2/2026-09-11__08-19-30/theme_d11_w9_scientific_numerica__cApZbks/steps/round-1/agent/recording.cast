[2830.366812, "o", "\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"load error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch format {\r\n\tcase \"json\":\r\n\t\tpayload := exportPayload{\r\n\t\t\tStoredResult: result,\r\n\t\t\tEnvironment:  environmentFromMetadata(result.Metadata),"]
[2830.366885, "o", "\r\n\t\t}\r\n\t\tdata, err := json.MarshalIndent(payload, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"marshal error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t"]
[2830.366944, "o", "\t}\r\n\t\tfmt.Println(string(data))\r\n\tcase \"csv\":\r\n\t\tfmt.Printf(\"# id: %s\\n\", result.ID)\r\n\t\tfmt.Printf(\"# experiment: %s\\n\", result.ExperimentName)\r\n\t\tfmt.Printf(\"# timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n\t\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n\t\t\tfmt.Printf(\"# seed: %s\\n\", seed)\r\n"]
[2830.367012, "o", "\t\t}\r\n\t\tfmt.Println(\"label,value\")\r\n\t\tfor i, v := range result.Values {\r\n\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n"]
[2830.367073, "o", "\t\t\tif i < len(result.Labels) {\r\n\t\t\t\tlabel = result.Labels[i]\r\n\t\t\t}\r\n\t\t\tfmt.Printf(\"%s,%.15e\\n\", label, v)\r\n\t\t}\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown format: %s\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
