[3903.889919, "o", "drwxr-xr-x 1 root root    4096 Sep 11 01:18 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root    4096 Sep 11 01:25 \u001b[01;34m..\u001b[0m\r\ndrwxrwxr-x 1 root root    4096 Sep 11 00:34 \u001b[01;34mcompare\u001b[0m\r\ndrwxrwxr-x 2 root root    4096 Jul 21 12:51 \u001b[01;34mconfig\u001b[0m\r\n"]
