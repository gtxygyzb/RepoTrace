[3409.658282, "o", "   609\t\tentries, err := store.ListResults(\"\")\r\n   610\t\tif err != nil {\r\n   611\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   612\t\t\tos.Exit(1)\r\n   613\t\t}\r\n   614\t\r\n   615\t\tpassed := 0\r\n   616\t\tfailed := 0\r\n   617\t\ttotal := len(entries)\r\n"]
