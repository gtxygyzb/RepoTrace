[3941.936523, "o", "   463\t\t\tpayload := exportPayload{\r\n   464\t\t\t\tStoredResult: result,\r\n   465\t\t\t\tEnvironment:  environmentFromMetadata(result.Metadata),\r\n   466\t\t\t}\r\n   467\t\t\tdata, err := json.MarshalIndent(payload, \"\", \"  \")\r\n   468\t\t\tif err != nil {\r\n   469\t\t\t\tfmt.Fprintf(os.Stderr, \"marshal error: %v\\n\", err)\r\n   470\t\t\t\tos.Exit(1)\r\n   471\t\t\t}\r\n   472\t\t\tfmt.Println(string(data))\r\n   473\t\tcase \"csv\":\r\n   474\t\t\tfmt.Printf(\"# id: %s\\n\", result.ID)\r\n   475\t\t\tfmt.Printf(\"# experiment: %s\\n\", result.ExperimentName)\r\n   476\t\t\tfmt.Printf(\"# timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n   477\t\t\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n   478\t\t\t\tfmt.Printf(\"# seed: %s\\n\", seed)\r\n   479\t\t\t}\r\n   480\t\t\tfmt.Println(\"label,value\")\r\n"]
