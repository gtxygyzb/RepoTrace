[5413.636782, "o", "\u001b[?2004h> "]
[5413.636989, "o", "                status, _, _, err := store.Verify(entry.ID)\r\n\u001b[?2004l\r"]
[5413.637044, "o", "\u001b[?2004h> "]
[5413.637153, "o", "                if err != nil {\r\n\u001b[?2004l\r"]
[5413.637208, "o", "\u001b[?2004h> "]
[5413.637311, "o", "                        fail++\r\n\u001b[?2004l\r"]
[5413.637366, "o", "\u001b[?2004h> "]
