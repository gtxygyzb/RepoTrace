[4633.154696, "o", "fmt.Println(\"label,value\")\r\n   558\t\t\tfor i, v := range result.Values {\r\n   559\t\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n   560\t\t\t\tif i < len(result.Labels) {\r\n   561\t\t\t\t\tlabel = result.Labels[i]\r\n   562\t\t\t\t}\r\n   563\t\t\t\tfmt.Printf(\"%s,%.15e\\n\", label, v)\r\n   564\t\t\t}\r\n   565\t\tcase \"markdown\":\r\n   566\t\t\tfmt.Printf(\"# %s (%s)\\n\", result.ExperimentName, result.ID)\r\n   567\t\t\tfmt.Println()\r\n   568\t\t\tfmt.Println(\"## Metadata\")\r\n   569\t\t\tfmt.Printf(\"- timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n   570\t\t\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n"]
[4633.154788, "o", "   571\t\t\t\tfmt.Printf(\"- seed: %s\\n\", seed)\r\n   572\t\t\t} else {\r\n   573\t\t\t\tfmt.Println(\"- seed: \")\r\n   574\t\t\t}\r\n   575\t\t\tfmt.Printf(\"- go_version: %s\\n\", metadataOrDefault(result.Metadata, \"env_go_version\", \"unknown\"))\r\n   576\t\t\tfmt.Printf(\"- os: %s\\n\", metadataOrDefault(result.Metadata, \"env_os\", \"unknown\"))\r\n   577\t\t\tfmt.Printf(\"- arch: %s\\n\", metadataOrDefault(result.Metadata, \"env_arch\", \"unknown\"))\r\n   578\t\t\tfmt.Printf(\"- hostname: %s\\n\", metadataOrDefault(result.Metadata, \"env_hostname\", \"unknown\"))\r\n   579\t\t\tfmt.Println()\r\n   580\t\t\tfmt.Println(\"## Results\")\r\n"]
[4633.15488, "o", "   581\t\t\tfmt.Println(\"| Label | Value |\")\r\n   582\t\t\tfmt.Println(\"|---|---|\")\r\n   583\t\t\tfor i, v := range result.Values {\r\n   584\t\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n   585\t\t\t\tif i < len(result.Labels) {\r\n   586\t\t\t\t\tlabel = result.Labels[i]\r\n   587\t\t\t\t}\r\n   588\t\t\t\tfmt.Printf(\"| %s | %.15g |\\n\", label, v)\r\n   589\t\t\t}\r\n   590\t\tdefault:\r\n   591\t\t\tfmt.Fprintf(os.Stderr, \"unknown format: %s\\n\", format)\r\n   592\t\t\tos.Exit(1)\r\n   593\t\t}\r\n   594\t}\r\n   595\t\r\n"]
[4633.154962, "o", "   596\tfunc metadataOrDefault(metadata map[string]string, key, fallback string) string {\r\n   597\t\tif value, ok := metadata[key]; ok && value != \"\" {\r\n   598\t\t\treturn value\r\n   599\t\t}\r\n   600\t\treturn fallback\r\n"]
