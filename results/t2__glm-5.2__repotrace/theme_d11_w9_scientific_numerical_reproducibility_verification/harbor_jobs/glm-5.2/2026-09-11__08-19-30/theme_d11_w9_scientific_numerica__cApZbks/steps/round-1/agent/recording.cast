[4777.887266, "o", "     1\tpackage storage\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/sha256\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n"]
[4777.887373, "o", "     9\t\t\"sort\"\r\n    10\t\t\"strings\"\r\n    11\t\t\"time\"\r\n    12\t\r\n    13\t\t\"numeriforge/engine\"\r\n    14\t)\r\n    15\t\r\n    16\t// StoredResult is the on-disk representation of an experiment result.\r\n    17\ttype StoredResult struct {\r\n    18\t\tID             string             `json:\"id\"`\r\n    19\t\tExperimentName string             `json:\"experiment_name\"`\r\n    20\t\tTimestamp      time.Time          `json:\"timestamp\"`\r\n    21\t\tParameters     []engine.Parameter `json:\"parameters\"`\r\n    22\t\tValues         []float64          `json:\"values\"`\r\n    23\t\tLabels         []string           `json:\"labels\"`\r\n    24\t\tMetadata       map[string]string  `json:\"metadata\"`\r\n"]
[4777.887453, "o", "    25\t\tChecksum       string             `json:\"checksum,omitempty\"`\r\n    26\t}\r\n    27\t\r\n    28\t// VerifyStatus reports the outcome of integrity verification.\r\n    29\ttype VerifyStatus string\r\n    30\t\r\n    31\tconst (\r\n    32\t\tStatusVerified   VerifyStatus = \"verified\"\r\n    33\t\tStatusCorrupted  VerifyStatus = \"corrupted\"\r\n    34\t\tStatusNoChecksum VerifyStatus = \"no_checksum\"\r\n"]
[4777.88756, "o", "    35\t)\r\n    36\t\r\n    37\t// IndexEntry is a stored result index record.\r\n    38\ttype IndexEntry struct {\r\n    39\t\tID             string\r\n    40\t\tExperimentName string\r\n    41\t\tTimestamp      time.Time\r\n    42\t}\r\n    43\t\r\n"]
[4777.887628, "o", "    44\t// Store manages experiment result persistence.\r\n    45\ttype Store struct {\r\n    46\t\tBaseDir string\r\n    47\t}\r\n    48\t\r\n    49\t// NewStore creates a store at the given directory.\r\n    50\tfunc NewStore(baseDir string) (*Store, error) {\r\n    51\t\tif err := os.MkdirAll(baseDir, 0755); err != nil {\r\n    52\t\t\treturn nil, fmt.Errorf(\"cannot create store directory: %w\", err)\r\n    53\t\t}\r\n    54\t\treturn &Store{BaseDir: baseDir}, nil\r\n    55\t}\r\n    56\t\r\n    57\t// ComputeChecksum returns the SHA-256 checksum of the canonical value\r\n"]
[4777.887692, "o", "    58\t// representation defined by the reproducibility specification.\r\n    59\tfunc ComputeChecksum(values []float64) string {\r\n    60\t\tvar sb strings.Builder\r\n    61\t\tfor i, v := range values {\r\n    62\t\t\tif i > 0 {\r\n    63\t\t\t\tsb.WriteByte('\\n')\r\n    64\t\t\t}\r\n    65\t\t\tfmt.Fprintf(&sb, \"%.17e\", v)\r\n    66\t\t"]
[4777.887755, "o", "}\r\n    67\t\tsum := sha256.Sum256([]byte(sb.String()))\r\n    68\t\treturn fmt.Sprintf(\"%x\", sum)\r\n    69\t}\r\n    70\t\r\n    71\t// Save persists an experiment result to disk.\r\n    72\tfunc (s *Store) Save(result *engine.Result) (string, error) {\r\n    73\t\tid := fmt.Sprintf(\"%s_%s\", result.ExperimentName, result.Timestamp.Format(\"20060102_150405\"))\r\n    74\t\r\n    75\t\tchecksum := ComputeChecksum(result.Values)\r\n    76\t\r\n"]
[4777.887814, "o", "    77\t\tif result.Metadata == nil {\r\n    78\t\t\tresult.Metadata = map[string]string{}\r\n    79\t\t}\r\n    80\t\tresult.Metadata[\"values_checksum\"] = checksum\r\n    81\t\r\n    82\t\tstored := StoredResult{\r\n    83\t\t\tID:             id,\r\n    84\t\t\t"]
[4777.887873, "o", "ExperimentName: result.ExperimentName,\r\n    85\t\t\tTimestamp:      result.Timestamp,\r\n    86\t\t\tParameters:     result.Parameters,\r\n    87\t\t\tValues:         result.Values,\r\n    88\t\t\tLabels:         result.Labels,\r\n    89\t\t\tMetadata:       result.Metadata,\r\n    90\t\t\tChecksum:       checksum,\r\n    91\t\t}\r\n    92\t\r\n"]
[4777.887937, "o", "    93\t\tdata, err := json.MarshalIndent(stored, \"\", \"  \")\r\n    94\t\tif err != nil {\r\n    95\t\t\treturn \"\", fmt.Errorf(\"marshal error: %w\", err)\r\n    96\t\t}\r\n    97\t\r\n    98\t\tresultDir := filepath.Join(s.BaseDir, result.ExperimentName)\r\n    99\t\tif err := os.MkdirAll(resultDir, 0755); err != nil {\r\n   100\t\t\treturn \"\", fmt.Errorf(\"cannot create result directory: %w\", err)\r\n   101\t\t}\r\n   102\t\r\n"]
[4777.887995, "o", "   103\t\tpath := filepath.Join(resultDir, id+\".json\")\r\n   104\t\tif err := os.WriteFile(path, data, 0644); err != nil {\r\n   105\t\t\treturn \"\", fmt.Errorf(\"write error: %w\", err)\r\n   106\t\t}\r\n   107\t\r\n   108\t\tif err := s.updateIndex(id, result.ExperimentName, result.Timestamp); err != nil {\r\n"]
[4777.888053, "o", "   109\t\t\treturn \"\", fmt.Errorf(\"index update error: %w\", err)\r\n   110\t\t}\r\n   111\t\r\n   112\t\treturn id, nil\r\n   113\t}\r\n   114\t\r\n   115\t// Load reads a stored result by ID.\r\n   116\tfunc (s *Store) Load(id string) (*StoredResult, error) {\r\n   117\t\tvar resultPath string\r\n"]
[4777.888118, "o", "   118\t\terr := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {\r\n   119\t\t\tif err != nil {\r\n   120\t\t\t\treturn err\r\n   121\t\t\t}\r\n   122\t\t\tif !info.IsDir() && strings.TrimSuffix(info.Name(), \".json\") == id {\r\n   123\t\t\t\tresultPath = path\r\n   124\t\t\t\treturn filepath.SkipAll\r\n   125\t\t\t}\r\n   126\t\t\treturn nil\r\n"]
[4777.888178, "o", "   127\t\t})\r\n   128\t\tif err != nil {\r\n   129\t\t\treturn nil, err\r\n   130\t\t}\r\n   131\t\tif resultPath == \"\" {\r\n   132\t\t\treturn nil, fmt.Errorf(\"result not found: %s\", id)\r\n   133\t\t}\r\n   134\t\r\n"]
[4777.888237, "o", "   135\t\tdata, err := os.ReadFile(resultPath)\r\n   136\t\tif err != nil {\r\n   137\t\t\treturn nil, fmt.Errorf(\"read error: %w\", err)\r\n   138\t\t}\r\n   139\t\r\n   140\t\tvar stored StoredResult\r\n   141\t\tif err := json.Unmarshal(data, &stored); err != nil {\r\n   142\t\t\treturn nil, fmt.Errorf(\"unmarshal error: %w\", err)\r\n   143\t\t}\r\n   144\t"]
[4777.888302, "o", "\treturn &stored, nil\r\n   145\t}\r\n   146\t\r\n   147\t// ListResults returns all stored result IDs, optionally filtered by experiment name.\r\n   148\tfunc (s *Store) ListResults(experimentFilter string) ([]IndexEntry, error) {\r\n   149\t\tentries, err := s.readIndex()\r\n   150\t\tif err != nil {\r\n   151\t\t\treturn nil, err\r\n   152"]
[4777.888357, "o", "\t\t}\r\n   153\t\r\n   154\t\tif experimentFilter == \"\" {\r\n   155\t\t\treturn entries, nil\r\n   156\t\t}\r\n   157\t\r\n   158\t\tfiltered := make([]IndexEntry, 0)\r\n   159\t\tfor _, entry := range entries {\r\n"]
[4777.888418, "o", "   160\t\t\tif entry.ExperimentName == experimentFilter {\r\n   161\t\t\t\tfiltered = append(filtered, entry)\r\n   162\t\t\t}\r\n   163\t\t}\r\n   164\t\treturn filtered, nil\r\n   165\t}\r\n   166\t\r\n   167\t// Verify checks stored result integrity by recomputing the canonical checksum.\r\n   168\tfunc (s *Store) Verify(id string) (VerifyStatus, string, string, error) {\r\n   169"]
[4777.888503, "o", "\t\tstored, err := s.Load(id)\r\n   170\t\tif err != nil {\r\n   171\t\t\treturn \"\", \"\", \"\", err\r\n   172\t\t}\r\n   173\t\r\n"]
[4777.888571, "o", "   174\t\tif stored.Checksum == \"\" {\r\n   175\t\t\treturn StatusNoChecksum, \"\", \"\", nil\r\n   176\t\t}\r\n   177\t\r\n   178\t\tcomputed := ComputeChecksum(stored.Values)\r\n   179\t\tif computed == stored.Checksum {\r\n   180\t\t\treturn StatusVerified, stored.Checksum, computed, nil\r\n   181\t\t}\r\n   182\t\treturn StatusCorrupted, stored.Checksum, computed, nil\r\n   183\t}\r\n   184\t\r\n   185\tfunc (s *Store) indexPath() string {\r\n   186\t\treturn filepath.Join(s.BaseDir, \"index.txt\")\r\n   187\t}\r\n   188\t\r\n   189"]
[4777.888631, "o", "\tfunc (s *Store) updateIndex(id, experimentName string, timestamp time.Time) error {\r\n   190\t\tif err := os.MkdirAll(s.BaseDir, 0755); err != nil {\r\n   191\t\t\treturn err\r\n   192\t\t}\r\n   193\t\r\n   194\t\tf, err := os.OpenFile(s.indexPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)\r\n   195\t\tif err != nil {\r\n   196\t\t\treturn err\r\n   197\t\t}\r\n   198\t"]
[4777.888696, "o", "\tdefer f.Close()\r\n   199\t\r\n   200\t\t_, err = fmt.Fprintf(f, \"%s|%s|%s\\n\", id, experimentName, timestamp.Format(time.RFC3339))\r\n   201\t\treturn err\r\n   202\t}\r\n   203\t\r\n   204\tfunc (s *Store) readIndex() ([]IndexEntry, error) {\r\n   205\t\tdata, err := os.ReadFile(s.indexPath())\r\n   206\t\tif err != nil {\r\n   207\t\t\t"]
