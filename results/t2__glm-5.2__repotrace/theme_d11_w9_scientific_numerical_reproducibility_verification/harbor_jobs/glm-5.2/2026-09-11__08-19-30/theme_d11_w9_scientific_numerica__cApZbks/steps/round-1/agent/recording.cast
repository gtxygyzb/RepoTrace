[2821.800977, "o", "\u001b[?2004h"]
[2821.801024, "o", "> "]
[2821.801217, "o", "\\tfmt.Printf(\"# id: %s\\\\n\", result.ID)\r\n\u001b[?2004l\r"]
[2821.801268, "o", "\u001b[?2004h> "]
