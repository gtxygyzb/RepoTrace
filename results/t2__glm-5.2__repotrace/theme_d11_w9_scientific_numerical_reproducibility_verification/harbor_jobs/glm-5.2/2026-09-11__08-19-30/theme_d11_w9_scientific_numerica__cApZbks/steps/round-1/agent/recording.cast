[2259.253844, "o", "\u001b[35m\u001b[K./engine/ode.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"euler\", \"system\": sysNames[sysIdx]},\r\n"]
[2259.253938, "o", "\u001b[35m\u001b[K./engine/ode.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"rk4\", \"system\": sysNames[sysIdx]},\r\n\u001b[35m\u001b[K./engine/ode.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K335\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"rk4_with_noise\", \"system\": sysNames[sysIdx]},\r\n"]
[2259.254013, "o", "\u001b[35m\u001b[K./engine/engine.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K       map[string]string\r\n"]
[2259.25408, "o", "\u001b[35m\u001b[K./engine/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"welch_ttest\"},\r\n\u001b[35m\u001b[K./engine/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"chi_squared_gof\", \"null_hypothesis\": \"uniform\"},\r\n"]
[2259.254139, "o", "\u001b[35m\u001b[K./engine/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"two_sample_ks\"},\r\n"]
[2259.2542, "o", "\u001b[35m\u001b[K./engine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"circle_square\"},\r\n\u001b[35m\u001b[K./engine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"simple_mc\", \"integrand\": \"sin(x)*exp(-x^2/2)\"},\r\n"]
[2259.254262, "o", "\u001b[35m\u001b[K./engine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"importance_sampling\", \"status\": \"no_accepted_samples\"},\r\n\u001b[35m\u001b[K./engine/montecarlo.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"importance_sampling\", \"integrand\": \"sin(x)*exp(-x^2/2)\"},\r\n"]
[2259.254344, "o", "\u001b[35m\u001b[K./engine/matrix.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"partial_pivoting\", \"matrix_type\": \"random_dense\"},\r\n"]
[2259.254402, "o", "\u001b[35m\u001b[K./engine/matrix.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"modified_gram_schmidt\", \"matrix_type\": \"random_dense\"},\r\n\u001b[35m\u001b[K./engine/matrix.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K391\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       map[string]string{\"method\": \"power_iteration\", \"matrix_type\": \"spd\"},\r\n"]
[2259.254547, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KcmdRun\u001b[m\u001b[K(os.Args[2:])\r\n"]
[2259.254618, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KcmdExport\u001b[m\u001b[K(os.Args[2:])\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcmdRun\u001b[m\u001b[K(args []string) {\r\n"]
[2259.254676, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K == nil {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K = map[string]string{}\r\n"]
[2259.254735, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif _, ok := result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed\"]; !ok {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed\"] = strconv.FormatInt(seed, 10)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed_source\"] = \"provided\"\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed_source\"] = \"auto-generated\"\r\n"]
[2259.254799, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcmdExport\u001b[m\u001b[K(args []string) {\r\n"]
[2259.255131, "o", "\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K       map[string]string  `json:\"metadata\"`\r\n"]
[2259.255191, "o", "\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K == nil {\r\n\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K = map[string]string{}\r\n\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"values_checksum\"] = checksum\r\n\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K,\r\n"]
