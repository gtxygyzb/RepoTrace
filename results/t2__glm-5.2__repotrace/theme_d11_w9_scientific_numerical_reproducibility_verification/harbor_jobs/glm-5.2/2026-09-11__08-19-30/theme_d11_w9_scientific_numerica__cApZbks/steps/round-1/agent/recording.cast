[5073.269883, "o", "\t\tStoredResult: result,\r\n\t\t\tEnvironment:  environmentFromMetadata(result.Metadata),\r\n\t\t\tTags:         tagsFromMetadata(result.Metadata),\r\n\t\t}\r\n\t\tdata, err := json.MarshalIndent(payload, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"marshal error: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Println(string(data))\r\n\t"]
[5073.269949, "o", "case \"csv\":\r\n\t\tfmt.Printf(\"# id: %s\\n\", result.ID)\r\n\t\tfmt.Printf(\"# experiment: %s\\n\", result.ExperimentName)\r\n\t\tfmt.Printf(\"# timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n\t\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n\t\t\tfmt.Printf(\"# seed: %s\\n\", seed)\r\n\t\t}\r\n\t\tfmt.Println(\"label,value\")\r\n"]
[5073.270016, "o", "\t\tfor i, v := range result.Values {\r\n\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n\t\t\tif i < len(result.Labels) {\r\n\t\t\t\tlabel = result.Labels[i]\r\n\t\t\t}\r\n\t\t\tfmt.Printf(\"%s,%.15e\\n\", label, v)\r\n\t\t}\r\n\tcase \"markdown\":\r\n\t\t"]
[5073.270086, "o", "fmt.Printf(\"# %s (%s)\\n\", result.ExperimentName, result.ID)\r\n\t\tfmt.Println()\r\n\t\tfmt.Println(\"## Metadata\")\r\n\t\tfmt.Printf(\"- timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n\t\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n\t\t\tfmt.Printf(\"- seed: %s\\n\", seed)\r\n\t\t} else {\r\n\t\t\tfmt.Println(\"- seed: \")\r\n\t\t}\r\n\t\tfmt.Printf(\"- go_version: %s\\n\", metadataOrDefault(result.Metadata, \"env_go_version\", \"unknown\"))\r\n\t\tfmt.Printf(\"- os: %s\\n\", metadataOrDefault(result.Metadata, \"env_os\", \"unknown\"))\r\n"]
[5073.270156, "o", "\t\tfmt.Printf(\"- arch: %s\\n\", metadataOrDefault(result.Metadata, \"env_arch\", \"unknown\"))\r\n\t\tfmt.Printf(\"- hostname: %s\\n\", metadataOrDefault(result.Metadata, \"env_hostname\", \"unknown\"))\r\n\t\tfmt.Println()\r\n\t\tfmt.Println(\"## Results\")\r\n\t\tfmt.Println(\"| Label | Value |\")\r\n\t\tfmt.Println(\"|---|---|\")\r\n\t\tfor i, v := range result.Values {\r\n\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n"]
[5073.270226, "o", "\t\t\tif i < len(result.Labels) {\r\n\t\t\t\tlabel = result.Labels[i]\r\n\t\t\t}\r\n\t\t\tfmt.Printf(\"| %s | %.15g |\\n\", label, v)\r\n\t\t}\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown format: %s\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc metadataOrDefault(metadata map[string]string, key, fallback string) string {\r\n\tif value, ok := metadata[key]; ok && value != \"\" {\r\n"]
[5073.270294, "o", "\t\treturn value\r\n\t}\r\n\treturn fallback\r\n}\r\n\r\nfunc cmdVerify(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid := args[0]\r\n"]
[5073.270361, "o", "\tstoreDir := \"./results\"\r\n\tverbose := false\r\n\r\n\tfor i := 1; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--verbose\":\r\n\t\t\tverbose = true\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\t"]
[5073.270427, "o", "fmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(storeDir)\r\n"]
[5073.270503, "o", "\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tstatus, expected, computed, err := store.Verify(id)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"verify error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n"]
[5073.270569, "o", "\t}\r\n\r\n\tswitch status {\r\n\tcase storage.StatusVerified:\r\n\t\tfmt.Printf(\"INTEGRITY_OK: %s\\n\", id)\r\n\t\tif verbose {\r\n\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n\t\t}\r\n\t\tos.Exit(0)\r\n\tcase storage.StatusCorrupted:\r\n\t\tfmt.Printf(\"INTEGRITY_FAIL: %s\\n\", id)\r\n\t"]
[5073.270643, "o", "\tif verbose {\r\n\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n\t\t}\r\n\t\tos.Exit(1)\r\n\tcase storage.StatusNoChecksum:\r\n\t\tfmt.Printf(\"NO_CHECKSUM: %s\\n\", id)\r\n\t\tos.Exit(2)\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown verification status: %s\\n\", status)\r\n\t\tos.Exit(1)\r\n\t}"]
[5073.270712, "o", "\r\n}\r\nfunc cmdAudit(args []string) {\r\n\tall := false\r\n\tvar positionals []string\r\n\tstoreDir := \"./results\"\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--all\":\r\n\t\t\tall = true\r\n"]
[5073.27078, "o", "\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tdefault:\r\n\t\t\tif strings.HasPrefix(args[i], \"-\") {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\t\tos.Exit(1)\r\n"]
[5073.270858, "o", "\t\t\t}\r\n\t\t\tpositionals = append(positionals, args[i])\r\n\t\t}\r\n\t}\r\n\r\n\tif all {\r\n\t\tif len(positionals) != 0 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: --all does not accept result IDs\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tcmdAuditAll(storeDir)\r\n\t\treturn\r\n\t}\r\n"]
[5073.270926, "o", "\r\n\tif len(positionals) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge audit <result_id> --store-dir <dir>\\n\")\r\n\t\tfmt.Fprintf(os.Stderr, \"       numeriforge audit --all --store-dir <dir>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif len(positionals) > 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"error: too many arguments\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[5073.270998, "o", "\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tstatus, details := auditStoredResult(store, positionals[0])\r\n\tfmt.Print(details)\r\n\tif status == auditFail {\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\n"]
[5073.271074, "o", "func cmdAuditAll(storeDir string) {\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := store.ListResults(\"\")\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tpassed := 0\r\n"]
[5073.271146, "o", "\tfailed := 0\r\n\tskipped := 0\r\n\ttotal := len(entries)\r\n\tfor _, entry := range entries {\r\n\t\tstatus, details := auditStoredResult(store, entry.ID)\r\n\t\tfmt.Print(details)\r\n\t\tswitch status {\r\n\t\tcase auditPass:\r\n\t\t\tpassed++\r\n\t\tcase auditFail:\r\n\t"]
[5073.271214, "o", "\t\tfailed++\r\n\t\tcase auditSkip:\r\n\t\t\tskipped++\r\n\t\t}\r\n\t}\r\n\r\n\tfmt.Printf(\"Audit Summary: %d passed, %d failed, %d skipped out of %d total\\n\", passed, failed, skipped, total)\r\n\tif failed > 0 {\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\n"]
[5073.271279, "o", "type auditStatus int\r\n\r\nconst (\r\n"]
