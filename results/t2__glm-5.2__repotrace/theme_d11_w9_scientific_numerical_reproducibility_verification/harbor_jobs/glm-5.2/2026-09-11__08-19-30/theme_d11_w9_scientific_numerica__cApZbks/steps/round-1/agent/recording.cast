[5144.237909, "o", "\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"exact\":\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"tolerance\":\r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--experiment\":\r\n\u001b[32m\u001b[K440\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--tag\":\r\n\u001b[32m\u001b[K505\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n\u001b[32m\u001b[K512\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--format\":\r\n\u001b[32m\u001b[K538\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"json\":\r\n\u001b[32m\u001b[K550\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"csv\":\r\n\u001b[32m\u001b[K565\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"markdown\":\r\n\u001b[32m\u001b[K615\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--verbose\":\r\n\u001b[32m\u001b[K617\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n"]
[5144.23798, "o", "\u001b[32m\u001b[K643\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Kstorage.StatusVerified:\r\n\u001b[32m\u001b[K650\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Kstorage.StatusCorrupted:\r\n\u001b[32m\u001b[K657\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Kstorage.StatusNoChecksum:\r\n\u001b[32m\u001b[K672\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--all\":\r\n\u001b[32m\u001b[K674\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n\u001b[32m\u001b[K743\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[KauditPass:\r\n"]
[5144.238038, "o", "\u001b[32m\u001b[K745\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[KauditFail:\r\n\u001b[32m\u001b[K747\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[KauditSkip:\r\n"]
