[3682.878948, "o", "\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K4. Print `\u001b[01;31m\u001b[KINTEGRITY_OK:\u001b[m\u001b[K <id>` and exit 0 if checksums match.\r\n\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K5. Print `\u001b[01;31m\u001b[KINTEGRITY_FAIL:\u001b[m\u001b[K <id> (expected=<stored>, computed=<actual>)` and exit 1 if they differ.\r\n"]
[3682.879023, "o", "\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K6. Print `\u001b[01;31m\u001b[KNO_CHECKSUM:\u001b[m\u001b[K <id>` and exit 2 if the stored result has no checksum field.\r\n"]
[3682.879103, "o", "\u001b[35m\u001b[Kdocs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K**Known limitation:** Results do not include \u001b[01;31m\u001b[Kintegrity check\u001b[m\u001b[Ksums. There is no way to verify that stored values have not been corrupted or tampered with.\r\n"]
