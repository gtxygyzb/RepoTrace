[282.65287, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"strings\"\r\n"]
[282.652986, "o", "     8\t\r\n     9\t\t\"numeriforge/compare\"\r\n    10\t\t\"numeriforge/config\"\r\n    11\t\t\"numeriforge/engine\"\r\n    12\t\t\"numeriforge/storage\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc usage() {\r\n    16\t\tfmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform\r\n    17\t\r\n    18\tUsage:\r\n    19\t  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>]\r\n    20\t  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\r\n    21\t  numeriforge list [--experiment <name>] [--store-dir <dir>]\r\n    22\t  numeriforge export <result_id> --store-dir <dir> [--format json|csv]\r\n    23\t  numeriforge verify <result_id> --store-dir <dir>\r\n    24\t\r\n    25\tCommands:\r\n    26\t  run       Run an experiment and store the result\r\n"]
[282.65308, "o", "    27\t  compare   Compare two stored results\r\n    28\t  list      List stored experiment results\r\n    29\t  export    Export a result to a different format\r\n    30\t  verify    Verify result integrity (TODO: not yet implemented)\r\n    31\t\r\n    32\tAvailable experiments:\r\n    33\t`)\r\n    34\t\tfor _, name := range engine.List() {\r\n    35\t\t\tfmt.Fprintf(os.Stderr, \"  %s\\n\", name)\r\n    36\t\t}\r\n    37\t}\r\n    38\t\r\n    39\tfunc main() {\r\n"]
[282.653146, "o", "    40\t\tif len(os.Args) < 2 {\r\n    41\t\t\tusage()\r\n    42\t\t\tos.Exit(1)\r\n    43\t\t}\r\n    44\t\r\n    45\t\tcmd := os.Args[1]\r\n    46\t\r\n    47\t\tswitch cmd {\r\n    48\t\tcase \"run\":\r\n"]
[282.653226, "o", "    49\t\t\tcmdRun(os.Args[2:])\r\n    50\t\tcase \"compare\":\r\n    51\t\t\tcmdCompare(os.Args[2:])\r\n    52\t\tcase \"list\":\r\n    53\t\t\tcmdList(os.Args[2:])\r\n    54\t\tcase \"export\":\r\n    55\t\t\tcmdExport(os.Args[2:])\r\n    56\t\tcase \"verify\":\r\n    57\t\t\tcmdVerify(os.Args[2:])\r\n    58\t\tcase \"help\", \"--help\", \"-h\":\r\n    59\t\t\tusage()"]
[282.653286, "o", "\r\n    60\t\tdefault:\r\n    61\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n    62\t\t\tusage()\r\n    63\t\t\tos.Exit(1)\r\n    64\t\t}\r\n    65\t}\r\n    66\t\r\n    67\tfunc cmdRun(args []string) {\r\n"]
[282.653347, "o", "    68\t\tvar experimentName, outputDir, configPath string\r\n    69\t\tvar paramStrs []string\r\n    70\t\r\n    71\t\t// TODO: Add --seed flag for reproducible experiments.\r\n    72\t\t// Currently there is no way to set a seed, making all stochastic\r\n    73\t\t// experiments non-reproducible.\r\n    74\t\r\n    75\t\tfor i := 0; i < len(args); i++ {\r\n    76"]
[282.653421, "o", "\t\t\tswitch args[i] {\r\n    77\t\t\tcase \"--experiment\":\r\n    78\t\t\t\ti++\r\n    79\t\t\t\tif i < len(args) {\r\n    80\t\t\t\t\texperimentName = args[i]\r\n    81\t\t\t\t}\r\n    82\t\t\tcase \"--output-dir\":\r\n    83\t\t\t\ti++\r\n    84\t\t\t\tif i < len(args) {\r\n    85"]
[282.653499, "o", "\t\t\t\t\toutputDir = args[i]\r\n    86\t\t\t\t}\r\n    87\t\t\tcase \"--config\":\r\n    88\t\t\t\ti++\r\n    89\t\t\t\tif i < len(args) {\r\n    90\t\t\t\t\tconfigPath = args[i]\r\n    91\t\t\t\t}\r\n    92\t\t\tcase \"--param\":\r\n    93\t\t\t\ti++\r\n"]
[282.653564, "o", "    94\t\t\t\tif i < len(args) {\r\n    95\t\t\t\t\tparamStrs = append(paramStrs, args[i])\r\n    96\t\t\t\t}\r\n    97\t\t\t}\r\n    98\t\t}\r\n    99\t\r\n   100\t\t// Load config file if specified\r\n   101\t\tif configPath != \"\" {\r\n   102\t\t\tcfg, err := config.ParseINI(configPath)\r\n"]
[282.653636, "o", "   103\t\t\tif err != nil {\r\n   104\t\t\t\tfmt.Fprintf(os.Stderr, \"config error: %v\\n\", err)\r\n   105\t\t\t\tos.Exit(1)\r\n   106\t\t\t}\r\n   107\t\t\tif experimentName == \"\" {\r\n   108\t\t\t\texperimentName = cfg.Experiment\r\n   109\t\t\t}\r\n   110\t\t\tif outputDir == \"\" {\r\n   111\t\t\t\toutputDir = cfg.OutputDir\r\n"]
[282.653699, "o", "   112\t\t\t}\r\n   113\t\t\t// Config params are used as defaults; CLI params override\r\n   114\t\t\tcliParams, _ := config.ParseParams(paramStrs)\r\n   115\t\t\tcliParamMap := make(map[string]float64)\r\n   116\t\t\tfor _, p := range cliParams {\r\n   117\t\t\t\tcliParamMap[p.Name] = p.Value\r\n   118\t\t\t}\r\n   119\t\t\tfor _, p := range cfg.Params {\r\n   120\t\t\t\tif _, exists := cliParamMap[p.Name]; !exists {\r\n   121\t\t\t\t\tcliParams = append(cliParams, p)\r\n"]
[282.653759, "o", "   122\t\t\t\t}\r\n   123\t\t\t}\r\n   124\t\t\tparamStrs = nil\r\n   125\t\t\tfor _, p := range cliParams {\r\n   126\t\t\t\tparamStrs = append(paramStrs, fmt.Sprintf(\"%s=%f\", p.Name, p.Value))\r\n   127\t\t\t}\r\n   128\t\t"]
[282.653832, "o", "}\r\n   129\t\r\n   130\t\tif experimentName == \"\" {\r\n   131\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment is required\\n\")\r\n   132\t\t\tos.Exit(1)\r\n   133\t\t}\r\n   134\t\tif outputDir == \"\" {\r\n   135\t\t\toutputDir = \"./results\"\r\n   136\t\t}\r\n   137\t\r\n   138\t\tparams, err := config.ParseParams(paramStrs)\r\n"]
[282.653902, "o", "   139\t\tif err != nil {\r\n   140\t\t\tfmt.Fprintf(os.Stderr, \"parameter error: %v\\n\", err)\r\n   141\t\t\tos.Exit(1)\r\n   142\t\t}\r\n   143\t\r\n   144\t\tfn, err := engine.Get(experimentName)\r\n   145\t\tif err != nil {\r\n   146\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   147\t\t\tos.Exit(1)\r\n"]
