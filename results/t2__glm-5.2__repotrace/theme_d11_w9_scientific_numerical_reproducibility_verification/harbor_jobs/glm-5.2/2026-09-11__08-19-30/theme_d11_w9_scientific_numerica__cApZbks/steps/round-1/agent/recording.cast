[2535.626884, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n"]
[2535.626971, "o", "     6\t\t\"os\"\r\n     7\t\t\"runtime\"\r\n     8\t\t\"strconv\"\r\n     9\t\t\"strings\"\r\n    10\t\t\"time\"\r\n    11\t\r\n    12\t\t\"numeriforge/compare\"\r\n    13\t\t\"numeriforge/config\"\r\n    14\t\t\"numeriforge/engine\"\r\n    15\t\t\"numeriforge/storage\"\r\n    16\t)\r\n    17\t"]
[2535.627047, "o", "\r\n    18\tfunc usage() {\r\n    19\t\tfmt.Fprintf(os.Stderr, `numeriforge - Scientific Numerical Experiment Platform\r\n    20\t\r\n    21\tUsage:\r\n    22\t  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]\r\n    23\t  numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\r\n    24\t  numeriforge list [--experiment <name>] [--store-dir <dir>]\r\n    25\t  numeriforge export <result_id> --store-dir <dir> [--format json|csv]\r\n    26\t  numeriforge verify <result_id> --store-dir <dir>\r\n"]
[2535.62712, "o", "    27\t\r\n    28\tCommands:\r\n    29\t  run       Run an experiment and store the result\r\n    30\t  compare   Compare two stored results\r\n"]
[2535.627182, "o", "    31\t  list      List stored experiment results\r\n    32\t  export    Export a result to a different format\r\n    33\t  verify    Verify result integrity\r\n    34\t\r\n    35\tAvailable experiments:\r\n    36\t`)\r\n    37\t\tfor _, name := range engine.List() {\r\n    38\t\t\tfmt.Fprintf(os.Stderr, \"  %s\\n\", name)\r\n    39\t\t}\r\n    40\t}\r\n    41\t\r\n    42\tfunc main() {\r\n    43\t\tif len(os.Args) < 2 {\r\n    44\t\t\tusage()\r\n    45\t\t\tos.Exit(1)\r\n"]
[2535.627249, "o", "    46\t\t}\r\n    47\t\r\n    48\t\tcmd := os.Args[1]\r\n    49\t\r\n    50\t\tswitch cmd {\r\n    51\t\tcase \"run\":\r\n    52\t\t\tcmdRun(os.Args[2:])\r\n    53\t\tcase \"compare\":\r\n    54\t\t\tcmdCompare(os.Args[2:])\r\n"]
[2535.627314, "o", "    55\t\tcase \"list\":\r\n    56\t\t\tcmdList(os.Args[2:])\r\n    57\t\tcase \"export\":\r\n    58\t\t\tcmdExport(os.Args[2:])\r\n    59\t\tcase \"verify\":\r\n    60\t\t\tcmdVerify(os.Args[2:])\r\n    61\t\tcase \"help\", \"--help\", \"-h\":\r\n    62\t\t\tusage()\r\n    63\t\tdefault:\r\n    64"]
[2535.627373, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n    65\t\t\tusage()\r\n    66\t\t\tos.Exit(1)\r\n    67\t\t}\r\n    68\t}\r\n    69\t\r\n    70\t\r\n    71\t// environmentMetadata returns the environment fingerprint metadata required for\r\n    72\t// reproducible experiment traces.\r\n"]
[2535.62744, "o", "    73\tfunc environmentMetadata() map[string]string {\r\n    74\t\thostname, err := os.Hostname()\r\n    75\t\tif err != nil {\r\n    76\t\t\thostname = \"unknown\"\r\n    77\t\t}\r\n"]
[2535.627537, "o", "    78\t\treturn map[string]string{\r\n    79\t\t\t\"env_go_version\": runtime.Version(),\r\n    80\t\t\t\"env_os\":         runtime.GOOS,\r\n    81\t\t\t\"env_arch\":       runtime.GOARCH,\r\n    82\t\t\t\"env_hostname\":   hostname,\r\n    83\t\t}\r\n    84\t}\r\n    85\t\r\n    86\t// environmentFromMetadata aggregates stored environment fingerprint metadata\r\n    87\t// into an export-friendly object.\r\n    88\ttype environmentInfo struct {\r\n    89\t\tGoVersion string `json:\"go_version\"`\r\n    90\t\tOS        string `json:\"os\"`\r\n    91\t\tArch      string `json:\"arch\"`\r\n    92\t\tHostname  string `json:\"hostname\"`\r\n"]
[2535.627601, "o", "    93\t}\r\n    94\t\r\n    95\tfunc environmentFromMetadata(metadata map[string]string) environmentInfo {\r\n    96\t\treturn environmentInfo{\r\n    97\t\t\tGoVersion: metadata[\"env_go_version\"],\r\n    98\t\t\tOS:        metadata[\"env_os\"],\r\n    99\t\t\tArch:      metadata[\"env_arch\"],\r\n   100\t\t\tHostname:  metadata[\"env_hostname\"],\r\n   101\t\t}\r\n   102"]
[2535.627665, "o", "\t}\r\n   103\t\r\n   104\ttype exportPayload struct {\r\n   105\t\t*storage.StoredResult\r\n   106\t\tEnvironment environmentInfo `json:\"environment\"`\r\n"]
[2535.627726, "o", "   107\t}\r\n   108\t\r\n   109\tfunc cmdRun(args []string) {\r\n   110\t\tvar experimentName, outputDir, configPath string\r\n   111\t\tvar paramStrs []string\r\n   112\t\tvar seed int64\r\n   113\t\tseedProvided := false\r\n   114\t\r\n   115\t\tfor i := 0; i < len(args); i++ {\r\n   116\t\t\tswitch args[i] {\r\n   117\t\t\tcase \"--experiment\":\r\n   118\t\t\t\ti++\r\n   119\t\t\t\tif i >= len(args) {\r\n"]
[2535.627789, "o", "   120\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment requires a value\\n\")\r\n   121\t\t\t\t\tos.Exit(1)\r\n   122\t\t\t\t}\r\n   123\t\t\t\texperimentName = args[i]\r\n   124\t\t\tcase \"--output-dir\":\r\n   125\t\t\t\ti++\r\n   126\t\t\t\tif i >= len(args) {\r\n   127\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --output-dir requires a value\\n\")\r\n   128\t\t\t\t\tos.Exit(1)"]
[2535.627856, "o", "\r\n   129\t\t\t\t}\r\n   130\t\t\t\toutputDir = args[i]\r\n   131\t\t\tcase \"--config\":\r\n   132\t\t\t\ti++\r\n   133\t\t\t\tif i >= len(args) {\r\n"]
[2535.627918, "o", "   134\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --config requires a value\\n\")\r\n   135\t\t\t\t\tos.Exit(1)\r\n   136\t\t\t\t}\r\n   137\t\t\t\tconfigPath = args[i]\r\n   138\t\t\tcase \"--param\":\r\n   139\t\t\t\ti++\r\n   140\t\t\t\tif i >= len(args) {\r\n   141\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --param requires a value\\n\")\r\n   142\t\t\t\t\tos.Exit(1)\r\n   143\t\t\t\t}\r\n"]
[2535.627981, "o", "   144\t\t\t\tparamStrs = append(paramStrs, args[i])\r\n   145\t\t\tcase \"--seed\":\r\n   146\t\t\t\ti++\r\n   147\t\t\t\tif i >= len(args) {\r\n   148\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --seed requires a value\\n\")\r\n   149\t\t\t\t\tos.Exit(1)\r\n   150\t\t\t\t}\r\n   151\t\t\t\tparsed, err := strconv.ParseInt(args[i], 10, 64)\r\n   152\t\t\t\tif err != nil {\r\n"]
[2535.628044, "o", "   153\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid seed: %v\\n\", err)\r\n   154\t\t\t\t\tos.Exit(1)\r\n   155\t\t\t\t}\r\n   156\t\t\t\tseed = parsed\r\n   157\t\t\t\tseedProvided = true\r\n   158\t\t\tdefault:\r\n   159\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   160\t\t\t\tos.Exit(1)\r\n"]
[2535.628105, "o", "   161\t\t\t}\r\n   162\t\t}\r\n   163\t\r\n   164\t\tif configPath != \"\" {\r\n   165\t\t\tcfg, err := config.ParseINI(configPath)\r\n   166\t\t\tif err != nil {\r\n   167\t\t\t\tfmt.Fprintf(os.Stderr, \"config error: %v\\n\", err)\r\n   168\t\t\t\tos.Exit(1)\r\n   169\t\t\t}"]
[2535.62817, "o", "\r\n   170\t\t\tif experimentName == \"\" {\r\n   171\t\t\t\texperimentName = cfg.Experiment\r\n   172\t\t\t}\r\n   173\t\t\tif outputDir == \"\" {\r\n   174\t\t\t\toutputDir = cfg.OutputDir\r\n   175\t\t\t}\r\n   176\t\r\n   177\t\t\tcliParams, _ := config.ParseParams(paramStrs)\r\n   178\t\t\tcliParamMap := make(map[string]float64)"]
[2535.628237, "o", "\r\n   179\t\t\tfor _, p := range cliParams {\r\n   180\t\t\t\tcliParamMap[p.Name] = p.Value\r\n   181\t\t\t}\r\n   182\t\t\tfor _, p := range cfg.Params {\r\n"]
[2535.628302, "o", "   183\t\t\t\tif _, exists := cliParamMap[p.Name]; !exists {\r\n   184\t\t\t\t\tcliParams = append(cliParams, p)\r\n   185\t\t\t\t}\r\n   186\t\t\t}\r\n   187\t\t\tparamStrs = nil\r\n   188\t\t\tfor _, p := range cliParams {\r\n   189\t\t\t\tparamStrs = append(paramStrs, fmt.Sprintf(\"%s=%g\", p.Name, p.Value))\r\n   190\t\t\t}\r\n   191\t\t}\r\n   192\t\r\n   193\t\tif experimentName == \"\" {\r\n   194\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment is required\\n\")\r\n   195\t\t\tos.Exit(1)\r\n   196\t\t}"]
[2535.628372, "o", "\r\n   197\t\tif outputDir == \"\" {\r\n   198\t\t\toutputDir = \"./results\"\r\n   199\t\t}\r\n   200\t\r\n   201\t\tparams, err := config.ParseParams(paramStrs)\r\n   202\t\tif err != nil {\r\n   203\t\t\tfmt.Fprintf(os.Stderr, \"parameter error: %v\\n\", err)\r\n   204\t\t\tos.Exit(1)\r\n   205\t\t}\r\n"]
[2535.628435, "o", "   206\t\r\n   207\t\tfn, err := engine.Get(experimentName)\r\n   208\t\tif err != nil {\r\n   209\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   210\t\t\tos.Exit(1)\r\n   211\t\t}\r\n"]
[2535.628506, "o", "   212\t\r\n   213\t\tif !seedProvided {\r\n   214\t\t\tseed = time.Now().UnixNano()\r\n   215\t\t}\r\n   216\t\r\n   217\t\trng := engine.NewRNG(seed)\r\n   218\t\r\n   219\t\tresult, err := fn(experimentName, params, rng)\r\n   220\t\tif err != nil {\r\n   221\t\t\tfmt.Fprintf(os.Stderr, \"experiment error: %v\\n\", err)\r\n   222\t\t\tos.Exit(1)\r\n   223\t\t}\r\n   224\t\r\n"]
[2535.628573, "o", "   225\t\tif result.Metadata == nil {\r\n   226\t\t\tresult.Metadata = map[string]string{}\r\n   227\t\t}\r\n   228\t\tif _, ok := result.Metadata[\"seed\"]; !ok {\r\n   229\t\t\tresult.Metadata[\"seed\"] = strconv.FormatInt(seed, 10)\r\n   230\t\t}\r\n   231\t\tif seedProvided {\r\n   232\t\t\tresult.Metadata[\"seed_source\"] = \"provided\"\r\n   233\t\t} else {\r\n   234\t\t\t"]
[2535.628643, "o", "result.Metadata[\"seed_source\"] = \"auto-generated\"\r\n   235\t\t}\r\n   236\t\r\n   237\t\tfor k, v := range environmentMetadata() {\r\n   238\t\t\tresult.Metadata[k] = v\r\n"]
[2535.628704, "o", "   239\t\t}\r\n   240\t\r\n   241\t\tstore, err := storage.NewStore(outputDir)\r\n   242\t\tif err != nil {\r\n   243\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   244\t\t\tos.Exit(1)\r\n   245\t\t}\r\n   246\t\r\n   247\t\tid, err := store.Save(result)\r\n   248\t\tif err != nil {\r\n   249\t\t\tfmt.Fprintf(os.Stderr, \"save error: %v\\n\", err)\r\n"]
[2535.628766, "o", "   250\t\t\tos.Exit(1)\r\n   251\t\t}\r\n   252\t\r\n   253\t\tfmt.Printf(\"Experiment: %s\\n\", experimentName)\r\n   254\t\tfmt.Printf(\"Result ID: %s\\n\", id)\r\n   255\t\tfmt.Printf(\"Values:\\n\")\r\n   256\t\tfor i, v := range result.Values {\r\n   257\t\t\tlabel := fmt.Sprintf(\"[%d]\", i)\r\n   258\t\t\tif i < len(result.Labels) {\r\n   259\t\t\t\tlabel = result.Labels[i]\r\n"]
[2535.628831, "o", "   260\t\t\t}\r\n"]
