[2821.803173, "o", "\u001b[?2004h> "]
[2821.803378, "o", "\\tfor i, v := range result.Values {\r\n\u001b[?2004l\r"]
[2821.803435, "o", "\u001b[?2004h> "]
[2821.803678, "o", "\\t\\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n\u001b[?2004l\r"]
[2821.803737, "o", "\u001b[?2004h> "]
[2821.803919, "o", "\\t\\tif i < len(result.Labels) {\r\n\u001b[?2004l\r"]
[2821.803974, "o", "\u001b[?2004h> "]
