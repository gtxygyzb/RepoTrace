[4056.835347, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('main.go')\ns = p.read_text()\n\n# Update usage text\ns = s.replace(\n    \"    numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>]\\n\",\n    \"    numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--seed <integer>] [--tag key=value ...]\\n\"\n)\ns = s.replace(\n    \"    numeriforge list [--experiment <name>] [--store-dir <dir>]\\n\",\n    \"    numeriforge list [--experiment <name>] [--store-dir <dir>] [--tag key=value ...]\\n\"\n)\n\n# Add exportPayload Tags field and helpers after environmentFromMetadata\ns = s.replace(\n\"\"\"type exportPayload struct {\n\\t*storage.StoredResult\n\\tEnvironment environmentInfo `json:\"environment\"`\n}\n\"\"\",\n\"\"\"type exportPayload struct {\n\\t*storage.StoredResult\n\\tEnvironment environmentInfo `json:\"environment\"`\n\\tTags        map[string]string `json:\"tags,omitempty\"`\n}\n\n// tagsFromMetadata collects tag_<key> metadata entries into an export-fri"]
[4056.835702, "i", "endly\n// map without the tag_ prefix. It returns nil when no tags are present.\nfunc tagsFromMetadata(metadata map[string]string) map[string]string {\n\\tif metadata == nil {\n\\t\\treturn nil\n\\t}\n\\ttags := map[string]string{}\n\\tfor k, v := range metadata {\n\\t\\tif strings.HasPrefix(k, \"tag_\") {\n\\t\\t\\ttags[k[len(\"tag_\"):]] = v\n\\t\\t}\n\\t}\n\\tif len(tags) == 0 {\n\\t\\treturn nil\n\\t}\n\\treturn tags\n}\n\n// parseTagFlag parses a --tag key=value argument and returns the metadata key\n// and value. It prints an error and exits when the argument is malformed.\nfunc parseTagFlag(arg string) (string, string) {\n\\tparts := strings.SplitN(arg, \"=\", 2)\n\\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\n\\t\\tfmt.Fprintf(os.Stderr, \"error: invalid tag, expected key=value: %s\\\\n\", arg)\n\\t\\tos.Exit(1)\n\\t}\n\\treturn \"tag_\" + parts[0], parts[1]\n}\n\n// hasMatchingTags reports whether metadata contains all requested tag filters.\nfunc hasMatchingTags(metadata map[string]string, tags map[string]string) bool {\n\\tfor k, v := range tags {\n\\t\\tif"]
[4056.835815, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
