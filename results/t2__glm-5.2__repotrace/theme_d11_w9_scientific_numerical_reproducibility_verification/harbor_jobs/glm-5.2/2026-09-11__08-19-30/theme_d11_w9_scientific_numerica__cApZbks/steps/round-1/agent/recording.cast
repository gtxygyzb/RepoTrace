[283.171824, "o", "\u001b[?2004l\r"]
[283.175364, "o", "     1\tpackage compare\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"math\"\r\n     6\t\t\"strings\"\r\n     7\t\r\n     8"]
[283.175506, "o", "\t\t\"numeriforge/storage\"\r\n     9\t)\r\n    10\t\r\n    11\t// ComparisonMode determines how results are compared.\r\n    12\ttype ComparisonMode int\r\n    13\t\r\n    14\tconst (\r\n    15\t\t// ModeExact uses exact float equality (legacy, broken for scientific use).\r\n    16\t\tModeExact ComparisonMode = iota\r\n"]
[283.175585, "o", "    17\t\t// ModeTolerance uses configurable absolute and relative tolerance.\r\n    18\t\t// TODO: Implement tolerance-based comparison.\r\n    19\t\tModeTolerance\r\n    20\t)\r\n    21\t\r\n    22\t// Tolerance defines comparison thresholds.\r\n    23\ttype Tolerance struct {\r\n    24\t\tAbsolute float64\r\n    25\t\tRelative float64\r\n    26\t}\r\n    27\t\r\n    28\t// DefaultTolerance returns a reasonable default for scientific comparisons.\r\n    29\tfunc DefaultTolerance() Tolerance {\r\n    30\t\treturn Tolerance{\r\n    31\t\t\tAbsolute: 1e-10,\r\n    32\t"]
[283.175691, "o", "\t\tRelative: 1e-8,\r\n    33\t\t}\r\n    34\t}\r\n    35\t\r\n    36\t// ComparisonResult holds the outcome of comparing two experiment results.\r\n    37\ttype ComparisonResult struct {\r\n    38\t\tMatch       bool\r\n    39\t\tTotalPairs  int\r\n    40\t\tMatchedPairs int\r\n    41\t\tMismatches  []Mismatch\r\n    42\t\tMode        ComparisonMode\r\n    43\t\tSummary     string\r\n    44\t}\r\n    45\t\r\n    46\t// Mismatch records a single value pair that didn't match.\r\n    47\ttype Mismatch struct {\r\n    48\t\tIndex    int\r\n    49\t\tLabel    string\r\n    50\t\tValueA   float64\r\n    51\t\tValueB   float64\r\n    52\t\tAbsDiff  float64\r\n    53\t\t"]
[283.175762, "o", "RelDiff  float64\r\n    54\t}\r\n    55\t\r\n    56\t// Compare compares two stored results.\r\n    57\t// Currently only supports ModeExact (legacy behavior).\r\n    58\t// TODO: Implement ModeTolerance for proper scientific comparison.\r\n    59\tfunc Compare(a, b *storage.StoredResult, mode ComparisonMode, tol Tolerance) *ComparisonResult {\r\n    60\t\t"]
[283.175855, "o", "result := &ComparisonResult{\r\n    61\t\t\tMode: mode,\r\n    62\t\t}\r\n    63\t\r\n    64\t\tif a.ExperimentName != b.ExperimentName {\r\n    65\t\t\tresult.Match = false\r\n"]
[283.175916, "o", "    66\t\t\tresult.Summary = fmt.Sprintf(\"experiment name mismatch: %s vs %s\", a.ExperimentName, b.ExperimentName)\r\n    67\t\t\treturn result\r\n    68\t\t}\r\n    69\t\r\n    70\t\tminLen := len(a.Values)\r\n    71\t\tif len(b.Values) < minLen {\r\n    72\t\t\tminLen = len(b.Values)\r\n    73\t\t}\r\n    74\t\r\n    75\t\tif len(a.Values) != len(b.Values) {\r\n    76\t\t\tresult.Match = false\r\n    77\t\t\tresult.Summary = fmt.Sprintf(\"value count mismatch: %d vs %d\", len(a.Values), len(b.Values))\r\n"]
[283.175955, "o", "    78\t\t\treturn result\r\n    79\t\t}\r\n    80\t\r\n    81\t\tresult.TotalPairs = minLen\r\n    82\t\r\n"]
[283.176053, "o", "    83\t\tswitch mode {\r\n    84\t\tcase ModeExact:\r\n    85\t\t\tresult.Match = true\r\n    86\t\t\tfor i := 0; i < minLen; i++ {\r\n    87\t\t\t\tlabel := fmt.Sprintf(\"value[%d]\", i)\r\n    88\t\t\t\tif i < len(a.Labels) {\r\n    89\t"]
[283.176119, "o", "\t\t\t\tlabel = a.Labels[i]\r\n    90\t\t\t\t}\r\n    91\t\t\t\t// Legacy: exact float equality comparison\r\n    92\t\t\t\tif a.Values[i] != b.Values[i] {\r\n    93\t\t\t\t\tresult.Match = false\r\n    94\t\t\t\t\tresult.Mismatches = append(result.Mismatches, Mismatch{\r\n    95\t\t\t\t\t\tIndex:   i,\r\n    96\t\t\t\t\t\tLabel:   label,\r\n    97\t\t\t\t\t\tValueA:  a.Values[i],\r\n    98\t\t\t\t\t\tValueB:  b.Values[i],\r\n"]
[283.176203, "o", "    99\t\t\t\t\t\tAbsDiff: math.Abs(a.Values[i] - b.Values[i]),\r\n   100\t\t\t\t\t\tRelDiff: relDiff(a.Values[i], b.Values[i]),\r\n   101\t\t\t\t\t})\r\n   102\t\t\t\t} else {\r\n   103\t\t\t\t\tresult.MatchedPairs++\r\n   104\t\t\t\t}\r\n   105\t\t\t}\r\n   106\t\tcase ModeTolerance:\r\n   107\t\t\t// TODO: Implement tolerance-based comparison.\r\n   108\t\t\t// For each value pair, should check:\r\n"]
[283.176274, "o", "   109\t\t\t// 1. If both values are zero (within absolute tolerance), they match.\r\n   110\t\t\t// 2. Otherwise, check both absolute and relative tolerance:\r\n   111\t\t\t//    |a - b| <= tol.Absolute  OR  |a - b| / max(|a|, |b|) <= tol.Relative\r\n   112\t\t\t// 3. Handle NaN and Inf specially: NaN matches NaN, Inf matches Inf.\r\n   113\t\t\tresult.Match = false\r\n   114\t\t\tresult.Summary = \"tolerance comparison not yet implemented\"\r\n   115\t\t}\r\n   116\t\r\n"]
[283.176342, "o", "   117\t\tif result.Summary == \"\" {\r\n   118\t\t\tif result.Match {\r\n   119\t\t\t\tresult.Summary = fmt.Sprintf(\"all %d value pairs match\", result.TotalPairs)\r\n   120\t\t\t} else {\r\n   121\t\t\t\tresult.Summary = fmt.Sprintf(\"%d of %d value pairs mismatch\", len(result.Mismatches), result.TotalPairs)\r\n   122\t\t\t}\r\n   123\t\t}\r\n"]
[283.176423, "o", "   124\t\r\n   125\t\treturn result\r\n   126\t}\r\n   127\t\r\n   128\t// FormatReport generates a human-readable comparison report.\r\n   129\tfunc FormatReport(cr *ComparisonResult) string {\r\n   130\t\tvar sb strings.Builder\r\n   131\t\tsb.WriteString(\"=== Comparison Report ===\\n\")\r\n   132\t\tsb.WriteString(fmt.Sprintf(\"Mode: %s\\n\", modeString(cr.Mode)))\r\n   133\t\tsb.WriteString(fmt.Sprintf(\"Match: %v\\n\", cr.Match))\r\n   134\t\tsb.WriteString(fmt.Sprintf(\"Total pairs: %d\\n\", cr.TotalPairs))\r\n   135\t\tsb.WriteString(fmt.Sprintf(\"Matched: %d\\n\", cr.MatchedPairs))\r\n   136\t\tsb.WriteString(fmt.Sprintf(\"Summary: %s\\n\", cr.Summary))\r\n"]
[283.176507, "o", "   137\t\r\n   138\t\tif len(cr.Mismatches) > 0 {\r\n   139\t\t\tsb.WriteString(\"\\nMismatches:\\n\")\r\n   140\t\t\tfor _, m := range cr.Mismatches {\r\n   141\t\t\t\tsb.WriteString(fmt.Sprintf(\"  [%d] %s: %.15e vs %.15e (abs=%.6e, rel=%.6e)\\n\",\r\n   142\t\t\t\t\tm.Index, m.Label, m.ValueA, m.ValueB, m.AbsDiff, m.RelDiff))\r\n   143\t\t\t}\r\n   144\t\t}\r\n   145\t\r\n"]
[283.176572, "o", "   146\t\treturn sb.String()\r\n   147\t}\r\n   148\t\r\n   149\tfunc relDiff(a, b float64) float64 {\r\n   150\t\tdenom := math.Max(math.Abs(a), math.Abs(b))\r\n   151\t\tif denom < 1e-300 {\r\n   152\t\t\treturn 0\r\n   153\t\t}\r\n"]
[283.17664, "o", "   154\t\treturn math.Abs(a-b) / denom\r\n   155\t}\r\n   156\t\r\n   157\tfunc modeString(m ComparisonMode) string {\r\n   158\t\tswitch m {\r\n   159\t\tcase ModeExact:\r\n   160\t\t\treturn \"exact\"\r\n   161\t\tcase ModeTolerance:\r\n   162\t\t\treturn \"tolerance\"\r\n   163\t\tdefault:\r\n   164\t\t\treturn \"unknown\"\r\n   165"]
[283.176711, "o", "\t\t}\r\n   166\t}\r\n"]
