[5112.661676, "o", "package storage\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n"]
[5112.661756, "o", "\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"numeriforge/engine\"\r\n)\r\n\r\n// StoredResult is the on-disk representation of an experiment result.\r\ntype StoredResult struct {\r\n\tID             string             `json:\"id\"`\r\n\tExperimentName string             `json:\"experiment_name\"`\r\n\tTimestamp      time.Time          `json:\"timestamp\"`\r\n\tParameters     []engine.Parameter `json:\"parameters\"`\r\n\tValues         []float64          `json:\"values\"`\r\n\tLabels         []string           `json:\"labels\"`\r\n"]
[5112.661835, "o", "\tMetadata       map[string]string  `json:\"metadata\"`\r\n\tChecksum       string             `json:\"checksum,omitempty\"`\r\n}\r\n\r\n// VerifyStatus reports the outcome of integrity verification.\r\ntype VerifyStatus string\r\n\r\nconst (\r\n\tStatusVerified   VerifyStatus = \"verified\"\r\n\tStatusCorrupted  VerifyStatus = \"corrupted\"\r\n\tStatusNoChecksum VerifyStatus = \"no_checksum\"\r\n)\r\n\r\n// IndexEntry is a stored result index record.\r\ntype IndexEntry struct {\r\n\tID             string\r\n"]
[5112.661904, "o", "\tExperimentName string\r\n\tTimestamp      time.Time\r\n}\r\n\r\n// Store manages experiment result persistence.\r\ntype Store struct {\r\n\tBaseDir string\r\n"]
[5112.661965, "o", "}\r\n\r\n// NewStore creates a store at the given directory.\r\nfunc NewStore(baseDir string) (*Store, error) {\r\n\tif err := os.MkdirAll(baseDir, 0755); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"cannot create store directory: %w\", err)\r\n\t}\r\n\treturn &Store{BaseDir: baseDir}, nil\r\n}\r\n\r\n// ComputeChecksum returns the SHA-256 checksum of the canonical value\r\n// representation defined by the reproducibility specification.\r\nfunc ComputeChecksum(values []float64) string {\r\n\tvar sb strings.Builder\r\n\tfor i, v := range values {\r\n\t\tif i > 0 {"]
[5112.662033, "o", "\r\n\t\t\tsb.WriteByte('\\n')\r\n\t\t}\r\n\t\tfmt.Fprintf(&sb, \"%.17e\", v)\r\n"]
[5112.662093, "o", "\t}\r\n\tsum := sha256.Sum256([]byte(sb.String()))\r\n\treturn fmt.Sprintf(\"%x\", sum)\r\n}\r\n\r\n// Save persists an experiment result to disk.\r\nfunc (s *Store) Save(result *engine.Result) (string, error) {\r\n\tid := fmt.Sprintf(\"%s_%s\", result.ExperimentName, result.Timestamp.Format(\"20060102_150405\"))\r\n\r\n\tchecksum := ComputeChecksum(result.Values)\r\n\r\n"]
[5112.662153, "o", "\tif result.Metadata == nil {\r\n\t\tresult.Metadata = map[string]string{}\r\n\t}\r\n\tresult.Metadata[\"values_checksum\"] = checksum\r\n\r\n\tstored := StoredResult{\r\n\t\tID:             id,\r\n\t\tExperimentName: result.ExperimentName,\r\n\t\tTimestamp:      result.Timestamp,\r\n\t\tParameters:     result.Parameters,\r\n\t\tValues:         result.Values,\r\n"]
[5112.662212, "o", "\t\tLabels:         result.Labels,\r\n\t\tMetadata:       result.Metadata,\r\n\t\tChecksum:       checksum,\r\n\t}\r\n\r\n\tdata, err := json.MarshalIndent(stored, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"marshal error: %w\", err)\r\n\t}\r\n\r\n\tresultDir := filepath.Join(s.BaseDir, result.ExperimentName)\r\n\tif err := os.MkdirAll(resultDir, 0755); err != nil {\r\n"]
[5112.662274, "o", "\t\treturn \"\", fmt.Errorf(\"cannot create result directory: %w\", err)\r\n\t}\r\n\r\n\tpath := filepath.Join(resultDir, id+\".json\")\r\n\tif err := os.WriteFile(path, data, 0644); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"write error: %w\", err)\r\n\t}\r\n\r\n\tif err := s.updateIndex(id, result.ExperimentName, result.Timestamp); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"index update error: %w\", err)\r\n"]
[5112.662332, "o", "\t}\r\n\r\n\treturn id, nil\r\n}\r\n\r\n// Load reads a stored result by ID.\r\nfunc (s *Store) Load(id string) (*StoredResult, error) {\r\n\tvar resultPath string\r\n\terr := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n"]
[5112.662903, "o", "\u001b[?2004h"]
