[5413.634066, "o", "\u001b[?2004h> "]
[5413.634221, "o", "        fmt.Println(\"Environment summary:\")\r\n\u001b[?2004l\r"]
[5413.634276, "o", "\u001b[?2004h> "]
[5413.634447, "o", "        envKeys := make([]string, 0, len(envSet))\r\n\u001b[?2004l\r"]
[5413.634509, "o", "\u001b[?2004h> "]
[5413.634627, "o", "        for key := range envSet {\r\n\u001b[?2004l\r"]
[5413.634685, "o", "\u001b[?2004h> "]
[5413.634843, "o", "                envKeys = append(envKeys, key)\r\n\u001b[?2004l\r"]
[5413.634899, "o", "\u001b[?2004h> "]
[5413.634953, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
