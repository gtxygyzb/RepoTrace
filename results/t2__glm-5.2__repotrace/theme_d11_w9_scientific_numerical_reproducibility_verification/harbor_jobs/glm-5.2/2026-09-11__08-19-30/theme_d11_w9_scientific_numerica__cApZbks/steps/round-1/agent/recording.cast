[3417.047781, "o", "\tos.Exit(1)\r\n   559\t\t\t\t}\r\n   560\t\t\t\tstoreDir = args[i]\r\n   561\t\t\tdefault:\r\n   562\t\t\t\tif strings.HasPrefix(args[i], \"-\") {\r\n   563\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n"]
[3417.047861, "o", "   564\t\t\t\t\tos.Exit(1)\r\n   565\t\t\t\t}\r\n   566\t\t\t\tpositionals = append(positionals, args[i])\r\n   567\t\t\t}\r\n"]
[3417.047935, "o", "   568\t\t}\r\n   569\t\r\n   570\t\tif all {\r\n   571\t\t\tif len(positionals) != 0 {\r\n   572\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --all does not accept result IDs\\n\")\r\n   573\t\t\t\tos.Exit(1)\r\n   574\t\t\t}\r\n   575\t\t\tcmdAuditAll(storeDir)\r\n   576\t\t\treturn\r\n   577\t\t}\r\n   578\t\r\n   579\t\tif len(positionals) < 1 {\r\n   580\t\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge audit <result_id> --store-dir <dir>\\n\")\r\n   581\t\t\tfmt.Fprintf(os.Stderr, \"       numeriforge audit --all --store-dir <dir>\\n\")\r\n   582\t\t\tos.Exit(1)\r\n   583\t\t}\r\n"]
[3417.048016, "o", "   584\t\tif len(positionals) > 1 {\r\n   585\t\t\tfmt.Fprintf(os.Stderr, \"error: too many arguments\\n\")\r\n   586\t\t\tos.Exit(1)\r\n"]
[3417.048082, "o", "   587\t\t}\r\n   588\t\r\n   589\t\tstore, err := storage.NewStore(storeDir)\r\n   590\t\tif err != nil {\r\n   591\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   592\t\t\tos.Exit(1)\r\n   593\t\t}\r\n   594\t\r\n   595\t\tpassed, details := auditStoredResult(store, positionals[0])\r\n   596\t\tfmt.Print(details)\r\n   597\t\tif !passed {\r\n   598\t\t\tos.Exit(1)\r\n   599\t\t}\r\n   600\t}\r\n   601\t\r\n   602\tfunc cmdAuditAll(storeDir string) {\r\n   603\t\tstore, err := storage.NewStore(storeDir)\r\n   604\t\t"]
[3417.048146, "o", "if err != nil {\r\n   605\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   606\t\t\tos.Exit(1)\r\n   607\t\t}\r\n   608\t\r\n   609\t\tentries, err := store.ListResults(\"\")\r\n"]
[3417.048212, "o", "   610\t\tif err != nil {\r\n   611\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   612\t\t\tos.Exit(1)\r\n   613\t\t}\r\n   614\t\r\n   615\t\tpassed := 0\r\n   616\t\tfailed := 0\r\n   617\t\ttotal := len(entries)\r\n   618\t\tfor _, entry := range entries {\r\n   619\t\t\tok, details := auditStoredResult(store, entry.ID)\r\n"]
[3417.048276, "o", "   620\t\t\tfmt.Print(details)\r\n"]
