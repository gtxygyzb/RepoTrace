[2858.530327, "o", "\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmdRun\u001b[m\u001b[K(args []string) {\r\n"]
[2858.530868, "o", "\u001b[?2004h"]
