[2266.860168, "o", "\tif len(entries) == 0 {\r\n\t\tfmt.Println(\"No results found.\")\r\n\t\treturn\r\n\t}\r\n\r\n\tfmt.Printf(\"%-40s %-25s %s\\n\", \"ID\", \"Experiment\", \"Timestamp\")\r\n\tfmt.Println(strings.Repeat(\"-\", 80))\r\n\tfor _, entry := range entries {\r\n\t\tfmt.Printf(\"%-40s %-25s %s\\n\", entry.ID, entry.ExperimentName, entry.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n\t}\r\n}\r\n\r\nfunc cmdExport(args []string) {\r\n\tif len(args) < 1 {\r\n"]
