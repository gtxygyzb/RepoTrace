[306.623045, "o", "     1\tpackage engine\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"math\"\r\n     5\t\t\"time\"\r\n     6\t)\r\n     7\t\r\n"]
[306.623142, "o", "     8\tfunc registerMonteCarloExperiments() {\r\n     9\t\tRegister(\"mc-estimate-pi\", mcEstimatePi)\r\n    10\t\tRegister(\"mc-integral\", mcIntegral)\r\n    11\t\tRegister(\"mc-importance-sampling\", mcImportanceSampling)\r\n    12\t}\r\n    13\t\r\n    14\t// mcEstimatePi estimates pi using the classic circle/square Monte Carlo method.\r\n    15\t// Parameters: samples (int)\r\n    16\t// TODO: This uses GlobalRand which makes results non-reproducible.\r\n    17\t//       Need to accept a seed parameter and create a local random source.\r\n    18\tfunc mcEstimatePi(name string, params []Parameter) (*Result, error) {\r\n    19\t\tsamplesF, err := RequireParam(params, \"samples\")\r\n"]
[306.623207, "o", "    20\t\tif err != nil {\r\n    21\t\t\treturn nil, err\r\n    22\t\t}\r\n    23\t\tsamples := int(samplesF)\r\n    24\t\tif samples <= 0 {\r\n    25\t\t\tsamples = 100000\r\n    26\t\t}\r\n    27\t\r\n    28\t\tinside := 0\r\n    29\t\tfor i := 0; i < samples; i++ {\r\n"]
[306.623294, "o", "    30\t\t\tx := GlobalRand.Float64()\r\n    31\t\t\ty := GlobalRand.Float64()\r\n    32\t\t\tif x*x+y*y <= 1.0 {\r\n    33\t\t\t\tinside++\r\n    34\t\t\t}\r\n    35\t\t}\r\n    36\t\r\n    37\t\tpiEstimate := 4.0 * float64(inside) / float64(samples)\r\n    38\t\terrorMargin := math.Abs(piEstimate - math.Pi)\r\n    39\t\r\n    40\t\treturn &Result{\r\n    41\t\t\tExperimentName: name,\r\n"]
[306.623357, "o", "    42\t\t\tTimestamp:      time.Now(),\r\n    43\t\t\tParameters:     params,\r\n    44\t\t\tValues:         []float64{piEstimate, errorMargin, float64(inside), float64(samples)},\r\n    45\t\t\tLabels:         []string{\"pi_estimate\", \"error_margin\", \"inside_count\", \"total_samples\"},\r\n    46\t\t\tMetadata:       map[string]string{\"method\": \"circle_square\"},\r\n    47\t\t}, nil\r\n    48\t}\r\n    49"]
[306.623416, "o", "\t\r\n    50\t// mcIntegral performs numerical integration of f(x) = sin(x)*exp(-x^2/2) over [a,b]\r\n    51\t// using simple Monte Carlo sampling.\r\n    52\t// Parameters: samples (int), lower_bound (float), upper_bound (float)\r\n    53\t// TODO: Uses GlobalRand - not reproducible.\r\n    54\tfunc mcIntegral(name string, params []Parameter) (*Result, error) {\r\n    55\t\tsamplesF, err := RequireParam(params, \"samples\")\r\n    56\t\tif err != nil {\r\n"]
[306.623509, "o", "    57\t\t\treturn nil, err\r\n    58\t\t}\r\n    59\t\tlower, err := RequireParam(params, \"lower_bound\")\r\n    60\t\tif err != nil {\r\n    61\t\t\treturn nil, err\r\n    62\t\t}\r\n    63\t\tupper, err := RequireParam(params, \"upper_bound\")\r\n    64\t\t"]
[306.623568, "o", "if err != nil {\r\n    65\t\t\treturn nil, err\r\n    66\t\t}\r\n    67\t\r\n    68\t\tsamples := int(samplesF)\r\n    69\t\tif samples <= 0 {\r\n    70\t\t\tsamples = 100000\r\n    71\t\t}\r\n    72\t\r\n    73\t\twidth := upper - lower\r\n    74\t\tsum := 0.0\r\n"]
[306.623626, "o", "    75\t\tsumSq := 0.0\r\n    76\t\tfor i := 0; i < samples; i++ {\r\n    77\t\t\tx := lower + GlobalRand.Float64()*width\r\n    78\t\t\tfx := math.Sin(x) * math.Exp(-x*x/2.0)\r\n    79\t\t\tsum += fx\r\n    80\t\t\tsumSq += fx * fx\r\n    81\t\t}\r\n    82\t\r\n    83\t\t"]
[306.623684, "o", "mean := sum / float64(samples)\r\n    84\t\tintegral := width * mean\r\n    85\t\tvariance := (sumSq/float64(samples) - mean*mean) / float64(samples)\r\n    86\t\tstdErr := math.Sqrt(math.Abs(variance)) * width\r\n    87\t\r\n    88\t\treturn &Result{\r\n    89\t\t\tExperimentName: name,\r\n"]
[306.623743, "o", "    90\t\t\tTimestamp:      time.Now(),\r\n    91\t\t\tParameters:     params,\r\n    92\t\t\tValues:         []float64{integral, stdErr, mean, variance},\r\n    93\t\t\tLabels:         []string{\"integral\", \"std_error\", \"mean_value\", \"variance\"},\r\n    94\t\t\tMetadata:       map[string]string{\"method\": \"simple_mc\", \"integrand\": \"sin(x)*exp(-x^2/2)\"},\r\n    95\t\t}, nil\r\n    96\t}\r\n    97\t\r\n    98\t// mcImportanceSampling performs Monte Carlo integration using importance sampling\r\n    99\t// with a Gaussian proposal distribution.\r\n"]
[306.62381, "o", "   100\t// Parameters: samples (int), lower_bound (float), upper_bound (float), proposal_mean (float), proposal_std (float)\r\n   101\t// TODO: Uses GlobalRand - not reproducible.\r\n   102\tfunc mcImportanceSampling(name string, params []Parameter) (*Result, error) {\r\n   103\t\tsamplesF, err := RequireParam(params, \"samples\")\r\n   104\t\tif err != nil {\r\n   105\t\t\treturn nil, err\r\n   106\t\t}\r\n   107\t\tlower, err := RequireParam(params, \"lower_bound\")\r\n   108\t\tif err != nil {\r\n   109\t\t\treturn nil, err\r\n   110\t\t}\r\n   111\t\t"]
[306.623867, "o", "upper, err := RequireParam(params, \"upper_bound\")\r\n   112\t\tif err != nil {\r\n   113\t\t\treturn nil, err\r\n   114\t\t}\r\n   115\t\tpMean, err := RequireParam(params, \"proposal_mean\")\r\n   116\t\tif err != nil {\r\n   117\t\t\treturn nil, err\r\n"]
[306.623926, "o", "   118\t\t}\r\n   119\t\tpStd, err := RequireParam(params, \"proposal_std\")\r\n   120\t\tif err != nil {\r\n"]
