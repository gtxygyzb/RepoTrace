[5129.447069, "o", "`)\r\n\tfor _, name := range engine.List() {\r\n\t\tfmt.Fprintf(os.Stderr, \"  %s\\n\", name)\r\n\t}\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n"]
[5129.447201, "o", "\t\tusage()\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcmd := os.Args[1]\r\n\r\n\tswitch cmd {\r\n\tcase \"run\":\r\n\t\tcmdRun(os.Args[2:])\r\n\tcase \"compare\":\r\n\t\tcmdCompare(os.Args[2:])\r\n\tcase \"list\":\r\n\t\tcmdList(os.Args[2:])\r\n\tcase \"export\":\r\n\t\tcmdExport(os.Args[2:])\r\n\tcase \"verify\":\r\n\t\tcmdVerify(os.Args[2:])\r\n\tcase \"audit\":\r\n\t\tcmdAudit(os.Args[2:])\r\n\tcase \"help\", \"--help\", \"-h\":\r\n\t\tusage()\r\n\tdefault:\r\n"]
[5129.447276, "o", "\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\t\tusage()\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\n// environmentMetadata returns the environment fingerprint metadata required for\r\n// reproducible experiment traces.\r\nfunc environmentMetadata() map[string]string {\r\n\thostname, err := os.Hostname()\r\n\tif err != nil {\r\n\t\thostname = \"unknown\"\r\n\t}\r\n"]
[5129.447344, "o", "\treturn map[string]string{\r\n\t\t\"env_go_version\": runtime.Version(),\r\n\t\t\"env_os\":         runtime.GOOS,\r\n\t\t\"env_arch\":       runtime.GOARCH,\r\n\t\t\"env_hostname\":   hostname,\r\n\t}\r\n}\r\n\r\n"]
