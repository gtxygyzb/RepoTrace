[5175.120943, "o", "func cmdVerify(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid := args[0]\r\n\tstoreDir := \"./results\""]
[5175.121037, "o", "\r\n\tverbose := false\r\n\r\n\tfor i := 1; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--verbose\":\r\n"]
[5175.121098, "o", "\t\t\tverbose = true\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\t"]
[5175.121163, "o", "status, expected, computed, err := store.Verify(id)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"verify error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch status {\r\n\tcase storage.StatusVerified:\r\n\t\tfmt.Printf(\"INTEGRITY_OK: %s\\n\", id)\r\n\t\tif verbose {\r\n\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n"]
[5175.121229, "o", "\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n\t\t}\r\n\t\tos.Exit(0)\r\n\tcase storage.StatusCorrupted:\r\n\t\tfmt.Printf(\"INTEGRITY_FAIL: %s\\n\", id)\r\n\t\tif verbose {\r\n\t\t\tfmt.Printf(\"Stored checksum: %s\\n\", expected)\r\n\t\t\tfmt.Printf(\"Computed checksum: %s\\n\", computed)\r\n\t\t}\r\n\t"]
[5175.121293, "o", "\tos.Exit(1)\r\n\tcase storage.StatusNoChecksum:\r\n\t\tfmt.Printf(\"NO_CHECKSUM: %s\\n\", id)\r\n\t\tos.Exit(2)\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown verification status: %s\\n\", status)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\nfunc cmdAudit(args []string) {\r\n\tall := false\r\n\t"]
[5175.121354, "o", "var positionals []string\r\n\tstoreDir := \"./results\"\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--all\":\r\n\t\t\tall = true\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n"]
[5175.121414, "o", "\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tdefault:\r\n\t\t\tif strings.HasPrefix(args[i], \"-\") {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\t\tos.Exit(1)\r\n\t"]
[5175.12147, "o", "\t\t}\r\n\t\t\tpositionals = append(positionals, args[i])\r\n\t\t}\r\n\t}\r\n\r\n\tif all {\r\n"]
