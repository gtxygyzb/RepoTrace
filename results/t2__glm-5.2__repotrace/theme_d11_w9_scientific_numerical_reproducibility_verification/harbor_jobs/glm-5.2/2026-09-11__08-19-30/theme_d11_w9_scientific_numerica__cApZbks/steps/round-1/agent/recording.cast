[274.607814, "i", "sed -n '1,260p' compare/compare.go\n"]
[274.608106, "o", "sed -n '1,260p' compare/compare.go\r\n\u001b[?2004l\r"]
[274.610845, "o", "package compare\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"strings\"\r\n\r\n"]
[274.61092, "o", "\t\"numeriforge/storage\"\r\n)\r\n\r\n// ComparisonMode determines how results are compared.\r\ntype ComparisonMode int\r\n\r\nconst (\r\n\t// ModeExact uses exact float equality (legacy, broken for scientific use).\r\n\tModeExact ComparisonMode = iota\r\n\t// ModeTolerance uses configurable absolute and relative tolerance.\r\n\t// TODO: Implement tolerance-based comparison.\r\n\tModeTolerance\r\n)\r\n\r\n"]
[274.611021, "o", "// Tolerance defines comparison thresholds.\r\ntype Tolerance struct {\r\n\tAbsolute float64\r\n\tRelative float64\r\n}\r\n\r\n// DefaultTolerance returns a reasonable default for scientific comparisons.\r\n"]
[274.61112, "o", "func DefaultTolerance() Tolerance {\r\n\treturn Tolerance{\r\n\t\tAbsolute: 1e-10,\r\n\t\tRelative: 1e-8,\r\n\t}\r\n}\r\n\r\n// ComparisonResult holds the outcome of comparing two experiment results.\r\ntype ComparisonResult struct {\r\n\tMatch       bool\r\n\tTotalPairs  int\r\n\tMatchedPairs int\r\n\tMismatches  []Mismatch\r\n\tMode        ComparisonMode\r\n\tSummary     string\r\n}\r\n\r\n// Mismatch records a single value pair that didn't match.\r\ntype Mismatch struct {\r\n\tIndex    int\r\n\tLabel    string\r\n\tValueA   float64\r\n\tValueB   float64\r\n\tAbsDiff  float64\r\n\tRelDiff  float64\r\n}\r\n\r\n// Compare compares two stored results.\r\n// Currently only supports ModeExact (legacy behavior).\r\n// TODO: Implement ModeTolerance for proper scientific comparison.\r\nfunc Compare(a, b *storage.StoredResult, mode ComparisonMode, tol Tolerance) *ComparisonResult {\r\n\tresult := &ComparisonResult{\r\n"]
[274.611227, "o", "\t\tMode: mode,\r\n\t}\r\n\r\n\tif a.ExperimentName != b.ExperimentName {\r\n\t\tresult.Match = false\r\n\t\tresult.Summary = fmt.Sprintf(\"experiment name mismatch: %s vs %s\", a.ExperimentName, b.ExperimentName)\r\n\t\treturn result\r\n\t}\r\n\r\n\tminLen := len(a.Values)\r\n\tif len(b.Values) < minLen {\r\n\t\tminLen = len(b.Values)\r\n\t}\r\n\r\n\tif len(a.Values) != len(b.Values) {\r\n\t\tresult.Match = false\r\n\t\tresult.Summary = fmt.Sprintf(\"value count mismatch: %d vs %d\", len(a.Values), len(b.Values))\r\n\t\treturn result\r\n"]
[274.611317, "o", "\t}\r\n\r\n\tresult.TotalPairs = minLen\r\n\r\n\tswitch mode {\r\n\tcase ModeExact:\r\n\t\tresult.Match = true\r\n"]
[274.611425, "o", "\t\tfor i := 0; i < minLen; i++ {\r\n\t\t\tlabel := fmt.Sprintf(\"value[%d]\", i)\r\n\t\t\tif i < len(a.Labels) {\r\n\t\t\t\tlabel = a.Labels[i]\r\n\t\t\t}\r\n\t\t\t// Legacy: exact float equality comparison\r\n\t\t\tif a.Values[i] != b.Values[i] {\r\n\t\t\t\tresult.Match = false\r\n\t\t\t\tresult.Mismatches = append(result.Mismatches, Mismatch{\r\n\t\t\t\t\tIndex:   i,\r\n\t\t\t\t\tLabel:   label,\r\n\t\t\t\t\tValueA:  a.Values[i],\r\n\t\t\t\t\tValueB:  b.Values[i],\r\n\t\t\t\t\tAbsDiff: math.Abs(a.Values[i] - b.Values[i]),\r\n\t\t\t\t\tRelDiff: relDiff(a.Values[i], b.Values[i]),\r\n\t\t\t\t})\r\n\t\t\t} else {\r\n\t\t\t\tresult.MatchedPairs++\r\n\t\t\t}\r\n\t\t}\r\n\tcase ModeTolerance:\r\n\t\t// TODO: Implement tolerance-based comparison.\r\n\t\t// For each value pair, should check:\r\n\t\t// 1. If both values are zero (within absolute tolerance), they match.\r\n\t\t// 2. Otherwise, check both absolute and relative tolerance:\r\n"]
[274.611613, "o", "\t\t//    |a - b| <= tol.Absolute  OR  |a - b| / max(|a|, |b|) <= tol.Relative\r\n\t\t// 3. Handle NaN and Inf specially: NaN matches NaN, Inf matches Inf.\r\n\t\tresult.Match = false\r\n\t\tresult.Summary = \"tolerance comparison not yet implemented\"\r\n\t}\r\n\r\n\tif result.Summary == \"\" {\r\n\t\tif result.Match {\r\n\t\t\tresult.Summary = fmt.Sprintf(\"all %d value pairs match\", result.TotalPairs)\r\n\t\t} else {\r\n\t\t\tresult.Summary = fmt.Sprintf(\"%d of %d value pairs mismatch\", len(result.Mismatches), result.TotalPairs)\r\n\t\t}\r\n\t}\r\n\r\n\treturn result\r\n}\r\n\r\n// FormatReport generates a human-readable comparison report.\r\nfunc FormatReport(cr *ComparisonResult) string {\r\n\tvar sb strings.Builder\r\n\tsb.WriteString(\"=== Comparison Report ===\\n\")\r\n\tsb.WriteString(fmt.Sprintf(\"Mode: %s\\n\", modeString(cr.Mode)))\r\n\tsb.WriteString(fmt.Sprintf(\"Match: %v\\n\", cr.Match))\r\n\tsb.WriteString(fmt.Sprintf(\"Total pairs: %d\\n\", cr.TotalPairs))\r\n\tsb.WriteString(fmt.Sprintf(\"Matched: %d\\n\", cr.MatchedPairs))\r\n\tsb.WriteString(fmt.Sprintf(\"Summary: %s\\n\", cr.Summary))\r\n\r\n\t"]
[274.611789, "o", "if len(cr.Mismatches) > 0 {\r\n\t\tsb.WriteString(\"\\nMismatches:\\n\")\r\n\t\tfor _, m := range cr.Mismatches {\r\n\t\t\tsb.WriteString(fmt.Sprintf(\"  [%d] %s: %.15e vs %.15e (abs=%.6e, rel=%.6e)\\n\",\r\n\t\t\t\tm.Index, m.Label, m.ValueA, m.ValueB, m.AbsDiff, m.RelDiff))\r\n\t\t}\r\n\t}\r\n\r\n\treturn sb.String()\r\n}\r\n\r\nfunc relDiff(a, b float64) float64 {\r\n\tdenom := math.Max(math.Abs(a), math.Abs(b))\r\n\tif denom < 1e-300 {\r\n\t\treturn 0\r\n\t}\r\n\treturn math.Abs(a-b) / denom\r\n}\r\n\r\nfunc modeString(m ComparisonMode) string {\r\n\tswitch m {\r\n\tcase ModeExact:\r\n\t\treturn \"exact\"\r\n\tcase ModeTolerance:\r\n\t\treturn \"tolerance\"\r\n\tdefault:\r\n\t\treturn \"unknown\"\r\n\t}\r\n}\r\n"]
[274.612289, "o", "\u001b[?2004h"]
[274.61244, "o", "root@n30009:/app# "]
[274.883442, "i", "sed -n '1,260p' config/config.go\n"]
[274.883744, "o", "sed -n '1,260p' config/config.go\r\n\u001b[?2004l\r"]
[274.886639, "o", "package config\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n"]
[274.886691, "o", "\r\n\t\"numeriforge/engine\"\r\n)\r\n\r\n// Config represents parsed experiment configuration.\r\ntype Config struct {\r\n\tExperiment string\r\n\tOutputDir  string\r\n\tParams     []engine.Parameter\r\n"]
[274.886788, "o", "\tRaw        map[string]string\r\n}\r\n\r\n// ParseINI reads a simple INI-style configuration file.\r\n// Format:\r\n//   experiment = mc-estimate-pi\r\n//   output_dir = ./results\r\n//   param.samples = 100000\r\n//   param.lower_bound = 0.0\r\nfunc ParseINI(path string) (*Config, error) {\r\n\tf, err := os.Open(path)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"cannot open config: %w\", err)\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\tcfg := &Config{\r\n\t\tRaw: make(map[string]string),\r\n\t}\r\n"]
[274.886867, "o", "\r\n\tscanner := bufio.NewScanner(f)\r\n\tfor scanner.Scan() {\r\n\t\tline := strings.TrimSpace(scanner.Text())\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") || strings.HasPrefix(line, \";\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tparts := strings.SplitN(line, \"=\", 2)\r\n\t\tif len(parts) != 2 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n"]
[274.886957, "o", "\t\tkey := strings.TrimSpace(parts[0])\r\n\t\tvalue := strings.TrimSpace(parts[1])\r\n\t\tcfg.Raw[key] = value\r\n\r\n\t\tswitch key {\r\n\t\tcase \"experiment\":\r\n\t\t\tcfg.Experiment = value\r\n\t\tcase \"output_dir\":\r\n\t\t\tcfg.OutputDir = value\r\n\t\tdefault:\r\n\t\t\tif strings.HasPrefix(key, \"param.\") {\r\n\t\t\t\tparamName := strings.TrimPrefix(key, \"param.\")\r\n"]
[274.887021, "o", "\t\t\t\tparamValue, err := strconv.ParseFloat(value, 64)\r\n\t\t\t\tif err != nil {\r\n\t\t\t\t\treturn nil, fmt.Errorf(\"invalid parameter value for %s: %s\", paramName, value)\r\n\t\t\t\t}\r\n\t\t\t\tcfg.Params = append(cfg.Params, engine.Parameter{\r\n\t\t\t\t\tName:  paramName,\r\n\t\t\t\t\tValue: paramValue,\r\n\t\t\t\t})\r\n\t\t\t}\r\n\t"]
[274.887082, "o", "\t}\r\n\t}\r\n\r\n\tif err := scanner.Err(); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"read error: %w\", err)\r\n\t}\r\n\r\n\tif cfg.Experiment == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"missing required field: experiment\")\r\n\t}\r\n\tif cfg.OutputDir == \"\" {\r\n"]
[274.887124, "o", "\t\tcfg.OutputDir = \"./results\"\r\n\t}\r\n\r\n\treturn cfg, nil\r\n}\r\n\r\n// ParseParams converts a param string slice (key=value pairs) into Parameters.\r\n"]
[274.887208, "o", "func ParseParams(raw []string) ([]engine.Parameter, error) {\r\n\tvar params []engine.Parameter\r\n\tfor _, kv := range raw {\r\n\t\tparts := strings.SplitN(kv, \"=\", 2)\r\n\t\tif len(parts) != 2 {\r\n\t\t\treturn nil, fmt.Errorf(\"invalid parameter: %s (expected key=value)\", kv)\r\n\t\t}\r\n\t\tval, err := strconv.ParseFloat(parts[1], 64)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"invalid parameter value for %s: %s\", parts[0], parts[1])\r\n\t\t}\r\n\t\tparams = append(params, engine.Parameter{Name: parts[0], Value: val})\r\n\t}\r\n\treturn params, nil"]
[274.887274, "o", "\r\n}\r\n"]
[274.887716, "o", "\u001b[?2004h"]
[274.887777, "o", "root@n30009:/app# "]
[275.160968, "i", "sed -n '1,260p' engine/engine.go\n"]
[275.161237, "o", "sed -n '1,260p' engine/engine.go\r\n\u001b[?2004l\r"]
[275.164289, "o", "package engine\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"math/rand\"\r\n\t\"time\"\r\n)\r\n\r\n// ExperimentType enumerates supported experiment categories.\r\ntype ExperimentType string\r\n"]
[275.164385, "o", "\r\nconst (\r\n\tTypeMonteCarlo ExperimentType = \"montecarlo\"\r\n\tTypeMatrix     ExperimentType = \"matrix\"\r\n\tTypeODE        ExperimentType = \"ode\"\r\n\tTypeStats      ExperimentType = \"stats\"\r\n)\r\n\r\n// Parameter holds a single experiment parameter.\r\ntype Parameter struct {\r\n\tName  string\r\n"]
[275.164472, "o", "\tValue float64\r\n}\r\n\r\n// Result holds raw experiment output.\r\ntype Result struct {\r\n\tExperimentName string\r\n\tTimestamp      time.Time\r\n\tParameters     []Parameter\r\n\tValues         []float64\r\n\tLabels         []string\r\n\tMetadata       map[string]string\r\n}\r\n\r\n// ExperimentFunc is the signature for all experiment backends.\r\n// It takes a name, parameters, and returns a Result or error.\r\ntype ExperimentFunc func(name string, params []Parameter) (*Result, error)\r\n\r\n// Global registry of experiment backends.\r\nvar registry = map[string]ExperimentFunc{}\r\n\r\n// Global random source used by all experiments (legacy: not reproducible).\r\nvar GlobalRand = rand.New(rand.NewSource(time.Now().UnixNano()))\r\n\r\n// Register adds an experiment backend to the registry.\r\n"]
[275.164592, "o", "func Register(name string, fn ExperimentFunc) {\r\n\tregistry[name] = fn\r\n}\r\n\r\n// Get retrieves an experiment backend by name.\r\nfunc Get(name string) (ExperimentFunc, error) {\r\n\tfn, ok := registry[name]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"unknown experiment: %s\", name)\r\n\t}\r\n\treturn fn, nil\r\n}\r\n\r\n// List returns all registered experiment names.\r\nfunc List() []string {\r\n\tnames := make([]string, 0, len(registry))\r\n\tfor k := range registry {\r\n\t\tnames = append(names, k)\r\n\t}\r\n"]
[275.164682, "o", "\treturn names\r\n}\r\n\r\n// GetParam finds a parameter by name, returning its value and whether it was found.\r\nfunc GetParam(params []Parameter, name string) (float64, bool) {\r\n\tfor _, p := range params {\r\n\t\tif p.Name == name {\r\n\t\t\treturn p.Value, true\r\n\t\t}\r\n\t}\r\n\treturn 0, false\r\n}\r\n\r\n// RequireParam finds a parameter by name or returns an error.\r\nfunc RequireParam(params []Parameter, name string) (float64, error) {\r\n\tv, ok := GetParam(params, name)\r\n\tif !ok {\r\n"]
[275.164746, "o", "\t\treturn 0, fmt.Errorf(\"missing required parameter: %s\", name)\r\n\t}\r\n\treturn v, nil\r\n}\r\n\r\nfunc init() {\r\n\tregisterMonteCarloExperiments()\r\n\tregisterMatrixExperiments()\r\n\tregisterODEExperiments()\r\n\tregisterStatsExperiments()\r\n}\r\n"]
[275.165218, "o", "\u001b[?2004h"]
