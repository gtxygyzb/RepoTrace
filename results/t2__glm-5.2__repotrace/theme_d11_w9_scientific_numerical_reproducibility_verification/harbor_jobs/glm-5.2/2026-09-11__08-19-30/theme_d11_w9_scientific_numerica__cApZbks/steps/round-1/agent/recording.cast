[2286.052559, "o", "\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif \u001b[01;31m\u001b[Kresult.Metadata\u001b[m\u001b[K == nil {\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kresult.Metadata\u001b[m\u001b[K = map[string]string{}\r\n\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif _, ok := \u001b[01;31m\u001b[Kresult.Metadata\u001b[m\u001b[K[\"seed\"]; !ok {\r\n\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kresult.Metadata\u001b[m\u001b[K[\"seed\"] = strconv.FormatInt(seed, 10)\r\n"]
[2286.052683, "o", "\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kresult.Metadata\u001b[m\u001b[K[\"seed_source\"] = \"provided\"\r\n\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kresult.Metadata\u001b[m\u001b[K[\"seed_source\"] = \"auto-generated\"\r\n"]
[2286.052753, "o", "\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmdExport\u001b[m\u001b[K(args []string) {\r\n"]
[2286.052806, "o", "\u001b[32m\u001b[K414\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tdata, err := \u001b[01;31m\u001b[Kjson.Marshal\u001b[m\u001b[KIndent(result, \"\", \"  \")\r\n"]
