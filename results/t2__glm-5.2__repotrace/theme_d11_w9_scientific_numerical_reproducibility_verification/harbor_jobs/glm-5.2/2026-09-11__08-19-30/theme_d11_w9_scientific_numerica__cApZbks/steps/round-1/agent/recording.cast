[2821.814548, "o", "\u001b[?2004h> "]
[2821.814607, "o", "\\tif !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2821.814897, "o", "\\t\\tfmt.Printf(\"AUDIT_FAIL: %s (reason: missing seed in metadata)\\\\n\", id)\r\n\u001b[?2004l\r"]
[2821.814951, "o", "\u001b[?2004h> "]
[2821.815013, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2821.815073, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
