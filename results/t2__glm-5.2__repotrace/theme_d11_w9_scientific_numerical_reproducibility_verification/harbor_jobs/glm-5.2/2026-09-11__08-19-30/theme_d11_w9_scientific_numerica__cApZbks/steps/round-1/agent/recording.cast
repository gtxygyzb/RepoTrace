[3736.432321, "o", "\u001b[?2004h> "]
[3736.432799, "o", "   Verbose mode does not change the exit code and does not apply to `NO_CHECKSUM`.'''\r\n\u001b[?2004l\r"]
[3736.432872, "o", "\u001b[?2004h> "]
[3736.432956, "o", "if old not in s:\r\n\u001b[?2004l\r"]
[3736.433021, "o", "\u001b[?2004h> "]
