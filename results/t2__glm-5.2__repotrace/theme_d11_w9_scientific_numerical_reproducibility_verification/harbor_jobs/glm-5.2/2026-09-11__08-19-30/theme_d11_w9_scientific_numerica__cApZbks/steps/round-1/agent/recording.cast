[4710.761979, "o", "\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge audit <result_id> --store-dir <dir>\\n\")\r\n\t\tfmt.Fprintf(os.Stderr, \"       numeriforge audit --all --store-dir <dir>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif len(positionals) > 1 {\r\n"]
[4710.762101, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: too many arguments\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tstatus, details := auditStoredResult(store, positionals[0])\r\n\tfmt.Print(details)\r\n\tif status == auditFail {\r\n\t\tos.Exit(1)\r\n"]
[4710.762205, "o", "\t}\r\n}\r\n\r\nfunc cmdAuditAll(storeDir string) {\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tentries, err := store.ListResults(\"\")\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tpassed := 0\r\n\tfailed := 0\r\n\tskipped := 0\r\n\ttotal := len(entries)\r\n\tfor _, entry := range entries {\r\n\t\tstatus, details := auditStoredResult(store, entry.ID)\r\n\t\tfmt.Print(details)\r\n\t\tswitch status {\r\n\t\tcase auditPass:\r\n\t\t\tpassed++\r\n\t\tcase auditFail:\r\n"]
[4710.7623, "o", "\t\t\tfailed++\r\n\t\tcase auditSkip:\r\n\t\t\tskipped++\r\n\t\t}\r\n\t}\r\n\r\n\tfmt.Printf(\"Audit Summary: %d passed, %d failed, %d skipped out of %d total\\n\", passed, failed, skipped, total)\r\n\tif failed > 0 {\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\ntype auditStatus int\r\n\r\nconst (\r\n"]
[4710.762454, "o", "\tauditPass auditStatus = iota\r\n\tauditFail\r\n\tauditSkip\r\n)\r\n\r\nfunc auditStoredResult(store *storage.Store, id string) (auditStatus, string) {\r\n\tstored, err := store.Load(id)\r\n\tif err != nil {\r\n\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: load error: %v)\\n\", id, err)\r\n\t}\r\n\r\n\twarnEnvMismatch(stored)\r\n\r\n\tstatus, expected, computed, err := store.Verify(id)\r\n\tif err != nil {\r\n\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: integrity check error: %v)\\n\", id, err)\r\n\t}\r\n\tif status == storage.StatusNoChecksum {\r\n\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: integrity check failed: no checksum)\\n\", id)\r\n\t}\r\n\tif status == storage.StatusCorrupted {\r\n\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: integrity check failed: expected=%s computed=%s)\\n\", id, expected, computed)\r\n\t}\r\n\r\n\tvar seed int64\r\n\tseedStr, ok := stored.Metadata[\"seed\"]\r\n"]
[4710.762571, "o", "\tif !ok {\r\n\t\tif seedParam, ok := engine.GetParam(stored.Parameters, \"seed\"); ok {\r\n\t\t\tseed = int64(seedParam)\r\n\t\t} else {\r\n\t\t\treturn auditSkip, fmt.Sprintf(\"AUDIT_SKIP: %s (no seed)\\n\", id)\r\n\t\t}\r\n\t} else {\r\n\t\tseed, err = strconv.ParseInt(seedStr, 10, 64)\r\n\t\tif err != nil {\r\n\t\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: invalid seed in metadata: %v)\\n\", id, err)\r\n\t\t}\r\n\t}\r\n\r\n\tfn, err := engine.Get(stored.ExperimentName)\r\n\tif err != nil {\r\n\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n\t}\r\n\r\n\trng := engine.NewRNG(seed)\r\n"]
[4710.762669, "o", "\treexec, err := fn(stored.ExperimentName, stored.Parameters, rng)\r\n\tif err != nil {\r\n\t\treturn auditFail, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n\t}\r\n\r\n\tmaxLen := len(stored.Values)\r\n\tif len(reexec.Values) > maxLen {\r\n\t\tmaxLen = len(reexec.Values)\r\n\t}\r\n\r\n\tvar mismatches []string\r\n\tfor i := 0; i < maxLen; i++ {\r\n\t\tstoredMissing := i >= len(stored.Values)\r\n\t\treexecMissing := i >= len(reexec.Values)\r\n\r\n\t\tvar storedVal, reexecVal string\r\n\t\tif storedMissing {\r\n"]
[4710.762762, "o", "\t\t\tstoredVal = \"<missing>\"\r\n\t\t} else {\r\n\t\t\tstoredVal = strconv.FormatFloat(stored.Values[i], 'g', -1, 64)\r\n\t\t}\r\n\t\tif reexecMissing {\r\n\t\t\treexecVal = \"<missing>\"\r\n\t\t} else {\r\n\t\t\treexecVal = strconv.FormatFloat(reexec.Values[i], 'g', -1, 64)\r\n\t\t}\r\n\r\n\t\tif storedMissing || reexecMissing || math.Float64bits(stored.Values[i]) != math.Float64bits(reexec.Values[i]) {\r\n\t\t\tmismatches = append(mismatches, fmt.Sprintf(\"  value[%d]: stored=%s, re-executed=%s\", i, storedVal, reexecVal))\r\n\t\t}"]
[4710.762852, "o", "\r\n\t}\r\n\r\n\tif len(mismatches) == 0 {\r\n\t\treturn auditPass, fmt.Sprintf(\"AUDIT_PASS: %s\\n\", id)\r\n\t}\r\n\r\n\tvar sb strings.Builder\r\n\tsb.WriteString(fmt.Sprintf(\"AUDIT_FAIL: %s\\n\", id))\r\n\tfor _, m := range mismatches {\r\n\t\tsb.WriteString(m)\r\n\t\tsb.WriteByte('\\n')\r\n\t}\r\n\treturn auditFail, sb.String()\r\n}\r\n"]
[4710.762938, "o", "\r\n"]
