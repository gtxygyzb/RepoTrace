[3638.209948, "o", "\t\tfmt.Println(\"label,value\")\r\n\t\tfor i, v := range result.Values {\r\n\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n\t\t\tif i < len(result.Labels) {\r\n\t\t\t\tlabel = result.Labels[i]\r\n\t\t\t}\r\n\t\t\tfmt.Printf(\"%s,%.15e\\n\", label, v)\r\n\t\t}\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown format: %s\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n}"]
[3638.210104, "o", "\r\n\r\nfunc cmdVerify(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge verify <result_id> --store-dir <dir>\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid := args[0]\r\n\tstoreDir := \"./results\"\r\n\r\n\tfor i := 1; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tdefault:\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n"]
[3638.210183, "o", "\t\tos.Exit(1)\r\n\t}\r\n\r\n\tstatus, expected, computed, err := store.Verify(id)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"verify error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tswitch status {\r\n\tcase storage.StatusVerified:\r\n\t\tfmt.Printf(\"VERIFIED: %s\\n\", id)\r\n\t\tos.Exit(0)\r\n\tcase storage.StatusCorrupted:\r\n\t\tfmt.Printf(\"CORRUPTED: %s (expected=%s, computed=%s)\\n\", id, expected, computed)\r\n"]
[3638.210255, "o", "\t\tos.Exit(1)\r\n\tcase storage.StatusNoChecksum:\r\n\t\tfmt.Printf(\"NO_CHECKSUM: %s\\n\", id)\r\n\t\tos.Exit(2)\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown verification status: %s\\n\", status)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\nfunc cmdAudit(args []string) {\r\n\tall := false\r\n\tvar positionals []string\r\n"]
[3638.210322, "o", "\tstoreDir := \"./results\"\r\n\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--all\":\r\n\t\t\tall = true\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n"]
[3638.210385, "o", "\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tstoreDir = args[i]\r\n\t\tdefault:\r\n\t\t\tif strings.HasPrefix(args[i], \"-\") {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tpositionals = append(positionals, args[i])\r\n\t\t}\r\n\t}\r\n\r\n"]
[3638.210441, "o", "\tif all {\r\n\t\tif len(positionals) != 0 {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: --all does not accept result IDs\\n\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tcmdAuditAll(storeDir)\r\n\t\treturn\r\n\t}\r\n\r\n"]
