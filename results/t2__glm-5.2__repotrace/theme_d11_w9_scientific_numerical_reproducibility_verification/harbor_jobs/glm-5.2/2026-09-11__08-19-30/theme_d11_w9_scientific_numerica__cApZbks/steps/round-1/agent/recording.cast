[2821.814127, "o", "\u001b[?2004h> "]
[2821.8142, "o", "\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[2821.814254, "o", "\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[2821.814309, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[2821.814363, "o", "> "]
