[5073.269595, "o", "\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge export <id> --store-dir <dir> [--format json|csv|markdown]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid := args[0]\r\n\tstoreDir := \"./results\"\r\n\tformat := \"json\"\r\n\r\n\tfor i := 1; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n"]
