[5113.214603, "o", "\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc main\u001b[m\u001b[K() {\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kusage\u001b[m\u001b[K()\r\n\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"run\":\r\n\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"compare\":\r\n\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"list\":\r\n\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"export\":\r\n"]
[5113.214702, "o", "\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"verify\":\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"audit\":\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"help\", \"--help\", \"-h\":\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kusage\u001b[m\u001b[K()\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kusage\u001b[m\u001b[K()\r\n"]
[5113.214775, "o", "\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// hasMatchingTags \u001b[01;31m\u001b[Kreport\u001b[m\u001b[Ks whether metadata contains all requested tag filters.\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KRun(args []string) {\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--experiment\":\r\n\u001b[32m\u001b[K170\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--output-dir\":\r\n"]
[5113.21484, "o", "\u001b[32m\u001b[K177\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--config\":\r\n\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--param\":\r\n\u001b[32m\u001b[K191\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--seed\":\r\n\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--tag\":\r\n"]
[5113.214917, "o", "\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KCompare(args []string) {\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"\u001b[01;31m\u001b[Kusage\u001b[m\u001b[K: numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\\n\")\r\n\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--mode\":\r\n\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--abs-tol\":\r\n"]
[5113.214985, "o", "\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--rel-tol\":\r\n\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"exact\":\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K"]
[5113.215049, "o", "\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"tolerance\":\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KList(args []string) {\r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--experiment\":\r\n\u001b[32m\u001b[K440\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--tag\":\r\n"]
[5113.215111, "o", "\u001b[32m\u001b[K493\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KExport(args []string) {\r\n\u001b[32m\u001b[K495\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"\u001b[01;31m\u001b[Kusage\u001b[m\u001b[K: numeriforge export <id> --store-dir <dir> [--format json|csv|markdown]\\n\")\r\n\u001b[32m\u001b[K505\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n\u001b[32m\u001b[K512\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--format\":\r\n\u001b[32m\u001b[K538\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"json\":\r\n\u001b[32m\u001b[K550\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"csv\":\r\n\u001b[32m\u001b[K565\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"markdown\":\r\n"]
[5113.215203, "o", "\u001b[32m\u001b[K603\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KVerify(args []string) {\r\n\u001b[32m\u001b[K605\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"\u001b[01;31m\u001b[Kusage\u001b[m\u001b[K: numeriforge verify <result_id> --store-dir <dir> [--verbose]\\n\")\r\n\u001b[32m\u001b[K615\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--verbose\":\r\n\u001b[32m\u001b[K617\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n"]
[5113.21527, "o", "\u001b[32m\u001b[K643\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Kstorage.StatusVerified:\r\n\u001b[32m\u001b[K650\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Kstorage.StatusCorrupted:\r\n\u001b[32m\u001b[K657\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[Kstorage.StatusNoChecksum:\r\n\u001b[32m\u001b[K665\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KAudit(args []string) {\r\n\u001b[32m\u001b[K672\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--all\":\r\n\u001b[32m\u001b[K674\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[K\"--store-dir\":\r\n"]
[5113.215333, "o", "\u001b[32m\u001b[K700\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"\u001b[01;31m\u001b[Kusage\u001b[m\u001b[K: numeriforge audit <result_id> --store-dir <dir>\\n\")\r\n\u001b[32m\u001b[K722\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc cmd\u001b[m\u001b[KAuditAll(storeDir string) {\r\n\u001b[32m\u001b[K743\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[KauditPass:\r\n\u001b[32m\u001b[K745\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[KauditFail:\r\n\u001b[32m\u001b[K747\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \u001b[m\u001b[KauditSkip:\r\n"]
