[306.348399, "o", "    54\t\t}\r\n    55\t\r\n    56\t\t// TODO: Compute and store checksum here.\r\n    57\t\t// Should hash the canonical representation of Values.\r\n    58\t\r\n    59\t\tdata, err := json.MarshalIndent(stored, \"\", \"  \")\r\n    60\t\tif err != nil {\r\n    61\t\t\treturn \"\", fmt.Errorf(\"marshal error: %w\", err)\r\n    62\t\t}\r\n    63\t\r\n"]
[306.348457, "o", "    64\t\tresultDir := filepath.Join(s.BaseDir, result.ExperimentName)\r\n    65\t\tif err := os.MkdirAll(resultDir, 0755); err != nil {\r\n    66\t\t\treturn \"\", fmt.Errorf(\"cannot create result directory: %w\", err)\r\n    67\t\t}\r\n    68\t\r\n    69\t\tpath := filepath.Join(resultDir, id+\".json\")\r\n    70\t\tif err := os.WriteFile(path, data, 0644); err != nil {\r\n    71\t\t\treturn \"\", fmt.Errorf(\"write error: %w\", err)\r\n"]
