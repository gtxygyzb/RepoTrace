[5082.001742, "o", "   145\t}\r\n   146\t\r\n   147\t// ListResults returns all stored result IDs, optionally filtered by experiment name.\r\n   148\tfunc (s *Store) ListResults(experimentFilter string) ([]IndexEntry, error) {\r\n   149\t\tentries, err := s.readIndex()\r\n   150\t\tif err != nil {\r\n   151\t\t\treturn nil, err\r\n   152\t\t}\r\n   153\t\r\n   154\t\tif experimentFilter == \"\" {\r\n   155\t"]
[5082.001805, "o", "\t\treturn entries, nil\r\n   156\t\t}\r\n   157\t\r\n   158\t\tfiltered := make([]IndexEntry, 0)\r\n   159\t\tfor _, entry := range entries {\r\n   160\t\t\tif entry.ExperimentName == experimentFilter {\r\n   161\t\t\t\tfiltered = append(filtered, entry)\r\n   162\t\t\t}\r\n   163\t\t}\r\n   164\t\treturn filtered, nil\r\n   165\t}\r\n"]
[5082.001861, "o", "   166\t\r\n   167\t// Verify checks stored result integrity by recomputing the canonical checksum.\r\n   168\tfunc (s *Store) Verify(id string) (VerifyStatus, string, string, error) {\r\n   169\t\tstored, err := s.Load(id)\r\n   170\t\tif err != nil {\r\n   171\t\t\treturn \"\", \"\", \"\", err\r\n   172\t\t}\r\n"]
[5082.001917, "o", "   173\t\r\n   174\t\tif stored.Checksum == \"\" {\r\n   175\t\t\treturn StatusNoChecksum, \"\", \"\", nil\r\n   176\t\t}\r\n   177\t\r\n   178\t\tcomputed := ComputeChecksum(stored.Values)\r\n   179\t\tif computed == stored.Checksum {\r\n   180\t\t\t"]
[5082.001974, "o", "return StatusVerified, stored.Checksum, computed, nil\r\n   181\t\t}\r\n   182\t\treturn StatusCorrupted, stored.Checksum, computed, nil\r\n   183\t}\r\n   184\t\r\n   185\tfunc (s *Store) indexPath() string {\r\n   186\t\treturn filepath.Join(s.BaseDir, \"index.txt\")\r\n   187\t}\r\n   188\t\r\n   189\t"]
[5082.002033, "o", "func (s *Store) updateIndex(id, experimentName string, timestamp time.Time) error {\r\n   190\t\tif err := os.MkdirAll(s.BaseDir, 0755); err != nil {\r\n   191\t\t\treturn err\r\n   192\t\t}\r\n   193\t\r\n   194\t\tf, err := os.OpenFile(s.indexPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)\r\n   195\t\tif err != nil {\r\n   196\t\t"]
[5082.002095, "o", "\treturn err\r\n   197\t\t}\r\n   198\t\tdefer f.Close()\r\n   199\t\r\n   200\t\t_, err = fmt.Fprintf(f, \"%s|%s|%s\\n\", id, experimentName, timestamp.Format(time.RFC3339))\r\n   201\t\treturn err\r\n   202\t}\r\n   203\t\r\n   204\tfunc (s *Store) readIndex() ([]IndexEntry, error) {\r\n   205\t"]
[5082.002169, "o", "\tdata, err := os.ReadFile(s.indexPath())\r\n   206\t\tif err != nil {\r\n   207\t\t\tif os.IsNotExist(err) {\r\n   208\t\t\t\treturn nil, nil\r\n   209\t\t\t}\r\n   210\t\t\treturn nil, err\r\n   211\t\t}\r\n   212\t\r\n   213\t\tvar entries []IndexEntry\r\n   214\t\tfor _, line := range strings.Split(strings.TrimSpace(string(data)), \"\\n\") {\r\n"]
[5082.002226, "o", "   215\t\t\tif line == \"\" {\r\n   216\t\t\t\tcontinue\r\n   217\t\t\t}\r\n   218\t\t\tparts := strings.SplitN(line, \"|\", 3)\r\n   219\t\t\tif len(parts) != 3 {\r\n   220\t\t\t\tcontinue\r\n   221\t\t\t}\r\n"]
[5082.002287, "o", "   222\t\t\tts, _ := time.Parse(time.RFC3339, parts[2])\r\n   223\t\t\tentries = append(entries, IndexEntry{\r\n   224\t\t\t\tID:             parts[0],\r\n   225\t\t\t\tExperimentName: parts[1],\r\n   226\t\t\t\tTimestamp:      ts,\r\n   227\t\t\t})\r\n   228\t\t}\r\n   229\t\r\n   230\t\tsort.Slice(entries, func(i, j int) bool {\r\n   231\t\t\treturn entries[i].Timestamp.Before(entries[j].Timestamp)\r\n"]
