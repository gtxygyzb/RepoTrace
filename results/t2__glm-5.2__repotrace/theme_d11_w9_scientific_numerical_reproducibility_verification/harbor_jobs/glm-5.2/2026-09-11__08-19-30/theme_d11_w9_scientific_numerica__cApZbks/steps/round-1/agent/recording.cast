[5413.637713, "o", "\u001b[?2004h> "]
[5413.637818, "o", "                        continue\r\n\u001b[?2004l\r"]
[5413.637874, "o", "\u001b[?2004h> "]
[5413.637938, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5413.637993, "o", "> "]
[5413.638087, "o", "                switch status {\r\n\u001b[?2004l\r"]
[5413.638142, "o", "\u001b[?2004h> "]
[5413.638236, "o", "                case storage.StatusVerified:\r\n\u001b[?2004l\r\u001b[?2004h"]
[5413.638291, "o", "> "]
[5413.638353, "o", "                        ok++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5413.638499, "o", "                case storage.StatusCorrupted:\r\n\u001b[?2004l\r"]
[5413.638554, "o", "\u001b[?2004h> "]
[5413.63861, "o", "                        fail++\r\n\u001b[?2004l\r"]
[5413.638664, "o", "\u001b[?2004h> "]
[5413.638764, "o", "                case storage.StatusNoChecksum:\r\n\u001b[?2004l\r\u001b[?2004h"]
[5413.638827, "o", "> "]
[5413.638891, "o", "                        noChecksum++\r\n\u001b[?2004l\r"]
[5413.638945, "o", "\u001b[?2004h> "]
[5413.639005, "o", "                default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5413.639098, "o", "                        fail++\r\n\u001b[?2004l\r"]
[5413.639153, "o", "\u001b[?2004h> "]
[5413.639206, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5413.639262, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5413.639321, "o", "> "]
