[3919.10757, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K == nil {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K = map[string]string{}\r\n"]
[3919.107637, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif _, ok := result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed\"]; !ok {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed\"] = strconv.FormatInt(seed, 10)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed_source\"] = \"provided\"\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed_source\"] = \"auto-generated\"\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor k, v := range environment\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K() {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[k] = v\r\n"]
[3919.107714, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K417\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc cmd\u001b[01;31m\u001b[KExport\u001b[m\u001b[K(args []string) {\r\n"]
[3919.10778, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K465\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tEnvironment:  environmentFrom\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K(result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K),\r\n"]
[3919.107859, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K467\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tdata, err := \u001b[01;31m\u001b[Kjson.Marshal\u001b[m\u001b[KIndent(payload, \"\", \"  \")\r\n"]
[3919.107913, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K477\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif seed, ok := result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed\"]; ok {\r\n"]
[3919.107959, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K664\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tseedStr, ok := stored.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"seed\"]\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K666\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: missing seed in \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K)\\n\", id)\r\n"]
[3919.108022, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K670\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"AUDIT_FAIL: %s (reason: invalid seed in \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K: %v)\\n\", id, err)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K725\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmsg, ok := envMismatchWarning(stored.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K731\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc envMismatchWarning(\u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K map[string]string) (string, bool) {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K732\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcurrent := environment\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K()\r\n"]
[3919.108078, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K737\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K[field] != current[field] {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K738\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tdiffs = append(diffs, fmt.Sprintf(\"%s stored=%q current=%q\", field, \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K[field], current[field]))\r\n"]
[3919.108381, "o", "\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K- When no seed is provided, the system must generate a random seed and include it in the result \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K under the key `\"seed\"`.\r\n\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K- The seed must be recorded in the result \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K regardless of how it was obtained.\r\n"]
[3919.108461, "o", "\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K- The checksum must also be stored in the result \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K under the key `\"values_checksum\"`.\r\n"]
[3919.108564, "o", "\u001b[35m\u001b[K./docs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KExport\u001b[m\u001b[Ks a result to JSON or CSV format.\r\n\u001b[35m\u001b[K./docs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K- `\u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K`: Key-value pairs with method details\r\n"]
[3919.108588, "o", "\u001b[35m\u001b[K./docs/architecture.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KExperiment Execution ──► Result{Values, Labels, \u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K}\r\n"]
[3919.108677, "o", "\u001b[35m\u001b[K./docs/architecture.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K2. **Flat result format**: Results are plain JSON files with no schema versioning, no checksums, and no provenance \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K.\r\n"]
[3919.108742, "o", "\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K       map[string]string  `json:\"\u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K\"`\r\n\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K == nil {\r\n\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K = map[string]string{}\r\n"]
[3919.108794, "o", "\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"values_checksum\"] = checksum\r\n\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K:       result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K,\r\n\u001b[35m\u001b[K./storage/storage.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tdata, err := \u001b[01;31m\u001b[Kjson.Marshal\u001b[m\u001b[KIndent(stored, \"\", \"  \")\r\n"]
[3919.120594, "o", "grep: ./numeriforge: binary file matches\r\n"]
