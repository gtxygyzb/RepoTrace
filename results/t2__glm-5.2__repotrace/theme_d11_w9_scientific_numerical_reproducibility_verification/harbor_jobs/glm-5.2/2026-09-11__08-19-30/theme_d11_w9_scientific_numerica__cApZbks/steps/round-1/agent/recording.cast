[3077.865449, "o", "     1\tpackage compare\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n"]
[3077.865667, "o", "     5\t\t\"math\"\r\n     6\t\t\"strings\"\r\n     7\t\r\n     8\t\t\"numeriforge/storage\"\r\n     9\t)\r\n    10\t\r\n    11\t// ComparisonMode determines how results are compared.\r\n    12\ttype ComparisonMode int\r\n    13\t\r\n    14\tconst (\r\n    15\t\t// ModeExact uses exact float equality (legacy behavior).\r\n    16\t\tModeExact ComparisonMode = iota\r\n    17\t\t// ModeTolerance uses configurable absolute and relative tolerance.\r\n    18\t\tModeTolerance\r\n    19\t)\r\n    20\t\r\n    21\t// Tolerance defines comparison thresholds.\r\n    22\ttype Tolerance struct {\r\n    23\t\tAbsolute float64\r\n    24\t\tRelative float64\r\n    25\t}\r\n    26\t\r\n    27\t// DefaultTolerance returns the spec defaults for scientific comparisons.\r\n    28\tfunc DefaultTolerance() Tolerance {\r\n    29\t\treturn Tolerance{\r\n    30\t\t\tAbsolute: 1e-10,\r\n    31\t\t\tRelative: 1e-8,\r\n    32\t\t}\r\n    33\t}\r\n    34\t\r\n    35"]
[3077.865782, "o", "\t// ComparisonResult holds the outcome of comparing two experiment results.\r\n    36\ttype ComparisonResult struct {\r\n    37\t\tMatch        bool\r\n    38\t\tTotalPairs   int\r\n    39\t\tMatchedPairs int\r\n    40\t\tMismatches   []Mismatch\r\n    41\t\tMode         ComparisonMode\r\n    42\t\tTolerance    Tolerance\r\n    43\t\tSummary      string\r\n    44\t}\r\n    45\t\r\n    46\t// Mismatch records a single value pair that didn't match.\r\n    47\ttype Mismatch struct {\r\n    48\t\tIndex   int\r\n    49\t\tLabel   string\r\n    50\t\tValueA  float64\r\n    51\t\tValueB  float64\r\n    52\t\tAbsDiff float64\r\n    53\t\tRelDiff float64\r\n    54\t}\r\n    55\t\r\n    56\t// Compare compares two stored results.\r\n    57\tfunc Compare(a, b *storage.StoredResult, mode ComparisonMode, tol Tolerance) *ComparisonResult {\r\n    58\t\tresult := &ComparisonResult{\r\n"]
[3077.865854, "o", "    59\t\t\tMode:      mode,\r\n    60\t\t\tTolerance: tol,\r\n    61\t\t}\r\n    62\t\r\n    63\t\tif a.ExperimentName != b.ExperimentName {\r\n    64\t\t\tresult.Match = false\r\n    65\t\t\tresult.Summary = fmt.Sprintf(\"experiment name mismatch: %s vs %s\", a.ExperimentName, b.ExperimentName)\r\n    66\t\t\treturn result\r\n    67\t\t}\r\n    68\t\r\n    69\t\t"]
[3077.865922, "o", "minLen := len(a.Values)\r\n    70\t\tif len(b.Values) < minLen {\r\n    71\t\t\tminLen = len(b.Values)\r\n    72\t\t}\r\n    73\t\r\n    74\t\tif len(a.Values) != len(b.Values) {\r\n    75\t\t\tresult.Match = false\r\n    76\t\t\tresult.Summary = fmt.Sprintf(\"value count mismatch: %d vs %d\", len(a.Values), len(b.Values))\r\n    77\t\t\treturn result\r\n"]
[3077.865982, "o", "    78\t\t}\r\n    79\t\r\n    80\t\tresult.TotalPairs = minLen\r\n    81\t\r\n    82\t\tswitch mode {\r\n    83\t\tcase ModeExact:\r\n    84\t\t\tresult.Match = true\r\n    85\t\t\tfor i := 0; i < minLen; i++ {\r\n"]
[3077.866044, "o", "    86\t\t\t\tlabel := fmt.Sprintf(\"value[%d]\", i)\r\n    87\t\t\t\tif i < len(a.Labels) {\r\n    88\t\t\t\t\tlabel = a.Labels[i]\r\n    89\t\t\t\t}\r\n    90\t\t\t\tif a.Values[i] != b.Values[i] {\r\n    91\t\t\t\t\tresult.Match = false\r\n    92\t\t\t\t\tresult.Mismatches = append(result.Mismatches, Mismatch{\r\n    93\t\t\t\t\t\tIndex:   i,\r\n    94\t\t\t\t\t\tLabel:   label,\r\n    95\t\t\t\t\t\tValueA:  a.Values[i],\r\n"]
[3077.866103, "o", "    96\t\t\t\t\t\tValueB:  b.Values[i],\r\n    97\t\t\t\t\t\tAbsDiff: math.Abs(a.Values[i] - b.Values[i]),\r\n    98\t\t\t\t\t\tRelDiff: relDiff(a.Values[i], b.Values[i]),\r\n    99\t\t\t\t\t})\r\n   100\t\t\t\t} else {\r\n   101\t\t\t\t\tresult.MatchedPairs++\r\n   102\t\t\t\t}\r\n   103\t\t\t}\r\n"]
[3077.866159, "o", "   104\t\tcase ModeTolerance:\r\n   105\t\t\tresult.Match = true\r\n   106\t\t\tfor i := 0; i < minLen; i++ {\r\n   107\t\t\t\tlabel := fmt.Sprintf(\"value[%d]\", i)\r\n   108\t\t\t\tif i < len(a.Labels) {\r\n   109\t\t\t\t\tlabel = a.Labels[i]\r\n   110\t\t\t\t}\r\n   111\t\t\t\tif !valuesMatch(a.Values[i], b.Values[i], tol) {\r\n   112\t\t\t\t\tresult.Match = false\r\n"]
[3077.866224, "o", "   113\t\t\t\t\tresult.Mismatches = append(result.Mismatches, Mismatch{\r\n   114\t\t\t\t\t\tIndex:   i,\r\n   115\t\t\t\t\t\tLabel:   label,\r\n   116\t\t\t\t\t\tValueA:  a.Values[i],\r\n"]
[3077.866285, "o", "   117\t\t\t\t\t\tValueB:  b.Values[i],\r\n   118\t\t\t\t\t\tAbsDiff: math.Abs(a.Values[i] - b.Values[i]),\r\n   119\t\t\t\t\t\tRelDiff: relDiff(a.Values[i], b.Values[i]),\r\n   120\t\t\t\t\t})\r\n   121\t\t\t\t} else {\r\n   122\t\t\t\t\tresult.MatchedPairs++\r\n   123\t\t\t\t}\r\n   124\t\t\t}\r\n   125\t\tdefault:\r\n   126\t\t\tresult.Match = false\r\n   127\t"]
[3077.866364, "o", "\t\tresult.Summary = \"unknown comparison mode\"\r\n   128\t\t\treturn result\r\n   129\t\t}\r\n   130\t\r\n   131\t\tif result.Summary == \"\" {\r\n   132\t"]
[3077.86643, "o", "\t\tif result.Match {\r\n   133\t\t\t\tresult.Summary = fmt.Sprintf(\"all %d value pairs match\", result.TotalPairs)\r\n   134\t\t\t} else {\r\n   135\t\t\t\tresult.Summary = fmt.Sprintf(\"%d of %d value pairs mismatch\", len(result.Mismatches), result.TotalPairs)\r\n   136\t\t\t}\r\n   137\t\t}\r\n   138\t\r\n   139\t\treturn result\r\n   140\t}\r\n   141\t\r\n   142\t// valuesMatch implements the spec's tolerance comparison rules.\r\n   143\tfunc valuesMatch(a, b float64, tol Tolerance) bool {\r\n"]
[3077.866506, "o", "   144\t\tif math.IsNaN(a) && math.IsNaN(b) {\r\n   145\t\t\treturn true\r\n   146\t\t}\r\n   147\t\tif math.IsNaN(a) || math.IsNaN(b) {\r\n   148\t\t\treturn false\r\n   149\t\t}\r\n   150\t\r\n   151\t\tif math.IsInf(a, 1) && math.IsInf(b, 1) {\r\n   152\t\t\treturn true\r\n   153\t\t}\r\n"]
[3077.866618, "o", "   154\t\tif math.IsInf(a, -1) && math.IsInf(b, -1) {\r\n   155\t\t\treturn true\r\n   156\t\t}\r\n   157\t\tif math.IsInf(a, 0) || math.IsInf(b, 0) {\r\n   158\t\t\treturn false\r\n   159\t\t}\r\n   160\t\r\n   161\t\tif math.Abs(a) < tol.Absolute && math.Abs(b) < tol.Absolute {\r\n   162\t\t\treturn true\r\n   163\t\t}\r\n   164\t\r\n   165\t\tdiff := math.Abs(a - b)\r\n   166\t\tif diff <= tol.Absolute {\r\n   167\t\t\treturn true\r\n   168\t\t}\r\n   169\t\r\n   170\t\tdenom := math.Max(math.Abs(a), math.Abs(b))\r\n   171\t\tif denom > 0 && diff/denom <= tol.Relative {\r\n   172\t\t\treturn true\r\n   173\t\t}\r\n   174\t\r\n   175\t\treturn false\r\n   176\t}\r\n   177\t\r\n   178\t// FormatReport generates a human-readable comparison report.\r\n"]
[3077.86668, "o", "   179\tfunc FormatReport(cr *ComparisonResult) string {\r\n   180\t\tvar sb strings.Builder\r\n   181\t\tsb.WriteString(\"=== Comparison Report ===\\n\")\r\n   182\t\tsb.WriteString(fmt.Sprintf(\"Mode: %s\\n\", modeString(cr.Mode)))\r\n   183\t\tif cr.Mode == ModeTolerance {\r\n   184\t\t\tsb.WriteString(fmt.Sprintf(\"Absolute tolerance: %g\\n\", cr.Tolerance.Absolute))\r\n   185\t\t\tsb.WriteString(fmt.Sprintf(\"Relative tolerance: %g\\n\", cr.Tolerance.Relative))\r\n   186\t\t}\r\n   187\t\tsb.WriteString(fmt.Sprintf(\"Match: %v\\n\", cr.Match))\r\n   188\t\t"]
[3077.866745, "o", "sb.WriteString(fmt.Sprintf(\"Total pairs: %d\\n\", cr.TotalPairs))\r\n   189\t\tsb.WriteString(fmt.Sprintf(\"Matched: %d\\n\", cr.MatchedPairs))\r\n   190\t\tsb.WriteString(fmt.Sprintf(\"Summary: %s\\n\", cr.Summary))\r\n   191\t\r\n   192\t\tif len(cr.Mismatches) > 0 {\r\n   193\t\t\tsb.WriteString(\"\\nMismatches:\\n\")\r\n   194\t\t\tfor _, m := range cr.Mismatches {\r\n   195\t\t\t\tsb.WriteString(fmt.Sprintf(\"  [%d] %s: %.15e vs %.15e (abs=%.6e, rel=%.6e)\\n\",\r\n   196\t\t\t\t\tm.Index, m.Label, m.ValueA, m.ValueB, m.AbsDiff, m.RelDiff))\r\n   197\t\t\t}\r\n"]
[3077.866806, "o", "   198\t\t}\r\n   199\t\r\n   200\t\treturn sb.String()\r\n   201\t}\r\n   202\t\r\n   203\tfunc relDiff(a, b float64) float64 {\r\n   204\t\tdenom := math.Max(math.Abs(a), math.Abs(b))\r\n   205\t\tif denom < 1e-300 {\r\n   206\t\t\treturn 0\r\n   207\t\t}\r\n   208\t\treturn math.Abs(a-b) / denom\r\n"]
[3077.866867, "o", "   209\t}\r\n   210\t\r\n   211\tfunc modeString(m ComparisonMode) string {\r\n   212\t\tswitch m {\r\n   213\t\tcase ModeExact:\r\n   214\t\t\treturn \"exact\"\r\n   215\t\tcase ModeTolerance:\r\n   216\t\t\treturn \"tolerance\"\r\n   217\t\t"]
[3077.866923, "o", "default:\r\n   218\t\t\treturn \"unknown\"\r\n   219\t\t}\r\n   220\t}\r\n"]
