[3919.670576, "o", "fmt.Printf(\"# experiment: %s\\n\", result.ExperimentName)\r\n\t\tfmt.Printf(\"# timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n\t\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n\t\t\tfmt.Printf(\"# seed: %s\\n\", seed)\r\n\t\t}\r\n\t\tfmt.Println(\"label,value\")\r\n\t\tfor i, v := range result.Values {\r\n\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n\t\t\tif i < len(result.Labels) {\r\n\t\t\t\tlabel = result.Labels[i]\r\n\t\t\t}\r\n\t\t\tfmt.Printf(\"%s,%.15e\\n\", label, v)\r\n\t\t}\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown format: %s\\n\", format)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n"]
[3919.670639, "o", "\r\nfunc cmdVerify(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tid := args[0]\r\n\tstoreDir := \"./results\"\r\n\tverbose := false\r\n"]
