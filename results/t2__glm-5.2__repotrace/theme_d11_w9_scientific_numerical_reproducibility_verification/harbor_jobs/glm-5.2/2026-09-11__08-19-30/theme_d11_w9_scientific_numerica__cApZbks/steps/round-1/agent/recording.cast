[3919.948136, "o", "package storage\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n"]
[3919.948239, "o", "\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n"]
[3919.948312, "o", "\t\"numeriforge/engine\"\r\n)\r\n\r\n// StoredResult is the on-disk representation of an experiment result.\r\ntype StoredResult struct {\r\n\tID             string             `json:\"id\"`\r\n\tExperimentName string             `json:\"experiment_name\"`\r\n\tTimestamp      time.Time          `json:\"timestamp\"`\r\n\tParameters     []engine.Parameter `json:\"parameters\"`\r\n\tValues         []float64          `json:\"values\"`\r\n\tLabels         []string           `json:\"labels\"`\r\n\tMetadata       map[string]string  `json:\"metadata\"`\r\n\tChecksum       string             `json:\"checksum,omitempty\"`\r\n}\r\n\r\n// VerifyStatus reports the outcome of integrity verification.\r\ntype VerifyStatus string\r\n\r\nconst (\r\n\tStatusVerified   VerifyStatus = \"verified\"\r\n\tStatusCorrupted  VerifyStatus = \"corrupted\"\r\n\tStatusNoChecksum VerifyStatus = \"no_checksum\"\r\n)\r\n\r\n"]
[3919.948401, "o", "// IndexEntry is a stored result index record.\r\ntype IndexEntry struct {\r\n\tID             string\r\n\tExperimentName string\r\n\tTimestamp      time.Time\r\n}\r\n\r\n// Store manages experiment result persistence.\r\ntype Store struct {\r\n\tBaseDir string\r\n"]
[3919.948553, "o", "}\r\n\r\n// NewStore creates a store at the given directory.\r\nfunc NewStore(baseDir string) (*Store, error) {\r\n\tif err := os.MkdirAll(baseDir, 0755); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"cannot create store directory: %w\", err)\r\n\t}\r\n\treturn &Store{BaseDir: baseDir}, nil\r\n}\r\n\r\n// ComputeChecksum returns the SHA-256 checksum of the canonical value\r\n// representation defined by the reproducibility specification.\r\nfunc ComputeChecksum(values []float64) string {\r\n\tvar sb strings.Builder\r\n\tfor i, v := range values {\r\n\t\tif i > 0 {\r\n\t\t\tsb.WriteByte('\\n')\r\n\t\t}\r\n\t\tfmt.Fprintf(&sb, \"%.17e\", v)\r\n\t}\r\n\tsum := sha256.Sum256([]byte(sb.String()))\r\n\treturn fmt.Sprintf(\"%x\", sum)\r\n}\r\n\r\n// Save persists an experiment result to disk.\r\nfunc (s *Store) Save(result *engine.Result) (string, error) {\r\n\tid := fmt.Sprintf(\"%s_%s\", result.ExperimentName, result.Timestamp.Format(\"20060102_150405\"))\r\n\r\n\tchecksum := ComputeChecksum(result.Values)\r\n\r\n\tif result.Metadata == nil {\r\n\t\tresult.Metadata = map[string]string{}\r\n\t}\r\n\tresult.Metadata[\""]
[3919.948622, "o", "values_checksum\"] = checksum\r\n\r\n\tstored := StoredResult{\r\n\t\tID:             id,\r\n\t\tExperimentName: result.ExperimentName,\r\n\t\tTimestamp:      result.Timestamp,\r\n\t\tParameters:     result.Parameters,\r\n\t\tValues:         result.Values,\r\n\t\tLabels:         result.Labels,\r\n\t\tMetadata:       result.Metadata,\r\n\t\tChecksum:       checksum,\r\n"]
[3919.948682, "o", "\t}\r\n\r\n\tdata, err := json.MarshalIndent(stored, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"marshal error: %w\", err)\r\n\t}\r\n\r\n\tresultDir := filepath.Join(s.BaseDir, result.ExperimentName)\r\n\tif err := os.MkdirAll(resultDir, 0755); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"cannot create result directory: %w\", err)\r\n\t}\r\n"]
[3919.94874, "o", "\r\n\tpath := filepath.Join(resultDir, id+\".json\")\r\n\tif err := os.WriteFile(path, data, 0644); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"write error: %w\", err)\r\n\t}\r\n\r\n\tif err := s.updateIndex(id, result.ExperimentName, result.Timestamp); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"index update error: %w\", err)\r\n\t}\r\n\r\n"]
[3919.948799, "o", "\treturn id, nil\r\n}\r\n\r\n// Load reads a stored result by ID.\r\nfunc (s *Store) Load(id string) (*StoredResult, error) {\r\n\tvar resultPath string\r\n\terr := filepath.Walk(s.BaseDir, func(path string, info os.FileInfo, err error) error {\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n"]
[3919.948856, "o", "\t\tif !info.IsDir() && strings.TrimSuffix(info.Name(), \".json\") == id {\r\n\t\t\tresultPath = path\r\n\t\t\treturn filepath.SkipAll\r\n\t\t}\r\n\t\treturn nil\r\n\t})\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif resultPath == \"\" {\r\n"]
[3919.948913, "o", "\t\treturn nil, fmt.Errorf(\"result not found: %s\", id)\r\n\t}\r\n\r\n\tdata, err := os.ReadFile(resultPath)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"read error: %w\", err)\r\n\t}\r\n\r\n\tvar stored StoredResult\r\n\tif err := json.Unmarshal(data, &stored); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"unmarshal error: %w\", err)\r\n\t}"]
[3919.94897, "o", "\r\n\treturn &stored, nil\r\n}\r\n\r\n// ListResults returns all stored result IDs, optionally filtered by experiment name.\r\nfunc (s *Store) ListResults(experimentFilter string) ([]IndexEntry, error) {\r\n\tentries, err := s.readIndex()\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n"]
[3919.949027, "o", "\r\n\tif experimentFilter == \"\" {\r\n\t\treturn entries, nil\r\n\t}\r\n\r\n\tfiltered := make([]IndexEntry, 0)\r\n\tfor _, entry := range entries {\r\n\t\tif entry.ExperimentName == experimentFilter {\r\n"]
[3919.949089, "o", "\t\t\tfiltered = append(filtered, entry)\r\n\t\t}\r\n\t}\r\n\treturn filtered, nil\r\n}\r\n\r\n// Verify checks stored result integrity by recomputing the canonical checksum.\r\nfunc (s *Store) Verify(id string) (VerifyStatus, string, string, error) {\r\n\tstored, err := s.Load(id)\r\n\tif err != nil {\r\n\t\treturn \"\", \"\", \"\", err\r\n\t}\r\n\r\n"]
[3919.949146, "o", "\tif stored.Checksum == \"\" {\r\n\t\treturn StatusNoChecksum, \"\", \"\", nil\r\n\t}\r\n\r\n\tcomputed := ComputeChecksum(stored.Values)\r\n\tif computed == stored.Checksum {\r\n\t\treturn StatusVerified, stored.Checksum, computed, nil\r\n\t}\r\n\treturn StatusCorrupted, stored.Checksum, computed, nil\r\n}\r\n\r\n"]
[3919.949212, "o", "func (s *Store) indexPath() string {\r\n\treturn filepath.Join(s.BaseDir, \"index.txt\")\r\n}\r\n\r\nfunc (s *Store) updateIndex(id, experimentName string, timestamp time.Time) error {\r\n\tif err := os.MkdirAll(s.BaseDir, 0755); err != nil {\r\n"]
[3919.94927, "o", "\t\treturn err\r\n\t}\r\n\r\n\tf, err := os.OpenFile(s.indexPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdefer f.Close()\r\n\r\n\t_, err = fmt.Fprintf(f, \"%s|%s|%s\\n\", id, experimentName, timestamp.Format(time.RFC3339))\r\n\treturn err\r\n}\r\n\r\nfunc (s *Store) readIndex() ([]IndexEntry, error) {\r\n\tdata, err := os.ReadFile(s.indexPath())\r\n\tif err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n"]
[3919.949326, "o", "\t\t\treturn nil, nil\r\n\t\t}\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tvar entries []IndexEntry\r\n\tfor _, line := range strings.Split(strings.TrimSpace(string(data)), \"\\n\") {\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n"]
[3919.949387, "o", "\t\t}\r\n\t\tparts := strings.SplitN(line, \"|\", 3)\r\n\t\tif len(parts) != 3 {\r\n\t\t\tcontinue\r\n"]
