[3961.875839, "o", "\u001b[32m\u001b[K737\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K[field] != current[field] {\r\n\u001b[32m\u001b[K738\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tdiffs = append(diffs, fmt.Sprintf(\"%s stored=%q current=%q\", field, \u001b[01;31m\u001b[Kmetadata\u001b[m\u001b[K[field], current[field]))\r\n"]
