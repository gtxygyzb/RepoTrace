[3955.762903, "o", "   121\t\t\tswitch args[i] {\r\n   122\t\t\tcase \"--experiment\":\r\n   123\t\t\t\ti++\r\n"]
[3955.763002, "o", "   124\t\t\t\tif i >= len(args) {\r\n   125\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment requires a value\\n\")\r\n   126\t\t\t\t\tos.Exit(1)\r\n   127\t\t\t\t}\r\n   128\t\t\t\texperimentName = args[i]\r\n   129\t\t\tcase \"--output-dir\":\r\n   130\t\t\t\ti++\r\n   131\t\t\t\tif i >= len(args) {\r\n   132\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --output-dir requires a value\\n\")\r\n   133\t\t\t\t\tos.Exit(1)\r\n"]
[3955.763082, "o", "   134\t\t\t\t}\r\n   135\t\t\t\toutputDir = args[i]\r\n   136\t\t\tcase \"--config\":\r\n   137\t\t\t\ti++\r\n   138\t\t\t\tif i >= len(args) {\r\n   139\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --config requires a value\\n\")\r\n   140\t\t\t\t\tos.Exit(1)\r\n   141\t\t\t\t}\r\n   142\t\t\t\tconfigPath = args[i]\r\n   143\t\t\tcase \"--param\":\r\n   144\t\t\t\ti++\r\n   145\t\t\t\tif i >= len(args) {\r\n"]
[3955.763141, "o", "   146\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --param requires a value\\n\")\r\n   147\t\t\t\t\tos.Exit(1)\r\n   148\t\t\t\t}\r\n   149\t\t\t\tparamStrs = append(paramStrs, args[i])\r\n   150\t\t\tcase \"--seed\":\r\n   151\t\t\t\ti++\r\n   152\t\t\t\tif i >= len(args) {\r\n"]
[3955.763201, "o", "   153\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --seed requires a value\\n\")\r\n   154\t\t\t\t\tos.Exit(1)\r\n   155\t\t\t\t}\r\n   156\t\t\t\tparsed, err := strconv.ParseInt(args[i], 10, 64)\r\n   157\t\t\t\tif err != nil {\r\n   158\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid seed: %v\\n\", err)\r\n   159\t\t\t\t\tos.Exit(1)\r\n   160\t\t\t"]
[3955.763264, "o", "\t}\r\n   161\t\t\t\tseed = parsed\r\n   162\t\t\t\tseedProvided = true\r\n   163\t\t\tdefault:\r\n   164\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   165\t\t\t\tos.Exit(1)\r\n   166\t\t\t}\r\n   167\t\t}\r\n   168\t\r\n"]
[3955.763324, "o", "   169\t\tif configPath != \"\" {\r\n   170\t\t\tcfg, err := config.ParseINI(configPath)\r\n   171\t\t\tif err != nil {\r\n   172\t\t\t\tfmt.Fprintf(os.Stderr, \"config error: %v\\n\", err)\r\n   173\t\t\t\tos.Exit(1)\r\n   174\t\t\t}\r\n   175\t\t\tif experimentName == \"\" {\r\n   176\t\t\t\texperimentName = cfg.Experiment\r\n   177\t\t\t}\r\n"]
[3955.763383, "o", "   178\t\t\tif outputDir == \"\" {\r\n   179\t\t\t\toutputDir = cfg.OutputDir\r\n   180\t\t\t}\r\n   181\t\r\n   182\t\t\tcliParams, _ := config.ParseParams(paramStrs)\r\n   183\t\t\tcliParamMap := make(map[string]float64)\r\n   184\t\t\tfor _, p := range cliParams {\r\n   185\t\t\t\tcliParamMap[p.Name] = p.Value\r\n"]
[3955.763448, "o", "   186\t\t\t}\r\n   187\t\t\tfor _, p := range cfg.Params {\r\n   188\t\t\t\tif _, exists := cliParamMap[p.Name]; !exists {\r\n   189\t\t\t\t\tcliParams = append(cliParams, p)\r\n"]
[3955.763537, "o", "   190\t\t\t\t}\r\n   191\t\t\t}\r\n   192\t\t\tparamStrs = nil\r\n   193\t\t\tfor _, p := range cliParams {\r\n   194\t\t\t\tparamStrs = append(paramStrs, fmt.Sprintf(\"%s=%g\", p.Name, p.Value))\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197\t\r\n   198\t\tif experimentName == \"\" {\r\n   199\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment is required\\n\")\r\n   200\t\t\tos.Exit(1)\r\n   201\t\t}\r\n   202\t\tif outputDir == \"\" {\r\n   203\t\t\toutputDir = \"./results\"\r\n   204\t\t}\r\n   205\t\r\n   206\t\tparams, err := config.ParseParams(paramStrs)\r\n   207\t\t"]
[3955.763596, "o", "if err != nil {\r\n   208\t\t\tfmt.Fprintf(os.Stderr, \"parameter error: %v\\n\", err)\r\n   209\t\t\tos.Exit(1)\r\n   210\t\t}\r\n   211\t\r\n   212\t\tfn, err := engine.Get(experimentName)\r\n   213\t\tif err != nil {\r\n   214\t\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\r\n   215\t\t\tos.Exit(1)\r\n"]
[3955.76366, "o", "   216\t\t}\r\n   217\t\r\n   218\t\tif !seedProvided {\r\n   219\t\t\tseed = time.Now().UnixNano()\r\n   220\t\t}\r\n"]
[3955.763721, "o", "   221\t\r\n   222\t\trng := engine.NewRNG(seed)\r\n   223\t\r\n   224\t\tresult, err := fn(experimentName, params, rng)\r\n   225\t\tif err != nil {\r\n   226\t\t\tfmt.Fprintf(os.Stderr, \"experiment error: %v\\n\", err)\r\n   227\t\t\tos.Exit(1)\r\n   228\t\t}\r\n   229\t\r\n   230\t\tif result.Metadata == nil {\r\n   231\t\t\tresult.Metadata = map[string]string{}\r\n   232\t\t}\r\n   233\t\t"]
[3955.763783, "o", "if _, ok := result.Metadata[\"seed\"]; !ok {\r\n   234\t\t\tresult.Metadata[\"seed\"] = strconv.FormatInt(seed, 10)\r\n   235\t\t}\r\n   236\t\tif seedProvided {\r\n   237\t\t\tresult.Metadata[\"seed_source\"] = \"provided\"\r\n   238\t\t} else {\r\n   239\t\t\tresult.Metadata[\"seed_source\"] = \"auto-generated\"\r\n   240\t\t}\r\n   241\t\r\n   242\t\tfor k, v := range environmentMetadata() {\r\n   243"]
[3955.763858, "o", "\t\t\tresult.Metadata[k] = v\r\n   244\t\t}\r\n   245\t\r\n   246\t\tstore, err := storage.NewStore(outputDir)\r\n   247\t\tif err != nil {\r\n   248\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   249\t\t\tos.Exit(1)\r\n   250\t\t}\r\n   251\t\r\n   252\t\tid, err := store.Save(result)\r\n"]
[3955.763918, "o", "   253\t\tif err != nil {\r\n   254\t\t\tfmt.Fprintf(os.Stderr, \"save error: %v\\n\", err)\r\n   255\t\t\tos.Exit(1)\r\n   256\t\t}\r\n   257\t\r\n   258\t\tfmt.Printf(\"Experiment: %s\\n\", experimentName)\r\n   259\t\tfmt.Printf(\"Result ID: %s\\n\", id)\r\n   260\t\tfmt.Printf(\"Values:\\n\")\r\n"]
