[3948.019665, "o", "\t\tcase \"--param\":\r\n   144\t\t\t\ti++\r\n   145\t\t\t\tif i >= len(args) {\r\n   146\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --param requires a value\\n\")\r\n   147\t\t\t\t\tos.Exit(1)\r\n   148\t\t\t\t}\r\n   149\t\t\t\tparamStrs = append(paramStrs, args[i])\r\n   150\t\t\tcase \"--seed\":\r\n   151\t\t\t\ti++\r\n   152\t\t\t\tif i >= len(args) {\r\n   153\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --seed requires a value\\n\")\r\n   154\t\t\t\t\tos.Exit(1)\r\n   155\t\t\t\t}\r\n   156\t\t\t\tparsed, err := strconv.ParseInt(args[i], 10, 64)\r\n   157\t\t\t\tif err != nil {\r\n"]
[3948.019731, "o", "   158\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid seed: %v\\n\", err)\r\n   159\t\t\t\t\tos.Exit(1)\r\n   160\t\t\t\t}\r\n   161\t\t\t\tseed = parsed\r\n   162\t\t\t\tseedProvided = true\r\n   163\t\t\tdefault:\r\n   164\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   165\t\t\t\tos.Exit(1)\r\n   166\t\t\t}\r\n   167\t\t}\r\n   168"]
[3948.019796, "o", "\t\r\n   169\t\tif configPath != \"\" {\r\n   170\t\t\tcfg, err := config.ParseINI(configPath)\r\n   171\t\t\tif err != nil {\r\n   172\t\t\t\tfmt.Fprintf(os.Stderr, \"config error: %v\\n\", err)\r\n   173\t\t\t\tos.Exit(1)\r\n   174\t\t\t}\r\n   175\t\t\tif experimentName == \"\" {\r\n   176\t\t\t\texperimentName = cfg.Experiment\r\n"]
