[3926.844796, "o", "   245\t\r\n   246\t\tstore, err := storage.NewStore(outputDir)\r\n   247\t\tif err != nil {\r\n   248\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   249\t\t\tos.Exit(1)\r\n   250\t\t}\r\n   251\t\r\n   252\t\tid, err := store.Save(result)\r\n   253\t\tif err != nil {\r\n   254\t\t\tfmt.Fprintf(os.Stderr, \"save error: %v\\n\", err)\r\n   255\t\t\tos.Exit(1)\r\n   256\t\t}\r\n   257\t\r\n   258\t\tfmt.Printf(\"Experiment: %s\\n\", experimentName)\r\n   259\t\tfmt.Printf(\"Result ID: %s\\n\", id)\r\n   260\t\tfmt.Printf(\"Values:\\n\")\r\n   261\t\tfor i, v := range result.Values {\r\n   262\t\t\tlabel := fmt.Sprintf(\"[%d]\", i)\r\n"]
[3926.84489, "o", "   263\t\t\tif i < len(result.Labels) {\r\n   264\t\t\t\tlabel = result.Labels[i]\r\n   265\t\t\t}\r\n   266\t\t\tfmt.Printf(\"  %s = %.15e\\n\", label, v)\r\n   267\t\t}\r\n   268\t"]
[3926.844956, "o", "}\r\n   269\t\r\n   270\tfunc cmdCompare(args []string) {\r\n   271\t\tif len(args) < 2 {\r\n   272\t\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge compare <result_id_1> <result_id_2> --store-dir <dir> [--mode exact|tolerance] [--abs-tol <val>] [--rel-tol <val>]\\n\")\r\n   273\t\t\tos.Exit(1)\r\n   274\t\t}\r\n   275\t\r\n   276\t\tid1 := args[0]\r\n   277\t\tid2 := args[1]\r\n   278\t\tstoreDir := \"./results\"\r\n   279\t\tmode := \"exact\"\r\n   280\t\ttol := compare.DefaultTolerance()\r\n   281\t\r\n   282\t\tfor i := 2; i < len(args); i++ {\r\n   283\t\t\tswitch args[i] {\r\n   284\t\t\tcase \"--store-dir\":\r\n   285\t\t\t\ti++\r\n"]
[3926.845017, "o", "   286\t\t\t\tif i >= len(args) {\r\n   287\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n   288\t\t\t\t\tos.Exit(1)\r\n   289\t\t\t\t}\r\n   290\t\t\t\tstoreDir = args[i]\r\n   291\t\t\tcase \"--mode\":\r\n   292\t\t\t\ti++\r\n   293\t\t\t\tif i >= len(args) {\r\n"]
[3926.845079, "o", "   294\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --mode requires a value\\n\")\r\n   295\t\t\t\t\tos.Exit(1)\r\n   296\t\t\t\t}\r\n   297\t\t\t\tmode = args[i]\r\n   298\t\t\tcase \"--abs-tol\":\r\n   299\t\t\t\ti++\r\n   300\t\t\t\tif i >= len(args) {\r\n   301\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --abs-tol requires a value\\n\")\r\n   302\t\t\t\t\t"]
[3926.84514, "o", "os.Exit(1)\r\n   303\t\t\t\t}\r\n   304\t\t\t\tv, err := strconv.ParseFloat(args[i], 64)\r\n   305\t\t\t\tif err != nil {\r\n   306\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid absolute tolerance: %v\\n\", err)\r\n   307\t\t\t\t\tos.Exit(1)\r\n   308\t\t\t\t}\r\n   309\t\t"]
[3926.845198, "o", "\t\ttol.Absolute = v\r\n   310\t\t\tcase \"--rel-tol\":\r\n   311\t\t\t\ti++\r\n   312\t\t\t\tif i >= len(args) {\r\n   313\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --rel-tol requires a value\\n\")\r\n   314\t\t\t\t\tos.Exit(1)\r\n   315\t\t\t\t}\r\n"]
[3926.84526, "o", "   316\t\t\t\tv, err := strconv.ParseFloat(args[i], 64)\r\n   317\t\t\t\tif err != nil {\r\n   318\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid relative tolerance: %v\\n\", err)\r\n   319\t\t\t\t\tos.Exit(1)\r\n   320\t\t\t\t}\r\n   321\t\t\t\ttol.Relative = v\r\n   322\t\t\tdefault:\r\n   323\t\t\t\t"]
[3926.845319, "o", "fmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   324\t\t\t\tos.Exit(1)\r\n   325\t\t\t}\r\n   326\t\t}\r\n   327\t\r\n   328\t\tstore, err := storage.NewStore(storeDir)\r\n   329\t\tif err != nil {\r\n   330\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   331\t\t\tos.Exit(1)\r\n"]
[3926.845381, "o", "   332\t\t}\r\n   333\t\r\n   334\t\ta, err := store.Load(id1)\r\n   335\t\tif err != nil {\r\n   336\t\t\tfmt.Fprintf(os.Stderr, \"load error: %v\\n\", err)\r\n   337\t\t\tos.Exit(1)\r\n   338\t\t}\r\n"]
[3926.845443, "o", "   339\t\r\n   340\t\tb, err := store.Load(id2)\r\n   341\t\tif err != nil {\r\n   342\t\t\tfmt.Fprintf(os.Stderr, \"load error: %v\\n\", err)\r\n   343\t\t\tos.Exit(1)\r\n   344\t\t}\r\n   345\t\r\n   346\t\tvar comparisonMode compare.ComparisonMode\r\n   347\t\tswitch mode {\r\n   348\t\t"]
