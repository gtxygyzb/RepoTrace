[2576.936693, "o", "\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype\u001b[m\u001b[K Result struct {\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype\u001b[m\u001b[K ExperimentFunc func(name string, params []Parameter, rng RNG) (*Result, error)\r\n\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype\u001b[m\u001b[K RNG = *rand.Rand\r\n"]
[2576.936758, "o", "\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K NewRNG(seed int64) RNG {\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K Register(name string, fn ExperimentFunc) {\r\n\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K Get(name string) (ExperimentFunc, error) {\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K List() []string {\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K GetParam(params []Parameter, name string) (float64, bool) {\r\n"]
[2576.936817, "o", "\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K RequireParam(params []Parameter, name string) (float64, error) {\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K init() {\r\n"]
