[5413.636237, "o", "\u001b[?2004h> "]
[5413.636302, "o", "        ok := 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[5413.636356, "o", "> "]
[5413.636406, "o", "        fail := 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[5413.636463, "o", "> "]
[5413.636533, "o", "        noChecksum := 0\r\n\u001b[?2004l\r"]
[5413.636589, "o", "\u001b[?2004h> "]
