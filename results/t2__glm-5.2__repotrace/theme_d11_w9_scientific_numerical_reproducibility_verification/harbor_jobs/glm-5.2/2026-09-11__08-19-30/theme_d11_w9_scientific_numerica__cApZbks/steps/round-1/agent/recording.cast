[2593.213302, "o", "\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  numeriforge run --experiment <name> [--param key=value ...] [--output-dir <dir>] [--config <file>] [--\u001b[01;31m\u001b[Kseed\u001b[m\u001b[K <integer>]\r\n"]
[2593.213392, "o", "\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// environment\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K returns the environment fingerprint metadata required for\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc environment\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K() map[string]string {\r\n"]
[2593.213472, "o", "\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// environmentFrom\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K aggregates stored environment fingerprint metadata\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc environmentFrom\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K(metadata map[string]string) environmentInfo {\r\n\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar \u001b[01;31m\u001b[Kseed\u001b[m\u001b[K int64\r\n\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kseed\u001b[m\u001b[KProvided := false\r\n\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Kseed\u001b[m\u001b[K\":\r\n"]
[2593.213569, "o", "\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --\u001b[01;31m\u001b[Kseed\u001b[m\u001b[K requires a value\\n\")\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid \u001b[01;31m\u001b[Kseed\u001b[m\u001b[K: %v\\n\", err)\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kseed\u001b[m\u001b[K = parsed\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kseed\u001b[m\u001b[KProvided = true\r\n"]
[2593.213665, "o", "\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfn, err := \u001b[01;31m\u001b[Kengine.Get\u001b[m\u001b[K(experimentName)\r\n\u001b[32m\u001b[K213\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif !\u001b[01;31m\u001b[Kseed\u001b[m\u001b[KProvided {\r\n\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kseed\u001b[m\u001b[K = time.Now().UnixNano()\r\n"]
[2593.213725, "o", "\u001b[32m\u001b[K217\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\trng := engine.\u001b[01;31m\u001b[KNewRNG\u001b[m\u001b[K(\u001b[01;31m\u001b[Kseed\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K == nil {\r\n"]
[2593.213798, "o", "\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K = map[string]string{}\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif _, ok := result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"\u001b[01;31m\u001b[Kseed\u001b[m\u001b[K\"]; !ok {\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"\u001b[01;31m\u001b[Kseed\u001b[m\u001b[K\"] = strconv.FormatInt(\u001b[01;31m\u001b[Kseed\u001b[m\u001b[K, 10)\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif \u001b[01;31m\u001b[Kseed\u001b[m\u001b[KProvided {\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"\u001b[01;31m\u001b[Kseed\u001b[m\u001b[K_source\"] = \"provided\"\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[\"\u001b[01;31m\u001b[Kseed\u001b[m\u001b[K_source\"] = \"auto-generated\"\r\n"]
[2593.21386, "o", "\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor k, v := range environment\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K() {\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tresult.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K[k] = v\r\n\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tid, err := store.\u001b[01;31m\u001b[KSave\u001b[m\u001b[K(result)\r\n"]
[2593.213946, "o", "\u001b[32m\u001b[K460\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tEnvironment:  environmentFrom\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K(result.\u001b[01;31m\u001b[KMetadata\u001b[m\u001b[K),\r\n"]
