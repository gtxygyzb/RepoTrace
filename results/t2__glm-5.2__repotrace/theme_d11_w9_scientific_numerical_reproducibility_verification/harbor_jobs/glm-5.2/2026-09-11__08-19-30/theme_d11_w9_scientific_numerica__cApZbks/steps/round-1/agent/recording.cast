[3737.393549, "o", "\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K4. Print `\u001b[01;31m\u001b[KINTEGRITY_OK:\u001b[m\u001b[K <id>` and exit 0 if checksums match.\r\n"]
[3737.393664, "o", "\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K5. Print `\u001b[01;31m\u001b[KINTEGRITY_FAIL:\u001b[m\u001b[K <id>` and exit 1 if they differ.\r\n"]
[3737.393743, "o", "\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K6. Print `\u001b[01;31m\u001b[KNO_CHECKSUM:\u001b[m\u001b[K <id>` and exit 2 if the stored result has no checksum field.\r\n"]
[3737.393808, "o", "\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K7. When `--\u001b[01;31m\u001b[Kverbose\u001b[m\u001b[K` is supplied, after the `INTEGRITY_OK` or `INTEGRITY_FAIL` line, also print:\r\n"]
[3737.393919, "o", "\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   - `\u001b[01;31m\u001b[KStored checksum\u001b[m\u001b[K: <hex>`\r\n"]
[3737.394047, "o", "\u001b[35m\u001b[Kdocs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   - `\u001b[01;31m\u001b[KComputed checksum\u001b[m\u001b[K: <hex>`\r\n"]
[3737.394142, "o", "\u001b[35m\u001b[Kdocs/legacy_api.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Knumeriforge verify <id> --store-dir <dir> [--\u001b[01;31m\u001b[Kverbose\u001b[m\u001b[K]\r\n"]
[3737.394353, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K496\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge verify <result_id> --store-dir <dir> [--\u001b[01;31m\u001b[Kverbose\u001b[m\u001b[K]\\n\")\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K502\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kverbose\u001b[m\u001b[K := false\r\n"]
