[4148.81003, "o", " of matrix data with row-major labeling.\r\nengine/matrix.go:76:// matrixLUDecompose performs LU decomposition with partial pivoting.\r\nengine/matrix.go:78:func matrixLUDecompose(name string, params []Parameter, rng RNG) (*Result, error) {\r\nengine/matrix.go:90:\t\treturn nil, fmt.Errorf(\"matrix size must be between 1 and 100, got %d\", size)\r\nengine/matrix.go:152:\tallLabels := append([]string{\"residual_norm\", \"matrix_size\"}, lLabels...)\r\nengine/matrix.go:161:\t\tMetadata:       map[string]string{\"method\": \"partial_pivoting\", \"matrix_type\": \"random_dense\"},\r\nengine/matrix.go:188:// matrixQRDecompose performs QR decomposition via modified Gram-Schmidt.\r\nengine/matrix.go:190:func matrixQRDecompose(name string, params []Parameter, rng RNG) (*Result, error) {\r\nengine/matrix.go:207:\t\treturn nil, fmt.Errorf(\"matrix dimensions must be between 1 and 50\")\r\nengine/matrix.go:296:\t\tMetadata:       map[string]string{\"method\": \"modified_gram_schmidt\", \"matrix_type\": \"random_dense\"},\r\nengine/matrix.go:300:// matrixEigenvalue estimat"]
[4148.810131, "o", "es the dominant eigenvalue using power iteration.\r\nengine/matrix.go:302:func matrixEigenvalue(name string, params []Parameter, rng RNG) (*Result, error) {\r\nengine/matrix.go:390:\t\tLabels:         []string{\"dominant_eigenvalue\", \"converged\", \"convergence_iteration\", \"matrix_size\"},\r\nengine/matrix.go:391:\t\tMetadata:       map[string]string{\"method\": \"power_iteration\", \"matrix_type\": \"spd\"},\r\nengine/ode.go:10:\tRegister(\"ode-euler\", odeEuler)\r\nengine/ode.go:11:\tRegister(\"ode-rk4\", odeRK4)\r\nengine/ode.go:12:\tRegister(\"ode-system\", odeSystem)\r\nengine/ode.go:19:var odeSystems = map[string]struct {\r\nengine/ode.go:75:// odeEuler solves an ODE system using forward Euler method.\r\nengine/ode.go:77:func odeEuler(name string, params []Parameter, rng RNG) (*Result, error) {\r\nengine/ode.go:99:\tsys := odeSystems[sysNames[sysIdx]]\r\nengine/ode.go:155:// odeRK4 solves an ODE system using the classic 4th-order Runge-Kutta method.\r\nengine/ode.go:157:func odeRK4(name string, params []Parameter, rng RNG) (*Result, error) {\r\nengine/od"]
[4148.810198, "o", "e.go:179:\tsys := odeSystems[sysNames[sysIdx]]\r\nengine/ode.go:250:// odeSystem solves a coupled system with noise injection for uncertainty quantification.\r\nengine/ode.go:252:func odeSystem(name string, params []Parameter, rng RNG) (*Result, error) {\r\nengine/ode.go:278:\tsys := odeSystems[sysNames[sysIdx]]\r\nengine/stats.go:11:\tRegister(\"stats-ttest\", statsTTest)\r\nengine/stats.go:12:\tRegister(\"stats-chi-squared\", statsChiSquared)\r\nengine/stats.go:13:\tRegister(\"stats-ks-test\", statsKSTest)\r\nengine/stats.go:16:// statsTTest performs a two-sample t-test.\r\nengine/stats.go:19:func statsTTest(name string, params []Parameter, rng RNG) (*Result, error) {\r\nengine/stats.go:89:// statsChiSquared performs a chi-squared goodness-of-fit test.\r\nengine/stats.go:92:func statsChiSquared(name string, params []Parameter, rng RNG) (*Result, error) {\r\nengine/stats.go:154:// statsKSTest performs a two-sample Kolmogorov-Smirnov test.\r\nengine/stats.go:156:func statsKSTest(name string, params []Parameter, rng RNG) (*Result, error) {\r\n"]
