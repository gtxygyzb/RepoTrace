[3984.688504, "o", "   367\tfunc cmdList(args []string) {\r\n   368\t\tstoreDir := \"./results\"\r\n   369\t\texperimentFilter := \"\"\r\n   370\t\r\n   371\t\tfor i := 0; i < len(args); i++ {\r\n"]
[3984.688585, "o", "   372\t\t\tswitch args[i] {\r\n   373\t\t\tcase \"--store-dir\":\r\n   374\t\t\t\ti++\r\n   375\t\t\t\tif i >= len(args) {\r\n   376\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n   377\t\t\t\t\tos.Exit(1)\r\n   378\t\t\t\t}\r\n   379\t\t\t\tstoreDir = args[i]\r\n"]
[3984.688656, "o", "   380\t\t\tcase \"--experiment\":\r\n   381\t\t\t\ti++\r\n   382\t\t\t\tif i >= len(args) {\r\n   383\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --experiment requires a value\\n\")\r\n   384\t\t\t\t\tos.Exit(1)\r\n   385\t\t\t\t}\r\n   386\t\t\t\texperimentFilter = args[i]\r\n   387\t\t\tdefault:\r\n   388\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n"]
