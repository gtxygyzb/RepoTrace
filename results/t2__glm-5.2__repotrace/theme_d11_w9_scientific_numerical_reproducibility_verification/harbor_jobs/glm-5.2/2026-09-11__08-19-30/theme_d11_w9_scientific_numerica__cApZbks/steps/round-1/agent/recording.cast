[3941.936646, "o", "\t\t\tos.Exit(1)\r\n   491\t\t}\r\n   492\t}\r\n   493\t\r\n   494\tfunc cmdVerify(args []string) {\r\n   495\t\tif len(args) < 1 {\r\n   496\t\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge verify <result_id> --store-dir <dir> [--verbose]\\n\")\r\n   497\t\t\tos.Exit(1)\r\n   498\t\t}\r\n   499\t\r\n"]
[3941.936705, "o", "   500\t\tid := args[0]\r\n   501\t\tstoreDir := \"./results\"\r\n   502\t\tverbose := false\r\n   503\t\r\n   504\t\tfor i := 1; i < len(args); i++ {\r\n   505\t\t\tswitch args[i] {\r\n   506\t\t\tcase \"--verbose\":\r\n   507\t\t\t\tverbose = true\r\n"]
