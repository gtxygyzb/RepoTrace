[4185.887224, "o", "   114\t\r\n   115\t// tagsFromMetadata collects tag_<key> metadata entries into an export-friendly\r\n   116\t// map without the tag_ prefix. It returns nil when no tags are present.\r\n   117\tfunc tagsFromMetadata(metadata map[string]string) map[string]string {\r\n   118\t\tif metadata == nil {\r\n"]
[4185.887308, "o", "   119\t\t\treturn nil\r\n   120\t\t}\r\n   121\t\ttags := map[string]string{}\r\n   122\t\tfor k, v := range metadata {\r\n   123\t\t\tif strings.HasPrefix(k, \"tag_\") {\r\n   124\t\t\t\ttags[k[len(\"tag_\"):]] = v\r\n   125\t\t\t}\r\n   126\t\t}\r\n   127\t\tif len(tags) == 0 {\r\n   128\t\t\treturn nil\r\n   129\t\t}\r\n   130\t\treturn tags\r\n"]
[4185.887387, "o", "   131\t}\r\n   132\t\r\n   133\t// parseTagFlag parses a --tag key=value argument and returns the metadata key\r\n   134\t// and value. It prints an error and exits when the argument is malformed.\r\n   135\tfunc parseTagFlag(arg string) (string, string) {\r\n   136\t\tparts := strings.SplitN(arg, \"=\", 2)\r\n"]
[4185.88745, "o", "   137\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\r\n   138\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid tag, expected key=value: %s\\n\", arg)\r\n   139\t\t\tos.Exit(1)\r\n   140\t\t}\r\n   141\t\treturn \"tag_\" + parts[0], parts[1]\r\n   142\t}\r\n   143\t\r\n   144\t// hasMatchingTags reports whether metadata contains all requested tag filters.\r\n   145\tfunc hasMatchingTags(metadata map[string]string, tags map[string]string) bool {\r\n   146\t\tfor k, v := range tags {\r\n   147\t\t\tif metadata[\"tag_\"+k] != v {\r\n   148\t\t\t\treturn false\r\n   149\t\t\t}\r\n   150\t\t}\r\n   151\t\treturn true\r\n   152\t}"]
