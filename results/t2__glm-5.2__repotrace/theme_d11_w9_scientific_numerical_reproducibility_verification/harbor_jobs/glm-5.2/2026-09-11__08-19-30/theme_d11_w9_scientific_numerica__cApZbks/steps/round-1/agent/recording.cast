[4446.190857, "o", "   497\t\t}\r\n   498\t\r\n   499\t\tid := args[0]\r\n   500\t\tstoreDir := \"./results\"\r\n   501\t\tformat := \"json\"\r\n   502\t\r\n   503\t\tfor i := 1; i < len(args); i++ {\r\n   504\t\t\tswitch args[i] {\r\n   505\t\t\tcase \"--store-dir\":\r\n   506\t\t\t\ti++\r\n   507\t\t\t\tif i >= len(args) {\r\n   508\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --store-dir requires a value\\n\")\r\n   509\t\t\t\t\tos.Exit(1)\r\n   510\t\t\t\t}\r\n   511\t\t\t\tstoreDir = args[i]\r\n   512\t\t\tcase \"--format\":\r\n"]
[4446.190942, "o", "   513\t\t\t\ti++\r\n   514\t\t\t\tif i >= len(args) {\r\n   515\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: --format requires a value\\n\")\r\n   516\t\t\t\t\tos.Exit(1)\r\n   517\t\t\t\t}\r\n   518\t\t\t\tformat = args[i]\r\n   519\t\t\tdefault:\r\n   520\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag: %s\\n\", args[i])\r\n   521\t\t\t\tos.Exit(1)\r\n   522\t\t\t}\r\n   523\t\t}\r\n   524\t\r\n   525\t\tstore, err := storage.NewStore(storeDir)\r\n"]
[4446.191016, "o", "   526\t\tif err != nil {\r\n   527\t\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n   528\t\t\tos.Exit(1)\r\n   529\t\t}\r\n   530\t\r\n   531\t\tresult, err := store.Load(id)\r\n   532\t\tif err != nil {\r\n   533\t\t\tfmt.Fprintf(os.Stderr, \"load error: %v\\n\", err)\r\n   534\t\t\tos.Exit(1)\r\n"]
[4446.191086, "o", "   535\t\t}\r\n   536\t\r\n   537\t\tswitch format {\r\n   538\t\tcase \"json\":\r\n   539\t\t\tpayload := exportPayload{\r\n   540\t\t\t\tStoredResult: result,\r\n   541\t\t\t\tEnvironment:  environmentFromMetadata(result.Metadata),\r\n   542\t\t\t\tTags:         tagsFromMetadata(result.Metadata),\r\n   543\t\t\t}\r\n   544\t\t\tdata, err := json.MarshalIndent(payload, \"\", \"  \")\r\n"]
[4446.191156, "o", "   545\t\t\tif err != nil {\r\n   546\t\t\t\tfmt.Fprintf(os.Stderr, \"marshal error: %v\\n\", err)\r\n   547\t\t\t\tos.Exit(1)\r\n   548\t\t\t}\r\n   549\t\t\tfmt.Println(string(data))\r\n   550\t\tcase \"csv\":\r\n   551\t\t\tfmt.Printf(\"# id: %s\\n\", result.ID)\r\n   552\t\t\tfmt.Printf(\"# experiment: %s\\n\", result.ExperimentName)\r\n   553\t\t\tfmt.Printf(\"# timestamp: %s\\n\", result.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n"]
[4446.191229, "o", "   554\t\t\tif seed, ok := result.Metadata[\"seed\"]; ok {\r\n   555\t\t\t\tfmt.Printf(\"# seed: %s\\n\", seed)\r\n   556\t\t\t}\r\n   557\t\t\tfmt.Println(\"label,value\")\r\n   558\t\t\tfor i, v := range result.Values {\r\n   559\t\t\t\tlabel := fmt.Sprintf(\"value_%d\", i)\r\n   560\t\t\t\tif i < len(result.Labels) {\r\n"]
