[3942.481727, "o", "   186\t\treturn filepath.Join(s.BaseDir, \"index.txt\")\r\n   187\t}\r\n   188\t\r\n   189\tfunc (s *Store) updateIndex(id, experimentName string, timestamp time.Time) error {\r\n   190\t\tif err := os.MkdirAll(s.BaseDir, 0755); err != nil {\r\n   191\t\t\treturn err\r\n   192\t\t}\r\n   193\t\r\n   194\t\tf, err := os.OpenFile(s.indexPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)\r\n   195\t\tif err != nil {\r\n   196\t\t\treturn err\r\n   197\t\t}\r\n"]
[3942.481812, "o", "   198\t\tdefer f.Close()\r\n   199\t\r\n   200\t\t_, err = fmt.Fprintf(f, \"%s|%s|%s\\n\", id, experimentName, timestamp.Format(time.RFC3339))\r\n   201\t\treturn err\r\n   202\t}\r\n   203\t\r\n   204\tfunc (s *Store) readIndex() ([]IndexEntry, error) {\r\n   205\t\tdata, err := os.ReadFile(s.indexPath())\r\n   206\t\tif err != nil {\r\n   207\t\t\tif os.IsNotExist(err) {\r\n   208\t\t\t\treturn nil, nil\r\n"]
[3942.481877, "o", "   209\t\t\t}\r\n   210\t\t\treturn nil, err\r\n   211\t\t}\r\n   212\t\r\n   213\t\tvar entries []IndexEntry\r\n   214\t\tfor _, line := range strings.Split(strings.TrimSpace(string(data)), \"\\n\") {\r\n   215\t\t\tif line == \"\" {\r\n   216\t\t\t\tcontinue\r\n   217\t\t\t}\r\n"]
[3942.481936, "o", "   218\t\t\tparts := strings.SplitN(line, \"|\", 3)\r\n   219\t\t\tif len(parts) != 3 {\r\n   220\t\t\t\tcontinue\r\n   221\t\t\t}\r\n   222\t\t\tts, _ := time.Parse(time.RFC3339, parts[2])\r\n   223\t\t\tentries = append(entries, IndexEntry{\r\n   224\t\t\t\tID:             parts[0],\r\n   225\t\t\t\tExperimentName: parts[1],\r\n   226\t\t\t\tTimestamp:      ts,\r\n"]
[3942.481999, "o", "   227\t\t\t})\r\n   228\t\t}\r\n   229\t\r\n   230\t\tsort.Slice(entries, func(i, j int) bool {\r\n   231\t\t\treturn entries[i].Timestamp.Before(entries[j].Timestamp)\r\n   232\t\t})\r\n   233\t\r\n   234\t\treturn entries, nil\r\n   235\t}\r\n"]
