[3919.669639, "o", "\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\ta, err := store.Load(id1)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"load error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[3919.669695, "o", "\tb, err := store.Load(id2)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"load error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tvar comparisonMode compare.ComparisonMode\r\n\tswitch mode {\r\n\tcase \"exact\":\r\n\t\tcomparisonMode = compare.ModeExact"]
