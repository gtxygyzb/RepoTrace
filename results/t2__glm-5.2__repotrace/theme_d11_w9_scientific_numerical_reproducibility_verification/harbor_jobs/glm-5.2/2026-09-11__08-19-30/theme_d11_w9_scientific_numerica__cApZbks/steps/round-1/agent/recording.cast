[463.577255, "o", "\t\t\tif i < len(args) {\r\n\t\t\t\texperimentFilter = args[i]\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"storage error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[463.577317, "o", "\tentries, err := store.ListResults(experimentFilter)\r\n\tif err != nil {\r\n\t\tfmt.Fprintf(os.Stderr, \"list error: %v\\n\", err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tif len(entries) == 0 {\r\n\t\tfmt.Println(\"No results found.\")\r\n"]
[463.577377, "o", "\t\treturn\r\n\t}\r\n\r\n\tfmt.Printf(\"%-40s %-25s %s\\n\", \"ID\", \"Experiment\", \"Timestamp\")\r\n\tfmt.Println(strings.Repeat(\"-\", 80))\r\n\tfor _, entry := range entries {\r\n\t\tfmt.Printf(\"%-40s %-25s %s\\n\", entry.ID, entry.ExperimentName, entry.Timestamp.Format(\"2006-01-02 15:04:05\"))\r\n\t}\r\n}\r\n"]
[463.577446, "o", "\r\nfunc cmdExport(args []string) {\r\n\tif len(args) < 1 {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: numeriforge export <id> --store-dir <dir> [--format json|csv]\\n\")\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[463.57755, "o", "\r\n\tid := args[0]\r\n\tstoreDir := \"./results\"\r\n\tformat := \"json\"\r\n\r\n\tfor i := 1; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--store-dir\":\r\n\t\t\ti++\r\n\t\t\tif i < len(args) {\r\n\t\t\t\tstoreDir = args[i]\r\n\t\t\t}\r\n"]
[463.577609, "o", "\t\tcase \"--format\":\r\n\t\t\ti++\r\n\t\t\tif i < len(args) {\r\n\t\t\t\tformat = args[i]\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n"]
[463.577664, "o", "\tstore, err := storage.NewStore(storeDir)\r\n\tif err != nil {\r\n"]
