[4419.307007, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K633\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcmdAudit\u001b[m\u001b[K(args []string) {\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K663\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KcmdAudit\u001b[m\u001b[KAll(storeDir)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K669\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"       numeriforge \u001b[01;31m\u001b[Kaudit --all\u001b[m\u001b[K --store-dir <dir>\\n\")\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K690\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcmdAudit\u001b[m\u001b[KAll(storeDir string) {\r\n"]
[4419.307092, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K725\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"\u001b[01;31m\u001b[KAUDIT\u001b[m\u001b[K_FAIL: %s (reason: load error: %v)\\n\", id, err)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K732\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"\u001b[01;31m\u001b[KAUDIT\u001b[m\u001b[K_FAIL: %s (reason: integrity check error: %v)\\n\", id, err)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K735\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"\u001b[01;31m\u001b[KAUDIT\u001b[m\u001b[K_FAIL: %s (reason: integrity check failed: no checksum)\\n\", id)\r\n"]
[4419.307167, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K738\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"\u001b[01;31m\u001b[KAUDIT\u001b[m\u001b[K_FAIL: %s (reason: integrity check failed: expected=%s computed=%s)\\n\", id, expected, computed)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K743\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"\u001b[01;31m\u001b[KAUDIT\u001b[m\u001b[K_FAIL: %s (reason: missing seed in metadata)\\n\", id)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K747\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"\u001b[01;31m\u001b[KAUDIT\u001b[m\u001b[K_FAIL: %s (reason: invalid seed in metadata: %v)\\n\", id, err)\r\n"]
[4419.30724, "o", "\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K752\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"\u001b[01;31m\u001b[KAUDIT\u001b[m\u001b[K_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K758\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn false, fmt.Sprintf(\"\u001b[01;31m\u001b[KAUDIT\u001b[m\u001b[K_FAIL: %s (reason: experiment error: %v)\\n\", id, err)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K789\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn true, fmt.Sprintf(\"\u001b[01;31m\u001b[KAUDIT\u001b[m\u001b[K_PASS: %s\\n\", id)\r\n\u001b[35m\u001b[K./main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K793\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tsb.WriteString(fmt.Sprintf(\"\u001b[01;31m\u001b[KAUDIT\u001b[m\u001b[K_FAIL: %s\\n\", id))\r\n"]
