[3629.454413, "o", "\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K4. Print `\u001b[01;31m\u001b[KVERIFIED:\u001b[m\u001b[K <id>` and exit 0 if checksums match.\r\n\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K5. Print `\u001b[01;31m\u001b[KCORRUPTED:\u001b[m\u001b[K <id> (expected=<stored>, computed=<actual>)` and exit 1 if they differ.\r\n"]
[3629.454534, "o", "\u001b[35m\u001b[K./docs/reproducibility_spec.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K6. Print `\u001b[01;31m\u001b[KNO_CHECKSUM:\u001b[m\u001b[K <id>` and exit 2 if the stored result has no checksum field.\r\n"]
