[4279.812667, "o", "\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Knumeriforge \u001b[01;31m\u001b[Krun --experiment\u001b[m\u001b[K <name> [--param key=value ...] [--output-dir <dir>] [--config <file>]\r\n"]
