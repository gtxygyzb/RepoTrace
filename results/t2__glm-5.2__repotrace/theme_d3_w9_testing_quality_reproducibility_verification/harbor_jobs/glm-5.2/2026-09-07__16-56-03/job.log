StepsRemoved     int `json:"steps_removed"`\n\tStepsModified    int `json:"steps_modified"`\n\tStepsUnchanged   int `json:"steps_unchanged"`\n\tRegressions      int `json:"regressions"`\n\tImprovements     int `json:"improvements"`\n\tTotalOutputChanges int `json:"total_output_changes"`\n}\n\ntype diffReportLite struct {\n\tManifestName    string `json:"manifest_name"`\n\tManifestVersion string `json:"manifest_version"`\n\tOverallStatus   string `json:"overall_status"`\n\tTimestamp       string `json:"timestamp"`\n\tSteps           []stepReport `json:"steps"`\n}\n\nfunc diffCmd(args []string) {\n\tformat := "json"\n\tpositional := parseFlags(args, map[string]*string{\n\t\t"format": &format,\n\t})\n\tif len(positional) != 2 {\n\t\tfmt.Fprintln(os.Stderr, "usage: repro-verify diff <baseline.json> <current.json> [--format json|text]")\n\t\tos.Exit(2)\n\t}\n\n\tbaseline, err := loadDiffReport(positional[0], "baseline")\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\tos.Exit(2)\n\t}\n\tcurrent, err := loadDiffReport(positional[1], "current")\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\tos.Exit(2)\n\t}\n\n\tdiff := buildDiffReport(baseline, current)\n\n\tif format == "text" {\n\t\tprintDiffText(diff)\n\t} else {\n\t\tout, err := json.MarshalIndent(diff, "", "  ")\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error: %s\\n", err)\n\t\t\tos.Exit(2)\n\t\t}\n\t\tfmt.Println(string(out))\n\t}\n\n\tif diff.Summary.Regressions > 0 {\n\t\tos.Exit(1)\n\t}\n\tos.Exit(0)\n}\n\nfunc loadDiffReport(path, role string) (*diffReportLite, error) {\n\tif _, err := os.Stat(path); err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn nil, fmt.Errorf("error: diff %s not found: %s", role, path)\n\t\t}\n\t\treturn nil, fmt.Errorf("error: invalid report: %s: %s", path, err)\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf("error: invalid report: %s: %s", path, err)\n\t}\n\tvar raw map[string]json.RawMessage\n\tif err := json.Unmarshal(data, &raw); err != nil {\n\t\treturn nil, fmt.Errorf("error: invalid report: %s: %s", path, err)\n\t}\n\tfor _, field := range []string{"manifest_name", "overall_status", "steps"} {\n\t\tif _, ok := raw[field]; !ok {\n\t\t\treturn nil, fmt.Errorf("error: invalid report: %s: missing field %s", path, field)\n\t\t}\n\t}\n\tvar r diffReportLite\n\tif err := json.Unmarshal(data, &r); err != nil {\n\t\treturn nil, fmt.Errorf("error: invalid report: %s: %s", path, err)\n\t}\n\tif r.ManifestName == "" {\n\t\treturn nil, fmt.Errorf("error: invalid report: %s: missing field manifest_name", path)\n\t}\n\tif r.OverallStatus == "" {\n\t\treturn nil, fmt.Errorf("error: invalid report: %s: missing field overall_status", path)\n\t}\n\tif r.Steps == nil {\n\t\tr.Steps = []stepReport{}\n\t}\n\treturn &r, nil\n}\n\nfunc buildDiffReport(baseline, current *diffReportLite) *diffReport {\n\tbaselineSteps := map[string]stepReport{}\n\tfor _, s := range baseline.Steps {\n\t\tbaselineSteps[s.ID] = s\n\t}\n\tcurrentSteps := map[string]stepReport{}\n\tfor _, s := range current.Steps {\n\t\tcurrentSteps[s.ID] = s\n\t}\n\n\tstepIDs := map[string]bool{}\n\tfor id := range baselineSteps {\n\t\tstepIDs[id] = true\n\t}\n\tfor id := range currentSteps {\n\t\tstepIDs[id] = true\n\t}\n\n\tids := make([]string, 0, len(stepIDs))\n\tfor id := range stepIDs {\n\t\tids = append(ids, id)\n\t}\n\tsort.Strings(ids)\n\n\tchanges := make([]diffStepChange, 0, len(ids))\n\tsummary := diffSummary{}\n\n\tfor _, id := range ids {\n\t\tb, hasB := baselineSteps[id]\n\t\tc, hasC := currentSteps[id]\n\n\t\tchange := diffStepChange{\n\t\t\tStepID: id,\n\t\t}\n\t\tif hasB {\n\t\t\tbs := b.Status\n\t\t\tchange.BaselineStatus = &bs\n\t\t}\n\t\tif hasC {\n\t\t\tcs := c.Status\n\t\t\tchange.CurrentStatus = &cs\n\t\t}\n\n\t\tswitch {\n\t\tcase hasC && !hasB:\n\t\t\tchange.ChangeType = "added"\n\t\t\tsummary.StepsAdded++\n\t\t\tsummary.TotalOutputChanges += len(c.Outputs)\n\t\tcase hasB && !hasC:\n\t\t\tchange.ChangeType = "removed"\n\t\t\tsummary.StepsRemoved++\n\t\t\tsummary.TotalOutputChanges += len(b.Outputs)\n\t\tdefault:\n\t\t\toutputChanges, outputChanged := diffStepOutputs(b, c)\n\t\t\tchange.OutputChanges = outputChanges\n\t\t\tif outputChanged || !stepEqual(b, c) {\n\t\t\t\tchange.ChangeType = "modified"\n\t\t\t\tsummary.StepsModified++\n\t\t\t} else {\n\t\t\t\tchange.ChangeType = "unchanged"\n\t\t\t\tsummary.StepsUnchanged++\n\t\t\t\tchange.OutputChanges = []diffOutputChange{}\n\t\t\t}\n\t\t\tfor _, oc := range outputChanges {\n\t\t\t\tif oc.ChangeType != "unchanged" {\n\t\t\t\t\tsummary.TotalOutputChanges++\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tif hasB && hasC && b.Status != c.Status {\n\t\t\ttr := statusTransitionType(b.Status, c.Status)\n\t\t\tchange.StatusTransition = &tr\n\t\t\tif tr == "regression" {\n\t\t\t\tsummary.Regressions++\n\t\t\t} else if tr == "improvement" {\n\t\t\t\tsummary.Improvements++\n\t\t\t}\n\t\t}\n\n\t\tchanges = append(changes, change)\n\t}\n\n\treturn &diffReport{\n\t\tBaseline: diffReportMeta{\n\t\t\tManifestName:    baseline.ManifestName,\n\t\t\tManifestVersion: baseline.ManifestVersion,\n\t\t\tOverallStatus:   baseline.OverallStatus,\n\t\t\tTimestamp:       baseline.Timestamp,\n\t\t},\n\t\tCurrent: diffReportMeta{\n\t\t\tManifestName:    current.ManifestName,\n\t\t\tManifestVersion: current.ManifestVersion,\n\t\t\tOverallStatus:   current.OverallStatus,\n\t\t\tTimestamp:       current.Timestamp,\n\t\t},\n\t\tComparisonTimestamp: time.Now().UTC().Format(time.RFC3339),\n\t\tStatusTransition: diffStatusTransition{\n\t\t\tFrom: baseline.OverallStatus,\n\t\t\tTo:   current.OverallStatus,\n\t\t\tType: statusTransitionType(baseline.OverallStatus, current.OverallStatus),\n\t\t},\n\t\tStepChanges: changes,\n\t\tSummary:     summary,\n\t}\n}\n\nfunc diffStepOutputs(b, c stepReport) ([]diffOutputChange, bool) {\n\tbOutputs := map[string]outputReport{}\n\tfor _, o := range b.Outputs {\n\t\tbOutputs[o.Path] = o\n\t}\n\tcOutputs := map[string]outputReport{}\n\tfor _, o := range c.Outputs {\n\t\tcOutputs[o.Path] = o\n\t}\n\n\tpaths := map[string]bool{}\n\tfor p := range bOutputs {\n\t\tpaths[p] = true\n\t}\n\tfor p := range cOutputs {\n\t\tpaths[p] = true\n\t}\n\n\tvar keys []string\n\tfor p := range paths {\n\t\tkeys = append(keys, p)\n\t}\n\tsort.Strings(keys)\n\n\tchanges := []diffOutputChange{}\n\tchanged := false\n\n\tfor _, p := range keys {\n\t\tbo, hasB := bOutputs[p]\n\t\tco, hasC := cOutputs[p]\n\n\t\toc := diffOutputChange{\n\t\t\tPath: p,\n\t\t\tDetails: diffOutputDetail{\n\t\t\t\tBaselineFingerprints:   nilIfEmpty(bo.Fingerprints),\n\t\t\t\tCurrentFingerprints:    nilIfEmpty(co.Fingerprints),\n\t\t\t},\n\t\t}\n\t\tif hasB {\n\t\t\toc.Details.BaselineConsistent = &bo.CrossPassConsistent\n\t\t\tif bo.ReferenceMatch != nil {\n\t\t\t\toc.Details.BaselineReferenceMatch = bo.ReferenceMatch\n\t\t\t}\n\t\t}\n\t\tif hasC {\n\t\t\toc.Details.CurrentConsistent = &co.CrossPassConsistent\n\t\t\tif co.ReferenceMatch != nil {\n\t\t\t\toc.Details.CurrentReferenceMatch = co.ReferenceMatch\n\t\t\t}\n\t\t}\n\n\t\tswitch {\n\t\tcase hasC && !hasB:\n\t\t\toc.ChangeType = "added"\n\t\t\tchanged = true\n\t\tcase hasB && !hasC:\n\t\t\toc.ChangeType = "removed"\n\t\t\tchanged = true\n\t\tcase !equalStrings(bo.Fingerprints, co.Fingerprints):\n\t\t\toc.ChangeType = "fingerprint_changed"\n\t\t\tchanged = true\n\t\tcase bo.CrossPassConsistent != co.CrossPassConsistent:\n\t\t\toc.ChangeType = "consistency_changed"\n\t\t\tchanged = true\n\t\tcase !boolPtrEqual(bo.ReferenceMatch, co.ReferenceMatch):\n\t\t\toc.ChangeType = "reference_changed"\n\t\t\tchanged = true\n\t\tdefault:\n\t\t\toc.ChangeType = "unchanged"\n\t\t}\n\t\tchanges = append(changes, oc)\n\t}\n\n\treturn changes, changed\n}\n\nfunc stepEqual(b, c stepReport) bool {\n\tif b.Status != c.Status || b.ExecutionOrder != c.ExecutionOrder || b.ErrorMessage != c.ErrorMessage {\n\t\treturn false\n\t}\n\tif !equalStrings(b.TimingMs, c.TimingMs) {\n\t\treturn false\n\t}\n\tif len(b.Outputs) != len(c.Outputs) {\n\t\treturn false\n\t}\n\tfor i := range b.Outputs {\n\t\tif !outputEqual(b.Outputs[i], c.Outputs[i]) {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc outputEqual(b, c outputReport) bool {\n\tif b.Path != c.Path {\n\t\treturn false\n\t}\n\tif !equalStrings(b.Fingerprints, c.Fingerprints) {\n\t\treturn false\n\t}\n\tif b.CrossPassConsistent != c.CrossPassConsistent {\n\t\treturn false\n\t}\n\tif !boolPtrEqual(b.ReferenceMatch, c.ReferenceMatch) {\n\t\treturn false\n\t}\n\tif !stringPtrEqual(b.Reference, c.Reference) {\n\t\treturn false\n\t}\n\tif !stringPtrEqual(b.VarianceDetail, c.VarianceDetail) {\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc statusTransitionType(from, to string) string {\n\trank := func(s string) int {\n\t\tswitch s {\n\t\tcase "PASS":\n\t\t\treturn 4\n\t\tcase "FAIL":\n\t\t\treturn 3\n\t\tcase "ERROR":\n\t\t\treturn 2\n\t\tcase "TIMEOUT":\n\t\t\treturn 1\n\t\tcase "SKIPPED":\n\t\t\treturn 0\n\t\tdefault:\n\t\t\treturn -1\n\t\t}\n\t}\n\tr := rank(to) - rank(from)\n\tswitch {\n\t\tcase r < 0:\n\t\t\treturn "regression"\n\t\tcase r > 0:\n\t\t\treturn "improvement"\n\t\tdefault:\n\t\t\treturn "unchanged"\n\t}\n}\n\nfunc nilIfEmpty(s []string) []string {\n\tif len(s) == 0 {\n\t\treturn nil\n\t}\n\treturn s\n}\n\nfunc equalStrings(a, b []string) bool {\n\tif len(a) != len(b) {\n\t\treturn false\n\t}\n\tfor i := range a {\n\t\tif a[i] != b[i] {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc boolPtrEqual(a, b *bool) bool {\n\tif a == nil && b == nil {\n\t\treturn true\n\t}\n\tif a == nil || b == nil {\n\t\treturn false\n\t}\n\treturn *a == *b\n}\n\nfunc stringPtrEqual(a, b *string) bool {\n\tif a == nil && b == nil {\n\t\treturn true\n\t}\n\tif a == nil || b == nil {\n\t\treturn false\n\t}\n\treturn *a == *b\n}\n\nfunc printDiffText(d *diffReport) {\n\tfmt.Println("Verification Report Diff")\n\tfmt.Println("========================")\n\tfmt.Printf("Baseline: %s@%s (%s) at %s\\n", d.Baseline.ManifestName, d.Baseline.ManifestVersion, d.Baseline.OverallStatus, d.Baseline.Timestamp)\n\tfmt.Printf("Current:  %s@%s (%s) at %s\\n", d.Current.ManifestName, d.Current.ManifestVersion, d.Current.OverallStatus, d.Current.Timestamp)\n\tfmt.Printf("Overall:  %s → %s [%s]\\n", d.StatusTransition.From, d.StatusTransition.To, d.StatusTransition.Type)\n\tfmt.Println()\n\tfmt.Println("Step Changes:")\n\tfor _, sc := range d.StepChanges {\n\t\tswitch sc.ChangeType {\n\t\tcase "added":\n\t\t\tstatus := ""\n\t\t\tif sc.CurrentStatus != nil {\n\t\t\t\tstatus = *sc.CurrentStatus\n\t\t\t}\n\t\t\tfmt.Printf("  + %s [%s]\\n", sc.StepID, status)\n\t\tcase "removed":\n\t\t\tstatus := ""\n\t\t\tif sc.BaselineStatus != nil {\n\t\t\t\tstatus = *sc.BaselineStatus\n\t\t\t}\n\t\t\tfmt.Printf("  - %s [%s]\\n", sc.StepID, status)\n\t\tcase "modified":\n\t\t\tif sc.BaselineStatus != nil && sc.CurrentStatus != nil {\n\t\t\t\tfmt.Printf("  ~ %s [%s → %s]\\n", sc.StepID, *sc.BaselineStatus, *sc.CurrentStatus)\n\t\t\t} else {\n\t\t\t\tfmt.Printf("  ~ %s\\n", sc.StepID)\n\t\t\t}\n\t\t\tfor _, oc := range sc.OutputChanges {\n\t\t\t\tfmt.Printf("    Output: %s — %s\\n", oc.Path, oc.ChangeType)\n\t\t\t}\n\t\tcase "unchanged":\n\t\t\tfmt.Printf("  = %s\\n", sc.StepID)\n\t\t}\n\t}\n\tfmt.Println()\n\tfmt.Printf("Summary: %d added, %d removed, %d modified, %d unchanged\\n",\n\t\td.Summary.StepsAdded, d.Summary.StepsRemoved, d.Summary.StepsModified, d.Summary.StepsUnchanged)\n\tfmt.Printf("         %d regressions, %d improvements\\n",\n\t\td.Summary.Regressions, d.Summary.Improvements)\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
