duplicate policy rule id: %q", rule.ID)\n\t\t}\n\t\tseenRuleIDs[rule.ID] = true\n\n\t\tswitch rule.Action {\n\t\tcase "allow", "warn", "require":\n\t\tdefault:\n\t\t\treturn fmt.Errorf("invalid policy action: %q (must be \\"allow\\", \\"warn\\", or \\"require\\")", rule.Action)\n\t\t}\n\n\t\tswitch rule.Type {\n\t\tcase "allow_variance":\n\t\t\tif _, err := policyStringParam(rule, "output_pattern"); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\tcase "min_consistency_rate":\n\t\t\tif _, err := policyStringParam(rule, "step_pattern"); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\trate, err := policyFloatParam(rule, "rate")\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tif rate < 0.0 || rate > 1.0 {\n\t\t\t\treturn fmt.Errorf("invalid min_consistency_rate: rate must be between 0.0 and 1.0")\n\t\t\t}\n\t\tcase "required_steps":\n\t\t\tsteps, err := policyStringSliceParam(rule, "steps")\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tfor _, stepID := range steps {\n\t\t\t\tif !stepIDs[stepID] {\n\t\t\t\t\treturn fmt.Errorf("unknown step in policy rule %q: %q", rule.ID, stepID)\n\t\t\t\t}\n\t\t\t}\n\t\tcase "ignore_steps":\n\t\t\tsteps, err := policyStringSliceParam(rule, "steps")\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tfor _, stepID := range steps {\n\t\t\t\tif !stepIDs[stepID] {\n\t\t\t\t\treturn fmt.Errorf("unknown step in policy rule %q: %q", rule.ID, stepID)\n\t\t\t\t}\n\t\t\t}\n\t\tdefault:\n\t\t\treturn fmt.Errorf("unknown policy rule type: %q", rule.Type)\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc policyStringParam(rule PolicyRule, name string) (string, error) {\n\tv, ok := rule.Params[name]\n\tif !ok {\n\t\treturn "", fmt.Errorf("policy rule %q missing required param: %q", rule.ID, name)\n\t}\n\ts, ok := v.(string)\n\tif !ok {\n\t\treturn "", fmt.Errorf("policy rule %q missing required param: %q", rule.ID, name)\n\t}\n\treturn s, nil\n}\n\nfunc policyFloatParam(rule PolicyRule, name string) (float64, error) {\n\tv, ok := ru