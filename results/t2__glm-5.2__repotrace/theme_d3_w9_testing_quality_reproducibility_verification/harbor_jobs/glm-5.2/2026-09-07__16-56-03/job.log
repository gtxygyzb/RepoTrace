t.Sprintf("majority rate %.3f below required %.3f", majorityRate, rate)\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\tev.Effect = "applied"\n\t\t\t\t\t\t\tev.Details = "required majority rate satisfied"\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tsort.Strings(ev.MatchedSteps)\n\t\t\tsort.Strings(ev.MatchedOutputs)\n\t\t\truleEvals = append(ruleEvals, ev)\n\n\t\tcase "required_steps":\n\t\t\tev := policyRuleEval{\n\t\t\t\tRuleID:   rule.ID,\n\t\t\t\tRuleType: rule.Type,\n\t\t\t\tAction:   rule.Action,\n\t\t\t\tEffect:   "not_applicable",\n\t\t\t}\n\t\t\tsteps, _ := policyStringSliceParam(rule, "steps")\n\t\t\tev.MatchedSteps = append([]string{}, steps...)\n\t\t\tsort.Strings(ev.MatchedSteps)\n\t\t\tfor _, id := range steps {\n\t\t\t\tmatchedStepsAll[id] = true\n\t\t\t\tif rule.Action == "require" {\n\t\t\t\t\tmustPassSteps[id] = true\n\t\t\t\t} else if rule.Action == "allow" {\n\t\t\t\t\thasRequiredAllow = true\n\t\t\t\t\trequiredAllowListed[id] = true\n\t\t\t\t}\n\t\t\t}\n\t\t\tif rule.Action == "require" {\n\t\t\t\tev.Effect = "applied"\n\t\t\t\tev.Details = "listed steps are required to pass"\n\t\t\t} else if rule.Action == "allow" {\n\t\t\t\tev.Effect = "applied"\n\t\t\t\tev.Details = "unlisted steps are forgiven"\n\t\t\t}\n\t\t\truleEvals = append(ruleEvals, ev)\n\n\t\tcase "ignore_steps":\n\t\t\tev := policyRuleEval{\n\t\t\t\tRuleID:   rule.ID,\n\t\t\t\tRuleType: rule.Type,\n\t\t\t\tAction:   rule.Action,\n\t\t\t\tEffect:   "not_applicable",\n\t\t\t}\n\t\t\tsteps, _ := policyStringSliceParam(rule, "steps")\n\t\t\tev.MatchedSteps = append([]string{}, steps...)\n\t\t\tsort.Strings(ev.MatchedSteps)\n\t\t\tfor _, id := range steps {\n\t\t\t\tmatchedStepsAll[id] = true\n\t\t\t\tignoredSteps[id] = true\n\t\t\t}\n\t\t\tif len(steps) > 0 {\n\t\t\t\tev.Effect = "applied"\n\t\t\t\tev.Details = "steps ignored from policy evaluation"\n\t\t\t}\n\t\t\truleEvals = append(ruleEvals, ev)\n\t\t}\n\t}\n\n\teffectiveStatus := map[string]string{}\n\tfor _, sr := range rep.Steps {