Sending keys: ['cat > cmd/repro-verify/trend.go <<\'EOF\'\npackage main\n\nimport (\n\t"encoding/json"\n\t"fmt"\n\t"os"\n\t"sort"\n\t"strings"\n\t"time"\n)\n\ntype trendReportLite struct {\n\tManifestName    string       `json:"manifest_name"`\n\tManifestVersion string       `json:"manifest_version"`\n\tOverallStatus   string       `json:"overall_status"`\n\tTimestamp       string       `json:"timestamp"`\n\tSteps           []stepReport `json:"steps"`\n}\n\ntype trendStep struct {\n\tStepID           string   `json:"step_id"`\n\tStatuses         []*string `json:"statuses"`\n\tFirstSeenIndex   int      `json:"first_seen_index"`\n\tLastSeenIndex    int      `json:"last_seen_index"`\n\tStatusChanges    int      `json:"status_changes"`\n\tStability        float64  `json:"stability"`\n\tClassification   string   `json:"classification"`\n}\n\ntype trendAggregate struct {\n\tTotalStepsTracked int     `json:"total_steps_tracked"`\n\tStableCount      int     `json:"stable_count"`\n\tFlakyCount       int     `json:"flaky_count"`\n\tDegradingCount   int     `json:"degrading_count"`\n\tImprovingCount   int     `json:"improving_count"`\n\tOverallStability float64 `json:"overall_stability"`\n}\n\ntype trendOutput struct {\n\tTrendTimestamp string         `json:"trend_timestamp"`\n\tReportCount    int            `json:"report_count"`\n\tStepTrends    []trendStep    `json:"step_trends"`\n\tAggregate      trendAggregate `json:"aggregate"`\n}\n\nfunc trendCmd(args []string) {\n\tformat := "json"\n\tpositional := parseFlags(args, map[string]*string{\n\t\t"format": &format,\n\t})\n\n\tif len(positional) < 2 {\n\t\tfmt.Fprintln(os.Stderr, "error: trend requires at least two report files")\n\t\tos.Exit(2)\n\t}\n\n\treports := make([]*trendReportLite, 0, len(positional))\n\tfor _, path := range positional {\n\t\trep, err := loadTrendReport(path)\n\t\tif err != nil {\n\t\t\tfmt.Fprintln(os.Stderr, err)\n\t\t\tos.Exit(2)\n\t\t}\n\t\treports = append(reports, rep)\n\t}\n\n\toutput := buildTrendOutput(reports)\n\n\tif format == "text" {\n\t\tprintTrendText(output)\n\t} else {\n\t\tdata, err := json.MarshalIndent(output, "", "  ")\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, "error: %s\\n", err)\n\t\t\tos.Exit(2)\n\t\t}\n\t\tfmt.Println(string(data))\n\t}\n\n\tif output.Aggregate.DegradingCount > 0 || output.Aggregate.FlakyCount > 0 {\n\t\tos.Exit(1)\n\t}\n\tos.Exit(0)\n}\n\nfunc loadTrendReport(path string) (*trendReportLite, error) {\n\tif _, err := os.Stat(path); err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn nil, fmt.Errorf("error: trend file not found: %s", path)\n\t\t}\n\t\treturn nil, fmt.Errorf("error: invalid trend input: %s: %s", path, err)\n\t}\n\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf("error: invalid trend input: %s: %s", path, err)\n\t}\n\n\tvar raw map[string]json.RawMessage\n\tif err := json.Unmarshal(data, &raw); err != nil {\n\t\treturn nil, fmt.Errorf("error: invalid trend input: %s: %s", path, err)\n\t}\n\n\tfor _, field := range []string{"manifest_name", "overall_status", "steps"} {\n\t\tif _, ok := raw[field]; !ok {\n\t\t\treturn nil, fmt.Errorf("error: invalid trend input: %s: missing field %s", path, field)\n\t\t}\n\t}\n\n\tvar r trendReportLite\n\tif err := json.Unmarshal(data, &r); err != nil {\n\t\treturn nil, fmt.Errorf("error: invalid trend input: %s: %s", path, err)\n\t}\n\tif r.ManifestName == "" {\n\t\treturn nil, fmt.Errorf("error: invalid trend input: %s: missing field manifest_name", path)\n\t}\n\tif r.OverallStatus == "" {\n\t\treturn nil, fmt.Errorf("error: invalid trend input: %s: missing field overall_status", path)\n\t}\n\tif r.Steps == nil {\n\t\treturn nil, fmt.Errorf("error: invalid trend input: %s: missing field steps", path)\n\t}\n\n\treturn &r, nil\n}\n\nfunc buildTrendOutput(reports []*trendReportLite) *trendOutput {\n\treportCount := len(reports)\n\tstepIDs := make(map[string]bool)\n\treportStepStatus := make([]map[string]string, reportCount)\n\n\tfor i, rep := range reports {\n\t\tstatusByID := make(map[string]string)\n\t\tfor _, step := range rep.Steps {\n\t\t\tstatusByID[step.ID] = step.Status\n\t\t\tstepIDs[step.ID] = true\n\t\t}\n\t\treportStepStatus[i] = statusByID\n\t}\n\n\tids := make([]string, 0, len(stepIDs))\n\tfor id := range stepIDs {\n\t\tids = append(ids, id)\n\t}\n\tsort.Strings(ids)\n\n\tstepTrends := make([]trendStep, 0, len(ids))\n\tvar stableCount, flakyCount, degradingCount, improvingCount int\n\tvar stabilitySum float64\n\n\tfor _, id := range ids {\n\t\tstatuses := make([]*string, reportCount)\n\t\tappearances := 0\n\t\tfirstSeenIndex := -1\n\t\tlastSeenIndex := -1\n\t\tvar firstStatus, lastStatus string\n\n\t\tfor i, statusByID := range reportStepStatus {\n\t\t\tif status, ok := statusByID[id]; ok {\n\t\t\t\tstatusCopy := status\n\t\t\t\tstatuses[i] = &statusCopy\n\t\t\t\tappearances++\n\t\t\t\tif firstSeenIndex == -1 {\n\t\t\t\t\tfirstSeenIndex = i\n\t\t\t\t\tfirstStatus = status\n\t\t\t\t}\n\t\t\t\tlastSeenIndex = i\n\t\t\t\tlastStatus = status\n\t\t\t}\n\t\t}\n\n\t\tstatusChanges := 0\n\t\tvar prev *string\n\t\tfor _, status := range statuses {\n\t\t\tif status == nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif prev != nil && *prev != *status {\n\t\t\t\tstatusChanges++\n\t\t\t}\n\t\t\tprev = status\n\t\t}\n\n\t\tstability := 1.0\n\t\tif appearances > 1 {\n\t\t\tstability = 1.0 - float64(statusChanges)/float64(appearances-1)\n\t\t}\n\n\t\tclassification := classifyTrendStep(statusChanges, firstStatus, lastStatus)\n\t\tswitch classification {\n\t\tcase "stable":\n\t\t\tstableCount++\n\t\tcase "flaky":\n\t\t\tflakyCount++\n\t\tcase "degrading":\n\t\t\tdegradingCount++\n\t\tcase "improving":\n\t\t\timprovingCount++\n\t\t}\n\t\tstabilitySum += stability\n\n\t\tstepTrends = append(stepTrends, trendStep{\n\t\t\tStepID:         id,\n\t\t\tStatuses:       statuses,\n\t\t\tFirstSeenIndex: firstSeenIndex,\n\t\t\tLastSeenIndex:  lastSeenIndex,\n\t\t\tStatusChanges:  statusChanges,\n\t\t\tStability:      stability,\n\t\t\tClassification: classification,\n\t\t})\n\t}\n\n\toverallStability := 1.0\n\tif len(ids) > 0 {\n\t\toverallStability = stabilitySum / float64(len(ids))\n\t}\n\n\treturn &trendOutput{\n\t\tTrendTimestamp: time.Now().UTC().Format(time.RFC3339),\n\t\tReportCount:    reportCount,\n\t\tStepTrends:     stepTrends,\n\t\tAggregate: trendAggregate{\n\t\t\tTotalStepsTracked: len(ids),\n\t\t\tStableCount:      stableCount,\n\t\t\tFlakyCount:       flakyCount,\n\t\t\tDegradingCount:   degradingCount,\n\t\t\tImprovingCount:   improvingCount,\n\t\t\tOverallStability: overallStability,\n\t\t},\n\t}\n}\n\nfunc classifyTrendStep(statusChanges int, firstStatus, lastStatus string) string {\n\tif statusChanges == 0 {\n\t\treturn "stable"\n\t}\n\tif statusChanges >= 2 {\n\t\treturn "flaky"\n\t}\n\n\tfirstRank := statusRank(firstStatus)\n\tlastRank := statusRank(lastStatus)\n\tif lastRank < firstRank {\n\t\treturn "degrading"\n\t}\n\tif lastRank > firstRank {\n\t\treturn "improving"\n\t}\n\treturn "stable"\n}\n\nfunc statusRank(status string) int {\n\tswitch status {\n\tcase "PASS":\n\t\treturn 4\n\tcase "FAIL":\n\t\treturn 3\n\tcase "ERROR":\n\t\treturn 2\n\tcase "TIMEOUT":\n\t\treturn 1\n\tcase "SKIPPED":\n\t\treturn 0\n\tdefault:\n\t\treturn -1\n\t}\n}\n\nfunc printTrendText(output *trendOutput) {\n\theader := fmt.Sprintf("Trend Analysis (%d reports)", output.ReportCount)\n\tfmt.Println(header)\n\tfmt.Println(strings.Repeat("=", len(header)))\n\n\tfor _, step := range output.StepTrends {\n\t\tstatusParts := make([]string, 0, len(step.Statuses))\n\t\tfor _, status := range step.Statuses {\n\t\t\tif status == nil {\n\t\t\t\tstatusParts = append(statusParts, "-")\n\t\t\t} else {\n\t\t\t\tstatusParts = append(statusParts, *status)\n\t\t\t}\n\t\t}\n\t\tfmt.Printf("%s  %s  [%s]  stability=%.2f\\n", step.StepID, step.Classification, strings.Join(statusParts, ","), step.Stability)\n\t}\n\n\tfmt.Println("---")\n\tfmt.Printf("%d steps: %d stable, %d flaky, %d degrading, %d improving\\n",\n\t\toutput.Aggregate.TotalStepsTracked,\n\t\toutput.Aggregate.StableCount,\n\t\toutput.Aggregate.FlakyCount,\n\t\toutput.Aggregate.DegradingCount,\n\t\toutput.Aggregate.ImprovingCount)\n\tfmt.Printf("Overall stability: %.1f%%\\n", output.Aggregate.OverallStability*100)\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
