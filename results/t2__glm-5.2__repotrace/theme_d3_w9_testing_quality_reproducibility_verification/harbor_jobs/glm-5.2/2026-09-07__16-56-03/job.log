ce file not found: %s\\n", path)\n\t\t} else {\n\t\t\tfmt.Fprintf(os.Stderr, "error: invalid slice input: %s: %s\\n", path, err)\n\t\t}\n\t\tos.Exit(2)\n\t}\n\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: invalid slice input: %s: %s\\n", path, err)\n\t\tos.Exit(2)\n\t}\n\n\tvar raw map[string]json.RawMessage\n\tif err := json.Unmarshal(data, &raw); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: invalid slice input: %s: %s\\n", path, err)\n\t\tos.Exit(2)\n\t}\n\n\tfor _, field := range []string{"manifest_name", "overall_status", "steps"} {\n\t\tif _, ok := raw[field]; !ok {\n\t\t\tfmt.Fprintf(os.Stderr, "error: invalid slice input: %s: missing field %s\\n", path, field)\n\t\t\tos.Exit(2)\n\t\t}\n\t}\n\n\tvar r sliceReportLite\n\tif err := json.Unmarshal(data, &r); err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: invalid slice input: %s: %s\\n", path, err)\n\t\tos.Exit(2)\n\t}\n\tif r.ManifestName == "" {\n\t\tfmt.Fprintf(os.Stderr, "error: invalid slice input: %s: missing field manifest_name\\n", path)\n\t\tos.Exit(2)\n\t}\n\tif r.OverallStatus == "" {\n\t\tfmt.Fprintf(os.Stderr, "error: invalid slice input: %s: missing field overall_status\\n", path)\n\t\tos.Exit(2)\n\t}\n\tif r.Steps == nil {\n\t\tfmt.Fprintf(os.Stderr, "error: invalid slice input: %s: missing field steps\\n", path)\n\t\tos.Exit(2)\n\t}\n\n\tmatched := make([]sliceStepOutput, 0)\n\tfor _, step := range r.Steps {\n\t\tfor _, status := range statuses {\n\t\t\tif step.Status == status {\n\t\t\t\tmatched = append(matched, sliceStepOutput{\n\t\t\t\t\tID:     step.ID,\n\t\t\t\t\tStatus: step.Status,\n\t\t\t\t})\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\n\tout := sliceOutput{\n\t\tSourceFile:     path,\n\t\tManifestName:   r.ManifestName,\n\t\tFilterStatuses: statuses,\n\t\tTotalSteps:     len(r.Steps),\n\t\tMatchedCount:   len(matched),\n\t\tSteps:          matched,\n\t}\n\n\tencoded, err := json.MarshalIndent(out, "", "  ")\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, "error: %s\\n", err)\n\t\tos.Exit(2)\n\t}\n\tfmt.Println(string(encoded))\n\n\tif len(matched) > 0 {\n\t\tos.Exit(0)\n\t}\n\tos.Exit(1)\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
