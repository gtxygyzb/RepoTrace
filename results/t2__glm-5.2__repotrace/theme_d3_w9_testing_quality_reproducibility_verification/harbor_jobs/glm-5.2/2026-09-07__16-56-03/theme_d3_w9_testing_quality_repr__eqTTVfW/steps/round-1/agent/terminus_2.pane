   108			fmt.Fprintln(os.Stderr, "usage: repro-verify verify <manifest.json> [--steps ...] [--cache-dir ...] [--pipeline-root ...]")
   109			os.Exit(2)
   110		}
   111		manifestPath := positional[0]
   112		m, err := loadManifest(manifestPath)
   113		if err != nil {
   114			fmt.Fprintf(os.Stderr, "error: %s\n", err)
   115			os.Exit(2)
   116		}
   117		if _, err := os.Stat(pipelineRoot); err != nil {
   118			fmt.Fprintf(os.Stderr, "error: pipeline root not found: %s\n", pipelineRoot)
   119			os.Exit(2)
   120		}
   121		targetedSteps := []string{}
   122		if stepsFlag != "" {
   123			for _, s := range strings.Split(stepsFlag, ",") {
   124				s = strings.TrimSpace(s)
   125				if s != "" {
   126					targetedSteps = append(targetedSteps, s)
   127				}
   128			}
   129		}
   130		if m.Verify.Mode == "targeted" && len(targetedSteps) == 0 {
   131			fmt.Fprintln(os.Stderr, "error: targeted mode requires --steps")
   132			os.Exit(2)
   133		}
   134		stepByID := map[string]Step{}
   135		for _, s := range m.Steps {
   136			stepByID[s.ID] = s
   137		}
   138		for _, t := range targetedSteps {
   139			if _, ok := stepByID[t]; !ok {
   140				fmt.Fprintf(os.Stderr, "error: unknown target step: %q\n", t)
   141				os.Exit(2)
   142			}
   143		}
   144		topOrder := topologicalOrder(m.Steps)
   145		topoIndex := map[string]int{}
   146		for i, id := range topOrder {
   147			topoIndex[id] = i + 1
   148		}
   149		trans := transitiveDeps(m.Steps)
   150		required := map[string]bool{}
   151		targetSet := map[string]bool{}
   152		switch m.Verify.Mode {
   153		case "targeted":
   154			for _, t := range targetedSteps {
   155				targetSet[t] = true
   156				required[t] = true
   157				for _, d := range trans[t] {
   158					required[d] = true
   159				}
   160			}
   161		default:
