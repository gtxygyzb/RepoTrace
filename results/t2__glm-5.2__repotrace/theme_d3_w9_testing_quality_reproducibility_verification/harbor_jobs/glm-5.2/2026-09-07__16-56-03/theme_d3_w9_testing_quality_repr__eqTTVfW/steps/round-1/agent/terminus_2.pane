   141	
   142	func policyStringSliceParam(rule PolicyRule, name string) ([]string, error) {
   143	v, ok := rule.Params[name]
   144	if !ok {
   145	return nil, fmt.Errorf("policy rule %q missing required param: %q", rule.ID, name)
   146	}
   147	arr, ok := v.([]interface{})
   148	if !ok {
   149	return nil, fmt.Errorf("policy rule %q missing required param: %q", rule.ID, name)
   150	}
   151	out := make([]string, 0, len(arr))
   152	for _, item := range arr {
   153	s, ok := item.(string)
   154	if !ok {
   155	return nil, fmt.Errorf("policy rule %q missing required param: %q", rule.ID, name)
   156	}
   157	out = append(out, s)
   158	}
   159	return out, nil
   160	}
