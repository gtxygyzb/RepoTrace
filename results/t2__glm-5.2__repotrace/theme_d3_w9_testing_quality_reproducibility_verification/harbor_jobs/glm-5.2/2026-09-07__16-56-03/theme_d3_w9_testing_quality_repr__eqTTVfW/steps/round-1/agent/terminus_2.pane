    39		Reports          []summaryReportEntry `json:"reports"`
    40		Aggregate        summaryAggregate     `json:"aggregate"`
    41	}
    42	
    43	func summaryCmd(args []string) {
    44		if len(args) == 0 {
    45			fmt.Fprintln(os.Stderr, "error: summary requires at least one report file")
    46			os.Exit(2)
    47		}
    48	
    49		format := "json"
    50		positional := []string{}
    51		for i := 0; i < len(args); i++ {
    52			switch args[i] {
    53			case "--format":
    54				i++
    55				if i >= len(args) {
    56					fmt.Fprintln(os.Stderr, "error: --format requires an argument")
    57					os.Exit(2)
    58				}
    59				format = args[i]
    60				if format != "json" && format != "text" {
    61					fmt.Fprintf(os.Stderr, "error: invalid format %q\n", format)
    62					os.Exit(2)
    63				}
    64			case "--format=json":
    65				format = "json"
    66			case "--format=text":
    67				format = "text"
    68			default:
    69				if len(args[i]) > 0 && args[i][0] == '-' {
    70					fmt.Fprintf(os.Stderr, "error: unknown flag %q\n", args[i])
    71					os.Exit(2)
    72				}
    73				positional = append(positional, args[i])
    74			}
    75		}
    76	
    77		if len(positional) == 0 {
    78			fmt.Fprintln(os.Stderr, "error: summary requires at least one report file")
    79			os.Exit(2)
    80		}
    81	
    82		entries := make([]summaryReportEntry, 0, len(positional))
    83		aggregate := summaryAggregate{}
    84		allPassing := true
    85	
    86		for _, path := range positional {
    87			if _, err := os.Stat(path); err != nil {
    88				if os.IsNotExist(err) {
    89					fmt.Fprintf(os.Stderr, "error: summary file not found: %s\n", path)
    90				} else {
    91					fmt.Fprintf(os.Stderr, "error: invalid summary input: %s: %s\n", path, err)
    92				}
    93				os.Exit(2)
    94			}
    95	
    96			data, err := os.ReadFile(path)
    97			if err != nil {
    98				fmt.Fprintf(os.Stderr, "error: invalid summary input: %s: %s\n", path, err)
    99				os.Exit(2)
   100			}
   101	
   102			var rep summaryReportInput
   103			if err := json.Unmarshal(data, &rep); err != nil {
   104				fmt.Fprintf(os.Stderr, "error: invalid summary input: %s: %s\n", path, err)
   105				os.Exit(2)
   106			}
   107	
   108			if rep.ManifestName == "" {
   109				fmt.Fprintf(os.Stderr, "error: invalid summary input: %s: missing field manifest_name\n", path)
   110				os.Exit(2)
   111			}
   112			if rep.OverallStatus == "" {
   113				fmt.Fprintf(os.Stderr, "error: invalid summary input: %s: missing field overall_status\n", path)
   114				os.Exit(2)
   115			}
   116			if rep.Steps == nil {
   117				fmt.Fprintf(os.Stderr, "error: invalid summary input: %s: missing field steps\n", path)
   118				os.Exit(2)
   119			}
   120	
   121			stepCount := len(rep.Steps)
   122			passCount := 0
   123			for _, sr := range rep.Steps {
   124				if sr.Status == "PASS" {
   125					passCount++
   126				}
   127			}
   128			failCount := stepCount - passCount
   129			passRate := 1.0
   130			if stepCount != 0 {
   131				passRate = float64(passCount) / float64(stepCount)
   132			}
   133	
   134			entries = append(entries, summaryReportEntry{
   135				File:            path,
   136				ManifestName:    rep.ManifestName,
   137				ManifestVersion: rep.ManifestVersion,
   138				OverallStatus:   rep.OverallStatus,
   139				StepCount:       stepCount,
   140				PassCount:       passCount,
   141				FailCount:       failCount,
   142				PassRate:        passRate,
   143			})
   144	
   145			aggregate.TotalReports++
   146			aggregate.TotalSteps += stepCount
   147			aggregate.TotalPass += passCount
   148			aggregate.TotalFail += failCount
   149			if rep.OverallStatus != "PASS" {
   150				allPassing = false
   151			}
   152		}
   153	
   154		aggregate.OverallPassRate = 1.0
   155		if aggregate.TotalSteps != 0 {
   156			aggregate.OverallPassRate = float64(aggregate.TotalPass) / float64(aggregate.TotalSteps)
   157		}
   158		aggregate.AllPassing = allPassing
   159	
   160		out := summaryOutput{
   161			SummaryTimestamp: time.Now().UTC().Format(time.RFC3339),
   162			Reports:          entries,
   163			Aggregate:        aggregate,
   164		}
   165	
   166		if format == "text" {
   167			for _, r := range out.Reports {
   168				fmt.Printf("%s@%s  %s  %d/%d steps  (%.1f%%)\n", r.ManifestName, r.ManifestVersion, r.OverallStatus, r.PassCount, r.StepCount, r.PassRate*100)
   169			}
   170			fmt.Println("---")
   171			fmt.Printf("%d reports, %d total steps, %.1f%% pass rate\n", aggregate.TotalReports, aggregate.TotalSteps, aggregate.OverallPassRate*100)
   172		} else {
   173			data, err := json.MarshalIndent(out, "", "  ")
   174			if err != nil {
   175				fmt.Fprintf(os.Stderr, "error: %s\n", err)
   176				os.Exit(2)
   177			}
   178			fmt.Println(string(data))
   179		}
   180	
