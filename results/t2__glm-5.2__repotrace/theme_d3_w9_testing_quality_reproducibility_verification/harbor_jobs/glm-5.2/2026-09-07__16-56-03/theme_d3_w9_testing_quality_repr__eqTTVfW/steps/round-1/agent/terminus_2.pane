[?2004l     1	package main
     2	
     3	import (
     4	"fmt"
     5	"path/filepath"
     6	"regexp"
     7	"sort"
     8	"strings"
     9	)
    10	
    11	type Policy struct {
    12	DefaultAction string       `json:"default_action"`
    13	Rules         []PolicyRule `json:"rules"`
    14	}
    15	
    16	type PolicyRule struct {
    17	ID     string                 `json:"id"`
    18	Type   string                 `json:"type"`
    19	Params map[string]interface{} `json:"params"`
    20	Action string                 `json:"action"`
    21	}
    22	
    23	type policyEvaluation struct {
    24	PolicyOverallStatus   string            `json:"policy_overall_status"`
    25	DefaultAction         string            `json:"default_action"`
    26	RulesEvaluated        []policyRuleEval  `json:"rules_evaluated"`
    27	EffectiveStepStatuses map[string]string `json:"effective_step_statuses"`
    28	Warnings              []string          `json:"warnings"`
    29	}
    30	
    31	type policyRuleEval struct {
    32	RuleID        string   `json:"rule_id"`
    33	RuleType      string   `json:"rule_type"`
    34	MatchedSteps  []string `json:"matched_steps"`
    35	MatchedOutputs []string `json:"matched_outputs"`
    36	Action        string   `json:"action"`
    37	Effect        string   `json:"effect"`
    38	Details       string   `json:"details"`
    39	}
    40	
    41	var policyRuleIDRe = regexp.MustCompile(`^[a-z][a-z0-9_-]{0,63}$`)
    42	
    43	func validatePolicy(p *Policy, stepIDs map[string]bool) error {
    44	if p == nil {
    45	return nil
    46	}
    47	if p.DefaultAction == "" {
    48	p.DefaultAction = "strict"
    49	}
    50	switch p.DefaultAction {
    51	case "strict", "lenient":
    52	default:
    53	return fmt.Errorf("invalid default_action: %q (must be \"strict\" or \"lenient\")", p.DefaultAction)
    54	}
    55	if p.Rules == nil {
    56	p.Rules = []PolicyRule{}
    57	}
    58	
    59	seenRuleIDs := map[string]bool{}
    60	for _, rule := range p.Rules {
    61	if !policyRuleIDRe.MatchString(rule.ID) {
    62	return fmt.Errorf("invalid policy rule id: %q (must match ^[a-z][a-z0-9_-]{0,63}$)", rule.ID)
    63	}
    64	if seenRuleIDs[rule.ID] {
    65	return fmt.Errorf("duplicate policy rule id: %q", rule.ID)
    66	}
    67	seenRuleIDs[rule.ID] = true
    68	
    69	switch rule.Action {
    70	case "allow", "warn", "require":
    71	default:
    72	return fmt.Errorf("invalid policy action: %q (must be \"allow\", \"warn\", or \"require\")", rule.Action)
    73	}
    74	
    75	switch rule.Type {
    76	case "allow_variance":
    77	if _, err := policyStringParam(rule, "output_pattern"); err != nil {
    78	return err
    79	}
    80	case "min_consistency_rate":
    81	if _, err := policyStringParam(rule, "step_pattern"); err != nil {
    82	return err
    83	}
    84	rate, err := policyFloatParam(rule, "rate")
    85	if err != nil {
    86	return err
    87	}
    88	if rate < 0.0 || rate > 1.0 {
    89	return fmt.Errorf("invalid min_consistency_rate: rate must be between 0.0 and 1.0")
    90	}
    91	case "required_steps":
    92	steps, err := policyStringSliceParam(rule, "steps")
    93	if err != nil {
    94	return err
    95	}
    96	for _, stepID := range steps {
    97	if !stepIDs[stepID] {
    98	return fmt.Errorf("unknown step in policy rule %q: %q", rule.ID, stepID)
    99	}
   100	}
   101	case "ignore_steps":
   102	steps, err := policyStringSliceParam(rule, "steps")
   103	if err != nil {
   104	return err
   105	}
   106	for _, stepID := range steps {
   107	if !stepIDs[stepID] {
   108	return fmt.Errorf("unknown step in policy rule %q: %q", rule.ID, stepID)
   109	}
   110	}
   111	default:
   112	return fmt.Errorf("unknown policy rule type: %q", rule.Type)
   113	}
   114	}
   115	return nil
   116	}
