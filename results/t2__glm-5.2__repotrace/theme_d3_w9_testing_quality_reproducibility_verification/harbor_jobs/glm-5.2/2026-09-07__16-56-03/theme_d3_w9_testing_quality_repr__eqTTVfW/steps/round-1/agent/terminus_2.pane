    97	func verifyCmd(args []string) {
    98		stepsFlag := ""
    99		cacheDir := ""
   100		pipelineRoot := "."
   101		positional := parseFlags(args, map[string]*string{
   102			"steps":         &stepsFlag,
   103			"cache-dir":     &cacheDir,
   104			"pipeline-root": &pipelineRoot,
   105		})
   106		if len(positional) < 1 {
   107			fmt.Fprintln(os.Stderr, "usage: repro-verify verify <manifest.json> [--steps ...] [--cache-dir ...] [--pipeline-root ...]")
   108			os.Exit(2)
   109		}
   110		manifestPath := positional[0]
   111		m, err := loadManifest(manifestPath)
   112		if err != nil {
   113			fmt.Fprintf(os.Stderr, "error: %s\n", err)
   114			os.Exit(2)
   115		}
   116		if _, err := os.Stat(pipelineRoot); err != nil {
   117			fmt.Fprintf(os.Stderr, "error: pipeline root not found: %s\n", pipelineRoot)
   118			os.Exit(2)
   119		}
   120		targetedSteps := []string{}
   121		if stepsFlag != "" {
   122			for _, s := range strings.Split(stepsFlag, ",") {
   123				s = strings.TrimSpace(s)
   124				if s != "" {
   125					targetedSteps = append(targetedSteps, s)
   126				}
   127			}
   128		}
   129		if m.Verify.Mode == "targeted" && len(targetedSteps) == 0 {
   130			fmt.Fprintln(os.Stderr, "error: targeted mode requires --steps")
   131			os.Exit(2)
   132		}
   133		stepByID := map[string]Step{}
   134		for _, s := range m.Steps {
   135			stepByID[s.ID] = s
   136		}
   137		for _, t := range targetedSteps {
   138			if _, ok := stepByID[t]; !ok {
   139				fmt.Fprintf(os.Stderr, "error: unknown target step: %q\n", t)
   140				os.Exit(2)
   141			}
   142		}
   143		topOrder := topologicalOrder(m.Steps)
   144		topoIndex := map[string]int{}
   145		for i, id := range topOrder {
   146			topoIndex[id] = i + 1
   147		}
   148		trans := transitiveDeps(m.Steps)
   149		required := map[string]bool{}
   150		targetSet := map[string]bool{}
   151		switch m.Verify.Mode {
   152		case "targeted":
   153			for _, t := range targetedSteps {
   154				targetSet[t] = true
   155				required[t] = true
   156				for _, d := range trans[t] {
   157					required[d] = true
   158				}
   159			}
   160		default:
   161			for _, s := range m.Steps {
   162				required[s.ID] = true
   163				targetSet[s.ID] = true
   164			}
   165		}
   166		passes := make([]*passResult, 0, m.Verify.Passes)
   167		reexecuted := map[string]bool{}
   168		for p := 1; p <= m.Verify.Passes; p++ {
   169			root, err := os.MkdirTemp("", "repro-verify-")
   170			if err != nil {
   171				fmt.Fprintf(os.Stderr, "error: %s\n", err)
   172				os.Exit(2)
   173			}
   174			if err := copyInputs(m, pipelineRoot, root, required); err != nil {
   175				fmt.Fprintf(os.Stderr, "error: %s\n", err)
   176				os.RemoveAll(root)
   177				os.Exit(2)
   178			}
   179			pr := &passResult{
   180				root:    root,
