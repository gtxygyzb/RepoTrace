   366	
   367	func copyInputs(m *Manifest, src, dst string, required map[string]bool) error {
   368		for _, s := range m.Steps {
   369			if !required[s.ID] {
   370				continue
   371			}
   372			for _, in := range s.Inputs {
   373				p := normalizePath(in)
   374				if p == "" {
   375					continue
   376				}
   377				srcPath := filepath.Join(src, p)
   378				dstPath := filepath.Join(dst, p)
   379				info, err := os.Stat(srcPath)
   380				if err != nil {
   381					continue
   382				}
   383				if err := os.MkdirAll(filepath.Dir(dstPath), 0755); err != nil {
   384					return err
   385				}
   386				if info.IsDir() {
   387					if err := copyDir(srcPath, dstPath); err != nil {
   388						return err
   389					}
   390				} else {
   391					if err := copyFile(srcPath, dstPath); err != nil {
   392						return err
   393					}
   394				}
   395			}
   396		}
   397		return nil
   398	}
   399	
   400	func copyDir(src, dst string) error {
   401		if err := os.MkdirAll(dst, 0755); err != nil {
   402			return err
   403		}
   404		entries, err := os.ReadDir(src)
   405		if err != nil {
   406			return err
   407		}
   408		for _, e := range entries {
   409			srcPath := filepath.Join(src, e.Name())
   410			dstPath := filepath.Join(dst, e.Name())
   411			if e.IsDir() {
   412				if err := copyDir(srcPath, dstPath); err != nil {
   413					return err
   414				}
   415			} else {
   416				if err := copyFile(srcPath, dstPath); err != nil {
   417					return err
   418				}
   419			}
   420		}
   421		return nil
   422	}
   423	
   424	func copyFile(src, dst string) error {
   425		in, err := os.Open(src)
   426		if err != nil {
   427			return err
   428		}
   429		defer in.Close()
   430		out, err := os.Create(dst)
   431		if err != nil {
   432			return err
   433		}
   434		defer out.Close()
   435		if _, err := ioCopy(in, out); err != nil {
   436			return err
   437		}
   438		return out.Sync()
   439	}
   440	
   441	func ioCopy(in *os.File, out *os.File) (int64, error) {
   442		buf := make([]byte, 32*1024)
   443		var written int64
   444		for {
   445			n, err := in.Read(buf)
   446			if n > 0 {
   447				if _, werr := out.Write(buf[:n]); werr != nil {
   448					return written, werr
   449				}
   450				written += int64(n)
   451			}
   452			if err == io.EOF {
   453				break
   454			}
   455			if err != nil {
   456				return written, err
   457			}
   458		}
   459		return written, nil
   460	}
