    44	EnvVars              map[string]string `json:"env_vars"`
    45	BlockedEnvVars       []string          `json:"blocked_env_vars"`
    46	NormalizePaths       bool              `json:"normalize_paths"`
    47	NormalizeTimestamps  bool              `json:"normalize_timestamps"`
    48	}
