   226							continue
   227						}
   228						matched, err := filepath.Match(pattern, o.Path)
   229						if err != nil || !matched {
   230							continue
   231						}
   232						matchedStepsAll[sr.ID] = true
   233						ev.MatchedSteps = appendUnique(ev.MatchedSteps, sr.ID)
   234						ev.MatchedOutputs = appendUnique(ev.MatchedOutputs, o.Path)
   235						st.matched = true
   236	
   237						switch rule.Action {
   238						case "allow":
   239							if st.bad {
   240								st.effective = true
   241								ev.Effect = "applied"
   242								ev.Details = "allowed variance for matched outputs"
   243							}
   244						case "warn":
   245							if st.bad {
   246								warnings = append(warnings, fmt.Sprintf("rule %s: variance allowed with warning for %s:%s", rule.ID, sr.ID, o.Path))
   247								ev.Effect = "applied"
   248								ev.Details = "warned about variance for matched outputs"
   249							}
   250						case "require":
   251							if !st.bad {
   252								requireViolation = true
   253								ev.Effect = "violation"
   254								ev.Details = "output is consistent but rule requires variance"
   255							} else {
   256								ev.Effect = "applied"
   257								ev.Details = "required variance present for matched outputs"
   258							}
   259						}
   260					}
   261				}
   262				sort.Strings(ev.MatchedSteps)
   263				sort.Strings(ev.MatchedOutputs)
   264				ruleEvals = append(ruleEvals, ev)
   265	
   266			case "min_consistency_rate":
   267				ev := policyRuleEval{
   268					RuleID:   rule.ID,
   269					RuleType: rule.Type,
   270					Action:   rule.Action,
   271					Effect:   "not_applicable",
   272				}
   273				rate, _ := policyFloatParam(rule, "rate")
   274				stepPattern, _ := policyStringParam(rule, "step_pattern")
   275				for _, sr := range rep.Steps {
