    75	func diffCmd(args []string) {
    76		format := "json"
    77		positional := parseFlags(args, map[string]*string{
    78			"format": &format,
    79		})
    80		if len(positional) != 2 {
    81			fmt.Fprintln(os.Stderr, "usage: repro-verify diff <baseline.json> <current.json> [--format json|text]")
    82			os.Exit(2)
    83		}
    84	
    85		baseline, err := loadDiffReport(positional[0], "baseline")
    86		if err != nil {
    87			fmt.Fprintln(os.Stderr, err)
    88			os.Exit(2)
    89		}
    90		current, err := loadDiffReport(positional[1], "current")
    91		if err != nil {
    92			fmt.Fprintln(os.Stderr, err)
    93			os.Exit(2)
    94		}
    95	
    96		diff := buildDiffReport(baseline, current)
    97	
    98		if format == "text" {
    99			printDiffText(diff)
   100		} else {
   101			out, err := json.MarshalIndent(diff, "", "  ")
   102			if err != nil {
   103				fmt.Fprintf(os.Stderr, "error: %s\n", err)
   104				os.Exit(2)
   105			}
   106			fmt.Println(string(out))
   107		}
   108	
   109		if diff.Summary.Regressions > 0 {
   110			os.Exit(1)
   111		}
   112		os.Exit(0)
   113	}
   114	
   115	func loadDiffReport(path, role string) (*diffReportLite, error) {
   116		if _, err := os.Stat(path); err != nil {
   117			if os.IsNotExist(err) {
   118				return nil, fmt.Errorf("error: diff %s not found: %s", role, path)
   119			}
   120			return nil, fmt.Errorf("error: invalid report: %s: %s", path, err)
   121		}
   122		data, err := os.ReadFile(path)
   123		if err != nil {
   124			return nil, fmt.Errorf("error: invalid report: %s: %s", path, err)
   125		}
   126		var raw map[string]json.RawMessage
   127		if err := json.Unmarshal(data, &raw); err != nil {
   128			return nil, fmt.Errorf("error: invalid report: %s: %s", path, err)
   129		}
   130		for _, field := range []string{"manifest_name", "overall_status", "steps"} {
   131			if _, ok := raw[field]; !ok {
   132				return nil, fmt.Errorf("error: invalid report: %s: missing field %s", path, field)
   133			}
   134		}
   135		var r diffReportLite
   136		if err := json.Unmarshal(data, &r); err != nil {
   137			return nil, fmt.Errorf("error: invalid report: %s: %s", path, err)
   138		}
   139		if r.ManifestName == "" {
   140			return nil, fmt.Errorf("error: invalid report: %s: missing field manifest_name", path)
   141		}
   142		if r.OverallStatus == "" {
   143			return nil, fmt.Errorf("error: invalid report: %s: missing field overall_status", path)
   144		}
   145		if r.Steps == nil {
   146			r.Steps = []stepReport{}
   147		}
   148		return &r, nil
   149	}
   150	
   151	func buildDiffReport(baseline, current *diffReportLite) *diffReport {
   152		baselineSteps := map[string]stepReport{}
   153		for _, s := range baseline.Steps {
   154			baselineSteps[s.ID] = s
   155		}
   156		currentSteps := map[string]stepReport{}
   157		for _, s := range current.Steps {
   158			currentSteps[s.ID] = s
   159		}
   160	
   161		stepIDs := map[string]bool{}
   162		for id := range baselineSteps {
   163			stepIDs[id] = true
   164		}
   165		for id := range currentSteps {
   166			stepIDs[id] = true
   167		}
   168	
   169		ids := make([]string, 0, len(stepIDs))
   170		for id := range stepIDs {
   171			ids = append(ids, id)
   172		}
   173		sort.Strings(ids)
   174	
   175		changes := make([]diffStepChange, 0, len(ids))
   176		summary := diffSummary{}
   177	
   178		for _, id := range ids {
   179			b, hasB := baselineSteps[id]
   180			c, hasC := currentSteps[id]
   181	
   182			change := diffStepChange{
   183				StepID: id,
   184			}
   185			if hasB {
   186				bs := b.Status
   187				change.BaselineStatus = &bs
   188			}
   189			if hasC {
   190				cs := c.Status
   191				change.CurrentStatus = &cs
   192			}
   193	
   194			switch {
   195			case hasC && !hasB:
   196				change.ChangeType = "added"
   197				summary.StepsAdded++
   198				summary.TotalOutputChanges += len(c.Outputs)
   199			case hasB && !hasC:
   200				change.ChangeType = "removed"
   201				summary.StepsRemoved++
   202				summary.TotalOutputChanges += len(b.Outputs)
   203			default:
   204				outputChanges, outputChanged := diffStepOutputs(b, c)
   205				change.OutputChanges = outputChanges
   206				if outputChanged || !stepEqual(b, c) {
   207					change.ChangeType = "modified"
   208					summary.StepsModified++
   209				} else {
   210					change.ChangeType = "unchanged"
   211					summary.StepsUnchanged++
   212					change.OutputChanges = []diffOutputChange{}
   213				}
   214				for _, oc := range outputChanges {
   215					if oc.ChangeType != "unchanged" {
   216						summary.TotalOutputChanges++
   217					}
   218				}
   219			}
   220	
   221			if hasB && hasC {
   222				tr := statusTransitionType(b.Status, c.Status)
   223				change.StatusTransition = &tr
   224				if tr == "regression" {
   225					summary.Regressions++
   226				} else if tr == "improvement" {
   227					summary.Improvements++
   228				}
   229			}
   230	
   231			changes = append(changes, change)
   232		}
   233	
   234		return &diffReport{
   235			Baseline: diffReportMeta{
   236				ManifestName:    baseline.ManifestName,
   237				ManifestVersion: baseline.ManifestVersion,
   238				OverallStatus:   baseline.OverallStatus,
   239				Timestamp:       baseline.Timestamp,
   240			},
   241			Current: diffReportMeta{
   242				ManifestName:    current.ManifestName,
   243				ManifestVersion: current.ManifestVersion,
   244				OverallStatus:   current.OverallStatus,
   245				Timestamp:       current.Timestamp,
   246			},
   247			ComparisonTimestamp: time.Now().UTC().Format(time.RFC3339),
   248			StatusTransition: diffStatusTransition{
   249				From: baseline.OverallStatus,
   250				To:   current.OverallStatus,
   251				Type: statusTransitionType(baseline.OverallStatus, current.OverallStatus),
   252			},
   253			StepChanges: changes,
   254			Summary:     summary,
   255		}
   256	}
   257	
   258	func diffStepOutputs(b, c stepReport) ([]diffOutputChange, bool) {
   259		bOutputs := map[string]outputReport{}
   260		for _, o := range b.Outputs {
