		}
		fmt.Println("---")
		fmt.Printf("%d reports, %d total steps, %.1f%% pass rate\n", aggregate.TotalReports, aggregate.TotalSteps, aggregate.OverallPassRate*100)
	} else {
		data, err := json.MarshalIndent(out, "", "  ")
		if err != nil {
			fmt.Fprintf(os.Stderr, "error: %s\n", err)
			os.Exit(2)
		}
		fmt.Println(string(data))
	}

	if allPassing {
		os.Exit(0)
	}
	os.Exit(1)
}
