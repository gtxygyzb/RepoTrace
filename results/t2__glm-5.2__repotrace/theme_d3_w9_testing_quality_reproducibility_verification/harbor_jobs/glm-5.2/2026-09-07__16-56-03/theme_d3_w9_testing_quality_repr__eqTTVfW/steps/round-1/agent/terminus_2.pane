    75	func diffCmd(args []string) {
    76		format := "json"
    77		positional := parseFlags(args, map[string]*string{
    78			"format": &format,
    79		})
    80		if len(positional) != 2 {
    81			fmt.Fprintln(os.Stderr, "usage: repro-verify diff <baseline.json> <current.json> [--format json|text]")
    82			os.Exit(2)
    83		}
    84	
    85		baseline, err := loadDiffReport(positional[0], "baseline")
    86		if err != nil {
    87			fmt.Fprintln(os.Stderr, err)
    88			os.Exit(2)
    89		}
    90		current, err := loadDiffReport(positional[1], "current")
    91		if err != nil {
    92			fmt.Fprintln(os.Stderr, err)
    93			os.Exit(2)
    94		}
    95	
    96		diff := buildDiffReport(baseline, current)
    97	
    98		if format == "text" {
    99			printDiffText(diff)
   100		} else {
   101			out, err := json.MarshalIndent(diff, "", "  ")
   102			if err != nil {
   103				fmt.Fprintf(os.Stderr, "error: %s\n", err)
   104				os.Exit(2)
   105			}
   106			fmt.Println(string(out))
   107		}
   108	
   109		if diff.Summary.Regressions > 0 {
   110			os.Exit(1)
   111		}
   112		os.Exit(0)
   113	}
   114	
   115	func loadDiffReport(path, role string) (*diffReportLite, error) {
   116		if _, err := os.Stat(path); err != nil {
   117			if os.IsNotExist(err) {
   118				return nil, fmt.Errorf("error: diff %s not found: %s", role, path)
   119			}
   120			return nil, fmt.Errorf("error: invalid report: %s: %s", path, err)
   121		}
   122		data, err := os.ReadFile(path)
   123		if err != nil {
   124			return nil, fmt.Errorf("error: invalid report: %s: %s", path, err)
   125		}
   126		var raw map[string]json.RawMessage
   127		if err := json.Unmarshal(data, &raw); err != nil {
   128			return nil, fmt.Errorf("error: invalid report: %s: %s", path, err)
   129		}
   130		for _, field := range []string{"manifest_name", "overall_status", "steps"} {
   131			if _, ok := raw[field]; !ok {
   132				return nil, fmt.Errorf("error: invalid report: %s: missing field %s", path, field)
   133			}
   134		}
   135		var r diffReportLite
   136		if err := json.Unmarshal(data, &r); err != nil {
   137			return nil, fmt.Errorf("error: invalid report: %s: %s", path, err)
   138		}
   139		if r.ManifestName == "" {
   140			return nil, fmt.Errorf("error: invalid report: %s: missing field manifest_name", path)
