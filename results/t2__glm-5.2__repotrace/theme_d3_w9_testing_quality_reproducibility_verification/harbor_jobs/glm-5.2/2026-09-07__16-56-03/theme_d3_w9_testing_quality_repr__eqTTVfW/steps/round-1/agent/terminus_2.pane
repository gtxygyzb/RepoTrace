    26		EffectiveStepStatuses map[string]string `json:"effective_step_statuses"`
    27		Warnings              []string          `json:"warnings"`
    28	}
    29	
    30	type policyRuleEval struct {
    31		RuleID         string   `json:"rule_id"`
    32		RuleType       string   `json:"rule_type"`
    33		MatchedSteps   []string `json:"matched_steps"`
    34		MatchedOutputs []string `json:"matched_outputs"`
    35		Action         string   `json:"action"`
    36		Effect         string   `json:"effect"`
    37		Details        string   `json:"details"`
    38	}
    39	
    40	var policyRuleIDRe = regexp.MustCompile(`^[a-z][a-z0-9_-]{0,63}$`)
    41	
    42	func validatePolicy(p *Policy, stepIDs map[string]bool) error {
    43		if p == nil {
    44			return nil
    45		}
    46		if p.DefaultAction == "" {
    47			p.DefaultAction = "strict"
    48		}
    49		switch p.DefaultAction {
    50		case "strict", "lenient":
    51		default:
    52			return fmt.Errorf("invalid default_action: %q (must be \"strict\" or \"lenient\")", p.DefaultAction)
    53		}
    54		if p.Rules == nil {
    55			p.Rules = []PolicyRule{}
    56		}
    57	
    58		seenRuleIDs := map[string]bool{}
    59		for _, rule := range p.Rules {
    60			if !policyRuleIDRe.MatchString(rule.ID) {
    61				return fmt.Errorf("invalid policy rule id: %q (must match ^[a-z][a-z0-9_-]{0,63}$)", rule.ID)
    62			}
    63			if seenRuleIDs[rule.ID] {
    64				return fmt.Errorf("duplicate policy rule id: %q", rule.ID)
    65			}
    66			seenRuleIDs[rule.ID] = true
    67	
    68			switch rule.Action {
    69			case "allow", "warn", "require":
    70			default:
    71				return fmt.Errorf("invalid policy action: %q (must be \"allow\", \"warn\", or \"require\")", rule.Action)
    72			}
    73	
    74			switch rule.Type {
    75			case "allow_variance":
    76				if _, err := policyStringParam(rule, "output_pattern"); err != nil {
    77					return err
    78				}
    79			case "min_consistency_rate":
    80				if _, err := policyStringParam(rule, "step_pattern"); err != nil {
    81					return err
    82				}
    83				rate, err := policyFloatParam(rule, "rate")
    84				if err != nil {
    85					return err
    86				}
    87				if rate < 0.0 || rate > 1.0 {
    88					return fmt.Errorf("invalid min_consistency_rate: rate must be between 0.0 and 1.0")
    89				}
    90			case "required_steps":
    91				steps, err := policyStringSliceParam(rule, "steps")
    92				if err != nil {
    93					return err
    94				}
    95				for _, stepID := range steps {
    96					if !stepIDs[stepID] {
    97						return fmt.Errorf("unknown step in policy rule %q: %q", rule.ID, stepID)
    98					}
    99				}
   100			case "ignore_steps":
   101				steps, err := policyStringSliceParam(rule, "steps")
   102				if err != nil {
   103					return err
   104				}
   105				for _, stepID := range steps {
   106					if !stepIDs[stepID] {
   107						return fmt.Errorf("unknown step in policy rule %q: %q", rule.ID, stepID)
   108					}
   109				}
   110			default:
   111				return fmt.Errorf("unknown policy rule type: %q", rule.Type)
   112			}
   113		}
   114		return nil
   115	}
   116	
   117	func policyStringParam(rule PolicyRule, name string) (string, error) {
   118		v, ok := rule.Params[name]
   119		if !ok {
   120			return "", fmt.Errorf("policy rule %q missing required param: %q", rule.ID, name)
   121		}
   122		s, ok := v.(string)
   123		if !ok {
   124			return "", fmt.Errorf("policy rule %q missing required param: %q", rule.ID, name)
   125		}
   126		return s, nil
   127	}
   128	
   129	func policyFloatParam(rule PolicyRule, name string) (float64, error) {
   130		v, ok := rule.Params[name]
   131		if !ok {
   132			return 0, fmt.Errorf("policy rule %q missing required param: %q", rule.ID, name)
   133		}
   134		f, ok := v.(float64)
   135		if !ok {
   136			return 0, fmt.Errorf("policy rule %q missing required param: %q", rule.ID, name)
   137		}
   138		return f, nil
   139	}
   140	
   141	func policyStringSliceParam(rule PolicyRule, name string) ([]string, error) {
   142		v, ok := rule.Params[name]
   143		if !ok {
   144			return nil, fmt.Errorf("policy rule %q missing required param: %q", rule.ID, name)
   145		}
   146		arr, ok := v.([]interface{})
   147		if !ok {
   148			return nil, fmt.Errorf("policy rule %q missing required param: %q", rule.ID, name)
   149		}
   150		out := make([]string, 0, len(arr))
   151		for _, item := range arr {
   152			s, ok := item.(string)
   153			if !ok {
   154				return nil, fmt.Errorf("policy rule %q missing required param: %q", rule.ID, name)
   155			}
   156			out = append(out, s)
   157		}
   158		return out, nil
   159	}
