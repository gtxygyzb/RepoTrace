		case "PASS":
			return 4
		case "FAIL":
			return 3
		case "ERROR":
			return 2
		case "TIMEOUT":
			return 1
		case "SKIPPED":
			return 0
		default:
			return -1
		}
	}
	r := rank(to) - rank(from)
	switch {
	case r < 0:
		return "regression"
	case r > 0:
		return "improvement"
	default:
		return "unchanged"
	}
}

