   369	func copyInputs(m *Manifest, src, dst string, required map[string]bool) error {
   370		for _, s := range m.Steps {
   371			if !required[s.ID] {
   372				continue
   373			}
   374			for _, in := range s.Inputs {
   375				p := normalizePath(in)
   376				if p == "" {
   377					continue
   378				}
   379				srcPath := filepath.Join(src, p)
   380				dstPath := filepath.Join(dst, p)
   381				info, err := os.Stat(srcPath)
   382				if err != nil {
   383					continue
   384				}
   385				if err := os.MkdirAll(filepath.Dir(dstPath), 0755); err != nil {
   386					return err
   387				}
   388				if info.IsDir() {
   389					if err := copyDir(srcPath, dstPath); err != nil {
   390						return err
   391					}
   392				} else {
   393					if err := copyFile(srcPath, dstPath); err != nil {
   394						return err
   395					}
   396				}
   397			}
   398		}
   399		return nil
   400	}
   401	
   402	func copyDir(src, dst string) error {
   403		if err := os.MkdirAll(dst, 0755); err != nil {
   404			return err
   405		}
   406		entries, err := os.ReadDir(src)
   407		if err != nil {
   408			return err
   409		}
   410		for _, e := range entries {
   411			srcPath := filepath.Join(src, e.Name())
   412			dstPath := filepath.Join(dst, e.Name())
   413			if e.IsDir() {
   414				if err := copyDir(srcPath, dstPath); err != nil {
   415					return err
   416				}
   417			} else {
   418				if err := copyFile(srcPath, dstPath); err != nil {
   419					return err
   420				}
   421			}
   422		}
   423		return nil
   424	}
   425	
   426	func copyFile(src, dst string) error {
   427		in, err := os.Open(src)
   428		if err != nil {
   429			return err
   430		}
   431		defer in.Close()
   432		out, err := os.Create(dst)
   433		if err != nil {
   434			return err
   435		}
   436		defer out.Close()
   437		if _, err := ioCopy(in, out); err != nil {
   438			return err
   439		}
   440		return out.Sync()
   441	}
   442	
   443	func ioCopy(in *os.File, out *os.File) (int64, error) {
   444		buf := make([]byte, 32*1024)
   445		var written int64
   446		for {
   447			n, err := in.Read(buf)
   448			if n > 0 {
   449				if _, werr := out.Write(buf[:n]); werr != nil {
   450					return written, werr
   451				}
   452				written += int64(n)
   453			}
   454			if err == io.EOF {
   455				break
   456			}
   457			if err != nil {
   458				return written, err
   459			}
   460		}
