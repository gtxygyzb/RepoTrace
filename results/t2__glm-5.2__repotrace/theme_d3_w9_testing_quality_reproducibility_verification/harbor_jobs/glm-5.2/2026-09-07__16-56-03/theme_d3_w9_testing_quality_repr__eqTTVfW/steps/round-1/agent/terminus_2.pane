    49	func loadManifest(path string) (*Manifest, error) {
    50		data, err := os.ReadFile(path)
    51		if err != nil {
    52			if os.IsNotExist(err) {
    53				return nil, fmt.Errorf("manifest not found: %s", path)
    54			}
    55			return nil, err
    56		}
    57	
    58		raw := map[string]json.RawMessage{}
