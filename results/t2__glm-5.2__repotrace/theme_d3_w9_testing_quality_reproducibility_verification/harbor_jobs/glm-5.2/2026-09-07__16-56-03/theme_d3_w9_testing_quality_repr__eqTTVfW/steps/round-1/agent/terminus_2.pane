	lastRank := statusRank(lastStatus)
	if lastRank < firstRank {
		return "degrading"
	}
	if lastRank > firstRank {
		return "improving"
	}
	return "stable"
}

func statusRank(status string) int {
	switch status {
	case "PASS":
		return 4
	case "FAIL":
		return 1
	case "ERROR":
		return 2
	case "TIMEOUT":
		return 3
	case "SKIPPED":
		return 0
	default:
		return -1
