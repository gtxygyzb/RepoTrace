	ManifestVersion    string `json:"manifest_version"`
	Timestamp          string `json:"timestamp"`
	OverallStatus      string `json:"overall_status"`
	VerificationConfig struct {
		Passes        int      `json:"passes"`
		Algorithm     string   `json:"algorithm"`
		Mode          string   `json:"mode"`
		TargetedSteps []string `json:"targeted_steps"`
	} `json:"verification_config"`
	EnvironmentConfig struct {
		Locale              string   `json:"locale"`
		Timezone            string   `json:"timezone"`
		Seed                *int     `json:"seed"`
		NormalizePaths      bool     `json:"normalize_paths"`
		NormalizeTimestamps bool     `json:"normalize_timestamps"`
		BlockedEnvVars      []string `json:"blocked_env_vars"`
	} `json:"environment_config"`
	Steps              []stepReport `json:"steps"`
	DependencyAnalysis struct {
		TopologicalOrder []string   `json:"topological_order"`
		ParallelGroups   [][]string `json:"parallel_groups"`
		CriticalPath     []string   `json:"critical_path"`
		TotalSteps       int        `json:"total_steps"`
		MaxParallelism   int        `json:"max_parallelism"`
	} `json:"dependency_analysis"`
	NonDeterminismHints []hint            `json:"non_determinism_hints"`
	PolicyEvaluation    *policyEvaluation `json:"policy_evaluation,omitempty"`
	Summary             struct {
		TotalOutputs        int `json:"total_outputs"`
		ConsistentOutputs   int `json:"consistent_outputs"`
		InconsistentOutputs int `json:"inconsistent_outputs"`
		ReferenceMatches    int `json:"reference_matches"`
		ReferenceMismatches int `json:"reference_mismatches"`
		StepsPassed         int `json:"steps_passed"`
		StepsFailed         int `json:"steps_failed"`
		StepsError          int `json:"steps_error"`
		StepsSkipped        int `json:"steps_skipped"`
		StepsTimeout        int `json:"steps_timeout"`
	} `json:"summary"`
}

type stepReport struct {
	ID             string         `json:"id"`
	ExecutionOrder int            `json:"execution_order"`
	Status         string         `json:"status"`
	Outputs        []outputReport `json:"outputs"`
	TimingMs       []int64        `json:"timing_ms"`
	ErrorMessage   *string        `json:"error_message"`
}

type outputReport struct {
	Path                string   `json:"path"`
