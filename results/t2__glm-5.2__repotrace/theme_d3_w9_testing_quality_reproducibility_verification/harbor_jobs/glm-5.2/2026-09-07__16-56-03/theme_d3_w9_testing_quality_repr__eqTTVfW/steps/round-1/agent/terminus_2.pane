    98	func verifyCmd(args []string) {
    99		stepsFlag := ""
   100		cacheDir := ""
   101		pipelineRoot := "."
   102		positional := parseFlags(args, map[string]*string{
   103			"steps":         &stepsFlag,
   104			"cache-dir":     &cacheDir,
   105			"pipeline-root": &pipelineRoot,
   106		})
