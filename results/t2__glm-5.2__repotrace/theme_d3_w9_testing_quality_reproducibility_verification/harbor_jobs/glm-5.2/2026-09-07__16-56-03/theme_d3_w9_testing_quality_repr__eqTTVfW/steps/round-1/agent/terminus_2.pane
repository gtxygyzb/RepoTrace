   420					if ignoredSteps[id] {
   421						continue
   422					}
   423					relevant := true
   424					if hasRequiredAllow && !requiredAllowListed[id] && !mustPassSteps[id] {
   425						relevant = false
   426					}
   427					if !relevant {
   428						continue
   429					}
   430					if mustPassSteps[id] && effectiveStatus[id] != "PASS" {
   431						policyStatus = "FAIL"
   432						break
   433					}
   434					if defaultAction == "strict" && effectiveStatus[id] == "FAIL" {
   435						policyStatus = "FAIL"
   436						break
   437					}
   438				}
