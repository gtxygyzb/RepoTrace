[?2004lfunc classifyTrendStep(statusChanges int, firstStatus, lastStatus string) string {
	if statusChanges == 0 {
		return "stable"
	}
	if statusChanges >= 2 {
		return "flaky"
	}

	firstRank := statusRank(firstStatus)
	lastRank := statusRank(lastStatus)
	if lastRank < firstRank {
		return "degrading"
	}
	if lastRank > firstRank {
		return "improving"
	}
	return "stable"
}

