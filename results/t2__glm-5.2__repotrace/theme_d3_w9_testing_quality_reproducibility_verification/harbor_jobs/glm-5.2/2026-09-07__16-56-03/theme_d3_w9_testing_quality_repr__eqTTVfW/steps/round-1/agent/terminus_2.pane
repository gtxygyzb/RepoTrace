    10	
    11	type Graph struct {
    12	nodes []string
    13	direct map[string][]string
    14	dependents map[string][]string
    15	}
    16	
    17	func buildGraph(steps []Step) *Graph {
    18	g := &Graph{direct: map[string][]string{}, dependents: map[string][]string{}}
    19	for _, s := range steps {
    20	g.nodes = append(g.nodes, s.ID)
    21	g.direct[s.ID] = append([]string{}, s.DependsOn...)
    22	}
    23	sort.Strings(g.nodes)
    24	for _, s := range steps {
    25	for _, dep := range s.DependsOn {
    26	g.dependents[dep] = append(g.dependents[dep], s.ID)
    27	}
    28	}
    29	return g
    30	}
    31	
    32	func (g *Graph) deps(id string) []string {
    33	return g.direct[id]
    34	}
    35	
    36	func shortestCycle(steps []Step) []string {
    37	g := buildGraph(steps)
    38	var best []string
    39	for _, start := range g.nodes {
    40	stack := []string{start}
    41	seen := map[string]bool{start: true}
    42	var dfs func()
    43	dfs = func() {
    44	last := stack[len(stack)-1]
    45	deps := append([]string{}, g.direct[last]...)
    46	sort.Strings(deps)
    47	for _, dep := range deps {
    48	if dep == start {
    49	cyc := append([]string{}, stack...)
    50	cyc = append(cyc, start)
    51	if best == nil || len(cyc) < len(best) || (len(cyc) == len(best) && lessCycle(cyc, best)) {
    52	best = cyc
    53	}
    54	return
    55	}
    56	if !seen[dep] {
    57	seen[dep] = true
    58	stack = append(stack, dep)
    59	dfs()
    60	stack = stack[:len(stack)-1]
    61	delete(seen, dep)
    62	}
    63	}
    64	}
    65	dfs()
    66	}
    67	return best
    68	}
    69	
    70	func lessCycle(a, b []string) bool {
    71	for i := 0; i < len(a) && i < len(b); i++ {
    72	if a[i] != b[i] {
    73	return a[i] < b[i]
    74	}
    75	}
    76	return len(a) < len(b)
    77	}
    78	
