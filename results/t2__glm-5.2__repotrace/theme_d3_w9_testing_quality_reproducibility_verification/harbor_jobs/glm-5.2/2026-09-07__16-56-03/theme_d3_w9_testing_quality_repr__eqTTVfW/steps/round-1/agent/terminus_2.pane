[?2004lpackage main

import (
	"encoding/json"
	"fmt"
	"os"
	"time"
)

type summaryReportInput struct {
	ManifestName    string       `json:"manifest_name"`
	ManifestVersion string       `json:"manifest_version"`
	OverallStatus   string       `json:"overall_status"`
	Steps           []stepReport `json:"steps"`
}

type summaryReportEntry struct {
	File            string  `json:"file"`
	ManifestName    string  `json:"manifest_name"`
	ManifestVersion string  `json:"manifest_version"`
	OverallStatus   string  `json:"overall_status"`
	StepCount       int     `json:"step_count"`
	PassCount       int     `json:"pass_count"`
	FailCount       int     `json:"fail_count"`
	PassRate        float64 `json:"pass_rate"`
}

type summaryAggregate struct {
	TotalReports    int     `json:"total_reports"`
	TotalSteps      int     `json:"total_steps"`
	TotalPass       int     `json:"total_pass"`
	TotalFail       int     `json:"total_fail"`
	OverallPassRate float64 `json:"overall_pass_rate"`
	AllPassing      bool    `json:"all_passing"`
}

type summaryOutput struct {
	SummaryTimestamp string               `json:"summary_timestamp"`
	Reports          []summaryReportEntry `json:"reports"`
	Aggregate        summaryAggregate     `json:"aggregate"`
}

func summaryCmd(args []string) {
	if len(args) == 0 {
		fmt.Fprintln(os.Stderr, "error: summary requires at least one report file")
		os.Exit(2)
	}

	format := "json"
	positional := []string{}
	for i := 0; i < len(args); i++ {
		switch args[i] {
		case "--format":
			i++
			if i >= len(args) {
				fmt.Fprintln(os.Stderr, "error: --format requires an argument")
				os.Exit(2)
			}
			format = args[i]
			if format != "json" && format != "text" {
				fmt.Fprintf(os.Stderr, "error: invalid format %q\n", format)
				os.Exit(2)
			}
		case "--format=json":
			format = "json"
		case "--format=text":
			format = "text"
		default:
			if len(args[i]) > 0 && args[i][0] == '-' {
				fmt.Fprintf(os.Stderr, "error: unknown flag %q\n", args[i])
				os.Exit(2)
			}
			positional = append(positional, args[i])
		}
	}

	if len(positional) == 0 {
		fmt.Fprintln(os.Stderr, "error: summary requires at least one report file")
		os.Exit(2)
	}

	entries := make([]summaryReportEntry, 0, len(positional))
	aggregate := summaryAggregate{}
	allPassing := true

	for _, path := range positional {
		if _, err := os.Stat(path); err != nil {
			if os.IsNotExist(err) {
				fmt.Fprintf(os.Stderr, "error: summary file not found: %s\n", path)
			} else {
				fmt.Fprintf(os.Stderr, "error: invalid summary input: %s: %s\n", path, err)
			}
			os.Exit(2)
		}

		data, err := os.ReadFile(path)
		if err != nil {
			fmt.Fprintf(os.Stderr, "error: invalid summary input: %s: %s\n", path, err)
			os.Exit(2)
		}

		var rep summaryReportInput
		if err := json.Unmarshal(data, &rep); err != nil {
			fmt.Fprintf(os.Stderr, "error: invalid summary input: %s: %s\n", path, err)
			os.Exit(2)
		}

		if rep.ManifestName == "" {
			fmt.Fprintf(os.Stderr, "error: invalid summary input: %s: missing field manifest_name\n", path)
			os.Exit(2)
		}
		if rep.OverallStatus == "" {
			fmt.Fprintf(os.Stderr, "error: invalid summary input: %s: missing field overall_status\n", path)
			os.Exit(2)
		}
		if rep.Steps == nil {
			fmt.Fprintf(os.Stderr, "error: invalid summary input: %s: missing field steps\n", path)
			os.Exit(2)
		}

		stepCount := len(rep.Steps)
		passCount := 0
		for _, sr := range rep.Steps {
			if sr.Status == "PASS" {
				passCount++
			}
		}
		failCount := stepCount - passCount
		passRate := 1.0
		if stepCount != 0 {
			passRate = float64(passCount) / float64(stepCount)
		}

		entries = append(entries, summaryReportEntry{
			File:            path,
			ManifestName:    rep.ManifestName,
			ManifestVersion: rep.ManifestVersion,
			OverallStatus:   rep.OverallStatus,
			StepCount:       stepCount,
			PassCount:       passCount,
			FailCount:       failCount,
			PassRate:        passRate,
		})

		aggregate.TotalReports++
		aggregate.TotalSteps += stepCount
		aggregate.TotalPass += passCount
		aggregate.TotalFail += failCount
		if rep.OverallStatus != "PASS" {
			allPassing = false
		}
	}

	aggregate.OverallPassRate = 1.0
	if aggregate.TotalSteps != 0 {
		aggregate.OverallPassRate = float64(aggregate.TotalPass) / float64(aggregate.TotalSteps)
	}
	aggregate.AllPassing = allPassing

	out := summaryOutput{
		SummaryTimestamp: time.Now().UTC().Format(time.RFC3339),
		Reports:          entries,
		Aggregate:        aggregate,
	}

	if format == "text" {
		for _, r := range out.Reports {
