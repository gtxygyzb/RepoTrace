    26	}
    27	
    28	type summaryAggregate struct {
    29		TotalReports    int     `json:"total_reports"`
    30		TotalSteps      int     `json:"total_steps"`
    31		TotalPass       int     `json:"total_pass"`
    32		TotalFail       int     `json:"total_fail"`
    33		OverallPassRate float64 `json:"overall_pass_rate"`
    34		AllPassing      bool    `json:"all_passing"`
