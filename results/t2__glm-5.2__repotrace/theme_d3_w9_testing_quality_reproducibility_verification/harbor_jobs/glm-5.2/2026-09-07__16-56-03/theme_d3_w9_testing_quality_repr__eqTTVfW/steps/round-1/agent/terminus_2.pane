[?2004lpackage main

import (
	"fmt"
	"os"
)

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: repro-verify <verify|fingerprint|graph|diff|summary|trend|slice> ...")
		os.Exit(2)
	}
	switch os.Args[1] {
	case "verify":
		verifyCmd(os.Args[2:])
	case "fingerprint":
		fingerprintCmd(os.Args[2:])
	case "graph":
		graphCmd(os.Args[2:])
	case "diff":
		diffCmd(os.Args[2:])
	case "summary":
		summaryCmd(os.Args[2:])
	case "trend":
		trendCmd(os.Args[2:])
	case "slice":
		sliceCmd(os.Args[2:])
	default:
		fmt.Fprintf(os.Stderr, "error: unknown subcommand %q\n", os.Args[1])
		os.Exit(2)
	}
}
