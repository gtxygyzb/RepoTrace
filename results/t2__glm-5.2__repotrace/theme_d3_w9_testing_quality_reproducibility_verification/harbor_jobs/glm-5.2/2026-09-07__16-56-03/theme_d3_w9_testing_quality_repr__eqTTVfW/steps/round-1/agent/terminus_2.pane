   246		case "FAIL":
   247			os.Exit(1)
   248		default:
   249			os.Exit(2)
   250		}
   251	}
   252	
   253	func firstFailedDependency(pr *passResult, s Step) (string, bool) {
   254		deps := append([]string{}, s.DependsOn...)
   255		sort.Strings(deps)
   256		for _, dep := range deps {
   257			st := pr.status[dep]
   258			if st == "ERROR" {
   259				return dep, false
   260			}
   261			if st == "TIMEOUT" {
   262				return dep, true
   263			}
   264		}
   265		return "", false
   266	}
   267	
   268	func executeStep(m *Manifest, s Step, root string, pr *passResult, verifyOutputs bool, algorithm string) {
   269		workDir := filepath.Join(root, normalizePath(s.WorkingDir))
   270		if err := os.MkdirAll(workDir, 0755); err != nil {
   271			pr.status[s.ID] = "ERROR"
   272			pr.err[s.ID] = err.Error()
   273			pr.timing[s.ID] = 0
   274			return
   275		}
   276		cmd := exec.CommandContext(context.Background(), "sh", "-c", s.Command)
   277		timeout := s.TimeoutSecs
   278		if timeout <= 0 {
   279			timeout = 300
   280		}
   281		ctx, cancel := context.WithTimeout(context.Background(), time.Duration(timeout)*time.Second)
   282		defer cancel()
   283		cmd = exec.CommandContext(ctx, "sh", "-c", s.Command)
   284		cmd.Dir = workDir
   285		cmd.Env = buildEnv(m, s, workDir)
   286		var stderr bytes.Buffer
   287		cmd.Stderr = &stderr
   288		start := time.Now()
   289		err := cmd.Run()
   290		elapsed := time.Since(start).Milliseconds()
   291		pr.timing[s.ID] = elapsed
   292		if ctx.Err() == context.DeadlineExceeded {
   293			pr.status[s.ID] = "TIMEOUT"
   294			pr.err[s.ID] = fmt.Sprintf("timeout after %ds", timeout)
   295			return
   296		}
   297		if err != nil {
   298			pr.status[s.ID] = "ERROR"
   299			msg := strings.TrimSpace(stderr.String())
   300			if msg != "" {
   301				pr.err[s.ID] = fmt.Sprintf("exit status %d: %s", exitCode(err), truncate(msg, 200))
   302			} else {
   303				pr.err[s.ID] = fmt.Sprintf("exit status %d", exitCode(err))
   304			}
   305			return
   306		}
   307		for _, out := range s.Outputs {
   308			outPath := filepath.Join(root, normalizePath(out))
   309			if _, err := os.Stat(outPath); err != nil {
   310				pr.status[s.ID] = "ERROR"
   311				pr.err[s.ID] = "missing output: " + normalizePath(out)
   312				pr.timing[s.ID] = elapsed
   313				return
   314			}
   315		}
   316		pr.status[s.ID] = "PASS"
   317		if verifyOutputs {
   318			if pr.outputs[s.ID] == nil {
   319				pr.outputs[s.ID] = map[string]string{}
   320			}
   321			for _, out := range s.Outputs {
   322				outPath := filepath.Join(root, normalizePath(out))
   323				fp, err := fingerprintFile(outPath, algorithm)
   324				if err != nil {
   325					fp = ""
   326				}
   327				pr.outputs[s.ID][normalizePath(out)] = fp
   328			}
   329		}
   330	}
   331	
   332	func buildEnv(m *Manifest, s Step, workDir string) []string {
   333		envMap := map[string]string{}
   334		for _, kv := range os.Environ() {
   335			idx := strings.IndexByte(kv, '=')
   336			if idx >= 0 {
   337				envMap[kv[:idx]] = kv[idx+1:]
   338			}
   339		}
   340		set := func(k, v string) { envMap[k] = v }
   341		set("LC_ALL", m.Env.Locale)
   342		set("TZ", m.Env.Timezone)
   343		if m.Env.Seed != nil {
   344			set("REPRO_SEED", strconv.Itoa(*m.Env.Seed))
   345		}
   346		if m.Env.NormalizeTimestamps {
   347			set("SOURCE_DATE_EPOCH", "0")
   348		}
   349		for k, v := range m.Env.EnvVars {
   350			set(k, v)
   351		}
   352		for k, v := range s.EnvOverrides {
   353			set(k, v)
   354		}
   355		if m.Env.NormalizePaths {
   356			set("PWD", workDir)
   357		}
   358		for _, b := range m.Env.BlockedEnvVars {
   359			delete(envMap, b)
   360		}
