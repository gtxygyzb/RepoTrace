   289						ev.MatchedSteps = appendUnique(ev.MatchedSteps, sr.ID)
   290						ev.MatchedOutputs = appendUnique(ev.MatchedOutputs, o.Path)
   291						st.matched = true
   292	
   293						majorityRate := majorityRate(o.Fingerprints)
   294						condition := majorityRate >= rate
   295						switch rule.Action {
   296						case "allow":
   297							if condition {
   298								st.effective = true
   299								ev.Effect = "applied"
   300								ev.Details = "output majority rate satisfies required consistency"
   301							}
   302						case "warn":
   303							if condition {
   304								warnings = append(warnings, fmt.Sprintf("rule %s: consistency allowed with warning for %s:%s", rule.ID, sr.ID, o.Path))
   305								ev.Effect = "applied"
   306								ev.Details = "warned about allowed consistency for matched outputs"
   307							}
   308						case "require":
   309							if !condition {
   310								requireViolation = true
   311								ev.Effect = "violation"
   312								ev.Details = fmt.Sprintf("majority rate %.3f below required %.3f", majorityRate, rate)
   313							} else {
   314								ev.Effect = "applied"
   315								ev.Details = "required majority rate satisfied"
   316							}
   317						}
   318					}
   319				}
   320				sort.Strings(ev.MatchedSteps)
   321				sort.Strings(ev.MatchedOutputs)
   322				ruleEvals = append(ruleEvals, ev)
   323	
   324			case "required_steps":
   325				ev := policyRuleEval{
   326					RuleID:   rule.ID,
   327					RuleType: rule.Type,
   328					Action:   rule.Action,
   329					Effect:   "not_applicable",
   330				}
   331				steps, _ := policyStringSliceParam(rule, "steps")
   332				ev.MatchedSteps = append([]string{}, steps...)
   333				sort.Strings(ev.MatchedSteps)
   334				for _, id := range steps {
   335					matchedStepsAll[id] = true
   336					if rule.Action == "require" {
   337						mustPassSteps[id] = true
   338					} else if rule.Action == "allow" {
   339						hasRequiredAllow = true
   340						requiredAllowListed[id] = true
   341					}
   342				}
   343				if rule.Action == "require" {
   344					ev.Effect = "applied"
   345					ev.Details = "listed steps are required to pass"
   346				} else if rule.Action == "allow" {
   347					ev.Effect = "applied"
   348					ev.Details = "unlisted steps are forgiven"
   349				}
   350				ruleEvals = append(ruleEvals, ev)
   351	
   352			case "ignore_steps":
   353				ev := policyRuleEval{
   354					RuleID:   rule.ID,
   355					RuleType: rule.Type,
   356					Action:   rule.Action,
   357					Effect:   "not_applicable",
   358				}
   359				steps, _ := policyStringSliceParam(rule, "steps")
   360				ev.MatchedSteps = append([]string{}, steps...)
   361				sort.Strings(ev.MatchedSteps)
   362				for _, id := range steps {
   363					matchedStepsAll[id] = true
   364					ignoredSteps[id] = true
   365				}
   366				if len(steps) > 0 {
   367					ev.Effect = "applied"
   368					ev.Details = "steps ignored from policy evaluation"
   369				}
   370				ruleEvals = append(ruleEvals, ev)
   371			}
   372		}
   373	
   374		effectiveStatus := map[string]string{}
   375		for _, sr := range rep.Steps {
   376			id := sr.ID
   377			st := rawStatus[id]
   378			if st == "ERROR" || st == "TIMEOUT" || st == "SKIPPED" {
   379				effectiveStatus[id] = st
   380				continue
   381			}
   382			badOutput := false
   383			for _, o := range sr.Outputs {
   384				if outputs[id][o.Path] != nil && !outputs[id][o.Path].effective {
   385					badOutput = true
   386					break
   387				}
   388			}
   389			if badOutput {
   390				effectiveStatus[id] = "FAIL"
   391			} else {
   392				effectiveStatus[id] = "PASS"
   393			}
   394		}
   395	
   396		policyStatus := "PASS"
   397		for _, sr := range rep.Steps {
   398			id := sr.ID
   399			if ignoredSteps[id] {
   400				continue
   401			}
   402			relevant := true
   403			if hasRequiredAllow && !requiredAllowListed[id] && !mustPassSteps[id] {
   404				relevant = false
   405			}
   406			if !relevant {
   407				continue
   408			}
   409			if effectiveStatus[id] == "ERROR" || effectiveStatus[id] == "TIMEOUT" {
   410				policyStatus = "ERROR"
   411				break
   412			}
   413		}
   414		if policyStatus != "ERROR" {
   415			if requireViolation {
   416				policyStatus = "FAIL"
   417			} else {
   418				for _, sr := range rep.Steps {
   419					id := sr.ID
   420					if ignoredSteps[id] {
   421						continue
   422					}
   423					relevant := true
   424					if hasRequiredAllow && !requiredAllowListed[id] && !mustPassSteps[id] {
   425						relevant = false
   426					}
   427					if !relevant {
   428						continue
   429					}
   430					if mustPassSteps[id] && effectiveStatus[id] != "PASS" {
   431						policyStatus = "FAIL"
   432						break
   433					}
   434					if defaultAction == "strict" && effectiveStatus[id] == "FAIL" {
   435						policyStatus = "FAIL"
   436						break
   437					}
   438				}
   439			}
   440		}
   441	
   442		effectiveStepStatuses := map[string]string{}
   443		for _, sr := range rep.Steps {
   444			id := sr.ID
   445			if matchedStepsAll[id] || effectiveStatus[id] != rawStatus[id] {
   446				effectiveStepStatuses[id] = effectiveStatus[id]
   447			}
   448		}
   449	
   450		return &policyEvaluation{
   451			PolicyOverallStatus:   policyStatus,
   452			DefaultAction:         defaultAction,
   453			RulesEvaluated:        ruleEvals,
   454			EffectiveStepStatuses: effectiveStepStatuses,
   455			Warnings:              warnings,
   456		}
   457	}
   458	
   459	func majorityRate(fps []string) float64 {
   460		if len(fps) == 0 {
   461			return 0
   462		}
   463		counts := map[string]int{}
   464		for _, fp := range fps {
   465			counts[fp]++
   466		}
   467		max := 0
   468		for _, c := range counts {
   469			if c > max {
   470				max = c
   471			}
   472		}
   473		return float64(max) / float64(len(fps))
   474	}
   475	
   476	func appendUnique(slice []string, value string) []string {
   477		for _, v := range slice {
   478			if v == value {
   479				return slice
   480			}
   481		}
   482		return append(slice, value)
   483	}
