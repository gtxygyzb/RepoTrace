   162	func evaluatePolicy(m *Manifest, rep *report) *policyEvaluation {
   163	p := m.Policy
   164	if p == nil {
   165	return nil
   166	}
   167	defaultAction := p.DefaultAction
   168	if defaultAction == "" {
   169	defaultAction = "strict"
   170	}
   171	
   172	stepByID := map[string]Step{}
   173	for _, s := range m.Steps {
   174	stepByID[s.ID] = s
   175	}
   176	
   177	rawStatus := map[string]string{}
   178	for _, sr := range rep.Steps {
   179	rawStatus[sr.ID] = sr.Status
   180	}
   181	
   182	type outputState struct {
   183	bad       bool
   184	effective bool
   185	matched   bool
   186	}
   187	outputs := map[string]map[string]*outputState{}
   188	for _, sr := range rep.Steps {
   189	for _, o := range sr.Outputs {
   190	if outputs[sr.ID] == nil {
   191	outputs[sr.ID] = map[string]*outputState{}
   192	}
   193	bad := !o.CrossPassConsistent || (o.ReferenceMatch != nil && !*o.ReferenceMatch)
   194	outputs[sr.ID][o.Path] = &outputState{
   195	bad:       bad,
   196	effective: !bad,
   197	}
   198	}
   199	}
   200	
   201	matchedStepsAll := map[string]bool{}
   202	ignoredSteps := map[string]bool{}
   203	mustPassSteps := map[string]bool{}
   204	requiredAllowListed := map[string]bool{}
   205	hasRequiredAllow := false
   206	requireViolation := false
   207	warnings := []string{}
   208	ruleEvals := make([]policyRuleEval, 0, len(p.Rules))
   209	
   210	for _, rule := range p.Rules {
   211	switch rule.Type {
   212	case "allow_variance":
   213	ev := policyRuleEval{
   214	RuleID:   rule.ID,
   215	RuleType: rule.Type,
   216	Action:   rule.Action,
   217	Effect:   "not_applicable",
   218	}
   219	pattern, _ := policyStringParam(rule, "output_pattern")
   220	for _, sr := range rep.Steps {
   221	if rawStatus[sr.ID] == "ERROR" || rawStatus[sr.ID] == "TIMEOUT" || rawStatus[sr.ID] == "SKIPPED" {
   222	continue
   223	}
   224	for _, o := range sr.Outputs {
   225	st := outputs[sr.ID][o.Path]
   226	if st == nil || st.matched {
   227	continue
   228	}
   229	matched, err := filepath.Match(pattern, o.Path)
   230	if err != nil || !matched {
   231	continue
   232	}
   233	matchedStepsAll[sr.ID] = true
   234	ev.MatchedSteps = appendUnique(ev.MatchedSteps, sr.ID)
   235	ev.MatchedOutputs = appendUnique(ev.MatchedOutputs, o.Path)
   236	st.matched = true
   237	
   238	switch rule.Action {
   239	case "allow":
   240	if st.bad {
   241	st.effective = true
   242	ev.Effect = "applied"
   243	ev.Details = "allowed variance for matched outputs"
   244	}
   245	case "warn":
   246	if st.bad {
   247	warnings = append(warnings, fmt.Sprintf("rule %s: variance allowed with warning for %s:%s", rule.ID, sr.ID, o.Path))
   248	ev.Effect = "applied"
   249	ev.Details = "warned about variance for matched outputs"
   250	}
   251	case "require":
   252	if !st.bad {
   253	requireViolation = true
   254	ev.Effect = "violation"
   255	ev.Details = "output is consistent but rule requires variance"
   256	} else {
   257	ev.Effect = "applied"
   258	ev.Details = "required variance present for matched outputs"
   259	}
   260	}
   261	}
   262	}
   263	sort.Strings(ev.MatchedSteps)
   264	sort.Strings(ev.MatchedOutputs)
   265	ruleEvals = append(ruleEvals, ev)
   266	
   267	case "min_consistency_rate":
   268	ev := policyRuleEval{
   269	RuleID:   rule.ID,
   270	RuleType: rule.Type,
   271	Action:   rule.Action,
   272	Effect:   "not_applicable",
   273	}
   274	rate, _ := policyFloatParam(rule, "rate")
   275	stepPattern, _ := policyStringParam(rule, "step_pattern")
   276	for _, sr := range rep.Steps {
   277	stepMatched, err := filepath.Match(stepPattern, sr.ID)
   278	if err != nil || !stepMatched {
   279	continue
   280	}
   281	if rawStatus[sr.ID] == "ERROR" || rawStatus[sr.ID] == "TIMEOUT" || rawStatus[sr.ID] == "SKIPPED" {
   282	continue
   283	}
   284	for _, o := range sr.Outputs {
   285	st := outputs[sr.ID][o.Path]
   286	if st == nil || st.matched {
   287	continue
   288	}
   289	matchedStepsAll[sr.ID] = true
   290	ev.MatchedSteps = appendUnique(ev.MatchedSteps, sr.ID)
   291	ev.MatchedOutputs = appendUnique(ev.MatchedOutputs, o.Path)
   292	st.matched = true
   293	
   294	majorityRate := majorityRate(o.Fingerprints)
   295	condition := majorityRate >= rate
   296	switch rule.Action {
   297	case "allow":
   298	if condition {
   299	st.effective = true
   300	ev.Effect = "applied"
   301	ev.Details = "output majority rate satisfies required consistency"
   302	}
   303	case "warn":
   304	if condition {
   305	warnings = append(warnings, fmt.Sprintf("rule %s: consistency allowed with warning for %s:%s", rule.ID, sr.ID, o.Path))
   306	ev.Effect = "applied"
   307	ev.Details = "warned about allowed consistency for matched outputs"
   308	}
   309	case "require":
   310	if !condition {
   311	requireViolation = true
   312	ev.Effect = "violation"
   313	ev.Details = fmt.Sprintf("majority rate %.3f below required %.3f", majorityRate, rate)
   314	} else {
   315	ev.Effect = "applied"
   316	ev.Details = "required majority rate satisfied"
   317	}
   318	}
   319	}
   320	}
   321	sort.Strings(ev.MatchedSteps)
   322	sort.Strings(ev.MatchedOutputs)
   323	ruleEvals = append(ruleEvals, ev)
   324	
   325	case "required_steps":
   326	ev := policyRuleEval{
   327	RuleID:   rule.ID,
   328	RuleType: rule.Type,
   329	Action:   rule.Action,
   330	Effect:   "not_applicable",
   331	}
   332	steps, _ := policyStringSliceParam(rule, "steps")
   333	ev.MatchedSteps = append([]string{}, steps...)
   334	sort.Strings(ev.MatchedSteps)
   335	for _, id := range steps {
   336	matchedStepsAll[id] = true
   337	if rule.Action == "require" {
   338	mustPassSteps[id] = true
   339	} else if rule.Action == "allow" {
   340	hasRequiredAllow = true
   341	requiredAllowListed[id] = true
   342	}
   343	}
   344	if rule.Action == "require" {
   345	ev.Effect = "applied"
   346	ev.Details = "listed steps are required to pass"
   347	} else if rule.Action == "allow" {
   348	ev.Effect = "applied"
   349	ev.Details = "unlisted steps are forgiven"
   350	}
   351	ruleEvals = append(ruleEvals, ev)
   352	
   353	case "ignore_steps":
   354	ev := policyRuleEval{
   355	RuleID:   rule.ID,
   356	RuleType: rule.Type,
   357	Action:   rule.Action,
   358	Effect:   "not_applicable",
   359	}
   360	steps, _ := policyStringSliceParam(rule, "steps")
