   161	func evaluatePolicy(m *Manifest, rep *report) *policyEvaluation {
   162		p := m.Policy
   163		if p == nil {
   164			return nil
   165		}
   166		defaultAction := p.DefaultAction
   167		if defaultAction == "" {
   168			defaultAction = "strict"
   169		}
   170	
   171		stepByID := map[string]Step{}
   172		for _, s := range m.Steps {
   173			stepByID[s.ID] = s
   174		}
   175	
   176		rawStatus := map[string]string{}
   177		for _, sr := range rep.Steps {
   178			rawStatus[sr.ID] = sr.Status
   179		}
   180	
   181		type outputState struct {
   182			bad       bool
   183			effective bool
   184			matched   bool
   185		}
   186		outputs := map[string]map[string]*outputState{}
