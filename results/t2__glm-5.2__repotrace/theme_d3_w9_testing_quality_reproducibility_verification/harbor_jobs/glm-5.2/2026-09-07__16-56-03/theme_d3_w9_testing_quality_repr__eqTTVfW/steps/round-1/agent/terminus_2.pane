[?2004lpackage main

import (
	"fmt"
	"os"
	"strings"
)

func parseFlags(args []string, defs map[string]*string) []string {
	positionals := []string{}
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if strings.HasPrefix(arg, "--") {
			name := strings.TrimPrefix(arg, "--")
			var value string
			if idx := strings.IndexByte(name, '='); idx >= 0 {
				value = name[idx+1:]
				name = name[:idx]
			} else {
				if i+1 >= len(args) {
					fmt.Fprintf(os.Stderr, "error: flag --%s requires a value\n", name)
					os.Exit(2)
				}
				i++
				value = args[i]
			}
			ptr, ok := defs[name]
			if !ok {
				fmt.Fprintf(os.Stderr, "error: unknown flag --%s\n", name)
				os.Exit(2)
			}
			*ptr = value
		} else {
			positionals = append(positionals, arg)
		}
	}
	return positionals
}
[?2004hroot@n30009:/app# sed -n '77,92p' docs/spec_v4.md
[?2004l### 17.3 Text Output Format

```
Trend Analysis (<N> reports)
==========================
<step_id>  <classification>  [<s1>, <s2>, ...]  stability=<value>
...
---
<total> steps: <stable> stable, <flaky> flaky, <degrading> degrading, <improving> improving
Overall stability: <pct>%
```

- Each step on one line. Status values are comma-separated. Null entries display as `-`.
- Stability value is formatted to two decimal places (e.g., `0.50`, `1.00`).
- Overall stability percentage is formatted to one decimal place (e.g., `75.0%`, `100.0%`).
- Steps are listed in alphabetical order by `step_id`.
