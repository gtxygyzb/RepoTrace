     8	
     9	func parseFlags(args []string, defs map[string]*string) []string {
    10		positionals := []string{}
    11		for i := 0; i < len(args); i++ {
    12			arg := args[i]
    13			if strings.HasPrefix(arg, "--") {
    14				name := strings.TrimPrefix(arg, "--")
    15				var value string
    16				if idx := strings.IndexByte(name, '='); idx >= 0 {
    17					value = name[idx+1:]
    18					name = name[:idx]
    19				} else {
    20					if i+1 >= len(args) {
    21						fmt.Fprintf(os.Stderr, "error: flag --%s requires a value\n", name)
    22						os.Exit(2)
    23					}
    24					i++
    25					value = args[i]
    26				}
    27				ptr, ok := defs[name]
    28				if !ok {
    29					fmt.Fprintf(os.Stderr, "error: unknown flag --%s\n", name)
    30					os.Exit(2)
    31				}
    32				*ptr = value
    33			} else {
    34				positionals = append(positionals, arg)
    35			}
    36		}
    37		return positionals
    38	}
