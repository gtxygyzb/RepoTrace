   734					HintType: classifyHint(m, s, o, passes),
   735					Detail:   "output varied across passes",
   736				})
   737			}
   738		}
   739		sort.Slice(hints, func(i, j int) bool {
   740			if hints[i].StepID != hints[j].StepID {
