   287		cmd.Stderr = &stderr
   288		start := time.Now()
   289		err := cmd.Run()
   290		elapsed := time.Since(start).Milliseconds()
   291		pr.timing[s.ID] = elapsed
   292		if ctx.Err() == context.DeadlineExceeded {
   293			pr.status[s.ID] = "TIMEOUT"
   294			pr.err[s.ID] = fmt.Sprintf("timeout after %ds", timeout)
   295			return
   296		}
