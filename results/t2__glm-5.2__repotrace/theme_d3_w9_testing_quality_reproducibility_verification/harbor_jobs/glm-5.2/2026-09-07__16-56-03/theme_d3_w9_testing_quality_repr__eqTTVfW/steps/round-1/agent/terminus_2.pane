   280					if rawStatus[sr.ID] == "ERROR" || rawStatus[sr.ID] == "TIMEOUT" || rawStatus[sr.ID] == "SKIPPED" {
   281						continue
   282					}
   283					for _, o := range sr.Outputs {
   284						st := outputs[sr.ID][o.Path]
