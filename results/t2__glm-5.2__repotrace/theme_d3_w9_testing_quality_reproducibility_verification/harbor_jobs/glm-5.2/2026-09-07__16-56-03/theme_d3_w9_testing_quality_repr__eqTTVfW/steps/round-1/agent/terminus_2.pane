func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: repro-verify <verify|fingerprint|graph> ...")
		os.Exit(2)
	}
	switch os.Args[1] {
	case "verify":
		verifyCmd(os.Args[2:])
	case "fingerprint":
		fingerprintCmd(os.Args[2:])
	case "graph":
