    11	
    12	type trendReportLite struct {
    13		ManifestName    string       `json:"manifest_name"`
    14		ManifestVersion string       `json:"manifest_version"`
    15		OverallStatus   string       `json:"overall_status"`
    16		Timestamp       string       `json:"timestamp"`
    17		Steps           []stepReport `json:"steps"`
    18	}
    19	
    20	type trendStep struct {
    21		StepID         string    `json:"step_id"`
    22		Statuses       []*string `json:"statuses"`
    23		FirstSeenIndex int       `json:"first_seen_index"`
    24		LastSeenIndex  int       `json:"last_seen_index"`
    25		StatusChanges  int       `json:"status_changes"`
    26		Stability      float64   `json:"stability"`
    27		Classification string    `json:"classification"`
    28	}
    29	
    30	type trendAggregate struct {
    31		TotalStepsTracked int     `json:"total_steps_tracked"`
    32		StableCount       int     `json:"stable_count"`
    33		FlakyCount        int     `json:"flaky_count"`
    34		DegradingCount    int     `json:"degrading_count"`
    35		ImprovingCount    int     `json:"improving_count"`
    36		OverallStability  float64 `json:"overall_stability"`
    37	}
    38	
    39	type trendOutput struct {
    40		TrendTimestamp string         `json:"trend_timestamp"`
    41		ReportCount    int            `json:"report_count"`
    42		StepTrends     []trendStep    `json:"step_trends"`
    43		Aggregate      trendAggregate `json:"aggregate"`
    44	}
    45	
    46	func trendCmd(args []string) {
    47		format := "json"
    48		positional := parseFlags(args, map[string]*string{
    49			"format": &format,
    50		})
    51	
    52		if len(positional) < 2 {
    53			fmt.Fprintln(os.Stderr, "error: trend requires at least two report files")
    54			os.Exit(2)
    55		}
    56	
    57		reports := make([]*trendReportLite, 0, len(positional))
    58		for _, path := range positional {
    59			rep, err := loadTrendReport(path)
    60			if err != nil {
    61				fmt.Fprintln(os.Stderr, err)
    62				os.Exit(2)
    63			}
    64			reports = append(reports, rep)
    65		}
    66	
    67		output := buildTrendOutput(reports)
    68	
    69		if format == "text" {
    70			printTrendText(output)
    71		} else {
    72			data, err := json.MarshalIndent(output, "", "  ")
    73			if err != nil {
    74				fmt.Fprintf(os.Stderr, "error: %s\n", err)
    75				os.Exit(2)
    76			}
    77			fmt.Println(string(data))
    78		}
    79	
    80		if output.Aggregate.DegradingCount > 0 || output.Aggregate.FlakyCount > 0 {
    81			os.Exit(1)
    82		}
    83		os.Exit(0)
    84	}
    85	
    86	func loadTrendReport(path string) (*trendReportLite, error) {
    87		if _, err := os.Stat(path); err != nil {
    88			if os.IsNotExist(err) {
    89				return nil, fmt.Errorf("error: trend file not found: %s", path)
    90			}
    91			return nil, fmt.Errorf("error: invalid trend input: %s: %s", path, err)
    92		}
    93	
    94		data, err := os.ReadFile(path)
    95		if err != nil {
    96			return nil, fmt.Errorf("error: invalid trend input: %s: %s", path, err)
    97		}
    98	
    99		var raw map[string]json.RawMessage
   100		if err := json.Unmarshal(data, &raw); err != nil {
   101			return nil, fmt.Errorf("error: invalid trend input: %s: %s", path, err)
   102		}
   103	
   104		for _, field := range []string{"manifest_name", "overall_status", "steps"} {
   105			if _, ok := raw[field]; !ok {
   106				return nil, fmt.Errorf("error: invalid trend input: %s: missing field %s", path, field)
   107			}
   108		}
   109	
   110		var r trendReportLite
   111		if err := json.Unmarshal(data, &r); err != nil {
   112			return nil, fmt.Errorf("error: invalid trend input: %s: %s", path, err)
   113		}
   114		if r.ManifestName == "" {
   115			return nil, fmt.Errorf("error: invalid trend input: %s: missing field manifest_name", path)
   116		}
   117		if r.OverallStatus == "" {
   118			return nil, fmt.Errorf("error: invalid trend input: %s: missing field overall_status", path)
   119		}
   120		if r.Steps == nil {
   121			return nil, fmt.Errorf("error: invalid trend input: %s: missing field steps", path)
   122		}
   123	
   124		return &r, nil
   125	}
   126	
   127	func buildTrendOutput(reports []*trendReportLite) *trendOutput {
   128		reportCount := len(reports)
   129		stepIDs := make(map[string]bool)
   130		reportStepStatus := make([]map[string]string, reportCount)
   131	
   132		for i, rep := range reports {
   133			statusByID := make(map[string]string)
   134			for _, step := range rep.Steps {
   135				statusByID[step.ID] = step.Status
   136				stepIDs[step.ID] = true
   137			}
   138			reportStepStatus[i] = statusByID
   139		}
   140	
   141		ids := make([]string, 0, len(stepIDs))
   142		for id := range stepIDs {
   143			ids = append(ids, id)
   144		}
   145		sort.Strings(ids)
   146	
   147		stepTrends := make([]trendStep, 0, len(ids))
   148		var stableCount, flakyCount, degradingCount, improvingCount int
   149		var stabilitySum float64
   150	
   151		for _, id := range ids {
   152			statuses := make([]*string, reportCount)
   153			appearances := 0
   154			firstSeenIndex := -1
   155			lastSeenIndex := -1
   156			var firstStatus, lastStatus string
   157	
   158			for i, statusByID := range reportStepStatus {
   159				if status, ok := statusByID[id]; ok {
   160					statusCopy := status
   161					statuses[i] = &statusCopy
   162					appearances++
   163					if firstSeenIndex == -1 {
   164						firstSeenIndex = i
   165						firstStatus = status
   166					}
   167					lastSeenIndex = i
   168					lastStatus = status
   169				}
   170			}
   171	
   172			statusChanges := 0
   173			var prev *string
   174			for _, status := range statuses {
   175				if status == nil {
   176					continue
   177				}
   178				if prev != nil && *prev != *status {
   179					statusChanges++
   180				}
