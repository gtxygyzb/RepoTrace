		firstSeenIndex := -1
		lastSeenIndex := -1
		var firstStatus, lastStatus string

		for i, statusByID := range reportStepStatus {
			if status, ok := statusByID[id]; ok {
				statusCopy := status
				statuses[i] = &statusCopy
				appearances++
				if firstSeenIndex == -1 {
					firstSeenIndex = i
					firstStatus = status
				}
				lastSeenIndex = i
				lastStatus = status
			}
		}

		statusChanges := 0
		var prev *string
		for _, status := range statuses {
			if status == nil {
				continue
			}
			if prev != nil && *prev != *status {
				statusChanges++
			}
			prev = status
		}

		stability := 1.0
		if appearances > 1 {
			stability = 1.0 - float64(statusChanges)/float64(appearances-1)
		}

