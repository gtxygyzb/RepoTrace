	Reference           *string  `json:"reference"`
	ReferenceMatch      *bool    `json:"reference_match"`
	CrossPassConsistent bool     `json:"cross_pass_consistent"`
	VarianceDetail      *string  `json:"variance_detail"`
}

type hint struct {
	Output   string `json:"output"`
