	case "graph":
		graphCmd(os.Args[2:])
	case "diff":
		diffCmd(os.Args[2:])
	case "summary":
		summaryCmd(os.Args[2:])
	case "trend":
		trendCmd(os.Args[2:])
	default:
		fmt.Fprintf(os.Stderr, "error: unknown subcommand %q\n", os.Args[1])
		os.Exit(2)
	}
}
