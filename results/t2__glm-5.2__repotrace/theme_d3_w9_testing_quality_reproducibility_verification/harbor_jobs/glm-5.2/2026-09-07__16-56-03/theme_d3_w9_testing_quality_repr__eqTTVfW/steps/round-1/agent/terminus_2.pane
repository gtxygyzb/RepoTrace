    12	func fingerprintFile(path, algorithm string) (string, error) {
    13		f, err := os.Open(path)
    14		if err != nil {
    15			return "", err
    16		}
    17		defer f.Close()
    18		var sum []byte
    19		switch algorithm {
    20		case "sha256":
    21			h := sha256.New()
    22			if _, err := io.Copy(h, f); err != nil {
    23				return "", err
    24			}
    25			sum = h.Sum(nil)
    26		case "blake2b":
    27			h := sha512.New()
    28			if _, err := io.Copy(h, f); err != nil {
    29				return "", err
    30			}
    31			sum = h.Sum(nil)[:32]
    32		default:
    33			return "", fmt.Errorf("invalid algorithm: %q", algorithm)
    34		}
    35		return algorithm + ":" + hex.EncodeToString(sum), nil
    36	}
    37	
