   188			for _, o := range sr.Outputs {
   189				if outputs[sr.ID] == nil {
   190					outputs[sr.ID] = map[string]*outputState{}
   191				}
   192				bad := !o.CrossPassConsistent || (o.ReferenceMatch != nil && !*o.ReferenceMatch)
   193				outputs[sr.ID][o.Path] = &outputState{
   194					bad:       bad,
   195					effective: !bad,
   196				}
   197			}
   198		}
