   258	func diffStepOutputs(b, c stepReport) ([]diffOutputChange, bool) {
   259		bOutputs := map[string]outputReport{}
   260		for _, o := range b.Outputs {
   261			bOutputs[o.Path] = o
   262		}
   263		cOutputs := map[string]outputReport{}
   264		for _, o := range c.Outputs {
   265			cOutputs[o.Path] = o
   266		}
   267	
   268		paths := map[string]bool{}
   269		for p := range bOutputs {
   270			paths[p] = true
   271		}
   272		for p := range cOutputs {
   273			paths[p] = true
   274		}
   275	
   276		var keys []string
   277		for p := range paths {
   278			keys = append(keys, p)
   279		}
   280		sort.Strings(keys)
   281	
   282		changes := []diffOutputChange{}
   283		changed := false
   284	
   285		for _, p := range keys {
   286			bo, hasB := bOutputs[p]
   287			co, hasC := cOutputs[p]
   288	
   289			oc := diffOutputChange{
   290				Path: p,
   291				Details: diffOutputDetail{
   292					BaselineFingerprints: nilIfEmpty(bo.Fingerprints),
   293					CurrentFingerprints:  nilIfEmpty(co.Fingerprints),
   294				},
   295			}
   296			if hasB {
   297				oc.Details.BaselineConsistent = &bo.CrossPassConsistent
   298				if bo.ReferenceMatch != nil {
   299					oc.Details.BaselineReferenceMatch = bo.ReferenceMatch
   300				}
   301			}
   302			if hasC {
   303				oc.Details.CurrentConsistent = &co.CrossPassConsistent
   304				if co.ReferenceMatch != nil {
   305					oc.Details.CurrentReferenceMatch = co.ReferenceMatch
   306				}
   307			}
   308	
   309			switch {
   310			case hasC && !hasB:
   311				oc.ChangeType = "added"
   312				changed = true
   313			case hasB && !hasC:
   314				oc.ChangeType = "removed"
   315				changed = true
   316			case !equalStrings(bo.Fingerprints, co.Fingerprints):
   317				oc.ChangeType = "fingerprint_changed"
   318				changed = true
   319			case bo.CrossPassConsistent != co.CrossPassConsistent:
   320				oc.ChangeType = "consistency_changed"
   321				changed = true
   322			case !boolPtrEqual(bo.ReferenceMatch, co.ReferenceMatch):
   323				oc.ChangeType = "reference_changed"
   324				changed = true
   325			default:
   326				oc.ChangeType = "unchanged"
   327			}
   328			changes = append(changes, oc)
   329		}
   330	
   331		return changes, changed
   332	}
