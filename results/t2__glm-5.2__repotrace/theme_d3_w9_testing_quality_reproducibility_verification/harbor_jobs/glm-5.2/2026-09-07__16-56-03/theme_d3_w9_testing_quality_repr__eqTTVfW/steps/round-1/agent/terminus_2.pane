   310				pr.status[s.ID] = "ERROR"
   311				pr.err[s.ID] = "missing output: " + normalizePath(out)
   312				pr.timing[s.ID] = elapsed
   313				return
   314			}
   315		}
   316		pr.status[s.ID] = "PASS"
   317		if verifyOutputs {
   318			if pr.outputs[s.ID] == nil {
   319				pr.outputs[s.ID] = map[string]string{}
   320			}
