   170			root, err := os.MkdirTemp("", "repro-verify-")
   171			if err != nil {
   172				fmt.Fprintf(os.Stderr, "error: %s\n", err)
   173				os.Exit(2)
   174			}
   175			if err := copyInputs(m, pipelineRoot, root, required); err != nil {
   176				fmt.Fprintf(os.Stderr, "error: %s\n", err)
   177				os.RemoveAll(root)
   178				os.Exit(2)
   179			}
   180			pr := &passResult{
