   252	
   253	func firstFailedDependency(pr *passResult, s Step) (string, bool) {
   254		deps := append([]string{}, s.DependsOn...)
   255		sort.Strings(deps)
   256		for _, dep := range deps {
   257			st := pr.status[dep]
   258			if st == "ERROR" {
   259				return dep, false
   260			}
   261			if st == "TIMEOUT" {
   262				return dep, true
   263			}
   264		}
   265		return "", false
   266	}
   267	
   268	func executeStep(m *Manifest, s Step, root string, pr *passResult, verifyOutputs bool, algorithm string) {
   269		workDir := filepath.Join(root, normalizePath(s.WorkingDir))
   270		if err := os.MkdirAll(workDir, 0755); err != nil {
   271			pr.status[s.ID] = "ERROR"
   272			pr.err[s.ID] = err.Error()
   273			pr.timing[s.ID] = 0
   274			return
   275		}
   276		cmd := exec.CommandContext(context.Background(), "sh", "-c", s.Command)
   277		timeout := s.TimeoutSecs
   278		if timeout <= 0 {
   279			timeout = 300
   280		}
   281		ctx, cancel := context.WithTimeout(context.Background(), time.Duration(timeout)*time.Second)
   282		defer cancel()
   283		cmd = exec.CommandContext(ctx, "sh", "-c", s.Command)
   284		cmd.Dir = workDir
   285		cmd.Env = buildEnv(m, s, workDir)
   286		var stderr bytes.Buffer
   287		cmd.Stderr = &stderr
   288		start := time.Now()
   289		err := cmd.Run()
   290		elapsed := time.Since(start).Milliseconds()
   291		pr.timing[s.ID] = elapsed
   292		if ctx.Err() == context.DeadlineExceeded {
   293			pr.status[s.ID] = "TIMEOUT"
   294			pr.err[s.ID] = fmt.Sprintf("timeout after %ds", timeout)
   295			return
   296		}
   297		if err != nil {
   298			pr.status[s.ID] = "ERROR"
   299			msg := strings.TrimSpace(stderr.String())
   300			if msg != "" {
   301				pr.err[s.ID] = fmt.Sprintf("exit status %d: %s", exitCode(err), truncate(msg, 200))
   302			} else {
   303				pr.err[s.ID] = fmt.Sprintf("exit status %d", exitCode(err))
   304			}
   305			return
   306		}
   307		for _, out := range s.Outputs {
   308			outPath := filepath.Join(root, normalizePath(out))
   309			if _, err := os.Stat(outPath); err != nil {
   310				pr.status[s.ID] = "ERROR"
   311				pr.err[s.ID] = "missing output: " + normalizePath(out)
   312				pr.timing[s.ID] = elapsed
   313				return
   314			}
   315		}
   316		pr.status[s.ID] = "PASS"
   317		if verifyOutputs {
   318			if pr.outputs[s.ID] == nil {
   319				pr.outputs[s.ID] = map[string]string{}
   320			}
   321			for _, out := range s.Outputs {
   322				outPath := filepath.Join(root, normalizePath(out))
   323				fp, err := fingerprintFile(outPath, algorithm)
   324				if err != nil {
   325					fp = ""
   326				}
   327				pr.outputs[s.ID][normalizePath(out)] = fp
   328			}
   329		}
   330	}
   331	
   332	func buildEnv(m *Manifest, s Step, workDir string) []string {
   333		envMap := map[string]string{}
   334		for _, kv := range os.Environ() {
   335			idx := strings.IndexByte(kv, '=')
   336			if idx >= 0 {
   337				envMap[kv[:idx]] = kv[idx+1:]
   338			}
   339		}
   340		set := func(k, v string) { envMap[k] = v }
   341		set("LC_ALL", m.Env.Locale)
   342		set("TZ", m.Env.Timezone)
   343		if m.Env.Seed != nil {
   344			set("REPRO_SEED", strconv.Itoa(*m.Env.Seed))
   345		}
   346		if m.Env.NormalizeTimestamps {
   347			set("SOURCE_DATE_EPOCH", "0")
   348		}
   349		for k, v := range m.Env.EnvVars {
   350			set(k, v)
   351		}
   352		for k, v := range s.EnvOverrides {
   353			set(k, v)
   354		}
   355		if m.Env.NormalizePaths {
   356			set("PWD", workDir)
   357		}
   358		for _, b := range m.Env.BlockedEnvVars {
   359			delete(envMap, b)
   360		}
[?2004hroot@n30009:/app# nl -ba cmd/repro-verify/verify.go | sed -n '361,460p'
[?2004l   361		result := make([]string, 0, len(envMap))
   362		for k, v := range envMap {
   363			result = append(result, k+"="+v)
   364		}
   365		sort.Strings(result)
   366		return result
   367	}
   368	
   369	func copyInputs(m *Manifest, src, dst string, required map[string]bool) error {
   370		for _, s := range m.Steps {
   371			if !required[s.ID] {
   372				continue
   373			}
   374			for _, in := range s.Inputs {
   375				p := normalizePath(in)
   376				if p == "" {
   377					continue
   378				}
   379				srcPath := filepath.Join(src, p)
   380				dstPath := filepath.Join(dst, p)
   381				info, err := os.Stat(srcPath)
   382				if err != nil {
   383					continue
   384				}
   385				if err := os.MkdirAll(filepath.Dir(dstPath), 0755); err != nil {
   386					return err
   387				}
   388				if info.IsDir() {
   389					if err := copyDir(srcPath, dstPath); err != nil {
   390						return err
   391					}
   392				} else {
   393					if err := copyFile(srcPath, dstPath); err != nil {
   394						return err
   395					}
   396				}
   397			}
   398		}
   399		return nil
   400	}
   401	
   402	func copyDir(src, dst string) error {
   403		if err := os.MkdirAll(dst, 0755); err != nil {
   404			return err
   405		}
   406		entries, err := os.ReadDir(src)
   407		if err != nil {
   408			return err
   409		}
   410		for _, e := range entries {
   411			srcPath := filepath.Join(src, e.Name())
   412			dstPath := filepath.Join(dst, e.Name())
   413			if e.IsDir() {
   414				if err := copyDir(srcPath, dstPath); err != nil {
   415					return err
   416				}
   417			} else {
   418				if err := copyFile(srcPath, dstPath); err != nil {
   419					return err
   420				}
   421			}
   422		}
   423		return nil
   424	}
   425	
   426	func copyFile(src, dst string) error {
   427		in, err := os.Open(src)
   428		if err != nil {
   429			return err
   430		}
   431		defer in.Close()
   432		out, err := os.Create(dst)
   433		if err != nil {
   434			return err
   435		}
   436		defer out.Close()
   437		if _, err := ioCopy(in, out); err != nil {
   438			return err
   439		}
   440		return out.Sync()
   441	}
   442	
   443	func ioCopy(in *os.File, out *os.File) (int64, error) {
   444		buf := make([]byte, 32*1024)
   445		var written int64
   446		for {
   447			n, err := in.Read(buf)
   448			if n > 0 {
   449				if _, werr := out.Write(buf[:n]); werr != nil {
   450					return written, werr
   451				}
   452				written += int64(n)
   453			}
   454			if err == io.EOF {
   455				break
   456			}
   457			if err != nil {
   458				return written, err
   459			}
   460		}
