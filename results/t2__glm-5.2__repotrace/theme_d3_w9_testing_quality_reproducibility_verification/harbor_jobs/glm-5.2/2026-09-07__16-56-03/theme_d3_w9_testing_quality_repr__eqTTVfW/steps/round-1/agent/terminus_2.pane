   216					Effect:   "not_applicable",
   217				}
   218				pattern, _ := policyStringParam(rule, "output_pattern")
   219				for _, sr := range rep.Steps {
   220					if rawStatus[sr.ID] == "ERROR" || rawStatus[sr.ID] == "TIMEOUT" || rawStatus[sr.ID] == "SKIPPED" {
   221						continue
   222					}
   223					for _, o := range sr.Outputs {
   224						st := outputs[sr.ID][o.Path]
   225						if st == nil || st.matched {
   226							continue
   227						}
   228						matched, err := filepath.Match(pattern, o.Path)
   229						if err != nil || !matched {
   230							continue
[?2004hroot@n30009:/app# nl -ba cmd/repro-verify/policy.go | sed -n '380,460p'
[?2004l   380				continue
   381			}
   382			badOutput := false
