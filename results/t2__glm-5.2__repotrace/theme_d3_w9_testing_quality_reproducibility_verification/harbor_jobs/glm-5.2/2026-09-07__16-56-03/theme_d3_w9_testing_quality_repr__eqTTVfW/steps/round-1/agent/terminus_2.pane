   232	
   233	func classifyTrendStep(statusChanges int, firstStatus, lastStatus string) string {
   234		if statusChanges == 0 {
   235			return "stable"
   236		}
   237		if statusChanges >= 2 {
   238			return "flaky"
   239		}
   240	
   241		firstRank := statusRank(firstStatus)
   242		lastRank := statusRank(lastStatus)
   243		if lastRank < firstRank {
   244			return "degrading"
   245		}
   246		if lastRank > firstRank {
   247			return "improving"
   248		}
   249		return "stable"
   250	}
   251	
   252	func statusRank(status string) int {
   253		switch status {
   254		case "PASS":
   255			return 4
   256		case "FAIL":
   257			return 3
   258		case "ERROR":
   259			return 2
   260		case "TIMEOUT":
   261			return 1
   262		case "SKIPPED":
   263			return 0
   264		default:
   265			return -1
   266		}
   267	}
   268	
   269	func printTrendText(output *trendOutput) {
   270		header := fmt.Sprintf("Trend Analysis (%d reports)", output.ReportCount)
   271		fmt.Println(header)
   272		fmt.Println(strings.Repeat("=", len(header)))
   273	
   274		for _, step := range output.StepTrends {
   275			statusParts := make([]string, 0, len(step.Statuses))
   276			for _, status := range step.Statuses {
   277				if status == nil {
   278					statusParts = append(statusParts, "-")
   279				} else {
   280					statusParts = append(statusParts, *status)
   281				}
   282			}
   283			fmt.Printf("%s  %s  [%s]  stability=%.2f\n", step.StepID, step.Classification, strings.Join(statusParts, ","), step.Stability)
   284		}
   285	
   286		fmt.Println("---")
   287		fmt.Printf("%d steps: %d stable, %d flaky, %d degrading, %d improving\n",
   288			output.Aggregate.TotalStepsTracked,
   289			output.Aggregate.StableCount,
   290			output.Aggregate.FlakyCount,
   291			output.Aggregate.DegradingCount,
   292			output.Aggregate.ImprovingCount)
   293		fmt.Printf("Overall stability: %.1f%%\n", output.Aggregate.OverallStability*100)
   294	}
