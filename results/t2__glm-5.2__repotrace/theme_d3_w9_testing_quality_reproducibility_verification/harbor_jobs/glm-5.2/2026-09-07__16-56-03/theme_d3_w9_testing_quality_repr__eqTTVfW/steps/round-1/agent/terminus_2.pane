    49	func loadManifest(path string) (*Manifest, error) {
    50		data, err := os.ReadFile(path)
    51		if err != nil {
    52			if os.IsNotExist(err) {
    53				return nil, fmt.Errorf("manifest not found: %s", path)
    54			}
    55			return nil, err
    56		}
    57	
    58		raw := map[string]json.RawMessage{}
    59		if err := json.Unmarshal(data, &raw); err != nil {
    60			return nil, fmt.Errorf("invalid manifest JSON: %s", err.Error())
    61		}
    62		for _, field := range []string{"name", "version", "verification", "environment", "steps"} {
    63			if _, ok := raw[field]; !ok {
    64				return nil, fmt.Errorf("missing required field: %s", field)
    65			}
    66		}
    67	
    68		var m Manifest
    69		if err := json.Unmarshal(data, &m); err != nil {
    70			return nil, fmt.Errorf("invalid manifest JSON: %s", err.Error())
    71		}
    72	
    73		if m.Name == "" {
    74			return nil, fmt.Errorf("missing required field: name")
    75		}
    76		if !nameRe.MatchString(m.Name) {
    77			return nil, fmt.Errorf("invalid name format: %q (must match ^[a-z][a-z0-9_-]{0,63}$)", m.Name)
    78		}
    79		if m.Version == "" {
    80			return nil, fmt.Errorf("missing required field: version")
    81		}
    82	
    83		vraw := map[string]json.RawMessage{}
    84		if err := json.Unmarshal(raw["verification"], &vraw); err != nil {
    85			return nil, fmt.Errorf("invalid manifest JSON: %s", err.Error())
    86		}
    87		for _, field := range []string{"passes", "algorithm", "mode"} {
    88			if _, ok := vraw[field]; !ok {
    89				return nil, fmt.Errorf("missing required field: verification.%s", field)
    90			}
    91		}
    92		switch m.Verify.Algorithm {
    93		case "sha256", "blake2b":
    94		default:
    95			return nil, fmt.Errorf("invalid algorithm: %q (must be \"sha256\" or \"blake2b\")", m.Verify.Algorithm)
    96		}
    97		switch m.Verify.Mode {
    98		case "full", "incremental", "targeted":
    99		default:
   100			return nil, fmt.Errorf("invalid mode: %q (must be \"full\", \"incremental\", or \"targeted\")", m.Verify.Mode)
   101		}
   102		if m.Verify.Passes < 1 {
   103			return nil, fmt.Errorf("passes must be >= 1, got %d", m.Verify.Passes)
   104		}
   105	
   106		if m.Env.Locale == "" {
   107			m.Env.Locale = "C"
   108		}
   109		if m.Env.Timezone == "" {
   110			m.Env.Timezone = "UTC"
   111		}
   112		if m.Env.EnvVars == nil {
   113			m.Env.EnvVars = map[string]string{}
   114		}
   115		if m.Env.BlockedEnvVars == nil {
   116			m.Env.BlockedEnvVars = []string{}
   117		}
   118	
   119		if len(m.Steps) == 0 {
   120			return nil, fmt.Errorf("steps must contain at least one step")
   121		}
   122		stepIDs := map[string]bool{}
   123		for i, s := range m.Steps {
   124			if s.ID == "" {
   125				return nil, fmt.Errorf("missing required field: steps[%d].id", i)
   126			}
   127			if !nameRe.MatchString(s.ID) {
   128				return nil, fmt.Errorf("invalid step id: %q (must match ^[a-z][a-z0-9_-]{0,63}$)", s.ID)
   129			}
   130			if stepIDs[s.ID] {
   131				return nil, fmt.Errorf("duplicate step id: %q", s.ID)
   132			}
   133			stepIDs[s.ID] = true
   134			if s.Command == "" {
   135				return nil, fmt.Errorf("missing required field: steps[%d].command", i)
   136			}
   137			if s.WorkingDir == "" {
   138				s.WorkingDir = "."
   139			}
   140			if s.TimeoutSecs <= 0 {
   141				s.TimeoutSecs = 300
   142			}
   143			if s.Inputs == nil {
   144				s.Inputs = []string{}
   145			}
   146			if s.Outputs == nil {
   147				s.Outputs = []string{}
   148			}
   149			if s.DependsOn == nil {
   150				s.DependsOn = []string{}
   151			}
   152			if s.EnvOverrides == nil {
   153				s.EnvOverrides = map[string]string{}
   154			}
   155			m.Steps[i] = s
   156		}
   157	
   158		for _, s := range m.Steps {
   159			for _, dep := range s.DependsOn {
   160				if !stepIDs[dep] {
   161					return nil, fmt.Errorf("unknown dependency: step %q depends on %q", s.ID, dep)
   162				}
   163			}
   164		}
   165	
   166		if cyc := shortestCycle(m.Steps); len(cyc) > 0 {
   167			return nil, fmt.Errorf("cycle detected: %s", strings.Join(cyc, " -> "))
   168		}
   169		return &m, nil
   170	}
