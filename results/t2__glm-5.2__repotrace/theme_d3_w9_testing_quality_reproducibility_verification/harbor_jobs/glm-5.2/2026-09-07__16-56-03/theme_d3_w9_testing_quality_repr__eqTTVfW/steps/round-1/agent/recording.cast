[5935.129863, "o", "func classifyTrendStep(statusChanges int, firstStatus, lastStatus string) string {\r\n\tif statusChanges == 0 {\r\n\t\treturn \"stable\"\r\n\t}\r\n\tif statusChanges >= 2 {\r\n\t\treturn \"flaky\"\r\n\t}\r\n\r\n\tfirstRank := statusRank(firstStatus)\r\n\tlastRank := statusRank(lastStatus)\r\n"]
[5935.129979, "o", "\tif lastRank < firstRank {\r\n\t\treturn \"degrading\"\r\n\t}\r\n\tif lastRank > firstRank {\r\n\t\treturn \"improving\"\r\n\t}\r\n\treturn \"stable\"\r\n}\r\n\r\nfunc statusRank(status string) int {\r\n\tswitch status {\r\n\tcase \"PASS\":\r\n\t\treturn 4\r\n"]
[5935.13015, "o", "\tcase \"FAIL\":\r\n\t\treturn 3\r\n\tcase \"ERROR\":\r\n\t\treturn 2\r\n\tcase \"TIMEOUT\":\r\n\t\treturn 1\r\n\tcase \"SKIPPED\":\r\n\t\treturn 0\r\n\tdefault:\r\n\t\treturn -1\r\n"]
[5935.130597, "o", "\u001b[?2004h"]
