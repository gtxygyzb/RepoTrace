[2667.151682, "o", "targetedSteps := []string{}\r\n   121\t\tif stepsFlag != \"\" {\r\n   122\t\t\tfor _, s := range strings.Split(stepsFlag, \",\") {\r\n   123\t\t\t\ts = strings.TrimSpace(s)\r\n   124\t\t\t\tif s != \"\" {\r\n"]
[2667.151745, "o", "   125\t\t\t\t\ttargetedSteps = append(targetedSteps, s)\r\n   126\t\t\t\t}\r\n   127\t\t\t}\r\n   128\t\t}\r\n   129\t\tif m.Verify.Mode == \"targeted\" && len(targetedSteps) == 0 {\r\n   130\t\t\tfmt.Fprintln(os.Stderr, \"error: targeted mode requires --steps\")\r\n   131\t\t\tos.Exit(2)\r\n   132\t\t}\r\n   133\t\tstepByID := map[string]Step{}\r\n   134\t\tfor _, s := range m.Steps {\r\n   135\t\t\tstepByID[s.ID] = s\r\n   136\t\t}\r\n   137\t\tfor _, t := range targetedSteps {\r\n"]
[2667.151807, "o", "   138\t\t\tif _, ok := stepByID[t]; !ok {\r\n   139\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown target step: %q\\n\", t)\r\n   140\t\t\t\tos.Exit(2)\r\n   141\t\t\t}\r\n   142\t\t}\r\n   143\t\ttopOrder := topologicalOrder(m.Steps)\r\n   144\t\ttopoIndex := map[string]int{}\r\n"]
[2667.15187, "o", "   145\t\tfor i, id := range topOrder {\r\n   146\t\t\ttopoIndex[id] = i + 1\r\n   147\t\t}\r\n   148\t\ttrans := transitiveDeps(m.Steps)\r\n   149\t\trequired := map[string]bool{}\r\n   150\t\ttargetSet := map[string]bool{}\r\n   151\t\tswitch m.Verify.Mode {\r\n   152\t\tcase \"targeted\":\r\n   153\t\t\tfor _, t := range targetedSteps {\r\n"]
[2667.151937, "o", "   154\t\t\t\ttargetSet[t] = true\r\n   155\t\t\t\trequired[t] = true\r\n   156\t\t\t\tfor _, d := range trans[t] {\r\n   157\t\t\t\t\trequired[d] = true\r\n   158\t\t\t\t}\r\n   159\t\t\t}\r\n   160\t\tdefault:\r\n   161\t\t\tfor _, s := range m.Steps {\r\n   162"]
[2667.152067, "o", "\t\t\t\trequired[s.ID] = true\r\n   163\t\t\t\ttargetSet[s.ID] = true\r\n   164\t\t\t}\r\n   165\t\t}\r\n   166\t\tpasses := make([]*passResult, 0, m.Verify.Passes)\r\n   167\t\treexecuted := map[string]bool{}\r\n   168\t\tfor p := 1; p <= m.Verify.Passes; p++ {\r\n   169\t\t\troot, err := os.MkdirTemp(\"\", \"repro-verify-\")\r\n   170\t\t\tif err != nil {\r\n   171\t\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   172\t\t\t\tos.Exit(2)\r\n   173\t\t\t}\r\n   174\t\t\tif err := copyInputs(m, pipelineRoot, root, required); err != nil {\r\n   175\t\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   176\t\t\t\tos.RemoveAll(root)\r\n   177\t\t\t\tos.Exit(2)\r\n   178\t\t\t}\r\n   179\t\t\tpr := &passResult{\r\n   180\t\t\t\troot:    root,\r\n"]
[2667.152138, "o", "   181\t\t\t\tstatus:  map[string]string{},\r\n   182\t\t\t\terr:     map[string]string{},\r\n   183\t\t\t\ttiming:  map[string]int64{},\r\n   184\t\t\t\toutputs: map[string]map[string]string{},\r\n   185\t\t\t}\r\n   186\t\t\tfor _, id := range topOrder {\r\n   187\t\t\t\ts := stepByID[id]\r\n   188\t\t\t\tif !required[id] {\r\n   189\t\t\t\t\tpr.status[id] = \"SKIPPED\"\r\n   190\t\t\t\t\tpr.timing[id] = 0\r\n"]
[2667.152195, "o", "   191\t\t\t\t\tcontinue\r\n   192\t\t\t\t}\r\n   193\t\t\t\tfailedDep, depTimeout := firstFailedDependency(pr, s)\r\n   194\t\t\t\tif failedDep != \"\" {\r\n   195\t\t\t\t\tpr.status[id] = \"ERROR\"\r\n   196\t\t\t\t\tif depTimeout {\r\n   197\t\t\t\t\t\tpr.err[id] = \"dependency timed out: \" + failedDep\r\n   198\t\t\t\t\t} else {\r\n"]
[2667.15226, "o", "   199\t\t\t\t\t\tpr.err[id] = \"dependency failed: \" + failedDep\r\n   200\t\t\t\t\t}\r\n   201\t\t\t\t\tpr.timing[id] = 0\r\n   202\t\t\t\t\tcontinue\r\n   203\t\t\t\t}\r\n   204\t\t\t\tmissingInput := \"\"\r\n   205\t\t\t\tfor _, in := range s.Inputs {\r\n   206\t\t\t\t\tif _, err := os.Stat(filepath.Join(root, normalizePath(in))); err != nil {\r\n   207\t\t\t"]
[2667.152317, "o", "\t\t\tmissingInput = normalizePath(in)\r\n   208\t\t\t\t\t\tbreak\r\n   209\t\t\t\t\t}\r\n   210\t\t\t\t}\r\n   211\t\t\t\tif missingInput != \"\" {\r\n   212\t\t\t\t\tpr.status[id] = \"ERROR\"\r\n   213\t\t\t\t\tpr.err[id] = \"missing input: \" + missingInput\r\n"]
[2667.15238, "o", "   214\t\t\t\t\tpr.timing[id] = 0\r\n   215\t\t\t\t\tcontinue\r\n   216\t\t\t\t}\r\n   217\t\t\t\tif m.Verify.Mode == \"incremental\" && cacheDir != \"\" {\r\n   218\t\t\t\t\tif skip, cachedOutputs, err := checkCache(m, s, root, cacheDir, trans, reexecuted); err == nil && skip {\r\n   219\t\t\t\t\t\tpr.status[id] = \"PASS\"\r\n   220\t\t\t\t\t\tpr.timing[id] = 0\r\n   221\t\t\t\t\t\tpr.outputs[id] = cachedOutputs\r\n"]
[2667.152441, "o", "   222\t\t\t\t\t\tcontinue\r\n   223\t\t\t\t\t}\r\n   224\t\t\t\t}\r\n   225\t\t\t\texecuteStep(m, s, root, pr, targetSet[id], m.Verify.Algorithm)\r\n   226\t\t\t\tif pr.status[id] == \"PASS\" && m.Verify.Mode == \"incremental\" && cacheDir != \"\" {\r\n   227\t\t\t\t\twriteCache(m, s, root, cacheDir, pr.outputs[id])\r\n"]
[2667.152499, "o", "   228\t\t\t\t\treexecuted[id] = true\r\n   229\t\t\t\t}\r\n   230\t\t\t}\r\n   231\t\t\tpasses = append(passes, pr)\r\n   232\t\t}\r\n   233\t\trep := buildReport(m, passes, topOrder, topoIndex, trans, targetedSteps, required, targetSet)\r\n   234\t\tfor _, pr := range passes {\r\n   235\t\t\tos.RemoveAll(pr.root)\r\n"]
[2667.152565, "o", "   236\t\t}\r\n   237\t\tout, err := json.MarshalIndent(rep, \"\", \"  \")\r\n   238\t\tif err != nil {\r\n   239\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   240\t\t\tos.Exit(2)\r\n"]
[2667.152628, "o", "   241\t\t}\r\n   242\t\tfmt.Println(string(out))\r\n   243\t\tswitch rep.OverallStatus {\r\n   244\t\tcase \"PASS\":\r\n   245\t\t\tos.Exit(0)\r\n   246\t\tcase \"FAIL\":\r\n   247\t\t\tos.Exit(1)\r\n   248\t\tdefault:\r\n   249\t\t\tos.Exit(2)\r\n   250\t\t}\r\n   251\t}\r\n   252\t\r\n   253"]
[2667.152685, "o", "\tfunc firstFailedDependency(pr *passResult, s Step) (string, bool) {\r\n   254\t\tdeps := append([]string{}, s.DependsOn...)\r\n   255\t\tsort.Strings(deps)\r\n   256\t\tfor _, dep := range deps {\r\n   257\t\t\tst := pr.status[dep]\r\n   258\t\t\tif st == \"ERROR\" {\r\n   259\t\t\t\treturn dep, false\r\n   260\t\t\t}\r\n"]
[2667.152722, "o", "   261\t\t\tif st == \"TIMEOUT\" {\r\n   262\t\t\t\treturn dep, true\r\n   263\t\t\t}\r\n   264\t\t}\r\n   265\t\treturn \"\", false\r\n   266\t}\r\n"]
[2667.152802, "o", "   267\t\r\n   268\tfunc executeStep(m *Manifest, s Step, root string, pr *passResult, verifyOutputs bool, algorithm string) {\r\n   269\t\tworkDir := filepath.Join(root, normalizePath(s.WorkingDir))\r\n   270\t\tif err := os.MkdirAll(workDir, 0755); err != nil {\r\n   271\t\t\tpr.status[s.ID] = \"ERROR\"\r\n   272\t\t\tpr.err[s.ID] = err.Error()\r\n   273\t\t\tpr.timing[s.ID] = 0\r\n   274\t\t\treturn\r\n   275\t\t}\r\n   276\t\tcmd := exec.CommandContext(context.Background(), \"sh\", \"-c\", s.Command)\r\n   277\t\ttimeout := s.TimeoutSecs\r\n"]
[2667.152859, "o", "   278\t\tif timeout <= 0 {\r\n   279\t\t\ttimeout = 300\r\n   280\t\t}\r\n   281\t\tctx, cancel := context.WithTimeout(context.Background(), time.Duration(timeout)*time.Second)\r\n   282\t\tdefer cancel()\r\n   283\t\tcmd = exec.CommandContext(ctx, \"sh\", \"-c\", s.Command)\r\n   284\t\tcmd.Dir = workDir\r\n"]
[2667.152924, "o", "   285\t\tcmd.Env = buildEnv(m, s, workDir)\r\n   286\t\tvar stderr bytes.Buffer\r\n   287\t\tcmd.Stderr = &stderr\r\n   288\t\tstart := time.Now()\r\n   289\t\terr := cmd.Run()\r\n   290\t\telapsed := time.Since(start).Milliseconds()\r\n   291\t\tpr.timing[s.ID] = elapsed\r\n   292\t\tif ctx.Err() == context.DeadlineExceeded {\r\n   293\t\t\tpr.status[s.ID] = \"TIMEOUT\"\r\n"]
[2667.15301, "o", "   294\t\t\tpr.err[s.ID] = fmt.Sprintf(\"timeout after %ds\", timeout)\r\n   295\t\t\treturn\r\n   296\t\t}\r\n   297\t\tif err != nil {\r\n   298\t\t\tpr.status[s.ID] = \"ERROR\"\r\n   299\t\t\tmsg := strings.TrimSpace(stderr.String())\r\n   300\t\t\tif msg != \"\" {\r\n   301\t\t\t\tpr.err[s.ID] = fmt.Sprintf(\"exit status %d: %s\", exitCode(err), truncate(msg, 200))\r\n   302\t\t\t} else {\r\n   303\t\t\t\tpr.err[s.ID] = fmt.Sprintf(\"exit status %d\", exitCode(err))\r\n"]
[2667.153074, "o", "   304\t\t\t}\r\n   305\t\t\treturn\r\n   306\t\t}\r\n   307\t\tfor _, out := range s.Outputs {\r\n   308\t\t\toutPath := filepath.Join(root, normalizePath(out))\r\n   309\t\t\tif _, err := os.Stat(outPath); err != nil {\r\n   310\t\t\t\tpr.status[s.ID] = \"ERROR\"\r\n   311\t\t\t\tpr.err[s.ID] = \"missing output: \" + normalizePath(out)\r\n   312\t\t\t\tpr.timing[s.ID] = elapsed\r\n   313\t\t\t\treturn\r\n"]
[2667.153131, "o", "   314\t\t\t}\r\n   315\t\t}\r\n   316\t\tpr.status[s.ID] = \"PASS\"\r\n   317\t\tif verifyOutputs {\r\n   318\t\t\tif pr.outputs[s.ID] == nil {\r\n   319\t\t\t\tpr.outputs[s.ID] = map[string]string{}\r\n   320\t\t\t}\r\n   321\t\t\tfor _, out := range s.Outputs {\r\n   322"]
[2667.153191, "o", "\t\t\t\toutPath := filepath.Join(root, normalizePath(out))\r\n   323\t\t\t\tfp, err := fingerprintFile(outPath, algorithm)\r\n   324\t\t\t\tif err != nil {\r\n   325\t\t\t\t\tfp = \"\"\r\n   326\t\t\t\t}\r\n   327\t\t\t\tpr.outputs[s.ID][normalizePath(out)] = fp\r\n   328\t\t\t}\r\n   329\t\t}\r\n   330\t"]
[2667.153255, "o", "}\r\n   331\t\r\n   332\tfunc buildEnv(m *Manifest, s Step, workDir string) []string {\r\n   333\t\tenvMap := map[string]string{}\r\n   334\t\tfor _, kv := range os.Environ() {\r\n   335\t\t\tidx := strings.IndexByte(kv, '=')\r\n   336\t\t\tif idx >= 0 {\r\n   337\t\t\t\tenvMap[kv[:idx]] = kv[idx+1:]\r\n   338"]
[2667.153311, "o", "\t\t\t}\r\n   339\t\t}\r\n   340\t\tset := func(k, v string) { envMap[k] = v }\r\n   341\t\tset(\"LC_ALL\", m.Env.Locale)\r\n   342\t\tset(\"TZ\", m.Env.Timezone)\r\n   343\t\tif m.Env.Seed != nil {\r\n   344\t\t\tset(\"REPRO_SEED\", strconv.Itoa(*m.Env.Seed))\r\n   345"]
[2667.153368, "o", "\t\t}\r\n   346\t\tif m.Env.NormalizeTimestamps {\r\n   347\t\t\tset(\"SOURCE_DATE_EPOCH\", \"0\")\r\n   348\t\t}\r\n   349\t\tfor k, v := range m.Env.EnvVars {\r\n   350\t\t\tset(k, v)\r\n   351\t\t}\r\n   352\t\t"]
[2667.153425, "o", "for k, v := range s.EnvOverrides {\r\n   353\t\t\tset(k, v)\r\n   354\t\t}\r\n   355\t\tif m.Env.NormalizePaths {\r\n   356\t\t\tset(\"PWD\", workDir)\r\n   357\t\t}\r\n   358\t\tfor _, b := range m.Env.BlockedEnvVars {\r\n   359\t\t\tdelete(envMap, b)\r\n   360\t"]
[2667.153484, "o", "\t}\r\n"]
