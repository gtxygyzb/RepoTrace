[1461.34007, "o", "    11\t\r\n    12\tfunc fingerprintFile(path, algorithm string) (string, error) {\r\n    13\t\tf, err := os.Open(path)\r\n    14\t\tif err != nil {\r\n    15\t\t\treturn \"\", err\r\n    16\t\t}\r\n    17\t\tdefer f.Close()\r\n    18\t\tvar sum []byte\r\n    19\t\tswitch algorithm {\r\n    20\t\tcase \"sha256\":\r\n    21\t\t\th := sha256.New()\r\n    22\t\t\tif _, err := io.Copy(h, f); err != nil {\r\n    23\t\t\t\treturn \"\", err\r\n    24\t\t\t}\r\n    25\t\t\tsum = h.Sum(nil)\r\n    26\t\tcase \"blake2b\":\r\n    27\t\t\th := sha512.New()\r\n    28\t\t\tif _, err := io.Copy(h, f); err != nil {\r\n    29\t\t\t\treturn \"\", err\r\n    30\t\t\t}\r\n    31\t\t\tsum = h.Sum(nil)[:32]\r\n    32\t\tdefault:\r\n    33\t\t\treturn \"\", fmt.Errorf(\"invalid algorithm: %q\", algorithm)\r\n    34\t\t}\r\n    35\t\treturn algorithm + \":\" + hex.EncodeToString(sum), nil\r\n    36\t}\r\n    37\t\r\n    38\tfunc fingerprintCmd(args []string) {\r\n    39\t\tfs := flag.NewFlagSet(\"fingerprint\", flag.ExitOnError)\r\n    40\t\talgorithm := fs.String(\"algorithm\", \"sha256\", \"algorithm\")\r\n    41\t\tfs.Parse(args)\r\n    42\t\tif fs.NArg() < 1 {\r\n    43\t\t\tfmt.Fprintln(o"]
