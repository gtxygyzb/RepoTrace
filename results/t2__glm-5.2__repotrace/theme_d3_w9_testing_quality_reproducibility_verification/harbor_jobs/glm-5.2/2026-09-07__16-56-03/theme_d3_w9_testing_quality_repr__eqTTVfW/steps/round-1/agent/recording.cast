[6064.77212, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('cmd/repro-verify/main.go')\ns = p.read_text()\ns = s.replace('usage: repro-verify <verify|fingerprint|graph|diff|summary|trend> ...', 'usage: repro-verify <verify|fingerprint|graph|diff|summary|trend|slice> ...')\ns = s.replace('\\tcase \"trend\":\\n\\t\\ttrendCmd(os.Args[2:])\\n', '\\tcase \"trend\":\\n\\t\\ttrendCmd(os.Args[2:])\\n\\tcase \"slice\":\\n\\t\\tsliceCmd(os.Args[2:])\\n')\np.write_text(s)\nPY\n"]
[6064.77231, "o", "python3 - <<'PY'\r\n"]
