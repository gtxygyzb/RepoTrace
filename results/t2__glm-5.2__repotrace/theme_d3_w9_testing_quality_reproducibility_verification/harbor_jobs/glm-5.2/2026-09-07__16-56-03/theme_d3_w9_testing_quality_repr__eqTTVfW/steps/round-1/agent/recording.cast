[1170.526123, "o", "func buildHints(m *Manifest, passes []*passResult, steps []stepReport, stepByID map[string]Step) []hint {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.526181, "o", "var hints []hint\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.526254, "o", "for _, sr := range steps {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.526323, "o", "s := stepByID[sr.ID]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.5264, "o", "for _, o := range sr.Outputs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.526473, "o", "if o.CrossPassConsistent {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.526528, "o", "continue\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1170.526583, "o", "\u001b[?2004h> "]
[1170.526639, "o", "hints = append(hints, hint{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.526695, "o", "Output:   o.Path,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.526759, "o", "StepID:   sr.ID,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.526827, "o", "HintType: classifyHint(m, s, o, passes),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.526923, "o", "Detail:   \"output varied across passes\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.526989, "o", "})\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1170.527045, "o", "\u001b[?2004h> "]
[1170.527103, "o", "sort.Slice(hints, func(i, j int) bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.5272, "o", "if hints[i].StepID != hints[j].StepID {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.527299, "o", "return hints[i].StepID < hints[j].StepID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.527355, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.527428, "o", "return hints[i].Output < hints[j].Output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.527484, "o", "})\r\n\u001b[?2004l\r\u001b[?2004h> return hints\r\n\u001b[?2004l\r"]
[1170.52754, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1170.5276, "o", "\u001b[?2004h> "]
[1170.527737, "o", "func classifyHint(m *Manifest, s Step, o outputReport, passes []*passResult) string {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.527803, "o", "if len(passes) < 2 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
