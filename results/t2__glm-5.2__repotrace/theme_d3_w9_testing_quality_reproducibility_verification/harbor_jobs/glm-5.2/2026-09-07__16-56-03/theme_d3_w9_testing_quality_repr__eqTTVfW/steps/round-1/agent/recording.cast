[5446.431639, "o", "\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\ntype passResult struct {\r\n\troot    string\r\n\tstatus  map[string]string\r\n\terr     map[string]string\r\n\ttiming  map[string]int64\r\n\toutputs map[string]map[string]string\r\n"]
[5446.431729, "o", "}\r\n\r\ntype report struct {\r\n\tManifestName       string `json:\"manifest_name\"`\r\n\tManifestVersion    string `json:\"manifest_version\"`\r\n\tTimestamp          string `json:\"timestamp\"`\r\n\tOverallStatus      string `json:\"overall_status\"`\r\n\tVerificationConfig struct {\r\n\t\t"]
[5446.431804, "o", "Passes        int      `json:\"passes\"`\r\n\t\tAlgorithm     string   `json:\"algorithm\"`\r\n\t\tMode          string   `json:\"mode\"`\r\n\t\tTargetedSteps []string `json:\"targeted_steps\"`\r\n\t} `json:\"verification_config\"`\r\n\tEnvironmentConfig struct {\r\n\t\tLocale              string   `json:\"locale\"`\r\n\t\tTimezone            string   `json:\"timezone\"`\r\n\t\tSeed                *int     `json:\"seed\"`\r\n\t\tNormalizePaths      bool     `json:\"normalize_paths\"`\r\n\t\tNormalizeTimestamps bool     `json:\"normalize_timestamps\"`\r\n\t\tBlockedEnvVars      []string `json:\"blocked_env_vars\"`"]
[5446.431921, "o", "\r\n\t} `json:\"environment_config\"`\r\n\tSteps              []stepReport `json:\"steps\"`\r\n\tDependencyAnalysis struct {\r\n\t\tTopologicalOrder []string   `json:\"topological_order\"`\r\n\t\tParallelGroups   [][]string `json:\"parallel_groups\"`\r\n\t\tCriticalPath     []string   `json:\"critical_path\"`\r\n\t\tTotalSteps       int        `json:\"total_steps\"`\r\n\t\tMaxParallelism   int        `json:\"max_parallelism\"`\r\n\t} `json:\"dependency_analysis\"`\r\n\tNonDeterminismHints []hint            `json:\"non_determinism_hints\"`\r\n\tPolicyEvaluation    *policyEvaluation `json:\"policy_evaluation,omitempty\"`\r\n\tSummary             struct {\r\n\t\tTotalOutputs        int `json:\"total_outputs\"`\r\n\t\tConsistentOutputs   int `json:\"consistent_outputs\"`\r\n\t\tInconsistentOutputs int `json:\"inconsistent_outputs\"`\r\n\t\tReferenceMatches    int `json:\"reference_matches\"`"]
[5446.43206, "o", "\r\n\t\tReferenceMismatches int `json:\"reference_mismatches\"`\r\n\t\tStepsPassed         int `json:\"steps_passed\"`\r\n\t\tStepsFailed         int `json:\"steps_failed\"`\r\n\t\tStepsError          int `json:\"steps_error\"`\r\n\t\tStepsSkipped        int `json:\"steps_skipped\"`\r\n\t\tStepsTimeout        int `json:\"steps_timeout\"`\r\n\t} `json:\"summary\"`\r\n}\r\n\r\ntype stepReport struct {\r\n\tID             string         `json:\"id\"`\r\n\tExecutionOrder int            `json:\"execution_order\"`\r\n"]
[5446.432101, "o", "\tStatus         string         `json:\"status\"`\r\n\tOutputs        []outputReport `json:\"outputs\"`\r\n\tTimingMs       []int64        `json:\"timing_ms\"`\r\n\tErrorMessage   *string        `json:\"error_message\"`\r\n}\r\n\r\ntype outputReport struct {\r\n\tPath                string   `json:\"path\"`\r\n\tFingerprints        []string `json:\"fingerprints\"`"]
[5446.432378, "o", "\r\n\tReference           *string  `json:\"reference\"`\r\n\tReferenceMatch      *bool    `json:\"reference_match\"`\r\n\tCrossPassConsistent bool     `json:\"cross_pass_consistent\"`\r\n\tVarianceDetail      *string  `json:\"variance_detail\"`\r\n}\r\n\r\ntype hint struct {\r\n\tOutput   string `json:\"output\"`\r\n"]
[5446.432953, "o", "\u001b[?2004h"]
[5446.433058, "o", "root@n30009:/app# "]
[5446.723872, "i", "sed -n '1,140p' cmd/repro-verify/diff.go\n"]
