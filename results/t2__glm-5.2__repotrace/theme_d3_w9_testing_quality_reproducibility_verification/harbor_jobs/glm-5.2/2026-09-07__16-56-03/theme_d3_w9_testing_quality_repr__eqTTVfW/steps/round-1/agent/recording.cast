[1170.49852, "o", "func writeCache(m *Manifest, s Step, root, cacheDir string, outputs map[string]string) {\r\n\u001b[?2004l\r"]
[1170.498586, "o", "\u001b[?2004h> "]
[1170.498899, "o", "cacheStepDir := filepath.Join(cacheDir, s.ID)\r\n\u001b[?2004l\r"]
[1170.498963, "o", "\u001b[?2004h> "]
[1170.499343, "o", "if err := os.MkdirAll(cacheStepDir, 0755); err != nil {\r\n\u001b[?2004l\r"]
[1170.4994, "o", "\u001b[?2004h> "]
[1170.499458, "o", "return\r\n\u001b[?2004l\r"]
[1170.499514, "o", "\u001b[?2004h> }\r\n"]
[1170.499569, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1170.499624, "o", "> "]
[1170.499796, "o", "inputs := map[string]string{}\r\n\u001b[?2004l\r"]
[1170.499851, "o", "\u001b[?2004h> "]
[1170.500074, "o", "for _, in := range s.Inputs {\r\n\u001b[?2004l\r"]
[1170.50013, "o", "\u001b[?2004h> "]
[1170.500287, "o", "p := normalizePath(in)\r\n\u001b[?2004l\r"]
[1170.500349, "o", "\u001b[?2004h> "]
[1170.50045, "o", "if p == \"\" {\r\n\u001b[?2004l\r"]
[1170.500506, "o", "\u001b[?2004h> "]
[1170.500578, "o", "continue\r\n\u001b[?2004l\r"]
[1170.500633, "o", "\u001b[?2004h> }\r\n"]
[1170.500689, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1170.500744, "o", "> "]
[1170.501222, "o", "if fp, err := fingerprintFile(filepath.Join(root, p), m.Verify.Algorithm); err == nil {\r\n\u001b[?2004l\r"]
[1170.501283, "o", "\u001b[?2004h> "]
[1170.501347, "o", "inputs[p] = fp\r\n\u001b[?2004l\r"]
[1170.501402, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1170.501458, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1170.501512, "o", "\u001b[?2004h> "]
[1170.501883, "o", "if data, err := json.MarshalIndent(inputs, \"\", \"  \"); err == nil {\r\n\u001b[?2004l\r"]
[1170.50195, "o", "\u001b[?2004h> "]
[1170.502313, "o", "os.WriteFile(filepath.Join(cacheStepDir, \"inputs.json\"), data, 0644)\r\n\u001b[?2004l\r"]
[1170.502368, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1170.502423, "o", "\u001b[?2004h> "]
[1170.50281, "o", "if data, err := json.MarshalIndent(outputs, \"\", \"  \"); err == nil {\r\n\u001b[?2004l\r"]
[1170.502864, "o", "\u001b[?2004h> "]
[1170.503242, "o", "os.WriteFile(filepath.Join(cacheStepDir, \"outputs.json\"), data, 0644)\r\n\u001b[?2004l\r"]
[1170.5033, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1170.503355, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1170.503412, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
