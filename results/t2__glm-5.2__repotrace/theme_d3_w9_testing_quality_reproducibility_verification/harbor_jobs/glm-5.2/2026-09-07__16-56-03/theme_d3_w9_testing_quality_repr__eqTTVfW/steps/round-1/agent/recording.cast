[2831.816601, "o", "   331\t\r\n   332\tfunc buildEnv(m *Manifest, s Step, workDir string) []string {\r\n   333\t\tenvMap := map[string]string{}\r\n   334\t\tfor _, kv := range os.Environ() {\r\n   335\t\t\tidx := strings.IndexByte(kv, '=')\r\n   336\t\t\tif idx >= 0 {\r\n   337\t\t\t\tenvMap[kv[:idx]] = kv[idx+1:]\r\n   338\t\t\t}\r\n   339\t\t}\r\n   340\t\tset := func(k, v string) { envMap[k] = v }\r\n   341\t\tset(\"LC_ALL\", m.Env.Locale)\r\n   342\t\tset(\"TZ\", m.Env.Timezone)\r\n   343\t\tif m.Env.Seed != nil {\r\n   344\t\t\tset(\"REPRO_SEED\", strconv.Itoa(*m.Env.Seed))\r\n   345\t\t}\r\n   346\t\tif m.Env.NormalizeTimestamps {\r\n   347\t\t\tset(\"SOURCE_DATE_EPOCH\", \"0\")\r\n   348\t\t}\r\n   349\t\tfor k, v := range m.Env.EnvVars {\r\n   350\t\t\tset(k, v)\r\n   351\t\t}\r\n   352\t\tfor k, v := range s.EnvOverrides {\r\n   353\t\t\tset(k, v)\r\n   354\t\t}\r\n   355\t\tif m.Env.NormalizePaths {\r\n   356\t\t\tset(\"PWD\", workDir)\r\n   357\t\t}\r\n   358\t\tfor _, b := range m.Env.BlockedEnvVars {\r\n   359\t\t\tdelete(envMap, b)\r\n   360\t\t}\r\n"]
