[830.923566, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\"encoding/json\"\r\n     5\t\"fmt\"\r\n     6\t\"os\"\r\n"]
[830.923666, "o", "     7\t\"sort\"\r\n     8\t\"strings\"\r\n     9\t)\r\n    10\t\r\n    11\ttype Graph struct {\r\n    12\tnodes []string\r\n    13\tdirect map[string][]string\r\n    14\tdependents map[string][]string\r\n    15\t}\r\n    16\t\r\n    17\tfunc buildGraph(steps []Step) *Graph {\r\n    18\tg := &Graph{direct: map[string][]string{}, dependents: map[string][]string{}}\r\n    19\tfor _, s := range steps {\r\n    20\tg.nodes = append(g.nodes, s.ID)\r\n    21\tg.direct[s.ID] = append([]string{}, s.DependsOn...)\r\n"]
[830.923746, "o", "    22\t}\r\n    23\tsort.Strings(g.nodes)\r\n    24\tfor _, s := range steps {\r\n    25\tfor _, dep := range s.DependsOn {\r\n    26\tg.dependents[dep] = append(g.dependents[dep], s.ID)\r\n    27\t}\r\n    28\t}\r\n    29\treturn g\r\n    30\t}\r\n    31\t\r\n    32\tfunc (g *Graph) deps(id string) []string {\r\n    33\treturn g.direct[id]\r\n    34\t}\r\n    35\t\r\n    36\tfunc shortestCycle(steps []Step) []string {\r\n"]
[830.923813, "o", "    37\tg := buildGraph(steps)\r\n    38\tvar best []string\r\n    39\tfor _, start := range g.nodes {\r\n    40\tstack := []string{start}\r\n    41\tseen := map[string]bool{start: true}\r\n    42\tvar dfs func()\r\n    43\tdfs = func() {\r\n    44\tlast := stack[len(stack)-1]\r\n    45\tdeps := append([]string{}, g.direct[last]...)\r\n    46\tsort.Strings(deps)\r\n    47"]
[830.923896, "o", "\tfor _, dep := range deps {\r\n    48\tif dep == start {\r\n    49\tcyc := append([]string{}, stack...)\r\n    50\tcyc = append(cyc, start)\r\n    51\tif best == nil || len(cyc) < len(best) || (len(cyc) == len(best) && lessCycle(cyc, best)) {\r\n    52\tbest = cyc\r\n    53\t}\r\n    54\treturn\r\n    55\t}\r\n    56\tif !seen[dep] {\r\n    57\tseen[dep] = true\r\n    58\tstack = append(stack, dep)\r\n    59\tdfs()\r\n    60\tstack = stack[:len(stack)-1]\r\n    61\tdelete(seen, dep)\r\n    62"]
[830.924007, "o", "\t}\r\n    63\t}\r\n    64\t}\r\n    65\tdfs()\r\n    66\t}\r\n    67\treturn best\r\n    68\t}\r\n    69\t\r\n    70\tfunc lessCycle(a, b []string) bool {\r\n    71"]
[830.92407, "o", "\tfor i := 0; i < len(a) && i < len(b); i++ {\r\n    72\tif a[i] != b[i] {\r\n    73\treturn a[i] < b[i]\r\n    74\t}\r\n    75\t}\r\n    76\treturn len(a) < len(b)\r\n    77\t}\r\n    78\t\r\n    79\tfunc topologicalOrder(steps []Step) []string {\r\n"]
[830.924125, "o", "    80\tg := buildGraph(steps)\r\n"]
