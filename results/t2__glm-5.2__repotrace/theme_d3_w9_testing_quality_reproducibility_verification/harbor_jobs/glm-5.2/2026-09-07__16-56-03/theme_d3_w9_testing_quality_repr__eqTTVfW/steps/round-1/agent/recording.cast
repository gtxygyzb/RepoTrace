[5898.908081, "o", "    11\t\tManifestName    string       `json:\"manifest_name\"`\r\n    12\t\tManifestVersion string       `json:\"manifest_version\"`\r\n    13\t\tOverallStatus   string       `json:\"overall_status\"`\r\n    14\t\tSteps           []stepReport `json:\"steps\"`\r\n    15\t}\r\n    16\t\r\n    17\ttype summaryReportEntry struct {\r\n    18\t\tFile            string  `json:\"file\"`\r\n    19\t\tManifestName    string  `json:\"manifest_name\"`\r\n    20\t\tManifestVersion string  `json:\"manifest_version\"`\r\n    21\t\tOverallStatus   string  `json:\"overall_status\"`\r\n    22\t"]
[5898.908157, "o", "\tStepCount       int     `json:\"step_count\"`\r\n    23\t\tPassCount       int     `json:\"pass_count\"`\r\n    24\t\tFailCount       int     `json:\"fail_count\"`\r\n    25\t\tPassRate        float64 `json:\"pass_rate\"`\r\n    26\t}\r\n    27\t\r\n    28\ttype summaryAggregate struct {\r\n    29\t\tTotalReports    int     `json:\"total_reports\"`\r\n    30\t\tTotalSteps      int     `json:\"total_steps\"`\r\n    31\t\tTotalPass       int     `json:\"total_pass\"`\r\n    32\t\tTotalFail       int     `json:\"total_fail\"`\r\n"]
