[2720.618964, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"os\"\r\n"]
[2720.619059, "o", "     6\t)\r\n     7\t\r\n     8\tfunc main() {\r\n     9\t\tif len(os.Args) < 2 {\r\n    10\t\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify <verify|fingerprint|graph> ...\")\r\n    11\t\t\tos.Exit(2)\r\n    12\t\t}\r\n    13\t\tswitch os.Args[1] {\r\n    14\t\tcase \"verify\":\r\n    15\t\t\tverifyCmd(os.Args[2:])\r\n    16\t\tcase \"fingerprint\":\r\n    17\t\t\tfingerprintCmd(os.Args[2:])\r\n    18\t\tcase \"graph\":\r\n    19\t\t\tgraphCmd(os.Args[2:])\r\n    20\t\tdefault:\r\n    21\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown subcommand %q\\n\", os.Args[1])\r\n"]
[2720.619136, "o", "    22\t\t\tos.Exit(2)\r\n    23\t\t}\r\n    24\t}\r\n"]
