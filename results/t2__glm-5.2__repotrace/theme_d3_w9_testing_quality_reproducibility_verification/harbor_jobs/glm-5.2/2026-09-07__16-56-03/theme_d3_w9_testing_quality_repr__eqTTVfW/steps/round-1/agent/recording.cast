[3796.30089, "o", "\t\"sort\"\r\n     8\t)\r\n     9\t\r\n    10\ttype Policy struct {\r\n    11\t\tDefaultAction string       `json:\"default_action\"`\r\n    12\t\tRules         []PolicyRule `json:\"rules\"`\r\n    13\t}\r\n    14\t\r\n    15\ttype PolicyRule struct {\r\n    16\t\tID     string                 `json:\"id\"`\r\n    17\t\tType   string                 `json:\"type\"`\r\n    18\t\tParams map[string]interface{} `json:\"params\"`\r\n    19\t\tAction string                 `json:\"action\"`\r\n    20\t}\r\n    21\t\r\n    22\t"]
[3796.30095, "o", "type policyEvaluation struct {\r\n    23\t\tPolicyOverallStatus   string            `json:\"policy_overall_status\"`\r\n    24\t\tDefaultAction         string            `json:\"default_action\"`\r\n    25\t\tRulesEvaluated        []policyRuleEval  `json:\"rules_evaluated\"`\r\n    26\t\tEffectiveStepStatuses map[string]string `json:\"effective_step_statuses\"`"]
[3796.301121, "o", "\r\n    27\t\tWarnings              []string          `json:\"warnings\"`\r\n    28\t}\r\n    29\t\r\n    30\ttype policyRuleEval struct {\r\n    31\t\tRuleID         string   `json:\"rule_id\"`\r\n    32\t\tRuleType       string   `json:\"rule_type\"`\r\n    33\t\tMatchedSteps   []string `json:\"matched_steps\"`\r\n    34\t\tMatchedOutputs []string `json:\"matched_outputs\"`\r\n    35\t\tAction         string   `json:\"action\"`\r\n    36\t\tEffect         string   `json:\"effect\"`\r\n    37\t\tDetails        string   `json:\"details\"`\r\n    38\t}\r\n    39\t\r\n    40\tvar policyRuleIDRe = regexp.MustCompile(`^[a-z][a-z0-9_-]{0,63}$`)\r\n    41\t\r\n    42\tfunc validatePolicy(p *Policy, stepIDs map[string]bool) error {\r\n    43\t\tif p == nil {\r\n    44\t\t\treturn nil\r\n    45\t\t}\r\n    46\t\tif p.DefaultAction == \"\" {\r\n    47\t\t\tp.DefaultAction = \"strict\"\r\n    48\t\t}\r\n    49\t\tswitch p.DefaultAction {\r\n"]
[3796.301193, "o", "    50\t\tcase \"strict\", \"lenient\":\r\n    51\t\tdefault:\r\n    52\t\t\treturn fmt.Errorf(\"invalid default_action: %q (must be \\\"strict\\\" or \\\"lenient\\\")\", p.DefaultAction)\r\n    53\t\t}\r\n    54\t\tif p.Rules == nil {\r\n    55\t\t\tp.Rules = []PolicyRule{}\r\n    56\t\t}\r\n    57"]
[3796.301256, "o", "\t\r\n    58\t\tseenRuleIDs := map[string]bool{}\r\n    59\t\tfor _, rule := range p.Rules {\r\n    60\t\t\tif !policyRuleIDRe.MatchString(rule.ID) {\r\n    61\t\t\t\treturn fmt.Errorf(\"invalid policy rule id: %q (must match ^[a-z][a-z0-9_-]{0,63}$)\", rule.ID)\r\n    62\t\t\t}\r\n    63\t\t\tif seenRuleIDs[rule.ID] {\r\n    64\t\t\t\treturn fmt.Errorf(\"duplicate policy rule id: %q\", rule.ID)\r\n    65\t\t\t}\r\n    66\t\t\tseenRuleIDs[rule.ID] = true\r\n    67\t\r\n    68\t\t\tswitch rule.Action {\r\n    69\t\t\tcase \"allow\", \"warn\", \"require\":\r\n    70\t\t\tdefault:\r\n"]
[3796.301325, "o", "    71\t\t\t\treturn fmt.Errorf(\"invalid policy action: %q (must be \\\"allow\\\", \\\"warn\\\", or \\\"require\\\")\", rule.Action)\r\n    72\t\t\t}\r\n    73\t\r\n    74\t\t\tswitch rule.Type {\r\n"]
[3796.301388, "o", "    75\t\t\tcase \"allow_variance\":\r\n    76\t\t\t\tif _, err := policyStringParam(rule, \"output_pattern\"); err != nil {\r\n    77\t\t\t\t\treturn err\r\n    78\t\t\t\t}\r\n    79\t\t\tcase \"min_consistency_rate\":\r\n    80\t\t\t\tif _, err := policyStringParam(rule, \"step_pattern\"); err != nil {\r\n    81\t\t\t\t\treturn err\r\n    82\t\t\t\t}\r\n    83\t\t\t\trate, err := policyFloatParam(rule, \"rate\")\r\n    84\t\t\t\tif err != nil {\r\n    85\t\t\t\t\treturn err\r\n    86\t\t\t\t}\r\n    87\t\t\t\tif rate < 0.0 || rate > 1.0 {\r\n    88\t\t\t\t\treturn fmt.Errorf(\"invalid min_consistency_rate: rate must be between 0.0 and 1.0\")\r\n    89\t\t\t"]
[3796.301445, "o", "\t}\r\n    90\t\t\tcase \"required_steps\":\r\n    91\t\t\t\tsteps, err := policyStringSliceParam(rule, \"steps\")\r\n    92\t\t\t\tif err != nil {\r\n    93\t\t\t\t\treturn err\r\n    94\t\t\t\t}\r\n    95\t\t\t\tfor _, stepID := range steps {\r\n    96\t\t\t\t\tif !stepIDs[stepID] {\r\n    97\t\t\t\t\t\t"]
[3796.30151, "o", "return fmt.Errorf(\"unknown step in policy rule %q: %q\", rule.ID, stepID)\r\n    98\t\t\t\t\t}\r\n    99\t\t\t\t}\r\n   100\t\t\tcase \"ignore_steps\":\r\n   101\t\t\t\tsteps, err := policyStringSliceParam(rule, \"steps\")\r\n   102\t\t\t\tif err != nil {\r\n   103\t\t\t\t\treturn err\r\n   104\t\t\t\t}\r\n   105\t\t\t\tfor _, stepID := range steps {\r\n   106"]
[3796.301568, "o", "\t\t\t\t\tif !stepIDs[stepID] {\r\n   107\t\t\t\t\t\treturn fmt.Errorf(\"unknown step in policy rule %q: %q\", rule.ID, stepID)\r\n   108\t\t\t\t\t}\r\n   109\t\t\t\t}\r\n   110\t\t\tdefault:\r\n   111\t\t\t\treturn fmt.Errorf(\"unknown policy rule type: %q\", rule.Type)\r\n   112\t\t\t}\r\n"]
[3796.301637, "o", "   113\t\t}\r\n   114\t\treturn nil\r\n   115\t}\r\n   116\t\r\n   117\tfunc policyStringParam(rule PolicyRule, name string) (string, error) {\r\n"]
[3796.301701, "o", "   118\t\tv, ok := rule.Params[name]\r\n   119\t\tif !ok {\r\n   120\t\t\treturn \"\", fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n   121\t\t}\r\n   122\t\ts, ok := v.(string)\r\n   123\t\tif !ok {\r\n   124\t\t\treturn \"\", fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n   125\t\t}\r\n   126\t\treturn s, nil\r\n   127\t}\r\n   128\t\r\n"]
[3796.30176, "o", "   129\tfunc policyFloatParam(rule PolicyRule, name string) (float64, error) {\r\n   130\t\tv, ok := rule.Params[name]\r\n   131\t\tif !ok {\r\n   132\t\t\treturn 0, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n   133\t\t}\r\n   134\t\tf, ok := v.(float64)\r\n   135\t\tif !ok {\r\n   136\t\t\treturn 0, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n   137\t\t}\r\n   138\t\treturn f, nil\r\n   139\t"]
[3796.301819, "o", "}\r\n   140\t\r\n   141\tfunc policyStringSliceParam(rule PolicyRule, name string) ([]string, error) {\r\n   142\t\tv, ok := rule.Params[name]\r\n   143\t\tif !ok {\r\n   144\t\t\treturn nil, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n   145\t\t}\r\n   146\t\tarr, ok := v.([]interface{})\r\n"]
[3796.301885, "o", "   147\t\tif !ok {\r\n   148\t\t\treturn nil, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n   149\t\t}\r\n   150\t\tout := make([]string, 0, len(arr))\r\n   151\t\tfor _, item := range arr {\r\n   152\t\t\ts, ok := item.(string)\r\n   153\t\t\tif !ok {\r\n   154\t\t\t\treturn nil, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n   155\t\t\t}\r\n   156\t\t\tout = append(out, s)\r\n   157\t\t}\r\n   158\t\treturn out, nil\r\n"]
[3796.301957, "o", "   159\t}\r\n   160\t\r\n   161\tfunc evaluatePolicy(m *Manifest, rep *report) *policyEvaluation {\r\n   162\t\tp := m.Policy\r\n   163\t\tif p == nil {\r\n   164\t\t\treturn nil\r\n   165\t\t}\r\n   166\t\tdefaultAction := p.DefaultAction\r\n   167\t\tif defaultAction == \"\" {\r\n"]
[3796.302014, "o", "   168\t\t\tdefaultAction = \"strict\"\r\n   169\t\t}\r\n   170\t\r\n   171\t\tstepByID := map[string]Step{}\r\n   172\t\tfor _, s := range m.Steps {\r\n   173\t\t\tstepByID[s.ID] = s\r\n   174\t\t}\r\n"]
[3796.302075, "o", "   175\t\r\n   176\t\trawStatus := map[string]string{}\r\n   177\t\tfor _, sr := range rep.Steps {\r\n   178\t\t\trawStatus[sr.ID] = sr.Status\r\n   179\t\t}\r\n   180\t\r\n   181\t\ttype outputState struct {\r\n   182\t\t\tbad       bool\r\n   183\t\t\teffective bool\r\n"]
[3796.302133, "o", "   184\t\t\tmatched   bool\r\n   185\t\t}\r\n   186\t\toutputs := map[string]map[string]*outputState{}\r\n   187\t\tfor _, sr := range rep.Steps {\r\n   188\t\t\tfor _, o := range sr.Outputs {\r\n   189\t\t\t\tif outputs[sr.ID] == nil {\r\n   190\t\t\t\t\toutputs[sr.ID] = map[string]*outputState{}\r\n"]
[3796.302196, "o", "   191\t\t\t\t}\r\n   192\t\t\t\tbad := !o.CrossPassConsistent || (o.ReferenceMatch != nil && !*o.ReferenceMatch)\r\n   193\t\t\t\toutputs[sr.ID][o.Path] = &outputState{\r\n   194\t\t\t\t\tbad:       bad,\r\n   195\t\t\t\t\teffective: !bad,\r\n   196\t\t\t\t}\r\n   197\t\t\t}\r\n   198\t\t}\r\n   199"]
