[2667.151354, "o", "    61\t\t\tReferenceMismatches int `json:\"reference_mismatches\"`\r\n    62\t\t\tStepsPassed         int `json:\"steps_passed\"`\r\n    63\t\t\tStepsFailed         int `json:\"steps_failed\"`\r\n    64\t\t\tStepsError          int `json:\"steps_error\"`\r\n    65\t\t\tStepsSkipped        int `json:\"steps_skipped\"`\r\n    66\t\t\tStepsTimeout        int `json:\"steps_timeout\"`\r\n    67\t\t} `json:\"summary\"`\r\n    68\t}\r\n    69\t\r\n    70\ttype stepReport struct {\r\n    71\t\tID             string         `json:\"id\"`\r\n    72\t\tExecutionOrder int            `json:\"execution_order\"`\r\n"]
