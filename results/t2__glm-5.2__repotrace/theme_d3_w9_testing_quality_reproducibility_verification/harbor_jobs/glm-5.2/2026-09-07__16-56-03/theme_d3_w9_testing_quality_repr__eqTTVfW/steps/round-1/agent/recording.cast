[6527.194708, "o", "    28\t\tdefault:\r\n    29\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown subcommand %q\\n\", os.Args[1])\r\n    30\t\t\tos.Exit(2)\r\n    31\t\t}\r\n    32\t}\r\n"]
