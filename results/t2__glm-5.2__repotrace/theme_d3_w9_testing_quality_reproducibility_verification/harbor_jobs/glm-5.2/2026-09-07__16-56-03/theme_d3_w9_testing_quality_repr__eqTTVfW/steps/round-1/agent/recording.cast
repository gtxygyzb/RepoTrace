[3422.545717, "i", "s\n}\n\nfunc equalStrings(a, b []string) bool {\n\tif len(a) != len(b) {\n\t\treturn false\n\t}\n\tfor i := range a {\n\t\tif a[i] != b[i] {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc boolPtrEqual(a, b *bool) bool {\n\tif a == nil && b == nil {\n\t\treturn true\n\t}\n\tif a == nil || b == nil {\n\t\treturn false\n\t}\n\treturn *a == *b\n}\n\nfunc stringPtrEqual(a, b *string) bool {\n\tif a == nil && b == nil {\n\t\treturn true\n\t}\n\tif a == nil || b == nil {\n\t\treturn false\n\t}\n\treturn *a == *b\n}\n\nfunc printDiffText(d *diffReport) {\n\tfmt.Println(\"Verification Report Diff\")\n\tfmt.Println(\"========================\")\n\tfmt.Printf(\"Baseline: %s@%s (%s) at %s\\n\", d.Baseline.ManifestName, d.Baseline.ManifestVersion, d.Baseline.OverallStatus, d.Baseline.Timestamp)\n\tfmt.Printf(\"Current:  %s@%s (%s) at %s\\n\", d.Current.ManifestName, d.Current.ManifestVersion, d.Current.OverallStatus, d.Current.Timestamp)\n\tfmt.Printf(\"Overall:  %s → %s [%s]\\n\", d.StatusTransition.From, d.StatusTransition.To, d.StatusTransition.Type)\n\tfmt.Println()\n\tfmt.Println(\"Step Changes:\")"]
