[847.519503, "i", "cat > cmd/repro-verify/fingerprint.go <<'EOF'\npackage main\n\nimport (\n\t\"crypto/sha256\"\n\t\"crypto/sha512\"\n\t\"encoding/hex\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n)\n\nfunc fingerprintFile(path, algorithm string) (string, error) {\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer f.Close()\n\tvar sum []byte\n\tswitch algorithm {\n\tcase \"sha256\":\n\t\th := sha256.New()\n\t\tif _, err := io.Copy(h, f); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tsum = h.Sum(nil)\n\tcase \"blake2b\":\n\t\th := sha512.New()\n\t\tif _, err := io.Copy(h, f); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tsum = h.Sum(nil)[:32]\n\tdefault:\n\t\treturn \"\", fmt.Errorf(\"invalid algorithm: %q\", algorithm)\n\t}\n\treturn algorithm + \":\" + hex.EncodeToString(sum), nil\n}\n\nfunc fingerprintCmd(args []string) {\n\tfs := flag.NewFlagSet(\"fingerprint\", flag.ExitOnError)\n\talgorithm := fs.String(\"algorithm\", \"sha256\", \"algorithm\")\n\tfs.Parse(args)\n\tif fs.NArg() < 1 {\n\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify fingerprint <file> [--algorithm sha256|blake2b]\")\n\t\tos.Exit(2)\n\t}\n\tif *algorithm != "]
[847.519757, "i", "\"sha256\" && *algorithm != \"blake2b\" {\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid algorithm: %q (must be \\\"sha256\\\" or \\\"blake2b\\\")\\n\", *algorithm)\n\t\tos.Exit(2)\n\t}\n\tfp, err := fingerprintFile(fs.Arg(0), *algorithm)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\tfmt.Fprintf(os.Stderr, \"error: file not found: %s\\n\", fs.Arg(0))\n\t\t} else {\n\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\n\t\t}\n\t\tos.Exit(2)\n\t}\n\tfmt.Println(fp)\n}\nEOF\n"]
