[5907.586098, "o", "   128\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n   129\t\t}\r\n   130\t\tfor _, field := range []string{\"manifest_name\", \"overall_status\", \"steps\"} {\r\n   131\t\t\tif _, ok := raw[field]; !ok {\r\n   132\t\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: missing field %s\", path, field)\r\n   133\t\t\t}\r\n   134\t\t}\r\n   135\t\tvar r diffReportLite\r\n   136\t\tif err := json.Unmarshal(data, &r); err != nil {\r\n   137\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n   138\t\t}\r\n   139\t\tif r.ManifestName == \"\" {\r\n   140\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: missing field manifest_name\", path)\r\n   141\t\t}\r\n"]
