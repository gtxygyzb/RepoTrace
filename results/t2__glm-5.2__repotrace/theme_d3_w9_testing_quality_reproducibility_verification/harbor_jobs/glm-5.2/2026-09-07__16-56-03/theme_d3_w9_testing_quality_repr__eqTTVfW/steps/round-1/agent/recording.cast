[3250.971675, "i", "fectiveStepStatuses: effectiveStepStatuses,\n\t\tWarnings:              warnings,\n\t}\n}\n\nfunc majorityRate(fps []string) float64 {\n\tif len(fps) == 0 {\n\t\treturn 0\n\t}\n\tcounts := map[string]int{}\n\tfor _, fp := range fps {\n\t\tcounts[fp]++\n\t}\n\tmax := 0\n\tfor _, c := range counts {\n\t\tif c > max {\n\t\t\tmax = c\n\t\t}\n\t}\n\treturn float64(max) / float64(len(fps))\n}\n\nfunc appendUnique(slice []string, value string) []string {\n\tfor _, v := range slice {\n\t\tif v == value {\n\t\t\treturn slice\n\t\t}\n\t}\n\treturn append(slice, value)\n}\n\nfunc boolPtr(b bool) *bool {\n\treturn &b\n}\n\nfunc stringSlicePtr(s []string) *[]string {\n\tif s == nil {\n\t\treturn nil\n\t}\n\treturn &s\n}\nEOF\n"]
