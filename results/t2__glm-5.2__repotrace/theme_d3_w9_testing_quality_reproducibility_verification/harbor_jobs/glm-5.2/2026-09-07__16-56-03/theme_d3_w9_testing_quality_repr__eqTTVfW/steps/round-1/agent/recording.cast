[5480.983021, "o", "\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tID             string         `json:\"id\"`\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tExecutionOrder int            `json:\"execution_order\"`\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tStatus         string         `json:\"status\"`\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tOutputs        []outputReport `json:\"outputs\"`\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tTimingMs       []int64        `json:\"timing_ms\"`\r\n\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tErrorMessage   *string        `json:\"error_message\"`\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Ktype outputReport struct {\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tPath                string   `json:\"path\"`\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tFingerprints        []string `json:\"fingerprints\"`\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tReference           *string  `json:\"reference\"`\r\n"]
