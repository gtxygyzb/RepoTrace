[5907.861047, "o", "   310\t\t\tcase hasC && !hasB:\r\n   311\t\t\t\toc.ChangeType = \"added\"\r\n   312\t\t\t\tchanged = true\r\n   313\t\t\tcase hasB && !hasC:\r\n   314\t\t\t\toc.ChangeType = \"removed\"\r\n   315\t\t\t\tchanged = true\r\n   316\t\t\tcase !equalStrings(bo.Fingerprints, co.Fingerprints):\r\n   317"]
[5907.861111, "o", "\t\t\t\toc.ChangeType = \"fingerprint_changed\"\r\n   318\t\t\t\tchanged = true\r\n   319\t\t\tcase bo.CrossPassConsistent != co.CrossPassConsistent:\r\n   320\t\t\t\toc.ChangeType = \"consistency_changed\"\r\n   321\t\t\t\tchanged = true\r\n   322\t\t\tcase !boolPtrEqual(bo.ReferenceMatch, co.ReferenceMatch):\r\n   323\t\t\t\toc.ChangeType = \"reference_changed\"\r\n   324\t\t\t\tchanged = true\r\n   325\t\t\tdefault:\r\n   326\t\t\t\toc.ChangeType = \"unchanged\"\r\n   327\t\t\t}\r\n   328\t\t\tchanges = append(changes, oc)\r\n   329\t\t}\r\n   330\t"]
[5907.861168, "o", "\r\n   331\t\treturn changes, changed\r\n   332\t}\r\n   333\t\r\n"]
[5907.861224, "o", "   334\tfunc stepEqual(b, c stepReport) bool {\r\n   335\t\tif b.Status != c.Status || b.ExecutionOrder != c.ExecutionOrder || b.ErrorMessage != c.ErrorMessage {\r\n   336\t\t\treturn false\r\n   337\t\t}\r\n   338\t\tif !equalInt64(b.TimingMs, c.TimingMs) {\r\n   339\t\t\treturn false\r\n   340\t\t}\r\n   341\t\tif len(b.Outputs) != len(c.Outputs) {\r\n   342\t\t\treturn false\r\n"]
[5907.861282, "o", "   343\t\t}\r\n   344\t\tfor i := range b.Outputs {\r\n   345\t\t\tif !outputEqual(b.Outputs[i], c.Outputs[i]) {\r\n   346\t\t\t\treturn false\r\n   347\t\t\t}\r\n   348\t\t}\r\n   349\t\treturn true\r\n   350\t}\r\n"]
[5907.861336, "o", "   351\t\r\n   352\tfunc outputEqual(b, c outputReport) bool {\r\n   353\t\tif b.Path != c.Path {\r\n   354\t\t\treturn false\r\n   355\t\t}\r\n   356\t\tif !equalStrings(b.Fingerprints, c.Fingerprints) {\r\n   357\t\t\treturn false\r\n   358\t\t}\r\n"]
[5907.861392, "o", "   359\t\tif b.CrossPassConsistent != c.CrossPassConsistent {\r\n   360\t\t\treturn false\r\n"]
