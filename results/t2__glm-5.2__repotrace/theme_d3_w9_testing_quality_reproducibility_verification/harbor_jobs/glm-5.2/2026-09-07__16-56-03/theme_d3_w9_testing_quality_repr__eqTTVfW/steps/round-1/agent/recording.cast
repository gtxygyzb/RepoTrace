[6630.807339, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"os\"\r\n     6\t)\r\n     7\t\r\n     8\tfunc main() {\r\n     9\t\tif len(os.Args) < 2 {\r\n"]
[6630.807453, "o", "    10\t\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify <verify|fingerprint|graph|diff|summary|trend|slice|export> ...\")\r\n    11\t\t\tos.Exit(2)\r\n    12\t\t}\r\n    13\t\tswitch os.Args[1] {\r\n    14\t\tcase \"verify\":\r\n    15\t\t\tverifyCmd(os.Args[2:])\r\n    16\t\tcase \"fingerprint\":\r\n    17\t\t\tfingerprintCmd(os.Args[2:])\r\n    18\t\tcase \"graph\":\r\n    19\t\t\tgraphCmd(os.Args[2:])\r\n    20\t\tcase \"diff\":\r\n    21\t\t\tdiffCmd(os.Args[2:])\r\n    22\t\tcase \"summary\":\r\n    23\t\t\tsummaryCmd(os.Args[2:])\r\n    24\t\tcase \"trend\":\r\n    25\t\t\ttrendCmd(os.Args[2:])\r\n    26\t\tcase \"slice\":\r\n"]
[6630.807529, "o", "    27\t\t\tsliceCmd(os.Args[2:])\r\n    28\t\tcase \"export\":\r\n    29\t\t\texportCmd(os.Args[2:])\r\n    30\t\tdefault:\r\n    31\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown subcommand %q\\n\", os.Args[1])\r\n    32\t\t\tos.Exit(2)\r\n    33\t\t}\r\n    34\t}\r\n"]
[6630.808074, "o", "\u001b[?2004h"]
[6630.808133, "o", "root@n30009:/app# "]
