[5457.551634, "o", "\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K diffCmd(args []string) {\r\n"]
[5457.551698, "o", "\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K loadDiffReport(path, role string) (*diffReportLite, error) {\r\n\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K buildDiffReport(baseline, current *diffReportLite) *diffReport {\r\n\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K diffStepOutputs(b, c stepReport) ([]diffOutputChange, bool) {\r\n"]
