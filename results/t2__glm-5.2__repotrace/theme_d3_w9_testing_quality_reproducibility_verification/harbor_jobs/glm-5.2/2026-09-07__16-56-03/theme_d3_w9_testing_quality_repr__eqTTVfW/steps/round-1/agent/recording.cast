[5898.278164, "o", "\t\tclassification := classifyTrendStep(statusChanges, firstStatus, lastStatus)\r\n   190\t\t\tswitch classification {\r\n   191\t\t\tcase \"stable\":\r\n   192\t\t\t\tstableCount++\r\n   193\t\t\tcase \"flaky\":\r\n   194\t\t\t\tflakyCount++\r\n   195\t\t\tcase \"degrading\":\r\n   196"]
