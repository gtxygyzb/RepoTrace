[5907.043093, "o", "    90\t\t\t}\r\n    91\t\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: %s\", path, err)\r\n    92\t\t}\r\n    93\t\r\n    94\t\tdata, err := os.ReadFile(path)\r\n    95\t\tif err != nil {\r\n    96\t\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: %s\", path, err)\r\n    97\t\t}\r\n    98\t\r\n    99\t\tvar raw map[string]json.RawMessage\r\n   100\t\tif err := json.Unmarshal(data, &raw); err != nil {\r\n   101\t\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: %s\", path, err)\r\n   102\t\t}\r\n   103\t"]
