[5367.288441, "o", "\tBaseline            diffReportMeta       `json:\"baseline\"`\r\n\tCurrent             diffReportMeta       `json:\"current\"`\r\n\tComparisonTimestamp string               `json:\"comparison_timestamp\"`\r\n\tStatusTransition    diffStatusTransition `json:\"status_transition\"`\r\n\tStepChanges         []diffStepChange     `json:\"step_changes\"`\r\n\tSummary             diffSummary          `json:\"summary\"`\r\n}\r\n\r\ntype diffReportMeta struct {\r\n\tManifestName    string `json:\"manifest_name\"`\r\n\tManifestVersion string `json:\"manifest_version\"`\r\n\tOverallStatus   string `json:\"overall_status\"`\r\n\tTimestamp       string `json:\"timestamp\"`\r\n}\r\n\r\ntype diffStatusTransition struct {\r\n\tFrom string `json:\"from\"`\r\n\tTo   string `json:\"to\"`\r\n\tType string `json:\"type\"`\r\n}\r\n\r\ntype diffStepChange struct {\r\n\tStepID           string             `json:\"step_id\"`\r\n\tChangeType       string             `json:\"change_type\"`\r\n\tBaselineStatus   *string            `json:\"baseline_status\"`\r\n\tCurrentStatus    *string            `json:\"current_status\"`\r\n\tStatusTran"]
[5367.28854, "o", "sition *string            `json:\"status_transition\"`\r\n\tOutputChanges    []diffOutputChange `json:\"output_changes\"`\r\n}\r\n\r\ntype diffOutputChange struct {\r\n\tPath       string           `json:\"path\"`\r\n\tChangeType string           `json:\"change_type\"`\r\n\tDetails    diffOutputDetail `json:\"details\"`\r\n}\r\n\r\ntype diffOutputDetail struct {\r\n\tBaselineFingerprints   []string `json:\"baseline_fingerprints\"`\r\n"]
[5367.28865, "o", "\tCurrentFingerprints    []string `json:\"current_fingerprints\"`\r\n\tBaselineConsistent     *bool    `json:\"baseline_consistent\"`\r\n\tCurrentConsistent      *bool    `json:\"current_consistent\"`\r\n\tBaselineReferenceMatch *bool    `json:\"baseline_reference_match\"`\r\n\tCurrentReferenceMatch  *bool    `json:\"current_reference_match\"`\r\n}\r\n\r\ntype diffSummary struct {\r\n\tStepsAdded         int `json:\"steps_added\"`\r\n\tStepsRemoved       int `json:\"steps_removed\"`\r\n\tStepsModified      int `json:\"steps_modified\"`\r\n\tStepsUnchanged     int `json:\"steps_unchanged\"`\r\n\tRegressions        int `json:\"regressions\"`\r\n\tImprovements       int `json:\"improvements\"`\r\n\tTotalOutputChanges int `json:\"total_output_changes\"`\r\n}\r\n\r\ntype diffReportLite struct {\r\n\tManifestName    string       `json:\"manifest_name\"`\r\n\tManifestVersion string       `json:\"manifest_version\"`\r\n\tOverallStatus   string       `json:\"overall_status\"`\r\n\tTimestamp       string       `json:\"timestamp\"`\r\n\tSteps           []stepReport `json:\"steps\"`\r\n}\r\n\r\nfunc diffCmd(args []strin"]
[5367.288728, "o", "g) {\r\n\tformat := \"json\"\r\n\tpositional := parseFlags(args, map[string]*string{\r\n\t\t\"format\": &format,\r\n\t})\r\n\tif len(positional) != 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify diff <baseline.json> <current.json> [--format json|text]\")\r\n\t\tos.Exit(2)"]
[5367.288793, "o", "\r\n\t}\r\n\r\n\tbaseline, err := loadDiffReport(positional[0], \"baseline\")\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(2)\r\n\t}\r\n\tcurrent, err := loadDiffReport(positional[1], \"current\")\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(2)\r\n"]
[5367.288857, "o", "\t}\r\n\r\n\tdiff := buildDiffReport(baseline, current)\r\n\r\n\tif format == \"text\" {\r\n\t\tprintDiffText(diff)\r\n\t} else {\r\n\t\tout, err := json.MarshalIndent(diff, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n"]
[5367.288922, "o", "\t\t\tos.Exit(2)\r\n\t\t}\r\n\t\tfmt.Println(string(out))\r\n\t}\r\n\r\n\tif diff.Summary.Regressions > 0 {\r\n\t\tos.Exit(1)\r\n\t}\r\n\tos.Exit(0)\r\n}\r\n\r\nfunc loadDiffReport(path, role string) (*diffReportLite, error) {\r\n\tif _, err := os.Stat(path); err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n"]
[5367.289043, "o", "\t\t\treturn nil, fmt.Errorf(\"error: diff %s not found: %s\", role, path)\r\n\t\t}\r\n\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n\t}\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n\t}\r\n\tvar raw map[string]json.RawMessage\r\n\tif err := json.Unmarshal(data, &raw); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n\t}\r\n\tfor _, field := range []string{\"manifest_name\", \"overall_status\", \"steps\"} {\r\n\t\tif _, ok := raw[field]; !ok {\r\n\t\t"]
[5367.289115, "o", "\treturn nil, fmt.Errorf(\"error: invalid report: %s: missing field %s\", path, field)\r\n\t\t}\r\n\t}\r\n\tvar r diffReportLite\r\n\tif err := json.Unmarshal(data, &r); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n\t}\r\n\tif r.ManifestName == \"\" {\r\n\t\t"]
[5367.289182, "o", "return nil, fmt.Errorf(\"error: invalid report: %s: missing field manifest_name\", path)\r\n\t}\r\n\tif r.OverallStatus == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: missing field overall_status\", path)\r\n\t}\r\n\tif r.Steps == nil {\r\n\t\tr.Steps = []stepReport{}\r\n\t}\r\n\treturn &r, nil\r\n"]
[5367.289252, "o", "}\r\n\r\nfunc buildDiffReport(baseline, current *diffReportLite) *diffReport {\r\n\tbaselineSteps := map[string]stepReport{}\r\n\tfor _, s := range baseline.Steps {\r\n\t\tbaselineSteps[s.ID] = s\r\n\t}\r\n\tcurrentSteps := map[string]stepReport{}\r\n\tfor _, s := range current.Steps {\r\n\t\tcurrentSteps[s.ID] = s\r\n\t}\r\n"]
[5367.289345, "o", "\r\n\tstepIDs := map[string]bool{}\r\n\tfor id := range baselineSteps {\r\n\t\tstepIDs[id] = true\r\n\t}\r\n\tfor id := range currentSteps {\r\n\t\tstepIDs[id] = true\r\n"]
[5367.289414, "o", "\t}\r\n\r\n\tids := make([]string, 0, len(stepIDs))\r\n\tfor id := range stepIDs {\r\n\t\tids = append(ids, id)\r\n\t}\r\n\tsort.Strings(ids)\r\n\r\n\tchanges := make([]diffStepChange, 0, len(ids))\r\n\tsummary := diffSummary{}\r\n\r\n"]
[5367.289486, "o", "\tfor _, id := range ids {\r\n\t\tb, hasB := baselineSteps[id]\r\n\t\tc, hasC := currentSteps[id]\r\n\r\n\t\tchange := diffStepChange{\r\n\t\t\tStepID: id,\r\n\t\t}\r\n\t\tif hasB {\r\n\t\t\tbs := b.Status\r\n\t\t\tchange.BaselineStatus = &bs\r\n\t\t}\r\n\t\tif hasC {\r\n\t\t\tcs := c.Status\r\n\t\t\tchange.CurrentStatus = &cs\r\n"]
[5367.28956, "o", "\t\t}\r\n\r\n\t\tswitch {\r\n\t\tcase hasC && !hasB:\r\n\t\t\tchange.ChangeType = \"added\"\r\n\t\t\tsummary.StepsAdded++\r\n\t\t\tsummary.TotalOutputChanges += len(c.Outputs)\r\n\t\tcase hasB && !hasC:\r\n\t\t\tchange.ChangeType = \"removed\"\r\n\t\t\tsummary.StepsRemoved++\r\n\t\t\tsummary.TotalOutputChanges += len(b.Outputs)\r\n"]
[5367.289634, "o", "\t\tdefault:\r\n\t\t\toutputChanges, outputChanged := diffStepOutputs(b, c)\r\n\t\t\tchange.OutputChanges = outputChanges\r\n\t\t\tif outputChanged || !stepEqual(b, c) {\r\n\t\t\t\tchange.ChangeType = \"modified\"\r\n\t\t\t\tsummary.StepsModified++\r\n\t\t\t} else {\r\n\t\t\t\tchange.ChangeType = \"unchanged\"\r\n\t\t\t\tsummary.StepsUnchanged++\r\n\t\t\t\t"]
[5367.289703, "o", "change.OutputChanges = []diffOutputChange{}\r\n\t\t\t}\r\n\t\t\tfor _, oc := range outputChanges {\r\n\t\t\t\tif oc.ChangeType != \"unchanged\" {\r\n\t\t\t\t\tsummary.TotalOutputChanges++\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n"]
