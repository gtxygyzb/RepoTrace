[2667.445011, "o", "nl -ba cmd/repro-verify/manifest.go | sed -n '1,260p'\r\n\u001b[?2004l\r"]
[2667.448621, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n"]
[2667.448779, "o", "     7\t\t\"regexp\"\r\n     8\t\t\"strings\"\r\n     9\t)\r\n    10\t\r\n    11\tvar nameRe = regexp.MustCompile(`^[a-z][a-z0-9_-]{0,63}$`)\r\n    12\t\r\n    13\ttype Manifest struct {\r\n    14\t\tName    string            `json:\"name\"`\r\n    15\t\tVersion string            `json:\"version\"`\r\n    16\t\tVerify  VerifyConfig      `json:\"verification\"`\r\n    17\t\tEnv     EnvironmentConfig `json:\"environment\"`\r\n    18\t\tSteps   []Step            `json:\"steps\"`\r\n    19\t\tRefs    map[string]string `json:\"references\"`\r\n    20\t}\r\n    21\t\r\n    22\ttype VerifyConfig struct {\r\n    23\t\tPasses    int    `json:\"passes\"`\r\n    24\t\tAlgorithm string `json:\"algorithm\"`\r\n    25\t\tMode      string `json:\"mode\"`\r\n    26\t}\r\n    27\t\r\n    28\ttype EnvironmentConfig struct {\r\n    29\t\tLocale              string            `json:\"locale\"`\r\n    30\t\tTimezone            string            `json:\"timezone\"`\r\n"]
[2667.448868, "o", "    31\t\tSeed                *int              `json:\"seed\"`\r\n    32\t\tEnvVars             map[string]string `json:\"env_vars\"`\r\n    33\t\tBlockedEnvVars      []string          `json:\"blocked_env_vars\"`\r\n    34\t\tNormalizePaths      bool              `json:\"normalize_paths\"`\r\n    35\t\tNormalizeTimestamps bool              `json:\"normalize_timestamps\"`\r\n    36\t}\r\n    37\t\r\n    38\ttype Step struct {\r\n    39\t\tID           string            `json:\"id\"`\r\n    40\t\tCommand      string            `json:\"command\"`\r\n    41\t\tWorkingDir   string            `json:\"working_dir\"`\r\n    42\t\tInputs       []string          `json:\"inputs\"`"]
[2667.449055, "o", "\r\n    43\t\tOutputs      []string          `json:\"outputs\"`\r\n    44\t\tDependsOn    []string          `json:\"depends_on\"`\r\n    45\t\tTimeoutSecs  int               `json:\"timeout_seconds\"`\r\n    46\t\tEnvOverrides map[string]string `json:\"env_overrides\"`\r\n    47\t}\r\n    48\t\r\n    49\tfunc loadManifest(path string) (*Manifest, error) {\r\n    50\t\tdata, err := os.ReadFile(path)\r\n    51\t\tif err != nil {\r\n    52\t\t\tif os.IsNotExist(err) {\r\n    53\t\t\t\treturn nil, fmt.Errorf(\"manifest not found: %s\", path)\r\n    54\t\t\t}\r\n    55\t\t\treturn nil, err\r\n    56\t\t}\r\n    57\t\r\n    58\t\traw := map[string]json.RawMessage{}\r\n    59\t\tif err := json.Unmarshal(data, &raw); err != nil {\r\n    60\t\t\treturn nil, fmt.Errorf(\"invalid manifest JSON: %s\", err.Error())\r\n    61\t\t}\r\n    62\t\tfor _, field := range []string{\"name\", \"version\", \"verification\", \"environment\", \"steps\"} {\r\n    63\t\t\tif _, ok := raw[field]; !ok {\r\n    64\t\t\t\treturn nil, fmt.Errorf(\"missing required field: %s\", field)\r\n    65\t\t\t}\r\n    66\t\t}\r\n    67\t\r\n    68\t\t"]
[2667.449131, "o", "var m Manifest\r\n    69\t\tif err := json.Unmarshal(data, &m); err != nil {\r\n    70\t\t\treturn nil, fmt.Errorf(\"invalid manifest JSON: %s\", err.Error())\r\n    71\t\t}\r\n    72\t\r\n    73\t\tif m.Name == \"\" {\r\n    74\t\t\treturn nil, fmt.Errorf(\"missing required field: name\")\r\n    75\t\t}\r\n    76\t\tif !nameRe.MatchString(m.Name) {\r\n    77\t\t\treturn nil, fmt.Errorf(\"invalid name format: %q (must match ^[a-z][a-z0-9_-]{0,63}$)\", m.Name)\r\n"]
[2667.449208, "o", "    78\t\t}\r\n    79\t\tif m.Version == \"\" {\r\n    80\t\t\treturn nil, fmt.Errorf(\"missing required field: version\")\r\n    81\t\t}\r\n    82\t\r\n    83\t\tvraw := map[string]json.RawMessage{}\r\n    84\t\tif err := json.Unmarshal(raw[\"verification\"], &vraw); err != nil {\r\n    85\t\t\treturn nil, fmt.Errorf(\"invalid manifest JSON: %s\", err.Error())\r\n    86\t\t}\r\n    87\t\tfor _, field := range []string{\"passes\", \"algorithm\", \"mode\"} {\r\n    88\t\t\tif _, ok := vraw[field]; !ok {\r\n"]
[2667.449285, "o", "    89\t\t\t\treturn nil, fmt.Errorf(\"missing required field: verification.%s\", field)\r\n    90\t\t\t}\r\n    91\t\t}\r\n    92\t\tswitch m.Verify.Algorithm {\r\n    93\t\tcase \"sha256\", \"blake2b\":\r\n    94\t\tdefault:\r\n    95\t\t\treturn nil, fmt.Errorf(\"invalid algorithm: %q (must be \\\"sha256\\\" or \\\"blake2b\\\")\", m.Verify.Algorithm)\r\n    96\t\t}\r\n"]
[2667.449357, "o", "    97\t\tswitch m.Verify.Mode {\r\n    98\t\tcase \"full\", \"incremental\", \"targeted\":\r\n    99\t\tdefault:\r\n"]
[2667.449419, "o", "   100\t\t\treturn nil, fmt.Errorf(\"invalid mode: %q (must be \\\"full\\\", \\\"incremental\\\", or \\\"targeted\\\")\", m.Verify.Mode)\r\n   101\t\t}\r\n   102\t\tif m.Verify.Passes < 1 {\r\n   103\t\t\treturn nil, fmt.Errorf(\"passes must be >= 1, got %d\", m.Verify.Passes)\r\n   104\t\t}\r\n   105\t\r\n   106\t\tif m.Env.Locale == \"\" {\r\n   107\t\t\tm.Env.Locale = \"C\"\r\n   108\t\t}\r\n   109\t\tif m.Env.Timezone == \"\" {\r\n   110\t\t\tm.Env.Timezone = \"UTC\"\r\n   111\t\t}\r\n   112\t\tif m.Env.EnvVars == nil {\r\n"]
[2667.449493, "o", "   113\t\t\tm.Env.EnvVars = map[string]string{}\r\n   114\t\t}\r\n   115\t\tif m.Env.BlockedEnvVars == nil {\r\n   116\t\t\tm.Env.BlockedEnvVars = []string{}\r\n   117\t\t}\r\n   118\t\r\n   119\t\tif len(m.Steps) == 0 {\r\n   120\t\t\treturn nil, fmt.Errorf(\"steps must contain at least one step\")\r\n   121\t\t}\r\n   122\t\tstepIDs := map[string]bool{}"]
[2667.449577, "o", "\r\n   123\t\tfor i, s := range m.Steps {\r\n   124\t\t\tif s.ID == \"\" {\r\n   125\t\t\t\treturn nil, fmt.Errorf(\"missing required field: steps[%d].id\", i)\r\n   126\t\t\t}\r\n   127\t\t\tif !nameRe.MatchString(s.ID) {\r\n   128\t\t\t\treturn nil, fmt.Errorf(\"invalid step id: %q (must match ^[a-z][a-z0-9_-]{0,63}$)\", s.ID)\r\n   129\t\t\t}\r\n   130\t\t\tif stepIDs[s.ID] {\r\n   131\t\t\t\treturn nil, fmt.Errorf(\"duplicate step id: %q\", s.ID)\r\n"]
[2667.449651, "o", "   132\t\t\t}\r\n   133\t\t\tstepIDs[s.ID] = true\r\n   134\t\t\tif s.Command == \"\" {\r\n   135\t\t\t\treturn nil, fmt.Errorf(\"missing required field: steps[%d].command\", i)\r\n   136\t\t\t}\r\n   137\t\t\tif s.WorkingDir == \"\" {\r\n   138\t\t\t\ts.WorkingDir = \".\"\r\n   139\t\t\t}\r\n   140\t\t\tif s.TimeoutSecs <= 0 {\r\n   141\t\t\t\ts.TimeoutSecs = 300\r\n"]
[2667.449716, "o", "   142\t\t\t}\r\n   143\t\t\tif s.Inputs == nil {\r\n   144\t\t\t\ts.Inputs = []string{}\r\n   145\t\t\t}\r\n   146\t\t\tif s.Outputs == nil {\r\n   147\t\t\t\ts.Outputs = []string{}\r\n   148\t\t\t}\r\n   149\t\t\tif s.DependsOn == nil {\r\n   150\t\t\t"]
[2667.449773, "o", "\ts.DependsOn = []string{}\r\n   151\t\t\t}\r\n   152\t\t\tif s.EnvOverrides == nil {\r\n   153\t\t\t\ts.EnvOverrides = map[string]string{}\r\n   154\t\t\t}\r\n   155\t\t\tm.Steps[i] = s\r\n   156\t\t}\r\n"]
[2667.449833, "o", "   157\t\r\n   158\t\tfor _, s := range m.Steps {\r\n   159\t\t\tfor _, dep := range s.DependsOn {\r\n   160\t\t\t\tif !stepIDs[dep] {\r\n   161\t\t\t\t\treturn nil, fmt.Errorf(\"unknown dependency: step %q depends on %q\", s.ID, dep)\r\n   162\t\t\t\t}\r\n   163\t\t\t}\r\n   164\t\t}\r\n   165\t\r\n"]
[2667.449891, "o", "   166\t\tif cyc := shortestCycle(m.Steps); len(cyc) > 0 {\r\n   167\t\t\treturn nil, fmt.Errorf(\"cycle detected: %s\", strings.Join(cyc, \" -> \"))\r\n   168\t\t}\r\n   169\t\treturn &m, nil\r\n   170\t}\r\n"]
