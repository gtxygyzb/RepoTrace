[6176.087893, "o", "\t\t}\r\n\r\n\t\tclassification := classifyTrendStep(statusChanges, firstStatus, lastStatus)\r\n\t\tswitch classification {\r\n\t\tcase \"stable\":\r\n\t\t\tstableCount++\r\n\t\tcase \"flaky\":\r\n\t\t\tflakyCount++\r\n\t\tcase \"degrading\":\r\n\t\t\tdegradingCount++\r\n\t\tcase \"improving\":\r\n\t\t\timprovingCount++\r\n\t\t}\r\n\t\tstabilitySum += stability\r\n\r\n"]
[6176.088019, "o", "\t\tstepTrends = append(stepTrends, trendStep{\r\n\t\t\tStepID:         id,\r\n\t\t\tStatuses:       statuses,\r\n\t\t\tFirstSeenIndex: firstSeenIndex,\r\n\t\t\tLastSeenIndex:  lastSeenIndex,\r\n\t\t\tStatusChanges:  statusChanges,\r\n\t\t\tStability:      stability,\r\n\t\t\tClassification: classification,\r\n\t\t})\r\n\t}\r\n\r\n\toverallStability := 1.0\r\n\tif len(ids) > 0 {\r\n\t\toverallStability = stabilitySum / float64(len(ids))\r\n\t}\r\n\r\n\t"]
[6176.088091, "o", "return &trendOutput{\r\n\t\tTrendTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n\t\tReportCount:    reportCount,\r\n\t\tStepTrends:     stepTrends,\r\n\t\tAggregate: trendAggregate{\r\n\t\t\tTotalStepsTracked: len(ids),\r\n\t\t\tStableCount:       stableCount,\r\n\t\t\tFlakyCount:        flakyCount,\r\n\t\t\tDegradingCount:    degradingCount,\r\n"]
[6176.088155, "o", "\t\t\tImprovingCount:    improvingCount,\r\n\t\t\tOverallStability:  overallStability,\r\n\t\t},\r\n\t}\r\n}\r\n\r\nfunc classifyTrendStep(statusChanges int, firstStatus, lastStatus string) string {\r\n\tif statusChanges == 0 {\r\n\t\treturn \"stable\"\r\n\t}\r\n\tif statusChanges >= 2 {\r\n"]
[6176.088214, "o", "\t\treturn \"flaky\"\r\n\t}\r\n\r\n\tfirstRank := statusRank(firstStatus)\r\n\tlastRank := statusRank(lastStatus)\r\n\tif lastRank < firstRank {\r\n\t\treturn \"degrading\"\r\n\t}\r\n"]
