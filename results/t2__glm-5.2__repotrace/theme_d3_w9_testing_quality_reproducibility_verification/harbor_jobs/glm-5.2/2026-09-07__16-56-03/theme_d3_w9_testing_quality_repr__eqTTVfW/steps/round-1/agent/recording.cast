[3796.563753, "o", "\t}\r\n   414\t\tif policyStatus != \"ERROR\" {\r\n   415\t\t\tif requireViolation {\r\n   416\t\t\t\tpolicyStatus = \"FAIL\"\r\n   417\t\t\t} else {\r\n   418\t\t\t\tfor _, sr := range rep.Steps {\r\n   419\t\t\t\t\tid := sr.ID\r\n   420\t\t\t\t\tif ignoredSteps[id] {\r\n   421\t\t\t\t\t\tcontinue\r\n"]
