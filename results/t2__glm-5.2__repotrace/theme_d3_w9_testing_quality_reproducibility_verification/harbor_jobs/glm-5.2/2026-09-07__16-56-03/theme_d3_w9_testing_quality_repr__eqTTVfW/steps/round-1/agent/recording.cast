[5907.860544, "o", "\t\t\t\tTimestamp:       baseline.Timestamp,\r\n   240\t\t\t},\r\n   241\t\t\tCurrent: diffReportMeta{\r\n   242\t\t\t\tManifestName:    current.ManifestName,\r\n   243\t\t\t\tManifestVersion: current.ManifestVersion,\r\n   244\t\t\t\tOverallStatus:   current.OverallStatus,\r\n"]
[5907.8606, "o", "   245\t\t\t\tTimestamp:       current.Timestamp,\r\n   246\t\t\t},\r\n   247\t\t\tComparisonTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n   248\t\t\tStatusTransition: diffStatusTransition{\r\n   249\t\t\t\tFrom: baseline.OverallStatus,\r\n   250\t\t\t\tTo:   current.OverallStatus,\r\n   251\t\t\t\tType: statusTransitionType(baseline.OverallStatus, current.OverallStatus),\r\n   252\t\t\t},\r\n"]
[5907.860657, "o", "   253\t\t\tStepChanges: changes,\r\n   254\t\t\tSummary:     summary,\r\n   255\t\t}\r\n   256\t}\r\n   257\t\r\n   258\tfunc diffStepOutputs(b, c stepReport) ([]diffOutputChange, bool) {\r\n   259\t\tbOutputs := map[string]outputReport{}\r\n   260\t\tfor _, o := range b.Outputs {\r\n   261\t\t\tbOutputs[o.Path] = o\r\n   262\t\t}\r\n   263"]
[5907.860676, "o", "\t\tcOutputs := map[string]outputReport{}\r\n   264\t\tfor _, o := range c.Outputs {\r\n   265\t\t\tcOutputs[o.Path] = o\r\n   266\t\t}\r\n   267\t\r\n   268\t\tpaths := map[string]bool{}\r\n   269\t\tfor p := range bOutputs {\r\n"]
[5907.86078, "o", "   270\t\t\tpaths[p] = true\r\n   271\t\t}\r\n   272\t\tfor p := range cOutputs {\r\n   273\t\t\tpaths[p] = true\r\n   274\t\t}\r\n   275\t\r\n   276\t\tvar keys []string\r\n   277\t\tfor p := range paths {\r\n   278\t\t\tkeys = append(keys, p)\r\n   279\t\t}\r\n   280\t\tsort.Strings(keys)\r\n   281\t\r\n   282\t\tchanges := []diffOutputChange{}\r\n   283\t\tchanged := false\r\n   284\t\r\n   285\t\tfor _, p := range keys {\r\n   286\t\t\tbo, hasB := bOutputs[p]\r\n"]
[5907.860798, "o", "   287\t\t\tco, hasC := cOutputs[p]\r\n   288\t\r\n   289\t\t\toc := diffOutputChange{\r\n"]
[5907.86091, "o", "   290\t\t\t\tPath: p,\r\n   291\t\t\t\tDetails: diffOutputDetail{\r\n   292\t\t\t\t\tBaselineFingerprints: nilIfEmpty(bo.Fingerprints),\r\n   293\t\t\t\t\tCurrentFingerprints:  nilIfEmpty(co.Fingerprints),\r\n   294\t\t\t\t},\r\n   295\t\t\t}\r\n   296\t\t\tif hasB {\r\n   297\t\t\t\toc.Details.BaselineConsistent = &bo.CrossPassConsistent\r\n   298\t\t\t\tif bo.ReferenceMatch != nil {\r\n   299\t\t\t\t\toc.Details.BaselineReferenceMatch = bo.ReferenceMatch\r\n   300\t\t\t\t}\r\n   301\t\t\t}\r\n   302\t\t\tif hasC {\r\n   303\t\t\t\toc.Details.CurrentConsistent = &co.CrossPassConsistent\r\n   304\t\t\t\tif co.ReferenceMatch != nil {\r\n   305\t\t\t\t\toc.Details.CurrentReferenceMatch = co.ReferenceMatch\r\n"]
