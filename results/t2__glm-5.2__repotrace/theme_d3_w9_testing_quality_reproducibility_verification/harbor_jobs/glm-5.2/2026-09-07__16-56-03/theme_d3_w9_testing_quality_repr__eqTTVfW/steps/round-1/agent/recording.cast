[5416.723639, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n"]
[5416.723749, "o", "     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"sort\"\r\n     8\t\t\"time\"\r\n     9\t)\r\n    10\t\r\n    11\ttype diffReport struct {\r\n    12\t\tBaseline            diffReportMeta       `json:\"baseline\"`\r\n    13\t\tCurrent             diffReportMeta       `json:\"current\"`\r\n    14\t\tComparisonTimestamp string               `json:\"comparison_timestamp\"`\r\n    15\t\tStatusTransition    diffStatusTransition `json:\"status_transition\"`\r\n    16\t\tStepChanges         []diffStepChange     `json:\"step_changes\"`\r\n    17\t\tSummary             diffSummary          `json:\"summary\"`\r\n    18\t}\r\n    19\t\r\n    20\ttype diffReportMeta struct {\r\n    21\t\tManifestName    string `json:\"manifest_name\"`\r\n"]
[5416.723851, "o", "    22\t\tManifestVersion string `json:\"manifest_version\"`\r\n    23\t\tOverallStatus   string `json:\"overall_status\"`\r\n    24\t\tTimestamp       string `json:\"timestamp\"`\r\n    25\t}\r\n    26\t\r\n    27\ttype diffStatusTransition struct {\r\n    28\t\tFrom string `json:\"from\"`\r\n    29\t\tTo   string `json:\"to\"`\r\n    30\t\tType string `json:\"type\"`\r\n    31\t}\r\n    32\t\r\n    33\ttype diffStepChange struct {\r\n    34\t\tStepID           string             `json:\"step_id\"`\r\n    35\t\tChangeType       string             `json:\"change_type\"`\r\n    36\t\tBaselineStatus   *string            `json:\"baseline_status\"`\r\n"]
[5416.72397, "o", "    37\t\tCurrentStatus    *string            `json:\"current_status\"`\r\n    38\t\tStatusTransition *string            `json:\"status_transition\"`\r\n    39\t\tOutputChanges    []diffOutputChange `json:\"output_changes\"`\r\n    40\t}\r\n    41\t\r\n    42\ttype diffOutputChange struct {\r\n    43\t\tPath       string           `json:\"path\"`\r\n    44\t\tChangeType string           `json:\"change_type\"`\r\n    45\t\tDetails    diffOutputDetail `json:\"details\"`\r\n    46\t}\r\n    47"]
[5416.724049, "o", "\t\r\n    48\ttype diffOutputDetail struct {\r\n    49\t\tBaselineFingerprints   []string `json:\"baseline_fingerprints\"`\r\n    50\t\tCurrentFingerprints    []string `json:\"current_fingerprints\"`\r\n    51\t\tBaselineConsistent     *bool    `json:\"baseline_consistent\"`\r\n    52\t\t"]
[5416.724115, "o", "CurrentConsistent      *bool    `json:\"current_consistent\"`\r\n    53\t\tBaselineReferenceMatch *bool    `json:\"baseline_reference_match\"`\r\n    54\t\tCurrentReferenceMatch  *bool    `json:\"current_reference_match\"`\r\n    55\t}\r\n    56\t\r\n    57\ttype diffSummary struct {\r\n    58\t\tStepsAdded         int `json:\"steps_added\"`\r\n    59\t\tStepsRemoved       int `json:\"steps_removed\"`\r\n    60\t\tStepsModified      int `json:\"steps_modified\"`\r\n    61\t\tStepsUnchanged     int `json:\"steps_unchanged\"`\r\n    62\t\tRegressions        int `json:\"regressions\"`\r\n    63\t\tImprovements       int `json:\"improvements\"`\r\n    64\t\tTotalOutputChanges int `json:\"total_output_changes\"`\r\n    65\t}\r\n    66\t\r\n    67\ttype diffReportLite struct {\r\n    68\t\tManifestName    string       `json:\"manifest_name\"`\r\n"]
[5416.724187, "o", "    69\t\tManifestVersion string       `json:\"manifest_version\"`\r\n    70\t\tOverallStatus   string       `json:\"overall_status\"`\r\n    71\t\tTimestamp       string       `json:\"timestamp\"`\r\n    72\t\tSteps           []stepReport `json:\"steps\"`\r\n    73\t}\r\n    74\t\r\n"]
[5416.724254, "o", "    75\tfunc diffCmd(args []string) {\r\n    76\t\tformat := \"json\"\r\n    77\t\tpositional := parseFlags(args, map[string]*string{\r\n    78\t\t\t\"format\": &format,\r\n    79\t\t})\r\n    80\t\tif len(positional) != 2 {\r\n    81\t\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify diff <baseline.json> <current.json> [--format json|text]\")\r\n    82\t\t\tos.Exit(2)\r\n    83\t\t}\r\n    84\t\r\n"]
[5416.724319, "o", "    85\t\tbaseline, err := loadDiffReport(positional[0], \"baseline\")\r\n    86\t\tif err != nil {\r\n    87\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    88\t\t\tos.Exit(2)\r\n    89\t\t}\r\n    90\t\tcurrent, err := loadDiffReport(positional[1], \"current\")\r\n    91\t\tif err != nil {\r\n    92\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    93\t\t\tos.Exit(2)\r\n    94\t\t}\r\n    95\t\r\n"]
[5416.724381, "o", "    96\t\tdiff := buildDiffReport(baseline, current)\r\n    97\t\r\n    98\t\tif format == \"text\" {\r\n    99\t\t\tprintDiffText(diff)\r\n   100\t\t} else {\r\n   101\t\t\tout, err := json.MarshalIndent(diff, \"\", \"  \")\r\n   102\t\t\tif err != nil {\r\n   103\t\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   104\t\t\t\tos.Exit(2)\r\n   105\t\t"]
[5416.724438, "o", "\t}\r\n   106\t\t\tfmt.Println(string(out))\r\n   107\t\t}\r\n   108\t\r\n   109\t\tif diff.Summary.Regressions > 0 {\r\n   110\t\t\tos.Exit(1)\r\n   111\t\t}\r\n   112\t\tos.Exit(0)\r\n   113\t}\r\n"]
[5416.724501, "o", "   114\t\r\n   115\tfunc loadDiffReport(path, role string) (*diffReportLite, error) {\r\n   116\t\tif _, err := os.Stat(path); err != nil {\r\n   117\t\t\tif os.IsNotExist(err) {\r\n   118\t\t\t\treturn nil, fmt.Errorf(\"error: diff %s not found: %s\", role, path)\r\n   119\t\t\t}\r\n   120\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n"]
