[3796.562752, "o", "\t\t\tcase \"allow\":\r\n   297\t\t\t\t\t\t\tif condition {\r\n   298\t\t\t\t\t\t\t\tst.effective = true\r\n   299\t\t\t\t\t\t\t\tev.Effect = \"applied\"\r\n   300\t\t\t\t\t\t\t\tev.Details = \"output majority rate satisfies required consistency\"\r\n   301\t"]
[3796.562809, "o", "\t\t\t\t\t\t}\r\n   302\t\t\t\t\t\tcase \"warn\":\r\n   303\t\t\t\t\t\t\tif condition {\r\n   304\t\t\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"rule %s: consistency allowed with warning for %s:%s\", rule.ID, sr.ID, o.Path))\r\n   305\t\t\t\t\t\t\t\tev.Effect = \"applied\"\r\n"]
