[5457.552011, "o", "\u001b[35m\u001b[Kcmd/repro-verify/graph.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K11\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype\u001b[m\u001b[K Graph struct {\r\n\u001b[35m\u001b[Kcmd/repro-verify/graph.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K buildGraph(steps []Step) *Graph {\r\n\u001b[35m\u001b[Kcmd/repro-verify/graph.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K (g *Graph) deps(id string) []string {\r\n"]
