[6831.507258, "o", "\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tOverallStability  float64 `json:\"\u001b[01;31m\u001b[Koverall_stability\u001b[m\u001b[K\"`\r\n"]
[6831.50741, "o", "\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\toutput := \u001b[01;31m\u001b[KbuildTrendOutput\u001b[m\u001b[K(reports)\r\n"]
[6831.507452, "o", "\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KbuildTrendOutput\u001b[m\u001b[K(reports []*trendReportLite) *trendOutput {\r\n"]
[6831.50753, "o", "\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kappearances\u001b[m\u001b[K := 0\r\n\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K162\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[Kappearances\u001b[m\u001b[K++\r\n"]
[6831.507578, "o", "\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif \u001b[01;31m\u001b[Kappearances\u001b[m\u001b[K > 1 {\r\n\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tstability = 1.0 - float64(statusChanges)/float64(\u001b[01;31m\u001b[Kappearances\u001b[m\u001b[K-1)\r\n"]
[6831.508298, "o", "\u001b[35m\u001b[Kdocs/spec_v7.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KThe `\u001b[01;31m\u001b[Koverall_stability\u001b[m\u001b[K` field in the trend aggregate (Section 17.2) is corrected.\r\n\u001b[35m\u001b[Kdocs/spec_v7.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K**Corrected behavior:** Average of `stability` values only for steps with `\u001b[01;31m\u001b[Kappearances\u001b[m\u001b[K > 1` (steps that appear in two or more reports). Steps appearing in only one report are excluded from the average.\r\n"]
[6831.508349, "o", "\u001b[35m\u001b[Kdocs/spec_v7.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KIf no steps have `\u001b[01;31m\u001b[Kappearances\u001b[m\u001b[K > 1`, `\u001b[01;31m\u001b[Koverall_stability\u001b[m\u001b[K` is `1.0`.\r\n\u001b[35m\u001b[Kdocs/spec_v7.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K**Rationale:** A step appearing in only one report has `stability = 1.0` by definition (zero transitions possible). Including these steps inflates the `\u001b[01;31m\u001b[Koverall_stability\u001b[m\u001b[K` metric and masks actual instability in multi-appearance steps.\r\n\u001b[35m\u001b[Kdocs/spec_v7.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KPrevious `\u001b[01;31m\u001b[Koverall_stability\u001b[m\u001b[K`: (0.0 + 1.0) / 2 = 0.50\r\n"]
[6831.508393, "o", "\u001b[35m\u001b[Kdocs/spec_v7.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KCorrected `\u001b[01;31m\u001b[Koverall_stability\u001b[m\u001b[K`: 0.0 / 1 = 0.0 (only step-a counts)\r\n\u001b[35m\u001b[Kdocs/spec_v7.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K**Note:** Per-step `stability` values are unchanged. Only the aggregate `\u001b[01;31m\u001b[Koverall_stability\u001b[m\u001b[K` calculation changes. The `total_steps_tracked` still counts ALL unique steps (including single-appearance ones).\r\n"]
[6831.508529, "o", "\u001b[35m\u001b[Kdocs/spec_v4.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \"\u001b[01;31m\u001b[Koverall_stability\u001b[m\u001b[K\": <float>\r\n"]
[6831.508579, "o", "\u001b[35m\u001b[Kdocs/spec_v4.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K- `stability`: Calculated as `1.0 - (status_changes / (\u001b[01;31m\u001b[Kappearances\u001b[m\u001b[K - 1))`, where `\u001b[01;31m\u001b[Kappearances\u001b[m\u001b[K` is the count of non-null entries in `statuses`. If `\u001b[01;31m\u001b[Kappearances\u001b[m\u001b[K <= 1`, stability is `1.0`.\r\n\u001b[35m\u001b[Kdocs/spec_v4.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K- `\u001b[01;31m\u001b[Koverall_stability\u001b[m\u001b[K`: Average of all steps' `stability` values. If `total_steps_tracked == 0`, `1.0`.\r\n"]
[6831.509132, "o", "\u001b[?2004h"]
[6831.509179, "o", "root@n30009:/app# "]
[6837.655136, "i", "sed -n '1,260p' cmd/repro-verify/trend.go\n"]
[6837.655504, "o", "sed -n '1,260p' cmd/repro-verify/trend.go\r\n\u001b[?2004l\r"]
[6837.658619, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n"]
[6837.658733, "o", "\t\"time\"\r\n)\r\n\r\ntype trendReportLite struct {\r\n\tManifestName    string       `json:\"manifest_name\"`\r\n\tManifestVersion string       `json:\"manifest_version\"`\r\n\tOverallStatus   string       `json:\"overall_status\"`\r\n\tTimestamp       string       `json:\"timestamp\"`\r\n\tSteps           []stepReport `json:\"steps\"`\r\n}\r\n\r\ntype trendStep struct {\r\n\tStepID         string    `json:\"step_id\"`\r\n\tStatuses       []*string `json:\"statuses\"`\r\n\tFirstSeenIndex int       `json:\"first_seen_index\"`\r\n\tLastSeenIndex  int       `json:\"last_seen_index\"`\r\n"]
[6837.658849, "o", "\tStatusChanges  int       `json:\"status_changes\"`\r\n\tStability      float64   `json:\"stability\"`\r\n\tClassification string    `json:\"classification\"`\r\n}\r\n\r\ntype trendAggregate struct {\r\n\tTotalStepsTracked int     `json:\"total_steps_tracked\"`\r\n\tStableCount       int     `json:\"stable_count\"`\r\n\tFlakyCount        int     `json:\"flaky_count\"`\r\n\tDegradingCount    int     `json:\"degrading_count\"`\r\n"]
[6837.65897, "o", "\tImprovingCount    int     `json:\"improving_count\"`\r\n\tOverallStability  float64 `json:\"overall_stability\"`\r\n}\r\n\r\ntype trendOutput struct {\r\n\tTrendTimestamp string         `json:\"trend_timestamp\"`\r\n\tReportCount    int            `json:\"report_count\"`\r\n\tStepTrends     []trendStep    `json:\"step_trends\"`\r\n\tAggregate      trendAggregate `json:\"aggregate\"`\r\n}\r\n\r\nfunc trendCmd(args []string) {\r\n\tformat := \"json\"\r\n\tpositional := parseFlags(args, map[string]*string{\r\n"]
[6837.659047, "o", "\t\t\"format\": &format,\r\n\t})\r\n\r\n\tif len(positional) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: trend requires at least two report files\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n\treports := make([]*trendReportLite, 0, len(positional))\r\n\tfor _, path := range positional {\r\n\t\trep, err := loadTrendReport(path)\r\n\t\tif err != nil {\r\n"]
[6837.659125, "o", "\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\tos.Exit(2)\r\n\t\t}\r\n\t\treports = append(reports, rep)\r\n\t}\r\n\r\n\toutput := buildTrendOutput(reports)\r\n\r\n\tif format == \"text\" {\r\n\t\tprintTrendText(output)\r\n\t} else {\r\n"]
[6837.659199, "o", "\t\tdata, err := json.MarshalIndent(output, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n\t\t\tos.Exit(2)\r\n\t\t}\r\n\t\tfmt.Println(string(data))\r\n\t}\r\n\r\n\tif output.Aggregate.DegradingCount > 0 || output.Aggregate.FlakyCount > 0 {\r\n\t\tos.Exit(1)\r\n\t}\r\n\tos.Exit(0)\r\n}\r\n\r\n"]
[6837.659276, "o", "func loadTrendReport(path string) (*trendReportLite, error) {\r\n\tif _, err := os.Stat(path); err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, fmt.Errorf(\"error: trend file not found: %s\", path)\r\n\t\t}\r\n\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: %s\", path, err)\r\n\t}\r\n\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: %s\", path, err)\r\n\t}\r\n\r\n\tvar raw map[string]json.RawMessage\r\n\tif err := json.Unmarshal(data, &raw); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: %s\", path, err)\r\n\t}\r\n\r\n"]
[6837.65935, "o", "\tfor _, field := range []string{\"manifest_name\", \"overall_status\", \"steps\"} {\r\n\t\tif _, ok := raw[field]; !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: missing field %s\", path, field)\r\n\t\t}\r\n\t}\r\n\r\n\tvar r trendReportLite\r\n\tif err := json.Unmarshal(data, &r); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: %s\", path, err)\r\n\t}\r\n\tif r.ManifestName == \"\" {\r\n\t\t"]
[6837.65938, "o", "return nil, fmt.Errorf(\"error: invalid trend input: %s: missing field manifest_name\", path)\r\n\t}\r\n\tif r.OverallStatus == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: missing field overall_status\", path)\r\n\t}\r\n"]
[6837.659472, "o", "\tif r.Steps == nil {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: missing field steps\", path)\r\n\t}\r\n\r\n"]
[6837.65955, "o", "\treturn &r, nil\r\n}\r\n\r\nfunc buildTrendOutput(reports []*trendReportLite) *trendOutput {\r\n\treportCount := len(reports)\r\n\tstepIDs := make(map[string]bool)\r\n\treportStepStatus := make([]map[string]string, reportCount)\r\n\r\n\tfor i, rep := range reports {\r\n\t\tstatusByID := make(map[string]string)\r\n\t\tfor _, step := range rep.Steps {\r\n\t\t\tstatusByID[step.ID] = step.Status\r\n\t\t\tstepIDs[step.ID] = true\r\n\t\t}\r\n\t\treportStepStatus[i] = statusByID\r\n\t}\r\n\r\n\tids := make([]string, 0, len(stepIDs))\r\n\tfor id := range stepIDs {\r\n"]
[6837.659625, "o", "\t\tids = append(ids, id)\r\n\t}\r\n\tsort.Strings(ids)\r\n\r\n\tstepTrends := make([]trendStep, 0, len(ids))\r\n\tvar stableCount, flakyCount, degradingCount, improvingCount int\r\n\tvar stabilitySum float64\r\n\r\n\tfor _, id := range ids {\r\n\t\tstatuses := make([]*string, reportCount)\r\n\t\tappearances := 0\r\n\t\tfirstSeenIndex := -1\r\n\t\tlastSeenIndex := -1\r\n\t\tvar firstStatus, lastStatus string\r\n\r\n\t\tfor i, statusByID := range reportStepStatus {\r\n\t\t\tif status, ok := statusByID[id]; ok {\r\n\t\t\t\tstatusCopy := status\r\n"]
[6837.659747, "o", "\t\t\t\tstatuses[i] = &statusCopy\r\n\t\t\t\tappearances++\r\n\t\t\t\tif firstSeenIndex == -1 {\r\n\t\t\t\t\tfirstSeenIndex = i\r\n\t\t\t\t\tfirstStatus = status\r\n\t\t\t\t}\r\n\t\t\t\tlastSeenIndex = i\r\n\t\t\t\tlastStatus = status\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tstatusChanges := 0\r\n\t\tvar prev *string\r\n\t\tfor _, status := range statuses {\r\n\t\t\tif status == nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif prev != nil && *prev != *status {\r\n"]
[6837.659826, "o", "\t\t\t\tstatusChanges++\r\n\t\t\t}\r\n\t\t\tprev = status\r\n\t\t}\r\n\r\n\t\tstability := 1.0\r\n\t\tif appearances > 1 {\r\n\t\t\tstability = 1.0 - float64(statusChanges)/float64(appearances-1)\r\n\t\t}\r\n\r\n\t\tclassification := classifyTrendStep(statusChanges, firstStatus, lastStatus)\r\n\t\tswitch classification {\r\n"]
[6837.659859, "o", "\t\tcase \"stable\":\r\n\t\t\tstableCount++\r\n\t\tcase \"flaky\":\r\n\t\t\tflakyCount++\r\n\t\tcase \"degrading\":\r\n"]
[6837.659976, "o", "\t\t\tdegradingCount++\r\n\t\tcase \"improving\":\r\n\t\t\timprovingCount++\r\n\t\t}\r\n\t\tstabilitySum += stability\r\n\r\n\t\tstepTrends = append(stepTrends, trendStep{\r\n\t\t\tStepID:         id,\r\n\t\t\tStatuses:       statuses,\r\n\t\t\tFirstSeenIndex: firstSeenIndex,\r\n\t\t\tLastSeenIndex:  lastSeenIndex,\r\n\t\t\tStatusChanges:  statusChanges,\r\n\t\t\tStability:      stability,\r\n\t\t\tClassification: classification,\r\n\t\t})\r\n"]
[6837.660053, "o", "\t}\r\n\r\n\toverallStability := 1.0\r\n\tif len(ids) > 0 {\r\n\t\toverallStability = stabilitySum / float64(len(ids))\r\n\t}\r\n\r\n"]
[6837.660123, "o", "\treturn &trendOutput{\r\n\t\tTrendTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n\t\tReportCount:    reportCount,\r\n\t\tStepTrends:     stepTrends,\r\n\t\tAggregate: trendAggregate{\r\n\t\t\tTotalStepsTracked: len(ids),\r\n\t\t\tStableCount:       stableCount,\r\n\t\t\tFlakyCount:        flakyCount,\r\n\t\t\tDegradingCount:    degradingCount,\r\n\t\t\tImprovingCount:    improvingCount,\r\n\t\t\tOverallStability:  overallStability,\r\n\t\t},\r\n\t}\r\n}\r\n\r\nfunc classifyTrendStep(statusChanges int, firstStatus, lastStatus string) string {\r\n\tif statusChanges == 0 {\r\n\t\treturn \"stable\"\r\n\t}\r\n\tif statusChanges >= 2 {\r\n\t\treturn \"flaky\"\r\n"]
[6837.660197, "o", "\t}\r\n\r\n\tfirstRank := statusRank(firstStatus)\r\n\tlastRank := statusRank(lastStatus)\r\n\tif lastRank < firstRank {\r\n\t\treturn \"degrading\"\r\n\t}\r\n\tif lastRank > firstRank {\r\n\t\treturn \"improving\"\r\n\t}\r\n\treturn \"stable\"\r\n}\r\n\r\nfunc statusRank(status string) int {\r\n\t"]
[6837.660275, "o", "switch status {\r\n\tcase \"PASS\":\r\n\t\treturn 4\r\n\tcase \"FAIL\":\r\n\t\treturn 1\r\n\tcase \"ERROR\":\r\n\t\treturn 2"]
[6837.660344, "o", "\r\n\tcase \"TIMEOUT\":\r\n"]
