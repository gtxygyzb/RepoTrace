[3796.562125, "o", "   225\t\t\t\t\t\tif st == nil || st.matched {\r\n   226\t\t\t\t\t\t\tcontinue\r\n   227\t\t\t\t\t\t}\r\n   228\t\t\t\t\t\tmatched, err := filepath.Match(pattern, o.Path)\r\n   229\t\t\t\t\t\tif err != nil || !matched {\r\n   230\t\t\t\t\t\t\tcontinue\r\n   231\t\t\t\t\t\t}\r\n   232\t\t\t\t\t\tmatchedStepsAll[sr.ID] = true\r\n   233\t\t\t\t\t\tev.MatchedSteps = appendUnique(ev.MatchedSteps, sr.ID)\r\n   234\t\t\t\t\t\tev.MatchedOutputs = appendUnique(ev.MatchedOutputs, o.Path)\r\n   235\t"]
[3796.562206, "o", "\t\t\t\t\tst.matched = true\r\n   236\t\r\n   237\t\t\t\t\t\tswitch rule.Action {\r\n   238\t\t\t\t\t\tcase \"allow\":\r\n   239\t\t\t\t\t\t\tif st.bad {\r\n   240\t\t\t\t\t\t\t\tst.effective = true\r\n   241\t\t\t\t\t\t\t\tev.Effect = \"applied\"\r\n   242\t\t\t\t\t\t\t\tev.Details = \"allowed variance for matched outputs\"\r\n   243\t\t\t\t"]
