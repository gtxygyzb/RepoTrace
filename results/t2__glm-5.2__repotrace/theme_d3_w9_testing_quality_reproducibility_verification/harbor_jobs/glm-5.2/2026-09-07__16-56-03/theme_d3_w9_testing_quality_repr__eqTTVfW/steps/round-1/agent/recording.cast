[5980.297411, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"strings\"\r\n)\r\n\r\n"]
[5980.297561, "o", "func parseFlags(args []string, defs map[string]*string) []string {\r\n\tpositionals := []string{}\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tif strings.HasPrefix(arg, \"--\") {\r\n\t\t\tname := strings.TrimPrefix(arg, \"--\")\r\n\t\t\tvar value string\r\n\t\t\tif idx := strings.IndexByte(name, '='); idx >= 0 {\r\n\t\t\t\tvalue = name[idx+1:]\r\n\t\t\t\tname = name[:idx]\r\n\t\t\t} else {\r\n\t\t\t\tif i+1 >= len(args) {\r\n\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: flag --%s requires a value\\n\", name)\r\n\t\t\t\t\tos.Exit(2)\r\n\t\t\t\t}\r\n\t\t\t\ti++\r\n\t\t\t\tvalue = args[i]\r\n\t\t\t}\r\n\t\t\tptr, ok := defs[name]\r\n\t\t\tif !ok {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag --%s\\n\", name)\r\n\t\t\t\tos.Exit(2)\r\n"]
[5980.297652, "o", "\t\t\t}\r\n\t\t\t*ptr = value\r\n\t\t} else {\r\n\t\t\tpositionals = append(positionals, arg)\r\n\t\t}\r\n\t}\r\n\treturn positionals\r\n}\r\n"]
