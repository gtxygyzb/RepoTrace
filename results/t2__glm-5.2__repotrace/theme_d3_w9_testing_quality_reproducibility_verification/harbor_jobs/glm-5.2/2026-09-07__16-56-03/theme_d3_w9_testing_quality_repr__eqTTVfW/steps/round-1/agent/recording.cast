[5907.303938, "o", "   181\t\t\t\tprev = status\r\n   182\t\t\t}\r\n   183\t\r\n   184\t\t\tstability := 1.0\r\n   185\t\t\tif appearances > 1 {\r\n"]
[5907.304028, "o", "   186\t\t\t\tstability = 1.0 - float64(statusChanges)/float64(appearances-1)\r\n   187\t\t\t}\r\n   188\t\r\n   189\t\t\tclassification := classifyTrendStep(statusChanges, firstStatus, lastStatus)\r\n   190\t\t\tswitch classification {\r\n   191\t\t\tcase \"stable\":\r\n   192\t\t\t\tstableCount++\r\n   193\t\t\tcase \"flaky\":\r\n   194\t\t\t\tflakyCount++\r\n   195\t\t\tcase \"degrading\":\r\n   196\t\t\t\tdegradingCount++\r\n   197\t\t\tcase \"improving\":\r\n   198\t"]
[5907.304098, "o", "\t\t\timprovingCount++\r\n   199\t\t\t}\r\n   200\t\t\tstabilitySum += stability\r\n   201\t\r\n   202\t\t\tstepTrends = append(stepTrends, trendStep{\r\n   203\t\t\t\tStepID:         id,\r\n   204\t\t\t\tStatuses:       statuses,\r\n   205\t\t\t\tFirstSeenIndex: firstSeenIndex,\r\n"]
[5907.30416, "o", "   206\t\t\t\tLastSeenIndex:  lastSeenIndex,\r\n   207\t\t\t\tStatusChanges:  statusChanges,\r\n   208\t\t\t\tStability:      stability,\r\n"]
[5907.30422, "o", "   209\t\t\t\tClassification: classification,\r\n   210\t\t\t})\r\n   211\t\t}\r\n   212\t\r\n   213\t\toverallStability := 1.0\r\n   214\t\tif len(ids) > 0 {\r\n   215\t\t\toverallStability = stabilitySum / float64(len(ids))\r\n   216\t\t}\r\n   217\t\r\n   218\t\treturn &trendOutput{\r\n   219\t\t\tTrendTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n   220\t\t\t"]
[5907.304283, "o", "ReportCount:    reportCount,\r\n   221\t\t\tStepTrends:     stepTrends,\r\n   222\t\t\tAggregate: trendAggregate{\r\n   223\t\t\t\tTotalStepsTracked: len(ids),\r\n   224\t\t\t\tStableCount:       stableCount,\r\n   225\t\t\t\tFlakyCount:        flakyCount,\r\n   226\t\t\t\tDegradingCount:    degradingCount,\r\n   227\t\t\t\tImprovingCount:    improvingCount,\r\n   228\t\t\t\tOverallStability:  overallStability,\r\n   229\t\t\t},\r\n   230\t\t}\r\n   231\t}\r\n   232\t\r\n   233\tfunc classifyTrendStep(statusChanges int, firstStatus, lastStatus string) string {\r\n"]
[5907.304338, "o", "   234\t\tif statusChanges == 0 {\r\n   235\t\t\treturn \"stable\"\r\n   236\t\t}\r\n   237\t"]
[5907.304394, "o", "\tif statusChanges >= 2 {\r\n   238\t\t\treturn \"flaky\"\r\n   239\t\t}\r\n   240\t\r\n   241\t\tfirstRank := statusRank(firstStatus)\r\n   242\t\tlastRank := statusRank(lastStatus)\r\n   243\t\tif lastRank < firstRank {\r\n   244\t\t\treturn \"degrading\"\r\n   245\t\t}"]
[5907.304452, "o", "\r\n   246\t\tif lastRank > firstRank {\r\n   247\t\t\treturn \"improving\"\r\n   248\t\t}\r\n   249\t\treturn \"stable\"\r\n   250\t}\r\n   251\t\r\n   252\tfunc statusRank(status string) int {\r\n   253"]
[5907.304506, "o", "\t\tswitch status {\r\n   254\t\tcase \"PASS\":\r\n   255\t\t\treturn 4\r\n   256\t\tcase \"FAIL\":\r\n   257\t\t\treturn 3\r\n   258\t\tcase \"ERROR\":\r\n   259\t\t\treturn 2\r\n"]
[5907.304562, "o", "   260\t\tcase \"TIMEOUT\":\r\n   261\t\t\treturn 1\r\n   262\t\tcase \"SKIPPED\":\r\n   263\t\t\treturn 0\r\n   264\t\tdefault:\r\n   265\t\t\treturn -1\r\n   266\t\t}\r\n   267\t}\r\n   268\t\r\n"]
[5907.30462, "o", "   269\tfunc printTrendText(output *trendOutput) {\r\n   270\t\theader := fmt.Sprintf(\"Trend Analysis (%d reports)\", output.ReportCount)\r\n   271\t\tfmt.Println(header)\r\n   272\t\tfmt.Println(strings.Repeat(\"=\", len(header)))\r\n   273\t\r\n   274\t\tfor _, step := range output.StepTrends {\r\n   275\t\t\tstatusParts := make([]string, 0, len(step.Statuses))\r\n   276\t\t\tfor _, status := range step.Statuses {\r\n   277\t\t\t\tif status == nil {\r\n   278\t\t\t\t\tstatusParts = append(statusParts, \"-\")\r\n   279\t\t\t\t} else {\r\n   280\t\t\t\t\tstatusParts = append(statusParts, *status)\r\n"]
[5907.304679, "o", "   281\t\t\t\t}\r\n   282\t\t\t}\r\n   283\t\t\tfmt.Printf(\"%s  %s  [%s]  stability=%.2f\\n\", step.StepID, step.Classification, strings.Join(statusParts, \",\"), step.Stability)\r\n   284\t\t}\r\n   285\t\r\n   286\t\tfmt.Println(\"---\")\r\n   287\t\tfmt.Printf(\"%d steps: %d stable, %d flaky, %d degrading, %d improving\\n\",\r\n   288"]
[5907.304734, "o", "\t\t\toutput.Aggregate.TotalStepsTracked,\r\n   289\t\t\toutput.Aggregate.StableCount,\r\n   290\t\t\t"]
[5907.304792, "o", "output.Aggregate.FlakyCount,\r\n   291\t\t\toutput.Aggregate.DegradingCount,\r\n   292\t\t\toutput.Aggregate.ImprovingCount)\r\n   293\t\tfmt.Printf(\"Overall stability: %.1f%%\\n\", output.Aggregate.OverallStability*100)\r\n   294\t}\r\n"]
