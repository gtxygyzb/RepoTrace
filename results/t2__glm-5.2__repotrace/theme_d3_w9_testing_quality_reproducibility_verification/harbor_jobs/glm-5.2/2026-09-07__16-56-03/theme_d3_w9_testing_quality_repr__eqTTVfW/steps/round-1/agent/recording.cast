[3796.563395, "o", "   367\t\t\t\t\tev.Effect = \"applied\"\r\n   368\t\t\t\t\tev.Details = \"steps ignored from policy evaluation\"\r\n   369\t\t\t\t}\r\n   370\t\t\t\truleEvals = append(ruleEvals, ev)\r\n   371\t\t\t}\r\n   372\t\t}\r\n   373\t\r\n   374\t\teffectiveStatus := map[string]string{}\r\n   375\t\tfor _, sr := range rep.Steps {\r\n   376"]
[3796.56345, "o", "\t\t\tid := sr.ID\r\n   377\t\t\tst := rawStatus[id]\r\n   378\t\t\tif st == \"ERROR\" || st == \"TIMEOUT\" || st == \"SKIPPED\" {\r\n   379\t\t\t\teffectiveStatus[id] = st\r\n   380\t\t\t\tcontinue\r\n   381\t\t\t}\r\n   382\t\t\tbadOutput := false\r\n"]
