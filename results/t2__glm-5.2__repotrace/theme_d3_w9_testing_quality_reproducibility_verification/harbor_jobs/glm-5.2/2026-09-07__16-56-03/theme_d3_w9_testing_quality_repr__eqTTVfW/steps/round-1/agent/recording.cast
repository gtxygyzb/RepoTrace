[3978.367768, "o", "s = s.replace('\\tcase \"diff\":\\n\\t\\tdiffCmd(os.Args[2:])\\n', '\\tcase \"diff\":\\n\\t\\tdiffCmd(os.Args[2:])\\n\\tcase \"summary\":\\n\\t\\tsummaryCmd(os.Args[2:])\\n')\r\n\u001b[?2004l\r"]
[3978.367827, "o", "\u001b[?2004h> "]
[3978.367998, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n"]
