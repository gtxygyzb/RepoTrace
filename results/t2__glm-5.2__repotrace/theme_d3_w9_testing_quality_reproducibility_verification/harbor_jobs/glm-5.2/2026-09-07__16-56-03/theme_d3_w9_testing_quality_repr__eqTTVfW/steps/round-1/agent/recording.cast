[3795.995282, "o", "\t\ttargetedSteps := []string{}\r\n   122\t\tif stepsFlag != \"\" {\r\n   123\t\t\tfor _, s := range strings.Split(stepsFlag, \",\") {\r\n   124\t\t\t\ts = strings.TrimSpace(s)\r\n   125\t\t\t\tif s != \"\" {\r\n   126\t\t\t\t\ttargetedSteps = append(targetedSteps, s)\r\n   127\t\t\t\t}\r\n"]
