[6064.478541, "i", "cat > cmd/repro-verify/slice.go <<'EOF'\npackage main\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"strings\"\n)\n\ntype sliceReportLite struct {\n\tManifestName  string       `json:\"manifest_name\"`\n\tOverallStatus string       `json:\"overall_status\"`\n\tSteps         []stepReport `json:\"steps\"`\n}\n\ntype sliceStepOutput struct {\n\tID     string `json:\"id\"`\n\tStatus string `json:\"status\"`\n}\n\ntype sliceOutput struct {\n\tSourceFile     string            `json:\"source_file\"`\n\tManifestName   string            `json:\"manifest_name\"`\n\tFilterStatuses []string          `json:\"filter_statuses\"`\n\tTotalSteps     int               `json:\"total_steps\"`\n\tMatchedCount   int               `json:\"matched_count\"`\n\tSteps          []sliceStepOutput `json:\"steps\"`\n}\n\nfunc sliceCmd(args []string) {\n\tvar statuses []string\n\tvar positional []string\n\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tswitch {\n\t\tcase arg == \"--status\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\tfmt.Fprintln(os.Stderr, \"error: flag --status requires a value\")\n\t\t\t\tos.Exit(2)\n\t\t\t}\n\t\t\ti"]
[6064.478798, "i", "++\n\t\t\tstatuses = append(statuses, args[i])\n\t\tcase strings.HasPrefix(arg, \"--status=\"):\n\t\t\tstatuses = append(statuses, strings.TrimPrefix(arg, \"--status=\"))\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag %q\\n\", arg)\n\t\t\tos.Exit(2)\n\t\tdefault:\n\t\t\tpositional = append(positional, arg)\n\t\t}\n\t}\n\n\tif len(statuses) == 0 {\n\t\tfmt.Fprintln(os.Stderr, \"error: slice requires at least one --status flag\")\n\t\tos.Exit(2)\n\t}\n\tif len(positional) == 0 {\n\t\tfmt.Fprintln(os.Stderr, \"error: slice requires a report file\")\n\t\tos.Exit(2)\n\t}\n\tif len(positional) > 1 {\n\t\tfmt.Fprintln(os.Stderr, \"error: slice accepts exactly one report file\")\n\t\tos.Exit(2)\n\t}\n\n\tpath := positional[0]\n\tif _, err := os.Stat(path); err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\tfmt.Fprintf(os.Stderr, \"error: slice file not found: %s\\n\", path)\n\t\t} else {\n\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid slice input: %s: %s\\n\", path, err)\n\t\t}\n\t\tos.Exit(2)\n\t}\n\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error: inva"]
[6064.478971, "i", "lid slice input: %s: %s\\n\", path, err)\n\t\tos.Exit(2)\n\t}\n\n\tvar raw map[string]json.RawMessage\n\tif err := json.Unmarshal(data, &raw); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid slice input: %s: %s\\n\", path, err)\n\t\tos.Exit(2)\n\t}\n\n\tfor _, field := range []string{\"manifest_name\", \"overall_status\", \"steps\"} {\n\t\tif _, ok := raw[field]; !ok {\n\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid slice input: %s: missing field %s\\n\", path, field)\n\t\t\tos.Exit(2)\n\t\t}\n\t}\n\n\tvar r sliceReportLite\n\tif err := json.Unmarshal(data, &r); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid slice input: %s: %s\\n\", path, err)\n\t\tos.Exit(2)\n\t}\n\tif r.ManifestName == \"\" {\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid slice input: %s: missing field manifest_name\\n\", path)\n\t\tos.Exit(2)\n\t}\n\tif r.OverallStatus == \"\" {\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid slice input: %s: missing field overall_status\\n\", path)\n\t\tos.Exit(2)\n\t}\n\tif r.Steps == nil {\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid slice input: %s: missing field steps\\n\", path)\n\t\tos.Exi"]
