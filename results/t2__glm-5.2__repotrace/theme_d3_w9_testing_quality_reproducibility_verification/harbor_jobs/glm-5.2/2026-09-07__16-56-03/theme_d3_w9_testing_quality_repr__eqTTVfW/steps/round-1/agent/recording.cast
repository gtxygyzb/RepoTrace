[3786.390237, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n)\r\n\r\n"]
[3786.390326, "o", "type Policy struct {\r\n\tDefaultAction string       `json:\"default_action\"`\r\n\tRules         []PolicyRule `json:\"rules\"`\r\n}\r\n\r\ntype PolicyRule struct {\r\n\tID     string                 `json:\"id\"`\r\n\tType   string                 `json:\"type\"`\r\n\tParams map[string]interface{} `json:\"params\"`\r\n\tAction string                 `json:\"action\"`\r\n}\r\n\r\ntype policyEvaluation struct {\r\n\tPolicyOverallStatus   string            `json:\"policy_overall_status\"`\r\n\tDefaultAction         string            `json:\"default_action\"`\r\n\tRulesEvaluated        []policyRuleEval  `json:\"rules_evaluated\"`\r\n"]
[3786.390406, "o", "\tEffectiveStepStatuses map[string]string `json:\"effective_step_statuses\"`\r\n\tWarnings              []string          `json:\"warnings\"`\r\n}\r\n\r\ntype policyRuleEval struct {\r\n\tRuleID         string   `json:\"rule_id\"`\r\n\tRuleType       string   `json:\"rule_type\"`\r\n\tMatchedSteps   []string `json:\"matched_steps\"`\r\n\tMatchedOutputs []string `json:\"matched_outputs\"`\r\n\tAction         string   `json:\"action\"`\r\n\tEffect         string   `json:\"effect\"`\r\n\tDetails        string   `json:\"details\"`\r\n}\r\n"]
[3786.390493, "o", "\r\nvar policyRuleIDRe = regexp.MustCompile(`^[a-z][a-z0-9_-]{0,63}$`)\r\n\r\nfunc validatePolicy(p *Policy, stepIDs map[string]bool) error {\r\n\tif p == nil {\r\n\t\treturn nil\r\n\t}\r\n\tif p.DefaultAction == \"\" {\r\n\t\tp.DefaultAction = \"strict\"\r\n\t}\r\n\tswitch p.DefaultAction {\r\n\tcase \"strict\", \"lenient\":\r\n\tdefault:\r\n\t\treturn fmt.Errorf(\"invalid default_action: %q (must be \\\"strict\\\" or \\\"lenient\\\")\", p.DefaultAction)\r\n\t}\r\n\tif p.Rules == nil {\r\n\t\t"]
[3786.390566, "o", "p.Rules = []PolicyRule{}\r\n\t}\r\n\r\n\tseenRuleIDs := map[string]bool{}\r\n\tfor _, rule := range p.Rules {\r\n\t\tif !policyRuleIDRe.MatchString(rule.ID) {\r\n\t\t\treturn fmt.Errorf(\"invalid policy rule id: %q (must match ^[a-z][a-z0-9_-]{0,63}$)\", rule.ID)\r\n\t\t}\r\n\t\tif seenRuleIDs[rule.ID] {\r\n\t\t\treturn fmt.Errorf(\"duplicate policy rule id: %q\", rule.ID)\r\n\t\t}\r\n"]
[3786.390646, "o", "\t\tseenRuleIDs[rule.ID] = true\r\n\r\n\t\tswitch rule.Action {\r\n\t\tcase \"allow\", \"warn\", \"require\":\r\n\t\tdefault:\r\n\t\t\treturn fmt.Errorf(\"invalid policy action: %q (must be \\\"allow\\\", \\\"warn\\\", or \\\"require\\\")\", rule.Action)\r\n\t\t}\r\n\r\n\t\tswitch rule.Type {\r\n\t\tcase \"allow_variance\":\r\n\t\t\tif _, err := policyStringParam(rule, \"output_pattern\"); err != nil {\r\n\t\t\t\treturn err\r\n\t\t\t}\r\n"]
[3786.390715, "o", "\t\tcase \"min_consistency_rate\":\r\n\t\t\tif _, err := policyStringParam(rule, \"step_pattern\"); err != nil {\r\n\t\t\t\treturn err\r\n\t\t\t}\r\n\t\t\trate, err := policyFloatParam(rule, \"rate\")\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn err\r\n\t\t\t}\r\n\t\t\tif rate < 0.0 || rate > 1.0 {\r\n\t\t\t\treturn fmt.Errorf(\"invalid min_consistency_rate: rate must be between 0.0 and 1.0\")\r\n\t\t\t}\r\n\t"]
[3786.390784, "o", "\tcase \"required_steps\":\r\n\t\t\tsteps, err := policyStringSliceParam(rule, \"steps\")\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn err\r\n\t\t\t}\r\n\t\t\tfor _, stepID := range steps {\r\n\t\t\t\tif !stepIDs[stepID] {\r\n\t\t\t\t\treturn fmt.Errorf(\"unknown step in policy rule %q: %q\", rule.ID, stepID)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\tcase \"ignore_steps\":\r\n"]
[3786.390856, "o", "\t\t\tsteps, err := policyStringSliceParam(rule, \"steps\")\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn err\r\n\t\t\t}\r\n\t\t\tfor _, stepID := range steps {\r\n\t\t\t\tif !stepIDs[stepID] {\r\n\t\t\t\t\treturn fmt.Errorf(\"unknown step in policy rule %q: %q\", rule.ID, stepID)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\tdefault:\r\n\t\t\treturn fmt.Errorf(\"unknown policy rule type: %q\", rule.Type)"]
[3786.390921, "o", "\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc policyStringParam(rule PolicyRule, name string) (string, error) {\r\n\tv, ok := rule.Params[name]\r\n\tif !ok {\r\n\t\treturn \"\", fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t}\r\n\ts, ok := v.(string)\r\n\tif !ok {\r\n\t"]
[3786.391001, "o", "\treturn \"\", fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t}\r\n\treturn s, nil\r\n}\r\n\r\nfunc policyFloatParam(rule PolicyRule, name string) (float64, error) {\r\n\tv, ok := rule.Params[name]\r\n\tif !ok {\r\n\t\treturn 0, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t}\r\n\tf, ok := v.(float64)\r\n\tif !ok {\r\n\t\treturn 0, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n"]
[3786.391072, "o", "\t}\r\n\treturn f, nil\r\n}\r\n\r\nfunc policyStringSliceParam(rule PolicyRule, name string) ([]string, error) {\r\n\tv, ok := rule.Params[name]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t}\r\n\tarr, ok := v.([]interface{})\r\n\tif !ok {\r\n"]
[3786.391139, "o", "\t\treturn nil, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t}\r\n\tout := make([]string, 0, len(arr))\r\n\tfor _, item := range arr {\r\n\t\ts, ok := item.(string)\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t\t}\r\n\t\tout = append(out, s)\r\n\t}\r\n\treturn out, nil\r\n"]
[3786.391204, "o", "}\r\n\r\nfunc evaluatePolicy(m *Manifest, rep *report) *policyEvaluation {\r\n\tp := m.Policy\r\n\tif p == nil {\r\n\t\treturn nil\r\n\t}\r\n\tdefaultAction := p.DefaultAction\r\n\tif defaultAction == \"\" {\r\n\t\tdefaultAction = \"strict\"\r\n\t}\r\n\r\n\tstepByID := map[string]Step{}\r\n\tfor _, s := range m.Steps {\r\n"]
[3786.391268, "o", "\t\tstepByID[s.ID] = s\r\n\t}\r\n\r\n\trawStatus := map[string]string{}\r\n\tfor _, sr := range rep.Steps {\r\n\t\trawStatus[sr.ID] = sr.Status\r\n"]
[3786.391337, "o", "\t}\r\n\r\n\ttype outputState struct {\r\n\t\tbad       bool\r\n\t\teffective bool\r\n\t\tmatched   bool\r\n\t}\r\n\toutputs := map[string]map[string]*outputState{}\r\n\tfor _, sr := range rep.Steps {\r\n\t\tfor _, o := range sr.Outputs {\r\n\t\t\tif outputs[sr.ID] == nil {\r\n\t\t\t\toutputs[sr.ID] = map[string]*outputState{}\r\n\t\t\t}\r\n\t\t\tbad := !o.CrossPassConsistent || (o.ReferenceMatch != nil && !*o.ReferenceMatch)\r\n\t\t\toutputs[sr.ID][o.Path] = &outputState{\r\n\t\t\t\tbad:       bad,\r\n\t\t\t\teffective: !bad,\r\n\t\t\t}\r\n"]
[3786.391402, "o", "\t\t}\r\n\t}\r\n\r\n\tmatchedStepsAll := map[string]bool{}\r\n\tignoredSteps := map[string]bool{}\r\n\tmustPassSteps := map[string]bool{}\r\n\trequiredAllowListed := map[string]bool{}\r\n\thasRequiredAllow := false\r\n\trequireViolation := false\r\n\twarnings := []string{}\r\n\truleEvals := make([]policyRuleEval, 0, len(p.Rules))\r\n\r\n"]
[3786.391468, "o", "\tfor _, rule := range p.Rules {\r\n\t\tswitch rule.Type {\r\n\t\tcase \"allow_variance\":\r\n\t\t\tev := policyRuleEval{\r\n\t\t\t\tRuleID:   rule.ID,\r\n\t\t\t\tRuleType: rule.Type,\r\n\t\t\t\tAction:   rule.Action,\r\n\t\t\t\tEffect:   \"not_applicable\",\r\n\t\t\t}\r\n\t"]
[3786.391531, "o", "\t\tpattern, _ := policyStringParam(rule, \"output_pattern\")\r\n\t\t\tfor _, sr := range rep.Steps {\r\n\t\t\t\tif rawStatus[sr.ID] == \"ERROR\" || rawStatus[sr.ID] == \"TIMEOUT\" || rawStatus[sr.ID] == \"SKIPPED\" {\r\n"]
