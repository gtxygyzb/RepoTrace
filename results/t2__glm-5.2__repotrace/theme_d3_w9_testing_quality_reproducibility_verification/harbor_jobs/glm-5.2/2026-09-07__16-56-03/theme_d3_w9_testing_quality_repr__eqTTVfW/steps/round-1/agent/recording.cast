[2667.151493, "o", "    97\tfunc verifyCmd(args []string) {\r\n    98\t\tstepsFlag := \"\"\r\n    99\t\tcacheDir := \"\"\r\n   100\t\tpipelineRoot := \".\"\r\n   101\t\tpositional := parseFlags(args, map[string]*string{\r\n   102\t\t\t\"steps\":         &stepsFlag,\r\n   103\t\t\t\"cache-dir\":     &cacheDir,\r\n   104\t\t\t\"pipeline-root\": &pipelineRoot,\r\n"]
[2667.151554, "o", "   105\t\t})\r\n   106\t\tif len(positional) < 1 {\r\n   107\t\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify verify <manifest.json> [--steps ...] [--cache-dir ...] [--pipeline-root ...]\")\r\n   108\t\t\tos.Exit(2)\r\n   109\t\t}\r\n   110\t\tmanifestPath := positional[0]\r\n   111\t\tm, err := loadManifest(manifestPath)\r\n"]
