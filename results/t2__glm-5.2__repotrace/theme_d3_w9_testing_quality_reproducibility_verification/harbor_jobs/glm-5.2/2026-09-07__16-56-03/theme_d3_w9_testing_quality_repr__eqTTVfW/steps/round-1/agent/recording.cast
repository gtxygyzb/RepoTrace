[6600.655889, "i", "cat > cmd/repro-verify/export.go <<'EOF'\npackage main\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n)\n\ntype exportReport struct {\n\tManifestName  string       `json:\"manifest_name\"`\n\tOverallStatus string       `json:\"overall_status\"`\n\tSteps         []exportStep `json:\"steps\"`\n}\n\ntype exportStep struct {\n\tID      string            `json:\"id\"`\n\tStatus  string            `json:\"status\"`\n\tOutputs []json.RawMessage `json:\"outputs\"`\n}\n\nfunc exportCmd(args []string) {\n\tif len(args) != 1 {\n\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify export <report.json>\")\n\t\tos.Exit(2)\n\t}\n\n\tpath := args[0]\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\tfmt.Fprintf(os.Stderr, \"error: export file not found: %s\\n\", path)\n\t\t} else {\n\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid export input: %s: %s\\n\", path, err)\n\t\t}\n\t\tos.Exit(2)\n\t}\n\n\tvar raw map[string]json.RawMessage\n\tif err := json.Unmarshal(data, &raw); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error: invalid export input: %s: %s\\n\", path, err)\n\t\tos.Exit(2)\n\t}\n\n\tfo"]
