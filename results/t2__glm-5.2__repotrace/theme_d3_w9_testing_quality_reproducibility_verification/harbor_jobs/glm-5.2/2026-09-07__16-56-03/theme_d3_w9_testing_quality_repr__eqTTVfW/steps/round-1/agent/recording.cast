[5907.042711, "o", "    53\t\t\tfmt.Fprintln(os.Stderr, \"error: trend requires at least two report files\")\r\n    54\t\t\tos.Exit(2)\r\n    55\t\t}\r\n    56\t\r\n    57\t\treports := make([]*trendReportLite, 0, len(positional))\r\n    58\t\tfor _, path := range positional {\r\n"]
