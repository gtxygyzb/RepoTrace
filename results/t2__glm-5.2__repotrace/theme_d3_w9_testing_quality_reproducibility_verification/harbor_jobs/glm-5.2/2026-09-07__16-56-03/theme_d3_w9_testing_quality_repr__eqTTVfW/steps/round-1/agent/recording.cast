[3796.562989, "o", "   312\t\t\t\t\t\t\t\tev.Details = fmt.Sprintf(\"majority rate %.3f below required %.3f\", majorityRate, rate)\r\n   313\t\t\t\t\t\t\t} else {\r\n   314\t\t\t\t\t\t\t\tev.Effect = \"applied\"\r\n   315\t\t\t\t\t\t\t\tev.Details = \"required majority rate satisfied\"\r\n   316\t\t\t\t\t\t\t}\r\n   317\t\t\t\t\t\t}\r\n   318\t\t\t\t\t}\r\n   319\t\t\t\t}\r\n   320\t\t\t\tsort.Strings(ev.MatchedSteps)\r\n   321\t\t\t\tsort.Strings(ev.MatchedOutputs)\r\n   322\t\t\t\truleEvals = append(ruleEvals, ev)\r\n   323\t\r\n   324\t\t\tcase \"required_steps\":\r\n   325\t\t\t\tev := policyRuleEval{\r\n"]
