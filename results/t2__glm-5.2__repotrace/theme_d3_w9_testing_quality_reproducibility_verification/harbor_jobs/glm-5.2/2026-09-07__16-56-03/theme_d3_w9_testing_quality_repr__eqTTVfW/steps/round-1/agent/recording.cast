[3817.487526, "o", "\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KOverallStatus\u001b[m\u001b[K      string `json:\"\u001b[01;31m\u001b[Koverall_status\u001b[m\u001b[K\"`\r\n"]
[3817.487824, "o", "\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KPolicyEvaluation\u001b[m\u001b[K    *\u001b[01;31m\u001b[KpolicyEvaluation\u001b[m\u001b[K `json:\"policy_evaluation,omitempty\"`\r\n"]
[3817.487911, "o", "\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif rep.\u001b[01;31m\u001b[KPolicyEvaluation\u001b[m\u001b[K != nil {\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tswitch rep.\u001b[01;31m\u001b[KPolicyEvaluation\u001b[m\u001b[K.Policy\u001b[01;31m\u001b[KOverallStatus\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tswitch rep.\u001b[01;31m\u001b[KOverallStatus\u001b[m\u001b[K {\r\n"]
[3817.488033, "o", "\u001b[32m\u001b[K725\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\trep.\u001b[01;31m\u001b[KOverallStatus\u001b[m\u001b[K = \"ERROR\"\r\n\u001b[32m\u001b[K727\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\trep.\u001b[01;31m\u001b[KOverallStatus\u001b[m\u001b[K = \"FAIL\"\r\n"]
[3817.488104, "o", "\u001b[32m\u001b[K729\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\trep.\u001b[01;31m\u001b[KOverallStatus\u001b[m\u001b[K = \"PASS\"\r\n"]
