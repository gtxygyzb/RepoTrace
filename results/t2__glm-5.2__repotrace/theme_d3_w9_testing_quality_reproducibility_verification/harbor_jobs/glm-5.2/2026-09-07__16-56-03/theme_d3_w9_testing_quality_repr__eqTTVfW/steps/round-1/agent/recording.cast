[3796.836566, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"sort\"\r\n"]
[3796.83667, "o", "     8\t\t\"time\"\r\n     9\t)\r\n    10\t\r\n    11\ttype diffReport struct {\r\n    12\t\tBaseline            diffReportMeta       `json:\"baseline\"`\r\n    13\t\tCurrent             diffReportMeta       `json:\"current\"`\r\n    14\t\tComparisonTimestamp string               `json:\"comparison_timestamp\"`\r\n    15\t\tStatusTransition    diffStatusTransition `json:\"status_transition\"`\r\n    16\t\tStepChanges         []diffStepChange     `json:\"step_changes\"`\r\n    17\t\tSummary             diffSummary          `json:\"summary\"`\r\n    18\t}\r\n    19\t\r\n    20\ttype diffReportMeta struct {\r\n    21\t\tManifestName    string `json:\"manifest_name\"`\r\n    22\t\tManifestVersion string `json:\"manifest_version\"`\r\n    23\t\tOverallStatus   string `json:\"overall_status\"`\r\n"]
[3796.836747, "o", "    24\t\tTimestamp       string `json:\"timestamp\"`\r\n    25\t}\r\n    26\t\r\n    27\ttype diffStatusTransition struct {\r\n    28\t\tFrom string `json:\"from\"`\r\n    29\t\tTo   string `json:\"to\"`\r\n    30\t\tType string `json:\"type\"`\r\n    31\t}\r\n    32\t\r\n    33\ttype diffStepChange struct {\r\n    34\t\tStepID           string             `json:\"step_id\"`\r\n    35\t"]
[3796.836812, "o", "\tChangeType       string             `json:\"change_type\"`\r\n    36\t\tBaselineStatus   *string            `json:\"baseline_status\"`\r\n    37\t\tCurrentStatus    *string            `json:\"current_status\"`\r\n    38\t\tStatusTransition *string            `json:\"status_transition\"`\r\n    39\t\tOutputChanges    []diffOutputChange `json:\"output_changes\"`\r\n    40\t}\r\n    41\t\r\n    42\ttype diffOutputChange struct {\r\n    43\t\tPath       string           `json:\"path\"`\r\n    44\t"]
[3796.836874, "o", "\tChangeType string           `json:\"change_type\"`\r\n    45\t\tDetails    diffOutputDetail `json:\"details\"`\r\n    46\t}\r\n    47\t\r\n    48\ttype diffOutputDetail struct {\r\n    49\t\tBaselineFingerprints   []string `json:\"baseline_fingerprints\"`\r\n    50\t\tCurrentFingerprints    []string `json:\"current_fingerprints\"`\r\n    51\t\tBaselineConsistent     *bool    `json:\"baseline_consistent\"`\r\n    52\t\tCurrentConsistent      *bool    `json:\"current_consistent\"`\r\n"]
[3796.837012, "o", "    53\t\tBaselineReferenceMatch *bool    `json:\"baseline_reference_match\"`\r\n    54\t\tCurrentReferenceMatch  *bool    `json:\"current_reference_match\"`\r\n    55\t}\r\n    56\t\r\n    57\ttype diffSummary struct {\r\n    58\t\tStepsAdded         int `json:\"steps_added\"`\r\n    59\t\tStepsRemoved       int `json:\"steps_removed\"`\r\n    60\t\tStepsModified      int `json:\"steps_modified\"`\r\n"]
[3796.837152, "o", "    61\t\tStepsUnchanged     int `json:\"steps_unchanged\"`\r\n    62\t\tRegressions        int `json:\"regressions\"`\r\n    63\t\tImprovements       int `json:\"improvements\"`\r\n    64\t\tTotalOutputChanges int `json:\"total_output_changes\"`\r\n    65\t}\r\n    66\t\r\n    67\ttype diffReportLite struct {\r\n    68\t\tManifestName    string       `json:\"manifest_name\"`\r\n    69\t\tManifestVersion string       `json:\"manifest_version\"`\r\n    70\t\tOverallStatus   string       `json:\"overall_status\"`\r\n    71\t\tTimestamp       string       `json:\"timestamp\"`\r\n    72\t\tSteps           []stepReport `json:\"steps\"`\r\n    73\t}\r\n    74\t\r\n    75\tfunc diffCmd(args []string) {\r\n    76\t\tformat := \"json\"\r\n"]
[3796.837226, "o", "    77\t\tpositional := parseFlags(args, map[string]*string{\r\n    78\t\t\t\"format\": &format,\r\n    79\t\t})\r\n    80\t\tif len(positional) != 2 {\r\n    81\t\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify diff <baseline.json> <current.json> [--format json|text]\")\r\n    82\t\t\tos.Exit(2)\r\n    83\t\t}\r\n    84\t\r\n    85\t\tbaseline, err := loadDiffReport(positional[0], \"baseline\")\r\n    86\t\tif err != nil {\r\n    87\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    88\t\t\tos.Exit(2)\r\n    89\t\t}\r\n    90\t\tcurrent, err := loadDiffReport(positional[1], \"current\")\r\n    91\t\tif err != nil {\r\n    92\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    93\t\t\tos.Exit(2)\r\n    94\t\t}\r\n    95\t\r\n    96\t\tdiff := buildDiffReport(baseline, current)\r\n    97\t\r\n    98\t\tif format == \"text\" {\r\n    99\t\t\tprintDiffText(diff)\r\n   100\t\t} else {\r\n   101\t\t\tout, err := json.MarshalIndent(diff, \"\", \"  \")\r\n   102\t\t\t"]
[3796.837294, "o", "if err != nil {\r\n   103\t\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   104\t\t\t\tos.Exit(2)\r\n   105\t\t\t}\r\n   106\t\t\tfmt.Println(string(out))\r\n"]
[3796.837357, "o", "   107\t\t}\r\n   108\t\r\n   109\t\tif diff.Summary.Regressions > 0 {\r\n   110\t\t\tos.Exit(1)\r\n   111\t\t}\r\n   112\t\tos.Exit(0)\r\n   113\t}\r\n   114\t\r\n   115\tfunc loadDiffReport(path, role string) (*diffReportLite, error) {\r\n   116\t\tif _, err := os.Stat(path); err != nil {\r\n   117\t\t\tif os.IsNotExist(err) {\r\n   118\t\t\t\treturn nil, fmt.Errorf(\"error: diff %s not found: %s\", role, path)\r\n   119\t\t\t}\r\n"]
[3796.837422, "o", "   120\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n   121\t\t}\r\n   122\t\tdata, err := os.ReadFile(path)\r\n   123\t\tif err != nil {\r\n   124\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n   125\t\t}\r\n   126\t\tvar raw map[string]json.RawMessage\r\n   127\t\tif err := json.Unmarshal(data, &raw); err != nil {\r\n   128\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n   129\t\t}\r\n   130\t\tfor _, field := range []string{\"manifest_name\", \"overall_status\", \"steps\"} {\r\n"]
[3796.83748, "o", "   131\t\t\tif _, ok := raw[field]; !ok {\r\n   132\t\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: missing field %s\", path, field)\r\n   133\t\t\t}\r\n   134\t\t}\r\n   135\t\tvar r diffReportLite\r\n   136\t\tif err := json.Unmarshal(data, &r); err != nil {\r\n   137\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n   138\t\t}\r\n   139\t\tif r.ManifestName == \"\" {\r\n"]
[3796.837543, "o", "   140\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: missing field manifest_name\", path)\r\n   141\t\t}\r\n   142\t\tif r.OverallStatus == \"\" {\r\n   143\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: missing field overall_status\", path)\r\n   144\t\t}\r\n   145\t\tif r.Steps == nil {\r\n   146\t\t\tr.Steps = []stepReport{}\r\n   147\t\t}\r\n   148\t\treturn &r, nil\r\n   149\t}\r\n   150\t\r\n   151\t"]
[3796.8376, "o", "func buildDiffReport(baseline, current *diffReportLite) *diffReport {\r\n   152\t\tbaselineSteps := map[string]stepReport{}\r\n   153\t\tfor _, s := range baseline.Steps {\r\n   154\t\t\tbaselineSteps[s.ID] = s\r\n   155\t\t}\r\n   156\t\tcurrentSteps := map[string]stepReport{}\r\n   157\t\tfor _, s := range current.Steps {\r\n   158\t\t\tcurrentSteps[s.ID] = s\r\n   159\t\t}\r\n"]
[3796.837667, "o", "   160\t\r\n   161\t\tstepIDs := map[string]bool{}\r\n   162\t\tfor id := range baselineSteps {\r\n   163\t\t\tstepIDs[id] = true\r\n   164\t\t}\r\n   165\t\tfor id := range currentSteps {\r\n"]
[3796.837731, "o", "   166\t\t\tstepIDs[id] = true\r\n   167\t\t}\r\n   168\t\r\n   169\t\tids := make([]string, 0, len(stepIDs))\r\n   170\t\tfor id := range stepIDs {\r\n   171\t\t\tids = append(ids, id)\r\n   172\t\t}\r\n   173\t\tsort.Strings(ids)\r\n   174\t\r\n   175\t\tchanges := make([]diffStepChange, 0, len(ids))\r\n   176\t\tsummary := diffSummary{}\r\n   177\t\r\n   178\t\tfor _, id := range ids {\r\n   179\t\t\tb, hasB := baselineSteps[id]\r\n"]
[3796.837788, "o", "   180\t\t\tc, hasC := currentSteps[id]\r\n   181\t\r\n   182\t\t\tchange := diffStepChange{\r\n   183\t\t\t\tStepID: id,\r\n   184\t\t\t}\r\n   185\t\t\tif hasB {\r\n   186\t\t\t\tbs := b.Status\r\n   187\t\t\t\tchange.BaselineStatus = &bs\r\n"]
[3796.837847, "o", "   188\t\t\t}\r\n   189\t\t\tif hasC {\r\n   190\t\t\t\tcs := c.Status\r\n   191\t\t\t\tchange.CurrentStatus = &cs\r\n   192\t\t\t}\r\n   193\t\r\n   194\t\t\tswitch {\r\n   195\t\t\tcase hasC && !hasB:\r\n   196\t\t\t\tchange.ChangeType = \"added\"\r\n"]
[3796.837906, "o", "   197\t\t\t\tsummary.StepsAdded++\r\n   198\t\t\t\tsummary.TotalOutputChanges += len(c.Outputs)\r\n   199\t\t\tcase hasB && !hasC:\r\n   200\t\t\t\tchange.ChangeType = \"removed\"\r\n   201\t\t\t\tsummary.StepsRemoved++\r\n   202\t\t\t\tsummary.TotalOutputChanges += len(b.Outputs)\r\n   203\t\t\tdefault:\r\n   204\t\t\t\toutputChanges, outputChanged := diffStepOutputs(b, c)\r\n   205\t\t\t\tchange.OutputChanges = outputChanges\r\n"]
[3796.837986, "o", "   206\t\t\t\tif outputChanged || !stepEqual(b, c) {\r\n   207\t\t\t\t\tchange.ChangeType = \"modified\"\r\n   208\t\t\t\t\tsummary.StepsModified++\r\n   209\t\t\t\t} else {\r\n   210\t\t\t\t\tchange.ChangeType = \"unchanged\"\r\n   211\t\t\t\t\tsummary.StepsUnchanged++\r\n   212\t\t\t\t\tchange.OutputChanges = []diffOutputChange{}\r\n   213\t\t\t\t}\r\n   214\t\t\t\tfor _, oc := range outputChanges {\r\n"]
[3796.838048, "o", "   215\t\t\t\t\tif oc.ChangeType != \"unchanged\" {\r\n   216\t\t\t\t\t\tsummary.TotalOutputChanges++\r\n   217\t\t\t\t\t}\r\n   218\t\t\t\t}\r\n   219\t\t\t}\r\n   220\t\r\n   221\t\t\tif hasB && hasC {\r\n   222\t\t\t\ttr := statusTransitionType(b.Status, c.Status)\r\n"]
[3796.838104, "o", "   223\t\t\t\tchange.StatusTransition = &tr\r\n   224\t\t\t\tif tr == \"regression\" {\r\n   225\t\t\t\t\tsummary.Regressions++\r\n   226\t\t\t\t} else if tr == \"improvement\" {\r\n   227\t\t\t\t\tsummary.Improvements++\r\n   228\t\t\t\t}\r\n   229\t\t\t}\r\n   230\t\r\n"]
[3796.838165, "o", "   231\t\t\tchanges = append(changes, change)\r\n   232\t\t}\r\n   233\t\r\n   234\t\treturn &diffReport{\r\n   235\t\t\tBaseline: diffReportMeta{\r\n   236\t\t\t\tManifestName:    baseline.ManifestName,\r\n   237\t\t\t\tManifestVersion: baseline.ManifestVersion,\r\n   238\t\t\t\tOverallStatus:   baseline.OverallStatus,\r\n"]
[3796.838229, "o", "   239\t\t\t\tTimestamp:       baseline.Timestamp,\r\n   240\t\t\t},\r\n   241\t\t\tCurrent: diffReportMeta{\r\n   242\t\t\t\tManifestName:    current.ManifestName,\r\n   243\t\t\t\tManifestVersion: current.ManifestVersion,\r\n   244\t\t\t\tOverallStatus:   current.OverallStatus,\r\n   245\t\t\t\tTimestamp:       current.Timestamp,\r\n   246\t\t\t},\r\n   247\t\t\tComparisonTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n   248\t\t\tStatusTransition: diffStatusTransition{\r\n"]
[3796.838288, "o", "   249\t\t\t\tFrom: baseline.OverallStatus,\r\n   250\t\t\t\tTo:   current.OverallStatus,\r\n   251\t\t\t\tType: statusTransitionType(baseline.OverallStatus, current.OverallStatus),\r\n   252\t\t\t},\r\n   253\t\t\tStepChanges: changes,\r\n   254\t\t\tSummary:     summary,\r\n   255\t\t}\r\n   256\t}\r\n   257\t\r\n   258\t"]
[3796.838351, "o", "func diffStepOutputs(b, c stepReport) ([]diffOutputChange, bool) {\r\n   259\t\tbOutputs := map[string]outputReport{}\r\n   260\t\tfor _, o := range b.Outputs {\r\n   261\t\t\tbOutputs[o.Path] = o\r\n   262\t\t}\r\n   263\t\tcOutputs := map[string]outputReport{}\r\n   264\t\tfor _, o := range c.Outputs {\r\n   265\t\t\tcOutputs[o.Path] = o\r\n"]
[3796.838411, "o", "   266\t\t}\r\n   267\t\r\n   268\t\tpaths := map[string]bool{}\r\n   269\t\tfor p := range bOutputs {\r\n   270\t\t\tpaths[p] = true\r\n   271\t\t}\r\n   272\t\tfor p := range cOutputs {\r\n   273\t\t\tpaths[p] = true\r\n   274\t\t}\r\n   275\t\r\n"]
[3796.838472, "o", "   276\t\tvar keys []string\r\n   277\t\tfor p := range paths {\r\n   278\t\t\tkeys = append(keys, p)\r\n   279\t\t}\r\n   280\t\tsort.Strings(keys)\r\n"]
