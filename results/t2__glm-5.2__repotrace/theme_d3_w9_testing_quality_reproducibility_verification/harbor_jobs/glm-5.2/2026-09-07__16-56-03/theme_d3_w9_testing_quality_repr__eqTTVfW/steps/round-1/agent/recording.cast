[4056.572197, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('cmd/repro-verify/summary.go')\ns = p.read_text()\ns = s.replace('import (\\n\\t\"encoding/json\"\\n\\t\"fmt\"\\n\\t\"os\"\\n)', 'import (\\n\\t\"encoding/json\"\\n\\t\"fmt\"\\n\\t\"os\"\\n\\t\"time\"\\n)')\ns = s.replace('type summaryOutput struct {\\n\\tReports   []summaryReportEntry `json:\"reports\"`\\n\\tAggregate summaryAggregate     `json:\"aggregate\"`\\n}', 'type summaryOutput struct {\\n\\tSummaryTimestamp string             `json:\"summary_timestamp\"`\\n\\tReports         []summaryReportEntry `json:\"reports\"`\\n\\tAggregate       summaryAggregate     `json:\"aggregate\"`\\n}')\ns = s.replace('\\tout := summaryOutput{\\n\\t\\tReports:   entries,\\n\\t\\tAggregate: aggregate,\\n\\t}', '\\tout := summaryOutput{\\n\\t\\tSummaryTimestamp: time.Now().UTC().Format(time.RFC3339),\\n\\t\\tReports:         entries,\\n\\t\\tAggregate:       aggregate,\\n\\t}')\np.write_text(s)\nPY\n"]
[4056.572484, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
