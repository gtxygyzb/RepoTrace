[6502.906515, "o", "\u001b[35m\u001b[Kdocs/spec_v6.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Krepro-verify \u001b[01;31m\u001b[Kexport\u001b[m\u001b[K <report.json>\r\n\u001b[35m\u001b[Kdocs/spec_v6.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KReads a verification report JSON file and \u001b[01;31m\u001b[Kexport\u001b[m\u001b[Ks the step-level data as CSV to stdout.\r\n\u001b[35m\u001b[Kdocs/spec_v6.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  - `error: \u001b[01;31m\u001b[Kexport\u001b[m\u001b[K file not found: <path>`\r\n"]
[6502.906582, "o", "\u001b[35m\u001b[Kdocs/spec_v6.md\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  - `error: invalid \u001b[01;31m\u001b[Kexport\u001b[m\u001b[K input: <path>: <reason>`\r\n"]
