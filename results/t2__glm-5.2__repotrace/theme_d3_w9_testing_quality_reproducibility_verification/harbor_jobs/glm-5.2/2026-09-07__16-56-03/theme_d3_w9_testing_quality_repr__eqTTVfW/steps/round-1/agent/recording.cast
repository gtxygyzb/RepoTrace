[1170.524124, "o", "} else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.524196, "o", "rep.Summary.InconsistentOutputs++\r\n\u001b[?2004l\r\u001b[?2004h> }"]
[1170.524252, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
