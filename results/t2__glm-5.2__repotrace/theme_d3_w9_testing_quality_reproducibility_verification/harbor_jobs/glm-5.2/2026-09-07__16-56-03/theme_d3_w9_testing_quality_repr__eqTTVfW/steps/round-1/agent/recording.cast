[5616.039418, "i", "\t}\n\tif statusChanges >= 2 {\n\t\treturn \"flaky\"\n\t}\n\n\tfirstRank := statusRank(firstStatus)\n\tlastRank := statusRank(lastStatus)\n\tif lastRank < firstRank {\n\t\treturn \"degrading\"\n\t}\n\tif lastRank > firstRank {\n\t\treturn \"improving\"\n\t}\n\treturn \"stable\"\n}\n\nfunc statusRank(status string) int {\n\tswitch status {\n\tcase \"PASS\":\n\t\treturn 4\n\tcase \"FAIL\":\n\t\treturn 3\n\tcase \"ERROR\":\n\t\treturn 2\n\tcase \"TIMEOUT\":\n\t\treturn 1\n\tcase \"SKIPPED\":\n\t\treturn 0\n\tdefault:\n\t\treturn -1\n\t}\n}\n\nfunc printTrendText(output *trendOutput) {\n\theader := fmt.Sprintf(\"Trend Analysis (%d reports)\", output.ReportCount)\n\tfmt.Println(header)\n\tfmt.Println(strings.Repeat(\"=\", len(header)))\n\n\tfor _, step := range output.StepTrends {\n\t\tstatusParts := make([]string, 0, len(step.Statuses))\n\t\tfor _, status := range step.Statuses {\n\t\t\tif status == nil {\n\t\t\t\tstatusParts = append(statusParts, \"-\")\n\t\t\t} else {\n\t\t\t\tstatusParts = append(statusParts, *status)\n\t\t\t}\n\t\t}\n\t\tfmt.Printf(\"%s  %s  [%s]  stability=%.2f\\n\", step.StepID, step.Classification, strings.Join(statusParts, \""]
