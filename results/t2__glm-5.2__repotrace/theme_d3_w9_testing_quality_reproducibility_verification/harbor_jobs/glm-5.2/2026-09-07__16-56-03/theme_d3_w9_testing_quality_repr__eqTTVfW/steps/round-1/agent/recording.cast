[4249.521083, "o", "\r\n\u001b[?2004l\r"]
[4249.52403, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[4249.524142, "o", "\t\"os\"\r\n\t\"time\"\r\n)\r\n\r\ntype summaryReportInput struct {\r\n\tManifestName    string       `json:\"manifest_name\"`\r\n\tManifestVersion string       `json:\"manifest_version\"`\r\n\tOverallStatus   string       `json:\"overall_status\"`\r\n\tSteps           []stepReport `json:\"steps\"`\r\n}\r\n\r\ntype summaryReportEntry struct {\r\n\tFile            string  `json:\"file\"`\r\n\tManifestName    string  `json:\"manifest_name\"`\r\n\tManifestVersion string  `json:\"manifest_version\"`\r\n\tOverallStatus   string  `json:\"overall_status\"`\r\n\tStepCount       int     `json:\"step_count\"`\r\n\tPassCount       int     `json:\"pass_count\"`\r\n\tFailCount       int     `json:\"fail_count\"`\r\n\tPassRate        float64 `json:\"pass_rate\"`\r\n}\r\n\r\ntype summaryAggregate struct {\r\n"]
[4249.524194, "o", "\tTotalReports    int     `json:\"total_reports\"`\r\n\tTotalSteps      int     `json:\"total_steps\"`\r\n\tTotalPass       int     `json:\"total_pass\"`\r\n\tTotalFail       int     `json:\"total_fail\"`\r\n\tOverallPassRate float64 `json:\"overall_pass_rate\"`\r\n\tAllPassing      bool    `json:\"all_passing\"`\r\n}\r\n"]
[4249.524309, "o", "\r\ntype summaryOutput struct {\r\n\tSummaryTimestamp string               `json:\"summary_timestamp\"`\r\n\tReports          []summaryReportEntry `json:\"reports\"`\r\n\tAggregate        summaryAggregate     `json:\"aggregate\"`\r\n}\r\n\r\nfunc summaryCmd(args []string) {\r\n\tif len(args) == 0 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: summary requires at least one report file\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n\tformat := \"json\"\r\n\tpositional := []string{}\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\tswitch args[i] {\r\n\t\tcase \"--format\":\r\n\t\t\ti++\r\n\t\t\tif i >= len(args) {\r\n"]
[4249.524414, "o", "\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --format requires an argument\")\r\n\t\t\t\tos.Exit(2)\r\n\t\t\t}\r\n\t\t\tformat = args[i]\r\n\t\t\tif format != \"json\" && format != \"text\" {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format %q\\n\", format)\r\n\t\t\t\tos.Exit(2)\r\n\t\t\t}\r\n\t\tcase \"--format=json\":\r\n\t\t\tformat = \"json\"\r\n\t\tcase \"--format=text\":\r\n\t\t\tformat = \"text\"\r\n\t\tdefault:\r\n\t\t\tif len(args[i]) > 0 && args[i][0] == '-' {\r\n"]
[4249.52449, "o", "\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag %q\\n\", args[i])\r\n\t\t\t\tos.Exit(2)\r\n\t\t\t}\r\n\t\t\tpositional = append(positional, args[i])\r\n\t\t}\r\n\t}\r\n\r\n\tif len(positional) == 0 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: summary requires at least one report file\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n\tentries := make([]summaryReportEntry, 0, len(positional))\r\n\taggregate := summaryAggregate{}\r\n\tallPassing := true"]
[4249.52456, "o", "\r\n\r\n\tfor _, path := range positional {\r\n\t\tif _, err := os.Stat(path); err != nil {\r\n\t\t\tif os.IsNotExist(err) {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: summary file not found: %s\\n\", path)\r\n\t\t\t} else {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: %s\\n\", path, err)\r\n\t\t\t}\r\n\t\t\tos.Exit(2)\r\n\t"]
[4249.524635, "o", "\t}\r\n\r\n\t\tdata, err := os.ReadFile(path)\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: %s\\n\", path, err)\r\n\t\t\tos.Exit(2)\r\n\t\t}\r\n\r\n\t\tvar rep summaryReportInput\r\n\t\tif err := json.Unmarshal(data, &rep); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: %s\\n\", path, err)\r\n\t\t\tos.Exit(2)\r\n\t\t}\r\n"]
[4249.524708, "o", "\r\n\t\tif rep.ManifestName == \"\" {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: missing field manifest_name\\n\", path)\r\n\t\t\tos.Exit(2)\r\n\t\t}\r\n\t\tif rep.OverallStatus == \"\" {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: missing field overall_status\\n\", path)\r\n\t\t\tos.Exit(2)\r\n\t\t}\r\n\t\tif rep.Steps == nil {\r\n"]
[4249.524783, "o", "\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: missing field steps\\n\", path)\r\n\t\t\tos.Exit(2)\r\n\t\t}\r\n\r\n\t\tstepCount := len(rep.Steps)\r\n\t\tpassCount := 0\r\n\t\tfor _, sr := range rep.Steps {\r\n\t\t\tif sr.Status == \"PASS\" {\r\n\t\t\t\tpassCount++\r\n\t\t\t}\r\n\t\t}\r\n\t\tfailCount := stepCount - passCount\r\n"]
[4249.524853, "o", "\t\tpassRate := 1.0\r\n\t\tif stepCount != 0 {\r\n\t\t\tpassRate = float64(passCount) / float64(stepCount)\r\n\t\t}\r\n\r\n\t\tentries = append(entries, summaryReportEntry{\r\n\t\t\tFile:            path,\r\n\t\t\tManifestName:    rep.ManifestName,\r\n\t\t\tManifestVersion: rep.ManifestVersion,\r\n\t\t\tOverallStatus:   rep.OverallStatus,\r\n\t\t\tStepCount:       stepCount,\r\n"]
[4249.524922, "o", "\t\t\tPassCount:       passCount,\r\n\t\t\tFailCount:       failCount,\r\n\t\t\tPassRate:        passRate,\r\n\t\t})\r\n\r\n\t\taggregate.TotalReports++\r\n\t\taggregate.TotalSteps += stepCount\r\n\t\taggregate.TotalPass += passCount\r\n\t\taggregate.TotalFail += failCount\r\n"]
[4249.525019, "o", "\t\tif rep.OverallStatus != \"PASS\" {\r\n\t\t\tallPassing = false\r\n\t\t}\r\n\t}\r\n\r\n\taggregate.OverallPassRate = 1.0\r\n\tif aggregate.TotalSteps != 0 {\r\n\t\taggregate.OverallPassRate = float64(aggregate.TotalPass) / float64(aggregate.TotalSteps)\r\n\t}\r\n\taggregate.AllPassing = allPassing\r\n\r\n\tout := summaryOutput{\r\n\t\tSummaryTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n\t\tReports:          entries,"]
[4249.525103, "o", "\r\n\t\tAggregate:        aggregate,\r\n\t}\r\n\r\n\tif format == \"text\" {\r\n\t\tfor _, r := range out.Reports {\r\n\t\t\tfmt.Printf(\"%s@%s  %s  %d/%d steps  (%.1f%%)\\n\", r.ManifestName, r.ManifestVersion, r.OverallStatus, r.PassCount, r.StepCount, r.PassRate*100)\r\n\t\t}\r\n\t\tfmt.Println(\"---\")\r\n\t\tfmt.Printf(\"%d reports, %d total steps, %.1f%% pass rate\\n\", aggregate.TotalReports, aggregate.TotalSteps, aggregate.OverallPassRate*100)\r\n\t} else {\r\n\t\tdata, err := json.MarshalIndent(out, \"\", \"  \")\r\n\t"]
[4249.52518, "o", "\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n\t\t\tos.Exit(2)\r\n\t\t}\r\n\t\tfmt.Println(string(data))\r\n\t}\r\n\r\n\tif allPassing {\r\n\t\tos.Exit(0)\r\n\t}\r\n\tos.Exit(1)\r\n}\r\n"]
