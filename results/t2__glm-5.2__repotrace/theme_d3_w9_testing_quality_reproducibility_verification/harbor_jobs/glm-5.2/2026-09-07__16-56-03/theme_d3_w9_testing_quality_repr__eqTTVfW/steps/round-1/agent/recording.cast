[5701.438417, "o", "{\r\n  \"trend_timestamp\": \"2026-09-07T10:32:55Z\",\r\n  \"report_count\": 3,\r\n  \"step_trends\": [\r\n    {\r\n      \"step_id\": \"a\",\r\n      \"statuses\": [\r\n        \"FAIL\",\r\n        \"PASS\",\r\n        \"PASS\"\r\n      ],\r\n      \"first_seen_index\": 0,\r\n      \"last_seen_index\": 2,\r\n      \"status_changes\": 1,\r\n      \"stability\": 0.5,\r\n      \"classification\": \"improving\"\r\n    },\r\n    {\r\n      \"step_id\": \"b\",\r\n      \"statuses\": [\r\n        \"PASS\",\r\n        null,\r\n        \"TIMEOUT\"\r\n      ],\r\n      \"first_seen_index\": 0,\r\n      \"last_seen_index\": 2,\r\n      \"status_changes\": 1,\r\n      \"stability\": 0,\r\n      \"classification\": \"degrading\"\r\n    },\r\n    {\r\n      \"step_id\": \"c\",\r\n      \"statuses\": [\r\n        null,\r\n        \"FAIL\",\r\n        \"FAIL\"\r\n      ],\r\n      \"first_seen_index\": 1,\r\n      \"last_seen_index\": 2,\r\n      \"status_changes\": 0,\r\n      \"stability\": 1,\r\n      \"classification\": \"stable\"\r\n    }\r\n  ],\r\n  \"aggregate\": {\r\n    \"total_steps_tracked\": 3,\r\n    \"stable_count\": 1,\r\n    \"flaky_count\": 0,\r\n    \"degrading_count\": 1,\r\n    \"impr"]
[5701.438533, "o", "oving_count\": 1,\r\n    \"overall_stability\": 0.5\r\n  }\r\n}\r\n"]
