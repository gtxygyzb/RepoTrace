[5390.084202, "o", "\tdiff := buildDiffReport(baseline, current)\r\n    97\t\r\n    98\t\tif format == \"text\" {\r\n    99\t\t\tprintDiffText(diff)\r\n   100\t\t} else {\r\n   101\t\t\tout, err := json.MarshalIndent(diff, \"\", \"  \")\r\n"]
[5390.084248, "o", "   102\t\t\tif err != nil {\r\n   103\t\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n   104\t\t\t\tos.Exit(2)\r\n   105\t\t\t}\r\n   106\t\t\tfmt.Println(string(out))\r\n   107\t\t}\r\n   108\t\r\n"]
[5390.084296, "o", "   109\t\tif diff.Summary.Regressions > 0 {\r\n   110\t\t\tos.Exit(1)\r\n   111\t\t}\r\n   112\t\tos.Exit(0)\r\n   113\t}\r\n"]
[5390.084345, "o", "   114\t\r\n   115\tfunc loadDiffReport(path, role string) (*diffReportLite, error) {\r\n   116\t\tif _, err := os.Stat(path); err != nil {\r\n   117\t\t\tif os.IsNotExist(err) {\r\n   118\t\t\t\treturn nil, fmt.Errorf(\"error: diff %s not found: %s\", role, path)\r\n   119\t\t\t}\r\n   120\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n"]
[5390.084393, "o", "   121\t\t}\r\n   122\t\tdata, err := os.ReadFile(path)\r\n   123\t\tif err != nil {\r\n   124\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n   125\t\t}\r\n   126\t\tvar raw map[string]json.RawMessage\r\n   127\t\tif err := json.Unmarshal(data, &raw); err != nil {\r\n"]
[5390.084441, "o", "   128\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n   129\t\t}\r\n   130\t\tfor _, field := range []string{\"manifest_name\", \"overall_status\", \"steps\"} {\r\n   131\t\t\tif _, ok := raw[field]; !ok {\r\n   132\t\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: missing field %s\", path, field)\r\n   133\t\t\t}\r\n   134\t\t}\r\n"]
[5390.084491, "o", "   135\t\tvar r diffReportLite\r\n   136\t\tif err := json.Unmarshal(data, &r); err != nil {\r\n   137\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: %s\", path, err)\r\n   138\t\t}\r\n   139\t\tif r.ManifestName == \"\" {\r\n   140\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: missing field manifest_name\", path)\r\n"]
[5390.084548, "o", "   141\t\t}\r\n   142\t\tif r.OverallStatus == \"\" {\r\n   143\t\t\treturn nil, fmt.Errorf(\"error: invalid report: %s: missing field overall_status\", path)\r\n   144\t\t}\r\n   145\t\tif r.Steps == nil {\r\n   146\t\t\tr.Steps = []stepReport{}\r\n   147\t\t}\r\n   148\t\treturn &r, nil\r\n   149\t}\r\n"]
[5390.084616, "o", "   150\t\r\n   151\tfunc buildDiffReport(baseline, current *diffReportLite) *diffReport {\r\n   152\t\tbaselineSteps := map[string]stepReport{}\r\n   153\t\tfor _, s := range baseline.Steps {\r\n   154\t\t\tbaselineSteps[s.ID] = s\r\n   155\t\t}\r\n   156\t\tcurrentSteps := map[string]stepReport{}\r\n   157\t\tfor _, s := range current.Steps {\r\n   158\t\t\tcurrentSteps[s.ID] = s\r\n   159\t\t}\r\n   160\t\r\n   161\t\t"]
[5390.084664, "o", "stepIDs := map[string]bool{}\r\n   162\t\tfor id := range baselineSteps {\r\n   163\t\t\tstepIDs[id] = true\r\n   164\t\t}\r\n   165\t\tfor id := range currentSteps {\r\n"]
[5390.08471, "o", "   166\t\t\tstepIDs[id] = true\r\n   167\t\t}\r\n   168\t\r\n   169\t\tids := make([]string, 0, len(stepIDs))\r\n   170\t\tfor id := range stepIDs {\r\n   171\t\t\tids = append(ids, id)\r\n   172\t\t}\r\n"]
[5390.084757, "o", "   173\t\tsort.Strings(ids)\r\n   174\t\r\n   175\t\tchanges := make([]diffStepChange, 0, len(ids))\r\n   176\t\tsummary := diffSummary{}\r\n   177\t\r\n   178\t\tfor _, id := range ids {\r\n   179\t\t\t"]
[5390.084804, "o", "b, hasB := baselineSteps[id]\r\n   180\t\t\tc, hasC := currentSteps[id]\r\n   181\t\r\n   182\t\t\tchange := diffStepChange{\r\n   183\t\t\t\tStepID: id,\r\n   184\t\t\t}\r\n   185\t\t\tif hasB {\r\n   186"]
[5390.084849, "o", "\t\t\t\tbs := b.Status\r\n   187\t\t\t\tchange.BaselineStatus = &bs\r\n   188\t\t\t}\r\n   189\t\t\tif hasC {\r\n   190\t\t\t\tcs := c.Status\r\n"]
[5390.0849, "o", "   191\t\t\t\tchange.CurrentStatus = &cs\r\n   192\t\t\t}\r\n   193\t\r\n   194\t\t\tswitch {\r\n   195\t\t\tcase hasC && !hasB:\r\n   196\t\t\t\tchange.ChangeType = \"added\"\r\n   197\t\t\t\tsummary.StepsAdded++\r\n   198\t\t\t\tsummary.TotalOutputChanges += len(c.Outputs)\r\n"]
[5390.084955, "o", "   199\t\t\tcase hasB && !hasC:\r\n   200\t\t\t\tchange.ChangeType = \"removed\"\r\n   201\t\t\t\tsummary.StepsRemoved++\r\n   202\t\t\t\tsummary.TotalOutputChanges += len(b.Outputs)\r\n   203\t\t\tdefault:\r\n   204\t\t\t\toutputChanges, outputChanged := diffStepOutputs(b, c)\r\n   205\t\t\t\tchange.OutputChanges = outputChanges\r\n"]
[5390.085004, "o", "   206\t\t\t\tif outputChanged || !stepEqual(b, c) {\r\n   207\t\t\t\t\tchange.ChangeType = \"modified\"\r\n   208\t\t\t\t\tsummary.StepsModified++\r\n   209\t\t\t\t} else {\r\n   210\t\t\t\t\tchange.ChangeType = \"unchanged\"\r\n   211\t\t\t\t\tsummary.StepsUnchanged++\r\n   212\t\t\t\t\tchange.OutputChanges = []diffOutputChange{}\r\n"]
[5390.085052, "o", "   213\t\t\t\t}\r\n   214\t\t\t\tfor _, oc := range outputChanges {\r\n   215\t\t\t\t\tif oc.ChangeType != \"unchanged\" {\r\n   216\t\t\t\t\t\tsummary.TotalOutputChanges++\r\n   217\t\t\t\t\t}\r\n   218\t\t"]
[5390.085093, "o", "\t\t}\r\n   219\t\t\t}\r\n   220\t\r\n   221\t\t\tif hasB && hasC {\r\n"]
[5390.085139, "o", "   222\t\t\t\ttr := statusTransitionType(b.Status, c.Status)\r\n   223\t\t\t\tchange.StatusTransition = &tr\r\n   224\t\t\t\tif tr == \"regression\" {\r\n   225\t\t\t\t\tsummary.Regressions++\r\n   226\t\t\t\t} else if tr == \"improvement\" {\r\n   227\t\t\t\t\tsummary.Improvements++\r\n   228\t\t\t\t}\r\n   229\t\t\t}\r\n"]
[5390.085191, "o", "   230\t\r\n   231\t\t\tchanges = append(changes, change)\r\n   232\t\t}\r\n   233\t\r\n   234\t\treturn &diffReport{\r\n   235\t\t\tBaseline: diffReportMeta{\r\n   236\t\t\t\tManifestName:    baseline.ManifestName,\r\n"]
[5390.085239, "o", "   237\t\t\t\tManifestVersion: baseline.ManifestVersion,\r\n   238\t\t\t\tOverallStatus:   baseline.OverallStatus,\r\n   239\t\t\t\tTimestamp:       baseline.Timestamp,\r\n   240\t\t\t},\r\n   241\t\t\tCurrent: diffReportMeta{\r\n"]
[5390.085289, "o", "   242\t\t\t\tManifestName:    current.ManifestName,\r\n   243\t\t\t\tManifestVersion: current.ManifestVersion,\r\n   244\t\t\t\tOverallStatus:   current.OverallStatus,\r\n   245\t\t\t\tTimestamp:       current.Timestamp,\r\n   246\t\t\t},\r\n   247\t\t\tComparisonTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n   248\t\t"]
[5390.085339, "o", "\tStatusTransition: diffStatusTransition{\r\n   249\t\t\t\tFrom: baseline.OverallStatus,\r\n   250\t\t\t\tTo:   current.OverallStatus,\r\n   251\t\t\t\tType: statusTransitionType(baseline.OverallStatus, current.OverallStatus),\r\n   252\t\t\t},\r\n   253\t\t\tStepChanges: changes,\r\n   254\t\t\tSummary:     summary,\r\n"]
[5390.085387, "o", "   255\t\t}\r\n   256\t}\r\n   257\t\r\n   258\tfunc diffStepOutputs(b, c stepReport) ([]diffOutputChange, bool) {\r\n   259\t\tbOutputs := map[string]outputReport{}\r\n   260\t\tfor _, o := range b.Outputs {\r\n"]
