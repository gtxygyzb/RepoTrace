[5907.043428, "o", "   131\t\r\n   132\t\tfor i, rep := range reports {\r\n   133\t\t\tstatusByID := make(map[string]string)\r\n   134\t\t\tfor _, step := range rep.Steps {\r\n   135\t\t\t\tstatusByID[step.ID] = step.Status\r\n   136\t\t\t\tstepIDs[step.ID] = true\r\n   137\t\t\t}\r\n   138\t\t\treportStepStatus[i] = statusByID\r\n   139\t\t}\r\n   140\t\r\n   141\t\tids := make([]string, 0, len(stepIDs))\r\n"]
[5907.043494, "o", "   142\t\tfor id := range stepIDs {\r\n   143\t\t\tids = append(ids, id)\r\n   144\t\t}\r\n   145\t\tsort.Strings(ids)\r\n   146\t\r\n   147\t\tstepTrends := make([]trendStep, 0, len(ids))\r\n   148\t\tvar stableCount, flakyCount, degradingCount, improvingCount int\r\n   149\t\tvar stabilitySum float64\r\n   150\t\r\n   151\t\tfor _, id := range ids {\r\n"]
[5907.043549, "o", "   152\t\t\tstatuses := make([]*string, reportCount)\r\n   153\t\t\tappearances := 0\r\n   154\t\t\tfirstSeenIndex := -1\r\n   155"]
[5907.043605, "o", "\t\t\tlastSeenIndex := -1\r\n   156\t\t\tvar firstStatus, lastStatus string\r\n   157\t\r\n   158\t\t\tfor i, statusByID := range reportStepStatus {\r\n   159\t\t\t\tif status, ok := statusByID[id]; ok {\r\n   160\t\t\t\t\tstatusCopy := status\r\n   161\t\t\t\t\tstatuses[i] = &statusCopy\r\n   162\t\t\t\t\tappearances++\r\n   163\t\t\t\t\tif firstSeenIndex == -1 {\r\n   164\t\t\t\t\t\tfirstSeenIndex = i\r\n   165\t\t\t\t\t\tfirstStatus = status\r\n   166\t\t\t\t\t}\r\n"]
[5907.043659, "o", "   167\t\t\t\t\tlastSeenIndex = i\r\n   168\t\t\t\t\tlastStatus = status\r\n   169\t\t\t\t}\r\n"]
[5907.043715, "o", "   170\t\t\t}\r\n   171\t\r\n   172\t\t\tstatusChanges := 0\r\n   173\t\t\tvar prev *string\r\n   174\t\t\tfor _, status := range statuses {\r\n   175\t\t\t\tif status == nil {\r\n   176\t\t"]
[5907.043777, "o", "\t\t\tcontinue\r\n   177\t\t\t\t}\r\n   178\t\t\t\tif prev != nil && *prev != *status {\r\n   179\t\t\t\t\tstatusChanges++\r\n   180\t\t\t\t}\r\n"]
