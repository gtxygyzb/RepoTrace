[5924.81012, "o", "\t}\r\n   232\t\r\n   233\tfunc classifyTrendStep(statusChanges int, firstStatus, lastStatus string) string {\r\n   234\t\tif statusChanges == 0 {\r\n   235\t\t\treturn \"stable\"\r\n   236\t\t}\r\n   237\t\tif statusChanges >= 2 {\r\n   238\t\t\treturn \"flaky\"\r\n   239\t\t}\r\n   240\t\r\n   241\t\tfirstRank := statusRank(firstStatus)\r\n   242\t\tlastRank := statusRank(lastStatus)\r\n"]
[5924.810216, "o", "   243\t\tif lastRank < firstRank {\r\n   244\t\t\treturn \"degrading\"\r\n   245\t\t}\r\n   246\t\tif lastRank > firstRank {\r\n   247\t\t\treturn \"improving\"\r\n   248\t\t}\r\n   249\t\treturn \"stable\"\r\n   250\t}\r\n   251\t\r\n   252\tfunc statusRank(status string) int {\r\n   253\t\tswitch status {\r\n   254\t\tcase \"PASS\":\r\n   255\t\t\treturn 4\r\n   256\t\tcase \"FAIL\":\r\n   257\t\t\treturn 3\r\n   258\t\tcase \"ERROR\":\r\n   259\t\t\treturn 2\r\n   260\t\tcase \"TIMEOUT\":\r\n   261\t\t\treturn 1\r\n   262\t\tcase \"SKIPPED\":\r\n   263\t\t\treturn 0\r\n   264\t\tdefault:\r\n   265\t\t\treturn -1\r\n   266\t\t}\r\n   267\t}\r\n   268\t"]
[5924.810298, "o", "\r\n   269\tfunc printTrendText(output *trendOutput) {\r\n   270\t\theader := fmt.Sprintf(\"Trend Analysis (%d reports)\", output.ReportCount)\r\n   271\t\tfmt.Println(header)\r\n   272\t\tfmt.Println(strings.Repeat(\"=\", len(header)))\r\n   273\t\r\n   274"]
[5924.81038, "o", "\t\tfor _, step := range output.StepTrends {\r\n   275\t\t\tstatusParts := make([]string, 0, len(step.Statuses))\r\n"]
