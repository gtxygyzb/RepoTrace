[5377.883713, "o", "\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K### \u001b[01;31m\u001b[K17.\u001b[m\u001b[K3 Text Output Format\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K### \u001b[01;31m\u001b[K17.\u001b[m\u001b[K4 Exit Codes\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K### \u001b[01;31m\u001b[K17.\u001b[m\u001b[K5 Input Validation\r\n"]
