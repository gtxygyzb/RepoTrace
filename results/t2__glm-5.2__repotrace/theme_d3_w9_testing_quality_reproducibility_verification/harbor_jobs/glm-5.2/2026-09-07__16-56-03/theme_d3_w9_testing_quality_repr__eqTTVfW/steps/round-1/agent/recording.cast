[3796.562331, "o", "   249\t\t\t\t\t\t\t}\r\n   250\t\t\t\t\t\tcase \"require\":\r\n   251\t\t\t\t\t\t\tif !st.bad {\r\n   252\t\t\t\t\t\t\t\trequireViolation = true\r\n   253\t\t\t\t\t\t\t\tev.Effect = \"violation\"\r\n   254\t\t\t\t\t\t\t\tev.Details = \"output is consistent but rule requires variance\"\r\n   255\t\t\t"]
[3796.56239, "o", "\t\t\t\t} else {\r\n   256\t\t\t\t\t\t\t\tev.Effect = \"applied\"\r\n   257\t\t\t\t\t\t\t\tev.Details = \"required variance present for matched outputs\"\r\n   258\t\t\t\t\t\t\t}\r\n   259\t\t\t\t\t\t}\r\n   260\t\t\t\t\t}\r\n   261\t\t\t\t"]
