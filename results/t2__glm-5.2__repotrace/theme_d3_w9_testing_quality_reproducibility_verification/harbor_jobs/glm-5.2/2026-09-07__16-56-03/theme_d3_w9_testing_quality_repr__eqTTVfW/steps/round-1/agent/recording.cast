[5979.726483, "o", "}\r\n\r\nfunc statusRank(status string) int {\r\n\tswitch status {\r\n\tcase \"PASS\":\r\n\t\treturn 4\r\n\tcase \"FAIL\":\r\n\t\treturn 1\r\n\tcase \"ERROR\":\r\n\t\treturn 2\r\n"]
[5979.726604, "o", "\tcase \"TIMEOUT\":\r\n\t\treturn 3\r\n\tcase \"SKIPPED\":\r\n\t\treturn 0\r\n\tdefault:\r\n\t\treturn -1\r\n\t}\r\n}\r\n\r\n"]
