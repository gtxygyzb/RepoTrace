[2719.462188, "o", "\u001b[32m\u001b[K12\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[K13. Verification Policy Engine\r\n"]
[2719.462289, "o", "\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K13.1 Policy Section in Manifest\r\n\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K13.2 Rule Schema\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K13.3 Rule Types\r\n\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K#### \u001b[m\u001b[K`allow_variance`\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K#### \u001b[m\u001b[K`min_consistency_rate`\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K#### \u001b[m\u001b[K`required_steps`\r\n\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K#### \u001b[m\u001b[K`ignore_steps`\r\n\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K13.4 Policy Evaluation Flow\r\n\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K13.5 Report Additions\r\n"]
[2719.462373, "o", "\u001b[32m\u001b[K175\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K13.6 Exit Code with Policy\r\n\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K13.7 Policy Validation Errors\r\n\u001b[32m\u001b[K199\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K## \u001b[m\u001b[K14. `diff` Subcommand\r\n\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K14.1 Usage\r\n\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K14.2 JSON Output Schema\r\n\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K14.3 Comparison Logic\r\n\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K14.4 Text Output Format\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K14.5 Exit Codes\r\n\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K### \u001b[m\u001b[K14.6 Input Validation"]
[2719.462497, "o", "\r\n"]
