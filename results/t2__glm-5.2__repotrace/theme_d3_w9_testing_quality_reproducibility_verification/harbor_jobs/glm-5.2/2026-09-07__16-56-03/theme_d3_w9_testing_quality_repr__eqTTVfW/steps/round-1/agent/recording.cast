[4014.985027, "o", "\r\n\u001b[?2004l\r\u001b[?2004hroot@n30009:/app# "]
[4015.955493, "i", "sed -n '1,220p' cmd/repro-verify/summary.go\n"]
[4015.955833, "o", "sed -n '1,220p' cmd/repro-verify/summary.go\r\n"]
[4015.955877, "o", "\u001b[?2004l\r"]
[4015.95876, "o", "package main\r\n\r\nimport (\r\n\"encoding/json\"\r\n\"fmt\"\r\n\"os\"\r\n)\r\n"]
[4015.958847, "o", "\r\ntype summaryReportInput struct {\r\nManifestName    string       `json:\"manifest_name\"`\r\nManifestVersion string       `json:\"manifest_version\"`\r\nOverallStatus   string       `json:\"overall_status\"`\r\nSteps           []stepReport `json:\"steps\"`\r\n}\r\n\r\ntype summaryReportEntry struct {\r\nFile             string  `json:\"file\"`\r\nManifestName     string  `json:\"manifest_name\"`\r\nManifestVersion  string  `json:\"manifest_version\"`\r\nOverallStatus    string  `json:\"overall_status\"`\r\nStepCount        int     `json:\"step_count\"`\r\nPassCount        int     `json:\"pass_count\"`\r\nFailCount        int     `json:\"fail_count\"`\r\nPassRate         float64 `json:\"pass_rate\"`\r\n}\r\n\r\ntype summaryAggregate struct {\r\n"]
[4015.95889, "o", "TotalReports     int     `json:\"total_reports\"`\r\nTotalSteps       int     `json:\"total_steps\"`\r\nTotalPass        int     `json:\"total_pass\"`\r\nTotalFail        int     `json:\"total_fail\"`\r\nOverallPassRate  float64 `json:\"overall_pass_rate\"`\r\nAllPassing       bool    `json:\"all_passing\"`\r\n}\r\n\r\ntype summaryOutput struct {\r\n"]
[4015.958946, "o", "Reports   []summaryReportEntry `json:\"reports\"`\r\nAggregate summaryAggregate     `json:\"aggregate\"`\r\n}\r\n\r\nfunc summaryCmd(args []string) {\r\nif len(args) == 0 {\r\nfmt.Fprintln(os.Stderr, \"error: summary requires at least one report file\")\r\n"]
[4015.958982, "o", "os.Exit(2)\r\n}\r\n\r\nformat := \"json\"\r\npositional := []string{}\r\nfor i := 0; i < len(args); i++ {\r\nswitch args[i] {\r\ncase \"--format\":\r\ni++\r\n"]
[4015.959015, "o", "if i >= len(args) {\r\nfmt.Fprintln(os.Stderr, \"error: --format requires an argument\")\r\nos.Exit(2)\r\n}"]
[4015.95905, "o", "\r\nformat = args[i]\r\nif format != \"json\" && format != \"text\" {\r\nfmt.Fprintf(os.Stderr, \"error: invalid format %q\\n\", format)\r\nos.Exit(2)\r\n}\r\ncase \"--format=json\":\r\nformat = \"json\"\r\ncase \"--format=text\":\r\nformat = \"text\"\r\ndefault:\r\n"]
[4015.959082, "o", "if len(args[i]) > 0 && args[i][0] == '-' {\r\nfmt.Fprintf(os.Stderr, \"error: unknown flag %q\\n\", args[i])\r\nos.Exit(2)\r\n}\r\npositional = append(positional, args[i])\r\n}\r\n"]
[4015.959114, "o", "}\r\n\r\nif len(positional) == 0 {\r\nfmt.Fprintln(os.Stderr, \"error: summary requires at least one report file\")\r\nos.Exit(2)\r\n}\r\n\r\n"]
[4015.959148, "o", "entries := make([]summaryReportEntry, 0, len(positional))\r\naggregate := summaryAggregate{}\r\nallPassing := true\r\n\r\n"]
[4015.959181, "o", "for _, path := range positional {\r\nif _, err := os.Stat(path); err != nil {\r\nif os.IsNotExist(err) {\r\nfmt.Fprintf(os.Stderr, \"error: summary file not found: %s\\n\", path)\r\n} else {\r\nfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: %s\\n\", path, err)\r\n}\r\nos.Exit(2)\r\n}\r\n\r\n"]
[4015.959211, "o", "data, err := os.ReadFile(path)\r\nif err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: %s\\n\", path, err)\r\nos.Exit(2)\r\n}\r\n\r\nvar rep summaryReportInput\r\n"]
[4015.959239, "o", "if err := json.Unmarshal(data, &rep); err != nil {\r\nfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: %s\\n\", path, err)\r\nos.Exit(2)\r\n}\r\n\r\n"]
[4015.959268, "o", "if rep.ManifestName == \"\" {\r\nfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: missing field manifest_name\\n\", path)\r\nos.Exit(2)\r\n}\r\nif rep.OverallStatus == \"\" {\r\nfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: missing field overall_status\\n\", path)\r\nos.Exit(2)\r\n}\r\n"]
[4015.959297, "o", "if rep.Steps == nil {\r\nfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: missing field steps\\n\", path)\r\nos.Exit(2)\r\n}\r\n\r\nstepCount := len(rep.Steps)\r\npassCount := 0\r\n"]
[4015.959328, "o", "for _, sr := range rep.Steps {\r\nif sr.Status == \"PASS\" {\r\npassCount++\r\n}\r\n}\r\nfailCount := stepCount - passCount\r\n"]
[4015.959359, "o", "passRate := 1.0\r\nif stepCount != 0 {\r\npassRate = float64(passCount) / float64(stepCount)\r\n}\r\n\r\nentries = append(entries, summaryReportEntry{\r\nFile:            path,\r\nManifestName:    rep.ManifestName,\r\nManifestVersion: rep.ManifestVersion,\r\n"]
[4015.959387, "o", "OverallStatus:   rep.OverallStatus,\r\nStepCount:       stepCount,\r\nPassCount:       passCount,\r\nFailCount:       failCount,\r\nPassRate:        passRate,\r\n})\r\n"]
[4015.95942, "o", "\r\naggregate.TotalReports++\r\naggregate.TotalSteps += stepCount\r\naggregate.TotalPass += passCount\r\n"]
[4015.959451, "o", "aggregate.TotalFail += failCount\r\nif rep.OverallStatus != \"PASS\" {\r\nallPassing = false\r\n}\r\n}\r\n\r\naggregate.OverallPassRate = 1.0\r\nif aggregate.TotalSteps != 0 {\r\naggregate.OverallPassRate = float64(aggregate.TotalPass) / float64(aggregate.TotalSteps)\r\n"]
[4015.959481, "o", "}\r\naggregate.AllPassing = allPassing\r\n\r\nout := summaryOutput{\r\nReports:   entries,\r\nAggregate: aggregate,\r\n"]
[4015.959508, "o", "}\r\n\r\nif format == \"text\" {\r\nfor _, r := range out.Reports {\r\n"]
[4015.95954, "o", "fmt.Printf(\"%s@%s  %s  %d/%d steps  (%.1f%%)\\n\", r.ManifestName, r.ManifestVersion, r.OverallStatus, r.PassCount, r.StepCount, r.PassRate*100)\r\n}\r\nfmt.Println(\"---\")\r\nfmt.Printf(\"%d reports, %d total steps, %.1f%% pass rate\\n\", aggregate.TotalReports, aggregate.TotalSteps, aggregate.OverallPassRate*100)\r\n} else {\r\ndata, err := json.MarshalIndent(out, \"\", \"  \")\r\nif err != nil {\r\n"]
[4015.959569, "o", "fmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\nos.Exit(2)\r\n}\r\nfmt.Println(string(data))\r\n}"]
[4015.959597, "o", "\r\n\r\nif allPassing {\r\nos.Exit(0)\r\n}\r\nos.Exit(1)\r\n}\r\n"]
[4015.960076, "o", "\u001b[?2004h"]
[4015.960114, "o", "root@n30009:/app# "]
[4016.241176, "i", "sed -n '1,40p' cmd/repro-verify/main.go\n"]
[4016.241405, "o", "sed -n '1,40p' cmd/repro-verify/main.go\r\n\u001b[?2004l\r"]
[4016.242524, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify <verify|fingerprint|graph|diff|summary> ...\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\tswitch os.Args[1] {\r\n\tcase \"verify\":\r\n\t\tverifyCmd(os.Args[2:])\r\n\tcase \"fingerprint\":\r\n\t\tfingerprintCmd(os.Args[2:])\r\n\tcase \"graph\":\r\n\t\tgraphCmd(os.Args[2:])\r\n\tcase \"diff\":\r\n\t\tdiffCmd(os.Args[2:])\r\n\tcase \"summary\":\r\n\t\tsummaryCmd(os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unknown subcommand %q\\n\", os.Args[1])\r\n\t\tos.Exit(2)\r\n\t}\r\n}\r\n"]
[4016.242717, "o", "\u001b[?2004hroot@n30009:/app# "]
[4016.498767, "i", "go build ./...\n"]
[4016.4991, "o", "go build ./...\r\n\u001b[?2004l\r"]
[4018.70261, "o", "\u001b[?2004hroot@n30009:/app# "]
[4037.645848, "i", "sed -n '30,130p' docs/spec_v3.md\n"]
[4037.646179, "o", "sed -n '30,130p' docs/spec_v3.md\r\n\u001b[?2004l\r"]
[4037.649062, "o", "---\r\n\r\n## 16. Summary Subcommand\r\n\r\n### 16.1 Usage\r\n\r\n```\r\n"]
[4037.649131, "o", "repro-verify summary <report1.json> [report2.json ...]\r\n```\r\n\r\nReads one or more verification report JSON files and produces a concise summary.\r\n\r\n**Flags:**\r\n| Flag | Type | Default | Description |\r\n|------|------|---------|-------------|\r\n| `--format` | string | `\"json\"` | Output format: `\"json\"` or `\"text\"`. |\r\n\r\n### 16.2 JSON Output Schema\r\n"]
[4037.649321, "o", "\r\n```json\r\n{\r\n  \"summary_timestamp\": \"<RFC3339>\",\r\n  \"reports\": [\r\n    {\r\n      \"file\": \"<path>\",\r\n      \"manifest_name\": \"<string>\",\r\n      \"manifest_version\": \"<string>\",\r\n      \"overall_status\": \"<string>\",\r\n      \"step_count\": <integer>,\r\n      \"pass_count\": <integer>,\r\n      \"fail_count\": <integer>,\r\n      \"pass_rate\": <float>\r\n    }\r\n  ],\r\n  \"aggregate\": {\r\n    \"total_reports\": <integer>,\r\n    \"total_steps\": <integer>,\r\n    \"total_pass\": <integer>,\r\n    \"total_fail\": <integer>,\r\n    \"overall_pass_rate\": <float>,\r\n    \"all_passing\": <boolean>\r\n  }\r\n}\r\n```\r\n\r\n**Field details:**\r\n- `reports`: One entry per input file, in the order provided on the command line.\r\n- `file`: The file path as given on the command line.\r\n- `step_count`: Total number of steps in the report.\r\n- `pass_count`: Number of steps with status `\"PASS\"`.\r\n- `fail_count`: Number of steps with status other than `\"PASS\"` (includes `\"FAIL\"`, `\"ERROR\"`, `\"TIMEOUT\"`, `\"SKIPPED\"`).\r\n- `pass_rate`: `pass_count / step_count`, as a float between 0.0"]
[4037.649431, "o", " and 1.0. If `step_count` is 0, `pass_rate` is 1.0.\r\n- `aggregate.total_steps`: Sum of all `step_count` values.\r\n- `aggregate.total_pass`: Sum of all `pass_count` values.\r\n- `aggregate.total_fail`: Sum of all `fail_count` values.\r\n- `aggregate.overall_pass_rate`: `total_pass / total_steps`. If `total_steps` is 0, 1.0.\r\n- `aggregate.all_passing`: `true` if every report has `overall_status == \"PASS\"`, `false` otherwise.\r\n\r\n### 16.3 Text Output Format\r\n\r\n```\r\n<manifest_name>@<version>  <overall_status>  <pass_count>/<step_count> steps  (<pass_rate_pct>%)\r\n...\r\n---\r\n"]
[4037.649544, "o", "<total_reports> reports, <total_steps> total steps, <overall_pass_rate_pct>% pass rate\r\n```\r\n\r\nEach report is on one line. The pass rate percentage is formatted to one decimal place (e.g., `66.7%`, `100.0%`). Reports are listed in input order.\r\n\r\n### 16.4 Exit Codes\r\n\r\n| Code | Meaning |\r\n|------|---------|\r\n| `0` | All reports have `overall_status == \"PASS\"`. |\r\n| `1` | At least one report has `overall_status != \"PASS\"`. |\r\n| `2` | Error (file not found, invalid JSON, not a valid report, no arguments). |\r\n\r\n### 16.5 Input Validation\r\n\r\n- At least one report file must be provided. If no arguments are given, exit with code 2 and print: `error: summary requires at least one report file`.\r\n- Each file must exist, be valid JSON, and contain at minimum `manifest_name`, `overall_status`, and `steps` array. If any file fails validation, exit with code 2 and print to stderr:\r\n  - `error: summary file not found: <path>`\r\n  - `error: invalid summary input: <path>: <reason>`\r\n"]
