[1448.620148, "i", "cat > cmd/repro-verify/util.go <<'EOF'\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"strings\"\n)\n\nfunc parseFlags(args []string, defs map[string]*string) []string {\n\tpositionals := []string{}\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tname := strings.TrimPrefix(arg, \"--\")\n\t\t\tvar value string\n\t\t\tif idx := strings.IndexByte(name, '='); idx >= 0 {\n\t\t\t\tvalue = name[idx+1:]\n\t\t\t\tname = name[:idx]\n\t\t\t} else {\n\t\t\t\tif i+1 >= len(args) {\n\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: flag --%s requires a value\\n\", name)\n\t\t\t\t\tos.Exit(2)\n\t\t\t\t}\n\t\t\t\ti++\n\t\t\t\tvalue = args[i]\n\t\t\t}\n\t\t\tptr, ok := defs[name]\n\t\t\tif !ok {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag --%s\\n\", name)\n\t\t\t\tos.Exit(2)\n\t\t\t}\n\t\t\t*ptr = value\n\t\t} else {\n\t\t\tpositionals = append(positionals, arg)\n\t\t}\n\t}\n\treturn positionals\n}\nEOF\n"]
