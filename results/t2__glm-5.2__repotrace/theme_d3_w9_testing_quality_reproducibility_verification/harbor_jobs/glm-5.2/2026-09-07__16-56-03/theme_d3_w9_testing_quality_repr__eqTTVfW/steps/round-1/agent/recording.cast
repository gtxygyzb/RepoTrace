[5761.756106, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n"]
[5761.756142, "o", "\t\"strings\"\r\n)\r\n\r\nfunc parseFlags(args []string, defs map[string]*string) []string {\r\n\tpositionals := []string{}\r\n\tfor i := 0; i < len(args); i++ {\r\n"]
[5761.756368, "o", "\t\targ := args[i]\r\n\t\tif strings.HasPrefix(arg, \"--\") {\r\n\t\t\tname := strings.TrimPrefix(arg, \"--\")\r\n\t\t\tvar value string\r\n\t\t\tif idx := strings.IndexByte(name, '='); idx >= 0 {\r\n\t\t\t\tvalue = name[idx+1:]\r\n\t\t\t\tname = name[:idx]\r\n\t\t\t} else {\r\n\t\t\t\tif i+1 >= len(args) {\r\n\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: flag --%s requires a value\\n\", name)\r\n\t\t\t\t\tos.Exit(2)\r\n\t\t\t\t}\r\n\t\t\t\ti++\r\n\t\t\t\tvalue = args[i]\r\n\t\t\t}\r\n\t\t\tptr, ok := defs[name]\r\n\t\t\tif !ok {\r\n\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag --%s\\n\", name)\r\n\t\t\t\tos.Exit(2)\r\n\t\t\t}\r\n\t\t\t*ptr = value\r\n\t\t} else {\r\n\t\t\tpositionals = append(positionals, arg)"]
[5761.756481, "o", "\r\n\t\t}\r\n\t}\r\n\treturn positionals\r\n}\r\n"]
[5761.757006, "o", "\u001b[?2004h"]
[5761.757089, "o", "root@n30009:/app# "]
[5762.043717, "i", "sed -n '77,92p' docs/spec_v4.md\n"]
[5762.04405, "o", "sed -n '77,92p' docs/spec_v4.md\r\n\u001b[?2004l\r"]
[5762.047036, "o", "### 17.3 Text Output Format\r\n\r\n```\r\nTrend Analysis (<N> reports)\r\n==========================\r\n<step_id>  <classification>  [<s1>, <s2>, ...]  stability=<value>\r\n...\r\n---\r\n"]
[5762.047149, "o", "<total> steps: <stable> stable, <flaky> flaky, <degrading> degrading, <improving> improving\r\nOverall stability: <pct>%\r\n```\r\n\r\n- Each step on one line. Status values are comma-separated. Null entries display as `-`.\r\n- Stability value is formatted to two decimal places (e.g., `0.50`, `1.00`).\r\n- Overall stability percentage is formatted to one decimal place (e.g., `75.0%`, `100.0%`).\r\n- Steps are listed in alphabetical order by `step_id`.\r\n"]
[5762.047592, "o", "\u001b[?2004h"]
[5762.047666, "o", "root@n30009:/app# "]
