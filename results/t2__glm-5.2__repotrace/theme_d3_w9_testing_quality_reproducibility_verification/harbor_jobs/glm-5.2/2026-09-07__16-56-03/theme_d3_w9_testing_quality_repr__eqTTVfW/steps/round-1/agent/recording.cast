[3807.533421, "i", "sed -n '120,230p' cmd/repro-verify/policy.go\n"]
[3807.533771, "o", "sed -n '120,230p' cmd/repro-verify/policy.go\r\n\u001b[?2004l\r"]
[3807.536855, "o", "\t\treturn \"\", fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t}\r\n\ts, ok := v.(string)\r\n\tif !ok {\r\n\t\treturn \"\", fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t}\r\n"]
[3807.536945, "o", "\treturn s, nil\r\n}\r\n\r\nfunc policyFloatParam(rule PolicyRule, name string) (float64, error) {\r\n\tv, ok := rule.Params[name]\r\n\tif !ok {\r\n\t\treturn 0, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t}\r\n\tf, ok := v.(float64)\r\n\tif !ok {\r\n\t\treturn 0, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t}\r\n\treturn f, nil\r\n}\r\n\r\n"]
[3807.537016, "o", "func policyStringSliceParam(rule PolicyRule, name string) ([]string, error) {\r\n\tv, ok := rule.Params[name]\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t}\r\n\tarr, ok := v.([]interface{})\r\n\tif !ok {\r\n\t\treturn nil, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t}\r\n\tout := make([]string, 0, len(arr))\r\n\tfor _, item := range arr {\r\n"]
[3807.537077, "o", "\t\ts, ok := item.(string)\r\n\t\tif !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"policy rule %q missing required param: %q\", rule.ID, name)\r\n\t\t}\r\n\t\tout = append(out, s)\r\n\t}\r\n\treturn out, nil\r\n}\r\n\r\n"]
[3807.53713, "o", "func evaluatePolicy(m *Manifest, rep *report) *policyEvaluation {\r\n\tp := m.Policy\r\n\tif p == nil {\r\n\t\treturn nil\r\n"]
[3807.537188, "o", "\t}\r\n\tdefaultAction := p.DefaultAction\r\n\tif defaultAction == \"\" {\r\n\t\tdefaultAction = \"strict\"\r\n\t}\r\n\r\n\tstepByID := map[string]Step{}\r\n\tfor _, s := range m.Steps {\r\n\t\tstepByID[s.ID] = s\r\n\t}\r\n\r\n\trawStatus := map[string]string{}\r\n\tfor _, sr := range rep.Steps {\r\n\t\trawStatus[sr.ID] = sr.Status\r\n\t"]
[3807.537244, "o", "}\r\n\r\n\ttype outputState struct {\r\n\t\tbad       bool\r\n"]
[3807.5373, "o", "\t\teffective bool\r\n\t\tmatched   bool\r\n\t}\r\n\toutputs := map[string]map[string]*outputState{}\r\n\tfor _, sr := range rep.Steps {\r\n\t\tfor _, o := range sr.Outputs {\r\n\t\t\tif outputs[sr.ID] == nil {\r\n\t\t\t\toutputs[sr.ID] = map[string]*outputState{}\r\n"]
[3807.537357, "o", "\t\t\t}\r\n\t\t\tbad := !o.CrossPassConsistent || (o.ReferenceMatch != nil && !*o.ReferenceMatch)\r\n\t\t\toutputs[sr.ID][o.Path] = &outputState{\r\n\t\t\t\tbad:       bad,\r\n\t\t\t\teffective: !bad,\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tmatchedStepsAll := map[string]bool{}\r\n\tignoredSteps := map[string]bool{}\r\n"]
[3807.537383, "o", "\tmustPassSteps := map[string]bool{}\r\n\trequiredAllowListed := map[string]bool{}\r\n\thasRequiredAllow := false\r\n\trequireViolation := false\r\n\twarnings := []string{}\r\n\truleEvals := make([]policyRuleEval, 0, len(p.Rules))\r\n\r\n\tfor _, rule := range p.Rules {\r\n\t\tswitch rule.Type {\r\n\t\tcase \"allow_variance\":\r\n"]
[3807.537527, "o", "\t\t\tev := policyRuleEval{\r\n\t\t\t\tRuleID:   rule.ID,\r\n\t\t\t\tRuleType: rule.Type,\r\n\t\t\t\tAction:   rule.Action,\r\n\t\t\t\tEffect:   \"not_applicable\",\r\n\t\t\t}\r\n\t\t\tpattern, _ := policyStringParam(rule, \"output_pattern\")\r\n\t\t\tfor _, sr := range rep.Steps {\r\n\t\t\t\tif rawStatus[sr.ID] == \"ERROR\" || rawStatus[sr.ID] == \"TIMEOUT\" || rawStatus[sr.ID] == \"SKIPPED\" {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tfor _, o := range sr.Outputs {\r\n\t\t\t\t\tst := outputs[sr.ID][o.Path]\r\n\t\t\t\t\tif st == nil || st.matched {\r\n\t\t\t\t\t\tcontinue\r\n\t\t\t\t\t}\r\n\t\t\t\t\tmatched, err := filepath.Match(pattern, o.Path)\r\n\t\t\t\t\tif err != nil || !matched {\r\n"]
[3807.537634, "o", "\t\t\t\t\t\tcontinue\r\n"]
[3807.538107, "o", "\u001b[?2004h"]
