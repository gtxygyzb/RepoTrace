[3806.682454, "o", "\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K456\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Printf(\"Baseline: %s@%s (%s) at %s\\n\", d.Baseline.ManifestName, d.Baseline.ManifestVersion, d.Baseline.\u001b[01;31m\u001b[KOverallStatus\u001b[m\u001b[K, d.Baseline.Timestamp)\r\n\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K457\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfmt.Printf(\"Current:  %s@%s (%s) at %s\\n\", d.Current.ManifestName, d.Current.ManifestVersion, d.Current.\u001b[01;31m\u001b[KOverallStatus\u001b[m\u001b[K, d.Current.Timestamp)\r\n"]
