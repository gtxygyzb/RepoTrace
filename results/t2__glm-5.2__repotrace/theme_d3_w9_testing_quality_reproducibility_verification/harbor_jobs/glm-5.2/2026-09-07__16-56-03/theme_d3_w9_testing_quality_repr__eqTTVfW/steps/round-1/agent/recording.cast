[6065.058867, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify <verify|fingerprint|graph|diff|summary|trend|slice> ...\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\tswitch os.Args[1] {\r\n\tcase \"verify\":\r\n\t\tverifyCmd(os.Args[2:])\r\n\tcase \"fingerprint\":\r\n\t\tfingerprintCmd(os.Args[2:])\r\n\tcase \"graph\":\r\n\t\tgraphCmd(os.Args[2:])\r\n\tcase \"diff\":\r\n\t\tdiffCmd(os.Args[2:])\r\n\tcase \"summary\":\r\n\t\t"]
[6065.059035, "o", "summaryCmd(os.Args[2:])\r\n\tcase \"trend\":\r\n\t\ttrendCmd(os.Args[2:])\r\n\tcase \"slice\":\r\n\t\tsliceCmd(os.Args[2:])\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"error: unknown subcommand %q\\n\", os.Args[1])\r\n\t\tos.Exit(2)\r\n\t}\r\n}\r\n"]
[6065.059354, "o", "\u001b[?2004h"]
