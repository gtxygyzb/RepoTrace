[1170.504627, "o", "func buildReport(m *Manifest, passes []*passResult, topOrder []string, topoIndex map[string]int, trans map[string][]string, targetedSteps []string, required map[string]bool, targetSet map[string]bool) *report {\r\n\u001b[?2004l\r"]
[1170.504691, "o", "\u001b[?2004h> "]
[1170.504759, "o", "rep := &report{\r\n\u001b[?2004l\r"]
[1170.504814, "o", "\u001b[?2004h> "]
[1170.504964, "o", "ManifestName:    m.Name,\r\n\u001b[?2004l\r"]
[1170.505019, "o", "\u001b[?2004h> "]
[1170.505173, "o", "ManifestVersion: m.Version,\r\n\u001b[?2004l\r"]
[1170.505229, "o", "\u001b[?2004h> "]
[1170.505516, "o", "Timestamp:       time.Now().UTC().Format(time.RFC3339),\r\n\u001b[?2004l\r"]
[1170.505574, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1170.505628, "o", "\u001b[?2004h> "]
[1170.505892, "o", "rep.VerificationConfig.Passes = m.Verify.Passes\r\n\u001b[?2004l\r"]
[1170.505958, "o", "\u001b[?2004h> "]
[1170.506248, "o", "rep.VerificationConfig.Algorithm = m.Verify.Algorithm\r\n\u001b[?2004l\r"]
[1170.506307, "o", "\u001b[?2004h> "]
[1170.506524, "o", "rep.VerificationConfig.Mode = m.Verify.Mode\r\n\u001b[?2004l\r"]
[1170.506589, "o", "\u001b[?2004h> "]
[1170.506765, "o", "if m.Verify.Mode == \"targeted\" {\r\n\u001b[?2004l\r"]
[1170.506822, "o", "\u001b[?2004h> "]
[1170.50712, "o", "rep.VerificationConfig.TargetedSteps = targetedSteps\r\n\u001b[?2004l\r"]
[1170.507176, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1170.507232, "o", "\u001b[?2004h> "]
[1170.507478, "o", "rep.EnvironmentConfig.Locale = m.Env.Locale\r\n\u001b[?2004l\r"]
[1170.507535, "o", "\u001b[?2004h> "]
[1170.507822, "o", "rep.EnvironmentConfig.Timezone = m.Env.Timezone\r\n\u001b[?2004l\r"]
[1170.507877, "o", "\u001b[?2004h> "]
[1170.508082, "o", "rep.EnvironmentConfig.Seed = m.Env.Seed\r\n\u001b[?2004l\r"]
[1170.508139, "o", "\u001b[?2004h> "]
[1170.508436, "o", "rep.EnvironmentConfig.NormalizePaths = m.Env.NormalizePaths\r\n\u001b[?2004l\r"]
[1170.508494, "o", "\u001b[?2004h> "]
[1170.508888, "o", "rep.EnvironmentConfig.NormalizeTimestamps = m.Env.NormalizeTimestamps\r\n\u001b[?2004l\r"]
[1170.508947, "o", "\u001b[?2004h> "]
[1170.509286, "o", "rep.EnvironmentConfig.BlockedEnvVars = m.Env.BlockedEnvVars\r\n\u001b[?2004l\r"]
[1170.509348, "o", "\u001b[?2004h> "]
[1170.509512, "o", "pg := parallelGroups(m.Steps)\r\n\u001b[?2004l\r"]
[1170.509568, "o", "\u001b[?2004h> "]
[1170.509837, "o", "rep.DependencyAnalysis.TopologicalOrder = topOrder\r\n\u001b[?2004l\r"]
[1170.509892, "o", "\u001b[?2004h> "]
[1170.510153, "o", "rep.DependencyAnalysis.ParallelGroups = pg\r\n\u001b[?2004l\r"]
[1170.510209, "o", "\u001b[?2004h> "]
[1170.510531, "o", "rep.DependencyAnalysis.CriticalPath = criticalPath(m.Steps)\r\n\u001b[?2004l\r"]
[1170.510587, "o", "\u001b[?2004h> "]
[1170.510824, "o", "rep.DependencyAnalysis.TotalSteps = len(m.Steps)\r\n\u001b[?2004l\r"]
[1170.510879, "o", "\u001b[?2004h> "]
[1170.511131, "o", "rep.DependencyAnalysis.MaxParallelism = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[1170.511192, "o", "> "]
[1170.511296, "o", "for _, g := range pg {\r\n\u001b[?2004l\r"]
[1170.511353, "o", "\u001b[?2004h> "]
[1170.511546, "o", "if len(g) > rep.DependencyAnalysis.MaxParallelism {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1170.511602, "o", "> "]
[1170.511754, "o", "rep.DependencyAnalysis.MaxParallelism = len(g)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1170.51181, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[1170.511866, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1170.511981, "o", "stepByID := map[string]Step{}\r\n\u001b[?2004l\r"]
[1170.512037, "o", "\u001b[?2004h> "]
[1170.512127, "o", "for _, s := range m.Steps {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1170.512182, "o", "> "]
[1170.512237, "o", "stepByID[s.ID] = s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.512292, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.512413, "o", "for _, id := range topOrder {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1170.512468, "o", "> "]
[1170.512514, "o", "s := stepByID[id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1170.512573, "o", "> "]
[1170.512629, "o", "sr := stepReport{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.512714, "o", "ID:            id,\r\n\u001b[?2004l\r"]
[1170.512769, "o", "\u001b[?2004h> "]
[1170.512863, "o", "ExecutionOrder: topoIndex[id],\r\n\u001b[?2004l\r"]
[1170.51292, "o", "\u001b[?2004h> "]
[1170.513067, "o", "TimingMs:      make([]int64, len(passes)),\r\n\u001b[?2004l\r"]
[1170.513123, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r1,\u001b[?2004h> "]
[1170.513248, "o", "for i, pr := range passes {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1170.513303, "o", "> "]
