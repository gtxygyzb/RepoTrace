[5878.590722, "i", "sed -n '1,220p' cmd/repro-verify/trend.go\n"]
[5878.591093, "o", "sed -n '1,220p' cmd/repro-verify/trend.go\r\n"]
[5878.591192, "o", "\u001b[?2004l\r"]
[5878.593907, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"sort\"\r\n"]
[5878.593998, "o", "\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\ntype trendReportLite struct {\r\n\tManifestName    string       `json:\"manifest_name\"`\r\n\tManifestVersion string       `json:\"manifest_version\"`\r\n\tOverallStatus   string       `json:\"overall_status\"`\r\n\tTimestamp       string       `json:\"timestamp\"`\r\n\tSteps           []stepReport `json:\"steps\"`\r\n}\r\n\r\ntype trendStep struct {\r\n"]
[5878.594075, "o", "\tStepID         string    `json:\"step_id\"`\r\n\tStatuses       []*string `json:\"statuses\"`\r\n\tFirstSeenIndex int       `json:\"first_seen_index\"`\r\n\tLastSeenIndex  int       `json:\"last_seen_index\"`\r\n\tStatusChanges  int       `json:\"status_changes\"`\r\n\tStability      float64   `json:\"stability\"`\r\n\tClassification string    `json:\"classification\"`\r\n}\r\n\r\ntype trendAggregate struct {\r\n\tTotalStepsTracked int     `json:\"total_steps_tracked\"`\r\n\tStableCount       int     `json:\"stable_count\"`\r\n\tFlakyCount        int     `json:\"flaky_count\"`\r\n"]
[5878.594153, "o", "\tDegradingCount    int     `json:\"degrading_count\"`\r\n\tImprovingCount    int     `json:\"improving_count\"`\r\n\tOverallStability  float64 `json:\"overall_stability\"`\r\n}\r\n\r\ntype trendOutput struct {\r\n"]
[5878.594234, "o", "\tTrendTimestamp string         `json:\"trend_timestamp\"`\r\n\tReportCount    int            `json:\"report_count\"`\r\n\tStepTrends     []trendStep    `json:\"step_trends\"`\r\n\tAggregate      trendAggregate `json:\"aggregate\"`\r\n}\r\n\r\nfunc trendCmd(args []string) {\r\n\tformat := \"json\"\r\n\tpositional := parseFlags(args, map[string]*string{\r\n\t\t\"format\": &format,\r\n\t})\r\n\r\n\tif len(positional) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"error: trend requires at least two report files\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\r\n\treports := make([]*trendReportLite, 0, len(positional))\r\n\tfor _, path := range positional {\r\n\t\trep, err := loadTrendReport(path)\r\n\t\t"]
[5878.594307, "o", "if err != nil {\r\n\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\tos.Exit(2)\r\n\t\t}\r\n\t\treports = append(reports, rep)\r\n\t}\r\n\r\n\toutput := buildTrendOutput(reports)\r\n\r\n\tif format == \"text\" {\r\n\t\tprintTrendText(output)\r\n\t} else {\r\n\t\tdata, err := json.MarshalIndent(output, \"\", \"  \")\r\n"]
[5878.594376, "o", "\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n\t\t\tos.Exit(2)\r\n\t\t}\r\n\t\tfmt.Println(string(data))\r\n\t}\r\n\r\n\tif output.Aggregate.DegradingCount > 0 || output.Aggregate.FlakyCount > 0 {\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[5878.59445, "o", "\tos.Exit(0)\r\n}\r\n\r\nfunc loadTrendReport(path string) (*trendReportLite, error) {\r\n\tif _, err := os.Stat(path); err != nil {\r\n\t\tif os.IsNotExist(err) {\r\n\t\t\treturn nil, fmt.Errorf(\"error: trend file not found: %s\", path)\r\n\t\t}\r\n\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: %s\", path, err)\r\n\t}\r\n\r\n\tdata, err := os.ReadFile(path)\r\n"]
[5878.594553, "o", "\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: %s\", path, err)\r\n\t}\r\n\r\n\tvar raw map[string]json.RawMessage\r\n\tif err := json.Unmarshal(data, &raw); err != nil {\r\n\t"]
[5878.59463, "o", "\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: %s\", path, err)\r\n\t}\r\n\r\n\tfor _, field := range []string{\"manifest_name\", \"overall_status\", \"steps\"} {\r\n\t\tif _, ok := raw[field]; !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: missing field %s\", path, field)\r\n\t\t}\r\n\t}\r\n\r\n\tvar r trendReportLite\r\n\tif err := json.Unmarshal(data, &r); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: %s\", path, err)\r\n\t}\r\n\tif r.ManifestName == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: missing field manifest_name\", path)\r\n\t}\r\n\tif r.OverallStatus == \"\" {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: missing field overall_status\", path)\r\n\t}\r\n\tif r.Steps == nil {\r\n\t\treturn nil, fmt.Errorf(\"error: invalid trend input: %s: missing field steps\", path)\r\n"]
[5878.594699, "o", "\t}\r\n\r\n\treturn &r, nil\r\n}\r\n\r\nfunc buildTrendOutput(reports []*trendReportLite) *trendOutput {\r\n\treportCount := len(reports)\r\n\tstepIDs := make(map[string]bool)\r\n\treportStepStatus := make([]map[string]string, reportCount)\r\n\r\n\tfor i, rep := range reports {\r\n\t\tstatusByID := make(map[string]string)\r\n\t\tfor _, step := range rep.Steps {\r\n"]
[5878.594808, "o", "\t\t\tstatusByID[step.ID] = step.Status\r\n\t\t\tstepIDs[step.ID] = true\r\n\t\t}\r\n\t\treportStepStatus[i] = statusByID\r\n\t}\r\n\r\n\tids := make([]string, 0, len(stepIDs))\r\n\tfor id := range stepIDs {\r\n\t\tids = append(ids, id)\r\n\t}\r\n\tsort.Strings(ids)\r\n\r\n\tstepTrends := make([]trendStep, 0, len(ids))\r\n\tvar stableCount, flakyCount, degradingCount, improvingCount int\r\n\tvar stabilitySum float64\r\n\r\n"]
[5878.594973, "o", "\tfor _, id := range ids {\r\n\t\tstatuses := make([]*string, reportCount)\r\n\t\tappearances := 0\r\n\t\tfirstSeenIndex := -1\r\n\t\tlastSeenIndex := -1\r\n\t\tvar firstStatus, lastStatus string\r\n\r\n\t\tfor i, statusByID := range reportStepStatus {\r\n\t\t\tif status, ok := statusByID[id]; ok {\r\n\t\t\t\tstatusCopy := status\r\n\t\t\t\tstatuses[i] = &statusCopy\r\n\t\t\t\tappearances++\r\n\t\t\t\tif firstSeenIndex == -1 {\r\n\t\t\t\t\tfirstSeenIndex = i\r\n\t\t\t\t\tfirstStatus = status\r\n\t\t\t\t}\r\n\t\t\t\tlastSeenIndex = i\r\n\t\t\t\tlastStatus = status\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tstatusChanges := 0\r\n\t\tvar prev *string\r\n\t\tfor _, status := range statuses {\r\n\t\t\tif status == nil {\r\n"]
[5878.595064, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif prev != nil && *prev != *status {\r\n\t\t\t\tstatusChanges++\r\n\t\t\t}\r\n\t\t\tprev = status\r\n\t\t}\r\n\r\n\t\tstability := 1.0\r\n"]
[5878.595138, "o", "\t\tif appearances > 1 {\r\n\t\t\tstability = 1.0 - float64(statusChanges)/float64(appearances-1)\r\n\t\t}\r\n\r\n\t\tclassification := classifyTrendStep(statusChanges, firstStatus, lastStatus)\r\n\t\tswitch classification {\r\n\t\tcase \"stable\":\r\n\t\t\tstableCount++\r\n\t\tcase \"flaky\":\r\n\t\t\tflakyCount++\r\n\t\tcase \"degrading\":\r\n"]
[5878.595213, "o", "\t\t\tdegradingCount++\r\n\t\tcase \"improving\":\r\n\t\t\timprovingCount++\r\n\t\t}\r\n\t\tstabilitySum += stability\r\n\r\n\t\tstepTrends = append(stepTrends, trendStep{\r\n\t\t\tStepID:         id,\r\n\t\t\tStatuses:       statuses,\r\n\t\t\tFirstSeenIndex: firstSeenIndex,\r\n\t\t\tLastSeenIndex:  lastSeenIndex,\r\n\t\t\tStatusChanges:  statusChanges,\r\n\t\t\tStability:      stability,\r\n\t"]
[5878.595286, "o", "\t\tClassification: classification,\r\n\t\t})\r\n\t}\r\n\r\n\toverallStability := 1.0\r\n\tif len(ids) > 0 {\r\n\t\toverallStability = stabilitySum / float64(len(ids))\r\n\t}\r\n\r\n\treturn &trendOutput{\r\n\t\tTrendTimestamp: time.Now().UTC().Format(time.RFC3339),\r\n"]
[5878.595356, "o", "\t\tReportCount:    reportCount,\r\n"]
[5878.595796, "o", "\u001b[?2004h"]
[5878.595854, "o", "root@n30009:/app# "]
[5878.886042, "i", "sed -n '1,220p' cmd/repro-verify/diff.go\n"]
[5878.886395, "o", "sed -n '1,220p' cmd/repro-verify/diff.go\r\n\u001b[?2004l\r"]
[5878.888004, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\ntype diffReport struct {\r\n\tBaseline            diffReportMeta       `json:\"baseline\"`\r\n\tCurrent             diffReportMeta       `json:\"current\"`\r\n\tComparisonTimestamp string               `json:\"comparison_timestamp\"`\r\n\tStatusTransition    diffStatusTransition `json:\"status_transition\"`\r\n\tStepChanges         []diffStepChange     `json:\"step_changes\"`\r\n"]
[5878.888152, "o", "\tSummary             diffSummary          `json:\"summary\"`\r\n}\r\n\r\ntype diffReportMeta struct {\r\n\tManifestName    string `json:\"manifest_name\"`\r\n\tManifestVersion string `json:\"manifest_version\"`\r\n\tOverallStatus   string `json:\"overall_status\"`\r\n\tTimestamp       string `json:\"timestamp\"`\r\n}\r\n\r\ntype diffStatusTransition struct {\r\n\tFrom string `json:\"from\"`\r\n\tTo   string `json:\"to\"`\r\n\tType string `json:\"type\"`\r\n}\r\n\r\ntype diffStepChange struct {\r\n\tStepID           string             `json:\"step_id\"`\r\n\tChangeType       string             `json:\"change_type\"`\r\n\tBaselineStatus   *string            `json:\"baseline_status\"`\r\n\tCurrentStatus    *string            `json:\"current_status\"`\r\n\tStatusTransition *string            `json:\"status_transition\"`\r\n\tOutputChanges    []diffOutputChange `json:\"output_changes\"`\r\n}\r\n\r\ntype diffOutputChange struct {\r\n\tPath       string           `json:\"path\"`\r\n\tChangeType string           `json:\"change_type\"`\r\n\tDetails    diffOutputDetail `json:\"details\"`\r\n}\r\n\r\ntype diffOutputDetail struct "]
[5878.88828, "o", "{\r\n\tBaselineFingerprints   []string `json:\"baseline_fingerprints\"`\r\n\tCurrentFingerprints    []string `json:\"current_fingerprints\"`\r\n\tBaselineConsistent     *bool    `json:\"baseline_consistent\"`\r\n\tCurrentConsistent      *bool    `json:\"current_consistent\"`\r\n\tBaselineReferenceMatch *bool    `json:\"baseline_reference_match\"`\r\n\tCurrentReferenceMatch  *bool    `json:\"current_reference_match\"`\r\n}\r\n\r\ntype diffSummary struct {\r\n\tStepsAdded         int `json:\"steps_added\"`\r\n\tStepsRemoved       int `json:\"steps_removed\"`\r\n\tStepsModified      int `json:\"steps_modified\"`\r\n\tStepsUnchanged     int `json:\"steps_unchanged\"`\r\n\tRegressions        int `json:\"regressions\"`\r\n\tImprovements       int `json:\"improvements\"`\r\n\tTotalOutputChanges int `json:\"total_output_changes\"`\r\n}\r\n\r\ntype diffReportLite struct {\r\n\tManifestName    string       `json:\"manifest_name\"`\r\n\tManifestVersion string       `json:\"manifest_version\"`\r\n\tOverallStatus   string       `json:\"overall_status\"`\r\n\tTimestamp       string       `json:\"timestamp\"`\r\n\tSteps  "]
