[3796.564053, "o", "\t}\r\n   449\t\r\n   450\t\treturn &policyEvaluation{\r\n   451\t\t\tPolicyOverallStatus:   policyStatus,\r\n   452\t\t\tDefaultAction:         defaultAction,\r\n   453\t\t\tRulesEvaluated:        ruleEvals,\r\n   454\t\t\tEffectiveStepStatuses: effectiveStepStatuses,\r\n   455\t\t\tWarnings:              warnings,\r\n   456\t\t}\r\n   457\t}\r\n   458\t\r\n   459\tfunc majorityRate(fps []string) float64 {\r\n   460\t\tif len(fps) == 0 {\r\n"]
[3796.564115, "o", "   461\t\t\treturn 0\r\n   462\t\t}\r\n   463\t\tcounts := map[string]int{}\r\n   464\t\tfor _, fp := range fps {\r\n   465\t\t\tcounts[fp]++\r\n   466\t\t}\r\n   467\t\tmax := 0\r\n   468\t\tfor _, c := range counts {\r\n   469\t\t\tif c > max {\r\n   470\t\t\t\t"]
[3796.564171, "o", "max = c\r\n   471\t\t\t}\r\n   472\t\t}\r\n   473\t\treturn float64(max) / float64(len(fps))\r\n   474\t}\r\n   475\t\r\n   476\tfunc appendUnique(slice []string, value string) []string {\r\n"]
