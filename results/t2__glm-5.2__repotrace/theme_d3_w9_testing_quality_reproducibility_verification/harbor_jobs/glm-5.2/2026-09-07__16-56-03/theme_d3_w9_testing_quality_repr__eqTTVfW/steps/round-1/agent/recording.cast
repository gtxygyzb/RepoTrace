[5925.683292, "o", "    58\t\tfor _, path := range positional {\r\n    59\t\t\trep, err := loadTrendReport(path)\r\n    60\t\t\tif err != nil {\r\n    61\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    62\t\t\t\tos.Exit(2)\r\n    63\t\t\t}\r\n    64\t\t\treports = append(reports, rep)\r\n    65\t\t}\r\n    66\t\r\n    67\t\toutput := buildTrendOutput(reports)\r\n    68\t\r\n    69\t\tif format == \"text\" {\r\n    70\t\t\tprintTrendText(output)\r\n    71\t\t} else {\r\n    72\t\t\tdata, err := json.MarshalIndent(output, \"\", \"  \")\r\n    73\t\t\tif err != nil {\r\n    74\t\t\t\tfmt.Fprintf(os.Stderr, \"error: %s\\n\", err)\r\n    75\t\t\t\tos.Exit(2)\r\n    76\t\t\t}\r\n    77\t\t\tfmt.Println(string(data))\r\n    78\t\t}\r\n    79\t\r\n    80\t\tif output.Aggregate.DegradingCount > 0 || output.Aggregate.FlakyCount > 0 {\r\n    81\t\t\tos.Exit(1)\r\n    82\t\t}\r\n    83\t\tos.Exit(0)\r\n    84\t}\r\n    85\t\r\n    86\tfunc loadTrendReport(path string) (*trendReportLite, error) {\r\n    87\t\tif _, err := os.Stat(path); err != nil {\r\n    88\t\t\tif os.IsNotExist(err) {\r\n"]
