[144.324155, "i", "cat > cmd/repro-verify/main.go <<'EOF'\npackage main\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"crypto/sha512\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n)\n\nvar nameRe = regexp.MustCompile(`^[a-z][a-z0-9_-]{0,63}$`)\n\ntype Manifest struct {\n\tName      string                 `json:\"name\"`\n\tVersion   string                 `json:\"version\"`\n\tVerify    VerifyConfig           `json:\"verification\"`\n\tEnv       EnvironmentConfig      `json:\"environment\"`\n\tSteps     []Step                 `json:\"steps\"`\n\tRefs      map[string]string      `json:\"references\"`\n}\n\ntype VerifyConfig struct {\n\tPasses    int    `json:\"passes\"`\n\tAlgorithm string `json:\"algorithm\"`\n\tMode      string `json:\"mode\"`\n}\n\ntype EnvironmentConfig struct {\n\tLocale               string            `json:\"locale\"`\n\tTimezone             string            `json:\"timezone\"`\n\tSeed                 *int              `json:\"seed\"`\n\tEnvVars              map[string]strin"]
[144.324437, "i", "g `json:\"env_vars\"`\n\tBlockedEnvVars       []string          `json:\"blocked_env_vars\"`\n\tNormalizePaths       bool              `json:\"normalize_paths\"`\n\tNormalizeTimestamps  bool              `json:\"normalize_timestamps\"`\n}\n\ntype Step struct {\n\tID            string            `json:\"id\"`\n\tCommand       string            `json:\"command\"`\n\tWorkingDir    string            `json:\"working_dir\"`\n\tInputs        []string          `json:\"inputs\"`\n\tOutputs       []string          `json:\"outputs\"`\n\tDependsOn     []string          `json:\"depends_on\"`\n\tTimeoutSecs   int               `json:\"timeout_seconds\"`\n\tEnvOverrides  map[string]string `json:\"env_overrides\"`\n}\n\nfunc main() {\n\tif len(os.Args) < 2 {\n\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify <verify|fingerprint|graph> ...\")\n\t\tos.Exit(2)\n\t}\n\tswitch os.Args[1] {\n\tcase \"verify\":\n\t\tverifyCmd(os.Args[2:])\n\tcase \"fingerprint\":\n\t\tfingerprintCmd(os.Args[2:])\n\tcase \"graph\":\n\t\tgraphCmd(os.Args[2:])\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, \"error: unknown subcommand %q\\n\", os.Args[1"]
[144.324533, "o", "cat > cmd/repro-verify/main.go <<'EOF'\r\n\u001b[?2004l\r"]
[144.324624, "i", "])\n\t\tos.Exit(2)\n\t}\n}\nEOF\n"]
