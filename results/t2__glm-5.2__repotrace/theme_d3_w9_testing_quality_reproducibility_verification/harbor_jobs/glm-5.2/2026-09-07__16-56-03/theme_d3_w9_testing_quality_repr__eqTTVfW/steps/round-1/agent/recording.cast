[5898.590096, "o", "    81\t\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify diff <baseline.json> <current.json> [--format json|text]\")\r\n    82\t\t\tos.Exit(2)\r\n    83\t\t}\r\n    84\t\r\n    85\t\tbaseline, err := loadDiffReport(positional[0], \"baseline\")\r\n    86\t\tif err != nil {\r\n    87\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    88\t\t\tos.Exit(2)\r\n    89\t"]
