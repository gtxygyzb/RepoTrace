[5356.134538, "o", "drwxr-xr-x 1 root root    4096 Sep  7 10:22 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root    4096 Sep  7 10:25 \u001b[01;34m..\u001b[0m\r\ndrwxr-xr-x 3 root root    4096 Sep  7 09:00 \u001b[01;34mcmd\u001b[0m\r\ndrwxr-xr-x 2 root root    4096 Jul 21 12:55 \u001b[01;34mdocs\u001b[0m\r\n-rw-rw-r-- 1 root root      29 Apr  8 17:05 go.mod\r\n-rwxr-xr-x 1 root root 3603393 Sep  7 10:23 \u001b[01;32mrepro-verify\u001b[0m\r\n"]
