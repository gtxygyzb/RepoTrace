[6355.99926, "o", "\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"PASS\"\u001b[m\u001b[K:\r\n\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn 4\r\n"]
[6355.999367, "o", "\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"FAIL\"\u001b[m\u001b[K:\r\n\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K257\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn 1\r\n\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"ERROR\"\u001b[m\u001b[K:\r\n"]
[6355.99947, "o", "\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn 2\r\n"]
[6355.999539, "o", "\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"TIMEOUT\"\u001b[m\u001b[K:\r\n\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn 3\r\n\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"SKIPPED\"\u001b[m\u001b[K:\r\n"]
[6355.999603, "o", "\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn 0\r\n\u001b[35m\u001b[Kcmd/repro-verify/trend.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefault:\r\n"]
[6355.999673, "o", "\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n"]
[6355.999735, "o", "\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K377\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \"PASS\"\u001b[m\u001b[K:\r\n\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn 4\r\n\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \"FAIL\"\u001b[m\u001b[K:\r\n\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn 3\r\n\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K381\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \"ERROR\"\u001b[m\u001b[K:\r\n\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K382\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn 2\r\n"]
[6355.999802, "o", "\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K383\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \"TIMEOUT\"\u001b[m\u001b[K:\r\n\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn 1\r\n\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K385\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kcase \"SKIPPED\"\u001b[m\u001b[K:\r\n\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn 0\r\n\u001b[35m\u001b[Kcmd/repro-verify/diff.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K387\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t"]
[6355.999861, "o", "\tdefault:\r\n"]
