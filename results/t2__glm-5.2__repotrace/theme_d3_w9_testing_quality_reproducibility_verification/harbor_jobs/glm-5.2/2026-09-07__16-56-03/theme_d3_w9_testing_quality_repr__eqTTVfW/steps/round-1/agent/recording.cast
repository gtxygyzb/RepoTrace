[1170.52468, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.524829, "o", "rep.NonDeterminismHints = buildHints(m, passes, rep.Steps, stepByID)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.524889, "o", "hasError := false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.524968, "o", "for _, sr := range rep.Steps {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.525088, "o", "if sr.Status == \"ERROR\" || sr.Status == \"TIMEOUT\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.525143, "o", "hasError = true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.525199, "o", "break\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.525255, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.525414, "o", "hasFail := rep.Summary.InconsistentOutputs > 0 || rep.Summary.ReferenceMismatches > 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.525461, "o", "if hasError {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.525536, "o", "rep.OverallStatus = \"ERROR\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.5256, "o", "} else if hasFail {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.525671, "o", "rep.OverallStatus = \"FAIL\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.525727, "o", "} else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
