[6631.090541, "o", "nl -ba cmd/repro-verify/export.go | sed -n '1,140p'\r\n\u001b[?2004l\r"]
[6631.094325, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t)"]
[6631.094416, "o", "\r\n     8\t\r\n     9\ttype exportReport struct {\r\n    10\t\tManifestName  string       `json:\"manifest_name\"`\r\n    11\t\tOverallStatus string       `json:\"overall_status\"`\r\n    12\t\tSteps         []exportStep `json:\"steps\"`\r\n    13\t}\r\n    14\t\r\n    15\ttype exportStep struct {\r\n    16\t\tID      string            `json:\"id\"`\r\n    17\t\tStatus  string            `json:\"status\"`\r\n    18\t\tOutputs []json.RawMessage `json:\"outputs\"`\r\n    19\t}\r\n    20\t\r\n"]
[6631.094488, "o", "    21\tfunc exportCmd(args []string) {\r\n    22\t\tif len(args) != 1 {\r\n    23\t\t\tfmt.Fprintln(os.Stderr, \"usage: repro-verify export <report.json>\")\r\n    24\t\t\tos.Exit(2)\r\n    25\t\t}\r\n    26\t\r\n    27\t\tpath := args[0]\r\n    28\t\tdata, err := os.ReadFile(path)\r\n    29\t\tif err != nil {\r\n    30\t\t\tif os.IsNotExist(err) {\r\n    31\t\t\t\tfmt.Fprintf(os.Stderr, \"error: export file not found: %s\\n\", path)\r\n"]
[6631.094551, "o", "    32\t\t\t} else {\r\n    33\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid export input: %s: %s\\n\", path, err)\r\n    34\t\t\t}\r\n    35\t\t\tos.Exit(2)\r\n    36\t\t}\r\n    37\t\r\n    38\t\tvar raw map[string]json.RawMessage\r\n    39\t\tif err := json.Unmarshal(data, &raw); err != nil {\r\n"]
[6631.094611, "o", "    40\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid export input: %s: %s\\n\", path, err)\r\n    41\t\t\tos.Exit(2)\r\n    42\t\t}\r\n    43\t\r\n    44\t\tfor _, field := range []string{\"manifest_name\", \"overall_status\", \"steps\"} {\r\n    45\t\t\tif _, ok := raw[field]; !ok {\r\n    46\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid export input: %s: missing required field %s\\n\", path, field)\r\n    47\t\t\t\tos.Exit(2)\r\n    48\t\t\t}\r\n    49"]
[6631.094672, "o", "\t\t\tif string(raw[field]) == \"null\" {\r\n    50\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid export input: %s: %s must not be null\\n\", path, field)\r\n    51\t\t\t\tos.Exit(2)\r\n    52\t\t\t}\r\n    53\t\t}\r\n    54\t\r\n    55\t\tvar rep exportReport\r\n"]
[6631.094729, "o", "    56\t\tif err := json.Unmarshal(data, &rep); err != nil {\r\n    57\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid export input: %s: %s\\n\", path, err)\r\n    58\t\t\tos.Exit(2)\r\n    59\t\t}\r\n    60\t\r\n    61\t\tvar rawSteps []map[string]json.RawMessage\r\n    62\t\tif err := json.Unmarshal(raw[\"steps\"], &rawSteps); err != nil {\r\n    63\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid export input: %s: %s\\n\", path, err)\r\n    64\t\t\tos.Exit(2)\r\n"]
[6631.094788, "o", "    65\t\t}\r\n    66\t\tfor i, step := range rawSteps {\r\n    67\t\t\tif _, ok := step[\"id\"]; !ok || string(step[\"id\"]) == \"null\" {\r\n    68\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid export input: %s: step %d missing required field id\\n\", path, i)\r\n    69\t\t\t\tos.Exit(2)\r\n    70\t\t\t}\r\n    71\t\t\tif _, ok := step[\"status\"]; !ok || string(step[\"status\"]) == \"null\" {\r\n    72\t\t"]
[6631.094848, "o", "\t\tfmt.Fprintf(os.Stderr, \"error: invalid export input: %s: step %d missing required field status\\n\", path, i)\r\n    73\t\t\t\tos.Exit(2)\r\n    74\t\t\t}\r\n    75\t\t}\r\n    76\t\r\n    77\t\tfmt.Println(\"step_id,status,output_count\")\r\n    78\t\tfor _, step := range rep.Steps {\r\n    79\t\t\tfmt.Printf(\"%s,%s,%d\\n\", step.ID, step.Status, len(step.Outputs))\r\n    80\t\t}\r\n    81"]
[6631.094903, "o", "\t}\r\n"]
