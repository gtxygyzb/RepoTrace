[1170.523066, "o", "for _, sr := range rep.Steps {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.523124, "o", "switch sr.Status {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.523179, "o", "case \"PASS\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.523241, "o", "rep.Summary.StepsPassed++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.52329, "o", "case \"FAIL\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.523357, "o", "rep.Summary.StepsFailed++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.523408, "o", "case \"ERROR\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.523475, "o", "rep.Summary.StepsError++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.52354, "o", "case \"SKIPPED\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1170.523603, "o", "rep.Summary.StepsSkipped++\r\n\u001b[?2004l\r\u001b[?2004h"]
[1170.523658, "o", "> case \"TIMEOUT\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
