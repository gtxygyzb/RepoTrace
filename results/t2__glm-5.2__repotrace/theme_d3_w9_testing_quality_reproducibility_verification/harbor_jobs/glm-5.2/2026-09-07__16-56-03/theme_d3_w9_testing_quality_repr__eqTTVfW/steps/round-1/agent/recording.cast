[3978.365019, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('cmd/repro-verify/main.go')\ns = p.read_text()\ns = s.replace('usage: repro-verify <verify|fingerprint|graph|diff> ...', 'usage: repro-verify <verify|fingerprint|graph|diff|summary> ...')\ns = s.replace('\\tcase \"diff\":\\n\\t\\tdiffCmd(os.Args[2:])\\n', '\\tcase \"diff\":\\n\\t\\tdiffCmd(os.Args[2:])\\n\\tcase \"summary\":\\n\\t\\tsummaryCmd(os.Args[2:])\\n')\np.write_text(s)\nPY\n"]
