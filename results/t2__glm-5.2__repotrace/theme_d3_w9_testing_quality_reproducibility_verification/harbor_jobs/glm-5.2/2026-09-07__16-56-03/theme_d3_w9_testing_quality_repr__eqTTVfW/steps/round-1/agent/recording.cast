[2852.220793, "o", "   440\t\treturn out.Sync()\r\n   441\t}\r\n   442\t\r\n   443\tfunc ioCopy(in *os.File, out *os.File) (int64, error) {\r\n   444\t\tbuf := make([]byte, 32*1024)\r\n   445\t\tvar written int64\r\n   446\t\tfor {\r\n   447\t\t\tn, err := in.Read(buf)\r\n   448\t\t\tif n > 0 {\r\n   449\t\t\t\tif _, werr := out.Write(buf[:n]); werr != nil {\r\n"]
[2852.220852, "o", "   450\t\t\t\t\treturn written, werr\r\n   451\t\t\t\t}\r\n   452\t\t\t\twritten += int64(n)\r\n   453\t\t\t}\r\n   454\t\t\tif err == io.EOF {\r\n   455\t\t\t\tbreak\r\n   456\t\t\t}\r\n"]
