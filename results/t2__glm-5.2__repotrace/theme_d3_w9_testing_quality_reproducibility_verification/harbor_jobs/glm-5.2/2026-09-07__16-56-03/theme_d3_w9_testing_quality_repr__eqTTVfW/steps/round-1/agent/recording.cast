[5925.396728, "o", "    51\t\tfor i := 0; i < len(args); i++ {\r\n    52\t\t\tswitch args[i] {\r\n    53\t\t\tcase \"--format\":\r\n    54\t\t\t\ti++\r\n    55\t\t\t\tif i >= len(args) {\r\n    56\t\t\t\t\tfmt.Fprintln(os.Stderr, \"error: --format requires an argument\")\r\n    57\t\t\t\t\tos.Exit(2)\r\n    58\t\t\t\t}\r\n    59\t\t\t\tformat = args[i]\r\n    60\t\t\t\tif format != \"json\" && format != \"text\" {\r\n    61\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid format %q\\n\", format)\r\n    62\t\t\t\t\tos.Exit(2)\r\n    63\t\t\t\t}\r\n    64\t\t\tcase \"--format=json\":\r\n    65\t\t\t\tformat = \"json\"\r\n    66\t\t\tcase \"--format=text\":\r\n    67\t\t\t\tformat = \"text\"\r\n    68\t\t\tdefault:\r\n    69\t\t\t\tif len(args[i]) > 0 && args[i][0] == '-' {\r\n    70\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: unknown flag %q\\n\", args[i])\r\n    71\t\t\t\t\tos.Exit(2)\r\n    72\t\t\t\t}\r\n    73\t\t\t\tpositional = append(positional, args[i])\r\n    74\t\t\t}\r\n    75\t\t}\r\n    76\t\r\n    77\t\tif len(positional) == 0 {\r\n    78\t\t\tfmt.Fprintln(os.Stderr, \"error: summary requires at least one report file\")\r\n    79\t\t\tos.Exit(2)\r\n    80\t\t}\r\n    81\t\r\n    82\t\t"]
[5925.396846, "o", "entries := make([]summaryReportEntry, 0, len(positional))\r\n    83\t\taggregate := summaryAggregate{}\r\n    84\t\tallPassing := true\r\n    85\t\r\n    86\t\tfor _, path := range positional {\r\n    87\t\t\tif _, err := os.Stat(path); err != nil {\r\n    88\t\t\t\tif os.IsNotExist(err) {\r\n    89\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: summary file not found: %s\\n\", path)\r\n    90\t\t\t\t} else {\r\n    91\t\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: %s\\n\", path, err)\r\n    92\t\t\t\t}\r\n    93\t\t\t\tos.Exit(2)\r\n    94\t\t\t}\r\n    95\t\r\n    96\t\t\tdata, err := os.ReadFile(path)\r\n    97\t\t\tif err != nil {\r\n    98\t\t\t\tfmt.Fprintf(os.Stderr, \"error: invalid summary input: %s: %s\\n\", path, err)\r\n    99\t\t\t\tos.Exit(2)\r\n   100\t\t\t}\r\n   101\t\r\n   102\t\t\tvar rep summaryReportInput\r\n"]
