[1170.38313, "i", "if err := os.MkdirAll(dst, 0755); err != nil {\rreturn err\r}\rentries, err := os.ReadDir(src)\rif err != nil {\rreturn err\r}\rfor _, e := range entries {\rsrcPath := filepath.Join(src, e.Name())\rdstPath := filepath.Join(dst, e.Name())\rif e.IsDir() {\rif err := copyDir(srcPath, dstPath); err != nil {\rreturn err\r}\r} else {\rif err := copyFile(srcPath, dstPath); err != nil {\rreturn err\r}\r}\r}\rreturn nil\r}\r\rfunc copyFile(src, dst string) error {\rin, err := os.Open(src)\rif err != nil {\rreturn err\r}\rdefer in.Close()\rout, err := os.Create(dst)\rif err != nil {\rreturn err\r}\rdefer out.Close()\rif _, err := ioCopy(in, out); err != nil {\rreturn err\r}\rreturn out.Sync()\r}\r\rfunc ioCopy(in *os.File, out *os.File) (int64, error) {\rbuf := make([]byte, 32*1024)\rvar written int64\rfor {\rn, err := in.Read(buf)\rif n > 0 {\rif _, werr := out.Write(buf[:n]); werr != nil {\rreturn written, werr\r}\rwritten += int64(n)\r}\rif err == io.EOF {\rbreak\r}\rif err != nil {\rreturn written, err\r}\r}\rreturn written, nil\r}\r\rfunc checkCache(m *Manifest, s Step, roo"]
