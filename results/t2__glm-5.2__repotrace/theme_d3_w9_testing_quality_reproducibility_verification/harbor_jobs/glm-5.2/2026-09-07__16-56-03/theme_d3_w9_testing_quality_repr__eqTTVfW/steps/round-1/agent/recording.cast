[3796.562514, "o", "\t\t\t\tRuleID:   rule.ID,\r\n   269\t\t\t\t\tRuleType: rule.Type,\r\n   270\t\t\t\t\tAction:   rule.Action,\r\n   271\t\t\t\t\tEffect:   \"not_applicable\",\r\n   272\t\t\t\t}\r\n   273\t\t\t\trate, _ := policyFloatParam(rule, \"rate\")\r\n   274\t\t\t\tstepPattern, _ := policyStringParam(rule, \"step_pattern\")\r\n"]
