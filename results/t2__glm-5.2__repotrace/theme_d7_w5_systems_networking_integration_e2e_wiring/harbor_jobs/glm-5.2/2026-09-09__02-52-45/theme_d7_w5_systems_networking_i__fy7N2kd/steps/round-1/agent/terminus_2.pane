     6	
     7	// Global holds mesh-wide tuning parameters.
     8	type Global struct {
     9		HealthIntervalMs        int `toml:"health_interval_ms"`
    10		UnhealthyThreshold      int `toml:"unhealthy_threshold"`
    11		HealthyThreshold        int `toml:"healthy_threshold"`
    12		StatsWindowSec          int `toml:"stats_window_sec"`
    13		CircuitBreakerThreshold int `toml:"circuit_breaker_threshold"`
    14		CircuitBreakerTimeoutMs int `toml:"circuit_breaker_timeout_ms"`
    15	}
    16	
    17	// Endpoint describes one backend endpoint from config.
    18	type Endpoint struct {
    19		Address     string `toml:"address"`
    20		Weight      int    `toml:"weight"`
    21		HealthCheck string `toml:"health_check"`
    22		HealthPath  string `toml:"health_path"`
    23		HealthCmd   string `toml:"health_cmd"`
    24	}
    25	
    26	// Service describes one routed service from config.
    27	type Service struct {
    28		Name                      string     `toml:"name"`
    29		ListenPort                int        `toml:"listen_port"`
    30		RoutingMode               string     `toml:"routing_mode"`
    31		DrainTimeoutMs            int        `toml:"drain_timeout_ms"`
    32		MaxConnectionsPerEndpoint int        `toml:"max_connections_per_endpoint"`
    33		RateLimitRps              int        `toml:"rate_limit_rps"`
    34		RateLimitBurst            int        `toml:"rate_limit_burst"`
    35		RateLimitQueueDepth       int        `toml:"rate_limit_queue_depth"`
    36		RateLimitQueueTimeoutMs   int        `toml:"rate_limit_queue_timeout_ms"`
    37		MaxRetries                int        `toml:"max_retries"`
    38		RetryDelayMs              int        `toml:"retry_delay_ms"`
    39		RetryBackoffMultiplier    float64    `toml:"retry_backoff_multiplier"`
    40		RetryMaxDelayMs           int        `toml:"retry_max_delay_ms"`
    41		IdleTimeoutMs             int        `toml:"idle_timeout_ms"`
    42		Endpoints                 []Endpoint `toml:"endpoint"`
    43	}
    44	
    45	// Config is the parsed application configuration.
    46	type Config struct {
    47		Global   Global
    48		Services []Service `toml:"service"`
    49	}
    50	
    51	// Load reads and normalizes a TOML config file.
    52	func Load(path string) (*Config, error) {
    53		var cfg Config
    54		if _, err := toml.DecodeFile(path, &cfg); err != nil {
    55			return nil, err
    56		}
    57		if cfg.Global.HealthIntervalMs <= 0 {
    58			cfg.Global.HealthIntervalMs = 2000
    59		}
    60		if cfg.Global.UnhealthyThreshold <= 0 {
    61			cfg.Global.UnhealthyThreshold = 3
    62		}
    63		if cfg.Global.HealthyThreshold <= 0 {
    64			cfg.Global.HealthyThreshold = 2
    65		}
    66		if cfg.Global.StatsWindowSec <= 0 {
    67			cfg.Global.StatsWindowSec = 60
    68		}
    69		if cfg.Global.CircuitBreakerThreshold <= 0 {
    70			cfg.Global.CircuitBreakerThreshold = 3
    71		}
    72		if cfg.Global.CircuitBreakerTimeoutMs <= 0 {
    73			cfg.Global.CircuitBreakerTimeoutMs = 5000
    74		}
    75		for i := range cfg.Services {
    76			s := &cfg.Services[i]
    77			if s.RoutingMode == "" {
    78				s.RoutingMode = "weighted-round-robin"
    79			}
    80			if s.DrainTimeoutMs <= 0 {
    81				s.DrainTimeoutMs = 5000
    82			}
    83			if s.MaxConnectionsPerEndpoint <= 0 {
    84				s.MaxConnectionsPerEndpoint = 100
    85			}
    86			if s.RateLimitBurst <= 0 {
    87				s.RateLimitBurst = s.RateLimitRps
    88			}
    89			if s.RateLimitQueueTimeoutMs <= 0 {
    90				s.RateLimitQueueTimeoutMs = 1000
    91			}
    92			if s.RetryDelayMs <= 0 {
    93				s.RetryDelayMs = 100
    94			}
    95			if s.RetryBackoffMultiplier <= 0 {
    96				s.RetryBackoffMultiplier = 2.0
    97			}
    98			if s.RetryMaxDelayMs <= 0 {
    99				s.RetryMaxDelayMs = 5000
   100			}
   101			for j := range s.Endpoints {
   102				ep := &s.Endpoints[j]
   103				if ep.HealthCheck == "" {
   104					ep.HealthCheck = "tcp"
   105				}
   106				if ep.Weight < 0 {
   107					ep.Weight = 0
   108				}
   109			}
   110		}
   111		return &cfg, nil
   112	}
