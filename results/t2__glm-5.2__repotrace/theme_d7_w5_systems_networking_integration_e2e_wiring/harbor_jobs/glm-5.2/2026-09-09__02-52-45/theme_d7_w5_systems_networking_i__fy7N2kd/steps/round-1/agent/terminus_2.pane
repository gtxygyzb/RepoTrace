[?2004lpackage ipc

import (
	"bufio"
	"encoding/json"
	"errors"
	"fmt"
	"net"
	"os"
	"strconv"
	"strings"
	"sync"

	"meshrouter/internal/accesslog"
	"meshrouter/internal/config"
	"meshrouter/internal/state"
)

type Request struct {
	Cmd  string          `json:"cmd"`
	Args json.RawMessage `json:"args"`
}

type Response struct {
	Status string      `json:"status"`
	Data   interface{} `json:"data"`
}

type Server struct {
	state    *state.State
	path     string
	listener net.Listener
	wg       sync.WaitGroup
	stop     chan struct{}
	done     chan struct{}
}

func NewServer(s *state.State, path string) *Server {
	return &Server{
		state: s,
		path:  path,
		stop:  make(chan struct{}),
		done:  make(chan struct{}),
	}
}

func (s *Server) Start() error {
	os.Remove(s.path)
	ln, err := net.Listen("unix", s.path)
	if err != nil {
		return err
	}
	s.listener = ln
	go s.acceptLoop()
	return nil
}

func (s *Server) Stop() {
	select {
	case <-s.stop:
	default:
		close(s.stop)
	}
	if s.listener != nil {
		s.listener.Close()
	}
	<-s.done
	os.Remove(s.path)
}

func (s *Server) acceptLoop() {
	defer close(s.done)
	for {
		conn, err := s.listener.Accept()
		if err != nil {
			return
		}
		s.wg.Add(1)
		go s.handleConn(conn)
	}
}

func (s *Server) handleConn(conn net.Conn) {
	defer s.wg.Done()
	defer conn.Close()
	reader := bufio.NewReader(conn)
	for {
		line, err := reader.ReadString('\n')
		if err != nil {
			return
		}
		line = strings.TrimRight(line, "\r\n")
		if line == "" {
			continue
		}
		resp := s.handleLine(line)
		_, _ = conn.Write([]byte(resp + "\n"))
	}
}

func (s *Server) handleLine(line string) string {
	var req Request
	if err := json.Unmarshal([]byte(line), &req); err != nil {
		return encodeResp(Response{Status: "error", Data: err.Error()})
	}
	data, err := s.dispatch(req)
	if err != nil {
		return encodeResp(Response{Status: "error", Data: err.Error()})
	}
	return encodeResp(Response{Status: "ok", Data: data})
}

func encodeResp(r Response) string {
	b, _ := json.Marshal(r)
	return string(b)
}

func (s *Server) dispatch(req Request) (interface{}, error) {
	switch req.Cmd {
	case "list_services":
		return s.state.ServicesView(), nil
	case "get_service":
		var args struct {
			Name string `json:"name"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		sv, ok := s.state.ServiceView(args.Name)
		if !ok {
			return nil, errors.New("service not found")
		}
		return sv, nil
	case "get_warmup_status":
		var args struct {
			Name string `json:"name"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		sv, ok := s.state.WarmupStatusView(args.Name)
		if !ok {
			return nil, errors.New("service not found")
		}
		return sv, nil
	case "get_stats":
		var args struct {
			Name string `json:"name"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		g := s.state.Global()
		sv, ok := s.state.StatsView(args.Name, g.StatsWindowSec)
		if !ok {
			return nil, errors.New("service not found")
		}
		return sv, nil
	case "set_weight":
		var args struct {
			Name    string `json:"name"`
			Address string `json:"address"`
			Weight  int    `json:"weight"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		if err := s.state.SetWeight(args.Name, args.Address, args.Weight); err != nil {
			return nil, err
		}
		return "OK", nil
	case "drain_endpoint":
		var args struct {
			Name    string `json:"name"`
			Address string `json:"address"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		if err := s.state.DrainEndpoint(args.Name, args.Address); err != nil {
			return nil, err
		}
		return "OK", nil
	case "get_health_log":
		var args struct {
			Name  string `json:"name"`
			LastN int    `json:"last_n"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		return s.state.HealthLogView(args.Name, args.LastN), nil
	case "get_circuit_breakers":
		var args struct {
			Name string `json:"name"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		cv, ok := s.state.CircuitsView(args.Name)
		if !ok {
			return nil, errors.New("service not found")
		}
		return cv, nil
	case "reset_circuit_breaker":
		var args struct {
			Name    string `json:"name"`
			Address string `json:"address"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		if err := s.state.ResetCircuitBreaker(args.Name, args.Address); err != nil {
			return nil, err
		}
		return "OK", nil
	case "resolve":
		var args struct {
			Name string `json:"name"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		addr, err := s.state.ResolveEndpoint(args.Name)
		if err != nil {
			return nil, err
		}
		return addr, nil
	case "reload_config":
		path := s.state.ConfigPath()
		cfg, err := config.Load(path)
		if err != nil {
			return nil, err
		}
		s.state.ApplyConfig(cfg)
		return "OK", nil
	case "get_rate_limit_status":
		var args struct {
			Name string `json:"name"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		tokens, queueDepth, rateLimited, queued, timeouts, rps, burst, ok := s.state.RateLimitStatus(args.Name)
		if !ok {
			return nil, errors.New("service not found")
		}
		return map[string]interface{}{
			"tokens_available": tokens,
			"queue_depth":      queueDepth,
			"rate_limited":     int(rateLimited),
			"queued":           int(queued),
			"queue_timeouts":   int(timeouts),
			"rps":              rps,
			"burst":            burst,
		}, nil
	case "get_connections":
		var args struct {
			Name string `json:"name"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		conns, ok := s.state.ConnectionsView(args.Name)
		if !ok {
			return nil, errors.New("service not found")
		}
		return map[string]interface{}{"connections": conns}, nil
	case "set_rate_limit":
		var args struct {
			Name  string `json:"name"`
			Rps   int    `json:"rps"`
			Burst int    `json:"burst"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		if err := s.state.SetRateLimit(args.Name, args.Rps, args.Burst); err != nil {
			return nil, err
		}
		return "OK", nil
	case "get_access_log":
		var args struct {
			Service       string `json:"service"`
			LastN         *int   `json:"last_n"`
			Result        string `json:"result"`
			MinDurationMs int64  `json:"min_duration_ms"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		lastN := 20
		if args.LastN != nil {
			lastN = *args.LastN
		}
		entries := accesslog.GetAccessLog(accesslog.DefaultPath, args.Service, args.Result, lastN, args.MinDurationMs)
		if entries == nil {
			entries = []accesslog.Entry{}
		}
		return entries, nil
	case "get_access_stats":
		var args struct {
			Service string `json:"service"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		return accesslog.Stats(accesslog.DefaultPath, args.Service), nil
	case "get_dependencies":
		var args struct {
			Name string `json:"name"`
		}
		if err := json.Unmarshal(req.Args, &args); err != nil {
			return nil, err
		}
		deps := s.state.DependencyStatuses(args.Name)
		if deps == nil {
			deps = []state.DependencyStatus{}
		}
		return map[string]interface{}{
			"service":      args.Name,
			"dependencies": deps,
		}, nil
	default:
		return nil, fmt.Errorf("unknown command: %s", req.Cmd)
	}
}

func init() {
	_ = strconv.Itoa(0)
}
