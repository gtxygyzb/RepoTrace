   450	func (ep *EndpointState) TryAddConnection(conn net.Conn, maxConns int) (int64, bool) {
   451		ep.mu.Lock()
   452		defer ep.mu.Unlock()
   453		if ep.ActiveConnections >= maxConns {
   454			return 0, false
   455		}
   456		id := atomic.AddInt64(&ep.connIDCounter, 1)
   457		ep.connections[id] = conn
   458		ep.ActiveConnections++
   459		return id, true
   460	}
   461	
   462	func (ep *EndpointState) CloseConnections() {
   463		ep.mu.Lock()
   464		defer ep.mu.Unlock()
   465		ep.closeConnectionsLocked()
   466	}
