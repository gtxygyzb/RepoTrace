   130	func (s *State) applyConfigLocked(cfg *config.Config) {
   131		s.global = cfg.Global
   132		seen := make(map[string]bool)
   133		for _, svc := range cfg.Services {
   134			seen[svc.Name] = true
   135			ss := s.services[svc.Name]
   136			if ss == nil {
   137				ss = newServiceState(svc, cfg.Global)
   138				s.services[svc.Name] = ss
   139			} else {
   140				ss.mu.Lock()
   141				ss.Name = svc.Name
   142				ss.ListenPort = svc.ListenPort
   143				ss.RoutingMode = svc.RoutingMode
   144				ss.DrainTimeoutMs = svc.DrainTimeoutMs
   145				ss.RateLimitRps = svc.RateLimitRps
   146				ss.RateLimitBurst = svc.RateLimitBurst
   147				ss.RateLimitQueueDepth = svc.RateLimitQueueDepth
   148				ss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs
   149				ss.MaxRetries = svc.MaxRetries
   150				ss.RetryDelayMs = svc.RetryDelayMs
   151				ss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier
   152				ss.RetryMaxDelayMs = svc.RetryMaxDelayMs
   153				if ss.rateLimiter == nil {
   154					ss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   155				} else {
   156					ss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   157				}
   158				ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint
   159				ss.IdleTimeoutMs = svc.IdleTimeoutMs
   160				ss.mu.Unlock()
   161				ss.applyEndpoints(svc.Endpoints, cfg.Global)
   162			}
   163		}
   164		for name, ss := range s.services {
   165			if !seen[name] {
   166				ss.mu.Lock()
   167				ss.stopping = true
   168				if ss.listenerStop != nil {
   169					close(ss.listenerStop)
   170					ss.listenerStop = nil
   171				}
   172				if ss.Listener != nil {
   173					ss.Listener.Close()
   174					ss.Listener = nil
   175				}
   176				ss.mu.Unlock()
   177				for _, ep := range ss.Endpoints {
   178					ep.StartDraining(ss.DrainTimeoutMs, true)
   179				}
   180			}
   181		}
   182	}
