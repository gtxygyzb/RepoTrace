   171	func (r *Router) handleConn(service string, client net.Conn) {
   172		start := time.Now()
   173		ss := r.state.GetService(service)
   174		if ss == nil {
   175			client.Close()
   176			return
   177		}
   178	
   179		allowed, queued := ss.AcquireRateLimitToken()
   180		if !allowed {
   181			if queued {
   182				if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   183					cand.Stats.RecordQueueTimeout()
   184				}
   185			} else {
   186				if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   187					cand.Stats.RecordRateLimited()
   188				}
   189			}
   190			client.Close()
   191			return
   192		}
   193		if queued {
   194			if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   195				cand.Stats.RecordQueued()
