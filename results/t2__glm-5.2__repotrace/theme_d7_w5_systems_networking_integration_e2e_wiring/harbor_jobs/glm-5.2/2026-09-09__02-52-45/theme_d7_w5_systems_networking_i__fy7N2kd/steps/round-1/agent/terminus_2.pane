    85	// Stats aggregates access log entries for the optional service filter.
    86	func Stats(path, service string) StatsResult {
    87		entries := ReadEntries(path)
    88	
    89		type agg struct {
    90			count    int
    91			duration int64
    92			bytesIn  int64
    93			bytesOut int64
    94		}
    95		aggs := make(map[string]*agg)
    96		total := 0
