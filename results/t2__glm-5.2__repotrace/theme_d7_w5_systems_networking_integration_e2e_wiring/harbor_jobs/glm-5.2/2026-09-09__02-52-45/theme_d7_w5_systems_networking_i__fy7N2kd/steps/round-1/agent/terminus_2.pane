[?2004l     1	package state
     2	
     3	import (
     4		"sync"
     5		"time"
     6	)
     7	
     8	type rateLimiter struct {
     9		mu          sync.Mutex
    10		rps         float64
    11		burst       float64
    12		tokens      float64
    13		last        time.Time
    14		queueMax    int
    15		queueDepth  int
    16		timeout     time.Duration
    17		rateLimited uint64
    18		queued      uint64
    19		timeouts    uint64
    20	}
    21	
    22	func newRateLimiter(rps, burst int, queueDepth int, timeoutMs int) *rateLimiter {
    23		return &rateLimiter{
    24			rps:      float64(rps),
    25			burst:    float64(burst),
    26			tokens:   float64(burst),
    27			last:     time.Now(),
    28			queueMax: queueDepth,
    29			timeout:  time.Duration(timeoutMs) * time.Millisecond,
    30		}
    31	}
    32	
    33	func (rl *rateLimiter) update(rps, burst int, queueDepth int, timeoutMs int) {
    34		rl.mu.Lock()
    35		defer rl.mu.Unlock()
    36		rl.rps = float64(rps)
    37		rl.burst = float64(burst)
    38		if rl.tokens > rl.burst {
    39			rl.tokens = rl.burst
    40		}
    41		rl.queueMax = queueDepth
    42		rl.timeout = time.Duration(timeoutMs) * time.Millisecond
    43	}
    44	
    45	func (rl *rateLimiter) refillLocked(now time.Time) {
    46		elapsed := now.Sub(rl.last).Seconds()
    47		if elapsed > 0 {
    48			rl.tokens += rl.rps * elapsed
    49			if rl.burst > 0 && rl.tokens > rl.burst {
    50				rl.tokens = rl.burst
    51			}
    52			rl.last = now
    53		}
    54	}
    55	
    56	func (rl *rateLimiter) tryAcquireLocked(now time.Time) bool {
    57		if rl.rps <= 0 {
    58			return true
    59		}
    60		rl.refillLocked(now)
    61		if rl.tokens >= 1 {
    62			rl.tokens -= 1
    63			return true
    64		}
    65		return false
    66	}
    67	
    68	func (rl *rateLimiter) acquire(now time.Time) (bool, bool) {
    69		rl.mu.Lock()
    70		if rl.rps <= 0 {
    71			rl.mu.Unlock()
    72			return true, false
    73		}
    74		if rl.tryAcquireLocked(now) {
    75			rl.mu.Unlock()
    76			return true, false
    77		}
    78		if rl.queueMax <= 0 {
    79			rl.rateLimited++
    80			rl.mu.Unlock()
    81			return false, false
    82		}
    83		if rl.queueDepth >= rl.queueMax {
    84			rl.rateLimited++
    85			rl.mu.Unlock()
    86			return false, false
    87		}
    88		rl.queueDepth++
    89		rl.queued++
    90		rl.mu.Unlock()
    91	
    92		deadline := now.Add(rl.timeout)
    93		for {
    94			rl.mu.Lock()
    95			var wait time.Duration
    96			if rl.rps > 0 {
    97				needed := 1.0 - rl.tokens
    98				if needed > 0 {
    99					wait = time.Duration(needed / rl.rps * float64(time.Second))
   100				}
   101			}
   102			rl.mu.Unlock()
   103	
   104			if wait <= 0 {
   105				rl.mu.Lock()
   106				if rl.tryAcquireLocked(time.Now()) {
   107					rl.queueDepth--
   108					rl.mu.Unlock()
   109					return true, true
   110				}
   111				rl.mu.Unlock()
   112				continue
   113			}
   114	
   115			remaining := time.Until(deadline)
   116			if remaining <= 0 {
   117				rl.mu.Lock()
   118				rl.queueDepth--
   119				rl.timeouts++
   120				rl.mu.Unlock()
   121				return false, true
   122			}
   123			if wait > remaining {
   124				wait = remaining
   125			}
   126			timer := time.NewTimer(wait)
   127			select {
   128			case <-timer.C:
   129			}
   130			timer.Stop()
   131		}
   132	}
   133	
   134	func (rl *rateLimiter) status() (tokens float64, queueDepth int, rateLimited uint64, queued uint64, timeouts uint64, rps float64, burst float64) {
   135		rl.mu.Lock()
   136		defer rl.mu.Unlock()
   137		rl.refillLocked(time.Now())
   138		return rl.tokens, rl.queueDepth, rl.rateLimited, rl.queued, rl.timeouts, rl.rps, rl.burst
   139	}
