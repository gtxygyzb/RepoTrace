[?2004l   110	func (s *State) applyConfigLocked(cfg *config.Config) {
   111		s.global = cfg.Global
   112		seen := make(map[string]bool)
   113		for _, svc := range cfg.Services {
   114			seen[svc.Name] = true
   115			ss := s.services[svc.Name]
   116			if ss == nil {
   117				ss = newServiceState(svc, cfg.Global)
   118				s.services[svc.Name] = ss
   119			} else {
   120				ss.mu.Lock()
   121				ss.Name = svc.Name
   122				ss.ListenPort = svc.ListenPort
   123				ss.RoutingMode = svc.RoutingMode
   124				ss.DrainTimeoutMs = svc.DrainTimeoutMs
   125				ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint
   126				ss.mu.Unlock()
   127				ss.applyEndpoints(svc.Endpoints, cfg.Global)
   128			}
   129		}
   130		for name, ss := range s.services {
   131			if !seen[name] {
   132				ss.mu.Lock()
   133				ss.stopping = true
   134				if ss.listenerStop != nil {
   135					close(ss.listenerStop)
   136					ss.listenerStop = nil
   137				}
   138				if ss.Listener != nil {
   139					ss.Listener.Close()
   140					ss.Listener = nil
   141				}
   142				ss.mu.Unlock()
   143				for _, ep := range ss.Endpoints {
   144					ep.StartDraining(ss.DrainTimeoutMs, true)
   145				}
   146			}
   147		}
   148	}
   149	
   150	func newServiceState(svc config.Service, global config.Global) *ServiceState {
   151		ss := &ServiceState{
   152			Name:                      svc.Name,
   153			ListenPort:                svc.ListenPort,
   154			RoutingMode:               svc.RoutingMode,
   155			DrainTimeoutMs:            svc.DrainTimeoutMs,
   156			MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
   157			listenerStop:              nil,
   158		}
   159		for _, ep := range svc.Endpoints {
   160			ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))
   161		}
   162		return ss
   163	}
   164	
   165	func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {
   166		ss.mu.Lock()
   167		defer ss.mu.Unlock()
   168		seen := make(map[string]bool)
   169		for _, cep := range eps {
   170			seen[cep.Address] = true
   171			var ep *EndpointState
   172			for _, existing := range ss.Endpoints {
   173				if existing.Address == cep.Address {
   174					ep = existing
   175					break
   176				}
   177			}
   178			if ep == nil {
   179				ep = newEndpointState(cep, global)
   180				ss.Endpoints = append(ss.Endpoints, ep)
   181			} else {
   182				ep.mu.Lock()
   183				ep.Config = cep
   184				ep.Weight = cep.Weight
   185				ep.mu.Unlock()
   186			}
   187		}
   188		for _, ep := range ss.Endpoints {
   189			if !seen[ep.Address] {
   190				ep.StartDraining(ss.DrainTimeoutMs, true)
   191			}
   192		}
   193	}
   194	
   195	func newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {
   196		return &EndpointState{
   197			Address:     cep.Address,
   198			Weight:      cep.Weight,
   199			Config:      cep,
   200			State:       Unknown,
   201			Circuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),
   202			Stats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),
   203			connections: make(map[int64]net.Conn),
   204		}
   205	}
   206	
   207	func (s *State) GetService(name string) *ServiceState {
   208		s.mu.RLock()
   209		defer s.mu.RUnlock()
   210		return s.services[name]
   211	}
   212	
   213	func (s *State) Services() []*ServiceState {
   214		s.mu.RLock()
   215		defer s.mu.RUnlock()
   216		out := make([]*ServiceState, 0, len(s.services))
   217		for _, ss := range s.services {
   218			out = append(out, ss)
   219		}
   220		return out
   221	}
   222	
   223	func (s *State) GetEndpoint(service, address string) *EndpointState {
   224		ss := s.GetService(service)
   225		if ss == nil {
   226			return nil
   227		}
   228		ss.mu.Lock()
   229		defer ss.mu.Unlock()
   230		for _, ep := range ss.Endpoints {
   231			if ep.Address == address {
   232				return ep
   233			}
   234		}
   235		return nil
   236	}
   237	
   238	func (s *State) SetWeight(service, address string, weight int) error {
   239		ep := s.GetEndpoint(service, address)
   240		if ep == nil {
   241			return errNotFound("endpoint not found")
   242		}
   243		ep.mu.Lock()
   244		defer ep.mu.Unlock()
   245		if weight < 0 {
   246			weight = 0
   247		}
   248		ep.Weight = weight
   249		return nil
   250	}
   251	
   252	func (s *State) DrainEndpoint(service, address string) error {
   253		ss := s.GetService(service)
   254		if ss == nil {
   255			return errNotFound("service not found")
   256		}
   257		ep := s.GetEndpoint(service, address)
   258		if ep == nil {
   259			return errNotFound("endpoint not found")
   260		}
