   362	func (s *State) RecordHealthCheck(service, address string, success bool) HealthEvent {
   363		ss := s.GetService(service)
   364		if ss == nil {
   365			return HealthEvent{}
   366		}
   367		ep := s.GetEndpoint(service, address)
   368		if ep == nil {
   369			return HealthEvent{}
   370		}
   371		global := s.Global()
   372		ep.mu.Lock()
   373		oldState := ep.State
   374		result := "success"
   375		if !success {
   376			result = "failure"
   377		}
   378		if success {
   379			ep.consecSuccess++
   380			ep.consecFailures = 0
   381			if oldState == Unknown && ep.consecSuccess >= global.HealthyThreshold {
   382				ep.State = Healthy
   383			} else if oldState == Unhealthy && ep.consecSuccess >= global.HealthyThreshold {
   384				ep.State = Healthy
   385			}
   386		} else {
   387			ep.consecFailures++
   388			ep.consecSuccess = 0
   389			if (oldState == Healthy || oldState == Unknown) && ep.consecFailures >= global.UnhealthyThreshold {
   390				ep.State = Unhealthy
   391				ep.Circuit.Open()
   392				ep.consecFailures = 0
   393				timeout := time.Duration(ss.DrainTimeoutMs) * time.Millisecond
   394				go func(deadline time.Time) {
   395					time.Sleep(time.Until(deadline))
   396					ep.mu.Lock()
   397					ep.closeConnectionsLocked()
   398					ep.mu.Unlock()
   399				}(time.Now().Add(timeout))
   400			}
   401		}
   402		newState := ep.State
   403		ep.mu.Unlock()
   404		evt := HealthEvent{
   405			Timestamp:   time.Now(),
   406			Endpoint:    address,
   407			OldState:    oldState,
   408			NewState:    newState,
   409			CheckResult: result,
   410		}
   411		s.logMu.Lock()
   412		s.healthLog[service] = append(s.healthLog[service], evt)
   413		if len(s.healthLog[service]) > 1000 {
   414			s.healthLog[service] = s.healthLog[service][len(s.healthLog[service])-1000:]
   415		}
   416		s.logMu.Unlock()
   417		return evt
   418	}
