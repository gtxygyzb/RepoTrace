func (r *Router) handleConn(service string, client net.Conn) {
	start := time.Now()
	clientAddr := ""
	if addr := client.RemoteAddr(); addr != nil {
		clientAddr = addr.String()
	}

	var endpoint string
	var bytesIn, bytesOut int64
	var result string
	var retryCount int
	var queueWaitMs *int64
	defer func() {
		if result == "" {
			result = "success"
		}
		if r.accessLog != nil {
			r.accessLog.Log(accesslog.Entry{
				Service:     service,
				Client:      clientAddr,
				Endpoint:    endpoint,
				BytesIn:     bytesIn,
				BytesOut:    bytesOut,
				DurationMs:  time.Since(start).Milliseconds(),
				Result:      result,
				Retried:     retryCount > 0,
				RetryCount:  retryCount,
				QueueWaitMs: queueWaitMs,
			})
		}
	}()

	ss := r.state.GetService(service)
	if ss == nil {
		result = "rejected_no_endpoint"
		client.Close()
		return
	}

	allowed, queued, waitMs, _ := ss.AcquireRateLimitToken()
	if !allowed {
		result = "rejected_rate_limit"
		queueWaitMs = &waitMs
		client.Close()
