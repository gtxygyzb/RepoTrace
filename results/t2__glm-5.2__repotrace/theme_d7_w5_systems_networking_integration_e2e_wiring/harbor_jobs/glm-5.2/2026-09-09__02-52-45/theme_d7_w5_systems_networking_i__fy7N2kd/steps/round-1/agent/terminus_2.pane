    95	
    96	func NewState(cfg *config.Config, path string) *State {
    97		s := &State{
    98			configPath: path,
    99			services:   make(map[string]*ServiceState),
   100			healthLog:  make(map[string][]HealthEvent),
   101			reloadCh:   make(chan struct{}, 1),
   102		}
   103		s.applyConfigLocked(cfg)
   104		return s
   105	}
   106	
   107	func (s *State) ReloadChan() <-chan struct{} {
   108		return s.reloadCh
   109	}
   110	
   111	func (s *State) ConfigPath() string {
   112		s.mu.RLock()
   113		defer s.mu.RUnlock()
   114		return s.configPath
   115	}
   116	
   117	func (s *State) Global() config.Global {
   118		s.mu.RLock()
   119		defer s.mu.RUnlock()
   120		return s.global
   121	}
   122	
   123	func (s *State) ApplyConfig(cfg *config.Config) {
   124		s.mu.Lock()
   125		defer s.mu.Unlock()
   126		s.applyConfigLocked(cfg)
   127		select {
   128		case s.reloadCh <- struct{}{}:
   129		default:
   130		}
   131	}
   132	
   133	func (s *State) applyConfigLocked(cfg *config.Config) {
   134		s.global = cfg.Global
   135		seen := make(map[string]bool)
   136		for _, svc := range cfg.Services {
   137			seen[svc.Name] = true
   138			ss := s.services[svc.Name]
   139			if ss == nil {
   140				ss = newServiceState(svc, cfg.Global)
   141				s.services[svc.Name] = ss
   142			} else {
   143				ss.mu.Lock()
   144				ss.Name = svc.Name
   145				ss.ListenPort = svc.ListenPort
   146				ss.RoutingMode = svc.RoutingMode
   147				ss.DrainTimeoutMs = svc.DrainTimeoutMs
   148				ss.RateLimitRps = svc.RateLimitRps
   149				ss.RateLimitBurst = svc.RateLimitBurst
   150				ss.RateLimitQueueDepth = svc.RateLimitQueueDepth
   151				ss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs
   152				ss.MaxRetries = svc.MaxRetries
   153				ss.RetryDelayMs = svc.RetryDelayMs
   154				ss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier
   155				ss.RetryMaxDelayMs = svc.RetryMaxDelayMs
   156				if ss.rateLimiter == nil {
   157					ss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   158				} else {
   159					ss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   160				}
   161				ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint
   162				ss.ConnectionLimitMode = svc.ConnectionLimitMode
   163				ss.IdleTimeoutMs = svc.IdleTimeoutMs
   164				ss.mu.Unlock()
   165				ss.applyEndpoints(svc.Endpoints, cfg.Global)
   166			}
   167		}
   168		for name, ss := range s.services {
   169			if !seen[name] {
   170				ss.mu.Lock()
   171				ss.stopping = true
   172				if ss.listenerStop != nil {
   173					close(ss.listenerStop)
   174					ss.listenerStop = nil
   175				}
   176				if ss.Listener != nil {
   177					ss.Listener.Close()
   178					ss.Listener = nil
   179				}
   180				ss.mu.Unlock()
   181				for _, ep := range ss.Endpoints {
   182					ep.StartDraining(ss.DrainTimeoutMs, true)
   183				}
   184			}
   185		}
   186	}
   187	
   188	func newServiceState(svc config.Service, global config.Global) *ServiceState {
   189		ss := &ServiceState{
   190			Name:                      svc.Name,
   191			ListenPort:                svc.ListenPort,
   192			RoutingMode:               svc.RoutingMode,
   193			DrainTimeoutMs:            svc.DrainTimeoutMs,
   194			RateLimitRps:              svc.RateLimitRps,
   195			RateLimitBurst:            svc.RateLimitBurst,
   196			RateLimitQueueDepth:       svc.RateLimitQueueDepth,
   197			RateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,
   198			MaxRetries:                svc.MaxRetries,
   199			RetryDelayMs:              svc.RetryDelayMs,
   200			RetryBackoffMultiplier:    svc.RetryBackoffMultiplier,
   201			RetryMaxDelayMs:           svc.RetryMaxDelayMs,
   202			rateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),
   203			MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
   204			ConnectionLimitMode:       svc.ConnectionLimitMode,
   205			IdleTimeoutMs:             svc.IdleTimeoutMs,
   206			listenerStop:              nil,
   207		}
   208		for _, ep := range svc.Endpoints {
   209			ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))
   210		}
   211		return ss
   212	}
   213	
   214	func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {
   215		ss.mu.Lock()
   216		defer ss.mu.Unlock()
   217		seen := make(map[string]bool)
   218		for _, cep := range eps {
   219			seen[cep.Address] = true
   220			var ep *EndpointState
   221			for _, existing := range ss.Endpoints {
   222				if existing.Address == cep.Address {
   223					ep = existing
   224					break
   225				}
   226			}
   227			if ep == nil {
   228				ep = newEndpointState(cep, global)
   229				ss.Endpoints = append(ss.Endpoints, ep)
   230			} else {
   231				ep.mu.Lock()
   232				ep.Config = cep
   233				ep.Weight = cep.Weight
   234				ep.WarmupDurationMs = cep.WarmupDurationMs
   235				ep.mu.Unlock()
   236			}
   237		}
   238		for _, ep := range ss.Endpoints {
   239			if !seen[ep.Address] {
   240				ep.StartDraining(ss.DrainTimeoutMs, true)
   241			}
   242		}
   243	}
   244	
   245	func newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {
   246		return &EndpointState{
   247			Address:          cep.Address,
   248			Weight:           cep.Weight,
   249			WarmupDurationMs: cep.WarmupDurationMs,
   250			Config:           cep,
   251			State:            Unknown,
   252			Circuit:          circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),
   253			Stats:            stats.New(time.Duration(global.StatsWindowSec) * time.Second),
   254			connections:      make(map[int64]*connectionInfo),
   255		}
   256	}
   257	
   258	func (s *State) GetService(name string) *ServiceState {
   259		s.mu.RLock()
   260		defer s.mu.RUnlock()
