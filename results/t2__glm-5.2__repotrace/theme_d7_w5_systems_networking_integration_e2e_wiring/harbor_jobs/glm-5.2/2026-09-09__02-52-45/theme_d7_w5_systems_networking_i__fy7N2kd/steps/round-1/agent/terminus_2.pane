[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // New creates a Logger for path and starts its writer goroutine.
[?2004l[?2004h> func New(path string) *Logger {
[?2004l[?2004h>     if path == "" {
[?2004l[?2004h>         path = DefaultPath
[?2004l[?2004h>     }
