   251				if !ok {
   252					ep.Stats.RecordRejection()
   253					backend.Close()
   254					client.Close()
   255					return
   256				}
   257			}
   258	
   259			if attempt > 0 {
   260				ep.Stats.RecordRetrySuccess()
