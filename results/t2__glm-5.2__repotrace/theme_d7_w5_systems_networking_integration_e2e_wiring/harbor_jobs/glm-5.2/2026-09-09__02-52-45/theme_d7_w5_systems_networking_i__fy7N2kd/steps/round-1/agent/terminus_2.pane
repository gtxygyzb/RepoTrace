   143				ConsecutiveFailures: ep.Circuit.ConsecutiveFailures(),
   144				TimeInStateMs:       ep.Circuit.TimeInStateMs(),
   145				ProbeActive:         ep.Circuit.ProbeActive(),
   146			})
   147			ep.mu.Unlock()
   148		}
   149		ss.mu.Unlock()
   150		return out, true
   151	}
   152	
   153	func (s *State) ResolveEndpoint(service string) (string, error) {
   154		ss := s.GetService(service)
   155		if ss == nil {
   156			return "", errNotFound("service not found")
   157		}
   158		ss.mu.Lock()
   159		maxConns := ss.MaxConnectionsPerEndpoint
   160		mode := ss.RoutingMode
   161		endpoints := make([]*EndpointState, len(ss.Endpoints))
   162		copy(endpoints, ss.Endpoints)
   163		ss.mu.Unlock()
   164	
   165		var regular []*EndpointState
   166		for _, ep := range endpoints {
   167			if ep.IsEligible(maxConns) {
   168				regular = append(regular, ep)
   169			}
   170		}
   171	
   172		if len(regular) > 0 {
   173			if mode == "least-connections" {
   174				ep := selectLeastConnections(regular, maxConns)
   175				return ep.Address, nil
   176			}
   177			var best *EndpointState
   178			var bestWeight int
   179			for _, ep := range regular {
   180				ep.mu.Lock()
   181				cw := ep.currentWeight + ep.Weight
   182				ep.mu.Unlock()
   183				if best == nil || cw > bestWeight {
   184					best = ep
   185					bestWeight = cw
   186				}
   187			}
   188			if best != nil {
   189				return best.Address, nil
   190			}
   191		}
   192	
   193		for _, ep := range endpoints {
   194			ep.mu.Lock()
   195			halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns && !ep.Circuit.ProbeActive()
   196			ep.mu.Unlock()
   197			if halfOpen {
   198				return ep.Address, nil
   199			}
   200		}
   201		return "", errNotFound("no eligible endpoints")
   202	}
