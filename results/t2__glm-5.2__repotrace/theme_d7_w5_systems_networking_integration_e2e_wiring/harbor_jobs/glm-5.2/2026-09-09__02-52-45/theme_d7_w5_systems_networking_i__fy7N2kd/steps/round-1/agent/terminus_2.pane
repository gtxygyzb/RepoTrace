   191	func newServiceState(svc config.Service, global config.Global) *ServiceState {
   192		ss := &ServiceState{
   193			Name:                      svc.Name,
   194			Stats:                     stats.New(time.Duration(global.StatsWindowSec) * time.Second),
   195			ListenPort:                svc.ListenPort,
   196			RoutingMode:               svc.RoutingMode,
   197			DrainTimeoutMs:            svc.DrainTimeoutMs,
   198			RateLimitRps:              svc.RateLimitRps,
   199			RateLimitBurst:            svc.RateLimitBurst,
   200			RateLimitQueueDepth:       svc.RateLimitQueueDepth,
   201			RateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,
   202			MaxRetries:                svc.MaxRetries,
   203			RetryDelayMs:              svc.RetryDelayMs,
   204			RetryBackoffMultiplier:    svc.RetryBackoffMultiplier,
   205			RetryMaxDelayMs:           svc.RetryMaxDelayMs,
   206			DependsOn:                 svc.DependsOn,
   207			rateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),
   208			MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
   209			ConnectionLimitMode:       svc.ConnectionLimitMode,
   210			IdleTimeoutMs:             svc.IdleTimeoutMs,
   211			listenerStop:              nil,
   212		}
   213		for _, ep := range svc.Endpoints {
   214			ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))
   215		}
   216		return ss
   217	}
   218	
   219	func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {
   220		ss.mu.Lock()
   221		defer ss.mu.Unlock()
   222		seen := make(map[string]bool)
   223		for _, cep := range eps {
   224			seen[cep.Address] = true
   225			var ep *EndpointState
   226			for _, existing := range ss.Endpoints {
   227				if existing.Address == cep.Address {
   228					ep = existing
   229					break
   230				}
   231			}
   232			if ep == nil {
   233				ep = newEndpointState(cep, global)
   234				ss.Endpoints = append(ss.Endpoints, ep)
   235			} else {
   236				ep.mu.Lock()
   237				ep.Config = cep
   238				ep.Weight = cep.Weight
   239				ep.WarmupDurationMs = cep.WarmupDurationMs
   240				ep.mu.Unlock()
   241			}
   242		}
   243		for _, ep := range ss.Endpoints {
   244			if !seen[ep.Address] {
   245				ep.StartDraining(ss.DrainTimeoutMs, true)
   246			}
   247		}
   248	}
