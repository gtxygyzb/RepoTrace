   106		NewState    string    `json:"new_state"`
   107		CheckResult string    `json:"check_result"`
   108	}
   109	
   110	func (s *State) HealthLogView(name string, lastN int) []HealthEventView {
   111		events := s.HealthLog(name, lastN)
