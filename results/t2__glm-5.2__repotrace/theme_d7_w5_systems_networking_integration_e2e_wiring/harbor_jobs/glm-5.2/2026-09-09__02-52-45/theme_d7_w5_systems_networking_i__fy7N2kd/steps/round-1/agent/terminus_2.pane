     5		"log"
     6		"net"
     7		"sync"
     8		"sync/atomic"
     9		"time"
    10	
    11		"meshrouter/internal/accesslog"
    12		"meshrouter/internal/state"
    13	)
    14	
    15	type serviceListener struct {
    16		service  string
    17		port     int
    18		listener net.Listener
    19		stop     chan struct{}
    20		wg       sync.WaitGroup
    21		done     chan struct{}
    22	}
    23	
    24	type Router struct {
    25		state     *state.State
    26		accessLog *accesslog.Logger
    27		mu        sync.Mutex
    28		listeners map[string]*serviceListener
    29	}
    30	
    31	func NewRouter(s *state.State) *Router {
    32		return &Router{
    33			state:     s,
    34			listeners: make(map[string]*serviceListener),
    35		}
    36	}
    37	
    38	func (r *Router) SetAccessLogger(l *accesslog.Logger) {
    39		r.accessLog = l
    40	}
    41	
    42	func (r *Router) Start() {
    43		for _, ss := range r.state.Services() {
    44			if !ss.IsStopping() {
    45				r.startService(ss)
    46			}
    47		}
    48	}
    49	
    50	func (r *Router) Reload() {
    51		services := r.state.Services()
    52		seen := make(map[string]bool)
    53		for _, ss := range services {
    54			seen[ss.Name] = true
    55			r.mu.Lock()
    56			sl, ok := r.listeners[ss.Name]
    57			r.mu.Unlock()
    58			if !ok {
    59				if !ss.IsStopping() {
    60					r.startService(ss)
    61				}
    62				continue
    63			}
    64			if sl.port != ss.ListenPort {
    65				r.stopService(ss.Name, true)
    66				r.startService(ss)
    67			}
    68		}
    69		r.mu.Lock()
    70		for name := range r.listeners {
    71			if !seen[name] {
    72				r.mu.Unlock()
    73				r.stopService(name, true)
    74				r.mu.Lock()
    75			}
    76		}
    77		r.mu.Unlock()
    78	}
    79	
    80	func (r *Router) startService(ss *state.ServiceState) {
    81		addr := ":" + intToStr(ss.ListenPort)
    82		ln, err := net.Listen("tcp", addr)
    83		if err != nil {
    84			log.Printf("router: listen %s on %s failed: %v", ss.Name, addr, err)
    85			return
    86		}
    87		sl := &serviceListener{
    88			service:  ss.Name,
    89			port:     ss.ListenPort,
    90			listener: ln,
    91			stop:     make(chan struct{}),
    92			done:     make(chan struct{}),
    93		}
    94		r.mu.Lock()
    95		r.listeners[ss.Name] = sl
    96		r.mu.Unlock()
    97		go sl.acceptLoop(r)
    98	}
    99	
   100	func (r *Router) stopService(name string, drain bool) {
   101		r.mu.Lock()
   102		sl, ok := r.listeners[name]
   103		if ok {
   104			delete(r.listeners, name)
   105		}
   106		r.mu.Unlock()
   107		if !ok {
   108			return
   109		}
   110		sl.stopAccept(drain, r)
   111	}
   112	
   113	func (r *Router) Stop() {
   114		r.mu.Lock()
   115		listeners := r.listeners
   116		r.listeners = make(map[string]*serviceListener)
   117		r.mu.Unlock()
   118		var wg sync.WaitGroup
   119		for name, sl := range listeners {
   120			wg.Add(1)
   121			go func(name string, sl *serviceListener) {
   122				defer wg.Done()
   123				sl.stopAccept(true, r)
   124			}(name, sl)
   125		}
   126		wg.Wait()
   127	}
   128	
   129	func (sl *serviceListener) acceptLoop(r *Router) {
   130		defer close(sl.done)
   131		for {
   132			conn, err := sl.listener.Accept()
   133			if err != nil {
   134				return
   135			}
   136			sl.wg.Add(1)
   137			go func(c net.Conn) {
   138				defer sl.wg.Done()
   139				r.handleConn(sl.service, c)
   140			}(conn)
   141		}
   142	}
   143	
   144	func (sl *serviceListener) stopAccept(drain bool, r *Router) {
   145		select {
   146		case <-sl.stop:
   147		default:
   148			close(sl.stop)
   149		}
   150		sl.listener.Close()
   151		<-sl.done
   152		if drain {
   153			ss := r.state.GetService(sl.service)
   154			timeout := 5 * time.Second
   155			if ss != nil {
   156				timeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond
   157				if timeout <= 0 {
   158					timeout = 5 * time.Second
   159				}
   160			}
   161			done := make(chan struct{})
   162			go func() {
   163				sl.wg.Wait()
   164				close(done)
   165			}()
   166			select {
   167			case <-done:
   168			case <-time.After(timeout):
   169				r.state.CloseServiceConnections(sl.service)
   170				<-done
   171			}
   172		} else {
   173			sl.wg.Wait()
   174		}
   175	}
   176	
   177	func (r *Router) handleConn(service string, client net.Conn) {
   178		start := time.Now()
   179		clientAddr := ""
   180		if addr := client.RemoteAddr(); addr != nil {
   181			clientAddr = addr.String()
   182		}
   183	
   184		var endpoint string
   185		var bytesIn, bytesOut int64
   186		var result string
   187		defer func() {
   188			if result == "" {
   189				result = "success"
   190			}
   191			if r.accessLog != nil {
   192				r.accessLog.Log(accesslog.Entry{
   193					Service:    service,
   194					Client:     clientAddr,
   195					Endpoint:   endpoint,
   196					BytesIn:    bytesIn,
   197					BytesOut:   bytesOut,
   198					DurationMs: time.Since(start).Milliseconds(),
   199					Result:     result,
   200				})
   201			}
   202		}()
   203	
   204		ss := r.state.GetService(service)
   205		if ss == nil {
   206			result = "rejected_no_endpoint"
   207			client.Close()
   208			return
   209		}
   210	
   211		allowed, queued := ss.AcquireRateLimitToken()
   212		if !allowed {
   213			result = "rejected_rate_limit"
   214			client.Close()
   215			return
   216		}
   217		if queued {
   218			if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   219				cand.Stats.RecordQueued()
   220			}
   221		}
   222	
   223		maxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()
   224		var lastEndpoint *state.EndpointState
   225		for attempt := 0; ; attempt++ {
   226			res, err := r.state.SelectEndpointExcluding(service, lastEndpoint)
   227			if err != nil {
   228				result = "rejected_no_endpoint"
   229				endpoint = ""
   230				if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   231					ss := r.state.GetService(service)
   232					if ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {
   233						cand.Stats.RecordRejection()
   234					}
   235				}
   236				client.Close()
   237				return
   238			}
   239			lastEndpoint = res.Endpoint
   240			ep := res.Endpoint
   241			endpoint = ep.Address
   242	
   243			var id int64
   244			if !res.Probe {
   245				var ok bool
   246				id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)
   247				if !ok {
   248					result = "rejected_conn_limit"
   249					ep.Stats.RecordRejection()
   250					client.Close()
   251					return
   252				}
   253			}
   254	
   255			backend, derr := net.Dial("tcp", ep.Address)
   256			if derr != nil {
   257				if id != 0 {
   258					ep.RemoveConnection(id)
   259				}
   260				ep.Stats.RecordConnection(0, 0, time.Since(start), true)
