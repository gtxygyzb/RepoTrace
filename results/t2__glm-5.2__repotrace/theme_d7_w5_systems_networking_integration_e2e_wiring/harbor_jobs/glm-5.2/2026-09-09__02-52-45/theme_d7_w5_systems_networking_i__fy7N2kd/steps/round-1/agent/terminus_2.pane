[?2004l     1	package main
     2	
     3	import (
     4		"flag"
     5		"log"
     6		"os"
     7		"os/signal"
     8		"sync"
     9		"syscall"
    10	
    11		"meshrouter/internal/config"
    12		"meshrouter/internal/health"
    13		"meshrouter/internal/ipc"
    14		"meshrouter/internal/router"
    15		"meshrouter/internal/state"
    16	)
    17	
    18	func main() {
    19		cfgPath := flag.String("config", "/app/config/services.toml", "path to services config")
    20		flag.Parse()
    21	
    22		cfg, err := config.Load(*cfgPath)
    23		if err != nil {
    24			log.Fatalf("config load failed: %v", err)
    25		}
    26	
    27		st := state.NewState(cfg, *cfgPath)
    28		monitor := health.NewMonitor(st, cfg)
    29		router := router.NewRouter(st)
    30		ipcServer := ipc.NewServer(st, "/tmp/meshd.sock")
    31	
    32		if err := ipcServer.Start(); err != nil {
    33			log.Fatalf("ipc server failed: %v", err)
    34		}
    35		monitor.Start()
    36		router.Start()
    37	
    38		sigCh := make(chan os.Signal, 1)
    39		signal.Notify(sigCh, syscall.SIGHUP, syscall.SIGTERM, syscall.SIGINT)
    40		var reloadMu sync.Mutex
    41		for {
    42			sig := <-sigCh
    43			if sig == syscall.SIGHUP {
    44				reloadMu.Lock()
    45				path := st.ConfigPath()
    46				newCfg, err := config.Load(path)
    47				if err != nil {
    48					log.Printf("reload failed: %v", err)
    49					reloadMu.Unlock()
    50					continue
    51				}
    52				st.ApplyConfig(newCfg)
    53				monitor.ApplyConfig(newCfg)
    54				router.Reload()
    55				reloadMu.Unlock()
    56				log.Printf("reloaded config")
    57			} else {
    58				break
    59			}
    60		}
    61	
    62		monitor.Stop()
    63		router.Stop()
    64		ipcServer.Stop()
    65	}
