   325	func (ep *EndpointState) IsEligible(maxConns int) bool {
   326		ep.mu.Lock()
   327		defer ep.mu.Unlock()
   328		return ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
   329	}
   330	
   331	func (s *State) RecordHealthCheck(service, address string, success bool) HealthEvent {
   332		ss := s.GetService(service)
   333		if ss == nil {
   334			return HealthEvent{}
   335		}
   336		ep := s.GetEndpoint(service, address)
   337		if ep == nil {
   338			return HealthEvent{}
   339		}
   340		global := s.Global()
   341		ep.mu.Lock()
   342		oldState := ep.State
   343		result := "success"
   344		if !success {
   345			result = "failure"
   346		}
   347		if success {
   348			ep.consecSuccess++
   349			ep.consecFailures = 0
   350			if oldState == Unknown && ep.consecSuccess >= global.HealthyThreshold {
   351				ep.State = Healthy
   352			} else if oldState == Unhealthy && ep.consecSuccess >= global.HealthyThreshold {
   353				ep.State = Healthy
   354			}
   355		} else {
   356			ep.consecFailures++
   357			ep.consecSuccess = 0
   358			if (oldState == Healthy || oldState == Unknown) && ep.consecFailures >= global.UnhealthyThreshold {
   359				ep.State = Unhealthy
   360				ep.Circuit.Open()
   361				ep.consecFailures = 0
   362				timeout := time.Duration(ss.DrainTimeoutMs) * time.Millisecond
   363				go func(deadline time.Time) {
   364					time.Sleep(time.Until(deadline))
   365					ep.mu.Lock()
   366					ep.closeConnectionsLocked()
   367					ep.mu.Unlock()
   368				}(time.Now().Add(timeout))
   369			}
   370		}
   371		newState := ep.State
   372		ep.mu.Unlock()
   373		evt := HealthEvent{
   374			Timestamp:   time.Now(),
   375			Endpoint:    address,
   376			OldState:    oldState,
   377			NewState:    newState,
   378			CheckResult: result,
   379		}
   380		s.logMu.Lock()
   381		s.healthLog[service] = append(s.healthLog[service], evt)
   382		if len(s.healthLog[service]) > 1000 {
   383			s.healthLog[service] = s.healthLog[service][len(s.healthLog[service])-1000:]
   384		}
   385		s.logMu.Unlock()
   386		return evt
   387	}
   388	
   389	func (s *State) HealthLog(service string, lastN int) []HealthEvent {
   390		s.logMu.Lock()
   391		defer s.logMu.Unlock()
   392		events := s.healthLog[service]
   393		if lastN <= 0 || lastN > len(events) {
   394			lastN = len(events)
   395		}
   396		out := make([]HealthEvent, lastN)
   397		copy(out, events[len(events)-lastN:])
   398		return out
   399	}
