   273	
   274	func (r *Router) sleepRetry(attempt, delayMs int, multiplier float64, maxDelayMs int) {
   275		if attempt < 0 {
   276			attempt = 0
   277		}
   278		delay := float64(delayMs) * pow(multiplier, float64(attempt))
   279		if maxDelayMs > 0 && delay > float64(maxDelayMs) {
   280			delay = float64(maxDelayMs)
   281		}
   282		if delay > 0 {
   283			time.Sleep(time.Duration(delay) * time.Millisecond)
   284		}
   285	}
   286	
   287	func pow(base, exp float64) float64 {
   288		result := 1.0
   289		for i := 0; i < int(exp); i++ {
   290			result *= base
   291		}
   292		return result
   293	}
