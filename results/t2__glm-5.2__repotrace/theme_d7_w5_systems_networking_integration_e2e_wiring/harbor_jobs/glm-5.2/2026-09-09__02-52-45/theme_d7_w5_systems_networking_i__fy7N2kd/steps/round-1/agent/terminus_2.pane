    18	
    19	type Request struct {
    20		Cmd  string          `json:"cmd"`
    21		Args json.RawMessage `json:"args"`
    22	}
    23	
    24	type Response struct {
    25		Status string      `json:"status"`
    26		Data   interface{} `json:"data"`
    27	}
    28	
    29	type Server struct {
    30		state    *state.State
    31		path     string
    32		listener net.Listener
    33		wg       sync.WaitGroup
    34		stop     chan struct{}
    35		done     chan struct{}
    36	}
    37	
    38	func NewServer(s *state.State, path string) *Server {
    39		return &Server{
    40			state: s,
    41			path:  path,
    42			stop:  make(chan struct{}),
    43			done:  make(chan struct{}),
    44		}
    45	}
    46	
    47	func (s *Server) Start() error {
    48		os.Remove(s.path)
    49		ln, err := net.Listen("unix", s.path)
    50		if err != nil {
    51			return err
    52		}
    53		s.listener = ln
    54		go s.acceptLoop()
    55		return nil
    56	}
    57	
    58	func (s *Server) Stop() {
    59		select {
    60		case <-s.stop:
    61		default:
    62			close(s.stop)
    63		}
    64		if s.listener != nil {
    65			s.listener.Close()
    66		}
    67		<-s.done
    68		os.Remove(s.path)
    69	}
    70	
    71	func (s *Server) acceptLoop() {
    72		defer close(s.done)
    73		for {
    74			conn, err := s.listener.Accept()
    75			if err != nil {
    76				return
    77			}
    78			s.wg.Add(1)
    79			go s.handleConn(conn)
    80		}
    81	}
    82	
    83	func (s *Server) handleConn(conn net.Conn) {
    84		defer s.wg.Done()
    85		defer conn.Close()
    86		reader := bufio.NewReader(conn)
    87		for {
    88			line, err := reader.ReadString('\n')
    89			if err != nil {
    90				return
    91			}
    92			line = strings.TrimRight(line, "\r\n")
    93			if line == "" {
    94				continue
    95			}
    96			resp := s.handleLine(line)
    97			_, _ = conn.Write([]byte(resp + "\n"))
    98		}
    99	}
   100	
   101	func (s *Server) handleLine(line string) string {
   102		var req Request
   103		if err := json.Unmarshal([]byte(line), &req); err != nil {
   104			return encodeResp(Response{Status: "error", Data: err.Error()})
   105		}
   106		data, err := s.dispatch(req)
   107		if err != nil {
   108			return encodeResp(Response{Status: "error", Data: err.Error()})
   109		}
   110		return encodeResp(Response{Status: "ok", Data: data})
   111	}
   112	
   113	func encodeResp(r Response) string {
   114		b, _ := json.Marshal(r)
   115		return string(b)
   116	}
