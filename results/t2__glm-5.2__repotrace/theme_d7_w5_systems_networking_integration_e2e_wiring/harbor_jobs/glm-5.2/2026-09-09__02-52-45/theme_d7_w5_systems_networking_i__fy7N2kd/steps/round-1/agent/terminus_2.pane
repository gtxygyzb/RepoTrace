[?2004hroot@n30009:/app# sed -n '1,220p' internal/accesslog/logger.go
[?2004lpackage accesslog

import (
	"encoding/json"
	"os"
	"path/filepath"
	"sync"
	"sync/atomic"
	"time"
)

// Entry is one structured access log record.
type Entry struct {
	Ts         string `json:"ts"`
	Service    string `json:"service"`
	Client     string `json:"client"`
	Endpoint   string `json:"endpoint"`
	BytesIn    int64  `json:"bytes_in"`
	BytesOut   int64  `json:"bytes_out"`
	DurationMs int64  `json:"duration_ms"`
	Result     string `json:"result"`
}

// DefaultPath is the access log path required by meshrouter.
const DefaultPath = "/app/logs/access.log"

const maxFileSize = 1 << 20 // 1 MB

// Logger writes access log entries asynchronously to a JSON-lines file.
type Logger struct {
	path     string
	ch       chan Entry
	stop     chan struct{}
	done     chan struct{}
	stopped  int32
	stopOnce sync.Once
	mu       sync.Mutex
	file     *os.File
	size     int64
}

// New creates a Logger for path and starts its writer goroutine.
func New(path string) *Logger {
	if path == "" {
		path = DefaultPath
	}
	l := &Logger{
		path: path,
		ch:   make(chan Entry, 8192),
		stop: make(chan struct{}),
		done: make(chan struct{}),
	}
	go l.run()
	return l
}

// Path returns the configured log file path.
func (l *Logger) Path() string {
	return l.path
}

// Log queues an entry for asynchronous writing. If the buffered channel is full,
// the entry is written synchronously to avoid losing it.
func (l *Logger) Log(entry Entry) {
	if atomic.LoadInt32(&l.stopped) != 0 {
		return
	}
	entry.Ts = time.Now().UTC().Format(time.RFC3339Nano)
	select {
	case l.ch <- entry:
	default:
		l.writeLine(entry)
	}
}

// Stop flushes all buffered entries and closes the log file.
func (l *Logger) Stop() {
	l.stopOnce.Do(func() {
		atomic.StoreInt32(&l.stopped, 1)
		close(l.stop)
		<-l.done
		l.mu.Lock()
		if l.file != nil {
			l.file.Close()
			l.file = nil
		}
		l.mu.Unlock()
	})
}

func (l *Logger) run() {
	for {
		select {
		case e := <-l.ch:
			l.writeLine(e)
		case <-l.stop:
			l.drain()
			close(l.done)
			return
		}
	}
}

func (l *Logger) drain() {
	for {
		select {
		case e := <-l.ch:
			l.writeLine(e)
		default:
			return
		}
	}
}

func (l *Logger) writeLine(e Entry) {
	b, err := json.Marshal(e)
	if err != nil {
		return
	}
	b = append(b, '\n')

	l.mu.Lock()
	defer l.mu.Unlock()

	if l.file == nil {
		if err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {
			return
		}
		f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
		if err != nil {
			return
		}
		l.file = f
		if info, err := f.Stat(); err == nil {
			l.size = info.Size()
		}
	}

	if l.size > 0 && l.size+int64(len(b)) > maxFileSize {
		l.rotateLocked()
	}

	n, err := l.file.Write(b)
	if err != nil {
		l.size = 0
		if l.file != nil {
			l.file.Close()
			l.file = nil
		}
		return
	}
	l.size += int64(n)
}

func (l *Logger) rotateLocked() {
	if l.file != nil {
		l.file.Close()
		l.file = nil
	}
	os.Remove(l.path + ".1")
	if err := os.Rename(l.path, l.path+".1"); err != nil {
		f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
		if err == nil {
			l.file = f
			if info, err := f.Stat(); err == nil {
				l.size = info.Size()
			}
		}
		return
	}
	f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
	if err != nil {
		l.size = 0
		return
	}
	l.file = f
	l.size = 0
}
