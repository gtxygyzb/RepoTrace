   183	
   184	func newServiceState(svc config.Service, global config.Global) *ServiceState {
   185		ss := &ServiceState{
   186			Name:                      svc.Name,
   187			ListenPort:                svc.ListenPort,
   188			RoutingMode:               svc.RoutingMode,
   189			DrainTimeoutMs:            svc.DrainTimeoutMs,
   190			RateLimitRps:              svc.RateLimitRps,
   191			RateLimitBurst:            svc.RateLimitBurst,
   192			RateLimitQueueDepth:       svc.RateLimitQueueDepth,
   193			RateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,
   194			MaxRetries:                svc.MaxRetries,
   195			RetryDelayMs:              svc.RetryDelayMs,
   196			RetryBackoffMultiplier:    svc.RetryBackoffMultiplier,
   197			RetryMaxDelayMs:           svc.RetryMaxDelayMs,
   198			rateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),
   199			MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
   200			IdleTimeoutMs:             svc.IdleTimeoutMs,
   201			listenerStop:              nil,
   202		}
   203		for _, ep := range svc.Endpoints {
   204			ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))
   205		}
   206		return ss
   207	}
   208	
   209	func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {
   210		ss.mu.Lock()
   211		defer ss.mu.Unlock()
   212		seen := make(map[string]bool)
   213		for _, cep := range eps {
   214			seen[cep.Address] = true
   215			var ep *EndpointState
   216			for _, existing := range ss.Endpoints {
   217				if existing.Address == cep.Address {
   218					ep = existing
   219					break
   220				}
   221			}
   222			if ep == nil {
   223				ep = newEndpointState(cep, global)
   224				ss.Endpoints = append(ss.Endpoints, ep)
   225			} else {
   226				ep.mu.Lock()
   227				ep.Config = cep
   228				ep.Weight = cep.Weight
   229				ep.mu.Unlock()
   230			}
   231		}
   232		for _, ep := range ss.Endpoints {
   233			if !seen[ep.Address] {
   234				ep.StartDraining(ss.DrainTimeoutMs, true)
   235			}
   236		}
   237	}
   238	
   239	func newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {
   240		return &EndpointState{
   241			Address:     cep.Address,
   242			Weight:      cep.Weight,
   243			Config:      cep,
   244			State:       Unknown,
   245			Circuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),
   246			Stats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),
   247			connections: make(map[int64]*connectionInfo),
   248		}
   249	}
   250	
   251	func (s *State) GetService(name string) *ServiceState {
   252		s.mu.RLock()
   253		defer s.mu.RUnlock()
   254		return s.services[name]
   255	}
   256	
   257	func (s *State) Services() []*ServiceState {
   258		s.mu.RLock()
   259		defer s.mu.RUnlock()
   260		out := make([]*ServiceState, 0, len(s.services))
   261		for _, ss := range s.services {
   262			out = append(out, ss)
   263		}
   264		return out
   265	}
   266	
   267	func (s *State) GetEndpoint(service, address string) *EndpointState {
   268		ss := s.GetService(service)
   269		if ss == nil {
   270			return nil
   271		}
   272		ss.mu.Lock()
   273		defer ss.mu.Unlock()
   274		for _, ep := range ss.Endpoints {
   275			if ep.Address == address {
   276				return ep
   277			}
   278		}
   279		return nil
   280	}
   281	
   282	func (s *State) SetWeight(service, address string, weight int) error {
   283		ep := s.GetEndpoint(service, address)
   284		if ep == nil {
   285			return errNotFound("endpoint not found")
   286		}
   287		ep.mu.Lock()
   288		defer ep.mu.Unlock()
   289		if weight < 0 {
   290			weight = 0
   291		}
   292		ep.Weight = weight
   293		return nil
   294	}
   295	
   296	func (s *State) DrainEndpoint(service, address string) error {
   297		ss := s.GetService(service)
   298		if ss == nil {
   299			return errNotFound("service not found")
   300		}
   301		ep := s.GetEndpoint(service, address)
   302		if ep == nil {
   303			return errNotFound("endpoint not found")
   304		}
   305		ep.StartDraining(ss.DrainTimeoutMs, false)
   306		return nil
   307	}
   308	
   309	func (s *State) ResetCircuitBreaker(service, address string) error {
   310		ep := s.GetEndpoint(service, address)
   311		if ep == nil {
   312			return errNotFound("endpoint not found")
   313		}
   314		ep.Circuit.Reset()
   315		return nil
   316	}
   317	
   318	func (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {
   319		ep.mu.Lock()
   320		defer ep.mu.Unlock()
   321		ep.State = Draining
   322		ep.consecSuccess = 0
   323		ep.consecFailures = 0
   324		ep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)
   325		if markRemoved {
   326			ep.removed = true
   327		}
   328		if len(ep.connections) > 0 {
   329			go func(deadline time.Time) {
   330				time.Sleep(time.Until(deadline))
   331				ep.mu.Lock()
   332				ep.closeConnectionsLocked()
   333				ep.mu.Unlock()
   334			}(ep.drainDeadline)
   335		}
   336	}
