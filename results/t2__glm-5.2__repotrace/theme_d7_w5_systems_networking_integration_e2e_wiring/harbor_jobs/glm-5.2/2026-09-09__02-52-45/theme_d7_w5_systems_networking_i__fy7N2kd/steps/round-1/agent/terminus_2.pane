		clientAddr = addr.String()
	}

	var endpoint string
	var bytesIn, bytesOut int64
	var result string
	var retryCount int
	var queueWaitMs int64
	defer func() {
		if result == "" {
			result = "success"
		}
		if r.accessLog != nil {
			r.accessLog.Log(accesslog.Entry{
				Service:    service,
				Client:     clientAddr,
				Endpoint:   endpoint,
				BytesIn:    bytesIn,
				BytesOut:   bytesOut,
				DurationMs: time.Since(start).Milliseconds(),
				Result:     result,
			})
		}
	}()

	ss := r.state.GetService(service)
	if ss == nil {
		result = "rejected_no_endpoint"
		client.Close()
		return
	}

	allowed, queued, waitMs, timedOut := ss.AcquireRateLimitToken()
	if !allowed {
		result = "rejected_rate_limit"
		queueWaitMs = waitMs
		_ = timedOut
		client.Close()
		return
	}
	if queued {
		if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
			cand.Stats.RecordQueued()
		}
	}
