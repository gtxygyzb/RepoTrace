import (
	"bufio"
	"encoding/json"
	"fmt"
	"net"
	"os"
	"sort"
	"strconv"
	"strings"
)

type request struct {
	Cmd  string          `json:"cmd"`
	Args json.RawMessage `json:"args"`
}

type response struct {
	Status string          `json:"status"`
	Data   json.RawMessage `json:"data"`
}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: meshctl <command> [args]")
		os.Exit(1)
	}

	cliCmd := os.Args[1]
	args := make(map[string]interface{})
	var ipcCmd string

	switch cliCmd {
	case "status":
		ipcCmd = "list_services"
	case "stats":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl stats <service>")
			os.Exit(1)
		}
		ipcCmd = "get_stats"
		args["name"] = os.Args[2]
	case "set-weight":
		if len(os.Args) < 5 {
			fmt.Fprintln(os.Stderr, "usage: meshctl set-weight <service> <endpoint> <weight>")
			os.Exit(1)
		}
		weight, err := strconv.Atoi(os.Args[4])
		if err != nil {
			fmt.Fprintf(os.Stderr, "invalid weight: %v\n", err)
			os.Exit(1)
		}
		ipcCmd = "set_weight"
		args["name"] = os.Args[2]
		args["address"] = os.Args[3]
		args["weight"] = weight
	case "drain":
		if len(os.Args) < 4 {
			fmt.Fprintln(os.Stderr, "usage: meshctl drain <service> <endpoint>")
			os.Exit(1)
		}
		ipcCmd = "drain_endpoint"
		args["name"] = os.Args[2]
		args["address"] = os.Args[3]
	case "health-log":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl health-log <service> [--last N]")
			os.Exit(1)
		}
		ipcCmd = "get_health_log"
		args["name"] = os.Args[2]
		last := 20
		for _, a := range os.Args[3:] {
			if strings.HasPrefix(a, "--last") && len(a) > 6 {
				if v, err := strconv.Atoi(a[6:]); err == nil {
					last = v
				}
			}
		}
		args["last_n"] = last
	case "resolve":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl resolve <service>")
			os.Exit(1)
		}
		ipcCmd = "resolve"
		args["name"] = os.Args[2]
	case "circuits":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl circuits <service>")
			os.Exit(1)
		}
		ipcCmd = "get_circuit_breakers"
		args["name"] = os.Args[2]
	case "reset-circuit":
		if len(os.Args) < 4 {
			fmt.Fprintln(os.Stderr, "usage: meshctl reset-circuit <service> <endpoint>")
			os.Exit(1)
		}
		ipcCmd = "reset_circuit_breaker"
		args["name"] = os.Args[2]
		args["address"] = os.Args[3]
	case "reload":
		ipcCmd = "reload_config"
	case "rate-limit":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl rate-limit <service>")
			os.Exit(1)
		}
		ipcCmd = "get_rate_limit_status"
		args["name"] = os.Args[2]
	case "warmup":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl warmup <service>")
			os.Exit(1)
		}
		ipcCmd = "get_warmup_status"
		args["name"] = os.Args[2]
	case "connections":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl connections <service>")
			os.Exit(1)
		}
		ipcCmd = "get_connections"
		args["name"] = os.Args[2]
	case "set-rate-limit":
		if len(os.Args) < 5 {
			fmt.Fprintln(os.Stderr, "usage: meshctl set-rate-limit <service> <rps> <burst>")
			os.Exit(1)
		}
		rps, err := strconv.Atoi(os.Args[3])
		if err != nil {
			fmt.Fprintf(os.Stderr, "invalid rps: %v\n", err)
			os.Exit(1)
		}
		burst, err := strconv.Atoi(os.Args[4])
		if err != nil {
			fmt.Fprintf(os.Stderr, "invalid burst: %v\n", err)
			os.Exit(1)
		}
		ipcCmd = "set_rate_limit"
		args["name"] = os.Args[2]
		args["rps"] = rps
		args["burst"] = burst
	case "access-log":
		ipcCmd = "get_access_log"
		last := 20
		rest := os.Args[2:]
		for i := 0; i < len(rest); i++ {
			a := rest[i]
			if a == "--last" {
				if i+1 < len(rest) {
					if v, err := strconv.Atoi(rest[i+1]); err == nil {
						last = v
					}
					i++
				}
			} else if strings.HasPrefix(a, "--last=") {
				if v, err := strconv.Atoi(a[len("--last="):]); err == nil {
					last = v
				}
			} else if a == "--result" {
				if i+1 < len(rest) {
					args["result"] = rest[i+1]
					i++
				}
			} else if strings.HasPrefix(a, "--result=") {
				args["result"] = a[len("--result="):]
			} else if !strings.HasPrefix(a, "-") {
				args["service"] = a
			}
		}
		args["last_n"] = last
	case "access-stats":
		ipcCmd = "get_access_stats"
		for _, a := range os.Args[2:] {
			if !strings.HasPrefix(a, "-") {
				args["service"] = a
			}
		}
	case "deps":
		if len(os.Args) >= 3 {
			ipcCmd = "get_dependencies"
			args["name"] = os.Args[2]
		} else {
			out, err := depsAll()
			if err != nil {
				fmt.Fprintln(os.Stderr, err)
				os.Exit(1)
			}
			fmt.Println(out)
			return
		}
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", cliCmd)
		os.Exit(1)
	}

	data, err := sendCommand(ipcCmd, args)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Println(data)
}

func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {
	data, err := sendRaw(ipcCmd, args)
	if err != nil {
		return "", err
	}
	return prettyData(ipcCmd, data)
}

func depsAll() (string, error) {
	raw, err := sendRaw("list_services", nil)
	if err != nil {
		return "", err
	}
	var services []struct {
		Name string `json:"name"`
	}
	if err := json.Unmarshal(raw, &services); err != nil {
		return "", err
	}
	type depRow struct {
		Service          string
		Name             string
		Available        bool
		HealthyEndpoints int
	}
	var rows []depRow
	for _, svc := range services {
		depRaw, err := sendRaw("get_dependencies", map[string]interface{}{"name": svc.Name})
		if err != nil {
			return "", err
		}
		var resp struct {
			Service      string `json:"service"`
			Dependencies []struct {
				Name             string `json:"name"`
				Available        bool   `json:"available"`
				HealthyEndpoints int    `json:"healthy_endpoints"`
			} `json:"dependencies"`
		}
		if err := json.Unmarshal(depRaw, &resp); err != nil {
			return "", err
		}
		for _, dep := range resp.Dependencies {
			rows = append(rows, depRow{Service: svc.Name, Name: dep.Name, Available: dep.Available, HealthyEndpoints: dep.HealthyEndpoints})
		}
	}
	if len(rows) == 0 {
		return "no dependencies", nil
	}
	var b strings.Builder
	fmt.Fprintf(&b, "%-14s %-14s %-10s %-18s\n", "SERVICE", "DEPENDS_ON", "AVAILABLE", "HEALTHY_ENDPOINTS")
	for _, row := range rows {
		fmt.Fprintf(&b, "%-14s %-14s %-10t %-18d\n", row.Service, row.Name, row.Available, row.HealthyEndpoints)
	}
	return strings.TrimRight(b.String(), "\n"), nil
}

func sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {
	rawArgs, err := json.Marshal(args)
	if err != nil {
		return nil, err
	}
	req := request{Cmd: ipcCmd, Args: rawArgs}
	reqBytes, err := json.Marshal(req)
	if err != nil {
		return nil, err
	}

	conn, err := net.Dial("unix", "/tmp/meshd.sock")
	if err != nil {
		return nil, fmt.Errorf("connect to meshd failed: %w", err)
	}
	defer conn.Close()

	fmt.Fprintf(conn, "%s\n", string(reqBytes))

	reader := bufio.NewReader(conn)
	line, err := reader.ReadString('\n')
	if err != nil {
		return nil, err
	}
	line = strings.TrimRight(line, "\r\n")

	var resp response
	if err := json.Unmarshal([]byte(line), &resp); err != nil {
		return nil, err
	}
	if resp.Status != "ok" {
		var msg string
		if err := json.Unmarshal(resp.Data, &msg); err == nil {
			return nil, fmt.Errorf("%s", msg)
		}
		return nil, fmt.Errorf("%s", string(resp.Data))
	}
	return resp.Data, nil
}

func prettyData(ipcCmd string, data json.RawMessage) (string, error) {
	switch ipcCmd {
	case "list_services":
		var services []struct {
			Name        string `json:"name"`
			ListenPort  int    `json:"listen_port"`
			RoutingMode string `json:"routing_mode"`
			Endpoints   []struct {
				Address           string `json:"address"`
				State             string `json:"state"`
				Weight            int    `json:"weight"`
				ActiveConnections int    `json:"active_connections"`
				CircuitState      string `json:"circuit_state"`
			} `json:"endpoints"`
		}
		if err := json.Unmarshal(data, &services); err != nil {
			return "", err
		}
		var b strings.Builder
		fmt.Fprintf(&b, "%-14s %-18s %-10s %-7s %-11s %-7s\n", "SERVICE", "ENDPOINT", "STATE", "WEIGHT", "CIRCUIT", "ACTIVE")
		for _, svc := range services {
			for _, ep := range svc.Endpoints {
				fmt.Fprintf(&b, "%-14s %-18s %-10s %-7d %-11s %-7d\n", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)
			}
		}
		return strings.TrimRight(b.String(), "\n"), nil
	case "resolve":
		var addr string
		if err := json.Unmarshal(data, &addr); err != nil {
			return "", err
		}
		return addr, nil
	case "get_circuit_breakers":
		var circuits []struct {
			Address             string `json:"address"`
			CircuitState        string `json:"circuit_state"`
