   222			}
   223			return strings.TrimRight(b.String(), "\n"), nil
   224		case "resolve":
   225			var addr string
   226			if err := json.Unmarshal(data, &addr); err != nil {
   227				return "", err
   228			}
   229			return addr, nil
   230		case "get_circuit_breakers":
   231			var circuits []struct {
