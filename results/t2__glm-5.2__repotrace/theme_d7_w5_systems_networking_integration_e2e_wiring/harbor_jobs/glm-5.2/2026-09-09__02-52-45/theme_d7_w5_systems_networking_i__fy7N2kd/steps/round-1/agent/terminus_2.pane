   119	func (s *State) applyConfigLocked(cfg *config.Config) {
   120		s.global = cfg.Global
   121		seen := make(map[string]bool)
   122		for _, svc := range cfg.Services {
   123			seen[svc.Name] = true
   124			ss := s.services[svc.Name]
   125			if ss == nil {
   126				ss = newServiceState(svc, cfg.Global)
   127				s.services[svc.Name] = ss
   128			} else {
   129				ss.mu.Lock()
   130				ss.Name = svc.Name
   131				ss.ListenPort = svc.ListenPort
   132				ss.RoutingMode = svc.RoutingMode
   133				ss.DrainTimeoutMs = svc.DrainTimeoutMs
   134				ss.RateLimitRps = svc.RateLimitRps
   135				ss.RateLimitBurst = svc.RateLimitBurst
   136				ss.RateLimitQueueDepth = svc.RateLimitQueueDepth
   137				ss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs
   138				ss.MaxRetries = svc.MaxRetries
   139				ss.RetryDelayMs = svc.RetryDelayMs
   140				ss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier
   141				ss.RetryMaxDelayMs = svc.RetryMaxDelayMs
   142				if ss.rateLimiter == nil {
   143					ss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   144				} else {
   145					ss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   146				}
   147				ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint
   148				ss.mu.Unlock()
   149				ss.applyEndpoints(svc.Endpoints, cfg.Global)
   150			}
   151		}
   152		for name, ss := range s.services {
   153			if !seen[name] {
   154				ss.mu.Lock()
   155				ss.stopping = true
   156				if ss.listenerStop != nil {
   157					close(ss.listenerStop)
   158					ss.listenerStop = nil
   159				}
   160				if ss.Listener != nil {
[?2004hroot@n30009:/app# nl -ba internal/state/state.go | sed -n '161,240p'
[?2004l   161					ss.Listener.Close()
   162					ss.Listener = nil
   163				}
   164				ss.mu.Unlock()
   165				for _, ep := range ss.Endpoints {
   166					ep.StartDraining(ss.DrainTimeoutMs, true)
   167				}
