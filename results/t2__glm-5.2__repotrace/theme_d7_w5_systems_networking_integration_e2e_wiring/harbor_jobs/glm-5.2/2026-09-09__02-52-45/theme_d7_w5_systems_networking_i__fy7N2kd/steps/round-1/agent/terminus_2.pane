   171		start := time.Now()
   172		ss := r.state.GetService(service)
   173		if ss == nil {
   174			client.Close()
   175			return
   176		}
   177	
   178		allowed, queued := ss.AcquireRateLimitToken()
   179		if !allowed {
   180			if queued {
   181				if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   182					cand.Stats.RecordQueueTimeout()
   183				}
   184			} else {
   185				if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   186					cand.Stats.RecordRateLimited()
   187				}
   188			}
   189			client.Close()
   190			return
   191		}
   192		if queued {
   193			if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   194				cand.Stats.RecordQueued()
   195			}
   196		}
   197	
   198		maxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()
   199		var lastEndpoint *state.EndpointState
   200		for attempt := 0; ; attempt++ {
   201			res, err := r.state.SelectEndpointExcluding(service, lastEndpoint)
   202			if err != nil {
   203				if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   204					ss := r.state.GetService(service)
   205					if ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {
   206						cand.Stats.RecordRejection()
   207					}
   208				}
   209				client.Close()
   210				return
   211			}
   212			lastEndpoint = res.Endpoint
   213			ep := res.Endpoint
   214	
   215			var id int64
   216			if !res.Probe {
   217				var ok bool
   218				id, ok = ep.TryAddConnection(client, res.MaxConns)
   219				if !ok {
   220					ep.Stats.RecordRejection()
   221					if attempt >= maxRetries {
   222						client.Close()
   223						return
   224					}
   225					r.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)
   226					continue
   227				}
   228			}
   229	
   230			backend, derr := net.Dial("tcp", ep.Address)
   231			if derr != nil {
   232				if id != 0 {
   233					ep.RemoveConnection(id)
   234				}
   235				ep.Stats.RecordConnection(0, 0, time.Since(start), true)
   236				if res.Probe {
   237					ep.Circuit.ProbeFailure()
   238				} else {
   239					ep.Circuit.Open()
   240				}
   241				if attempt >= maxRetries {
   242					client.Close()
   243					return
   244				}
   245				ep.Stats.RecordRetry()
   246				r.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)
   247				continue
   248			}
   249	
   250			if res.Probe {
   251				ep.Circuit.ProbeSuccess()
   252				var ok bool
   253				id, ok = ep.TryAddConnection(client, res.MaxConns)
   254				if !ok {
   255					ep.Stats.RecordRejection()
   256					backend.Close()
   257					client.Close()
   258					return
   259				}
   260			}
   261	
   262			if attempt > 0 {
   263				ep.Stats.RecordRetrySuccess()
   264			}
   265			bytesIn, bytesOut := forward(client, backend)
   266			backend.Close()
   267			client.Close()
   268			ep.RemoveConnection(id)
   269			ep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)
   270			return
