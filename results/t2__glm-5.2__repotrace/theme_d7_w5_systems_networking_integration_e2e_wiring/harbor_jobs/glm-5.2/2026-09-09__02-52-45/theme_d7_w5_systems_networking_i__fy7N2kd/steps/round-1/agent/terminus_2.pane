   129	// removeDependencyCycles drops dependency edges that would create cycles.
   130	func removeDependencyCycles(services []Service) []Service {
   131		byName := make(map[string]int, len(services))
   132		for i, svc := range services {
   133			byName[svc.Name] = i
   134		}
   135		for i := range services {
   136			seen := map[string]bool{services[i].Name: true}
   137			kept := make([]string, 0, len(services[i].DependsOn))
   138			for _, dep := range services[i].DependsOn {
   139				if dep == services[i].Name {
   140					log.Printf("warning: dropping self dependency from %s to %s", services[i].Name, dep)
   141					continue
   142				}
   143				if _, ok := byName[dep]; !ok {
   144					kept = append(kept, dep)
   145					continue
   146				}
   147				if createsCycle(services, byName, seen, services[i].Name, dep) {
   148					log.Printf("warning: dropping dependency edge from %s to %s to avoid circular dependency", services[i].Name, dep)
   149					continue
   150				}
   151				kept = append(kept, dep)
   152			}
   153			services[i].DependsOn = kept
   154		}
   155		return services
   156	}
   157	
   158	func createsCycle(services []Service, byName map[string]int, seen map[string]bool, start, dep string) bool {
   159		if seen[dep] {
   160			return true
   161		}
   162		seen[dep] = true
   163		defer delete(seen, dep)
   164		next := services[byName[dep]].DependsOn
   165		for _, d := range next {
   166			if d == start || d == dep {
   167				return true
   168			}
   169			if _, ok := byName[d]; !ok {
   170				continue
   171			}
   172			if createsCycle(services, byName, seen, start, d) {
   173				return true
   174			}
   175		}
   176		return false
   177	}
