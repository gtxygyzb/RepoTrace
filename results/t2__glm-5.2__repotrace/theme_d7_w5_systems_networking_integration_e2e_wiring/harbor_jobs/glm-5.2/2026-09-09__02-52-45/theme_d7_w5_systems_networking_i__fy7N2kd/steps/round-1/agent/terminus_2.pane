     2	
     3	import (
     4		"encoding/json"
     5		"os"
     6		"path/filepath"
     7		"sync"
     8		"sync/atomic"
     9		"time"
    10	)
    11	
    12	// Entry is one structured access log record.
    13	type Entry struct {
    14		Ts         string `json:"ts"`
    15		Service    string `json:"service"`
    16		Client     string `json:"client"`
    17		Endpoint   string `json:"endpoint"`
    18		BytesIn    int64  `json:"bytes_in"`
    19		BytesOut   int64  `json:"bytes_out"`
    20		DurationMs int64  `json:"duration_ms"`
    21		Result     string `json:"result"`
    22	}
    23	
    24	// DefaultPath is the access log path required by meshrouter.
    25	const DefaultPath = "/app/logs/access.log"
    26	
    27	const maxFileSize = 1 << 20 // 1 MB
    28	
    29	// Logger writes access log entries asynchronously to a JSON-lines file.
    30	type Logger struct {
    31		path     string
    32		ch       chan Entry
    33		stop     chan struct{}
    34		done     chan struct{}
    35		stopped  int32
    36		stopOnce sync.Once
    37		mu       sync.Mutex
    38		file     *os.File
    39		size     int64
    40	}
    41	
    42	// New creates a Logger for path and starts its writer goroutine.
    43	func New(path string) *Logger {
    44		if path == "" {
    45			path = DefaultPath
    46		}
    47		l := &Logger{
    48			path: path,
    49			ch:   make(chan Entry, 8192),
    50			stop: make(chan struct{}),
    51			done: make(chan struct{}),
    52		}
    53		go l.run()
    54		return l
    55	}
    56	
    57	// Path returns the configured log file path.
    58	func (l *Logger) Path() string {
    59		return l.path
    60	}
    61	
    62	// Log queues an entry for asynchronous writing. If the buffered channel is full,
    63	// the entry is written synchronously to avoid losing it.
    64	func (l *Logger) Log(entry Entry) {
    65		if atomic.LoadInt32(&l.stopped) != 0 {
    66			return
    67		}
    68		entry.Ts = time.Now().UTC().Format(time.RFC3339Nano)
    69		select {
    70		case l.ch <- entry:
    71		default:
    72			l.writeLine(entry)
    73		}
    74	}
    75	
    76	// Stop flushes all buffered entries and closes the log file.
    77	func (l *Logger) Stop() {
    78		l.stopOnce.Do(func() {
    79			atomic.StoreInt32(&l.stopped, 1)
    80			close(l.stop)
    81			<-l.done
    82			l.mu.Lock()
    83			if l.file != nil {
    84				l.file.Close()
    85				l.file = nil
    86			}
    87			l.mu.Unlock()
    88		})
    89	}
    90	
    91	func (l *Logger) run() {
    92		for {
    93			select {
    94			case e := <-l.ch:
    95				l.writeLine(e)
    96			case <-l.stop:
    97				l.drain()
    98				close(l.done)
    99				return
   100			}
   101		}
   102	}
   103	
   104	func (l *Logger) drain() {
   105		for {
   106			select {
   107			case e := <-l.ch:
   108				l.writeLine(e)
   109			default:
   110				return
   111			}
   112		}
   113	}
   114	
   115	func (l *Logger) writeLine(e Entry) {
   116		b, err := json.Marshal(e)
   117		if err != nil {
   118			return
   119		}
   120		b = append(b, '\n')
   121	
   122		l.mu.Lock()
   123		defer l.mu.Unlock()
   124	
   125		if l.file == nil {
   126			if err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {
   127				return
   128			}
   129			f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
   130			if err != nil {
   131				return
   132			}
   133			l.file = f
   134			if info, err := f.Stat(); err == nil {
   135				l.size = info.Size()
   136			}
   137		}
   138	
   139		if l.size > 0 && l.size+int64(len(b)) > maxFileSize {
   140			l.rotateLocked()
   141		}
   142	
   143		n, err := l.file.Write(b)
   144		if err != nil {
   145			l.size = 0
   146			if l.file != nil {
   147				l.file.Close()
   148				l.file = nil
   149			}
   150			return
   151		}
   152		l.size += int64(n)
   153	}
   154	
   155	func (l *Logger) rotateLocked() {
   156		if l.file != nil {
   157			l.file.Close()
   158			l.file = nil
   159		}
   160		os.Remove(l.path + ".1")
   161		if err := os.Rename(l.path, l.path+".1"); err != nil {
   162			f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
   163			if err == nil {
   164				l.file = f
   165				if info, err := f.Stat(); err == nil {
   166					l.size = info.Size()
   167				}
   168			}
   169			return
   170		}
   171		f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
   172		if err != nil {
   173			l.size = 0
   174			return
   175		}
   176		l.file = f
   177		l.size = 0
   178	}
