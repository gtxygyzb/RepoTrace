'''type WarmupEndpointView struct {
\tEndpoint        string `json:"endpoint"`
\tWarmingUp       bool   `json:"warming_up"`
\tWarmupRemainingMs int  `json:"warmup_remaining_ms"`
\tEffectiveWeight int    `json:"effective_weight"`
\tConfigWeight    int    `json:"config_weight"`
}

type WarmupStatusView struct {
\tService   string              `json:"service"`
\tEndpoints []WarmupEndpointView `json:"endpoints"`
}

func (s *State) WarmupStatusView(name string) (WarmupStatusView, bool) {
\tss := s.GetService(name)
\tif ss == nil {
\t\treturn WarmupStatusView{}, false
\t}
\tss.mu.Lock()
\tdefer ss.mu.Unlock()
\tout := WarmupStatusView{
\t\tService:   ss.Name,
\t\tEndpoints: make([]WarmupEndpointView, 0, len(ss.Endpoints)),
\t}
\tfor _, ep := range ss.Endpoints {
\t\tep.mu.Lock()
\t\tout.Endpoints = append(out.Endpoints, WarmupEndpointView{
\t\t\tEndpoint:        ep.Address,
\t\t\tWarmingUp:       ep.WarmupDurationMs > 0 && time.Now().Before(ep.warmupUntil),
\t\t\tWarmupRemainingMs: ep.warmupRemainingMsLocked(),
\t\t\tEffectiveWeight: ep.effectiveWeightLocked(),
\t\t\tConfigWeight:    ep.Weight,
\t\t})
\t\tep.mu.Unlock()
\t}
\treturn out, true
}

type StatsEndpointView struct {''')

