   202	func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {
   203		rawArgs, err := json.Marshal(args)
   204		if err != nil {
   205			return "", err
   206		}
   207		req := request{Cmd: ipcCmd, Args: rawArgs}
   208		reqBytes, err := json.Marshal(req)
   209		if err != nil {
   210			return "", err
   211		}
   212	
   213		conn, err := net.Dial("unix", "/tmp/meshd.sock")
   214		if err != nil {
   215			return "", fmt.Errorf("connect to meshd failed: %w", err)
   216		}
   217		defer conn.Close()
   218	
   219		fmt.Fprintf(conn, "%s\n", string(reqBytes))
   220	
   221		reader := bufio.NewReader(conn)
   222		line, err := reader.ReadString('\n')
   223		if err != nil {
   224			return "", err
   225		}
   226		line = strings.TrimRight(line, "\r\n")
   227	
   228		var resp response
   229		if err := json.Unmarshal([]byte(line), &resp); err != nil {
   230			return "", err
   231		}
   232		if resp.Status != "ok" {
   233			var msg string
   234			if err := json.Unmarshal(resp.Data, &msg); err == nil {
   235				return "", fmt.Errorf("%s", msg)
   236			}
   237			return "", fmt.Errorf("%s", string(resp.Data))
   238		}
   239		return prettyData(ipcCmd, resp.Data)
   240	}
