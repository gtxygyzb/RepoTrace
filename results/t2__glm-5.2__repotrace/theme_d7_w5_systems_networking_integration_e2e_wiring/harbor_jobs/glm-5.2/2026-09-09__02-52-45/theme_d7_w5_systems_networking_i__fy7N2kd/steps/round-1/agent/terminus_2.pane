   156	func (s *State) HealthLogView(name string, lastN int) []HealthEventView {
   157		events := s.HealthLog(name, lastN)
   158		out := make([]HealthEventView, 0, len(events))
   159		for _, e := range events {
   160			out = append(out, HealthEventView{
   161				Timestamp:   e.Timestamp,
   162				Endpoint:    e.Endpoint,
   163				OldState:    string(e.OldState),
   164				NewState:    string(e.NewState),
   165				CheckResult: e.CheckResult,
   166			})
   167		}
   168		return out
   169	}
   170	
   171	type CircuitView struct {
   172		Address             string `json:"address"`
   173		CircuitState        string `json:"circuit_state"`
   174		ConsecutiveFailures int    `json:"consecutive_failures"`
   175		TimeInStateMs       int64  `json:"time_in_state_ms"`
   176		ProbeActive         bool   `json:"probe_active"`
   177	}
   178	
   179	func (s *State) CircuitsView(name string) ([]CircuitView, bool) {
   180		ss := s.GetService(name)
   181		if ss == nil {
   182			return nil, false
   183		}
   184		ss.mu.Lock()
   185		out := make([]CircuitView, 0, len(ss.Endpoints))
   186		for _, ep := range ss.Endpoints {
   187			ep.mu.Lock()
   188			out = append(out, CircuitView{
   189				Address:             ep.Address,
   190				CircuitState:        string(ep.Circuit.State()),
   191				ConsecutiveFailures: ep.Circuit.ConsecutiveFailures(),
   192				TimeInStateMs:       ep.Circuit.TimeInStateMs(),
   193				ProbeActive:         ep.Circuit.ProbeActive(),
   194			})
   195			ep.mu.Unlock()
   196		}
   197		ss.mu.Unlock()
   198		return out, true
   199	}
