   216				regular = append(regular, ep)
   217			}
   218		}
   219	
   220		if len(regular) > 0 {
   221			if mode == "least-connections" {
   222				ep := selectLeastConnections(regular, maxConns)
   223				return ep.Address, nil
   224			}
   225			var best *EndpointState
   226			var bestWeight int
   227			for _, ep := range regular {
   228				ep.mu.Lock()
   229				cw := ep.currentWeight + ep.Weight
   230				ep.mu.Unlock()
