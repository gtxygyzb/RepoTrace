     2	
     3	import (
     4		"github.com/BurntSushi/toml"
     5	)
     6	
     7	// Global holds mesh-wide tuning parameters.
     8	type Global struct {
     9		HealthIntervalMs        int `toml:"health_interval_ms"`
    10		UnhealthyThreshold      int `toml:"unhealthy_threshold"`
    11		HealthyThreshold        int `toml:"healthy_threshold"`
    12		StatsWindowSec          int `toml:"stats_window_sec"`
    13		CircuitBreakerThreshold int `toml:"circuit_breaker_threshold"`
    14		CircuitBreakerTimeoutMs int `toml:"circuit_breaker_timeout_ms"`
    15	}
    16	
    17	// Endpoint describes one backend endpoint from config.
    18	type Endpoint struct {
    19		Address          string `toml:"address"`
    20		Weight           int    `toml:"weight"`
    21		WarmupDurationMs int    `toml:"warmup_duration_ms"`
    22		HealthCheck      string `toml:"health_check"`
    23		HealthPath       string `toml:"health_path"`
    24		HealthCmd        string `toml:"health_cmd"`
    25	}
    26	
    27	// Service describes one routed service from config.
    28	type Service struct {
    29		Name                      string     `toml:"name"`
    30		ListenPort                int        `toml:"listen_port"`
    31		RoutingMode               string     `toml:"routing_mode"`
    32		DrainTimeoutMs            int        `toml:"drain_timeout_ms"`
    33		MaxConnectionsPerEndpoint int        `toml:"max_connections_per_endpoint"`
    34		ConnectionLimitMode       string     `toml:"connection_limit_mode"`
    35		RateLimitRps              int        `toml:"rate_limit_rps"`
    36		RateLimitBurst            int        `toml:"rate_limit_burst"`
    37		RateLimitQueueDepth       int        `toml:"rate_limit_queue_depth"`
    38		RateLimitQueueTimeoutMs   int        `toml:"rate_limit_queue_timeout_ms"`
    39		MaxRetries                int        `toml:"max_retries"`
    40		RetryDelayMs              int        `toml:"retry_delay_ms"`
    41		RetryBackoffMultiplier    float64    `toml:"retry_backoff_multiplier"`
    42		RetryMaxDelayMs           int        `toml:"retry_max_delay_ms"`
    43		IdleTimeoutMs             int        `toml:"idle_timeout_ms"`
    44		Endpoints                 []Endpoint `toml:"endpoint"`
    45	}
    46	
    47	// Config is the parsed application configuration.
    48	type Config struct {
    49		Global   Global
    50		Services []Service `toml:"service"`
    51	}
    52	
    53	// Load reads and normalizes a TOML config file.
    54	func Load(path string) (*Config, error) {
    55		var cfg Config
    56		if _, err := toml.DecodeFile(path, &cfg); err != nil {
    57			return nil, err
    58		}
    59		if cfg.Global.HealthIntervalMs <= 0 {
    60			cfg.Global.HealthIntervalMs = 2000
    61		}
    62		if cfg.Global.UnhealthyThreshold <= 0 {
    63			cfg.Global.UnhealthyThreshold = 3
    64		}
    65		if cfg.Global.HealthyThreshold <= 0 {
    66			cfg.Global.HealthyThreshold = 2
    67		}
    68		if cfg.Global.StatsWindowSec <= 0 {
    69			cfg.Global.StatsWindowSec = 60
    70		}
    71		if cfg.Global.CircuitBreakerThreshold <= 0 {
    72			cfg.Global.CircuitBreakerThreshold = 3
    73		}
    74		if cfg.Global.CircuitBreakerTimeoutMs <= 0 {
    75			cfg.Global.CircuitBreakerTimeoutMs = 5000
    76		}
    77		for i := range cfg.Services {
    78			s := &cfg.Services[i]
    79			if s.RoutingMode == "" {
    80				s.RoutingMode = "weighted-round-robin"
    81			}
    82			if s.DrainTimeoutMs <= 0 {
    83				s.DrainTimeoutMs = 5000
    84			}
    85			if s.MaxConnectionsPerEndpoint <= 0 {
    86				s.MaxConnectionsPerEndpoint = 100
    87			}
    88			if s.ConnectionLimitMode == "" {
    89				s.ConnectionLimitMode = "per-endpoint"
    90			}
    91			if s.RateLimitBurst <= 0 {
    92				s.RateLimitBurst = s.RateLimitRps
    93			}
    94			if s.RateLimitQueueTimeoutMs <= 0 {
    95				s.RateLimitQueueTimeoutMs = 1000
    96			}
    97			if s.RetryDelayMs <= 0 {
    98				s.RetryDelayMs = 100
    99			}
   100			if s.RetryBackoffMultiplier <= 0 {
   101				s.RetryBackoffMultiplier = 2.0
   102			}
   103			if s.RetryMaxDelayMs <= 0 {
   104				s.RetryMaxDelayMs = 5000
   105			}
   106			for j := range s.Endpoints {
   107				ep := &s.Endpoints[j]
   108				if ep.HealthCheck == "" {
   109					ep.HealthCheck = "tcp"
   110				}
   111				if ep.Weight < 0 {
   112					ep.Weight = 0
   113				}
   114				if ep.WarmupDurationMs < 0 {
   115					ep.WarmupDurationMs = 0
   116				}
   117			}
   118		}
   119		return &cfg, nil
   120	}
