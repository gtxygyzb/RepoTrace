    47	func (s *Server) Start() error {
    48		os.Remove(s.path)
    49		ln, err := net.Listen("unix", s.path)
    50		if err != nil {
    51			return err
    52		}
    53		s.listener = ln
    54		go s.acceptLoop()
    55		return nil
    56	}
