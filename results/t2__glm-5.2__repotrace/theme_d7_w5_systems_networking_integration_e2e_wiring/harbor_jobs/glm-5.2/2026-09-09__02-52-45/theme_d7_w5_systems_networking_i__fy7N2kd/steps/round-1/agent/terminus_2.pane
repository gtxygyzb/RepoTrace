   105		case "rate-limit":
   106			if len(os.Args) < 3 {
   107				fmt.Fprintln(os.Stderr, "usage: meshctl rate-limit <service>")
   108				os.Exit(1)
   109			}
   110			ipcCmd = "get_rate_limit_status"
   111			args["name"] = os.Args[2]
   112		case "warmup":
   113			if len(os.Args) < 3 {
   114				fmt.Fprintln(os.Stderr, "usage: meshctl warmup <service>")
   115				os.Exit(1)
   116			}
   117			ipcCmd = "get_warmup_status"
   118			args["name"] = os.Args[2]
   119		case "connections":
   120			if len(os.Args) < 3 {
   121				fmt.Fprintln(os.Stderr, "usage: meshctl connections <service>")
   122				os.Exit(1)
   123			}
   124			ipcCmd = "get_connections"
   125			args["name"] = os.Args[2]
   126		case "set-rate-limit":
   127			if len(os.Args) < 5 {
   128				fmt.Fprintln(os.Stderr, "usage: meshctl set-rate-limit <service> <rps> <burst>")
   129				os.Exit(1)
   130			}
   131			rps, err := strconv.Atoi(os.Args[3])
   132			if err != nil {
   133				fmt.Fprintf(os.Stderr, "invalid rps: %v\n", err)
   134				os.Exit(1)
   135			}
   136			burst, err := strconv.Atoi(os.Args[4])
   137			if err != nil {
   138				fmt.Fprintf(os.Stderr, "invalid burst: %v\n", err)
   139				os.Exit(1)
   140			}
   141			ipcCmd = "set_rate_limit"
   142			args["name"] = os.Args[2]
   143			args["rps"] = rps
   144			args["burst"] = burst
   145		default:
   146			fmt.Fprintf(os.Stderr, "unknown command: %s\n", cliCmd)
   147			os.Exit(1)
   148		}
   149	
   150		data, err := sendCommand(ipcCmd, args)
   151		if err != nil {
   152			fmt.Fprintln(os.Stderr, err)
   153			os.Exit(1)
   154		}
   155		fmt.Println(data)
   156	}
