import (
	"net"
	"sort"
	"sync"
	"sync/atomic"
	"time"

	"meshrouter/internal/circuit"
	"meshrouter/internal/config"
	"meshrouter/internal/stats"
)

type HealthState string

const (
	Unknown   HealthState = "unknown"
	Healthy   HealthState = "healthy"
	Unhealthy HealthState = "unhealthy"
	Draining  HealthState = "draining"
)

type HealthEvent struct {
	Timestamp   time.Time
	Endpoint    string
	OldState    HealthState
	NewState    HealthState
	CheckResult string
}

type EndpointState struct {
	mu                sync.Mutex
	Address           string
	Weight            int
	Config            config.Endpoint
	State             HealthState
	ActiveConnections int
	Circuit           *circuit.Breaker
	Stats             *stats.Collector
	consecSuccess     int
	consecFailures    int
	drainDeadline     time.Time
	removed           bool
	connIDCounter     int64
	currentWeight     int
	WarmupDurationMs  int
	warmupUntil       time.Time
	connections       map[int64]*connectionInfo
}

type connectionInfo struct {
	conn         net.Conn
	clientAddr   string
	start        time.Time
	lastActivity time.Time
	bytesIn      int64
	bytesOut     int64
}

type ServiceState struct {
	mu                        sync.Mutex
	Name                      string
	ListenPort                int
	RoutingMode               string
	DrainTimeoutMs            int
	MaxConnectionsPerEndpoint int
	ConnectionLimitMode       string
	IdleTimeoutMs             int
	RateLimitRps              int
	RateLimitBurst            int
	RateLimitQueueDepth       int
	RateLimitQueueTimeoutMs   int
	MaxRetries                int
	RetryDelayMs              int
	RetryBackoffMultiplier    float64
	RetryMaxDelayMs           int
	rateLimiter               *rateLimiter
	Endpoints                 []*EndpointState
	rrIndex                   int
	Listener                  net.Listener
	listenerStop              chan struct{}
	stopping                  bool
}

type State struct {
	mu         sync.RWMutex
	configPath string
	global     config.Global
	services   map[string]*ServiceState
	logMu      sync.Mutex
	healthLog  map[string][]HealthEvent
	reloadCh   chan struct{}
}

func NewState(cfg *config.Config, path string) *State {
	s := &State{
		configPath: path,
		services:   make(map[string]*ServiceState),
		healthLog:  make(map[string][]HealthEvent),
		reloadCh:   make(chan struct{}, 1),
	}
	s.applyConfigLocked(cfg)
	return s
}

func (s *State) ReloadChan() <-chan struct{} {
	return s.reloadCh
}

func (s *State) ConfigPath() string {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return s.configPath
}

func (s *State) Global() config.Global {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return s.global
