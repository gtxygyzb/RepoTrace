[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // Stop flushes all buffered entries and closes the log file.
[?2004l[?2004h> func (l *Logger) Stop() {
[?2004l[?2004h>     l.stopOnce.Do(func() {
[?2004l[?2004h>         atomic.StoreInt32(&l.stopped, 1)
