   324	func (r *Router) sleepRetry(attempt, delayMs int, multiplier float64, maxDelayMs int) {
   325		if attempt < 0 {
   326			attempt = 0
   327		}
   328		delay := float64(delayMs) * pow(multiplier, float64(attempt))
   329		if maxDelayMs > 0 && delay > float64(maxDelayMs) {
   330			delay = float64(maxDelayMs)
   331		}
   332		if delay > 0 {
   333			time.Sleep(time.Duration(delay) * time.Millisecond)
   334		}
   335	}
   336	
   337	func pow(base, exp float64) float64 {
   338		result := 1.0
   339		for i := 0; i < int(exp); i++ {
   340			result *= base
   341		}
   342		return result
   343	}
