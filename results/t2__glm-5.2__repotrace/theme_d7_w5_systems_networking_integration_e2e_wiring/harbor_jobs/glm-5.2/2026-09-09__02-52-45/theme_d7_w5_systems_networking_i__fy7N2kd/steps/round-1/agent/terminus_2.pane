   113		for _, e := range events {
   114			out = append(out, HealthEventView{
   115				Timestamp:   e.Timestamp,
   116				Endpoint:    e.Endpoint,
   117				OldState:    string(e.OldState),
   118				NewState:    string(e.NewState),
   119				CheckResult: e.CheckResult,
   120			})
   121		}
   122		return out
   123	}
   124	
   125	type CircuitView struct {
   126		Address             string `json:"address"`
   127		CircuitState        string `json:"circuit_state"`
   128		ConsecutiveFailures int    `json:"consecutive_failures"`
   129		TimeInStateMs       int64  `json:"time_in_state_ms"`
   130		ProbeActive         bool   `json:"probe_active"`
   131	}
   132	
   133	func (s *State) CircuitsView(name string) ([]CircuitView, bool) {
   134		ss := s.GetService(name)
   135		if ss == nil {
   136			return nil, false
   137		}
   138		ss.mu.Lock()
   139		out := make([]CircuitView, 0, len(ss.Endpoints))
   140		for _, ep := range ss.Endpoints {
   141			ep.mu.Lock()
   142			out = append(out, CircuitView{
   143				Address:             ep.Address,
   144				CircuitState:        string(ep.Circuit.State()),
   145				ConsecutiveFailures: ep.Circuit.ConsecutiveFailures(),
   146				TimeInStateMs:       ep.Circuit.TimeInStateMs(),
   147				ProbeActive:         ep.Circuit.ProbeActive(),
   148			})
   149			ep.mu.Unlock()
   150		}
   151		ss.mu.Unlock()
   152		return out, true
   153	}
   154	
   155	func (s *State) ResolveEndpoint(service string) (string, error) {
   156		ss := s.GetService(service)
   157		if ss == nil {
   158			return "", errNotFound("service not found")
   159		}
   160		ss.mu.Lock()
   161		maxConns := ss.MaxConnectionsPerEndpoint
   162		mode := ss.RoutingMode
   163		endpoints := make([]*EndpointState, len(ss.Endpoints))
   164		copy(endpoints, ss.Endpoints)
   165		ss.mu.Unlock()
   166	
   167		var regular []*EndpointState
   168		for _, ep := range endpoints {
   169			if ep.IsEligible(maxConns) {
   170				regular = append(regular, ep)
   171			}
   172		}
   173	
   174		if len(regular) > 0 {
   175			if mode == "least-connections" {
   176				ep := selectLeastConnections(regular, maxConns)
   177				return ep.Address, nil
   178			}
   179			var best *EndpointState
   180			var bestWeight int
   181			for _, ep := range regular {
   182				ep.mu.Lock()
   183				cw := ep.currentWeight + ep.Weight
   184				ep.mu.Unlock()
   185				if best == nil || cw > bestWeight {
   186					best = ep
   187					bestWeight = cw
   188				}
   189			}
   190			if best != nil {
   191				return best.Address, nil
   192			}
   193		}
   194	
   195		for _, ep := range endpoints {
   196			ep.mu.Lock()
   197			halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns && !ep.Circuit.ProbeActive()
   198			ep.mu.Unlock()
   199			if halfOpen {
   200				return ep.Address, nil
   201			}
   202		}
   203		return "", errNotFound("no eligible endpoints")
   204	}
