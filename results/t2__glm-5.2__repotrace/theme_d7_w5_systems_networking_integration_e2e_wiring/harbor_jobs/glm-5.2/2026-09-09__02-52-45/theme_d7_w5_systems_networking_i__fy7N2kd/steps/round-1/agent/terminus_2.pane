    26	func (s *State) ServiceView(name string) (ServiceView, bool) {
    27		ss := s.GetService(name)
    28		if ss == nil {
    29			return ServiceView{}, false
    30		}
    31		return ss.View(), true
    32	}
    33	
    34	func (s *State) ServicesView() []ServiceView {
    35		services := s.Services()
    36		out := make([]ServiceView, 0, len(services))
    37		for _, ss := range services {
    38			out = append(out, ss.View())
    39		}
    40		sort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })
    41		return out
    42	}
    43	
    44	func (ss *ServiceState) View() ServiceView {
    45		ss.mu.Lock()
    46		defer ss.mu.Unlock()
    47		sv := ServiceView{
    48			Name:          ss.Name,
    49			ListenPort:    ss.ListenPort,
    50			RoutingMode:   ss.RoutingMode,
    51			IdleTimeoutMs: ss.IdleTimeoutMs,
    52			Endpoints:     make([]EndpointView, 0, len(ss.Endpoints)),
    53		}
    54		for _, ep := range ss.Endpoints {
    55			ep.mu.Lock()
    56			sv.Endpoints = append(sv.Endpoints, EndpointView{
    57				Address:           ep.Address,
    58				State:             string(ep.State),
    59				Weight:            ep.Weight,
    60				ActiveConnections: ep.ActiveConnections,
    61				CircuitState:      string(ep.Circuit.State()),
    62			})
    63			ep.mu.Unlock()
    64		}
    65		return sv
    66	}
    67	
    68	type StatsEndpointView struct {
    69		Address string `json:"address"`
    70		stats.Snapshot
    71	}
    72	
    73	type StatsView struct {
    74		Service   string              `json:"service"`
    75		WindowSec int                 `json:"window_sec"`
    76		Endpoints []StatsEndpointView `json:"endpoints"`
    77	}
    78	
    79	func (s *State) StatsView(name string, windowSec int) (StatsView, bool) {
    80		ss := s.GetService(name)
    81		if ss == nil {
    82			return StatsView{}, false
    83		}
    84		sv := StatsView{
    85			Service:   name,
    86			WindowSec: windowSec,
    87			Endpoints: make([]StatsEndpointView, 0),
    88		}
    89		ss.mu.Lock()
    90		for _, ep := range ss.Endpoints {
    91			ep.mu.Lock()
    92			sv.Endpoints = append(sv.Endpoints, StatsEndpointView{
    93				Address:  ep.Address,
    94				Snapshot: ep.Stats.Snapshot(ep.ActiveConnections),
    95			})
    96			ep.mu.Unlock()
    97		}
    98		ss.mu.Unlock()
    99		return sv, true
   100	}
