   172	func newServiceState(svc config.Service, global config.Global) *ServiceState {
   173		ss := &ServiceState{
   174			Name:                      svc.Name,
   175			ListenPort:                svc.ListenPort,
   176			RoutingMode:               svc.RoutingMode,
   177			DrainTimeoutMs:            svc.DrainTimeoutMs,
   178			RateLimitRps:              svc.RateLimitRps,
   179			RateLimitBurst:            svc.RateLimitBurst,
   180			RateLimitQueueDepth:       svc.RateLimitQueueDepth,
   181			RateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,
   182			MaxRetries:                svc.MaxRetries,
   183			RetryDelayMs:              svc.RetryDelayMs,
   184			RetryBackoffMultiplier:    svc.RetryBackoffMultiplier,
   185			RetryMaxDelayMs:           svc.RetryMaxDelayMs,
   186			rateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),
   187			MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
   188			listenerStop:              nil,
   189		}
   190		for _, ep := range svc.Endpoints {
   191			ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))
   192		}
   193		return ss
   194	}
   195	
   196	func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {
   197		ss.mu.Lock()
   198		defer ss.mu.Unlock()
   199		seen := make(map[string]bool)
   200		for _, cep := range eps {
   201			seen[cep.Address] = true
   202			var ep *EndpointState
   203			for _, existing := range ss.Endpoints {
   204				if existing.Address == cep.Address {
   205					ep = existing
   206					break
   207				}
   208			}
   209			if ep == nil {
   210				ep = newEndpointState(cep, global)
   211				ss.Endpoints = append(ss.Endpoints, ep)
   212			} else {
   213				ep.mu.Lock()
   214				ep.Config = cep
   215				ep.Weight = cep.Weight
   216				ep.mu.Unlock()
   217			}
   218		}
   219		for _, ep := range ss.Endpoints {
   220			if !seen[ep.Address] {
   221				ep.StartDraining(ss.DrainTimeoutMs, true)
   222			}
   223		}
   224	}
