[?2004lpackage config

import (
	"github.com/BurntSushi/toml"
)

// Global holds mesh-wide tuning parameters.
type Global struct {
	HealthIntervalMs        int `toml:"health_interval_ms"`
	UnhealthyThreshold      int `toml:"unhealthy_threshold"`
	HealthyThreshold        int `toml:"healthy_threshold"`
	StatsWindowSec          int `toml:"stats_window_sec"`
	CircuitBreakerThreshold int `toml:"circuit_breaker_threshold"`
	CircuitBreakerTimeoutMs int `toml:"circuit_breaker_timeout_ms"`
}

// Endpoint describes one backend endpoint from config.
type Endpoint struct {
	Address     string `toml:"address"`
	Weight      int    `toml:"weight"`
	HealthCheck string `toml:"health_check"`
	HealthPath  string `toml:"health_path"`
	HealthCmd   string `toml:"health_cmd"`
}

// Service describes one routed service from config.
type Service struct {
	Name                      string     `toml:"name"`
	ListenPort                int        `toml:"listen_port"`
	RoutingMode               string     `toml:"routing_mode"`
	DrainTimeoutMs            int        `toml:"drain_timeout_ms"`
	MaxConnectionsPerEndpoint int        `toml:"max_connections_per_endpoint"`
	Endpoints                 []Endpoint `toml:"endpoint"`
}

// Config is the parsed application configuration.
type Config struct {
	Global   Global
	Services []Service `toml:"service"`
}

// Load reads and normalizes a TOML config file.
func Load(path string) (*Config, error) {
	var cfg Config
	if _, err := toml.DecodeFile(path, &cfg); err != nil {
		return nil, err
	}
	if cfg.Global.HealthIntervalMs <= 0 {
		cfg.Global.HealthIntervalMs = 2000
	}
	if cfg.Global.UnhealthyThreshold <= 0 {
		cfg.Global.UnhealthyThreshold = 3
	}
	if cfg.Global.HealthyThreshold <= 0 {
		cfg.Global.HealthyThreshold = 2
	}
	if cfg.Global.StatsWindowSec <= 0 {
		cfg.Global.StatsWindowSec = 60
	}
	if cfg.Global.CircuitBreakerThreshold <= 0 {
		cfg.Global.CircuitBreakerThreshold = 3
	}
	if cfg.Global.CircuitBreakerTimeoutMs <= 0 {
		cfg.Global.CircuitBreakerTimeoutMs = 5000
	}
	for i := range cfg.Services {
		s := &cfg.Services[i]
		if s.RoutingMode == "" {
			s.RoutingMode = "weighted-round-robin"
		}
		if s.DrainTimeoutMs <= 0 {
			s.DrainTimeoutMs = 5000
		}
		if s.MaxConnectionsPerEndpoint <= 0 {
			s.MaxConnectionsPerEndpoint = 100
		}
		for j := range s.Endpoints {
			ep := &s.Endpoints[j]
			if ep.HealthCheck == "" {
				ep.HealthCheck = "tcp"
			}
			if ep.Weight < 0 {
				ep.Weight = 0
			}
		}
	}
	return &cfg, nil
}
[?2004hroot@n30009:/app# sed -n '1,260p' internal/state/state.go
[?2004lpackage state

import (
	"net"
	"sync"
	"sync/atomic"
	"time"

	"meshrouter/internal/circuit"
	"meshrouter/internal/config"
	"meshrouter/internal/stats"
)

type HealthState string

const (
	Unknown   HealthState = "unknown"
	Healthy   HealthState = "healthy"
	Unhealthy HealthState = "unhealthy"
	Draining  HealthState = "draining"
)

type HealthEvent struct {
	Timestamp   time.Time
	Endpoint    string
	OldState    HealthState
	NewState    HealthState
	CheckResult string
}

type EndpointState struct {
	mu                sync.Mutex
	Address           string
	Weight            int
	Config            config.Endpoint
	State             HealthState
	ActiveConnections int
	Circuit           *circuit.Breaker
	Stats             *stats.Collector
	consecSuccess     int
	consecFailures    int
	drainDeadline     time.Time
	removed           bool
	connIDCounter     int64
	currentWeight     int
	connections       map[int64]net.Conn
}

type ServiceState struct {
	mu                        sync.Mutex
	Name                      string
	ListenPort                int
	RoutingMode               string
	DrainTimeoutMs            int
	MaxConnectionsPerEndpoint int
	Endpoints                 []*EndpointState
	rrIndex                   int
	Listener                  net.Listener
	listenerStop              chan struct{}
	stopping                  bool
}

type State struct {
	mu         sync.RWMutex
	configPath string
	global     config.Global
	services   map[string]*ServiceState
	logMu      sync.Mutex
	healthLog  map[string][]HealthEvent
	reloadCh   chan struct{}
}

func NewState(cfg *config.Config, path string) *State {
	s := &State{
		configPath: path,
		services:   make(map[string]*ServiceState),
		healthLog:  make(map[string][]HealthEvent),
		reloadCh:   make(chan struct{}, 1),
	}
	s.applyConfigLocked(cfg)
	return s
}

func (s *State) ReloadChan() <-chan struct{} {
	return s.reloadCh
}

func (s *State) ConfigPath() string {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return s.configPath
}

func (s *State) Global() config.Global {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return s.global
}

func (s *State) ApplyConfig(cfg *config.Config) {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.applyConfigLocked(cfg)
	select {
	case s.reloadCh <- struct{}{}:
	default:
	}
}

func (s *State) applyConfigLocked(cfg *config.Config) {
	s.global = cfg.Global
	seen := make(map[string]bool)
	for _, svc := range cfg.Services {
		seen[svc.Name] = true
		ss := s.services[svc.Name]
		if ss == nil {
			ss = newServiceState(svc, cfg.Global)
			s.services[svc.Name] = ss
		} else {
			ss.mu.Lock()
			ss.Name = svc.Name
			ss.ListenPort = svc.ListenPort
			ss.RoutingMode = svc.RoutingMode
			ss.DrainTimeoutMs = svc.DrainTimeoutMs
			ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint
			ss.mu.Unlock()
			ss.applyEndpoints(svc.Endpoints, cfg.Global)
		}
	}
	for name, ss := range s.services {
		if !seen[name] {
			ss.mu.Lock()
			ss.stopping = true
			if ss.listenerStop != nil {
				close(ss.listenerStop)
				ss.listenerStop = nil
			}
			if ss.Listener != nil {
				ss.Listener.Close()
				ss.Listener = nil
			}
			ss.mu.Unlock()
			for _, ep := range ss.Endpoints {
				ep.StartDraining(ss.DrainTimeoutMs, true)
			}
		}
	}
}

func newServiceState(svc config.Service, global config.Global) *ServiceState {
	ss := &ServiceState{
		Name:                      svc.Name,
		ListenPort:                svc.ListenPort,
		RoutingMode:               svc.RoutingMode,
		DrainTimeoutMs:            svc.DrainTimeoutMs,
		MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
		listenerStop:              nil,
	}
	for _, ep := range svc.Endpoints {
		ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))
	}
	return ss
}

func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {
	ss.mu.Lock()
	defer ss.mu.Unlock()
	seen := make(map[string]bool)
	for _, cep := range eps {
		seen[cep.Address] = true
		var ep *EndpointState
		for _, existing := range ss.Endpoints {
			if existing.Address == cep.Address {
				ep = existing
				break
			}
		}
		if ep == nil {
			ep = newEndpointState(cep, global)
			ss.Endpoints = append(ss.Endpoints, ep)
		} else {
			ep.mu.Lock()
			ep.Config = cep
			ep.Weight = cep.Weight
			ep.mu.Unlock()
		}
	}
	for _, ep := range ss.Endpoints {
		if !seen[ep.Address] {
			ep.StartDraining(ss.DrainTimeoutMs, true)
		}
	}
}

func newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {
	return &EndpointState{
		Address:     cep.Address,
		Weight:      cep.Weight,
		Config:      cep,
		State:       Unknown,
		Circuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),
		Stats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),
		connections: make(map[int64]net.Conn),
	}
}

func (s *State) GetService(name string) *ServiceState {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return s.services[name]
}

func (s *State) Services() []*ServiceState {
	s.mu.RLock()
	defer s.mu.RUnlock()
	out := make([]*ServiceState, 0, len(s.services))
	for _, ss := range s.services {
		out = append(out, ss)
	}
	return out
}

func (s *State) GetEndpoint(service, address string) *EndpointState {
	ss := s.GetService(service)
	if ss == nil {
		return nil
	}
	ss.mu.Lock()
	defer ss.mu.Unlock()
	for _, ep := range ss.Endpoints {
		if ep.Address == address {
			return ep
		}
	}
	return nil
}

func (s *State) SetWeight(service, address string, weight int) error {
	ep := s.GetEndpoint(service, address)
	if ep == nil {
		return errNotFound("endpoint not found")
	}
	ep.mu.Lock()
	defer ep.mu.Unlock()
	if weight < 0 {
		weight = 0
	}
	ep.Weight = weight
	return nil
}

func (s *State) DrainEndpoint(service, address string) error {
	ss := s.GetService(service)
	if ss == nil {
		return errNotFound("service not found")
	}
	ep := s.GetEndpoint(service, address)
	if ep == nil {
		return errNotFound("endpoint not found")
	}
[?2004hroot@n30009:/app# sed -n '1,240p' internal/state/routing.go
[?2004lpackage state

import (
	"sort"
	"time"
)

// SelectResult contains selected endpoint and whether it is a half-open probe.
type SelectResult struct {
	Endpoint *EndpointState
	Probe    bool
	MaxConns int
}

// SelectEndpoint chooses an endpoint for the next connection.
func (s *State) SelectEndpoint(service string) (SelectResult, error) {
	ss := s.GetService(service)
	if ss == nil {
		return SelectResult{}, errNotFound("service not found")
	}
	ss.mu.Lock()
	maxConns := ss.MaxConnectionsPerEndpoint
	mode := ss.RoutingMode
	endpoints := make([]*EndpointState, len(ss.Endpoints))
	copy(endpoints, ss.Endpoints)
	ss.mu.Unlock()

	now := time.Now()
	_ = now

	var regular []*EndpointState
	for _, ep := range endpoints {
		ep.mu.Lock()
		eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
		ep.mu.Unlock()
		if eligible {
			regular = append(regular, ep)
		}
	}

	if len(regular) > 0 {
		if mode == "least-connections" {
			return SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil
		}
		return SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil
	}

	for _, ep := range endpoints {
		ep.mu.Lock()
		halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
		ep.mu.Unlock()
		if halfOpen && ep.Circuit.AcquireProbe() {
			return SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil
		}
	}
	return SelectResult{}, errNotFound("no eligible endpoints")
}

// SelectCandidate returns the endpoint that would be selected ignoring connection limits.
// Used to account rejected_connections when all eligible endpoints are at capacity.
func (s *State) SelectCandidate(service string) (*EndpointState, error) {
	ss := s.GetService(service)
	if ss == nil {
		return nil, errNotFound("service not found")
	}
	ss.mu.Lock()
	mode := ss.RoutingMode
	endpoints := make([]*EndpointState, len(ss.Endpoints))
	copy(endpoints, ss.Endpoints)
	ss.mu.Unlock()

	var regular []*EndpointState
	for _, ep := range endpoints {
		ep.mu.Lock()
		eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining
		ep.mu.Unlock()
		if eligible {
			regular = append(regular, ep)
		}
	}
	if len(regular) == 0 {
		for _, ep := range endpoints {
			ep.mu.Lock()
			halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining
			ep.mu.Unlock()
			if halfOpen {
				return ep, nil
			}
		}
		return nil, errNotFound("no eligible endpoints")
	}
	if mode == "least-connections" {
		return selectLeastConnections(regular, 1<<30), nil
	}
	return selectWeightedCandidate(regular), nil
}

func selectWeighted(eps []*EndpointState) *EndpointState {
	var best *EndpointState
	var bestWeight int
	var totalWeight int
	for _, ep := range eps {
		ep.mu.Lock()
		ep.currentWeight += ep.Weight
		totalWeight += ep.Weight
		cw := ep.currentWeight
		ep.mu.Unlock()
		if best == nil || cw > bestWeight {
			best = ep
			bestWeight = cw
		}
	}
	if best != nil {
		best.mu.Lock()
		best.currentWeight -= totalWeight
		best.mu.Unlock()
	}
	return best
}

func selectWeightedCandidate(eps []*EndpointState) *EndpointState {
	var best *EndpointState
	var bestWeight int
	for _, ep := range eps {
		ep.mu.Lock()
		cw := ep.currentWeight + ep.Weight
		ep.mu.Unlock()
		if best == nil || cw > bestWeight {
			best = ep
			bestWeight = cw
		}
	}
	return best
}

func selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {
	sort.SliceStable(eps, func(i, j int) bool {
		ai := eps[i].Active()
		aj := eps[j].Active()
		if ai != aj {
			return ai < aj
		}
		return eps[i].Address < eps[j].Address
	})
	return eps[0]
}
[?2004hroot@n30009:/app# sed -n '1,260p' internal/stats/stats.go
[?2004lpackage stats

import (
	"sync"
	"time"
)

type entry struct {
	timestamp time.Time
	bytesIn   int64
	bytesOut  int64
	latency   time.Duration
	err       bool
}

// Collector keeps rolling connection statistics for one endpoint.
type Collector struct {
	mu         sync.Mutex
	window     time.Duration
	entries    []entry
	rejections []time.Time
}

// New creates a collector with the given window length.
func New(window time.Duration) *Collector {
	if window <= 0 {
		window = time.Minute
	}
	return &Collector{window: window}
}

// RecordConnection records a finished connection attempt.
func (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {
	c.mu.Lock()
	defer c.mu.Unlock()
	now := time.Now()
	c.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})
	c.trim(now)
}

// RecordRejection records a rejected connection because the endpoint was at capacity.
func (c *Collector) RecordRejection() {
	c.mu.Lock()
	defer c.mu.Unlock()
	now := time.Now()
	c.rejections = append(c.rejections, now)
	c.trim(now)
}

func (c *Collector) trim(now time.Time) {
	cutoff := now.Add(-c.window)
	i := 0
	for i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {
		i++
	}
	if i > 0 {
		c.entries = c.entries[i:]
	}
	j := 0
	for j < len(c.rejections) && c.rejections[j].Before(cutoff) {
		j++
	}
	if j > 0 {
		c.rejections = c.rejections[j:]
	}
}

// Snapshot returns current windowed stats. active is supplied by the state manager.
func (c *Collector) Snapshot(active int) Snapshot {
	c.mu.Lock()
	defer c.mu.Unlock()
	now := time.Now()
	cutoff := now.Add(-c.window)
	var total int
	var bytesIn, bytesOut int64
	var latencySum time.Duration
	var errors int
	for _, e := range c.entries {
		if e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {
			total++
			bytesIn += e.bytesIn
			bytesOut += e.bytesOut
			latencySum += e.latency
			if e.err {
				errors++
			}
		}
	}
	rejected := 0
	for _, t := range c.rejections {
		if t.After(cutoff) || t.Equal(cutoff) {
			rejected++
		}
	}
	var avg float64
	if total > 0 {
		avg = float64(latencySum.Milliseconds()) / float64(total)
	}
	return Snapshot{
		TotalConnections:    total,
		ActiveConnections:   active,
		BytesIn:             bytesIn,
		BytesOut:            bytesOut,
		AvgLatencyMs:        avg,
		Errors:              errors,
		RejectedConnections: rejected,
	}
}

// Snapshot is a JSON-friendly stats view.
type Snapshot struct {
	TotalConnections    int     `json:"total_connections"`
	ActiveConnections   int     `json:"active_connections"`
	BytesIn             int64   `json:"bytes_in"`
	BytesOut            int64   `json:"bytes_out"`
	AvgLatencyMs        float64 `json:"avg_latency_ms"`
	Errors              int     `json:"errors"`
	RejectedConnections int     `json:"rejected_connections"`
}
