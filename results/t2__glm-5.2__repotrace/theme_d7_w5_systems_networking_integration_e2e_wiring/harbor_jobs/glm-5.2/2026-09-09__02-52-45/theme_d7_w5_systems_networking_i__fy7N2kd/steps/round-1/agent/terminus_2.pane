// Stop flushes all buffered entries and closes the log file.
func (l *Logger) Stop() {
	l.stopOnce.Do(func() {
		atomic.StoreInt32(&l.stopped, 1)
		close(l.stop)
		<-l.done
		l.mu.Lock()
		if l.file != nil {
			l.file.Close()
			l.file = nil
		}
		l.mu.Unlock()
	})
}

