   101		var req Request
   102		if err := json.Unmarshal([]byte(line), &req); err != nil {
   103			return encodeResp(Response{Status: "error", Data: err.Error()})
   104		}
   105		data, err := s.dispatch(req)
   106		if err != nil {
   107			return encodeResp(Response{Status: "error", Data: err.Error()})
   108		}
   109		return encodeResp(Response{Status: "ok", Data: data})
   110	}
   111	
   112	func encodeResp(r Response) string {
