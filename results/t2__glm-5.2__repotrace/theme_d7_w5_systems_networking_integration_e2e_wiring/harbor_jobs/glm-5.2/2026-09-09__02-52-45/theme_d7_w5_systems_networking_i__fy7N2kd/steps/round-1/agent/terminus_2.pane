   175		RateLimited         int     `json:"rate_limited"`
   176		Queued              int     `json:"queued"`
   177		QueueTimeouts       int     `json:"queue_timeouts"`
   178		Retries             int     `json:"retries"`
   179		RetrySuccesses      int     `json:"retry_successes"`
   180		IdleTimeouts        int     `json:"idle_timeouts"`
