    15	
    16	// SelectEndpoint chooses an endpoint for the next connection.
    17	func (s *State) SelectEndpoint(service string) (SelectResult, error) {
    18		return s.selectEndpointExcluding(service, nil)
    19	}
    20	
    21	// SelectCandidate returns the endpoint that would be selected ignoring connection limits.
    22	// Used to account rejected_connections when all eligible endpoints are at capacity.
    23	func (s *State) SelectCandidate(service string) (*EndpointState, error) {
    24		ss := s.GetService(service)
    25		if ss == nil {
    26			return nil, errNotFound("service not found")
    27		}
    28		ss.mu.Lock()
    29		mode := ss.RoutingMode
    30		endpoints := make([]*EndpointState, len(ss.Endpoints))
    31		copy(endpoints, ss.Endpoints)
    32		ss.mu.Unlock()
    33	
    34		var regular []*EndpointState
    35		for _, ep := range endpoints {
    36			ep.mu.Lock()
    37			eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining
    38			ep.mu.Unlock()
    39			if eligible {
    40				regular = append(regular, ep)
    41			}
    42		}
    43		if len(regular) == 0 {
    44			for _, ep := range endpoints {
    45				ep.mu.Lock()
    46				halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining
    47				ep.mu.Unlock()
    48				if halfOpen {
    49					return ep, nil
    50				}
    51			}
    52			return nil, errNotFound("no eligible endpoints")
    53		}
    54		if mode == "least-connections" {
    55			return selectLeastConnections(regular, 1<<30), nil
    56		}
    57		return selectWeightedCandidate(regular), nil
    58	}
    59	
    60	func selectWeighted(eps []*EndpointState) *EndpointState {
    61		var best *EndpointState
    62		var bestWeight int
    63		var totalWeight int
    64		for _, ep := range eps {
    65			ep.mu.Lock()
    66			w := ep.effectiveWeightLocked()
    67			ep.currentWeight += w
    68			totalWeight += w
    69			cw := ep.currentWeight
    70			ep.mu.Unlock()
    71			if best == nil || cw > bestWeight {
    72				best = ep
    73				bestWeight = cw
    74			}
    75		}
    76		if best != nil {
    77			best.mu.Lock()
    78			best.currentWeight -= totalWeight
    79			best.mu.Unlock()
    80		}
