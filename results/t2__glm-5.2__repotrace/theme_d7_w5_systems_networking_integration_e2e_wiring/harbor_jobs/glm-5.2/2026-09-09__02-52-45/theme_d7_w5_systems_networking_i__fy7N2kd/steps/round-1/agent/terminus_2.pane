[?2004l     1	package ipc
     2	
     3	import (
     4		"bufio"
     5		"encoding/json"
     6		"errors"
     7		"fmt"
     8		"net"
     9		"os"
    10		"strconv"
    11		"strings"
    12		"sync"
    13	
    14		"meshrouter/internal/accesslog"
    15		"meshrouter/internal/config"
    16		"meshrouter/internal/state"
    17	)
    18	
    19	type Request struct {
    20		Cmd  string          `json:"cmd"`
    21		Args json.RawMessage `json:"args"`
    22	}
    23	
    24	type Response struct {
    25		Status string      `json:"status"`
    26		Data   interface{} `json:"data"`
    27	}
    28	
    29	type Server struct {
    30		state    *state.State
    31		path     string
    32		listener net.Listener
    33		wg       sync.WaitGroup
    34		stop     chan struct{}
    35		done     chan struct{}
    36	}
    37	
    38	func NewServer(s *state.State, path string) *Server {
    39		return &Server{
    40			state: s,
    41			path:  path,
    42			stop:  make(chan struct{}),
    43			done:  make(chan struct{}),
    44		}
    45	}
    46	
    47	func (s *Server) Start() error {
    48		os.Remove(s.path)
    49		ln, err := net.Listen("unix", s.path)
    50		if err != nil {
    51			return err
    52		}
    53		s.listener = ln
    54		go s.acceptLoop()
    55		return nil
    56	}
    57	
    58	func (s *Server) Stop() {
    59		select {
    60		case <-s.stop:
    61		default:
    62			close(s.stop)
    63		}
    64		if s.listener != nil {
    65			s.listener.Close()
    66		}
    67		<-s.done
    68		os.Remove(s.path)
    69	}
    70	
    71	func (s *Server) acceptLoop() {
    72		defer close(s.done)
    73		for {
    74			conn, err := s.listener.Accept()
    75			if err != nil {
    76				return
    77			}
    78			s.wg.Add(1)
    79			go s.handleConn(conn)
    80		}
    81	}
    82	
    83	func (s *Server) handleConn(conn net.Conn) {
    84		defer s.wg.Done()
    85		defer conn.Close()
    86		reader := bufio.NewReader(conn)
    87		for {
    88			line, err := reader.ReadString('\n')
    89			if err != nil {
    90				return
    91			}
    92			line = strings.TrimRight(line, "\r\n")
    93			if line == "" {
    94				continue
    95			}
    96			resp := s.handleLine(line)
    97			_, _ = conn.Write([]byte(resp + "\n"))
    98		}
    99	}
   100	
   101	func (s *Server) handleLine(line string) string {
   102		var req Request
   103		if err := json.Unmarshal([]byte(line), &req); err != nil {
   104			return encodeResp(Response{Status: "error", Data: err.Error()})
   105		}
   106		data, err := s.dispatch(req)
   107		if err != nil {
   108			return encodeResp(Response{Status: "error", Data: err.Error()})
   109		}
   110		return encodeResp(Response{Status: "ok", Data: data})
   111	}
   112	
   113	func encodeResp(r Response) string {
   114		b, _ := json.Marshal(r)
   115		return string(b)
   116	}
   117	
   118	func (s *Server) dispatch(req Request) (interface{}, error) {
   119		switch req.Cmd {
   120		case "list_services":
   121			return s.state.ServicesView(), nil
   122		case "get_service":
   123			var args struct {
   124				Name string `json:"name"`
   125			}
   126			if err := json.Unmarshal(req.Args, &args); err != nil {
   127				return nil, err
   128			}
   129			sv, ok := s.state.ServiceView(args.Name)
   130			if !ok {
   131				return nil, errors.New("service not found")
   132			}
   133			return sv, nil
   134		case "get_warmup_status":
   135			var args struct {
   136				Name string `json:"name"`
   137			}
   138			if err := json.Unmarshal(req.Args, &args); err != nil {
   139				return nil, err
   140			}
   141			sv, ok := s.state.WarmupStatusView(args.Name)
   142			if !ok {
   143				return nil, errors.New("service not found")
   144			}
   145			return sv, nil
   146		case "get_stats":
   147			var args struct {
   148				Name string `json:"name"`
   149			}
   150			if err := json.Unmarshal(req.Args, &args); err != nil {
   151				return nil, err
   152			}
   153			g := s.state.Global()
   154			sv, ok := s.state.StatsView(args.Name, g.StatsWindowSec)
   155			if !ok {
   156				return nil, errors.New("service not found")
   157			}
   158			return sv, nil
   159		case "set_weight":
   160			var args struct {
   161				Name    string `json:"name"`
   162				Address string `json:"address"`
   163				Weight  int    `json:"weight"`
   164			}
   165			if err := json.Unmarshal(req.Args, &args); err != nil {
   166				return nil, err
   167			}
   168			if err := s.state.SetWeight(args.Name, args.Address, args.Weight); err != nil {
   169				return nil, err
   170			}
   171			return "OK", nil
   172		case "drain_endpoint":
   173			var args struct {
   174				Name    string `json:"name"`
   175				Address string `json:"address"`
   176			}
   177			if err := json.Unmarshal(req.Args, &args); err != nil {
   178				return nil, err
   179			}
   180			if err := s.state.DrainEndpoint(args.Name, args.Address); err != nil {
   181				return nil, err
   182			}
   183			return "OK", nil
   184		case "get_health_log":
   185			var args struct {
   186				Name  string `json:"name"`
   187				LastN int    `json:"last_n"`
   188			}
   189			if err := json.Unmarshal(req.Args, &args); err != nil {
   190				return nil, err
   191			}
   192			return s.state.HealthLogView(args.Name, args.LastN), nil
   193		case "get_circuit_breakers":
   194			var args struct {
   195				Name string `json:"name"`
   196			}
   197			if err := json.Unmarshal(req.Args, &args); err != nil {
   198				return nil, err
   199			}
   200			cv, ok := s.state.CircuitsView(args.Name)
   201			if !ok {
   202				return nil, errors.New("service not found")
   203			}
   204			return cv, nil
   205		case "reset_circuit_breaker":
   206			var args struct {
   207				Name    string `json:"name"`
   208				Address string `json:"address"`
   209			}
   210			if err := json.Unmarshal(req.Args, &args); err != nil {
   211				return nil, err
   212			}
   213			if err := s.state.ResetCircuitBreaker(args.Name, args.Address); err != nil {
   214				return nil, err
   215			}
   216			return "OK", nil
   217		case "resolve":
   218			var args struct {
   219				Name string `json:"name"`
   220			}
   221			if err := json.Unmarshal(req.Args, &args); err != nil {
   222				return nil, err
   223			}
   224			addr, err := s.state.ResolveEndpoint(args.Name)
   225			if err != nil {
   226				return nil, err
   227			}
   228			return addr, nil
   229		case "reload_config":
   230			path := s.state.ConfigPath()
   231			cfg, err := config.Load(path)
   232			if err != nil {
   233				return nil, err
   234			}
   235			s.state.ApplyConfig(cfg)
   236			return "OK", nil
   237		case "get_rate_limit_status":
   238			var args struct {
   239				Name string `json:"name"`
   240			}
   241			if err := json.Unmarshal(req.Args, &args); err != nil {
   242				return nil, err
   243			}
   244			tokens, queueDepth, rateLimited, queued, timeouts, rps, burst, ok := s.state.RateLimitStatus(args.Name)
   245			if !ok {
   246				return nil, errors.New("service not found")
   247			}
   248			return map[string]interface{}{
   249				"tokens_available": tokens,
   250				"queue_depth":      queueDepth,
   251				"rate_limited":     int(rateLimited),
   252				"queued":           int(queued),
   253				"queue_timeouts":   int(timeouts),
   254				"rps":              rps,
   255				"burst":            burst,
   256			}, nil
   257		case "get_connections":
   258			var args struct {
   259				Name string `json:"name"`
   260			}
   261			if err := json.Unmarshal(req.Args, &args); err != nil {
   262				return nil, err
   263			}
   264			conns, ok := s.state.ConnectionsView(args.Name)
   265			if !ok {
   266				return nil, errors.New("service not found")
   267			}
   268			return map[string]interface{}{"connections": conns}, nil
   269		case "set_rate_limit":
   270			var args struct {
   271				Name  string `json:"name"`
   272				Rps   int    `json:"rps"`
   273				Burst int    `json:"burst"`
   274			}
   275			if err := json.Unmarshal(req.Args, &args); err != nil {
   276				return nil, err
   277			}
   278			if err := s.state.SetRateLimit(args.Name, args.Rps, args.Burst); err != nil {
   279				return nil, err
   280			}
   281			return "OK", nil
   282		case "get_access_log":
   283			var args struct {
   284				Service       string `json:"service"`
   285				LastN         *int   `json:"last_n"`
   286				Result        string `json:"result"`
   287				MinDurationMs int64  `json:"min_duration_ms"`
   288			}
   289			if err := json.Unmarshal(req.Args, &args); err != nil {
   290				return nil, err
   291			}
   292			lastN := 20
   293			if args.LastN != nil {
   294				lastN = *args.LastN
   295			}
   296			entries := accesslog.GetAccessLog(accesslog.DefaultPath, args.Service, args.Result, lastN, args.MinDurationMs)
   297			if entries == nil {
   298				entries = []accesslog.Entry{}
   299			}
   300			return entries, nil
   301		case "get_access_stats":
   302			var args struct {
   303				Service string `json:"service"`
   304			}
   305			if err := json.Unmarshal(req.Args, &args); err != nil {
   306				return nil, err
   307			}
   308			return accesslog.Stats(accesslog.DefaultPath, args.Service), nil
   309		default:
   310			return nil, fmt.Errorf("unknown command: %s", req.Cmd)
   311		}
   312	}
