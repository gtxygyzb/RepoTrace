[?2004l     1	package stats
     2	
     3	import (
     4		"sync"
     5		"time"
     6	)
     7	
     8	type entry struct {
     9		timestamp time.Time
    10		bytesIn   int64
    11		bytesOut  int64
    12		latency   time.Duration
    13		err       bool
    14	}
    15	
    16	// Collector keeps rolling connection statistics for one endpoint.
    17	type Collector struct {
    18		mu         sync.Mutex
    19		window     time.Duration
    20		entries    []entry
    21		rejections []time.Time
    22	
    23		rateLimited    int
    24		queued         int
    25		queueTimeouts  int
    26		retries        int
    27		retrySuccesses int
    28		idleTimeouts   int
    29	}
    30	
    31	// New creates a collector with the given window length.
    32	func New(window time.Duration) *Collector {
    33		if window <= 0 {
    34			window = time.Minute
    35		}
    36		return &Collector{window: window}
    37	}
    38	
    39	// RecordConnection records a finished connection attempt.
    40	func (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {
    41		c.mu.Lock()
    42		defer c.mu.Unlock()
    43		now := time.Now()
    44		c.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})
    45		c.trim(now)
    46	}
    47	
    48	// RecordRejection records a rejected connection because the endpoint was at capacity.
    49	func (c *Collector) RecordRejection() {
    50		c.mu.Lock()
    51		defer c.mu.Unlock()
    52		now := time.Now()
    53		c.rejections = append(c.rejections, now)
    54		c.trim(now)
    55	}
    56	
    57	// RecordRateLimited records a rate limit rejection.
    58	func (c *Collector) RecordRateLimited() {
    59		c.mu.Lock()
    60		defer c.mu.Unlock()
    61		c.rateLimited++
    62	}
    63	
    64	// RecordQueued records a connection that was queued waiting for a token.
    65	func (c *Collector) RecordQueued() {
    66		c.mu.Lock()
    67		defer c.mu.Unlock()
    68		c.queued++
    69	}
    70	
    71	// RecordQueueTimeout records a queue timeout rejection.
    72	func (c *Collector) RecordQueueTimeout() {
    73		c.mu.Lock()
    74		defer c.mu.Unlock()
    75		c.queueTimeouts++
    76		c.rateLimited++
    77	}
    78	
    79	// RecordRetry records a retry attempt.
    80	func (c *Collector) RecordRetry() {
    81		c.mu.Lock()
    82		defer c.mu.Unlock()
    83		c.retries++
    84	}
    85	
    86	// RecordRetrySuccess records a successful retry attempt.
    87	func (c *Collector) RecordRetrySuccess() {
    88		c.mu.Lock()
    89		defer c.mu.Unlock()
    90		c.retrySuccesses++
    91	}
    92	
    93	// RecordIdleTimeout records a connection that was closed because it was idle.
    94	func (c *Collector) RecordIdleTimeout() {
    95		c.mu.Lock()
    96		defer c.mu.Unlock()
    97		c.idleTimeouts++
    98	}
    99	
   100	func (c *Collector) trim(now time.Time) {
   101		cutoff := now.Add(-c.window)
   102		i := 0
   103		for i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {
   104			i++
   105		}
   106		if i > 0 {
   107			c.entries = c.entries[i:]
   108		}
   109		j := 0
   110		for j < len(c.rejections) && c.rejections[j].Before(cutoff) {
   111			j++
   112		}
   113		if j > 0 {
   114			c.rejections = c.rejections[j:]
   115		}
   116	}
   117	
   118	// Snapshot returns current windowed stats. active is supplied by the state manager.
   119	func (c *Collector) Snapshot(active int) Snapshot {
   120		c.mu.Lock()
   121		defer c.mu.Unlock()
   122		now := time.Now()
   123		cutoff := now.Add(-c.window)
   124		var total int
   125		var bytesIn, bytesOut int64
   126		var latencySum time.Duration
   127		var errors int
   128		for _, e := range c.entries {
   129			if e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {
   130				total++
   131				bytesIn += e.bytesIn
   132				bytesOut += e.bytesOut
   133				latencySum += e.latency
   134				if e.err {
   135					errors++
   136				}
   137			}
   138		}
   139		rejected := 0
   140		for _, t := range c.rejections {
   141			if t.After(cutoff) || t.Equal(cutoff) {
   142				rejected++
   143			}
   144		}
   145		var avg float64
   146		if total > 0 {
   147			avg = float64(latencySum.Milliseconds()) / float64(total)
   148		}
   149		return Snapshot{
   150			TotalConnections:    total,
   151			ActiveConnections:   active,
   152			BytesIn:             bytesIn,
   153			BytesOut:            bytesOut,
   154			AvgLatencyMs:        avg,
   155			Errors:              errors,
   156			RejectedConnections: rejected,
   157			RateLimited:         c.rateLimited,
   158			Queued:              c.queued,
   159			QueueTimeouts:       c.queueTimeouts,
   160			Retries:             c.retries,
   161			RetrySuccesses:      c.retrySuccesses,
   162			IdleTimeouts:        c.idleTimeouts,
   163		}
   164	}
   165	
   166	// Snapshot is a JSON-friendly stats view.
   167	type Snapshot struct {
   168		TotalConnections    int     `json:"total_connections"`
   169		ActiveConnections   int     `json:"active_connections"`
   170		BytesIn             int64   `json:"bytes_in"`
   171		BytesOut            int64   `json:"bytes_out"`
   172		AvgLatencyMs        float64 `json:"avg_latency_ms"`
   173		Errors              int     `json:"errors"`
   174		RejectedConnections int     `json:"rejected_connections"`
   175		RateLimited         int     `json:"rate_limited"`
   176		Queued              int     `json:"queued"`
   177		QueueTimeouts       int     `json:"queue_timeouts"`
   178		Retries             int     `json:"retries"`
   179		RetrySuccesses      int     `json:"retry_successes"`
   180		IdleTimeouts        int     `json:"idle_timeouts"`
   181	}
