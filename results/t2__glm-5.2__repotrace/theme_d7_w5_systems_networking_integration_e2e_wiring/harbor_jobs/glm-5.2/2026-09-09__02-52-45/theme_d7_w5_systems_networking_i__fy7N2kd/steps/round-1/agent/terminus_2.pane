'''func (s *State) ResolveEndpoint(service string) (string, error) {
\tss := s.GetService(service)
\tif ss == nil {
\t\treturn "", errNotFound("service not found")
\t}
\tss.mu.Lock()
\tmaxConns := ss.MaxConnectionsPerEndpoint
\tmode := ss.RoutingMode
\tperService := ss.ConnectionLimitMode == "per-service"
\tendpoints := make([]*EndpointState, len(ss.Endpoints))
\tcopy(endpoints, ss.Endpoints)
\tss.mu.Unlock()

\ttotalActive := 0
\tif perService {
\t\tfor _, ep := range endpoints {
\t\t\tep.mu.Lock()
\t\t\ttotalActive += ep.ActiveConnections
\t\t\tep.mu.Unlock()
\t\t}
\t}

\tvar regular []*EndpointState
\tfor _, ep := range endpoints {
\t\tep.mu.Lock()
\t\tvar eligible bool
\t\tif perService {
\t\t\teligible = ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && totalActive < maxConns
\t\t} else {
\t\t\teligible = ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
\t\t}
\t\tep.mu.Unlock()
\t\tif eligible {
\t\t\tregular = append(regular, ep)
\t\t}
\t}

\tif len(regular) > 0 {
\t\tif mode == "least-connections" {
\t\t\tep := selectLeastConnections(regular, maxConns)
\t\t\treturn ep.Address, nil
\t\t}
\t\tif best := selectWeightedCandidate(regular); best != nil {
\t\t\treturn best.Address, nil
\t\t}
\t}

\tfor _, ep := range endpoints {
\t\tep.mu.Lock()
\t\tvar halfOpen bool
\t\tif perService {
\t\t\thalfOpen = ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && totalActive < maxConns && !ep.Circuit.ProbeActive()
\t\t} else {
\t\t\thalfOpen = ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns && !ep.Circuit.ProbeActive()
\t\t}
\t\tep.mu.Unlock()
\t\tif halfOpen {
\t\t\treturn ep.Address, nil
\t\t}
\t}
\treturn "", errNotFound("no eligible endpoints")
}''')
p.write_text(s)
