   156				timeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond
   157				if timeout <= 0 {
   158					timeout = 5 * time.Second
   159				}
   160			}
   161			done := make(chan struct{})
   162			go func() {
   163				sl.wg.Wait()
   164				close(done)
   165			}()
   166			select {
   167			case <-done:
   168			case <-time.After(timeout):
   169				r.state.CloseServiceConnections(sl.service)
   170				<-done
   171			}
   172		} else {
   173			sl.wg.Wait()
   174		}
   175	}
