    60	func selectWeighted(eps []*EndpointState) *EndpointState {
    61		var best *EndpointState
    62		var bestWeight int
    63		var totalWeight int
    64		for _, ep := range eps {
    65			ep.mu.Lock()
    66			w := ep.effectiveWeightLocked()
    67			ep.currentWeight += w
    68			totalWeight += w
    69			cw := ep.currentWeight
    70			ep.mu.Unlock()
    71			if best == nil || cw > bestWeight {
    72				best = ep
    73				bestWeight = cw
    74			}
    75		}
    76		if best != nil {
    77			best.mu.Lock()
    78			best.currentWeight -= totalWeight
    79			best.mu.Unlock()
    80		}
    81		return best
    82	}
    83	
    84	func selectWeightedCandidate(eps []*EndpointState) *EndpointState {
    85		var best *EndpointState
    86		var bestWeight int
    87		for _, ep := range eps {
    88			ep.mu.Lock()
    89			cw := ep.currentWeight + ep.effectiveWeightLocked()
    90			ep.mu.Unlock()
    91			if best == nil || cw > bestWeight {
    92				best = ep
    93				bestWeight = cw
    94			}
    95		}
    96		return best
