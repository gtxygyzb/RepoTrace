    81	
    82	func NewState(cfg *config.Config, path string) *State {
    83		s := &State{
    84			configPath: path,
    85			services:   make(map[string]*ServiceState),
    86			healthLog:  make(map[string][]HealthEvent),
    87			reloadCh:   make(chan struct{}, 1),
    88		}
    89		s.applyConfigLocked(cfg)
    90		return s
    91	}
    92	
    93	func (s *State) ReloadChan() <-chan struct{} {
    94		return s.reloadCh
    95	}
    96	
    97	func (s *State) ConfigPath() string {
    98		s.mu.RLock()
    99		defer s.mu.RUnlock()
   100		return s.configPath
   101	}
   102	
   103	func (s *State) Global() config.Global {
   104		s.mu.RLock()
   105		defer s.mu.RUnlock()
   106		return s.global
   107	}
   108	
   109	func (s *State) ApplyConfig(cfg *config.Config) {
   110		s.mu.Lock()
   111		defer s.mu.Unlock()
   112		s.applyConfigLocked(cfg)
   113		select {
   114		case s.reloadCh <- struct{}{}:
   115		default:
   116		}
   117	}
   118	
   119	func (s *State) applyConfigLocked(cfg *config.Config) {
   120		s.global = cfg.Global
   121		seen := make(map[string]bool)
   122		for _, svc := range cfg.Services {
   123			seen[svc.Name] = true
   124			ss := s.services[svc.Name]
   125			if ss == nil {
   126				ss = newServiceState(svc, cfg.Global)
   127				s.services[svc.Name] = ss
   128			} else {
   129				ss.mu.Lock()
   130				ss.Name = svc.Name
   131				ss.ListenPort = svc.ListenPort
   132				ss.RoutingMode = svc.RoutingMode
   133				ss.DrainTimeoutMs = svc.DrainTimeoutMs
   134				ss.RateLimitRps = svc.RateLimitRps
   135				ss.RateLimitBurst = svc.RateLimitBurst
   136				ss.RateLimitQueueDepth = svc.RateLimitQueueDepth
   137				ss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs
   138				ss.MaxRetries = svc.MaxRetries
   139				ss.RetryDelayMs = svc.RetryDelayMs
   140				ss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier
   141				ss.RetryMaxDelayMs = svc.RetryMaxDelayMs
   142				if ss.rateLimiter == nil {
   143					ss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   144				} else {
   145					ss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   146				}
   147				ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint
   148				ss.mu.Unlock()
   149				ss.applyEndpoints(svc.Endpoints, cfg.Global)
   150			}
   151		}
   152		for name, ss := range s.services {
   153			if !seen[name] {
   154				ss.mu.Lock()
   155				ss.stopping = true
   156				if ss.listenerStop != nil {
   157					close(ss.listenerStop)
   158					ss.listenerStop = nil
   159				}
   160				if ss.Listener != nil {
   161					ss.Listener.Close()
   162					ss.Listener = nil
   163				}
   164				ss.mu.Unlock()
   165				for _, ep := range ss.Endpoints {
   166					ep.StartDraining(ss.DrainTimeoutMs, true)
   167				}
   168			}
   169		}
   170	}
   171	
   172	func newServiceState(svc config.Service, global config.Global) *ServiceState {
   173		ss := &ServiceState{
   174			Name:                      svc.Name,
   175			ListenPort:                svc.ListenPort,
   176			RoutingMode:               svc.RoutingMode,
   177			DrainTimeoutMs:            svc.DrainTimeoutMs,
   178			RateLimitRps:              svc.RateLimitRps,
   179			RateLimitBurst:            svc.RateLimitBurst,
   180			RateLimitQueueDepth:       svc.RateLimitQueueDepth,
   181			RateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,
   182			MaxRetries:                svc.MaxRetries,
   183			RetryDelayMs:              svc.RetryDelayMs,
   184			RetryBackoffMultiplier:    svc.RetryBackoffMultiplier,
   185			RetryMaxDelayMs:           svc.RetryMaxDelayMs,
   186			rateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),
   187			MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
   188			listenerStop:              nil,
   189		}
   190		for _, ep := range svc.Endpoints {
   191			ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))
   192		}
   193		return ss
   194	}
   195	
   196	func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {
   197		ss.mu.Lock()
   198		defer ss.mu.Unlock()
   199		seen := make(map[string]bool)
   200		for _, cep := range eps {
   201			seen[cep.Address] = true
   202			var ep *EndpointState
   203			for _, existing := range ss.Endpoints {
   204				if existing.Address == cep.Address {
   205					ep = existing
   206					break
   207				}
   208			}
   209			if ep == nil {
   210				ep = newEndpointState(cep, global)
   211				ss.Endpoints = append(ss.Endpoints, ep)
   212			} else {
   213				ep.mu.Lock()
   214				ep.Config = cep
   215				ep.Weight = cep.Weight
   216				ep.mu.Unlock()
   217			}
   218		}
   219		for _, ep := range ss.Endpoints {
   220			if !seen[ep.Address] {
   221				ep.StartDraining(ss.DrainTimeoutMs, true)
   222			}
   223		}
   224	}
   225	
   226	func newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {
   227		return &EndpointState{
   228			Address:     cep.Address,
   229			Weight:      cep.Weight,
   230			Config:      cep,
   231			State:       Unknown,
   232			Circuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),
   233			Stats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),
   234			connections: make(map[int64]net.Conn),
   235		}
   236	}
   237	
   238	func (s *State) GetService(name string) *ServiceState {
   239		s.mu.RLock()
   240		defer s.mu.RUnlock()
   241		return s.services[name]
   242	}
   243	
   244	func (s *State) Services() []*ServiceState {
   245		s.mu.RLock()
   246		defer s.mu.RUnlock()
   247		out := make([]*ServiceState, 0, len(s.services))
   248		for _, ss := range s.services {
   249			out = append(out, ss)
   250		}
   251		return out
   252	}
   253	
   254	func (s *State) GetEndpoint(service, address string) *EndpointState {
   255		ss := s.GetService(service)
   256		if ss == nil {
   257			return nil
   258		}
   259		ss.mu.Lock()
   260		defer ss.mu.Unlock()
   261		for _, ep := range ss.Endpoints {
   262			if ep.Address == address {
   263				return ep
   264			}
   265		}
   266		return nil
   267	}
   268	
   269	func (s *State) SetWeight(service, address string, weight int) error {
   270		ep := s.GetEndpoint(service, address)
   271		if ep == nil {
   272			return errNotFound("endpoint not found")
   273		}
   274		ep.mu.Lock()
   275		defer ep.mu.Unlock()
   276		if weight < 0 {
   277			weight = 0
   278		}
   279		ep.Weight = weight
   280		return nil
[?2004hroot@n30009:/app# nl -ba internal/state/routing.go | sed -n '1,260p'
[?2004l     1	package state
     2	
     3	import (
     4		"sort"
     5		"time"
     6	)
     7	
     8	// SelectResult contains selected endpoint and whether it is a half-open probe.
     9	type SelectResult struct {
    10		Endpoint *EndpointState
    11		Probe    bool
    12		MaxConns int
    13	}
    14	
    15	// SelectEndpoint chooses an endpoint for the next connection.
    16	func (s *State) SelectEndpoint(service string) (SelectResult, error) {
    17		ss := s.GetService(service)
    18		if ss == nil {
    19			return SelectResult{}, errNotFound("service not found")
    20		}
    21		ss.mu.Lock()
    22		maxConns := ss.MaxConnectionsPerEndpoint
    23		mode := ss.RoutingMode
    24		endpoints := make([]*EndpointState, len(ss.Endpoints))
    25		copy(endpoints, ss.Endpoints)
    26		ss.mu.Unlock()
    27	
    28		now := time.Now()
    29		_ = now
    30	
    31		var regular []*EndpointState
    32		for _, ep := range endpoints {
    33			ep.mu.Lock()
    34			eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
    35			ep.mu.Unlock()
    36			if eligible {
    37				regular = append(regular, ep)
    38			}
    39		}
    40	
    41		if len(regular) > 0 {
    42			if mode == "least-connections" {
    43				return SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil
    44			}
    45			return SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil
    46		}
    47	
    48		for _, ep := range endpoints {
    49			ep.mu.Lock()
    50			halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
    51			ep.mu.Unlock()
    52			if halfOpen && ep.Circuit.AcquireProbe() {
    53				return SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil
    54			}
    55		}
    56		return SelectResult{}, errNotFound("no eligible endpoints")
    57	}
    58	
    59	// SelectCandidate returns the endpoint that would be selected ignoring connection limits.
    60	// Used to account rejected_connections when all eligible endpoints are at capacity.
    61	func (s *State) SelectCandidate(service string) (*EndpointState, error) {
    62		ss := s.GetService(service)
    63		if ss == nil {
    64			return nil, errNotFound("service not found")
    65		}
    66		ss.mu.Lock()
    67		mode := ss.RoutingMode
    68		endpoints := make([]*EndpointState, len(ss.Endpoints))
    69		copy(endpoints, ss.Endpoints)
    70		ss.mu.Unlock()
    71	
    72		var regular []*EndpointState
    73		for _, ep := range endpoints {
    74			ep.mu.Lock()
    75			eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining
    76			ep.mu.Unlock()
    77			if eligible {
    78				regular = append(regular, ep)
    79			}
    80		}
    81		if len(regular) == 0 {
    82			for _, ep := range endpoints {
    83				ep.mu.Lock()
    84				halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining
    85				ep.mu.Unlock()
    86				if halfOpen {
    87					return ep, nil
    88				}
    89			}
    90			return nil, errNotFound("no eligible endpoints")
    91		}
    92		if mode == "least-connections" {
    93			return selectLeastConnections(regular, 1<<30), nil
    94		}
    95		return selectWeightedCandidate(regular), nil
    96	}
    97	
    98	func selectWeighted(eps []*EndpointState) *EndpointState {
    99		var best *EndpointState
   100		var bestWeight int
   101		var totalWeight int
   102		for _, ep := range eps {
   103			ep.mu.Lock()
   104			ep.currentWeight += ep.Weight
   105			totalWeight += ep.Weight
   106			cw := ep.currentWeight
   107			ep.mu.Unlock()
   108			if best == nil || cw > bestWeight {
   109				best = ep
   110				bestWeight = cw
   111			}
   112		}
   113		if best != nil {
   114			best.mu.Lock()
   115			best.currentWeight -= totalWeight
   116			best.mu.Unlock()
   117		}
   118		return best
   119	}
   120	
   121	func selectWeightedCandidate(eps []*EndpointState) *EndpointState {
   122		var best *EndpointState
   123		var bestWeight int
   124		for _, ep := range eps {
   125			ep.mu.Lock()
   126			cw := ep.currentWeight + ep.Weight
   127			ep.mu.Unlock()
   128			if best == nil || cw > bestWeight {
   129				best = ep
   130				bestWeight = cw
   131			}
   132		}
   133		return best
   134	}
   135	
   136	func selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {
   137		sort.SliceStable(eps, func(i, j int) bool {
   138			ai := eps[i].Active()
   139			aj := eps[j].Active()
   140			if ai != aj {
   141				return ai < aj
   142			}
   143			return eps[i].Address < eps[j].Address
   144		})
   145		return eps[0]
   146	}
   147	
   148	// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.
   149	func (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {
   150		ss := s.GetService(service)
   151		if ss == nil {
   152			return SelectResult{}, errNotFound("service not found")
   153		}
   154		ss.mu.Lock()
   155		maxConns := ss.MaxConnectionsPerEndpoint
   156		mode := ss.RoutingMode
   157		endpoints := make([]*EndpointState, len(ss.Endpoints))
   158		copy(endpoints, ss.Endpoints)
   159		ss.mu.Unlock()
   160	
   161		var regular []*EndpointState
   162		for _, ep := range endpoints {
   163			if exclude != nil && ep == exclude {
   164				continue
   165			}
   166			ep.mu.Lock()
   167			eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
   168			ep.mu.Unlock()
   169			if eligible {
   170				regular = append(regular, ep)
   171			}
   172		}
   173	
   174		if len(regular) > 0 {
   175			if mode == "least-connections" {
   176				return SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil
   177			}
   178			return SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil
   179		}
   180	
   181		for _, ep := range endpoints {
   182			if exclude != nil && ep == exclude {
   183				continue
   184			}
   185			ep.mu.Lock()
   186			halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
   187			ep.mu.Unlock()
   188			if halfOpen && ep.Circuit.AcquireProbe() {
   189				return SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil
   190			}
   191		}
   192		return SelectResult{}, errNotFound("no eligible endpoints")
   193	}
