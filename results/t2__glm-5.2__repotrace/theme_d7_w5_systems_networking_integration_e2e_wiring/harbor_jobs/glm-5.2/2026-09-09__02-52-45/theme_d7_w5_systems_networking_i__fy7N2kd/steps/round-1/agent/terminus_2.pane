[?2004lfunc (ss *ServiceState) AcquireRateLimitToken() (allowed bool, queued bool, queueWaitMs int64, timedOut bool) {
	ss.mu.Lock()
	rl := ss.rateLimiter
	ss.mu.Unlock()
	if rl == nil {
		return true, false, 0, false
	}
	return rl.acquire(time.Now())
}
