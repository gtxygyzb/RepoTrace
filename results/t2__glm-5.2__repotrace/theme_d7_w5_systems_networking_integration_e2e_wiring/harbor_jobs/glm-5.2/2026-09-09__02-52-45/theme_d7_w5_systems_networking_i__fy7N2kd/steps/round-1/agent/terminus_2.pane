func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: meshctl <command> [args]")
		os.Exit(1)
	}

	cliCmd := os.Args[1]
	args := make(map[string]interface{})
	var ipcCmd string

	switch cliCmd {
	case "status":
		ipcCmd = "list_services"
	case "stats":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl stats <service>")
			os.Exit(1)
		}
		ipcCmd = "get_stats"
		args["name"] = os.Args[2]
	case "set-weight":
		if len(os.Args) < 5 {
			fmt.Fprintln(os.Stderr, "usage: meshctl set-weight <service> <endpoint> <weight>")
			os.Exit(1)
		}
		weight, err := strconv.Atoi(os.Args[4])
		if err != nil {
			fmt.Fprintf(os.Stderr, "invalid weight: %v\n", err)
			os.Exit(1)
		}
		ipcCmd = "set_weight"
		args["name"] = os.Args[2]
		args["address"] = os.Args[3]
		args["weight"] = weight
	case "drain":
		if len(os.Args) < 4 {
			fmt.Fprintln(os.Stderr, "usage: meshctl drain <service> <endpoint>")
			os.Exit(1)
		}
		ipcCmd = "drain_endpoint"
		args["name"] = os.Args[2]
		args["address"] = os.Args[3]
	case "health-log":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl health-log <service> [--last N]")
			os.Exit(1)
		}
		ipcCmd = "get_health_log"
		args["name"] = os.Args[2]
		last := 20
		for _, a := range os.Args[3:] {
			if strings.HasPrefix(a, "--last") && len(a) > 6 {
				if v, err := strconv.Atoi(a[6:]); err == nil {
					last = v
				}
			}
		}
		args["last_n"] = last
	case "resolve":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl resolve <service>")
			os.Exit(1)
		}
		ipcCmd = "resolve"
		args["name"] = os.Args[2]
	case "circuits":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl circuits <service>")
			os.Exit(1)
		}
		ipcCmd = "get_circuit_breakers"
		args["name"] = os.Args[2]
	case "reset-circuit":
		if len(os.Args) < 4 {
			fmt.Fprintln(os.Stderr, "usage: meshctl reset-circuit <service> <endpoint>")
			os.Exit(1)
		}
		ipcCmd = "reset_circuit_breaker"
		args["name"] = os.Args[2]
		args["address"] = os.Args[3]
	case "reload":
		ipcCmd = "reload_config"
	case "rate-limit":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl rate-limit <service>")
			os.Exit(1)
		}
		ipcCmd = "get_rate_limit_status"
		args["name"] = os.Args[2]
	case "warmup":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl warmup <service>")
			os.Exit(1)
		}
		ipcCmd = "get_warmup_status"
		args["name"] = os.Args[2]
	case "connections":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl connections <service>")
			os.Exit(1)
		}
		ipcCmd = "get_connections"
		args["name"] = os.Args[2]
	case "set-rate-limit":
		if len(os.Args) < 5 {
			fmt.Fprintln(os.Stderr, "usage: meshctl set-rate-limit <service> <rps> <burst>")
			os.Exit(1)
		}
		rps, err := strconv.Atoi(os.Args[3])
		if err != nil {
			fmt.Fprintf(os.Stderr, "invalid rps: %v\n", err)
			os.Exit(1)
		}
		burst, err := strconv.Atoi(os.Args[4])
		if err != nil {
			fmt.Fprintf(os.Stderr, "invalid burst: %v\n", err)
			os.Exit(1)
		}
		ipcCmd = "set_rate_limit"
		args["name"] = os.Args[2]
		args["rps"] = rps
		args["burst"] = burst
	case "access-log":
		ipcCmd = "get_access_log"
		last := 20
		rest := os.Args[2:]
		for i := 0; i < len(rest); i++ {
			a := rest[i]
			if a == "--last" {
				if i+1 < len(rest) {
					if v, err := strconv.Atoi(rest[i+1]); err == nil {
						last = v
					}
					i++
				}
			} else if strings.HasPrefix(a, "--last=") {
				if v, err := strconv.Atoi(a[len("--last="):]); err == nil {
					last = v
				}
			} else if a == "--result" {
				if i+1 < len(rest) {
					args["result"] = rest[i+1]
					i++
				}
			} else if strings.HasPrefix(a, "--result=") {
				args["result"] = a[len("--result="):]
			} else if !strings.HasPrefix(a, "-") {
				args["service"] = a
			}
		}
		args["last_n"] = last
	case "access-stats":
		ipcCmd = "get_access_stats"
		for _, a := range os.Args[2:] {
			if !strings.HasPrefix(a, "-") {
				args["service"] = a
			}
		}
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", cliCmd)
		os.Exit(1)
	}

	data, err := sendCommand(ipcCmd, args)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Println(data)
}

func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {
	rawArgs, err := json.Marshal(args)
	if err != nil {
		return "", err
	}
	req := request{Cmd: ipcCmd, Args: rawArgs}
	reqBytes, err := json.Marshal(req)
	if err != nil {
		return "", err
	}

	conn, err := net.Dial("unix", "/tmp/meshd.sock")
	if err != nil {
		return "", fmt.Errorf("connect to meshd failed: %w", err)
	}
	defer conn.Close()

	fmt.Fprintf(conn, "%s\n", string(reqBytes))

	reader := bufio.NewReader(conn)
	line, err := reader.ReadString('\n')
	if err != nil {
		return "", err
	}
	line = strings.TrimRight(line, "\r\n")

