   158	func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {
   159		rawArgs, err := json.Marshal(args)
   160		if err != nil {
[?2004hroot@n30009:/app# nl -ba cmd/meshctl/main.go | sed -n '161,320p'
[?2004l   161			return "", err
   162		}
   163		req := request{Cmd: ipcCmd, Args: rawArgs}
   164		reqBytes, err := json.Marshal(req)
   165		if err != nil {
   166			return "", err
   167		}
   168	
   169		conn, err := net.Dial("unix", "/tmp/meshd.sock")
   170		if err != nil {
   171			return "", fmt.Errorf("connect to meshd failed: %w", err)
   172		}
   173		defer conn.Close()
   174	
   175		fmt.Fprintf(conn, "%s\n", string(reqBytes))
   176	
   177		reader := bufio.NewReader(conn)
   178		line, err := reader.ReadString('\n')
   179		if err != nil {
   180			return "", err
   181		}
   182		line = strings.TrimRight(line, "\r\n")
   183	
   184		var resp response
   185		if err := json.Unmarshal([]byte(line), &resp); err != nil {
   186			return "", err
   187		}
   188		if resp.Status != "ok" {
   189			var msg string
   190			if err := json.Unmarshal(resp.Data, &msg); err == nil {
   191				return "", fmt.Errorf("%s", msg)
   192			}
   193			return "", fmt.Errorf("%s", string(resp.Data))
   194		}
   195		return prettyData(ipcCmd, resp.Data)
   196	}
   197	
   198	func prettyData(ipcCmd string, data json.RawMessage) (string, error) {
   199		switch ipcCmd {
   200		case "list_services":
   201			var services []struct {
   202				Name        string `json:"name"`
   203				ListenPort  int    `json:"listen_port"`
   204				RoutingMode string `json:"routing_mode"`
   205				Endpoints   []struct {
   206					Address           string `json:"address"`
   207					State             string `json:"state"`
   208					Weight            int    `json:"weight"`
   209					ActiveConnections int    `json:"active_connections"`
   210					CircuitState      string `json:"circuit_state"`
   211				} `json:"endpoints"`
   212			}
   213			if err := json.Unmarshal(data, &services); err != nil {
   214				return "", err
   215			}
   216			var b strings.Builder
   217			fmt.Fprintf(&b, "%-14s %-18s %-10s %-7s %-11s %-7s\n", "SERVICE", "ENDPOINT", "STATE", "WEIGHT", "CIRCUIT", "ACTIVE")
   218			for _, svc := range services {
   219				for _, ep := range svc.Endpoints {
   220					fmt.Fprintf(&b, "%-14s %-18s %-10s %-7d %-11s %-7d\n", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)
   221				}
   222			}
   223			return strings.TrimRight(b.String(), "\n"), nil
   224		case "resolve":
   225			var addr string
   226			if err := json.Unmarshal(data, &addr); err != nil {
   227				return "", err
   228			}
   229			return addr, nil
   230		case "get_circuit_breakers":
   231			var circuits []struct {
   232				Address             string `json:"address"`
   233				CircuitState        string `json:"circuit_state"`
   234				ConsecutiveFailures int    `json:"consecutive_failures"`
   235				TimeInStateMs       int64  `json:"time_in_state_ms"`
   236				ProbeActive         bool   `json:"probe_active"`
   237			}
   238			if err := json.Unmarshal(data, &circuits); err != nil {
   239				return "", err
   240			}
   241			var b strings.Builder
   242			fmt.Fprintf(&b, "%-18s %-11s %-9s %-17s %-7s\n", "ENDPOINT", "CIRCUIT", "FAILURES", "TIME_IN_STATE_MS", "PROBE")
   243			for _, c := range circuits {
   244				fmt.Fprintf(&b, "%-18s %-11s %-9d %-17d %-7t\n", c.Address, c.CircuitState, c.ConsecutiveFailures, c.TimeInStateMs, c.ProbeActive)
   245			}
   246			return strings.TrimRight(b.String(), "\n"), nil
   247		case "get_warmup_status":
   248			var resp struct {
   249				Endpoints []struct {
   250					Endpoint          string `json:"endpoint"`
   251					WarmingUp         bool   `json:"warming_up"`
   252					WarmupRemainingMs int    `json:"warmup_remaining_ms"`
   253					EffectiveWeight   int    `json:"effective_weight"`
   254					ConfigWeight      int    `json:"config_weight"`
   255				} `json:"endpoints"`
   256			}
   257			if err := json.Unmarshal(data, &resp); err != nil {
   258				return "", err
   259			}
   260			var b strings.Builder
   261			fmt.Fprintf(&b, "%-18s %-11s %-13s %-17s %-13s\n", "ENDPOINT", "WARMING_UP", "REMAINING_MS", "EFFECTIVE_WEIGHT", "CONFIG_WEIGHT")
   262			for _, e := range resp.Endpoints {
   263				fmt.Fprintf(&b, "%-18s %-11t %-13d %-17d %-13d\n", e.Endpoint, e.WarmingUp, e.WarmupRemainingMs, e.EffectiveWeight, e.ConfigWeight)
   264			}
   265			return strings.TrimRight(b.String(), "\n"), nil
   266		case "set_weight", "drain_endpoint", "reset_circuit_breaker", "reload_config", "set_rate_limit":
   267			var s string
   268			if err := json.Unmarshal(data, &s); err != nil {
   269				return "", err
   270			}
   271			return s, nil
   272		case "get_connections":
   273			var resp struct {
   274				Connections []struct {
   275					Endpoint string `json:"endpoint"`
   276					Client   string `json:"client"`
   277					AgeMs    int64  `json:"age_ms"`
   278					IdleMs   int64  `json:"idle_ms"`
   279					BytesIn  int64  `json:"bytes_in"`
   280					BytesOut int64  `json:"bytes_out"`
   281				} `json:"connections"`
   282			}
   283			if err := json.Unmarshal(data, &resp); err != nil {
   284				fmt.Fprintf(os.Stderr, "failed to decode response: %v\n", err)
   285				os.Exit(1)
   286			}
   287			fmt.Printf("%-18s %-18s %-9s %-9s %-10s %-10s\n", "ENDPOINT", "CLIENT", "AGE_MS", "IDLE_MS", "BYTES_IN", "BYTES_OUT")
   288			for _, c := range resp.Connections {
   289				fmt.Printf("%-18s %-18s %-9d %-9d %-10d %-10d\n", c.Endpoint, c.Client, c.AgeMs, c.IdleMs, c.BytesIn, c.BytesOut)
   290			}
   291			return "", nil
   292		case "get_rate_limit_status":
   293			var st struct {
   294				TokensAvailable float64 `json:"tokens_available"`
   295				QueueDepth      int     `json:"queue_depth"`
   296				RateLimited     int     `json:"rate_limited"`
   297				Queued          int     `json:"queued"`
   298				QueueTimeouts   int     `json:"queue_timeouts"`
   299				Rps             float64 `json:"rps"`
   300				Burst           float64 `json:"burst"`
   301			}
   302			if err := json.Unmarshal(data, &st); err != nil {
   303				return "", err
   304			}
   305			var b strings.Builder
   306			fmt.Fprintf(&b, "%-10s %-6s %-7s %-10s %-8s %-14s %-15s\n", "SERVICE", "RPS", "BURST", "TOKENS", "QUEUED", "RATE_LIMITED", "QUEUE_TIMEOUTS")
   307			fmt.Fprintf(&b, "%-10s %-6.0f %-7.0f %-10.2f %-8d %-14d %-15d\n", os.Args[2], st.Rps, st.Burst, st.TokensAvailable, st.QueueDepth, st.RateLimited, st.QueueTimeouts)
   308			return strings.TrimRight(b.String(), "\n"), nil
   309		default:
   310			var v interface{}
   311			if err := json.Unmarshal(data, &v); err != nil {
   312				return "", err
   313			}
   314			b, err := json.MarshalIndent(v, "", "  ")
   315			if err != nil {
   316				return "", err
   317			}
   318			return string(b), nil
   319		}
   320	}
