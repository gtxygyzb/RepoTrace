    48	
    49	type ServiceState struct {
    50		mu                        sync.Mutex
    51		Name                      string
    52		ListenPort                int
    53		RoutingMode               string
    54		DrainTimeoutMs            int
    55		MaxConnectionsPerEndpoint int
    56		Endpoints                 []*EndpointState
    57		rrIndex                   int
    58		Listener                  net.Listener
    59		listenerStop              chan struct{}
    60		stopping                  bool
    61	}
    62	
    63	type State struct {
    64		mu         sync.RWMutex
    65		configPath string
    66		global     config.Global
    67		services   map[string]*ServiceState
    68		logMu      sync.Mutex
    69		healthLog  map[string][]HealthEvent
    70		reloadCh   chan struct{}
    71	}
    72	
    73	func NewState(cfg *config.Config, path string) *State {
    74		s := &State{
    75			configPath: path,
    76			services:   make(map[string]*ServiceState),
    77			healthLog:  make(map[string][]HealthEvent),
    78			reloadCh:   make(chan struct{}, 1),
    79		}
    80		s.applyConfigLocked(cfg)
    81		return s
    82	}
    83	
    84	func (s *State) ReloadChan() <-chan struct{} {
    85		return s.reloadCh
    86	}
    87	
    88	func (s *State) ConfigPath() string {
    89		s.mu.RLock()
    90		defer s.mu.RUnlock()
    91		return s.configPath
    92	}
    93	
    94	func (s *State) Global() config.Global {
    95		s.mu.RLock()
    96		defer s.mu.RUnlock()
    97		return s.global
    98	}
    99	
   100	func (s *State) ApplyConfig(cfg *config.Config) {
   101		s.mu.Lock()
   102		defer s.mu.Unlock()
   103		s.applyConfigLocked(cfg)
   104		select {
   105		case s.reloadCh <- struct{}{}:
   106		default:
   107		}
   108	}
   109	
   110	func (s *State) applyConfigLocked(cfg *config.Config) {
   111		s.global = cfg.Global
   112		seen := make(map[string]bool)
   113		for _, svc := range cfg.Services {
   114			seen[svc.Name] = true
   115			ss := s.services[svc.Name]
   116			if ss == nil {
   117				ss = newServiceState(svc, cfg.Global)
   118				s.services[svc.Name] = ss
   119			} else {
   120				ss.mu.Lock()
   121				ss.Name = svc.Name
   122				ss.ListenPort = svc.ListenPort
   123				ss.RoutingMode = svc.RoutingMode
   124				ss.DrainTimeoutMs = svc.DrainTimeoutMs
   125				ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint
   126				ss.mu.Unlock()
   127				ss.applyEndpoints(svc.Endpoints, cfg.Global)
   128			}
   129		}
   130		for name, ss := range s.services {
   131			if !seen[name] {
   132				ss.mu.Lock()
   133				ss.stopping = true
   134				if ss.listenerStop != nil {
   135					close(ss.listenerStop)
   136					ss.listenerStop = nil
   137				}
   138				if ss.Listener != nil {
   139					ss.Listener.Close()
   140					ss.Listener = nil
   141				}
   142				ss.mu.Unlock()
   143				for _, ep := range ss.Endpoints {
   144					ep.StartDraining(ss.DrainTimeoutMs, true)
   145				}
   146			}
   147		}
   148	}
   149	
   150	func newServiceState(svc config.Service, global config.Global) *ServiceState {
   151		ss := &ServiceState{
   152			Name:                      svc.Name,
   153			ListenPort:                svc.ListenPort,
   154			RoutingMode:               svc.RoutingMode,
   155			DrainTimeoutMs:            svc.DrainTimeoutMs,
   156			MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
   157			listenerStop:              nil,
   158		}
   159		for _, ep := range svc.Endpoints {
   160			ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))
   161		}
   162		return ss
   163	}
   164	
   165	func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {
   166		ss.mu.Lock()
   167		defer ss.mu.Unlock()
   168		seen := make(map[string]bool)
   169		for _, cep := range eps {
   170			seen[cep.Address] = true
   171			var ep *EndpointState
   172			for _, existing := range ss.Endpoints {
   173				if existing.Address == cep.Address {
   174					ep = existing
   175					break
   176				}
   177			}
   178			if ep == nil {
   179				ep = newEndpointState(cep, global)
   180				ss.Endpoints = append(ss.Endpoints, ep)
   181			} else {
   182				ep.mu.Lock()
   183				ep.Config = cep
   184				ep.Weight = cep.Weight
   185				ep.mu.Unlock()
   186			}
   187		}
   188		for _, ep := range ss.Endpoints {
   189			if !seen[ep.Address] {
   190				ep.StartDraining(ss.DrainTimeoutMs, true)
   191			}
   192		}
   193	}
