func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {
	rawArgs, err := json.Marshal(args)
	if err != nil {
		return "", err
	}
	req := request{Cmd: ipcCmd, Args: rawArgs}
	reqBytes, err := json.Marshal(req)
	if err != nil {
		return "", err
	}

	conn, err := net.Dial("unix", "/tmp/meshd.sock")
	if err != nil {
		return "", fmt.Errorf("connect to meshd failed: %w", err)
	}
	defer conn.Close()

	fmt.Fprintf(conn, "%s\n", string(reqBytes))

	reader := bufio.NewReader(conn)
	line, err := reader.ReadString('\n')
	if err != nil {
		return "", err
	}
	line = strings.TrimRight(line, "\r\n")

	var resp response
	if err := json.Unmarshal([]byte(line), &resp); err != nil {
		return "", err
	}
	if resp.Status != "ok" {
		var msg string
		if err := json.Unmarshal(resp.Data, &msg); err == nil {
			return "", fmt.Errorf("%s", msg)
		}
		return "", fmt.Errorf("%s", string(resp.Data))
[?2004hroot@n30009:/app# sed -n '390,440p' cmd/meshctl/main.go
[?2004l		fmt.Fprintf(&b, "%-10s %-6s %-7s %-10s %-8s %-14s %-15s\n", "SERVICE", "RPS", "BURST", "TOKENS", "QUEUED", "RATE_LIMITED", "QUEUE_TIMEOUTS")
		fmt.Fprintf(&b, "%-10s %-6.0f %-7.0f %-10.2f %-8d %-14d %-15d\n", os.Args[2], st.Rps, st.Burst, st.TokensAvailable, st.QueueDepth, st.RateLimited, st.QueueTimeouts)
		return strings.TrimRight(b.String(), "\n"), nil
	default:
		var v interface{}
		if err := json.Unmarshal(data, &v); err != nil {
			return "", err
		}
		b, err := json.MarshalIndent(v, "", "  ")
		if err != nil {
			return "", err
		}
		return string(b), nil
	}
}
