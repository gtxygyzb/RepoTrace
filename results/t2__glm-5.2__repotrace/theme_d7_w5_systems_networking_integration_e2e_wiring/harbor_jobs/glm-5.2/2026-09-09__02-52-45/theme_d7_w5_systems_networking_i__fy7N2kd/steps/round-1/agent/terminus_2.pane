	case "warmup":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl warmup <service>")
			os.Exit(1)
		}
		ipcCmd = "get_warmup_status"
		args["name"] = os.Args[2]
	case "connections":
		if len(os.Args) < 3 {
			fmt.Fprintln(os.Stderr, "usage: meshctl connections <service>")
			os.Exit(1)
		}
		ipcCmd = "get_connections"
		args["name"] = os.Args[2]
	case "set-rate-limit":
		if len(os.Args) < 5 {
			fmt.Fprintln(os.Stderr, "usage: meshctl set-rate-limit <service> <rps> <burst>")
			os.Exit(1)
		}
		rps, err := strconv.Atoi(os.Args[3])
		if err != nil {
			fmt.Fprintf(os.Stderr, "invalid rps: %v\n", err)
			os.Exit(1)
		}
		burst, err := strconv.Atoi(os.Args[4])
		if err != nil {
			fmt.Fprintf(os.Stderr, "invalid burst: %v\n", err)
			os.Exit(1)
		}
		ipcCmd = "set_rate_limit"
		args["name"] = os.Args[2]
		args["rps"] = rps
		args["burst"] = burst
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", cliCmd)
		os.Exit(1)
	}

	data, err := sendCommand(ipcCmd, args)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Println(data)
}

func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {
	rawArgs, err := json.Marshal(args)
	if err != nil {
		return "", err
	}
	req := request{Cmd: ipcCmd, Args: rawArgs}
	reqBytes, err := json.Marshal(req)
	if err != nil {
		return "", err
	}

	conn, err := net.Dial("unix", "/tmp/meshd.sock")
	if err != nil {
		return "", fmt.Errorf("connect to meshd failed: %w", err)
	}
	defer conn.Close()

	fmt.Fprintf(conn, "%s\n", string(reqBytes))

	reader := bufio.NewReader(conn)
	line, err := reader.ReadString('\n')
	if err != nil {
		return "", err
	}
	line = strings.TrimRight(line, "\r\n")

	var resp response
	if err := json.Unmarshal([]byte(line), &resp); err != nil {
		return "", err
	}
	if resp.Status != "ok" {
		var msg string
		if err := json.Unmarshal(resp.Data, &msg); err == nil {
			return "", fmt.Errorf("%s", msg)
		}
		return "", fmt.Errorf("%s", string(resp.Data))
	}
	return prettyData(ipcCmd, resp.Data)
}

func prettyData(ipcCmd string, data json.RawMessage) (string, error) {
	switch ipcCmd {
