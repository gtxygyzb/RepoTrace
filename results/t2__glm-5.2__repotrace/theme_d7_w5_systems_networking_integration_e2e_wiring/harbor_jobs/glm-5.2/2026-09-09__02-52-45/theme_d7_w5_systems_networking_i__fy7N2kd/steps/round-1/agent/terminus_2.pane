   117	
   118	func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {
   119		rawArgs, err := json.Marshal(args)
   120		if err != nil {
   121			return "", err
   122		}
   123		req := request{Cmd: ipcCmd, Args: rawArgs}
   124		reqBytes, err := json.Marshal(req)
   125		if err != nil {
   126			return "", err
   127		}
   128	
   129		conn, err := net.Dial("unix", "/tmp/meshd.sock")
   130		if err != nil {
   131			return "", fmt.Errorf("connect to meshd failed: %w", err)
   132		}
   133		defer conn.Close()
   134	
   135		fmt.Fprintf(conn, "%s\n", string(reqBytes))
   136	
   137		reader := bufio.NewReader(conn)
   138		line, err := reader.ReadString('\n')
   139		if err != nil {
   140			return "", err
   141		}
   142		line = strings.TrimRight(line, "\r\n")
   143	
   144		var resp response
   145		if err := json.Unmarshal([]byte(line), &resp); err != nil {
   146			return "", err
   147		}
   148		if resp.Status != "ok" {
   149			var msg string
   150			if err := json.Unmarshal(resp.Data, &msg); err == nil {
   151				return "", fmt.Errorf("%s", msg)
   152			}
   153			return "", fmt.Errorf("%s", string(resp.Data))
   154		}
   155		return prettyData(ipcCmd, resp.Data)
   156	}
   157	
   158	func prettyData(ipcCmd string, data json.RawMessage) (string, error) {
   159		switch ipcCmd {
   160		case "list_services":
