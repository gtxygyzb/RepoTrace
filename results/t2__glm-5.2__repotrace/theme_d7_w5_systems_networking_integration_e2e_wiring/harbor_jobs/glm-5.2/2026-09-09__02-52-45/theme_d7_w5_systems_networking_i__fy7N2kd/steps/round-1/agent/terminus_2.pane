[?2004l[?2004h>     BytesOut   int64  `json:"bytes_out"`
[?2004l[?2004h>     DurationMs int64  `json:"duration_ms"`
[?2004l[?2004h>     Result     string `json:"result"`
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // DefaultPath is the access log path required by meshrouter.
