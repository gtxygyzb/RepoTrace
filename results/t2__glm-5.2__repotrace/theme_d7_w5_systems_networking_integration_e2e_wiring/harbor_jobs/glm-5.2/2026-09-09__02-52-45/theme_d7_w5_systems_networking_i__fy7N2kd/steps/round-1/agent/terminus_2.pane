   253					EffectiveWeight   int    `json:"effective_weight"`
   254					ConfigWeight      int    `json:"config_weight"`
   255				} `json:"endpoints"`
   256			}
   257			if err := json.Unmarshal(data, &resp); err != nil {
   258				return "", err
   259			}
   260			var b strings.Builder
