			Burst           float64 `json:"burst"`
		}
		if err := json.Unmarshal(data, &st); err != nil {
			return "", err
		}
		var b strings.Builder
		fmt.Fprintf(&b, "%-10s %-6s %-7s %-10s %-8s %-14s %-15s\n", "SERVICE", "RPS", "BURST", "TOKENS", "QUEUED", "RATE_LIMITED", "QUEUE_TIMEOUTS")
		fmt.Fprintf(&b, "%-10s %-6.0f %-7.0f %-10.2f %-8d %-14d %-15d\n", os.Args[2], st.Rps, st.Burst, st.TokensAvailable, st.QueueDepth, st.RateLimited, st.QueueTimeouts)
		return strings.TrimRight(b.String(), "\n"), nil
	case "get_dependencies":
		var resp struct {
			Service      string `json:"service"`
			Dependencies []struct {
				Name             string `json:"name"`
				Available        bool   `json:"available"`
				HealthyEndpoints int    `json:"healthy_endpoints"`
			} `json:"dependencies"`
		}
		if err := json.Unmarshal(data, &resp); err != nil {
			return "", err
		}
		if len(resp.Dependencies) == 0 {
			return "no dependencies", nil
		}
		var b strings.Builder
		fmt.Fprintf(&b, "%-14s %-14s %-10s %-18s\n", "SERVICE", "DEPENDS_ON", "AVAILABLE", "HEALTHY_ENDPOINTS")
		for _, dep := range resp.Dependencies {
			fmt.Fprintf(&b, "%-14s %-14s %-10t %-18d\n", resp.Service, dep.Name, dep.Available, dep.HealthyEndpoints)
		}
		return strings.TrimRight(b.String(), "\n"), nil
	default:
		var v interface{}
		if err := json.Unmarshal(data, &v); err != nil {
			return "", err
		}
		b, err := json.MarshalIndent(v, "", "  ")
		if err != nil {
			return "", err
		}
		return string(b), nil
