[?2004l   170	func (r *Router) handleConn(service string, client net.Conn) {
   171		start := time.Now()
   172		res, err := r.state.SelectEndpoint(service)
   173		if err != nil {
   174			if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   175				ss := r.state.GetService(service)
   176				if ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {
   177					cand.Stats.RecordRejection()
   178				}
   179			}
   180			client.Close()
   181			return
   182		}
   183		ep := res.Endpoint
   184	
   185		var id int64
   186		if !res.Probe {
   187			var ok bool
   188			id, ok = ep.TryAddConnection(client, res.MaxConns)
   189			if !ok {
   190				ep.Stats.RecordRejection()
   191				client.Close()
   192				return
   193			}
   194		}
   195	
   196		backend, err := net.Dial("tcp", ep.Address)
   197		if err != nil {
   198			if id != 0 {
   199				ep.RemoveConnection(id)
   200			}
   201			ep.Stats.RecordConnection(0, 0, time.Since(start), true)
   202			if res.Probe {
   203				ep.Circuit.ProbeFailure()
   204			}
   205			client.Close()
   206			return
   207		}
   208	
   209		if res.Probe {
   210			ep.Circuit.ProbeSuccess()
   211			var ok bool
   212			id, ok = ep.TryAddConnection(client, res.MaxConns)
   213			if !ok {
   214				ep.Stats.RecordRejection()
   215				backend.Close()
   216				client.Close()
   217				return
   218			}
   219		}
   220	
   221		bytesIn, bytesOut := forward(client, backend)
   222		backend.Close()
   223		client.Close()
   224		ep.RemoveConnection(id)
   225		ep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)
   226	}
   227	
   228	func forward(client, backend net.Conn) (int64, int64) {
   229		var bytesIn, bytesOut int64
   230		var wg sync.WaitGroup
   231		wg.Add(2)
   232		go func() {
   233			defer wg.Done()
   234			n, _ := io.Copy(backend, client)
   235			bytesOut = n
   236			backend.Close()
   237			client.Close()
   238		}()
   239		go func() {
   240			defer wg.Done()
   241			n, _ := io.Copy(client, backend)
   242			bytesIn = n
   243			client.Close()
   244			backend.Close()
   245		}()
   246		wg.Wait()
   247		return bytesIn, bytesOut
   248	}
   249	
   250	func intToStr(i int) string {
   251		if i == 0 {
   252			return "0"
   253		}
   254		var buf [12]byte
   255		pos := len(buf)
   256		neg := false
   257		if i < 0 {
   258			neg = true
   259			i = -i
   260		}
   261		for i > 0 {
   262			pos--
   263			buf[pos] = byte('0' + i%10)
   264			i /= 10
   265		}
   266		if neg {
   267			pos--
   268			buf[pos] = '-'
   269		}
   270		return string(buf[pos:])
   271	}
