                Service:    service,
                Client:     clientAddr,
                Endpoint:   endpoint,
                BytesIn:    bytesIn,
                BytesOut:   bytesOut,
                DurationMs: time.Since(start).Milliseconds(),
                Result:     result,
            })
        }
    }()

    ss := r.state.GetService(service)
    if ss == nil {
        result = "rejected_no_endpoint"
        client.Close()
        return
    }

    allowed, queued := ss.AcquireRateLimitToken()
    if !allowed {
        result = "rejected_rate_limit"
        client.Close()
        return
    }
    if queued {
        if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
            cand.Stats.RecordQueued()
        }
    }

    maxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()
    var lastEndpoint *state.EndpointState
    for attempt := 0; ; attempt++ {
        res, err := r.state.SelectEndpointExcluding(service, lastEndpoint)
        if err != nil {
            result = "rejected_no_endpoint"
            client.Close()
            return
        }
        lastEndpoint = res.Endpoint
        ep := res.Endpoint
        endpoint = ep.Address

        var id int64
        if !res.Probe {
            var ok bool
            id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)
            if !ok {
                result = "rejected_conn_limit"
                ep.Stats.RecordRejection()
                client.Close()
                return
            }
        }

