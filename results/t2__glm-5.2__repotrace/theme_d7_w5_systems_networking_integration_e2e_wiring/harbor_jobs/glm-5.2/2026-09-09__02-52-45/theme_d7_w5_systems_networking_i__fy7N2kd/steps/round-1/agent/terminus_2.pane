   420	func (s *State) HealthLog(service string, lastN int) []HealthEvent {
   421		s.logMu.Lock()
   422		defer s.logMu.Unlock()
   423		events := s.healthLog[service]
   424		if lastN <= 0 || lastN > len(events) {
   425			lastN = len(events)
   426		}
   427		out := make([]HealthEvent, lastN)
   428		copy(out, events[len(events)-lastN:])
   429		return out
   430	}
