    93	func (r *Router) stopService(name string, drain bool) {
    94		r.mu.Lock()
    95		sl, ok := r.listeners[name]
    96		if ok {
    97			delete(r.listeners, name)
    98		}
    99		r.mu.Unlock()
   100		if !ok {
   101			return
   102		}
   103		sl.stopAccept(drain, r)
   104	}
   105	
   106	func (r *Router) Stop() {
   107		r.mu.Lock()
   108		listeners := r.listeners
   109		r.listeners = make(map[string]*serviceListener)
   110		r.mu.Unlock()
   111		var wg sync.WaitGroup
   112		for name, sl := range listeners {
   113			wg.Add(1)
   114			go func(name string, sl *serviceListener) {
   115				defer wg.Done()
   116				sl.stopAccept(true, r)
   117			}(name, sl)
   118		}
   119		wg.Wait()
   120	}
   121	
   122	func (sl *serviceListener) acceptLoop(r *Router) {
   123		defer close(sl.done)
   124		for {
   125			conn, err := sl.listener.Accept()
   126			if err != nil {
   127				return
   128			}
   129			sl.wg.Add(1)
   130			go func(c net.Conn) {
   131				defer sl.wg.Done()
   132				r.handleConn(sl.service, c)
   133			}(conn)
   134		}
   135	}
   136	
   137	func (sl *serviceListener) stopAccept(drain bool, r *Router) {
   138		select {
   139		case <-sl.stop:
   140		default:
   141			close(sl.stop)
   142		}
   143		sl.listener.Close()
   144		<-sl.done
   145		if drain {
   146			ss := r.state.GetService(sl.service)
   147			timeout := 5 * time.Second
   148			if ss != nil {
   149				timeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond
   150				if timeout <= 0 {
   151					timeout = 5 * time.Second
   152				}
   153			}
   154			done := make(chan struct{})
   155			go func() {
   156				sl.wg.Wait()
   157				close(done)
   158			}()
   159			select {
   160			case <-done:
   161			case <-time.After(timeout):
   162				r.state.CloseServiceConnections(sl.service)
   163				<-done
   164			}
   165		} else {
   166			sl.wg.Wait()
   167		}
   168	}
