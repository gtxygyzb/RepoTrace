[?2004l     1	package router
     2	
     3	import (
     4		"io"
     5		"log"
     6		"net"
     7		"sync"
     8		"sync/atomic"
     9		"time"
    10	
    11		"meshrouter/internal/state"
    12	)
    13	
    14	type serviceListener struct {
    15		service  string
    16		port     int
    17		listener net.Listener
    18		stop     chan struct{}
    19		wg       sync.WaitGroup
    20		done     chan struct{}
    21	}
    22	
    23	type Router struct {
    24		state     *state.State
    25		mu        sync.Mutex
    26		listeners map[string]*serviceListener
    27	}
    28	
    29	func NewRouter(s *state.State) *Router {
    30		return &Router{
    31			state:     s,
    32			listeners: make(map[string]*serviceListener),
    33		}
    34	}
    35	
    36	func (r *Router) Start() {
    37		for _, ss := range r.state.Services() {
    38			if !ss.IsStopping() {
    39				r.startService(ss)
    40			}
    41		}
    42	}
    43	
    44	func (r *Router) Reload() {
    45		services := r.state.Services()
    46		seen := make(map[string]bool)
    47		for _, ss := range services {
    48			seen[ss.Name] = true
    49			r.mu.Lock()
    50			sl, ok := r.listeners[ss.Name]
    51			r.mu.Unlock()
    52			if !ok {
    53				if !ss.IsStopping() {
    54					r.startService(ss)
    55				}
    56				continue
    57			}
    58			if sl.port != ss.ListenPort {
    59				r.stopService(ss.Name, true)
    60				r.startService(ss)
    61			}
    62		}
    63		r.mu.Lock()
    64		for name := range r.listeners {
    65			if !seen[name] {
    66				r.mu.Unlock()
    67				r.stopService(name, true)
    68				r.mu.Lock()
    69			}
    70		}
    71		r.mu.Unlock()
    72	}
    73	
    74	func (r *Router) startService(ss *state.ServiceState) {
    75		addr := ":" + intToStr(ss.ListenPort)
    76		ln, err := net.Listen("tcp", addr)
    77		if err != nil {
    78			log.Printf("router: listen %s on %s failed: %v", ss.Name, addr, err)
    79			return
    80		}
    81		sl := &serviceListener{
    82			service:  ss.Name,
    83			port:     ss.ListenPort,
    84			listener: ln,
    85			stop:     make(chan struct{}),
    86			done:     make(chan struct{}),
    87		}
    88		r.mu.Lock()
    89		r.listeners[ss.Name] = sl
    90		r.mu.Unlock()
    91		go sl.acceptLoop(r)
    92	}
    93	
    94	func (r *Router) stopService(name string, drain bool) {
    95		r.mu.Lock()
    96		sl, ok := r.listeners[name]
    97		if ok {
    98			delete(r.listeners, name)
    99		}
   100		r.mu.Unlock()
   101		if !ok {
   102			return
   103		}
   104		sl.stopAccept(drain, r)
   105	}
   106	
   107	func (r *Router) Stop() {
   108		r.mu.Lock()
   109		listeners := r.listeners
   110		r.listeners = make(map[string]*serviceListener)
   111		r.mu.Unlock()
   112		var wg sync.WaitGroup
   113		for name, sl := range listeners {
   114			wg.Add(1)
   115			go func(name string, sl *serviceListener) {
   116				defer wg.Done()
   117				sl.stopAccept(true, r)
   118			}(name, sl)
   119		}
   120		wg.Wait()
   121	}
   122	
   123	func (sl *serviceListener) acceptLoop(r *Router) {
   124		defer close(sl.done)
   125		for {
   126			conn, err := sl.listener.Accept()
   127			if err != nil {
   128				return
   129			}
   130			sl.wg.Add(1)
   131			go func(c net.Conn) {
   132				defer sl.wg.Done()
   133				r.handleConn(sl.service, c)
   134			}(conn)
   135		}
   136	}
   137	
   138	func (sl *serviceListener) stopAccept(drain bool, r *Router) {
   139		select {
   140		case <-sl.stop:
   141		default:
   142			close(sl.stop)
   143		}
   144		sl.listener.Close()
   145		<-sl.done
   146		if drain {
   147			ss := r.state.GetService(sl.service)
   148			timeout := 5 * time.Second
   149			if ss != nil {
   150				timeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond
   151				if timeout <= 0 {
   152					timeout = 5 * time.Second
   153				}
   154			}
   155			done := make(chan struct{})
   156			go func() {
   157				sl.wg.Wait()
   158				close(done)
   159			}()
   160			select {
   161			case <-done:
   162			case <-time.After(timeout):
   163				r.state.CloseServiceConnections(sl.service)
   164				<-done
   165			}
   166		} else {
   167			sl.wg.Wait()
   168		}
   169	}
   170	
   171	func (r *Router) handleConn(service string, client net.Conn) {
   172		start := time.Now()
   173		ss := r.state.GetService(service)
   174		if ss == nil {
   175			client.Close()
   176			return
   177		}
   178	
   179		allowed, queued := ss.AcquireRateLimitToken()
   180		if !allowed {
   181			if queued {
   182				if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   183					cand.Stats.RecordQueueTimeout()
   184				}
   185			} else {
   186				if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   187					cand.Stats.RecordRateLimited()
   188				}
   189			}
   190			client.Close()
   191			return
   192		}
   193		if queued {
   194			if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   195				cand.Stats.RecordQueued()
   196			}
   197		}
   198	
   199		maxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()
   200		var lastEndpoint *state.EndpointState
   201		for attempt := 0; ; attempt++ {
   202			res, err := r.state.SelectEndpointExcluding(service, lastEndpoint)
   203			if err != nil {
   204				if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   205					ss := r.state.GetService(service)
   206					if ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {
   207						cand.Stats.RecordRejection()
   208					}
   209				}
   210				client.Close()
   211				return
   212			}
   213			lastEndpoint = res.Endpoint
   214			ep := res.Endpoint
   215	
   216			var id int64
   217			if !res.Probe {
   218				var ok bool
   219				id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)
   220				if !ok {
   221					ep.Stats.RecordRejection()
   222					client.Close()
   223					return
   224				}
   225			}
   226	
   227			backend, derr := net.Dial("tcp", ep.Address)
   228			if derr != nil {
   229				if id != 0 {
   230					ep.RemoveConnection(id)
   231				}
   232				ep.Stats.RecordConnection(0, 0, time.Since(start), true)
   233				if res.Probe {
   234					ep.Circuit.ProbeFailure()
   235				} else {
   236					ep.Circuit.Open()
   237				}
   238				if attempt >= maxRetries {
   239					client.Close()
   240					return
   241				}
   242				ep.Stats.RecordRetry()
   243				r.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)
   244				continue
   245			}
   246	
   247			if res.Probe {
   248				ep.Circuit.ProbeSuccess()
   249				var ok bool
   250				id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)
   251				if !ok {
   252					ep.Stats.RecordRejection()
   253					backend.Close()
   254					client.Close()
   255					return
   256				}
   257			}
   258	
   259			if attempt > 0 {
   260				ep.Stats.RecordRetrySuccess()
   261			}
   262			bytesIn, bytesOut, idleClosed := forward(client, backend, ep, id, ss.IdleTimeout())
   263			backend.Close()
   264			client.Close()
   265			ep.RemoveConnection(id)
   266			ep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)
   267			if idleClosed {
   268				ep.Stats.RecordIdleTimeout()
   269			}
   270			return
   271		}
   272	}
   273	
   274	func (r *Router) sleepRetry(attempt, delayMs int, multiplier float64, maxDelayMs int) {
   275		if attempt < 0 {
   276			attempt = 0
   277		}
   278		delay := float64(delayMs) * pow(multiplier, float64(attempt))
   279		if maxDelayMs > 0 && delay > float64(maxDelayMs) {
   280			delay = float64(maxDelayMs)
   281		}
   282		if delay > 0 {
   283			time.Sleep(time.Duration(delay) * time.Millisecond)
   284		}
   285	}
   286	
   287	func pow(base, exp float64) float64 {
   288		result := 1.0
   289		for i := 0; i < int(exp); i++ {
   290			result *= base
   291		}
   292		return result
   293	}
   294	
   295	func forward(client, backend net.Conn, ep *state.EndpointState, id int64, idleTimeoutMs int) (int64, int64, bool) {
   296		var bytesIn, bytesOut int64
   297		var idleClosed int32
   298		var closeOnce sync.Once
   299		var wg sync.WaitGroup
   300		done := make(chan struct{})
   301		closeConns := func() {
   302			client.Close()
   303			backend.Close()
   304		}
   305	
   306		wg.Add(2)
   307		go func() {
   308			defer wg.Done()
   309			n, _ := copyConn(backend, client, ep, id, "out")
   310			bytesOut = n
   311			closeOnce.Do(closeConns)
   312		}()
   313		go func() {
   314			defer wg.Done()
   315			n, _ := copyConn(client, backend, ep, id, "in")
   316			bytesIn = n
   317			closeOnce.Do(closeConns)
   318		}()
   319	
   320		if idleTimeoutMs > 0 {
   321			go func() {
   322				ticker := time.NewTicker(time.Duration(idleTimeoutMs) * time.Millisecond)
   323				defer ticker.Stop()
   324				for {
   325					select {
   326					case <-ticker.C:
   327						if ep.ConnectionIdleMs(id) >= int64(idleTimeoutMs) {
   328							atomic.StoreInt32(&idleClosed, 1)
   329							closeOnce.Do(closeConns)
   330							return
   331						}
   332					case <-done:
   333						return
   334					}
   335				}
   336			}()
   337		}
   338	
   339		wg.Wait()
   340		close(done)
   341		return bytesIn, bytesOut, atomic.LoadInt32(&idleClosed) == 1
   342	}
   343	
   344	func copyConn(dst io.Writer, src io.Reader, ep *state.EndpointState, id int64, direction string) (int64, error) {
   345		buf := make([]byte, 32*1024)
   346		var total int64
   347		for {
   348			n, err := src.Read(buf)
   349			if n > 0 {
   350				if _, werr := dst.Write(buf[:n]); werr != nil {
   351					return total, werr
   352				}
   353				total += int64(n)
   354				if direction == "in" {
   355					ep.UpdateConnectionActivity(id, int64(n), 0)
   356				} else {
   357					ep.UpdateConnectionActivity(id, 0, int64(n))
   358				}
   359			}
   360			if err != nil {
   361				return total, err
   362			}
   363		}
   364	}
   365	
   366	func intToStr(i int) string {
   367		if i == 0 {
   368			return "0"
   369		}
   370		var buf [12]byte
   371		pos := len(buf)
   372		neg := false
   373		if i < 0 {
   374			neg = true
   375			i = -i
   376		}
   377		for i > 0 {
   378			pos--
   379			buf[pos] = byte('0' + i%10)
   380			i /= 10
   381		}
   382		if neg {
   383			pos--
   384			buf[pos] = '-'
   385		}
   386		return string(buf[pos:])
   387	}
