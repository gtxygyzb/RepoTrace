   305	func prettyData(ipcCmd string, data json.RawMessage) (string, error) {
   306		switch ipcCmd {
   307		case "list_services":
   308			var services []struct {
   309				Name        string `json:"name"`
   310				ListenPort  int    `json:"listen_port"`
   311				RoutingMode string `json:"routing_mode"`
   312				Endpoints   []struct {
   313					Address           string `json:"address"`
   314					State             string `json:"state"`
   315					Weight            int    `json:"weight"`
   316					ActiveConnections int    `json:"active_connections"`
   317					CircuitState      string `json:"circuit_state"`
   318				} `json:"endpoints"`
   319			}
   320			if err := json.Unmarshal(data, &services); err != nil {
   321				return "", err
   322			}
   323			var b strings.Builder
   324			fmt.Fprintf(&b, "%-14s %-18s %-10s %-7s %-11s %-7s\n", "SERVICE", "ENDPOINT", "STATE", "WEIGHT", "CIRCUIT", "ACTIVE")
   325			for _, svc := range services {
   326				for _, ep := range svc.Endpoints {
   327					fmt.Fprintf(&b, "%-14s %-18s %-10s %-7d %-11s %-7d\n", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)
   328				}
   329			}
   330			return strings.TrimRight(b.String(), "\n"), nil
   331		case "resolve":
   332			var addr string
   333			if err := json.Unmarshal(data, &addr); err != nil {
   334				return "", err
   335			}
   336			return addr, nil
   337		case "get_circuit_breakers":
   338			var circuits []struct {
   339				Address             string `json:"address"`
   340				CircuitState        string `json:"circuit_state"`
   341				ConsecutiveFailures int    `json:"consecutive_failures"`
   342				TimeInStateMs       int64  `json:"time_in_state_ms"`
   343				ProbeActive         bool   `json:"probe_active"`
   344			}
   345			if err := json.Unmarshal(data, &circuits); err != nil {
   346				return "", err
   347			}
   348			var b strings.Builder
   349			fmt.Fprintf(&b, "%-18s %-11s %-9s %-17s %-7s\n", "ENDPOINT", "CIRCUIT", "FAILURES", "TIME_IN_STATE_MS", "PROBE")
   350			for _, c := range circuits {
   351				fmt.Fprintf(&b, "%-18s %-11s %-9d %-17d %-7t\n", c.Address, c.CircuitState, c.ConsecutiveFailures, c.TimeInStateMs, c.ProbeActive)
   352			}
   353			return strings.TrimRight(b.String(), "\n"), nil
   354		case "get_warmup_status":
   355			var resp struct {
   356				Endpoints []struct {
   357					Endpoint          string `json:"endpoint"`
   358					WarmingUp         bool   `json:"warming_up"`
   359					WarmupRemainingMs int    `json:"warmup_remaining_ms"`
   360					EffectiveWeight   int    `json:"effective_weight"`
   361					ConfigWeight      int    `json:"config_weight"`
   362				} `json:"endpoints"`
   363			}
   364			if err := json.Unmarshal(data, &resp); err != nil {
   365				return "", err
   366			}
   367			var b strings.Builder
   368			fmt.Fprintf(&b, "%-18s %-11s %-13s %-17s %-13s\n", "ENDPOINT", "WARMING_UP", "REMAINING_MS", "EFFECTIVE_WEIGHT", "CONFIG_WEIGHT")
   369			for _, e := range resp.Endpoints {
   370				fmt.Fprintf(&b, "%-18s %-11t %-13d %-17d %-13d\n", e.Endpoint, e.WarmingUp, e.WarmupRemainingMs, e.EffectiveWeight, e.ConfigWeight)
