   360	func forward(client, backend net.Conn, ep *state.EndpointState, id int64, idleTimeoutMs int, mirror net.Conn) (int64, int64, bool) {
   361		var bytesIn, bytesOut int64
   362		var idleClosed int32
   363		var closeOnce sync.Once
   364		var wg sync.WaitGroup
   365		done := make(chan struct{})
   366		closeConns := func() {
   367			client.Close()
   368			backend.Close()
   369			if mirror != nil {
   370				mirror.Close()
   371			}
   372		}
   373	
   374		if mirror != nil {
   375			wg.Add(1)
   376			go func() {
   377				defer wg.Done()
   378				io.Copy(io.Discard, mirror)
   379			}()
   380		}
   381		wg.Add(2)
   382		go func() {
   383			defer wg.Done()
   384			var n int64
   385			var err error
   386			if mirror != nil {
   387				n, err = copyTee(backend, mirror, client, ep, id, "out")
   388			} else {
   389				n, err = copyConn(backend, client, ep, id, "out")
   390			}
   391			bytesOut = n
   392			_ = err
   393			closeOnce.Do(closeConns)
   394		}()
   395		go func() {
   396			defer wg.Done()
   397			n, _ := copyConn(client, backend, ep, id, "in")
   398			bytesIn = n
   399			closeOnce.Do(closeConns)
   400		}()
   401	
   402		if idleTimeoutMs > 0 {
   403			go func() {
   404				ticker := time.NewTicker(time.Duration(idleTimeoutMs) * time.Millisecond)
   405				defer ticker.Stop()
   406				for {
   407					select {
   408					case <-ticker.C:
   409						if ep.ConnectionIdleMs(id) >= int64(idleTimeoutMs) {
   410							atomic.StoreInt32(&idleClosed, 1)
   411							closeOnce.Do(closeConns)
   412							return
   413						}
   414					case <-done:
   415						return
   416					}
   417				}
   418			}()
   419		}
   420	
   421		wg.Wait()
   422		close(done)
   423		return bytesIn, bytesOut, atomic.LoadInt32(&idleClosed) == 1
   424	}
