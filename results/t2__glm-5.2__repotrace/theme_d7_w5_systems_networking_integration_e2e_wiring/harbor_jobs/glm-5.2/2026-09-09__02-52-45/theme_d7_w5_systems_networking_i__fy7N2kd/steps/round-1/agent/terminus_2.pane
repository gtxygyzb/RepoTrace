     6	
     7	// Global holds mesh-wide tuning parameters.
     8	type Global struct {
     9		HealthIntervalMs        int `toml:"health_interval_ms"`
    10		UnhealthyThreshold      int `toml:"unhealthy_threshold"`
    11		HealthyThreshold        int `toml:"healthy_threshold"`
    12		StatsWindowSec          int `toml:"stats_window_sec"`
    13		CircuitBreakerThreshold int `toml:"circuit_breaker_threshold"`
    14		CircuitBreakerTimeoutMs int `toml:"circuit_breaker_timeout_ms"`
    15	}
    16	
    17	// Endpoint describes one backend endpoint from config.
    18	type Endpoint struct {
    19		Address     string `toml:"address"`
    20		Weight      int    `toml:"weight"`
    21		HealthCheck string `toml:"health_check"`
    22		HealthPath  string `toml:"health_path"`
    23		HealthCmd   string `toml:"health_cmd"`
    24	}
    25	
    26	// Service describes one routed service from config.
    27	type Service struct {
    28		Name                      string     `toml:"name"`
    29		ListenPort                int        `toml:"listen_port"`
    30		RoutingMode               string     `toml:"routing_mode"`
    31		DrainTimeoutMs            int        `toml:"drain_timeout_ms"`
    32		MaxConnectionsPerEndpoint int        `toml:"max_connections_per_endpoint"`
    33		RateLimitRps              int        `toml:"rate_limit_rps"`
    34		RateLimitBurst            int        `toml:"rate_limit_burst"`
    35		RateLimitQueueDepth       int        `toml:"rate_limit_queue_depth"`
    36		RateLimitQueueTimeoutMs   int        `toml:"rate_limit_queue_timeout_ms"`
    37		MaxRetries                int        `toml:"max_retries"`
    38		RetryDelayMs              int        `toml:"retry_delay_ms"`
    39		RetryBackoffMultiplier    float64    `toml:"retry_backoff_multiplier"`
    40		RetryMaxDelayMs           int        `toml:"retry_max_delay_ms"`
    41		Endpoints                 []Endpoint `toml:"endpoint"`
    42	}
    43	
    44	// Config is the parsed application configuration.
    45	type Config struct {
    46		Global   Global
    47		Services []Service `toml:"service"`
    48	}
    49	
    50	// Load reads and normalizes a TOML config file.
    51	func Load(path string) (*Config, error) {
    52		var cfg Config
    53		if _, err := toml.DecodeFile(path, &cfg); err != nil {
    54			return nil, err
    55		}
    56		if cfg.Global.HealthIntervalMs <= 0 {
    57			cfg.Global.HealthIntervalMs = 2000
    58		}
    59		if cfg.Global.UnhealthyThreshold <= 0 {
    60			cfg.Global.UnhealthyThreshold = 3
    61		}
    62		if cfg.Global.HealthyThreshold <= 0 {
    63			cfg.Global.HealthyThreshold = 2
    64		}
    65		if cfg.Global.StatsWindowSec <= 0 {
    66			cfg.Global.StatsWindowSec = 60
    67		}
    68		if cfg.Global.CircuitBreakerThreshold <= 0 {
    69			cfg.Global.CircuitBreakerThreshold = 3
    70		}
    71		if cfg.Global.CircuitBreakerTimeoutMs <= 0 {
    72			cfg.Global.CircuitBreakerTimeoutMs = 5000
    73		}
    74		for i := range cfg.Services {
    75			s := &cfg.Services[i]
    76			if s.RoutingMode == "" {
    77				s.RoutingMode = "weighted-round-robin"
    78			}
    79			if s.DrainTimeoutMs <= 0 {
    80				s.DrainTimeoutMs = 5000
    81			}
    82			if s.MaxConnectionsPerEndpoint <= 0 {
    83				s.MaxConnectionsPerEndpoint = 100
    84			}
    85			if s.RateLimitBurst <= 0 {
    86				s.RateLimitBurst = s.RateLimitRps
    87			}
    88			if s.RateLimitQueueTimeoutMs <= 0 {
    89				s.RateLimitQueueTimeoutMs = 1000
    90			}
    91			if s.RetryDelayMs <= 0 {
    92				s.RetryDelayMs = 100
    93			}
    94			if s.RetryBackoffMultiplier <= 0 {
    95				s.RetryBackoffMultiplier = 2.0
    96			}
    97			if s.RetryMaxDelayMs <= 0 {
    98				s.RetryMaxDelayMs = 5000
    99			}
   100			for j := range s.Endpoints {
   101				ep := &s.Endpoints[j]
   102				if ep.HealthCheck == "" {
   103					ep.HealthCheck = "tcp"
   104				}
   105				if ep.Weight < 0 {
   106					ep.Weight = 0
   107				}
   108			}
   109		}
   110		return &cfg, nil
   111	}
