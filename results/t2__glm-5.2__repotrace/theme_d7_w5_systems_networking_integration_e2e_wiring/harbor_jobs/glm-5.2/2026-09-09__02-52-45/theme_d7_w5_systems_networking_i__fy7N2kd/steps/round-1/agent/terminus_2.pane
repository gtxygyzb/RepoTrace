[?2004l[?2004h> \t\t\t\tep.UpdateConnectionActivity(id, 0, int64(n))
[?2004l[?2004h> \t\t\t}
[?2004l[?2004h> \t\t}
[?2004l[?2004h> \t\tif err != nil {
