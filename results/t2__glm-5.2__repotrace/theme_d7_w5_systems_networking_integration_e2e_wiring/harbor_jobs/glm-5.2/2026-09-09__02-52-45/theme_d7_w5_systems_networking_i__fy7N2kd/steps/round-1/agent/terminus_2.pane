   317	func (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {
   318		ep.mu.Lock()
   319		defer ep.mu.Unlock()
   320		ep.State = Draining
   321		ep.consecSuccess = 0
   322		ep.consecFailures = 0
   323		ep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)
   324		if markRemoved {
   325			ep.removed = true
   326		}
   327		if len(ep.connections) > 0 {
   328			go func(deadline time.Time, conns map[int64]net.Conn) {
   329				time.Sleep(time.Until(deadline))
   330				ep.closeConnectionsLocked()
   331			}(ep.drainDeadline, ep.connections)
   332		}
   333	}
