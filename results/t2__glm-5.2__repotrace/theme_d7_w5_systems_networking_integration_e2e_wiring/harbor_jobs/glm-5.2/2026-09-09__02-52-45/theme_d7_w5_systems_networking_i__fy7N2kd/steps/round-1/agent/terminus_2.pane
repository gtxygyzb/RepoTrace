   177	func (r *Router) handleConn(service string, client net.Conn) {
   178		start := time.Now()
   179		clientAddr := ""
   180		if addr := client.RemoteAddr(); addr != nil {
   181			clientAddr = addr.String()
   182		}
   183	
   184		var endpoint string
   185		var bytesIn, bytesOut int64
   186		var result string
   187		var retryCount int
   188		var queueWaitMs *int64
   189		var failedDependency string
   190		defer func() {
   191			if result == "" {
   192				result = "success"
   193			}
   194			if r.accessLog != nil {
   195				r.accessLog.Log(accesslog.Entry{
   196					Service:          service,
   197					Client:           clientAddr,
   198					Endpoint:         endpoint,
   199					BytesIn:          bytesIn,
   200					BytesOut:         bytesOut,
   201					DurationMs:       time.Since(start).Milliseconds(),
   202					Result:           result,
   203					Retried:          retryCount > 0,
   204					RetryCount:       retryCount,
   205					QueueWaitMs:      queueWaitMs,
   206					FailedDependency: failedDependency,
   207				})
   208			}
   209		}()
   210	
   211		ss := r.state.GetService(service)
   212		if ss == nil {
   213			result = "rejected_no_endpoint"
   214			client.Close()
   215			return
   216		}
   217	
   218		if failedDep, _ := r.state.CheckDependencies(service); failedDep != "" {
   219			result = "rejected_dependency"
   220			failedDependency = failedDep
   221			ss.Stats.RecordDependencyRejection()
   222			client.Close()
   223			return
   224		}
   225	
   226		allowed, queued, waitMs, _ := ss.AcquireRateLimitToken()
   227		if !allowed {
   228			result = "rejected_rate_limit"
   229			queueWaitMs = &waitMs
   230			client.Close()
   231			return
   232		}
   233		if queued {
   234			if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   235				cand.Stats.RecordQueued()
   236			}
   237		}
   238	
   239		maxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()
   240		var lastEndpoint *state.EndpointState
   241		for attempt := 0; ; attempt++ {
   242			res, err := r.state.SelectEndpointExcluding(service, lastEndpoint)
   243			if err != nil {
   244				result = "rejected_no_endpoint"
   245				endpoint = ""
   246				if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   247					ss := r.state.GetService(service)
   248					if ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {
   249						cand.Stats.RecordRejection()
   250					}
   251				}
   252				client.Close()
   253				return
   254			}
   255			lastEndpoint = res.Endpoint
   256			ep := res.Endpoint
   257			endpoint = ep.Address
   258	
   259			var id int64
   260			if !res.Probe {
   261				var ok bool
   262				id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)
   263				if !ok {
   264					result = "rejected_conn_limit"
   265					ep.Stats.RecordRejection()
   266					client.Close()
   267					return
   268				}
   269			}
   270	
   271			backend, derr := net.Dial("tcp", ep.Address)
   272			if derr != nil {
   273				if id != 0 {
   274					ep.RemoveConnection(id)
   275				}
   276				ep.Stats.RecordConnection(0, 0, time.Since(start), true)
   277				if res.Probe {
   278					ep.Circuit.ProbeFailure()
   279				} else {
   280					ep.Circuit.Open()
   281				}
   282				if attempt >= maxRetries {
   283					result = "retry_exhausted"
   284					client.Close()
   285					return
   286				}
   287				retryCount++
   288				ep.Stats.RecordRetry()
   289				r.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)
   290				continue
   291			}
   292	
   293			if res.Probe {
   294				ep.Circuit.ProbeSuccess()
   295				var ok bool
   296				id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)
   297				if !ok {
   298					result = "rejected_conn_limit"
   299					ep.Stats.RecordRejection()
   300					backend.Close()
   301					client.Close()
   302					return
   303				}
   304			}
   305	
   306			if attempt > 0 {
   307				ep.Stats.RecordRetrySuccess()
   308			}
   309			bytesIn, bytesOut, idleClosed := forward(client, backend, ep, id, ss.IdleTimeout())
   310			backend.Close()
   311			client.Close()
   312			ep.RemoveConnection(id)
   313			ep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)
   314			if idleClosed {
   315				result = "idle_timeout"
   316				ep.Stats.RecordIdleTimeout()
   317			} else {
   318				result = "success"
   319			}
   320			return
