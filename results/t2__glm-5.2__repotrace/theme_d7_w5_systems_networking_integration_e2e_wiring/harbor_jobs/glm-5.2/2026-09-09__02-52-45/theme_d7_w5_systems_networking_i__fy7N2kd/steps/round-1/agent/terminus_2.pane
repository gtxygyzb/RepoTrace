[?2004l     1	package accesslog
     2	
     3	import (
     4		"encoding/json"
     5		"os"
     6		"path/filepath"
     7		"sync"
     8		"sync/atomic"
     9		"time"
    10	)
    11	
    12	// Entry is one structured access log record.
    13	type Entry struct {
    14		Ts               string `json:"ts"`
    15		Service          string `json:"service"`
    16		Client           string `json:"client"`
    17		Endpoint         string `json:"endpoint"`
    18		BytesIn          int64  `json:"bytes_in"`
    19		BytesOut         int64  `json:"bytes_out"`
    20		DurationMs       int64  `json:"duration_ms"`
    21		Result           string `json:"result"`
    22		Retried          bool   `json:"retried"`
    23		RetryCount       int    `json:"retry_count"`
    24		QueueWaitMs      *int64 `json:"queue_wait_ms,omitempty"`
    25		FailedDependency string `json:"failed_dependency,omitempty"`
    26	}
    27	
    28	// DefaultPath is the access log path required by meshrouter.
    29	const DefaultPath = "/app/logs/access.log"
    30	
    31	const maxFileSize = 1 << 20 // 1 MB
    32	
    33	// Logger writes access log entries asynchronously to a JSON-lines file.
    34	type Logger struct {
    35		path     string
    36		ch       chan Entry
    37		stop     chan struct{}
    38		done     chan struct{}
    39		stopped  int32
    40		stopOnce sync.Once
    41		mu       sync.Mutex
    42		file     *os.File
    43		size     int64
    44	}
    45	
    46	// New creates a Logger for path and starts its writer goroutine.
    47	func New(path string) *Logger {
    48		if path == "" {
    49			path = DefaultPath
    50		}
    51		l := &Logger{
    52			path: path,
    53			ch:   make(chan Entry, 8192),
    54			stop: make(chan struct{}),
    55			done: make(chan struct{}),
    56		}
    57		go l.run()
    58		return l
    59	}
    60	
    61	// Path returns the configured log file path.
    62	func (l *Logger) Path() string {
    63		return l.path
    64	}
    65	
    66	// Log queues an entry for asynchronous writing. If the buffered channel is full,
    67	// the entry is written synchronously to avoid losing it.
    68	func (l *Logger) Log(entry Entry) {
    69		if atomic.LoadInt32(&l.stopped) != 0 {
    70			return
    71		}
    72		entry.Ts = time.Now().UTC().Format(time.RFC3339Nano)
    73		select {
    74		case l.ch <- entry:
    75		default:
    76			l.writeLine(entry)
    77		}
    78	}
    79	
    80	// Stop flushes all buffered entries and closes the log file.
    81	func (l *Logger) Stop() {
    82		l.stopOnce.Do(func() {
    83			atomic.StoreInt32(&l.stopped, 1)
    84			close(l.stop)
    85			<-l.done
    86			l.mu.Lock()
    87			if l.file != nil {
    88				l.file.Close()
    89				l.file = nil
    90			}
    91			l.mu.Unlock()
    92		})
    93	}
    94	
    95	func (l *Logger) run() {
    96		for {
    97			select {
    98			case e := <-l.ch:
    99				l.writeLine(e)
   100			case <-l.stop:
   101				l.drain()
   102				close(l.done)
   103				return
   104			}
   105		}
   106	}
   107	
   108	func (l *Logger) drain() {
   109		for {
   110			select {
   111			case e := <-l.ch:
   112				l.writeLine(e)
   113			default:
   114				return
   115			}
   116		}
   117	}
   118	
   119	func (l *Logger) writeLine(e Entry) {
   120		b, err := json.Marshal(e)
   121		if err != nil {
   122			return
   123		}
   124		b = append(b, '\n')
   125	
   126		l.mu.Lock()
   127		defer l.mu.Unlock()
   128	
   129		if l.file == nil {
   130			if err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {
   131				return
   132			}
   133			f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
   134			if err != nil {
   135				return
   136			}
   137			l.file = f
   138			if info, err := f.Stat(); err == nil {
   139				l.size = info.Size()
   140			}
   141		}
   142	
   143		if l.size > 0 && l.size+int64(len(b)) > maxFileSize {
   144			l.rotateLocked()
   145		}
   146	
   147		n, err := l.file.Write(b)
   148		if err != nil {
   149			l.size = 0
   150			if l.file != nil {
   151				l.file.Close()
   152				l.file = nil
   153			}
   154			return
   155		}
   156		l.size += int64(n)
   157	}
   158	
   159	func (l *Logger) rotateLocked() {
   160		if l.file != nil {
   161			l.file.Close()
   162			l.file = nil
   163		}
   164		os.Remove(l.path + ".1")
   165		if err := os.Rename(l.path, l.path+".1"); err != nil {
   166			f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
   167			if err == nil {
   168				l.file = f
   169				if info, err := f.Stat(); err == nil {
   170					l.size = info.Size()
   171				}
   172			}
   173			return
   174		}
   175		f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
   176		if err != nil {
   177			l.size = 0
   178			return
   179		}
   180		l.file = f
   181		l.size = 0
   182	}
