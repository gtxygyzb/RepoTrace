    28	
    29	type Server struct {
    30		state    *state.State
    31		path     string
    32		listener net.Listener
    33		wg       sync.WaitGroup
    34		stop     chan struct{}
    35		done     chan struct{}
    36	}
    37	
    38	func NewServer(s *state.State, path string) *Server {
    39		return &Server{
    40			state: s,
    41			path:  path,
    42			stop:  make(chan struct{}),
    43			done:  make(chan struct{}),
    44		}
    45	}
    46	
    47	func (s *Server) Start() error {
    48		os.Remove(s.path)
    49		ln, err := net.Listen("unix", s.path)
    50		if err != nil {
    51			return err
    52		}
    53		s.listener = ln
    54		go s.acceptLoop()
    55		return nil
    56	}
    57	
    58	func (s *Server) Stop() {
    59		select {
    60		case <-s.stop:
    61		default:
    62			close(s.stop)
    63		}
    64		if s.listener != nil {
    65			s.listener.Close()
    66		}
