[?2004l     1	package state
     2	
     3	import (
     4		"net"
     5		"sort"
     6		"sync"
     7		"sync/atomic"
     8		"time"
     9	
    10		"meshrouter/internal/circuit"
    11		"meshrouter/internal/config"
    12		"meshrouter/internal/stats"
    13	)
    14	
    15	type HealthState string
    16	
    17	const (
    18		Unknown   HealthState = "unknown"
    19		Healthy   HealthState = "healthy"
    20		Unhealthy HealthState = "unhealthy"
    21		Draining  HealthState = "draining"
    22	)
    23	
    24	type HealthEvent struct {
    25		Timestamp   time.Time
    26		Endpoint    string
    27		OldState    HealthState
    28		NewState    HealthState
    29		CheckResult string
    30	}
    31	
    32	type EndpointState struct {
    33		mu                sync.Mutex
    34		Address           string
    35		Weight            int
    36		Config            config.Endpoint
    37		State             HealthState
    38		ActiveConnections int
    39		Circuit           *circuit.Breaker
    40		Stats             *stats.Collector
    41		consecSuccess     int
    42		consecFailures    int
    43		drainDeadline     time.Time
    44		removed           bool
    45		connIDCounter     int64
    46		currentWeight     int
    47		connections       map[int64]*connectionInfo
    48	}
    49	
    50	type connectionInfo struct {
    51		conn         net.Conn
    52		clientAddr   string
    53		start        time.Time
    54		lastActivity time.Time
    55		bytesIn      int64
    56		bytesOut     int64
    57	}
    58	
    59	type ServiceState struct {
    60		mu                        sync.Mutex
    61		Name                      string
    62		ListenPort                int
    63		RoutingMode               string
    64		DrainTimeoutMs            int
    65		MaxConnectionsPerEndpoint int
    66		IdleTimeoutMs             int
    67		RateLimitRps              int
    68		RateLimitBurst            int
    69		RateLimitQueueDepth       int
    70		RateLimitQueueTimeoutMs   int
    71		MaxRetries                int
    72		RetryDelayMs              int
    73		RetryBackoffMultiplier    float64
    74		RetryMaxDelayMs           int
    75		rateLimiter               *rateLimiter
    76		Endpoints                 []*EndpointState
    77		rrIndex                   int
    78		Listener                  net.Listener
    79		listenerStop              chan struct{}
    80		stopping                  bool
    81	}
    82	
    83	type State struct {
    84		mu         sync.RWMutex
    85		configPath string
    86		global     config.Global
    87		services   map[string]*ServiceState
    88		logMu      sync.Mutex
    89		healthLog  map[string][]HealthEvent
    90		reloadCh   chan struct{}
    91	}
    92	
    93	func NewState(cfg *config.Config, path string) *State {
    94		s := &State{
    95			configPath: path,
    96			services:   make(map[string]*ServiceState),
    97			healthLog:  make(map[string][]HealthEvent),
    98			reloadCh:   make(chan struct{}, 1),
    99		}
   100		s.applyConfigLocked(cfg)
   101		return s
   102	}
   103	
   104	func (s *State) ReloadChan() <-chan struct{} {
   105		return s.reloadCh
   106	}
   107	
   108	func (s *State) ConfigPath() string {
   109		s.mu.RLock()
   110		defer s.mu.RUnlock()
   111		return s.configPath
   112	}
   113	
   114	func (s *State) Global() config.Global {
   115		s.mu.RLock()
   116		defer s.mu.RUnlock()
   117		return s.global
   118	}
   119	
   120	func (s *State) ApplyConfig(cfg *config.Config) {
   121		s.mu.Lock()
   122		defer s.mu.Unlock()
   123		s.applyConfigLocked(cfg)
   124		select {
   125		case s.reloadCh <- struct{}{}:
   126		default:
   127		}
   128	}
   129	
   130	func (s *State) applyConfigLocked(cfg *config.Config) {
   131		s.global = cfg.Global
   132		seen := make(map[string]bool)
   133		for _, svc := range cfg.Services {
   134			seen[svc.Name] = true
   135			ss := s.services[svc.Name]
   136			if ss == nil {
   137				ss = newServiceState(svc, cfg.Global)
   138				s.services[svc.Name] = ss
   139			} else {
   140				ss.mu.Lock()
   141				ss.Name = svc.Name
   142				ss.ListenPort = svc.ListenPort
   143				ss.RoutingMode = svc.RoutingMode
   144				ss.DrainTimeoutMs = svc.DrainTimeoutMs
   145				ss.RateLimitRps = svc.RateLimitRps
   146				ss.RateLimitBurst = svc.RateLimitBurst
   147				ss.RateLimitQueueDepth = svc.RateLimitQueueDepth
   148				ss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs
   149				ss.MaxRetries = svc.MaxRetries
   150				ss.RetryDelayMs = svc.RetryDelayMs
   151				ss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier
   152				ss.RetryMaxDelayMs = svc.RetryMaxDelayMs
   153				if ss.rateLimiter == nil {
   154					ss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   155				} else {
   156					ss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   157				}
   158				ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint
   159				ss.IdleTimeoutMs = svc.IdleTimeoutMs
   160				ss.mu.Unlock()
   161				ss.applyEndpoints(svc.Endpoints, cfg.Global)
   162			}
   163		}
   164		for name, ss := range s.services {
   165			if !seen[name] {
   166				ss.mu.Lock()
   167				ss.stopping = true
   168				if ss.listenerStop != nil {
   169					close(ss.listenerStop)
   170					ss.listenerStop = nil
   171				}
   172				if ss.Listener != nil {
   173					ss.Listener.Close()
   174					ss.Listener = nil
   175				}
   176				ss.mu.Unlock()
   177				for _, ep := range ss.Endpoints {
   178					ep.StartDraining(ss.DrainTimeoutMs, true)
   179				}
   180			}
   181		}
   182	}
   183	
   184	func newServiceState(svc config.Service, global config.Global) *ServiceState {
   185		ss := &ServiceState{
   186			Name:                      svc.Name,
   187			ListenPort:                svc.ListenPort,
   188			RoutingMode:               svc.RoutingMode,
   189			DrainTimeoutMs:            svc.DrainTimeoutMs,
   190			RateLimitRps:              svc.RateLimitRps,
   191			RateLimitBurst:            svc.RateLimitBurst,
   192			RateLimitQueueDepth:       svc.RateLimitQueueDepth,
   193			RateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,
   194			MaxRetries:                svc.MaxRetries,
   195			RetryDelayMs:              svc.RetryDelayMs,
   196			RetryBackoffMultiplier:    svc.RetryBackoffMultiplier,
   197			RetryMaxDelayMs:           svc.RetryMaxDelayMs,
   198			rateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),
   199			MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
   200			IdleTimeoutMs:             svc.IdleTimeoutMs,
   201			listenerStop:              nil,
   202		}
   203		for _, ep := range svc.Endpoints {
   204			ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))
   205		}
   206		return ss
   207	}
   208	
   209	func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {
   210		ss.mu.Lock()
   211		defer ss.mu.Unlock()
   212		seen := make(map[string]bool)
   213		for _, cep := range eps {
   214			seen[cep.Address] = true
   215			var ep *EndpointState
   216			for _, existing := range ss.Endpoints {
   217				if existing.Address == cep.Address {
   218					ep = existing
   219					break
   220				}
   221			}
   222			if ep == nil {
   223				ep = newEndpointState(cep, global)
   224				ss.Endpoints = append(ss.Endpoints, ep)
   225			} else {
   226				ep.mu.Lock()
   227				ep.Config = cep
   228				ep.Weight = cep.Weight
   229				ep.mu.Unlock()
   230			}
   231		}
   232		for _, ep := range ss.Endpoints {
   233			if !seen[ep.Address] {
   234				ep.StartDraining(ss.DrainTimeoutMs, true)
   235			}
   236		}
   237	}
   238	
   239	func newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {
   240		return &EndpointState{
