[?2004l     1	package accesslog
     2	
     3	import (
     4		"encoding/json"
     5		"os"
     6		"path/filepath"
     7		"sync"
     8		"sync/atomic"
     9		"time"
    10	)
    11	
    12	// Entry is one structured access log record.
    13	type Entry struct {
    14		Ts         string `json:"ts"`
    15		Service    string `json:"service"`
    16		Client     string `json:"client"`
    17		Endpoint   string `json:"endpoint"`
    18		BytesIn    int64  `json:"bytes_in"`
    19		BytesOut   int64  `json:"bytes_out"`
    20		DurationMs int64  `json:"duration_ms"`
    21		Result     string `json:"result"`
    22	}
    23	
    24	// DefaultPath is the access log path required by meshrouter.
    25	const DefaultPath = "/app/logs/access.log"
    26	
    27	const maxFileSize = 1 << 20 // 1 MB
    28	
    29	// Logger writes access log entries asynchronously to a JSON-lines file.
    30	type Logger struct {
    31		path     string
    32		ch       chan Entry
    33		stop     chan struct{}
    34		done     chan struct{}
    35		stopped  int32
    36		stopOnce sync.Once
    37		mu       sync.Mutex
    38		file     *os.File
    39		size     int64
    40	}
    41	
    42	// New creates a Logger for path and starts its writer goroutine.
    43	func New(path string) *Logger {
    44		if path == "" {
    45			path = DefaultPath
    46		}
    47		l := &Logger{
    48			path: path,
    49			ch:   make(chan Entry, 8192),
    50			stop: make(chan struct{}),
    51			done: make(chan struct{}),
    52		}
    53		go l.run()
    54		return l
    55	}
    56	
    57	// Path returns the configured log file path.
    58	func (l *Logger) Path() string {
    59		return l.path
    60	}
    61	
    62	// Log queues an entry for asynchronous writing. If the buffered channel is full,
    63	// the entry is written synchronously to avoid losing it.
    64	func (l *Logger) Log(entry Entry) {
    65		if atomic.LoadInt32(&l.stopped) != 0 {
    66			return
    67		}
    68		entry.Ts = time.Now().UTC().Format(time.RFC3339Nano)
    69		select {
    70		case l.ch <- entry:
    71		default:
    72			l.writeLine(entry)
    73		}
    74	}
    75	
    76	// Stop flushes all buffered entries and closes the log file.
    77	func (l *Logger) Stop() {
    78		l.stopOnce.Do(func() {
    79			atomic.StoreInt32(&l.stopped, 1)
    80			close(l.stop)
    81			<-l.done
    82			l.mu.Lock()
    83			if l.file != nil {
    84				l.file.Close()
    85				l.file = nil
    86			}
    87			l.mu.Unlock()
    88		})
    89	}
    90	
    91	func (l *Logger) run() {
    92		for {
    93			select {
    94			case e := <-l.ch:
    95				l.writeLine(e)
    96			case <-l.stop:
    97				l.drain()
    98				close(l.done)
    99				return
   100			}
   101		}
   102	}
   103	
   104	func (l *Logger) drain() {
   105		for {
   106			select {
   107			case e := <-l.ch:
   108				l.writeLine(e)
   109			default:
   110				return
   111			}
   112		}
   113	}
   114	
   115	func (l *Logger) writeLine(e Entry) {
   116		b, err := json.Marshal(e)
   117		if err != nil {
   118			return
   119		}
   120		b = append(b, '\n')
   121	
   122		l.mu.Lock()
   123		defer l.mu.Unlock()
   124	
   125		if l.file == nil {
   126			if err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {
   127				return
   128			}
   129			f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
   130			if err != nil {
   131				return
   132			}
   133			l.file = f
   134			if info, err := f.Stat(); err == nil {
   135				l.size = info.Size()
   136			}
   137		}
   138	
   139		if l.size > 0 && l.size+int64(len(b)) > maxFileSize {
   140			l.rotateLocked()
   141		}
   142	
   143		n, err := l.file.Write(b)
   144		if err != nil {
   145			l.size = 0
   146			if l.file != nil {
   147				l.file.Close()
   148				l.file = nil
   149			}
   150			return
   151		}
   152		l.size += int64(n)
   153	}
   154	
   155	func (l *Logger) rotateLocked() {
   156		if l.file != nil {
   157			l.file.Close()
   158			l.file = nil
   159		}
   160		os.Remove(l.path + ".1")
   161		if err := os.Rename(l.path, l.path+".1"); err != nil {
   162			f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
   163			if err == nil {
   164				l.file = f
   165				if info, err := f.Stat(); err == nil {
   166					l.size = info.Size()
   167				}
   168			}
   169			return
   170		}
   171		f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
   172		if err != nil {
   173			l.size = 0
   174			return
   175		}
   176		l.file = f
   177		l.size = 0
   178	}
[?2004hroot@n30009:/app# nl -ba internal/accesslog/query.go | sed -n '1,180p'
[?2004l     1	package accesslog
     2	
     3	import (
     4		"bufio"
     5		"encoding/json"
     6		"os"
     7	)
     8	
     9	// Stats holds aggregated access log statistics for one result type.
    10	type ResultStats struct {
    11		Count         int   `json:"count"`
    12		AvgDurationMs int64 `json:"avg_duration_ms"`
    13		TotalBytesIn  int64 `json:"total_bytes_in"`
    14		TotalBytesOut int64 `json:"total_bytes_out"`
    15	}
    16	
    17	// StatsResult is the response shape for get_access_stats.
    18	type StatsResult struct {
    19		TotalRequests int                    `json:"total_requests"`
    20		ByResult      map[string]ResultStats `json:"by_result"`
    21	}
    22	
    23	// ReadEntries reads and parses log entries from the backup file plus the
    24	// current log file, in chronological order. Invalid lines are skipped.
    25	func ReadEntries(path string) []Entry {
    26		var entries []Entry
    27		entries = append(entries, readLogFile(path+".1")...)
    28		entries = append(entries, readLogFile(path)...)
    29		return entries
    30	}
    31	
    32	func readLogFile(path string) []Entry {
    33		f, err := os.Open(path)
    34		if err != nil {
    35			return nil
    36		}
    37		defer f.Close()
    38	
    39		var entries []Entry
    40		scanner := bufio.NewScanner(f)
    41		scanner.Buffer(make([]byte, 1024*1024), 1024*1024)
    42		for scanner.Scan() {
    43			line := scanner.Bytes()
    44			if len(line) == 0 {
    45				continue
    46			}
    47			var e Entry
    48			if err := json.Unmarshal(line, &e); err != nil {
    49				continue
    50			}
    51			entries = append(entries, e)
    52		}
    53		return entries
    54	}
    55	
    56	// GetAccessLog returns filtered log entries. Filters are applied first, then the
    57	// last lastN entries are returned. If lastN is 0 or negative, all matching
    58	// entries are returned.
    59	func GetAccessLog(path, service, result string, lastN int, minDurationMs int64) []Entry {
    60		entries := ReadEntries(path)
    61	
    62		filtered := entries[:0]
    63		for _, e := range entries {
    64			if service != "" && e.Service != service {
    65				continue
    66			}
    67			if result != "" && e.Result != result {
    68				continue
    69			}
    70			if minDurationMs > 0 && e.DurationMs < minDurationMs {
    71				continue
    72			}
    73			filtered = append(filtered, e)
    74		}
    75	
    76		if lastN <= 0 {
    77			return filtered
    78		}
    79		if len(filtered) > lastN {
    80			return filtered[len(filtered)-lastN:]
    81		}
    82		return filtered
    83	}
    84	
    85	// Stats aggregates access log entries for the optional service filter.
    86	func Stats(path, service string) StatsResult {
    87		entries := ReadEntries(path)
    88	
    89		type agg struct {
    90			count    int
    91			duration int64
    92			bytesIn  int64
    93			bytesOut int64
    94		}
    95		aggs := make(map[string]*agg)
    96		total := 0
    97	
    98		for _, e := range entries {
    99			if service != "" && e.Service != service {
   100				continue
   101			}
   102			a := aggs[e.Result]
   103			if a == nil {
   104				a = &agg{}
   105				aggs[e.Result] = a
   106			}
   107			a.count++
   108			a.duration += e.DurationMs
   109			a.bytesIn += e.BytesIn
   110			a.bytesOut += e.BytesOut
   111			total++
   112		}
   113	
   114		result := StatsResult{
   115			TotalRequests: total,
   116			ByResult:      make(map[string]ResultStats),
   117		}
   118		for name, a := range aggs {
   119			if a.count == 0 {
   120				continue
   121			}
   122			result.ByResult[name] = ResultStats{
   123				Count:         a.count,
   124				AvgDurationMs: a.duration / int64(a.count),
   125				TotalBytesIn:  a.bytesIn,
   126				TotalBytesOut: a.bytesOut,
   127			}
   128		}
   129		return result
   130	}
