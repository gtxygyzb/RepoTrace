    32	
    33	func (s *State) ServicesView() []ServiceView {
    34		services := s.Services()
    35		out := make([]ServiceView, 0, len(services))
    36		for _, ss := range services {
    37			out = append(out, ss.View())
    38		}
    39		sort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })
    40		return out
    41	}
    42	
    43	func (ss *ServiceState) View() ServiceView {
    44		ss.mu.Lock()
    45		defer ss.mu.Unlock()
    46		sv := ServiceView{
    47			Name:        ss.Name,
    48			ListenPort:  ss.ListenPort,
    49			RoutingMode: ss.RoutingMode,
    50			Endpoints:   make([]EndpointView, 0, len(ss.Endpoints)),
    51		}
    52		for _, ep := range ss.Endpoints {
    53			ep.mu.Lock()
    54			sv.Endpoints = append(sv.Endpoints, EndpointView{
    55				Address:           ep.Address,
    56				State:             string(ep.State),
    57				Weight:            ep.Weight,
    58				ActiveConnections: ep.ActiveConnections,
    59				CircuitState:      string(ep.Circuit.State()),
    60			})
    61			ep.mu.Unlock()
    62		}
    63		return sv
    64	}
