[?2004l     1	package stats
     2	
     3	import (
     4		"sync"
     5		"time"
     6	)
     7	
     8	type entry struct {
     9		timestamp time.Time
    10		bytesIn   int64
    11		bytesOut  int64
    12		latency   time.Duration
    13		err       bool
    14	}
    15	
    16	// Collector keeps rolling connection statistics for one endpoint.
    17	type Collector struct {
    18		mu         sync.Mutex
    19		window     time.Duration
    20		entries    []entry
    21		rejections []time.Time
    22	}
    23	
    24	// New creates a collector with the given window length.
    25	func New(window time.Duration) *Collector {
    26		if window <= 0 {
    27			window = time.Minute
    28		}
    29		return &Collector{window: window}
    30	}
    31	
    32	// RecordConnection records a finished connection attempt.
    33	func (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {
    34		c.mu.Lock()
    35		defer c.mu.Unlock()
    36		now := time.Now()
    37		c.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})
    38		c.trim(now)
    39	}
    40	
    41	// RecordRejection records a rejected connection because the endpoint was at capacity.
    42	func (c *Collector) RecordRejection() {
    43		c.mu.Lock()
    44		defer c.mu.Unlock()
    45		now := time.Now()
    46		c.rejections = append(c.rejections, now)
    47		c.trim(now)
    48	}
    49	
    50	func (c *Collector) trim(now time.Time) {
    51		cutoff := now.Add(-c.window)
    52		i := 0
    53		for i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {
    54			i++
    55		}
    56		if i > 0 {
    57			c.entries = c.entries[i:]
    58		}
    59		j := 0
    60		for j < len(c.rejections) && c.rejections[j].Before(cutoff) {
    61			j++
    62		}
    63		if j > 0 {
    64			c.rejections = c.rejections[j:]
    65		}
    66	}
    67	
    68	// Snapshot returns current windowed stats. active is supplied by the state manager.
    69	func (c *Collector) Snapshot(active int) Snapshot {
    70		c.mu.Lock()
    71		defer c.mu.Unlock()
    72		now := time.Now()
    73		cutoff := now.Add(-c.window)
    74		var total int
    75		var bytesIn, bytesOut int64
    76		var latencySum time.Duration
    77		var errors int
    78		for _, e := range c.entries {
    79			if e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {
    80				total++
    81				bytesIn += e.bytesIn
    82				bytesOut += e.bytesOut
    83				latencySum += e.latency
    84				if e.err {
    85					errors++
    86				}
    87			}
    88		}
    89		rejected := 0
    90		for _, t := range c.rejections {
    91			if t.After(cutoff) || t.Equal(cutoff) {
    92				rejected++
    93			}
    94		}
    95		var avg float64
    96		if total > 0 {
    97			avg = float64(latencySum.Milliseconds()) / float64(total)
    98		}
    99		return Snapshot{
   100			TotalConnections:    total,
   101			ActiveConnections:   active,
   102			BytesIn:             bytesIn,
   103			BytesOut:            bytesOut,
   104			AvgLatencyMs:        avg,
   105			Errors:              errors,
   106			RejectedConnections: rejected,
   107		}
   108	}
   109	
   110	// Snapshot is a JSON-friendly stats view.
   111	type Snapshot struct {
   112		TotalConnections    int     `json:"total_connections"`
   113		ActiveConnections   int     `json:"active_connections"`
   114		BytesIn             int64   `json:"bytes_in"`
   115		BytesOut            int64   `json:"bytes_out"`
   116		AvgLatencyMs        float64 `json:"avg_latency_ms"`
   117		Errors              int     `json:"errors"`
   118		RejectedConnections int     `json:"rejected_connections"`
   119	}
