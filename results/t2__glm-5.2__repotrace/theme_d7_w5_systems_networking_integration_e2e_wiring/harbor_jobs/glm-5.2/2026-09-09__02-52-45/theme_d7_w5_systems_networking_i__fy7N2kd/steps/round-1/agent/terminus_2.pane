    15		Service          string `json:"service"`
    16		Client           string `json:"client"`
    17		Endpoint         string `json:"endpoint"`
    18		BytesIn          int64  `json:"bytes_in"`
    19		BytesOut         int64  `json:"bytes_out"`
    20		DurationMs       int64  `json:"duration_ms"`
    21		Result           string `json:"result"`
