   199			RetryDelayMs:              svc.RetryDelayMs,
   200			RetryBackoffMultiplier:    svc.RetryBackoffMultiplier,
   201			RetryMaxDelayMs:           svc.RetryMaxDelayMs,
   202			rateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),
   203			MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
   204			ConnectionLimitMode:       svc.ConnectionLimitMode,
   205			IdleTimeoutMs:             svc.IdleTimeoutMs,
