    10		"strconv"
    11		"strings"
    12		"sync"
    13	
    14		"meshrouter/internal/config"
    15		"meshrouter/internal/state"
    16	)
    17	
    18	type Request struct {
    19		Cmd  string          `json:"cmd"`
    20		Args json.RawMessage `json:"args"`
    21	}
    22	
    23	type Response struct {
    24		Status string      `json:"status"`
    25		Data   interface{} `json:"data"`
    26	}
    27	
    28	type Server struct {
    29		state    *state.State
    30		path     string
    31		listener net.Listener
    32		wg       sync.WaitGroup
    33		stop     chan struct{}
    34		done     chan struct{}
    35	}
    36	
    37	func NewServer(s *state.State, path string) *Server {
    38		return &Server{
    39			state: s,
    40			path:  path,
    41			stop:  make(chan struct{}),
    42			done:  make(chan struct{}),
    43		}
    44	}
    45	
    46	func (s *Server) Start() error {
    47		os.Remove(s.path)
    48		ln, err := net.Listen("unix", s.path)
    49		if err != nil {
    50			return err
    51		}
    52		s.listener = ln
    53		go s.acceptLoop()
    54		return nil
    55	}
    56	
    57	func (s *Server) Stop() {
    58		select {
    59		case <-s.stop:
    60		default:
    61			close(s.stop)
    62		}
    63		if s.listener != nil {
    64			s.listener.Close()
    65		}
    66		<-s.done
    67		os.Remove(s.path)
    68	}
    69	
    70	func (s *Server) acceptLoop() {
    71		defer close(s.done)
    72		for {
    73			conn, err := s.listener.Accept()
    74			if err != nil {
    75				return
    76			}
    77			s.wg.Add(1)
    78			go s.handleConn(conn)
    79		}
    80	}
