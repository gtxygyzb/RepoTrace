   270	func (r *Router) sleepRetry(attempt, delayMs int, multiplier float64, maxDelayMs int) {
   271		if attempt < 0 {
   272			attempt = 0
   273		}
   274		delay := float64(delayMs) * pow(multiplier, float64(attempt))
   275		if maxDelayMs > 0 && delay > float64(maxDelayMs) {
   276			delay = float64(maxDelayMs)
   277		}
   278		if delay > 0 {
   279			time.Sleep(time.Duration(delay) * time.Millisecond)
   280		}
   281	}
