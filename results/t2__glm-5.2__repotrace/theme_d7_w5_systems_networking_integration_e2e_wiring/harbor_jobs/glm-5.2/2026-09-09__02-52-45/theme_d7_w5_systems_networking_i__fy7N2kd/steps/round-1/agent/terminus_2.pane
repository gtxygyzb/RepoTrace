   304	
   305	func (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {
   306		ep.mu.Lock()
   307		defer ep.mu.Unlock()
   308		ep.State = Draining
   309		ep.consecSuccess = 0
   310		ep.consecFailures = 0
   311		ep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)
   312		if markRemoved {
   313			ep.removed = true
   314		}
   315		if len(ep.connections) > 0 {
   316			go func(deadline time.Time, conns map[int64]net.Conn) {
   317				time.Sleep(time.Until(deadline))
   318				ep.closeConnectionsLocked()
   319			}(ep.drainDeadline, ep.connections)
   320		}
   321	}
   322	
   323	func (ep *EndpointState) AddConnection(conn net.Conn) int64 {
   324		ep.mu.Lock()
   325		defer ep.mu.Unlock()
   326		id := atomic.AddInt64(&ep.connIDCounter, 1)
   327		ep.connections[id] = conn
   328		ep.ActiveConnections++
   329		return id
   330	}
   331	
   332	func (ep *EndpointState) RemoveConnection(id int64) {
   333		ep.mu.Lock()
   334		defer ep.mu.Unlock()
   335		if _, ok := ep.connections[id]; ok {
   336			delete(ep.connections, id)
   337			if ep.ActiveConnections > 0 {
   338				ep.ActiveConnections--
   339			}
   340		}
   341	}
   342	
   343	func (ep *EndpointState) closeConnectionsLocked() {
   344		for id, c := range ep.connections {
   345			c.Close()
   346			delete(ep.connections, id)
   347		}
   348	}
   349	
   350	func (ep *EndpointState) Active() int {
   351		ep.mu.Lock()
   352		defer ep.mu.Unlock()
   353		return ep.ActiveConnections
   354	}
   355	
   356	func (ep *EndpointState) IsEligible(maxConns int) bool {
   357		ep.mu.Lock()
   358		defer ep.mu.Unlock()
   359		return ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
   360	}
