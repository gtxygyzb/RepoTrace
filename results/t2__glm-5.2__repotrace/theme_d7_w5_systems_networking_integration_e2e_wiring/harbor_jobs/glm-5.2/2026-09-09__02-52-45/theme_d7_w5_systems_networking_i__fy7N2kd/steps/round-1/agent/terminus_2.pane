    46		currentWeight     int
    47		connections       map[int64]*connectionInfo
    48	}
    49	
    50	type connectionInfo struct {
    51		conn         net.Conn
    52		clientAddr   string
    53		start        time.Time
    54		lastActivity time.Time
    55		bytesIn      int64
    56		bytesOut     int64
    57	}
    58	
    59	type ServiceState struct {
    60		mu                        sync.Mutex
    61		Name                      string
    62		ListenPort                int
    63		RoutingMode               string
    64		DrainTimeoutMs            int
    65		MaxConnectionsPerEndpoint int
    66		IdleTimeoutMs             int
    67		RateLimitRps              int
    68		RateLimitBurst            int
    69		RateLimitQueueDepth       int
    70		RateLimitQueueTimeoutMs   int
    71		MaxRetries                int
    72		RetryDelayMs              int
    73		RetryBackoffMultiplier    float64
    74		RetryMaxDelayMs           int
    75		rateLimiter               *rateLimiter
    76		Endpoints                 []*EndpointState
    77		rrIndex                   int
    78		Listener                  net.Listener
    79		listenerStop              chan struct{}
    80		stopping                  bool
    81	}
    82	
    83	type State struct {
    84		mu         sync.RWMutex
    85		configPath string
    86		global     config.Global
    87		services   map[string]*ServiceState
    88		logMu      sync.Mutex
    89		healthLog  map[string][]HealthEvent
    90		reloadCh   chan struct{}
    91	}
    92	
    93	func NewState(cfg *config.Config, path string) *State {
    94		s := &State{
    95			configPath: path,
    96			services:   make(map[string]*ServiceState),
    97			healthLog:  make(map[string][]HealthEvent),
    98			reloadCh:   make(chan struct{}, 1),
    99		}
   100		s.applyConfigLocked(cfg)
   101		return s
   102	}
   103	
   104	func (s *State) ReloadChan() <-chan struct{} {
   105		return s.reloadCh
   106	}
   107	
   108	func (s *State) ConfigPath() string {
   109		s.mu.RLock()
   110		defer s.mu.RUnlock()
   111		return s.configPath
   112	}
   113	
   114	func (s *State) Global() config.Global {
   115		s.mu.RLock()
   116		defer s.mu.RUnlock()
   117		return s.global
   118	}
   119	
   120	func (s *State) ApplyConfig(cfg *config.Config) {
   121		s.mu.Lock()
