func (ep *EndpointState) CloseConnections() {
    ep.mu.Lock()
    defer ep.mu.Unlock()
    ep.closeConnectionsLocked()
}

func (s *State) CloseServiceConnections(name string) {
    ss := s.GetService(name)
    if ss == nil {
        return
    }
    ss.mu.Lock()
    eps := make([]*EndpointState, len(ss.Endpoints))
    copy(eps, ss.Endpoints)
    ss.mu.Unlock()
    for _, ep := range eps {
        ep.CloseConnections()
    }
}
