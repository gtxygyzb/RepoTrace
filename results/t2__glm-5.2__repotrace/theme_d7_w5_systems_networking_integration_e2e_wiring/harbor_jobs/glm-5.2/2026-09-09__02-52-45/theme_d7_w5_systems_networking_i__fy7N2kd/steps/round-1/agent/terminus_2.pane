   134	
   135	func (s *State) applyConfigLocked(cfg *config.Config) {
   136		s.global = cfg.Global
   137		seen := make(map[string]bool)
   138		for _, svc := range cfg.Services {
   139			seen[svc.Name] = true
   140			ss := s.services[svc.Name]
   141			if ss == nil {
   142				ss = newServiceState(svc, cfg.Global)
   143				s.services[svc.Name] = ss
   144			} else {
   145				ss.mu.Lock()
   146				ss.Name = svc.Name
   147				ss.ListenPort = svc.ListenPort
   148				ss.RoutingMode = svc.RoutingMode
   149				ss.DrainTimeoutMs = svc.DrainTimeoutMs
   150				ss.RateLimitRps = svc.RateLimitRps
   151				ss.RateLimitBurst = svc.RateLimitBurst
   152				ss.RateLimitQueueDepth = svc.RateLimitQueueDepth
   153				ss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs
   154				ss.MaxRetries = svc.MaxRetries
   155				ss.RetryDelayMs = svc.RetryDelayMs
   156				ss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier
   157				ss.RetryMaxDelayMs = svc.RetryMaxDelayMs
   158				ss.DependsOn = svc.DependsOn
   159				if ss.rateLimiter == nil {
   160					ss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   161				} else {
   162					ss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   163				}
   164				ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint
   165				ss.ConnectionLimitMode = svc.ConnectionLimitMode
   166				ss.IdleTimeoutMs = svc.IdleTimeoutMs
   167				ss.mu.Unlock()
   168				ss.applyEndpoints(svc.Endpoints, cfg.Global)
   169			}
   170		}
   171		for name, ss := range s.services {
   172			if !seen[name] {
   173				ss.mu.Lock()
   174				ss.stopping = true
   175				if ss.listenerStop != nil {
   176					close(ss.listenerStop)
   177					ss.listenerStop = nil
   178				}
   179				if ss.Listener != nil {
   180					ss.Listener.Close()
   181					ss.Listener = nil
   182				}
   183				ss.mu.Unlock()
   184				for _, ep := range ss.Endpoints {
   185					ep.StartDraining(ss.DrainTimeoutMs, true)
   186				}
   187			}
   188		}
   189	}
