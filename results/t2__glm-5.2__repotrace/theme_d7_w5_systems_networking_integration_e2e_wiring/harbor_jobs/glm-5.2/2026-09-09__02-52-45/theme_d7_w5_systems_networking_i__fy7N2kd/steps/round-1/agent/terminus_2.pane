   118	
   119	func (s *State) applyConfigLocked(cfg *config.Config) {
   120		s.global = cfg.Global
   121		seen := make(map[string]bool)
   122		for _, svc := range cfg.Services {
   123			seen[svc.Name] = true
   124			ss := s.services[svc.Name]
   125			if ss == nil {
   126				ss = newServiceState(svc, cfg.Global)
   127				s.services[svc.Name] = ss
   128			} else {
   129				ss.mu.Lock()
   130				ss.Name = svc.Name
   131				ss.ListenPort = svc.ListenPort
   132				ss.RoutingMode = svc.RoutingMode
   133				ss.DrainTimeoutMs = svc.DrainTimeoutMs
   134				ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint
   135				ss.mu.Unlock()
   136				ss.applyEndpoints(svc.Endpoints, cfg.Global)
   137			}
   138		}
   139		for name, ss := range s.services {
   140			if !seen[name] {
   141				ss.mu.Lock()
   142				ss.stopping = true
   143				if ss.listenerStop != nil {
   144					close(ss.listenerStop)
   145					ss.listenerStop = nil
   146				}
   147				if ss.Listener != nil {
   148					ss.Listener.Close()
   149					ss.Listener = nil
   150				}
   151				ss.mu.Unlock()
   152				for _, ep := range ss.Endpoints {
   153					ep.StartDraining(ss.DrainTimeoutMs, true)
   154				}
   155			}
   156		}
   157	}
   158	
   159	func newServiceState(svc config.Service, global config.Global) *ServiceState {
   160		ss := &ServiceState{
   161			Name:                      svc.Name,
   162			ListenPort:                svc.ListenPort,
   163			RoutingMode:               svc.RoutingMode,
   164			DrainTimeoutMs:            svc.DrainTimeoutMs,
   165			MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
