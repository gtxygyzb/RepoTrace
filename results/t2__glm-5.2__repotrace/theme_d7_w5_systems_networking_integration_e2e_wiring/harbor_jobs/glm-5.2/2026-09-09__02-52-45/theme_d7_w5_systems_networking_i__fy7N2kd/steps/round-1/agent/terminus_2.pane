   291	func forward(client, backend net.Conn) (int64, int64) {
   292		var bytesIn, bytesOut int64
   293		var wg sync.WaitGroup
   294		wg.Add(2)
   295		go func() {
   296			defer wg.Done()
   297			n, _ := io.Copy(backend, client)
   298			bytesOut = n
   299			backend.Close()
   300			client.Close()
   301		}()
   302		go func() {
   303			defer wg.Done()
   304			n, _ := io.Copy(client, backend)
   305			bytesIn = n
   306			client.Close()
   307			backend.Close()
   308		}()
   309		wg.Wait()
   310		return bytesIn, bytesOut
   311	}
