[?2004l   552	func (ep *EndpointState) TryAddConnection(conn net.Conn, maxConns int) (int64, bool) {
   553		ep.mu.Lock()
   554		defer ep.mu.Unlock()
   555		if ep.ActiveConnections >= maxConns {
   556			return 0, false
   557		}
   558		id := atomic.AddInt64(&ep.connIDCounter, 1)
   559		now := time.Now()
   560		ep.connections[id] = &connectionInfo{
   561			conn:         conn,
   562			clientAddr:   remoteAddr(conn),
   563			start:        now,
   564			lastActivity: now,
   565		}
   566		ep.ActiveConnections++
   567		return id, true
   568	}
   569	
   570	func (ep *EndpointState) CloseConnections() {
   571		ep.mu.Lock()
   572		defer ep.mu.Unlock()
   573		ep.closeConnectionsLocked()
   574	}
   575	
   576	func (s *State) CloseServiceConnections(name string) {
   577		ss := s.GetService(name)
   578		if ss == nil {
   579			return
   580		}
   581		ss.mu.Lock()
   582		eps := make([]*EndpointState, len(ss.Endpoints))
   583		copy(eps, ss.Endpoints)
   584		ss.mu.Unlock()
   585		for _, ep := range eps {
   586			ep.CloseConnections()
   587		}
   588	}
