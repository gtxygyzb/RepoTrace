[?2004lpackage state

import (
	"net"
	"sort"
	"sync"
	"sync/atomic"
	"time"

	"meshrouter/internal/circuit"
	"meshrouter/internal/config"
	"meshrouter/internal/stats"
)

type HealthState string

const (
	Unknown   HealthState = "unknown"
	Healthy   HealthState = "healthy"
	Unhealthy HealthState = "unhealthy"
	Draining  HealthState = "draining"
)

type HealthEvent struct {
	Timestamp   time.Time
	Endpoint    string
	OldState    HealthState
	NewState    HealthState
	CheckResult string
}

type EndpointState struct {
	mu                sync.Mutex
	Address           string
	Weight            int
	Config            config.Endpoint
	State             HealthState
	ActiveConnections int
	Circuit           *circuit.Breaker
	Stats             *stats.Collector
	consecSuccess     int
	consecFailures    int
	drainDeadline     time.Time
	removed           bool
	connIDCounter     int64
	currentWeight     int
	WarmupDurationMs  int
	warmupUntil       time.Time
	connections       map[int64]*connectionInfo
}

type connectionInfo struct {
	conn         net.Conn
	clientAddr   string
	start        time.Time
	lastActivity time.Time
	bytesIn      int64
	bytesOut     int64
}

type ServiceState struct {
	mu                        sync.Mutex
	Name                      string
	ListenPort                int
	RoutingMode               string
	DrainTimeoutMs            int
	MaxConnectionsPerEndpoint int
	ConnectionLimitMode       string
	IdleTimeoutMs             int
	RateLimitRps              int
	RateLimitBurst            int
	RateLimitQueueDepth       int
	RateLimitQueueTimeoutMs   int
	MaxRetries                int
	RetryDelayMs              int
	RetryBackoffMultiplier    float64
	RetryMaxDelayMs           int
	rateLimiter               *rateLimiter
	Endpoints                 []*EndpointState
	rrIndex                   int
	Listener                  net.Listener
	listenerStop              chan struct{}
	stopping                  bool
}

type State struct {
	mu         sync.RWMutex
	configPath string
	global     config.Global
	services   map[string]*ServiceState
	logMu      sync.Mutex
	healthLog  map[string][]HealthEvent
	reloadCh   chan struct{}
}

func NewState(cfg *config.Config, path string) *State {
	s := &State{
		configPath: path,
		services:   make(map[string]*ServiceState),
		healthLog:  make(map[string][]HealthEvent),
		reloadCh:   make(chan struct{}, 1),
	}
	s.applyConfigLocked(cfg)
	return s
}

func (s *State) ReloadChan() <-chan struct{} {
	return s.reloadCh
}

func (s *State) ConfigPath() string {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return s.configPath
}

func (s *State) Global() config.Global {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return s.global
}

func (s *State) ApplyConfig(cfg *config.Config) {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.applyConfigLocked(cfg)
	select {
	case s.reloadCh <- struct{}{}:
	default:
	}
}

func (s *State) applyConfigLocked(cfg *config.Config) {
	s.global = cfg.Global
	seen := make(map[string]bool)
	for _, svc := range cfg.Services {
		seen[svc.Name] = true
		ss := s.services[svc.Name]
		if ss == nil {
			ss = newServiceState(svc, cfg.Global)
			s.services[svc.Name] = ss
		} else {
			ss.mu.Lock()
			ss.Name = svc.Name
			ss.ListenPort = svc.ListenPort
			ss.RoutingMode = svc.RoutingMode
			ss.DrainTimeoutMs = svc.DrainTimeoutMs
			ss.RateLimitRps = svc.RateLimitRps
			ss.RateLimitBurst = svc.RateLimitBurst
			ss.RateLimitQueueDepth = svc.RateLimitQueueDepth
			ss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs
			ss.MaxRetries = svc.MaxRetries
			ss.RetryDelayMs = svc.RetryDelayMs
			ss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier
			ss.RetryMaxDelayMs = svc.RetryMaxDelayMs
			if ss.rateLimiter == nil {
				ss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
			} else {
				ss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
			}
			ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint
			ss.ConnectionLimitMode = svc.ConnectionLimitMode
			ss.IdleTimeoutMs = svc.IdleTimeoutMs
			ss.mu.Unlock()
			ss.applyEndpoints(svc.Endpoints, cfg.Global)
		}
	}
	for name, ss := range s.services {
		if !seen[name] {
			ss.mu.Lock()
			ss.stopping = true
			if ss.listenerStop != nil {
				close(ss.listenerStop)
				ss.listenerStop = nil
			}
			if ss.Listener != nil {
				ss.Listener.Close()
				ss.Listener = nil
			}
			ss.mu.Unlock()
			for _, ep := range ss.Endpoints {
				ep.StartDraining(ss.DrainTimeoutMs, true)
			}
		}
	}
}

func newServiceState(svc config.Service, global config.Global) *ServiceState {
	ss := &ServiceState{
		Name:                      svc.Name,
		ListenPort:                svc.ListenPort,
		RoutingMode:               svc.RoutingMode,
		DrainTimeoutMs:            svc.DrainTimeoutMs,
		RateLimitRps:              svc.RateLimitRps,
		RateLimitBurst:            svc.RateLimitBurst,
		RateLimitQueueDepth:       svc.RateLimitQueueDepth,
		RateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,
		MaxRetries:                svc.MaxRetries,
		RetryDelayMs:              svc.RetryDelayMs,
		RetryBackoffMultiplier:    svc.RetryBackoffMultiplier,
		RetryMaxDelayMs:           svc.RetryMaxDelayMs,
		rateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),
		MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
		ConnectionLimitMode:       svc.ConnectionLimitMode,
		IdleTimeoutMs:             svc.IdleTimeoutMs,
		listenerStop:              nil,
	}
	for _, ep := range svc.Endpoints {
		ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))
	}
	return ss
}

func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {
	ss.mu.Lock()
	defer ss.mu.Unlock()
	seen := make(map[string]bool)
	for _, cep := range eps {
		seen[cep.Address] = true
		var ep *EndpointState
[?2004hroot@n30009:/app# sed -n '1,80p' internal/accesslog/logger.go
[?2004lpackage accesslog

import (
	"encoding/json"
	"os"
	"path/filepath"
	"sync"
	"sync/atomic"
	"time"
)

// Entry is one structured access log record.
type Entry struct {
	Ts          string `json:"ts"`
	Service     string `json:"service"`
	Client      string `json:"client"`
	Endpoint    string `json:"endpoint"`
	BytesIn     int64  `json:"bytes_in"`
	BytesOut    int64  `json:"bytes_out"`
	DurationMs  int64  `json:"duration_ms"`
	Result      string `json:"result"`
	Retried     bool   `json:"retried"`
	RetryCount  int    `json:"retry_count"`
	QueueWaitMs *int64 `json:"queue_wait_ms,omitempty"`
}

// DefaultPath is the access log path required by meshrouter.
const DefaultPath = "/app/logs/access.log"

const maxFileSize = 1 << 20 // 1 MB

// Logger writes access log entries asynchronously to a JSON-lines file.
type Logger struct {
	path     string
	ch       chan Entry
	stop     chan struct{}
	done     chan struct{}
	stopped  int32
	stopOnce sync.Once
	mu       sync.Mutex
	file     *os.File
	size     int64
}

// New creates a Logger for path and starts its writer goroutine.
func New(path string) *Logger {
	if path == "" {
		path = DefaultPath
	}
	l := &Logger{
		path: path,
		ch:   make(chan Entry, 8192),
		stop: make(chan struct{}),
		done: make(chan struct{}),
	}
	go l.run()
	return l
}

// Path returns the configured log file path.
func (l *Logger) Path() string {
	return l.path
}

// Log queues an entry for asynchronous writing. If the buffered channel is full,
// the entry is written synchronously to avoid losing it.
func (l *Logger) Log(entry Entry) {
	if atomic.LoadInt32(&l.stopped) != 0 {
		return
	}
	entry.Ts = time.Now().UTC().Format(time.RFC3339Nano)
	select {
	case l.ch <- entry:
	default:
		l.writeLine(entry)
	}
}

// Stop flushes all buffered entries and closes the log file.
func (l *Logger) Stop() {
[?2004hroot@n30009:/app# sed -n '1,180p' internal/stats/stats.go
[?2004lpackage stats

import (
	"sync"
	"time"
)

type entry struct {
	timestamp time.Time
	bytesIn   int64
	bytesOut  int64
	latency   time.Duration
	err       bool
}

// Collector keeps rolling connection statistics for one endpoint.
type Collector struct {
	mu         sync.Mutex
	window     time.Duration
	entries    []entry
	rejections []time.Time

	rateLimited    int
	queued         int
	queueTimeouts  int
	retries        int
	retrySuccesses int
	idleTimeouts   int
}

// New creates a collector with the given window length.
func New(window time.Duration) *Collector {
	if window <= 0 {
		window = time.Minute
	}
	return &Collector{window: window}
}

// RecordConnection records a finished connection attempt.
func (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {
	c.mu.Lock()
	defer c.mu.Unlock()
	now := time.Now()
	c.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})
	c.trim(now)
}

// RecordRejection records a rejected connection because the endpoint was at capacity.
func (c *Collector) RecordRejection() {
	c.mu.Lock()
	defer c.mu.Unlock()
	now := time.Now()
	c.rejections = append(c.rejections, now)
	c.trim(now)
}

// RecordRateLimited records a rate limit rejection.
func (c *Collector) RecordRateLimited() {
	c.mu.Lock()
	defer c.mu.Unlock()
	c.rateLimited++
}

// RecordQueued records a connection that was queued waiting for a token.
func (c *Collector) RecordQueued() {
	c.mu.Lock()
	defer c.mu.Unlock()
	c.queued++
}

// RecordQueueTimeout records a queue timeout rejection.
func (c *Collector) RecordQueueTimeout() {
	c.mu.Lock()
	defer c.mu.Unlock()
	c.queueTimeouts++
	c.rateLimited++
}

// RecordRetry records a retry attempt.
func (c *Collector) RecordRetry() {
	c.mu.Lock()
	defer c.mu.Unlock()
	c.retries++
}

// RecordRetrySuccess records a successful retry attempt.
func (c *Collector) RecordRetrySuccess() {
	c.mu.Lock()
	defer c.mu.Unlock()
	c.retrySuccesses++
}

// RecordIdleTimeout records a connection that was closed because it was idle.
func (c *Collector) RecordIdleTimeout() {
	c.mu.Lock()
	defer c.mu.Unlock()
	c.idleTimeouts++
}

func (c *Collector) trim(now time.Time) {
	cutoff := now.Add(-c.window)
	i := 0
	for i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {
		i++
	}
	if i > 0 {
		c.entries = c.entries[i:]
	}
	j := 0
	for j < len(c.rejections) && c.rejections[j].Before(cutoff) {
		j++
	}
	if j > 0 {
		c.rejections = c.rejections[j:]
	}
}

// Snapshot returns current windowed stats. active is supplied by the state manager.
func (c *Collector) Snapshot(active int) Snapshot {
	c.mu.Lock()
	defer c.mu.Unlock()
	now := time.Now()
	cutoff := now.Add(-c.window)
	var total int
	var bytesIn, bytesOut int64
	var latencySum time.Duration
	var errors int
	for _, e := range c.entries {
		if e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {
			total++
			bytesIn += e.bytesIn
			bytesOut += e.bytesOut
			latencySum += e.latency
			if e.err {
				errors++
			}
		}
	}
	rejected := 0
	for _, t := range c.rejections {
		if t.After(cutoff) || t.Equal(cutoff) {
			rejected++
		}
	}
	var avg float64
	if total > 0 {
		avg = float64(latencySum.Milliseconds()) / float64(total)
	}
	return Snapshot{
		TotalConnections:    total,
		ActiveConnections:   active,
		BytesIn:             bytesIn,
		BytesOut:            bytesOut,
		AvgLatencyMs:        avg,
		Errors:              errors,
		RejectedConnections: rejected,
		RateLimited:         c.rateLimited,
		Queued:              c.queued,
		QueueTimeouts:       c.queueTimeouts,
		Retries:             c.retries,
		RetrySuccesses:      c.retrySuccesses,
		IdleTimeouts:        c.idleTimeouts,
	}
}

// Snapshot is a JSON-friendly stats view.
type Snapshot struct {
	TotalConnections    int     `json:"total_connections"`
	ActiveConnections   int     `json:"active_connections"`
	BytesIn             int64   `json:"bytes_in"`
	BytesOut            int64   `json:"bytes_out"`
	AvgLatencyMs        float64 `json:"avg_latency_ms"`
	Errors              int     `json:"errors"`
	RejectedConnections int     `json:"rejected_connections"`
	RateLimited         int     `json:"rate_limited"`
	Queued              int     `json:"queued"`
	QueueTimeouts       int     `json:"queue_timeouts"`
	Retries             int     `json:"retries"`
	RetrySuccesses      int     `json:"retry_successes"`
	IdleTimeouts        int     `json:"idle_timeouts"`
