   156	// Snapshot is a JSON-friendly stats view.
   157	type Snapshot struct {
   158		TotalConnections    int     `json:"total_connections"`
   159		ActiveConnections   int     `json:"active_connections"`
   160		BytesIn             int64   `json:"bytes_in"`
   161		BytesOut            int64   `json:"bytes_out"`
   162		AvgLatencyMs        float64 `json:"avg_latency_ms"`
   163		Errors              int     `json:"errors"`
   164		RejectedConnections int     `json:"rejected_connections"`
   165		RateLimited         int     `json:"rate_limited"`
   166		Queued              int     `json:"queued"`
   167		QueueTimeouts       int     `json:"queue_timeouts"`
   168		Retries             int     `json:"retries"`
