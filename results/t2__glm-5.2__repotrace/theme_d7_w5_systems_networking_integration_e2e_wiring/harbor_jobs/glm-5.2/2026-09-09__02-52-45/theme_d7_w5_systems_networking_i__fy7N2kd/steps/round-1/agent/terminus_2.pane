    53	// Load reads and normalizes a TOML config file.
    54	func Load(path string) (*Config, error) {
    55		var cfg Config
    56		if _, err := toml.DecodeFile(path, &cfg); err != nil {
    57			return nil, err
    58		}
    59		if cfg.Global.HealthIntervalMs <= 0 {
    60			cfg.Global.HealthIntervalMs = 2000
    61		}
    62		if cfg.Global.UnhealthyThreshold <= 0 {
    63			cfg.Global.UnhealthyThreshold = 3
    64		}
    65		if cfg.Global.HealthyThreshold <= 0 {
    66			cfg.Global.HealthyThreshold = 2
    67		}
    68		if cfg.Global.StatsWindowSec <= 0 {
    69			cfg.Global.StatsWindowSec = 60
    70		}
    71		if cfg.Global.CircuitBreakerThreshold <= 0 {
    72			cfg.Global.CircuitBreakerThreshold = 3
    73		}
    74		if cfg.Global.CircuitBreakerTimeoutMs <= 0 {
    75			cfg.Global.CircuitBreakerTimeoutMs = 5000
    76		}
    77		for i := range cfg.Services {
    78			s := &cfg.Services[i]
    79			if s.RoutingMode == "" {
    80				s.RoutingMode = "weighted-round-robin"
    81			}
    82			if s.DrainTimeoutMs <= 0 {
    83				s.DrainTimeoutMs = 5000
    84			}
    85			if s.MaxConnectionsPerEndpoint <= 0 {
    86				s.MaxConnectionsPerEndpoint = 100
    87			}
    88			if s.ConnectionLimitMode == "" {
    89				s.ConnectionLimitMode = "per-endpoint"
    90			}
    91			if s.RateLimitBurst <= 0 {
    92				s.RateLimitBurst = s.RateLimitRps
    93			}
    94			if s.RateLimitQueueTimeoutMs <= 0 {
    95				s.RateLimitQueueTimeoutMs = 1000
    96			}
    97			if s.RetryDelayMs <= 0 {
    98				s.RetryDelayMs = 100
    99			}
   100			if s.RetryBackoffMultiplier <= 0 {
   101				s.RetryBackoffMultiplier = 2.0
   102			}
   103			if s.RetryMaxDelayMs <= 0 {
   104				s.RetryMaxDelayMs = 5000
   105			}
   106			for j := range s.Endpoints {
   107				ep := &s.Endpoints[j]
   108				if ep.HealthCheck == "" {
   109					ep.HealthCheck = "tcp"
   110				}
   111				if ep.Weight < 0 {
   112					ep.Weight = 0
   113				}
