   426	func copyTee(primary, mirror io.Writer, src io.Reader, ep *state.EndpointState, id int64, direction string) (int64, error) {
   427		buf := make([]byte, 32*1024)
   428		var total int64
   429		mirrorOK := true
   430		for {
   431			n, err := src.Read(buf)
   432			if n > 0 {
   433				if _, werr := primary.Write(buf[:n]); werr != nil {
   434					return total, werr
   435				}
   436				if mirrorOK {
   437					if _, merr := mirror.Write(buf[:n]); merr != nil {
   438						mirrorOK = false
   439					}
   440				}
   441				total += int64(n)
   442				if direction == "out" {
   443					ep.UpdateConnectionActivity(id, int64(n), 0)
   444				} else {
   445					ep.UpdateConnectionActivity(id, 0, int64(n))
   446				}
   447			}
   448			if err != nil {
   449				return total, err
   450			}
   451		}
   452	}
