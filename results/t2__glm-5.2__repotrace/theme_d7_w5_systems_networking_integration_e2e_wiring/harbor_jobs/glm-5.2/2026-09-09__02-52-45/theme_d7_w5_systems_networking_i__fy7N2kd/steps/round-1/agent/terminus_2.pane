   266	
   267	func (s *State) GetEndpoint(service, address string) *EndpointState {
   268		ss := s.GetService(service)
   269		if ss == nil {
   270			return nil
   271		}
   272		ss.mu.Lock()
   273		defer ss.mu.Unlock()
   274		for _, ep := range ss.Endpoints {
   275			if ep.Address == address {
   276				return ep
   277			}
   278		}
   279		return nil
   280	}
   281	
   282	func (s *State) SetWeight(service, address string, weight int) error {
   283		ep := s.GetEndpoint(service, address)
   284		if ep == nil {
   285			return errNotFound("endpoint not found")
   286		}
   287		ep.mu.Lock()
   288		defer ep.mu.Unlock()
   289		if weight < 0 {
   290			weight = 0
   291		}
   292		ep.Weight = weight
   293		return nil
   294	}
   295	
   296	func (s *State) DrainEndpoint(service, address string) error {
   297		ss := s.GetService(service)
   298		if ss == nil {
   299			return errNotFound("service not found")
   300		}
   301		ep := s.GetEndpoint(service, address)
   302		if ep == nil {
   303			return errNotFound("endpoint not found")
   304		}
   305		ep.StartDraining(ss.DrainTimeoutMs, false)
   306		return nil
   307	}
   308	
   309	func (s *State) ResetCircuitBreaker(service, address string) error {
   310		ep := s.GetEndpoint(service, address)
   311		if ep == nil {
   312			return errNotFound("endpoint not found")
   313		}
   314		ep.Circuit.Reset()
   315		return nil
   316	}
   317	
   318	func (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {
   319		ep.mu.Lock()
   320		defer ep.mu.Unlock()
   321		ep.State = Draining
   322		ep.consecSuccess = 0
   323		ep.consecFailures = 0
   324		ep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)
   325		if markRemoved {
   326			ep.removed = true
   327		}
   328		if len(ep.connections) > 0 {
   329			go func(deadline time.Time) {
   330				time.Sleep(time.Until(deadline))
   331				ep.mu.Lock()
   332				ep.closeConnectionsLocked()
   333				ep.mu.Unlock()
   334			}(ep.drainDeadline)
   335		}
   336	}
   337	
   338	func (ep *EndpointState) AddConnection(conn net.Conn) int64 {
   339		ep.mu.Lock()
   340		defer ep.mu.Unlock()
   341		id := atomic.AddInt64(&ep.connIDCounter, 1)
   342		now := time.Now()
   343		ep.connections[id] = &connectionInfo{
   344			conn:         conn,
   345			clientAddr:   remoteAddr(conn),
   346			start:        now,
   347			lastActivity: now,
   348		}
   349		ep.ActiveConnections++
   350		return id
   351	}
   352	
   353	func (ep *EndpointState) RemoveConnection(id int64) {
   354		ep.mu.Lock()
   355		defer ep.mu.Unlock()
   356		if _, ok := ep.connections[id]; ok {
   357			delete(ep.connections, id)
   358			if ep.ActiveConnections > 0 {
   359				ep.ActiveConnections--
   360			}
   361		}
   362	}
   363	
   364	func (ep *EndpointState) closeConnectionsLocked() {
   365		for id, info := range ep.connections {
   366			info.conn.Close()
   367			delete(ep.connections, id)
   368		}
   369	}
   370	
   371	func (ep *EndpointState) Active() int {
   372		ep.mu.Lock()
   373		defer ep.mu.Unlock()
   374		return ep.ActiveConnections
   375	}
   376	
   377	func remoteAddr(conn net.Conn) string {
   378		if conn == nil {
   379			return ""
   380		}
   381		if a := conn.RemoteAddr(); a != nil {
   382			return a.String()
   383		}
   384		return ""
   385	}
   386	
   387	func (ep *EndpointState) UpdateConnectionActivity(id int64, bytesIn, bytesOut int64) {
   388		ep.mu.Lock()
   389		defer ep.mu.Unlock()
   390		if info, ok := ep.connections[id]; ok {
   391			info.bytesIn += bytesIn
   392			info.bytesOut += bytesOut
   393			if bytesIn > 0 || bytesOut > 0 {
   394				info.lastActivity = time.Now()
   395			}
   396		}
   397	}
   398	
   399	func (ep *EndpointState) ConnectionIdleMs(id int64) int64 {
   400		ep.mu.Lock()
   401		defer ep.mu.Unlock()
   402		if info, ok := ep.connections[id]; ok {
   403			return time.Since(info.lastActivity).Milliseconds()
   404		}
   405		return -1
   406	}
   407	
   408	func (ss *ServiceState) IdleTimeout() int {
   409		ss.mu.Lock()
   410		defer ss.mu.Unlock()
   411		return ss.IdleTimeoutMs
   412	}
   413	
   414	type ConnectionView struct {
   415		Endpoint string `json:"endpoint"`
   416		Client   string `json:"client"`
   417		AgeMs    int64  `json:"age_ms"`
   418		IdleMs   int64  `json:"idle_ms"`
   419		BytesIn  int64  `json:"bytes_in"`
   420		BytesOut int64  `json:"bytes_out"`
   421	}
   422	
   423	func (s *State) ConnectionsView(name string) ([]ConnectionView, bool) {
   424		ss := s.GetService(name)
   425		if ss == nil {
   426			return nil, false
   427		}
   428		ss.mu.Lock()
   429		endpoints := make([]*EndpointState, len(ss.Endpoints))
   430		copy(endpoints, ss.Endpoints)
   431		ss.mu.Unlock()
   432	
   433		now := time.Now()
   434		var out []ConnectionView
   435		for _, ep := range endpoints {
   436			ep.mu.Lock()
   437			for _, info := range ep.connections {
   438				out = append(out, ConnectionView{
   439					Endpoint: ep.Address,
   440					Client:   info.clientAddr,
   441					AgeMs:    now.Sub(info.start).Milliseconds(),
   442					IdleMs:   now.Sub(info.lastActivity).Milliseconds(),
   443					BytesIn:  info.bytesIn,
   444					BytesOut: info.bytesOut,
   445				})
   446			}
   447			ep.mu.Unlock()
   448		}
   449		sort.Slice(out, func(i, j int) bool {
   450			if out[i].Endpoint != out[j].Endpoint {
   451				return out[i].Endpoint < out[j].Endpoint
   452			}
   453			return out[i].Client < out[j].Client
   454		})
   455		return out, true
   456	}
   457	
   458	func (ep *EndpointState) IsEligible(maxConns int) bool {
   459		ep.mu.Lock()
   460		defer ep.mu.Unlock()
   461		return ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
   462	}
   463	
   464	func (s *State) RecordHealthCheck(service, address string, success bool) HealthEvent {
   465		ss := s.GetService(service)
   466		if ss == nil {
   467			return HealthEvent{}
   468		}
   469		ep := s.GetEndpoint(service, address)
   470		if ep == nil {
   471			return HealthEvent{}
   472		}
   473		global := s.Global()
   474		ep.mu.Lock()
   475		oldState := ep.State
   476		result := "success"
   477		if !success {
   478			result = "failure"
   479		}
   480		if success {
   481			ep.consecSuccess++
   482			ep.consecFailures = 0
   483			if oldState == Unknown && ep.consecSuccess >= global.HealthyThreshold {
   484				ep.State = Healthy
   485			} else if oldState == Unhealthy && ep.consecSuccess >= global.HealthyThreshold {
   486				ep.State = Healthy
   487			}
   488		} else {
   489			ep.consecFailures++
   490			ep.consecSuccess = 0
   491			if (oldState == Healthy || oldState == Unknown) && ep.consecFailures >= global.UnhealthyThreshold {
   492				ep.State = Unhealthy
   493				ep.Circuit.Open()
   494				ep.consecFailures = 0
   495				timeout := time.Duration(ss.DrainTimeoutMs) * time.Millisecond
   496				go func(deadline time.Time) {
   497					time.Sleep(time.Until(deadline))
   498					ep.mu.Lock()
   499					ep.closeConnectionsLocked()
   500					ep.mu.Unlock()
   501				}(time.Now().Add(timeout))
   502			}
   503		}
   504		newState := ep.State
   505		ep.mu.Unlock()
   506		evt := HealthEvent{
   507			Timestamp:   time.Now(),
   508			Endpoint:    address,
   509			OldState:    oldState,
   510			NewState:    newState,
   511			CheckResult: result,
   512		}
   513		s.logMu.Lock()
   514		s.healthLog[service] = append(s.healthLog[service], evt)
   515		if len(s.healthLog[service]) > 1000 {
   516			s.healthLog[service] = s.healthLog[service][len(s.healthLog[service])-1000:]
   517		}
   518		s.logMu.Unlock()
   519		return evt
   520	}
