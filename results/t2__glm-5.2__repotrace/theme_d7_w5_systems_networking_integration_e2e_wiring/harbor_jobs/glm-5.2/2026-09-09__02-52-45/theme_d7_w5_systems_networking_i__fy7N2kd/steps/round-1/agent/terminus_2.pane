[?2004lpackage state

import (
	"sync"
	"time"
)

type rateLimiter struct {
	mu          sync.Mutex
	rps         float64
	burst       float64
	tokens      float64
	last        time.Time
	queueMax    int
	queueDepth  int
	timeout     time.Duration
	rateLimited uint64
	queued      uint64
	timeouts    uint64
}

func newRateLimiter(rps, burst int, queueDepth int, timeoutMs int) *rateLimiter {
	return &rateLimiter{
		rps:      float64(rps),
		burst:    float64(burst),
		tokens:   float64(burst),
		last:     time.Now(),
		queueMax: queueDepth,
		timeout:  time.Duration(timeoutMs) * time.Millisecond,
	}
}

func (rl *rateLimiter) update(rps, burst int, queueDepth int, timeoutMs int) {
	rl.mu.Lock()
	defer rl.mu.Unlock()
	rl.rps = float64(rps)
	rl.burst = float64(burst)
	if rl.tokens > rl.burst {
		rl.tokens = rl.burst
	}
	rl.queueMax = queueDepth
	rl.timeout = time.Duration(timeoutMs) * time.Millisecond
}

func (rl *rateLimiter) refillLocked(now time.Time) {
	elapsed := now.Sub(rl.last).Seconds()
	if elapsed > 0 {
		rl.tokens += rl.rps * elapsed
		if rl.burst > 0 && rl.tokens > rl.burst {
			rl.tokens = rl.burst
		}
		rl.last = now
	}
}

func (rl *rateLimiter) tryAcquireLocked(now time.Time) bool {
	if rl.rps <= 0 {
		return true
	}
	rl.refillLocked(now)
	if rl.tokens >= 1 {
		rl.tokens -= 1
		return true
	}
	return false
}

func (rl *rateLimiter) acquire(now time.Time) (bool, bool) {
	rl.mu.Lock()
	if rl.rps <= 0 {
		rl.mu.Unlock()
		return true, false
	}
	if rl.tryAcquireLocked(now) {
		rl.mu.Unlock()
		return true, false
	}
	if rl.queueMax <= 0 {
		rl.rateLimited++
		rl.mu.Unlock()
		return false, false
	}
	if rl.queueDepth >= rl.queueMax {
		rl.rateLimited++
		rl.mu.Unlock()
		return false, false
	}
	rl.queueDepth++
	rl.queued++
	rl.mu.Unlock()

	deadline := now.Add(rl.timeout)
	for {
		rl.mu.Lock()
		var wait time.Duration
		if rl.rps > 0 {
			needed := 1.0 - rl.tokens
			if needed > 0 {
				wait = time.Duration(needed / rl.rps * float64(time.Second))
			}
		}
		rl.mu.Unlock()

		if wait <= 0 {
			rl.mu.Lock()
			if rl.tryAcquireLocked(time.Now()) {
				rl.queueDepth--
				rl.mu.Unlock()
				return true, true
			}
			rl.mu.Unlock()
			continue
		}

		remaining := time.Until(deadline)
		if remaining <= 0 {
			rl.mu.Lock()
			rl.queueDepth--
			rl.timeouts++
			rl.mu.Unlock()
			return false, true
		}
		if wait > remaining {
			wait = remaining
		}
		timer := time.NewTimer(wait)
		select {
		case <-timer.C:
		}
		timer.Stop()
	}
}

func (rl *rateLimiter) status() (tokens float64, queueDepth int, rateLimited uint64, queued uint64, timeouts uint64, rps float64, burst float64) {
	rl.mu.Lock()
	defer rl.mu.Unlock()
	rl.refillLocked(time.Now())
	return rl.tokens, rl.queueDepth, rl.rateLimited, rl.queued, rl.timeouts, rl.rps, rl.burst
}
