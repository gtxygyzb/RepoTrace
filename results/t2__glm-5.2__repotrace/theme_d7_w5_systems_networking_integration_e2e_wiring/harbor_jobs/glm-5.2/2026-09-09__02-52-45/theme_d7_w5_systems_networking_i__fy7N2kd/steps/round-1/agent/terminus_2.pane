    41		mu       sync.Mutex
    42		file     *os.File
    43		size     int64
    44	}
    45	
    46	// New creates a Logger for path and starts its writer goroutine.
    47	func New(path string) *Logger {
    48		if path == "" {
    49			path = DefaultPath
    50		}
    51		l := &Logger{
    52			path: path,
    53			ch:   make(chan Entry, 8192),
    54			stop: make(chan struct{}),
    55			done: make(chan struct{}),
    56		}
    57		go l.run()
    58		return l
    59	}
