    59				fmt.Fprintln(os.Stderr, "usage: meshctl drain <service> <endpoint>")
    60				os.Exit(1)
    61			}
    62			ipcCmd = "drain_endpoint"
    63			args["name"] = os.Args[2]
    64			args["address"] = os.Args[3]
    65		case "health-log":
    66			if len(os.Args) < 3 {
    67				fmt.Fprintln(os.Stderr, "usage: meshctl health-log <service> [--last N]")
    68				os.Exit(1)
    69			}
    70			ipcCmd = "get_health_log"
    71			args["name"] = os.Args[2]
    72			last := 20
    73			for _, a := range os.Args[3:] {
    74				if strings.HasPrefix(a, "--last") && len(a) > 6 {
    75					if v, err := strconv.Atoi(a[6:]); err == nil {
    76						last = v
    77					}
    78				}
    79			}
    80			args["last_n"] = last
    81		case "resolve":
    82			if len(os.Args) < 3 {
    83				fmt.Fprintln(os.Stderr, "usage: meshctl resolve <service>")
    84				os.Exit(1)
    85			}
    86			ipcCmd = "resolve"
    87			args["name"] = os.Args[2]
    88		case "circuits":
    89			if len(os.Args) < 3 {
    90				fmt.Fprintln(os.Stderr, "usage: meshctl circuits <service>")
    91				os.Exit(1)
    92			}
    93			ipcCmd = "get_circuit_breakers"
    94			args["name"] = os.Args[2]
    95		case "reset-circuit":
