    32	
    33	func (s *State) ServicesView() []ServiceView {
    34		services := s.Services()
    35		out := make([]ServiceView, 0, len(services))
    36		for _, ss := range services {
    37			out = append(out, ss.View())
    38		}
    39		sort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })
    40		return out
    41	}
