    13	
    14	type HealthState string
    15	
    16	const (
    17		Unknown   HealthState = "unknown"
    18		Healthy   HealthState = "healthy"
    19		Unhealthy HealthState = "unhealthy"
    20		Draining  HealthState = "draining"
    21	)
    22	
    23	type HealthEvent struct {
