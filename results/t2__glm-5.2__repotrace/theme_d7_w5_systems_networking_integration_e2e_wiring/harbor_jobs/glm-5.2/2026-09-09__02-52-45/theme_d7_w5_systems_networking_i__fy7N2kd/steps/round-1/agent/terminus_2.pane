   254	func (s *State) GetEndpoint(service, address string) *EndpointState {
   255		ss := s.GetService(service)
   256		if ss == nil {
   257			return nil
   258		}
   259		ss.mu.Lock()
   260		defer ss.mu.Unlock()
   261		for _, ep := range ss.Endpoints {
   262			if ep.Address == address {
   263				return ep
   264			}
   265		}
   266		return nil
   267	}
   268	
   269	func (s *State) SetWeight(service, address string, weight int) error {
   270		ep := s.GetEndpoint(service, address)
   271		if ep == nil {
   272			return errNotFound("endpoint not found")
   273		}
   274		ep.mu.Lock()
   275		defer ep.mu.Unlock()
   276		if weight < 0 {
   277			weight = 0
   278		}
   279		ep.Weight = weight
   280		return nil
   281	}
   282	
   283	func (s *State) DrainEndpoint(service, address string) error {
   284		ss := s.GetService(service)
   285		if ss == nil {
   286			return errNotFound("service not found")
   287		}
   288		ep := s.GetEndpoint(service, address)
   289		if ep == nil {
   290			return errNotFound("endpoint not found")
   291		}
   292		ep.StartDraining(ss.DrainTimeoutMs, false)
   293		return nil
   294	}
   295	
   296	func (s *State) ResetCircuitBreaker(service, address string) error {
   297		ep := s.GetEndpoint(service, address)
   298		if ep == nil {
   299			return errNotFound("endpoint not found")
   300		}
   301		ep.Circuit.Reset()
   302		return nil
   303	}
   304	
   305	func (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {
   306		ep.mu.Lock()
   307		defer ep.mu.Unlock()
   308		ep.State = Draining
   309		ep.consecSuccess = 0
   310		ep.consecFailures = 0
   311		ep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)
   312		if markRemoved {
   313			ep.removed = true
   314		}
   315		if len(ep.connections) > 0 {
   316			go func(deadline time.Time, conns map[int64]net.Conn) {
   317				time.Sleep(time.Until(deadline))
   318				ep.closeConnectionsLocked()
   319			}(ep.drainDeadline, ep.connections)
   320		}
