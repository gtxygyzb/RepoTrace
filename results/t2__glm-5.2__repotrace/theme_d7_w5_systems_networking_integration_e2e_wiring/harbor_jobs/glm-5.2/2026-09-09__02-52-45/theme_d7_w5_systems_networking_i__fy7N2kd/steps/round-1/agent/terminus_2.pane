    41	
    42	// Load reads and normalizes a TOML config file.
    43	func Load(path string) (*Config, error) {
    44		var cfg Config
    45		if _, err := toml.DecodeFile(path, &cfg); err != nil {
    46			return nil, err
    47		}
    48		if cfg.Global.HealthIntervalMs <= 0 {
    49			cfg.Global.HealthIntervalMs = 2000
    50		}
    51		if cfg.Global.UnhealthyThreshold <= 0 {
    52			cfg.Global.UnhealthyThreshold = 3
    53		}
    54		if cfg.Global.HealthyThreshold <= 0 {
    55			cfg.Global.HealthyThreshold = 2
    56		}
    57		if cfg.Global.StatsWindowSec <= 0 {
    58			cfg.Global.StatsWindowSec = 60
    59		}
    60		if cfg.Global.CircuitBreakerThreshold <= 0 {
    61			cfg.Global.CircuitBreakerThreshold = 3
    62		}
    63		if cfg.Global.CircuitBreakerTimeoutMs <= 0 {
    64			cfg.Global.CircuitBreakerTimeoutMs = 5000
    65		}
    66		for i := range cfg.Services {
    67			s := &cfg.Services[i]
    68			if s.RoutingMode == "" {
    69				s.RoutingMode = "weighted-round-robin"
    70			}
    71			if s.DrainTimeoutMs <= 0 {
    72				s.DrainTimeoutMs = 5000
    73			}
    74			if s.MaxConnectionsPerEndpoint <= 0 {
    75				s.MaxConnectionsPerEndpoint = 100
    76			}
    77			for j := range s.Endpoints {
    78				ep := &s.Endpoints[j]
    79				if ep.HealthCheck == "" {
    80					ep.HealthCheck = "tcp"
    81				}
    82				if ep.Weight < 0 {
    83					ep.Weight = 0
    84				}
    85			}
    86		}
    87		return &cfg, nil
    88	}
