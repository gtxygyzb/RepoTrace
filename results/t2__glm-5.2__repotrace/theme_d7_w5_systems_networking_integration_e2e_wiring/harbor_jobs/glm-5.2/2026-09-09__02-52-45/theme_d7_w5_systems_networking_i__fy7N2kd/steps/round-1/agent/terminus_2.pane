    44			for _, ep := range endpoints {
    45				ep.mu.Lock()
    46				halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining
    47				ep.mu.Unlock()
    48				if halfOpen {
    49					return ep, nil
    50				}
    51			}
    52			return nil, errNotFound("no eligible endpoints")
    53		}
    54		if mode == "least-connections" {
    55			return selectLeastConnections(regular, 1<<30), nil
    56		}
    57		return selectWeightedCandidate(regular), nil
    58	}
    59	
    60	func selectWeighted(eps []*EndpointState) *EndpointState {
    61		var best *EndpointState
    62		var bestWeight int
    63		var totalWeight int
    64		for _, ep := range eps {
    65			ep.mu.Lock()
    66			w := ep.effectiveWeightLocked()
    67			ep.currentWeight += w
    68			totalWeight += w
    69			cw := ep.currentWeight
    70			ep.mu.Unlock()
    71			if best == nil || cw > bestWeight {
    72				best = ep
    73				bestWeight = cw
    74			}
    75		}
    76		if best != nil {
    77			best.mu.Lock()
    78			best.currentWeight -= totalWeight
    79			best.mu.Unlock()
    80		}
    81		return best
    82	}
    83	
    84	func selectWeightedCandidate(eps []*EndpointState) *EndpointState {
    85		var best *EndpointState
    86		var bestWeight int
    87		for _, ep := range eps {
    88			ep.mu.Lock()
    89			cw := ep.currentWeight + ep.effectiveWeightLocked()
    90			ep.mu.Unlock()
    91			if best == nil || cw > bestWeight {
    92				best = ep
    93				bestWeight = cw
    94			}
    95		}
    96		return best
    97	}
    98	
    99	func selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {
   100		sort.SliceStable(eps, func(i, j int) bool {
   101			ai := eps[i].Active()
   102			aj := eps[j].Active()
   103			if ai != aj {
   104				return ai < aj
   105			}
   106			// Tie-break by effective weight (higher weight first), then lexicographic address.
   107			wi := eps[i].EffectiveWeight()
   108			wj := eps[j].EffectiveWeight()
   109			if wi != wj {
   110				return wi > wj
   111			}
   112			return eps[i].Address < eps[j].Address
   113		})
   114		return eps[0]
   115	}
