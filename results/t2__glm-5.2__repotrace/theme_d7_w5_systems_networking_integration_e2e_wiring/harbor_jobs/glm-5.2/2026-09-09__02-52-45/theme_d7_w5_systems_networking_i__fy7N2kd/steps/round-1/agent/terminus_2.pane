    53		if _, err := toml.DecodeFile(path, &cfg); err != nil {
    54			return nil, err
    55		}
    56		if cfg.Global.HealthIntervalMs <= 0 {
    57			cfg.Global.HealthIntervalMs = 2000
    58		}
    59		if cfg.Global.UnhealthyThreshold <= 0 {
    60			cfg.Global.UnhealthyThreshold = 3
    61		}
    62		if cfg.Global.HealthyThreshold <= 0 {
    63			cfg.Global.HealthyThreshold = 2
    64		}
    65		if cfg.Global.StatsWindowSec <= 0 {
    66			cfg.Global.StatsWindowSec = 60
    67		}
    68		if cfg.Global.CircuitBreakerThreshold <= 0 {
    69			cfg.Global.CircuitBreakerThreshold = 3
    70		}
    71		if cfg.Global.CircuitBreakerTimeoutMs <= 0 {
    72			cfg.Global.CircuitBreakerTimeoutMs = 5000
    73		}
    74		for i := range cfg.Services {
    75			s := &cfg.Services[i]
    76			if s.RoutingMode == "" {
    77				s.RoutingMode = "weighted-round-robin"
    78			}
    79			if s.DrainTimeoutMs <= 0 {
    80				s.DrainTimeoutMs = 5000
    81			}
    82			if s.MaxConnectionsPerEndpoint <= 0 {
    83				s.MaxConnectionsPerEndpoint = 100
    84			}
    85			if s.RateLimitBurst <= 0 {
    86				s.RateLimitBurst = s.RateLimitRps
    87			}
    88			if s.RateLimitQueueTimeoutMs <= 0 {
    89				s.RateLimitQueueTimeoutMs = 1000
    90			}
    91			if s.RetryDelayMs <= 0 {
    92				s.RetryDelayMs = 100
    93			}
    94			if s.RetryBackoffMultiplier <= 0 {
    95				s.RetryBackoffMultiplier = 2.0
    96			}
    97			if s.RetryMaxDelayMs <= 0 {
    98				s.RetryMaxDelayMs = 5000
    99			}
   100			for j := range s.Endpoints {
   101				ep := &s.Endpoints[j]
   102				if ep.HealthCheck == "" {
   103					ep.HealthCheck = "tcp"
   104				}
   105				if ep.Weight < 0 {
   106					ep.Weight = 0
   107				}
   108			}
   109		}
   110		return &cfg, nil
   111	}
