     2	
     3	import (
     4		"sync"
     5		"time"
     6	)
     7	
     8	type State string
     9	
    10	const (
    11		Closed   State = "closed"
    12		Open     State = "open"
    13		HalfOpen State = "half_open"
    14	)
    15	
    16	// Breaker implements an endpoint circuit breaker.
    17	type Breaker struct {
    18		mu                  sync.Mutex
    19		state               State
    20		consecutiveFailures int
    21		stateChangedAt      time.Time
    22		openedAt            time.Time
    23		timeout             time.Duration
    24		probeActive         bool
    25	}
    26	
    27	// New creates a closed breaker with the given open timeout.
    28	func New(timeout time.Duration) *Breaker {
    29		now := time.Now()
    30		return &Breaker{
    31			state:          Closed,
    32			stateChangedAt: now,
    33			openedAt:       now,
    34			timeout:        timeout,
    35		}
    36	}
    37	
    38	// State returns the current state.
    39	func (b *Breaker) State() State {
    40		b.mu.Lock()
    41		defer b.mu.Unlock()
    42		return b.state
    43	}
    44	
    45	// IsClosed returns true if the breaker is closed.
    46	func (b *Breaker) IsClosed() bool {
    47		return b.State() == Closed
    48	}
    49	
    50	// IsOpen returns true if the breaker is open.
    51	func (b *Breaker) IsOpen() bool {
    52		return b.State() == Open
    53	}
    54	
    55	// IsHalfOpen returns true if the breaker is half-open.
    56	func (b *Breaker) IsHalfOpen() bool {
    57		return b.State() == HalfOpen
    58	}
    59	
    60	// Open forces the breaker open and restarts the timeout clock.
    61	func (b *Breaker) Open() {
    62		b.mu.Lock()
    63		defer b.mu.Unlock()
    64		now := time.Now()
    65		b.state = Open
    66		b.stateChangedAt = now
    67		b.openedAt = now
    68		b.consecutiveFailures++
    69		b.probeActive = false
    70	}
    71	
    72	// MaybeHalfOpen transitions from open to half_open if the timeout has elapsed.
    73	func (b *Breaker) MaybeHalfOpen() bool {
    74		b.mu.Lock()
    75		defer b.mu.Unlock()
    76		if b.state == Open && time.Since(b.openedAt) >= b.timeout {
    77			b.state = HalfOpen
    78			b.stateChangedAt = time.Now()
    79			b.probeActive = false
    80			return true
    81		}
    82		return false
    83	}
    84	
    85	// AcquireProbe attempts to take the single allowed half-open probe connection.
    86	func (b *Breaker) AcquireProbe() bool {
    87		b.mu.Lock()
    88		defer b.mu.Unlock()
    89		if b.state == HalfOpen && !b.probeActive {
    90			b.probeActive = true
    91			return true
    92		}
    93		return false
    94	}
    95	
    96	// ProbeSuccess closes the circuit and clears failure counts.
    97	func (b *Breaker) ProbeSuccess() {
    98		b.mu.Lock()
    99		defer b.mu.Unlock()
   100		now := time.Now()
   101		b.state = Closed
   102		b.stateChangedAt = now
   103		b.consecutiveFailures = 0
   104		b.probeActive = false
   105	}
   106	
   107	// ProbeFailure reopens the circuit and restarts the timeout.
   108	func (b *Breaker) ProbeFailure() {
   109		b.mu.Lock()
   110		defer b.mu.Unlock()
   111		now := time.Now()
   112		b.state = Open
   113		b.stateChangedAt = now
   114		b.openedAt = now
   115		b.consecutiveFailures++
   116		b.probeActive = false
   117	}
   118	
   119	// Reset forces the breaker closed and clears failure counts.
   120	func (b *Breaker) Reset() {
