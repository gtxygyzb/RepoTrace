[?2004l   118	func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {
   119		rawArgs, err := json.Marshal(args)
   120		if err != nil {
   121			return "", err
   122		}
   123		req := request{Cmd: ipcCmd, Args: rawArgs}
   124		reqBytes, err := json.Marshal(req)
   125		if err != nil {
   126			return "", err
   127		}
   128	
   129		conn, err := net.Dial("unix", "/tmp/meshd.sock")
   130		if err != nil {
   131			return "", fmt.Errorf("connect to meshd failed: %w", err)
   132		}
   133		defer conn.Close()
   134	
   135		fmt.Fprintf(conn, "%s\n", string(reqBytes))
   136	
   137		reader := bufio.NewReader(conn)
   138		line, err := reader.ReadString('\n')
   139		if err != nil {
   140			return "", err
   141		}
   142		line = strings.TrimRight(line, "\r\n")
   143	
   144		var resp response
   145		if err := json.Unmarshal([]byte(line), &resp); err != nil {
   146			return "", err
   147		}
   148		if resp.Status != "ok" {
   149			var msg string
   150			if err := json.Unmarshal(resp.Data, &msg); err == nil {
   151				return "", fmt.Errorf("%s", msg)
   152			}
   153			return "", fmt.Errorf("%s", string(resp.Data))
   154		}
   155		return prettyData(ipcCmd, resp.Data)
   156	}
   157	
   158	func prettyData(ipcCmd string, data json.RawMessage) (string, error) {
   159		switch ipcCmd {
   160		case "list_services":
   161			var services []struct {
   162				Name        string `json:"name"`
   163				ListenPort  int    `json:"listen_port"`
   164				RoutingMode string `json:"routing_mode"`
   165				Endpoints   []struct {
   166					Address           string `json:"address"`
   167					State             string `json:"state"`
   168					Weight            int    `json:"weight"`
   169					ActiveConnections int    `json:"active_connections"`
   170					CircuitState      string `json:"circuit_state"`
   171				} `json:"endpoints"`
   172			}
   173			if err := json.Unmarshal(data, &services); err != nil {
   174				return "", err
   175			}
   176			var b strings.Builder
   177			fmt.Fprintf(&b, "%-14s %-18s %-10s %-7s %-11s %-7s\n", "SERVICE", "ENDPOINT", "STATE", "WEIGHT", "CIRCUIT", "ACTIVE")
   178			for _, svc := range services {
   179				for _, ep := range svc.Endpoints {
   180					fmt.Fprintf(&b, "%-14s %-18s %-10s %-7d %-11s %-7d\n", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)
   181				}
   182			}
   183			return strings.TrimRight(b.String(), "\n"), nil
   184		case "resolve":
   185			var addr string
   186			if err := json.Unmarshal(data, &addr); err != nil {
   187				return "", err
   188			}
   189			return addr, nil
   190		case "get_circuit_breakers":
   191			var circuits []struct {
   192				Address             string `json:"address"`
   193				CircuitState        string `json:"circuit_state"`
   194				ConsecutiveFailures int    `json:"consecutive_failures"`
   195				TimeInStateMs       int64  `json:"time_in_state_ms"`
   196				ProbeActive         bool   `json:"probe_active"`
   197			}
   198			if err := json.Unmarshal(data, &circuits); err != nil {
   199				return "", err
   200			}
   201			var b strings.Builder
   202			fmt.Fprintf(&b, "%-18s %-11s %-9s %-17s %-7s\n", "ENDPOINT", "CIRCUIT", "FAILURES", "TIME_IN_STATE_MS", "PROBE")
   203			for _, c := range circuits {
   204				fmt.Fprintf(&b, "%-18s %-11s %-9d %-17d %-7t\n", c.Address, c.CircuitState, c.ConsecutiveFailures, c.TimeInStateMs, c.ProbeActive)
   205			}
   206			return strings.TrimRight(b.String(), "\n"), nil
   207		case "set_weight", "drain_endpoint", "reset_circuit_breaker", "reload_config":
   208			var s string
   209			if err := json.Unmarshal(data, &s); err != nil {
   210				return "", err
   211			}
   212			return s, nil
   213		default:
   214			var v interface{}
   215			if err := json.Unmarshal(data, &v); err != nil {
   216				return "", err
   217			}
   218			b, err := json.MarshalIndent(v, "", "  ")
   219			if err != nil {
   220				return "", err
   221			}
   222			return string(b), nil
   223		}
   224	}
