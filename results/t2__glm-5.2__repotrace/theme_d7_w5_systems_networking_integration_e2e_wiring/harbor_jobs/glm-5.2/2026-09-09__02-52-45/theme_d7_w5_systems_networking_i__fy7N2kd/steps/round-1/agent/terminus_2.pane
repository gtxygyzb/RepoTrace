   208	func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {
   209		data, err := sendRaw(ipcCmd, args)
   210		if err != nil {
   211			return "", err
   212		}
   213		return prettyData(ipcCmd, data)
   214	}
   215	
   216	func depsAll() (string, error) {
   217		raw, err := sendRaw("list_services", nil)
   218		if err != nil {
   219			return "", err
   220		}
   221		var services []struct {
   222			Name string `json:"name"`
   223		}
   224		if err := json.Unmarshal(raw, &services); err != nil {
   225			return "", err
   226		}
   227		type depRow struct {
   228			Service          string
   229			Name             string
   230			Available        bool
   231			HealthyEndpoints int
   232		}
   233		var rows []depRow
   234		for _, svc := range services {
   235			depRaw, err := sendRaw("get_dependencies", map[string]interface{}{"name": svc.Name})
   236			if err != nil {
   237				return "", err
   238			}
   239			var resp struct {
   240				Service      string `json:"service"`
   241				Dependencies []struct {
   242					Name             string `json:"name"`
   243					Available        bool   `json:"available"`
   244					HealthyEndpoints int    `json:"healthy_endpoints"`
   245				} `json:"dependencies"`
   246			}
   247			if err := json.Unmarshal(depRaw, &resp); err != nil {
   248				return "", err
   249			}
   250			for _, dep := range resp.Dependencies {
   251				rows = append(rows, depRow{Service: svc.Name, Name: dep.Name, Available: dep.Available, HealthyEndpoints: dep.HealthyEndpoints})
   252			}
   253		}
   254		if len(rows) == 0 {
   255			return "no dependencies", nil
   256		}
   257		var b strings.Builder
   258		fmt.Fprintf(&b, "%-14s %-14s %-10s %-18s\n", "SERVICE", "DEPENDS_ON", "AVAILABLE", "HEALTHY_ENDPOINTS")
   259		for _, row := range rows {
   260			fmt.Fprintf(&b, "%-14s %-14s %-10t %-18d\n", row.Service, row.Name, row.Available, row.HealthyEndpoints)
   261		}
   262		return strings.TrimRight(b.String(), "\n"), nil
   263	}
   264	
   265	func sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {
   266		rawArgs, err := json.Marshal(args)
   267		if err != nil {
   268			return nil, err
   269		}
   270		req := request{Cmd: ipcCmd, Args: rawArgs}
   271		reqBytes, err := json.Marshal(req)
   272		if err != nil {
   273			return nil, err
   274		}
   275	
   276		conn, err := net.Dial("unix", "/tmp/meshd.sock")
   277		if err != nil {
   278			return nil, fmt.Errorf("connect to meshd failed: %w", err)
   279		}
   280		defer conn.Close()
   281	
   282		fmt.Fprintf(conn, "%s\n", string(reqBytes))
   283	
   284		reader := bufio.NewReader(conn)
   285		line, err := reader.ReadString('\n')
   286		if err != nil {
   287			return nil, err
   288		}
   289		line = strings.TrimRight(line, "\r\n")
   290	
   291		var resp response
   292		if err := json.Unmarshal([]byte(line), &resp); err != nil {
   293			return nil, err
   294		}
   295		if resp.Status != "ok" {
   296			var msg string
   297			if err := json.Unmarshal(resp.Data, &msg); err == nil {
   298				return nil, fmt.Errorf("%s", msg)
   299			}
   300			return nil, fmt.Errorf("%s", string(resp.Data))
   301		}
   302		return resp.Data, nil
   303	}
