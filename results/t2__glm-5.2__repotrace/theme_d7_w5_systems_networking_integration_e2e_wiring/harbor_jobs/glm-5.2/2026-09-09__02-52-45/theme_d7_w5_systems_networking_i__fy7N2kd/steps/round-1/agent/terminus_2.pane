   194					Result:     result,
   195				})
   196			}
   197		}()
   198	
   199		ss := r.state.GetService(service)
   200		if ss == nil {
   201			result = "rejected_no_endpoint"
   202			client.Close()
   203			return
   204		}
   205	
   206		allowed, queued := ss.AcquireRateLimitToken()
