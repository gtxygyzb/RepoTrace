   255			Config:           cep,
   256			State:            Unknown,
   257			Circuit:          circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),
   258			Stats:            stats.New(time.Duration(global.StatsWindowSec) * time.Second),
   259			connections:      make(map[int64]*connectionInfo),
   260		}
