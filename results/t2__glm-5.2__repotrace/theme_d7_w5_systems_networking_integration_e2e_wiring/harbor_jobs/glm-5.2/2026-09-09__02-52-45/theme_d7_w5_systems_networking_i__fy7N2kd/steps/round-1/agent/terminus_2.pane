   394	func copyConn(dst io.Writer, src io.Reader, ep *state.EndpointState, id int64, direction string) (int64, error) {
   395		buf := make([]byte, 32*1024)
   396		var total int64
   397		for {
   398			n, err := src.Read(buf)
   399			if n > 0 {
   400				if _, werr := dst.Write(buf[:n]); werr != nil {
   401					return total, werr
   402				}
   403				total += int64(n)
   404				if direction == "in" {
   405					ep.UpdateConnectionActivity(id, int64(n), 0)
   406				} else {
   407					ep.UpdateConnectionActivity(id, 0, int64(n))
   408				}
   409			}
   410			if err != nil {
   411				return total, err
   412			}
   413		}
   414	}
