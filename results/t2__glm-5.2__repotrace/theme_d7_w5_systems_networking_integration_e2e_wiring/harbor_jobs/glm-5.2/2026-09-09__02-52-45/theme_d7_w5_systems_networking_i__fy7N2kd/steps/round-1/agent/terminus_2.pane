[?2004lpackage router

import (
	"io"
	"log"
	"net"
	"sync"
	"sync/atomic"
	"time"

	"meshrouter/internal/state"
)

type serviceListener struct {
	service  string
	port     int
	listener net.Listener
	stop     chan struct{}
	wg       sync.WaitGroup
	done     chan struct{}
}

type Router struct {
	state     *state.State
	mu        sync.Mutex
	listeners map[string]*serviceListener
}

func NewRouter(s *state.State) *Router {
	return &Router{
		state:     s,
		listeners: make(map[string]*serviceListener),
	}
}

func (r *Router) Start() {
	for _, ss := range r.state.Services() {
		if !ss.IsStopping() {
			r.startService(ss)
		}
	}
}

func (r *Router) Reload() {
	services := r.state.Services()
	seen := make(map[string]bool)
	for _, ss := range services {
		seen[ss.Name] = true
		r.mu.Lock()
		sl, ok := r.listeners[ss.Name]
		r.mu.Unlock()
		if !ok {
			if !ss.IsStopping() {
				r.startService(ss)
			}
			continue
		}
		if sl.port != ss.ListenPort {
			r.stopService(ss.Name, true)
			r.startService(ss)
		}
	}
	r.mu.Lock()
	for name := range r.listeners {
		if !seen[name] {
			r.mu.Unlock()
			r.stopService(name, true)
			r.mu.Lock()
		}
	}
	r.mu.Unlock()
}

func (r *Router) startService(ss *state.ServiceState) {
	addr := ":" + intToStr(ss.ListenPort)
	ln, err := net.Listen("tcp", addr)
	if err != nil {
		log.Printf("router: listen %s on %s failed: %v", ss.Name, addr, err)
		return
	}
	sl := &serviceListener{
		service:  ss.Name,
		port:     ss.ListenPort,
		listener: ln,
		stop:     make(chan struct{}),
		done:     make(chan struct{}),
	}
	r.mu.Lock()
	r.listeners[ss.Name] = sl
	r.mu.Unlock()
	go sl.acceptLoop(r)
}

func (r *Router) stopService(name string, drain bool) {
	r.mu.Lock()
	sl, ok := r.listeners[name]
	if ok {
		delete(r.listeners, name)
	}
	r.mu.Unlock()
	if !ok {
		return
	}
	sl.stopAccept(drain, r)
}

func (r *Router) Stop() {
	r.mu.Lock()
	listeners := r.listeners
	r.listeners = make(map[string]*serviceListener)
	r.mu.Unlock()
	var wg sync.WaitGroup
	for name, sl := range listeners {
		wg.Add(1)
		go func(name string, sl *serviceListener) {
			defer wg.Done()
			sl.stopAccept(true, r)
		}(name, sl)
	}
	wg.Wait()
}

func (sl *serviceListener) acceptLoop(r *Router) {
	defer close(sl.done)
	for {
		conn, err := sl.listener.Accept()
		if err != nil {
			return
		}
		sl.wg.Add(1)
		go func(c net.Conn) {
			defer sl.wg.Done()
			r.handleConn(sl.service, c)
		}(conn)
	}
}

func (sl *serviceListener) stopAccept(drain bool, r *Router) {
	select {
	case <-sl.stop:
	default:
		close(sl.stop)
	}
	sl.listener.Close()
	<-sl.done
	if drain {
		ss := r.state.GetService(sl.service)
		timeout := 5 * time.Second
		if ss != nil {
			timeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond
			if timeout <= 0 {
				timeout = 5 * time.Second
			}
		}
		done := make(chan struct{})
		go func() {
			sl.wg.Wait()
			close(done)
		}()
		select {
		case <-done:
		case <-time.After(timeout):
			r.state.CloseServiceConnections(sl.service)
			<-done
		}
	} else {
		sl.wg.Wait()
	}
}

func (r *Router) handleConn(service string, client net.Conn) {
	start := time.Now()
	ss := r.state.GetService(service)
	if ss == nil {
		client.Close()
		return
	}

	allowed, queued := ss.AcquireRateLimitToken()
	if !allowed {
		if queued {
			if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
				cand.Stats.RecordQueueTimeout()
			}
		} else {
			if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
				cand.Stats.RecordRateLimited()
			}
		}
		client.Close()
		return
	}
	if queued {
		if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
			cand.Stats.RecordQueued()
		}
	}

	maxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()
	var lastEndpoint *state.EndpointState
	for attempt := 0; ; attempt++ {
		res, err := r.state.SelectEndpointExcluding(service, lastEndpoint)
		if err != nil {
			if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
				ss := r.state.GetService(service)
				if ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {
					cand.Stats.RecordRejection()
				}
			}
			client.Close()
			return
		}
		lastEndpoint = res.Endpoint
		ep := res.Endpoint

		var id int64
		if !res.Probe {
			var ok bool
			id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)
			if !ok {
				ep.Stats.RecordRejection()
				client.Close()
				return
			}
		}

		backend, derr := net.Dial("tcp", ep.Address)
		if derr != nil {
			if id != 0 {
				ep.RemoveConnection(id)
			}
			ep.Stats.RecordConnection(0, 0, time.Since(start), true)
			if res.Probe {
				ep.Circuit.ProbeFailure()
			} else {
				ep.Circuit.Open()
			}
			if attempt >= maxRetries {
				client.Close()
				return
			}
			ep.Stats.RecordRetry()
			r.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)
			continue
		}

		if res.Probe {
			ep.Circuit.ProbeSuccess()
			var ok bool
			id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)
			if !ok {
				ep.Stats.RecordRejection()
				backend.Close()
				client.Close()
				return
			}
		}

		if attempt > 0 {
			ep.Stats.RecordRetrySuccess()
