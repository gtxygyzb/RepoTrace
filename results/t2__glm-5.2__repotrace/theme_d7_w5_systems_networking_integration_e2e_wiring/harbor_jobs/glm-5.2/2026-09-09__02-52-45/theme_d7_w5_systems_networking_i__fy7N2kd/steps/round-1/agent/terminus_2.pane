methods = '''
// MirrorConfig returns the mirror endpoint and sample percentage for a service.
func (ss *ServiceState) MirrorConfig() (string, int) {
	ss.mu.Lock()
	defer ss.mu.Unlock()
	return ss.MirrorEndpoint, ss.MirrorSamplePct
}

// IncrementMirroredConnections atomically increments the mirrored connection counter.
func (ss *ServiceState) IncrementMirroredConnections() {
	atomic.AddUint64(&ss.mirroredConnections, 1)
}

// MirroredConnections returns the number of mirrored connections since startup.
func (ss *ServiceState) MirroredConnections() uint64 {
	return atomic.LoadUint64(&ss.mirroredConnections)
}

// MirrorStatus returns the mirror endpoint, sample percentage, and mirrored connection count.
func (ss *ServiceState) MirrorStatus() (string, int, uint64) {
	ss.mu.Lock()
	defer ss.mu.Unlock()
	return ss.MirrorEndpoint, ss.MirrorSamplePct, atomic.LoadUint64(&ss.mirroredConnections)
}

func (ss *ServiceState) RetryConfig() (maxRetries int, delayMs int, multiplier float64, maxDelayMs int) {'''
