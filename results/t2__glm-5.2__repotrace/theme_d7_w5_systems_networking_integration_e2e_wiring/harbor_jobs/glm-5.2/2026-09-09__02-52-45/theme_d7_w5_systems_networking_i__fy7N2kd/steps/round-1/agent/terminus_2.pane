    43	func (r *Router) Reload() {
    44		services := r.state.Services()
    45		seen := make(map[string]bool)
    46		for _, ss := range services {
    47			seen[ss.Name] = true
    48			r.mu.Lock()
    49			sl, ok := r.listeners[ss.Name]
    50			r.mu.Unlock()
    51			if !ok {
    52				if !ss.IsStopping() {
    53					r.startService(ss)
    54				}
    55				continue
    56			}
    57			if sl.port != ss.ListenPort {
    58				r.stopService(ss.Name, true)
    59				r.startService(ss)
    60			}
    61		}
    62		r.mu.Lock()
    63		for name := range r.listeners {
    64			if !seen[name] {
    65				r.mu.Unlock()
    66				r.stopService(name, true)
    67				r.mu.Lock()
    68			}
    69		}
    70		r.mu.Unlock()
    71	}
