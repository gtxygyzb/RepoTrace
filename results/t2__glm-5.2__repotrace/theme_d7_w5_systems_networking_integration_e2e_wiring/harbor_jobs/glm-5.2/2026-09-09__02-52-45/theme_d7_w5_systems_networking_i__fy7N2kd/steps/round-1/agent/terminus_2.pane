[?2004lpackage config

import (
	"github.com/BurntSushi/toml"
)

// Global holds mesh-wide tuning parameters.
type Global struct {
	HealthIntervalMs        int `toml:"health_interval_ms"`
	UnhealthyThreshold      int `toml:"unhealthy_threshold"`
	HealthyThreshold        int `toml:"healthy_threshold"`
	StatsWindowSec          int `toml:"stats_window_sec"`
	CircuitBreakerThreshold int `toml:"circuit_breaker_threshold"`
	CircuitBreakerTimeoutMs int `toml:"circuit_breaker_timeout_ms"`
}

// Endpoint describes one backend endpoint from config.
type Endpoint struct {
	Address          string `toml:"address"`
	Weight           int    `toml:"weight"`
	WarmupDurationMs int    `toml:"warmup_duration_ms"`
	HealthCheck      string `toml:"health_check"`
	HealthPath       string `toml:"health_path"`
	HealthCmd        string `toml:"health_cmd"`
}

// Service describes one routed service from config.
type Service struct {
	Name                      string     `toml:"name"`
	ListenPort                int        `toml:"listen_port"`
	RoutingMode               string     `toml:"routing_mode"`
	DrainTimeoutMs            int        `toml:"drain_timeout_ms"`
	MaxConnectionsPerEndpoint int        `toml:"max_connections_per_endpoint"`
	ConnectionLimitMode       string     `toml:"connection_limit_mode"`
	RateLimitRps              int        `toml:"rate_limit_rps"`
	RateLimitBurst            int        `toml:"rate_limit_burst"`
	RateLimitQueueDepth       int        `toml:"rate_limit_queue_depth"`
	RateLimitQueueTimeoutMs   int        `toml:"rate_limit_queue_timeout_ms"`
	MaxRetries                int        `toml:"max_retries"`
	RetryDelayMs              int        `toml:"retry_delay_ms"`
	RetryBackoffMultiplier    float64    `toml:"retry_backoff_multiplier"`
	RetryMaxDelayMs           int        `toml:"retry_max_delay_ms"`
	IdleTimeoutMs             int        `toml:"idle_timeout_ms"`
	Endpoints                 []Endpoint `toml:"endpoint"`
}

// Config is the parsed application configuration.
type Config struct {
	Global   Global
	Services []Service `toml:"service"`
}

// Load reads and normalizes a TOML config file.
func Load(path string) (*Config, error) {
	var cfg Config
	if _, err := toml.DecodeFile(path, &cfg); err != nil {
		return nil, err
	}
	if cfg.Global.HealthIntervalMs <= 0 {
		cfg.Global.HealthIntervalMs = 2000
	}
	if cfg.Global.UnhealthyThreshold <= 0 {
		cfg.Global.UnhealthyThreshold = 3
	}
	if cfg.Global.HealthyThreshold <= 0 {
		cfg.Global.HealthyThreshold = 2
	}
	if cfg.Global.StatsWindowSec <= 0 {
		cfg.Global.StatsWindowSec = 60
	}
	if cfg.Global.CircuitBreakerThreshold <= 0 {
		cfg.Global.CircuitBreakerThreshold = 3
	}
	if cfg.Global.CircuitBreakerTimeoutMs <= 0 {
		cfg.Global.CircuitBreakerTimeoutMs = 5000
	}
	for i := range cfg.Services {
		s := &cfg.Services[i]
		if s.RoutingMode == "" {
			s.RoutingMode = "weighted-round-robin"
		}
		if s.DrainTimeoutMs <= 0 {
			s.DrainTimeoutMs = 5000
		}
		if s.MaxConnectionsPerEndpoint <= 0 {
			s.MaxConnectionsPerEndpoint = 100
		}
		if s.ConnectionLimitMode == "" {
			s.ConnectionLimitMode = "per-endpoint"
		}
		if s.RateLimitBurst <= 0 {
			s.RateLimitBurst = s.RateLimitRps
		}
		if s.RateLimitQueueTimeoutMs <= 0 {
			s.RateLimitQueueTimeoutMs = 1000
		}
		if s.RetryDelayMs <= 0 {
			s.RetryDelayMs = 100
		}
		if s.RetryBackoffMultiplier <= 0 {
			s.RetryBackoffMultiplier = 2.0
		}
		if s.RetryMaxDelayMs <= 0 {
			s.RetryMaxDelayMs = 5000
		}
		for j := range s.Endpoints {
			ep := &s.Endpoints[j]
			if ep.HealthCheck == "" {
				ep.HealthCheck = "tcp"
			}
			if ep.Weight < 0 {
				ep.Weight = 0
			}
			if ep.WarmupDurationMs < 0 {
				ep.WarmupDurationMs = 0
			}
		}
	}
	return &cfg, nil
}
[?2004hroot@n30009:/app# sed -n '1,260p' internal/state/state.go
[?2004lpackage state

import (
	"net"
	"sort"
	"sync"
	"sync/atomic"
	"time"

	"meshrouter/internal/circuit"
	"meshrouter/internal/config"
	"meshrouter/internal/stats"
)

type HealthState string

const (
	Unknown   HealthState = "unknown"
	Healthy   HealthState = "healthy"
	Unhealthy HealthState = "unhealthy"
	Draining  HealthState = "draining"
)

type HealthEvent struct {
	Timestamp   time.Time
	Endpoint    string
	OldState    HealthState
	NewState    HealthState
	CheckResult string
}

type EndpointState struct {
	mu                sync.Mutex
	Address           string
	Weight            int
	Config            config.Endpoint
	State             HealthState
	ActiveConnections int
	Circuit           *circuit.Breaker
	Stats             *stats.Collector
	consecSuccess     int
	consecFailures    int
	drainDeadline     time.Time
	removed           bool
	connIDCounter     int64
	currentWeight     int
	WarmupDurationMs  int
	warmupUntil       time.Time
	connections       map[int64]*connectionInfo
}

type connectionInfo struct {
	conn         net.Conn
	clientAddr   string
	start        time.Time
	lastActivity time.Time
	bytesIn      int64
	bytesOut     int64
}

type ServiceState struct {
	mu                        sync.Mutex
	Name                      string
	ListenPort                int
	RoutingMode               string
	DrainTimeoutMs            int
	MaxConnectionsPerEndpoint int
	ConnectionLimitMode       string
	IdleTimeoutMs             int
	RateLimitRps              int
	RateLimitBurst            int
	RateLimitQueueDepth       int
	RateLimitQueueTimeoutMs   int
	MaxRetries                int
	RetryDelayMs              int
	RetryBackoffMultiplier    float64
	RetryMaxDelayMs           int
	rateLimiter               *rateLimiter
	Endpoints                 []*EndpointState
	rrIndex                   int
	Listener                  net.Listener
	listenerStop              chan struct{}
	stopping                  bool
}

type State struct {
	mu         sync.RWMutex
	configPath string
	global     config.Global
	services   map[string]*ServiceState
	logMu      sync.Mutex
	healthLog  map[string][]HealthEvent
	reloadCh   chan struct{}
}

func NewState(cfg *config.Config, path string) *State {
	s := &State{
		configPath: path,
		services:   make(map[string]*ServiceState),
		healthLog:  make(map[string][]HealthEvent),
		reloadCh:   make(chan struct{}, 1),
	}
	s.applyConfigLocked(cfg)
	return s
}

func (s *State) ReloadChan() <-chan struct{} {
	return s.reloadCh
}

func (s *State) ConfigPath() string {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return s.configPath
}

func (s *State) Global() config.Global {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return s.global
}

func (s *State) ApplyConfig(cfg *config.Config) {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.applyConfigLocked(cfg)
	select {
	case s.reloadCh <- struct{}{}:
	default:
	}
}

func (s *State) applyConfigLocked(cfg *config.Config) {
	s.global = cfg.Global
	seen := make(map[string]bool)
	for _, svc := range cfg.Services {
		seen[svc.Name] = true
		ss := s.services[svc.Name]
		if ss == nil {
			ss = newServiceState(svc, cfg.Global)
			s.services[svc.Name] = ss
		} else {
			ss.mu.Lock()
			ss.Name = svc.Name
			ss.ListenPort = svc.ListenPort
			ss.RoutingMode = svc.RoutingMode
			ss.DrainTimeoutMs = svc.DrainTimeoutMs
			ss.RateLimitRps = svc.RateLimitRps
			ss.RateLimitBurst = svc.RateLimitBurst
			ss.RateLimitQueueDepth = svc.RateLimitQueueDepth
			ss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs
			ss.MaxRetries = svc.MaxRetries
			ss.RetryDelayMs = svc.RetryDelayMs
			ss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier
			ss.RetryMaxDelayMs = svc.RetryMaxDelayMs
			if ss.rateLimiter == nil {
				ss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
			} else {
				ss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
			}
			ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint
			ss.ConnectionLimitMode = svc.ConnectionLimitMode
			ss.IdleTimeoutMs = svc.IdleTimeoutMs
			ss.mu.Unlock()
			ss.applyEndpoints(svc.Endpoints, cfg.Global)
		}
	}
	for name, ss := range s.services {
		if !seen[name] {
			ss.mu.Lock()
			ss.stopping = true
			if ss.listenerStop != nil {
				close(ss.listenerStop)
				ss.listenerStop = nil
			}
			if ss.Listener != nil {
				ss.Listener.Close()
				ss.Listener = nil
			}
			ss.mu.Unlock()
			for _, ep := range ss.Endpoints {
				ep.StartDraining(ss.DrainTimeoutMs, true)
			}
		}
	}
}

func newServiceState(svc config.Service, global config.Global) *ServiceState {
	ss := &ServiceState{
		Name:                      svc.Name,
		ListenPort:                svc.ListenPort,
		RoutingMode:               svc.RoutingMode,
		DrainTimeoutMs:            svc.DrainTimeoutMs,
		RateLimitRps:              svc.RateLimitRps,
		RateLimitBurst:            svc.RateLimitBurst,
		RateLimitQueueDepth:       svc.RateLimitQueueDepth,
		RateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,
		MaxRetries:                svc.MaxRetries,
		RetryDelayMs:              svc.RetryDelayMs,
		RetryBackoffMultiplier:    svc.RetryBackoffMultiplier,
		RetryMaxDelayMs:           svc.RetryMaxDelayMs,
		rateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),
		MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,
		ConnectionLimitMode:       svc.ConnectionLimitMode,
		IdleTimeoutMs:             svc.IdleTimeoutMs,
		listenerStop:              nil,
	}
	for _, ep := range svc.Endpoints {
		ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))
	}
	return ss
}

func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {
	ss.mu.Lock()
	defer ss.mu.Unlock()
	seen := make(map[string]bool)
	for _, cep := range eps {
		seen[cep.Address] = true
		var ep *EndpointState
		for _, existing := range ss.Endpoints {
			if existing.Address == cep.Address {
				ep = existing
				break
			}
		}
		if ep == nil {
			ep = newEndpointState(cep, global)
			ss.Endpoints = append(ss.Endpoints, ep)
		} else {
			ep.mu.Lock()
			ep.Config = cep
			ep.Weight = cep.Weight
			ep.WarmupDurationMs = cep.WarmupDurationMs
			ep.mu.Unlock()
		}
	}
	for _, ep := range ss.Endpoints {
		if !seen[ep.Address] {
			ep.StartDraining(ss.DrainTimeoutMs, true)
		}
	}
}

func newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {
	return &EndpointState{
		Address:          cep.Address,
		Weight:           cep.Weight,
		WarmupDurationMs: cep.WarmupDurationMs,
		Config:           cep,
		State:            Unknown,
		Circuit:          circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),
		Stats:            stats.New(time.Duration(global.StatsWindowSec) * time.Second),
		connections:      make(map[int64]*connectionInfo),
	}
}

func (s *State) GetService(name string) *ServiceState {
	s.mu.RLock()
	defer s.mu.RUnlock()
