   172	func (r *Router) handleConn(service string, client net.Conn) {
   173		start := time.Now()
   174		clientAddr := ""
   175		if addr := client.RemoteAddr(); addr != nil {
   176			clientAddr = addr.String()
   177		}
   178	
   179		var endpoint string
   180		var bytesIn, bytesOut int64
   181		var result string
   182		defer func() {
   183			if result == "" {
   184				result = "success"
   185			}
   186			if r.accessLog != nil {
   187				r.accessLog.Log(accesslog.Entry{
   188					Service:    service,
   189					Client:     clientAddr,
   190					Endpoint:   endpoint,
   191					BytesIn:    bytesIn,
   192					BytesOut:   bytesOut,
   193					DurationMs: time.Since(start).Milliseconds(),
   194					Result:     result,
   195				})
   196			}
   197		}()
   198	
   199		ss := r.state.GetService(service)
   200		if ss == nil {
   201			result = "rejected_no_endpoint"
   202			client.Close()
   203			return
   204		}
   205	
   206		allowed, queued := ss.AcquireRateLimitToken()
   207		if !allowed {
   208			result = "rejected_rate_limit"
   209			client.Close()
   210			return
   211		}
   212		if queued {
   213			if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   214				cand.Stats.RecordQueued()
   215			}
   216		}
   217	
   218		maxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()
   219		var lastEndpoint *state.EndpointState
   220		for attempt := 0; ; attempt++ {
   221			res, err := r.state.SelectEndpointExcluding(service, lastEndpoint)
   222			if err != nil {
   223				result = "rejected_no_endpoint"
   224				client.Close()
   225				return
   226			}
   227			lastEndpoint = res.Endpoint
   228			ep := res.Endpoint
   229			endpoint = ep.Address
   230	
   231			var id int64
   232			if !res.Probe {
   233				var ok bool
   234				id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)
   235				if !ok {
   236					result = "rejected_conn_limit"
   237					ep.Stats.RecordRejection()
   238					client.Close()
   239					return
   240				}
   241			}
   242	
   243			backend, derr := net.Dial("tcp", ep.Address)
   244			if derr != nil {
   245				if id != 0 {
   246					ep.RemoveConnection(id)
   247				}
   248				ep.Stats.RecordConnection(0, 0, time.Since(start), true)
   249				if res.Probe {
   250					ep.Circuit.ProbeFailure()
   251				} else {
   252					ep.Circuit.Open()
   253				}
   254				if attempt >= maxRetries {
   255					result = "retry_exhausted"
   256					client.Close()
   257					return
   258				}
   259				ep.Stats.RecordRetry()
   260				r.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)
   261				continue
   262			}
   263	
   264			if res.Probe {
   265				ep.Circuit.ProbeSuccess()
   266				var ok bool
   267				id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)
   268				if !ok {
   269					result = "rejected_conn_limit"
   270					ep.Stats.RecordRejection()
   271					backend.Close()
   272					client.Close()
   273					return
   274				}
   275			}
