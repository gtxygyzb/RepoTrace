[?2004l     1	package state
     2	
     3	import (
     4		"sort"
     5		"time"
     6	)
     7	
     8	// SelectResult contains selected endpoint and whether it is a half-open probe.
     9	type SelectResult struct {
    10		Endpoint *EndpointState
    11		Probe    bool
    12		MaxConns int
    13	}
    14	
    15	// SelectEndpoint chooses an endpoint for the next connection.
    16	func (s *State) SelectEndpoint(service string) (SelectResult, error) {
    17		ss := s.GetService(service)
    18		if ss == nil {
    19			return SelectResult{}, errNotFound("service not found")
    20		}
    21		ss.mu.Lock()
    22		maxConns := ss.MaxConnectionsPerEndpoint
    23		mode := ss.RoutingMode
    24		endpoints := make([]*EndpointState, len(ss.Endpoints))
    25		copy(endpoints, ss.Endpoints)
    26		ss.mu.Unlock()
    27	
    28		now := time.Now()
    29		_ = now
    30	
    31		var regular []*EndpointState
    32		for _, ep := range endpoints {
    33			ep.mu.Lock()
    34			eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
    35			ep.mu.Unlock()
    36			if eligible {
    37				regular = append(regular, ep)
    38			}
    39		}
    40	
    41		if len(regular) > 0 {
    42			if mode == "least-connections" {
    43				return SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil
    44			}
    45			return SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil
    46		}
    47	
    48		for _, ep := range endpoints {
    49			ep.mu.Lock()
    50			halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
    51			ep.mu.Unlock()
    52			if halfOpen && ep.Circuit.AcquireProbe() {
    53				return SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil
    54			}
    55		}
    56		return SelectResult{}, errNotFound("no eligible endpoints")
    57	}
    58	
    59	// SelectCandidate returns the endpoint that would be selected ignoring connection limits.
    60	// Used to account rejected_connections when all eligible endpoints are at capacity.
    61	func (s *State) SelectCandidate(service string) (*EndpointState, error) {
    62		ss := s.GetService(service)
    63		if ss == nil {
    64			return nil, errNotFound("service not found")
    65		}
    66		ss.mu.Lock()
    67		mode := ss.RoutingMode
    68		endpoints := make([]*EndpointState, len(ss.Endpoints))
    69		copy(endpoints, ss.Endpoints)
    70		ss.mu.Unlock()
    71	
    72		var regular []*EndpointState
    73		for _, ep := range endpoints {
    74			ep.mu.Lock()
    75			eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining
    76			ep.mu.Unlock()
    77			if eligible {
    78				regular = append(regular, ep)
    79			}
    80		}
    81		if len(regular) == 0 {
    82			for _, ep := range endpoints {
    83				ep.mu.Lock()
    84				halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining
    85				ep.mu.Unlock()
    86				if halfOpen {
    87					return ep, nil
    88				}
    89			}
    90			return nil, errNotFound("no eligible endpoints")
    91		}
    92		if mode == "least-connections" {
    93			return selectLeastConnections(regular, 1<<30), nil
    94		}
    95		return selectWeightedCandidate(regular), nil
    96	}
    97	
    98	func selectWeighted(eps []*EndpointState) *EndpointState {
    99		var best *EndpointState
   100		var bestWeight int
   101		var totalWeight int
   102		for _, ep := range eps {
   103			ep.mu.Lock()
   104			ep.currentWeight += ep.Weight
   105			totalWeight += ep.Weight
   106			cw := ep.currentWeight
   107			ep.mu.Unlock()
   108			if best == nil || cw > bestWeight {
   109				best = ep
   110				bestWeight = cw
   111			}
   112		}
   113		if best != nil {
   114			best.mu.Lock()
   115			best.currentWeight -= totalWeight
   116			best.mu.Unlock()
   117		}
   118		return best
   119	}
   120	
   121	func selectWeightedCandidate(eps []*EndpointState) *EndpointState {
   122		var best *EndpointState
   123		var bestWeight int
   124		for _, ep := range eps {
   125			ep.mu.Lock()
   126			cw := ep.currentWeight + ep.Weight
   127			ep.mu.Unlock()
   128			if best == nil || cw > bestWeight {
   129				best = ep
   130				bestWeight = cw
   131			}
   132		}
   133		return best
   134	}
   135	
   136	func selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {
   137		sort.SliceStable(eps, func(i, j int) bool {
   138			ai := eps[i].Active()
   139			aj := eps[j].Active()
   140			if ai != aj {
   141				return ai < aj
   142			}
   143			// Tie-break by weight (higher weight first), then lexicographic address.
   144			wi := eps[i].Weight
   145			wj := eps[j].Weight
   146			if wi != wj {
   147				return wi > wj
   148			}
   149			return eps[i].Address < eps[j].Address
   150		})
   151		return eps[0]
   152	}
   153	
   154	// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.
   155	func (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {
   156		ss := s.GetService(service)
   157		if ss == nil {
   158			return SelectResult{}, errNotFound("service not found")
   159		}
   160		ss.mu.Lock()
   161		maxConns := ss.MaxConnectionsPerEndpoint
   162		mode := ss.RoutingMode
   163		endpoints := make([]*EndpointState, len(ss.Endpoints))
   164		copy(endpoints, ss.Endpoints)
   165		ss.mu.Unlock()
   166	
   167		var regular []*EndpointState
   168		for _, ep := range endpoints {
   169			if exclude != nil && ep == exclude {
   170				continue
   171			}
   172			ep.mu.Lock()
   173			eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
   174			ep.mu.Unlock()
   175			if eligible {
   176				regular = append(regular, ep)
   177			}
   178		}
   179	
   180		if len(regular) > 0 {
   181			if mode == "least-connections" {
   182				return SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil
   183			}
   184			return SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil
   185		}
   186	
   187		for _, ep := range endpoints {
   188			if exclude != nil && ep == exclude {
   189				continue
   190			}
   191			ep.mu.Lock()
   192			halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns
   193			ep.mu.Unlock()
   194			if halfOpen && ep.Circuit.AcquireProbe() {
   195				return SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil
   196			}
   197		}
   198		return SelectResult{}, errNotFound("no eligible endpoints")
   199	}
