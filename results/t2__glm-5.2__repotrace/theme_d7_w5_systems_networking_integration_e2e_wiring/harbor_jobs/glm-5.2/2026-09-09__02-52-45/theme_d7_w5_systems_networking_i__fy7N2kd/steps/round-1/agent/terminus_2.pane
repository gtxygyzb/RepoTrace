[?2004lpackage router

import (
	"io"
	"log"
	"net"
	"sync"
	"sync/atomic"
	"time"

	"meshrouter/internal/accesslog"
	"meshrouter/internal/state"
)

type serviceListener struct {
	service  string
	port     int
	listener net.Listener
	stop     chan struct{}
	wg       sync.WaitGroup
	done     chan struct{}
}

type Router struct {
	state     *state.State
	accessLog *accesslog.Logger
	mu        sync.Mutex
	listeners map[string]*serviceListener
}

func NewRouter(s *state.State) *Router {
	return &Router{
		state:     s,
		listeners: make(map[string]*serviceListener),
	}
}

func (r *Router) SetAccessLogger(l *accesslog.Logger) {
	r.accessLog = l
}

func (r *Router) Start() {
	for _, ss := range r.state.Services() {
		if !ss.IsStopping() {
			r.startService(ss)
		}
	}
}

func (r *Router) Reload() {
	services := r.state.Services()
	seen := make(map[string]bool)
	for _, ss := range services {
		seen[ss.Name] = true
		r.mu.Lock()
		sl, ok := r.listeners[ss.Name]
		r.mu.Unlock()
		if !ok {
			if !ss.IsStopping() {
				r.startService(ss)
			}
			continue
		}
		if sl.port != ss.ListenPort {
			r.stopService(ss.Name, true)
			r.startService(ss)
		}
	}
	r.mu.Lock()
	for name := range r.listeners {
		if !seen[name] {
			r.mu.Unlock()
			r.stopService(name, true)
			r.mu.Lock()
		}
	}
	r.mu.Unlock()
}

func (r *Router) startService(ss *state.ServiceState) {
	addr := ":" + intToStr(ss.ListenPort)
	ln, err := net.Listen("tcp", addr)
	if err != nil {
		log.Printf("router: listen %s on %s failed: %v", ss.Name, addr, err)
		return
	}
	sl := &serviceListener{
		service:  ss.Name,
		port:     ss.ListenPort,
		listener: ln,
		stop:     make(chan struct{}),
		done:     make(chan struct{}),
	}
	r.mu.Lock()
	r.listeners[ss.Name] = sl
	r.mu.Unlock()
	go sl.acceptLoop(r)
}

func (r *Router) stopService(name string, drain bool) {
	r.mu.Lock()
	sl, ok := r.listeners[name]
	if ok {
		delete(r.listeners, name)
	}
	r.mu.Unlock()
	if !ok {
		return
	}
	sl.stopAccept(drain, r)
}

func (r *Router) Stop() {
	r.mu.Lock()
	listeners := r.listeners
	r.listeners = make(map[string]*serviceListener)
	r.mu.Unlock()
	var wg sync.WaitGroup
	for name, sl := range listeners {
		wg.Add(1)
		go func(name string, sl *serviceListener) {
			defer wg.Done()
			sl.stopAccept(true, r)
		}(name, sl)
	}
	wg.Wait()
}

func (sl *serviceListener) acceptLoop(r *Router) {
	defer close(sl.done)
	for {
		conn, err := sl.listener.Accept()
		if err != nil {
			return
		}
		sl.wg.Add(1)
		go func(c net.Conn) {
			defer sl.wg.Done()
			r.handleConn(sl.service, c)
		}(conn)
	}
}

func (sl *serviceListener) stopAccept(drain bool, r *Router) {
	select {
	case <-sl.stop:
	default:
		close(sl.stop)
	}
	sl.listener.Close()
	<-sl.done
	if drain {
		ss := r.state.GetService(sl.service)
		timeout := 5 * time.Second
		if ss != nil {
			timeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond
			if timeout <= 0 {
				timeout = 5 * time.Second
			}
		}
		done := make(chan struct{})
		go func() {
			sl.wg.Wait()
			close(done)
		}()
		select {
		case <-done:
		case <-time.After(timeout):
			r.state.CloseServiceConnections(sl.service)
			<-done
		}
	} else {
		sl.wg.Wait()
	}
}

func (r *Router) handleConn(service string, client net.Conn) {
	start := time.Now()
	clientAddr := ""
	if addr := client.RemoteAddr(); addr != nil {
		clientAddr = addr.String()
	}

	var endpoint string
	var bytesIn, bytesOut int64
	var result string
	var retryCount int
	var queueWaitMs *int64
	var failedDependency string
	defer func() {
		if result == "" {
			result = "success"
		}
		if r.accessLog != nil {
			r.accessLog.Log(accesslog.Entry{
				Service:          service,
				Client:           clientAddr,
				Endpoint:         endpoint,
				BytesIn:          bytesIn,
				BytesOut:         bytesOut,
				DurationMs:       time.Since(start).Milliseconds(),
				Result:           result,
				Retried:          retryCount > 0,
				RetryCount:       retryCount,
				QueueWaitMs:      queueWaitMs,
				FailedDependency: failedDependency,
			})
		}
	}()

	ss := r.state.GetService(service)
	if ss == nil {
		result = "rejected_no_endpoint"
		client.Close()
		return
	}

	if failedDep, _ := r.state.CheckDependencies(service); failedDep != "" {
		result = "rejected_dependency"
		failedDependency = failedDep
		ss.Stats.RecordDependencyRejection()
		client.Close()
		return
	}

	allowed, queued, waitMs, _ := ss.AcquireRateLimitToken()
	if !allowed {
		result = "rejected_rate_limit"
		queueWaitMs = &waitMs
		client.Close()
		return
	}
	if queued {
		if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
			cand.Stats.RecordQueued()
		}
	}

	maxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()
	var lastEndpoint *state.EndpointState
	for attempt := 0; ; attempt++ {
		res, err := r.state.SelectEndpointExcluding(service, lastEndpoint)
		if err != nil {
			result = "rejected_no_endpoint"
			endpoint = ""
			if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
				ss := r.state.GetService(service)
				if ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {
					cand.Stats.RecordRejection()
				}
			}
			client.Close()
			return
		}
		lastEndpoint = res.Endpoint
		ep := res.Endpoint
		endpoint = ep.Address

		var id int64
		if !res.Probe {
			var ok bool
			id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)
			if !ok {
				result = "rejected_conn_limit"
				ep.Stats.RecordRejection()
				client.Close()
				return
			}
		}

		backend, derr := net.Dial("tcp", ep.Address)
		if derr != nil {
			if id != 0 {
				ep.RemoveConnection(id)
			}
			ep.Stats.RecordConnection(0, 0, time.Since(start), true)
			if res.Probe {
				ep.Circuit.ProbeFailure()
			} else {
				ep.Circuit.Open()
			}
			if attempt >= maxRetries {
				result = "retry_exhausted"
				client.Close()
				return
			}
			retryCount++
			ep.Stats.RecordRetry()
			r.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)
			continue
		}

		if res.Probe {
			ep.Circuit.ProbeSuccess()
			var ok bool
			id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)
			if !ok {
				result = "rejected_conn_limit"
				ep.Stats.RecordRejection()
				backend.Close()
				client.Close()
				return
			}
		}

		if attempt > 0 {
			ep.Stats.RecordRetrySuccess()
		}
		bytesIn, bytesOut, idleClosed := forward(client, backend, ep, id, ss.IdleTimeout())
		backend.Close()
		client.Close()
		ep.RemoveConnection(id)
		ep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)
		if idleClosed {
			result = "idle_timeout"
			ep.Stats.RecordIdleTimeout()
		} else {
			result = "success"
		}
		return
	}
}

func (r *Router) sleepRetry(attempt, delayMs int, multiplier float64, maxDelayMs int) {
	if attempt < 0 {
		attempt = 0
	}
	delay := float64(delayMs) * pow(multiplier, float64(attempt))
	if maxDelayMs > 0 && delay > float64(maxDelayMs) {
		delay = float64(maxDelayMs)
	}
	if delay > 0 {
		time.Sleep(time.Duration(delay) * time.Millisecond)
	}
}

func pow(base, exp float64) float64 {
	result := 1.0
	for i := 0; i < int(exp); i++ {
		result *= base
[?2004hroot@n30009:/app# sed -n '1,280p' internal/accesslog/logger.go
[?2004lpackage accesslog

import (
	"encoding/json"
	"os"
	"path/filepath"
	"sync"
	"sync/atomic"
	"time"
)

// Entry is one structured access log record.
type Entry struct {
	Ts               string `json:"ts"`
	Service          string `json:"service"`
	Client           string `json:"client"`
	Endpoint         string `json:"endpoint"`
	BytesIn          int64  `json:"bytes_in"`
	BytesOut         int64  `json:"bytes_out"`
	DurationMs       int64  `json:"duration_ms"`
	Result           string `json:"result"`
	Retried          bool   `json:"retried"`
	RetryCount       int    `json:"retry_count"`
	QueueWaitMs      *int64 `json:"queue_wait_ms,omitempty"`
	FailedDependency string `json:"failed_dependency,omitempty"`
}

// DefaultPath is the access log path required by meshrouter.
const DefaultPath = "/app/logs/access.log"

const maxFileSize = 1 << 20 // 1 MB

// Logger writes access log entries asynchronously to a JSON-lines file.
type Logger struct {
	path     string
	ch       chan Entry
	stop     chan struct{}
	done     chan struct{}
	stopped  int32
	stopOnce sync.Once
	mu       sync.Mutex
	file     *os.File
	size     int64
}

// New creates a Logger for path and starts its writer goroutine.
func New(path string) *Logger {
	if path == "" {
		path = DefaultPath
	}
	l := &Logger{
		path: path,
		ch:   make(chan Entry, 8192),
		stop: make(chan struct{}),
		done: make(chan struct{}),
	}
	go l.run()
	return l
}

// Path returns the configured log file path.
func (l *Logger) Path() string {
	return l.path
}

// Log queues an entry for asynchronous writing. If the buffered channel is full,
// the entry is written synchronously to avoid losing it.
func (l *Logger) Log(entry Entry) {
	if atomic.LoadInt32(&l.stopped) != 0 {
		return
	}
	entry.Ts = time.Now().UTC().Format(time.RFC3339Nano)
	select {
	case l.ch <- entry:
	default:
		l.writeLine(entry)
	}
}

// Stop flushes all buffered entries and closes the log file.
func (l *Logger) Stop() {
	l.stopOnce.Do(func() {
		atomic.StoreInt32(&l.stopped, 1)
		close(l.stop)
		<-l.done
		l.mu.Lock()
		if l.file != nil {
			l.file.Close()
			l.file = nil
		}
		l.mu.Unlock()
	})
}

func (l *Logger) run() {
	for {
		select {
		case e := <-l.ch:
			l.writeLine(e)
		case <-l.stop:
			l.drain()
			close(l.done)
			return
		}
	}
}

func (l *Logger) drain() {
	for {
		select {
		case e := <-l.ch:
			l.writeLine(e)
		default:
			return
		}
	}
}

func (l *Logger) writeLine(e Entry) {
	b, err := json.Marshal(e)
	if err != nil {
		return
	}
	b = append(b, '\n')

	l.mu.Lock()
	defer l.mu.Unlock()

	if l.file == nil {
		if err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {
			return
		}
		f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
		if err != nil {
			return
		}
		l.file = f
		if info, err := f.Stat(); err == nil {
			l.size = info.Size()
		}
	}

	if l.size > 0 && l.size+int64(len(b)) > maxFileSize {
		l.rotateLocked()
	}

	n, err := l.file.Write(b)
	if err != nil {
		l.size = 0
		if l.file != nil {
			l.file.Close()
			l.file = nil
		}
		return
	}
	l.size += int64(n)
}

func (l *Logger) rotateLocked() {
	if l.file != nil {
		l.file.Close()
		l.file = nil
	}
	os.Remove(l.path + ".1")
	if err := os.Rename(l.path, l.path+".1"); err != nil {
		f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
		if err == nil {
			l.file = f
			if info, err := f.Stat(); err == nil {
				l.size = info.Size()
			}
		}
		return
	}
	f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
	if err != nil {
		l.size = 0
		return
	}
	l.file = f
	l.size = 0
}
