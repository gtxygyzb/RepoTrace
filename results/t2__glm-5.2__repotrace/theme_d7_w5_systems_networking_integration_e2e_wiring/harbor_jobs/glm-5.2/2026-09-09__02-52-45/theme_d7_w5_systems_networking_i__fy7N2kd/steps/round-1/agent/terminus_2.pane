[?2004lpackage ipc

import (
	"bufio"
	"encoding/json"
	"errors"
	"fmt"
	"net"
	"os"
	"strconv"
	"strings"
	"sync"

	"meshrouter/internal/config"
	"meshrouter/internal/state"
)

type Request struct {
	Cmd  string          `json:"cmd"`
	Args json.RawMessage `json:"args"`
}

type Response struct {
	Status string      `json:"status"`
	Data   interface{} `json:"data"`
}

type Server struct {
	state    *state.State
	path     string
	listener net.Listener
	wg       sync.WaitGroup
	stop     chan struct{}
	done     chan struct{}
}

func NewServer(s *state.State, path string) *Server {
	return &Server{
		state: s,
		path:  path,
		stop:  make(chan struct{}),
		done:  make(chan struct{}),
	}
}

func (s *Server) Start() error {
	os.Remove(s.path)
	ln, err := net.Listen("unix", s.path)
	if err != nil {
		return err
	}
	s.listener = ln
	go s.acceptLoop()
	return nil
}

func (s *Server) Stop() {
	select {
	case <-s.stop:
	default:
		close(s.stop)
	}
	if s.listener != nil {
		s.listener.Close()
	}
	<-s.done
	os.Remove(s.path)
}

func (s *Server) acceptLoop() {
	defer close(s.done)
	for {
		conn, err := s.listener.Accept()
		if err != nil {
			return
		}
		s.wg.Add(1)
		go s.handleConn(conn)
	}
}

func (s *Server) handleConn(conn net.Conn) {
	defer s.wg.Done()
	defer conn.Close()
	reader := bufio.NewReader(conn)
	for {
		line, err := reader.ReadString('\n')
		if err != nil {
			return
		}
		line = strings.TrimRight(line, "\r\n")
		if line == "" {
			continue
		}
		resp := s.handleLine(line)
		_, _ = conn.Write([]byte(resp + "\n"))
	}
}

func (s *Server) handleLine(line string) string {
	var req Request
	if err := json.Unmarshal([]byte(line), &req); err != nil {
		return encodeResp(Response{Status: "error", Data: err.Error()})
	}
	data, err := s.dispatch(req)
	if err != nil {
		return encodeResp(Response{Status: "error", Data: err.Error()})
	}
	return encodeResp(Response{Status: "ok", Data: data})
}

func encodeResp(r Response) string {
	b, _ := json.Marshal(r)
	return string(b)
}

func (s *Server) dispatch(req Request) (interface{}, error) {
	switch req.Cmd {
	case "list_services":
