[?2004l     1	package router
     2	
     3	import (
     4		"io"
     5		"log"
     6		"net"
     7		"sync"
     8		"time"
     9	
    10		"meshrouter/internal/state"
    11	)
    12	
    13	type serviceListener struct {
    14		service  string
    15		port     int
    16		listener net.Listener
    17		stop     chan struct{}
    18		wg       sync.WaitGroup
    19		done     chan struct{}
    20	}
    21	
    22	type Router struct {
    23		state     *state.State
    24		mu        sync.Mutex
    25		listeners map[string]*serviceListener
    26	}
    27	
    28	func NewRouter(s *state.State) *Router {
    29		return &Router{
    30			state:     s,
    31			listeners: make(map[string]*serviceListener),
    32		}
    33	}
    34	
    35	func (r *Router) Start() {
    36		for _, ss := range r.state.Services() {
    37			if !ss.IsStopping() {
    38				r.startService(ss)
    39			}
    40		}
    41	}
    42	
    43	func (r *Router) Reload() {
    44		services := r.state.Services()
    45		seen := make(map[string]bool)
    46		for _, ss := range services {
    47			seen[ss.Name] = true
    48			r.mu.Lock()
    49			sl, ok := r.listeners[ss.Name]
    50			r.mu.Unlock()
    51			if !ok {
    52				if !ss.IsStopping() {
    53					r.startService(ss)
    54				}
    55				continue
    56			}
    57			if sl.port != ss.ListenPort {
    58				r.stopService(ss.Name, true)
    59				r.startService(ss)
    60			}
    61		}
    62		r.mu.Lock()
    63		for name := range r.listeners {
    64			if !seen[name] {
    65				r.mu.Unlock()
    66				r.stopService(name, true)
    67				r.mu.Lock()
    68			}
    69		}
    70		r.mu.Unlock()
    71	}
    72	
    73	func (r *Router) startService(ss *state.ServiceState) {
    74		addr := ":" + intToStr(ss.ListenPort)
    75		ln, err := net.Listen("tcp", addr)
    76		if err != nil {
    77			log.Printf("router: listen %s on %s failed: %v", ss.Name, addr, err)
    78			return
    79		}
    80		sl := &serviceListener{
    81			service:  ss.Name,
    82			port:     ss.ListenPort,
    83			listener: ln,
    84			stop:     make(chan struct{}),
    85			done:     make(chan struct{}),
    86		}
    87		r.mu.Lock()
    88		r.listeners[ss.Name] = sl
    89		r.mu.Unlock()
    90		go sl.acceptLoop(r)
    91	}
    92	
    93	func (r *Router) stopService(name string, drain bool) {
    94		r.mu.Lock()
    95		sl, ok := r.listeners[name]
    96		if ok {
    97			delete(r.listeners, name)
    98		}
    99		r.mu.Unlock()
   100		if !ok {
   101			return
   102		}
   103		sl.stopAccept(drain, r)
   104	}
   105	
   106	func (r *Router) Stop() {
   107		r.mu.Lock()
   108		listeners := r.listeners
   109		r.listeners = make(map[string]*serviceListener)
   110		r.mu.Unlock()
   111		var wg sync.WaitGroup
   112		for name, sl := range listeners {
   113			wg.Add(1)
   114			go func(name string, sl *serviceListener) {
   115				defer wg.Done()
   116				sl.stopAccept(true, r)
   117			}(name, sl)
   118		}
   119		wg.Wait()
   120	}
   121	
   122	func (sl *serviceListener) acceptLoop(r *Router) {
   123		defer close(sl.done)
   124		for {
   125			conn, err := sl.listener.Accept()
   126			if err != nil {
   127				return
   128			}
   129			sl.wg.Add(1)
   130			go func(c net.Conn) {
   131				defer sl.wg.Done()
   132				r.handleConn(sl.service, c)
   133			}(conn)
   134		}
   135	}
   136	
   137	func (sl *serviceListener) stopAccept(drain bool, r *Router) {
   138		select {
   139		case <-sl.stop:
   140		default:
   141			close(sl.stop)
   142		}
   143		sl.listener.Close()
   144		<-sl.done
   145		if drain {
   146			ss := r.state.GetService(sl.service)
   147			timeout := 5 * time.Second
   148			if ss != nil {
   149				timeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond
   150				if timeout <= 0 {
   151					timeout = 5 * time.Second
   152				}
   153			}
   154			done := make(chan struct{})
   155			go func() {
   156				sl.wg.Wait()
   157				close(done)
   158			}()
   159			select {
   160			case <-done:
   161			case <-time.After(timeout):
   162				r.state.CloseServiceConnections(sl.service)
   163				<-done
   164			}
   165		} else {
   166			sl.wg.Wait()
   167		}
   168	}
   169	
   170	func (r *Router) handleConn(service string, client net.Conn) {
   171		start := time.Now()
   172		res, err := r.state.SelectEndpoint(service)
   173		if err != nil {
   174			if cand, cerr := r.state.SelectCandidate(service); cerr == nil {
   175				ss := r.state.GetService(service)
   176				if ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {
   177					cand.Stats.RecordRejection()
   178				}
   179			}
   180			client.Close()
   181			return
   182		}
   183		ep := res.Endpoint
   184	
   185		var id int64
   186		if !res.Probe {
   187			var ok bool
   188			id, ok = ep.TryAddConnection(client, res.MaxConns)
   189			if !ok {
   190				ep.Stats.RecordRejection()
   191				client.Close()
   192				return
   193			}
   194		}
   195	
   196		backend, err := net.Dial("tcp", ep.Address)
   197		if err != nil {
   198			if id != 0 {
   199				ep.RemoveConnection(id)
   200			}
   201			ep.Stats.RecordConnection(0, 0, time.Since(start), true)
   202			if res.Probe {
   203				ep.Circuit.ProbeFailure()
   204			}
   205			client.Close()
   206			return
   207		}
   208	
   209		if res.Probe {
   210			ep.Circuit.ProbeSuccess()
   211			var ok bool
   212			id, ok = ep.TryAddConnection(client, res.MaxConns)
   213			if !ok {
   214				ep.Stats.RecordRejection()
   215				backend.Close()
   216				client.Close()
   217				return
   218			}
   219		}
   220	
