    23	func newRateLimiter(rps, burst int, queueDepth int, timeoutMs int) *rateLimiter {
    24		return &rateLimiter{
    25			rps:      float64(rps),
    26			burst:    float64(burst),
    27			tokens:   float64(burst),
    28			last:     time.Now(),
    29			queue:    list.New(),
    30			queueMax: queueDepth,
    31			timeout:  time.Duration(timeoutMs) * time.Millisecond,
    32		}
    33	}
    34	
    35	func (rl *rateLimiter) update(rps, burst int, queueDepth int, timeoutMs int) {
    36		rl.mu.Lock()
    37		defer rl.mu.Unlock()
    38		rl.rps = float64(rps)
    39		rl.burst = float64(burst)
    40		if rl.tokens > rl.burst {
    41			rl.tokens = rl.burst
    42		}
    43		rl.queueMax = queueDepth
    44		rl.timeout = time.Duration(timeoutMs) * time.Millisecond
    45	}
    46	
    47	func (rl *rateLimiter) refillLocked(now time.Time) {
    48		elapsed := now.Sub(rl.last).Seconds()
    49		if elapsed > 0 {
    50			rl.tokens += rl.rps * elapsed
    51			if rl.burst > 0 && rl.tokens > rl.burst {
    52				rl.tokens = rl.burst
    53			}
    54			rl.last = now
    55		}
    56	}
    57	
    58	func (rl *rateLimiter) tryAcquire(now time.Time) bool {
    59		rl.mu.Lock()
    60		defer rl.mu.Unlock()
    61		rl.refillLocked(now)
    62		if rl.rps <= 0 || rl.tokens >= 1 {
    63			if rl.rps > 0 {
    64				rl.tokens -= 1
    65			}
    66			return true
    67		}
    68		return false
    69	}
    70	
    71	type queuedWaiter struct {
    72		deadline time.Time
    73		ch       chan struct{}
    74	}
    75	
    76	func (rl *rateLimiter) acquire(now time.Time) (bool, bool) {
    77		rl.mu.Lock()
    78		if rl.rps <= 0 {
    79			rl.mu.Unlock()
    80			return true, false
    81		}
    82		rl.refillLocked(now)
    83		if rl.tokens >= 1 {
    84			rl.tokens -= 1
    85			rl.mu.Unlock()
    86			return true, false
    87		}
    88		if rl.queueMax <= 0 {
    89			rl.rateLimited++
    90			rl.mu.Unlock()
    91			return false, false
    92		}
    93		if rl.queue.Len() >= rl.queueMax {
    94			rl.rateLimited++
    95			rl.mu.Unlock()
    96			return false, false
    97		}
    98		deadline := now.Add(rl.timeout)
    99		waiter := &queuedWaiter{deadline: deadline, ch: make(chan struct{})}
   100		elem := rl.queue.PushBack(waiter)
   101		rl.queued++
   102		rl.mu.Unlock()
   103	
   104		timer := time.NewTimer(rl.timeout)
   105		defer timer.Stop()
   106		select {
   107		case <-waiter.ch:
   108			return true, true
   109		case <-timer.C:
   110			rl.mu.Lock()
   111			select {
   112			case <-waiter.ch:
   113				rl.mu.Unlock()
   114				return true, true
   115			default:
   116			}
   117			if elem.Value != nil {
   118				rl.queue.Remove(elem)
   119			}
   120			rl.timeouts++
   121			rl.mu.Unlock()
   122			return false, true
   123		}
   124	}
   125	
   126	func (rl *rateLimiter) releaseToken() {
   127		rl.mu.Lock()
   128		if rl.queue.Len() > 0 {
   129			elem := rl.queue.Front()
   130			waiter := elem.Value.(*queuedWaiter)
   131			rl.queue.Remove(elem)
   132			rl.mu.Unlock()
   133			close(waiter.ch)
   134			return
   135		}
   136		rl.mu.Unlock()
   137	}
   138	
   139	func (rl *rateLimiter) status() (tokens float64, queueDepth int, rateLimited uint64, queued uint64, timeouts uint64, rps float64, burst float64) {
   140		rl.mu.Lock()
   141		defer rl.mu.Unlock()
   142		rl.refillLocked(time.Now())
   143		return rl.tokens, rl.queue.Len(), rl.rateLimited, rl.queued, rl.timeouts, rl.rps, rl.burst
   144	}
