				}
			} else if strings.HasPrefix(a, "--result=") {
				args["result"] = a[len("--result="):]
			} else if !strings.HasPrefix(a, "-") {
				args["service"] = a
			}
		}
		args["last_n"] = last
	case "access-stats":
		ipcCmd = "get_access_stats"
		for _, a := range os.Args[2:] {
			if !strings.HasPrefix(a, "-") {
				args["service"] = a
			}
		}
	default:
		fmt.Fprintf(os.Stderr, "unknown command: %s\n", cliCmd)
		os.Exit(1)
	}

	data, err := sendCommand(ipcCmd, args)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Println(data)
}

func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {
	rawArgs, err := json.Marshal(args)
	if err != nil {
		return "", err
	}
	req := request{Cmd: ipcCmd, Args: rawArgs}
	reqBytes, err := json.Marshal(req)
	if err != nil {
		return "", err
	}

	conn, err := net.Dial("unix", "/tmp/meshd.sock")
	if err != nil {
		return "", fmt.Errorf("connect to meshd failed: %w", err)
	}
	defer conn.Close()

	fmt.Fprintf(conn, "%s\n", string(reqBytes))

	reader := bufio.NewReader(conn)
	line, err := reader.ReadString('\n')
	if err != nil {
		return "", err
	}
	line = strings.TrimRight(line, "\r\n")

[?2004hroot@n30009:/app# sed -n '220,330p' cmd/meshctl/main.go
[?2004l
	var resp response
	if err := json.Unmarshal([]byte(line), &resp); err != nil {
		return "", err
	}
	if resp.Status != "ok" {
		var msg string
		if err := json.Unmarshal(resp.Data, &msg); err == nil {
			return "", fmt.Errorf("%s", msg)
		}
		return "", fmt.Errorf("%s", string(resp.Data))
	}
	return prettyData(ipcCmd, resp.Data)
}

func prettyData(ipcCmd string, data json.RawMessage) (string, error) {
	switch ipcCmd {
	case "list_services":
		var services []struct {
			Name        string `json:"name"`
			ListenPort  int    `json:"listen_port"`
			RoutingMode string `json:"routing_mode"`
			Endpoints   []struct {
				Address           string `json:"address"`
				State             string `json:"state"`
				Weight            int    `json:"weight"`
				ActiveConnections int    `json:"active_connections"`
				CircuitState      string `json:"circuit_state"`
			} `json:"endpoints"`
		}
		if err := json.Unmarshal(data, &services); err != nil {
			return "", err
		}
		var b strings.Builder
		fmt.Fprintf(&b, "%-14s %-18s %-10s %-7s %-11s %-7s\n", "SERVICE", "ENDPOINT", "STATE", "WEIGHT", "CIRCUIT", "ACTIVE")
		for _, svc := range services {
			for _, ep := range svc.Endpoints {
				fmt.Fprintf(&b, "%-14s %-18s %-10s %-7d %-11s %-7d\n", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)
			}
		}
		return strings.TrimRight(b.String(), "\n"), nil
	case "resolve":
		var addr string
		if err := json.Unmarshal(data, &addr); err != nil {
			return "", err
		}
		return addr, nil
	case "get_circuit_breakers":
		var circuits []struct {
			Address             string `json:"address"`
			CircuitState        string `json:"circuit_state"`
			ConsecutiveFailures int    `json:"consecutive_failures"`
			TimeInStateMs       int64  `json:"time_in_state_ms"`
			ProbeActive         bool   `json:"probe_active"`
		}
		if err := json.Unmarshal(data, &circuits); err != nil {
			return "", err
		}
		var b strings.Builder
		fmt.Fprintf(&b, "%-18s %-11s %-9s %-17s %-7s\n", "ENDPOINT", "CIRCUIT", "FAILURES", "TIME_IN_STATE_MS", "PROBE")
		for _, c := range circuits {
			fmt.Fprintf(&b, "%-18s %-11s %-9d %-17d %-7t\n", c.Address, c.CircuitState, c.ConsecutiveFailures, c.TimeInStateMs, c.ProbeActive)
		}
		return strings.TrimRight(b.String(), "\n"), nil
	case "get_warmup_status":
		var resp struct {
			Endpoints []struct {
				Endpoint          string `json:"endpoint"`
				WarmingUp         bool   `json:"warming_up"`
				WarmupRemainingMs int    `json:"warmup_remaining_ms"`
				EffectiveWeight   int    `json:"effective_weight"`
				ConfigWeight      int    `json:"config_weight"`
			} `json:"endpoints"`
		}
		if err := json.Unmarshal(data, &resp); err != nil {
			return "", err
		}
		var b strings.Builder
		fmt.Fprintf(&b, "%-18s %-11s %-13s %-17s %-13s\n", "ENDPOINT", "WARMING_UP", "REMAINING_MS", "EFFECTIVE_WEIGHT", "CONFIG_WEIGHT")
		for _, e := range resp.Endpoints {
			fmt.Fprintf(&b, "%-18s %-11t %-13d %-17d %-13d\n", e.Endpoint, e.WarmingUp, e.WarmupRemainingMs, e.EffectiveWeight, e.ConfigWeight)
		}
		return strings.TrimRight(b.String(), "\n"), nil
	case "set_weight", "drain_endpoint", "reset_circuit_breaker", "reload_config", "set_rate_limit":
		var s string
		if err := json.Unmarshal(data, &s); err != nil {
			return "", err
		}
		return s, nil
	case "get_connections":
		var resp struct {
			Connections []struct {
				Endpoint string `json:"endpoint"`
				Client   string `json:"client"`
				AgeMs    int64  `json:"age_ms"`
				IdleMs   int64  `json:"idle_ms"`
				BytesIn  int64  `json:"bytes_in"`
				BytesOut int64  `json:"bytes_out"`
			} `json:"connections"`
		}
		if err := json.Unmarshal(data, &resp); err != nil {
			fmt.Fprintf(os.Stderr, "failed to decode response: %v\n", err)
			os.Exit(1)
		}
		fmt.Printf("%-18s %-18s %-9s %-9s %-10s %-10s\n", "ENDPOINT", "CLIENT", "AGE_MS", "IDLE_MS", "BYTES_IN", "BYTES_OUT")
		for _, c := range resp.Connections {
			fmt.Printf("%-18s %-18s %-9d %-9d %-10d %-10d\n", c.Endpoint, c.Client, c.AgeMs, c.IdleMs, c.BytesIn, c.BytesOut)
		}
		return "", nil
	case "get_access_log":
		var entries []struct {
[?2004hroot@n30009:/app# python3 - <<'PY'
