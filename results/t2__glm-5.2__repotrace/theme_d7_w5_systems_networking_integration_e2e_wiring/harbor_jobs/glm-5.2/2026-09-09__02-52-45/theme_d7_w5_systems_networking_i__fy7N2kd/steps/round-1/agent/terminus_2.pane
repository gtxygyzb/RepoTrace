    17	type Collector struct {
    18		mu         sync.Mutex
    19		window     time.Duration
    20		entries    []entry
    21		rejections []time.Time
    22	
    23		rateLimited    int
    24		queued         int
    25		queueTimeouts  int
    26		retries        int
    27		retrySuccesses int
    28	}
    29	
    30	// New creates a collector with the given window length.
    31	func New(window time.Duration) *Collector {
    32		if window <= 0 {
    33			window = time.Minute
    34		}
    35		return &Collector{window: window}
    36	}
    37	
    38	// RecordConnection records a finished connection attempt.
    39	func (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {
    40		c.mu.Lock()
    41		defer c.mu.Unlock()
    42		now := time.Now()
    43		c.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})
    44		c.trim(now)
    45	}
    46	
    47	// RecordRejection records a rejected connection because the endpoint was at capacity.
    48	func (c *Collector) RecordRejection() {
    49		c.mu.Lock()
    50		defer c.mu.Unlock()
    51		now := time.Now()
    52		c.rejections = append(c.rejections, now)
    53		c.trim(now)
    54	}
    55	
    56	// RecordRateLimited records a rate limit rejection.
    57	func (c *Collector) RecordRateLimited() {
    58		c.mu.Lock()
    59		defer c.mu.Unlock()
    60		c.rateLimited++
    61	}
    62	
    63	// RecordQueued records a connection that was queued waiting for a token.
    64	func (c *Collector) RecordQueued() {
    65		c.mu.Lock()
    66		defer c.mu.Unlock()
    67		c.queued++
    68	}
    69	
    70	// RecordQueueTimeout records a queue timeout rejection.
    71	func (c *Collector) RecordQueueTimeout() {
    72		c.mu.Lock()
    73		defer c.mu.Unlock()
    74		c.queueTimeouts++
    75	}
    76	
    77	// RecordRetry records a retry attempt.
    78	func (c *Collector) RecordRetry() {
    79		c.mu.Lock()
    80		defer c.mu.Unlock()
    81		c.retries++
    82	}
    83	
    84	// RecordRetrySuccess records a successful retry attempt.
    85	func (c *Collector) RecordRetrySuccess() {
    86		c.mu.Lock()
    87		defer c.mu.Unlock()
    88		c.retrySuccesses++
    89	}
