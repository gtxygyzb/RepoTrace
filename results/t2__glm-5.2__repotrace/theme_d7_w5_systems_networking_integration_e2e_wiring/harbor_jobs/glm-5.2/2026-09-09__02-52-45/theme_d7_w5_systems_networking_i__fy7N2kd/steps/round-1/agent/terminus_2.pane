   177			}
   178			if ep == nil {
   179				ep = newEndpointState(cep, global)
   180				ss.Endpoints = append(ss.Endpoints, ep)
   181			} else {
   182				ep.mu.Lock()
   183				ep.Config = cep
   184				ep.Weight = cep.Weight
   185				ep.mu.Unlock()
   186			}
   187		}
   188		for _, ep := range ss.Endpoints {
   189			if !seen[ep.Address] {
   190				ep.StartDraining(ss.DrainTimeoutMs, true)
   191			}
   192		}
   193	}
   194	
   195	func newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {
   196		return &EndpointState{
   197			Address:     cep.Address,
   198			Weight:      cep.Weight,
   199			Config:      cep,
   200			State:       Unknown,
   201			Circuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),
   202			Stats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),
   203			connections: make(map[int64]net.Conn),
   204		}
   205	}
   206	
   207	func (s *State) GetService(name string) *ServiceState {
   208		s.mu.RLock()
   209		defer s.mu.RUnlock()
   210		return s.services[name]
   211	}
   212	
   213	func (s *State) Services() []*ServiceState {
   214		s.mu.RLock()
   215		defer s.mu.RUnlock()
   216		out := make([]*ServiceState, 0, len(s.services))
   217		for _, ss := range s.services {
   218			out = append(out, ss)
   219		}
   220		return out
   221	}
   222	
   223	func (s *State) GetEndpoint(service, address string) *EndpointState {
   224		ss := s.GetService(service)
   225		if ss == nil {
   226			return nil
   227		}
   228		ss.mu.Lock()
   229		defer ss.mu.Unlock()
   230		for _, ep := range ss.Endpoints {
   231			if ep.Address == address {
   232				return ep
   233			}
   234		}
   235		return nil
   236	}
   237	
   238	func (s *State) SetWeight(service, address string, weight int) error {
   239		ep := s.GetEndpoint(service, address)
   240		if ep == nil {
   241			return errNotFound("endpoint not found")
   242		}
   243		ep.mu.Lock()
   244		defer ep.mu.Unlock()
   245		if weight < 0 {
   246			weight = 0
   247		}
   248		ep.Weight = weight
   249		return nil
   250	}
   251	
   252	func (s *State) DrainEndpoint(service, address string) error {
   253		ss := s.GetService(service)
   254		if ss == nil {
   255			return errNotFound("service not found")
   256		}
   257		ep := s.GetEndpoint(service, address)
   258		if ep == nil {
   259			return errNotFound("endpoint not found")
   260		}
   261		ep.StartDraining(ss.DrainTimeoutMs, false)
   262		return nil
   263	}
   264	
   265	func (s *State) ResetCircuitBreaker(service, address string) error {
   266		ep := s.GetEndpoint(service, address)
   267		if ep == nil {
   268			return errNotFound("endpoint not found")
   269		}
   270		ep.Circuit.Reset()
   271		return nil
   272	}
   273	
   274	func (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {
   275		ep.mu.Lock()
   276		defer ep.mu.Unlock()
   277		ep.State = Draining
   278		ep.consecSuccess = 0
   279		ep.consecFailures = 0
   280		ep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)
   281		if markRemoved {
   282			ep.removed = true
   283		}
   284		if len(ep.connections) > 0 {
   285			go func(deadline time.Time, conns map[int64]net.Conn) {
   286				time.Sleep(time.Until(deadline))
   287				ep.closeConnectionsLocked()
   288			}(ep.drainDeadline, ep.connections)
   289		}
   290	}
   291	
   292	func (ep *EndpointState) AddConnection(conn net.Conn) int64 {
   293		ep.mu.Lock()
   294		defer ep.mu.Unlock()
   295		id := atomic.AddInt64(&ep.connIDCounter, 1)
   296		ep.connections[id] = conn
   297		ep.ActiveConnections++
   298		return id
   299	}
   300	
   301	func (ep *EndpointState) RemoveConnection(id int64) {
   302		ep.mu.Lock()
   303		defer ep.mu.Unlock()
   304		if _, ok := ep.connections[id]; ok {
   305			delete(ep.connections, id)
   306			if ep.ActiveConnections > 0 {
   307				ep.ActiveConnections--
   308			}
   309		}
   310	}
   311	
   312	func (ep *EndpointState) closeConnectionsLocked() {
   313		for id, c := range ep.connections {
   314			c.Close()
   315			delete(ep.connections, id)
   316		}
   317	}
   318	
   319	func (ep *EndpointState) Active() int {
   320		ep.mu.Lock()
