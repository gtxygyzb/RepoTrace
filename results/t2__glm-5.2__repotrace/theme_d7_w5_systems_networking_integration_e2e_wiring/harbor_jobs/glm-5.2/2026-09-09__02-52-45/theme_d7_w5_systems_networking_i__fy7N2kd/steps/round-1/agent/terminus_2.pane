   101	func (s *Server) handleLine(line string) string {
   102		var req Request
   103		if err := json.Unmarshal([]byte(line), &req); err != nil {
   104			return encodeResp(Response{Status: "error", Data: err.Error()})
   105		}
   106		data, err := s.dispatch(req)
   107		if err != nil {
   108			return encodeResp(Response{Status: "error", Data: err.Error()})
   109		}
   110		return encodeResp(Response{Status: "ok", Data: data})
   111	}
   112	
   113	func encodeResp(r Response) string {
   114		b, _ := json.Marshal(r)
   115		return string(b)
   116	}
   117	
   118	func (s *Server) dispatch(req Request) (interface{}, error) {
   119		switch req.Cmd {
   120		case "list_services":
   121			return s.state.ServicesView(), nil
   122		case "get_service":
   123			var args struct {
   124				Name string `json:"name"`
   125			}
   126			if err := json.Unmarshal(req.Args, &args); err != nil {
   127				return nil, err
   128			}
   129			sv, ok := s.state.ServiceView(args.Name)
   130			if !ok {
   131				return nil, errors.New("service not found")
   132			}
   133			return sv, nil
   134		case "get_warmup_status":
   135			var args struct {
   136				Name string `json:"name"`
   137			}
   138			if err := json.Unmarshal(req.Args, &args); err != nil {
   139				return nil, err
   140			}
   141			sv, ok := s.state.WarmupStatusView(args.Name)
   142			if !ok {
   143				return nil, errors.New("service not found")
   144			}
   145			return sv, nil
   146		case "get_stats":
   147			var args struct {
   148				Name string `json:"name"`
   149			}
   150			if err := json.Unmarshal(req.Args, &args); err != nil {
   151				return nil, err
   152			}
   153			g := s.state.Global()
   154			sv, ok := s.state.StatsView(args.Name, g.StatsWindowSec)
   155			if !ok {
   156				return nil, errors.New("service not found")
   157			}
   158			return sv, nil
   159		case "set_weight":
   160			var args struct {
   161				Name    string `json:"name"`
