    15	type HealthState string
    16	
    17	const (
    18		Unknown   HealthState = "unknown"
    19		Healthy   HealthState = "healthy"
    20		Unhealthy HealthState = "unhealthy"
    21		Draining  HealthState = "draining"
    22	)
    23	
    24	type HealthEvent struct {
    25		Timestamp   time.Time
    26		Endpoint    string
    27		OldState    HealthState
    28		NewState    HealthState
