   552	func (ep *EndpointState) TryAddConnection(conn net.Conn, maxConns int) (int64, bool) {
   553		ep.mu.Lock()
   554		defer ep.mu.Unlock()
   555		if ep.ActiveConnections >= maxConns {
   556			return 0, false
   557		}
   558		id := atomic.AddInt64(&ep.connIDCounter, 1)
   559		now := time.Now()
   560		ep.connections[id] = &connectionInfo{
   561			conn:         conn,
   562			clientAddr:   remoteAddr(conn),
   563			start:        now,
   564			lastActivity: now,
   565		}
   566		ep.ActiveConnections++
   567		return id, true
   568	}
