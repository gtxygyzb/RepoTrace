[?2004lfunc (rl *rateLimiter) acquire(now time.Time) (allowed bool, queued bool, queueWaitMs int64, timedOut bool) {
	rl.mu.Lock()
	if rl.rps <= 0 {
		rl.mu.Unlock()
		return true, false, 0, false
	}
	if rl.tryAcquireLocked(now) {
		rl.mu.Unlock()
		return true, false, 0, false
	}
	if rl.queueMax <= 0 {
		rl.rateLimited++
		rl.mu.Unlock()
		return false, false, 0, false
	}
	if rl.queueDepth >= rl.queueMax {
		rl.rateLimited++
		rl.mu.Unlock()
		return false, false, 0, false
	}
	rl.queueDepth++
	rl.queued++
	rl.mu.Unlock()

	deadline := now.Add(rl.timeout)
	for {
		rl.mu.Lock()
		var wait time.Duration
		if rl.rps > 0 {
			needed := 1.0 - rl.tokens
			if needed > 0 {
				wait = time.Duration(needed / rl.rps * float64(time.Second))
			}
		}
		rl.mu.Unlock()

		if wait <= 0 {
			rl.mu.Lock()
			if rl.tryAcquireLocked(time.Now()) {
				rl.queueDepth--
				rl.mu.Unlock()
				return true, true, time.Since(queueStart).Milliseconds(), false
			}
			rl.mu.Unlock()
			continue
		}

		remaining := time.Until(deadline)
		if remaining <= 0 {
			rl.mu.Lock()
			rl.queueDepth--
			rl.timeouts++
			rl.rateLimited++
			rl.mu.Unlock()
			return false, true, time.Since(queueStart).Milliseconds(), true
		}
		if wait > remaining {
			wait = remaining
		}
		timer := time.NewTimer(wait)
		select {
		case <-timer.C:
		}
		timer.Stop()
	}
}

