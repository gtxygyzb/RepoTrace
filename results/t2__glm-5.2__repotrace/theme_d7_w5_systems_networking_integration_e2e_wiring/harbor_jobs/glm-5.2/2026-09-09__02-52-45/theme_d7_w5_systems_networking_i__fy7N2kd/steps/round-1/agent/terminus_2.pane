[?2004l[?2004h> 
[?2004l[?2004h> // Log queues an entry for asynchronous writing. If the buffered channel is full,
[?2004l[?2004h> // the entry is written synchronously to avoid losing it.
[?2004l[?2004h> func (l *Logger) Log(entry Entry) {
[?2004l[?2004h>     if atomic.LoadInt32(&l.stopped) != 0 {
[?2004l[?2004h>         return
