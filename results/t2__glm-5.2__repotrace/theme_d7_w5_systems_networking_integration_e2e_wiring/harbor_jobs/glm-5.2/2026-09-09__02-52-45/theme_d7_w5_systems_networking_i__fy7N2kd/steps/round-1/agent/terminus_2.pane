   221		var resp response
   222		if err := json.Unmarshal([]byte(line), &resp); err != nil {
   223			return "", err
   224		}
   225		if resp.Status != "ok" {
   226			var msg string
   227			if err := json.Unmarshal(resp.Data, &msg); err == nil {
   228				return "", fmt.Errorf("%s", msg)
   229			}
   230			return "", fmt.Errorf("%s", string(resp.Data))
   231		}
   232		return prettyData(ipcCmd, resp.Data)
   233	}
   234	
   235	func prettyData(ipcCmd string, data json.RawMessage) (string, error) {
   236		switch ipcCmd {
   237		case "list_services":
   238			var services []struct {
   239				Name        string `json:"name"`
   240				ListenPort  int    `json:"listen_port"`
   241				RoutingMode string `json:"routing_mode"`
   242				Endpoints   []struct {
   243					Address           string `json:"address"`
   244					State             string `json:"state"`
   245					Weight            int    `json:"weight"`
   246					ActiveConnections int    `json:"active_connections"`
   247					CircuitState      string `json:"circuit_state"`
   248				} `json:"endpoints"`
   249			}
   250			if err := json.Unmarshal(data, &services); err != nil {
   251				return "", err
   252			}
   253			var b strings.Builder
   254			fmt.Fprintf(&b, "%-14s %-18s %-10s %-7s %-11s %-7s\n", "SERVICE", "ENDPOINT", "STATE", "WEIGHT", "CIRCUIT", "ACTIVE")
   255			for _, svc := range services {
   256				for _, ep := range svc.Endpoints {
   257					fmt.Fprintf(&b, "%-14s %-18s %-10s %-7d %-11s %-7d\n", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)
   258				}
   259			}
   260			return strings.TrimRight(b.String(), "\n"), nil
   261		case "resolve":
   262			var addr string
   263			if err := json.Unmarshal(data, &addr); err != nil {
   264				return "", err
   265			}
   266			return addr, nil
   267		case "get_circuit_breakers":
   268			var circuits []struct {
   269				Address             string `json:"address"`
   270				CircuitState        string `json:"circuit_state"`
   271				ConsecutiveFailures int    `json:"consecutive_failures"`
   272				TimeInStateMs       int64  `json:"time_in_state_ms"`
   273				ProbeActive         bool   `json:"probe_active"`
   274			}
   275			if err := json.Unmarshal(data, &circuits); err != nil {
   276				return "", err
   277			}
