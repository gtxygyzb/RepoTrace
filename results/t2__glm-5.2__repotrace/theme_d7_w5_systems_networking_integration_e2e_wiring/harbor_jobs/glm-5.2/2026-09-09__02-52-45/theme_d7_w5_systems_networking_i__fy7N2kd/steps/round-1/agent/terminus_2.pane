[?2004l     1	package router
     2	
     3	import (
     4		"io"
     5		"log"
     6		"net"
     7		"sync"
     8		"time"
     9	
    10		"meshrouter/internal/state"
    11	)
    12	
    13	type serviceListener struct {
    14		service  string
    15		port     int
    16		listener net.Listener
    17		stop     chan struct{}
    18		wg       sync.WaitGroup
    19		done     chan struct{}
    20	}
    21	
    22	type Router struct {
    23		state     *state.State
    24		mu        sync.Mutex
    25		listeners map[string]*serviceListener
    26	}
    27	
    28	func NewRouter(s *state.State) *Router {
    29		return &Router{
    30			state:     s,
    31			listeners: make(map[string]*serviceListener),
    32		}
    33	}
    34	
    35	func (r *Router) Start() {
    36		for _, ss := range r.state.Services() {
    37			if !ss.IsStopping() {
    38				r.startService(ss)
    39			}
    40		}
    41	}
    42	
    43	func (r *Router) Reload() {
    44		services := r.state.Services()
    45		seen := make(map[string]bool)
    46		for _, ss := range services {
    47			seen[ss.Name] = true
    48			r.mu.Lock()
    49			sl, ok := r.listeners[ss.Name]
    50			r.mu.Unlock()
    51			if !ok {
    52				if !ss.IsStopping() {
    53					r.startService(ss)
    54				}
    55				continue
    56			}
    57			if sl.port != ss.ListenPort {
    58				r.stopService(ss.Name, true)
    59				r.startService(ss)
    60			}
    61		}
    62		r.mu.Lock()
    63		for name := range r.listeners {
    64			if !seen[name] {
    65				r.mu.Unlock()
    66				r.stopService(name, true)
    67				r.mu.Lock()
    68			}
    69		}
    70		r.mu.Unlock()
    71	}
    72	
    73	func (r *Router) startService(ss *state.ServiceState) {
    74		addr := ":" + intToStr(ss.ListenPort)
    75		ln, err := net.Listen("tcp", addr)
    76		if err != nil {
    77			log.Printf("router: listen %s on %s failed: %v", ss.Name, addr, err)
    78			return
    79		}
    80		sl := &serviceListener{
    81			service:  ss.Name,
    82			port:     ss.ListenPort,
    83			listener: ln,
    84			stop:     make(chan struct{}),
    85			done:     make(chan struct{}),
    86		}
    87		r.mu.Lock()
    88		r.listeners[ss.Name] = sl
    89		r.mu.Unlock()
    90		go sl.acceptLoop(r)
    91	}
    92	
    93	func (r *Router) stopService(name string, drain bool) {
    94		r.mu.Lock()
    95		sl, ok := r.listeners[name]
    96		if ok {
    97			delete(r.listeners, name)
    98		}
    99		r.mu.Unlock()
   100		if !ok {
   101			return
   102		}
   103		sl.stopAccept(drain, r)
   104	}
   105	
   106	func (r *Router) Stop() {
   107		r.mu.Lock()
   108		listeners := r.listeners
   109		r.listeners = make(map[string]*serviceListener)
   110		r.mu.Unlock()
   111		var wg sync.WaitGroup
   112		for name, sl := range listeners {
   113			wg.Add(1)
   114			go func(name string, sl *serviceListener) {
   115				defer wg.Done()
   116				sl.stopAccept(true, r)
   117			}(name, sl)
   118		}
   119		wg.Wait()
   120	}
