[?2004l     1	package accesslog
     2	
     3	import (
     4		"encoding/json"
     5		"os"
     6		"path/filepath"
     7		"sync"
     8		"sync/atomic"
     9		"time"
    10	)
    11	
    12	// Entry is one structured access log record.
    13	type Entry struct {
    14		Ts          string `json:"ts"`
    15		Service     string `json:"service"`
    16		Client      string `json:"client"`
    17		Endpoint    string `json:"endpoint"`
    18		BytesIn     int64  `json:"bytes_in"`
    19		BytesOut    int64  `json:"bytes_out"`
    20		DurationMs  int64  `json:"duration_ms"`
    21		Result      string `json:"result"`
    22		Retried     bool   `json:"retried"`
    23		RetryCount  int    `json:"retry_count"`
    24		QueueWaitMs *int64 `json:"queue_wait_ms,omitempty"`
    25	}
    26	
    27	// DefaultPath is the access log path required by meshrouter.
    28	const DefaultPath = "/app/logs/access.log"
    29	
    30	const maxFileSize = 1 << 20 // 1 MB
    31	
    32	// Logger writes access log entries asynchronously to a JSON-lines file.
    33	type Logger struct {
    34		path     string
    35		ch       chan Entry
    36		stop     chan struct{}
    37		done     chan struct{}
    38		stopped  int32
    39		stopOnce sync.Once
    40		mu       sync.Mutex
    41		file     *os.File
    42		size     int64
    43	}
    44	
    45	// New creates a Logger for path and starts its writer goroutine.
    46	func New(path string) *Logger {
    47		if path == "" {
    48			path = DefaultPath
    49		}
    50		l := &Logger{
    51			path: path,
    52			ch:   make(chan Entry, 8192),
    53			stop: make(chan struct{}),
    54			done: make(chan struct{}),
    55		}
    56		go l.run()
    57		return l
    58	}
    59	
    60	// Path returns the configured log file path.
    61	func (l *Logger) Path() string {
    62		return l.path
    63	}
    64	
    65	// Log queues an entry for asynchronous writing. If the buffered channel is full,
    66	// the entry is written synchronously to avoid losing it.
    67	func (l *Logger) Log(entry Entry) {
    68		if atomic.LoadInt32(&l.stopped) != 0 {
    69			return
    70		}
    71		entry.Ts = time.Now().UTC().Format(time.RFC3339Nano)
    72		select {
    73		case l.ch <- entry:
    74		default:
    75			l.writeLine(entry)
    76		}
    77	}
    78	
    79	// Stop flushes all buffered entries and closes the log file.
    80	func (l *Logger) Stop() {
    81		l.stopOnce.Do(func() {
    82			atomic.StoreInt32(&l.stopped, 1)
    83			close(l.stop)
    84			<-l.done
    85			l.mu.Lock()
    86			if l.file != nil {
    87				l.file.Close()
    88				l.file = nil
    89			}
    90			l.mu.Unlock()
    91		})
    92	}
    93	
    94	func (l *Logger) run() {
    95		for {
    96			select {
    97			case e := <-l.ch:
    98				l.writeLine(e)
    99			case <-l.stop:
   100				l.drain()
   101				close(l.done)
   102				return
   103			}
   104		}
   105	}
   106	
   107	func (l *Logger) drain() {
   108		for {
   109			select {
   110			case e := <-l.ch:
   111				l.writeLine(e)
   112			default:
   113				return
   114			}
   115		}
   116	}
   117	
   118	func (l *Logger) writeLine(e Entry) {
   119		b, err := json.Marshal(e)
   120		if err != nil {
   121			return
   122		}
   123		b = append(b, '\n')
   124	
   125		l.mu.Lock()
   126		defer l.mu.Unlock()
   127	
   128		if l.file == nil {
   129			if err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {
   130				return
   131			}
   132			f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
   133			if err != nil {
   134				return
   135			}
   136			l.file = f
   137			if info, err := f.Stat(); err == nil {
   138				l.size = info.Size()
   139			}
   140		}
   141	
   142		if l.size > 0 && l.size+int64(len(b)) > maxFileSize {
   143			l.rotateLocked()
   144		}
   145	
   146		n, err := l.file.Write(b)
   147		if err != nil {
   148			l.size = 0
   149			if l.file != nil {
   150				l.file.Close()
   151				l.file = nil
   152			}
   153			return
   154		}
   155		l.size += int64(n)
   156	}
   157	
   158	func (l *Logger) rotateLocked() {
   159		if l.file != nil {
   160			l.file.Close()
   161			l.file = nil
   162		}
   163		os.Remove(l.path + ".1")
   164		if err := os.Rename(l.path, l.path+".1"); err != nil {
   165			f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
   166			if err == nil {
   167				l.file = f
   168				if info, err := f.Stat(); err == nil {
   169					l.size = info.Size()
   170				}
   171			}
   172			return
   173		}
   174		f, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
   175		if err != nil {
   176			l.size = 0
   177			return
   178		}
   179		l.file = f
   180		l.size = 0
   181	}
