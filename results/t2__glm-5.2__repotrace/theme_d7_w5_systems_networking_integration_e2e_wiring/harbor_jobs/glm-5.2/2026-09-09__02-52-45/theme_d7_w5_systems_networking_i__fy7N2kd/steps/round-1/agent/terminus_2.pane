   123	type CircuitView struct {
   124		Address             string `json:"address"`
   125		CircuitState        string `json:"circuit_state"`
   126		ConsecutiveFailures int    `json:"consecutive_failures"`
   127		TimeInStateMs       int64  `json:"time_in_state_ms"`
   128		ProbeActive         bool   `json:"probe_active"`
