    12		AvgDurationMs int64 `json:"avg_duration_ms"`
    13		TotalBytesIn  int64 `json:"total_bytes_in"`
    14		TotalBytesOut int64 `json:"total_bytes_out"`
    15	}
    16	
    17	// StatsResult is the response shape for get_access_stats.
    18	type StatsResult struct {
    19		TotalRequests int                    `json:"total_requests"`
    20		ByResult      map[string]ResultStats `json:"by_result"`
    21	}
    22	
    23	// ReadEntries reads and parses log entries from the backup file plus the
    24	// current log file, in chronological order. Invalid lines are skipped.
    25	func ReadEntries(path string) []Entry {
    26		var entries []Entry
    27		entries = append(entries, readLogFile(path+".1")...)
    28		entries = append(entries, readLogFile(path)...)
    29		return entries
    30	}
    31	
    32	func readLogFile(path string) []Entry {
    33		f, err := os.Open(path)
    34		if err != nil {
    35			return nil
    36		}
    37		defer f.Close()
    38	
    39		var entries []Entry
    40		scanner := bufio.NewScanner(f)
    41		scanner.Buffer(make([]byte, 1024*1024), 1024*1024)
    42		for scanner.Scan() {
    43			line := scanner.Bytes()
    44			if len(line) == 0 {
    45				continue
    46			}
    47			var e Entry
    48			if err := json.Unmarshal(line, &e); err != nil {
    49				continue
    50			}
    51			entries = append(entries, e)
    52		}
    53		return entries
    54	}
    55	
    56	// GetAccessLog returns filtered log entries. Filters are applied first, then the
    57	// last lastN entries are returned. If lastN is 0 or negative, all matching
    58	// entries are returned.
    59	func GetAccessLog(path, service, result string, lastN int, minDurationMs int64) []Entry {
    60		entries := ReadEntries(path)
    61	
    62		filtered := entries[:0]
    63		for _, e := range entries {
    64			if service != "" && e.Service != service {
    65				continue
    66			}
    67			if result != "" && e.Result != result {
    68				continue
    69			}
    70			if minDurationMs > 0 && e.DurationMs < minDurationMs {
    71				continue
    72			}
    73			filtered = append(filtered, e)
    74		}
    75	
    76		if lastN <= 0 {
    77			return filtered
    78		}
    79		if len(filtered) > lastN {
    80			return filtered[len(filtered)-lastN:]
    81		}
    82		return filtered
    83	}
    84	
    85	// Stats aggregates access log entries for the optional service filter.
    86	func Stats(path, service string) StatsResult {
    87		entries := ReadEntries(path)
    88	
    89		type agg struct {
    90			count    int
    91			duration int64
    92			bytesIn  int64
    93			bytesOut int64
    94		}
    95		aggs := make(map[string]*agg)
    96		total := 0
    97	
    98		for _, e := range entries {
    99			if service != "" && e.Service != service {
   100				continue
   101			}
   102			a := aggs[e.Result]
   103			if a == nil {
   104				a = &agg{}
   105				aggs[e.Result] = a
   106			}
   107			a.count++
   108			a.duration += e.DurationMs
   109			a.bytesIn += e.BytesIn
   110			a.bytesOut += e.BytesOut
   111			total++
   112		}
   113	
   114		result := StatsResult{
   115			TotalRequests: total,
   116			ByResult:      make(map[string]ResultStats),
   117		}
   118		for name, a := range aggs {
   119			if a.count == 0 {
   120				continue
   121			}
   122			result.ByResult[name] = ResultStats{
   123				Count:         a.count,
   124				AvgDurationMs: a.duration / int64(a.count),
   125				TotalBytesIn:  a.bytesIn,
   126				TotalBytesOut: a.bytesOut,
   127			}
   128		}
   129		return result
   130	}
