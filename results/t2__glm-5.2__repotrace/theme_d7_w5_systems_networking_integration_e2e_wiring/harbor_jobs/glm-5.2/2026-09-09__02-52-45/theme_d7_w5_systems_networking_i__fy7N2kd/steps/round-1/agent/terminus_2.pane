}

func (rl *rateLimiter) refillLocked(now time.Time) {
\telapsed := now.Sub(rl.last).Seconds()
\tif elapsed > 0 {
\t\trl.tokens += rl.rps * elapsed
\t\tif rl.burst > 0 && rl.tokens > rl.burst {
\t\t\trl.tokens = rl.burst
\t\t}
\t\trl.last = now
\t}
}

func (rl *rateLimiter) tryAcquireLocked(now time.Time) bool {
\tif rl.rps <= 0 {
\t\treturn true
\t}
\trl.refillLocked(now)
\tif rl.tokens >= 1 {
\t\trl.tokens -= 1
\t\treturn true
\t}
\treturn false
}

func (rl *rateLimiter) acquire(now time.Time) (bool, bool) {
\trl.mu.Lock()
\tif rl.rps <= 0 {
\t\trl.mu.Unlock()
\t\treturn true, false
\t}
\tif rl.tryAcquireLocked(now) {
\t\trl.mu.Unlock()
\t\treturn true, false
\t}
\tif rl.queueMax <= 0 {
\t\trl.rateLimited++
\t\trl.mu.Unlock()
\t\treturn false, false
\t}
\tif rl.queueDepth >= rl.queueMax {
\t\trl.rateLimited++
\t\trl.mu.Unlock()
\t\treturn false, false
\t}
\trl.queueDepth++
\trl.queued++
\trl.mu.Unlock()

\tdeadline := now.Add(rl.timeout)
\tfor {
\t\trl.mu.Lock()
\t\tvar wait time.Duration
\t\tif rl.rps > 0 {
\t\t\tneeded := 1.0 - rl.tokens
\t\t\tif needed > 0 {
\t\t\t\twait = time.Duration(needed / rl.rps * float64(time.Second))
\t\t\t}
\t\t}
\t\trl.mu.Unlock()

\t\tif wait <= 0 {
\t\t\trl.mu.Lock()
\t\t\tif rl.tryAcquireLocked(time.Now()) {
\t\t\t\trl.queueDepth--
\t\t\t\trl.mu.Unlock()
\t\t\t\treturn true, true
\t\t\t}
\t\t\trl.mu.Unlock()
\t\t\tcontinue
\t\t}

\t\tremaining := time.Until(deadline)
\t\tif remaining <= 0 {
\t\t\trl.mu.Lock()
\t\t\trl.queueDepth--
\t\t\trl.timeouts++
\t\t\trl.mu.Unlock()
\t\t\treturn false, true
\t\t}
\t\tif wait > remaining {
\t\t\twait = remaining
\t\t}
\t\ttimer := time.NewTimer(wait)
\t\tselect {
\t\tcase <-timer.C:
\t\t}
\t\ttimer.Stop()
\t}
}

func (rl *rateLimiter) status() (tokens float64, queueDepth int, rateLimited uint64, queued uint64, timeouts uint64, rps float64, burst float64) {
\trl.mu.Lock()
\tdefer rl.mu.Unlock()
\trl.refillLocked(time.Now())
\treturn rl.tokens, rl.queueDepth, rl.rateLimited, rl.queued, rl.timeouts, rl.rps, rl.burst
}
''')
