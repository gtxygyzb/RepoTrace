    88		for _, ep := range ss.Endpoints {
    89			ep.mu.Lock()
    90			sv.Endpoints = append(sv.Endpoints, StatsEndpointView{
    91				Address:  ep.Address,
    92				Snapshot: ep.Stats.Snapshot(ep.ActiveConnections),
    93			})
    94			ep.mu.Unlock()
    95		}
    96		ss.mu.Unlock()
    97		return sv, true
