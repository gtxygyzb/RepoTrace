[?2004l   321		}
   322	}
   323	
   324	func (r *Router) sleepRetry(attempt, delayMs int, multiplier float64, maxDelayMs int) {
   325		if attempt < 0 {
   326			attempt = 0
   327		}
   328		delay := float64(delayMs) * pow(multiplier, float64(attempt))
   329		if maxDelayMs > 0 && delay > float64(maxDelayMs) {
   330			delay = float64(maxDelayMs)
   331		}
   332		if delay > 0 {
   333			time.Sleep(time.Duration(delay) * time.Millisecond)
   334		}
   335	}
   336	
   337	func pow(base, exp float64) float64 {
   338		result := 1.0
   339		for i := 0; i < int(exp); i++ {
   340			result *= base
   341		}
   342		return result
   343	}
   344	
   345	func forward(client, backend net.Conn, ep *state.EndpointState, id int64, idleTimeoutMs int) (int64, int64, bool) {
   346		var bytesIn, bytesOut int64
   347		var idleClosed int32
   348		var closeOnce sync.Once
   349		var wg sync.WaitGroup
   350		done := make(chan struct{})
   351		closeConns := func() {
   352			client.Close()
   353			backend.Close()
   354		}
   355	
   356		wg.Add(2)
   357		go func() {
   358			defer wg.Done()
   359			n, _ := copyConn(backend, client, ep, id, "out")
   360			bytesOut = n
   361			closeOnce.Do(closeConns)
   362		}()
   363		go func() {
   364			defer wg.Done()
   365			n, _ := copyConn(client, backend, ep, id, "in")
   366			bytesIn = n
   367			closeOnce.Do(closeConns)
   368		}()
   369	
   370		if idleTimeoutMs > 0 {
   371			go func() {
   372				ticker := time.NewTicker(time.Duration(idleTimeoutMs) * time.Millisecond)
   373				defer ticker.Stop()
   374				for {
   375					select {
   376					case <-ticker.C:
   377						if ep.ConnectionIdleMs(id) >= int64(idleTimeoutMs) {
   378							atomic.StoreInt32(&idleClosed, 1)
   379							closeOnce.Do(closeConns)
   380							return
   381						}
   382					case <-done:
   383						return
   384					}
   385				}
   386			}()
   387		}
   388	
   389		wg.Wait()
   390		close(done)
   391		return bytesIn, bytesOut, atomic.LoadInt32(&idleClosed) == 1
   392	}
   393	
   394	func copyConn(dst io.Writer, src io.Reader, ep *state.EndpointState, id int64, direction string) (int64, error) {
   395		buf := make([]byte, 32*1024)
   396		var total int64
   397		for {
   398			n, err := src.Read(buf)
   399			if n > 0 {
   400				if _, werr := dst.Write(buf[:n]); werr != nil {
   401					return total, werr
   402				}
   403				total += int64(n)
   404				if direction == "in" {
   405					ep.UpdateConnectionActivity(id, int64(n), 0)
   406				} else {
   407					ep.UpdateConnectionActivity(id, 0, int64(n))
   408				}
   409			}
   410			if err != nil {
   411				return total, err
   412			}
   413		}
   414	}
   415	
   416	func intToStr(i int) string {
   417		if i == 0 {
   418			return "0"
   419		}
   420		var buf [12]byte
   421		pos := len(buf)
   422		neg := false
   423		if i < 0 {
   424			neg = true
   425			i = -i
   426		}
   427		for i > 0 {
   428			pos--
   429			buf[pos] = byte('0' + i%10)
   430			i /= 10
   431		}
   432		if neg {
   433			pos--
   434			buf[pos] = '-'
   435		}
   436		return string(buf[pos:])
   437	}
