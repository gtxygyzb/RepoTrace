   154				ss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier
   155				ss.RetryMaxDelayMs = svc.RetryMaxDelayMs
   156				if ss.rateLimiter == nil {
   157					ss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)
   158				} else {
