   191	func prettyData(ipcCmd string, data json.RawMessage) (string, error) {
   192		switch ipcCmd {
   193		case "list_services":
   194			var services []struct {
   195				Name        string `json:"name"`
   196				ListenPort  int    `json:"listen_port"`
   197				RoutingMode string `json:"routing_mode"`
   198				Endpoints   []struct {
   199					Address           string `json:"address"`
   200					State             string `json:"state"`
   201					Weight            int    `json:"weight"`
   202					ActiveConnections int    `json:"active_connections"`
   203					CircuitState      string `json:"circuit_state"`
   204				} `json:"endpoints"`
   205			}
   206			if err := json.Unmarshal(data, &services); err != nil {
   207				return "", err
   208			}
   209			var b strings.Builder
   210			fmt.Fprintf(&b, "%-14s %-18s %-10s %-7s %-11s %-7s\n", "SERVICE", "ENDPOINT", "STATE", "WEIGHT", "CIRCUIT", "ACTIVE")
   211			for _, svc := range services {
   212				for _, ep := range svc.Endpoints {
   213					fmt.Fprintf(&b, "%-14s %-18s %-10s %-7d %-11s %-7d\n", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)
   214				}
   215			}
   216			return strings.TrimRight(b.String(), "\n"), nil
   217		case "resolve":
   218			var addr string
   219			if err := json.Unmarshal(data, &addr); err != nil {
   220				return "", err
   221			}
   222			return addr, nil
   223		case "get_circuit_breakers":
   224			var circuits []struct {
   225				Address             string `json:"address"`
   226				CircuitState        string `json:"circuit_state"`
   227				ConsecutiveFailures int    `json:"consecutive_failures"`
   228				TimeInStateMs       int64  `json:"time_in_state_ms"`
   229				ProbeActive         bool   `json:"probe_active"`
   230			}
