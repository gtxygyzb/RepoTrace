[2557.859759, "o", "\u001b[?2004h> "]
[2557.859904, "o", "new = '''\\tcase \"reload\":\r\n\u001b[?2004l\r"]
[2557.859955, "o", "\u001b[?2004h> "]
[2557.860127, "o", "\\t\\tipcCmd = \"reload_config\"\r\n\u001b[?2004l\r"]
[2557.860192, "o", "\u001b[?2004h> "]
[2557.860309, "o", "\\tcase \"rate-limit\":\r\n\u001b[?2004l\r"]
[2557.860363, "o", "\u001b[?2004h> "]
[2557.860528, "o", "\\t\\tif len(os.Args) < 3 {\r\n\u001b[?2004l\r"]
[2557.860585, "o", "\u001b[?2004h> "]
[2557.860971, "o", "\\t\\t\\tfmt.Fprintln(os.Stderr, \"usage: meshctl rate-limit <service>\")\r\n\u001b[?2004l\r"]
[2557.861035, "o", "\u001b[?2004h> "]
[2557.86113, "o", "\\t\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[2557.861193, "o", "\u001b[?2004h> "]
[2557.861252, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[2557.861306, "o", "> "]
[2557.861504, "o", "\\t\\tipcCmd = \"get_rate_limit_status\"\r\n\u001b[?2004l\r"]
[2557.861552, "o", "\u001b[?2004h> "]
[2557.861738, "o", "\\t\\targs[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
[2557.861803, "o", "\u001b[?2004h> "]
[2557.861941, "o", "\\tcase \"set-rate-limit\":\r\n\u001b[?2004l\r"]
[2557.861996, "o", "\u001b[?2004h> "]
[2557.862144, "o", "\\t\\tif len(os.Args) < 5 {\r\n\u001b[?2004l\r"]
[2557.8622, "o", "\u001b[?2004h> "]
[2557.862694, "o", "\\t\\t\\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-rate-limit <service> <rps> <burst>\")\r\n\u001b[?2004l\r"]
[2557.862757, "o", "\u001b[?2004h> "]
[2557.862852, "o", "\\t\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[2557.862907, "o", "\u001b[?2004h> "]
[2557.862961, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[2557.863016, "o", "\u001b[?2004h> "]
[2557.863233, "o", "\\t\\trps, err := strconv.Atoi(os.Args[3])\r\n\u001b[?2004l\r"]
[2557.863299, "o", "\u001b[?2004h> "]
[2557.863442, "o", "\\t\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[2557.863498, "o", "\u001b[?2004h> "]
[2557.863832, "o", "\\t\\t\\t\\tfmt.Fprintf(os.Stderr, \"invalid rps: %v\\\\n\", err)\r\n\u001b[?2004l\r"]
[2557.863897, "o", "\u001b[?2004h> "]
[2557.864003, "o", "\\t\\t\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[2557.864057, "o", "\u001b[?2004h> "]
[2557.86413, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[2557.86419, "o", "\u001b[?2004h> "]
[2557.864426, "o", "\\t\\t\\tburst, err := strconv.Atoi(os.Args[4])\r\n\u001b[?2004l\r"]
[2557.864494, "o", "\u001b[?2004h> "]
[2557.864624, "o", "\\t\\t\\t\\tif err != nil {\r\n\u001b[?2004l\r"]
[2557.864674, "o", "\u001b[?2004h> "]
[2557.865031, "o", "\\t\\t\\t\\t\\tfmt.Fprintf(os.Stderr, \"invalid burst: %v\\\\n\", err)\r\n\u001b[?2004l\r"]
[2557.865096, "o", "\u001b[?2004h> "]
[2557.865211, "o", "\\t\\t\\t\\t\\tos.Exit(1)\r\n\u001b[?2004l\r"]
[2557.865279, "o", "\u001b[?2004h> "]
[2557.865333, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r"]
[2557.865397, "o", "\u001b[?2004h> "]
[2557.865562, "o", "\\t\\t\\tipcCmd = \"set_rate_limit\"\r\n\u001b[?2004l\r"]
[2557.865625, "o", "\u001b[?2004h> "]
[2557.865805, "o", "\\t\\t\\targs[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
[2557.86586, "o", "\u001b[?2004h> "]
[2557.865997, "o", "\\t\\t\\targs[\"rps\"] = rps\r\n\u001b[?2004l\r"]
[2557.866052, "o", "\u001b[?2004h> "]
[2557.866229, "o", "\\t\\t\\targs[\"burst\"] = burst'''\r\n\u001b[?2004l\r"]
[2557.866283, "o", "\u001b[?2004h> "]
[2557.866383, "o", "if old not in s:\r\n\u001b[?2004l\r"]
[2557.866452, "o", "\u001b[?2004h> "]
