[2988.89873, "o", "   170\tfunc (r *Router) handleConn(service string, client net.Conn) {\r\n   171\t\tstart := time.Now()\r\n   172\t\tss := r.state.GetService(service)\r\n   173\t\tif ss == nil {\r\n   174\t\t\tclient.Close()\r\n   175\t\t\treturn\r\n"]
[2988.898851, "o", "   176\t\t}\r\n   177\t\r\n   178\t\tallowed, queued := ss.AcquireRateLimitToken()\r\n   179\t\tif !allowed {\r\n   180\t\t\tif queued {\r\n   181\t\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   182\t\t\t\t\tcand.Stats.RecordQueueTimeout()\r\n   183\t\t\t\t}\r\n   184\t\t\t} else {\r\n   185\t\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   186\t\t\t\t\tcand.Stats.RecordRateLimited()\r\n   187\t\t\t\t}\r\n   188\t\t\t}\r\n   189\t\t\tclient.Close()\r\n   190\t\t\treturn\r\n   191\t\t}\r\n   192\t\tif queued {\r\n"]
[2988.898952, "o", "   193\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   194\t\t\t\tcand.Stats.RecordQueued()\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197\t\r\n   198\t\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\r\n   199\t\tvar lastEndpoint *state.EndpointState\r\n   200\t\tfor attempt := 0; ; attempt++ {\r\n   201\t\t\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\r\n   202\t\t\tif err != nil {\r\n   203\t\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   204\t\t\t\t\tss := r.state.GetService(service)\r\n   205\t\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n"]
[2988.899136, "o", "   206\t\t\t\t\t\tcand.Stats.RecordRejection()\r\n   207\t\t\t\t\t}\r\n   208\t\t\t\t}\r\n   209\t\t\t\tclient.Close()\r\n   210\t\t\t\treturn\r\n   211\t\t\t}\r\n   212\t\t\tlastEndpoint = res.Endpoint\r\n   213\t\t\tep := res.Endpoint\r\n   214\t\r\n   215\t\t\tvar id int64\r\n   216\t\t\tif !res.Probe {\r\n   217\t\t\t\tvar ok bool\r\n   218\t\t\t\tid, ok = ep.TryAddConnection(client, res.MaxConns)\r\n   219\t\t\t\tif !ok {\r\n   220\t\t\t\t\tep.Stats.RecordRejection()\r\n   221\t\t\t\t\tif attempt >= maxRetries {\r\n   222\t\t\t\t\t\tclient.Close()\r\n   223\t\t\t\t\t\treturn\r\n   224\t\t\t\t\t}\r\n   225\t\t\t\t\tr.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\r\n   226\t\t\t\t\tcontinue\r\n   227\t\t\t\t}\r\n   228"]
[2988.899246, "o", "\t\t\t}\r\n   229\t\r\n   230\t\t\tbackend, derr := net.Dial(\"tcp\", ep.Address)\r\n   231\t\t\tif derr != nil {\r\n   232\t\t\t\tif id != 0 {\r\n   233\t\t\t\t\tep.RemoveConnection(id)\r\n   234\t\t\t\t}\r\n   235\t\t\t\tep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n   236\t\t\t\tif res.Probe {\r\n   237\t\t\t\t\tep.Circuit.ProbeFailure()\r\n   238\t\t\t\t} else {\r\n   239\t\t\t\t\tep.Circuit.Open()\r\n   240\t\t\t\t}\r\n   241\t\t\t\tif attempt >= maxRetries {\r\n   242\t\t\t\t\tclient.Close()\r\n   243\t\t\t\t\treturn\r\n   244\t\t\t\t}\r\n   245\t\t\t\tep.Stats.RecordRetry()\r\n"]
[2988.899318, "o", "   246\t\t\t\tr.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\r\n   247\t\t\t\tcontinue\r\n   248\t\t\t}\r\n   249\t\r\n   250\t\t\tif res.Probe {\r\n   251\t\t\t\tep.Circuit.ProbeSuccess()\r\n   252\t\t\t\tvar ok bool\r\n   253\t\t\t\tid, ok = ep.TryAddConnection(client, res.MaxConns)\r\n   254\t\t\t\tif !ok {\r\n   255\t\t\t\t\tep.Stats.RecordRejection()\r\n"]
[2988.899379, "o", "   256\t\t\t\t\tbackend.Close()\r\n   257\t\t\t\t\tclient.Close()\r\n   258\t\t\t\t\treturn\r\n   259\t\t\t\t}\r\n   260\t\t\t}\r\n   261\t\r\n   262\t\t\tif attempt > 0 {\r\n   263\t\t\t\tep.Stats.RecordRetrySuccess()\r\n   264\t\t\t}\r\n   265\t\t\tbytesIn, bytesOut := forward(client, backend)\r\n"]
[2988.899483, "o", "   266\t\t\tbackend.Close()\r\n   267\t\t\tclient.Close()\r\n   268\t\t\tep.RemoveConnection(id)\r\n   269\t\t\tep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)\r\n   270\t\t\treturn\r\n"]
