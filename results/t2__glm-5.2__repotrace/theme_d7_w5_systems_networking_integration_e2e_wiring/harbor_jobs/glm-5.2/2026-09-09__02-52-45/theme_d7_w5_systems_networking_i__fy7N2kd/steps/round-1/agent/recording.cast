[6318.243327, "o", "   387\tfunc (ep *EndpointState) UpdateConnectionActivity(id int64, bytesIn, bytesOut int64) {\r\n   388\t\tep.mu.Lock()\r\n   389\t\tdefer ep.mu.Unlock()\r\n   390\t\tif info, ok := ep.connections[id]; ok {\r\n   391\t\t\tinfo.bytesIn += bytesIn\r\n"]
[6318.243399, "o", "   392\t\t\tinfo.bytesOut += bytesOut\r\n   393\t\t\tif bytesIn > 0 || bytesOut > 0 {\r\n   394\t\t\t\tinfo.lastActivity = time.Now()\r\n   395\t\t\t}\r\n   396\t\t}\r\n   397\t}\r\n   398\t\r\n   399\tfunc (ep *EndpointState) ConnectionIdleMs(id int64) int64 {\r\n   400"]
[6318.243457, "o", "\t\tep.mu.Lock()\r\n   401\t\tdefer ep.mu.Unlock()\r\n   402\t\tif info, ok := ep.connections[id]; ok {\r\n   403\t\t\treturn time.Since(info.lastActivity).Milliseconds()\r\n   404\t\t}\r\n"]
