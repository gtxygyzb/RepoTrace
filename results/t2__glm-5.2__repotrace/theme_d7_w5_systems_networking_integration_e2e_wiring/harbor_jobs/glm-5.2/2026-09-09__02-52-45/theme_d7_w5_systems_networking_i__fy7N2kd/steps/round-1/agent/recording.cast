[2021.488201, "o", "\t\t\tep.mu.Lock()\r\n    34\t\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n    35\t\t\tep.mu.Unlock()\r\n    36\t\t\tif eligible {\r\n    37\t\t\t\tregular = append(regular, ep)\r\n    38\t\t\t}\r\n    39\t\t}\r\n    40\t\r\n    41\t\tif len(regular) > 0 {\r\n    42\t\t\tif mode == \"least-connections\" {\r\n    43\t\t\t\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\r\n    44\t\t\t}\r\n    45\t\t\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\r\n"]
