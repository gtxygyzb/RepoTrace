[2812.4146, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/state/ratelimit.go')\np.write_text('''package state\n\nimport (\n\\t\"sync\"\n\\t\"time\"\n)\n\ntype rateLimiter struct {\n\\tmu          sync.Mutex\n\\trps         float64\n\\tburst       float64\n\\ttokens      float64\n\\tlast        time.Time\n\\tqueueMax    int\n\\tqueueDepth  int\n\\ttimeout     time.Duration\n\\trateLimited uint64\n\\tqueued      uint64\n\\ttimeouts    uint64\n}\n\nfunc newRateLimiter(rps, burst int, queueDepth int, timeoutMs int) *rateLimiter {\n\\treturn &rateLimiter{\n\\t\\trps:      float64(rps),\n\\t\\tburst:    float64(burst),\n\\t\\ttokens:   float64(burst),\n\\t\\tlast:     time.Now(),\n\\t\\tqueueMax: queueDepth,\n\\t\\ttimeout:  time.Duration(timeoutMs) * time.Millisecond,\n\\t}\n}\n\nfunc (rl *rateLimiter) update(rps, burst int, queueDepth int, timeoutMs int) {\n\\trl.mu.Lock()\n\\tdefer rl.mu.Unlock()\n\\trl.rps = float64(rps)\n\\trl.burst = float64(burst)\n\\tif rl.tokens > rl.burst {\n\\t\\trl.tokens = rl.burst\n\\t}\n\\trl.queueMax = queueDepth\n\\trl.timeout = time.Duration(timeoutMs) * time"]
[2812.414923, "i", ".Millisecond\n}\n\nfunc (rl *rateLimiter) refillLocked(now time.Time) {\n\\telapsed := now.Sub(rl.last).Seconds()\n\\tif elapsed > 0 {\n\\t\\trl.tokens += rl.rps * elapsed\n\\t\\tif rl.burst > 0 && rl.tokens > rl.burst {\n\\t\\t\\trl.tokens = rl.burst\n\\t\\t}\n\\t\\trl.last = now\n\\t}\n}\n\nfunc (rl *rateLimiter) tryAcquireLocked(now time.Time) bool {\n\\tif rl.rps <= 0 {\n\\t\\treturn true\n\\t}\n\\trl.refillLocked(now)\n\\tif rl.tokens >= 1 {\n\\t\\trl.tokens -= 1\n\\t\\treturn true\n\\t}\n\\treturn false\n}\n\nfunc (rl *rateLimiter) acquire(now time.Time) (bool, bool) {\n\\trl.mu.Lock()\n\\tif rl.rps <= 0 {\n\\t\\trl.mu.Unlock()\n\\t\\treturn true, false\n\\t}\n\\tif rl.tryAcquireLocked(now) {\n\\t\\trl.mu.Unlock()\n\\t\\treturn true, false\n\\t}\n\\tif rl.queueMax <= 0 {\n\\t\\trl.rateLimited++\n\\t\\trl.mu.Unlock()\n\\t\\treturn false, false\n\\t}\n\\tif rl.queueDepth >= rl.queueMax {\n\\t\\trl.rateLimited++\n\\t\\trl.mu.Unlock()\n\\t\\treturn false, false\n\\t}\n\\trl.queueDepth++\n\\trl.queued++\n\\trl.mu.Unlock()\n\n\\tdeadline := now.Add(rl.timeout)\n\\tfor {\n\\t\\trl.mu.Lock()\n\\t\\tvar wait time.Duration\n\\t\\t"]
