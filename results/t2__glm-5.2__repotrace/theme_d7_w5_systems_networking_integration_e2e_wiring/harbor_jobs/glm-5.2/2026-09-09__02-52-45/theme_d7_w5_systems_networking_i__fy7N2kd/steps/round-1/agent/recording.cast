[10848.173768, "o", "ircuit.IsClosed() && ep.Weight > 0 && ep.State != Draining\r\ninternal/state/routing.go:46:\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining\r\ninternal/state/routing.go:155:\t\t\teligible = ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && totalActive < maxConns\r\ninternal/state/routing.go:157:\t\t\teligible = ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\ninternal/state/routing.go:179:\t\t\thalfOpen = ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && totalActive < maxConns\r\ninternal/state/routing.go:181:\t\t\thalfOpen = ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\ninternal/state/json.go:228:\t\t\teligible = ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && totalActive < maxConns\r\ninternal/state/json.go:230:"]
[10848.173854, "o", "\t\t\teligible = ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\ninternal/state/json.go:252:\t\t\thalfOpen = ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && totalActive < maxConns && !ep.Circuit.ProbeActive()\r\ninternal/state/json.go:254:\t\t\thalfOpen = ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns && !ep.Circuit.ProbeActive()\r\n"]
