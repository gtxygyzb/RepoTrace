[4187.21064, "o", "   102\t\r\n   103\tfunc (s *State) Global() config.Global {\r\n   104\t\ts.mu.RLock()\r\n   105\t\tdefer s.mu.RUnlock()\r\n   106\t\treturn s.global\r\n   107\t}\r\n   108\t\r\n   109\tfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n   110\t\ts.mu.Lock()\r\n   111\t\tdefer s.mu.Unlock()\r\n   112\t\ts.applyConfigLocked(cfg)\r\n   113\t\tselect {\r\n"]
[4187.210716, "o", "   114\t\tcase s.reloadCh <- struct{}{}:\r\n   115\t\tdefault:\r\n   116\t\t}\r\n   117\t}\r\n   118\t\r\n   119\tfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n   120\t\ts.global = cfg.Global\r\n   121\t"]
[4187.21078, "o", "\tseen := make(map[string]bool)\r\n   122\t\tfor _, svc := range cfg.Services {\r\n   123\t\t\tseen[svc.Name] = true\r\n   124\t\t\tss := s.services[svc.Name]\r\n   125\t\t\tif ss == nil {\r\n   126\t\t\t\tss = newServiceState(svc, cfg.Global)\r\n   127\t\t\t\ts.services[svc.Name] = ss\r\n   128\t\t\t} else {\r\n   129\t\t\t\tss.mu.Lock()\r\n   130\t\t\t\tss.Name = svc.Name\r\n   131\t\t\t\tss.ListenPort = svc.ListenPort\r\n   132\t\t\t\tss.RoutingMode = svc.RoutingMode\r\n   133\t\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n"]
[4187.210839, "o", "   134\t\t\t\tss.RateLimitRps = svc.RateLimitRps\r\n   135\t\t\t\tss.RateLimitBurst = svc.RateLimitBurst\r\n   136\t\t\t\tss.RateLimitQueueDepth = svc.RateLimitQueueDepth\r\n   137\t\t\t\tss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs\r\n   138\t\t\t\tss.MaxRetries = svc.MaxRetries\r\n   139\t\t\t\tss.RetryDelayMs = svc.RetryDelayMs\r\n   140\t\t\t\tss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier\r\n   141\t\t\t\tss.RetryMaxDelayMs = svc.RetryMaxDelayMs\r\n"]
[4187.210906, "o", "   142\t\t\t\tif ss.rateLimiter == nil {\r\n   143\t\t\t\t\tss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n   144\t\t\t\t} else {\r\n   145\t\t\t\t\tss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n"]
[4187.210963, "o", "   146\t\t\t\t}\r\n   147\t\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n   148\t\t\t\tss.mu.Unlock()\r\n   149\t\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n   150\t\t\t}\r\n   151\t\t}\r\n   152\t\tfor name, ss := range s.services {\r\n   153\t\t\tif !seen[name] {\r\n   154\t\t\t\tss.mu.Lock()\r\n   155\t\t\t\tss.stopping = true\r\n   156\t\t\t\tif ss.listenerStop != nil {\r\n   157\t\t\t\t\tclose(ss.listenerStop)\r\n   158\t\t\t\t\tss.listenerStop = nil\r\n   159\t\t\t\t}\r\n"]
[4187.211028, "o", "   160\t\t\t\tif ss.Listener != nil {\r\n"]
