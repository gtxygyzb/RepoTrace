[3172.595027, "o", "     6\t)\r\n     7\t\r\n     8\t"]
[3172.595087, "o", "type State string\r\n     9\t\r\n    10\tconst (\r\n    11\t\tClosed   State = \"closed\"\r\n"]
[3172.595123, "o", "    12\t\tOpen     State = \"open\"\r\n    13\t\tHalfOpen State = \"half_open\"\r\n    14\t)\r\n    15\t\r\n    16\t// Breaker implements an endpoint circuit breaker.\r\n    17\ttype Breaker struct {\r\n"]
[3172.595157, "o", "    18\t\tmu                  sync.Mutex\r\n    19\t\tstate               State\r\n    20\t\tconsecutiveFailures int\r\n    21\t\tstateChangedAt      time.Time\r\n    22\t\topenedAt            time.Time\r\n    23\t\ttimeout             time.Duration\r\n    24\t\tprobeActive         bool\r\n    25\t}\r\n"]
[3172.595189, "o", "    26\t\r\n    27\t// New creates a closed breaker with the given open timeout.\r\n    28\tfunc New(timeout time.Duration) *Breaker {\r\n"]
[3172.595224, "o", "    29\t\tnow := time.Now()\r\n    30\t\treturn &Breaker{\r\n    31\t\t\tstate:          Closed,\r\n    32\t\t\tstateChangedAt: now,\r\n    33\t\t\topenedAt:       now,\r\n    34\t\t\ttimeout:        timeout,\r\n    35\t\t}\r\n    36\t}\r\n    37\t\r\n"]
[3172.595257, "o", "    38\t// State returns the current state.\r\n    39\tfunc (b *Breaker) State() State {\r\n    40\t\tb.mu.Lock()\r\n    41\t\tdefer b.mu.Unlock()\r\n    42\t\treturn b.state\r\n"]
[3172.595285, "o", "    43\t}\r\n    44\t\r\n"]
[3172.595315, "o", "    45\t// IsClosed returns true if the breaker is closed.\r\n    46\tfunc (b *Breaker) IsClosed() bool {\r\n    47\t\treturn b.State() == Closed\r\n    48\t}\r\n    49\t\r\n"]
[3172.595348, "o", "    50\t// IsOpen returns true if the breaker is open.\r\n    51\tfunc (b *Breaker) IsOpen() bool {\r\n    52\t\treturn b.State() == Open\r\n    53\t}\r\n    54\t\r\n"]
[3172.595377, "o", "    55\t// IsHalfOpen returns true if the breaker is half-open.\r\n    56\tfunc (b *Breaker) IsHalfOpen() bool {\r\n    57\t\treturn b.State() == HalfOpen\r\n    58\t}\r\n    59\t\r\n"]
[3172.595444, "o", "    60\t// Open forces the breaker open and restarts the timeout clock.\r\n    61\tfunc (b *Breaker) Open() {\r\n    62\t\tb.mu.Lock()\r\n    63\t\tdefer b.mu.Unlock()\r\n    64\t\tnow := time.Now()\r\n"]
[3172.595478, "o", "    65\t\tb.state = Open\r\n    66\t\tb.stateChangedAt = now\r\n"]
[3172.595507, "o", "    67\t\tb.openedAt = now\r\n    68\t\tb.consecutiveFailures++\r\n    69\t\tb.probeActive = false\r\n    70\t}\r\n    71\t\r\n    72\t// MaybeHalfOpen transitions from open to half_open if the timeout has elapsed.\r\n"]
[3172.595544, "o", "    73\tfunc (b *Breaker) MaybeHalfOpen() bool {\r\n    74\t\tb.mu.Lock()\r\n    75\t\tdefer b.mu.Unlock()\r\n    76\t\tif b.state == Open && time.Since(b.openedAt) >= b.timeout {\r\n    77\t\t\tb.state = HalfOpen\r\n    78\t\t\tb.stateChangedAt = time.Now()\r\n    79\t\t\tb.probeActive = false\r\n    80\t"]
[3172.595575, "o", "\t\treturn true\r\n    81\t\t}\r\n    82\t\treturn false\r\n    83\t}\r\n    84\t\r\n"]
[3172.595608, "o", "    85\t// AcquireProbe attempts to take the single allowed half-open probe connection.\r\n    86\tfunc (b *Breaker) AcquireProbe() bool {\r\n    87\t\tb.mu.Lock()\r\n    88\t\tdefer b.mu.Unlock()\r\n    89\t\t"]
[3172.595642, "o", "if b.state == HalfOpen && !b.probeActive {\r\n    90\t\t\tb.probeActive = true\r\n    91\t\t\treturn true\r\n    92\t\t}\r\n    93\t\treturn false\r\n    94\t}\r\n    95\t\r\n"]
[3172.595672, "o", "    96\t// ProbeSuccess closes the circuit and clears failure counts.\r\n    97\tfunc (b *Breaker) ProbeSuccess() {\r\n    98\t\tb.mu.Lock()\r\n    99\t\tdefer b.mu.Unlock()\r\n   100\t\tnow := time.Now()\r\n"]
[3172.59569, "o", "   101\t\tb.state = Closed\r\n   102\t\tb.stateChangedAt = now\r\n   103\t\t"]
[3172.595728, "o", "b.consecutiveFailures = 0\r\n   104\t\tb.probeActive = false\r\n   105\t}\r\n   106\t\r\n   107\t// ProbeFailure reopens the circuit and restarts the timeout.\r\n   108\tfunc (b *Breaker) ProbeFailure() {\r\n"]
[3172.59576, "o", "   109\t\tb.mu.Lock()\r\n   110\t\tdefer b.mu.Unlock()\r\n   111\t\tnow := time.Now()\r\n   112\t\tb.state = Open\r\n   113\t\tb.stateChangedAt = now\r\n   114\t\t"]
[3172.595797, "o", "b.openedAt = now\r\n   115\t\tb.consecutiveFailures++\r\n   116\t\tb.probeActive = false\r\n   117\t}\r\n   118\t"]
[3172.595826, "o", "\r\n   119\t// Reset forces the breaker closed and clears failure counts.\r\n   120\tfunc (b *Breaker) Reset() {"]
[3172.595851, "o", "\r\n   121\t\tb.mu.Lock()\r\n   122\t\tdefer b.mu.Unlock()\r\n   123\t\tnow := time.Now()\r\n   124\t\tb.state = Closed\r\n   125\t\tb.stateChangedAt = now\r\n   126\t\t"]
[3172.595894, "o", "b.openedAt = now\r\n"]
[3172.595931, "o", "   127\t\tb.consecutiveFailures = 0\r\n   128\t\tb.probeActive = false\r\n   129\t}\r\n   130\t\r\n   131\t// ConsecutiveFailures returns the current failure count.\r\n   132\tfunc (b *Breaker) ConsecutiveFailures() int {\r\n   133\t\tb.mu.Lock()\r\n"]
[3172.595963, "o", "   134\t\tdefer b.mu.Unlock()\r\n   135\t\treturn b.consecutiveFailures\r\n   136\t}\r\n   137\t\r\n   138\t// TimeInStateMs returns milliseconds since the last state transition.\r\n   139\tfunc (b *Breaker) TimeInStateMs() int64 {\r\n   140\t\tb.mu.Lock()\r\n"]
[3172.595997, "o", "   141\t\tdefer b.mu.Unlock()\r\n   142\t\treturn time.Since(b.stateChangedAt).Milliseconds()\r\n"]
[3172.596032, "o", "   143\t}\r\n   144\t\r\n   145\t// ProbeActive returns whether a probe connection is currently active.\r\n   146\tfunc (b *Breaker) ProbeActive() bool {\r\n   147\t\tb.mu.Lock()\r\n   148\t\tdefer b.mu.Unlock()\r\n   149\t\t"]
[3172.596061, "o", "return b.probeActive\r\n   150\t}\r\n"]
