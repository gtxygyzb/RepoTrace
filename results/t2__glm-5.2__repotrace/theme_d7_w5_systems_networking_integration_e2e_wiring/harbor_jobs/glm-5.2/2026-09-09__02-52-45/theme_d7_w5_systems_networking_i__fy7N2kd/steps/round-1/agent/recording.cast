[11459.818751, "o", "sed -n '80,140p' internal/config/config.go\r\n\u001b[?2004l\r"]
[11459.821965, "o", "\t\tif s.RoutingMode == \"\" {\r\n\t\t\ts.RoutingMode = \"weighted-round-robin\"\r\n\t\t}\r\n\t"]
[11459.822054, "o", "\tif s.DrainTimeoutMs <= 0 {\r\n\t\t\ts.DrainTimeoutMs = 5000\r\n\t\t}\r\n\t\tif s.MaxConnectionsPerEndpoint <= 0 {\r\n\t\t\ts.MaxConnectionsPerEndpoint = 100\r\n\t\t}\r\n\t\tif s.ConnectionLimitMode == \"\" {\r\n\t\t\ts.ConnectionLimitMode = \"per-endpoint\"\r\n\t\t}\r\n\t"]
[11459.82212, "o", "\tif s.RateLimitBurst <= 0 {\r\n\t\t\ts.RateLimitBurst = s.RateLimitRps\r\n\t\t}\r\n\t\tif s.RateLimitQueueTimeoutMs <= 0 {\r\n\t\t\ts.RateLimitQueueTimeoutMs = 1000\r\n\t\t}\r\n\t\tif s.RetryDelayMs <= 0 {\r\n\t\t\ts.RetryDelayMs = 100\r\n\t\t}\r\n"]
[11459.822179, "o", "\t\tif s.RetryBackoffMultiplier <= 0 {\r\n\t\t\ts.RetryBackoffMultiplier = 2.0\r\n\t\t}\r\n\t\tif s.RetryMaxDelayMs <= 0 {\r\n\t\t\ts.RetryMaxDelayMs = 5000\r\n\t\t}\r\n\t\tfor j := range s.Endpoints {\r\n\t\t\tep := &s.Endpoints[j]\r\n"]
[11459.822232, "o", "\t\t\tif ep.HealthCheck == \"\" {\r\n\t\t\t\tep.HealthCheck = \"tcp\"\r\n\t\t\t}\r\n\t\t\tif ep.Weight < 0 {\r\n\t\t\t\tep.Weight = 0\r\n\t\t\t}\r\n\t\t"]
[11459.822284, "o", "\tif ep.WarmupDurationMs < 0 {\r\n\t\t\t\tep.WarmupDurationMs = 0\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn &cfg, nil\r\n}\r\n"]
