[11937.888492, "i", "sed -n '100,125p' internal/config/config.go\n"]
[11937.888893, "o", "sed -n '100,125p' internal/config/config.go\r\n\u001b[?2004l\r"]
[11937.8925, "o", "\t\tif s.RetryDelayMs <= 0 {\r\n\t\t\ts.RetryDelayMs = 100\r\n\t\t}\r\n\t\tif s.RetryBackoffMultiplier <= 0 {\r\n\t\t\ts.RetryBackoffMultiplier = 2.0\r\n"]
[11937.892557, "o", "\t\t}\r\n\t\tif s.RetryMaxDelayMs <= 0 {\r\n\t\t\ts.RetryMaxDelayMs = 5000\r\n\t\t}\r\n\t\tfor j := range s.Endpoints {\r\n\t\t\tep := &s.Endpoints[j]\r\n\t\t\tif ep.HealthCheck == \"\" {\r\n\t\t\t\tep.HealthCheck = \"tcp\"\r\n\t\t\t}\r\n"]
[11937.892722, "o", "\t\t\tif ep.Weight < 0 {\r\n\t\t\t\tep.Weight = 0\r\n\t\t\t}\r\n\t\t\tif ep.WarmupDurationMs < 0 {\r\n\t\t\t\tep.WarmupDurationMs = 0\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn &cfg, nil\r\n}\r\n\r\n// removeDependencyCycles drops dependency edges that would create cycles.\r\n"]
