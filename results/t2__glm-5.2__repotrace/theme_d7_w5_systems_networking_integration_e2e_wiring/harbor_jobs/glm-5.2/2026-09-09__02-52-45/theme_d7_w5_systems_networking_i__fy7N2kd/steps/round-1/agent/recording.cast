[2042.739452, "o", "\r\n    30\t\tpath     string\r\n    31\t\tlistener net.Listener\r\n    32\t\twg       sync.WaitGroup\r\n    33\t\tstop     chan struct{}\r\n    34\t\tdone     chan struct{}\r\n    35\t}\r\n    36\t\r\n    37\tfunc NewServer(s *state.State, path string) *Server {\r\n    38\t\treturn &Server{\r\n    39\t\t\tstate: s,\r\n    40\t\t\tpath:  path,\r\n    41\t\t\tstop:  make(chan struct{}),\r\n    42\t\t\tdone:  make(chan struct{}),\r\n    43\t\t}\r\n    44\t}\r\n    45\t\r\n    46\tfunc (s *Server) Start() error {\r\n"]
[2042.739522, "o", "    47\t\tos.Remove(s.path)\r\n    48\t\tln, err := net.Listen(\"unix\", s.path)\r\n    49\t\tif err != nil {\r\n    50\t\t\treturn err\r\n    51\t\t}\r\n    52\t\ts.listener = ln\r\n    53\t\tgo s.acceptLoop()\r\n    54\t\treturn nil\r\n    55\t}\r\n    56\t\r\n    57\tfunc (s *Server) Stop() {\r\n"]
[2042.739588, "o", "    58\t\tselect {\r\n    59\t\tcase <-s.stop:\r\n    60\t\tdefault:\r\n    61\t\t\tclose(s.stop)\r\n    62\t\t}\r\n    63\t\tif s.listener != nil {\r\n    64\t\t\ts.listener.Close()\r\n    65\t\t}\r\n    66\t\t<-s.done\r\n    67\t\tos.Remove(s.path)\r\n    68\t}\r\n    69\t\r\n    70\tfunc (s *Server) acceptLoop() {\r\n    71"]
[2042.739652, "o", "\t\tdefer close(s.done)\r\n    72\t\tfor {\r\n    73\t\t\tconn, err := s.listener.Accept()\r\n    74\t\t\tif err != nil {\r\n    75\t\t\t\treturn\r\n    76\t\t\t}\r\n    77\t\t\ts.wg.Add(1)\r\n    78\t\t\tgo s.handleConn(conn)\r\n    79\t\t}\r\n    80\t}\r\n    81\t\r\n"]
[2042.73972, "o", "    82\tfunc (s *Server) handleConn(conn net.Conn) {\r\n    83\t\tdefer s.wg.Done()\r\n    84\t\tdefer conn.Close()\r\n    85\t\treader := bufio.NewReader(conn)\r\n    86\t\tfor {\r\n    87\t\t\tline, err := reader.ReadString('\\n')\r\n    88\t\t\tif err != nil {\r\n    89\t\t\t\treturn\r\n    90\t\t\t}\r\n    91\t\t\tline = strings.TrimRight(line, \"\\r\\n\")\r\n    92\t\t"]
[2042.739784, "o", "\tif line == \"\" {\r\n    93\t\t\t\tcontinue\r\n    94\t\t\t}\r\n    95\t\t\tresp := s.handleLine(line)\r\n    96\t\t\t_, _ = conn.Write([]byte(resp + \"\\n\"))\r\n    97\t\t}\r\n    98\t}\r\n    99\t\r\n   100\tfunc (s *Server) handleLine(line string) string {\r\n   101\t\tvar req Request\r\n   102\t\tif err := json.Unmarshal([]byte(line), &req); err != nil {\r\n"]
