[5756.210482, "o", "\r\n    99\t\t\t\ts.RetryMaxDelayMs = 5000\r\n   100\t\t\t}\r\n   101\t\t\tfor j := range s.Endpoints {\r\n   102\t\t\t\tep := &s.Endpoints[j]\r\n   103\t\t\t\tif ep.HealthCheck == \"\" {\r\n   104\t\t\t\t\tep.HealthCheck = \"tcp\"\r\n   105\t\t\t\t}\r\n   106\t\t\t\tif ep.Weight < 0 {\r\n   107\t\t\t\t\tep.Weight = 0\r\n   108\t\t\t\t}\r\n"]
