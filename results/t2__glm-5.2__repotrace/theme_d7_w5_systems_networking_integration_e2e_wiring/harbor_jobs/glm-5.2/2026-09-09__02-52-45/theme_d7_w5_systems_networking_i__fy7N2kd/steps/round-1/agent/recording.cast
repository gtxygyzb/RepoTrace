[11741.034033, "o", "\u001b[?2004l\r"]
[11741.037019, "o", "\t\tvar services []struct {\r\n\t\t\tName        string `json:\"name\"`\r\n\t\t\tListenPort  int    `json:\"listen_port\"`\r\n\t\t\tRoutingMode string `json:\"routing_mode\"`\r\n\t\t\tEndpoints   []struct {\r\n"]
[11741.037105, "o", "\t\t\t\tAddress           string `json:\"address\"`\r\n\t\t\t\tState             string `json:\"state\"`\r\n\t\t\t\tWeight            int    `json:\"weight\"`\r\n\t\t\t\tActiveConnections int    `json:\"active_connections\"`\r\n\t\t\t\tCircuitState      string `json:\"circuit_state\"`\r\n\t\t\t} `json:\"endpoints\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(data, &services); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\tvar b strings.Builder\r\n"]
[11741.037186, "o", "\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\r\n\t\tfor _, svc := range services {\r\n\t\t\tfor _, ep := range svc.Endpoints {\r\n\t\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n\tcase \"resolve\":\r\n\t\tvar addr string\r\n\t\tif err := json.Unmarshal(data, &addr); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n"]
[11741.03725, "o", "\t\treturn addr, nil\r\n\tcase \"get_circuit_breakers\":\r\n\t\tvar circuits []struct {\r\n\t\t\tAddress             string `json:\"address\"`\r\n\t\t\tCircuitState        string `json:\"circuit_state\"`\r\n\t\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n\t\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n\t\t\tProbeActive         bool   `json:\"probe_active\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(data, &circuits); err != nil {\r\n"]
[11741.037319, "o", "\t\t\treturn \"\", err\r\n\t\t}\r\n\t\tvar b strings.Builder\r\n\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9s %-17s %-7s\\n\", \"ENDPOINT\", \"CIRCUIT\", \"FAILURES\", \"TIME_IN_STATE_MS\", \"PROBE\")\r\n\t\tfor _, c := range circuits {\r\n\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9d %-17d %-7t\\n\", c.Address, c.CircuitState, c.ConsecutiveFailures, c.TimeInStateMs, c.ProbeActive)\r\n\t\t}\r\n\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n\tcase \"get_warmup_status\":\r\n\t"]
[11741.037383, "o", "\tvar resp struct {\r\n\t\t\tEndpoints []struct {\r\n\t\t\t\tEndpoint          string `json:\"endpoint\"`\r\n\t\t\t\tWarmingUp         bool   `json:\"warming_up\"`\r\n\t\t\t\tWarmupRemainingMs int    `json:\"warmup_remaining_ms\"`\r\n\t\t\t\tEffectiveWeight   int    `json:\"effective_weight\"`\r\n\t\t\t\tConfigWeight      int    `json:\"config_weight\"`\r\n\t\t\t} `json:\"endpoints\"`\r\n\t"]
[11741.037497, "o", "\t}\r\n\t\tif err := json.Unmarshal(data, &resp); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\tvar b strings.Builder\r\n\t\tfmt.Fprintf(&b, \"%-18s %-11s %-13s %-17s %-13s\\n\", \"ENDPOINT\", \"WARMING_UP\", \"REMAINING_MS\", \"EFFECTIVE_WEIGHT\", \"CONFIG_WEIGHT\")\r\n\t\tfor _, e := range resp.Endpoints {\r\n\t\t\tfmt.Fprintf(&b, \"%-18s %-11t %-13d %-17d %-13d\\n\", e.Endpoint, e.WarmingUp, e.WarmupRemainingMs, e.EffectiveWeight, e.ConfigWeight)\r\n\t\t}\r\n\t\t"]
[11741.037561, "o", "return strings.TrimRight(b.String(), \"\\n\"), nil\r\n\tcase \"set_weight\", \"drain_endpoint\", \"reset_circuit_breaker\", \"reload_config\", \"set_rate_limit\":\r\n\t\tvar s string\r\n\t\tif err := json.Unmarshal(data, &s); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\treturn s, nil\r\n\tcase \"get_connections\":\r\n\t\tvar resp struct {\r\n\t\t\tConnections []struct {\r\n\t\t\t\tEndpoint string `json:\"endpoint\"`\r\n\t\t\t\tClient   string `json:\"client\"`\r\n\t\t\t\tAgeMs    int64  `json:\"age_ms\"`\r\n\t\t\t\tIdleMs   int64  `json:\"idle_ms\"`\r\n\t\t\t\tBytesIn  int64  `json:\"bytes_in\"`\r\n"]
[11741.037633, "o", "\t\t\t\tBytesOut int64  `json:\"bytes_out\"`\r\n\t\t\t} `json:\"connections\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(data, &resp); err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"failed to decode response: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tfmt.Printf(\"%-18s %-18s %-9s %-9s %-10s %-10s\\n\", \"ENDPOINT\", \"CLIENT\", \"AGE_MS\", \"IDLE_MS\", \"BYTES_IN\", \"BYTES_OUT\")\r\n\t\tfor _, c := range resp.Connections {\r\n\t\t\tfmt.Printf(\"%-18s %-18s %-9d %-9d %-10d %-10d\\n\", c.Endpoint, c.Client, c.AgeMs, c.IdleMs, c.BytesIn, c.BytesOut)\r\n"]
[11741.037694, "o", "\t\t}\r\n\t\treturn \"\", nil\r\n\tcase \"get_access_log\":\r\n\t\tvar entries []struct {\r\n\t\t\tTs          string `json:\"ts\"`\r\n\t\t\tService     string `json:\"service\"`\r\n\t\t\tClient      string `json:\"client\"`\r\n"]
[11741.037758, "o", "\t\t\tEndpoint    string `json:\"endpoint\"`\r\n\t\t\tBytesIn     int64  `json:\"bytes_in\"`\r\n\t\t\tBytesOut    int64  `json:\"bytes_out\"`\r\n\t\t\tDurationMs  int64  `json:\"duration_ms\"`\r\n\t\t\tResult      string `json:\"result\"`\r\n\t\t\tRetried     bool   `json:\"retried\"`\r\n\t\t\tRetryCount  int    `json:\"retry_count\"`\r\n\t\t\tQueueWaitMs *int64 `json:\"queue_wait_ms,omitempty\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(data, &entries); err != nil {\r\n\t\t\treturn \"\", err\r\n\t"]
[11741.037835, "o", "\t}\r\n\t\tb, err := json.MarshalIndent(entries, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n"]
[11741.037901, "o", "\t\treturn string(b), nil\r\n\tcase \"get_access_stats\":\r\n\t\tvar st struct {\r\n\t\t\tTotalRequests int `json:\"total_requests\"`\r\n\t\t\tByResult      map[string]struct {\r\n\t\t\t\tCount         int   `json:\"count\"`\r\n\t\t\t\tAvgDurationMs int64 `json:\"avg_duration_ms\"`\r\n\t\t\t\tTotalBytesIn  int64 `json:\"total_bytes_in\"`\r\n\t\t\t\tTotalBytesOut int64 `json:\"total_bytes_out\"`\r\n\t\t\t} `json:\"by_result\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(data, &st); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\tvar b strings.Builder\r\n"]
[11741.037963, "o", "\t\tfmt.Fprintf(&b, \"%-20s %-6s %-15s %-15s %-15s\\n\", \"RESULT\", \"COUNT\", \"AVG_DURATION_MS\", \"TOTAL_BYTES_IN\", \"TOTAL_BYTES_OUT\")\r\n\t\tresults := make([]string, 0, len(st.ByResult))\r\n\t\tfor name := range st.ByResult {\r\n\t\t\tresults = append(results, name)\r\n\t\t}\r\n\t\tsort.Strings(results)\r\n\t\tfor _, name := range results {\r\n\t\t\tr := st.ByResult[name]\r\n\t\t"]
[11741.038026, "o", "\tfmt.Fprintf(&b, \"%-20s %-6d %-15d %-15d %-15d\\n\", name, r.Count, r.AvgDurationMs, r.TotalBytesIn, r.TotalBytesOut)\r\n\t\t}\r\n\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n\tcase \"get_rate_limit_status\":\r\n\t\tvar st struct {\r\n\t\t\tTokensAvailable float64 `json:\"tokens_available\"`\r\n\t\t\tQueueDepth      int     `json:\"queue_depth\"`\r\n\t\t\t"]
