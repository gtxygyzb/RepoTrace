[4630.387862, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/ipc/server.go')\ns = p.read_text()\ninsert = '''    case \"get_connections\":\n        var args struct {\n            Name string `json:\"name\"`\n        }\n        if err := json.Unmarshal(req.Args, &args); err != nil {\n            return nil, err\n        }\n        conns, ok := s.state.ConnectionsView(args.Name)\n        if !ok {\n            return nil, errors.New(\"service not found\")\n        }\n        return map[string]interface{}{\"connections\": conns}, nil\n    case \"set_rate_limit\":'''\nif 'case \"get_connections\":' not in s:\n    s = s.replace('    case \"set_rate_limit\":', insert)\np.write_text(s)\nPY\n"]
