[10632.208358, "o", "package state\r\n\r\nimport (\r\n\t\"net\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n"]
[10632.208522, "o", "\t\"sync/atomic\"\r\n\t\"time\"\r\n\r\n\t\"meshrouter/internal/circuit\"\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/stats\"\r\n)\r\n\r\ntype HealthState string\r\n\r\nconst (\r\n\tUnknown   HealthState = \"unknown\"\r\n\tHealthy   HealthState = \"healthy\"\r\n\tUnhealthy HealthState = \"unhealthy\"\r\n\tDraining  HealthState = \"draining\"\r\n)\r\n\r\ntype HealthEvent struct {\r\n\tTimestamp   time.Time\r\n\tEndpoint    string\r\n\tOldState    HealthState\r\n\tNewState    HealthState\r\n\tCheckResult string\r\n}\r\n\r\ntype EndpointState struct {\r\n\tmu                sync.Mutex\r\n\tAddress           string"]
[10632.208645, "o", "\r\n\tWeight            int\r\n\tConfig            config.Endpoint\r\n\tState             HealthState\r\n\tActiveConnections int\r\n\tCircuit           *circuit.Breaker\r\n\tStats             *stats.Collector\r\n\tconsecSuccess     int\r\n\tconsecFailures    int\r\n\tdrainDeadline     time.Time\r\n\tremoved           bool\r\n\tconnIDCounter     int64\r\n\tcurrentWeight     int\r\n\tWarmupDurationMs  int\r\n\twarmupUntil       time.Time\r\n\tconnections       map[int64]*connectionInfo\r\n}\r\n\r\ntype connectionInfo struct {\r\n\tconn         net.Conn\r\n\tclientAddr   string\r\n\t"]
[10632.208712, "o", "start        time.Time\r\n\tlastActivity time.Time\r\n\tbytesIn      int64\r\n\tbytesOut     int64\r\n}\r\n\r\ntype ServiceState struct {\r\n\tmu                        sync.Mutex\r\n\tName                      string\r\n\tListenPort                int\r\n\tRoutingMode               string\r\n\tDrainTimeoutMs            int\r\n\tMaxConnectionsPerEndpoint int"]
[10632.208777, "o", "\r\n\tConnectionLimitMode       string\r\n\tIdleTimeoutMs             int\r\n\tRateLimitRps              int\r\n\tRateLimitBurst            int\r\n\tRateLimitQueueDepth       int\r\n\tRateLimitQueueTimeoutMs   int\r\n\tMaxRetries                int\r\n\tRetryDelayMs              int\r\n\tRetryBackoffMultiplier    float64\r\n"]
[10632.20884, "o", "\tRetryMaxDelayMs           int\r\n\trateLimiter               *rateLimiter\r\n\tEndpoints                 []*EndpointState\r\n\trrIndex                   int\r\n\tListener                  net.Listener\r\n\tlistenerStop              chan struct{}\r\n\tstopping                  bool\r\n}\r\n\r\ntype State struct {\r\n\tmu         sync.RWMutex\r\n\tconfigPath string\r\n\tglobal     config.Global\r\n\t"]
[10632.208902, "o", "services   map[string]*ServiceState\r\n\tlogMu      sync.Mutex\r\n\thealthLog  map[string][]HealthEvent\r\n\treloadCh   chan struct{}\r\n}\r\n\r\nfunc NewState(cfg *config.Config, path string) *State {\r\n\ts := &State{\r\n\t\tconfigPath: path,\r\n\t\tservices:   make(map[string]*ServiceState),\r\n\t"]
[10632.208964, "o", "\thealthLog:  make(map[string][]HealthEvent),\r\n\t\treloadCh:   make(chan struct{}, 1),\r\n\t}\r\n\ts.applyConfigLocked(cfg)\r\n\treturn s\r\n}\r\n\r\nfunc (s *State) ReloadChan() <-chan struct{} {\r\n\treturn s.reloadCh\r\n"]
[10632.209026, "o", "}\r\n\r\nfunc (s *State) ConfigPath() string {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.configPath\r\n}\r\n\r\nfunc (s *State) Global() config.Global {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.global\r\n}\r\n"]
[10632.209085, "o", "\r\nfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\ts.applyConfigLocked(cfg)\r\n\tselect {\r\n\tcase s.reloadCh <- struct{}{}:\r\n\tdefault:\r\n\t}\r\n}\r\n\r\n"]
[10632.209147, "o", "func (s *State) applyConfigLocked(cfg *config.Config) {\r\n\ts.global = cfg.Global\r\n\tseen := make(map[string]bool)\r\n\tfor _, svc := range cfg.Services {\r\n\t\tseen[svc.Name] = true\r\n\t\tss := s.services[svc.Name]\r\n\t\tif ss == nil {\r\n\t\t\tss = newServiceState(svc, cfg.Global)\r\n\t\t\ts.services[svc.Name] = ss\r\n\t\t} else {\r\n"]
[10632.209211, "o", "\t\t\tss.mu.Lock()\r\n\t\t\tss.Name = svc.Name\r\n\t\t\tss.ListenPort = svc.ListenPort\r\n\t\t\tss.RoutingMode = svc.RoutingMode\r\n\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n\t\t\tss.RateLimitRps = svc.RateLimitRps\r\n\t\t\tss.RateLimitBurst = svc.RateLimitBurst\r\n\t\t\tss.RateLimitQueueDepth = svc.RateLimitQueueDepth\r\n\t\t\tss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs\r\n"]
[10632.209274, "o", "\t\t\tss.MaxRetries = svc.MaxRetries\r\n\t\t\tss.RetryDelayMs = svc.RetryDelayMs\r\n\t\t\tss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier\r\n\t\t\tss.RetryMaxDelayMs = svc.RetryMaxDelayMs\r\n\t\t\tif ss.rateLimiter == nil {\r\n\t\t\t\tss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n\t\t\t} else {\r\n\t\t\t\tss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n\t\t\t}\r\n\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n"]
[10632.209339, "o", "\t\t\tss.ConnectionLimitMode = svc.ConnectionLimitMode\r\n\t\t\tss.IdleTimeoutMs = svc.IdleTimeoutMs\r\n\t\t\tss.mu.Unlock()\r\n\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n\t\t}\r\n\t}\r\n\tfor name, ss := range s.services {\r\n\t\tif !seen[name] {\r\n"]
[10632.209407, "o", "\t\t\tss.mu.Lock()\r\n\t\t\tss.stopping = true\r\n\t\t\tif ss.listenerStop != nil {\r\n\t\t\t\tclose(ss.listenerStop)\r\n\t\t\t\tss.listenerStop = nil\r\n\t\t\t}\r\n"]
[10632.209471, "o", "\t\t\tif ss.Listener != nil {\r\n\t\t\t\tss.Listener.Close()\r\n\t\t\t\tss.Listener = nil\r\n\t\t\t}\r\n\t\t\tss.mu.Unlock()\r\n\t\t\tfor _, ep := range ss.Endpoints {\r\n\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n"]
[10632.209529, "o", "\r\nfunc newServiceState(svc config.Service, global config.Global) *ServiceState {\r\n\tss := &ServiceState{\r\n\t\tName:                      svc.Name,\r\n\t\tListenPort:                svc.ListenPort,\r\n\t\tRoutingMode:               svc.RoutingMode,\r\n\t\tDrainTimeoutMs:            svc.DrainTimeoutMs,\r\n\t\tRateLimitRps:              svc.RateLimitRps,\r\n\t\tRateLimitBurst:            svc.RateLimitBurst,\r\n\t\tRateLimitQueueDepth:       svc.RateLimitQueueDepth,\r\n"]
[10632.209595, "o", "\t\tRateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,\r\n\t\tMaxRetries:                svc.MaxRetries,\r\n\t\tRetryDelayMs:              svc.RetryDelayMs,\r\n\t\tRetryBackoffMultiplier:    svc.RetryBackoffMultiplier,\r\n\t\tRetryMaxDelayMs:           svc.RetryMaxDelayMs,\r\n\t\trateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),\r\n\t\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n\t\tConnectionLimitMode:       svc.ConnectionLimitMode,\r\n\t\tIdleTimeoutMs:             svc.IdleTimeoutMs,\r\n"]
[10632.209657, "o", "\t\tlistenerStop:              nil,\r\n\t}\r\n\tfor _, ep := range svc.Endpoints {\r\n\t\tss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))\r\n\t}\r\n\treturn ss\r\n}\r\n\r\nfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n\tss.mu.Lock()\r\n\tdefer ss.mu.Unlock()\r\n"]
[10632.209716, "o", "\tseen := make(map[string]bool)\r\n\tfor _, cep := range eps {\r\n\t\tseen[cep.Address] = true\r\n\t\tvar ep *EndpointState\r\n"]
