[2079.148433, "o", "   118\tfunc sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n   119\t\trawArgs, err := json.Marshal(args)\r\n   120\t\tif err != nil {\r\n   121\t\t\treturn \"\", err\r\n   122\t\t}\r\n   123\t\treq := request{Cmd: ipcCmd, Args: rawArgs}\r\n   124\t\treqBytes, err := json.Marshal(req)\r\n   125\t"]
[2079.148595, "o", "\tif err != nil {\r\n   126\t\t\treturn \"\", err\r\n   127\t\t}\r\n   128\t\r\n   129\t\tconn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n   130\t\tif err != nil {\r\n   131\t\t\treturn \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n"]
[2079.14867, "o", "   132\t\t}\r\n   133\t\tdefer conn.Close()\r\n   134\t\r\n   135\t\tfmt.Fprintf(conn, \"%s\\n\", string(reqBytes))\r\n   136\t\r\n   137\t\treader := bufio.NewReader(conn)\r\n   138\t\tline, err := reader.ReadString('\\n')\r\n   139\t\tif err != nil {\r\n   140\t\t\treturn \"\", err\r\n   141\t\t}\r\n   142\t\tline = strings.TrimRight(line, \"\\r\\n\")\r\n   143\t\r\n   144\t\tvar resp response\r\n   145\t\tif err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n   146\t\t\treturn \"\", err\r\n   147\t\t}\r\n   148\t\tif resp.Status != \"ok\" {\r\n   149\t\t\tvar msg string\r\n   150\t\t\tif err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n   151\t\t\t\treturn \"\", fmt.Errorf(\"%s\", msg)\r\n   152\t\t\t}\r\n   153\t\t\treturn \"\", fmt.Errorf(\"%s\", string(resp.Data))\r\n   154\t\t}\r\n   155\t\treturn prettyData(ipcCmd, resp.Data)\r\n   156\t}\r\n   157\t\r\n"]
[2079.14875, "o", "   158\tfunc prettyData(ipcCmd string, data json.RawMessage) (string, error) {\r\n   159\t\tswitch ipcCmd {\r\n   160\t\tcase \"list_services\":\r\n   161\t\t\tvar services []struct {\r\n   162\t\t\t\tName        string `json:\"name\"`\r\n   163\t\t\t\tListenPort  int    `json:\"listen_port\"`\r\n"]
[2079.148817, "o", "   164\t\t\t\tRoutingMode string `json:\"routing_mode\"`\r\n   165\t\t\t\tEndpoints   []struct {\r\n   166\t\t\t\t\tAddress           string `json:\"address\"`\r\n   167\t\t\t\t\tState             string `json:\"state\"`\r\n   168\t\t\t\t\tWeight            int    `json:\"weight\"`\r\n   169\t\t\t\t\tActiveConnections int    `json:\"active_connections\"`\r\n   170\t\t\t\t\tCircuitState      string `json:\"circuit_state\"`\r\n   171\t\t\t\t} `json:\"endpoints\"`\r\n   172\t\t\t}\r\n   173\t\t\tif err := json.Unmarshal(data, &services); err != nil {\r\n   174\t\t\t\treturn \"\", err\r\n   175\t\t\t}\r\n   176\t\t\tvar b strings.Builder\r\n"]
[2079.148882, "o", "   177\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\r\n   178\t\t\tfor _, svc := range services {\r\n   179\t\t\t\tfor _, ep := range svc.Endpoints {\r\n"]
[2079.148944, "o", "   180\t\t\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\r\n   181\t\t\t\t}\r\n   182\t\t\t}\r\n   183\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   184\t\tcase \"resolve\":\r\n   185\t\t\tvar addr string\r\n   186\t\t\tif err := json.Unmarshal(data, &addr); err != nil {\r\n   187\t\t\t\treturn \"\", err\r\n   188\t\t\t}\r\n   189\t\t\treturn addr, nil\r\n   190\t\tcase \"get_circuit_breakers\":\r\n   191\t\t\tvar circuits []struct {\r\n   192\t\t\t\tAddress             string `json:\"address\"`\r\n"]
[2079.149004, "o", "   193\t\t\t\tCircuitState        string `json:\"circuit_state\"`\r\n   194\t\t\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n   195\t\t\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n   196\t\t\t\tProbeActive         bool   `json:\"probe_active\"`\r\n   197\t\t\t}\r\n   198\t\t\tif err := json.Unmarshal(data, &circuits); err != nil {\r\n   199\t"]
[2079.14913, "o", "\t\t\treturn \"\", err\r\n   200\t\t\t}\r\n   201\t\t\tvar b strings.Builder\r\n   202\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9s %-17s %-7s\\n\", \"ENDPOINT\", \"CIRCUIT\", \"FAILURES\", \"TIME_IN_STATE_MS\", \"PROBE\")\r\n   203\t\t\tfor _, c := range circuits {\r\n"]
[2079.149193, "o", "   204\t\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9d %-17d %-7t\\n\", c.Address, c.CircuitState, c.ConsecutiveFailures, c.TimeInStateMs, c.ProbeActive)\r\n   205\t\t\t}\r\n   206\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   207\t\tcase \"set_weight\", \"drain_endpoint\", \"reset_circuit_breaker\", \"reload_config\":\r\n   208\t\t\tvar s string\r\n   209\t\t\tif err := json.Unmarshal(data, &s); err != nil {\r\n   210\t\t\t\treturn \"\", err\r\n   211\t\t\t}\r\n   212\t\t\treturn s, nil\r\n   213\t\tdefault:\r\n   214\t\t\tvar v interface{}\r\n   215\t\t\tif err := json.Unmarshal(data, &v); err != nil {\r\n   216\t\t\t\treturn \"\", err\r\n   217\t\t\t}\r\n   218\t\t\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n   219\t\t\tif err != nil {\r\n   220\t\t\t\treturn \"\", err\r\n   221\t\t\t}\r\n   222\t\t\treturn string(b), nil\r\n   223\t\t}\r\n   224\t}\r\n"]
