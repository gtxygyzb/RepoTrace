[8366.805749, "i", "cat > insert_cmds.py <<'PY'\nfrom pathlib import Path\n\n# Insert IPC cases\np = Path(\"internal/ipc/server.go\")\nlines = p.read_text().splitlines()\nif 'get_access_log' not in p.read_text():\n    for i, line in enumerate(lines):\n        if line.strip() == 'default:' and i > 100:\n            indent = line[:len(line)-len(line.lstrip())]\n            cases = [\n                'case \"get_access_log\":',\n                '    var args struct {',\n                '        Service       string `json:\"service\"`',\n                '        LastN         *int   `json:\"last_n\"`',\n                '        Result        string `json:\"result\"`',\n                '        MinDurationMs int64  `json:\"min_duration_ms\"`',\n                '    }',\n                '    if err := json.Unmarshal(req.Args, &args); err != nil {',\n                '        return nil, err',\n                '    }',\n                '    lastN := 20',\n                '    if args.LastN != nil {',\n                '        lastN = *args.LastN',\n                '    }'"]
[8366.806046, "i", ",\n                '    entries := accesslog.GetAccessLog(accesslog.DefaultPath, args.Service, args.Result, lastN, args.MinDurationMs)',\n                '    if entries == nil {',\n                '        entries = []accesslog.Entry{}',\n                '    }',\n                '    return entries, nil',\n                'case \"get_access_stats\":',\n                '    var args struct {',\n                '        Service string `json:\"service\"`',\n                '    }',\n                '    if err := json.Unmarshal(req.Args, &args); err != nil {',\n                '        return nil, err',\n                '    }',\n                '    return accesslog.Stats(accesslog.DefaultPath, args.Service), nil',\n            ]\n            new_lines = []\n            for c in cases:\n                new_lines.append(indent + c)\n            lines = lines[:i] + new_lines + lines[i:]\n            break\n    p.write_text(\"\\n\".join(lines) + \"\\n\")\nif '\"meshrouter/internal/accesslog\"' not in p.read_text():\n    s = p.read_text()\n    s ="]
