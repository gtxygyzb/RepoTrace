[9764.767034, "o", "\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tBytesOut   int64  `json:\"bytes_out\"`\r\n\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tDurationMs int64  `json:\"duration_ms\"`\r\n\u001b[32m\u001b[K338\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tResult     string `json:\"result\"`\r\n\u001b[32m\u001b[K339\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K340\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err := json.Unmarshal(data, &entries); err != nil {\r\n\u001b[32m\u001b[K341\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn \"\", err\r\n\u001b[32m\u001b[K342\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tb, err := json.MarshalIndent(entries, \"\", \"  \")\r\n\u001b[32m\u001b[K344\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err != nil {\r\n\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn \"\", err\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn string(b), nil\r\n"]
