[11434.198377, "o", "\t\t\tRetried     bool   `json:\"retried\"`\r\n\t\t\tRetryCount  int    `json:\"retry_count\"`\r\n\t\t\tQueueWaitMs *int64 `json:\"queue_wait_ms,omitempty\"`\r\n\t"]
[11434.198426, "o", "\t}\r\n\t\tif err := json.Unmarshal(data, &entries); err != nil {\r\n"]
[11434.198458, "o", "\t\t\treturn \"\", err\r\n\t\t}\r\n\t\tb, err := json.MarshalIndent(entries, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\treturn \"\", err\r\n"]
[11434.198489, "o", "\t\t}\r\n\t\treturn string(b), nil\r\n\tcase \"get_access_stats\":\r\n\t\tvar st struct {\r\n"]
[11434.198515, "o", "\t\t\tTotalRequests int `json:\"total_requests\"`\r\n\t\t\tByResult      map[string]struct {\r\n\t\t\t\t"]
[11434.198546, "o", "Count         int   `json:\"count\"`\r\n\t\t\t\tAvgDurationMs int64 `json:\"avg_duration_ms\"`\r\n\t\t\t\tTotalBytesIn  int64 `json:\"total_bytes_in\"`\r\n"]
[11434.198572, "o", "\t\t\t\tTotalBytesOut int64 `json:\"total_bytes_out\"`\r\n\t\t\t} `json:\"by_result\"`\r\n"]
[11434.198597, "o", "\t\t}\r\n\t\tif err := json.Unmarshal(data, &st); err != nil {\r\n\t\t\treturn \"\", err\r\n"]
[11434.198627, "o", "\t\t}\r\n\t\tvar b strings.Builder\r\n\t\tfmt.Fprintf(&b, \"%-20s %-6s %-15s %-15s %-15s\\n\", \"RESULT\", \"COUNT\", \"AVG_DURATION_MS\", \"TOTAL_BYTES_IN\", \"TOTAL_BYTES_OUT\")\r\n"]
[11434.198652, "o", "\t\tresults := make([]string, 0, len(st.ByResult))\r\n\t\tfor name := range st.ByResult {\r\n"]
[11434.198668, "o", "\t\t\tresults = append(results, name)\r\n"]
[11434.198712, "o", "\t\t}\r\n\t\tsort.Strings(results)\r\n\t\tfor _, name := range results {\r\n\t\t\tr := st.ByResult[name]\r\n\t\t\tfmt.Fprintf(&b, \"%-20s %-6d %-15d %-15d %-15d\\n\", name, r.Count, r.AvgDurationMs, r.TotalBytesIn, r.TotalBytesOut)\r\n"]
[11434.198745, "o", "\t\t}\r\n\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n\tcase \"get_rate_limit_status\":\r\n\t"]
