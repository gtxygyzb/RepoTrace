[2557.869168, "o", "\u001b[?2004h> "]
[2557.869288, "o", "old3 = '''\\tdefault:\r\n\u001b[?2004l\r"]
[2557.869342, "o", "\u001b[?2004h> "]
[2557.869496, "o", "\\t\\tvar v interface{}'''\r\n\u001b[?2004l\r"]
[2557.869551, "o", "\u001b[?2004h> "]
[2557.869787, "o", "new3 = '''\\tcase \"get_rate_limit_status\":\r\n\u001b[?2004l\r"]
[2557.86985, "o", "\u001b[?2004h> "]
[2557.869959, "o", "\\t\\tvar st struct {\r\n\u001b[?2004l\r"]
[2557.870014, "o", "\u001b[?2004h> "]
[2557.870329, "o", "\\t\\t\\tTokensAvailable float64 `json:\"tokens_available\"`\r\n\u001b[?2004l\r"]
[2557.870386, "o", "\u001b[?2004h> "]
[2557.870681, "o", "\\t\\t\\tQueueDepth      int     `json:\"queue_depth\"`\r\n\u001b[?2004l\r"]
[2557.870734, "o", "\u001b[?2004h> "]
[2557.870976, "o", "\\t\\t\\tRateLimited     int     `json:\"rate_limited\"`\r\n\u001b[?2004l\r"]
[2557.87103, "o", "\u001b[?2004h> "]
[2557.871206, "o", "\\t\\t\\tQueued          int     `json:\"queued\"`\r\n\u001b[?2004l\r"]
[2557.87126, "o", "\u001b[?2004h> "]
[2557.871471, "o", "\\t\\t\\tQueueTimeouts   int     `json:\"queue_timeouts\"`\r\n\u001b[?2004l\r"]
[2557.871526, "o", "\u001b[?2004h> "]
[2557.871692, "o", "\\t\\t\\tRps             float64 `json:\"rps\"`\r\n\u001b[?2004l\r"]
[2557.871747, "o", "\u001b[?2004h> "]
[2557.871918, "o", "\\t\\t\\tBurst           float64 `json:\"burst\"`\r\n\u001b[?2004l\r"]
[2557.871973, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[2557.87203, "o", "\u001b[?2004h> "]
[2557.872247, "o", "\\t\\tif err := json.Unmarshal(data, &st); err != nil {\r\n\u001b[?2004l\r"]
[2557.872302, "o", "\u001b[?2004h> "]
[2557.872373, "o", "\\t\\t\\treturn \"\", err\r\n\u001b[?2004l\r"]
[2557.872434, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r"]
[2557.872489, "o", "\u001b[?2004h> "]
[2557.872595, "o", "\\t\\tvar b strings.Builder\r\n\u001b[?2004l\r"]
[2557.87265, "o", "\u001b[?2004h> "]
[2557.873227, "o", "\\t\\tfmt.Fprintf(&b, \"%-10s %-6s %-7s %-10s %-8s %-14s %-15s\\\\n\", \"SERVICE\", \"RPS\", \"BURST\", \"TOKENS\", \"QUEUED\", \"RATE_LIMITED\", \"QUEUE_TIMEOUTS\")\r\n\u001b[?2004l\r"]
[2557.873289, "o", "\u001b[?2004h> "]
[2557.873964, "o", "\\t\\tfmt.Fprintf(&b, \"%-10s %-6.0f %-7.0f %-10.2f %-8d %-14d %-15d\\\\n\", os.Args[2], st.Rps, st.Burst, st.TokensAvailable, st.QueueDepth, st.RateLimited, st.QueueTimeouts)\r\n\u001b[?2004l\r"]
[2557.874022, "o", "\u001b[?2004h> "]
[2557.874226, "o", "\\t\\treturn strings.TrimRight(b.String(), \"\\\\n\"), nil\r\n\u001b[?2004l\r"]
[2557.874281, "o", "\u001b[?2004h> "]
[2557.874341, "o", "\\tdefault:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2557.874464, "o", "\\t\\tvar v interface{}'''\r\n\u001b[?2004l\r"]
[2557.874522, "o", "\u001b[?2004h> "]
