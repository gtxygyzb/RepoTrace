[4130.464323, "o", "   131\t\t\t\tss.ListenPort = svc.ListenPort\r\n   132\t\t\t\tss.RoutingMode = svc.RoutingMode\r\n   133\t\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n   134\t\t\t\tss.RateLimitRps = svc.RateLimitRps\r\n   135\t\t\t\tss.RateLimitBurst = svc.RateLimitBurst\r\n   136\t\t\t\tss.RateLimitQueueDepth = svc.RateLimitQueueDepth\r\n"]
[4130.464401, "o", "   137\t\t\t\tss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs\r\n   138\t\t\t\tss.MaxRetries = svc.MaxRetries\r\n   139\t\t\t\tss.RetryDelayMs = svc.RetryDelayMs\r\n   140\t\t\t\tss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier\r\n   141\t\t\t\tss.RetryMaxDelayMs = svc.RetryMaxDelayMs\r\n   142\t\t\t\tif ss.rateLimiter == nil {\r\n   143\t\t"]
[4130.464465, "o", "\t\t\tss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n   144\t\t\t\t} else {\r\n   145\t\t\t\t\tss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n   146\t\t\t\t}\r\n   147\t\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n   148\t\t\t\tss.mu.Unlock()\r\n   149\t\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n   150\t\t\t}\r\n   151\t\t}\r\n   152\t\tfor name, ss := range s.services {\r\n"]
[4130.464529, "o", "   153\t\t\tif !seen[name] {\r\n   154\t\t\t\tss.mu.Lock()\r\n   155\t\t\t\tss.stopping = true\r\n   156\t\t\t\tif ss.listenerStop != nil {\r\n   157\t\t\t\t\tclose(ss.listenerStop)\r\n   158\t\t\t\t\tss.listenerStop = nil\r\n   159\t\t\t\t}\r\n   160\t\t\t\tif ss.Listener != nil {\r\n   161\t\t\t\t\tss.Listener.Close()\r\n   162"]
[4130.464588, "o", "\t\t\t\t\tss.Listener = nil\r\n   163\t\t\t\t}\r\n   164\t\t\t\tss.mu.Unlock()\r\n   165\t\t\t\tfor _, ep := range ss.Endpoints {\r\n   166\t\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   167\t\t\t\t}\r\n   168\t\t\t}\r\n   169\t\t}\r\n   170\t}\r\n"]
[4130.46466, "o", "   171\t\r\n   172\tfunc newServiceState(svc config.Service, global config.Global) *ServiceState {\r\n   173\t\tss := &ServiceState{\r\n   174\t\t\tName:                      svc.Name,\r\n   175\t\t\tListenPort:                svc.ListenPort,\r\n   176\t\t\tRoutingMode:               svc.RoutingMode,\r\n   177\t\t\tDrainTimeoutMs:            svc.DrainTimeoutMs,\r\n   178\t\t\tRateLimitRps:              svc.RateLimitRps,\r\n   179\t\t\tRateLimitBurst:            svc.RateLimitBurst,\r\n   180\t\t\tRateLimitQueueDepth:       svc.RateLimitQueueDepth,\r\n"]
[4130.464727, "o", "   181\t\t\tRateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,\r\n   182\t\t\tMaxRetries:                svc.MaxRetries,\r\n   183\t\t\tRetryDelayMs:              svc.RetryDelayMs,\r\n   184\t\t\tRetryBackoffMultiplier:    svc.RetryBackoffMultiplier,\r\n   185\t\t\tRetryMaxDelayMs:           svc.RetryMaxDelayMs,\r\n   186\t\t\trateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),\r\n   187\t\t\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n   188\t\t\tlistenerStop:              nil,\r\n   189\t\t}\r\n   190\t\tfor _, ep := range svc.Endpoints {"]
