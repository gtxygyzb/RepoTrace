[11434.198152, "o", "\t\t\t\tBytesIn  int64  `json:\"bytes_in\"`\r\n\t\t\t\tBytesOut int64  `json:\"bytes_out\"`\r\n\t\t\t} `json:\"connections\"`\r\n\t\t}\r\n"]
