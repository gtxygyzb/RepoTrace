[11453.160561, "o", "\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tg := s.state.Global()\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tsv, ok := s.state.StatsView(args.Name, g.StatsWindowSec)\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif !ok {\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn nil, errors.New(\"service not found\")\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K304\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K305\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err := json.Unmarshal(req.Args, &args); err != nil {"]
[11453.160616, "o", "\r\n\u001b[32m\u001b[K306\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn nil, err\r\n\u001b[32m\u001b[K307\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn accesslog.Stats(accesslog.DefaultPath, args.Service), nil\r\n"]
[11453.160672, "o", "\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"get_dependencies\"\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K310\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tvar args struct {\r\n\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tService string `json:\"service\"`\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n"]
[11453.160725, "o", "\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn nil, err\r\n\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tdeps := s.state.DependencyStatuses(args.Service)\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif deps == nil {\r\n\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tdeps = []state.DependencyStatus{}\r\n\u001b[32m\u001b[K319\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn map[string]interface{}{\r\n"]
[11453.160782, "o", "\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\"service\":      args.Service,\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\"dependencies\": deps,\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}, nil\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefault:\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn nil, fmt.Errorf(\"unknown command: %s\", req.Cmd)\r\n\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K327\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
