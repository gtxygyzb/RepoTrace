[11530.122992, "o", "s = p.read_text()\r\n\u001b[?2004l\r"]
[11530.12308, "o", "\u001b[?2004h> "]
[11530.123139, "o", "s = s.replace(\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.123201, "o", "> "]
