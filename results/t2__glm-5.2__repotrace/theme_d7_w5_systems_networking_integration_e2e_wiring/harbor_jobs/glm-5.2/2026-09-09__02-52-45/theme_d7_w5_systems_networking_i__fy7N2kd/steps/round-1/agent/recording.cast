[5893.073837, "o", "    85\tfunc (m *Monitor) run(ctx context.Context, cfg *config.Config, service string, ep config.Endpoint, done chan struct{}) {\r\n    86\t\tdefer close(done)\r\n    87\t\tinterval := time.Duration(cfg.Global.HealthIntervalMs) * time.Millisecond\r\n    88\t\tif interval <= 0 {\r\n    89\t\t\tinterval = 2 * time.Second\r\n    90\t\t}\r\n    91\t\tticker := time.NewTicker(interval)\r\n    92"]
[5893.073968, "o", "\t\tdefer ticker.Stop()\r\n    93\t\tfor {\r\n    94\t\t\tselect {\r\n    95\t\t\tcase <-ctx.Done():\r\n    96\t\t\t\treturn\r\n    97\t\t\tcase <-m.stop:\r\n    98\t\t\t\treturn\r\n    99\t\t\tcase <-ticker.C:\r\n   100\t\t\t}\r\n   101\t\t\tsuccess := checkEndpoint(ctx, ep)\r\n   102\t\t\tm.state.RecordHealthCheck(service, ep.Address, success)\r\n   103\t\t\tif ss := m.state.GetService(service); ss != nil {\r\n   104\t\t\t\tif eps := m.state.GetEndpoint(service, ep.Address); eps != nil {\r\n   105\t\t\t\t\teps.Circuit.MaybeHalfOpen()\r\n   106\t\t\t\t}\r\n   107\t\t\t\t_ = ss\r\n   108\t\t\t}\r\n   109\t\t}\r\n   110\t}\r\n"]
