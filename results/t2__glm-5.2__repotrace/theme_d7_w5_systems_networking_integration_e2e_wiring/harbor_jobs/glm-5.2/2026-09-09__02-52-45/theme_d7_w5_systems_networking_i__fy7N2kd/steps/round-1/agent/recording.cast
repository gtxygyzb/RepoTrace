[9549.947652, "o", "\t\tif ss != nil {\r\n\t\t\ttimeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n\t\t\tif timeout <= 0 {\r\n\t\t\t\ttimeout = 5 * time.Second\r\n\t\t\t}\r\n\t\t}\r\n\t\tdone := make(chan struct{})\r\n\t\tgo func() {\r\n\t\t\tsl.wg.Wait()\r\n\t\t\tclose(done)\r\n\t\t}()\r\n\t\t"]
[9549.94774, "o", "select {\r\n\t\tcase <-done:\r\n\t\tcase <-time.After(timeout):\r\n\t\t\tr.state.CloseServiceConnections(sl.service)\r\n\t\t\t<-done\r\n\t\t}\r\n\t} else {\r\n\t\tsl.wg.Wait()\r\n\t}\r\n}\r\n\r\nfunc (r *Router) handleConn(service string, client net.Conn) {\r\n\tstart := time.Now()\r\n\tclientAddr := \"\"\r\n\tif addr := client.RemoteAddr(); addr != nil {\r\n\t\tclientAddr = addr.String()\r\n"]
[9549.947804, "o", "\t}\r\n\r\n\tvar endpoint string\r\n\tvar bytesIn, bytesOut int64\r\n\tvar result string\r\n\tdefer func() {\r\n\t\tif result == \"\" {\r\n\t\t\tresult = \"success\"\r\n\t\t}\r\n"]
[9549.947871, "o", "\t\tif r.accessLog != nil {\r\n\t\t\tr.accessLog.Log(accesslog.Entry{\r\n\t\t\t\tService:    service,\r\n\t\t\t\tClient:     clientAddr,\r\n\t\t\t\tEndpoint:   endpoint,\r\n\t\t\t\tBytesIn:    bytesIn,\r\n\t\t\t\tBytesOut:   bytesOut,\r\n\t\t\t\tDurationMs: time.Since(start).Milliseconds(),\r\n\t\t\t\tResult:     result,\r\n"]
[9549.947946, "o", "\t\t\t})\r\n\t\t}\r\n\t}()\r\n\r\n\tss := r.state.GetService(service)\r\n\tif ss == nil {\r\n\t\tresult = \"rejected_no_endpoint\"\r\n\t\tclient.Close()\r\n\t\treturn\r\n\t}\r\n\r\n\tallowed, queued := ss.AcquireRateLimitToken()\r\n\tif !allowed {\r\n"]
[9549.948071, "o", "\t\tresult = \"rejected_rate_limit\"\r\n\t\tclient.Close()\r\n\t\treturn\r\n\t}\r\n\tif queued {\r\n\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n\t\t\tcand.Stats.RecordQueued()\r\n\t\t}\r\n\t}\r\n\r\n\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\r\n\tvar lastEndpoint *state.EndpointState\r\n\tfor attempt := 0; ; attempt++ {\r\n\t\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\r\n\t\tif err != nil {\r\n\t\t\tresult = \"rejected_no_endpoint\"\r\n"]
[9549.948167, "o", "\t\t\tendpoint = \"\"\r\n\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n\t\t\t\tss := r.state.GetService(service)\r\n\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n\t\t\t\t\tcand.Stats.RecordRejection()\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tclient.Close()\r\n\t\t\treturn\r\n\t\t}\r\n\t\tlastEndpoint = res.Endpoint\r\n\t\tep := res.Endpoint\r\n\t\tendpoint = ep.Address\r\n\r\n\t\tvar id int64\r\n"]
[9549.948442, "o", "\t\tif !res.Probe {\r\n\t\t\tvar ok bool\r\n\t\t\tid, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\r\n\t\t\tif !ok {\r\n\t\t\t\tresult = \"rejected_conn_limit\"\r\n\t\t\t\tep.Stats.RecordRejection()\r\n\t\t\t\tclient.Close()\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tbackend, derr := net.Dial(\"tcp\", ep.Address)\r\n\t\tif derr != nil {\r\n\t\t\tif id != 0 {\r\n\t\t\t\tep.RemoveConnection(id)\r\n\t\t\t}\r\n\t\t\tep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n\t\t\tif res.Probe {\r\n\t\t\t\tep.Circuit.ProbeFailure()\r\n\t\t\t} else {\r\n\t\t\t\tep.Circuit.Open()\r\n\t\t\t}\r\n\t\t\tif attempt >= maxRetries {\r\n\t\t\t\tresult = \"retry_exhausted\"\r\n\t\t\t\tclient.Close()\r\n\t\t\t\treturn\r\n\t\t\t}\r\n"]
