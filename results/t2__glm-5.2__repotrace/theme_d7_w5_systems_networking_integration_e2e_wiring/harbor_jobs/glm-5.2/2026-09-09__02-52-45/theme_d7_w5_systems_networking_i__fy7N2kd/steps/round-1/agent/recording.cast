[5748.710837, "o", "\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks   []struct {\r\n\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tWeight            int    `json:\"\u001b[01;31m\u001b[Kweight\u001b[m\u001b[K\"`\r\n\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K202\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tActiveConnections int    `json:\"active_\u001b[01;31m\u001b[Kconnections\u001b[m\u001b[K\"`\r\n"]
[5748.710918, "o", "\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor _, ep := range svc.\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks {\r\n\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"set_\u001b[01;31m\u001b[Kweight\u001b[m\u001b[K\", \"drain_endpoint\", \"reset_circuit_breaker\", \"reload_config\", \"set_rate_limit\":\r\n\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \"get_\u001b[01;31m\u001b[Kconnections\u001b[m\u001b[K\":\r\n"]
