[1148.261836, "i", "   rawArgs = b\n    } else {\n        rawArgs = json.RawMessage(\"{}\")\n    }\n    req := request{Cmd: cmd, Args: rawArgs}\n    reqBytes, err := json.Marshal(req)\n    if err != nil {\n        return \"\", err\n    }\n    conn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\n    if err != nil {\n        return \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\n    }\n    defer conn.Close()\n    fmt.Fprintf(conn, \"%s\\n\", string(reqBytes))\n    reader := bufio.NewReader(conn)\n    line, err := reader.ReadString('\\n')\n    if err != nil {\n        return \"\", err\n    }\n    line = strings.TrimRight(line, \"\\r\\n\")\n    var resp response\n    if err := json.Unmarshal([]byte(line), &resp); err != nil {\n        return \"\", err\n    }\n    if resp.Status != \"ok\" {\n        var msg string\n        if err := json.Unmarshal(resp.Data, &msg); err == nil {\n            return \"\", fmt.Errorf(\"%s\", msg)\n        }\n        return \"\", fmt.Errorf(\"%s\", string(resp.Data))\n    }\n    return prettyData(cmd, resp.Data)\n}\n\nfunc prettyData(cmd string, data json.RawMess"]
