[1975.357139, "o", "    96\t\tdefer s.mu.RUnlock()\r\n    97\t\treturn s.global\r\n    98\t}\r\n    99\t\r\n   100\tfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n   101\t\ts.mu.Lock()\r\n   102\t\tdefer s.mu.Unlock()\r\n   103\t\ts.applyConfigLocked(cfg)\r\n   104\t\tselect {\r\n   105\t\tcase s.reloadCh <- struct{}{}:\r\n   106"]
[1975.3572, "o", "\t\tdefault:\r\n   107\t\t}\r\n   108\t}\r\n   109\t\r\n   110\tfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n   111\t\ts.global = cfg.Global\r\n   112\t\tseen := make(map[string]bool)\r\n   113\t\tfor _, svc := range cfg.Services {\r\n   114\t\t\tseen[svc.Name] = true\r\n   115"]
