[11441.652204, "o", "\t\tfmt.Fprintf(&b, \"%-10s %-6s %-7s %-10s %-8s %-14s %-15s\\n\", \"SERVICE\", \"RPS\", \"BURST\", \"TOKENS\", \"QUEUED\", \"RATE_LIMITED\", \"QUEUE_TIMEOUTS\")\r\n\t\tfmt.Fprintf(&b, \"%-10s %-6.0f %-7.0f %-10.2f %-8d %-14d %-15d\\n\", os.Args[2], st.Rps, st.Burst, st.TokensAvailable, st.QueueDepth, st.RateLimited, st.QueueTimeouts)\r\n\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n\tcase \"get_dependencies\":\r\n\t\tvar resp struct {\r\n\t\t\tService      string `json:\"service\"`\r\n\t\t\tDependencies []struct {\r\n\t\t\t\tName             string `json:\"name\"`\r\n\t\t\t\tAvailable        bool   `json:\"available\"`\r\n\t\t\t\tHealthyEndpoints int    `json:\"healthy_endpoints\"`\r\n\t\t\t} `json:\"dependencies\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(data, &resp); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\tif len(resp.Dependencies) == 0 {\r\n\t\t\treturn \"no dependencies\", nil\r\n\t\t}\r\n\t\tvar b strings.Builder\r\n\t\tfmt.Fprintf(&b, \"%-14s %-14s %-10s %-18s\\n\", \"SERVICE\", \"DEPENDS_ON\", \"AVAILABLE\", \"HEALTHY_ENDPOINTS\")\r\n\t\tfor _, dep := range resp.Dependencies {"]
[11441.652312, "o", "\r\n\t\t\tfmt.Fprintf(&b, \"%-14s %-14s %-10t %-18d\\n\", resp.Service, dep.Name, dep.Available, dep.HealthyEndpoints)\r\n\t\t}\r\n\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n\tdefault:\r\n\t\tvar v interface{}\r\n\t\tif err := json.Unmarshal(data, &v); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n"]
[11441.652445, "o", "\t\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\treturn string(b), nil\r\n"]
