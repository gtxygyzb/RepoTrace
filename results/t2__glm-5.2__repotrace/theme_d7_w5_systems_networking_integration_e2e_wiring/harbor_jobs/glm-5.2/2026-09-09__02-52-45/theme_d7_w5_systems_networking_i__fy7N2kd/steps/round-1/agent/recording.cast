[13870.095667, "o", "   287\t\t\t\tMinDurationMs int64  `json:\"min_duration_ms\"`\r\n   288\t\t\t}\r\n   289\t\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n   290\t\t\t\treturn nil, err\r\n   291\t\t\t}\r\n   292\t\t\tlastN := 20\r\n   293\t\t\tif args.LastN != nil {\r\n   294\t\t\t\tlastN = *args.LastN\r\n   295\t\t\t}\r\n   296\t\t\tentries := accesslog.GetAccessLog(accesslog.DefaultPath, args.Service, args.Result, lastN, args.MinDurationMs)\r\n"]
