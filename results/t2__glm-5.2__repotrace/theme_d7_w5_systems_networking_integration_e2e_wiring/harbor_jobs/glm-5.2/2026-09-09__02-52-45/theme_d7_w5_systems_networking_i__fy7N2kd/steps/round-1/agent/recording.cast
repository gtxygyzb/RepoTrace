[10586.684643, "o", "   123\tfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n   124\t\ts.mu.Lock()\r\n   125\t\tdefer s.mu.Unlock()\r\n   126\t\ts.applyConfigLocked(cfg)\r\n   127\t\tselect {\r\n   128\t\tcase s.reloadCh <- struct{}{}:\r\n   129\t\tdefault:\r\n   130\t\t}\r\n   131\t}\r\n"]
[10586.684699, "o", "   132\t\r\n   133\tfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n   134\t\ts.global = cfg.Global\r\n   135\t\tseen := make(map[string]bool)\r\n   136\t\tfor _, svc := range cfg.Services {\r\n   137\t\t\tseen[svc.Name] = true\r\n   138\t\t\tss := s.services[svc.Name]\r\n"]
[10586.684761, "o", "   139\t\t\tif ss == nil {\r\n   140\t\t\t\tss = newServiceState(svc, cfg.Global)\r\n   141\t\t\t\ts.services[svc.Name] = ss\r\n   142\t\t\t} else {\r\n   143\t\t\t\tss.mu.Lock()\r\n   144\t\t\t\tss.Name = svc.Name\r\n   145\t\t\t\tss.ListenPort = svc.ListenPort\r\n"]
[10586.684818, "o", "   146\t\t\t\tss.RoutingMode = svc.RoutingMode\r\n   147\t\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n   148\t\t\t\tss.RateLimitRps = svc.RateLimitRps\r\n   149\t\t\t\tss.RateLimitBurst = svc.RateLimitBurst\r\n   150\t\t\t\tss.RateLimitQueueDepth = svc.RateLimitQueueDepth\r\n   151\t\t\t\tss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs\r\n   152\t\t"]
[10586.684885, "o", "\t\tss.MaxRetries = svc.MaxRetries\r\n   153\t\t\t\tss.RetryDelayMs = svc.RetryDelayMs\r\n   154\t\t\t\tss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier\r\n   155\t\t\t\tss.RetryMaxDelayMs = svc.RetryMaxDelayMs\r\n   156\t\t\t\tif ss.rateLimiter == nil {\r\n   157\t\t\t\t\tss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n   158\t\t\t\t} else {\r\n   159\t\t\t\t\tss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n   160\t\t\t\t}\r\n   161\t\t"]
[10586.684948, "o", "\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n   162\t\t\t\tss.ConnectionLimitMode = svc.ConnectionLimitMode\r\n   163\t\t\t\tss.IdleTimeoutMs = svc.IdleTimeoutMs\r\n   164\t\t\t\tss.mu.Unlock()\r\n   165\t\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n   166\t\t\t}\r\n   167\t\t}\r\n   168\t\tfor name, ss := range s.services {\r\n"]
[10586.685011, "o", "   169\t\t\tif !seen[name] {\r\n   170\t\t\t\tss.mu.Lock()\r\n   171\t\t\t\tss.stopping = true\r\n   172\t\t\t\tif ss.listenerStop != nil {\r\n   173\t\t\t\t\tclose(ss.listenerStop)\r\n   174\t\t\t\t\tss.listenerStop = nil\r\n   175\t\t\t\t}\r\n   176\t\t\t\tif ss.Listener != nil {\r\n   177\t\t\t\t\tss.Listener.Close()\r\n"]
[10586.685067, "o", "   178\t\t\t\t\tss.Listener = nil\r\n   179\t\t\t\t}\r\n   180\t\t\t\tss.mu.Unlock()\r\n   181\t\t\t\tfor _, ep := range ss.Endpoints {\r\n   182\t\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   183\t\t\t\t}\r\n   184\t\t\t}\r\n"]
[10586.685126, "o", "   185\t\t}\r\n   186\t}\r\n   187\t\r\n   188\tfunc newServiceState(svc config.Service, global config.Global) *ServiceState {\r\n   189\t\tss := &ServiceState{\r\n   190\t\t\tName:                      svc.Name,\r\n   191\t\t\tListenPort:                svc.ListenPort,\r\n   192\t\t\tRoutingMode:               svc.RoutingMode,\r\n"]
[10586.685193, "o", "   193\t\t\tDrainTimeoutMs:            svc.DrainTimeoutMs,\r\n   194\t\t\tRateLimitRps:              svc.RateLimitRps,\r\n   195\t\t\tRateLimitBurst:            svc.RateLimitBurst,\r\n   196\t\t\tRateLimitQueueDepth:       svc.RateLimitQueueDepth,\r\n   197\t\t\tRateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,\r\n   198\t\t\tMaxRetries:                svc.MaxRetries,\r\n   199\t\t\tRetryDelayMs:              svc.RetryDelayMs,\r\n   200\t\t\tRetryBackoffMultiplier:    svc.RetryBackoffMultiplier,\r\n   201\t\t\tRetryMaxDelayMs:           svc.RetryMaxDelayMs,\r\n   202\t\t\trateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),\r\n   203\t"]
[10586.685257, "o", "\t\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n   204\t\t\tConnectionLimitMode:       svc.ConnectionLimitMode,\r\n   205\t\t\tIdleTimeoutMs:             svc.IdleTimeoutMs,\r\n   206\t\t\tlistenerStop:              nil,\r\n   207\t\t}\r\n   208\t\tfor _, ep := range svc.Endpoints {\r\n   209\t\t\tss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))\r\n   210\t\t}\r\n   211\t\treturn ss\r\n   212\t}\r\n"]
[10586.685323, "o", "   213\t\r\n   214\tfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n   215\t\tss.mu.Lock()\r\n   216\t\tdefer ss.mu.Unlock()\r\n   217\t\tseen := make(map[string]bool)\r\n   218\t\tfor _, cep := range eps {\r\n   219\t\t\tseen[cep.Address] = true\r\n   220\t\t\tvar ep *EndpointState\r\n   221\t\t\tfor _, existing := range ss.Endpoints {\r\n"]
[10586.685379, "o", "   222\t\t\t\tif existing.Address == cep.Address {\r\n   223\t\t\t\t\tep = existing\r\n   224\t\t\t\t\tbreak\r\n   225\t\t\t\t}\r\n   226\t\t\t}\r\n   227\t\t\tif ep == nil {\r\n"]
[10586.685463, "o", "   228\t\t\t\tep = newEndpointState(cep, global)\r\n   229\t\t\t\tss.Endpoints = append(ss.Endpoints, ep)\r\n   230\t\t\t} else {\r\n   231\t\t\t\tep.mu.Lock()\r\n   232\t\t\t\tep.Config = cep\r\n   233\t\t\t\tep.Weight = cep.Weight\r\n   234\t\t\t\tep.WarmupDurationMs = cep.WarmupDurationMs\r\n   235\t\t\t\tep.mu.Unlock()\r\n   236\t\t\t}\r\n   237\t\t}\r\n   238\t\tfor _, ep := range ss.Endpoints {\r\n   239"]
[10586.685526, "o", "\t\t\tif !seen[ep.Address] {\r\n   240\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   241\t\t\t}\r\n   242\t\t}\r\n   243\t}\r\n   244\t\r\n   245\tfunc newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {\r\n   246\t\treturn &EndpointState{\r\n   247\t\t\tAddress:          cep.Address,\r\n"]
[10586.685584, "o", "   248\t\t\tWeight:           cep.Weight,\r\n   249\t\t\tWarmupDurationMs: cep.WarmupDurationMs,\r\n   250\t\t\tConfig:           cep,\r\n   251\t\t\tState:            Unknown,\r\n   252\t\t\tCircuit:          circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n   253\t\t\tStats:            stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n   254\t\t\tconnections:      make(map[int64]*connectionInfo),\r\n"]
[10586.685645, "o", "   255\t\t}\r\n   256\t}\r\n   257\t\r\n   258\tfunc (s *State) GetService(name string) *ServiceState {\r\n   259\t\ts.mu.RLock()\r\n   260\t\tdefer s.mu.RUnlock()\r\n"]
