[12974.360797, "o", "cat -n internal/circuit/breaker.go\r\n"]
[12974.360925, "o", "\u001b[?2004l\r"]
[12974.363376, "o", "     1\tpackage circuit\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"sync\"\r\n     5\t\t\"time\"\r\n     6\t)\r\n     7\t\r\n     8\ttype State string\r\n     9\t\r\n    10\tconst (\r\n    11\t\tClosed   State = \"closed\"\r\n    12\t\tOpen     State = \"open\"\r\n    13\t\tHalfOpen State = \"half_open\"\r\n    14\t)\r\n    15\t\r\n    16\t// Breaker implements an endpoint circuit breaker.\r\n    17\ttype Breaker struct {\r\n    18\t\tmu                  sync.Mutex\r\n    19\t\tstate               State\r\n    20\t\t"]
[12974.363537, "o", "consecutiveFailures int\r\n    21\t\tstateChangedAt      time.Time\r\n    22\t\topenedAt            time.Time\r\n    23\t\ttimeout             time.Duration\r\n    24\t\tprobeActive         bool\r\n    25\t}\r\n    26\t\r\n    27\t// New creates a closed breaker with the given open timeout.\r\n    28\tfunc New(timeout time.Duration) *Breaker {\r\n    29\t\tnow := time.Now()\r\n    30\t\treturn &Breaker{\r\n    31\t\t\tstate:          Closed,\r\n    32\t\t\tstateChangedAt: now,\r\n    33\t\t\topenedAt:       now,\r\n    34\t\t\ttimeout:        timeout,\r\n    35\t\t}\r\n    36\t}\r\n    37\t\r\n    38\t// State returns the current state.\r\n    39\tfunc (b *Breaker) State() State {\r\n    40\t\tb.mu.Lock()\r\n    41\t\tdefer b.mu.Unlock()\r\n    42\t\treturn b.state\r\n    43\t}\r\n    44\t\r\n    45\t// IsClosed returns true if the breaker is closed.\r\n    46\tfunc (b *Breaker) IsClosed() bool {\r\n    47\t\treturn b.State() == Closed\r\n    48\t}\r\n    49\t\r\n    50\t// IsOpen returns true if the breaker is open.\r\n    51\tfunc (b *Breaker) IsOpen() bool {\r\n    52\t\t"]
[12974.363628, "o", "return b.State() == Open\r\n    53\t}\r\n    54\t\r\n    55\t// IsHalfOpen returns true if the breaker is half-open.\r\n    56\tfunc (b *Breaker) IsHalfOpen() bool {\r\n    57\t\treturn b.State() == HalfOpen\r\n    58\t}\r\n    59\t\r\n    60\t// Open forces the breaker open and restarts the timeout clock.\r\n    61\tfunc (b *Breaker) Open() {\r\n    62\t\tb.mu.Lock()\r\n    63\t\tdefer b.mu.Unlock()\r\n    64\t\tnow := time.Now()\r\n    65\t\tb.state = Open\r\n    66\t\tb.stateChangedAt = now\r\n    67"]
