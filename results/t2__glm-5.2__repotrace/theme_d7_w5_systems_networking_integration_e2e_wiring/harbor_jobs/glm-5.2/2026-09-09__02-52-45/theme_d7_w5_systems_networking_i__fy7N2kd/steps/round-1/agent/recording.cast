[5701.317819, "i", "sed -n '1,260p' internal/state/ratelimit.go\n"]
[5701.318285, "o", "sed -n '1,260p' internal/state/ratelimit.go\r\n\u001b[?2004l\r"]
[5701.321439, "o", "package state\r\n\r\nimport (\r\n\t\"sync\"\r\n"]
[5701.321565, "o", "\t\"time\"\r\n)\r\n\r\ntype rateLimiter struct {\r\n\tmu          sync.Mutex\r\n\trps         float64\r\n\tburst       float64\r\n\ttokens      float64\r\n\tlast        time.Time\r\n\tqueueMax    int\r\n\tqueueDepth  int\r\n\ttimeout     time.Duration\r\n\trateLimited uint64\r\n\tqueued      uint64\r\n\ttimeouts    uint64\r\n}\r\n\r\nfunc newRateLimiter(rps, burst int, queueDepth int, timeoutMs int) *rateLimiter {\r\n\treturn &rateLimiter{\r\n\t\trps:      float64(rps),\r\n\t\tburst:    float64(burst),\r\n\t\ttokens:   float64(burst),\r\n\t\tlast:     time.Now(),\r\n"]
[5701.321676, "o", "\t\tqueueMax: queueDepth,\r\n\t\ttimeout:  time.Duration(timeoutMs) * time.Millisecond,\r\n\t}\r\n}\r\n\r\nfunc (rl *rateLimiter) update(rps, burst int, queueDepth int, timeoutMs int) {\r\n\trl.mu.Lock()\r\n"]
[5701.321804, "o", "\tdefer rl.mu.Unlock()\r\n\trl.rps = float64(rps)\r\n\trl.burst = float64(burst)\r\n\tif rl.tokens > rl.burst {\r\n\t\trl.tokens = rl.burst\r\n\t}\r\n\trl.queueMax = queueDepth\r\n\trl.timeout = time.Duration(timeoutMs) * time.Millisecond\r\n}\r\n\r\nfunc (rl *rateLimiter) refillLocked(now time.Time) {\r\n\telapsed := now.Sub(rl.last).Seconds()\r\n\tif elapsed > 0 {\r\n\t\trl.tokens += rl.rps * elapsed\r\n\t\tif rl.burst > 0 && rl.tokens > rl.burst {\r\n\t\t\trl.tokens = rl.burst\r\n\t\t}\r\n\t\trl.last = now\r\n\t}\r\n}\r\n\r\nfunc (rl *rateLimiter) tryAcquireLocked(now time.Time) bool {\r\n\tif rl.rps <= 0 {\r\n\t\treturn true\r\n\t}\r\n\trl.refillLocked(now)\r\n\tif rl.tokens >= 1 {\r\n\t\trl.tokens -= 1\r\n\t\t"]
[5701.321874, "o", "return true\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc (rl *rateLimiter) acquire(now time.Time) (bool, bool) {\r\n\trl.mu.Lock()\r\n\tif rl.rps <= 0 {\r\n\t\trl.mu.Unlock()\r\n\t\treturn true, false\r\n\t}\r\n\tif rl.tryAcquireLocked(now) {\r\n"]
[5701.321935, "o", "\t\trl.mu.Unlock()\r\n\t\treturn true, false\r\n\t}\r\n\tif rl.queueMax <= 0 {\r\n\t\trl.rateLimited++\r\n\t\trl.mu.Unlock()\r\n\t\treturn false, false\r\n\t}\r\n\tif rl.queueDepth >= rl.queueMax {\r\n\t\t"]
[5701.321992, "o", "rl.rateLimited++\r\n\t\trl.mu.Unlock()\r\n\t\treturn false, false\r\n\t}\r\n\trl.queueDepth++\r\n\trl.queued++\r\n\trl.mu.Unlock()\r\n\r\n\tdeadline := now.Add(rl.timeout)\r\n\tfor {\r\n"]
[5701.322062, "o", "\t\trl.mu.Lock()\r\n\t\tvar wait time.Duration\r\n\t\tif rl.rps > 0 {\r\n\t\t\tneeded := 1.0 - rl.tokens\r\n\t\t\tif needed > 0 {\r\n\t\t\t\twait = time.Duration(needed / rl.rps * float64(time.Second))\r\n\t\t\t}\r\n\t\t}\r\n\t\trl.mu.Unlock()\r\n\r\n\t\tif wait <= 0 {\r\n\t\t\trl.mu.Lock()\r\n"]
[5701.322123, "o", "\t\t\tif rl.tryAcquireLocked(time.Now()) {\r\n\t\t\t\trl.queueDepth--\r\n\t\t\t\trl.mu.Unlock()\r\n\t\t\t\treturn true, true\r\n\t\t\t}\r\n\t\t\trl.mu.Unlock()\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[5701.322179, "o", "\r\n\t\tremaining := time.Until(deadline)\r\n\t\tif remaining <= 0 {\r\n\t\t\trl.mu.Lock()\r\n\t\t\trl.queueDepth--\r\n\t\t\trl.timeouts++\r\n"]
[5701.322239, "o", "\t\t\trl.mu.Unlock()\r\n\t\t\treturn false, true\r\n\t\t}\r\n\t\tif wait > remaining {\r\n\t\t\twait = remaining\r\n\t\t}\r\n\t\ttimer := time.NewTimer(wait)\r\n\t\tselect {\r\n"]
[5701.3223, "o", "\t\tcase <-timer.C:\r\n\t\t}\r\n\t\ttimer.Stop()\r\n\t}\r\n}\r\n\r\nfunc (rl *rateLimiter) status() (tokens float64, queueDepth int, rateLimited uint64, queued uint64, timeouts uint64, rps float64, burst float64) {\r\n\trl.mu.Lock()\r\n\tdefer rl.mu.Unlock()\r\n\trl.refillLocked(time.Now())\r\n"]
[5701.322365, "o", "\treturn rl.tokens, rl.queueDepth, rl.rateLimited, rl.queued, rl.timeouts, rl.rps, rl.burst\r\n}\r\n"]
