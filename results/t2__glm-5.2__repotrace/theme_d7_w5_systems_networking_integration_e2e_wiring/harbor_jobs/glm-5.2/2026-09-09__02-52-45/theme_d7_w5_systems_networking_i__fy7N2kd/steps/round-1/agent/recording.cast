[4304.169981, "o", "    98\tfunc selectWeighted(eps []*EndpointState) *EndpointState {\r\n    99\t\tvar best *EndpointState\r\n   100\t\tvar bestWeight int\r\n   101\t\tvar totalWeight int\r\n"]
[4304.170092, "o", "   102\t\tfor _, ep := range eps {\r\n   103\t\t\tep.mu.Lock()\r\n   104\t\t\tep.currentWeight += ep.Weight\r\n   105\t\t\ttotalWeight += ep.Weight\r\n   106\t\t\tcw := ep.currentWeight\r\n   107\t\t\tep.mu.Unlock()\r\n   108\t\t\tif best == nil || cw > bestWeight {\r\n   109\t\t\t\tbest = ep\r\n   110\t\t\t\tbestWeight = cw\r\n   111\t\t\t}\r\n   112\t\t}\r\n"]
[4304.170174, "o", "   113\t\tif best != nil {\r\n   114\t\t\tbest.mu.Lock()\r\n   115\t\t\tbest.currentWeight -= totalWeight\r\n   116\t\t\tbest.mu.Unlock()\r\n"]
[4304.170244, "o", "   117\t\t}\r\n   118\t\treturn best\r\n   119\t}\r\n   120\t\r\n   121\tfunc selectWeightedCandidate(eps []*EndpointState) *EndpointState {\r\n   122\t\tvar best *EndpointState\r\n   123\t\tvar bestWeight int\r\n   124\t\tfor _, ep := range eps {\r\n"]
[4304.170303, "o", "   125\t\t\tep.mu.Lock()\r\n   126\t\t\tcw := ep.currentWeight + ep.Weight\r\n   127\t\t\tep.mu.Unlock()\r\n   128\t\t\tif best == nil || cw > bestWeight {\r\n   129\t\t\t\tbest = ep\r\n   130\t\t\t\tbestWeight = cw\r\n   131\t\t\t}\r\n   132\t\t}\r\n   133\t\treturn best\r\n   134\t}\r\n"]
[4304.170363, "o", "   135\t\r\n   136\tfunc selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\r\n   137\t\tsort.SliceStable(eps, func(i, j int) bool {\r\n   138\t\t\tai := eps[i].Active()\r\n   139\t\t\taj := eps[j].Active()\r\n   140\t\t\tif ai != aj {\r\n   141\t\t\t\treturn ai < aj\r\n"]
[4304.170444, "o", "   142\t\t\t}\r\n   143\t\t\treturn eps[i].Address < eps[j].Address\r\n   144\t\t})\r\n   145\t\t"]
[4304.170503, "o", "return eps[0]\r\n   146\t}\r\n   147\t\r\n   148\t// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\r\n   149\tfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\r\n   150\t\tss := s.GetService(service)\r\n   151\t\tif ss == nil {\r\n   152\t\t\treturn SelectResult{}, errNotFound(\"service not found\")\r\n   153\t\t}\r\n"]
[4304.170572, "o", "   154\t\tss.mu.Lock()\r\n   155\t\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n   156\t\tmode := ss.RoutingMode\r\n   157\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n   158\t\tcopy(endpoints, ss.Endpoints)\r\n   159\t\tss.mu.Unlock()\r\n   160\t\r\n"]
