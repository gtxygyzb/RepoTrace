[9670.367598, "o", "func (rl *rateLimiter) acquire(now time.Time) (allowed bool, queued bool, queueWaitMs int64, timedOut bool) {\r\n\trl.mu.Lock()\r\n\tif rl.rps <= 0 {\r\n\t\trl.mu.Unlock()\r\n\t\treturn true, false, 0, false"]
[9670.36767, "o", "\r\n\t}\r\n\tif rl.tryAcquireLocked(now) {\r\n\t\trl.mu.Unlock()\r\n\t\treturn true, false, 0, false\r\n\t}\r\n\tif rl.queueMax <= 0 {\r\n\t\trl.rateLimited++\r\n\t\trl.mu.Unlock()\r\n\t\treturn false, false, 0, false\r\n"]
[9670.367739, "o", "\t}\r\n\tif rl.queueDepth >= rl.queueMax {\r\n\t\trl.rateLimited++\r\n\t\trl.mu.Unlock()\r\n\t\treturn false, false, 0, false\r\n\t}\r\n\trl.queueDepth++\r\n"]
[9670.367773, "o", "\trl.queued++\r\n\trl.mu.Unlock()\r\n\r\n\tdeadline := now.Add(rl.timeout)\r\n\tfor {\r\n\t\trl.mu.Lock()\r\n\t\tvar wait time.Duration\r\n\t\tif rl.rps > 0 {\r\n\t\t\tneeded := 1.0 - rl.tokens\r\n\t\t\tif needed > 0 {\r\n\t\t\t\twait = time.Duration(needed / rl.rps * float64(time.Second))\r\n\t\t\t}\r\n"]
[9670.367859, "o", "\t\t}\r\n\t\trl.mu.Unlock()\r\n\r\n\t\tif wait <= 0 {\r\n\t\t\trl.mu.Lock()\r\n\t\t\tif rl.tryAcquireLocked(time.Now()) {\r\n"]
[9670.367928, "o", "\t\t\t\trl.queueDepth--\r\n\t\t\t\trl.mu.Unlock()\r\n\t\t\t\treturn true, true, time.Since(queueStart).Milliseconds(), false\r\n\t\t\t}\r\n\t\t\trl.mu.Unlock()\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n"]
[9670.367995, "o", "\t\tremaining := time.Until(deadline)\r\n\t\tif remaining <= 0 {\r\n\t\t\trl.mu.Lock()\r\n\t\t\trl.queueDepth--\r\n\t\t\trl.timeouts++\r\n\t\t\trl.rateLimited++\r\n\t\t\trl.mu.Unlock()\r\n\t\t\treturn false, true, time.Since(queueStart).Milliseconds(), true\r\n\t\t}\r\n\t\tif wait > remaining {\r\n\t\t\twait = remaining\r\n\t\t}\r\n\t\ttimer := time.NewTimer(wait)\r\n\t\t"]
[9670.368061, "o", "select {\r\n\t\tcase <-timer.C:\r\n\t\t}\r\n\t\ttimer.Stop()\r\n\t}\r\n}\r\n\r\nfunc (rl *rateLimiter) status() (tokens float64, queueDepth int, rateLimited uint64, queued uint64, timeouts uint64, rps float64, burst float64) {\r\n"]
[9670.368598, "o", "\u001b[?2004h"]
