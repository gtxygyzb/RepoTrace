[10746.681732, "o", "sed -n '170,235p' internal/router/router.go\r\n"]
[10746.681836, "o", "\u001b[?2004l\r"]
[10746.684965, "o", "\t\t\t<-done\r\n\t\t}\r\n\t} else {\r\n"]
[10746.685056, "o", "\t\tsl.wg.Wait()\r\n\t}\r\n}\r\n\r\n"]
[10746.685131, "o", "func (r *Router) handleConn(service string, client net.Conn) {\r\n\tstart := time.Now()\r\n\tclientAddr := \"\"\r\n\tif addr := client.RemoteAddr(); addr != nil {\r\n\t\tclientAddr = addr.String()\r\n\t}\r\n\r\n\tvar endpoint string\r\n\tvar bytesIn, bytesOut int64\r\n\tvar result string\r\n\tvar retryCount int\r\n\tvar queueWaitMs *int64\r\n\tdefer func() {\r\n\t\tif result == \"\" {\r\n\t\t\tresult = \"success\"\r\n\t\t}\r\n\t\tif r.accessLog != nil {\r\n\t\t\tr.accessLog.Log(accesslog.Entry{\r\n"]
[10746.685214, "o", "\t\t\t\tService:     service,\r\n\t\t\t\tClient:      clientAddr,\r\n\t\t\t\tEndpoint:    endpoint,\r\n\t\t\t\tBytesIn:     bytesIn,\r\n\t\t\t\tBytesOut:    bytesOut,\r\n\t\t\t\tDurationMs:  time.Since(start).Milliseconds(),\r\n\t\t\t\tResult:      result,\r\n\t\t\t\tRetried:     retryCount > 0,\r\n\t\t\t\tRetryCount:  retryCount,\r\n\t\t\t\tQueueWaitMs: queueWaitMs,\r\n\t\t\t})\r\n\t\t}\r\n\t}()\r\n\r\n"]
[10746.685287, "o", "\tss := r.state.GetService(service)\r\n\tif ss == nil {\r\n\t\tresult = \"rejected_no_endpoint\"\r\n\t\tclient.Close()\r\n\t\treturn\r\n\t}\r\n\r\n\tallowed, queued, waitMs, _ := ss.AcquireRateLimitToken()\r\n\tif !allowed {\r\n"]
[10746.685355, "o", "\t\tresult = \"rejected_rate_limit\"\r\n\t\tqueueWaitMs = &waitMs\r\n\t\tclient.Close()\r\n\t"]
[10746.685448, "o", "\treturn\r\n\t}\r\n\tif queued {\r\n\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n\t\t\tcand.Stats.RecordQueued()\r\n\t\t}\r\n\t}\r\n\r\n\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\r\n"]
[10746.685518, "o", "\tvar lastEndpoint *state.EndpointState\r\n\tfor attempt := 0; ; attempt++ {\r\n\t\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\r\n\t\tif err != nil {\r\n\t\t\tresult = \"rejected_no_endpoint\"\r\n\t\t\tendpoint = \"\"\r\n"]
[10746.686029, "o", "\u001b[?2004h"]
