[5757.092455, "o", "     1\tpackage state\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"sort\"\r\n     5\t\t\"time\"\r\n     6\t)\r\n     7\t"]
[5757.092571, "o", "\r\n     8\t// SelectResult contains selected endpoint and whether it is a half-open probe.\r\n     9\ttype SelectResult struct {\r\n    10\t\tEndpoint *EndpointState\r\n    11\t\tProbe    bool\r\n    12\t\tMaxConns int\r\n    13\t}\r\n    14\t\r\n    15\t// SelectEndpoint chooses an endpoint for the next connection.\r\n    16\tfunc (s *State) SelectEndpoint(service string) (SelectResult, error) {\r\n    17\t\tss := s.GetService(service)\r\n    18\t\tif ss == nil {\r\n    19\t\t\treturn SelectResult{}, errNotFound(\"service not found\")\r\n    20\t\t}\r\n    21\t\tss.mu.Lock()\r\n    22\t\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n"]
[5757.092648, "o", "    23\t\tmode := ss.RoutingMode\r\n    24\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n    25\t\tcopy(endpoints, ss.Endpoints)\r\n    26\t\tss.mu.Unlock()\r\n    27\t\r\n    28\t\tnow := time.Now()\r\n    29\t\t_ = now\r\n    30\t\r\n    31\t\tvar regular []*EndpointState\r\n    32\t\tfor _, ep := range endpoints {\r\n    33\t\t\tep.mu.Lock()\r\n"]
[5757.092763, "o", "    34\t\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n    35\t\t\tep.mu.Unlock()\r\n    36\t\t\tif eligible {\r\n    37\t\t\t\tregular = append(regular, ep)\r\n    38\t\t\t}\r\n    39\t\t}\r\n    40\t\r\n    41\t\tif len(regular) > 0 {\r\n    42\t\t\tif mode == \"least-connections\" {\r\n    43\t\t\t\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\r\n    44\t\t\t}\r\n    45\t\t\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\r\n    46\t\t}\r\n    47\t\r\n    48\t\tfor _, ep := range endpoints {\r\n    49\t"]
[5757.092896, "o", "\t\tep.mu.Lock()\r\n    50\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n    51\t\t\tep.mu.Unlock()\r\n    52\t\t\tif halfOpen && ep.Circuit.AcquireProbe() {\r\n    53\t\t\t\treturn SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil\r\n    54\t\t\t}\r\n    55\t\t}\r\n    56\t\treturn SelectResult{}, errNotFound(\"no eligible endpoints\")\r\n    57\t}\r\n    58\t\r\n    59\t// SelectCandidate returns the endpoint that would be selected ignoring connection limits.\r\n    60\t// Used to account rejected_connections when all eligible endpoints are at capacity.\r\n    61\tfunc (s *State) SelectCandidate(service string) (*EndpointState, error) {\r\n    62\t\tss := s.GetService(service)\r\n    63\t\tif ss == nil {\r\n    64\t\t\treturn nil, errNotFound(\"service not found\")\r\n    65\t\t}\r\n    66\t\tss.mu.Lock()\r\n    67\t\tmode := ss.RoutingMode\r\n"]
[5757.092957, "o", "    68\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n    69\t\tcopy(endpoints, ss.Endpoints)\r\n    70\t\tss.mu.Unlock()\r\n    71\t\r\n    72\t\tvar regular []*EndpointState\r\n    73\t\tfor _, ep := range endpoints {\r\n    74\t\t\tep.mu.Lock()\r\n    75\t\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining\r\n    76\t\t\tep.mu.Unlock()\r\n"]
[5757.093015, "o", "    77\t\t\tif eligible {\r\n    78\t\t\t\tregular = append(regular, ep)\r\n"]
[5757.09309, "o", "    79\t\t\t}\r\n    80\t\t}\r\n    81\t\tif len(regular) == 0 {\r\n    82\t\t\tfor _, ep := range endpoints {\r\n    83\t\t\t\tep.mu.Lock()\r\n    84\t\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining\r\n    85\t\t\t\tep.mu.Unlock()\r\n    86\t\t\t\tif halfOpen {\r\n    87\t\t\t\t\treturn ep, nil\r\n    88\t\t\t\t}\r\n    89\t\t\t}\r\n    90\t\t\treturn nil, errNotFound(\"no eligible endpoints\")\r\n    91\t\t}\r\n    92\t\tif mode == \"least-connections\" {\r\n    93\t\t\treturn selectLeastConnections(regular, 1<<30), nil\r\n    94\t\t}\r\n    95\t\treturn selectWeightedCandidate(regular), nil\r\n    96\t}\r\n    97\t\r\n    98\tfunc selectWeighted(eps []*EndpointState) *EndpointState {\r\n    99\t\tvar best *EndpointState\r\n   100\t\tvar bestWeight int\r\n   101\t\tvar totalWeight int\r\n"]
[5757.093153, "o", "   102\t\tfor _, ep := range eps {\r\n   103\t\t\tep.mu.Lock()\r\n   104\t\t\tep.currentWeight += ep.Weight\r\n   105\t\t\ttotalWeight += ep.Weight\r\n   106\t\t\tcw := ep.currentWeight\r\n   107"]
[5757.09322, "o", "\t\t\tep.mu.Unlock()\r\n   108\t\t\tif best == nil || cw > bestWeight {\r\n   109\t\t\t\tbest = ep\r\n   110\t\t\t\tbestWeight = cw\r\n   111\t\t\t}\r\n   112\t\t}\r\n   113\t\tif best != nil {\r\n   114\t\t\tbest.mu.Lock()\r\n   115\t\t\tbest.currentWeight -= totalWeight\r\n   116\t\t\tbest.mu.Unlock()\r\n   117\t\t}\r\n   118\t\treturn best\r\n   119\t}\r\n"]
[5757.093275, "o", "   120\t\r\n   121\tfunc selectWeightedCandidate(eps []*EndpointState) *EndpointState {\r\n   122\t\tvar best *EndpointState\r\n   123\t\tvar bestWeight int\r\n   124\t\tfor _, ep := range eps {\r\n   125\t\t\tep.mu.Lock()\r\n   126\t\t\tcw := ep.currentWeight + ep.Weight\r\n"]
[5757.093336, "o", "   127\t\t\tep.mu.Unlock()\r\n   128\t\t\tif best == nil || cw > bestWeight {\r\n   129\t\t\t\tbest = ep\r\n   130\t\t\t\tbestWeight = cw\r\n   131\t\t\t}\r\n   132\t\t}\r\n   133\t\treturn best\r\n   134\t}\r\n   135\t\r\n   136\tfunc selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\r\n   137\t\tsort.SliceStable(eps, func(i, j int) bool {\r\n"]
[5757.093435, "o", "   138\t\t\tai := eps[i].Active()\r\n   139\t\t\taj := eps[j].Active()\r\n   140\t\t\tif ai != aj {\r\n   141\t\t\t\treturn ai < aj\r\n   142\t\t"]
[5757.093496, "o", "\t}\r\n   143\t\t\t// Tie-break by weight (higher weight first), then lexicographic address.\r\n   144\t\t\twi := eps[i].Weight\r\n   145\t\t\twj := eps[j].Weight\r\n   146\t\t\tif wi != wj {\r\n   147\t\t\t\treturn wi > wj\r\n   148\t\t\t}\r\n   149\t\t\treturn eps[i].Address < eps[j].Address\r\n   150\t\t})\r\n   151\t\treturn eps[0]\r\n   152\t}\r\n   153\t\r\n   154\t// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\r\n"]
[5757.093557, "o", "   155\tfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\r\n   156\t\tss := s.GetService(service)\r\n   157\t\tif ss == nil {\r\n   158\t\t\treturn SelectResult{}, errNotFound(\"service not found\")\r\n   159\t\t}\r\n   160\t\tss.mu.Lock()\r\n   161\t\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n   162"]
[5757.093616, "o", "\t\tmode := ss.RoutingMode\r\n   163\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n   164\t\tcopy(endpoints, ss.Endpoints)\r\n   165\t\tss.mu.Unlock()\r\n   166\t\r\n   167\t\tvar regular []*EndpointState\r\n   168\t\tfor _, ep := range endpoints {\r\n   169\t\t\tif exclude != nil && ep == exclude {\r\n   170\t\t"]
[5757.093677, "o", "\t\tcontinue\r\n   171\t\t\t}\r\n   172\t\t\tep.mu.Lock()\r\n   173\t\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n   174\t\t\tep.mu.Unlock()\r\n   175\t\t\tif eligible {\r\n   176\t\t\t\tregular = append(regular, ep)\r\n   177\t\t\t}\r\n   178\t\t}\r\n   179\t\r\n   180\t\tif len(regular) > 0 {\r\n"]
[5757.093731, "o", "   181\t\t\tif mode == \"least-connections\" {\r\n   182\t\t\t\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\r\n   183\t\t\t}\r\n   184\t\t\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\r\n   185\t\t}\r\n   186\t\r\n   187\t\t"]
[5757.093793, "o", "for _, ep := range endpoints {\r\n   188\t\t\tif exclude != nil && ep == exclude {\r\n   189\t\t\t\tcontinue\r\n   190\t\t\t}\r\n   191\t\t\tep.mu.Lock()\r\n"]
[5757.093851, "o", "   192\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n   193\t\t\tep.mu.Unlock()\r\n   194\t\t\tif halfOpen && ep.Circuit.AcquireProbe() {\r\n   195\t\t\t\treturn SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil\r\n   196\t\t\t}\r\n   197\t\t}\r\n   198\t\treturn SelectResult{}, errNotFound(\"no eligible endpoints\")\r\n   199\t}\r\n"]
