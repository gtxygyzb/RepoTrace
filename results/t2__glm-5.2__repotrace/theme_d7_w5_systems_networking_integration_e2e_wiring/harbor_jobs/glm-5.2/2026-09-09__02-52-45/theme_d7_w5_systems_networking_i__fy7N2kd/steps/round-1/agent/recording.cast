[12267.964039, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/stats/stats.go')\ns = p.read_text()\nif 'DependencyRejections: c.dependencyRejections' not in s:\n    s = s.replace('                IdleTimeouts:        c.idleTimeouts,\\n        }', '                IdleTimeouts:        c.idleTimeouts,\\n                DependencyRejections: c.dependencyRejections,\\n        }')\nif 'DependencyRejections int     `json:\"dependency_rejections\"`' not in s:\n    s = s.replace('        IdleTimeouts        int     `json:\"idle_timeouts\"`\\n}', '        IdleTimeouts        int     `json:\"idle_timeouts\"`\\n        DependencyRejections int     `json:\"dependency_rejections\"`\\n}')\np.write_text(s)\nPY\ngofmt -w internal/stats/stats.go\nsed -n '157,190p' internal/stats/stats.go\ngo build ./...\ngo test ./...\n"]
