[2109.36099, "o", "   120\t\treturn out\r\n   121\t}\r\n   122\t\r\n   123\ttype CircuitView struct {\r\n   124\t\tAddress             string `json:\"address\"`\r\n   125\t\tCircuitState        string `json:\"circuit_state\"`\r\n   126\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n   127\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n"]
