[9502.190956, "o", "     1\tpackage router\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"io\"\r\n     5\t\t\"log\"\r\n     6\t\t\"net\"\r\n"]
[9502.191078, "o", "     7\t\t\"sync\"\r\n     8\t\t\"sync/atomic\"\r\n     9\t\t\"time\"\r\n    10\t\r\n    11\t\t\"meshrouter/internal/accesslog\"\r\n    12\t\t\"meshrouter/internal/state\"\r\n    13\t)\r\n    14\t\r\n"]
[9502.191157, "o", "    15\ttype serviceListener struct {\r\n    16\t\tservice  string\r\n    17\t\tport     int\r\n    18\t\tlistener net.Listener\r\n    19\t\tstop     chan struct{}\r\n    20\t\twg       sync.WaitGroup\r\n    21\t\tdone     chan struct{}\r\n    22\t}\r\n    23\t\r\n    24\ttype Router struct {\r\n    25\t\tstate     *state.State\r\n    26\t\taccessLog *accesslog.Logger\r\n    27\t\tmu        sync.Mutex\r\n    28\t\tlisteners map[string]*serviceListener\r\n    29\t}\r\n    30\t\r\n    31\tfunc NewRouter(s *state.State) *Router {\r\n    32\t\treturn &Router{\r\n    33\t\t\tstate:     s,\r\n"]
[9502.191233, "o", "    34\t\t\tlisteners: make(map[string]*serviceListener),\r\n    35\t\t}\r\n    36\t}\r\n    37\t\r\n"]
[9502.191265, "o", "    38\tfunc (r *Router) SetAccessLogger(l *accesslog.Logger) {\r\n    39\t\tr.accessLog = l\r\n    40\t}\r\n    41\t\r\n    42\tfunc (r *Router) Start() {\r\n    43\t\tfor _, ss := range r.state.Services() {\r\n    44\t\t\tif !ss.IsStopping() {\r\n    45\t\t\t\tr.startService(ss)\r\n    46\t\t\t}\r\n    47\t\t}\r\n    48\t}\r\n    49\t"]
[9502.191355, "o", "\r\n    50\tfunc (r *Router) Reload() {\r\n    51\t\tservices := r.state.Services()\r\n    52\t\tseen := make(map[string]bool)\r\n    53\t\tfor _, ss := range services {\r\n    54\t\t\tseen[ss.Name] = true\r\n    55\t\t\tr.mu.Lock()\r\n    56\t\t\tsl, ok := r.listeners[ss.Name]\r\n    57\t\t\tr.mu.Unlock()\r\n    58\t\t\tif !ok {\r\n    59\t\t\t\tif !ss.IsStopping() {\r\n    60\t\t\t\t\tr.startService(ss)\r\n"]
[9502.191431, "o", "    61\t\t\t\t}\r\n    62\t\t\t\tcontinue\r\n"]
[9502.191498, "o", "    63\t\t\t}\r\n    64\t\t\tif sl.port != ss.ListenPort {\r\n    65\t\t\t\tr.stopService(ss.Name, true)\r\n    66\t\t\t\tr.startService(ss)\r\n    67\t\t\t}\r\n    68\t\t}\r\n    69\t\tr.mu.Lock()\r\n    70\t\tfor name := range r.listeners {\r\n    71\t\t\tif !seen[name] {\r\n    72\t\t\t\tr.mu.Unlock()\r\n"]
[9502.191571, "o", "    73\t\t\t\tr.stopService(name, true)\r\n    74\t\t\t\tr.mu.Lock()\r\n    75\t\t\t}\r\n    76\t\t}\r\n    77\t\tr.mu.Unlock()\r\n    78\t}\r\n    79\t\r\n    80\tfunc (r *Router) startService(ss *state.ServiceState) {\r\n    81\t\taddr := \":\" + intToStr(ss.ListenPort)\r\n    82\t\tln, err := net.Listen(\"tcp\", addr)\r\n    83\t\tif err != nil {\r\n    84\t\t\tlog.Printf(\"router: listen %s on %s failed: %v\", ss.Name, addr, err)\r\n    85\t\t\treturn\r\n    86\t\t}\r\n    87\t\tsl := &serviceListener{\r\n"]
[9502.191642, "o", "    88\t\t\tservice:  ss.Name,\r\n    89\t\t\tport:     ss.ListenPort,\r\n    90\t\t\tlistener: ln,\r\n    91\t\t\tstop:     make(chan struct{}),\r\n    92\t\t\tdone:     make(chan struct{}),\r\n    93\t\t}\r\n    94\t\tr.mu.Lock()\r\n    95\t\tr.listeners[ss.Name] = sl\r\n    96\t\tr.mu.Unlock()\r\n    97\t\tgo sl.acceptLoop(r)\r\n"]
[9502.191723, "o", "    98\t}\r\n    99\t\r\n   100\tfunc (r *Router) stopService(name string, drain bool) {\r\n   101\t\tr.mu.Lock()\r\n   102\t\tsl, ok := r.listeners[name]\r\n   103\t\tif ok {\r\n   104\t\t\tdelete(r.listeners, name)\r\n   105\t\t}\r\n   106\t\tr.mu.Unlock()\r\n   107\t\tif !ok {\r\n   108\t\t\treturn\r\n   109\t\t}\r\n   110"]
[9502.191748, "o", "\t\tsl.stopAccept(drain, r)\r\n   111\t}\r\n   112\t\r\n"]
[9502.191838, "o", "   113\tfunc (r *Router) Stop() {\r\n   114\t\tr.mu.Lock()\r\n   115\t\tlisteners := r.listeners\r\n   116\t\tr.listeners = make(map[string]*serviceListener)\r\n   117\t\tr.mu.Unlock()\r\n   118\t\tvar wg sync.WaitGroup\r\n   119\t\tfor name, sl := range listeners {\r\n   120\t\t\twg.Add(1)\r\n   121\t\t\tgo func(name string, sl *serviceListener) {\r\n   122\t\t\t\tdefer wg.Done()\r\n   123\t\t\t\tsl.stopAccept(true, r)\r\n"]
[9502.191905, "o", "   124\t\t\t}(name, sl)\r\n   125\t\t}\r\n   126\t\twg.Wait()\r\n   127\t}\r\n   128\t\r\n   129"]
[9502.19197, "o", "\tfunc (sl *serviceListener) acceptLoop(r *Router) {\r\n   130\t\tdefer close(sl.done)\r\n   131\t\tfor {\r\n   132\t\t\tconn, err := sl.listener.Accept()\r\n   133\t\t\tif err != nil {\r\n   134\t\t\t\treturn\r\n   135\t\t\t}\r\n   136\t\t\tsl.wg.Add(1)\r\n   137\t\t\tgo func(c net.Conn) {\r\n   138\t"]
[9502.192039, "o", "\t\t\tdefer sl.wg.Done()\r\n   139\t\t\t\tr.handleConn(sl.service, c)\r\n   140\t\t\t}(conn)\r\n"]
