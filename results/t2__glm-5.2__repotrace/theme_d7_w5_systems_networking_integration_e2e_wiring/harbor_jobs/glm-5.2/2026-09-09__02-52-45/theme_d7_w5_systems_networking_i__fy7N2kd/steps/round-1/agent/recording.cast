[2130.452812, "o", "     1\tpackage stats\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"sync\"\r\n     5\t\t\"time\"\r\n"]
[2130.452931, "o", "     6\t)\r\n     7\t\r\n     8\ttype entry struct {\r\n     9\t\ttimestamp time.Time\r\n    10\t\tbytesIn   int64\r\n    11\t\tbytesOut  int64\r\n    12\t\tlatency   time.Duration\r\n    13\t\terr       bool\r\n    14\t}\r\n    15\t\r\n"]
[2130.452997, "o", "    16\t// Collector keeps rolling connection statistics for one endpoint.\r\n    17\ttype Collector struct {\r\n    18\t\tmu         sync.Mutex\r\n    19\t\twindow     time.Duration\r\n    20\t\tentries    []entry\r\n    21\t\trejections []time.Time\r\n    22\t}\r\n    23\t\r\n    24\t// New creates a collector with the given window length.\r\n    25\tfunc New(window time.Duration) *Collector {\r\n    26\t\tif window <= 0 {\r\n    27\t\t\twindow = time.Minute\r\n    28\t\t}\r\n    29\t\treturn &Collector{window: window}\r\n    30\t}\r\n    31\t\r\n"]
[2130.453073, "o", "    32\t// RecordConnection records a finished connection attempt.\r\n    33\tfunc (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\r\n    34\t\tc.mu.Lock()\r\n    35\t\tdefer c.mu.Unlock()\r\n    36\t\tnow := time.Now()\r\n    37\t\tc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\r\n    38\t\tc.trim(now)\r\n    39\t}\r\n    40\t\r\n"]
