[11211.292802, "i", "sed -n '160,220p' internal/router/router.go\n"]
[11211.29328, "o", "sed -n '160,220p' internal/router/router.go\r\n\u001b[?2004l\r"]
[11211.296512, "o", "\t\t}\r\n\t\tdone := make(chan struct{})\r\n\t\tgo func() {\r\n\t\t\tsl.wg.Wait()\r\n\t\t\tclose(done)\r\n"]
[11211.296597, "o", "\t\t}()\r\n\t\tselect {\r\n\t\tcase <-done:\r\n\t\tcase <-time.After(timeout):\r\n\t\t\tr.state.CloseServiceConnections(sl.service)\r\n\t\t\t<-done\r\n\t\t}\r\n\t} else {\r\n\t\tsl.wg.Wait()\r\n\t}\r\n}\r\n\r\nfunc (r *Router) handleConn(service string, client net.Conn) {\r\n\tstart := time.Now()\r\n"]
[11211.296689, "o", "\tclientAddr := \"\"\r\n\tif addr := client.RemoteAddr(); addr != nil {\r\n\t\tclientAddr = addr.String()\r\n\t}\r\n\r\n\tvar endpoint string\r\n\tvar bytesIn, bytesOut int64\r\n\tvar result string\r\n\tvar retryCount int\r\n\tvar queueWaitMs *int64\r\n\tdefer func() {\r\n\t\tif result == \"\" {\r\n\t\t\tresult = \"success\"\r\n\t\t}\r\n\t\tif r.accessLog != nil {\r\n\t\t\tr.accessLog.Log(accesslog.Entry{\r\n\t\t\t\tService:     service,\r\n"]
[11211.296779, "o", "\t\t\t\tClient:      clientAddr,\r\n\t\t\t\tEndpoint:    endpoint,\r\n\t\t\t\tBytesIn:     bytesIn,\r\n\t\t\t\tBytesOut:    bytesOut,\r\n\t\t\t\tDurationMs:  time.Since(start).Milliseconds(),\r\n\t\t\t\tResult:      result,\r\n\t\t\t\tRetried:     retryCount > 0,\r\n\t\t\t\tRetryCount:  retryCount,\r\n\t\t\t\tQueueWaitMs: queueWaitMs,\r\n\t\t\t})\r\n\t\t}\r\n\t}()\r\n\r\n\tss := r.state.GetService(service)\r\n"]
[11211.296856, "o", "\tif ss == nil {\r\n\t\tresult = \"rejected_no_endpoint\"\r\n\t\tclient.Close()\r\n\t\treturn\r\n\t}\r\n\r\n\tallowed, queued, waitMs, _ := ss.AcquireRateLimitToken()\r\n\tif !allowed {\r\n\t\tresult = \"rejected_rate_limit\"\r\n\t\tqueueWaitMs = &waitMs\r\n\t\tclient.Close()\r\n"]
[11211.297432, "o", "\u001b[?2004h"]
