[6720.291041, "o", "   199\t\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\r\n   200\t\tvar lastEndpoint *state.EndpointState\r\n   201\t\tfor attempt := 0; ; attempt++ {\r\n   202\t\t\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\r\n   203\t\t\tif err != nil {\r\n   204\t\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n"]
[6720.291163, "o", "   205\t\t\t\t\tss := r.state.GetService(service)\r\n   206\t\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n   207\t\t\t\t\t\tcand.Stats.RecordRejection()\r\n   208\t\t\t\t\t}\r\n   209\t\t\t\t}\r\n   210\t\t\t\tclient.Close()\r\n   211\t\t\t\treturn\r\n   212\t\t\t}\r\n   213\t\t\tlastEndpoint = res.Endpoint\r\n   214\t\t\tep := res.Endpoint\r\n   215\t\r\n   216\t\t\tvar id int64\r\n   217\t\t\tif !res.Probe {\r\n   218\t\t\t\tvar ok bool\r\n"]
[6720.291242, "o", "   219\t\t\t\tid, ok = ep.TryAddConnection(client, res.MaxConns)\r\n   220\t\t\t\tif !ok {\r\n   221\t\t\t\t\tep.Stats.RecordRejection()\r\n   222\t\t\t\t\tclient.Close()\r\n   223\t\t\t\t\treturn\r\n   224\t\t\t\t}\r\n   225\t\t\t}\r\n   226\t\r\n   227\t\t\tbackend, derr := net.Dial(\"tcp\", ep.Address)\r\n   228\t\t\tif derr != nil {\r\n"]
[6720.291308, "o", "   229\t\t\t\tif id != 0 {\r\n   230\t\t\t\t\tep.RemoveConnection(id)\r\n   231\t\t\t\t}\r\n   232\t\t\t\tep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n   233\t\t\t\tif res.Probe {\r\n   234\t\t\t\t\tep.Circuit.ProbeFailure()\r\n   235\t\t\t\t} else {\r\n   236\t\t\t\t\tep.Circuit.Open()\r\n   237\t\t\t\t}\r\n   238\t\t\t\tif attempt >= maxRetries {\r\n"]
