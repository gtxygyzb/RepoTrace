[13869.531363, "o", "     1\tpackage accesslog\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n"]
[13869.531422, "o", "     5\t\t\"os\"\r\n     6\t\t\"path/filepath\"\r\n     7\t\t\"sync\"\r\n     8\t\t\"sync/atomic\"\r\n     9\t\t\"time\"\r\n    10\t)\r\n    11\t\r\n    12\t// Entry is one structured access log record.\r\n"]
[13869.531553, "o", "    13\ttype Entry struct {\r\n    14\t\tTs               string `json:\"ts\"`\r\n    15\t\tService          string `json:\"service\"`\r\n    16\t\tClient           string `json:\"client\"`\r\n    17\t\tEndpoint         string `json:\"endpoint\"`\r\n    18\t\tBytesIn          int64  `json:\"bytes_in\"`\r\n    19\t\tBytesOut         int64  `json:\"bytes_out\"`\r\n    20\t\tDurationMs       int64  `json:\"duration_ms\"`\r\n    21\t\tResult           string `json:\"result\"`\r\n    22\t\tRetried          bool   `json:\"retried\"`\r\n    23\t\tRetryCount       int    `json:\"retry_count\"`\r\n    24\t\tQueueWaitMs      *int64 `json:\"queue_wait_ms,omitempty\"`\r\n    25\t\tFailedDependency string `json:\"failed_dependency,omitempty\"`\r\n    26\t}\r\n    27\t\r\n"]
[13869.531642, "o", "    28\t// DefaultPath is the access log path required by meshrouter.\r\n    29\tconst DefaultPath = \"/app/logs/access.log\"\r\n    30\t\r\n    31\tconst maxFileSize = 1 << 20 // 1 MB\r\n    32\t\r\n    33\t// Logger writes access log entries asynchronously to a JSON-lines file.\r\n    34\ttype Logger struct {\r\n"]
[13869.531716, "o", "    35\t\tpath     string\r\n    36\t\tch       chan Entry\r\n    37\t\tstop     chan struct{}\r\n    38\t\t"]
[13869.53178, "o", "done     chan struct{}\r\n    39\t\tstopped  int32\r\n    40\t\tstopOnce sync.Once\r\n    41\t\tmu       sync.Mutex\r\n    42\t\tfile     *os.File\r\n    43\t\tsize     int64\r\n    44\t}\r\n    45\t\r\n    46\t// New creates a Logger for path and starts its writer goroutine.\r\n    47\tfunc New(path string) *Logger {\r\n"]
[13869.531846, "o", "    48\t\tif path == \"\" {\r\n    49\t\t\tpath = DefaultPath\r\n    50\t\t}\r\n    51\t\tl := &Logger{\r\n    52\t\t\tpath: path,\r\n    53\t\t\tch:   make(chan Entry, 8192),\r\n    54\t\t\tstop: make(chan struct{}),\r\n    55\t\t\tdone: make(chan struct{}),\r\n    56\t\t}\r\n"]
[13869.531914, "o", "    57\t\tgo l.run()\r\n    58\t\treturn l\r\n    59\t}\r\n    60\t\r\n    61\t// Path returns the configured log file path.\r\n    62\tfunc (l *Logger) Path() string {\r\n"]
[13869.53198, "o", "    63\t\treturn l.path\r\n    64\t}\r\n    65\t\r\n    66\t// Log queues an entry for asynchronous writing. If the buffered channel is full,\r\n    67\t// the entry is written synchronously to avoid losing it.\r\n    68\tfunc (l *Logger) Log(entry Entry) {\r\n    69\t\tif atomic.LoadInt32(&l.stopped) != 0 {\r\n    70\t\t\treturn\r\n    71\t\t}\r\n"]
[13869.532049, "o", "    72\t\tentry.Ts = time.Now().UTC().Format(time.RFC3339Nano)\r\n    73\t\tselect {\r\n    74\t\tcase l.ch <- entry:\r\n    75\t\tdefault:\r\n    76\t\t\tl.writeLine(entry)\r\n    77\t\t}\r\n    78\t}\r\n    79\t\r\n    80\t// Stop flushes all buffered entries and closes the log file.\r\n    81\tfunc (l *Logger) Stop() {\r\n"]
[13869.532144, "o", "    82\t\tl.stopOnce.Do(func() {\r\n    83\t\t\tatomic.StoreInt32(&l.stopped, 1)\r\n    84\t\t\tclose(l.stop)\r\n    85\t\t\t<-l.done\r\n    86\t\t\tl.mu.Lock()\r\n    87\t\t\tif l.file != nil {\r\n    88\t\t\t\tl.file.Close()\r\n    89\t\t\t\tl.file = nil\r\n"]
[13869.532208, "o", "    90\t\t\t}\r\n    91\t\t\tl.mu.Unlock()\r\n    92\t\t})\r\n    93\t}\r\n    94\t\r\n    95\tfunc (l *Logger) run() {\r\n    96\t\tfor {\r\n    97\t\t\tselect {\r\n    98\t\t\tcase e := <-l.ch:\r\n    99\t\t\t\tl.writeLine(e)"]
[13869.532264, "o", "\r\n   100\t\t\tcase <-l.stop:\r\n   101\t\t\t\tl.drain()\r\n   102\t\t\t\tclose(l.done)\r\n   103\t\t\t\treturn\r\n   104\t\t\t}\r\n   105\t\t}\r\n   106\t}\r\n   107\t\r\n   108\tfunc (l *Logger) drain() {\r\n"]
[13869.532326, "o", "   109\t\tfor {\r\n   110\t\t\tselect {\r\n   111\t\t\tcase e := <-l.ch:\r\n   112\t\t\t\tl.writeLine(e)\r\n   113\t\t\tdefault:\r\n   114\t\t\t\treturn\r\n   115\t\t\t}\r\n   116\t\t}\r\n   117\t}\r\n   118\t\r\n   119\tfunc (l *Logger) writeLine(e Entry) {\r\n   120\t\tb, err := json.Marshal(e)\r\n"]
[13869.532396, "o", "   121\t\tif err != nil {\r\n   122\t\t\treturn\r\n   123\t\t}\r\n   124\t\tb = append(b, '\\n')\r\n   125\t\r\n   126\t\tl.mu.Lock()\r\n   127\t\tdefer l.mu.Unlock()\r\n   128\t\r\n   129\t\tif l.file == nil {\r\n"]
[13869.532463, "o", "   130\t\t\tif err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {\r\n   131\t\t\t\treturn\r\n   132\t\t\t}\r\n   133\t\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n   134\t\t\tif err != nil {\r\n   135\t\t\t\treturn\r\n   136\t\t\t}\r\n   137\t\t\tl.file = f\r\n   138\t\t\tif info, err := f.Stat(); err == nil {\r\n   139\t\t\t\tl.size = info.Size()\r\n"]
[13869.532531, "o", "   140\t\t\t}\r\n   141\t\t}\r\n   142\t\r\n   143\t\tif l.size > 0 && l.size+int64(len(b)) > maxFileSize {\r\n   144\t\t\tl.rotateLocked()\r\n   145\t\t}\r\n   146\t\r\n   147\t\tn, err := l.file.Write(b)\r\n   148\t\tif err != nil {\r\n   149\t\t\tl.size = 0\r\n   150\t\t\tif l.file != nil {\r\n   151\t\t\t\tl.file.Close()\r\n"]
[13869.532593, "o", "   152\t\t\t\tl.file = nil\r\n   153\t\t\t}\r\n   154\t\t\treturn\r\n   155\t\t}\r\n   156\t\tl.size += int64(n)\r\n   157\t}\r\n"]
[13869.53265, "o", "   158\t\r\n   159\tfunc (l *Logger) rotateLocked() {\r\n   160\t\tif l.file != nil {\r\n   161\t\t\tl.file.Close()\r\n   162\t\t\tl.file = nil\r\n   163\t\t}\r\n   164\t\tos.Remove(l.path + \".1\")"]
[13869.532711, "o", "\r\n   165\t\tif err := os.Rename(l.path, l.path+\".1\"); err != nil {\r\n   166\t\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n   167\t\t\tif err == nil {\r\n   168\t\t\t\tl.file = f\r\n   169\t\t\t\tif info, err := f.Stat(); err == nil {\r\n   170\t\t\t\t\tl.size = info.Size()\r\n"]
[13869.532782, "o", "   171\t\t\t\t}\r\n   172\t\t\t}\r\n   173\t\t\treturn\r\n   174\t\t}\r\n   175\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n   176\t\tif err != nil {\r\n   177\t\t\tl.size = 0\r\n   178\t\t\treturn\r\n   179\t\t}\r\n   180\t\tl.file = f\r\n   181"]
[13869.532863, "o", "\t\tl.size = 0\r\n   182\t}\r\n"]
