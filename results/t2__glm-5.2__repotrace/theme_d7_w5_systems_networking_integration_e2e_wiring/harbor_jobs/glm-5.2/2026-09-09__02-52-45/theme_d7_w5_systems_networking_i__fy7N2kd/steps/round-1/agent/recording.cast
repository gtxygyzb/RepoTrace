[4131.019911, "o", "   153\tfunc (s *State) ResolveEndpoint(service string) (string, error) {\r\n   154\t\tss := s.GetService(service)\r\n   155\t\tif ss == nil {\r\n   156\t\t\treturn \"\", errNotFound(\"service not found\")\r\n   157\t\t}\r\n   158\t\tss.mu.Lock()\r\n   159\t\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n   160\t\tmode := ss.RoutingMode\r\n"]
[4131.019923, "o", "   161\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n"]
[4131.019984, "o", "   162\t\tcopy(endpoints, ss.Endpoints)\r\n   163\t\tss.mu.Unlock()\r\n   164\t\r\n   165\t\tvar regular []*EndpointState\r\n   166\t\tfor _, ep := range endpoints {\r\n   167\t\t\tif ep.IsEligible(maxConns) {\r\n   168\t\t\t\tregular = append(regular, ep)\r\n   169\t\t\t}\r\n   170\t\t}\r\n   171\t\r\n"]
[4131.019995, "o", "   172\t\tif len(regular) > 0 {\r\n   173\t"]
[4131.020056, "o", "\t\tif mode == \"least-connections\" {\r\n   174\t\t\t\tep := selectLeastConnections(regular, maxConns)\r\n   175\t\t\t\treturn ep.Address, nil\r\n   176\t\t\t}\r\n   177\t\t\tvar best *EndpointState\r\n   178\t\t\tvar bestWeight int\r\n   179\t\t\tfor _, ep := range regular {\r\n   180\t\t\t\tep.mu.Lock()\r\n   181\t\t\t\tcw := ep.currentWeight + ep.Weight"]
[4131.020067, "o", "\r\n"]
[4131.020125, "o", "   182\t\t\t\tep.mu.Unlock()\r\n   183\t\t\t\tif best == nil || cw > bestWeight {\r\n   184\t\t\t\t\tbest = ep\r\n   185\t\t\t\t\tbestWeight = cw\r\n   186\t\t\t\t}\r\n   187\t\t\t}\r\n"]
[4131.020136, "o", "   188\t\t\tif best != nil {\r\n"]
[4131.020196, "o", "   189\t\t\t\treturn best.Address, nil\r\n   190\t\t\t}\r\n   191\t\t}\r\n   192\t\r\n   193\t\tfor _, ep := range endpoints {\r\n   194\t\t\tep.mu.Lock()\r\n   195\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns && !ep.Circuit.ProbeActive()\r\n   196\t\t\tep.mu.Unlock()\r\n   197"]
[4131.020207, "o", "\t\t\tif halfOpen {\r\n"]
[4131.020266, "o", "   198\t\t\t\treturn ep.Address, nil\r\n   199\t\t\t}\r\n   200\t\t}\r\n   201\t\treturn \"\", errNotFound(\"no eligible endpoints\")\r\n   202\t}\r\n"]
