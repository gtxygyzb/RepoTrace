[2596.959102, "o", "   117\t\t\trps, err := strconv.Atoi(os.Args[3])\r\n   118\t\t\tif err != nil {\r\n   119\t\t\t\tfmt.Fprintf(os.Stderr, \"invalid rps: %v\\n\", err)\r\n   120\t\t\t\tos.Exit(1)\r\n   121\t\t\t}\r\n   122\t\t\tburst, err := strconv.Atoi(os.Args[4])\r\n   123\t\t\tif err != nil {\r\n   124\t\t\t\tfmt.Fprintf(os.Stderr, \"invalid burst: %v\\n\", err)\r\n   125\t\t\t\tos.Exit(1)\r\n   126\t\t"]
