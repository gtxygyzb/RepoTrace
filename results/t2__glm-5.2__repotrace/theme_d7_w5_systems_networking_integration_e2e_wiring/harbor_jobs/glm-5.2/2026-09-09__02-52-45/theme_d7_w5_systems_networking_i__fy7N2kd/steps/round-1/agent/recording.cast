[2516.71962, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/router/router.go')\ns = p.read_text()\nstart = s.index('func (r *Router) handleConn(service string, client net.Conn) {')\nend = s.index('func forward(client, backend net.Conn) (int64, int64) {')\nnew = r'''func (r *Router) handleConn(service string, client net.Conn) {\n\tstart := time.Now()\n\tss := r.state.GetService(service)\n\tif ss == nil {\n\t\tclient.Close()\n\t\treturn\n\t}\n\n\tallowed, queued := ss.AcquireRateLimitToken()\n\tif !allowed {\n\t\tif queued {\n\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\n\t\t\t\tcand.Stats.RecordQueueTimeout()\n\t\t\t}\n\t\t} else {\n\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\n\t\t\t\tcand.Stats.RecordRateLimited()\n\t\t\t}\n\t\t}\n\t\tclient.Close()\n\t\treturn\n\t}\n\tif queued {\n\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\n\t\t\t\tcand.Stats.RecordQueued()\n\t\t}\n\t}\n\tdefer ss.ReleaseRateLimitToken()\n\n\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\n\tvar lastEndpoint *state.EndpointStat"]
[2516.719914, "i", "e\n\tfor attempt := 0; ; attempt++ {\n\t\tres, err := r.state.SelectEndpoint(service)\n\t\tif err != nil {\n\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\n\t\t\t\tss := r.state.GetService(service)\n\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\n\t\t\t\t\tcand.Stats.RecordRejection()\n\t\t\t\t}\n\t\t\t}\n\t\t\tclient.Close()\n\t\t\treturn\n\t\t}\n\t\tif attempt > 0 && res.Endpoint == lastEndpoint {\n\t\t\t// Avoid using the same endpoint consecutively when possible.\n\t\t\talt, aerr := r.state.SelectEndpoint(service)\n\t\t\tif aerr == nil && alt.Endpoint != lastEndpoint {\n\t\t\t\tres = alt\n\t\t\t}\n\t\t}\n\t\tlastEndpoint = res.Endpoint\n\t\tep := res.Endpoint\n\n\t\tvar id int64\n\t\tif !res.Probe {\n\t\t\tvar ok bool\n\t\t\tid, ok = ep.TryAddConnection(client, res.MaxConns)\n\t\t\tif !ok {\n\t\t\t\tep.Stats.RecordRejection()\n\t\t\t\tif attempt >= maxRetries {\n\t\t\t\t\tclient.Close()\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tr.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\n\t\tbackend, derr := net.Dial(\"tcp\", ep.Address)\n\t\tif derr != nil {\n\t\t\tif id != 0 {\n"]
