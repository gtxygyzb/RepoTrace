[1044.834235, "o", "        ep.mu.Unlock()\r\n\u001b[?2004l\r"]
[1044.834289, "o", "\u001b[?2004h> "]
[1044.834543, "o", "        if best == nil || cw > bestWeight {\r\n\u001b[?2004l\r"]
[1044.834602, "o", "\u001b[?2004h> "]
[1044.834705, "o", "            best = ep\r\n\u001b[?2004l\r"]
[1044.83476, "o", "\u001b[?2004h> "]
[1044.834894, "o", "            bestWeight = cw\r\n\u001b[?2004l\r"]
[1044.834949, "o", "\u001b[?2004h> "]
[1044.835002, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1044.835067, "o", "> "]
[1044.835124, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1044.835224, "o", "    if best != nil {\r\n\u001b[?2004l\r"]
[1044.835278, "o", "\u001b[?2004h> "]
[1044.835457, "o", "        best.mu.Lock()\r\n\u001b[?2004l\r"]
[1044.835514, "o", "\u001b[?2004h> "]
[1044.835659, "o", "        best.currentWeight -= totalWeight\r\n\u001b[?2004l\r"]
[1044.835716, "o", "\u001b[?2004h> "]
[1044.835853, "o", "        best.mu.Unlock()\r\n\u001b[?2004l\r"]
[1044.835908, "o", "\u001b[?2004h>     }"]
[1044.835968, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1044.836052, "o", "    return best\r\n\u001b[?2004l\r"]
[1044.836112, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1044.836171, "o", "\u001b[?2004h> "]
[1044.836418, "o", "func selectWeightedCandidate(eps []*EndpointState) *EndpointState {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1044.836476, "o", "> "]
[1044.836538, "o", "    var best *EndpointState\r\n\u001b[?2004l\r"]
[1044.836594, "o", "\u001b[?2004h> "]
[1044.836656, "o", "    var bestWeight int\r\n\u001b[?2004l\r"]
[1044.836711, "o", "\u001b[?2004h> "]
[1044.836789, "o", "    for _, ep := range eps {\r\n\u001b[?2004l\r"]
[1044.836843, "o", "\u001b[?2004h> "]
[1044.836905, "o", "        ep.mu.Lock()\r\n\u001b[?2004l\r"]
[1044.836959, "o", "\u001b[?2004h> "]
[1044.837085, "o", "        cw := ep.currentWeight + ep.Weight\r\n\u001b[?2004l\r"]
[1044.837138, "o", "\u001b[?2004h> "]
[1044.837202, "o", "        ep.mu.Unlock()\r\n\u001b[?2004l\r-\u001b[?2004h"]
[1044.837256, "o", "> "]
[1044.837415, "o", "        if best == nil || cw > bestWeight {\r\n\u001b[?2004l\r"]
[1044.837481, "o", "\u001b[?2004h> "]
[1044.837536, "o", "            best = ep\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1044.837634, "o", "            bestWeight = cw\r\n\u001b[?2004l\r\u001b[?2004h"]
[1044.837689, "o", ">         }\r\n\u001b[?2004l\r"]
[1044.837747, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1044.837812, "o", "\u001b[?2004h> "]
[1044.837872, "o", "    return best\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1044.837925, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1044.83822, "o", "func selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\r\n\u001b[?2004l\r"]
[1044.83828, "o", "\u001b[?2004h> "]
[1044.83843, "o", "    sort.SliceStable(eps, func(i, j int) bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1044.838499, "o", "> "]
[1044.838566, "o", "        ai := eps[i].Active()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1044.838622, "o", "> "]
[1044.838698, "o", "        aj := eps[j].Active()\r\n\u001b[?2004l\r"]
[1044.838753, "o", "\u001b[?2004h> "]
[1044.838821, "o", "        if ai != aj {\r\n\u001b[?2004l\rl\u001b[?2004h"]
[1044.838876, "o", "> "]
[1044.838945, "o", "            return ai < aj\r\n\u001b[?2004l\r"]
[1044.839004, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1044.839068, "o", "\u001b[?2004h> "]
[1044.839199, "o", "        return eps[i].Address < eps[j].Address\r\n\u001b[?2004l\r"]
[1044.839258, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r \u001b[?2004h"]
[1044.839341, "o", "> "]
[1044.839414, "o", "    return eps[0]\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1044.839486, "o", "EOF\r\n\u001b[?2004l\r"]
