[11938.243979, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[11938.244139, "o", "\u001b[?2004h> "]
[11938.244355, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h"]
[11938.244384, "o", "> "]
[11938.244668, "o", "p = Path('internal/config/config.go')\r\n\u001b[?2004l\r"]
[11938.244745, "o", "\u001b[?2004h> "]
[11938.244858, "o", "s = p.read_text()\r\n\u001b[?2004l\r"]
[11938.244989, "o", "\u001b[?2004h> "]
[11938.24513, "o", "if 'if s.DependsOn == nil' not in s:\r\n\u001b[?2004l\r"]
[11938.245203, "o", "\u001b[?2004h> "]
[11938.246452, "o", "    s = s.replace('        }\\n        return &cfg, nil\\n}', '                if s.DependsOn == nil {\\n                        s.DependsOn = []string{}\\n                }\\n        }\\n        return &cfg, nil\\n}', 1)\r\n\u001b[?2004l\r"]
[11938.246524, "o", "\u001b[?2004h> "]
[11938.2469, "o", "if 'cfg.Services = removeDependencyCycles(cfg.Services)' not in s:\r\n\u001b[?2004l\r"]
[11938.246982, "o", "\u001b[?2004h> "]
[11938.247782, "o", "    s = s.replace('        return &cfg, nil\\n}', '        cfg.Services = removeDependencyCycles(cfg.Services)\\n        return &cfg, nil\\n}', 1)\r\n\u001b[?2004l\r"]
[11938.247853, "o", "\u001b[?2004h> "]
[11938.247941, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[11938.247994, "o", "\u001b[?2004h> "]
[11938.248052, "o", "PY\r\n\u001b[?2004l\r"]
