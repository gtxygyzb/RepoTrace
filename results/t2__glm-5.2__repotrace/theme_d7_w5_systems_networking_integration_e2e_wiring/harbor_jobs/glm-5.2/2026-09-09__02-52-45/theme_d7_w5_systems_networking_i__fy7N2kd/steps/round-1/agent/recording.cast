[2109.360297, "o", "    25\tfunc (s *State) ServiceView(name string) (ServiceView, bool) {\r\n    26\t\tss := s.GetService(name)\r\n    27\t\tif ss == nil {\r\n    28\t\t\treturn ServiceView{}, false\r\n    29\t\t}\r\n    30\t\treturn ss.View(), true\r\n    31\t}\r\n    32\t\r\n    33\tfunc (s *State) ServicesView() []ServiceView {\r\n    34\t\tservices := s.Services()\r\n"]
