[1058.190295, "i", "grep -n \"newEndpointState\" -A2 -B2 internal/state/state.go\npython3 - <<'PY'\np='internal/state/state.go'\ns=open(p).read()\ns=s.replace('ep = newEndpointState(cep, stats.New(time.Duration(global.StatsWindowSec)*time.Second))', 'ep = newEndpointState(cep, global)')\nopen(p,'w').write(s)\nPY\ngrep -n \"newEndpointState\" -A2 -B2 internal/state/state.go\ngofmt -w internal/state/state.go\ngo build ./...\n"]
