[1189.609428, "i", "sed -n '1,80p' cmd/meshctl/main.go\ngrep -n \"case \\\"status\\\"\\|case \\\"reload\\\"\\|unknown command\" cmd/meshctl/main.go\n"]
[1189.609717, "o", "sed -n '1,80p' cmd/meshctl/main.go\r\n\u001b[?2004l\r"]
[1189.612906, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[1189.613087, "o", "\t\"net\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n"]
[1189.613136, "o", ")\r\n\r\ntype request struct {\r\n\tCmd  string          `json:\"cmd\"`\r\n\tArgs json.RawMessage `json:\"args\"`\r\n}\r\n\r\ntype response struct {\r\n\tStatus string          `json:\"status\"`\r\n\tData   json.RawMessage `json:\"data\"`\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl <command> [args]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\tcmd := os.Args[1]\r\n\targs := map[string]interface{}{}\r\n\tswitch cmd {\r\n\tcase \"status\":\r\n\tcase \"stats\":\r\n\t\tif len(os.Args) < 3 {\r\n"]
[1189.613282, "o", "\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"set-weight\":\r\n\t\tif len(os.Args) < 5 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tw, err := strconv.Atoi(os.Args[4])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid weight: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\targs[\"name\"] = os.Args[2]"]
[1189.61338, "o", "\r\n\t\targs[\"address\"] = os.Args[3]\r\n\t\targs[\"weight\"] = w\r\n\tcase \"drain\":"]
[1189.613433, "o", "\r\n\t\tif len(os.Args) < 4 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\targs[\"address\"] = os.Args[3]\r\n\tcase \"health-log\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\r\n\t\t\tos.Exit(1)\r\n"]
[1189.613461, "o", "\t\t}\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\tn := 20\r\n"]
[1189.613631, "o", "\t\tfor _, a := range os.Args[3:] {\r\n\t\t\tif strings.HasPrefix(a, \"--last\") && len(a) > 6 {\r\n"]
[1189.61373, "o", "\t\t\t\tv, err := strconv.Atoi(a[6:])\r\n\t\t\t\tif err == nil {\r\n\t\t\t\t\tn = v\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\targs[\"last_n\"] = n\r\n\tcase \"resolve\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl resolve <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"circuits\":\r\n"]
[1189.614262, "o", "\u001b[?2004h"]
[1189.614341, "o", "root@n30009:/app# "]
