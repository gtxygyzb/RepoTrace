[7943.802278, "i", "cat > internal/accesslog/query.go <<'EOF'\npackage accesslog\n\nimport (\n    \"bufio\"\n    \"encoding/json\"\n    \"os\"\n)\n\n// Stats holds aggregated access log statistics for one result type.\ntype Stats struct {\n    Count         int   `json:\"count\"`\n    AvgDurationMs int64 `json:\"avg_duration_ms\"`\n    TotalBytesIn  int64 `json:\"total_bytes_in\"`\n    TotalBytesOut int64 `json:\"total_bytes_out\"`\n}\n\n// StatsResult is the response shape for get_access_stats.\ntype StatsResult struct {\n    TotalRequests int              `json:\"total_requests\"`\n    ByResult      map[string]Stats `json:\"by_result\"`\n}\n\n// ReadEntries reads and parses log entries from the backup file plus the\n// current log file, in chronological order. Invalid lines are skipped.\nfunc ReadEntries(path string) []Entry {\n    var entries []Entry\n    entries = append(entries, readLogFile(path+\".1\")...)\n    entries = append(entries, readLogFile(path)...)\n    return entries\n}\n\nfunc readLogFile(path string) []Entry {\n    f, err := os.Open(path)\n    if err != nil {\n   "]
[7943.802553, "i", "     return nil\n    }\n    defer f.Close()\n\n    var entries []Entry\n    scanner := bufio.NewScanner(f)\n    scanner.Buffer(make([]byte, 1024*1024), 1024*1024)\n    for scanner.Scan() {\n        line := scanner.Bytes()\n        if len(line) == 0 {\n            continue\n        }\n        var e Entry\n        if err := json.Unmarshal(line, &e); err != nil {\n            continue\n        }\n        entries = append(entries, e)\n    }\n    return entries\n}\n\n// GetAccessLog returns filtered log entries. Filters are applied first, then the\n// last lastN entries are returned. If lastN is 0 or negative, all matching\n// entries are returned.\nfunc GetAccessLog(path, service, result string, lastN int, minDurationMs int64) []Entry {\n    entries := ReadEntries(path)\n\n    filtered := entries[:0]\n    for _, e := range entries {\n        if service != \"\" && e.Service != service {\n            continue\n        }\n        if result != \"\" && e.Result != result {\n            continue\n        }\n        if minDurationMs > 0 && e.DurationMs < min"]
[7943.80264, "i", "DurationMs {\n            continue\n        }\n        filtered = append(filtered, e)\n    }\n\n    if lastN <= 0 {\n        return filtered\n    }\n    if len(filtered) > lastN {\n        return filtered[len(filtered)-lastN:]\n    }\n    return filtered\n}\n\n// Stats aggregates access log entries for the optional service filter.\nfunc Stats(path, service string) StatsResult {\n    entries := ReadEntries(path)\n\n    type agg struct {\n        count    int\n        duration int64\n        bytesIn  int64\n        bytesOut int64\n    }\n    aggs := make(map[string]*agg)\n    total := 0\n\n    for _, e := range entries {\n        if service != \"\" && e.Service != service {\n            continue\n        }\n        a := aggs[e.Result]\n        if a == nil {\n            a = &agg{}\n            aggs[e.Result] = a\n        }\n        a.count++\n        a.duration += e.DurationMs\n        a.bytesIn += e.BytesIn\n        a.bytesOut += e.BytesOut\n        total++\n    }\n\n    result := StatsResult{\n        TotalRequests: total,\n        ByResult:      make(map["]
[7943.802716, "o", "cat > internal/accesslog/query.go <<'EOF'\r\n\u001b[?2004l\r"]
[7943.802791, "i", "string]Stats),\n    }\n    for name, a := range aggs {\n        if a.count == 0 {\n            continue\n        }\n        result.ByResult[name] = Stats{\n            Count:         a.count,\n            AvgDurationMs: a.duration / int64(a.count),\n            TotalBytesIn:  a.bytesIn,\n            TotalBytesOut: a.bytesOut,\n        }\n    }\n    return result\n}\nEOF\n"]
[7943.80282, "o", "\u001b[?2004h> "]
[7943.802948, "o", "package accesslog\r\n\u001b[?2004l\r"]
[7943.803032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7943.803112, "o", "\u001b[?2004h> import (\r\n"]
[7943.80318, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[7943.803249, "o", "    \"bufio\"\r\n\u001b[?2004l\r"]
[7943.803315, "o", "\u001b[?2004h> "]
[7943.803464, "o", "    \"encoding/json\"\r\n\u001b[?2004l\r"]
[7943.803548, "o", "\u001b[?2004h>     \"os\"\r\n"]
[7943.803629, "o", "\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[7943.803709, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7943.80379, "o", "\u001b[?2004h> "]
[7943.804144, "o", "// Stats holds aggregated access log statistics for one result type.\r\n\u001b[?2004l\r"]
[7943.804211, "o", "\u001b[?2004h> "]
[7943.804318, "o", "type Stats struct {\r\n\u001b[?2004l\r"]
[7943.804383, "o", "\u001b[?2004h> "]
[7943.804604, "o", "    Count         int   `json:\"count\"`\r\n\u001b[?2004l\r"]
[7943.804662, "o", "\u001b[?2004h> "]
[7943.804939, "o", "    AvgDurationMs int64 `json:\"avg_duration_ms\"`\r\n\u001b[?2004l\r"]
[7943.804993, "o", "\u001b[?2004h> "]
[7943.80529, "o", "    TotalBytesIn  int64 `json:\"total_bytes_in\"`\r\n\u001b[?2004l\r"]
[7943.805358, "o", "\u001b[?2004h> "]
[7943.805641, "o", "    TotalBytesOut int64 `json:\"total_bytes_out\"`\r\n\u001b[?2004l\r"]
[7943.805698, "o", "\u001b[?2004h> }\r\n"]
[7943.80576, "o", "\u001b[?2004l\r\u001b[?2004h"]
[7943.805827, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7943.806175, "o", "// StatsResult is the response shape for get_access_stats.\r\n\u001b[?2004l\r"]
[7943.806238, "o", "\u001b[?2004h> "]
[7943.806405, "o", "type StatsResult struct {\r\n\u001b[?2004l\r"]
[7943.806466, "o", "\u001b[?2004h> "]
[7943.80679, "o", "    TotalRequests int              `json:\"total_requests\"`\r\n\u001b[?2004l\r"]
[7943.806846, "o", "\u001b[?2004h> "]
[7943.80715, "o", "    ByResult      map[string]Stats `json:\"by_result\"`\r\n\u001b[?2004l\r"]
[7943.807217, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[7943.807278, "o", "\u001b[?2004h> \r\n"]
[7943.807336, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[7943.807767, "o", "// ReadEntries reads and parses log entries from the backup file plus the\r\n\u001b[?2004l\r"]
[7943.807834, "o", "\u001b[?2004h> "]
[7943.808247, "o", "// current log file, in chronological order. Invalid lines are skipped.\r\n\u001b[?2004l\r"]
[7943.808297, "o", "\u001b[?2004h> "]
[7943.808547, "o", "func ReadEntries(path string) []Entry {\r\n\u001b[?2004l\r"]
[7943.808613, "o", "\u001b[?2004h> "]
[7943.808745, "o", "    var entries []Entry\r\n\u001b[?2004l\r"]
[7943.808807, "o", "\u001b[?2004h> "]
[7943.809128, "o", "    entries = append(entries, readLogFile(path+\".1\")...)\r\n\u001b[?2004l\r"]
[7943.809187, "o", "\u001b[?2004h> "]
[7943.809491, "o", "    entries = append(entries, readLogFile(path)...)\r\n\u001b[?2004l\r"]
[7943.809558, "o", "\u001b[?2004h> "]
[7943.809665, "o", "    return entries\r\n\u001b[?2004l\r"]
[7943.80972, "o", "\u001b[?2004h> }\r\n"]
[7943.809787, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7943.809859, "o", "\u001b[?2004h> "]
[7943.81009, "o", "func readLogFile(path string) []Entry {\r\n\u001b[?2004l\r"]
[7943.810125, "o", "\u001b[?2004h"]
[7943.810204, "o", "> "]
[7943.810315, "o", "    f, err := os.Open(path)\r\n\u001b[?2004l\r"]
[7943.810371, "o", "\u001b[?2004h> "]
[7943.810498, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[7943.810554, "o", "\u001b[?2004h> "]
[7943.810669, "o", "        return nil\r\n\u001b[?2004l\r"]
[7943.810725, "o", "\u001b[?2004h> "]
[7943.810786, "o", "    }\r\n\u001b[?2004l\r"]
[7943.810842, "o", "\u001b[?2004h> "]
[7943.810948, "o", "    defer f.Close()\r\n\u001b[?2004l\r"]
[7943.811002, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7943.811071, "o", "\u001b[?2004h> "]
[7943.811205, "o", "    var entries []Entry\r\n\u001b[?2004l\r"]
[7943.81126, "o", "\u001b[?2004h> "]
[7943.811468, "o", "    scanner := bufio.NewScanner(f)\r\n\u001b[?2004l\r"]
[7943.811524, "o", "\u001b[?2004h> "]
[7943.811835, "o", "    scanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n\u001b[?2004l\r"]
[7943.811892, "o", "\u001b[?2004h> "]
[7943.812037, "o", "    for scanner.Scan() {\r\n\u001b[?2004l\r"]
[7943.812092, "o", "\u001b[?2004h> "]
[7943.812276, "o", "        line := scanner.Bytes()\r\n\u001b[?2004l\r"]
[7943.812336, "o", "\u001b[?2004h> "]
[7943.812505, "o", "        if len(line) == 0 {\r\n\u001b[?2004l\r"]
[7943.812562, "o", "\u001b[?2004h> "]
[7943.812683, "o", "            continue\r\n\u001b[?2004l\r"]
[7943.812738, "o", "\u001b[?2004h> "]
[7943.812801, "o", "        }\r\n\u001b[?2004l\r"]
[7943.812856, "o", "\u001b[?2004h> "]
[7943.812982, "o", "        var e Entry\r\n\u001b[?2004l\r"]
[7943.813052, "o", "\u001b[?2004h> "]
[7943.813352, "o", "        if err := json.Unmarshal(line, &e); err != nil {\r\n\u001b[?2004l\r"]
[7943.813466, "o", "\u001b[?2004h> "]
[7943.813581, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7943.813649, "o", "        }\r\n\u001b[?2004l\r"]
[7943.813714, "o", "\u001b[?2004h"]
[7943.813774, "o", "> "]
[7943.81393, "o", "        entries = append(entries, e)\r\n\u001b[?2004l\r"]
[7943.814001, "o", "\u001b[?2004h> "]
[7943.814065, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7943.814185, "o", "    return entries\r\n\u001b[?2004l\r"]
[7943.814242, "o", "\u001b[?2004h> }\r\n"]
[7943.814303, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[7943.814363, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[7943.814844, "o", "// GetAccessLog returns filtered log entries. Filters are applied first, then the\r\n\u001b[?2004l\r"]
[7943.814901, "o", "\u001b[?2004h> "]
[7943.815327, "o", "// last lastN entries are returned. If lastN is 0 or negative, all matching\r\n\u001b[?2004l\r"]
[7943.815384, "o", "\u001b[?2004h> "]
[7943.815551, "o", "// entries are returned.\r\n\u001b[?2004l\r"]
[7943.815612, "o", "\u001b[?2004h> "]
[7943.815998, "o", "func GetAccessLog(path, service, result string, lastN int, minDurationMs int64) []Entry {\r\n\u001b[?2004l\r"]
[7943.816056, "o", "\u001b[?2004h> "]
[7943.816179, "o", "    entries := ReadEntries(path)\r\n\u001b[?2004l\r"]
[7943.816235, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7943.816293, "o", "> "]
[7943.816398, "o", "    filtered := entries[:0]\r\n\u001b[?2004l\r"]
[7943.816462, "o", "\u001b[?2004h> "]
[7943.816574, "o", "    for _, e := range entries {\r\n\u001b[?2004l\r"]
[7943.816635, "o", "\u001b[?2004h> "]
[7943.816818, "o", "        if service != \"\" && e.Service != service {\r\n\u001b[?2004l\r"]
[7943.816874, "o", "\u001b[?2004h> "]
[7943.816956, "o", "            continue\r\n\u001b[?2004l\r"]
[7943.817011, "o", "\u001b[?2004h> "]
[7943.81707, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7943.817281, "o", "        if result != \"\" && e.Result != result {\r\n\u001b[?2004l\r"]
[7943.817338, "o", "\u001b[?2004h> "]
[7943.817422, "o", "            continue\r\n\u001b[?2004l\r"]
[7943.817479, "o", "\u001b[?2004h> "]
[7943.817538, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7943.817803, "o", "        if minDurationMs > 0 && e.DurationMs < minDurationMs {\r\n\u001b[?2004l\r"]
[7943.817858, "o", "\u001b[?2004h> "]
[7943.817944, "o", "            continue\r\n\u001b[?2004l\r"]
[7943.817999, "o", "\u001b[?2004h> "]
[7943.81806, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7943.818237, "o", "        filtered = append(filtered, e)\r\n\u001b[?2004l\r"]
[7943.818293, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[7943.818351, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7943.818418, "o", "\u001b[?2004h> "]
[7943.818487, "o", "    if lastN <= 0 {\r\n\u001b[?2004l\r"]
[7943.818543, "o", "\u001b[?2004h> "]
[7943.818629, "o", "        return filtered\r\n\u001b[?2004l\r"]
[7943.818686, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[7943.818747, "o", "\u001b[?2004h> "]
[7943.818871, "o", "    if len(filtered) > lastN {\r\n\u001b[?2004l\r"]
[7943.818926, "o", "\u001b[?2004h> "]
[7943.819102, "o", "        return filtered[len(filtered)-lastN:]\r\n\u001b[?2004l\r"]
[7943.819159, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[7943.819217, "o", "\u001b[?2004h> "]
[7943.8193, "o", "    return filtered\r\n\u001b[?2004l\r"]
[7943.819361, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[7943.819432, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7943.819738, "o", "// Stats aggregates access log entries for the optional service filter.\r\n\u001b[?2004l\r"]
[7943.819794, "o", "\u001b[?2004h> "]
[7943.819974, "o", "func Stats(path, service string) StatsResult {\r\n\u001b[?2004l\r"]
[7943.820032, "o", "\u001b[?2004h> "]
[7943.820155, "o", "    entries := ReadEntries(path)\r\n\u001b[?2004l\r"]
[7943.82021, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[7943.82027, "o", "> "]
[7943.820333, "o", "    type agg struct {\r\n\u001b[?2004l\r"]
[7943.820399, "o", "\u001b[?2004h> "]
[7943.820458, "o", "        count    int\r\n\u001b[?2004l\r"]
[7943.820517, "o", "\u001b[?2004h> "]
[7943.820612, "o", "        duration int64\r\n\u001b[?2004l\r"]
[7943.820667, "o", "\u001b[?2004h> "]
[7943.820751, "o", "        bytesIn  int64\r\n\u001b[?2004l\r"]
[7943.820807, "o", "\u001b[?2004h> "]
[7943.82089, "o", "        bytesOut int64\r\n\u001b[?2004l\r"]
[7943.820946, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[7943.821006, "o", "\u001b[?2004h> "]
[7943.821143, "o", "    aggs := make(map[string]*agg)\r\n\u001b[?2004l\r"]
[7943.821198, "o", "\u001b[?2004h> "]
[7943.821265, "o", "    total := 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[7943.821327, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[7943.821475, "o", "    for _, e := range entries {\r\n\u001b[?2004l\r"]
[7943.821532, "o", "\u001b[?2004h> "]
[7943.821732, "o", "        if service != \"\" && e.Service != service {\r\n\u001b[?2004l\r"]
[7943.821802, "o", "\u001b[?2004h> "]
[7943.821878, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[7943.821939, "o", ">         }\r\n\u001b[?2004l\r"]
[7943.821998, "o", "\u001b[?2004h> "]
[7943.822111, "o", "        a := aggs[e.Result]\r\n\u001b[?2004l\r"]
[7943.822167, "o", "\u001b[?2004h> "]
[7943.822247, "o", "        if a == nil {\r\n\u001b[?2004l\r"]
[7943.822302, "o", "\u001b[?2004h> "]
[7943.822386, "o", "            a = &agg{}\r\n\u001b[?2004l\r"]
[7943.822453, "o", "\u001b[?2004h> "]
[7943.822563, "o", "            aggs[e.Result] = a\r\n\u001b[?2004l\r"]
[7943.822618, "o", "\u001b[?2004h> "]
[7943.822672, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7943.822768, "o", "        a.count++\r\n\u001b[?2004l\r"]
[7943.822823, "o", "\u001b[?2004h> "]
[7943.822956, "o", "        a.duration += e.DurationMs\r\n\u001b[?2004l\r"]
[7943.82301, "o", "\u001b[?2004h> "]
[7943.823127, "o", "        a.bytesIn += e.BytesIn\r\n\u001b[?2004l\r"]
[7943.823182, "o", "\u001b[?2004h> "]
[7943.823305, "o", "        a.bytesOut += e.BytesOut\r\n\u001b[?2004l\r"]
[7943.823359, "o", "\u001b[?2004h> "]
[7943.823431, "o", "        total++\r\n\u001b[?2004l\r"]
[7943.823486, "o", "\u001b[?2004h> "]
[7943.823544, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[7943.823603, "o", "\u001b[?2004h> "]
[7943.823715, "o", "    result := StatsResult{\r\n\u001b[?2004l\r"]
[7943.82377, "o", "\u001b[?2004h> "]
[7943.823883, "o", "        TotalRequests: total,\r\n\u001b[?2004l\r"]
[7943.823939, "o", "\u001b[?2004h> "]
[7943.824118, "o", "        ByResult:      make(map[string]Stats),\r\n\u001b[?2004l\r"]
[7943.824172, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[7943.824241, "o", "\u001b[?2004h> "]
[7943.824368, "o", "    for name, a := range aggs {\r\n\u001b[?2004l\r"]
[7943.824434, "o", "\u001b[?2004h> "]
[7943.824526, "o", "        if a.count == 0 {\r\n\u001b[?2004l\r"]
[7943.824582, "o", "\u001b[?2004h> "]
[7943.824658, "o", "            continue\r\n\u001b[?2004l\r"]
[7943.824712, "o", "\u001b[?2004h> "]
[7943.824773, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7943.824948, "o", "        result.ByResult[name] = Stats{\r\n\u001b[?2004l\r"]
[7943.825006, "o", "\u001b[?2004h> "]
[7943.825139, "o", "            Count:         a.count,\r\n\u001b[?2004l\r"]
[7943.825194, "o", "\u001b[?2004h> "]
[7943.82542, "o", "            AvgDurationMs: a.duration / int64(a.count),\r\n\u001b[?2004l\r"]
[7943.825476, "o", "\u001b[?2004h> "]
[7943.825623, "o", "            TotalBytesIn:  a.bytesIn,\r\n\u001b[?2004l\r"]
[7943.82568, "o", "\u001b[?2004h> "]
[7943.825839, "o", "            TotalBytesOut: a.bytesOut,\r\n\u001b[?2004l\r"]
[7943.825893, "o", "\u001b[?2004h> "]
[7943.825951, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7943.826005, "o", "    }\r\n\u001b[?2004l\r"]
[7943.826077, "o", "\u001b[?2004h> "]
[7943.826125, "o", "    return result\r\n\u001b[?2004l\r"]
[7943.826182, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[7943.826242, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
