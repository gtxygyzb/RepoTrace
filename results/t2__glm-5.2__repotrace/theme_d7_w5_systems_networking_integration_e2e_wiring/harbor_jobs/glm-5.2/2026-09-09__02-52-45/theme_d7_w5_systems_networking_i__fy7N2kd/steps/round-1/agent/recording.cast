[7401.281754, "o", "sed -n '1,260p' cmd/meshd/main.go\r\n\u001b[?2004l\r"]
[7401.284746, "o", "package main\r\n\r\nimport (\r\n\t\"flag\"\r\n\t\"log\"\r\n\t\"os\"\r\n"]
[7401.284854, "o", "\t\"os/signal\"\r\n\t\"sync\"\r\n\t\"syscall\"\r\n\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/health\"\r\n\t\"meshrouter/internal/ipc\"\r\n\t\"meshrouter/internal/router\"\r\n\t\"meshrouter/internal/state\"\r\n)\r\n\r\nfunc main() {\r\n\tcfgPath := flag.String(\"config\", \"/app/config/services.toml\", \"path to services config\")\r\n\tflag.Parse()\r\n\r\n\tcfg, err := config.Load(*cfgPath)\r\n\tif err != nil {\r\n\t\tlog.Fatalf(\"config load failed: %v\", err)\r\n\t}\r\n\r\n"]
[7401.284944, "o", "\tst := state.NewState(cfg, *cfgPath)\r\n\tmonitor := health.NewMonitor(st, cfg)\r\n\trouter := router.NewRouter(st)\r\n\tipcServer := ipc.NewServer(st, \"/tmp/meshd.sock\")\r\n\r\n\tif err := ipcServer.Start(); err != nil {\r\n\t\tlog.Fatalf(\"ipc server failed: %v\", err)\r\n\t}\r\n\tmonitor.Start()\r\n\trouter.Start()\r\n\r\n\tsigCh := make(chan os.Signal, 1)\r\n\tsignal.Notify(sigCh, syscall.SIGHUP, syscall.SIGTERM, syscall.SIGINT)\r\n\tvar reloadMu sync.Mutex\r\n\tfor {\r\n"]
[7401.285011, "o", "\t\tsig := <-sigCh\r\n\t\tif sig == syscall.SIGHUP {\r\n\t\t\treloadMu.Lock()\r\n\t\t\tpath := st.ConfigPath()\r\n\t\t\tnewCfg, err := config.Load(path)\r\n\t\t\tif err != nil {\r\n\t\t\t\tlog.Printf(\"reload failed: %v\", err)\r\n\t\t\t\treloadMu.Unlock()\r\n\t\t\t\tcontinue\r\n"]
[7401.28507, "o", "\t\t\t}\r\n\t\t\tst.ApplyConfig(newCfg)\r\n\t\t\tmonitor.ApplyConfig(newCfg)\r\n\t\t\trouter.Reload()\r\n\t\t\treloadMu.Unlock()\r\n\t\t\tlog.Printf(\"reloaded config\")\r\n\t\t} else {\r\n\t\t\tbreak\r\n\t\t}\r\n"]
[7401.285125, "o", "\t}\r\n\r\n\tmonitor.Stop()\r\n\trouter.Stop()\r\n\tipcServer.Stop()\r\n}\r\n"]
