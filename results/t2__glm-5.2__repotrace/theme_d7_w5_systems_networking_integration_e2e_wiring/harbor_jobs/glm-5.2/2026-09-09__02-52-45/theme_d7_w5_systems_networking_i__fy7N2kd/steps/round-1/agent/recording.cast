[10752.937314, "o", "\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype ServiceState struct\u001b[m\u001b[K {\r\n"]
[10752.937452, "o", "\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmu                        sync.Mutex\r\n\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tName                      string\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tListenPort                int\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRoutingMode               string\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tDrainTimeoutMs            int\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tMaxConnectionsPerEndpoint int\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tConnectionLimitMode       string\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tIdleTimeoutMs             int\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRateLimitRps              int\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRateLimitBurst            int\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRateLimitQueueDepth       int\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRateLimitQueueTimeoutMs   int\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tMaxRetries                int\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRetryDelayMs              int\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRetryBackoffMultiplier    float64\r\n\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRetryMaxDelayMs           i"]
[10752.937549, "o", "nt\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\trateLimiter               *rateLimiter\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tEndpoints                 []*EndpointState\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\trrIndex                   int\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tListener                  net.Listener\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tlistenerStop              chan struct{}\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tstopping                  bool\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Ktype State struct {\r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmu         sync.RWMutex\r\n\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tconfigPath string\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tglobal     config.Global\r\n\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tservices   map[string]*ServiceState\r\n\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tlogMu      sync.Mutex\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\thealthLog  map[string][]HealthEvent\r\n"]
[10752.937624, "o", "\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treloadCh   chan struct{}\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc NewState(cfg *config.Config, path string) *State {\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ts := &State{\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tconfigPath: path,\r\n\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tservices:   make(map[string]*ServiceState),\r\n\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\thealthLog:  make(map[string][]HealthEvent),\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treloadCh:   make(chan struct{}, 1),\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ts.applyConfigLocked(cfg)\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn s"]
[10752.937696, "o", "\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (s *State) ReloadChan() <-chan struct{} {\r\n\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn s.reloadCh\r\n\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[10752.937761, "o", "\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (s *State) ConfigPath() string {\r\n\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ts.mu.RLock()\r\n\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer s.mu.RUnlock()\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn s.configPath\r\n\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (s *State) Global() config.Global {\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ts.mu.RLock()\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer s.mu.RUnlock()\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn s.global\r\n\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n\u001b[32m\u001b[K124\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ts.mu.Lock()\r\n"]
[10752.937827, "o", "\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer s.mu.Unlock()\r\n\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ts.applyConfigLocked(cfg)\r\n\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tselect {\r\n\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase s.reloadCh <- struct{}{}:\r\n\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefault:\r\n\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[10752.937888, "o", "\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ts.global = cfg.Global\r\n\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tseen := make(map[string]bool)\r\n\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor _, svc := range cfg.Services {\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tseen[svc.Name] = true\r\n\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tss := s.services[svc.Name]\r\n\u001b[32m\u001b[K139\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif ss == nil {\r\n\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss = newServiceState(svc, cfg.Global)\r\n\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\ts.services[svc.Name] = ss\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t} else {\r\n\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.mu.Lock()\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.Name = svc.Name\r\n"]
[10752.93795, "o", "\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.ListenPort = svc.ListenPort\r\n\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.RoutingMode = svc.RoutingMode\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.RateLimitRps = svc.RateLimitRps\r\n\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.RateLimitBurst = svc.RateLimitBurst\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.RateLimitQueueDepth = svc.RateLimitQueueDepth\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs\r\n"]
[10752.938009, "o", "\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.MaxRetries = svc.MaxRetries\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.RetryDelayMs = svc.RetryDelayMs\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.RetryMaxDelayMs = svc.RetryMaxDelayMs\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif ss.rateLimiter == nil {\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t} else {\r\n"]
[10752.938067, "o", "\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n"]
