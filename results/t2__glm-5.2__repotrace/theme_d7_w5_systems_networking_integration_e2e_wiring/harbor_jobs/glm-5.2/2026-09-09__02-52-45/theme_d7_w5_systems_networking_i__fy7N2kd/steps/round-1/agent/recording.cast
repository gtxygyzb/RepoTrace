[14481.799042, "o", "etries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()'\r\n)\r\n\r\n# Update probe failure call\r\ns = s.replace(\r\n    '\\t\\t\\tif res.Probe {\\n\\t\\t\\t\\tep.Circuit.ProbeFailure()\\n\\t\\t\\t} else {\\n\\t\\t\\t\\tep.Circuit.Open()\\n\\t\\t\\t}',\r\n    '\\t\\t\\tif res.Probe {\\n\\t\\t\\t\\tep.Circuit.RecordProbeResult(false)\\n\\t\\t\\t} else {\\n\\t\\t\\t\\tep.C"]
