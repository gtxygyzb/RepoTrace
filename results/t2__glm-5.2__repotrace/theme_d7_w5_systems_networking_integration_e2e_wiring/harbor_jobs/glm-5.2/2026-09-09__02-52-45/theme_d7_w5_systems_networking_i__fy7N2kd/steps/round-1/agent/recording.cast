[4119.706603, "i", "sed -n '1,240p' internal/config/config.go\n"]
[4119.706954, "o", "sed -n '1,240p' internal/config/config.go\r\n"]
[4119.707056, "o", "\u001b[?2004l\r"]
[4119.710105, "o", "package config\r\n\r\nimport (\r\n\t\"github.com/BurntSushi/toml\"\r\n"]
[4119.710211, "o", ")\r\n\r\n// Global holds mesh-wide tuning parameters.\r\ntype Global struct {\r\n\tHealthIntervalMs        int `toml:\"health_interval_ms\"`\r\n\tUnhealthyThreshold      int `toml:\"unhealthy_threshold\"`\r\n\tHealthyThreshold        int `toml:\"healthy_threshold\"`\r\n\tStatsWindowSec          int `toml:\"stats_window_sec\"`\r\n\tCircuitBreakerThreshold int `toml:\"circuit_breaker_threshold\"`\r\n\tCircuitBreakerTimeoutMs int `toml:\"circuit_breaker_timeout_ms\"`\r\n}\r\n\r\n// Endpoint describes one backend endpoint from config.\r\ntype Endpoint struct {\r\n\tAddress     string `toml:\"address\"`\r\n\tWeight      int    `toml:\"weight\"`\r\n\tHealthCheck string `toml:\"health_check\"`\r\n\tHealthPath  string `toml:\"health_path\"`\r\n\tHealthCmd   string `toml:\"health_cmd\"`"]
[4119.710292, "o", "\r\n}\r\n\r\n// Service describes one routed service from config.\r\ntype Service struct {\r\n\tName                      string     `toml:\"name\"`\r\n\tListenPort                int        `toml:\"listen_port\"`\r\n\tRoutingMode               string     `toml:\"routing_mode\"`\r\n\tDrainTimeoutMs            int        `toml:\"drain_timeout_ms\"`\r\n\tMaxConnectionsPerEndpoint int        `toml:\"max_connections_per_endpoint\"`\r\n\tRateLimitRps              int        `toml:\"rate_limit_rps\"`\r\n\tRateLimitBurst            int        `toml:\"rate_limit_burst\"`\r\n\tRateLimitQueueDepth       int        `toml:\"rate_limit_queue_depth\"`\r\n\t"]
[4119.710355, "o", "RateLimitQueueTimeoutMs   int        `toml:\"rate_limit_queue_timeout_ms\"`\r\n\tMaxRetries                int        `toml:\"max_retries\"`\r\n\tRetryDelayMs              int        `toml:\"retry_delay_ms\"`\r\n\tRetryBackoffMultiplier    float64    `toml:\"retry_backoff_multiplier\"`\r\n\tRetryMaxDelayMs           int        `toml:\"retry_max_delay_ms\"`\r\n\tEndpoints                 []Endpoint `toml:\"endpoint\"`\r\n}\r\n\r\n// Config is the parsed application configuration.\r\ntype Config struct {\r\n\tGlobal   Global\r\n\tServices []Service `toml:\"service\"`\r\n"]
[4119.710507, "o", "}\r\n\r\n// Load reads and normalizes a TOML config file.\r\nfunc Load(path string) (*Config, error) {\r\n\tvar cfg Config\r\n\tif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif cfg.Global.HealthIntervalMs <= 0 {\r\n\t\tcfg.Global.HealthIntervalMs = 2000\r\n\t}\r\n\tif cfg.Global.UnhealthyThreshold <= 0 {\r\n\t\tcfg.Global.UnhealthyThreshold = 3\r\n\t}\r\n\tif cfg.Global.HealthyThreshold <= 0 {\r\n\t\tcfg.Global.HealthyThreshold = 2\r\n\t}\r\n\tif cfg.Global.StatsWindowSec <= 0 {\r\n\t\tcfg.Global.StatsWindowSec = 60\r\n\t}\r\n\tif cfg.Global.CircuitBreakerThreshold <= 0 {\r\n\t\tcfg.Global.CircuitBreakerThreshold = 3\r\n"]
[4119.710569, "o", "\t}\r\n\tif cfg.Global.CircuitBreakerTimeoutMs <= 0 {\r\n\t\tcfg.Global.CircuitBreakerTimeoutMs = 5000\r\n\t}\r\n\tfor i := range cfg.Services {\r\n\t\ts := &cfg.Services[i]\r\n\t\tif s.RoutingMode == \"\" {\r\n\t\t\ts.RoutingMode = \"weighted-round-robin\"\r\n\t\t}\r\n"]
[4119.710631, "o", "\t\tif s.DrainTimeoutMs <= 0 {\r\n\t\t\ts.DrainTimeoutMs = 5000\r\n\t\t}\r\n\t\tif s.MaxConnectionsPerEndpoint <= 0 {\r\n\t\t\ts.MaxConnectionsPerEndpoint = 100\r\n\t\t}\r\n\t\tif s.RateLimitBurst <= 0 {\r\n\t\t\ts.RateLimitBurst = s.RateLimitRps\r\n\t\t}\r\n"]
[4119.71069, "o", "\t\tif s.RateLimitQueueTimeoutMs <= 0 {\r\n\t\t\ts.RateLimitQueueTimeoutMs = 1000\r\n\t\t}\r\n\t\tif s.RetryDelayMs <= 0 {\r\n\t\t\ts.RetryDelayMs = 100\r\n\t\t}\r\n\t\tif s.RetryBackoffMultiplier <= 0 {\r\n\t\t\ts.RetryBackoffMultiplier = 2.0\r\n\t\t}\r\n"]
[4119.710747, "o", "\t\tif s.RetryMaxDelayMs <= 0 {\r\n\t\t\ts.RetryMaxDelayMs = 5000\r\n\t\t}\r\n\t\tfor j := range s.Endpoints {\r\n\t\t\tep := &s.Endpoints[j]\r\n\t\t\tif ep.HealthCheck == \"\" {\r\n\t\t\t\tep.HealthCheck = \"tcp\"\r\n"]
[4119.710812, "o", "\t\t\t}\r\n\t\t\tif ep.Weight < 0 {\r\n\t\t\t\tep.Weight = 0\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[4119.710871, "o", "\treturn &cfg, nil\r\n}\r\n"]
[4119.711292, "o", "\u001b[?2004h"]
[4119.711352, "o", "root@n30009:/app# "]
[4120.006281, "i", "sed -n '1,260p' internal/state/state.go\n"]
[4120.006696, "o", "sed -n '1,260p' internal/state/state.go\r\n\u001b[?2004l\r"]
[4120.009912, "o", "package state\r\n\r\nimport (\r\n\t\"net\"\r\n\t\"sync\"\r\n\t\"sync/atomic\"\r\n"]
[4120.009969, "o", "\t\"time\"\r\n\r\n\t\"meshrouter/internal/circuit\"\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/stats\"\r\n)\r\n\r\ntype HealthState string\r\n\r\nconst (\r\n\tUnknown   HealthState = \"unknown\"\r\n\tHealthy   HealthState = \"healthy\"\r\n\tUnhealthy HealthState = \"unhealthy\"\r\n"]
[4120.010212, "o", "\tDraining  HealthState = \"draining\"\r\n)\r\n\r\ntype HealthEvent struct {\r\n\tTimestamp   time.Time\r\n\tEndpoint    string\r\n\tOldState    HealthState\r\n\tNewState    HealthState\r\n\tCheckResult string\r\n}\r\n\r\ntype EndpointState struct {\r\n\tmu                sync.Mutex\r\n\tAddress           string\r\n\tWeight            int\r\n\tConfig            config.Endpoint\r\n\tState             HealthState\r\n\tActiveConnections int\r\n\tCircuit           *circuit.Breaker\r\n\tStats             *stats.Collector\r\n\tconsecSuccess     int\r\n\tconsecFailures    int\r\n\tdrainDeadline     time.Time\r\n\tremoved           bool\r\n\tconnIDCounter     int64\r\n\tcurrentWeight     int\r\n\tconnections       map[int64]net.Conn\r\n}\r\n\r\ntype ServiceState struct {\r\n\tmu                        sync.Mutex\r\n\tName                      string\r\n\tListenPort                int\r\n\tRoutingMode               string\r\n\tDrainTimeoutMs            int\r\n\tMaxConnectionsPerEndpoint int\r\n\tRateLimitRps              int\r\n\tRateLimitBurst            int\r\n\tRateLimitQueueDepth       int\r\n\tRateLimitQueueTimeoutMs   in"]
[4120.010295, "o", "t\r\n\tMaxRetries                int\r\n\tRetryDelayMs              int\r\n\tRetryBackoffMultiplier    float64\r\n\tRetryMaxDelayMs           int\r\n\trateLimiter               *rateLimiter\r\n\tEndpoints                 []*EndpointState\r\n\trrIndex                   int\r\n\tListener                  net.Listener\r\n\tlistenerStop              chan struct{}\r\n\tstopping                  bool\r\n}\r\n\r\ntype State struct {\r\n\tmu         sync.RWMutex\r\n\tconfigPath string\r\n\tglobal     config.Global\r\n\tservices   map[string]*ServiceState\r\n\tlogMu      sync.Mutex\r\n\thealthLog  map[string][]HealthEvent\r\n\treloadCh   chan struct{}\r\n}\r\n\r\nfunc NewState(cfg *config.Config, path string) *State {\r\n\ts := &State{\r\n\t\tconfigPath: path,\r\n"]
[4120.010324, "o", "\t\tservices:   make(map[string]*ServiceState),\r\n\t\thealthLog:  make(map[string][]HealthEvent),\r\n\t\treloadCh:   make(chan struct{}, 1),\r\n"]
[4120.01035, "o", "\t}\r\n\ts.applyConfigLocked(cfg)\r\n\treturn s\r\n}\r\n\r\nfunc (s *State) ReloadChan() <-chan struct{} {\r\n\treturn s.reloadCh\r\n"]
[4120.01052, "o", "}\r\n\r\nfunc (s *State) ConfigPath() string {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.configPath\r\n}\r\n\r\nfunc (s *State) Global() config.Global {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.global\r\n}\r\n\r\nfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n\ts.mu.Lock()\r\n"]
[4120.010591, "o", "\tdefer s.mu.Unlock()\r\n\ts.applyConfigLocked(cfg)\r\n\tselect {\r\n\tcase s.reloadCh <- struct{}{}:\r\n\tdefault:\r\n\t}\r\n}\r\n\r\nfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n\ts.global = cfg.Global\r\n\tseen := make(map[string]bool)\r\n\tfor _, svc := range cfg.Services {\r\n\t\tseen[svc.Name] = true\r\n\t\tss := s.services[svc.Name]\r\n\t"]
[4120.010659, "o", "\tif ss == nil {\r\n\t\t\tss = newServiceState(svc, cfg.Global)\r\n\t\t\ts.services[svc.Name] = ss\r\n\t\t} else {\r\n\t\t\tss.mu.Lock()\r\n\t\t\tss.Name = svc.Name\r\n\t\t\tss.ListenPort = svc.ListenPort\r\n\t\t\tss.RoutingMode = svc.RoutingMode\r\n\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n\t\t\tss.RateLimitRps = svc.RateLimitRps\r\n\t\t\tss.RateLimitBurst = svc.RateLimitBurst\r\n"]
[4120.01073, "o", "\t\t\tss.RateLimitQueueDepth = svc.RateLimitQueueDepth\r\n\t\t\tss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs\r\n\t\t\tss.MaxRetries = svc.MaxRetries\r\n\t\t\tss.RetryDelayMs = svc.RetryDelayMs\r\n\t\t\tss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier\r\n\t\t\tss.RetryMaxDelayMs = svc.RetryMaxDelayMs\r\n\t\t\tif ss.rateLimiter == nil {\r\n\t\t\t\tss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n\t\t\t} else {\r\n\t\t\t\tss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n"]
[4120.010799, "o", "\t\t\t}\r\n\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n\t\t\tss.mu.Unlock()\r\n\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n\t\t}\r\n\t}\r\n\tfor name, ss := range s.services {\r\n\t\tif !seen[name] {\r\n\t\t\tss.mu.Lock()\r\n\t\t\tss.stopping = true\r\n\t\t\tif ss.listenerStop != nil {\r\n"]
[4120.010864, "o", "\t\t\t\tclose(ss.listenerStop)\r\n\t\t\t\tss.listenerStop = nil\r\n\t\t\t}\r\n\t\t\tif ss.Listener != nil {\r\n\t\t\t\tss.Listener.Close()\r\n"]
[4120.010926, "o", "\t\t\t\tss.Listener = nil\r\n\t\t\t}\r\n\t\t\tss.mu.Unlock()\r\n\t\t\tfor _, ep := range ss.Endpoints {\r\n\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n"]
[4120.010989, "o", "\r\nfunc newServiceState(svc config.Service, global config.Global) *ServiceState {\r\n\tss := &ServiceState{\r\n\t\tName:                      svc.Name,\r\n\t\tListenPort:                svc.ListenPort,\r\n\t\tRoutingMode:               svc.RoutingMode,\r\n\t\tDrainTimeoutMs:            svc.DrainTimeoutMs,\r\n\t\tRateLimitRps:              svc.RateLimitRps,\r\n"]
[4120.011054, "o", "\t\tRateLimitBurst:            svc.RateLimitBurst,\r\n\t\tRateLimitQueueDepth:       svc.RateLimitQueueDepth,\r\n\t\tRateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,\r\n"]
[4120.011124, "o", "\t\tMaxRetries:                svc.MaxRetries,\r\n\t\tRetryDelayMs:              svc.RetryDelayMs,\r\n\t\tRetryBackoffMultiplier:    svc.RetryBackoffMultiplier,\r\n\t\tRetryMaxDelayMs:           svc.RetryMaxDelayMs,\r\n\t\trateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),\r\n\t\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n\t\tlistenerStop:              nil,\r\n\t}\r\n\tfor _, ep := range svc.Endpoints {\r\n\t\tss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))\r\n\t}\r\n"]
[4120.011192, "o", "\treturn ss\r\n}\r\n\r\nfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n\tss.mu.Lock()\r\n\tdefer ss.mu.Unlock()\r\n\tseen := make(map[string]bool)\r\n\tfor _, cep := range eps {\r\n\t\tseen[cep.Address] = true\r\n\t\tvar ep *EndpointState\r\n\t\tfor _, existing := range ss.Endpoints {\r\n\t\t"]
[4120.011256, "o", "\tif existing.Address == cep.Address {\r\n\t\t\t\tep = existing\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\t"]
[4120.01132, "o", "if ep == nil {\r\n\t\t\tep = newEndpointState(cep, global)\r\n\t\t\tss.Endpoints = append(ss.Endpoints, ep)\r\n\t\t} else {\r\n\t\t\tep.mu.Lock()\r\n\t\t\t"]
[4120.011398, "o", "ep.Config = cep\r\n\t\t\tep.Weight = cep.Weight\r\n\t\t\tep.mu.Unlock()\r\n\t\t}\r\n\t}\r\n\tfor _, ep := range ss.Endpoints {\r\n\t\tif !seen[ep.Address] {\r\n\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n\t\t}\r\n\t}\r\n}"]
[4120.011471, "o", "\r\n"]
[4120.011534, "o", "\r\nfunc newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {\r\n\treturn &EndpointState{\r\n\t\tAddress:     cep.Address,\r\n\t\tWeight:      cep.Weight,\r\n\t\tConfig:      cep,\r\n\t\tState:       Unknown,\r\n\t\tCircuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n\t\tStats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n\t\tconnections: make(map[int64]net.Conn),\r\n\t}\r\n}\r\n\r\nfunc (s *State) GetService(name string) *ServiceState {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.services[name]"]
[4120.011597, "o", "\r\n}\r\n\r\nfunc (s *State) Services() []*ServiceState {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\tout := make([]*ServiceState, 0, len(s.services))\r\n\tfor _, ss := range s.services {\r\n\t\tout = append(out, ss)\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc (s *State) GetEndpoint(service, address string) *EndpointState {\r\n\tss := s.GetService(service)\r\n\tif ss == nil {\r\n\t\treturn nil\r\n"]
[4120.011701, "o", "\t}\r\n\tss.mu.Lock()\r\n\tdefer ss.mu.Unlock()\r\n"]
[4120.01219, "o", "\u001b[?2004h"]
[4120.012247, "o", "root@n30009:/app# "]
[4120.288562, "i", "sed -n '1,260p' internal/state/routing.go\n"]
[4120.288918, "o", "sed -n '1,260p' internal/state/routing.go\r\n\u001b[?2004l\r"]
[4120.291813, "o", "package state\r\n\r\nimport (\r\n\t\"sort\"\r\n"]
[4120.291896, "o", "\t\"time\"\r\n)\r\n\r\n// SelectResult contains selected endpoint and whether it is a half-open probe.\r\ntype SelectResult struct {\r\n\tEndpoint *EndpointState\r\n\tProbe    bool\r\n\tMaxConns int\r\n}\r\n\r\n// SelectEndpoint chooses an endpoint for the next connection.\r\n"]
[4120.291968, "o", "func (s *State) SelectEndpoint(service string) (SelectResult, error) {\r\n\tss := s.GetService(service)\r\n\tif ss == nil {\r\n\t\treturn SelectResult{}, errNotFound(\"service not found\")\r\n\t}\r\n\tss.mu.Lock()\r\n\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n\tmode := ss.RoutingMode\r\n\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n\tcopy(endpoints, ss.Endpoints)\r\n\tss.mu.Unlock()\r\n\r\n"]
[4120.292036, "o", "\tnow := time.Now()\r\n\t_ = now\r\n\r\n\tvar regular []*EndpointState\r\n\tfor _, ep := range endpoints {\r\n\t\tep.mu.Lock()\r\n\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n\t\tep.mu.Unlock()\r\n\t\tif eligible {\r\n\t\t\tregular = append(regular, ep)\r\n"]
[4120.292097, "o", "\t\t}\r\n\t}\r\n\r\n\tif len(regular) > 0 {\r\n\t\tif mode == \"least-connections\" {\r\n\t\t\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\r\n\t\t}\r\n\t\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\r\n\t}\r\n\r\n\t"]
[4120.292157, "o", "for _, ep := range endpoints {\r\n\t\tep.mu.Lock()\r\n\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n\t\tep.mu.Unlock()\r\n\t\tif halfOpen && ep.Circuit.AcquireProbe() {\r\n\t\t\treturn SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil\r\n\t\t}\r\n\t}\r\n\treturn SelectResult{}, errNotFound(\"no eligible endpoints\")\r\n"]
[4120.292218, "o", "}\r\n\r\n// SelectCandidate returns the endpoint that would be selected ignoring connection limits.\r\n// Used to account rejected_connections when all eligible endpoints are at capacity.\r\nfunc (s *State) SelectCandidate(service string) (*EndpointState, error) {\r\n\tss := s.GetService(service)\r\n\tif ss == nil {\r\n\t\treturn nil, errNotFound(\"service not found\")\r\n\t}\r\n\tss.mu.Lock()\r\n\tmode := ss.RoutingMode\r\n\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n"]
[4120.292276, "o", "\tcopy(endpoints, ss.Endpoints)\r\n\tss.mu.Unlock()\r\n\r\n\tvar regular []*EndpointState\r\n\tfor _, ep := range endpoints {\r\n\t\tep.mu.Lock()\r\n\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining\r\n\t\tep.mu.Unlock()\r\n\t\tif eligible {\r\n"]
[4120.292339, "o", "\t\t\tregular = append(regular, ep)\r\n\t\t}\r\n\t}\r\n\tif len(regular) == 0 {\r\n\t\tfor _, ep := range endpoints {\r\n\t\t\tep.mu.Lock()\r\n\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining\r\n\t\t\tep.mu.Unlock()\r\n\t\t\tif halfOpen {\r\n\t"]
[4120.292465, "o", "\t\t\treturn ep, nil\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn nil, errNotFound(\"no eligible endpoints\")\r\n\t}\r\n\tif mode == \"least-connections\" {\r\n\t\treturn selectLeastConnections(regular, 1<<30), nil\r\n\t}\r\n\treturn selectWeightedCandidate(regular), nil\r\n}\r\n\r\nfunc selectWeighted(eps []*EndpointState) *EndpointState {\r\n\tvar best *EndpointState\r\n\tvar bestWeight int\r\n\tvar totalWeight int\r\n\tfor _, ep := range eps {\r\n\t\tep.mu.Lock()\r\n"]
[4120.292542, "o", "\t\tep.currentWeight += ep.Weight\r\n\t\ttotalWeight += ep.Weight\r\n\t\tcw := ep.currentWeight\r\n\t\tep.mu.Unlock()\r\n\t\tif best == nil || cw > bestWeight {\r\n\t\t\tbest = ep\r\n\t\t\tbestWeight = cw\r\n\t\t}\r\n\t}\r\n\tif best != nil {\r\n\t\tbest.mu.Lock()\r\n\t\tbest.currentWeight -= totalWeight\r\n\t\tbest.mu.Unlock()\r\n"]
[4120.292597, "o", "\t}\r\n\treturn best\r\n}\r\n\r\nfunc selectWeightedCandidate(eps []*EndpointState) *EndpointState {\r\n\tvar best *EndpointState\r\n\tvar bestWeight int\r\n\tfor _, ep := range eps {\r\n\t\tep.mu.Lock()\r\n\t\tcw := ep.currentWeight + ep.Weight\r\n\t\tep.mu.Unlock()\r\n"]
[4120.292653, "o", "\t\tif best == nil || cw > bestWeight {\r\n\t\t\tbest = ep\r\n\t\t\tbestWeight = cw\r\n\t\t}\r\n\t}\r\n\treturn best\r\n}\r\n\r\nfunc selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\r\n\tsort.SliceStable(eps, func(i, j int) bool {\r\n\t\t"]
[4120.292711, "o", "ai := eps[i].Active()\r\n\t\taj := eps[j].Active()\r\n\t\tif ai != aj {\r\n\t\t\treturn ai < aj\r\n\t\t}\r\n\t\treturn eps[i].Address < eps[j].Address\r\n\t})\r\n\treturn eps[0]\r\n}\r\n\r\n"]
[4120.292776, "o", "// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\r\nfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\r\n\tss := s.GetService(service)\r\n\tif ss == nil {\r\n\t\treturn SelectResult{}, errNotFound(\"service not found\")\r\n\t}\r\n\tss.mu.Lock()\r\n\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n\tmode := ss.RoutingMode\r\n\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n\tcopy(endpoints, ss.Endpoints)"]
[4120.292832, "o", "\r\n\tss.mu.Unlock()\r\n\r\n\tvar regular []*EndpointState\r\n\tfor _, ep := range endpoints {\r\n\t\tif exclude != nil && ep == exclude {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tep.mu.Lock()\r\n"]
[4120.29289, "o", "\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n\t\tep.mu.Unlock()\r\n\t\tif eligible {\r\n\t\t\tregular = append(regular, ep)\r\n\t\t}\r\n\t}\r\n\r\n\tif len(regular) > 0 {\r\n\t\tif mode == \"least-connections\" {\r\n\t\t\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\r\n"]
[4120.292948, "o", "\t\t}\r\n\t\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\r\n\t}\r\n\r\n\tfor _, ep := range endpoints {\r\n\t\tif exclude != nil && ep == exclude {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tep.mu.Lock()\r\n\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n\t\tep.mu.Unlock()\r\n\t\tif halfOpen && ep.Circuit.AcquireProbe() {\r\n"]
[4120.29301, "o", "\t\t\treturn SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil\r\n\t\t}\r\n\t}\r\n\treturn SelectResult{}, errNotFound(\"no eligible endpoints\")\r\n}\r\n"]
