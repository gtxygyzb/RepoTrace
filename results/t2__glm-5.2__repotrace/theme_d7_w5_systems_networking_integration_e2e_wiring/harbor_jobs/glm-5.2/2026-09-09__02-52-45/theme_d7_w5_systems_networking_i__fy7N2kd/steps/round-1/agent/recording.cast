[2557.859136, "o", "\u001b[?2004h> "]
[2557.859237, "o", "s = p.read_text()\r\n\u001b[?2004l\r"]
[2557.8593, "o", "\u001b[?2004h> "]
[2557.859455, "o", "old = '''\\tcase \"reload\":\r\n\u001b[?2004l\r"]
[2557.859513, "o", "\u001b[?2004h> "]
