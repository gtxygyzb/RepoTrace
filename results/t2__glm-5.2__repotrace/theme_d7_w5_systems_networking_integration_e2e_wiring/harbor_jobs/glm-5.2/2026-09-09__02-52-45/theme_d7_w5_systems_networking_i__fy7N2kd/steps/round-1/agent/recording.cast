[13863.574349, "o", "   290\t\t\t\tcontinue\r\n   291\t\t\t}\r\n   292\t\r\n   293\t\t\tif res.Probe {\r\n   294\t\t\t\tep.Circuit.ProbeSuccess()\r\n   295\t\t\t\tvar ok bool\r\n   296\t\t\t\tid, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\r\n   297\t\t\t\tif !ok {\r\n   298\t\t\t\t\tresult = \"rejected_conn_limit\"\r\n   299\t\t\t\t\tep.Stats.RecordRejection()\r\n"]
