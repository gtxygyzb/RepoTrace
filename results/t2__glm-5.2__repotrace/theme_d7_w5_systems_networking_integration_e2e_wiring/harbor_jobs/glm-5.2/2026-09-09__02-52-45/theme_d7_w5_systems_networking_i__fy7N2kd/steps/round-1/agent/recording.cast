[5929.1723, "o", "   100\tfunc (s *Server) handleLine(line string) string {\r\n   101\t\tvar req Request\r\n   102\t\tif err := json.Unmarshal([]byte(line), &req); err != nil {\r\n   103\t\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n"]
[5929.172433, "o", "   104\t\t}\r\n   105\t\tdata, err := s.dispatch(req)\r\n   106\t\tif err != nil {\r\n   107\t\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n   108\t\t}\r\n   109\t\treturn encodeResp(Response{Status: \"ok\", Data: data})\r\n   110\t}\r\n   111\t\r\n   112\tfunc encodeResp(r Response) string {\r\n   113\t\tb, _ := json.Marshal(r)\r\n   114\t\treturn string(b)\r\n   115\t}\r\n   116\t\r\n   117\tfunc (s *Server) dispatch(req Request) (interface{}, error) {\r\n   118\t\tswitch req.Cmd {\r\n"]
[5929.172511, "o", "   119\t\tcase \"list_services\":\r\n   120\t\t\treturn s.state.ServicesView(), nil\r\n   121\t\tcase \"get_service\":\r\n   122\t\t\tvar args struct {\r\n   123\t\t\t\tName string `json:\"name\"`\r\n   124\t\t"]
[5929.172588, "o", "\t}\r\n   125\t\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n   126\t\t\t\treturn nil, err\r\n   127\t\t\t}\r\n   128\t\t\tsv, ok := s.state.ServiceView(args.Name)\r\n   129\t\t\tif !ok {\r\n   130\t\t\t\treturn nil, errors.New(\"service not found\")\r\n   131\t\t\t}\r\n   132\t\t\treturn sv, nil\r\n   133\t\tcase \"get_stats\":\r\n   134\t\t\tvar args struct {\r\n   135\t\t\t\tName string `json:\"name\"`\r\n   136\t\t\t}\r\n   137\t\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n   138\t\t\t\treturn nil, err\r\n"]
[5929.172676, "o", "   139\t\t\t}\r\n   140\t\t\tg := s.state.Global()\r\n   141\t\t\tsv, ok := s.state.StatsView(args.Name, g.StatsWindowSec)\r\n   142\t\t\tif !ok {\r\n   143\t\t\t\treturn nil, errors.New(\"service not found\")\r\n   144\t\t\t}\r\n   145\t\t\treturn sv, nil\r\n   146\t\tcase \"set_weight\":\r\n   147\t\t\tvar args struct {\r\n   148\t\t\t\tName    string `json:\"name\"`\r\n   149\t\t\t\tAddress string `json:\"address\"`\r\n   150\t\t\t\tWeight  int    `json:\"weight\"`\r\n"]
