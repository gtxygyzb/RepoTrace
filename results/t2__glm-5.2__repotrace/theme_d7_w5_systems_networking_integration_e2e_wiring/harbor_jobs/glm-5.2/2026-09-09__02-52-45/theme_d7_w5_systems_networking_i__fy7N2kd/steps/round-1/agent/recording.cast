[4186.920329, "o", "    11\t\t\"meshrouter/internal/stats\"\r\n    12\t)\r\n    13\t\r\n    14\ttype HealthState string\r\n    15\t\r\n    16\tconst (\r\n    17\t\tUnknown   HealthState = \"unknown\"\r\n    18\t\tHealthy   HealthState = \"healthy\"\r\n    19\t\tUnhealthy HealthState = \"unhealthy\"\r\n    20\t\tDraining  HealthState = \"draining\"\r\n    21\t)\r\n    22\t\r\n    23\ttype HealthEvent struct {\r\n    24\t\tTimestamp   time.Time\r\n    25\t\tEndpoint    string\r\n    26\t\tOldState    HealthState\r\n    27\t\tNewState    HealthState\r\n    28\t\tCheckResult string\r\n    29\t}\r\n    30\t\r\n    31\ttype EndpointState struct {\r\n    32\t\tmu                sync.Mutex\r\n    33\t\tAddress           string\r\n    34\t\tWeight            int\r\n    35\t\tConfig            config.Endpoint\r\n    36\t\tState             HealthState\r\n    37\t\tActiveConnections int\r\n    38\t\tCircuit           *circuit.Breaker\r\n    39\t\tStats             *stats.Collector\r\n    40\t\tconsecSuccess     int\r\n    41\t\tconsecFailures    int\r\n"]
[4186.920511, "o", "    42\t\tdrainDeadline     time.Time\r\n    43\t\tremoved           bool\r\n    44\t\tconnIDCounter     int64\r\n    45\t\tcurrentWeight     int\r\n    46\t\tconnections       map[int64]net.Conn\r\n    47\t}\r\n    48\t\r\n    49\ttype ServiceState struct {\r\n"]
[4186.920613, "o", "    50\t\tmu                        sync.Mutex\r\n    51\t\tName                      string\r\n    52\t\tListenPort                int\r\n    53\t\tRoutingMode               string\r\n    54\t\tDrainTimeoutMs            int\r\n    55\t\tMaxConnectionsPerEndpoint int\r\n    56\t\tRateLimitRps              int\r\n    57\t\tRateLimitBurst            int\r\n    58\t\tRateLimitQueueDepth       int\r\n    59\t\tRateLimitQueueTimeoutMs   int\r\n    60\t\tMaxRetries                int\r\n    61\t\tRetryDelayMs              int\r\n    62\t\tRetryBackoffMultiplier    float64\r\n    63\t\tRetryMaxDelayMs           int\r\n    64\t\trateLimiter               *rateLimiter\r\n    65\t\tEndpoints                 []*EndpointState\r\n    66\t\trrIndex                   int\r\n    67\t\tListener                  net.Listener\r\n    68\t\tlistenerStop              chan struct{}\r\n    69\t\tstopping                  bool\r\n    70\t}\r\n    71\t\r\n    72\ttype State struct {\r\n    73\t\tmu         sync.RWMutex\r\n    74\t\tconfigPath string\r\n    75\t\tglobal     config.Global\r\n    76\t\tservices   map[string]*ServiceState\r"]
