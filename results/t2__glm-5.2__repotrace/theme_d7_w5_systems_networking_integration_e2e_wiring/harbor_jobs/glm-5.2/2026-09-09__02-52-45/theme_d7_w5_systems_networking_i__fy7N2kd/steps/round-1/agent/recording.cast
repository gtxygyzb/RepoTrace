[7943.234081, "o", "// Stop flushes all buffered entries and closes the log file.\r\n\u001b[?2004l\r"]
[7943.234169, "o", "\u001b[?2004h> "]
[7943.234243, "o", "func (l *Logger) Stop() {\r\n\u001b[?2004l\r"]
[7943.234335, "o", "\u001b[?2004h> "]
[7943.234427, "o", "    l.stopOnce.Do(func() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[7943.234517, "o", "> "]
