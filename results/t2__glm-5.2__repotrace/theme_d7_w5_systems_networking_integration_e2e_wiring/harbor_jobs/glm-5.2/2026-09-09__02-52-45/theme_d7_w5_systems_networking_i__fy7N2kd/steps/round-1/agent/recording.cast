[13863.574483, "o", "\tep.Stats.RecordRetrySuccess()\r\n   308\t\t\t}\r\n   309\t\t\tbytesIn, bytesOut, idleClosed := forward(client, backend, ep, id, ss.IdleTimeout())\r\n   310\t\t\tbackend.Close()\r\n   311\t\t\tclient.Close()\r\n   312\t\t\tep.RemoveConnection(id)\r\n   313\t\t\tep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)\r\n   314\t\t\tif idleClosed {\r\n   315\t\t\t\tresult = \"idle_timeout\"\r\n"]
