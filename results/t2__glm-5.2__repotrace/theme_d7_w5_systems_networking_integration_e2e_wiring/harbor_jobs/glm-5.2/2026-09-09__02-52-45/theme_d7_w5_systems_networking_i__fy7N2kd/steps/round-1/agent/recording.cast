[1980.791859, "o", "     1\tpackage stats\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"sync\"\r\n     5\t\t\"time\"\r\n     6\t)\r\n     7\t\r\n"]
[1980.791938, "o", "     8\ttype entry struct {\r\n     9\t\ttimestamp time.Time\r\n    10\t\tbytesIn   int64\r\n    11\t\tbytesOut  int64\r\n    12\t\tlatency   time.Duration\r\n    13\t\terr       bool\r\n    14\t}\r\n    15\t\r\n    16\t// Collector keeps rolling connection statistics for one endpoint.\r\n    17\ttype Collector struct {\r\n"]
[1980.792006, "o", "    18\t\tmu         sync.Mutex\r\n    19\t\twindow     time.Duration\r\n    20\t\tentries    []entry\r\n    21\t\trejections []time.Time\r\n    22\t}\r\n    23\t\r\n    24\t// New creates a collector with the given window length.\r\n    25\tfunc New(window time.Duration) *Collector {\r\n    26\t\tif window <= 0 {\r\n    27\t\t\twindow = time.Minute\r\n    28\t\t}\r\n    29\t\treturn &Collector{window: window}\r\n"]
[1980.792072, "o", "    30\t}\r\n    31\t\r\n    32\t// RecordConnection records a finished connection attempt.\r\n    33\tfunc (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\r\n    34\t\tc.mu.Lock()\r\n    35\t\tdefer c.mu.Unlock()\r\n    36\t\tnow := time.Now()\r\n    37\t\tc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\r\n    38\t\tc.trim(now)\r\n    39\t}\r\n"]
[1980.792133, "o", "    40\t\r\n    41\t// RecordRejection records a rejected connection because the endpoint was at capacity.\r\n    42\tfunc (c *Collector) RecordRejection() {\r\n    43\t\tc.mu.Lock()\r\n    44\t\tdefer c.mu.Unlock()\r\n    45\t\tnow := time.Now()\r\n    46\t\tc.rejections = append(c.rejections, now)\r\n    47\t\tc.trim(now)\r\n    48\t}\r\n    49\t\r\n    50\tfunc (c *Collector) trim(now time.Time) {\r\n    51"]
[1980.792196, "o", "\t\tcutoff := now.Add(-c.window)\r\n    52\t\ti := 0\r\n    53\t\tfor i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {\r\n    54\t\t\ti++\r\n    55\t\t}\r\n"]
[1980.792256, "o", "    56\t\tif i > 0 {\r\n    57\t\t\tc.entries = c.entries[i:]\r\n    58\t\t}\r\n    59\t\tj := 0\r\n    60\t\tfor j < len(c.rejections) && c.rejections[j].Before(cutoff) {\r\n    61\t\t\tj++\r\n    62\t\t}\r\n    63\t\tif j > 0 {\r\n    64\t"]
[1980.792319, "o", "\t\tc.rejections = c.rejections[j:]\r\n    65\t\t}\r\n    66\t}\r\n    67\t\r\n    68\t// Snapshot returns current windowed stats. active is supplied by the state manager.\r\n    69\tfunc (c *Collector) Snapshot(active int) Snapshot {\r\n    70\t\tc.mu.Lock()\r\n    71\t\tdefer c.mu.Unlock()\r\n    72\t\tnow := time.Now()\r\n    73\t\tcutoff := now.Add(-c.window)\r\n    74\t\tvar total int\r\n    75\t\tvar bytesIn, bytesOut int64\r\n    76\t\tvar latencySum time.Duration\r\n    77\t\tvar errors int\r\n"]
[1980.792379, "o", "    78\t\tfor _, e := range c.entries {\r\n    79\t\t\tif e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {\r\n    80\t\t\t\ttotal++\r\n    81\t\t\t\tbytesIn += e.bytesIn\r\n"]
[1980.792477, "o", "    82\t\t\t\tbytesOut += e.bytesOut\r\n    83\t\t\t\tlatencySum += e.latency\r\n    84\t\t\t\tif e.err {\r\n    85\t\t\t\t\terrors++\r\n    86\t\t\t\t}\r\n    87\t\t\t}\r\n    88\t\t}\r\n    89\t\trejected := 0\r\n    90\t\tfor _, t := range c.rejections {\r\n    91\t\t\tif t.After(cutoff) || t.Equal(cutoff) {\r\n    92\t\t\t\trejected++\r\n    93\t\t\t}\r\n    94\t\t}\r\n    95\t\tvar avg float64\r\n    96\t\tif total > 0 {\r\n    97\t\t\tavg = float64(latencySum.Milliseconds()) / float64(total)\r\n"]
[1980.792538, "o", "    98\t\t}\r\n    99\t\treturn Snapshot{\r\n   100\t\t\tTotalConnections:    total,\r\n   101\t\t\tActiveConnections:   active,\r\n   102\t\t\tBytesIn:             bytesIn,\r\n   103"]
[1980.792577, "o", "\t\t\tBytesOut:            bytesOut,\r\n   104\t\t\tAvgLatencyMs:        avg,\r\n   105\t\t\tErrors:              errors,\r\n   106\t\t\tRejectedConnections: rejected,\r\n   107\t\t}\r\n   108\t}\r\n   109\t\r\n   110\t// Snapshot is a JSON-friendly stats view.\r\n   111\ttype Snapshot struct {\r\n   112\t\tTotalConnections    int     `json:\"total_connections\"`\r\n"]
[1980.792652, "o", "   113\t\tActiveConnections   int     `json:\"active_connections\"`\r\n   114\t\tBytesIn             int64   `json:\"bytes_in\"`\r\n   115\t\tBytesOut            int64   `json:\"bytes_out\"`\r\n   116\t\tAvgLatencyMs        float64 `json:\"avg_latency_ms\"`\r\n   117\t\tErrors              int     `json:\"errors\"`\r\n   118\t\tRejectedConnections int     `json:\"rejected_connections\"`\r\n   119\t}\r\n"]
