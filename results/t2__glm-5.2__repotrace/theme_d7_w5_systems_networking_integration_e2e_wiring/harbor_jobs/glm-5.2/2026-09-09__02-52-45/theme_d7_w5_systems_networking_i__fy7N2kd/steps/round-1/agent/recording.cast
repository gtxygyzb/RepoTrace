[10613.858946, "o", "     1\tpackage accesslog\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"os\"\r\n"]
[10613.859036, "o", "     6\t\t\"path/filepath\"\r\n     7\t\t\"sync\"\r\n     8\t\t\"sync/atomic\"\r\n     9\t\t\"time\"\r\n    10\t)\r\n    11\t\r\n    12\t// Entry is one structured access log record.\r\n    13\ttype Entry struct {\r\n    14\t\tTs          string `json:\"ts\"`\r\n    15\t\tService     string `json:\"service\"`\r\n    16\t\tClient      string `json:\"client\"`\r\n    17\t\tEndpoint    string `json:\"endpoint\"`\r\n"]
[10613.859115, "o", "    18\t\tBytesIn     int64  `json:\"bytes_in\"`\r\n    19\t\tBytesOut    int64  `json:\"bytes_out\"`\r\n    20\t\tDurationMs  int64  `json:\"duration_ms\"`\r\n    21\t\tResult      string `json:\"result\"`\r\n    22\t\tRetried     bool   `json:\"retried\"`\r\n    23\t\tRetryCount  int    `json:\"retry_count\"`\r\n    24\t\tQueueWaitMs *int64 `json:\"queue_wait_ms,omitempty\"`\r\n    25\t}\r\n    26\t\r\n    27\t// DefaultPath is the access log path required by meshrouter.\r\n    28\tconst DefaultPath = \"/app/logs/access.log\"\r\n    29\t\r\n    30\tconst maxFileSize = 1 << 20 // 1 MB\r\n    31\t\r\n"]
[10613.859194, "o", "    32\t// Logger writes access log entries asynchronously to a JSON-lines file.\r\n    33\ttype Logger struct {\r\n    34\t\tpath     string\r\n    35\t\tch       chan Entry\r\n    36\t\tstop     chan struct{}\r\n    37\t\tdone     chan struct{}\r\n    38\t\tstopped  int32\r\n    39\t\tstopOnce sync.Once\r\n    40\t\tmu       sync.Mutex\r\n    41\t\tfile     *os.File\r\n    42\t"]
[10613.859266, "o", "\tsize     int64\r\n    43\t}\r\n    44\t\r\n    45\t// New creates a Logger for path and starts its writer goroutine.\r\n    46\tfunc New(path string) *Logger {\r\n    47\t\tif path == \"\" {\r\n    48\t\t\tpath = DefaultPath\r\n    49\t\t}\r\n    50\t\tl := &Logger{\r\n    51\t\t\tpath: path,\r\n    52\t\t\tch:   make(chan Entry, 8192),\r\n    53\t\t\tstop: make(chan struct{}),\r\n"]
[10613.859344, "o", "    54\t\t\tdone: make(chan struct{}),\r\n    55\t\t}\r\n    56\t\tgo l.run()\r\n    57\t\treturn l\r\n    58\t}\r\n    59\t\r\n    60\t// Path returns the configured log file path.\r\n    61\tfunc (l *Logger) Path() string {\r\n    62\t\treturn l.path\r\n    63\t}\r\n    64\t\r\n"]
[10613.859444, "o", "    65\t// Log queues an entry for asynchronous writing. If the buffered channel is full,\r\n    66\t// the entry is written synchronously to avoid losing it.\r\n    67\tfunc (l *Logger) Log(entry Entry) {\r\n    68\t\tif atomic.LoadInt32(&l.stopped) != 0 {\r\n    69\t\t\treturn\r\n    70\t\t}\r\n"]
[10613.859516, "o", "    71\t\tentry.Ts = time.Now().UTC().Format(time.RFC3339Nano)\r\n    72\t\tselect {\r\n    73\t\tcase l.ch <- entry:\r\n    74\t\tdefault:\r\n    75\t\t\tl.writeLine(entry)\r\n    76\t\t}\r\n    77\t}\r\n    78\t\r\n    79\t// Stop flushes all buffered entries and closes the log file.\r\n    80\tfunc (l *Logger) Stop() {\r\n    81\t\tl.stopOnce.Do(func() {\r\n    82\t\t\tatomic.StoreInt32(&l.stopped, 1)\r\n    83\t\t\tclose(l.stop)\r\n    84\t\t\t<-l.done\r\n    85\t\t\tl.mu.Lock()\r\n    86\t\t\tif l.file != nil {\r\n    87"]
[10613.859584, "o", "\t\t\t\tl.file.Close()\r\n    88\t\t\t\tl.file = nil\r\n    89\t\t\t}\r\n    90\t\t\tl.mu.Unlock()\r\n    91\t\t})\r\n    92\t}\r\n    93\t\r\n    94\tfunc (l *Logger) run() {\r\n    95\t\tfor {\r\n"]
[10613.859652, "o", "    96\t\t\tselect {\r\n    97\t\t\tcase e := <-l.ch:\r\n    98\t\t\t\tl.writeLine(e)\r\n    99\t\t\tcase <-l.stop:\r\n   100\t\t\t\tl.drain()\r\n   101\t\t\t\tclose(l.done)\r\n   102\t\t\t\treturn\r\n   103\t\t\t}\r\n   104\t\t}\r\n   105\t"]
[10613.859727, "o", "}\r\n   106\t\r\n   107\tfunc (l *Logger) drain() {\r\n   108\t\tfor {\r\n   109\t\t\tselect {\r\n"]
[10613.859801, "o", "   110\t\t\tcase e := <-l.ch:\r\n   111\t\t\t\tl.writeLine(e)\r\n   112\t\t\tdefault:\r\n   113\t\t\t\treturn\r\n   114\t\t\t}\r\n   115\t\t}\r\n   116\t}\r\n   117\t\r\n   118\tfunc (l *Logger) writeLine(e Entry) {\r\n   119\t\tb, err := json.Marshal(e)\r\n   120\t\tif err != nil {\r\n   121\t\t\treturn\r\n   122\t\t}\r\n   123\t\tb = append(b, '\\n')\r\n   124\t\r\n   125\t\t"]
[10613.859879, "o", "l.mu.Lock()\r\n   126\t\tdefer l.mu.Unlock()\r\n   127\t\r\n   128\t\tif l.file == nil {\r\n   129\t\t\tif err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {\r\n   130\t\t\t\treturn\r\n   131\t\t\t}\r\n   132\t\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n   133\t\t\tif err != nil {\r\n   134\t\t\t\treturn\r\n   135\t\t\t}\r\n   136"]
[10613.85997, "o", "\t\t\tl.file = f\r\n   137\t\t\tif info, err := f.Stat(); err == nil {\r\n   138\t\t\t\tl.size = info.Size()\r\n   139\t\t\t}\r\n   140\t\t}\r\n   141\t\r\n   142\t\tif l.size > 0 && l.size+int64(len(b)) > maxFileSize {\r\n   143\t\t\tl.rotateLocked()\r\n   144\t\t}\r\n   145\t\r\n   146\t\tn, err := l.file.Write(b)\r\n   147\t\tif err != nil {\r\n"]
[10613.860038, "o", "   148\t\t\tl.size = 0\r\n   149\t\t\tif l.file != nil {\r\n   150\t\t\t\tl.file.Close()\r\n   151\t\t\t\tl.file = nil\r\n   152\t\t\t}\r\n   153\t\t\treturn\r\n   154\t\t}\r\n   155\t\tl.size += int64(n)\r\n   156\t}\r\n"]
[10613.860111, "o", "   157\t\r\n   158\tfunc (l *Logger) rotateLocked() {\r\n   159\t\tif l.file != nil {\r\n   160\t\t\tl.file.Close()\r\n   161\t\t\tl.file = nil"]
[10613.860187, "o", "\r\n   162\t\t}\r\n   163\t\tos.Remove(l.path + \".1\")\r\n   164\t\tif err := os.Rename(l.path, l.path+\".1\"); err != nil {\r\n   165\t\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n   166\t\t\tif err == nil {\r\n   167\t\t\t\tl.file = f\r\n   168\t\t\t\tif info, err := f.Stat(); err == nil {\r\n   169\t\t\t\t\tl.size = info.Size()\r\n   170\t\t\t\t}\r\n   171\t\t\t}\r\n   172\t\t\treturn\r\n   173\t\t}\r\n   174\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n   175\t\tif err != nil {\r\n   176\t\t\tl.size = 0\r\n"]
[10613.860255, "o", "   177\t\t\treturn\r\n   178\t\t}\r\n   179\t\tl.file = f\r\n   180\t\tl.size = 0\r\n   181\t}\r\n"]
