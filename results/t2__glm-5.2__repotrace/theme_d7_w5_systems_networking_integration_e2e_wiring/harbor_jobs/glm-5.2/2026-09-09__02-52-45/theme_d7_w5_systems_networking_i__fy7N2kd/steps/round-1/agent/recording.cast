[5940.361546, "o", "\"sort\"\r\n     5\t\t\"time\"\r\n     6\t\r\n     7\t\t\"meshrouter/internal/stats\"\r\n     8\t)\r\n     9\t\r\n    10\ttype EndpointView struct {\r\n    11\t\tAddress           string `json:\"address\"`\r\n    12\t\tState             string `json:\"state\"`\r\n    13\t\tWeight            int    `json:\"weight\"`\r\n    14\t\tActiveConnections int    `json:\"active_connections\"`\r\n    15\t\tCircuitState      string `json:\"circuit_state\"`\r\n    16\t}\r\n    17\t\r\n    18\ttype ServiceView struct {\r\n    19\t\tName          string         `json:\"name\"`\r\n    20\t\tListenPort    int            `json:\"listen_port\"`\r\n    21\t\tRoutingMode   string         `json:\"routing_mode\"`\r\n    22\t\tIdleTimeoutMs int            `json:\"idle_timeout_ms\"`\r\n"]
[5940.361606, "o", "    23\t\tEndpoints     []EndpointView `json:\"endpoints\"`\r\n    24\t}\r\n    25\t\r\n"]
[5940.36166, "o", "    26\tfunc (s *State) ServiceView(name string) (ServiceView, bool) {\r\n    27\t\tss := s.GetService(name)\r\n    28\t\tif ss == nil {\r\n    29\t\t\treturn ServiceView{}, false\r\n    30\t\t}\r\n    31\t\treturn ss.View(), true\r\n    32\t}\r\n    33\t\r\n    34\tfunc (s *State) ServicesView() []ServiceView {\r\n    35\t\tservices := s.Services()\r\n"]
[5940.361715, "o", "    36\t\tout := make([]ServiceView, 0, len(services))\r\n    37\t\tfor _, ss := range services {\r\n    38\t\t\tout = append(out, ss.View())\r\n    39\t\t}\r\n    40\t\tsort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })\r\n    41\t\treturn out\r\n    42\t}\r\n    43\t\r\n    44\tfunc (ss *ServiceState) View() ServiceView {\r\n    45\t\tss.mu.Lock()\r\n    46\t\tdefer ss.mu.Unlock()\r\n    47\t\tsv := ServiceView{\r\n    48\t\t\tName:          ss.Name,\r\n"]
[5940.361767, "o", "    49\t\t\tListenPort:    ss.ListenPort,\r\n    50\t\t\tRoutingMode:   ss.RoutingMode,\r\n    51\t\t\t"]
[5940.361817, "o", "IdleTimeoutMs: ss.IdleTimeoutMs,\r\n    52\t\t\tEndpoints:     make([]EndpointView, 0, len(ss.Endpoints)),\r\n    53\t\t}\r\n    54\t\tfor _, ep := range ss.Endpoints {\r\n    55\t\t\tep.mu.Lock()\r\n    56\t\t\tsv.Endpoints = append(sv.Endpoints, EndpointView{\r\n    57\t\t\t\tAddress:           ep.Address,\r\n    58\t\t\t\tState:             string(ep.State),\r\n"]
[5940.361871, "o", "    59\t\t\t\tWeight:            ep.Weight,\r\n    60\t\t\t\tActiveConnections: ep.ActiveConnections,\r\n    61\t\t\t\tCircuitState:      string(ep.Circuit.State()),\r\n    62\t\t\t})\r\n    63\t\t\tep.mu.Unlock()\r\n    64\t\t}\r\n    65\t\treturn sv\r\n"]
[5940.361921, "o", "    66\t}\r\n    67\t\r\n    68\ttype StatsEndpointView struct {\r\n    69\t\tAddress string `json:\"address\"`\r\n    70\t\tstats.Snapshot\r\n    71\t}\r\n    72\t\r\n    73\ttype StatsView struct {\r\n    74\t\t"]
[5940.36197, "o", "Service   string              `json:\"service\"`\r\n    75\t\tWindowSec int                 `json:\"window_sec\"`\r\n    76\t\tEndpoints []StatsEndpointView `json:\"endpoints\"`\r\n    77\t}\r\n    78\t\r\n    79\tfunc (s *State) StatsView(name string, windowSec int) (StatsView, bool) {\r\n    80\t\tss := s.GetService(name)\r\n"]
[5940.36202, "o", "    81\t\tif ss == nil {\r\n    82\t\t\treturn StatsView{}, false\r\n    83\t\t}\r\n    84\t\tsv := StatsView{\r\n    85\t\t\tService:   name,\r\n    86\t\t\tWindowSec: windowSec,\r\n    87\t\t\tEndpoints: make([]StatsEndpointView, 0),\r\n    88\t\t}\r\n    89\t\tss.mu.Lock()\r\n    90\t\t"]
[5940.362069, "o", "for _, ep := range ss.Endpoints {\r\n    91\t\t\tep.mu.Lock()\r\n    92\t\t\tsv.Endpoints = append(sv.Endpoints, StatsEndpointView{\r\n    93\t\t\t\tAddress:  ep.Address,\r\n    94\t\t\t\tSnapshot: ep.Stats.Snapshot(ep.ActiveConnections),\r\n    95\t\t\t})\r\n    96\t\t\tep.mu.Unlock()\r\n    97\t"]
[5940.36212, "o", "\t}\r\n    98\t\tss.mu.Unlock()\r\n    99\t\treturn sv, true\r\n   100\t}\r\n   101\t\r\n   102\ttype HealthEventView struct {\r\n   103\t\tTimestamp   time.Time `json:\"timestamp\"`\r\n   104\t\tEndpoint    string    `json:\"endpoint\"`\r\n   105\t\tOldState    string    `json:\"old_state\"`\r\n   106\t\tNewState    string    `json:\"new_state\"`\r\n"]
[5940.362168, "o", "   107\t\tCheckResult string    `json:\"check_result\"`\r\n   108\t}\r\n   109\t\r\n   110\tfunc (s *State) HealthLogView(name string, lastN int) []HealthEventView {\r\n   111\t\tevents := s.HealthLog(name, lastN)\r\n   112\t\tout := make([]HealthEventView, 0, len(events))\r\n   113\t\tfor _, e := range events {\r\n"]
[5940.362218, "o", "   114\t\t\tout = append(out, HealthEventView{\r\n   115\t\t\t\tTimestamp:   e.Timestamp,\r\n   116\t\t\t\tEndpoint:    e.Endpoint,\r\n   117\t\t\t\tOldState:    string(e.OldState),\r\n"]
[5940.362268, "o", "   118\t\t\t\tNewState:    string(e.NewState),\r\n   119\t\t\t\tCheckResult: e.CheckResult,\r\n   120\t\t\t})\r\n   121\t\t}\r\n   122\t\treturn out\r\n   123\t}\r\n   124\t\r\n"]
[5940.362317, "o", "   125\ttype CircuitView struct {\r\n   126\t\tAddress             string `json:\"address\"`\r\n   127\t\tCircuitState        string `json:\"circuit_state\"`\r\n   128\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n   129\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n   130\t\tProbeActive         bool   `json:\"probe_active\"`\r\n   131\t}\r\n   132\t\r\n   133\tfunc (s *State) CircuitsView(name string) ([]CircuitView, bool) {\r\n"]
[5940.362367, "o", "   134\t\tss := s.GetService(name)\r\n   135\t\tif ss == nil {\r\n   136\t\t\treturn nil, false\r\n   137\t\t}\r\n   138\t\tss.mu.Lock()\r\n   139\t\tout := make([]CircuitView, 0, len(ss.Endpoints))\r\n   140\t\tfor _, ep := range ss.Endpoints {\r\n   141\t\t\tep.mu.Lock()\r\n"]
[5940.362427, "o", "   142\t\t\tout = append(out, CircuitView{\r\n   143\t\t\t\tAddress:             ep.Address,\r\n   144\t\t\t\tCircuitState:        string(ep.Circuit.State()),\r\n   145\t\t\t\tConsecutiveFailures: ep.Circuit.ConsecutiveFailures(),\r\n   146\t\t\t\tTimeInStateMs:       ep.Circuit.TimeInStateMs(),\r\n   147\t\t\t\tProbeActive:         ep.Circuit.ProbeActive(),\r\n   148\t\t\t})\r\n   149\t\t\tep.mu.Unlock()\r\n"]
[5940.362485, "o", "   150\t\t}\r\n   151\t\tss.mu.Unlock()\r\n   152\t\treturn out, true\r\n   153\t}\r\n   154\t\r\n   155\tfunc (s *State) ResolveEndpoint(service string) (string, error) {\r\n   156"]
[5940.362543, "o", "\t\tss := s.GetService(service)\r\n   157\t\tif ss == nil {\r\n   158\t\t\treturn \"\", errNotFound(\"service not found\")\r\n   159\t\t}\r\n   160\t\tss.mu.Lock()\r\n   161\t\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n   162\t\t"]
[5940.362596, "o", "mode := ss.RoutingMode\r\n   163\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n   164\t\tcopy(endpoints, ss.Endpoints)\r\n   165\t\tss.mu.Unlock()\r\n   166\t\r\n   167\t\tvar regular []*EndpointState\r\n   168\t\tfor _, ep := range endpoints {\r\n   169\t\t\tif ep.IsEligible(maxConns) {\r\n   170\t\t\t"]
[5940.362611, "o", "\tregular = append(regular, ep)\r\n   171\t\t\t}\r\n   172\t\t}\r\n   173\t\r\n   174\t\tif len(regular) > 0 {\r\n   175\t\t\tif mode == \"least-connections\" {\r\n   176\t\t\t\tep := selectLeastConnections(regular, maxConns)\r\n   177\t\t\t\treturn ep.Address, nil\r\n"]
[5940.362682, "o", "   178\t\t\t}\r\n   179\t\t\tvar best *EndpointState\r\n   180\t\t\tvar bestWeight int\r\n   181\t\t\tfor _, ep := range regular {\r\n   182\t\t\t\tep.mu.Lock()\r\n   183\t\t\t\tcw := ep.currentWeight + ep.Weight\r\n   184\t\t\t\tep.mu.Unlock()\r\n   185\t\t\t\tif best == nil || cw > bestWeight {\r\n   186\t\t\t\t\tbest = ep\r\n   187\t\t\t\t\tbestWeight = cw\r\n   188\t\t\t\t}\r\n"]
[5940.362731, "o", "   189\t\t\t}\r\n   190\t\t\tif best != nil {\r\n"]
[5940.362781, "o", "   191\t\t\t\treturn best.Address, nil\r\n   192\t\t\t}\r\n   193\t\t}\r\n   194\t\r\n   195\t\tfor _, ep := range endpoints {\r\n   196\t\t\tep.mu.Lock()\r\n   197\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns && !ep.Circuit.ProbeActive()\r\n"]
[5940.362796, "o", "   198\t\t\tep.mu.Unlock()\r\n   199\t\t\tif halfOpen {\r\n   200\t\t\t\treturn ep.Address, nil\r\n   201\t\t\t}\r\n   202\t\t}\r\n   203\t\treturn \"\", errNotFound(\"no eligible endpoints\")\r\n   204\t}\r\n"]
