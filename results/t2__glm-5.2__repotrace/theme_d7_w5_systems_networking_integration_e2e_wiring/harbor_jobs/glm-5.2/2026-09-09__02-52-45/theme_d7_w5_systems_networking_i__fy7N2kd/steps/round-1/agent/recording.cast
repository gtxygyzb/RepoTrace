[1460.75149, "o", "            fmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")\r\n\u001b[?2004l\r"]
[1460.751551, "o", "\u001b[?2004h> "]
[1460.751686, "o", "            os.Exit(1)\r\n\u001b[?2004l\r"]
[1460.75174, "o", "\u001b[?2004h> "]
[1460.751798, "o", "        }\r\n\u001b[?2004l\r"]
