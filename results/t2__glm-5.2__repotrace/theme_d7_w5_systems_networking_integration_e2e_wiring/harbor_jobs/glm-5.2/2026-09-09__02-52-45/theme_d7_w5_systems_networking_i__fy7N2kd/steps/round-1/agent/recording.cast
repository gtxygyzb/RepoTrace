[12921.34448, "i", "cat go.mod\n"]
[12921.344705, "o", "cat go.mod\r\n\u001b[?2004l\r"]
[12921.347085, "o", "module meshrouter\r\n\r\ngo 1.18\r\n\r\nrequire github.com/BurntSushi/toml v1.3.2\r\n"]
[12921.347545, "o", "\u001b[?2004h"]
[12921.347611, "o", "root@n30009:/app# "]
[12940.336335, "i", "sed -n '1,240p' internal/circuit/breaker.go\n"]
[12940.336783, "o", "sed -n '1,240p' internal/circuit/breaker.go\r\n\u001b[?2004l\r"]
[12940.339784, "o", "package circuit\r\n\r\nimport (\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\n"]
[12940.339865, "o", "type State string\r\n\r\nconst (\r\n\tClosed   State = \"closed\"\r\n\tOpen     State = \"open\"\r\n\tHalfOpen State = \"half_open\"\r\n)\r\n\r\n// Breaker implements an endpoint circuit breaker.\r\ntype Breaker struct {\r\n\tmu                  sync.Mutex\r\n\tstate               State\r\n\tconsecutiveFailures int\r\n\tstateChangedAt      time.Time\r\n\topenedAt            time.Time\r\n\ttimeout             time.Duration\r\n\tprobeActive         bool\r\n}"]
[12940.339942, "o", "\r\n\r\n// New creates a closed breaker with the given open timeout.\r\nfunc New(timeout time.Duration) *Breaker {\r\n\tnow := time.Now()\r\n\treturn &Breaker{\r\n\t\tstate:          Closed,\r\n\t\tstateChangedAt: now,\r\n\t\topenedAt:       now,\r\n\t\ttimeout:        timeout,\r\n\t}\r\n}\r\n\r\n// State returns the current state.\r\n"]
[12940.340017, "o", "func (b *Breaker) State() State {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\treturn b.state\r\n}\r\n\r\n// IsClosed returns true if the breaker is closed.\r\nfunc (b *Breaker) IsClosed() bool {\r\n\treturn b.State() == Closed\r\n}"]
[12940.340079, "o", "\r\n\r\n// IsOpen returns true if the breaker is open.\r\nfunc (b *Breaker) IsOpen() bool {\r\n\treturn b.State() == Open\r\n}\r\n\r\n// IsHalfOpen returns true if the breaker is half-open.\r\nfunc (b *Breaker) IsHalfOpen() bool {\r\n\treturn b.State() == HalfOpen\r\n}\r\n\r\n// Open forces the breaker open and restarts the timeout clock.\r\nfunc (b *Breaker) Open() {\r\n"]
[12940.340139, "o", "\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tnow := time.Now()\r\n\tb.state = Open\r\n\tb.stateChangedAt = now\r\n\tb.openedAt = now\r\n\tb.consecutiveFailures++\r\n\tb.probeActive = false\r\n}\r\n\r\n// MaybeHalfOpen transitions from open to half_open if the timeout has elapsed.\r\nfunc (b *Breaker) MaybeHalfOpen() bool {\r\n"]
[12940.340203, "o", "\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tif b.state == Open && time.Since(b.openedAt) >= b.timeout {\r\n\t\tb.state = HalfOpen\r\n\t\tb.stateChangedAt = time.Now()\r\n\t\tb.probeActive = false\r\n\t\treturn true\r\n\t}\r\n\treturn false\r\n"]
[12940.340268, "o", "}\r\n\r\n// AcquireProbe attempts to take the single allowed half-open probe connection.\r\nfunc (b *Breaker) AcquireProbe() bool {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tif b.state == HalfOpen && !b.probeActive {\r\n\t\tb.probeActive = true\r\n\t\treturn true\r\n\t}\r\n"]
[12940.340331, "o", "\treturn false\r\n}\r\n\r\n// ProbeSuccess closes the circuit and clears failure counts.\r\nfunc (b *Breaker) ProbeSuccess() {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tnow := time.Now()\r\n\tb.state = Closed\r\n\tb.stateChangedAt = now\r\n\tb.consecutiveFailures = 0\r\n\tb.probeActive = false\r\n"]
[12940.340407, "o", "}\r\n\r\n// ProbeFailure reopens the circuit and restarts the timeout.\r\nfunc (b *Breaker) ProbeFailure() {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n"]
[12940.340472, "o", "\tnow := time.Now()\r\n\tb.state = Open\r\n\tb.stateChangedAt = now\r\n\tb.openedAt = now\r\n\tb.consecutiveFailures++\r\n\tb.probeActive = false\r\n}\r\n\r\n// Reset forces the breaker closed and clears failure counts.\r\nfunc (b *Breaker) Reset() {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tnow := time.Now()\r\n\tb.state = Closed\r\n\tb.stateChangedAt = now\r\n\tb.openedAt = now\r\n\tb.consecutiveFailures = 0\r\n"]
[12940.340535, "o", "\tb.probeActive = false\r\n}\r\n\r\n// ConsecutiveFailures returns the current failure count.\r\nfunc (b *Breaker) ConsecutiveFailures() int {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\treturn b.consecutiveFailures\r\n}\r\n\r\n// TimeInStateMs returns milliseconds since the last state transition.\r\nfunc (b *Breaker) TimeInStateMs() int64 {\r\n\tb.mu.Lock()\r\n"]
[12940.340596, "o", "\tdefer b.mu.Unlock()\r\n\treturn time.Since(b.stateChangedAt).Milliseconds()\r\n}\r\n\r\n// ProbeActive returns whether a probe connection is currently active.\r\nfunc (b *Breaker) ProbeActive() bool {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\treturn b.probeActive\r\n}\r\n"]
[12940.341114, "o", "\u001b[?2004h"]
[12940.341172, "o", "root@n30009:/app# "]
[12940.618875, "i", "sed -n '1,260p' internal/config/config.go\n"]
[12940.619227, "o", "sed -n '1,260p' internal/config/config.go\r\n"]
[12940.619319, "o", "\u001b[?2004l\r"]
[12940.622244, "o", "package config\r\n\r\nimport (\r\n\t\"log\"\r\n\r\n\t\"github.com/BurntSushi/toml\"\r\n"]
[12940.622323, "o", ")\r\n\r\n// Global holds mesh-wide tuning parameters.\r\ntype Global struct {\r\n\tHealthIntervalMs        int `toml:\"health_interval_ms\"`\r\n\tUnhealthyThreshold      int `toml:\"unhealthy_threshold\"`\r\n\tHealthyThreshold        int `toml:\"healthy_threshold\"`\r\n\tStatsWindowSec          int `toml:\"stats_window_sec\"`\r\n\tCircuitBreakerThreshold int `toml:\"circuit_breaker_threshold\"`\r\n\tCircuitBreakerTimeoutMs int `toml:\"circuit_breaker_timeout_ms\"`\r\n}\r\n\r\n// Endpoint describes one backend endpoint from config.\r\ntype Endpoint struct {\r\n\tAddress          string `toml:\"address\"`\r\n"]
[12940.622404, "o", "\tWeight           int    `toml:\"weight\"`\r\n\tWarmupDurationMs int    `toml:\"warmup_duration_ms\"`\r\n\tHealthCheck      string `toml:\"health_check\"`\r\n\tHealthPath       string `toml:\"health_path\"`\r\n\tHealthCmd        string `toml:\"health_cmd\"`\r\n"]
[12940.622471, "o", "}\r\n\r\n// Service describes one routed service from config.\r\ntype Service struct {\r\n\tName                      string     `toml:\"name\"`\r\n\tListenPort                int        `toml:\"listen_port\"`\r\n\tRoutingMode               string     `toml:\"routing_mode\"`\r\n\tDrainTimeoutMs            int        `toml:\"drain_timeout_ms\"`\r\n\tMaxConnectionsPerEndpoint int        `toml:\"max_connections_per_endpoint\"`\r\n\tConnectionLimitMode       string     `toml:\"connection_limit_mode\"`\r\n\tRateLimitRps              int        `toml:\"rate_limit_rps\"`\r\n\tRateLimitBurst            int        `toml:\"rate_limit_burst\"`\r\n\tRateLimitQueueDepth       int        `toml:\"rate_limit_queue_depth\"`\r\n\tRateLimitQueueTimeoutMs   int        `toml:\"rate_limit_queue_timeout_ms\"`\r\n"]
[12940.622537, "o", "\tMaxRetries                int        `toml:\"max_retries\"`\r\n\tRetryDelayMs              int        `toml:\"retry_delay_ms\"`\r\n\tRetryBackoffMultiplier    float64    `toml:\"retry_backoff_multiplier\"`\r\n\tRetryMaxDelayMs           int        `toml:\"retry_max_delay_ms\"`\r\n\tIdleTimeoutMs             int        `toml:\"idle_timeout_ms\"`\r\n\tDependsOn                 []string   `toml:\"depends_on\"`\r\n\tEndpoints                 []Endpoint `toml:\"endpoint\"`\r\n}\r\n\r\n// Config is the parsed application configuration.\r\ntype Config struct {\r\n\tGlobal   Global\r\n"]
[12940.622599, "o", "\tServices []Service `toml:\"service\"`\r\n}\r\n\r\n// Load reads and normalizes a TOML config file.\r\nfunc Load(path string) (*Config, error) {\r\n\tvar cfg Config\r\n\tif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif cfg.Global.HealthIntervalMs <= 0 {\r\n\t\t"]
[12940.622669, "o", "cfg.Global.HealthIntervalMs = 2000\r\n\t}\r\n\tif cfg.Global.UnhealthyThreshold <= 0 {\r\n\t\tcfg.Global.UnhealthyThreshold = 3\r\n\t}\r\n\tif cfg.Global.HealthyThreshold <= 0 {\r\n\t\tcfg.Global.HealthyThreshold = 2\r\n\t}\r\n\tif cfg.Global.StatsWindowSec <= 0 {\r\n\t\tcfg.Global.StatsWindowSec = 60\r\n\t}\r\n"]
[12940.622726, "o", "\tif cfg.Global.CircuitBreakerThreshold <= 0 {\r\n\t\tcfg.Global.CircuitBreakerThreshold = 3\r\n\t}\r\n\tif cfg.Global.CircuitBreakerTimeoutMs <= 0 {\r\n\t\tcfg.Global.CircuitBreakerTimeoutMs = 5000\r\n\t}\r\n\tfor i := range cfg.Services {\r\n"]
[12940.622785, "o", "\t\ts := &cfg.Services[i]\r\n\t\tif s.RoutingMode == \"\" {\r\n\t\t\ts.RoutingMode = \"weighted-round-robin\"\r\n\t\t}\r\n\t\tif s.DrainTimeoutMs <= 0 {\r\n\t\t\ts.DrainTimeoutMs = 5000\r\n\t\t}\r\n\t\t"]
[12940.622848, "o", "if s.MaxConnectionsPerEndpoint <= 0 {\r\n\t\t\ts.MaxConnectionsPerEndpoint = 100\r\n\t\t}\r\n\t\tif s.ConnectionLimitMode == \"\" {\r\n\t\t\ts.ConnectionLimitMode = \"per-endpoint\"\r\n\t\t}\r\n\t"]
[12940.622904, "o", "\tif s.RateLimitBurst <= 0 {\r\n\t\t\ts.RateLimitBurst = s.RateLimitRps\r\n\t\t}\r\n\t\tif s.RateLimitQueueTimeoutMs <= 0 {\r\n\t\t\ts.RateLimitQueueTimeoutMs = 1000\r\n\t\t}\r\n"]
[12940.622972, "o", "\t\tif s.RetryDelayMs <= 0 {\r\n\t\t\ts.RetryDelayMs = 100\r\n\t\t}\r\n\t\tif s.RetryBackoffMultiplier <= 0 {\r\n\t\t\ts.RetryBackoffMultiplier = 2.0\r\n\t\t}\r\n"]
[12940.623034, "o", "\t\tif s.RetryMaxDelayMs <= 0 {\r\n\t\t\ts.RetryMaxDelayMs = 5000\r\n\t\t}\r\n\t\tfor j := range s.Endpoints {\r\n\t\t\tep := &s.Endpoints[j]\r\n\t\t\tif ep.HealthCheck == \"\" {\r\n\t\t\t\tep.HealthCheck = \"tcp\"\r\n\t\t\t}\r\n\t\t\tif ep.Weight < 0 {\r\n\t\t\t\tep.Weight = 0\r\n\t\t\t}\r\n\t\t\tif ep.WarmupDurationMs < 0 {\r\n\t\t\t\tep.WarmupDurationMs = 0\r\n"]
[12940.623096, "o", "\t\t\t}\r\n\t\t}\r\n\t\tif s.DependsOn == nil {\r\n\t\t\ts.DependsOn = []string{}\r\n\t\t}\r\n\t}\r\n\tcfg.Services = removeDependencyCycles(cfg.Services)\r\n\treturn &cfg, nil\r\n}\r\n\r\n"]
[12940.623155, "o", "// removeDependencyCycles drops dependency edges that would create cycles.\r\nfunc removeDependencyCycles(services []Service) []Service {\r\n\tbyName := make(map[string]int, len(services))\r\n\tfor i, svc := range services {\r\n\t\tbyName[svc.Name] = i\r\n\t}\r\n\tfor i := range services {\r\n\t\tseen := map[string]bool{services[i].Name: true}\r\n\t\tkept := make([]string, 0, len(services[i].DependsOn))\r\n\t\t"]
[12940.623214, "o", "for _, dep := range services[i].DependsOn {\r\n\t\t\tif dep == services[i].Name {\r\n\t\t\t\tlog.Printf(\"warning: dropping self dependency from %s to %s\", services[i].Name, dep)\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif _, ok := byName[dep]; !ok {\r\n\t\t\t\tkept = append(kept, dep)\r\n"]
[12940.623271, "o", "\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tif createsCycle(services, byName, seen, services[i].Name, dep) {\r\n\t\t\t\tlog.Printf(\"warning: dropping dependency edge from %s to %s to avoid circular dependency\", services[i].Name, dep)\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tkept = append(kept, dep)\r\n\t\t}\r\n\t\tservices[i].DependsOn = kept\r\n"]
[12940.623327, "o", "\t}\r\n\treturn services\r\n}\r\n\r\nfunc createsCycle(services []Service, byName map[string]int, seen map[string]bool, start, dep string) bool {\r\n\tif seen[dep] {\r\n\t\treturn true\r\n\t}\r\n\tseen[dep] = true\r\n\tdefer delete(seen, dep)\r\n\tnext := services[byName[dep]].DependsOn\r\n\tfor _, d := range next {\r\n\t"]
[12940.623398, "o", "\tif d == start || d == dep {\r\n\t\t\treturn true\r\n\t\t}\r\n\t\tif _, ok := byName[d]; !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif createsCycle(services, byName, seen, start, d) {\r\n\t\t\treturn true\r\n"]
[12940.62346, "o", "\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n"]
[12940.62393, "o", "\u001b[?2004h"]
[12940.623986, "o", "root@n30009:/app# "]
[12940.904487, "i", "sed -n '1,340p' internal/state/state.go\n"]
[12940.90484, "o", "sed -n '1,340p' internal/state/state.go\r\n"]
[12940.904922, "o", "\u001b[?2004l\r"]
[12940.908082, "o", "package state\r\n\r\nimport (\r\n\t\"net\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n\t\"sync/atomic\"\r\n"]
[12940.908151, "o", "\t\"time\"\r\n\r\n\t\"meshrouter/internal/circuit\"\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/stats\"\r\n)\r\n\r\ntype HealthState string\r\n\r\nconst (\r\n\tUnknown   HealthState = \"unknown\"\r\n\tHealthy   HealthState = \"healthy\"\r\n\tUnhealthy HealthState = \"unhealthy\"\r\n\tDraining  HealthState = \"draining\"\r\n)\r\n"]
[12940.908269, "o", "\r\ntype HealthEvent struct {\r\n\tTimestamp   time.Time\r\n\tEndpoint    string\r\n\tOldState    HealthState\r\n\tNewState    HealthState\r\n\tCheckResult string\r\n}\r\n\r\ntype EndpointState struct {\r\n\tmu                sync.Mutex\r\n\tAddress           string\r\n\tWeight            int\r\n\tConfig            config.Endpoint\r\n"]
[12940.90836, "o", "\tState             HealthState\r\n\tActiveConnections int\r\n\tCircuit           *circuit.Breaker\r\n\tStats             *stats.Collector\r\n"]
[12940.908453, "o", "\tconsecSuccess     int\r\n\tconsecFailures    int\r\n\tdrainDeadline     time.Time\r\n\tremoved           bool\r\n\tconnIDCounter     int64\r\n\tcurrentWeight     int\r\n\tWarmupDurationMs  int\r\n\twarmupUntil       time.Time\r\n"]
[12940.908525, "o", "\tconnections       map[int64]*connectionInfo\r\n}\r\n\r\ntype connectionInfo struct {\r\n\tconn         net.Conn\r\n\tclientAddr   string\r\n\tstart        time.Time\r\n\tlastActivity time.Time\r\n\tbytesIn      int64\r\n\tbytesOut     int64\r\n}\r\n\r\ntype ServiceState struct {\r\n\tmu                        sync.Mutex\r\n\tName                      string\r\n\tListenPort                int\r\n\tRoutingMode               string\r\n"]
[12940.908558, "o", "\tDrainTimeoutMs            int\r\n\tMaxConnectionsPerEndpoint int\r\n\tConnectionLimitMode       string\r\n\tIdleTimeoutMs             int\r\n\tRateLimitRps              int\r\n\tRateLimitBurst            int\r\n\t"]
[12940.908691, "o", "RateLimitQueueDepth       int\r\n\tRateLimitQueueTimeoutMs   int\r\n\tMaxRetries                int\r\n\tRetryDelayMs              int\r\n\tRetryBackoffMultiplier    float64\r\n\tRetryMaxDelayMs           int\r\n\tDependsOn                 []string\r\n\tStats                     *stats.Collector\r\n\trateLimiter               *rateLimiter\r\n\tEndpoints                 []*EndpointState\r\n\trrIndex                   int\r\n\tListener                  net.Listener\r\n\tlistenerStop              chan struct{}\r\n\tstopping                  bool\r\n}\r\n\r\ntype State struct {\r\n\tmu         sync.RWMutex\r\n\tconfigPath string\r\n\tglobal     config.Global\r\n"]
[12940.908747, "o", "\tservices   map[string]*ServiceState\r\n\tlogMu      sync.Mutex\r\n\thealthLog  map[string][]HealthEvent\r\n\treloadCh   chan struct{}\r\n}\r\n\r\nfunc NewState(cfg *config.Config, path string) *State {\r\n\ts := &State{\r\n\t\tconfigPath: path,\r\n\t\tservices:   make(map[string]*ServiceState),\r\n\t\thealthLog:  make(map[string][]HealthEvent),\r\n\t\treloadCh:   make(chan struct{}, 1),\r\n\t}\r\n\ts.applyConfigLocked(cfg)\r\n\treturn s\r\n}\r\n"]
[12940.908844, "o", "\r\nfunc (s *State) ReloadChan() <-chan struct{} {\r\n\treturn s.reloadCh\r\n}\r\n\r\nfunc (s *State) ConfigPath() string {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.configPath\r\n}\r\n\r\nfunc (s *State) Global() config.Global {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.global\r\n}\r\n\r\nfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n\ts.mu.Lock()\r\n"]
[12940.90891, "o", "\tdefer s.mu.Unlock()\r\n\ts.applyConfigLocked(cfg)\r\n\tselect {\r\n\tcase s.reloadCh <- struct{}{}:\r\n\tdefault:\r\n\t}\r\n}\r\n\r\nfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n\ts.global = cfg.Global\r\n\tseen := make(map[string]bool)\r\n\tfor _, svc := range cfg.Services {\r\n\t\tseen[svc.Name] = true\r\n\t\tss := s.services[svc.Name]\r\n\t"]
[12940.908976, "o", "\tif ss == nil {\r\n\t\t\tss = newServiceState(svc, cfg.Global)\r\n\t\t\ts.services[svc.Name] = ss\r\n\t\t} else {\r\n\t\t\tss.mu.Lock()\r\n\t\t\tss.Name = svc.Name\r\n"]
[12940.909069, "o", "\t\t\tss.ListenPort = svc.ListenPort\r\n\t\t\tss.RoutingMode = svc.RoutingMode\r\n\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n\t\t\tss.RateLimitRps = svc.RateLimitRps\r\n\t\t\tss.RateLimitBurst = svc.RateLimitBurst\r\n\t\t\tss.RateLimitQueueDepth = svc.RateLimitQueueDepth\r\n\t\t\tss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs\r\n\t\t\tss.MaxRetries = svc.MaxRetries\r\n"]
[12940.909143, "o", "\t\t\tss.RetryDelayMs = svc.RetryDelayMs\r\n\t\t\tss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier\r\n\t\t\tss.RetryMaxDelayMs = svc.RetryMaxDelayMs\r\n\t\t\tss.DependsOn = svc.DependsOn\r\n\t\t\tif ss.rateLimiter == nil {\r\n\t\t\t\tss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n\t\t\t} else {\r\n\t\t\t\tss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n\t\t\t}\r\n\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n\t\t\t"]
[12940.909204, "o", "ss.ConnectionLimitMode = svc.ConnectionLimitMode\r\n\t\t\tss.IdleTimeoutMs = svc.IdleTimeoutMs\r\n\t\t\tss.mu.Unlock()\r\n\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n\t\t}\r\n\t}\r\n\tfor name, ss := range s.services {\r\n\t\tif !seen[name] {\r\n"]
[12940.909265, "o", "\t\t\tss.mu.Lock()\r\n\t\t\tss.stopping = true\r\n\t\t\tif ss.listenerStop != nil {\r\n\t\t\t\tclose(ss.listenerStop)\r\n\t\t\t\tss.listenerStop = nil\r\n\t\t\t}\r\n\t\t\tif ss.Listener != nil {\r\n"]
[12940.909329, "o", "\t\t\t\tss.Listener.Close()\r\n\t\t\t\tss.Listener = nil\r\n\t\t\t}\r\n\t\t\tss.mu.Unlock()\r\n\t\t\tfor _, ep := range ss.Endpoints {\r\n\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc newServiceState(svc config.Service, global config.Global) *ServiceState {\r\n"]
[12940.909407, "o", "\tss := &ServiceState{\r\n\t\tName:                      svc.Name,\r\n\t\tStats:                     stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n\t\tListenPort:                svc.ListenPort,\r\n\t\tRoutingMode:               svc.RoutingMode,\r\n\t\tDrainTimeoutMs:            svc.DrainTimeoutMs,\r\n\t\tRateLimitRps:              svc.RateLimitRps,\r\n\t\tRateLimitBurst:            svc.RateLimitBurst,\r\n"]
[12940.909494, "o", "\t\tRateLimitQueueDepth:       svc.RateLimitQueueDepth,\r\n\t\tRateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,\r\n\t\tMaxRetries:                svc.MaxRetries,\r\n\t\tRetryDelayMs:              svc.RetryDelayMs,\r\n\t\tRetryBackoffMultiplier:    svc.RetryBackoffMultiplier,\r\n\t\tRetryMaxDelayMs:           svc.RetryMaxDelayMs,\r\n\t\tDependsOn:                 svc.DependsOn,\r\n\t\trateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),\r\n\t\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n\t\tConnectionLimitMode:       svc.ConnectionLimitMode,\r\n\t\tIdleTimeoutMs:             svc.IdleTimeoutMs,\r\n\t\tlistenerStop:              nil,\r\n\t}\r\n\tfor _, ep := range svc.Endpoints {\r\n\t\t"]
[12940.909557, "o", "ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))\r\n\t}\r\n\treturn ss\r\n}\r\n\r\nfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n\tss.mu.Lock()\r\n\tdefer ss.mu.Unlock()\r\n\tseen := make(map[string]bool)\r\n\tfor _, cep := range eps {\r\n\t\tseen[cep.Address] = true\r\n\t\tvar ep *EndpointState\r\n"]
[12940.90961, "o", "\t\tfor _, existing := range ss.Endpoints {\r\n\t\t\tif existing.Address == cep.Address {\r\n\t\t\t\tep = existing\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif ep == nil {\r\n\t\t"]
[12940.909695, "o", "\tep = newEndpointState(cep, global)\r\n\t\t\tss.Endpoints = append(ss.Endpoints, ep)\r\n\t\t} else {\r\n\t\t\tep.mu.Lock()\r\n\t\t\tep.Config = cep\r\n\t\t\tep.Weight = cep.Weight\r\n\t\t\tep.WarmupDurationMs = cep.WarmupDurationMs\r\n\t\t\tep.mu.Unlock()\r\n\t\t}\r\n\t}\r\n\tfor _, ep := range ss.Endpoints {\r\n\t\tif !seen[ep.Address] {\r\n\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n\t\t}\r\n"]
[12940.909799, "o", "\t}\r\n}\r\n\r\nfunc newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {\r\n\treturn &EndpointState{\r\n\t\tAddress:          cep.Address,\r\n\t\tWeight:           cep.Weight,\r\n\t\tWarmupDurationMs: cep.WarmupDurationMs,\r\n\t\tConfig:           cep,\r\n\t\tState:            Unknown,\r\n\t\tCircuit:          circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n\t\tStats:            stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n\t\tconnections:      make(map[int64]*connectionInfo),\r\n"]
[12940.909866, "o", "\t}\r\n}\r\n\r\nfunc (s *State) GetService(name string) *ServiceState {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.services[name]\r\n}\r\n\r\nfunc (s *State) Services() []*ServiceState {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\tout := make([]*ServiceState, 0, len(s.services))\r\n\tfor _, ss := range s.services {"]
[12940.90993, "o", "\r\n\t\tout = append(out, ss)\r\n\t}\r\n\treturn out\r\n}\r\n\r\n// DependencyStatus describes a configured dependency.\r\ntype DependencyStatus struct {\r\n\tName             string `json:\"name\"`\r\n\tAvailable        bool   `json:\"available\"`\r\n"]
[12940.909989, "o", "\tHealthyEndpoints int    `json:\"healthy_endpoints\"`\r\n}\r\n\r\n// CheckDependency returns whether a dependency service is available and how\r\n// many of its endpoints are healthy with closed circuit breakers.\r\nfunc (s *State) CheckDependency(name string) (bool, int) {\r\n\tdep := s.GetService(name)\r\n\tif dep == nil {\r\n\t\treturn false, 0\r\n\t}\r\n\tdep.mu.Lock()\r\n\tdefer dep.mu.Unlock()\r\n"]
[12940.91007, "o", "\thealthy := 0\r\n\tfor _, ep := range dep.Endpoints {\r\n\t\tif ep.State == Healthy && ep.Circuit.IsClosed() {\r\n\t\t\thealthy++\r\n\t\t}\r\n\t}\r\n\treturn healthy > 0, healthy\r\n}\r\n\r\n// CheckDependencies returns the first unavailable dependency and the full\r\n// dependency status list for a service.\r\nfunc (s *State) CheckDependencies(service string) (string, []DependencyStatus) {\r\n\tss := s.GetService(service)\r\n\tif ss == nil {\r\n\t\t"]
[12940.91013, "o", "return \"\", nil\r\n\t}\r\n\tss.mu.Lock()\r\n\tdeps := ss.DependsOn\r\n\tss.mu.Unlock()\r\n\tif len(deps) == 0 {\r\n\t\treturn \"\", nil\r\n\t}\r\n\tvar statuses []DependencyStatus\r\n\tvar failed string\r\n"]
[12940.910222, "o", "\tfor _, dep := range deps {\r\n\t\tavailable, healthy := s.CheckDependency(dep)\r\n\t\tstatuses = append(statuses, DependencyStatus{Name: dep, Available: available, HealthyEndpoints: healthy})\r\n\t\tif failed == \"\" && !available {\r\n\t\t\tfailed = dep\r\n\t\t}\r\n\t}\r\n\treturn failed, statuses\r\n}\r\n\r\n// DependencyStatuses returns dependency status rows for a service.\r\nfunc (s *State) DependencyStatuses(service string) []DependencyStatus {\r\n\t_, statuses := s.CheckDependencies(service)\r\n\treturn statuses\r\n}\r\n\r\nfunc (s *State) GetEndpoint(service, address string) *EndpointState {\r\n\t"]
[12940.9103, "o", "ss := s.GetService(service)\r\n\tif ss == nil {\r\n\t\treturn nil\r\n\t}\r\n\tss.mu.Lock()\r\n"]
