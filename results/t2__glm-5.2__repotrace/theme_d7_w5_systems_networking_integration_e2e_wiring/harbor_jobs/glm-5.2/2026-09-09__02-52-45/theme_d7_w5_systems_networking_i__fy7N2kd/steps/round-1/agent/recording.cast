[11434.198252, "o", "\t\t\tfmt.Printf(\"%-18s %-18s %-9d %-9d %-10d %-10d\\n\", c.Endpoint, c.Client, c.AgeMs, c.IdleMs, c.BytesIn, c.BytesOut)\r\n\t\t}\r\n\t\t"]
[11434.198268, "o", "return \"\", nil\r\n\tcase \"get_access_log\":\r\n\t\tvar entries []struct {\r\n"]
[11434.19831, "o", "\t\t\tTs          string `json:\"ts\"`\r\n\t\t\tService     string `json:\"service\"`\r\n\t\t\tClient      string `json:\"client\"`\r\n\t\t\tEndpoint    string `json:\"endpoint\"`\r\n\t\t\tBytesIn     int64  `json:\"bytes_in\"`\r\n\t"]
