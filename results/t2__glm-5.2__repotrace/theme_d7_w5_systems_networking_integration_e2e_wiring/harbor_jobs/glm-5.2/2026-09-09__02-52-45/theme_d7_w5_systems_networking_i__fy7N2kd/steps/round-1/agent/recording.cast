[1952.293426, "o", "     1\tpackage config\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"github.com/BurntSushi/toml\"\r\n"]
[1952.293509, "o", "     5\t)\r\n     6\t\r\n     7\t// Global holds mesh-wide tuning parameters.\r\n     8\ttype Global struct {\r\n     9\t\tHealthIntervalMs        int `toml:\"health_interval_ms\"`\r\n    10\t\tUnhealthyThreshold      int `toml:\"unhealthy_threshold\"`\r\n    11\t\tHealthyThreshold        int `toml:\"healthy_threshold\"`\r\n    12\t\tStatsWindowSec          int `toml:\"stats_window_sec\"`\r\n    13\t\tCircuitBreakerThreshold int `toml:\"circuit_breaker_threshold\"`\r\n    14\t\tCircuitBreakerTimeoutMs int `toml:\"circuit_breaker_timeout_ms\"`\r\n    15\t}\r\n"]
[1952.293587, "o", "    16\t\r\n    17\t// Endpoint describes one backend endpoint from config.\r\n    18\ttype Endpoint struct {\r\n    19\t\tAddress     string `toml:\"address\"`\r\n    20\t\tWeight      int    `toml:\"weight\"`\r\n    21\t\tHealthCheck string `toml:\"health_check\"`\r\n    22\t\tHealthPath  string `toml:\"health_path\"`\r\n    23\t\tHealthCmd   string `toml:\"health_cmd\"`\r\n    24\t}\r\n    25\t\r\n    26\t// Service describes one routed service from config.\r\n"]
[1952.293683, "o", "    27\ttype Service struct {\r\n    28\t\tName                      string     `toml:\"name\"`\r\n    29\t\tListenPort                int        `toml:\"listen_port\"`\r\n    30\t\tRoutingMode               string     `toml:\"routing_mode\"`\r\n    31\t\tDrainTimeoutMs            int        `toml:\"drain_timeout_ms\"`\r\n    32\t\tMaxConnectionsPerEndpoint int        `toml:\"max_connections_per_endpoint\"`\r\n    33\t\tEndpoints                 []Endpoint `toml:\"endpoint\"`\r\n    34\t}\r\n    35\t\r\n    36\t// Config is the parsed application configuration.\r\n    37\ttype Config struct {\r\n    38\t\tGlobal   Global\r\n    39\t\tServices []Service `toml:\"service\"`\r\n    40\t}\r\n    41\t\r\n"]
[1952.293752, "o", "    42\t// Load reads and normalizes a TOML config file.\r\n    43\tfunc Load(path string) (*Config, error) {\r\n    44\t\tvar cfg Config\r\n    45\t\tif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\n    46\t\t\treturn nil, err\r\n    47\t\t}\r\n    48\t\tif cfg.Global.HealthIntervalMs <= 0 {\r\n    49\t\t\tcfg.Global.HealthIntervalMs = 2000\r\n    50\t\t}\r\n    51\t\tif cfg.Global.UnhealthyThreshold <= 0 {\r\n    52\t\t"]
[1952.293817, "o", "\tcfg.Global.UnhealthyThreshold = 3\r\n    53\t\t}\r\n    54\t\tif cfg.Global.HealthyThreshold <= 0 {\r\n    55\t\t\tcfg.Global.HealthyThreshold = 2\r\n    56\t\t}\r\n    57\t\tif cfg.Global.StatsWindowSec <= 0 {\r\n    58\t\t\tcfg.Global.StatsWindowSec = 60\r\n    59\t\t}\r\n    60\t\tif cfg.Global.CircuitBreakerThreshold <= 0 {\r\n"]
[1952.293875, "o", "    61\t\t\tcfg.Global.CircuitBreakerThreshold = 3\r\n    62\t\t}\r\n    63\t\tif cfg.Global.CircuitBreakerTimeoutMs <= 0 {\r\n    64\t\t\tcfg.Global.CircuitBreakerTimeoutMs = 5000\r\n    65\t\t}\r\n    66\t\tfor i := range cfg.Services {\r\n    67\t\t\ts := &cfg.Services[i]\r\n    68\t\t\tif s.RoutingMode == \"\" {\r\n"]
[1952.293939, "o", "    69\t\t\t\ts.RoutingMode = \"weighted-round-robin\"\r\n    70\t\t\t}\r\n    71\t\t\tif s.DrainTimeoutMs <= 0 {\r\n    72\t\t\t\ts.DrainTimeoutMs = 5000\r\n    73\t\t\t}\r\n    74\t\t\tif s.MaxConnectionsPerEndpoint <= 0 {\r\n    75\t\t\t\ts.MaxConnectionsPerEndpoint = 100\r\n    76\t\t\t}\r\n    77\t\t\tfor j := range s.Endpoints {\r\n"]
[1952.294019, "o", "    78\t\t\t\tep := &s.Endpoints[j]\r\n    79\t\t\t\tif ep.HealthCheck == \"\" {\r\n    80\t\t\t\t\tep.HealthCheck = \"tcp\"\r\n    81\t\t\t\t}\r\n    82\t\t\t\tif ep.Weight < 0 {\r\n    83\t\t\t\t\tep.Weight = 0\r\n    84\t\t\t\t}\r\n    85\t\t\t}\r\n"]
[1952.294083, "o", "    86\t\t}\r\n    87\t\treturn &cfg, nil\r\n    88\t}\r\n"]
