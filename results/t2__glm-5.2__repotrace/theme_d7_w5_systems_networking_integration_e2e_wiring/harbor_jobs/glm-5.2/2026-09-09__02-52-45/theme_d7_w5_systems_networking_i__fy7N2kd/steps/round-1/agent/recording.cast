[11411.313603, "o", "\t\t\treturn nil, err\r\n\t\t}\r\n\t\tlastN := 20\r\n\t\tif args.LastN != nil {\r\n\t\t\tlastN = *args.LastN\r\n"]
[11411.313728, "o", "\t\t}\r\n\t\tentries := accesslog.GetAccessLog(accesslog.DefaultPath, args.Service, args.Result, lastN, args.MinDurationMs)\r\n\t\tif entries == nil {\r\n\t\t\tentries = []accesslog.Entry{}\r\n"]
[11411.313823, "o", "\t\t}\r\n\t\treturn entries, nil\r\n\tcase \"get_access_stats\":\r\n\t\tvar args struct {\r\n\t\t\tService string `json:\"service\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn accesslog.Stats(accesslog.DefaultPath, args.Service), nil\r\n\tcase \"get_dependencies\":\r\n\t\tvar args struct {\r\n\t\t\tService string `json:\"service\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tdeps := s.state.DependencyStatuses(args.Service)\r\n\t\tif deps == nil {\r\n"]
[11411.313897, "o", "\t\t\tdeps = []state.DependencyStatus{}\r\n\t\t}\r\n\t\treturn map[string]interface{}{\r\n\t\t\t\"service\":      args.Service,\r\n\t\t\t\"dependencies\": deps,\r\n\t\t}, nil\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"unknown command: %s\", req.Cmd)\r\n\t}\r\n}\r\n\r\nfunc init() {\r\n\t_ = strconv.Itoa(0)\r\n"]
