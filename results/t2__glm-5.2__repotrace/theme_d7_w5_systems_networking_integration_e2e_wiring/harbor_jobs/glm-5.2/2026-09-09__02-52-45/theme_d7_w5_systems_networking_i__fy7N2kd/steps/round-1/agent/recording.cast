[11410.151563, "o", "\u001b[?2004l\r"]
[11410.154705, "o", "package config\r\n\r\nimport (\r\n\t\"github.com/BurntSushi/toml\"\r\n)\r\n\r\n"]
[11410.154796, "o", "// Global holds mesh-wide tuning parameters.\r\ntype Global struct {\r\n\tHealthIntervalMs        int `toml:\"health_interval_ms\"`\r\n\tUnhealthyThreshold      int `toml:\"unhealthy_threshold\"`\r\n\tHealthyThreshold        int `toml:\"healthy_threshold\"`\r\n\tStatsWindowSec          int `toml:\"stats_window_sec\"`\r\n\tCircuitBreakerThreshold int `toml:\"circuit_breaker_threshold\"`\r\n\tCircuitBreakerTimeoutMs int `toml:\"circuit_breaker_timeout_ms\"`\r\n}\r\n\r\n// Endpoint describes one backend endpoint from config.\r\ntype Endpoint struct {\r\n\tAddress          string `toml:\"address\"`\r\n\tWeight           int    `toml:\"weight\"`\r\n\tWarmupDurationMs int    `toml:\"warmup_duration_ms\"`\r\n"]
[11410.154873, "o", "\tHealthCheck      string `toml:\"health_check\"`\r\n\tHealthPath       string `toml:\"health_path\"`\r\n\tHealthCmd        string `toml:\"health_cmd\"`\r\n}\r\n\r\n// Service describes one routed service from config.\r\ntype Service struct {\r\n\tName                      string     `toml:\"name\"`\r\n\tListenPort                int        `toml:\"listen_port\"`\r\n\tRoutingMode               string     `toml:\"routing_mode\"`\r\n\tDrainTimeoutMs            int        `toml:\"drain_timeout_ms\"`\r\n\tMaxConnectionsPerEndpoint int        `toml:\"max_connections_per_endpoint\"`\r\n"]
[11410.154939, "o", "\tConnectionLimitMode       string     `toml:\"connection_limit_mode\"`\r\n\tRateLimitRps              int        `toml:\"rate_limit_rps\"`\r\n\tRateLimitBurst            int        `toml:\"rate_limit_burst\"`\r\n\tRateLimitQueueDepth       int        `toml:\"rate_limit_queue_depth\"`\r\n\tRateLimitQueueTimeoutMs   int        `toml:\"rate_limit_queue_timeout_ms\"`\r\n\tMaxRetries                int        `toml:\"max_retries\"`\r\n\tRetryDelayMs              int        `toml:\"retry_delay_ms\"`\r\n\tRetryBackoffMultiplier    float64    `toml:\"retry_backoff_multiplier\"`\r\n\tRetryMaxDelayMs           int        `toml:\"retry_max_delay_ms\"`\r\n\tIdleTimeoutMs             int        `toml:\"idle_timeout_ms\"`\r\n"]
[11410.155008, "o", "\tDependsOn                 []string   `toml:\"depends_on\"`\r\n\tEndpoints                 []Endpoint `toml:\"endpoint\"`\r\n}\r\n\r\n// Config is the parsed application configuration.\r\ntype Config struct {\r\n"]
[11410.155075, "o", "\tGlobal   Global\r\n\tServices []Service `toml:\"service\"`\r\n}\r\n\r\n// Load reads and normalizes a TOML config file.\r\nfunc Load(path string) (*Config, error) {\r\n\tvar cfg Config\r\n\tif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif cfg.Global.HealthIntervalMs <= 0 {\r\n\t\tcfg.Global.HealthIntervalMs = 2000\r\n\t}\r\n\tif cfg.Global.UnhealthyThreshold <= 0 {\r\n\t\tcfg.Global.UnhealthyThreshold = 3\r\n\t}\r\n\tif cfg.Global.HealthyThreshold <= 0 {\r\n"]
[11410.155136, "o", "\t\tcfg.Global.HealthyThreshold = 2\r\n\t}\r\n\tif cfg.Global.StatsWindowSec <= 0 {\r\n\t\tcfg.Global.StatsWindowSec = 60\r\n\t}\r\n\tif cfg.Global.CircuitBreakerThreshold <= 0 {\r\n\t\tcfg.Global.CircuitBreakerThreshold = 3\r\n\t}\r\n\tif cfg.Global.CircuitBreakerTimeoutMs <= 0 {\r\n"]
[11410.155199, "o", "\t\tcfg.Global.CircuitBreakerTimeoutMs = 5000\r\n\t}\r\n\tfor i := range cfg.Services {\r\n\t\ts := &cfg.Services[i]\r\n\t\tif s.RoutingMode == \"\" {\r\n\t\t\ts.RoutingMode = \"weighted-round-robin\"\r\n\t\t}\r\n\t\tif s.DrainTimeoutMs <= 0 {\r\n\t\t\ts.DrainTimeoutMs = 5000\r\n"]
[11410.155262, "o", "\t\t}\r\n\t\tif s.MaxConnectionsPerEndpoint <= 0 {\r\n\t\t\ts.MaxConnectionsPerEndpoint = 100\r\n\t\t}\r\n\t\tif s.ConnectionLimitMode == \"\" {\r\n\t\t\ts.ConnectionLimitMode = \"per-endpoint\"\r\n\t\t}\r\n\t\tif s.RateLimitBurst <= 0 {\r\n"]
[11410.155322, "o", "\t\t\ts.RateLimitBurst = s.RateLimitRps\r\n\t\t}\r\n\t\tif s.RateLimitQueueTimeoutMs <= 0 {\r\n\t\t\ts.RateLimitQueueTimeoutMs = 1000\r\n\t\t}\r\n\t\tif s.RetryDelayMs <= 0 {\r\n\t\t\ts.RetryDelayMs = 100\r\n\t\t}\r\n\t\tif s.RetryBackoffMultiplier <= 0 {\r\n"]
[11410.155422, "o", "\t\t\ts.RetryBackoffMultiplier = 2.0\r\n\t\t}\r\n\t\tif s.RetryMaxDelayMs <= 0 {\r\n\t\t\ts.RetryMaxDelayMs = 5000\r\n\t\t}\r\n\t\tfor j := range s.Endpoints {\r\n\t\t\tep := &s.Endpoints[j]\r\n\t\t\tif ep.HealthCheck == \"\" {\r\n\t\t\t\tep.HealthCheck = \"tcp\"\r\n\t\t\t}\r\n"]
[11410.155485, "o", "\t\t\tif ep.Weight < 0 {\r\n\t\t\t\tep.Weight = 0\r\n\t\t\t}\r\n\t\t\tif ep.WarmupDurationMs < 0 {\r\n\t\t\t\tep.WarmupDurationMs = 0\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn &cfg, nil\r\n}\r\n"]
[11410.156029, "o", "\u001b[?2004h"]
[11410.15609, "o", "root@n30009:/app# "]
[11410.440242, "i", "sed -n '250,340p' internal/state/state.go\n"]
[11410.44062, "o", "sed -n '250,340p' internal/state/state.go\r\n"]
[11410.44072, "o", "\u001b[?2004l\r"]
[11410.444013, "o", "func newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {\r\n\treturn &EndpointState{\r\n\t\tAddress:          cep.Address,\r\n\t\tWeight:           cep.Weight,\r\n\t\tWarmupDurationMs: cep.WarmupDurationMs,\r\n\t\tConfig:           cep,\r\n\t\tState:            Unknown,\r\n\t\tCircuit:          circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n"]
[11410.444124, "o", "\t\tStats:            stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n\t\tconnections:      make(map[int64]*connectionInfo),\r\n\t}\r\n}\r\n\r\nfunc (s *State) GetService(name string) *ServiceState {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.services[name]\r\n}\r\n\r\nfunc (s *State) Services() []*ServiceState {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\tout := make([]*ServiceState, 0, len(s.services))\r\n\tfor _, ss := range s.services {\r\n\t\tout = append(out, ss)\r\n\t}\r\n\treturn out\r\n}\r\n"]
[11410.44419, "o", "\r\n// DependencyStatus describes a configured dependency.\r\ntype DependencyStatus struct {\r\n\tName             string `json:\"name\"`\r\n\tAvailable        bool   `json:\"available\"`\r\n\tHealthyEndpoints int    `json:\"healthy_endpoints\"`\r\n}\r\n\r\n// CheckDependency returns whether a dependency service is available and how\r\n// many of its endpoints are healthy with closed circuit breakers.\r\nfunc (s *State) CheckDependency(name string) (bool, int) {\r\n\tdep := s.GetService(name)\r\n\tif dep == nil {\r\n"]
[11410.444254, "o", "\t\treturn false, 0\r\n\t}\r\n\tdep.mu.Lock()\r\n\tdefer dep.mu.Unlock()\r\n\thealthy := 0\r\n\tfor _, ep := range dep.Endpoints {\r\n\t\tif ep.State == Healthy && ep.Circuit.IsClosed() {\r\n\t\t\thealthy++\r\n\t\t}\r\n\t}\r\n"]
[11410.444317, "o", "\treturn healthy > 0, healthy\r\n}\r\n\r\n// CheckDependencies returns the first unavailable dependency and the full\r\n// dependency status list for a service.\r\nfunc (s *State) CheckDependencies(service string) (string, []DependencyStatus) {\r\n\tss := s.GetService(service)\r\n\tif ss == nil {\r\n\t\treturn \"\", nil\r\n\t}\r\n"]
[11410.444378, "o", "\tss.mu.Lock()\r\n\tdeps := ss.DependsOn\r\n\tss.mu.Unlock()\r\n\tif len(deps) == 0 {\r\n\t\treturn \"\", nil\r\n\t}\r\n\tvar statuses []DependencyStatus\r\n\tvar failed string\r\n\tfor _, dep := range deps {\r\n\t\tavailable, healthy := s.CheckDependency(dep)\r\n"]
[11410.444451, "o", "\t\tstatuses = append(statuses, DependencyStatus{Name: dep, Available: available, HealthyEndpoints: healthy})\r\n\t\tif failed == \"\" && !available {\r\n\t\t\tfailed = dep\r\n\t\t}\r\n\t}\r\n\treturn failed, statuses\r\n}\r\n"]
[11410.444512, "o", "\r\n// DependencyStatuses returns dependency status rows for a service.\r\nfunc (s *State) DependencyStatuses(service string) []DependencyStatus {\r\n\t_, statuses := s.CheckDependencies(service)\r\n\treturn statuses\r\n}\r\n\r\nfunc (s *State) GetEndpoint(service, address string) *EndpointState {\r\n\tss := s.GetService(service)\r\n\t"]
[11410.444573, "o", "if ss == nil {\r\n\t\treturn nil\r\n\t}\r\n\tss.mu.Lock()\r\n"]
[11410.445178, "o", "\u001b[?2004h"]
