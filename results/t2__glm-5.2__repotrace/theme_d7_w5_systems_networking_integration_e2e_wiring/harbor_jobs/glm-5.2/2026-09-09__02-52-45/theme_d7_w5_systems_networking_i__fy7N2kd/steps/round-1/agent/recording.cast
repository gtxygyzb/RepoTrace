[14477.80153, "i", "0\n\t\treturn true\n\t}\n\treturn false\n}\n\n// AcquireProbe attempts to take one of the allowed half-open probe connections.\nfunc (b *Breaker) AcquireProbe() bool {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tif b.state == HalfOpen && b.probeActive < b.halfOpenMaxProbes {\n\t\tb.probeActive++\n\t\treturn true\n\t}\n\treturn false\n}\n\n// RecordProbeResult records the outcome of a half-open probe. When all probes\n// in the batch have completed, the circuit is closed if more than half\n// succeeded, otherwise it is reopened.\nfunc (b *Breaker) RecordProbeResult(success bool) {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tif b.state != HalfOpen {\n\t\treturn\n\t}\n\tif b.probeActive > 0 {\n\t\tb.probeActive--\n\t}\n\tif success {\n\t\tb.probeSuccesses++\n\t} else {\n\t\tb.probeFailures++\n\t}\n\tif b.probeActive == 0 {\n\t\ttotal := b.probeSuccesses + b.probeFailures\n\t\tif total > 0 && b.probeSuccesses*2 > total {\n\t\t\tnow := time.Now()\n\t\t\tb.state = Closed\n\t\t\tb.stateChangedAt = now\n\t\t\tb.openedAt = now\n\t\t\tb.consecutiveFailures = 0\n\t\t} else {\n\t\t\tnow := time.Now()\n\t\t\tb.state = Open\n\t\t\tb"]
