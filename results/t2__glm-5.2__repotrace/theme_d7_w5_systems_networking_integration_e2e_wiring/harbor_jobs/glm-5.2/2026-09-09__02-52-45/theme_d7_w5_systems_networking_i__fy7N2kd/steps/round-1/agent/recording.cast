[12186.334913, "o", "   132\t\t\tService:              name,\r\n   133\t\t\tWindowSec:            windowSec,\r\n   134\t\t\tDependencyRejections: ss.Stats.Snapshot(0).DependencyRejections,\r\n   135\t\t\tEndpoints:            make([]StatsEndpointView, 0),\r\n   136\t\t}\r\n   137\t\tss.mu.Lock()\r\n   138\t\tfor _, ep := range ss.Endpoints {\r\n   139\t\t\tep.mu.Lock()\r\n   140\t\t\tsv.Endpoints = append(sv.Endpoints, StatsEndpointView{\r\n   141\t\t\t\tAddress:  ep.Address,\r\n   142\t\t\t\tSnapshot: ep.Stats.Snapshot(ep.ActiveConnections),\r\n   143\t\t\t})\r\n   144\t\t\tep.mu.Unlock()\r\n   145\t\t}\r\n   146\t\tss.mu.Unlock()\r\n   147\t\treturn sv, true\r\n   148\t}\r\n   149\t\r\n   150\ttype HealthEventView struct {\r\n"]
