[1148.261315, "i", "cat > cmd/meshctl/main.go <<'EOF'\npackage main\n\nimport (\n    \"bufio\"\n    \"encoding/json\"\n    \"fmt\"\n    \"net\"\n    \"os\"\n    \"strconv\"\n    \"strings\"\n)\n\ntype request struct {\n    Cmd  string          `json:\"cmd\"`\n    Args json.RawMessage `json:\"args\"`\n}\n\ntype response struct {\n    Status string          `json:\"status\"`\n    Data   json.RawMessage `json:\"data\"`\n}\n\nfunc main() {\n    if len(os.Args) < 2 {\n        fmt.Fprintln(os.Stderr, \"usage: meshctl <command> [args]\")\n        os.Exit(1)\n    }\n    cmd := os.Args[1]\n    args := map[string]interface{}{}\n    switch cmd {\n    case \"status\":\n    case \"stats\":\n        if len(os.Args) < 3 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n    case \"set-weight\":\n        if len(os.Args) < 5 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")\n            os.Exit(1)\n        }\n        w, err := strconv.Atoi(os.Args[4])\n        if err != nil {\n   "]
[1148.26158, "i", "         fmt.Fprintf(os.Stderr, \"invalid weight: %v\\n\", err)\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n        args[\"address\"] = os.Args[3]\n        args[\"weight\"] = w\n    case \"drain\":\n        if len(os.Args) < 4 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n        args[\"address\"] = os.Args[3]\n    case \"health-log\":\n        if len(os.Args) < 3 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n        n := 20\n        for _, a := range os.Args[3:] {\n            if strings.HasPrefix(a, \"--last\") && len(a) > 6 {\n                v, err := strconv.Atoi(a[6:])\n                if err == nil {\n                    n = v\n                }\n            }\n        }\n        args[\"last_n\"] = n\n    case \"resolve\":\n        if len(os.Args) < 3 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl "]
[1148.261678, "i", "resolve <service>\")\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n    case \"circuits\":\n        if len(os.Args) < 3 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n    case \"reset-circuit\":\n        if len(os.Args) < 4 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl reset-circuit <service> <endpoint>\")\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n        args[\"address\"] = os.Args[3]\n    case \"reload\":\n    default:\n        fmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\n        os.Exit(1)\n    }\n    data, err := sendCommand(cmd, args)\n    if err != nil {\n        fmt.Fprintln(os.Stderr, err)\n        os.Exit(1)\n    }\n    fmt.Println(data)\n}\n\nfunc sendCommand(cmd string, args map[string]interface{}) (string, error) {\n    var rawArgs json.RawMessage\n    if args != nil {\n        b, err := json.Marshal(args)\n        if err != nil {\n            return \"\", err\n        }\n     "]
