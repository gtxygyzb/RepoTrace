[14481.830485, "o", "# Add shouldMirror function and counter at end of file\r\n\u001b[?2004l\r"]
[14481.830554, "o", "\u001b[?2004h> "]
[14481.83062, "o", "should_mirror = '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.830704, "o", "var mirrorSampleCounter uint64\r\n\u001b[?2004l\r\u001b[?2004h"]
[14481.830777, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.830862, "o", "func shouldMirror(pct int) bool {\r\n\u001b[?2004l\r"]
[14481.830929, "o", "\u001b[?2004h> "]
[14481.831015, "o", "\u0007"]
[14481.83108, "o", "if pct <= 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.831157, "o", "\u0007"]
[14481.831229, "o", "\r\ncmd/      config/   go.mod    go.sum    internal/ logs/     meshctl   meshd     \r\n> "]
[14481.831303, "o", "return false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.831376, "o", "\u0007}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.831456, "o", "\u0007"]
[14481.831527, "o", "if pct >= 100 {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007"]
[14481.831594, "o", "\r\ncmd/      config/   go.mod    go.sum    internal/ logs/     meshctl   meshd     \r\n> "]
[14481.83166, "o", "return true\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.831717, "o", "\u0007}\r\n\u001b[?2004l\r\u001b[?2004h"]
[14481.831784, "o", "> \u0007"]
[14481.831916, "o", "c := atomic.AddUint64(&mirrorSampleCounter, 1)\r\n\u001b[?2004l\r"]
[14481.831985, "o", "\u001b[?2004h> \u0007"]
[14481.832056, "o", "return int(c%100) < pct\r\n\u001b[?2004l\r"]
[14481.832124, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[14481.832192, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.832293, "o", "# Add before intToStr function\r\n\u001b[?2004l\r"]
[14481.832361, "o", "\u001b[?2004h> "]
[14481.832612, "o", "s = s.replace('\\nfunc intToStr(i int) string {', should_mirror + '\\nfunc intToStr(i int) string {')\r\n\u001b[?2004l\r"]
[14481.832682, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
