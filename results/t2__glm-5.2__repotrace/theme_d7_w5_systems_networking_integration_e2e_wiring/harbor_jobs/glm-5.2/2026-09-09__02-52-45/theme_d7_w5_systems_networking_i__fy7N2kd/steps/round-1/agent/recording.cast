[13869.785909, "o", "    27\t}\r\n    28\t\r\n    29\ttype Server struct {\r\n    30\t\tstate    *state.State\r\n"]
[13869.785978, "o", "    31\t\tpath     string\r\n    32\t\tlistener net.Listener\r\n    33\t\twg       sync.WaitGroup\r\n    34\t\tstop     chan struct{}\r\n    35\t\tdone     chan struct{}\r\n    36\t}\r\n    37\t\r\n    38\tfunc NewServer(s *state.State, path string) *Server {\r\n    39\t\treturn &Server{\r\n    40\t\t\tstate: s,\r\n    41\t\t\tpath:  path,\r\n"]
[13869.786045, "o", "    42\t\t\tstop:  make(chan struct{}),\r\n    43\t\t\tdone:  make(chan struct{}),\r\n    44\t\t}\r\n    45\t}\r\n    46\t\r\n    47\tfunc (s *Server) Start() error {\r\n    48\t\tos.Remove(s.path)\r\n    49\t\tln, err := net.Listen(\"unix\", s.path)\r\n    50\t\tif err != nil {\r\n    51\t\t\treturn err\r\n    52\t\t}\r\n    53\t\ts.listener = ln\r\n    54\t\tgo s.acceptLoop()\r\n    55\t"]
[13869.78616, "o", "\treturn nil\r\n    56\t}\r\n    57\t\r\n    58\tfunc (s *Server) Stop() {\r\n    59\t\tselect {\r\n    60\t\tcase <-s.stop:\r\n    61\t\tdefault:\r\n    62\t\t\tclose(s.stop)\r\n    63\t\t}\r\n    64\t\tif s.listener != nil {\r\n    65\t\t\ts.listener.Close()\r\n    66\t\t}\r\n    67\t\t<-s.done\r\n    68\t\tos.Remove(s.path)\r\n"]
[13869.78628, "o", "    69\t}\r\n    70\t\r\n    71\tfunc (s *Server) acceptLoop() {\r\n    72\t\tdefer close(s.done)\r\n    73\t\tfor {\r\n    74\t\t\tconn, err := s.listener.Accept()\r\n    75\t\t\tif err != nil {\r\n    76\t\t\t\treturn\r\n    77\t\t\t}\r\n    78\t\t\ts.wg.Add(1)\r\n    79\t\t\tgo s.handleConn(conn)\r\n    80\t\t}\r\n    81\t}\r\n    82\t\r\n    83\tfunc (s *Server) handleConn(conn net.Conn) {\r\n    84\t\tdefer s.wg.Done()\r\n    85\t\tdefer conn.Close()\r\n    86\t\treader := bufio.NewReader(conn)\r\n    87\t\tfor {\r\n"]
[13869.786353, "o", "    88\t\t\tline, err := reader.ReadString('\\n')\r\n    89\t\t\tif err != nil {\r\n    90\t\t\t\treturn\r\n    91\t\t\t}\r\n    92\t\t\tline = strings.TrimRight(line, \"\\r\\n\")\r\n    93\t\t\tif line == \"\" {\r\n"]
[13869.786428, "o", "    94\t\t\t\tcontinue\r\n    95\t\t\t}\r\n    96\t\t\tresp := s.handleLine(line)\r\n    97\t\t\t_, _ = conn.Write([]byte(resp + \"\\n\"))\r\n    98\t\t}\r\n    99\t}\r\n   100\t\r\n   101\tfunc (s *Server) handleLine(line string) string {\r\n   102\t\tvar req Request\r\n   103\t\tif err := json.Unmarshal([]byte(line), &req); err != nil {\r\n   104\t\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n   105\t\t}\r\n   106\t\tdata, err := s.dispatch(req)\r\n   107\t\tif err != nil {\r\n"]
[13869.786495, "o", "   108\t\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n   109\t\t}\r\n   110\t\treturn encodeResp(Response{Status: \"ok\", Data: data})\r\n   111\t}\r\n   112\t\r\n   113\tfunc encodeResp(r Response) string {\r\n"]
[13869.786557, "o", "   114\t\tb, _ := json.Marshal(r)\r\n   115\t\treturn string(b)\r\n   116\t}\r\n   117\t\r\n   118\tfunc (s *Server) dispatch(req Request) (interface{}, error) {\r\n   119\t\tswitch req.Cmd {\r\n   120\t\tcase \"list_services\":\r\n   121\t\t\treturn s.state.ServicesView(), nil\r\n   122\t\tcase \"get_service\":\r\n   123\t\t\tvar args struct {\r\n   124\t\t\t\tName string `json:\"name\"`\r\n   125\t\t\t}\r\n   126\t\t\t"]
[13869.78662, "o", "if err := json.Unmarshal(req.Args, &args); err != nil {\r\n   127\t\t\t\treturn nil, err\r\n   128\t\t\t}\r\n   129\t\t\tsv, ok := s.state.ServiceView(args.Name)\r\n   130\t\t\tif !ok {\r\n   131\t\t"]
[13869.786662, "o", "\t\treturn nil, errors.New(\"service not found\")\r\n   132\t\t\t}\r\n   133\t\t\treturn sv, nil\r\n   134\t\tcase \"get_warmup_status\":\r\n   135\t\t\tvar args struct {\r\n   136\t\t\t\tName string `json:\"name\"`\r\n   137\t\t\t}\r\n   138\t\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n   139\t\t\t\treturn nil, err\r\n   140\t\t\t}\r\n"]
[13869.786744, "o", "   141\t\t\tsv, ok := s.state.WarmupStatusView(args.Name)\r\n   142\t\t\tif !ok {\r\n   143\t\t\t\treturn nil, errors.New(\"service not found\")\r\n   144\t\t\t}\r\n   145\t\t\treturn sv, nil\r\n   146\t\tcase \"get_stats\":\r\n   147\t\t\tvar args struct {\r\n   148\t\t\t\tName string `json:\"name\"`\r\n   149\t\t\t}\r\n   150\t\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n   151\t\t\t\treturn nil, err\r\n"]
[13869.786809, "o", "   152\t\t\t}\r\n   153\t\t\tg := s.state.Global()\r\n   154\t\t\tsv, ok := s.state.StatsView(args.Name, g.StatsWindowSec)\r\n   155\t\t\tif !ok {\r\n   156\t\t\t\treturn nil, errors.New(\"service not found\")\r\n   157\t\t\t}\r\n   158\t\t\treturn sv, nil\r\n"]
