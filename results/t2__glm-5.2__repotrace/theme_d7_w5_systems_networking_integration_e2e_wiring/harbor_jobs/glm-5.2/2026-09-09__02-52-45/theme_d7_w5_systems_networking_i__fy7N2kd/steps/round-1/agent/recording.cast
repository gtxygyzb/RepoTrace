[5827.171914, "o", "   464\tfunc (s *State) RecordHealthCheck(service, address string, success bool) HealthEvent {\r\n   465\t\tss := s.GetService(service)\r\n   466\t\tif ss == nil {\r\n   467\t\t\treturn HealthEvent{}\r\n   468\t\t}\r\n   469\t\tep := s.GetEndpoint(service, address)\r\n   470\t\tif ep == nil {\r\n"]
