[2031.603654, "o", "   151\t\t\t\t\ttimeout = 5 * time.Second\r\n   152\t\t\t\t}\r\n   153\t\t\t}\r\n   154\t\t\tdone := make(chan struct{})\r\n   155\t\t\tgo func() {\r\n   156\t\t\t\tsl.wg.Wait()\r\n   157\t\t\t\tclose(done)\r\n   158\t\t\t}()\r\n   159\t\t\tselect {\r\n   160\t\t\tcase <-done:\r\n   161\t\t\tcase <-time.After(timeout):\r\n"]
