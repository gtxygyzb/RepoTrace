[2465.654743, "o", "nl -ba internal/router/router.go | sed -n '1,80p'\r\n\u001b[?2004l\r"]
[2465.658662, "o", "     1\tpackage router\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"io\"\r\n     5\t\t\"log\"\r\n     6\t\t\"net\"\r\n     7\t\t\"sync\"\r\n"]
[2465.65877, "o", "     8\t\t\"time\"\r\n     9\t\r\n    10\t\t\"meshrouter/internal/state\"\r\n    11\t)\r\n    12\t\r\n    13\ttype serviceListener struct {\r\n    14\t\tservice  string\r\n    15\t\tport     int\r\n    16\t\tlistener net.Listener\r\n    17\t\tstop     chan struct{}\r\n    18\t\twg       sync.WaitGroup\r\n    19\t\tdone     chan struct{}\r\n    20\t}\r\n    21\t\r\n    22"]
[2465.658852, "o", "\ttype Router struct {\r\n    23\t\tstate     *state.State\r\n    24\t\tmu        sync.Mutex\r\n    25\t\tlisteners map[string]*serviceListener\r\n    26\t}\r\n    27\t\r\n    28\tfunc NewRouter(s *state.State) *Router {\r\n    29\t\treturn &Router{\r\n    30\t\t\tstate:     s,\r\n    31\t\t\tlisteners: make(map[string]*serviceListener),\r\n    32\t\t}\r\n    33\t}\r\n"]
[2465.658914, "o", "    34\t\r\n    35\tfunc (r *Router) Start() {\r\n    36\t\tfor _, ss := range r.state.Services() {\r\n    37\t\t\tif !ss.IsStopping() {\r\n    38\t\t\t\tr.startService(ss)\r\n    39\t\t\t}\r\n    40\t\t}\r\n    41\t}\r\n    42\t\r\n    43\tfunc (r *Router) Reload() {\r\n    44\t\tservices := r.state.Services()\r\n    45\t\tseen := make(map[string]bool)"]
[2465.658993, "o", "\r\n    46\t\tfor _, ss := range services {\r\n    47\t\t\tseen[ss.Name] = true\r\n    48\t\t\tr.mu.Lock()\r\n    49\t\t\tsl, ok := r.listeners[ss.Name]\r\n    50\t\t\tr.mu.Unlock()\r\n    51\t\t\tif !ok {\r\n    52\t\t\t\tif !ss.IsStopping() {\r\n    53\t\t\t\t\tr.startService(ss)\r\n    54\t\t\t\t}"]
[2465.659057, "o", "\r\n    55\t\t\t\tcontinue\r\n    56\t\t\t}\r\n    57\t\t\tif sl.port != ss.ListenPort {\r\n    58\t\t\t\tr.stopService(ss.Name, true)\r\n    59\t\t\t\tr.startService(ss)\r\n    60\t\t\t}\r\n    61\t\t}\r\n    62\t\tr.mu.Lock()\r\n    63\t\tfor name := range r.listeners {\r\n"]
[2465.659117, "o", "    64\t\t\tif !seen[name] {\r\n    65\t\t\t\tr.mu.Unlock()\r\n    66\t\t\t\tr.stopService(name, true)\r\n    67\t\t\t\tr.mu.Lock()\r\n    68\t\t\t}\r\n    69\t\t}\r\n    70\t\tr.mu.Unlock()\r\n    71\t}\r\n"]
[2465.659177, "o", "    72\t\r\n    73\tfunc (r *Router) startService(ss *state.ServiceState) {\r\n    74\t\taddr := \":\" + intToStr(ss.ListenPort)\r\n    75\t\tln, err := net.Listen(\"tcp\", addr)\r\n    76\t\tif err != nil {\r\n    77\t\t\tlog.Printf(\"router: listen %s on %s failed: %v\", ss.Name, addr, err)\r\n    78\t\t\treturn\r\n    79\t\t}\r\n    80\t\tsl := &serviceListener{\r\n"]
[2465.659787, "o", "\u001b[?2004h"]
