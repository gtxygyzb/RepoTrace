[10784.349218, "o", "}\r\n\r\n// State returns the current state.\r\nfunc (b *Breaker) State() State {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\treturn b.state\r\n}\r\n\r\n// IsClosed returns true if the breaker is closed.\r\nfunc (b *Breaker) IsClosed() bool {\r\n\treturn b.State() == Closed\r\n}\r\n\r\n// IsOpen returns true if the breaker is open.\r\nfunc (b *Breaker) IsOpen() bool {\r\n\treturn b.State() == Open\r\n}\r\n\r\n// IsHalfOpen returns true if the breaker is half-open.\r\nfunc (b *Breaker) IsHalfOpen() bool {\r\n\treturn b.State() == HalfOpen\r\n}\r\n\r\n// Open forces the breaker open and restarts the timeout clock.\r\nfunc (b *Breaker) Open() {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tnow := time.Now()\r\n\tb.state = Open\r\n"]
[10784.349257, "o", "\tb.stateChangedAt = now\r\n\tb.openedAt = now\r\n\tb.consecutiveFailures++\r\n\tb.probeActive = false\r\n}\r\n\r\n// MaybeHalfOpen transitions from open to half_open if the timeout has elapsed.\r\nfunc (b *Breaker) MaybeHalfOpen() bool {\r\n\t"]
[10784.349349, "o", "b.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tif b.state == Open && time.Since(b.openedAt) >= b.timeout {\r\n\t\tb.state = HalfOpen\r\n\t\tb.stateChangedAt = time.Now()\r\n\t\tb.probeActive = false\r\n\t\treturn true\r\n"]
