[10604.611758, "o", "    46\t\r\n    47\t// Config is the parsed application configuration.\r\n    48\ttype Config struct {\r\n    49\t\tGlobal   Global\r\n    50\t\tServices []Service `toml:\"service\"`\r\n    51\t}\r\n    52\t\r\n    53\t// Load reads and normalizes a TOML config file.\r\n    54\tfunc Load(path string) (*Config, error) {\r\n    55\t\tvar cfg Config\r\n    56\t\tif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\n    57\t\t\treturn nil, err\r\n    58\t\t}\r\n    59\t\tif cfg.Global.HealthIntervalMs <= 0 {\r\n    60\t\t\tcfg.Global.HealthIntervalMs = 2000\r\n    61\t\t}\r\n    62\t\tif cfg.Global.UnhealthyThreshold <= 0 {\r\n    63\t\t\tcfg.Global.UnhealthyThreshold = 3\r\n    64\t\t}\r\n    65\t\tif cfg.Global.HealthyThreshold <= 0 {\r\n    66\t\t\tcfg.Global.HealthyThreshold = 2\r\n    67\t\t}\r\n    68\t\tif cfg.Global.StatsWindowSec <= 0 {\r\n    69\t\t\tcfg.Global.StatsWindowSec = 60\r\n    70\t\t}\r\n    71\t\tif cfg.Global.CircuitBreakerThreshold <= 0 {\r\n    72\t\t\tcfg.Global.CircuitBreakerThreshold = 3\r\n    73\t\t}\r\n    74\t\tif cfg.Global.CircuitBreakerTimeoutMs <= 0 {\r\n    75\t\t\tcfg.Global.CircuitBreaker"]
