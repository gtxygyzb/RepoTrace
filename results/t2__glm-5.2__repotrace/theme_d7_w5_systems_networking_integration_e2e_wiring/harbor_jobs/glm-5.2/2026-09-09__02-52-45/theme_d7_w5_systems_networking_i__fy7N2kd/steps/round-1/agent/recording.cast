[10862.770058, "o", "sed -n '390,440p' cmd/meshctl/main.go\r\n\u001b[?2004l\r"]
[10862.773047, "o", "\t\tfmt.Fprintf(&b, \"%-10s %-6s %-7s %-10s %-8s %-14s %-15s\\n\", \"SERVICE\", \"RPS\", \"BURST\", \"TOKENS\", \"QUEUED\", \"RATE_LIMITED\", \"QUEUE_TIMEOUTS\")\r\n\t\tfmt.Fprintf(&b, \"%-10s %-6.0f %-7.0f %-10.2f %-8d %-14d %-15d\\n\", os.Args[2], st.Rps, st.Burst, st.TokensAvailable, st.QueueDepth, st.RateLimited, st.QueueTimeouts)\r\n\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n\tdefault:\r\n\t\tvar v interface{}\r\n\t\tif err := json.Unmarshal(data, &v); err != nil {\r\n\t\t\treturn \"\", err\r\n"]
[10862.773192, "o", "\t\t}\r\n\t\tb, err := json.MarshalIndent(v, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\treturn string(b), nil\r\n\t}\r\n}\r\n"]
