[14481.832817, "o", "\u001b[?2004h>     f.write(s)\r\n\u001b[?2004l\r"]
[14481.832883, "o", "\u001b[?2004h> "]
[14481.832952, "o", "print('router.go updated')\r\n\u001b[?2004l\r\u001b[?2004h> "]
