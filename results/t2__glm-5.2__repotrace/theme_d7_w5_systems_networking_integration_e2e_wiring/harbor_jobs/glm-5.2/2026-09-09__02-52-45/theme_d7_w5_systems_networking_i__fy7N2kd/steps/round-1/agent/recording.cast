[1147.654911, "o", "func (s *Server) handleConn(conn net.Conn) {\r\n\u001b[?2004l\r"]
[1147.654966, "o", "\u001b[?2004h> "]
[1147.655071, "o", "    defer s.wg.Done()\r\n\u001b[?2004l\r"]
[1147.655125, "o", "\u001b[?2004h> "]
[1147.655238, "o", "    defer conn.Close()\r\n\u001b[?2004l\r"]
[1147.655296, "o", "\u001b[?2004h> "]
[1147.655474, "o", "    reader := bufio.NewReader(conn)\r\n\u001b[?2004l\r"]
[1147.655602, "o", "\u001b[?2004h>     for {\r\n\u001b[?2004l\r"]
[1147.655736, "o", "\u001b[?2004h> "]
[1147.65597, "o", "        line, err := reader.ReadString('\\n')\r\n\u001b[?2004l\r"]
[1147.656048, "o", "\u001b[?2004h> "]
[1147.656213, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[1147.656286, "o", "\u001b[?2004h> "]
[1147.656449, "o", "            return\r\n\u001b[?2004l\r"]
[1147.656527, "o", "\u001b[?2004h> "]
[1147.656614, "o", "        }\r\n\u001b[?2004l\r"]
[1147.656686, "o", "\u001b[?2004h> "]
[1147.656971, "o", "        line = strings.TrimRight(line, \"\\r\\n\")\r\n\u001b[?2004l\r"]
[1147.657016, "o", "\u001b[?2004h"]
[1147.657106, "o", "> "]
[1147.657238, "o", "        if line == \"\" {\r\n\u001b[?2004l\r"]
[1147.657281, "o", "\u001b[?2004h"]
[1147.657367, "o", "> "]
[1147.657498, "o", "            continue\r\n\u001b[?2004l\r"]
[1147.65754, "o", "\u001b[?2004h"]
[1147.657627, "o", "> "]
[1147.657708, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1147.65778, "o", "> "]
[1147.657979, "o", "        resp := s.handleLine(line)\r\n\u001b[?2004l\r"]
[1147.658049, "o", "\u001b[?2004h> "]
[1147.658332, "o", "        _, _ = conn.Write([]byte(resp + \"\\n\"))\r\n\u001b[?2004l\r"]
[1147.658374, "o", "\u001b[?2004h"]
[1147.658472, "o", ">     }\r\n\u001b[?2004l\r"]
[1147.658545, "o", "\u001b[?2004h> "]
[1147.658617, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1147.65869, "o", "> \r\n\u001b[?2004l\r"]
[1147.658771, "o", "\u001b[?2004h> "]
[1147.659046, "o", "func (s *Server) handleLine(line string) string {\r\n\u001b[?2004l\r"]
[1147.659127, "o", "\u001b[?2004h> "]
[1147.65927, "o", "    var req Request\r\n\u001b[?2004l\r"]
[1147.659346, "o", "\u001b[?2004h"]
[1147.659429, "o", "> "]
[1147.659755, "o", "    if err := json.Unmarshal([]byte(line), &req); err != nil {\r\n\u001b[?2004l\r"]
[1147.659798, "o", "\u001b[?2004h"]
[1147.659843, "o", "> "]
[1147.660228, "o", "        return encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n\u001b[?2004l\r"]
[1147.660271, "o", "\u001b[?2004h"]
[1147.660354, "o", ">     }\r\n\u001b[?2004l\r"]
[1147.660421, "o", "\u001b[?2004h> "]
[1147.660587, "o", "    data, err := s.dispatch(req)\r\n\u001b[?2004l\r"]
[1147.660651, "o", "\u001b[?2004h> "]
[1147.660749, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1147.66081, "o", "\u001b[?2004h> "]
[1147.661099, "o", "        return encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n\u001b[?2004l\r"]
[1147.661161, "o", "\u001b[?2004h> "]
[1147.66122, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1147.661278, "o", "> "]
[1147.661519, "o", "    return encodeResp(Response{Status: \"ok\", Data: data})\r\n\u001b[?2004l\r"]
[1147.66158, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1147.661651, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1147.661722, "o", "\u001b[?2004h> "]
[1147.661889, "o", "func encodeResp(r Response) string {\r\n\u001b[?2004l\r"]
[1147.661949, "o", "\u001b[?2004h> "]
[1147.662076, "o", "    b, _ := json.Marshal(r)\r\n\u001b[?2004l\r"]
[1147.662137, "o", "\u001b[?2004h> "]
[1147.662238, "o", "    return string(b)\r\n\u001b[?2004l\r"]
[1147.662297, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1147.662362, "o", "\u001b[?2004h"]
[1147.662431, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1147.662492, "o", "> "]
[1147.662716, "o", "func (s *Server) dispatch(req Request) (interface{}, error) {\r\n\u001b[?2004l\r"]
[1147.662779, "o", "\u001b[?2004h> "]
[1147.66288, "o", "    switch req.Cmd {\r\n\u001b[?2004l\r"]
[1147.662941, "o", "\u001b[?2004h> "]
[1147.663059, "o", "    case \"list_services\":\r\n\u001b[?2004l\r"]
[1147.663119, "o", "\u001b[?2004h> "]
[1147.663301, "o", "        return s.state.ServicesView(), nil\r\n\u001b[?2004l\r"]
[1147.663361, "o", "\u001b[?2004h> "]
[1147.663483, "o", "    case \"get_service\":\r\n\u001b[?2004l\r"]
[1147.663545, "o", "\u001b[?2004h> "]
[1147.663664, "o", "        var args struct {\r\n\u001b[?2004l\r"]
[1147.663723, "o", "\u001b[?2004h> "]
[1147.66389, "o", "            Name string `json:\"name\"`\r\n\u001b[?2004l\r"]
[1147.663949, "o", "\u001b[?2004h> "]
[1147.664022, "o", "        }\r\n\u001b[?2004l\r"]
[1147.664081, "o", "\u001b[?2004h> "]
[1147.664337, "o", "        if err := json.Unmarshal(req.Args, &args); err != nil {\r\n\u001b[?2004l\r"]
[1147.664407, "o", "\u001b[?2004h> "]
[1147.664536, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[1147.664595, "o", "\u001b[?2004h> "]
[1147.664654, "o", "        }\r\n\u001b[?2004l\r"]
[1147.664721, "o", "\u001b[?2004h> "]
[1147.664923, "o", "        sv, ok := s.state.ServiceView(args.Name)\r\n\u001b[?2004l\r"]
[1147.664982, "o", "\u001b[?2004h> "]
[1147.66507, "o", "        if !ok {\r\n\u001b[?2004l\r"]
[1147.665126, "o", "\u001b[?2004h> "]
[1147.665363, "o", "            return nil, errors.New(\"service not found\")\r\n\u001b[?2004l\r"]
[1147.665426, "o", "\u001b[?2004h"]
[1147.709479, "o", "> "]
[1147.709548, "o", "        }\r\n\u001b[?2004l\r"]
[1147.709735, "o", "\u001b[?2004h> "]
[1147.709848, "o", "        return sv, nil\r\n\u001b[?2004l\r"]
[1147.70994, "o", "\u001b[?2004h> "]
[1147.710127, "o", "    case \"get_stats\":\r\n\u001b[?2004l\r"]
[1147.71022, "o", "\u001b[?2004h> "]
[1147.710419, "o", "        var args struct {\r\n\u001b[?2004l\r"]
[1147.710506, "o", "\u001b[?2004h> "]
[1147.710756, "o", "            Name string `json:\"name\"`\r\n\u001b[?2004l\r"]
[1147.710862, "o", "\u001b[?2004h> "]
[1147.710999, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1147.711437, "o", "        if err := json.Unmarshal(req.Args, &args); err != nil {\r\n\u001b[?2004l\r"]
[1147.711653, "o", "\u001b[?2004h> "]
[1147.711797, "o", "            return nil, err\r\n\u001b[?2004l\r\u001b[?2004h"]
[1147.711839, "o", "> "]
[1147.712134, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1147.712529, "o", "        g := s.state.Global()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1147.712896, "o", "        sv, ok := s.state.StatsView(args.Name, g.StatsWindowSec)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1147.7132, "o", "        if !ok {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1147.713497, "o", "            return nil, errors.New(\"service not found\")\r\n\u001b[?2004l\r"]
[1147.713541, "o", "\u001b[?2004h"]
[1147.713573, "o", "> "]
[1147.713785, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1147.713943, "o", "        return sv, nil\r\n\u001b[?2004l\r"]
[1147.714035, "o", "\u001b[?2004h> "]
[1147.714206, "o", "    case \"set_weight\":\r\n\u001b[?2004l\r"]
[1147.714253, "o", "\u001b[?2004h"]
[1147.714303, "o", "> "]
[1147.714501, "o", "        var args struct {\r\n\u001b[?2004l\r"]
[1147.714581, "o", "\u001b[?2004h> "]
[1147.714862, "o", "            Name    string `json:\"name\"`\r\n\u001b[?2004l\r"]
[1147.71494, "o", "\u001b[?2004h> "]
[1147.715241, "o", "            Address string `json:\"address\"`\r\n\u001b[?2004l\r"]
[1147.71532, "o", "\u001b[?2004h> "]
[1147.715629, "o", "            Weight  int    `json:\"weight\"`\r\n\u001b[?2004l\r"]
[1147.71571, "o", "\u001b[?2004h"]
[1147.715788, "o", ">         }\r\n"]
[1147.715863, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1147.71594, "o", "> "]
[1147.716324, "o", "        if err := json.Unmarshal(req.Args, &args); err != nil {\r\n\u001b[?2004l\r"]
[1147.716416, "o", "\u001b[?2004h> "]
[1147.716628, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[1147.716707, "o", "\u001b[?2004h> "]
[1147.71682, "o", "        }\r\n\u001b[?2004l\r"]
[1147.716896, "o", "\u001b[?2004h> "]
[1147.717456, "o", "        if err := s.state.SetWeight(args.Name, args.Address, args.Weight); err != nil {\r\n\u001b[?2004l\r"]
[1147.717537, "o", "\u001b[?2004h> "]
[1147.717749, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[1147.717826, "o", "\u001b[?2004h> "]
[1147.717939, "o", "        }\r\n\u001b[?2004l\r"]
[1147.718015, "o", "\u001b[?2004h> "]
[1147.718213, "o", "        return \"OK\", nil\r\n\u001b[?2004l\r"]
[1147.71829, "o", "\u001b[?2004h> "]
[1147.718513, "o", "    case \"drain_endpoint\":\r\n\u001b[?2004l\r"]
[1147.718592, "o", "\u001b[?2004h> "]
[1147.718792, "o", "        var args struct {\r\n\u001b[?2004l\r"]
[1147.718869, "o", "\u001b[?2004h> "]
[1147.719154, "o", "            Name    string `json:\"name\"`\r\n\u001b[?2004l\r"]
[1147.719237, "o", "\u001b[?2004h> "]
[1147.719553, "o", "            Address string `json:\"address\"`\r\n\u001b[?2004l\r"]
[1147.719636, "o", "\u001b[?2004h> "]
[1147.719742, "o", "        }\r\n\u001b[?2004l\r"]
[1147.719819, "o", "\u001b[?2004h> "]
[1147.720244, "o", "        if err := json.Unmarshal(req.Args, &args); err != nil {\r\n\u001b[?2004l\r"]
[1147.720323, "o", "\u001b[?2004h> "]
[1147.720551, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[1147.720634, "o", "\u001b[?2004h> "]
[1147.720727, "o", "        }\r\n\u001b[?2004l\r"]
[1147.720804, "o", "\u001b[?2004h> "]
[1147.721303, "o", "        if err := s.state.DrainEndpoint(args.Name, args.Address); err != nil {\r\n\u001b[?2004l\r"]
[1147.721381, "o", "\u001b[?2004h> "]
[1147.721602, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[1147.721684, "o", "\u001b[?2004h> "]
[1147.721785, "o", "        }\r\n\u001b[?2004l\r"]
[1147.721863, "o", "\u001b[?2004h> "]
[1147.722063, "o", "        return \"OK\", nil\r\n\u001b[?2004l\r"]
[1147.722144, "o", "\u001b[?2004h> "]
[1147.722346, "o", "    case \"get_health_log\":\r\n\u001b[?2004l\r"]
[1147.722434, "o", "\u001b[?2004h> "]
[1147.722607, "o", "        var args struct {\r\n\u001b[?2004l\r"]
[1147.722646, "o", "\u001b[?2004h"]
[1147.722728, "o", "> "]
[1147.722884, "o", "            Name   string `json:\"name\"`\r\n\u001b[?2004l\r"]
[1147.72295, "o", "\u001b[?2004h"]
[1147.723018, "o", "> "]
[1147.72317, "o", "            LastN  int    `json:\"last_n\"`\r\n\u001b[?2004l\r"]
[1147.723235, "o", "\u001b[?2004h"]
[1147.723301, "o", "> "]
[1147.723363, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1147.723668, "o", "        if err := json.Unmarshal(req.Args, &args); err != nil {\r\n\u001b[?2004l\r"]
[1147.723739, "o", "\u001b[?2004h> "]
[1147.72387, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[1147.723938, "o", "\u001b[?2004h> "]
[1147.724014, "o", "        }\r\n\u001b[?2004l\r"]
[1147.724077, "o", "\u001b[?2004h> "]
[1147.724362, "o", "        return s.state.HealthLogView(args.Name, args.LastN), nil\r\n\u001b[?2004l\r"]
[1147.72444, "o", "\u001b[?2004h> "]
[1147.724597, "o", "    case \"get_circuit_breakers\":\r\n\u001b[?2004l\r"]
[1147.724637, "o", "\u001b[?2004h> "]
[1147.724785, "o", "        var args struct {\r\n\u001b[?2004l\r"]
[1147.724824, "o", "\u001b[?2004h> "]
[1147.725018, "o", "            Name string `json:\"name\"`\r\n\u001b[?2004l\r"]
[1147.725058, "o", "\u001b[?2004h> "]
[1147.72514, "o", "        }\r\n\u001b[?2004l\r"]
[1147.725179, "o", "\u001b[?2004h> "]
[1147.72549, "o", "        if err := json.Unmarshal(req.Args, &args); err != nil {\r\n\u001b[?2004l\r"]
[1147.72556, "o", "\u001b[?2004h"]
[1147.725626, "o", "> "]
[1147.72572, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[1147.725786, "o", "\u001b[?2004h"]
[1147.725854, "o", "> "]
[1147.725922, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1147.72596, "o", "> "]
[1147.726161, "o", "        cv, ok := s.state.CircuitsView(args.Name)\r\n\u001b[?2004l\r"]
[1147.726227, "o", "\u001b[?2004h"]
[1147.726266, "o", "> "]
[1147.726359, "o", "        if !ok {\r\n\u001b[?2004l\r"]
[1147.726435, "o", "\u001b[?2004h> "]
[1147.726672, "o", "            return nil, errors.New(\"service not found\")\r\n\u001b[?2004l\r"]
[1147.726736, "o", "\u001b[?2004h> "]
[1147.726808, "o", "        }\r\n\u001b[?2004l\r"]
[1147.726875, "o", "\u001b[?2004h"]
[1147.726942, "o", "> "]
[1147.727015, "o", "        return cv, nil\r\n\u001b[?2004l\r"]
[1147.727081, "o", "\u001b[?2004h"]
[1147.727149, "o", "> "]
[1147.727267, "o", "    case \"reset_circuit_breaker\":\r\n\u001b[?2004l\r"]
[1147.727333, "o", "\u001b[?2004h"]
[1147.727411, "o", "> "]
[1147.727498, "o", "        var args struct {\r\n\u001b[?2004l\r"]
[1147.727566, "o", "\u001b[?2004h"]
[1147.727633, "o", "> "]
[1147.72778, "o", "            Name    string `json:\"name\"`\r\n\u001b[?2004l\r"]
[1147.727842, "o", "\u001b[?2004h> "]
[1147.728051, "o", "            Address string `json:\"address\"`\r\n\u001b[?2004l\r"]
[1147.728118, "o", "\u001b[?2004h> "]
[1147.728188, "o", "        }\r\n\u001b[?2004l\r"]
[1147.728251, "o", "\u001b[?2004h> "]
[1147.728547, "o", "        if err := json.Unmarshal(req.Args, &args); err != nil {\r\n\u001b[?2004l\r"]
[1147.72861, "o", "\u001b[?2004h> "]
[1147.728752, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[1147.72885, "o", "\u001b[?2004h> "]
[1147.728946, "o", "        }\r\n\u001b[?2004l\r"]
[1147.729034, "o", "\u001b[?2004h> "]
[1147.729418, "o", "        if err := s.state.ResetCircuitBreaker(args.Name, args.Address); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1147.729622, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[1147.729857, "o", "\u001b[?2004h"]
[1147.7299, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1147.730058, "o", "        return \"OK\", nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1147.730282, "o", "    case \"reload_config\":\r\n"]
[1147.730452, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1147.73071, "o", "        path := s.state.ConfigPath()\r\n\u001b[?2004l\r"]
[1147.730823, "o", "\u001b[?2004h> "]
[1147.731137, "o", "        cfg, err := config.Load(path)\r\n\u001b[?2004l\r"]
[1147.731279, "o", "\u001b[?2004h> "]
[1147.731418, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1147.731624, "o", "            return nil, err\r\n\u001b[?2004l\r"]
[1147.731699, "o", "\u001b[?2004h> "]
[1147.731757, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1147.731814, "o", "> "]
[1147.731956, "o", "        s.state.ApplyConfig(cfg)\r\n\u001b[?2004l\r"]
[1147.732021, "o", "\u001b[?2004h> "]
[1147.732178, "o", "        return \"OK\", nil\r\n\u001b[?2004l\r"]
[1147.732239, "o", "\u001b[?2004h> "]
[1147.732335, "o", "    default:\r\n\u001b[?2004l\r"]
[1147.732382, "o", "\u001b[?2004h> "]
[1147.732707, "o", "        return nil, fmt.Errorf(\"unknown command: %s\", req.Cmd)\r\n\u001b[?2004l\r"]
[1147.732778, "o", "\u001b[?2004h> "]
[1147.732834, "o", "    }\r\n\u001b[?2004l\r"]
[1147.732889, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1147.732944, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1147.733004, "o", "\u001b[?2004h> "]
[1147.733068, "o", "func init() {\r\n\u001b[?2004l\r"]
