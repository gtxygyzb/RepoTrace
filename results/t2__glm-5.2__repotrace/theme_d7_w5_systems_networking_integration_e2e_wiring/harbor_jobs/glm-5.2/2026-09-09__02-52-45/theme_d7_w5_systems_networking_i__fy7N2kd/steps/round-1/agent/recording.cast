[10713.111715, "o", "\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype Entry struct\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tTs          string `json:\"ts\"`\r\n\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tService     string `json:\"service\"`\r\n\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tClient      string `json:\"client\"`\r\n\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tEndpoint    string `json:\"endpoint\"`\r\n\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tBytesIn     int64  `json:\"bytes_in\"`"]
[10713.111816, "o", "\r\n\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tBytesOut    int64  `json:\"bytes_out\"`\r\n\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tDurationMs  int64  `json:\"duration_ms\"`\r\n\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tResult      string `json:\"result\"`\r\n\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRetried     bool   `json:\"retried\"`\r\n\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRetryCount  int    `json:\"retry_count\"`\r\n\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tQueueWaitMs *int64 `json:\"queue_wait_ms,omitempty\"`\r\n\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// DefaultPath is the access log path required by meshrouter.\r\n\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kconst DefaultPath = \"/app/logs/access.log\"\r\n\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kconst maxFileSize = 1 << 20 // 1 MB\r\n\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// Logger writes access log entries asynchronously to a JSON-lines file.\r\n"]
[10713.111905, "o", "\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Ktype Logger struct {\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tpath     string\r\n\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tch       chan Entry\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tstop     chan struct{}\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdone     chan struct{}\r\n\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tstopped  int32\r\n"]
