[10640.39101, "o", "package state\r\n\r\nimport (\r\n\t\"net\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n\t\"sync/atomic\"\r\n\t\"time\"\r\n"]
[10640.391071, "o", "\r\n\t\"meshrouter/internal/circuit\"\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/stats\"\r\n)\r\n\r\ntype HealthState string\r\n\r\nconst (\r\n\tUnknown   HealthState = \"unknown\"\r\n\tHealthy   HealthState = \"healthy\"\r\n"]
[10640.391125, "o", "\tUnhealthy HealthState = \"unhealthy\"\r\n\tDraining  HealthState = \"draining\"\r\n)\r\n\r\ntype HealthEvent struct {\r\n\tTimestamp   time.Time\r\n\tEndpoint    string\r\n\tOldState    HealthState\r\n\tNewState    HealthState\r\n\tCheckResult string\r\n}\r\n"]
[10640.391175, "o", "\r\ntype EndpointState struct {\r\n\tmu                sync.Mutex\r\n\tAddress           string\r\n\tWeight            int\r\n\tConfig            config.Endpoint\r\n\tState             HealthState\r\n\tActiveConnections int\r\n\tCircuit           *circuit.Breaker\r\n"]
[10640.391224, "o", "\tStats             *stats.Collector\r\n\tconsecSuccess     int\r\n\tconsecFailures    int\r\n\tdrainDeadline     time.Time\r\n\tremoved           bool\r\n\tconnIDCounter     int64\r\n\tcurrentWeight     int\r\n"]
[10640.391278, "o", "\tWarmupDurationMs  int\r\n\twarmupUntil       time.Time\r\n\tconnections       map[int64]*connectionInfo\r\n}\r\n\r\ntype connectionInfo struct {\r\n\tconn         net.Conn\r\n"]
[10640.391326, "o", "\tclientAddr   string\r\n\tstart        time.Time\r\n\tlastActivity time.Time\r\n\tbytesIn      int64\r\n\tbytesOut     int64\r\n}\r\n\r\ntype ServiceState struct {\r\n"]
[10640.391375, "o", "\tmu                        sync.Mutex\r\n\tName                      string\r\n\tListenPort                int\r\n\tRoutingMode               string\r\n\tDrainTimeoutMs            int\r\n\tMaxConnectionsPerEndpoint int\r\n\tConnectionLimitMode       string\r\n\tIdleTimeoutMs             int\r\n\tRateLimitRps              int"]
[10640.391446, "o", "\r\n\tRateLimitBurst            int\r\n\tRateLimitQueueDepth       int\r\n\tRateLimitQueueTimeoutMs   int\r\n\tMaxRetries                int\r\n\tRetryDelayMs              int\r\n\tRetryBackoffMultiplier    float64\r\n\tRetryMaxDelayMs           int\r\n\trateLimiter               *rateLimiter\r\n\tEndpoints                 []*EndpointState\r\n"]
[10640.391495, "o", "\trrIndex                   int\r\n\tListener                  net.Listener\r\n\tlistenerStop              chan struct{}\r\n\tstopping                  bool\r\n}\r\n\r\ntype State struct {\r\n\tmu         sync.RWMutex\r\n\tconfigPath string\r\n\tglobal     config.Global\r\n\t"]
[10640.391543, "o", "services   map[string]*ServiceState\r\n\tlogMu      sync.Mutex\r\n\thealthLog  map[string][]HealthEvent\r\n\treloadCh   chan struct{}\r\n}\r\n\r\nfunc NewState(cfg *config.Config, path string) *State {\r\n\ts := &State{\r\n"]
[10640.39159, "o", "\t\tconfigPath: path,\r\n\t\tservices:   make(map[string]*ServiceState),\r\n\t\thealthLog:  make(map[string][]HealthEvent),\r\n\t\treloadCh:   make(chan struct{}, 1),\r\n\t}\r\n\t"]
[10640.391637, "o", "s.applyConfigLocked(cfg)\r\n\treturn s\r\n}\r\n\r\nfunc (s *State) ReloadChan() <-chan struct{} {\r\n\treturn s.reloadCh\r\n}\r\n\r\nfunc (s *State) ConfigPath() string {\r\n\ts.mu.RLock()\r\n"]
[10640.391685, "o", "\tdefer s.mu.RUnlock()\r\n\treturn s.configPath\r\n}\r\n\r\nfunc (s *State) Global() config.Global {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.global\r\n}\r\n\r\nfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n"]
[10640.391734, "o", "\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n\ts.applyConfigLocked(cfg)\r\n\tselect {\r\n\tcase s.reloadCh <- struct{}{}:\r\n\tdefault:\r\n\t}\r\n"]
[10640.391781, "o", "}\r\n\r\nfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n\ts.global = cfg.Global\r\n\tseen := make(map[string]bool)\r\n\tfor _, svc := range cfg.Services {\r\n\t\tseen[svc.Name] = true\r\n\t\tss := s.services[svc.Name]\r\n"]
[10640.391831, "o", "\t\tif ss == nil {\r\n\t\t\tss = newServiceState(svc, cfg.Global)\r\n\t\t\ts.services[svc.Name] = ss\r\n\t\t} else {\r\n\t\t\tss.mu.Lock()\r\n\t\t\tss.Name = svc.Name\r\n\t\t\tss.ListenPort = svc.ListenPort\r\n"]
[10640.391877, "o", "\t\t\tss.RoutingMode = svc.RoutingMode\r\n\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n\t\t\tss.RateLimitRps = svc.RateLimitRps\r\n\t\t\tss.RateLimitBurst = svc.RateLimitBurst\r\n\t\t\tss.RateLimitQueueDepth = svc.RateLimitQueueDepth\r\n"]
[10640.391925, "o", "\t\t\tss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs\r\n\t\t\tss.MaxRetries = svc.MaxRetries\r\n\t\t\tss.RetryDelayMs = svc.RetryDelayMs\r\n\t\t\tss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier\r\n\t\t\tss.RetryMaxDelayMs = svc.RetryMaxDelayMs\r\n\t\t\tif ss.rateLimiter == nil {\r\n\t\t\t\tss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n\t\t\t} else {"]
[10640.391973, "o", "\r\n\t\t\t\tss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n\t\t\t}\r\n\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n\t\t\tss.ConnectionLimitMode = svc.ConnectionLimitMode\r\n"]
[10640.392024, "o", "\t\t\tss.IdleTimeoutMs = svc.IdleTimeoutMs\r\n\t\t\tss.mu.Unlock()\r\n\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n\t\t}\r\n\t}\r\n\tfor name, ss := range s.services {\r\n\t\tif !seen[name] {\r\n\t\t\tss.mu.Lock()\r\n\t\t\tss.stopping = true\r\n\t\t\tif ss.listenerStop != nil {\r\n"]
[10640.392071, "o", "\t\t\t\tclose(ss.listenerStop)\r\n\t\t\t\tss.listenerStop = nil\r\n\t\t\t}\r\n\t\t\tif ss.Listener != nil {\r\n\t\t\t\tss.Listener.Close()\r\n\t\t\t\tss.Listener = nil\r\n"]
[10640.392116, "o", "\t\t\t}\r\n\t\t\tss.mu.Unlock()\r\n\t\t\tfor _, ep := range ss.Endpoints {\r\n\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n\t\t\t}\r\n\t\t}\r\n"]
[10640.392165, "o", "\t}\r\n}\r\n\r\nfunc newServiceState(svc config.Service, global config.Global) *ServiceState {\r\n\tss := &ServiceState{\r\n\t\tName:                      svc.Name,\r\n\t\tListenPort:                svc.ListenPort,\r\n\t\tRoutingMode:               svc.RoutingMode,\r\n\t\tDrainTimeoutMs:            svc.DrainTimeoutMs,\r\n"]
[10640.392215, "o", "\t\tRateLimitRps:              svc.RateLimitRps,\r\n\t\tRateLimitBurst:            svc.RateLimitBurst,\r\n\t\tRateLimitQueueDepth:       svc.RateLimitQueueDepth,\r\n\t\tRateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,\r\n\t\tMaxRetries:                svc.MaxRetries,\r\n\t\tRetryDelayMs:              svc.RetryDelayMs,\r\n\t\tRetryBackoffMultiplier:    svc.RetryBackoffMultiplier,\r\n\t\tRetryMaxDelayMs:           svc.RetryMaxDelayMs,\r\n"]
[10640.392264, "o", "\t\trateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),\r\n\t\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n\t\tConnectionLimitMode:       svc.ConnectionLimitMode,\r\n\t\tIdleTimeoutMs:             svc.IdleTimeoutMs,\r\n\t\tlistenerStop:              nil,\r\n\t}\r\n\tfor _, ep := range svc.Endpoints {\r\n\t\t"]
[10640.392312, "o", "ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))\r\n\t}\r\n\treturn ss\r\n}\r\n\r\nfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n\tss.mu.Lock()\r\n\tdefer ss.mu.Unlock()\r\n\tseen := make(map[string]bool)\r\n\t"]
[10640.392358, "o", "for _, cep := range eps {\r\n\t\tseen[cep.Address] = true\r\n\t\tvar ep *EndpointState\r\n"]
[10640.393, "o", "\u001b[?2004h"]
[10640.393051, "o", "root@n30009:/app# "]
[10640.710503, "i", "sed -n '1,80p' internal/accesslog/logger.go\n"]
[10640.7109, "o", "sed -n '1,80p' internal/accesslog/logger.go\r\n"]
[10640.710958, "o", "\u001b[?2004l\r"]
[10640.714415, "o", "package accesslog\r\n\r\nimport (\r\n\t"]
[10640.71448, "o", "\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sync\"\r\n\t\"sync/atomic\"\r\n\t\"time\"\r\n)\r\n\r\n// Entry is one structured access log record.\r\ntype Entry struct {\r\n\tTs          string `json:\"ts\"`\r\n\tService     string `json:\"service\"`\r\n\t"]
[10640.714535, "o", "Client      string `json:\"client\"`\r\n\tEndpoint    string `json:\"endpoint\"`\r\n\tBytesIn     int64  `json:\"bytes_in\"`\r\n\tBytesOut    int64  `json:\"bytes_out\"`\r\n\tDurationMs  int64  `json:\"duration_ms\"`\r\n\tResult      string `json:\"result\"`\r\n\tRetried     bool   `json:\"retried\"`\r\n\tRetryCount  int    `json:\"retry_count\"`\r\n"]
[10640.714588, "o", "\tQueueWaitMs *int64 `json:\"queue_wait_ms,omitempty\"`\r\n}\r\n\r\n// DefaultPath is the access log path required by meshrouter.\r\nconst DefaultPath = \"/app/logs/access.log\"\r\n\r\nconst maxFileSize = 1 << 20 // 1 MB\r\n\r\n// Logger writes access log entries asynchronously to a JSON-lines file.\r\ntype Logger struct {\r\n\tpath     string\r\n\tch       chan Entry\r\n\t"]
[10640.714638, "o", "stop     chan struct{}\r\n\tdone     chan struct{}\r\n\tstopped  int32\r\n\tstopOnce sync.Once\r\n\tmu       sync.Mutex\r\n\tfile     *os.File\r\n\tsize     int64\r\n}\r\n"]
[10640.714686, "o", "\r\n// New creates a Logger for path and starts its writer goroutine.\r\nfunc New(path string) *Logger {\r\n\tif path == \"\" {\r\n\t\tpath = DefaultPath\r\n\t}\r\n\tl := &Logger{\r\n\t\tpath: path,\r\n\t\t"]
[10640.714735, "o", "ch:   make(chan Entry, 8192),\r\n\t\tstop: make(chan struct{}),\r\n\t\tdone: make(chan struct{}),\r\n\t}\r\n\tgo l.run()\r\n\treturn l\r\n}\r\n\r\n// Path returns the configured log file path.\r\n"]
[10640.714785, "o", "func (l *Logger) Path() string {\r\n\treturn l.path\r\n}\r\n\r\n// Log queues an entry for asynchronous writing. If the buffered channel is full,\r\n// the entry is written synchronously to avoid losing it.\r\nfunc (l *Logger) Log(entry Entry) {\r\n\tif atomic.LoadInt32(&l.stopped) != 0 {\r\n\t\treturn\r\n"]
[10640.714844, "o", "\t}\r\n\tentry.Ts = time.Now().UTC().Format(time.RFC3339Nano)\r\n\tselect {\r\n\tcase l.ch <- entry:\r\n\tdefault:\r\n\t\tl.writeLine(entry)\r\n\t}\r\n}\r\n\r\n// Stop flushes all buffered entries and closes the log file.\r\n"]
[10640.714893, "o", "func (l *Logger) Stop() {\r\n"]
[10640.715429, "o", "\u001b[?2004h"]
[10640.715478, "o", "root@n30009:/app# "]
[10641.051641, "i", "sed -n '1,180p' internal/stats/stats.go\n"]
[10641.051997, "o", "sed -n '1,180p' internal/stats/stats.go\r\n\u001b[?2004l\r"]
[10641.055083, "o", "package stats\r\n\r\nimport (\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\ntype entry struct {\r\n\ttimestamp time.Time\r\n\tbytesIn   int64\r\n\tbytesOut  int64\r\n"]
[10641.055178, "o", "\tlatency   time.Duration\r\n\terr       bool\r\n}\r\n\r\n// Collector keeps rolling connection statistics for one endpoint.\r\ntype Collector struct {\r\n\tmu         sync.Mutex\r\n\twindow     time.Duration\r\n\tentries    []entry\r\n\trejections []time.Time\r\n\r\n\trateLimited    int\r\n\tqueued         int\r\n\tqueueTimeouts  int\r\n\tretries        int\r\n\t"]
[10641.055232, "o", "retrySuccesses int\r\n\tidleTimeouts   int\r\n}\r\n\r\n// New creates a collector with the given window length.\r\nfunc New(window time.Duration) *Collector {\r\n\tif window <= 0 {\r\n\t\twindow = time.Minute\r\n\t}\r\n\treturn &Collector{window: window}\r\n}\r\n"]
[10641.055292, "o", "\r\n// RecordConnection records a finished connection attempt.\r\nfunc (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\r\n\tc.trim(now)\r\n}\r\n\r\n"]
[10641.055341, "o", "// RecordRejection records a rejected connection because the endpoint was at capacity.\r\nfunc (c *Collector) RecordRejection() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tc.rejections = append(c.rejections, now)\r\n\tc.trim(now)\r\n"]
[10641.055436, "o", "}\r\n\r\n// RecordRateLimited records a rate limit rejection.\r\nfunc (c *Collector) RecordRateLimited() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.rateLimited++\r\n}\r\n\r\n// RecordQueued records a connection that was queued waiting for a token.\r\nfunc (c *Collector) RecordQueued() {\r\n\tc.mu.Lock()\r\n"]
[10641.055497, "o", "\tdefer c.mu.Unlock()\r\n\tc.queued++\r\n}\r\n\r\n// RecordQueueTimeout records a queue timeout rejection.\r\nfunc (c *Collector) RecordQueueTimeout() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.queueTimeouts++\r\n\tc.rateLimited++\r\n}\r\n\r\n// RecordRetry records a retry attempt.\r\nfunc (c *Collector) RecordRetry() {\r\n\tc.mu.Lock()\r\n\t"]
[10641.055547, "o", "defer c.mu.Unlock()\r\n\tc.retries++\r\n}\r\n\r\n// RecordRetrySuccess records a successful retry attempt.\r\nfunc (c *Collector) RecordRetrySuccess() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\t"]
[10641.055603, "o", "c.retrySuccesses++\r\n}\r\n\r\n// RecordIdleTimeout records a connection that was closed because it was idle.\r\nfunc (c *Collector) RecordIdleTimeout() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.idleTimeouts++\r\n}\r\n\r\n"]
[10641.055652, "o", "func (c *Collector) trim(now time.Time) {\r\n\tcutoff := now.Add(-c.window)\r\n\ti := 0\r\n\tfor i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {\r\n\t\ti++\r\n\t}\r\n\tif i > 0 {\r\n\t\tc.entries = c.entries[i:]\r\n"]
[10641.055699, "o", "\t}\r\n\tj := 0\r\n\tfor j < len(c.rejections) && c.rejections[j].Before(cutoff) {\r\n\t\tj++\r\n\t}\r\n\tif j > 0 {\r\n\t\tc.rejections = c.rejections[j:]\r\n"]
[10641.055748, "o", "\t}\r\n}\r\n\r\n// Snapshot returns current windowed stats. active is supplied by the state manager.\r\nfunc (c *Collector) Snapshot(active int) Snapshot {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tcutoff := now.Add(-c.window)\r\n\tvar total int\r\n\tvar bytesIn, bytesOut int64\r\n"]
[10641.0558, "o", "\tvar latencySum time.Duration\r\n\tvar errors int\r\n\tfor _, e := range c.entries {\r\n\t\tif e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {\r\n\t\t\ttotal++\r\n\t\t\tbytesIn += e.bytesIn\r\n\t\t\tbytesOut += e.bytesOut\r\n"]
[10641.055855, "o", "\t\t\tlatencySum += e.latency\r\n\t\t\tif e.err {\r\n\t\t\t\terrors++\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\trejected := 0\r\n\tfor _, t := range c.rejections {\r\n\t\tif t.After(cutoff) || t.Equal(cutoff) {\r\n"]
[10641.05591, "o", "\t\t\trejected++\r\n\t\t}\r\n\t}\r\n\tvar avg float64\r\n\tif total > 0 {\r\n\t\tavg = float64(latencySum.Milliseconds()) / float64(total)\r\n\t}\r\n\treturn Snapshot{\r\n\t\tTotalConnections:    total,"]
[10641.055964, "o", "\r\n\t\tActiveConnections:   active,\r\n\t\tBytesIn:             bytesIn,\r\n\t\tBytesOut:            bytesOut,\r\n\t\tAvgLatencyMs:        avg,\r\n\t\tErrors:              errors,\r\n\t\tRejectedConnections: rejected,\r\n\t\tRateLimited:         c.rateLimited,\r\n"]
[10641.056017, "o", "\t\tQueued:              c.queued,\r\n\t\tQueueTimeouts:       c.queueTimeouts,\r\n\t\tRetries:             c.retries,\r\n\t\tRetrySuccesses:      c.retrySuccesses,\r\n\t\tIdleTimeouts:        c.idleTimeouts,\r\n\t}\r\n}\r\n\r\n"]
[10641.056066, "o", "// Snapshot is a JSON-friendly stats view.\r\ntype Snapshot struct {\r\n\tTotalConnections    int     `json:\"total_connections\"`\r\n\tActiveConnections   int     `json:\"active_connections\"`\r\n\tBytesIn             int64   `json:\"bytes_in\"`\r\n\tBytesOut            int64   `json:\"bytes_out\"`\r\n\tAvgLatencyMs        float64 `json:\"avg_latency_ms\"`\r\n\tErrors              int     `json:\"errors\"`\r\n"]
[10641.056123, "o", "\tRejectedConnections int     `json:\"rejected_connections\"`\r\n\tRateLimited         int     `json:\"rate_limited\"`\r\n\tQueued              int     `json:\"queued\"`\r\n\tQueueTimeouts       int     `json:\"queue_timeouts\"`\r\n\tRetries             int     `json:\"retries\"`\r\n\tRetrySuccesses      int     `json:\"retry_successes\"`\r\n\tIdleTimeouts        int     `json:\"idle_timeouts\"`\r\n"]
[10641.056673, "o", "\u001b[?2004h"]
[10641.056728, "o", "root@n30009:/app# "]
[10641.341626, "i", "sed -n '1,220p' cmd/meshctl/main.go\n"]
[10641.341941, "o", "sed -n '1,220p' cmd/meshctl/main.go\r\n"]
[10641.342002, "o", "\u001b[?2004l\r"]
[10641.343743, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"net\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\ntype request struct {\r\n\tCmd  string          `json:\"cmd\"`\r\n\tArgs json.RawMessage `json:\"args\"`\r\n}\r\n\r\ntype response struct {\r\n\tStatus string          `json:\"status\"`\r\n"]
[10641.343801, "o", "\tData   json.RawMessage `json:\"data\"`\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl <command> [args]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcliCmd := os.Args[1]\r\n\targs := make(map[string]interface{})\r\n\tvar ipcCmd string\r\n\r\n\tswitch cliCmd {\r\n\tcase \"status\":\r\n\t\tipcCmd = \"list_services\"\r\n\tcase \"stats\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\t"]
[10641.343854, "o", "fmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_stats\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"set-weight\":\r\n\t\tif len(os.Args) < 5 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tweight, err := strconv.Atoi(os.Args[4])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid weight: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
[10641.343905, "o", "\t\tipcCmd = \"set_weight\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\targs[\"address\"] = os.Args[3]\r\n\t\targs[\"weight\"] = weight\r\n\tcase \"drain\":\r\n\t\tif len(os.Args) < 4 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"drain_endpoint\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\targs[\"address\"] = os.Args[3]\r\n\tcase \"health-log\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
[10641.343958, "o", "\t\tipcCmd = \"get_health_log\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\tlast := 20\r\n\t\tfor _, a := range os.Args[3:] {\r\n\t\t\tif strings.HasPrefix(a, \"--last\") && len(a) > 6 {\r\n\t\t\t\tif v, err := strconv.Atoi(a[6:]); err == nil {\r\n\t\t\t\t\tlast = v\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\targs[\"last_n\"] = last\r\n\tcase \"resolve\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl resolve <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"resolve\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"circuits\":\r\n"]
[10641.344012, "o", "\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_circuit_breakers\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"reset-circuit\":\r\n\t\tif len(os.Args) < 4 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl reset-circuit <service> <endpoint>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"reset_circuit_breaker\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n"]
[10641.344063, "o", "\t\targs[\"address\"] = os.Args[3]\r\n\tcase \"reload\":\r\n\t\tipcCmd = \"reload_config\"\r\n\tcase \"rate-limit\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl rate-limit <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_rate_limit_status\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"warmup\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl warmup <service>\")\r\n\t\t\tos.Exit(1)\r\n"]
[10641.344114, "o", "\t\t}\r\n\t\tipcCmd = \"get_warmup_status\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"connections\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl connections <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_connections\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"set-rate-limit\":\r\n\t\tif len(os.Args) < 5 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-rate-limit <service> <rps> <burst>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\trps, err := strconv.Atoi(os.Args[3])"]
[10641.344167, "o", "\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid rps: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tburst, err := strconv.Atoi(os.Args[4])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid burst: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"set_rate_limit\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\targs[\"rps\"] = rps\r\n\t\targs[\"burst\"] = burst\r\n\tcase \"access-log\":\r\n\t\tipcCmd = \"get_access_log\"\r\n\t\tlast := 20\r\n\t\trest := os.Args[2:]\r\n\t\tfor i := 0; i < len(rest); i++ {\r\n\t\t\ta := rest[i]\r\n"]
[10641.344219, "o", "\t\t\tif a == \"--last\" {\r\n\t\t\t\tif i+1 < len(rest) {\r\n\t\t\t\t\tif v, err := strconv.Atoi(rest[i+1]); err == nil {\r\n\t\t\t\t\t\tlast = v\r\n\t\t\t\t\t}\r\n\t\t\t\t\ti++\r\n\t\t\t\t}\r\n\t\t\t} else if strings.HasPrefix(a, \"--last=\") {\r\n\t\t\t\tif v, err := strconv.Atoi(a[len(\"--last=\"):]); err == nil {\r\n\t\t\t\t\tlast = v\r\n\t\t\t\t}\r\n\t\t\t} else if a == \"--result\" {\r\n\t\t\t\tif i+1 < len(rest) {\r\n\t\t\t\t\targs[\"result\"] = rest[i+1]\r\n"]
[10641.344267, "o", "\t\t\t\t\ti++\r\n\t\t\t\t}\r\n\t\t\t} else if strings.HasPrefix(a, \"--result=\") {\r\n\t\t\t\targs[\"result\"] = a[len(\"--result=\"):]\r\n\t\t\t} else if !strings.HasPrefix(a, \"-\") {\r\n\t\t\t\targs[\"service\"] = a\r\n\t\t\t}\r\n\t\t}\r\n\t\targs[\"last_n\"] = last\r\n\tcase \"access-stats\":\r\n\t\tipcCmd = \"get_access_stats\"\r\n\t\tfor _, a := range os.Args[2:] {\r\n\t\t\tif !strings.HasPrefix(a, \"-\") {\r\n\t\t\t\targs[\"service\"] = a\r\n\t\t\t}\r\n"]
[10641.344317, "o", "\t\t}\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cliCmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tdata, err := sendCommand(ipcCmd, args)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Println(data)\r\n}\r\n\r\nfunc sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n\trawArgs, err := json.Marshal(args)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\treq := request{Cmd: ipcCmd, Args: rawArgs}\r\n"]
[10641.344367, "o", "\treqBytes, err := json.Marshal(req)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\r\n\tconn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\tif err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n\t}\r\n\tdefer conn.Close()\r\n\r\n\tfmt.Fprintf(conn, \"%s\\n\", string(reqBytes))\r\n\r\n\treader := bufio.NewReader(conn)\r\n\tline, err := reader.ReadString('\\n')\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tline = strings.TrimRight(line, \"\\r\\n\")\r\n\r\n"]
