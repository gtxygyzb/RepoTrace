[8646.141712, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path(\"internal/router/router.go\")\ns = p.read_text()\n\nold = '''type Router struct {\n\\tstate     *state.State\n\\tmu        sync.Mutex\n\\tlisteners map[string]*serviceListener\n}\n'''\nnew = '''type Router struct {\n\\tstate     *state.State\n\\taccessLog *accesslog.Logger\n\\tmu        sync.Mutex\n\\tlisteners map[string]*serviceListener\n}\n'''\nif old not in s:\n    raise SystemExit(\"struct block not found\")\ns = s.replace(old, new)\n\nold = '''func NewRouter(s *state.State) *Router {\n\\treturn &Router{\n\\t\\tstate:     s,\n\\t\\tlisteners: make(map[string]*serviceListener),\n\\t}\n}\n'''\nnew = '''func NewRouter(s *state.State) *Router {\n\\treturn &Router{\n\\t\\tstate:     s,\n\\t\\tlisteners: make(map[string]*serviceListener),\n\\t}\n}\n\nfunc (r *Router) SetAccessLogger(l *accesslog.Logger) {\n\\tr.accessLog = l\n}\n'''\nif old not in s:\n    raise SystemExit(\"NewRouter block not found\")\ns = s.replace(old, new)\n\np.write_text(s)\nPY\n"]
