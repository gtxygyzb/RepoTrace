[4333.085715, "o", "   109\t// Snapshot returns current windowed stats. active is supplied by the state manager.\r\n   110\tfunc (c *Collector) Snapshot(active int) Snapshot {\r\n   111\t\tc.mu.Lock()\r\n   112\t\tdefer c.mu.Unlock()\r\n   113\t\tnow := time.Now()\r\n   114\t\tcutoff := now.Add(-c.window)\r\n   115\t\tvar total int\r\n"]
[4333.08584, "o", "   116\t\tvar bytesIn, bytesOut int64\r\n   117\t\tvar latencySum time.Duration\r\n   118\t\tvar errors int\r\n   119\t\tfor _, e := range c.entries {\r\n   120\t\t\tif e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {\r\n   121\t\t\t\ttotal++\r\n   122\t\t\t\tbytesIn += e.bytesIn\r\n   123\t\t\t\tbytesOut += e.bytesOut\r\n   124\t\t\t\tlatencySum += e.latency\r\n   125\t\t\t\tif e.err {\r\n   126\t\t\t\t\terrors++\r\n   127\t\t\t\t}\r\n   128\t\t\t}\r\n   129\t\t}\r\n   130\t\trejected := 0\r\n   131\t\tfor _, t := range c.rejections {\r\n   132\t\t\tif t.After(cutoff) || t.Equal(cutoff) {\r\n"]
[4333.085912, "o", "   133\t\t\t\trejected++\r\n   134\t\t\t}\r\n   135\t\t}\r\n   136\t\tvar avg float64\r\n   137\t\tif total > 0 {\r\n   138\t\t\tavg = float64(latencySum.Milliseconds()) / float64(total)\r\n   139\t\t}\r\n   140\t\treturn Snapshot{\r\n   141\t\t\tTotalConnections:    total,\r\n   142\t\t\tActiveConnections:   active,\r\n   143\t\t\tBytesIn:             bytesIn,"]
[4333.086031, "o", "\r\n   144\t\t\tBytesOut:            bytesOut,\r\n   145\t\t\tAvgLatencyMs:        avg,\r\n   146\t\t\tErrors:              errors,\r\n   147\t\t\tRejectedConnections: rejected,\r\n   148\t\t\tRateLimited:         c.rateLimited,\r\n   149\t\t\tQueued:              c.queued,\r\n   150\t\t\tQueueTimeouts:       c.queueTimeouts,\r\n   151\t\t\tRetries:             c.retries,\r\n   152\t\t\tRetrySuccesses:      c.retrySuccesses,\r\n   153\t\t}\r\n   154\t}\r\n   155\t\r\n   156\t// Snapshot is a JSON-friendly stats view.\r\n   157\ttype Snapshot struct {\r\n   158"]
[4333.086095, "o", "\t\tTotalConnections    int     `json:\"total_connections\"`\r\n   159\t\tActiveConnections   int     `json:\"active_connections\"`\r\n   160\t\tBytesIn             int64   `json:\"bytes_in\"`\r\n   161\t\tBytesOut            int64   `json:\"bytes_out\"`\r\n   162\t\tAvgLatencyMs        float64 `json:\"avg_latency_ms\"`\r\n   163\t\tErrors              int     `json:\"errors\"`\r\n   164\t\tRejectedConnections int     `json:\"rejected_connections\"`\r\n   165\t\tRateLimited         int     `json:\"rate_limited\"`\r\n"]
[4333.08616, "o", "   166\t\tQueued              int     `json:\"queued\"`\r\n   167\t\tQueueTimeouts       int     `json:\"queue_timeouts\"`\r\n   168\t\tRetries             int     `json:\"retries\"`\r\n   169\t\tRetrySuccesses      int     `json:\"retry_successes\"`\r\n   170\t}\r\n"]
