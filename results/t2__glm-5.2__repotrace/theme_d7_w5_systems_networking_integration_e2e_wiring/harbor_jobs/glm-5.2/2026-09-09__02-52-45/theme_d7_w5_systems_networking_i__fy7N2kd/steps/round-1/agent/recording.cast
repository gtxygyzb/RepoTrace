[4594.938948, "o", "s = s.replace('''func (ep *EndpointState) AddConnection(conn net.Conn) int64 {\\n\\tep.mu.Lock()\\n\\tdefer ep.mu.Unlock()\\n\\tid := atomic.AddInt64(&ep.connIDCounter, 1)\\n\\tep.connections[id] = conn\\n\\tep.ActiveConnections++\\n\\treturn id\\n}''',\r\n\u001b[?2004l\r"]
[4594.939007, "o", "\u001b[?2004h> "]
[4594.941048, "o", "'''func (ep *EndpointState) AddConnection(conn net.Conn) int64 {\\n\\tep.mu.Lock()\\n\\tdefer ep.mu.Unlock()\\n\\tid := atomic.AddInt64(&ep.connIDCounter, 1)\\n\\tnow := time.Now()\\n\\tep.connections[id] = &connectionInfo{\\n\\t\\tconn:         conn,\\n\\t\\tclientAddr:   remoteAddr(conn),\\n\\t\\tstart:        now,\\n\\t\\tlastActivity: now,\\n\\t}\\n\\tep.ActiveConnections++\\n\\treturn id\\n}''')\r\n\u001b[?2004l\r"]
[4594.941123, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4594.941174, "o", "\u001b[?2004h"]
