[5719.44281, "o", "State:       Unknown,\r\n   245\t\t\tCircuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n   246\t\t\tStats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n   247\t\t\tconnections: make(map[int64]*connectionInfo),\r\n   248\t\t}\r\n   249\t}\r\n   250\t\r\n   251\tfunc (s *State) GetService(name string) *ServiceState {\r\n   252\t\ts.mu.RLock()\r\n   253\t\tdefer s.mu.RUnlock()\r\n"]
[5719.442886, "o", "   254\t\treturn s.services[name]\r\n   255\t}\r\n   256\t\r\n   257\tfunc (s *State) Services() []*ServiceState {\r\n   258\t\ts.mu.RLock()\r\n   259\t\tdefer s.mu.RUnlock()\r\n   260\t\tout := make([]*ServiceState, 0, len(s.services))\r\n   261\t\tfor _, ss := range s.services {\r\n   262\t\t\tout = append(out, ss)\r\n   263\t\t}\r\n   264\t\treturn out\r\n   265"]
[5719.442955, "o", "\t}\r\n   266\t\r\n   267\tfunc (s *State) GetEndpoint(service, address string) *EndpointState {\r\n   268\t\tss := s.GetService(service)\r\n   269\t\tif ss == nil {\r\n"]
[5719.443017, "o", "   270\t\t\treturn nil\r\n   271\t\t}\r\n   272\t\tss.mu.Lock()\r\n   273\t\tdefer ss.mu.Unlock()\r\n   274\t\tfor _, ep := range ss.Endpoints {\r\n   275\t\t\tif ep.Address == address {\r\n   276\t\t\t\treturn ep\r\n   277\t\t\t}\r\n   278\t\t}\r\n   279\t\treturn nil\r\n   280\t}\r\n   281\t\r\n   282\t"]
[5719.443081, "o", "func (s *State) SetWeight(service, address string, weight int) error {\r\n   283\t\tep := s.GetEndpoint(service, address)\r\n   284\t\tif ep == nil {\r\n   285\t\t\treturn errNotFound(\"endpoint not found\")\r\n   286\t\t}\r\n   287\t\tep.mu.Lock()\r\n   288\t\tdefer ep.mu.Unlock()\r\n   289\t\tif weight < 0 {\r\n   290\t\t\tweight = 0\r\n"]
[5719.443146, "o", "   291\t\t}\r\n   292\t\tep.Weight = weight\r\n   293\t\treturn nil\r\n   294\t}\r\n   295\t\r\n   296\tfunc (s *State) DrainEndpoint(service, address string) error {\r\n   297\t\tss := s.GetService(service)\r\n   298\t\tif ss == nil {\r\n   299\t\t\treturn errNotFound(\"service not found\")\r\n   300\t"]
[5719.443205, "o", "\t}\r\n   301\t\tep := s.GetEndpoint(service, address)\r\n   302\t\tif ep == nil {\r\n   303\t\t\treturn errNotFound(\"endpoint not found\")\r\n   304\t\t}\r\n   305\t\tep.StartDraining(ss.DrainTimeoutMs, false)\r\n   306\t\treturn nil\r\n   307\t}\r\n   308\t\r\n   309"]
[5719.443264, "o", "\tfunc (s *State) ResetCircuitBreaker(service, address string) error {\r\n   310\t\tep := s.GetEndpoint(service, address)\r\n   311\t\tif ep == nil {\r\n   312\t\t\treturn errNotFound(\"endpoint not found\")\r\n   313\t\t}\r\n   314\t\tep.Circuit.Reset()\r\n   315\t\treturn nil\r\n   316\t}\r\n"]
[5719.443326, "o", "   317\t\r\n   318\tfunc (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {\r\n   319\t\tep.mu.Lock()\r\n   320\t\tdefer ep.mu.Unlock()\r\n   321\t\tep.State = Draining\r\n   322\t\tep.consecSuccess = 0\r\n   323\t\tep.consecFailures = 0\r\n   324\t\tep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\r\n"]
[5719.443419, "o", "   325\t\tif markRemoved {\r\n   326\t\t\tep.removed = true\r\n   327\t\t}\r\n   328\t\tif len(ep.connections) > 0 {\r\n   329\t\t\tgo func(deadline time.Time) {\r\n   330\t\t\t\ttime.Sleep(time.Until(deadline))\r\n   331\t\t\t\tep.mu.Lock()\r\n   332\t\t\t\tep.closeConnectionsLocked()\r\n   333\t\t\t\tep.mu.Unlock()\r\n   334\t\t\t}(ep.drainDeadline)\r\n   335\t\t}\r\n   336\t}\r\n"]
[5719.44348, "o", "   337\t\r\n   338\tfunc (ep *EndpointState) AddConnection(conn net.Conn) int64 {\r\n   339\t\tep.mu.Lock()\r\n   340\t\tdefer ep.mu.Unlock()\r\n   341\t\tid := atomic.AddInt64(&ep.connIDCounter, 1)\r\n   342\t\tnow := time.Now()\r\n   343\t\tep.connections[id] = &connectionInfo{\r\n   344\t\t\tconn:         conn,\r\n   345\t"]
[5719.443545, "o", "\t\tclientAddr:   remoteAddr(conn),\r\n   346\t\t\tstart:        now,\r\n   347\t\t\tlastActivity: now,\r\n   348\t\t}\r\n   349\t\tep.ActiveConnections++\r\n   350\t\treturn id\r\n   351\t}\r\n   352\t\r\n   353\tfunc (ep *EndpointState) RemoveConnection(id int64) {\r\n   354\t\tep.mu.Lock()\r\n"]
[5719.443602, "o", "   355\t\tdefer ep.mu.Unlock()\r\n   356\t\tif _, ok := ep.connections[id]; ok {\r\n   357\t\t\tdelete(ep.connections, id)\r\n   358\t\t\tif ep.ActiveConnections > 0 {\r\n   359\t\t\t\tep.ActiveConnections--\r\n   360\t\t\t}\r\n   361\t\t}\r\n   362\t}\r\n"]
[5719.44366, "o", "   363\t\r\n   364\tfunc (ep *EndpointState) closeConnectionsLocked() {\r\n   365\t\tfor id, info := range ep.connections {\r\n   366\t\t\tinfo.conn.Close()\r\n   367\t\t\tdelete(ep.connections, id)\r\n   368\t\t}\r\n   369\t}\r\n   370\t\r\n"]
[5719.443717, "o", "   371\tfunc (ep *EndpointState) Active() int {\r\n   372\t\tep.mu.Lock()\r\n   373\t\tdefer ep.mu.Unlock()\r\n   374\t\treturn ep.ActiveConnections\r\n   375\t}\r\n   376\t\r\n   377\tfunc remoteAddr(conn net.Conn) string {\r\n   378\t\tif conn == nil {\r\n   379"]
[5719.443774, "o", "\t\t\treturn \"\"\r\n   380\t\t}\r\n   381\t\tif a := conn.RemoteAddr(); a != nil {\r\n   382\t\t\treturn a.String()\r\n   383\t\t}\r\n   384\t\treturn \"\"\r\n   385\t}\r\n   386\t\r\n   387\tfunc (ep *EndpointState) UpdateConnectionActivity(id int64, bytesIn, bytesOut int64) {\r\n"]
[5719.443832, "o", "   388\t\tep.mu.Lock()\r\n   389\t\tdefer ep.mu.Unlock()\r\n   390\t\tif info, ok := ep.connections[id]; ok {\r\n   391\t\t\tinfo.bytesIn += bytesIn\r\n   392\t\t\tinfo.bytesOut += bytesOut\r\n   393\t\t\tif bytesIn > 0 || bytesOut > 0 {\r\n   394\t\t\t\tinfo.lastActivity = time.Now()\r\n   395\t\t\t}\r\n   396"]
[5719.443896, "o", "\t\t}\r\n   397\t}\r\n   398\t\r\n   399\tfunc (ep *EndpointState) ConnectionIdleMs(id int64) int64 {\r\n   400\t\tep.mu.Lock()\r\n   401\t\tdefer ep.mu.Unlock()\r\n   402\t\tif info, ok := ep.connections[id]; ok {\r\n   403\t\t\treturn time.Since(info.lastActivity).Milliseconds()\r\n"]
[5719.443953, "o", "   404\t\t}\r\n   405\t\treturn -1\r\n   406\t}\r\n   407\t\r\n   408\tfunc (ss *ServiceState) IdleTimeout() int {\r\n   409\t\tss.mu.Lock()\r\n   410\t\tdefer ss.mu.Unlock()\r\n   411\t\treturn ss.IdleTimeoutMs\r\n   412\t}\r\n   413\t"]
[5719.444017, "o", "\r\n   414\ttype ConnectionView struct {\r\n   415\t\tEndpoint string `json:\"endpoint\"`\r\n   416\t\tClient   string `json:\"client\"`\r\n   417\t\tAgeMs    int64  `json:\"age_ms\"`\r\n   418\t\tIdleMs   int64  `json:\"idle_ms\"`\r\n   419\t\tBytesIn  int64  `json:\"bytes_in\"`\r\n   420\t\tBytesOut int64  `json:\"bytes_out\"`\r\n   421\t}\r\n   422\t\r\n"]
[5719.444232, "o", "   423\tfunc (s *State) ConnectionsView(name string) ([]ConnectionView, bool) {\r\n   424\t\tss := s.GetService(name)\r\n   425\t\tif ss == nil {\r\n   426\t\t\treturn nil, false\r\n   427\t\t}\r\n   428\t\tss.mu.Lock()\r\n   429\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n   430\t\tcopy(endpoints, ss.Endpoints)\r\n   431\t\tss.mu.Unlock()\r\n   432\t\r\n   433\t\tnow := time.Now()\r\n   434\t\tvar out []ConnectionView\r\n   435\t\tfor _, ep := range endpoints {\r\n   436\t\t\tep.mu.Lock()\r\n   437\t\t\tfor _, info := range ep.connections {\r\n   438\t\t\t\tout = append(out, ConnectionView{\r\n   439\t\t\t\t\tEndpoint: ep.Address,\r\n   440\t\t\t\t\tClient:   info.clientAddr,\r\n   441\t\t\t\t\tAgeMs:    now.Sub(info.start).Milliseconds(),\r\n   442\t\t\t\t\tIdleMs:   now.Sub(info.lastActivity).Milliseconds(),\r\n   443\t\t\t\t\tBytesIn:  info.bytesIn,\r\n   444\t\t\t\t\tBytesOut: info.bytesOut,\r\n   445\t\t\t\t})\r\n   446\t\t\t}\r\n   447\t\t\tep.mu.Unlock()\r\n   448\t\t}\r\n   449\t\tsort.Slice(out, func(i, j int) bool {\r\n   450\t\t\tif out[i].Endpoint != out[j].Endpoint {\r\n   451\t\t"]
[5719.444327, "o", "\t\treturn out[i].Endpoint < out[j].Endpoint\r\n   452\t\t\t}\r\n   453\t\t\treturn out[i].Client < out[j].Client\r\n   454\t\t})\r\n   455\t\treturn out, true\r\n   456\t}\r\n   457\t\r\n   458\tfunc (ep *EndpointState) IsEligible(maxConns int) bool {\r\n   459\t\tep.mu.Lock()\r\n   460\t\tdefer ep.mu.Unlock()\r\n   461\t\treturn ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n   462\t}\r\n   463\t\r\n   464\tfunc (s *State) RecordHealthCheck(service, address string, success bool) HealthEvent {\r\n   465\t\tss := s.GetService(service)\r\n   466\t"]
[5719.444412, "o", "\tif ss == nil {\r\n   467\t\t\treturn HealthEvent{}\r\n   468\t\t}\r\n   469\t\tep := s.GetEndpoint(service, address)\r\n   470\t\tif ep == nil {\r\n   471\t\t\treturn HealthEvent{}\r\n   472\t\t}\r\n   473\t\tglobal := s.Global()\r\n   474\t\tep.mu.Lock()\r\n   475\t\toldState := ep.State\r\n"]
[5719.444524, "o", "   476\t\tresult := \"success\"\r\n   477\t\tif !success {\r\n   478\t\t\tresult = \"failure\"\r\n   479\t\t}\r\n   480\t\tif success {\r\n   481\t\t\tep.consecSuccess++\r\n   482\t\t\tep.consecFailures = 0\r\n   483\t\t\tif oldState == Unknown && ep.consecSuccess >= global.HealthyThreshold {\r\n   484\t\t\t\tep.State = Healthy\r\n"]
[5719.444596, "o", "   485\t\t\t} else if oldState == Unhealthy && ep.consecSuccess >= global.HealthyThreshold {\r\n   486\t\t\t\tep.State = Healthy\r\n   487\t\t\t}\r\n   488\t\t} else {\r\n   489\t\t\tep.consecFailures++\r\n   490\t\t\tep.consecSuccess = 0\r\n   491\t\t\tif (oldState == Healthy || oldState == Unknown) && ep.consecFailures >= global.UnhealthyThreshold {\r\n   492\t\t\t\tep.State = Unhealthy\r\n   493\t\t\t\tep.Circuit.Open()\r\n   494\t\t\t\tep.consecFailures = 0\r\n   495\t\t\t\ttimeout := time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n   496\t\t\t\tgo func(deadline time.Time) {\r\n   497\t\t\t\t\ttime.Sleep(time.Until(deadline))\r\n   498\t\t\t\t\tep.mu.Lock()\r\n   499\t\t\t\t\tep.closeConnectionsLocked()\r\n   500\t\t\t\t\tep.mu.Unlock()\r\n   501\t\t\t\t}(time.Now().Add(timeout))\r\n   502\t\t\t}\r\n   503\t\t"]
[5719.44466, "o", "}\r\n   504\t\tnewState := ep.State\r\n   505\t\tep.mu.Unlock()\r\n   506\t\tevt := HealthEvent{\r\n   507\t\t\tTimestamp:   time.Now(),\r\n   508\t\t\tEndpoint:    address,\r\n   509\t\t\tOldState:    oldState,\r\n   510\t\t\tNewState:    newState,\r\n"]
[5719.444727, "o", "   511\t\t\tCheckResult: result,\r\n   512\t\t}\r\n   513\t\ts.logMu.Lock()\r\n   514\t\ts.healthLog[service] = append(s.healthLog[service], evt)\r\n   515\t\tif len(s.healthLog[service]) > 1000 {\r\n   516\t\t\ts.healthLog[service] = s.healthLog[service][len(s.healthLog[service])-1000:]\r\n   517\t\t}\r\n   518\t\ts.logMu.Unlock()\r\n   519\t"]
[5719.444797, "o", "\treturn evt\r\n   520\t}\r\n"]
