[689.689276, "o", "func selectWeighted(eps []*EndpointState) *EndpointState {\r\n\u001b[?2004l\r"]
[689.689331, "o", "\u001b[?2004h> "]
[689.689457, "o", "    var best *EndpointState\r\n\u001b[?2004l\r"]
