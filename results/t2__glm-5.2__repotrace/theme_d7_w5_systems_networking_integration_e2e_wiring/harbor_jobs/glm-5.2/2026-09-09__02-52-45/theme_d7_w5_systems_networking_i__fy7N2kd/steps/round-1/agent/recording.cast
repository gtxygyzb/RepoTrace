[11211.568752, "i", "sed -n '1,40p' internal/accesslog/logger.go\n"]
[11211.569194, "o", "sed -n '1,40p' internal/accesslog/logger.go\r\n\u001b[?2004l\r"]
[11211.572443, "o", "package accesslog\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sync\"\r\n\t\"sync/atomic\"\r\n"]
[11211.572566, "o", "\t\"time\"\r\n)\r\n\r\n// Entry is one structured access log record.\r\ntype Entry struct {\r\n\tTs          string `json:\"ts\"`\r\n\tService     string `json:\"service\"`\r\n\tClient      string `json:\"client\"`\r\n\tEndpoint    string `json:\"endpoint\"`\r\n\tBytesIn     int64  `json:\"bytes_in\"`\r\n\tBytesOut    int64  `json:\"bytes_out\"`\r\n\tDurationMs  int64  `json:\"duration_ms\"`\r\n\tResult      string `json:\"result\"`\r\n\tRetried     bool   `json:\"retried\"`\r\n\tRetryCount  int    `json:\"retry_count\"`\r\n\tQueueWaitMs *int64 `json:\"queue_wait_ms,omitempty\"`\r\n}\r\n\r\n// DefaultPath is the access log path required by meshrouter.\r\nconst DefaultPath = \"/app/logs/access.log\"\r\n\r\nconst maxFileSize = 1 << 20 // 1 MB\r\n\r\n// Logger writes access log entries asynchronously to a JSON-lines file.\r\n"]
[11211.572647, "o", "type Logger struct {\r\n\tpath     string\r\n\tch       chan Entry\r\n\tstop     chan struct{}\r\n\tdone     chan struct{}\r\n\tstopped  int32\r\n\tstopOnce sync.Once\r\n\tmu       sync.Mutex\r\n"]
[11211.57322, "o", "\u001b[?2004h"]
[11211.573286, "o", "root@n30009:/app# "]
[11211.845493, "i", "sed -n '290,330p' internal/ipc/server.go\n"]
[11211.845867, "o", "sed -n '290,330p' internal/ipc/server.go\r\n"]
