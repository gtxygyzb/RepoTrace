[9486.406678, "i", "sed -n '1,220p' internal/accesslog/logger.go\n"]
[9486.40705, "o", "sed -n '1,220p' internal/accesslog/logger.go\r\n"]
[9486.407115, "o", "\u001b[?2004l\r"]
[9486.410432, "o", "package accesslog\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sync\"\r\n\t\"sync/atomic\"\r\n\t\"time\"\r\n)\r\n\r\n// Entry is one structured access log record.\r\ntype Entry struct {\r\n\tTs         string `json:\"ts\"`\r\n"]
[9486.410528, "o", "\tService    string `json:\"service\"`\r\n\tClient     string `json:\"client\"`\r\n\tEndpoint   string `json:\"endpoint\"`\r\n\tBytesIn    int64  `json:\"bytes_in\"`\r\n\tBytesOut   int64  `json:\"bytes_out\"`\r\n\tDurationMs int64  `json:\"duration_ms\"`\r\n\tResult     string `json:\"result\"`\r\n}\r\n\r\n// DefaultPath is the access log path required by meshrouter.\r\nconst DefaultPath = \"/app/logs/access.log\"\r\n\r\nconst maxFileSize = 1 << 20 // 1 MB\r\n\r\n// Logger writes access log entries asynchronously to a JSON-lines file.\r\ntype Logger struct {\r\n\tpath     string\r\n"]
[9486.410684, "o", "\tch       chan Entry\r\n\tstop     chan struct{}\r\n\tdone     chan struct{}\r\n\tstopped  int32\r\n\tstopOnce sync.Once\r\n\tmu       sync.Mutex\r\n"]
[9486.410902, "o", "\tfile     *os.File\r\n\tsize     int64\r\n}\r\n\r\n// New creates a Logger for path and starts its writer goroutine.\r\nfunc New(path string) *Logger {\r\n\tif path == \"\" {\r\n\t\tpath = DefaultPath\r\n\t}\r\n\tl := &Logger{\r\n\t\tpath: path,\r\n\t\tch:   make(chan Entry, 8192),\r\n\t\tstop: make(chan struct{}),\r\n\t\tdone: make(chan struct{}),\r\n\t}\r\n\tgo l.run()\r\n\treturn l\r\n}\r\n\r\n// Path returns the configured log file path.\r\nfunc (l *Logger) Path() string {\r\n\treturn l.path\r\n}\r\n\r\n// Log queues an entry for asynchronous writing. If the buffered channel is full,\r\n// the entry is written synchronously to avoid losing it.\r\nfunc (l *Logger) Log(entry Entry) {\r\n\tif atomic.LoadInt32(&l.stopped) != 0 {\r\n\t\treturn\r\n\t}\r\n\tentry.Ts = time.Now().UTC().Format(time.RFC3339Nano)\r\n\tselect {\r\n\tcase l.ch <- entry:\r\n\tdefault:\r\n\t\tl.writeLine(entry)\r\n\t}\r\n}\r\n\r\n// Stop flushes all buffered entries and closes the log file.\r\nfunc (l *Logger) Stop() {\r\n\tl.stopOnce.Do(func() {\r\n\t\tatomic.StoreInt32(&l.stopped, 1)\r\n\t\tclose(l.stop)\r\n\t\t<-l.done\r\n\t\tl.mu.Lock()\r\n\t\tif l.file != nil {"]
[9486.411005, "o", "\r\n\t\t\tl.file.Close()\r\n\t\t\tl.file = nil\r\n\t\t}\r\n\t\tl.mu.Unlock()\r\n\t})\r\n}\r\n\r\nfunc (l *Logger) run() {\r\n\tfor {\r\n\t\tselect {\r\n\t\tcase e := <-l.ch:\r\n\t\t\tl.writeLine(e)\r\n\t\tcase <-l.stop:\r\n\t\t\tl.drain()\r\n\t\t\tclose(l.done)\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc (l *Logger) drain() {\r\n\tfor {\r\n\t\tselect {\r\n\t\tcase e := <-l.ch:\r\n\t\t\tl.writeLine(e)\r\n\t\tdefault:\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n}\r\n\r\n"]
[9486.411081, "o", "func (l *Logger) writeLine(e Entry) {\r\n\tb, err := json.Marshal(e)\r\n\tif err != nil {\r\n\t\treturn\r\n\t}\r\n\tb = append(b, '\\n')\r\n\r\n\tl.mu.Lock()\r\n\tdefer l.mu.Unlock()\r\n\r\n\tif l.file == nil {\r\n\t\tif err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {\r\n\t\t\treturn\r\n"]
[9486.411154, "o", "\t\t}\r\n\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n\t\tif err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n\t\tl.file = f\r\n\t\tif info, err := f.Stat(); err == nil {\r\n\t\t\tl.size = info.Size()\r\n\t\t}\r\n\t}\r\n\r\n\tif l.size > 0 && l.size+int64(len(b)) > maxFileSize {"]
[9486.411223, "o", "\r\n\t\tl.rotateLocked()\r\n\t}\r\n\r\n\tn, err := l.file.Write(b)\r\n\tif err != nil {\r\n\t\tl.size = 0\r\n\t\tif l.file != nil {\r\n\t\t\tl.file.Close()\r\n\t\t\tl.file = nil\r\n\t\t}\r\n\t\treturn\r\n"]
[9486.411299, "o", "\t}\r\n\tl.size += int64(n)\r\n}\r\n\r\nfunc (l *Logger) rotateLocked() {\r\n\tif l.file != nil {\r\n\t\tl.file.Close()\r\n\t\tl.file = nil\r\n\t}\r\n\tos.Remove(l.path + \".1\")\r\n\tif err := os.Rename(l.path, l.path+\".1\"); err != nil {\r\n\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n\t"]
[9486.411369, "o", "\tif err == nil {\r\n\t\t\tl.file = f\r\n\t\t\tif info, err := f.Stat(); err == nil {\r\n\t\t\t\tl.size = info.Size()\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn\r\n\t}\r\n\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n\tif err != nil {\r\n\t\tl.size = 0\r\n"]
[9486.411458, "o", "\t\treturn\r\n\t}\r\n\tl.file = f\r\n\tl.size = 0\r\n}\r\n"]
