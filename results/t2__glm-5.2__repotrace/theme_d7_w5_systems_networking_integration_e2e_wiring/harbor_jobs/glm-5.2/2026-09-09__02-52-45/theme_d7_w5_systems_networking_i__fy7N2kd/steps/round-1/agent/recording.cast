[4594.946569, "o", "> "]
[4594.946881, "o", "anchor = '''func (ep *EndpointState) Active() int {\\n\\tep.mu.Lock()\\n\\tdefer ep.mu.Unlock()\\n\\treturn ep.ActiveConnections\\n}'''\r\n\u001b[?2004l\r"]
[4594.946898, "o", "\u001b[?2004h"]
[4594.94691, "o", "> "]
[4594.946995, "o", "insert = anchor + '''\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[4594.947011, "o", "\u001b[?2004l\r"]
[4594.947075, "o", "\u001b[?2004h> "]
[4594.952712, "o", "func remoteAddr(conn net.Conn) string {\\n\\tif conn == nil {\\n\\t\\treturn \"\"\\n\\t}\\n\\tif a := conn.RemoteAddr(); a != nil {\\n\\t\\treturn a.String()\\n\\t}\\n\\treturn \"\"\\n}\\n\\nfunc (ep *EndpointState) UpdateConnectionActivity(id int64, bytesIn, bytesOut int64) {\\n\\tep.mu.Lock()\\n\\tdefer ep.mu.Unlock()\\n\\tif info, ok := ep.connections[id]; ok {\\n\\t\\tinfo.bytesIn += bytesIn\\n\\t\\tinfo.bytesOut += bytesOut\\n\\t\\tif bytesIn > 0 || bytesOut > 0 {\\n\\t\\t\\tinfo.lastActivity = time.Now()\\n\\t\\t}\\n\\t}\\n}\\n\\nfunc (ep *EndpointState) ConnectionIdleMs(id int64) int64 {\\n\\tep.mu.Lock()\\n\\tdefer ep.mu.Unlock()\\n\\tif info, ok := ep.connections[id]; ok {\\n\\t\\treturn time.Since(info.lastActivity).Milliseconds()\\n\\t}\\n\\treturn -1\\n}\\n\\nfunc (ss *ServiceState) IdleTimeoutMs() int {\\n\\tss.mu.Lock()\\n\\tdefer ss.mu.Unlock()\\n\\treturn ss.IdleTimeoutMs\\n}\\n\\ntype ConnectionView struct {\\n\\tEndpoint string `json:\"endpoint\"`\\n\\tClient   string `json:\"client\"`\\n\\tAgeMs    int64  `json:\"age_ms\"`\\n\\tIdleMs   int64  `json:\"idle_ms\"`\\n\\tBytesIn  int64"]
[4594.952776, "o", "  `json:\"bytes_in\"`\\n\\tBytesOut int64  `json:\"bytes_out\"`\\n}\\n\\nfunc (s *State) ConnectionsView(name string) ([]ConnectionView, bool) {\\n\\tss := s.GetService(name)\\n\\tif ss == nil {\\n\\t\\treturn nil, false\\n\\t}\\n\\tss.mu.Lock()\\n\\tendpoints := make([]*EndpointState, len(ss.Endpoints))\\n\\tcopy(endpoints, ss.Endpoints)\\n\\tss.mu.Unlock()\\n\\n\\tnow := time.Now()\\n\\tvar out []ConnectionView\\n\\tfor _, ep := range endpoints {\\n\\t\\tep.mu.Lock()\\n\\t\\tfor _, info := range ep.connections {\\n\\t\\t\\tout = append(out, ConnectionView{\\n\\t\\t\\t\\tEndpoint: ep.Address,\\n\\t\\t\\t\\tClient:   info.clientAddr,\\n\\t\\t\\t\\tAgeMs:    now.Sub(info.start).Milliseconds(),\\n\\t\\t\\t\\tIdleMs:   now.Sub(info.lastActivity).Milliseconds(),\\n\\t\\t\\t\\tBytesIn:  info.bytesIn,\\n\\t\\t\\t\\tBytesOut: info.bytesOut,\\n\\t\\t\\t})\\n\\t\\t}\\n\\t\\tep.mu.Unlock()\\n\\t}\\n\\tsort.Slice(out, func(i, j int) bool {\\n\\t\\tif out[i].Endpoint != out[j].Endpoint {\\n\\t\\t\\treturn out[i].Endpoint < out[j].Endpoint\\n\\t\\t}\\n\\t\\treturn out[i].Client < out[j].Client\\n\\t})\\n\\treturn out, true\\"]
[4594.952793, "o", "n}'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4594.952893, "o", "s = s.replace(anchor, insert)\r\n\u001b[?2004l\r"]
