[9494.4329, "o", "     1\tpackage router\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"io\"\r\n     5\t\t\"log\"\r\n     6\t\t\"net\"\r\n     7\t\t\"sync\"\r\n"]
[9494.433032, "o", "     8\t\t\"sync/atomic\"\r\n     9\t\t\"time\"\r\n    10\t\r\n    11\t\t\"meshrouter/internal/accesslog\"\r\n    12\t\t\"meshrouter/internal/state\"\r\n    13\t)\r\n    14\t\r\n    15\ttype serviceListener struct {\r\n    16\t\tservice  string\r\n    17\t\tport     int\r\n    18\t\tlistener net.Listener\r\n    19\t\tstop     chan struct{}\r\n    20\t\twg       sync.WaitGroup\r\n    21\t\tdone     chan struct{}\r\n    22\t}\r\n    23\t\r\n    24\ttype Router struct {\r\n    25\t\tstate     *state.State\r\n    26\t\taccessLog *accesslog.Logger\r\n    27\t\tmu        sync.Mutex\r\n"]
[9494.433132, "o", "    28\t\tlisteners map[string]*serviceListener\r\n    29\t}\r\n    30\t\r\n    31\tfunc NewRouter(s *state.State) *Router {\r\n    32\t\treturn &Router{\r\n    33\t\t\tstate:     s,\r\n"]
[9494.433207, "o", "    34\t\t\tlisteners: make(map[string]*serviceListener),\r\n    35\t\t}\r\n    36\t}\r\n    37\t\r\n    38\tfunc (r *Router) SetAccessLogger(l *accesslog.Logger) {\r\n    39\t\tr.accessLog = l\r\n    40\t}\r\n    41\t\r\n    42\tfunc (r *Router) Start() {\r\n    43\t\tfor _, ss := range r.state.Services() {\r\n    44\t\t\tif !ss.IsStopping() {\r\n    45\t\t\t\tr.startService(ss)\r\n    46\t\t\t}\r\n    47\t\t}\r\n    48\t}\r\n    49\t\r\n    50\tfunc (r *Router) Reload() {\r\n    51\t\tservices := r.state.Services()\r\n    52\t\t"]
[9494.433287, "o", "seen := make(map[string]bool)\r\n    53\t\tfor _, ss := range services {\r\n    54\t\t\tseen[ss.Name] = true\r\n    55\t\t\tr.mu.Lock()\r\n    56\t\t\tsl, ok := r.listeners[ss.Name]\r\n    57\t\t\tr.mu.Unlock()\r\n    58\t\t\tif !ok {\r\n"]
[9494.433358, "o", "    59\t\t\t\tif !ss.IsStopping() {\r\n    60\t\t\t\t\tr.startService(ss)\r\n    61\t\t\t\t}\r\n    62\t\t\t\tcontinue\r\n    63\t\t\t}\r\n    64\t\t\tif sl.port != ss.ListenPort {\r\n    65\t\t\t\tr.stopService(ss.Name, true)\r\n    66\t\t\t\tr.startService(ss)\r\n    67\t\t\t}\r\n    68\t\t}\r\n    69\t\tr.mu.Lock()\r\n    70\t\tfor name := range r.listeners {\r\n    71\t\t\tif !seen[name] {\r\n    72\t\t\t\tr.mu.Unlock()\r\n    73\t\t\t\tr.stopService(name, true)\r\n"]
[9494.43348, "o", "    74\t\t\t\tr.mu.Lock()\r\n    75\t\t\t}\r\n    76\t\t}\r\n    77\t\tr.mu.Unlock()\r\n    78\t}\r\n    79\t\r\n    80\tfunc (r *Router) startService(ss *state.ServiceState) {\r\n    81\t\taddr := \":\" + intToStr(ss.ListenPort)\r\n    82\t\tln, err := net.Listen(\"tcp\", addr)\r\n    83\t\tif err != nil {\r\n    84\t\t\tlog.Printf(\"router: listen %s on %s failed: %v\", ss.Name, addr, err)\r\n    85\t\t\treturn\r\n    86\t\t}\r\n    87\t\tsl := &serviceListener{\r\n    88\t\t\tservice:  ss.Name,\r\n"]
[9494.433575, "o", "    89\t\t\tport:     ss.ListenPort,\r\n    90\t\t\tlistener: ln,\r\n    91\t\t\tstop:     make(chan struct{}),\r\n    92\t\t\tdone:     make(chan struct{}),\r\n    93\t\t}\r\n    94\t\tr.mu.Lock()\r\n    95\t\tr.listeners[ss.Name] = sl\r\n    96\t\tr.mu.Unlock()\r\n    97\t\tgo sl.acceptLoop(r)\r\n    98\t}\r\n    99\t\r\n   100\tfunc (r *Router) stopService(name string, drain bool) {\r\n   101\t\tr.mu.Lock()\r\n   102\t\tsl, ok := r.listeners[name]\r\n"]
[9494.433654, "o", "   103\t\tif ok {\r\n   104\t\t\tdelete(r.listeners, name)\r\n   105\t\t}\r\n   106\t\tr.mu.Unlock()\r\n   107\t\tif !ok {\r\n   108\t\t\treturn\r\n   109\t\t}\r\n   110\t\tsl.stopAccept(drain, r)\r\n   111\t}\r\n   112\t\r\n   113\tfunc (r *Router) Stop() {\r\n   114\t\t"]
[9494.433683, "o", "r.mu.Lock()\r\n   115\t\tlisteners := r.listeners\r\n   116\t\tr.listeners = make(map[string]*serviceListener)\r\n   117\t\tr.mu.Unlock()\r\n"]
[9494.43377, "o", "   118\t\tvar wg sync.WaitGroup\r\n   119\t\tfor name, sl := range listeners {\r\n   120\t\t\twg.Add(1)\r\n   121\t\t\tgo func(name string, sl *serviceListener) {\r\n   122\t\t\t\tdefer wg.Done()\r\n   123\t\t\t\tsl.stopAccept(true, r)\r\n   124\t\t\t}(name, sl)\r\n   125\t\t}\r\n   126\t\twg.Wait()\r\n   127\t}\r\n   128\t\r\n   129\tfunc (sl *serviceListener) acceptLoop(r *Router) {"]
[9494.433839, "o", "\r\n   130\t\tdefer close(sl.done)\r\n   131\t\tfor {\r\n   132\t\t\tconn, err := sl.listener.Accept()\r\n"]
[9494.433919, "o", "   133\t\t\tif err != nil {\r\n   134\t\t\t\treturn\r\n   135\t\t\t}\r\n   136\t\t\tsl.wg.Add(1)\r\n   137\t\t\tgo func(c net.Conn) {\r\n   138\t\t\t\tdefer sl.wg.Done()\r\n   139\t\t\t\tr.handleConn(sl.service, c)\r\n   140\t\t\t}(conn)\r\n   141\t\t}\r\n   142\t}\r\n   143\t\r\n   144\tfunc (sl *serviceListener) stopAccept(drain bool, r *Router) {\r\n   145\t\tselect {\r\n   146\t\tcase <-sl.stop:\r\n   147\t\tdefault:\r\n"]
[9494.433942, "o", "   148\t\t\tclose(sl.stop)\r\n   149\t\t}\r\n   150\t\tsl.listener.Close()\r\n"]
[9494.433959, "o", "   151\t\t<-sl.done\r\n   152\t\tif drain {\r\n   153\t\t"]
[9494.434069, "o", "\tss := r.state.GetService(sl.service)\r\n   154\t\t\ttimeout := 5 * time.Second\r\n   155\t\t\tif ss != nil {\r\n   156\t\t\t\ttimeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n   157\t\t\t\tif timeout <= 0 {\r\n   158\t\t\t\t\ttimeout = 5 * time.Second\r\n   159\t\t\t\t}\r\n   160\t\t\t}\r\n   161\t\t\tdone := make(chan struct{})\r\n   162\t\t\tgo func() {\r\n   163\t\t\t\tsl.wg.Wait()\r\n   164\t\t\t\tclose(done)\r\n   165\t\t\t}()\r\n   166\t\t\tselect {\r\n   167\t\t\tcase <-done:\r\n   168\t\t\tcase <-time.After(timeout):\r\n"]
[9494.434134, "o", "   169\t\t\t\tr.state.CloseServiceConnections(sl.service)\r\n   170\t\t\t\t<-done\r\n"]
[9494.434201, "o", "   171\t\t\t}\r\n   172\t\t} else {\r\n   173\t\t\tsl.wg.Wait()\r\n   174\t\t}\r\n   175\t}\r\n   176\t\r\n   177\tfunc (r *Router) handleConn(service string, client net.Conn) {\r\n   178\t\tstart := time.Now()\r\n   179\t\tclientAddr := \"\"\r\n   180\t\tif addr := client.RemoteAddr(); addr != nil {\r\n"]
[9494.434273, "o", "   181\t\t\tclientAddr = addr.String()\r\n   182\t\t}\r\n   183\t\r\n   184\t\tvar endpoint string\r\n   185\t\tvar bytesIn, bytesOut int64\r\n   186\t\tvar result string\r\n   187\t\tdefer func() {\r\n   188\t\t\tif result == \"\" {\r\n   189\t\t\t\tresult = \"success\"\r\n   190\t\t\t}\r\n   191\t\t\tif r.accessLog != nil {\r\n   192\t\t\t\tr.accessLog.Log(accesslog.Entry{\r\n   193\t\t\t\t\tService:    service,\r\n   194\t\t\t\t\tClient:     clientAddr,\r\n   195\t\t\t\t\tEndpoint:   endpoint,\r\n   196\t\t\t\t\tBytesIn:    bytesIn,\r\n"]
[9494.434347, "o", "   197\t\t\t\t\tBytesOut:   bytesOut,\r\n   198\t\t\t\t\tDurationMs: time.Since(start).Milliseconds(),\r\n   199\t\t\t\t\tResult:     result,\r\n   200\t\t\t\t})\r\n   201\t\t\t}\r\n   202\t\t}()\r\n   203\t\r\n   204\t\tss := r.state.GetService(service)\r\n   205\t\tif ss == nil {\r\n   206\t\t\tresult = \"rejected_no_endpoint\"\r\n   207\t\t\tclient.Close()\r\n"]
[9494.434419, "o", "   208\t\t\treturn\r\n   209\t\t}\r\n   210\t\r\n   211\t\tallowed, queued := ss.AcquireRateLimitToken()\r\n"]
[9494.434486, "o", "   212\t\tif !allowed {\r\n   213\t\t\tresult = \"rejected_rate_limit\"\r\n   214\t\t\tclient.Close()\r\n   215\t\t\treturn\r\n   216\t\t}\r\n   217\t\tif queued {\r\n   218\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   219\t\t\t\tcand.Stats.RecordQueued()\r\n"]
[9494.434555, "o", "   220\t\t\t}\r\n   221\t\t}\r\n   222\t\r\n   223\t\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\r\n   224\t\tvar lastEndpoint *state.EndpointState\r\n   225\t\tfor attempt := 0; ; attempt++ {\r\n   226\t\t\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\r\n   227\t\t\tif err != nil {\r\n   228\t\t\t\tresult = \"rejected_no_endpoint\"\r\n"]
[9494.434587, "o", "   229\t\t\t\tendpoint = \"\"\r\n   230\t\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   231\t\t\t\t\tss := r.state.GetService(service)\r\n   232\t\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n   233\t\t\t\t\t\tcand.Stats.RecordRejection()\r\n   234\t\t\t\t\t}\r\n   235\t\t\t\t}\r\n   236\t\t\t\tclient.Close()\r\n   237\t\t\t\treturn\r\n   238\t\t\t}\r\n   239\t\t\tlastEndpoint = res.Endpoint\r\n   240\t"]
[9494.434667, "o", "\t\tep := res.Endpoint\r\n   241\t\t\tendpoint = ep.Address\r\n   242\t\r\n   243\t\t\tvar id int64\r\n   244\t\t\tif !res.Probe {\r\n   245\t\t\t\tvar ok bool\r\n   246\t\t\t\tid, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\r\n   247\t\t\t\tif !ok {\r\n   248\t\t\t\t\tresult = \"rejected_conn_limit\"\r\n   249\t\t\t\t\tep.Stats.RecordRejection()\r\n   250\t\t\t\t\tclient.Close()\r\n   251\t\t\t\t\treturn"]
[9494.43473, "o", "\r\n   252\t\t\t\t}\r\n   253\t\t\t}\r\n"]
[9494.434803, "o", "   254\t\r\n   255\t\t\tbackend, derr := net.Dial(\"tcp\", ep.Address)\r\n   256\t\t\tif derr != nil {\r\n   257\t\t\t\tif id != 0 {\r\n   258\t\t\t\t\tep.RemoveConnection(id)\r\n   259\t\t\t\t}\r\n   260\t\t\t\tep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n"]
