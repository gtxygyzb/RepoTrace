[11291.710417, "o", "\\t\\treturn false, 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11291.710492, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11291.710585, "o", "\\tdep.mu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11291.710687, "o", "\\tdefer dep.mu.Unlock()\r\n\u001b[?2004l\r"]
[11291.710757, "o", "\u001b[?2004h> "]
[11291.710831, "o", "\\thealthy := 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11291.711003, "o", "\\tfor _, ep := range dep.Endpoints {\r\n\u001b[?2004l\r"]
[11291.711073, "o", "\u001b[?2004h> "]
