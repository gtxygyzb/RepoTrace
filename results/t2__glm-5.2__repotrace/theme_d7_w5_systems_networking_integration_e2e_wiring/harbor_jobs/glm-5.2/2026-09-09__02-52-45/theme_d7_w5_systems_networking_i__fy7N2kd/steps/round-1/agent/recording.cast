[14091.755771, "o", "   304\t\r\n   305\tfunc prettyData(ipcCmd string, data json.RawMessage) (string, error) {\r\n   306\t\tswitch ipcCmd {\r\n   307\t\tcase \"list_services\":\r\n   308\t\t\tvar services []struct {\r\n   309\t\t\t\tName        string `json:\"name\"`\r\n   310\t\t\t\tListenPort  int    `json:\"listen_port\"`\r\n   311\t\t\t\tRoutingMode string `json:\"routing_mode\"`\r\n   312\t\t\t\tEndpoints   []struct {\r\n   313\t\t\t\t\tAddress           string `json:\"address\"`\r\n   314\t\t\t\t\tState             string `json:\"state\"`\r\n   315\t\t\t\t\tWeight            int    `json:\"weight\"`\r\n   316\t\t\t\t\tActiveConnections int    `json:\"active_connections\"`\r\n   317\t\t\t\t\tCircuitState      string `json:\"circuit_state\"`\r\n"]
[14091.755842, "o", "   318\t\t\t\t} `json:\"endpoints\"`\r\n   319\t\t\t}\r\n   320\t\t\tif err := json.Unmarshal(data, &services); err != nil {\r\n   321\t\t\t\treturn \"\", err\r\n   322\t\t\t}\r\n   323\t\t\tvar b strings.Builder\r\n   324\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\r\n   325\t\t\tfor _, svc := range services {\r\n   326\t\t\t\tfor _, ep := range svc.Endpoints {\r\n"]
[14091.755877, "o", "   327\t\t\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\r\n   328\t\t\t\t}\r\n   329\t\t\t}\r\n   330\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   331\t\tcase \"resolve\":\r\n"]
[14091.755961, "o", "   332\t\t\tvar addr string\r\n   333\t\t\tif err := json.Unmarshal(data, &addr); err != nil {\r\n   334\t\t\t\treturn \"\", err\r\n   335\t\t\t}\r\n   336\t\t\treturn addr, nil\r\n   337\t\tcase \"get_circuit_breakers\":\r\n   338\t\t\tvar circuits []struct {\r\n   339\t\t\t\tAddress             string `json:\"address\"`\r\n   340\t\t\t\tCircuitState        string `json:\"circuit_state\"`\r\n   341\t\t\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n   342\t\t\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n   343\t\t\t\tProbeActive         bool   `json:\"probe_active\"`\r\n"]
[14091.756017, "o", "   344\t\t\t}\r\n   345\t\t\tif err := json.Unmarshal(data, &circuits); err != nil {\r\n   346\t\t\t\treturn \"\", err\r\n"]
[14091.756076, "o", "   347\t\t\t}\r\n   348\t\t\tvar b strings.Builder\r\n   349\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9s %-17s %-7s\\n\", \"ENDPOINT\", \"CIRCUIT\", \"FAILURES\", \"TIME_IN_STATE_MS\", \"PROBE\")\r\n   350\t\t\tfor _, c := range circuits {\r\n   351\t\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9d %-17d %-7t\\n\", c.Address, c.CircuitState, c.ConsecutiveFailures, c.TimeInStateMs, c.ProbeActive)\r\n   352\t\t\t}\r\n   353\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   354\t\t"]
