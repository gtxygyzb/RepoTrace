[6872.551865, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('config/services.toml')\nlines = p.read_text().splitlines()\nout = []\ni = 0\nwhile i < len(lines):\n    out.append(lines[i])\n    if lines[i].strip() == 'address = \"127.0.0.1:8091\"':\n        if i+1 < len(lines) and lines[i+1].strip() == 'weight = 1':\n            out.append(lines[i+1])\n            out.append('warmup_duration_ms = 5000')\n            i += 2\n            continue\n    if lines[i].strip() == 'address = \"127.0.0.1:8092\"':\n        if i+1 < len(lines) and lines[i+1].strip() == 'weight = 1':\n            out.append(lines[i+1])\n            out.append('warmup_duration_ms = 5000')\n            i += 2\n            continue\n    i += 1\np.write_text('\\n'.join(out) + '\\n')\nPY\n"]
