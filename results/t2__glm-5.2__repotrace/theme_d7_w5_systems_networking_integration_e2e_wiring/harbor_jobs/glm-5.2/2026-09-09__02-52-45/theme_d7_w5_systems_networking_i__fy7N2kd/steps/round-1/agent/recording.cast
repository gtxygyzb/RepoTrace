[7490.196058, "o", "    62\t\t\tipcCmd = \"drain_endpoint\"\r\n    63\t\t\targs[\"name\"] = os.Args[2]\r\n    64\t\t\targs[\"address\"] = os.Args[3]\r\n    65\t\tcase \"health-log\":\r\n    66\t\t\tif len(os.Args) < 3 {\r\n    67\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\r\n    68\t\t\t\tos.Exit(1)\r\n    69\t\t\t}\r\n    70\t\t\tipcCmd = \"get_health_log\"\r\n    71\t\t\targs[\"name\"] = os.Args[2]\r\n    72\t\t\tlast := 20\r\n    73\t\t\tfor _, a := range os.Args[3:] {\r\n    74\t\t\t\tif strings.HasPrefix(a, \"--last\") && len(a) > 6 {\r\n"]
