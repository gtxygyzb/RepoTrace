[10740.618466, "o", "   232\t\treturn prettyData(ipcCmd, resp.Data)\r\n   233\t}\r\n   234\t\r\n   235\tfunc prettyData(ipcCmd string, data json.RawMessage) (string, error) {\r\n   236\t\tswitch ipcCmd {\r\n   237\t\tcase \"list_services\":\r\n   238\t\t\tvar services []struct {\r\n   239\t\t\t\tName        string `json:\"name\"`\r\n   240\t\t\t\tListenPort  int    `json:\"listen_port\"`\r\n   241\t\t\t\tRoutingMode string `json:\"routing_mode\"`\r\n   242\t\t\t\tEndpoints   []struct {\r\n   243\t\t\t\t\tAddress           string `json:\"address\"`\r\n   244\t\t\t\t\tState             string `json:\"state\"`\r\n   245\t\t\t\t\tWeight            int    `json:\"weight\"`\r\n   246\t\t\t\t\tActiveConnections int    `json:\"active_connections\"`\r\n   247"]
[10740.618533, "o", "\t\t\t\t\tCircuitState      string `json:\"circuit_state\"`\r\n   248\t\t\t\t} `json:\"endpoints\"`\r\n   249\t\t\t}\r\n   250\t\t\tif err := json.Unmarshal(data, &services); err != nil {\r\n   251\t\t\t\treturn \"\", err\r\n   252\t\t\t}\r\n   253\t\t\tvar b strings.Builder\r\n   254\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\r\n   255\t\t\tfor _, svc := range services {\r\n   256\t\t\t\tfor _, ep := range svc.Endpoints {\r\n   257\t\t\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\r\n   258\t\t\t\t}\r\n   259\t\t\t}\r\n   260\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n"]
[10740.6186, "o", "   261\t\tcase \"resolve\":\r\n   262\t\t\tvar addr string\r\n   263\t\t\tif err := json.Unmarshal(data, &addr); err != nil {\r\n   264\t\t\t\treturn \"\", err\r\n   265\t\t\t}\r\n   266\t\t\treturn addr, nil\r\n   267\t\tcase \"get_circuit_breakers\":\r\n   268\t\t\tvar circuits []struct {\r\n   269\t\t\t\tAddress             string `json:\"address\"`\r\n   270\t\t\t\tCircuitState        string `json:\"circuit_state\"`\r\n   271\t\t\t\t"]
