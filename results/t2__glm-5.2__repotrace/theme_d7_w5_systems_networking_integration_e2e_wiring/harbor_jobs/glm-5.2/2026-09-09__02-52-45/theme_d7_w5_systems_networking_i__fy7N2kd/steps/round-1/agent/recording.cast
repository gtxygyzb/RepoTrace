[4411.701191, "o", "    73\t\tWindowSec int                 `json:\"window_sec\"`\r\n    74\t\tEndpoints []StatsEndpointView `json:\"endpoints\"`\r\n    75\t}\r\n    76\t\r\n    77\tfunc (s *State) StatsView(name string, windowSec int) (StatsView, bool) {\r\n    78\t\tss := s.GetService(name)\r\n    79\t\tif ss == nil {\r\n    80\t\t\treturn StatsView{}, false\r\n    81\t\t}\r\n    82\t\tsv := StatsView{\r\n    83\t\t\tService:   name,\r\n    84\t\t\tWindowSec: windowSec,\r\n    85\t\t\tEndpoints: make([]StatsEndpointView, 0),\r\n    86\t\t}\r\n    87\t\tss.mu.Lock()\r\n    88\t"]
[4411.701277, "o", "\tfor _, ep := range ss.Endpoints {\r\n    89\t\t\tep.mu.Lock()\r\n    90\t\t\tsv.Endpoints = append(sv.Endpoints, StatsEndpointView{\r\n    91\t\t\t\tAddress:  ep.Address,\r\n    92\t\t\t\tSnapshot: ep.Stats.Snapshot(ep.ActiveConnections),\r\n    93\t\t\t})\r\n"]
[4411.701351, "o", "    94\t\t\tep.mu.Unlock()\r\n    95\t\t}\r\n    96\t\tss.mu.Unlock()\r\n    97\t\treturn sv, true\r\n    98\t}\r\n    99\t\r\n   100\ttype HealthEventView struct {\r\n   101\t\tTimestamp   time.Time `json:\"timestamp\"`\r\n   102\t\tEndpoint    string    `json:\"endpoint\"`\r\n   103\t\tOldState    string    `json:\"old_state\"`\r\n   104\t\tNewState    string    `json:\"new_state\"`"]
