[6318.243686, "o", "   424\t\tss := s.GetService(name)\r\n   425\t\tif ss == nil {\r\n   426\t\t\treturn nil, false\r\n   427\t\t}\r\n   428\t\tss.mu.Lock()\r\n   429\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n"]
[6318.243746, "o", "   430\t\tcopy(endpoints, ss.Endpoints)\r\n   431\t\tss.mu.Unlock()\r\n   432\t\r\n   433\t\tnow := time.Now()\r\n   434\t\tvar out []ConnectionView\r\n   435\t\tfor _, ep := range endpoints {\r\n   436\t\t\tep.mu.Lock()\r\n"]
