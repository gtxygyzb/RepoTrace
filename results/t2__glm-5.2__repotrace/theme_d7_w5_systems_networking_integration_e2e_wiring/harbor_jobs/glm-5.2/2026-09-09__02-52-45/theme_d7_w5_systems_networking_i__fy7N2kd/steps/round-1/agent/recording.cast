[2210.204519, "o", "nl -ba internal/state/ratelimit.go | sed -n '1,180p'\r\n\u001b[?2004l\r"]
[2210.20837, "o", "     1\tpackage state\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"container/list\"\r\n     5\t\t\"sync\"\r\n     6\t\t\"time\"\r\n     7\t)\r\n     8\t\r\n     9\ttype rateLimiter struct {\r\n    10\t\tmu          sync.Mutex\r\n"]
[2210.208544, "o", "    11\t\trps         float64\r\n    12\t\tburst       float64\r\n    13\t\ttokens      float64\r\n    14\t\tlast        time.Time\r\n    15\t\tqueue       *list.List\r\n    16\t\tqueueMax    int\r\n    17\t\ttimeout     time.Duration\r\n    18\t\trateLimited uint64\r\n    19\t\tqueued      uint64\r\n    20\t\ttimeouts    uint64\r\n    21\t}\r\n    22\t\r\n    23\tfunc newRateLimiter(rps, burst int, queueDepth int, timeoutMs int) *rateLimiter {\r\n    24\t\treturn &rateLimiter{\r\n    25\t\t\trps:      float64(rps),\r\n    26\t\t\tburst:    float64(burst),\r\n    27\t\t\ttokens:   float64(burst),\r\n    28\t\t\tlast:     time.Now(),\r\n    29\t\t\tqueue:    list.New(),\r\n    30\t\t\tqueueMax: queueDepth,\r\n    31\t\t\ttimeout:  time.Duration(timeoutMs) * time.Millisecond,\r\n    32\t\t}\r\n    33\t}\r\n    34\t\r\n    35\tfunc (rl *rateLimiter) update(rps, burst int, queueDepth int, timeoutMs int) {\r\n    36"]
[2210.208629, "o", "\t\trl.mu.Lock()\r\n    37\t\tdefer rl.mu.Unlock()\r\n    38\t\trl.rps = float64(rps)\r\n    39\t\trl.burst = float64(burst)\r\n    40\t\tif rl.tokens > rl.burst {\r\n    41\t\t\trl.tokens = rl.burst\r\n    42\t\t}\r\n    43\t\trl.queueMax = queueDepth\r\n    44\t\trl.timeout = time.Duration(timeoutMs) * time.Millisecond\r\n"]
[2210.208693, "o", "    45\t}\r\n    46\t\r\n    47\tfunc (rl *rateLimiter) refillLocked(now time.Time) {\r\n    48\t\telapsed := now.Sub(rl.last).Seconds()\r\n    49\t\tif elapsed > 0 {\r\n    50\t\t\trl.tokens += rl.rps * elapsed\r\n    51\t\t\tif rl.burst > 0 && rl.tokens > rl.burst {\r\n"]
[2210.208754, "o", "    52\t\t\t\trl.tokens = rl.burst\r\n    53\t\t\t}\r\n    54\t\t\trl.last = now\r\n    55\t\t}\r\n    56\t}\r\n    57\t\r\n    58\t"]
[2210.208814, "o", "func (rl *rateLimiter) tryAcquire(now time.Time) bool {\r\n    59\t\trl.mu.Lock()\r\n    60\t\tdefer rl.mu.Unlock()\r\n    61\t\trl.refillLocked(now)\r\n    62\t\tif rl.rps <= 0 || rl.tokens >= 1 {\r\n    63\t\t\tif rl.rps > 0 {\r\n    64\t\t\t\trl.tokens -= 1\r\n"]
[2210.208871, "o", "    65\t\t\t}\r\n    66\t\t\treturn true\r\n    67\t\t}\r\n    68\t\treturn false\r\n    69\t}\r\n    70\t\r\n    71\ttype queuedWaiter struct {\r\n    72\t"]
[2210.20893, "o", "\tdeadline time.Time\r\n    73\t\tch       chan struct{}\r\n    74\t}\r\n    75\t\r\n    76\tfunc (rl *rateLimiter) acquire(now time.Time) (bool, bool) {\r\n    77\t\trl.mu.Lock()\r\n    78\t\tif rl.rps <= 0 {\r\n"]
[2210.208996, "o", "    79\t\t\trl.mu.Unlock()\r\n    80\t\t\treturn true, false\r\n    81\t\t}\r\n    82\t\trl.refillLocked(now)\r\n    83\t\tif rl.tokens >= 1 {\r\n    84\t\t\trl.tokens -= 1\r\n    85\t\t\trl.mu.Unlock()\r\n"]
[2210.209053, "o", "    86\t\t\treturn true, false\r\n    87\t\t}\r\n    88\t\tif rl.queueMax <= 0 {\r\n    89\t\t\trl.rateLimited++\r\n    90\t\t\trl.mu.Unlock()\r\n    91\t\t\treturn false, false\r\n    92\t\t"]
[2210.209119, "o", "}\r\n    93\t\tif rl.queue.Len() >= rl.queueMax {\r\n    94\t\t\trl.rateLimited++\r\n    95\t\t\trl.mu.Unlock()\r\n    96\t\t\treturn false, false\r\n    97\t\t}\r\n"]
[2210.209181, "o", "    98\t\tdeadline := now.Add(rl.timeout)\r\n    99\t\twaiter := &queuedWaiter{deadline: deadline, ch: make(chan struct{})}\r\n   100\t\telem := rl.queue.PushBack(waiter)\r\n   101\t\trl.queued++\r\n   102\t\trl.mu.Unlock()\r\n   103\t\r\n   104\t\ttimer := time.NewTimer(rl.timeout)\r\n   105\t\tdefer timer.Stop()\r\n"]
[2210.209246, "o", "   106\t\tselect {\r\n   107\t\tcase <-waiter.ch:\r\n   108\t\t\treturn true, true\r\n"]
[2210.209302, "o", "   109\t\tcase <-timer.C:\r\n   110\t\t\trl.mu.Lock()\r\n   111\t\t\tselect {\r\n   112\t\t\tcase <-waiter.ch:\r\n   113\t\t\t\trl.mu.Unlock()\r\n   114\t\t\t\treturn true, true\r\n   115\t\t\tdefault:\r\n   116\t\t\t}\r\n"]
[2210.209358, "o", "   117\t\t\tif elem.Value != nil {\r\n   118\t\t\t\trl.queue.Remove(elem)\r\n   119\t\t\t}\r\n   120\t\t\trl.timeouts++\r\n   121\t\t\trl.mu.Unlock()\r\n"]
[2210.209414, "o", "   122\t\t\treturn false, true\r\n   123\t\t}\r\n   124\t}\r\n   125\t\r\n   126\tfunc (rl *rateLimiter) releaseToken() {\r\n   127\t\trl.mu.Lock()\r\n   128\t\tif rl.queue.Len() > 0 {\r\n   129\t\t\telem := rl.queue.Front()\r\n"]
[2210.209498, "o", "   130\t\t\twaiter := elem.Value.(*queuedWaiter)\r\n   131\t\t\trl.queue.Remove(elem)\r\n   132\t\t\trl.mu.Unlock()\r\n   133\t\t\tclose(waiter.ch)\r\n   134\t\t\treturn\r\n   135\t\t}\r\n   136\t\trl.mu.Unlock()\r\n   137\t}\r\n   138\t\r\n"]
[2210.209558, "o", "   139\tfunc (rl *rateLimiter) status() (tokens float64, queueDepth int, rateLimited uint64, queued uint64, timeouts uint64, rps float64, burst float64) {\r\n   140\t\trl.mu.Lock()\r\n   141\t\tdefer rl.mu.Unlock()\r\n   142\t\trl.refillLocked(time.Now())\r\n   143\t\treturn rl.tokens, rl.queue.Len(), rl.rateLimited, rl.queued, rl.timeouts, rl.rps, rl.burst\r\n   144\t}\r\n"]
[2210.21008, "o", "\u001b[?2004h"]
