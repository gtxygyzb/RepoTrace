[5710.279519, "o", "     1\tpackage state\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"net\"\r\n     5\t\t\"sort\"\r\n     6\t\t\"sync\"\r\n"]
[5710.279624, "o", "     7\t\t\"sync/atomic\"\r\n     8\t\t\"time\"\r\n     9\t\r\n    10\t\t\"meshrouter/internal/circuit\"\r\n    11\t\t\"meshrouter/internal/config\"\r\n    12\t\t\"meshrouter/internal/stats\"\r\n    13\t)\r\n    14\t\r\n    15\ttype HealthState string\r\n    16\t\r\n    17\tconst (\r\n    18\t\tUnknown   HealthState = \"unknown\"\r\n    19\t\tHealthy   HealthState = \"healthy\"\r\n    20\t\tUnhealthy HealthState = \"unhealthy\"\r\n    21\t\tDraining  HealthState = \"draining\"\r\n"]
[5710.279697, "o", "    22\t)\r\n    23\t\r\n    24\ttype HealthEvent struct {\r\n    25\t\tTimestamp   time.Time\r\n    26\t\tEndpoint    string\r\n    27\t\tOldState    HealthState\r\n    28\t\tNewState    HealthState\r\n    29\t\tCheckResult string\r\n    30\t}\r\n    31\t\r\n    32\ttype EndpointState struct {\r\n"]
[5710.27977, "o", "    33\t\tmu                sync.Mutex\r\n    34\t\tAddress           string\r\n    35\t\tWeight            int\r\n    36\t\tConfig            config.Endpoint\r\n    37\t\tState             HealthState\r\n    38\t\tActiveConnections int\r\n    39\t\tCircuit           *circuit.Breaker\r\n    40\t\tStats             *stats.Collector\r\n    41\t\tconsecSuccess     int\r\n    42\t\t"]
[5710.279837, "o", "consecFailures    int\r\n    43\t\tdrainDeadline     time.Time\r\n    44\t\tremoved           bool\r\n    45\t\tconnIDCounter     int64\r\n    46\t\tcurrentWeight     int\r\n    47\t\tconnections       map[int64]*connectionInfo\r\n    48\t}\r\n    49\t\r\n    50\ttype connectionInfo struct {\r\n    51\t\tconn         net.Conn\r\n"]
[5710.279895, "o", "    52\t\tclientAddr   string\r\n    53\t\tstart        time.Time\r\n    54\t\tlastActivity time.Time\r\n    55\t\tbytesIn      int64\r\n    56\t\tbytesOut     int64\r\n    57\t}\r\n    58\t\r\n    59\ttype ServiceState struct {\r\n"]
[5710.279957, "o", "    60\t\tmu                        sync.Mutex\r\n    61\t\tName                      string\r\n    62\t\tListenPort                int\r\n    63\t\tRoutingMode               string\r\n    64\t\tDrainTimeoutMs            int\r\n    65\t\tMaxConnectionsPerEndpoint int\r\n    66\t\tIdleTimeoutMs             int\r\n    67\t\tRateLimitRps              int\r\n    68\t\tRateLimitBurst            int"]
[5710.280018, "o", "\r\n    69\t\tRateLimitQueueDepth       int\r\n    70\t\tRateLimitQueueTimeoutMs   int\r\n    71\t\tMaxRetries                int\r\n    72\t\tRetryDelayMs              int\r\n    73\t\tRetryBackoffMultiplier    float64\r\n    74\t\tRetryMaxDelayMs           int\r\n    75\t\trateLimiter               *rateLimiter\r\n"]
[5710.280081, "o", "    76\t\tEndpoints                 []*EndpointState\r\n    77\t\trrIndex                   int\r\n    78\t\tListener                  net.Listener\r\n    79\t\tlistenerStop              chan struct{}\r\n    80\t\tstopping                  bool\r\n    81\t}\r\n    82\t\r\n    83\ttype State struct {\r\n    84"]
[5710.280137, "o", "\t\tmu         sync.RWMutex\r\n    85\t\tconfigPath string\r\n    86\t\tglobal     config.Global\r\n    87\t\tservices   map[string]*ServiceState\r\n    88\t\tlogMu      sync.Mutex\r\n    89\t\thealthLog  map[string][]HealthEvent\r\n    90\t\treloadCh   chan struct{}\r\n    91\t}\r\n"]
[5710.280195, "o", "    92\t\r\n    93\tfunc NewState(cfg *config.Config, path string) *State {\r\n    94\t\ts := &State{\r\n    95\t\t\tconfigPath: path,\r\n    96\t\t\tservices:   make(map[string]*ServiceState),\r\n    97\t\t\thealthLog:  make(map[string][]HealthEvent),\r\n"]
[5710.280252, "o", "    98\t\t\treloadCh:   make(chan struct{}, 1),\r\n    99\t\t}\r\n   100\t\ts.applyConfigLocked(cfg)\r\n   101\t\treturn s\r\n   102\t}\r\n   103\t\r\n   104\tfunc (s *State) ReloadChan() <-chan struct{} {\r\n   105\t\treturn s.reloadCh\r\n   106\t}\r\n   107\t\r\n"]
[5710.280311, "o", "   108\tfunc (s *State) ConfigPath() string {\r\n   109\t\ts.mu.RLock()\r\n   110\t\tdefer s.mu.RUnlock()\r\n   111\t\treturn s.configPath\r\n   112\t}\r\n   113\t\r\n   114\tfunc (s *State) Global() config.Global {\r\n   115\t\ts.mu.RLock()\r\n"]
[5710.280376, "o", "   116\t\tdefer s.mu.RUnlock()\r\n   117\t\treturn s.global\r\n   118\t}\r\n   119\t\r\n   120\tfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n   121\t\ts.mu.Lock()\r\n   122\t\tdefer s.mu.Unlock()\r\n   123\t\ts.applyConfigLocked(cfg)\r\n   124\t\tselect {\r\n   125\t\tcase s.reloadCh <- struct{}{}:\r\n   126"]
[5710.280457, "o", "\t\tdefault:\r\n   127\t\t}\r\n   128\t}\r\n   129\t\r\n   130\tfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n   131\t\ts.global = cfg.Global\r\n   132\t\tseen := make(map[string]bool)\r\n   133\t\tfor _, svc := range cfg.Services {\r\n   134\t\t\tseen[svc.Name] = true\r\n   135\t\t\tss := s.services[svc.Name]\r\n   136\t\t\tif ss == nil {\r\n   137\t\t\t\tss = newServiceState(svc, cfg.Global)\r\n"]
[5710.280515, "o", "   138\t\t\t\ts.services[svc.Name] = ss\r\n   139\t\t\t} else {\r\n   140\t\t\t\tss.mu.Lock()\r\n   141\t\t\t\tss.Name = svc.Name\r\n   142\t\t\t\tss.ListenPort = svc.ListenPort\r\n   143\t\t\t\tss.RoutingMode = svc.RoutingMode\r\n   144\t\t\t"]
[5710.280571, "o", "\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n   145\t\t\t\tss.RateLimitRps = svc.RateLimitRps\r\n   146\t\t\t\tss.RateLimitBurst = svc.RateLimitBurst\r\n   147\t\t\t\tss.RateLimitQueueDepth = svc.RateLimitQueueDepth\r\n   148\t\t\t\tss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs\r\n   149\t\t\t\tss.MaxRetries = svc.MaxRetries\r\n   150\t\t\t\tss.RetryDelayMs = svc.RetryDelayMs\r\n"]
[5710.280645, "o", "   151\t\t\t\tss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier\r\n   152\t\t\t\tss.RetryMaxDelayMs = svc.RetryMaxDelayMs\r\n   153\t\t\t\tif ss.rateLimiter == nil {\r\n   154\t\t\t\t\tss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n   155\t\t\t\t} else {\r\n   156\t\t\t\t\tss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n   157\t\t\t\t}\r\n   158\t\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n   159\t\t\t\tss.IdleTimeoutMs = svc.IdleTimeoutMs\r\n   160\t\t\t\tss.mu.Unlock()\r\n"]
[5710.280721, "o", "   161\t\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n   162\t\t\t}\r\n   163\t\t}\r\n   164\t\tfor name, ss := range s.services {\r\n   165\t\t\tif !seen[name] {\r\n   166\t\t\t\tss.mu.Lock()\r\n   167\t\t\t\tss.stopping = true"]
[5710.280781, "o", "\r\n   168\t\t\t\tif ss.listenerStop != nil {\r\n   169\t\t\t\t\tclose(ss.listenerStop)\r\n   170\t\t\t\t\tss.listenerStop = nil\r\n   171\t\t\t\t}\r\n   172\t\t\t\tif ss.Listener != nil {\r\n   173\t\t\t\t\tss.Listener.Close()\r\n   174\t\t\t\t\tss.Listener = nil\r\n   175\t\t\t\t}\r\n   176\t\t\t\tss.mu.Unlock()\r\n   177\t\t\t\tfor _, ep := range ss.Endpoints {\r\n   178\t\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   179\t\t\t\t}\r\n   180\t\t\t}\r\n   181\t\t}\r\n"]
[5710.280845, "o", "   182\t}\r\n   183\t\r\n   184\tfunc newServiceState(svc config.Service, global config.Global) *ServiceState {\r\n   185\t\tss := &ServiceState{\r\n   186\t\t\tName:                      svc.Name,\r\n   187\t\t\tListenPort:                svc.ListenPort,\r\n   188\t\t\tRoutingMode:               svc.RoutingMode,\r\n   189\t\t\tDrainTimeoutMs:            svc.DrainTimeoutMs,\r\n   190\t\t\tRateLimitRps:              svc.RateLimitRps,\r\n"]
[5710.280908, "o", "   191\t\t\tRateLimitBurst:            svc.RateLimitBurst,\r\n   192\t\t\tRateLimitQueueDepth:       svc.RateLimitQueueDepth,\r\n   193\t\t\tRateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,\r\n   194\t\t\tMaxRetries:                svc.MaxRetries,\r\n   195\t\t\tRetryDelayMs:              svc.RetryDelayMs,\r\n   196\t\t\tRetryBackoffMultiplier:    svc.RetryBackoffMultiplier,\r\n   197\t\t\tRetryMaxDelayMs:           svc.RetryMaxDelayMs,\r\n   198\t\t\trateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),\r\n   199\t\t\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n"]
[5710.280966, "o", "   200\t\t\tIdleTimeoutMs:             svc.IdleTimeoutMs,\r\n   201\t\t\tlistenerStop:              nil,\r\n   202\t\t}\r\n   203\t\tfor _, ep := range svc.Endpoints {\r\n   204\t\t\tss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))\r\n   205\t\t}\r\n   206\t\treturn ss\r\n   207\t}\r\n"]
[5710.281031, "o", "   208\t\r\n   209\tfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n   210\t\tss.mu.Lock()\r\n   211\t\tdefer ss.mu.Unlock()\r\n   212\t\tseen := make(map[string]bool)\r\n   213\t\tfor _, cep := range eps {\r\n   214\t\t\tseen[cep.Address] = true\r\n   215\t\t\tvar ep *EndpointState\r\n   216\t\t\tfor _, existing := range ss.Endpoints {\r\n   217\t\t"]
[5710.281087, "o", "\t\tif existing.Address == cep.Address {\r\n   218\t\t\t\t\tep = existing\r\n   219\t\t\t\t\tbreak\r\n   220\t\t\t\t}\r\n   221\t\t\t}\r\n   222\t\t\tif ep == nil {\r\n   223\t\t\t\tep = newEndpointState(cep, global)\r\n   224\t"]
[5710.281145, "o", "\t\t\tss.Endpoints = append(ss.Endpoints, ep)\r\n   225\t\t\t} else {\r\n   226\t\t\t\tep.mu.Lock()\r\n   227\t\t\t\tep.Config = cep\r\n   228\t\t\t\tep.Weight = cep.Weight\r\n   229\t\t\t\tep.mu.Unlock()\r\n   230\t\t\t}\r\n   231\t\t}\r\n"]
[5710.2812, "o", "   232\t\tfor _, ep := range ss.Endpoints {\r\n   233\t\t\tif !seen[ep.Address] {\r\n   234\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   235\t\t\t}\r\n   236\t\t}\r\n   237\t}\r\n   238\t\r\n   239\tfunc newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {\r\n   240\t\treturn &EndpointState{\r\n   241\t\t\tAddress:     cep.Address,\r\n"]
[5710.281261, "o", "   242\t\t\tWeight:      cep.Weight,\r\n   243\t\t\tConfig:      cep,\r\n   244\t\t\tState:       Unknown,\r\n   245\t\t\tCircuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n   246\t\t\tStats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n   247\t\t\tconnections: make(map[int64]*connectionInfo),\r\n   248\t\t}\r\n   249\t}\r\n   250\t\r\n"]
[5710.281317, "o", "   251\tfunc (s *State) GetService(name string) *ServiceState {\r\n   252\t\ts.mu.RLock()\r\n   253\t\tdefer s.mu.RUnlock()\r\n   254\t\treturn s.services[name]\r\n   255\t}\r\n   256\t\r\n   257\tfunc (s *State) Services() []*ServiceState {\r\n   258\t\ts.mu.RLock()"]
[5710.281371, "o", "\r\n   259\t\tdefer s.mu.RUnlock()\r\n   260\t\tout := make([]*ServiceState, 0, len(s.services))\r\n"]
