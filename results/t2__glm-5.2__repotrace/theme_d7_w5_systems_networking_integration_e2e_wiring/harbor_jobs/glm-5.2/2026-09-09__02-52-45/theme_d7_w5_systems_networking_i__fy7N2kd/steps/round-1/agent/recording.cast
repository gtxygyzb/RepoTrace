[13844.354575, "o", "\r\n   151\t\t<-sl.done\r\n   152\t\tif drain {\r\n   153\t\t\tss := r.state.GetService(sl.service)\r\n   154\t\t\ttimeout := 5 * time.Second\r\n   155\t\t\tif ss != nil {\r\n   156\t\t\t\ttimeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n   157\t\t\t\tif timeout <= 0 {\r\n   158\t\t\t\t\ttimeout = 5 * time.Second\r\n   159\t\t\t\t}\r\n   160\t\t\t}\r\n   161\t\t\tdone := make(chan struct{})\r\n   162\t\t\tgo func() {\r\n   163\t\t\t\tsl.wg.Wait()\r\n"]
