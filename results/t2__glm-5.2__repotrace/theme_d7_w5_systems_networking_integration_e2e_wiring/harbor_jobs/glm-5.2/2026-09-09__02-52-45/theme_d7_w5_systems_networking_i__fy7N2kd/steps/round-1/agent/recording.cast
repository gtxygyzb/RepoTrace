[5693.750084, "o", "\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")\r\n./cmd/meshctl/main.go:45:\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")\r\n./cmd/meshctl/main.go:59:\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")\r\n./cmd/meshctl/main.go:67:\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\r\n./cmd/meshctl/main.go:83:\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl resolve <service>\")\r\n./cmd/meshctl/main.go:90:\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")\r\n./cmd/meshctl/main.go:97:\t\t\t"]
