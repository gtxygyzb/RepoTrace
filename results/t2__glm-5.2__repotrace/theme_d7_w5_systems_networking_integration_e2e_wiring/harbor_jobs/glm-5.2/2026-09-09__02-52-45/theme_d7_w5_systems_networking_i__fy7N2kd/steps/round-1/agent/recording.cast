[4288.159418, "o", "   121\tfunc selectWeightedCandidate(eps []*EndpointState) *EndpointState {\r\n   122\t\tvar best *EndpointState\r\n   123\t\tvar bestWeight int\r\n   124\t\tfor _, ep := range eps {\r\n   125\t\t\tep.mu.Lock()\r\n"]
[4288.159514, "o", "   126\t\t\tcw := ep.currentWeight + ep.Weight\r\n   127\t\t\tep.mu.Unlock()\r\n   128\t\t\tif best == nil || cw > bestWeight {\r\n   129\t\t\t\tbest = ep\r\n   130\t\t\t\tbestWeight = cw\r\n   131\t\t\t}\r\n   132\t\t}\r\n   133\t\treturn best\r\n   134\t}\r\n   135\t\r\n   136\tfunc selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\r\n   137\t\tsort.SliceStable(eps, func(i, j int) bool {\r\n   138\t\t\tai := eps[i].Active()\r\n   139\t\t\taj := eps[j].Active()\r\n   140\t\t\tif ai != aj {\r\n   141\t\t\t\treturn ai < aj\r\n"]
[4288.15959, "o", "   142\t\t\t}\r\n   143\t\t\treturn eps[i].Address < eps[j].Address\r\n   144\t\t})\r\n   145\t\treturn eps[0]\r\n   146\t}\r\n   147\t\r\n   148\t// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\r\n   149\tfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\r\n   150\t\tss := s.GetService(service)\r\n   151\t\tif ss == nil {\r\n   152\t\t\treturn SelectResult{}, errNotFound(\"service not found\")\r\n   153\t\t}\r\n   154\t\tss.mu.Lock()\r\n"]
[4288.159657, "o", "   155\t\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n   156\t\tmode := ss.RoutingMode\r\n   157\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n   158\t\tcopy(endpoints, ss.Endpoints)\r\n   159\t\tss.mu.Unlock()\r\n   160\t\r\n   161\t\tvar regular []*EndpointState\r\n   162\t"]
[4288.159724, "o", "\tfor _, ep := range endpoints {\r\n   163\t\t\tif exclude != nil && ep == exclude {\r\n   164\t\t\t\tcontinue\r\n   165\t\t\t}\r\n   166\t\t\tep.mu.Lock()\r\n"]
[4288.159785, "o", "   167\t\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n   168\t\t\tep.mu.Unlock()\r\n   169\t\t\tif eligible {\r\n   170\t\t\t\tregular = append(regular, ep)\r\n   171\t\t\t}\r\n   172\t\t}"]
[4288.159856, "o", "\r\n   173\t\r\n   174\t\tif len(regular) > 0 {\r\n   175\t\t\tif mode == \"least-connections\" {\r\n   176\t\t\t\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\r\n   177\t\t\t}\r\n   178\t\t\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\r\n   179\t\t}\r\n   180\t\r\n   181\t\tfor _, ep := range endpoints {\r\n   182\t\t\tif exclude != nil && ep == exclude {\r\n   183\t\t\t\tcontinue\r\n   184\t\t\t"]
[4288.159951, "o", "}\r\n   185\t\t\tep.mu.Lock()\r\n   186\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n   187\t\t\tep.mu.Unlock()\r\n"]
[4288.160006, "o", "   188\t\t\tif halfOpen && ep.Circuit.AcquireProbe() {\r\n   189\t\t\t\treturn SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil\r\n   190\t\t\t}\r\n   191\t\t}\r\n   192\t\treturn SelectResult{}, errNotFound(\"no eligible endpoints\")\r\n   193\t}\r\n"]
