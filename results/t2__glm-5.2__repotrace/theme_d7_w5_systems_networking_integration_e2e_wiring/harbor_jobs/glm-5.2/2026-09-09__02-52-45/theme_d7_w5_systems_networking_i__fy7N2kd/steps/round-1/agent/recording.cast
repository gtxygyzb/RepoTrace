[9794.092754, "o", "\tvar endpoint string\r\n\tvar bytesIn, bytesOut int64\r\n\tvar result string\r\n\tvar retryCount int\r\n\tvar queueWaitMs *int64\r\n\tdefer func() {\r\n\t"]
[9794.092859, "o", "\tif result == \"\" {\r\n\t\t\tresult = \"success\"\r\n\t\t}\r\n\t\tif r.accessLog != nil {\r\n\t\t\tr.accessLog.Log(accesslog.Entry{\r\n\t\t\t\tService:     service,\r\n\t\t\t\tClient:      clientAddr,\r\n\t\t\t\tEndpoint:    endpoint,\r\n\t\t\t\tBytesIn:     bytesIn,\r\n\t\t\t\tBytesOut:    bytesOut,\r\n\t\t\t\tDurationMs:  time.Since(start).Milliseconds(),\r\n\t\t\t\tResult:      result,\r\n\t\t\t\tRetried:     retryCount > 0,\r\n\t\t\t\tRetryCount:  retryCount,\r\n\t\t\t\tQueueWaitMs: queueWaitMs,\r\n\t\t\t})\r\n\t\t}\r\n"]
[9794.092952, "o", "\t}()\r\n\r\n\tss := r.state.GetService(service)\r\n\tif ss == nil {\r\n\t\tresult = \"rejected_no_endpoint\"\r\n\t\tclient.Close()\r\n\t\treturn\r\n\t}\r\n\r\n\tallowed, queued, waitMs, _ := ss.AcquireRateLimitToken()\r\n"]
[9794.0935, "o", "\u001b[?2004h"]
