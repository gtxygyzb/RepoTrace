[2073.53218, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/json\"\r\n"]
[2073.532295, "o", "     6\t\t\"fmt\"\r\n     7\t\t\"net\"\r\n     8\t\t\"os\"\r\n     9\t\t\"strconv\"\r\n    10\t\t\"strings\"\r\n    11\t)\r\n    12\t\r\n    13\ttype request struct {\r\n    14\t\tCmd  string          `json:\"cmd\"`\r\n"]
[2073.532342, "o", "    15\t\tArgs json.RawMessage `json:\"args\"`\r\n    16\t}\r\n    17\t\r\n    18\ttype response struct {\r\n    19\t\tStatus string          `json:\"status\"`\r\n    20\t\tData   json.RawMessage `json:\"data\"`\r\n    21\t}\r\n    22\t\r\n    23\tfunc main() {\r\n    24\t\tif len(os.Args) < 2 {\r\n    25\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl <command> [args]\")\r\n    26\t\t\tos.Exit(1)\r\n    27\t\t}\r\n"]
[2073.532451, "o", "    28\t\r\n    29\t\tcliCmd := os.Args[1]\r\n    30\t\targs := make(map[string]interface{})\r\n    31\t\tvar ipcCmd string\r\n    32\t\r\n    33\t\tswitch cliCmd {\r\n    34\t\tcase \"status\":\r\n    35\t\t\tipcCmd = \"list_services\"\r\n    36\t\tcase \"stats\":\r\n    37\t\t\tif len(os.Args) < 3 {\r\n    38\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")\r\n    39\t\t\t\tos.Exit(1)\r\n    40\t\t\t}\r\n    41\t\t\tipcCmd = \"get_stats\"\r\n"]
[2073.532524, "o", "    42\t\t\targs[\"name\"] = os.Args[2]\r\n    43\t\tcase \"set-weight\":\r\n    44\t\t\tif len(os.Args) < 5 {\r\n    45\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")\r\n    46\t\t\t\tos.Exit(1)\r\n    47\t\t\t}\r\n    48\t\t\tweight, err := strconv.Atoi(os.Args[4])\r\n    49\t\t\tif err != nil {\r\n    50\t\t\t\tfmt.Fprintf(os.Stderr, \"invalid weight: %v\\n\", err)\r\n    51\t\t\t\tos.Exit(1)\r\n    52\t\t\t}\r\n"]
[2073.532583, "o", "    53\t\t\tipcCmd = \"set_weight\"\r\n    54\t\t\targs[\"name\"] = os.Args[2]\r\n    55\t\t\targs[\"address\"] = os.Args[3]\r\n    56\t\t\targs[\"weight\"] = weight\r\n    57\t\tcase \"drain\":\r\n    58\t\t\tif len(os.Args) < 4 {\r\n    59\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")\r\n    60\t\t\t\tos.Exit(1)\r\n"]
[2073.532651, "o", "    61\t\t\t}\r\n    62\t\t\tipcCmd = \"drain_endpoint\"\r\n    63\t\t\targs[\"name\"] = os.Args[2]\r\n    64\t\t\targs[\"address\"] = os.Args[3]\r\n"]
[2073.532708, "o", "    65\t\tcase \"health-log\":\r\n    66\t\t\tif len(os.Args) < 3 {\r\n    67\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\r\n    68\t\t\t\tos.Exit(1)\r\n    69\t\t\t}\r\n    70\t\t\tipcCmd = \"get_health_log\"\r\n    71\t\t\targs[\"name\"] = os.Args[2]\r\n    72\t\t\tlast := 20\r\n    73\t\t\tfor _, a := range os.Args[3:] {\r\n"]
[2073.532768, "o", "    74\t\t\t\tif strings.HasPrefix(a, \"--last\") && len(a) > 6 {\r\n    75\t\t\t\t\tif v, err := strconv.Atoi(a[6:]); err == nil {\r\n    76\t\t\t\t\t\tlast = v\r\n    77\t\t\t\t\t}\r\n    78\t\t\t\t}\r\n    79\t\t\t}\r\n    80\t\t\targs[\"last_n\"] = last\r\n    81\t\tcase \"resolve\":\r\n    82\t\t\tif len(os.Args) < 3 {\r\n    83\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl resolve <service>\")\r\n    84\t\t\t\tos.Exit(1)\r\n    85\t\t\t}\r\n"]
[2073.53283, "o", "    86\t\t\tipcCmd = \"resolve\"\r\n    87\t\t\targs[\"name\"] = os.Args[2]\r\n    88\t\tcase \"circuits\":\r\n    89\t\t\tif len(os.Args) < 3 {\r\n    90\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")\r\n"]
[2073.532892, "o", "    91\t\t\t\tos.Exit(1)\r\n    92\t\t\t}\r\n    93\t\t\tipcCmd = \"get_circuit_breakers\"\r\n    94\t\t\targs[\"name\"] = os.Args[2]\r\n    95\t\tcase \"reset-circuit\":\r\n    96\t\t\tif len(os.Args) < 4 {\r\n    97\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl reset-circuit <service> <endpoint>\")\r\n    98\t\t\t\tos.Exit(1)\r\n    99"]
[2073.532956, "o", "\t\t\t}\r\n   100\t\t\tipcCmd = \"reset_circuit_breaker\"\r\n   101\t\t\targs[\"name\"] = os.Args[2]\r\n   102\t\t\targs[\"address\"] = os.Args[3]\r\n   103\t\tcase \"reload\":\r\n   104\t\t\tipcCmd = \"reload_config\"\r\n   105\t\tdefault:\r\n   106\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cliCmd)\r\n   107\t\t\tos.Exit(1)\r\n   108\t\t}\r\n   109\t\r\n   110\t\tdata, err := sendCommand(ipcCmd, args)\r\n   111\t\tif err != nil {\r\n"]
[2073.533028, "o", "   112\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   113\t\t\tos.Exit(1)\r\n   114\t\t}\r\n   115\t\tfmt.Println(data)\r\n   116\t}\r\n"]
[2073.53309, "o", "   117\t\r\n   118\tfunc sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n   119\t\trawArgs, err := json.Marshal(args)\r\n   120\t\tif err != nil {\r\n"]
