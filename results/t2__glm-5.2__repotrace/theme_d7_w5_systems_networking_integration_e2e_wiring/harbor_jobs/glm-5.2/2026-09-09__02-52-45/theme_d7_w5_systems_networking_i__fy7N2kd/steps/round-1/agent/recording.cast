[13816.44754, "o", "\t\t\tif !seen[name] {\r\n   173\t\t\t\tss.mu.Lock()\r\n   174\t\t\t\tss.stopping = true\r\n   175\t\t\t\tif ss.listenerStop != nil {\r\n   176\t\t\t\t\tclose(ss.listenerStop)\r\n   177\t\t\t\t\tss.listenerStop = nil\r\n   178\t\t\t\t}\r\n   179\t\t\t\tif ss.Listener != nil {\r\n   180\t\t\t\t\tss.Listener.Close()\r\n   181\t\t\t\t\tss.Listener = nil\r\n   182\t\t\t\t}\r\n"]
