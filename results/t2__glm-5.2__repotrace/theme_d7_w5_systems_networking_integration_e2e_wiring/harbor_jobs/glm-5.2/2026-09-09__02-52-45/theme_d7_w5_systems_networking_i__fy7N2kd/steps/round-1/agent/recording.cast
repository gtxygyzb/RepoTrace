[1970.254604, "o", "   419\tfunc (ep *EndpointState) TryAddConnection(conn net.Conn, maxConns int) (int64, bool) {\r\n   420\t\tep.mu.Lock()\r\n   421\t\tdefer ep.mu.Unlock()\r\n   422\t\tif ep.ActiveConnections >= maxConns {\r\n   423\t\t\treturn 0, false\r\n   424\t\t}\r\n   425\t\tid := atomic.AddInt64(&ep.connIDCounter, 1)\r\n"]
[1970.254669, "o", "   426\t\tep.connections[id] = conn\r\n   427\t\tep.ActiveConnections++\r\n   428\t\treturn id, true\r\n   429\t}\r\n   430\t\r\n   431\tfunc (ep *EndpointState) CloseConnections() {\r\n   432\t\tep.mu.Lock()"]
