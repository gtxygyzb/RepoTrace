[9670.665188, "o", "func (ss *ServiceState) AcquireRateLimitToken() (allowed bool, queued bool, queueWaitMs int64, timedOut bool) {\r\n\tss.mu.Lock()\r\n\trl := ss.rateLimiter\r\n\tss.mu.Unlock()\r\n\tif rl == nil {\r\n\t\t"]
[9670.665263, "o", "return true, false, 0, false\r\n\t}\r\n\treturn rl.acquire(time.Now())\r\n}\r\n"]
