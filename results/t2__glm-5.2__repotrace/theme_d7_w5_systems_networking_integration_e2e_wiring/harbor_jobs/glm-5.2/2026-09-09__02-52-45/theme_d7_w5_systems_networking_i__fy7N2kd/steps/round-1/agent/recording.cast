[8564.707367, "o", "    23\t\tcfg, err := config.Load(*cfgPath)\r\n    24\t\tif err != nil {\r\n    25\t\t\tlog.Fatalf(\"config load failed: %v\", err)\r\n    26\t\t}\r\n    27\t\r\n    28\t\tst := state.NewState(cfg, *cfgPath)\r\n    29\t\tmonitor := health.NewMonitor(st, cfg)\r\n    30\t\trouter := router.NewRouter(st)\r\n    31\t\taccessLog := accesslog.New(accesslog.DefaultPath)\r\n    32\t\trouter.SetAccessLogger(accessLog)\r\n    33\t\tipcServer := ipc.NewServer(st, \"/tmp/meshd.sock\")\r\n    34\t"]
[8564.707507, "o", "\r\n    35\t\tif err := ipcServer.Start(); err != nil {\r\n    36\t\t\tlog.Fatalf(\"ipc server failed: %v\", err)\r\n    37\t\t}\r\n    38\t\tmonitor.Start()\r\n    39\t\trouter.Start()\r\n    40\t\r\n    41\t\tsigCh := make(chan os.Signal, 1)\r\n    42\t\tsignal.Notify(sigCh, syscall.SIGHUP, syscall.SIGTERM, syscall.SIGINT)\r\n    43\t\tvar reloadMu sync.Mutex\r\n    44\t\tfor {\r\n    45\t\t\tsig := <-sigCh\r\n    46\t\t\tif sig == syscall.SIGHUP {\r\n"]
[8564.70757, "o", "    47\t\t\t\treloadMu.Lock()\r\n    48\t\t\t\tpath := st.ConfigPath()\r\n    49\t\t\t\tnewCfg, err := config.Load(path)\r\n    50\t\t\t\tif err != nil {\r\n    51\t\t\t\t\tlog.Printf(\"reload failed: %v\", err)\r\n    52\t\t\t\t\treloadMu.Unlock()\r\n    53\t\t\t\t\tcontinue\r\n    54\t\t\t\t}\r\n"]
[8564.707629, "o", "    55\t\t\t\tst.ApplyConfig(newCfg)\r\n    56\t\t\t\tmonitor.ApplyConfig(newCfg)\r\n    57\t\t\t\trouter.Reload()\r\n    58\t\t\t\treloadMu.Unlock()\r\n    59\t\t\t\tlog.Printf(\"reloaded config\")\r\n    60\t\t\t} else {\r\n    61\t\t\t\tbreak\r\n"]
[8564.707686, "o", "    62\t\t\t}\r\n    63\t\t}\r\n    64\t\r\n    65\t\tmonitor.Stop()\r\n    66\t\trouter.Stop()\r\n    67\t\taccessLog.Stop()\r\n    68\t\tipcServer.Stop()\r\n"]
[8564.707743, "o", "    69\t}\r\n"]
