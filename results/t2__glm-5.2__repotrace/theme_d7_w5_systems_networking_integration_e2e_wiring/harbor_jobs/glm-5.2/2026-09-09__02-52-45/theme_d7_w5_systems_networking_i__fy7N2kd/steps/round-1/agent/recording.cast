[5871.039179, "o", "    81\t\tif len(regular) == 0 {\r\n    82\t\t\tfor _, ep := range endpoints {\r\n    83\t\t\t\tep.mu.Lock()\r\n    84\t\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining\r\n    85\t\t\t\tep.mu.Unlock()\r\n"]
[5871.039276, "o", "    86\t\t\t\tif halfOpen {\r\n    87\t\t\t\t\treturn ep, nil\r\n    88\t\t\t\t}\r\n    89\t\t\t}\r\n    90\t\t\treturn nil, errNotFound(\"no eligible endpoints\")\r\n    91\t\t}\r\n    92\t\tif mode == \"least-connections\" {\r\n    93\t\t\treturn selectLeastConnections(regular, 1<<30), nil\r\n    94\t\t}\r\n    95\t\treturn selectWeightedCandidate(regular), nil\r\n    96\t}\r\n    97\t\r\n    98\tfunc selectWeighted(eps []*EndpointState) *EndpointState {\r\n    99\t\tvar best *EndpointState\r\n"]
[5871.039351, "o", "   100\t\tvar bestWeight int\r\n   101\t\tvar totalWeight int\r\n   102\t\tfor _, ep := range eps {\r\n   103\t\t\tep.mu.Lock()\r\n   104\t\t\tep.currentWeight += ep.Weight\r\n   105\t"]
[5871.039434, "o", "\t\ttotalWeight += ep.Weight\r\n   106\t\t\tcw := ep.currentWeight\r\n   107\t\t\tep.mu.Unlock()\r\n   108\t\t\tif best == nil || cw > bestWeight {\r\n   109\t\t\t\tbest = ep\r\n   110\t\t\t\tbestWeight = cw\r\n   111\t\t\t}\r\n   112\t\t}\r\n   113\t\tif best != nil {\r\n   114\t\t\tbest.mu.Lock()\r\n   115\t\t\tbest.currentWeight -= totalWeight\r\n   116\t\t\tbest.mu.Unlock()\r\n   117\t\t}\r\n   118\t\treturn best\r\n   119\t}\r\n   120\t\r\n"]
[5871.039496, "o", "   121\tfunc selectWeightedCandidate(eps []*EndpointState) *EndpointState {\r\n   122\t\tvar best *EndpointState\r\n   123\t\tvar bestWeight int\r\n   124\t\tfor _, ep := range eps {\r\n   125\t\t\tep.mu.Lock()\r\n   126\t\t\tcw := ep.currentWeight + ep.Weight\r\n   127\t\t\tep.mu.Unlock()\r\n   128\t\t\tif best == nil || cw > bestWeight {\r\n   129\t\t"]
[5871.039553, "o", "\t\tbest = ep\r\n   130\t\t\t\tbestWeight = cw\r\n   131\t\t\t}\r\n   132\t\t}\r\n   133\t\treturn best\r\n   134\t}\r\n   135\t\r\n   136\tfunc selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\r\n"]
[5871.039612, "o", "   137\t\tsort.SliceStable(eps, func(i, j int) bool {\r\n   138\t\t\tai := eps[i].Active()\r\n   139\t\t\taj := eps[j].Active()\r\n   140\t\t\tif ai != aj {\r\n   141\t\t\t\treturn ai < aj\r\n   142\t\t\t}\r\n   143\t\t\t// Tie-break by weight (higher weight first), then lexicographic address.\r\n   144\t\t\twi := eps[i].Weight\r\n   145\t\t\twj := eps[j].Weight\r\n"]
[5871.039667, "o", "   146\t\t\tif wi != wj {\r\n   147\t\t\t\treturn wi > wj\r\n   148\t\t\t}\r\n   149\t\t\treturn eps[i].Address < eps[j].Address\r\n   150\t\t})\r\n   151\t\treturn eps[0]\r\n   152\t}\r\n   153\t\r\n"]
[5871.039723, "o", "   154\t// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\r\n   155\tfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\r\n   156\t\tss := s.GetService(service)\r\n   157\t\tif ss == nil {\r\n   158\t\t\treturn SelectResult{}, errNotFound(\"service not found\")\r\n   159\t\t}\r\n   160\t\tss.mu.Lock()\r\n"]
