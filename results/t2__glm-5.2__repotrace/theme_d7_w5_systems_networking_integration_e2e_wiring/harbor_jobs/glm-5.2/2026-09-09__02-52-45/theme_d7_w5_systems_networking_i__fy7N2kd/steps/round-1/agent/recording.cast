[13869.785761, "o", "\t\"errors\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"net\"\r\n     9\t\t\"os\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t\t\"sync\"\r\n    13\t\r\n    14\t\t\"meshrouter/internal/accesslog\"\r\n    15\t\t\"meshrouter/internal/config\"\r\n    16\t\t\"meshrouter/internal/state\"\r\n"]
