[1366.976454, "o", "\u001b[?2004h> "]
[1366.976549, "o", "        if len(os.Args) < 3 {\r\n\u001b[?2004l\r"]
[1366.976604, "o", "\u001b[?2004h> "]
[1366.976885, "o", "            fmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")\r\n\u001b[?2004l\r"]
[1366.97694, "o", "\u001b[?2004h> "]
[1366.977023, "o", "            os.Exit(1)\r\n\u001b[?2004l\r"]
[1366.977083, "o", "\u001b[?2004h> "]
[1366.97714, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1366.97728, "o", "        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
[1366.977335, "o", "\u001b[?2004h> "]
[1367.009492, "o", "    case \"reset-circuit\":\r\n\u001b[?2004l\r"]
[1367.00967, "o", "\u001b[?2004h> "]
[1367.009725, "o", "        if len(os.Args) < 4 {\r\n\u001b[?2004l\r"]
[1367.009783, "o", "\u001b[?2004h> "]
[1367.010275, "o", "            fmt.Fprintln(os.Stderr, \"usage: meshctl reset-circuit <service> <endpoint>\")\r\n\u001b[?2004l\r"]
[1367.010358, "o", "\u001b[?2004h> "]
[1367.010472, "o", "            os.Exit(1)\r\n\u001b[?2004l\r"]
[1367.010549, "o", "\u001b[?2004h> "]
[1367.010624, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1367.010819, "o", "        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
[1367.010875, "o", "\u001b[?2004h> "]
[1367.011082, "o", "        args[\"address\"] = os.Args[3]\r\n\u001b[?2004l\r"]
[1367.011137, "o", "\u001b[?2004h> "]
[1367.011248, "o", "    case \"reload\":\r\n\u001b[?2004l\r"]
[1367.011312, "o", "\u001b[?2004h> "]
[1367.011398, "o", "    default:\r\n\u001b[?2004l\r"]
[1367.011459, "o", "\u001b[?2004h> "]
[1367.011795, "o", "        fmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\u001b[?2004l\r"]
[1367.011928, "o", "\u001b[?2004h"]
[1367.011988, "o", ">         os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.012049, "o", ">     }\r\n\u001b[?2004l\r"]
[1367.012106, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1367.012172, "o", "\u001b[?2004h> "]
[1367.012405, "o", "    data, err := sendCommand(cmd, args)\r\n\u001b[?2004l\r"]
[1367.012464, "o", "\u001b[?2004h> "]
[1367.012573, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1367.012628, "o", "\u001b[?2004h> "]
[1367.012837, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r"]
[1367.012892, "o", "\u001b[?2004h> "]
[1367.013001, "o", "        os.Exit(1)\r\n\u001b[?2004l\r"]
[1367.013057, "o", "\u001b[?2004h> "]
[1367.013111, "o", "    }\r\n\u001b[?2004l\r"]
[1367.013167, "o", "\u001b[?2004h> "]
[1367.013275, "o", "    fmt.Println(data)\r\n\u001b[?2004l\r"]
[1367.013331, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1367.013419, "o", "\u001b[?2004h"]
[1367.013489, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1367.013898, "o", "func sendCommand(cmd string, args map[string]interface{}) (string, error) {\r\n\u001b[?2004l\r"]
[1367.013959, "o", "\u001b[?2004h> "]
[1367.014174, "o", "    rawArgs, err := json.Marshal(args)\r\n\u001b[?2004l\r"]
[1367.014235, "o", "\u001b[?2004h> "]
[1367.014346, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1367.014418, "o", "\u001b[?2004h> "]
[1367.014616, "o", "        return \"\", err\r\n\u001b[?2004l\r"]
[1367.014683, "o", "\u001b[?2004h> "]
[1367.01474, "o", "    }\r\n\u001b[?2004l\r"]
[1367.014795, "o", "\u001b[?2004h> "]
[1367.015026, "o", "    req := request{Cmd: cmd, Args: rawArgs}\r\n\u001b[?2004l\r"]
[1367.015083, "o", "\u001b[?2004h> "]
[1367.0153, "o", "    reqBytes, err := json.Marshal(req)\r\n\u001b[?2004l\r"]
[1367.015365, "o", "\u001b[?2004h> "]
[1367.015482, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1367.015541, "o", "\u001b[?2004h> "]
[1367.015669, "o", "        return \"\", err\r\n\u001b[?2004l\r"]
[1367.015726, "o", "\u001b[?2004h> "]
[1367.01578, "o", "    }\r\n\u001b[?2004l\r"]
[1367.015836, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1367.015891, "o", "\u001b[?2004h> "]
[1367.016177, "o", "    conn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\u001b[?2004l\r"]
[1367.016236, "o", "\u001b[?2004h> "]
[1367.016351, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1367.016423, "o", "\u001b[?2004h> "]
[1367.016787, "o", "        return \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n\u001b[?2004l\r"]
[1367.016857, "o", "\u001b[?2004h> "]
[1367.016912, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.016968, "o", "> "]
[1367.017074, "o", "    defer conn.Close()\r\n\u001b[?2004l\r"]
[1367.01713, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1367.01719, "o", "\u001b[?2004h> "]
[1367.017476, "o", "    fmt.Fprintf(conn, \"%s\\n\", string(reqBytes))\r\n\u001b[?2004l\r"]
[1367.017546, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1367.017601, "o", "\u001b[?2004h> "]
[1367.017796, "o", "    reader := bufio.NewReader(conn)\r\n\u001b[?2004l\r"]
[1367.017855, "o", "\u001b[?2004h> "]
[1367.018084, "o", "    line, err := reader.ReadString('\\n')\r\n\u001b[?2004l\r"]
[1367.018148, "o", "\u001b[?2004h> "]
[1367.01827, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1367.018328, "o", "\u001b[?2004h> "]
[1367.018479, "o", "        return \"\", err\r\n\u001b[?2004l\r"]
[1367.01854, "o", "\u001b[?2004h> "]
[1367.018601, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.018656, "o", "> "]
[1367.01888, "o", "    line = strings.TrimRight(line, \"\\r\\n\")\r\n\u001b[?2004l\r"]
[1367.018945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1367.018998, "o", "\u001b[?2004h"]
[1367.019052, "o", "> "]
[1367.019143, "o", "    var resp response\r\n\u001b[?2004l\r"]
[1367.019197, "o", "\u001b[?2004h> "]
[1367.019608, "o", "    if err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n\u001b[?2004l\r"]
[1367.019668, "o", "\u001b[?2004h> "]
[1367.019794, "o", "        return \"\", err\r\n\u001b[?2004l\r"]
[1367.019849, "o", "\u001b[?2004h> "]
[1367.019903, "o", "    }\r\n\u001b[?2004l\r"]
[1367.019941, "o", "\u001b[?2004h> "]
[1367.020108, "o", "    if resp.Status != \"ok\" {\r\n\u001b[?2004l\r"]
[1367.020164, "o", "\u001b[?2004h> "]
[1367.020291, "o", "        var msg string\r\n\u001b[?2004l\r"]
[1367.020346, "o", "\u001b[?2004h> "]
[1367.020786, "o", "        if err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n\u001b[?2004l\r"]
[1367.020852, "o", "\u001b[?2004h> "]
[1367.0211, "o", "            return \"\", fmt.Errorf(\"%s\", msg)\r\n\u001b[?2004l\r"]
[1367.021155, "o", "\u001b[?2004h> "]
[1367.021215, "o", "        }\r\n\u001b[?2004l\r"]
[1367.02127, "o", "\u001b[?2004h> "]
[1367.021588, "o", "        return \"\", fmt.Errorf(\"%s\", string(resp.Data))\r\n\u001b[?2004l\r"]
[1367.02165, "o", "\u001b[?2004h> "]
[1367.021704, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.021758, "o", "> "]
[1367.02195, "o", "    return prettyData(cmd, resp.Data)\r\n\u001b[?2004l\r"]
[1367.022004, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1367.022059, "o", "\u001b[?2004h> \r\n"]
[1367.022113, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1367.02217, "o", "> "]
[1367.022539, "o", "func prettyData(cmd string, data json.RawMessage) (string, error) {\r\n\u001b[?2004l\r"]
[1367.022619, "o", "\u001b[?2004h> "]
[1367.022695, "o", "    switch cmd {\r\n\u001b[?2004l\r"]
[1367.02277, "o", "\u001b[?2004h> "]
[1367.022845, "o", "    case \"status\":\r\n\u001b[?2004l\r"]
[1367.022949, "o", "\u001b[?2004h> "]
[1367.023096, "o", "        var services []struct {\r\n\u001b[?2004l\r"]
[1367.023213, "o", "\u001b[?2004h> "]
[1367.023407, "o", "            Name        string `json:\"name\"`\r\n\u001b[?2004l\r"]
[1367.023485, "o", "\u001b[?2004h> "]
[1367.023749, "o", "            ListenPort  int    `json:\"listen_port\"`\r\n\u001b[?2004l\r"]
[1367.023845, "o", "\u001b[?2004h"]
[1367.023934, "o", "> "]
[1367.024102, "o", "            RoutingMode string `json:\"routing_mode\"`\r\n\u001b[?2004l\r"]
[1367.024194, "o", "\u001b[?2004h> "]
[1367.02432, "o", "            Endpoints   []struct {\r\n\u001b[?2004l\r"]
[1367.024375, "o", "\u001b[?2004h> "]
[1367.024628, "o", "                Address            string `json:\"address\"`\r\n\u001b[?2004l\r"]
[1367.024692, "o", "\u001b[?2004h> "]
[1367.024909, "o", "                State             string `json:\"state\"`\r\n\u001b[?2004l\r"]
[1367.024975, "o", "\u001b[?2004h> "]
[1367.02518, "o", "                Weight            int    `json:\"weight\"`\r\n\u001b[?2004l\r"]
[1367.025235, "o", "\u001b[?2004h> "]
[1367.025506, "o", "                ActiveConnections int    `json:\"active_connections\"`\r\n\u001b[?2004l\r"]
[1367.025567, "o", "\u001b[?2004h> "]
[1367.025811, "o", "                CircuitState       string `json:\"circuit_state\"`\r\n\u001b[?2004l\r"]
[1367.025865, "o", "\u001b[?2004h> "]
[1367.025985, "o", "            } `json:\"endpoints\"`\r\n\u001b[?2004l\r"]
[1367.026045, "o", "\u001b[?2004h> "]
[1367.026099, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1367.026369, "o", "        if err := json.Unmarshal(data, &services); err != nil {\r\n\u001b[?2004l\r"]
[1367.026446, "o", "\u001b[?2004h> "]
[1367.026527, "o", "            return \"\", err\r\n\u001b[?2004l\r"]
[1367.026582, "o", "\u001b[?2004h> "]
[1367.026654, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1367.026776, "o", "        var b strings.Builder\r\n\u001b[?2004l\r"]
[1367.02683, "o", "\u001b[?2004h> "]
[1367.027324, "o", "        fmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\r\n\u001b[?2004l\r"]
[1367.027401, "o", "\u001b[?2004h> "]
[1367.027531, "o", "        for _, svc := range services {\r\n\u001b[?2004l\r"]
[1367.027586, "o", "\u001b[?2004h> "]
[1367.027764, "o", "            for _, ep := range svc.Endpoints {\r\n\u001b[?2004l\r"]
[1367.027819, "o", "\u001b[?2004h> "]
[1367.028443, "o", "                fmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\r\n\u001b[?2004l\r"]
[1367.028502, "o", "\u001b[?2004h> "]
[1367.028559, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.028613, "o", "> "]
[1367.028679, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1367.0289, "o", "        return strings.TrimRight(b.String(), \"\\n\"), nil\r\n\u001b[?2004l\r"]
[1367.028958, "o", "\u001b[?2004h> "]
[1367.029036, "o", "    case \"resolve\":\r\n\u001b[?2004l\r"]
[1367.029092, "o", "\u001b[?2004h> "]
[1367.029178, "o", "        var addr string\r\n\u001b[?2004l\r"]
[1367.029232, "o", "\u001b[?2004h> "]
[1367.029485, "o", "        if err := json.Unmarshal(data, &addr); err != nil {\r\n\u001b[?2004l\r"]
[1367.02954, "o", "\u001b[?2004h> "]
[1367.029641, "o", "            return \"\", err\r\n\u001b[?2004l\r"]
[1367.029698, "o", "\u001b[?2004h> "]
[1367.029752, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1367.029868, "o", "        return addr, nil\r\n\u001b[?2004l\r"]
[1367.029923, "o", "\u001b[?2004h> "]
[1367.030147, "o", "    case \"set-weight\", \"drain\", \"reset-circuit\", \"reload\":\r\n\u001b[?2004l\r"]
[1367.030204, "o", "\u001b[?2004h> "]
[1367.030276, "o", "        var s string\r\n\u001b[?2004l\r"]
[1367.03033, "o", "\u001b[?2004h> "]
[1367.030551, "o", "        if err := json.Unmarshal(data, &s); err != nil {\r\n\u001b[?2004l\r"]
[1367.030607, "o", "\u001b[?2004h> "]
[1367.030741, "o", "            return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1367.030811, "o", "        }\r\n\u001b[?2004l\r"]
[1367.030867, "o", "\u001b[?2004h> "]
[1367.030931, "o", "        return s, nil\r\n\u001b[?2004l\r"]
[1367.030986, "o", "\u001b[?2004h> "]
[1367.031041, "o", "    default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1367.031165, "o", "        var v interface{}\r\n\u001b[?2004l\r"]
[1367.03122, "o", "\u001b[?2004h> "]
[1367.031442, "o", "        if err := json.Unmarshal(data, &v); err != nil {\r\n\u001b[?2004l\r"]
[1367.031499, "o", "\u001b[?2004h> "]
[1367.031597, "o", "            return \"\", err\r\n\u001b[?2004l\r"]
[1367.031651, "o", "\u001b[?2004h> "]
[1367.031708, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1367.031938, "o", "        b, err := json.MarshalIndent(v, \"\", \"  \")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.031989, "o", "> "]
[1367.032079, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.032159, "o", "> "]
[1367.032235, "o", "            return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.032311, "o", ">         }\r\n\u001b[?2004l\r"]
[1367.032398, "o", "\u001b[?2004h> "]
[1367.032474, "o", "        return string(b), nil\r\n\u001b[?2004l\r"]
[1367.032548, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1367.032624, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1367.032699, "o", "EOF\r\n\u001b[?2004l\r"]
[1367.035697, "o", "\u001b[?2004hroot@n30009:/app# "]
[1367.248228, "i", "gofmt -w cmd/meshctl/main.go\ngo build -o meshctl ./cmd/meshctl\n"]
[1367.248538, "o", "gofmt -w cmd/meshctl/main.go\r\n\u001b[?2004l\r"]
[1367.259349, "o", "\u001b[?2004hroot@n30009:/app# "]
[1367.259577, "o", "go build -o meshctl ./cmd/meshctl\r\n\u001b[?2004l\r"]
[1368.620306, "i", "rm -f /tmp/meshd.sock\n./meshd --config /app/config/services.toml >/tmp/meshd.log 2>&1 &\necho $! >/tmp/meshd.pid\nsleep 1\n./meshctl status\n"]
[1368.620636, "o", "rm -f /tmp/meshd.sock\r\n./meshd --config /app/config/services.toml >/tmp/meshd.log 2>&1 &\r\necho $! >/tmp/meshd.pid\r\nsleep 1\r\n./meshctl status\r\n"]
[1369.470439, "o", "\u001b[?2004hroot@n30009:/app# "]
[1369.470716, "o", "rm -f /tmp/meshd.sock\r\n\u001b[?2004l\r"]
[1369.473342, "o", "\u001b[?2004h"]
[1369.473454, "o", "root@n30009:/app# "]
[1369.473773, "o", "./meshd --config /app/config/services.toml >/tmp/meshd.log 2>&1 &\r\n\u001b[?2004l\r"]
[1369.474241, "o", "[1] 7187\r\n"]
[1369.47443, "o", "\u001b[?2004h"]
[1369.474489, "o", "root@n30009:/app# "]
[1369.474628, "o", "echo $! >/tmp/meshd.pid\r\n\u001b[?2004l\r"]
[1369.475027, "o", "\u001b[?2004h"]
[1369.475085, "o", "root@n30009:/app# "]
[1369.475139, "o", "sleep 1\r\n\u001b[?2004l\r"]
[1370.478231, "o", "\u001b[?2004hroot@n30009:/app# "]
[1370.478539, "o", "./meshctl status\r\n\u001b[?2004l\r"]
[1370.486525, "o", "unknown command: status\r\n"]
[1370.487595, "o", "\u001b[?2004h"]
[1370.487674, "o", "root@n30009:/app# "]
[1373.697913, "i", "\n"]
[1373.698168, "o", "\r\n\u001b[?2004l\r\u001b[?2004hroot@n30009:/app# "]
[1455.793097, "i", "python3 - <<'PY'\np='internal/ipc/server.go'\ns=open(p).read()\nneedle='''    case \"reload_config\":'''\ninsert='''    case \"resolve\":\n        var args struct {\n            Name string `json:\"name\"`\n        }\n        if err := json.Unmarshal(req.Args, &args); err != nil {\n            return nil, err\n        }\n        addr, err := s.state.ResolveEndpoint(args.Name)\n        if err != nil {\n            return nil, err\n        }\n        return addr, nil\n'''\nif 'case \"resolve\":' not in s:\n    s=s.replace(needle, insert + needle)\nopen(p,'w').write(s)\nPY\ngofmt -w internal/ipc/server.go\ngo build ./...\n"]
[1455.793317, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[1455.793465, "o", "\u001b[?2004h> "]
[1455.793641, "o", "p='internal/ipc/server.go'\r\n\u001b[?2004l\r"]
[1455.7937, "o", "\u001b[?2004h> "]
[1455.793809, "o", "s=open(p).read()\r\n\u001b[?2004l\r"]
[1455.793869, "o", "\u001b[?2004h> "]
[1455.794088, "o", "needle='''    case \"reload_config\":'''\r\n\u001b[?2004l\r"]
