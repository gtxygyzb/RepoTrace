[9729.144123, "o", "\trl.queueDepth++\r\n\trl.queued++\r\n\trl.mu.Unlock()\r\n\r\n\tdeadline := now.Add(rl.timeout)\r\n\tqueueStart := now\r\n\t"]
[9729.144247, "o", "for {\r\n\t\trl.mu.Lock()\r\n\t\tvar wait time.Duration\r\n\t\tif rl.rps > 0 {\r\n\t\t\tneeded := 1.0 - rl.tokens\r\n\t\t\tif needed > 0 {\r\n\t\t\t\twait = time.Duration(needed / rl.rps * float64(time.Second))\r\n\t\t\t}\r\n\t\t}\r\n\t\trl.mu.Unlock()\r\n\r\n\t\tif wait <= 0 {\r\n\t\t\trl.mu.Lock()\r\n\t\t\tif rl.tryAcquireLocked(time.Now()) {\r\n\t\t\t\trl.queueDepth--\r\n\t\t\t\trl.mu.Unlock()\r\n"]
[9729.144365, "o", "\t\t\t\treturn true, true, time.Since(queueStart).Milliseconds(), false\r\n\t\t\t}\r\n\t\t\trl.mu.Unlock()\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tremaining := time.Until(deadline)\r\n\t\tif remaining <= 0 {\r\n\t\t\trl.mu.Lock()\r\n\t\t\trl.queueDepth--\r\n\t\t\trl.timeouts++\r\n\t\t\trl.rateLimited++\r\n\t\t\trl.mu.Unlock()\r\n\t\t\treturn false, true, time.Since(queueStart).Milliseconds(), true\r\n\t\t}\r\n"]
[9729.144822, "o", "\u001b[?2004hroot@n30009:/app# "]
