[6842.016078, "o", "   201\tfunc (s *State) ResolveEndpoint(service string) (string, error) {\r\n   202\t\tss := s.GetService(service)\r\n   203\t\tif ss == nil {\r\n   204\t\t\treturn \"\", errNotFound(\"service not found\")\r\n   205\t\t}\r\n   206\t\t"]
[6842.016181, "o", "ss.mu.Lock()\r\n   207\t\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n   208\t\tmode := ss.RoutingMode\r\n   209\t"]
[6842.016249, "o", "\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n   210\t\tcopy(endpoints, ss.Endpoints)\r\n   211\t\tss.mu.Unlock()\r\n   212\t\r\n   213\t\tvar regular []*EndpointState\r\n   214\t\tfor _, ep := range endpoints {\r\n   215\t\t\tif ep.IsEligible(maxConns) {\r\n   216\t\t\t\tregular = append(regular, ep)\r\n   217\t\t\t}\r\n   218\t\t}\r\n"]
[6842.016327, "o", "   219\t\r\n   220\t\tif len(regular) > 0 {\r\n   221\t\t\tif mode == \"least-connections\" {\r\n   222\t\t\t\tep := selectLeastConnections(regular, maxConns)\r\n   223\t\t\t\treturn ep.Address, nil\r\n   224\t\t\t}\r\n   225\t\t\tvar best *EndpointState\r\n   226\t\t\tvar bestWeight int\r\n   227\t\t\tfor _, ep := range regular {\r\n   228\t\t\t\tep.mu.Lock()\r\n   229\t\t\t\tcw := ep.currentWeight + ep.Weight\r\n   230\t\t\t\tep.mu.Unlock()\r\n"]
[6842.016399, "o", "   231\t\t\t\tif best == nil || cw > bestWeight {\r\n   232\t\t\t\t\tbest = ep\r\n   233\t\t\t\t\tbestWeight = cw\r\n"]
[6842.016421, "o", "   234\t\t\t\t}\r\n   235\t\t\t}\r\n"]
[6842.016961, "o", "\u001b[?2004h"]
[6842.017031, "o", "root@n30009:/app# "]
[6842.304778, "i", "nl -ba internal/state/routing.go | sed -n '59,96p'\n"]
[6842.305197, "o", "nl -ba internal/state/routing.go | sed -n '59,96p'\r\n\u001b[?2004l\r"]
[6842.309255, "o", "    59\t\r\n    60\tfunc selectWeighted(eps []*EndpointState) *EndpointState {\r\n    61\t\tvar best *EndpointState\r\n    62\t\tvar bestWeight int\r\n    63\t\tvar totalWeight int\r\n    64\t"]
[6842.309452, "o", "\tfor _, ep := range eps {\r\n    65\t\t\tep.mu.Lock()\r\n    66\t\t\tw := ep.effectiveWeightLocked()\r\n    67\t\t\tep.currentWeight += w\r\n    68\t\t\ttotalWeight += w\r\n    69\t\t\tcw := ep.currentWeight\r\n    70\t\t\tep.mu.Unlock()\r\n    71\t\t\tif best == nil || cw > bestWeight {\r\n    72\t\t\t\tbest = ep\r\n    73\t\t\t\tbestWeight = cw\r\n    74\t\t\t}\r\n    75\t\t}\r\n    76\t\tif best != nil {\r\n    77\t\t\tbest.mu.Lock()\r\n    78\t\t\tbest.currentWeight -= totalWeight\r\n    79\t\t\tbest.mu.Unlock()\r\n    80\t\t}\r\n    81\t\treturn best\r\n    82\t}\r\n    83\t\r\n    84\tfunc selectWeightedCandidate(eps []*EndpointState) *EndpointState {\r\n    85\t\tvar best *EndpointState\r\n    86\t\tvar bestWeight int\r\n    87\t\tfor _, ep := range eps {\r\n"]
[6842.309554, "o", "    88\t\t\tep.mu.Lock()\r\n    89\t\t\tcw := ep.currentWeight + ep.effectiveWeightLocked()\r\n    90\t\t\tep.mu.Unlock()\r\n    91\t\t\tif best == nil || cw > bestWeight {\r\n    92\t\t\t\tbest = ep\r\n    93\t\t\t\tbestWeight = cw\r\n    94\t\t\t}\r\n    95\t\t}\r\n    96\t\treturn best\r\n"]
