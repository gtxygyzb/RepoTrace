[10753.238895, "o", "\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc New\u001b[m\u001b[K(window time.Duration) *Collector {\r\n"]
[10753.239019, "o", "\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif window <= 0 {\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\twindow = time.Minute\r\n\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\treturn &Collector{window: window}\r\n"]
[10753.239045, "o", "\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// RecordConnection records a finished connection attempt.\r\n\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\r\n"]
[10753.239164, "o", "\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.mu.Lock()\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer c.mu.Unlock()\r\n\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tnow := time.Now()\r\n\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n"]
[10753.239176, "o", "\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KRecordRejection\u001b[m\u001b[K records a rejected connection because the endpoint was at capacity.\r\n"]
[10753.239274, "o", "\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Collector) \u001b[01;31m\u001b[KRecordRejection\u001b[m\u001b[K() {\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.mu.Lock()\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer c.mu.Unlock()\r\n\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tnow := time.Now()\r\n"]
[10753.239285, "o", "\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.rejections = append(c.rejections, now)\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.trim(now)\r\n"]
[10753.239374, "o", "\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KRecordRateLimited\u001b[m\u001b[K records a rate limit rejection.\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Collector) \u001b[01;31m\u001b[KRecordRateLimited\u001b[m\u001b[K() {\r\n"]
[10753.239444, "o", "\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.mu.Lock()\r\n\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer c.mu.Unlock()\r\n\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.rateLimited++\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[10753.239498, "o", "\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KRecordQueued\u001b[m\u001b[K records a connection that was queued waiting for a token.\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Collector) \u001b[01;31m\u001b[KRecordQueued\u001b[m\u001b[K() {\r\n"]
[10753.239599, "o", "\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.mu.Lock()\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer c.mu.Unlock()\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.queued++\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KRecordQueueTimeout\u001b[m\u001b[K records a queue timeout rejection.\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Collector) \u001b[01;31m\u001b[KRecordQueueTimeout\u001b[m\u001b[K() {\r\n"]
[10753.239668, "o", "\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.mu.Lock()\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer c.mu.Unlock()\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.queueTimeouts++\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.rateLimited++\r\n\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[10753.23968, "o", "\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KRecordRetry\u001b[m\u001b[K records a retry attempt.\r\n"]
[10753.23973, "o", "\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Collector) \u001b[01;31m\u001b[KRecordRetry\u001b[m\u001b[K() {\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.mu.Lock()\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer c.mu.Unlock()\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.retries++\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[10753.239815, "o", "\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KRecordRetrySuccess\u001b[m\u001b[K records a successful retry attempt.\r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Collector) \u001b[01;31m\u001b[KRecordRetrySuccess\u001b[m\u001b[K() {\r\n"]
[10753.23988, "o", "\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.mu.Lock()\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer c.mu.Unlock()\r\n\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.retrySuccesses++\r\n\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[10753.239943, "o", "\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KRecordIdleTimeout\u001b[m\u001b[K records a connection that was closed because it was idle.\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Collector) \u001b[01;31m\u001b[KRecordIdleTimeout\u001b[m\u001b[K() {\r\n"]
[10753.240006, "o", "\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.mu.Lock()\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer c.mu.Unlock()\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.idleTimeouts++\r\n"]
[10753.240018, "o", "\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
[10753.240025, "o", "\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[10753.240113, "o", "\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (c *Collector) trim(now time.Time) {\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcutoff := now.Add(-c.window)\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\ti := 0\r\n\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\ti++\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif i > 0 {\r\n"]
[10753.240623, "o", "\u001b[?2004h"]
[10753.240696, "o", "root@n30009:/app# "]
[10758.824808, "i", "sed -n '1,80p' internal/stats/stats.go\n"]
[10758.825155, "o", "sed -n '1,80p' internal/stats/stats.go\r\n"]
[10758.825259, "o", "\u001b[?2004l\r"]
[10758.828289, "o", "package stats\r\n\r\nimport (\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n"]
[10758.828377, "o", "\r\ntype entry struct {\r\n\ttimestamp time.Time\r\n\tbytesIn   int64\r\n\tbytesOut  int64\r\n\tlatency   time.Duration\r\n\terr       bool\r\n}\r\n\r\n// Collector keeps rolling connection statistics for one endpoint.\r\ntype Collector struct {\r\n\tmu         sync.Mutex\r\n\twindow     time.Duration\r\n\tentries    []entry\r\n\trejections []time.Time\r\n\r\n\trateLimited    int\r\n\tqueued         int\r\n\tqueueTimeouts  int\r\n"]
[10758.828498, "o", "\tretries        int\r\n\tretrySuccesses int\r\n\tidleTimeouts   int\r\n}\r\n\r\n// New creates a collector with the given window length.\r\nfunc New(window time.Duration) *Collector {\r\n\tif window <= 0 {\r\n\t\twindow = time.Minute\r\n\t}\r\n"]
[10758.828572, "o", "\treturn &Collector{window: window}\r\n}\r\n\r\n// RecordConnection records a finished connection attempt.\r\nfunc (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\r\n\tc.trim(now)\r\n}\r\n\r\n// RecordRejection records a rejected connection because the endpoint was at capacity.\r\nfunc (c *Collector) RecordRejection() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n"]
[10758.828647, "o", "\tnow := time.Now()\r\n\tc.rejections = append(c.rejections, now)\r\n\tc.trim(now)\r\n}\r\n\r\n// RecordRateLimited records a rate limit rejection.\r\nfunc (c *Collector) RecordRateLimited() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.rateLimited++\r\n}\r\n\r\n// RecordQueued records a connection that was queued waiting for a token.\r\n"]
[10758.828712, "o", "func (c *Collector) RecordQueued() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.queued++\r\n}\r\n\r\n// RecordQueueTimeout records a queue timeout rejection.\r\nfunc (c *Collector) RecordQueueTimeout() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.queueTimeouts++\r\n\tc.rateLimited++\r\n}\r\n\r\n// RecordRetry records a retry attempt.\r\nfunc (c *Collector) RecordRetry() {\r\n"]
[10758.829266, "o", "\u001b[?2004h"]
[10758.829324, "o", "root@n30009:/app# "]
[10759.10902, "i", "sed -n '1,100p' internal/state/state.go\n"]
[10759.109351, "o", "sed -n '1,100p' internal/state/state.go\r\n"]
[10759.109517, "o", "\u001b[?2004l\r"]
[10759.112418, "o", "package state\r\n\r\nimport (\r\n\t\"net\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n"]
[10759.112562, "o", "\t\"sync/atomic\"\r\n\t\"time\"\r\n\r\n\t\"meshrouter/internal/circuit\"\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/stats\"\r\n"]
[10759.112661, "o", ")\r\n\r\ntype HealthState string\r\n\r\nconst (\r\n\tUnknown   HealthState = \"unknown\"\r\n\tHealthy   HealthState = \"healthy\"\r\n\tUnhealthy HealthState = \"unhealthy\"\r\n\tDraining  HealthState = \"draining\"\r\n)\r\n\r\ntype HealthEvent struct {\r\n\tTimestamp   time.Time\r\n\tEndpoint    string\r\n\tOldState    HealthState\r\n\tNewState    HealthState\r\n\tCheckResult string\r\n}\r\n\r\ntype EndpointState struct {\r\n\tmu                sync.Mutex\r\n\tAddress           string\r\n\tWeight            int\r\n\tConfig            config.Endpoint\r\n\tState             HealthState\r\n"]
[10759.112751, "o", "\tActiveConnections int\r\n\tCircuit           *circuit.Breaker\r\n\tStats             *stats.Collector\r\n\tconsecSuccess     int\r\n\tconsecFailures    int\r\n\tdrainDeadline     time.Time\r\n\tremoved           bool\r\n\tconnIDCounter     int64\r\n\tcurrentWeight     int\r\n\tWarmupDurationMs  int\r\n\twarmupUntil       time.Time\r\n\tconnections       map[int64]*connectionInfo\r\n"]
[10759.112814, "o", "}\r\n\r\ntype connectionInfo struct {\r\n\tconn         net.Conn\r\n\tclientAddr   string\r\n\tstart        time.Time\r\n\tlastActivity time.Time\r\n\tbytesIn      int64\r\n\tbytesOut     int64\r\n}"]
[10759.112873, "o", "\r\n\r\ntype ServiceState struct {\r\n\tmu                        sync.Mutex\r\n\tName                      string\r\n\tListenPort                int\r\n\tRoutingMode               string\r\n\tDrainTimeoutMs            int\r\n\tMaxConnectionsPerEndpoint int"]
[10759.112951, "o", "\r\n\tConnectionLimitMode       string\r\n\tIdleTimeoutMs             int\r\n\tRateLimitRps              int\r\n\tRateLimitBurst            int\r\n\tRateLimitQueueDepth       int\r\n\tRateLimitQueueTimeoutMs   int\r\n\tMaxRetries                int\r\n\tRetryDelayMs              int\r\n\tRetryBackoffMultiplier    float64\r\n\tRetryMaxDelayMs           int\r\n\t"]
[10759.113058, "o", "rateLimiter               *rateLimiter\r\n\tEndpoints                 []*EndpointState\r\n\trrIndex                   int\r\n\tListener                  net.Listener\r\n"]
[10759.113094, "o", "\tlistenerStop              chan struct{}\r\n\tstopping                  bool\r\n}\r\n\r\ntype State struct {\r\n\tmu         sync.RWMutex\r\n\tconfigPath string\r\n\tglobal     config.Global\r\n\tservices   map[string]*ServiceState\r\n\tlogMu      sync.Mutex\r\n\thealthLog  map[string][]HealthEvent\r\n\treloadCh   chan struct{}\r\n}\r\n\r\n"]
[10759.113184, "o", "func NewState(cfg *config.Config, path string) *State {\r\n\ts := &State{\r\n\t\tconfigPath: path,\r\n\t\tservices:   make(map[string]*ServiceState),\r\n\t\thealthLog:  make(map[string][]HealthEvent),\r\n"]
[10759.113823, "o", "\u001b[?2004h"]
[10759.113888, "o", "root@n30009:/app# "]
[10768.020469, "i", "grep -n \"type EndpointState struct\\|State\\|Circuit\\|func.*Healthy\\|func.*Available\\|Allowed\\|Tripped\\|Open\\|Closed\" -A12 internal/state/state.go internal/circuit/breaker.go | head -220\n"]
[10768.020879, "o", "grep -n \"type EndpointState struct\\|State\\|Circuit\\|func.*Healthy\\|func.*Available\\|Allowed\\|Tripped\\|Open\\|Closed\" -A12 internal/state/state.go internal/circuit/breaker.go | head -220\r\n\u001b[?2004l\r"]
