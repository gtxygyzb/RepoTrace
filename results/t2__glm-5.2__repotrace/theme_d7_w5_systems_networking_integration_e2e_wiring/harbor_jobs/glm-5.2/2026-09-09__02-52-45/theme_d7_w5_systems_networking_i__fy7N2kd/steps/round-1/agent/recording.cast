[2858.858861, "o", "   308\t\tep.State = Draining\r\n   309\t\tep.consecSuccess = 0\r\n   310\t\tep.consecFailures = 0\r\n   311\t\tep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\r\n   312\t\tif markRemoved {\r\n   313\t\t\tep.removed = true\r\n   314\t\t}\r\n   315\t\tif len(ep.connections) > 0 {\r\n   316\t\t\tgo func(deadline time.Time, conns map[int64]net.Conn) {\r\n   317\t\t\t\ttime.Sleep(time.Until(deadline))\r\n   318\t\t\t\tep.closeConnectionsLocked()\r\n   319\t\t\t}(ep.drainDeadline, ep.connections)\r\n   320\t\t}\r\n"]
[2858.858952, "o", "   321\t}\r\n   322\t\r\n   323\tfunc (ep *EndpointState) AddConnection(conn net.Conn) int64 {\r\n   324\t\tep.mu.Lock()\r\n   325\t\tdefer ep.mu.Unlock()\r\n   326\t\tid := atomic.AddInt64(&ep.connIDCounter, 1)\r\n   327\t\tep.connections[id] = conn\r\n   328\t\tep.ActiveConnections++\r\n   329\t\treturn id\r\n   330\t}\r\n   331\t\r\n   332\tfunc (ep *EndpointState) RemoveConnection(id int64) {\r\n   333\t\tep.mu.Lock()\r\n   334\t\tdefer ep.mu.Unlock()\r\n   335\t\tif _, ok := ep.connections[id]; ok {\r\n   336\t\t\tdelete(ep.connections, id)\r\n   337\t\t\tif ep.ActiveConnections > 0 {\r\n   338\t\t\t\tep.ActiveConnections--\r\n   339\t\t\t}\r\n   340\t\t}\r\n   341\t}\r\n   342\t\r\n   343\tfunc (ep *EndpointState) closeConnectionsLocked() {\r\n   344\t\tfor id, c := range ep.connections {\r\n   345\t\t\tc.Close()\r\n   346\t\t\tdelete(ep.connections, id)\r\n   347\t\t}\r\n   348\t}\r\n   349\t\r\n   350\tfunc (ep *EndpointState) Active() int {\r\n   351\t\tep.mu.Lock()\r\n   352\t\tdefer ep.mu.Unlock()\r\n   353\t\treturn ep.ActiveConnections\r\n   354\t}\r\n   355\t\r\n   356\tfunc (ep *EndpointState) IsEligible(maxConns int) bool {\r"]
