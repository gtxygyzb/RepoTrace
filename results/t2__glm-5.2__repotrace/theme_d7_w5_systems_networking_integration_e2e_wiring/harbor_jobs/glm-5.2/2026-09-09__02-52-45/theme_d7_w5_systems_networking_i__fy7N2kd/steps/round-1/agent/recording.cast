[7897.828057, "o", "\u001b[?2004hroot@n30009:/app# "]
[7943.219481, "i", "cat > internal/accesslog/logger.go <<'EOF'\npackage accesslog\n\nimport (\n    \"encoding/json\"\n    \"os\"\n    \"path/filepath\"\n    \"sync\"\n    \"sync/atomic\"\n    \"time\"\n)\n\n// Entry is one structured access log record.\ntype Entry struct {\n    Ts         string `json:\"ts\"`\n    Service    string `json:\"service\"`\n    Client     string `json:\"client\"`\n    Endpoint   string `json:\"endpoint\"`\n    BytesIn    int64  `json:\"bytes_in\"`\n    BytesOut   int64  `json:\"bytes_out\"`\n    DurationMs int64  `json:\"duration_ms\"`\n    Result     string `json:\"result\"`\n}\n\n// DefaultPath is the access log path required by meshrouter.\nconst DefaultPath = \"/app/logs/access.log\"\n\nconst maxFileSize = 1 << 20 // 1 MB\n\n// Logger writes access log entries asynchronously to a JSON-lines file.\ntype Logger struct {\n    path     string\n    ch       chan Entry\n    stop     chan struct{}\n    done     chan struct{}\n    stopped  int32\n    stopOnce sync.Once\n    mu       sync.Mutex\n    file     *os.File\n    size     int64\n}\n\n// New creates a Logger for path a"]
[7943.219808, "i", "nd starts its writer goroutine.\nfunc New(path string) *Logger {\n    if path == \"\" {\n        path = DefaultPath\n    }\n    l := &Logger{\n        path: path,\n        ch:   make(chan Entry, 8192),\n        stop: make(chan struct{}),\n        done: make(chan struct{}),\n    }\n    go l.run()\n    return l\n}\n\n// Path returns the configured log file path.\nfunc (l *Logger) Path() string {\n    return l.path\n}\n\n// Log queues an entry for asynchronous writing. If the buffered channel is full,\n// the entry is written synchronously to avoid losing it.\nfunc (l *Logger) Log(entry Entry) {\n    if atomic.LoadInt32(&l.stopped) != 0 {\n        return\n    }\n    entry.Ts = time.Now().UTC().Format(time.RFC3339Nano)\n    select {\n    case l.ch <- entry:\n    default:\n        l.writeLine(entry)\n    }\n}\n\n// Stop flushes all buffered entries and closes the log file.\nfunc (l *Logger) Stop() {\n    l.stopOnce.Do(func() {\n        atomic.StoreInt32(&l.stopped, 1)\n        close(l.stop)\n        <-l.done\n        l.mu.Lock()\n        if l.file != nil {"]
[7943.219942, "o", "cat > internal/accesslog/logger.go <<'EOF'\r\n\u001b[?2004l\r"]
[7943.220068, "i", "\n            l.file.Close()\n            l.file = nil\n        }\n        l.mu.Unlock()\n    })\n}\n\nfunc (l *Logger) run() {\n    for {\n        select {\n        case e := <-l.ch:\n            l.writeLine(e)\n        case <-l.stop:\n            l.drain()\n            close(l.done)\n            return\n        }\n    }\n}\n\nfunc (l *Logger) drain() {\n    for {\n        select {\n        case e := <-l.ch:\n            l.writeLine(e)\n        default:\n            return\n        }\n    }\n}\nEOF\n"]
