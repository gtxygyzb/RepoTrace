[4882.078482, "o", "\t\tBytesIn:             bytesIn,\r\n   144\t\t\tBytesOut:            bytesOut,\r\n   145\t\t\tAvgLatencyMs:        avg,\r\n   146\t\t\tErrors:              errors,\r\n   147\t\t\tRejectedConnections: rejected,\r\n   148\t\t\tRateLimited:         c.rateLimited,\r\n   149\t\t\tQueued:              c.queued,\r\n   150\t\t\tQueueTimeouts:       c.queueTimeouts,\r\n   151\t\t\tRetries:             c.retries,\r\n   152\t\t\tRetrySuccesses:      c.retrySuccesses,\r\n   153\t\t}\r\n   154\t}\r\n   155\t\r\n   156\t// Snapshot is a JSON-friendly stats view.\r\n   157\ttype Snapshot struct {\r\n"]
[4882.078552, "o", "   158\t\tTotalConnections    int     `json:\"total_connections\"`\r\n   159\t\tActiveConnections   int     `json:\"active_connections\"`\r\n   160\t\tBytesIn             int64   `json:\"bytes_in\"`\r\n   161\t\tBytesOut            int64   `json:\"bytes_out\"`\r\n   162\t\tAvgLatencyMs        float64 `json:\"avg_latency_ms\"`\r\n   163\t\tErrors              int     `json:\"errors\"`\r\n   164\t\tRejectedConnections int     `json:\"rejected_connections\"`\r\n   165\t\tRateLimited         int     `json:\"rate_limited\"`\r\n   166\t\tQueued              int     `json:\"queued\"`\r\n   167\t\t"]
