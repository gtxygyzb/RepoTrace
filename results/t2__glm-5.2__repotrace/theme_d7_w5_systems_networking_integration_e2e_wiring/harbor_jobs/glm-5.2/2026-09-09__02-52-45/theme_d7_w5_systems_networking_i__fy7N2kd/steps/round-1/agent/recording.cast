[11185.187845, "o", "sed -n '120,190p' internal/stats/stats.go\r\n\u001b[?2004l\r"]
[11185.19103, "o", "\t}\r\n\tif j > 0 {\r\n\t\tc.rejections = c.rejections[j:]\r\n\t}\r\n}\r\n\r\n// Snapshot returns current windowed stats. active is supplied by the state manager.\r\n"]
[11185.191152, "o", "func (c *Collector) Snapshot(active int) Snapshot {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tcutoff := now.Add(-c.window)\r\n\tvar total int\r\n\tvar bytesIn, bytesOut int64\r\n\tvar latencySum time.Duration\r\n\tvar errors int\r\n\tfor _, e := range c.entries {\r\n\t\tif e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {\r\n\t\t\ttotal++\r\n\t\t\tbytesIn += e.bytesIn\r\n\t\t\tbytesOut += e.bytesOut\r\n\t\t\tlatencySum += e.latency\r\n\t\t\tif e.err {\r\n\t\t\t\terrors++\r\n\t\t\t}\r\n\t\t}\r\n"]
[11185.19123, "o", "\t}\r\n\trejected := 0\r\n\tfor _, t := range c.rejections {\r\n\t\tif t.After(cutoff) || t.Equal(cutoff) {\r\n\t\t\trejected++\r\n\t\t}\r\n\t}\r\n\tvar avg float64\r\n\tif total > 0 {\r\n\t\tavg = float64(latencySum.Milliseconds()) / float64(total)\r\n\t}\r\n"]
[11185.191322, "o", "\treturn Snapshot{\r\n\t\tTotalConnections:    total,\r\n\t\tActiveConnections:   active,\r\n\t\tBytesIn:             bytesIn,\r\n\t\tBytesOut:            bytesOut,\r\n\t\tAvgLatencyMs:        avg,\r\n\t\tErrors:              errors,\r\n\t\tRejectedConnections: rejected,\r\n\t\tRateLimited:         c.rateLimited,\r\n\t\tQueued:              c.queued,\r\n\t\tQueueTimeouts:       c.queueTimeouts,\r\n\t\tRetries:             c.retries,\r\n\t\tRetrySuccesses:      c.retrySuccesses,\r\n"]
[11185.191421, "o", "\t\tIdleTimeouts:        c.idleTimeouts,\r\n\t}\r\n}\r\n\r\n// Snapshot is a JSON-friendly stats view.\r\ntype Snapshot struct {\r\n\tTotalConnections    int     `json:\"total_connections\"`\r\n\tActiveConnections   int     `json:\"active_connections\"`\r\n\tBytesIn             int64   `json:\"bytes_in\"`\r\n\tBytesOut            int64   `json:\"bytes_out\"`\r\n\tAvgLatencyMs        float64 `json:\"avg_latency_ms\"`\r\n\tErrors              int     `json:\"errors\"`\r\n\tRejectedConnections int     `json:\"rejected_connections\"`\r\n\tRateLimited         int     `json:\"rate_limited\"`\r\n"]
[11185.19152, "o", "\tQueued              int     `json:\"queued\"`\r\n\tQueueTimeouts       int     `json:\"queue_timeouts\"`\r\n\tRetries             int     `json:\"retries\"`\r\n\tRetrySuccesses      int     `json:\"retry_successes\"`\r\n\tIdleTimeouts        int     `json:\"idle_timeouts\"`\r\n}\r\n"]
[11185.192004, "o", "\u001b[?2004h"]
[11185.192063, "o", "root@n30009:/app# "]
[11185.47012, "i", "sed -n '1,140p' internal/config/config.go\n"]
[11185.47052, "o", "sed -n '1,140p' internal/config/config.go\r\n\u001b[?2004l\r"]
[11185.473632, "o", "package config\r\n\r\nimport (\r\n\t\"github.com/BurntSushi/toml\"\r\n)\r\n"]
[11185.473844, "o", "\r\n// Global holds mesh-wide tuning parameters.\r\ntype Global struct {\r\n\tHealthIntervalMs        int `toml:\"health_interval_ms\"`\r\n\tUnhealthyThreshold      int `toml:\"unhealthy_threshold\"`\r\n\tHealthyThreshold        int `toml:\"healthy_threshold\"`\r\n\tStatsWindowSec          int `toml:\"stats_window_sec\"`\r\n\tCircuitBreakerThreshold int `toml:\"circuit_breaker_threshold\"`\r\n\tCircuitBreakerTimeoutMs int `toml:\"circuit_breaker_timeout_ms\"`\r\n}\r\n\r\n// Endpoint describes one backend endpoint from config.\r\ntype Endpoint struct {\r\n\tAddress          string `toml:\"address\"`\r\n\tWeight           int    `toml:\"weight\"`\r\n\tWarmupDurationMs int    `toml:\"warmup_duration_ms\"`\r\n\tHealthCheck      string `toml:\"health_check\"`\r\n\tHealthPath       string `toml:\"health_path\"`\r\n\tHealthCmd        string `toml:\"health_cmd\"`\r\n}\r\n\r\n// Service describes one routed service from config.\r\ntype Service struct {\r\n\tName                      string     `toml:\"name\"`\r\n\tListenPort                int        `toml:\"listen_port\"`\r\n\tRoutingMode               strin"]
[11185.473959, "o", "g     `toml:\"routing_mode\"`\r\n\tDrainTimeoutMs            int        `toml:\"drain_timeout_ms\"`\r\n\tMaxConnectionsPerEndpoint int        `toml:\"max_connections_per_endpoint\"`\r\n\tConnectionLimitMode       string     `toml:\"connection_limit_mode\"`\r\n\tRateLimitRps              int        `toml:\"rate_limit_rps\"`\r\n\tRateLimitBurst            int        `toml:\"rate_limit_burst\"`\r\n\tRateLimitQueueDepth       int        `toml:\"rate_limit_queue_depth\"`\r\n\tRateLimitQueueTimeoutMs   int        `toml:\"rate_limit_queue_timeout_ms\"`\r\n\tMaxRetries                int        `toml:\"max_retries\"`\r\n\tRetryDelayMs              int        `toml:\"retry_delay_ms\"`\r\n\tRetryBackoffMultiplier    float64    `toml:\"retry_backoff_multiplier\"`\r\n\tRetryMaxDelayMs           int        `toml:\"retry_max_delay_ms\"`\r\n\tIdleTimeoutMs             int        `toml:\"idle_timeout_ms\"`\r\n\tEndpoints                 []Endpoint `toml:\"endpoint\"`\r\n}\r\n\r\n// Config is the parsed application configuration.\r\ntype Config struct {\r\n\tGlobal   Global\r\n\tServices []Service `toml:\""]
[11185.474031, "o", "service\"`\r\n}\r\n\r\n// Load reads and normalizes a TOML config file.\r\nfunc Load(path string) (*Config, error) {\r\n\tvar cfg Config\r\n\tif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif cfg.Global.HealthIntervalMs <= 0 {\r\n\t\tcfg.Global.HealthIntervalMs = 2000\r\n\t}\r\n\tif cfg.Global.UnhealthyThreshold <= 0 {\r\n\t\tcfg.Global.UnhealthyThreshold = 3\r\n\t}\r\n\tif cfg.Global.HealthyThreshold <= 0 {\r\n\t\tcfg.Global.HealthyThreshold = 2\r\n\t}\r\n\tif cfg.Global.StatsWindowSec <= 0 {\r\n\t\tcfg.Global.StatsWindowSec = 60\r\n\t}\r\n\tif cfg.Global.CircuitBreakerThreshold <= 0 {\r\n\t\tcfg.Global.CircuitBreakerThreshold = 3\r\n\t}\r\n\tif cfg.Global.CircuitBreakerTimeoutMs <= 0 {\r\n\t\tcfg.Global.CircuitBreakerTimeoutMs = 5000\r\n\t"]
[11185.474095, "o", "}\r\n\tfor i := range cfg.Services {\r\n\t\ts := &cfg.Services[i]\r\n\t\tif s.RoutingMode == \"\" {\r\n\t\t\ts.RoutingMode = \"weighted-round-robin\"\r\n\t\t}\r\n\t\tif s.DrainTimeoutMs <= 0 {\r\n\t\t\ts.DrainTimeoutMs = 5000\r\n\t\t}\r\n"]
[11185.474168, "o", "\t\tif s.MaxConnectionsPerEndpoint <= 0 {\r\n\t\t\ts.MaxConnectionsPerEndpoint = 100\r\n\t\t}\r\n\t\tif s.ConnectionLimitMode == \"\" {\r\n\t\t\ts.ConnectionLimitMode = \"per-endpoint\"\r\n\t\t}\r\n\t\tif s.RateLimitBurst <= 0 {\r\n\t\t\ts.RateLimitBurst = s.RateLimitRps\r\n\t\t}\r\n\t\tif s.RateLimitQueueTimeoutMs <= 0 {\r\n\t\t\ts.RateLimitQueueTimeoutMs = 1000\r\n\t\t}\r\n"]
[11185.474249, "o", "\t\tif s.RetryDelayMs <= 0 {\r\n\t\t\ts.RetryDelayMs = 100\r\n\t\t}\r\n\t\tif s.RetryBackoffMultiplier <= 0 {\r\n\t\t\ts.RetryBackoffMultiplier = 2.0\r\n\t\t}\r\n\t\tif s.RetryMaxDelayMs <= 0 {\r\n\t\t\ts.RetryMaxDelayMs = 5000\r\n\t\t}\r\n\t\tfor j := range s.Endpoints {\r\n\t\t\tep := &s.Endpoints[j]\r\n"]
[11185.47433, "o", "\t\t\tif ep.HealthCheck == \"\" {\r\n\t\t\t\tep.HealthCheck = \"tcp\"\r\n\t\t\t}\r\n\t\t\tif ep.Weight < 0 {\r\n\t\t\t\tep.Weight = 0\r\n\t\t\t}\r\n\t\t\tif ep.WarmupDurationMs < 0 {\r\n\t\t\t\tep.WarmupDurationMs = 0\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn &cfg, nil\r\n}\r\n"]
[11185.475018, "o", "\u001b[?2004h"]
[11185.475069, "o", "root@n30009:/app# "]
[11185.742141, "i", "sed -n '255,330p' internal/state/state.go\n"]
[11185.742532, "o", "sed -n '255,330p' internal/state/state.go\r\n\u001b[?2004l\r"]
[11185.745707, "o", "\t}\r\n}\r\n\r\nfunc (s *State) GetService(name string) *ServiceState {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.services[name]\r\n}\r\n\r\n"]
[11185.745811, "o", "func (s *State) Services() []*ServiceState {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\tout := make([]*ServiceState, 0, len(s.services))\r\n\tfor _, ss := range s.services {\r\n\t\tout = append(out, ss)\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc (s *State) GetEndpoint(service, address string) *EndpointState {\r\n\tss := s.GetService(service)\r\n\tif ss == nil {\r\n\t\treturn nil\r\n\t}\r\n\tss.mu.Lock()\r\n"]
[11185.74589, "o", "\tdefer ss.mu.Unlock()\r\n\tfor _, ep := range ss.Endpoints {\r\n\t\tif ep.Address == address {\r\n\t\t\treturn ep\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc (s *State) SetWeight(service, address string, weight int) error {\r\n\tep := s.GetEndpoint(service, address)\r\n\tif ep == nil {\r\n\t\treturn errNotFound(\"endpoint not found\")\r\n\t}\r\n"]
[11185.745953, "o", "\tep.mu.Lock()\r\n\tdefer ep.mu.Unlock()\r\n\tif weight < 0 {\r\n\t\tweight = 0\r\n\t}\r\n\tep.Weight = weight\r\n\treturn nil\r\n}\r\n\r\nfunc (s *State) DrainEndpoint(service, address string) error {\r\n\tss := s.GetService(service)\r\n\t"]
[11185.746014, "o", "if ss == nil {\r\n\t\treturn errNotFound(\"service not found\")\r\n\t}\r\n\tep := s.GetEndpoint(service, address)\r\n\tif ep == nil {\r\n\t\treturn errNotFound(\"endpoint not found\")\r\n\t}\r\n\tep.StartDraining(ss.DrainTimeoutMs, false)\r\n\treturn nil\r\n}\r\n"]
[11185.746075, "o", "\r\nfunc (s *State) ResetCircuitBreaker(service, address string) error {\r\n\tep := s.GetEndpoint(service, address)\r\n\tif ep == nil {\r\n\t\treturn errNotFound(\"endpoint not found\")\r\n\t}\r\n\tep.mu.Lock()\r\n\tdefer ep.mu.Unlock()\r\n\toldState := ep.State\r\n\tep.Circuit.Reset()\r\n\tif ep.State != Draining {"]
[11185.746133, "o", "\r\n\t\tep.State = Healthy\r\n\t}\r\n\tif oldState == Unknown || oldState == Unhealthy {\r\n\t\tep.startWarmupLocked()\r\n\t}\r\n"]
[11185.746745, "o", "\u001b[?2004h"]
