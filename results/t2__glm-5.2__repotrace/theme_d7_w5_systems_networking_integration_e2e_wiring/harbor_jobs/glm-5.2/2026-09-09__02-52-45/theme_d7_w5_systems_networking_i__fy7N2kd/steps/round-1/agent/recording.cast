[12118.907733, "o", "\tfor _, ep := range ss.Endpoints {\r\n\t\tep.mu.Lock()\r\n\t\tout.Endpoints = append(out.Endpoints, WarmupEndpointView{\r\n\t\t\tEndpoint:          ep.Address,\r\n\t\t\tWarmingUp:         ep.WarmupDurationMs > 0 && time.Now().Before(ep.warmupUntil),\r\n\t\t\tWarmupRemainingMs: ep.warmupRemainingMsLocked(),\r\n\t\t\tEffectiveWeight:   ep.effectiveWeightLocked(),\r\n\t\t\tConfigWeight:      ep.Weight,\r\n\t\t})\r\n\t\tep.mu.Unlock()\r\n\t}\r\n\treturn out, true\r\n}\r\n\r\ntype StatsEndpointView struct {\r\n\tAddress string `json:\"address\"`\r\n\tstats.Snapshot\r\n}\r\n\r\ntype StatsView struct {\r\n\tService   string              `json:\"service\"`\r\n\tWindowSec int                 `json:\"window_sec\"`\r\n\tEndpoints []StatsEndpointView `json:\"endpoints\"`\r\n}\r\n\r\nfunc (s *State) StatsView(name string, windowSec int) (StatsView, bool) {\r\n\tss := s.GetService(name)\r\n"]
