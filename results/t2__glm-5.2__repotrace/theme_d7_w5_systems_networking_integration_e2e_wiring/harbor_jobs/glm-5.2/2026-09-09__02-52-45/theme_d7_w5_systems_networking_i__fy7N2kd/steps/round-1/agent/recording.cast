[4594.944915, "o", "# Update closeConnectionsLocked.\r\n\u001b[?2004l\r"]
[4594.94499, "o", "\u001b[?2004h> "]
[4594.945636, "o", "s = s.replace('''func (ep *EndpointState) closeConnectionsLocked() {\\n\\tfor id, c := range ep.connections {\\n\\t\\tc.Close()\\n\\t\\tdelete(ep.connections, id)\\n\\t}\\n}''',\r\n\u001b[?2004l\r"]
[4594.945699, "o", "\u001b[?2004h> "]
[4594.946289, "o", "'''func (ep *EndpointState) closeConnectionsLocked() {\\n\\tfor id, info := range ep.connections {\\n\\t\\tinfo.conn.Close()\\n\\t\\tdelete(ep.connections, id)\\n\\t}\\n}''')\r\n\u001b[?2004l\r"]
