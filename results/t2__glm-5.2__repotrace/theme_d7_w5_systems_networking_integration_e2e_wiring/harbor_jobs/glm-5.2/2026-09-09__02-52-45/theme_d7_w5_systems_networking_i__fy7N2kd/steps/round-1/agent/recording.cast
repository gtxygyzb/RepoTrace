[4344.252508, "o", "   323\tfunc (ep *EndpointState) AddConnection(conn net.Conn) int64 {\r\n   324\t\tep.mu.Lock()\r\n   325\t\tdefer ep.mu.Unlock()\r\n   326\t\tid := atomic.AddInt64(&ep.connIDCounter, 1)\r\n   327\t\tep.connections[id] = conn\r\n   328\t\tep.ActiveConnections++\r\n   329\t\treturn id\r\n   330\t}\r\n   331\t\r\n   332\tfunc (ep *EndpointState) RemoveConnection(id int64) {\r\n   333\t\tep.mu.Lock()\r\n   334\t\tdefer ep.mu.Unlock()\r\n   335\t\t"]
[4344.252577, "o", "if _, ok := ep.connections[id]; ok {\r\n   336\t\t\tdelete(ep.connections, id)\r\n   337\t\t\tif ep.ActiveConnections > 0 {\r\n   338\t\t\t\tep.ActiveConnections--\r\n   339\t\t\t}\r\n   340\t\t}\r\n   341\t}\r\n   342\t\r\n   343\tfunc (ep *EndpointState) closeConnectionsLocked() {\r\n"]
[4344.252633, "o", "   344\t\tfor id, c := range ep.connections {\r\n   345\t\t\tc.Close()\r\n   346\t\t\tdelete(ep.connections, id)\r\n   347\t\t}\r\n   348\t}\r\n   349\t\r\n   350\tfunc (ep *EndpointState) Active() int {\r\n"]
[4344.252696, "o", "   351\t\tep.mu.Lock()\r\n   352\t\tdefer ep.mu.Unlock()\r\n   353\t\treturn ep.ActiveConnections\r\n   354\t}\r\n   355\t\r\n   356\tfunc (ep *EndpointState) IsEligible(maxConns int) bool {\r\n   357\t\tep.mu.Lock()\r\n   358\t\tdefer ep.mu.Unlock()\r\n   359\t\treturn ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n   360\t}\r\n   361\t\r\n"]
[4344.252753, "o", "   362\tfunc (s *State) RecordHealthCheck(service, address string, success bool) HealthEvent {\r\n   363\t\tss := s.GetService(service)\r\n   364\t\tif ss == nil {\r\n   365\t\t\treturn HealthEvent{}\r\n   366\t\t}\r\n   367\t\tep := s.GetEndpoint(service, address)\r\n   368\t"]
[4344.252806, "o", "\tif ep == nil {\r\n   369\t\t\treturn HealthEvent{}\r\n   370\t\t}\r\n   371\t\tglobal := s.Global()\r\n   372\t\tep.mu.Lock()\r\n   373\t\toldState := ep.State\r\n   374\t\tresult := \"success\"\r\n   375\t"]
[4344.252866, "o", "\tif !success {\r\n   376\t\t\tresult = \"failure\"\r\n   377\t\t}\r\n   378\t\tif success {\r\n   379\t\t\tep.consecSuccess++\r\n   380\t\t\tep.consecFailures = 0\r\n   381\t\t\tif oldState == Unknown && ep.consecSuccess >= global.HealthyThreshold {\r\n   382\t\t\t\tep.State = Healthy\r\n"]
[4344.252932, "o", "   383\t\t\t} else if oldState == Unhealthy && ep.consecSuccess >= global.HealthyThreshold {\r\n   384\t\t\t\tep.State = Healthy\r\n   385\t\t\t}\r\n   386\t\t} else {\r\n   387\t\t\tep.consecFailures++\r\n   388\t\t\tep.consecSuccess = 0\r\n   389\t\t\tif (oldState == Healthy || oldState == Unknown) && ep.consecFailures >= global.UnhealthyThreshold {\r\n   390\t\t\t\tep.State = Unhealthy\r\n"]
[4344.252988, "o", "   391\t\t\t\tep.Circuit.Open()\r\n   392\t\t\t\tep.consecFailures = 0\r\n   393\t\t\t\ttimeout := time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n   394\t\t\t\tgo func(deadline time.Time) {\r\n   395\t\t\t\t\ttime.Sleep(time.Until(deadline))\r\n   396\t\t\t\t\tep.mu.Lock()\r\n   397\t\t\t\t\tep.closeConnectionsLocked()\r\n   398\t\t\t\t\tep.mu.Unlock()\r\n   399\t\t\t"]
[4344.253052, "o", "\t}(time.Now().Add(timeout))\r\n   400\t\t\t}\r\n   401\t\t}\r\n   402\t\tnewState := ep.State\r\n   403\t\tep.mu.Unlock()\r\n   404\t\tevt := HealthEvent{\r\n   405\t\t\tTimestamp:   time.Now(),\r\n   406\t\t\tEndpoint:    address,\r\n   407\t\t\tOldState:    oldState,\r\n   408\t\t"]
[4344.253116, "o", "\tNewState:    newState,\r\n   409\t\t\tCheckResult: result,\r\n   410\t\t}\r\n   411\t\ts.logMu.Lock()\r\n   412\t\ts.healthLog[service] = append(s.healthLog[service], evt)\r\n   413\t\tif len(s.healthLog[service]) > 1000 {\r\n   414\t\t\ts.healthLog[service] = s.healthLog[service][len(s.healthLog[service])-1000:]\r\n   415\t\t}\r\n   416\t\ts.logMu.Unlock()\r\n   417\t\t"]
[4344.253184, "o", "return evt\r\n   418\t}\r\n   419\t\r\n   420\tfunc (s *State) HealthLog(service string, lastN int) []HealthEvent {\r\n   421\t\ts.logMu.Lock()\r\n   422\t\tdefer s.logMu.Unlock()\r\n   423\t\tevents := s.healthLog[service]\r\n   424\t\tif lastN <= 0 || lastN > len(events) {\r\n   425\t\t\tlastN = len(events)\r\n   426\t\t}\r\n   427\t"]
[4344.253252, "o", "\tout := make([]HealthEvent, lastN)\r\n   428\t\tcopy(out, events[len(events)-lastN:])\r\n   429\t\treturn out\r\n   430\t}\r\n   431\t\r\n   432\ttype notFoundError struct {\r\n   433\t\tmsg string\r\n   434\t}\r\n   435\t\r\n   436\tfunc (e *notFoundError) Error() string {\r\n"]
