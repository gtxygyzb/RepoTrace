[12941.178776, "o", "\u001b[?2004l\r"]
[12941.181814, "o", "package router\r\n\r\nimport (\r\n\t\"io\"\r\n\t\"log\"\r\n\t\"net\"\r\n"]
[12941.181891, "o", "\t\"sync\"\r\n\t\"sync/atomic\"\r\n\t\"time\"\r\n\r\n\t\"meshrouter/internal/accesslog\"\r\n\t\"meshrouter/internal/state\"\r\n)\r\n\r\ntype serviceListener struct {\r\n\tservice  string\r\n\tport     int\r\n\tlistener net.Listener\r\n\tstop     chan struct{}\r\n\twg       sync.WaitGroup\r\n"]
[12941.181986, "o", "\tdone     chan struct{}\r\n}\r\n\r\ntype Router struct {\r\n\tstate     *state.State\r\n\taccessLog *accesslog.Logger\r\n\tmu        sync.Mutex\r\n\tlisteners map[string]*serviceListener\r\n}\r\n\r\nfunc NewRouter(s *state.State) *Router {\r\n\treturn &Router{\r\n\t\tstate:     s,\r\n\t\tlisteners: make(map[string]*serviceListener),\r\n"]
[12941.182069, "o", "\t}\r\n}\r\n\r\nfunc (r *Router) SetAccessLogger(l *accesslog.Logger) {\r\n"]
[12941.18215, "o", "\tr.accessLog = l\r\n}\r\n\r\nfunc (r *Router) Start() {\r\n\tfor _, ss := range r.state.Services() {\r\n\t\tif !ss.IsStopping() {\r\n\t\t\tr.startService(ss)\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc (r *Router) Reload() {\r\n\tservices := r.state.Services()\r\n\tseen := make(map[string]bool)\r\n\tfor _, ss := range services {\r\n\t\tseen[ss.Name] = true\r\n\t\tr.mu.Lock()\r\n\t\tsl, ok := r.listeners[ss.Name]\r\n\t\tr.mu.Unlock()\r\n\t\tif !ok {\r\n\t\t\tif !ss.IsStopping() {"]
[12941.18223, "o", "\r\n\t\t\t\tr.startService(ss)\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif sl.port != ss.ListenPort {\r\n\t\t\tr.stopService(ss.Name, true)\r\n\t\t\tr.startService(ss)\r\n\t\t}\r\n\t}\r\n\tr.mu.Lock()\r\n\tfor name := range r.listeners {"]
[12941.182288, "o", "\r\n\t\tif !seen[name] {\r\n\t\t\tr.mu.Unlock()\r\n\t\t\tr.stopService(name, true)\r\n\t\t\tr.mu.Lock()\r\n\t\t}\r\n\t}\r\n\tr.mu.Unlock()\r\n}\r\n\r\n"]
[12941.182348, "o", "func (r *Router) startService(ss *state.ServiceState) {\r\n\taddr := \":\" + intToStr(ss.ListenPort)\r\n\tln, err := net.Listen(\"tcp\", addr)\r\n\tif err != nil {\r\n\t\tlog.Printf(\"router: listen %s on %s failed: %v\", ss.Name, addr, err)\r\n\t\treturn\r\n\t}\r\n\tsl := &serviceListener{\r\n\t\tservice:  ss.Name,\r\n"]
[12941.182415, "o", "\t\tport:     ss.ListenPort,\r\n\t\tlistener: ln,\r\n\t\tstop:     make(chan struct{}),\r\n\t\tdone:     make(chan struct{}),\r\n"]
[12941.182479, "o", "\t}\r\n\tr.mu.Lock()\r\n\tr.listeners[ss.Name] = sl\r\n\tr.mu.Unlock()\r\n\tgo sl.acceptLoop(r)\r\n"]
[12941.182536, "o", "}\r\n\r\nfunc (r *Router) stopService(name string, drain bool) {\r\n\tr.mu.Lock()\r\n\tsl, ok := r.listeners[name]\r\n\tif ok {\r\n\t\tdelete(r.listeners, name)\r\n\t}\r\n\tr.mu.Unlock()\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tsl.stopAccept(drain, r)\r\n}\r\n\r\nfunc (r *Router) Stop() {\r\n\tr.mu.Lock()\r\n"]
[12941.182595, "o", "\tlisteners := r.listeners\r\n\tr.listeners = make(map[string]*serviceListener)\r\n\tr.mu.Unlock()\r\n\tvar wg sync.WaitGroup\r\n\tfor name, sl := range listeners {\r\n\t\twg.Add(1)\r\n\t\tgo func(name string, sl *serviceListener) {\r\n\t\t\tdefer wg.Done()\r\n\t\t\tsl.stopAccept(true, r)\r\n"]
[12941.182659, "o", "\t\t}(name, sl)\r\n\t}\r\n\twg.Wait()\r\n}\r\n\r\nfunc (sl *serviceListener) acceptLoop(r *Router) {\r\n\tdefer close(sl.done)\r\n"]
[12941.182725, "o", "\tfor {\r\n\t\tconn, err := sl.listener.Accept()\r\n\t\tif err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n\t\tsl.wg.Add(1)\r\n\t\tgo func(c net.Conn) {\r\n\t\t\tdefer sl.wg.Done()\r\n\t\t\tr.handleConn(sl.service, c)\r\n\t\t}(conn)\r\n\t}\r\n}\r\n\r\nfunc (sl *serviceListener) stopAccept(drain bool, r *Router) {\r\n\tselect {\r\n"]
[12941.182788, "o", "\tcase <-sl.stop:\r\n\tdefault:\r\n\t\tclose(sl.stop)\r\n\t}\r\n\tsl.listener.Close()\r\n\t<-sl.done\r\n"]
[12941.182829, "o", "\tif drain {\r\n\t\tss := r.state.GetService(sl.service)\r\n\t\ttimeout := 5 * time.Second\r\n\t\tif ss != nil {\r\n\t\t\ttimeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n\t\t\tif timeout <= 0 {\r\n\t\t\t\ttimeout = 5 * time.Second\r\n\t\t\t}\r\n\t\t}\r\n\t\tdone := make(chan struct{})\r\n"]
[12941.182907, "o", "\t\tgo func() {\r\n\t\t\tsl.wg.Wait()\r\n\t\t\tclose(done)\r\n\t\t}()\r\n\t\tselect {\r\n\t\tcase <-done:\r\n\t\tcase <-time.After(timeout):\r\n\t\t\tr.state.CloseServiceConnections(sl.service)\r\n\t\t\t<-done\r\n\t\t}\r\n\t} else {\r\n\t\tsl.wg.Wait()\r\n"]
[12941.182971, "o", "\t}\r\n}\r\n\r\nfunc (r *Router) handleConn(service string, client net.Conn) {\r\n\tstart := time.Now()\r\n\tclientAddr := \"\"\r\n\tif addr := client.RemoteAddr(); addr != nil {\r\n\t\tclientAddr = addr.String()\r\n\t}\r\n\r\n\tvar endpoint string\r\n\tvar bytesIn, bytesOut int64\r\n\tvar result string\r\n"]
[12941.18303, "o", "\tvar retryCount int\r\n\tvar queueWaitMs *int64\r\n\tvar failedDependency string\r\n\tdefer func() {\r\n\t\tif result == \"\" {\r\n\t\t\tresult = \"success\"\r\n\t\t}\r\n\t\tif r.accessLog != nil {\r\n\t\t\tr.accessLog.Log(accesslog.Entry{\r\n"]
[12941.183104, "o", "\t\t\t\tService:          service,\r\n\t\t\t\tClient:           clientAddr,\r\n\t\t\t\tEndpoint:         endpoint,\r\n\t\t\t\tBytesIn:          bytesIn,\r\n\t\t\t\tBytesOut:         bytesOut,\r\n\t\t\t\tDurationMs:       time.Since(start).Milliseconds(),\r\n\t\t\t\tResult:           result,\r\n\t\t\t\tRetried:          retryCount > 0,\r\n\t\t\t\tRetryCount:       retryCount,\r\n\t\t\t\tQueueWaitMs:      queueWaitMs,\r\n\t\t\t\tFailedDependency: failedDependency,\r\n\t\t\t})\r\n"]
[12941.183167, "o", "\t\t}\r\n\t}()\r\n\r\n\tss := r.state.GetService(service)\r\n\tif ss == nil {\r\n\t\tresult = \"rejected_no_endpoint\"\r\n"]
[12941.183226, "o", "\t\tclient.Close()\r\n\t\treturn\r\n\t}\r\n\r\n\tif failedDep, _ := r.state.CheckDependencies(service); failedDep != \"\" {\r\n\t\tresult = \"rejected_dependency\"\r\n\t\tfailedDependency = failedDep\r\n\t\tss.Stats.RecordDependencyRejection()\r\n\t\tclient.Close()\r\n\t\treturn\r\n\t}\r\n\r\n\tallowed, queued, waitMs, _ := ss.AcquireRateLimitToken()\r\n\tif !allowed {\r\n\t\tresult = \"rejected_rate_limit\"\r\n\t\tqueueWaitMs = &waitMs\r\n"]
[12941.183284, "o", "\t\tclient.Close()\r\n\t\treturn\r\n\t}\r\n\tif queued {\r\n\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n\t\t\tcand.Stats.RecordQueued()\r\n\t\t}\r\n\t}\r\n\r\n\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\r\n\tvar lastEndpoint *state.EndpointState\r\n"]
[12941.183346, "o", "\tfor attempt := 0; ; attempt++ {\r\n\t\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\r\n\t\tif err != nil {\r\n\t\t\tresult = \"rejected_no_endpoint\"\r\n\t\t\tendpoint = \"\"\r\n\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n\t\t\t\tss := r.state.GetService(service)\r\n\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n\t\t\t\t\t"]
[12941.183416, "o", "cand.Stats.RecordRejection()\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tclient.Close()\r\n\t\t\treturn\r\n\t\t}\r\n\t\tlastEndpoint = res.Endpoint\r\n\t\tep := res.Endpoint\r\n\t\tendpoint = ep.Address\r\n\r\n"]
[12941.183474, "o", "\t\tvar id int64\r\n\t\tif !res.Probe {\r\n\t\t\tvar ok bool\r\n\t\t\tid, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\r\n\t\t\tif !ok {\r\n\t\t\t\tresult = \"rejected_conn_limit\"\r\n\t\t\t\tep.Stats.RecordRejection()\r\n"]
[12941.183536, "o", "\t\t\t\tclient.Close()\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tbackend, derr := net.Dial(\"tcp\", ep.Address)\r\n\t\tif derr != nil {\r\n\t\t\tif id != 0 {\r\n\t\t\t\tep.RemoveConnection(id)\r\n\t\t\t}\r\n\t\t\tep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n\t\t\tif res.Probe {\r\n"]
[12941.183609, "o", "\t\t\t\tep.Circuit.ProbeFailure()\r\n\t\t\t} else {\r\n\t\t\t\tep.Circuit.Open()\r\n\t\t\t}\r\n\t\t\tif attempt >= maxRetries {\r\n\t\t\t\tresult = \"retry_exhausted\"\r\n\t\t\t\tclient.Close()\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tretryCount++\r\n"]
[12941.183666, "o", "\t\t\tep.Stats.RecordRetry()\r\n\t\t\tr.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tif res.Probe {\r\n\t\t\tep.Circuit.ProbeSuccess()\r\n\t\t\tvar ok bool\r\n\t\t\t"]
[12941.183734, "o", "id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\r\n\t\t\tif !ok {\r\n\t\t\t\tresult = \"rejected_conn_limit\"\r\n\t\t\t\tep.Stats.RecordRejection()\r\n\t\t\t\tbackend.Close()\r\n"]
[12941.183793, "o", "\t\t\t\tclient.Close()\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif attempt > 0 {\r\n\t\t\tep.Stats.RecordRetrySuccess()\r\n\t\t}\r\n\t\tbytesIn, bytesOut, idleClosed := forward(client, backend, ep, id, ss.IdleTimeout())\r\n\t\tbackend.Close()\r\n\t\tclient.Close()\r\n\t\tep.RemoveConnection(id)\r\n\t\tep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)\r\n"]
[12941.183856, "o", "\t\tif idleClosed {\r\n\t\t\tresult = \"idle_timeout\"\r\n\t\t\tep.Stats.RecordIdleTimeout()\r\n\t\t} else {\r\n\t\t\tresult = \"success\"\r\n\t\t}\r\n\t\treturn\r\n\t}\r\n"]
[12941.183915, "o", "}\r\n\r\nfunc (r *Router) sleepRetry(attempt, delayMs int, multiplier float64, maxDelayMs int) {\r\n\tif attempt < 0 {\r\n\t\tattempt = 0\r\n\t}\r\n\tdelay := float64(delayMs) * pow(multiplier, float64(attempt))\r\n\tif maxDelayMs > 0 && delay > float64(maxDelayMs) {\r\n\t\tdelay = float64(maxDelayMs)\r\n\t}\r\n\tif delay > 0 {\r\n"]
[12941.18397, "o", "\t\ttime.Sleep(time.Duration(delay) * time.Millisecond)\r\n\t}\r\n}\r\n\r\nfunc pow(base, exp float64) float64 {\r\n\tresult := 1.0\r\n\tfor i := 0; i < int(exp); i++ {\r\n\t\tresult *= base\r\n"]
[12941.184534, "o", "\u001b[?2004h"]
[12941.18459, "o", "root@n30009:/app# "]
[12941.472732, "i", "sed -n '1,280p' internal/accesslog/logger.go\n"]
[12941.473079, "o", "sed -n '1,280p' internal/accesslog/logger.go\r\n"]
[12941.473158, "o", "\u001b[?2004l\r"]
[12941.476032, "o", "package accesslog\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n"]
[12941.476107, "o", "\t\"path/filepath\"\r\n\t\"sync\"\r\n\t\"sync/atomic\"\r\n\t\"time\"\r\n)\r\n\r\n// Entry is one structured access log record.\r\ntype Entry struct {\r\n\tTs               string `json:\"ts\"`\r\n\tService          string `json:\"service\"`\r\n\tClient           string `json:\"client\"`\r\n\tEndpoint         string `json:\"endpoint\"`\r\n\tBytesIn          int64  `json:\"bytes_in\"`\r\n\tBytesOut         int64  `json:\"bytes_out\"`\r\n"]
[12941.476176, "o", "\tDurationMs       int64  `json:\"duration_ms\"`\r\n\tResult           string `json:\"result\"`\r\n\tRetried          bool   `json:\"retried\"`\r\n\tRetryCount       int    `json:\"retry_count\"`\r\n\tQueueWaitMs      *int64 `json:\"queue_wait_ms,omitempty\"`\r\n\tFailedDependency string `json:\"failed_dependency,omitempty\"`\r\n}\r\n\r\n// DefaultPath is the access log path required by meshrouter.\r\nconst DefaultPath = \"/app/logs/access.log\"\r\n\r\nconst maxFileSize = 1 << 20 // 1 MB\r\n\r\n"]
[12941.476238, "o", "// Logger writes access log entries asynchronously to a JSON-lines file.\r\ntype Logger struct {\r\n\tpath     string\r\n\tch       chan Entry\r\n\tstop     chan struct{}\r\n\tdone     chan struct{}\r\n\tstopped  int32\r\n\tstopOnce sync.Once\r\n\tmu       sync.Mutex\r\n\tfile     *os.File\r\n\tsize     int64\r\n"]
[12941.476301, "o", "}\r\n\r\n// New creates a Logger for path and starts its writer goroutine.\r\nfunc New(path string) *Logger {\r\n\tif path == \"\" {\r\n\t\tpath = DefaultPath\r\n\t}\r\n\tl := &Logger{\r\n\t\tpath: path,\r\n\t\tch:   make(chan Entry, 8192),\r\n\t\tstop: make(chan struct{}),\r\n\t\tdone: make(chan struct{}),\r\n\t"]
[12941.476359, "o", "}\r\n\tgo l.run()\r\n\treturn l\r\n}\r\n\r\n// Path returns the configured log file path.\r\nfunc (l *Logger) Path() string {\r\n\treturn l.path\r\n}\r\n"]
[12941.476456, "o", "\r\n// Log queues an entry for asynchronous writing. If the buffered channel is full,\r\n// the entry is written synchronously to avoid losing it.\r\nfunc (l *Logger) Log(entry Entry) {\r\n\tif atomic.LoadInt32(&l.stopped) != 0 {\r\n\t\treturn\r\n\t}\r\n\tentry.Ts = time.Now().UTC().Format(time.RFC3339Nano)\r\n\tselect {\r\n\tcase l.ch <- entry:\r\n\tdefault:\r\n\t\tl.writeLine(entry)\r\n\t}\r\n}\r\n"]
[12941.476514, "o", "\r\n// Stop flushes all buffered entries and closes the log file.\r\nfunc (l *Logger) Stop() {\r\n\tl.stopOnce.Do(func() {\r\n\t\tatomic.StoreInt32(&l.stopped, 1)\r\n\t\tclose(l.stop)\r\n\t\t<-l.done\r\n\t\tl.mu.Lock()\r\n\t\tif l.file != nil {\r\n\t\t"]
[12941.476575, "o", "\tl.file.Close()\r\n\t\t\tl.file = nil\r\n\t\t}\r\n\t\tl.mu.Unlock()\r\n\t})\r\n}\r\n\r\nfunc (l *Logger) run() {\r\n\tfor {\r\n\t\tselect {\r\n\t\tcase e := <-l.ch:\r\n\t\t"]
[12941.47663, "o", "\tl.writeLine(e)\r\n\t\tcase <-l.stop:\r\n\t\t\tl.drain()\r\n\t\t\tclose(l.done)\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n}\r\n"]
[12941.476686, "o", "\r\nfunc (l *Logger) drain() {\r\n\tfor {\r\n\t\tselect {\r\n\t\tcase e := <-l.ch:\r\n\t\t\tl.writeLine(e)\r\n\t\tdefault:\r\n\t\t\treturn\r\n\t\t}\r\n"]
[12941.476742, "o", "\t}\r\n}\r\n\r\nfunc (l *Logger) writeLine(e Entry) {\r\n\tb, err := json.Marshal(e)\r\n\tif err != nil {\r\n\t\treturn\r\n\t}\r\n\tb = append(b, '\\n')\r\n\r\n"]
[12941.476799, "o", "\tl.mu.Lock()\r\n\tdefer l.mu.Unlock()\r\n\r\n\tif l.file == nil {\r\n\t\tif err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n\t\tif err != nil {\r\n"]
[12941.476855, "o", "\t\t\treturn\r\n\t\t}\r\n\t\tl.file = f\r\n\t\tif info, err := f.Stat(); err == nil {\r\n\t\t\tl.size = info.Size()\r\n\t\t}\r\n\t}\r\n\r\n\tif l.size > 0 && l.size+int64(len(b)) > maxFileSize {\r\n\t\tl.rotateLocked()\r\n\t}\r\n\r\n"]
[12941.476915, "o", "\tn, err := l.file.Write(b)\r\n\tif err != nil {\r\n\t\tl.size = 0\r\n\t\tif l.file != nil {\r\n\t\t\tl.file.Close()\r\n\t\t\tl.file = nil\r\n\t\t}\r\n\t\treturn\r\n\t}\r\n"]
[12941.47697, "o", "\tl.size += int64(n)\r\n}\r\n\r\nfunc (l *Logger) rotateLocked() {\r\n\tif l.file != nil {\r\n\t\tl.file.Close()\r\n\t\tl.file = nil\r\n\t}\r\n"]
[12941.477027, "o", "\tos.Remove(l.path + \".1\")\r\n\tif err := os.Rename(l.path, l.path+\".1\"); err != nil {\r\n\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n\t\tif err == nil {\r\n\t\t\tl.file = f\r\n\t\t\tif info, err := f.Stat(); err == nil {\r\n\t\t\t\tl.size = info.Size()\r\n\t\t\t}\r\n\t"]
[12941.477091, "o", "\t}\r\n\t\treturn\r\n\t}\r\n\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n\tif err != nil {\r\n"]
[12941.477146, "o", "\t\tl.size = 0\r\n\t\treturn\r\n\t}\r\n\tl.file = f\r\n\tl.size = 0\r\n}\r\n"]
[12941.47763, "o", "\u001b[?2004h"]
[12941.477687, "o", "root@n30009:/app# "]
[12941.746079, "i", "sed -n '1,340p' internal/ipc/server.go\n"]
[12941.746418, "o", "sed -n '1,340p' internal/ipc/server.go\r\n"]
[12941.746495, "o", "\u001b[?2004l\r"]
[12941.749403, "o", "package ipc\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n"]
[12941.749472, "o", "\t\"errors\"\r\n\t\"fmt\"\r\n\t\"net\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\r\n\t\"meshrouter/internal/accesslog\"\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/state\"\r\n"]
[12941.749536, "o", ")\r\n\r\ntype Request struct {\r\n\tCmd  string          `json:\"cmd\"`\r\n\tArgs json.RawMessage `json:\"args\"`\r\n}\r\n\r\ntype Response struct {\r\n\tStatus string      `json:\"status\"`\r\n\tData   interface{} `json:\"data\"`\r\n}\r\n\r\ntype Server struct {\r\n"]
[12941.7496, "o", "\tstate    *state.State\r\n\tpath     string\r\n\tlistener net.Listener\r\n\twg       sync.WaitGroup\r\n\tstop     chan struct{}\r\n\tdone     chan struct{}\r\n}\r\n\r\nfunc NewServer(s *state.State, path string) *Server {\r\n\treturn &Server{\r\n\t\tstate: s,\r\n\t\tpath:  path,\r\n\t\tstop:  make(chan struct{}),\r\n"]
[12941.749659, "o", "\t\tdone:  make(chan struct{}),\r\n\t}\r\n}\r\n\r\nfunc (s *Server) Start() error {\r\n\tos.Remove(s.path)\r\n\tln, err := net.Listen(\"unix\", s.path)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n"]
[12941.74972, "o", "\ts.listener = ln\r\n\tgo s.acceptLoop()\r\n\treturn nil\r\n}\r\n\r\nfunc (s *Server) Stop() {\r\n\tselect {\r\n\tcase <-s.stop:\r\n\tdefault:\r\n\t\tclose(s.stop)\r\n\t}\r\n\tif s.listener != nil {\r\n"]
[12941.749777, "o", "\t\ts.listener.Close()\r\n\t}\r\n\t<-s.done\r\n\tos.Remove(s.path)\r\n}\r\n\r\nfunc (s *Server) acceptLoop() {\r\n\tdefer close(s.done)\r\n"]
[12941.749834, "o", "\tfor {\r\n\t\tconn, err := s.listener.Accept()\r\n\t\tif err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n\t\ts.wg.Add(1)\r\n\t\tgo s.handleConn(conn)\r\n\t}\r\n"]
[12941.749897, "o", "}\r\n\r\nfunc (s *Server) handleConn(conn net.Conn) {\r\n\tdefer s.wg.Done()\r\n\tdefer conn.Close()\r\n\treader := bufio.NewReader(conn)\r\n\tfor {\r\n\t\tline, err := reader.ReadString('\\n')\r\n\t\tif err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n"]
[12941.749954, "o", "\t\tline = strings.TrimRight(line, \"\\r\\n\")\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tresp := s.handleLine(line)\r\n\t\t_, _ = conn.Write([]byte(resp + \"\\n\"))\r\n\t}\r\n}\r\n\r\n"]
[12941.750012, "o", "func (s *Server) handleLine(line string) string {\r\n\tvar req Request\r\n\tif err := json.Unmarshal([]byte(line), &req); err != nil {\r\n\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n\t}\r\n\tdata, err := s.dispatch(req)\r\n\tif err != nil {\r\n\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n\t}\r\n\treturn encodeResp(Response{Status: \"ok\", Data: data})\r\n"]
[12941.750071, "o", "}\r\n\r\nfunc encodeResp(r Response) string {\r\n\tb, _ := json.Marshal(r)\r\n\treturn string(b)\r\n}\r\n\r\nfunc (s *Server) dispatch(req Request) (interface{}, error) {\r\n\tswitch req.Cmd {\r\n\tcase \"list_services\":\r\n\t\treturn s.state.ServicesView(), nil\r\n\tcase \"get_service\":"]
[12941.750134, "o", "\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tsv, ok := s.state.ServiceView(args.Name)\r\n\t\tif !ok {\r\n\t\t\t"]
[12941.750191, "o", "return nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn sv, nil\r\n\tcase \"get_warmup_status\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n"]
[12941.750252, "o", "\t\t}\r\n\t\tsv, ok := s.state.WarmupStatusView(args.Name)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn sv, nil\r\n\tcase \"get_stats\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n"]
[12941.750311, "o", "\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tg := s.state.Global()\r\n\t\tsv, ok := s.state.StatsView(args.Name, g.StatsWindowSec)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t"]
[12941.750368, "o", "\treturn sv, nil\r\n\tcase \"set_weight\":\r\n\t\tvar args struct {\r\n\t\t\tName    string `json:\"name\"`\r\n\t\t\tAddress string `json:\"address\"`\r\n\t\t\tWeight  int    `json:\"weight\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {"]
[12941.750433, "o", "\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tif err := s.state.SetWeight(args.Name, args.Address, args.Weight); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn \"OK\", nil\r\n\tcase \"drain_endpoint\":\r\n\t\t"]
[12941.750505, "o", "var args struct {\r\n\t\t\tName    string `json:\"name\"`\r\n\t\t\tAddress string `json:\"address\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t"]
[12941.75056, "o", "\tif err := s.state.DrainEndpoint(args.Name, args.Address); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn \"OK\", nil\r\n\tcase \"get_health_log\":\r\n\t\tvar args struct {\r\n\t\t\tName  string `json:\"name\"`\r\n\t\t\tLastN int    `json:\"last_n\"`\r\n\t\t}\r\n\t"]
[12941.750621, "o", "\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn s.state.HealthLogView(args.Name, args.LastN), nil\r\n\tcase \"get_circuit_breakers\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n"]
[12941.750679, "o", "\t\t}\r\n\t\tcv, ok := s.state.CircuitsView(args.Name)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn cv, nil\r\n\tcase \"reset_circuit_breaker\":\r\n\t\tvar args struct {\r\n"]
[12941.750735, "o", "\t\t\tName    string `json:\"name\"`\r\n\t\t\tAddress string `json:\"address\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tif err := s.state.ResetCircuitBreaker(args.Name, args.Address); err != nil {\r\n\t"]
[12941.750791, "o", "\t\treturn nil, err\r\n\t\t}\r\n\t\treturn \"OK\", nil\r\n\tcase \"resolve\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n"]
[12941.750846, "o", "\t\t}\r\n\t\taddr, err := s.state.ResolveEndpoint(args.Name)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn addr, nil\r\n\tcase \"reload_config\":\r\n\t\tpath := s.state.ConfigPath()\r\n"]
[12941.750908, "o", "\t\tcfg, err := config.Load(path)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\ts.state.ApplyConfig(cfg)\r\n\t\treturn \"OK\", nil\r\n\tcase \"get_rate_limit_status\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\t"]
[12941.750964, "o", "if err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\ttokens, queueDepth, rateLimited, queued, timeouts, rps, burst, ok := s.state.RateLimitStatus(args.Name)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn map[string]interface{}{\r\n"]
[12941.751021, "o", "\t\t\t\"tokens_available\": tokens,\r\n\t\t\t\"queue_depth\":      queueDepth,\r\n\t\t\t\"rate_limited\":     int(rateLimited),\r\n\t\t\t\"queued\":           int(queued),\r\n\t\t\t\"queue_timeouts\":   int(timeouts),\r\n\t\t\t\"rps\":              rps,\r\n\t\t\t\"burst\":            burst,\r\n\t\t}, nil\r\n"]
[12941.751076, "o", "\tcase \"get_connections\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n"]
[12941.751132, "o", "\t\tconns, ok := s.state.ConnectionsView(args.Name)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn map[string]interface{}{\"connections\": conns}, nil\r\n\tcase \"set_rate_limit\":\r\n\t\tvar args struct {\r\n\t\t\tName  string `json:\"name\"`\r\n"]
[12941.751194, "o", "\t\t\tRps   int    `json:\"rps\"`\r\n\t\t\tBurst int    `json:\"burst\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tif err := s.state.SetRateLimit(args.Name, args.Rps, args.Burst); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn \"OK\", nil\r\n\t"]
[12941.751251, "o", "case \"get_access_log\":\r\n\t\tvar args struct {\r\n\t\t\tService       string `json:\"service\"`\r\n\t\t\tLastN         *int   `json:\"last_n\"`\r\n\t\t\tResult        string `json:\"result\"`\r\n\t\t\tMinDurationMs int64  `json:\"min_duration_ms\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n"]
[12941.751311, "o", "\t\t\treturn nil, err\r\n\t\t}\r\n\t\tlastN := 20\r\n\t\tif args.LastN != nil {\r\n\t\t\tlastN = *args.LastN\r\n\t\t}\r\n\t\tentries := accesslog.GetAccessLog(accesslog.DefaultPath, args.Service, args.Result, lastN, args.MinDurationMs)\r\n\t\tif entries == nil {\r\n"]
[12941.751366, "o", "\t\t\tentries = []accesslog.Entry{}\r\n\t\t}\r\n\t\treturn entries, nil\r\n\tcase \"get_access_stats\":\r\n\t\tvar args struct {\r\n\t\t\tService string `json:\"service\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n"]
[12941.751434, "o", "\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn accesslog.Stats(accesslog.DefaultPath, args.Service), nil\r\n\tcase \"get_dependencies\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n"]
[12941.751499, "o", "\t\tdeps := s.state.DependencyStatuses(args.Name)\r\n\t\tif deps == nil {\r\n\t\t\tdeps = []state.DependencyStatus{}\r\n\t\t}\r\n\t\treturn map[string]interface{}{\r\n\t"]
[12941.751556, "o", "\t\t\"service\":      args.Name,\r\n\t\t\t\"dependencies\": deps,\r\n\t\t}, nil\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"unknown command: %s\", req.Cmd)\r\n\t}\r\n}\r\n\r\nfunc init() {\r\n\t_ = strconv.Itoa(0)\r\n}\r\n"]
[12941.752033, "o", "\u001b[?2004h"]
