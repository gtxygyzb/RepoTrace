[11530.123667, "o", "\u001b[?2004h> "]
[11530.123925, "o", "                        Service string `json:\"service\"`\r\n\u001b[?2004l\r"]
[11530.123985, "o", "\u001b[?2004h> "]
[11530.124065, "o", "                }\r\n\u001b[?2004l\r"]
[11530.124121, "o", "\u001b[?2004h> "]
[11530.124408, "o", "                if err := json.Unmarshal(req.Args, &args); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.124574, "o", "                        return nil, err\r\n\u001b[?2004l\r\u001b[?2004h"]
