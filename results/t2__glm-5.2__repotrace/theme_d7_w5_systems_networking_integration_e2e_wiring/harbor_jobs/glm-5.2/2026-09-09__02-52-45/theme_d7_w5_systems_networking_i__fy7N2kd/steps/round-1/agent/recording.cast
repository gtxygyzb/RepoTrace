[11530.104188, "o", "\u001b[?2004h> "]
[11530.104485, "o", "                if s.DependsOn == nil {\r\n\u001b[?2004l\r"]
[11530.104547, "o", "\u001b[?2004h> "]
[11530.104873, "o", "                        s.DependsOn = []string{}\r\n\u001b[?2004l\r"]
[11530.104931, "o", "\u001b[?2004h> "]
[11530.10506, "o", "                }\r\n\u001b[?2004l\r"]
[11530.105126, "o", "\u001b[?2004h> "]
[11530.105197, "o", "        }\r\n\u001b[?2004l\r"]
[11530.105252, "o", "\u001b[?2004h> "]
