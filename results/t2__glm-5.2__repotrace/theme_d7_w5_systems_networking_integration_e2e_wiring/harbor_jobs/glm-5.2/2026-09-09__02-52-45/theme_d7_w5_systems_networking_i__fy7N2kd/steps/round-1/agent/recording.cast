[7897.521453, "o", "// Logger writes access log entries asynchronously to a JSON-lines file.\r\n\u001b[?2004l\r"]
[7897.521511, "o", "\u001b[?2004h> "]
[7897.521952, "o", "// It uses a buffered channel so connection handling does not block unless the\r\n\u001b[?2004l\r"]
[7897.522002, "o", "\u001b[?2004h> "]
[7897.52247, "o", "// channel is full. When the channel is full, entries are written synchronously\r\n\u001b[?2004l\r"]
