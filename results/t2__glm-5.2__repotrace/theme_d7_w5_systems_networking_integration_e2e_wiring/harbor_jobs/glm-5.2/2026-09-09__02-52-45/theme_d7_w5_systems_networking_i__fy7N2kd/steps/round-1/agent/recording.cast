[8532.971261, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\n# Fix accesslog/query.go remaining Stats type references.\np = Path(\"internal/accesslog/query.go\")\ns = p.read_text()\ns = s.replace(\"type Stats struct {\", \"type ResultStats struct {\")\ns = re.sub(r\"map\\[string\\]Stats\\b\", \"map[string]ResultStats\", s)\ns = re.sub(r\"=\\s*Stats\\{\", \"= ResultStats{\", s)\np.write_text(s)\n\n# Fix CLI access-log argument parsing.\np = Path(\"cmd/meshctl/main.go\")\ns = p.read_text()\nstart = s.index('\\tcase \"access-log\":')\nend = s.index('\\tcase \"access-stats\":', start)\nnew_block = '''\\tcase \"access-log\":\n\\t\\tipcCmd = \"get_access_log\"\n\\t\\tlast := 20\n\\t\\trest := os.Args[2:]\n\\t\\tfor i := 0; i < len(rest); i++ {\n\\t\\t\\ta := rest[i]\n\\t\\t\\tif a == \"--last\" {\n\\t\\t\\t\\tif i+1 < len(rest) {\n\\t\\t\\t\\t\\tif v, err := strconv.Atoi(rest[i+1]); err == nil {\n\\t\\t\\t\\t\\t\\tlast = v\n\\t\\t\\t\\t\\t}\n\\t\\t\\t\\t\\ti++\n\\t\\t\\t\\t}\n\\t\\t\\t} else if strings.HasPrefix(a, \"--last=\") {\n\\t\\t\\t\\tif v, err := strconv.Atoi(a[len(\"--last=\"):]); err == nil {\n\\t\\t\\t\\t\\tlast = v\n\\t\\t\\t\\t}\n\\t\\"]
