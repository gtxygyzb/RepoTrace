[5946.993488, "o", "\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, ep := range ss.\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks {\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tsv.\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks = append(sv.\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks, Stats\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[KView{\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tSnapshot: ep.Stats.Snapshot(ep.\u001b[01;31m\u001b[KActiveConnections\u001b[m\u001b[K),\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype \u001b[m\u001b[KHealthEventView struct {\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[K    string    `json:\"endpoint\"`\r\n"]
