[8636.13412, "o", "    10\t\r\n    11\t\t\"meshrouter/internal/accesslog\"\r\n    12\t\t\"meshrouter/internal/state\"\r\n    13\t)\r\n    14\t\r\n    15\ttype serviceListener struct {\r\n    16\t\tservice  string\r\n"]
[8636.134225, "o", "    17\t\tport     int\r\n    18\t\tlistener net.Listener\r\n    19\t\tstop     chan struct{}\r\n    20\t\twg       sync.WaitGroup\r\n    21\t\tdone     chan struct{}\r\n    22\t}\r\n    23\t\r\n    24\ttype Router struct {\r\n    25\t\tstate     *state.State\r\n    26\t\tmu        sync.Mutex\r\n    27\t\tlisteners map[string]*serviceListener\r\n    28\t}\r\n    29\t\r\n    30\tfunc NewRouter(s *state.State) *Router {\r\n    31\t\treturn &Router{\r\n    32\t\t\tstate:     s,\r\n    33\t\t\tlisteners: make(map[string]*serviceListener),\r\n    34\t\t}\r\n    35\t}\r\n    36\t\r\n    37\tfunc (r *Router) Start() {\r\n    38\t\tfor _, ss := range r.state.Services() {\r\n    39\t\t\tif !ss.IsStopping() {\r\n    40\t\t\t\tr.startService(ss)\r\n    41\t\t\t}\r\n    42\t\t}\r\n    43\t}\r\n    44\t\r\n    45\tfunc (r *Router) Reload() {\r\n    46\t\tservices := r.state.Services()\r\n    47\t\tseen := make(map[string]bool)\r\n    48\t\tfor _, ss := range services {\r\n"]
[8636.134334, "o", "    49\t\t\tseen[ss.Name] = true\r\n    50\t\t\tr.mu.Lock()\r\n    51\t\t\tsl, ok := r.listeners[ss.Name]\r\n    52\t\t\tr.mu.Unlock()\r\n    53\t\t\tif !ok {\r\n    54\t\t\t\tif !ss.IsStopping() {\r\n    55\t\t\t\t\tr.startService(ss)\r\n"]
