[11820.624649, "o", "\u001b[?2004h> "]
[11820.624794, "o", "                        Service      string `json:\"service\"`\r\n\u001b[?2004l\r"]
[11820.624849, "o", "\u001b[?2004h> "]
[11820.624963, "o", "                        Dependencies []struct {\r\n\u001b[?2004l\r"]
[11820.625029, "o", "\u001b[?2004h> "]
[11820.625184, "o", "                                Name             string `json:\"name\"`\r\n\u001b[?2004l\r"]
[11820.625242, "o", "\u001b[?2004h> "]
[11820.62543, "o", "                                Available         bool   `json:\"available\"`\r\n\u001b[?2004l\r"]
[11820.62549, "o", "\u001b[?2004h> "]
[11820.625692, "o", "                                HealthyEndpoints int    `json:\"healthy_endpoints\"`\r\n\u001b[?2004l\r"]
[11820.625746, "o", "\u001b[?2004h> "]
[11820.62586, "o", "                        } `json:\"dependencies\"`\r\n\u001b[?2004l\r"]
[11820.625915, "o", "\u001b[?2004h> "]
[11820.625973, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.62617, "o", "                if err := json.Unmarshal(depRaw, &resp); err != nil {\r\n\u001b[?2004l\r"]
[11820.626224, "o", "\u001b[?2004h> "]
[11820.62631, "o", "                        return \"\", err\r\n\u001b[?2004l\r"]
