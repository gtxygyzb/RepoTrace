[9511.35226, "o", "    47\t\t}\r\n    48\t}\r\n    49\t\r\n    50\tfunc (r *Router) Reload() {\r\n    51\t\tservices := r.state.Services()\r\n    52\t\tseen := make(map[string]bool)\r\n    53\t\tfor _, ss := range services {\r\n    54\t\t\tseen[ss.Name] = true\r\n    55\t\t\tr.mu.Lock()\r\n    56\t\t\tsl, ok := r.listeners[ss.Name]\r\n    57\t\t\tr.mu.Unlock()\r\n    58\t\t\tif !ok {\r\n    59\t\t\t\tif !ss.IsStopping() {\r\n    60\t\t\t\t\tr.startService(ss)\r\n    61\t\t\t\t}\r\n    62\t\t\t\tcontinue\r\n    63\t\t\t}\r\n    64\t\t\tif sl.port != ss.ListenPort {\r\n    65\t\t\t\tr.stopService(ss.Name, true)\r\n    66\t\t\t\tr.startService(ss)\r\n    67\t\t\t}\r\n    68\t\t}\r\n    69\t\tr.mu.Lock()\r\n    70\t\tfor name := range r.listeners {\r\n    71\t\t\tif !seen[name] {\r\n    72\t\t\t\tr.mu.Unlock()\r\n"]
[9511.352332, "o", "    73\t\t\t\tr.stopService(name, true)\r\n    74\t\t\t\tr.mu.Lock()\r\n    75\t\t\t}\r\n    76\t\t}\r\n    77\t\tr.mu.Unlock()\r\n    78\t}\r\n    79\t\r\n    80\tfunc (r *Router) startService(ss *state.ServiceState) {\r\n    81\t\taddr := \":\" + intToStr(ss.ListenPort)\r\n    82\t\tln, err := net.Listen(\"tcp\", addr)\r\n    83\t\tif err != nil {\r\n    84\t\t"]
[9511.352418, "o", "\tlog.Printf(\"router: listen %s on %s failed: %v\", ss.Name, addr, err)\r\n    85\t\t\treturn\r\n    86\t\t}\r\n"]
[9511.352491, "o", "    87\t\tsl := &serviceListener{\r\n    88\t\t\tservice:  ss.Name,\r\n    89\t\t\tport:     ss.ListenPort,\r\n    90\t\t\tlistener: ln,\r\n    91\t\t\tstop:     make(chan struct{}),\r\n    92\t\t\tdone:     make(chan struct{}),\r\n    93\t\t}\r\n    94\t\tr.mu.Lock()\r\n    95\t\tr.listeners[ss.Name] = sl\r\n    96\t\tr.mu.Unlock()\r\n    97\t\tgo sl.acceptLoop(r)\r\n    98\t}\r\n    99\t\r\n   100\tfunc (r *Router) stopService(name string, drain bool) {\r\n   101\t\tr.mu.Lock()\r\n   102\t\tsl, ok := r.listeners[name]\r\n   103\t\tif ok {\r\n   104\t\t\tdelete(r.listeners, name)\r\n   105\t\t}\r\n   106\t\tr.mu.Unlock()\r\n   107\t\tif !ok {\r\n   108\t\t\treturn\r\n"]
[9511.352561, "o", "   109\t\t}\r\n   110\t\tsl.stopAccept(drain, r)\r\n   111\t}\r\n   112\t\r\n   113\tfunc (r *Router) Stop() {\r\n   114\t\tr.mu.Lock()\r\n   115\t\tlisteners := r.listeners\r\n   116\t\tr.listeners = make(map[string]*serviceListener)\r\n   117\t\tr.mu.Unlock()\r\n   118\t\tvar wg sync.WaitGroup\r\n   119\t\tfor name, sl := range listeners {\r\n   120\t\t\twg.Add(1)\r\n"]
[9511.352589, "o", "   121\t\t\tgo func(name string, sl *serviceListener) {\r\n   122\t\t\t\tdefer wg.Done()\r\n   123\t\t\t\tsl.stopAccept(true, r)\r\n   124\t\t\t}(name, sl)\r\n   125\t\t}\r\n"]
[9511.352672, "o", "   126\t\twg.Wait()\r\n   127\t}\r\n   128\t\r\n   129\tfunc (sl *serviceListener) acceptLoop(r *Router) {\r\n   130\t\tdefer close(sl.done)\r\n   131\t\tfor {\r\n   132\t\t\tconn, err := sl.listener.Accept()\r\n   133\t\t\tif err != nil {\r\n   134\t\t\t\treturn\r\n   135\t\t\t}\r\n   136\t\t\tsl.wg.Add(1)\r\n   137\t\t\tgo func(c net.Conn) {\r\n   138\t\t\t\tdefer sl.wg.Done()\r\n"]
[9511.352741, "o", "   139\t\t\t\tr.handleConn(sl.service, c)\r\n   140\t\t\t}(conn)\r\n   141\t\t}\r\n   142\t}\r\n   143\t\r\n"]
[9511.352769, "o", "   144\tfunc (sl *serviceListener) stopAccept(drain bool, r *Router) {\r\n   145\t\tselect {\r\n   146\t\tcase <-sl.stop:\r\n   147\t\tdefault:\r\n   148\t\t\tclose(sl.stop)\r\n   149\t\t}\r\n   150\t\tsl.listener.Close()\r\n   151\t\t<-sl.done\r\n   152\t\tif drain {\r\n   153\t\t\tss := r.state.GetService(sl.service)\r\n   154\t\t\ttimeout := 5 * time.Second\r\n   155\t\t\tif ss != nil {\r\n   156\t\t\t\ttimeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n"]
[9511.352852, "o", "   157\t\t\t\tif timeout <= 0 {\r\n   158\t\t\t\t\ttimeout = 5 * time.Second\r\n   159\t\t\t\t}\r\n   160\t\t\t}\r\n"]
