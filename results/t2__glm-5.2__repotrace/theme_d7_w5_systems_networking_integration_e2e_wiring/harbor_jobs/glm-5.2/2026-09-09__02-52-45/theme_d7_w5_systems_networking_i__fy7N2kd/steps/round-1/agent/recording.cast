[6626.056796, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/state/state.go')\ns = p.read_text()\n\n# EndpointState fields\ns = s.replace(\n'''\\tcurrentWeight     int\n\\tconnections       map[int64]*connectionInfo\n}''',\n'''\\tcurrentWeight     int\n\\tWarmupDurationMs  int\n\\twarmupUntil       time.Time\n\\tconnections       map[int64]*connectionInfo\n}''')\n\n# ServiceState field\ns = s.replace(\n'''\\tMaxConnectionsPerEndpoint int\n\\tIdleTimeoutMs             int''',\n'''\\tMaxConnectionsPerEndpoint int\n\\tConnectionLimitMode       string\n\\tIdleTimeoutMs             int''')\n\n# ApplyConfig update\ns = s.replace(\n'''\\t\\t\\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\n\\t\\t\\tss.IdleTimeoutMs = svc.IdleTimeoutMs''',\n'''\\t\\t\\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\n\\t\\t\\tss.ConnectionLimitMode = svc.ConnectionLimitMode\n\\t\\t\\tss.IdleTimeoutMs = svc.IdleTimeoutMs''')\n\n# newServiceState\ns = s.replace(\n'''\\t\\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\n\\t\\tIdleTimeoutMs:             svc.Idl"]
[6626.056844, "i", "eTimeoutMs,''',\n'''\\t\\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\n\\t\\tConnectionLimitMode:       svc.ConnectionLimitMode,\n\\t\\tIdleTimeoutMs:             svc.IdleTimeoutMs,''')\n\n# applyEndpoints existing endpoint update\ns = s.replace(\n'''\\t\\t\\tep.Config = cep\n\\t\\t\\tep.Weight = cep.Weight\n\\t\\t\\tep.mu.Unlock()''',\n'''\\t\\t\\tep.Config = cep\n\\t\\t\\tep.Weight = cep.Weight\n\\t\\t\\tep.WarmupDurationMs = cep.WarmupDurationMs\n\\t\\t\\tep.mu.Unlock()''')\n\n# newEndpointState\ns = s.replace(\n'''\\t\\tWeight:      cep.Weight,\n\\t\\tConfig:      cep,''',\n'''\\t\\tWeight:           cep.Weight,\n\\t\\tWarmupDurationMs: cep.WarmupDurationMs,\n\\t\\tConfig:           cep,''')\n\n# ResetCircuitBreaker\ns = s.replace(\n'''func (s *State) ResetCircuitBreaker(service, address string) error {\n\\tep := s.GetEndpoint(service, address)\n\\tif ep == nil {\n\\t\\treturn errNotFound(\"endpoint not found\")\n\\t}\n\\tep.Circuit.Reset()\n\\treturn nil\n}''',\n'''func (s *State) ResetCircuitBreaker(service, address string) error {\n\\tep := s.GetEndpoint(service, addr"]
