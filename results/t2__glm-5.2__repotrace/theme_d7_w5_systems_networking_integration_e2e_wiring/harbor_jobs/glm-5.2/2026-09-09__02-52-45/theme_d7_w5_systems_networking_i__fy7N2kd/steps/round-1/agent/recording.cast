[9593.019769, "o", "    83\t\tif rl.queueDepth >= rl.queueMax {\r\n    84\t\t\trl.rateLimited++\r\n    85\t\t\trl.mu.Unlock()\r\n    86\t\t\treturn false, false\r\n    87\t\t}\r\n    88\t\trl.queueDepth++\r\n    89\t\trl.queued++\r\n    90\t\trl.mu.Unlock()\r\n    91\t\r\n    92\t\tdeadline := now.Add(rl.timeout)\r\n    93\t\tfor {\r\n    94\t\t\trl.mu.Lock()\r\n    95\t\t\tvar wait time.Duration\r\n"]
