[1189.617946, "o", "\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"status\"\u001b[m\u001b[K:\r\n"]
[1189.618037, "o", "\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"reload\"\u001b[m\u001b[K:\r\n"]
[1189.618163, "o", "\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfmt.Fprintf(os.Stderr, \"\u001b[01;31m\u001b[Kunknown command\u001b[m\u001b[K: %s\\n\", cmd)\r\n"]
[1189.618224, "o", "\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"status\"\u001b[m\u001b[K:\r\n"]
