[9857.419191, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/router/router.go')\nlines = p.read_text().splitlines()\nfor i, line in enumerate(lines):\n    if 'ep.Stats.RecordRetry()' in line:\n        indent = line[:len(line)-len(line.lstrip())]\n        lines.insert(i, indent + 'retryCount++')\n        break\nelse:\n    raise SystemExit('RecordRetry line not found')\np.write_text('\\n'.join(lines) + '\\n')\nPY\n"]
