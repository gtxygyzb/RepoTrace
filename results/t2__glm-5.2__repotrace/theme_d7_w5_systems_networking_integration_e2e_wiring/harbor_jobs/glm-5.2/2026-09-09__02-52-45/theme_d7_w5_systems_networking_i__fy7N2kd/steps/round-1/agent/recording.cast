[5929.462832, "o", "   188\t\treturn prettyData(ipcCmd, resp.Data)\r\n   189\t}\r\n   190\t\r\n   191\tfunc prettyData(ipcCmd string, data json.RawMessage) (string, error) {\r\n   192\t\tswitch ipcCmd {\r\n   193\t\tcase \"list_services\":\r\n   194\t\t\tvar services []struct {\r\n   195\t\t\t\tName        string `json:\"name\"`\r\n   196\t\t\t\tListenPort  int    `json:\"listen_port\"`\r\n   197\t\t\t\tRoutingMode string `json:\"routing_mode\"`\r\n   198\t\t\t\tEndpoints   []struct {\r\n   199\t\t\t\t\tAddress           string `json:\"address\"`\r\n   200\t\t\t\t\tState             string `json:\"state\"`\r\n   201\t\t\t\t\tWeight            int    `json:\"weight\"`\r\n   202\t\t\t\t\tActiveConnections int    `json:\"active_connections\"`\r\n   203\t\t\t\t\tCircuitState      string `json:\"circuit_state\"`\r\n   204\t\t\t\t} `json:\"endpoints\"`\r\n   205\t\t\t}\r\n   206\t\t\tif err := json.Unmarshal(data, &services); err != nil {\r\n   207\t\t\t\treturn \"\", err\r\n   208\t\t\t}\r\n   209\t\t\tvar b strings.Builder\r\n   210\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\r\n   211\t\t\tfor _, s"]
[5929.463035, "o", "vc := range services {\r\n   212\t\t\t\tfor _, ep := range svc.Endpoints {\r\n   213\t\t\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\r\n   214\t\t\t\t}\r\n   215\t\t\t}\r\n   216\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   217\t\tcase \"resolve\":\r\n   218\t\t\tvar addr string\r\n   219\t\t\tif err := json.Unmarshal(data, &addr); err != nil {\r\n   220\t\t\t\treturn \"\", err\r\n   221\t\t\t}\r\n   222\t\t\treturn addr, nil\r\n   223\t\tcase \"get_circuit_breakers\":\r\n   224\t\t\tvar circuits []struct {\r\n   225\t\t\t\tAddress             string `json:\"address\"`\r\n   226\t\t\t\tCircuitState        string `json:\"circuit_state\"`\r\n   227\t\t\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n   228\t\t\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n   229\t\t\t\tProbeActive         bool   `json:\"probe_active\"`\r\n   230\t\t\t}\r\n"]
