[9511.351968, "o", "     7\t\t\"sync\"\r\n     8\t\t\"sync/atomic\"\r\n     9\t\t\"time\"\r\n    10\t\r\n    11\t\t\"meshrouter/internal/accesslog\"\r\n    12\t\t\"meshrouter/internal/state\"\r\n    13\t)\r\n    14\t\r\n    15\ttype serviceListener struct {\r\n    16\t\tservice  string\r\n    17\t\tport     int\r\n    18\t\tlistener net.Listener\r\n    19\t\tstop     chan struct{}\r\n    20\t\twg       sync.WaitGroup\r\n    21\t\tdone     chan struct{}\r\n    22\t}\r\n    23\t\r\n    24\ttype Router struct {\r\n    25\t\tstate     *state.State\r\n"]
[9511.35206, "o", "    26\t\taccessLog *accesslog.Logger\r\n    27\t\tmu        sync.Mutex\r\n    28\t\tlisteners map[string]*serviceListener\r\n    29\t}\r\n    30\t\r\n    31\tfunc NewRouter(s *state.State) *Router {\r\n    32\t\treturn &Router{\r\n    33\t\t\tstate:     s,\r\n    34\t\t\tlisteners: make(map[string]*serviceListener),\r\n    35\t\t}\r\n    36\t}\r\n    37\t\r\n    38\tfunc (r *Router) SetAccessLogger(l *accesslog.Logger) {\r\n    39\t\tr.accessLog = l\r\n"]
[9511.352089, "o", "    40\t}\r\n    41\t\r\n    42\tfunc (r *Router) Start() {\r\n"]
