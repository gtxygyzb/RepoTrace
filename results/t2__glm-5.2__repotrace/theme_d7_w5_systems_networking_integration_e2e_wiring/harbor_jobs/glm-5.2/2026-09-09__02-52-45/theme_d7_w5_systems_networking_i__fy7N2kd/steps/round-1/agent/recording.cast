[14481.826575, "o", "\u001b[?2004h> "]
[14481.826882, "o", "func copyTee(primary, mirror io.Writer, src io.Reader, ep *state.EndpointState, id int64, direction string) (int64, error) {\r\n\u001b[?2004l\r"]
[14481.826953, "o", "\u001b[?2004h> "]
[14481.827013, "o", "\\tbuf := make([]byte, 32*1024)\r\n\u001b[?2004l\r\u001b[?2004h"]
[14481.827088, "o", "> \\tvar total int64\r\n\u001b[?2004l\r\u001b[?2004h"]
[14481.827156, "o", "> \\tmirrorOK := true\r\n\u001b[?2004l\r"]
[14481.827222, "o", "\u001b[?2004h> \\tfor {\r\n\u001b[?2004l\r"]
[14481.827286, "o", "\u001b[?2004h> "]
[14481.827339, "o", "\\t\\tn, err := src.Read(buf)\r\n\u001b[?2004l\r\u001b[?2004h"]
[14481.827372, "o", "> "]
[14481.827465, "o", "\\t\\tif n > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.82761, "o", "\\t\\t\\tif _, werr := primary.Write(buf[:n]); werr != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[14481.827675, "o", "> "]
[14481.827741, "o", "\\t\\t\\t\\treturn total, werr\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.827809, "o", "\\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.827874, "o", "\\t\\t\\tif mirrorOK {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.828059, "o", "\\t\\t\\t\\tif _, merr := mirror.Write(buf[:n]); merr != nil {\r\n\u001b[?2004l\r"]
[14481.828124, "o", "\u001b[?2004h> "]
[14481.828187, "o", "\\t\\t\\t\\t\\tmirrorOK = false\r\n\u001b[?2004l\r\u001b[?2004h"]
[14481.828263, "o", "> \\t\\t\\t\\t}\r\n\u001b[?2004l\r"]
[14481.828334, "o", "\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.828417, "o", "\\t\\t\\ttotal += int64(n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.82852, "o", "\\t\\t\\tif direction == \"out\" {\r\n\u001b[?2004l\r"]
[14481.828586, "o", "\u001b[?2004h> "]
[14481.828699, "o", "\\t\\t\\t\\tep.UpdateConnectionActivity(id, int64(n), 0)\r\n\u001b[?2004l\r"]
[14481.828765, "o", "\u001b[?2004h> \\t\\t\\t} else {\r\n\u001b[?2004l\r"]
[14481.828829, "o", "\u001b[?2004h> "]
[14481.82895, "o", "\\t\\t\\t\\tep.UpdateConnectionActivity(id, 0, int64(n))\r\n\u001b[?2004l\r"]
[14481.82902, "o", "\u001b[?2004h> \\t\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.829091, "o", "\\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.829164, "o", "\\t\\tif err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.829241, "o", "\\t\\t\\treturn total, err\r\n\u001b[?2004l\r"]
[14481.829305, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.829373, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[14481.829455, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[14481.829776, "o", "func copyConn(dst io.Writer, src io.Reader, ep *state.EndpointState, id int64, direction string) (int64, error) {'''\r\n\u001b[?2004l\r"]
