[5884.298815, "o", "   145\t\t\twj := eps[j].Weight\r\n   146\t\t\tif wi != wj {\r\n   147\t\t\t\treturn wi > wj\r\n   148\t\t\t}\r\n   149\t\t\treturn eps[i].Address < eps[j].Address\r\n   150\t\t})\r\n   151\t\treturn eps[0]\r\n   152\t}\r\n   153\t\r\n   154\t// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\r\n   155\tfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\r\n"]
[5884.298873, "o", "   156\t\tss := s.GetService(service)\r\n   157\t\tif ss == nil {\r\n   158\t\t\treturn SelectResult{}, errNotFound(\"service not found\")\r\n   159\t\t}\r\n   160\t\tss.mu.Lock()\r\n"]
