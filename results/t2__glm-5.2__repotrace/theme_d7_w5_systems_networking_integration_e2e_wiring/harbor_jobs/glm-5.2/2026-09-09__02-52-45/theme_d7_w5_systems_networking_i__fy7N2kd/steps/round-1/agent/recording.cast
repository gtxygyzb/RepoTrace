[8402.435729, "o", "   267\t\t\t\tid, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\r\n   268\t\t\t\tif !ok {\r\n   269\t\t\t\t\tresult = \"rejected_conn_limit\"\r\n   270\t\t\t\t\tep.Stats.RecordRejection()\r\n   271\t\t\t\t\tbackend.Close()\r\n   272\t\t\t\t\tclient.Close()\r\n   273\t\t\t\t\treturn\r\n   274\t\t\t\t}\r\n   275\t\t\t}\r\n   276\t\r\n   277\t\t\tif attempt > 0 {\r\n   278\t\t\t\tep.Stats.RecordRetrySuccess()\r\n   279\t\t\t}\r\n   280\t\t\tbytesIn, bytesOut, idleClosed := forward(client, backend, ep, id, ss.IdleTimeout())\r\n   281\t\t\tbackend.Close()\r\n   282\t"]
