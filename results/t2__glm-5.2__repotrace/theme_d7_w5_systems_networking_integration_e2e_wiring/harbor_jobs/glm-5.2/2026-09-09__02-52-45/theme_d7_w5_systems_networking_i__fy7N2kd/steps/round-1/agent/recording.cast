[1497.115117, "o", "\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// Service describes one routed service from config.\r\n"]
[1497.115212, "o", "\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktype \u001b[01;31m\u001b[KService struct\u001b[m\u001b[K {\r\n"]
[1497.115281, "o", "\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tName                      string     `toml:\"name\"`\r\n\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tListenPort                int        `toml:\"listen_port\"`\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRoutingMode               string     `toml:\"routing_mode\"`\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n"]
[1497.115357, "o", "\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// Config is the parsed application configuration.\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktype \u001b[01;31m\u001b[KConfig struct\u001b[m\u001b[K {\r\n"]
[1497.115425, "o", "\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tGlobal   Global\r\n\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KServices\u001b[m\u001b[K []Service\r\n\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// Load reads and normalizes a TOML config file.\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n"]
[1497.115487, "o", "\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor i := range cfg.\u001b[01;31m\u001b[KServices\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\ts := &cfg.\u001b[01;31m\u001b[KServices\u001b[m\u001b[K[i]\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif s.RoutingMode == \"\" {\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\ts.RoutingMode = \"weighted-round-robin\"\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n"]
