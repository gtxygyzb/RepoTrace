[588.050825, "o", "\u001b[?2004h> "]
[588.051114, "o", "func (s *State) ReloadChan() <-chan struct{} {\r\n\u001b[?2004l\r"]
[588.051167, "o", "\u001b[?2004h> "]
[588.051297, "o", "    return s.reloadCh\r\n\u001b[?2004l\r"]
[588.051354, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[588.05142, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[588.051475, "o", "\u001b[?2004h> "]
[588.051703, "o", "func (s *State) ConfigPath() string {\r\n\u001b[?2004l\r"]
[588.051756, "o", "\u001b[?2004h> "]
[588.051841, "o", "    s.mu.RLock()\r\n\u001b[?2004l\r"]
[588.051895, "o", "\u001b[?2004h> "]
[588.052034, "o", "    defer s.mu.RUnlock()\r\n\u001b[?2004l\r"]
[588.052093, "o", "\u001b[?2004h> "]
[588.052237, "o", "    return s.configPath\r\n\u001b[?2004l\r"]
[588.052292, "o", "\u001b[?2004h> }"]
[588.052346, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[588.052409, "o", "\u001b[?2004h> "]
[588.052686, "o", "func (s *State) Global() config.Global {\r\n\u001b[?2004l\r"]
[588.052746, "o", "\u001b[?2004h> "]
[588.052832, "o", "    s.mu.RLock()\r\n\u001b[?2004l\r"]
[588.052887, "o", "\u001b[?2004h> "]
[588.053036, "o", "    defer s.mu.RUnlock()\r\n\u001b[?2004l\r"]
[588.053091, "o", "\u001b[?2004h> "]
[588.053209, "o", "    return s.global\r\n\u001b[?2004l\r"]
[588.053262, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[588.053308, "o", "\u001b[?2004h> "]
[588.05336, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.053696, "o", "func (s *State) ApplyConfig(cfg *config.Config) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.053767, "o", "> "]
[588.053825, "o", "    s.mu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.053929, "o", "    defer s.mu.Unlock()\r\n\u001b[?2004l\r"]
[588.053983, "o", "\u001b[?2004h> "]
[588.054085, "o", "    s.applyConfigLocked(cfg)\r\n\u001b[?2004l\r"]
[588.054143, "o", "\u001b[?2004h> "]
[588.054198, "o", "    select {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.054363, "o", "    case s.reloadCh <- struct{}{}:\r\n\u001b[?2004l\r"]
[588.054438, "o", "\u001b[?2004h> "]
[588.054495, "o", "    default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.054554, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[588.054612, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[588.05467, "o", "> "]
[588.05487, "o", "func (s *State) applyConfigLocked(cfg *config.Config) {\r\n\u001b[?2004l\r"]
[588.054933, "o", "\u001b[?2004h> "]
[588.055024, "o", "    s.global = cfg.Global\r\n\u001b[?2004l\r"]
[588.055081, "o", "\u001b[?2004h> "]
[588.055202, "o", "    seen := make(map[string]bool)\r\n\u001b[?2004l\r"]
[588.055259, "o", "\u001b[?2004h> "]
[588.055404, "o", "    for _, svc := range cfg.Services {\r\n\u001b[?2004l\r"]
[588.055456, "o", "\u001b[?2004h> "]
[588.055578, "o", "        seen[svc.Name] = true\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.055636, "o", "> "]
[588.055772, "o", "        ss := s.services[svc.Name]\r\n\u001b[?2004l\r"]
[588.055827, "o", "\u001b[?2004h> "]
[588.055904, "o", "        if ss == nil {\r\n\u001b[?2004l\r"]
[588.055955, "o", "\u001b[?2004h> "]
[588.056094, "o", "            ss = newServiceState(svc)\r\n\u001b[?2004l\r"]
[588.056149, "o", "\u001b[?2004h> "]
[588.056301, "o", "            s.services[svc.Name] = ss\r\n\u001b[?2004l\r"]
[588.056357, "o", "\u001b[?2004h> "]
[588.056417, "o", "        } else {\r\n\u001b[?2004l\r"]
[588.056469, "o", "\u001b[?2004h> "]
[588.056549, "o", "            ss.mu.Lock()\r\n\u001b[?2004l\r"]
[588.056599, "o", "\u001b[?2004h> "]
[588.056732, "o", "            ss.Name = svc.Name\r\n\u001b[?2004l\r"]
[588.056777, "o", "\u001b[?2004h> "]
[588.056944, "o", "            ss.ListenPort = svc.ListenPort\r\n\u001b[?2004l\r"]
[588.057003, "o", "\u001b[?2004h> "]
[588.057177, "o", "            ss.RoutingMode = svc.RoutingMode\r\n\u001b[?2004l\r"]
[588.05724, "o", "\u001b[?2004h> "]
[588.057438, "o", "            ss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n\u001b[?2004l\r"]
[588.057498, "o", "\u001b[?2004h> "]
[588.057783, "o", "            ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n\u001b[?2004l\r"]
[588.057844, "o", "\u001b[?2004h> "]
[588.057942, "o", "            ss.mu.Unlock()\r\n\u001b[?2004l\r"]
[588.057996, "o", "\u001b[?2004h> "]
[588.058217, "o", "            ss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n\u001b[?2004l\r"]
[588.058278, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[588.058348, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[588.058413, "o", "\u001b[?2004h> "]
[588.058548, "o", "    for name, ss := range s.services {\r\n\u001b[?2004l\r"]
[588.058612, "o", "\u001b[?2004h> "]
[588.058702, "o", "        if !seen[name] {\r\n\u001b[?2004l\r"]
[588.058755, "o", "\u001b[?2004h> "]
[588.058847, "o", "            ss.mu.Lock()\r\n\u001b[?2004l\r"]
[588.058898, "o", "\u001b[?2004h> "]
[588.059029, "o", "            ss.stopping = true\r\n\u001b[?2004l\r"]
[588.059083, "o", "\u001b[?2004h> "]
[588.059235, "o", "            if ss.listenerStop != nil {\r\n\u001b[?2004l\r"]
[588.059293, "o", "\u001b[?2004h> "]
[588.059445, "o", "                close(ss.listenerStop)\r\n\u001b[?2004l\r"]
[588.059502, "o", "\u001b[?2004h> "]
[588.059641, "o", "                ss.listenerStop = nil\r\n\u001b[?2004l\r"]
[588.059699, "o", "\u001b[?2004h> "]
[588.059749, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.059924, "o", "            if ss.Listener != nil {\r\n\u001b[?2004l\r"]
[588.05998, "o", "\u001b[?2004h> "]
[588.06011, "o", "                ss.Listener.Close()\r\n\u001b[?2004l\r"]
[588.060166, "o", "\u001b[?2004h> "]
[588.060282, "o", "                ss.Listener = nil\r\n\u001b[?2004l\r"]
[588.060334, "o", "\u001b[?2004h> "]
[588.060384, "o", "            }\r\n\u001b[?2004l\r"]
[588.060452, "o", "\u001b[?2004h> "]
[588.060558, "o", "            ss.mu.Unlock()\r\n\u001b[?2004l\r"]
[588.060611, "o", "\u001b[?2004h> "]
[588.060778, "o", "            for _, ep := range ss.Endpoints {\r\n\u001b[?2004l\r"]
[588.060838, "o", "\u001b[?2004h> "]
[588.061054, "o", "                ep.StartDraining(ss.DrainTimeoutMs, true)\r\n\u001b[?2004l\r"]
[588.061115, "o", "\u001b[?2004h> "]
[588.061167, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.061234, "o", "        }\r\n\u001b[?2004l\rd\u001b[?2004h"]
[588.061285, "o", ">     }\r\n\u001b[?2004l\r"]
[588.061336, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.109411, "o", "> \r\n\u001b[?2004l\rm\u001b[?2004h> func newServiceState(svc config.Service) *ServiceState {\r\n\u001b[?2004l\r\u001b[?2004h>     ss := &ServiceState{\r\n\u001b[?2004l\r\u001b[?2004h>         Name:                      svc.Name,\r\n\u001b[?2004l\r\u001b[?2004h>         ListenPort:                svc.ListenPort,\r\n\u001b[?2004l\r\u001b[?2004h>         RoutingMode:               svc.RoutingMode,\r\n\u001b[?2004l\r\u001b[?2004h>         DrainTimeoutMs:            svc.DrainTimeoutMs,\r\n\u001b[?2004l\r\u001b[?2004h>         MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n\u001b[?2004l\r\u001b[?2004h>         listenerStop:              nil,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[588.109522, "o", "\u001b[?2004h> "]
[588.109745, "o", "    for _, ep := range svc.Endpoints {\r\n\u001b[?2004l\r"]
[588.109801, "o", "\u001b[?2004h> "]
[588.110678, "o", "        ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, stats.New(time.Duration(svc.DrainTimeoutMs)*time.Millisecond)))\r\n\u001b[?2004l\r"]
[588.110754, "o", "\u001b[?2004h> "]
[588.110808, "o", "    }\r\n\u001b[?2004l\r"]
[588.110861, "o", "\u001b[?2004h> "]
[588.110938, "o", "    return ss\r\n\u001b[?2004l\r"]
[588.11099, "o", "\u001b[?2004h> "]
[588.111039, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.111089, "o", "> \r\n\u001b[?2004l\r"]
[588.111138, "o", "\u001b[?2004h> "]
[588.111706, "o", "func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n\u001b[?2004l\r"]
[588.111779, "o", "\u001b[?2004h> "]
[588.111884, "o", "    ss.mu.Lock()\r\n\u001b[?2004l\r"]
[588.111939, "o", "\u001b[?2004h> "]
[588.11214, "o", "    defer ss.mu.Unlock()\r\n\u001b[?2004l\r"]
[588.1122, "o", "\u001b[?2004h> "]
[588.112444, "o", "    seen := make(map[string]bool)\r\n\u001b[?2004l\r"]
[588.112506, "o", "\u001b[?2004h> "]
[588.112706, "o", "    for _, cep := range eps {\r\n\u001b[?2004l\r"]
[588.112764, "o", "\u001b[?2004h> "]
[588.112981, "o", "        seen[cep.Address] = true\r\n\u001b[?2004l\r"]
[588.113041, "o", "\u001b[?2004h> "]
[588.113239, "o", "        var ep *EndpointState\r\n\u001b[?2004l\r"]
[588.113297, "o", "\u001b[?2004h> "]
[588.113626, "o", "        for _, existing := range ss.Endpoints {\r\n\u001b[?2004l\r"]
[588.113687, "o", "\u001b[?2004h> "]
[588.114007, "o", "            if existing.Address == cep.Address {\r\n\u001b[?2004l\r"]
[588.114068, "o", "\u001b[?2004h> "]
[588.114268, "o", "                ep = existing\r\n\u001b[?2004l\r"]
[588.114326, "o", "\u001b[?2004h> "]
[588.114492, "o", "                break\r\n\u001b[?2004l\r"]
[588.114562, "o", "\u001b[?2004h> "]
[588.114648, "o", "            }\r\n\u001b[?2004l\r"]
[588.114702, "o", "\u001b[?2004h> "]
[588.114779, "o", "        }\r\n\u001b[?2004l\r"]
[588.11483, "o", "\u001b[?2004h> "]
[588.114996, "o", "        if ep == nil {\r\n\u001b[?2004l\r"]
[588.115048, "o", "\u001b[?2004h> "]
[588.115731, "o", "            ep = newEndpointState(cep, stats.New(time.Duration(global.StatsWindowSec)*time.Second))\r\n\u001b[?2004l\r"]
[588.115811, "o", "\u001b[?2004h> "]
[588.116143, "o", "            ss.Endpoints = append(ss.Endpoints, ep)\r\n\u001b[?2004l\r"]
[588.116209, "o", "\u001b[?2004h> "]
[588.116322, "o", "        } else {\r\n\u001b[?2004l\r"]
[588.116378, "o", "\u001b[?2004h> "]
[588.116555, "o", "            ep.mu.Lock()\r\n\u001b[?2004l\r"]
[588.116614, "o", "\u001b[?2004h> "]
[588.116816, "o", "            ep.Config = cep\r\n\u001b[?2004l\r"]
[588.11687, "o", "\u001b[?2004h> "]
[588.117119, "o", "            ep.Weight = cep.Weight\r\n\u001b[?2004l\r"]
[588.11718, "o", "\u001b[?2004h> "]
[588.117371, "o", "            ep.mu.Unlock()\r\n\u001b[?2004l\r"]
[588.117445, "o", "\u001b[?2004h> "]
[588.117497, "o", "        }\r\n\u001b[?2004l\r"]
[588.117547, "o", "\u001b[?2004h"]
[588.1176, "o", ">     }\r\n\u001b[?2004l\r"]
[588.117651, "o", "\u001b[?2004h"]
[588.1177, "o", "> "]
[588.117934, "o", "    for _, ep := range ss.Endpoints {\r\n\u001b[?2004l\r"]
[588.117995, "o", "\u001b[?2004h> "]
[588.118197, "o", "        if !seen[ep.Address] {\r\n\u001b[?2004l\r"]
[588.118256, "o", "\u001b[?2004h> "]
[588.11863, "o", "            ep.StartDraining(ss.DrainTimeoutMs, true)\r\n\u001b[?2004l\r"]
[588.118702, "o", "\u001b[?2004h> "]
[588.118758, "o", "        }\r\n\u001b[?2004l\r"]
[588.11881, "o", "\u001b[?2004h> "]
[588.11886, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.118909, "o", "> }\r\n\u001b[?2004l\r"]
[588.118958, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[588.119014, "o", "\u001b[?2004h> "]
[588.119555, "o", "func newEndpointState(cep config.Endpoint, st *stats.Collector) *EndpointState {\r\n\u001b[?2004l\r"]
[588.119617, "o", "\u001b[?2004h> "]
[588.119785, "o", "    return &EndpointState{\r\n\u001b[?2004l\r"]
[588.119847, "o", "\u001b[?2004h> "]
[588.120066, "o", "        Address:      cep.Address,\r\n\u001b[?2004l\r"]
[588.120123, "o", "\u001b[?2004h> "]
[588.120344, "o", "        Weight:       cep.Weight,\r\n\u001b[?2004l\r"]
[588.120405, "o", "\u001b[?2004h> "]
[588.120606, "o", "        Config:       cep,\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.120678, "o", "> "]
[588.120839, "o", "        State:        Unknown,\r\n\u001b[?2004l\r"]
[588.120898, "o", "\u001b[?2004h> "]
[588.121371, "o", "        Circuit:      circuit.New(time.Duration(5000) * time.Millisecond),\r\n\u001b[?2004l\r"]
[588.12144, "o", "\u001b[?2004h> "]
[588.121601, "o", "        Stats:        st,\r\n\u001b[?2004l\r"]
[588.12166, "o", "\u001b[?2004h> "]
[588.121975, "o", "        connections:  make(map[int64]net.Conn),\r\n\u001b[?2004l\r"]
[588.122038, "o", "\u001b[?2004h> "]
[588.122091, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.122141, "o", "> }\r\n\u001b[?2004l\r"]
[588.12219, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[588.122241, "o", "\u001b[?2004h> "]
[588.122638, "o", "func (s *State) GetService(name string) *ServiceState {\r\n\u001b[?2004l\r"]
[588.122704, "o", "\u001b[?2004h> "]
[588.122806, "o", "    s.mu.RLock()\r\n\u001b[?2004l\r"]
[588.122861, "o", "\u001b[?2004h> "]
[588.123012, "o", "    defer s.mu.RUnlock()\r\n\u001b[?2004l\r"]
[588.12307, "o", "\u001b[?2004h> "]
[588.123242, "o", "    return s.services[name]\r\n\u001b[?2004l\r"]
[588.123301, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[588.123353, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[588.123411, "o", "\u001b[?2004h> "]
[588.123705, "o", "func (s *State) Services() []*ServiceState {\r\n\u001b[?2004l\r"]
[588.123769, "o", "\u001b[?2004h> "]
[588.123864, "o", "    s.mu.RLock()\r\n\u001b[?2004l\r"]
[588.123917, "o", "\u001b[?2004h> "]
[588.124084, "o", "    defer s.mu.RUnlock()\r\n\u001b[?2004l\r"]
[588.124145, "o", "\u001b[?2004h> "]
[588.12449, "o", "    out := make([]*ServiceState, 0, len(s.services))\r\n\u001b[?2004l\r"]
[588.124553, "o", "\u001b[?2004h> "]
[588.124772, "o", "    for _, ss := range s.services {\r\n\u001b[?2004l\r"]
[588.124831, "o", "\u001b[?2004h> "]
[588.125015, "o", "        out = append(out, ss)\r\n\u001b[?2004l\r"]
[588.12507, "o", "\u001b[?2004h> "]
[588.125122, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.125171, "o", "> "]
[588.125252, "o", "    return out\r\n\u001b[?2004l\r"]
[588.125305, "o", "\u001b[?2004h> }"]
[588.125354, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.125411, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[588.125464, "o", "> "]
[588.125891, "o", "func (s *State) GetEndpoint(service, address string) *EndpointState {\r\n\u001b[?2004l\r"]
[588.125955, "o", "\u001b[?2004h> "]
[588.126145, "o", "    ss := s.GetService(service)\r\n\u001b[?2004l\r"]
[588.126209, "o", "\u001b[?2004h> "]
[588.12632, "o", "    if ss == nil {\r\n\u001b[?2004l\r"]
[588.126377, "o", "\u001b[?2004h> "]
[588.126511, "o", "        return nil\r\n\u001b[?2004l\r"]
[588.126566, "o", "\u001b[?2004h> "]
[588.126616, "o", "    }\r\n\u001b[?2004l\r"]
[588.126668, "o", "\u001b[?2004h> "]
[588.12678, "o", "    ss.mu.Lock()\r\n\u001b[?2004l\r"]
[588.126833, "o", "\u001b[?2004h> "]
[588.126995, "o", "    defer ss.mu.Unlock()\r\n\u001b[?2004l\r"]
[588.127056, "o", "\u001b[?2004h> "]
[588.127294, "o", "    for _, ep := range ss.Endpoints {\r\n\u001b[?2004l\r"]
[588.127356, "o", "\u001b[?2004h> "]
[588.12759, "o", "        if ep.Address == address {\r\n\u001b[?2004l\r"]
[588.127655, "o", "\u001b[?2004h> "]
[588.127779, "o", "            return ep\r\n\u001b[?2004l\r"]
[588.127832, "o", "\u001b[?2004h> "]
[588.127912, "o", "        }\r\n\u001b[?2004l\r"]
[588.127965, "o", "\u001b[?2004h> "]
[588.128015, "o", "    }\r\n\u001b[?2004l\r"]
[588.128063, "o", "\u001b[?2004h> "]
[588.128175, "o", "    return nil\r\n\u001b[?2004l\r"]
[588.12823, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[588.12828, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[588.128334, "o", "\u001b[?2004h> "]
[588.128794, "o", "func (s *State) SetWeight(service, address string, weight int) error {\r\n\u001b[?2004l\r"]
[588.128862, "o", "\u001b[?2004h> "]
[588.129141, "o", "    ep := s.GetEndpoint(service, address)\r\n\u001b[?2004l\r"]
[588.129201, "o", "\u001b[?2004h> "]
[588.129311, "o", "    if ep == nil {\r\n\u001b[?2004l\r"]
[588.129365, "o", "\u001b[?2004h> "]
[588.129713, "o", "        return errNotFound(\"endpoint not found\")\r\n\u001b[?2004l\r"]
[588.129779, "o", "\u001b[?2004h> "]
[588.129843, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.129941, "o", "    ep.mu.Lock()\r\n\u001b[?2004l\r"]
[588.129994, "o", "\u001b[?2004h> "]
[588.130107, "o", "    defer ep.mu.Unlock()\r\n\u001b[?2004l\r"]
[588.13016, "o", "\u001b[?2004h> "]
[588.130244, "o", "    if weight < 0 {\r\n\u001b[?2004l\r"]
[588.130297, "o", "\u001b[?2004h> "]
[588.130374, "o", "        weight = 0\r\n\u001b[?2004l\r"]
[588.130433, "o", "\u001b[?2004h> "]
[588.130484, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.130615, "o", "    ep.Weight = weight\r\n\u001b[?2004l\r"]
[588.130669, "o", "\u001b[?2004h> "]
[588.130721, "o", "    return nil\r\n\u001b[?2004l\r"]
[588.130771, "o", "\u001b[?2004h> }\r\n"]
[588.130822, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r "]
[588.130871, "o", "\u001b[?2004h> "]
[588.131201, "o", "func (s *State) DrainEndpoint(service, address string) error {\r\n\u001b[?2004l\r"]
[588.131264, "o", "\u001b[?2004h> "]
[588.1314, "o", "    ss := s.GetService(service)\r\n\u001b[?2004l\r"]
[588.131457, "o", "\u001b[?2004h> "]
[588.131538, "o", "    if ss == nil {\r\n\u001b[?2004l\r"]
[588.131591, "o", "\u001b[?2004h> "]
[588.131815, "o", "        return errNotFound(\"service not found\")\r\n\u001b[?2004l\r"]
[588.131876, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[588.131928, "o", "\u001b[?2004h> "]
[588.132147, "o", "    ep := s.GetEndpoint(service, address)\r\n\u001b[?2004l\r"]
[588.132204, "o", "\u001b[?2004h> "]
[588.132278, "o", "    if ep == nil {\r\n\u001b[?2004l\r"]
[588.132331, "o", "\u001b[?2004h> "]
[588.132586, "o", "        return errNotFound(\"endpoint not found\")\r\n\u001b[?2004l\r"]
[588.132651, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[588.132702, "o", "\u001b[?2004h> "]
[588.132928, "o", "    ep.StartDraining(ss.DrainTimeoutMs, false)\r\n\u001b[?2004l\r"]
[588.132991, "o", "\u001b[?2004h> "]
[588.133043, "o", "    return nil\r\n\u001b[?2004l\r"]
[588.133093, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[588.133138, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[588.133177, "o", "\u001b[?2004h> "]
[588.133449, "o", "func (s *State) ResetCircuitBreaker(service, address string) error {\r\n\u001b[?2004l\r"]
[588.133488, "o", "\u001b[?2004h> "]
[588.133645, "o", "    ep := s.GetEndpoint(service, address)\r\n\u001b[?2004l\r"]
[588.133709, "o", "\u001b[?2004h> "]
[588.133759, "o", "    if ep == nil {\r\n\u001b[?2004l\r"]
[588.13381, "o", "\u001b[?2004h> "]
[588.133977, "o", "        return errNotFound(\"endpoint not found\")\r\n\u001b[?2004l\r"]
[588.134038, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[588.134089, "o", "\u001b[?2004h> "]
[588.134165, "o", "    ep.Circuit.Reset()\r\n\u001b[?2004l\r"]
[588.134216, "o", "\u001b[?2004h> "]
[588.134264, "o", "    return nil\r\n\u001b[?2004l\r"]
[588.134313, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[588.134362, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[588.134436, "o", "> "]
[588.134668, "o", "func (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {\r\n\u001b[?2004l\r"]
[588.134731, "o", "\u001b[?2004h> "]
[588.134784, "o", "    ep.mu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.134834, "o", "> "]
[588.134901, "o", "    defer ep.mu.Unlock()\r\n\u001b[?2004l\r"]
[588.134951, "o", "\u001b[?2004h> "]
[588.135031, "o", "    ep.State = Draining\r\n\u001b[?2004l\r"]
[588.135082, "o", "\u001b[?2004h> "]
[588.135164, "o", "    ep.consecSuccess = 0\r\n\u001b[?2004l\r"]
[588.135216, "o", "\u001b[?2004h> "]
[588.1353, "o", "    ep.consecFailures = 0\r\n\u001b[?2004l\r"]
[588.135353, "o", "\u001b[?2004h> "]
[588.135657, "o", "    ep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\r\n\u001b[?2004l\r"]
[588.135731, "o", "\u001b[?2004h> "]
[588.135793, "o", "    if markRemoved {\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.135845, "o", "> "]
[588.135921, "o", "        ep.removed = true\r\n\u001b[?2004l\r"]
[588.135971, "o", "\u001b[?2004h> "]
[588.136021, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.136156, "o", "    if len(ep.connections) > 0 {\r\n\u001b[?2004l\r"]
[588.136214, "o", "\u001b[?2004h> "]
[588.136438, "o", "        go func(deadline time.Time, conns map[int64]net.Conn) {\r\n\u001b[?2004l\r"]
[588.1365, "o", "\u001b[?2004h> "]
[588.136645, "o", "            time.Sleep(time.Until(deadline))\r\n\u001b[?2004l\r"]
[588.136702, "o", "\u001b[?2004h> "]
[588.136833, "o", "            ep.closeConnectionsLocked()\r\n\u001b[?2004l\r"]
[588.13689, "o", "\u001b[?2004h> "]
[588.137037, "o", "        }(ep.drainDeadline, ep.connections)\r\n\u001b[?2004l\r"]
[588.137094, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[588.137142, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[588.137192, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[588.137243, "o", "> "]
[588.137458, "o", "func (ep *EndpointState) AddConnection(conn net.Conn) int64 {\r\n\u001b[?2004l\r"]
[588.137517, "o", "\u001b[?2004h> "]
[588.137567, "o", "    ep.mu.Lock()\r\n\u001b[?2004l\r"]
[588.137617, "o", "\u001b[?2004h> "]
[588.137693, "o", "    defer ep.mu.Unlock()\r\n\u001b[?2004l\r"]
[588.137744, "o", "\u001b[?2004h> "]
[588.13791, "o", "    id := atomic.AddInt64(&ep.connIDCounter, 1)\r\n\u001b[?2004l\r"]
[588.137973, "o", "\u001b[?2004h> "]
[588.138062, "o", "    ep.connections[id] = conn\r\n\u001b[?2004l\r"]
[588.138113, "o", "\u001b[?2004h> "]
[588.138202, "o", "    ep.ActiveConnections++\r\n\u001b[?2004l\r"]
[588.138256, "o", "\u001b[?2004h> "]
[588.138305, "o", "    return id\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.138355, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.138412, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[588.138461, "o", "> "]
[588.138643, "o", "func (ep *EndpointState) RemoveConnection(id int64) {\r\n\u001b[?2004l\r"]
[588.138698, "o", "\u001b[?2004h> "]
[588.13878, "o", "    ep.mu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.13888, "o", "    defer ep.mu.Unlock()\r\n\u001b[?2004l\r"]
[588.138933, "o", "\u001b[?2004h> "]
[588.139072, "o", "    if _, ok := ep.connections[id]; ok {\r\n\u001b[?2004l\r"]
[588.139127, "o", "\u001b[?2004h> "]
[588.139252, "o", "        delete(ep.connections, id)\r\n\u001b[?2004l\r"]
[588.139309, "o", "\u001b[?2004h> "]
[588.139421, "o", "        if ep.ActiveConnections > 0 {\r\n\u001b[?2004l\r"]
[588.139475, "o", "\u001b[?2004h> "]
[588.139547, "o", "            ep.ActiveConnections--\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.139597, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.139646, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[588.139697, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[588.139745, "o", "> "]
[588.139847, "o", "func (ep *EndpointState) closeConnectionsLocked() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.139912, "o", "> "]
[588.139966, "o", "    for id, c := range ep.connections {\r\n\u001b[?2004l\r"]
[588.140016, "o", "\u001b[?2004h> "]
[588.140066, "o", "        c.Close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.140159, "o", "        delete(ep.connections, id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.140216, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[588.140267, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[588.140316, "o", "> "]
[588.140402, "o", "func (ep *EndpointState) Active() int {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.140455, "o", "    ep.mu.Lock()\r\n\u001b[?2004l\r"]
[588.140505, "o", "\u001b[?2004h> "]
[588.140554, "o", "    defer ep.mu.Unlock()\r\n\u001b[?2004l\r"]
[588.140604, "o", "\u001b[?2004h> "]
[588.140653, "o", "    return ep.ActiveConnections\r\n\u001b[?2004l\r"]
[588.140702, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.140753, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.140891, "o", "func (ep *EndpointState) IsEligible(maxConns int) bool {\r\n\u001b[?2004l\r"]
[588.140948, "o", "\u001b[?2004h>     ep.mu.Lock()\r\n\u001b[?2004l\r"]
[588.141, "o", "\u001b[?2004h> "]
[588.14105, "o", "    defer ep.mu.Unlock()\r\n\u001b[?2004l\r"]
[588.141098, "o", "\u001b[?2004h> "]
[588.141415, "o", "    return ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.141478, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[588.141531, "o", "> "]
[588.141718, "o", "func (s *State) RecordHealthCheck(service, address string, success bool) HealthEvent {\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.141782, "o", "> "]
[588.141832, "o", "    ss := s.GetService(service)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.141899, "o", "    if ss == nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.141948, "o", "> "]
[588.141998, "o", "        return HealthEvent{}\r\n\u001b[?2004l\r"]
[588.142048, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.142098, "o", "> "]
[588.142175, "o", "    ep := s.GetEndpoint(service, address)\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.142227, "o", "> "]
[588.142276, "o", "    if ep == nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.142349, "o", "        return HealthEvent{}\r\n\u001b[?2004l\r"]
[588.142407, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.142482, "o", "    global := s.Global()\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.142536, "o", ">     ep.mu.Lock()\r\n\u001b[?2004l\r"]
[588.142585, "o", "\u001b[?2004h> "]
[588.142634, "o", "    oldState := ep.State\r\n\u001b[?2004l\r"]
[588.142683, "o", "\u001b[?2004h> "]
[588.142734, "o", "    result := \"success\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.1428, "o", "    if !success {\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.14285, "o", "> "]
[588.1429, "o", "        result = \"failure\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.14295, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.14301, "o", "    if success {\r\n\u001b[?2004l\r"]
[588.14306, "o", "\u001b[?2004h> "]
[588.14311, "o", "        ep.consecSuccess++\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.143158, "o", "> "]
[588.143208, "o", "        ep.consecFailures = 0\r\n\u001b[?2004l\r"]
[588.143257, "o", "\u001b[?2004h> "]
[588.143442, "o", "        if oldState == Unknown && ep.consecSuccess >= global.HealthyThreshold {\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.143509, "o", "> "]
[588.14356, "o", "            ep.State = Healthy\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.143791, "o", "        } else if oldState == Unhealthy && ep.consecSuccess >= global.HealthyThreshold {\r\n\u001b[?2004l\r"]
[588.14385, "o", "\u001b[?2004h> "]
[588.143899, "o", "            ep.State = Healthy\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.14395, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.144002, "o", ">     } else {\r\n\u001b[?2004l\r"]
[588.144051, "o", "\u001b[?2004h> "]
[588.144099, "o", "        ep.consecFailures++\r\n\u001b[?2004l\r"]
[588.144148, "o", "\u001b[?2004h> "]
[588.144195, "o", "        ep.consecSuccess = 0\r\n\u001b[?2004l\r"]
[588.144243, "o", "\u001b[?2004h> "]
[588.144506, "o", "        if (oldState == Healthy || oldState == Unknown) && ep.consecFailures >= global.UnhealthyThreshold {\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.144568, "o", "> "]
[588.14462, "o", "            ep.State = Unhealthy\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.14467, "o", "> "]
[588.144721, "o", "            ep.Circuit.Open()\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.144771, "o", "> "]
[588.144822, "o", "            ep.consecFailures = 0\r\n\u001b[?2004l\r"]
[588.144871, "o", "\u001b[?2004h> "]
[588.145045, "o", "            timeout := time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n\u001b[?2004l\r"]
[588.145103, "o", "\u001b[?2004h> "]
[588.145178, "o", "            go func(deadline time.Time) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.145231, "o", "> "]
[588.145327, "o", "                time.Sleep(time.Until(deadline))\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.14538, "o", "> "]
[588.14544, "o", "                ep.mu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.145567, "o", "                ep.closeConnectionsLocked()\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.145627, "o", "> "]
[588.145679, "o", "                ep.mu.Unlock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.145796, "o", "            }(time.Now().Add(timeout))\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.14585, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.145877, "o", "> "]
[588.145901, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.145982, "o", "    newState := ep.State\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.146002, "o", "> "]
[588.146057, "o", "    ep.mu.Unlock()\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.146077, "o", "> "]
[588.146151, "o", "    evt := HealthEvent{\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.146183, "o", "> "]
[588.146255, "o", "        Timestamp:   time.Now(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.146276, "o", "> "]
[588.146357, "o", "        Endpoint:    address,\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.146377, "o", "> "]
[588.146467, "o", "        OldState:    oldState,\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.146488, "o", "> "]
[588.146571, "o", "        NewState:    newState,\r\n\u001b[?2004l\r"]
[588.146591, "o", "\u001b[?2004h> "]
[588.146671, "o", "        CheckResult: result,\r\n\u001b[?2004l\r"]
[588.14669, "o", "\u001b[?2004h> "]
[588.14671, "o", "    }\r\n\u001b[?2004l\r"]
[588.146731, "o", "\u001b[?2004h> "]
[588.209519, "o", "    s.logMu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h>     s.healthLog[service] = append(s.healthLog[service], evt)\r\n\u001b[?2004l\r\u001b[?2004h>     if len(s.healthLog[service]) > 1000 {\r\n\u001b[?2004l\r\u001b[?2004h>         s.healthLog[service] = s.healthLog[service][len(s.healthLog[service])-1000:]\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     s.logMu.Unlock()\r\n\u001b[?2004l\r\u001b[?2004h>     return evt\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func (s *State) HealthLog(service string, lastN int) []HealthEvent {\r\n\u001b[?2004l\r\u001b[?2004h>     s.logMu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h>     defer s.logMu.Unlock()\r\n\u001b[?2004l\r\u001b[?2004h>     events := s.healthLog[service]\r\n\u001b[?2004l\r\u001b[?2004h>     if lastN <= 0 || lastN > len(events) {\r\n\u001b[?2004l\r\u001b[?2004h>         lastN = len(events)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     out := make([]HealthEvent, lastN)\r\n\u001b[?2004l\r\u001b[?2004h>     copy(out, events[len(events)-lastN:])\r\n\u001b[?2004l\r\u001b[?2004h>     return out\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> type notFoundError struct {"]
[588.209634, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     msg string\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func (e *notFoundError) Error() string {\r\n\u001b[?2004l\r\u001b[?2004h>     return e.msg\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func errNotFound(msg string) error {\r\n\u001b[?2004l\r\u001b[?2004h>     return &notFoundError{msg: msg}\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.209705, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.209796, "o", "EOF\r\n\u001b[?2004l\r"]
