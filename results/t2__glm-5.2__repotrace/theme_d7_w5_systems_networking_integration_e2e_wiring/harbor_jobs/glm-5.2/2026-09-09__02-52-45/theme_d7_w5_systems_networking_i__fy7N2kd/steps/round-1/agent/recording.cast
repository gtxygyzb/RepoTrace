[14477.801078, "i", "python3 - <<'PY'\ncontent = r'''package circuit\n\nimport (\n\t\"sync\"\n\t\"time\"\n)\n\ntype State string\n\nconst (\n\tClosed   State = \"closed\"\n\tOpen     State = \"open\"\n\tHalfOpen State = \"half_open\"\n)\n\n// Breaker implements an endpoint circuit breaker.\ntype Breaker struct {\n\tmu                  sync.Mutex\n\tstate               State\n\tconsecutiveFailures int\n\tstateChangedAt      time.Time\n\topenedAt            time.Time\n\ttimeout             time.Duration\n\thalfOpenMaxProbes   int\n\tprobeActive         int\n\tprobeSuccesses      int\n\tprobeFailures       int\n}\n\n// New creates a closed breaker with the given open timeout and half-open max probes.\nfunc New(timeout time.Duration, halfOpenMaxProbes int) *Breaker {\n\tnow := time.Now()\n\tif halfOpenMaxProbes < 1 {\n\t\thalfOpenMaxProbes = 1\n\t}\n\treturn &Breaker{\n\t\tstate:             Closed,\n\t\tstateChangedAt:    now,\n\t\topenedAt:          now,\n\t\ttimeout:           timeout,\n\t\thalfOpenMaxProbes: halfOpenMaxProbes,\n\t}\n}\n\n// State returns the current state.\nfunc (b *Breaker) State() State {\n\tb.mu.Lo"]
[14477.801342, "i", "ck()\n\tdefer b.mu.Unlock()\n\treturn b.state\n}\n\n// IsClosed returns true if the breaker is closed.\nfunc (b *Breaker) IsClosed() bool {\n\treturn b.State() == Closed\n}\n\n// IsOpen returns true if the breaker is open.\nfunc (b *Breaker) IsOpen() bool {\n\treturn b.State() == Open\n}\n\n// IsHalfOpen returns true if the breaker is half-open.\nfunc (b *Breaker) IsHalfOpen() bool {\n\treturn b.State() == HalfOpen\n}\n\n// Open forces the breaker open and restarts the timeout clock.\nfunc (b *Breaker) Open() {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := time.Now()\n\tb.state = Open\n\tb.stateChangedAt = now\n\tb.openedAt = now\n\tb.consecutiveFailures++\n\tb.probeActive = 0\n\tb.probeSuccesses = 0\n\tb.probeFailures = 0\n}\n\n// MaybeHalfOpen transitions from open to half_open if the timeout has elapsed.\nfunc (b *Breaker) MaybeHalfOpen() bool {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tif b.state == Open && time.Since(b.openedAt) >= b.timeout {\n\t\tb.state = HalfOpen\n\t\tb.stateChangedAt = time.Now()\n\t\tb.probeActive = 0\n\t\tb.probeSuccesses = 0\n\t\tb.probeFailures = "]
