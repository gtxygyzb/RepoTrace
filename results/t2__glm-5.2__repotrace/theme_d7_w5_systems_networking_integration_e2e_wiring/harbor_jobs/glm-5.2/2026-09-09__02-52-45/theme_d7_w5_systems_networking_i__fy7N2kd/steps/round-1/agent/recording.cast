[6318.53967, "o", "   552\tfunc (ep *EndpointState) TryAddConnection(conn net.Conn, maxConns int) (int64, bool) {\r\n   553\t\tep.mu.Lock()\r\n   554\t\tdefer ep.mu.Unlock()\r\n   555\t\tif ep.ActiveConnections >= maxConns {\r\n   556\t\t\treturn 0, false\r\n   557\t\t}\r\n   558\t\tid := atomic.AddInt64(&ep.connIDCounter, 1)\r\n   559\t\tnow := time.Now()\r\n   560\t\tep.connections[id] = &connectionInfo{\r\n   561\t\t\tconn:         conn,\r\n   562\t\t\tclientAddr:   remoteAddr(conn),\r\n   563\t\t\tstart:        now,\r\n   564\t\t\tlastActivity: now,\r\n   565\t\t}\r\n   566\t\tep.ActiveConnections++\r\n   567\t\treturn id, true\r\n   568\t}\r\n   569\t"]
[6318.539792, "o", "\r\n   570\tfunc (ep *EndpointState) CloseConnections() {\r\n   571\t\tep.mu.Lock()\r\n   572\t\tdefer ep.mu.Unlock()\r\n   573\t\tep.closeConnectionsLocked()\r\n   574\t}\r\n   575\t\r\n   576\tfunc (s *State) CloseServiceConnections(name string) {\r\n   577\t\tss := s.GetService(name)\r\n   578\t\tif ss == nil {\r\n   579\t\t\treturn\r\n   580\t\t}\r\n   581\t\tss.mu.Lock()\r\n   582\t\teps := make([]*EndpointState, len(ss.Endpoints))\r\n   583\t\tcopy(eps, ss.Endpoints)\r\n   584\t\tss.mu.Unlock()\r\n   585\t\tfor _, ep := range eps {\r\n   586\t\t\tep.CloseConnections()\r\n   587\t\t}\r\n   588\t}\r\n   589\t\r\n   590\tfunc (ss *ServiceState) AcquireRateLimitToken() (bool, bool) {\r\n"]
