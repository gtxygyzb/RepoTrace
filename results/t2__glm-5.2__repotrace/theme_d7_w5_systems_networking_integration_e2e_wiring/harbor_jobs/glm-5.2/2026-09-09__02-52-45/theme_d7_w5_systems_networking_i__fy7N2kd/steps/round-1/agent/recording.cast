[786.408498, "o", "        ListenPort:  ss.ListenPort,\r\n\u001b[?2004l\r"]
[786.408569, "o", "\u001b[?2004h> "]
[786.408783, "o", "        RoutingMode: ss.RoutingMode,\r\n\u001b[?2004l\r"]
[786.408863, "o", "\u001b[?2004h> "]
[786.409238, "o", "        Endpoints:   make([]EndpointView, 0, len(ss.Endpoints)),\r\n\u001b[?2004l\r"]
[786.409313, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[786.409367, "o", "\u001b[?2004h> "]
[786.409626, "o", "    for _, ep := range ss.Endpoints {\r\n\u001b[?2004l\r"]
[786.409689, "o", "\u001b[?2004h> "]
[786.409818, "o", "        ep.mu.Lock()\r\n\u001b[?2004l\r"]
[786.409874, "o", "\u001b[?2004h> "]
[786.410244, "o", "        sv.Endpoints = append(sv.Endpoints, EndpointView{\r\n\u001b[?2004l\r"]
[786.410308, "o", "\u001b[?2004h> "]
[786.410586, "o", "            Address:            ep.Address,\r\n\u001b[?2004l\r"]
[786.410649, "o", "\u001b[?2004h> "]
[786.410954, "o", "            State:              string(ep.State),\r\n\u001b[?2004l\r"]
[786.411016, "o", "\u001b[?2004h> "]
[786.411307, "o", "            Weight:             ep.Weight,\r\n\u001b[?2004l\r"]
[786.41137, "o", "\u001b[?2004h> "]
[786.411699, "o", "            ActiveConnections: ep.ActiveConnections,\r\n\u001b[?2004l\r"]
[786.411769, "o", "\u001b[?2004h> "]
[786.412157, "o", "            CircuitState:       string(ep.Circuit.State()),\r\n\u001b[?2004l\r"]
[786.412225, "o", "\u001b[?2004h> "]
[786.412279, "o", "        })\r\n\u001b[?2004l\r"]
[786.412331, "o", "\u001b[?2004h> "]
[786.412517, "o", "        ep.mu.Unlock()\r\n\u001b[?2004l\r"]
[786.412578, "o", "\u001b[?2004h> "]
[786.412631, "o", "    }\r\n\u001b[?2004l\r"]
[786.412681, "o", "\u001b[?2004h> "]
[786.412763, "o", "    return sv\r\n\u001b[?2004l\r"]
[786.412815, "o", "\u001b[?2004h> }"]
[786.412866, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.412916, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.412966, "o", "> "]
[786.413135, "o", "type StatsEndpointView struct {\r\n\u001b[?2004l\r"]
[786.413198, "o", "\u001b[?2004h> "]
[786.413372, "o", "    Address string `json:\"address\"`\r\n\u001b[?2004l\r"]
[786.413452, "o", "\u001b[?2004h> "]
[786.413525, "o", "    stats.Snapshot\r\n\u001b[?2004l\r"]
[786.413579, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[786.413629, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[786.413678, "o", "\u001b[?2004h> "]
[786.41381, "o", "type StatsView struct {\r\n\u001b[?2004l\r"]
[786.413866, "o", "\u001b[?2004h> "]
[786.414129, "o", "    Service   string              `json:\"service\"`\r\n\u001b[?2004l\r"]
[786.414188, "o", "\u001b[?2004h> "]
[786.414459, "o", "    WindowSec int                 `json:\"window_sec\"`\r\n\u001b[?2004l\r"]
[786.414524, "o", "\u001b[?2004h> "]
[786.414775, "o", "    Endpoints []StatsEndpointView `json:\"endpoints\"`\r\n\u001b[?2004l\r"]
[786.414837, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[786.41489, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[786.41494, "o", "\u001b[?2004h> "]
[786.415303, "o", "func (s *State) StatsView(name string, windowSec int) (StatsView, bool) {\r\n\u001b[?2004l\r"]
[786.415367, "o", "\u001b[?2004h> "]
[786.415501, "o", "    ss := s.GetService(name)\r\n\u001b[?2004l\r"]
[786.415567, "o", "\u001b[?2004h> "]
[786.415661, "o", "    if ss == nil {\r\n\u001b[?2004l\r"]
[786.415717, "o", "\u001b[?2004h> "]
[786.415885, "o", "        return StatsView{}, false\r\n\u001b[?2004l\r"]
[786.415941, "o", "\u001b[?2004h> "]
[786.415993, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.416044, "o", "> "]
[786.41612, "o", "    sv := StatsView{\r\n\u001b[?2004l\r"]
[786.416172, "o", "\u001b[?2004h> "]
[786.416293, "o", "        Service:   name,\r\n\u001b[?2004l\r"]
[786.416351, "o", "\u001b[?2004h> "]
[786.416456, "o", "        WindowSec: windowSec,\r\n\u001b[?2004l\r"]
[786.416507, "o", "\u001b[?2004h> "]
[786.416659, "o", "        Endpoints: make([]StatsEndpointView, 0),\r\n\u001b[?2004l\r"]
[786.416718, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[786.41677, "o", "\u001b[?2004h> "]
[786.416822, "o", "    ss.mu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.416872, "o", "> "]
[786.416978, "o", "    for _, ep := range ss.Endpoints {\r\n\u001b[?2004l\r"]
[786.417033, "o", "\u001b[?2004h> "]
[786.417083, "o", "        ep.mu.Lock()\r\n\u001b[?2004l\r"]
[786.417133, "o", "\u001b[?2004h> "]
[786.417337, "o", "        sv.Endpoints = append(sv.Endpoints, StatsEndpointView{\r\n\u001b[?2004l\r"]
[786.417401, "o", "\u001b[?2004h> "]
[786.417493, "o", "            Address:  ep.Address,\r\n\u001b[?2004l\r"]
[786.417544, "o", "\u001b[?2004h> "]
[786.417747, "o", "            Snapshot: ep.Stats.Snapshot(ep.ActiveConnections),\r\n\u001b[?2004l\r"]
[786.417809, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[786.417859, "o", "\u001b[?2004h> "]
[786.417935, "o", "        ep.mu.Unlock()\r\n\u001b[?2004l\r"]
[786.417988, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[786.418036, "o", "\u001b[?2004h> "]
[786.418085, "o", "    ss.mu.Unlock()\r\n\u001b[?2004l\r"]
[786.418134, "o", "\u001b[?2004h> "]
[786.4182, "o", "    return sv, true\r\n\u001b[?2004l\r"]
[786.418252, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.418301, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[786.41835, "o", "> "]
[786.418429, "o", "type HealthEventView struct {\r\n\u001b[?2004l\r"]
[786.418483, "o", "\u001b[?2004h> "]
[786.418616, "o", "    Timestamp   time.Time `json:\"timestamp\"`\r\n\u001b[?2004l\r"]
[786.41867, "o", "\u001b[?2004h> "]
[786.418803, "o", "    Endpoint    string    `json:\"endpoint\"`\r\n\u001b[?2004l\r"]
[786.418864, "o", "\u001b[?2004h> "]
[786.41899, "o", "    OldState    string    `json:\"old_state\"`\r\n\u001b[?2004l\r"]
[786.419044, "o", "\u001b[?2004h> "]
[786.419184, "o", "    NewState    string    `json:\"new_state\"`\r\n\u001b[?2004l\r"]
[786.419242, "o", "\u001b[?2004h> "]
[786.419381, "o", "    CheckResult string    `json:\"check_result\"`\r\n\u001b[?2004l\r"]
[786.419418, "o", "\u001b[?2004h> }\r\n"]
[786.419487, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[786.419537, "o", "\u001b[?2004h> "]
[786.419786, "o", "func (s *State) HealthLogView(name string, lastN int) []HealthEventView {\r\n\u001b[?2004l\r"]
[786.419849, "o", "\u001b[?2004h> "]
[786.41995, "o", "    events := s.HealthLog(name, lastN)\r\n\u001b[?2004l\r"]
[786.420004, "o", "\u001b[?2004h> "]
[786.420163, "o", "    out := make([]HealthEventView, 0, len(events))\r\n\u001b[?2004l\r"]
[786.420224, "o", "\u001b[?2004h> "]
[786.420304, "o", "    for _, e := range events {\r\n\u001b[?2004l\r"]
[786.420357, "o", "\u001b[?2004h> "]
[786.420502, "o", "        out = append(out, HealthEventView{\r\n\u001b[?2004l\r"]
[786.42056, "o", "\u001b[?2004h> "]
[786.420667, "o", "            Timestamp:   e.Timestamp,\r\n\u001b[?2004l\r"]
[786.420721, "o", "\u001b[?2004h> "]
[786.420826, "o", "            Endpoint:    e.Endpoint,\r\n\u001b[?2004l\r"]
[786.420887, "o", "\u001b[?2004h> "]
[786.421015, "o", "            OldState:    string(e.OldState),\r\n\u001b[?2004l\r"]
[786.421071, "o", "\u001b[?2004h> "]
[786.4212, "o", "            NewState:    string(e.NewState),\r\n\u001b[?2004l\r"]
[786.42126, "o", "\u001b[?2004h> "]
[786.421377, "o", "            CheckResult: e.CheckResult,\r\n\u001b[?2004l\r"]
[786.421451, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[786.421504, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[786.421556, "o", "\u001b[?2004h> "]
[786.421606, "o", "    return out\r\n\u001b[?2004l\r"]
[786.421655, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.421705, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.421807, "o", "type CircuitView struct {\r\n\u001b[?2004l\r"]
[786.42186, "o", "\u001b[?2004h> "]
[786.422021, "o", "    Address             string `json:\"address\"`\r\n\u001b[?2004l\r"]
[786.422081, "o", "\u001b[?2004h> "]
[786.422241, "o", "    CircuitState        string `json:\"circuit_state\"`\r\n\u001b[?2004l\r"]
[786.4223, "o", "\u001b[?2004h> "]
[786.422505, "o", "    ConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n\u001b[?2004l\r"]
[786.422567, "o", "\u001b[?2004h> "]
[786.422731, "o", "    TimeInStateMs      int64  `json:\"time_in_state_ms\"`\r\n\u001b[?2004l\r"]
[786.422793, "o", "\u001b[?2004h> "]
[786.422942, "o", "    ProbeActive        bool   `json:\"probe_active\"`\r\n\u001b[?2004l\r"]
[786.422999, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[786.423049, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[786.423099, "o", "> "]
[786.423298, "o", "func (s *State) CircuitsView(name string) ([]CircuitView, bool) {\r\n\u001b[?2004l\r"]
[786.423359, "o", "\u001b[?2004h> "]
[786.423439, "o", "    ss := s.GetService(name)\r\n\u001b[?2004l\r"]
[786.42349, "o", "\u001b[?2004h> "]
[786.423538, "o", "    if ss == nil {\r\n\u001b[?2004l\r"]
[786.423589, "o", "\u001b[?2004h> "]
[786.423673, "o", "        return nil, false\r\n\u001b[?2004l\r"]
[786.423724, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[786.423773, "o", "\u001b[?2004h> "]
[786.423822, "o", "    ss.mu.Lock()\r\n\u001b[?2004l\r"]
[786.423871, "o", "\u001b[?2004h> "]
[786.424042, "o", "    out := make([]CircuitView, 0, len(ss.Endpoints))\r\n\u001b[?2004l\r"]
[786.424098, "o", "\u001b[?2004h> "]
[786.424209, "o", "    for _, ep := range ss.Endpoints {\r\n\u001b[?2004l\r"]
[786.424266, "o", "\u001b[?2004h> "]
[786.424323, "o", "        ep.mu.Lock()\r\n\u001b[?2004l\r"]
[786.42442, "o", "\u001b[?2004h> "]
[786.424493, "o", "        out = append(out, CircuitView{\r\n\u001b[?2004l\r"]
[786.424546, "o", "\u001b[?2004h> "]
[786.424685, "o", "            Address:             ep.Address,\r\n\u001b[?2004l\r"]
[786.424748, "o", "\u001b[?2004h> "]
[786.424927, "o", "            CircuitState:        string(ep.Circuit.State()),\r\n\u001b[?2004l\r"]
[786.42499, "o", "\u001b[?2004h> "]
[786.425192, "o", "            ConsecutiveFailures: ep.Circuit.ConsecutiveFailures(),\r\n\u001b[?2004l\r"]
[786.425249, "o", "\u001b[?2004h> "]
[786.425472, "o", "            TimeInStateMs:      ep.Circuit.TimeInStateMs(),\r\n\u001b[?2004l\r"]
[786.425535, "o", "\u001b[?2004h> "]
[786.42572, "o", "            ProbeActive:        ep.Circuit.ProbeActive(),\r\n\u001b[?2004l\r"]
[786.425774, "o", "\u001b[?2004h> "]
[786.425826, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.425906, "o", "        ep.mu.Unlock()\r\n\u001b[?2004l\r"]
[786.425961, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[786.426013, "o", "\u001b[?2004h> "]
[786.426061, "o", "    ss.mu.Unlock()\r\n\u001b[?2004l\r"]
[786.426111, "o", "\u001b[?2004h> "]
[786.426176, "o", "    return out, true\r\n\u001b[?2004l\r"]
[786.426226, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.426276, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[786.426327, "o", "> "]
[786.426528, "o", "func (s *State) ResolveEndpoint(service string) (string, error) {\r\n\u001b[?2004l\r"]
[786.426588, "o", "\u001b[?2004h> "]
[786.426669, "o", "    ss := s.GetService(service)\r\n\u001b[?2004l\r"]
[786.426722, "o", "\u001b[?2004h> "]
[786.426773, "o", "    if ss == nil {\r\n\u001b[?2004l\r"]
[786.426822, "o", "\u001b[?2004h> "]
[786.426987, "o", "        return \"\", errNotFound(\"service not found\")\r\n\u001b[?2004l\r"]
[786.427045, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[786.427098, "o", "\u001b[?2004h>     ss.mu.Lock()\r\n\u001b[?2004l\r"]
[786.427149, "o", "\u001b[?2004h> "]
[786.427243, "o", "    maxConns := ss.MaxConnectionsPerEndpoint\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.427295, "o", "> "]
[786.427346, "o", "    mode := ss.RoutingMode\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.427508, "o", "    endpoints := make([]*EndpointState, len(ss.Endpoints))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.427614, "o", "    copy(endpoints, ss.Endpoints)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.42767, "o", "    ss.mu.Unlock()\r\n\u001b[?2004l\r"]
[786.427722, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.427812, "o", "    var regular []*EndpointState\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.427866, "o", "> "]
[786.427919, "o", "    for _, ep := range endpoints {\r\n\u001b[?2004l\r"]
[786.427969, "o", "\u001b[?2004h> "]
[786.428036, "o", "        if ep.IsEligible(maxConns) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.428158, "o", "            regular = append(regular, ep)\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.428218, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.428269, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[786.428319, "o", "\u001b[?2004h> "]
[786.42837, "o", "    if len(regular) > 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.4285, "o", "        if mode == \"least-connections\" {\r\n\u001b[?2004l\r"]
[786.428554, "o", "\u001b[?2004h> "]
[786.428669, "o", "            ep := selectLeastConnections(regular, maxConns)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.428776, "o", "            return ep.Address, nil\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.428829, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.428929, "o", "        var best *EndpointState\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.429018, "o", "        var bestWeight int\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.429072, "o", "> "]
[786.429122, "o", "        for _, ep := range regular {\r\n\u001b[?2004l\r"]
[786.429175, "o", "\u001b[?2004h> "]
[786.429225, "o", "            ep.mu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.429353, "o", "            cw := ep.currentWeight + ep.Weight\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.429447, "o", "            ep.mu.Unlock()\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.429501, "o", "> "]
[786.429586, "o", "            if best == nil || cw > bestWeight {\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.429638, "o", "> "]
[786.429689, "o", "                best = ep\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.429776, "o", "                bestWeight = cw\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.429829, "o", "            }\r\n\u001b[?2004l\r"]
[786.429879, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[786.429928, "o", "\u001b[?2004h> "]
[786.429977, "o", "        if best != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.43008, "o", "            return best.Address, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.430136, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.430186, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[786.430236, "o", "\u001b[?2004h> "]
[786.430306, "o", "    for _, ep := range endpoints {\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.430356, "o", "> "]
[786.430415, "o", "        ep.mu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[786.430813, "o", "        halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns && !ep.Circuit.ProbeActive()\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.430881, "o", ">         ep.mu.Unlock()\r\n\u001b[?2004l\r"]
[786.430941, "o", "\u001b[?2004h> "]
[786.430992, "o", "        if halfOpen {\r\n\u001b[?2004l\r\u001b[?2004h> "]
