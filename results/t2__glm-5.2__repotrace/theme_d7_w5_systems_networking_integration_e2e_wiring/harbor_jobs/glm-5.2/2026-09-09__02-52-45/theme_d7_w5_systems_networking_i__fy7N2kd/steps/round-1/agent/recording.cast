[5737.258729, "o", "   231\t\t}\r\n   232\t\tfor _, ep := range ss.Endpoints {\r\n   233\t\t\tif !seen[ep.Address] {\r\n   234\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   235\t\t\t}\r\n   236\t\t}\r\n"]
