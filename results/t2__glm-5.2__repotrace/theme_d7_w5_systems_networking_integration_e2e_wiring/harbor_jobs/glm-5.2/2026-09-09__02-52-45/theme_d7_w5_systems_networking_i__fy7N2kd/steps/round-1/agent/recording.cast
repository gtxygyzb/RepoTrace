[9511.646116, "o", "   162\t\t\tgo func() {\r\n   163\t\t\t\tsl.wg.Wait()\r\n   164\t\t\t\tclose(done)\r\n   165\t\t\t}()\r\n   166\t\t\tselect {\r\n   167\t\t\tcase <-done:\r\n   168\t\t\tcase <-time.After(timeout):\r\n   169\t\t\t\tr.state.CloseServiceConnections(sl.service)\r\n   170\t\t\t\t<-done\r\n   171\t\t\t}\r\n   172\t\t} else {\r\n   173\t\t\tsl.wg.Wait()\r\n   174\t\t}\r\n   175\t}\r\n   176\t\r\n   177\tfunc (r *Router) handleConn(service string, client net.Conn) {\r\n   178\t\tstart := time.Now()\r\n   179\t\tclientAddr := \"\"\r\n   180\t\tif addr := client.RemoteAddr(); addr != nil {\r\n   181\t\t\tclientAddr = addr.String()\r\n   182\t\t}\r\n   183\t\r\n   184\t\tvar endpoint string\r\n   185\t\tvar bytesIn, bytesOut int64\r\n   186\t\tvar result string\r\n   187"]
[9511.646204, "o", "\t\tdefer func() {\r\n   188\t\t\tif result == \"\" {\r\n   189\t\t\t\tresult = \"success\"\r\n   190\t\t\t}\r\n   191\t\t\tif r.accessLog != nil {\r\n   192\t\t\t\tr.accessLog.Log(accesslog.Entry{\r\n   193\t\t\t\t\tService:    service,\r\n   194\t\t\t\t\tClient:     clientAddr,\r\n   195\t\t\t\t\tEndpoint:   endpoint,\r\n   196\t\t\t\t\tBytesIn:    bytesIn,\r\n   197\t\t\t\t\tBytesOut:   bytesOut,\r\n   198\t\t\t\t\tDurationMs: time.Since(start).Milliseconds(),\r\n   199\t\t\t\t\tResult:     result,\r\n   200\t\t\t\t})\r\n   201\t\t\t}\r\n   202\t\t}()\r\n   203\t\r\n   204\t\tss := r.state.GetService(service)\r\n   205\t\tif ss == nil {\r\n   206\t\t\tresult = \"rejected_no_endpoint\"\r\n   207\t\t\tclient.Close()\r\n   208\t\t\treturn\r\n   209\t"]
[9511.646229, "o", "\t}\r\n   210\t\r\n   211\t\tallowed, queued := ss.AcquireRateLimitToken()\r\n   212\t\tif !allowed {\r\n   213\t\t\tresult = \"rejected_rate_limit\"\r\n   214\t\t\tclient.Close()\r\n   215\t\t\treturn\r\n   216\t\t}\r\n   217\t\tif queued {\r\n"]
[9511.646319, "o", "   218\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   219\t\t\t\tcand.Stats.RecordQueued()\r\n   220\t\t\t}\r\n   221\t\t}\r\n   222\t\r\n   223\t\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\r\n   224\t\tvar lastEndpoint *state.EndpointState\r\n   225\t\tfor attempt := 0; ; attempt++ {\r\n   226\t\t\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\r\n   227\t\t\tif err != nil {\r\n   228\t\t\t\tresult = \"rejected_no_endpoint\"\r\n   229\t\t\t\tendpoint = \"\"\r\n   230\t\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   231\t\t\t\t\tss := r.state.GetService(service)\r\n   232\t\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n   233\t\t\t\t\t\tcand.Stats.RecordRejection()\r\n   234\t\t\t\t\t}\r\n   235\t\t\t\t}\r\n   236\t\t\t\tclient.Close()\r\n   237\t\t\t\treturn\r\n   238\t\t\t}\r\n   239\t\t\tlastEndpoint = res.Endpoint\r\n"]
[9511.646396, "o", "   240\t\t\tep := res.Endpoint\r\n   241\t\t\tendpoint = ep.Address\r\n   242\t\r\n   243\t\t\tvar id int64\r\n   244\t\t\tif !res.Probe {\r\n   245\t\t\t\tvar ok bool\r\n   246\t\t\t\tid, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\r\n   247\t\t\t\tif !ok {\r\n   248"]
[9511.646427, "o", "\t\t\t\t\tresult = \"rejected_conn_limit\"\r\n   249\t\t\t\t\tep.Stats.RecordRejection()\r\n   250\t\t\t\t\tclient.Close()\r\n   251\t\t\t\t\treturn\r\n   252\t\t\t\t}\r\n   253\t\t\t}\r\n   254\t\r\n   255\t\t\tbackend, derr := net.Dial(\"tcp\", ep.Address)\r\n   256\t\t\tif derr != nil {\r\n   257\t\t\t\tif id != 0 {\r\n   258\t\t\t\t\tep.RemoveConnection(id)\r\n   259\t\t\t\t}\r\n   260\t\t\t\tep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n   261\t\t\t\tif res.Probe {\r\n   262\t\t\t\t\tep.Circuit.ProbeFailure()\r\n   263\t\t\t\t} else {\r\n   264\t\t\t\t\tep.Circuit.Open()\r\n   265\t\t\t\t}\r\n   266\t\t\t\tif attempt >= maxRetries {\r\n"]
[9511.646625, "o", "   267\t\t\t\t\tresult = \"retry_exhausted\"\r\n   268\t\t\t\t\tclient.Close()\r\n   269\t\t\t\t\treturn\r\n   270\t\t\t\t}\r\n   271\t\t\t\tep.Stats.RecordRetry()\r\n   272\t\t\t\tr.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\r\n   273\t\t\t\tcontinue\r\n   274\t\t\t}\r\n   275\t\r\n   276\t\t\tif res.Probe {\r\n   277\t\t\t\tep.Circuit.ProbeSuccess()\r\n   278\t\t\t\tvar ok bool\r\n   279\t\t\t\tid, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\r\n   280\t\t\t\tif !ok {\r\n"]
