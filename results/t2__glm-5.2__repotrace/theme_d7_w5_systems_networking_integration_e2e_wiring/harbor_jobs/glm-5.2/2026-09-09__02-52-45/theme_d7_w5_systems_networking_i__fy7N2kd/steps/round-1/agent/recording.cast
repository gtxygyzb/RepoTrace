[5322.055162, "o", "\u001b[?2004l\r"]
[5322.058967, "o", "   136\tfunc selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\r\n   137\t\tsort.SliceStable(eps, func(i, j int) bool {\r\n   138\t\t\tai := eps[i].Active()\r\n   139\t\t\taj := eps[j].Active()\r\n   140\t\t\tif ai != aj {\r\n   141\t\t\t\treturn ai < aj\r\n"]
[5322.05906, "o", "   142\t\t\t}\r\n   143\t\t\t// Tie-break by weight (higher weight first), then lexicographic address.\r\n   144\t\t\twi := eps[i].Weight\r\n   145\t\t\twj := eps[j].Weight\r\n   146\t\t\tif wi != wj {\r\n   147\t\t\t\treturn wi > wj\r\n   148\t\t\t}\r\n   149\t\t\treturn eps[i].Address < eps[j].Address\r\n   150\t\t})\r\n"]
[5322.059637, "o", "\u001b[?2004h"]
[5322.059729, "o", "root@n30009:/app# "]
