[10862.166531, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[10862.166625, "o", "\t\"net\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\ntype request struct {\r\n\tCmd  string          `json:\"cmd\"`\r\n\tArgs json.RawMessage `json:\"args\"`\r\n}\r\n\r\ntype response struct {\r\n\tStatus string          `json:\"status\"`\r\n\tData   json.RawMessage `json:\"data\"`\r\n}\r\n\r\nfunc main() {\r\n"]
[10862.166706, "o", "\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl <command> [args]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcliCmd := os.Args[1]\r\n\targs := make(map[string]interface{})\r\n\tvar ipcCmd string\r\n\r\n\tswitch cliCmd {\r\n\tcase \"status\":\r\n\t\tipcCmd = \"list_services\"\r\n\tcase \"stats\":\r\n"]
[10862.166774, "o", "\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_stats\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"set-weight\":\r\n\t\tif len(os.Args) < 5 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")\r\n"]
[10862.166836, "o", "\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tweight, err := strconv.Atoi(os.Args[4])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid weight: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"set_weight\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n"]
[10862.166895, "o", "\t\targs[\"address\"] = os.Args[3]\r\n\t\targs[\"weight\"] = weight\r\n\tcase \"drain\":\r\n\t\tif len(os.Args) < 4 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t"]
[10862.166956, "o", "\tipcCmd = \"drain_endpoint\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\targs[\"address\"] = os.Args[3]\r\n\tcase \"health-log\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\r\n\t\t\tos.Exit(1)\r\n\t"]
[10862.167015, "o", "\t}\r\n\t\tipcCmd = \"get_health_log\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\tlast := 20\r\n\t\tfor _, a := range os.Args[3:] {\r\n\t\t\tif strings.HasPrefix(a, \"--last\") && len(a) > 6 {\r\n\t\t\t\tif v, err := strconv.Atoi(a[6:]); err == nil {\r\n\t\t\t\t\tlast = v\r\n\t\t\t\t}\r\n"]
[10862.167071, "o", "\t\t\t}\r\n\t\t}\r\n\t\targs[\"last_n\"] = last\r\n\tcase \"resolve\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl resolve <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\t"]
[10862.167131, "o", "ipcCmd = \"resolve\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"circuits\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_circuit_breakers\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t"]
[10862.167187, "o", "case \"reset-circuit\":\r\n\t\tif len(os.Args) < 4 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl reset-circuit <service> <endpoint>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"reset_circuit_breaker\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\t"]
[10862.167249, "o", "args[\"address\"] = os.Args[3]\r\n\tcase \"reload\":\r\n\t\tipcCmd = \"reload_config\"\r\n\tcase \"rate-limit\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl rate-limit <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_rate_limit_status\"\r\n"]
[10862.167305, "o", "\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"warmup\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl warmup <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_warmup_status\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n"]
[10862.167367, "o", "\tcase \"connections\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl connections <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_connections\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"set-rate-limit\":\r\n\t\tif len(os.Args) < 5 {\r\n"]
[10862.167448, "o", "\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-rate-limit <service> <rps> <burst>\")\r\n\t\t\tos.Exit(1)\r\n"]
