[10666.643809, "o", "package stats\r\n\r\nimport (\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\ntype entry struct {\r\n\ttimestamp time.Time\r\n\tbytesIn   int64\r\n\tbytesOut  int64\r\n\tlatency   time.Duration\r\n\terr       bool\r\n}\r\n\r\n// Collector keeps rolling connection statistics for one endpoint.\r\ntype Collector struct {\r\n\tmu         sync.Mutex\r\n\twindow     time.Duration\r\n\tentries    []entry\r\n\trejections []time.Time\r\n\r\n\trateLimited    int\r\n\tqueued         int\r\n\tqueueTimeouts  int"]
[10666.643882, "o", "\r\n\tretries        int\r\n\tretrySuccesses int\r\n\tidleTimeouts   int\r\n}\r\n\r\n// New creates a collector with the given window length.\r\nfunc New(window time.Duration) *Collector {\r\n\tif window <= 0 {\r\n\t\twindow = time.Minute\r\n\t}\r\n\treturn &Collector{window: window}\r\n}\r\n\r\n// RecordConnection records a finished connection attempt.\r\nfunc (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\r\n\tc.trim(now)\r\n}\r\n\r\n// RecordRejection records a rejected connection because the endpoint was at capacity.\r\nfunc (c *Collector) RecordRejection() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tc.rejections = append(c.rejections, now)\r\n\tc.trim(now)\r\n}\r\n\r\n// RecordRateLimited records a rate limit rejection.\r\nfunc (c *Collector) RecordRateLimited() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.rateLimited++\r\n}\r\n\r\n// Rec"]
[10666.643953, "o", "ordQueued records a connection that was queued waiting for a token.\r\nfunc (c *Collector) RecordQueued() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.queued++\r\n}\r\n\r\n// RecordQueueTimeout records a queue timeout rejection.\r\nfunc (c *Collector) RecordQueueTimeout() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.queueTimeouts++\r\n\tc.rateLimited++\r\n}\r\n\r\n// RecordRetry records a retry attempt.\r\nfunc (c *Collector) RecordRetry() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.retries++\r\n}\r\n\r\n// RecordRetrySuccess records a successful retry attempt.\r\nfunc (c *Collector) RecordRetrySuccess() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.retrySuccesses++\r\n}\r\n\r\n// RecordIdleTimeout records a connection that was closed because it was idle.\r\nfunc (c *Collector) RecordIdleTimeout() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.idleTimeouts++\r\n}\r\n\r\nfunc (c *Collector) trim(now time.Time) {\r\n\tcutoff := now.Add(-c.window)\r\n\ti := 0\r\n\tfor i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {\r\n"]
[10666.644014, "o", "\t\ti++\r\n\t}\r\n\tif i > 0 {\r\n\t\tc.entries = c.entries[i:]\r\n\t}\r\n\tj := 0\r\n\tfor j < len(c.rejections) && c.rejections[j].Before(cutoff) {\r\n\t\tj++\r\n\t}\r\n\tif j > 0 {\r\n\t\tc.rejections = c.rejections[j:]\r\n\t}\r\n}\r\n\r\n// Snapshot returns current windowed stats. active is supplied by the state manager.\r\nfunc (c *Collector) Snapshot(active int) Snapshot {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tcutoff := now.Add(-c.window)\r\n\tvar total int\r\n\tvar bytesIn, bytesOut int64\r\n\tvar latencySum time.Duration\r\n\tvar errors int\r\n\t"]
[10666.64407, "o", "for _, e := range c.entries {\r\n\t\tif e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {\r\n\t\t\ttotal++\r\n\t\t\tbytesIn += e.bytesIn\r\n\t\t\tbytesOut += e.bytesOut\r\n\t\t\tlatencySum += e.latency\r\n\t\t\tif e.err {\r\n\t\t\t\terrors++\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\trejected := 0\r\n\tfor _, t := range c.rejections {\r\n\t\tif t.After(cutoff) || t.Equal(cutoff) {\r\n\t\t\trejected++\r\n\t\t}\r\n\t}\r\n\t"]
[10666.644121, "o", "var avg float64\r\n\tif total > 0 {\r\n\t\tavg = float64(latencySum.Milliseconds()) / float64(total)\r\n\t}\r\n\treturn Snapshot{\r\n\t\tTotalConnections:    total,\r\n\t\tActiveConnections:   active,\r\n\t\tBytesIn:             bytesIn,\r\n\t\tBytesOut:            bytesOut,\r\n\t\tAvgLatencyMs:        avg,\r\n\t\tErrors:              errors,\r\n\t\tRejectedConnections: rejected,\r\n\t\tRateLimited:         c.rateLimited,\r\n\t\tQueued:              c.queued,\r\n\t\tQueueTimeouts:       c.queueTimeouts,\r\n\t\tRetries:             c.retries,\r\n\t"]
[10666.644177, "o", "\tRetrySuccesses:      c.retrySuccesses,\r\n\t\tIdleTimeouts:        c.idleTimeouts,\r\n\t}\r\n}\r\n\r\n// Snapshot is a JSON-friendly stats view.\r\ntype Snapshot struct {\r\n\tTotalConnections    int     `json:\"total_connections\"`\r\n\tActiveConnections   int     `json:\"active_connections\"`\r\n\tBytesIn             int64   `json:\"bytes_in\"`\r\n\tBytesOut            int64   `json:\"bytes_out\"`\r\n\tAvgLatencyMs        float64 `json:\"avg_latency_ms\"`\r\n\tErrors              int     `json:\"errors\"`\r\n\tRejectedConnections int     `json:\"rejected_connections\"`\r\n\tRateLimited         int     `json:\"rate_limited\"`\r\n\tQueued              int     `json:\"queued\"`\r\n\tQueueTimeouts       int     `json:\"queue_timeouts\"`\r\n\tRetries             int     `json:\"retries\"`\r\n\tRetrySuccesses      int     `json:\"retry_successes\"`\r\n\tIdleTimeouts        int     `json:\"idle_timeouts\"`\r\n}\r\n"]
