[11767.938794, "o", "> "]
[11767.939133, "o", "    s = s.replace('func sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {', '''func depsAll() (string, error) {\r\n\u001b[?2004l\r"]
[11767.93919, "o", "\u001b[?2004h> "]
[11767.939294, "o", "        raw, err := sendRaw(\"list_services\", nil)\r\n\u001b[?2004l\r"]
