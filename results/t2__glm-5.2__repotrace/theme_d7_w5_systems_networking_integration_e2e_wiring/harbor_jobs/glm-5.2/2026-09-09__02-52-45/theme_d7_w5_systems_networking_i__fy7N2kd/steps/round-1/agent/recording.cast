[1047.810494, "o", "cat > internal/router/router.go <<'EOF'\r\n\u001b[?2004l\r"]
[1047.810578, "o", "\u001b[?2004h"]
[1047.810653, "o", "> "]
[1047.810724, "o", "package router\r\n\u001b[?2004l\r"]
[1047.810788, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1047.810844, "o", "\u001b[?2004h> "]
[1047.810913, "o", "import (\r\n\u001b[?2004l\r"]
[1047.810972, "o", "\u001b[?2004h> "]
[1047.81105, "o", "    \"io\"\r\n\u001b[?2004l\r"]
[1047.81111, "o", "\u001b[?2004h> "]
[1047.811188, "o", "    \"log\"\r\n\u001b[?2004l\r"]
[1047.811245, "o", "\u001b[?2004h"]
[1047.811299, "o", "> "]
[1047.811354, "o", "    \"net\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.811455, "o", ">     \"sync\"\r\n\u001b[?2004l\r"]
[1047.81151, "o", "\u001b[?2004h> "]
[1047.811597, "o", "    \"time\"\r\n\u001b[?2004l\r"]
[1047.811664, "o", "\u001b[?2004h> \r\n"]
[1047.811723, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1047.811972, "o", "    \"meshrouter/internal/state\"\r\n\u001b[?2004l\r"]
[1047.812033, "o", "\u001b[?2004h> )\r\n"]
[1047.812089, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1047.812144, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.812198, "o", "> "]
[1047.81238, "o", "type serviceListener struct {\r\n\u001b[?2004l\r"]
[1047.812453, "o", "\u001b[?2004h> "]
[1047.812595, "o", "    service  string\r\n\u001b[?2004l\r"]
[1047.812651, "o", "\u001b[?2004h> "]
[1047.812767, "o", "    port     int\r\n\u001b[?2004l\r"]
[1047.812831, "o", "\u001b[?2004h> "]
[1047.813009, "o", "    listener net.Listener\r\n\u001b[?2004l\r"]
[1047.813057, "o", "\u001b[?2004h> "]
[1047.813255, "o", "    stop     chan struct{}\r\n\u001b[?2004l\r"]
[1047.813315, "o", "\u001b[?2004h> "]
[1047.813514, "o", "    wg       sync.WaitGroup\r\n\u001b[?2004l\r"]
[1047.813576, "o", "\u001b[?2004h> "]
[1047.813781, "o", "    done     chan struct{}\r\n\u001b[?2004l\r"]
[1047.813846, "o", "\u001b[?2004h> }"]
[1047.813903, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.813958, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.814013, "o", "> "]
[1047.814154, "o", "type Router struct {\r\n\u001b[?2004l\r"]
[1047.814215, "o", "\u001b[?2004h> "]
[1047.814403, "o", "    state     *state.State\r\n\u001b[?2004l\r"]
[1047.814459, "o", "\u001b[?2004h> "]
[1047.814651, "o", "    mu        sync.Mutex\r\n\u001b[?2004l\r"]
[1047.81471, "o", "\u001b[?2004h> "]
[1047.815044, "o", "    listeners map[string]*serviceListener\r\n\u001b[?2004l\r"]
[1047.815102, "o", "\u001b[?2004h> "]
[1047.815168, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.81524, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.815557, "o", "func NewRouter(s *state.State) *Router {\r\n\u001b[?2004l\r"]
[1047.815622, "o", "\u001b[?2004h> "]
[1047.81575, "o", "    return &Router{\r\n\u001b[?2004l\r"]
[1047.815801, "o", "\u001b[?2004h> "]
[1047.815967, "o", "        state:     s,\r\n\u001b[?2004l\r"]
[1047.816018, "o", "\u001b[?2004h> "]
[1047.816411, "o", "        listeners: make(map[string]*serviceListener),\r\n\u001b[?2004l\r"]
[1047.816473, "o", "\u001b[?2004h> "]
[1047.81654, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.816602, "o", "> }\r\n\u001b[?2004l\r"]
[1047.816664, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.816727, "o", "> "]
[1047.816894, "o", "func (r *Router) Start() {\r\n\u001b[?2004l\r"]
[1047.816956, "o", "\u001b[?2004h> "]
[1047.817267, "o", "    for _, ss := range r.state.Services() {\r\n\u001b[?2004l\r"]
[1047.817331, "o", "\u001b[?2004h> "]
[1047.817548, "o", "        if !ss.IsStopping() {\r\n\u001b[?2004l\r"]
[1047.817613, "o", "\u001b[?2004h> "]
[1047.817815, "o", "            r.startService(ss)\r\n\u001b[?2004l\r"]
[1047.817845, "o", "\u001b[?2004h"]
[1047.818079, "o", "> "]
[1047.818172, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1047.818251, "o", "\u001b[?2004h> "]
[1047.818452, "o", "func (r *Router) Reload() {\r\n\u001b[?2004l\r"]
[1047.818516, "o", "\u001b[?2004h> "]
[1047.818746, "o", "    services := r.state.Services()\r\n\u001b[?2004l\r"]
[1047.818804, "o", "\u001b[?2004h> "]
[1047.819034, "o", "    seen := make(map[string]bool)\r\n\u001b[?2004l\r"]
[1047.819094, "o", "\u001b[?2004h> "]
[1047.81933, "o", "    for _, ss := range services {\r\n\u001b[?2004l\r"]
[1047.819386, "o", "\u001b[?2004h> "]
[1047.819597, "o", "        seen[ss.Name] = true\r\n\u001b[?2004l\r"]
[1047.819656, "o", "\u001b[?2004h> "]
[1047.819812, "o", "        r.mu.Lock()\r\n\u001b[?2004l\r"]
[1047.819875, "o", "\u001b[?2004h> "]
[1047.820159, "o", "        sl, ok := r.listeners[ss.Name]\r\n\u001b[?2004l\r"]
[1047.820216, "o", "\u001b[?2004h> "]
[1047.820373, "o", "        r.mu.Unlock()\r\n\u001b[?2004l\r"]
[1047.820436, "o", "\u001b[?2004h> "]
[1047.820554, "o", "        if !ok {\r\n\u001b[?2004l\r"]
[1047.820617, "o", "\u001b[?2004h> "]
[1047.820845, "o", "            if !ss.IsStopping() {\r\n\u001b[?2004l\r"]
[1047.820908, "o", "\u001b[?2004h> "]
[1047.82115, "o", "                r.startService(ss)\r\n\u001b[?2004l\r"]
[1047.821205, "o", "\u001b[?2004h> "]
[1047.821303, "o", "            }\r\n\u001b[?2004l\r"]
[1047.821365, "o", "\u001b[?2004h> "]
[1047.821517, "o", "            continue\r\n"]
[1047.821572, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1047.821655, "o", "        }\r\n\u001b[?2004l\r"]
[1047.82172, "o", "\u001b[?2004h> "]
[1047.821989, "o", "        if sl.port != ss.ListenPort {\r\n\u001b[?2004l\r"]
[1047.822055, "o", "\u001b[?2004h> "]
[1047.822321, "o", "            r.stopService(ss.Name, true)\r\n\u001b[?2004l\r"]
[1047.822377, "o", "\u001b[?2004h> "]
[1047.8226, "o", "            r.startService(ss)\r\n\u001b[?2004l\r"]
[1047.822657, "o", "\u001b[?2004h> "]
[1047.822729, "o", "        }\r\n\u001b[?2004l\r"]
[1047.822787, "o", "\u001b[?2004h> "]
[1047.82284, "o", "    }\r\n\u001b[?2004l\r"]
[1047.822894, "o", "\u001b[?2004h> "]
[1047.82301, "o", "    r.mu.Lock()\r\n\u001b[?2004l\r"]
[1047.823065, "o", "\u001b[?2004h> "]
[1047.82331, "o", "    for name := range r.listeners {\r\n\u001b[?2004l\r"]
[1047.823366, "o", "\u001b[?2004h> "]
[1047.823586, "o", "        if !seen[name] {\r\n\u001b[?2004l\r"]
[1047.823666, "o", "\u001b[?2004h> "]
[1047.82384, "o", "            r.mu.Unlock()\r\n\u001b[?2004l\r"]
[1047.823895, "o", "\u001b[?2004h> "]
[1047.82417, "o", "            r.stopService(name, true)\r\n\u001b[?2004l\r"]
[1047.824232, "o", "\u001b[?2004h> "]
[1047.8244, "o", "            r.mu.Lock()\r\n\u001b[?2004l\r"]
[1047.824455, "o", "\u001b[?2004h> "]
[1047.824544, "o", "        }\r\n\u001b[?2004l\r"]
[1047.8246, "o", "\u001b[?2004h> "]
[1047.824654, "o", "    }\r\n\u001b[?2004l\r"]
[1047.824712, "o", "\u001b[?2004h> "]
[1047.824853, "o", "    r.mu.Unlock()\r\n\u001b[?2004l\r"]
[1047.824918, "o", "\u001b[?2004h"]
[1047.824983, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.825038, "o", "> \r\n\u001b[?2004l\r"]
[1047.825092, "o", "\u001b[?2004h> "]
[1047.825406, "o", "func (r *Router) startService(ss *state.ServiceState) {\r\n\u001b[?2004l\r"]
[1047.825463, "o", "\u001b[?2004h> "]
[1047.825666, "o", "    addr := \":\" + intToStr(ss.ListenPort)\r\n\u001b[?2004l\r"]
[1047.825725, "o", "\u001b[?2004h> "]
[1047.82593, "o", "    ln, err := net.Listen(\"tcp\", addr)\r\n\u001b[?2004l\r"]
[1047.825984, "o", "\u001b[?2004h> "]
[1047.826082, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1047.826137, "o", "\u001b[?2004h> "]
[1047.826552, "o", "        log.Printf(\"router: listen %s on %s failed: %v\", ss.Name, addr, err)\r\n\u001b[?2004l\r"]
[1047.826609, "o", "\u001b[?2004h> "]
[1047.826672, "o", "        return\r\n\u001b[?2004l\r"]
[1047.826726, "o", "\u001b[?2004h> "]
[1047.826783, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.82694, "o", "    sl := &serviceListener{\r\n\u001b[?2004l\r"]
[1047.827001, "o", "\u001b[?2004h> "]
[1047.827133, "o", "        service:  ss.Name,\r\n\u001b[?2004l\r"]
[1047.8272, "o", "\u001b[?2004h> "]
[1047.827374, "o", "        port:     ss.ListenPort,\r\n\u001b[?2004l\r"]
[1047.827445, "o", "\u001b[?2004h> "]
[1047.827547, "o", "        listener: ln,\r\n\u001b[?2004l\r"]
[1047.827602, "o", "\u001b[?2004h> "]
[1047.827807, "o", "        stop:     make(chan struct{}),\r\n\u001b[?2004l\r"]
[1047.827862, "o", "\u001b[?2004h> "]
[1047.828067, "o", "        done:     make(chan struct{}),\r\n\u001b[?2004l\r"]
[1047.82812, "o", "\u001b[?2004h> "]
[1047.828175, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.828271, "o", "    r.mu.Lock()\r\n\u001b[?2004l\r"]
[1047.828326, "o", "\u001b[?2004h> "]
[1047.82849, "o", "    r.listeners[ss.Name] = sl\r\n\u001b[?2004l\r"]
[1047.828546, "o", "\u001b[?2004h> "]
[1047.82863, "o", "    r.mu.Unlock()\r\n\u001b[?2004l\r"]
[1047.828683, "o", "\u001b[?2004h> "]
[1047.828802, "o", "    go sl.acceptLoop(r)\r\n\u001b[?2004l\r"]
[1047.828861, "o", "\u001b[?2004h> "]
[1047.828917, "o", "}\r\n\u001b[?2004l\rg\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h"]
[1047.828971, "o", "> "]
[1047.829277, "o", "func (r *Router) stopService(name string, drain bool) {\r\n\u001b[?2004l\r"]
[1047.829339, "o", "\u001b[?2004h> "]
[1047.829407, "o", "    r.mu.Lock()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.829463, "o", "> "]
[1047.829556, "o", "    sl, ok := r.listeners[name]\r\n\u001b[?2004l\r"]
[1047.829585, "o", "\u001b[?2004h> "]
[1047.829656, "o", "    if ok {\r\n\u001b[?2004l\r"]
[1047.82971, "o", "\u001b[?2004h> "]
[1047.82984, "o", "        delete(r.listeners, name)\r\n\u001b[?2004l\r"]
[1047.829895, "o", "\u001b[?2004h> "]
[1047.82995, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.830033, "o", "    r.mu.Unlock()\r\n\u001b[?2004l\r"]
[1047.830087, "o", "\u001b[?2004h> "]
[1047.830144, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[1047.830199, "o", "\u001b[?2004h> "]
[1047.830256, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.83031, "o", ">     }\r\n\u001b[?2004l\r"]
[1047.830364, "o", "\u001b[?2004h> "]
[1047.830473, "o", "    sl.stopAccept(drain, r)\r\n\u001b[?2004l\r"]
[1047.830528, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1047.830587, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.83064, "o", "> "]
[1047.830718, "o", "func (r *Router) Stop() {\r\n\u001b[?2004l\r"]
[1047.830771, "o", "\u001b[?2004h> "]
[1047.830826, "o", "    r.mu.Lock()\r\n\u001b[?2004l\r"]
[1047.83088, "o", "\u001b[?2004h> "]
[1047.830985, "o", "    listeners := r.listeners\r\n\u001b[?2004l\r"]
[1047.831039, "o", "\u001b[?2004h> "]
[1047.831237, "o", "    r.listeners = make(map[string]*serviceListener)\r\n\u001b[?2004l\r"]
[1047.831291, "o", "\u001b[?2004h> "]
[1047.831354, "o", "    r.mu.Unlock()\r\n\u001b[?2004l\r"]
[1047.831415, "o", "\u001b[?2004h> "]
[1047.831507, "o", "    var wg sync.WaitGroup\r\n\u001b[?2004l\r"]
[1047.831547, "o", "\u001b[?2004h> "]
[1047.831706, "o", "    for name, sl := range listeners {\r\n\u001b[?2004l\r"]
[1047.831761, "o", "\u001b[?2004h> "]
[1047.831833, "o", "        wg.Add(1)\r\n\u001b[?2004l\r"]
[1047.831887, "o", "\u001b[?2004h> "]
[1047.832091, "o", "        go func(name string, sl *serviceListener) {\r\n\u001b[?2004l\r"]
[1047.83215, "o", "\u001b[?2004h> "]
[1047.832242, "o", "            defer wg.Done()\r\n\u001b[?2004l\r"]
[1047.832296, "o", "\u001b[?2004h> "]
[1047.832432, "o", "            sl.stopAccept(true, r)\r\n\u001b[?2004l\r"]
[1047.832485, "o", "\u001b[?2004h> "]
[1047.832556, "o", "        }(name, sl)\r\n\u001b[?2004l\r"]
[1047.832609, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1047.832663, "o", "\u001b[?2004h> "]
[1047.832722, "o", "    wg.Wait()\r\n\u001b[?2004l\r"]
[1047.832776, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1047.832829, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.832883, "o", "> "]
[1047.833065, "o", "func (sl *serviceListener) acceptLoop(r *Router) {\r\n\u001b[?2004l\r"]
[1047.833128, "o", "\u001b[?2004h> "]
[1047.833236, "o", "    defer close(sl.done)\r\n\u001b[?2004l\r"]
[1047.833311, "o", "\u001b[?2004h>     for {\r\n\u001b[?2004l\r"]
[1047.833396, "o", "\u001b[?2004h> "]
[1047.833535, "o", "        conn, err := sl.listener.Accept()\r\n\u001b[?2004l\r"]
[1047.83359, "o", "\u001b[?2004h> "]
[1047.833677, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[1047.833757, "o", "\u001b[?2004h> "]
[1047.833814, "o", "            return\r\n\u001b[?2004l\r"]
[1047.833869, "o", "\u001b[?2004h> "]
[1047.833923, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.834022, "o", "        sl.wg.Add(1)\r\n\u001b[?2004l\r"]
[1047.834075, "o", "\u001b[?2004h> "]
[1047.834187, "o", "        go func(c net.Conn) {\r\n\u001b[?2004l\r"]
[1047.834248, "o", "\u001b[?2004h> "]
[1047.834369, "o", "            defer sl.wg.Done()\r\n\u001b[?2004l\r"]
[1047.834432, "o", "\u001b[?2004h> "]
[1047.834595, "o", "            r.handleConn(sl.service, c)\r\n\u001b[?2004l\r"]
[1047.834649, "o", "\u001b[?2004h> "]
[1047.834706, "o", "        }(conn)\r\n\u001b[?2004l\r"]
[1047.834759, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1047.834818, "o", "\u001b[?2004h> "]
[1047.834872, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1047.834927, "o", "\u001b[?2004h> "]
[1047.835183, "o", "func (sl *serviceListener) stopAccept(drain bool, r *Router) {\r\n\u001b[?2004l\r"]
[1047.835247, "o", "\u001b[?2004h> "]
[1047.835319, "o", "    select {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.835412, "o", "    case <-sl.stop:\r\n\u001b[?2004l\r"]
[1047.835467, "o", "\u001b[?2004h> "]
[1047.835525, "o", "    default:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.835553, "o", "> "]
[1047.835641, "o", "        close(sl.stop)\r\n\u001b[?2004l\r"]
[1047.835697, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1047.83577, "o", "\u001b[?2004h> "]
[1047.835845, "o", "    sl.listener.Close()\r\n\u001b[?2004l\r"]
[1047.835899, "o", "\u001b[?2004h> "]
[1047.835956, "o", "    <-sl.done\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.83601, "o", ">     if drain {\r\n\u001b[?2004l\r"]
[1047.836071, "o", "\u001b[?2004h> "]
[1047.836174, "o", "        ss := r.state.GetService(sl.service)\r\n\u001b[?2004l\r"]
[1047.836229, "o", "\u001b[?2004h> "]
[1047.836294, "o", "        timeout := 5 * time.Second\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.836349, "o", "> "]
[1047.836417, "o", "        if ss != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.836609, "o", "            timeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n\u001b[?2004l\r"]
[1047.836665, "o", "\u001b[?2004h> "]
[1047.836725, "o", "            if timeout <= 0 {\r\n\u001b[?2004l\r"]
[1047.83678, "o", "\u001b[?2004h> "]
[1047.836856, "o", "                timeout = 5 * time.Second\r\n\u001b[?2004l\r"]
[1047.836911, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[1047.836969, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1047.837024, "o", "\u001b[?2004h> "]
[1047.837105, "o", "        done := make(chan struct{})\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.837184, "o", ">         go func() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.837259, "o", ">             sl.wg.Wait()\r\n\u001b[?2004l\r"]
[1047.837336, "o", "\u001b[?2004h> "]
[1047.837404, "o", "            close(done)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.837488, "o", "        }()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.837547, "o", "        select {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.837602, "o", "        case <-done:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.837706, "o", "        case <-time.After(timeout):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.83776, "o", "> "]
[1047.837878, "o", "            r.state.CloseServiceConnections(sl.service)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.83794, "o", "> "]
[1047.837994, "o", "            <-done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.838049, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.838108, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.838174, "o", "        sl.wg.Wait()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.838199, "o", "    }\r\n\u001b[?2004l\r"]
[1047.83822, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1047.838317, "o", "\u001b[?2004h> \r\n"]
[1047.838374, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1047.838463, "o", "func (r *Router) handleConn(service string, client net.Conn) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.838554, "o", "    start := time.Now()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.838611, "o", "> "]
[1047.838711, "o", "    res, err := r.state.SelectEndpoint(service)\r\n\u001b[?2004l\r"]
[1047.838767, "o", "\u001b[?2004h> "]
[1047.838822, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1047.838878, "o", "\u001b[?2004h> "]
[1047.839011, "o", "        if cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n\u001b[?2004l\r"]
[1047.839065, "o", "\u001b[?2004h> "]
[1047.839159, "o", "            ss := r.state.GetService(service)\r\n\u001b[?2004l\r"]
[1047.839214, "o", "\u001b[?2004h> "]
[1047.839396, "o", "            if ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.839455, "o", "> "]
[1047.839536, "o", "                cand.Stats.RecordRejection()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.839593, "o", ">             }\r\n\u001b[?2004l\r"]
[1047.839647, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1047.839701, "o", "\u001b[?2004h> "]
[1047.83976, "o", "        client.Close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.839815, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.83987, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.839956, "o", "    ep := res.Endpoint\r\n\u001b[?2004l\r"]
[1047.840011, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.840074, "o", "    var id int64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.840143, "o", "    if !res.Probe {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.840197, "o", "> "]
[1047.840251, "o", "        var ok bool\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.840423, "o", "        id, ok = ep.TryAddConnection(client, res.MaxConns)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.840477, "o", ">         if !ok {\r\n\u001b[?2004l\r"]
[1047.840532, "o", "\u001b[?2004h> "]
[1047.84063, "o", "            ep.Stats.RecordRejection()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.840684, "o", "> "]
[1047.840742, "o", "            client.Close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.840809, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.840862, "o", ">         }\r\n\u001b[?2004l\r"]
[1047.840917, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1047.840971, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1047.841093, "o", "    backend, err := net.Dial(\"tcp\", ep.Address)\r\n\u001b[?2004l\r"]
[1047.841147, "o", "\u001b[?2004h> "]
[1047.841212, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.841275, "o", "        if id != 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.841382, "o", "            ep.RemoveConnection(id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.841443, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.841498, "o", "> "]
[1047.84164, "o", "        ep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n\u001b[?2004l\r"]
[1047.841694, "o", "\u001b[?2004h> "]
[1047.841748, "o", "        if res.Probe {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.841857, "o", "            ep.Circuit.ProbeFailure()\r\n\u001b[?2004l\r"]
[1047.84191, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[1047.841965, "o", "\u001b[?2004h> "]
[1047.842034, "o", "        client.Close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.842101, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.842172, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.842227, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     if res.Probe {\r\n\u001b[?2004l\r"]
[1047.842282, "o", "\u001b[?2004h> "]
[1047.84235, "o", "        ep.Circuit.ProbeSuccess()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.842413, "o", "> "]
[1047.842467, "o", "        var ok bool\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.909412, "o", "        id, ok = ep.TryAddConnection(client, res.MaxConns)\r\n\u001b[?2004l\r\u001b[?2004h>         if !ok {\r\n\u001b[?2004l\r\u001b[?2004h>             ep.Stats.RecordRejection()\r\n\u001b[?2004l\r\u001b[?2004h>             backend.Close()\r\n\u001b[?2004l\r\u001b[?2004h>             client.Close()\r\n\u001b[?2004l\r\u001b[?2004h>             return\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     bytesIn, bytesOut := forward(client, backend)\r\n\u001b[?2004l\r\u001b[?2004h>     backend.Close()\r\n\u001b[?2004l\r\u001b[?2004h>     client.Close()\r\n\u001b[?2004l\r\u001b[?2004h>     ep.RemoveConnection(id)\r\n\u001b[?2004l\r\u001b[?2004h>     ep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func forward(client, backend net.Conn) (int64, int64) {\r\n\u001b[?2004l\r\u001b[?2004h>     var bytesIn, bytesOut int64\r\n\u001b[?2004l\r\u001b[?2004h>     var wg sync.WaitGroup\r\n\u001b[?2004l\r\u001b[?2004h>     wg.Add(2)\r\n\u001b[?2004l\r\u001b[?2004h>     go func() {\r\n\u001b[?2004l\r\u001b[?2004h>         defer wg.Done()\r\n\u001b[?2004l\r\u001b[?2004h>         n, _ :="]
[1047.909583, "o", " io.Copy(backend, client)\r\n\u001b[?2004l\r\u001b[?2004h>         bytesOut = n\r\n\u001b[?2004l\r\u001b[?2004h>         backend.Close()\r\n\u001b[?2004l\r\u001b[?2004h>         client.Close()\r\n\u001b[?2004l\r\u001b[?2004h>     }()\r\n\u001b[?2004l\r\u001b[?2004h>     go func() {\r\n\u001b[?2004l\r\u001b[?2004h>         defer wg.Done()\r\n\u001b[?2004l\r\u001b[?2004h>         n, _ := io.Copy(client, backend)\r\n\u001b[?2004l\r\u001b[?2004h>         bytesIn = n\r\n\u001b[?2004l\r\u001b[?2004h>         client.Close()\r\n\u001b[?2004l\r\u001b[?2004h>         backend.Close()\r\n\u001b[?2004l\r\u001b[?2004h>     }()\r\n\u001b[?2004l\r\u001b[?2004h>     wg.Wait()\r\n\u001b[?2004l\r\u001b[?2004h>     return bytesIn, bytesOut\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func intToStr(i int) string {\r\n\u001b[?2004l\r\u001b[?2004h>     if i == 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         return \"0\"\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     var buf [12]byte\r\n\u001b[?2004l\r\u001b[?2004h>     pos := len(buf)\r\n\u001b[?2004l\r\u001b[?2004h>     neg := false\r\n\u001b[?2004l\r\u001b[?2004h>     if i < 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         neg = true\r\n\u001b[?2004l\r\u001b[?2004h>         i = -i\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?200"]
[1047.909657, "o", "4h>     for i > 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         pos--\r\n\u001b[?2004l\r\u001b[?2004h>         buf[pos] = byte('0' + i%10)\r\n\u001b[?2004l\r\u001b[?2004h>         i /= 10\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if neg {\r\n\u001b[?2004l\r\u001b[?2004h>         pos--\r\n\u001b[?2004l\r\u001b[?2004h>         buf[pos] = '-'\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return string(buf[pos:])\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
