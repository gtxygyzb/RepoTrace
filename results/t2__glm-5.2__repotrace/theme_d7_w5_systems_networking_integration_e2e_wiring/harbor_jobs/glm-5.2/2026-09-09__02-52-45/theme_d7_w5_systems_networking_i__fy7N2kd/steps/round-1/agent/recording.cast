[689.411637, "o", "            if eps := m.state.GetEndpoint(service, ep.Address); eps != nil {\r\n\u001b[?2004l\r"]
[689.411694, "o", "\u001b[?2004h> "]
[689.411856, "o", "                eps.Circuit.MaybeHalfOpen()\r\n\u001b[?2004l\r"]
[689.41191, "o", "\u001b[?2004h> "]
[689.411968, "o", "            }\r\n\u001b[?2004l\r"]
[689.412024, "o", "\u001b[?2004h> "]
[689.412088, "o", "            _ = ss\r\n\u001b[?2004l\r"]
[689.412143, "o", "\u001b[?2004h> "]
[689.4122, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.412254, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.412318, "o", "> }\r\n\u001b[?2004l\r"]
[689.412371, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.412657, "o", "func checkEndpoint(ctx context.Context, ep config.Endpoint) bool {\r\n\u001b[?2004l\r"]
[689.412715, "o", "\u001b[?2004h> "]
[689.412817, "o", "    switch ep.HealthCheck {\r\n\u001b[?2004l\r"]
[689.412871, "o", "\u001b[?2004h> "]
[689.412953, "o", "    case \"http\":\r\n\u001b[?2004l\r"]
[689.413008, "o", "\u001b[?2004h> "]
[689.41311, "o", "        return checkHTTP(ctx, ep)\r\n\u001b[?2004l\r"]
[689.413164, "o", "\u001b[?2004h> "]
[689.413225, "o", "    case \"exec\":\r\n\u001b[?2004l\r"]
[689.413279, "o", "\u001b[?2004h> "]
[689.413413, "o", "        return checkExec(ctx, ep)\r\n\u001b[?2004l\r"]
[689.413471, "o", "\u001b[?2004h> "]
[689.413531, "o", "    default:\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.413574, "o", "> "]
[689.413701, "o", "        return checkTCP(ep.Address)\r\n\u001b[?2004l\r"]
[689.413756, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[689.413811, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[689.413871, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[689.41393, "o", "\u001b[?2004h> "]
[689.414057, "o", "func checkTCP(address string) bool {\r\n\u001b[?2004l\r"]
[689.41411, "o", "\u001b[?2004h> "]
[689.414319, "o", "    conn, err := net.DialTimeout(\"tcp\", address, time.Second)\r\n\u001b[?2004l\r"]
[689.414372, "o", "\u001b[?2004h> "]
[689.414445, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.414507, "o", "        return false\r\n\u001b[?2004l\r"]
[689.414562, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.414632, "o", "    conn.Close()\r\n\u001b[?2004l\r"]
[689.41469, "o", "\u001b[?2004h>     return true\r\n\u001b[?2004l\r"]
[689.414749, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.414806, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.414982, "o", "func checkHTTP(ctx context.Context, ep config.Endpoint) bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.415037, "o", "> "]
[689.415098, "o", "    path := ep.HealthPath\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.415167, "o", "    if path == \"\" {\r\n\u001b[?2004l\r"]
[689.415224, "o", "\u001b[?2004h> "]
[689.415278, "o", "        path = \"/\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.415332, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.415495, "o", "    url := fmt.Sprintf(\"http://%s%s\", ep.Address, path)\r\n\u001b[?2004l\r"]
[689.41555, "o", "\u001b[?2004h> "]
[689.415676, "o", "    client := &http.Client{Timeout: 2 * time.Second}\r\n\u001b[?2004l\r"]
[689.41573, "o", "\u001b[?2004h> "]
[689.415892, "o", "    req, err := http.NewRequestWithContext(ctx, \"GET\", url, nil)\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.415946, "o", "> "]
[689.416005, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.41608, "o", "        return false\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.416135, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.416245, "o", "    resp, err := client.Do(req)\r\n\u001b[?2004l\r"]
[689.416298, "o", "\u001b[?2004h> "]
[689.416358, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.416433, "o", "        return false\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.416488, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.416587, "o", "    defer resp.Body.Close()\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.416641, "o", "> "]
[689.416707, "o", "    if resp.StatusCode != 200 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.41676, "o", "> "]
[689.416819, "o", "        return false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.416877, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.416987, "o", "    body, err := io.ReadAll(resp.Body)\r\n\u001b[?2004l\r"]
[689.41704, "o", "\u001b[?2004h> "]
[689.417099, "o", "    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.417162, "o", "        return false\r\n\u001b[?2004l\r"]
[689.41722, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.417428, "o", "    return strings.Contains(strings.ToLower(string(body)), \"ok\")\r\n\u001b[?2004l\r"]
[689.417483, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[689.417546, "o", "\u001b[?2004h> "]
[689.417703, "o", "func checkExec(ctx context.Context, ep config.Endpoint) bool {\r\n\u001b[?2004l\r"]
[689.417757, "o", "\u001b[?2004h> "]
[689.417827, "o", "    if ep.HealthCmd == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.417904, "o", "        return false\r\n\u001b[?2004l\r"]
[689.417957, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.418149, "o", "    c := exec.CommandContext(ctx, \"sh\", \"-c\", ep.HealthCmd)\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.418203, "o", "> "]
[689.418269, "o", "    c.Stdout = io.Discard\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.418353, "o", "    c.Stderr = io.Discard\r\n\u001b[?2004l\r"]
[689.418415, "o", "\u001b[?2004h> "]
[689.4185, "o", "    if err := c.Start(); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.418554, "o", "> "]
[689.41861, "o", "        return false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.418668, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.418752, "o", "    done := make(chan error, 1)\r\n\u001b[?2004l\r"]
[689.418806, "o", "\u001b[?2004h> "]
[689.41886, "o", "    go func() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.418929, "o", "        done <- c.Wait()\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.418987, "o", ">     }()\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.419044, "o", ">     select {\r\n\u001b[?2004l\r"]
[689.4191, "o", "\u001b[?2004h> "]
[689.419193, "o", "    case <-time.After(3 * time.Second):\r\n\u001b[?2004l\r"]
[689.419248, "o", "\u001b[?2004h> "]
[689.419317, "o", "        c.Process.Kill()\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.419382, "o", ">         <-done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.419473, "o", "        return false\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.41953, "o", "> "]
[689.419588, "o", "    case err := <-done:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.419675, "o", "        return err == nil\r\n\u001b[?2004l\r"]
[689.419729, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[689.419787, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.41984, "o", "EOF\r\n\u001b[?2004l\r"]
[689.422697, "o", "\u001b[?2004hroot@n30009:/app# "]
[689.675968, "i", "cat > internal/state/routing.go <<'EOF'\npackage state\n\nimport (\n    \"sort\"\n    \"time\"\n)\n\n// SelectResult contains selected endpoint and whether it is a half-open probe.\ntype SelectResult struct {\n    Endpoint *EndpointState\n    Probe    bool\n}\n\n// SelectEndpoint chooses an endpoint for the next connection.\nfunc (s *State) SelectEndpoint(service string) (SelectResult, error) {\n    ss := s.GetService(service)\n    if ss == nil {\n        return SelectResult{}, errNotFound(\"service not found\")\n    }\n    ss.mu.Lock()\n    maxConns := ss.MaxConnectionsPerEndpoint\n    mode := ss.RoutingMode\n    endpoints := make([]*EndpointState, len(ss.Endpoints))\n    copy(endpoints, ss.Endpoints)\n    ss.mu.Unlock()\n\n    now := time.Now()\n    _ = now\n\n    var regular []*EndpointState\n    for _, ep := range endpoints {\n        ep.mu.Lock()\n        eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n        if eligible {\n            regular = append(regula"]
[689.676204, "i", "r, ep)\n        }\n        ep.mu.Unlock()\n    }\n\n    if len(regular) > 0 {\n        if mode == \"least-connections\" {\n            return SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false}, nil\n        }\n        return SelectResult{Endpoint: selectWeighted(regular), Probe: false}, nil\n    }\n\n    for _, ep := range endpoints {\n        ep.mu.Lock()\n        halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n        ep.mu.Unlock()\n        if halfOpen && ep.Circuit.AcquireProbe() {\n            return SelectResult{Endpoint: ep, Probe: true}, nil\n        }\n    }\n    return SelectResult{}, errNotFound(\"no eligible endpoints\")\n}\n\nfunc selectWeighted(eps []*EndpointState) *EndpointState {\n    var best *EndpointState\n    var bestWeight int\n    var totalWeight int\n    for _, ep := range eps {\n        ep.mu.Lock()\n        ep.currentWeight += ep.Weight\n        totalWeight += ep.Weight\n        cw := ep.currentWeight\n "]
[689.676287, "i", "       w := ep.Weight\n        ep.mu.Unlock()\n        if best == nil || cw > bestWeight {\n            best = ep\n            bestWeight = cw\n        }\n        _ = w\n    }\n    if best != nil {\n        best.mu.Lock()\n        best.currentWeight -= totalWeight\n        best.mu.Unlock()\n    }\n    return best\n}\n\nfunc selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\n    sort.SliceStable(eps, func(i, j int) bool {\n        ai := eps[i].Active()\n        aj := eps[j].Active()\n        if ai != aj {\n            return ai < aj\n        }\n        return eps[i].Address < eps[j].Address\n    })\n    return eps[0]\n}\nEOF\n"]
