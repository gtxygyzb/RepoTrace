[2812.551733, "o", "\u001b[?2004h> "]
[2812.552062, "o", "old = '''func (ss *ServiceState) ReleaseRateLimitToken() {\r\n\u001b[?2004l\r"]
[2812.552109, "o", "\u001b[?2004h> "]
[2812.552214, "o", "\\tss.mu.Lock()\r\n\u001b[?2004l\r"]
[2812.552258, "o", "\u001b[?2004h> "]
