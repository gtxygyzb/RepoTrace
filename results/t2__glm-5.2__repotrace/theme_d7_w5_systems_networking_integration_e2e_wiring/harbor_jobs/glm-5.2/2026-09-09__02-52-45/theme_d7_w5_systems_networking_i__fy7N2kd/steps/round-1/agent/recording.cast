[5756.807922, "o", "   260\t\tout := make([]*ServiceState, 0, len(s.services))\r\n   261\t\tfor _, ss := range s.services {\r\n   262\t\t\tout = append(out, ss)\r\n   263\t\t}\r\n   264\t\treturn out\r\n   265\t}\r\n   266\t\r\n   267\tfunc (s *State) GetEndpoint(service, address string) *EndpointState {\r\n   268\t\tss := s.GetService(service)\r\n   269\t\tif ss == nil {\r\n   270"]
