[4141.75843, "o", "   361\t\r\n   362\tfunc (s *State) RecordHealthCheck(service, address string, success bool) HealthEvent {\r\n   363\t\tss := s.GetService(service)\r\n   364\t\tif ss == nil {\r\n   365\t\t\t"]
[4141.758557, "o", "return HealthEvent{}\r\n   366\t\t}\r\n   367\t\tep := s.GetEndpoint(service, address)\r\n   368\t\tif ep == nil {\r\n   369\t\t\treturn HealthEvent{}\r\n"]
[4141.758623, "o", "   370\t\t}\r\n   371\t\tglobal := s.Global()\r\n   372\t\tep.mu.Lock()\r\n   373\t\toldState := ep.State\r\n   374\t\tresult := \"success\"\r\n   375\t\tif !success {\r\n   376\t\t\tresult = \"failure\"\r\n   377\t\t}\r\n   378\t\tif success {\r\n   379\t\t\tep.consecSuccess++\r\n   380\t\t\tep.consecFailures = 0\r\n   381\t\t\tif oldState == Unknown && ep.consecSuccess >= global.HealthyThreshold {\r\n   382\t\t\t\tep.State = Healthy\r\n   383\t\t\t} else if oldState == Unhealthy && ep.consecSuccess >= global.HealthyThreshold {\r\n   384\t\t\t\tep.State = Healthy\r\n   385\t\t\t}\r\n   386\t\t} else {\r\n   387\t\t\tep.consecFailures++\r\n   388\t\t\tep.consecSuccess = 0\r\n"]
