[11820.611984, "o", "old_send = '''func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n\u001b[?2004l\r"]
[11820.612076, "o", "\u001b[?2004h> "]
[11820.61226, "o", "        rawArgs, err := json.Marshal(args)\r\n\u001b[?2004l\r"]
[11820.612351, "o", "\u001b[?2004h> "]
[11820.612438, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11820.612508, "o", "\u001b[?2004h> "]
[11820.612657, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11820.612744, "o", "\u001b[?2004h> "]
[11820.612834, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.613086, "o", "        req := request{Cmd: ipcCmd, Args: rawArgs}\r\n\u001b[?2004l\r"]
[11820.613147, "o", "\u001b[?2004h> "]
[11820.613349, "o", "        reqBytes, err := json.Marshal(req)\r\n\u001b[?2004l\r"]
[11820.613454, "o", "\u001b[?2004h> "]
[11820.613616, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.613733, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11820.61381, "o", "\u001b[?2004h> "]
[11820.613898, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[11820.613934, "o", "> "]
[11820.614231, "o", "        conn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\u001b[?2004l\r"]
[11820.614317, "o", "\u001b[?2004h> "]
[11820.614426, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11820.614495, "o", "> "]
[11820.61486, "o", "                return \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n\u001b[?2004l\r"]
[11820.614896, "o", "\u001b[?2004h> "]
[11820.614985, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.61514, "o", "        defer conn.Close()\r\n\u001b[?2004l\r"]
[11820.615195, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11820.615249, "o", "\u001b[?2004h> "]
[11820.615528, "o", "        fmt.Fprintf(conn, \"%s\\\\n\", string(reqBytes))\r\n\u001b[?2004l\r"]
[11820.615588, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[11820.615642, "o", "\u001b[?2004h> "]
[11820.615838, "o", "        reader := bufio.NewReader(conn)\r\n\u001b[?2004l\r"]
[11820.615903, "o", "\u001b[?2004h> "]
[11820.616125, "o", "        line, err := reader.ReadString('\\\\n')\r\n\u001b[?2004l\r"]
[11820.616168, "o", "\u001b[?2004h> "]
[11820.61631, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11820.616383, "o", "\u001b[?2004h> "]
[11820.616536, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11820.616605, "o", "\u001b[?2004h> "]
[11820.616683, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.616934, "o", "        line = strings.TrimRight(line, \"\\\\r\\\\n\")\r\n\u001b[?2004l\r"]
[11820.616999, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rf\u001b[?2004h"]
[11820.617077, "o", "> "]
[11820.617157, "o", "        var resp response\r\n\u001b[?2004l\r"]
[11820.617231, "o", "\u001b[?2004h> "]
[11820.617574, "o", "        if err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n\u001b[?2004l\r"]
[11820.61764, "o", "\u001b[?2004h> "]
[11820.617794, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11820.617865, "o", "\u001b[?2004h> "]
[11820.617944, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.618111, "o", "        if resp.Status != \"ok\" {\r\n\u001b[?2004l\r"]
[11820.618181, "o", "\u001b[?2004h> "]
[11820.618313, "o", "                var msg string\r\n\u001b[?2004l\r"]
[11820.618384, "o", "\u001b[?2004h> "]
[11820.618747, "o", "                if err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n\u001b[?2004l\r"]
[11820.618814, "o", "\u001b[?2004h> "]
[11820.619074, "o", "                        return \"\", fmt.Errorf(\"%s\", msg)\r\n\u001b[?2004l\r"]
[11820.61914, "o", "\u001b[?2004h> "]
[11820.619216, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11820.619295, "o", "> "]
[11820.619499, "o", "                return \"\", fmt.Errorf(\"%s\", string(resp.Data))\r\n\u001b[?2004l\r"]
[11820.619565, "o", "\u001b[?2004h> "]
[11820.619641, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.619809, "o", "        return prettyData(ipcCmd, resp.Data)\r\n\u001b[?2004l\r"]
[11820.619852, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11820.619945, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h"]
[11820.620015, "o", "> "]
[11820.620341, "o", "new_send = '''func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n\u001b[?2004l\r"]
[11820.620423, "o", "\u001b[?2004h> "]
[11820.620566, "o", "        data, err := sendRaw(ipcCmd, args)\r\n\u001b[?2004l\r"]
[11820.62063, "o", "\u001b[?2004h> "]
[11820.620708, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11820.620788, "o", "\u001b[?2004h> "]
[11820.620891, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11820.620956, "o", "\u001b[?2004h> "]
[11820.621034, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.621185, "o", "        return prettyData(ipcCmd, data)\r\n\u001b[?2004l\r"]
[11820.621252, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11820.62133, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.621471, "o", "func depsAll() (string, error) {\r\n\u001b[?2004l\r"]
[11820.621559, "o", "\u001b[?2004h> "]
[11820.621721, "o", "        raw, err := sendRaw(\"list_services\", nil)\r\n\u001b[?2004l\r"]
[11820.621786, "o", "\u001b[?2004h> "]
[11820.621864, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11820.621951, "o", "\u001b[?2004h> "]
[11820.622035, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11820.622096, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[11820.622151, "o", "\u001b[?2004h> "]
[11820.62223, "o", "        var services []struct {\r\n\u001b[?2004l\r"]
[11820.622285, "o", "\u001b[?2004h> "]
[11820.622378, "o", "                Name string `json:\"name\"`\r\n\u001b[?2004l\r"]
[11820.622449, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11820.622504, "o", "> "]
[11820.622651, "o", "        if err := json.Unmarshal(raw, &services); err != nil {\r\n\u001b[?2004l\r"]
[11820.622706, "o", "\u001b[?2004h> "]
[11820.622769, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11820.622825, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[11820.622878, "o", "\u001b[?2004h> "]
[11820.622943, "o", "        type depRow struct {\r\n\u001b[?2004l\r"]
[11820.623032, "o", "\u001b[?2004h> "]
[11820.623133, "o", "                Service          string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.623226, "o", "                Name             string\r\n\u001b[?2004l\r"]
[11820.623281, "o", "\u001b[?2004h> "]
[11820.623364, "o", "                Available        bool\r\n\u001b[?2004l\r"]
[11820.623443, "o", "\u001b[?2004h> "]
[11820.623503, "o", "                HealthyEndpoints int\r\n\u001b[?2004l\r"]
[11820.623559, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[11820.623626, "o", "\u001b[?2004h> "]
[11820.623689, "o", "        var rows []depRow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.623808, "o", "        for _, svc := range services {\r\n\u001b[?2004l\r"]
[11820.623863, "o", "\u001b[?2004h> "]
[11820.624119, "o", "                depRaw, err := sendRaw(\"get_dependencies\", map[string]interface{}{\"name\": svc.Name})\r\n\u001b[?2004l\r"]
[11820.624175, "o", "\u001b[?2004h> "]
[11820.624239, "o", "                if err != nil {\r\n\u001b[?2004l\r"]
[11820.624294, "o", "\u001b[?2004h> "]
[11820.624379, "o", "                        return \"\", err\r\n\u001b[?2004l\r"]
