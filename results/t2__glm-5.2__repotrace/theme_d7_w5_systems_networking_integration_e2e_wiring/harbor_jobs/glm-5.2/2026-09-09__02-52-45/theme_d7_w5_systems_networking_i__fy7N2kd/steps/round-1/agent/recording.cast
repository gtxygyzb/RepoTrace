[1148.264171, "o", "\u001b[?2004h> "]
[1148.264245, "o", "    \"os\"\r\n\u001b[?2004l\r"]
[1148.264311, "o", "\u001b[?2004h> "]
[1148.264402, "o", "    \"strconv\"\r\n\u001b[?2004l\r"]
[1148.264438, "o", "\u001b[?2004h> "]
[1148.264632, "o", "    \"strings\"\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[1148.264778, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.264904, "o", "type request struct {\r\n\u001b[?2004l\r"]
[1148.264961, "o", "\u001b[?2004h> "]
[1148.265222, "o", "    Cmd  string          `json:\"cmd\"`\r\n\u001b[?2004l\r"]
[1148.265291, "o", "\u001b[?2004h> "]
[1148.265562, "o", "    Args json.RawMessage `json:\"args\"`\r\n\u001b[?2004l\r"]
[1148.265622, "o", "\u001b[?2004h> }\r\n"]
[1148.26568, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1148.265738, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1148.265914, "o", "type response struct {\r\n\u001b[?2004l\r"]
[1148.265975, "o", "\u001b[?2004h> "]
[1148.266287, "o", "    Status string          `json:\"status\"`\r\n\u001b[?2004l\r"]
[1148.266348, "o", "\u001b[?2004h> "]
[1148.266635, "o", "    Data   json.RawMessage `json:\"data\"`\r\n\u001b[?2004l\r"]
[1148.266695, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1148.266747, "o", "\u001b[?2004h> \r\n"]
[1148.266803, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1148.266858, "o", "> "]
[1148.266926, "o", "func main() {\r\n\u001b[?2004l\r"]
[1148.266975, "o", "\u001b[?2004h> "]
[1148.267172, "o", "    if len(os.Args) < 2 {\r\n\u001b[?2004l\r"]
[1148.267227, "o", "\u001b[?2004h> "]
[1148.267689, "o", "        fmt.Fprintln(os.Stderr, \"usage: meshctl <command> [args]\")\r\n\u001b[?2004l\r"]
[1148.267719, "o", "\u001b[?2004h"]
[1148.267799, "o", "> "]
[1148.267876, "o", "        os.Exit(1)\r\n\u001b[?2004l\r"]
[1148.267937, "o", "\u001b[?2004h> "]
[1148.268005, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.268059, "o", "> "]
[1148.268196, "o", "    cmd := os.Args[1]\r\n\u001b[?2004l\r"]
[1148.26825, "o", "\u001b[?2004h> "]
[1148.26852, "o", "    args := map[string]interface{}{}\r\n\u001b[?2004l\r"]
[1148.268574, "o", "\u001b[?2004h> "]
[1148.268692, "o", "    switch cmd {\r\n\u001b[?2004l\r"]
[1148.268752, "o", "\u001b[?2004h> "]
[1148.26889, "o", "    case \"status\":\r\n\u001b[?2004l\r"]
[1148.268945, "o", "\u001b[?2004h> "]
[1148.269083, "o", "    case \"stats\":\r\n\u001b[?2004l\r"]
[1148.269142, "o", "\u001b[?2004h> "]
[1148.269335, "o", "        if len(os.Args) < 3 {\r\n\u001b[?2004l\r"]
[1148.269406, "o", "\u001b[?2004h> "]
[1148.269863, "o", "            fmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")\r\n\u001b[?2004l\r"]
[1148.269935, "o", "\u001b[?2004h> "]
[1148.270083, "o", "            os.Exit(1)\r\n\u001b[?2004l\r"]
[1148.270138, "o", "\u001b[?2004h> "]
[1148.270219, "o", "        }\r\n\u001b[?2004l\r"]
[1148.270276, "o", "\u001b[?2004h> "]
[1148.270515, "o", "        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
[1148.270579, "o", "\u001b[?2004h> "]
[1148.270734, "o", "    case \"set-weight\":\r\n\u001b[?2004l\r"]
[1148.27078, "o", "\u001b[?2004h> "]
[1148.270998, "o", "        if len(os.Args) < 5 {\r\n\u001b[?2004l\r"]
[1148.271054, "o", "\u001b[?2004h> "]
[1148.271702, "o", "            fmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")\r\n\u001b[?2004l\r"]
[1148.271763, "o", "\u001b[?2004h> "]
[1148.271916, "o", "            os.Exit(1)\r\n\u001b[?2004l\r"]
[1148.271976, "o", "\u001b[?2004h> "]
[1148.272056, "o", "        }\r\n\u001b[?2004l\r"]
[1148.272114, "o", "\u001b[?2004h> "]
[1148.272428, "o", "        w, err := strconv.Atoi(os.Args[4])\r\n\u001b[?2004l\r"]
[1148.272491, "o", "\u001b[?2004h> "]
[1148.272648, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[1148.272708, "o", "\u001b[?2004h> "]
[1148.27318, "o", "            fmt.Fprintf(os.Stderr, \"invalid weight: %v\\n\", err)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.273305, "o", "> "]
[1148.273386, "o", "            os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.273464, "o", "> "]
[1148.273537, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.273594, "o", "> "]
[1148.273828, "o", "        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
[1148.273884, "o", "\u001b[?2004h> "]
[1148.274141, "o", "        args[\"address\"] = os.Args[3]\r\n\u001b[?2004l\r"]
[1148.274196, "o", "\u001b[?2004h> "]
[1148.274381, "o", "        args[\"weight\"] = w\r\n\u001b[?2004l\r"]
[1148.274451, "o", "\u001b[?2004h> "]
[1148.274576, "o", "    case \"drain\":\r\n\u001b[?2004l\r"]
[1148.274632, "o", "\u001b[?2004h> "]
[1148.274839, "o", "        if len(os.Args) < 4 {\r\n\u001b[?2004l\r"]
[1148.274894, "o", "\u001b[?2004h> "]
[1148.275456, "o", "            fmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")\r\n\u001b[?2004l\r"]
[1148.275513, "o", "\u001b[?2004h> "]
[1148.275675, "o", "            os.Exit(1)\r\n\u001b[?2004l\r"]
[1148.275736, "o", "\u001b[?2004h> "]
[1148.275808, "o", "        }\r\n\u001b[?2004l\r"]
[1148.275863, "o", "\u001b[?2004h> "]
[1148.276093, "o", "        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
[1148.276169, "o", "\u001b[?2004h> "]
[1148.276412, "o", "        args[\"address\"] = os.Args[3]\r\n\u001b[?2004l\r"]
[1148.276469, "o", "\u001b[?2004h> "]
[1148.276624, "o", "    case \"health-log\":\r\n\u001b[?2004l\r"]
[1148.276679, "o", "\u001b[?2004h> "]
[1148.276885, "o", "        if len(os.Args) < 3 {\r\n\u001b[?2004l\r"]
[1148.27694, "o", "\u001b[?2004h> "]
[1148.277525, "o", "            fmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\r\n\u001b[?2004l\r"]
[1148.277591, "o", "\u001b[?2004h> "]
[1148.277744, "o", "            os.Exit(1)\r\n\u001b[?2004l\r"]
[1148.277805, "o", "\u001b[?2004h> "]
[1148.277883, "o", "        }\r\n\u001b[?2004l\r"]
[1148.277937, "o", "\u001b[?2004h> "]
[1148.278167, "o", "        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
[1148.278214, "o", "\u001b[?2004h> "]
[1148.278342, "o", "        n := 20\r\n\u001b[?2004l\r"]
[1148.278408, "o", "\u001b[?2004h> "]
[1148.278706, "o", "        for _, a := range os.Args[3:] {\r\n\u001b[?2004l\r"]
[1148.278761, "o", "\u001b[?2004h> "]
[1148.279077, "o", "            if strings.HasPrefix(a, \"--last\") && len(a) > 6 {\r\n\u001b[?2004l\r"]
[1148.279132, "o", "\u001b[?2004h> "]
[1148.279349, "o", "                v, err := strconv.Atoi(a[6:])\r\n\u001b[?2004l\r"]
[1148.279417, "o", "\u001b[?2004h> "]
[1148.279575, "o", "                if err == nil {\r\n\u001b[?2004l\r"]
[1148.279639, "o", "\u001b[?2004h> "]
[1148.279709, "o", "                    n = v\r\n\u001b[?2004l\r"]
[1148.279764, "o", "\u001b[?2004h> "]
[1148.279819, "o", "                }\r\n\u001b[?2004l\r"]
[1148.279874, "o", "\u001b[?2004h> "]
[1148.279929, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.279988, "o", "        }\r\n\u001b[?2004l\r"]
[1148.280044, "o", "\u001b[?2004h> "]
[1148.280129, "o", "        args[\"last_n\"] = n\r\n\u001b[?2004l\r"]
[1148.280184, "o", "\u001b[?2004h> "]
[1148.280243, "o", "    case \"resolve\":\r\n\u001b[?2004l\r"]
[1148.280307, "o", "\u001b[?2004h> "]
[1148.280411, "o", "        if len(os.Args) < 3 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.280441, "o", "> "]
[1148.280706, "o", "            fmt.Fprintln(os.Stderr, \"usage: meshctl resolve <service>\")\r\n\u001b[?2004l\r"]
[1148.280728, "o", "\u001b[?2004h> "]
[1148.280831, "o", "            os.Exit(1)\r\n\u001b[?2004l\r"]
[1148.280854, "o", "\u001b[?2004h> "]
[1148.280911, "o", "        }\r\n\u001b[?2004l\r"]
[1148.280932, "o", "\u001b[?2004h> "]
[1148.281075, "o", "        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
[1148.281096, "o", "\u001b[?2004h> "]
[1148.309677, "o", "    case \"circuits\":\r\n\u001b[?2004l\r\u001b[?2004h>         if len(os.Args) < 3 {\r\n\u001b[?2004l\r\u001b[?2004h>             fmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")\r\n\u001b[?2004l\r\u001b[?2004h>             os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r\u001b[?2004h>     case \"reset-circuit\":\r\n\u001b[?2004l\r\u001b[?2004h>         if len(os.Args) < 4 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.309911, "o", "            fmt.Fprintln(os.Stderr, \"usage: meshctl reset-circuit <service> <endpoint>\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.309994, "o", "            os.Exit(1)\r\n\u001b[?2004l\r"]
[1148.310055, "o", "\u001b[?2004h> "]
[1148.310122, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.310179, "o", "> "]
[1148.31035, "o", "        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
[1148.31046, "o", "\u001b[?2004h> "]
[1148.310628, "o", "        args[\"address\"] = os.Args[3]\r\n\u001b[?2004l\r"]
[1148.310694, "o", "\u001b[?2004h> "]
[1148.310794, "o", "    case \"reload\":\r\n\u001b[?2004l\r"]
[1148.31086, "o", "\u001b[?2004h> "]
[1148.310957, "o", "    default:\r\n\u001b[?2004l\r"]
[1148.311014, "o", "\u001b[?2004h> "]
[1148.311374, "o", "        fmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\r\n\u001b[?2004l\r"]
[1148.311445, "o", "\u001b[?2004h> "]
[1148.311547, "o", "        os.Exit(1)\r\n\u001b[?2004l\r"]
[1148.311601, "o", "\u001b[?2004h> "]
[1148.311656, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.31171, "o", "> "]
[1148.311918, "o", "    data, err := sendCommand(cmd, args)\r\n\u001b[?2004l\r"]
[1148.311973, "o", "\u001b[?2004h> "]
[1148.312089, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1148.312144, "o", "\u001b[?2004h> "]
[1148.312351, "o", "        fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r"]
[1148.312416, "o", "\u001b[?2004h> "]
[1148.312533, "o", "        os.Exit(1)\r\n\u001b[?2004l\r"]
[1148.312587, "o", "\u001b[?2004h> "]
[1148.312646, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.312701, "o", "> "]
[1148.312804, "o", "    fmt.Println(data)\r\n\u001b[?2004l\r"]
[1148.312859, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1148.312915, "o", "\u001b[?2004h> \r\n"]
[1148.312971, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1148.313026, "o", "> "]
[1148.313422, "o", "func sendCommand(cmd string, args map[string]interface{}) (string, error) {\r\n\u001b[?2004l\r"]
[1148.313482, "o", "\u001b[?2004h> "]
[1148.313665, "o", "    var rawArgs json.RawMessage\r\n\u001b[?2004l\r"]
[1148.31372, "o", "\u001b[?2004h> "]
[1148.31384, "o", "    if args != nil {\r\n\u001b[?2004l\r"]
[1148.313895, "o", "\u001b[?2004h> "]
[1148.31412, "o", "        b, err := json.Marshal(args)\r\n\u001b[?2004l\r"]
[1148.314176, "o", "\u001b[?2004h> "]
[1148.314315, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[1148.31437, "o", "\u001b[?2004h> "]
[1148.314535, "o", "            return \"\", err\r\n\u001b[?2004l\r"]
[1148.31459, "o", "\u001b[?2004h> "]
[1148.314651, "o", "        }\r\n\u001b[?2004l\r"]
[1148.314705, "o", "\u001b[?2004h> "]
[1148.314819, "o", "        rawArgs = b\r\n\u001b[?2004l\r"]
[1148.314872, "o", "\u001b[?2004h> "]
[1148.315059, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.315228, "o", "        rawArgs = json.RawMessage(\"{}\")\r\n\u001b[?2004l\r"]
[1148.315298, "o", "\u001b[?2004h> "]
[1148.315362, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.315634, "o", "    req := request{Cmd: cmd, Args: rawArgs}\r\n\u001b[?2004l\r"]
[1148.315695, "o", "\u001b[?2004h> "]
[1148.315908, "o", "    reqBytes, err := json.Marshal(req)\r\n\u001b[?2004l\r"]
[1148.315964, "o", "\u001b[?2004h> "]
[1148.316078, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1148.316134, "o", "\u001b[?2004h> "]
[1148.316267, "o", "        return \"\", err\r\n\u001b[?2004l\r"]
[1148.316322, "o", "\u001b[?2004h> "]
[1148.316377, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.316442, "o", "> "]
[1148.316718, "o", "    conn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\u001b[?2004l\r"]
[1148.316774, "o", "\u001b[?2004h> "]
[1148.316888, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1148.316942, "o", "\u001b[?2004h> "]
[1148.317309, "o", "        return \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n\u001b[?2004l\r"]
[1148.317365, "o", "\u001b[?2004h> "]
[1148.317447, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.317595, "o", "    defer conn.Close()\r\n\u001b[?2004l\r"]
[1148.317651, "o", "\u001b[?2004h> "]
[1148.317918, "o", "    fmt.Fprintf(conn, \"%s\\n\", string(reqBytes))\r\n\u001b[?2004l\r"]
[1148.317973, "o", "\u001b[?2004h> "]
[1148.318177, "o", "    reader := bufio.NewReader(conn)\r\n\u001b[?2004l\r"]
[1148.318232, "o", "\u001b[?2004h> "]
[1148.318529, "o", "    line, err := reader.ReadString('\\n')\r\n\u001b[?2004l\r"]
[1148.318587, "o", "\u001b[?2004h> "]
[1148.318699, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1148.318754, "o", "\u001b[?2004h> "]
[1148.318884, "o", "        return \"\", err\r\n\u001b[?2004l\r"]
[1148.318938, "o", "\u001b[?2004h> "]
[1148.318992, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.319046, "o", "> "]
[1148.31927, "o", "    line = strings.TrimRight(line, \"\\r\\n\")\r\n\u001b[?2004l\r"]
[1148.319324, "o", "\u001b[?2004h> "]
[1148.319464, "o", "    var resp response\r\n\u001b[?2004l\r"]
[1148.319521, "o", "\u001b[?2004h> "]
[1148.319873, "o", "    if err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n\u001b[?2004l\r"]
[1148.319927, "o", "\u001b[?2004h> "]
[1148.32006, "o", "        return \"\", err\r\n\u001b[?2004l\r"]
[1148.320115, "o", "\u001b[?2004h> "]
[1148.320168, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.320222, "o", "> "]
[1148.320371, "o", "    if resp.Status != \"ok\" {\r\n\u001b[?2004l\r"]
[1148.320449, "o", "\u001b[?2004h> "]
[1148.320567, "o", "        var msg string\r\n\u001b[?2004l\r"]
[1148.32063, "o", "\u001b[?2004h> "]
[1148.320932, "o", "        if err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n\u001b[?2004l\r"]
[1148.320989, "o", "\u001b[?2004h> "]
[1148.32118, "o", "            return \"\", fmt.Errorf(\"%s\", msg)\r\n\u001b[?2004l\r"]
[1148.32124, "o", "\u001b[?2004h> "]
[1148.321294, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.321348, "o", "> "]
[1148.321571, "o", "        return \"\", fmt.Errorf(\"%s\", string(resp.Data))\r\n\u001b[?2004l\r"]
[1148.321641, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1148.321697, "o", "\u001b[?2004h> "]
[1148.321858, "o", "    return prettyData(cmd, resp.Data)\r\n\u001b[?2004l\r"]
[1148.321913, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1148.321968, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1148.322023, "o", "\u001b[?2004h> "]
[1148.322311, "o", "func prettyData(cmd string, data json.RawMessage) (string, error) {\r\n\u001b[?2004l\r"]
[1148.322366, "o", "\u001b[?2004h> "]
[1148.322444, "o", "    switch cmd {\r\n\u001b[?2004l\r"]
[1148.322499, "o", "\u001b[?2004h> "]
[1148.322576, "o", "    case \"status\":\r\n\u001b[?2004l\r"]
[1148.322632, "o", "\u001b[?2004h> "]
[1148.322766, "o", "        var services []struct {\r\n\u001b[?2004l\r"]
[1148.322822, "o", "\u001b[?2004h> "]
[1148.323014, "o", "            Name        string `json:\"name\"`\r\n\u001b[?2004l\r"]
[1148.323068, "o", "\u001b[?2004h> "]
[1148.323289, "o", "            ListenPort  int    `json:\"listen_port\"`\r\n\u001b[?2004l\r"]
[1148.323344, "o", "\u001b[?2004h> "]
[1148.323577, "o", "            RoutingMode string `json:\"routing_mode\"`\r\n\u001b[?2004l\r"]
[1148.323633, "o", "\u001b[?2004h> "]
[1148.32378, "o", "            Endpoints   []struct {\r\n\u001b[?2004l\r"]
[1148.323834, "o", "\u001b[?2004h> "]
[1148.324102, "o", "                Address            string `json:\"address\"`\r\n\u001b[?2004l\r"]
[1148.324157, "o", "\u001b[?2004h> "]
[1148.324408, "o", "                State             string `json:\"state\"`\r\n\u001b[?2004l\r"]
[1148.324465, "o", "\u001b[?2004h> "]
[1148.324705, "o", "                Weight            int    `json:\"weight\"`\r\n\u001b[?2004l\r"]
[1148.324759, "o", "\u001b[?2004h> "]
[1148.325056, "o", "                ActiveConnections int    `json:\"active_connections\"`\r\n\u001b[?2004l\r"]
[1148.32511, "o", "\u001b[?2004h> "]
[1148.325398, "o", "                CircuitState       string `json:\"circuit_state\"`\r\n\u001b[?2004l\r"]
[1148.325454, "o", "\u001b[?2004h> "]
[1148.325593, "o", "            } `json:\"endpoints\"`\r\n\u001b[?2004l\r"]
[1148.325648, "o", "\u001b[?2004h> "]
[1148.325702, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.325756, "o", "> "]
[1148.326013, "o", "        if err := json.Unmarshal(data, &services); err != nil {\r\n\u001b[?2004l\r"]
[1148.326067, "o", "\u001b[?2004h> "]
[1148.326182, "o", "            return \"\", err\r\n\u001b[?2004l\r"]
[1148.326236, "o", "\u001b[?2004h> "]
[1148.32629, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.326345, "o", "> "]
[1148.32646, "o", "        var b strings.Builder\r\n\u001b[?2004l\r"]
[1148.326515, "o", "\u001b[?2004h> "]
[1148.327062, "o", "        fmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\r\n\u001b[?2004l\r"]
[1148.327118, "o", "\u001b[?2004h> "]
[1148.327284, "o", "        for _, svc := range services {\r\n\u001b[?2004l\r"]
[1148.327338, "o", "\u001b[?2004h> "]
[1148.327547, "o", "            for _, ep := range svc.Endpoints {\r\n\u001b[?2004l\r"]
[1148.327611, "o", "\u001b[?2004h> "]
[1148.328264, "o", "                fmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\r\n\u001b[?2004l\r"]
[1148.328321, "o", "\u001b[?2004h> "]
[1148.328383, "o", "            }\r\n\u001b[?2004l\r"]
[1148.328451, "o", "\u001b[?2004h> "]
[1148.328506, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.328776, "o", "        return strings.TrimRight(b.String(), \"\\n\"), nil\r\n\u001b[?2004l\r"]
[1148.328833, "o", "\u001b[?2004h> "]
[1148.328917, "o", "    case \"resolve\":\r\n\u001b[?2004l\r"]
[1148.328972, "o", "\u001b[?2004h> "]
[1148.329072, "o", "        var addr string\r\n\u001b[?2004l\r"]
[1148.329127, "o", "\u001b[?2004h> "]
[1148.329384, "o", "        if err := json.Unmarshal(data, &addr); err != nil {\r\n\u001b[?2004l\r"]
[1148.329451, "o", "\u001b[?2004h> "]
[1148.329561, "o", "            return \"\", err\r\n\u001b[?2004l\r"]
[1148.329616, "o", "\u001b[?2004h> "]
[1148.329671, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.329725, "o", "> "]
[1148.329812, "o", "        return addr, nil\r\n\u001b[?2004l\r"]
[1148.329866, "o", "\u001b[?2004h> "]
[1148.330122, "o", "    case \"set-weight\", \"drain\", \"reset-circuit\", \"reload\":\r\n\u001b[?2004l\r"]
[1148.330176, "o", "\u001b[?2004h> "]
[1148.330262, "o", "        var s string\r\n\u001b[?2004l\r"]
[1148.330316, "o", "\u001b[?2004h> "]
[1148.330507, "o", "        if err := json.Unmarshal(data, &s); err != nil {\r\n\u001b[?2004l\r"]
[1148.330571, "o", "\u001b[?2004h> "]
[1148.330633, "o", "            return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.330687, "o", ">         }\r\n\u001b[?2004l\r"]
[1148.330742, "o", "\u001b[?2004h> "]
[1148.33081, "o", "        return s, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.330863, "o", "    default:\r\n\u001b[?2004l\r"]
[1148.330918, "o", "\u001b[?2004h> "]
[1148.330974, "o", "        var v interface{}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.331028, "o", "> "]
[1148.331188, "o", "        if err := json.Unmarshal(data, &v); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.331249, "o", "> "]
[1148.331309, "o", "            return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.331364, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.331539, "o", "        b, err := json.MarshalIndent(v, \"\", \"  \")\r\n\u001b[?2004l\r"]
[1148.331595, "o", "\u001b[?2004h> "]
[1148.331647, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.331702, "o", "> "]
[1148.331763, "o", "            return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.331817, "o", ">         }\r\n\u001b[?2004l\r"]
[1148.331872, "o", "\u001b[?2004h> "]
[1148.33195, "o", "        return string(b), nil\r\n\u001b[?2004l\r"]
[1148.332006, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1148.332062, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.332121, "o", "EOF\r\n\u001b[?2004l\r"]
[1148.334871, "o", "\u001b[?2004hroot@n30009:/app# "]
