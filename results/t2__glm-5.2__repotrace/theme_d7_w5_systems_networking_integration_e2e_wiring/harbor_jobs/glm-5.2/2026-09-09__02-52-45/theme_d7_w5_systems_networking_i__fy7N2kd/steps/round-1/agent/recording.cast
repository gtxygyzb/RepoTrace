[10697.701471, "o", "\t}\r\n    53\t\ts.listener = ln\r\n    54\t\tgo s.acceptLoop()\r\n    55\t\treturn nil\r\n    56\t}\r\n    57\t\r\n    58\tfunc (s *Server) Stop() {\r\n    59\t\tselect {\r\n    60\t\tcase <-s.stop:\r\n    61\t\tdefault:\r\n    62\t\t\tclose(s.stop)\r\n    63\t\t}\r\n"]
