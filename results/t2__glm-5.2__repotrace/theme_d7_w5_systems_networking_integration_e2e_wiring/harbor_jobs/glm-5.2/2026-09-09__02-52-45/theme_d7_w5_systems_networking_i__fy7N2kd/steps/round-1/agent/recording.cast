[11530.097247, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\n# internal/config/config.go: add log import, normalize DependsOn, add cycle detection\np = Path('internal/config/config.go')\ns = p.read_text()\nif '\"log\"' not in s:\n    s = s.replace('import (\\n\\t\"github.com/BurntSushi/toml\"\\n)', 'import (\\n\\t\"log\"\\n\\n\\t\"github.com/BurntSushi/toml\"\\n)')\nif 'if s.DependsOn == nil' not in s:\n    s = s.replace(\n'''                        if ep.WarmupDurationMs < 0 {\n                                ep.WarmupDurationMs = 0\n                        }\n                }\n        }\n        return &cfg, nil\n}''',\n'''                        if ep.WarmupDurationMs < 0 {\n                                ep.WarmupDurationMs = 0\n                        }\n                }\n                if s.DependsOn == nil {\n                        s.DependsOn = []string{}\n                }\n        }\n        cfg.Services = removeDependencyCycles(cfg.Services)\n        return &cfg, nil\n}\n\n// removeDependencyCycles drops dependency edges that would create cycl"]
[11530.097591, "i", "es.\nfunc removeDependencyCycles(services []Service) []Service {\n        byName := make(map[string]int, len(services))\n        for i, svc := range services {\n                byName[svc.Name] = i\n        }\n        for i := range services {\n                seen := map[string]bool{services[i].Name: true}\n                kept := make([]string, 0, len(services[i].DependsOn))\n                for _, dep := range services[i].DependsOn {\n                        if dep == services[i].Name {\n                                log.Printf(\"warning: dropping self dependency from %s to %s\", services[i].Name, dep)\n                                continue\n                        }\n                        if _, ok := byName[dep]; !ok {\n                                kept = append(kept, dep)\n                                continue\n                        }\n                        if createsCycle(services, byName, seen, services[i].Name, dep) {\n                                log.Printf(\"warning: dropping dependency edge from %s t"]
[11530.097626, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[11530.097756, "i", "o %s to avoid circular dependency\", services[i].Name, dep)\n                                continue\n                        }\n                        kept = append(kept, dep)\n                }\n                services[i].DependsOn = kept\n        }\n        return services\n}\n\nfunc createsCycle(services []Service, byName map[string]int, seen map[string]bool, start, dep string) bool {\n        if seen[dep] {\n                return true\n        }\n        seen[dep] = true\n        defer delete(seen, dep)\n        next := services[byName[dep]].DependsOn\n        for _, d := range next {\n                if d == start || d == dep {\n                        return true\n                }\n                if _, ok := byName[d]; !ok {\n                        continue\n                }\n                if createsCycle(services, byName, seen, start, d) {\n                        return true\n                }\n        }\n        return false\n}\n'''\n    )\np.write_text(s)\n\n# internal/ipc/server.go: accept name instead of service for get_"]
