[9968.307445, "o", "\t\t\trl.mu.Unlock()\r\n\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tremaining := time.Until(deadline)\r\n"]
[9968.307521, "o", "\t\tif remaining <= 0 {\r\n\t\t\trl.mu.Lock()\r\n\t\t\trl.queueDepth--\r\n\t\t\trl.timeouts++\r\n\t\t\trl.rateLimited++\r\n\t\t\trl.mu.Unlock()\r\n\t\t\treturn false, true, time.Since(queueStart).Milliseconds(), true\r\n\t\t}\r\n"]
[9968.308009, "o", "\u001b[?2004h"]
