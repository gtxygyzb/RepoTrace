[11291.712142, "o", "// CheckDependencies returns the first unavailable dependency and the full\r\n\u001b[?2004l\r"]
[11291.712211, "o", "\u001b[?2004h> "]
[11291.712359, "o", "// dependency status list for a service.\r\n\u001b[?2004l\r"]
[11291.71244, "o", "\u001b[?2004h> "]
[11291.712789, "o", "func (s *State) CheckDependencies(service string) (string, []DependencyStatus) {\r\n\u001b[?2004l\r"]
[11291.712858, "o", "\u001b[?2004h> "]
[11291.71296, "o", "\\tss := s.GetService(service)\r\n\u001b[?2004l\r"]
[11291.713027, "o", "\u001b[?2004h> "]
[11291.713093, "o", "\\tif ss == nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11291.713131, "o", "> "]
[11291.713226, "o", "\\t\\treturn \"\", nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11291.713297, "o", "\\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
