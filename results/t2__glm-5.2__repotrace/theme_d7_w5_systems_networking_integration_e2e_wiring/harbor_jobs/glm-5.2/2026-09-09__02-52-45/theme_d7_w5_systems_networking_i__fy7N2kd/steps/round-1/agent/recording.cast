[10659.784966, "o", "     7\t\t\"sync/atomic\"\r\n     8\t\t\"time\"\r\n     9\t\r\n    10\t\t\"meshrouter/internal/circuit\"\r\n    11\t\t\"meshrouter/internal/config\"\r\n    12\t\t\"meshrouter/internal/stats\"\r\n    13\t)\r\n    14\t\r\n    15\ttype HealthState string\r\n"]
[10659.785021, "o", "    16\t\r\n    17\tconst (\r\n    18\t\tUnknown   HealthState = \"unknown\"\r\n    19\t\tHealthy   HealthState = \"healthy\"\r\n    20\t\tUnhealthy HealthState = \"unhealthy\"\r\n    21\t\tDraining  HealthState = \"draining\"\r\n    22\t)\r\n    23\t\r\n    24\ttype HealthEvent struct {\r\n    25\t\tTimestamp   time.Time\r\n"]
[10659.785083, "o", "    26\t\tEndpoint    string\r\n    27\t\tOldState    HealthState\r\n    28\t\tNewState    HealthState\r\n    29\t\tCheckResult string\r\n    30\t}\r\n    31\t\r\n    32\ttype EndpointState struct {\r\n    33\t\tmu                sync.Mutex\r\n"]
[10659.785133, "o", "    34\t\tAddress           string\r\n    35\t\tWeight            int\r\n    36\t\tConfig            config.Endpoint\r\n    37\t\tState             HealthState\r\n    38\t\tActiveConnections int\r\n    39\t\tCircuit           *circuit.Breaker\r\n"]
[10659.785182, "o", "    40\t\tStats             *stats.Collector\r\n    41\t\tconsecSuccess     int\r\n    42\t\tconsecFailures    int\r\n    43\t\tdrainDeadline     time.Time\r\n    44\t\tremoved           bool\r\n    45\t\tconnIDCounter     int64\r\n    46\t\tcurrentWeight     int\r\n"]
[10659.785236, "o", "    47\t\tWarmupDurationMs  int\r\n    48\t\twarmupUntil       time.Time\r\n    49\t\tconnections       map[int64]*connectionInfo\r\n    50\t}\r\n    51\t\r\n    52\ttype connectionInfo struct {\r\n    53\t\tconn         net.Conn\r\n    54\t\tclientAddr   string\r\n    55\t\tstart        time.Time\r\n    56\t\t"]
[10659.78529, "o", "lastActivity time.Time\r\n    57\t\tbytesIn      int64\r\n    58\t\tbytesOut     int64\r\n    59\t}\r\n    60\t\r\n    61\ttype ServiceState struct {\r\n    62\t\tmu                        sync.Mutex\r\n    63\t\tName                      string\r\n"]
[10659.785343, "o", "    64\t\tListenPort                int\r\n    65\t\tRoutingMode               string\r\n    66\t\tDrainTimeoutMs            int\r\n    67\t\tMaxConnectionsPerEndpoint int\r\n    68\t\tConnectionLimitMode       string\r\n    69\t\tIdleTimeoutMs             int\r\n    70\t\tRateLimitRps              int\r\n    71"]
[10659.78543, "o", "\t\tRateLimitBurst            int\r\n    72\t\tRateLimitQueueDepth       int\r\n    73\t\tRateLimitQueueTimeoutMs   int\r\n    74\t\tMaxRetries                int\r\n    75\t\tRetryDelayMs              int\r\n    76\t\tRetryBackoffMultiplier    float64\r\n    77\t\tRetryMaxDelayMs           int\r\n    78\t\trateLimiter               *rateLimiter\r\n    79\t\tEndpoints                 []*EndpointState\r\n    80\t\trrIndex                   int\r\n"]
[10659.785483, "o", "    81\t\tListener                  net.Listener\r\n    82\t\tlistenerStop              chan struct{}\r\n    83\t\tstopping                  bool\r\n    84\t}\r\n    85\t\r\n    86\ttype State struct {\r\n    87\t\tmu         sync.RWMutex\r\n    88\t\tconfigPath string\r\n    89\t\tglobal     config.Global\r\n    90\t\tservices   map[string]*ServiceState\r\n"]
