[10739.725842, "o", "\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tListenPort                int\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRoutingMode               string\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tDrainTimeoutMs            int\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tMaxConnectionsPerEndpoint int\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tConnectionLimitMode       string\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tIdleTimeoutMs             int\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRateLimitRps              int\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRateLimitBurst            int\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRateLimitQueueDepth       int\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRateLimitQueueTimeoutMs   int\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tMaxRetries                int\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRetryDelayMs              int\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRetryBackoffMultiplier    float64\r\n\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRetryMaxDelayMs           int\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\trateLimiter               *rateLimiter\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tEndpoints                 []"]
