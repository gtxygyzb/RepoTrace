[2083.540903, "o", "   153\t\t\treturn \"\", fmt.Errorf(\"%s\", string(resp.Data))\r\n   154\t\t}\r\n   155\t\treturn prettyData(ipcCmd, resp.Data)\r\n   156\t}\r\n   157\t\r\n   158\tfunc prettyData(ipcCmd string, data json.RawMessage) (string, error) {\r\n   159\t\tswitch ipcCmd {\r\n"]
[2083.540962, "o", "   160\t\tcase \"list_services\":\r\n   161\t\t\tvar services []struct {\r\n   162\t\t\t\tName        string `json:\"name\"`\r\n   163\t\t\t\tListenPort  int    `json:\"listen_port\"`\r\n   164\t\t\t\tRoutingMode string `json:\"routing_mode\"`\r\n   165\t\t\t\tEndpoints   []struct {\r\n"]
[2083.541021, "o", "   166\t\t\t\t\tAddress           string `json:\"address\"`\r\n   167\t\t\t\t\tState             string `json:\"state\"`\r\n   168\t\t\t\t\tWeight            int    `json:\"weight\"`\r\n   169\t\t\t\t\tActiveConnections int    `json:\"active_connections\"`\r\n   170\t\t\t\t\tCircuitState      string `json:\"circuit_state\"`\r\n"]
[2083.54108, "o", "   171\t\t\t\t} `json:\"endpoints\"`\r\n   172\t\t\t}\r\n   173\t\t\tif err := json.Unmarshal(data, &services); err != nil {\r\n   174\t\t\t\treturn \"\", err\r\n   175\t\t\t}\r\n   176\t\t\tvar b strings.Builder\r\n   177\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\r\n   178\t\t\tfor _, svc := range services {\r\n"]
[2083.541137, "o", "   179\t\t\t\tfor _, ep := range svc.Endpoints {\r\n   180\t\t\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\r\n   181\t\t\t\t}\r\n   182\t\t\t}\r\n   183\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   184\t\tcase \"resolve\":\r\n   185\t\t\tvar addr string\r\n"]
[2083.541193, "o", "   186\t\t\tif err := json.Unmarshal(data, &addr); err != nil {\r\n   187\t\t\t\treturn \"\", err\r\n   188\t\t\t}\r\n   189\t\t\treturn addr, nil\r\n   190\t\tcase \"get_circuit_breakers\":\r\n   191\t\t\tvar circuits []struct {\r\n   192\t\t\t\tAddress             string `json:\"address\"`\r\n   193\t\t\t\tCircuitState        string `json:\"circuit_state\"`\r\n"]
[2083.54125, "o", "   194\t\t\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n   195\t\t\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n   196\t\t\t\tProbeActive         bool   `json:\"probe_active\"`\r\n   197\t\t\t}\r\n   198\t\t\tif err := json.Unmarshal(data, &circuits); err != nil {\r\n   199\t\t\t\treturn \"\", err\r\n   200\t\t\t}\r\n   201\t\t\tvar b strings.Builder\r\n"]
[2083.541308, "o", "   202\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9s %-17s %-7s\\n\", \"ENDPOINT\", \"CIRCUIT\", \"FAILURES\", \"TIME_IN_STATE_MS\", \"PROBE\")\r\n   203\t\t\tfor _, c := range circuits {\r\n   204\t\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9d %-17d %-7t\\n\", c.Address, c.CircuitState, c.ConsecutiveFailures, c.TimeInStateMs, c.ProbeActive)\r\n   205\t\t\t}\r\n   206\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   207\t\tcase \"set_weight\", \"drain_endpoint\", \"reset_circuit_breaker\", \"reload_config\":\r\n   208\t\t\tvar s string\r\n   209\t\t\tif err := json.Unmarshal(data, &s); err != nil {\r\n"]
