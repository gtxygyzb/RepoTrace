[10723.098943, "o", "\u001b[?2004l\r"]
[10723.101947, "o", "package state\r\n\r\nimport (\r\n\t\"net\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n\t\"sync/atomic\"\r\n\t\"time\"\r\n\r\n"]
[10723.102014, "o", "\t\"meshrouter/internal/circuit\"\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/stats\"\r\n)\r\n\r\ntype HealthState string\r\n\r\nconst (\r\n\tUnknown   HealthState = \"unknown\"\r\n\tHealthy   HealthState = \"healthy\"\r\n\tUnhealthy HealthState = \"unhealthy\"\r\n"]
[10723.10207, "o", "\tDraining  HealthState = \"draining\"\r\n)\r\n\r\ntype HealthEvent struct {\r\n\tTimestamp   time.Time\r\n\tEndpoint    string\r\n\tOldState    HealthState\r\n\tNewState    HealthState\r\n\tCheckResult string\r\n"]
[10723.102122, "o", "}\r\n\r\ntype EndpointState struct {\r\n\tmu                sync.Mutex\r\n\tAddress           string\r\n\tWeight            int\r\n\tConfig            config.Endpoint\r\n\tState             HealthState\r\n\tActiveConnections int\r\n\tCircuit           *circuit.Breaker\r\n"]
[10723.102172, "o", "\tStats             *stats.Collector\r\n\tconsecSuccess     int\r\n\tconsecFailures    int\r\n\tdrainDeadline     time.Time\r\n\tremoved           bool\r\n\tconnIDCounter     int64\r\n\tcurrentWeight     int\r\n"]
[10723.102221, "o", "\tWarmupDurationMs  int\r\n\twarmupUntil       time.Time\r\n\tconnections       map[int64]*connectionInfo\r\n}\r\n\r\ntype connectionInfo struct {\r\n\tconn         net.Conn\r\n\tclientAddr   string\r\n\tstart        time.Time\r\n"]
[10723.102271, "o", "\tlastActivity time.Time\r\n\tbytesIn      int64\r\n\tbytesOut     int64\r\n}\r\n\r\ntype ServiceState struct {\r\n\tmu                        sync.Mutex\r\n\tName                      string\r\n\tListenPort                int\r\n\tRoutingMode               string\r\n"]
[10723.10232, "o", "\tDrainTimeoutMs            int\r\n\tMaxConnectionsPerEndpoint int\r\n\tConnectionLimitMode       string\r\n\tIdleTimeoutMs             int\r\n\tRateLimitRps              int\r\n\tRateLimitBurst            int\r\n\tRateLimitQueueDepth       int\r\n\tRateLimitQueueTimeoutMs   int\r\n"]
[10723.102371, "o", "\tMaxRetries                int\r\n\tRetryDelayMs              int\r\n\tRetryBackoffMultiplier    float64\r\n\tRetryMaxDelayMs           int\r\n\trateLimiter               *rateLimiter\r\n\tEndpoints                 []*EndpointState\r\n\trrIndex                   int\r\n"]
[10723.102445, "o", "\tListener                  net.Listener\r\n\tlistenerStop              chan struct{}\r\n\tstopping                  bool\r\n}\r\n\r\ntype State struct {\r\n\tmu         sync.RWMutex\r\n\tconfigPath string\r\n\tglobal     config.Global\r\n\tservices   map[string]*ServiceState\r\n\tlogMu      sync.Mutex\r\n"]
[10723.102495, "o", "\thealthLog  map[string][]HealthEvent\r\n\treloadCh   chan struct{}\r\n}\r\n\r\nfunc NewState(cfg *config.Config, path string) *State {\r\n\ts := &State{\r\n\t\tconfigPath: path,\r\n\t\tservices:   make(map[string]*ServiceState),\r\n\t"]
[10723.102544, "o", "\thealthLog:  make(map[string][]HealthEvent),\r\n\t\treloadCh:   make(chan struct{}, 1),\r\n\t}\r\n\ts.applyConfigLocked(cfg)\r\n\treturn s\r\n}\r\n\r\nfunc (s *State) ReloadChan() <-chan struct{} {\r\n"]
[10723.102593, "o", "\treturn s.reloadCh\r\n}\r\n\r\nfunc (s *State) ConfigPath() string {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.configPath\r\n}\r\n\r\nfunc (s *State) Global() config.Global {\r\n\ts.mu.RLock()\r\n\t"]
[10723.102639, "o", "defer s.mu.RUnlock()\r\n\treturn s.global\r\n"]
[10723.103156, "o", "\u001b[?2004hroot@n30009:/app# "]
[10723.375218, "i", "sed -n '1,40p' internal/accesslog/logger.go\n"]
[10723.375425, "o", "sed -n '1,40p' internal/accesslog/logger.go"]
[10723.375493, "o", "\r\n\u001b[?2004l\r"]
[10723.378458, "o", "package accesslog\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n"]
[10723.378525, "o", "\t\"sync\"\r\n\t\"sync/atomic\"\r\n\t\"time\"\r\n)\r\n\r\n// Entry is one structured access log record.\r\ntype Entry struct {\r\n\tTs          string `json:\"ts\"`\r\n\tService     string `json:\"service\"`\r\n\tClient      string `json:\"client\"`\r\n\tEndpoint    string `json:\"endpoint\"`\r\n\tBytesIn     int64  `json:\"bytes_in\"`\r\n\tBytesOut    int64  `json:\"bytes_out\"`\r\n\t"]
[10723.378582, "o", "DurationMs  int64  `json:\"duration_ms\"`\r\n\tResult      string `json:\"result\"`\r\n\tRetried     bool   `json:\"retried\"`\r\n\tRetryCount  int    `json:\"retry_count\"`\r\n\tQueueWaitMs *int64 `json:\"queue_wait_ms,omitempty\"`\r\n}\r\n\r\n// DefaultPath is the access log path required by meshrouter.\r\nconst DefaultPath = \"/app/logs/access.log\"\r\n\r\nconst maxFileSize = 1 << 20 // 1 MB\r\n"]
[10723.378636, "o", "\r\n// Logger writes access log entries asynchronously to a JSON-lines file.\r\ntype Logger struct {\r\n\tpath     string\r\n\tch       chan Entry\r\n\tstop     chan struct{}\r\n\tdone     chan struct{}\r\n\tstopped  int32\r\n\t"]
[10723.378686, "o", "stopOnce sync.Once\r\n\tmu       sync.Mutex\r\n"]
[10723.379101, "o", "\u001b[?2004hroot@n30009:/app# "]
[10723.659181, "i", "sed -n '1,140p' internal/stats/stats.go\n"]
[10723.659361, "o", "sed -n '1,140p' internal/stats/stats.go\r\n"]
[10723.659457, "o", "\u001b[?2004l\r"]
[10723.662196, "o", "package stats\r\n\r\nimport (\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\ntype entry struct {\r\n"]
[10723.662269, "o", "\ttimestamp time.Time\r\n\tbytesIn   int64\r\n\tbytesOut  int64\r\n\tlatency   time.Duration\r\n\terr       bool\r\n}\r\n\r\n// Collector keeps rolling connection statistics for one endpoint.\r\ntype Collector struct {\r\n\tmu         sync.Mutex\r\n\twindow     time.Duration\r\n\tentries    []entry\r\n\trejections []time.Time\r\n\r\n"]
[10723.662327, "o", "\trateLimited    int\r\n\tqueued         int\r\n\tqueueTimeouts  int\r\n\tretries        int\r\n\tretrySuccesses int\r\n\tidleTimeouts   int\r\n}\r\n\r\n// New creates a collector with the given window length.\r\nfunc New(window time.Duration) *Collector {\r\n\tif window <= 0 {\r\n"]
[10723.662379, "o", "\t\twindow = time.Minute\r\n\t}\r\n\treturn &Collector{window: window}\r\n}\r\n\r\n// RecordConnection records a finished connection attempt.\r\nfunc (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n"]
[10723.662461, "o", "\tc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\r\n\tc.trim(now)\r\n}\r\n\r\n// RecordRejection records a rejected connection because the endpoint was at capacity.\r\nfunc (c *Collector) RecordRejection() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tc.rejections = append(c.rejections, now)\r\n"]
[10723.662514, "o", "\tc.trim(now)\r\n}\r\n\r\n// RecordRateLimited records a rate limit rejection.\r\nfunc (c *Collector) RecordRateLimited() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.rateLimited++\r\n}\r\n\r\n// RecordQueued records a connection that was queued waiting for a token.\r\nfunc (c *Collector) RecordQueued() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n"]
[10723.662565, "o", "\tc.queued++\r\n}\r\n\r\n// RecordQueueTimeout records a queue timeout rejection.\r\nfunc (c *Collector) RecordQueueTimeout() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.queueTimeouts++\r\n\tc.rateLimited++\r\n}\r\n\r\n// RecordRetry records a retry attempt.\r\n"]
[10723.662615, "o", "func (c *Collector) RecordRetry() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.retries++\r\n}\r\n\r\n// RecordRetrySuccess records a successful retry attempt.\r\nfunc (c *Collector) RecordRetrySuccess() {\r\n\tc.mu.Lock()\r\n"]
[10723.662665, "o", "\tdefer c.mu.Unlock()\r\n\tc.retrySuccesses++\r\n}\r\n\r\n// RecordIdleTimeout records a connection that was closed because it was idle.\r\nfunc (c *Collector) RecordIdleTimeout() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.idleTimeouts++\r\n}\r\n"]
[10723.662717, "o", "\r\nfunc (c *Collector) trim(now time.Time) {\r\n\tcutoff := now.Add(-c.window)\r\n\ti := 0\r\n\tfor i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {\r\n\t\ti++\r\n\t}\r\n\tif i > 0 {\r\n\t\tc.entries = c.entries[i:]\r\n"]
[10723.662781, "o", "\t}\r\n\tj := 0\r\n\tfor j < len(c.rejections) && c.rejections[j].Before(cutoff) {\r\n\t\tj++\r\n\t}\r\n\tif j > 0 {\r\n\t\tc.rejections = c.rejections[j:]\r\n\t}\r\n}\r\n\r\n// Snapshot returns current windowed stats. active is supplied by the state manager.\r\n"]
[10723.66283, "o", "func (c *Collector) Snapshot(active int) Snapshot {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tcutoff := now.Add(-c.window)\r\n\tvar total int\r\n\tvar bytesIn, bytesOut int64\r\n\tvar latencySum time.Duration\r\n"]
[10723.662878, "o", "\tvar errors int\r\n\tfor _, e := range c.entries {\r\n\t\tif e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {\r\n\t\t\ttotal++\r\n\t\t\tbytesIn += e.bytesIn\r\n\t\t\tbytesOut += e.bytesOut\r\n\t\t\tlatencySum += e.latency\r\n"]
[10723.662925, "o", "\t\t\tif e.err {\r\n\t\t\t\terrors++\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\trejected := 0\r\n\tfor _, t := range c.rejections {\r\n"]
[10723.663379, "o", "\u001b[?2004hroot@n30009:/app# "]
[10723.951074, "i", "sed -n '120,210p' cmd/meshctl/main.go\n"]
[10723.951267, "o", "sed -n '120,210p' cmd/meshctl/main.go\r\n\u001b[?2004l\r"]
[10723.9543, "o", "\tcase \"connections\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl connections <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_connections\"\r\n\t"]
[10723.954363, "o", "\targs[\"name\"] = os.Args[2]\r\n\tcase \"set-rate-limit\":\r\n\t\tif len(os.Args) < 5 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-rate-limit <service> <rps> <burst>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\trps, err := strconv.Atoi(os.Args[3])\r\n\t\t"]
[10723.954438, "o", "if err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid rps: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tburst, err := strconv.Atoi(os.Args[4])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid burst: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"set_rate_limit\"\r\n"]
[10723.954492, "o", "\t\targs[\"name\"] = os.Args[2]\r\n\t\targs[\"rps\"] = rps\r\n\t\targs[\"burst\"] = burst\r\n\tcase \"access-log\":\r\n\t\tipcCmd = \"get_access_log\"\r\n\t\tlast := 20\r\n\t\trest := os.Args[2:]\r\n\t\tfor i := 0; i < len(rest); i++ {\r\n\t\t\ta := rest[i]\r\n"]
[10723.954542, "o", "\t\t\tif a == \"--last\" {\r\n\t\t\t\tif i+1 < len(rest) {\r\n\t\t\t\t\tif v, err := strconv.Atoi(rest[i+1]); err == nil {\r\n\t\t\t\t\t\tlast = v\r\n\t\t\t\t\t}\r\n\t\t\t\t\ti++\r\n\t\t\t\t"]
[10723.954592, "o", "}\r\n\t\t\t} else if strings.HasPrefix(a, \"--last=\") {\r\n\t\t\t\tif v, err := strconv.Atoi(a[len(\"--last=\"):]); err == nil {\r\n\t\t\t\t\tlast = v\r\n\t\t\t\t}\r\n\t\t\t} else if a == \"--result\" {\r\n"]
[10723.954641, "o", "\t\t\t\tif i+1 < len(rest) {\r\n\t\t\t\t\targs[\"result\"] = rest[i+1]\r\n\t\t\t\t\ti++\r\n\t\t\t\t}\r\n\t\t\t} else if strings.HasPrefix(a, \"--result=\") {\r\n\t\t\t\targs[\"result\"] = a[len(\"--result=\"):]\r\n\t\t\t} else if !strings.HasPrefix(a, \"-\") {\r\n"]
[10723.95471, "o", "\t\t\t\targs[\"service\"] = a\r\n\t\t\t}\r\n\t\t}\r\n\t\targs[\"last_n\"] = last\r\n\tcase \"access-stats\":\r\n\t\tipcCmd = \"get_access_stats\"\r\n\t\tfor _, a := range os.Args[2:] {\r\n\t\t\tif !strings.HasPrefix(a, \"-\") {\r\n\t\t\t\targs[\"service\"] = a\r\n\t\t\t}\r\n"]
[10723.95476, "o", "\t\t}\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cliCmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tdata, err := sendCommand(ipcCmd, args)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n"]
[10723.95481, "o", "\t}\r\n\tfmt.Println(data)\r\n}\r\n\r\nfunc sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n\trawArgs, err := json.Marshal(args)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\treq := request{Cmd: ipcCmd, Args: rawArgs}\r\n"]
[10723.954857, "o", "\treqBytes, err := json.Marshal(req)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\r\n\tconn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\tif err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n\t}\r\n\tdefer conn.Close()\r\n"]
[10723.955332, "o", "\u001b[?2004hroot@n30009:/app# "]
