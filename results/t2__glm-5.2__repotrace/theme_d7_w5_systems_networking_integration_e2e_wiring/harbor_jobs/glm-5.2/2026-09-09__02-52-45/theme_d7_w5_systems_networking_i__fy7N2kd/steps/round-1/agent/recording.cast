[1235.676826, "o", "^IData   json.RawMessage `json:\"data\"`$\r\n}$\r\n$\r\nfunc main() {$\r\n^Iif len(os.Args) < 2 {$\r\n^I^Ifmt.Fprintln(os.Stderr, \"usage: meshctl <command> [args]\")$\r\n^I^Ios.Exit(1)$\r\n^I}$\r\n^Icmd := os.Args[1]$\r\n^Iargs := map[string]interface{}{}$\r\n^Iswitch cmd {$\r\n^Icase \"status\":$\r\n^Icase \"stats\":$\r\n^I^Iif len(os.Args) < 3 {$\r\n^I^I^Ifmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")$\r\n^I^I^Ios.Exit(1)$\r\n^I^I}$\r\n^I^Iargs[\"name\"] = os.Args[2]$\r\n^Icase \"set-weight\":$\r\n^I^Iif len(os.Args) < 5 {$\r\n^I^I^Ifmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")$\r\n^I^I^Ios.Exit(1)$\r\n^I^I}$\r\n^I^Iw, err := strconv.Atoi(os.Args[4])$\r\n^I^Iif err != nil {$\r\n^I^I^Ifmt.Fprintf(os.Stderr, \"invalid weight: %v\\n\", err)$\r\n^I^I^Ios.Exit(1)$\r\n^I^I}$\r\n^I^Iargs[\"name\"] = os.Args[2]$\r\n^I^Iargs[\"address\"] = os.Args[3]$\r\n^I^Iargs[\"weight\"] = w$\r\n^Icase \"drain\":$\r\n^I^Iif len(os.Args) < 4 {$\r\n^I^I^Ifmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")$\r\n^I^I^Ios.Exit(1)$\r\n^I^I}$\r\n^I^Iargs[\"name\"] = "]
[1235.676969, "o", "os.Args[2]$\r\n^I^Iargs[\"address\"] = os.Args[3]$\r\n^Icase \"health-log\":$\r\n^I^Iif len(os.Args) < 3 {$\r\n^I^I^Ifmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")$\r\n^I^I^Ios.Exit(1)$\r\n^I^I}$\r\n^I^Iargs[\"name\"] = os.Args[2]$\r\n^I^In := 20$\r\n^I^Ifor _, a := range os.Args[3:] {$\r\n^I^I^Iif strings.HasPrefix(a, \"--last\") && len(a) > 6 {$\r\n^I^I^I^Iv, err := strconv.Atoi(a[6:])$\r\n^I^I^I^Iif err == nil {$\r\n^I^I^I^I^In = v$\r\n^I^I^I^I}$\r\n^I^I^I}$\r\n^I^I}$\r\n^I^Iargs[\"last_n\"] = n$\r\n^Icase \"resolve\":$\r\n^I^Iif len(os.Args) < 3 {$\r\n^I^I^Ifmt.Fprintln(os.Stderr, \"usage: meshctl resolve <service>\")$\r\n^I^I^Ios.Exit(1)$\r\n^I^I}$\r\n^I^Iargs[\"name\"] = os.Args[2]$\r\n^Icase \"circuits\":$\r\n^I^Iif len(os.Args) < 3 {$\r\n^I^I^Ifmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")$\r\n^I^I^Ios.Exit(1)$\r\n^I^I}$\r\n^I^Iargs[\"name\"] = os.Args[2]$\r\n^Icase \"reset-circuit\":$\r\n^I^Iif len(os.Args) < 4 {$\r\n^I^I^Ifmt.Fprintln(os.Stderr, \"usage: meshctl reset-circuit <service> <endpoint>\")$\r\n^I^I^Ios.Exit(1)$\r\n^I^I}$\r\n^I^Iargs[\"name\"] "]
[1235.677041, "o", "= os.Args[2]$\r\n^I^Iargs[\"address\"] = os.Args[3]$\r\n^Icase \"reload\":$\r\n^Idefault:$\r\n^I^Ifmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)$\r\n^I^Ios.Exit(1)$\r\n^I}$\r\n^Idata, err := sendCommand(cmd, args)$\r\n^Iif err != nil {$\r\n^I^Ifmt.Fprintln(os.Stderr, err)$\r\n"]
