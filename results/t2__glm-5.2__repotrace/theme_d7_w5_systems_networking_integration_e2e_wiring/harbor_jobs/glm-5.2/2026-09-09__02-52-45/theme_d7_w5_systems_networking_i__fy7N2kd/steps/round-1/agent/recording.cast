[2994.80669, "o", "\t\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   204\t\t\t\t\tss := r.state.GetService(service)\r\n   205\t\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n   206\t\t\t\t\t\tcand.Stats.RecordRejection()\r\n   207\t\t\t\t\t}\r\n   208\t\t\t\t}\r\n   209\t\t\t\tclient.Close()\r\n   210\t\t\t\treturn\r\n   211\t\t\t}\r\n   212\t\t\tlastEndpoint = res.Endpoint\r\n"]
