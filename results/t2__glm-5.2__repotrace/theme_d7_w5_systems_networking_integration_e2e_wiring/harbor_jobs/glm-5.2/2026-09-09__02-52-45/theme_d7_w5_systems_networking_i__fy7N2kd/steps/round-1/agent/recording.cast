[2306.227512, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/config/config.go')\nlines = p.read_text().splitlines()\nout = []\nfor i, line in enumerate(lines):\n    if line.strip() == 'MaxConnectionsPerEndpoint int        `toml:\"max_connections_per_endpoint\"`' and i+1 < len(lines) and lines[i+1].strip() == 'Endpoints                 []Endpoint `toml:\"endpoint\"`':\n        out.append(line)\n        out.append('\\tRateLimitRps              int        `toml:\"rate_limit_rps\"`')\n        out.append('\\tRateLimitBurst            int        `toml:\"rate_limit_burst\"`')\n        out.append('\\tRateLimitQueueDepth       int        `toml:\"rate_limit_queue_depth\"`')\n        out.append('\\tRateLimitQueueTimeoutMs   int        `toml:\"rate_limit_queue_timeout_ms\"`')\n        out.append('\\tMaxRetries                int        `toml:\"max_retries\"`')\n        out.append('\\tRetryDelayMs              int        `toml:\"retry_delay_ms\"`')\n        out.append('\\tRetryBackoffMultiplier    float64    `toml:\"retry_backoff_multiplier\"`')\n        out."]
[2306.227718, "i", "append('\\tRetryMaxDelayMs           int        `toml:\"retry_max_delay_ms\"`')\n    else:\n        out.append(line)\np.write_text('\\n'.join(out) + '\\n')\nPY\ngofmt -w internal/config/config.go\nnl -ba internal/config/config.go | sed -n '26,45p'\ngo build ./...\n"]
