[4130.463914, "o", "\t\tglobal     config.Global\r\n    76\t\tservices   map[string]*ServiceState\r\n    77\t\tlogMu      sync.Mutex\r\n    78\t\thealthLog  map[string][]HealthEvent\r\n    79\t\treloadCh   chan struct{}\r\n    80\t}\r\n    81\t\r\n"]
[4130.463971, "o", "    82\tfunc NewState(cfg *config.Config, path string) *State {\r\n    83\t\ts := &State{\r\n    84\t\t\tconfigPath: path,\r\n    85\t\t\tservices:   make(map[string]*ServiceState),\r\n    86\t\t\thealthLog:  make(map[string][]HealthEvent),\r\n    87\t\t\treloadCh:   make(chan struct{}, 1),\r\n    88\t\t}\r\n    89\t\ts.applyConfigLocked(cfg)\r\n    90\t\treturn s\r\n    91\t}\r\n"]
[4130.464027, "o", "    92\t\r\n    93\tfunc (s *State) ReloadChan() <-chan struct{} {\r\n    94\t\treturn s.reloadCh\r\n    95\t}\r\n    96\t\r\n    97\tfunc (s *State) ConfigPath() string {\r\n    98\t\ts.mu.RLock()\r\n"]
[4130.464091, "o", "    99\t\tdefer s.mu.RUnlock()\r\n   100\t\treturn s.configPath\r\n   101\t}\r\n   102\t\r\n   103\tfunc (s *State) Global() config.Global {\r\n   104\t\ts.mu.RLock()\r\n   105\t\tdefer s.mu.RUnlock()\r\n   106\t\treturn s.global\r\n   107\t}\r\n   108\t\r\n   109\tfunc (s *State) ApplyConfig(cfg *config.Config) {"]
[4130.464146, "o", "\r\n   110\t\ts.mu.Lock()\r\n   111\t\tdefer s.mu.Unlock()\r\n   112\t\ts.applyConfigLocked(cfg)\r\n   113\t\tselect {\r\n   114\t\tcase s.reloadCh <- struct{}{}:\r\n   115\t\tdefault:\r\n   116\t"]
[4130.464208, "o", "\t}\r\n   117\t}\r\n   118\t\r\n   119\tfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n   120\t\ts.global = cfg.Global\r\n   121\t\tseen := make(map[string]bool)\r\n   122\t\tfor _, svc := range cfg.Services {\r\n   123\t\t\tseen[svc.Name] = true\r\n"]
