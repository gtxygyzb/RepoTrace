[12008.247125, "o", "   254\t\t\tfmt.Fprintf(&b, \"%-14s %-14s %-10t %-18d\\n\", row.Service, row.Name, row.Available, row.HealthyEndpoints)\r\n   255\t\t}\r\n   256\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   257\t}\r\n   258\t\r\n   259\tfunc sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {\r\n   260\t\trawArgs, err := json.Marshal(args)\r\n   261\t\tif err != nil {\r\n"]
