[10577.918878, "i", "sed -n '1,220p' internal/accesslog/logger.go\n"]
[10577.919585, "o", "sed -n '1,220p' internal/accesslog/logger.go\r\n\u001b[?2004l\r"]
[10577.921459, "o", "package accesslog\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sync\"\r\n\t\"sync/atomic\"\r\n\t\"time\"\r\n)\r\n\r\n// Entry is one structured access log record.\r\ntype Entry struct {\r\n\tTs          string `json:\"ts\"`\r\n\tService     string `json:\"service\"`\r\n\tClient      string `json:\"client\"`\r\n"]
[10577.921536, "o", "\tEndpoint    string `json:\"endpoint\"`\r\n\tBytesIn     int64  `json:\"bytes_in\"`\r\n\tBytesOut    int64  `json:\"bytes_out\"`\r\n\tDurationMs  int64  `json:\"duration_ms\"`\r\n\tResult      string `json:\"result\"`\r\n\tRetried     bool   `json:\"retried\"`\r\n\tRetryCount  int    `json:\"retry_count\"`\r\n\tQueueWaitMs *int64 `json:\"queue_wait_ms,omitempty\"`\r\n}\r\n\r\n// DefaultPath is the access log path required by meshrouter.\r\nconst DefaultPath = \"/app/logs/access.log\"\r\n\r\nconst maxFileSize = 1 << 20 // 1 MB\r\n\r\n// Logger writes access log entries asynchronously to a JSON-lines file.\r\ntype Logger struct {\r\n\tpath     string\r\n\tch       chan Entry\r\n\tstop     chan struct{}\r\n\tdone     chan struct{}\r\n\tstopped  int32\r\n\tstopOnce sync.Once\r\n\tmu       sync.Mutex\r\n\tfile     *os.File\r\n\tsize     int64\r\n}\r\n\r\n// New creates a Logger for path and starts its writer goroutine.\r\nfunc New(path string) *Logger {\r\n\tif path == \"\" {\r\n\t\tpath = DefaultPath\r\n\t}\r\n\tl := &Logger{\r\n\t\tpath: path,\r\n\t\tch:   make(chan Entry, 8192),\r\n\t\tstop: make(chan struct{}),\r\n\t\tdone: make(c"]
[10577.921588, "o", "han struct{}),\r\n\t}\r\n\tgo l.run()\r\n\treturn l\r\n}\r\n\r\n// Path returns the configured log file path.\r\nfunc (l *Logger) Path() string {\r\n\treturn l.path\r\n}\r\n\r\n// Log queues an entry for asynchronous writing. If the buffered channel is full,\r\n// the entry is written synchronously to avoid losing it.\r\nfunc (l *Logger) Log(entry Entry) {\r\n\tif atomic.LoadInt32(&l.stopped) != 0 {\r\n\t\treturn\r\n\t}\r\n\tentry.Ts = time.Now().UTC().Format(time.RFC3339Nano)\r\n\tselect {\r\n\tcase l.ch <- entry:\r\n\tdefault:\r\n\t\tl.writeLine(entry)\r\n\t}\r\n}\r\n\r\n// Stop flushes all buffered entries and closes the log file.\r\nfunc (l *Logger) Stop() {\r\n\tl.stopOnce.Do(func() {\r\n\t\tatomic.StoreInt32(&l.stopped, 1)\r\n\t\tclose(l.stop)\r\n\t\t<-l.done\r\n\t\tl.mu.Lock()\r\n\t\tif l.file != nil {\r\n\t\t\tl.file.Close()\r\n\t\t\tl.file = nil\r\n\t"]
[10577.921631, "o", "\t}\r\n\t\tl.mu.Unlock()\r\n\t})\r\n}\r\n\r\nfunc (l *Logger) run() {\r\n\tfor {\r\n\t\tselect {\r\n\t\tcase e := <-l.ch:\r\n\t\t\tl.writeLine(e)\r\n\t\tcase <-l.stop:\r\n\t\t\tl.drain()\r\n\t\t\tclose(l.done)\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc (l *Logger) drain() {\r\n\tfor {\r\n\t\tselect {\r\n\t\tcase e := <-l.ch:\r\n\t\t\tl.writeLine(e)\r\n"]
[10577.921699, "o", "\t\tdefault:\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc (l *Logger) writeLine(e Entry) {\r\n\tb, err := json.Marshal(e)\r\n\tif err != nil {\r\n\t\treturn\r\n\t}\r\n\tb = append(b, '\\n')\r\n\r\n\tl.mu.Lock()\r\n\tdefer l.mu.Unlock()\r\n\r\n\tif l.file == nil {\r\n\t\tif err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n\t\tif err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n\t\tl.file = f\r\n\t\tif info, err := f.Stat(); err == nil {\r\n\t\t\tl.size = info.Size()\r\n\t\t}\r\n\t}\r\n\r\n\tif l.size > 0 && l.size+int64(len(b)) > maxFileSize {\r\n\t\tl.rotateLocked()\r\n\t}\r\n\r\n\tn, err := l.file.Write(b)\r\n\tif err != nil {\r\n\t\tl.size = 0\r\n\t\tif l.file != nil {\r\n\t\t\tl.file.Close()\r\n"]
[10577.921745, "o", "\t\t\tl.file = nil\r\n\t\t}\r\n\t\treturn\r\n\t}\r\n\tl.size += int64(n)\r\n}\r\n\r\nfunc (l *Logger) rotateLocked() {\r\n\tif l.file != nil {\r\n\t\tl.file.Close()\r\n\t\tl.file = nil\r\n\t}\r\n\tos.Remove(l.path + \".1\")\r\n\tif err := os.Rename(l.path, l.path+\".1\"); err != nil {\r\n\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n\t\tif err == nil {\r\n\t\t\tl.file = f\r\n\t\t\tif info, err := f.Stat(); err == nil {\r\n\t\t\t\tl.size = info.Size()\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn\r\n\t}\r\n"]
[10577.921797, "o", "\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n\tif err != nil {\r\n\t\tl.size = 0\r\n\t\treturn\r\n"]
[10577.921855, "o", "\t}\r\n\tl.file = f\r\n\tl.size = 0\r\n}\r\n"]
[10577.922263, "o", "\u001b[?2004h"]
[10577.922305, "o", "root@n30009:/app# "]
[10578.243495, "i", "sed -n '1,220p' internal/stats/stats.go\n"]
[10578.243841, "o", "sed -n '1,220p' internal/stats/stats.go\r\n"]
[10578.243956, "o", "\u001b[?2004l\r"]
[10578.246999, "o", "package stats\r\n\r\nimport (\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n"]
[10578.247122, "o", "\r\ntype entry struct {\r\n\ttimestamp time.Time\r\n\tbytesIn   int64\r\n\tbytesOut  int64\r\n\tlatency   time.Duration\r\n\terr       bool\r\n}\r\n\r\n// Collector keeps rolling connection statistics for one endpoint.\r\ntype Collector struct {\r\n\tmu         sync.Mutex\r\n\twindow     time.Duration\r\n\tentries    []entry\r\n\trejections []time.Time\r\n\r\n\trateLimited    int\r\n\tqueued         int\r\n\tqueueTimeouts  int\r\n\tretries        int\r\n\tretrySuccesses int\r\n\tidleTimeouts   int\r\n}"]
[10578.247216, "o", "\r\n\r\n// New creates a collector with the given window length.\r\nfunc New(window time.Duration) *Collector {\r\n\tif window <= 0 {\r\n\t\twindow = time.Minute\r\n\t}\r\n\treturn &Collector{window: window}\r\n}\r\n\r\n// RecordConnection records a finished connection attempt.\r\nfunc (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\r\n\tc.trim(now)\r\n}\r\n\r\n"]
[10578.247289, "o", "// RecordRejection records a rejected connection because the endpoint was at capacity.\r\nfunc (c *Collector) RecordRejection() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tc.rejections = append(c.rejections, now)\r\n\tc.trim(now)\r\n}\r\n\r\n// RecordRateLimited records a rate limit rejection.\r\nfunc (c *Collector) RecordRateLimited() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.rateLimited++\r\n}"]
[10578.24737, "o", "\r\n\r\n// RecordQueued records a connection that was queued waiting for a token.\r\nfunc (c *Collector) RecordQueued() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.queued++\r\n}\r\n\r\n// RecordQueueTimeout records a queue timeout rejection.\r\nfunc (c *Collector) RecordQueueTimeout() {\r\n\tc.mu.Lock()\r\n"]
[10578.247449, "o", "\tdefer c.mu.Unlock()\r\n\tc.queueTimeouts++\r\n\tc.rateLimited++\r\n}\r\n\r\n// RecordRetry records a retry attempt.\r\nfunc (c *Collector) RecordRetry() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.retries++\r\n}\r\n\r\n// RecordRetrySuccess records a successful retry attempt."]
[10578.247518, "o", "\r\nfunc (c *Collector) RecordRetrySuccess() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.retrySuccesses++\r\n}\r\n\r\n// RecordIdleTimeout records a connection that was closed because it was idle.\r\nfunc (c *Collector) RecordIdleTimeout() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.idleTimeouts++\r\n}\r\n\r\nfunc (c *Collector) trim(now time.Time) {\r\n\tcutoff := now.Add(-c.window)\r\n\ti := 0\r\n\tfor i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {\r\n\t\ti++\r\n"]
[10578.247558, "o", "\t}\r\n\tif i > 0 {\r\n\t\tc.entries = c.entries[i:]\r\n\t}\r\n\tj := 0\r\n\tfor j < len(c.rejections) && c.rejections[j].Before(cutoff) {\r\n\t\tj++\r\n"]
[10578.247799, "o", "\t}\r\n\tif j > 0 {\r\n\t\tc.rejections = c.rejections[j:]\r\n\t}\r\n}\r\n\r\n// Snapshot returns current windowed stats. active is supplied by the state manager.\r\nfunc (c *Collector) Snapshot(active int) Snapshot {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tcutoff := now.Add(-c.window)\r\n\tvar total int\r\n\tvar bytesIn, bytesOut int64\r\n\tvar latencySum time.Duration\r\n\tvar errors int\r\n\tfor _, e := range c.entries {\r\n\t\tif e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {\r\n\t\t\ttotal++\r\n\t\t\tbytesIn += e.bytesIn\r\n\t\t\tbytesOut += e.bytesOut\r\n\t\t\tlatencySum += e.latency\r\n\t\t\tif e.err {\r\n\t\t\t\terrors++\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\trejected := 0\r\n\tfor _, t := range c.rejections {\r\n\t\tif t.After(cutoff) || t.Equal(cutoff) {\r\n\t\t\trejected++\r\n\t\t}\r\n\t}\r\n\tvar avg float64\r\n\tif total > 0 {\r\n\t\tavg = float64(latencySum.Milliseconds()) / float64(total)\r\n\t}\r\n\treturn Snapshot{\r\n\t\tTotalConnections:    total,\r\n\t\tActiveConnections:   active,\r\n\t\tBytesIn:             bytesIn,\r\n\t\tBytesOut:            bytesOut,\r\n\t\tAvgLatencyMs:        avg,\r\n\t"]
[10578.247889, "o", "\tErrors:              errors,\r\n\t\tRejectedConnections: rejected,\r\n\t\tRateLimited:         c.rateLimited,\r\n\t\tQueued:              c.queued,\r\n\t\tQueueTimeouts:       c.queueTimeouts,\r\n\t\tRetries:             c.retries,\r\n\t\tRetrySuccesses:      c.retrySuccesses,\r\n\t\tIdleTimeouts:        c.idleTimeouts,\r\n\t}\r\n}\r\n\r\n// Snapshot is a JSON-friendly stats view.\r\ntype Snapshot struct {\r\n\tTotalConnections    int     `json:\"total_connections\"`\r\n\tActiveConnections   int     `json:\"active_connections\"`\r\n\tBytesIn             int64   `json:\"bytes_in\"`\r\n\tBytesOut            int64   `json:\"bytes_out\"`\r\n"]
[10578.247954, "o", "\tAvgLatencyMs        float64 `json:\"avg_latency_ms\"`\r\n\tErrors              int     `json:\"errors\"`\r\n\tRejectedConnections int     `json:\"rejected_connections\"`\r\n\tRateLimited         int     `json:\"rate_limited\"`\r\n\tQueued              int     `json:\"queued\"`\r\n\tQueueTimeouts       int     `json:\"queue_timeouts\"`\r\n\tRetries             int     `json:\"retries\"`\r\n\tRetrySuccesses      int     `json:\"retry_successes\"`\r\n\tIdleTimeouts        int     `json:\"idle_timeouts\"`\r\n"]
[10578.248015, "o", "}\r\n"]
[10578.248522, "o", "\u001b[?2004h"]
[10578.248587, "o", "root@n30009:/app# "]
[10578.523807, "i", "sed -n '1,260p' internal/ipc/server.go\n"]
[10578.52414, "o", "sed -n '1,260p' internal/ipc/server.go\r\n"]
[10578.524228, "o", "\u001b[?2004l\r"]
[10578.527454, "o", "package ipc\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"errors\"\r\n"]
[10578.527568, "o", "\t\"fmt\"\r\n\t\"net\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\r\n\t\"meshrouter/internal/accesslog\"\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/state\"\r\n)\r\n\r\ntype Request struct {\r\n\tCmd  string          `json:\"cmd\"`\r\n\tArgs json.RawMessage `json:\"args\"`\r\n}\r\n\r\ntype Response struct {\r\n\tStatus string      `json:\"status\"`\r\n\tData   interface{} `json:\"data\"`\r\n}\r\n\r\n"]
[10578.527648, "o", "type Server struct {\r\n\tstate    *state.State\r\n\tpath     string\r\n\tlistener net.Listener\r\n\twg       sync.WaitGroup\r\n\tstop     chan struct{}\r\n\tdone     chan struct{}\r\n}\r\n\r\nfunc NewServer(s *state.State, path string) *Server {\r\n\treturn &Server{\r\n\t\tstate: s,\r\n\t\tpath:  path,\r\n\t\tstop:  make(chan struct{}),\r\n\t\t"]
[10578.52774, "o", "done:  make(chan struct{}),\r\n\t}\r\n}\r\n\r\nfunc (s *Server) Start() error {\r\n\tos.Remove(s.path)\r\n\tln, err := net.Listen(\"unix\", s.path)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\ts.listener = ln\r\n\tgo s.acceptLoop()\r\n\treturn nil\r\n}\r\n\r\nfunc (s *Server) Stop() {\r\n\tselect {\r\n\tcase <-s.stop:\r\n"]
[10578.527804, "o", "\tdefault:\r\n\t\tclose(s.stop)\r\n\t}\r\n\tif s.listener != nil {\r\n\t\ts.listener.Close()\r\n\t}\r\n\t<-s.done\r\n\tos.Remove(s.path)\r\n}\r\n\r\nfunc (s *Server) acceptLoop() {\r\n"]
[10578.527861, "o", "\tdefer close(s.done)\r\n\tfor {\r\n\t\tconn, err := s.listener.Accept()\r\n\t\tif err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n\t\ts.wg.Add(1)\r\n\t\tgo s.handleConn(conn)\r\n\t}\r\n}"]
[10578.52792, "o", "\r\n\r\nfunc (s *Server) handleConn(conn net.Conn) {\r\n\tdefer s.wg.Done()\r\n\tdefer conn.Close()\r\n\treader := bufio.NewReader(conn)\r\n\tfor {\r\n\t\tline, err := reader.ReadString('\\n')\r\n\t\tif err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n"]
[10578.527982, "o", "\t\tline = strings.TrimRight(line, \"\\r\\n\")\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tresp := s.handleLine(line)\r\n\t\t_, _ = conn.Write([]byte(resp + \"\\n\"))\r\n\t}\r\n}\r\n\r\nfunc (s *Server) handleLine(line string) string {\r\n\tvar req Request\r\n"]
[10578.528044, "o", "\tif err := json.Unmarshal([]byte(line), &req); err != nil {\r\n\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n\t}\r\n\tdata, err := s.dispatch(req)\r\n\tif err != nil {\r\n\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n"]
[10578.528107, "o", "\t}\r\n\treturn encodeResp(Response{Status: \"ok\", Data: data})\r\n}\r\n\r\nfunc encodeResp(r Response) string {\r\n\tb, _ := json.Marshal(r)\r\n\treturn string(b)\r\n}\r\n\r\nfunc (s *Server) dispatch(req Request) (interface{}, error) {\r\n\tswitch req.Cmd {\r\n\tcase \"list_services\":\r\n\t\treturn s.state.ServicesView(), nil\r\n\tcase \"get_service\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n"]
[10578.528169, "o", "\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tsv, ok := s.state.ServiceView(args.Name)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn sv, nil\r\n\tcase \"get_warmup_status\":\r\n"]
[10578.52823, "o", "\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tsv, ok := s.state.WarmupStatusView(args.Name)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn sv, nil\r\n"]
[10578.528292, "o", "\tcase \"get_stats\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tg := s.state.Global()\r\n\t\tsv, ok := s.state.StatsView(args.Name, g.StatsWindowSec)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n"]
[10578.528357, "o", "\t\treturn sv, nil\r\n\tcase \"set_weight\":\r\n\t\tvar args struct {\r\n\t\t\tName    string `json:\"name\"`\r\n\t\t\tAddress string `json:\"address\"`\r\n\t\t\tWeight  int    `json:\"weight\"`\r\n\t\t}\r\n"]
