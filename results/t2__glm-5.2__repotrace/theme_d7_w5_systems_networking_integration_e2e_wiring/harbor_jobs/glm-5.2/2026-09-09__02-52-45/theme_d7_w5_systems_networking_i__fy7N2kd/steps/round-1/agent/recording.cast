[14527.562573, "i", "python3 - <<'PY'\np = 'cmd/meshctl/main.go'\nwith open(p) as f:\n    s = f.read()\n\n# Add mirror subcommand after connections case\nold = '''\\tcase \"connections\":\n\\t\\tif len(os.Args) < 3 {\n\\t\\t\\tfmt.Fprintln(os.Stderr, \"usage: meshctl connections <service>\")\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\\t\\tipcCmd = \"get_connections\"\n\\t\\targs[\"name\"] = os.Args[2]\n'''\nnew = old + '''\\tcase \"mirror\":\n\\t\\tif len(os.Args) < 3 {\n\\t\\t\\tfmt.Fprintln(os.Stderr, \"usage: meshctl mirror <service>\")\n\\t\\t\\tos.Exit(1)\n\\t\\t}\n\\t\\tipcCmd = \"get_mirror_status\"\n\\t\\targs[\"name\"] = os.Args[2]\n'''\nif old in s:\n    s = s.replace(old, new)\nelse:\n    print('WARNING: connections case not found')\n\n# Add formatting case before default in printResponse\nold_fmt = '''\\tdefault:\n\\t\\tvar v interface{}\n\\t\\tif err := json.Unmarshal(data, &v); err != nil {\n\\t\\t\\treturn \"\", err\n\\t\\t}\n'''\nnew_fmt = '''\\tcase \"get_mirror_status\":\n\\t\\tvar resp struct {\n\\t\\t\\tMirrorEndpoint     string `json:\"mirror_endpoint\"`\n\\t\\t\\tMirrorSamplePct    int    `json:\"mirror_sample_pct\"`\n\\t\\t\\tMir"]
[14527.562835, "i", "roredConnections int   `json:\"mirrored_connections\"`\n\\t\\t}\n\\t\\tif err := json.Unmarshal(data, &resp); err != nil {\n\\t\\t\\treturn \"\", err\n\\t\\t}\n\\t\\tvar b strings.Builder\n\\t\\tfmt.Fprintf(&b, \"%-18s %-15s %-20s\\n\", \"MIRROR_ENDPOINT\", \"SAMPLE_PCT\", \"MIRRORED_CONNECTIONS\")\n\\t\\tfmt.Fprintf(&b, \"%-18s %-15d %-20d\\n\", resp.MirrorEndpoint, resp.MirrorSamplePct, resp.MirroredConnections)\n\\t\\treturn strings.TrimRight(b.String(), \"\\n\"), nil\n\\tdefault:\n\\t\\tvar v interface{}\n\\t\\tif err := json.Unmarshal(data, &v); err != nil {\n\\t\\t\\treturn \"\", err\n\\t\\t}\n'''\nif old_fmt in s:\n    s = s.replace(old_fmt, new_fmt)\nelse:\n    print('WARNING: default fmt case not found')\n\nwith open(p, 'w') as f:\n    f.write(s)\nprint('meshctl main.go updated')\nPY\n"]
