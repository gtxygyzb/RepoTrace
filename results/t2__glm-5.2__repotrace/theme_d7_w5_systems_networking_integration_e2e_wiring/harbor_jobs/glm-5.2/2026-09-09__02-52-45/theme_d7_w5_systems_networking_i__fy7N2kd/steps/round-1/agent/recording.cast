[9670.0827, "o", "type Entry struct {\r\n\tTs         string `json:\"ts\"`\r\n\tService    string `json:\"service\"`\r\n\tClient     string `json:\"client\"`\r\n\tEndpoint   string `json:\"endpoint\"`\r\n"]
[9670.082815, "o", "\tBytesIn    int64  `json:\"bytes_in\"`\r\n\tBytesOut   int64  `json:\"bytes_out\"`\r\n\tDurationMs int64  `json:\"duration_ms\"`\r\n\tResult     string `json:\"result\"`\r\n}\r\n\r\n// DefaultPath is the access log path required by meshrouter.\r\nconst DefaultPath = \"/app/logs/access.log\"\r\n\r\nconst maxFileSize = 1 << 20 // 1 MB\r\n\r\n// Logger writes access log entries asynchronously to a JSON-lines file.\r\ntype Logger struct {\r\n"]
