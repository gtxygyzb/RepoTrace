[5719.732077, "o", "     1\tpackage state\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"sync\"\r\n     5\t\t\"time\"\r\n"]
[5719.732149, "o", "     6\t)\r\n     7\t\r\n     8\ttype rateLimiter struct {\r\n     9\t\tmu          sync.Mutex\r\n    10\t\trps         float64\r\n    11\t\tburst       float64\r\n    12\t\ttokens      float64\r\n    13\t\tlast        time.Time\r\n    14\t\tqueueMax    int\r\n    15\t\tqueueDepth  int\r\n"]
[5719.732232, "o", "    16\t\ttimeout     time.Duration\r\n    17\t\trateLimited uint64\r\n    18\t\tqueued      uint64\r\n    19\t\ttimeouts    uint64\r\n    20\t}\r\n    21\t\r\n    22\tfunc newRateLimiter(rps, burst int, queueDepth int, timeoutMs int) *rateLimiter {\r\n    23\t\treturn &rateLimiter{\r\n    24\t\t\trps:      float64(rps),\r\n    25\t\t\tburst:    float64(burst),\r\n    26\t\t\ttokens:   float64(burst),\r\n    27\t\t\t"]
[5719.732312, "o", "last:     time.Now(),\r\n    28\t\t\tqueueMax: queueDepth,\r\n    29\t\t\ttimeout:  time.Duration(timeoutMs) * time.Millisecond,\r\n    30\t\t}\r\n    31\t}\r\n    32\t\r\n    33\tfunc (rl *rateLimiter) update(rps, burst int, queueDepth int, timeoutMs int) {\r\n    34\t\trl.mu.Lock()\r\n    35\t\tdefer rl.mu.Unlock()\r\n    36\t\trl.rps = float64(rps)\r\n    37\t\trl.burst = float64(burst)\r\n    38"]
[5719.732375, "o", "\t\tif rl.tokens > rl.burst {\r\n    39\t\t\trl.tokens = rl.burst\r\n    40\t\t}\r\n    41\t\trl.queueMax = queueDepth\r\n    42\t\trl.timeout = time.Duration(timeoutMs) * time.Millisecond\r\n    43\t}\r\n    44\t\r\n    45\tfunc (rl *rateLimiter) refillLocked(now time.Time) {\r\n    46\t\telapsed := now.Sub(rl.last).Seconds()\r\n"]
[5719.732483, "o", "    47\t\tif elapsed > 0 {\r\n    48\t\t\trl.tokens += rl.rps * elapsed\r\n    49\t\t\tif rl.burst > 0 && rl.tokens > rl.burst {\r\n    50\t\t\t\trl.tokens = rl.burst\r\n    51\t\t\t}\r\n    52\t\t\trl.last = now\r\n    53\t\t}\r\n    54\t}\r\n    55\t\r\n    56\tfunc (rl *rateLimiter) tryAcquireLocked(now time.Time) bool {\r\n    57\t"]
[5719.732551, "o", "\tif rl.rps <= 0 {\r\n    58\t\t\treturn true\r\n    59\t\t}\r\n    60\t\trl.refillLocked(now)\r\n    61\t\tif rl.tokens >= 1 {\r\n    62\t\t\trl.tokens -= 1\r\n    63\t\t\treturn true\r\n    64\t\t}\r\n    65\t\treturn false\r\n    66\t}\r\n"]
[5719.732619, "o", "    67\t\r\n    68\tfunc (rl *rateLimiter) acquire(now time.Time) (bool, bool) {\r\n    69\t\trl.mu.Lock()\r\n    70\t\tif rl.rps <= 0 {\r\n    71\t\t\trl.mu.Unlock()\r\n    72\t\t\treturn true, false\r\n    73\t\t}\r\n    74\t\tif rl.tryAcquireLocked(now) {\r\n    75"]
[5719.732678, "o", "\t\t\trl.mu.Unlock()\r\n    76\t\t\treturn true, false\r\n    77\t\t}\r\n    78\t\tif rl.queueMax <= 0 {\r\n"]
[5719.732739, "o", "    79\t\t\trl.rateLimited++\r\n    80\t\t\trl.mu.Unlock()\r\n    81\t\t\treturn false, false\r\n    82\t\t}\r\n    83\t\tif rl.queueDepth >= rl.queueMax {\r\n    84\t\t\trl.rateLimited++\r\n    85\t\t\trl.mu.Unlock()\r\n    86\t\t\treturn false, false\r\n    87\t\t}\r\n    88\t\trl.queueDepth++\r\n    89\t\trl.queued++\r\n    90\t\trl.mu.Unlock()\r\n    91\t\r\n"]
[5719.732806, "o", "    92\t\tdeadline := now.Add(rl.timeout)\r\n    93\t\tfor {\r\n    94\t\t\trl.mu.Lock()\r\n    95\t\t\tvar wait time.Duration\r\n    96\t\t\tif rl.rps > 0 {\r\n    97\t\t\t\tneeded := 1.0 - rl.tokens\r\n    98\t\t\t\tif needed > 0 {\r\n    99\t\t\t\t\twait = time.Duration(needed / rl.rps * float64(time.Second))\r\n   100\t\t\t"]
[5719.73287, "o", "\t}\r\n   101\t\t\t}\r\n   102\t\t\trl.mu.Unlock()\r\n   103\t\r\n   104\t\t\tif wait <= 0 {\r\n   105\t\t\t\trl.mu.Lock()\r\n   106\t\t\t\tif rl.tryAcquireLocked(time.Now()) {\r\n   107\t\t\t\t\trl.queueDepth--\r\n   108\t\t\t\t\trl.mu.Unlock()\r\n"]
[5719.732929, "o", "   109\t\t\t\t\treturn true, true\r\n   110\t\t\t\t}\r\n   111\t\t\t\trl.mu.Unlock()\r\n   112\t\t\t\tcontinue\r\n   113\t\t\t}\r\n   114\t\r\n   115\t\t\tremaining := time.Until(deadline)\r\n   116\t\t\tif remaining <= 0 {\r\n   117\t\t\t\trl.mu.Lock()\r\n   118\t\t\t\trl.queueDepth--\r\n"]
[5719.732994, "o", "   119\t\t\t\trl.timeouts++\r\n   120\t\t\t\trl.mu.Unlock()\r\n   121\t\t\t\treturn false, true\r\n   122\t\t\t}\r\n   123\t\t\tif wait > remaining {\r\n   124\t\t\t\twait = remaining\r\n   125\t\t\t}\r\n   126\t\t\ttimer := time.NewTimer(wait)\r\n   127\t\t\tselect {\r\n   128\t\t\tcase <-timer.C:\r\n"]
[5719.733051, "o", "   129\t\t\t}\r\n   130\t\t\ttimer.Stop()\r\n   131\t\t}\r\n   132\t}\r\n   133\t\r\n   134\tfunc (rl *rateLimiter) status() (tokens float64, queueDepth int, rateLimited uint64, queued uint64, timeouts uint64, rps float64, burst float64) {\r\n   135\t\trl.mu.Lock()\r\n   136\t\t"]
[5719.733113, "o", "defer rl.mu.Unlock()\r\n   137\t\trl.refillLocked(time.Now())\r\n   138\t\treturn rl.tokens, rl.queueDepth, rl.rateLimited, rl.queued, rl.timeouts, rl.rps, rl.burst\r\n   139\t}\r\n"]
