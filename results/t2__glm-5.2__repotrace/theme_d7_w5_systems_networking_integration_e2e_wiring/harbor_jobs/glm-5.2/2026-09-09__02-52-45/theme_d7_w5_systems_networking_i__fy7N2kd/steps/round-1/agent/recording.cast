[14584.911436, "o", "   268\t\t\t\t\tresult = \"rejected_conn_limit\"\r\n   269\t\t\t\t\tep.Stats.RecordRejection()\r\n   270\t\t\t\t\tclient.Close()\r\n   271\t\t\t\t\treturn\r\n   272\t\t\t\t}\r\n   273\t\t\t}\r\n   274\t\r\n   275\t\t\tbackend, derr := net.Dial(\"tcp\", ep.Address)\r\n"]
[14584.911496, "o", "   276\t\t\tif derr != nil {\r\n   277\t\t\t\tif id != 0 {\r\n   278\t\t\t\t\tep.RemoveConnection(id)\r\n   279\t\t\t\t}\r\n   280\t\t\t\tep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n   281\t\t\t\tif res.Probe {\r\n   282\t\t\t\t\tep.Circuit.RecordProbeResult(false)\r\n"]
[14584.911557, "o", "   283\t\t\t\t} else {\r\n   284\t\t\t\t\tep.Circuit.Open()\r\n   285\t\t\t\t}\r\n   286\t\t\t\tif attempt >= maxRetries {\r\n   287\t\t\t\t\tresult = \"retry_exhausted\"\r\n   288\t\t\t\t\tclient.Close()\r\n   289\t\t\t\t\treturn\r\n   290\t\t\t\t}\r\n"]
[14584.911619, "o", "   291\t\t\t\tretryCount++\r\n   292\t\t\t\tep.Stats.RecordRetry()\r\n   293\t\t\t\tr.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\r\n   294\t\t\t\tcontinue\r\n   295\t\t\t}\r\n   296\t\r\n   297\t\t\tif res.Probe {\r\n   298\t\t\t\tep.Circuit.RecordProbeResult(true)\r\n   299\t\t\t\tvar ok bool\r\n"]
