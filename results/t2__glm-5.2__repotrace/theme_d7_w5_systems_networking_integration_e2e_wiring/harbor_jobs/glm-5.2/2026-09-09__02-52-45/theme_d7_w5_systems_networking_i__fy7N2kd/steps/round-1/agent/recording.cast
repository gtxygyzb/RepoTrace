[4594.941296, "o", "# Update TryAddConnection.\r\n\u001b[?2004l\r"]
[4594.941349, "o", "\u001b[?2004h> "]
[4594.94273, "o", "s = s.replace('''func (ep *EndpointState) TryAddConnection(conn net.Conn, maxConns int) (int64, bool) {\\n\\tep.mu.Lock()\\n\\tdefer ep.mu.Unlock()\\n\\tif ep.ActiveConnections >= maxConns {\\n\\t\\treturn 0, false\\n\\t}\\n\\tid := atomic.AddInt64(&ep.connIDCounter, 1)\\n\\tep.connections[id] = conn\\n\\tep.ActiveConnections++\\n\\treturn id, true\\n}''',\r\n\u001b[?2004l\r"]
[4594.94279, "o", "\u001b[?2004h> "]
[4594.944683, "o", "'''func (ep *EndpointState) TryAddConnection(conn net.Conn, maxConns int) (int64, bool) {\\n\\tep.mu.Lock()\\n\\tdefer ep.mu.Unlock()\\n\\tif ep.ActiveConnections >= maxConns {\\n\\t\\treturn 0, false\\n\\t}\\n\\tid := atomic.AddInt64(&ep.connIDCounter, 1)\\n\\tnow := time.Now()\\n\\tep.connections[id] = &connectionInfo{\\n\\t\\tconn:         conn,\\n\\t\\tclientAddr:   remoteAddr(conn),\\n\\t\\tstart:        now,\\n\\t\\tlastActivity: now,\\n\\t}\\n\\tep.ActiveConnections++\\n\\treturn id, true\\n}''')\r\n\u001b[?2004l\r"]
[4594.944746, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4594.944799, "o", "\u001b[?2004h"]
