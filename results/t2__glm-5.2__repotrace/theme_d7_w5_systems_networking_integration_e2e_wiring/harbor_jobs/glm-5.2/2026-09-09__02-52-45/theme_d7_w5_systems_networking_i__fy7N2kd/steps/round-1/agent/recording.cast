[5756.807796, "o", "   242\t\t\tWeight:      cep.Weight,\r\n   243\t\t\tConfig:      cep,\r\n   244\t\t\tState:       Unknown,\r\n   245\t\t\tCircuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n   246\t\t\tStats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n   247\t\t\tconnections: make(map[int64]*connectionInfo),\r\n   248\t\t}\r\n   249\t}\r\n   250\t"]
