[7408.261797, "o", "    13\ttype request struct {\r\n    14\t\tCmd  string          `json:\"cmd\"`\r\n    15\t\tArgs json.RawMessage `json:\"args\"`\r\n    16\t}\r\n    17\t\r\n    18\ttype response struct {\r\n    19\t\tStatus string          `json:\"status\"`\r\n    20\t\tData   json.RawMessage `json:\"data\"`\r\n    21\t}\r\n    22\t\r\n    23\tfunc main() {\r\n    24\t\tif len(os.Args) < 2 {\r\n    25\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl <command> [args]\")\r\n    26\t\t\tos.Exit(1)\r\n    27\t\t}\r\n    28\t\r\n    29\t\tcliCmd := os.Args[1]\r\n    30\t\targs := make(map[string]interface{})\r\n    31\t\tvar ipcCmd string\r\n    32\t\r\n    33\t\tswitch cliCmd {\r\n    34\t\tcase \"status\":\r\n    35\t\t\tipcCmd = \"list_services\"\r\n    36\t\tcase \"stats\":\r\n    37\t\t\tif len(os.Args) < 3 {\r\n    38\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")\r\n    39\t\t\t\tos.Exit(1)\r\n    40\t\t\t}\r\n    41\t\t\tipcCmd = \"get_stats\"\r\n    42\t\t\targs[\"name\"] = os.Args[2]\r\n    43\t\tcase \"set-weight\":\r\n    44\t\t\tif len(os.Args) < 5 {\r\n    45"]
[7408.261958, "o", "\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")\r\n    46\t\t\t\tos.Exit(1)\r\n    47\t\t\t}\r\n    48\t\t\tweight, err := strconv.Atoi(os.Args[4])\r\n    49\t\t\tif err != nil {\r\n    50\t\t\t\tfmt.Fprintf(os.Stderr, \"invalid weight: %v\\n\", err)\r\n    51\t\t\t\tos.Exit(1)\r\n    52\t\t\t}\r\n    53\t\t\tipcCmd = \"set_weight\"\r\n    54\t\t\targs[\"name\"] = os.Args[2]\r\n    55\t\t\targs[\"address\"] = os.Args[3]\r\n    56\t\t\targs[\"weight\"] = weight\r\n    57\t\tcase \"drain\":\r\n    58\t\t\tif len(os.Args) < 4 {\r\n    59\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")\r\n    60\t\t\t\tos.Exit(1)\r\n    61\t\t\t}\r\n    62\t\t\tipcCmd = \"drain_endpoint\"\r\n    63\t\t\targs[\"name\"] = os.Args[2]\r\n    64\t\t\targs[\"address\"] = os.Args[3]\r\n    65\t\tcase \"health-log\":\r\n"]
[7408.262065, "o", "    66\t\t\tif len(os.Args) < 3 {\r\n    67\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\r\n    68\t\t\t\tos.Exit(1)\r\n    69\t\t\t}\r\n    70\t\t\tipcCmd = \"get_health_log\"\r\n    71\t\t\targs[\"name\"] = os.Args[2]\r\n    72\t\t\tlast := 20\r\n    73\t\t\tfor _, a := range os.Args[3:] {\r\n    74\t\t\t\tif strings.HasPrefix(a, \"--last\") && len(a) > 6 {\r\n    75\t\t\t\t\tif v, err := strconv.Atoi(a[6:]); err == nil {\r\n    76\t\t\t\t\t\tlast = v\r\n    77\t\t\t\t\t}\r\n    78\t\t\t\t}\r\n    79\t\t\t}\r\n"]
[7408.262168, "o", "    80\t\t\targs[\"last_n\"] = last\r\n    81\t\tcase \"resolve\":\r\n    82\t\t\tif len(os.Args) < 3 {\r\n    83\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl resolve <service>\")\r\n    84\t\t\t\tos.Exit(1)\r\n    85\t\t\t}\r\n    86\t\t\tipcCmd = \"resolve\"\r\n    87\t\t\targs[\"name\"] = os.Args[2]\r\n    88\t\tcase \"circuits\":\r\n    89\t\t\tif len(os.Args) < 3 {\r\n    90\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")\r\n    91\t\t\t\tos.Exit(1)\r\n    92\t\t\t}\r\n"]
[7408.262261, "o", "    93\t\t\tipcCmd = \"get_circuit_breakers\"\r\n    94\t\t\targs[\"name\"] = os.Args[2]\r\n    95\t\tcase \"reset-circuit\":\r\n    96\t\t\tif len(os.Args) < 4 {\r\n    97\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl reset-circuit <service> <endpoint>\")\r\n    98\t\t\t\tos.Exit(1)\r\n    99\t\t\t}\r\n   100\t\t\tipcCmd = \"reset_circuit_breaker\"\r\n   101\t\t\targs[\"name\"] = os.Args[2]\r\n   102\t\t\targs[\"address\"] = os.Args[3]\r\n   103\t\tcase \"reload\":\r\n   104\t\t\tipcCmd = \"reload_config\"\r\n   105\t\t"]
[7408.262355, "o", "case \"rate-limit\":\r\n   106\t\t\tif len(os.Args) < 3 {\r\n   107\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl rate-limit <service>\")\r\n   108\t\t\t\tos.Exit(1)\r\n   109\t\t\t}\r\n   110\t\t\tipcCmd = \"get_rate_limit_status\"\r\n   111\t\t\targs[\"name\"] = os.Args[2]\r\n   112\t\tcase \"warmup\":\r\n   113\t\t\tif len(os.Args) < 3 {\r\n   114\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl warmup <service>\")\r\n   115\t\t\t\tos.Exit(1)\r\n   116\t\t\t}\r\n"]
[7408.262557, "o", "   117\t\t\tipcCmd = \"get_warmup_status\"\r\n   118\t\t\targs[\"name\"] = os.Args[2]\r\n   119\t\tcase \"connections\":\r\n   120\t\t\tif len(os.Args) < 3 {\r\n   121\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl connections <service>\")\r\n   122\t\t\t\tos.Exit(1)\r\n   123\t\t\t}\r\n   124\t\t\tipcCmd = \"get_connections\"\r\n   125\t\t\targs[\"name\"] = os.Args[2]\r\n   126\t\tcase \"set-rate-limit\":\r\n   127\t\t\tif len(os.Args) < 5 {\r\n   128\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-rate-limit <service> <rps> <burst>\")\r\n   129\t\t\t\tos.Exit(1)\r\n   130\t\t\t}\r\n   131\t\t\trps, err := strconv.Atoi(os.Args[3])\r\n   132\t\t\tif err != nil {\r\n   133\t\t\t\tfmt.Fprintf(os.Stderr, \"invalid rps: %v\\n\", err)\r\n   134\t\t\t\tos.Exit(1)\r\n   135\t\t\t}\r\n   136\t\t\tburst, err := strconv.Atoi(os.Args[4])\r\n   137\t\t\tif err != nil {\r\n   138\t\t\t\tfmt.Fprintf(os.Stderr, \"invalid burst: %v\\n\", err)\r\n   139\t\t\t\tos.Exit(1)\r\n   140\t\t\t}\r\n   141\t\t\tipcCmd = \"set_rate_limit\"\r\n   142\t\t"]
[7408.262657, "o", "\targs[\"name\"] = os.Args[2]\r\n   143\t\t\targs[\"rps\"] = rps\r\n   144\t\t\targs[\"burst\"] = burst\r\n   145\t\tdefault:\r\n   146\t\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cliCmd)\r\n   147\t\t\tos.Exit(1)\r\n   148\t\t}\r\n   149\t\r\n   150\t\tdata, err := sendCommand(ipcCmd, args)\r\n   151\t\tif err != nil {\r\n   152\t\t\tfmt.Fprintln(os.Stderr, err)\r\n   153\t\t\tos.Exit(1)\r\n   154\t\t}\r\n   155\t\tfmt.Println(data)"]
[7408.262751, "o", "\r\n   156\t}\r\n   157\t\r\n   158\tfunc sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n   159\t\trawArgs, err := json.Marshal(args)\r\n   160\t\tif err != nil {\r\n   161\t\t\treturn \"\", err\r\n   162\t\t}\r\n   163\t\treq := request{Cmd: ipcCmd, Args: rawArgs}\r\n   164\t\treqBytes, err := json.Marshal(req)\r\n   165\t\tif err != nil {\r\n   166\t\t\treturn \"\", err\r\n   167\t\t}\r\n   168\t\r\n   169\t\tconn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n   170\t\tif err != nil {\r\n   171\t\t\treturn \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n"]
[7408.262842, "o", "   172\t\t}\r\n   173\t\tdefer conn.Close()\r\n   174\t\r\n   175\t\tfmt.Fprintf(conn, \"%s\\n\", string(reqBytes))\r\n   176\t\r\n"]
[7408.262917, "o", "   177\t\treader := bufio.NewReader(conn)\r\n   178\t\tline, err := reader.ReadString('\\n')\r\n   179\t\tif err != nil {\r\n   180\t\t\treturn \"\", err\r\n   181\t\t}\r\n   182\t\tline = strings.TrimRight(line, \"\\r\\n\")\r\n   183\t\r\n   184\t\tvar resp response\r\n   185\t\tif err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n   186\t\t\treturn \"\", err\r\n   187\t\t}\r\n   188\t\tif resp.Status != \"ok\" {\r\n   189\t\t\tvar msg string\r\n   190\t\t\tif err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n   191\t\t\t\treturn \"\", fmt.Errorf(\"%s\", msg)\r\n   192\t\t\t}\r\n   193\t\t\treturn \"\", fmt.Errorf(\"%s\", string(resp.Data))\r\n   194\t\t}\r\n   195\t\treturn prettyData(ipcCmd, resp.Data)\r\n"]
[7408.26301, "o", "   196\t}\r\n   197\t\r\n   198\tfunc prettyData(ipcCmd string, data json.RawMessage) (string, error) {\r\n   199\t\tswitch ipcCmd {\r\n   200\t\tcase \"list_services\":\r\n   201\t\t\tvar services []struct {\r\n   202\t\t\t\tName        string `json:\"name\"`\r\n   203\t\t\t\tListenPort  int    `json:\"listen_port\"`\r\n   204\t\t\t\tRoutingMode string `json:\"routing_mode\"`\r\n   205\t\t\t\tEndpoints   []struct {\r\n   206\t\t\t\t\tAddress           string `json:\"address\"`\r\n   207\t\t\t\t\tState             string `json:\"state\"`\r\n   208\t\t\t\t\tWeight            int    `json:\"weight\"`\r\n"]
[7408.263102, "o", "   209\t\t\t\t\tActiveConnections int    `json:\"active_connections\"`\r\n   210\t\t\t\t\tCircuitState      string `json:\"circuit_state\"`\r\n   211\t\t\t\t} `json:\"endpoints\"`\r\n   212\t\t\t}\r\n   213\t\t\tif err := json.Unmarshal(data, &services); err != nil {\r\n   214\t\t\t\treturn \"\", err\r\n   215\t\t\t}\r\n   216\t\t\tvar b strings.Builder\r\n   217\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\r\n   218\t\t\tfor _, svc := range services {\r\n   219\t\t\t\tfor _, ep := range svc.Endpoints {\r\n   220\t\t\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\r\n"]
[7408.26319, "o", "   221\t\t\t\t}\r\n   222\t\t\t}\r\n   223\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   224\t\tcase \"resolve\":\r\n   225\t\t\tvar addr string\r\n   226\t\t\tif err := json.Unmarshal(data, &addr); err != nil {\r\n   227\t\t\t\treturn \"\", err\r\n   228\t\t\t}\r\n   229\t\t\treturn addr, nil\r\n   230\t\tcase \"get_circuit_breakers\":\r\n   231\t\t\tvar circuits []struct {\r\n   232\t\t\t\tAddress             string `json:\"address\"`\r\n   233\t\t\t\tCircuitState        string `json:\"circuit_state\"`\r\n"]
[7408.263282, "o", "   234\t\t\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n   235\t\t\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n   236\t\t\t\tProbeActive         bool   `json:\"probe_active\"`\r\n   237\t\t\t}\r\n   238\t\t\tif err := json.Unmarshal(data, &circuits); err != nil {\r\n   239\t\t\t\treturn \"\", err\r\n   240\t\t\t}\r\n   241\t\t\tvar b strings.Builder\r\n   242\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9s %-17s %-7s\\n\", \"ENDPOINT\", \"CIRCUIT\", \"FAILURES\", \"TIME_IN_STATE_MS\", \"PROBE\")\r\n   243\t\t\tfor _, c := range circuits {\r\n   244\t\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9d %-17d %-7t\\n\", c.Address, c.CircuitState, c.ConsecutiveFailures, c.TimeInStateMs, c.ProbeActive)\r\n"]
[7408.263352, "o", "   245\t\t\t}\r\n   246\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   247\t\tcase \"get_warmup_status\":\r\n   248\t\t\tvar resp struct {\r\n   249\t\t\t\tEndpoints []struct {\r\n   250\t\t\t\t\tEndpoint          string `json:\"endpoint\"`\r\n   251\t\t\t\t\tWarmingUp         bool   `json:\"warming_up\"`\r\n   252\t\t\t\t\tWarmupRemainingMs int    `json:\"warmup_remaining_ms\"`\r\n   253\t\t\t\t\tEffectiveWeight   int    `json:\"effective_weight\"`\r\n   254\t\t\t\t\tConfigWeight      int    `json:\"config_weight\"`\r\n"]
[7408.263437, "o", "   255\t\t\t\t} `json:\"endpoints\"`\r\n   256\t\t\t}\r\n   257\t\t\tif err := json.Unmarshal(data, &resp); err != nil {\r\n   258\t\t\t\treturn \"\", err\r\n   259\t\t\t}\r\n   260\t\t\tvar b strings.Builder\r\n"]
