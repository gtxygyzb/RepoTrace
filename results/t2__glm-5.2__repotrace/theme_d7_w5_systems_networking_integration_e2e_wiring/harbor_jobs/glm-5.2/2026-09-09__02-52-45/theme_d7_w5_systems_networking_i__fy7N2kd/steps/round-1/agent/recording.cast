[13876.233648, "o", "     1\tpackage ipc\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"errors\"\r\n     7\t\t\"fmt\"\r\n"]
[13876.233747, "o", "     8\t\t\"net\"\r\n     9\t\t\"os\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t\t\"sync\"\r\n    13\t\r\n    14\t\t\"meshrouter/internal/accesslog\"\r\n    15\t\t\"meshrouter/internal/config\"\r\n    16\t\t\"meshrouter/internal/state\"\r\n    17\t)\r\n    18\t\r\n    19\ttype Request struct {\r\n    20\t\tCmd  string          `json:\"cmd\"`\r\n    21\t\tArgs json.RawMessage `json:\"args\"`\r\n    22\t}\r\n    23\t\r\n"]
[13876.233824, "o", "    24\ttype Response struct {\r\n    25\t\tStatus string      `json:\"status\"`\r\n    26\t\tData   interface{} `json:\"data\"`\r\n    27\t}\r\n    28\t\r\n    29\ttype Server struct {\r\n    30\t\tstate    *state.State\r\n    31\t\tpath     string\r\n    32\t\tlistener net.Listener\r\n    33\t\twg       sync.WaitGroup\r\n    34\t\tstop     chan struct{}\r\n    35\t\tdone     chan struct{}\r\n"]
[13876.233887, "o", "    36\t}\r\n    37\t\r\n    38\tfunc NewServer(s *state.State, path string) *Server {\r\n    39\t\treturn &Server{\r\n    40\t\t\tstate: s,\r\n    41\t\t\tpath:  path,\r\n    42\t\t\tstop:  make(chan struct{}),\r\n"]
[13876.233954, "o", "    43\t\t\tdone:  make(chan struct{}),\r\n    44\t\t}\r\n    45\t}\r\n    46\t\r\n    47\tfunc (s *Server) Start() error {\r\n    48\t\tos.Remove(s.path)\r\n    49\t\tln, err := net.Listen(\"unix\", s.path)\r\n    50\t\tif err != nil {\r\n    51\t\t\treturn err\r\n    52\t\t}\r\n    53\t\t"]
[13876.23403, "o", "s.listener = ln\r\n    54\t\tgo s.acceptLoop()\r\n    55\t\treturn nil\r\n    56\t}\r\n    57\t\r\n    58\tfunc (s *Server) Stop() {\r\n    59\t\tselect {\r\n    60\t\tcase <-s.stop:\r\n    61\t\tdefault:\r\n    62\t\t\tclose(s.stop)\r\n    63\t\t}\r\n    64\t\tif s.listener != nil {\r\n"]
[13876.234089, "o", "    65\t\t\ts.listener.Close()\r\n    66\t\t}\r\n    67\t\t<-s.done\r\n    68\t\tos.Remove(s.path)\r\n    69\t}\r\n    70\t\r\n    71\tfunc (s *Server) acceptLoop() {\r\n    72\t\tdefer close(s.done)\r\n    73\t\tfor {\r\n    74\t"]
[13876.234152, "o", "\t\tconn, err := s.listener.Accept()\r\n    75\t\t\tif err != nil {\r\n    76\t\t\t\treturn\r\n    77\t\t\t}\r\n    78\t\t\ts.wg.Add(1)\r\n    79\t\t\tgo s.handleConn(conn)\r\n    80\t\t}\r\n    81\t}\r\n    82\t\r\n    83\tfunc (s *Server) handleConn(conn net.Conn) {\r\n"]
[13876.234208, "o", "    84\t\tdefer s.wg.Done()\r\n    85\t\tdefer conn.Close()\r\n    86\t\treader := bufio.NewReader(conn)\r\n    87\t\tfor {\r\n    88\t\t\tline, err := reader.ReadString('\\n')\r\n    89\t\t\tif err != nil {\r\n    90\t\t\t\treturn\r\n    91\t\t\t}\r\n    92"]
[13876.234268, "o", "\t\t\tline = strings.TrimRight(line, \"\\r\\n\")\r\n    93\t\t\tif line == \"\" {\r\n    94\t\t\t\tcontinue\r\n    95\t\t\t}\r\n    96\t\t\tresp := s.handleLine(line)\r\n    97\t\t\t_, _ = conn.Write([]byte(resp + \"\\n\"))\r\n    98\t\t}\r\n    99\t}\r\n   100\t\r\n"]
[13876.234329, "o", "   101\tfunc (s *Server) handleLine(line string) string {\r\n   102\t\tvar req Request\r\n   103\t\tif err := json.Unmarshal([]byte(line), &req); err != nil {\r\n   104\t\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n   105\t\t}\r\n   106\t\tdata, err := s.dispatch(req)\r\n   107\t\tif err != nil {\r\n   108\t\t\t"]
[13876.234426, "o", "return encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n   109\t\t}\r\n   110\t\treturn encodeResp(Response{Status: \"ok\", Data: data})\r\n   111\t}\r\n   112\t\r\n   113\tfunc encodeResp(r Response) string {\r\n   114\t\tb, _ := json.Marshal(r)\r\n"]
[13876.234483, "o", "   115\t\treturn string(b)\r\n   116\t}\r\n   117\t\r\n   118\tfunc (s *Server) dispatch(req Request) (interface{}, error) {\r\n   119\t\tswitch req.Cmd {\r\n   120\t\tcase \"list_services\":\r\n"]
