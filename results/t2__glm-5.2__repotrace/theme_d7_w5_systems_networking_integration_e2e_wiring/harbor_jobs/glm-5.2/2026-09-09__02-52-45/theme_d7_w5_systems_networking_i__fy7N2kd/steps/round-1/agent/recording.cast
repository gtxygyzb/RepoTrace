[8324.443922, "o", "\t\tName  string `json:\"name\"`\r\n   272\t\t\t\tRps   int    `json:\"rps\"`\r\n   273\t\t\t\tBurst int    `json:\"burst\"`\r\n   274\t\t\t}\r\n   275\t\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n   276\t\t\t\treturn nil, err\r\n   277\t\t\t}\r\n   278\t\t\tif err := s.state.SetRateLimit(args.Name, args.Rps, args.Burst); err != nil {\r\n   279\t\t\t\treturn nil, err\r\n   280\t\t\t}\r\n   281\t\t\treturn \"OK\", nil\r\n   282\t\tdefault:\r\n   283\t\t\treturn nil, fmt.Errorf(\"unknown command: %s\", req.Cmd)\r\n"]
