[11291.714323, "o", "\u001b[?2004h> "]
[11291.714424, "o", "\\tfor _, dep := range deps {\r\n\u001b[?2004l\r"]
[11291.714497, "o", "\u001b[?2004h> "]
[11291.714686, "o", "\\t\\tavailable, healthy := s.CheckDependency(dep)\r\n\u001b[?2004l\r"]
[11291.714763, "o", "\u001b[?2004h> "]
[11291.715171, "o", "\\t\\tstatuses = append(statuses, DependencyStatus{Name: dep, Available: available, HealthyEndpoints: healthy})\r\n\u001b[?2004l\r"]
[11291.715246, "o", "\u001b[?2004h> "]
[11291.715365, "o", "\\t\\tif failed == \"\" && !available {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11291.715425, "o", "> "]
[11291.715493, "o", "\\t\\t\\tfailed = dep\r\n\u001b[?2004l\r"]
[11291.715597, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[11291.715682, "o", "\u001b[?2004h> "]
[11291.715771, "o", "\\treturn failed, statuses\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[11291.715852, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
