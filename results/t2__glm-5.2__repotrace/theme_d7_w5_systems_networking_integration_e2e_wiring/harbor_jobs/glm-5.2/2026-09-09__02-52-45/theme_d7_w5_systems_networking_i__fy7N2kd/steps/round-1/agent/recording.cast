[4130.464848, "o", "defer ss.mu.Unlock()\r\n   199\t\tseen := make(map[string]bool)\r\n   200\t\tfor _, cep := range eps {\r\n   201\t\t\tseen[cep.Address] = true\r\n   202\t\t\tvar ep *EndpointState\r\n   203\t\t\tfor _, existing := range ss.Endpoints {\r\n   204\t\t\t\tif existing.Address == cep.Address {\r\n   205\t\t\t\t\tep = existing\r\n"]
[4130.464903, "o", "   206\t\t\t\t\tbreak\r\n   207\t\t\t\t}\r\n   208\t\t\t}\r\n   209\t\t\tif ep == nil {\r\n   210\t\t\t\tep = newEndpointState(cep, global)\r\n   211\t\t\t\tss.Endpoints = append(ss.Endpoints, ep)\r\n   212\t\t\t} else {\r\n   213\t\t\t\tep.mu.Lock()\r\n"]
[4130.464962, "o", "   214\t\t\t\tep.Config = cep\r\n   215\t\t\t\tep.Weight = cep.Weight\r\n   216\t\t\t\tep.mu.Unlock()\r\n   217\t\t\t}\r\n   218\t\t}\r\n   219\t\tfor _, ep := range ss.Endpoints {\r\n   220\t\t\tif !seen[ep.Address] {\r\n   221\t"]
[4130.465025, "o", "\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   222\t\t\t}\r\n   223\t\t}\r\n   224\t}\r\n   225\t\r\n   226\tfunc newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {\r\n   227\t\treturn &EndpointState{\r\n   228\t\t\tAddress:     cep.Address,\r\n   229\t\t\tWeight:      cep.Weight,\r\n   230"]
[4130.465083, "o", "\t\t\tConfig:      cep,\r\n   231\t\t\tState:       Unknown,\r\n   232\t\t\tCircuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n   233\t\t\tStats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n   234\t\t\tconnections: make(map[int64]net.Conn),\r\n   235\t\t}\r\n   236\t}\r\n   237\t\r\n"]
[4130.465143, "o", "   238\tfunc (s *State) GetService(name string) *ServiceState {\r\n   239\t\ts.mu.RLock()\r\n   240\t\tdefer s.mu.RUnlock()\r\n   241\t\treturn s.services[name]\r\n   242\t}\r\n   243\t\r\n   244\tfunc (s *State) Services() []*ServiceState {\r\n   245\t\ts.mu.RLock()\r\n"]
[4130.465225, "o", "   246\t\tdefer s.mu.RUnlock()\r\n   247\t\tout := make([]*ServiceState, 0, len(s.services))\r\n   248\t\tfor _, ss := range s.services {\r\n   249\t\t\tout = append(out, ss)\r\n   250\t\t}\r\n   251\t\treturn out\r\n   252\t}\r\n   253\t\r\n   254\tfunc (s *State) GetEndpoint(service, address string) *EndpointState {\r\n   255\t\tss := s.GetService(service)\r\n   256\t\tif ss == nil {\r\n   257\t\t\treturn nil\r\n"]
[4130.465284, "o", "   258\t\t}\r\n   259\t\tss.mu.Lock()\r\n   260\t\tdefer ss.mu.Unlock()\r\n   261\t\tfor _, ep := range ss.Endpoints {\r\n   262\t\t\tif ep.Address == address {\r\n   263\t\t\t\treturn ep\r\n   264\t\t\t}\r\n"]
[4130.465353, "o", "   265\t\t}\r\n   266\t\treturn nil\r\n   267\t}\r\n   268\t\r\n   269\tfunc (s *State) SetWeight(service, address string, weight int) error {\r\n"]
[4130.465427, "o", "   270\t\tep := s.GetEndpoint(service, address)\r\n   271\t\tif ep == nil {\r\n   272\t\t\treturn errNotFound(\"endpoint not found\")\r\n   273\t\t}\r\n   274\t\tep.mu.Lock()\r\n   275\t\tdefer ep.mu.Unlock()\r\n   276\t\tif weight < 0 {\r\n   277\t\t\tweight = 0\r\n   278\t\t}\r\n   279\t\tep.Weight = weight\r\n   280\t\treturn nil\r\n"]
