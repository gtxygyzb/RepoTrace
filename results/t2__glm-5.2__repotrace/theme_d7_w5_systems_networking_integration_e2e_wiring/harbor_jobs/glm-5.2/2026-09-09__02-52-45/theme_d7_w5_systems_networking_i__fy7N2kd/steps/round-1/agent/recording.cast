[6817.316506, "o", "   161\t\t\t\tTimestamp:   e.Timestamp,\r\n   162\t\t\t\tEndpoint:    e.Endpoint,\r\n   163\t\t\t\tOldState:    string(e.OldState),\r\n   164\t\t\t\tNewState:    string(e.NewState),\r\n   165\t\t\t\tCheckResult: e.CheckResult,\r\n   166\t\t\t})\r\n   167\t\t}\r\n   168\t\treturn out\r\n   169\t}\r\n   170\t\r\n   171\ttype CircuitView struct {\r\n   172\t\tAddress             string `json:\"address\"`\r\n"]
[6817.316576, "o", "   173\t\tCircuitState        string `json:\"circuit_state\"`\r\n   174\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n   175\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n   176\t\tProbeActive         bool   `json:\"probe_active\"`\r\n   177\t}\r\n   178\t\r\n   179\tfunc (s *State) CircuitsView(name string) ([]CircuitView, bool) {\r\n   180\t\tss := s.GetService(name)\r\n   181\t\tif ss == nil {\r\n   182\t\t\treturn nil, false\r\n"]
[6817.316644, "o", "   183\t\t}\r\n   184\t\tss.mu.Lock()\r\n   185\t\tout := make([]CircuitView, 0, len(ss.Endpoints))\r\n   186\t\tfor _, ep := range ss.Endpoints {\r\n   187\t\t\tep.mu.Lock()\r\n   188\t\t\tout = append(out, CircuitView{\r\n   189\t\t\t\tAddress:             ep.Address,\r\n   190\t\t\t\tCircuitState:        string(ep.Circuit.State()),\r\n   191\t\t\t\tConsecutiveFailures: ep.Circuit.ConsecutiveFailures(),\r\n"]
[6817.316714, "o", "   192\t\t\t\tTimeInStateMs:       ep.Circuit.TimeInStateMs(),\r\n   193\t\t\t\tProbeActive:         ep.Circuit.ProbeActive(),\r\n   194\t\t\t})\r\n   195\t\t\tep.mu.Unlock()\r\n   196\t\t}\r\n   197\t\tss.mu.Unlock()\r\n   198\t\treturn out, true\r\n   199\t}\r\n   200\t\r\n   201\tfunc (s *State) ResolveEndpoint(service string) (string, error) {\r\n   202\t\tss := s.GetService(service)\r\n   203\t\tif ss == nil {"]
[6817.316781, "o", "\r\n   204\t\t\treturn \"\", errNotFound(\"service not found\")\r\n   205\t\t}\r\n"]
