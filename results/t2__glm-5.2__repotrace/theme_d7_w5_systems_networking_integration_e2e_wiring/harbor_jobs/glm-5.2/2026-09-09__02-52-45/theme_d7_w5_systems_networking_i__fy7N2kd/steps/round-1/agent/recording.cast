[11724.509434, "o", "\u001b[?2004h>                         return nil, fmt.Errorf(\"%s\", msg)\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h>                 return nil, fmt.Errorf(\"%s\", string(resp.Data))\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         return resp.Data, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> if 'func depsAll()' not in s:\r\n\u001b[?2004l\r\u001b[?2004h>     s = s.replace(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11724.509708, "o", "'''func sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {''',\r\n\u001b[?2004l\r"]
[11724.509794, "o", "\u001b[?2004h> "]
[11724.509982, "o", "'''func depsAll() (string, error) {\r\n\u001b[?2004l\r"]
[11724.510026, "o", "\u001b[?2004h> "]
[11724.51032, "o", "        raw, err := sendRaw(\"list_services\", nil)\r\n\u001b[?2004l\r"]
[11724.510379, "o", "\u001b[?2004h> "]
[11724.510519, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11724.51057, "o", "\u001b[?2004h> "]
[11724.510753, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11724.510819, "o", "\u001b[?2004h> "]
[11724.510871, "o", "        }\r\n\u001b[?2004l\r"]
[11724.510934, "o", "\u001b[?2004h> "]
[11724.511111, "o", "        var services []struct {\r\n\u001b[?2004l\r"]
[11724.511176, "o", "\u001b[?2004h> "]
[11724.511421, "o", "                Name string `json:\"name\"`\r\n\u001b[?2004l\r"]
[11724.511484, "o", "\u001b[?2004h> "]
[11724.511544, "o", "        }\r\n\u001b[?2004l\r"]
[11724.511607, "o", "\u001b[?2004h> "]
[11724.511969, "o", "        if err := json.Unmarshal(raw, &services); err != nil {\r\n\u001b[?2004l\r"]
[11724.51202, "o", "\u001b[?2004h> "]
[11724.5122, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11724.512259, "o", "\u001b[?2004h> "]
[11724.512319, "o", "        }\r\n\u001b[?2004l\r"]
[11724.512376, "o", "\u001b[?2004h> "]
[11724.512551, "o", "        type depRow struct {\r\n\u001b[?2004l\r"]
[11724.512609, "o", "\u001b[?2004h> "]
[11724.512834, "o", "                Service          string\r\n\u001b[?2004l\r"]
[11724.512891, "o", "\u001b[?2004h> "]
[11724.513117, "o", "                Name             string\r\n\u001b[?2004l\r"]
[11724.513174, "o", "\u001b[?2004h> "]
[11724.513397, "o", "                Available        bool\r\n\u001b[?2004l\r"]
[11724.513446, "o", "\u001b[?2004h> "]
[11724.513664, "o", "                HealthyEndpoints int\r\n\u001b[?2004l\r"]
[11724.513727, "o", "\u001b[?2004h> "]
[11724.513783, "o", "        }\r\n\u001b[?2004l\r"]
[11724.513845, "o", "\u001b[?2004h> "]
[11724.513988, "o", "        var rows []depRow\r\n\u001b[?2004l\r"]
[11724.514053, "o", "\u001b[?2004h> "]
[11724.514266, "o", "        for _, svc := range services {\r\n\u001b[?2004l\r"]
[11724.514333, "o", "\u001b[?2004h> "]
[11724.514893, "o", "                depRaw, err := sendRaw(\"get_dependencies\", map[string]interface{}{\"name\": svc.Name})\r\n\u001b[?2004l\r"]
[11724.514941, "o", "\u001b[?2004h> "]
[11724.515134, "o", "                if err != nil {\r\n\u001b[?2004l\r"]
[11724.515197, "o", "\u001b[?2004h> "]
[11724.515415, "o", "                        return \"\", err\r\n\u001b[?2004l\r"]
[11724.515484, "o", "\u001b[?2004h> "]
[11724.515579, "o", "                }\r\n\u001b[?2004l\r"]
[11724.515643, "o", "\u001b[?2004h> "]
[11724.51583, "o", "                var resp struct {\r\n\u001b[?2004l\r"]
[11724.515885, "o", "\u001b[?2004h> "]
[11724.516229, "o", "                        Service      string `json:\"service\"`\r\n\u001b[?2004l\r"]
[11724.516292, "o", "\u001b[?2004h> "]
[11724.516562, "o", "                        Dependencies []struct {\r\n\u001b[?2004l\r"]
[11724.51661, "o", "\u001b[?2004h> "]
[11724.517011, "o", "                                Name             string `json:\"name\"`\r\n\u001b[?2004l\r"]
[11724.517071, "o", "\u001b[?2004h> "]
[11724.517498, "o", "                                Available         bool   `json:\"available\"`\r\n\u001b[?2004l\r"]
[11724.517556, "o", "\u001b[?2004h> "]
[11724.518017, "o", "                                HealthyEndpoints int    `json:\"healthy_endpoints\"`\r\n\u001b[?2004l\r"]
[11724.518067, "o", "\u001b[?2004h> "]
[11724.518345, "o", "                        } `json:\"dependencies\"`\r\n\u001b[?2004l\r"]
[11724.518418, "o", "\u001b[?2004h> "]
[11724.518514, "o", "                }\r\n\u001b[?2004l\r"]
[11724.518577, "o", "\u001b[?2004h> "]
[11724.518967, "o", "                if err := json.Unmarshal(depRaw, &resp); err != nil {\r\n\u001b[?2004l\r"]
[11724.519023, "o", "\u001b[?2004h> "]
[11724.51924, "o", "                        return \"\", err\r\n\u001b[?2004l\r"]
[11724.519298, "o", "\u001b[?2004h> "]
[11724.519412, "o", "                }\r\n\u001b[?2004l\r"]
[11724.519469, "o", "\u001b[?2004h> "]
[11724.51978, "o", "                for _, dep := range resp.Dependencies {\r\n\u001b[?2004l\r"]
[11724.519846, "o", "\u001b[?2004h> "]
[11724.520695, "o", "                        rows = append(rows, depRow{Service: svc.Name, Name: dep.Name, Available: dep.Available, HealthyEndpoints: dep.HealthyEndpoints})\r\n\u001b[?2004l\r"]
[11724.520771, "o", "\u001b[?2004h> "]
[11724.520859, "o", "                }\r\n\u001b[?2004l\r"]
