[2096.206374, "o", "package state\r\n\r\nimport (\r\n\t\"sort\"\r\n\t\"time\"\r\n"]
[2096.206606, "o", "\r\n\t\"meshrouter/internal/stats\"\r\n)\r\n\r\ntype EndpointView struct {\r\n\tAddress           string `json:\"address\"`\r\n\tState             string `json:\"state\"`\r\n\tWeight            int    `json:\"weight\"`\r\n\tActiveConnections int    `json:\"active_connections\"`\r\n\tCircuitState      string `json:\"circuit_state\"`\r\n}\r\n\r\ntype ServiceView struct {\r\n\tName        string         `json:\"name\"`\r\n\tListenPort  int            `json:\"listen_port\"`\r\n\tRoutingMode string         `json:\"routing_mode\"`\r\n\tEndpoints   []EndpointView `json:\"endpoints\"`\r\n}\r\n\r\nfunc (s *State) ServiceView(name string) (ServiceView, bool) {\r\n\tss := s.GetService(name)\r\n\tif ss == nil {\r\n\t\treturn ServiceView{}, false\r\n\t}\r\n\treturn ss.View(), true\r\n}\r\n\r\nfunc (s *State) ServicesView() []ServiceView {\r\n\tservices := s.Services()\r\n\tout := make([]ServiceView, 0, len(services))\r\n\tfor _, ss := range services {\r\n\t\tout = append(out, ss.View())\r\n\t}\r\n\tsort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })\r\n\treturn out\r\n}\r\n\r\nfunc (ss *ServiceState) View() ServiceV"]
[2096.206716, "o", "iew {\r\n\tss.mu.Lock()\r\n\tdefer ss.mu.Unlock()\r\n\tsv := ServiceView{\r\n\t\tName:        ss.Name,\r\n\t\tListenPort:  ss.ListenPort,\r\n\t\tRoutingMode: ss.RoutingMode,\r\n\t\tEndpoints:   make([]EndpointView, 0, len(ss.Endpoints)),\r\n"]
[2096.206791, "o", "\t}\r\n\tfor _, ep := range ss.Endpoints {\r\n\t\tep.mu.Lock()\r\n\t\tsv.Endpoints = append(sv.Endpoints, EndpointView{\r\n\t\t\tAddress:           ep.Address,\r\n\t\t\tState:             string(ep.State),\r\n\t\t\tWeight:            ep.Weight,\r\n\t\t\tActiveConnections: ep.ActiveConnections,\r\n\t\t\tCircuitState:      string(ep.Circuit.State()),\r\n\t\t})\r\n\t\tep.mu.Unlock()\r\n\t}\r\n\treturn sv\r\n}\r\n\r\ntype StatsEndpointView struct {\r\n\tAddress string `json:\"address\"`\r\n\tstats.Snapshot\r\n}\r\n\r\ntype StatsView struct {\r\n\tService   string              `json:\"service\"`\r\n"]
[2096.20686, "o", "\tWindowSec int                 `json:\"window_sec\"`\r\n\tEndpoints []StatsEndpointView `json:\"endpoints\"`\r\n}\r\n\r\nfunc (s *State) StatsView(name string, windowSec int) (StatsView, bool) {\r\n\tss := s.GetService(name)\r\n\tif ss == nil {\r\n\t\treturn StatsView{}, false\r\n\t}\r\n\tsv := StatsView{\r\n\t\tService:   name,\r\n\t\tWindowSec: windowSec,\r\n\t"]
[2096.206925, "o", "\tEndpoints: make([]StatsEndpointView, 0),\r\n\t}\r\n\tss.mu.Lock()\r\n\tfor _, ep := range ss.Endpoints {\r\n\t\tep.mu.Lock()\r\n\t\tsv.Endpoints = append(sv.Endpoints, StatsEndpointView{\r\n\t\t\tAddress:  ep.Address,\r\n\t\t\tSnapshot: ep.Stats.Snapshot(ep.ActiveConnections),\r\n\t\t})\r\n\t\tep.mu.Unlock()\r\n"]
[2096.207007, "o", "\t}\r\n\tss.mu.Unlock()\r\n\treturn sv, true\r\n}\r\n\r\ntype HealthEventView struct {\r\n\tTimestamp   time.Time `json:\"timestamp\"`\r\n\tEndpoint    string    `json:\"endpoint\"`\r\n\tOldState    string    `json:\"old_state\"`\r\n\tNewState    string    `json:\"new_state\"`\r\n\tCheckResult string    `json:\"check_result\"`\r\n}\r\n\r\nfunc (s *State) HealthLogView(name string, lastN int) []HealthEventView {\r\n\tevents := s.HealthLog(name, lastN)\r\n"]
[2096.207071, "o", "\tout := make([]HealthEventView, 0, len(events))\r\n\tfor _, e := range events {\r\n\t\tout = append(out, HealthEventView{\r\n\t\t\tTimestamp:   e.Timestamp,\r\n\t\t\tEndpoint:    e.Endpoint,\r\n\t\t\tOldState:    string(e.OldState),\r\n\t\t\tNewState:    string(e.NewState),\r\n\t\t\tCheckResult: e.CheckResult,\r\n\t\t})\r\n\t}\r\n\treturn out\r\n"]
