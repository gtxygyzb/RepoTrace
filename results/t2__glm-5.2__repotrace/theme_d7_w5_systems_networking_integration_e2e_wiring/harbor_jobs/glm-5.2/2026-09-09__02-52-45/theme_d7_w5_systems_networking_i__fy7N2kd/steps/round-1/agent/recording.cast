[12974.657449, "o", "     1\tpackage config\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"log\"\r\n     5\t\r\n     6\t\t\"github.com/BurntSushi/toml\"\r\n     7\t)\r\n     8\t\r\n     9\t// Global holds mesh-wide tuning parameters.\r\n    10\ttype Global struct {\r\n    11\t\tHealthIntervalMs        int `toml:\"health_interval_ms\"`\r\n    12\t\tUnhealthyThreshold      int `toml:\"unhealthy_threshold\"`\r\n    13\t\tHealthyThreshold        int `toml:\"healthy_threshold\"`\r\n    14\t"]
[12974.657569, "o", "\tStatsWindowSec          int `toml:\"stats_window_sec\"`\r\n    15\t\tCircuitBreakerThreshold int `toml:\"circuit_breaker_threshold\"`\r\n    16\t\tCircuitBreakerTimeoutMs int `toml:\"circuit_breaker_timeout_ms\"`\r\n    17\t}\r\n    18\t\r\n    19\t// Endpoint describes one backend endpoint from config.\r\n    20\ttype Endpoint struct {\r\n    21\t\tAddress          string `toml:\"address\"`"]
[12974.65769, "o", "\r\n    22\t\tWeight           int    `toml:\"weight\"`\r\n    23\t\tWarmupDurationMs int    `toml:\"warmup_duration_ms\"`\r\n    24\t\tHealthCheck      string `toml:\"health_check\"`\r\n    25\t\tHealthPath       string `toml:\"health_path\"`\r\n    26\t\tHealthCmd        string `toml:\"health_cmd\"`\r\n    27\t}\r\n    28\t\r\n    29\t// Service describes one routed service from config.\r\n    30\ttype Service struct {\r\n    31\t\tName                      string     `toml:\"name\"`\r\n    32\t\tListenPort                int        `toml:\"listen_port\"`\r\n    33\t\tRoutingMode               string     `toml:\"routing_mode\"`\r\n    34\t\tDrainTimeoutMs            int        `toml:\"drain_timeout_ms\"`\r\n    35\t\tMaxConnectionsPerEndpoint int        `toml:\"max_connections_per_endpoint\"`\r\n    36\t\tConnectionLimitMode       string     `toml:\"connection_limit_mode\"`\r\n    37\t\tRateLimitRps              int        `toml:\"rate_limit_rps\"`\r\n    38\t\tRateLimitBurst            int        `toml:\"rate_limit_burst\"`\r\n    39\t\tRateLimitQueueDepth       int        `toml:\"rate_limit_queue_d"]
[12974.657826, "o", "epth\"`\r\n    40\t\tRateLimitQueueTimeoutMs   int        `toml:\"rate_limit_queue_timeout_ms\"`\r\n    41\t\tMaxRetries                int        `toml:\"max_retries\"`\r\n    42\t\tRetryDelayMs              int        `toml:\"retry_delay_ms\"`\r\n    43\t\tRetryBackoffMultiplier    float64    `toml:\"retry_backoff_multiplier\"`\r\n    44\t\tRetryMaxDelayMs           int        `toml:\"retry_max_delay_ms\"`\r\n    45\t\tIdleTimeoutMs             int        `toml:\"idle_timeout_ms\"`\r\n    46\t\tDependsOn                 []string   `toml:\"depends_on\"`\r\n    47\t\tEndpoints                 []Endpoint `toml:\"endpoint\"`\r\n    48\t}\r\n    49\t\r\n    50\t// Config is the parsed application configuration.\r\n    51\ttype Config struct {\r\n    52\t\tGlobal   Global\r\n    53\t\tServices []Service `toml:\"service\"`\r\n    54\t}\r\n    55\t\r\n    56\t// Load reads and normalizes a TOML config file.\r\n    57\tfunc Load(path string) (*Config, error) {\r\n    58\t\tvar cfg Config\r\n    59\t\tif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\n    60\t\t\treturn nil, err\r\n    61\t\t}\r\n    62\t\tif cf"]
[12974.657933, "o", "g.Global.HealthIntervalMs <= 0 {\r\n    63\t\t\tcfg.Global.HealthIntervalMs = 2000\r\n    64\t\t}\r\n    65\t\tif cfg.Global.UnhealthyThreshold <= 0 {\r\n    66\t\t\tcfg.Global.UnhealthyThreshold = 3\r\n    67\t\t}\r\n    68\t\tif cfg.Global.HealthyThreshold <= 0 {\r\n    69\t\t\tcfg.Global.HealthyThreshold = 2\r\n    70\t\t}\r\n    71\t\tif cfg.Global.StatsWindowSec <= 0 {\r\n    72\t\t\tcfg.Global.StatsWindowSec = 60\r\n    73\t\t}\r\n    74\t\tif cfg.Global.CircuitBreakerThreshold <= 0 {\r\n    75\t\t\tcfg.Global.CircuitBreakerThreshold = 3\r\n    76\t\t}\r\n    77\t\tif cfg.Global.CircuitBreakerTimeoutMs <= 0 {\r\n    78\t\t\tcfg.Global.CircuitBreakerTimeoutMs = 5000\r\n    79\t\t}\r\n    80\t\tfor i := range cfg.Services {\r\n    81\t\t\ts := &cfg.Services[i]\r\n    82\t\t\tif s.RoutingMode == \"\" {\r\n    83\t\t\t\ts.RoutingMode = \"weighted-round-robin\"\r\n    84\t\t\t}\r\n    85\t\t\tif s.DrainTimeoutMs <= 0 {\r\n    86\t\t\t\ts.DrainTimeoutMs = 5000\r\n    87\t\t\t}\r\n    88\t\t\tif s.MaxConnectionsPerEndpoint <= 0 {\r\n    89\t\t\t\ts.MaxConnectionsPerEndpoint = 100\r\n    90\t\t\t}\r\n    91\t\t\tif s.ConnectionLimitMode == \"\" {\r\n  "]
[12974.658036, "o", "  92\t\t\t\ts.ConnectionLimitMode = \"per-endpoint\"\r\n    93\t\t\t}\r\n    94\t\t\tif s.RateLimitBurst <= 0 {\r\n    95\t\t\t\ts.RateLimitBurst = s.RateLimitRps\r\n    96\t\t\t}\r\n    97\t\t\tif s.RateLimitQueueTimeoutMs <= 0 {\r\n    98\t\t\t\ts.RateLimitQueueTimeoutMs = 1000\r\n    99\t\t\t}\r\n   100\t\t\tif s.RetryDelayMs <= 0 {\r\n   101\t\t\t\ts.RetryDelayMs = 100\r\n   102\t\t\t}\r\n   103\t\t\tif s.RetryBackoffMultiplier <= 0 {\r\n   104\t\t\t\ts.RetryBackoffMultiplier = 2.0\r\n   105\t\t\t}\r\n   106\t\t\tif s.RetryMaxDelayMs <= 0 {\r\n   107\t\t\t\ts.RetryMaxDelayMs = 5000\r\n   108\t\t\t}\r\n   109\t\t\tfor j := range s.Endpoints {\r\n   110\t\t\t\tep := &s.Endpoints[j]\r\n   111\t\t\t\tif ep.HealthCheck == \"\" {\r\n   112\t\t\t\t\tep.HealthCheck = \"tcp\"\r\n   113\t\t\t\t}\r\n   114\t\t\t\tif ep.Weight < 0 {\r\n   115\t\t\t\t\tep.Weight = 0\r\n   116\t\t\t\t}\r\n   117\t\t\t\tif ep.WarmupDurationMs < 0 {\r\n   118\t\t\t\t\tep.WarmupDurationMs = 0\r\n   119\t\t\t\t}\r\n   120\t\t\t}\r\n   121\t\t\tif s.DependsOn == nil {\r\n   122\t\t\t\ts.DependsOn = []string{}\r\n   123\t\t\t}\r\n   124\t\t}\r\n   125\t\tcfg.Services = removeDependencyCycles(cfg.Services)\r\n   126\t\treturn &cfg, ni"]
[12974.658073, "o", "l\r\n   127\t}\r\n   128\t\r\n   129\t// removeDependencyCycles drops dependency edges that would create cycles.\r\n   130\tfunc removeDependencyCycles(services []Service) []Service {\r\n   131\t\tbyName := make(map[string]int, len(services))\r\n   132\t\tfor i, svc := range services {\r\n   133\t\t\tbyName[svc.Name] = i\r\n   134\t\t}\r\n   135\t\tfor i := range services {\r\n   136\t\t\tseen := map[string]bool{services[i].Name: true}\r\n   137"]
[12974.658167, "o", "\t\t\tkept := make([]string, 0, len(services[i].DependsOn))\r\n   138\t\t\tfor _, dep := range services[i].DependsOn {\r\n   139\t\t\t\tif dep == services[i].Name {\r\n   140\t\t\t\t\tlog.Printf(\"warning: dropping self dependency from %s to %s\", services[i].Name, dep)\r\n   141\t\t\t\t\tcontinue\r\n   142\t\t\t\t}\r\n   143\t\t\t\tif _, ok := byName[dep]; !ok {\r\n   144\t\t\t\t\tkept = append(kept, dep)\r\n   145\t\t\t\t\tcontinue\r\n   146\t\t\t\t}\r\n   147\t\t\t\tif createsCycle(services, byName, seen, services[i].Name, dep) {\r\n   148\t\t\t\t\tlog.Printf(\"warning: dropping dependency edge from %s to %s to avoid circular dependency\", services[i].Name, dep)\r\n   149\t\t\t\t\tcontinue\r\n   150\t\t\t\t}\r\n   151\t\t\t\tkept = append(kept, dep)\r\n   152\t"]
[12974.658234, "o", "\t\t}\r\n   153\t\t\tservices[i].DependsOn = kept\r\n   154\t\t}\r\n   155\t\treturn services\r\n   156\t}\r\n   157\t\r\n   158\tfunc createsCycle(services []Service, byName map[string]int, seen map[string]bool, start, dep string) bool {\r\n   159\t\tif seen[dep] {\r\n   160\t\t\treturn true\r\n   161\t\t}\r\n   162\t\tseen[dep] = true\r\n   163\t\tdefer delete(seen, dep)\r\n   164\t\tnext := services[byName[dep]].DependsOn\r\n   165\t\tfor _, d := range next {\r\n   166\t\t\tif d == start || d == dep {\r\n   167\t\t\t\treturn true\r\n   168"]
[12974.658294, "o", "\t\t\t}\r\n   169\t\t\tif _, ok := byName[d]; !ok {\r\n   170\t\t\t\tcontinue\r\n   171\t\t\t}\r\n   172\t\t\tif createsCycle(services, byName, seen, start, d) {\r\n   173\t\t\t\treturn true\r\n   174\t\t\t}\r\n   175\t\t}\r\n   176\t\treturn false\r\n   177\t}\r\n"]
