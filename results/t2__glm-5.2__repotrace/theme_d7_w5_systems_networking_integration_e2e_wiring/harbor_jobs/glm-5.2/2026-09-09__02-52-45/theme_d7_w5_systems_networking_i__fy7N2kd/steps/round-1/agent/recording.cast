[2994.806851, "o", "   225\t\t\t\t\tr.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\r\n   226\t\t\t\t\tcontinue\r\n   227\t\t\t\t}\r\n   228\t\t\t}\r\n   229\t\r\n   230\t\t\tbackend, derr := net.Dial(\"tcp\", ep.Address)\r\n   231\t\t\tif derr != nil {\r\n"]
[2994.806929, "o", "   232\t\t\t\tif id != 0 {\r\n   233\t\t\t\t\tep.RemoveConnection(id)\r\n   234\t\t\t\t}\r\n   235\t\t\t\tep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n   236\t\t\t\tif res.Probe {\r\n   237\t\t\t\t\tep.Circuit.ProbeFailure()\r\n   238\t\t\t\t} else {\r\n"]
[2994.807005, "o", "   239\t\t\t\t\tep.Circuit.Open()\r\n   240\t\t\t\t}\r\n   241\t\t\t\tif attempt >= maxRetries {\r\n   242\t\t\t\t\tclient.Close()\r\n   243\t\t\t\t\treturn\r\n   244\t\t\t\t}\r\n   245\t\t\t\tep.Stats.RecordRetry()\r\n   246\t\t\t\tr.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\r\n   247\t\t\t\tcontinue\r\n   248\t\t\t}\r\n   249\t\r\n   250\t\t\tif res.Probe {\r\n   251\t\t\t\tep.Circuit.ProbeSuccess()\r\n   252\t\t\t\tvar ok bool\r\n   253\t\t\t\tid, ok = ep.TryAddConnection(client, res.MaxConns)\r\n   254\t\t\t\tif !ok {\r\n   255\t\t\t\t\tep.Stats.RecordRejection()\r\n   256\t\t\t\t\tbackend.Close()\r\n"]
[2994.807082, "o", "   257\t\t\t\t\tclient.Close()\r\n   258\t\t\t\t\treturn\r\n   259\t\t\t\t}\r\n   260\t\t\t}\r\n   261\t\r\n   262\t\t\tif attempt > 0 {\r\n   263\t\t\t\tep.Stats.RecordRetrySuccess()\r\n   264\t\t\t}\r\n   265\t\t\tbytesIn, bytesOut := forward(client, backend)\r\n   266"]
[2994.807154, "o", "\t\t\tbackend.Close()\r\n   267\t\t\tclient.Close()\r\n   268\t\t\tep.RemoveConnection(id)\r\n   269\t\t\tep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)\r\n"]
[2994.807225, "o", "   270\t\t\treturn\r\n   271\t\t}\r\n   272\t}\r\n   273\t\r\n   274\tfunc (r *Router) sleepRetry(attempt, delayMs int, multiplier float64, maxDelayMs int) {\r\n   275\t\tif attempt < 0 {\r\n   276\t\t\tattempt = 0\r\n   277\t\t}\r\n   278\t\tdelay := float64(delayMs) * pow(multiplier, float64(attempt))\r\n   279\t\tif maxDelayMs > 0 && delay > float64(maxDelayMs) {\r\n   280\t\t\tdelay = float64(maxDelayMs)\r\n"]
