[689.694576, "o", "\u001b[?2004h> "]
[689.69463, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[689.694728, "o", "    return eps[0]\r\n\u001b[?2004l\r"]
[689.694754, "o", "\u001b[?2004h> "]
[689.694773, "o", "}\r\n\u001b[?2004l\r"]
