[4130.46334, "o", "     1\tpackage state\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"net\"\r\n     5\t\t\"sync\"\r\n     6\t\t\"sync/atomic\"\r\n     7\t\t\"time\"\r\n     8\t\r\n"]
