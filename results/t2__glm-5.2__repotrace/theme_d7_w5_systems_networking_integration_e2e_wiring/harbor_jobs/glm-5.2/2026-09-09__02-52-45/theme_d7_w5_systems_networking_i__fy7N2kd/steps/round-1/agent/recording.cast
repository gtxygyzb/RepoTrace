[1530.257501, "i", "python3 - <<'PY'\np='internal/ipc/server.go'\ns=open(p).read()\ninsert='''    case \"resolve\":\n        var args struct {\n            Name string `json:\"name\"`\n        }\n        if err := json.Unmarshal(req.Args, &args); err != nil {\n            return nil, err\n        }\n        addr, err := s.state.ResolveEndpoint(args.Name)\n        if err != nil {\n            return nil, err\n        }\n        return addr, nil\n'''\nif 'case \"resolve\":' not in s:\n    s=s.replace('    case \"reload_config\":', insert + '    case \"reload_config\":')\nopen(p,'w').write(s)\nPY\n"]
