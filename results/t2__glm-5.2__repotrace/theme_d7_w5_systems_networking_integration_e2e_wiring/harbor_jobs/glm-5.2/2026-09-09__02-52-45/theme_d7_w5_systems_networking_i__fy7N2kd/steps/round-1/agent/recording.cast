[1985.502021, "o", "   110\tfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n   111\t\ts.global = cfg.Global\r\n   112\t\tseen := make(map[string]bool)\r\n   113\t\tfor _, svc := range cfg.Services {\r\n   114\t\t\tseen[svc.Name] = true\r\n"]
[1985.502123, "o", "   115\t\t\tss := s.services[svc.Name]\r\n   116\t\t\tif ss == nil {\r\n   117\t\t\t\tss = newServiceState(svc, cfg.Global)\r\n   118\t\t\t\ts.services[svc.Name] = ss\r\n   119\t\t\t} else {\r\n   120\t\t\t\tss.mu.Lock()\r\n   121\t\t\t\tss.Name = svc.Name\r\n   122\t\t\t\tss.ListenPort = svc.ListenPort\r\n   123\t\t\t\tss.RoutingMode = svc.RoutingMode\r\n   124\t\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n   125\t\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n   126\t\t\t\tss.mu.Unlock()\r\n   127\t\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n   128\t\t\t}\r\n   129\t\t}\r\n"]
[1985.502208, "o", "   130\t\tfor name, ss := range s.services {\r\n   131\t\t\tif !seen[name] {\r\n   132\t\t\t\tss.mu.Lock()\r\n   133\t\t\t\tss.stopping = true\r\n   134\t\t\t\tif ss.listenerStop != nil {\r\n   135\t\t\t\t\tclose(ss.listenerStop)\r\n"]
[1985.502285, "o", "   136\t\t\t\t\tss.listenerStop = nil\r\n   137\t\t\t\t}\r\n   138\t\t\t\tif ss.Listener != nil {\r\n   139\t\t\t\t\tss.Listener.Close()\r\n   140\t\t\t\t\tss.Listener = nil\r\n   141\t\t\t\t}\r\n   142\t\t\t\tss.mu.Unlock()\r\n   143\t\t\t\tfor _, ep := range ss.Endpoints {\r\n   144\t\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   145\t\t\t\t}\r\n   146\t\t\t}\r\n   147\t\t}\r\n   148\t}\r\n   149\t\r\n"]
[1985.502357, "o", "   150\tfunc newServiceState(svc config.Service, global config.Global) *ServiceState {\r\n   151\t\tss := &ServiceState{\r\n   152\t\t\tName:                      svc.Name,\r\n   153\t\t\tListenPort:                svc.ListenPort,\r\n   154\t\t\tRoutingMode:               svc.RoutingMode,\r\n   155\t\t\tDrainTimeoutMs:            svc.DrainTimeoutMs,\r\n   156\t\t\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n   157\t\t\tlistenerStop:              nil,\r\n   158\t\t}\r\n   159\t\tfor _, ep := range svc.Endpoints {\r\n"]
[1985.502462, "o", "   160\t\t\tss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))\r\n   161\t\t}\r\n   162\t\treturn ss\r\n   163\t}\r\n   164\t\r\n   165\tfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n   166\t\tss.mu.Lock()\r\n   167\t\tdefer ss.mu.Unlock()\r\n   168\t\tseen := make(map[string]bool)\r\n   169\t\tfor _, cep := range eps {\r\n   170\t\t\tseen[cep.Address] = true\r\n"]
[1985.502548, "o", "   171\t\t\tvar ep *EndpointState\r\n   172\t\t\tfor _, existing := range ss.Endpoints {\r\n   173\t\t\t\tif existing.Address == cep.Address {\r\n   174\t\t\t\t\tep = existing\r\n   175\t\t\t\t\tbreak\r\n   176\t\t\t\t}\r\n   177\t\t\t}\r\n   178\t\t\tif ep == nil {\r\n   179\t\t\t\tep = newEndpointState(cep, global)\r\n   180\t\t\t\tss.Endpoints = append(ss.Endpoints, ep)\r\n   181\t\t\t} else {\r\n   182\t\t\t\tep.mu.Lock()\r\n"]
[1985.502618, "o", "   183\t\t\t\tep.Config = cep\r\n   184\t\t\t\tep.Weight = cep.Weight\r\n   185\t\t\t\tep.mu.Unlock()\r\n   186\t\t\t}\r\n   187\t\t}\r\n   188\t\tfor _, ep := range ss.Endpoints {\r\n   189\t\t\tif !seen[ep.Address] {\r\n   190\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   191\t\t\t}\r\n   192\t\t}\r\n   193\t}\r\n   194\t"]
[1985.502685, "o", "\r\n   195\tfunc newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {\r\n   196\t\treturn &EndpointState{\r\n   197\t\t\tAddress:     cep.Address,\r\n   198\t\t\tWeight:      cep.Weight,\r\n   199\t\t\tConfig:      cep,\r\n   200\t\t\tState:       Unknown,\r\n   201\t\t\tCircuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n"]
[1985.502756, "o", "   202\t\t\tStats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n   203\t\t\tconnections: make(map[int64]net.Conn),\r\n   204\t\t}\r\n   205\t}\r\n   206\t\r\n   207\tfunc (s *State) GetService(name string) *ServiceState {\r\n   208\t\ts.mu.RLock()\r\n   209\t\tdefer s.mu.RUnlock()\r\n   210\t\treturn s.services[name]\r\n   211\t}\r\n   212\t\r\n   213\tfunc (s *State) Services() []*ServiceState {\r\n"]
[1985.502827, "o", "   214\t\ts.mu.RLock()\r\n   215\t\tdefer s.mu.RUnlock()\r\n   216\t\tout := make([]*ServiceState, 0, len(s.services))\r\n   217\t\tfor _, ss := range s.services {\r\n   218\t\t\tout = append(out, ss)\r\n   219\t\t}\r\n   220\t\treturn out\r\n   221\t}\r\n   222\t\r\n"]
[1985.502893, "o", "   223\tfunc (s *State) GetEndpoint(service, address string) *EndpointState {\r\n   224\t\tss := s.GetService(service)\r\n   225\t\tif ss == nil {\r\n   226\t\t\treturn nil\r\n   227\t\t}\r\n   228\t\tss.mu.Lock()\r\n   229\t\tdefer ss.mu.Unlock()\r\n   230\t\tfor _, ep := range ss.Endpoints {\r\n   231\t\t\tif ep.Address == address {\r\n"]
[1985.502963, "o", "   232\t\t\t\treturn ep\r\n   233\t\t\t}\r\n   234\t\t}\r\n   235\t\treturn nil\r\n   236\t}\r\n   237\t\r\n   238\tfunc (s *State) SetWeight(service, address string, weight int) error {\r\n   239\t\tep := s.GetEndpoint(service, address)\r\n   240\t\tif ep == nil {\r\n   241\t\t\treturn errNotFound(\"endpoint not found\")\r\n   242\t\t}\r\n   243"]
[1985.503036, "o", "\t\tep.mu.Lock()\r\n   244\t\tdefer ep.mu.Unlock()\r\n   245\t\tif weight < 0 {\r\n   246\t\t\tweight = 0\r\n   247\t\t}\r\n   248\t\tep.Weight = weight\r\n   249\t\treturn nil\r\n   250\t}\r\n   251\t\r\n"]
[1985.503104, "o", "   252\tfunc (s *State) DrainEndpoint(service, address string) error {\r\n   253\t\tss := s.GetService(service)\r\n   254\t\tif ss == nil {\r\n   255\t\t\treturn errNotFound(\"service not found\")\r\n   256\t\t}\r\n   257\t\tep := s.GetEndpoint(service, address)\r\n   258\t\tif ep == nil {\r\n   259\t\t\treturn errNotFound(\"endpoint not found\")\r\n   260\t\t}\r\n"]
