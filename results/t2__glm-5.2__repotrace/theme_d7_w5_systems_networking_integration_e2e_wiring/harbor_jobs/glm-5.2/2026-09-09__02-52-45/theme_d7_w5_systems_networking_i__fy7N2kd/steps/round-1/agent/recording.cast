[10596.688002, "o", "    35\t\tdone     chan struct{}\r\n    36\t}\r\n    37\t\r\n    38\tfunc NewServer(s *state.State, path string) *Server {\r\n    39\t\treturn &Server{\r\n    40\t\t\tstate: s,\r\n    41\t\t\tpath:  path,\r\n    42\t"]
[10596.688087, "o", "\t\tstop:  make(chan struct{}),\r\n    43\t\t\tdone:  make(chan struct{}),\r\n    44\t\t}\r\n    45\t}\r\n    46\t\r\n    47\tfunc (s *Server) Start() error {\r\n    48\t\tos.Remove(s.path)\r\n    49\t\tln, err := net.Listen(\"unix\", s.path)\r\n    50\t\tif err != nil {\r\n    51\t\t\treturn err\r\n    52\t\t}\r\n    53\t\ts.listener = ln\r\n    54\t\tgo s.acceptLoop()\r\n    55\t\treturn nil\r\n    56\t}\r\n    57\t\r\n    58"]
[10596.688157, "o", "\tfunc (s *Server) Stop() {\r\n    59\t\tselect {\r\n    60\t\tcase <-s.stop:\r\n    61\t\tdefault:\r\n    62\t\t\tclose(s.stop)\r\n    63\t\t}\r\n    64\t\tif s.listener != nil {\r\n    65\t\t\ts.listener.Close()\r\n    66\t\t}\r\n    67\t\t<-s.done\r\n    68"]
