[11929.933369, "o", "\t[no test files]\r\n?   \tmeshrouter/internal/ipc\t[no test files]\r\n?   \tmeshrouter/internal/router\t[no test files]\r\n?   \tmeshrouter/internal/state\t[no test files]\r\n?   \tmeshrouter/internal/stats\t[no test files]\r\n"]
