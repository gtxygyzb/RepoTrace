[689.689815, "o", "\u001b[?2004h> "]
[689.689931, "o", "    for _, ep := range eps {\r\n\u001b[?2004l\r"]
[689.689985, "o", "\u001b[?2004h> "]
[689.690074, "o", "        ep.mu.Lock()\r\n\u001b[?2004l\r"]
[689.690128, "o", "\u001b[?2004h> "]
