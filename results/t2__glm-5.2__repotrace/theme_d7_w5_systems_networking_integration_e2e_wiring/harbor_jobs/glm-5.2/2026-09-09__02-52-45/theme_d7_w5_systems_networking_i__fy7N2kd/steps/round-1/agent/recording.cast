[13805.595375, "o", "   126\t\ts.mu.Lock()\r\n   127\t\tdefer s.mu.Unlock()\r\n   128\t\ts.applyConfigLocked(cfg)\r\n   129\t\tselect {\r\n   130\t\tcase s.reloadCh <- struct{}{}:\r\n   131\t\tdefault:\r\n   132\t\t}\r\n   133\t}\r\n   134\t\r\n   135\tfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n   136\t\ts.global = cfg.Global\r\n   137\t\tseen := make(map[string]bool)\r\n"]
[13805.595489, "o", "   138\t\tfor _, svc := range cfg.Services {\r\n   139\t\t\tseen[svc.Name] = true\r\n   140\t\t\tss := s.services[svc.Name]\r\n   141\t\t\tif ss == nil {\r\n   142\t\t\t\tss = newServiceState(svc, cfg.Global)\r\n   143\t\t\t\ts.services[svc.Name] = ss\r\n   144\t\t\t} else {\r\n   145\t\t\t\tss.mu.Lock()\r\n   146\t\t\t\tss.Name = svc.Name\r\n   147\t\t\t\tss.ListenPort = svc.ListenPort\r\n"]
