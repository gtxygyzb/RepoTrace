[6873.840685, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/state/json.go')\ns = p.read_text()\ns = s.replace(\n'''func (s *State) ResolveEndpoint(service string) (string, error) {\n\\tss := s.GetService(service)\n\\tif ss == nil {\n\\t\\treturn \"\", errNotFound(\"service not found\")\n\\t}\n\\tss.mu.Lock()\n\\tmaxConns := ss.MaxConnectionsPerEndpoint\n\\tmode := ss.RoutingMode\n\\tendpoints := make([]*EndpointState, len(ss.Endpoints))\n\\tcopy(endpoints, ss.Endpoints)\n\\tss.mu.Unlock()\n\n\\tvar regular []*EndpointState\n\\tfor _, ep := range endpoints {\n\\t\\tif ep.IsEligible(maxConns) {\n\\t\\t\\tregular = append(regular, ep)\n\\t\\t}\n\\t}\n\n\\tif len(regular) > 0 {\n\\t\\tif mode == \"least-connections\" {\n\\t\\t\\tep := selectLeastConnections(regular, maxConns)\n\\t\\t\\treturn ep.Address, nil\n\\t\\t}\n\\t\\tvar best *EndpointState\n\\t\\tvar bestWeight int\n\\t\\tfor _, ep := range regular {\n\\t\\t\\tep.mu.Lock()\n\\t\\t\\tcw := ep.currentWeight + ep.Weight\n\\t\\t\\tep.mu.Unlock()\n\\t\\t\\tif best == nil || cw > bestWeight {\n\\t\\t\\t\\tbest = ep\n\\t\\t\\t\\tbestWeight = cw\n\\t\\t\\t}\n\\t\\t}"]
[6873.840949, "i", "\n\\t\\tif best != nil {\n\\t\\t\\treturn best.Address, nil\n\\t\\t}\n\\t}\n\n\\tfor _, ep := range endpoints {\n\\t\\tep.mu.Lock()\n\\t\\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns && !ep.Circuit.ProbeActive()\n\\t\\tep.mu.Unlock()\n\\t\\tif halfOpen {\n\\t\\t\\treturn ep.Address, nil\n\\t\\t}\n\\t}\n\\treturn \"\", errNotFound(\"no eligible endpoints\")\n}''',\n'''func (s *State) ResolveEndpoint(service string) (string, error) {\n\\tss := s.GetService(service)\n\\tif ss == nil {\n\\t\\treturn \"\", errNotFound(\"service not found\")\n\\t}\n\\tss.mu.Lock()\n\\tmaxConns := ss.MaxConnectionsPerEndpoint\n\\tmode := ss.RoutingMode\n\\tperService := ss.ConnectionLimitMode == \"per-service\"\n\\tendpoints := make([]*EndpointState, len(ss.Endpoints))\n\\tcopy(endpoints, ss.Endpoints)\n\\tss.mu.Unlock()\n\n\\ttotalActive := 0\n\\tif perService {\n\\t\\tfor _, ep := range endpoints {\n\\t\\t\\tep.mu.Lock()\n\\t\\t\\ttotalActive += ep.ActiveConnections\n\\t\\t\\tep.mu.Unlock()\n\\t\\t}\n\\t}\n\n\\tvar regular []*EndpointState\n"]
