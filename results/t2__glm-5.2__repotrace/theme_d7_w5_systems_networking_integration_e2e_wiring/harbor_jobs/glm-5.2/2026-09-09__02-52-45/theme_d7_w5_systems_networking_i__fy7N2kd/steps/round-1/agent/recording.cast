[11530.129467, "o", "# cmd/meshctl/main.go: add sendRaw helper and deps all-services aggregation\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.129535, "o", "> "]
[11530.129601, "o", "p = Path('cmd/meshctl/main.go')\r\n\u001b[?2004l\r"]
[11530.12966, "o", "\u001b[?2004h> "]
[11530.12972, "o", "s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.129818, "o", "if 'func sendRaw(' not in s:\r\n\u001b[?2004l\r"]
[11530.129874, "o", "\u001b[?2004h> "]
[11530.129929, "o", "    s = s.replace(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.13024, "o", "'''func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n\u001b[?2004l\r"]
[11530.130295, "o", "\u001b[?2004h> "]
[11530.130429, "o", "        rawArgs, err := json.Marshal(args)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.130586, "o", "> "]
[11530.130664, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>                 return \"\", err"]
[11530.130725, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.130783, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.130975, "o", "        req := request{Cmd: ipcCmd, Args: rawArgs}\r\n\u001b[?2004l\r"]
[11530.131038, "o", "\u001b[?2004h> "]
[11530.131172, "o", "        reqBytes, err := json.Marshal(req)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.131229, "o", "> "]
[11530.131295, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.131351, "o", "> "]
[11530.131434, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11530.13149, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[11530.13155, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rl\u001b[?2004h> "]
[11530.131772, "o", "        conn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.131827, "o", "> "]
[11530.131903, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.131958, "o", "> "]
[11530.132213, "o", "                return \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.132268, "o", ">         }\r\n\u001b[?2004l\r"]
[11530.132324, "o", "\u001b[?2004h> "]
[11530.132421, "o", "        defer conn.Close()\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.132479, "o", "> \r\n\u001b[?2004l\r.\u001b[?2004h> "]
[11530.132698, "o", "        fmt.Fprintf(conn, \"%s\\\\n\", string(reqBytes))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.132755, "o", "\r\n\u001b[?2004l\r1\u001b[?2004h> "]
[11530.132893, "o", "        reader := bufio.NewReader(conn)\r\n\u001b[?2004l\r"]
[11530.132948, "o", "\u001b[?2004h> "]
[11530.133083, "o", "        line, err := reader.ReadString('\\\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.133138, "o", "> "]
[11530.133202, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11530.133259, "o", "\u001b[?2004h> "]
[11530.133347, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11530.133422, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[11530.133479, "o", "\u001b[?2004h> "]
[11530.133664, "o", "        line = strings.TrimRight(line, \"\\\\r\\\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r,\u001b[?2004h"]
[11530.133744, "o", "> "]
[11530.133804, "o", "        var resp response\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.134051, "o", "        if err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.134115, "o", "> "]
[11530.134187, "o", "                return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.134243, "o", ">         }\r\n\u001b[?2004l\r"]
[11530.134303, "o", "\u001b[?2004h> "]
[11530.134465, "o", "        if resp.Status != \"ok\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.134593, "o", "                var msg string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.13482, "o", "                if err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.134889, "o", "> "]
[11530.135033, "o", "                        return \"\", fmt.Errorf(\"%s\", msg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.135103, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.135294, "o", "                return \"\", fmt.Errorf(\"%s\", string(resp.Data))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.135364, "o", "        }\r\n\u001b[?2004l\r \u001b[?2004h> "]
[11530.135487, "o", "        return prettyData(ipcCmd, resp.Data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.135553, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> ''',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.13579, "o", "'''func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.135918, "o", "        data, err := sendRaw(ipcCmd, args)\r\n\u001b[?2004l\r"]
[11530.135983, "o", "\u001b[?2004h> "]
[11530.136048, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.136112, "o", "                return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.136208, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.13629, "o", "        return prettyData(ipcCmd, data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.136354, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[11530.136596, "o", "func sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.136731, "o", "        rawArgs, err := json.Marshal(args)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.136818, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.136924, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[11530.136989, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.137139, "o", "        req := request{Cmd: ipcCmd, Args: rawArgs}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.137281, "o", "        reqBytes, err := json.Marshal(req)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.137353, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.137464, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[11530.137529, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[11530.137594, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[11530.137729, "o", "        conn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.137797, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.137946, "o", "                return nil, fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.138012, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.138076, "o", "        defer conn.Close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.13818, "o", "        fmt.Fprintf(conn, \"%s\\\\n\", string(reqBytes))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.138245, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.13831, "o", "        reader := bufio.NewReader(conn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.138397, "o", "        line, err := reader.ReadString('\\\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.13863, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>                 return nil, err\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.138718, "o", "        line = strings.TrimRight(line, \"\\\\r\\\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.138788, "o", "        var resp response\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.138895, "o", "        if err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.13897, "o", "                return nil, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.139027, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.139086, "o", "        if resp.Status != \"ok\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.139158, "o", "                var msg string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.139301, "o", "                if err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.139424, "o", "                        return nil, fmt.Errorf(\"%s\", msg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.139523, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.139635, "o", "                return nil, fmt.Errorf(\"%s\", string(resp.Data))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.139701, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.139763, "o", "        return resp.Data, nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.139833, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.139889, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> # Add depsAll helper if missing\r\n\u001b[?2004l\r"]
[11530.139945, "o", "\u001b[?2004h> "]
[11530.14, "o", "if 'func depsAll()' not in s:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.140056, "o", "    s = s.replace(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.140206, "o", "'''func sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {''',\r\n\u001b[?2004l\r"]
[11530.14026, "o", "\u001b[?2004h> "]
[11530.140315, "o", "'''func depsAll() (string, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.140408, "o", "        raw, err := sendRaw(\"list_services\", nil)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.140616, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>                 return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.140705, "o", "        var services []struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.14077, "o", "                Name string `json:\"name\"`\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[11530.140832, "o", "\u001b[?2004h> "]
[11530.14091, "o", "        if err := json.Unmarshal(raw, &services); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.140983, "o", "                return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.141038, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.14109, "o", "        type depRow struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.14118, "o", "                Service          string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.141268, "o", "                Name             string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.141353, "o", "                Available        bool\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.141441, "o", "                HealthyEndpoints int\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.141497, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.141546, "o", "        var rows []depRow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.141632, "o", "        for _, svc := range services {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.141825, "o", "                depRaw, err := sendRaw(\"get_dependencies\", map[string]interface{}{\"name\": svc.Name})\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.141896, "o", "> "]
[11530.141952, "o", "                if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.142014, "o", "                        return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.142073, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.142134, "o", "                var resp struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.142258, "o", "                        Service      string `json:\"service\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.14236, "o", "                        Dependencies []struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.142509, "o", "                                Name             string `json:\"name\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.14266, "o", "                                Available         bool   `json:\"available\"`\r\n\u001b[?2004l\r"]
[11530.142729, "o", "\u001b[?2004h> "]
[11530.142834, "o", "                                HealthyEndpoints int    `json:\"healthy_endpoints\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.142936, "o", "                        } `json:\"dependencies\"`\r\n\u001b[?2004l\r"]
[11530.142992, "o", "\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.143046, "o", "> "]
[11530.143126, "o", "                if err := json.Unmarshal(depRaw, &resp); err != nil {\r\n\u001b[?2004l\r"]
[11530.143182, "o", "\u001b[?2004h> "]
[11530.143236, "o", "                        return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.143291, "o", "                }\r\n\u001b[?2004l\r"]
[11530.143345, "o", "\u001b[?2004h> "]
[11530.143423, "o", "                for _, dep := range resp.Dependencies {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.143668, "o", "                        rows = append(rows, depRow{Service: svc.Name, Name: dep.Name, Available: dep.Available, HealthyEndpoints: dep.HealthyEndpoints})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.143722, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.143783, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.143847, "o", "        if len(rows) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.143929, "o", "                return \"no dependencies\", nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.143984, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.144038, "o", "        var b strings.Builder\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.144251, "o", "        fmt.Fprintf(&b, \"%-14s %-14s %-10s %-18s\\\\n\", \"SERVICE\", \"DEPENDS_ON\", \"AVAILABLE\", \"HEALTHY_ENDPOINTS\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.144331, "o", "        for _, row := range rows {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.144562, "o", "                fmt.Fprintf(&b, \"%-14s %-14s %-10t %-18d\\\\n\", row.Service, row.Name, row.Available, row.HealthyEndpoints)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.144625, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.144721, "o", "        return strings.TrimRight(b.String(), \"\\\\n\"), nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.144775, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.144933, "o", "func sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.144992, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.145065, "o", "# Special-case deps with no service in main()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.145128, "o", "s = s.replace(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.145186, "o", "'''        case \"deps\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.145267, "o", "                ipcCmd = \"get_dependencies\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.145355, "o", "                if len(os.Args) >= 3 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.145519, "o", "                        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.145617, "o", "                } else {\r\n\u001b[?2004l\r\u001b[?2004h>                         args[\"name\"] = \"\"\r\n\u001b[?2004l\r"]
[11530.145688, "o", "\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.145747, "o", "> ''',\r\n\u001b[?2004l\r\u001b[?2004h> '''        case \"deps\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.145811, "o", "                if len(os.Args) >= 3 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.145897, "o", "                        ipcCmd = \"get_dependencies\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.145982, "o", "                        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.146043, "o", "                } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.146112, "o", "                        out, err := depsAll()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.146183, "o", "                        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.146282, "o", "                                fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.146357, "o", "                                os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.146418, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.146486, "o", "                        fmt.Println(out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.209476, "o", "                        return\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[11530.252944, "o", "\u001b[?2004hroot@n30009:/app# "]
[11530.25347, "o", "gofmt -w internal/config/config.go internal/ipc/server.go cmd/meshctl/main.go\r\n\u001b[?2004l\r"]
[11530.263375, "o", "\u001b[?2004hroot@n30009:/app# "]
[11530.263606, "o", "go build ./...\r\n\u001b[?2004l\r"]
[11532.719965, "o", "# meshrouter/internal/config\r\ninternal/config/config.go:4:2: imported and not used: \"log\"\r\n"]
[11533.336915, "o", "\u001b[?2004hroot@n30009:/app# "]
[11533.337092, "o", "go test ./...\r\n\u001b[?2004l\r"]
[11536.317962, "o", "# meshrouter/internal/config\r\ninternal/config/config.go:4:2: imported and not used: \"log\"\r\n"]
[11536.435677, "o", "?   \tmeshrouter/cmd/meshctl\t[no test files]\r\n"]
[11536.52074, "o", "\u001b[?2004hroot@n30009:/app# "]
[11557.665456, "i", "sed -n '1,140p' internal/config/config.go\n"]
[11557.665824, "o", "sed -n '1,140p' internal/config/config.go\r\n"]
[11557.665918, "o", "\u001b[?2004l\r"]
[11557.668994, "o", "package config\r\n\r\nimport (\r\n\t\"log\"\r\n\r\n\t\"github.com/BurntSushi/toml\"\r\n)\r\n\r\n// Global holds mesh-wide tuning parameters.\r\n"]
[11557.669105, "o", "type Global struct {\r\n\tHealthIntervalMs        int `toml:\"health_interval_ms\"`\r\n\tUnhealthyThreshold      int `toml:\"unhealthy_threshold\"`\r\n\tHealthyThreshold        int `toml:\"healthy_threshold\"`\r\n\tStatsWindowSec          int `toml:\"stats_window_sec\"`\r\n\tCircuitBreakerThreshold int `toml:\"circuit_breaker_threshold\"`\r\n\tCircuitBreakerTimeoutMs int `toml:\"circuit_breaker_timeout_ms\"`\r\n}\r\n\r\n// Endpoint describes one backend endpoint from config.\r\ntype Endpoint struct {\r\n\tAddress          string `toml:\"address\"`\r\n\tWeight           int    `toml:\"weight\"`\r\n\tWarmupDurationMs int    `toml:\"warmup_duration_ms\"`\r\n\tHealthCheck      string `toml:\"health_check\"`\r\n\tHealthPath       string `toml:\"health_path\"`\r\n\t"]
[11557.669186, "o", "HealthCmd        string `toml:\"health_cmd\"`\r\n}\r\n\r\n// Service describes one routed service from config.\r\ntype Service struct {\r\n\tName                      string     `toml:\"name\"`\r\n\tListenPort                int        `toml:\"listen_port\"`\r\n\tRoutingMode               string     `toml:\"routing_mode\"`\r\n\tDrainTimeoutMs            int        `toml:\"drain_timeout_ms\"`\r\n\tMaxConnectionsPerEndpoint int        `toml:\"max_connections_per_endpoint\"`\r\n\tConnectionLimitMode       string     `toml:\"connection_limit_mode\"`\r\n\tRateLimitRps              int        `toml:\"rate_limit_rps\"`\r\n\tRateLimitBurst            int        `toml:\"rate_limit_burst\"`\r\n\t"]
[11557.669254, "o", "RateLimitQueueDepth       int        `toml:\"rate_limit_queue_depth\"`\r\n\tRateLimitQueueTimeoutMs   int        `toml:\"rate_limit_queue_timeout_ms\"`\r\n\tMaxRetries                int        `toml:\"max_retries\"`\r\n\tRetryDelayMs              int        `toml:\"retry_delay_ms\"`\r\n\tRetryBackoffMultiplier    float64    `toml:\"retry_backoff_multiplier\"`\r\n\tRetryMaxDelayMs           int        `toml:\"retry_max_delay_ms\"`\r\n\tIdleTimeoutMs             int        `toml:\"idle_timeout_ms\"`\r\n\tDependsOn                 []string   `toml:\"depends_on\"`\r\n\tEndpoints                 []Endpoint `toml:\"endpoint\"`\r\n}\r\n\r\n"]
[11557.66932, "o", "// Config is the parsed application configuration.\r\ntype Config struct {\r\n\tGlobal   Global\r\n\tServices []Service `toml:\"service\"`\r\n}\r\n\r\n"]
[11557.669384, "o", "// Load reads and normalizes a TOML config file.\r\nfunc Load(path string) (*Config, error) {\r\n\tvar cfg Config\r\n\tif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif cfg.Global.HealthIntervalMs <= 0 {\r\n\t\tcfg.Global.HealthIntervalMs = 2000\r\n\t}\r\n\tif cfg.Global.UnhealthyThreshold <= 0 {\r\n\t\tcfg.Global.UnhealthyThreshold = 3\r\n\t}\r\n\tif cfg.Global.HealthyThreshold <= 0 {\r\n\t\tcfg.Global.HealthyThreshold = 2\r\n"]
[11557.66947, "o", "\t}\r\n\tif cfg.Global.StatsWindowSec <= 0 {\r\n\t\tcfg.Global.StatsWindowSec = 60\r\n\t}\r\n\tif cfg.Global.CircuitBreakerThreshold <= 0 {\r\n\t\tcfg.Global.CircuitBreakerThreshold = 3\r\n\t}\r\n\tif cfg.Global.CircuitBreakerTimeoutMs <= 0 {\r\n\t\tcfg.Global.CircuitBreakerTimeoutMs = 5000\r\n\t}\r\n\tfor i := range cfg.Services {\r\n\t\ts := &cfg.Services[i]\r\n\t\tif s.RoutingMode == \"\" {\r\n\t\t\ts.RoutingMode = \"weighted-round-robin\"\r\n"]
[11557.669541, "o", "\t\t}\r\n\t\tif s.DrainTimeoutMs <= 0 {\r\n\t\t\ts.DrainTimeoutMs = 5000\r\n\t\t}\r\n\t\tif s.MaxConnectionsPerEndpoint <= 0 {\r\n\t\t\ts.MaxConnectionsPerEndpoint = 100\r\n"]
[11557.669601, "o", "\t\t}\r\n\t\tif s.ConnectionLimitMode == \"\" {\r\n\t\t\ts.ConnectionLimitMode = \"per-endpoint\"\r\n\t\t}\r\n\t\tif s.RateLimitBurst <= 0 {\r\n\t\t\ts.RateLimitBurst = s.RateLimitRps\r\n\t\t}\r\n\t\tif s.RateLimitQueueTimeoutMs <= 0 {\r\n\t\t\ts.RateLimitQueueTimeoutMs = 1000\r\n\t\t}\r\n\t\tif s.RetryDelayMs <= 0 {\r\n\t\t\ts.RetryDelayMs = 100\r\n"]
[11557.669665, "o", "\t\t}\r\n\t\tif s.RetryBackoffMultiplier <= 0 {\r\n\t\t\ts.RetryBackoffMultiplier = 2.0\r\n\t\t}\r\n\t\tif s.RetryMaxDelayMs <= 0 {\r\n\t\t\ts.RetryMaxDelayMs = 5000\r\n\t\t}\r\n\t\tfor j := range s.Endpoints {\r\n\t\t\tep := &s.Endpoints[j]\r\n"]
[11557.669727, "o", "\t\t\tif ep.HealthCheck == \"\" {\r\n\t\t\t\tep.HealthCheck = \"tcp\"\r\n\t\t\t}\r\n\t\t\tif ep.Weight < 0 {\r\n\t\t\t\tep.Weight = 0\r\n\t\t\t}\r\n\t\t\tif ep.WarmupDurationMs < 0 {\r\n\t\t\t\tep.WarmupDurationMs = 0\r\n\t\t\t}\r\n\t\t}\r\n\t"]
[11557.669789, "o", "}\r\n\treturn &cfg, nil\r\n}\r\n"]
[11557.670294, "o", "\u001b[?2004h"]
[11557.670359, "o", "root@n30009:/app# "]
[11557.967323, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/config/config.go')\ns = p.read_text()\nif 'removeDependencyCycles' not in s:\n    s = s.replace(\n'''                if ep.WarmupDurationMs < 0 {\n                        ep.WarmupDurationMs = 0\n                }\n                }\n        }\n        return &cfg, nil\n}\n''',\n'''                if ep.WarmupDurationMs < 0 {\n                        ep.WarmupDurationMs = 0\n                }\n                }\n                if s.DependsOn == nil {\n                        s.DependsOn = []string{}\n                }\n        }\n        cfg.Services = removeDependencyCycles(cfg.Services)\n        return &cfg, nil\n}\n\n// removeDependencyCycles drops dependency edges that would create cycles.\nfunc removeDependencyCycles(services []Service) []Service {\n        byName := make(map[string]int, len(services))\n        for i, svc := range services {\n                byName[svc.Name] = i\n        }\n        for i := range services {\n                seen := map[string]bool{services["]
[11557.96761, "i", "i].Name: true}\n                kept := make([]string, 0, len(services[i].DependsOn))\n                for _, dep := range services[i].DependsOn {\n                        if dep == services[i].Name {\n                                log.Printf(\"warning: dropping self dependency from %s to %s\", services[i].Name, dep)\n                                continue\n                        }\n                        if _, ok := byName[dep]; !ok {\n                                kept = append(kept, dep)\n                                continue\n                        }\n                        if createsCycle(services, byName, seen, services[i].Name, dep) {\n                                log.Printf(\"warning: dropping dependency edge from %s to %s to avoid circular dependency\", services[i].Name, dep)\n                                continue\n                        }\n                        kept = append(kept, dep)\n                }\n                services[i].DependsOn = kept\n        }\n        return services\n}\n\nfunc creates"]
[11557.967705, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
