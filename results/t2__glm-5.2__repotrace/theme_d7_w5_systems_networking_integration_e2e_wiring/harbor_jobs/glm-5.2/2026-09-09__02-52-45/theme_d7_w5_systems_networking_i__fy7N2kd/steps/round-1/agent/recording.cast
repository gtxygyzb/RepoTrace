[14584.911236, "o", "   243\t\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\r\n   244\t\tvar lastEndpoint *state.EndpointState\r\n   245\t\tfor attempt := 0; ; attempt++ {\r\n   246\t\t\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\r\n   247\t\t\tif err != nil {\r\n   248\t\t\t\tresult = \"rejected_no_endpoint\"\r\n   249\t\t\t\tendpoint = \"\"\r\n   250\t\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n"]
[14584.911299, "o", "   251\t\t\t\t\tss := r.state.GetService(service)\r\n   252\t\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n   253\t\t\t\t\t\tcand.Stats.RecordRejection()\r\n   254\t\t\t\t\t}\r\n   255\t\t\t\t}\r\n   256\t\t\t\tclient.Close()\r\n   257\t\t\t\treturn\r\n   258\t\t\t}\r\n"]
