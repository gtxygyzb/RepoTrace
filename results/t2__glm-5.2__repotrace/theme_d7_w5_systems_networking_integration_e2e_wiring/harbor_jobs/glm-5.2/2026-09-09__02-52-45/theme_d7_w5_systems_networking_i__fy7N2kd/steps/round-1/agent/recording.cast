[13811.758446, "o", "    41\t\tconsecSuccess     int\r\n    42\t\tconsecFailures    int\r\n    43\t\tdrainDeadline     time.Time\r\n    44\t\tremoved           bool\r\n    45\t\tconnIDCounter     int64\r\n    46\t\tcurrentWeight     int\r\n    47\t\tWarmupDurationMs  int\r\n    48\t\twarmupUntil       time.Time\r\n    49\t\tconnections       map[int64]*connectionInfo\r\n    50\t}\r\n    51\t\r\n    52\ttype connectionInfo struct {\r\n"]
[13811.758501, "o", "    53\t\tconn         net.Conn\r\n    54\t\tclientAddr   string\r\n    55\t\tstart        time.Time\r\n    56\t\tlastActivity time.Time\r\n    57\t\tbytesIn      int64\r\n    58\t\tbytesOut     int64\r\n    59\t}\r\n"]
[13811.758555, "o", "    60\t\r\n    61\ttype ServiceState struct {\r\n    62\t\tmu                        sync.Mutex\r\n    63\t\tName                      string\r\n    64\t\tListenPort                int\r\n    65\t\tRoutingMode               string\r\n    66\t\tDrainTimeoutMs            int\r\n    67\t\tMaxConnectionsPerEndpoint int\r\n"]
