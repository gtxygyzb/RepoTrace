[11530.106168, "o", "\u001b[?2004h> "]
[11530.106706, "o", "// removeDependencyCycles drops dependency edges that would create cycles.\r\n\u001b[?2004l\r"]
[11530.106768, "o", "\u001b[?2004h> "]
[11530.107176, "o", "func removeDependencyCycles(services []Service) []Service {\r\n\u001b[?2004l\r"]
[11530.107244, "o", "\u001b[?2004h> "]
[11530.107613, "o", "        byName := make(map[string]int, len(services))\r\n\u001b[?2004l\r"]
[11530.107666, "o", "\u001b[?2004h> "]
[11530.107943, "o", "        for i, svc := range services {\r\n\u001b[?2004l\r"]
[11530.108001, "o", "\u001b[?2004h> "]
[11530.108258, "o", "                byName[svc.Name] = i\r\n\u001b[?2004l\r"]
[11530.108313, "o", "\u001b[?2004h> "]
[11530.108432, "o", "        }\r\n"]
[11530.108493, "o", "\u001b[?2004l\r\u001b[?2004h"]
[11530.10855, "o", "> "]
[11530.108866, "o", "        for i := range services {\r\n\u001b[?2004l\r"]
[11530.108939, "o", "\u001b[?2004h"]
[11530.108995, "o", "> "]
[11530.109589, "o", "                seen := map[string]bool{services[i].Name: true}\r\n\u001b[?2004l\r"]
[11530.109656, "o", "\u001b[?2004h> "]
[11530.110153, "o", "                kept := make([]string, 0, len(services[i].DependsOn))\r\n\u001b[?2004l\r"]
[11530.110218, "o", "\u001b[?2004h> "]
[11530.11064, "o", "                for _, dep := range services[i].DependsOn {\r\n\u001b[?2004l\r"]
[11530.110699, "o", "\u001b[?2004h> "]
[11530.111069, "o", "                        if dep == services[i].Name {\r\n\u001b[?2004l\r"]
[11530.111133, "o", "\u001b[?2004h> "]
[11530.111966, "o", "                                log.Printf(\"warning: dropping self dependency from %s to %s\", services[i].Name, dep)\r\n\u001b[?2004l\r"]
[11530.112032, "o", "\u001b[?2004h> "]
[11530.112313, "o", "                                continue\r\n\u001b[?2004l\r"]
[11530.112372, "o", "\u001b[?2004h> "]
[11530.112566, "o", "                        }\r\n\u001b[?2004l\r"]
[11530.112623, "o", "\u001b[?2004h> "]
[11530.113003, "o", "                        if _, ok := byName[dep]; !ok {\r\n\u001b[?2004l\r"]
[11530.113059, "o", "\u001b[?2004h> "]
[11530.11348, "o", "                                kept = append(kept, dep)\r\n\u001b[?2004l\r"]
[11530.11354, "o", "\u001b[?2004h> "]
[11530.113751, "o", "                                continue\r\n\u001b[?2004l\r"]
[11530.113824, "o", "\u001b[?2004h> "]
[11530.113948, "o", "                        }\r\n\u001b[?2004l\r"]
[11530.114003, "o", "\u001b[?2004h> "]
[11530.114558, "o", "                        if createsCycle(services, byName, seen, services[i].Name, dep) {\r\n\u001b[?2004l\r"]
[11530.114619, "o", "\u001b[?2004h> "]
[11530.115382, "o", "                                log.Printf(\"warning: dropping dependency edge from %s to %s to avoid circular dependency\", services[i].Name, dep)\r\n\u001b[?2004l\r"]
[11530.11556, "o", "\u001b[?2004h> "]
[11530.115663, "o", "                                continue\r\n\u001b[?2004l\r"]
[11530.115725, "o", "\u001b[?2004h> "]
[11530.115845, "o", "                        }\r\n\u001b[?2004l\r"]
[11530.115904, "o", "\u001b[?2004h> "]
[11530.116153, "o", "                        kept = append(kept, dep)\r\n\u001b[?2004l\r"]
[11530.116208, "o", "\u001b[?2004h> "]
[11530.116303, "o", "                }\r\n\u001b[?2004l\r"]
[11530.116359, "o", "\u001b[?2004h> "]
[11530.116639, "o", "                services[i].DependsOn = kept\r\n\u001b[?2004l\r"]
[11530.116695, "o", "\u001b[?2004h> "]
[11530.116755, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11530.116814, "o", "> "]
[11530.116928, "o", "        return services\r\n\u001b[?2004l\r"]
[11530.116984, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11530.11704, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11530.117109, "o", "\u001b[?2004h> "]
[11530.117712, "o", "func createsCycle(services []Service, byName map[string]int, seen map[string]bool, start, dep string) bool {\r\n\u001b[?2004l\r"]
[11530.117774, "o", "\u001b[?2004h> "]
[11530.117894, "o", "        if seen[dep] {\r\n\u001b[?2004l\r"]
[11530.117949, "o", "\u001b[?2004h> "]
[11530.118093, "o", "                return true\r\n\u001b[?2004l\r"]
[11530.118149, "o", "\u001b[?2004h> "]
[11530.118194, "o", "        }\r\n\u001b[?2004l\r"]
[11530.118251, "o", "\u001b[?2004h"]
[11530.11831, "o", "> "]
[11530.118379, "o", "        seen[dep] = true\r\n\u001b[?2004l\r"]
[11530.11845, "o", "\u001b[?2004h> "]
[11530.118639, "o", "        defer delete(seen, dep)\r\n\u001b[?2004l\r"]
[11530.118695, "o", "\u001b[?2004h> "]
[11530.118931, "o", "        next := services[byName[dep]].DependsOn\r\n\u001b[?2004l\r"]
[11530.118989, "o", "\u001b[?2004h> "]
[11530.119153, "o", "        for _, d := range next {\r\n\u001b[?2004l\r"]
[11530.119215, "o", "\u001b[?2004h> "]
[11530.119469, "o", "                if d == start || d == dep {\r\n\u001b[?2004l\r"]
[11530.119527, "o", "\u001b[?2004h> "]
[11530.119705, "o", "                        return true\r\n\u001b[?2004l\r"]
[11530.119761, "o", "\u001b[?2004h> "]
[11530.119845, "o", "                }\r\n\u001b[?2004l\r"]
[11530.1199, "o", "\u001b[?2004h> "]
[11530.120149, "o", "                if _, ok := byName[d]; !ok {\r\n\u001b[?2004l\r"]
[11530.120204, "o", "\u001b[?2004h> "]
[11530.120407, "o", "                        continue\r\n\u001b[?2004l\r"]
[11530.120463, "o", "\u001b[?2004h> "]
[11530.120553, "o", "                }\r\n\u001b[?2004l\r"]
[11530.120609, "o", "\u001b[?2004h> "]
[11530.12096, "o", "                if createsCycle(services, byName, seen, start, d) {\r\n\u001b[?2004l\r"]
[11530.121016, "o", "\u001b[?2004h> "]
[11530.121188, "o", "                        return true\r\n\u001b[?2004l\r"]
[11530.121219, "o", "\u001b[?2004h> "]
[11530.121399, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11530.121475, "o", "        }\r\n\u001b[?2004l\r"]
[11530.121535, "o", "\u001b[?2004h> "]
[11530.121626, "o", "        return false\r\n\u001b[?2004l\r"]
[11530.121683, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11530.12174, "o", "\u001b[?2004h> '''\r\n"]
[11530.121797, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[11530.121879, "o", "    )\r\n\u001b[?2004l\r"]
[11530.121939, "o", "\u001b[?2004h> "]
