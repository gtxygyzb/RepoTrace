[5728.810904, "o", "   204\t\t\tss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))\r\n   205\t\t}\r\n   206\t\treturn ss\r\n   207\t}\r\n   208\t\r\n   209\tfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n   210\t\tss.mu.Lock()\r\n   211\t\tdefer ss.mu.Unlock()\r\n   212\t\tseen := make(map[string]bool)\r\n"]
[5728.811019, "o", "   213\t\tfor _, cep := range eps {\r\n   214\t\t\tseen[cep.Address] = true\r\n   215\t\t\tvar ep *EndpointState\r\n   216\t\t\tfor _, existing := range ss.Endpoints {\r\n   217\t\t\t\tif existing.Address == cep.Address {\r\n   218\t\t\t\t\tep = existing\r\n   219\t\t\t\t\tbreak\r\n   220\t\t\t\t}\r\n   221\t\t\t}\r\n   222\t\t\tif ep == nil {\r\n   223\t\t\t\tep = newEndpointState(cep, global)\r\n   224\t\t\t\tss.Endpoints = append(ss.Endpoints, ep)"]
[5728.811078, "o", "\r\n   225\t\t\t} else {\r\n   226\t\t\t\tep.mu.Lock()\r\n   227\t\t\t\tep.Config = cep\r\n   228\t\t\t\tep.Weight = cep.Weight\r\n   229\t\t\t\tep.mu.Unlock()\r\n   230\t\t\t}\r\n   231\t\t}\r\n"]
[5728.811141, "o", "   232\t\tfor _, ep := range ss.Endpoints {\r\n   233\t\t\tif !seen[ep.Address] {\r\n   234\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   235\t\t\t}\r\n   236\t\t}\r\n   237\t}\r\n   238\t\r\n   239\tfunc newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {\r\n   240\t\treturn &EndpointState{\r\n   241"]
[5728.811207, "o", "\t\t\tAddress:     cep.Address,\r\n   242\t\t\tWeight:      cep.Weight,\r\n   243\t\t\tConfig:      cep,\r\n   244\t\t\tState:       Unknown,\r\n   245\t\t\tCircuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n"]
[5728.81127, "o", "   246\t\t\tStats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n   247\t\t\tconnections: make(map[int64]*connectionInfo),\r\n   248\t\t}\r\n   249\t}\r\n   250\t\r\n   251\tfunc (s *State) GetService(name string) *ServiceState {\r\n   252\t\ts.mu.RLock()\r\n   253\t\tdefer s.mu.RUnlock()\r\n   254\t\treturn s.services[name]\r\n   255\t}\r\n   256\t\r\n   257\tfunc (s *State) Services() []*ServiceState {\r\n   258\t"]
