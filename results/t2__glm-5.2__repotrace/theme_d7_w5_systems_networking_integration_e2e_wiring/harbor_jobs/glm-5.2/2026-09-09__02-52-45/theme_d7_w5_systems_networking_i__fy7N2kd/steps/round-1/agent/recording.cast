[7407.976191, "o", "    26\t}\r\n    27\t\r\n    28\ttype Server struct {\r\n    29\t\tstate    *state.State\r\n    30\t\tpath     string\r\n    31\t\tlistener net.Listener\r\n    32\t\twg       sync.WaitGroup\r\n    33\t\tstop     chan struct{}\r\n    34\t\tdone     chan struct{}\r\n    35\t}\r\n    36\t\r\n    37\tfunc NewServer(s *state.State, path string) *Server {\r\n    38\t\treturn &Server{\r\n    39\t\t\tstate: s,\r\n    40\t\t\tpath:  path,\r\n    41\t\t\tstop:  make(chan struct{}),\r\n"]
[7407.97625, "o", "    42\t\t\tdone:  make(chan struct{}),\r\n    43\t\t}\r\n    44\t}\r\n    45\t\r\n    46\tfunc (s *Server) Start() error {\r\n    47\t\tos.Remove(s.path)\r\n    48\t\tln, err := net.Listen(\"unix\", s.path)\r\n    49\t\tif err != nil {\r\n    50\t\t\treturn err\r\n"]
[7407.97631, "o", "    51\t\t}\r\n    52\t\ts.listener = ln\r\n    53\t\tgo s.acceptLoop()\r\n    54\t\treturn nil\r\n    55\t}\r\n    56\t\r\n    57\tfunc (s *Server) Stop() {\r\n    58\t\tselect {\r\n    59\t\tcase <-s.stop:\r\n    60\t\tdefault:\r\n    61\t\t"]
