[2036.459275, "o", "\r\n   183\t\tep := res.Endpoint\r\n   184\t\r\n   185\t\tvar id int64\r\n   186\t\tif !res.Probe {\r\n   187\t\t\tvar ok bool\r\n   188\t\t\tid, ok = ep.TryAddConnection(client, res.MaxConns)\r\n   189\t\t\tif !ok {\r\n   190\t\t\t\tep.Stats.RecordRejection()\r\n   191\t\t\t\tclient.Close()\r\n   192\t\t\t\treturn\r\n   193\t\t\t}\r\n   194\t\t}\r\n   195\t\r\n   196\t\tbackend, err := net.Dial(\"tcp\", ep.Address)\r\n   197\t\tif err != nil {\r\n   198\t\t\tif id != 0 {\r\n   199\t\t\t\tep.RemoveConnection(id)\r\n   200\t\t\t}\r\n   201\t\t\tep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n   202\t\t\tif res.Probe {\r\n   203\t\t\t\tep.Circuit.ProbeFailure()\r\n   204\t\t\t}\r\n   205\t\t\tclient.Close()\r\n   206\t\t\treturn\r\n   207\t\t}\r\n   208\t\r\n   209\t\tif res.Probe {\r\n"]
[2036.459383, "o", "   210\t\t\tep.Circuit.ProbeSuccess()\r\n   211\t\t\tvar ok bool\r\n   212\t\t\tid, ok = ep.TryAddConnection(client, res.MaxConns)\r\n   213\t\t\tif !ok {\r\n   214\t\t\t\tep.Stats.RecordRejection()\r\n   215\t\t\t\tbackend.Close()\r\n   216\t\t\t\tclient.Close()\r\n   217\t\t\t\treturn\r\n   218\t\t\t}\r\n   219\t\t}\r\n   220\t\r\n   221\t\tbytesIn, bytesOut := forward(client, backend)\r\n   222\t\tbackend.Close()\r\n   223\t\tclient.Close()\r\n   224\t\tep.RemoveConnection(id)\r\n   225\t\tep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)\r\n   226\t}\r\n   227\t\r\n"]
[2036.459502, "o", "   228\tfunc forward(client, backend net.Conn) (int64, int64) {\r\n   229\t\tvar bytesIn, bytesOut int64\r\n   230\t\tvar wg sync.WaitGroup\r\n   231\t\twg.Add(2)\r\n   232\t\tgo func() {\r\n   233\t\t\tdefer wg.Done()\r\n   234\t\t\tn, _ := io.Copy(backend, client)\r\n   235\t\t\tbytesOut = n\r\n   236\t\t\tbackend.Close()\r\n   237\t\t\tclient.Close()\r\n   238\t\t}()\r\n   239\t\tgo func() {\r\n   240\t\t\tdefer wg.Done()\r\n   241\t\t\tn, _ := io.Copy(client, backend)\r\n   242\t\t\tbytesIn = n\r\n   243\t\t\tclient.Close()\r\n   244\t\t\tbackend.Close()\r\n   245\t\t}()\r\n   246\t\twg.Wait()\r\n   247\t\treturn bytesIn, bytesOut\r\n   248\t}\r\n   249\t\r\n   250\tfunc intToStr(i int) string {\r\n   251\t\t"]
[2036.459605, "o", "if i == 0 {\r\n   252\t\t\treturn \"0\"\r\n   253\t\t}\r\n   254\t\tvar buf [12]byte\r\n   255\t\tpos := len(buf)\r\n   256\t\tneg := false\r\n   257\t\tif i < 0 {\r\n   258\t\t\tneg = true\r\n   259\t\t\ti = -i\r\n   260\t\t}\r\n   261\t\tfor i > 0 {\r\n   262\t\t\tpos--\r\n   263\t\t\tbuf[pos] = byte('0' + i%10)\r\n"]
[2036.459777, "o", "   264\t\t\ti /= 10\r\n   265\t\t}\r\n   266\t\tif neg {\r\n   267\t\t\tpos--\r\n   268\t\t\tbuf[pos] = '-'\r\n   269\t\t}\r\n   270\t\treturn string(buf[pos:])\r\n   271\t}\r\n"]
