[4313.846972, "o", "     9\t\ttimestamp time.Time\r\n    10\t\tbytesIn   int64\r\n    11\t\tbytesOut  int64\r\n    12\t\t"]
[4313.847052, "o", "latency   time.Duration\r\n    13\t\terr       bool\r\n    14\t}\r\n    15\t\r\n    16\t// Collector keeps rolling connection statistics for one endpoint.\r\n    17\ttype Collector struct {\r\n    18\t\tmu         sync.Mutex\r\n    19\t\twindow     time.Duration\r\n    20\t\tentries    []entry\r\n    21\t\trejections []time.Time\r\n    22\t\r\n"]
[4313.847114, "o", "    23\t\trateLimited    int\r\n    24\t\tqueued         int\r\n    25\t\tqueueTimeouts  int\r\n    26\t\tretries        int\r\n    27\t\tretrySuccesses int\r\n    28\t}\r\n    29\t\r\n    30\t// New creates a collector with the given window length.\r\n    31\tfunc New(window time.Duration) *Collector {\r\n    32\t\tif window <= 0 {\r\n    33\t\t\twindow = time.Minute\r\n"]
[4313.847168, "o", "    34\t\t}\r\n    35\t\treturn &Collector{window: window}\r\n    36\t}\r\n    37\t\r\n    38\t// RecordConnection records a finished connection attempt.\r\n    39\tfunc (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\r\n    40\t\tc.mu.Lock()\r\n    41\t\tdefer c.mu.Unlock()\r\n"]
[4313.847222, "o", "    42\t\tnow := time.Now()\r\n    43\t\tc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\r\n    44\t\tc.trim(now)\r\n    45\t}\r\n    46\t\r\n    47\t// RecordRejection records a rejected connection because the endpoint was at capacity.\r\n    48\tfunc (c *Collector) RecordRejection() {\r\n    49\t"]
[4313.847273, "o", "\tc.mu.Lock()\r\n    50\t\tdefer c.mu.Unlock()\r\n    51\t\tnow := time.Now()\r\n    52\t\tc.rejections = append(c.rejections, now)\r\n    53\t\tc.trim(now)\r\n    54\t}\r\n"]
[4313.847323, "o", "    55\t\r\n    56\t// RecordRateLimited records a rate limit rejection.\r\n    57\tfunc (c *Collector) RecordRateLimited() {\r\n    58\t\tc.mu.Lock()\r\n    59\t\tdefer c.mu.Unlock()\r\n    60\t\tc.rateLimited++\r\n    61\t}\r\n    62\t\r\n    63\t// RecordQueued records a connection that was queued waiting for a token.\r\n"]
[4313.847373, "o", "    64\tfunc (c *Collector) RecordQueued() {\r\n    65\t\tc.mu.Lock()\r\n    66\t\tdefer c.mu.Unlock()\r\n    67\t\tc.queued++\r\n    68\t}\r\n    69\t\r\n    70\t// RecordQueueTimeout records a queue timeout rejection.\r\n"]
[4313.847411, "o", "    71\tfunc (c *Collector) RecordQueueTimeout() {\r\n    72\t\tc.mu.Lock()\r\n    73\t\tdefer c.mu.Unlock()\r\n    74\t\tc.queueTimeouts++\r\n    75\t}\r\n    76\t\r\n    77\t// RecordRetry records a retry attempt.\r\n    78\tfunc (c *Collector) RecordRetry() {\r\n"]
[4313.847481, "o", "    79\t\tc.mu.Lock()\r\n    80\t\tdefer c.mu.Unlock()\r\n    81\t\tc.retries++\r\n    82\t}\r\n    83\t\r\n    84\t// RecordRetrySuccess records a successful retry attempt.\r\n    85\tfunc (c *Collector) RecordRetrySuccess() {\r\n    86\t\tc.mu.Lock()\r\n    87\t\tdefer c.mu.Unlock()\r\n    88\t\tc.retrySuccesses++\r\n    89\t}\r\n"]
[4313.847497, "o", "    90\t\r\n    91\tfunc (c *Collector) trim(now time.Time) {\r\n"]
[4313.847564, "o", "    92\t\tcutoff := now.Add(-c.window)\r\n    93\t\t"]
[4313.847616, "o", "i := 0\r\n    94\t\tfor i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {\r\n    95\t\t\ti++\r\n    96\t\t}\r\n    97\t\tif i > 0 {\r\n    98\t\t\tc.entries = c.entries[i:]\r\n    99\t\t}\r\n   100\t\tj := 0\r\n   101\t\tfor j < len(c.rejections) && c.rejections[j].Before(cutoff) {\r\n"]
[4313.847667, "o", "   102\t\t\tj++\r\n   103\t\t}\r\n   104\t\tif j > 0 {\r\n   105\t\t\tc.rejections = c.rejections[j:]\r\n   106\t\t}\r\n   107\t}\r\n"]
[4313.847717, "o", "   108\t\r\n   109\t// Snapshot returns current windowed stats. active is supplied by the state manager.\r\n   110\tfunc (c *Collector) Snapshot(active int) Snapshot {\r\n   111\t\tc.mu.Lock()\r\n   112\t\tdefer c.mu.Unlock()\r\n   113\t\tnow := time.Now()\r\n   114\t\tcutoff := now.Add(-c.window)\r\n   115\t\tvar total int\r\n   116\t\t"]
[4313.847766, "o", "var bytesIn, bytesOut int64\r\n   117\t\tvar latencySum time.Duration\r\n   118\t\tvar errors int\r\n   119\t\tfor _, e := range c.entries {\r\n   120\t\t\tif e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {\r\n"]
