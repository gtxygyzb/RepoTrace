[7897.53599, "o", "func (l *Logger) run() {\r\n\u001b[?2004l\r"]
[7897.536046, "o", "\u001b[?2004h> "]
[7897.536102, "o", "\u0007for {\r\n\u001b[?2004l\r"]
[7897.536157, "o", "\u001b[?2004h> "]
[7897.536212, "o", "\u0007"]
