[11291.711303, "o", "\u001b[?2004h> "]
[11291.711385, "o", "\\t\\t\\thealthy++\r\n\u001b[?2004l\r"]
[11291.711472, "o", "\u001b[?2004h> \\t\\t}\r\n\u001b[?2004l\r\u001b[?2004h"]
[11291.711545, "o", "> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11291.711693, "o", "\\treturn healthy > 0, healthy\r\n\u001b[?2004l\r"]
[11291.71177, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\r\n"]
