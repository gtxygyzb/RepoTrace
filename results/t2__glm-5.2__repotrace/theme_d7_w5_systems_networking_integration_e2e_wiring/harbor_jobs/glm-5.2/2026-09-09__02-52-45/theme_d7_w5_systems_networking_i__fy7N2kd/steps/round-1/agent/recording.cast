[11011.546781, "o", "// removeDependencyCycles drops dependency edges that would create cycles.\r\n\u001b[?2004l\r"]
[11011.546852, "o", "\u001b[?2004h> "]
[11011.547133, "o", "func removeDependencyCycles(services []Service) []Service {\r\n\u001b[?2004l\r"]
[11011.547198, "o", "\u001b[?2004h> "]
[11011.547482, "o", "        byName := make(map[string]int, len(services))\r\n\u001b[?2004l\r"]
[11011.547551, "o", "\u001b[?2004h> "]
[11011.547818, "o", "        for i, svc := range services {\r\n\u001b[?2004l\r"]
[11011.547874, "o", "\u001b[?2004h> "]
[11011.548052, "o", "                byName[svc.Name] = i\r\n\u001b[?2004l\r"]
[11011.548112, "o", "\u001b[?2004h> "]
[11011.548171, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11011.548229, "o", "> "]
[11011.548376, "o", "        for i := range services {\r\n\u001b[?2004l\r"]
[11011.548457, "o", "\u001b[?2004h> "]
[11011.548868, "o", "                seen := map[string]bool{services[i].Name: true}\r\n\u001b[?2004l\r"]
[11011.548925, "o", "\u001b[?2004h> "]
[11011.549257, "o", "                kept := make([]string, 0, len(services[i].DependsOn))\r\n\u001b[?2004l\r"]
[11011.549313, "o", "\u001b[?2004h> "]
[11011.549737, "o", "                for _, dep := range services[i].DependsOn {\r\n\u001b[?2004l\r"]
[11011.5498, "o", "\u001b[?2004h> "]
[11011.55007, "o", "                        if dep == services[i].Name {\r\n\u001b[?2004l\r"]
[11011.55013, "o", "\u001b[?2004h> "]
[11011.55035, "o", "                                continue\r\n\u001b[?2004l\r"]
[11011.550449, "o", "\u001b[?2004h> "]
[11011.55063, "o", "                        }\r\n\u001b[?2004l\r"]
[11011.550696, "o", "\u001b[?2004h> "]
[11011.551063, "o", "                        if _, ok := byName[dep]; !ok {\r\n\u001b[?2004l\r"]
[11011.551124, "o", "\u001b[?2004h> "]
[11011.55145, "o", "                                kept = append(kept, dep)\r\n\u001b[?2004l\r"]
[11011.551519, "o", "\u001b[?2004h> "]
[11011.551784, "o", "                                continue\r\n\u001b[?2004l\r"]
[11011.551844, "o", "\u001b[?2004h> "]
[11011.55191, "o", "                        }\r\n\u001b[?2004l\r"]
[11011.551966, "o", "\u001b[?2004h> "]
[11011.552311, "o", "                        if createsCycle(services, byName, seen, services[i].Name, dep) {\r\n\u001b[?2004l\r"]
[11011.552369, "o", "\u001b[?2004h> "]
[11011.552526, "o", "                                continue\r\n\u001b[?2004l\r"]
[11011.552585, "o", "\u001b[?2004h> "]
[11011.552658, "o", "                        }\r\n\u001b[?2004l\r"]
[11011.552714, "o", "\u001b[?2004h> "]
[11011.552899, "o", "                        kept = append(kept, dep)\r\n\u001b[?2004l\r"]
[11011.552954, "o", "\u001b[?2004h> "]
[11011.553019, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11011.553076, "o", "> "]
[11011.55322, "o", "                services[i].DependsOn = kept\r\n\u001b[?2004l\r"]
[11011.553276, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[11011.553339, "o", "\u001b[?2004h> "]
[11011.553437, "o", "        return services\r\n\u001b[?2004l\r"]
[11011.553494, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11011.55355, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[11011.553609, "o", "> "]
[11011.554044, "o", "func createsCycle(services []Service, byName map[string]int, seen map[string]bool, start, dep string) bool {\r\n\u001b[?2004l\r"]
[11011.554101, "o", "\u001b[?2004h> "]
[11011.554165, "o", "        if seen[dep] {\r\n\u001b[?2004l\r"]
[11011.554219, "o", "\u001b[?2004h> "]
[11011.554316, "o", "                return true\r\n\u001b[?2004l\r"]
[11011.554374, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[11011.554443, "o", "\u001b[?2004h> "]
[11011.554577, "o", "        seen[dep] = true\r\n\u001b[?2004l\r"]
[11011.554638, "o", "\u001b[?2004h> "]
[11011.554822, "o", "        defer delete(seen, dep)\r\n\u001b[?2004l\r"]
[11011.554887, "o", "\u001b[?2004h> "]
[11011.555061, "o", "        next := services[byName[dep]].DependsOn\r\n\u001b[?2004l\r"]
[11011.555118, "o", "\u001b[?2004h> "]
[11011.555223, "o", "        for _, d := range next {\r\n\u001b[?2004l\r"]
[11011.555278, "o", "\u001b[?2004h> "]
[11011.555443, "o", "                if d == start || d == dep {\r\n\u001b[?2004l\r"]
[11011.555501, "o", "\u001b[?2004h> "]
[11011.555694, "o", "                        return true\r\n\u001b[?2004l\r"]
[11011.555752, "o", "\u001b[?2004h> "]
[11011.555808, "o", "                }\r\n\u001b[?2004l\r"]
[11011.555866, "o", "\u001b[?2004h> "]
[11011.556032, "o", "                if _, ok := byName[d]; !ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11011.556087, "o", "> "]
[11011.556198, "o", "                        continue\r\n\u001b[?2004l\r"]
[11011.556252, "o", "\u001b[?2004h> "]
[11011.556312, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11011.556366, "o", "> "]
[11011.556689, "o", "                if createsCycle(services, byName, seen, start, d) {\r\n\u001b[?2004l\r"]
[11011.556744, "o", "\u001b[?2004h> "]
[11011.556866, "o", "                        return true\r\n\u001b[?2004l\r"]
[11011.556921, "o", "\u001b[?2004h> "]
[11011.556985, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11011.55704, "o", ">         }\r\n\u001b[?2004l\r"]
[11011.557097, "o", "\u001b[?2004h> "]
[11011.557164, "o", "        return false\r\n\u001b[?2004l\r"]
[11011.557231, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11011.557319, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> "]
