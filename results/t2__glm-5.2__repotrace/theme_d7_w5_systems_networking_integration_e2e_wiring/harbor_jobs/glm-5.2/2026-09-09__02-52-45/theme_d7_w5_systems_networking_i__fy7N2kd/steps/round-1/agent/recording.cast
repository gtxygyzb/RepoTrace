[11820.597878, "o", "\u001b[?2004h> "]
[11820.609402, "o", "s = s.replace(\r\n\u001b[?2004l\r\u001b[?2004h> '''        case \"deps\":\r\n\u001b[?2004l\r\u001b[?2004h>                 ipcCmd = \"get_dependencies\"\r\n\u001b[?2004l\r\u001b[?2004h>                 if len(os.Args) >= 3 {\r\n\u001b[?2004l\r\u001b[?2004h>                         args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r\u001b[?2004h>                 } else {\r\n\u001b[?2004l\r\u001b[?2004h>                         args[\"name\"] = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> ''',\r\n\u001b[?2004l\r\u001b[?2004h> '''        case \"deps\":\r\n\u001b[?2004l\r\u001b[?2004h>                 if len(os.Args) >= 3 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.609538, "o", "                        ipcCmd = \"get_dependencies\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11820.609694, "o", "                        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
