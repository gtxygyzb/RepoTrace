[9486.103332, "o", "package router\r\n\r\nimport (\r\n\t\"io\"\r\n\t\"log\"\r\n\t\"net\"\r\n\t\"sync\"\r\n\t\"sync/atomic\"\r\n"]
[9486.103468, "o", "\t\"time\"\r\n\r\n\t\"meshrouter/internal/accesslog\"\r\n\t\"meshrouter/internal/state\"\r\n)\r\n\r\ntype serviceListener struct {\r\n\tservice  string\r\n\tport     int\r\n\tlistener net.Listener\r\n\tstop     chan struct{}\r\n\twg       sync.WaitGroup\r\n\tdone     chan struct{}\r\n}\r\n\r\ntype Router struct {\r\n\tstate     *state.State\r\n\taccessLog *accesslog.Logger\r\n"]
[9486.103548, "o", "\tmu        sync.Mutex\r\n\tlisteners map[string]*serviceListener\r\n}\r\n\r\nfunc NewRouter(s *state.State) *Router {\r\n\treturn &Router{\r\n"]
[9486.103615, "o", "\t\tstate:     s,\r\n\t\tlisteners: make(map[string]*serviceListener),\r\n\t}\r\n}\r\n\r\nfunc (r *Router) SetAccessLogger(l *accesslog.Logger) {\r\n\tr.accessLog = l\r\n}\r\n\r\nfunc (r *Router) Start() {\r\n\tfor _, ss := range r.state.Services() {\r\n\t\tif !ss.IsStopping() {\r\n\t\t\tr.startService(ss)\r\n"]
[9486.10368, "o", "\t\t}\r\n\t}\r\n}\r\n\r\nfunc (r *Router) Reload() {\r\n\tservices := r.state.Services()\r\n\tseen := make(map[string]bool)\r\n\t"]
[9486.103761, "o", "for _, ss := range services {\r\n\t\tseen[ss.Name] = true\r\n\t\tr.mu.Lock()\r\n\t\tsl, ok := r.listeners[ss.Name]\r\n\t\tr.mu.Unlock()\r\n"]
[9486.103822, "o", "\t\tif !ok {\r\n\t\t\tif !ss.IsStopping() {\r\n\t\t\t\tr.startService(ss)\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif sl.port != ss.ListenPort {\r\n\t\t\tr.stopService(ss.Name, true)\r\n\t\t\tr.startService(ss)\r\n\t\t}\r\n\t}\r\n"]
[9486.103884, "o", "\tr.mu.Lock()\r\n\tfor name := range r.listeners {\r\n\t\tif !seen[name] {\r\n\t\t\tr.mu.Unlock()\r\n\t\t\tr.stopService(name, true)\r\n\t\t\tr.mu.Lock()\r\n\t\t}\r\n\t}\r\n"]
[9486.10394, "o", "\tr.mu.Unlock()\r\n}\r\n\r\nfunc (r *Router) startService(ss *state.ServiceState) {\r\n\taddr := \":\" + intToStr(ss.ListenPort)\r\n\tln, err := net.Listen(\"tcp\", addr)\r\n\tif err != nil {\r\n"]
[9486.103996, "o", "\t\tlog.Printf(\"router: listen %s on %s failed: %v\", ss.Name, addr, err)\r\n\t\treturn\r\n\t}\r\n\tsl := &serviceListener{\r\n\t\tservice:  ss.Name,\r\n\t\tport:     ss.ListenPort,\r\n\t\tlistener: ln,\r\n"]
[9486.104056, "o", "\t\tstop:     make(chan struct{}),\r\n\t\tdone:     make(chan struct{}),\r\n\t}\r\n\tr.mu.Lock()\r\n\tr.listeners[ss.Name] = sl\r\n\tr.mu.Unlock()\r\n\tgo sl.acceptLoop(r)\r\n"]
[9486.104113, "o", "}\r\n\r\nfunc (r *Router) stopService(name string, drain bool) {\r\n\tr.mu.Lock()\r\n\tsl, ok := r.listeners[name]\r\n\tif ok {\r\n"]
[9486.104173, "o", "\t\tdelete(r.listeners, name)\r\n\t}\r\n\tr.mu.Unlock()\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tsl.stopAccept(drain, r)\r\n}\r\n\r\n"]
[9486.104228, "o", "func (r *Router) Stop() {\r\n\tr.mu.Lock()\r\n\tlisteners := r.listeners\r\n\tr.listeners = make(map[string]*serviceListener)\r\n\tr.mu.Unlock()\r\n\tvar wg sync.WaitGroup\r\n\tfor name, sl := range listeners {\r\n"]
[9486.104295, "o", "\t\twg.Add(1)\r\n\t\tgo func(name string, sl *serviceListener) {\r\n\t\t\tdefer wg.Done()\r\n\t\t\tsl.stopAccept(true, r)\r\n\t\t}(name, sl)\r\n"]
[9486.104352, "o", "\t}\r\n\twg.Wait()\r\n}\r\n\r\nfunc (sl *serviceListener) acceptLoop(r *Router) {\r\n\tdefer close(sl.done)\r\n\tfor {\r\n\t\tconn, err := sl.listener.Accept()\r\n\t\tif err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n"]
[9486.104419, "o", "\t\tsl.wg.Add(1)\r\n\t\tgo func(c net.Conn) {\r\n\t\t\tdefer sl.wg.Done()\r\n\t\t\tr.handleConn(sl.service, c)\r\n\t\t}(conn)\r\n\t}\r\n"]
[9486.104475, "o", "}\r\n\r\nfunc (sl *serviceListener) stopAccept(drain bool, r *Router) {\r\n\tselect {\r\n\tcase <-sl.stop:\r\n\tdefault:\r\n\t\tclose(sl.stop)\r\n\t}\r\n\tsl.listener.Close()\r\n"]
[9486.104532, "o", "\t<-sl.done\r\n\tif drain {\r\n\t\tss := r.state.GetService(sl.service)\r\n\t\ttimeout := 5 * time.Second\r\n\t\tif ss != nil {\r\n\t\t\ttimeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n"]
[9486.104591, "o", "\t\t\tif timeout <= 0 {\r\n\t\t\t\ttimeout = 5 * time.Second\r\n\t\t\t}\r\n\t\t}\r\n\t\tdone := make(chan struct{})\r\n\t\tgo func() {\r\n"]
[9486.104647, "o", "\t\t\tsl.wg.Wait()\r\n\t\t\tclose(done)\r\n\t\t}()\r\n\t\tselect {\r\n\t\tcase <-done:\r\n\t\tcase <-time.After(timeout):\r\n"]
[9486.104708, "o", "\t\t\tr.state.CloseServiceConnections(sl.service)\r\n\t\t\t<-done\r\n\t\t}\r\n\t} else {\r\n\t\tsl.wg.Wait()\r\n\t}\r\n}\r\n\r\n"]
[9486.10477, "o", "func (r *Router) handleConn(service string, client net.Conn) {\r\n\tstart := time.Now()\r\n\tclientAddr := \"\"\r\n\tif addr := client.RemoteAddr(); addr != nil {\r\n\t\tclientAddr = addr.String()\r\n\t}\r\n\r\n\tvar endpoint string\r\n\tvar bytesIn, bytesOut int64\r\n"]
[9486.10483, "o", "\tvar result string\r\n\tdefer func() {\r\n\t\tif result == \"\" {\r\n\t\t\tresult = \"success\"\r\n\t\t}\r\n\t\tif r.accessLog != nil {\r\n\t\t\tr.accessLog.Log(accesslog.Entry{\r\n\t\t\t\tService:    service,\r\n"]
[9486.104897, "o", "\t\t\t\tClient:     clientAddr,\r\n\t\t\t\tEndpoint:   endpoint,\r\n\t\t\t\tBytesIn:    bytesIn,\r\n\t\t\t\tBytesOut:   bytesOut,\r\n"]
[9486.104958, "o", "\t\t\t\tDurationMs: time.Since(start).Milliseconds(),\r\n\t\t\t\tResult:     result,\r\n\t\t\t})\r\n\t\t}\r\n\t}()\r\n\r\n\tss := r.state.GetService(service)\r\n\tif ss == nil {\r\n\t\tresult = \"rejected_no_endpoint\"\r\n\t\tclient.Close()\r\n\t\treturn\r\n"]
[9486.105019, "o", "\t}\r\n\r\n\tallowed, queued := ss.AcquireRateLimitToken()\r\n\tif !allowed {\r\n\t\tresult = \"rejected_rate_limit\"\r\n\t\tclient.Close()\r\n"]
[9486.105074, "o", "\t\treturn\r\n\t}\r\n\tif queued {\r\n\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n\t\t\tcand.Stats.RecordQueued()\r\n\t\t}\r\n\t}\r\n"]
[9486.105137, "o", "\r\n\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\r\n\tvar lastEndpoint *state.EndpointState\r\n\tfor attempt := 0; ; attempt++ {\r\n\t\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\r\n\t\tif err != nil {\r\n\t\t\tresult = \"rejected_no_endpoint\"\r\n"]
[9486.105202, "o", "\t\t\tendpoint = \"\"\r\n\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n\t\t\t\tss := r.state.GetService(service)\r\n"]
[9486.105257, "o", "\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n\t\t\t\t\tcand.Stats.RecordRejection()\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tclient.Close()\r\n\t\t\treturn\r\n\t\t}\r\n\t\tlastEndpoint = res.Endpoint\r\n\t\tep := res.Endpoint\r\n\t\tendpoint = ep.Address\r\n"]
[9486.105314, "o", "\r\n\t\tvar id int64\r\n\t\tif !res.Probe {\r\n\t\t\tvar ok bool\r\n\t\t\tid, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\r\n\t\t\tif !ok {\r\n"]
[9486.105386, "o", "\t\t\t\tresult = \"rejected_conn_limit\"\r\n\t\t\t\tep.Stats.RecordRejection()\r\n\t\t\t\tclient.Close()\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t"]
[9486.10546, "o", "backend, derr := net.Dial(\"tcp\", ep.Address)\r\n\t\tif derr != nil {\r\n\t\t\tif id != 0 {\r\n\t\t\t\tep.RemoveConnection(id)\r\n\t\t\t}\r\n\t\t\t"]
[9486.105516, "o", "ep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n\t\t\tif res.Probe {\r\n\t\t\t\tep.Circuit.ProbeFailure()\r\n\t\t\t} else {\r\n\t\t\t\tep.Circuit.Open()\r\n\t\t\t}\r\n\t\t\tif attempt >= maxRetries {\r\n"]
[9486.105572, "o", "\t\t\t\tresult = \"retry_exhausted\"\r\n\t\t\t\tclient.Close()\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tep.Stats.RecordRetry()\r\n\t\t\tr.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\r\n"]
[9486.105635, "o", "\t\t\tcontinue\r\n\t\t}\r\n\r\n\t\tif res.Probe {\r\n\t\t\tep.Circuit.ProbeSuccess()\r\n\t\t\tvar ok bool\r\n\t\t\tid, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\r\n"]
