[9494.707399, "o", "     1\tpackage accesslog\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"os\"\r\n"]
[9494.707513, "o", "     6\t\t\"path/filepath\"\r\n     7\t\t\"sync\"\r\n     8\t\t\"sync/atomic\"\r\n     9\t\t\"time\"\r\n    10\t)\r\n    11\t\r\n    12\t// Entry is one structured access log record.\r\n    13\ttype Entry struct {\r\n    14\t\tTs         string `json:\"ts\"`\r\n    15\t\tService    string `json:\"service\"`\r\n    16\t\tClient     string `json:\"client\"`\r\n"]
[9494.707593, "o", "    17\t\tEndpoint   string `json:\"endpoint\"`\r\n    18\t\tBytesIn    int64  `json:\"bytes_in\"`\r\n    19\t\tBytesOut   int64  `json:\"bytes_out\"`\r\n    20\t\tDurationMs int64  `json:\"duration_ms\"`\r\n    21\t\tResult     string `json:\"result\"`\r\n    22\t}\r\n    23\t\r\n    24\t// DefaultPath is the access log path required by meshrouter.\r\n    25\tconst DefaultPath = \"/app/logs/access.log\"\r\n    26\t\r\n    27\tconst maxFileSize = 1 << 20 // 1 MB\r\n    28"]
[9494.707666, "o", "\t\r\n    29\t// Logger writes access log entries asynchronously to a JSON-lines file.\r\n    30\ttype Logger struct {\r\n    31\t\tpath     string\r\n    32\t\tch       chan Entry\r\n"]
[9494.707693, "o", "    33\t\tstop     chan struct{}\r\n    34\t\tdone     chan struct{}\r\n    35\t\tstopped  int32\r\n    36\t\tstopOnce sync.Once\r\n    37\t\tmu       sync.Mutex\r\n    38\t\tfile     *os.File\r\n    39\t\tsize     int64\r\n    40\t}\r\n"]
[9494.707775, "o", "    41\t\r\n    42\t// New creates a Logger for path and starts its writer goroutine.\r\n    43\tfunc New(path string) *Logger {\r\n    44\t\tif path == \"\" {\r\n    45\t\t\tpath = DefaultPath\r\n    46\t\t}\r\n    47\t\tl := &Logger{\r\n    48\t\t\tpath: path,\r\n    49\t\t\tch:   make(chan Entry, 8192),\r\n    50\t"]
[9494.707839, "o", "\t\tstop: make(chan struct{}),\r\n    51\t\t\tdone: make(chan struct{}),\r\n    52\t\t}\r\n"]
[9494.707905, "o", "    53\t\tgo l.run()\r\n    54\t\treturn l\r\n    55\t}\r\n    56\t\r\n    57\t// Path returns the configured log file path.\r\n    58\tfunc (l *Logger) Path() string {\r\n    59\t\treturn l.path\r\n"]
[9494.70797, "o", "    60\t}\r\n    61\t\r\n    62\t// Log queues an entry for asynchronous writing. If the buffered channel is full,\r\n    63\t// the entry is written synchronously to avoid losing it.\r\n    64\tfunc (l *Logger) Log(entry Entry) {\r\n    65\t\tif atomic.LoadInt32(&l.stopped) != 0 {\r\n    66\t\t\treturn\r\n    67\t\t}\r\n"]
[9494.708038, "o", "    68\t\tentry.Ts = time.Now().UTC().Format(time.RFC3339Nano)\r\n    69\t\tselect {\r\n    70\t\tcase l.ch <- entry:\r\n    71\t\tdefault:\r\n    72\t\t\tl.writeLine(entry)\r\n    73\t\t}\r\n    74\t}\r\n    75\t\r\n    76\t// Stop flushes all buffered entries and closes the log file.\r\n    77\tfunc (l *Logger) Stop() {"]
[9494.708102, "o", "\r\n    78\t\tl.stopOnce.Do(func() {\r\n    79\t\t\tatomic.StoreInt32(&l.stopped, 1)\r\n    80\t\t\tclose(l.stop)\r\n    81\t\t\t<-l.done\r\n    82\t\t\tl.mu.Lock()\r\n    83\t\t\tif l.file != nil {\r\n    84\t\t\t\tl.file.Close()\r\n"]
[9494.708173, "o", "    85\t\t\t\tl.file = nil\r\n    86\t\t\t}\r\n    87\t\t\tl.mu.Unlock()\r\n    88\t\t})\r\n    89\t}\r\n    90\t\r\n    91\tfunc (l *Logger) run() {\r\n    92\t\tfor {\r\n    93\t\t\tselect {\r\n    94\t\t\tcase e := <-l.ch:\r\n    95\t\t\t\tl.writeLine(e)\r\n    96\t\t\tcase <-l.stop:\r\n    97\t\t\t\tl.drain()\r\n    98\t\t\t\tclose(l.done)\r\n    99\t\t\t\treturn\r\n   100\t\t\t}\r\n   101\t\t}\r\n   102\t}\r\n   103\t"]
[9494.708239, "o", "\r\n   104\tfunc (l *Logger) drain() {\r\n   105\t\tfor {\r\n   106\t\t\tselect {\r\n"]
[9494.708311, "o", "   107\t\t\tcase e := <-l.ch:\r\n   108\t\t\t\tl.writeLine(e)\r\n   109\t\t\tdefault:\r\n   110\t\t\t\treturn\r\n   111\t\t\t}\r\n   112\t\t}\r\n   113\t}\r\n   114\t\r\n   115\tfunc (l *Logger) writeLine(e Entry) {\r\n   116\t\tb, err := json.Marshal(e)\r\n   117\t\tif err != nil {\r\n   118\t\t\treturn\r\n   119\t\t}\r\n"]
[9494.708379, "o", "   120\t\tb = append(b, '\\n')\r\n   121\t\r\n   122\t\tl.mu.Lock()\r\n"]
[9494.708453, "o", "   123\t\tdefer l.mu.Unlock()\r\n   124\t\r\n   125\t\tif l.file == nil {\r\n   126\t\t\tif err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {\r\n   127\t\t\t\treturn\r\n   128\t\t\t}\r\n   129\t\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n   130\t\t\tif err != nil {\r\n   131\t\t\t\treturn\r\n"]
[9494.708523, "o", "   132\t\t\t}\r\n   133\t\t\tl.file = f\r\n   134\t\t\tif info, err := f.Stat(); err == nil {\r\n   135\t\t\t\tl.size = info.Size()\r\n   136\t\t\t}\r\n   137\t\t}\r\n   138\t\r\n   139\t\tif l.size > 0 && l.size+int64(len(b)) > maxFileSize {\r\n   140\t\t\tl.rotateLocked()\r\n   141\t\t}\r\n   142\t\r\n"]
[9494.708592, "o", "   143\t\tn, err := l.file.Write(b)\r\n   144\t\tif err != nil {\r\n   145\t\t\tl.size = 0\r\n   146\t\t\tif l.file != nil {\r\n   147\t\t\t\tl.file.Close()\r\n   148\t\t\t\tl.file = nil\r\n   149\t\t\t}\r\n   150\t\t\treturn\r\n   151\t\t}\r\n"]
[9494.708662, "o", "   152\t\tl.size += int64(n)\r\n   153\t}\r\n   154\t\r\n   155\tfunc (l *Logger) rotateLocked() {\r\n   156\t\tif l.file != nil {\r\n   157\t\t\tl.file.Close()\r\n   158\t\t\tl.file = nil\r\n   159\t\t}\r\n   160\t\tos.Remove(l.path + \".1\")\r\n   161\t\tif err := os.Rename(l.path, l.path+\".1\"); err != nil {\r\n   162\t\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n   163\t\t\tif err == nil {\r\n   164\t\t\t\tl.file = f\r\n   165\t\t\t\tif info, err := f.Stat(); err == nil {\r\n   166\t\t\t\t\tl.size = info.Size()\r\n"]
[9494.708733, "o", "   167\t\t\t\t}\r\n   168\t\t\t}\r\n   169\t\t\treturn\r\n   170\t\t}\r\n   171\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n   172\t\tif err != nil {\r\n   173\t\t\tl.size = 0\r\n   174\t\t\treturn\r\n   175\t\t}\r\n   176\t\tl.file = f\r\n   177\t\tl.size = 0\r\n"]
[9494.708798, "o", "   178\t}\r\n"]
