[8264.020898, "o", "   171\t\r\n   172\tfunc (r *Router) handleConn(service string, client net.Conn) {\r\n   173\t\tstart := time.Now()\r\n   174\t\tclientAddr := \"\"\r\n   175\t\tif addr := client.RemoteAddr(); addr != nil {\r\n"]
[8264.020998, "o", "   176\t\t\tclientAddr = addr.String()\r\n   177\t\t}\r\n   178\t\r\n   179\t\tvar endpoint string\r\n   180\t\tvar bytesIn, bytesOut int64\r\n   181\t\tvar result string\r\n   182\t\tdefer func() {\r\n   183\t\t\tif result == \"\" {\r\n   184\t\t\t\tresult = \"success\"\r\n   185\t\t\t}\r\n   186\t\t\tif r.accessLog != nil {\r\n   187\t\t\t\tr.accessLog.Log(accesslog.Entry{\r\n   188\t\t\t\t\tService:    service,\r\n   189\t\t\t\t\tClient:     clientAddr,\r\n"]
[8264.021081, "o", "   190\t\t\t\t\tEndpoint:   endpoint,\r\n   191\t\t\t\t\tBytesIn:    bytesIn,\r\n   192\t\t\t\t\tBytesOut:   bytesOut,\r\n   193\t\t\t\t\tDurationMs: time.Since(start).Milliseconds(),\r\n   194\t\t\t\t\tResult:     result,\r\n"]
[8264.021146, "o", "   195\t\t\t\t})\r\n   196\t\t\t}\r\n   197\t\t}()\r\n   198\t\r\n   199\t\tss := r.state.GetService(service)\r\n   200\t\tif ss == nil {\r\n   201\t\t\tresult = \"rejected_no_endpoint\"\r\n   202\t\t\tclient.Close()\r\n   203\t\t\treturn\r\n   204\t\t}\r\n   205\t\r\n   206\t\tallowed, queued := ss.AcquireRateLimitToken()\r\n   207\t\tif !allowed {\r\n   208\t\t\tresult = \"rejected_rate_limit\"\r\n   209\t\t\tclient.Close()\r\n   210\t\t\treturn\r\n   211\t\t}\r\n"]
[8264.021208, "o", "   212\t\tif queued {\r\n   213\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   214\t\t\t\tcand.Stats.RecordQueued()\r\n   215\t\t\t}\r\n   216\t\t}\r\n   217\t\r\n   218\t\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\r\n   219\t\tvar lastEndpoint *state.EndpointState\r\n   220\t"]
[8264.021271, "o", "\tfor attempt := 0; ; attempt++ {\r\n   221\t\t\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\r\n   222\t\t\tif err != nil {\r\n   223\t\t\t\tresult = \"rejected_no_endpoint\"\r\n   224\t\t\t\tclient.Close()\r\n   225\t\t\t\treturn\r\n   226\t\t\t}\r\n   227\t\t\tlastEndpoint = res.Endpoint\r\n   228\t\t"]
[8264.021341, "o", "\tep := res.Endpoint\r\n   229\t\t\tendpoint = ep.Address\r\n   230\t\r\n   231\t\t\tvar id int64\r\n   232\t\t\tif !res.Probe {\r\n   233\t\t\t\tvar ok bool\r\n   234\t\t\t\tid, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\r\n   235\t\t\t\tif !ok {\r\n   236\t\t\t\t\tresult = \"rejected_conn_limit\"\r\n   237\t\t\t\t\tep.Stats.RecordRejection()\r\n   238\t\t\t"]
[8264.021411, "o", "\t\tclient.Close()\r\n   239\t\t\t\t\treturn\r\n   240\t\t\t\t}\r\n   241\t\t\t}\r\n   242\t\r\n   243\t\t\tbackend, derr := net.Dial(\"tcp\", ep.Address)\r\n   244\t\t\tif derr != nil {\r\n"]
[8264.021472, "o", "   245\t\t\t\tif id != 0 {\r\n   246\t\t\t\t\tep.RemoveConnection(id)\r\n   247\t\t\t\t}\r\n   248\t\t\t\tep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n   249\t\t\t\tif res.Probe {\r\n   250\t\t\t\t\tep.Circuit.ProbeFailure()\r\n   251\t\t\t\t} else {\r\n   252\t\t\t\t\tep.Circuit.Open()\r\n"]
[8264.021531, "o", "   253\t\t\t\t}\r\n   254\t\t\t\tif attempt >= maxRetries {\r\n   255\t\t\t\t\tresult = \"retry_exhausted\"\r\n   256\t\t\t\t\tclient.Close()\r\n   257\t\t\t\t\treturn\r\n   258\t\t\t\t}\r\n   259\t\t\t\tep.Stats.RecordRetry()\r\n   260\t\t\t\tr.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\r\n"]
[8264.02159, "o", "   261\t\t\t\tcontinue\r\n   262\t\t\t}\r\n   263\t\r\n   264\t\t\tif res.Probe {\r\n   265\t\t\t\tep.Circuit.ProbeSuccess()\r\n   266\t\t\t\tvar ok bool\r\n   267\t\t\t\tid, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\r\n   268\t\t\t\tif !ok {\r\n   269\t\t\t\t\tresult = \"rejected_conn_limit\"\r\n   270\t\t\t\t\tep.Stats.RecordRejection()\r\n"]
[8264.021657, "o", "   271\t\t\t\t\tbackend.Close()\r\n   272\t\t\t\t\tclient.Close()\r\n   273\t\t\t\t\treturn\r\n   274\t\t\t\t}\r\n   275\t\t\t}\r\n"]
