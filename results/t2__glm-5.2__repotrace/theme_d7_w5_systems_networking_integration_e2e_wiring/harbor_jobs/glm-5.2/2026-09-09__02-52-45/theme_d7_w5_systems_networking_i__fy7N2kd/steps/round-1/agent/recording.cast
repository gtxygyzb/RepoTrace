[6720.291464, "o", "\t\t\tif res.Probe {\r\n   248\t\t\t\tep.Circuit.ProbeSuccess()\r\n   249\t\t\t\tvar ok bool\r\n   250\t\t\t\tid, ok = ep.TryAddConnection(client, res.MaxConns)\r\n   251\t\t\t\tif !ok {\r\n   252\t\t\t\t\tep.Stats.RecordRejection()\r\n   253\t\t\t\t\tbackend.Close()\r\n"]
