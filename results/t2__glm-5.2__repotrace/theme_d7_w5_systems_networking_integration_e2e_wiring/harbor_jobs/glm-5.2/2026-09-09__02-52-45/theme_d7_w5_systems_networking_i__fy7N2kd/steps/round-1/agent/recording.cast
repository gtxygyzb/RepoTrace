[9519.630034, "o", "\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// Record\u001b[01;31m\u001b[KQueue\u001b[m\u001b[Kd records a connection that was \u001b[01;31m\u001b[Kqueue\u001b[m\u001b[Kd waiting for a token.\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Collector) Record\u001b[01;31m\u001b[KQueue\u001b[m\u001b[Kd() {\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tc.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[Kd++\r\n"]
[9519.630077, "o", "\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KRecordQueueTimeout\u001b[m\u001b[K records a \u001b[01;31m\u001b[Kqueue\u001b[m\u001b[K timeout rejection.\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Collector) \u001b[01;31m\u001b[KRecordQueueTimeout\u001b[m\u001b[K() {\r\n"]
[9519.630126, "o", "\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tc.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[KTimeouts++\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// Record\u001b[01;31m\u001b[KRetry\u001b[m\u001b[K records a \u001b[01;31m\u001b[Kretry\u001b[m\u001b[K \u001b[01;31m\u001b[Kattempt\u001b[m\u001b[K.\r\n"]
[9519.630174, "o", "\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Collector) Record\u001b[01;31m\u001b[KRetry\u001b[m\u001b[K() {\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// Record\u001b[01;31m\u001b[KRetry\u001b[m\u001b[KSuccess records a successful \u001b[01;31m\u001b[Kretry\u001b[m\u001b[K \u001b[01;31m\u001b[Kattempt\u001b[m\u001b[K.\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Collector) Record\u001b[01;31m\u001b[KRetry\u001b[m\u001b[KSuccess() {\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tc.\u001b[01;31m\u001b[Kretry\u001b[m\u001b[KSuccesses++\r\n"]
[9519.630221, "o", "\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KQueue\u001b[m\u001b[Kd:              c.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[Kd,\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KQueue\u001b[m\u001b[KTimeouts:       c.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[KTimeouts,\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KRetry\u001b[m\u001b[KSuccesses:      c.\u001b[01;31m\u001b[Kretry\u001b[m\u001b[KSuccesses,\r\n"]
[9519.630266, "o", "\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K175\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KQueue\u001b[m\u001b[Kd              int     `json:\"\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[Kd\"`\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K176\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KQueue\u001b[m\u001b[KTimeouts       int     `json:\"\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[K_timeouts\"`\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KRetry\u001b[m\u001b[KSuccesses      int     `json:\"\u001b[01;31m\u001b[Kretry\u001b[m\u001b[K_successes\"`\r\n"]
[9519.630828, "o", "\u001b[?2004h"]
[9519.630891, "o", "root@n30009:/app# "]
[9519.917998, "i", "sed -n '1,140p' internal/accesslog/logger.go\n"]
[9519.918208, "o", "sed -n '1,140p' internal/accesslog/logger.go\r\n\u001b[?2004l\r"]
[9519.921053, "o", "package accesslog\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sync\"\r\n"]
[9519.921155, "o", "\t\"sync/atomic\"\r\n\t\"time\"\r\n)\r\n\r\n// Entry is one structured access log record.\r\ntype Entry struct {\r\n\tTs         string `json:\"ts\"`\r\n\tService    string `json:\"service\"`\r\n\tClient     string `json:\"client\"`\r\n\tEndpoint   string `json:\"endpoint\"`\r\n\tBytesIn    int64  `json:\"bytes_in\"`\r\n\tBytesOut   int64  `json:\"bytes_out\"`\r\n\tDurationMs int64  `json:\"duration_ms\"`\r\n\tResult     string `json:\"result\"`\r\n}\r\n\r\n// DefaultPath is the access log path required by meshrouter.\r\nconst DefaultPath = \"/app/logs/access.log\"\r\n"]
[9519.921231, "o", "\r\nconst maxFileSize = 1 << 20 // 1 MB\r\n\r\n// Logger writes access log entries asynchronously to a JSON-lines file.\r\ntype Logger struct {\r\n\tpath     string\r\n\tch       chan Entry\r\n\tstop     chan struct{}\r\n\tdone     chan struct{}\r\n\tstopped  int32\r\n\tstopOnce sync.Once\r\n\tmu       sync.Mutex\r\n\tfile     *os.File\r\n\t"]
[9519.921297, "o", "size     int64\r\n}\r\n\r\n// New creates a Logger for path and starts its writer goroutine.\r\n"]
[9519.921359, "o", "func New(path string) *Logger {\r\n\tif path == \"\" {\r\n\t\tpath = DefaultPath\r\n\t}\r\n\tl := &Logger{\r\n\t\tpath: path,\r\n\t\tch:   make(chan Entry, 8192),\r\n\t\tstop: make(chan struct{}),\r\n\t\tdone: make(chan struct{}),\r\n\t}\r\n\tgo l.run()\r\n\treturn l\r\n}\r\n\r\n// Path returns the configured log file path.\r\nfunc (l *Logger) Path() string {\r\n\treturn l.path\r\n}\r\n"]
[9519.921467, "o", "\r\n// Log queues an entry for asynchronous writing. If the buffered channel is full,\r\n// the entry is written synchronously to avoid losing it.\r\nfunc (l *Logger) Log(entry Entry) {\r\n\tif atomic.LoadInt32(&l.stopped) != 0 {\r\n\t\treturn\r\n"]
[9519.92153, "o", "\t}\r\n\tentry.Ts = time.Now().UTC().Format(time.RFC3339Nano)\r\n\tselect {\r\n\tcase l.ch <- entry:\r\n\tdefault:\r\n\t\tl.writeLine(entry)\r\n\t}\r\n}\r\n\r\n// Stop flushes all buffered entries and closes the log file.\r\nfunc (l *Logger) Stop() {\r\n\tl.stopOnce.Do(func() {\r\n\t\tatomic.StoreInt32(&l.stopped, 1)\r\n\t\tclose(l.stop)\r\n\t\t<-l.done\r\n\t\tl.mu.Lock()\r\n\t\tif l.file != nil {\r\n\t\t"]
[9519.921591, "o", "\tl.file.Close()\r\n\t\t\tl.file = nil\r\n\t\t}\r\n\t\tl.mu.Unlock()\r\n\t})\r\n}\r\n\r\nfunc (l *Logger) run() {\r\n\tfor {\r\n"]
[9519.921647, "o", "\t\tselect {\r\n\t\tcase e := <-l.ch:\r\n\t\t\tl.writeLine(e)\r\n\t\tcase <-l.stop:\r\n\t\t"]
[9519.921704, "o", "\tl.drain()\r\n\t\t\tclose(l.done)\r\n\t\t\treturn\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc (l *Logger) drain() {\r\n\tfor {\r\n\t\tselect {\r\n\t\tcase e := <-l.ch:\r\n\t\t\tl.writeLine(e)\r\n\t\tdefault:\r\n\t\t\treturn\r\n\t\t}\r\n"]
[9519.921761, "o", "\t}\r\n}\r\n\r\nfunc (l *Logger) writeLine(e Entry) {\r\n"]
[9519.921815, "o", "\tb, err := json.Marshal(e)\r\n\tif err != nil {\r\n\t\treturn\r\n\t}\r\n\tb = append(b, '\\n')\r\n\r\n\tl.mu.Lock()\r\n\tdefer l.mu.Unlock()\r\n\r\n\tif l.file == nil {\r\n\t\tif err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {\r\n\t"]
[9519.921841, "o", "\t\treturn\r\n\t\t}\r\n\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n\t\tif err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n\t\tl.file = f\r\n\t\tif info, err := f.Stat(); err == nil {\r\n\t"]
[9519.921916, "o", "\t\tl.size = info.Size()\r\n\t\t}\r\n\t}\r\n\r\n\tif l.size > 0 && l.size+int64(len(b)) > maxFileSize {\r\n\t\tl.rotateLocked()\r\n"]
[9519.92229, "o", "\u001b[?2004hroot@n30009:/app# "]
[9520.226884, "i", "sed -n '1,130p' internal/router/router.go\n"]
[9520.227303, "o", "sed -n '1,130p' internal/router/router.go\r\n"]
[9520.227386, "o", "\u001b[?2004l\r"]
[9520.230433, "o", "package router\r\n\r\nimport (\r\n\t\"io\"\r\n\t\"log\"\r\n\t\"net\"\r\n"]
[9520.230513, "o", "\t\"sync\"\r\n\t\"sync/atomic\"\r\n\t\"time\"\r\n\r\n\t\"meshrouter/internal/accesslog\"\r\n\t\"meshrouter/internal/state\"\r\n)\r\n\r\ntype serviceListener struct {\r\n\tservice  string\r\n\tport     int\r\n\tlistener net.Listener\r\n\tstop     chan struct{}\r\n\twg       sync.WaitGroup\r\n"]
[9520.230545, "o", "\tdone     chan struct{}\r\n}\r\n\r\ntype Router struct {\r\n\tstate     *state.State\r\n"]
[9520.230633, "o", "\taccessLog *accesslog.Logger\r\n\tmu        sync.Mutex\r\n\tlisteners map[string]*serviceListener\r\n}\r\n\r\nfunc NewRouter(s *state.State) *Router {\r\n\treturn &Router{\r\n\t\tstate:     s,\r\n\t\tlisteners: make(map[string]*serviceListener),\r\n\t}\r\n}\r\n\r\nfunc (r *Router) SetAccessLogger(l *accesslog.Logger) {\r\n\tr.accessLog = l\r\n}\r\n"]
[9520.230654, "o", "\r\nfunc (r *Router) Start() {\r\n"]
[9520.230738, "o", "\tfor _, ss := range r.state.Services() {\r\n\t\tif !ss.IsStopping() {\r\n\t\t\tr.startService(ss)\r\n"]
[9520.230802, "o", "\t\t}\r\n\t}\r\n}\r\n\r\nfunc (r *Router) Reload() {\r\n\tservices := r.state.Services()\r\n\tseen := make(map[string]bool)\r\n\tfor _, ss := range services {\r\n\t\tseen[ss.Name] = true\r\n\t\tr.mu.Lock()\r\n\t\tsl, ok := r.listeners[ss.Name]\r\n\t\tr.mu.Unlock()\r\n\t\tif !ok {\r\n\t\t\tif !ss.IsStopping() {\r\n\t\t\t\tr.startService(ss)\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif sl.port != ss.ListenPort {\r\n\t\t\tr.stopService(ss.Name, true)\r\n\t\t\tr.startService(ss)\r\n\t"]
[9520.230952, "o", "\t}\r\n\t}\r\n\tr.mu.Lock()\r\n\tfor name := range r.listeners {\r\n"]
[9520.231024, "o", "\t\tif !seen[name] {\r\n\t\t\tr.mu.Unlock()\r\n\t\t\tr.stopService(name, true)\r\n\t\t\tr.mu.Lock()\r\n\t\t}\r\n\t}\r\n\tr.mu.Unlock()\r\n}\r\n\r\nfunc (r *Router) startService(ss *state.ServiceState) {\r\n\taddr := \":\" + intToStr(ss.ListenPort)\r\n\tln, err := net.Listen(\"tcp\", addr)\r\n\tif err != nil {\r\n\t\tlog.Printf(\"router: listen %s on %s failed: %v\", ss.Name, addr, err)\r\n\t\treturn\r\n\t}\r\n\tsl := &serviceListener{\r\n\t\tservice:  ss.Name,\r\n\t\tport:     ss.ListenPort,\r\n\t\tlistener: ln,\r\n\t\tstop:     make(chan struct{}),\r\n\t\tdone:     make(chan struct{}),\r\n\t}\r\n\tr.mu.Lock()\r\n"]
[9520.231105, "o", "\tr.listeners[ss.Name] = sl\r\n\tr.mu.Unlock()\r\n\tgo sl.acceptLoop(r)\r\n}\r\n\r\nfunc (r *Router) stopService(name string, drain bool) {\r\n\tr.mu.Lock()\r\n\tsl, ok := r.listeners[name]\r\n\tif ok {\r\n\t\tdelete(r.listeners, name)\r\n\t}\r\n"]
[9520.231176, "o", "\tr.mu.Unlock()\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tsl.stopAccept(drain, r)\r\n}\r\n\r\nfunc (r *Router) Stop() {\r\n\tr.mu.Lock()\r\n\tlisteners := r.listeners\r\n\tr.listeners = make(map[string]*serviceListener)\r\n\tr.mu.Unlock()\r\n\tvar wg sync.WaitGroup\r\n\tfor name, sl := range listeners {\r\n"]
[9520.231234, "o", "\t\twg.Add(1)\r\n\t\tgo func(name string, sl *serviceListener) {\r\n\t\t\tdefer wg.Done()\r\n\t\t\tsl.stopAccept(true, r)\r\n\t\t}(name, sl)\r\n\t}\r\n\twg.Wait()\r\n}\r\n\r\nfunc (sl *serviceListener) acceptLoop(r *Router) {\r\n\tdefer close(sl.done)\r\n"]
[9520.231797, "o", "\u001b[?2004h"]
