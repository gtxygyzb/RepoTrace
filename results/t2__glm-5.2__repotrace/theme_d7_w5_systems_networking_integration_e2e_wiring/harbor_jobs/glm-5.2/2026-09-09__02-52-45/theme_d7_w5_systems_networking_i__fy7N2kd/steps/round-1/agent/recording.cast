[5946.993643, "o", "\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(s *State) Resolve\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[K(service string) (string, error) {\r\n\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tmaxConns := ss.MaxConnectionsPer\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[K\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tendpoints := make([]*\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[KState, len(ss.\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks))\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcopy(endpoints, ss.\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks)\r\n\u001b[32m\u001b[K167\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar regular []*\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[KState\r\n"]
[5946.993692, "o", "\u001b[32m\u001b[K179\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tvar best *\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[KState\r\n\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tvar best\u001b[01;31m\u001b[KWeight\u001b[m\u001b[K int\r\n"]
[5946.99371, "o", "\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcw := ep.current\u001b[01;31m\u001b[KWeight\u001b[m\u001b[K + ep.\u001b[01;31m\u001b[KWeight\u001b[m\u001b[K\r\n"]
[5946.993776, "o", "\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif best == nil || cw > best\u001b[01;31m\u001b[KWeight\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tbest\u001b[01;31m\u001b[KWeight\u001b[m\u001b[K = cw\r\n\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.\u001b[01;31m\u001b[KWeight\u001b[m\u001b[K > 0 && ep.State != Draining && ep.\u001b[01;31m\u001b[KActiveConnections\u001b[m\u001b[K < maxConns && !ep.Circuit.ProbeActive()\r\n"]
