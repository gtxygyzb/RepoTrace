[7412.978747, "o", "\t\tdelay := float64(delayMs) * pow(multiplier, float64(attempt))\r\n   279\t\tif maxDelayMs > 0 && delay > float64(maxDelayMs) {\r\n   280\t\t\tdelay = float64(maxDelayMs)\r\n   281\t\t}\r\n   282\t\tif delay > 0 {\r\n   283\t\t\ttime.Sleep(time.Duration(delay) * time.Millisecond)\r\n   284\t\t}\r\n   285\t}\r\n   286\t\r\n   287\tfunc pow(base, exp float64) float64 {\r\n   288\t\tresult := 1.0\r\n   289\t\tfor i := 0; i < int(exp); i++ {\r\n   290\t\t\tresult *= base\r\n   291\t\t}\r\n   292\t\treturn result\r\n   293\t}"]
