[13875.936913, "o", "     1\tpackage accesslog\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n"]
[13875.937013, "o", "     5\t\t\"os\"\r\n     6\t\t\"path/filepath\"\r\n     7\t\t\"sync\"\r\n     8\t\t\"sync/atomic\"\r\n     9\t\t\"time\"\r\n    10\t)\r\n    11\t\r\n    12\t// Entry is one structured access log record.\r\n    13\ttype Entry struct {\r\n    14\t\tTs               string `json:\"ts\"`\r\n    15\t\tService          string `json:\"service\"`\r\n    16\t\tClient           string `json:\"client\"`\r\n    17\t\tEndpoint         string `json:\"endpoint\"`\r\n    18\t\tBytesIn          int64  `json:\"bytes_in\"`\r\n    19\t\t"]
[13875.937097, "o", "BytesOut         int64  `json:\"bytes_out\"`\r\n    20\t\tDurationMs       int64  `json:\"duration_ms\"`\r\n    21\t\tResult           string `json:\"result\"`\r\n    22\t\tRetried          bool   `json:\"retried\"`\r\n    23\t\tRetryCount       int    `json:\"retry_count\"`\r\n    24\t\tQueueWaitMs      *int64 `json:\"queue_wait_ms,omitempty\"`\r\n    25\t\tFailedDependency string `json:\"failed_dependency,omitempty\"`\r\n    26\t}\r\n    27\t\r\n    28\t// DefaultPath is the access log path required by meshrouter.\r\n    29\tconst DefaultPath = \"/app/logs/access.log\"\r\n    30\t\r\n"]
[13875.937163, "o", "    31\tconst maxFileSize = 1 << 20 // 1 MB\r\n    32\t\r\n    33\t// Logger writes access log entries asynchronously to a JSON-lines file.\r\n    34\ttype Logger struct {\r\n    35\t\tpath     string\r\n    36\t\tch       chan Entry\r\n    37\t\tstop     chan struct{}\r\n    38\t\tdone     chan struct{}\r\n    39\t\tstopped  int32\r\n    40\t"]
[13875.937231, "o", "\tstopOnce sync.Once\r\n    41\t\tmu       sync.Mutex\r\n    42\t\tfile     *os.File\r\n    43\t\tsize     int64\r\n    44\t}\r\n    45\t\r\n    46\t// New creates a Logger for path and starts its writer goroutine.\r\n    47\tfunc New(path string) *Logger {\r\n    48\t\tif path == \"\" {\r\n    49\t\t\tpath = DefaultPath\r\n    50\t\t}\r\n    51"]
[13875.93729, "o", "\t\tl := &Logger{\r\n    52\t\t\tpath: path,\r\n    53\t\t\tch:   make(chan Entry, 8192),\r\n    54\t\t\tstop: make(chan struct{}),\r\n    55\t\t\tdone: make(chan struct{}),\r\n    56\t\t}\r\n    57\t\tgo l.run()\r\n    58\t\treturn l\r\n    59\t}\r\n"]
[13875.937354, "o", "    60\t\r\n    61\t// Path returns the configured log file path.\r\n    62\tfunc (l *Logger) Path() string {\r\n    63\t\treturn l.path\r\n    64\t}\r\n    65\t\r\n    66\t// Log queues an entry for asynchronous writing. If the buffered channel is full,\r\n    67\t// the entry is written synchronously to avoid losing it.\r\n    68\tfunc (l *Logger) Log(entry Entry) {\r\n    69\t\tif atomic.LoadInt32(&l.stopped) != 0 {\r\n    70\t\t\treturn\r\n"]
[13875.937434, "o", "    71\t\t}\r\n    72\t\tentry.Ts = time.Now().UTC().Format(time.RFC3339Nano)\r\n    73\t\tselect {\r\n    74\t\tcase l.ch <- entry:\r\n    75\t\tdefault:\r\n    76\t\t\tl.writeLine(entry)\r\n    77\t\t}\r\n    78\t}\r\n    79\t\r\n    80\t// Stop flushes all buffered entries and closes the log file.\r\n    81\tfunc (l *Logger) Stop() {\r\n    82\t\tl.stopOnce.Do(func() {\r\n    83\t\t\tatomic.StoreInt32(&l.stopped, 1)\r\n"]
[13875.937494, "o", "    84\t\t\tclose(l.stop)\r\n    85\t\t\t<-l.done\r\n    86\t\t\tl.mu.Lock()\r\n    87\t\t\tif l.file != nil {\r\n    88\t\t\t\tl.file.Close()\r\n    89\t\t\t\tl.file = nil\r\n    90\t\t\t}\r\n"]
[13875.937551, "o", "    91\t\t\tl.mu.Unlock()\r\n    92\t\t})\r\n    93\t}\r\n    94\t\r\n    95\tfunc (l *Logger) run() {\r\n    96\t\tfor {\r\n    97\t\t\tselect {\r\n    98\t\t\tcase e := <-l.ch:\r\n    99\t\t\t\tl.writeLine(e)\r\n   100\t\t\tcase <-l.stop:\r\n"]
