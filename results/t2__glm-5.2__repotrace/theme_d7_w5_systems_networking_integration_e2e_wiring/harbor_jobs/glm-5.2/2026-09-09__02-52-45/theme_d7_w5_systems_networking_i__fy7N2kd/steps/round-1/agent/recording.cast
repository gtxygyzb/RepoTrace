[8128.258295, "o", "result string\r\n    defer func() {\r\n        if result == \"\" {\r\n            result = \"success\"\r\n        }\r\n        if r.accessLog != nil {\r\n            r.accessLog.Log(accesslog.Entry{\r\n                Service:    service,\r\n                Client:   "]
[8128.258353, "i", "      }\n        bytesIn, bytesOut, idleClosed := forward(client, backend, ep, id, ss.IdleTimeout())\n        backend.Close()\n        client.Close()\n        ep.RemoveConnection(id)\n        ep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)\n        if idleClosed {\n            result = \"idle_timeout\"\n            ep.Stats.RecordIdleTimeout()\n        } else {\n            result = \"success\"\n        }\n        return\n    }\n}\n\"\"\"\n\nlines = text.split(\"\\n\")\nstart = end = None\nfor i, line in enumerate(lines):\n    if line.startswith(\"func (r *Router) handleConn(service string, client net.Conn) {\"):\n        start = i\n    if start is not None and line.startswith(\"func (r *Router) sleepRetry(\"):\n        end = i\n        break\nif start is None or end is None:\n    raise SystemExit(\"could not locate handleConn\")\nlines = lines[:start] + new_handle.split(\"\\n\") + lines[end:]\npath.write_text(\"\\n\".join(lines))\nPY\npython3 edit_router.py\n"]
