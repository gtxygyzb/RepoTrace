[2021.488513, "o", "\r\n    58\t\r\n    59\t// SelectCandidate returns the endpoint that would be selected ignoring connection limits.\r\n    60\t// Used to account rejected_connections when all eligible endpoints are at capacity.\r\n    61\tfunc (s *State) SelectCandidate(service string) (*EndpointState, error) {\r\n    62\t\tss := s.GetService(service)\r\n    63\t\tif ss == nil {\r\n    64\t\t\treturn nil, errNotFound(\"service not found\")\r\n    65\t\t}\r\n    66\t\tss.mu.Lock()\r\n    67\t\tmode := ss.RoutingMode\r\n    68\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n    69\t\tcopy(endpoints, ss.Endpoints)\r\n    70\t\tss.mu.Unlock()\r\n"]
