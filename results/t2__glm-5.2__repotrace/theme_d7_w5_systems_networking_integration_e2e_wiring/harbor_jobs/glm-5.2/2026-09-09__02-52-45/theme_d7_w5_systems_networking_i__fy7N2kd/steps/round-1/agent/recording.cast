[2744.169171, "o", "     1\tpackage state\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"container/list\"\r\n     5\t\t\"sync\"\r\n"]
[2744.169294, "o", "     6\t\t\"time\"\r\n     7\t)\r\n     8\t\r\n     9\ttype rateLimiter struct {\r\n    10\t\tmu          sync.Mutex\r\n    11\t\trps         float64\r\n    12\t\tburst       float64\r\n    13\t\ttokens      float64\r\n    14\t\tlast        time.Time\r\n    15\t\tqueue       *list.List\r\n    16\t\tqueueMax    int\r\n    17\t\ttimeout     time.Duration\r\n    18\t\trateLimited uint64\r\n    19\t\tqueued      uint64\r\n    20\t\ttimeouts    uint64\r\n    21\t}\r\n    22\t\r\n    23\tfunc newRateLimiter(rps, burst int, queueDepth int, timeoutMs int) *rateLimiter {\r\n    24\t\treturn &rateLimiter{\r\n"]
[2744.169379, "o", "    25\t\t\trps:      float64(rps),\r\n    26\t\t\tburst:    float64(burst),\r\n    27\t\t\ttokens:   float64(burst),\r\n    28\t\t\tlast:     time.Now(),\r\n    29\t\t\tqueue:    list.New(),\r\n    30\t\t\tqueueMax: queueDepth,\r\n    31\t\t\ttimeout:  time.Duration(timeoutMs) * time.Millisecond,\r\n    32\t\t}\r\n    33\t}\r\n    34\t\r\n    35\tfunc (rl *rateLimiter) update(rps, burst int, queueDepth int, timeoutMs int) {\r\n    36\t\trl.mu.Lock()\r\n    37\t\tdefer rl.mu.Unlock()\r\n    38\t\t"]
[2744.169512, "o", "rl.rps = float64(rps)\r\n    39\t\trl.burst = float64(burst)\r\n    40\t\tif rl.tokens > rl.burst {\r\n    41\t\t\trl.tokens = rl.burst\r\n    42\t\t}\r\n    43\t\trl.queueMax = queueDepth\r\n    44\t\trl.timeout = time.Duration(timeoutMs) * time.Millisecond\r\n    45\t}\r\n    46\t\r\n    47\tfunc (rl *rateLimiter) refillLocked(now time.Time) {\r\n    48\t\telapsed := now.Sub(rl.last).Seconds()\r\n    49\t\tif elapsed > 0 {\r\n    50\t\t\trl.tokens += rl.rps * elapsed\r\n    51\t\t\tif rl.burst > 0 && rl.tokens > rl.burst {\r\n    52\t\t\t\trl.tokens = rl.burst\r\n    53\t\t\t}\r\n"]
[2744.169578, "o", "    54\t\t\trl.last = now\r\n    55\t\t}\r\n    56\t}\r\n    57\t\r\n    58\tfunc (rl *rateLimiter) tryAcquire(now time.Time) bool {\r\n    59\t\trl.mu.Lock()\r\n    60\t\tdefer rl.mu.Unlock()\r\n    61\t\trl.refillLocked(now)\r\n    62\t\tif rl.rps <= 0 || rl.tokens >= 1 {\r\n    63\t\t\tif rl.rps > 0 {\r\n    64\t\t\t\trl.tokens -= 1\r\n    65\t\t\t}\r\n"]
[2744.169669, "o", "    66\t\t\treturn true\r\n    67\t\t}\r\n    68\t\treturn false\r\n    69\t}\r\n    70\t\r\n    71\ttype queuedWaiter struct {\r\n    72\t\tdeadline time.Time\r\n    73\t\tch       chan struct{}\r\n    74\t}\r\n    75\t\r\n    76\tfunc (rl *rateLimiter) acquire(now time.Time) (bool, bool) {\r\n    77\t\trl.mu.Lock()\r\n"]
