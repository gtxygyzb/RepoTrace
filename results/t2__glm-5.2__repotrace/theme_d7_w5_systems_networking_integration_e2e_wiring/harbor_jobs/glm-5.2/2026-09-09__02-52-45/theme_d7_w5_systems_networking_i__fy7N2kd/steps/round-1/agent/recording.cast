[2581.795376, "o", "[global]\r\nhealth_interval_ms = 2000\r\nunhealthy_threshold = 3\r\nhealthy_threshold = 2\r\nstats_window_sec = 60\r\ncircuit_breaker_threshold = 3\r\n"]
[2581.795474, "o", "circuit_breaker_timeout_ms = 5000\r\n\r\n[[service]]\r\nname = \"api-gateway\"\r\nlisten_port = 9001\r\nrouting_mode = \"weighted-round-robin\"\r\ndrain_timeout_ms = 5000\r\nmax_connections_per_endpoint = 50\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8081\"\r\n  weight = 5\r\n  health_check = \"tcp\"\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8082\"\r\n  weight = 3\r\n  health_check = \"http\"\r\n  health_path = \"/healthz\"\r\n"]
[2581.795534, "o", "\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8083\"\r\n  weight = 2\r\n  health_check = \"tcp\"\r\n\r\n[[service]]\r\nname = \"data-store\"\r\nlisten_port = 9002\r\nrouting_mode = \"least-connections\"\r\ndrain_timeout_ms = 10000\r\nmax_connections_per_endpoint = 3\r\n\r\n"]
[2581.795581, "o", "  [[service.endpoint]]\r\n  address = \"127.0.0.1:8091\"\r\n  weight = 1\r\n  health_check = \"tcp\"\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8092\"\r\n  weight = 1\r\n  health_check = \"exec\"\r\n  health_cmd = \"nc -z 127.0.0.1 8092\"\r\n"]
[2581.795604, "o", "\r\n[[service]]\r\nname = \"cache-layer\"\r\nlisten_port = 9003\r\nrouting_mode = \"weighted-round-robin\"\r\ndrain_timeout_ms = 3000\r\n"]
[2581.795654, "o", "max_connections_per_endpoint = 100\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8071\"\r\n  weight = 4\r\n  health_check = \"tcp\"\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8072\"\r\n  weight = 4\r\n  health_check = \"tcp\"\r\n"]
