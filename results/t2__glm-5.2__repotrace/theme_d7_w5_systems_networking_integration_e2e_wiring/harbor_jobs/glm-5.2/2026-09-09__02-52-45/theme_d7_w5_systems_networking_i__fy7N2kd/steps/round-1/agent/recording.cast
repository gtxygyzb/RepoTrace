[2249.281753, "i", "ServiceState) AcquireRateLimitToken() (bool, bool) {\n\tss.mu.Lock()\n\trl := ss.rateLimiter\n\tss.mu.Unlock()\n\tif rl == nil {\n\t\treturn true, false\n\t}\n\treturn rl.acquire(time.Now())\n}\n\nfunc (ss *ServiceState) ReleaseRateLimitToken() {\n\tss.mu.Lock()\n\trl := ss.rateLimiter\n\tss.mu.Unlock()\n\tif rl != nil {\n\t\trl.releaseToken()\n\t}\n}\n\nfunc (ss *ServiceState) RateLimitStatus() (tokens float64, queueDepth int, rateLimited uint64, queued uint64, timeouts uint64, rps float64, burst float64) {\n\tss.mu.Lock()\n\trl := ss.rateLimiter\n\tss.mu.Unlock()\n\tif rl == nil {\n\t\treturn 0, 0, 0, 0, 0, 0, 0\n\t}\n\treturn rl.status()\n}\n\nfunc (ss *ServiceState) RetryConfig() (maxRetries int, delayMs int, multiplier float64, maxDelayMs int) {\n\tss.mu.Lock()\n\tdefer ss.mu.Unlock()\n\treturn ss.MaxRetries, ss.RetryDelayMs, ss.RetryBackoffMultiplier, ss.RetryMaxDelayMs\n}\n\nfunc (s *State) SetRateLimit(name string, rps, burst int) error {\n\tss := s.GetService(name)\n\tif ss == nil {\n\t\treturn errNotFound(\"service not found\")\n\t}\n\tss.mu.Lock()\n\tdefer ss.mu.Unlock()\n\t"]
