[11724.453634, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11724.453688, "o", "\u001b[?2004h> "]
[11724.453743, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11724.45381, "o", "> "]
[11724.453919, "o", "        if resp.Status != \"ok\" {\r\n\u001b[?2004l\r"]
[11724.453979, "o", "\u001b[?2004h> "]
[11724.454105, "o", "                var msg string\r\n\u001b[?2004l\r"]
[11724.454164, "o", "\u001b[?2004h> "]
[11724.454533, "o", "                if err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n\u001b[?2004l\r"]
[11724.45459, "o", "\u001b[?2004h> "]
[11724.454874, "o", "                        return \"\", fmt.Errorf(\"%s\", msg)\r\n\u001b[?2004l\r"]
[11724.454928, "o", "\u001b[?2004h> "]
[11724.455009, "o", "                }\r\n\u001b[?2004l\r"]
[11724.455063, "o", "\u001b[?2004h> "]
[11724.455371, "o", "                return \"\", fmt.Errorf(\"%s\", string(resp.Data))\r\n\u001b[?2004l\r"]
[11724.455437, "o", "\u001b[?2004h> "]
[11724.455491, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11724.45555, "o", "> "]
[11724.45574, "o", "        return prettyData(ipcCmd, resp.Data)\r\n\u001b[?2004l\r"]
[11724.4558, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11724.455858, "o", "\u001b[?2004h> ''',\r\n\u001b[?2004l\r"]
