[9487.294383, "o", "\t\tif err := s.state.DrainEndpoint(args.Name, args.Address); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn \"OK\", nil\r\n\tcase \"get_health_log\":\r\n\t\tvar args struct {\r\n\t\t\tName  string `json:\"name\"`\r\n\t\t\tLastN int    `json:\"last_n\"`\r\n"]
[9487.294529, "o", "\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn s.state.HealthLogView(args.Name, args.LastN), nil\r\n\tcase \"get_circuit_breakers\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tcv, ok := s.state.CircuitsView(args.Name)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn cv, nil\r\n\tcase \"reset_circuit_breaker\":\r\n\t\tvar args struct {\r\n\t\t\tName    string `json:\"name\"`\r\n"]
[9487.294637, "o", "\t\t\tAddress string `json:\"address\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tif err := s.state.ResetCircuitBreaker(args.Name, args.Address); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn \"OK\", nil\r\n\tcase \"resolve\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t"]
[9487.294745, "o", "\t\treturn nil, err\r\n\t\t}\r\n\t\taddr, err := s.state.ResolveEndpoint(args.Name)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn addr, nil\r\n\tcase \"reload_config\":\r\n\t\tpath := s.state.ConfigPath()\r\n\t\tcfg, err := config.Load(path)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\ts.state.ApplyConfig(cfg)\r\n\t\treturn \"OK\", nil\r\n\tcase \"get_rate_limit_status\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n"]
[9487.294841, "o", "\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\ttokens, queueDepth, rateLimited, queued, timeouts, rps, burst, ok := s.state.RateLimitStatus(args.Name)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn map[string]interface{}{\r\n\t\t\t\"tokens_available\": tokens,\r\n\t\t\t\"queue_depth\":      queueDepth,\r\n\t\t\t\"rate_limited\":     int(rateLimited),\r\n"]
[9487.294936, "o", "\t\t\t\"queued\":           int(queued),\r\n\t\t\t\"queue_timeouts\":   int(timeouts),\r\n\t\t\t\"rps\":              rps,\r\n\t\t\t\"burst\":            burst,\r\n\t\t}, nil\r\n\tcase \"get_connections\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tconns, ok := s.state.ConnectionsView(args.Name)\r\n\t\tif !ok {\r\n"]
[9487.295028, "o", "\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn map[string]interface{}{\"connections\": conns}, nil\r\n\tcase \"set_rate_limit\":\r\n\t\tvar args struct {\r\n\t\t\tName  string `json:\"name\"`\r\n\t\t\tRps   int    `json:\"rps\"`\r\n\t\t\tBurst int    `json:\"burst\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tif err := s.state.SetRateLimit(args.Name, args.Rps, args.Burst); err != nil {\r\n\t\t\treturn nil, err\r\n"]
[9487.29511, "o", "\t\t}\r\n\t\treturn \"OK\", nil\r\n\tcase \"get_access_log\":\r\n\t\tvar args struct {\r\n\t\t\tService       string `json:\"service\"`\r\n\t\t\tLastN         *int   `json:\"last_n\"`\r\n\t\t\tResult        string `json:\"result\"`\r\n\t\t\tMinDurationMs int64  `json:\"min_duration_ms\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t"]
[9487.295181, "o", "\tlastN := 20\r\n\t\tif args.LastN != nil {\r\n\t\t\tlastN = *args.LastN\r\n\t\t}\r\n\t\tentries := accesslog.GetAccessLog(accesslog.DefaultPath, args.Service, args.Result, lastN, args.MinDurationMs)\r\n\t\tif entries == nil {\r\n\t\t\tentries = []accesslog.Entry{}\r\n\t\t}\r\n\t\treturn entries, nil\r\n\tcase \"get_access_stats\":\r\n\t"]
[9487.295259, "o", "\tvar args struct {\r\n\t\t\tService string `json:\"service\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n"]
[9487.295333, "o", "\t\treturn accesslog.Stats(accesslog.DefaultPath, args.Service), nil\r\n\tdefault:\r\n\t\treturn nil, fmt.Errorf(\"unknown command: %s\", req.Cmd)\r\n\t}\r\n}\r\n\r\nfunc init() {\r\n\t_ = strconv.Itoa(0)\r\n}\r\n"]
