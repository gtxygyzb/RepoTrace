[9519.629556, "o", "\u001b[35m\u001b[Kinternal/state/ratelimit.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif rl.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[KMax <= 0 {\r\n\u001b[35m\u001b[Kinternal/state/ratelimit.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif rl.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[KDepth >= rl.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[KMax {\r\n\u001b[35m\u001b[Kinternal/state/ratelimit.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\trl.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[KDepth++\r\n\u001b[35m\u001b[Kinternal/state/ratelimit.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\trl.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[Kd++\r\n"]
[9519.629605, "o", "\u001b[35m\u001b[Kinternal/state/ratelimit.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\trl.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[KDepth--\r\n\u001b[35m\u001b[Kinternal/state/ratelimit.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\trl.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[KDepth--\r\n\u001b[35m\u001b[Kinternal/state/ratelimit.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (rl *rateLimiter) status() (tokens float64, \u001b[01;31m\u001b[Kqueue\u001b[m\u001b[KDepth int, rateLimited uint64, \u001b[01;31m\u001b[Kqueue\u001b[m\u001b[Kd uint64, timeouts uint64, rps float64, burst float64) {\r\n\u001b[35m\u001b[Kinternal/state/ratelimit.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn rl.tokens, rl.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[KDepth, rl.rateLimited, rl.\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[Kd, rl.timeouts, rl.rps, rl.burst\r\n"]
[9519.629855, "o", "\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[Kd         int\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[KTimeouts  int\r\n"]
[9519.62991, "o", "\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kretry\u001b[m\u001b[KSuccesses int\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// RecordConnection records a finished connection \u001b[01;31m\u001b[Kattempt\u001b[m\u001b[K.\r\n"]
