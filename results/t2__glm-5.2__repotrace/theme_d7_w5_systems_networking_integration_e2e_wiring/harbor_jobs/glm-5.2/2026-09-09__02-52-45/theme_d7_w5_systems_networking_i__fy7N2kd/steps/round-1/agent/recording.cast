[11011.732349, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11011.732684, "o", "                if err := json.Unmarshal(data, &resp); err != nil {\r\n\u001b[?2004l\r"]
[11011.732752, "o", "\u001b[?2004h> "]
[11011.732858, "o", "                        return \"\", err\r\n\u001b[?2004l\r"]
[11011.732913, "o", "\u001b[?2004h> "]
[11011.732978, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11011.733007, "o", "> "]
[11011.733173, "o", "                if len(resp.Dependencies) == 0 {\r\n\u001b[?2004l\r"]
[11011.733198, "o", "\u001b[?2004h> "]
[11011.733419, "o", "                        return \"no dependencies\", nil\r\n\u001b[?2004l\r"]
[11011.733488, "o", "\u001b[?2004h> "]
[11011.733568, "o", "                }\r\n\u001b[?2004l\r"]
[11011.733617, "o", "\u001b[?2004h> "]
[11011.733813, "o", "                var b strings.Builder\r\n\u001b[?2004l\r"]
[11011.733868, "o", "\u001b[?2004h> "]
[11011.734266, "o", "                fmt.Fprintf(&b, \"%-14s %-14s %-10s %-18s\\\\n\", \"SERVICE\", \"DEPENDS_ON\", \"AVAILABLE\", \"HEALTHY_ENDPOINTS\")\r\n\u001b[?2004l\r"]
[11011.734322, "o", "\u001b[?2004h> "]
[11011.734513, "o", "                for _, dep := range resp.Dependencies {\r\n\u001b[?2004l\r"]
[11011.73457, "o", "\u001b[?2004h> "]
[11011.735005, "o", "                        fmt.Fprintf(&b, \"%-14s %-14s %-10t %-18d\\\\n\", resp.Service, dep.Name, dep.Available, dep.HealthyEndpoints)\r\n\u001b[?2004l\r"]
[11011.735061, "o", "\u001b[?2004h> "]
[11011.735119, "o", "                }\r\n\u001b[?2004l\r"]
[11011.735173, "o", "\u001b[?2004h> "]
[11011.735378, "o", "                return strings.TrimRight(b.String(), \"\\\\n\"), nil\r\n\u001b[?2004l\r"]
