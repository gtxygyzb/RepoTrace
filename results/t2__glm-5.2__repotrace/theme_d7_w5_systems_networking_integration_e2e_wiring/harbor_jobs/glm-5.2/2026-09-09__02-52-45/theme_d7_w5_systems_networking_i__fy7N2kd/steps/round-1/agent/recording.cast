[10869.656183, "o", "./config/services.toml\r\n"]
[10869.658893, "o", "[global]\r\nhealth_interval_ms = 2000\r\nunhealthy_threshold = 3\r\nhealthy_threshold = 2\r\nstats_window_sec = 60\r\ncircuit_breaker_threshold = 3\r\ncircuit_breaker_timeout_ms = 5000\r\n"]
[10869.659024, "o", "\r\n[[service]]\r\nname = \"api-gateway\"\r\nlisten_port = 9001\r\nrouting_mode = \"weighted-round-robin\"\r\ndrain_timeout_ms = 5000\r\nmax_connections_per_endpoint = 50\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8081\"\r\n  weight = 5\r\n  health_check = \"tcp\"\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8082\"\r\n  weight = 3\r\n  health_check = \"http\"\r\n  health_path = \"/healthz\"\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8083\"\r\n  weight = 2\r\n  health_check = \"tcp\"\r\n\r\n[[service]]\r\nname = \"data-store\"\r\nlisten_port = 9002\r\n"]
[10869.659114, "o", "routing_mode = \"least-connections\"\r\ndrain_timeout_ms = 10000\r\nmax_connections_per_endpoint = 3\r\nrate_limit_rps = 1\r\nrate_limit_burst = 1\r\nrate_limit_queue_depth = 1\r\nrate_limit_queue_timeout_ms = 300\r\nconnection_limit_mode = \"per-service\"\r\nmax_retries = 1\r\nretry_delay_ms = 100\r\nretry_backoff_multiplier = 2.0\r\nretry_max_delay_ms = 1000\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8091\"\r\n  weight = 1\r\nwarmup_duration_ms = 5000\r\n  health_check = \"tcp\"\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8092\"\r\n  weight = 1\r\nwarmup_duration_ms = 5000\r\n  health_check = \"exec\"\r\n"]
[10869.659184, "o", "  health_cmd = \"nc -z 127.0.0.1 8092\"\r\n\r\n[[service]]\r\nname = \"cache-layer\"\r\nlisten_port = 9003\r\nrouting_mode = \"weighted-round-robin\"\r\ndrain_timeout_ms = 3000\r\nmax_connections_per_endpoint = 100\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8071\"\r\n  weight = 4\r\n  health_check = \"tcp\"\r\n\r\n"]
[10869.659251, "o", "  [[service.endpoint]]\r\n  address = \"127.0.0.1:8072\"\r\n  weight = 4\r\n  health_check = \"tcp\"\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8073\"\r\n  weight = 2\r\n  health_check = \"http\"\r\n  health_path = \"/health\"\r\n"]
[10869.66082, "o", "\u001b[?2004hroot@n30009:/app# "]
