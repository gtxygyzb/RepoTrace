[10595.827042, "o", "     1\tpackage config\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"github.com/BurntSushi/toml\"\r\n"]
[10595.827131, "o", "     5\t)\r\n     6\t\r\n     7\t// Global holds mesh-wide tuning parameters.\r\n     8\ttype Global struct {\r\n     9\t\tHealthIntervalMs        int `toml:\"health_interval_ms\"`\r\n    10\t\tUnhealthyThreshold      int `toml:\"unhealthy_threshold\"`\r\n    11\t\tHealthyThreshold        int `toml:\"healthy_threshold\"`\r\n    12\t\tStatsWindowSec          int `toml:\"stats_window_sec\"`\r\n"]
[10595.827207, "o", "    13\t\tCircuitBreakerThreshold int `toml:\"circuit_breaker_threshold\"`\r\n    14\t\tCircuitBreakerTimeoutMs int `toml:\"circuit_breaker_timeout_ms\"`\r\n    15\t}\r\n    16\t\r\n    17\t// Endpoint describes one backend endpoint from config.\r\n    18\ttype Endpoint struct {\r\n    19\t\tAddress          string `toml:\"address\"`\r\n    20\t\tWeight           int    `toml:\"weight\"`\r\n"]
[10595.827278, "o", "    21\t\tWarmupDurationMs int    `toml:\"warmup_duration_ms\"`\r\n    22\t\tHealthCheck      string `toml:\"health_check\"`\r\n    23\t\tHealthPath       string `toml:\"health_path\"`\r\n    24\t\tHealthCmd        string `toml:\"health_cmd\"`\r\n    25\t}\r\n    26\t\r\n    27\t// Service describes one routed service from config.\r\n    28\ttype Service struct {\r\n    29\t\tName                      string     `toml:\"name\"`\r\n"]
[10595.827353, "o", "    30\t\tListenPort                int        `toml:\"listen_port\"`\r\n    31\t\tRoutingMode               string     `toml:\"routing_mode\"`\r\n    32\t\tDrainTimeoutMs            int        `toml:\"drain_timeout_ms\"`\r\n    33\t\tMaxConnectionsPerEndpoint int        `toml:\"max_connections_per_endpoint\"`\r\n    34\t\tConnectionLimitMode       string     `toml:\"connection_limit_mode\"`\r\n    35\t\tRateLimitRps              int        `toml:\"rate_limit_rps\"`\r\n    36\t\tRateLimitBurst            int        `toml:\"rate_limit_burst\"`\r\n"]
[10595.827439, "o", "    37\t\tRateLimitQueueDepth       int        `toml:\"rate_limit_queue_depth\"`\r\n    38\t\tRateLimitQueueTimeoutMs   int        `toml:\"rate_limit_queue_timeout_ms\"`\r\n    39\t\tMaxRetries                int        `toml:\"max_retries\"`\r\n    40\t\tRetryDelayMs              int        `toml:\"retry_delay_ms\"`\r\n    41\t\tRetryBackoffMultiplier    float64    `toml:\"retry_backoff_multiplier\"`\r\n    42\t\tRetryMaxDelayMs           int        `toml:\"retry_max_delay_ms\"`\r\n"]
[10595.82751, "o", "    43\t\tIdleTimeoutMs             int        `toml:\"idle_timeout_ms\"`\r\n    44\t\tEndpoints                 []Endpoint `toml:\"endpoint\"`\r\n    45\t}\r\n    46\t\r\n    47\t// Config is the parsed application configuration.\r\n    48\ttype Config struct {\r\n    49\t\tGlobal   Global\r\n    50\t\tServices []Service `toml:\"service\"`\r\n    51\t}\r\n"]
[10595.827589, "o", "    52\t\r\n    53\t// Load reads and normalizes a TOML config file.\r\n    54\tfunc Load(path string) (*Config, error) {\r\n    55\t\tvar cfg Config\r\n    56\t\tif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\n    57\t\t\treturn nil, err\r\n"]
[10595.827657, "o", "    58\t\t}\r\n    59\t\tif cfg.Global.HealthIntervalMs <= 0 {\r\n    60\t\t\tcfg.Global.HealthIntervalMs = 2000\r\n    61\t\t}\r\n    62\t\tif cfg.Global.UnhealthyThreshold <= 0 {\r\n    63\t\t\tcfg.Global.UnhealthyThreshold = 3\r\n    64\t\t}\r\n    65\t\tif cfg.Global.HealthyThreshold <= 0 {\r\n    66\t\t\tcfg.Global.HealthyThreshold = 2\r\n    67\t\t}\r\n    68\t\tif cfg.Global.StatsWindowSec <= 0 {\r\n"]
[10595.827734, "o", "    69\t\t\tcfg.Global.StatsWindowSec = 60\r\n    70\t\t}\r\n    71\t\tif cfg.Global.CircuitBreakerThreshold <= 0 {\r\n    72\t\t\tcfg.Global.CircuitBreakerThreshold = 3\r\n    73\t\t}\r\n    74\t\tif cfg.Global.CircuitBreakerTimeoutMs <= 0 {\r\n    75\t\t\tcfg.Global.CircuitBreakerTimeoutMs = 5000\r\n    76\t\t}\r\n    77\t\tfor i := range cfg.Services {\r\n"]
[10595.827802, "o", "    78\t\t\ts := &cfg.Services[i]\r\n    79\t\t\tif s.RoutingMode == \"\" {\r\n    80\t\t\t\ts.RoutingMode = \"weighted-round-robin\"\r\n    81\t\t\t}\r\n    82\t\t\tif s.DrainTimeoutMs <= 0 {\r\n    83\t\t\t\ts.DrainTimeoutMs = 5000\r\n    84\t\t\t}\r\n    85\t\t\tif s.MaxConnectionsPerEndpoint <= 0 {\r\n"]
[10595.827868, "o", "    86\t\t\t\ts.MaxConnectionsPerEndpoint = 100\r\n    87\t\t\t}\r\n    88\t\t\tif s.ConnectionLimitMode == \"\" {\r\n    89\t\t\t\ts.ConnectionLimitMode = \"per-endpoint\"\r\n    90\t\t\t}\r\n    91\t"]
[10595.827956, "o", "\t\tif s.RateLimitBurst <= 0 {\r\n    92\t\t\t\ts.RateLimitBurst = s.RateLimitRps\r\n    93\t\t\t}\r\n    94\t\t\tif s.RateLimitQueueTimeoutMs <= 0 {\r\n    95\t\t\t\ts.RateLimitQueueTimeoutMs = 1000\r\n    96\t\t\t}\r\n    97\t\t\tif s.RetryDelayMs <= 0 {\r\n    98\t\t\t\ts.RetryDelayMs = 100\r\n    99\t\t\t}\r\n"]
[10595.828021, "o", "   100\t\t\tif s.RetryBackoffMultiplier <= 0 {\r\n   101\t\t\t\ts.RetryBackoffMultiplier = 2.0\r\n   102\t\t\t}\r\n   103\t\t\tif s.RetryMaxDelayMs <= 0 {\r\n   104\t\t\t\ts.RetryMaxDelayMs = 5000\r\n"]
[10595.828093, "o", "   105\t\t\t}\r\n   106\t\t\tfor j := range s.Endpoints {\r\n   107\t\t\t\tep := &s.Endpoints[j]\r\n   108\t\t\t\tif ep.HealthCheck == \"\" {\r\n   109\t\t\t\t\tep.HealthCheck = \"tcp\"\r\n   110\t\t\t\t}\r\n   111\t\t\t\tif ep.Weight < 0 {\r\n"]
[10595.828159, "o", "   112\t\t\t\t\tep.Weight = 0\r\n   113\t\t\t\t}\r\n   114\t\t\t\tif ep.WarmupDurationMs < 0 {\r\n   115\t\t\t\t\tep.WarmupDurationMs = 0\r\n   116\t\t\t\t}\r\n   117\t\t\t}\r\n   118\t\t}\r\n   119"]
[10595.828222, "o", "\t\treturn &cfg, nil\r\n   120\t}\r\n"]
