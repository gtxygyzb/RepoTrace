[10746.090033, "i", "sed -n '1,120p' internal/state/state.go\n"]
[10746.090438, "o", "sed -n '1,120p' internal/state/state.go\r\n\u001b[?2004l\r"]
[10746.093654, "o", "package state\r\n\r\nimport (\r\n\t\"net\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n\t\"sync/atomic\"\r\n"]
[10746.093753, "o", "\t\"time\"\r\n\r\n\t\"meshrouter/internal/circuit\"\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/stats\"\r\n)\r\n\r\ntype HealthState string\r\n\r\nconst (\r\n\tUnknown   HealthState = \"unknown\"\r\n\tHealthy   HealthState = \"healthy\"\r\n\tUnhealthy HealthState = \"unhealthy\"\r\n\tDraining  HealthState = \"draining\"\r\n)\r\n\r\ntype HealthEvent struct {\r\n\tTimestamp   time.Time\r\n\tEndpoint    string\r\n\tOldState    HealthState\r\n"]
[10746.093842, "o", "\tNewState    HealthState\r\n\tCheckResult string\r\n}\r\n\r\ntype EndpointState struct {\r\n\tmu                sync.Mutex\r\n\tAddress           string\r\n\tWeight            int\r\n\tConfig            config.Endpoint\r\n\tState             HealthState\r\n\tActiveConnections int\r\n\tCircuit           *circuit.Breaker\r\n\tStats             *stats.Collector\r\n\tconsecSuccess     int\r\n\tconsecFailures    int\r\n"]
[10746.093904, "o", "\tdrainDeadline     time.Time\r\n\tremoved           bool\r\n\tconnIDCounter     int64\r\n\tcurrentWeight     int\r\n\tWarmupDurationMs  int\r\n\twarmupUntil       time.Time\r\n\tconnections       map[int64]*connectionInfo\r\n}\r\n\r\ntype connectionInfo struct {\r\n"]
[10746.093963, "o", "\tconn         net.Conn\r\n\tclientAddr   string\r\n\tstart        time.Time\r\n\tlastActivity time.Time\r\n\tbytesIn      int64\r\n\tbytesOut     int64\r\n}\r\n\r\ntype ServiceState struct {\r\n\tmu                        sync.Mutex\r\n\tName                      string\r\n\t"]
[10746.094023, "o", "ListenPort                int\r\n\tRoutingMode               string\r\n\tDrainTimeoutMs            int\r\n\tMaxConnectionsPerEndpoint int\r\n\tConnectionLimitMode       string\r\n\tIdleTimeoutMs             int\r\n\tRateLimitRps              int\r\n\tRateLimitBurst            int\r\n\tRateLimitQueueDepth       int\r\n\tRateLimitQueueTimeoutMs   int\r\n\tMaxRetries                int\r\n"]
[10746.094085, "o", "\tRetryDelayMs              int\r\n\tRetryBackoffMultiplier    float64\r\n\tRetryMaxDelayMs           int\r\n\trateLimiter               *rateLimiter\r\n\tEndpoints                 []*EndpointState\r\n\trrIndex                   int\r\n\tListener                  net.Listener\r\n\tlistenerStop              chan struct{}\r\n\tstopping                  bool\r\n}\r\n"]
[10746.094144, "o", "\r\ntype State struct {\r\n\tmu         sync.RWMutex\r\n\tconfigPath string\r\n\tglobal     config.Global\r\n\tservices   map[string]*ServiceState\r\n\tlogMu      sync.Mutex\r\n\thealthLog  map[string][]HealthEvent\r\n\treloadCh   chan struct{}\r\n"]
[10746.094202, "o", "}\r\n\r\nfunc NewState(cfg *config.Config, path string) *State {\r\n\ts := &State{\r\n\t\tconfigPath: path,\r\n\t\tservices:   make(map[string]*ServiceState),\r\n\t\thealthLog:  make(map[string][]HealthEvent),\r\n\t\treloadCh:   make(chan struct{}, 1),\r\n\t}\r\n\t"]
[10746.094265, "o", "s.applyConfigLocked(cfg)\r\n\treturn s\r\n}\r\n\r\nfunc (s *State) ReloadChan() <-chan struct{} {\r\n\treturn s.reloadCh\r\n}\r\n\r\nfunc (s *State) ConfigPath() string {\r\n\ts.mu.RLock()\r\n"]
[10746.094321, "o", "\tdefer s.mu.RUnlock()\r\n\treturn s.configPath\r\n}\r\n\r\nfunc (s *State) Global() config.Global {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.global\r\n"]
[10746.094983, "o", "\u001b[?2004h"]
[10746.095048, "o", "root@n30009:/app# "]
[10746.38353, "i", "sed -n '1,130p' internal/stats/stats.go\n"]
[10746.383911, "o", "sed -n '1,130p' internal/stats/stats.go\r\n"]
[10746.384005, "o", "\u001b[?2004l\r"]
[10746.387151, "o", "package stats\r\n\r\nimport (\r\n\t\"sync\"\r\n\t\"time\"\r\n"]
[10746.387238, "o", ")\r\n\r\ntype entry struct {\r\n\ttimestamp time.Time\r\n\tbytesIn   int64\r\n\tbytesOut  int64\r\n\tlatency   time.Duration\r\n\terr       bool\r\n}\r\n\r\n// Collector keeps rolling connection statistics for one endpoint.\r\ntype Collector struct {\r\n"]
[10746.387272, "o", "\tmu         sync.Mutex\r\n\twindow     time.Duration\r\n\tentries    []entry\r\n\trejections []time.Time\r\n"]
[10746.387304, "o", "\r\n\trateLimited    int\r\n\tqueued         int\r\n\tqueueTimeouts  int\r\n\tretries        int\r\n"]
[10746.387412, "o", "\tretrySuccesses int\r\n\tidleTimeouts   int\r\n}\r\n\r\n// New creates a collector with the given window length.\r\nfunc New(window time.Duration) *Collector {\r\n\tif window <= 0 {\r\n\t\twindow = time.Minute\r\n\t}\r\n\treturn &Collector{window: window}\r\n}\r\n\r\n// RecordConnection records a finished connection attempt.\r\n"]
[10746.387474, "o", "func (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\r\n\tc.trim(now)\r\n}\r\n\r\n"]
[10746.387533, "o", "// RecordRejection records a rejected connection because the endpoint was at capacity.\r\nfunc (c *Collector) RecordRejection() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()"]
[10746.38759, "o", "\r\n\tnow := time.Now()\r\n\tc.rejections = append(c.rejections, now)\r\n\tc.trim(now)\r\n}\r\n\r\n// RecordRateLimited records a rate limit rejection.\r\n"]
[10746.387651, "o", "func (c *Collector) RecordRateLimited() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.rateLimited++\r\n}\r\n\r\n// RecordQueued records a connection that was queued waiting for a token.\r\nfunc (c *Collector) RecordQueued() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.queued++\r\n}\r\n\r\n"]
[10746.38771, "o", "// RecordQueueTimeout records a queue timeout rejection.\r\nfunc (c *Collector) RecordQueueTimeout() {\r\n\tc.mu.Lock()\r\n"]
[10746.38777, "o", "\tdefer c.mu.Unlock()\r\n\tc.queueTimeouts++\r\n\tc.rateLimited++\r\n}\r\n\r\n// RecordRetry records a retry attempt.\r\nfunc (c *Collector) RecordRetry() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.retries++\r\n}\r\n\r\n// RecordRetrySuccess records a successful retry attempt.\r\nfunc (c *Collector) RecordRetrySuccess() {\r\n\tc.mu.Lock()\r\n"]
[10746.387826, "o", "\tdefer c.mu.Unlock()\r\n\tc.retrySuccesses++\r\n}\r\n"]
[10746.38788, "o", "\r\n// RecordIdleTimeout records a connection that was closed because it was idle.\r\nfunc (c *Collector) RecordIdleTimeout() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.idleTimeouts++\r\n}\r\n\r\n"]
[10746.38795, "o", "func (c *Collector) trim(now time.Time) {\r\n\tcutoff := now.Add(-c.window)\r\n\ti := 0\r\n\tfor i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {\r\n\t\ti++\r\n\t}\r\n\tif i > 0 {\r\n\t\tc.entries = c.entries[i:]\r\n"]
[10746.387977, "o", "\t}\r\n\tj := 0\r\n\tfor j < len(c.rejections) && c.rejections[j].Before(cutoff) {\r\n\t\tj++\r\n\t}\r\n\tif j > 0 {\r\n\t\tc.rejections = c.rejections[j:]\r\n\t}\r\n}\r\n\r\n"]
[10746.388183, "o", "// Snapshot returns current windowed stats. active is supplied by the state manager.\r\nfunc (c *Collector) Snapshot(active int) Snapshot {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tnow := time.Now()\r\n\tcutoff := now.Add(-c.window)\r\n\tvar total int\r\n\tvar bytesIn, bytesOut int64\r\n\tvar latencySum time.Duration\r\n\tvar errors int\r\n\tfor _, e := range c.entries {\r\n\t\tif e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {\r\n\t\t\ttotal++\r\n"]
[10746.388622, "o", "\u001b[?2004h"]
[10746.388697, "o", "root@n30009:/app# "]
