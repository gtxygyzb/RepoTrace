[5805.505982, "o", "    10\t\t\"meshrouter/internal/circuit\"\r\n    11\t\t\"meshrouter/internal/config\"\r\n    12\t\t\"meshrouter/internal/stats\"\r\n    13\t)\r\n    14\t\r\n    15\ttype HealthState string\r\n    16\t\r\n    17\tconst (\r\n    18\t\tUnknown   HealthState = \"unknown\"\r\n    19\t\tHealthy   HealthState = \"healthy\"\r\n    20\t\tUnhealthy HealthState = \"unhealthy\"\r\n    21\t\tDraining  HealthState = \"draining\"\r\n    22\t)\r\n    23\t\r\n    24\ttype HealthEvent struct {\r\n    25\t\tTimestamp   time.Time\r\n    26\t\tEndpoint    string\r\n    27\t\tOldState    HealthState\r\n    28\t\tNewState    HealthState\r\n    29\t\tCheckResult string\r\n    30\t}\r\n    31\t\r\n    32\ttype EndpointState struct {\r\n    33\t\tmu                sync.Mutex\r\n    34\t\tAddress           string\r\n    35\t\tWeight            int\r\n    36\t\tConfig            config.Endpoint\r\n    37\t\tState             HealthState\r\n    38"]
