[2178.569319, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/config/config.go')\nlines = p.read_text().splitlines()\nout = []\nfor i, line in enumerate(lines, 1):\n    out.append(line)\n    if i == 76:\n        out.append('\\t\\t\\tif s.RateLimitBurst <= 0 {')\n        out.append('\\t\\t\\t\\ts.RateLimitBurst = s.RateLimitRps')\n        out.append('\\t\\t\\t}')\n        out.append('\\t\\t\\tif s.RateLimitQueueTimeoutMs <= 0 {')\n        out.append('\\t\\t\\t\\ts.RateLimitQueueTimeoutMs = 1000')\n        out.append('\\t\\t\\t}')\n        out.append('\\t\\t\\tif s.RetryDelayMs <= 0 {')\n        out.append('\\t\\t\\t\\ts.RetryDelayMs = 100')\n        out.append('\\t\\t\\t}')\n        out.append('\\t\\t\\tif s.RetryBackoffMultiplier <= 0 {')\n        out.append('\\t\\t\\t\\ts.RetryBackoffMultiplier = 2.0')\n        out.append('\\t\\t\\t}')\n        out.append('\\t\\t\\tif s.RetryMaxDelayMs <= 0 {')\n        out.append('\\t\\t\\t\\ts.RetryMaxDelayMs = 5000')\n        out.append('\\t\\t\\t}')\np.write_text('\\n'.join(out) + '\\n')\nPY\ngofmt -w internal/config/config.go\nnl -ba internal/co"]
