[11920.625902, "o", "        fmt.Fprintf(&b, \"%-14s %-14s %-10s %-18s\\\\n\", \"SERVICE\", \"DEPENDS_ON\", \"AVAILABLE\", \"HEALTHY_ENDPOINTS\")\r\n\u001b[?2004l\r"]
[11920.62596, "o", "\u001b[?2004h> "]
[11920.626085, "o", "        for _, row := range rows {\r\n\u001b[?2004l\r"]
[11920.62614, "o", "\u001b[?2004h> "]
[11920.626633, "o", "                fmt.Fprintf(&b, \"%-14s %-14s %-10t %-18d\\\\n\", row.Service, row.Name, row.Available, row.HealthyEndpoints)\r\n\u001b[?2004l\r"]
[11920.626693, "o", "\u001b[?2004h> "]
[11920.626747, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11920.626798, "o", "> "]
[11920.626999, "o", "        return strings.TrimRight(b.String(), \"\\\\n\"), nil\r\n\u001b[?2004l\r"]
[11920.627057, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11920.627108, "o", "\u001b[?2004h"]
[11920.627162, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11920.627498, "o", "func sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {\r\n\u001b[?2004l\r"]
[11920.627557, "o", "\u001b[?2004h> "]
[11920.627712, "o", "        rawArgs, err := json.Marshal(args)\r\n\u001b[?2004l\r"]
[11920.627767, "o", "\u001b[?2004h> "]
[11920.627856, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11920.6279, "o", "\u001b[?2004h> "]
[11920.628031, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[11920.628087, "o", "\u001b[?2004h> "]
[11920.628141, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11920.62819, "o", "> "]
[11920.628373, "o", "        req := request{Cmd: ipcCmd, Args: rawArgs}\r\n\u001b[?2004l\r"]
[11920.628434, "o", "\u001b[?2004h"]
[11920.628488, "o", "> "]
[11920.628595, "o", "        reqBytes, err := json.Marshal(req)\r\n\u001b[?2004l\r"]
[11920.628648, "o", "\u001b[?2004h> "]
[11920.628738, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11920.628792, "o", "\u001b[?2004h> "]
[11920.628909, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[11920.628964, "o", "\u001b[?2004h> "]
[11920.629016, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11920.62907, "o", "> \r\n\u001b[?2004l\r"]
[11920.629122, "o", "\u001b[?2004h> "]
[11920.629322, "o", "        conn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\u001b[?2004l\r"]
[11920.62938, "o", "\u001b[?2004h> "]
[11920.629463, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11920.629519, "o", "\u001b[?2004h> "]
[11920.62982, "o", "                return nil, fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n\u001b[?2004l\r"]
[11920.629878, "o", "\u001b[?2004h> "]
[11920.629928, "o", "        }\r\n\u001b[?2004l\r"]
[11920.629979, "o", "\u001b[?2004h> "]
[11920.630094, "o", "        defer conn.Close()\r\n\u001b[?2004l\r\u001b[?2004h"]
[11920.630183, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11920.630368, "o", "        fmt.Fprintf(conn, \"%s\\\\n\", string(reqBytes))\r\n\u001b[?2004l\r"]
[11920.630444, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11920.630504, "o", "\u001b[?2004h> "]
[11920.630623, "o", "        reader := bufio.NewReader(conn)\r\n\u001b[?2004l\r"]
[11920.630679, "o", "\u001b[?2004h> "]
[11920.630855, "o", "        line, err := reader.ReadString('\\\\n')\r\n\u001b[?2004l\r"]
[11920.63091, "o", "\u001b[?2004h> "]
[11920.631001, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11920.631056, "o", "\u001b[?2004h> "]
[11920.631174, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[11920.631229, "o", "\u001b[?2004h> "]
[11920.631283, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11920.631343, "o", "> "]
[11920.631512, "o", "        line = strings.TrimRight(line, \"\\\\r\\\\n\")\r\n\u001b[?2004l\r"]
[11920.631567, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11920.631626, "o", "\u001b[?2004h> "]
[11920.631725, "o", "        var resp response\r\n\u001b[?2004l\r"]
[11920.631778, "o", "\u001b[?2004h> "]
[11920.632045, "o", "        if err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n\u001b[?2004l\r"]
[11920.632099, "o", "\u001b[?2004h> "]
[11920.632227, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[11920.632281, "o", "\u001b[?2004h> "]
[11920.632342, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11920.632403, "o", "> "]
[11920.632502, "o", "        if resp.Status != \"ok\" {\r\n\u001b[?2004l\r"]
[11920.632556, "o", "\u001b[?2004h> "]
[11920.632674, "o", "                var msg string\r\n\u001b[?2004l\r"]
[11920.632729, "o", "\u001b[?2004h> "]
[11920.633023, "o", "                if err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n\u001b[?2004l\r"]
[11920.633077, "o", "\u001b[?2004h> "]
[11920.633304, "o", "                        return nil, fmt.Errorf(\"%s\", msg)\r\n\u001b[?2004l\r"]
[11920.633358, "o", "\u001b[?2004h> "]
[11920.633435, "o", "                }\r\n\u001b[?2004l\r"]
[11920.633498, "o", "\u001b[?2004h> "]
[11920.633734, "o", "                return nil, fmt.Errorf(\"%s\", string(resp.Data))\r\n\u001b[?2004l\r"]
[11920.633788, "o", "\u001b[?2004h> "]
[11920.633842, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[11920.633896, "o", "> "]
[11920.633988, "o", "        return resp.Data, nil\r\n\u001b[?2004l\r"]
[11920.634043, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[11920.634098, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[11920.634153, "o", "> '''\r\n\u001b[?2004l\r"]
[11920.634208, "o", "\u001b[?2004h> "]
[11920.634342, "o", "s = s[:start] + new_funcs + s[end:]\r\n\u001b[?2004l\r"]
[11920.634407, "o", "\u001b[?2004h> "]
[11920.634461, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[11920.634515, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
