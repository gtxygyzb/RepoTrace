[5946.993292, "o", "\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(ss *ServiceState) View() \u001b[01;31m\u001b[KServiceView\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tsv := \u001b[01;31m\u001b[KServiceView\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks:     make([]\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[KView, 0, len(ss.\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks)),\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, ep := range ss.\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks {\r\n"]
[5946.993356, "o", "\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tsv.\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks = append(sv.\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks, \u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[KView{\r\n\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KWeight\u001b[m\u001b[K:            ep.\u001b[01;31m\u001b[KWeight\u001b[m\u001b[K,\r\n\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KActiveConnections\u001b[m\u001b[K: ep.\u001b[01;31m\u001b[KActiveConnections\u001b[m\u001b[K,\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype \u001b[m\u001b[KStats\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[KView struct {\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype \u001b[m\u001b[KStatsView struct {\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[Ks []Stats\u001b[01;31m\u001b[KEndpoint\u001b[m\u001b[KView `json:\"endpoints\"`\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(s *State) StatsView(name string, windowSec int) (StatsView, bool) {\r\n"]
