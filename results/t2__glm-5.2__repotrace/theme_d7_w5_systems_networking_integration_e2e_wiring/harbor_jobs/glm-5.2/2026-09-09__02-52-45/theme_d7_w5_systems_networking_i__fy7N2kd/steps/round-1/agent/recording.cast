[11577.557874, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\np = Path('internal/config/config.go')\ns = p.read_text()\n# Replace the tail of Load with dependency normalization + cycle detection\ns = re.sub(\n    r'(\\n\\t\\t\\tif ep\\.WarmupDurationMs < 0 \\{\\n\\t\\t\\t\\tep\\.WarmupDurationMs = 0\\n\\t\\t\\t\\}\\n\\t\\t\\}\\n\\t)\\n\\treturn &cfg, nil\\n\\}\\n(\\n)?$',\n    r'''\\1\\t\\t\\tif s.DependsOn == nil {\n\\t\\t\\t\\ts.DependsOn = []string{}\n\\t\\t\\t}\n\\t\\t}\n\\t\\tcfg.Services = removeDependencyCycles(cfg.Services)\n\\t\\treturn &cfg, nil\n}\n\n// removeDependencyCycles drops dependency edges that would create cycles.\nfunc removeDependencyCycles(services []Service) []Service {\n\\tbyName := make(map[string]int, len(services))\n\\tfor i, svc := range services {\n\\t\\tbyName[svc.Name] = i\n\\t}\n\\tfor i := range services {\n\\t\\tseen := map[string]bool{services[i].Name: true}\n\\t\\tkept := make([]string, 0, len(services[i].DependsOn))\n\\t\\tfor _, dep := range services[i].DependsOn {\n\\t\\t\\tif dep == services[i].Name {\n\\t\\t\\t\\tlog.Printf(\"warning: dropping self dependency from "]
[11577.558165, "i", "%s to %s\", services[i].Name, dep)\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}\n\\t\\t\\tif _, ok := byName[dep]; !ok {\n\\t\\t\\t\\tkept = append(kept, dep)\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}\n\\t\\t\\tif createsCycle(services, byName, seen, services[i].Name, dep) {\n\\t\\t\\t\\tlog.Printf(\"warning: dropping dependency edge from %s to %s to avoid circular dependency\", services[i].Name, dep)\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}\n\\t\\t\\tkept = append(kept, dep)\n\\t\\t}\n\\t\\tservices[i].DependsOn = kept\n\\t}\n\\treturn services\n}\n\nfunc createsCycle(services []Service, byName map[string]int, seen map[string]bool, start, dep string) bool {\n\\tif seen[dep] {\n\\t\\treturn true\n\\t}\n\\tseen[dep] = true\n\\tdefer delete(seen, dep)\n\\tnext := services[byName[dep]].DependsOn\n\\tfor _, d := range next {\n\\t\\tif d == start || d == dep {\n\\t\\t\\treturn true\n\\t\\t}\n\\t\\tif _, ok := byName[d]; !ok {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tif createsCycle(services, byName, seen, start, d) {\n\\t\\t\\treturn true\n\\t\\t}\n\\t}\n\\treturn false\n}\n''',\n    s,\n    flags=re.S\n)\np.write_text(s)\nPY\ngofmt -w internal/config/config.go\nsed"]
