[9533.61437, "o", "\t\"sync\"\r\n\t\"sync/atomic\"\r\n\t\"time\"\r\n)\r\n\r\n// Entry is one structured access log record.\r\ntype Entry struct {\r\n\tTs         string `json:\"ts\"`\r\n\tService    string `json:\"service\"`\r\n\tClient     string `json:\"client\"`\r\n\tEndpoint   string `json:\"endpoint\"`\r\n"]
[9533.614455, "o", "\tBytesIn    int64  `json:\"bytes_in\"`\r\n\tBytesOut   int64  `json:\"bytes_out\"`\r\n\tDurationMs int64  `json:\"duration_ms\"`\r\n\tResult     string `json:\"result\"`\r\n}\r\n\r\n// DefaultPath is the access log path required by meshrouter.\r\nconst DefaultPath = \"/app/logs/access.log\"\r\n"]
[9533.614526, "o", "\r\nconst maxFileSize = 1 << 20 // 1 MB\r\n\r\n// Logger writes access log entries asynchronously to a JSON-lines file.\r\ntype Logger struct {\r\n\tpath     string\r\n\tch       chan Entry\r\n\tstop     chan struct{}\r\n\tdone     chan struct{}\r\n\tstopped  int32\r\n\tstopOnce sync.Once\r\n\tmu       sync.Mutex\r\n"]
[9533.614589, "o", "\tfile     *os.File\r\n\tsize     int64\r\n}\r\n\r\n// New creates a Logger for path and starts its writer goroutine.\r\nfunc New(path string) *Logger {\r\n\tif path == \"\" {\r\n\t\tpath = DefaultPath\r\n\t}\r\n\tl := &Logger{\r\n\t\tpath: path,\r\n\t\tch:   make(chan Entry, 8192),\r\n"]
[9533.614647, "o", "\t\tstop: make(chan struct{}),\r\n\t\tdone: make(chan struct{}),\r\n\t}\r\n\tgo l.run()\r\n\treturn l\r\n}\r\n\r\n// Path returns the configured log file path.\r\nfunc (l *Logger) Path() string {\r\n\treturn l.path\r\n}\r\n\r\n// Log queues an entry for asynchronous writing. If the buffered channel is full,\r\n// the entry is written synchronously to avoid losing it.\r\nfunc (l *Logger) Log(entry Entry) {\r\n\tif atomic.LoadInt32(&l.stopped) != 0 {\r\n\t\treturn\r\n\t}\r\n"]
[9533.614717, "o", "\tentry.Ts = time.Now().UTC().Format(time.RFC3339Nano)\r\n\tselect {\r\n\tcase l.ch <- entry:\r\n\tdefault:\r\n\t\tl.writeLine(entry)\r\n\t}\r\n}\r\n\r\n// Stop flushes all buffered entries and closes the log file.\r\nfunc (l *Logger) Stop() {\r\n\t"]
[9533.614783, "o", "l.stopOnce.Do(func() {\r\n\t\tatomic.StoreInt32(&l.stopped, 1)\r\n\t\tclose(l.stop)\r\n\t\t<-l.done\r\n\t\tl.mu.Lock()\r\n\t\tif l.file != nil {\r\n\t\t\tl.file.Close()\r\n\t\t\tl.file = nil\r\n\t\t}\r\n\t\tl.mu.Unlock()\r\n\t})\r\n"]
[9533.614845, "o", "}\r\n\r\n"]
