[4131.019623, "o", "   116\t\t\t\tNewState:    string(e.NewState),\r\n   117\t\t\t\tCheckResult: e.CheckResult,\r\n   118\t\t\t})\r\n   119\t\t}\r\n   120\t\treturn out\r\n   121\t}\r\n   122\t\r\n   123\ttype CircuitView struct {\r\n   124\t\tAddress             string `json:\"address\"`\r\n"]
[4131.019634, "o", "   125\t\tCircuitState        string `json:\"circuit_state\"`\r\n"]
[4131.019693, "o", "   126\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n   127\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n   128\t\tProbeActive         bool   `json:\"probe_active\"`\r\n   129\t}\r\n   130\t\r\n   131\tfunc (s *State) CircuitsView(name string) ([]CircuitView, bool) {\r\n   132\t\tss := s.GetService(name)\r\n   133\t\tif ss == nil {\r\n"]
