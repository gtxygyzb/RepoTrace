[444.695482, "i", "sed -n '1,80p' internal/config/config.go\nsed -n '1,80p' internal/stats/stats.go\nsed -n '1,80p' internal/circuit/breaker.go\n"]
[444.695845, "o", "sed -n '1,80p' internal/config/config.go\r\n\u001b[?2004l\r"]
[444.698822, "o", "package config\r\n\r\nimport (\r\n\"github.com/BurntSushi/toml\"\r\n)\r\n\r\n// Global holds mesh-wide tuning parameters.\r\n"]
[444.698877, "o", "type Global struct {\r\nHealthIntervalMs        int `toml:\"health_interval_ms\"`\r\nUnhealthyThreshold      int `toml:\"unhealthy_threshold\"`\r\nHealthyThreshold        int `toml:\"healthy_threshold\"`\r\nStatsWindowSec          int `toml:\"stats_window_sec\"`\r\nCircuitBreakerThreshold int `toml:\"circuit_breaker_threshold\"`\r\nCircuitBreakerTimeoutMs int `toml:\"circuit_breaker_timeout_ms\"`\r\n}\r\n\r\n// Endpoint describes one backend endpoint from config.\r\ntype Endpoint struct {\r\nAddress     string `toml:\"address\"`\r\nWeight      int    `toml:\"weight\"`\r\n"]
[444.698992, "o", "HealthCheck string `toml:\"health_check\"`\r\nHealthPath  string `toml:\"health_path\"`\r\nHealthCmd   string `toml:\"health_cmd\"`\r\n}"]
[444.69906, "o", "\r\n\r\n// Service describes one routed service from config.\r\ntype Service struct {\r\nName                    string     `toml:\"name\"`\r\nListenPort             int        `toml:\"listen_port\"`\r\nRoutingMode             string     `toml:\"routing_mode\"`\r\nDrainTimeoutMs          int        `toml:\"drain_timeout_ms\"`\r\nMaxConnectionsPerEndpoint int      `toml:\"max_connections_per_endpoint\"`\r\nEndpoints               []Endpoint `toml:\"endpoint\"`\r\n}\r\n\r\n// Config is the parsed application configuration.\r\ntype Config struct {\r\nGlobal   Global\r\nServices []Service\r\n}\r\n\r\n// Load reads and normalizes a TOML config file.\r\nfunc Load(path string) (*Config, error) {\r\nvar cfg Config\r\nif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\nreturn nil, err\r\n}\r\nif cfg.Global.HealthIntervalMs <= 0 {\r\ncfg.Global.HealthIntervalMs = 2000\r\n}\r\nif cfg.Global.UnhealthyThreshold <= 0 {\r\ncfg.Global.UnhealthyThreshold = 3\r\n}\r\nif cfg.Global.HealthyThreshold <= 0 {\r\ncfg.Global.HealthyThreshold = 2\r\n"]
[444.699124, "o", "}\r\nif cfg.Global.StatsWindowSec <= 0 {\r\ncfg.Global.StatsWindowSec = 60\r\n}\r\n"]
[444.69918, "o", "if cfg.Global.CircuitBreakerThreshold <= 0 {\r\ncfg.Global.CircuitBreakerThreshold = 3\r\n}\r\nif cfg.Global.CircuitBreakerTimeoutMs <= 0 {\r\ncfg.Global.CircuitBreakerTimeoutMs = 5000\r\n}\r\nfor i := range cfg.Services {\r\ns := &cfg.Services[i]\r\nif s.RoutingMode == \"\" {\r\ns.RoutingMode = \"weighted-round-robin\"\r\n}\r\nif s.DrainTimeoutMs <= 0 {\r\ns.DrainTimeoutMs = 5000\r\n}\r\nif s.MaxConnectionsPerEndpoint <= 0 {\r\n"]
[444.6992, "o", "s.MaxConnectionsPerEndpoint = 100\r\n}\r\nfor j := range s.Endpoints {\r\nep := &s.Endpoints[j]\r\nif ep.HealthCheck == \"\" {\r\nep.HealthCheck = \"tcp\"\r\n"]
[444.699697, "o", "\u001b[?2004hroot@n30009:/app# "]
[444.699939, "o", "sed -n '1,80p' internal/stats/stats.go\r\n\u001b[?2004l\r"]
[444.702687, "o", "package stats\r\n\r\nimport (\r\n\"sync\"\r\n\"time\"\r\n)\r\n\r\ntype entry struct {"]
[444.702777, "o", "\r\ntimestamp time.Time\r\nbytesIn   int64\r\nbytesOut  int64\r\nlatency   time.Duration\r\nerr       bool\r\n}\r\n\r\n// Collector keeps rolling connection statistics for one endpoint.\r\ntype Collector struct {\r\nmu         sync.Mutex\r\nwindow     time.Duration\r\nentries    []entry\r\nrejections []time.Time\r\n}\r\n\r\n// New creates a collector with the given window length.\r\nfunc New(window time.Duration) *Collector {\r\nif window <= 0 {\r\nwindow = time.Minute\r\n"]
[444.70285, "o", "}\r\nreturn &Collector{window: window}\r\n}\r\n\r\n// RecordConnection records a finished connection attempt.\r\nfunc (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\r\nc.mu.Lock()\r\ndefer c.mu.Unlock()\r\nnow := time.Now()\r\nc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\r\nc.trim(now)\r\n}\r\n\r\n// RecordRejection records a rejected connection because the endpoint was at capacity.\r\nfunc (c *Collector) RecordRejection() {\r\n"]
[444.702911, "o", "c.mu.Lock()\r\ndefer c.mu.Unlock()\r\nnow := time.Now()\r\n"]
[444.702932, "o", "c.rejections = append(c.rejections, now)\r\nc.trim(now)\r\n}\r\n\r\nfunc (c *Collector) trim(now time.Time) {\r\ncutoff := now.Add(-c.window)\r\ni := 0\r\nfor i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {\r\ni++\r\n}\r\nif i > 0 {\r\nc.entries = c.entries[i:]\r\n}\r\nj := 0\r\nfor j < len(c.rejections) && c.rejections[j].Before(cutoff) {\r\n"]
[444.702952, "o", "j++\r\n}\r\nif j > 0 {\r\nc.rejections = c.rejections[j:]\r\n"]
[444.703053, "o", "}\r\n}\r\n"]
[444.703113, "o", "\r\n// Snapshot returns current windowed stats. active is supplied by the state manager.\r\nfunc (c *Collector) Snapshot(active int) Snapshot {\r\nc.mu.Lock()\r\ndefer c.mu.Unlock()\r\nnow := time.Now()\r\ncutoff := now.Add(-c.window)\r\nvar total int\r\nvar bytesIn, bytesOut int64\r\nvar latencySum time.Duration\r\nvar errors int\r\nfor _, e := range c.entries {\r\nif e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {\r\ntotal++\r\n"]
[444.703526, "o", "\u001b[?2004h"]
[444.703598, "o", "root@n30009:/app# "]
[444.703804, "o", "sed -n '1,80p' internal/circuit/breaker.go\r\n\u001b[?2004l\r"]
[444.706505, "o", "package circuit\r\n\r\nimport (\r\n\"sync\"\r\n\"time\"\r\n)\r\n\r\n"]
[444.706536, "o", "type State string\r\n\r\nconst (\r\nClosed   State = \"closed\"\r\nOpen     State = \"open\"\r\nHalfOpen State = \"half_open\"\r\n)\r\n\r\n"]
[444.70664, "o", "// Breaker implements an endpoint circuit breaker.\r\ntype Breaker struct {\r\n"]
[444.706702, "o", "mu                 sync.Mutex\r\nstate              State\r\nconsecutiveFailures int\r\nstateChangedAt     time.Time\r\nopenedAt           time.Time\r\ntimeout            time.Duration\r\nprobeActive        bool\r\n}\r\n\r\n// New creates a closed breaker with the given open timeout.\r\nfunc New(timeout time.Duration) *Breaker {\r\nnow := time.Now()\r\nreturn &Breaker{\r\nstate:          Closed,\r\nstateChangedAt: now,\r\nopenedAt:       now,\r\ntimeout:        timeout,\r\n}\r\n}\r\n\r\n// State returns the current state.\r\nfunc (b *Breaker) State() State {\r\n"]
[444.70676, "o", "b.mu.Lock()\r\ndefer b.mu.Unlock()\r\nreturn b.state\r\n}\r\n\r\n// IsClosed returns true if the breaker is closed.\r\nfunc (b *Breaker) IsClosed() bool {\r\nreturn b.State() == Closed\r\n}\r\n\r\n// IsOpen returns true if the breaker is open.\r\nfunc (b *Breaker) IsOpen() bool {\r\nreturn b.State() == Open\r\n"]
[444.70679, "o", "}\r\n\r\n// IsHalfOpen returns true if the breaker is half-open.\r\nfunc (b *Breaker) IsHalfOpen() bool {\r\nreturn b.State() == HalfOpen\r\n}\r\n\r\n// Open forces the breaker open and restarts the timeout clock.\r\nfunc (b *Breaker) Open() {\r\nb.mu.Lock()\r\ndefer b.mu.Unlock()\r\nnow := time.Now()\r\nb.state = Open\r\n"]
[444.70689, "o", "b.stateChangedAt = now\r\nb.openedAt = now\r\nb.consecutiveFailures++\r\nb.probeActive = false\r\n}\r\n\r\n// MaybeHalfOpen transitions from open to half_open if the timeout has elapsed.\r\nfunc (b *Breaker) MaybeHalfOpen() bool {\r\nb.mu.Lock()\r\ndefer b.mu.Unlock()\r\nif b.state == Open && time.Since(b.openedAt) >= b.timeout {\r\nb.state = HalfOpen\r\nb.stateChangedAt = time.Now()\r\nb.probeActive = false\r\nreturn true\r\n"]
[444.707327, "o", "\u001b[?2004h"]
[444.707441, "o", "root@n30009:/app# "]
[588.031933, "i", "cat > internal/state/state.go <<'EOF'\npackage state\n\nimport (\n    \"net\"\n    \"sync\"\n    \"sync/atomic\"\n    \"time\"\n\n    \"meshrouter/internal/circuit\"\n    \"meshrouter/internal/config\"\n    \"meshrouter/internal/stats\"\n)\n\ntype HealthState string\n\nconst (\n    Unknown   HealthState = \"unknown\"\n    Healthy   HealthState = \"healthy\"\n    Unhealthy HealthState = \"unhealthy\"\n    Draining  HealthState = \"draining\"\n)\n\ntype HealthEvent struct {\n    Timestamp   time.Time\n    Endpoint    string\n    OldState    HealthState\n    NewState    HealthState\n    CheckResult string\n}\n\ntype EndpointState struct {\n    mu                  sync.Mutex\n    Address             string\n    Weight              int\n    Config              config.Endpoint\n    State               HealthState\n    ActiveConnections  int\n    Circuit            *circuit.Breaker\n    Stats              *stats.Collector\n    consecSuccess      int\n    consecFailures     int\n    drainDeadline      time.Time\n    removed            bool\n    connIDCounter      int64\n    connecti"]
[588.032247, "i", "ons        map[int64]net.Conn\n}\n\ntype ServiceState struct {\n    mu                        sync.Mutex\n    Name                      string\n    ListenPort                int\n    RoutingMode               string\n    DrainTimeoutMs            int\n    MaxConnectionsPerEndpoint int\n    Endpoints                 []*EndpointState\n    rrIndex                    int\n    Listener                  net.Listener\n    listenerStop              chan struct{}\n    stopping                  bool\n}\n\ntype State struct {\n    mu         sync.RWMutex\n    configPath string\n    global     config.Global\n    services   map[string]*ServiceState\n    logMu      sync.Mutex\n    healthLog  map[string][]HealthEvent\n    reloadCh   chan struct{}\n}\n\nfunc NewState(cfg *config.Config, path string) *State {\n    s := &State{\n        configPath: path,\n        services:   make(map[string]*ServiceState),\n        healthLog:  make(map[string][]HealthEvent),\n        reloadCh:   make(chan struct{}, 1),\n    }\n    s.applyConfigLocked(cfg)\n    return s\n}\n\nfunc "]
[588.032346, "o", "cat > internal/state/state.go <<'EOF'\r\n\u001b[?2004l\r"]
[588.032481, "i", "(s *State) ReloadChan() <-chan struct{} {\n    return s.reloadCh\n}\n\nfunc (s *State) ConfigPath() string {\n    s.mu.RLock()\n    defer s.mu.RUnlock()\n    return s.configPath\n}\n\nfunc (s *State) Global() config.Global {\n    s.mu.RLock()\n    defer s.mu.RUnlock()\n    return s.global\n}\n\nfunc (s *State) ApplyConfig(cfg *config.Config) {\n    s.mu.Lock()\n    defer s.mu.Unlock()\n    s.applyConfigLocked(cfg)\n    select {\n    case s.reloadCh <- struct{}{}:\n    default:\n    }\n}\n\nfunc (s *State) applyConfigLocked(cfg *config.Config) {\n    s.global = cfg.Global\n    seen := make(map[string]bool)\n    for _, svc := range cfg.Services {\n        seen[svc.Name] = true\n        ss := s.services[svc.Name]\n        if ss == nil {\n            ss = newServiceState(svc)\n            s.services[svc.Name] = ss\n        } else {\n            ss.mu.Lock()\n            ss.Name = svc.Name\n            ss.ListenPort = svc.ListenPort\n            ss.RoutingMode = svc.RoutingMode\n            ss.DrainTimeoutMs = svc.DrainTimeoutMs\n            ss.MaxConnec"]
[588.032543, "o", "\u001b[?2004h> "]
[588.03261, "i", "tionsPerEndpoint = svc.MaxConnectionsPerEndpoint\n            ss.mu.Unlock()\n            ss.applyEndpoints(svc.Endpoints, cfg.Global)\n        }\n    }\n    for name, ss := range s.services {\n        if !seen[name] {\n            ss.mu.Lock()\n            ss.stopping = true\n            if ss.listenerStop != nil {\n                close(ss.listenerStop)\n                ss.listenerStop = nil\n            }\n            if ss.Listener != nil {\n                ss.Listener.Close()\n                ss.Listener = nil\n            }\n            ss.mu.Unlock()\n            for _, ep := range ss.Endpoints {\n                ep.StartDraining(ss.DrainTimeoutMs, true)\n            }\n        }\n    }\n}\n\nfunc newServiceState(svc config.Service) *ServiceState {\n    ss := &ServiceState{\n        Name:                      svc.Name,\n        ListenPort:                svc.ListenPort,\n        RoutingMode:               svc.RoutingMode,\n        DrainTimeoutMs:            svc.DrainTimeoutMs,\n        MaxConnectionsPerEndpoint: svc.MaxConnectionsPe"]
[588.032665, "o", "package state\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[588.032726, "i", "rEndpoint,\n        listenerStop:              nil,\n    }\n    for _, ep := range svc.Endpoints {\n        ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, stats.New(time.Duration(svc.DrainTimeoutMs)*time.Millisecond)))\n    }\n    return ss\n}\n\nfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\n    ss.mu.Lock()\n    defer ss.mu.Unlock()\n    seen := make(map[string]bool)\n    for _, cep := range eps {\n        seen[cep.Address] = true\n        var ep *EndpointState\n        for _, existing := range ss.Endpoints {\n            if existing.Address == cep.Address {\n                ep = existing\n                break\n            }\n        }\n        if ep == nil {\n            ep = newEndpointState(cep, stats.New(time.Duration(global.StatsWindowSec)*time.Second))\n            ss.Endpoints = append(ss.Endpoints, ep)\n        } else {\n            ep.mu.Lock()\n            ep.Config = cep\n            ep.Weight = cep.Weight\n            ep.mu.Unlock()\n        }\n    }\n    for _, ep := range ss"]
[588.03281, "o", "tionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n            ss.mu.Unlock()\r\n            ss.applyEndpoints(svc.Endp"]
[588.032887, "i", ".Endpoints {\n        if !seen[ep.Address] {\n            ep.StartDraining(ss.DrainTimeoutMs, true)\n        }\n    }\n}\n\nfunc newEndpointState(cep config.Endpoint, st *stats.Collector) *EndpointState {\n    return &EndpointState{\n        Address:      cep.Address,\n        Weight:       cep.Weight,\n        Config:       cep,\n        State:        Unknown,\n        Circuit:      circuit.New(time.Duration(5000) * time.Millisecond),\n        Stats:        st,\n        connections:  make(map[int64]net.Conn),\n    }\n}\n\nfunc (s *State) GetService(name string) *ServiceState {\n    s.mu.RLock()\n    defer s.mu.RUnlock()\n    return s.services[name]\n}\n\nfunc (s *State) Services() []*ServiceState {\n    s.mu.RLock()\n    defer s.mu.RUnlock()\n    out := make([]*ServiceState, 0, len(s.services))\n    for _, ss := range s.services {\n        out = append(out, ss)\n    }\n    return out\n}\n\nfunc (s *State) GetEndpoint(service, address string) *EndpointState {\n    ss := s.GetService(service)\n    if ss == nil {\n        return nil\n    }\n    ss.mu"]
