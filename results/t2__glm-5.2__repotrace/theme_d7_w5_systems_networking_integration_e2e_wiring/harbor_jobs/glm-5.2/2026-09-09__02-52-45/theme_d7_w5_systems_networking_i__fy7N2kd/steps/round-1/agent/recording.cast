[4610.129048, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/state/routing.go')\ns = p.read_text()\nold = '''func selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\n\\tsort.SliceStable(eps, func(i, j int) bool {\n\\t\\tai := eps[i].Active()\n\\t\\taj := eps[j].Active()\n\\t\\tif ai != aj {\n\\t\\t\\treturn ai < aj\n\\t\\t}\n\\t\\treturn eps[i].Address < eps[j].Address\n\\t})\n\\treturn eps[0]\n}'''\nnew = '''func selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\n\\tsort.SliceStable(eps, func(i, j int) bool {\n\\t\\tai := eps[i].Active()\n\\t\\taj := eps[j].Active()\n\\t\\tif ai != aj {\n\\t\\t\\treturn ai < aj\n\\t\\t}\n\\t\\t// Tie-break by weight (higher weight first), then lexicographic address.\n\\t\\twi := eps[i].Weight\n\\t\\twj := eps[j].Weight\n\\t\\tif wi != wj {\n\\t\\t\\treturn wi > wj\n\\t\\t}\n\\t\\treturn eps[i].Address < eps[j].Address\n\\t})\n\\treturn eps[0]\n}'''\nif old not in s:\n    raise SystemExit('old selectLeastConnections not found')\np.write_text(s.replace(old, new))\nPY\n"]
