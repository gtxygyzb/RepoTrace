[5827.172013, "o", "\tif !success {\r\n   478\t\t\tresult = \"failure\"\r\n   479\t\t}\r\n   480\t\tif success {\r\n   481\t\t\tep.consecSuccess++\r\n   482\t\t\tep.consecFailures = 0\r\n"]
[5827.172068, "o", "   483\t\t\tif oldState == Unknown && ep.consecSuccess >= global.HealthyThreshold {\r\n   484\t\t\t\tep.State = Healthy\r\n   485\t\t\t} else if oldState == Unhealthy && ep.consecSuccess >= global.HealthyThreshold {\r\n   486\t\t\t\tep.State = Healthy\r\n   487\t\t\t}\r\n   488\t\t} else {\r\n   489\t\t\tep.consecFailures++\r\n   490\t\t\tep.consecSuccess = 0\r\n   491\t\t\tif (oldState == Healthy || oldState == Unknown) && ep.consecFailures >= global.UnhealthyThreshold {\r\n   492\t\t\t\tep.State = Unhealthy\r\n   493\t\t\t\tep.Circuit.Open()\r\n   494\t\t\t\tep.consecFailures = 0\r\n"]
