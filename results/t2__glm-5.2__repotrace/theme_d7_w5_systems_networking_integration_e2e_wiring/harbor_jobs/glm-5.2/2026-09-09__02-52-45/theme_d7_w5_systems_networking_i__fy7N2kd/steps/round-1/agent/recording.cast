[11220.533284, "o", "package state\r\n\r\nimport (\r\n\t\"net\"\r\n\t\"sort\"\r\n\t\"sync\"\r\n"]
[11220.533444, "o", "\t\"sync/atomic\"\r\n\t\"time\"\r\n\r\n\t\"meshrouter/internal/circuit\"\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/stats\"\r\n)\r\n\r\ntype HealthState string\r\n\r\nconst (\r\n\tUnknown   HealthState = \"unknown\"\r\n\tHealthy   HealthState = \"healthy\"\r\n\tUnhealthy HealthState = \"unhealthy\"\r\n\tDraining  HealthState = \"draining\"\r\n)\r\n\r\ntype HealthEvent struct {\r\n\tTimestamp   time.Time\r\n\tEndpoint    string\r\n\tOldState    HealthState\r\n\tNewState    HealthState\r\n\tCheckResult string\r\n}\r\n\r\ntype EndpointState struct {\r\n\tmu                sync.Mutex\r\n\tAddress           string\r\n\tWeight            int\r\n"]
[11220.533551, "o", "\tConfig            config.Endpoint\r\n\tState             HealthState\r\n\tActiveConnections int\r\n\tCircuit           *circuit.Breaker\r\n\tStats             *stats.Collector\r\n\tconsecSuccess     int\r\n\tconsecFailures    int\r\n\tdrainDeadline     time.Time\r\n\tremoved           bool\r\n\tconnIDCounter     int64\r\n\tcurrentWeight     int\r\n\tWarmupDurationMs  int\r\n\twarmupUntil       time.Time\r\n\tconnections       map[int64]*connectionInfo\r\n}\r\n\r\ntype connectionInfo struct {\r\n\tconn         net.Conn\r\n\tclientAddr   string\r\n\tstart        time.Time\r\n\t"]
[11220.533621, "o", "lastActivity time.Time\r\n\tbytesIn      int64\r\n\tbytesOut     int64\r\n}\r\n\r\ntype ServiceState struct {\r\n\tmu                        sync.Mutex\r\n\tName                      string\r\n\tListenPort                int\r\n\tRoutingMode               string\r\n\tDrainTimeoutMs            int\r\n\tMaxConnectionsPerEndpoint int\r\n\tConnectionLimitMode       string\r\n\tIdleTimeoutMs             int\r\n\t"]
[11220.533687, "o", "RateLimitRps              int\r\n\tRateLimitBurst            int\r\n\tRateLimitQueueDepth       int\r\n\tRateLimitQueueTimeoutMs   int\r\n\tMaxRetries                int\r\n\tRetryDelayMs              int\r\n\tRetryBackoffMultiplier    float64\r\n\tRetryMaxDelayMs           int\r\n\trateLimiter               *rateLimiter\r\n\tEndpoints                 []*EndpointState\r\n\trrIndex                   int\r\n\t"]
[11220.533755, "o", "Listener                  net.Listener\r\n\tlistenerStop              chan struct{}\r\n\tstopping                  bool\r\n}\r\n\r\ntype State struct {\r\n\tmu         sync.RWMutex\r\n\tconfigPath string\r\n\tglobal     config.Global\r\n\tservices   map[string]*ServiceState\r\n\tlogMu      sync.Mutex\r\n\thealthLog  map[string][]HealthEvent\r\n"]
[11220.533814, "o", "\treloadCh   chan struct{}\r\n}\r\n\r\nfunc NewState(cfg *config.Config, path string) *State {\r\n\ts := &State{\r\n\t\tconfigPath: path,\r\n\t\tservices:   make(map[string]*ServiceState),\r\n\t\thealthLog:  make(map[string][]HealthEvent),\r\n"]
[11220.53388, "o", "\t\treloadCh:   make(chan struct{}, 1),\r\n\t}\r\n\ts.applyConfigLocked(cfg)\r\n\treturn s\r\n}\r\n\r\nfunc (s *State) ReloadChan() <-chan struct{} {\r\n\treturn s.reloadCh\r\n}\r\n\r\nfunc (s *State) ConfigPath() string {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.configPath\r\n"]
[11220.533942, "o", "}\r\n\r\nfunc (s *State) Global() config.Global {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.global\r\n"]
