[7445.924991, "o", "   292\t\treturn result\r\n   293\t}\r\n   294\t\r\n   295\tfunc forward(client, backend net.Conn, ep *state.EndpointState, id int64, idleTimeoutMs int) (int64, int64, bool) {\r\n   296\t\tvar bytesIn, bytesOut int64\r\n   297\t\tvar idleClosed int32\r\n"]
