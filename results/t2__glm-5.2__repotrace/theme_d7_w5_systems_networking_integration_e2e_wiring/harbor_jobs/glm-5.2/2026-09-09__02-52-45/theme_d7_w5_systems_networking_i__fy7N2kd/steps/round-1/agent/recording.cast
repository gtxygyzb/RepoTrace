[13816.447106, "o", "   124\t\r\n   125\tfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n   126\t\ts.mu.Lock()\r\n   127\t\tdefer s.mu.Unlock()\r\n   128\t\ts.applyConfigLocked(cfg)\r\n   129\t\tselect {\r\n   130\t\tcase s.reloadCh <- struct{}{}:\r\n   131\t\tdefault:\r\n   132\t\t}\r\n   133\t}\r\n   134\t\r\n"]
[13816.447185, "o", "   135\tfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n   136\t\ts.global = cfg.Global\r\n   137\t\tseen := make(map[string]bool)\r\n   138\t\tfor _, svc := range cfg.Services {\r\n   139\t\t\tseen[svc.Name] = true\r\n   140\t\t\tss := s.services[svc.Name]\r\n   141\t\t\tif ss == nil {\r\n   142\t\t\t\tss = newServiceState(svc, cfg.Global)\r\n   143\t\t\t\ts.services[svc.Name] = ss\r\n"]
