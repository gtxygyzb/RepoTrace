[5921.862603, "o", "   455\t\treturn out, true\r\n   456\t}\r\n   457\t\r\n   458\tfunc (ep *EndpointState) IsEligible(maxConns int) bool {\r\n   459\t\tep.mu.Lock()\r\n"]
[5921.862693, "o", "   460\t\tdefer ep.mu.Unlock()\r\n   461\t\treturn ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n   462\t}\r\n   463\t\r\n   464\tfunc (s *State) RecordHealthCheck(service, address string, success bool) HealthEvent {\r\n   465\t\tss := s.GetService(service)\r\n   466\t\tif ss == nil {\r\n   467\t\t\treturn HealthEvent{}\r\n   468\t\t}\r\n   469\t\tep := s.GetEndpoint(service, address)\r\n   470\t\tif ep == nil {\r\n   471\t\t\treturn HealthEvent{}\r\n   472\t\t}\r\n   473\t\tglobal := s.Global()\r\n   474\t\t"]
[5921.862769, "o", "ep.mu.Lock()\r\n   475\t\toldState := ep.State\r\n   476\t\tresult := \"success\"\r\n   477\t\tif !success {\r\n   478\t\t\tresult = \"failure\"\r\n"]
[5921.862833, "o", "   479\t\t}\r\n   480\t\tif success {\r\n   481\t\t\tep.consecSuccess++\r\n   482\t\t\tep.consecFailures = 0\r\n   483\t\t\tif oldState == Unknown && ep.consecSuccess >= global.HealthyThreshold {\r\n   484\t\t\t\tep.State = Healthy\r\n   485\t\t\t} else if oldState == Unhealthy && ep.consecSuccess >= global.HealthyThreshold {\r\n   486\t\t\t\tep.State = Healthy\r\n   487\t\t\t}\r\n   488\t\t} else {\r\n   489\t\t\tep.consecFailures++\r\n   490\t\t\tep.consecSuccess = 0\r\n   491\t\t\tif (oldState == Healthy || oldState == Unknown) && ep.consecFailures >= global.UnhealthyThreshold {\r\n   492\t\t\t\tep.State = Unhealthy\r\n   493\t\t\t\tep.Circuit.Open()\r\n"]
[5921.862892, "o", "   494\t\t\t\tep.consecFailures = 0\r\n   495\t\t\t\ttimeout := time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n   496\t\t\t\tgo func(deadline time.Time) {\r\n   497\t\t\t\t\ttime.Sleep(time.Until(deadline))\r\n   498\t\t\t\t\tep.mu.Lock()\r\n   499\t\t\t\t\tep.closeConnectionsLocked()\r\n   500\t\t\t\t\tep.mu.Unlock()\r\n   501\t\t\t\t}(time.Now().Add(timeout))\r\n   502\t\t\t}\r\n"]
[5921.862954, "o", "   503\t\t}\r\n   504\t\tnewState := ep.State\r\n   505\t\tep.mu.Unlock()\r\n   506\t\tevt := HealthEvent{\r\n   507\t\t\tTimestamp:   time.Now(),\r\n   508\t\t\tEndpoint:    address,\r\n   509\t\t\tOldState:    oldState,\r\n   510\t\t\tNewState:    newState,\r\n   511\t\t\tCheckResult: result,\r\n   512\t\t}\r\n   513\t\ts.logMu.Lock()\r\n"]
[5921.863012, "o", "   514\t\ts.healthLog[service] = append(s.healthLog[service], evt)\r\n   515\t\tif len(s.healthLog[service]) > 1000 {\r\n   516\t\t\ts.healthLog[service] = s.healthLog[service][len(s.healthLog[service])-1000:]\r\n   517\t\t}\r\n   518\t\ts.logMu.Unlock()\r\n   519\t\treturn evt\r\n   520\t}\r\n"]
