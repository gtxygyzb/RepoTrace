[588.048484, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.048846, "o", "func NewState(cfg *config.Config, path string) *State {\r\n\u001b[?2004l\r"]
[588.048933, "o", "\u001b[?2004h> "]
[588.049008, "o", "    s := &State{\r\n\u001b[?2004l\r\u001b[?2004h"]
[588.049084, "o", "> "]
[588.04919, "o", "        configPath: path,\r\n\u001b[?2004l\r"]
[588.049258, "o", "\u001b[?2004h> "]
[588.049545, "o", "        services:   make(map[string]*ServiceState),\r\n\u001b[?2004l\r"]
[588.049621, "o", "\u001b[?2004h> "]
[588.04991, "o", "        healthLog:  make(map[string][]HealthEvent),\r\n\u001b[?2004l\r"]
[588.049965, "o", "\u001b[?2004h> "]
[588.050222, "o", "        reloadCh:   make(chan struct{}, 1),\r\n\u001b[?2004l\r"]
[588.050276, "o", "\u001b[?2004h> "]
[588.050332, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.050526, "o", "    s.applyConfigLocked(cfg)\r\n\u001b[?2004l\r"]
[588.050586, "o", "\u001b[?2004h> "]
[588.050657, "o", "    return s\r\n\u001b[?2004l\r"]
[588.050711, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
