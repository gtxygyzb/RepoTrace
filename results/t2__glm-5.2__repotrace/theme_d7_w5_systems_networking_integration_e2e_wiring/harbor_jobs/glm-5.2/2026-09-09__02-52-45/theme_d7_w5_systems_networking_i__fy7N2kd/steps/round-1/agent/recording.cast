[5827.171369, "o", "   384\t\treturn \"\"\r\n   385\t}\r\n   386\t\r\n   387\tfunc (ep *EndpointState) UpdateConnectionActivity(id int64, bytesIn, bytesOut int64) {\r\n   388\t\tep.mu.Lock()\r\n   389\t\tdefer ep.mu.Unlock()\r\n   390\t\tif info, ok := ep.connections[id]; ok {\r\n   391\t\t\tinfo.bytesIn += bytesIn\r\n   392\t\t\tinfo.bytesOut += bytesOut\r\n   393"]
