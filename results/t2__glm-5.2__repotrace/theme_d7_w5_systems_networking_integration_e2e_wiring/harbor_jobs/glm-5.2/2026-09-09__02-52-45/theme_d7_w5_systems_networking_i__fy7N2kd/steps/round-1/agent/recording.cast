[10660.09042, "o", "    96\tfunc NewState(cfg *config.Config, path string) *State {\r\n    97\t\ts := &State{\r\n    98\t\t\tconfigPath: path,\r\n    99\t\t\tservices:   make(map[string]*ServiceState),\r\n   100\t\t\thealthLog:  make(map[string][]HealthEvent),\r\n"]
[10660.090474, "o", "   101\t\t\treloadCh:   make(chan struct{}, 1),\r\n   102\t\t}\r\n   103\t\ts.applyConfigLocked(cfg)\r\n   104\t\treturn s\r\n   105\t}\r\n   106\t\r\n   107\tfunc (s *State) ReloadChan() <-chan struct{} {\r\n   108\t\treturn s.reloadCh\r\n   109\t}\r\n   110\t\r\n   111\t"]
[10660.090526, "o", "func (s *State) ConfigPath() string {\r\n   112\t\ts.mu.RLock()\r\n   113\t\tdefer s.mu.RUnlock()\r\n   114\t\treturn s.configPath\r\n   115\t}\r\n   116\t\r\n"]
[10660.090575, "o", "   117\tfunc (s *State) Global() config.Global {\r\n   118\t\ts.mu.RLock()\r\n   119\t\tdefer s.mu.RUnlock()\r\n   120\t\treturn s.global\r\n   121\t}\r\n   122\t\r\n"]
