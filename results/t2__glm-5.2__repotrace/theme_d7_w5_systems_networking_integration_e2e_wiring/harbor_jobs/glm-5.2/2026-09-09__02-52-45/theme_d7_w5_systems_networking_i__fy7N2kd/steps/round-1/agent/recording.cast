[14091.75635, "o", "\r\n   384\t\t\t\t\tAgeMs    int64  `json:\"age_ms\"`\r\n   385\t\t\t\t\tIdleMs   int64  `json:\"idle_ms\"`\r\n   386\t\t\t\t\tBytesIn  int64  `json:\"bytes_in\"`\r\n   387\t\t\t\t\tBytesOut int64  `json:\"bytes_out\"`\r\n   388\t\t\t\t} `json:\"connections\"`\r\n   389\t\t\t}\r\n   390\t\t\tif err := json.Unmarshal(data, &resp); err != nil {\r\n"]
