[5929.75894, "o", "    16\t}\r\n    17\t\r\n    18\ttype response struct {\r\n    19\t\tStatus string          `json:\"status\"`\r\n    20\t\tData   json.RawMessage `json:\"data\"`\r\n    21\t}\r\n    22\t\r\n    23\tfunc main() {\r\n    24\t\tif len(os.Args) < 2 {\r\n    25\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl <command> [args]\")\r\n    26\t\t\tos.Exit(1)\r\n    27\t\t}\r\n    28\t\r\n    29\t\tcliCmd := os.Args[1]\r\n    30\t\targs := make(map[string]interface{})\r\n    31\t\tvar ipcCmd string\r\n    32\t\r\n    33\t\tswitch cliCmd {\r\n    34\t\tcase \"status\":\r\n"]
[5929.759044, "o", "    35\t\t\tipcCmd = \"list_services\"\r\n    36\t\tcase \"stats\":\r\n    37\t\t\tif len(os.Args) < 3 {\r\n    38\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")\r\n    39\t\t\t\tos.Exit(1)\r\n    40\t\t\t}\r\n    41\t\t\tipcCmd = \"get_stats\"\r\n    42\t\t\targs[\"name\"] = os.Args[2]\r\n    43\t\tcase \"set-weight\":\r\n    44\t\t\tif len(os.Args) < 5 {\r\n    45\t\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")\r\n    46\t\t\t\tos.Exit(1)\r\n    47\t\t\t}\r\n    48\t\t\tweight, err := strconv.Atoi(os.Args[4])\r\n    49\t\t\tif err != nil {\r\n    50\t\t\t\tfmt.Fprintf(os.Stderr, \"invalid weight: %v\\n\", err)\r\n    51\t\t\t\tos.Exit(1)\r\n    52\t\t\t}\r\n    53\t\t\tipcCmd = \"set_weight\"\r\n    54\t\t\targs[\"name\"] = os.Args[2]\r\n    55\t\t\targs[\"address\"] = os.Args[3]\r\n    56\t\t\targs[\"weight\"] = weight\r\n    57\t\tcase \"drain\":\r\n"]
