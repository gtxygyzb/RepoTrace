[4130.745795, "o", "     1\tpackage state\r\n     2\t\r\n     3\timport (\r\n"]
[4130.745807, "o", "     4\t\t\"sort\"\r\n     5\t\t\"time\"\r\n"]
[4130.745891, "o", "     6\t)\r\n     7\t\r\n     8\t// SelectResult contains selected endpoint and whether it is a half-open probe.\r\n     9\ttype SelectResult struct {\r\n    10\t\tEndpoint *EndpointState\r\n    11\t\tProbe    bool\r\n    12\t\tMaxConns int\r\n    13\t}\r\n    14\t\r\n    15\t// SelectEndpoint chooses an endpoint for the next connection.\r\n    16\tfunc (s *State) SelectEndpoint(service string) (SelectResult, error) {\r\n    17\t\tss := s.GetService(service)\r\n"]
[4130.745903, "o", "    18\t\tif ss == nil {\r\n"]
[4130.745972, "o", "    19\t\t\treturn SelectResult{}, errNotFound(\"service not found\")\r\n    20\t\t}\r\n    21\t\tss.mu.Lock()\r\n    22\t\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n    23\t\tmode := ss.RoutingMode\r\n    24\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n    25\t\tcopy(endpoints, ss.Endpoints)\r\n    26\t\tss.mu.Unlock()\r\n    27\t\r\n    28\t\tnow := time.Now()\r\n"]
[4130.745985, "o", "    29\t\t_ = now\r\n    30\t\r\n"]
[4130.746064, "o", "    31\t\tvar regular []*EndpointState\r\n    32\t\tfor _, ep := range endpoints {\r\n    33\t\t\tep.mu.Lock()\r\n    34\t\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n    35\t\t\tep.mu.Unlock()\r\n    36\t\t\tif eligible {\r\n    37\t\t\t\tregular = append(regular, ep)\r\n    38\t\t\t}\r\n    39\t\t}\r\n    40\t\r\n"]
[4130.746075, "o", "    41\t\tif len(regular) > 0 {\r\n"]
[4130.746136, "o", "    42\t\t\tif mode == \"least-connections\" {\r\n    43\t\t\t\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\r\n    44\t\t\t}\r\n    45\t\t\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\r\n    46\t\t}\r\n    47\t\r\n    48\t\tfor _, ep := range endpoints {\r\n    49\t\t\tep.mu.Lock()\r\n"]
[4130.746147, "o", "    50\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n    51\t\t\tep.mu.Unlock()\r\n"]
[4130.746205, "o", "    52\t\t\tif halfOpen && ep.Circuit.AcquireProbe() {\r\n    53\t\t\t\treturn SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil\r\n    54\t\t\t}\r\n    55\t\t}\r\n    56\t\treturn SelectResult{}, errNotFound(\"no eligible endpoints\")\r\n    57\t}\r\n    58\t\r\n    59\t// SelectCandidate returns the endpoint that would be selected ignoring connection limits.\r\n    60\t// Used to account rejected_connections when all eligible endpoints are at capacity.\r\n    61"]
[4130.746216, "o", "\tfunc (s *State) SelectCandidate(service string) (*EndpointState, error) {\r\n    62\t\tss := s.GetService(service)"]
[4130.746277, "o", "\r\n    63\t\tif ss == nil {\r\n    64\t\t\treturn nil, errNotFound(\"service not found\")\r\n    65\t\t}\r\n    66\t\tss.mu.Lock()\r\n    67\t\tmode := ss.RoutingMode\r\n    68\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n"]
[4130.746289, "o", "    69\t\tcopy(endpoints, ss.Endpoints)\r\n    70\t\tss.mu.Unlock()\r\n    71\t\r\n    72\t\t"]
[4130.74636, "o", "var regular []*EndpointState\r\n    73\t\tfor _, ep := range endpoints {\r\n    74\t\t\tep.mu.Lock()\r\n    75\t\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining\r\n    76\t\t\tep.mu.Unlock()\r\n    77\t\t\tif eligible {\r\n    78\t\t\t\tregular = append(regular, ep)\r\n    79\t\t\t}\r\n    80\t\t}\r\n    81\t\tif len(regular) == 0 {"]
[4130.746371, "o", "\r\n"]
[4130.746469, "o", "    82\t\t\tfor _, ep := range endpoints {\r\n    83\t\t\t\tep.mu.Lock()\r\n    84\t\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining\r\n    85\t\t\t\tep.mu.Unlock()\r\n    86\t\t\t\tif halfOpen {\r\n    87\t\t\t\t\treturn ep, nil\r\n    88\t\t\t\t}\r\n    89\t\t\t}\r\n    90\t\t\treturn nil, errNotFound(\"no eligible endpoints\")\r\n    91\t\t}\r\n    92\t\tif mode == \"least-connections\" {\r\n"]
[4130.74648, "o", "    93\t\t\treturn selectLeastConnections(regular, 1<<30), nil\r\n"]
[4130.746543, "o", "    94\t\t}\r\n    95\t\treturn selectWeightedCandidate(regular), nil\r\n    96\t}\r\n    97\t\r\n    98\tfunc selectWeighted(eps []*EndpointState) *EndpointState {\r\n    99\t\tvar best *EndpointState\r\n   100\t\tvar bestWeight int\r\n   101\t\tvar totalWeight int\r\n"]
[4130.746553, "o", "   102\t\tfor _, ep := range eps {\r\n   103\t\t\tep.mu.Lock()\r\n"]
[4130.746583, "o", "   104\t\t\tep.currentWeight += ep.Weight\r\n   105\t\t\ttotalWeight += ep.Weight\r\n   106\t\t\tcw := ep.currentWeight\r\n   107\t\t\tep.mu.Unlock()\r\n   108\t\t\tif best == nil || cw > bestWeight {\r\n"]
[4130.746652, "o", "   109\t\t\t\tbest = ep\r\n   110\t\t\t\tbestWeight = cw\r\n   111\t\t\t}\r\n   112\t\t}\r\n   113\t\tif best != nil {\r\n   114\t\t\tbest.mu.Lock()\r\n   115\t\t\tbest.currentWeight -= totalWeight\r\n   116\t\t\tbest.mu.Unlock()\r\n   117\t\t}\r\n   118\t\treturn best\r\n   119"]
[4130.746697, "o", "\t}\r\n   120\t\r\n"]
[4130.746711, "o", "   121\tfunc selectWeightedCandidate(eps []*EndpointState) *EndpointState {\r\n   122\t\tvar best *EndpointState\r\n   123\t\tvar bestWeight int\r\n   124\t\tfor _, ep := range eps {\r\n   125\t\t\tep.mu.Lock()\r\n   126\t\t"]
[4130.746771, "o", "\tcw := ep.currentWeight + ep.Weight\r\n   127\t\t\tep.mu.Unlock()\r\n   128\t\t\tif best == nil || cw > bestWeight {\r\n   129\t\t\t\tbest = ep\r\n   130\t\t\t\tbestWeight = cw\r\n   131\t\t\t}\r\n   132\t\t}\r\n   133\t\treturn best\r\n   134\t}\r\n   135\t\r\n"]
[4130.746781, "o", "   136\t"]
[4130.746843, "o", "func selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\r\n   137\t\tsort.SliceStable(eps, func(i, j int) bool {\r\n   138\t\t\tai := eps[i].Active()\r\n   139\t\t\taj := eps[j].Active()\r\n   140\t\t\tif ai != aj {\r\n   141\t\t\t\treturn ai < aj\r\n   142\t\t\t}\r\n   143\t\t\treturn eps[i].Address < eps[j].Address\r\n   144\t\t})\r\n   145\t\treturn eps[0]\r\n"]
[4130.746854, "o", "   146\t}\r\n"]
[4130.746912, "o", "   147\t\r\n   148\t// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\r\n   149\tfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\r\n   150\t\tss := s.GetService(service)\r\n   151\t\tif ss == nil {\r\n   152\t\t\treturn SelectResult{}, errNotFound(\"service not found\")\r\n   153\t\t}\r\n   154\t\tss.mu.Lock()\r\n"]
[4130.746924, "o", "   155\t\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n   156\t\tmode := ss.RoutingMode\r\n   157\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n"]
[4130.746982, "o", "   158\t\tcopy(endpoints, ss.Endpoints)\r\n   159\t\tss.mu.Unlock()\r\n   160\t\r\n   161\t\tvar regular []*EndpointState\r\n   162\t\tfor _, ep := range endpoints {\r\n   163\t\t\tif exclude != nil && ep == exclude {\r\n"]
[4130.746997, "o", "   164\t\t\t\tcontinue\r\n   165\t\t\t}\r\n   166\t\t\tep.mu.Lock()\r\n"]
[4130.747071, "o", "   167\t\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n   168\t\t\tep.mu.Unlock()\r\n   169\t\t\tif eligible {\r\n   170\t\t\t\tregular = append(regular, ep)\r\n   171\t\t\t}\r\n   172\t\t}\r\n   173\t\r\n   174\t\tif len(regular) > 0 {\r\n   175\t\t\tif mode == \"least-connections\" {\r\n"]
[4130.747088, "o", "   176\t\t\t\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\r\n   177\t\t\t}\r\n   178\t\t\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\r\n"]
[4130.747174, "o", "   179\t\t}\r\n   180\t\r\n   181\t\tfor _, ep := range endpoints {\r\n   182\t\t\tif exclude != nil && ep == exclude {\r\n   183\t\t\t\tcontinue\r\n   184\t\t\t}\r\n   185\t\t\tep.mu.Lock()\r\n   186\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n   187\t\t\tep.mu.Unlock()\r\n   188\t\t\tif halfOpen && ep.Circuit.AcquireProbe() {\r\n   189\t\t\t\treturn SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil\r\n   190\t\t\t}\r\n   191"]
[4130.747185, "o", "\t\t}\r\n"]
[4130.747287, "o", "   192\t\treturn SelectResult{}, errNotFound(\"no eligible endpoints\")\r\n   193\t}\r\n"]
[4130.747705, "o", "\u001b[?2004h"]
