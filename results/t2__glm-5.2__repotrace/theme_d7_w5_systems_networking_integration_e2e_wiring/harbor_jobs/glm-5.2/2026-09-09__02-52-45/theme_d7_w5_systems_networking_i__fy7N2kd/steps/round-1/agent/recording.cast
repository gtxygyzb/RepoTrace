[5700.46173, "i", "sed -n '1,220p' config/services.toml\n"]
[5700.462067, "o", "sed -n '1,220p' config/services.toml\r\n\u001b[?2004l\r"]
[5700.465122, "o", "[global]\r\nhealth_interval_ms = 2000\r\nunhealthy_threshold = 3\r\nhealthy_threshold = 2\r\nstats_window_sec = 60\r\ncircuit_breaker_threshold = 3\r\n"]
[5700.46524, "o", "circuit_breaker_timeout_ms = 5000\r\n\r\n[[service]]\r\nname = \"api-gateway\"\r\nlisten_port = 9001\r\nrouting_mode = \"weighted-round-robin\"\r\ndrain_timeout_ms = 5000\r\nmax_connections_per_endpoint = 50\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8081\"\r\n  weight = 5\r\n  health_check = \"tcp\"\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8082\"\r\n  weight = 3\r\n  health_check = \"http\"\r\n  health_path = \"/healthz\"\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8083\"\r\n  weight = 2\r\n  health_check = \"tcp\"\r\n\r\n[[service]]"]
[5700.465321, "o", "\r\nname = \"data-store\"\r\nlisten_port = 9002\r\nrouting_mode = \"least-connections\"\r\ndrain_timeout_ms = 10000\r\nmax_connections_per_endpoint = 3\r\nrate_limit_rps = 5\r\nrate_limit_burst = 8\r\nrate_limit_queue_depth = 2\r\nrate_limit_queue_timeout_ms = 500\r\nmax_retries = 1\r\nretry_delay_ms = 100\r\nretry_backoff_multiplier = 2.0\r\nretry_max_delay_ms = 1000\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8091\""]
[5700.465447, "o", "\r\n  weight = 1\r\n  health_check = \"tcp\"\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8092\"\r\n  weight = 1\r\n  health_check = \"exec\"\r\n  health_cmd = \"nc -z 127.0.0.1 8092\"\r\n"]
[5700.465514, "o", "\r\n[[service]]\r\nname = \"cache-layer\"\r\nlisten_port = 9003\r\nrouting_mode = \"weighted-round-robin\"\r\ndrain_timeout_ms = 3000\r\nmax_connections_per_endpoint = 100\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8071\"\r\n  weight = 4\r\n  health_check = \"tcp\"\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8072\"\r\n  weight = 4\r\n  health_check = \"tcp\"\r\n\r\n  [[service.endpoint]]\r\n  address = \"127.0.0.1:8073\"\r\n  weight = 2\r\n  health_check = \"http\"\r\n  health_path = \"/health\"\r\n"]
[5700.466008, "o", "\u001b[?2004h"]
[5700.466079, "o", "root@n30009:/app# "]
[5700.740119, "i", "sed -n '1,260p' internal/config/config.go\n"]
[5700.74052, "o", "sed -n '1,260p' internal/config/config.go\r\n"]
[5700.740603, "o", "\u001b[?2004l\r"]
[5700.743513, "o", "package config\r\n\r\nimport (\r\n\t\"github.com/BurntSushi/toml\"\r\n)\r\n\r\n// Global holds mesh-wide tuning parameters.\r\n"]
[5700.743566, "o", "type Global struct {\r\n\tHealthIntervalMs        int `toml:\"health_interval_ms\"`\r\n\tUnhealthyThreshold      int `toml:\"unhealthy_threshold\"`\r\n\tHealthyThreshold        int `toml:\"healthy_threshold\"`\r\n\tStatsWindowSec          int `toml:\"stats_window_sec\"`\r\n\tCircuitBreakerThreshold int `toml:\"circuit_breaker_threshold\"`\r\n\tCircuitBreakerTimeoutMs int `toml:\"circuit_breaker_timeout_ms\"`\r\n}\r\n"]
[5700.743732, "o", "\r\n// Endpoint describes one backend endpoint from config.\r\ntype Endpoint struct {\r\n\tAddress     string `toml:\"address\"`\r\n\tWeight      int    `toml:\"weight\"`\r\n\tHealthCheck string `toml:\"health_check\"`\r\n\tHealthPath  string `toml:\"health_path\"`\r\n\tHealthCmd   string `toml:\"health_cmd\"`\r\n}\r\n\r\n// Service describes one routed service from config.\r\ntype Service struct {\r\n\tName                      string     `toml:\"name\"`\r\n\tListenPort                int        `toml:\"listen_port\"`\r\n\tRoutingMode               string     `toml:\"routing_mode\"`\r\n\tDrainTimeoutMs            int        `toml:\"drain_timeout_ms\"`\r\n\tMaxConnectionsPerEndpoint int        `toml:\"max_connections_per_endpoint\"`\r\n\tRateLimitRps              int        `toml:\"rate_limit_rps\"`\r\n\tRateLimitBurst            int        `toml:\"rate_limit_burst\"`\r\n\tRateLimitQueueDepth       int        `toml:\"rate_limit_queue_depth\"`\r\n\tRateLimitQueueTimeoutMs   int        `toml:\"rate_limit_queue_timeout_ms\"`\r\n\tMaxRetries                int        `toml:\"max_retries\"`\r\n\tRetryD"]
[5700.743813, "o", "elayMs              int        `toml:\"retry_delay_ms\"`\r\n\tRetryBackoffMultiplier    float64    `toml:\"retry_backoff_multiplier\"`\r\n\tRetryMaxDelayMs           int        `toml:\"retry_max_delay_ms\"`\r\n\tIdleTimeoutMs             int        `toml:\"idle_timeout_ms\"`\r\n\tEndpoints                 []Endpoint `toml:\"endpoint\"`\r\n}\r\n\r\n// Config is the parsed application configuration.\r\ntype Config struct {\r\n\tGlobal   Global\r\n\tServices []Service `toml:\"service\"`\r\n}\r\n\r\n// Load reads and normalizes a TOML config file.\r\nfunc Load(path string) (*Config, error) {\r\n\tvar cfg Config\r\n\tif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n"]
[5700.743885, "o", "\tif cfg.Global.HealthIntervalMs <= 0 {\r\n\t\tcfg.Global.HealthIntervalMs = 2000\r\n\t}\r\n\tif cfg.Global.UnhealthyThreshold <= 0 {\r\n\t\tcfg.Global.UnhealthyThreshold = 3\r\n\t}\r\n\tif cfg.Global.HealthyThreshold <= 0 {\r\n\t\tcfg.Global.HealthyThreshold = 2\r\n\t}\r\n\tif cfg.Global.StatsWindowSec <= 0 {\r\n\t\tcfg.Global.StatsWindowSec = 60\r\n\t}\r\n\tif cfg.Global.CircuitBreakerThreshold <= 0 {\r\n\t\tcfg.Global.CircuitBreakerThreshold = 3\r\n\t}\r\n\tif cfg.Global.CircuitBreakerTimeoutMs <= 0 {\r\n\t\tcfg.Global.CircuitBreakerTimeoutMs = 5000\r\n\t}\r\n"]
[5700.744001, "o", "\tfor i := range cfg.Services {\r\n\t\ts := &cfg.Services[i]\r\n\t\tif s.RoutingMode == \"\" {\r\n\t\t\ts.RoutingMode = \"weighted-round-robin\"\r\n\t\t}\r\n\t\tif s.DrainTimeoutMs <= 0 {\r\n\t\t\ts.DrainTimeoutMs = 5000\r\n\t\t}\r\n\t\tif s.MaxConnectionsPerEndpoint <= 0 {\r\n\t\t\ts.MaxConnectionsPerEndpoint = 100\r\n\t\t}\r\n\t\tif s.RateLimitBurst <= 0 {\r\n\t\t\ts.RateLimitBurst = s.RateLimitRps\r\n\t\t}\r\n\t\tif s.RateLimitQueueTimeoutMs <= 0 {\r\n\t\t\ts.RateLimitQueueTimeoutMs = 1000\r\n\t\t}\r\n\t\tif s.RetryDelayMs <= 0 {\r\n\t\t\ts.RetryDelayMs = 100\r\n\t\t}\r\n\t\tif s.RetryBackoffMultiplier <= 0 {\r\n\t\t\ts.RetryBackoffMultiplier = 2.0\r\n\t\t}\r\n"]
[5700.744065, "o", "\t\tif s.RetryMaxDelayMs <= 0 {\r\n\t\t\ts.RetryMaxDelayMs = 5000\r\n\t\t}\r\n\t\tfor j := range s.Endpoints {\r\n\t\t\tep := &s.Endpoints[j]\r\n\t\t\tif ep.HealthCheck == \"\" {\r\n\t\t\t\tep.HealthCheck = \"tcp\"\r\n\t\t\t}\r\n"]
[5700.744131, "o", "\t\t\tif ep.Weight < 0 {\r\n\t\t\t\tep.Weight = 0\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn &cfg, nil\r\n}\r\n"]
[5700.74463, "o", "\u001b[?2004h"]
[5700.744691, "o", "root@n30009:/app# "]
[5701.03799, "i", "sed -n '1,320p' internal/state/state.go\n"]
[5701.038337, "o", "sed -n '1,320p' internal/state/state.go\r\n\u001b[?2004l\r"]
[5701.04152, "o", "package state\r\n\r\nimport (\r\n\t\"net\"\r\n\t\"sort\"\r\n"]
[5701.041644, "o", "\t\"sync\"\r\n\t\"sync/atomic\"\r\n\t\"time\"\r\n\r\n\t\"meshrouter/internal/circuit\"\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/stats\"\r\n)\r\n"]
[5701.041715, "o", "\r\ntype HealthState string\r\n\r\nconst (\r\n\tUnknown   HealthState = \"unknown\"\r\n\tHealthy   HealthState = \"healthy\"\r\n\tUnhealthy HealthState = \"unhealthy\"\r\n\tDraining  HealthState = \"draining\"\r\n)\r\n\r\ntype HealthEvent struct {\r\n\tTimestamp   time.Time\r\n\tEndpoint    string\r\n\tOldState    HealthState\r\n\tNewState    HealthState\r\n\tCheckResult string\r\n}\r\n\r\ntype EndpointState struct {\r\n\tmu                sync.Mutex\r\n\tAddress           string\r\n\tWeight            int\r\n\tConfig            config.Endpoint\r\n\tState             HealthState\r\n\tActiveConnections int\r\n\tCircuit           *circuit.Breaker\r\n\tStats             *stats.Collector\r\n\tconsecSuccess     int\r\n\tconsecFailures    int\r\n\tdrainDeadline     time.Time\r\n\tremoved           bool\r\n\tconnIDCounter     int64\r\n\tcurrentWeight     int\r\n"]
[5701.041793, "o", "\tconnections       map[int64]*connectionInfo\r\n}\r\n\r\ntype connectionInfo struct {\r\n\tconn         net.Conn\r\n\tclientAddr   string\r\n\tstart        time.Time\r\n\tlastActivity time.Time\r\n\tbytesIn      int64\r\n\tbytesOut     int64\r\n}\r\n\r\ntype ServiceState struct {\r\n\tmu                        sync.Mutex\r\n\tName                      string"]
[5701.041858, "o", "\r\n\tListenPort                int\r\n\tRoutingMode               string\r\n\tDrainTimeoutMs            int\r\n\tMaxConnectionsPerEndpoint int\r\n\tIdleTimeoutMs             int\r\n\tRateLimitRps              int\r\n\tRateLimitBurst            int\r\n\tRateLimitQueueDepth       int\r\n\tRateLimitQueueTimeoutMs   int\r\n\tMaxRetries                int\r\n\tRetryDelayMs              int\r\n"]
[5701.041919, "o", "\tRetryBackoffMultiplier    float64\r\n\tRetryMaxDelayMs           int\r\n\trateLimiter               *rateLimiter\r\n\tEndpoints                 []*EndpointState\r\n\trrIndex                   int\r\n\tListener                  net.Listener\r\n\tlistenerStop              chan struct{}\r\n\tstopping                  bool\r\n}\r\n\r\n"]
[5701.041979, "o", "type State struct {\r\n\tmu         sync.RWMutex\r\n\tconfigPath string\r\n\tglobal     config.Global\r\n\tservices   map[string]*ServiceState\r\n\tlogMu      sync.Mutex\r\n\thealthLog  map[string][]HealthEvent\r\n\treloadCh   chan struct{}\r\n}\r\n\r\n"]
[5701.042036, "o", "func NewState(cfg *config.Config, path string) *State {\r\n\ts := &State{\r\n\t\tconfigPath: path,\r\n\t\tservices:   make(map[string]*ServiceState),\r\n\t\thealthLog:  make(map[string][]HealthEvent),\r\n\t\treloadCh:   make(chan struct{}, 1),\r\n\t}\r\n\ts.applyConfigLocked(cfg)\r\n"]
[5701.042096, "o", "\treturn s\r\n}\r\n\r\nfunc (s *State) ReloadChan() <-chan struct{} {\r\n\treturn s.reloadCh\r\n}\r\n\r\nfunc (s *State) ConfigPath() string {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.configPath\r\n}\r\n"]
[5701.042153, "o", "\r\nfunc (s *State) Global() config.Global {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.global\r\n}\r\n\r\nfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n\ts.mu.Lock()\r\n\tdefer s.mu.Unlock()\r\n"]
[5701.042215, "o", "\ts.applyConfigLocked(cfg)\r\n\tselect {\r\n\tcase s.reloadCh <- struct{}{}:\r\n\tdefault:\r\n\t}\r\n}\r\n\r\nfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n\ts.global = cfg.Global\r\n\tseen := make(map[string]bool)\r\n\tfor _, svc := range cfg.Services {\r\n\t\tseen[svc.Name] = true\r\n\t\tss := s.services[svc.Name]\r\n"]
[5701.042271, "o", "\t\tif ss == nil {\r\n\t\t\tss = newServiceState(svc, cfg.Global)\r\n\t\t\ts.services[svc.Name] = ss\r\n\t\t} else {\r\n\t\t\tss.mu.Lock()\r\n\t\t\tss.Name = svc.Name\r\n\t\t\tss.ListenPort = svc.ListenPort\r\n"]
[5701.042327, "o", "\t\t\tss.RoutingMode = svc.RoutingMode\r\n\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n\t\t\tss.RateLimitRps = svc.RateLimitRps\r\n\t\t\tss.RateLimitBurst = svc.RateLimitBurst\r\n\t\t\tss.RateLimitQueueDepth = svc.RateLimitQueueDepth\r\n\t\t\tss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs\r\n\t\t\tss.MaxRetries = svc.MaxRetries\r\n\t\t\tss.RetryDelayMs = svc.RetryDelayMs\r\n\t\t"]
[5701.042399, "o", "\tss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier\r\n\t\t\tss.RetryMaxDelayMs = svc.RetryMaxDelayMs\r\n\t\t\tif ss.rateLimiter == nil {\r\n\t\t\t\tss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n\t\t\t} else {\r\n\t\t\t\tss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n\t\t\t}\r\n\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n\t\t\tss.IdleTimeoutMs = svc.IdleTimeoutMs\r\n"]
[5701.042455, "o", "\t\t\tss.mu.Unlock()\r\n\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n\t\t}\r\n\t}\r\n\tfor name, ss := range s.services {\r\n\t\tif !seen[name] {\r\n\t\t\tss.mu.Lock()\r\n\t\t\tss.stopping = true\r\n"]
[5701.042514, "o", "\t\t\tif ss.listenerStop != nil {\r\n\t\t\t\tclose(ss.listenerStop)\r\n\t\t\t\tss.listenerStop = nil\r\n\t\t\t}\r\n\t\t\tif ss.Listener != nil {\r\n\t\t\t\tss.Listener.Close()\r\n\t\t\t\tss.Listener = nil\r\n\t\t\t}\r\n\t\t\tss.mu.Unlock()\r\n"]
[5701.042569, "o", "\t\t\tfor _, ep := range ss.Endpoints {\r\n\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc newServiceState(svc config.Service, global config.Global) *ServiceState {\r\n\tss := &ServiceState{\r\n\t\tName:                      svc.Name,\r\n\t"]
[5701.042646, "o", "\tListenPort:                svc.ListenPort,\r\n\t\tRoutingMode:               svc.RoutingMode,\r\n\t\tDrainTimeoutMs:            svc.DrainTimeoutMs,\r\n\t\tRateLimitRps:              svc.RateLimitRps,\r\n\t\tRateLimitBurst:            svc.RateLimitBurst,\r\n\t\tRateLimitQueueDepth:       svc.RateLimitQueueDepth,\r\n\t\tRateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,\r\n\t\tMaxRetries:                svc.MaxRetries,\r\n\t\tRetryDelayMs:              svc.RetryDelayMs,\r\n\t\tRetryBackoffMultiplier:    svc.RetryBackoffMultiplier,\r\n\t\tRetryMaxDelayMs:           svc.RetryMaxDelayMs,\r\n\t\trateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),\r\n\t"]
[5701.042711, "o", "\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n\t\tIdleTimeoutMs:             svc.IdleTimeoutMs,\r\n\t\tlistenerStop:              nil,\r\n\t}\r\n\tfor _, ep := range svc.Endpoints {\r\n\t\tss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))\r\n\t}\r\n\treturn ss\r\n}\r\n\r\n"]
[5701.042775, "o", "func (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n\tss.mu.Lock()\r\n\tdefer ss.mu.Unlock()\r\n\tseen := make(map[string]bool)\r\n\tfor _, cep := range eps {\r\n\t\tseen[cep.Address] = true\r\n\t\tvar ep *EndpointState\r\n\t\tfor _, existing := range ss.Endpoints {\r\n\t\t\tif existing.Address == cep.Address {\r\n\t\t\t\tep = existing\r\n\t\t\t\tbreak\r\n"]
[5701.042836, "o", "\t\t\t}\r\n\t\t}\r\n\t\tif ep == nil {\r\n\t\t\tep = newEndpointState(cep, global)\r\n\t\t\tss.Endpoints = append(ss.Endpoints, ep)\r\n\t\t} else {\r\n\t\t\tep.mu.Lock()\r\n\t\t\tep.Config = cep\r\n\t\t\tep.Weight = cep.Weight\r\n\t\t\tep.mu.Unlock()\r\n"]
[5701.042897, "o", "\t\t}\r\n\t}\r\n\tfor _, ep := range ss.Endpoints {\r\n\t\tif !seen[ep.Address] {\r\n\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunc newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {\r\n"]
[5701.042959, "o", "\treturn &EndpointState{\r\n\t\tAddress:     cep.Address,\r\n\t\tWeight:      cep.Weight,\r\n\t\tConfig:      cep,\r\n\t\tState:       Unknown,\r\n\t\tCircuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n\t\tStats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n\t\tconnections: make(map[int64]*connectionInfo),\r\n\t}\r\n}\r\n\r\n"]
[5701.043026, "o", "func (s *State) GetService(name string) *ServiceState {\r\n\ts.mu.RLock()\r\n\tdefer s.mu.RUnlock()\r\n\treturn s.services[name]\r\n}\r\n\r\nfunc (s *State) Services() []*ServiceState {\r\n\ts.mu.RLock()\r\n"]
[5701.043088, "o", "\tdefer s.mu.RUnlock()\r\n\tout := make([]*ServiceState, 0, len(s.services))\r\n\tfor _, ss := range s.services {\r\n\t\tout = append(out, ss)\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc (s *State) GetEndpoint(service, address string) *EndpointState {\r\n\tss := s.GetService(service)\r\n\tif ss == nil {\r\n\t\treturn nil\r\n\t}\r\n"]
[5701.043145, "o", "\tss.mu.Lock()\r\n\tdefer ss.mu.Unlock()\r\n\tfor _, ep := range ss.Endpoints {\r\n\t\tif ep.Address == address {\r\n\t\t\treturn ep\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc (s *State) SetWeight(service, address string, weight int) error {\r\n\tep := s.GetEndpoint(service, address)\r\n"]
[5701.043204, "o", "\tif ep == nil {\r\n\t\treturn errNotFound(\"endpoint not found\")\r\n\t}\r\n\tep.mu.Lock()\r\n\tdefer ep.mu.Unlock()\r\n\tif weight < 0 {\r\n\t\tweight = 0\r\n\t}\r\n\tep.Weight = weight\r\n\treturn nil\r\n}\r\n\r\n"]
[5701.043266, "o", "func (s *State) DrainEndpoint(service, address string) error {\r\n\tss := s.GetService(service)\r\n\tif ss == nil {\r\n\t\treturn errNotFound(\"service not found\")\r\n"]
[5701.043331, "o", "\t}\r\n\tep := s.GetEndpoint(service, address)\r\n\tif ep == nil {\r\n\t\treturn errNotFound(\"endpoint not found\")\r\n\t}\r\n\tep.StartDraining(ss.DrainTimeoutMs, false)\r\n\treturn nil\r\n}\r\n\r\nfunc (s *State) ResetCircuitBreaker(service, address string) error {\r\n"]
[5701.043396, "o", "\tep := s.GetEndpoint(service, address)\r\n\tif ep == nil {\r\n\t\treturn errNotFound(\"endpoint not found\")\r\n\t}\r\n\tep.Circuit.Reset()\r\n\treturn nil\r\n}\r\n\r\nfunc (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {\r\n\tep.mu.Lock()\r\n\tdefer ep.mu.Unlock()\r\n"]
