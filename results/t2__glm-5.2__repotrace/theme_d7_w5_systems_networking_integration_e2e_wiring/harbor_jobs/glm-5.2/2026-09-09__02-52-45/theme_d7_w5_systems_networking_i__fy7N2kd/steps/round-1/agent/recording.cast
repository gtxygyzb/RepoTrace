[7897.513422, "i", "cat > internal/accesslog/logger.go <<'EOF'\npackage accesslog\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"time\"\n)\n\n// Entry is one structured access log record.\ntype Entry struct {\n\tTs         string `json:\"ts\"`\n\tService    string `json:\"service\"`\n\tClient     string `json:\"client\"`\n\tEndpoint   string `json:\"endpoint\"`\n\tBytesIn    int64  `json:\"bytes_in\"`\n\tBytesOut   int64  `json:\"bytes_out\"`\n\tDurationMs int64  `json:\"duration_ms\"`\n\tResult     string `json:\"result\"`\n}\n\n// DefaultPath is the access log path required by meshrouter.\nconst DefaultPath = \"/app/logs/access.log\"\n\nconst maxFileSize = 1 << 20 // 1 MB\n\n// Logger writes access log entries asynchronously to a JSON-lines file.\n// It uses a buffered channel so connection handling does not block unless the\n// channel is full. When the channel is full, entries are written synchronously\n// to avoid losing them.\ntype Logger struct {\n\tpath     string\n\tch       chan Entry\n\tstop     chan struct{}\n\tdone     chan struct{}\n\tstopped  int3"]
[7897.513686, "i", "2\n\tstopOnce sync.Once\n\tmu       sync.Mutex\n\tfile     *os.File\n\tsize     int64\n}\n\n// New creates a Logger for path and starts its writer goroutine.\nfunc New(path string) *Logger {\n\tif path == \"\" {\n\t\tpath = DefaultPath\n\t}\n\tl := &Logger{\n\t\tpath: path,\n\t\tch:   make(chan Entry, 8192),\n\t\tstop: make(chan struct{}),\n\t\tdone: make(chan struct{}),\n\t}\n\tgo l.run()\n\treturn l\n}\n\n// Path returns the configured log file path.\nfunc (l *Logger) Path() string {\n\treturn l.path\n}\n\n// Log queues an entry for asynchronous writing. If the buffered channel is full,\n// the entry is written synchronously so no entry is lost. The timestamp is set\n// here so callers do not need to populate it.\nfunc (l *Logger) Log(entry Entry) {\n\tif atomic.LoadInt32(&l.stopped) != 0 {\n\t\treturn\n\t}\n\tentry.Ts = time.Now().UTC().Format(time.RFC3339Nano)\n\tselect {\n\tcase l.ch <- entry:\n\tdefault:\n\t\tl.writeLine(entry)\n\t}\n}\n\n// Stop flushes all buffered entries and closes the log file. It is safe to call\n// more than once.\nfunc (l *Logger) Stop() {\n\tl.stopOnce.Do("]
[7897.513748, "i", "func() {\n\t\tatomic.StoreInt32(&l.stopped, 1)\n\t\tclose(l.stop)\n\t\t<-l.done\n\t\tl.mu.Lock()\n\t\tif l.file != nil {\n\t\t\tl.file.Close()\n\t\t\tl.file = nil\n\t\t}\n\t\tl.mu.Unlock()\n\t})\n}\n\nfunc (l *Logger) run() {\n\tfor {\n\t\tselect {\n\t\tcase e := <-l.ch:\n\t\t\tl.writeLine(e)\n\t\tcase <-l.stop:\n\t\t\tl.drain()\n\t\t\tclose(l.done)\n\t\t\treturn\n\t\t}\n\t}\n}\n\nfunc (l *Logger) drain() {\n\tfor {\n\t\tselect {\n\t\tcase e := <-l.ch:\n\t\t\tl.writeLine(e)\n\t\tdefault:\n\t\t\treturn\n\t\t}\n\t}\n}\n\nfunc (l *Logger) writeLine(e Entry) {\n\tb, err := json.Marshal(e)\n\tif err != nil {\n\t\treturn\n\t}\n\tb = append(b, '\\n')\n\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\n\tif l.file == nil {\n\t\tif err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {\n\t\t\treturn\n\t\t}\n\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\n\t\tif err != nil {\n\t\t\treturn\n\t\t}\n\t\tl.file = f\n\t\tif info, err := f.Stat(); err == nil {\n\t\t\tl.size = info.Size()\n\t\t}\n\t}\n\n\t// Rotate before adding a line that would exceed 1 MB. This keeps only one\n\t// backup file, overwriting any existing access.log.1.\n\tif l.size > 0 && l"]
[7897.513864, "o", "cat > internal/accesslog/logger.go <<'EOF'\r\n\u001b[?2004l\r"]
[7897.51395, "i", ".size+int64(len(b)) > maxFileSize {\n\t\tl.rotateLocked()\n\t}\n\n\tn, err := l.file.Write(b)\n\tif err != nil {\n\t\tl.size = 0\n\t\tif l.file != nil {\n\t\t\tl.file.Close()\n\t\t\tl.file = nil\n\t\t}\n\t\treturn\n\t}\n\tl.size += int64(n)\n}\n\nfunc (l *Logger) rotateLocked() {\n\tif l.file != nil {\n\t\tl.file.Close()\n\t\tl.file = nil\n\t}\n\tos.Remove(l.path + \".1\")\n\tif err := os.Rename(l.path, l.path+\".1\"); err != nil {\n\t\t// If rename fails, continue appending to the existing file.\n\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\n\t\tif err == nil {\n\t\t\tl.file = f\n\t\t\tif info, err := f.Stat(); err == nil {\n\t\t\t\tl.size = info.Size()\n\t\t\t}\n\t\t}\n\t\treturn\n\t}\n\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\n\tif err != nil {\n\t\tl.size = 0\n\t\treturn\n\t}\n\tl.file = f\n\tl.size = 0\n}\nEOF\n"]
