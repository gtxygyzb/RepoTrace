[4740.779376, "o", "   253\t\t\t\t\tBytesIn  int64  `json:\"bytes_in\"`\r\n   254\t\t\t\t\tBytesOut int64  `json:\"bytes_out\"`\r\n   255\t\t\t\t} `json:\"connections\"`\r\n   256\t\t\t}\r\n   257\t\t\tif err := json.Unmarshal(data, &resp); err != nil {\r\n   258\t\t\t\tfmt.Fprintf(os.Stderr, \"failed to decode response: %v\\n\", err)\r\n   259\t\t\t\tos.Exit(1)\r\n   260\t\t\t}\r\n"]
[4740.779478, "o", "   261\t\t\tfmt.Printf(\"%-18s %-18s %-9s %-9s %-10s %-10s\\n\", \"ENDPOINT\", \"CLIENT\", \"AGE_MS\", \"IDLE_MS\", \"BYTES_IN\", \"BYTES_OUT\")\r\n   262\t\t\tfor _, c := range resp.Connections {\r\n   263\t\t\t\tfmt.Printf(\"%-18s %-18s %-9d %-9d %-10d %-10d\\n\", c.Endpoint, c.Client, c.AgeMs, c.IdleMs, c.BytesIn, c.BytesOut)\r\n   264\t\t\t}\r\n   265\t\tcase \"get_rate_limit_status\":\r\n   266\t\t\tvar st struct {\r\n   267\t\t\t\tTokensAvailable float64 `json:\"tokens_available\"`\r\n   268\t\t\t\tQueueDepth      int     `json:\"queue_depth\"`\r\n   269\t\t\t\tRateLimited     int     `json:\"rate_limited\"`\r\n   270\t\t\t\tQueued          int     `json:\"queued\"`\r\n   271\t\t\t\tQueueTimeouts   int     `json:\"queue_timeouts\"`\r\n   272\t\t\t\tRps             float64 `json:\"rps\"`\r\n"]
[4740.779534, "o", "   273\t\t\t\tBurst           float64 `json:\"burst\"`\r\n   274\t\t\t}\r\n   275\t\t\tif err := json.Unmarshal(data, &st); err != nil {\r\n   276\t\t\t\treturn \"\", err\r\n   277\t\t\t}\r\n   278\t\t\tvar b strings.Builder\r\n   279\t\t\tfmt.Fprintf(&b, \"%-10s %-6s %-7s %-10s %-8s %-14s %-15s\\n\", \"SERVICE\", \"RPS\", \"BURST\", \"TOKENS\", \"QUEUED\", \"RATE_LIMITED\", \"QUEUE_TIMEOUTS\")\r\n   280\t\t\tfmt.Fprintf(&b, \"%-10s %-6.0f %-7.0f %-10.2f %-8d %-14d %-15d\\n\", os.Args[2], st.Rps, st.Burst, st.TokensAvailable, st.QueueDepth, st.RateLimited, st.QueueTimeouts)\r\n"]
[4740.779576, "o", "   281\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   282\t\tdefault:\r\n   283\t\t\tvar v interface{}\r\n   284\t\t\tif err := json.Unmarshal(data, &v); err != nil {\r\n   285\t\t\t\treturn \"\", err\r\n   286\t\t\t}\r\n   287"]
