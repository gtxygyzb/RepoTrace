[1991.867754, "o", "port     int\r\n    16\t\tlistener net.Listener\r\n    17\t\tstop     chan struct{}\r\n    18\t\twg       sync.WaitGroup\r\n    19\t\tdone     chan struct{}\r\n    20\t}\r\n    21\t\r\n    22\ttype Router struct {\r\n    23\t\tstate     *state.State\r\n    24\t\tmu        sync.Mutex\r\n    25\t\tlisteners map[string]*serviceListener\r\n    26\t}\r\n    27\t\r\n    28\t"]
[1991.867831, "o", "func NewRouter(s *state.State) *Router {\r\n    29\t\treturn &Router{\r\n    30\t\t\tstate:     s,\r\n    31\t\t\tlisteners: make(map[string]*serviceListener),\r\n    32\t\t}\r\n    33\t}\r\n    34\t\r\n    35\tfunc (r *Router) Start() {\r\n    36\t\tfor _, ss := range r.state.Services() {\r\n    37\t\t\tif !ss.IsStopping() {\r\n"]
[1991.867902, "o", "    38\t\t\t\tr.startService(ss)\r\n    39\t\t\t}\r\n    40\t\t}\r\n    41\t}\r\n    42\t\r\n    43\tfunc (r *Router) Reload() {\r\n    44\t\tservices := r.state.Services()\r\n    45\t\tseen := make(map[string]bool)\r\n    46\t\tfor _, ss := range services {\r\n    47\t\t\tseen[ss.Name] = true\r\n"]
[1991.867969, "o", "    48\t\t\tr.mu.Lock()\r\n    49\t\t\tsl, ok := r.listeners[ss.Name]\r\n    50\t\t\tr.mu.Unlock()\r\n    51\t\t\tif !ok {\r\n    52\t\t\t\tif !ss.IsStopping() {\r\n    53\t\t\t\t\tr.startService(ss)\r\n    54\t\t\t\t}\r\n    55\t\t\t\tcontinue\r\n"]
[1991.868038, "o", "    56\t\t\t}\r\n    57\t\t\tif sl.port != ss.ListenPort {\r\n    58\t\t\t\tr.stopService(ss.Name, true)\r\n    59\t\t\t\tr.startService(ss)\r\n    60\t\t\t}\r\n    61\t\t}\r\n    62\t\tr.mu.Lock()\r\n    63\t\tfor name := range r.listeners {\r\n    64\t\t\tif !seen[name] {\r\n"]
[1991.868116, "o", "    65\t\t\t\tr.mu.Unlock()\r\n    66\t\t\t\tr.stopService(name, true)\r\n    67\t\t\t\tr.mu.Lock()\r\n    68\t\t\t}\r\n    69\t\t}\r\n    70\t\tr.mu.Unlock()\r\n    71\t}\r\n    72\t\r\n    73\tfunc (r *Router) startService(ss *state.ServiceState) {\r\n    74\t\taddr := \":\" + intToStr(ss.ListenPort)\r\n    75\t\tln, err := net.Listen(\"tcp\", addr)\r\n    76\t\tif err != nil {\r\n    77\t"]
[1991.868188, "o", "\t\tlog.Printf(\"router: listen %s on %s failed: %v\", ss.Name, addr, err)\r\n    78\t\t\treturn\r\n    79\t\t}\r\n    80\t\tsl := &serviceListener{\r\n    81\t\t\tservice:  ss.Name,\r\n    82\t\t\tport:     ss.ListenPort,\r\n    83\t\t\tlistener: ln,\r\n    84\t\t\tstop:     make(chan struct{}),\r\n    85\t\t\tdone:     make(chan struct{}),\r\n    86\t\t}\r\n"]
[1991.868257, "o", "    87\t\tr.mu.Lock()\r\n    88\t\tr.listeners[ss.Name] = sl\r\n    89\t\tr.mu.Unlock()\r\n    90\t\tgo sl.acceptLoop(r)\r\n    91\t}\r\n    92\t\r\n    93\tfunc (r *Router) stopService(name string, drain bool) {\r\n    94\t\tr.mu.Lock()\r\n    95\t\tsl, ok := r.listeners[name]"]
[1991.868332, "o", "\r\n    96\t\tif ok {\r\n    97\t\t\tdelete(r.listeners, name)\r\n    98\t\t}\r\n    99\t\tr.mu.Unlock()\r\n   100\t\tif !ok {\r\n   101\t\t\treturn\r\n   102\t\t}\r\n   103\t\tsl.stopAccept(drain, r)\r\n   104\t}\r\n   105\t\r\n   106\tfunc (r *Router) Stop() {\r\n   107\t"]
[1991.868436, "o", "\tr.mu.Lock()\r\n   108\t\tlisteners := r.listeners\r\n   109\t\tr.listeners = make(map[string]*serviceListener)\r\n   110\t\tr.mu.Unlock()\r\n   111\t\tvar wg sync.WaitGroup\r\n   112\t\tfor name, sl := range listeners {\r\n   113\t\t\twg.Add(1)\r\n   114\t\t\tgo func(name string, sl *serviceListener) {\r\n   115\t\t\t\tdefer wg.Done()\r\n   116\t\t\t\tsl.stopAccept(true, r)\r\n   117\t\t\t}(name, sl)\r\n   118\t\t}"]
[1991.868509, "o", "\r\n   119\t\twg.Wait()\r\n   120\t}\r\n   121\t\r\n   122\tfunc (sl *serviceListener) acceptLoop(r *Router) {\r\n   123\t\tdefer close(sl.done)\r\n   124\t\tfor {\r\n   125\t\t\tconn, err := sl.listener.Accept()\r\n   126\t\t\tif err != nil {\r\n   127\t\t\t\treturn\r\n   128\t\t\t}\r\n"]
[1991.868576, "o", "   129\t\t\tsl.wg.Add(1)\r\n   130\t\t\tgo func(c net.Conn) {\r\n   131\t\t\t\tdefer sl.wg.Done()\r\n   132\t\t\t\tr.handleConn(sl.service, c)\r\n   133\t\t\t}(conn)\r\n   134\t\t}\r\n   135\t}\r\n   136\t\r\n   137\tfunc (sl *serviceListener) stopAccept(drain bool, r *Router) {\r\n   138\t\tselect {\r\n   139\t"]
[1991.868647, "o", "\tcase <-sl.stop:\r\n   140\t\tdefault:\r\n   141\t\t\tclose(sl.stop)\r\n   142\t\t}\r\n   143\t\tsl.listener.Close()\r\n"]
[1991.868718, "o", "   144\t\t<-sl.done\r\n   145\t\tif drain {\r\n   146\t\t\tss := r.state.GetService(sl.service)\r\n   147\t\t\ttimeout := 5 * time.Second\r\n   148\t\t\tif ss != nil {\r\n   149\t\t\t\ttimeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n   150\t\t\t\tif timeout <= 0 {\r\n   151\t\t\t\t\ttimeout = 5 * time.Second\r\n   152\t\t\t\t}\r\n   153\t\t\t}\r\n   154\t\t\tdone := make(chan struct{})\r\n   155\t\t\tgo func() {\r\n   156\t\t\t\tsl.wg.Wait()\r\n   157\t\t\t\tclose(done)\r\n   158\t\t\t}()\r\n   159\t\t\tselect {\r\n   160"]
[1991.868788, "o", "\t\t\tcase <-done:\r\n   161\t\t\tcase <-time.After(timeout):\r\n   162\t\t\t\tr.state.CloseServiceConnections(sl.service)\r\n   163\t\t\t\t<-done\r\n   164\t\t\t}\r\n   165\t\t} else {\r\n   166\t\t\tsl.wg.Wait()\r\n   167\t\t}\r\n   168\t}\r\n   169\t\r\n"]
[1991.86886, "o", "   170\tfunc (r *Router) handleConn(service string, client net.Conn) {\r\n   171\t\tstart := time.Now()\r\n   172\t\tres, err := r.state.SelectEndpoint(service)\r\n   173\t\tif err != nil {\r\n   174\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   175\t\t\t\tss := r.state.GetService(service)\r\n   176\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n   177\t\t\t\t\tcand.Stats.RecordRejection()\r\n   178\t\t\t\t}\r\n   179\t\t\t}\r\n"]
[1991.868904, "o", "   180\t\t\tclient.Close()\r\n   181\t\t\treturn\r\n   182\t\t}\r\n   183\t\tep := res.Endpoint\r\n   184\t\r\n   185\t\tvar id int64\r\n"]
[1991.86899, "o", "   186\t\tif !res.Probe {\r\n   187\t\t\tvar ok bool\r\n   188\t\t\tid, ok = ep.TryAddConnection(client, res.MaxConns)\r\n   189\t\t\tif !ok {\r\n   190\t\t\t\tep.Stats.RecordRejection()\r\n   191\t\t\t\tclient.Close()\r\n   192\t\t\t\treturn\r\n   193\t\t\t}\r\n   194\t\t}\r\n   195\t\r\n   196\t\tbackend, err := net.Dial(\"tcp\", ep.Address)\r\n   197\t\tif err != nil {\r\n"]
[1991.869061, "o", "   198\t\t\tif id != 0 {\r\n   199\t\t\t\tep.RemoveConnection(id)\r\n   200\t\t\t}\r\n   201\t\t\tep.Stats.RecordConnection(0, 0, time.Since(start), true)\r\n   202\t\t\tif res.Probe {\r\n   203\t\t\t\tep.Circuit.ProbeFailure()\r\n   204\t\t\t}\r\n   205\t\t\tclient.Close()\r\n   206\t\t\treturn\r\n   207\t\t}\r\n   208\t\r\n"]
[1991.869133, "o", "   209\t\tif res.Probe {\r\n   210\t\t\tep.Circuit.ProbeSuccess()\r\n   211\t\t\tvar ok bool\r\n   212\t\t\tid, ok = ep.TryAddConnection(client, res.MaxConns)\r\n"]
[1991.8692, "o", "   213\t\t\tif !ok {\r\n   214\t\t\t\tep.Stats.RecordRejection()\r\n   215\t\t\t\tbackend.Close()\r\n   216\t\t\t\tclient.Close()\r\n   217\t\t\t\treturn\r\n   218\t\t\t}\r\n   219\t\t}\r\n   220\t\r\n"]
