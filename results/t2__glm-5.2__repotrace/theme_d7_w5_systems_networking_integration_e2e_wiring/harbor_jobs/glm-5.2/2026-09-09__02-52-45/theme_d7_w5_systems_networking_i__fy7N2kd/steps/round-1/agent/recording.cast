[600.417284, "o", "sed -n '1,40p' internal/state/state.go\r\n\u001b[?2004l\r"]
[600.420304, "o", "package state\r\n\r\nimport (\r\n    \"net\"\r\n    \"sync\"\r\n"]
[600.420437, "o", "    \"sync/atomic\"\r\n    \"time\"\r\n\r\n    \"meshrouter/internal/circuit\"\r\n    \"meshrouter/internal/config\"\r\n    \"meshrouter/internal/stats\"\r\n)\r\n\r\ntype HealthState string\r\n\r\nconst (\r\n    Unknown   HealthState = \"unknown\"\r\n    Healthy   HealthState = \"healthy\"\r\n    Unhealthy HealthState = \"unhealthy\"\r\n    Draining  HealthState = \"draining\"\r\n)\r\n\r\ntype HealthEvent struct {\r\n    Timestamp   time.Time\r\n    Endpoint    string\r\n    OldState    HealthState\r\n    NewState    HealthState\r\n    CheckResult string\r\n}\r\n\r\ntype EndpointState struct {\r\n    mu                  sync.Mutex\r\n    Address             string\r\n    Weight              int\r\n"]
[600.420508, "o", "    Config              config.Endpoint\r\n    State               HealthState\r\n    ActiveConnections  int\r\n    Circuit            *circuit.Breaker\r\n    Stats              *stats.Collector\r\n    consecSuccess      int\r\n"]
[600.421043, "o", "\u001b[?2004h"]
[600.421111, "o", "root@n30009:/app# "]
[600.421338, "o", "sed -n '80,140p' internal/state/state.go\r\n\u001b[?2004l\r"]
[600.424312, "o", "    return s\r\n}\r\n\r\nfunc (s *State) ReloadChan() <-chan struct{} {\r\n    return s.reloadCh\r\n}\r\n\r\n"]
[600.424403, "o", "func (s *State) ConfigPath() string {\r\n    s.mu.RLock()\r\n    defer s.mu.RUnlock()\r\n    return s.configPath\r\n}\r\n\r\nfunc (s *State) Global() config.Global {\r\n    s.mu.RLock()\r\n"]
[600.424466, "o", "    defer s.mu.RUnlock()\r\n    return s.global\r\n}\r\n\r\nfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n    s.mu.Lock()\r\n    defer s.mu.Unlock()\r\n    s.applyConfigLocked(cfg)\r\n    select {\r\n    case s.reloadCh <- struct{}{}:\r\n    default:\r\n    }\r\n}\r\n\r\nfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n    s.global = cfg.Global\r\n    seen := make(map[string]bool)\r\n    for _, svc := range cfg.Services {\r\n        seen[svc.Name] = true\r\n        ss := s.services[svc.Name]\r\n        if ss == nil {\r\n            ss = newServiceState(svc)\r\n            s.services[svc.Name] = ss\r\n"]
[600.424525, "o", "        } else {\r\n            ss.mu.Lock()\r\n            ss.Name = svc.Name\r\n            ss.ListenPort = svc.ListenPort\r\n            ss.RoutingMode = svc.RoutingMode\r\n            ss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n            ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n            ss.mu.Unlock()\r\n            ss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n        }\r\n    }\r\n    for name, ss := range s.services {\r\n        if !seen[name] {\r\n"]
[600.424578, "o", "            ss.mu.Lock()\r\n            ss.stopping = true\r\n            if ss.listenerStop != nil {\r\n                close(ss.listenerStop)\r\n                ss.listenerStop = nil\r\n            }\r\n            if ss.Listener != nil {\r\n                ss.Listener.Close()\r\n                ss.Listener = nil\r\n            }\r\n"]
[600.425106, "o", "\u001b[?2004h"]
[600.425182, "o", "root@n30009:/app# "]
[600.425239, "o", "go build ./...\r\n\u001b[?2004l\r"]
[604.31321, "o", "\u001b[?2004hroot@n30009:/app# "]
[689.388676, "i", "cat > internal/health/monitor.go <<'EOF'\npackage health\n\nimport (\n    \"context\"\n    \"fmt\"\n    \"io\"\n    \"net\"\n    \"net/http\"\n    \"os/exec\"\n    \"strings\"\n    \"sync\"\n    \"time\"\n\n    \"meshrouter/internal/config\"\n    \"meshrouter/internal/state\"\n)\n\ntype worker struct {\n    cancel context.CancelFunc\n    done   chan struct{}\n}\n\ntype Monitor struct {\n    state *state.State\n    mu    sync.Mutex\n    cur   *config.Config\n    stop  chan struct{}\n    workers map[string]*worker\n}\n\nfunc NewMonitor(s *state.State, cfg *config.Config) *Monitor {\n    return &Monitor{\n        state:   s,\n        cur:     cfg,\n        stop:    make(chan struct{}),\n        workers: make(map[string]*worker),\n    }\n}\n\nfunc (m *Monitor) Start() {\n    m.mu.Lock()\n    cfg := m.cur\n    m.mu.Unlock()\n    m.startWorkers(cfg)\n}\n\nfunc (m *Monitor) ApplyConfig(cfg *config.Config) {\n    m.mu.Lock()\n    m.cur = cfg\n    m.mu.Unlock()\n    m.stopWorkers()\n    m.startWorkers(cfg)\n}\n\nfunc (m *Monitor) Stop() {\n    close(m.stop)\n    m.stopWorkers()\n}\n\nfunc (m *Monit"]
[689.389068, "i", "or) startWorkers(cfg *config.Config) {\n    for _, svc := range cfg.Services {\n        for _, ep := range svc.Endpoints {\n            key := svc.Name + \"|\" + ep.Address\n            ctx, cancel := context.WithCancel(context.Background())\n            w := &worker{cancel: cancel, done: make(chan struct{})}\n            m.mu.Lock()\n            m.workers[key] = w\n            m.mu.Unlock()\n            go m.run(ctx, cfg, svc.Name, ep, w.done)\n        }\n    }\n}\n\nfunc (m *Monitor) stopWorkers() {\n    m.mu.Lock()\n    workers := m.workers\n    m.workers = make(map[string]*worker)\n    m.mu.Unlock()\n    for _, w := range workers {\n        w.cancel()\n        <-w.done\n    }\n}\n\nfunc (m *Monitor) run(ctx context.Context, cfg *config.Config, service string, ep config.Endpoint, done chan struct{}) {\n    defer close(done)\n    interval := time.Duration(cfg.Global.HealthIntervalMs) * time.Millisecond\n    if interval <= 0 {\n        interval = 2 * time.Second\n    }\n    ticker := time.NewTicker(interval)\n    defer ticker.Stop()\n    for "]
