[11724.446475, "o", "'''func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n\u001b[?2004l\r"]
[11724.44654, "o", "\u001b[?2004h> "]
[11724.446823, "o", "        rawArgs, err := json.Marshal(args)\r\n\u001b[?2004l\r"]
[11724.446883, "o", "\u001b[?2004h> "]
[11724.44704, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11724.447095, "o", "\u001b[?2004h> "]
[11724.447292, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11724.447358, "o", "\u001b[?2004h> "]
[11724.447446, "o", "        }\r\n\u001b[?2004l\r"]
[11724.447506, "o", "\u001b[?2004h> "]
[11724.447824, "o", "        req := request{Cmd: ipcCmd, Args: rawArgs}\r\n\u001b[?2004l\r"]
[11724.447882, "o", "\u001b[?2004h> "]
[11724.44816, "o", "        reqBytes, err := json.Marshal(req)\r\n\u001b[?2004l\r"]
[11724.448216, "o", "\u001b[?2004h> "]
[11724.448372, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11724.448441, "o", "\u001b[?2004h> "]
[11724.448652, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11724.448708, "o", "\u001b[?2004h> "]
[11724.448777, "o", "        }\r\n\u001b[?2004l\r"]
[11724.44883, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11724.448885, "o", "\u001b[?2004h> "]
[11724.449257, "o", "        conn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\u001b[?2004l\r"]
[11724.449325, "o", "\u001b[?2004h> "]
[11724.449483, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11724.449544, "o", "\u001b[?2004h> "]
[11724.450062, "o", "                return \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n\u001b[?2004l\r"]
[11724.450119, "o", "\u001b[?2004h> "]
[11724.450188, "o", "        }\r\n\u001b[?2004l\r"]
[11724.450241, "o", "\u001b[?2004h> "]
[11724.450446, "o", "        defer conn.Close()\r\n\u001b[?2004l\r"]
[11724.45051, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11724.450572, "o", "\u001b[?2004h> "]
[11724.4509, "o", "        fmt.Fprintf(conn, \"%s\\\\n\", string(reqBytes))\r\n\u001b[?2004l\r"]
[11724.450955, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11724.451037, "o", "\u001b[?2004h> "]
[11724.451268, "o", "        reader := bufio.NewReader(conn)\r\n\u001b[?2004l\r"]
[11724.451329, "o", "\u001b[?2004h> "]
[11724.451637, "o", "        line, err := reader.ReadString('\\\\n')\r\n\u001b[?2004l\r"]
[11724.451694, "o", "\u001b[?2004h> "]
[11724.451847, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11724.451902, "o", "\u001b[?2004h> "]
[11724.452109, "o", "                return \"\", err\r\n\u001b[?2004l\r"]
[11724.452163, "o", "\u001b[?2004h> "]
[11724.452233, "o", "        }\r\n\u001b[?2004l\r"]
[11724.452293, "o", "\u001b[?2004h> "]
[11724.45264, "o", "        line = strings.TrimRight(line, \"\\\\r\\\\n\")\r\n\u001b[?2004l\r"]
[11724.452709, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11724.452768, "o", "\u001b[?2004h> "]
[11724.452918, "o", "        var resp response\r\n\u001b[?2004l\r"]
[11724.452984, "o", "\u001b[?2004h> "]
[11724.45343, "o", "        if err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n\u001b[?2004l\r"]
