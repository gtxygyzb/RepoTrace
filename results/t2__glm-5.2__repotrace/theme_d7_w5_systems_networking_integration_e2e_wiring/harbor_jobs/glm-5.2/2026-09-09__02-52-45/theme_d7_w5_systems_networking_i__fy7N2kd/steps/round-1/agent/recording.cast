[7470.961903, "o", "    81\t\r\n    82\tfunc (s *Server) handleConn(conn net.Conn) {\r\n    83\t\tdefer s.wg.Done()\r\n    84\t\tdefer conn.Close()\r\n    85\t\treader := bufio.NewReader(conn)\r\n    86\t\tfor {\r\n    87\t\t\tline, err := reader.ReadString('\\n')\r\n    88\t\t\tif err != nil {\r\n    89\t\t\t\treturn\r\n    90\t\t\t}\r\n    91\t\t\tline = strings.TrimRight(line, \"\\r\\n\")\r\n    92\t\t\tif line == \"\" {\r\n    93\t\t\t\tcontinue\r\n    94\t\t\t}\r\n    95\t\t\tresp := s.handleLine(line)\r\n    96\t\t\t_, _ = conn.Write([]byte(resp + \"\\n\"))\r\n    97\t\t}\r\n    98\t}\r\n    99\t\r\n   100\tfunc (s *Server) handleLine(line string) string {\r\n   101\t\tvar req Request\r\n   102\t\tif err := json.Unmarshal([]byte(line), &req); err != nil {\r\n   103\t\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n   104\t\t}\r\n   105\t\tdata, err := s.dispatch(req)\r\n   106\t\tif err != nil {\r\n   107\t\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n   108\t"]
[7470.962044, "o", "\t}\r\n   109\t\treturn encodeResp(Response{Status: \"ok\", Data: data})\r\n   110\t}\r\n   111\t\r\n   112\tfunc encodeResp(r Response) string {\r\n   113\t\tb, _ := json.Marshal(r)\r\n   114\t\treturn string(b)\r\n   115\t}\r\n   116\t\r\n   117\tfunc (s *Server) dispatch(req Request) (interface{}, error) {\r\n   118\t\tswitch req.Cmd {\r\n   119\t\tcase \"list_services\":\r\n   120\t\t\treturn s.state.ServicesView(), nil\r\n   121\t\tcase \"get_service\":\r\n   122\t\t\tvar args struct {\r\n   123\t\t\t\tName string `json:\"name\"`\r\n   124\t\t\t}\r\n   125\t\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n   126\t\t\t\treturn nil, err\r\n   127\t\t\t}\r\n   128\t\t\tsv, ok := s.state.ServiceView(args.Name)\r\n   129\t\t\tif !ok {\r\n   130\t\t\t\treturn nil, errors.New(\"service not found\")\r\n   131\t\t\t}\r\n   132\t\t\treturn sv, nil\r\n   133\t\tcase \"get_warmup_status\":\r\n   134\t\t\tvar args struct {\r\n   135\t\t\t\tName string `json:\"name\"`\r\n   136\t\t\t}\r\n   137\t\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n   138\t\t\t\treturn nil, err\r\n   139\t\t\t}\r\n   140\t\t\tsv, ok := s.state.WarmupStatusView(args.Name"]
[7470.962141, "o", ")\r\n   141\t\t\tif !ok {\r\n   142\t\t\t\treturn nil, errors.New(\"service not found\")\r\n   143\t\t\t}\r\n   144\t\t\treturn sv, nil\r\n   145\t\tcase \"get_stats\":\r\n   146\t\t\tvar args struct {\r\n   147\t\t\t\tName string `json:\"name\"`\r\n   148\t\t\t}\r\n   149\t\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n   150\t\t\t\treturn nil, err\r\n   151\t\t\t}\r\n   152\t\t\tg := s.state.Global()\r\n   153\t\t\tsv, ok := s.state.StatsView(args.Name, g.StatsWindowSec)\r\n   154\t\t\tif !ok {\r\n   155\t\t\t\treturn nil, errors.New(\"service not found\")\r\n   156\t\t\t}\r\n   157\t\t\treturn sv, nil\r\n   158\t\tcase \"set_weight\":\r\n   159\t\t\tvar args struct {\r\n   160\t\t\t\tName    string `json:\"name\"`\r\n"]
