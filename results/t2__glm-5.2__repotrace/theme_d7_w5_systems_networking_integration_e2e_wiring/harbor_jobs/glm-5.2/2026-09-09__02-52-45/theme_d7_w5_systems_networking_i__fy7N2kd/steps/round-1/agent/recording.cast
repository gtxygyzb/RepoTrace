[2557.86709, "o", "\u001b[?2004h> "]
[2557.867634, "o", "old2 = '''\\tcase \"set_weight\", \"drain_endpoint\", \"reset_circuit_breaker\", \"reload_config\":'''\r\n\u001b[?2004l\r"]
[2557.867692, "o", "\u001b[?2004h> "]
[2557.868308, "o", "new2 = '''\\tcase \"set_weight\", \"drain_endpoint\", \"reset_circuit_breaker\", \"reload_config\", \"set_rate_limit\":'''\r\n\u001b[?2004l\r"]
