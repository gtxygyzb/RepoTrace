[9967.99454, "o", "// RecordQueueTimeout records a queue timeout rejection.\r\nfunc (c *Collector) RecordQueueTimeout() {\r\n\tc.mu.Lock()\r\n\tdefer c.mu.Unlock()\r\n\tc.queueTimeouts++\r\n\tc.rateLimited++\r\n}\r\n\r\n"]
[9967.995086, "o", "\u001b[?2004h"]
[9967.995167, "o", "root@n30009:/app# "]
[9968.303919, "i", "sed -n '112,124p' internal/state/ratelimit.go\n"]
