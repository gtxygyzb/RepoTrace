[10660.678353, "o", "c.idleTimeouts++\r\n    98\t}\r\n    99\t\r\n   100\tfunc (c *Collector) trim(now time.Time) {\r\n   101\t\tcutoff := now.Add(-c.window)\r\n   102\t\ti := 0\r\n   103\t\tfor i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {\r\n   104\t\t\ti++\r\n   105\t\t}\r\n   106\t"]
