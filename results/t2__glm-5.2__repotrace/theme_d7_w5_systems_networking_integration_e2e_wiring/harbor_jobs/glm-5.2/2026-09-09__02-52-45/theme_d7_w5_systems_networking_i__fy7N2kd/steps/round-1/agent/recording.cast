[4131.01947, "o", "    96\t\tss.mu.Unlock()\r\n    97\t\treturn sv, true\r\n    98\t}\r\n    99\t\r\n   100\ttype HealthEventView struct {\r\n   101\t\tTimestamp   time.Time `json:\"timestamp\"`\r\n   102\t\tEndpoint    string    `json:\"endpoint\"`\r\n   103\t\tOldState    string    `json:\"old_state\"`\r\n   104\t\tNewState    string    `json:\"new_state\"`\r\n"]
[4131.019484, "o", "   105\t\tCheckResult string    `json:\"check_result\"`\r\n   106\t}\r\n   107\t\r\n"]
[4131.019548, "o", "   108\tfunc (s *State) HealthLogView(name string, lastN int) []HealthEventView {\r\n   109\t\tevents := s.HealthLog(name, lastN)\r\n   110\t\tout := make([]HealthEventView, 0, len(events))\r\n   111\t\tfor _, e := range events {\r\n   112\t\t\tout = append(out, HealthEventView{\r\n   113\t\t\t\tTimestamp:   e.Timestamp,\r\n   114\t\t\t\tEndpoint:    e.Endpoint,\r\n   115\t"]
