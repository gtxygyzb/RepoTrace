[6848.718158, "o", "   209\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n   210\t\tcopy(endpoints, ss.Endpoints)\r\n   211\t\tss.mu.Unlock()\r\n   212\t\r\n   213\t\tvar regular []*EndpointState\r\n   214\t\tfor _, ep := range endpoints {\r\n   215\t\t\tif ep.IsEligible(maxConns) {\r\n   216\t\t\t\tregular = append(regular, ep)\r\n   217\t\t\t}\r\n   218\t\t}\r\n   219\t\r\n   220\t\tif len(regular) > 0 {\r\n   221\t\t\tif mode == \"least-connections\" {\r\n   222\t\t\t\tep := selectLeastConnections(regular, maxConns)\r\n   223\t\t\t\treturn ep.Address, nil\r\n   224\t\t\t}\r\n   225\t\t\tvar best *EndpointState\r\n   226\t\t\tvar bestWeight int\r\n   227\t\t\tfor _, ep := range regular {\r\n   228\t\t\t\tep.mu.Lock()\r\n   229\t\t\t\tcw := ep.currentWeight + ep.Weight\r\n   230\t\t\t\tep.mu.Unlock()\r\n   231\t\t\t\tif best == nil || cw > bestWeight {\r\n"]
[6848.718247, "o", "   232\t\t\t\t\tbest = ep\r\n   233\t\t\t\t\tbestWeight = cw\r\n   234\t\t\t\t}\r\n   235\t\t\t}\r\n"]
