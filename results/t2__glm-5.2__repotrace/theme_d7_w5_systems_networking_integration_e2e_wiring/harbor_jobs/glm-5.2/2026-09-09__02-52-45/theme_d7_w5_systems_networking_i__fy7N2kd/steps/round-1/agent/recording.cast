[7897.531141, "o", "\u001b[?2004h> "]
[7897.531208, "o", "\u0007select {\r\n\u001b[?2004l\r"]
[7897.531272, "o", "\u001b[?2004h> "]
[7897.531341, "o", "\u0007"]
[7897.531419, "o", "case l.ch <- entry:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7897.531496, "o", "\u0007"]
[7897.53156, "o", "default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[7897.531615, "o", "\u0007"]
[7897.531677, "o", "\r\n"]
