[7897.794783, "i", "cat > internal/accesslog/query.go <<'EOF'\npackage accesslog\n\nimport (\n\t\"bufio\"\n\t\"encoding/json\"\n\t\"os\"\n)\n\n// Stats holds aggregated access log statistics for one result type.\ntype Stats struct {\n\tCount         int   `json:\"count\"`\n\tAvgDurationMs int64 `json:\"avg_duration_ms\"`\n\tTotalBytesIn  int64 `json:\"total_bytes_in\"`\n\tTotalBytesOut int64 `json:\"total_bytes_out\"`\n}\n\n// StatsResult is the response shape for get_access_stats.\ntype StatsResult struct {\n\tTotalRequests int              `json:\"total_requests\"`\n\tByResult      map[string]Stats `json:\"by_result\"`\n}\n\n// ReadEntries reads and parses log entries from the backup file plus the\n// current log file, in chronological order. Invalid lines are skipped.\nfunc ReadEntries(path string) []Entry {\n\tvar entries []Entry\n\tentries = append(entries, readLogFile(path+\".1\")...)\n\tentries = append(entries, readLogFile(path)...)\n\treturn entries\n}\n\nfunc readLogFile(path string) []Entry {\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn nil\n\t}\n\tdefer f.Close()\n\n\tvar entries ["]
[7897.794984, "i", "]Entry\n\tscanner := bufio.NewScanner(f)\n\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\n\tfor scanner.Scan() {\n\t\tline := scanner.Bytes()\n\t\tif len(line) == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tvar e Entry\n\t\tif err := json.Unmarshal(line, &e); err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, e)\n\t}\n\treturn entries\n}\n\n// GetAccessLog returns filtered log entries. Filters are applied first, then the\n// last lastN entries are returned. If lastN is 0 or negative, all matching\n// entries are returned.\nfunc GetAccessLog(path, service, result string, lastN int, minDurationMs int64) []Entry {\n\tentries := ReadEntries(path)\n\n\tfiltered := entries[:0]\n\tfor _, e := range entries {\n\t\tif service != \"\" && e.Service != service {\n\t\t\tcontinue\n\t\t}\n\t\tif result != \"\" && e.Result != result {\n\t\t\tcontinue\n\t\t}\n\t\tif minDurationMs > 0 && e.DurationMs < minDurationMs {\n\t\t\tcontinue\n\t\t}\n\t\tfiltered = append(filtered, e)\n\t}\n\n\tif lastN <= 0 {\n\t\treturn filtered\n\t}\n\tif len(filtered) > lastN {\n\t\treturn filtered[len(filtered)-lastN:]\n\t}\n\treturn filtered\n"]
[7897.795102, "i", "}\n\n// Stats aggregates access log entries for the optional service filter.\nfunc Stats(path, service string) StatsResult {\n\tentries := ReadEntries(path)\n\n\ttype agg struct {\n\t\tcount    int\n\t\tduration int64\n\t\tbytesIn  int64\n\t\tbytesOut int64\n\t}\n\taggs := make(map[string]*agg)\n\ttotal := 0\n\n\tfor _, e := range entries {\n\t\tif service != \"\" && e.Service != service {\n\t\t\tcontinue\n\t\t}\n\t\ta := aggs[e.Result]\n\t\tif a == nil {\n\t\t\ta = &agg{}\n\t\t\taggs[e.Result] = a\n\t\t}\n\t\ta.count++\n\t\ta.duration += e.DurationMs\n\t\ta.bytesIn += e.BytesIn\n\t\ta.bytesOut += e.BytesOut\n\t\ttotal++\n\t}\n\n\tresult := StatsResult{\n\t\tTotalRequests: total,\n\t\tByResult:      make(map[string]Stats),\n\t}\n\tfor name, a := range aggs {\n\t\tif a.count == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tresult.ByResult[name] = Stats{\n\t\t\tCount:         a.count,\n\t\t\tAvgDurationMs: a.duration / int64(a.count),\n\t\t\tTotalBytesIn:  a.bytesIn,\n\t\t\tTotalBytesOut: a.bytesOut,\n\t\t}\n\t}\n\treturn result\n}\nEOF\n"]
