[2931.450594, "i", "cat >> internal/state/routing.go <<'EOF'\n\n// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\nfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\n\tres, err := s.SelectEndpoint(service)\n\tif err != nil {\n\t\treturn res, err\n\t}\n\tif exclude == nil || res.Endpoint != exclude {\n\t\treturn res, nil\n\t}\n\tfor i := 0; i < len(res.Endpoint.Address)+1; i++ {\n\t\talt, aerr := s.SelectEndpoint(service)\n\t\tif aerr != nil {\n\t\t\treturn res, nil\n\t\t}\n\t\tif alt.Endpoint != exclude {\n\t\t\treturn alt, nil\n\t\t}\n\t}\n\treturn res, nil\n}\nEOF\ngofmt -w internal/state/routing.go\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/router/router.go')\ns = p.read_text()\ns = s.replace('\\t\\tres, err := r.state.SelectEndpoint(service)\\n\\t\\tif err != nil {', '\\t\\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\\n\\t\\tif err != nil {', 1)\ns = s.replace('\\t\\tif attempt > 0 && res.Endpoint == lastEndpoint {\\n\\t\\t\\t// Avoid using the same endpoint co"]
[2931.450927, "i", "nsecutively when possible.\\n\\t\\t\\talt, aerr := r.state.SelectEndpoint(service)\\n\\t\\t\\tif aerr == nil && alt.Endpoint != lastEndpoint {\\n\\t\\t\\t\\tres = alt\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tlastEndpoint = res.Endpoint\\n', '\\t\\tlastEndpoint = res.Endpoint\\n', 1)\nold = '''\\t\\t\\tif res.Probe {\n\\t\\t\\t\\tep.Circuit.ProbeFailure()\n\\t\\t\\t}'''\nnew = '''\\t\\t\\tif res.Probe {\n\\t\\t\\t\\tep.Circuit.ProbeFailure()\n\\t\\t\\t} else {\n\\t\\t\\t\\tep.Circuit.Open()\n\\t\\t\\t}'''\nif old not in s:\n    raise SystemExit('probe failure pattern not found')\ns = s.replace(old, new, 1)\np.write_text(s)\nPY\ngofmt -w internal/router/router.go\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/state/state.go')\ns = p.read_text()\nold = '''\\tss.RateLimitRps = rps\n\\tss.RateLimitBurst = burst'''\nnew = '''\\tss.RateLimitRps = rps\n\\tif burst <= 0 {\n\\t\\tburst = rps\n\\t}\n\\tss.RateLimitBurst = burst'''\nif old not in s:\n    raise SystemExit('SetRateLimit pattern not found')\ns = s.replace(old, new, 1)\np.write_text(s)\nPY\ngofmt -w internal/state/state.go\npython3 - <<'PY'\nfr"]
