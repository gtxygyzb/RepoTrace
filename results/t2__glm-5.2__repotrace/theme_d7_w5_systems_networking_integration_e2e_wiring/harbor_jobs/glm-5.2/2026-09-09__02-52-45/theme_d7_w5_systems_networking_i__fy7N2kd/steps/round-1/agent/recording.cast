[10740.618722, "o", "   279\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9s %-17s %-7s\\n\", \"ENDPOINT\", \"CIRCUIT\", \"FAILURES\", \"TIME_IN_STATE_MS\", \"PROBE\")\r\n   280\t\t\tfor _, c := range circuits {\r\n   281\t\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9d %-17d %-7t\\n\", c.Address, c.CircuitState, c.ConsecutiveFailures, c.TimeInStateMs, c.ProbeActive)\r\n   282\t\t\t}\r\n   283\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   284\t\tcase \"get_warmup_status\":\r\n   285\t\t\tvar resp struct {\r\n   286\t\t\t\tEndpoints []struct {\r\n   287\t"]
[10740.618787, "o", "\t\t\t\tEndpoint          string `json:\"endpoint\"`\r\n   288\t\t\t\t\tWarmingUp         bool   `json:\"warming_up\"`\r\n   289\t\t\t\t\tWarmupRemainingMs int    `json:\"warmup_remaining_ms\"`\r\n   290\t\t\t\t\tEffectiveWeight   int    `json:\"effective_weight\"`\r\n   291\t\t\t\t\tConfigWeight      int    `json:\"config_weight\"`\r\n   292\t\t\t\t} `json:\"endpoints\"`\r\n   293\t\t\t}\r\n   294\t\t\t"]
[10740.618853, "o", "if err := json.Unmarshal(data, &resp); err != nil {\r\n   295\t\t\t\treturn \"\", err\r\n   296\t\t\t}\r\n   297\t\t\tvar b strings.Builder\r\n   298\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-13s %-17s %-13s\\n\", \"ENDPOINT\", \"WARMING_UP\", \"REMAINING_MS\", \"EFFECTIVE_WEIGHT\", \"CONFIG_WEIGHT\")\r\n   299\t\t\tfor _, e := range resp.Endpoints {\r\n   300\t\t\t\tfmt.Fprintf(&b, \"%-18s %-11t %-13d %-17d %-13d\\n\", e.Endpoint, e.WarmingUp, e.WarmupRemainingMs, e.EffectiveWeight, e.ConfigWeight)\r\n   301\t\t\t}\r\n   302\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n"]
[10740.618924, "o", "   303\t\tcase \"set_weight\", \"drain_endpoint\", \"reset_circuit_breaker\", \"reload_config\", \"set_rate_limit\":\r\n   304\t\t\tvar s string\r\n   305\t\t\tif err := json.Unmarshal(data, &s); err != nil {\r\n   306\t\t\t\treturn \"\", err\r\n   307\t\t\t}\r\n   308\t\t\treturn s, nil\r\n   309\t\tcase \"get_connections\":\r\n   310\t\t\tvar resp struct {\r\n   311\t\t\t\tConnections []struct {\r\n"]
[10740.619018, "o", "   312\t\t\t\t\tEndpoint string `json:\"endpoint\"`\r\n   313\t\t\t\t\tClient   string `json:\"client\"`\r\n   314\t\t\t\t\tAgeMs    int64  `json:\"age_ms\"`\r\n   315\t\t\t\t\tIdleMs   int64  `json:\"idle_ms\"`\r\n   316\t\t\t\t\tBytesIn  int64  `json:\"bytes_in\"`\r\n   317\t\t\t\t\tBytesOut int64  `json:\"bytes_out\"`\r\n   318\t\t\t\t} `json:\"connections\"`\r\n   319\t\t\t}\r\n   320\t\t\tif err := json.Unmarshal(data, &resp); err != nil {\r\n   321\t\t\t\tfmt.Fprintf(os.Stderr, \"failed to decode response: %v\\n\", err)\r\n   322\t\t\t\tos.Exit(1)\r\n   323\t\t\t"]
[10740.619078, "o", "}\r\n   324\t\t\tfmt.Printf(\"%-18s %-18s %-9s %-9s %-10s %-10s\\n\", \"ENDPOINT\", \"CLIENT\", \"AGE_MS\", \"IDLE_MS\", \"BYTES_IN\", \"BYTES_OUT\")\r\n   325\t\t\tfor _, c := range resp.Connections {\r\n   326\t\t\t\tfmt.Printf(\"%-18s %-18s %-9d %-9d %-10d %-10d\\n\", c.Endpoint, c.Client, c.AgeMs, c.IdleMs, c.BytesIn, c.BytesOut)\r\n   327\t\t\t}\r\n   328\t\t"]
[10740.619143, "o", "\treturn \"\", nil\r\n   329\t\tcase \"get_access_log\":\r\n   330\t\t\tvar entries []struct {\r\n   331\t\t\t\tTs          string `json:\"ts\"`\r\n   332\t\t\t\tService     string `json:\"service\"`\r\n   333\t\t\t\tClient      string `json:\"client\"`\r\n   334\t\t\t\tEndpoint    string `json:\"endpoint\"`\r\n"]
[10740.619205, "o", "   335\t\t\t\tBytesIn     int64  `json:\"bytes_in\"`\r\n   336\t\t\t\tBytesOut    int64  `json:\"bytes_out\"`\r\n   337\t\t\t\tDurationMs  int64  `json:\"duration_ms\"`\r\n   338\t\t\t\tResult      string `json:\"result\"`\r\n   339\t\t\t\tRetried     bool   `json:\"retried\"`\r\n   340\t\t\t\tRetryCount  int    `json:\"retry_count\"`\r\n   341\t\t\t\tQueueWaitMs *int64 `json:\"queue_wait_ms,omitempty\"`\r\n   342\t\t\t}\r\n   343\t\t\tif err := json.Unmarshal(data, &entries); err != nil {\r\n   344\t\t\t\treturn \"\", err\r\n   345\t\t"]
[10740.619277, "o", "\t}\r\n   346\t\t\tb, err := json.MarshalIndent(entries, \"\", \"  \")\r\n   347\t\t\tif err != nil {\r\n   348\t\t\t\treturn \"\", err\r\n   349\t\t\t}\r\n"]
[10740.619337, "o", "   350\t\t\treturn string(b), nil\r\n   351\t\tcase \"get_access_stats\":\r\n   352\t\t\tvar st struct {\r\n   353\t\t\t\tTotalRequests int `json:\"total_requests\"`\r\n   354\t\t\t\tByResult      map[string]struct {\r\n   355\t\t\t\t\tCount         int   `json:\"count\"`\r\n   356\t\t\t\t\tAvgDurationMs int64 `json:\"avg_duration_ms\"`\r\n   357\t\t\t\t\tTotalBytesIn  int64 `json:\"total_bytes_in\"`\r\n   358\t\t\t\t\tTotalBytesOut int64 `json:\"total_bytes_out\"`\r\n   359\t\t\t\t} `json:\"by_result\"`\r\n   360\t\t\t}\r\n   361\t\t\tif err := json.Unmarshal(data, &st); err != nil {\r\n"]
[10740.619411, "o", "   362\t\t\t\treturn \"\", err\r\n   363\t\t\t}\r\n   364\t\t\tvar b strings.Builder\r\n   365\t\t\tfmt.Fprintf(&b, \"%-20s %-6s %-15s %-15s %-15s\\n\", \"RESULT\", \"COUNT\", \"AVG_DURATION_MS\", \"TOTAL_BYTES_IN\", \"TOTAL_BYTES_OUT\")\r\n   366\t\t\tresults := make([]string, 0, len(st.ByResult))\r\n   367\t\t\tfor name := range st.ByResult {\r\n   368\t\t\t\tresults = append(results, name)\r\n   369\t\t\t}\r\n   370\t\t\tsort.Strings(results)\r\n"]
[10740.619471, "o", "   371\t\t\tfor _, name := range results {\r\n   372\t\t\t\tr := st.ByResult[name]\r\n   373\t\t\t\tfmt.Fprintf(&b, \"%-20s %-6d %-15d %-15d %-15d\\n\", name, r.Count, r.AvgDurationMs, r.TotalBytesIn, r.TotalBytesOut)\r\n   374\t\t\t}\r\n   375\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   376\t\tcase \"get_rate_limit_status\":\r\n   377\t\t\tvar st struct {\r\n   378\t\t\t\tTokensAvailable float64 `json:\"tokens_available\"`\r\n"]
[10740.619529, "o", "   379\t\t\t\tQueueDepth      int     `json:\"queue_depth\"`\r\n   380\t\t\t\tRateLimited     int     `json:\"rate_limited\"`\r\n   381\t\t\t\tQueued          int     `json:\"queued\"`\r\n   382\t\t\t\tQueueTimeouts   int     `json:\"queue_timeouts\"`\r\n   383\t\t\t\tRps             float64 `json:\"rps\"`\r\n   384\t\t\t\tBurst           float64 `json:\"burst\"`\r\n   385\t\t\t}\r\n   386\t\t\tif err := json.Unmarshal(data, &st); err != nil {\r\n   387\t\t\t\treturn \"\", err\r\n"]
[10740.619586, "o", "   388\t\t\t}\r\n   389\t\t\tvar b strings.Builder\r\n   390\t\t\tfmt.Fprintf(&b, \"%-10s %-6s %-7s %-10s %-8s %-14s %-15s\\n\", \"SERVICE\", \"RPS\", \"BURST\", \"TOKENS\", \"QUEUED\", \"RATE_LIMITED\", \"QUEUE_TIMEOUTS\")\r\n"]
