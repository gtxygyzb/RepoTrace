[1460.752129, "o", "\u001b[?2004h> "]
[1460.752322, "o", "        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
[1460.752377, "o", "\u001b[?2004h> "]
[1460.752623, "o", "        args[\"address\"] = os.Args[3]\r\n\u001b[?2004l\r"]
[1460.752683, "o", "\u001b[?2004h> "]
[1460.752803, "o", "    case \"health-log\":\r\n\u001b[?2004l\r"]
[1460.75286, "o", "\u001b[?2004h> "]
[1460.753042, "o", "        if len(os.Args) < 3 {\r\n\u001b[?2004l\r"]
[1460.753097, "o", "\u001b[?2004h> "]
[1460.753616, "o", "            fmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\r\n\u001b[?2004l\r"]
[1460.753678, "o", "\u001b[?2004h> "]
[1460.753796, "o", "            os.Exit(1)\r\n\u001b[?2004l\r"]
[1460.753852, "o", "\u001b[?2004h> "]
[1460.753912, "o", "        }\r\n\u001b[?2004l\r"]
[1460.753967, "o", "\u001b[?2004h> "]
[1460.754185, "o", "        ipcCmd = \"get_health_log\"\r\n\u001b[?2004l\r"]
[1460.754241, "o", "\u001b[?2004h> "]
[1460.75445, "o", "        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r"]
[1460.754532, "o", "\u001b[?2004h> "]
[1460.754611, "o", "        last := 20\r\n\u001b[?2004l\r"]
[1460.754667, "o", "\u001b[?2004h> "]
[1460.75489, "o", "        for _, a := range os.Args[3:] {\r\n\u001b[?2004l\r"]
[1460.754953, "o", "\u001b[?2004h> "]
[1460.755327, "o", "            if strings.HasPrefix(a, \"--last\") && len(a) > 6 {\r\n\u001b[?2004l\r"]
[1460.755385, "o", "\u001b[?2004h> "]
[1460.755787, "o", "                if v, err := strconv.Atoi(a[6:]); err == nil {\r\n\u001b[?2004l\r"]
[1460.755844, "o", "\u001b[?2004h> "]
[1460.756019, "o", "                    last = v\r\n\u001b[?2004l\r"]
[1460.756074, "o", "\u001b[?2004h> "]
[1460.75617, "o", "                }\r\n\u001b[?2004l\r"]
[1460.756225, "o", "\u001b[?2004h> "]
[1460.756306, "o", "            }\r\n\u001b[?2004l\r"]
[1460.756437, "o", "\u001b[?2004h"]
[1460.756496, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1460.75666, "o", "        args[\"last_n\"] = last\r\n\u001b[?2004l\r"]
[1460.756715, "o", "\u001b[?2004h> "]
[1460.756826, "o", "    case \"resolve\":\r\n\u001b[?2004l\r"]
[1460.756883, "o", "\u001b[?2004h> "]
[1460.757075, "o", "        if len(os.Args) < 3 {\r\n\u001b[?2004l\r"]
[1460.757134, "o", "\u001b[?2004h> "]
[1460.757576, "o", "            fmt.Fprintln(os.Stderr, \"usage: meshctl resolve <service>\")\r\n\u001b[?2004l\r"]
[1460.757636, "o", "\u001b[?2004h> "]
[1460.757763, "o", "            os.Exit(1)\r\n\u001b[?2004l\r"]
[1460.757819, "o", "\u001b[?2004h> "]
[1460.757884, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1460.757912, "o", "> "]
[1460.758031, "o", "        ipcCmd = \"resolve\"\r\n\u001b[?2004l\r"]
[1460.758054, "o", "\u001b[?2004h> "]
[1460.758233, "o", "        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\rtew\u001b[?2004h"]
[1460.758255, "o", "> "]
[1460.758359, "o", "    case \"circuits\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[1460.75838, "o", "> "]
[1460.809694, "o", "        if len(os.Args) < 3 {\r\n\u001b[?2004l\r\u001b[?2004h>             fmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")\r\n\u001b[?2004l\r\u001b[?2004h>             os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         ipcCmd = \"get_circuit_breakers\"\r\n\u001b[?2004l\r\u001b[?2004h>         args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r\u001b[?2004h>     case \"reset-circuit\":\r\n\u001b[?2004l\r\u001b[?2004h>         if len(os.Args) < 4 {\r\n\u001b[?2004l\r\u001b[?2004h>             fmt.Fprintln(os.Stderr, \"usage: meshctl reset-circuit <service> <endpoint>\")\r\n\u001b[?2004l\r\u001b[?2004h>             os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         ipcCmd = \"reset_circuit_breaker\"\r\n\u001b[?2004l\r\u001b[?2004h>         args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r\u001b[?2004h>         args[\"address\"] = os.Args[3]\r\n\u001b[?2004l\r\u001b[?2004h>     case \"reload\":\r\n\u001b[?2004l\r\u001b[?2004h>         ipcCmd = \"reload_config\"\r\n\u001b[?2004l\r\u001b[?2004h>     default:\r\n\u001b[?2004l\r\u001b[?2004h>         fmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cliCmd)\r\n\u001b[?2004l\r\u001b[?2004h>         os.Exit(1)\r\n\u001b[?2004l\r\u001b[?200"]
[1460.809795, "o", "4h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     data, err := sendCommand(ipcCmd, args)\r\n\u001b[?2004l\r\u001b[?2004h>     if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>         fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r\u001b[?2004h>         os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     fmt.Println(data)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n\u001b[?2004l\r\u001b[?2004h>     rawArgs, err := json.Marshal(args)\r\n\u001b[?2004l\r\u001b[?2004h>     if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1460.809866, "o", "> "]
[1460.809946, "o", "        return \"\", err\r\n\u001b[?2004l\r"]
[1460.810009, "o", "\u001b[?2004h> "]
[1460.810064, "o", "    }\r\n\u001b[?2004l\r"]
[1460.810124, "o", "\u001b[?2004h> "]
[1460.810373, "o", "    req := request{Cmd: ipcCmd, Args: rawArgs}\r\n\u001b[?2004l\r"]
[1460.810441, "o", "\u001b[?2004h> "]
[1460.810662, "o", "    reqBytes, err := json.Marshal(req)\r\n\u001b[?2004l\r"]
[1460.810717, "o", "\u001b[?2004h> "]
[1460.810836, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1460.810915, "o", "\u001b[?2004h> "]
[1460.811026, "o", "        return \"\", err\r\n\u001b[?2004l\r"]
[1460.811081, "o", "\u001b[?2004h> "]
[1460.811136, "o", "    }\r\n\u001b[?2004l\r"]
[1460.811192, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1460.811246, "o", "\u001b[?2004h> "]
[1460.811546, "o", "    conn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\u001b[?2004l\r"]
[1460.811602, "o", "\u001b[?2004h> "]
[1460.811719, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1460.811779, "o", "\u001b[?2004h> "]
[1460.812142, "o", "        return \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n\u001b[?2004l\r"]
[1460.812198, "o", "\u001b[?2004h> "]
[1460.812254, "o", "    }\r\n\u001b[?2004l\r"]
[1460.81231, "o", "\u001b[?2004h> "]
[1460.812461, "o", "    defer conn.Close()\r\n\u001b[?2004l\r"]
[1460.812516, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1460.812564, "o", "\u001b[?2004h> "]
[1460.812848, "o", "    fmt.Fprintf(conn, \"%s\\n\", string(reqBytes))\r\n\u001b[?2004l\r"]
[1460.812905, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1460.812957, "o", "\u001b[?2004h> "]
[1460.81317, "o", "    reader := bufio.NewReader(conn)\r\n\u001b[?2004l\r"]
[1460.813225, "o", "\u001b[?2004h> "]
[1460.813467, "o", "    line, err := reader.ReadString('\\n')\r\n\u001b[?2004l\r"]
[1460.813522, "o", "\u001b[?2004h> "]
[1460.813636, "o", "    if err != nil {\r\n\u001b[?2004l\r"]
[1460.81369, "o", "\u001b[?2004h> "]
[1460.81382, "o", "        return \"\", err\r\n\u001b[?2004l\r"]
[1460.813879, "o", "\u001b[?2004h> "]
[1460.813933, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1460.813987, "o", "> "]
[1460.814211, "o", "    line = strings.TrimRight(line, \"\\r\\n\")\r\n\u001b[?2004l\r"]
[1460.814266, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1460.814321, "o", "\u001b[?2004h> "]
[1460.814486, "o", "    var resp response\r\n\u001b[?2004l\r"]
[1460.814541, "o", "\u001b[?2004h> "]
[1460.814901, "o", "    if err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n\u001b[?2004l\r"]
[1460.814956, "o", "\u001b[?2004h> "]
[1460.815087, "o", "        return \"\", err\r\n\u001b[?2004l\r"]
[1460.81514, "o", "\u001b[?2004h> "]
[1460.815194, "o", "    }\r\n\u001b[?2004l\r"]
[1460.815248, "o", "\u001b[?2004h> "]
[1460.815415, "o", "    if resp.Status != \"ok\" {\r\n\u001b[?2004l\r"]
[1460.815471, "o", "\u001b[?2004h> "]
[1460.815598, "o", "        var msg string\r\n\u001b[?2004l\r"]
[1460.815652, "o", "\u001b[?2004h> "]
[1460.816009, "o", "        if err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n\u001b[?2004l\r"]
[1460.816064, "o", "\u001b[?2004h> "]
[1460.816321, "o", "            return \"\", fmt.Errorf(\"%s\", msg)\r\n\u001b[?2004l\r"]
[1460.816375, "o", "\u001b[?2004h> "]
[1460.816441, "o", "        }\r\n\u001b[?2004l\r"]
[1460.816497, "o", "\u001b[?2004h> "]
[1460.81681, "o", "        return \"\", fmt.Errorf(\"%s\", string(resp.Data))\r\n\u001b[?2004l\r"]
[1460.816865, "o", "\u001b[?2004h> "]
[1460.816921, "o", "    }\r\n\u001b[?2004l\r"]
[1460.816976, "o", "\u001b[?2004h> "]
[1460.817211, "o", "    return prettyData(ipcCmd, resp.Data)\r\n\u001b[?2004l\r"]
[1460.817272, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1460.817328, "o", "\u001b[?2004h> \r\n"]
[1460.817383, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1460.81746, "o", "> "]
[1460.817815, "o", "func prettyData(ipcCmd string, data json.RawMessage) (string, error) {\r\n\u001b[?2004l\r"]
[1460.81787, "o", "\u001b[?2004h> "]
[1460.817986, "o", "    switch ipcCmd {\r\n\u001b[?2004l\r"]
[1460.818041, "o", "\u001b[?2004h> "]
[1460.818192, "o", "    case \"list_services\":\r\n\u001b[?2004l\r"]
[1460.818247, "o", "\u001b[?2004h> "]
[1460.818439, "o", "        var services []struct {\r\n\u001b[?2004l\r"]
[1460.818494, "o", "\u001b[?2004h> "]
[1460.818748, "o", "            Name        string `json:\"name\"`\r\n\u001b[?2004l\r"]
[1460.818803, "o", "\u001b[?2004h> "]
[1460.819097, "o", "            ListenPort  int    `json:\"listen_port\"`\r\n\u001b[?2004l\r"]
[1460.819146, "o", "\u001b[?2004h> "]
[1460.819467, "o", "            RoutingMode string `json:\"routing_mode\"`\r\n\u001b[?2004l\r"]
[1460.819521, "o", "\u001b[?2004h> "]
[1460.819719, "o", "            Endpoints   []struct {\r\n\u001b[?2004l\r"]
[1460.819773, "o", "\u001b[?2004h> "]
[1460.820156, "o", "                Address            string `json:\"address\"`\r\n\u001b[?2004l\r"]
[1460.820222, "o", "\u001b[?2004h> "]
[1460.820541, "o", "                State             string `json:\"state\"`\r\n\u001b[?2004l\r"]
[1460.820596, "o", "\u001b[?2004h> "]
[1460.820918, "o", "                Weight            int    `json:\"weight\"`\r\n\u001b[?2004l\r"]
[1460.821, "o", "\u001b[?2004h"]
[1460.821056, "o", "> "]
[1460.82136, "o", "                ActiveConnections int    `json:\"active_connections\"`\r\n\u001b[?2004l\r"]
[1460.821437, "o", "\u001b[?2004h> "]
[1460.821672, "o", "                CircuitState      string `json:\"circuit_state\"`\r\n\u001b[?2004l\r"]
[1460.821738, "o", "\u001b[?2004h> "]
[1460.821848, "o", "            } `json:\"endpoints\"`\r\n\u001b[?2004l\r"]
[1460.821903, "o", "\u001b[?2004h> "]
[1460.821957, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1460.822234, "o", "        if err := json.Unmarshal(data, &services); err != nil {\r\n\u001b[?2004l\r"]
[1460.822289, "o", "\u001b[?2004h> "]
[1460.822413, "o", "            return \"\", err\r\n\u001b[?2004l\r"]
[1460.822469, "o", "\u001b[?2004h> "]
[1460.822523, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1460.822661, "o", "        var b strings.Builder\r\n\u001b[?2004l\r"]
[1460.822715, "o", "\u001b[?2004h> "]
[1460.823214, "o", "        fmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\r\n\u001b[?2004l\r"]
[1460.82327, "o", "\u001b[?2004h> "]
[1460.823423, "o", "        for _, svc := range services {\r\n\u001b[?2004l\r"]
[1460.823479, "o", "\u001b[?2004h> "]
[1460.823661, "o", "            for _, ep := range svc.Endpoints {\r\n\u001b[?2004l\r"]
[1460.823715, "o", "\u001b[?2004h> "]
[1460.824318, "o", "                fmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\r\n\u001b[?2004l\r"]
[1460.824379, "o", "\u001b[?2004h> "]
[1460.824441, "o", "            }\r\n\u001b[?2004l\r"]
[1460.824497, "o", "\u001b[?2004h> "]
[1460.824552, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1460.824605, "o", "> "]
[1460.824813, "o", "        return strings.TrimRight(b.String(), \"\\n\"), nil\r\n\u001b[?2004l\r"]
[1460.824868, "o", "\u001b[?2004h> "]
[1460.824931, "o", "    case \"resolve\":\r\n\u001b[?2004l\r"]
[1460.824985, "o", "\u001b[?2004h> "]
[1460.825074, "o", "        var addr string\r\n\u001b[?2004l\r"]
[1460.825128, "o", "\u001b[?2004h> "]
[1460.825362, "o", "        if err := json.Unmarshal(data, &addr); err != nil {\r\n\u001b[?2004l\r"]
[1460.825468, "o", "\u001b[?2004h> "]
[1460.825576, "o", "            return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1460.825643, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1460.825704, "o", "> "]
[1460.825768, "o", "        return addr, nil\r\n\u001b[?2004l\r\u001b[?2004h"]
