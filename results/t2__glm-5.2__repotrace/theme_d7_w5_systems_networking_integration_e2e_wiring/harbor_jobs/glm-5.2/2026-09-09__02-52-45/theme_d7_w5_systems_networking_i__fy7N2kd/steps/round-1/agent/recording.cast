[9542.553336, "o", "\tif queued {\r\n\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n\u001b[32m\u001b[K219\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tcand.Stats.RecordQueued()\r\n\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K223\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\r\n\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar lastEndpoint *state.EndpointState\r\n\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tfor attempt := 0; ; attempt++ {\r\n\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\r\n\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif err != nil {\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tresult = \"rejected_no_endpoint\"\r\n"]
[9542.553446, "o", "\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tendpoint = \"\"\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tss := r.state.GetService(service)\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n"]
