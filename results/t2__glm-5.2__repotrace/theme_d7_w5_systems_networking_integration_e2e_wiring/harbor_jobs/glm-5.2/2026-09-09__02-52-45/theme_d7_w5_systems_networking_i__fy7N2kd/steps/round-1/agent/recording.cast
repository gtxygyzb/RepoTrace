[5736.957726, "o", "    47\t\tconnections       map[int64]*connectionInfo\r\n    48\t}\r\n    49\t\r\n    50\ttype connectionInfo struct {\r\n    51\t\tconn         net.Conn\r\n    52\t\tclientAddr   string\r\n    53\t\tstart        time.Time\r\n"]
[5736.95778, "o", "    54\t\tlastActivity time.Time\r\n    55\t\tbytesIn      int64\r\n    56\t\tbytesOut     int64\r\n    57\t}\r\n    58\t\r\n    59\ttype ServiceState struct {\r\n    60\t\tmu                        sync.Mutex\r\n    61\t\tName                      string\r\n    62\t\tListenPort                int\r\n    63\t\tRoutingMode               string\r\n    64\t\tDrainTimeoutMs            int\r\n    65\t\tMaxConnectionsPerEndpoint int\r\n    66\t\tIdleTimeoutMs             int\r\n    67\t\tRateLimitRps              int\r\n"]
