[10651.228977, "o", "nl -ba internal/stats/stats.go | sed -n '1,180p'\r\n"]
[10651.229014, "o", "\u001b[?2004l\r"]
[10651.23287, "o", "     1\tpackage stats\r\n     2\t\r\n     3\timport (\r\n"]
[10651.232906, "o", "     4\t\t\"sync\"\r\n     5\t\t\"time\"\r\n     6\t)\r\n     7\t\r\n     8\ttype entry struct {\r\n     9\t\ttimestamp time.Time\r\n    10"]
[10651.232941, "o", "\t\tbytesIn   int64\r\n    11\t\tbytesOut  int64\r\n    12\t\tlatency   time.Duration\r\n    13\t\terr       bool\r\n"]
[10651.232979, "o", "    14\t}\r\n    15\t\r\n    16\t// Collector keeps rolling connection statistics for one endpoint.\r\n"]
[10651.233007, "o", "    17\ttype Collector struct {\r\n    18\t\tmu         sync.Mutex\r\n    19\t\twindow     time.Duration\r\n    20\t\tentries    []entry\r\n    21\t\trejections []time.Time\r\n    22\t\r\n    23\t\t"]
[10651.233035, "o", "rateLimited    int\r\n    24\t\tqueued         int\r\n    25\t\tqueueTimeouts  int\r\n    26\t\tretries        int\r\n    27\t\tretrySuccesses int"]
[10651.233066, "o", "\r\n    28\t\tidleTimeouts   int\r\n    29\t}\r\n    30\t\r\n    31\t// New creates a collector with the given window length.\r\n    32"]
[10651.233096, "o", "\tfunc New(window time.Duration) *Collector {\r\n    33\t\tif window <= 0 {\r\n    34\t\t\twindow = time.Minute\r\n    35\t\t}\r\n"]
[10651.233125, "o", "    36\t\treturn &Collector{window: window}\r\n    37\t}\r\n    38\t\r\n    39\t// RecordConnection records a finished connection attempt.\r\n    40\tfunc (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\r\n"]
[10651.233155, "o", "    41\t\tc.mu.Lock()\r\n    42\t\tdefer c.mu.Unlock()\r\n    43\t\tnow := time.Now()\r\n"]
[10651.233186, "o", "    44\t\tc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\r\n    45\t\tc.trim(now)\r\n"]
[10651.233214, "o", "    46\t}\r\n    47\t\r\n"]
[10651.233243, "o", "    48\t// RecordRejection records a rejected connection because the endpoint was at capacity.\r\n    49\tfunc (c *Collector) RecordRejection() {\r\n    50\t\tc.mu.Lock()\r\n    51\t\tdefer c.mu.Unlock()\r\n    52\t\t"]
[10651.233271, "o", "now := time.Now()\r\n    53\t\tc.rejections = append(c.rejections, now)\r\n    54\t\tc.trim(now)\r\n"]
[10651.233301, "o", "    55\t}\r\n    56\t\r\n    57\t// RecordRateLimited records a rate limit rejection.\r\n    58"]
[10651.233332, "o", "\tfunc (c *Collector) RecordRateLimited() {\r\n"]
[10651.233359, "o", "    59\t\tc.mu.Lock()\r\n    60\t\tdefer c.mu.Unlock()\r\n    61\t\tc.rateLimited++\r\n    62\t}\r\n    63\t\r\n    64\t"]
[10651.233405, "o", "// RecordQueued records a connection that was queued waiting for a token.\r\n    65\tfunc (c *Collector) RecordQueued() {\r\n    66\t\tc.mu.Lock()\r\n"]
[10651.233436, "o", "    67\t\tdefer c.mu.Unlock()\r\n    68\t\tc.queued++\r\n    69\t}\r\n"]
[10651.233466, "o", "    70\t\r\n    71\t// RecordQueueTimeout records a queue timeout rejection.\r\n    72\tfunc (c *Collector) RecordQueueTimeout() {\r\n    73\t\tc.mu.Lock()\r\n    74\t\tdefer c.mu.Unlock()\r\n"]
[10651.233497, "o", "    75\t\tc.queueTimeouts++\r\n    76\t\tc.rateLimited++\r\n    77\t}\r\n    78\t\r\n"]
[10651.233529, "o", "    79\t// RecordRetry records a retry attempt.\r\n    80\tfunc (c *Collector) RecordRetry() {\r\n    81\t\tc.mu.Lock()\r\n"]
[10651.233557, "o", "    82\t\tdefer c.mu.Unlock()\r\n    83\t\tc.retries++\r\n    84\t}\r\n"]
[10651.233586, "o", "    85\t\r\n    86\t// RecordRetrySuccess records a successful retry attempt.\r\n    87\tfunc (c *Collector) RecordRetrySuccess() {\r\n"]
[10651.233612, "o", "    88\t\tc.mu.Lock()\r\n    89\t\tdefer c.mu.Unlock()\r\n    90\t\tc.retrySuccesses++\r\n    91\t}\r\n"]
[10651.233639, "o", "    92\t\r\n    93\t// RecordIdleTimeout records a connection that was closed because it was idle.\r\n    94\tfunc (c *Collector) RecordIdleTimeout() {\r\n    95\t\tc.mu.Lock()\r\n"]
[10651.233669, "o", "    96\t\tdefer c.mu.Unlock()\r\n    97\t\tc.idleTimeouts++\r\n    98\t}\r\n"]
[10651.233696, "o", "    99\t\r\n   100\tfunc (c *Collector) trim(now time.Time) {\r\n   101\t\tcutoff := now.Add(-c.window)\r\n"]
[10651.233728, "o", "   102\t"]
[10651.233757, "o", "\ti := 0\r\n   103\t\tfor i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {\r\n   104\t\t\ti++\r\n   105\t\t}\r\n   106\t\tif i > 0 {\r\n"]
[10651.233793, "o", "   107\t\t\tc.entries = c.entries[i:]\r\n   108\t\t}\r\n   109\t\tj := 0\r\n   110\t\tfor j < len(c.rejections) && c.rejections[j].Before(cutoff) {\r\n   111\t\t\t"]
[10651.233822, "o", "j++\r\n   112\t\t}\r\n   113\t\tif j > 0 {\r\n   114\t\t\tc.rejections = c.rejections[j:]\r\n"]
[10651.233851, "o", "   115\t\t}\r\n   116\t}\r\n   117\t\r\n"]
[10651.233877, "o", "   118\t// Snapshot returns current windowed stats. active is supplied by the state manager.\r\n   119\tfunc (c *Collector) Snapshot(active int) Snapshot {\r\n   120\t\tc.mu.Lock()\r\n"]
[10651.233906, "o", "   121\t\tdefer c.mu.Unlock()\r\n   122\t\tnow := time.Now()\r\n   123\t\tcutoff := now.Add(-c.window)\r\n"]
[10651.233938, "o", "   124\t\tvar total int\r\n   125\t\tvar bytesIn, bytesOut int64\r\n"]
[10651.233965, "o", "   126\t\tvar latencySum time.Duration\r\n   127\t\tvar errors int\r\n   128\t\tfor _, e := range c.entries {\r\n   129\t\t\tif e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {\r\n"]
[10651.233983, "o", "   130\t\t\t\ttotal++\r\n   131\t\t\t\tbytesIn += e.bytesIn\r\n"]
[10651.23402, "o", "   132\t\t\t\tbytesOut += e.bytesOut\r\n   133\t\t\t\tlatencySum += e.latency\r\n   134\t\t\t\tif e.err {\r\n   135\t\t"]
[10651.234047, "o", "\t\t\terrors++\r\n   136\t\t\t\t}\r\n   137"]
[10651.234078, "o", "\t\t\t}\r\n   138\t\t}\r\n   139\t\trejected := 0\r\n   140\t\tfor _, t := range c.rejections {\r\n"]
[10651.234111, "o", "   141\t\t\tif t.After(cutoff) || t.Equal(cutoff) {\r\n   142\t\t\t\trejected++\r\n"]
[10651.234138, "o", "   143\t\t\t}\r\n   144\t\t}\r\n   145\t\tvar avg float64\r\n"]
[10651.234165, "o", "   146\t\tif total > 0 {\r\n   147\t\t\tavg = float64(latencySum.Milliseconds()) / float64(total)\r\n   148\t\t}\r\n"]
[10651.234194, "o", "   149\t\treturn Snapshot{\r\n   150\t\t\tTotalConnections:    total,\r\n   151\t\t\tActiveConnections:   active,\r\n"]
[10651.234222, "o", "   152\t\t\tBytesIn:             bytesIn,\r\n   153\t\t\tBytesOut:            bytesOut,\r\n   154\t\t\t"]
[10651.234251, "o", "AvgLatencyMs:        avg,\r\n   155\t\t\tErrors:              errors,\r\n   156\t\t\tRejectedConnections: rejected,\r\n"]
[10651.234276, "o", "   157\t\t\tRateLimited:         c.rateLimited,\r\n   158\t\t\tQueued:              c.queued,\r\n   159\t\t\t"]
[10651.234306, "o", "QueueTimeouts:       c.queueTimeouts,\r\n   160\t\t\tRetries:             c.retries,\r\n   161\t\t\tRetrySuccesses:      c.retrySuccesses,\r\n   162\t\t"]
[10651.234333, "o", "\tIdleTimeouts:        c.idleTimeouts,\r\n   163\t\t}\r\n   164\t}\r\n   165\t\r\n"]
[10651.23436, "o", "   166\t// Snapshot is a JSON-friendly stats view.\r\n   167\ttype Snapshot struct {\r\n   168\t\tTotalConnections    int     `json:\"total_connections\"`\r\n   169\t\tActiveConnections   int     `json:\"active_connections\"`\r\n   170\t\t"]
[10651.234391, "o", "BytesIn             int64   `json:\"bytes_in\"`\r\n   171\t\tBytesOut            int64   `json:\"bytes_out\"`\r\n   172\t\tAvgLatencyMs        float64 `json:\"avg_latency_ms\"`\r\n   173\t\tErrors              int     `json:\"errors\"`\r\n"]
[10651.234422, "o", "   174\t\tRejectedConnections int     `json:\"rejected_connections\"`\r\n   175\t\tRateLimited         int     `json:\"rate_limited\"`\r\n   176\t\tQueued              int     `json:\"queued\"`\r\n"]
[10651.234448, "o", "   177\t\tQueueTimeouts       int     `json:\"queue_timeouts\"`\r\n   178\t\tRetries             int     `json:\"retries\"`\r\n   179\t\tRetrySuccesses      int     `json:\"retry_successes\"`\r\n"]
[10651.234476, "o", "   180\t\tIdleTimeouts        int     `json:\"idle_timeouts\"`\r\n"]
