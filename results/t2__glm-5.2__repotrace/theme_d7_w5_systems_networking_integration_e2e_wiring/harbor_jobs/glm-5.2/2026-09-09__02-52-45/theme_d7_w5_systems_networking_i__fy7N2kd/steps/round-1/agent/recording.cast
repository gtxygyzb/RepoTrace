[9542.846569, "o", "\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.mu.Lock()\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer c.mu.Unlock()\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.rateLimited++\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// RecordQueued records a connection that was queued waiting for a token.\r\n"]
[9542.846642, "o", "\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (c *Collector) RecordQueued() {\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.mu.Lock()\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer c.mu.Unlock()\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.queued++\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n"]
[9542.846708, "o", "\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KRecordQueueTimeout\u001b[m\u001b[K records a queue timeout rejection.\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (c *Collector) \u001b[01;31m\u001b[KRecordQueueTimeout\u001b[m\u001b[K() {\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.mu.Lock()\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[9542.846773, "o", "\tdefer c.mu.Unlock()\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.queueTimeouts++\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K77\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// RecordRetry records a retry attempt.\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (c *Collector) RecordRetry() {\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.mu.Lock()\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefer c.mu.Unlock()\r\n\u001b[35m\u001b[Kinternal/stats/stats.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tc.retries++\r\n"]
