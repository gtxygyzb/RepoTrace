[7507.49006, "o", "   226\t\t\tif err := json.Unmarshal(data, &addr); err != nil {\r\n   227\t\t\t\treturn \"\", err\r\n   228\t\t\t}\r\n   229\t\t\treturn addr, nil\r\n   230\t\tcase \"get_circuit_breakers\":\r\n   231\t\t\tvar circuits []struct {\r\n   232\t\t\t\tAddress             string `json:\"address\"`\r\n   233\t\t\t\tCircuitState        string `json:\"circuit_state\"`\r\n   234\t\t\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n   235\t\t\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n   236\t\t\t\tProbeActive         bool   `json:\"probe_active\"`\r\n   237\t\t\t}\r\n   238\t\t\tif err := json.Unmarshal(data, &circuits); err != nil {\r\n   239\t\t\t\treturn \"\", err\r\n   240\t\t\t}\r\n   241\t\t\tvar b strings.Builder\r\n"]
[7507.49015, "o", "   242\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9s %-17s %-7s\\n\", \"ENDPOINT\", \"CIRCUIT\", \"FAILURES\", \"TIME_IN_STATE_MS\", \"PROBE\")\r\n   243\t\t\tfor _, c := range circuits {\r\n   244\t\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9d %-17d %-7t\\n\", c.Address, c.CircuitState, c.ConsecutiveFailures, c.TimeInStateMs, c.ProbeActive)\r\n   245\t\t\t}\r\n   246\t\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n   247\t\tcase \"get_warmup_status\":\r\n   248\t\t\tvar resp struct {\r\n   249\t\t\t\tEndpoints []struct {\r\n"]
[7507.49023, "o", "   250\t\t\t\t\tEndpoint          string `json:\"endpoint\"`\r\n   251\t\t\t\t\tWarmingUp         bool   `json:\"warming_up\"`\r\n   252\t\t\t\t\tWarmupRemainingMs int    `json:\"warmup_remaining_ms\"`\r\n   253\t\t\t\t\tEffectiveWeight   int    `json:\"effective_weight\"`\r\n   254\t\t\t\t\tConfigWeight      int    `json:\"config_weight\"`\r\n   255\t\t\t\t} `json:\"endpoints\"`\r\n   256\t\t\t}\r\n   257\t\t\tif err := json.Unmarshal(data, &resp); err != nil {\r\n   258\t\t\t\treturn \"\", err\r\n   259\t\t\t}\r\n   260\t\t\tvar b strings.Builder\r\n   261\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-13s %-17s %-13s\\n\", \"ENDPOINT\", \"WARMING_UP\", \"REMAINING_MS\", \"EFFECTIVE_WEIGHT\", \"CONFIG_WEIGHT\")\r\n"]
