[7400.640879, "o", "package ipc\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"errors\"\r\n\t\"fmt\"\r\n\t\"net\"\r\n\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"sync\"\r\n\r\n\t\"meshrouter/internal/config\"\r\n\t\"meshrouter/internal/state\"\r\n)\r\n\r\ntype Request struct {\r\n\tCmd  string          `json:\"cmd\"`\r\n\tArgs json.RawMessage `json:\"args\"`\r\n}\r\n\r\ntype Response struct {\r\n\tStatus string      `json:\"status\"`\r\n\tData   interface{} `json:\"data\"`\r\n}\r\n\r\ntype Server struct {\r\n\tstate    *state.State\r\n\tpath     string\r\n\tlistener net.Listener\r\n\twg       sync.WaitGroup\r\n\tstop     chan struct{}\r\n\t"]
[7400.64098, "o", "done     chan struct{}\r\n}\r\n\r\nfunc NewServer(s *state.State, path string) *Server {\r\n\treturn &Server{\r\n\t\tstate: s,\r\n\t\tpath:  path,\r\n\t\tstop:  make(chan struct{}),\r\n\t\tdone:  make(chan struct{}),\r\n\t}\r\n}\r\n\r\nfunc (s *Server) Start() error {\r\n\tos.Remove(s.path)\r\n\tln, err := net.Listen(\"unix\", s.path)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\ts.listener = ln\r\n\tgo s.acceptLoop()\r\n\treturn nil\r\n}\r\n\r\nfunc (s *Server) Stop() {\r\n\tselect {\r\n\tcase <-s.stop:\r\n\tdefault:\r\n\t\tclose(s.stop)\r\n\t}\r\n\tif s.listener != nil {\r\n\t\ts.listener.Close()\r\n\t}\r\n\t<-s.done\r\n\tos.Remove(s.path)\r\n}\r\n\r\nfunc (s *Server) acceptLoop() {\r\n\tdefer close(s.done)\r\n\tfor {\r\n\t\tconn, err := s.listener.Accept()\r\n\t\tif err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n\t\ts.wg.Add(1)\r\n\t\tgo s.handleConn(conn)\r\n\t}\r\n}\r\n\r\nfunc (s *Server) handleConn(conn net.Conn) {\r\n\tdefer s.wg.Done()\r\n\tdefer conn.Close()\r\n\treader := bufio.NewReader(conn)\r\n\tfor {\r\n\t\tline, err := reader.ReadString('\\n')\r\n\t\tif err != nil {\r\n"]
[7400.641001, "o", "\t\t\treturn\r\n\t\t}\r\n\t\tline = strings.TrimRight(line, \"\\r\\n\")\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tresp := s.handleLine(line)\r\n\t\t_, _ = conn.Write([]byte(resp + \"\\n\"))\r\n\t}\r\n}\r\n\r\nfunc (s *Server) handleLine(line string) string {\r\n\tvar req Request\r\n\tif err := json.Unmarshal([]byte(line), &req); err != nil {\r\n\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n\t}\r\n\tdata, err := s.dispatch(req)\r\n\tif err != nil {\r\n\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n\t}\r\n"]
[7400.641137, "o", "\treturn encodeResp(Response{Status: \"ok\", Data: data})\r\n}\r\n\r\nfunc encodeResp(r Response) string {\r\n\tb, _ := json.Marshal(r)\r\n\treturn string(b)\r\n}\r\n\r\nfunc (s *Server) dispatch(req Request) (interface{}, error) {\r\n\tswitch req.Cmd {\r\n\tcase \"list_services\":\r\n\t\treturn s.state.ServicesView(), nil\r\n\tcase \"get_service\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tsv, ok := s.state.ServiceView(args.Name)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn sv, nil\r\n\tcase \"get_warmup_status\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tsv, ok := s.state.WarmupStatusView(args.Name)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn sv, nil\r\n\tcase \"get_stats\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\tretu"]
[7400.641156, "o", "rn nil, err\r\n\t\t}\r\n\t\tg := s.state.Global()\r\n\t\tsv, ok := s.state.StatsView(args.Name, g.StatsWindowSec)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn sv, nil\r\n\tcase \"set_weight\":\r\n\t\tvar args struct {\r\n\t\t\tName    string `json:\"name\"`\r\n\t\t\tAddress string `json:\"address\"`\r\n\t\t\tWeight  int    `json:\"weight\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tif err := s.state.SetWeight(args.Name, args.Address, args.Weight); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn \"OK\", nil\r\n\tcase \"drain_endpoint\":\r\n\t\tvar args struct {\r\n\t\t\tName    string `json:\"name\"`\r\n\t\t\tAddress string `json:\"address\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tif err := s.state.DrainEndpoint(args.Name, args.Address); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t"]
[7400.641242, "o", "\treturn \"OK\", nil\r\n\tcase \"get_health_log\":\r\n\t\tvar args struct {\r\n\t\t\tName  string `json:\"name\"`\r\n\t\t\tLastN int    `json:\"last_n\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn s.state.HealthLogView(args.Name, args.LastN), nil\r\n\tcase \"get_circuit_breakers\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tcv, ok := s.state.CircuitsView(args.Name)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn cv, nil\r\n\tcase \"reset_circuit_breaker\":\r\n\t\tvar args struct {\r\n\t\t\tName    string `json:\"name\"`\r\n\t\t\tAddress string `json:\"address\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tif err := s.state.ResetCircuitBreaker(args.Name, args.Address); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\t"]
[7400.641302, "o", "return \"OK\", nil\r\n\tcase \"resolve\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\taddr, err := s.state.ResolveEndpoint(args.Name)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\treturn addr, nil\r\n"]
[7400.641382, "o", "\tcase \"reload_config\":\r\n\t\tpath := s.state.ConfigPath()\r\n\t\tcfg, err := config.Load(path)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\ts.state.ApplyConfig(cfg)\r\n\t\treturn \"OK\", nil\r\n\tcase \"get_rate_limit_status\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\ttokens, queueDepth, rateLimited, queued, timeouts, rps, burst, ok := s.state.RateLimitStatus(args.Name)\r\n\t\tif !ok {\r\n\t\t\treturn nil, errors.New(\"service not found\")\r\n\t\t}\r\n\t\treturn map[string]interface{}{\r\n\t\t\t\"tokens_available\": tokens,\r\n\t\t\t\"queue_depth\":      queueDepth,\r\n\t\t\t\"rate_limited\":     int(rateLimited),\r\n\t\t\t\"queued\":           int(queued),"]
[7400.641421, "o", "\r\n\t\t\t\"queue_timeouts\":   int(timeouts),\r\n\t\t\t\"rps\":              rps,\r\n\t\t\t\"burst\":            burst,\r\n\t\t}, nil\r\n\tcase \"get_connections\":\r\n\t\tvar args struct {\r\n\t\t\tName string `json:\"name\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n"]
