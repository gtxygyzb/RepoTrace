[3110.937019, "o", "     1\tpackage circuit\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"sync\"\r\n     5\t\t\"time\"\r\n     6\t)\r\n"]
[3110.93711, "o", "     7\t\r\n     8\ttype State string\r\n     9\t\r\n    10\tconst (\r\n    11\t\tClosed   State = \"closed\"\r\n    12\t\tOpen     State = \"open\"\r\n    13\t\tHalfOpen State = \"half_open\"\r\n    14\t)\r\n    15\t\r\n    16\t// Breaker implements an endpoint circuit breaker.\r\n    17\ttype Breaker struct {\r\n    18\t\tmu                  sync.Mutex\r\n    19\t\tstate               State\r\n    20\t\t"]
[3110.937191, "o", "consecutiveFailures int\r\n    21\t\tstateChangedAt      time.Time\r\n    22\t\topenedAt            time.Time\r\n    23\t\ttimeout             time.Duration\r\n    24\t\tprobeActive         bool\r\n    25\t}\r\n    26\t\r\n    27\t// New creates a closed breaker with the given open timeout.\r\n    28\tfunc New(timeout time.Duration) *Breaker {\r\n    29\t\tnow := time.Now()\r\n    30\t"]
[3110.937256, "o", "\treturn &Breaker{\r\n    31\t\t\tstate:          Closed,\r\n    32\t\t\tstateChangedAt: now,\r\n    33\t\t\topenedAt:       now,\r\n    34\t\t\ttimeout:        timeout,\r\n    35\t\t}\r\n    36\t}\r\n    37\t\r\n    38\t// State returns the current state.\r\n    39\tfunc (b *Breaker) State() State {\r\n"]
[3110.937316, "o", "    40\t\tb.mu.Lock()\r\n    41\t\tdefer b.mu.Unlock()\r\n    42\t\treturn b.state\r\n    43\t}\r\n    44\t\r\n    45\t// IsClosed returns true if the breaker is closed.\r\n    46\tfunc (b *Breaker) IsClosed() bool {\r\n    47\t\treturn b.State() == Closed\r\n"]
[3110.937377, "o", "    48\t}\r\n    49\t\r\n    50\t// IsOpen returns true if the breaker is open.\r\n    51\tfunc (b *Breaker) IsOpen() bool {\r\n    52\t\treturn b.State() == Open\r\n    53\t}\r\n    54\t\r\n    55\t// IsHalfOpen returns true if the breaker is half-open.\r\n    56\tfunc (b *Breaker) IsHalfOpen() bool {\r\n"]
[3110.937474, "o", "    57\t\treturn b.State() == HalfOpen\r\n    58\t}\r\n    59\t\r\n    60\t// Open forces the breaker open and restarts the timeout clock.\r\n    61\tfunc (b *Breaker) Open() {\r\n    62\t\tb.mu.Lock()\r\n    63\t\tdefer b.mu.Unlock()\r\n    64\t\tnow := time.Now()\r\n    65\t\tb.state = Open\r\n    66\t\tb.stateChangedAt = now\r\n"]
[3110.937541, "o", "    67\t\tb.openedAt = now\r\n    68\t\tb.consecutiveFailures++\r\n    69\t\tb.probeActive = false\r\n    70\t}\r\n    71\t\r\n    72\t// MaybeHalfOpen transitions from open to half_open if the timeout has elapsed.\r\n    73\tfunc (b *Breaker) MaybeHalfOpen() bool {\r\n    74\t\tb.mu.Lock()\r\n    75\t\tdefer b.mu.Unlock()\r\n    76\t\tif b.state == Open && time.Since(b.openedAt) >= b.timeout {\r\n    77\t\t\tb.state = HalfOpen\r\n"]
[3110.937607, "o", "    78\t\t\tb.stateChangedAt = time.Now()\r\n    79\t\t\tb.probeActive = false\r\n    80\t\t\treturn true\r\n    81\t\t}\r\n    82\t\treturn false\r\n    83\t}\r\n    84\t\r\n    85\t// AcquireProbe attempts to take the single allowed half-open probe connection.\r\n    86\tfunc (b *Breaker) AcquireProbe() bool {\r\n"]
[3110.937668, "o", "    87\t\tb.mu.Lock()\r\n    88\t\tdefer b.mu.Unlock()\r\n    89\t\tif b.state == HalfOpen && !b.probeActive {\r\n    90\t\t\tb.probeActive = true\r\n    91\t\t\treturn true\r\n    92\t\t}\r\n    93\t\treturn false\r\n"]
[3110.937738, "o", "    94\t}\r\n    95\t\r\n    96\t// ProbeSuccess closes the circuit and clears failure counts.\r\n    97\tfunc (b *Breaker) ProbeSuccess() {\r\n    98\t\tb.mu.Lock()\r\n    99\t\tdefer b.mu.Unlock()\r\n   100\t\tnow := time.Now()\r\n   101\t\tb.state = Closed\r\n   102\t\tb.stateChangedAt = now\r\n   103\t\tb.consecutiveFailures = 0\r\n   104\t\tb.probeActive = false\r\n"]
[3110.93781, "o", "   105\t}\r\n   106\t\r\n   107\t// ProbeFailure reopens the circuit and restarts the timeout.\r\n   108\tfunc (b *Breaker) ProbeFailure() {\r\n   109\t\tb.mu.Lock()\r\n   110\t\tdefer b.mu.Unlock()\r\n   111\t\tnow := time.Now()\r\n   112\t\tb.state = Open\r\n   113\t\tb.stateChangedAt = now\r\n   114\t\tb.openedAt = now\r\n"]
[3110.937873, "o", "   115\t\tb.consecutiveFailures++\r\n   116\t\tb.probeActive = false\r\n   117\t}\r\n   118\t\r\n   119\t// Reset forces the breaker closed and clears failure counts.\r\n   120\tfunc (b *Breaker) Reset() {\r\n   121\t\tb.mu.Lock()\r\n"]
