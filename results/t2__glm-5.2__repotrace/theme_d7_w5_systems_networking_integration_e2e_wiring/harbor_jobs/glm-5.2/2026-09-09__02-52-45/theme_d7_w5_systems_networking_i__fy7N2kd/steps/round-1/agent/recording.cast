[588.033221, "i", "t.Reset()\n    return nil\n}\n\nfunc (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {\n    ep.mu.Lock()\n    defer ep.mu.Unlock()\n    ep.State = Draining\n    ep.consecSuccess = 0\n    ep.consecFailures = 0\n    ep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n    if markRemoved {\n        ep.removed = true\n    }\n    if len(ep.connections) > 0 {\n        go func(deadline time.Time, conns map[int64]net.Conn) {\n            time.Sleep(time.Until(deadline))\n            ep.closeConnectionsLocked()\n        }(ep.drainDeadline, ep.connections)\n    }\n}\n\nfunc (ep *EndpointState) AddConnection(conn net.Conn) int64 {\n    ep.mu.Lock()\n    defer ep.mu.Unlock()\n    id := atomic.AddInt64(&ep.connIDCounter, 1)\n    ep.connections[id] = conn\n    ep.ActiveConnections++\n    return id\n}\n\nfunc (ep *EndpointState) RemoveConnection(id int64) {\n    ep.mu.Lock()\n    defer ep.mu.Unlock()\n    if _, ok := ep.connections[id]; ok {\n        delete(ep.connections, id)\n        if ep.ActiveConnections > 0 "]
[588.033274, "o", "ue)\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\nfunc newServiceState(svc config.Service) *ServiceState {\r\n    ss := &ServiceState{\r\n        Name:                      svc.Name,\r\n        ListenPort:                svc.ListenPort,\r\n"]
[588.033336, "i", "{\n            ep.ActiveConnections--\n        }\n    }\n}\n\nfunc (ep *EndpointState) closeConnectionsLocked() {\n    for id, c := range ep.connections {\n        c.Close()\n        delete(ep.connections, id)\n    }\n}\n\nfunc (ep *EndpointState) Active() int {\n    ep.mu.Lock()\n    defer ep.mu.Unlock()\n    return ep.ActiveConnections\n}\n\nfunc (ep *EndpointState) IsEligible(maxConns int) bool {\n    ep.mu.Lock()\n    defer ep.mu.Unlock()\n    return ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n}\n\nfunc (s *State) RecordHealthCheck(service, address string, success bool) HealthEvent {\n    ss := s.GetService(service)\n    if ss == nil {\n        return HealthEvent{}\n    }\n    ep := s.GetEndpoint(service, address)\n    if ep == nil {\n        return HealthEvent{}\n    }\n    global := s.Global()\n    ep.mu.Lock()\n    oldState := ep.State\n    result := \"success\"\n    if !success {\n        result = \"failure\"\n    }\n    if success {\n        ep.consecSuccess++\n        "]
[588.033431, "o", "        RoutingMode:               svc.RoutingMode,\r\n        DrainTimeoutMs:            svc.DrainTimeoutMs,\r\n        MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n        listenerStop:              nil,\r\n "]
[588.03352, "i", "ep.consecFailures = 0\n        if oldState == Unknown && ep.consecSuccess >= global.HealthyThreshold {\n            ep.State = Healthy\n        } else if oldState == Unhealthy && ep.consecSuccess >= global.HealthyThreshold {\n            ep.State = Healthy\n        }\n    } else {\n        ep.consecFailures++\n        ep.consecSuccess = 0\n        if (oldState == Healthy || oldState == Unknown) && ep.consecFailures >= global.UnhealthyThreshold {\n            ep.State = Unhealthy\n            ep.Circuit.Open()\n            ep.consecFailures = 0\n            timeout := time.Duration(ss.DrainTimeoutMs) * time.Millisecond\n            go func(deadline time.Time) {\n                time.Sleep(time.Until(deadline))\n                ep.mu.Lock()\n                ep.closeConnectionsLocked()\n                ep.mu.Unlock()\n            }(time.Now().Add(timeout))\n        }\n    }\n    newState := ep.State\n    ep.mu.Unlock()\n    evt := HealthEvent{\n        Timestamp:   time.Now(),\n        Endpoint:    address,\n        OldState:    oldState,"]
[588.033593, "o", "\u001b[?2004h> import (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[588.03369, "i", "\n        NewState:    newState,\n        CheckResult: result,\n    }\n    s.logMu.Lock()\n    s.healthLog[service] = append(s.healthLog[service], evt)\n    if len(s.healthLog[service]) > 1000 {\n        s.healthLog[service] = s.healthLog[service][len(s.healthLog[service])-1000:]\n    }\n    s.logMu.Unlock()\n    return evt\n}\n\nfunc (s *State) HealthLog(service string, lastN int) []HealthEvent {\n    s.logMu.Lock()\n    defer s.logMu.Unlock()\n    events := s.healthLog[service]\n    if lastN <= 0 || lastN > len(events) {\n        lastN = len(events)\n    }\n    out := make([]HealthEvent, lastN)\n    copy(out, events[len(events)-lastN:])\n    return out\n}\n\ntype notFoundError struct {\n    msg string\n}\n\nfunc (e *notFoundError) Error() string {\n    return e.msg\n}\n\nfunc errNotFound(msg string) error {\n    return &notFoundError{msg: msg}\n}\nEOF\n"]
