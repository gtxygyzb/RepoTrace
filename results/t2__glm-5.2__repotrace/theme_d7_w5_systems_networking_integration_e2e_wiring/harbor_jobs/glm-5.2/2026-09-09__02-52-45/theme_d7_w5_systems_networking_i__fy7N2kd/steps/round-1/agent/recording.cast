[11291.713466, "o", "\u001b[?2004h> "]
[11291.713541, "o", "\\tdeps := ss.DependsOn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11291.713624, "o", "\\tss.mu.Unlock()\r\n\u001b[?2004l\r\u001b[?2004h"]
[11291.713694, "o", "> "]
[11291.713768, "o", "\\tif len(deps) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[11291.713842, "o", "> "]
[11291.713915, "o", "\\t\\treturn \"\", nil\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r"]
[11291.713987, "o", "\u001b[?2004h> "]
[11291.714115, "o", "\\tvar statuses []DependencyStatus\r\n\u001b[?2004l\r"]
[11291.714185, "o", "\u001b[?2004h> "]
