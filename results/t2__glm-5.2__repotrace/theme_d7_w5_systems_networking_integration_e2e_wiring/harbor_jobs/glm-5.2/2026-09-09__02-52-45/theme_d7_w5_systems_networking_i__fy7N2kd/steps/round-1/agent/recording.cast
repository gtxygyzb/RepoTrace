[5838.010379, "o", "    58\t\r\n    59\ttype ServiceState struct {\r\n    60\t\tmu                        sync.Mutex\r\n"]
[5838.010594, "o", "    61\t\tName                      string\r\n    62\t\tListenPort                int\r\n    63\t\tRoutingMode               string\r\n    64\t\tDrainTimeoutMs            int\r\n    65\t\tMaxConnectionsPerEndpoint int\r\n    66\t\tIdleTimeoutMs             int\r\n    67\t\tRateLimitRps              int\r\n    68\t\tRateLimitBurst            int\r\n    69\t\tRateLimitQueueDepth       int\r\n    70\t\tRateLimitQueueTimeoutMs   int\r\n    71\t\tMaxRetries                int\r\n    72\t\tRetryDelayMs              int\r\n    73\t\tRetryBackoffMultiplier    float64\r\n    74\t\tRetryMaxDelayMs           int\r\n    75\t\trateLimiter               *rateLimiter\r\n    76\t\tEndpoints                 []*EndpointState\r\n    77\t\trrIndex                   int\r\n    78\t\tListener                  net.Listener\r\n    79\t\tlistenerStop              chan struct{}\r\n    80\t\tstopping                  bool\r\n    81"]
[5838.010666, "o", "\t}\r\n    82\t\r\n    83\ttype State struct {\r\n    84\t\tmu         sync.RWMutex\r\n    85\t\tconfigPath string\r\n    86\t\tglobal     config.Global\r\n    87\t\tservices   map[string]*ServiceState\r\n    88\t\tlogMu      sync.Mutex\r\n    89\t\thealthLog  map[string][]HealthEvent\r\n    90\t\treloadCh   chan struct{}\r\n    91\t}\r\n    92\t\r\n    93\tfunc NewState(cfg *config.Config, path string) *State {\r\n    94\t\ts := &State{\r\n    95\t\t\tconfigPath: path,\r\n    96\t\t\tservices:   make(map[string]*ServiceState),\r\n    97\t\t\thealthLog:  make(map[string][]HealthEvent),\r\n    98\t\t\treloadCh:   make(chan struct{}, 1),\r\n    99\t\t}\r\n   100"]
[5838.010683, "o", "\t\ts.applyConfigLocked(cfg)\r\n   101\t\treturn s\r\n   102\t}\r\n"]
[5838.010761, "o", "   103\t\r\n   104\tfunc (s *State) ReloadChan() <-chan struct{} {\r\n   105\t\treturn s.reloadCh\r\n   106\t}\r\n   107\t\r\n   108\tfunc (s *State) ConfigPath() string {\r\n   109\t\ts.mu.RLock()\r\n   110\t\tdefer s.mu.RUnlock()\r\n"]
