[4141.465068, "o", "   181\t\t\tRateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,\r\n   182\t\t\tMaxRetries:                svc.MaxRetries,\r\n   183\t\t\tRetryDelayMs:              svc.RetryDelayMs,\r\n   184\t\t\tRetryBackoffMultiplier:    svc.RetryBackoffMultiplier,\r\n   185\t\t\tRetryMaxDelayMs:           svc.RetryMaxDelayMs,\r\n"]
[4141.465213, "o", "   186\t\t\trateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),\r\n   187\t\t\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n   188\t\t\tlistenerStop:              nil,\r\n   189\t\t}\r\n   190\t\tfor _, ep := range svc.Endpoints {\r\n   191\t\t\tss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))\r\n   192\t\t}\r\n   193\t\treturn ss\r\n   194\t}\r\n   195\t\r\n   196\tfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n   197\t\tss.mu.Lock()\r\n   198\t\tdefer ss.mu.Unlock()\r\n   199\t\tseen := make(map[string]bool)\r\n   200\t\tfor _, cep := range eps {\r\n   201\t\t\tseen[cep.Address] = true\r\n   202\t\t\tvar ep *EndpointState\r\n   203\t"]
[4141.465286, "o", "\t\tfor _, existing := range ss.Endpoints {\r\n   204\t\t\t\tif existing.Address == cep.Address {\r\n   205\t\t\t\t\tep = existing\r\n   206\t\t\t\t\tbreak\r\n   207\t\t\t\t}\r\n   208\t\t\t}\r\n   209\t\t\tif ep == nil {\r\n   210\t\t\t\tep = newEndpointState(cep, global)\r\n   211\t\t\t\tss.Endpoints = append(ss.Endpoints, ep)\r\n   212\t\t\t} else {\r\n"]
[4141.465413, "o", "   213\t\t\t\tep.mu.Lock()\r\n   214\t\t\t\tep.Config = cep\r\n   215\t\t\t\tep.Weight = cep.Weight\r\n   216\t\t\t\tep.mu.Unlock()\r\n   217\t\t\t}\r\n   218\t\t}\r\n   219\t\tfor _, ep := range ss.Endpoints {\r\n   220\t\t\tif !seen[ep.Address] {\r\n   221\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   222\t\t\t}\r\n   223\t\t}\r\n   224\t}\r\n   225\t\r\n   226\tfunc newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {\r\n   227\t\treturn &EndpointState{\r\n   228"]
[4141.465472, "o", "\t\t\tAddress:     cep.Address,\r\n   229\t\t\tWeight:      cep.Weight,\r\n   230\t\t\tConfig:      cep,\r\n   231\t\t\tState:       Unknown,"]
[4141.465536, "o", "\r\n   232\t\t\tCircuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n   233\t\t\tStats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n   234\t\t\tconnections: make(map[int64]net.Conn),\r\n   235\t\t}\r\n   236\t}\r\n   237\t\r\n   238\tfunc (s *State) GetService(name string) *ServiceState {\r\n   239\t\ts.mu.RLock()\r\n"]
[4141.465601, "o", "   240\t\tdefer s.mu.RUnlock()\r\n   241\t\treturn s.services[name]\r\n   242\t}\r\n   243\t\r\n   244\tfunc (s *State) Services() []*ServiceState {\r\n   245\t\ts.mu.RLock()\r\n   246\t\tdefer s.mu.RUnlock()\r\n   247\t\tout := make([]*ServiceState, 0, len(s.services))\r\n   248\t\tfor _, ss := range s.services {\r\n"]
[4141.465674, "o", "   249\t\t\tout = append(out, ss)\r\n   250\t\t}\r\n   251\t\treturn out\r\n   252\t}\r\n   253\t\r\n   254\tfunc (s *State) GetEndpoint(service, address string) *EndpointState {\r\n   255\t\tss := s.GetService(service)\r\n   256\t\tif ss == nil {\r\n   257\t\t\treturn nil\r\n   258\t\t}\r\n"]
[4141.465738, "o", "   259\t\tss.mu.Lock()\r\n   260\t\tdefer ss.mu.Unlock()\r\n   261\t\tfor _, ep := range ss.Endpoints {\r\n   262\t\t\tif ep.Address == address {\r\n   263\t\t\t\treturn ep\r\n   264\t\t\t}\r\n   265\t\t}\r\n   266\t\treturn nil\r\n   267\t}\r\n"]
[4141.465796, "o", "   268\t\r\n   269\tfunc (s *State) SetWeight(service, address string, weight int) error {\r\n   270\t\tep := s.GetEndpoint(service, address)\r\n   271\t\tif ep == nil {\r\n   272\t\t\treturn errNotFound(\"endpoint not found\")\r\n   273\t\t}\r\n   274\t\tep.mu.Lock()\r\n   275\t\tdefer ep.mu.Unlock()\r\n"]
[4141.465854, "o", "   276\t\tif weight < 0 {\r\n   277\t\t\tweight = 0\r\n   278\t\t}\r\n   279\t\tep.Weight = weight\r\n   280\t\treturn nil\r\n   281\t}\r\n   282\t\r\n   283\tfunc (s *State) DrainEndpoint(service, address string) error {\r\n   284\t\tss := s.GetService(service)\r\n   285\t\tif ss == nil {\r\n"]
[4141.465919, "o", "   286\t\t\treturn errNotFound(\"service not found\")\r\n   287\t\t}\r\n   288\t\tep := s.GetEndpoint(service, address)\r\n   289\t\tif ep == nil {\r\n   290\t\t\treturn errNotFound(\"endpoint not found\")\r\n   291\t\t}\r\n   292\t\tep.StartDraining(ss.DrainTimeoutMs, false)\r\n   293\t\t"]
[4141.465976, "o", "return nil\r\n   294\t}\r\n   295\t\r\n   296\tfunc (s *State) ResetCircuitBreaker(service, address string) error {\r\n   297\t\tep := s.GetEndpoint(service, address)\r\n   298\t\tif ep == nil {\r\n   299\t\t\treturn errNotFound(\"endpoint not found\")\r\n   300\t\t}\r\n   301\t\tep.Circuit.Reset()\r\n   302\t"]
[4141.466038, "o", "\treturn nil\r\n   303\t}\r\n   304\t\r\n   305\tfunc (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {\r\n   306\t\tep.mu.Lock()\r\n   307\t\tdefer ep.mu.Unlock()\r\n   308\t\tep.State = Draining\r\n   309\t\tep.consecSuccess = 0\r\n   310\t\t"]
[4141.466097, "o", "ep.consecFailures = 0\r\n   311\t\tep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\r\n   312\t\tif markRemoved {\r\n   313\t\t\tep.removed = true\r\n   314\t\t}\r\n   315\t\tif len(ep.connections) > 0 {\r\n   316\t\t\tgo func(deadline time.Time, conns map[int64]net.Conn) {\r\n   317\t\t\t\ttime.Sleep(time.Until(deadline))\r\n   318\t\t\t\tep.closeConnectionsLocked()\r\n   319\t\t\t}(ep.drainDeadline, ep.connections)\r\n   320\t\t"]
[4141.466158, "o", "}\r\n   321\t}\r\n   322\t\r\n   323\tfunc (ep *EndpointState) AddConnection(conn net.Conn) int64 {\r\n   324\t\tep.mu.Lock()\r\n   325\t\tdefer ep.mu.Unlock()\r\n   326\t\tid := atomic.AddInt64(&ep.connIDCounter, 1)\r\n   327\t\tep.connections[id] = conn\r\n   328\t\tep.ActiveConnections++\r\n   329"]
[4141.46622, "o", "\t\treturn id\r\n   330\t}\r\n   331\t\r\n   332\tfunc (ep *EndpointState) RemoveConnection(id int64) {\r\n   333\t\tep.mu.Lock()\r\n   334\t\tdefer ep.mu.Unlock()\r\n   335\t\tif _, ok := ep.connections[id]; ok {\r\n   336\t\t\tdelete(ep.connections, id)\r\n   337\t\t\tif ep.ActiveConnections > 0 {\r\n   338\t\t\t"]
[4141.466276, "o", "\tep.ActiveConnections--\r\n   339\t\t\t}\r\n   340\t\t}\r\n   341\t}\r\n   342\t\r\n   343\tfunc (ep *EndpointState) closeConnectionsLocked() {\r\n   344\t\tfor id, c := range ep.connections {\r\n   345\t\t\tc.Close()\r\n"]
[4141.466334, "o", "   346\t\t\tdelete(ep.connections, id)\r\n   347\t\t}\r\n   348\t}\r\n   349\t\r\n   350\tfunc (ep *EndpointState) Active() int {\r\n   351\t\tep.mu.Lock()\r\n   352\t\tdefer ep.mu.Unlock()\r\n   353\t\treturn ep.ActiveConnections\r\n   354\t}\r\n   355\t\r\n   356\t"]
[4141.466399, "o", "func (ep *EndpointState) IsEligible(maxConns int) bool {\r\n   357\t\tep.mu.Lock()\r\n   358\t\tdefer ep.mu.Unlock()\r\n   359\t\treturn ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n   360\t}\r\n"]
