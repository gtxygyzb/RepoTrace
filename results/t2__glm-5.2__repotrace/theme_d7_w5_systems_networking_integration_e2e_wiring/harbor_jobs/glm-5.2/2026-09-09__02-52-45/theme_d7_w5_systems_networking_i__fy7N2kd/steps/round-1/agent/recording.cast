[13009.971014, "o", "tive = false\r\ninternal/circuit/breaker.go:85:// AcquireProbe attempts to take the single allowed half-open probe connection.\r\ninternal/circuit/breaker.go:86:func (b *Breaker) AcquireProbe() bool {\r\ninternal/circuit/breaker.go:89:\tif b.state == HalfOpen && !b.probeActive {\r\ninternal/circuit/breaker.go:90:\t\tb.probeActive = true\r\ninternal/circuit/breaker.go:96:// ProbeSuccess closes the circuit and clears failure counts.\r\ninternal/circuit/breaker.go:97:func (b *Breaker) ProbeSuccess() {\r\ninternal/circuit/breaker.go:104:\tb.probeActive = false\r\ninternal/circuit/breaker.go:107:// ProbeFailure reopens the circuit and restarts the timeout.\r\ninternal/circuit/breaker.go:108:func (b *Breaker) ProbeFailure() {\r\ninternal/circuit/breaker.go:116:\tb.probeActive = false\r\ninternal/circuit/breaker.go:128:\tb.probeActive = false\r\ninternal/circuit/breaker.go:145:// ProbeActive returns whether a probe connection is currently active.\r\ninternal/circuit/breaker.go:146:func (b *Breaker) ProbeActive() bool {\r\ninternal/circuit/breaker.go"]
