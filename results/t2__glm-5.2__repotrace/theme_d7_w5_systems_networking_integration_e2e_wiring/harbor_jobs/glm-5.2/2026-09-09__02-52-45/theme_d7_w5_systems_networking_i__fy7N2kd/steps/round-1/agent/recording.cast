[12942.036547, "o", "\u001b[?2004l\r"]
[12942.039475, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n"]
[12942.039549, "o", "\t\"fmt\"\r\n\t\"net\"\r\n\t\"os\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\ntype request struct {\r\n\tCmd  string          `json:\"cmd\"`\r\n\tArgs json.RawMessage `json:\"args\"`\r\n}\r\n\r\n"]
[12942.039616, "o", "type response struct {\r\n\tStatus string          `json:\"status\"`\r\n\tData   json.RawMessage `json:\"data\"`\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl <command> [args]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcliCmd := os.Args[1]\r\n\targs := make(map[string]interface{})\r\n"]
[12942.039681, "o", "\tvar ipcCmd string\r\n\r\n\tswitch cliCmd {\r\n\tcase \"status\":\r\n\t\tipcCmd = \"list_services\"\r\n\tcase \"stats\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")\r\n\t\t\tos.Exit(1)\r\n"]
[12942.039741, "o", "\t\t}\r\n\t\tipcCmd = \"get_stats\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"set-weight\":\r\n\t\tif len(os.Args) < 5 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tweight, err := strconv.Atoi(os.Args[4])\r\n\t"]
[12942.039798, "o", "\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid weight: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"set_weight\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n"]
[12942.039856, "o", "\t\targs[\"address\"] = os.Args[3]\r\n\t\targs[\"weight\"] = weight\r\n\tcase \"drain\":\r\n\t\tif len(os.Args) < 4 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"drain_endpoint\"\r\n"]
[12942.039918, "o", "\t\targs[\"name\"] = os.Args[2]\r\n\t\targs[\"address\"] = os.Args[3]\r\n\tcase \"health-log\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_health_log\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\tlast := 20\r\n\t\tfor _, a := range os.Args[3:] {"]
[12942.039979, "o", "\r\n\t\t\tif strings.HasPrefix(a, \"--last\") && len(a) > 6 {\r\n\t\t\t\tif v, err := strconv.Atoi(a[6:]); err == nil {\r\n\t\t\t\t\tlast = v\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}"]
[12942.040035, "o", "\r\n\t\targs[\"last_n\"] = last\r\n\tcase \"resolve\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl resolve <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"resolve\"\r\n"]
[12942.040095, "o", "\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"circuits\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_circuit_breakers\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"reset-circuit\":\r\n\t\t"]
[12942.040152, "o", "if len(os.Args) < 4 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl reset-circuit <service> <endpoint>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"reset_circuit_breaker\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\targs[\"address\"] = os.Args[3]\r\n\tcase \"reload\":\r\n\t\tipcCmd = \"reload_config\"\r\n\tcase \"rate-limit\":\r\n\t\tif len(os.Args) < 3 {\r\n"]
[12942.040213, "o", "\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl rate-limit <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_rate_limit_status\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"warmup\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl warmup <service>\")\r\n\t"]
[12942.040269, "o", "\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_warmup_status\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"connections\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl connections <service>\")\r\n"]
[12942.040331, "o", "\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_connections\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"set-rate-limit\":\r\n\t\tif len(os.Args) < 5 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-rate-limit <service> <rps> <burst>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\trps, err := strconv.Atoi(os.Args[3])\r\n"]
[12942.040416, "o", "\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid rps: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tburst, err := strconv.Atoi(os.Args[4])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid burst: %v\\n\", err)\r\n"]
[12942.040476, "o", "\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"set_rate_limit\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\targs[\"rps\"] = rps\r\n\t\targs[\"burst\"] = burst\r\n\tcase \"access-log\":\r\n\t\tipcCmd = \"get_access_log\"\r\n\t\tlast := 20\r\n\t\trest := os.Args[2:]\r\n\t\tfor i := 0; i < len(rest); i++ {\r\n\t\t\ta := rest[i]\r\n\t\t"]
[12942.040532, "o", "\tif a == \"--last\" {\r\n\t\t\t\tif i+1 < len(rest) {\r\n\t\t\t\t\tif v, err := strconv.Atoi(rest[i+1]); err == nil {\r\n\t\t\t\t\t\tlast = v\r\n\t\t\t\t\t}\r\n\t\t\t\t\ti++\r\n"]
[12942.040591, "o", "\t\t\t\t}\r\n\t\t\t} else if strings.HasPrefix(a, \"--last=\") {\r\n\t\t\t\tif v, err := strconv.Atoi(a[len(\"--last=\"):]); err == nil {\r\n\t\t\t\t\tlast = v\r\n\t\t\t\t}\r\n\t\t\t} else if a == \"--result\" {\r\n\t\t\t\tif i+1 < len(rest) {\r\n"]
[12942.040647, "o", "\t\t\t\t\targs[\"result\"] = rest[i+1]\r\n\t\t\t\t\ti++\r\n\t\t\t\t}\r\n\t\t\t} else if strings.HasPrefix(a, \"--result=\") {\r\n\t\t\t\targs[\"result\"] = a[len(\"--result=\"):]\r\n\t\t\t} else if !strings.HasPrefix(a, \"-\") {\r\n\t\t\t\targs[\"service\"] = a\r\n\t\t\t}\r\n\t\t}"]
[12942.040711, "o", "\r\n\t\targs[\"last_n\"] = last\r\n\tcase \"access-stats\":\r\n\t\tipcCmd = \"get_access_stats\"\r\n\t\tfor _, a := range os.Args[2:] {\r\n\t\t\tif !strings.HasPrefix(a, \"-\") {\r\n\t\t\t\targs[\"service\"] = a\r\n\t\t\t}\r\n"]
[12942.040774, "o", "\t\t}\r\n\tcase \"deps\":\r\n\t\tif len(os.Args) >= 3 {\r\n\t\t\tipcCmd = \"get_dependencies\"\r\n\t\t\targs[\"name\"] = os.Args[2]\r\n\t\t} else {\r\n\t\t\tout, err := depsAll()\r\n\t\t\tif err != nil {\r\n"]
[12942.04083, "o", "\t\t\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\t\t\tos.Exit(1)\r\n\t\t\t}\r\n\t\t\tfmt.Println(out)\r\n\t\t\treturn\r\n\t\t}\r\n\tdefault:"]
[12942.040885, "o", "\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cliCmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tdata, err := sendCommand(ipcCmd, args)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n"]
[12942.040941, "o", "\tfmt.Println(data)\r\n}\r\n\r\nfunc sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n\tdata, err := sendRaw(ipcCmd, args)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\treturn prettyData(ipcCmd, data)\r\n}\r\n\r\nfunc depsAll() (string, error) {\r\n\traw, err := sendRaw(\"list_services\", nil)\r\n"]
[12942.040997, "o", "\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tvar services []struct {\r\n\t\tName string `json:\"name\"`\r\n\t}\r\n\tif err := json.Unmarshal(raw, &services); err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\ttype depRow struct {\r\n"]
[12942.041059, "o", "\t\tService          string\r\n\t\tName             string\r\n\t\tAvailable        bool\r\n\t\tHealthyEndpoints int\r\n\t}\r\n\tvar rows []depRow\r\n\tfor _, svc := range services {\r\n\t\tdepRaw, err := sendRaw(\"get_dependencies\", map[string]interface{}{\"name\": svc.Name})\r\n\t\tif err != nil {\r\n\t\t"]
[12942.041115, "o", "\treturn \"\", err\r\n\t\t}\r\n\t\tvar resp struct {\r\n\t\t\tService      string `json:\"service\"`\r\n\t\t\tDependencies []struct {\r\n\t\t\t\tName             string `json:\"name\"`\r\n\t\t\t\tAvailable        bool   `json:\"available\"`\r\n"]
[12942.041177, "o", "\t\t\t\tHealthyEndpoints int    `json:\"healthy_endpoints\"`\r\n\t\t\t} `json:\"dependencies\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(depRaw, &resp); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\tfor _, dep := range resp.Dependencies {\r\n\t\t\trows = append(rows, depRow{Service: svc.Name, Name: dep.Name, Available: dep.Available, HealthyEndpoints: dep.HealthyEndpoints})\r\n\t\t}\r\n"]
[12942.041233, "o", "\t}\r\n\tif len(rows) == 0 {\r\n\t\treturn \"no dependencies\", nil\r\n\t}\r\n\tvar b strings.Builder\r\n\tfmt.Fprintf(&b, \"%-14s %-14s %-10s %-18s\\n\", \"SERVICE\", \"DEPENDS_ON\", \"AVAILABLE\", \"HEALTHY_ENDPOINTS\")\r\n\tfor _, row := range rows {\r\n\t\tfmt.Fprintf(&b, \"%-14s %-14s %-10t %-18d\\n\", row.Service, row.Name, row.Available, row.HealthyEndpoints)\r\n\t"]
[12942.041293, "o", "}\r\n\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n}\r\n\r\nfunc sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {\r\n\trawArgs, err := json.Marshal(args)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n"]
[12942.04135, "o", "\treq := request{Cmd: ipcCmd, Args: rawArgs}\r\n\treqBytes, err := json.Marshal(req)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\r\n\tconn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\tif err != nil {\r\n\t\treturn nil, fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n"]
[12942.041414, "o", "\t}\r\n\tdefer conn.Close()\r\n\r\n\tfmt.Fprintf(conn, \"%s\\n\", string(reqBytes))\r\n\r\n\treader := bufio.NewReader(conn)\r\n\tline, err := reader.ReadString('\\n')\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n"]
[12942.041473, "o", "\t}\r\n\tline = strings.TrimRight(line, \"\\r\\n\")\r\n\r\n\tvar resp response\r\n\tif err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif resp.Status != \"ok\" {\r\n\t\tvar msg string\r\n\t\tif err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n\t\t\treturn nil, fmt.Errorf(\"%s\", msg)\r\n"]
[12942.041535, "o", "\t\t}\r\n\t\treturn nil, fmt.Errorf(\"%s\", string(resp.Data))\r\n\t}\r\n\treturn resp.Data, nil\r\n}\r\n\r\nfunc prettyData(ipcCmd string, data json.RawMessage) (string, error) {\r\n\tswitch ipcCmd {\r\n\tcase \"list_services\":\r\n\t\tvar services []struct {\r\n"]
[12942.041591, "o", "\t\t\tName        string `json:\"name\"`\r\n\t\t\tListenPort  int    `json:\"listen_port\"`\r\n\t\t\tRoutingMode string `json:\"routing_mode\"`\r\n\t\t\tEndpoints   []struct {\r\n\t\t\t\tAddress           string `json:\"address\"`\r\n\t\t\t\tState             string `json:\"state\"`\r\n\t\t\t\tWeight            int    `json:\"weight\"`\r\n\t\t\t\tActiveConnections int    `json:\"active_connections\"`\r\n"]
[12942.041652, "o", "\t\t\t\tCircuitState      string `json:\"circuit_state\"`\r\n\t\t\t} `json:\"endpoints\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(data, &services); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\tvar b strings.Builder\r\n\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\r\n"]
[12942.041712, "o", "\t\tfor _, svc := range services {\r\n\t\t\tfor _, ep := range svc.Endpoints {\r\n\t\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n"]
[12942.041771, "o", "\tcase \"resolve\":\r\n\t\tvar addr string\r\n\t\tif err := json.Unmarshal(data, &addr); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\treturn addr, nil\r\n\tcase \"get_circuit_breakers\":\r\n\t\tvar circuits []struct {\r\n\t\t\tAddress             string `json:\"address\"`\r\n"]
[12942.041824, "o", "\t\t\tCircuitState        string `json:\"circuit_state\"`\r\n"]
