[4890.920264, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/stats/stats.go')\nlines = p.read_text().splitlines()\nout = []\nfor i, line in enumerate(lines, start=1):\n    out.append(line)\n    if line.strip() == 'retrySuccesses int' and i < 30:\n        out.append('\\tidleTimeouts   int')\n    if line == '}' and i == 89:\n        out.append('')\n        out.append('// RecordIdleTimeout records a connection that was closed because it was idle.')\n        out.append('func (c *Collector) RecordIdleTimeout() {')\n        out.append('\\tc.mu.Lock()')\n        out.append('\\tdefer c.mu.Unlock()')\n        out.append('\\tc.idleTimeouts++')\n        out.append('}')\n    if line.strip() == 'RetrySuccesses:      c.retrySuccesses,' and i == 152:\n        out.append('\\t\\tIdleTimeouts:   c.idleTimeouts,')\n    if line.strip() == 'RetrySuccesses      int     `json:\"retry_successes\"`' and i == 169:\n        out.append('\\tIdleTimeouts        int     `json:\"idle_timeouts\"`')\np.write_text('\\n'.join(out) + '\\n')\nPY\n"]
