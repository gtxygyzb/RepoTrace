[1043.511231, "i", "cat > internal/router/router.go <<'EOF'\npackage router\n\nimport (\n    \"io\"\n    \"log\"\n    \"net\"\n    \"sync\"\n    \"time\"\n\n    \"meshrouter/internal/state\"\n)\n\ntype serviceListener struct {\n    service  string\n    port     int\n    listener net.Listener\n    stop     chan struct{}\n    wg       sync.WaitGroup\n    done     chan struct{}\n}\n\ntype Router struct {\n    state     *state.State\n    mu        sync.Mutex\n    listeners map[string]*serviceListener\n}\n\nfunc NewRouter(s *state.State) *Router {\n    return &Router{\n        state:     s,\n        listeners: make(map[string]*serviceListener),\n    }\n}\n\nfunc (r *Router) Start() {\n    for _, ss := range r.state.Services() {\n        if !ss.IsStopping() {\n            r.startService(ss)\n        }\n    }\n}\n\nfunc (r *Router) Reload() {\n    services := r.state.Services()\n    seen := make(map[string]bool)\n    for _, ss := range services {\n        seen[ss.Name] = true\n        r.mu.Lock()\n        sl, ok := r.listeners[ss.Name]\n        r.mu.Unlock()\n        if !ok {\n            if !ss.Is"]
[1043.511534, "i", "Stopping() {\n                r.startService(ss)\n            }\n            continue\n        }\n        if sl.port != ss.ListenPort {\n            r.stopService(ss.Name, true)\n            r.startService(ss)\n        }\n    }\n    r.mu.Lock()\n    for name := range r.listeners {\n        if !seen[name] {\n            r.mu.Unlock()\n            r.stopService(name, true)\n            r.mu.Lock()\n        }\n    }\n    r.mu.Unlock()\n}\n\nfunc (r *Router) startService(ss *state.ServiceState) {\n    addr := \":\" + intToStr(ss.ListenPort)\n    ln, err := net.Listen(\"tcp\", addr)\n    if err != nil {\n        log.Printf(\"router: listen %s on %s failed: %v\", ss.Name, addr, err)\n        return\n    }\n    sl := &serviceListener{\n        service:  ss.Name,\n        port:     ss.ListenPort,\n        listener: ln,\n        stop:     make(chan struct{}),\n        done:     make(chan struct{}),\n    }\n    r.mu.Lock()\n    r.listeners[ss.Name] = sl\n    r.mu.Unlock()\n    go sl.acceptLoop(r)\n}\n\nfunc (r *Router) stopService(name string, drain bool) {\n    r.m"]
[1043.511658, "i", "u.Lock()\n    sl, ok := r.listeners[name]\n    if ok {\n        delete(r.listeners, name)\n    }\n    r.mu.Unlock()\n    if !ok {\n        return\n    }\n    sl.stopAccept(drain, r)\n}\n\nfunc (r *Router) Stop() {\n    r.mu.Lock()\n    listeners := r.listeners\n    r.listeners = make(map[string]*serviceListener)\n    r.mu.Unlock()\n    var wg sync.WaitGroup\n    for name, sl := range listeners {\n        wg.Add(1)\n        go func(name string, sl *serviceListener) {\n            defer wg.Done()\n            sl.stopAccept(true, r)\n        }(name, sl)\n    }\n    wg.Wait()\n}\n\nfunc (sl *serviceListener) acceptLoop(r *Router) {\n    defer close(sl.done)\n    for {\n        conn, err := sl.listener.Accept()\n        if err != nil {\n            return\n        }\n        sl.wg.Add(1)\n        go func(c net.Conn) {\n            defer sl.wg.Done()\n            r.handleConn(sl.service, c)\n        }(conn)\n    }\n}\n\nfunc (sl *serviceListener) stopAccept(drain bool, r *Router) {\n    select {\n    case <-sl.stop:\n    default:\n        close(sl.stop)\n    }\n "]
[1043.511756, "i", "   sl.listener.Close()\n    <-sl.done\n    if drain {\n        ss := r.state.GetService(sl.service)\n        timeout := 5 * time.Second\n        if ss != nil {\n            timeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond\n            if timeout <= 0 {\n                timeout = 5 * time.Second\n            }\n        }\n        done := make(chan struct{})\n        go func() {\n            sl.wg.Wait()\n            close(done)\n        }()\n        select {\n        case <-done:\n        case <-time.After(timeout):\n            r.state.CloseServiceConnections(sl.service)\n            <-done\n        }\n    } else {\n        sl.wg.Wait()\n    }\n}\n\nfunc (r *Router) handleConn(service string, client net.Conn) {\n    start := time.Now()\n    res, err := r.state.SelectEndpoint(service)\n    if err != nil {\n        if cand, cerr := r.state.SelectCandidate(service); cerr == nil {\n            ss := r.state.GetService(service)\n            if ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\n                cand.Stats.Rec"]
[1043.511854, "i", "ordRejection()\n            }\n        }\n        client.Close()\n        return\n    }\n    ep := res.Endpoint\n\n    var id int64\n    if !res.Probe {\n        var ok bool\n        id, ok = ep.TryAddConnection(client, res.MaxConns)\n        if !ok {\n            ep.Stats.RecordRejection()\n            client.Close()\n            return\n        }\n    }\n\n    backend, err := net.Dial(\"tcp\", ep.Address)\n    if err != nil {\n        if id != 0 {\n            ep.RemoveConnection(id)\n        }\n        ep.Stats.RecordConnection(0, 0, time.Since(start), true)\n        if res.Probe {\n            ep.Circuit.ProbeFailure()\n        }\n        client.Close()\n        return\n    }\n\n    if res.Probe {\n        ep.Circuit.ProbeSuccess()\n        var ok bool\n        id, ok = ep.TryAddConnection(client, res.MaxConns)\n        if !ok {\n            ep.Stats.RecordRejection()\n            backend.Close()\n            client.Close()\n            return\n        }\n    }\n\n    bytesIn, bytesOut := forward(client, backend)\n    backend.Close()\n    client.Close("]
[1043.511957, "i", ")\n    ep.RemoveConnection(id)\n    ep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)\n}\n\nfunc forward(client, backend net.Conn) (int64, int64) {\n    var bytesIn, bytesOut int64\n    var wg sync.WaitGroup\n    wg.Add(2)\n    go func() {\n        defer wg.Done()\n        n, _ := io.Copy(backend, client)\n        bytesOut = n\n        backend.Close()\n        client.Close()\n    }()\n    go func() {\n        defer wg.Done()\n        n, _ := io.Copy(client, backend)\n        bytesIn = n\n        client.Close()\n        backend.Close()\n    }()\n    wg.Wait()\n    return bytesIn, bytesOut\n}\n\nfunc intToStr(i int) string {\n    if i == 0 {\n        return \"0\"\n    }\n    var buf [12]byte\n    pos := len(buf)\n    neg := false\n    if i < 0 {\n        neg = true\n        i = -i\n    }\n    for i > 0 {\n        pos--\n        buf[pos] = byte('0' + i%10)\n        i /= 10\n    }\n    if neg {\n        pos--\n        buf[pos] = '-'\n    }\n    return string(buf[pos:])\n}\nEOF\ngofmt -w internal/router/router.go\ngo build ./...\n"]
