[8419.051754, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"flag\"\r\n     5\t\t\"log\""]
[8419.051906, "o", "\r\n     6\t\t\"os\"\r\n     7\t\t\"os/signal\"\r\n     8\t\t\"sync\"\r\n     9\t\t\"syscall\"\r\n    10\t\r\n    11\t\t\"meshrouter/internal/config\"\r\n    12\t\t\"meshrouter/internal/health\"\r\n    13\t\t\"meshrouter/internal/ipc\"\r\n    14\t\t\"meshrouter/internal/router\"\r\n    15\t\t\"meshrouter/internal/state\"\r\n    16\t)\r\n    17\t\r\n    18\tfunc main() {\r\n    19\t\tcfgPath := flag.String(\"config\", \"/app/config/services.toml\", \"path to services config\")\r\n    20\t\tflag.Parse()\r\n    21\t\r\n    22\t\tcfg, err := config.Load(*cfgPath)\r\n    23\t\tif err != nil {\r\n"]
[8419.052019, "o", "    24\t\t\tlog.Fatalf(\"config load failed: %v\", err)\r\n    25\t\t}\r\n    26\t\r\n    27\t\tst := state.NewState(cfg, *cfgPath)\r\n    28\t\tmonitor := health.NewMonitor(st, cfg)\r\n    29\t\trouter := router.NewRouter(st)\r\n    30\t\tipcServer := ipc.NewServer(st, \"/tmp/meshd.sock\")\r\n    31\t\r\n    32\t\tif err := ipcServer.Start(); err != nil {\r\n"]
[8419.052112, "o", "    33\t\t\tlog.Fatalf(\"ipc server failed: %v\", err)\r\n    34\t\t}\r\n    35\t\tmonitor.Start()\r\n    36\t\trouter.Start()\r\n    37\t\r\n    38\t\tsigCh := make(chan os.Signal, 1)\r\n    39\t\tsignal.Notify(sigCh, syscall.SIGHUP, syscall.SIGTERM, syscall.SIGINT)\r\n    40\t\tvar reloadMu sync.Mutex\r\n    41\t\tfor {\r\n    42\t\t\tsig := <-sigCh\r\n    43\t\t\tif sig == syscall.SIGHUP {\r\n    44\t\t\t\treloadMu.Lock()\r\n    45\t\t\t\tpath := st.ConfigPath()\r\n"]
[8419.052178, "o", "    46\t\t\t\tnewCfg, err := config.Load(path)\r\n    47\t\t\t\tif err != nil {\r\n    48\t\t\t\t\tlog.Printf(\"reload failed: %v\", err)\r\n    49\t\t\t\t\treloadMu.Unlock()\r\n    50\t\t\t\t\tcontinue\r\n    51\t\t\t\t}\r\n    52\t\t\t\tst.ApplyConfig(newCfg)\r\n    53\t\t\t\tmonitor.ApplyConfig(newCfg)\r\n    54\t\t\t\trouter.Reload()\r\n    55\t\t\t\treloadMu.Unlock()\r\n    56\t\t\t\tlog.Printf(\"reloaded config\")\r\n    57\t\t\t} else {\r\n    58\t\t\t\tbreak\r\n    59\t\t\t}\r\n    60\t\t}\r\n"]
[8419.052257, "o", "    61\t\r\n    62\t\tmonitor.Stop()\r\n    63\t\trouter.Stop()\r\n    64\t\tipcServer.Stop()\r\n    65\t}\r\n"]
