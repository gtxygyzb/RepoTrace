[1969.967278, "o", "     1\tpackage state\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"net\"\r\n     5\t\t\"sync\"\r\n"]
[1969.967333, "o", "     6\t\t\"sync/atomic\"\r\n     7\t\t\"time\"\r\n     8\t\r\n     9\t\t\"meshrouter/internal/circuit\"\r\n    10\t\t\"meshrouter/internal/config\"\r\n    11\t\t\"meshrouter/internal/stats\"\r\n    12\t)\r\n    13\t\r\n    14\ttype HealthState string\r\n"]
[1969.967514, "o", "    15\t\r\n    16\tconst (\r\n    17\t\tUnknown   HealthState = \"unknown\"\r\n    18\t\tHealthy   HealthState = \"healthy\"\r\n    19\t\tUnhealthy HealthState = \"unhealthy\"\r\n"]
[1969.967587, "o", "    20\t\tDraining  HealthState = \"draining\"\r\n    21\t)\r\n    22\t\r\n    23\ttype HealthEvent struct {\r\n    24\t\tTimestamp   time.Time\r\n    25\t\tEndpoint    string\r\n    26\t\tOldState    HealthState\r\n    27\t\tNewState    HealthState\r\n    28\t\tCheckResult string\r\n    29\t}\r\n    30\t\r\n    31\ttype EndpointState struct {\r\n    32\t\tmu                sync.Mutex\r\n    33\t\tAddress           string\r\n    34\t\tWeight            int\r\n    35\t\tConfig            config.Endpoint\r\n    36\t\tState             HealthState\r\n    37\t\tActiveConnections int\r\n    38\t\tCircuit           *circuit.Breaker\r\n    39\t\tStats             *stats.Collector\r\n    40\t\tconsecSuccess     int\r\n    41\t\tconsecFailures    int\r\n    42\t\tdrainDeadline     time.Time\r\n    43\t\tremoved           bool\r\n    44\t\tconnIDCounter     int64\r\n    45\t\tcurrentWeight     int\r\n    46\t\tconnections       map[int64]net.Conn\r\n    47\t}\r\n    48\t\r\n    49\t"]
[1969.967629, "o", "type ServiceState struct {\r\n    50\t\tmu                        sync.Mutex\r\n    51\t\tName                      string\r\n    52\t\tListenPort                int\r\n    53\t\tRoutingMode               string\r\n"]
[1969.967726, "o", "    54\t\tDrainTimeoutMs            int\r\n    55\t\tMaxConnectionsPerEndpoint int\r\n    56\t\tEndpoints                 []*EndpointState\r\n    57\t\trrIndex                   int\r\n    58\t\tListener                  net.Listener\r\n    59\t\tlistenerStop              chan struct{}\r\n    60\t\tstopping                  bool\r\n    61\t}\r\n    62\t\r\n    63\ttype State struct {\r\n    64\t\tmu         sync.RWMutex\r\n    65\t\tconfigPath string\r\n    66\t\tglobal     config.Global\r\n    67\t\tservices   map[string]*ServiceState\r\n    68\t\tlogMu      sync.Mutex\r\n    69\t\thealthLog  map[string][]HealthEvent\r\n    70"]
[1969.967788, "o", "\t\treloadCh   chan struct{}\r\n    71\t}\r\n    72\t\r\n    73\tfunc NewState(cfg *config.Config, path string) *State {\r\n    74\t\ts := &State{\r\n    75\t\t\tconfigPath: path,\r\n    76\t\t\tservices:   make(map[string]*ServiceState),\r\n    77\t\t\thealthLog:  make(map[string][]HealthEvent),\r\n"]
[1969.967847, "o", "    78\t\t\treloadCh:   make(chan struct{}, 1),\r\n    79\t\t}\r\n    80\t\ts.applyConfigLocked(cfg)\r\n    81\t\treturn s\r\n    82\t}\r\n    83\t\r\n    84\tfunc (s *State) ReloadChan() <-chan struct{} {\r\n    85\t\treturn s.reloadCh\r\n    86\t}\r\n"]
[1969.967906, "o", "    87\t\r\n    88\tfunc (s *State) ConfigPath() string {\r\n    89\t\ts.mu.RLock()\r\n    90\t\tdefer s.mu.RUnlock()\r\n    91\t\treturn s.configPath\r\n    92\t}\r\n    93\t\r\n    94\tfunc (s *State) Global() config.Global {\r\n    95\t\ts.mu.RLock()\r\n    96\t\tdefer s.mu.RUnlock()\r\n"]
[1969.967966, "o", "    97\t\treturn s.global\r\n    98\t}\r\n    99\t\r\n   100\tfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n   101\t\ts.mu.Lock()\r\n   102\t\tdefer s.mu.Unlock()\r\n   103\t\ts.applyConfigLocked(cfg)\r\n   104\t\tselect {\r\n   105\t\tcase s.reloadCh <- struct{}{}:\r\n"]
[1969.968029, "o", "   106\t\tdefault:\r\n   107\t\t}\r\n   108\t}\r\n   109\t\r\n   110\tfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n   111\t\ts.global = cfg.Global\r\n   112\t\tseen := make(map[string]bool)\r\n   113\t\tfor _, svc := range cfg.Services {\r\n   114\t\t\tseen[svc.Name] = true\r\n"]
[1969.96809, "o", "   115\t\t\tss := s.services[svc.Name]\r\n   116\t\t\tif ss == nil {\r\n   117\t\t\t\tss = newServiceState(svc, cfg.Global)\r\n   118\t\t\t\ts.services[svc.Name] = ss\r\n   119\t\t\t} else {\r\n   120\t\t\t\tss.mu.Lock()\r\n   121\t\t\t\tss.Name = svc.Name\r\n   122\t\t\t\tss.ListenPort = svc.ListenPort\r\n   123\t\t\t\tss.RoutingMode = svc.RoutingMode\r\n"]
[1969.968157, "o", "   124\t\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n   125\t\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n   126\t\t\t\tss.mu.Unlock()\r\n   127\t\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n   128\t\t\t}\r\n   129\t\t}\r\n   130\t\tfor name, ss := range s.services {\r\n   131\t\t\tif !seen[name] {\r\n   132\t\t\t\tss.mu.Lock()\r\n"]
[1969.968215, "o", "   133\t\t\t\tss.stopping = true\r\n   134\t\t\t\tif ss.listenerStop != nil {\r\n   135\t\t\t\t\tclose(ss.listenerStop)\r\n   136\t\t\t\t\tss.listenerStop = nil\r\n   137\t\t\t\t}\r\n   138\t\t\t\tif ss.Listener != nil {\r\n   139\t\t\t\t\tss.Listener.Close()\r\n"]
[1969.968276, "o", "   140\t\t\t\t\tss.Listener = nil\r\n   141\t\t\t\t}\r\n   142\t\t\t\tss.mu.Unlock()\r\n   143\t\t\t\tfor _, ep := range ss.Endpoints {\r\n   144\t\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n"]
[1969.968352, "o", "   145\t\t\t\t}\r\n   146\t\t\t}\r\n   147\t\t}\r\n   148\t}\r\n   149\t\r\n   150\tfunc newServiceState(svc config.Service, global config.Global) *ServiceState {\r\n   151\t\tss := &ServiceState{\r\n   152\t\t\tName:                      svc.Name,\r\n   153\t\t\tListenPort:                svc.ListenPort,\r\n   154\t\t\tRoutingMode:               svc.RoutingMode,\r\n   155\t\t"]
[1969.968432, "o", "\tDrainTimeoutMs:            svc.DrainTimeoutMs,\r\n   156\t\t\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n   157\t\t\tlistenerStop:              nil,\r\n   158\t\t}\r\n   159\t\tfor _, ep := range svc.Endpoints {\r\n   160\t\t\tss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))\r\n   161\t\t}\r\n   162\t\treturn ss\r\n   163\t}\r\n   164"]
[1969.968494, "o", "\t\r\n   165\tfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n   166\t\tss.mu.Lock()\r\n   167\t\tdefer ss.mu.Unlock()\r\n   168\t\tseen := make(map[string]bool)\r\n   169\t\tfor _, cep := range eps {\r\n   170\t\t\tseen[cep.Address] = true\r\n   171\t\t\tvar ep *EndpointState\r\n   172\t\t\tfor _, existing := range ss.Endpoints {\r\n"]
[1969.968555, "o", "   173\t\t\t\tif existing.Address == cep.Address {\r\n   174\t\t\t\t\tep = existing\r\n   175\t\t\t\t\tbreak\r\n   176\t\t\t\t}\r\n   177\t\t\t}\r\n   178\t\t\tif ep == nil {\r\n   179\t\t\t\tep = newEndpointState(cep, global)\r\n   180\t\t\t"]
[1969.968625, "o", "\tss.Endpoints = append(ss.Endpoints, ep)\r\n   181\t\t\t} else {\r\n   182\t\t\t\tep.mu.Lock()\r\n   183\t\t\t\tep.Config = cep\r\n   184\t\t\t\tep.Weight = cep.Weight\r\n   185\t\t\t\tep.mu.Unlock()\r\n   186\t\t\t}\r\n   187\t\t}\r\n   188\t\tfor _, ep := range ss.Endpoints {\r\n"]
[1969.968691, "o", "   189\t\t\tif !seen[ep.Address] {\r\n   190\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   191\t\t\t}\r\n   192\t\t}\r\n   193\t}\r\n   194\t\r\n   195\tfunc newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {\r\n   196\t\treturn &EndpointState{\r\n   197\t\t\tAddress:     cep.Address,\r\n   198\t\t"]
[1969.968754, "o", "\tWeight:      cep.Weight,\r\n   199\t\t\tConfig:      cep,\r\n   200\t\t\tState:       Unknown,\r\n   201\t\t\tCircuit:     circuit.New(time.Duration(global.CircuitBreakerTimeoutMs) * time.Millisecond),\r\n   202\t\t\tStats:       stats.New(time.Duration(global.StatsWindowSec) * time.Second),\r\n   203\t"]
[1969.968816, "o", "\t\tconnections: make(map[int64]net.Conn),\r\n   204\t\t}\r\n   205\t}\r\n   206\t\r\n   207\tfunc (s *State) GetService(name string) *ServiceState {\r\n   208\t\ts.mu.RLock()\r\n   209\t\tdefer s.mu.RUnlock()\r\n   210\t\treturn s.services[name]\r\n   211\t}\r\n   212\t\r\n   213\tfunc (s *State) Services() []*ServiceState {\r\n   214\t\ts.mu.RLock()\r\n   215\t\tdefer s.mu.RUnlock()\r\n"]
[1969.968874, "o", "   216\t\tout := make([]*ServiceState, 0, len(s.services))\r\n   217\t\tfor _, ss := range s.services {\r\n   218\t\t\tout = append(out, ss)\r\n   219\t\t}\r\n   220\t\treturn out\r\n"]
