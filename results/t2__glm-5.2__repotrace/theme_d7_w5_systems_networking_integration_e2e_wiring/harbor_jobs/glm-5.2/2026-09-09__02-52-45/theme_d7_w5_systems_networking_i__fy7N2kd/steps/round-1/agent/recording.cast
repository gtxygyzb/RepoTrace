[6817.24763, "o", "    32\t[[service]]\r\n    33\tname = \"data-store\"\r\n    34\tlisten_port = 9002\r\n    35\trouting_mode = \"least-connections\"\r\n    36\tdrain_timeout_ms = 10000\r\n"]
[6817.247744, "o", "    37\tmax_connections_per_endpoint = 3\r\n    38\tconnection_limit_mode = \"per-service\"\r\n    39\trate_limit_rps = 5\r\n    40\trate_limit_burst = 8\r\n    41\trate_limit_queue_depth = 2\r\n    42\trate_limit_queue_timeout_ms = 500\r\n    43\tmax_retries = 1\r\n    44\tretry_delay_ms = 100\r\n    45\tretry_backoff_multiplier = 2.0\r\n    46\tretry_max_delay_ms = 1000\r\n    47\t\r\n    48\t  [[service.endpoint]]\r\n    49\t  address = \"127.0.0.1:8091\"\r\n    50\t  weight = 1\r\n    51\t  health_check = \"tcp\"\r\n    52\t"]
[6817.247834, "o", "\r\n    53\t  [[service.endpoint]]\r\n    54\t  address = \"127.0.0.1:8092\"\r\n    55\t  weight = 1\r\n    56\t  health_check = \"exec\"\r\n    57\t  health_cmd = \"nc -z 127.0.0.1 8092\"\r\n    58\t\r\n"]
