[9495.299764, "o", "   163\t}\r\n   164\t\r\n   165\t// Snapshot is a JSON-friendly stats view.\r\n   166\ttype Snapshot struct {\r\n   167\t\tTotalConnections    int     `json:\"total_connections\"`\r\n   168\t\tActiveConnections   int     `json:\"active_connections\"`\r\n   169\t\tBytesIn             int64   `json:\"bytes_in\"`\r\n   170\t\tBytesOut            int64   `json:\"bytes_out\"`\r\n   171\t\tAvgLatencyMs        float64 `json:\"avg_latency_ms\"`\r\n   172\t\tErrors              int     `json:\"errors\"`\r\n   173\t\tRejectedConnections int     `json:\"rejected_connections\"`\r\n   174\t\tRateLimited         int     `json:\"rate_limited\"`\r\n   175\t\tQueued              int     `json:\"queued\"`\r\n   176\t\tQueueTimeouts       int     `json:\"queue_timeouts\"`\r\n   177\t\tRetries             int     `json:\"retries\"`\r\n   178\t\tRetrySuccesses      int     `json:\"retry_successes\"`\r\n   179\t\tIdleTimeouts        int     `json:\"idle_timeouts\"`\r\n   180\t}\r\n"]
