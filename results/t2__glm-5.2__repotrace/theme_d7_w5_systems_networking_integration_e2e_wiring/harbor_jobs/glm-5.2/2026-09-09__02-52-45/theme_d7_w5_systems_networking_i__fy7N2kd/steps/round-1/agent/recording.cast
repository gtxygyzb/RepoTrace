[7458.862594, "o", "    27\t\r\n    28\ttype Server struct {\r\n    29\t\tstate    *state.State\r\n    30\t\tpath     string\r\n    31\t\tlistener net.Listener\r\n    32\t\twg       sync.WaitGroup\r\n    33\t\tstop     chan struct{}\r\n    34\t\tdone     chan struct{}\r\n    35\t}\r\n    36\t\r\n    37\tfunc NewServer(s *state.State, path string) *Server {\r\n"]
[7458.862684, "o", "    38\t\treturn &Server{\r\n    39\t\t\tstate: s,\r\n    40\t\t\tpath:  path,\r\n    41\t\t\tstop:  make(chan struct{}),\r\n    42\t\t\tdone:  make(chan struct{}),\r\n    43\t\t}\r\n    44\t}\r\n    45\t\r\n    46\tfunc (s *Server) Start() error {\r\n"]
[7458.86275, "o", "    47\t\tos.Remove(s.path)\r\n    48\t\tln, err := net.Listen(\"unix\", s.path)\r\n    49\t\tif err != nil {\r\n    50\t\t\treturn err\r\n    51\t\t}\r\n    52\t\ts.listener = ln\r\n    53\t\tgo s.acceptLoop()\r\n    54\t\treturn nil\r\n    55\t}\r\n    56\t\r\n    57\tfunc (s *Server) Stop() {\r\n    58\t\tselect {\r\n    59\t\tcase <-s.stop:\r\n    60\t\tdefault:\r\n"]
[7458.862815, "o", "    61\t\t\tclose(s.stop)\r\n    62\t\t}\r\n    63\t\tif s.listener != nil {\r\n    64\t\t\ts.listener.Close()\r\n    65\t\t}\r\n    66\t\t<-s.done\r\n    67\t\tos.Remove(s.path)\r\n    68\t}\r\n    69\t\r\n    70\tfunc (s *Server) acceptLoop() {\r\n"]
[7458.862878, "o", "    71\t\tdefer close(s.done)\r\n    72\t\tfor {\r\n    73\t\t\tconn, err := s.listener.Accept()\r\n    74\t\t\tif err != nil {\r\n    75\t\t\t\treturn\r\n    76\t\t\t}\r\n    77\t\t\ts.wg.Add(1)\r\n"]
[7458.862933, "o", "    78\t\t\tgo s.handleConn(conn)\r\n    79\t\t}\r\n    80\t}\r\n"]
