[4406.105495, "o", "     8\t)\r\n     9\t\r\n    10\ttype EndpointView struct {\r\n    11\t\tAddress           string `json:\"address\"`\r\n    12\t\tState             string `json:\"state\"`\r\n    13\t\tWeight            int    `json:\"weight\"`\r\n    14\t\tActiveConnections int    `json:\"active_connections\"`\r\n    15\t\tCircuitState      string `json:\"circuit_state\"`\r\n    16\t}\r\n    17\t\r\n"]
[4406.10562, "o", "    18\ttype ServiceView struct {\r\n    19\t\tName        string         `json:\"name\"`\r\n    20\t\tListenPort  int            `json:\"listen_port\"`\r\n    21\t\tRoutingMode string         `json:\"routing_mode\"`\r\n    22\t\tEndpoints   []EndpointView `json:\"endpoints\"`\r\n    23\t}\r\n    24\t\r\n    25\tfunc (s *State) ServiceView(name string) (ServiceView, bool) {\r\n    26\t\tss := s.GetService(name)\r\n    27\t\tif ss == nil {\r\n    28\t\t\treturn ServiceView{}, false\r\n    29\t\t}\r\n    30\t\treturn ss.View(), true\r\n    31\t}\r\n    32\t\r\n    33\tfunc (s *State) ServicesView() []ServiceView {\r\n    34\t\tservices := s.Services()\r\n    35\t\tout := make([]ServiceView, 0, len(services))\r\n    36\t\tfor _, ss := range services {\r\n"]
[4406.105692, "o", "    37\t\t\tout = append(out, ss.View())\r\n    38\t\t}\r\n    39\t\tsort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })\r\n    40\t\treturn out\r\n    41\t}\r\n    42\t\r\n    43\tfunc (ss *ServiceState) View() ServiceView {\r\n    44\t\tss.mu.Lock()\r\n    45\t\tdefer ss.mu.Unlock()\r\n    46\t\tsv := ServiceView{\r\n    47\t\t\tName:        ss.Name,\r\n    48\t\t\tListenPort:  ss.ListenPort,\r\n"]
[4406.105813, "o", "    49\t\t\tRoutingMode: ss.RoutingMode,\r\n    50\t\t\tEndpoints:   make([]EndpointView, 0, len(ss.Endpoints)),\r\n    51\t\t}\r\n    52\t\tfor _, ep := range ss.Endpoints {\r\n    53\t\t\tep.mu.Lock()\r\n    54\t\t\tsv.Endpoints = append(sv.Endpoints, EndpointView{\r\n    55\t\t\t\tAddress:           ep.Address,\r\n    56\t\t\t\tState:             string(ep.State),\r\n    57\t\t\t\tWeight:            ep.Weight,\r\n    58\t\t\t\tActiveConnections: ep.ActiveConnections,\r\n    59\t\t\t\tCircuitState:      string(ep.Circuit.State()),\r\n    60\t\t\t})\r\n    61\t\t\tep.mu.Unlock()\r\n    62\t\t}\r\n    63\t\treturn sv\r\n    64\t}\r\n    65\t\r\n    66\ttype StatsEndpointView struct {\r\n    67\t\tAddress string `json:\"address\"`\r\n"]
