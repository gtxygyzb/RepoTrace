[10650.93834, "o", "\t\tseen := make(map[string]bool)\r\n   218\t\tfor _, cep := range eps {\r\n   219\t\t\tseen[cep.Address] = true\r\n   220\t\t\tvar ep *EndpointState\r\n   221\t\t\tfor _, existing := range ss.Endpoints {\r\n   222\t\t\t\tif existing.Address == cep.Address {\r\n   223\t\t\t\t\tep = existing\r\n"]
[10650.9384, "o", "   224\t\t\t\t\tbreak\r\n   225\t\t\t\t}\r\n   226\t\t\t}\r\n   227\t\t\tif ep == nil {\r\n   228\t\t\t\tep = newEndpointState(cep, global)\r\n   229\t\t\t\tss.Endpoints = append(ss.Endpoints, ep)\r\n"]
[10650.938454, "o", "   230\t\t\t} else {\r\n   231\t\t\t\tep.mu.Lock()\r\n   232\t\t\t\tep.Config = cep\r\n   233\t\t\t\tep.Weight = cep.Weight\r\n   234\t\t\t\tep.WarmupDurationMs = cep.WarmupDurationMs\r\n"]
[10650.938501, "o", "   235\t\t\t\tep.mu.Unlock()\r\n   236\t\t\t}\r\n   237\t\t}\r\n   238\t\tfor _, ep := range ss.Endpoints {\r\n   239\t\t\tif !seen[ep.Address] {\r\n   240\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n"]
[10650.939244, "o", "\u001b[?2004h"]
