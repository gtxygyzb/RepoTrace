[11667.42289, "o", "\u001b[?2004h> "]
[11667.422943, "o", "        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.423056, "o", "                return nil, err\r\n\u001b[?2004l\r"]
[11667.423084, "o", "\u001b[?2004h> "]
[11667.423144, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.423286, "o", "        line = strings.TrimRight(line, \"\\\\r\\\\n\")\r\n\u001b[?2004l\r"]
[11667.423337, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.423424, "o", "        var resp response\r\n\u001b[?2004l\r"]
[11667.423455, "o", "\u001b[?2004h> "]
[11667.423645, "o", "        if err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n\u001b[?2004l\r"]
[11667.423697, "o", "\u001b[?2004h> "]
[11667.42377, "o", "                return nil, err\r\n\u001b[?2004l\r\u001b[?2004h"]
[11667.423822, "o", ">         }\r\n\u001b[?2004l\r"]
[11667.423873, "o", "\u001b[?2004h> "]
[11667.423956, "o", "        if resp.Status != \"ok\" {\r\n\u001b[?2004l\r"]
[11667.424007, "o", "\u001b[?2004h> "]
[11667.424079, "o", "                var msg string\r\n\u001b[?2004l\r"]
[11667.424131, "o", "\u001b[?2004h> "]
[11667.424311, "o", "                if err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n\u001b[?2004l\r"]
[11667.424363, "o", "\u001b[?2004h> "]
[11667.424512, "o", "                        return nil, fmt.Errorf(\"%s\", msg)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11667.424565, "o", ">                 }\r\n\u001b[?2004l\r"]
[11667.424617, "o", "\u001b[?2004h> "]
[11667.424711, "o", "                return nil, fmt.Errorf(\"%s\", string(resp.Data))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.424762, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.424822, "o", "        return resp.Data, nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.424879, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.424931, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.424981, "o", "if 'func depsAll()' not in s:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.425033, "o", "    s = s.replace(\r\n\u001b[?2004l\r"]
[11667.425085, "o", "\u001b[?2004h> "]
[11667.425228, "o", "'''func sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {''',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.425313, "o", "'''func depsAll() (string, error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.425431, "o", "        raw, err := sendRaw(\"list_services\", nil)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.425482, "o", "        if err != nil {\r\n\u001b[?2004l\r"]
[11667.425533, "o", "\u001b[?2004h> "]
[11667.425584, "o", "                return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.425635, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.425685, "o", "        var services []struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.425785, "o", "                Name string `json:\"name\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.425836, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.425959, "o", "        if err := json.Unmarshal(raw, &services); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.426035, "o", "                return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.426085, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.426136, "o", "        type depRow struct {\r\n\u001b[?2004l\r"]
[11667.426186, "o", "\u001b[?2004h> "]
[11667.426237, "o", "                Service          string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.426333, "o", "                Name             string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.42643, "o", "                Available        bool\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.426515, "o", "                HealthyEndpoints int\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.426565, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.426616, "o", "        var rows []depRow\r\n\u001b[?2004l\r"]
[11667.426667, "o", "\u001b[?2004h> "]
[11667.426717, "o", "        for _, svc := range services {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.426915, "o", "                depRaw, err := sendRaw(\"get_dependencies\", map[string]interface{}{\"name\": svc.Name})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.426994, "o", "                if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.427086, "o", "                        return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.427143, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.427227, "o", "                var resp struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.427356, "o", "                        Service      string `json:\"service\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.427467, "o", "                        Dependencies []struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.427614, "o", "                                Name             string `json:\"name\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.42777, "o", "                                Available         bool   `json:\"available\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.427937, "o", "                                HealthyEndpoints int    `json:\"healthy_endpoints\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.428044, "o", "                        } `json:\"dependencies\"`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.428097, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.428246, "o", "                if err := json.Unmarshal(depRaw, &resp); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.428334, "o", "                        return \"\", err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.428397, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.428514, "o", "                for _, dep := range resp.Dependencies {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.428807, "o", "                        rows = append(rows, depRow{Service: svc.Name, Name: dep.Name, Available: dep.Available, HealthyEndpoints: dep.HealthyEndpoints})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.428863, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.428917, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.428974, "o", "        if len(rows) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.429078, "o", "                return \"no dependencies\", nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.429134, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.429194, "o", "        var b strings.Builder\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.429418, "o", "        fmt.Fprintf(&b, \"%-14s %-14s %-10s %-18s\\\\n\", \"SERVICE\", \"DEPENDS_ON\", \"AVAILABLE\", \"HEALTHY_ENDPOINTS\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.429506, "o", "        for _, row := range rows {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.429746, "o", "                fmt.Fprintf(&b, \"%-14s %-14s %-10t %-18d\\\\n\", row.Service, row.Name, row.Available, row.HealthyEndpoints)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.429779, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.429906, "o", "        return strings.TrimRight(b.String(), \"\\\\n\"), nil\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.429963, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.430126, "o", "func sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.430182, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.430236, "o", "s = s.replace(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.43029, "o", "'''        case \"deps\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.430373, "o", "                ipcCmd = \"get_dependencies\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.430469, "o", "                if len(os.Args) >= 3 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.430581, "o", "                        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.430649, "o", "                } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.430743, "o", "                        args[\"name\"] = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.430797, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.430857, "o", "''',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.430913, "o", "'''        case \"deps\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.43097, "o", "                if len(os.Args) >= 3 {\r\n\u001b[?2004l\r"]
[11667.431026, "o", "\u001b[?2004h> "]
[11667.431097, "o", "                        ipcCmd = \"get_dependencies\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.431208, "o", "                        args[\"name\"] = os.Args[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.431274, "o", "                } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.431378, "o", "                        out, err := depsAll()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.431474, "o", "                        if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.431609, "o", "                                fmt.Fprintln(os.Stderr, err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.431704, "o", "                                os.Exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.431772, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.431875, "o", "                        fmt.Println(out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.431954, "o", "                        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.432009, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.432066, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11667.432098, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r"]
[11667.432167, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
