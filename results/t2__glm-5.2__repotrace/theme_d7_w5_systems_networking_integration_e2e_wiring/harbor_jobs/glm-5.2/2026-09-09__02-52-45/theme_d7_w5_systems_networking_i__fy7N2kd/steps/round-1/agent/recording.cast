[9533.910335, "o", "\tb, err := json.Marshal(e)\r\n\tif err != nil {\r\n\t\treturn\r\n\t}\r\n\tb = append(b, '\\n')\r\n\r\n\tl.mu.Lock()\r\n\tdefer l.mu.Unlock()\r\n\r\n\tif l.file == nil {\r\n"]
[9533.910446, "o", "\t\tif err := os.MkdirAll(filepath.Dir(l.path), 0755); err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n\t\tf, err := os.OpenFile(l.path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)\r\n\t\tif err != nil {\r\n\t\t\treturn\r\n\t\t}\r\n\t\tl.file = f\r\n\t\tif info, err := f.Stat(); err == nil {\r\n\t\t\tl.size = info.Size()\r\n\t\t}\r\n\t}\r\n\r\n"]
[9533.910522, "o", "\tif l.size > 0 && l.size+int64(len(b)) > maxFileSize {\r\n\t\tl.rotateLocked()\r\n"]
