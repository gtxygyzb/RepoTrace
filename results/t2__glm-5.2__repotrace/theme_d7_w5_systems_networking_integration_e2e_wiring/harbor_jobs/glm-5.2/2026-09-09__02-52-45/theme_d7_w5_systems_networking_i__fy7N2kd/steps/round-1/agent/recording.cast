[4314.407473, "o", "     1\tpackage ipc\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t"]
[4314.407565, "o", "\t\"encoding/json\"\r\n     6\t\t\"errors\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"net\"\r\n     9\t\t\"os\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t\t\"sync\"\r\n    13\t\r\n    14\t\t\"meshrouter/internal/config\"\r\n    15\t\t\"meshrouter/internal/state\"\r\n    16\t)\r\n    17\t\r\n    18\ttype Request struct {"]
[4314.407643, "o", "\r\n    19\t\tCmd  string          `json:\"cmd\"`\r\n    20\t\tArgs json.RawMessage `json:\"args\"`\r\n    21\t}\r\n    22\t\r\n    23\ttype Response struct {\r\n    24\t\tStatus string      `json:\"status\"`\r\n    25\t\tData   interface{} `json:\"data\"`\r\n    26\t}\r\n    27\t\r\n    28\ttype Server struct {\r\n    29\t\tstate    *state.State\r\n"]
[4314.407704, "o", "    30\t\tpath     string\r\n    31\t\tlistener net.Listener\r\n    32\t\twg       sync.WaitGroup\r\n    33\t\tstop     chan struct{}\r\n    34\t\tdone     chan struct{}\r\n    35\t}\r\n    36\t\r\n    37\tfunc NewServer(s *state.State, path string) *Server {\r\n    38\t\treturn &Server{\r\n    39\t\t\tstate: s,\r\n"]
[4314.407776, "o", "    40\t\t\tpath:  path,\r\n    41\t\t\tstop:  make(chan struct{}),\r\n    42\t\t\tdone:  make(chan struct{}),\r\n    43\t\t}\r\n"]
[4314.407835, "o", "    44\t}\r\n    45\t\r\n    46\tfunc (s *Server) Start() error {\r\n    47\t\tos.Remove(s.path)\r\n    48\t\tln, err := net.Listen(\"unix\", s.path)\r\n    49\t\tif err != nil {\r\n    50\t\t\treturn err\r\n    51\t\t}\r\n    52\t\ts.listener = ln\r\n    53\t\tgo s.acceptLoop()\r\n    54\t\treturn nil\r\n    55\t}\r\n    56\t\r\n    57\tfunc (s *Server) Stop() {\r\n"]
[4314.40791, "o", "    58\t\tselect {\r\n    59\t\tcase <-s.stop:\r\n    60\t\tdefault:\r\n    61\t\t\tclose(s.stop)\r\n    62\t\t}\r\n    63\t\tif s.listener != nil {\r\n    64\t\t\ts.listener.Close()\r\n    65\t\t}\r\n    66\t\t<-s.done\r\n    67\t\tos.Remove(s.path)\r\n    68\t}\r\n    69\t\r\n    70\tfunc (s *Server) acceptLoop() {"]
[4314.407967, "o", "\r\n    71\t\tdefer close(s.done)\r\n    72\t\tfor {\r\n    73\t\t\tconn, err := s.listener.Accept()\r\n    74\t\t\tif err != nil {\r\n    75\t\t\t\treturn\r\n    76\t\t\t}\r\n    77\t\t\ts.wg.Add(1)\r\n"]
[4314.408025, "o", "    78\t\t\tgo s.handleConn(conn)\r\n    79\t\t}\r\n    80\t}\r\n    81\t\r\n    82\tfunc (s *Server) handleConn(conn net.Conn) {\r\n    83\t\tdefer s.wg.Done()\r\n    84\t\tdefer conn.Close()\r\n    85\t\treader := bufio.NewReader(conn)\r\n    86\t\tfor {\r\n"]
[4314.408082, "o", "    87\t\t\tline, err := reader.ReadString('\\n')\r\n    88\t\t\tif err != nil {\r\n    89\t\t\t\treturn\r\n    90\t\t\t}\r\n    91\t\t\tline = strings.TrimRight(line, \"\\r\\n\")\r\n    92\t\t\tif line == \"\" {\r\n    93\t\t\t\tcontinue\r\n"]
[4314.408139, "o", "    94\t\t\t}\r\n    95\t\t\tresp := s.handleLine(line)\r\n    96\t\t\t_, _ = conn.Write([]byte(resp + \"\\n\"))\r\n    97\t\t}\r\n    98\t}\r\n    99\t\r\n   100\tfunc (s *Server) handleLine(line string) string {\r\n   101\t\tvar req Request\r\n"]
[4314.408197, "o", "   102\t\tif err := json.Unmarshal([]byte(line), &req); err != nil {\r\n   103\t\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n   104\t\t}\r\n   105\t\tdata, err := s.dispatch(req)\r\n   106\t\tif err != nil {\r\n   107\t\t\treturn encodeResp(Response{Status: \"error\", Data: err.Error()})\r\n   108\t\t}\r\n   109\t\treturn encodeResp(Response{Status: \"ok\", Data: data})\r\n   110\t}\r\n   111\t\r\n"]
[4314.408268, "o", "   112\tfunc encodeResp(r Response) string {\r\n   113\t\tb, _ := json.Marshal(r)\r\n   114\t\treturn string(b)\r\n   115\t}\r\n   116\t\r\n   117\tfunc (s *Server) dispatch(req Request) (interface{}, error) {\r\n   118\t\tswitch req.Cmd {\r\n   119\t\tcase \"list_services\":\r\n   120\t\t\treturn s.state.ServicesView(), nil\r\n"]
