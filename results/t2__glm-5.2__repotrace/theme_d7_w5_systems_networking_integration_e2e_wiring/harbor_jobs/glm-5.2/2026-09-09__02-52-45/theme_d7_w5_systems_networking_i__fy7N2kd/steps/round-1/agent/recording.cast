[11740.76157, "o", "\targs[\"last_n\"] = last\r\n\tcase \"access-stats\":\r\n\t\tipcCmd = \"get_access_stats\"\r\n\t\tfor _, a := range os.Args[2:] {\r\n\t\t\tif !strings.HasPrefix(a, \"-\") {\r\n\t\t\t\targs[\"service\"] = a\r\n\t\t\t}\r\n\t\t}\r\n\tcase \"deps\":\r\n\t\tipcCmd = \"get_dependencies\"\r\n\t\tif len(os.Args) >= 3 {\r\n\t\t\targs[\"name\"] = os.Args[2]\r\n\t\t} else {\r\n\t\t\targs[\"name\"] = \"\"\r\n\t\t}\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cliCmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tdata, err := sendCommand(ipcCmd, args)\r\n\tif err != nil {\r\n"]
[11740.761657, "o", "\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Println(data)\r\n}\r\n\r\nfunc sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n\trawArgs, err := json.Marshal(args)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\treq := request{Cmd: ipcCmd, Args: rawArgs}\r\n\treqBytes, err := json.Marshal(req)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n"]
[11740.761729, "o", "\t}\r\n\r\n\tconn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\tif err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n\t}\r\n\tdefer conn.Close()\r\n\r\n\tfmt.Fprintf(conn, \"%s\\n\", string(reqBytes))\r\n\r\n\treader := bufio.NewReader(conn)\r\n\tline, err := reader.ReadString('\\n')\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n"]
[11740.761793, "o", "\tline = strings.TrimRight(line, \"\\r\\n\")\r\n\r\n\tvar resp response\r\n\tif err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tif resp.Status != \"ok\" {\r\n\t\tvar msg string\r\n\t\tif err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n\t\t\treturn \"\", fmt.Errorf(\"%s\", msg)\r\n"]
[11740.761858, "o", "\t\t}\r\n\t\treturn \"\", fmt.Errorf(\"%s\", string(resp.Data))\r\n\t}\r\n\treturn prettyData(ipcCmd, resp.Data)\r\n}\r\n\r\nfunc prettyData(ipcCmd string, data json.RawMessage) (string, error) {\r\n\tswitch ipcCmd {\r\n\tcase \"list_services\":\r\n\t\tvar services []struct {\r\n"]
[11740.762453, "o", "\u001b[?2004h"]
