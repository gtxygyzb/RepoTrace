[9670.96413, "o", "func (r *Router) handleConn(service string, client net.Conn) {\r\n\tstart := time.Now()\r\n\tclientAddr := \"\"\r\n\tif addr := client.RemoteAddr(); addr != nil {\r\n\t\tclientAddr = addr.String()\r\n"]
[9670.964221, "o", "\t}\r\n"]
[9670.964288, "o", "\r\n\tvar endpoint string\r\n\tvar bytesIn, bytesOut int64\r\n\tvar result string\r\n\tvar retryCount int\r\n\tvar queueWaitMs int64\r\n\tdefer func() {\r\n\t\tif result == \"\" {\r\n\t"]
[9670.964357, "o", "\t\tresult = \"success\"\r\n\t\t}\r\n\t\tif r.accessLog != nil {\r\n\t\t\tr.accessLog.Log(accesslog.Entry{\r\n\t\t\t\tService:    service,\r\n\t\t\t\tClient:     clientAddr,\r\n\t\t\t\tEndpoint:   endpoint,\r\n\t\t"]
[9670.964469, "o", "\t\tBytesIn:    bytesIn,\r\n\t\t\t\tBytesOut:   bytesOut,\r\n\t\t\t\tDurationMs: time.Since(start).Milliseconds(),\r\n\t"]
[9670.964535, "o", "\t\t\tResult:     result,\r\n\t\t\t})\r\n"]
[9670.964601, "o", "\t\t}\r\n\t}()\r\n\r\n\tss := r.state.GetService(service)\r\n\tif ss == nil {\r\n\t\tresult = \"rejected_no_endpoint\"\r\n\t\tclient.Close()\r\n\t\treturn\r\n\t}\r\n\r\n\tallowed, queued, waitMs, timedOut := ss.AcquireRateLimitToken()\r\n\tif !allowed {\r\n"]
[9670.964675, "o", "\t\tresult = \"rejected_rate_limit\"\r\n\t\tqueueWaitMs = waitMs\r\n\t\t_ = timedOut\r\n\t\tclient.Close()\r\n\t\treturn\r\n"]
[9670.96474, "o", "\t}\r\n\tif queued {\r\n\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n\t\t\tcand.Stats.RecordQueued()\r\n\t\t}\r\n\t}\r\n"]
[9670.965278, "o", "\u001b[?2004h"]
