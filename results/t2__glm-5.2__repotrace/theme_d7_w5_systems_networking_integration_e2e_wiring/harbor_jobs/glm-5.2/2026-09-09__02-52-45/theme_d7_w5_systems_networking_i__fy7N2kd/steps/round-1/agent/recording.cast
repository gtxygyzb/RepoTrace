[2905.155743, "o", "\t\r\n     8\t// SelectResult contains selected endpoint and whether it is a half-open probe.\r\n     9\ttype SelectResult struct {\r\n    10\t\tEndpoint *EndpointState\r\n    11\t\tProbe    bool\r\n    12\t\tMaxConns int\r\n    13\t}\r\n    14\t\r\n    15\t// SelectEndpoint chooses an endpoint for the next connection.\r\n    16\tfunc (s *State) SelectEndpoint(service string) (SelectResult, error) {\r\n    17\t\tss := s.GetService(service)\r\n    18\t\tif ss == nil {\r\n    19\t\t\treturn SelectResult{}, errNotFound(\"service not found\")\r\n    20\t\t}\r\n    21\t\tss.mu.Lock()\r\n    22\t\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n    23\t\tmode := ss.RoutingMode\r\n    24\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n    25\t\tcopy(endpoints, ss.Endpoints)\r\n    26\t\tss.mu.Unlock()\r\n    27\t\r\n"]
[2905.155839, "o", "    28\t\tnow := time.Now()\r\n    29\t\t_ = now\r\n    30\t\r\n    31\t\tvar regular []*EndpointState\r\n    32\t\tfor _, ep := range endpoints {\r\n    33\t\t\tep.mu.Lock()\r\n"]
[2905.155907, "o", "    34\t\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n    35\t\t\tep.mu.Unlock()\r\n    36\t\t\tif eligible {\r\n    37\t\t\t\tregular = append(regular, ep)\r\n    38\t\t\t}\r\n    39\t\t}\r\n    40\t\r\n    41\t\tif len(regular) > 0 {\r\n    42\t\t\tif mode == \"least-connections\" {\r\n    43\t\t\t\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\r\n    44\t\t\t}\r\n    45\t\t\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\r\n    46\t\t}\r\n    47\t\r\n    48\t\tfor _, ep := range endpoints {\r\n    49\t\t\tep.mu.Lock()\r\n"]
[2905.155975, "o", "    50\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n    51\t\t\tep.mu.Unlock()\r\n    52\t\t\tif halfOpen && ep.Circuit.AcquireProbe() {\r\n    53\t\t\t\treturn SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil\r\n    54\t\t\t}\r\n    55\t\t}\r\n    56\t\treturn SelectResult{}, errNotFound(\"no eligible endpoints\")\r\n    57\t}\r\n    58\t\r\n"]
[2905.156039, "o", "    59\t// SelectCandidate returns the endpoint that would be selected ignoring connection limits.\r\n    60\t// Used to account rejected_connections when all eligible endpoints are at capacity.\r\n    61\tfunc (s *State) SelectCandidate(service string) (*EndpointState, error) {\r\n    62\t\tss := s.GetService(service)\r\n    63\t\tif ss == nil {\r\n    64\t\t\treturn nil, errNotFound(\"service not found\")\r\n    65\t\t}\r\n    66\t\tss.mu.Lock()\r\n"]
[2905.156099, "o", "    67\t\tmode := ss.RoutingMode\r\n    68\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n    69\t\tcopy(endpoints, ss.Endpoints)\r\n    70\t\tss.mu.Unlock()\r\n    71\t\r\n    72\t\tvar regular []*EndpointState\r\n    73\t\tfor _, ep := range endpoints {\r\n    74\t\t\tep.mu.Lock()\r\n    75\t\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining\r\n    76\t\t\tep.mu.Unlock()\r\n    77\t\t\tif eligible {\r\n"]
[2905.156163, "o", "    78\t\t\t\tregular = append(regular, ep)\r\n    79\t\t\t}\r\n    80\t\t}\r\n    81\t\tif len(regular) == 0 {\r\n    82\t\t\tfor _, ep := range endpoints {\r\n    83\t\t\t\tep.mu.Lock()\r\n    84\t\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining\r\n    85\t\t\t\tep.mu.Unlock()\r\n"]
[2905.156222, "o", "    86\t\t\t\tif halfOpen {\r\n    87\t\t\t\t\treturn ep, nil\r\n    88\t\t\t\t}\r\n    89\t\t\t}\r\n    90\t\t\treturn nil, errNotFound(\"no eligible endpoints\")\r\n    91\t\t}\r\n    92\t\tif mode == \"least-connections\" {\r\n    93\t\t\treturn selectLeastConnections(regular, 1<<30), nil\r\n"]
[2905.156281, "o", "    94\t\t}\r\n    95\t\treturn selectWeightedCandidate(regular), nil\r\n    96\t}\r\n"]
