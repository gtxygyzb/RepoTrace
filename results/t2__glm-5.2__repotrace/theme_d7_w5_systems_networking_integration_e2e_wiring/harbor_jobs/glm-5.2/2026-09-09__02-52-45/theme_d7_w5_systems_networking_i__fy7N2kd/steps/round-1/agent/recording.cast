[1366.957697, "i", "cat > cmd/meshctl/main.go <<'EOF'\npackage main\n\nimport (\n    \"bufio\"\n    \"encoding/json\"\n    \"fmt\"\n    \"net\"\n    \"os\"\n    \"strconv\"\n    \"strings\"\n)\n\ntype request struct {\n    Cmd  string          `json:\"cmd\"`\n    Args json.RawMessage `json:\"args\"`\n}\n\ntype response struct {\n    Status string          `json:\"status\"`\n    Data   json.RawMessage `json:\"data\"`\n}\n\nfunc main() {\n    if len(os.Args) < 2 {\n        fmt.Fprintln(os.Stderr, \"usage: meshctl <command> [args]\")\n        os.Exit(1)\n    }\n\n    cmd := os.Args[1]\n    args := make(map[string]interface{})\n\n    switch cmd {\n    case \"status\":\n    case \"stats\":\n        if len(os.Args) < 3 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n    case \"set-weight\":\n        if len(os.Args) < 5 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")\n            os.Exit(1)\n        }\n        weight, err := strconv.Atoi(os.Args[4])\n        if err !"]
[1366.957977, "i", "= nil {\n            fmt.Fprintf(os.Stderr, \"invalid weight: %v\\n\", err)\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n        args[\"address\"] = os.Args[3]\n        args[\"weight\"] = weight\n    case \"drain\":\n        if len(os.Args) < 4 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n        args[\"address\"] = os.Args[3]\n    case \"health-log\":\n        if len(os.Args) < 3 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n        last := 20\n        for _, a := range os.Args[3:] {\n            if strings.HasPrefix(a, \"--last\") && len(a) > 6 {\n                if v, err := strconv.Atoi(a[6:]); err == nil {\n                    last = v\n                }\n            }\n        }\n        args[\"last_n\"] = last\n    case \"resolve\":\n        if len(os.Args) < 3 {\n            fmt.Fprintln(os.Stderr, \"usage"]
[1366.958114, "o", "cat > cmd/meshctl/main.go <<'EOF'\r\n\u001b[?2004l\r"]
[1366.958227, "i", ": meshctl resolve <service>\")\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n    case \"circuits\":\n        if len(os.Args) < 3 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n    case \"reset-circuit\":\n        if len(os.Args) < 4 {\n            fmt.Fprintln(os.Stderr, \"usage: meshctl reset-circuit <service> <endpoint>\")\n            os.Exit(1)\n        }\n        args[\"name\"] = os.Args[2]\n        args[\"address\"] = os.Args[3]\n    case \"reload\":\n    default:\n        fmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cmd)\n        os.Exit(1)\n    }\n\n    data, err := sendCommand(cmd, args)\n    if err != nil {\n        fmt.Fprintln(os.Stderr, err)\n        os.Exit(1)\n    }\n    fmt.Println(data)\n}\n\nfunc sendCommand(cmd string, args map[string]interface{}) (string, error) {\n    rawArgs, err := json.Marshal(args)\n    if err != nil {\n        return \"\", err\n    }\n    req := request{Cmd: cmd, Args: rawArgs}\n    reqBytes,"]
[1366.95832, "o", "\u001b[?2004h> package main\r\n\u001b[?2004l\r"]
[1366.958461, "i", " err := json.Marshal(req)\n    if err != nil {\n        return \"\", err\n    }\n\n    conn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\n    if err != nil {\n        return \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\n    }\n    defer conn.Close()\n\n    fmt.Fprintf(conn, \"%s\\n\", string(reqBytes))\n\n    reader := bufio.NewReader(conn)\n    line, err := reader.ReadString('\\n')\n    if err != nil {\n        return \"\", err\n    }\n    line = strings.TrimRight(line, \"\\r\\n\")\n\n    var resp response\n    if err := json.Unmarshal([]byte(line), &resp); err != nil {\n        return \"\", err\n    }\n    if resp.Status != \"ok\" {\n        var msg string\n        if err := json.Unmarshal(resp.Data, &msg); err == nil {\n            return \"\", fmt.Errorf(\"%s\", msg)\n        }\n        return \"\", fmt.Errorf(\"%s\", string(resp.Data))\n    }\n    return prettyData(cmd, resp.Data)\n}\n\nfunc prettyData(cmd string, data json.RawMessage) (string, error) {\n    switch cmd {\n    case \"status\":\n        var services []struct {\n            Name        string `json"]
[1366.958484, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1366.958617, "i", ":\"name\"`\n            ListenPort  int    `json:\"listen_port\"`\n            RoutingMode string `json:\"routing_mode\"`\n            Endpoints   []struct {\n                Address            string `json:\"address\"`\n                State             string `json:\"state\"`\n                Weight            int    `json:\"weight\"`\n                ActiveConnections int    `json:\"active_connections\"`\n                CircuitState       string `json:\"circuit_state\"`\n            } `json:\"endpoints\"`\n        }\n        if err := json.Unmarshal(data, &services); err != nil {\n            return \"\", err\n        }\n        var b strings.Builder\n        fmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\n        for _, svc := range services {\n            for _, ep := range svc.Endpoints {\n                fmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\n            }\n        }\n      "]
[1366.95864, "o", "import (\r\n\u001b[?2004l\r\u001b[?2004h>     \"bufio\"\r\n\u001b[?2004l\r"]
[1366.958685, "i", "  return strings.TrimRight(b.String(), \"\\n\"), nil\n    case \"resolve\":\n        var addr string\n        if err := json.Unmarshal(data, &addr); err != nil {\n            return \"\", err\n        }\n        return addr, nil\n    case \"set-weight\", \"drain\", \"reset-circuit\", \"reload\":\n        var s string\n        if err := json.Unmarshal(data, &s); err != nil {\n            return \"\", err\n        }\n        return s, nil\n    default:\n        var v interface{}\n        if err := json.Unmarshal(data, &v); err != nil {\n            return \"\", err\n        }\n        b, err := json.MarshalIndent(v, \"\", \"  \")\n        if err != nil {\n            return \"\", err\n        }\n        return string(b), nil\n    }\n}\nEOF\n"]
