[8277.689639, "o", "     7\t)\r\n     8\t\r\n     9\t// Stats holds aggregated access log statistics for one result type.\r\n    10\ttype ResultStats struct {\r\n    11\t\tCount         int   `json:\"count\"`\r\n    12\t\tAvgDurationMs int64 `json:\"avg_duration_ms\"`\r\n    13\t\tTotalBytesIn  int64 `json:\"total_bytes_in\"`\r\n    14\t\tTotalBytesOut int64 `json:\"total_bytes_out\"`\r\n    15\t}\r\n    16\t\r\n    17\t// StatsResult is the response shape for get_access_stats.\r\n    18\ttype StatsResult struct {\r\n    19\t\tTotalRequests int                    `json:\"total_requests\"`\r\n    20\t\tByResult      map[string]ResultStats `json:\"by_result\"`\r\n    21\t}\r\n    22\t\r\n    23\t// ReadEntries reads and parses log entries from the backup file plus the\r\n    24\t// current log file, in chronological order. Invalid lines are skipped.\r\n    25\tfunc ReadEntries(path string) []Entry {\r\n    26\t\tvar entries []Entry\r\n    27\t\tentries = append(entries, readLogFile(path+\".1\")...)\r\n    28\t\tentries = append(entries, readLogFile(path)...)\r\n    29\t\treturn entries\r\n    30\t}\r\n    31\t\r\n    32\tfunc re"]
[8277.689728, "o", "adLogFile(path string) []Entry {\r\n    33\t\tf, err := os.Open(path)\r\n    34\t\tif err != nil {\r\n    35\t\t\treturn nil\r\n    36\t\t}\r\n    37\t\tdefer f.Close()\r\n    38\t\r\n    39\t\tvar entries []Entry\r\n    40\t\tscanner := bufio.NewScanner(f)\r\n    41\t\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\r\n    42\t\tfor scanner.Scan() {\r\n    43\t\t\tline := scanner.Bytes()\r\n    44\t\t\tif len(line) == 0 {\r\n    45\t\t\t\tcontinue\r\n    46\t\t\t}\r\n"]
[8277.689797, "o", "    47\t\t\tvar e Entry\r\n    48\t\t\tif err := json.Unmarshal(line, &e); err != nil {\r\n    49\t\t\t\tcontinue\r\n    50\t\t\t}\r\n    51\t\t\tentries = append(entries, e)\r\n    52\t\t}\r\n    53\t\treturn entries\r\n    54\t}\r\n    55\t\r\n    56\t// GetAccessLog returns filtered log entries. Filters are applied first, then the\r\n    57\t// last lastN entries are returned. If lastN is 0 or negative, all matching\r\n    58\t// entries are returned.\r\n    59"]
[8277.689859, "o", "\tfunc GetAccessLog(path, service, result string, lastN int, minDurationMs int64) []Entry {\r\n    60\t\tentries := ReadEntries(path)\r\n    61\t\r\n    62\t\tfiltered := entries[:0]\r\n    63\t\tfor _, e := range entries {\r\n    64\t\t\tif service != \"\" && e.Service != service {\r\n    65\t\t\t\tcontinue\r\n    66\t\t\t}\r\n    67\t\t\tif result != \"\" && e.Result != result {\r\n    68\t\t\t\tcontinue\r\n    69"]
[8277.689921, "o", "\t\t\t}\r\n    70\t\t\tif minDurationMs > 0 && e.DurationMs < minDurationMs {\r\n    71\t\t\t\tcontinue\r\n    72\t\t\t}\r\n    73\t\t\tfiltered = append(filtered, e)\r\n    74\t\t}\r\n    75\t\r\n    76\t\tif lastN <= 0 {\r\n    77\t\t\treturn filtered\r\n"]
[8277.689983, "o", "    78\t\t}\r\n    79\t\tif len(filtered) > lastN {\r\n    80\t\t\treturn filtered[len(filtered)-lastN:]\r\n    81\t\t}\r\n    82\t\treturn filtered\r\n    83\t}\r\n    84\t\r\n    85\t// Stats aggregates access log entries for the optional service filter.\r\n"]
[8277.69004, "o", "    86\tfunc Stats(path, service string) StatsResult {\r\n    87\t\tentries := ReadEntries(path)\r\n    88\t\r\n    89\t\ttype agg struct {\r\n    90\t\t\tcount    int\r\n    91\t\t\tduration int64\r\n    92\t\t\tbytesIn  int64\r\n"]
[8277.6901, "o", "    93\t\t\tbytesOut int64\r\n    94\t\t}\r\n    95\t\taggs := make(map[string]*agg)\r\n    96\t\ttotal := 0\r\n    97\t\r\n    98\t\tfor _, e := range entries {\r\n    99\t\t\tif service != \"\" && e.Service != service {\r\n   100\t\t\t\tcontinue\r\n   101\t\t\t}\r\n"]
[8277.690161, "o", "   102\t\t\ta := aggs[e.Result]\r\n   103\t\t\tif a == nil {\r\n   104\t\t\t\ta = &agg{}\r\n   105\t\t\t\taggs[e.Result] = a\r\n   106\t\t\t}\r\n   107\t\t\ta.count++\r\n   108\t\t\ta.duration += e.DurationMs\r\n   109\t\t\ta.bytesIn += e.BytesIn\r\n"]
[8277.690217, "o", "   110\t\t\ta.bytesOut += e.BytesOut\r\n   111\t\t\ttotal++\r\n   112\t\t}\r\n   113\t\r\n   114\t\tresult := StatsResult{\r\n   115\t\t\tTotalRequests: total,\r\n   116\t\t\tByResult:      make(map[string]Stats),\r\n   117\t\t}\r\n   118\t\t"]
[8277.690281, "o", "for name, a := range aggs {\r\n   119\t\t\tif a.count == 0 {\r\n   120\t\t\t\tcontinue\r\n   121\t\t\t}\r\n   122\t\t\tresult.ByResult[name] = ResultStats{\r\n   123\t\t\t\tCount:         a.count,\r\n   124\t\t\t\tAvgDurationMs: a.duration / int64(a.count),\r\n   125\t\t\t\tTotalBytesIn:  a.bytesIn,\r\n   126\t\t\t\tTotalBytesOut: a.bytesOut,\r\n   127\t\t\t}\r\n"]
[8277.690343, "o", "   128\t\t}\r\n   129\t\treturn result\r\n   130\t}\r\n"]
