[10569.629056, "o", "./cmd/meshctl/main.go\r\n./cmd/meshd/main.go\r\n./internal/accesslog/logger.go\r\n./internal/accesslog/query.go\r\n./internal/circuit/breaker.go\r\n./internal/config/config.go\r\n"]
