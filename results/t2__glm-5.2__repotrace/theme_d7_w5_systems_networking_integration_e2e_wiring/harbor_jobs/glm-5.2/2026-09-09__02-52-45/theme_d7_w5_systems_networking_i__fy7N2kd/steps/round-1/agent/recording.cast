[7400.964789, "o", "package main\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"net\"\r\n"]
[7400.964913, "o", "\t\"os\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n)\r\n\r\ntype request struct {\r\n\tCmd  string          `json:\"cmd\"`\r\n\tArgs json.RawMessage `json:\"args\"`\r\n}\r\n\r\ntype response struct {\r\n\tStatus string          `json:\"status\"`\r\n\tData   json.RawMessage `json:\"data\"`\r\n}\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl <command> [args]\")\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n\tcliCmd := os.Args[1]\r\n\targs := make(map[string]interface{})\r\n\tvar ipcCmd string\r\n"]
[7400.964999, "o", "\r\n\tswitch cliCmd {\r\n\tcase \"status\":\r\n\t\tipcCmd = \"list_services\"\r\n\tcase \"stats\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl stats <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_stats\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"set-weight\":\r\n\t\tif len(os.Args) < 5 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-weight <service> <endpoint> <weight>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tweight, err := strconv.Atoi(os.Args[4])\r\n"]
[7400.965077, "o", "\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid weight: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"set_weight\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\targs[\"address\"] = os.Args[3]\r\n\t\targs[\"weight\"] = weight\r\n"]
[7400.96514, "o", "\tcase \"drain\":\r\n\t\tif len(os.Args) < 4 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl drain <service> <endpoint>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"drain_endpoint\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\targs[\"address\"] = os.Args[3]\r\n\tcase \"health-log\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl health-log <service> [--last N]\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n"]
[7400.965204, "o", "\t\tipcCmd = \"get_health_log\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\tlast := 20\r\n\t\tfor _, a := range os.Args[3:] {\r\n\t\t\tif strings.HasPrefix(a, \"--last\") && len(a) > 6 {\r\n\t\t\t\tif v, err := strconv.Atoi(a[6:]); err == nil {\r\n\t\t\t\t\tlast = v\r\n\t\t\t\t}\r\n"]
[7400.965269, "o", "\t\t\t}\r\n\t\t}\r\n\t\targs[\"last_n\"] = last\r\n\tcase \"resolve\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl resolve <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"resolve\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"circuits\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl circuits <service>\")\r\n\t\t"]
[7400.965335, "o", "\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_circuit_breakers\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"reset-circuit\":\r\n\t\tif len(os.Args) < 4 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl reset-circuit <service> <endpoint>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"reset_circuit_breaker\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n"]
[7400.965444, "o", "\t\targs[\"address\"] = os.Args[3]\r\n\tcase \"reload\":\r\n\t\tipcCmd = \"reload_config\"\r\n\tcase \"rate-limit\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl rate-limit <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_rate_limit_status\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n"]
[7400.965514, "o", "\tcase \"warmup\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl warmup <service>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"get_warmup_status\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"connections\":\r\n\t\tif len(os.Args) < 3 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl connections <service>\")\r\n\t\t\tos.Exit(1)\r\n"]
[7400.965606, "o", "\t\t}\r\n\t\tipcCmd = \"get_connections\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\tcase \"set-rate-limit\":\r\n\t\tif len(os.Args) < 5 {\r\n\t\t\tfmt.Fprintln(os.Stderr, \"usage: meshctl set-rate-limit <service> <rps> <burst>\")\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\trps, err := strconv.Atoi(os.Args[3])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid rps: %v\\n\", err)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t\tburst, err := strconv.Atoi(os.Args[4])\r\n\t\tif err != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"invalid burst: %v\\n\", err)\r\n\t"]
[7400.965703, "o", "\t\tos.Exit(1)\r\n\t\t}\r\n\t\tipcCmd = \"set_rate_limit\"\r\n\t\targs[\"name\"] = os.Args[2]\r\n\t\targs[\"rps\"] = rps\r\n\t\targs[\"burst\"] = burst\r\n\tdefault:\r\n\t\tfmt.Fprintf(os.Stderr, \"unknown command: %s\\n\", cliCmd)\r\n\t\tos.Exit(1)\r\n\t}\r\n\r\n"]
[7400.965767, "o", "\tdata, err := sendCommand(ipcCmd, args)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n\tfmt.Println(data)\r\n}\r\n\r\n"]
[7400.96583, "o", "func sendCommand(ipcCmd string, args map[string]interface{}) (string, error) {\r\n\trawArgs, err := json.Marshal(args)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\treq := request{Cmd: ipcCmd, Args: rawArgs}\r\n\treqBytes, err := json.Marshal(req)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n"]
[7400.965893, "o", "\r\n\tconn, err := net.Dial(\"unix\", \"/tmp/meshd.sock\")\r\n\tif err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"connect to meshd failed: %w\", err)\r\n\t}\r\n\tdefer conn.Close()\r\n\r\n\tfmt.Fprintf(conn, \"%s\\n\", string(reqBytes))\r\n\r\n\treader := bufio.NewReader(conn)\r\n\tline, err := reader.ReadString('\\n')\r\n"]
[7400.965975, "o", "\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tline = strings.TrimRight(line, \"\\r\\n\")\r\n\r\n\tvar resp response\r\n\tif err := json.Unmarshal([]byte(line), &resp); err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tif resp.Status != \"ok\" {\r\n\t\tvar msg string\r\n\t\tif err := json.Unmarshal(resp.Data, &msg); err == nil {\r\n\t\t\treturn \"\", fmt.Errorf(\"%s\", msg)\r\n"]
[7400.96604, "o", "\t\t}\r\n\t\treturn \"\", fmt.Errorf(\"%s\", string(resp.Data))\r\n\t}\r\n\treturn prettyData(ipcCmd, resp.Data)\r\n}\r\n\r\nfunc prettyData(ipcCmd string, data json.RawMessage) (string, error) {\r\n\tswitch ipcCmd {\r\n\tcase \"list_services\":\r\n\t\tvar services []struct {\r\n\t\t\tName        string `json:\"name\"`\r\n\t\t\tListenPort  int    `json:\"listen_port\"`\r\n\t\t\tRoutingMode string `json:\"routing_mode\"`\r\n\t\t\tEndpoints   []struct {\r\n\t\t\t\t"]
[7400.966105, "o", "Address           string `json:\"address\"`\r\n\t\t\t\tState             string `json:\"state\"`\r\n\t\t\t\tWeight            int    `json:\"weight\"`\r\n\t\t\t\tActiveConnections int    `json:\"active_connections\"`\r\n\t\t\t\tCircuitState      string `json:\"circuit_state\"`\r\n\t\t\t} `json:\"endpoints\"`\r\n"]
[7400.966168, "o", "\t\t}\r\n\t\tif err := json.Unmarshal(data, &services); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\tvar b strings.Builder\r\n\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7s %-11s %-7s\\n\", \"SERVICE\", \"ENDPOINT\", \"STATE\", \"WEIGHT\", \"CIRCUIT\", \"ACTIVE\")\r\n\t\tfor _, svc := range services {\r\n\t\t\tfor _, ep := range svc.Endpoints {\r\n\t\t\t\tfmt.Fprintf(&b, \"%-14s %-18s %-10s %-7d %-11s %-7d\\n\", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\r\n"]
[7400.966236, "o", "\t\t\t}\r\n\t\t}\r\n\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n\tcase \"resolve\":\r\n\t\tvar addr string\r\n\t\tif err := json.Unmarshal(data, &addr); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\treturn addr, nil\r\n\tcase \"get_circuit_breakers\":\r\n\t\tvar circuits []struct {\r\n"]
[7400.966299, "o", "\t\t\tAddress             string `json:\"address\"`\r\n\t\t\tCircuitState        string `json:\"circuit_state\"`\r\n\t\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n\t\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n\t\t\tProbeActive         bool   `json:\"probe_active\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(data, &circuits); err != nil {"]
[7400.966363, "o", "\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\tvar b strings.Builder\r\n\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9s %-17s %-7s\\n\", \"ENDPOINT\", \"CIRCUIT\", \"FAILURES\", \"TIME_IN_STATE_MS\", \"PROBE\")\r\n\t\tfor _, c := range circuits {\r\n\t\t\tfmt.Fprintf(&b, \"%-18s %-11s %-9d %-17d %-7t\\n\", c.Address, c.CircuitState, c.ConsecutiveFailures, c.TimeInStateMs, c.ProbeActive)\r\n\t\t}\r\n\t\treturn strings.TrimRight(b.String(), \"\\n\"), nil\r\n"]
[7400.96645, "o", "\tcase \"get_warmup_status\":\r\n\t\tvar resp struct {\r\n\t\t\tEndpoints []struct {\r\n\t\t\t\tEndpoint          string `json:\"endpoint\"`\r\n\t\t\t\tWarmingUp         bool   `json:\"warming_up\"`\r\n\t\t\t\tWarmupRemainingMs int    `json:\"warmup_remaining_ms\"`\r\n\t\t\t\tEffectiveWeight   int    `json:\"effective_weight\"`\r\n\t\t\t\tConfigWeight      int    `json:\"config_weight\"`\r\n"]
[7400.966519, "o", "\t\t\t} `json:\"endpoints\"`\r\n\t\t}\r\n\t\tif err := json.Unmarshal(data, &resp); err != nil {\r\n\t\t\treturn \"\", err\r\n\t\t}\r\n\t\tvar b strings.Builder\r\n"]
