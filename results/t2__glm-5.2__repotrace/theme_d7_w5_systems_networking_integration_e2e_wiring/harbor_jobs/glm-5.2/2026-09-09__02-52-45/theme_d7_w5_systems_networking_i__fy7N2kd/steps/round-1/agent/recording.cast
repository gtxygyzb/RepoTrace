[2031.603458, "o", "   120\t}\r\n   121\t\r\n   122\tfunc (sl *serviceListener) acceptLoop(r *Router) {\r\n   123\t\tdefer close(sl.done)\r\n   124\t\tfor {\r\n   125\t\t\tconn, err := sl.listener.Accept()\r\n   126\t\t\tif err != nil {\r\n   127\t\t\t\treturn\r\n   128\t\t\t}\r\n   129\t\t\tsl.wg.Add(1)\r\n   130\t\t\tgo func(c net.Conn) {\r\n   131\t\t\t\tdefer sl.wg.Done()\r\n   132\t\t\t\tr.handleConn(sl.service, c)\r\n   133\t\t\t}(conn)\r\n   134\t\t}\r\n"]
