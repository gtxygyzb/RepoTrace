[10773.522919, "i", "cat internal/circuit/breaker.go\n"]
[10773.523213, "o", "cat internal/circuit/breaker.go\r\n"]
[10773.523458, "o", "\u001b[?2004l\r"]
[10773.525556, "o", "package circuit\r\n\r\nimport (\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\ntype State string\r\n\r\nconst (\r\n\tClosed   State = \"closed\"\r\n\tOpen     State = \"open\"\r\n\tHalfOpen State = \"half_open\"\r\n)\r\n\r\n// Breaker implements an endpoint circuit breaker.\r\ntype Breaker struct {\r\n\tmu                  sync.Mutex\r\n\tstate               State"]
[10773.525651, "o", "\r\n\tconsecutiveFailures int\r\n\tstateChangedAt      time.Time\r\n\topenedAt            time.Time\r\n\ttimeout             time.Duration\r\n\tprobeActive         bool\r\n}\r\n\r\n// New creates a closed breaker with the given open timeout.\r\nfunc New(timeout time.Duration) *Breaker {\r\n\tnow := time.Now()\r\n\treturn &Breaker{\r\n\t\tstate:          Closed,\r\n\t\tstateChangedAt: now,\r\n\t\topenedAt:       now,\r\n\t\ttimeout:        timeout,\r\n\t}\r\n}\r\n\r\n// State returns the current state.\r\nfunc (b *Breaker) State() State {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\treturn b.state\r\n}\r\n\r\n// IsClosed returns true if the breaker is closed.\r\nfunc (b *Breaker) IsClosed() bool {\r\n\treturn b.State() == Closed\r\n}\r\n\r\n// IsOpen returns true if the breaker is open.\r\nfunc (b *Breaker) IsOpen() bool {\r\n\treturn b.State() == Open\r\n}\r\n\r\n// IsHalfOpen returns true if the breaker is half-open.\r\nfunc (b *Breaker) IsHalfOpen() bool {\r\n\treturn b.State() == HalfOpen\r\n}\r\n\r\n"]
[10773.525761, "o", "// Open forces the breaker open and restarts the timeout clock.\r\nfunc (b *Breaker) Open() {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tnow := time.Now()\r\n\tb.state = Open\r\n\tb.stateChangedAt = now\r\n\tb.openedAt = now\r\n\tb.consecutiveFailures++\r\n\tb.probeActive = false\r\n}\r\n\r\n// MaybeHalfOpen transitions from open to half_open if the timeout has elapsed.\r\nfunc (b *Breaker) MaybeHalfOpen() bool {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tif b.state == Open && time.Since(b.openedAt) >= b.timeout {\r\n\t\tb.state = HalfOpen\r\n\t\tb.stateChangedAt = time.Now()\r\n\t\tb.probeActive = false\r\n\t\treturn true\r\n\t}\r\n\treturn false"]
[10773.525843, "o", "\r\n}\r\n\r\n// AcquireProbe attempts to take the single allowed half-open probe connection.\r\nfunc (b *Breaker) AcquireProbe() bool {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tif b.state == HalfOpen && !b.probeActive {\r\n\t\tb.probeActive = true\r\n\t\treturn true\r\n\t}\r\n\treturn false\r\n}\r\n\r\n// ProbeSuccess closes the circuit and clears failure counts.\r\nfunc (b *Breaker) ProbeSuccess() {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tnow := time.Now()\r\n\tb.state = Closed\r\n\tb.stateChangedAt = now\r\n\tb.consecutiveFailures = 0\r\n\tb.probeActive = false\r\n}\r\n\r\n// ProbeFailure reopens the circuit and restarts the timeout.\r\nfunc (b *Breaker) ProbeFailure() {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tnow := time.Now()\r\n\tb.state = Open\r\n\tb.stateChangedAt = now\r\n\tb.openedAt = now\r\n\tb.consecutiveFailures++\r\n\tb.probeActive = false\r\n}\r\n\r\n"]
[10773.525923, "o", "// Reset forces the breaker closed and clears failure counts.\r\nfunc (b *Breaker) Reset() {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\tnow := time.Now()\r\n\tb.state = Closed\r\n\tb.stateChangedAt = now\r\n\tb.openedAt = now\r\n\tb.consecutiveFailures = 0\r\n\tb.probeActive = false\r\n}\r\n\r\n// ConsecutiveFailures returns the current failure count.\r\nfunc (b *Breaker) ConsecutiveFailures() int {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\treturn b.consecutiveFailures\r\n}\r\n\r\n// TimeInStateMs returns milliseconds since the last state transition.\r\nfunc (b *Breaker) TimeInStateMs() int64 {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\treturn time.Since(b.stateChangedAt).Milliseconds()\r\n}\r\n\r\n// ProbeActive returns whether a probe connection is currently active.\r\nfunc (b *Breaker) ProbeActive() bool {\r\n\tb.mu.Lock()\r\n\tdefer b.mu.Unlock()\r\n\treturn b.probeActive\r\n}\r\n"]
