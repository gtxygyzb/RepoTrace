[5728.809959, "o", "    75\t\trateLimiter               *rateLimiter\r\n    76\t\tEndpoints                 []*EndpointState\r\n    77\t\trrIndex                   int\r\n    78\t\tListener                  net.Listener\r\n    79\t\tlistenerStop              chan struct{}\r\n    80\t\tstopping                  bool\r\n    81\t}\r\n    82\t\r\n    83\ttype State struct {\r\n"]
[5728.810018, "o", "    84\t\tmu         sync.RWMutex\r\n    85\t\tconfigPath string\r\n    86\t\tglobal     config.Global\r\n    87\t\tservices   map[string]*ServiceState\r\n    88\t\tlogMu      sync.Mutex\r\n    89\t\thealthLog  map[string][]HealthEvent\r\n    90\t\treloadCh   chan struct{}\r\n    91\t}\r\n"]
[5728.810078, "o", "    92\t\r\n    93\tfunc NewState(cfg *config.Config, path string) *State {\r\n    94\t\ts := &State{\r\n    95\t\t\tconfigPath: path,\r\n    96\t\t\tservices:   make(map[string]*ServiceState),\r\n    97\t\t\thealthLog:  make(map[string][]HealthEvent),\r\n    98\t\t\treloadCh:   make(chan struct{}, 1),\r\n"]
[5728.81014, "o", "    99\t\t}\r\n   100\t\ts.applyConfigLocked(cfg)\r\n   101\t\treturn s\r\n   102\t}\r\n   103\t\r\n   104\tfunc (s *State) ReloadChan() <-chan struct{} {\r\n   105\t\treturn s.reloadCh\r\n   106\t}\r\n   107\t\r\n   108\tfunc (s *State) ConfigPath() string {\r\n   109\t\ts.mu.RLock()\r\n"]
[5728.810203, "o", "   110\t\tdefer s.mu.RUnlock()\r\n   111\t\treturn s.configPath\r\n   112\t}\r\n   113\t\r\n   114\tfunc (s *State) Global() config.Global {\r\n   115\t\ts.mu.RLock()\r\n   116\t\tdefer s.mu.RUnlock()\r\n   117\t\treturn s.global\r\n   118\t}\r\n   119"]
[5728.810264, "o", "\t\r\n   120\tfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n   121\t\ts.mu.Lock()\r\n   122\t\tdefer s.mu.Unlock()\r\n   123\t\ts.applyConfigLocked(cfg)\r\n   124\t\tselect {\r\n   125\t\tcase s.reloadCh <- struct{}{}:\r\n   126\t\tdefault:\r\n   127\t\t}\r\n"]
[5728.810328, "o", "   128\t}\r\n   129\t\r\n   130\tfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n   131\t\ts.global = cfg.Global\r\n   132\t\tseen := make(map[string]bool)\r\n   133\t\tfor _, svc := range cfg.Services {\r\n   134\t\t\tseen[svc.Name] = true\r\n   135\t\t\tss := s.services[svc.Name]\r\n   136\t\t\tif ss == nil {\r\n   137\t\t"]
[5728.810398, "o", "\t\tss = newServiceState(svc, cfg.Global)\r\n   138\t\t\t\ts.services[svc.Name] = ss\r\n   139\t\t\t} else {\r\n   140\t\t\t\tss.mu.Lock()\r\n   141\t\t\t\tss.Name = svc.Name\r\n   142\t\t\t\tss.ListenPort = svc.ListenPort\r\n   143\t\t\t\tss.RoutingMode = svc.RoutingMode\r\n   144\t\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n"]
[5728.810465, "o", "   145\t\t\t\tss.RateLimitRps = svc.RateLimitRps\r\n   146\t\t\t\tss.RateLimitBurst = svc.RateLimitBurst\r\n   147\t\t\t\tss.RateLimitQueueDepth = svc.RateLimitQueueDepth\r\n   148\t\t\t\tss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs\r\n   149\t\t\t\tss.MaxRetries = svc.MaxRetries\r\n   150\t\t\t\tss.RetryDelayMs = svc.RetryDelayMs\r\n   151\t\t\t\tss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier\r\n   152\t\t\t\tss.RetryMaxDelayMs = svc.RetryMaxDelayMs\r\n   153\t\t\t\tif ss.rateLimiter == nil {\r\n"]
[5728.810534, "o", "   154\t\t\t\t\tss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n   155\t\t\t\t} else {\r\n   156\t\t\t\t\tss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n   157\t\t\t\t}\r\n   158\t\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n"]
[5728.810595, "o", "   159\t\t\t\tss.IdleTimeoutMs = svc.IdleTimeoutMs\r\n   160\t\t\t\tss.mu.Unlock()\r\n   161\t\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n   162\t\t\t}\r\n   163\t\t}\r\n   164\t\tfor name, ss := range s.services {\r\n   165\t\t\tif !seen[name] {\r\n   166\t\t\t\tss.mu.Lock()\r\n   167\t\t\t\tss.stopping = true\r\n   168\t\t\t\tif ss.listenerStop != nil {\r\n   169\t\t\t\t\tclose(ss.listenerStop)\r\n"]
[5728.81066, "o", "   170\t\t\t\t\tss.listenerStop = nil\r\n   171\t\t\t\t}\r\n   172\t\t\t\tif ss.Listener != nil {\r\n   173\t\t\t\t\tss.Listener.Close()\r\n   174\t\t\t\t\tss.Listener = nil\r\n   175\t\t\t\t}\r\n   176\t\t\t\tss.mu.Unlock()\r\n   177\t\t\t\tfor _, ep := range ss.Endpoints {\r\n   178\t\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   179"]
[5728.810721, "o", "\t\t\t\t}\r\n   180\t\t\t}\r\n   181\t\t}\r\n   182\t}\r\n   183\t\r\n   184\tfunc newServiceState(svc config.Service, global config.Global) *ServiceState {\r\n   185\t\tss := &ServiceState{\r\n   186\t\t\tName:                      svc.Name,\r\n   187\t\t\tListenPort:                svc.ListenPort,\r\n"]
[5728.810783, "o", "   188\t\t\tRoutingMode:               svc.RoutingMode,\r\n   189\t\t\tDrainTimeoutMs:            svc.DrainTimeoutMs,\r\n   190\t\t\tRateLimitRps:              svc.RateLimitRps,\r\n   191\t\t\tRateLimitBurst:            svc.RateLimitBurst,\r\n   192\t\t\tRateLimitQueueDepth:       svc.RateLimitQueueDepth,\r\n   193\t\t\tRateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,\r\n   194\t\t\tMaxRetries:                svc.MaxRetries,\r\n   195\t\t\tRetryDelayMs:              svc.RetryDelayMs,\r\n"]
