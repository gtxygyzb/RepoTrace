[7407.71208, "o", "     8\t\t\"sync/atomic\"\r\n     9\t\t\"time\"\r\n    10\t\r\n    11\t\t\"meshrouter/internal/state\"\r\n    12\t)\r\n    13\t\r\n    14\ttype serviceListener struct {\r\n    15\t\tservice  string\r\n    16\t\tport     int\r\n    17\t\tlistener net.Listener\r\n    18\t\tstop     chan struct{}\r\n    19\t\twg       sync.WaitGroup\r\n    20\t\tdone     chan struct{}\r\n    21\t}\r\n    22\t\r\n    23\ttype Router struct {\r\n    24\t\tstate     *state.State\r\n"]
[7407.71216, "o", "    25\t\tmu        sync.Mutex\r\n    26\t\tlisteners map[string]*serviceListener\r\n    27\t}\r\n    28\t\r\n    29\tfunc NewRouter(s *state.State) *Router {\r\n    30\t\treturn &Router{\r\n"]
[7407.71223, "o", "    31\t\t\tstate:     s,\r\n    32\t\t\tlisteners: make(map[string]*serviceListener),\r\n    33\t\t}\r\n    34\t}\r\n    35\t\r\n    36\tfunc (r *Router) Start() {\r\n    37\t\tfor _, ss := range r.state.Services() {\r\n    38\t\t\tif !ss.IsStopping() {\r\n    39\t\t\t\tr.startService(ss)\r\n    40\t\t\t}\r\n    41\t\t}\r\n"]
[7407.712298, "o", "    42\t}\r\n    43\t\r\n    44\tfunc (r *Router) Reload() {\r\n    45\t\tservices := r.state.Services()\r\n    46\t\tseen := make(map[string]bool)\r\n    47\t\tfor _, ss := range services {\r\n    48\t\t\tseen[ss.Name] = true\r\n    49\t\t\tr.mu.Lock()\r\n    50\t\t\tsl, ok := r.listeners[ss.Name]\r\n    51\t\t\tr.mu.Unlock()\r\n    52\t\t\tif !ok {\r\n    53\t\t\t\tif !ss.IsStopping() {\r\n    54\t\t\t\t\tr.startService(ss)\r\n    55\t"]
[7407.712369, "o", "\t\t\t}\r\n    56\t\t\t\tcontinue\r\n    57\t\t\t}\r\n    58\t\t\tif sl.port != ss.ListenPort {\r\n    59\t\t\t\tr.stopService(ss.Name, true)\r\n    60\t\t\t\tr.startService(ss)\r\n    61\t\t\t}\r\n    62\t\t}\r\n    63\t\tr.mu.Lock()\r\n"]
[7407.712442, "o", "    64\t\tfor name := range r.listeners {\r\n    65\t\t\tif !seen[name] {\r\n    66\t\t\t\tr.mu.Unlock()\r\n    67\t\t\t\tr.stopService(name, true)\r\n    68\t\t\t\tr.mu.Lock()\r\n    69\t\t\t}\r\n    70\t\t}\r\n    71\t\t"]
[7407.712504, "o", "r.mu.Unlock()\r\n    72\t}\r\n    73\t\r\n    74\tfunc (r *Router) startService(ss *state.ServiceState) {\r\n    75\t\taddr := \":\" + intToStr(ss.ListenPort)\r\n    76\t\tln, err := net.Listen(\"tcp\", addr)\r\n    77\t\tif err != nil {\r\n"]
[7407.712564, "o", "    78\t\t\tlog.Printf(\"router: listen %s on %s failed: %v\", ss.Name, addr, err)\r\n    79\t\t\treturn\r\n    80\t\t}\r\n    81\t\tsl := &serviceListener{\r\n    82\t\t\tservice:  ss.Name,\r\n    83\t\t\tport:     ss.ListenPort,\r\n    84\t\t\tlistener: ln,\r\n    85\t\t\tstop:     make(chan struct{}),\r\n    86\t\t\tdone:     make(chan struct{}),\r\n    87"]
[7407.712626, "o", "\t\t}\r\n    88\t\tr.mu.Lock()\r\n    89\t\tr.listeners[ss.Name] = sl\r\n    90\t\tr.mu.Unlock()\r\n"]
[7407.712708, "o", "    91\t\tgo sl.acceptLoop(r)\r\n    92\t}\r\n    93\t\r\n    94\tfunc (r *Router) stopService(name string, drain bool) {\r\n    95\t\tr.mu.Lock()\r\n    96\t\tsl, ok := r.listeners[name]\r\n    97\t\tif ok {\r\n    98\t\t\tdelete(r.listeners, name)\r\n    99\t\t}\r\n   100\t\tr.mu.Unlock()\r\n"]
[7407.712749, "o", "   101\t\tif !ok {\r\n   102\t\t\treturn\r\n   103\t\t}\r\n   104\t\tsl.stopAccept(drain, r)\r\n   105\t}\r\n   106\t\r\n   107\tfunc (r *Router) Stop() {\r\n   108\t\tr.mu.Lock()\r\n   109\t\tlisteners := r.listeners\r\n   110\t\tr.listeners = make(map[string]*serviceListener)\r\n"]
[7407.712834, "o", "   111\t\tr.mu.Unlock()\r\n   112\t\tvar wg sync.WaitGroup\r\n   113\t\tfor name, sl := range listeners {\r\n   114\t\t\twg.Add(1)\r\n   115\t\t\tgo func(name string, sl *serviceListener) {\r\n   116\t\t\t\tdefer wg.Done()\r\n   117\t\t\t\tsl.stopAccept(true, r)\r\n   118\t\t\t}(name, sl)\r\n   119\t\t}\r\n   120\t\twg.Wait()\r\n   121\t}\r\n   122\t\r\n"]
[7407.712901, "o", "   123\tfunc (sl *serviceListener) acceptLoop(r *Router) {\r\n   124\t\tdefer close(sl.done)\r\n   125\t\tfor {\r\n   126\t\t\tconn, err := sl.listener.Accept()\r\n   127\t\t\tif err != nil {\r\n"]
[7407.712961, "o", "   128\t\t\t\treturn\r\n   129\t\t\t}\r\n   130\t\t\tsl.wg.Add(1)\r\n   131\t\t\tgo func(c net.Conn) {\r\n   132\t\t\t\tdefer sl.wg.Done()\r\n   133\t\t\t\tr.handleConn(sl.service, c)\r\n   134\t\t\t}(conn)\r\n   135\t\t}\r\n   136\t}\r\n   137\t\r\n   138\tfunc (sl *serviceListener) stopAccept(drain bool, r *Router) {\r\n"]
[7407.713022, "o", "   139\t\tselect {\r\n   140\t\tcase <-sl.stop:\r\n   141\t\tdefault:\r\n   142\t\t\tclose(sl.stop)\r\n   143\t\t}\r\n   144\t\tsl.listener.Close()\r\n   145\t\t<-sl.done\r\n   146\t\tif drain {\r\n"]
[7407.713093, "o", "   147\t\t\tss := r.state.GetService(sl.service)\r\n   148\t\t\ttimeout := 5 * time.Second\r\n   149\t\t\tif ss != nil {\r\n   150\t\t\t\ttimeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n   151\t\t\t\tif timeout <= 0 {\r\n   152\t\t\t\t\ttimeout = 5 * time.Second\r\n   153\t\t\t\t}\r\n   154\t\t\t}\r\n   155\t\t\tdone := make(chan struct{})\r\n   156\t\t\tgo func() {\r\n   157\t\t\t\tsl.wg.Wait()\r\n"]
[7407.713181, "o", "   158\t\t\t\tclose(done)\r\n   159\t\t\t}()\r\n   160\t\t\tselect {\r\n   161\t\t\tcase <-done:\r\n   162\t\t\tcase <-time.After(timeout):\r\n"]
[7407.713243, "o", "   163\t\t\t\tr.state.CloseServiceConnections(sl.service)\r\n   164\t\t\t\t<-done\r\n   165\t\t\t}\r\n   166\t\t} else {\r\n   167\t\t\tsl.wg.Wait()\r\n   168\t\t}\r\n   169\t}\r\n   170\t\r\n   171\tfunc (r *Router) handleConn(service string, client net.Conn) {\r\n   172\t\tstart := time.Now()\r\n   173\t\tss := r.state.GetService(service)\r\n   174\t\tif ss == nil {\r\n   175\t\t\tclient.Close()\r\n   176\t\t\treturn\r\n"]
[7407.713307, "o", "   177\t\t}\r\n   178\t\r\n   179\t\tallowed, queued := ss.AcquireRateLimitToken()\r\n   180\t\tif !allowed {\r\n   181\t\t\tif queued {\r\n   182\t\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   183\t\t\t\t\tcand.Stats.RecordQueueTimeout()\r\n   184\t\t\t\t}\r\n   185\t\t\t} else {\r\n   186\t\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n"]
[7407.713372, "o", "   187\t\t\t\t\tcand.Stats.RecordRateLimited()\r\n   188\t\t\t\t}\r\n   189\t\t\t}\r\n   190\t\t\tclient.Close()\r\n   191\t\t\treturn\r\n   192"]
[7407.713443, "o", "\t\t}\r\n   193\t\tif queued {\r\n   194\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   195\t\t\t\tcand.Stats.RecordQueued()\r\n   196\t\t\t}\r\n   197\t\t}\r\n   198\t\r\n   199\t\tmaxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\r\n   200\t\tvar lastEndpoint *state.EndpointState\r\n   201\t\t"]
[7407.713505, "o", "for attempt := 0; ; attempt++ {\r\n   202\t\t\tres, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\r\n   203\t\t\tif err != nil {\r\n   204\t\t\t\tif cand, cerr := r.state.SelectCandidate(service); cerr == nil {\r\n   205\t\t\t\t\tss := r.state.GetService(service)\r\n   206\t\t\t\t\tif ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\r\n   207\t\t\t\t\t\tcand.Stats.RecordRejection()\r\n   208\t\t\t\t\t}\r\n   209\t\t\t\t}\r\n   210\t\t\t\tclient.Close()\r\n   211\t\t\t\treturn\r\n   212\t\t\t}\r\n   213"]
