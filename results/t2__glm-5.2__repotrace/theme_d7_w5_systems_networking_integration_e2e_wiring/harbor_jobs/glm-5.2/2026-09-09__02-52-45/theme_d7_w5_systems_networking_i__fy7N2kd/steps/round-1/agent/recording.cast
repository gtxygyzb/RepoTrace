[5709.685079, "o", "nl -ba config/services.toml\r\n\u001b[?2004l\r"]
[5709.687648, "o", "     1\t[global]\r\n     2\thealth_interval_ms = 2000\r\n     3\tunhealthy_threshold = 3\r\n     4\thealthy_threshold = 2\r\n     5\tstats_window_sec = 60\r\n"]
[5709.687789, "o", "     6\tcircuit_breaker_threshold = 3\r\n     7\tcircuit_breaker_timeout_ms = 5000\r\n     8\t\r\n     9\t[[service]]\r\n    10\tname = \"api-gateway\"\r\n    11\tlisten_port = 9001\r\n    12\trouting_mode = \"weighted-round-robin\"\r\n    13\tdrain_timeout_ms = 5000\r\n    14\tmax_connections_per_endpoint = 50\r\n    15\t\r\n    16\t  [[service.endpoint]]\r\n    17\t  address = \"127.0.0.1:8081\"\r\n    18\t  weight = 5\r\n    19\t  health_check = \"tcp\"\r\n    20\t\r\n    21\t  [[service.endpoint]]\r\n    22\t  address = \"127.0.0.1:8082\"\r\n    23\t  weight = 3\r\n    24\t  health_check = \"http\"\r\n    25\t  health_path = \"/healthz\"\r\n    26\t\r\n"]
[5709.68792, "o", "    27\t  [[service.endpoint]]\r\n    28\t  address = \"127.0.0.1:8083\"\r\n    29\t  weight = 2\r\n    30\t  health_check = \"tcp\"\r\n    31\t\r\n    32\t[[service]]\r\n    33"]
[5709.688047, "o", "\tname = \"data-store\"\r\n    34\tlisten_port = 9002\r\n    35\trouting_mode = \"least-connections\"\r\n    36\tdrain_timeout_ms = 10000\r\n    37\tmax_connections_per_endpoint = 3\r\n    38\trate_limit_rps = 5\r\n    39\trate_limit_burst = 8\r\n    40\trate_limit_queue_depth = 2\r\n    41\trate_limit_queue_timeout_ms = 500\r\n    42\tmax_retries = 1\r\n    43\tretry_delay_ms = 100\r\n    44\tretry_backoff_multiplier = 2.0\r\n    45\tretry_max_delay_ms = 1000\r\n    46\t\r\n    47\t  [[service.endpoint]]\r\n    48\t  address = \"127.0.0.1:8091\"\r\n    49\t  weight = 1\r\n    50\t  health_check = \"tcp\"\r\n    51"]
