[14167.059083, "o", "   118\tfunc (s *Server) dispatch(req Request) (interface{}, error) {\r\n   119\t\tswitch req.Cmd {\r\n   120\t\tcase \"list_services\":\r\n   121\t\t\treturn s.state.ServicesView(), nil\r\n   122\t\tcase \"get_service\":\r\n   123\t\t\tvar args struct {"]
[14167.059181, "o", "\r\n   124\t\t\t\tName string `json:\"name\"`\r\n   125\t\t\t}\r\n   126\t\t\tif err := json.Unmarshal(req.Args, &args); err != nil {\r\n   127\t\t\t\treturn nil, err\r\n   128\t\t\t}\r\n   129\t\t\tsv, ok := s.state.ServiceView(args.Name)\r\n   130\t\t\tif !ok {\r\n   131\t\t\t\treturn nil, errors.New(\"service not found\")\r\n   132\t\t\t}\r\n   133\t\t\treturn sv, nil\r\n   134\t\tcase \"get_warmup_status\":\r\n   135\t"]
