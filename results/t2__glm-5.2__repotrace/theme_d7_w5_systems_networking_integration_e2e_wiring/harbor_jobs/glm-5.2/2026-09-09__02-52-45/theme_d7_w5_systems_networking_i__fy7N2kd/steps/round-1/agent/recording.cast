[2214.666536, "o", "     6\t\t\"time\"\r\n     7\t)\r\n     8\t\r\n     9\ttype rateLimiter struct {\r\n    10\t\tmu          sync.Mutex\r\n    11\t\trps         float64\r\n    12\t\tburst       float64\r\n    13\t\ttokens      float64\r\n    14\t\tlast        time.Time\r\n    15\t\tqueue       *list.List\r\n    16\t\tqueueMax    int\r\n    17\t\ttimeout     time.Duration\r\n    18\t\trateLimited uint64\r\n    19\t\tqueued      uint64\r\n"]
[2214.666584, "o", "    20\t\ttimeouts    uint64\r\n    21\t}\r\n    22\t\r\n    23\tfunc newRateLimiter(rps, burst int, queueDepth int, timeoutMs int) *rateLimiter {\r\n    24\t\treturn &rateLimiter{\r\n    25\t\t\trps:      float64(rps),\r\n    26\t\t\tburst:    float64(burst),\r\n"]
[2214.666687, "o", "    27\t\t\ttokens:   float64(burst),\r\n    28\t\t\tlast:     time.Now(),\r\n    29\t\t\tqueue:    list.New(),\r\n    30\t\t\tqueueMax: queueDepth,\r\n    31\t\t\ttimeout:  time.Duration(timeoutMs) * time.Millisecond,\r\n    32\t\t}\r\n    33\t}\r\n    34\t\r\n    35\tfunc (rl *rateLimiter) update(rps, burst int, queueDepth int, timeoutMs int) {\r\n    36\t\trl.mu.Lock()\r\n    37\t\tdefer rl.mu.Unlock()\r\n    38\t\trl.rps = float64(rps)\r\n    39\t\trl.burst = float64(burst)\r\n"]
[2214.666754, "o", "    40\t\tif rl.tokens > rl.burst {\r\n    41\t\t\trl.tokens = rl.burst\r\n    42\t\t}\r\n    43\t\trl.queueMax = queueDepth\r\n    44\t\trl.timeout = time.Duration(timeoutMs) * time.Millisecond\r\n    45\t}\r\n    46\t\r\n    47\tfunc (rl *rateLimiter) refillLocked(now time.Time) {\r\n    48\t\telapsed := now.Sub(rl.last).Seconds()\r\n    49\t\tif elapsed > 0 {\r\n"]
[2214.666813, "o", "    50\t\t\trl.tokens += rl.rps * elapsed\r\n    51\t\t\tif rl.burst > 0 && rl.tokens > rl.burst {\r\n    52\t\t\t\trl.tokens = rl.burst\r\n    53\t\t\t}\r\n    54\t\t\trl.last = now\r\n"]
[2214.666873, "o", "    55\t\t}\r\n    56\t}\r\n    57\t\r\n    58\tfunc (rl *rateLimiter) tryAcquire(now time.Time) bool {\r\n    59\t\trl.mu.Lock()\r\n    60\t\tdefer rl.mu.Unlock()\r\n    61\t\trl.refillLocked(now)\r\n    62\t\tif rl.rps <= 0 || rl.tokens >= 1 {\r\n    63\t\t\tif rl.rps > 0 {\r\n    64\t\t\t\trl.tokens -= 1\r\n    65\t\t\t}\r\n"]
[2214.666938, "o", "    66\t\t\treturn true\r\n    67\t\t}\r\n    68\t\treturn false\r\n    69\t}\r\n    70\t\r\n    71\ttype queuedWaiter struct {\r\n    72\t\tdeadline time.Time\r\n    73\t\tch       chan struct{}\r\n    74\t}\r\n    75\t\r\n"]
[2214.667005, "o", "    76\tfunc (rl *rateLimiter) acquire(now time.Time) (bool, bool) {\r\n    77\t\trl.mu.Lock()\r\n    78\t\tif rl.rps <= 0 {\r\n    79\t\t\trl.mu.Unlock()\r\n    80\t\t\treturn true, false\r\n    81\t\t}\r\n    82\t\trl.refillLocked(now)\r\n    83\t\tif rl.tokens >= 1 {\r\n    84\t\t\trl.tokens -= 1\r\n"]
[2214.667065, "o", "    85\t\t\trl.mu.Unlock()\r\n    86\t\t\treturn true, false\r\n    87\t\t}\r\n    88\t\tif rl.queueMax <= 0 {\r\n    89\t\t\trl.rateLimited++\r\n    90\t\t\trl.mu.Unlock()\r\n    91\t\t\treturn false, false\r\n    92\t\t}\r\n"]
[2214.667122, "o", "    93\t\tif rl.queue.Len() >= rl.queueMax {\r\n    94\t\t\trl.rateLimited++\r\n    95\t\t\trl.mu.Unlock()\r\n    96\t\t\treturn false, false\r\n    97\t\t}\r\n    98\t\tdeadline := now.Add(rl.timeout)\r\n    99\t\twaiter := &queuedWaiter{deadline: deadline, ch: make(chan struct{})}\r\n   100\t\telem := rl.queue.PushBack(waiter)\r\n"]
[2214.66719, "o", "   101\t\trl.queued++\r\n   102\t\trl.mu.Unlock()\r\n   103\t\r\n   104\t\ttimer := time.NewTimer(rl.timeout)\r\n"]
[2214.667255, "o", "   105\t\tdefer timer.Stop()\r\n"]
