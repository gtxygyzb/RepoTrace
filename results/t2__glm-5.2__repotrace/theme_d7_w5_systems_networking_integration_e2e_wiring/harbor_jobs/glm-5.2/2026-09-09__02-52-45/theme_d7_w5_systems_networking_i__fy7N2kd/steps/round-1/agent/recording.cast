[5709.989134, "o", "     1\tpackage config\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"github.com/BurntSushi/toml\"\r\n     5\t)\r\n     6\t\r\n     7\t// Global holds mesh-wide tuning parameters.\r\n"]
[5709.989257, "o", "     8\ttype Global struct {\r\n     9\t\tHealthIntervalMs        int `toml:\"health_interval_ms\"`\r\n    10\t\tUnhealthyThreshold      int `toml:\"unhealthy_threshold\"`\r\n    11\t\tHealthyThreshold        int `toml:\"healthy_threshold\"`\r\n    12\t\tStatsWindowSec          int `toml:\"stats_window_sec\"`\r\n    13\t\tCircuitBreakerThreshold int `toml:\"circuit_breaker_threshold\"`\r\n"]
[5709.989373, "o", "    14\t\tCircuitBreakerTimeoutMs int `toml:\"circuit_breaker_timeout_ms\"`\r\n    15\t}\r\n    16\t\r\n    17\t// Endpoint describes one backend endpoint from config.\r\n    18\ttype Endpoint struct {\r\n    19\t\tAddress     string `toml:\"address\"`\r\n    20\t\tWeight      int    `toml:\"weight\"`\r\n    21\t\tHealthCheck string `toml:\"health_check\"`\r\n    22\t\tHealthPath  string `toml:\"health_path\"`\r\n    23\t\tHealthCmd   string `toml:\"health_cmd\"`\r\n    24\t}\r\n    25\t\r\n    26\t// Service describes one routed service from config.\r\n    27\ttype Service struct {\r\n    28\t\tName                      string     `toml:\"name\"`\r\n    29\t\tListenPort                int        `toml:\"listen_port\"`\r\n    30\t\tRoutingMode               string     `toml:\"routing_mode\"`\r\n    31\t\tDrainTimeoutMs            int        `toml:\"drain_timeout_ms\"`\r\n    32\t\tMaxConnectionsPerEndpoint int        `toml:\"max_connections_per_endpoint\"`\r\n    33\t\tRateLimitRps              int        `toml:\"rate_limit_rps\"`\r\n    34\t\tRateLimitBurst            int        `toml:\"rate_limit_burst\"`"]
[5709.98954, "o", "\r\n    35\t\tRateLimitQueueDepth       int        `toml:\"rate_limit_queue_depth\"`\r\n    36\t\tRateLimitQueueTimeoutMs   int        `toml:\"rate_limit_queue_timeout_ms\"`\r\n    37\t\tMaxRetries                int        `toml:\"max_retries\"`\r\n    38\t\tRetryDelayMs              int        `toml:\"retry_delay_ms\"`\r\n    39\t\tRetryBackoffMultiplier    float64    `toml:\"retry_backoff_multiplier\"`\r\n    40\t\tRetryMaxDelayMs           int        `toml:\"retry_max_delay_ms\"`\r\n    41\t\tIdleTimeoutMs             int        `toml:\"idle_timeout_ms\"`\r\n    42\t\tEndpoints                 []Endpoint `toml:\"endpoint\"`\r\n    43\t}\r\n    44\t\r\n    45\t// Config is the parsed application configuration.\r\n"]
[5709.989649, "o", "    46\ttype Config struct {\r\n    47\t\tGlobal   Global\r\n    48\t\tServices []Service `toml:\"service\"`\r\n    49\t}\r\n    50\t\r\n    51\t// Load reads and normalizes a TOML config file.\r\n    52\tfunc Load(path string) (*Config, error) {\r\n    53\t\tvar cfg Config\r\n    54\t\tif _, err := toml.DecodeFile(path, &cfg); err != nil {\r\n    55\t\t\treturn nil, err\r\n    56\t\t}\r\n    57\t\tif cfg.Global.HealthIntervalMs <= 0 {\r\n    58\t\t\tcfg.Global.HealthIntervalMs = 2000\r\n    59\t\t}\r\n    60\t\tif cfg.Global.UnhealthyThreshold <= 0 {\r\n    61\t\t\tcfg.Global.UnhealthyThreshold = 3\r\n    62\t\t}\r\n    63\t\tif cfg.Global.HealthyThreshold <= 0 {\r\n    64\t\t\tcfg.Global.HealthyThreshold = 2\r\n    65\t\t}\r\n    66\t\tif cfg.Global.StatsWindowSec <= 0 {\r\n"]
[5709.989856, "o", "    67\t\t\tcfg.Global.StatsWindowSec = 60\r\n    68\t\t}\r\n    69\t\tif cfg.Global.CircuitBreakerThreshold <= 0 {\r\n    70\t\t\tcfg.Global.CircuitBreakerThreshold = 3\r\n    71\t\t}\r\n    72\t\tif cfg.Global.CircuitBreakerTimeoutMs <= 0 {\r\n    73\t\t\tcfg.Global.CircuitBreakerTimeoutMs = 5000\r\n    74\t\t}\r\n    75\t\tfor i := range cfg.Services {\r\n    76\t\t\ts := &cfg.Services[i]\r\n    77\t\t\tif s.RoutingMode == \"\" {\r\n    78\t\t\t\ts.RoutingMode = \"weighted-round-robin\"\r\n    79\t\t\t}\r\n    80\t\t\tif s.DrainTimeoutMs <= 0 {\r\n    81\t\t\t\ts.DrainTimeoutMs = 5000\r\n    82\t\t\t}\r\n    83\t\t\tif s.MaxConnectionsPerEndpoint <= 0 {\r\n    84\t\t\t\ts.MaxConnectionsPerEndpoint = 100\r\n    85\t\t\t}\r\n    86\t\t\tif s.RateLimitBurst <= 0 {\r\n    87\t\t\t\ts.RateLimitBurst = s.RateLimitRps\r\n    88\t\t\t}\r\n    89\t\t\tif s.RateLimitQueueTimeoutMs <= 0 {\r\n    90\t\t\t\ts.RateLimitQueueTimeoutMs = 1000\r\n    91\t\t\t}\r\n    92\t"]
[5709.98997, "o", "\t\tif s.RetryDelayMs <= 0 {\r\n    93\t\t\t\ts.RetryDelayMs = 100\r\n    94\t\t\t}\r\n    95\t\t\tif s.RetryBackoffMultiplier <= 0 {\r\n    96\t\t\t\ts.RetryBackoffMultiplier = 2.0\r\n    97\t\t\t}\r\n    98\t\t\tif s.RetryMaxDelayMs <= 0 {\r\n    99\t\t\t\ts.RetryMaxDelayMs = 5000\r\n   100\t\t\t}\r\n   101\t\t\tfor j := range s.Endpoints {\r\n   102\t\t\t\tep := &s.Endpoints[j]\r\n   103\t\t\t\tif ep.HealthCheck == \"\" {\r\n   104\t\t\t\t\tep.HealthCheck = \"tcp\"\r\n"]
[5709.990075, "o", "   105\t\t\t\t}\r\n   106\t\t\t\tif ep.Weight < 0 {\r\n   107\t\t\t\t\tep.Weight = 0\r\n   108\t\t\t\t}\r\n   109\t\t\t}\r\n   110\t\t}\r\n   111\t\treturn &cfg, nil\r\n   112\t}\r\n"]
