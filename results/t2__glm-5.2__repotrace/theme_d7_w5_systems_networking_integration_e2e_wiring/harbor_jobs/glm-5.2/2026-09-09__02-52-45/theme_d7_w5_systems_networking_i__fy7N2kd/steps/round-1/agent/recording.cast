[10586.684326, "o", "    82\t\tlistenerStop              chan struct{}\r\n    83\t\tstopping                  bool\r\n    84\t}\r\n    85\t\r\n    86\ttype State struct {\r\n    87\t\tmu         sync.RWMutex\r\n    88\t\tconfigPath string\r\n    89\t\tglobal     config.Global\r\n    90\t\tservices   map[string]*ServiceState\r\n    91\t\tlogMu      sync.Mutex\r\n    92\t\thealthLog  map[string][]HealthEvent\r\n    93"]
[10586.684398, "o", "\t\treloadCh   chan struct{}\r\n    94\t}\r\n    95\t\r\n    96\tfunc NewState(cfg *config.Config, path string) *State {\r\n    97\t\ts := &State{\r\n    98\t\t\tconfigPath: path,\r\n    99\t\t\tservices:   make(map[string]*ServiceState),\r\n   100\t\t\thealthLog:  make(map[string][]HealthEvent),\r\n"]
[10586.684455, "o", "   101\t\t\treloadCh:   make(chan struct{}, 1),\r\n   102\t\t}\r\n   103\t\ts.applyConfigLocked(cfg)\r\n   104\t\treturn s\r\n"]
