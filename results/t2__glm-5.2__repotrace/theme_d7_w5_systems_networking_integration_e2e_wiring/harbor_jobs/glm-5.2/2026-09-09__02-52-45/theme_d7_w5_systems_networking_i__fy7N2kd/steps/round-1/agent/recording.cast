[5719.151905, "o", "healthLog  map[string][]HealthEvent\r\n    90\t\treloadCh   chan struct{}\r\n    91\t}\r\n    92\t\r\n    93\tfunc NewState(cfg *config.Config, path string) *State {\r\n    94\t\ts := &State{\r\n    95\t\t\tconfigPath: path,\r\n    96\t\t\tservices:   make(map[string]*ServiceState),\r\n    97\t\t\thealthLog:  make(map[string][]HealthEvent),\r\n    98\t\t\treloadCh:   make(chan struct{}, 1),\r\n    99\t\t}\r\n   100\t\ts.applyConfigLocked(cfg)\r\n"]
[5719.151968, "o", "   101\t\treturn s\r\n   102\t}\r\n   103\t\r\n   104\tfunc (s *State) ReloadChan() <-chan struct{} {\r\n   105\t\treturn s.reloadCh\r\n   106\t}\r\n   107\t\r\n   108\tfunc (s *State) ConfigPath() string {\r\n   109\t\ts.mu.RLock()\r\n   110\t\tdefer s.mu.RUnlock()\r\n   111\t\treturn s.configPath\r\n"]
[5719.15203, "o", "   112\t}\r\n   113\t\r\n   114\tfunc (s *State) Global() config.Global {\r\n   115\t\ts.mu.RLock()\r\n   116\t\tdefer s.mu.RUnlock()\r\n   117\t"]
[5719.15209, "o", "\treturn s.global\r\n   118\t}\r\n   119\t\r\n   120\tfunc (s *State) ApplyConfig(cfg *config.Config) {\r\n   121\t\ts.mu.Lock()\r\n   122\t\tdefer s.mu.Unlock()\r\n   123\t\ts.applyConfigLocked(cfg)\r\n   124\t\tselect {\r\n"]
[5719.152151, "o", "   125\t\tcase s.reloadCh <- struct{}{}:\r\n   126\t\tdefault:\r\n   127\t\t}\r\n   128\t}\r\n   129\t\r\n   130\tfunc (s *State) applyConfigLocked(cfg *config.Config) {\r\n   131\t\ts.global = cfg.Global\r\n   132\t\tseen := make(map[string]bool)\r\n   133\t\t"]
[5719.152214, "o", "for _, svc := range cfg.Services {\r\n   134\t\t\tseen[svc.Name] = true\r\n   135\t\t\tss := s.services[svc.Name]\r\n   136\t\t\tif ss == nil {\r\n   137\t\t\t\tss = newServiceState(svc, cfg.Global)\r\n   138\t\t\t\ts.services[svc.Name] = ss\r\n   139\t\t\t} else {\r\n   140\t\t\t\tss.mu.Lock()\r\n   141\t\t\t\tss.Name = svc.Name\r\n"]
[5719.152276, "o", "   142\t\t\t\tss.ListenPort = svc.ListenPort\r\n   143\t\t\t\tss.RoutingMode = svc.RoutingMode\r\n   144\t\t\t\tss.DrainTimeoutMs = svc.DrainTimeoutMs\r\n   145\t\t\t\tss.RateLimitRps = svc.RateLimitRps\r\n   146\t\t\t\tss.RateLimitBurst = svc.RateLimitBurst\r\n   147\t\t\t\tss.RateLimitQueueDepth = svc.RateLimitQueueDepth\r\n   148\t\t\t\tss.RateLimitQueueTimeoutMs = svc.RateLimitQueueTimeoutMs\r\n   149\t\t\t\tss.MaxRetries = svc.MaxRetries\r\n   150\t\t\t\tss.RetryDelayMs = svc.RetryDelayMs\r\n"]
[5719.152343, "o", "   151\t\t\t\tss.RetryBackoffMultiplier = svc.RetryBackoffMultiplier\r\n   152\t\t\t\tss.RetryMaxDelayMs = svc.RetryMaxDelayMs\r\n   153\t\t\t\tif ss.rateLimiter == nil {\r\n   154\t\t\t\t\tss.rateLimiter = newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n   155\t\t\t\t} else {\r\n   156\t\t\t\t\tss.rateLimiter.update(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs)\r\n   157\t\t\t\t}\r\n"]
[5719.152429, "o", "   158\t\t\t\tss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\r\n   159\t\t\t\tss.IdleTimeoutMs = svc.IdleTimeoutMs\r\n   160\t\t\t\tss.mu.Unlock()\r\n   161\t\t\t\tss.applyEndpoints(svc.Endpoints, cfg.Global)\r\n   162\t\t\t}\r\n   163\t\t}\r\n   164\t\tfor name, ss := range s.services {\r\n   165\t\t\tif !seen[name] {\r\n   166\t\t\t\tss.mu.Lock()\r\n   167\t\t\t\tss.stopping = true\r\n   168"]
[5719.152495, "o", "\t\t\t\tif ss.listenerStop != nil {\r\n   169\t\t\t\t\tclose(ss.listenerStop)\r\n   170\t\t\t\t\tss.listenerStop = nil\r\n   171\t\t\t\t}\r\n   172\t\t\t\tif ss.Listener != nil {\r\n   173\t\t\t\t\tss.Listener.Close()\r\n   174\t\t\t\t\tss.Listener = nil\r\n   175\t\t\t\t}\r\n   176\t\t\t\tss.mu.Unlock()\r\n   177\t\t\t\tfor _, ep := range ss.Endpoints {\r\n"]
[5719.152565, "o", "   178\t\t\t\t\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   179\t\t\t\t}\r\n   180\t\t\t}\r\n   181\t\t}\r\n   182\t}\r\n   183\t\r\n   184\tfunc newServiceState(svc config.Service, global config.Global) *ServiceState {\r\n   185\t\tss := &ServiceState{\r\n   186\t\t\tName:                      svc.Name,\r\n   187\t\t"]
[5719.15264, "o", "\tListenPort:                svc.ListenPort,\r\n   188\t\t\tRoutingMode:               svc.RoutingMode,\r\n   189\t\t\tDrainTimeoutMs:            svc.DrainTimeoutMs,\r\n   190\t\t\tRateLimitRps:              svc.RateLimitRps,\r\n   191\t\t\tRateLimitBurst:            svc.RateLimitBurst,\r\n   192\t\t\tRateLimitQueueDepth:       svc.RateLimitQueueDepth,\r\n"]
[5719.152706, "o", "   193\t\t\tRateLimitQueueTimeoutMs:   svc.RateLimitQueueTimeoutMs,\r\n   194\t\t\tMaxRetries:                svc.MaxRetries,\r\n   195\t\t\tRetryDelayMs:              svc.RetryDelayMs,\r\n   196\t\t\tRetryBackoffMultiplier:    svc.RetryBackoffMultiplier,\r\n   197\t\t\tRetryMaxDelayMs:           svc.RetryMaxDelayMs,\r\n   198\t\t\trateLimiter:               newRateLimiter(svc.RateLimitRps, svc.RateLimitBurst, svc.RateLimitQueueDepth, svc.RateLimitQueueTimeoutMs),\r\n   199\t\t\tMaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\r\n   200\t\t\tIdleTimeoutMs:             svc.IdleTimeoutMs,\r\n   201\t\t\tlistenerStop:              nil,\r\n"]
[5719.152775, "o", "   202\t\t}\r\n   203\t\tfor _, ep := range svc.Endpoints {\r\n   204\t\t\tss.Endpoints = append(ss.Endpoints, newEndpointState(ep, global))\r\n   205\t\t}\r\n   206\t\treturn ss\r\n   207\t}\r\n   208\t\r\n   209\tfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\r\n   210\t\tss.mu.Lock()\r\n   211\t\tdefer ss.mu.Unlock()\r\n   212\t\t"]
[5719.152899, "o", "seen := make(map[string]bool)\r\n   213\t\tfor _, cep := range eps {\r\n   214\t\t\tseen[cep.Address] = true\r\n   215\t\t\tvar ep *EndpointState\r\n   216\t\t\tfor _, existing := range ss.Endpoints {\r\n   217\t\t\t\tif existing.Address == cep.Address {\r\n   218\t\t\t\t\tep = existing\r\n   219\t\t\t\t\tbreak\r\n   220\t\t\t\t}\r\n   221\t\t\t}\r\n   222\t\t\tif ep == nil {\r\n   223\t\t\t\tep = newEndpointState(cep, global)\r\n   224\t\t\t\tss.Endpoints = append(ss.Endpoints, ep)\r\n   225\t\t\t} else {\r\n   226\t\t\t\tep.mu.Lock()\r\n   227\t\t\t\tep.Config = cep\r\n   228\t\t\t\tep.Weight = cep.Weight\r\n   229\t\t\t\tep.mu.Unlock()\r\n   230\t\t\t}\r\n   231\t\t}\r\n   232\t\tfor _, ep := range ss.Endpoints {\r\n   233\t\t\tif !seen[ep.Address] {\r\n   234\t\t\t"]
[5719.152971, "o", "\tep.StartDraining(ss.DrainTimeoutMs, true)\r\n   235\t\t\t}\r\n   236\t\t}\r\n   237\t}\r\n   238\t\r\n   239\tfunc newEndpointState(cep config.Endpoint, global config.Global) *EndpointState {\r\n   240\t\treturn &EndpointState{\r\n"]
