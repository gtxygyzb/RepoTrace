[1970.25325, "o", "\t\t}\r\n   228\t\tss.mu.Lock()\r\n   229\t\tdefer ss.mu.Unlock()\r\n   230\t\tfor _, ep := range ss.Endpoints {\r\n   231\t\t\tif ep.Address == address {\r\n   232\t\t\t\treturn ep\r\n   233\t\t\t}\r\n   234\t\t}\r\n   235\t\treturn nil\r\n   236\t}\r\n   237\t\r\n   238\tfunc (s *State) SetWeight(service, address string, weight int) error {\r\n   239\t\tep := s.GetEndpoint(service, address)\r\n   240\t\tif ep == nil {\r\n   241\t\t\treturn errNotFound(\"endpoint not found\")\r\n   242\t\t}\r\n   243\t\tep.mu.Lock()\r\n"]
[1970.253334, "o", "   244\t\tdefer ep.mu.Unlock()\r\n   245\t\tif weight < 0 {\r\n   246\t\t\tweight = 0\r\n   247\t\t}\r\n   248\t\tep.Weight = weight\r\n   249\t\treturn nil\r\n   250\t}\r\n   251\t\r\n   252\tfunc (s *State) DrainEndpoint(service, address string) error {\r\n   253\t\tss := s.GetService(service)\r\n   254\t\tif ss == nil {\r\n   255\t\t"]
[1970.253438, "o", "\treturn errNotFound(\"service not found\")\r\n   256\t\t}\r\n   257\t\tep := s.GetEndpoint(service, address)\r\n   258\t\tif ep == nil {\r\n   259\t\t\treturn errNotFound(\"endpoint not found\")\r\n   260\t\t}\r\n   261\t\tep.StartDraining(ss.DrainTimeoutMs, false)\r\n   262\t\treturn nil\r\n   263\t}\r\n   264\t\r\n   265\tfunc (s *State) ResetCircuitBreaker(service, address string) error {\r\n   266\t\tep := s.GetEndpoint(service, address)\r\n   267\t\tif ep == nil {\r\n   268\t\t\t"]
[1970.253503, "o", "return errNotFound(\"endpoint not found\")\r\n   269\t\t}\r\n   270\t\tep.Circuit.Reset()\r\n   271\t\treturn nil\r\n   272\t}\r\n   273\t\r\n   274\tfunc (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {\r\n   275\t\tep.mu.Lock()\r\n   276\t\tdefer ep.mu.Unlock()\r\n   277\t\tep.State = Draining\r\n"]
[1970.253583, "o", "   278\t\tep.consecSuccess = 0\r\n   279\t\tep.consecFailures = 0\r\n   280\t\tep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\r\n   281\t\tif markRemoved {\r\n   282\t\t\tep.removed = true\r\n   283\t\t}\r\n   284\t\tif len(ep.connections) > 0 {\r\n   285\t\t\tgo func(deadline time.Time, conns map[int64]net.Conn) {\r\n   286\t\t\t\ttime.Sleep(time.Until(deadline))\r\n   287\t\t\t\tep.closeConnectionsLocked()\r\n   288\t\t\t}(ep.drainDeadline, ep.connections)\r\n"]
[1970.253644, "o", "   289\t\t}\r\n   290\t}\r\n   291\t\r\n   292\tfunc (ep *EndpointState) AddConnection(conn net.Conn) int64 {\r\n   293\t\tep.mu.Lock()\r\n   294\t\tdefer ep.mu.Unlock()\r\n   295\t\tid := atomic.AddInt64(&ep.connIDCounter, 1)\r\n   296\t\tep.connections[id] = conn\r\n   297\t"]
[1970.253704, "o", "\tep.ActiveConnections++\r\n   298\t\treturn id\r\n   299\t}\r\n   300\t\r\n   301\tfunc (ep *EndpointState) RemoveConnection(id int64) {\r\n   302\t\tep.mu.Lock()\r\n   303\t\tdefer ep.mu.Unlock()\r\n   304\t\tif _, ok := ep.connections[id]; ok {\r\n   305\t\t\tdelete(ep.connections, id)\r\n"]
[1970.253768, "o", "   306\t\t\tif ep.ActiveConnections > 0 {\r\n   307\t\t\t\tep.ActiveConnections--\r\n   308\t\t\t}\r\n   309\t\t}\r\n   310\t}\r\n   311\t\r\n   312\tfunc (ep *EndpointState) closeConnectionsLocked() {\r\n   313\t\tfor id, c := range ep.connections {\r\n   314\t\t\tc.Close()\r\n"]
[1970.253833, "o", "   315\t\t\tdelete(ep.connections, id)\r\n   316\t\t}\r\n   317\t}\r\n   318\t\r\n   319\tfunc (ep *EndpointState) Active() int {\r\n   320\t\tep.mu.Lock()\r\n   321\t\tdefer ep.mu.Unlock()\r\n   322\t\treturn ep.ActiveConnections\r\n"]
[1970.253892, "o", "   323\t}\r\n   324\t\r\n   325\tfunc (ep *EndpointState) IsEligible(maxConns int) bool {\r\n   326\t\tep.mu.Lock()\r\n   327\t\tdefer ep.mu.Unlock()\r\n   328\t\treturn ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n   329\t}\r\n   330\t\r\n   331\tfunc (s *State) RecordHealthCheck(service, address string, success bool) HealthEvent {\r\n   332\t"]
[1970.253955, "o", "\tss := s.GetService(service)\r\n   333\t\tif ss == nil {\r\n   334\t\t\treturn HealthEvent{}\r\n   335\t\t}\r\n   336\t\tep := s.GetEndpoint(service, address)\r\n   337\t\tif ep == nil {\r\n   338\t\t\treturn HealthEvent{}\r\n   339\t\t}\r\n   340\t\tglobal := s.Global()\r\n   341\t\t"]
[1970.254018, "o", "ep.mu.Lock()\r\n   342\t\toldState := ep.State\r\n   343\t\tresult := \"success\"\r\n   344\t\tif !success {\r\n   345\t\t\tresult = \"failure\"\r\n   346\t\t}\r\n   347\t\tif success {\r\n   348\t\t\tep.consecSuccess++\r\n   349"]
[1970.254076, "o", "\t\t\tep.consecFailures = 0\r\n   350\t\t\tif oldState == Unknown && ep.consecSuccess >= global.HealthyThreshold {\r\n   351\t\t\t\tep.State = Healthy\r\n   352\t\t\t} else if oldState == Unhealthy && ep.consecSuccess >= global.HealthyThreshold {\r\n   353\t\t\t\tep.State = Healthy\r\n   354\t\t\t}\r\n   355\t\t} else {\r\n   356\t\t\tep.consecFailures++\r\n"]
[1970.25415, "o", "   357\t\t\tep.consecSuccess = 0\r\n   358\t\t\tif (oldState == Healthy || oldState == Unknown) && ep.consecFailures >= global.UnhealthyThreshold {\r\n   359\t\t\t\tep.State = Unhealthy\r\n   360\t\t\t\tep.Circuit.Open()\r\n   361\t\t\t\tep.consecFailures = 0\r\n   362\t\t\t\ttimeout := time.Duration(ss.DrainTimeoutMs) * time.Millisecond\r\n   363\t\t\t\tgo func(deadline time.Time) {\r\n   364\t\t\t\t\ttime.Sleep(time.Until(deadline))\r\n   365\t\t\t\t\tep.mu.Lock()\r\n   366\t\t\t\t\tep.closeConnectionsLocked()\r\n   367\t\t\t\t\tep.mu.Unlock()\r\n"]
[1970.25422, "o", "   368\t\t\t\t}(time.Now().Add(timeout))\r\n   369\t\t\t}\r\n   370\t\t}\r\n   371\t\tnewState := ep.State\r\n   372\t\tep.mu.Unlock()\r\n   373\t\tevt := HealthEvent{\r\n   374\t\t\tTimestamp:   time.Now(),\r\n   375\t\t\tEndpoint:    address,\r\n   376\t\t\t"]
[1970.254282, "o", "OldState:    oldState,\r\n   377\t\t\tNewState:    newState,\r\n   378\t\t\tCheckResult: result,\r\n   379\t\t}\r\n   380\t\ts.logMu.Lock()\r\n   381\t\ts.healthLog[service] = append(s.healthLog[service], evt)\r\n   382\t\tif len(s.healthLog[service]) > 1000 {\r\n   383\t\t\ts.healthLog[service] = s.healthLog[service][len(s.healthLog[service])-1000:]\r\n"]
[1970.254353, "o", "   384\t\t}\r\n   385\t\ts.logMu.Unlock()\r\n   386\t\treturn evt\r\n   387\t}\r\n   388\t\r\n   389\tfunc (s *State) HealthLog(service string, lastN int) []HealthEvent {\r\n   390\t\ts.logMu.Lock()\r\n   391\t\tdefer s.logMu.Unlock()\r\n   392\t\tevents := s.healthLog[service]\r\n   393\t\tif lastN <= 0 || lastN > len(events) {\r\n   394\t\t\tlastN = len(events)\r\n"]
[1970.254425, "o", "   395\t\t}\r\n   396\t\tout := make([]HealthEvent, lastN)\r\n   397\t\tcopy(out, events[len(events)-lastN:])\r\n   398\t\treturn out\r\n   399\t}\r\n   400\t\r\n   401\ttype notFoundError struct {\r\n   402\t\tmsg string\r\n"]
[1970.254483, "o", "   403\t}\r\n   404\t\r\n   405\tfunc (e *notFoundError) Error() string {\r\n   406\t\treturn e.msg\r\n   407\t}\r\n   408\t\r\n   409\tfunc errNotFound(msg string) error {\r\n   410\t\treturn &notFoundError{msg: msg}\r\n"]
