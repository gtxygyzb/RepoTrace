[9533.32722, "o", "\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tTs         string `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"ts\"`\r\n\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tService    string `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"service\"`\r\n\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tClient     string `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"client\"`\r\n\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tEndpoint   string `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"endpoint\"`\r\n\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tBytesIn    int64  `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"bytes_in\"`\r\n\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tBytesOut   int64  `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"bytes_out\"`\r\n\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tDurationMs int64  `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"duration_ms\"`\r\n\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tResult     string `\u001b[01;31m\u001b[Kjson:\u001b[m\u001b[K\"result\"`\r\n"]
