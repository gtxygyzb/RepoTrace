[8378.422197, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path(\"internal/router/router.go\")\ns = p.read_text()\nold = '''        allowed, queued := ss.AcquireRateLimitToken()\n        if !allowed {\n                result = \"rejected_rate_limit\"\n                client.Close()\n                return\n        }\n'''\nnew = '''        allowed, queued := ss.AcquireRateLimitToken()\n        if !allowed {\n                result = \"rejected_rate_limit\"\n                if queued {\n                        if cand, cerr := r.state.SelectCandidate(service); cerr == nil {\n                                cand.Stats.RecordQueueTimeout()\n                        }\n                } else {\n                        if cand, cerr := r.state.SelectCandidate(service); cerr == nil {\n                                cand.Stats.RecordRateLimited()\n                        }\n                }\n                client.Close()\n                return\n        }\n'''\nif old in s:\n    s = s.replace(old, new)\np.write_text(s)\nPY\n"]
