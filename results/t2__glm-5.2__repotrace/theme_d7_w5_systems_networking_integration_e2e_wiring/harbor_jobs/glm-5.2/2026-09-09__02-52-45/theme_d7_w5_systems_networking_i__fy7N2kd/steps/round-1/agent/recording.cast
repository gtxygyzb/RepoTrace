[11467.793785, "o", "\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kcase \"list_services\"\u001b[m\u001b[K:\r\n"]
[11467.793825, "o", "\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tvar services []struct {\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tName        string `json:\"name\"`\r\n\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tListenPort  int    `json:\"listen_port\"`\r\n\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tRoutingMode string `json:\"routing_mode\"`\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tEndpoints   []struct {\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[11467.793856, "o", "\t\t\t\tAddress           string `json:\"address\"`\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tState             string `json:\"state\"`\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tWeight            int    `json:\"weight\"`\r\n"]
