[14015.542894, "o", "     1\tpackage state\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"sort\"\r\n     5\t\t\"time\"\r\n     6\t)\r\n     7\t\r\n     8\t// SelectResult contains selected endpoint and whether it is a half-open probe.\r\n     9\ttype SelectResult struct {"]
[14015.543009, "o", "\r\n    10\t\tEndpoint   *EndpointState\r\n    11\t\tProbe      bool\r\n    12\t\tMaxConns   int\r\n    13\t\tPerService bool\r\n    14\t}\r\n    15\t\r\n    16\t// SelectEndpoint chooses an endpoint for the next connection.\r\n    17\tfunc (s *State) SelectEndpoint(service string) (SelectResult, error) {\r\n    18\t\treturn s.selectEndpointExcluding(service, nil)\r\n    19\t}\r\n    20\t\r\n    21\t// SelectCandidate returns the endpoint that would be selected ignoring connection limits.\r\n"]
[14015.543094, "o", "    22\t// Used to account rejected_connections when all eligible endpoints are at capacity.\r\n    23\tfunc (s *State) SelectCandidate(service string) (*EndpointState, error) {\r\n    24\t\tss := s.GetService(service)\r\n    25\t\tif ss == nil {\r\n    26\t\t\treturn nil, errNotFound(\"service not found\")\r\n    27\t\t}\r\n    28\t\tss.mu.Lock()\r\n    29\t\tmode := ss.RoutingMode\r\n    30\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n    31"]
[14015.543175, "o", "\t\tcopy(endpoints, ss.Endpoints)\r\n    32\t\tss.mu.Unlock()\r\n    33\t\r\n    34\t\tvar regular []*EndpointState\r\n    35\t\tfor _, ep := range endpoints {\r\n    36\t\t\tep.mu.Lock()\r\n    37\t\t\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining\r\n    38\t\t\tep.mu.Unlock()\r\n    39\t\t\tif eligible {\r\n"]
[14015.54322, "o", "    40\t\t\t\tregular = append(regular, ep)\r\n    41\t\t\t}\r\n    42\t\t}\r\n    43\t\tif len(regular) == 0 {\r\n"]
[14015.543319, "o", "    44\t\t\tfor _, ep := range endpoints {\r\n    45\t\t\t\tep.mu.Lock()\r\n    46\t\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining\r\n    47\t\t\t\tep.mu.Unlock()\r\n    48\t\t\t\tif halfOpen {\r\n    49\t\t\t\t\treturn ep, nil\r\n    50\t\t\t\t}\r\n    51\t\t\t}\r\n    52\t\t\treturn nil, errNotFound(\"no eligible endpoints\")\r\n    53\t\t}\r\n    54\t\tif mode == \"least-connections\" {\r\n    55\t\t\treturn selectLeastConnections(regular, 1<<30), nil\r\n"]
[14015.543416, "o", "    56\t\t}\r\n    57\t\treturn selectWeightedCandidate(regular), nil\r\n    58\t}\r\n    59\t\r\n    60\tfunc selectWeighted(eps []*EndpointState) *EndpointState {\r\n    61\t\tvar best *EndpointState\r\n    62\t\tvar bestWeight int\r\n    63\t\tvar totalWeight int\r\n    64\t\tfor _, ep := range eps {\r\n    65\t\t\t"]
[14015.543491, "o", "ep.mu.Lock()\r\n    66\t\t\tw := ep.effectiveWeightLocked()\r\n    67\t\t\tep.currentWeight += w\r\n    68\t\t\ttotalWeight += w\r\n    69\t\t\tcw := ep.currentWeight\r\n    70\t\t\tep.mu.Unlock()\r\n    71\t\t\tif best == nil || cw > bestWeight {\r\n    72\t\t\t\tbest = ep\r\n    73\t\t\t\tbestWeight = cw\r\n    74\t\t\t}\r\n    75\t\t}\r\n    76\t"]
[14015.543554, "o", "\tif best != nil {\r\n    77\t\t\tbest.mu.Lock()\r\n    78\t\t\tbest.currentWeight -= totalWeight\r\n    79\t\t\tbest.mu.Unlock()\r\n    80\t\t}\r\n    81\t\treturn best\r\n    82\t}\r\n    83\t\r\n    84\t"]
[14015.543627, "o", "func selectWeightedCandidate(eps []*EndpointState) *EndpointState {\r\n    85\t\tvar best *EndpointState\r\n    86\t\tvar bestWeight int\r\n    87\t\tfor _, ep := range eps {\r\n    88\t\t\tep.mu.Lock()\r\n    89\t\t\tcw := ep.currentWeight + ep.effectiveWeightLocked()\r\n    90\t\t\tep.mu.Unlock()\r\n    91\t\t\tif best == nil || cw > bestWeight {\r\n    92\t\t\t\tbest = ep\r\n"]
[14015.543674, "o", "    93\t\t\t\tbestWeight = cw\r\n    94\t\t\t}\r\n    95\t\t}\r\n    96\t\treturn best\r\n    97\t}\r\n    98\t\r\n    99\tfunc selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {"]
[14015.54376, "o", "\r\n   100\t\tsort.SliceStable(eps, func(i, j int) bool {\r\n   101\t\t\tai := eps[i].Active()\r\n   102\t\t\taj := eps[j].Active()\r\n   103\t\t\tif ai != aj {\r\n   104\t\t\t\treturn ai < aj\r\n   105\t\t\t}\r\n   106\t\t\t// Tie-break by effective weight (higher weight first), then lexicographic address.\r\n   107\t\t\twi := eps[i].EffectiveWeight()\r\n   108\t\t\twj := eps[j].EffectiveWeight()\r\n   109\t\t\tif wi != wj {\r\n   110\t\t\t"]
[14015.543803, "o", "\treturn wi > wj\r\n   111\t\t\t}\r\n   112\t\t\treturn eps[i].Address < eps[j].Address\r\n   113\t\t})\r\n   114\t\treturn eps[0]\r\n"]
[14015.543888, "o", "   115\t}\r\n   116\t\r\n   117\t// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\r\n   118\tfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\r\n   119\t\treturn s.selectEndpointExcluding(service, exclude)\r\n   120\t}\r\n   121\t\r\n   122\tfunc (s *State) selectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\r\n   123\t\tss := s.GetService(service)\r\n   124\t\tif ss == nil {\r\n   125\t\t\treturn SelectResult{}, errNotFound(\"service not found\")\r\n   126\t\t}\r\n"]
[14015.543961, "o", "   127\t\tss.mu.Lock()\r\n   128\t\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n   129\t\tmode := ss.RoutingMode\r\n   130\t\tperService := ss.ConnectionLimitMode == \"per-service\"\r\n   131\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n"]
[14015.544005, "o", "   132\t\tcopy(endpoints, ss.Endpoints)\r\n   133\t\tss.mu.Unlock()\r\n   134\t\r\n   135\t\tnow := time.Now()\r\n   136\t\t_ = now\r\n   137\t\r\n   138\t\ttotalActive := 0\r\n   139\t\tif perService {\r\n   140\t\t\tfor _, ep := range endpoints {\r\n   141\t\t\t\tep.mu.Lock()\r\n"]
[14015.544088, "o", "   142\t\t\t\ttotalActive += ep.ActiveConnections\r\n   143\t\t\t\tep.mu.Unlock()\r\n   144\t\t\t}\r\n   145\t\t}\r\n   146\t\r\n   147\t\tvar regular []*EndpointState\r\n   148\t\tfor _, ep := range endpoints {\r\n   149\t\t\tif exclude != nil && ep == exclude {\r\n   150\t\t\t\tcontinue\r\n   151\t\t\t}\r\n   152\t\t\tep.mu.Lock()\r\n"]
[14015.544159, "o", "   153\t\t\tvar eligible bool\r\n   154\t\t\tif perService {\r\n   155\t\t\t\teligible = ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && totalActive < maxConns\r\n   156\t\t\t} else {\r\n   157\t\t\t\teligible = ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\r\n   158\t\t\t}\r\n   159\t\t\tep.mu.Unlock()\r\n   160\t\t\tif eligible {\r\n"]
[14015.544206, "o", "   161\t\t\t\tregular = append(regular, ep)\r\n   162\t\t\t}\r\n   163\t\t}\r\n   164\t\r\n   165\t\tif len(regular) > 0 {\r\n   166\t\t\tif mode == \"least-connections\" {\r\n   167\t\t\t\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns, PerService: perService}, nil\r\n"]
[14015.544287, "o", "   168\t\t\t}\r\n   169\t\t\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns, PerService: perService}, nil\r\n   170\t\t}\r\n   171\t\r\n   172\t\tfor _, ep := range endpoints {\r\n   173\t\t\tif exclude != nil && ep == exclude {\r\n   174\t\t\t\tcontinue\r\n   175\t\t\t}\r\n   176\t\t\tep.mu.Lock()\r\n   177\t\t\tvar halfOpen bool\r\n   178\t\t\tif perService {\r\n   179\t\t\t\thalfOpen = ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && totalActive < maxConns\r\n"]
[14015.544329, "o", "   180\t\t\t} else {\r\n"]
