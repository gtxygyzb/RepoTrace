[3172.886506, "o", "   146\t}\r\n   147\t\r\n   148\t// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\r\n   149\tfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\r\n   150\t\tres, err := s.SelectEndpoint(service)\r\n   151\t\tif err != nil {\r\n   152\t\t\treturn res, err\r\n"]
