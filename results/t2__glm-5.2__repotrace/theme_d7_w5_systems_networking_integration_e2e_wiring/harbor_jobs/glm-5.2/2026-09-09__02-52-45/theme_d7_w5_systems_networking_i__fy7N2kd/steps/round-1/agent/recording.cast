[14526.64328, "i", "python3 - <<'PY'\np = 'internal/ipc/server.go'\nwith open(p) as f:\n    s = f.read()\n\ninsert = '''\\tcase \"get_mirror_status\":\n\\t\\tvar args struct {\n\\t\\t\\tName string `json:\"name\"`\n\\t\\t}\n\\t\\tif err := json.Unmarshal(req.Args, &args); err != nil {\n\\t\\t\\treturn nil, err\n\\t\\t}\n\\t\\tss := s.state.GetService(args.Name)\n\\t\\tif ss == nil {\n\\t\\t\\treturn nil, errors.New(\"service not found\")\n\\t\\t}\n\\t\\tendpoint, pct, count := ss.MirrorStatus()\n\\t\\treturn map[string]interface{}{\n\\t\\t\\t\"service\":             args.Name,\n\\t\\t\\t\"mirror_endpoint\":     endpoint,\n\\t\\t\\t\"mirror_sample_pct\":   pct,\n\\t\\t\\t\"mirrored_connections\": int(count),\n\\t\\t}, nil\n\\tdefault:\n\\t\\treturn nil, fmt.Errorf(\"unknown command: %s\", req.Cmd)\n\\t}\n}\n'''\n\nold = '''\\tdefault:\n\\t\\treturn nil, fmt.Errorf(\"unknown command: %s\", req.Cmd)\n\\t}\n}\n'''\nif old in s:\n    s = s.replace(old, insert)\nelse:\n    print('WARNING: default case not found')\n\nwith open(p, 'w') as f:\n    f.write(s)\nprint('server.go updated')\nPY\n"]
