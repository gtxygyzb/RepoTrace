[8366.832158, "o", "# Insert pretty print cases\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.832213, "o", "> "]
[8366.832291, "o", "lines = p.read_text().splitlines()\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.832346, "o", "> "]
[8366.832478, "o", "if 'case \"get_access_log\"' not in '\\n'.join(lines):\r\n\u001b[?2004l\r"]
[8366.832537, "o", "\u001b[?2004h> "]
[8366.832609, "o", "    for i, line in enumerate(lines):\r\n\u001b[?2004l\r"]
[8366.832666, "o", "\u001b[?2004h> "]
[8366.832818, "o", "        if line.strip() == 'case \"get_rate_limit_status\":':\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.832878, "o", "> "]
[8366.833011, "o", "            indent = line[:len(line)-len(line.lstrip())]\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.833071, "o", "> "]
[8366.833143, "o", "            cases = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.833257, "o", "                'case \"get_access_log\":',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.833319, "o", "> "]
[8366.833432, "o", "                '    var entries []struct {',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.833617, "o", "                '        Ts         string `json:\"ts\"`',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.833678, "o", "> "]
[8366.833824, "o", "                '        Service    string `json:\"service\"`',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.833884, "o", "> "]
[8366.834028, "o", "                '        Client     string `json:\"client\"`',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.834085, "o", "> "]
[8366.834235, "o", "                '        Endpoint   string `json:\"endpoint\"`',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.834292, "o", "> "]
[8366.83445, "o", "                '        BytesIn    int64  `json:\"bytes_in\"`',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.834507, "o", "> "]
[8366.834668, "o", "                '        BytesOut   int64  `json:\"bytes_out\"`',\r\n\u001b[?2004l\r"]
[8366.834726, "o", "\u001b[?2004h> "]
[8366.834887, "o", "                '        DurationMs int64  `json:\"duration_ms\"`',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.834944, "o", "> "]
[8366.835096, "o", "                '        Result     string `json:\"result\"`',\r\n\u001b[?2004l\r"]
[8366.835154, "o", "\u001b[?2004h> "]
[8366.835226, "o", "                '    }',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.835466, "o", "                '    if err := json.Unmarshal(data, &entries); err != nil {',\r\n\u001b[?2004l\r"]
[8366.835525, "o", "\u001b[?2004h> "]
[8366.835627, "o", "                '        return \"\", err',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.835731, "o", "                '    }',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.835953, "o", "                '    b, err := json.MarshalIndent(entries, \"\", \"  \")',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.83601, "o", "> "]
[8366.836085, "o", "                '    if err != nil {',\r\n\u001b[?2004l\r"]
[8366.836157, "o", "\u001b[?2004h> "]
[8366.836257, "o", "                '        return \"\", err',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.836356, "o", "                '    }',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.836433, "o", "> "]
[8366.836508, "o", "                '    return string(b), nil',\r\n\u001b[?2004l\r"]
[8366.836576, "o", "\u001b[?2004h> "]
[8366.836678, "o", "                'case \"get_access_stats\":',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.836815, "o", "                '    var st struct {',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.836872, "o", "> "]
[8366.837041, "o", "                '        TotalRequests int `json:\"total_requests\"`',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.837097, "o", "> "]
[8366.837246, "o", "                '        ByResult      map[string]struct {',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.837304, "o", "> "]
[8366.837474, "o", "                '            Count         int   `json:\"count\"`',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.837713, "o", "                '            AvgDurationMs int64 `json:\"avg_duration_ms\"`',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.837772, "o", "> "]
[8366.837953, "o", "                '            TotalBytesIn  int64 `json:\"total_bytes_in\"`',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.83801, "o", "> "]
[8366.8382, "o", "                '            TotalBytesOut int64 `json:\"total_bytes_out\"`',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.838256, "o", "> "]
[8366.838368, "o", "                '        } `json:\"by_result\"`',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.83843, "o", "> "]
[8366.838478, "o", "                '    }',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.838546, "o", "> "]
[8366.838713, "o", "                '    if err := json.Unmarshal(data, &st); err != nil {',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.838773, "o", "> "]
[8366.83887, "o", "                '        return \"\", err',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.838973, "o", "                '    }',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.839033, "o", "> "]
[8366.839132, "o", "                '    var b strings.Builder',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.83958, "o", "                '    fmt.Fprintf(&b, \"%-20s %-6s %-15s %-15s %-15s\\\\n\", \"RESULT\", \"COUNT\", \"AVG_DURATION_MS\", \"TOTAL_BYTES_IN\", \"TOTAL_BYTES_OUT\")',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.839645, "o", "> "]
[8366.839809, "o", "                '    results := make([]string, 0, len(st.ByResult))',\r\n\u001b[?2004l\r"]
[8366.839867, "o", "\u001b[?2004h> "]
[8366.839973, "o", "                '    for name := range st.ByResult {',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.840098, "o", "                '        results = append(results, name)',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.840168, "o", "                '    }',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.840277, "o", "                '    sort.Strings(results)',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.840407, "o", "                '    for _, name := range results {',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.840518, "o", "                '        r := st.ByResult[name]',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.840802, "o", "                '        fmt.Fprintf(&b, \"%-20s %-6d %-15d %-15d %-15d\\\\n\", name, r.Count, r.AvgDurationMs, r.TotalBytesIn, r.TotalBytesOut)',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.840869, "o", "                '    }',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.841025, "o", "                '    return strings.TrimRight(b.String(), \"\\\\n\"), nil',\r\n\u001b[?2004l\r\u001b[?2004h"]
[8366.841083, "o", ">             ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.841154, "o", "            new_lines = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.841225, "o", "            for c in cases:\r\n\u001b[?2004l\r"]
[8366.841298, "o", "\u001b[?2004h> "]
[8366.841369, "o", "                new_lines.append(indent + c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.841469, "o", "            lines = lines[:i] + new_lines + lines[i:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.841539, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.841632, "o", "    p.write_text(\"\\n\".join(lines) + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[8366.841699, "o", "\u001b[?2004h> "]
[8366.841769, "o", "if '\"sort\"' not in p.read_text():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.841835, "o", "    s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.841936, "o", "    s = s.replace('import (\\n', 'import (\\n    \"sort\"\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8366.842006, "o", "    p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h"]
