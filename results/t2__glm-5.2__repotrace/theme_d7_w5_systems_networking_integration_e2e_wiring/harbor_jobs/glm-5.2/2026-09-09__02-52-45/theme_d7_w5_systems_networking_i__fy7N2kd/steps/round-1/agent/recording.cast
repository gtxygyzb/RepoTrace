[10773.833543, "o", "\r\n\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tStats             *stats.Collector\r\n\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tconsecSuccess     int\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tconsecFailures    int\r\n\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdrainDeadline     time.Time\r\n\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tremoved           bool\r\n\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tconnIDCounter     int64\r\n\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcurrentWeight     int\r\n\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tWarmupDurationMs  int\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[10773.833593, "o", "\twarmupUntil       time.Time\r\n\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tconnections       map[int64]*connectionInfo\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Ktype connectionInfo struct {\r\n\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tconn         net.Conn\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tclientAddr   string\r\n\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[10773.833643, "o", "\tstart        time.Time\r\n\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tlastActivity time.Time\r\n\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tbytesIn      int64\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tbytesOut     int64\r\n\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Ktype ServiceState struct {\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[10773.833695, "o", "\tmu                        sync.Mutex\r\n\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tName                      string\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tListenPort                int\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRoutingMode               string\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tDrainTimeoutMs            int\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tMaxConnectionsPerEndpoint int\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tConnectionLimitMode       string\r\n"]
[10773.833735, "o", "\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tIdleTimeoutMs             int\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRateLimitRps              int\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRateLimitBurst            int\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tRateLimitQueueDepth       int\r\n"]
