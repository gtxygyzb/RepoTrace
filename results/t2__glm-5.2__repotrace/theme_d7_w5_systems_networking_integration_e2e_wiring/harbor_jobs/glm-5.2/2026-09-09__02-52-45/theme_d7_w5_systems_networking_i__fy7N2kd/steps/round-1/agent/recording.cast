[2043.015964, "o", "     6\t\r\n     7\t\t\"meshrouter/internal/stats\"\r\n     8\t)\r\n     9\t\r\n    10\ttype EndpointView struct {\r\n    11\t\tAddress           string `json:\"address\"`\r\n    12\t\tState             string `json:\"state\"`\r\n    13\t\tWeight            int    `json:\"weight\"`\r\n    14\t\tActiveConnections int    `json:\"active_connections\"`\r\n    15\t\tCircuitState      string `json:\"circuit_state\"`\r\n    16\t}\r\n    17\t\r\n    18\ttype ServiceView struct {\r\n    19\t\tName        string         `json:\"name\"`\r\n    20\t\tListenPort  int            `json:\"listen_port\"`\r\n    21\t\tRoutingMode string         `json:\"routing_mode\"`\r\n"]
[2043.016007, "o", "    22\t\tEndpoints   []EndpointView `json:\"endpoints\"`\r\n    23\t}\r\n    24\t\r\n    25\tfunc (s *State) ServiceView(name string) (ServiceView, bool) {\r\n    26\t\tss := s.GetService(name)\r\n    27\t\tif ss == nil {\r\n    28\t\t\treturn ServiceView{}, false\r\n"]
[2043.016034, "o", "    29\t\t}\r\n    30\t\treturn ss.View(), true\r\n    31\t}\r\n    32\t\r\n    33\tfunc (s *State) ServicesView() []ServiceView {\r\n"]
[2043.016162, "o", "    34\t\tservices := s.Services()\r\n    35\t\tout := make([]ServiceView, 0, len(services))\r\n    36\t\tfor _, ss := range services {\r\n    37\t\t\tout = append(out, ss.View())\r\n    38\t\t}\r\n    39\t\tsort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })\r\n    40\t\treturn out\r\n    41\t}\r\n    42\t\r\n    43\tfunc (ss *ServiceState) View() ServiceView {\r\n    44\t\tss.mu.Lock()\r\n    45\t\tdefer ss.mu.Unlock()\r\n    46\t\tsv := ServiceView{\r\n    47\t\t\tName:        ss.Name,\r\n    48\t\t\tListenPort:  ss.ListenPort,\r\n    49\t\t\tRoutingMode: ss.RoutingMode,\r\n    50\t\t\tEndpoints:   make([]EndpointView, 0, len(ss.Endpoints)),\r\n    51\t\t}\r\n    52\t\tfor _, ep := range ss.Endpoints {\r\n"]
[2043.01624, "o", "    53\t\t\tep.mu.Lock()\r\n    54\t\t\tsv.Endpoints = append(sv.Endpoints, EndpointView{\r\n    55\t\t\t\tAddress:           ep.Address,\r\n    56\t\t\t\tState:             string(ep.State),\r\n    57\t\t\t\tWeight:            ep.Weight,\r\n    58\t\t\t\tActiveConnections: ep.ActiveConnections,\r\n    59\t\t\t\tCircuitState:      string(ep.Circuit.State()),\r\n    60\t\t\t})\r\n    61\t\t\tep.mu.Unlock()\r\n    62\t\t}\r\n    63\t\treturn sv\r\n    64\t}\r\n    65\t"]
[2043.016313, "o", "\r\n    66\ttype StatsEndpointView struct {\r\n    67\t\tAddress string `json:\"address\"`\r\n    68\t\tstats.Snapshot\r\n    69\t}\r\n    70\t\r\n    71\ttype StatsView struct {\r\n    72\t\tService   string              `json:\"service\"`\r\n    73\t\tWindowSec int                 `json:\"window_sec\"`\r\n    74\t\tEndpoints []StatsEndpointView `json:\"endpoints\"`\r\n    75\t}\r\n"]
[2043.016419, "o", "    76\t\r\n    77\tfunc (s *State) StatsView(name string, windowSec int) (StatsView, bool) {\r\n    78\t\tss := s.GetService(name)\r\n    79\t\tif ss == nil {\r\n    80\t\t\treturn StatsView{}, false\r\n    81\t\t}\r\n    82\t\tsv := StatsView{\r\n    83\t\t\tService:   name,\r\n    84\t\t\tWindowSec: windowSec,\r\n    85\t\t\tEndpoints: make([]StatsEndpointView, 0),\r\n    86\t\t"]
[2043.016489, "o", "}\r\n    87\t\tss.mu.Lock()\r\n    88\t\tfor _, ep := range ss.Endpoints {\r\n    89\t\t\tep.mu.Lock()\r\n    90\t\t\tsv.Endpoints = append(sv.Endpoints, StatsEndpointView{\r\n    91\t\t\t\tAddress:  ep.Address,\r\n    92\t\t\t\tSnapshot: ep.Stats.Snapshot(ep.ActiveConnections),\r\n    93\t\t\t})\r\n    94\t\t\tep.mu.Unlock()\r\n    95\t\t}\r\n    96\t\tss.mu.Unlock()\r\n    97\t\treturn sv, true\r\n    98\t}\r\n    99\t\r\n"]
[2043.01656, "o", "   100\ttype HealthEventView struct {\r\n   101\t\tTimestamp   time.Time `json:\"timestamp\"`\r\n   102\t\tEndpoint    string    `json:\"endpoint\"`\r\n   103\t\tOldState    string    `json:\"old_state\"`\r\n   104\t\tNewState    string    `json:\"new_state\"`\r\n   105\t\tCheckResult string    `json:\"check_result\"`\r\n   106\t}\r\n   107\t\r\n   108\tfunc (s *State) HealthLogView(name string, lastN int) []HealthEventView {\r\n   109\t\tevents := s.HealthLog(name, lastN)\r\n   110\t\tout := make([]HealthEventView, 0, len(events))\r\n   111\t"]
[2043.016631, "o", "\tfor _, e := range events {\r\n   112\t\t\tout = append(out, HealthEventView{\r\n   113\t\t\t\tTimestamp:   e.Timestamp,\r\n   114\t\t\t\tEndpoint:    e.Endpoint,\r\n   115\t\t\t\tOldState:    string(e.OldState),\r\n   116\t\t\t\tNewState:    string(e.NewState),\r\n   117\t\t\t\tCheckResult: e.CheckResult,\r\n   118\t\t\t})\r\n   119\t\t}\r\n   120\t\treturn out\r\n   121\t}\r\n   122\t\r\n"]
[2043.016701, "o", "   123\ttype CircuitView struct {\r\n   124\t\tAddress             string `json:\"address\"`\r\n   125\t\tCircuitState        string `json:\"circuit_state\"`\r\n   126\t\tConsecutiveFailures int    `json:\"consecutive_failures\"`\r\n   127\t\tTimeInStateMs       int64  `json:\"time_in_state_ms\"`\r\n   128\t\tProbeActive         bool   `json:\"probe_active\"`\r\n   129\t}\r\n   130\t\r\n   131\tfunc (s *State) CircuitsView(name string) ([]CircuitView, bool) {\r\n   132\t\tss := s.GetService(name)\r\n"]
[2043.016795, "o", "   133\t\tif ss == nil {\r\n   134\t\t\treturn nil, false\r\n   135\t\t}\r\n   136\t\tss.mu.Lock()\r\n   137\t\tout := make([]CircuitView, 0, len(ss.Endpoints))\r\n   138\t\tfor _, ep := range ss.Endpoints {\r\n   139\t\t\tep.mu.Lock()\r\n   140\t\t\tout = append(out, CircuitView{\r\n   141\t\t\t\tAddress:             ep.Address,\r\n   142\t\t\t\tCircuitState:        string(ep.Circuit.State()),\r\n   143\t\t\t\tConsecutiveFailures: ep.Circuit.ConsecutiveFailures(),\r\n   144\t\t\t\tTimeInStateMs:       ep.Circuit.TimeInStateMs(),\r\n   145\t\t\t\tProbeActive:         ep.Circuit.ProbeActive(),\r\n"]
[2043.016865, "o", "   146\t\t\t})\r\n   147\t\t\tep.mu.Unlock()\r\n   148\t\t}\r\n   149\t\tss.mu.Unlock()\r\n   150\t\treturn out, true\r\n   151\t}\r\n   152\t\r\n   153\tfunc (s *State) ResolveEndpoint(service string) (string, error) {\r\n   154\t\tss := s.GetService(service)\r\n   155\t\tif ss == nil {\r\n   156\t\t\treturn \"\", errNotFound(\"service not found\")\r\n   157\t\t}\r\n   158"]
[2043.01699, "o", "\t\tss.mu.Lock()\r\n   159\t\tmaxConns := ss.MaxConnectionsPerEndpoint\r\n   160\t\tmode := ss.RoutingMode\r\n   161\t\tendpoints := make([]*EndpointState, len(ss.Endpoints))\r\n   162\t\tcopy(endpoints, ss.Endpoints)\r\n   163\t\tss.mu.Unlock()\r\n   164\t\r\n   165\t\tvar regular []*EndpointState\r\n   166\t\tfor _, ep := range endpoints {\r\n   167\t\t\tif ep.IsEligible(maxConns) {\r\n   168\t\t\t\tregular = append(regular, ep)\r\n   169\t\t\t}\r\n   170\t\t}\r\n   171\t\r\n   172\t\tif len(regular) > 0 {\r\n   173\t\t\tif mode == \"least-connections\" {\r\n   174\t\t\t\tep := selectLeastConnections(regular, maxConns)\r\n   175\t\t\t\treturn ep.Address, nil\r\n   176\t\t\t}\r\n   177\t\t\tvar best *EndpointState\r\n"]
[2043.017061, "o", "   178\t\t\tvar bestWeight int\r\n   179\t\t\tfor _, ep := range regular {\r\n   180\t\t\t\tep.mu.Lock()\r\n   181\t\t\t\tcw := ep.currentWeight + ep.Weight\r\n   182\t\t\t\tep.mu.Unlock()\r\n   183\t\t\t\tif best == nil || cw > bestWeight {\r\n   184\t\t\t\t\tbest = ep\r\n   185\t\t\t\t\tbestWeight = cw\r\n   186\t\t\t\t}\r\n   187\t\t\t}\r\n   188\t\t\tif best != nil {\r\n   189\t\t\t\treturn best.Address, nil\r\n"]
[2043.017142, "o", "   190\t\t\t}\r\n   191\t\t}\r\n   192\t\r\n   193\t\tfor _, ep := range endpoints {\r\n   194\t\t\tep.mu.Lock()\r\n   195\t\t\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns && !ep.Circuit.ProbeActive()\r\n   196\t\t\tep.mu.Unlock()\r\n   197\t\t\tif halfOpen {\r\n   198\t\t\t\treturn ep.Address, nil\r\n   199\t\t\t}\r\n   200\t\t}\r\n   201\t\t"]
[2043.017213, "o", "return \"\", errNotFound(\"no eligible endpoints\")\r\n   202\t}\r\n"]
