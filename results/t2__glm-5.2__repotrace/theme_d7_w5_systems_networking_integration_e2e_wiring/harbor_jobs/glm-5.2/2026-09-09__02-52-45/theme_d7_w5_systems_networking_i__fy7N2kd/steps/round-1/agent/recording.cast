[2198.843668, "i", "cat > internal/state/ratelimit.go <<'EOF'\npackage state\n\nimport (\n\t\"container/list\"\n\t\"sync\"\n\t\"time\"\n)\n\ntype rateLimiter struct {\n\tmu        sync.Mutex\n\trps       float64\n\tburst     float64\n\ttokens    float64\n\tlast      time.Time\n\tqueue     *list.List\n\tqueueMax  int\n\ttimeout   time.Duration\n\trateLimited uint64\n\tqueued     uint64\n\ttimeouts   uint64\n}\n\nfunc newRateLimiter(rps, burst int, queueDepth int, timeoutMs int) *rateLimiter {\n\treturn &rateLimiter{\n\t\trps:      float64(rps),\n\t\tburst:    float64(burst),\n\t\ttokens:   float64(burst),\n\t\tlast:     time.Now(),\n\t\tqueue:    list.New(),\n\t\tqueueMax: queueDepth,\n\t\ttimeout:  time.Duration(timeoutMs) * time.Millisecond,\n\t}\n}\n\nfunc (rl *rateLimiter) update(rps, burst int, queueDepth int, timeoutMs int) {\n\trl.mu.Lock()\n\tdefer rl.mu.Unlock()\n\trl.rps = float64(rps)\n\trl.burst = float64(burst)\n\tif rl.tokens > rl.burst {\n\t\trl.tokens = rl.burst\n\t}\n\trl.queueMax = queueDepth\n\trl.timeout = time.Duration(timeoutMs) * time.Millisecond\n}\n\nfunc (rl *rateLimiter) refillLocked(now time.T"]
[2198.843936, "i", "ime) {\n\telapsed := now.Sub(rl.last).Seconds()\n\tif elapsed > 0 {\n\t\trl.tokens += rl.rps * elapsed\n\t\tif rl.burst > 0 && rl.tokens > rl.burst {\n\t\t\trl.tokens = rl.burst\n\t\t}\n\t\trl.last = now\n\t}\n}\n\nfunc (rl *rateLimiter) tryAcquire(now time.Time) bool {\n\trl.mu.Lock()\n\tdefer rl.mu.Unlock()\n\trl.refillLocked(now)\n\tif rl.rps <= 0 || rl.tokens >= 1 {\n\t\tif rl.rps > 0 {\n\t\t\trl.tokens -= 1\n\t\t}\n\t\treturn true\n\t}\n\treturn false\n}\n\ntype queuedWaiter struct {\n\tdeadline time.Time\n\tch       chan struct{}\n}\n\nfunc (rl *rateLimiter) acquire(now time.Time) (bool, bool) {\n\trl.mu.Lock()\n\tif rl.rps <= 0 {\n\t\trl.mu.Unlock()\n\t\treturn true, false\n\t}\n\trl.refillLocked(now)\n\tif rl.tokens >= 1 {\n\t\trl.tokens -= 1\n\t\trl.mu.Unlock()\n\t\treturn true, false\n\t}\n\tif rl.queueMax <= 0 {\n\t\trl.rateLimited++\n\t\trl.mu.Unlock()\n\t\treturn false, false\n\t}\n\tif rl.queue.Len() >= rl.queueMax {\n\t\trl.rateLimited++\n\t\trl.mu.Unlock()\n\t\treturn false, false\n\t}\n\tdeadline := now.Add(rl.timeout)\n\twaiter := &queuedWaiter{deadline: deadline, ch: make(chan struct{})}\n\telem := rl.queue"]
[2198.844038, "i", ".PushBack(waiter)\n\trl.queued++\n\trl.mu.Unlock()\n\n\ttimer := time.NewTimer(rl.timeout)\n\tdefer timer.Stop()\n\tselect {\n\tcase <-waiter.ch:\n\t\treturn true, true\n\tcase <-timer.C:\n\t\trl.mu.Lock()\n\t\tselect {\n\t\tcase <-waiter.ch:\n\t\t\trl.mu.Unlock()\n\t\t\treturn true, true\n\t\tdefault:\n\t\t}\n\t\tif elem.Value != nil {\n\t\t\trl.queue.Remove(elem)\n\t\t}\n\t\trl.timeouts++\n\t\trl.mu.Unlock()\n\t\treturn false, true\n\t}\n}\n\nfunc (rl *rateLimiter) releaseToken() {\n\trl.mu.Lock()\n\tif rl.queue.Len() > 0 {\n\t\telem := rl.queue.Front()\n\t\twaiter := elem.Value.(*queuedWaiter)\n\t\trl.queue.Remove(elem)\n\t\trl.mu.Unlock()\n\t\tclose(waiter.ch)\n\t\treturn\n\t}\n\trl.mu.Unlock()\n}\n\nfunc (rl *rateLimiter) status() (tokens float64, queueDepth int, rateLimited uint64, queued uint64, timeouts uint64, rps float64, burst float64) {\n\trl.mu.Lock()\n\tdefer rl.mu.Unlock()\n\trl.refillLocked(time.Now())\n\treturn rl.tokens, rl.queue.Len(), rl.rateLimited, rl.queued, rl.timeouts, rl.rps, rl.burst\n}\nEOF\ngofmt -w internal/state/ratelimit.go\n"]
