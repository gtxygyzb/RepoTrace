[11424.934936, "o", "\tName        string `json:\"name\"`\r\n\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tListenPort  int    `json:\"listen_port\"`\r\n\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tRoutingMode string `json:\"routing_mode\"`\r\n\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tEndpoints   []struct {\r\n\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tAddress           string `json:\"address\"`\r\n\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tState             string `json:\"state\"`\r\n\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tWeight            int    `json:\"weight\"`\r\n\u001b[35m\u001b[Kcmd/meshctl/main.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tActiveConnections int    `json:\"active_connections\"`\r\n"]
