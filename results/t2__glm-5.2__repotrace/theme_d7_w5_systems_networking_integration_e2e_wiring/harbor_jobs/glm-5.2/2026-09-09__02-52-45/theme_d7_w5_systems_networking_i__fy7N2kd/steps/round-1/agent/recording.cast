[3205.978435, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('internal/state/routing.go')\ns = p.read_text()\nold = '''// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\nfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\n\\tres, err := s.SelectEndpoint(service)\n\\tif err != nil {\n\\t\\treturn res, err\n\\t}\n\\tif exclude == nil || res.Endpoint != exclude {\n\\t\\treturn res, nil\n\\t}\n\\tfor i := 0; i < len(res.Endpoint.Address)+1; i++ {\n\\t\\talt, aerr := s.SelectEndpoint(service)\n\\t\\tif aerr != nil {\n\\t\\t\\treturn res, nil\n\\t\\t}\n\\t\\tif alt.Endpoint != exclude {\n\\t\\t\\treturn alt, nil\n\\t\\t}\n\\t}\n\\treturn res, nil\n}'''\nnew = '''// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\nfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\n\\tss := s.GetService(service)\n\\tif ss == nil {\n\\t\\treturn SelectResult{}, errNotFound(\"service not found\")\n\\t}\n\\tss.mu.Lock()\n\\tmaxC"]
[3205.978628, "i", "onns := ss.MaxConnectionsPerEndpoint\n\\tmode := ss.RoutingMode\n\\tendpoints := make([]*EndpointState, len(ss.Endpoints))\n\\tcopy(endpoints, ss.Endpoints)\n\\tss.mu.Unlock()\n\n\\tvar regular []*EndpointState\n\\tfor _, ep := range endpoints {\n\\t\\tif exclude != nil && ep == exclude {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tep.mu.Lock()\n\\t\\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n\\t\\tep.mu.Unlock()\n\\t\\tif eligible {\n\\t\\t\\tregular = append(regular, ep)\n\\t\\t}\n\\t}\n\n\\tif len(regular) > 0 {\n\\t\\tif mode == \"least-connections\" {\n\\t\\t\\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\n\\t\\t}\n\\t\\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\n\\t}\n\n\\tfor _, ep := range endpoints {\n\\t\\tif exclude != nil && ep == exclude {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tep.mu.Lock()\n\\t\\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State"]
[3205.978694, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[3205.978757, "i", " != Draining && ep.ActiveConnections < maxConns\n\\t\\tep.mu.Unlock()\n\\t\\tif halfOpen && ep.Circuit.AcquireProbe() {\n\\t\\t\\treturn SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil\n\\t\\t}\n\\t}\n\\treturn SelectResult{}, errNotFound(\"no eligible endpoints\")\n}'''\nif old not in s:\n    raise SystemExit('SelectEndpointExcluding pattern not found')\np.write_text(s.replace(old, new, 1))\nPY\ngofmt -w internal/state/routing.go\ngo build ./...\ngo test ./...\n"]
