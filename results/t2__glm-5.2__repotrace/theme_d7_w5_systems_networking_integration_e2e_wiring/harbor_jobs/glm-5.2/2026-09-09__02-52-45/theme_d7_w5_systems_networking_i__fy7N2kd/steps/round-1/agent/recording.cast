[14584.91085, "o", "   182\t\t}\r\n   183\t\r\n   184\t\tvar endpoint string\r\n   185\t\tvar bytesIn, bytesOut int64\r\n   186\t\tvar result string\r\n   187\t\tvar retryCount int\r\n   188\t\tvar queueWaitMs *int64\r\n   189\t\tvar failedDependency string\r\n   190\t\tvar mirrored bool\r\n   191\t\tdefer func() {\r\n   192\t\t\tif result == \"\" {\r\n   193\t\t\t\tresult = \"success\"\r\n   194\t\t\t}\r\n   195\t\t\tif r.accessLog != nil {\r\n   196\t\t"]
[14584.910922, "o", "\t\tr.accessLog.Log(accesslog.Entry{\r\n   197\t\t\t\t\tService:          service,\r\n   198\t\t\t\t\tClient:           clientAddr,\r\n   199\t\t\t\t\tEndpoint:         endpoint,\r\n   200\t\t\t\t\tBytesIn:          bytesIn,\r\n   201\t\t\t\t\tBytesOut:         bytesOut,\r\n   202\t\t\t\t\tDurationMs:       time.Since(start).Milliseconds(),\r\n   203\t\t\t\t\tResult:           result,\r\n   204\t\t\t\t\tRetried:          retryCount > 0,\r\n   205\t\t\t\t\tRetryCount:       retryCount,\r\n"]
[14584.910985, "o", "   206\t\t\t\t\tQueueWaitMs:      queueWaitMs,\r\n   207\t\t\t\t\tFailedDependency: failedDependency,\r\n   208\t\t\t\t\tMirrored:         mirrored,\r\n   209\t\t\t\t})\r\n   210\t\t\t}\r\n   211\t\t}()\r\n   212\t\r\n   213\t\tss := r.state.GetService(service)\r\n   214\t\tif ss == nil {\r\n   215"]
[14584.911051, "o", "\t\t\tresult = \"rejected_no_endpoint\"\r\n   216\t\t\tclient.Close()\r\n   217\t\t\treturn\r\n   218\t\t}\r\n   219\t\r\n   220\t\tif failedDep, _ := r.state.CheckDependencies(service); failedDep != \"\" {\r\n   221\t\t\tresult = \"rejected_dependency\"\r\n   222\t\t\tfailedDependency = failedDep\r\n   223\t\t\tss.Stats.RecordDependencyRejection()\r\n   224\t\t\tclient.Close()\r\n"]
[14584.911115, "o", "   225\t\t\treturn\r\n   226\t\t}\r\n   227\t\r\n   228\t\tallowed, queued, waitMs, _ := ss.AcquireRateLimitToken()\r\n   229\t\tif !allowed {\r\n   230\t\t\tresult = \"rejected_rate_limit\"\r\n"]
