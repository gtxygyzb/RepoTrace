[9542.255505, "o", "\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tr.\u001b[01;31m\u001b[KaccessLog.Log(accesslog.Entry\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tService:    service,\r\n\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tClient:     clientAddr,\r\n"]
[9542.255596, "o", "\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tEndpoint:   endpoint,\r\n\u001b[32m\u001b[K196\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tBytesIn:    bytesIn,\r\n\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tBytesOut:   bytesOut,\r\n\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tDurationMs: time.Since(start).Milliseconds(),\r\n\u001b[32m\u001b[K199\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tResult:     result,\r\n\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t})\r\n\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K202\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}()\r\n\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tss := r.state.GetService(service)\r\n\u001b[32m\u001b[K205\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif ss == nil {\r\n\u001b[32m\u001b[K206\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tresult = \"rejected_no_endpoint\"\r\n\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tclient.Close()\r\n"]
