f rl.queueDepth >= rl.queueMax {\n\\t\\trl.rateLimited++\n\\t\\trl.mu.Unlock()\n\\t\\treturn false, false\n\\t}\n\\trl.queueDepth++\n\\trl.queued++\n\\trl.mu.Unlock()\n\n\\tdeadline := now.Add(rl.timeout)\n\\tfor {\n\\t\\trl.mu.Lock()\n\\t\\tvar wait time.Duration\n\\t\\tif rl.rps > 0 {\n\\t\\t\\tneeded := 1.0 - rl.tokens\n\\t\\t\\tif needed > 0 {\n\\t\\t\\t\\twait = time.Duration(needed / rl.rps * float64(time.Second))\n\\t\\t\\t}\n\\t\\t}\n\\t\\trl.mu.Unlock()\n\n\\t\\tif wait <= 0 {\n\\t\\t\\trl.mu.Lock()\n\\t\\t\\tif rl.tryAcquireLocked(time.Now()) {\n\\t\\t\\t\\trl.queueDepth--\n\\t\\t\\t\\trl.mu.Unlock()\n\\t\\t\\t\\treturn true, true\n\\t\\t\\t}\n\\t\\t\\trl.mu.Unlock()\n\\t\\t\\tcontinue\n\\t\\t}\n\n\\t\\tremaining := time.Until(deadline)\n\\t\\tif remaining <= 0 {\n\\t\\t\\trl.mu.Lock()\n\\t\\t\\trl.queueDepth--\n\\t\\t\\trl.timeouts++\n\\t\\t\\trl.mu.Unlock()\n\\t\\t\\treturn false, true\n\\t\\t}\n\\t\\tif wait > remaining {\n\\t\\t\\twait = remaining\n\\t\\t}\n\\t\\ttimer := time.NewTimer(wait)\n\\t\\tselect {\n\\t\\tcase <-timer.C:\n\\t\\t}\n\\t\\ttimer.Stop()\n\\t}\n}\n\nfunc (rl *rateLimiter) status() (tokens float64, queueDepth int, rateLimited uint64, queued uint64, timeouts uint64, rps float64, burst float64) {\n\\trl.mu.Lock()\n\\tdefer rl.mu.Unlock()\n\\trl.refillLocked(time.Now())\n\\treturn rl.tokens, rl.queueDepth, rl.rateLimited, rl.queued, rl.timeouts, rl.rps, rl.burst\n}\n\'\'\')\nPY\ngofmt -w internal/state/ratelimit.go\npython3 - <<\'PY\'\nfrom pathlib import Path\np = Path(\'internal/state/state.go\')\ns = p.read_text()\nold = \'\'\'func (ss *ServiceState) ReleaseRateLimitToken() {\n\\tss.mu.Lock()\n\\trl := ss.rateLimiter\n\\tss.mu.Unlock()\n\\tif rl != nil {\n\\t\\trl.releaseToken()\n\\t}\n}\n\n\'\'\'\nif old in s:\n    s = s.replace(old, \'\', 1)\n    p.write_text(s)\nelse:\n    print(\'ReleaseRateLimitToken not found or already removed\')\nPY\ngofmt -w internal/state/state.go\npython3 - <<\'PY\'\nfrom pathlib import Path\np = Path(\'internal/router/router.go\')\ns = p.read_text()\ns = s.replace(\'\\tdefer ss.ReleaseRateLimitToken()\\n\', \'\', 1)\np.write_text(s)\nPY\ngofmt -w internal/router/router.go\ngo build ./...\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
