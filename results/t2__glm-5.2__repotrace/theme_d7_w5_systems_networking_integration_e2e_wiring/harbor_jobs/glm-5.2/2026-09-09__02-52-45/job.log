tatsView struct {\n    Service   string              `json:"service"`\n    WindowSec int                 `json:"window_sec"`\n    Endpoints []StatsEndpointView `json:"endpoints"`\n}\n\nfunc (s *State) StatsView(name string, windowSec int) (StatsView, bool) {\n    ss := s.GetService(name)\n    if ss == nil {\n        return StatsView{}, false\n    }\n    sv := StatsView{\n        Service:   name,\n        WindowSec: windowSec,\n        Endpoints: make([]StatsEndpointView, 0),\n    }\n    ss.mu.Lock()\n    for _, ep := range ss.Endpoints {\n        ep.mu.Lock()\n        sv.Endpoints = append(sv.Endpoints, StatsEndpointView{\n            Address:  ep.Address,\n            Snapshot: ep.Stats.Snapshot(ep.ActiveConnections),\n        })\n        ep.mu.Unlock()\n    }\n    ss.mu.Unlock()\n    return sv, true\n}\n\ntype HealthEventView struct {\n    Timestamp   time.Time `json:"timestamp"`\n    Endpoint    string    `json:"endpoint"`\n    OldState    string    `json:"old_state"`\n    NewState    string    `json:"new_state"`\n    CheckResult string    `json:"check_result"`\n}\n\nfunc (s *State) HealthLogView(name string, lastN int) []HealthEventView {\n    events := s.HealthLog(name, lastN)\n    out := make([]HealthEventView, 0, len(events))\n    for _, e := range events {\n        out = append(out, HealthEventView{\n            Timestamp:   e.Timestamp,\n            Endpoint:    e.Endpoint,\n            OldState:    string(e.OldState),\n            NewState:    string(e.NewState),\n            CheckResult: e.CheckResult,\n        })\n    }\n    return out\n}\n\ntype CircuitView struct {\n    Address             string `json:"address"`\n    CircuitState        string `json:"circuit_state"`\n    ConsecutiveFailures int    `json:"consecutive_failures"`\n    TimeInStateMs      int64  `json:"time_in_state_ms"`\n    ProbeActive        bool   `json:"probe_active"`\n}\n\nfunc (s *State) CircuitsView(name string) ([]CircuitView, bool) {\n    ss := s.GetService(name)\n    if ss == nil {\n        return nil, false\n    }\n    ss.mu.Lock()\n    out := make([]CircuitView, 0, len(ss.Endpoints))\n    for _, ep := range ss.Endpoints {\n        ep.mu.Lock()\n        out = append(out, CircuitView{\n            Address:             ep.Address,\n            CircuitState:        string(ep.Circuit.State()),\n            ConsecutiveFailures: ep.Circuit.ConsecutiveFailures(),\n            TimeInStateMs:      ep.Circuit.TimeInStateMs(),\n            ProbeActive:        ep.Circuit.ProbeActive(),\n        })\n        ep.mu.Unlock()\n    }\n    ss.mu.Unlock()\n    return out, true\n}\n\nfunc (s *State) ResolveEndpoint(service string) (string, error) {\n    ss := s.GetService(service)\n    if ss == nil {\n        return "", errNotFound("service not found")\n    }\n    ss.mu.Lock()\n    maxConns := ss.MaxConnectionsPerEndpoint\n    mode := ss.RoutingMode\n    endpoints := make([]*EndpointState, len(ss.Endpoints))\n    copy(endpoints, ss.Endpoints)\n    ss.mu.Unlock()\n\n    var regular []*EndpointState\n    for _, ep := range endpoints {\n        if ep.IsEligible(maxConns) {\n            regular = append(regular, ep)\n        }\n    }\n\n    if len(regular) > 0 {\n        if mode == "least-connections" {\n            ep := selectLeastConnections(regular, maxConns)\n            return ep.Address, nil\n        }\n        var best *EndpointState\n        var bestWeight int\n        for _, ep := range regular {\n            ep.mu.Lock()\n            cw := ep.currentWeight + ep.Weight\n            ep.mu.Unlock()\n            if best == nil || cw > bestWeight {\n                best = ep\n                bestWeight = cw\n            }\n        }\n        if best != nil {\n            return best.Address, nil\n        }\n    }\n\n    for _, ep := range endpoints {\n        ep.mu.Lock()\n        halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns && !ep.Circuit.ProbeActive()\n        ep.mu.Unlock()\n        if halfOpen {\n            return ep.Address, nil\n        }\n    }\n    return "", errNotFound("no eligible endpoints")\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
