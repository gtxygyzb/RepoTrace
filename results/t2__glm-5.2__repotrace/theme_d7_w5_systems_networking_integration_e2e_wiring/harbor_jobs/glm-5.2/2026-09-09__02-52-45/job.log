t\t\tep.Stats.RecordRejection()\n\t\t\t\tif attempt >= maxRetries {\n\t\t\t\t\tclient.Close()\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tr.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\n\t\tbackend, derr := net.Dial("tcp", ep.Address)\n\t\tif derr != nil {\n\t\t\tif id != 0 {\n\t\t\t\tep.RemoveConnection(id)\n\t\t\t}\n\t\t\tep.Stats.RecordConnection(0, 0, time.Since(start), true)\n\t\t\tif res.Probe {\n\t\t\t\tep.Circuit.ProbeFailure()\n\t\t\t}\n\t\t\tif attempt >= maxRetries {\n\t\t\t\tclient.Close()\n\t\t\t\treturn\n\t\t\t}\n\t\t\tep.Stats.RecordRetry()\n\t\t\tr.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\n\t\t\tcontinue\n\t\t}\n\n\t\tif res.Probe {\n\t\t\tep.Circuit.ProbeSuccess()\n\t\t\tvar ok bool\n\t\t\tid, ok = ep.TryAddConnection(client, res.MaxConns)\n\t\t\tif !ok {\n\t\t\t\tep.Stats.RecordRejection()\n\t\t\t\tbackend.Close()\n\t\t\t\tclient.Close()\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\n\t\tif attempt > 0 {\n\t\t\tep.Stats.RecordRetrySuccess()\n\t\t}\n\t\tbytesIn, bytesOut := forward(client, backend)\n\t\tbackend.Close()\n\t\tclient.Close()\n\t\tep.RemoveConnection(id)\n\t\tep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)\n\t\treturn\n\t}\n}\n\nfunc (r *Router) sleepRetry(attempt, delayMs int, multiplier float64, maxDelayMs int) {\n\tif attempt < 0 {\n\t\tattempt = 0\n\t}\n\tdelay := float64(delayMs) * pow(multiplier, float64(attempt))\n\tif maxDelayMs > 0 && delay > float64(maxDelayMs) {\n\t\tdelay = float64(maxDelayMs)\n\t}\n\tif delay > 0 {\n\t\ttime.Sleep(time.Duration(delay) * time.Millisecond)\n\t}\n}\n\nfunc pow(base, exp float64) float64 {\n\tresult := 1.0\n\tfor i := 0; i < int(exp); i++ {\n\t\tresult *= base\n\t}\n\treturn result\n}\n\n\'\'\'\ns = s[:start] + new + s[end:]\np.write_text(s)\nPY\ngofmt -w internal/router/router.go\ngo build ./...\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
