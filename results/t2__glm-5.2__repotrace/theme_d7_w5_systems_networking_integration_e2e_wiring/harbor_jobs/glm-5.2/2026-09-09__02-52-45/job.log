Sending keys: ['cat > internal/stats/stats.go <<\'EOF\'\npackage stats\n\nimport (\n\t"sync"\n\t"time"\n)\n\ntype entry struct {\n\ttimestamp time.Time\n\tbytesIn   int64\n\tbytesOut  int64\n\tlatency   time.Duration\n\terr       bool\n}\n\n// Collector keeps rolling connection statistics for one endpoint.\ntype Collector struct {\n\tmu         sync.Mutex\n\twindow     time.Duration\n\tentries    []entry\n\trejections []time.Time\n}\n\n// New creates a collector with the given window length.\nfunc New(window time.Duration) *Collector {\n\tif window <= 0 {\n\t\twindow = time.Minute\n\t}\n\treturn &Collector{window: window}\n}\n\n// RecordConnection records a finished connection attempt.\nfunc (c *Collector) RecordConnection(bytesIn, bytesOut int64, latency time.Duration, err bool) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tnow := time.Now()\n\tc.entries = append(c.entries, entry{timestamp: now, bytesIn: bytesIn, bytesOut: bytesOut, latency: latency, err: err})\n\tc.trim(now)\n}\n\n// RecordRejection records a rejected connection because the endpoint was at capacity.\nfunc (c *Collector) RecordRejection() {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tnow := time.Now()\n\tc.rejections = append(c.rejections, now)\n\tc.trim(now)\n}\n\nfunc (c *Collector) trim(now time.Time) {\n\tcutoff := now.Add(-c.window)\n\ti := 0\n\tfor i < len(c.entries) && c.entries[i].timestamp.Before(cutoff) {\n\t\ti++\n\t}\n\tif i > 0 {\n\t\tc.entries = c.entries[i:]\n\t}\n\tj := 0\n\tfor j < len(c.rejections) && c.rejections[j].Before(cutoff) {\n\t\tj++\n\t}\n\tif j > 0 {\n\t\tc.rejections = c.rejections[j:]\n\t}\n}\n\n// Snapshot returns current windowed stats. active is supplied by the state manager.\nfunc (c *Collector) Snapshot(active int) Snapshot {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tnow := time.Now()\n\tcutoff := now.Add(-c.window)\n\tvar total int\n\tvar bytesIn, bytesOut int64\n\tvar latencySum time.Duration\n\tvar errors int\n\tfor _, e := range c.entries {\n\t\tif e.timestamp.After(cutoff) || e.timestamp.Equal(cutoff) {\n\t\t\ttotal++\n\t\t\tbytesIn += e.bytesIn\n\t\t\tbytesOut += e.bytesOut\n\t\t\tlatencySum += e.latency\n\t\t\tif e.err {\n\t\t\t\terrors++\n\t\t\t}\n\t\t}\n\t}\n\trejected := 0\n\tfor _, t := range c.rejections {\n\t\tif t.After(cutoff) || t.Equal(cutoff) {\n\t\t\trejected++\n\t\t}\n\t}\n\tvar avg float64\n\tif total > 0 {\n\t\tavg = float64(latencySum.Milliseconds()) / float64(total)\n\t}\n\treturn Snapshot{\n\t\tTotalConnections:    total,\n\t\tActiveConnections:   active,\n\t\tBytesIn:             bytesIn,\n\t\tBytesOut:            bytesOut,\n\t\tAvgLatencyMs:        avg,\n\t\tErrors:              errors,\n\t\tRejectedConnections: rejected,\n\t}\n}\n\n// Snapshot is a JSON-friendly stats view.\ntype Snapshot struct {\n\tTotalConnections    int     `json:"total_connections"`\n\tActiveConnections   int     `json:"active_connections"`\n\tBytesIn             int64   `json:"bytes_in"`\n\tBytesOut            int64   `json:"bytes_out"`\n\tAvgLatencyMs        float64 `json:"avg_latency_ms"`\n\tErrors              int     `json:"errors"`\n\tRejectedConnections int     `json:"rejected_connections"`\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > internal/circuit/breaker.go <<\'EOF\'\npackage circuit\n\nimport (\n\t"sync"\n\t"time"\n)\n\ntype State string\n\nconst (\n\tClosed   State = "closed"\n\tOpen     State = "open"\n\tHalfOpen State = "half_open"\n)\n\n// Breaker implements an endpoint circuit breaker.\ntype Breaker struct {\n\tmu                 sync.Mutex\n\tstate              State\n\tconsecutiveFailures int\n\tstateChangedAt     time.Time\n\topenedAt           time.Time\n\ttimeout            time.Duration\n\tprobeActive        bool\n}\n\n// New creates a closed breaker with the given open timeout.\nfunc New(timeout time.Duration) *Breaker {\n\tnow := time.Now()\n\treturn &Breaker{\n\t\tstate:          Closed,\n\t\tstateChangedAt: now,\n\t\topenedAt:       now,\n\t\ttimeout:        timeout,\n\t}\n}\n\n// State returns the current state.\nfunc (b *Breaker) State() State {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\treturn b.state\n}\n\n// IsClosed returns true if the breaker is closed.\nfunc (b *Breaker) IsClosed() bool {\n\treturn b.State() == Closed\n}\n\n// IsOpen returns true if the breaker is open.\nfunc (b *Breaker) IsOpen() bool {\n\treturn b.State() == Open\n}\n\n// IsHalfOpen returns true if the breaker is half-open.\nfunc (b *Breaker) IsHalfOpen() bool {\n\treturn b.State() == HalfOpen\n}\n\n// Open forces the breaker open and restarts the timeout clock.\nfunc (b *Breaker) Open() {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := time.Now()\n\tb.state = Open\n\tb.stateChangedAt = now\n\tb.openedAt = now\n\tb.consecutiveFailures++\n\tb.probeActive = false\n}\n\n// MaybeHalfOpen transitions from open to half_open if the timeout has elapsed.\nfunc (b *Breaker) MaybeHalfOpen() bool {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tif b.state == Open && time.Since(b.openedAt) >= b.timeout {\n\t\tb.state = HalfOpen\n\t\tb.stateChangedAt = time.Now()\n\t\tb.probeActive = false\n\t\treturn true\n\t}\n\treturn false\n}\n\n// AcquireProbe attempts to take the single allowed half-open probe connection.\nfunc (b *Breaker) AcquireProbe() bool {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tif b.state == HalfOpen && !b.probeActive {\n\t\tb.probeActive = true\n\t\treturn true\n\t}\n\treturn false\n}\n\n// ProbeSuccess closes the circuit and clears failure counts.\nfunc (b *Breaker) ProbeSuccess() {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := time.Now()\n\tb.state = Closed\n\tb.stateChangedAt = now\n\tb.consecutiveFailures = 0\n\tb.probeActive = false\n}\n\n// ProbeFailure reopens the circuit and restarts the timeout.\nfunc (b *Breaker) ProbeFailure() {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := time.Now()\n\tb.state = Open\n\tb.stateChangedAt = now\n\tb.openedAt = now\n\tb.consecutiveFailures++\n\tb.probeActive = false\n}\n\n// Reset forces the breaker closed and clears failure counts.\nfunc (b *Breaker) Reset() {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := time.Now()\n\tb.state = Closed\n\tb.stateChangedAt = now\n\tb.openedAt = now\n\tb.consecutiveFailures = 0\n\tb.probeActive = false\n}\n\n// ConsecutiveFailures returns the current failure count.\nfunc (b *Breaker) ConsecutiveFailures() int {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\treturn b.consecutiveFailures\n}\n\n// TimeInStateMs returns milliseconds since the last state transition.\nfunc (b *Breaker) TimeInStateMs() int64 {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\treturn time.Since(b.stateChangedAt).Milliseconds()\n}\n\n// ProbeActive returns whether a probe connection is currently active.\nfunc (b *Breaker) ProbeActive() bool {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\treturn b.probeActive\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
