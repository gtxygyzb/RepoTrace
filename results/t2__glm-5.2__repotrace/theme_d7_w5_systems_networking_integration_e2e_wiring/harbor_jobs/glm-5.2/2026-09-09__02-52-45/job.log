imeout())\\n\\t\\tbackend.Close()\\n\\t\\tclient.Close()\',\n    \'\\t\\tif attempt > 0 {\\n\\t\\t\\tep.Stats.RecordRetrySuccess()\\n\\t\\t}\\n\\t\\tvar mirrorConn net.Conn\\n\\t\\tif doMirror {\\n\\t\\t\\tif mc, merr := net.Dial("tcp", mirrorEndpoint); merr == nil {\\n\\t\\t\\t\\tmirrorConn = mc\\n\\t\\t\\t\\tss.IncrementMirroredConnections()\\n\\t\\t\\t\\tmirrored = true\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tbytesIn, bytesOut, idleClosed := forward(client, backend, ep, id, ss.IdleTimeout(), mirrorConn)\\n\\t\\tbackend.Close()\\n\\t\\tclient.Close()\\n\\t\\tif mirrorConn != nil {\\n\\t\\t\\tmirrorConn.Close()\\n\\t\\t}\'\n)\n\n# Update forward function signature and add mirror support\nold_forward = \'\'\'func forward(client, backend net.Conn, ep *state.EndpointState, id int64, idleTimeoutMs int) (int64, int64, bool) {\n\\tvar bytesIn, bytesOut int64\n\\tvar idleClosed int32\n\\tvar closeOnce sync.Once\n\\tvar wg sync.WaitGroup\n\\tdone := make(chan struct{})\n\\tcloseConns := func() {\n\\t\\tclient.Close()\\n\\t\\tbackend.Close()\\n\\t}\'\'\'\n\nnew_forward = \'\'\'func forward(client, backend net.Conn, ep *state.EndpointState, id int64, idleTimeoutMs int, mirror net.Conn) (int64, int64, bool) {\n\\tvar bytesIn, bytesOut int64\n\\tvar idleClosed int32\n\\tvar closeOnce sync.Once\n\\tvar wg sync.WaitGroup\n\\tdone := make(chan struct{})\n\\tcloseConns := func() {\n\\t\\tclient.Close()\\n\\t\\tbackend.Close()\\n\\t\\tif mirror != nil {\n\\t\\t\\tmirror.Close()\n\\t\\t}\n\\t}\'\'\'\n\nif old_forward in s:\n    s = s.replace(old_forward, new_forward)\nelse:\n    print(\'WARNING: forward signature replacement not found\')\n\n# Add mirror drain goroutine and update copy goroutines\n# Replace the wg.Add(2) block\nold_copy = \'\'\'\\twg.Add(2)\n\\tgo func() {\n\\t\\tdefer wg.Done()\n\\t\\tn, _ := copyConn(backend, client, ep, id, "out")\n\\t\\tbytesOut = n\'\'\'\n\nnew_copy = \'\'\'\\tif mirror != nil {\n\\t\\twg.Add(1)\n\\t\\tgo func() {\n\\t\\t\\tdefer wg.Done()\n\\t\\t\\tio.Copy(io.Discard, mirror)\n\\t\\t}()\n\\t}\n\\twg.Add(2)\n\\tgo func() {\n\\t\\tdefer wg.Done()\n\\t\\tvar n int64\n\\t\\tvar err error\n\\t\\tif mirror != nil {\n\\t\\t\\tn, err = copyTee(backend, mirror, client, ep, id, "out")\n\\t\\t} else {\n\\t\\t\\tn, err = copyConn(backend, client, ep, id, "out")\n\\t\\t}\n\\t\\tbytesOut = n\n\\t\\t_ = err\'\'\'\n\nif old_copy in s:\n    s = s.replace(old_copy, new_copy)\nelse:\n    print(\'WARNING: copy goroutine replacement not found\')\n\n# Add copyTee function before copyConn\ncopytee_func = \'\'\'\nfunc copyTee(primary, mirror io.Writer, src io.Reader, ep *state.EndpointState, id int64, direction string) (int64, error) {\n\\tbuf := make([]byte, 32*1024)\n\\tvar total int64\n\\tmirrorOK := true\n\\tfor {\n\\t\\tn, err := src.Read(buf)\n\\t\\tif n > 0 {\n\\t\\t\\tif _, werr := primary.Write(buf[:n]); werr != nil {\n\\t\\t\\t\\treturn total, werr\n\\t\\t\\t}\n\\t\\t\\tif mirrorOK {\n\\t\\t\\t\\tif _, merr := mirror.Write(buf[:n]); merr != nil {\n\\t\\t\\t\\t\\tmirrorOK = false\n\\t\\t\\t\\t}\n\\t\\t\\t}\n\\t\\t\\ttotal += int64(n)\n\\t\\t\\tif direction == "out" {\n\\t\\t\\t\\tep.UpdateConnectionActivity(id, int64(n), 0)\n\\t\\t\\t} else {\n\\t\\t\\t\\tep.UpdateConnectionActivity(id, 0, int64(n))\n\\t\\t\\t}\n\\t\\t}\n\\t\\tif err != nil {\n\\t\\t\\treturn total, err\n\\t\\t}\n\\t}\n}\n\nfunc copyConn(dst io.Writer, src io.Reader, ep *state.EndpointState, id int64, direction string) (int64, error) {\'\'\'\n\ns = s.replace(\'\\nfunc copyConn(dst io.Writer, src io.Reader, ep *state.EndpointState, id int64, direction string) (int64, error) {\', copytee_func)\n\n# Add shouldMirror function and counter at end of file\nshould_mirror = \'\'\'\nvar mirrorSampleCounter uint64\n\nfunc shouldMirror(pct int) bool {\n\tif pct <= 0 {\n\t\treturn false\n\t}\n\tif pct >= 100 {\n\t\treturn true\n\t}\n\tc := atomic.AddUint64(&mirrorSampleCounter, 1)\n\treturn int(c%100) < pct\n}\n\'\'\'\n\n# Add before intToStr function\ns = s.replace(\'\\nfun