(endpoints, ss.Endpoints)\n\\tss.mu.Unlock()\n\n\\ttotalActive := 0\n\\tif perService {\n\\t\\tfor _, ep := range endpoints {\n\\t\\t\\tep.mu.Lock()\n\\t\\t\\ttotalActive += ep.ActiveConnections\n\\t\\t\\tep.mu.Unlock()\n\\t\\t}\n\\t}\n\n\\tvar regular []*EndpointState\n\\tfor _, ep := range endpoints {\n\\t\\tep.mu.Lock()\n\\t\\tvar eligible bool\n\\t\\tif perService {\n\\t\\t\\teligible = ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && totalActive < maxConns\n\\t\\t} else {\n\\t\\t\\teligible = ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n\\t\\t}\n\\t\\tep.mu.Unlock()\n\\t\\tif eligible {\n\\t\\t\\tregular = append(regular, ep)\n\\t\\t}\n\\t}\n\n\\tif len(regular) > 0 {\n\\t\\tif mode == "least-connections" {\n\\t\\t\\tep := selectLeastConnections(regular, maxConns)\n\\t\\t\\treturn ep.Address, nil\n\\t\\t}\n\\t\\tif best := selectWeightedCandidate(regular); best != nil {\n\\t\\t\\treturn best.Address, nil\n\\t\\t}\n\\t}\n\n\\tfor _, ep := range endpoints {\n\\t\\tep.mu.Lock()\n\\t\\tvar halfOpen bool\n\\t\\tif perService {\n\\t\\t\\thalfOpen = ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && totalActive < maxConns && !ep.Circuit.ProbeActive()\n\\t\\t} else {\n\\t\\t\\thalfOpen = ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns && !ep.Circuit.ProbeActive()\n\\t\\t}\n\\t\\tep.mu.Unlock()\n\\t\\tif halfOpen {\n\\t\\t\\treturn ep.Address, nil\n\\t\\t}\n\\t}\n\\treturn "", errNotFound("no eligible endpoints")\n}\'\'\')\np.write_text(s)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
