Sending keys: ['cat > internal/state/state.go <<\'EOF\'\npackage state\n\nimport (\n    "net"\n    "sync"\n    "sync/atomic"\n    "time"\n\n    "meshrouter/internal/circuit"\n    "meshrouter/internal/config"\n    "meshrouter/internal/stats"\n)\n\ntype HealthState string\n\nconst (\n    Unknown   HealthState = "unknown"\n    Healthy   HealthState = "healthy"\n    Unhealthy HealthState = "unhealthy"\n    Draining  HealthState = "draining"\n)\n\ntype HealthEvent struct {\n    Timestamp   time.Time\n    Endpoint    string\n    OldState    HealthState\n    NewState    HealthState\n    CheckResult string\n}\n\ntype EndpointState struct {\n    mu                  sync.Mutex\n    Address             string\n    Weight              int\n    Config              config.Endpoint\n    State               HealthState\n    ActiveConnections  int\n    Circuit            *circuit.Breaker\n    Stats              *stats.Collector\n    consecSuccess      int\n    consecFailures     int\n    drainDeadline      time.Time\n    removed            bool\n    connIDCounter      int64\n    connections        map[int64]net.Conn\n}\n\ntype ServiceState struct {\n    mu                        sync.Mutex\n    Name                      string\n    ListenPort                int\n    RoutingMode               string\n    DrainTimeoutMs            int\n    MaxConnectionsPerEndpoint int\n    Endpoints                 []*EndpointState\n    rrIndex                    int\n    Listener                  net.Listener\n    listenerStop              chan struct{}\n    stopping                  bool\n}\n\ntype State struct {\n    mu         sync.RWMutex\n    configPath string\n    global     config.Global\n    services   map[string]*ServiceState\n    logMu      sync.Mutex\n    healthLog  map[string][]HealthEvent\n    reloadCh   chan struct{}\n}\n\nfunc NewState(cfg *config.Config, path string) *State {\n    s := &State{\n        configPath: path,\n        services:   make(map[string]*ServiceState),\n        healthLog:  make(map[string][]HealthEvent),\n        reloadCh:   make(chan struct{}, 1),\n    }\n    s.applyConfigLocked(cfg)\n    return s\n}\n\nfunc (s *State) ReloadChan() <-chan struct{} {\n    return s.reloadCh\n}\n\nfunc (s *State) ConfigPath() string {\n    s.mu.RLock()\n    defer s.mu.RUnlock()\n    return s.configPath\n}\n\nfunc (s *State) Global() config.Global {\n    s.mu.RLock()\n    defer s.mu.RUnlock()\n    return s.global\n}\n\nfunc (s *State) ApplyConfig(cfg *config.Config) {\n    s.mu.Lock()\n    defer s.mu.Unlock()\n    s.applyConfigLocked(cfg)\n    select {\n    case s.reloadCh <- struct{}{}:\n    default:\n    }\n}\n\nfunc (s *State) applyConfigLocked(cfg *config.Config) {\n    s.global = cfg.Global\n    seen := make(map[string]bool)\n    for _, svc := range cfg.Services {\n        seen[svc.Name] = true\n        ss := s.services[svc.Name]\n        if ss == nil {\n            ss = newServiceState(svc)\n            s.services[svc.Name] = ss\n        } else {\n            ss.mu.Lock()\n            ss.Name = svc.Name\n            ss.ListenPort = svc.ListenPort\n            ss.RoutingMode = svc.RoutingMode\n            ss.DrainTimeoutMs = svc.DrainTimeoutMs\n            ss.MaxConnectionsPerEndpoint = svc.MaxConnectionsPerEndpoint\n            ss.mu.Unlock()\n            ss.applyEndpoints(svc.Endpoints, cfg.Global)\n        }\n    }\n    for name, ss := range s.services {\n        if !seen[name] {\n            ss.mu.Lock()\n            ss.stopping = true\n            if ss.listenerStop != nil {\n                close(ss.listenerStop)\n                ss.listenerStop = nil\n            }\n            if ss.Listener != nil {\n                ss.Listener.Close()\n                ss.Listener = nil\n            }\n            ss.mu.Unlock()\n            for _, ep := range ss.Endpoints {\n                ep.StartDraining(ss.DrainTimeoutMs, true)\n            }\n        }\n    }\n}\n\nfunc newServiceState(svc config.Service) *ServiceState {\n    ss := &ServiceState{\n        Name:                      svc.Name,\n        ListenPort:                svc.ListenPort,\n        RoutingMode:               svc.RoutingMode,\n        DrainTimeoutMs:            svc.DrainTimeoutMs,\n        MaxConnectionsPerEndpoint: svc.MaxConnectionsPerEndpoint,\n        listenerStop:              nil,\n    }\n    for _, ep := range svc.Endpoints {\n        ss.Endpoints = append(ss.Endpoints, newEndpointState(ep, stats.New(time.Duration(svc.DrainTimeoutMs)*time.Millisecond)))\n    }\n    return ss\n}\n\nfunc (ss *ServiceState) applyEndpoints(eps []config.Endpoint, global config.Global) {\n    ss.mu.Lock()\n    defer ss.mu.Unlock()\n    seen := make(map[string]bool)\n    for _, cep := range eps {\n        seen[cep.Address] = true\n        var ep *EndpointState\n        for _, existing := range ss.Endpoints {\n            if existing.Address == cep.Address {\n                ep = existing\n                break\n            }\n        }\n        if ep == nil {\n            ep = newEndpointState(cep, stats.New(time.Duration(global.StatsWindowSec)*time.Second))\n            ss.Endpoints = append(ss.Endpoints, ep)\n        } else {\n            ep.mu.Lock()\n            ep.Config = cep\n            ep.Weight = cep.Weight\n            ep.mu.Unlock()\n        }\n    }\n    for _, ep := range ss.Endpoints {\n        if !seen[ep.Address] {\n            ep.StartDraining(ss.DrainTimeoutMs, true)\n        }\n    }\n}\n\nfunc newEndpointState(cep config.Endpoint, st *stats.Collector) *EndpointState {\n    return &EndpointState{\n        Address:      cep.Address,\n        Weight:       cep.Weight,\n        Config:       cep,\n        State:        Unknown,\n        Circuit:      circuit.New(time.Duration(5000) * time.Millisecond),\n        Stats:        st,\n        connections:  make(map[int64]net.Conn),\n    }\n}\n\nfunc (s *State) GetService(name string) *ServiceState {\n    s.mu.RLock()\n    defer s.mu.RUnlock()\n    return s.services[name]\n}\n\nfunc (s *State) Services() []*ServiceState {\n    s.mu.RLock()\n    defer s.mu.RUnlock()\n    out := make([]*ServiceState, 0, len(s.services))\n    for _, ss := range s.services {\n        out = append(out, ss)\n    }\n    return out\n}\n\nfunc (s *State) GetEndpoint(service, address string) *EndpointState {\n    ss := s.GetService(service)\n    if ss == nil {\n        return nil\n    }\n    ss.mu.Lock()\n    defer ss.mu.Unlock()\n    for _, ep := range ss.Endpoints {\n        if ep.Address == address {\n            return ep\n        }\n    }\n    return nil\n}\n\nfunc (s *State) SetWeight(service, address string, weight int) error {\n    ep := s.GetEndpoint(service, address)\n    if ep == nil {\n        return errNotFound("endpoint not found")\n    }\n    ep.mu.Lock()\n    defer ep.mu.Unlock()\n    if weight < 0 {\n        weight = 0\n    }\n    ep.Weight = weight\n    return nil\n}\n\nfunc (s *State) DrainEndpoint(service, address string) error {\n    ss := s.GetService(service)\n    if ss == nil {\n        return errNotFound("service not found")\n    }\n    ep := s.GetEndpoint(service, address)\n    if ep == nil {\n        return errNotFound("endpoint not found")\n    }\n    ep.StartDraining(ss.DrainTimeoutMs, false)\n    return nil\n}\n\nfunc (s *State) ResetCircuitBreaker(service, address string) error {\n    ep := s.GetEndpoint(service, address)\n    if ep == nil {\n        return errNotFound("endpoint not found")\n    }\n    ep.Circuit.Reset()\n    return nil\n}\n\nfunc (ep *EndpointState) StartDraining(timeoutMs int, markRemoved bool) {\n    ep.mu.Lock()\n    defer ep.mu.Unlock()\n    ep.State = Draining\n    ep.consecSuccess = 0\n    ep.consecFailures = 0\n    ep.drainDeadline = time.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n    if markRemoved {\n        ep.removed = true\n    }\n    if len(ep.connections) > 0 {\n        go func(deadline time.Time, conns map[int64]net.Conn) {\n            time.Sleep(time.Until(deadline))\n            ep.closeConnectionsLocked()\n        }(ep.drainDeadline, ep.connections)\n    }\n}\n\nfunc (ep *EndpointState) AddConnection(conn net.Conn) int64 {\n    ep.mu.Lock()\n    defer ep.mu.Unlock()\n    id := atomic.AddInt64(&ep.connIDCounter, 1)\n    ep.connections[id] = conn\n    ep.ActiveConnections++\n    return id\n}\n\nfunc (ep *EndpointState) RemoveConnection(id int64) {\n    ep.mu.Lock()\n    defer ep.mu.Unlock()\n    if _, ok := ep.connections[id]; ok {\n        delete(ep.connections, id)\n        if ep.ActiveConnections > 0 {\n            ep.ActiveConnections--\n        }\n    }\n}\n\nfunc (ep *EndpointState) closeConnectionsLocked() {\n    for id, c := range ep.connections {\n        c.Close()\n        delete(ep.connections, id)\n    }\n}\n\nfunc (ep *EndpointState) Active() int {\n    ep.mu.Lock()\n    defer ep.mu.Unlock()\n    return ep.ActiveConnections\n}\n\nfunc (ep *EndpointState) IsEligible(maxConns int) bool {\n    ep.mu.Lock()\n    defer ep.mu.Unlock()\n    return ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n}\n\nfunc (s *State) RecordHealthCheck(service, address string, success bool) HealthEvent {\n    ss := s.GetService(service)\n    if ss == nil {\n        return HealthEvent{}\n    }\n    ep := s.GetEndpoint(service, address)\n    if ep == nil {\n        return HealthEvent{}\n    }\n    global := s.Global()\n    ep.mu.Lock()\n    oldState := ep.State\n    result := "success"\n    if !success {\n        result = "failure"\n    }\n    if success {\n        ep.consecSuccess++\n        ep.consecFailures = 0\n        if oldState == Unknown && ep.consecSuccess >= global.HealthyThreshold {\n            ep.State = Healthy\n        } else if oldState == Unhealthy && ep.consecSuccess >= global.HealthyThreshold {\n            ep.State = Healthy\n        }\n    } else {\n        ep.consecFailures++\n        ep.consecSuccess = 0\n        if (oldState == Healthy || oldState == Unknown) && ep.consecFailures >= global.UnhealthyThreshold {\n            ep.State = Unhealthy\n            ep.Circuit.Open()\n            ep.consecFailures = 0\n            timeout := time.Duration(ss.DrainTimeoutMs) * time.Millisecond\n            go func(deadline time.Time) {\n                time.Sleep(time.Until(deadline))\n                ep.mu.Lock()\n                ep.closeConnectionsLocked()\n                ep.mu.Unlock()\n            }(time.Now().Add(timeout))\n        }\n    }\n    newState := ep.State\n    ep.mu.Unlock()\n    evt := HealthEvent{\n        Timestamp:   time.Now(),\n        Endpoint:    address,\n        OldState:    oldState,\n        NewState:    newState,\n        CheckResult: result,\n    }\n    s.logMu.Lock()\n    s.healthLog[service] = append(s.healthLog[service], evt)\n    if len(s.healthLog[service]) > 1000 {\n        s.healthLog[service] = s.healthLog[service][len(s.healthLog[service])-1000:]\n    }\n    s.logMu.Unlock()\n    return evt\n}\n\nfunc (s *State) HealthLog(service string, lastN int) []HealthEvent {\n    s.logMu.Lock()\n    defer s.logMu.Unlock()\n    events := s.healthLog[service]\n    if lastN <= 0 || lastN > len(events) {\n        lastN = len(events)\n    }\n    out := make([]HealthEvent, lastN)\n    copy(out, events[len(events)-lastN:])\n    return out\n}\n\ntype notFoundError struct {\n    msg string\n}\n\nfunc (e *notFoundError) Error() string {\n    return e.msg\n}\n\nfunc errNotFound(msg string) error {\n    return &notFoundError{msg: msg}\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
