Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\n\n# internal/config/config.go: add DependsOn field and cycle-safe normalization\np = Path(\'internal/config/config.go\')\ns = p.read_text()\ns = s.replace(\n\'\'\'        IdleTimeoutMs             int        `toml:"idle_timeout_ms"`\n        Endpoints                 []Endpoint `toml:"endpoint"`\n}\'\'\',\n\'\'\'        IdleTimeoutMs             int        `toml:"idle_timeout_ms"`\n        DependsOn                 []string  `toml:"depends_on"`\n        Endpoints                 []Endpoint `toml:"endpoint"`\n}\'\'\'\n)\ns = s.replace(\n\'\'\'                for j := range s.Endpoints {\n                        ep := &s.Endpoints[j]\n                        if ep.HealthCheck == "" {\n                                ep.HealthCheck = "tcp"\n                        }\n                        if ep.Weight < 0 {\n                                ep.Weight = 0\n                        }\n                        if ep.WarmupDurationMs < 0 {\n                                ep.WarmupDurationMs = 0\n                        }\n                }\n        }\n        return &cfg, nil\n}\'\'\',\n\'\'\'                for j := range s.Endpoints {\n                        ep := &s.Endpoints[j]\n                        if ep.HealthCheck == "" {\n                                ep.HealthCheck = "tcp"\n                        }\n                        if ep.Weight < 0 {\n                                ep.Weight = 0\n                        }\n                        if ep.WarmupDurationMs < 0 {\n                                ep.WarmupDurationMs = 0\n                        }\n                }\n                if s.DependsOn == nil {\n                        s.DependsOn = []string{}\n                }\n        }\n        cfg.Services = removeDependencyCycles(cfg.Services)\n        return &cfg, nil\n}\n\n// removeDependencyCycles drops dependency edges that would create cycles.\nfunc removeDependencyCycles(services []Service) []Service {\n        byName := make(map[string]int, len(services))\n        for i, svc := range services {\n                byName[svc.Name] = i\n        }\n        for i := range services {\n                seen := map[string]bool{services[i].Name: true}\n                kept := make([]string, 0, len(services[i].DependsOn))\n                for _, dep := range services[i].DependsOn {\n                        if dep == services[i].Name {\n                                continue\n                        }\n                        if _, ok := byName[dep]; !ok {\n                                kept = append(kept, dep)\n                                continue\n                        }\n                        if createsCycle(services, byName, seen, services[i].Name, dep) {\n                                continue\n                        }\n                        kept = append(kept, dep)\n                }\n                services[i].DependsOn = kept\n        }\n        return services\n}\n\nfunc createsCycle(services []Service, byName map[string]int, seen map[string]bool, start, dep string) bool {\n        if seen[dep] {\n                return true\n        }\n        seen[dep] = true\n        defer delete(seen, dep)\n        next := services[byName[dep]].DependsOn\n        for _, d := range next {\n                if d == start || d == dep {\n                        return true\n                }\n                if _, ok := byName[d]; !ok {\n                        continue\n                }\n                if createsCycle(services, byName, seen, start, d) {\n                        return true\n                }\n        }\n        return false\n}\n\'\'\'\n)\np.write_text(s)\n\n# internal/state/state.go: add DependsOn to ServiceState, set in applyConfigLocked, add helpers\np = Path(\'internal/state/state.go\')\ns = p.read_text()\ns = s.replace(\n\'\'\'        RetryMaxDelayMs           int\n        rateLimiter               *rateLimiter\n        Endpoints                 []*EndpointState\'\'\',\n\'\'\'        RetryMaxDelayMs           int\n        DependsOn                []string\n        rateLimiter               *rateLimiter\n        Endpoints                 []*EndpointState\'\'\'\n)\ns = s.replace(\n\'\'\'                        ss.RetryMaxDelayMs = svc.RetryMaxDelayMs\n                        if ss.rateLimiter == nil {\'\'\',\n\'\'\'                        ss.RetryMaxDelayMs = svc.RetryMaxDelayMs\n                        ss.DependsOn = svc.DependsOn\n                        if ss.rateLimiter == nil {\'\'\'\n)\ns = s.replace(\n\'\'\'        for _, ep := range ss.Endpoints {\n                if ep.Address == address {\n                        return ep\n                }\n        }\n        return nil\n}\'\'\',\n\'\'\'        for _, ep := range ss.Endpoints {\n                if ep.Address == address {\n                        return ep\n                }\n        }\n        return nil\n}\n\n// DependencyStatus describes a configured dependency.\ntype DependencyStatus struct {\n        Name            string `json:"name"`\n        Available       bool   `json:"available"`\n        HealthyEndpoints int   `json:"healthy_endpoints"`\n}\n\n// CheckDependency returns whether a dependency service is available and how\n// many of its endpoints are healthy with closed circuit breakers.\nfunc (s *State) CheckDependency(name string) (bool, int) {\n        dep := s.GetService(name)\n        if dep == nil {\n                return false, 0\n        }\n        dep.mu.Lock()\n        defer dep.mu.Unlock()\n        healthy := 0\n        for _, ep := range dep.Endpoints {\n                if ep.State == Healthy && ep.Circuit.IsClosed() {\n                        healthy++\n                }\n        }\n        return healthy > 0, healthy\n}\n\n// CheckDependencies returns the first unavailable dependency and the full\n// dependency status list for a service.\nfunc (s *State) CheckDependencies(service string) (string, []DependencyStatus) {\n        ss := s.GetService(service)\n        if ss == nil {\n                return "", nil\n        }\n        ss.mu.Lock()\n        deps := ss.DependsOn\n        ss.mu.Unlock()\n        if len(deps) == 0 {\n                return "", nil\n        }\n        var statuses []DependencyStatus\n        var failed string\n        for _, dep := range deps {\n                available, healthy := s.CheckDependency(dep)\n                statuses = append(statuses, DependencyStatus{Name: dep, Available: available, HealthyEndpoints: healthy})\n                if failed == "" && !available {\n                        failed = dep\n                }\n        }\n        return failed, statuses\n}\n\n// DependencyStatuses returns dependency status rows for a service.\nfunc (s *State) DependencyStatuses(service string) []DependencyStatus {\n        _, statuses := s.CheckDependencies(service)\n        return statuses\n}\n\'\'\'\n)\np.write_text(s)\n\n# internal/accesslog/logger.go: add FailedDependency field\np = Path(\'internal/accesslog/logger.go\')\ns = p.read_text()\ns = s.replace(\n\'\'\'        QueueWaitMs *int64 `json:"queue_wait_ms,omitempty"`\n}\'\'\',\n\'\'\'        QueueWaitMs       *int64 `json:"queue_wait_ms,omitempty"`\n        FailedDependency string `json:"failed_dependency,omitempty"`\n}\'\'\'\n)\np.write_text(s)\n\n# internal/stats/stats.go: add dependencyRejections, RecordDependencyRejection, Snapshot field\np = Path(\'internal/stats/stats.go\')\ns = p.read_text()\ns = s.replace(\n\'\'\'        queueTimeouts   int\n        retries         int\n        retrySuccesses int\n        idleTimeouts    int\n}\'\'\',\n\'\'\'        queueTimeouts   int\n        retries         int\n        retrySuccesses int\n        idleTimeouts    int\n        dependencyRejections int\n}\'\'\'\n)\ns = s.replace(\n\'\'\'// RecordRetry records a retry attempt.\'\'\',\n\'\'\'// RecordDependencyRejection records a connection rejected due to dependency unavailability.\nfunc (c 