Sending keys: ['cat > internal/health/monitor.go <<\'EOF\'\npackage health\n\nimport (\n    "context"\n    "fmt"\n    "io"\n    "net"\n    "net/http"\n    "os/exec"\n    "strings"\n    "sync"\n    "time"\n\n    "meshrouter/internal/config"\n    "meshrouter/internal/state"\n)\n\ntype worker struct {\n    cancel context.CancelFunc\n    done   chan struct{}\n}\n\ntype Monitor struct {\n    state *state.State\n    mu    sync.Mutex\n    cur   *config.Config\n    stop  chan struct{}\n    workers map[string]*worker\n}\n\nfunc NewMonitor(s *state.State, cfg *config.Config) *Monitor {\n    return &Monitor{\n        state:   s,\n        cur:     cfg,\n        stop:    make(chan struct{}),\n        workers: make(map[string]*worker),\n    }\n}\n\nfunc (m *Monitor) Start() {\n    m.mu.Lock()\n    cfg := m.cur\n    m.mu.Unlock()\n    m.startWorkers(cfg)\n}\n\nfunc (m *Monitor) ApplyConfig(cfg *config.Config) {\n    m.mu.Lock()\n    m.cur = cfg\n    m.mu.Unlock()\n    m.stopWorkers()\n    m.startWorkers(cfg)\n}\n\nfunc (m *Monitor) Stop() {\n    close(m.stop)\n    m.stopWorkers()\n}\n\nfunc (m *Monitor) startWorkers(cfg *config.Config) {\n    for _, svc := range cfg.Services {\n        for _, ep := range svc.Endpoints {\n            key := svc.Name + "|" + ep.Address\n            ctx, cancel := context.WithCancel(context.Background())\n            w := &worker{cancel: cancel, done: make(chan struct{})}\n            m.mu.Lock()\n            m.workers[key] = w\n            m.mu.Unlock()\n            go m.run(ctx, cfg, svc.Name, ep, w.done)\n        }\n    }\n}\n\nfunc (m *Monitor) stopWorkers() {\n    m.mu.Lock()\n    workers := m.workers\n    m.workers = make(map[string]*worker)\n    m.mu.Unlock()\n    for _, w := range workers {\n        w.cancel()\n        <-w.done\n    }\n}\n\nfunc (m *Monitor) run(ctx context.Context, cfg *config.Config, service string, ep config.Endpoint, done chan struct{}) {\n    defer close(done)\n    interval := time.Duration(cfg.Global.HealthIntervalMs) * time.Millisecond\n    if interval <= 0 {\n        interval = 2 * time.Second\n    }\n    ticker := time.NewTicker(interval)\n    defer ticker.Stop()\n    for {\n        select {\n        case <-ctx.Done():\n            return\n        case <-m.stop:\n            return\n        case <-ticker.C:\n        }\n        success := checkEndpoint(ctx, ep)\n        m.state.RecordHealthCheck(service, ep.Address, success)\n        if ss := m.state.GetService(service); ss != nil {\n            if eps := m.state.GetEndpoint(service, ep.Address); eps != nil {\n                eps.Circuit.MaybeHalfOpen()\n            }\n            _ = ss\n        }\n    }\n}\n\nfunc checkEndpoint(ctx context.Context, ep config.Endpoint) bool {\n    switch ep.HealthCheck {\n    case "http":\n        return checkHTTP(ctx, ep)\n    case "exec":\n        return checkExec(ctx, ep)\n    default:\n        return checkTCP(ep.Address)\n    }\n}\n\nfunc checkTCP(address string) bool {\n    conn, err := net.DialTimeout("tcp", address, time.Second)\n    if err != nil {\n        return false\n    }\n    conn.Close()\n    return true\n}\n\nfunc checkHTTP(ctx context.Context, ep config.Endpoint) bool {\n    path := ep.HealthPath\n    if path == "" {\n        path = "/"\n    }\n    url := fmt.Sprintf("http://%s%s", ep.Address, path)\n    client := &http.Client{Timeout: 2 * time.Second}\n    req, err := http.NewRequestWithContext(ctx, "GET", url, nil)\n    if err != nil {\n        return false\n    }\n    resp, err := client.Do(req)\n    if err != nil {\n        return false\n    }\n    defer resp.Body.Close()\n    if resp.StatusCode != 200 {\n        return false\n    }\n    body, err := io.ReadAll(resp.Body)\n    if err != nil {\n        return false\n    }\n    return strings.Contains(strings.ToLower(string(body)), "ok")\n}\n\nfunc checkExec(ctx context.Context, ep config.Endpoint) bool {\n    if ep.HealthCmd == "" {\n        return false\n    }\n    c := exec.CommandContext(ctx, "sh", "-c", ep.HealthCmd)\n    c.Stdout = io.Discard\n    c.Stderr = io.Discard\n    if err := c.Start(); err != nil {\n        return false\n    }\n    done := make(chan error, 1)\n    go func() {\n        done <- c.Wait()\n    }()\n    select {\n    case <-time.After(3 * time.Second):\n        c.Process.Kill()\n        <-done\n        return false\n    case err := <-done:\n        return err == nil\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > internal/state/routing.go <<\'EOF\'\npackage state\n\nimport (\n    "sort"\n    "time"\n)\n\n// SelectResult contains selected endpoint and whether it is a half-open probe.\ntype SelectResult struct {\n    Endpoint *EndpointState\n    Probe    bool\n}\n\n// SelectEndpoint chooses an endpoint for the next connection.\nfunc (s *State) SelectEndpoint(service string) (SelectResult, error) {\n    ss := s.GetService(service)\n    if ss == nil {\n        return SelectResult{}, errNotFound("service not found")\n    }\n    ss.mu.Lock()\n    maxConns := ss.MaxConnectionsPerEndpoint\n    mode := ss.RoutingMode\n    endpoints := make([]*EndpointState, len(ss.Endpoints))\n    copy(endpoints, ss.Endpoints)\n    ss.mu.Unlock()\n\n    now := time.Now()\n    _ = now\n\n    var regular []*EndpointState\n    for _, ep := range endpoints {\n        ep.mu.Lock()\n        eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n        if eligible {\n            regular = append(regular, ep)\n        }\n        ep.mu.Unlock()\n    }\n\n    if len(regular) > 0 {\n        if mode == "least-connections" {\n            return SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false}, nil\n        }\n        return SelectResult{Endpoint: selectWeighted(regular), Probe: false}, nil\n    }\n\n    for _, ep := range endpoints {\n        ep.mu.Lock()\n        halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n        ep.mu.Unlock()\n        if halfOpen && ep.Circuit.AcquireProbe() {\n            return SelectResult{Endpoint: ep, Probe: true}, nil\n        }\n    }\n    return SelectResult{}, errNotFound("no eligible endpoints")\n}\n\nfunc selectWeighted(eps []*EndpointState) *EndpointState {\n    var best *EndpointState\n    var bestWeight int\n    var totalWeight int\n    for _, ep := range eps {\n        ep.mu.Lock()\n        ep.currentWeight += ep.Weight\n        totalWeight += ep.Weight\n        cw := ep.currentWeight\n        w := ep.Weight\n        ep.mu.Unlock()\n        if best == nil || cw > bestWeight {\n            best = ep\n            bestWeight = cw\n        }\n        _ = w\n    }\n    if best != nil {\n        best.mu.Lock()\n        best.currentWeight -= totalWeight\n        best.mu.Unlock()\n    }\n    return best\n}\n\nfunc selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\n    sort.SliceStable(eps, func(i, j int) bool {\n        ai := eps[i].Active()\n        aj := eps[j].Active()\n        if ai != aj {\n            return ai < aj\n        }\n        return eps[i].Address < eps[j].Address\n    })\n    return eps[0]\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
