\n\n    allowed, queued := ss.AcquireRateLimitToken()\n    if !allowed {\n        result = "rejected_rate_limit"\n        client.Close()\n        return\n    }\n    if queued {\n        if cand, cerr := r.state.SelectCandidate(service); cerr == nil {\n            cand.Stats.RecordQueued()\n        }\n    }\n\n    maxRetries, retryDelayMs, multiplier, maxDelayMs := ss.RetryConfig()\n    var lastEndpoint *state.EndpointState\n    for attempt := 0; ; attempt++ {\n        res, err := r.state.SelectEndpointExcluding(service, lastEndpoint)\n        if err != nil {\n            result = "rejected_no_endpoint"\n            client.Close()\n            return\n        }\n        lastEndpoint = res.Endpoint\n        ep := res.Endpoint\n        endpoint = ep.Address\n\n        var id int64\n        if !res.Probe {\n            var ok bool\n            id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\n            if !ok {\n                result = "rejected_conn_limit"\n                ep.Stats.RecordRejection()\n                client.Close()\n                return\n            }\n        }\n\n        backend, derr := net.Dial("tcp", ep.Address)\n        if derr != nil {\n            if id != 0 {\n                ep.RemoveConnection(id)\n            }\n            ep.Stats.RecordConnection(0, 0, time.Since(start), true)\n            if res.Probe {\n                ep.Circuit.ProbeFailure()\n            } else {\n                ep.Circuit.Open()\n            }\n            if attempt >= maxRetries {\n                result = "retry_exhausted"\n                client.Close()\n                return\n            }\n            ep.Stats.RecordRetry()\n            r.sleepRetry(attempt, retryDelayMs, multiplier, maxDelayMs)\n            continue\n        }\n\n        if res.Probe {\n            ep.Circuit.ProbeSuccess()\n            var ok bool\n            id, ok = ss.TryAddConnection(ep, client, res.MaxConns, res.PerService)\n            if !ok {\n                result = "rejected_conn_limit"\n                ep.Stats.RecordRejection()\n                backend.Close()\n                client.Close()\n                return\n            }\n        }\n\n        if attempt > 0 {\n            ep.Stats.RecordRetrySuccess()\n        }\n        bytesIn, bytesOut, idleClosed := forward(client, backend, ep, id, ss.IdleTimeout())\n        backend.Close()\n        client.Close()\n        ep.RemoveConnection(id)\n        ep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)\n        if idleClosed {\n            result = "idle_timeout"\n            ep.Stats.RecordIdleTimeout()\n        } else {\n            result = "success"\n        }\n        return\n    }\n}\n"""\n\nlines = text.split("\\n")\nstart = end = None\nfor i, line in enumerate(lines):\n    if line.startswith("func (r *Router) handleConn(service string, client net.Conn) {"):\n        start = i\n    if start is not None and line.startswith("func (r *Router) sleepRetry("):\n        end = i\n        break\nif start is None or end is None:\n    raise SystemExit("could not locate handleConn")\nlines = lines[:start] + new_handle.split("\\n") + lines[end:]\npath.write_text("\\n".join(lines))\nPY\npython3 edit_router.py\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
