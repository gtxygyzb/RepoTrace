Sending keys: ['python3 - <<\'PY\'\ncontent = r\'\'\'package circuit\n\nimport (\n\t"sync"\n\t"time"\n)\n\ntype State string\n\nconst (\n\tClosed   State = "closed"\n\tOpen     State = "open"\n\tHalfOpen State = "half_open"\n)\n\n// Breaker implements an endpoint circuit breaker.\ntype Breaker struct {\n\tmu                  sync.Mutex\n\tstate               State\n\tconsecutiveFailures int\n\tstateChangedAt      time.Time\n\topenedAt            time.Time\n\ttimeout             time.Duration\n\thalfOpenMaxProbes   int\n\tprobeActive         int\n\tprobeSuccesses      int\n\tprobeFailures       int\n}\n\n// New creates a closed breaker with the given open timeout and half-open max probes.\nfunc New(timeout time.Duration, halfOpenMaxProbes int) *Breaker {\n\tnow := time.Now()\n\tif halfOpenMaxProbes < 1 {\n\t\thalfOpenMaxProbes = 1\n\t}\n\treturn &Breaker{\n\t\tstate:             Closed,\n\t\tstateChangedAt:    now,\n\t\topenedAt:          now,\n\t\ttimeout:           timeout,\n\t\thalfOpenMaxProbes: halfOpenMaxProbes,\n\t}\n}\n\n// State returns the current state.\nfunc (b *Breaker) State() State {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\treturn b.state\n}\n\n// IsClosed returns true if the breaker is closed.\nfunc (b *Breaker) IsClosed() bool {\n\treturn b.State() == Closed\n}\n\n// IsOpen returns true if the breaker is open.\nfunc (b *Breaker) IsOpen() bool {\n\treturn b.State() == Open\n}\n\n// IsHalfOpen returns true if the breaker is half-open.\nfunc (b *Breaker) IsHalfOpen() bool {\n\treturn b.State() == HalfOpen\n}\n\n// Open forces the breaker open and restarts the timeout clock.\nfunc (b *Breaker) Open() {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := time.Now()\n\tb.state = Open\n\tb.stateChangedAt = now\n\tb.openedAt = now\n\tb.consecutiveFailures++\n\tb.probeActive = 0\n\tb.probeSuccesses = 0\n\tb.probeFailures = 0\n}\n\n// MaybeHalfOpen transitions from open to half_open if the timeout has elapsed.\nfunc (b *Breaker) MaybeHalfOpen() bool {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tif b.state == Open && time.Since(b.openedAt) >= b.timeout {\n\t\tb.state = HalfOpen\n\t\tb.stateChangedAt = time.Now()\n\t\tb.probeActive = 0\n\t\tb.probeSuccesses = 0\n\t\tb.probeFailures = 0\n\t\treturn true\n\t}\n\treturn false\n}\n\n// AcquireProbe attempts to take one of the allowed half-open probe connections.\nfunc (b *Breaker) AcquireProbe() bool {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tif b.state == HalfOpen && b.probeActive < b.halfOpenMaxProbes {\n\t\tb.probeActive++\n\t\treturn true\n\t}\n\treturn false\n}\n\n// RecordProbeResult records the outcome of a half-open probe. When all probes\n// in the batch have completed, the circuit is closed if more than half\n// succeeded, otherwise it is reopened.\nfunc (b *Breaker) RecordProbeResult(success bool) {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tif b.state != HalfOpen {\n\t\treturn\n\t}\n\tif b.probeActive > 0 {\n\t\tb.probeActive--\n\t}\n\tif success {\n\t\tb.probeSuccesses++\n\t} else {\n\t\tb.probeFailures++\n\t}\n\tif b.probeActive == 0 {\n\t\ttotal := b.probeSuccesses + b.probeFailures\n\t\tif total > 0 && b.probeSuccesses*2 > total {\n\t\t\tnow := time.Now()\n\t\t\tb.state = Closed\n\t\t\tb.stateChangedAt = now\n\t\t\tb.openedAt = now\n\t\t\tb.consecutiveFailures = 0\n\t\t} else {\n\t\t\tnow := time.Now()\n\t\t\tb.state = Open\n\t\t\tb.stateChangedAt = now\n\t\t\tb.openedAt = now\n\t\t\tb.consecutiveFailures++\n\t\t}\n\t\tb.probeSuccesses = 0\n\t\tb.probeFailures = 0\n\t}\n}\n\n// SetHalfOpenMaxProbes updates the configured batch size for half-open probes.\nfunc (b *Breaker) SetHalfOpenMaxProbes(n int) {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tif n < 1 {\n\t\tn = 1\n\t}\n\tb.halfOpenMaxProbes = n\n}\n\n// Reset forces the breaker closed and clears failure counts.\nfunc (b *Breaker) Reset() {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := time.Now()\n\tb.state = Closed\n\tb.stateChangedAt = now\n\tb.openedAt = now\n\tb.consecutiveFailures = 0\n\tb.probeActive = 0\n\tb.probeSuccesses = 0\n\tb.probeFailures = 0\n}\n\n// ConsecutiveFailures returns the current failure count.\nfunc (b *Breaker) ConsecutiveFailures() int {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\treturn b.consecutiveFailures\n}\n\n// TimeInStateMs returns milliseconds since the last state transition.\nfunc (b *Breaker) TimeInStateMs() int64 {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\treturn time.Since(b.stateChangedAt).Milliseconds()\n}\n\n// ProbeActive returns whether any probe connections are currently active.\nfunc (b *Breaker) ProbeActive() bool {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\treturn b.probeActive > 0\n}\n\'\'\'\nwith open(\'internal/circuit/breaker.go\', \'w\') as f:\n    f.write(content)\nprint(\'breaker.go written\')\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
