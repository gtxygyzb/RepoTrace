Sending keys: ['cat > internal/state/routing.go <<\'EOF\'\npackage state\n\nimport (\n    "sort"\n    "time"\n)\n\n// SelectResult contains selected endpoint and whether it is a half-open probe.\ntype SelectResult struct {\n    Endpoint *EndpointState\n    Probe    bool\n    MaxConns int\n}\n\n// SelectEndpoint chooses an endpoint for the next connection.\nfunc (s *State) SelectEndpoint(service string) (SelectResult, error) {\n    ss := s.GetService(service)\n    if ss == nil {\n        return SelectResult{}, errNotFound("service not found")\n    }\n    ss.mu.Lock()\n    maxConns := ss.MaxConnectionsPerEndpoint\n    mode := ss.RoutingMode\n    endpoints := make([]*EndpointState, len(ss.Endpoints))\n    copy(endpoints, ss.Endpoints)\n    ss.mu.Unlock()\n\n    now := time.Now()\n    _ = now\n\n    var regular []*EndpointState\n    for _, ep := range endpoints {\n        ep.mu.Lock()\n        eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n        ep.mu.Unlock()\n        if eligible {\n            regular = append(regular, ep)\n        }\n    }\n\n    if len(regular) > 0 {\n        if mode == "least-connections" {\n            return SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\n        }\n        return SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\n    }\n\n    for _, ep := range endpoints {\n        ep.mu.Lock()\n        halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n        ep.mu.Unlock()\n        if halfOpen && ep.Circuit.AcquireProbe() {\n            return SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil\n        }\n    }\n    return SelectResult{}, errNotFound("no eligible endpoints")\n}\n\n// SelectCandidate returns the endpoint that would be selected ignoring connection limits.\n// Used to account rejected_connections when all eligible endpoints are at capacity.\nfunc (s *State) SelectCandidate(service string) (*EndpointState, error) {\n    ss := s.GetService(service)\n    if ss == nil {\n        return nil, errNotFound("service not found")\n    }\n    ss.mu.Lock()\n    mode := ss.RoutingMode\n    endpoints := make([]*EndpointState, len(ss.Endpoints))\n    copy(endpoints, ss.Endpoints)\n    ss.mu.Unlock()\n\n    var regular []*EndpointState\n    for _, ep := range endpoints {\n        ep.mu.Lock()\n        eligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining\n        ep.mu.Unlock()\n        if eligible {\n            regular = append(regular, ep)\n        }\n    }\n    if len(regular) == 0 {\n        for _, ep := range endpoints {\n            ep.mu.Lock()\n            halfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining\n            ep.mu.Unlock()\n            if halfOpen {\n                return ep, nil\n            }\n        }\n        return nil, errNotFound("no eligible endpoints")\n    }\n    if mode == "least-connections" {\n        return selectLeastConnections(regular, 1<<30), nil\n    }\n    return selectWeightedCandidate(regular), nil\n}\n\nfunc selectWeighted(eps []*EndpointState) *EndpointState {\n    var best *EndpointState\n    var bestWeight int\n    var totalWeight int\n    for _, ep := range eps {\n        ep.mu.Lock()\n        ep.currentWeight += ep.Weight\n        totalWeight += ep.Weight\n        cw := ep.currentWeight\n        ep.mu.Unlock()\n        if best == nil || cw > bestWeight {\n            best = ep\n            bestWeight = cw\n        }\n    }\n    if best != nil {\n        best.mu.Lock()\n        best.currentWeight -= totalWeight\n        best.mu.Unlock()\n    }\n    return best\n}\n\nfunc selectWeightedCandidate(eps []*EndpointState) *EndpointState {\n    var best *EndpointState\n    var bestWeight int\n    for _, ep := range eps {\n        ep.mu.Lock()\n        cw := ep.currentWeight + ep.Weight\n        ep.mu.Unlock()\n        if best == nil || cw > bestWeight {\n            best = ep\n            bestWeight = cw\n        }\n    }\n    return best\n}\n\nfunc selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\n    sort.SliceStable(eps, func(i, j int) bool {\n        ai := eps[i].Active()\n        aj := eps[j].Active()\n        if ai != aj {\n            return ai < aj\n        }\n        return eps[i].Address < eps[j].Address\n    })\n    return eps[0]\n}\nEOF\ngofmt -w internal/state/routing.go internal/state/json.go\ngo build ./...\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > internal/router/router.go <<\'EOF\'\npackage router\n\nimport (\n    "io"\n    "log"\n    "net"\n    "sync"\n    "time"\n\n    "meshrouter/internal/state"\n)\n\ntype serviceListener struct {\n    service  string\n    port     int\n    listener net.Listener\n    stop     chan struct{}\n    wg       sync.WaitGroup\n    done     chan struct{}\n}\n\ntype Router struct {\n    state     *state.State\n    mu        sync.Mutex\n    listeners map[string]*serviceListener\n}\n\nfunc NewRouter(s *state.State) *Router {\n    return &Router{\n        state:     s,\n        listeners: make(map[string]*serviceListener),\n    }\n}\n\nfunc (r *Router) Start() {\n    for _, ss := range r.state.Services() {\n        if !ss.IsStopping() {\n            r.startService(ss)\n        }\n    }\n}\n\nfunc (r *Router) Reload() {\n    services := r.state.Services()\n    seen := make(map[string]bool)\n    for _, ss := range services {\n        seen[ss.Name] = true\n        r.mu.Lock()\n        sl, ok := r.listeners[ss.Name]\n        r.mu.Unlock()\n        if !ok {\n            if !ss.IsStopping() {\n                r.startService(ss)\n            }\n            continue\n        }\n        if sl.port != ss.ListenPort {\n            r.stopService(ss.Name, true)\n            r.startService(ss)\n        }\n    }\n    r.mu.Lock()\n    for name := range r.listeners {\n        if !seen[name] {\n            r.mu.Unlock()\n            r.stopService(name, true)\n            r.mu.Lock()\n        }\n    }\n    r.mu.Unlock()\n}\n\nfunc (r *Router) startService(ss *state.ServiceState) {\n    addr := ":" + intToStr(ss.ListenPort)\n    ln, err := net.Listen("tcp", addr)\n    if err != nil {\n        log.Printf("router: listen %s on %s failed: %v", ss.Name, addr, err)\n        return\n    }\n    sl := &serviceListener{\n        service:  ss.Name,\n        port:     ss.ListenPort,\n        listener: ln,\n        stop:     make(chan struct{}),\n        done:     make(chan struct{}),\n    }\n    r.mu.Lock()\n    r.listeners[ss.Name] = sl\n    r.mu.Unlock()\n    go sl.acceptLoop(r)\n}\n\nfunc (r *Router) stopService(name string, drain bool) {\n    r.mu.Lock()\n    sl, ok := r.listeners[name]\n    if ok {\n        delete(r.listeners, name)\n    }\n    r.mu.Unlock()\n    if !ok {\n        return\n    }\n    sl.stopAccept(drain, r)\n}\n\nfunc (r *Router) Stop() {\n    r.mu.Lock()\n    listeners := r.listeners\n    r.listeners = make(map[string]*serviceListener)\n    r.mu.Unlock()\n    var wg sync.WaitGroup\n    for name, sl := range listeners {\n        wg.Add(1)\n        go func(name string, sl *serviceListener) {\n            defer wg.Done()\n            sl.stopAccept(true, r)\n        }(name, sl)\n    }\n    wg.Wait()\n}\n\nfunc (sl *serviceListener) acceptLoop(r *Router) {\n    defer close(sl.done)\n    for {\n        conn, err := sl.listener.Accept()\n        if err != nil {\n            return\n        }\n        sl.wg.Add(1)\n        go func(c net.Conn) {\n            defer sl.wg.Done()\n            r.handleConn(sl.service, c)\n        }(conn)\n    }\n}\n\nfunc (sl *serviceListener) stopAccept(drain bool, r *Router) {\n    select {\n    case <-sl.stop:\n    default:\n        close(sl.stop)\n    }\n    sl.listener.Close()\n    <-sl.done\n    if drain {\n        ss := r.state.GetService(sl.service)\n        timeout := 5 * time.Second\n        if ss != nil {\n            timeout = time.Duration(ss.DrainTimeoutMs) * time.Millisecond\n            if timeout <= 0 {\n                timeout = 5 * time.Second\n            }\n        }\n        done := make(chan struct{})\n        go func() {\n            sl.wg.Wait()\n            close(done)\n        }()\n        select {\n        case <-done:\n        case <-time.After(timeout):\n            r.state.CloseServiceConnections(sl.service)\n            <-done\n        }\n    } else {\n        sl.wg.Wait()\n    }\n}\n\nfunc (r *Router) handleConn(service string, client net.Conn) {\n    start := time.Now()\n    res, err := r.state.SelectEndpoint(service)\n    if err != nil {\n        if cand, cerr := r.state.SelectCandidate(service); cerr == nil {\n            ss := r.state.GetService(service)\n            if ss != nil && cand.Active() >= ss.MaxConnectionsPerEndpoint {\n                cand.Stats.RecordRejection()\n            }\n        }\n        client.Close()\n        return\n    }\n    ep := res.Endpoint\n\n    var id int64\n    if !res.Probe {\n        var ok bool\n        id, ok = ep.TryAddConnection(client, res.MaxConns)\n        if !ok {\n            ep.Stats.RecordRejection()\n            client.Close()\n            return\n        }\n    }\n\n    backend, err := net.Dial("tcp", ep.Address)\n    if err != nil {\n        if id != 0 {\n            ep.RemoveConnection(id)\n        }\n        ep.Stats.RecordConnection(0, 0, time.Since(start), true)\n        if res.Probe {\n            ep.Circuit.ProbeFailure()\n        }\n        client.Close()\n        return\n    }\n\n    if res.Probe {\n        ep.Circuit.ProbeSuccess()\n        var ok bool\n        id, ok = ep.TryAddConnection(client, res.MaxConns)\n        if !ok {\n            ep.Stats.RecordRejection()\n            backend.Close()\n            client.Close()\n            return\n        }\n    }\n\n    bytesIn, bytesOut := forward(client, backend)\n    backend.Close()\n    client.Close()\n    ep.RemoveConnection(id)\n    ep.Stats.RecordConnection(bytesIn, bytesOut, time.Since(start), false)\n}\n\nfunc forward(client, backend net.Conn) (int64, int64) {\n    var bytesIn, bytesOut int64\n    var wg sync.WaitGroup\n    wg.Add(2)\n    go func() {\n        defer wg.Done()\n        n, _ := io.Copy(backend, client)\n        bytesOut = n\n        backend.Close()\n        client.Close()\n    }()\n    go func() {\n        defer wg.Done()\n        n, _ := io.Copy(client, backend)\n        bytesIn = n\n        client.Close()\n        backend.Close()\n    }()\n    wg.Wait()\n    return bytesIn, bytesOut\n}\n\nfunc intToStr(i int) string {\n    if i == 0 {\n        return "0"\n    }\n    var buf [12]byte\n    pos := len(buf)\n    neg := false\n    if i < 0 {\n        neg = true\n        i = -i\n    }\n    for i > 0 {\n        pos--\n        buf[pos] = byte(\'0\' + i%10)\n        i /= 10\n    }\n    if neg {\n        pos--\n        buf[pos] = \'-\'\n    }\n    return string(buf[pos:])\n}\nEOF\ngofmt -w internal/router/router.go\ngo build ./...\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
