Sending keys: ['cat > internal/ipc/server.go <<\'EOF\'\npackage ipc\n\nimport (\n    "bufio"\n    "encoding/json"\n    "errors"\n    "fmt"\n    "net"\n    "os"\n    "strconv"\n    "strings"\n    "sync"\n\n    "meshrouter/internal/config"\n    "meshrouter/internal/state"\n)\n\ntype Request struct {\n    Cmd  string          `json:"cmd"`\n    Args json.RawMessage `json:"args"`\n}\n\ntype Response struct {\n    Status string      `json:"status"`\n    Data   interface{} `json:"data"`\n}\n\ntype Server struct {\n    state    *state.State\n    path     string\n    listener net.Listener\n    wg       sync.WaitGroup\n    stop     chan struct{}\n    done     chan struct{}\n}\n\nfunc NewServer(s *state.State, path string) *Server {\n    return &Server{\n        state: s,\n        path:  path,\n        stop:  make(chan struct{}),\n        done:  make(chan struct{}),\n    }\n}\n\nfunc (s *Server) Start() error {\n    os.Remove(s.path)\n    ln, err := net.Listen("unix", s.path)\n    if err != nil {\n        return err\n    }\n    s.listener = ln\n    go s.acceptLoop()\n    return nil\n}\n\nfunc (s *Server) Stop() {\n    select {\n    case <-s.stop:\n    default:\n        close(s.stop)\n    }\n    if s.listener != nil {\n        s.listener.Close()\n    }\n    <-s.done\n    os.Remove(s.path)\n}\n\nfunc (s *Server) acceptLoop() {\n    defer close(s.done)\n    for {\n        conn, err := s.listener.Accept()\n        if err != nil {\n            return\n        }\n        s.wg.Add(1)\n        go s.handleConn(conn)\n    }\n}\n\nfunc (s *Server) handleConn(conn net.Conn) {\n    defer s.wg.Done()\n    defer conn.Close()\n    reader := bufio.NewReader(conn)\n    for {\n        line, err := reader.ReadString(\'\\n\')\n        if err != nil {\n            return\n        }\n        line = strings.TrimRight(line, "\\r\\n")\n        if line == "" {\n            continue\n        }\n        resp := s.handleLine(line)\n        _, _ = conn.Write([]byte(resp + "\\n"))\n    }\n}\n\nfunc (s *Server) handleLine(line string) string {\n    var req Request\n    if err := json.Unmarshal([]byte(line), &req); err != nil {\n        return encodeResp(Response{Status: "error", Data: err.Error()})\n    }\n    data, err := s.dispatch(req)\n    if err != nil {\n        return encodeResp(Response{Status: "error", Data: err.Error()})\n    }\n    return encodeResp(Response{Status: "ok", Data: data})\n}\n\nfunc encodeResp(r Response) string {\n    b, _ := json.Marshal(r)\n    return string(b)\n}\n\nfunc (s *Server) dispatch(req Request) (interface{}, error) {\n    switch req.Cmd {\n    case "list_services":\n        return s.state.ServicesView(), nil\n    case "get_service":\n        var args struct {\n            Name string `json:"name"`\n        }\n        if err := json.Unmarshal(req.Args, &args); err != nil {\n            return nil, err\n        }\n        sv, ok := s.state.ServiceView(args.Name)\n        if !ok {\n            return nil, errors.New("service not found")\n        }\n        return sv, nil\n    case "get_stats":\n        var args struct {\n            Name string `json:"name"`\n        }\n        if err := json.Unmarshal(req.Args, &args); err != nil {\n            return nil, err\n        }\n        g := s.state.Global()\n        sv, ok := s.state.StatsView(args.Name, g.StatsWindowSec)\n        if !ok {\n            return nil, errors.New("service not found")\n        }\n        return sv, nil\n    case "set_weight":\n        var args struct {\n            Name    string `json:"name"`\n            Address string `json:"address"`\n            Weight  int    `json:"weight"`\n        }\n        if err := json.Unmarshal(req.Args, &args); err != nil {\n            return nil, err\n        }\n        if err := s.state.SetWeight(args.Name, args.Address, args.Weight); err != nil {\n            return nil, err\n        }\n        return "OK", nil\n    case "drain_endpoint":\n        var args struct {\n            Name    string `json:"name"`\n            Address string `json:"address"`\n        }\n        if err := json.Unmarshal(req.Args, &args); err != nil {\n            return nil, err\n        }\n        if err := s.state.DrainEndpoint(args.Name, args.Address); err != nil {\n            return nil, err\n        }\n        return "OK", nil\n    case "get_health_log":\n        var args struct {\n            Name   string `json:"name"`\n            LastN  int    `json:"last_n"`\n        }\n        if err := json.Unmarshal(req.Args, &args); err != nil {\n            return nil, err\n        }\n        return s.state.HealthLogView(args.Name, args.LastN), nil\n    case "get_circuit_breakers":\n        var args struct {\n            Name string `json:"name"`\n        }\n        if err := json.Unmarshal(req.Args, &args); err != nil {\n            return nil, err\n        }\n        cv, ok := s.state.CircuitsView(args.Name)\n        if !ok {\n            return nil, errors.New("service not found")\n        }\n        return cv, nil\n    case "reset_circuit_breaker":\n        var args struct {\n            Name    string `json:"name"`\n            Address string `json:"address"`\n        }\n        if err := json.Unmarshal(req.Args, &args); err != nil {\n            return nil, err\n        }\n        if err := s.state.ResetCircuitBreaker(args.Name, args.Address); err != nil {\n            return nil, err\n        }\n        return "OK", nil\n    case "reload_config":\n        path := s.state.ConfigPath()\n        cfg, err := config.Load(path)\n        if err != nil {\n            return nil, err\n        }\n        s.state.ApplyConfig(cfg)\n        return "OK", nil\n    default:\n        return nil, fmt.Errorf("unknown command: %s", req.Cmd)\n    }\n}\n\nfunc init() {\n    _ = strconv.Itoa(0)\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > cmd/meshd/main.go <<\'EOF\'\npackage main\n\nimport (\n    "flag"\n    "log"\n    "os"\n    "os/signal"\n    "sync"\n    "syscall"\n\n    "meshrouter/internal/config"\n    "meshrouter/internal/health"\n    "meshrouter/internal/ipc"\n    "meshrouter/internal/router"\n    "meshrouter/internal/state"\n)\n\nfunc main() {\n    cfgPath := flag.String("config", "/app/config/services.toml", "path to services config")\n    flag.Parse()\n\n    cfg, err := config.Load(*cfgPath)\n    if err != nil {\n        log.Fatalf("config load failed: %v", err)\n    }\n\n    st := state.NewState(cfg, *cfgPath)\n    monitor := health.NewMonitor(st, cfg)\n    router := router.NewRouter(st)\n    ipcServer := ipc.NewServer(st, "/tmp/meshd.sock")\n\n    if err := ipcServer.Start(); err != nil {\n        log.Fatalf("ipc server failed: %v", err)\n    }\n    monitor.Start()\n    router.Start()\n\n    sigCh := make(chan os.Signal, 1)\n    signal.Notify(sigCh, syscall.SIGHUP, syscall.SIGTERM, syscall.SIGINT)\n    var reloadMu sync.Mutex\n    for {\n        sig := <-sigCh\n        if sig == syscall.SIGHUP {\n            reloadMu.Lock()\n            path := st.ConfigPath()\n            newCfg, err := config.Load(path)\n            if err != nil {\n                log.Printf("reload failed: %v", err)\n                reloadMu.Unlock()\n                continue\n            }\n            st.ApplyConfig(newCfg)\n            monitor.ApplyConfig(newCfg)\n            router.Reload()\n            reloadMu.Unlock()\n            log.Printf("reloaded config")\n        } else {\n            break\n        }\n    }\n\n    monitor.Stop()\n    router.Stop()\n    ipcServer.Stop()\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > cmd/meshctl/main.go <<\'EOF\'\npackage main\n\nimport (\n    "bufio"\n    "encoding/json"\n    "fmt"\n    "net"\n    "os"\n    "strconv"\n    "strings"\n)\n\ntype request struct {\n    Cmd  string          `json:"cmd"`\n    Args json.RawMessage `json:"args"`\n}\n\ntype response struct {\n    Status string          `json:"status"`\n    Data   json.RawMessage `json:"data"`\n}\n\nfunc main() {\n    if len(os.Args) < 2 {\n        fmt.Fprintln(os.Stderr, "usage: meshctl <command> [args]")\n        os.Exit(1)\n    }\n    cmd := os.Args[1]\n    args := map[string]interface{}{}\n    switch cmd {\n    case "status":\n    case "stats":\n        if len(os.Args) < 3 {\n            fmt.Fprintln(os.Stderr, "usage: meshctl stats <service>")\n            os.Exit(1)\n        }\n        args["name"] = os.Args[2]\n    case "set-weight":\n        if len(os.Args) < 5 {\n            fmt.Fprintln(os.Stderr, "usage: meshctl set-weight <service> <endpoint> <weight>")\n            os.Exit(1)\n        }\n        w, err := strconv.Atoi(os.Args[4])\n        if err != nil {\n            fmt.Fprintf(os.Stderr, "invalid weight: %v\\n", err)\n            os.Exit(1)\n        }\n        args["name"] = os.Args[2]\n        args["address"] = os.Args[3]\n        args["weight"] = w\n    case "drain":\n        if len(os.Args) < 4 {\n            fmt.Fprintln(os.Stderr, "usage: meshctl drain <service> <endpoint>")\n            os.Exit(1)\n        }\n        args["name"] = os.Args[2]\n        args["address"] = os.Args[3]\n    case "health-log":\n        if len(os.Args) < 3 {\n            fmt.Fprintln(os.Stderr, "usage: meshctl health-log <service> [--last N]")\n            os.Exit(1)\n        }\n        args["name"] = os.Args[2]\n        n := 20\n        for _, a := range os.Args[3:] {\n            if strings.HasPrefix(a, "--last") && len(a) > 6 {\n                v, err := strconv.Atoi(a[6:])\n                if err == nil {\n                    n = v\n                }\n            }\n        }\n        args["last_n"] = n\n    case "resolve":\n        if len(os.Args) < 3 {\n            fmt.Fprintln(os.Stderr, "usage: meshctl resolve <service>")\n            os.Exit(1)\n        }\n        args["name"] = os.Args[2]\n    case "circuits":\n        if len(os.Args) < 3 {\n            fmt.Fprintln(os.Stderr, "usage: meshctl circuits <service>")\n            os.Exit(1)\n        }\n        args["name"] = os.Args[2]\n    case "reset-circuit":\n        if len(os.Args) < 4 {\n            fmt.Fprintln(os.Stderr, "usage: meshctl reset-circuit <service> <endpoint>")\n            os.Exit(1)\n        }\n        args["name"] = os.Args[2]\n        args["address"] = os.Args[3]\n    case "reload":\n    default:\n        fmt.Fprintf(os.Stderr, "unknown command: %s\\n", cmd)\n        os.Exit(1)\n    }\n    data, err := sendCommand(cmd, args)\n    if err != nil {\n        fmt.Fprintln(os.Stderr, err)\n        os.Exit(1)\n    }\n    fmt.Println(data)\n}\n\nfunc sendCommand(cmd string, args map[string]interface{}) (string, error) {\n    var rawArgs json.RawMessage\n    if args != nil {\n        b, err := json.Marshal(args)\n        if err != nil {\n            return "", err\n        }\n        rawArgs = b\n    } else {\n        rawArgs = json.RawMessage("{}")\n    }\n    req := request{Cmd: cmd, Args: rawArgs}\n    reqBytes, err := json.Marshal(req)\n    if err != nil {\n        return "", err\n    }\n    conn, err := net.Dial("unix", "/tmp/meshd.sock")\n    if err != nil {\n        return "", fmt.Errorf("connect to meshd failed: %w", err)\n    }\n    defer conn.Close()\n    fmt.Fprintf(conn, "%s\\n", string(reqBytes))\n    reader := bufio.NewReader(conn)\n    line, err := reader.ReadString(\'\\n\')\n    if err != nil {\n        return "", err\n    }\n    line = strings.TrimRight(line, "\\r\\n")\n    var resp response\n    if err := json.Unmarshal([]byte(line), &resp); err != nil {\n        return "", err\n    }\n    if resp.Status != "ok" {\n        var msg string\n        if err := json.Unmarshal(resp.Data, &msg); err == nil {\n            return "", fmt.Errorf("%s", msg)\n        }\n        return "", fmt.Errorf("%s", string(resp.Data))\n    }\n    return prettyData(cmd, resp.Data)\n}\n\nfunc prettyData(cmd string, data json.RawMessage) (string, error) {\n    switch cmd {\n    case "status":\n        var services []struct {\n            Name        string `json:"name"`\n            ListenPort  int    `json:"listen_port"`\n            RoutingMode string `json:"routing_mode"`\n            Endpoints   []struct {\n                Address            string `json:"address"`\n                State             string `json:"state"`\n                Weight            int    `json:"weight"`\n                ActiveConnections int    `json:"active_connections"`\n                CircuitState       string `json:"circuit_state"`\n            } `json:"endpoints"`\n        }\n        if err := json.Unmarshal(data, &services); err != nil {\n            return "", err\n        }\n        var b strings.Builder\n        fmt.Fprintf(&b, "%-14s %-18s %-10s %-7s %-11s %-7s\\n", "SERVICE", "ENDPOINT", "STATE", "WEIGHT", "CIRCUIT", "ACTIVE")\n        for _, svc := range services {\n            for _, ep := range svc.Endpoints {\n                fmt.Fprintf(&b, "%-14s %-18s %-10s %-7d %-11s %-7d\\n", svc.Name, ep.Address, ep.State, ep.Weight, ep.CircuitState, ep.ActiveConnections)\n            }\n        }\n        return strings.TrimRight(b.String(), "\\n"), nil\n    case "resolve":\n        var addr string\n        if err := json.Unmarshal(data, &addr); err != nil {\n            return "", err\n        }\n        return addr, nil\n    case "set-weight", "drain", "reset-circuit", "reload":\n        var s string\n        if err := json.Unmarshal(data, &s); err != nil {\n            return "", err\n        }\n        return s, nil\n    default:\n        var v interface{}\n        if err := json.Unmarshal(data, &v); err != nil {\n            return "", err\n        }\n        b, err := json.MarshalIndent(v, "", "  ")\n        if err != nil {\n            return "", err\n        }\n        return string(b), nil\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
