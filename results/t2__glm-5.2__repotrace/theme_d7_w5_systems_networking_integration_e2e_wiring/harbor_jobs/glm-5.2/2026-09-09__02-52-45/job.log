Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\np = Path(\'internal/state/routing.go\')\ns = p.read_text()\n\ns = s.replace(\n\'\'\'// SelectResult contains selected endpoint and whether it is a half-open probe.\ntype SelectResult struct {\n\\tEndpoint *EndpointState\n\\tProbe    bool\n\\tMaxConns int\n}\'\'\',\n\'\'\'// SelectResult contains selected endpoint and whether it is a half-open probe.\ntype SelectResult struct {\n\\tEndpoint *EndpointState\n\\tProbe    bool\n\\tMaxConns int\n\\tPerService bool\n}\'\'\')\n\ns = s.replace(\n\'\'\'// SelectEndpoint chooses an endpoint for the next connection.\nfunc (s *State) SelectEndpoint(service string) (SelectResult, error) {\n\\tss := s.GetService(service)\n\\tif ss == nil {\n\\t\\treturn SelectResult{}, errNotFound("service not found")\n\\t}\n\\tss.mu.Lock()\n\\tmaxConns := ss.MaxConnectionsPerEndpoint\n\\tmode := ss.RoutingMode\n\\tendpoints := make([]*EndpointState, len(ss.Endpoints))\n\\tcopy(endpoints, ss.Endpoints)\n\\tss.mu.Unlock()\n\n\\tnow := time.Now()\n\\t_ = now\n\n\\tvar regular []*EndpointState\n\\tfor _, ep := range endpoints {\n\\t\\tep.mu.Lock()\n\\t\\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n\\t\\tep.mu.Unlock()\n\\t\\tif eligible {\n\\t\\t\\tregular = append(regular, ep)\n\\t\\t}\n\\t}\n\n\\tif len(regular) > 0 {\n\\t\\tif mode == "least-connections" {\n\\t\\t\\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\n\\t\\t}\n\\t\\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\n\\t}\n\n\\tfor _, ep := range endpoints {\n\\t\\tep.mu.Lock()\n\\t\\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n\\t\\tep.mu.Unlock()\n\\t\\tif halfOpen && ep.Circuit.AcquireProbe() {\n\\t\\t\\treturn SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil\n\\t\\t}\n\\t}\n\\treturn SelectResult{}, errNotFound("no eligible endpoints")\n}\'\'\',\n\'\'\'// SelectEndpoint chooses an endpoint for the next connection.\nfunc (s *State) SelectEndpoint(service string) (SelectResult, error) {\n\\treturn s.selectEndpointExcluding(service, nil)\n}\'\'\')\n\ns = s.replace(\n\'\'\'func selectWeighted(eps []*EndpointState) *EndpointState {\n\\tvar best *EndpointState\n\\tvar bestWeight int\n\\tvar totalWeight int\n\\tfor _, ep := range eps {\n\\t\\tep.mu.Lock()\n\\t\\tep.currentWeight += ep.Weight\n\\t\\ttotalWeight += ep.Weight\n\\t\\tcw := ep.currentWeight\n\\t\\tep.mu.Unlock()\n\\t\\tif best == nil || cw > bestWeight {\n\\t\\t\\tbest = ep\n\\t\\t\\tbestWeight = cw\n\\t\\t}\n\\t}\n\\tif best != nil {\n\\t\\tbest.mu.Lock()\n\\t\\tbest.currentWeight -= totalWeight\n\\t\\tbest.mu.Unlock()\n\\t}\n\\treturn best\n}\'\'\',\n\'\'\'func selectWeighted(eps []*EndpointState) *EndpointState {\n\\tvar best *EndpointState\n\\tvar bestWeight int\n\\tvar totalWeight int\n\\tfor _, ep := range eps {\n\\t\\tep.mu.Lock()\n\\t\\tw := ep.effectiveWeightLocked()\n\\t\\tep.currentWeight += w\n\\t\\ttotalWeight += w\n\\t\\tcw := ep.currentWeight\n\\t\\tep.mu.Unlock()\n\\t\\tif best == nil || cw > bestWeight {\n\\t\\t\\tbest = ep\n\\t\\t\\tbestWeight = cw\n\\t\\t}\n\\t}\n\\tif best != nil {\n\\t\\tbest.mu.Lock()\n\\t\\tbest.currentWeight -= totalWeight\n\\t\\tbest.mu.Unlock()\n\\t}\n\\treturn best\n}\'\'\')\n\ns = s.replace(\n\'\'\'func selectWeightedCandidate(eps []*EndpointState) *EndpointState {\n\\tvar best *EndpointState\n\\tvar bestWeight int\n\\tfor _, ep := range eps {\n\\t\\tep.mu.Lock()\n\\t\\tcw := ep.currentWeight + ep.Weight\n\\t\\tep.mu.Unlock()\n\\t\\tif best == nil || cw > bestWeight {\n\\t\\t\\tbest = ep\n\\t\\t\\tbestWeight = cw\n\\t\\t}\n\\t}\n\\treturn best\n}\'\'\',\n\'\'\'func selectWeightedCandidate(eps []*EndpointState) *EndpointState {\n\\tvar best *EndpointState\n\\tvar bestWeight int\n\\tfor _, ep := range eps {\n\\t\\tep.mu.Lock()\n\\t\\tcw := ep.currentWeight + ep.effectiveWeightLocked()\n\\t\\tep.mu.Unlock()\n\\t\\tif best == nil || cw > bestWeight {\n\\t\\t\\tbest = ep\n\\t\\t\\tbestWeight = cw\n\\t\\t}\n\\t}\n\\treturn best\n}\'\'\')\n\ns = s.replace(\n\'\'\'func selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\n\\tsort.SliceStable(eps, func(i, j int) bool {\n\\t\\tai := eps[i].Active()\n\\t\\taj := eps[j].Active()\n\\t\\tif ai != aj {\n\\t\\t\\treturn ai < aj\n\\t\\t}\n\\t\\t// Tie-break by weight (higher weight first), then lexicographic address.\n\\t\\twi := eps[i].Weight\n\\t\\twj := eps[j].Weight\n\\t\\tif wi != wj {\n\\t\\t\\treturn wi > wj\n\\t\\t}\n\\t\\treturn eps[i].Address < eps[j].Address\n\\t})\n\\treturn eps[0]\n}\'\'\',\n\'\'\'func selectLeastConnections(eps []*EndpointState, maxConns int) *EndpointState {\n\\tsort.SliceStable(eps, func(i, j int) bool {\n\\t\\tai := eps[i].Active()\n\\t\\taj := eps[j].Active()\n\\t\\tif ai != aj {\n\\t\\t\\treturn ai < aj\n\\t\\t}\n\\t\\t// Tie-break by effective weight (higher weight first), then lexicographic address.\n\\t\\twi := eps[i].EffectiveWeight()\n\\t\\twj := eps[j].EffectiveWeight()\n\\t\\tif wi != wj {\n\\t\\t\\treturn wi > wj\n\\t\\t}\n\\t\\treturn eps[i].Address < eps[j].Address\n\\t})\n\\treturn eps[0]\n}\'\'\')\n\ns = s.replace(\n\'\'\'// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\nfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\n\\tss := s.GetService(service)\n\\tif ss == nil {\n\\t\\treturn SelectResult{}, errNotFound("service not found")\n\\t}\n\\tss.mu.Lock()\n\\tmaxConns := ss.MaxConnectionsPerEndpoint\n\\tmode := ss.RoutingMode\n\\tendpoints := make([]*EndpointState, len(ss.Endpoints))\n\\tcopy(endpoints, ss.Endpoints)\n\\tss.mu.Unlock()\n\n\\tvar regular []*EndpointState\n\\tfor _, ep := range endpoints {\n\\t\\tif exclude != nil && ep == exclude {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tep.mu.Lock()\n\\t\\teligible := ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n\\t\\tep.mu.Unlock()\n\\t\\tif eligible {\n\\t\\t\\tregular = append(regular, ep)\n\\t\\t}\n\\t}\n\n\\tif len(regular) > 0 {\n\\t\\tif mode == "least-connections" {\n\\t\\t\\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns}, nil\n\\t\\t}\n\\t\\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns}, nil\n\\t}\n\n\\tfor _, ep := range endpoints {\n\\t\\tif exclude != nil && ep == exclude {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tep.mu.Lock()\n\\t\\thalfOpen := ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n\\t\\tep.mu.Unlock()\n\\t\\tif halfOpen && ep.Circuit.AcquireProbe() {\n\\t\\t\\treturn SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns}, nil\n\\t\\t}\n\\t}\n\\treturn SelectResult{}, errNotFound("no eligible endpoints")\n}\'\'\',\n\'\'\'// SelectEndpointExcluding chooses an eligible endpoint other than exclude when possible.\nfunc (s *State) SelectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\n\\treturn s.selectEndpointExcluding(service, exclude)\n}\n\nfunc (s *State) selectEndpointExcluding(service string, exclude *EndpointState) (SelectResult, error) {\n\\tss := s.GetService(service)\n\\tif ss == nil {\n\\t\\treturn SelectResult{}, errNotFound("service not found")\n\\t}\n\\tss.mu.Lock()\n\\tmaxConns := ss.MaxConnectionsPerEndpoint\n\\tmode := ss.RoutingMode\n\\tperService := ss.ConnectionLimitMode == "per-service"\n\\tendpoints := make([]*EndpointState, len(ss.Endpoints))\n\\tcopy(endpoints, ss.Endpoints)\n\\tss.mu.Unlock()\n\n\\tnow := time.Now()\n\\t_ = now\n\n\\ttotalActive := 0\n\\tif perService {\n\\t\\tfor _, ep := range endpoints {\n\\t\\t\\tep.mu.Lock()\n\\t\\t\\ttotalActive += ep.ActiveConnections\n\\t\\t\\tep.mu.Unlock()\n\\t\\t}\n\\t}\n\n\\tvar regular []*EndpointState\n\\tfor _, ep := range endpoints {\n\\t\\tif exclude != nil && ep == exclude {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tep.mu.Lock()\n\\t\\tvar eligible bool\n\\t\\tif perService {\n\\t\\t\\teligible = ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && totalActive < maxConns\n\\t\\t} else {\n\\t\\t\\teligible = ep.State == Healthy && ep.Circuit.IsClosed() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n\\t\\t}\n\\t\\tep.mu.Unlock()\n\\t\\tif eligible {\n\\t\\t\\tregular = append(regular, ep)\n\\t\\t}\n\\t}\n\n\\tif len(regular) > 0 {\n\\t\\tif mode == "least-connections" {\n\\t\\t\\treturn SelectResult{Endpoint: selectLeastConnections(regular, maxConns), Probe: false, MaxConns: maxConns, PerService: perService}, nil\n\\t\\t}\n\\t\\treturn SelectResult{Endpoint: selectWeighted(regular), Probe: false, MaxConns: maxConns, PerService: perService}, nil\n\\t}\n\n\\tfor _, ep := range endpoints {\n\\t\\tif exclude != nil && ep == exclude {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\tep.mu.Lock()\n\\t\\tvar halfOpen bool\n\\t\\tif perService {\n\\t\\t\\thalfOpen = ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && totalActive < maxConns\n\\t\\t} else {\n\\t\\t\\thalfOpen = ep.State == Healthy && ep.Circuit.IsHalfOpen() && ep.Weight > 0 && ep.State != Draining && ep.ActiveConnections < maxConns\n\\t\\t}\n\\t\\tep.mu.Unlock()\n\\t\\tif halfOpen && ep.Circuit.AcquireProbe() {\n\\t\\t\\treturn SelectResult{Endpoint: ep, Probe: true, MaxConns: maxConns, PerService: perService}, nil\n\\t\\t}\n\\t}\n\\treturn SelectResult{}, errNotFound("no eligible endpoints")\n}\'\'\')\n\np.write_text(s)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
