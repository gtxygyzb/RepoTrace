    }\n        var services []struct {\n                Name string `json:"name"`\n        }\n        if err := json.Unmarshal(raw, &services); err != nil {\n                return "", err\n        }\n        type depRow struct {\n                Service          string\n                Name             string\n                Available        bool\n                HealthyEndpoints int\n        }\n        var rows []depRow\n        for _, svc := range services {\n                depRaw, err := sendRaw("get_dependencies", map[string]interface{}{"name": svc.Name})\n                if err != nil {\n                        return "", err\n                }\n                var resp struct {\n                        Service      string `json:"service"`\n                        Dependencies []struct {\n                                Name             string `json:"name"`\n                                Available         bool   `json:"available"`\n                                HealthyEndpoints int    `json:"healthy_endpoints"`\n                        } `json:"dependencies"`\n                }\n                if err := json.Unmarshal(depRaw, &resp); err != nil {\n                        return "", err\n                }\n                for _, dep := range resp.Dependencies {\n                        rows = append(rows, depRow{Service: svc.Name, Name: dep.Name, Available: dep.Available, HealthyEndpoints: dep.HealthyEndpoints})\n                }\n        }\n        if len(rows) == 0 {\n                return "no dependencies", nil\n        }\n        var b strings.Builder\n        fmt.Fprintf(&b, "%-14s %-14s %-10s %-18s\\\\n", "SERVICE", "DEPENDS_ON", "AVAILABLE", "HEALTHY_ENDPOINTS")\n        for _, row := range rows {\n                fmt.Fprintf(&b, "%-14s %-14s %-10t %-18d\\\\n", row.Service, row.Name, row.Available, row.HealthyEndpoints)\n        }\n        return strings.TrimRight(b.String(), "\\\\n"), nil\n}\n\nfunc sendRaw(ipcCmd string, args map[string]interface{}) (json.RawMessage, error) {\'\'\'\n    )\n# Special-case deps with no service in main()\ns = s.replace(\n\'\'\'        case "deps":\n                ipcCmd = "get_dependencies"\n                if len(os.Args) >= 3 {\n                        args["name"] = os.Args[2]\n                } else {\n                        args["name"] = ""\n                }\n\'\'\',\n\'\'\'        case "deps":\n                if len(os.Args) >= 3 {\n                        ipcCmd = "get_dependencies"\n                        args["name"] = os.Args[2]\n                } else {\n                        out, err := depsAll()\n                        if err != nil {\n                                fmt.Fprintln(os.Stderr, err)\n                                os.Exit(1)\n                        }\n                        fmt.Println(out)\n                        return\n                }\n\'\'\'\n    )\np.write_text(s)\nPY\ngofmt -w internal/config/config.go internal/ipc/server.go cmd/meshctl/main.go\ngo build ./...\ngo test ./...\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
