json:"report_path"`\n\tReportSHA256        string `json:"report_sha256"`\n\tReportBytes         int64  `json:"report_bytes"`\n\tShardCount          int    `json:"shard_count"`\n\tSortKey             string `json:"sort_key,omitempty"`\n\tShardsSortedInvariant *bool `json:"shards_sorted_invariant,omitempty"`\n\tToolVersion         string `json:"tool_version"`\n}\n\ntype shardingReportIndexEntry struct {\n\tName string `json:"name"`\n\tType string `json:"type"`\n\tPath string `json:"path"`\n}\n\ntype shardingReportIndex struct {\n\tEntries       []shardingReportIndexEntry `json:"entries"`\n\tEntryCount    int                        `json:"entry_count"`\n\tShardCount    int                        `json:"shard_count"`\n\tGeneratedFrom string                     `json:"generated_from"`\n\tToolVersion   string                     `json:"tool_version"`\n}\n\ntype shardingReportHistogramBucket struct {\n\tUpperBound int `json:"upper_bound"`\n\tCount      int `json:"count"`\n}\n\ntype shardingReportHistogram struct {\n\tSchemaVersion string                            `json:"schema_version"`\n\tReportPath    string                            `json:"report_path"`\n\tShardCount    int                              `json:"shard_count"`\n\tBuckets       map[string][]shardingReportHistogramBucket `json:"buckets"`\n\tToolVersion   string                            `json:"tool_version"`\n}\n\nfunc writeShardingReportSidecars(cfg cliConfig, shards []inputShardInfo, auditEntries []auditLogEntry, events []rawEvent) error {\n\tif cfg.shardingReport == "" {\n\t\treturn nil\n\t}\n\treportShards := buildShardingReportShards(cfg, shards, auditEntries, events)\n\tsortKey := cfg.shardingReportSort\n\tif sortKey == "" {\n\t\tsortKey = "basename"\n\t}\n\tsortShardingReportShards(reportShards, sortKey)\n\n\tvar ingestID *string\n\tif cfg.ingestIDSet {\n\t\tid := cfg.ingestID\n\t\tingestID = &id\n\t}\n\ttotals := shardingReportTotals{Shards: len(reportShards)}\n\tfor _, s := range reportShards {\n\t\ttotals.BytesTotal += s.Bytes\n\t\ttotals.EventsTotal += s.EventsTotal\n\t\ttotals.EventsAccepted += s.EventsAccepted\n\t\ttotals.EventsInvalid += s.EventsInvalid\n\t\ttotals.EventsLate += s.EventsLate\n\t\ttotals.EventsDuplicate += s.EventsDuplicate\n\t\ttotals.EventsUnresolvedChargeback += s.EventsUnresolvedChargeback\n\t}\n\treport := shardingReport{\n\t\tSchemaVersion: shardingReportSchemaVersion,\n\t\tIngestID:      ingestID,\n\t\tShards:        reportShards,\n\t\tTotals:        totals,\n\t}\n\tdata, err := json.MarshalIndent(report, "", "  ")\n\tif err != nil {\n\t\treturn err\n\t}\n\tdata = append(data, \'\\n\')\n\tif err := atomicWriteFile(cfg.shardingReport, data); err != nil {\n\t\treturn err\n\t}\n\n\treportBase := filepath.Base(cfg.shardingReport)\n\tif cfg.shardingReportHistogram != "" {\n\t\tif err := writeShardingHistogram(cfg.shardingReportHistogram, reportBase, reportShards, totals.Shards); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif cfg.shardingReportDigest != "" {\n\t\tif err := writeShardingDigest(cfg, data, reportBase, totals.Shards, sortKey, reportShards); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif cfg.shardingReportIndex != "" {\n\t\tif err := writeShardingIndex(cfg.shardingReportIndex, reportBase, reportShards); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc buildShardingReportShards(cfg cliConfig, shards []inputShardInfo, auditEntries []auditLogEntry, events []rawEvent) []shardingReportShard {\n\tcounts := map[string]map[string]int{}\n\tfor _, e := range auditEntries {\n\t\tif counts[e.Shard] == nil {\n\t\t\tcounts[e.Shard] = map[string]int{}\n\t\t}\n\t\tcounts[e.Shard][e.Bucket]++\n\t}\n\ttsRanges := map[string]*shardTSRange{}\n\tfor _, raw := range events {\n\t\tif raw.Invalid || raw.Blank || raw.Obj == nil {\n\t\t\tcontinue\n\t\t}\n\t\tts, ok, _ := getRawString(raw.Obj, "ts")\n\t\tif !ok || !isExactRFC3339UTC(ts) {\n\t\t\tcontinue\n\t\t}\n\t\tr := tsRanges[raw.Shard]\n\t\tif r == nil {\n\t\t\tr = &shardTS