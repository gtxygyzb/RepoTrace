e(rows, func(i, j int) bool {\n\\t\\t\\tri, rj := rows[i], rows[j]\n\\t\\t\\tbi, bj := bucketRank(rows[i].bucket), bucketRank(rows[j].bucket)\n\\t\\t\\tif bi != bj {\n\\t\\t\\t\\treturn bi < bj\n\\t\\t\\t}\n\\t\\t\\tif ri.shard != rj.shard {\n\\t\\t\\t\\treturn ri.shard < rj.shard\n\\t\\t\\t}\n\\t\\t\\treturn ri.line < rj.line\n\\t\\t})\n\\t}\n\\tvar buf bytes.Buffer\n\\tif header && len(rows) > 0 {\n\\t\\tif policy == "first-arrival" {\n\\t\\t\\tbuf.WriteString("#bucket\\\\treason_code\\\\tshard\\\\tline_no\\\\traw_line\\\\twinner_shard\\\\twinner_line\\\\n")\n\\t\\t} else {\n\\t\\t\\tbuf.WriteString("#bucket\\\\treason_code\\\\tshard\\\\tline_no\\\\traw_line\\\\n")\n\\t\\t}\n\\t}\n\\tfor _, bucket := range order {\n\\t\\tfor _, r := range rows {\n\\t\\t\\tif format != "tagged-sorted" && r.bucket != bucket {\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}\n\\t\\t\\tif format == "tagged-sorted" && bucketRank(r.bucket) != bucketRank(bucket) {\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}\n\\t\\t\\tbuf.WriteString(r.bucket)\n\\t\\t\\tbuf.WriteByte(\'\\\\t\')\n\\t\\t\\tbuf.WriteString(r.reason)\n\\t\\t\\tbuf.WriteByte(\'\\\\t\')\n\\t\\t\\tbuf.WriteString(r.shard)\n\\t\\t\\tbuf.WriteByte(\'\\\\t\')\n\\t\\t\\tbuf.WriteString(strconv.Itoa(r.line))\n\\t\\t\\tbuf.WriteByte(\'\\\\t\')\n\\t\\t\\tbuf.WriteString(r.raw)\n\\t\\t\\tif policy == "first-arrival" {\n\\t\\t\\t\\tbuf.WriteByte(\'\\\\t\')\n\\t\\t\\t\\tif r.winner {\n\\t\\t\\t\\t\\tbuf.WriteString(r.winnerShard)\n\\t\\t\\t\\t\\tbuf.WriteByte(\'\\\\t\')\n\\t\\t\\t\\t\\tbuf.WriteString(strconv.Itoa(r.winnerLine))\n\\t\\t\\t\\t} else {\n\\t\\t\\t\\t\\tbuf.WriteString("-")\n\\t\\t\\t\\t\\tbuf.WriteByte(\'\\\\t\')\n\\t\\t\\t\\t\\tbuf.WriteString("-")\n\\t\\t\\t\\t}\n\\t\\t\\t}\n\\t\\t\\tbuf.WriteByte(\'\\\\n\')\n\\t\\t}\n\\t}\n\\treturn buf.Bytes()\n}\n\nfunc auditReason(e auditLogEntry) string {\n\\tif e.Bucket == "late" {\n\\t\\treturn "late"\n\\t}\n\\tif e.Bucket == "unresolved_chargeback" {\n\\t\\treturn "unresolved_chargeback"\n\\t}\n\\tif e.Bucket == "duplicate" {\n\\t\\tif e.Reason == "" {\n\\t\\t\\treturn "same_run"\n\\t\\t}\n\\t\\treturn e.Reason\n\\t}\n\\treturn e.Reason\n}\n\nfunc bucketRank(bucket string) int {\n\\tswitch bucket {\n\\tcase "invalid":\n\\t\\treturn 0\n\\tcase "late":\n\\t\\treturn 1\n\\tcase "duplicate":\n\\t\\treturn 2\n\\tcase "unresolved_chargeback":\n\\t\\treturn 3\n\\t}\n\\treturn 4\n}\'\'\'\nassert old_build in s, "old buildRejects not found"\ns = s.replace(old_build, new_build, 1)\n\n# Remove old bucketCode if duplicate? Keep if used elsewhere. Add bucketRank after it.\n# 7. Add audit digest cross-check\ns = s.replace(\n\'\'\'\\t\\t\\tdigest := auditDigestOutput{\n\\t\\t\\t\\tSchemaVersion:    "eventq.digest/v1",\n\\t\\t\\t\\tTotalRecords:     len(auditEntries),\n\\t\\t\\t\\tBucketCounts:     bucketCounts,\n\\t\\t\\t\\tInvalidReasons:   invalidReasons,\n\\t\\t\\t\\tDuplicateReasons: duplicateReasons,\n\\t\\t\\t\\tLateCutoffStats:  computeLateCutoffStats(auditEntries),\n\\t\\t\\t\\tResolvedAgainst:  "state",\n\\t\\t\\t\\tFXFallbackStats:  fxFallbackStats,\n\\t\\t\\t\\tRatesDigest:      ratesDigest,\n\\t\\t\\t}\'\'\',\n\'\'\'\\t\\t\\tdigest := auditDigestOutput{\n\\t\\t\\t\\tSchemaVersion:    "eventq.digest/v1",\n\\t\\t\\t\\tTotalRecords:     len(auditEntries),\n\\t\\t\\t\\tBucketCounts:     bucketCounts,\n\\t\\t\\t\\tInvalidReasons:   invalidReasons,\n\\t\\t\\t\\tDuplicateReasons: duplicateReasons,\n\\t\\t\\t\\tLateCutoffStats:  computeLateCutoffStats(auditEntries),\n\\t\\t\\t\\tResolvedAgainst:  "state",\n\\t\\t\\t\\tFXFallbackStats:  fxFallbackStats,\n\\t\\t\\t\\tRatesDigest:      ratesDigest,\n\\t\\t\\t}\n\\t\\t\\tif cfg.rejectsFormat == "tagged" || cfg.rejectsFormat == "tagged-sorted" {\n\\t\\t\\t\\tauditRejectCount := 0\n\\t\\t\\t\\tfor _, e := range auditEntries {\n\\t\\t\\t\\t\\tif e.Bucket != "accepted" {\n\\t\\t\\t\\t\\t\\tauditRejectCount++\n\\t\\t\\t\\t\\t}\n\\t\\t\\t\\t}\n\\t\\t\\t\\tdigest.RejectsCrossCheck = &rejectsCrossCheck{\n\\t\\t\\t\\t\\tRejectsRowCount:    