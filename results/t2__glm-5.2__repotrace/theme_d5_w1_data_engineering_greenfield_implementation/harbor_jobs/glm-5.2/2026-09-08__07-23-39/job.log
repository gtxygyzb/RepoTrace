sha256", value: h},\n\t\t\t{key: "provenance_bytes", value: b},\n\t\t\t{key: "tool_version", value: toolVersion},\n\t\t}\n\t\tdigestData := marshalOrderedIndent(digest)\n\t\tdigestData = append(digestData, \'\\n\')\n\t\tif err := atomicWriteFile(cfg.runProvenanceDigest, digestData); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc buildRunProvenance(cfg cliConfig, shards []inputShardInfo) []orderedJSON {\n\tentries := []orderedJSON{\n\t\t{key: "schema_version", value: runProvenanceSchemaVersion},\n\t\t{key: "tool_version", value: toolVersion},\n\t\t{key: "flags", value: buildRunProvenanceFlags(cfg)},\n\t\t{key: "inputs_fingerprint", value: inputsFingerprint(shards)},\n\t\t{key: "shard_count", value: len(shards)},\n\t}\n\tif cfg.runProvenanceStrict {\n\t\tentries = append(entries,\n\t\t\torderedJSON{key: "argv_sha256", value: argvSHA256(os.Args[1:])},\n\t\t\torderedJSON{key: "env_fingerprint", value: envFingerprint()},\n\t\t)\n\t}\n\treturn entries\n}\n\nfunc buildRunProvenanceFlags(cfg cliConfig) []orderedJSON {\n\tvar entries []orderedJSON\n\tfor _, name := range runProvenanceFlagOrder {\n\t\tif !cfg.observedFlags[name] {\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, orderedJSON{key: name, value: runProvenanceFlagValue(cfg, name)})\n\t}\n\treturn entries\n}\n\nfunc runProvenanceFlagValue(cfg cliConfig, name string) any {\n\tswitch name {\n\tcase "input-dir":\n\t\treturn cfg.inputDir\n\tcase "rates":\n\t\treturn cfg.ratesPath\n\tcase "output":\n\t\treturn cfg.outputPath\n\tcase "rejects":\n\t\treturn cfg.rejectsPath\n\tcase "session-gap":\n\t\treturn cfg.sessionGap\n\tcase "watermark-lag":\n\t\treturn cfg.watermarkLag\n\tcase "state-in":\n\t\treturn cfg.stateIn\n\tcase "state-out":\n\t\treturn cfg.stateOut\n\tcase "pending-ttl":\n\t\treturn cfg.pendingTTL\n\tcase "max-open-sessions":\n\t\treturn cfg.maxOpenSessions\n\tcase "state-strict":\n\t\treturn cfg.stateStrict\n\tcase "audit-log":\n\t\treturn cfg.auditLog\n\tcase "audit-log-digest":\n\t\treturn cfg.auditLogDigest\n\tcase "audit-log-rotate-bytes":\n\t\treturn cfg.auditLogRotateBytes\n\tcase "rates-strict":\n\t\treturn cfg.ratesStrict\n\tcase "rates-max-staleness":\n\t\treturn cfg.ratesMaxStaleness\n\tcase "ingest-id":\n\t\treturn cfg.ingestID\n\tcase "out-parquet-manifest":\n\t\treturn cfg.outManifest\n\tcase "manifest-signature":\n\t\treturn cfg.manifestSignature\n\tcase "dedup-policy":\n\t\treturn cfg.dedupPolicy\n\tcase "strict-late-audit":\n\t\treturn cfg.strictLateAudit\n\tcase "summary-schema-out":\n\t\treturn cfg.summarySchemaOut\n\tcase "summary-schema-digest":\n\t\treturn cfg.summarySchemaDigest\n\tcase "summary-schema-strict":\n\t\treturn cfg.summarySchemaStrict\n\tcase "summary-schema-index":\n\t\treturn cfg.summarySchemaIndex\n\tcase "rejects-format":\n\t\treturn cfg.rejectsFormat\n\tcase "rejects-format-header":\n\t\treturn cfg.rejectsFormatHeader\n\tcase "session-policy":\n\t\treturn cfg.sessionPolicy\n\tcase "fixed-window-seconds":\n\t\treturn cfg.fixedWindowSeconds\n\tcase "sharding-report":\n\t\treturn cfg.shardingReport\n\tcase "sharding-report-digest":\n\t\treturn cfg.shardingReportDigest\n\tcase "sharding-report-index":\n\t\treturn cfg.shardingReportIndex\n\tcase "sharding-report-histogram":\n\t\treturn cfg.shardingReportHistogram\n\tcase "sharding-report-sort":\n\t\treturn cfg.shardingReportSort\n\tcase "sharding-report-strict":\n\t\treturn cfg.shardingReportStrict\n\tcase "run-provenance":\n\t\treturn cfg.runProvenance\n\tcase "run-provenance-digest":\n\t\treturn cfg.runProvenanceDigest\n\tcase "run-provenance-strict":\n\t\treturn cfg.runProvenanceStrict\n\tdefault:\n\t\treturn nil\n\t}\n}\n\nfunc inputsFingerprint(shards []inputShardInfo) string {\n\tif len(shards) == 0 {\n\t\treturn emptySHA256\n\t}\n\tvar concat []byte\n\tfor _, s := range shards {\n\t\tconcat = append(concat, []byte(s.SHA256)...)\n\t}\n\treturn sha256Hex(concat)\n}\n\nfunc argvSHA256(argv []string) string {\n\tvar parts []string\n\tfor _, tok := range argv {\n\t\tif !strings.Contains(tok, "/") {\n\t\t\tparts = append(parts, tok)\n\t\t}\n\t}\n\tjoined := strings.Join(parts, " ")\n\treturn sha256Hex([]byte(joined))\n}\n\nfunc envFingerprint() string {\n\tvar names []string\n\tfor _, kv := range os.Environ() {\n\t\tif strings.HasPrefix(kv, "EVENTQ_") {\n\t\t\tname := kv\n\t\t\tif idx := strings.IndexByte(kv, \'=\'); idx >= 0 {\n\t\t\t\tname = kv[:idx]\n\t\t\t}\n\t\t\tif strings.HasPrefix(name, "EVENTQ_") {\n\t\t\t\tnames = append(names, name)\n\t\t\t}\n\t\t}\n\t}\n\tsort.Strings(names)\n\tvar buf bytes.Buffer\n\tfor _, name := range names {\n\t\tbuf.WriteString(name)\n\t\tbuf.WriteByte(\'\\n\')\n\t}\n\treturn sha256Hex(buf.Bytes())\n}\n\nvar _ = strconv.Atoi\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
