t// Finalize accepted/duplicate buckets and outputs in arrival order.\')\nnew_winner=r\'\'\'\twinner := idxs[0]\n\ttiebreak := false\n\tfor _, idx := range idxs[1:] {\n\t\tif cfg.dedupPolicy == "first-arrival" {\n\t\t\tif arrivalLess(candidates[idx].ev, candidates[winner].ev) {\n\t\t\t\twinner = idx\n\t\t\t}\n\t\t} else {\n\t\t\tcts := candidates[idx].ctx.TSString()\n\t\t\twts := candidates[winner].ctx.TSString()\n\t\t\tif cts > wts {\n\t\t\t\twinner = idx\n\t\t\t\ttiebreak = false\n\t\t\t} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {\n\t\t\t\twinner = idx\n\t\t\t\ttiebreak = true\n\t\t\t}\n\t\t}\n\t}\n\tif cfg.dedupPolicy == "lex-largest-ts" {\n\t\twts := candidates[winner].ctx.TSString()\n\t\tfor _, idx := range idxs {\n\t\t\tif idx != winner && candidates[idx].ctx.TSString() == wts {\n\t\t\t\ttiebreak = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\twinners[id] = winner\n\twinnerSet[winner] = true\n\tsameShard := true\n\tfor _, idx := range idxs {\n\t\tif candidates[idx].ev.Shard != candidates[winner].ev.Shard {\n\t\t\tsameShard = false\n\t\t\tbreak\n\t\t}\n\t}\n\tif sameShard {\n\t\tdedupPolicyStats.DuplicateWinnersSameShard++\n\t\tif cfg.dedupPolicy == "first-arrival" || tiebreak {\n\t\t\tdedupPolicyStats.DuplicateWinnersLineTiebreak++\n\t\t}\n\t} else {\n\t\tdedupPolicyStats.DuplicateWinnersCrossShard++\n\t}\n\'\'\'\ns=s[:start]+new_winner+s[end:]\n\n# Replace finalization block to reset min/max and mark seen IDs.\nstart=s.index(\'\\t// Finalize accepted/duplicate buckets and outputs in arrival order.\')\nend=s.index(\'\\n\\tvar rejectRecords []rejectRecord\')\nnew_final=r\'\'\'\t// Finalize accepted/duplicate buckets and outputs in arrival order.\n\thasMin, hasMax = false, false\n\tfor _, c := range candidates {\n\t\tif c.ev != nil {\n\t\t\tseen[c.ev.ID] = true\n\t\t}\n\t}\n\tbucketCounts["accepted"] = 0\n\tbucketCounts["duplicate"] = duplicateReasons["cross_run"]\n\tfor i, c := range candidates {\n\t\t_ = i\n\t\tif c.ev == nil {\n\t\t\tcontinue\n\t\t}\n\t\tif winnerSet[i] {\n\t\t\tbucketCounts["accepted"]++\n\t\t\tshardAccepted[c.ev.Shard]++\n\t\t\tif !hasMin || c.ev.TS.Before(minTs) {\n\t\t\t\tminTs = c.ev.TS\n\t\t\t\thasMin = true\n\t\t\t}\n\t\t\tif !hasMax || c.ev.TS.After(maxTs) {\n\t\t\t\tmaxTs = c.ev.TS\n\t\t\t\thasMax = true\n\t\t\t}\n\t\t\t_ = pending\n\t\t\t_ = openSessions\n\t\t} else {\n\t\t\tbucketCounts["duplicate"]++\n\t\t\tduplicateReasons["same_run"]++\n\t\t\tentry := auditEntries[i]\n\t\t\tentry.Bucket = "duplicate"\n\t\t\tentry.Reason = "same_run"\n\t\t\tif cfg.dedupPolicy == "first-arrival" {\n\t\t\t\tw := winners[entry.ID]\n\t\t\t\tentry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}\n\t\t\t}\n\t\t\tauditEntries[i] = entry\n\t\t}\n\t}\n\'\'\'\ns=s[:start]+new_final+s[end:]\n\n# Only emit dedup_policy_stats when audit log, digest, and first-arrival policy are present.\ns=s.replace(\'\'\'\t\tif cfg.dedupPolicySet {\n\t\t\tdigest.DedupPolicyStats = &dedupPolicyStats\n\t\t}\'\'\', \'\'\'\t\tif cfg.dedupPolicySet && cfg.auditLog != "" && cfg.dedupPolicy == "first-arrival" {\n\t\t\tdigest.DedupPolicyStats = &dedupPolicyStats\n\t\t}\'\'\')\n\np.write_text(s)\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
