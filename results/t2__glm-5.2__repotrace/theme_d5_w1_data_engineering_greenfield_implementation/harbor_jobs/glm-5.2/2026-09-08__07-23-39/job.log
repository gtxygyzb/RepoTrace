)\n\tbuf.Write(b)\n}\n\nfunc writeOrderedIndent(buf *bytes.Buffer, v any, indent int) {\n\twriteOrderedIndentValue(buf, v, indent)\n}\n\nfunc writeOrderedIndentValue(buf *bytes.Buffer, v any, indent int) {\n\tswitch val := v.(type) {\n\tcase []orderedJSON:\n\t\twriteOrderedIndentObject(buf, val, indent)\n\tcase orderedArray:\n\t\twriteOrderedIndentArrayAny(buf, val, indent)\n\tcase []any:\n\t\twriteOrderedIndentArrayAny(buf, val, indent)\n\tcase string:\n\t\twriteJSONString(buf, val)\n\tcase int:\n\t\tfmt.Fprintf(buf, "%d", val)\n\tcase int64:\n\t\tfmt.Fprintf(buf, "%d", val)\n\tcase bool:\n\t\tif val {\n\t\t\tbuf.WriteString("true")\n\t\t} else {\n\t\t\tbuf.WriteString("false")\n\t\t}\n\tcase nil:\n\t\tbuf.WriteString("null")\n\tcase orderedJSON:\n\t\twriteOrderedIndentValue(buf, val.value, indent)\n\tdefault:\n\t\tb, _ := json.Marshal(val)\n\t\tbuf.Write(b)\n\t}\n}\n\nfunc writeOrderedIndentObject(buf *bytes.Buffer, entries []orderedJSON, indent int) {\n\tif len(entries) == 0 {\n\t\tbuf.WriteString("{}")\n\t\treturn\n\t}\n\tbuf.WriteByte(\'{\')\n\tbuf.WriteByte(\'\\n\')\n\tfor i, e := range entries {\n\t\twriteIndent(buf, indent+1)\n\t\twriteJSONString(buf, e.key)\n\t\tbuf.WriteString(": ")\n\t\twriteOrderedIndentValue(buf, e.value, indent+1)\n\t\tif i < len(entries)-1 {\n\t\t\tbuf.WriteByte(\',\')\n\t\t}\n\t\tbuf.WriteByte(\'\\n\')\n\t}\n\twriteIndent(buf, indent)\n\tbuf.WriteByte(\'}\')\n}\n\nfunc writeOrderedIndentArrayAny(buf *bytes.Buffer, arr []any, indent int) {\n\tif len(arr) == 0 {\n\t\tbuf.WriteString("[]")\n\t\treturn\n\t}\n\tbuf.WriteByte(\'[\')\n\tbuf.WriteByte(\'\\n\')\n\tfor i, v := range arr {\n\t\twriteIndent(buf, indent+1)\n\t\twriteOrderedIndentValue(buf, v, indent+1)\n\t\tif i < len(arr)-1 {\n\t\t\tbuf.WriteByte(\',\')\n\t\t}\n\t\tbuf.WriteByte(\'\\n\')\n\t}\n\twriteIndent(buf, indent)\n\tbuf.WriteByte(\']\')\n}\n\nfunc writeIndent(buf *bytes.Buffer, indent int) {\n\tfor i := 0; i < indent; i++ {\n\t\tbuf.WriteString("  ")\n\t}\n}\n\nfunc marshalOrderedIndent(v any) []byte {\n\tvar buf bytes.Buffer\n\twriteOrderedIndent(&buf, v, 0)\n\treturn buf.Bytes()\n}\n\ntype summaryField struct {\n\tkey   string\n\tvalue any\n}\n\nfunc parseSummaryFields(data []byte) ([]summaryField, error) {\n\tdec := json.NewDecoder(bytes.NewReader(data))\n\tdec.UseNumber()\n\ttok, err := dec.Token()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdelim, ok := tok.(json.Delim)\n\tif !ok || delim != \'{\' {\n\t\treturn nil, fmt.Errorf("summary output is not a JSON object")\n\t}\n\tvar fields []summaryField\n\tfor dec.More() {\n\t\tkeyTok, err := dec.Token()\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tkey, ok := keyTok.(string)\n\t\tif !ok {\n\t\t\treturn nil, fmt.Errorf("summary object key is not a string")\n\t\t}\n\t\tvar val any\n\t\tif err := dec.Decode(&val); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfields = append(fields, summaryField{key: key, value: val})\n\t}\n\tif _, err := dec.Token(); err != nil {\n\t\treturn nil, err\n\t}\n\treturn fields, nil\n}\n\nfunc classify(v any) string {\n\tswitch val := v.(type) {\n\tcase nil:\n\t\treturn "null"\n\tcase bool:\n\t\treturn "boolean"\n\tcase string:\n\t\treturn "string"\n\tcase json.Number:\n\t\ts := val.String()\n\t\tif !strings.ContainsAny(s, ".eE") {\n\t\t\treturn "integer"\n\t\t}\n\t\treturn "number"\n\tcase float64:\n\t\tif val == float64(int64(val)) {\n\t\t\treturn "integer"\n\t\t}\n\t\treturn "number"\n\tcase []any:\n\t\treturn "array"\n\tcase map[string]any:\n\t\treturn "object"\n\tdefault:\n\t\treturn "unknown"\n\t}\n}\n\nfunc descriptorFor(v any, depth int, strict bool) []orderedJSON {\n\tt := classify(v)\n\tentries := []orderedJSON{{key: "type", value: t}}\n\tswitch t {\n\tcase "array":\n\t\tarr := v.([]any)\n\t\tvar elementType any\n\t\tif len(arr) == 0 {\n\t\t\tif strict {\n\t\t\t\telementType = []orderedJSON{{key: "type", value: "unknown"}}\n\t\t\t} else {\n\t\t\t\telementType = nil\n\t\t\t}\n\t\t} else {\n\t\t\telementType = classify(arr[0])\n\t\t