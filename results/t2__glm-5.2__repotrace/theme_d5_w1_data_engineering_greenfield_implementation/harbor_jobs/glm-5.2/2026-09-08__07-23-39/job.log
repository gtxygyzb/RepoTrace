nfunc buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {\n  out := stateFileOut{Version: 1, SeenIDs: seenIDs, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}\n  if hasCurrentMax {\n    s := formatTS(currentMax)\n    out.Watermark.MaxTS = &s\n  } else if st != nil && st.hasMax {\n    s := formatTS(st.maxTs)\n    out.Watermark.MaxTS = &s\n  }\n  b, _ := json.MarshalIndent(out, "", "  ")\n  b = append(b, \'\\n\')\n  return b\n}\n\nfunc statePendingOutList(pending []pendingEntry) []statePendingOut {\n  out := make([]statePendingOut, 0, len(pending))\n  for _, p := range pending {\n    out = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), User: p.user, USD: Money(p.usd), OriginRun: p.originRun})\n  }\n  return out\n}\n\nfunc stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {\n  out := make([]stateOpenSessionOut, 0, len(sessions))\n  for _, s := range sessions {\n    out = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})\n  }\n  return out\n}\n\nfunc sortedSeenIDs(seen map[string]bool) []string {\n  ids := make([]string, 0, len(seen))\n  for id := range seen {\n    ids = append(ids, id)\n  }\n  sort.Strings(ids)\n  return ids\n}\n\nfunc sortedPending(pending []pendingEntry) []pendingEntry {\n  out := append([]pendingEntry(nil), pending...)\n  sort.SliceStable(out, func(i, j int) bool {\n    if out[i].ts.Equal(out[j].ts) {\n      return out[i].id < out[j].id\n    }\n    return out[i].ts.Before(out[j].ts)\n  })\n  return out\n}\n\nfunc sortedOpenSessions(m map[string]carriedSession) []carriedSession {\n  out := make([]carriedSession, 0, len(m))\n  for _, s := range m {\n    out = append(out, s)\n  }\n  sort.SliceStable(out, func(i, j int) bool {\n    if out[i].lastTs.Equal(out[j].lastTs) {\n      return out[i].user < out[j].user\n    }\n    return out[i].lastTs.Before(out[j].lastTs)\n  })\n  return out\n}\n\nfunc sortedCarriedSessions(m map[string]carriedSession) []carriedSession {\n  return sortedOpenSessions(m)\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
