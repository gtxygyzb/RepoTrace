nding {\n      p.pendingByID[p.pending[i].id] = &p.pending[i]\n    }\n    for u, s := range st.openSessions {\n      p.openSessions[u] = s\n    }\n    p.runIndex = st.runIndex\n    p.hasMax = st.hasMax\n    p.maxTs = st.maxTs\n    p.stats.CarryInPending = st.carryInPending\n    p.stats.CarryInOpenSessions = st.carryInOpenSessions\n  }\n  if maxOpenSessions <= 0 {\n    p.maxOpenSessions = 0\n  }\n  return p\n}\n\nfunc copyStringBoolMap(m map[string]bool) map[string]bool {\n  out := make(map[string]bool, len(m))\n  for k, v := range m {\n    out[k] = v\n  }\n  return out\n}\n\nfunc (p *processor) currentCutoff() string {\n  if p.hasMax {\n    return formatTS(p.maxTs.Add(-p.watermarkLag))\n  }\n  return ""\n}\n\nfunc (p *processor) updateMax(t time.Time) {\n  if !p.hasMax || t.After(p.maxTs) {\n    p.maxTs = t\n    p.hasMax = true\n  }\n}\n\nfunc (p *processor) processEvents(raws []rawEvent) ([]*Event, []Reject, []auditRecord) {\n  var accepted []*Event\n  var rejects []Reject\n  var audits []auditRecord\n  for _, raw := range raws {\n    ctx := newContext(raw)\n    ev, invalidReason := parseEvent(ctx, p.rt)\n    if ev == nil {\n      rec := auditRecord{Bucket: "invalid", Reason: invalidReason, Raw: ctx}\n      rejects = append(rejects, Reject{Bucket: 1, Reason: invalidReason, Event: ctx.Raw})\n      audits = append(audits, rec)\n      continue\n    }\n    if p.seenIds[ev.ID] {\n      rec := auditRecord{Bucket: "duplicate", Reason: "cross_run", Raw: ctx}\n      rejects = append(rejects, Reject{Bucket: 2, Reason: "cross_run", Event: ctx.Raw})\n      audits = append(audits, rec)\n      continue\n    }\n    if p.sameRunSeen[ev.ID] {\n      rec := auditRecord{Bucket: "duplicate", Reason: "same_run", Raw: ctx}\n      rejects = append(rejects, Reject{Bucket: 2, Reason: "same_run", Event: ctx.Raw})\n      audits = append(audits, rec)\n      continue\n    }\n    cutoff := p.currentCutoff()\n    if p.hasMax && ev.TS.Before(p.maxTs.Add(-p.watermarkLag)) {\n      rec := auditRecord{Bucket: "late", Cutoff: cutoff, Raw: ctx}\n      rejects = append(rejects, Reject{Bucket: 3, Reason: "late", Event: ctx.Raw})\n      audits = append(audits, rec)\n      continue\n    }\n    p.sameRunSeen[ev.ID] = true\n    p.updateMax(ev.TS)\n    acceptedEvent, audit := p.acceptEvent(ctx, ev)\n    accepted = append(accepted, acceptedEvent)\n    audits = append(audits, audit)\n  }\n  return accepted, rejects, audits\n}\n\nfunc (p *processor) acceptEvent(ctx *eventContext, ev *Event) (*Event, auditRecord) {\n  p.handleSession(ev)\n  rec := auditRecord{Bucket: "accepted", USD: ev.USD, SessionIndex: ev.sessionIndex, ResolvedAgainst: nil, Raw: ctx}\n  switch ev.Type {\n  case "purchase":\n    pe := pendingEntry{id: ev.ID, ts: ev.TS, user: ev.UserID, usd: ev.USD, originRun: p.runIndex + 1}\n    p.pending = append(p.pending, pe)\n    p.pendingByID[ev.ID] = &p.pending[len(p.pending)-1]\n  case "refund":\n    pe := pendingEntry{id: ev.ID, ts: ev.TS, user: ev.UserID, usd: ev.USD, originRun: p.runIndex + 1}\n    p.pending = append(p.pending, pe)\n    p.pendingByID[ev.ID] = &p.pending[len(p.pending)-1]\n  case "chargeback":\n    resolved := p.resolveChargeback(ev)\n    if resolved == "" {\n      rec.Bucket = "unresolved_chargeback"\n      rec.RefID = ev.RefID\n      p.stats.Anomalies? // placeholder\n    } else {\n      rec.ResolvedAgainst = &resolved\n    }\n  }\n  return ev, rec\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
