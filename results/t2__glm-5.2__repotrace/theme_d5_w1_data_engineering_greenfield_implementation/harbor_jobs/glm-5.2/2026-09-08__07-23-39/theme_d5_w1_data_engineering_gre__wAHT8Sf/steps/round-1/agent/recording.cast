[12700.566165, "o", "\t\t\tbucket = \"invalid\"\r\n\t\t\treason = \"invalid_json\"\r\n\t\t} else {\r\n\t\t\tev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)\r\n\t\t\tif ev != nil {\r\n\t\t\t\tif seen[ev.ID] {\r\n\t\t\t\t\tbucket = \"duplicate\"\r\n\t\t\t\t\treason = \"cross_run\"\r\n\t\t\t\t\tev = nil\r\n\t\t\t\t} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {\r\n\t\t\t\t\tbucket = \"late\"\r\n\t\t\t\t\treason = \"late\"\r\n\t\t\t\t\tcutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)\r\n"]
[12700.566259, "o", "\t\t\t\t\tentry := auditLogEntry{\r\n\t\t\t\t\t\tShard:  raw.Shard,\r\n\t\t\t\t\t\tLine:   raw.Line,\r\n\t\t\t\t\t\tID:     ctx.IDStr(),\r\n\t\t\t\t\t\tTS:     ctx.TSString(),\r\n\t\t\t\t\t\tType:   ctx.TypeString(),\r\n\t\t\t\t\t\tBucket: bucket,\r\n\t\t\t\t\t\tCutoff: ptrCutoff(formatCutoffObject(cutoff)),\r\n"]
[12700.566317, "o", "\t\t\t\t\t}\r\n\t\t\t\t\tif cfg.strictLateAudit {\r\n\t\t\t\t\t\tlag := cfg.watermarkLag\r\n\t\t\t\t\t\tlateBy := int(entry.Cutoff.EpochSeconds - int(epochSeconds(ev.TS)))\r\n\t\t\t\t\t\tentry.WatermarkLagSeconds = &lag\r\n\t\t\t\t\t\tentry.LateBySeconds = &lateBy\r\n\t\t\t\t\t}\r\n\t\t\t\t\tauditEntries = append(auditEntries, entry)\r\n"]
[12700.566373, "o", "\t\t\t\t\tev = nil\r\n\t\t\t\t} else {\r\n\t\t\t\t\tbucket = \"accepted\"\r\n\t\t\t\t\tif ev.TS.After(watermark) {\r\n\t\t\t\t\t\twatermark = ev.TS\r\n\t\t"]
