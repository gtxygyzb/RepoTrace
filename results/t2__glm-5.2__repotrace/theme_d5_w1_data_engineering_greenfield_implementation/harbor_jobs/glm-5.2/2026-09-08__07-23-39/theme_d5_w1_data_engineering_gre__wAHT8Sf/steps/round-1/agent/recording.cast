[14586.427711, "o", "   263\t\t\treturn err\r\n   264\t\t}\r\n   265\t\tvar st *loadedState\r\n   266\t\trunIndex := 1\r\n   267\t\tif cfg.stateIn != \"\" {\r\n   268\t\t\tst, err = loadState(cfg.stateIn, cfg.stateStrict)\r\n   269\t\t\tif err != nil && !os.IsNotExist(err) {\r\n   270\t\t\t\treturn err\r\n   271\t\t\t}\r\n   272\t\t\tif st != nil {\r\n   273\t\t\t\trunIndex = st.runIndex + 1\r\n   274\t\t\t}\r\n   275\t\t}\r\n   276\t\tevents, shards, err := readInputEvents(cfg.inputDir)\r\n   277\t\tif err != nil {\r\n   278\t\t\treturn err\r\n   279\t\t}\r\n   280\t\tseen := map[string]bool{}\r\n   281\t\tif st != nil {\r\n   282\t\t\tfor k, v := range st.seenIds {\r\n   283\t\t\t\tseen[k] = v\r\n   284\t\t\t}\r\n   285\t\t}\r\n   286\t\tvar pending []pendingEntry\r\n   287\t\topenSessions := map[string]carriedSession{}\r\n   288\t\tif st != nil {\r\n"]
[14586.427802, "o", "   289\t\t\tpending = append([]pendingEntry(nil), st.pending...)\r\n   290\t\t\tfor k, v := range st.openSessions {\r\n   291\t\t\t\topenSessions[k] = v\r\n   292\t\t\t}\r\n   293\t\t}\r\n   294\t\tbucketCounts := map[string]int{\"accepted\": 0, \"duplicate\": 0, \"invalid\": 0, \"late\": 0, \"unresolved_chargeback\": 0}\r\n   295\t\tinvalidReasons := map[string]int{}\r\n   296\t\tduplicateReasons := map[string]int{\"same_run\": 0, \"cross_run\": 0}\r\n   297\t\tfxFallbackStats := map[string]int{\"0\": 0}\r\n   298\t\tshardAccepted := map[string]int{}\r\n   299\t\tvar minTs, maxTs time.Time\r\n   300\t\thasMin, hasMax := false, false\r\n   301\t\tvar watermark time.Time\r\n"]
[14586.427887, "o", "   302\t\thasWatermark := false\r\n   303\t\tif st != nil {\r\n   304\t\t\twatermark = st.maxTs\r\n   305\t\t\thasWatermark = st.hasMax\r\n   306\t\t}\r\n   307\t\r\n   308\t\ttype candidate struct {\r\n   309\t\t\traw       rawEvent\r\n   310\t\t\tctx       *eventContext\r\n   311\t\t\tev        *Event\r\n   312\t\t\tduplicate bool\r\n   313\t\t}\r\n   314\t\tvar candidates []candidate\r\n"]
