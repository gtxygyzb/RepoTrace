[11880.884309, "o", "    90\t\t\tcase \"--session-gap\":\r\n    91\t\t\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\r\n    92\t\t\tcase \"--watermark-lag\":\r\n    93\t\t\t\tcfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")"]
[11880.884414, "o", "\r\n    94\t\t\tcase \"--state-in\":\r\n    95\t\t\t\tcfg.stateIn = nextArg(args, &i)\r\n    96\t\t\tcase \"--state-out\":\r\n    97\t\t\t\tcfg.stateOut = nextArg(args, &i)\r\n    98\t\t\tcase \"--pending-ttl\":\r\n    99\t\t\t\tcfg.pendingTTL = atoiOrError(nextArg(args, &i), \"--pending-ttl\")\r\n   100\t\t\tcase \"--max-open-sessions\":\r\n   101\t\t\t\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-sessions\")\r\n   102\t\t\tcase \"--audit-log\":\r\n   103\t\t\t\tcfg.auditLog = nextArg(args, &i)\r\n   104\t\t\tcase \"--audit-log-digest\":\r\n   105\t\t\t\tcfg.auditLogDigest = nextArg(args, &i)\r\n   106\t\t\tcase \"--rates-strict\":\r\n   107\t\t\t\tcfg.ratesStrict = true\r\n   108"]
[11880.884487, "o", "\t\t\tcase \"--rates-max-staleness\":\r\n   109\t\t\t\tcfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), \"--rates-max-staleness\")\r\n   110\t\t\tcase \"--ingest-id\":\r\n   111\t\t\t\tcfg.ingestID = nextArg(args, &i)\r\n   112\t\t\t\tcfg.ingestIDSet = true\r\n   113\t\t\tcase \"--out-parquet-manifest\":\r\n   114\t\t\t\tcfg.outManifest = nextArg(args, &i)\r\n   115\t\t\tcase \"--manifest-signature\":\r\n   116\t\t\t\tcfg.manifestSignature = nextArg(args, &i)\r\n   117\t\t\tcase \"--dedup-policy\":\r\n   118\t\t\t\tval := nextArg(args, &i)\r\n"]
[11880.884554, "o", "   119\t\t\t\tif val != \"first-arrival\" && val != \"lex-largest-ts\" {\r\n   120\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --dedup-policy: must be one of {first-arrival, lex-largest-ts}\")\r\n   121\t\t\t\t}\r\n   122\t\t\t\tcfg.dedupPolicy = val\r\n   123\t\t\t\tcfg.dedupPolicySet = true\r\n   124\t\t\tdefault:\r\n   125\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: unknown flag %s\", arg)\r\n   126\t\t\t}\r\n"]
[11880.884619, "o", "   127\t\t\tif strings.HasPrefix(arg, \"--\") && arg != \"--rates-strict\" && arg != \"--strict-late-audit\" && arg != \"--state-strict\" {\r\n   128\t\t\t\tif _, ok := required[arg]; ok {\r\n   129\t\t\t\t\trequired[arg] = true\r\n   130\t\t\t\t}\r\n   131\t\t\t}\r\n   132\t\t}\r\n   133\t\tfor k, ok := range required {\r\n   134\t\t\tif !ok {\r\n   135\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: %s is required\", k)\r\n"]
