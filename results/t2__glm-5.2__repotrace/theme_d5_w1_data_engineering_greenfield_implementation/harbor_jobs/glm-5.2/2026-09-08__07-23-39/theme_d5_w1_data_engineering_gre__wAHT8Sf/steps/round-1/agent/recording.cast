[5476.537886, "o", "    27\tfunc (m Money) String() string {\r\n    28\t  f := float64(m)\r\n    29\t  abs := math.Abs(f)\r\n    30\t  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n    31\t  neg := f < 0 && cents != 0\r\n    32\t  dollars := cents / 100\r\n    33\t  rem := cents % 100\r\n    34\t  s := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n    35\t  if neg {\r\n    36\t    s = \"-\" + s\r\n    37\t  }\r\n    38\t  return s\r\n    39\t}\r\n    40\t\r\n    41\ttype Event struct {\r\n    42\t  ID       string\r\n    43\t  Type     string\r\n    44\t  TS       time.Time\r\n    45\t  UserID   string\r\n"]
