[18143.855253, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/sha256\"\r\n     5"]
[18143.855344, "o", "\t\t\"encoding/hex\"\r\n     6\t\t\"encoding/json\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"math\"\r\n     9\t\t\"os\"\r\n    10\t\t\"path/filepath\"\r\n    11\t\t\"strings\"\r\n    12\t\t\"time\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc rawStringPtr(obj map[string]json.RawMessage, key string) *string {\r\n    16\t\tif obj == nil {\r\n    17\t\t\treturn nil\r\n"]
[18143.855416, "o", "    18\t\t}\r\n    19\t\traw, ok := obj[key]\r\n    20\t\tif !ok {\r\n    21\t\t\treturn nil\r\n    22\t\t}\r\n    23\t\tvar s string\r\n    24\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n    25\t\t\treturn nil\r\n    26\t\t}\r\n    27\t\treturn &s\r\n    28\t}\r\n"]
[18143.855475, "o", "    29\t\r\n    30\tfunc getRawString(obj map[string]json.RawMessage, key string) (string, bool, bool) {\r\n    31\t\tif obj == nil {\r\n    32\t\t\treturn \"\", false, false\r\n    33\t\t}\r\n    34\t\traw, present := obj[key]\r\n    35\t\tif !present {\r\n    36\t\t\treturn \"\", false, false\r\n    37\t\t}\r\n    38"]
[18143.855553, "o", "\t\tvar s string\r\n    39\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n    40\t\t\treturn \"\", false, true\r\n    41\t\t}\r\n    42\t\treturn s, true, true\r\n    43\t}\r\n    44\t\r\n    45\tfunc getJSONInt(raw json.RawMessage) (int, error) {\r\n    46\t\tvar n int\r\n    47\t\tif err := json.Unmarshal(raw, &n); err != nil {\r\n    48\t\t\treturn 0, err\r\n    49\t\t}\r\n    50\t\treturn n, nil\r\n"]
[18143.855616, "o", "    51\t}\r\n    52\t\r\n    53\tfunc parseTime(s string) (time.Time, error) {\r\n    54\t\ts = strings.TrimSpace(s)\r\n    55\t\tif strings.HasSuffix(s, \"Z\") {\r\n    56\t\t\tif t, err := time.Parse(\"2006-01-02T15:04:05Z\", s); err == nil {\r\n    57\t\t\t\treturn t.UTC(), nil\r\n    58\t\t\t}\r\n    59\t\t\tif t, err := time.Parse(\"2006-01-02T15:04:05.000000000Z\", s); err == nil {\r\n    60\t\t\t\treturn t.UTC(), nil\r\n"]
[18143.855675, "o", "    61\t\t\t}\r\n    62\t\t}\r\n    63\t\tif t, err := time.Parse(time.RFC3339Nano, s); err == nil {\r\n    64\t\t\treturn t.UTC(), nil\r\n    65\t\t}\r\n    66\t\tif t, err := time.Parse(time.RFC3339, s); err == nil {\r\n    67\t\t\treturn t.UTC(), nil\r\n    68\t\t}\r\n    69\t\treturn time.Time{}, fmt.Errorf(\"bad timestamp: %s\", s)\r\n    70\t}"]
[18143.855733, "o", "\r\n    71\t\r\n    72\tfunc formatTS(t time.Time) string {\r\n    73\t\treturn t.UTC().Format(\"2006-01-02T15:04:05Z\")\r\n    74\t}\r\n    75\t\r\n    76\tfunc epochSeconds(t time.Time) int64 {\r\n    77\t\treturn t.UTC().Unix()\r\n    78\t}\r\n    79\t\r\n    80\t"]
[18143.855803, "o", "func formatCutoffObject(cutoff time.Time) cutoffObject {\r\n    81\t\tepoch := epochSeconds(cutoff)\r\n    82\t\tif epoch < 0 {\r\n    83\t\t\tepoch = 0\r\n    84\t\t\tcutoff = time.Unix(0, 0).UTC()\r\n    85\t\t}\r\n    86\t\treturn cutoffObject{Value: formatTS(cutoff), EpochSeconds: int(epoch)}\r\n    87\t}\r\n    88\t\r\n    89\tfunc dateKey(t time.Time) string {\r\n    90\t\treturn t.UTC().Format(\"2006-01-02\")\r\n"]
[18143.855865, "o", "    91\t}\r\n    92\t\r\n    93\tfunc roundMoney(v float64) float64 {\r\n    94\t\tcents := int64(math.Floor(math.Abs(v)*100.0 + 0.5))\r\n    95\t\tif v < 0 && cents != 0 {\r\n    96\t\t\treturn -float64(cents) / 100.0\r\n    97\t\t}\r\n    98\t\treturn float64(cents) / 100.0\r\n    99\t}\r\n   100\t\r\n"]
[18143.855927, "o", "   101\tfunc isFinite(f float64) bool {\r\n   102\t\treturn !math.IsNaN(f) && !math.IsInf(f, 0)\r\n   103\t}\r\n   104\t\r\n   105\tfunc isDate(s string) bool {\r\n   106\t\tif _, err := time.Parse(\"2006-01-02\", s); err != nil {\r\n   107\t\t\treturn false\r\n   108\t\t}\r\n   109\t\treturn true\r\n   110\t}\r\n   111\t\r\n   112"]
[18143.855986, "o", "\tfunc sha256Hex(data []byte) string {\r\n   113\t\tsum := sha256.Sum256(data)\r\n   114\t\treturn hex.EncodeToString(sum[:])\r\n   115\t}\r\n   116\t\r\n   117\tfunc sha256Short(h string) string {\r\n   118\t\tif len(h) < 12 {\r\n   119\t\t\treturn h\r\n   120\t\t}\r\n   121\t\treturn h[:12]\r\n"]
[18143.856052, "o", "   122\t}\r\n   123\t\r\n   124\tfunc fileDigest(path string) (string, int64, error) {\r\n   125\t\tdata, err := os.ReadFile(path)\r\n   126\t\tif err != nil {\r\n   127\t\t\treturn \"\", 0, err\r\n   128\t\t}\r\n   129\t\treturn sha256Hex(data), int64(len(data)), nil\r\n   130\t}\r\n   131\t\r\n   132\tfunc atomicWriteFile(path string, data []byte) error {\r\n"]
[18143.856114, "o", "   133\t\ttmp := path + \".tmp\"\r\n   134\t\tif err := os.WriteFile(tmp, data, 0644); err != nil {\r\n   135\t\t\treturn err\r\n   136\t\t}\r\n   137\t\tif err := os.Rename(tmp, path); err != nil {\r\n   138\t\t\t_ = os.Remove(tmp)\r\n   139\t\t\treturn err\r\n   140\t\t}\r\n   141\t\treturn nil\r\n   142\t}\r\n"]
[18143.85617, "o", "   143\t\r\n   144\tfunc parentDirExists(path string) bool {\r\n   145\t\tdir := filepath.Dir(path)\r\n   146\t\tif dir == \".\" || dir == \"\" {\r\n   147\t\t\treturn true\r\n   148\t\t}\r\n   149\t\tinfo, err := os.Stat(dir)\r\n   150\t\tif err != nil {\r\n"]
[18143.85626, "o", "   151\t\t\treturn false\r\n   152\t\t}\r\n   153\t\treturn info.IsDir()\r\n   154\t}\r\n   155\t\r\n   156\tfunc manifestFileOutputFor(path string) (*manifestFileOutput, error) {\r\n   157\t\th, b, err := fileDigest(path)\r\n   158\t\tif err != nil {\r\n   159\t\t\treturn nil, err\r\n   160\t\t}\r\n"]
[18143.856318, "o", "   161\t\treturn &manifestFileOutput{\r\n   162\t\t\tPath:        filepath.Base(path),\r\n   163\t\t\tSHA256:      h,\r\n   164\t\t\tSHA256Short: sha256Short(h),\r\n   165\t\t\tBytes:       b,\r\n   166\t\t}, nil\r\n   167\t}\r\n   168\t\r\n   169\tfunc ptrString(s string) *string {\r\n   170\t\treturn &s\r\n"]
[18143.856418, "o", "   171\t}\r\n   172\t\r\n   173\tfunc (ctx *eventContext) IDStr() string {\r\n   174\t\tif ctx.ID != nil {\r\n   175\t\t\treturn *ctx.ID\r\n   176\t\t}\r\n   177\t\treturn \"\"\r\n   178\t}\r\n   179\t\r\n   180\tfunc (ctx *eventContext) TSString() string {\r\n   181\t\tif ctx.TS != nil {\r\n   182\t\t\treturn *ctx.TS\r\n   183\t\t}\r\n   184\t\treturn \"\"\r\n   185\t}"]
[18143.856528, "o", "\r\n   186\t\r\n   187\tfunc (ctx *eventContext) TypeString() string {\r\n   188\t\tif ctx.Type != nil {\r\n   189\t\t\treturn *ctx.Type\r\n   190\t\t}\r\n   191\t\treturn \"\"\r\n   192\t}\r\n"]
