[12754.864743, "o", "r := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, raw: c.raw.Raw}\r\n   436\t\t\t\trejectRecords = append(rejectRecords, r)\r\n   437\t\t\t\tcontinue\r\n   438\t\t\t}\r\n   439\t\t\tif winnerSet[i] {\r\n   440\t\t\t\tcontinue\r\n   441\t\t\t}\r\n   442\t\t\tr := rejectRecord{bucket: \"duplicate\", reason: \"same_run\", raw: c.raw.Raw}\r\n   443\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n   444"]
[12754.864806, "o", "\t\t\t\tr.winner = true\r\n   445\t\t\t\tr.winnerShard = candidates[winners[c.ev.ID]].ev.Shard\r\n   446\t\t\t\tr.winnerLine = candidates[winners[c.ev.ID]].ev.Line\r\n   447\t\t\t}\r\n   448\t\t\trejectRecords = append(rejectRecords, r)\r\n   449\t\t}\r\n   450\t\r\n   451\t\tsummary := summaryOutput{\r\n   452\t\t\tTotalEvents:    len(events),\r\n"]
[12754.864895, "o", "   453\t\t\tAcceptedEvents: bucketCounts[\"accepted\"],\r\n   454\t\t\tRejectedEvents: bucketCounts[\"duplicate\"] + bucketCounts[\"invalid\"] + bucketCounts[\"late\"] + bucketCounts[\"unresolved_chargeback\"],\r\n   455\t\t\tAnomalies: map[string]int{\r\n   456\t\t\t\t\"duplicate\":             bucketCounts[\"duplicate\"],\r\n   457\t\t\t\t\"invalid\":               bucketCounts[\"invalid\"],\r\n"]
[12754.864958, "o", "   458\t\t\t\t\"late\":                  bucketCounts[\"late\"],\r\n   459\t\t\t\t\"unresolved_chargeback\": bucketCounts[\"unresolved_chargeback\"],\r\n   460\t\t\t},\r\n   461\t\t\tRunIndex: runIndex,\r\n   462\t\t}\r\n   463\t\tif hasWatermark {\r\n   464\t\t\twm := formatTS(watermark)\r\n   465\t\t\tsummary.Watermark = &wm\r\n   466\t\t}\r\n   467\t\tsummaryData, err := json.MarshalIndent(summary, \"\", \"  \")\r\n   468\t\tif err != nil {\r\n   469\t\t\treturn err\r\n   470\t\t}\r\n   471\t\tsummaryData = append(summaryData, '\\n')\r\n   472\t\tif err := atomicWriteFile(cfg.outputPath, summaryData); err != nil {\r\n   473\t\t\treturn err\r\n   474\t\t}\r\n   475\t\trejectsData := buildRejects(rejectRecords, cfg.dedupPolicy)\r\n"]
[12754.865023, "o", "   476\t\tif err := atomicWriteFile(cfg.rejectsPath, rejectsData); err != nil {\r\n   477\t\t\treturn err\r\n   478\t\t}\r\n   479\t\tif cfg.stateOut != \"\" {\r\n   480\t\t\tstateData := buildStateOut(watermark, hasWatermark, st, sortedSeenIDs(seen), sortedPending(pending), sortedOpenSessions(openSessions), runIndex)\r\n   481\t\t\tif err := atomicWriteFile(cfg.stateOut, stateData); err != nil {\r\n   482\t\t\t\treturn err\r\n   483\t\t\t}\r\n"]
[12754.86508, "o", "   484\t\t}\r\n   485\t\tvar auditSegmentPaths []string\r\n   486\t\tif cfg.auditLog != \"\" {\r\n   487\t\t\tauditSegmentPaths = writeAuditLog(cfg.auditLog, auditEntries, cfg.auditLogRotateBytes)\r\n   488\t\t}\r\n   489\t\tif cfg.auditLogDigest != \"\" {\r\n"]
[12754.865137, "o", "   490\t\t\tdigest := auditDigestOutput{\r\n   491\t\t\t\tSchemaVersion:    \"eventq.digest/v1\",\r\n   492\t\t\t\tTotalRecords:     len(auditEntries),\r\n   493\t\t\t\tBucketCounts:     bucketCounts,\r\n   494\t\t\t\tInvalidReasons:   invalidReasons,\r\n   495\t\t\t\tDuplicateReasons: duplicateReasons,\r\n"]
