[11874.059023, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K481\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tauditSegmentPaths = \u001b[01;31m\u001b[KwriteAuditLog\u001b[m\u001b[K(cfg.auditLog, auditEntries, cfg.\u001b[01;31m\u001b[KauditLogRotateBytes\u001b[m\u001b[K)\r\n"]
[11874.059177, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K490\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[KLateCutoffStats\u001b[m\u001b[K:  \u001b[01;31m\u001b[KcomputeLateCutoffStats\u001b[m\u001b[K(auditEntries),\r\n"]
[11874.059242, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K552\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KwriteAuditLog\u001b[m\u001b[K(path string, entries []auditLogEntry, rotateBytes int) []string {\r\n"]
[11874.059371, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K597\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcomputeLateCutoffStats\u001b[m\u001b[K(entries []auditLogEntry) late\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[KStats {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K598\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tstats := late\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[KStats{}\r\n"]
[11874.059431, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K600\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif e.Bucket == \"late\" && e.\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[K != nil {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K602\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tstats.Min\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[KEpoch = e.\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[K.EpochSeconds\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K603\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tstats.Max\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[KEpoch = e.\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[K.EpochSeconds\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K605\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif e.\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[K.EpochSeconds < stats.Min\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[KEpoch {\r\n"]
[11874.059493, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K606\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tstats.Min\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[KEpoch = e.\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[K.EpochSeconds\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K608\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif e.\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[K.EpochSeconds > stats.Max\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[KEpoch {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K609\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\tstats.Max\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[KEpoch = e.\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[K.EpochSeconds\r\n"]
[11874.059623, "o", "\u001b[35m\u001b[Khelpers.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc format\u001b[01;31m\u001b[KCutoff\u001b[m\u001b[KObject(cutoff time.Time) cutoffObject {\r\n"]
