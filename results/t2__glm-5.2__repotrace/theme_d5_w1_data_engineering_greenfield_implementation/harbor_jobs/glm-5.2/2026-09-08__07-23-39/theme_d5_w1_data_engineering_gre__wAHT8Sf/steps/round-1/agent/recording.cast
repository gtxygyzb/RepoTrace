[16534.017255, "o", "\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut = strings.TrimPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out=\")\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut == \"\" {\r\n\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out: value must be non-empty\")\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif strings.HasPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-digest=\") {\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest = strings.TrimPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-digest=\")\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest == \"\" {\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-digest: value must be non-empty\")\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif strings.HasPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-index=\") {\r\n"]
