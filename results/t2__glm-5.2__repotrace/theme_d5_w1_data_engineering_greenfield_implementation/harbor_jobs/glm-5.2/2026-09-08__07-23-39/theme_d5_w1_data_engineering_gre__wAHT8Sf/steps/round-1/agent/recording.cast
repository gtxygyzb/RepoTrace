[16306.106651, "o", "\u001b[?2004l\r"]
[16306.109824, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t\"errors\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n\t\"os\"\r\n"]
[16306.109885, "o", "\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\nvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--state-strict] [--audit-log <path>] [--audit-log-digest <path>] [--audit-log-rotate-bytes <int>] [--rates-strict] [--rates-max-staleness <seconds>] [--ingest-id <string>] [--out-parquet-manifest <path>] [--manifest-signature <path>] [--dedup-policy <first-arrival|lex-largest-ts>] [--strict-late-audit] [--summary-schema-out <path>] [--summary-schema-digest <path>] [--summary-schema-strict] [--summary-schema-index <path>] [--rejects-format <legacy|tagged|tagged-sorted>] [--rejects-format-header]\\n\"\r\n\r\ntype Money float64\r\n"]
[16306.109937, "o", "\r\nfunc (m Money) MarshalJSON() ([]byte, error) {\r\n\treturn []byte(m.String()), nil\r\n}\r\n\r\nfunc (m Money) String() string {\r\n\tf := float64(m)\r\n"]
[16306.109984, "o", "\tabs := math.Abs(f)\r\n\tcents := int64(math.Floor(abs*100.0 + 0.5))\r\n\tneg := f < 0 && cents != 0\r\n\tdollars := cents / 100\r\n\trem := cents % 100\r\n\ts := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n"]
[16306.110032, "o", "\tif neg {\r\n\t\ts = \"-\" + s\r\n\t}\r\n\treturn s\r\n}\r\n\r\n"]
[16306.110081, "o", "type Event struct {\r\n\tID                string\r\n\tType              string\r\n\tTS                time.Time\r\n\tUserID            string\r\n\tAmount            float64\r\n\tCurrency          string\r\n\tRefID             string"]
[16306.110123, "o", "\r\n\tUSD               float64\r\n\tRefUSD            float64\r\n\tFXFallbackDays    int\r\n\tResolvedAgainst   *string\r\n"]
[16306.110169, "o", "\tResolvedOriginRun int\r\n\tSessionIndex      int\r\n\tRaw               rawJSON\r\n\tShard             string\r\n\tLine              int\r\n"]
[16306.11023, "o", "}\r\n\r\ntype Reject struct {\r\n\tBucket int     `json:\"bucket\"`\r\n\tEvent  rawJSON `json:\"event\"`\r\n}\r\n\r\ntype ShardLine struct {\r\n\tShard string\r\n"]
[16306.110276, "o", "\tLine  int\r\n\tData  []byte\r\n}\r\n\r\ntype RateTable struct {\r\n"]
[16306.110321, "o", "\tbase  string\r\n\tdays  map[string]map[string]float64\r\n\tknown map[string]bool\r\n}\r\n\r\nfunc newRateTable() *RateTable {\r\n"]
[16306.110367, "o", "\treturn &RateTable{base: \"USD\", days: map[string]map[string]float64{}, known: map[string]bool{}}\r\n}\r\n\r\nfunc isUsableRate(f float64) bool {\r\n\treturn isFinite(f) && f > 0\r\n}\r\n"]
[16306.110415, "o", "\r\nfunc parseRateNumber(raw json.RawMessage) (float64, error) {\r\n\tif bytes.Equal(bytes.TrimSpace(raw), []byte(\"null\")) {\r\n\t\treturn 0, errors.New(\"non-numeric rate\")\r\n\t}\r\n\tvar f float64\r\n"]
[16306.110461, "o", "\tif err := json.Unmarshal(raw, &f); err != nil {\r\n\t\treturn 0, errors.New(\"non-numeric rate\")\r\n\t}\r\n\treturn f, nil\r\n}\r\n\r\n"]
[16306.110507, "o", "func sortedKeys[T any](m map[string]T) []string {\r\n\tkeys := make([]string, 0, len(m))\r\n\tfor k := range m {\r\n\t\tkeys = append(keys, k)\r\n"]
[16306.110552, "o", "\t}\r\n\tsort.Strings(keys)\r\n\treturn keys\r\n}\r\n\r\nfunc isStrictDate(s string) bool {\r\n"]
[16306.110598, "o", "\tif len(s) != 10 {\r\n\t\treturn false\r\n\t}\r\n\tfor i, c := range s {\r\n\t\tif i == 4 || i == 7 {\r\n\t\t\tif c != '-' {\r\n"]
[16306.110645, "o", "\t\t\t\treturn false\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\t"]
[16306.110684, "o", "if c < '0' || c > '9' {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n"]
[16306.110726, "o", "\treturn true\r\n}\r\n\r\nfunc dayEpoch(date string) time.Time {\r\n\tt, err := time.Parse(\"2006-01-02\", date)\r\n\tif err != nil {\r\n\t\treturn time.Time{}\r\n"]
[16306.110767, "o", "\t}\r\n\treturn t.UTC()\r\n}\r\n\r\n"]
[16306.110807, "o", "func calendarDayDiff(rateDate, eventDate string) int {\r\n\tr := dayEpoch(rateDate)\r\n\te := dayEpoch(eventDate)\r\n\tif r.IsZero() || e.IsZero() {\r\n\t\treturn 0\r\n"]
[16306.110849, "o", "\t}\r\n\treturn int(r.Sub(e) / (24 * time.Hour))\r\n}\r\n\r\nfunc absInt(v int) int {\r\n\tif v < 0 {\r\n"]
[16306.110896, "o", "\t\treturn -v\r\n\t}\r\n\treturn v\r\n}\r\n\r\n"]
[16306.110942, "o", "func absInt64(v int64) int64 {\r\n\tif v < 0 {\r\n\t\treturn -v\r\n\t}\r\n\treturn v\r\n"]
[16306.110984, "o", "}\r\n\r\nfunc (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {\r\n\tif !rt.known[currency] {\r\n\t\treturn 0, 0, \"fx_unknown_currency\"\r\n\t}\r\n"]
[16306.111032, "o", "\tif m, ok := rt.days[date]; ok {\r\n\t\tif r, ok := m[currency]; ok {\r\n\t\t\tif isUsableRate(r) {\r\n\t\t\t\treturn r, 0, \"\"\r\n\t\t\t}\r\n\t"]
[16306.111079, "o", "\t\treturn 0, 0, \"bad_rate\"\r\n\t\t}\r\n\t}\r\n\tif maxStaleness > 0 {\r\n"]
[16306.111125, "o", "\t\teventDay := dayEpoch(date)\r\n\t\tif !eventDay.IsZero() {\r\n\t\t\tvar bestDate string\r\n\t\t\tvar bestDist int64 = -1\r\n\t\t\tfor _, d := range sortedKeys(rt.days) {\r\n"]
[16306.111167, "o", "\t\t\t\tif _, ok := rt.days[d][currency]; !ok {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n"]
[16306.111227, "o", "\t\t\t\tdayTime := dayEpoch(d)\r\n\t\t\t\tif dayTime.IsZero() {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n"]
[16306.111275, "o", "\t\t\t\tdist := absInt64(dayTime.Unix() - eventDay.Unix())\r\n\t\t\t\tif dist > int64(maxStaleness) {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n"]
[16306.111322, "o", "\t\t\t\tif bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {\r\n\t\t\t\t\tbestDist = dist\r\n\t\t\t\t\tbestDate = d\r\n\t\t\t\t}\r\n"]
[16306.111363, "o", "\t\t\t}\r\n\t\t\tif bestDate != \"\" {\r\n\t\t\t\tr := rt.days[bestDate][currency]\r\n\t\t\t\tif isUsableRate(r) {\r\n"]
[16306.111409, "o", "\t\t\t\t\treturn r, calendarDayDiff(bestDate, date), \"\"\r\n\t\t\t\t}\r\n\t\t\t\treturn 0, 0, \"bad_rate\"\r\n\t\t\t}\r\n"]
[16306.111457, "o", "\t\t}\r\n\t}\r\n\treturn 0, 0, \"missing_rate\"\r\n}\r\n\r\nfunc loadRates(path string) (*RateTable, error) {\r\n"]
[16306.111504, "o", "\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar top map[string]json.RawMessage\r\n\tif err := json.Unmarshal(data, &top); err != nil {\r\n"]
[16306.11155, "o", "\t\treturn nil, fmt.Errorf(\"rates file is not valid json: %w\", err)\r\n\t}\r\n\trt := newRateTable()\r\n\tdaysRaw, ok := top[\"days\"]\r\n\tif !ok {\r\n\t"]
[16306.111591, "o", "\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\tvar days map[string]json.RawMessage\r\n\tif err := json.Unmarshal(daysRaw, &days); err != nil {\r\n"]
[16306.111631, "o", "\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\tif len(days) == 0 {\r\n\t\treturn nil, errors.New(\"fx days invalid\")\r\n"]
[16306.111677, "o", "\t}\r\n\tfor _, day := range sortedKeys(days) {\r\n\t\tif !isStrictDate(day) || !isDate(day) {\r\n\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: invalid day key %s\", day)\r\n"]
[16306.111722, "o", "\t\t}\r\n"]
[16306.112639, "o", "\u001b[?2004h"]
