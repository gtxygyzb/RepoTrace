[9220.148849, "o", "    70\ttype stateWatermarkOut struct {\r\n    71\t\tMaxTS *string `json:\"max_ts\"`\r\n    72\t}\r\n    73\t\r\n    74\ttype stateFileOut struct {\r\n    75\t\tVersion          int                   `json:\"version\"`\r\n    76\t\tWatermark        stateWatermarkOut     `json:\"watermark\"`\r\n    77\t\tSeenIDs          []string              `json:\"seen_ids\"`\r\n    78\t\tPendingPurchases []statePendingOut     `json:\"pending_purchases\"`\r\n    79\t\tOpenSessions     []stateOpenSessionOut `json:\"open_sessions\"`\r\n    80\t\tRunIndex         int                   `json:\"run_index\"`\r\n"]
