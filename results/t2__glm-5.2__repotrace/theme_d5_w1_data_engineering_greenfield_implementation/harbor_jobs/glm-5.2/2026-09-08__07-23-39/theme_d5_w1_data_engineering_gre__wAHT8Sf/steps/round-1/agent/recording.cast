[18153.888736, "o", "\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc parseArgs\u001b[m\u001b[K(args []string) (cfg cliConfig, err error) {\r\n"]
[18153.888875, "o", "\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif strings.HasPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out=\") {\r\n\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.summarySchemaOut = strings.TrimPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out=\")\r\n"]
[18153.88895, "o", "\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out: value must be non-empty\")\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif strings.HasPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest=\") {\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.summarySchemaDigest = strings.TrimPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest=\")\r\n"]
[18153.889026, "o", "\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest: value must be non-empty\")\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif strings.HasPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-index=\") {\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.summarySchemaIndex = strings.TrimPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-index=\")\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-index: value must be non-empty\")\r\n"]
[18153.889135, "o", "\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Kingest-id\u001b[m\u001b[K\":\r\n"]
[18153.889359, "o", "\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Kout-parquet-manifest\u001b[m\u001b[K\":\r\n"]
[18153.889422, "o", "\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out\":\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out: value must be non-empty\")\r\n\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest\":\r\n\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest: value must be non-empty\")\r\n\u001b[32m\u001b[K170\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-strict\":\r\n"]
[18153.889489, "o", "\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-index\":\r\n\u001b[32m\u001b[K175\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-index: value must be non-empty\")\r\n"]
[18153.889544, "o", "\u001b[32m\u001b[K177\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K\":\r\n\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K: must be one of {legacy, tagged, tagged-sorted}\")\r\n"]
[18153.889646, "o", "\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K\":\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K: must be one of {gap, fixed-window, hybrid}\")\r\n"]
[18153.889702, "o", "\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K-header\":\r\n"]
[18153.88976, "o", "\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: unknown \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K %s\", arg)\r\n\u001b[32m\u001b[K210\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Kingest-id\u001b[m\u001b[K: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)\")\r\n"]
[18153.889824, "o", "\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --manifest-signature requires --\u001b[01;31m\u001b[Kout-parquet-manifest\u001b[m\u001b[K\")\r\n\u001b[32m\u001b[K217\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest --\u001b[01;31m\u001b[Kout-parquet-manifest\u001b[m\u001b[K parent directory does not exist\")\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest requires --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out\")\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t"]
[18153.889884, "o", "return cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-strict requires --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out\")\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-index requires --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out and --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest\")\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out parent directory does not exist\")\r\n"]
[18153.88995, "o", "\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest parent directory does not exist\")\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-index parent directory does not exist\")\r\n\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K tagged requires --audit-log\")\r\n\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K tagged-sorted requires --audit-log\")\r\n"]
[18153.890019, "o", "\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K-header requires --\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K tagged\")\r\n\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --fixed-window-seconds requires --\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K fixed-window or hybrid\")\r\n"]
[18153.890079, "o", "\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K fixed-window requires --fixed-window-seconds\")\r\n\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K hybrid requires --fixed-window-seconds\")\r\n\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc atoiOrError(s, \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K string) int {\r\n\u001b[32m\u001b[K295\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tpanic(fmt.Errorf(\"ingest: invalid integer for %s: %s\", \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K, s))\r\n"]
[18153.891066, "o", "\u001b[?2004h"]
[18153.891132, "o", "root@n30009:/app# "]
[18154.178242, "i", "nl -ba cli.go | sed -n '1,260p'\n"]
[18154.178542, "o", "nl -ba cli.go | sed -n '1,260p'\r\n\u001b[?2004l\r"]
[18154.182434, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n"]
[18154.182515, "o", "     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"regexp\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t\t\"time\"\r\n    14\t)\r\n    15\t\r\n    16\tvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n"]
[18154.182592, "o", "    17\t\r\n    18\ttype cliConfig struct {\r\n    19\t\tinputDir            string\r\n    20\t\tratesPath           string\r\n    21\t\toutputPath          string\r\n    22\t\trejectsPath         string\r\n    23\t\tsessionGap          int\r\n    24\t\twatermarkLag        int\r\n    25\t\tstateIn             string\r\n    26\t\tstateOut            string\r\n    27\t\t"]
[18154.182668, "o", "pendingTTL          int\r\n    28\t\tmaxOpenSessions     int\r\n    29\t\tauditLog            string\r\n    30\t\tauditLogDigest      string\r\n    31\t\tauditLogRotateBytes int\r\n    32\t\tratesStrict         bool\r\n    33\t\tratesMaxStaleness   int\r\n    34\t\tingestID            string\r\n    35\t\tingestIDSet         bool\r\n    36\t\toutManifest         string\r\n    37\t\tmanifestSignature   string\r\n    38\t\tdedupPolicy         string\r\n"]
[18154.182728, "o", "    39\t\tdedupPolicySet      bool\r\n    40\t\tstrictLateAudit     bool\r\n    41\t\tstateStrict         bool\r\n    42\t\tsummarySchemaOut    string\r\n    43\t\tsummarySchemaDigest string\r\n    44\t\tsummarySchemaStrict bool\r\n    45\t\tsummarySchemaIndex  string\r\n    46\t\trejectsFormat       string\r\n    47\t\trejectsFormatHeader bool\r\n    48\t\tsessionPolicy       string\r\n"]
[18154.182786, "o", "    49\t\tfixedWindowSeconds  int\r\n    50\t\tfixedWindowSet      bool\r\n    51\t}\r\n    52\t\r\n    53\tfunc main() {\r\n    54\t\tcfg, err := parseArgs(os.Args[1:])\r\n    55\t\tif err != nil {\r\n    56\t\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[18154.182844, "o", "    57\t\t\tos.Exit(2)\r\n    58\t\t}\r\n    59\t\tif err := run(cfg); err != nil {\r\n    60\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    61\t\t\tos.Exit(1)\r\n    62\t\t}\r\n    63\t}\r\n    64\t\r\n"]
[18154.182906, "o", "    65\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n    66\t\tdefer func() {\r\n    67\t\t\tif r := recover(); r != nil {\r\n    68\t\t\t\tcfg = cliConfig{}\r\n    69\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n    70\t\t\t}\r\n    71\t\t}()\r\n    72\t\tcfg = cliConfig{\r\n    73\t\t\tsessionGap:        600,\r\n"]
[18154.18297, "o", "    74\t\t\twatermarkLag:      300,\r\n    75\t\t\tpendingTTL:        86400,\r\n    76\t\t\tmaxOpenSessions:   100000,\r\n    77\t\t\tratesMaxStaleness: 0,\r\n    78\t\t}\r\n    79\t\trequired := map[string]bool{\r\n    80\t\t\t\"--input-dir\": false,\r\n    81\t\t\t\"--rates\":     false,\r\n    82\t\t\t\"--output\":    false,\r\n    83\t\t\t\"--rejects\":   false,\r\n    84\t\t}\r\n    85\t\tif len(args) > 0 && args[0] == \"ingest\" {\r\n"]
[18154.183027, "o", "    86\t\t\targs = args[1:]\r\n    87\t\t}\r\n    88\t\tfor i := 0; i < len(args); i++ {\r\n    89\t\t\targ := args[i]\r\n    90\t\t\tif strings.HasPrefix(arg, \"--summary-schema-out=\") {\r\n    91\t\t\t\tcfg.summarySchemaOut = strings.TrimPrefix(arg, \"--summary-schema-out=\")\r\n    92\t\t\t\tif cfg.summarySchemaOut == \"\" {\r\n    93\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-out: value must be non-empty\")\r\n"]
[18154.183083, "o", "    94\t\t\t\t}\r\n    95\t\t\t\tcontinue\r\n    96\t\t\t}\r\n    97\t\t\tif strings.HasPrefix(arg, \"--summary-schema-digest=\") {\r\n    98\t\t\t\tcfg.summarySchemaDigest = strings.TrimPrefix(arg, \"--summary-schema-digest=\")\r\n    99\t\t\t\tif cfg.summarySchemaDigest == \"\" {\r\n   100\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest: value must be non-empty\")\r\n   101\t\t\t"]
[18154.183141, "o", "\t}\r\n   102\t\t\t\tcontinue\r\n   103\t\t\t}\r\n   104\t\t\tif strings.HasPrefix(arg, \"--summary-schema-index=\") {\r\n   105\t\t\t\tcfg.summarySchemaIndex = strings.TrimPrefix(arg, \"--summary-schema-index=\")\r\n   106\t\t\t\tif cfg.summarySchemaIndex == \"\" {\r\n   107\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index: value must be non-empty\")\r\n   108\t\t\t\t}\r\n   109\t\t\t\tcontinue\r\n"]
[18154.183252, "o", "   110\t\t\t}\r\n   111\t\t\tswitch arg {\r\n   112\t\t\tcase \"--input-dir\":\r\n   113\t\t\t\tcfg.inputDir = nextArg(args, &i)\r\n   114\t\t\tcase \"--rates\":\r\n   115\t\t\t\tcfg.ratesPath = nextArg(args, &i)\r\n   116\t\t\tcase \"--output\":\r\n   117\t\t\t\tcfg.outputPath = nextArg(args, &i)\r\n   118\t\t\tcase \"--rejects\":\r\n   119\t\t\t\tcfg.rejectsPath = nextArg(args, &i)\r\n   120\t\t\tcase \"--session-gap\":\r\n   121\t\t\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\r\n   122\t\t\tcase \"--watermark-lag\":\r\n   123\t\t\t\tcfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")\r\n"]
[18154.183316, "o", "   124\t\t\tcase \"--state-in\":\r\n   125\t\t\t\tcfg.stateIn = nextArg(args, &i)\r\n   126\t\t\tcase \"--state-out\":\r\n   127\t\t\t\tcfg.stateOut = nextArg(args, &i)\r\n   128\t\t\tcase \"--pending-ttl\":\r\n   129\t\t\t\tcfg.pendingTTL = atoiOrError(nextArg(args, &i), \"--pending-ttl\")\r\n   130\t\t\tcase \"--max-open-sessions\":\r\n   131\t\t\t\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-sessions\")\r\n   132\t\t\tcase \"--audit-log\":\r\n   133\t"]
[18154.183378, "o", "\t\t\tcfg.auditLog = nextArg(args, &i)\r\n   134\t\t\tcase \"--audit-log-digest\":\r\n   135\t\t\t\tcfg.auditLogDigest = nextArg(args, &i)\r\n   136\t\t\tcase \"--audit-log-rotate-bytes\":\r\n   137\t\t\t\tcfg.auditLogRotateBytes = atoiOrError(nextArg(args, &i), \"--audit-log-rotate-bytes\")\r\n   138\t\t\tcase \"--rates-strict\":\r\n   139\t\t\t\tcfg.ratesStrict = true\r\n   140\t\t\tcase \"--rates-max-staleness\":\r\n   141\t\t\t\tcfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), \"--rates-max-staleness\")\r\n"]
[18154.183444, "o", "   142\t\t\tcase \"--ingest-id\":\r\n   143\t\t\t\tcfg.ingestID = nextArg(args, &i)\r\n   144\t\t\t\tcfg.ingestIDSet = true\r\n   145\t\t\tcase \"--out-parquet-manifest\":\r\n   146\t\t\t\tcfg.outManifest = nextArg(args, &i)\r\n"]
