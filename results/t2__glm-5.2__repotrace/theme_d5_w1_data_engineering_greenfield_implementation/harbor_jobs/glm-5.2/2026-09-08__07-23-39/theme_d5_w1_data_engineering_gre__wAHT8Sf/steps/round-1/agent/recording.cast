[19926.409114, "o", "   105\t\tfor i, c := range s {\r\n   106\t\t\tif i == 4 || i == 7 {\r\n   107\t\t\t\tif c != '-' {\r\n   108\t\t\t\t\treturn false\r\n   109\t\t\t\t}\r\n   110\t\t\t\tcontinue\r\n   111\t\t\t}\r\n   112\t\t\tif c < '0' || c > '9' {\r\n   113\t\t\t\treturn false"]
