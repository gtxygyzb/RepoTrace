[19916.516035, "o", ")\r\n\r\nvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n\r\ntype cliConfig struct {\r\n\tinputDir                string\r\n\tratesPath               string\r\n\toutputPath              string\r\n\trejectsPath             string\r\n\tsessionGap              int\r\n\twatermarkLag            int\r\n\tstateIn                 string\r\n\tstateOut                string\r\n\tpendingTTL              int\r\n\tmaxOpenSessions         int\r\n\tauditLog                string\r\n\tauditLogDigest          string\r\n\tauditLogRotateBytes     int\r\n\tratesStrict             bool\r\n\tratesMaxStaleness       int\r\n\tingestID                string\r\n\tingestIDSet             bool\r\n\toutManifest             string\r\n\tmanifestSignature       string\r\n\tdedupPolicy             string\r\n\tdedupPolicySet          bool\r\n\t"]
