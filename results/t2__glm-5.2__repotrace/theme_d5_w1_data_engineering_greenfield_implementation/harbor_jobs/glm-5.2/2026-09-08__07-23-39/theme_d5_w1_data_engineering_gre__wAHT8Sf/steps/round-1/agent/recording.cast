[16323.702542, "o", "    32\t\t\ts = \"-\" + s\r\n    33\t\t}\r\n    34\t\treturn s\r\n    35\t}\r\n    36\t\r\n    37\ttype Event struct {\r\n    38\t\tID                string\r\n    39\t\tType              string\r\n    40\t\tTS                time.Time\r\n    41\t\tUserID            string\r\n"]
