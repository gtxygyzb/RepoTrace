[20094.862658, "o", "   258\tfunc readInputEvents(inputDir string) ([]rawEvent, []rawEvent, []inputShardInfo, error) {\r\n   259\t\tinfo, err := os.Stat(inputDir)\r\n   260\t\tif err != nil {\r\n   261\t\t\treturn nil, nil, nil, err\r\n   262\t\t}\r\n   263\t\tif !info.IsDir() {\r\n   264\t\t\treturn nil, nil, nil, errors.New(\"input-dir is not a directory\")\r\n   265\t\t}\r\n   266\t\tentries, err := os.ReadDir(inputDir)\r\n   267\t\tif err != nil {\r\n   268\t\t\treturn nil, nil, nil, err\r\n   269\t\t}\r\n   270\t\tvar files []string\r\n   271\t\tfor _, e := range entries {\r\n   272\t\t\tif e.IsDir() || !e.Type().IsRegular() {\r\n   273\t\t\t\tcontinue\r\n   274\t\t\t}\r\n   275\t\t\tfiles = append(files, e.Name())\r\n   276\t\t}\r\n   277\t\tsort.Strings(files)\r\n   278\t\tvar events []rawEvent\r\n   279\t\tvar blanks []rawEvent\r\n   280\t\tvar shards []inputShardInfo\r\n   281\t\tfor _, name := range files {\r\n   282\t\t\tdata, err := os.ReadFile(filepath.Join(inputDir, name))\r\n   283\t\t\tif err != nil {\r\n   284\t\t\t\treturn nil, nil, nil, err\r\n   285\t\t\t}"]
[20094.862829, "o", "\r\n   286\t\t\tsi := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}\r\n   287\t\t\tlineNo := 0\r\n   288\t\t\tfor _, line := range bytes.Split(data, []byte{'\\n'}) {\r\n   289\t\t\t\tlineNo++\r\n   290\t\t\t\ttrimmed := bytes.TrimSpace(line)\r\n   291\t\t\t\tif len(trimmed) == 0 {\r\n   292\t\t\t\t\tblanks = append(blanks, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Blank: true})\r\n   293\t\t\t\t\tcontinue\r\n   294\t\t\t\t}\r\n   295\t\t\t\tsi.EventsTotal++\r\n   296\t\t\t\tvar obj map[string]json.RawMessage\r\n   297\t\t\t\tinvalid := false\r\n   298\t\t\t\tif err := json.Unmarshal(trimmed, &obj); err != nil {\r\n   299\t\t\t\t\tinvalid = true\r\n   300\t\t\t\t}\r\n   301\t\t\t\tevents = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})\r\n   302\t\t\t}\r\n   303\t\t\tshards = append(shards, si)\r\n   304\t\t}\r\n   305\t\treturn events, blanks, shards, nil\r\n   306\t}\r\n   307\t\r\n   308\tfunc newContext(raw rawEvent) *eventContext {\r\n   309\t\tctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n "]
[20094.862925, "o", "  310\t\tif raw.Obj != nil {\r\n"]
