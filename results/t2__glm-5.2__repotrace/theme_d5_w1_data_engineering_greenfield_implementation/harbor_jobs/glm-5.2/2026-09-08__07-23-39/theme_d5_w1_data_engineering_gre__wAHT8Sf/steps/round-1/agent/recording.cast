[11626.80713, "o", "                  data, err := json.MarshalIndent(digest, \"\", \"  \")\r\n\u001b[?2004l\r"]
[11626.807184, "o", "\u001b[?2004h> "]
[11626.807321, "o", "                  if err != nil {\r\n\u001b[?2004l\r"]
