[18346.397249, "o", "--- cli.go:680-770 ---\r\n 680: \tif cfg.auditLogDigest != \"\" {\r\n 681: \t\tdigest := auditDigestOutput{\r\n 682: \t\t\tSchemaVersion:    \"eventq.digest/v1\",\r\n 683: \t\t\tTotalRecords:     len(auditEntries),\r\n 684: \t\t\tBucketCounts:     bucketCounts,\r\n 685: \t\t\tInvalidReasons:   invalidReasons,\r\n 686: \t\t\tDuplicateReasons: duplicateReasons,\r\n 687: \t\t\tLateCutoffStats:  computeLateCutoffStats(auditEntries),\r\n 688: \t\t\tResolvedAgainst:  \"state\",\r\n"]
[18346.397432, "o", " 689: \t\t\tFXFallbackStats:  fxFallbackStats,\r\n 690: \t\t\tRatesDigest:      ratesDigest,\r\n 691: \t\t}\r\n 692: \t\tif cfg.dedupPolicySet {\r\n 693: \t\t\tdigest.DedupPolicyStats = &dedupPolicyStats\r\n 694: \t\t}\r\n 695: \t\tif cfg.rejectsFormat == \"tagged\" || cfg.rejectsFormat == \"tagged-sorted\" {\r\n 696: \t\t\tauditRejectCount := 0\r\n 697: \t\t\tfor _, e := range auditEntries {\r\n 698: \t\t\t\tif e.Bucket != \"accepted\" {\r\n 699: \t\t\t\t\tauditRejectCount++\r\n 700: \t\t\t\t}\r\n 701: \t\t\t}\r\n 702: \t\t\tdigest.RejectsCrossCheck = &rejectsCrossCheck{\r\n 703: \t\t\t\tRejectsRowCount:        len(rejectRecords),\r\n 704: \t\t\t\tAuditRejectRecordCount: auditRejectCount,\r\n 705: \t\t\t\tAgree:                  len(rejectRecords) == auditRejectCount,\r\n 706: \t\t\t}\r\n 707: \t\t}\r\n 708: \t\tif cfg.auditLog != \"\" {\r\n 709: \t\t\thashByPath := make(map[string]string, len(auditSegmentPaths))\r\n 710: \t\t\tfor _, path := range auditSegmentPaths {\r\n 711: \t\t\t\th, _, err := fileDigest(path)\r\n 712: \t\t\t\tif err != nil {\r\n 713: \t\t\t\t\treturn err\r\n 714: \t\t\t\t}\r\n 715: \t\t\t\thashByPath[path] = h\r\n 716: \t\t\t}\r\n 717: \t\t"]
[18346.39751, "o", "\torderedPaths := append([]string(nil), auditSegmentPaths...)\r\n 718: \t\t\tfor i, j := 0, len(orderedPaths)-1; i < j; i, j = i+1, j-1 {\r\n 719: \t\t\t\torderedPaths[i], orderedPaths[j] = orderedPaths[j], orderedPaths[i]\r\n 720: \t\t\t}\r\n 721: \t\t\tif len(orderedPaths) > 1 {\r\n 722: \t\t\t\tnames := make([]string, len(orderedPaths))\r\n 723: \t\t\t\tfor i, path := range orderedPaths {\r\n 724: \t\t\t\t\tnames[i] = filepath.Base(path)\r\n 725: \t\t\t\t}\r\n 726: \t\t\t\thashes := make([]string, len(orderedPaths))\r\n 727: \t\t\t\tfor i, path := range orderedPaths {\r\n 728: \t\t\t\t\thashes[i] = hashByPath[path]\r\n 729: \t\t\t\t}\r\n 730: \t\t\t\tdigest.AuditLog = mustJSONStringArray(names)\r\n 731: \t\t\t\tdigest.SHA256Segments = hashes\r\n 732: \t\t\t} else {\r\n 733: \t\t\t\tdigest.AuditLog = mustJSONString(filepath.Base(orderedPaths[0]))\r\n 734: \t\t\t\tdigest.SHA256 = hashByPath[orderedPaths[0]]\r\n 735: \t\t\t}\r\n 736: \t\t} else {\r\n 737: \t\t\tdigest.AuditLog = mustJSONString(\"\")\r\n 738: \t\t}\r\n 739: \t\tdata, err := json.MarshalIndent(digest, \"\", \"  \")\r\n 740: \t\tif err != nil {\r\n 741: \t\t\treturn err\r\n 742: \t\t}"]
[18346.39758, "o", "\r\n 743: \t\tdata = append(data, '\\n')\r\n 744: \t\tif err := atomicWriteFile(cfg.auditLogDigest, data); err != nil {\r\n 745: \t\t\treturn err\r\n 746: \t\t}\r\n 747: \t}\r\n 748: \tif cfg.outManifest != \"\" {\r\n 749: \t\tmanifest, err := buildManifest(cfg, runIndex, ratesDigest, shards, shardAccepted, bucketCounts, hasMin, minTs, hasMax, maxTs)\r\n 750: \t\tif err != nil {\r\n 751: \t\t\treturn err\r\n 752: \t\t}\r\n 753: \t\tmanifestData, err := writeManifest(cfg.outManifest, manifest)\r\n 754: \t\tif err != nil {\r\n 755: \t\t\treturn err\r\n 756: \t\t}\r\n 757: \t\tif cfg.manifestSignature != \"\" {\r\n 758: \t\t\tvar maxPtr *string\r\n 759: \t\t\tif manifest.Window.MaxTs != nil {\r\n 760: \t\t\t\tmaxPtr = manifest.Window.MaxTs\r\n 761: \t\t\t}\r\n 762: \t\t\tif err := writeSignature(cfg.manifestSignature, cfg.outManifest, manifestData, maxPtr); err != nil {\r\n 763: \t\t\t\treturn err\r\n 764: \t\t\t}\r\n 765: \t\t}\r\n 766: \t}\r\n 767: \tif err := writeSummarySchemaSidecars(cfg, summaryData, runIndex); err != nil {\r\n"]
