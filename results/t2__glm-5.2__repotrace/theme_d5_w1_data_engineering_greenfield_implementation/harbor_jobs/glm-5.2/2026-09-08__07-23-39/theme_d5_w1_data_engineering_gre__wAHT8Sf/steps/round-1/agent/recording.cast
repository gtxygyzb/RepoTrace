[12701.158809, "o", "\tif err != nil {\r\n\t\treturn nil, nil, err\r\n\t}\r\n\tif !info.IsDir() {\r\n\t\treturn nil, nil, errors.New(\"input-dir is not a directory\")\r\n\t}\r\n\tentries, err := os.ReadDir(inputDir)\r\n\tif err != nil {\r\n"]
[12701.158902, "o", "\t\treturn nil, nil, err\r\n\t}\r\n\tvar files []string\r\n\tfor _, e := range entries {\r\n\t\tif e.IsDir() || !e.Type().IsRegular() {\r\n\t\t\tcontinue\r\n\t\t"]
[12701.158962, "o", "}\r\n\t\tfiles = append(files, e.Name())\r\n\t}\r\n\tsort.Strings(files)\r\n\tvar events []rawEvent\r\n\tvar shards []inputShardInfo\r\n\tfor _, name := range files {\r\n\t\tdata, err := os.ReadFile(filepath.Join(inputDir, name))\r\n\t\tif err != nil {\r\n\t\t\treturn nil, nil, err\r\n\t\t}\r\n\t\tsi := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}\r\n\t\tlineNo := 0\r\n\t\tfor _, line := range bytes.Split(data, []byte{'\\n'}) {\r\n\t\t\tlineNo++\r\n\t\t\ttrimmed := bytes.TrimSpace(line)\r\n\t\t\tif len(trimmed) == 0 {\r\n\t"]
[12701.159005, "o", "\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tsi.EventsTotal++\r\n\t\t\tvar obj map[string]json.RawMessage\r\n\t\t\tinvalid := false\r\n"]
[12701.159044, "o", "\t\t\tif err := json.Unmarshal(trimmed, &obj); err != nil {\r\n\t\t\t\tinvalid = true\r\n\t\t\t}\r\n\t\t\tevents = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})\r\n\t\t}\r\n\t\tshards = append(shards, si)\r\n\t}\r\n"]
[12701.159094, "o", "\treturn events, shards, nil\r\n}\r\n\r\nfunc newContext(raw rawEvent) *eventContext {\r\n\tctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n\t"]
[12701.159137, "o", "if raw.Obj != nil {\r\n\t\tctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n\t\tctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n\t\tctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n\t}\r\n\treturn ctx\r\n}\r\n\r\nfunc parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {\r\n\tobj := ctx.Obj\r\n"]
[12701.159176, "o", "\tif obj == nil {\r\n\t\treturn nil, \"invalid_json\"\r\n\t}\r\n\traw, ok := obj[\"v\"]\r\n\tif !ok {\r\n\t\treturn nil, \"schema_version\"\r\n"]
[12701.159248, "o", "\t}\r\n\tvar v int\r\n\tif err := json.Unmarshal(raw, &v); err != nil {\r\n\t\treturn nil, \"schema_version\"\r\n\t}\r\n\tif v != 1 && v != 2 {\r\n\t\treturn nil, \"schema_version\"\r\n\t}\r\n\tid, idOk, _ := getRawString(obj, \"id\")\r\n\tif !idOk || id == \"\" {\r\n"]
[12701.159287, "o", "\t\treturn nil, \"missing_id\"\r\n\t}\r\n\ttsStr, tsOk, _ := getRawString(obj, \"ts\")\r\n\tif !tsOk {\r\n\t\treturn nil, \"missing_ts\"\r\n\t}\r\n\tt, err := parseTime(tsStr)\r\n\tif err != nil {\r\n"]
[12701.159327, "o", "\t\treturn nil, \"bad_ts\"\r\n\t}\r\n\ttypeStr, typeOk, _ := getRawString(obj, \"type\")\r\n\tif !typeOk {\r\n\t\treturn nil, \"missing_type\"\r\n"]
[12701.159367, "o", "\t}\r\n\tswitch typeStr {\r\n\tcase \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\n\tdefault:\r\n\t\treturn nil, \"bad_type\"\r\n\t}\r\n"]
[12701.15941, "o", "\tuser, userOk, _ := getRawString(obj, \"user_id\")\r\n\tif !userOk || user == \"\" {\r\n\t\treturn nil, \"missing_user\"\r\n\t}\r\n\tev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n\tswitch typeStr {\r\n\t"]
[12701.159447, "o", "case \"purchase\", \"refund\":\r\n\t\tvar amount float64\r\n\t\tif v == 1 {\r\n\t\t\traw, present := obj[\"amount\"]\r\n\t\t\tif !present {\r\n"]
[12701.159481, "o", "\t\t\t\treturn nil, \"missing_amount\"\r\n\t\t\t}\r\n\t\t\tvar f float64\r\n"]
[12701.159517, "o", "\t\t\tif err := json.Unmarshal(raw, &f); err != nil {\r\n\t\t\t\treturn nil, \"bad_amount\"\r\n\t\t\t}\r\n\t\t\tif !isFinite(f) || f < 0 {\r\n\t\t\t\treturn nil, \"bad_amount\"\r\n\t\t\t}\r\n"]
[12701.15955, "o", "\t\t\tamount = f\r\n\t\t} else {\r\n\t\t\traw, present := obj[\"amount_cents\"]\r\n\t\t\tif !present {\r\n"]
[12701.159584, "o", "\t\t\t\treturn nil, \"missing_amount\"\r\n\t\t\t}\r\n\t\t\tn, err := getJSONInt(raw)\r\n\t\t\tif err != nil || n < 0 {\r\n\t\t\t\treturn nil, \"bad_amount\"\r\n"]
[12701.159621, "o", "\t\t\t}\r\n\t\t\tamount = float64(n) / 100.0\r\n\t\t}\r\n\t\tcur, curOk, curPresent := getRawString(obj, \"currency\")\r\n"]
[12701.159661, "o", "\t\tif !curPresent {\r\n\t\t\treturn nil, \"missing_currency\"\r\n\t\t}\r\n\t\tif !curOk || cur == \"\" {\r\n\t\t\treturn nil, \"bad_currency\"\r\n"]
[12701.159697, "o", "\t\t}\r\n\t\trate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)\r\n\t\tswitch status {\r\n\t\tcase \"fx_unknown_currency\":\r\n\t\t\treturn nil, \"fx_unknown_currency\"\r\n\t\tcase \"missing_rate\":\r\n\t"]
[12701.159746, "o", "\t\treturn nil, \"fx_no_rate_for_date\"\r\n\t\tcase \"bad_rate\":\r\n\t\t\tif ratesStrict {\r\n\t\t\t\treturn nil, \"fx_bad_rate\"\r\n\t\t\t}\r\n\t\t\treturn nil, \"fx_no_rate_for_date\"\r\n\t\t}\r\n\t"]
[12701.159784, "o", "\tusd := amount * rate\r\n\t\tif typeStr == \"refund\" {\r\n\t\t\tusd = -usd\r\n\t\t}\r\n\t\tev.Amount = amount\r\n\t\t"]
[12701.159821, "o", "ev.Currency = cur\r\n\t\tev.FXFallbackDays = fallbackDays\r\n\t\tev.USD = roundMoney(usd)\r\n\tcase \"chargeback\":\r\n\t\tref, refOk, refPresent := getRawString(obj, \"ref_id\")\r\n\t"]
[12701.159858, "o", "\tif !refPresent || !refOk || ref == \"\" {\r\n\t\t\treturn nil, \"missing_ref_id\"\r\n\t\t}\r\n\t\tev.RefID = ref\r\n\t\tev.USD = 0\r\n\tcase \"login\", \"signup\":\r\n"]
[12701.159894, "o", "\t\tev.USD = 0\r\n\t}\r\n\treturn ev, \"\"\r\n}\r\n\r\ntype stateFileIn struct {\r\n\t"]
[12701.159933, "o", "Version          int                   `json:\"version\"`\r\n\tWatermark        stateWatermarkOut     `json:\"watermark\"`\r\n\tSeenIDs          []string              `json:\"seen_ids\"`\r\n\tPendingPurchases []statePendingOut     `json:\"pending_purchases\"`\r\n\tOpenSessions     []stateOpenSessionOut `json:\"open_sessions\"`\r\n\tRunIndex         int                   `json:\"run_index\"`\r\n}\r\n"]
[12701.159979, "o", "\r\nfunc loadState(path string, stateStrict bool) (*loadedState, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n"]
[12701.160014, "o", "\tvar sin stateFileIn\r\n\tif err := json.Unmarshal(data, &sin); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tst := &loadedState{\r\n\t\tversion:      sin.Version,"]
[12701.16005, "o", "\r\n\t\tseenIds:      map[string]bool{},\r\n\t\trunIndex:     sin.RunIndex,\r\n\t\topenSessions: map[string]carriedSession{},\r\n\t}\r\n\tif sin.Watermark.MaxTS != nil {\r\n"]
[12701.160086, "o", "\t\tt, err := parseTime(*sin.Watermark.MaxTS)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"bad state watermark: %w\", err)\r\n\t\t}\r\n\t\tst.hasMax = true\r\n\t"]
[12701.160118, "o", "\tst.maxTs = t\r\n\t}\r\n\tfor _, id := range sin.SeenIDs {\r\n\t\tst.seenIds[id] = true\r\n"]
[12701.160153, "o", "\t}\r\n\tfor _, p := range sin.PendingPurchases {\r\n\t\tt, err := parseTime(p.TS)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"bad pending purchase ts: %w\", err)\r\n\t\t}\r\n\t"]
[12701.160187, "o", "\tif stateStrict && !p.firstSeenEpochSet {\r\n\t\t\treturn nil, fmt.Errorf(\"ingest: --state-strict: state pending entry missing first_seen_epoch\")\r\n\t\t}\r\n\t\tst.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, firstSeenEpoch: int(epochSeconds(t)), user: p.User, usd: float64(p.USD), originRun: p.OriginRun})\r\n"]
[12701.16024, "o", "\t}\r\n\tfor _, s := range sin.OpenSessions {\r\n\t\tlast, err := parseTime(s.LastTS)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"bad open session last_ts: %w\", err)\r\n\t\t}\r\n\t\tstart, err := parseTime(s.StartTS)\r\n\t\tif err != nil {\r\n"]
[12701.160277, "o", "\t\t\treturn nil, fmt.Errorf(\"bad open session start_ts: %w\", err)\r\n\t\t}\r\n\t\tst.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}\r\n\t}\r\n\tst.carryInPending = len(st.pending)\r\n\tst.carryInOpenSessions = len(st.openSessions)"]
[12701.160315, "o", "\r\n\treturn st, nil\r\n}\r\n\r\nfunc buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {\r\n\tout := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}\r\n"]
[12701.160352, "o", "\tif hasCurrentMax {\r\n\t\ts := formatTS(currentMax)\r\n\t\tout.Watermark.MaxTS = &s\r\n\t} else if st != nil && st.hasMax {\r\n\t\ts := formatTS(st.maxTs)\r\n"]
[12701.160387, "o", "\t\tout.Watermark.MaxTS = &s\r\n\t}\r\n\tb, _ := json.MarshalIndent(out, \"\", \"  \")\r\n\tb = append(b, '\\n')\r\n\treturn b\r\n}\r\n\r\n"]
[12701.160424, "o", "func statePendingOutList(pending []pendingEntry) []statePendingOut {\r\n\tout := make([]statePendingOut, 0, len(pending))\r\n\tfor _, p := range pending {\r\n\t\tout = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), FirstSeenEpoch: p.firstSeenEpoch, User: p.user, USD: Money(p.usd), OriginRun: p.originRun})\r\n\t}\r\n\treturn out\r\n"]
[12701.160457, "o", "}\r\n\r\nfunc stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {\r\n\tout := make([]stateOpenSessionOut, 0, len(sessions))\r\n\tfor _, s := range sessions {\r\n"]
[12701.160494, "o", "\t\tout = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc sortedSeenIDs(seen map[string]bool) []string {\r\n"]
[12701.160526, "o", "\tids := make([]string, 0, len(seen))\r\n\tfor id := range seen {\r\n\t\tids = append(ids, id)\r\n\t}\r\n\tsort.Strings(ids)\r\n"]
[12701.160557, "o", "\treturn ids\r\n}\r\n\r\nfunc stateFirstSeenEpochPresent(p statePendingOut) bool {\r\n\treturn p.firstSeenEpochSet\r\n}\r\n"]
[12701.160591, "o", "\r\nfunc sortedPending(pending []pendingEntry) []pendingEntry {\r\n\tout := append([]pendingEntry(nil), pending...)\r\n\tsort.SliceStable(out, func(i, j int) bool {\r\n\t\tif out[i].ts.Equal(out[j].ts) {\r\n\t\t\treturn out[i].id < out[j].id\r\n\t\t}\r\n"]
[12701.160631, "o", "\t\treturn out[i].ts.Before(out[j].ts)\r\n\t})\r\n\treturn out\r\n}\r\n\r\nfunc sortedOpenSessions(m map[string]carriedSession) []carriedSession {\r\n"]
[12701.160665, "o", "\tout := make([]carriedSession, 0, len(m))\r\n\tfor _, s := range m {\r\n\t\tout = append(out, s)\r\n\t}\r\n\tsort.SliceStable(out, func(i, j int) bool {\r\n"]
[12701.160697, "o", "\t\tif out[i].lastTs.Equal(out[j].lastTs) {\r\n\t\t\treturn out[i].user < out[j].user\r\n\t\t}\r\n\t\treturn out[i].lastTs.Before(out[j].lastTs)\r\n\t})\r\n"]
[12701.160731, "o", "\treturn out\r\n}\r\n\r\nfunc sortedCarriedSessions(m map[string]carriedSession) []carriedSession {\r\n\treturn sortedOpenSessions(m)\r\n}\r\n"]
