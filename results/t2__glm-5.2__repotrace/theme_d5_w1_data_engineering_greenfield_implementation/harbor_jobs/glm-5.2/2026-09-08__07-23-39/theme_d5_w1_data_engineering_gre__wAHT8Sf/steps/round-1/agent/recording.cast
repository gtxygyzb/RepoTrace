[9090.717336, "o", "\tfunc main() {\r\n    39\t\tcfg, err := parseArgs(os.Args[1:])\r\n    40\t\tif err != nil {\r\n    41\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    42\t\t\tos.Exit(2)\r\n    43\t\t}\r\n    44\t\tif err := run(cfg); err != nil {\r\n    45\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    46\t\t\tos.Exit(1)\r\n    47\t\t}\r\n    48\t}\r\n    49\t\r\n    50\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n    51\t\tdefer func() {\r\n    52\t\t\tif r := recover(); r != nil {\r\n    53\t\t\t\tcfg = cliConfig{}\r\n    54\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n    55\t\t\t}\r\n    56\t\t}()\r\n    57\t\tcfg = cliConfig{\r\n    58\t\t\tsessionGap:        600,\r\n    59\t\t\twatermarkLag:      300,\r\n    60\t\t\tpendingTTL:        86400,\r\n    61\t\t\tmaxOpenSessions:   100000,\r\n    62\t\t\tratesMaxStaleness: 0,\r\n    63\t\t}\r\n    64\t\trequired := map[string]bool{\r\n    65\t\t\t\"--input-dir\": false,\r\n    66\t\t\t\"--rates\":     false,\r\n    67\t\t\t\"--output\":    false,\r\n    68\t\t\t\"--rejects\":   false,\r\n    69"]
