[12827.67366, "o", "\t\t\tSignedAtUTC:    signedAt(maxTs),\r\n    26\t\t\tToolVersion:    toolVersion,\r\n    27\t\t}\r\n    28\t\tdata, err := json.MarshalIndent(sig, \"\", \"  \")\r\n    29\t\tif err != nil {\r\n    30\t\t\treturn err\r\n    31\t\t}\r\n"]
[12827.673726, "o", "    32\t\tdata = append(data, '\\n')\r\n    33\t\treturn atomicWriteFile(path, data)\r\n    34\t}\r\n    35\t\r\n    36\tfunc signedAt(maxTs *string) string {\r\n    37\t\tif maxTs != nil {\r\n    38\t\t\treturn *maxTs\r\n    39\t\t}\r\n"]
[12827.673789, "o", "    40\t\treturn \"1970-01-01T00:00:00Z\"\r\n    41\t}\r\n"]
