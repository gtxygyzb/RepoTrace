[9065.376327, "o", "    95\t\t\tkeys = append(keys, k)\r\n    96\t\t}\r\n    97\t\tsort.Strings(keys)\r\n    98\t\treturn keys\r\n    99\t}\r\n   100\t\r\n   101\tfunc isStrictDate(s string) bool {\r\n   102\t\tif len(s) != 10 {\r\n   103\t\t\treturn false\r\n   104\t\t}\r\n   105"]
[9065.376393, "o", "\t\tfor i, c := range s {\r\n   106\t\t\tif i == 4 || i == 7 {\r\n   107\t\t\t\tif c != '-' {\r\n   108\t\t\t\t\treturn false\r\n   109\t\t\t\t}\r\n   110\t\t\t\tcontinue\r\n   111\t\t\t}\r\n   112\t\t\tif c < '0' || c > '9' {\r\n   113\t\t\t\treturn false\r\n"]
[9065.37649, "o", "   114\t\t\t}\r\n   115\t\t}\r\n   116\t\treturn true\r\n   117\t}\r\n   118\t\r\n   119\tfunc dayEpoch(date string) time.Time {\r\n   120\t\tt, err := time.Parse(\"2006-01-02\", date)\r\n   121\t\tif err != nil {\r\n   122\t\t\treturn time.Time{}\r\n   123\t\t}\r\n   124\t\treturn t.UTC()\r\n   125\t}\r\n   126\t\r\n"]
[9065.376562, "o", "   127\tfunc calendarDayDiff(rateDate, eventDate string) int {\r\n   128\t\tr := dayEpoch(rateDate)\r\n   129\t\te := dayEpoch(eventDate)\r\n   130\t\tif r.IsZero() || e.IsZero() {\r\n   131\t\t\treturn 0\r\n   132\t\t}\r\n   133\t\treturn int(r.Sub(e) / (24 * time.Hour))\r\n   134\t}\r\n   135\t\r\n   136\tfunc absInt(v int) int {\r\n   137\t"]
[9065.37663, "o", "\tif v < 0 {\r\n   138\t\t\treturn -v\r\n   139\t\t}\r\n   140\t\treturn v\r\n   141\t}\r\n   142\t\r\n"]
