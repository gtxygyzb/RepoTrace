[14046.244604, "o", "{\r\n  \"schema_version\": \"eventq.summary-schema/v1\",\r\n  \"summary_schema\": {\r\n    \"total_events\": {\r\n      \"type\": \"integer\",\r\n      \"constraints\": {\r\n        \"non_negative\": true\r\n      }\r\n    },\r\n    \"accepted_events\": {\r\n      \"type\": \"integer\",\r\n      \"constraints\": {\r\n        \"non_negative\": true,\r\n        \"zero_observed\": true\r\n      }\r\n    },\r\n    \"rejected_events\": {\r\n      \"type\": \"integer\",\r\n      \"constraints\": {\r\n        \"non_negative\": true\r\n      }\r\n    },\r\n    \"total_usd\": {\r\n      \"type\": \"number\",\r\n      \"constraints\": {}\r\n    },\r\n    \"anomalies\": {\r\n      \"type\": \"object\",\r\n      \"fields\": [\r\n        \"duplicate\",\r\n        \"invalid\",\r\n        \"late\",\r\n        \"unresolved_chargeback\"\r\n      ],\r\n      \"constraints\": {\r\n        \"field_count\": 4,\r\n        \"subfields\": {\r\n          \"duplicate\": {\r\n            \"type\": \"integer\",\r\n            \"constraints\": {\r\n              \"non_negative\": true\r\n            }\r\n          },\r\n          \"invalid\": {\r\n            \"type\": \"integer\",\r\n            \"constraint"]
[14046.24472, "o", "s\": {\r\n              \"non_negative\": true\r\n            }\r\n          },\r\n          \"late\": {\r\n            \"type\": \"integer\",\r\n            \"constraints\": {\r\n              \"non_negative\": true\r\n            }\r\n          },\r\n          \"unresolved_chargeback\": {\r\n            \"type\": \"integer\",\r\n            \"constraints\": {\r\n              \"non_negative\": true\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"run_index\": {\r\n      \"type\": \"integer\",\r\n      \"constraints\": {\r\n        \"non_negative\": true\r\n      }\r\n    },\r\n    \"watermark\": {\r\n      \"type\": \"null\",\r\n      \"constraints\": {}\r\n    }\r\n  },\r\n  \"ingest_id\": null,\r\n  \"run_index\": 1,\r\n  \"field_summary\": {\r\n    \"array_fields\": 0,\r\n    \"object_fields\": 1,\r\n    \"scalar_fields\": 6\r\n  },\r\n  \"strict_mode\": true\r\n}\r\n"]
