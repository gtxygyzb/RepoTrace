[14568.485273, "o", "case \"--output\":\r\n   112\t\t\t\tcfg.outputPath = nextArg(args, &i)\r\n   113\t\t\tcase \"--rejects\":\r\n   114\t\t\t\tcfg.rejectsPath = nextArg(args, &i)\r\n   115\t\t\tcase \"--session-gap\":\r\n   116\t\t\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\r\n   117\t\t\tcase \"--watermark-lag\":\r\n   118\t\t\t\t"]
[14568.485329, "o", "cfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")\r\n   119\t\t\tcase \"--state-in\":\r\n   120\t\t\t\tcfg.stateIn = nextArg(args, &i)\r\n"]
