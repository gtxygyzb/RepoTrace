[20163.760428, "o", "    30\t}\r\n    31\t\r\n    32\tfunc orderedString(s string) any { return s }\r\n    33\tfunc orderedInt(n int) any       { return n }\r\n    34\tfunc orderedInt64(n int64) any   { return n }\r\n    35\tfunc orderedBool(b bool) any     { return b }\r\n    36\tfunc orderedNull() any           { return nil }\r\n    37\t\r\n    38"]
[20163.760497, "o", "\tfunc writeOrderedValue(buf *bytes.Buffer, v any) {\r\n    39\t\tswitch val := v.(type) {\r\n    40\t\tcase orderedJSON:\r\n    41\t\t\tbuf.WriteString(val.value.(string))\r\n    42\t\tcase []orderedJSON:\r\n    43\t\t\twriteOrderedObject(buf, val)\r\n    44\t\tcase orderedArray:\r\n"]
[20163.760569, "o", "    45\t\t\twriteOrderedArrayAny(buf, val)\r\n    46\t\tcase []any:\r\n    47\t\t\twriteOrderedArrayAny(buf, val)\r\n    48\t\tcase string:\r\n    49\t\t\twriteJSONString(buf, val)\r\n    50\t\tcase int:\r\n    51\t\t\tfmt.Fprintf(buf, \"%d\", val)\r\n    52\t\tcase int64:\r\n    53\t"]
[20163.760635, "o", "\t\tfmt.Fprintf(buf, \"%d\", val)\r\n    54\t\tcase bool:\r\n    55\t\t\tif val {\r\n    56\t\t\t\tbuf.WriteString(\"true\")\r\n    57\t\t\t} else {\r\n    58\t\t\t\tbuf.WriteString(\"false\")\r\n"]
[20163.760702, "o", "    59\t\t\t}\r\n    60\t\tcase nil:\r\n    61\t\t\tbuf.WriteString(\"null\")\r\n    62\t\tdefault:\r\n    63\t\t\tb, _ := json.Marshal(val)\r\n    64\t\t\tbuf.Write(b)\r\n    65\t\t}\r\n"]
[20163.76077, "o", "    66\t}\r\n    67\t\r\n    68\tfunc writeOrderedObject(buf *bytes.Buffer, entries []orderedJSON) {\r\n    69\t\tbuf.WriteByte('{')\r\n    70\t\tfor i, e := range entries {\r\n    71\t\t\tif i > 0 {\r\n    72\t\t\t\tbuf.WriteByte(',')\r\n    73\t\t\t}\r\n"]
[20163.760835, "o", "    74\t\t\twriteJSONString(buf, e.key)\r\n    75\t\t\tbuf.WriteByte(':')\r\n    76\t\t\twriteOrderedValue(buf, e.value)\r\n    77\t\t}\r\n    78\t\tbuf.WriteByte('}')\r\n    79\t}\r\n    80\t\r\n"]
[20163.760906, "o", "    81\tfunc writeOrderedArrayAny(buf *bytes.Buffer, arr []any) {\r\n    82\t\tbuf.WriteByte('[')\r\n    83\t\tfor i, v := range arr {\r\n    84\t\t\tif i > 0 {\r\n    85\t\t\t\tbuf.WriteByte(',')\r\n    86\t\t\t}\r\n    87\t\t\twriteOrderedValue(buf, v)\r\n    88\t\t}\r\n    89"]
