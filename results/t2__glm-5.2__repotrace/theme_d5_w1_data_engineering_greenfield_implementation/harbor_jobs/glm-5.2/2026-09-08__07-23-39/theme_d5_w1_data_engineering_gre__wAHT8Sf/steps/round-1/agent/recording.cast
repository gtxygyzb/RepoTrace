[18101.534405, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"path/filepath\"\r\n)\r\n\r\n"]
[18101.534509, "o", "func writeManifest(path string, m manifestOutput) ([]byte, error) {\r\n\tdata, err := json.MarshalIndent(m, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdata = append(data, '\\n')\r\n\tif err := atomicWriteFile(path, data); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn data, nil\r\n}\r\n\r\nfunc writeSignature(path, manifestPath string, manifestData []byte, maxTs *string) error {\r\n\tsig := signatureOutput{\r\n\t\tManifestPath:   filepath.Base(manifestPath),\r\n\t\tManifestSHA256: sha256Hex(manifestData),\r\n"]
[18101.534577, "o", "\t\tManifestBytes:  int64(len(manifestData)),\r\n\t\tSignedAtUTC:    signedAt(maxTs),\r\n\t\tToolVersion:    toolVersion,\r\n\t}\r\n\tdata, err := json.MarshalIndent(sig, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdata = append(data, '\\n')\r\n\treturn atomicWriteFile(path, data)\r\n}\r\n"]
[18101.534641, "o", "\r\nfunc signedAt(maxTs *string) string {\r\n\tif maxTs != nil {\r\n\t\treturn *maxTs\r\n\t}\r\n"]
[18101.53466, "o", "\treturn \"1970-01-01T00:00:00Z\"\r\n}\r\n"]
