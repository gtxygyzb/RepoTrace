[18117.245842, "o", "package main\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"math\"\r\n"]
[18117.245935, "o", "\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nfunc rawStringPtr(obj map[string]json.RawMessage, key string) *string {\r\n\tif obj == nil {\r\n\t\treturn nil\r\n\t}\r\n\traw, ok := obj[key]\r\n\tif !ok {\r\n\t\treturn nil\r\n\t"]
[18117.245997, "o", "}\r\n\tvar s string\r\n\tif err := json.Unmarshal(raw, &s); err != nil {\r\n\t\treturn nil\r\n\t}\r\n\treturn &s\r\n}\r\n\r\n"]
[18117.246039, "o", "func getRawString(obj map[string]json.RawMessage, key string) (string, bool, bool) {\r\n\tif obj == nil {\r\n\t\treturn \"\", false, false\r\n\t}\r\n\traw, present := obj[key]\r\n\tif !present {\r\n"]
[18117.24615, "o", "\t\treturn \"\", false, false\r\n\t}\r\n\tvar s string\r\n\tif err := json.Unmarshal(raw, &s); err != nil {\r\n\t\treturn \"\", false, true\r\n\t}\r\n\treturn s, true, true\r\n}\r\n\r\nfunc getJSONInt(raw json.RawMessage) (int, error) {\r\n\tvar n int\r\n\tif err := json.Unmarshal(raw, &n); err != nil {\r\n\t"]
[18117.246283, "o", "\treturn 0, err\r\n\t}\r\n\treturn n, nil\r\n}\r\n\r\nfunc parseTime(s string) (time.Time, error) {\r\n\ts = strings.TrimSpace(s)\r\n\tif strings.HasSuffix(s, \"Z\") {\r\n\t\tif t, err := time.Parse(\"2006-01-02T15:04:05Z\", s); err == nil {\r\n\t\t\treturn t.UTC(), nil\r\n\t\t}\r\n\t\tif t, err := time.Parse(\"2006-01-02T15:04:05.000000000Z\", s); err == nil {\r\n\t\t\treturn t.UTC(), nil\r\n\t\t}\r\n\t}\r\n"]
[18117.246305, "o", "\tif t, err := time.Parse(time.RFC3339Nano, s); err == nil {\r\n\t\treturn t.UTC(), nil\r\n"]
[18117.246401, "o", "\t}\r\n\tif t, err := time.Parse(time.RFC3339, s); err == nil {\r\n\t\treturn t.UTC(), nil\r\n\t}\r\n\treturn time.Time{}, fmt.Errorf(\"bad timestamp: %s\", s)\r\n}\r\n\r\nfunc formatTS(t time.Time) string {\r\n\treturn t.UTC().Format(\"2006-01-02T15:04:05Z\")\r\n}\r\n\r\nfunc epochSeconds(t time.Time) int64 {\r\n\t"]
[18117.246462, "o", "return t.UTC().Unix()\r\n}\r\n\r\nfunc formatCutoffObject(cutoff time.Time) cutoffObject {\r\n\tepoch := epochSeconds(cutoff)\r\n\tif epoch < 0 {\r\n\t\tepoch = 0\r\n\t\tcutoff = time.Unix(0, 0).UTC()\r\n\t}\r\n"]
[18117.246515, "o", "\treturn cutoffObject{Value: formatTS(cutoff), EpochSeconds: int(epoch)}\r\n}\r\n\r\nfunc dateKey(t time.Time) string {\r\n"]
[18117.246569, "o", "\treturn t.UTC().Format(\"2006-01-02\")\r\n}\r\n\r\nfunc roundMoney(v float64) float64 {\r\n\tcents := int64(math.Floor(math.Abs(v)*100.0 + 0.5))\r\n\tif v < 0 && cents != 0 {\r\n\t\treturn -float64(cents) / 100.0\r\n"]
[18117.246645, "o", "\t}\r\n\treturn float64(cents) / 100.0\r\n}\r\n\r\nfunc isFinite(f float64) bool {\r\n\treturn !math.IsNaN(f) && !math.IsInf(f, 0)\r\n}\r\n\r\n"]
[18117.246706, "o", "func isDate(s string) bool {\r\n\tif _, err := time.Parse(\"2006-01-02\", s); err != nil {\r\n\t\treturn false\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc sha256Hex(data []byte) string {\r\n\tsum := sha256.Sum256(data)\r\n\treturn hex.EncodeToString(sum[:])\r\n}\r\n\r\nfunc sha256Short(h string) string {\r\n\tif len(h) < 12 {\r\n"]
[18117.246764, "o", "\t\treturn h\r\n\t}\r\n\treturn h[:12]\r\n}\r\n\r\nfunc fileDigest(path string) (string, int64, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn \"\", 0, err\r\n"]
[18117.246819, "o", "\t}\r\n\treturn sha256Hex(data), int64(len(data)), nil\r\n}\r\n"]
[18117.246875, "o", "\r\nfunc atomicWriteFile(path string, data []byte) error {\r\n\ttmp := path + \".tmp\"\r\n\tif err := os.WriteFile(tmp, data, 0644); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif err := os.Rename(tmp, path); err != nil {\r\n\t\t_ = os.Remove(tmp)\r\n\t\treturn err\r\n\t}\r\n"]
[18117.246945, "o", "\treturn nil\r\n}\r\n\r\nfunc parentDirExists(path string) bool {\r\n\tdir := filepath.Dir(path)\r\n"]
[18117.247006, "o", "\tif dir == \".\" || dir == \"\" {\r\n\t\treturn true\r\n\t}\r\n\tinfo, err := os.Stat(dir)\r\n\tif err != nil {\r\n\t\treturn false\r\n\t}\r\n\treturn info.IsDir()\r\n}\r\n\r\nfunc manifestFileOutputFor(path string) (*manifestFileOutput, error) {\r\n\th, b, err := fileDigest(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\treturn &manifestFileOutput{"]
[18117.247061, "o", "\r\n\t\tPath:        filepath.Base(path),\r\n"]
[18117.247116, "o", "\t\tSHA256:      h,\r\n\t\tSHA256Short: sha256Short(h),\r\n\t\tBytes:       b,\r\n\t}, nil\r\n}\r\n\r\nfunc ptrString(s string) *string {\r\n\treturn &s\r\n}\r\n\r\nfunc (ctx *eventContext) IDStr() string {\r\n\tif ctx.ID != nil {\r\n\t\treturn *ctx.ID\r\n"]
[18117.247172, "o", "\t}\r\n\treturn \"\"\r\n}\r\n\r\nfunc (ctx *eventContext) TSString() string {\r\n\tif ctx.TS != nil {\r\n\t\treturn *ctx.TS\r\n\t}\r\n"]
[18117.247239, "o", "\treturn \"\"\r\n}\r\n\r\nfunc (ctx *eventContext) TypeString() string {\r\n\tif ctx.Type != nil {\r\n\t\treturn *ctx.Type\r\n\t}\r\n\treturn \"\""]
[18117.247292, "o", "\r\n}\r\n"]
