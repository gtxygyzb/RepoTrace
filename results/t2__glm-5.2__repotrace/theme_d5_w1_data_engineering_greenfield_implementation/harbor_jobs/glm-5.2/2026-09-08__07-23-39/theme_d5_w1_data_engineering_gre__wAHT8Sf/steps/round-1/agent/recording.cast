[14533.214525, "o", "\t\treturn nil, \"schema_version\"\r\n   324\t\t}\r\n   325\t\tvar v int\r\n   326\t\tif err := json.Unmarshal(raw, &v); err != nil {\r\n   327\t\t\treturn nil, \"schema_version\"\r\n   328\t\t}\r\n   329\t\tif v != 1 && v != 2 {\r\n   330"]
[14533.214585, "o", "\t\t\treturn nil, \"schema_version\"\r\n   331\t\t}\r\n   332\t\tid, idOk, _ := getRawString(obj, \"id\")\r\n   333\t\tif !idOk || id == \"\" {\r\n   334\t\t\treturn nil, \"missing_id\"\r\n   335\t\t}\r\n   336\t\ttsStr, tsOk, _ := getRawString(obj, \"ts\")\r\n   337\t\t"]
[14533.21464, "o", "if !tsOk {\r\n   338\t\t\treturn nil, \"missing_ts\"\r\n   339\t\t}\r\n   340\t\tt, err := parseTime(tsStr)\r\n   341\t\tif err != nil {\r\n   342\t\t\treturn nil, \"bad_ts\"\r\n   343\t\t}\r\n   344\t\ttypeStr, typeOk, _ := getRawString(obj, \"type\")\r\n   345"]
[14533.214697, "o", "\t\tif !typeOk {\r\n   346\t\t\treturn nil, \"missing_type\"\r\n   347\t\t}\r\n   348\t\tswitch typeStr {\r\n   349\t\tcase \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\n   350\t\tdefault:\r\n   351\t\t\treturn nil, \"bad_type\"\r\n   352\t\t}\r\n"]
[14533.214754, "o", "   353\t\tuser, userOk, _ := getRawString(obj, \"user_id\")\r\n   354\t\tif !userOk || user == \"\" {\r\n   355\t\t\treturn nil, \"missing_user\"\r\n   356\t\t}\r\n   357\t\tev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n   358\t\tswitch typeStr {\r\n   359\t\tcase \"purchase\", \"refund\":\r\n   360\t\t\tvar amount float64\r\n   361\t\t\tif v == 1 {\r\n"]
[14533.214828, "o", "   362\t\t\t\traw, present := obj[\"amount\"]\r\n   363\t\t\t\tif !present {\r\n   364\t\t\t\t\treturn nil, \"missing_amount\"\r\n   365\t\t\t\t}\r\n   366\t\t\t\tvar f float64\r\n   367\t\t\t\tif err := json.Unmarshal(raw, &f); err != nil {\r\n   368\t\t\t\t\treturn nil, \"bad_amount\"\r\n   369\t\t\t\t}\r\n   370\t\t\t\tif !isFinite(f) || f < 0 {\r\n   371\t\t\t\t\treturn nil, \"bad_amount\"\r\n"]
[14533.214896, "o", "   372\t\t\t\t}\r\n   373\t\t\t\tamount = f\r\n   374\t\t\t} else {\r\n   375\t\t\t\traw, present := obj[\"amount_cents\"]\r\n   376\t\t\t\tif !present {\r\n   377\t\t\t\t\treturn nil, \"missing_amount\"\r\n   378\t\t\t\t}\r\n   379\t\t\t\tn, err := getJSONInt(raw)\r\n   380\t\t\t\tif err != nil || n < 0 {\r\n   381\t\t\t\t\treturn nil, \"bad_amount\"\r\n"]
[14533.214965, "o", "   382\t\t\t\t}\r\n   383\t\t\t\tamount = float64(n) / 100.0\r\n   384\t\t\t}\r\n   385\t\t\tcur, curOk, curPresent := getRawString(obj, \"currency\")\r\n   386\t\t\tif !curPresent {\r\n   387\t\t\t\treturn nil, \"missing_currency\"\r\n   388"]
