[18117.613608, "o", "\t\tb, err := json.Marshal(e.ID)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"ts\":`)\r\n\t\tb, err = json.Marshal(e.TS)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n"]
[18117.613634, "o", "\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"type\":`)\r\n\t\tb, err = json.Marshal(e.Type)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n"]
[18117.613708, "o", "\t\tbuf.WriteString(`,\"shard\":`)\r\n\t\tb, err = json.Marshal(e.Shard)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"line\":`)\r\n\t\tb, err = json.Marshal(e.Line)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n"]
[18117.613764, "o", "\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"bucket\":`)\r\n\t\tb, err = json.Marshal(e.Bucket)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n"]
[18117.613814, "o", "\t\tbuf.WriteString(`,\"cutoff\":`)\r\n\t\tif e.Cutoff != nil {\r\n\t\t\t"]
[18117.613867, "o", "b, err = json.Marshal(e.Cutoff)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t\tb = []byte(\"null\")\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n"]
[18117.613925, "o", "\t\tif e.WatermarkLagSeconds != nil {\r\n\t\t\tbuf.WriteString(`,\"watermark_lag_seconds\":`)\r\n\t\t\tb, err = json.Marshal(*e.WatermarkLagSeconds)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tbuf.Write(b)\r\n\t\t}\r\n\t\tif e.LateBySeconds != nil {\r\n\t\t\tbuf.WriteString(`,\"late_by_seconds\":`)\r\n\t\t\tb, err = json.Marshal(*e.LateBySeconds)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tbuf.Write(b)\r\n\t\t}"]
