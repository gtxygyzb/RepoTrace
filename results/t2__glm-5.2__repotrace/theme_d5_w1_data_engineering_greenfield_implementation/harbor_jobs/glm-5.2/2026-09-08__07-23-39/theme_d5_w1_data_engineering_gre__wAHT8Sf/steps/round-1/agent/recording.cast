[4688.174006, "i", "head -n 20 main.go && tail -n 10 main.go\n"]
[4688.174393, "o", "head -n 20 main.go && tail -n 10 main.go\r\n\u001b[?2004l\r"]
[4688.176783, "o", "package main\r\n\r\nimport (\r\n  \"bytes\"\r\n  \"crypto/sha256\"\r\n  \"encoding/hex\"\r\n  \"encoding/json\"\r\n  \"errors\"\r\n  \"fmt\"\r\n"]
[4688.176922, "o", "  \"math\"\r\n  \"os\"\r\n  \"path/filepath\"\r\n  \"sort\"\r\n  \"strconv\"\r\n  \"strings\"\r\n  \"time\"\r\n)\r\n\r\nvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--audit-log <path>] [--audit-log-digest <path>]\\n\"\r\n\r\n"]
[4688.179247, "o", "\r\ntype digest struct {\r\n  AuditLog         string                `json:\"audit_log\"`\r\n  TotalRecords     int                   `json:\"total_records\"`\r\n  BucketCounts     digestBucketCounts    `json:\"bucket_counts\"`\r\n"]
[4688.179345, "o", "  InvalidReasons   map[string]int        `json:\"invalid_reasons\"`\r\n  DuplicateReasons digestDuplicateReasons `json:\"duplicate_reasons\"`\r\n  ResolvedAgainst  digestResolvedAgainst  `json:\"resolved_against\"`\r\n  SHA256           string                `json:\"sha256\"`\r\n}\r\n"]
[4688.17968, "o", "\u001b[?2004h"]
[4688.179739, "o", "root@n30009:/app# "]
[4688.459005, "i", "gofmt -e main.go >/tmp/main_gofmt.out 2>/tmp/main_gofmt.err; echo \"gofmt rc=$?\"; cat /tmp/main_gofmt.err | head -n 40\n"]
[4688.459844, "o", "gofmt -e main.go >/tmp/main_gofmt.out 2>/tmp/main_gofmt.err; echo \"gofmt rc=$?\"; cat /tmp/main_gofmt.err | head -n 40\r\n\u001b[?2004l\r"]
[4688.468899, "o", "gofmt rc=0\r\n"]
[4688.471999, "o", "\u001b[?2004h"]
