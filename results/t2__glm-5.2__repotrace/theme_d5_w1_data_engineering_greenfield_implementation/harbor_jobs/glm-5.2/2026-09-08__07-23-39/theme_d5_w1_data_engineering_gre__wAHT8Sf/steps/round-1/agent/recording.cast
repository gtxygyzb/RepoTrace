[14650.93973, "o", "   147\t\t\tbuf.WriteString(`,\"type\":`)\r\n   148\t\t\tb, err = json.Marshal(e.Type)\r\n   149\t\t\tif err != nil {\r\n   150\t\t\t\treturn nil, err\r\n   151\t\t\t}\r\n   152\t\t\tbuf.Write(b)\r\n"]
[14650.939822, "o", "   153\t\t\tbuf.WriteString(`,\"shard\":`)\r\n   154\t\t\tb, err = json.Marshal(e.Shard)\r\n   155\t\t\tif err != nil {\r\n   156\t\t\t\treturn nil, err\r\n   157\t\t\t}\r\n   158\t\t\tbuf.Write(b)\r\n   159\t\t\tbuf.WriteString(`,\"line\":`)\r\n   160\t\t\tb, err = json.Marshal(e.Line)\r\n   161\t\t\tif err != nil {\r\n   162\t\t\t\treturn nil, err\r\n   163\t\t\t}\r\n   164\t\t\tbuf.Write(b)\r\n   165\t\t\tbuf.WriteString(`,\"bucket\":`)\r\n   166\t\t\tb, err = json.Marshal(e.Bucket)\r\n   167\t\t\tif err != nil {\r\n   168\t\t\t\treturn nil, err\r\n   169\t\t\t}\r\n   170\t\t\tbuf.Write(b)\r\n"]
[14650.939911, "o", "   171\t\t\tbuf.WriteString(`,\"cutoff\":`)\r\n   172\t\t\tif e.Cutoff != nil {\r\n   173\t\t\t\tb, err = json.Marshal(e.Cutoff)\r\n   174\t\t\t\tif err != nil {\r\n   175\t\t\t\t\treturn nil, err\r\n   176\t\t\t\t}\r\n   177\t\t\t} else {\r\n   178\t\t\t\tb = []byte(\"null\")\r\n   179\t\t\t}\r\n   180\t\t\tbuf.Write(b)\r\n   181\t\t\tif e.WatermarkLagSeconds != nil {\r\n   182\t\t\t\tbuf.WriteString(`,\"watermark_lag_seconds\":`)\r\n"]
[14650.940001, "o", "   183\t\t\t\tb, err = json.Marshal(*e.WatermarkLagSeconds)\r\n   184\t\t\t\tif err != nil {\r\n   185\t\t\t\t\treturn nil, err\r\n   186\t\t\t\t}\r\n   187\t\t\t\tbuf.Write(b)\r\n   188\t\t\t}\r\n   189\t\t\tif e.LateBySeconds != nil {"]
[14650.940087, "o", "\r\n   190\t\t\t\tbuf.WriteString(`,\"late_by_seconds\":`)\r\n   191\t\t\t\tb, err = json.Marshal(*e.LateBySeconds)\r\n   192\t\t\t\tif err != nil {\r\n   193\t\t\t\t\treturn nil, err\r\n   194\t\t\t\t}\r\n   195\t\t\t\tbuf.Write(b)\r\n   196\t\t\t}\r\n   197\t\t\tbuf.WriteByte('}')\r\n   198\t\t\treturn buf.Bytes(), nil\r\n   199\t\t}\r\n   200\t\ttype alias auditLogEntry\r\n   201\t\treturn json.Marshal(alias(e))\r\n   202"]
[14650.94018, "o", "\t}\r\n   203\t\r\n   204\ttype winnerArrival struct {\r\n   205\t\tShard string `json:\"shard\"`\r\n   206\t\tLine  int    `json:\"line\"`\r\n   207\t}\r\n   208\t\r\n   209\ttype dedupPolicyStats struct {\r\n   210\t\tPolicy                       string `json:\"policy\"`\r\n   211\t\tDuplicateWinnersSameShard    int    `json:\"duplicate_winners_same_shard\"`\r\n   212\t\tDuplicateWinnersCrossShard   int    `json:\"duplicate_winners_cross_shard\"`\r\n   213\t\tDuplicateWinnersLineTiebreak int    `json:\"duplicate_winners_line_tiebreak\"`\r\n   214\t}\r\n   215\t\r\n   216\ttype auditDigestOutput struct {\r\n   217\t\tSchemaVersion    string            `json:\"schema_version\"`\r\n   218\t\tAuditLog         json.RawMessage   `json:\"audit_log\"`\r\n"]
