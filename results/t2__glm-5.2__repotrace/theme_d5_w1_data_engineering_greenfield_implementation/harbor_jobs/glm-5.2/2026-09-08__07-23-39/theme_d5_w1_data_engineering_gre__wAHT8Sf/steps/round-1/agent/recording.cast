[9076.026593, "o", "   361\t\t\tif v == 1 {\r\n   362\t\t\t\traw, present := obj[\"amount\"]\r\n   363\t\t\t\tif !present {\r\n   364\t\t\t\t\treturn nil, \"missing_amount\"\r\n   365\t\t\t\t}\r\n   366\t\t\t\tvar f float64\r\n   367\t\t\t\tif err := json.Unmarshal(raw, &f); err != nil {\r\n   368\t\t\t\t\treturn nil, \"bad_amount\"\r\n   369\t\t\t\t}\r\n   370\t\t\t\tif !isFinite(f) || f < 0 {\r\n   371\t\t\t\t\treturn nil, \"bad_amount\"\r\n   372\t\t\t\t}\r\n"]
[9076.026794, "o", "   373\t\t\t\tamount = f\r\n   374\t\t\t} else {\r\n   375\t\t\t\traw, present := obj[\"amount_cents\"]\r\n   376\t\t\t\tif !present {\r\n   377\t\t\t\t\treturn nil, \"missing_amount\"\r\n   378\t\t\t\t}\r\n   379\t\t\t\tn, err := getJSONInt(raw)\r\n   380\t\t\t\tif err != nil || n < 0 {\r\n   381\t\t\t\t\treturn nil, \"bad_amount\"\r\n   382\t\t\t\t}\r\n   383\t\t\t\tamount = float64(n) / 100.0\r\n   384\t\t\t}\r\n   385\t\t\tcur, curOk, curPresent := getRawString(obj, \"currency\")\r\n   386\t\t\tif !curPresent {\r\n   387\t\t\t\treturn nil, \"missing_currency\"\r\n   388\t\t\t}\r\n   389\t\t\tif !curOk || cur == \"\" {\r\n   390\t\t\t\treturn nil, \"bad_currency\"\r\n   391\t\t\t}\r\n   392\t\t\trate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)\r\n   393\t\t\tswitch status {\r\n   394\t\t\tcase \"fx_unknown_currency\":\r\n   395\t\t\t\treturn nil, \"fx_unknown_currency\"\r\n   396\t\t\tcase \"missing_rate\":\r\n"]
