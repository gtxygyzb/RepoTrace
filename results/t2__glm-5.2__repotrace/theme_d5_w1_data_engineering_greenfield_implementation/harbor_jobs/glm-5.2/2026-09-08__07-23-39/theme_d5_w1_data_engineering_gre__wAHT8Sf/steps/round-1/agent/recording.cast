[16541.786964, "o", "\r\n     9\ttype rawJSON json.RawMessage\r\n    10\t\r\n    11\tfunc (r rawJSON) MarshalJSON() ([]byte, error) {\r\n    12\t\tif json.Valid(r) {\r\n    13\t\t\treturn r, nil\r\n    14\t\t}\r\n    15\t\treturn json.Marshal(string(r))\r\n    16\t}\r\n    17\t\r\n    18\ttype rawEvent struct {\r\n    19\t\tShard   string\r\n    20\t\tLine    int\r\n    21\t\tRaw     rawJSON\r\n    22\t\tObj     map[string]json.RawMessage\r\n    23\t\tInvalid bool\r\n    24\t\tBlank   bool\r\n    25\t}\r\n    26\t\r\n"]
