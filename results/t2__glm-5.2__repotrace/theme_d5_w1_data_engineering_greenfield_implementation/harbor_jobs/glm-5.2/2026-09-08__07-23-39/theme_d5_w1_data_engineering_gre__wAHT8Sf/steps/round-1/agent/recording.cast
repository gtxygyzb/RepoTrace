[16487.592356, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest != \"\" && cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut == \"\" {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-digest requires --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaStrict && cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut == \"\" {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-strict requires --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out\")\r\n"]
