[5476.823684, "o", "   274\t  Ev    *Event\r\n   275\t}\r\n   276\t\r\n   277\tvar errUsage = errors.New(usageString)\r\n   278\t\r\n   279\tfunc usageError() error {\r\n   280\t  return errUsage\r\n   281\t}\r\n   282\t\r\n   283\tfunc parseTime(s string) (time.Time, error) {\r\n   284\t  t, err := time.Parse(\"2006-01-02T15:04:05Z\", s)\r\n"]
[5476.823738, "o", "   285\t  if err != nil {\r\n   286\t    return time.Time{}, err\r\n   287\t  }\r\n   288\t  return t.UTC(), nil\r\n   289\t}\r\n   290\t\r\n   291\tfunc formatTS(t time.Time) string {\r\n   292\t  return t.UTC().Format(\"2006-01-02T15:04:05Z\")\r\n   293\t}\r\n   294\t\r\n"]
[5476.823788, "o", "   295\tfunc hourKey(t time.Time) string {\r\n   296\t  return t.UTC().Format(\"2006-01-02T15\")\r\n   297\t}\r\n   298\t\r\n   299\tfunc dateKey(t time.Time) string {\r\n   300\t  return t.UTC().Format(\"2006-01-02\")\r\n   301\t}\r\n   302\t\r\n"]
[5476.823841, "o", "   303\tfunc isDate(s string) bool {\r\n   304\t  _, err := time.Parse(\"2006-01-02\", s)\r\n   305\t  return err == nil\r\n   306\t}\r\n   307\t\r\n   308\tfunc getRawString(m map[string]json.RawMessage, key string) (string, bool, bool) {\r\n   309\t  raw, present := m[key]\r\n   310\t  if !present {\r\n   311\t    return \"\", false, false"]
[5476.823894, "o", "\r\n   312\t  }\r\n   313\t  var s string\r\n   314\t  if err := json.Unmarshal(raw, &s); err == nil {\r\n   315\t    return s, true, true\r\n   316\t  }\r\n   317\t  return \"\", false, true\r\n   318\t}\r\n   319\t\r\n   320"]
[5476.823944, "o", "\tfunc rawStringPtr(m map[string]json.RawMessage, key string) *string {\r\n   321\t  s, ok, _ := getRawString(m, key)\r\n   322\t  if !ok {\r\n   323\t    return nil\r\n   324\t  }\r\n   325\t  return &s\r\n   326\t}\r\n   327\t\r\n"]
[5476.823995, "o", "   328\tfunc getString(m map[string]json.RawMessage, keys ...string) (string, bool) {\r\n   329\t  for _, k := range keys {\r\n   330\t    s, ok, _ := getRawString(m, k)\r\n   331\t    if ok {\r\n   332\t      return s, true\r\n   333\t    }\r\n   334\t  }\r\n   335\t  return \"\", false\r\n   336\t}\r\n"]
[5476.824049, "o", "   337\t\r\n   338\tfunc getNumberOrString(raw json.RawMessage) (float64, error) {\r\n   339\t  trimmed := bytes.TrimSpace(raw)\r\n   340\t  if len(trimmed) == 0 {\r\n   341\t    return 0, errors.New(\"empty number\")\r\n   342\t  }\r\n   343\t  if trimmed[0] == '\"' {\r\n   344\t    var s string\r\n   345\t    if err := json.Unmarshal(trimmed, &s); err != nil {\r\n"]
[5476.8241, "o", "   346\t      return 0, err\r\n   347\t    }\r\n   348\t    s = strings.TrimSpace(s)\r\n   349\t    if parts := strings.Fields(s); len(parts) > 0 {\r\n   350\t      s = parts[0]\r\n   351\t    }\r\n   352\t    return strconv.ParseFloat(s, 64)\r\n   353\t  }\r\n   354"]
[5476.824152, "o", "\t  return strconv.ParseFloat(string(trimmed), 64)\r\n   355\t}\r\n   356\t\r\n   357\tfunc isFinite(f float64) bool {\r\n   358\t  return !math.IsInf(f, 0) && !math.IsNaN(f)\r\n   359\t}\r\n   360\t\r\n"]
[5476.82422, "o", "   361\tfunc getJSONInt(raw json.RawMessage) (int64, error) {\r\n   362\t  var n json.Number\r\n   363\t  if err := json.Unmarshal(raw, &n); err != nil {\r\n   364\t    return 0, err\r\n   365\t  }\r\n   366\t  s := string(n)\r\n   367\t  if strings.ContainsAny(s, \".eE\") {\r\n   368\t    return 0, errors.New(\"not an integer\")\r\n   369\t  }\r\n   370\t  return strconv.ParseInt(s, 10, 64)\r\n   371\t}\r\n   372"]
[5476.824273, "o", "\t\r\n   373\tfunc roundMoney(f float64) float64 {\r\n   374\t  abs := math.Abs(f)\r\n   375\t  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n   376\t  if f < 0 && cents != 0 {\r\n   377\t    return -float64(cents) / 100.0\r\n   378\t  }\r\n   379\t  return float64(cents) / 100.0"]
[5476.824325, "o", "\r\n   380\t}\r\n   381\t\r\n   382\tfunc jsonBytes(s string) []byte {\r\n   383\t  b, err := json.Marshal(s)\r\n   384\t  if err != nil {\r\n   385\t    return []byte(`\"\"`)\r\n   386\t  }\r\n   387\t  return b\r\n"]
[5476.824374, "o", "   388\t}\r\n   389\t\r\n   390\tfunc strPtr(s string) *string {\r\n   391\t  return &s\r\n   392\t}\r\n   393\t\r\n   394\tfunc absDur(d time.Duration) time.Duration {\r\n"]
[5476.824426, "o", "   395\t  if d < 0 {\r\n   396\t    return -d\r\n   397\t  }\r\n   398\t  return d\r\n   399\t}\r\n   400\t\r\n   401\tfunc parentDirExists(path string) bool {\r\n   402\t  dir := filepath.Dir(path)\r\n   403\t  if dir == \".\" {\r\n   404\t    return true\r\n"]
[5476.824477, "o", "   405\t  }\r\n   406\t  info, err := os.Stat(dir)\r\n   407\t  return err == nil && info.IsDir()\r\n   408\t}\r\n   409\t\r\n   410\tfunc parseNonNegInt(s string) (int, error) {\r\n   411\t  n, err := strconv.Atoi(s)\r\n   412\t  if err != nil {\r\n"]
[5476.824528, "o", "   413\t    return 0, err\r\n   414\t  }\r\n   415\t  if n < 0 {\r\n   416\t    return 0, errors.New(\"negative\")\r\n   417\t  }\r\n   418\t  return n, nil\r\n   419\t}\r\n"]
[5476.824579, "o", "   420\t\r\n   421\tfunc atomicWriteFile(path string, data []byte) error {\r\n   422\t  tmp := path + \".tmp\"\r\n   423\t  if err := os.WriteFile(tmp, data, 0644); err != nil {\r\n   424\t    os.Remove(tmp)\r\n   425\t    return err\r\n   426\t  }\r\n   427\t  if err := os.Rename(tmp, path); err != nil {\r\n   428\t    os.Remove(tmp)\r\n"]
[5476.824634, "o", "   429\t    return err\r\n   430\t  }\r\n   431\t  return nil\r\n   432\t}\r\n   433\t\r\n   434\tfunc newRateTable() *RateTable {\r\n   435\t  return &RateTable{byDate: map[string]map[string]float64{}, global: map[string]float64{\"USD\": 1.0}}\r\n   436\t}\r\n"]
[5476.824684, "o", "   437\t\r\n   438\tfunc (rt *RateTable) rate(date, currency string) (float64, bool) {\r\n   439\t  if currency == \"USD\" {\r\n   440\t    return 1.0, true\r\n   441\t  }\r\n   442\t  if m, ok := rt.byDate[date]; ok {\r\n   443\t    if r, ok := m[currency]; ok && r > 0 {\r\n"]
[5476.824738, "o", "   444\t      return r, true\r\n   445\t    }\r\n   446\t  }\r\n   447\t  if r, ok := rt.global[currency]; ok && r > 0 {\r\n   448\t    return r, true\r\n   449\t  }\r\n   450\t  return 0, false\r\n   451\t}\r\n   452\t\r\n   453\tfunc parseRateRaw(raw json.RawMessage) (float64, error) {\r\n"]
[5476.824788, "o", "   454\t  var f float64\r\n   455\t  if err := json.Unmarshal(raw, &f); err == nil {\r\n   456\t    if !isFinite(f) {\r\n   457\t      return 0, errors.New(\"bad rate\")\r\n   458\t    }\r\n   459\t    return f, nil\r\n   460\t  }\r\n"]
