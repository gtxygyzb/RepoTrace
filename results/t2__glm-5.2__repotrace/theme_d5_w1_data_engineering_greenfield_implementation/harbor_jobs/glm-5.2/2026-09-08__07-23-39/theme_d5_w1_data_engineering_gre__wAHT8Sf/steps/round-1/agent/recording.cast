[19926.125717, "o", "   441\t\t\t\trunIndex = st.runIndex + 1\r\n   442\t\t\t}\r\n   443\t\t}\r\n   444\t\tevents, blanks, shards, err := readInputEvents(cfg.inputDir)\r\n   445\t\tif err != nil {\r\n   446\t\t\treturn err\r\n   447\t\t}\r\n   448\t\tseen := map[string]bool{}\r\n   449\t\tif st != nil {\r\n"]
[19926.125775, "o", "   450\t\t\tfor k, v := range st.seenIds {\r\n   451\t\t\t\tseen[k] = v\r\n   452\t\t\t}\r\n   453\t\t}\r\n   454\t\tvar pending []pendingEntry\r\n   455\t\topenSessions := map[string]carriedSession{}\r\n   456\t\tif st != nil {\r\n   457\t"]
