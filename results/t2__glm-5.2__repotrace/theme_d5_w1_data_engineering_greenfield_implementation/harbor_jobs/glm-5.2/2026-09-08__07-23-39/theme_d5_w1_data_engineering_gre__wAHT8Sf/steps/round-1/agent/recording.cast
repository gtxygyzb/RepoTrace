[14732.353341, "o", "func buildManifest(cfg cliConfig, runIndex int, ratesDigest string, shards []inputShardInfo, shardAccepted map[string]int, bucketCounts map[string]int, hasMin bool, minTs time.Time, hasMax bool, maxTs time.Time) (manifestOutput, error) {\r\n\tsortedShards := append([]inputShardInfo(nil), shards...)\r\n\tsort.SliceStable(sortedShards, func(i, j int) bool {\r\n\t\treturn sortedShards[i].Name < sortedShards[j].Name\r\n\t})\r\n\tmanifestShards := make([]manifestShard, 0, len(sortedShards))\r\n"]
[14732.353388, "o", "\tfor _, s := range sortedShards {\r\n\t\tmanifestShards = append(manifestShards, manifestShard{\r\n\t\t\tShard:          s.Name,\r\n\t\t\tSHA256:         s.SHA256,\r\n\t\t\tBytes:          s.Bytes,\r\n"]
[14732.353505, "o", "\t\t\tEventsTotal:    s.EventsTotal,\r\n\t\t\tEventsAccepted: shardAccepted[s.Name],\r\n\t\t})\r\n\t}\r\n\toutputs := manifestOutputs{}\r\n\tsummaryOut, err := manifestFileOutputFor(cfg.outputPath)\r\n\tif err != nil {\r\n\t\treturn manifestOutput{}, err\r\n\t}\r\n\trejectsOut, err := manifestFileOutputFor(cfg.rejectsPath)\r\n\tif err != nil {\r\n\t\treturn manifestOutput{}, err\r\n\t}\r\n\toutputs.Summary = summaryOut\r\n\toutputs.Rejects = rejectsOut\r\n\tif cfg.stateOut != \"\" {\r\n\t\tstateOut, err := manifestFileOutputFor(cfg.stateOut)\r\n\t\tif err != nil {\r\n\t\t\treturn manifestOutput{}, err\r\n\t\t}\r\n"]
[14732.353578, "o", "\t\toutputs.State = stateOut\r\n\t}\r\n\tif cfg.auditLog != \"\" {\r\n\t\tlogOut, err := manifestFileOutputFor(cfg.auditLog)\r\n\t\tif err != nil {\r\n"]
[14732.353653, "o", "\t\t\treturn manifestOutput{}, err\r\n\t\t}\r\n\t\toutputs.AuditLog = logOut\r\n\t}\r\n\tif cfg.auditLogDigest != \"\" {\r\n\t\tdigestOut, err := manifestFileOutputFor(cfg.auditLogDigest)\r\n\t\tif err != nil {\r\n\t\t\treturn manifestOutput{}, err\r\n\t\t}\r\n\t\toutputs.AuditDigest = digestOut\r\n\t}\r\n\twindow := manifestWindow{\r\n\t\tEventsAcceptedTotal: bucketCounts[\"accepted\"],\r\n\t\tEventsRejectedTotal: bucketCounts[\"duplicate\"] + bucketCounts[\"invalid\"] + bucketCounts[\"late\"] + bucketCounts[\"unresolved_chargeback\"],\r\n\t\tBucketCounts:        bucketCounts,\r\n\t}\r\n\tif hasMin {\r\n\t"]
[14732.353715, "o", "\tm := formatTS(minTs)\r\n\t\twindow.MinTs = &m\r\n\t}\r\n\tif hasMax {\r\n\t\tm := formatTS(maxTs)\r\n\t\twindow.MaxTs = &m\r\n\t}\r\n\tvar ingestID *string\r\n\tif cfg.ingestIDSet {\r\n\t"]
[14732.353775, "o", "\tid := cfg.ingestID\r\n\t\tingestID = &id\r\n\t}\r\n\treturn manifestOutput{\r\n\t\tSchemaVersion: manifestSchemaVersion,\r\n\t\tIngestID:      ingestID,\r\n\t\tRunIndex:      runIndex,\r\n\t\tRatesDigest:   ratesDigest,\r\n\t\tInputShards:   manifestShards,\r\n"]
[14732.353839, "o", "\t\tOutputs:       outputs,\r\n\t\tWindow:        window,\r\n\t}, nil\r\n}\r\n\r\nfunc bucketCode(bucket string) int {\r\n\tswitch bucket {\r\n\tcase \"accepted\":\r\n\t\treturn 0\r\n\tcase \"duplicate\":\r\n\t\treturn 1\r\n"]
[14732.353899, "o", "\tcase \"invalid\":\r\n\t\treturn 2\r\n\tcase \"late\":\r\n\t\treturn 3\r\n\tcase \"unresolved_chargeback\":\r\n"]
