[16351.990755, "o", "   683\t\t\t}\r\n   684\t\t\tif err := atomicWriteFile(path, buf.Bytes()); err != nil {\r\n   685\t\t\t\tpanic(err)\r\n   686\t\t\t}\r\n   687\t\t\treturn []string{path}\r\n   688\t\t}\r\n   689\t\r\n   690\t\tcurrent := path\r\n   691\t\tvar buf bytes.Buffer\r\n   692\t\tflush := func() {\r\n   693\t\t\tif err := atomicWriteFile(current, buf.Bytes()); err != nil {\r\n"]
