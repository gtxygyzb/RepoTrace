[18489.680876, "o", "   525\t\t\twinners[id] = winner\r\n   526\t\t\twinnerSet[winner] = true\r\n   527\t\t\tsameShard := true\r\n   528\t\t\tfor _, idx := range idxs {\r\n   529\t\t\t\tif candidates[idx].ev.Shard != candidates[winner].ev.Shard {\r\n   530"]
[18489.680952, "o", "\t\t\t\t\tsameShard = false\r\n   531\t\t\t\t\tbreak\r\n   532\t\t\t\t}\r\n   533\t\t\t}\r\n   534\t\t\tif sameShard {\r\n   535\t\t\t\tdedupPolicyStats.DuplicateWinnersSameShard++\r\n   536\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" || tiebreak {\r\n   537\t\t\t\t\tdedupPolicyStats.DuplicateWinnersLineTiebreak++\r\n   538\t\t\t\t}\r\n   539\t\t\t} else {\r\n   540\t\t\t\tdedupPolicyStats.DuplicateWinnersCrossShard++\r\n   541\t\t\t}\r\n   542\t\t}\r\n   543\t\r\n"]
[18489.681036, "o", "   544\t\t// Finalize accepted/duplicate buckets and outputs in arrival order.\r\n   545\t\thasMin, hasMax = false, false\r\n   546\t\tfor _, c := range candidates {\r\n   547\t\t\tif c.ev != nil {\r\n   548\t\t\t\tseen[c.ev.ID] = true\r\n   549\t\t\t}\r\n   550\t\t}\r\n   551\t\tbucketCounts[\"accepted\"] = 0\r\n"]
[18489.681116, "o", "   552\t\tbucketCounts[\"duplicate\"] = duplicateReasons[\"cross_run\"]\r\n   553\t\tfor i, c := range candidates {\r\n   554\t\t\t_ = i\r\n   555\t\t\tif c.ev == nil {\r\n   556\t\t\t\tcontinue\r\n   557\t\t\t}\r\n   558\t\t\tif winnerSet[i] {\r\n   559\t\t\t\tbucketCounts[\"accepted\"]++\r\n   560\t\t\t\tshardAccepted[c.ev.Shard]++\r\n   561\t\t\t\tif !hasMin || c.ev.TS.Before(minTs) {\r\n   562\t\t\t\t\tminTs = c.ev.TS\r\n   563\t\t\t\t\thasMin = true\r\n   564\t\t\t\t}\r\n   565\t\t\t\tif !hasMax || c.ev.TS.After(maxTs) {\r\n   566\t\t\t\t\tmaxTs = c.ev.TS\r\n"]
[18489.681201, "o", "   567\t\t\t\t\thasMax = true\r\n   568\t\t\t\t}\r\n   569\t\t\t\t_ = pending\r\n   570\t\t\t\t_ = openSessions\r\n   571\t\t\t} else {\r\n   572\t\t\t\tbucketCounts[\"duplicate\"]++\r\n   573\t\t\t\tduplicateReasons[\"same_run\"]++\r\n   574\t\t\t\tentry := auditEntries[i]\r\n"]
[18489.681279, "o", "   575\t\t\t\tentry.Bucket = \"duplicate\"\r\n   576\t\t\t\tentry.Reason = \"same_run\"\r\n   577\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n   578\t\t\t\t\tw := winners[entry.ID]\r\n   579\t\t\t\t\tentry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}\r\n   580\t\t\t\t}\r\n   581\t\t\t\tauditEntries[i] = entry\r\n   582\t\t\t}\r\n   583\t\t}\r\n   584\t\r\n   585\t\t// Collect surviving (accepted winner) events for session summary.\r\n   586\t\t"]
[18489.681348, "o", "survivingByUser := map[string][]*Event{}\r\n   587\t\tfor i, c := range candidates {\r\n   588\t\t\tif c.ev != nil && winnerSet[i] {\r\n   589\t\t\t\tsurvivingByUser[c.ev.UserID] = append(survivingByUser[c.ev.UserID], c.ev)\r\n   590\t\t\t}\r\n   591\t\t}\r\n   592\t\tfor u := range survivingByUser {\r\n   593\t\t\tevs := survivingByUser[u]\r\n"]
[18489.68142, "o", "   594\t\t\tsort.SliceStable(evs, func(i, j int) bool {\r\n   595\t\t\t\treturn evs[i].TS.Before(evs[j].TS)\r\n   596\t\t\t})\r\n   597\t\t\tsurvivingByUser[u] = evs\r\n   598\t\t}\r\n   599\t\tsessionTotal := 0\r\n   600\t\tbyUser := make([]summarySessionUser, 0, len(survivingByUser))\r\n"]
