[9328.958463, "o", "     1  package main\r\n     2  \r\n     3  import (\r\n     4  \t\"crypto/sha256\"\r\n     5  \t\"encoding/hex\"\r\n     6  \t\"encoding/json\"\r\n     7  \t\"fmt\"\r\n     8  \t\"math\"\r\n     9  \t\"os\"\r\n"]
[9328.958535, "o", "    10  \t\"path/filepath\"\r\n    11  \t\"strings\"\r\n    12  \t\"time\"\r\n    13  )\r\n    14  \r\n    15  func rawStringPtr(obj map[string]json.RawMessage, key string) *string {\r\n    16  \tif obj == nil {\r\n    17  \t\treturn nil\r\n    18  \t}\r\n    19  \traw, ok := obj[key]\r\n    20  \tif !ok {\r\n    21  \t\treturn nil\r\n    22  \t}\r\n    23  \tvar s string\r\n"]
[9328.958609, "o", "    24  \tif err := json.Unmarshal(raw, &s); err != nil {\r\n    25  \t\treturn nil\r\n    26  \t}\r\n    27  \treturn &s\r\n    28  }\r\n    29  \r\n    30  func getRawString(obj map[string]json.RawMessage, key string) (string, bool, bool) {\r\n    31  \tif obj == nil {\r\n    32  \t\treturn \"\", false, false\r\n    33  \t}\r\n    34  \traw, present := obj[key]\r\n    35  \tif !present {\r\n    36  \t\treturn \"\", false, false\r\n    37  \t}\r\n    38  \tvar s string\r\n    39  \tif err := json.Unmarshal(raw, &s); err != nil {\r\n    40  \t\treturn \"\", false, true\r\n    41  \t}\r\n    42  \treturn s, true, true\r\n    43  }\r\n    44  \r\n    45  func getJSONInt(raw json.RawMessage) (int, error) {\r\n    46  \tvar n int\r\n    47  \tif err := json.Unmarshal(raw, &n); err != nil {\r\n    48  \t\treturn 0, err\r\n    49  \t}\r\n    50  \treturn n, nil\r\n    51  }\r\n    52  \r\n"]
[9328.95868, "o", "    53  func parseTime(s string) (time.Time, error) {\r\n    54  \ts = strings.TrimSpace(s)\r\n    55  \tif strings.HasSuffix(s, \"Z\") {\r\n    56  \t\tif t, err := time.Parse(\"2006-01-02T15:04:05Z\", s); err == nil {\r\n    57  \t\t\treturn t.UTC(), nil\r\n    58  \t\t}\r\n    59  \t\tif t, err := time.Parse(\"2006-01-02T15:04:05.000000000Z\", s); err == nil {\r\n    60  \t\t\treturn t.UTC(), nil\r\n    61  \t\t}\r\n    62  \t}\r\n    63  \tif t, err := time.Parse(time.RFC3339Nano, s); err == nil {\r\n    64  \t\treturn t.UTC(), nil\r\n    65  \t}\r\n    66  \tif t, err := time.Parse(time.RFC3339, s); err == nil {\r\n    67  \t\treturn t.UTC(), nil\r\n    68  \t}\r\n    69  \treturn time.Time{}, fmt.Errorf(\"bad timestamp: %s\", s)\r\n    70  }\r\n"]
[9328.958742, "o", "    71  \r\n    72  func formatTS(t time.Time) string {\r\n    73  \treturn t.UTC().Format(\"2006-01-02T15:04:05Z\")\r\n    74  }\r\n    75  \r\n    76  func dateKey(t time.Time) string {\r\n    77  \treturn t.UTC().Format(\"2006-01-02\")\r\n    78  }\r\n    79  \r\n"]
[9328.958804, "o", "    80  func roundMoney(v float64) float64 {\r\n    81  \tcents := int64(math.Floor(math.Abs(v)*100.0 + 0.5))\r\n    82  \tif v < 0 && cents != 0 {\r\n    83  \t\treturn -float64(cents) / 100.0\r\n    84  \t}\r\n    85  \treturn float64(cents) / 100.0\r\n    86  }\r\n    87  \r\n    88  func isFinite(f float64) bool {\r\n    89  \treturn !math.IsNaN(f) && !math.IsInf(f, 0)\r\n    90  }\r\n    91  \r\n    92  func isDate(s string) bool {\r\n    93  \tif _, err := time.Parse(\"2006-01-02\", s); err != nil {\r\n    94  \t\treturn false\r\n    95  \t}\r\n    96  \treturn true\r\n    97  }\r\n    98  \r\n    99  func sha256Hex(data []byte) string {\r\n   100  \tsum := sha256.Sum256(data)\r\n   101  \treturn hex.EncodeToString(sum[:])\r\n   102  }\r\n   103  \r\n   104  func sha256Short(h string) string {\r\n   105  \tif len(h) < 12 {\r\n   106  \t\treturn h\r\n"]
[9328.958867, "o", "   107  \t}\r\n   108  \treturn h[:12]\r\n   109  }\r\n   110  \r\n   111  func fileDigest(path string) (string, int64, error) {\r\n   112  \tdata, err := os.ReadFile(path)\r\n   113  \tif err != nil {\r\n   114  \t\treturn \"\", 0, err\r\n   115  \t}\r\n   116  \treturn sha256Hex(data), int64(len(data)), nil\r\n   117  }\r\n   118  \r\n   119  func atomicWriteFile(path string, data []byte) error {\r\n   120  \ttmp := path + \".tmp\"\r\n   121  \tif err := os.WriteFile(tmp, data, 0644); err != nil {\r\n   122  \t\treturn err\r\n   123  \t}\r\n   124  \tif err := os.Rename(tmp, path); err != nil {\r\n"]
[9328.95893, "o", "   125  \t\t_ = os.Remove(tmp)\r\n   126  \t\treturn err\r\n   127  \t}\r\n   128  \treturn nil\r\n   129  }\r\n   130  \r\n   131  func parentDirExists(path string) bool {\r\n   132  \tdir := filepath.Dir(path)\r\n   133  \tif dir == \".\" || dir == \"\" {\r\n   134  \t\treturn true\r\n   135  \t}\r\n   136  \tinfo, err := os.Stat(dir)\r\n   137  \tif err != nil {\r\n   138  \t\treturn false\r\n   139  \t}\r\n   140  \treturn info.IsDir()\r\n   141  }\r\n"]
[9328.958987, "o", "   142  \r\n   143  func manifestFileOutputFor(path string) (*manifestFileOutput, error) {\r\n   144  \th, b, err := fileDigest(path)\r\n   145  \tif err != nil {\r\n   146  \t\treturn nil, err\r\n   147  \t}\r\n   148  \treturn &manifestFileOutput{\r\n   149  \t\tPath:        filepath.Base(path),\r\n   150  \t\tSHA256:      h,\r\n   151  \t\tSHA256Short: sha256Short(h),\r\n   152  \t\tBytes:       b,\r\n   153  \t}, nil\r\n   154  }\r\n   155  \r\n   156  func ptrString(s string) *string {\r\n   157  \treturn &s\r\n   158  }\r\n"]
[9328.959052, "o", "   159  \r\n   160  func (ctx *eventContext) IDStr() string {\r\n   161  \tif ctx.ID != nil {\r\n   162  \t\treturn *ctx.ID\r\n   163  \t}\r\n   164  \treturn \"\"\r\n   165  }\r\n"]
[9328.959115, "o", "   166  \r\n   167  func (ctx *eventContext) TSString() string {\r\n   168  \tif ctx.TS != nil {\r\n   169  \t\treturn *ctx.TS\r\n   170  \t}\r\n   171  \treturn \"\"\r\n   172  }\r\n   173  \r\n   174  func (ctx *eventContext) TypeString() string {\r\n   175  \tif ctx.Type != nil {\r\n   176  \t\treturn *ctx.Type\r\n   177  \t}\r\n   178  \treturn \"\"\r\n   179  }\r\n===== manifest.go =====\r\n"]
[9328.959222, "o", "     1  package main\r\n     2  \r\n     3  import (\r\n     4  \t\"encoding/json\"\r\n     5  \t\"path/filepath\"\r\n     6  )\r\n     7  \r\n     8  func writeManifest(path string, m manifestOutput) ([]byte, error) {\r\n     9  \tdata, err := json.MarshalIndent(m, \"\", \"  \")\r\n    10  \tif err != nil {\r\n    11  \t\treturn nil, err\r\n    12  \t}\r\n    13  \tdata = append(data, '\\n')\r\n    14  \tif err := atomicWriteFile(path, data); err != nil {\r\n    15  \t\treturn nil, err\r\n    16  \t}\r\n    17  \treturn data, nil\r\n    18  }\r\n    19  \r\n    20  func writeSignature(path, manifestPath string, manifestData []byte, maxTs *string) error {\r\n    21  \tsig := signatureOutput{\r\n    22  \t\tManifestPath:   filepath.Base(manifestPath),\r\n    23  \t\tManifestSHA256: sha256Hex(manifestData),\r\n    24  \t\tManifestBytes:  int64(len(manifestData)),\r\n"]
[9328.959287, "o", "    25  \t\tSignedAtUTC:    signedAt(maxTs),\r\n    26  \t\tToolVersion:    toolVersion,\r\n    27  \t}\r\n    28  \tdata, err := json.MarshalIndent(sig, \"\", \"  \")\r\n    29  \tif err != nil {\r\n    30  \t\treturn err\r\n    31  \t}\r\n    32  \tdata = append(data, '\\n')\r\n    33  \treturn atomicWriteFile(path, data)\r\n    34  }\r\n    35  \r\n    36  func signedAt(maxTs *string) string {\r\n    37  \tif maxTs != nil {\r\n    38  \t\treturn *maxTs\r\n    39  \t}\r\n    40  \treturn \"1970-01-01T00:00:00Z\"\r\n    41  }\r\n"]
