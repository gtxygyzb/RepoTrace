[14551.999001, "o", "   326\t\t\t} else {\r\n   327\t\t\t\tev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)\r\n   328\t\t\t\tif ev != nil {\r\n   329\t\t\t\t\tif seen[ev.ID] {\r\n"]
[14551.999058, "o", "   330\t\t\t\t\t\tbucket = \"duplicate\"\r\n   331\t\t\t\t\t\treason = \"cross_run\"\r\n   332\t\t\t\t\t\tev = nil\r\n   333\t\t\t\t\t} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {\r\n   334\t\t\t\t\t\tbucket = \"late\"\r\n"]
[14551.999114, "o", "   335\t\t\t\t\t\treason = \"late\"\r\n   336\t\t\t\t\t\tcutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)\r\n   337\t\t\t\t\t\tentry := auditLogEntry{\r\n   338\t\t\t\t\t\t\tShard:  raw.Shard,\r\n"]
[14551.99917, "o", "   339\t\t\t\t\t\t\tLine:   raw.Line,\r\n   340\t\t\t\t\t\t\tID:     ctx.IDStr(),\r\n   341\t\t\t\t\t\t\tTS:     ctx.TSString(),\r\n   342\t\t\t\t\t\t\tType:   ctx.TypeString(),\r\n"]
