[18489.393472, "o", "   420\t\t\tvar lateCutoff *cutoffObject\r\n   421\t\t\tvar lateLag, lateBySec *int\r\n   422\t\t\tif raw.Invalid {\r\n   423\t\t\t\tbucket = \"invalid\"\r\n   424\t\t\t\treason = \"invalid_json\"\r\n   425\t\t\t} else {\r\n   426\t\t\t\tev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)\r\n   427\t\t\t\tif ev != nil {\r\n   428\t\t\t\t\tif seen[ev.ID] {\r\n   429\t\t\t\t\t\tbucket = \"duplicate\"\r\n   430\t\t\t\t\t\treason = \"cross_run\"\r\n   431\t\t\t\t\t\tev = nil\r\n   432\t\t\t\t\t} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {\r\n   433\t\t\t\t\t\tbucket = \"late\"\r\n   434\t\t\t\t\t\treason = \"late\"\r\n   435\t\t\t\t\t\tcutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)\r\n   436\t\t\t\t"]
[18489.393559, "o", "\t\tlateCutoff = ptrCutoff(formatCutoffObject(cutoff))\r\n   437\t\t\t\t\t\tif cfg.strictLateAudit {\r\n   438\t\t\t\t\t\t\tlag := cfg.watermarkLag\r\n   439\t\t\t\t\t\t\tlateBy := int(lateCutoff.EpochSeconds - int(epochSeconds(ev.TS)))\r\n"]
[18489.393636, "o", "   440\t\t\t\t\t\t\tlateLag = &lag\r\n   441\t\t\t\t\t\t\tlateBySec = &lateBy\r\n   442\t\t\t\t\t\t}\r\n   443\t\t\t\t\t\tev = nil\r\n   444\t\t\t\t\t} else {\r\n   445\t\t\t\t\t\tbucket = \"accepted\"\r\n   446\t\t\t\t\t\tif ev.TS.After(watermark) {\r\n   447\t\t\t\t\t\t\twatermark = ev.TS\r\n   448\t\t\t\t\t\t\thasWatermark = true\r\n   449\t\t\t\t\t\t}\r\n   450\t\t\t\t\t}\r\n   451\t\t\t\t} else {\r\n   452\t\t\t\t\tbucket = \"invalid\"\r\n   453\t\t\t\t}\r\n   454\t\t\t}\r\n   455\t\t\tif bucket == \"invalid\" {\r\n   456"]
[18489.393712, "o", "\t\t\t\tinvalidReasons[reason]++\r\n   457\t\t\t}\r\n   458\t\t\tbucketCounts[bucket]++\r\n   459\t\t\tif bucket == \"duplicate\" && reason == \"cross_run\" {\r\n   460\t\t\t\tduplicateReasons[\"cross_run\"]++\r\n   461\t\t\t}\r\n   462\t\t\tcandidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})\r\n   463\t\t\tauditEntries = append(auditEntries, auditLogEntry{\r\n   464\t\t\t\tShard:               raw.Shard,\r\n   465\t\t\t\tLine:                raw.Line,\r\n   466\t\t\t\tID:                  ctx.IDStr(),\r\n   467"]
[18489.393784, "o", "\t\t\t\tTS:                  ctx.TSString(),\r\n   468\t\t\t\tType:                ctx.TypeString(),\r\n   469\t\t\t\tBucket:              bucket,\r\n   470\t\t\t\tReason:              reason,\r\n   471\t\t\t\tEvent:               raw.Raw,\r\n   472\t\t\t\tCutoff:              lateCutoff,\r\n   473\t\t\t\tWatermarkLagSeconds: lateLag,\r\n   474\t\t\t\tLateBySeconds:       lateBySec,\r\n   475\t\t\t})\r\n   476\t\t}\r\n   477"]
[18489.393858, "o", "\t\r\n   478\t\t// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.\r\n   479\t\tgroups := map[string][]int{}\r\n   480\t\tfor i, c := range candidates {\r\n   481\t\t\tif c.ev != nil {\r\n   482\t\t\t\tgroups[c.ev.ID] = append(groups[c.ev.ID], i)\r\n   483\t\t\t}\r\n   484\t\t}\r\n   485\t\twinnerSet := map[int]bool{}\r\n   486\t\twinners := map[string]int{}\r\n   487\t\tvar dedupPolicyStats dedupPolicyStats\r\n"]
[18489.393935, "o", "   488\t\tdedupPolicyStats.Policy = cfg.dedupPolicy\r\n   489\t\tfor id, idxs := range groups {\r\n   490\t\t\tif len(idxs) < 2 {\r\n   491\t\t\t\tif len(idxs) == 1 {\r\n   492\t\t\t\t\twinners[id] = idxs[0]\r\n   493\t\t\t\t\twinnerSet[idxs[0]] = true\r\n   494\t\t\t\t}\r\n   495\t\t\t\tcontinue\r\n   496\t\t\t}\r\n   497\t\t\twinner := idxs[0]\r\n   498\t\t\ttiebreak := false\r\n   499"]
[18489.394009, "o", "\t\t\tfor _, idx := range idxs[1:] {\r\n   500\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n   501\t\t\t\t\tif arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n   502\t\t\t\t\t\twinner = idx\r\n   503\t\t\t\t\t}\r\n   504\t\t\t\t} else {\r\n   505\t\t\t\t\tcts := candidates[idx].ctx.TSString()\r\n   506\t\t\t\t\twts := candidates[winner].ctx.TSString()\r\n   507\t\t\t\t\tif cts > wts {\r\n"]
[18489.394085, "o", "   508\t\t\t\t\t\twinner = idx\r\n   509\t\t\t\t\t\ttiebreak = false\r\n   510\t\t\t\t\t} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n   511\t\t\t\t\t\twinner = idx\r\n"]
[18489.39416, "o", "   512\t\t\t\t\t\ttiebreak = true\r\n   513\t\t\t\t\t}\r\n   514\t\t\t\t}\r\n   515\t\t\t}\r\n   516\t\t\tif cfg.dedupPolicy == \"lex-largest-ts\" {\r\n   517\t\t\t\twts := candidates[winner].ctx.TSString()\r\n   518\t\t\t\tfor _, idx := range idxs {\r\n   519\t\t\t\t\tif idx != winner && candidates[idx].ctx.TSString() == wts {\r\n   520\t\t\t\t\t\ttiebreak = true\r\n"]
