[20337.8506, "i", "cat > run_provenance.go <<'EOF'\npackage main\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nconst (\n\trunProvenanceSchemaVersion         = \"eventq.run-provenance/v1\"\n\trunProvenanceDigestSchemaVersion  = \"eventq.run-provenance-digest/v1\"\n\temptySHA256                       = \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n)\n\nvar runProvenanceFlagOrder = []string{\n\t\"input-dir\",\n\t\"rates\",\n\t\"output\",\n\t\"rejects\",\n\t\"session-gap\",\n\t\"watermark-lag\",\n\t\"state-in\",\n\t\"state-out\",\n\t\"pending-ttl\",\n\t\"max-open-sessions\",\n\t\"state-strict\",\n\t\"audit-log\",\n\t\"audit-log-digest\",\n\t\"audit-log-rotate-bytes\",\n\t\"rates-strict\",\n\t\"rates-max-staleness\",\n\t\"ingest-id\",\n\t\"out-parquet-manifest\",\n\t\"manifest-signature\",\n\t\"dedup-policy\",\n\t\"strict-late-audit\",\n\t\"summary-schema-out\",\n\t\"summary-schema-digest\",\n\t\"summary-schema-strict\",\n\t\"summary-schema-index\",\n\t\"rejects-format\",\n\t\"rejects-format-header\",\n\t\"session-policy\",\n\t\"fixed-window-seconds\",\n\t\"sharding-report\",\n\t\"sharding-report-digest\",\n\t\"sharding-"]
[20337.850874, "i", "report-index\",\n\t\"sharding-report-histogram\",\n\t\"sharding-report-sort\",\n\t\"sharding-report-strict\",\n\t\"run-provenance\",\n\t\"run-provenance-digest\",\n\t\"run-provenance-strict\",\n}\n\nfunc writeRunProvenanceSidecars(cfg cliConfig, shards []inputShardInfo) error {\n\tif cfg.runProvenance == \"\" {\n\t\treturn nil\n\t}\n\tprovenance := buildRunProvenance(cfg, shards)\n\tdata := marshalOrderedIndent(provenance)\n\tdata = append(data, '\\n')\n\tif err := atomicWriteFile(cfg.runProvenance, data); err != nil {\n\t\treturn err\n\t}\n\tif cfg.runProvenanceDigest != \"\" {\n\t\th, b, err := fileDigest(cfg.runProvenance)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tdigest := []orderedJSON{\n\t\t\t{key: \"schema_version\", value: runProvenanceDigestSchemaVersion},\n\t\t\t{key: \"provenance_path\", value: filepath.Base(cfg.runProvenance)},\n\t\t\t{key: \"provenance_sha256\", value: h},\n\t\t\t{key: \"provenance_bytes\", value: b},\n\t\t\t{key: \"tool_version\", value: toolVersion},\n\t\t}\n\t\tdigestData := marshalOrderedIndent(digest)\n\t\tdigestData = append(digestData, '\\n')\n\t\tif err := atomicWriteFile(cf"]
[20337.850977, "i", "g.runProvenanceDigest, digestData); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc buildRunProvenance(cfg cliConfig, shards []inputShardInfo) []orderedJSON {\n\tentries := []orderedJSON{\n\t\t{key: \"schema_version\", value: runProvenanceSchemaVersion},\n\t\t{key: \"tool_version\", value: toolVersion},\n\t\t{key: \"flags\", value: buildRunProvenanceFlags(cfg)},\n\t\t{key: \"inputs_fingerprint\", value: inputsFingerprint(shards)},\n\t\t{key: \"shard_count\", value: len(shards)},\n\t}\n\tif cfg.runProvenanceStrict {\n\t\tentries = append(entries,\n\t\t\torderedJSON{key: \"argv_sha256\", value: argvSHA256(os.Args[1:])},\n\t\t\torderedJSON{key: \"env_fingerprint\", value: envFingerprint()},\n\t\t)\n\t}\n\treturn entries\n}\n\nfunc buildRunProvenanceFlags(cfg cliConfig) []orderedJSON {\n\tvar entries []orderedJSON\n\tfor _, name := range runProvenanceFlagOrder {\n\t\tif !cfg.observedFlags[name] {\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, orderedJSON{key: name, value: runProvenanceFlagValue(cfg, name)})\n\t}\n\treturn entries\n}\n\nfunc runProvenanceFlagValue(cfg cliConfig, "]
