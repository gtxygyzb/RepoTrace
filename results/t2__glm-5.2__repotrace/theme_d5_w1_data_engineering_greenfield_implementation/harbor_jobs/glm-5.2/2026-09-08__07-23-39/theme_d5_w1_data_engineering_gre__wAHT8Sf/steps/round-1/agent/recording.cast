[5468.614911, "o", "   576\tfunc readInputEvents(inputDir string) ([]rawEvent, error) {\r\n   577\t  info, err := os.Stat(inputDir)\r\n   578\t  if err != nil {\r\n   579\t    return nil, err\r\n   580\t  }\r\n   581\t  if !info.IsDir() {\r\n   582\t    return nil, errors.New(\"input-dir is not a directory\")\r\n   583\t  }\r\n   584\t  entries, err := os.ReadDir(inputDir)\r\n   585\t  if err != nil {\r\n   586\t    return nil, err\r\n   587\t  }\r\n   588\t  var files []string\r\n   589\t  for _, e := range entries {\r\n   590\t    if e.IsDir() || !e.Type().IsRegular() {\r\n   591\t      continue\r\n   592\t    }\r\n   593\t    files = append(files, e.Name())\r\n   594\t  }\r\n   595\t  sort.Strings(files)\r\n"]
[5468.615016, "o", "   596\t  var events []rawEvent\r\n   597\t  for _, name := range files {\r\n   598\t    data, err := os.ReadFile(filepath.Join(inputDir, name))\r\n   599\t    if err != nil {\r\n   600\t      return nil, err\r\n   601\t    }\r\n   602\t    lineNo := 0\r\n   603\t    for _, line := range bytes.Split(data, []byte{'\\n'}) {\r\n   604\t      lineNo++\r\n   605\t      trimmed := bytes.TrimSpace(line)\r\n   606\t      if len(trimmed) == 0 {\r\n   607\t        continue\r\n   608\t      }\r\n   609\t      var obj map[string]json.RawMessage\r\n   610\t      if err := json.Unmarshal(trimmed, &obj); err != nil {\r\n   611\t        continue\r\n   612\t      }\r\n   613\t      events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: json.RawMessage(trimmed), Obj: obj})\r\n"]
[5468.615152, "o", "   614\t    }\r\n   615\t  }\r\n   616\t  return events, nil\r\n   617\t}\r\n   618\t\r\n   619\tfunc newContext(raw rawEvent) *eventContext {\r\n   620\t  ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n   621\t  ctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n   622\t  ctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n   623\t  ctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n   624\t  return ctx\r\n   625\t}\r\n   626\t\r\n"]
