[20173.065333, "o", "   118\t\t\t} else {\r\n   119\t\t\t\tbuf.WriteString(\"false\")\r\n   120\t\t\t}\r\n   121\t\tcase nil:\r\n   122\t\t\tbuf.WriteString(\"null\")\r\n"]
[20173.065389, "o", "   123\t\tcase orderedJSON:\r\n   124\t\t\twriteOrderedIndentValue(buf, val.value, indent)\r\n   125\t\tdefault:\r\n   126\t\t\tb, _ := json.Marshal(val)\r\n   127\t\t\tbuf.Write(b)\r\n   128\t\t}\r\n   129\t}\r\n   130\t\r\n   131\tfunc writeOrderedIndentObject(buf *bytes.Buffer, entries []orderedJSON, indent int) {\r\n   132\t\tif len(entries) == 0 {\r\n"]
