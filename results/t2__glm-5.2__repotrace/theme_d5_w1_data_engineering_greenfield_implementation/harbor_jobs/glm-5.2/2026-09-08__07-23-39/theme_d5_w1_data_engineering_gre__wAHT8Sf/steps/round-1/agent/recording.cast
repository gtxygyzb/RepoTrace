[12916.599656, "o", "summaryData, err := json.MarshalIndent(summary, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tsummaryData = append(summaryData, '\\n')\r\n\tif err := atomicWriteFile(cfg.outputPath, summaryData); err != nil {\r\n\t\treturn err\r\n\t}\r\n\trejectsData := buildRejects(rejectRecords, cfg.dedupPolicy)\r\n\tif err := atomicWriteFile(cfg.rejectsPath, rejectsData); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif cfg.stateOut != \"\" {\r\n\t\tstateData := buildStateOut(watermark, hasWatermark, st, sortedSeenIDs(seen), sortedPending(pending), sortedOpenSessions(openSessions), runIndex)\r\n\t\tif err := atomicWriteFile(cfg.stateOut, stateData); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\tvar auditSegmentPaths []string\r\n\tif cfg.auditLog != \"\" {\r\n\t\tauditSegmentPaths = writeAuditLog(cfg.auditLog, auditEntries, cfg.auditLogRotateBytes)\r\n\t}\r\n\tif cfg.auditLogDigest != \"\" {\r\n\t\tdigest := auditDigestOutput{\r\n\t\t\tSchemaVersion:    \"eventq.digest/v1\",\r\n\t\t\tTotalRecords:     len(auditEntries),\r\n\t\t\tBucketCounts:     bucketCounts,\r\n\t\t\tInvalidReasons:   invalidReasons,\r\n\t\t\tDup"]
