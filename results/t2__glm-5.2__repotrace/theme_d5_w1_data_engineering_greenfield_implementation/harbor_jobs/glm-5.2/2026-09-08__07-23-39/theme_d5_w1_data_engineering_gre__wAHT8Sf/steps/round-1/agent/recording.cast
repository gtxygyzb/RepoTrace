[5099.69232, "o", "      events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: json.RawMessage(trimmed), Obj: obj})\r\n\u001b[?2004l\r"]
[5099.692387, "o", "\u001b[?2004h> "]
[5099.692441, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.692496, "o", ">   }\r\n\u001b[?2004l\r"]
[5099.692552, "o", "\u001b[?2004h> "]
[5099.692673, "o", "  return events, nil\r\n\u001b[?2004l\r"]
[5099.692728, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[5099.692792, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5099.692852, "o", "\u001b[?2004h> "]
[5099.693118, "o", "func newContext(raw rawEvent) *eventContext {\r\n\u001b[?2004l\r"]
[5099.693173, "o", "\u001b[?2004h> "]
[5099.693655, "o", "  ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n\u001b[?2004l\r"]
[5099.69372, "o", "\u001b[?2004h> "]
[5099.693931, "o", "  ctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n\u001b[?2004l\r"]
[5099.693986, "o", "\u001b[?2004h> "]
[5099.694213, "o", "  ctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n\u001b[?2004l\r"]
[5099.694272, "o", "\u001b[?2004h> "]
[5099.694526, "o", "  ctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n\u001b[?2004l\r"]
[5099.694649, "o", "\u001b[?2004h> "]
[5099.69471, "o", "  return ctx\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.694765, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.694825, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.694891, "o", "> "]
[5099.695295, "o", "func parseEvent(ctx *eventContext, rt *RateTable) (*Event, string) {\r\n\u001b[?2004l\r"]
[5099.695363, "o", "\u001b[?2004h> "]
[5099.695458, "o", "  obj := ctx.Obj\r\n\u001b[?2004l\r"]
[5099.695513, "o", "\u001b[?2004h> "]
[5099.69564, "o", "  raw, ok := obj[\"v\"]\r\n\u001b[?2004l\r"]
[5099.695694, "o", "\u001b[?2004h> "]
[5099.695759, "o", "  if !ok {\r\n\u001b[?2004l\r"]
[5099.695813, "o", "\u001b[?2004h> "]
[5099.696001, "o", "    return nil, \"schema_version\"\r\n\u001b[?2004l\r"]
[5099.696057, "o", "\u001b[?2004h> "]
[5099.696112, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.696171, "o", "> "]
[5099.696235, "o", "  var v int\r\n\u001b[?2004l\r"]
[5099.69629, "o", "\u001b[?2004h> "]
[5099.696549, "o", "  if err := json.Unmarshal(raw, &v); err != nil {\r\n\u001b[?2004l\r"]
[5099.696638, "o", "\u001b[?2004h> "]
[5099.696791, "o", "    return nil, \"schema_version\"\r\n\u001b[?2004l\r"]
[5099.696846, "o", "\u001b[?2004h> "]
[5099.696902, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.696958, "o", "> "]
[5099.697063, "o", "  if v != 1 && v != 2 {\r\n\u001b[?2004l\r"]
[5099.697127, "o", "\u001b[?2004h> "]
[5099.697314, "o", "    return nil, \"schema_version\"\r\n\u001b[?2004l\r"]
[5099.69737, "o", "\u001b[?2004h> "]
[5099.697427, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.697483, "o", "> "]
[5099.697695, "o", "  id, idOk, _ := getRawString(obj, \"id\")\r\n\u001b[?2004l\r"]
[5099.697752, "o", "\u001b[?2004h> "]
[5099.697895, "o", "  if !idOk || id == \"\" {\r\n\u001b[?2004l\r"]
[5099.697954, "o", "\u001b[?2004h> "]
[5099.698114, "o", "    return nil, \"missing_id\"\r\n\u001b[?2004l\r"]
[5099.698205, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[5099.698263, "o", "\u001b[?2004h> "]
[5099.698506, "o", "  tsStr, tsOk, _ := getRawString(obj, \"ts\")\r\n\u001b[?2004l\r"]
[5099.69856, "o", "\u001b[?2004h> "]
[5099.698639, "o", "  if !tsOk {\r\n\u001b[?2004l\r"]
[5099.698694, "o", "\u001b[?2004h> "]
[5099.698856, "o", "    return nil, \"missing_ts\"\r\n\u001b[?2004l\r"]
[5099.698905, "o", "\u001b[?2004h> "]
[5099.698964, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.699031, "o", "> "]
[5099.699123, "o", "  t, err := parseTime(tsStr)\r\n\u001b[?2004l\r"]
[5099.699179, "o", "\u001b[?2004h> "]
[5099.699248, "o", "  if err != nil {\r\n\u001b[?2004l\r"]
[5099.699304, "o", "\u001b[?2004h> "]
[5099.699393, "o", "    return nil, \"bad_ts\"\r\n\u001b[?2004l\r"]
[5099.699448, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[5099.699507, "o", "\u001b[?2004h> "]
[5099.699698, "o", "  typeStr, typeOk, _ := getRawString(obj, \"type\")\r\n\u001b[?2004l\r"]
[5099.699759, "o", "\u001b[?2004h> "]
[5099.69982, "o", "  if !typeOk {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.699879, "o", "> "]
[5099.699972, "o", "    return nil, \"missing_type\"\r\n\u001b[?2004l\r"]
[5099.700027, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[5099.700083, "o", "\u001b[?2004h> "]
[5099.700151, "o", "  switch typeStr {\r\n\u001b[?2004l\r"]
[5099.700218, "o", "\u001b[?2004h> "]
[5099.700461, "o", "  case \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.700527, "o", ">   default:\r\n\u001b[?2004l\r"]
[5099.700582, "o", "\u001b[?2004h> "]
[5099.700689, "o", "    return nil, \"bad_type\"\r\n\u001b[?2004l\r"]
[5099.700744, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[5099.700799, "o", "\u001b[?2004h> "]
[5099.700993, "o", "  user, userOk, _ := getRawString(obj, \"user_id\")\r\n\u001b[?2004l\r"]
[5099.701048, "o", "\u001b[?2004h> "]
[5099.701157, "o", "  if !userOk || user == \"\" {\r\n\u001b[?2004l\r"]
[5099.701227, "o", "\u001b[?2004h> "]
[5099.701331, "o", "    return nil, \"missing_user\"\r\n\u001b[?2004l\r"]
[5099.701388, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[5099.701468, "o", "\u001b[?2004h> "]
[5099.701862, "o", "  ev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n\u001b[?2004l\r"]
[5099.701923, "o", "\u001b[?2004h> "]
[5099.702003, "o", "  switch typeStr {\r\n\u001b[?2004l\r"]
[5099.702057, "o", "\u001b[?2004h> "]
[5099.702164, "o", "  case \"purchase\", \"refund\":\r\n\u001b[?2004l\r"]
[5099.70223, "o", "\u001b[?2004h> "]
[5099.702307, "o", "    var amount float64\r\n\u001b[?2004l\r"]
[5099.702363, "o", "\u001b[?2004h> "]
[5099.702413, "o", "    if v == 1 {\r\n\u001b[?2004l\r"]
[5099.702474, "o", "\u001b[?2004h> "]
[5099.702607, "o", "      raw, present := obj[\"amount\"]\r\n\u001b[?2004l\r"]
[5099.702662, "o", "\u001b[?2004h> "]
[5099.702733, "o", "      if !present {\r\n\u001b[?2004l\r"]
[5099.702788, "o", "\u001b[?2004h> "]
[5099.702927, "o", "        return nil, \"missing_amount\"\r\n\u001b[?2004l\r"]
[5099.702981, "o", "\u001b[?2004h> "]
[5099.703037, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5099.703125, "o", "      var f float64\r\n\u001b[?2004l\r"]
[5099.70318, "o", "\u001b[?2004h> "]
[5099.703394, "o", "      if err := json.Unmarshal(raw, &f); err != nil {\r\n\u001b[?2004l\r"]
[5099.703451, "o", "\u001b[?2004h> "]
[5099.703567, "o", "        return nil, \"bad_amount\"\r\n\u001b[?2004l\r"]
[5099.703628, "o", "\u001b[?2004h> "]
[5099.703683, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5099.703823, "o", "      if !isFinite(f) || f < 0 {\r\n\u001b[?2004l\r"]
[5099.703878, "o", "\u001b[?2004h> "]
[5099.704, "o", "        return nil, \"bad_amount\"\r\n\u001b[?2004l\r"]
[5099.704056, "o", "\u001b[?2004h> "]
[5099.704111, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5099.704186, "o", "      amount = f\r\n\u001b[?2004l\r"]
[5099.704251, "o", "\u001b[?2004h> "]
[5099.704306, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.704358, "o", "> "]
[5099.704512, "o", "      raw, present := obj[\"amount_cents\"]\r\n\u001b[?2004l\r"]
[5099.704556, "o", "\u001b[?2004h> "]
[5099.704648, "o", "      if !present {\r\n\u001b[?2004l\r"]
[5099.704703, "o", "\u001b[?2004h> "]
[5099.704853, "o", "        return nil, \"missing_amount\"\r\n\u001b[?2004l\r"]
[5099.704908, "o", "\u001b[?2004h> "]
[5099.704967, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.705026, "o", "> "]
[5099.705127, "o", "      n, err := getJSONInt(raw)\r\n\u001b[?2004l\r"]
[5099.705184, "o", "\u001b[?2004h> "]
[5099.705307, "o", "      if err != nil || n < 0 {\r\n\u001b[?2004l\r"]
[5099.705363, "o", "\u001b[?2004h> "]
[5099.705487, "o", "        return nil, \"bad_amount\"\r\n\u001b[?2004l\r"]
[5099.705543, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
[5099.70561, "o", "\u001b[?2004h> "]
[5099.705743, "o", "      amount = float64(n) / 100.0\r\n\u001b[?2004l\r"]
[5099.705799, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5099.70587, "o", "\u001b[?2004h> "]
[5099.706096, "o", "    cur, curOk, curPresent := getRawString(obj, \"currency\")\r\n\u001b[?2004l\r"]
[5099.706152, "o", "\u001b[?2004h> "]
[5099.706231, "o", "    if !curPresent {\r\n\u001b[?2004l\r"]
[5099.706287, "o", "\u001b[?2004h> "]
[5099.706423, "o", "      return nil, \"missing_currency\"\r\n\u001b[?2004l\r"]
[5099.706477, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5099.706537, "o", "\u001b[?2004h> "]
[5099.706651, "o", "    if !curOk || cur == \"\" {\r\n\u001b[?2004l\r"]
[5099.706709, "o", "\u001b[?2004h> "]
[5099.706826, "o", "      return nil, \"bad_currency\"\r\n\u001b[?2004l\r"]
[5099.706881, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5099.706937, "o", "\u001b[?2004h> "]
[5099.707092, "o", "    r, ok := rt.rate(dateKey(t), cur)\r\n\u001b[?2004l\r"]
[5099.707147, "o", "\u001b[?2004h> "]
[5099.707212, "o", "    if !ok {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.707268, "o", "> "]
[5099.707362, "o", "      return nil, \"fx_lookup\"\r\n\u001b[?2004l\r"]
[5099.707417, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5099.707474, "o", "\u001b[?2004h> "]
[5099.70757, "o", "    usd := amount * r\r\n\u001b[?2004l\r"]
[5099.707621, "o", "\u001b[?2004h> "]
[5099.707756, "o", "    if typeStr == \"refund\" {\r\n\u001b[?2004l\r"]
[5099.707812, "o", "\u001b[?2004h> "]
[5099.707869, "o", "      usd = -usd\r\n\u001b[?2004l\r"]
[5099.707938, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[5099.707995, "o", "\u001b[?2004h> "]
[5099.708073, "o", "    ev.Amount = amount\r\n\u001b[?2004l\r"]
[5099.708128, "o", "\u001b[?2004h> "]
[5099.708213, "o", "    ev.Currency = cur\r\n\u001b[?2004l\r"]
[5099.708269, "o", "\u001b[?2004h> "]
[5099.708372, "o", "    ev.USD = roundMoney(usd)\r\n\u001b[?2004l\r"]
[5099.708427, "o", "\u001b[?2004h> "]
[5099.708501, "o", "  case \"chargeback\":\r\n\u001b[?2004l\r"]
[5099.708557, "o", "\u001b[?2004h> "]
[5099.708778, "o", "    ref, refOk, refPresent := getRawString(obj, \"ref_id\")\r\n\u001b[?2004l\r"]
[5099.708833, "o", "\u001b[?2004h> "]
[5099.708999, "o", "    if !refPresent || !refOk || ref == \"\" {\r\n\u001b[?2004l\r"]
[5099.709074, "o", "\u001b[?2004h> "]
[5099.709187, "o", "      return nil, \"missing_ref_id\"\r\n\u001b[?2004l\r"]
[5099.709248, "o", "\u001b[?2004h> "]
[5099.709306, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5099.709388, "o", "    ev.RefID = ref\r\n\u001b[?2004l\r"]
[5099.709443, "o", "\u001b[?2004h> "]
[5099.709503, "o", "    ev.USD = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.709563, "o", "> "]
[5099.70962, "o", "  case \"login\", \"signup\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5099.709678, "o", "    ev.USD = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.709733, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5099.709794, "o", "  return ev, \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[5099.709854, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
