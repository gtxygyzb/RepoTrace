[5460.124121, "o", "package main\r\n\r\nimport (\r\n  \"bytes\"\r\n  \"crypto/sha256\"\r\n  \"encoding/hex\"\r\n"]
[5460.124258, "o", "  \"encoding/json\"\r\n  \"errors\"\r\n  \"fmt\"\r\n  \"math\"\r\n  \"os\"\r\n  \"path/filepath\"\r\n  \"sort\"\r\n  \"strconv\"\r\n  \"strings\"\r\n  \"time\"\r\n)\r\n\r\nvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--audit-log <path>] [--audit-log-digest <path>]\\n\"\r\n\r\ntype Money float64\r\n\r\nfunc (m Money) MarshalJSON() ([]byte, error) {\r\n"]
[5460.124326, "o", "  return []byte(m.String()), nil\r\n}\r\n\r\nfunc (m Money) String() string {\r\n  f := float64(m)\r\n  abs := math.Abs(f)\r\n  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n  neg := f < 0 && cents != 0\r\n  dollars := cents / 100\r\n  rem := cents % 100\r\n  s := fmt.Sprintf(\"%d.%02d\", dollars, rem)"]
[5460.124387, "o", "\r\n  if neg {\r\n    s = \"-\" + s\r\n  }\r\n  return s\r\n}\r\n\r\ntype Event struct {\r\n  ID       string\r\n  Type     string\r\n"]
[5460.124443, "o", "  TS       time.Time\r\n  UserID   string\r\n  Amount   float64\r\n  Currency string\r\n  RefID    string\r\n  USD      float64\r\n  RefUSD   float64\r\n  Raw      json.RawMessage\r\n  Shard    string\r\n  Line     int\r\n"]
[5460.124499, "o", "}\r\n\r\ntype Reject struct {\r\n  Bucket int             `json:\"bucket\"`\r\n  Reason string          `json:\"reason\"`\r\n  Event  json.RawMessage `json:\"event\"`\r\n}\r\n\r\n"]
[5460.124552, "o", "type ShardLine struct {\r\n  Shard string\r\n  Line  int\r\n  Data  []byte\r\n}\r\n\r\ntype RateTable struct {\r\n  byDate map[string]map[string]float64\r\n  global map[string]float64\r\n}\r\n"]
[5460.124605, "o", "\r\ntype pendingEntry struct {\r\n  id        string\r\n  ts        time.Time\r\n  user      string\r\n  usd       float64\r\n  originRun int\r\n  retired   bool\r\n"]
[5460.124658, "o", "}\r\n\r\ntype carriedSession struct {\r\n  user         string\r\n  lastTs       time.Time\r\n  sessionIndex int\r\n  startTs      time.Time\r\n}\r\n\r\ntype loadedState struct {\r\n  version              int\r\n  hasMax               bool\r\n"]
[5460.12471, "o", "  maxTs                time.Time\r\n  seenIds              map[string]bool\r\n  pending              []pendingEntry\r\n  openSessions         map[string]carriedSession\r\n  runIndex             int\r\n  carryInPending       int\r\n  carryInOpenSessions  int\r\n  ttlDropped           int\r\n}\r\n\r\ntype stateStats struct {\r\n"]
[5460.124765, "o", "  CarryInPending      int `json:\"carry_in_pending\"`\r\n  CarryOutPending     int `json:\"carry_out_pending\"`\r\n  RetiredThisRun      int `json:\"retired_this_run\"`\r\n  TtlDropped          int `json:\"ttl_dropped\"`\r\n  CrossRunDuplicates  int `json:\"cross_run_duplicates\"`\r\n  OpenSessionsCarried int `json:\"open_sessions_carried\"`\r\n  OpenSessionsExtended int `json:\"open_sessions_extended\"`\r\n  OpenSessionsEvicted int `json:\"open_sessions_evicted\"`\r\n  RunIndex            int `json:\"run_index\"`\r\n}\r\n\r\n"]
[5460.124819, "o", "type eventTypeStats struct {\r\n  Count    int   `json:\"count\"`\r\n  TotalUSD Money `json:\"total_usd\"`\r\n  AvgUSD   Money `json:\"avg_usd\"`\r\n}\r\n\r\ntype hourStats struct {\r\n  Count    int   `json:\"count\"`\r\n  TotalUSD Money `json:\"total_usd\"`\r\n}\r\n\r\ntype sessionsOut struct {\r\n"]
[5460.124888, "o", "  Total  int            `json:\"total\"`\r\n  ByUser map[string]int `json:\"by_user\"`\r\n}\r\n\r\ntype timeRangeOut struct {\r\n  Start *string `json:\"start\"`\r\n  End   *string `json:\"end\"`\r\n}\r\n\r\ntype anomaliesOut struct {\r\n  Duplicate           int `json:\"duplicate\"`\r\n  UnresolvedChargeback int `json:\"unresolved_chargeback\"`\r\n}\r\n\r\ntype summary struct {\r\n  TotalEvents int                        `json:\"total_events\"`\r\n  ByType      map[string]eventTypeStats  `json:\"by_type\"`\r\n"]
[5460.124946, "o", "  ByHour      map[string]hourStats        `json:\"by_hour\"`\r\n  Sessions    sessionsOut                `json:\"sessions\"`\r\n  TimeRange   timeRangeOut               `json:\"time_range\"`\r\n  Anomalies   anomaliesOut               `json:\"anomalies\"`\r\n  StateStats  *stateStats                `json:\"state_stats,omitempty\"`\r\n}\r\n\r\ntype rawEvent struct {\r\n  Shard string\r\n  Line  int\r\n"]
[5460.125, "o", "  Raw   json.RawMessage\r\n  Obj   map[string]json.RawMessage\r\n}\r\n\r\ntype statePendingOut struct {\r\n  ID        string `json:\"id\"`\r\n  TS        string `json:\"ts\"`\r\n  User      string `json:\"user\"`\r\n  USD       Money  `json:\"usd\"`\r\n  OriginRun int    `json:\"origin_run\"`\r\n}\r\n"]
[5460.125061, "o", "\r\ntype stateOpenSessionOut struct {\r\n  User         string `json:\"user\"`\r\n  LastTS       string `json:\"last_ts\"`\r\n  SessionIndex int    `json:\"session_index\"`\r\n  StartTS      string `json:\"start_ts\"`\r\n}\r\n\r\n"]
[5460.125113, "o", "type stateWatermarkOut struct {\r\n  MaxTS *string `json:\"max_ts\"`\r\n}\r\n\r\ntype stateFileOut struct {\r\n  Version          int                   `json:\"version\"`\r\n  Watermark        stateWatermarkOut     `json:\"watermark\"`\r\n  SeenIDs          []string              `json:\"seen_ids\"`\r\n"]
[5460.125167, "o", "  PendingPurchases []statePendingOut    `json:\"pending_purchases\"`\r\n  OpenSessions     []stateOpenSessionOut `json:\"open_sessions\"`\r\n  RunIndex         int                   `json:\"run_index\"`\r\n}\r\n\r\ntype auditAccepted struct {\r\n  ID             *string `json:\"id\"`\r\n"]
[5460.125225, "o", "  TS             *string `json:\"ts\"`\r\n  Type           *string `json:\"type\"`\r\n  Shard          string  `json:\"shard\"`\r\n  Line           int     `json:\"line\"`\r\n  Bucket         string  `json:\"bucket\"`\r\n  USD            Money   `json:\"usd\"`\r\n  SessionIndex   int     `json:\"session_index\"`\r\n"]
[5460.125277, "o", "  ResolvedAgainst *string `json:\"resolved_against\"`\r\n}\r\n\r\ntype auditInvalid struct {\r\n  ID     *string `json:\"id\"`\r\n  TS     *string `json:\"ts\"`\r\n  Type   *string `json:\"type\"`\r\n"]
[5460.125328, "o", "  Shard  string  `json:\"shard\"`\r\n  Line   int     `json:\"line\"`\r\n  Bucket string  `json:\"bucket\"`\r\n  Reason string  `json:\"reason\"`\r\n}\r\n\r\ntype auditLate struct {\r\n  ID     *string `json:\"id\"`\r\n"]
[5460.125379, "o", "  TS     *string `json:\"ts\"`\r\n  Type   *string `json:\"type\"`\r\n  Shard  string  `json:\"shard\"`\r\n  Line   int     `json:\"line\"`\r\n  Bucket string  `json:\"bucket\"`\r\n  Cutoff string  `json:\"cutoff\"`\r\n}\r\n"]
[5460.12543, "o", "\r\ntype auditDuplicate struct {\r\n  ID     *string `json:\"id\"`\r\n  TS     *string `json:\"ts\"`\r\n  Type   *string `json:\"type\"`\r\n  Shard  string  `json:\"shard\"`\r\n  Line   int     `json:\"line\"`\r\n"]
[5460.12548, "o", "  Bucket string  `json:\"bucket\"`\r\n  Reason string  `json:\"reason\"`\r\n}\r\n\r\ntype auditUnresolved struct {\r\n  ID     *string `json:\"id\"`\r\n  TS     *string `json:\"ts\"`\r\n  Type   *string `json:\"type\"`\r\n"]
[5460.125531, "o", "  Shard  string  `json:\"shard\"`\r\n  Line   int     `json:\"line\"`\r\n  Bucket string  `json:\"bucket\"`\r\n  RefID  string  `json:\"ref_id\"`\r\n}\r\n\r\ntype digestBucketCounts struct {\r\n  Accepted             int `json:\"accepted\"`\r\n  Invalid              int `json:\"invalid\"`\r\n  Late                 int `json:\"late\"`"]
[5460.125583, "o", "\r\n  Duplicate            int `json:\"duplicate\"`\r\n  UnresolvedChargeback int `json:\"unresolved_chargeback\"`\r\n}\r\n\r\ntype digestDuplicateReasons struct {\r\n  SameRun  int `json:\"same_run\"`\r\n  CrossRun int `json:\"cross_run\"`\r\n}\r\n\r\ntype digestResolvedAgainst struct {\r\n"]
[5460.125634, "o", "  CurrentRun int `json:\"current_run\"`\r\n  CarryOver  int `json:\"carry_over\"`\r\n  Null       int `json:\"null\"`\r\n}\r\n\r\ntype digest struct {\r\n  AuditLog         string                `json:\"audit_log\"`\r\n  TotalRecords     int                   `json:\"total_records\"`\r\n  BucketCounts     digestBucketCounts    `json:\"bucket_counts\"`"]
[5460.125685, "o", "\r\n  InvalidReasons   map[string]int        `json:\"invalid_reasons\"`\r\n  DuplicateReasons digestDuplicateReasons `json:\"duplicate_reasons\"`\r\n  ResolvedAgainst  digestResolvedAgainst  `json:\"resolved_against\"`\r\n  SHA256           string                `json:\"sha256\"`\r\n}\r\n\r\ntype eventContext struct {\r\n"]
[5460.125736, "o", "  Shard string\r\n  Line  int\r\n  Raw   json.RawMessage\r\n  Obj   map[string]json.RawMessage\r\n  ID    *string\r\n  TS    *string\r\n  Type  *string\r\n"]
[5460.125785, "o", "  Ev    *Event\r\n}\r\n\r\nvar errUsage = errors.New(usageString)\r\n\r\nfunc usageError() error {\r\n  return errUsage\r\n}\r\n\r\n"]
[5460.125838, "o", "func parseTime(s string) (time.Time, error) {\r\n  t, err := time.Parse(\"2006-01-02T15:04:05Z\", s)\r\n  if err != nil {\r\n    return time.Time{}, err\r\n  }\r\n  return t.UTC(), nil\r\n"]
[5460.125887, "o", "}\r\n\r\nfunc formatTS(t time.Time) string {\r\n  return t.UTC().Format(\"2006-01-02T15:04:05Z\")\r\n}\r\n\r\nfunc hourKey(t time.Time) string {\r\n  return t.UTC().Format(\"2006-01-02T15\")\r\n}\r\n"]
[5460.125938, "o", "\r\nfunc dateKey(t time.Time) string {\r\n  return t.UTC().Format(\"2006-01-02\")\r\n}\r\n\r\nfunc isDate(s string) bool {\r\n  _, err := time.Parse(\"2006-01-02\", s)\r\n  return err == nil"]
[5460.125988, "o", "\r\n}\r\n\r\nfunc getRawString(m map[string]json.RawMessage, key string) (string, bool, bool) {\r\n  raw, present := m[key]\r\n  if !present {\r\n    return \"\", false, false\r\n"]
[5460.12604, "o", "  }\r\n  var s string\r\n  if err := json.Unmarshal(raw, &s); err == nil {\r\n    return s, true, true\r\n  }\r\n  return \"\", false, true\r\n}\r\n\r\n"]
[5460.126093, "o", "func rawStringPtr(m map[string]json.RawMessage, key string) *string {\r\n  s, ok, _ := getRawString(m, key)\r\n  if !ok {\r\n    return nil\r\n  }\r\n  return &s\r\n}\r\n"]
[5460.126144, "o", "\r\nfunc getString(m map[string]json.RawMessage, keys ...string) (string, bool) {\r\n  for _, k := range keys {\r\n    s, ok, _ := getRawString(m, k)\r\n    if ok {\r\n      return s, true\r\n    }\r\n"]
[5460.126203, "o", "  }\r\n  return \"\", false\r\n}\r\n\r\nfunc getNumberOrString(raw json.RawMessage) (float64, error) {\r\n  trimmed := bytes.TrimSpace(raw)\r\n  if len(trimmed) == 0 {\r\n    return 0, errors.New(\"empty number\")\r\n"]
[5460.126253, "o", "  }\r\n  if trimmed[0] == '\"' {\r\n    var s string\r\n    if err := json.Unmarshal(trimmed, &s); err != nil {\r\n      return 0, err\r\n    }\r\n    s = strings.TrimSpace(s)\r\n"]
[5460.126303, "o", "    if parts := strings.Fields(s); len(parts) > 0 {\r\n      s = parts[0]\r\n    }\r\n    return strconv.ParseFloat(s, 64)\r\n  }\r\n  return strconv.ParseFloat(string(trimmed), 64)\r\n}\r\n"]
[5460.126353, "o", "\r\nfunc isFinite(f float64) bool {\r\n  return !math.IsInf(f, 0) && !math.IsNaN(f)\r\n}\r\n\r\nfunc getJSONInt(raw json.RawMessage) (int64, error) {\r\n  var n json.Number\r\n  if err := json.Unmarshal(raw, &n); err != nil {\r\n    return 0, err\r\n"]
[5460.126404, "o", "  }\r\n  s := string(n)\r\n  if strings.ContainsAny(s, \".eE\") {\r\n    return 0, errors.New(\"not an integer\")\r\n  }\r\n  return strconv.ParseInt(s, 10, 64)\r\n}\r\n"]
[5460.126454, "o", "\r\nfunc roundMoney(f float64) float64 {\r\n  abs := math.Abs(f)\r\n  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n  if f < 0 && cents != 0 {\r\n    return -float64(cents) / 100.0\r\n"]
[5460.126504, "o", "  }\r\n  return float64(cents) / 100.0\r\n}\r\n\r\nfunc jsonBytes(s string) []byte {\r\n  b, err := json.Marshal(s)\r\n  if err != nil {\r\n"]
[5460.126554, "o", "    return []byte(`\"\"`)\r\n  }\r\n  return b\r\n}\r\n\r\nfunc strPtr(s string) *string {\r\n  return &s\r\n"]
[5460.126603, "o", "}\r\n\r\nfunc absDur(d time.Duration) time.Duration {\r\n  if d < 0 {\r\n    return -d\r\n  }\r\n  return d\r\n}\r\n"]
[5460.126654, "o", "\r\nfunc parentDirExists(path string) bool {\r\n  dir := filepath.Dir(path)\r\n  if dir == \".\" {\r\n    return true\r\n  }\r\n  info, err := os.Stat(dir)\r\n"]
[5460.126705, "o", "  return err == nil && info.IsDir()\r\n}\r\n\r\nfunc parseNonNegInt(s string) (int, error) {\r\n  n, err := strconv.Atoi(s)\r\n  if err != nil {\r\n    return 0, err\r\n  }\r\n  if n < 0 {\r\n"]
[5460.126754, "o", "    return 0, errors.New(\"negative\")\r\n  }\r\n  return n, nil\r\n}\r\n\r\n"]
[5460.127371, "o", "\u001b[?2004h"]
