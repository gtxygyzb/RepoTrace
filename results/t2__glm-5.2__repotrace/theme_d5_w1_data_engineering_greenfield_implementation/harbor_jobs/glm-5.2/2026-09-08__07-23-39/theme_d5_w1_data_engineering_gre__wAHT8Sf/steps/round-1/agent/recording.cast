[19002.391629, "o", "\tSchemaVersion string                         `json:\"schema_version\"`\r\n\tReportPath    string                         `json:\"report_path\"`\r\n\tShardCount    int                            `json:\"shard_count\"`\r\n\tBuckets       shardingReportHistogramBuckets `json:\"buckets\"`\r\n\tToolVersion   string                         `json:\"tool_version\"`\r\n}\r\n\r\nfunc writeShardingReportSidecars(cfg cliConfig, shards []inputShardInfo, auditEntries []auditLogEntry, events []rawEvent) error {\r\n\tif cfg.shardingReport == \"\" {\r\n\t\treturn nil\r\n\t}\r\n\treportShards := buildShardingReportShards(cfg, shards, auditEntries, events)\r\n\tsortKey := cfg.shardingReportSort\r\n\tif sortKey == \"\" {\r\n\t"]
