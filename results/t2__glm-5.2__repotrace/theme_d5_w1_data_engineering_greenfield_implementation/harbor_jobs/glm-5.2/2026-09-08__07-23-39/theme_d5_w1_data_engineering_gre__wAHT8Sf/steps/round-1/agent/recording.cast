[7251.992471, "o", "   108\t\t}\r\n   109\t\tfor i, c := range s {\r\n   110\t\t\tif i == 4 || i == 7 {\r\n   111\t\t\t\tif c != '-' {\r\n   112\t\t\t\t\treturn false\r\n   113\t\t\t\t}\r\n   114\t\t\t\tcontinue\r\n   115\t\t\t}\r\n   116\t\t\tif c < '0' || c > '9' {\r\n   117\t\t\t\treturn false\r\n   118\t\t\t}\r\n   119\t\t}\r\n   120\t\treturn true\r\n   121\t}\r\n   122\t\r\n   123\tfunc dayEpoch(date string) time.Time {\r\n"]
[7251.992529, "o", "   124\t\tt, err := time.Parse(\"2006-01-02\", date)\r\n   125\t\tif err != nil {\r\n   126\t\t\treturn time.Time{}\r\n   127\t\t}\r\n   128\t\treturn t.UTC()\r\n   129\t}\r\n   130\t\r\n"]
[7251.992592, "o", "   131\tfunc calendarDayDiff(rateDate, eventDate string) int {\r\n   132\t\tr := dayEpoch(rateDate)\r\n   133\t\te := dayEpoch(eventDate)\r\n   134\t\tif r.IsZero() || e.IsZero() {\r\n   135\t\t\treturn 0\r\n   136\t\t}\r\n   137\t\treturn int(r.Sub(e) / (24 * time.Hour))\r\n   138\t}\r\n   139\t\r\n   140\tfunc absInt(v int) int {\r\n   141\t\t"]
[7251.992654, "o", "if v < 0 {\r\n   142\t\t\treturn -v\r\n   143\t\t}\r\n   144\t\treturn v\r\n   145\t}\r\n   146\t\r\n   147\tfunc absInt64(v int64) int64 {\r\n   148\t\tif v < 0 {\r\n   149\t\t\treturn -v\r\n   150\t\t}\r\n   151\t\treturn v"]
[7251.992713, "o", "\r\n   152\t}\r\n   153\t\r\n   154\tfunc (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {\r\n   155\t\tif !rt.known[currency] {\r\n   156\t\t\treturn 0, 0, \"fx_unknown_currency\"\r\n   157\t\t}\r\n   158\t\tif m, ok := rt.days[date]; ok {\r\n"]
[7251.992774, "o", "   159\t\t\tif r, ok := m[currency]; ok {\r\n   160\t\t\t\tif isUsableRate(r) {\r\n   161\t\t\t\t\treturn r, 0, \"\"\r\n   162\t\t\t\t}\r\n   163\t\t\t\treturn 0, 0, \"bad_rate\"\r\n   164\t\t\t}\r\n   165\t\t}\r\n   166\t\tif maxStaleness > 0 {\r\n   167\t\t\teventDay := dayEpoch(date)\r\n   168\t"]
[7251.992836, "o", "\t\tif !eventDay.IsZero() {\r\n   169\t\t\t\tvar bestDate string\r\n   170\t\t\t\tvar bestDist int64 = -1\r\n   171\t\t\t\tfor _, d := range sortedKeys(rt.days) {\r\n   172\t\t\t\t\tif _, ok := rt.days[d][currency]; !ok {\r\n   173\t\t\t\t\t\tcontinue\r\n   174\t\t\t\t\t}\r\n   175\t\t\t\t\tdayTime := dayEpoch(d)\r\n"]
[7251.992898, "o", "   176\t\t\t\t\tif dayTime.IsZero() {\r\n   177\t\t\t\t\t\tcontinue\r\n   178\t\t\t\t\t}\r\n   179\t\t\t\t\tdist := absInt64(dayTime.Unix() - eventDay.Unix())\r\n   180\t\t\t\t\tif dist > int64(maxStaleness) {\r\n   181\t\t\t\t\t\tcontinue\r\n   182\t\t\t\t\t}\r\n   183\t\t\t\t\tif bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {"]
[7251.992958, "o", "\r\n   184\t\t\t\t\t\tbestDist = dist\r\n   185\t\t\t\t\t\tbestDate = d\r\n   186\t\t\t\t\t}\r\n   187\t\t\t\t}\r\n   188\t\t\t\tif bestDate != \"\" {\r\n   189\t\t\t\t\tr := rt.days[bestDate][currency]\r\n   190\t\t\t\t\tif isUsableRate(r) {\r\n"]
[7251.993016, "o", "   191\t\t\t\t\t\treturn r, calendarDayDiff(bestDate, date), \"\"\r\n   192\t\t\t\t\t}\r\n   193\t\t\t\t\treturn 0, 0, \"bad_rate\"\r\n   194\t\t\t\t}\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197\t\treturn 0, 0, \"missing_rate\"\r\n   198\t}\r\n   199\t\r\n"]
