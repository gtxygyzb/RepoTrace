[13895.855858, "o", "\u001b[32m\u001b[K208\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn nil, errors.New(\"\u001b[01;31m\u001b[Kfx\u001b[m\u001b[K \u001b[01;31m\u001b[Kdays\u001b[m\u001b[K \u001b[01;31m\u001b[Kinvalid\u001b[m\u001b[K\")\r\n\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K210\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar \u001b[01;31m\u001b[Kdays\u001b[m\u001b[K map[string]json.RawMessage\r\n\u001b[32m\u001b[K211\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif err := json.Unmarshal(\u001b[01;31m\u001b[Kdays\u001b[m\u001b[KRaw, &\u001b[01;31m\u001b[Kdays\u001b[m\u001b[K); err != nil {\r\n\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn nil, errors.New(\"\u001b[01;31m\u001b[Kfx\u001b[m\u001b[K \u001b[01;31m\u001b[Kdays\u001b[m\u001b[K \u001b[01;31m\u001b[Kinvalid\u001b[m\u001b[K\")\r\n\u001b[32m\u001b[K213\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n"]
[13895.85592, "o", "\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif len(\u001b[01;31m\u001b[Kdays\u001b[m\u001b[K) == 0 {\r\n\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn nil, errors.New(\"\u001b[01;31m\u001b[Kfx\u001b[m\u001b[K \u001b[01;31m\u001b[Kdays\u001b[m\u001b[K \u001b[01;31m\u001b[Kinvalid\u001b[m\u001b[K\")\r\n\u001b[32m\u001b[K216\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K217\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, day := range sortedKeys(\u001b[01;31m\u001b[Kdays\u001b[m\u001b[K) {\r\n"]
[13895.855985, "o", "\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif !isStrictDate(day) || !isDate(day) {\r\n\u001b[32m\u001b[K219\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn nil, fmt.Errorf(\"ingest: \u001b[01;31m\u001b[Krates\u001b[m\u001b[K.json: \u001b[01;31m\u001b[Kinvalid\u001b[m\u001b[K day key %s\", day)\r\n\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tvar currencies map[string]json.RawMessage\r\n"]
