[9065.375881, "o", "    26\t\tcents := int64(math.Floor(abs*100.0 + 0.5))\r\n    27\t\tneg := f < 0 && cents != 0\r\n    28\t\tdollars := cents / 100\r\n    29\t\trem := cents % 100\r\n    30\t\ts := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n    31\t\tif neg {\r\n    32\t\t\ts = \"-\" + s\r\n    33\t\t}\r\n    34\t\treturn s\r\n    35\t}\r\n    36\t\r\n    37\ttype Event struct {\r\n    38\t\tID                string\r\n    39\t"]
[9065.375956, "o", "\tType              string\r\n    40\t\tTS                time.Time\r\n    41\t\tUserID            string\r\n    42\t\tAmount            float64\r\n    43\t\tCurrency          string\r\n    44\t\tRefID             string\r\n    45\t\tUSD               float64\r\n    46\t\tRefUSD            float64\r\n    47\t\tFXFallbackDays    int\r\n    48\t\tResolvedAgainst   *string\r\n"]
[9065.376025, "o", "    49\t\tResolvedOriginRun int\r\n    50\t\tSessionIndex      int\r\n    51\t\tRaw               rawJSON\r\n    52\t\tShard             string\r\n    53\t\tLine              int\r\n    54\t}\r\n    55\t\r\n    56\ttype Reject struct {\r\n    57\t\tBucket int     `json:\"bucket\"`\r\n    58\t\tEvent  rawJSON `json:\"event\"`\r\n    59\t}\r\n    60\t\r\n    61\ttype ShardLine struct {\r\n"]
