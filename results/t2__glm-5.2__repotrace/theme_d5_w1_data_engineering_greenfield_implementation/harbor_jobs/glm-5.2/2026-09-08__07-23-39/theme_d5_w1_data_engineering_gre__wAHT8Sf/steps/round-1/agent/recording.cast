[14685.092884, "o", "\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kentries = append(entries, \u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K{key: \"constraints\", value: objectConstraints(obj, depth, strict)})\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kentries = append(entries, \u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K{key: \"constraints\", value: scalarConstraints(v, t, depth, strict)})\r\n\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc scalarConstraints(v any, t string, depth int, strict bool) []\u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K291\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvar entries []\u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K\r\n\u001b[32m\u001b[K295\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kentries = append(entries, \u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K{key: \"non_negative\", value: true})\r\n"]
[14685.092959, "o", "\u001b[32m\u001b[K298\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kentries = append(entries, \u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K{key: \"zero_observed\", value: true})\r\n\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kentries = append(entries, \u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K{key: \"format\", value: \"rfc3339-utc-z\"})\r\n\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc arrayConstraints(arr []any, depth int, strict bool) []\u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvar entries []\u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kentries = append(entries, \u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K{key: \"element_subfields\", value: elementSubfields(arr[0].(map[string]any), depth+1, strict)})\r\n\u001b[32m\u001b[K327\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kentries = append(entries, \u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K{key: \"homogeneous\", value: homogeneous})\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kentries = append(entries, \u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K{key: \"length\", value: len(arr)})\r\n"]
[14685.093048, "o", "\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc objectConstraints(obj map[string]any, depth int, strict bool) []\u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K333\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kentries := []\u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K{{key: \"field_count\", value: len(obj)}}\r\n\u001b[32m\u001b[K335\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kentries = append(entries, \u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K{key: \"subfields\", value: subfields(obj, depth+1, strict)})\r\n\u001b[32m\u001b[K340\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc subfields(obj map[string]any, depth int, strict bool) []\u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K {\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kentries := make([]\u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K, 0, len(keys))\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kentries = append(entries, \u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K{key: k, value: descriptorFor(obj[k], depth, strict)})\r\n\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc elementSubfields(obj map[string]any, depth int, strict bool) []\u001b[01;31m\u001b[KorderedJSON\u001b[m\u001b[K {\r\n"]
