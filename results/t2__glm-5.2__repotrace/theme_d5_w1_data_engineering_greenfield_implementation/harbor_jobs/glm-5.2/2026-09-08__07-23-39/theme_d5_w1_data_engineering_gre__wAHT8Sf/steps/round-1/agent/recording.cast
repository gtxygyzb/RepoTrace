[18232.592994, "o", "fixedWindowSeconds  int\r\n\tfixedWindowSet      bool\r\n}\r\n\r\nfunc main() {\r\n\tcfg, err := parseArgs(os.Args[1:])\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(2)\r\n\t}\r\n"]
[18232.593057, "o", "\tif err := run(cfg); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n\tdefer func() {\r\n\t\tif r := recover(); r != nil {\r\n\t\t\tcfg = cliConfig{}\r\n\t\t\terr = fmt.Errorf(\"%v\", r)\r\n\t\t}\r\n"]
[18232.593116, "o", "\t}()\r\n\tcfg = cliConfig{\r\n\t\tsessionGap:        600,\r\n\t\twatermarkLag:      300,\r\n\t\tpendingTTL:        86400,\r\n\t\tmaxOpenSessions:   100000,\r\n\t\tratesMaxStaleness: 0,\r\n\t}\r\n\trequired := map[string]bool{\r\n"]
[18232.593176, "o", "\t\t\"--input-dir\": false,\r\n\t\t\"--rates\":     false,\r\n\t\t\"--output\":    false,\r\n\t\t\"--rejects\":   false,\r\n\t}\r\n\tif len(args) > 0 && args[0] == \"ingest\" {\r\n\t\targs = args[1:]\r\n\t}\r\n\tfor i := 0; i < len(args); i++ {\r\n"]
