[16470.854129, "o", "8\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc (m Money) MarshalJSON() ([]byte, error) {\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn []byte(m.String()), nil\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K}\r\n\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n"]
