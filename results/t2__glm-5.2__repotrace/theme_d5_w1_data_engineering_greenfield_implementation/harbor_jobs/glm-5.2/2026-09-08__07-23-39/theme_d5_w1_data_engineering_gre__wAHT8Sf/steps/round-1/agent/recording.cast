[16616.746162, "o", "   437\t\tdata, err := os.ReadFile(path)\r\n   438\t\tif err != nil {\r\n   439\t\t\treturn nil, err\r\n   440\t\t}\r\n   441\t\tvar sin stateFileIn\r\n   442\t\tif err := json.Unmarshal(data, &sin); err != nil {\r\n   443\t\t\treturn nil, err\r\n   444\t\t}\r\n   445\t\tst := &loadedState{\r\n   446\t\t\tversion:      sin.Version,\r\n   447\t\t\tseenIds:      map[string]bool{},\r\n   448\t\t\trunIndex:     sin.RunIndex,\r\n"]
[16616.746272, "o", "   449\t\t\topenSessions: map[string]carriedSession{},\r\n   450\t\t}\r\n   451\t\tif sin.Watermark.MaxTS != nil {\r\n   452\t\t\tt, err := parseTime(*sin.Watermark.MaxTS)\r\n   453\t\t\tif err != nil {\r\n   454\t\t\t\treturn nil, fmt.Errorf(\"bad state watermark: %w\", err)\r\n   455\t\t\t}\r\n   456\t\t\tst.hasMax = true\r\n   457\t\t\tst.maxTs = t\r\n   458\t\t}\r\n   459\t\tfor _, id := range sin.SeenIDs {\r\n"]
[16616.746345, "o", "   460\t\t\tst.seenIds[id] = true\r\n   461\t\t}\r\n   462\t\tfor _, p := range sin.PendingPurchases {\r\n   463\t\t\tt, err := parseTime(p.TS)\r\n   464\t\t\tif err != nil {\r\n   465\t\t\t\treturn nil, fmt.Errorf(\"bad pending purchase ts: %w\", err)\r\n   466\t\t\t}\r\n   467\t\t\tif stateStrict && !p.firstSeenEpochSet {\r\n   468\t\t\t\treturn nil, fmt.Errorf(\"ingest: --state-strict: state pending entry missing first_seen_epoch\")\r\n   469\t\t\t}\r\n   470\t\t\tst.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, firstSeenEpoch: int(epochSeconds(t)), user: p.User, usd: float64(p.USD), originRun: p.OriginRun})\r\n"]
[16616.746424, "o", "   471\t\t}\r\n   472\t\tfor _, s := range sin.OpenSessions {\r\n   473\t\t\tlast, err := parseTime(s.LastTS)\r\n   474\t\t\tif err != nil {\r\n   475\t\t\t\treturn nil, fmt.Errorf(\"bad open session last_ts: %w\", err)\r\n   476\t\t\t}\r\n   477\t\t\tstart, err := parseTime(s.StartTS)\r\n   478\t\t\tif err != nil {\r\n   479\t\t\t\treturn nil, fmt.Errorf(\"bad open session start_ts: %w\", err)\r\n   480\t\t\t}\r\n"]
[16616.746505, "o", "   481\t\t\tst.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}\r\n   482\t\t}\r\n   483\t\tst.carryInPending = len(st.pending)\r\n   484\t\tst.carryInOpenSessions = len(st.openSessions)\r\n   485\t\treturn st, nil\r\n   486\t}\r\n   487\t\r\n   488\tfunc buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {\r\n   489\t\tout := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}\r\n   490\t\tif hasCurrentMax {\r\n   491\t\t\ts := formatTS(currentMax)\r\n"]
[16616.74657, "o", "   492\t\t\tout.Watermark.MaxTS = &s\r\n   493\t\t} else if st != nil && st.hasMax {\r\n   494\t\t\ts := formatTS(st.maxTs)\r\n   495\t\t\tout.Watermark.MaxTS = &s\r\n   496\t\t}\r\n   497\t\tb, _ := json.MarshalIndent(out, \"\", \"  \")\r\n   498\t\tb = append(b, '\\n')\r\n   499\t\treturn b\r\n   500\t}\r\n"]
[16616.746635, "o", "   501\t\r\n   502\tfunc statePendingOutList(pending []pendingEntry) []statePendingOut {\r\n   503\t\tout := make([]statePendingOut, 0, len(pending))\r\n   504\t\tfor _, p := range pending {\r\n   505\t\t\tout = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), FirstSeenEpoch: p.firstSeenEpoch, User: p.user, USD: Money(p.usd), OriginRun: p.originRun})\r\n   506\t\t}\r\n   507\t\treturn out\r\n   508\t}\r\n   509\t\r\n"]
[16616.746695, "o", "   510\tfunc stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {\r\n   511\t\tout := make([]stateOpenSessionOut, 0, len(sessions))\r\n   512\t\tfor _, s := range sessions {\r\n   513\t\t\tout = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})\r\n   514\t\t}\r\n   515\t\treturn out\r\n"]
[16616.746753, "o", "   516\t}\r\n   517\t\r\n   518\tfunc sortedSeenIDs(seen map[string]bool) []string {\r\n   519\t\tids := make([]string, 0, len(seen))\r\n   520\t\tfor id := range seen {\r\n   521\t\t\tids = append(ids, id)\r\n   522\t\t}\r\n   523\t\tsort.Strings(ids)\r\n   524\t\treturn ids\r\n   525\t}\r\n   526\t\r\n"]
[16616.746809, "o", "   527\tfunc stateFirstSeenEpochPresent(p statePendingOut) bool {\r\n   528\t\treturn p.firstSeenEpochSet\r\n   529\t}\r\n   530\t\r\n   531\tfunc sortedPending(pending []pendingEntry) []pendingEntry {\r\n   532\t\tout := append([]pendingEntry(nil), pending...)\r\n   533\t\tsort.SliceStable(out, func(i, j int) bool {\r\n   534\t\t\tif out[i].ts.Equal(out[j].ts) {\r\n   535\t\t\t\treturn out[i].id < out[j].id\r\n   536\t\t\t}\r\n"]
[16616.746885, "o", "   537\t\t\treturn out[i].ts.Before(out[j].ts)\r\n   538\t\t})\r\n   539\t\treturn out\r\n   540\t}\r\n"]
[16616.746952, "o", "   541\t\r\n   542\tfunc sortedOpenSessions(m map[string]carriedSession) []carriedSession {\r\n   543\t\tout := make([]carriedSession, 0, len(m))\r\n   544\t\tfor _, s := range m {\r\n   545\t\t\tout = append(out, s)\r\n   546\t\t}\r\n   547\t\tsort.SliceStable(out, func(i, j int) bool {\r\n   548\t\t\tif out[i].lastTs.Equal(out[j].lastTs) {\r\n   549\t\t\t\treturn out[i].user < out[j].user\r\n   550\t\t\t}\r\n   551\t\t\treturn out[i].lastTs.Before(out[j].lastTs)\r\n   552\t\t})\r\n   553\t\treturn out\r\n   554\t}\r\n   555\t\r\n"]
[16616.747013, "o", "   556\tfunc sortedCarriedSessions(m map[string]carriedSession) []carriedSession {\r\n   557\t\treturn sortedOpenSessions(m)\r\n   558\t}\r\n"]
