[19917.673687, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"path/filepath\"\r\n\t"]
[19917.673914, "o", "\"sort\"\r\n\t\"time\"\r\n)\r\n\r\nconst shardingReportSchemaVersion = \"eventq.sharding-report/v1\"\r\nconst shardingReportDigestSchemaVersion = \"eventq.sharding-report-digest/v1\"\r\nconst shardingReportHistogramSchemaVersion = \"eventq.sharding-report-histogram/v1\"\r\n\r\ntype shardingReportShard struct {\r\n\tShard                      string  `json:\"shard\"`\r\n\tBytes                      int64   `json:\"bytes\"`\r\n\tSHA256                     string  `json:\"sha256\"`\r\n\tEventsTotal                int     `json:\"events_total\"`\r\n\tEventsAccepted             int     `json:\"events_accepted\"`\r\n\tEventsInvalid              int     `json:\"events_invalid\"`\r\n\tEventsLate                 int     `json:\"events_late\"`\r\n\tEventsDuplicate            int     `json:\"events_duplicate\"`\r\n\tEventsUnresolvedChargeback int     `json:\"events_unresolved_chargeback\"`\r\n\tFirstTS                    *string `json:\"first_ts\"`\r\n\tLastTS                     *string `json:\"last_ts\"`\r\n}\r\n\r\ntype shardingReportTotals struct {"]
[19917.674033, "o", "\r\n\tShards                     int   `json:\"shards\"`\r\n\tBytesTotal                 int64 `json:\"bytes_total\"`\r\n\tEventsTotal                int   `json:\"events_total\"`\r\n\tEventsAccepted             int   `json:\"events_accepted\"`\r\n\tEventsInvalid              int   `json:\"events_invalid\"`\r\n\tEventsLate                 int   `json:\"events_late\"`\r\n\tEventsDuplicate            int   `json:\"events_duplicate\"`\r\n\tEventsUnresolvedChargeback int   `json:\"events_unresolved_chargeback\"`\r\n}\r\n\r\n"]
[19917.674124, "o", "type shardingReport struct {\r\n\tSchemaVersion string                `json:\"schema_version\"`\r\n\tIngestID      *string               `json:\"ingest_id\"`\r\n\tShards        []shardingReportShard `json:\"shards\"`\r\n\tTotals        shardingReportTotals  `json:\"totals\"`\r\n}\r\n\r\ntype shardingReportDigest struct {\r\n\tSchemaVersion         string `json:\"schema_version\"`\r\n"]
[19917.674217, "o", "\tReportPath            string `json:\"report_path\"`\r\n\tReportSHA256          string `json:\"report_sha256\"`\r\n\tReportBytes           int64  `json:\"report_bytes\"`\r\n\tShardCount            int    `json:\"shard_count\"`\r\n\tSortKey               string `json:\"sort_key,omitempty\"`\r\n\tShardsSortedInvariant *bool  `json:\"shards_sorted_invariant,omitempty\"`\r\n"]
[19917.674283, "o", "\tToolVersion           string `json:\"tool_version\"`\r\n}\r\n\r\ntype shardingReportIndexEntry struct {\r\n\tName string `json:\"name\"`\r\n\tType string `json:\"type\"`\r\n\tPath string `json:\"path\"`\r\n}\r\n"]
[19917.674348, "o", "\r\ntype shardingReportIndex struct {\r\n\tEntries       []shardingReportIndexEntry `json:\"entries\"`\r\n\tEntryCount    int                        `json:\"entry_count\"`\r\n\tShardCount    int                        `json:\"shard_count\"`\r\n\tGeneratedFrom string                     `json:\"generated_from\"`\r\n\tToolVersion   string                     `json:\"tool_version\"`\r\n}\r\n\r\ntype shardingReportHistogramBucket struct {\r\n\tUpperBound int `json:\"upper_bound\"`\r\n\tCount      int `json:\"count\"`\r\n}\r\n"]
[19917.674419, "o", "\r\ntype shardingReportHistogramBuckets struct {\r\n\tBytes                      []shardingReportHistogramBucket `json:\"bytes\"`\r\n\tEventsTotal                []shardingReportHistogramBucket `json:\"events_total\"`\r\n\tEventsAccepted             []shardingReportHistogramBucket `json:\"events_accepted\"`\r\n\tEventsInvalid              []shardingReportHistogramBucket `json:\"events_invalid\"`\r\n\tEventsLate                 []shardingReportHistogramBucket `json:\"events_late\"`\r\n\tEventsDuplicate            []shardingReportHistogramBucket `json:\"events_duplicate\"`\r\n\tEventsUnresolvedChargeback []shardingReportHistogramBucket `json:\"events_unresolved_chargeback\"`\r\n}"]
[19917.674486, "o", "\r\n\r\ntype shardingReportHistogram struct {\r\n\tSchemaVersion string                         `json:\"schema_version\"`\r\n\tReportPath    string                         `json:\"report_path\"`\r\n\tShardCount    int                            `json:\"shard_count\"`\r\n\tBuckets       shardingReportHistogramBuckets `json:\"buckets\"`\r\n\tToolVersion   string                         `json:\"tool_version\"`\r\n}\r\n\r\n"]
[19917.674552, "o", "func writeShardingReportSidecars(cfg cliConfig, shards []inputShardInfo, auditEntries []auditLogEntry, events []rawEvent) error {\r\n\tif cfg.shardingReport == \"\" {\r\n\t\treturn nil\r\n\t}\r\n\treportShards := buildShardingReportShards(cfg, shards, auditEntries, events)\r\n\tsortKey := cfg.shardingReportSort\r\n\tif sortKey == \"\" {\r\n\t\tsortKey = \"basename\"\r\n\t}\r\n\tsortShardingReportShards(reportShards, sortKey)\r\n\r\n"]
[19917.674615, "o", "\tvar ingestID *string\r\n\tif cfg.ingestIDSet {\r\n\t\tid := cfg.ingestID\r\n\t\tingestID = &id\r\n\t}\r\n\ttotals := shardingReportTotals{Shards: len(reportShards)}\r\n\tfor _, s := range reportShards {\r\n\t\ttotals.BytesTotal += s.Bytes\r\n"]
[19917.67468, "o", "\t\ttotals.EventsTotal += s.EventsTotal\r\n\t\ttotals.EventsAccepted += s.EventsAccepted\r\n\t\ttotals.EventsInvalid += s.EventsInvalid\r\n\t\ttotals.EventsLate += s.EventsLate\r\n\t\ttotals.EventsDuplicate += s.EventsDuplicate\r\n\t\ttotals.EventsUnresolvedChargeback += s.EventsUnresolvedChargeback\r\n\t}\r\n\treport := shardingReport{\r\n"]
[19917.674749, "o", "\t\tSchemaVersion: shardingReportSchemaVersion,\r\n\t\tIngestID:      ingestID,\r\n\t\tShards:        reportShards,\r\n\t\tTotals:        totals,\r\n\t}\r\n\tdata, err := json.MarshalIndent(report, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdata = append(data, '\\n')\r\n\t"]
[19917.674817, "o", "if err := atomicWriteFile(cfg.shardingReport, data); err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n\treportBase := filepath.Base(cfg.shardingReport)\r\n\tif cfg.shardingReportHistogram != \"\" {\r\n\t\tif err := writeShardingHistogram(cfg.shardingReportHistogram, reportBase, reportShards, totals.Shards); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\tif cfg.shardingReportDigest != \"\" {\r\n\t\tif err := writeShardingDigest(cfg, data, reportBase, totals.Shards, sortKey, reportShards); err != nil {\r\n\t"]
[19917.674884, "o", "\t\treturn err\r\n\t\t}\r\n\t}\r\n\tif cfg.shardingReportIndex != \"\" {\r\n\t\tif err := writeShardingIndex(cfg.shardingReportIndex, reportBase, reportShards); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n"]
[19917.674948, "o", "func buildShardingReportShards(cfg cliConfig, shards []inputShardInfo, auditEntries []auditLogEntry, events []rawEvent) []shardingReportShard {\r\n\tcounts := map[string]map[string]int{}\r\n\tfor _, e := range auditEntries {\r\n\t\tif counts[e.Shard] == nil {\r\n\t\t\tcounts[e.Shard] = map[string]int{}\r\n\t\t}\r\n\t\tcounts[e.Shard][e.Bucket]++\r\n\t}\r\n\ttsRanges := map[string]*shardTSRange{}\r\n\tfor _, raw := range events {\r\n"]
[19917.675011, "o", "\t\tif raw.Invalid || raw.Blank || raw.Obj == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tts, ok, _ := getRawString(raw.Obj, \"ts\")\r\n\t\tif !ok || !isExactRFC3339UTC(ts) {\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[19917.675066, "o", "\t\tr := tsRanges[raw.Shard]\r\n\t\tif r == nil {\r\n\t\t\tr = &shardTSRange{}\r\n\t\t\ttsRanges[raw.Shard] = r\r\n\t\t}\r\n\t\tif r.first == \"\" || ts < r.first {\r\n\t\t\t"]
[19917.675131, "o", "r.first = ts\r\n\t\t}\r\n\t\tif r.last == \"\" || ts > r.last {\r\n\t\t\tr.last = ts\r\n"]
[19917.675201, "o", "\t\t}\r\n\t}\r\n\tout := make([]shardingReportShard, 0, len(shards))\r\n\tfor _, s := range shards {\r\n\t\tc := counts[s.Name]\r\n\t\tr := tsRanges[s.Name]\r\n\t\trec := shardingReportShard{\r\n\t\t\tShard:                      s.Name,\r\n\t\t\tBytes:                      s.Bytes,\r\n\t\t\tSHA256:                     s.SHA256,\r\n"]
[19917.675299, "o", "\t\t\tEventsTotal:                s.EventsTotal,\r\n\t\t\tEventsAccepted:             c[\"accepted\"],\r\n\t\t\tEventsInvalid:              c[\"invalid\"],\r\n\t\t\tEventsLate:                 c[\"late\"],\r\n\t\t\tEventsDuplicate:            c[\"duplicate\"],\r\n\t\t\tEventsUnresolvedChargeback: c[\"unresolved_chargeback\"],\r\n\t\t}\r\n\t\tif r != nil && r.first != \"\" {\r\n"]
[19917.675363, "o", "\t\t\tfirst := r.first\r\n\t\t\tlast := r.last\r\n\t\t\trec.FirstTS = &first\r\n\t\t\trec.LastTS = &last\r\n\t\t}\r\n\t\tout = append(out, rec)\r\n\t}\r\n"]
[19917.675419, "o", "\treturn out\r\n}\r\n\r\ntype shardTSRange struct {\r\n\tfirst string\r\n\tlast  string\r\n}\r\n\r\nfunc isExactRFC3339UTC(s string) bool {\r\n\t_, err := time.Parse(\"2006-01-02T15:04:05Z\", s)\r\n\treturn err == nil\r\n}\r\n\r\nfunc sortShardingReportShards(shards []shardingReportShard, sortKey string) {\r\n\tswitch sortKey {\r\n\tcase \"bytes\":\r\n\t\tsort.SliceStable(shards, func(i, j int) bool {\r\n\t\t\tif shards[i].Bytes != shards[j].Bytes {\r\n\t\t\t\t"]
[19917.675508, "o", "return shards[i].Bytes < shards[j].Bytes\r\n\t\t\t}\r\n\t\t\treturn shards[i].Shard < shards[j].Shard\r\n\t"]
[19917.675539, "o", "\t})\r\n\tcase \"sha256\":\r\n\t\tsort.SliceStable(shards, func(i, j int) bool {\r\n\t\t\tif shards[i].SHA256 != shards[j].SHA256 {\r\n\t\t\t\treturn shards[i].SHA256 < shards[j].SHA256\r\n\t\t\t}\r\n\t\t\treturn shards[i].Shard < shards[j].Shard\r\n\t\t})\r\n\tdefault:\r\n\t\tsort.SliceStable(shards, func(i, j int) bool {\r\n\t\t\treturn shards[i].Shard < shards[j].Shard\r\n"]
[19917.675607, "o", "\t\t})\r\n\t}\r\n}\r\n\r\nfunc writeShardingDigest(cfg cliConfig, reportData []byte, reportBase string, shardCount int, sortKey string, reportShards []shardingReportShard) error {\r\n\th, b, err := fileDigest(cfg.shardingReport)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdigest := shardingReportDigest{\r\n\t\tSchemaVersion: shardingReportDigestSchemaVersion,\r\n\t\tReportPath:    reportBase,\r\n\t\tReportSHA256:  h,\r\n"]
[19917.67567, "o", "\t\tReportBytes:   b,\r\n\t\tShardCount:    shardCount,\r\n\t\tToolVersion:   toolVersion,\r\n\t}\r\n\tif cfg.shardingReportStrict {\r\n"]
[19917.675732, "o", "\t\tinvariant := shardsSortedInvariant(reportShards, sortKey)\r\n\t\tdigest.SortKey = sortKey\r\n\t\tdigest.ShardsSortedInvariant = &invariant\r\n\t}\r\n"]
