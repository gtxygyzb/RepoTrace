[18131.747743, "o", "   526\t\t\twinnerSet[winner] = true\r\n   527\t\t\tsameShard := true\r\n   528\t\t\tfor _, idx := range idxs {\r\n   529\t\t\t\tif candidates[idx].ev.Shard != candidates[winner].ev.Shard {\r\n   530\t\t\t\t\tsameShard = false\r\n   531\t\t\t\t\tbreak\r\n   532\t\t\t\t}\r\n   533\t\t\t}\r\n   534\t\t\tif sameShard {\r\n   535\t\t\t\tdedupPolicyStats.DuplicateWinnersSameShard++\r\n   536\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" || tiebreak {\r\n   537\t\t\t\t\tdedupPolicyStats.DuplicateWinnersLineTiebreak++\r\n   538\t\t\t\t}\r\n   539\t\t\t} else {"]
[18131.747805, "o", "\r\n   540\t\t\t\tdedupPolicyStats.DuplicateWinnersCrossShard++\r\n   541\t\t\t}\r\n   542\t\t}\r\n   543\t\r\n   544\t\t// Finalize accepted/duplicate buckets and outputs in arrival order.\r\n   545\t\thasMin, hasMax = false, false\r\n   546\t\tfor _, c := range candidates {\r\n   547\t\t\tif c.ev != nil {\r\n   548\t\t\t\tseen[c.ev.ID] = true\r\n   549\t\t\t}\r\n   550\t\t}\r\n   551\t\tbucketCounts[\"accepted\"] = 0\r\n   552\t\tbucketCounts[\"duplicate\"] = duplicateReasons[\"cross_run\"]\r\n"]
