[7342.461046, "o", "   262\tfunc readInputEvents(inputDir string) ([]rawEvent, error) {\r\n   263\t\tinfo, err := os.Stat(inputDir)\r\n   264\t\tif err != nil {\r\n   265\t\t\treturn nil, err\r\n"]
[7342.461144, "o", "   266\t\t}\r\n   267\t\tif !info.IsDir() {\r\n   268\t\t\treturn nil, errors.New(\"input-dir is not a directory\")\r\n   269\t\t}\r\n   270\t\tentries, err := os.ReadDir(inputDir)\r\n   271\t\tif err != nil {\r\n   272\t\t\treturn nil, err\r\n   273\t\t}\r\n   274\t\tvar files []string\r\n   275\t\tfor _, e := range entries {\r\n   276\t\t\tif e.IsDir() || !e.Type().IsRegular() {\r\n   277\t\t\t\tcontinue\r\n   278\t\t\t}\r\n"]
[7342.46123, "o", "   279\t\t\tfiles = append(files, e.Name())\r\n   280\t\t}\r\n   281\t\tsort.Strings(files)\r\n   282\t\tvar events []rawEvent\r\n   283\t\tfor _, name := range files {\r\n   284\t\t\tdata, err := os.ReadFile(filepath.Join(inputDir, name))\r\n   285\t\t\tif err != nil {\r\n   286\t\t\t\treturn nil, err\r\n   287\t\t\t}\r\n"]
[7342.461293, "o", "   288\t\t\tlineNo := 0\r\n   289\t\t\tfor _, line := range bytes.Split(data, []byte{'\\n'}) {\r\n   290\t\t\t\tlineNo++\r\n   291\t\t\t\ttrimmed := bytes.TrimSpace(line)\r\n   292\t\t\t\tif len(trimmed) == 0 {\r\n   293\t\t\t\t\tcontinue\r\n   294\t\t\t\t}\r\n   295\t\t"]
[7342.461351, "o", "\t\tvar obj map[string]json.RawMessage\r\n   296\t\t\t\tif err := json.Unmarshal(trimmed, &obj); err != nil {\r\n   297\t\t\t\t\tcontinue\r\n   298\t\t\t\t}\r\n   299\t\t\t\tevents = append(events, rawEvent{Shard: name, Line: lineNo, Raw: json.RawMessage(trimmed), Obj: obj})\r\n   300\t\t\t}\r\n   301\t\t}\r\n"]
[7342.461415, "o", "   302\t\treturn events, nil\r\n   303\t}\r\n   304\t\r\n   305\tfunc newContext(raw rawEvent) *eventContext {\r\n   306\t\tctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n   307\t\tctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n   308\t\tctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n   309\t\tctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n"]
[7342.461475, "o", "   310\t\treturn ctx\r\n   311\t}\r\n   312\t\r\n"]
