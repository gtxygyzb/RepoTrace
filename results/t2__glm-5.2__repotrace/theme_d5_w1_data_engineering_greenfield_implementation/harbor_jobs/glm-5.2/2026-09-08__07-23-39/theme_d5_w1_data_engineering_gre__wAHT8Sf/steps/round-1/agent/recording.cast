[14650.938652, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"time\"\r\n     7\t)\r\n     8\t\r\n     9\ttype rawJSON json.RawMessage\r\n    10\t\r\n"]
[14650.938747, "o", "    11\tfunc (r rawJSON) MarshalJSON() ([]byte, error) {\r\n    12\t\tif json.Valid(r) {\r\n    13\t\t\treturn r, nil\r\n    14\t\t}\r\n    15\t\treturn json.Marshal(string(r))\r\n    16\t}\r\n    17\t\r\n    18\ttype rawEvent struct {\r\n    19\t\tShard   string\r\n    20\t\tLine    int\r\n    21\t\tRaw     rawJSON\r\n    22\t\tObj     map[string]json.RawMessage\r\n    23\t\tInvalid bool\r\n    24\t}\r\n    25\t\r\n    26\ttype eventContext struct {\r\n"]
