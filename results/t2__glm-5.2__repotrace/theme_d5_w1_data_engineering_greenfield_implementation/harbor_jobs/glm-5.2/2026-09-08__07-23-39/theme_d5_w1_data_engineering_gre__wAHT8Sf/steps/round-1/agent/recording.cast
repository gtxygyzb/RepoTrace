[15086.681607, "o", "\tvar top map[string]json.RawMessage\r\n\tif err := json.Unmarshal(data, &top); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"rates file is not valid json: %w\", err)\r\n\t}\r\n\trt := newRateTable()\r\n\tdaysRaw, ok := top[\"days\"]\r\n\tif !ok {\r\n\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\tvar days map[string]json.RawMessage\r\n\tif err := json.Unmarshal(daysRaw, &days); err != nil {\r\n"]
[15086.681654, "o", "\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\tif len(days) == 0 {\r\n\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\tfor _, day := range sortedKeys(days) {\r\n\t\tif !isStrictDate(day) || !isDate(day) {\r\n\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: invalid day key %s\", day)\r\n\t\t}\r\n\t"]
[15086.681697, "o", "\tvar currencies map[string]json.RawMessage\r\n\t\tif err := json.Unmarshal(days[day], &currencies); err != nil {\r\n\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t\t}\r\n\t\tfor _, currency := range sortedKeys(currencies) {\r\n\t\t\tf, err := parseRateNumber(currencies[currency])\r\n"]
[15086.681745, "o", "\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: non-numeric rate for %s/%s\", day, currency)\r\n\t\t\t}\r\n\t\t\tif rt.days[day] == nil {\r\n\t\t\t\trt.days[day] = map[string]float64{}\r\n\t\t\t}\r\n\t\t\trt.days[day][currency] = f\r\n"]
[15086.68178, "o", "\t\t\trt.known[currency] = true\r\n\t\t}\r\n\t}\r\n\tbaseRaw, baseOk := top[\"base\"]\r\n\tif !baseOk {\r\n\t\treturn nil, errors.New(\"ingest: rates.json: base required\")\r\n"]
[15086.681821, "o", "\t}\r\n\tvar base string\r\n\tif err := json.Unmarshal(baseRaw, &base); err != nil || base == \"\" {\r\n\t\treturn nil, errors.New(\"ingest: rates.json: base required\")\r\n\t}\r\n\trt.base = base\r\n\tif base != \"USD\" {\r\n"]
[15086.681861, "o", "\t\treturn nil, errors.New(\"fx base must be USD\")\r\n\t}\r\n\tfor _, day := range sortedKeys(rt.days) {\r\n\t\tr, ok := rt.days[day][base]\r\n\t\tif !ok || r != 1.0 {\r\n\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: base currency %s must have rate 1.0 on day %s\", base, day)\r\n\t\t}\r\n\t}\r\n"]
[15086.6819, "o", "\treturn rt, nil\r\n"]
