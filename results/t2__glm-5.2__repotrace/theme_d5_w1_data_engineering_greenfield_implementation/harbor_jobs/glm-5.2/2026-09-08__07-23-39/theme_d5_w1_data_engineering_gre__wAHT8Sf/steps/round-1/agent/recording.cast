[17331.259702, "o", "   103\ttype summarySessions struct {\r\n   104\t\tTotal  int                  `json:\"total\"`\r\n   105\t\tByUser []summarySessionUser `json:\"by_user\"`\r\n   106\t}\r\n"]
[17331.259797, "o", "   107\t\r\n   108\ttype summarySessionUser struct {\r\n   109\t\tUser  string `json:\"user\"`\r\n   110\t\tCount int    `json:\"count\"`\r\n   111\t}\r\n   112\t\r\n   113\ttype summaryOutput struct {\r\n   114\t\tTotalEvents    int            `json:\"total_events\"`\r\n   115\t\tAcceptedEvents int            `json:\"accepted_events\"`\r\n   116\t\tRejectedEvents int            `json:\"rejected_events\"`\r\n   117\t\tTotalUSD       Money          `json:\"total_usd\"`\r\n   118\t\tAnomalies      map[string]int `json:\"anomalies\"`\r\n   119\t\tRunIndex       int            `json:\"run_index\"`\r\n   120\t\tWatermark      *string        `json:\"watermark\"`\r\n"]
[17331.259875, "o", "   121\t\tSessions       summarySessions `json:\"sessions\"`\r\n   122\t}\r\n   123\t\r\n   124\ttype auditLogEntry struct {\r\n   125\t\tShard               string         `json:\"shard\"`\r\n   126\t\tLine                int            `json:\"line\"`\r\n   127\t\tID                  string         `json:\"id\"`\r\n   128\t\tTS                  string         `json:\"ts\"`\r\n   129\t\tType                string         `json:\"type\"`\r\n   130\t\tBucket              string         `json:\"bucket\"`\r\n"]
[17331.259935, "o", "   131\t\tReason              string         `json:\"reason\"`\r\n   132\t\tWinnerArrival       *winnerArrival `json:\"winner_arrival,omitempty\"`\r\n   133\t\tEvent               rawJSON        `json:\"event\"`\r\n   134\t\tCutoff              *cutoffObject  `json:\"cutoff,omitempty\"`\r\n"]
[17331.259997, "o", "   135\t\tWatermarkLagSeconds *int           `json:\"watermark_lag_seconds,omitempty\"`\r\n   136\t\tLateBySeconds       *int           `json:\"late_by_seconds,omitempty\"`\r\n   137\t}\r\n   138\t\r\n   139\ttype cutoffObject struct {\r\n   140\t\tValue        string `json:\"value\"`\r\n   141\t\tEpochSeconds int    `json:\"epoch_seconds\"`\r\n   142\t}\r\n   143\t\r\n   144\tfunc (e auditLogEntry) MarshalJSON() ([]byte, error) {\r\n   145\t\tif e.Bucket == \"late\" {\r\n   146\t\t\tvar buf bytes.Buffer\r\n   147\t\t\tbuf.WriteString(`{\"id\":`)\r\n   148\t\t\tb, err := json.Marshal(e.ID)\r\n"]
[17331.260056, "o", "   149\t\t\tif err != nil {\r\n   150\t\t\t\treturn nil, err\r\n"]
