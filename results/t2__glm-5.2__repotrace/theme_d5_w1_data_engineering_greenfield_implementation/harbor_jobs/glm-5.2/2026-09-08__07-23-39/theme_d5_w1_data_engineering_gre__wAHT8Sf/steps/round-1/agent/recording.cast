[11749.74983, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\n# Patch types.go statePendingOut\np = Path('types.go')\ns = p.read_text()\nold = '''type statePendingOut struct {\n\\tID        string `json:\"id\"`\n\\tTS        string `json:\"ts\"`\n\\tUser      string `json:\"user\"`\n\\tUSD       Money  `json:\"usd\"`\n\\tOriginRun int    `json:\"origin_run\"`\n}'''\nnew = '''type statePendingOut struct {\n\\tID             string `json:\"id\"`\n\\tTS             string `json:\"ts\"`\n\\tFirstSeenEpoch int    `json:\"first_seen_epoch\"`\n\\tfirstSeenEpochSet bool\n\\tUser           string `json:\"user\"`\n\\tUSD            Money  `json:\"usd\"`\n\\tOriginRun      int    `json:\"origin_run\"`\n}'''\nif old in s:\n    s = s.replace(old, new, 1)\nelse:\n    print('statePendingOut old not found')\np.write_text(s)\n\n# Patch main.go loadState signature\np = Path('main.go')\ns = p.read_text()\ns = s.replace('func loadState(path string) (*loadedState, error) {', 'func loadState(path string, stateStrict bool) (*loadedState, error) {')\np.write_text(s)\n\n# Patch cli.go call site\np = Path('cli.go')\ns "]
[11749.750103, "i", "= p.read_text()\ns = s.replace('st, err = loadState(cfg.stateIn)', 'st, err = loadState(cfg.stateIn, cfg.stateStrict)')\np.write_text(s)\nPY\ngofmt -w *.go\ngo build ./...\n"]
