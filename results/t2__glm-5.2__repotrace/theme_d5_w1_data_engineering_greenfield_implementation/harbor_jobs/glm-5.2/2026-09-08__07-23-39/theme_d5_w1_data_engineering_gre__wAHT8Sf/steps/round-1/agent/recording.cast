[18213.042426, "o", "     8\t\t\"path/filepath\"\r\n     9\t\t\"regexp\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t\t\"time\"\r\n    14\t)\r\n    15\t\r\n    16\tvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n    17\t\r\n    18\ttype cliConfig struct {\r\n    19\t\tinputDir            string\r\n    20\t\tratesPath           string\r\n    21\t\toutputPath          string\r\n    22\t\trejectsPath         string\r\n    23\t\tsessionGap          int\r\n    24\t\twatermarkLag        int\r\n    25\t\tstateIn             string\r\n    26\t\tstateOut            string\r\n    27\t\tpendingTTL          int\r\n    28\t\tmaxOpenSessions     int\r\n    29\t\tauditLog            string\r\n    30\t\tauditLogDigest      string\r\n    31\t\tauditLogRotateBytes int\r\n    32\t\tratesStrict         bool\r\n    33\t\tratesMaxStaleness   int\r\n"]
[18213.042509, "o", "    34\t\tingestID            string\r\n    35\t\tingestIDSet         bool\r\n    36\t\toutManifest         string\r\n    37\t\tmanifestSignature   string\r\n    38\t\tdedupPolicy         string\r\n"]
[18213.04258, "o", "    39\t\tdedupPolicySet      bool\r\n    40\t\tstrictLateAudit     bool\r\n    41\t\tstateStrict         bool\r\n    42\t\tsummarySchemaOut    string\r\n    43\t\tsummarySchemaDigest string\r\n    44\t\tsummarySchemaStrict bool\r\n    45\t\tsummarySchemaIndex  string\r\n    46\t\trejectsFormat       string\r\n    47\t\trejectsFormatHeader bool\r\n    48\t\tsessionPolicy       string\r\n    49\t\tfixedWindowSeconds  int\r\n    50\t\tfixedWindowSet      bool\r\n    51\t}\r\n    52\t\r\n    53\tfunc main() {\r\n    54\t\tcfg, err := parseArgs(os.Args[1:])\r\n    55\t\t"]
[18213.042645, "o", "if err != nil {\r\n    56\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    57\t\t\tos.Exit(2)\r\n    58\t\t}\r\n    59\t\tif err := run(cfg); err != nil {\r\n    60\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    61\t\t\tos.Exit(1)\r\n    62\t\t}\r\n    63\t}\r\n    64\t\r\n"]
[18213.042708, "o", "    65\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n    66\t\tdefer func() {\r\n    67\t\t\tif r := recover(); r != nil {\r\n    68\t\t\t\tcfg = cliConfig{}\r\n    69\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n"]
[18213.042767, "o", "    70\t\t\t}\r\n    71\t\t}()\r\n    72\t\tcfg = cliConfig{\r\n    73\t\t\tsessionGap:        600,\r\n    74\t\t\twatermarkLag:      300,\r\n    75\t\t\tpendingTTL:        86400,\r\n    76\t\t\tmaxOpenSessions:   100000,\r\n    77\t\t\tratesMaxStaleness: 0,\r\n    78\t\t}\r\n    79\t"]
[18213.042837, "o", "\trequired := map[string]bool{\r\n    80\t\t\t\"--input-dir\": false,\r\n    81\t\t\t\"--rates\":     false,\r\n    82\t\t\t\"--output\":    false,\r\n    83\t\t\t\"--rejects\":   false,\r\n    84\t\t}\r\n"]
[18213.042895, "o", "    85\t\tif len(args) > 0 && args[0] == \"ingest\" {\r\n    86\t\t\targs = args[1:]\r\n    87\t\t}\r\n    88\t\tfor i := 0; i < len(args); i++ {\r\n    89\t\t\targ := args[i]\r\n    90\t\t\tif strings.HasPrefix(arg, \"--summary-schema-out=\") {\r\n    91\t\t\t\tcfg.summarySchemaOut = strings.TrimPrefix(arg, \"--summary-schema-out=\")\r\n    92\t\t\t\tif cfg.summarySchemaOut == \"\" {\r\n    93\t\t\t\t\t"]
[18213.042958, "o", "return cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-out: value must be non-empty\")\r\n    94\t\t\t\t}\r\n    95\t\t\t\tcontinue\r\n    96\t\t\t}\r\n    97\t\t\tif strings.HasPrefix(arg, \"--summary-schema-digest=\") {\r\n    98\t\t\t\tcfg.summarySchemaDigest = strings.TrimPrefix(arg, \"--summary-schema-digest=\")\r\n    99\t\t\t\tif cfg.summarySchemaDigest == \"\" {\r\n   100\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest: value must be non-empty\")\r\n   101\t\t\t\t}\r\n   102\t\t\t\tcontinue\r\n"]
[18213.043021, "o", "   103\t\t\t}\r\n   104\t\t\tif strings.HasPrefix(arg, \"--summary-schema-index=\") {\r\n   105\t\t\t\tcfg.summarySchemaIndex = strings.TrimPrefix(arg, \"--summary-schema-index=\")\r\n   106\t\t\t\tif cfg.summarySchemaIndex == \"\" {\r\n   107\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index: value must be non-empty\")\r\n   108\t\t\t\t}\r\n   109\t\t\t\tcontinue\r\n   110\t\t\t}\r\n   111\t\t\tswitch arg {\r\n"]
[18213.043086, "o", "   112\t\t\tcase \"--input-dir\":\r\n   113\t\t\t\tcfg.inputDir = nextArg(args, &i)\r\n   114\t\t\tcase \"--rates\":\r\n   115\t\t\t\tcfg.ratesPath = nextArg(args, &i)\r\n   116\t\t\tcase \"--output\":\r\n   117\t\t\t\tcfg.outputPath = nextArg(args, &i)\r\n   118\t\t\tcase \"--rejects\":\r\n   119\t\t\t\tcfg.rejectsPath = nextArg(args, &i)\r\n   120\t\t\tcase \"--session-gap\":\r\n"]
[18213.043169, "o", "   121\t\t\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\r\n   122\t\t\tcase \"--watermark-lag\":\r\n   123\t\t\t\tcfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")\r\n   124\t\t\tcase \"--state-in\":\r\n   125\t\t\t\tcfg.stateIn = nextArg(args, &i)\r\n   126\t\t\tcase \"--state-out\":\r\n   127\t\t\t\tcfg.stateOut = nextArg(args, &i)\r\n   128\t\t\tcase \"--pending-ttl\":\r\n   129\t\t\t\tcfg.pendingTTL = atoiOrError(nextArg(args, &i), \"--pending-ttl\")\r\n   130\t\t\tcase \"--max-open-sessions\":\r\n   131\t\t\t\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-sessions\")\r\n"]
[18213.043209, "o", "   132\t\t\tcase \"--audit-log\":\r\n   133\t\t\t\tcfg.auditLog = nextArg(args, &i)\r\n   134\t\t\tcase \"--audit-log-digest\":\r\n"]
[18213.043339, "o", "   135\t\t\t\tcfg.auditLogDigest = nextArg(args, &i)\r\n   136\t\t\tcase \"--audit-log-rotate-bytes\":\r\n   137\t\t\t\tcfg.auditLogRotateBytes = atoiOrError(nextArg(args, &i), \"--audit-log-rotate-bytes\")\r\n   138\t\t\tcase \"--rates-strict\":\r\n   139\t\t\t\tcfg.ratesStrict = true\r\n   140\t\t\tcase \"--rates-max-staleness\":\r\n   141\t\t\t\tcfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), \"--rates-max-staleness\")\r\n   142\t\t\tcase \"--ingest-id\":\r\n   143\t\t\t\tcfg.ingestID = nextArg(args, &i)\r\n   144\t\t\t\tcfg.ingestIDSet = true\r\n   145\t\t\tcase \"--out-parquet-manifest\":\r\n   146\t\t\t\tcfg.outManifest = nextArg(args, &i)\r\n   147\t\t\tcase \"--manifest-signature\":\r\n   148\t\t\t\tcfg.manifestSignature = nextArg(args, &i)\r\n   149\t\t\tcase \"--dedup-policy\":\r\n   150\t\t\t\tval := nextArg(args, &i)\r\n   151\t\t\t\tif val != \"first-arrival\" && val != \"lex-largest-ts\" {\r\n   152\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --dedup-policy: must be one of {first-arrival, lex-largest-ts}\")\r\n   153\t\t\t\t}\r\n   154\t\t"]
[18213.0434, "o", "\t\tcfg.dedupPolicy = val\r\n   155\t\t\t\tcfg.dedupPolicySet = true\r\n   156\t\t\tcase \"--strict-late-audit\":\r\n   157\t\t\t\tcfg.strictLateAudit = true\r\n   158\t\t\tcase \"--state-strict\":\r\n   159\t\t\t\tcfg.stateStrict = true\r\n   160\t\t\tcase \"--summary-schema-out\":\r\n   161\t\t\t\tcfg.summarySchemaOut = nextArg(args, &i)\r\n"]
[18213.043474, "o", "   162\t\t\t\tif cfg.summarySchemaOut == \"\" {\r\n   163\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-out: value must be non-empty\")\r\n   164\t\t\t\t}\r\n   165\t\t\tcase \"--summary-schema-digest\":\r\n   166\t\t\t\tcfg.summarySchemaDigest = nextArg(args, &i)\r\n   167\t\t\t\tif cfg.summarySchemaDigest == \"\" {\r\n   168\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest: value must be non-empty\")\r\n   169\t\t\t\t}\r\n   170\t\t\tcase \"--summary-schema-strict\":\r\n   171\t\t\t\tcfg.summarySchemaStrict = true\r\n   172\t\t\tcase \"--summary-schema-index\":\r\n   173\t\t\t\tcfg.summarySchemaIndex = nextArg(args, &i)\r\n"]
[18213.043544, "o", "   174\t\t\t\tif cfg.summarySchemaIndex == \"\" {\r\n   175\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index: value must be non-empty\")\r\n   176\t\t\t\t}\r\n   177\t\t\tcase \"--rejects-format\":\r\n   178\t\t\t\tval := nextArg(args, &i)\r\n   179\t\t\t\tif val != \"legacy\" && val != \"tagged\" && val != \"tagged-sorted\" {\r\n   180\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --rejects-format: must be one of {legacy, tagged, tagged-sorted}\")\r\n   181\t\t\t\t}\r\n   182\t\t\t\tcfg.rejectsFormat = val\r\n   183\t\t\tcase \"--session-policy\":\r\n"]
[18213.043602, "o", "   184\t\t\t\tval := nextArg(args, &i)\r\n   185\t\t\t\tif val != \"gap\" && val != \"fixed-window\" && val != \"hybrid\" {\r\n   186\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --session-policy: must be one of {gap, fixed-window, hybrid}\")\r\n   187\t\t\t\t}\r\n   188\t\t\t\tcfg.sessionPolicy = val\r\n   189\t\t\tcase \"--fixed-window-seconds\":\r\n   190\t\t\t\tcfg.fixedWindowSeconds = atoiOrError(nextArg(args, &i), \"--fixed-window-seconds\")\r\n   191\t\t\t\tcfg.fixedWindowSet = true\r\n"]
