[9827.491089, "i", "nl -ba main.go | sed -n '357,384p'\n"]
[9827.49144, "o", "nl -ba main.go | sed -n '357,384p'\r\n\u001b[?2004l\r"]
[9827.495277, "o", "   357\t\tev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n   358\t\tswitch typeStr {\r\n   359\t\tcase \"purchase\", \"refund\":\r\n   360\t\t\tvar amount float64\r\n   361\t\t\tif v == 1 {\r\n"]
[9827.495399, "o", "   362\t\t\t\traw, present := obj[\"amount\"]\r\n   363\t\t\t\tif !present {\r\n   364\t\t\t\t\treturn nil, \"missing_amount\"\r\n   365\t\t\t\t}\r\n   366\t\t\t\tvar f float64\r\n   367\t\t\t\tif err := json.Unmarshal(raw, &f); err != nil {\r\n   368\t\t\t\t\treturn nil, \"bad_amount\"\r\n   369\t\t\t\t}\r\n   370"]
[9827.495474, "o", "\t\t\t\tif !isFinite(f) || f < 0 {\r\n   371\t\t\t\t\treturn nil, \"bad_amount\"\r\n   372\t\t\t\t}\r\n   373\t\t\t\tamount = f\r\n   374\t\t\t} else {\r\n   375\t\t\t\traw, present := obj[\"amount_cents\"]\r\n   376\t\t\t\tif !present {\r\n   377\t\t\t\t\treturn nil, \"missing_amount\"\r\n   378\t\t\t\t}\r\n   379\t\t\t\tn, err := getJSONInt(raw)\r\n   380\t\t\t\tif err != nil || n < 0 {\r\n   381\t\t\t\t\treturn nil, \"bad_amount\"\r\n   382"]
[9827.495567, "o", "\t\t\t\t}\r\n   383\t\t\t\tamount = float64(n) / 100.0\r\n   384\t\t\t}\r\n"]
