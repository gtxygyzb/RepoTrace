[15758.408684, "i", "python3 - <<'PY'\nfrom pathlib import Path\nlines = Path('cli.go').read_text().splitlines(keepends=True)\n\n# Fix duplicate reject record to include shard/line\nfor i,line in enumerate(lines):\n    if 'r := rejectRecord{bucket: \"duplicate\", reason: \"same_run\", raw: c.raw.Raw}' in line:\n        lines[i] = line.replace('raw: c.raw.Raw}', 'shard: c.raw.Shard, line: c.raw.Line, raw: c.raw.Raw}', 1)\n        break\n\n# Insert blank records block after line 545 (index 544) before line 547 (summary)\nfor i,line in enumerate(lines):\n    if line.strip() == '}' and i > 0 and 'rejectRecords = append(rejectRecords, r)' in lines[i-1] and i+1 < len(lines) and lines[i+1].strip() == '' and i+2 < len(lines) and 'summary := summaryOutput' in lines[i+2]:\n        insert = [\n            '\\n',\n            '\\tif cfg.rejectsFormat == \"tagged\" || cfg.rejectsFormat == \"tagged-sorted\" {\\n',\n            '\\t\\tfor _, b := range blanks {\\n',\n            '\\t\\t\\trejectRecords = append(rejectRecords, rejectRecord{\\n',\n            '\\t\\t\\t\\tbucket: \"inva"]
[15758.408983, "i", "lid\",\\n',\n            '\\t\\t\\t\\treason: \"schema_version\",\\n',\n            '\\t\\t\\t\\tshard:  b.Shard,\\n',\n            '\\t\\t\\t\\tline:   b.Line,\\n',\n            '\\t\\t\\t\\traw:    rawJSON(\"-\"),\\n',\n            '\\t\\t\\t})\\n',\n            '\\t\\t}\\n',\n            '\\t}\\n',\n        ]\n        lines[i+1:i+1] = insert\n        break\nelse:\n    raise SystemExit('insert point not found')\n\nPath('cli.go').write_text(''.join(lines))\nprint('blank records and duplicate shard/line fixed')\nPY\n"]
