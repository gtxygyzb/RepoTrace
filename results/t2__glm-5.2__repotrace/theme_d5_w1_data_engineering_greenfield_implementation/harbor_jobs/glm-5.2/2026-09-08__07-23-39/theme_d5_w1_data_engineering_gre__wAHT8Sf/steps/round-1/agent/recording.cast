[12700.568384, "o", "\t\tb, err := json.Marshal(e)\r\n\t\t\tif err != nil {\r\n\t\t\t\tpanic(err)\r\n\t\t\t}\r\n\t\t\tbuf.Write(b)\r\n\t\t\tbuf.WriteByte('\\n')\r\n\t\t}\r\n\t\tif err := atomicWriteFile(path, buf.Bytes()); err != nil {\r\n\t\t\tpanic(err)\r\n\t\t}\r\n"]
[12700.56843, "o", "\t\treturn []string{path}\r\n\t}\r\n\r\n\tcurrent := path\r\n\tvar buf bytes.Buffer\r\n\tflush := func() {\r\n\t\tif err := atomicWriteFile(current, buf.Bytes()); err != nil {\r\n\t\t\tpanic(err)\r\n"]
