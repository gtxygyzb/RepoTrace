[12611.717626, "o", "   256\t\r\n   257\t\t// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.\r\n   258\t\tfor _, raw := range events {\r\n   259\t\t\tctx := newContext(raw)\r\n   260\t\t\tbucket := \"invalid\"\r\n   261\t\t\treason := \"\"\r\n   262\t"]
