[4680.001127, "o", "type Money float64\r\n\u001b[?2004l\r"]
[4680.001185, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4680.001266, "o", "\u001b[?2004h> "]
[4680.001592, "o", "func (m Money) MarshalJSON() ([]byte, error) {\r\n\u001b[?2004l\r"]
[4680.001649, "o", "\u001b[?2004h> "]
[4680.001877, "o", "  return []byte(m.String()), nil\r\n\u001b[?2004l\r"]
[4680.001932, "o", "\u001b[?2004h> }"]
[4680.001987, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[4680.002045, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4680.002104, "o", "> "]
[4680.002335, "o", "func (m Money) String() string {\r\n\u001b[?2004l\r"]
[4680.002391, "o", "\u001b[?2004h> "]
[4680.002517, "o", "  f := float64(m)\r\n\u001b[?2004l\r"]
[4680.002573, "o", "\u001b[?2004h> "]
[4680.002723, "o", "  abs := math.Abs(f)\r\n\u001b[?2004l\r"]
[4680.002788, "o", "\u001b[?2004h> "]
[4680.003108, "o", "  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n\u001b[?2004l\r"]
[4680.003164, "o", "\u001b[?2004h> "]
[4680.00338, "o", "  neg := f < 0 && cents != 0\r\n\u001b[?2004l\r"]
[4680.003436, "o", "\u001b[?2004h> "]
[4680.003603, "o", "  dollars := cents / 100\r\n\u001b[?2004l\r"]
[4680.003659, "o", "\u001b[?2004h> "]
[4680.003804, "o", "  rem := cents % 100\r\n\u001b[?2004l\r"]
[4680.003865, "o", "\u001b[?2004h> "]
[4680.004169, "o", "  s := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n\u001b[?2004l\r"]
[4680.004236, "o", "\u001b[?2004h> "]
[4680.004313, "o", "  if neg {\r\n\u001b[?2004l\r"]
[4680.004374, "o", "\u001b[?2004h> "]
[4680.004512, "o", "    s = \"-\" + s\r\n\u001b[?2004l\r"]
[4680.004575, "o", "\u001b[?2004h> "]
[4680.004632, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[4680.004688, "o", "> "]
[4680.004874, "o", "  return s\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[4680.004964, "o", "\u001b[?2004h"]
