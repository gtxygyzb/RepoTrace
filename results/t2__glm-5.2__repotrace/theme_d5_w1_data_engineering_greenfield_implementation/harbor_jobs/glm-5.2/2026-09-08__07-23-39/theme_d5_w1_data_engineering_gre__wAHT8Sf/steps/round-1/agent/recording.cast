[9764.415943, "o", "   306\tfunc newContext(raw rawEvent) *eventContext {\r\n   307\t\tctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n   308\t\tif raw.Obj != nil {\r\n   309\t\t\tctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n"]
[9764.416054, "o", "   310\t\t\tctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n   311\t\t\tctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n   312\t\t}\r\n   313\t\treturn ctx\r\n   314\t}\r\n   315\t\r\n   316\tfunc parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {\r\n   317\t\tobj := ctx.Obj\r\n   318\t\tif obj == nil {\r\n   319\t\t\treturn nil, \"invalid_json\"\r\n   320\t\t}\r\n   321\t\traw, ok := obj[\"v\"]\r\n   322\t\tif !ok {\r\n"]
[9764.416134, "o", "   323\t\t\treturn nil, \"schema_version\"\r\n   324\t\t}\r\n   325\t\tvar v int\r\n   326\t\tif err := json.Unmarshal(raw, &v); err != nil {\r\n   327\t\t\treturn nil, \"schema_version\"\r\n   328\t\t}\r\n   329\t\tif v != 1 && v != 2 {\r\n   330\t\t\treturn nil, \"schema_version\"\r\n   331\t\t}\r\n   332\t\tid, idOk, _ := getRawString(obj, \"id\")\r\n   333\t\tif !idOk || id == \"\" {\r\n"]
[9764.416219, "o", "   334\t\t\treturn nil, \"missing_id\"\r\n   335\t\t}\r\n"]
