[5486.582027, "o", "     7\t  \"encoding/json\"\r\n     8\t  \"errors\"\r\n     9\t  \"fmt\"\r\n    10\t  \"math\"\r\n    11\t  \"os\"\r\n    12\t  \"path/filepath\"\r\n    13\t  \"sort\"\r\n    14\t  \"strconv\"\r\n    15\t  \"strings\"\r\n    16\t  \"time\"\r\n    17\t)\r\n    18\t\r\n"]
[5486.582238, "o", "    19\tvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--audit-log <path>] [--audit-log-digest <path>]\\n\"\r\n    20\t\r\n    21\ttype Money float64\r\n    22\t\r\n    23\tfunc (m Money) MarshalJSON() ([]byte, error) {\r\n    24\t  return []byte(m.String()), nil\r\n    25\t}\r\n    26\t\r\n    27\tfunc (m Money) String() string {\r\n    28\t  f := float64(m)\r\n    29\t  abs := math.Abs(f)\r\n    30\t  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n    31\t  neg := f < 0 && cents != 0\r\n    32\t  dollars := cents / 100\r\n    33\t  rem := cents % 100\r\n    34\t  s := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n    35\t  if neg {\r\n    36\t    s = \"-\" + s\r\n    37\t  }\r\n    38\t  return s\r\n    39\t}\r\n    40\t\r\n    41\ttype Event struct {\r\n    42\t  ID       string\r\n    43\t  Type     string\r\n    44\t  TS       time.Time\r\n    45"]
[5486.582296, "o", "\t  UserID   string\r\n    46\t  Amount   float64\r\n    47\t  Currency string\r\n    48\t  RefID    string\r\n    49\t  USD      float64\r\n    50\t  RefUSD   float64\r\n    51\t  Raw      json.RawMessage\r\n    52\t  Shard    string\r\n    53\t  Line     int\r\n    54\t}\r\n"]
[5486.582411, "o", "    55\t\r\n    56\ttype Reject struct {\r\n    57\t  Bucket int             `json:\"bucket\"`\r\n    58\t  Reason string          `json:\"reason\"`\r\n    59\t  Event  json.RawMessage `json:\"event\"`\r\n    60\t}\r\n    61\t\r\n    62\ttype ShardLine struct {\r\n    63\t  Shard string\r\n    64\t  Line  int\r\n    65\t  Data  []byte\r\n    66\t}\r\n    67\t\r\n    68\ttype RateTable struct {\r\n    69\t  byDate map[string]map[string]float64\r\n    70\t  global map[string]float64\r\n    71\t}\r\n    72\t\r\n    73\ttype pendingEntry struct {\r\n"]
[5486.582496, "o", "    74\t  id        string\r\n    75\t  ts        time.Time\r\n    76\t  user      string\r\n    77\t  usd       float64\r\n    78\t  originRun int\r\n    79\t  retired   bool\r\n    80\t}\r\n    81\t\r\n    82\ttype carriedSession struct {\r\n    83\t  user         string\r\n    84\t  lastTs       time.Time\r\n    85\t  sessionIndex int\r\n"]
