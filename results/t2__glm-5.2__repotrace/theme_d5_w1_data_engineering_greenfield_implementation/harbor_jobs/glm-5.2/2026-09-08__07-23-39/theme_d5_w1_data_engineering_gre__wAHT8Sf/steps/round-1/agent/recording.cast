[20073.93015, "o", "    88\t\tSchemaVersion string                         `json:\"schema_version\"`\r\n    89\t\tReportPath    string                         `json:\"report_path\"`\r\n    90\t\tShardCount    int                            `json:\"shard_count\"`\r\n    91\t\tBuckets       shardingReportHistogramBuckets `json:\"buckets\"`\r\n    92\t\tToolVersion   string                         `json:\"tool_version\"`\r\n    93\t}\r\n    94\t\r\n    95\tfunc writeShardingReportSidecars(cfg cliConfig, shards []inputShardInfo, auditEntries []auditLogEntry, events []rawEvent) error {\r\n    96\t\tif cfg.shardingReport == \"\" {\r\n    97\t\t\treturn nil\r\n    98\t\t}\r\n    99\t\treportShards := buildShardingReportShards(cfg, shards, auditEntries, events)\r\n   100\t\tsortKey := cfg.shardingReportSort\r\n   101\t\tif sortKey == \"\" {\r\n   102\t\t\tsortKey = \"basename\"\r\n   103\t\t}\r\n   104\t\tsortShardingReportShards(reportShards, sortKey)\r\n   105\t\r\n   106\t\tvar ingestID *string\r\n   107\t\tif cfg.ingestIDSet {\r\n   108\t\t\tid := cfg.ingestID\r\n   109\t\t\tingestID = &id\r\n   110\t\t}\r\n   111\t\ttotals := shardingRepor"]
[20073.930309, "o", "tTotals{Shards: len(reportShards)}\r\n   112\t\tfor _, s := range reportShards {\r\n   113\t\t\ttotals.BytesTotal += s.Bytes\r\n   114\t\t\ttotals.EventsTotal += s.EventsTotal\r\n   115\t\t\ttotals.EventsAccepted += s.EventsAccepted\r\n   116\t\t\ttotals.EventsInvalid += s.EventsInvalid\r\n   117\t\t\ttotals.EventsLate += s.EventsLate\r\n   118\t\t\ttotals.EventsDuplicate += s.EventsDuplicate\r\n   119\t\t\ttotals.EventsUnresolvedChargeback += s.EventsUnresolvedChargeback\r\n   120\t\t}\r\n   121\t\treport := shardingReport{\r\n   122\t\t\tSchemaVersion: shardingReportSchemaVersion,\r\n   123\t\t\tIngestID:      ingestID,\r\n   124\t\t\tShards:        reportShards,\r\n   125\t\t\tTotals:        totals,\r\n   126\t\t}\r\n   127\t\tdata, err := json.MarshalIndent(report, \"\", \"  \")\r\n   128\t\tif err != nil {\r\n   129\t\t\treturn err\r\n   130\t\t}\r\n   131\t\tdata = append(data, '\\n')\r\n   132\t\tif err := atomicWriteFile(cfg.shardingReport, data); err != nil {\r\n   133\t\t\treturn err\r\n   134\t\t}\r\n   135\t\r\n   136\t\treportBase := filepath.Base(cfg.shardingReport)\r\n   137\t\tif cfg.shardingReportHistogram != \""]
[20073.930378, "o", "\" {\r\n   138\t\t\tif err := writeShardingHistogram(cfg.shardingReportHistogram, reportBase, reportShards, totals.Shards); err != nil {\r\n   139\t\t\t\treturn err\r\n   140\t\t\t}\r\n   141\t\t}\r\n   142\t\tif cfg.shardingReportDigest != \"\" {\r\n   143\t\t\tif err := writeShardingDigest(cfg, data, reportBase, totals.Shards, sortKey, reportShards); err != nil {\r\n   144\t\t\t\treturn err\r\n   145\t\t\t}\r\n   146\t\t}\r\n   147\t\tif cfg.shardingReportIndex != \"\" {\r\n   148\t\t\tif err := writeShardingIndex(cfg.shardingReportIndex, reportBase, reportShards); err != nil {\r\n   149\t\t\t\treturn err\r\n   150\t\t\t}\r\n"]
