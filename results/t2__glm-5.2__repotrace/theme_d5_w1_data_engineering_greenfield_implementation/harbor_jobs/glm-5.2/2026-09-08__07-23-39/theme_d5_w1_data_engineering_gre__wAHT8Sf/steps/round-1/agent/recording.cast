[16515.626987, "o", "   150\t\t\t\t}\r\n   151\t\t\t\tcfg.dedupPolicy = val\r\n   152\t\t\t\tcfg.dedupPolicySet = true\r\n   153\t\t\tcase \"--strict-late-audit\":\r\n   154\t\t\t\tcfg.strictLateAudit = true\r\n   155\t\t\tcase \"--state-strict\":\r\n   156\t\t\t\tcfg.stateStrict = true\r\n"]
[16515.62706, "o", "   157\t\t\tcase \"--summary-schema-out\":\r\n   158\t\t\t\tcfg.summarySchemaOut = nextArg(args, &i)\r\n   159\t\t\t\tif cfg.summarySchemaOut == \"\" {\r\n   160\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-out: value must be non-empty\")\r\n   161\t\t\t\t}\r\n   162\t\t\tcase \"--summary-schema-digest\":\r\n   163\t\t\t\tcfg.summarySchemaDigest = nextArg(args, &i)\r\n   164\t\t\t\tif cfg.summarySchemaDigest == \"\" {\r\n"]
[16515.627132, "o", "   165\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest: value must be non-empty\")\r\n   166\t\t\t\t}\r\n   167\t\t\tcase \"--summary-schema-strict\":\r\n   168\t\t\t\tcfg.summarySchemaStrict = true\r\n   169\t\t\tcase \"--summary-schema-index\":\r\n   170\t\t\t\tcfg.summarySchemaIndex = nextArg(args, &i)\r\n   171\t\t\t\tif cfg.summarySchemaIndex == \"\" {\r\n   172\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index: value must be non-empty\")\r\n   173\t\t\t\t}\r\n"]
[16515.62723, "o", "   174\t\t\tcase \"--rejects-format\":\r\n   175\t\t\t\tval := nextArg(args, &i)\r\n   176\t\t\t\tif val != \"legacy\" && val != \"tagged\" && val != \"tagged-sorted\" {\r\n"]
[16515.627308, "o", "   177\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --rejects-format: must be one of {legacy, tagged, tagged-sorted}\")\r\n   178\t\t\t\t}\r\n   179\t\t\t\tcfg.rejectsFormat = val\r\n   180\t\t\tcase \"--rejects-format-header\":\r\n   181\t\t\t\tcfg.rejectsFormatHeader = true\r\n   182\t\t\tdefault:\r\n   183\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: unknown flag %s\", arg)\r\n   184\t\t\t}\r\n   185\t\t\tif strings.HasPrefix(arg, \"--\") && arg != \"--rates-strict\" && arg != \"--strict-late-audit\" && arg != \"--state-strict\" {\r\n"]
[16515.627374, "o", "   186\t\t\t\tif _, ok := required[arg]; ok {\r\n   187\t\t\t\t\trequired[arg] = true\r\n   188\t\t\t\t}\r\n   189\t\t\t}\r\n   190\t\t}\r\n   191\t\tfor k, ok := range required {\r\n   192\t\t\tif !ok {\r\n"]
[16515.627445, "o", "   193\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: %s is required\", k)\r\n   194\t\t\t}\r\n   195\t\t}\r\n   196\t\tif cfg.ingestIDSet {\r\n   197\t\t\tif len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {\r\n   198\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)\")\r\n   199"]
[16515.627512, "o", "\t\t\t}\r\n   200\t\t}\r\n   201\t\tif cfg.outManifest == \"\" && cfg.manifestSignature != \"\" {\r\n   202\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --manifest-signature requires --out-parquet-manifest\")\r\n   203\t\t}\r\n   204\t\tif cfg.outManifest != \"\" && !parentDirExists(cfg.outManifest) {\r\n"]
[16515.627584, "o", "   205\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest --out-parquet-manifest parent directory does not exist\")\r\n   206\t\t}\r\n   207\t\tif cfg.manifestSignature != \"\" && !parentDirExists(cfg.manifestSignature) {\r\n   208\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest --manifest-signature parent directory does not exist\")\r\n   209\t\t}\r\n   210\t\tif cfg.strictLateAudit && cfg.auditLog == \"\" {\r\n"]
[16515.62765, "o", "   211\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --strict-late-audit requires --audit-log\")\r\n   212\t\t}\r\n   213\t\tif cfg.auditLogRotateBytes != 0 {\r\n   214\t\t\tif cfg.auditLog == \"\" {\r\n   215\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --audit-log-rotate-bytes requires --audit-log\")\r\n   216\t\t\t}\r\n"]
[16515.627726, "o", "   217\t\t\tif cfg.auditLogRotateBytes < 4096 {\r\n   218\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --audit-log-rotate-bytes: must be a positive integer >= 4096\")\r\n   219\t\t\t}\r\n   220\t\t}\r\n   221\t\tif cfg.summarySchemaDigest != \"\" && cfg.summarySchemaOut == \"\" {\r\n   222\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest requires --summary-schema-out\")\r\n   223\t\t}\r\n   224\t\tif cfg.summarySchemaStrict && cfg.summarySchemaOut == \"\" {\r\n"]
[16515.62781, "o", "   225\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-strict requires --summary-schema-out\")\r\n   226\t\t}\r\n   227\t\tif cfg.summarySchemaIndex != \"\" && (cfg.summarySchemaOut == \"\" || cfg.summarySchemaDigest == \"\") {\r\n   228\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index requires --summary-schema-out and --summary-schema-digest\")\r\n   229\t\t}\r\n   230\t\tif cfg.summarySchemaOut != \"\" && !parentDirExists(cfg.summarySchemaOut) {\r\n   231\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest --summary-schema-out parent directory does not exist\")\r\n   232\t\t}\r\n   233"]
[16515.62788, "o", "\t\tif cfg.summarySchemaDigest != \"\" && !parentDirExists(cfg.summarySchemaDigest) {\r\n   234\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest --summary-schema-digest parent directory does not exist\")\r\n   235\t\t}\r\n   236\t\tif cfg.summarySchemaIndex != \"\" && !parentDirExists(cfg.summarySchemaIndex) {\r\n   237\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest --summary-schema-index parent directory does not exist\")\r\n   238\t\t}\r\n   239\t\tif cfg.dedupPolicy == \"\" {\r\n   240\t\t\tcfg.dedupPolicy = \"lex-largest-ts\"\r\n"]
[16515.62795, "o", "   241\t\t}\r\n   242\t\tif cfg.rejectsFormat == \"\" {\r\n   243\t\t\tcfg.rejectsFormat = \"legacy\"\r\n   244\t\t}\r\n   245\t\tif cfg.rejectsFormat == \"tagged\" && cfg.auditLog == \"\" {\r\n   246\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --rejects-format tagged requires --audit-log\")\r\n   247\t\t}\r\n"]
[16515.628018, "o", "   248\t\tif cfg.rejectsFormat == \"tagged-sorted\" && cfg.auditLog == \"\" {\r\n   249\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --rejects-format tagged-sorted requires --audit-log\")\r\n   250\t\t}\r\n   251\t\tif cfg.rejectsFormatHeader && cfg.rejectsFormat != \"tagged\" && cfg.rejectsFormat != \"tagged-sorted\" {\r\n   252\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --rejects-format-header requires --rejects-format tagged\")\r\n   253\t\t}\r\n   254\t\treturn cfg, nil\r\n"]
[16515.628092, "o", "   255\t}\r\n   256\t\r\n   257\tfunc nextArg(args []string, i *int) string {\r\n   258\t\tif *i+1 >= len(args) {\r\n   259\t\t\tpanic(fmt.Errorf(\"ingest: missing value for %s\", args[*i]))\r\n   260\t\t}\r\n   261\t\t*i++\r\n   262\t\treturn args[*i]\r\n   263\t}\r\n   264\t\r\n   265"]
[16515.62816, "o", "\tfunc atoiOrError(s, flag string) int {\r\n   266\t\tn, err := strconv.Atoi(s)\r\n   267\t\tif err != nil {\r\n   268\t\t\tpanic(fmt.Errorf(\"ingest: invalid integer for %s: %s\", flag, s))\r\n   269\t\t}\r\n   270\t\treturn n\r\n"]
