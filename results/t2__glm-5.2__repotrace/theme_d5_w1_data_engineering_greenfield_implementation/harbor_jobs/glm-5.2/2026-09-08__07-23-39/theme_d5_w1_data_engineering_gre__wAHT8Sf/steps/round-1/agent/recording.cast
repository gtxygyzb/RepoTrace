[18116.030586, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t\"errors\"\r\n\t\"fmt\"\r\n"]
[18116.030694, "o", "\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\nvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--state-strict] [--audit-log <path>] [--audit-log-digest <path>] [--audit-log-rotate-bytes <int>] [--rates-strict] [--rates-max-staleness <seconds>] [--ingest-id <string>] [--out-parquet-manifest <path>] [--manifest-signature <path>] [--dedup-policy <first-arrival|lex-largest-ts>] [--strict-late-audit] [--summary-schema-out <path>] [--summary-schema-digest <path>] [--summary-schema-strict] [--summary-schema-index <path>] [--rejects-format <legacy|tagged|tagged-sorted>] [--rejects-format-header] [--session-policy <gap|fixed-window|hybrid>] [--fixed-window-seconds <int>]\\n\"\r\n\r\ntype Money float64\r\n\r\nfunc (m Money) MarshalJSON() ([]byte, error) {\r\n\treturn []byte(m.String()), nil\r\n}\r\n\r\nfunc (m Money) String() s"]
[18116.030774, "o", "tring {\r\n\tf := float64(m)\r\n\tabs := math.Abs(f)\r\n\tcents := int64(math.Floor(abs*100.0 + 0.5))\r\n\tneg := f < 0 && cents != 0\r\n\tdollars := cents / 100\r\n\trem := cents % 100\r\n\ts := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n\tif neg {\r\n\t\ts = \"-\" + s\r\n\t}\r\n\treturn s\r\n}\r\n\r\ntype Event struct {\r\n\tID                string\r\n\tType              string\r\n\tTS                time.Time\r\n"]
[18116.030846, "o", "\tUserID            string\r\n\tAmount            float64\r\n\tCurrency          string\r\n\tRefID             string\r\n\tUSD               float64\r\n\tRefUSD            float64\r\n\tFXFallbackDays    int\r\n\tResolvedAgainst   *string\r\n\tResolvedOriginRun int\r\n\tSessionIndex      int\r\n\tRaw               rawJSON\r\n\tShard             string\r\n\tLine              int\r\n"]
[18116.030905, "o", "}\r\n\r\ntype Reject struct {\r\n\tBucket int     `json:\"bucket\"`\r\n\tEvent  rawJSON `json:\"event\"`\r\n}\r\n\r\ntype ShardLine struct {\r\n\tShard string\r\n"]
[18116.030968, "o", "\tLine  int\r\n\tData  []byte\r\n}\r\n\r\ntype RateTable struct {\r\n\tbase  string\r\n\tdays  map[string]map[string]float64\r\n\tknown map[string]bool\r\n}\r\n\r\nfunc newRateTable() *RateTable {\r\n\treturn &RateTable{base: \"USD\", days: map[string]map[string]float64{}, known: map[string]bool{}}\r\n}\r\n\r\nfunc isUsableRate(f float64) bool {\r\n"]
[18116.031028, "o", "\treturn isFinite(f) && f > 0\r\n}\r\n\r\nfunc parseRateNumber(raw json.RawMessage) (float64, error) {\r\n\tif bytes.Equal(bytes.TrimSpace(raw), []byte(\"null\")) {\r\n\t\treturn 0, errors.New(\"non-numeric rate\")\r\n\t}\r\n\tvar f float64\r\n\tif err := json.Unmarshal(raw, &f); err != nil {\r\n"]
[18116.031084, "o", "\t\treturn 0, errors.New(\"non-numeric rate\")\r\n\t}\r\n\treturn f, nil\r\n}\r\n\r\nfunc sortedKeys[T any](m map[string]T) []string {\r\n\tkeys := make([]string, 0, len(m))\r\n\tfor k := range m {\r\n\t\tkeys = append(keys, k)\r\n\t}\r\n\tsort.Strings(keys)\r\n"]
[18116.031146, "o", "\treturn keys\r\n}\r\n\r\nfunc isStrictDate(s string) bool {\r\n\tif len(s) != 10 {\r\n\t\treturn false\r\n\t}\r\n\tfor i, c := range s {\r\n\t\tif i == 4 || i == 7 {\r\n\t\t\tif c != '-' {\r\n"]
[18116.031214, "o", "\t\t\t\treturn false\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif c < '0' || c > '9' {\r\n\t\t\treturn false\r\n\t\t}\r\n"]
[18116.031278, "o", "\t}\r\n\treturn true\r\n}\r\n\r\nfunc dayEpoch(date string) time.Time {\r\n\tt, err := time.Parse(\"2006-01-02\", date)\r\n\tif err != nil {\r\n\t\treturn time.Time{}\r\n\t}\r\n\treturn t.UTC()\r\n}\r\n\r\nfunc calendarDayDiff(rateDate, eventDate string) int {\r\n\tr := dayEpoch(rateDate)\r\n"]
[18116.031336, "o", "\te := dayEpoch(eventDate)\r\n\tif r.IsZero() || e.IsZero() {\r\n\t\treturn 0\r\n\t}\r\n\treturn int(r.Sub(e) / (24 * time.Hour))\r\n}\r\n\r\nfunc absInt(v int) int {\r\n\tif v < 0 {\r\n\t\treturn -v\r\n"]
[18116.031397, "o", "\t}\r\n\treturn v\r\n}\r\n\r\nfunc absInt64(v int64) int64 {\r\n\tif v < 0 {\r\n\t\treturn -v\r\n\t}\r\n\treturn v\r\n"]
[18116.031453, "o", "}\r\n\r\nfunc (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {\r\n\tif !rt.known[currency] {\r\n\t\treturn 0, 0, \"fx_unknown_currency\"\r\n\t}\r\n\tif m, ok := rt.days[date]; ok {\r\n\t\tif r, ok := m[currency]; ok {\r\n"]
[18116.031516, "o", "\t\t\tif isUsableRate(r) {\r\n\t\t\t\treturn r, 0, \"\"\r\n\t\t\t}\r\n\t\t\treturn 0, 0, \"bad_rate\"\r\n\t\t}\r\n\t}\r\n\tif maxStaleness > 0 {\r\n\t\teventDay := dayEpoch(date)\r\n\t\tif !eventDay.IsZero() {\r\n"]
[18116.031574, "o", "\t\t\tvar bestDate string\r\n\t\t\tvar bestDist int64 = -1\r\n\t\t\tfor _, d := range sortedKeys(rt.days) {\r\n\t\t\t\tif _, ok := rt.days[d][currency]; !ok {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tdayTime := dayEpoch(d)\r\n\t\t\t\tif dayTime.IsZero() {\r\n\t\t\t\t\tcontinue\r\n"]
[18116.03163, "o", "\t\t\t\t}\r\n\t\t\t\tdist := absInt64(dayTime.Unix() - eventDay.Unix())\r\n\t\t\t\tif dist > int64(maxStaleness) {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tif bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {\r\n\t\t\t\t\tbestDist = dist\r\n\t\t\t\t\t"]
[18116.031686, "o", "bestDate = d\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif bestDate != \"\" {\r\n\t\t\t\tr := rt.days[bestDate][currency]\r\n\t\t\t\tif isUsableRate(r) {\r\n\t\t\t\t\treturn r, calendarDayDiff(bestDate, date), \"\"\r\n\t\t\t\t}\r\n"]
[18116.03174, "o", "\t\t\t\treturn 0, 0, \"bad_rate\"\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn 0, 0, \"missing_rate\"\r\n}\r\n\r\nfunc loadRates(path string) (*RateTable, error) {\r\n\tdata, err := os.ReadFile(path)\r\n"]
[18116.031796, "o", "\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar top map[string]json.RawMessage\r\n\tif err := json.Unmarshal(data, &top); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"rates file is not valid json: %w\", err)\r\n\t}\r\n\trt := newRateTable()\r\n\tdaysRaw, ok := top[\"days\"]\r\n"]
[18116.031854, "o", "\tif !ok {\r\n\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\tvar days map[string]json.RawMessage\r\n\tif err := json.Unmarshal(daysRaw, &days); err != nil {\r\n\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\tif len(days) == 0 {\r\n\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\t"]
[18116.031917, "o", "for _, day := range sortedKeys(days) {\r\n\t\tif !isStrictDate(day) || !isDate(day) {\r\n\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: invalid day key %s\", day)\r\n\t\t}\r\n\t\tvar currencies map[string]json.RawMessage\r\n\t\tif err := json.Unmarshal(days[day], &currencies); err != nil {\r\n\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t\t}\r\n\t\tfor _, currency := range sortedKeys(currencies) {\r\n"]
[18116.031977, "o", "\t\t\tf, err := parseRateNumber(currencies[currency])\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: non-numeric rate for %s/%s\", day, currency)\r\n\t\t\t}\r\n\t\t\tif rt.days[day] == nil {\r\n\t\t\t\trt.days[day] = map[string]float64{}\r\n\t\t\t}\r\n\t\t\trt.days[day][currency] = f\r\n\t\t\trt.known[currency] = true\r\n"]
