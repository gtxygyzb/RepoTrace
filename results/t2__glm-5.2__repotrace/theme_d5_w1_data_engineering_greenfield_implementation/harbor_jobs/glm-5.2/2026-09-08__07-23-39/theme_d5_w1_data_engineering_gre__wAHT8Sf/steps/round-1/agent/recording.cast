[14532.667045, "o", "\t\t}\r\n   372\t\t\tcandidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})\r\n   373\t\t\tauditEntries = append(auditEntries, auditLogEntry{\r\n   374\t\t\t\tShard:  raw.Shard,\r\n   375\t\t\t\tLine:   raw.Line,\r\n   376\t\t\t\tID:     ctx.IDStr(),\r\n   377\t\t\t\tTS:     ctx.TSString(),\r\n   378\t\t\t\tType:   ctx.TypeString(),\r\n   379\t\t\t\tBucket: bucket,\r\n   380\t\t\t\tReason: reason,\r\n   381\t\t\t\tEvent:  raw.Raw,\r\n   382\t\t\t})\r\n   383\t\t}\r\n   384\t\r\n"]
[14532.667136, "o", "   385\t\t// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.\r\n   386\t\tgroups := map[string][]int{}\r\n   387\t\tfor i, c := range candidates {\r\n   388\t\t\tif c.ev != nil {\r\n   389\t\t\t\tgroups[c.ev.ID] = append(groups[c.ev.ID], i)\r\n   390\t\t\t}\r\n   391\t\t}\r\n   392\t\twinnerSet := map[int]bool{}\r\n   393\t\twinners := map[string]int{}\r\n   394\t\tvar dedupPolicyStats dedupPolicyStats\r\n"]
[14532.667237, "o", "   395\t\tdedupPolicyStats.Policy = cfg.dedupPolicy\r\n   396\t\tfor id, idxs := range groups {\r\n   397\t\t\tif len(idxs) < 2 {\r\n   398\t\t\t\tif len(idxs) == 1 {\r\n   399\t\t\t\t\twinners[id] = idxs[0]\r\n   400\t\t\t\t\twinnerSet[idxs[0]] = true\r\n   401\t\t\t\t}\r\n   402\t\t\t"]
[14532.667327, "o", "\tcontinue\r\n   403\t\t\t}\r\n   404\t\t\twinner := idxs[0]\r\n   405\t\t\ttiebreak := false\r\n   406\t\t\tfor _, idx := range idxs[1:] {\r\n   407\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n   408\t\t\t\t\tif arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n   409\t\t\t\t\t\twinner = idx\r\n   410\t\t\t\t\t}\r\n   411\t\t\t\t} else {\r\n"]
