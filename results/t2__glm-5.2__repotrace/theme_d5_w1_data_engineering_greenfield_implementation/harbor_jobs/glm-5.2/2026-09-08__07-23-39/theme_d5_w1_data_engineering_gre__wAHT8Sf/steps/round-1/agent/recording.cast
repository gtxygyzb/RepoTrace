[18489.967716, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/sha256\"\r\n     5\t\t\"encoding/hex\"\r\n"]
[18489.967802, "o", "     6\t\t\"encoding/json\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"math\"\r\n     9\t\t\"os\"\r\n    10\t\t\"path/filepath\"\r\n    11\t\t\"strings\"\r\n    12\t\t\"time\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc rawStringPtr(obj map[string]json.RawMessage, key string) *string {\r\n    16\t\tif obj == nil {\r\n    17\t\t\treturn nil\r\n    18\t\t}\r\n    19"]
[18489.967875, "o", "\t\traw, ok := obj[key]\r\n    20\t\tif !ok {\r\n    21\t\t\treturn nil\r\n    22\t\t}\r\n    23\t\tvar s string\r\n    24\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n    25\t\t\treturn nil\r\n    26\t\t}\r\n    27\t\treturn &s\r\n    28\t}\r\n"]
[18489.967946, "o", "    29\t\r\n    30\tfunc getRawString(obj map[string]json.RawMessage, key string) (string, bool, bool) {\r\n    31\t\tif obj == nil {\r\n    32\t\t\treturn \"\", false, false\r\n    33\t\t}\r\n    34\t\traw, present := obj[key]\r\n    35\t\tif !present {\r\n    36\t\t\treturn \"\", false, false\r\n    37\t\t}\r\n"]
[18489.968017, "o", "    38\t\tvar s string\r\n    39\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n    40\t\t\treturn \"\", false, true\r\n    41\t\t}\r\n    42\t\treturn s, true, true\r\n    43\t}\r\n    44\t\r\n    45\tfunc getJSONInt(raw json.RawMessage) (int, error) {\r\n    46\t\tvar n int\r\n    47\t\t"]
[18489.968089, "o", "if err := json.Unmarshal(raw, &n); err != nil {\r\n    48\t\t\treturn 0, err\r\n    49\t\t}\r\n    50\t\treturn n, nil\r\n    51\t}\r\n    52\t\r\n    53\tfunc parseTime(s string) (time.Time, error) {\r\n    54\t\ts = strings.TrimSpace(s)\r\n    55\t\tif strings.HasSuffix(s, \"Z\") {\r\n    56\t\t\tif t, err := time.Parse(\"2006-01-02T15:04:05Z\", s); err == nil {\r\n    57\t\t\t\treturn t.UTC(), nil\r\n"]
[18489.968158, "o", "    58\t\t\t}\r\n    59\t\t\tif t, err := time.Parse(\"2006-01-02T15:04:05.000000000Z\", s); err == nil {\r\n    60\t\t\t\treturn t.UTC(), nil\r\n    61\t\t\t}\r\n    62\t\t}\r\n    63\t\tif t, err := time.Parse(time.RFC3339Nano, s); err == nil {\r\n    64\t\t\treturn t.UTC(), nil\r\n    65\t\t}\r\n    66\t\tif t, err := time.Parse(time.RFC3339, s); err == nil {\r\n    67\t"]
[18489.968246, "o", "\t\treturn t.UTC(), nil\r\n    68\t\t}\r\n    69\t\treturn time.Time{}, fmt.Errorf(\"bad timestamp: %s\", s)\r\n    70\t}\r\n    71\t\r\n    72\tfunc formatTS(t time.Time) string {\r\n    73\t\treturn t.UTC().Format(\"2006-01-02T15:04:05Z\")\r\n    74\t}\r\n    75\t\r\n    76\tfunc epochSeconds(t time.Time) int64 {\r\n    77\t\treturn t.UTC().Unix()\r\n    78\t}\r\n    79\t\r\n"]
[18489.968323, "o", "    80\tfunc formatCutoffObject(cutoff time.Time) cutoffObject {\r\n    81\t\tepoch := epochSeconds(cutoff)\r\n    82\t\tif epoch < 0 {\r\n    83\t\t\tepoch = 0\r\n    84\t\t\tcutoff = time.Unix(0, 0).UTC()\r\n    85\t\t}\r\n    86\t\treturn cutoffObject{Value: formatTS(cutoff), EpochSeconds: int(epoch)}\r\n    87\t}\r\n    88\t\r\n    89\tfunc dateKey(t time.Time) string {\r\n    90\t\treturn t.UTC().Format(\"2006-01-02\")\r\n"]
