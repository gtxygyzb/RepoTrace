[3066.396391, "o", "go.mod go.mod return nil\r\ngo.mod }\r\ngo.mod f, err := strconv.ParseFloat(string(trimmed), 64)\r\ngo.mod if err != nil {\r\ngo.mod go.mod return err\r\ngo.mod }\r\ngo.mod *m = Money(f)\r\ngo.mod return nil\r\n}\r\n\r\nfunc (m Money) String() string {\r\ngo.mod f := float64(m)\r\ngo.mod abs := math.Abs(f)\r\ngo.mod cents := int64(math.Floor(abs*100.0 + 0.5))\r\ngo.mod neg := f < 0 && cents != 0\r\ngo.mod dollars := cents / 100\r\ngo.mod rem := cents % 100\r\ngo.mod s := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\ngo.mod if neg {\r\ngo.mod go.mod s = \"-\" + s\r\ngo.mod }\r\ngo.mod return s\r\n}\r\n\r\ntype Event struct {\r\ngo.mod ID       string\r\ngo.mod Type     string\r\ngo.mod TS       time.Time\r\ngo.mod UserID   string\r\n"]
[3066.396459, "o", "go.mod Amount   float64\r\ngo.mod Currency string\r\ngo.mod RefID    string\r\ngo.mod USD      float64\r\ngo.mod RefUSD   float64\r\ngo.mod Raw      json.RawMessage"]
[3066.396523, "o", "\r\ngo.mod Shard    string\r\ngo.mod Line     int\r\n}\r\n\r\ntype Reject struct {\r\ngo.mod Bucket int             `json:\"bucket\"`\r\ngo.mod Reason string          `json:\"reason\"`\r\ngo.mod Event  json.RawMessage `json:\"event,omitempty\"`\r\ngo.mod Line   string          `json:\"line,omitempty\"`\r\n}\r\n\r\ntype ShardLine struct {\r\ngo.mod Shard string\r\ngo.mod Line  int\r\ngo.mod Data  []byte\r\n}\r\n\r\ntype RateTable struct {\r\ngo.mod byDate map[string]map[string]float64\r\n"]
