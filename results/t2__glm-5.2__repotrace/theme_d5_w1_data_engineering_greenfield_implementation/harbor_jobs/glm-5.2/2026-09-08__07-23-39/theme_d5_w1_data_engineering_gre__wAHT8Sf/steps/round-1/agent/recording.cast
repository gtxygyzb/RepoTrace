[17098.083489, "o", "schema.go:13:const summarySchemaVersion = \"eventq.summary-schema/v1\"\r\nschema.go:183:type summaryField struct {\r\nschema.go:188:func parseSummaryFields(data []byte) ([]summaryField, error) {\r\nschema.go:197:\t\treturn nil, fmt.Errorf(\"summary output is not a JSON object\")\r\nschema.go:199:\tvar fields []summaryField\r\nschema.go:207:\t\t\treturn nil, fmt.Errorf(\"summary object key is not a string\")\r\nschema.go:213:\t\tfields = append(fields, summaryField{key: key, value: val})\r\nschema.go:403:func buildSchemaSidecar(summaryData []byte, cfg cliConfig, runIndex int) ([]byte, error) {\r\nschema.go:404:\tfields, err := parseSummaryFields(summaryData)\r\nschema.go:408:\tsummarySchema := make([]orderedJSON, 0, len(fields))\r\nschema.go:420:\t\tsummarySchema = append(summarySchema, orderedJSON{key: f.key, value: descriptorFor(f.value, 0, cfg.summarySchemaStrict)})\r\nschema.go:429:\t\t{key: \"schema_version\", value: summarySchemaVersion},\r\nschema.go:430:\t\t{key: \"summary_schema\", value: summarySchema},\r\nschema.go:433:\t"]
