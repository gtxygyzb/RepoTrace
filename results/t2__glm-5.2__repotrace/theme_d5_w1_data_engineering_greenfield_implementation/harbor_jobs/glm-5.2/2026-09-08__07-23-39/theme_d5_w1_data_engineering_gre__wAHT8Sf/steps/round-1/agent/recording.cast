[18251.967498, "o", "cfg.stateIn = nextArg(args, &i)\r\n\t\tcase \"--state-out\":\r\n\t\t\tcfg.stateOut = nextArg(args, &i)\r\n\t\tcase \"--pending-ttl\":\r\n\t\t\tcfg.pendingTTL = atoiOrError(nextArg(args, &i), \"--pending-ttl\")\r\n\t\tcase \"--max-open-sessions\":\r\n\t\t\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-sessions\")\r\n\t\tcase \"--audit-log\":\r\n\t\t\tcfg.auditLog = nextArg(args, &i)\r\n\t\tcase \"--audit-log-digest\":\r\n\t\t\tcfg.auditLogDigest = nextArg(args, &i)\r\n\t\tcase \"--audit-log-rotate-bytes\":\r\n\t\t\tcfg.auditLogRotateBytes = atoiOrError(nextArg(args, &i), \"--audit-log-rotate-bytes\")\r\n"]
[18251.967538, "o", "\t\tcase \"--rates-strict\":\r\n\t\t\tcfg.ratesStrict = true\r\n\t\tcase \"--rates-max-staleness\":\r\n\t\t\tcfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), \"--rates-max-staleness\")\r\n\t\tcase \"--ingest-id\":\r\n"]
[18251.96768, "o", "\t\t\tcfg.ingestID = nextArg(args, &i)\r\n\t\t\tcfg.ingestIDSet = true\r\n\t\tcase \"--out-parquet-manifest\":\r\n\t\t\tcfg.outManifest = nextArg(args, &i)\r\n\t\tcase \"--manifest-signature\":\r\n\t\t\tcfg.manifestSignature = nextArg(args, &i)\r\n\t\tcase \"--dedup-policy\":\r\n\t\t\tval := nextArg(args, &i)\r\n\t\t\tif val != \"first-arrival\" && val != \"lex-largest-ts\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --dedup-policy: must be one of {first-arrival, lex-largest-ts}\")\r\n\t\t\t}\r\n\t\t\tcfg.dedupPolicy = val\r\n\t\t\tcfg.dedupPolicySet = true\r\n\t\tcase \"--strict-late-audit\":\r\n\t\t\tcfg.strictLateAudit = true\r\n\t\tcase \"--state-strict\":\r\n\t\t\tcfg.stateStrict = true\r\n\t\tcase \"--summary-schema-out\":\r\n\t\t\tcfg.summarySchemaOut = nextArg(args, &i)\r\n\t\t\tif cfg.summarySchemaOut == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-out: value must be non-empty\")\r\n"]
[18251.967752, "o", "\t\t\t}\r\n\t\tcase \"--summary-schema-digest\":\r\n\t\t\tcfg.summarySchemaDigest = nextArg(args, &i)\r\n\t\t\tif cfg.summarySchemaDigest == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest: value must be non-empty\")\r\n\t\t\t}\r\n\t\tcase \"--summary-schema-strict\":\r\n\t\t\tcfg.summarySchemaStrict = true\r\n\t\tcase \"--summary-schema-index\":\r\n\t\t\tcfg.summarySchemaIndex = nextArg(args, &i)\r\n"]
[18251.967813, "o", "\t\t\tif cfg.summarySchemaIndex == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index: value must be non-empty\")\r\n\t\t\t}\r\n\t\tcase \"--rejects-format\":\r\n\t\t\tval := nextArg(args, &i)\r\n\t\t\tif val != \"legacy\" && val != \"tagged\" && val != \"tagged-sorted\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --rejects-format: must be one of {legacy, tagged, tagged-sorted}\")\r\n\t\t\t}\r\n\t\t\tcfg.rejectsFormat = val\r\n\t"]
[18251.967871, "o", "\tcase \"--session-policy\":\r\n\t\t\tval := nextArg(args, &i)\r\n\t\t\tif val != \"gap\" && val != \"fixed-window\" && val != \"hybrid\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --session-policy: must be one of {gap, fixed-window, hybrid}\")\r\n\t\t\t}\r\n\t\t\tcfg.sessionPolicy = val\r\n\t\tcase \"--fixed-window-seconds\":\r\n\t\t\tcfg.fixedWindowSeconds = atoiOrError(nextArg(args, &i), \"--fixed-window-seconds\")\r\n\t\t\tcfg.fixedWindowSet = true\r\n"]
[18251.967938, "o", "\t\tcase \"--rejects-format-header\":\r\n\t\t\tcfg.rejectsFormatHeader = true\r\n\t\tdefault:\r\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: unknown flag %s\", arg)\r\n\t\t}\r\n\t\tif strings.HasPrefix(arg, \"--\") && arg != \"--rates-strict\" && arg != \"--strict-late-audit\" && arg != \"--state-strict\" {\r\n\t\t\tif _, ok := required[arg]; ok {\r\n\t\t\t\trequired[arg] = true\r\n\t\t\t}\r\n\t\t}\r\n"]
[18251.968001, "o", "\t}\r\n\tfor k, ok := range required {\r\n\t\tif !ok {\r\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: %s is required\", k)\r\n\t\t}\r\n\t}\r\n\tif cfg.ingestIDSet {\r\n\t\tif len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {\r\n"]
[18251.968071, "o", "\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)\")\r\n\t\t}\r\n\t}\r\n\tif cfg.outManifest == \"\" && cfg.manifestSignature != \"\" {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --manifest-signature requires --out-parquet-manifest\")\r\n\t}\r\n"]
[18251.968128, "o", "\tif cfg.outManifest != \"\" && !parentDirExists(cfg.outManifest) {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest --out-parquet-manifest parent directory does not exist\")\r\n\t}\r\n\tif cfg.manifestSignature != \"\" && !parentDirExists(cfg.manifestSignature) {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest --manifest-signature parent directory does not exist\")\r\n\t}\r\n\tif cfg.strictLateAudit && cfg.auditLog == \"\" {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --strict-late-audit requires --audit-log\")\r\n\t}\r\n\tif cfg.auditLogRotateBytes != 0 {\r\n\t\tif cfg.auditLog == \"\" {\r\n"]
[18251.968204, "o", "\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --audit-log-rotate-bytes requires --audit-log\")\r\n\t\t}\r\n\t\tif cfg.auditLogRotateBytes < 4096 {\r\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --audit-log-rotate-bytes: must be a positive integer >= 4096\")\r\n\t\t}\r\n\t}\r\n\tif cfg.summarySchemaDigest != \"\" && cfg.summarySchemaOut == \"\" {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest requires --summary-schema-out\")\r\n"]
[18251.968264, "o", "\t}\r\n\tif cfg.summarySchemaStrict && cfg.summarySchemaOut == \"\" {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-strict requires --summary-schema-out\")\r\n\t}\r\n\tif cfg.summarySchemaIndex != \"\" && (cfg.summarySchemaOut == \"\" || cfg.summarySchemaDigest == \"\") {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index requires --summary-schema-out and --summary-schema-digest\")\r\n\t}\r\n\tif cfg.summarySchemaOut != \"\" && !parentDirExists(cfg.summarySchemaOut) {\r\n"]
[18251.968324, "o", "\t\treturn cliConfig{}, fmt.Errorf(\"ingest --summary-schema-out parent directory does not exist\")\r\n\t}\r\n\tif cfg.summarySchemaDigest != \"\" && !parentDirExists(cfg.summarySchemaDigest) {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest --summary-schema-digest parent directory does not exist\")\r\n\t}\r\n\tif cfg.summarySchemaIndex != \"\" && !parentDirExists(cfg.summarySchemaIndex) {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest --summary-schema-index parent directory does not exist\")\r\n\t}\r\n\tif cfg.dedupPolicy == \"\" {\r\n"]
[18251.968389, "o", "\t\tcfg.dedupPolicy = \"lex-largest-ts\"\r\n\t}\r\n\tif cfg.rejectsFormat == \"\" {\r\n\t\tcfg.rejectsFormat = \"legacy\"\r\n\t}\r\n\tif cfg.rejectsFormat == \"tagged\" && cfg.auditLog == \"\" {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --rejects-format tagged requires --audit-log\")\r\n\t}\r\n\tif cfg.rejectsFormat == \"tagged-sorted\" && cfg.auditLog == \"\" {\r\n"]
