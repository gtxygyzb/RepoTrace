[10973.58329, "o", "\tif err != nil {\r\n   474\t\t\t\treturn nil, fmt.Errorf(\"bad open session start_ts: %w\", err)\r\n   475\t\t\t}\r\n   476\t\t\tst.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}\r\n   477\t\t}\r\n   478\t\tst.carryInPending = len(st.pending)\r\n"]
