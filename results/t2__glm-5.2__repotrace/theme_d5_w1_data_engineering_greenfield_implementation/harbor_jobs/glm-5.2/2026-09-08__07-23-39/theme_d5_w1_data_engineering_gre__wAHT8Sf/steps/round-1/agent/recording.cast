[18233.462946, "o", "\t\t\t\t\tbestDist = dist\r\n\t\t\t\t\tbestDate = d\r\n\t\t\t\t}\r\n\t\t\t}\r\n"]
[18233.463062, "o", "\t\t\tif bestDate != \"\" {\r\n\t\t\t\tr := rt.days[bestDate][currency]\r\n\t\t\t\tif isUsableRate(r) {\r\n\t\t\t\t\treturn r, calendarDayDiff(bestDate, date), \"\"\r\n\t\t\t\t}\r\n\t\t\t\treturn 0, 0, \"bad_rate\"\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn 0, 0, \"missing_rate\"\r\n}\r\n\r\nfunc loadRates(path string) (*RateTable, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n"]
[18233.463153, "o", "\t}\r\n\tvar top map[string]json.RawMessage\r\n\tif err := json.Unmarshal(data, &top); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"rates file is not valid json: %w\", err)\r\n\t}\r\n\trt := newRateTable()\r\n\tdaysRaw, ok := top[\"days\"]\r\n\tif !ok {\r\n\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\tvar days map[string]json.RawMessage\r\n\tif err := json.Unmarshal(daysRaw, &days); err != nil {\r\n\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\t"]
[18233.463252, "o", "if len(days) == 0 {\r\n\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\tfor _, day := range sortedKeys(days) {\r\n\t\tif !isStrictDate(day) || !isDate(day) {\r\n\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: invalid day key %s\", day)\r\n\t\t}\r\n\t\tvar currencies map[string]json.RawMessage\r\n\t\tif err := json.Unmarshal(days[day], &currencies); err != nil {\r\n\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t\t}\r\n\t\tfor _, currency := range sortedKeys(currencies) {\r\n\t\t\tf, err := parseRateNumber(currencies[currency])\r\n"]
[18233.463327, "o", "\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: non-numeric rate for %s/%s\", day, currency)\r\n\t\t\t}\r\n\t\t\tif rt.days[day] == nil {\r\n\t\t\t\trt.days[day] = map[string]float64{}\r\n\t\t\t}\r\n\t\t\trt.days[day][currency] = f\r\n\t\t\trt.known[currency] = true\r\n\t\t}\r\n\t}\r\n"]
[18233.463404, "o", "\tbaseRaw, baseOk := top[\"base\"]\r\n\tif !baseOk {\r\n\t\treturn nil, errors.New(\"ingest: rates.json: base required\")\r\n\t}\r\n\tvar base string\r\n\tif err := json.Unmarshal(baseRaw, &base); err != nil || base == \"\" {\r\n\t\treturn nil, errors.New(\"ingest: rates.json: base required\")\r\n\t}\r\n\trt.base = base\r\n\tif base != \"USD\" {\r\n\t\treturn nil, errors.New(\"fx base must be USD\")\r\n\t}\r\n\tfor _, day := range sortedKeys(rt.days) {\r\n\t\t"]
[18233.463475, "o", "r, ok := rt.days[day][base]\r\n\t\tif !ok || r != 1.0 {\r\n\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: base currency %s must have rate 1.0 on day %s\", base, day)\r\n\t\t}\r\n\t}\r\n\treturn rt, nil\r\n}\r\n"]
[18233.46354, "o", "\r\nfunc readInputEvents(inputDir string) ([]rawEvent, []rawEvent, []inputShardInfo, error) {\r\n\tinfo, err := os.Stat(inputDir)\r\n\tif err != nil {\r\n\t\treturn nil, nil, nil, err\r\n\t}\r\n\tif !info.IsDir() {\r\n\t\treturn nil, nil, nil, errors.New(\"input-dir is not a directory\")\r\n\t}\r\n\tentries, err := os.ReadDir(inputDir)\r\n\tif err != nil {\r\n\t\treturn nil, nil, nil, err\r\n\t}\r\n\tvar files []string\r\n\t"]
[18233.463599, "o", "for _, e := range entries {\r\n\t\tif e.IsDir() || !e.Type().IsRegular() {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfiles = append(files, e.Name())\r\n\t}\r\n\tsort.Strings(files)\r\n\tvar events []rawEvent\r\n\tvar blanks []rawEvent\r\n\tvar shards []inputShardInfo\r\n"]
[18233.46366, "o", "\tfor _, name := range files {\r\n\t\tdata, err := os.ReadFile(filepath.Join(inputDir, name))\r\n\t\tif err != nil {\r\n\t\t\treturn nil, nil, nil, err\r\n\t\t}\r\n\t\tsi := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}\r\n\t\tlineNo := 0\r\n\t\tfor _, line := range bytes.Split(data, []byte{'\\n'}) {\r\n"]
[18233.463717, "o", "\t\t\tlineNo++\r\n\t\t\ttrimmed := bytes.TrimSpace(line)\r\n\t\t\tif len(trimmed) == 0 {\r\n\t\t\t\tblanks = append(blanks, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Blank: true})\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tsi.EventsTotal++\r\n\t\t\tvar obj map[string]json.RawMessage\r\n"]
[18233.463775, "o", "\t\t\tinvalid := false\r\n\t\t\tif err := json.Unmarshal(trimmed, &obj); err != nil {\r\n\t\t\t\tinvalid = true\r\n\t\t\t}\r\n\t\t\tevents = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})\r\n\t\t}\r\n\t\tshards = append(shards, si)\r\n\t}\r\n\treturn events, blanks, shards, nil\r\n}\r\n\r\n"]
[18233.463832, "o", "func newContext(raw rawEvent) *eventContext {\r\n\tctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n\tif raw.Obj != nil {\r\n\t\tctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n\t\tctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n\t\tctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n\t}\r\n\treturn ctx\r\n}\r\n\r\n"]
[18233.463887, "o", "func parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {\r\n\tobj := ctx.Obj\r\n\tif obj == nil {\r\n\t\treturn nil, \"invalid_json\"\r\n\t}\r\n\traw, ok := obj[\"v\"]\r\n\tif !ok {\r\n\t\treturn nil, \"schema_version\"\r\n"]
[18233.463946, "o", "\t}\r\n\tvar v int\r\n\tif err := json.Unmarshal(raw, &v); err != nil {\r\n\t\treturn nil, \"schema_version\"\r\n\t}\r\n\tif v != 1 && v != 2 {\r\n\t\treturn nil, \"schema_version\"\r\n\t}\r\n\tid, idOk, _ := getRawString(obj, \"id\")\r\n\tif !idOk || id == \"\" {\r\n\t\treturn nil, \"missing_id\"\r\n\t}\r\n"]
[18233.464001, "o", "\ttsStr, tsOk, _ := getRawString(obj, \"ts\")\r\n\tif !tsOk {\r\n\t\treturn nil, \"missing_ts\"\r\n\t}\r\n\tt, err := parseTime(tsStr)\r\n\tif err != nil {\r\n\t\treturn nil, \"bad_ts\"\r\n\t}\r\n"]
[18233.464059, "o", "\ttypeStr, typeOk, _ := getRawString(obj, \"type\")\r\n\tif !typeOk {\r\n\t\treturn nil, \"missing_type\"\r\n\t}\r\n\tswitch typeStr {\r\n\tcase \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\n\tdefault:\r\n\t\treturn nil, \"bad_type\"\r\n\t}\r\n\tuser, userOk, _ := getRawString(obj, \"user_id\")\r\n\tif !userOk || user == \"\" {\r\n\t\treturn nil, \"missing_user\"\r\n"]
[18233.464115, "o", "\t}\r\n\tev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n\tswitch typeStr {\r\n"]
