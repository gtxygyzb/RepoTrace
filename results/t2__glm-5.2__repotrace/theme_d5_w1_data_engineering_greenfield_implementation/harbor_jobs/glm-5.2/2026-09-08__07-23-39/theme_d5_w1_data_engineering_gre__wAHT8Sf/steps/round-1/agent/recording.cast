[18155.063104, "o", "var usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--state-strict] [--audit-log <path>] [--audit-log-digest <path>] [--audit-log-rotate-bytes <int>] [--rates-strict] [--rates-max-staleness <seconds>] [--ingest-id <string>] [--out-parquet-manifest <path>] [--manifest-signature <path>] [--dedup-policy <first-arrival|lex-largest-ts>] [--strict-late-audit] [--summary-schema-out <path>] [--summary-schema-digest <path>] [--summary-schema-strict] [--summary-schema-index <path>] [--rejects-format <legacy|tagged|tagged-sorted>] [--rejects-format-header] [--session-policy <gap|fixed-window|hybrid>] [--fixed-window-seconds <int>]\\n\"\r\n    16\t\r\n    17\ttype Money float64\r\n    18\t\r\n    19\tfunc (m Money) MarshalJSON() ([]byte, error) {\r\n    20\t\treturn []byte(m.String()), nil\r\n    21\t}\r\n    22\t\r\n    23\tfunc (m Money) String() st"]
