[17146.056058, "o", "   318\tfunc parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {\r\n   319\t\tobj := ctx.Obj\r\n   320\t\tif obj == nil {\r\n   321\t\t\treturn nil, \"invalid_json\"\r\n   322\t\t}\r\n"]
[17146.056159, "o", "   323\t\traw, ok := obj[\"v\"]\r\n   324\t\tif !ok {\r\n   325\t\t\treturn nil, \"schema_version\"\r\n   326\t\t}\r\n   327\t\tvar v int\r\n   328\t\tif err := json.Unmarshal(raw, &v); err != nil {\r\n   329\t\t\treturn nil, \"schema_version\"\r\n   330\t\t}\r\n   331\t\tif v != 1 && v != 2 {\r\n   332\t\t\treturn nil, \"schema_version\"\r\n   333\t\t}\r\n   334\t\tid, idOk, _ := getRawString(obj, \"id\")\r\n   335"]
[17146.056269, "o", "\t\tif !idOk || id == \"\" {\r\n   336\t\t\treturn nil, \"missing_id\"\r\n   337\t\t}\r\n   338\t\ttsStr, tsOk, _ := getRawString(obj, \"ts\")\r\n   339\t\tif !tsOk {\r\n   340\t\t\treturn nil, \"missing_ts\"\r\n"]
[17146.056349, "o", "   341\t\t}\r\n   342\t\tt, err := parseTime(tsStr)\r\n   343\t\tif err != nil {\r\n   344\t\t\treturn nil, \"bad_ts\"\r\n   345\t\t}\r\n   346\t\ttypeStr, typeOk, _ := getRawString(obj, \"type\")\r\n   347\t\tif !typeOk {\r\n   348\t\t\treturn nil, \"missing_type\"\r\n   349\t\t}\r\n"]
[17146.056432, "o", "   350\t\tswitch typeStr {\r\n   351\t\tcase \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\n   352\t\tdefault:\r\n   353\t\t\treturn nil, \"bad_type\"\r\n   354\t\t}\r\n   355\t\tuser, userOk, _ := getRawString(obj, \"user_id\")\r\n   356\t\tif !userOk || user == \"\" {\r\n   357\t\t\treturn nil, \"missing_user\"\r\n   358\t\t}\r\n   359\t\tev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n   360\t\tswitch typeStr {\r\n   361\t\tcase \"purchase\", \"refund\":"]
[17146.056495, "o", "\r\n   362\t\t\tvar amount float64\r\n   363\t\t\tif v == 1 {\r\n   364\t\t\t\traw, present := obj[\"amount\"]\r\n   365\t\t\t\tif !present {\r\n   366\t\t\t\t\treturn nil, \"missing_amount\"\r\n   367\t\t\t\t}\r\n   368\t\t\t\tvar f float64\r\n   369\t\t\t"]
[17146.056553, "o", "\tif err := json.Unmarshal(raw, &f); err != nil {\r\n   370\t\t\t\t\treturn nil, \"bad_amount\"\r\n   371\t\t\t\t}\r\n   372\t\t\t\tif !isFinite(f) || f < 0 {\r\n   373\t\t\t\t\treturn nil, \"bad_amount\"\r\n   374\t\t\t\t}\r\n   375\t\t\t\tamount = f\r\n"]
[17146.056615, "o", "   376\t\t\t} else {\r\n   377\t\t\t\traw, present := obj[\"amount_cents\"]\r\n   378\t\t\t\tif !present {\r\n   379\t\t\t\t\treturn nil, \"missing_amount\"\r\n   380\t\t\t\t}\r\n   381\t\t\t\tn, err := getJSONInt(raw)\r\n   382\t\t\t\tif err != nil || n < 0 {\r\n"]
[17146.056672, "o", "   383\t\t\t\t\treturn nil, \"bad_amount\"\r\n   384\t\t\t\t}\r\n   385\t\t\t\tamount = float64(n) / 100.0\r\n   386\t\t\t}\r\n   387\t\t\tcur, curOk, curPresent := getRawString(obj, \"currency\")\r\n   388\t\t\tif !curPresent {\r\n   389\t\t\t\treturn nil, \"missing_currency\"\r\n"]
[17146.056736, "o", "   390\t\t\t}\r\n   391\t\t\tif !curOk || cur == \"\" {\r\n   392\t\t\t\treturn nil, \"bad_currency\"\r\n   393\t\t\t}\r\n   394\t\t\trate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)\r\n   395\t\t\tswitch status {\r\n   396\t\t\tcase \"fx_unknown_currency\":\r\n   397\t\t\t\treturn nil, \"fx_unknown_currency\"\r\n   398\t\t\tcase \"missing_rate\":\r\n   399\t\t\t\t"]
[17146.056769, "o", "return nil, \"fx_no_rate_for_date\"\r\n   400\t\t\tcase \"bad_rate\":\r\n   401\t\t\t\tif ratesStrict {\r\n   402\t\t\t\t\treturn nil, \"fx_bad_rate\"\r\n"]
[17146.056853, "o", "   403\t\t\t\t}\r\n   404\t\t\t\treturn nil, \"fx_no_rate_for_date\"\r\n   405\t\t\t}\r\n   406\t\t\tusd := amount * rate\r\n   407\t\t\tif typeStr == \"refund\" {\r\n   408\t\t\t\tusd = -usd\r\n   409\t\t\t}\r\n   410\t\t\tev.Amount = amount\r\n   411\t\t\tev.Currency = cur\r\n   412\t\t\tev.FXFallbackDays = fallbackDays\r\n   413\t\t\tev.USD = roundMoney(usd)\r\n   414\t\tcase \"chargeback\":\r\n   415"]
[17146.056905, "o", "\t\t\tref, refOk, refPresent := getRawString(obj, \"ref_id\")\r\n   416\t\t\tif !refPresent || !refOk || ref == \"\" {\r\n   417\t\t\t\treturn nil, \"missing_ref_id\"\r\n   418\t\t\t}\r\n   419\t\t\tev.RefID = ref\r\n   420\t\t\tev.USD = 0\r\n"]
[17146.056953, "o", "   421\t\tcase \"login\", \"signup\":\r\n   422\t\t\tev.USD = 0\r\n   423\t\t}\r\n   424\t\treturn ev, \"\"\r\n   425\t}\r\n"]
