[7039.488569, "o", "\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K sortedKeys[T any](m map[string]T) []string {\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K isStrictDate(s string) bool {\r\n\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K dayEpoch(date string) time.Time {\r\n\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K calendarDayDiff(rateDate, eventDate string) int {\r\n\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K absInt(v int) int {\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K absInt64(v int64) int64 {\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {\r\n"]
[7039.488697, "o", "\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K loadRates(path string) (*RateTable, error) {\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K readInputEvents(inputDir string) ([]rawEvent, error) {\r\n\u001b[32m\u001b[K305\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K newContext(raw rawEvent) *eventContext {\r\n"]
[7039.488764, "o", "\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktype\u001b[m\u001b[K stateFileIn struct {\r\n\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K loadState(path string) (*loadedState, error) {\r\n\u001b[32m\u001b[K477\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {\r\n\u001b[32m\u001b[K491\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K statePendingOutList(pending []pendingEntry) []statePendingOut {\r\n\u001b[32m\u001b[K499\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {\r\n\u001b[32m\u001b[K507\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K sortedSeenIDs(seen map[string]bool) []string {\r\n\u001b[32m\u001b[K516\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K sortedPending(pending []pendingEntry) []pendingEntry {\r\n\u001b[32m\u001b"]
[7039.488961, "o", "[K527\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K sortedOpenSessions(m map[string]carriedSession) []carriedSession {\r\n\u001b[32m\u001b[K541\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc\u001b[m\u001b[K sortedCarriedSessions(m map[string]carriedSession) []carriedSession {\r\n"]
