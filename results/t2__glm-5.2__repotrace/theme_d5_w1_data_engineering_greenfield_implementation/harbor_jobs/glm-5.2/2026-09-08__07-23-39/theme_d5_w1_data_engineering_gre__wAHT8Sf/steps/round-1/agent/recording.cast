[12916.59991, "o", "stData, maxPtr); err != nil {\r\n\t\t\t\treturn err\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc writeAuditLog(path string, entries []auditLogEntry, rotateBytes int) []string {\r\n\tvar segments []string\r\n\tif rotateBytes <= 0 {\r\n\t\tvar buf bytes.Buffer\r\n\t\tfor _, e := range entries {\r\n\t\t\tb, err := json.Marshal(e)\r\n\t\t\tif err != nil {\r\n\t\t\t\tpanic(err)\r\n\t\t\t}\r\n\t\t\tbuf.Write(b)\r\n\t\t\tbuf.WriteByte('\\n')\r\n\t\t}\r\n\t\tif err := atomicWriteFile(path, buf.Bytes()); err != nil {\r\n\t\t\tpanic(err)\r\n\t\t}\r\n\t\treturn []string{path}\r\n\t}\r\n\r\n\tcurrent := path\r\n\tvar buf bytes.Buffer\r\n\tflush := func() {\r\n\t\tif err := atomicWriteFile(current, buf.Bytes()); err != nil {\r\n\t\t\tpanic(err)\r\n\t\t}\r\n\t\tsegments = append(segments, current)\r\n\t\tbuf.Reset()\r\n\t}\r\n\tfor _, e := range entries {\r\n\t\tb, err := json.Marshal(e)\r\n\t\tif err != nil {\r\n\t\t\tpanic(err)\r\n\t\t}\r\n\t\trec := append(b, '\\n')\r\n\t\tif buf.Len() > 0 && buf.Len()+len(rec) > rotateBytes {\r\n\t\t\tflush()\r\n\t\t\tcurrent = fmt.Sprintf(\"%s.%d\", path, len(segments))\r\n\t\t}\r\n\t\tbuf.Write(rec)\r\n\t}\r\n\tif buf.Len() > 0 || len(segments) == 0 {\r"]
[12916.599977, "o", "\n\t\tflush()\r\n\t}\r\n\treturn segments\r\n}\r\n\r\nfunc computeLateCutoffStats(entries []auditLogEntry) lateCutoffStats {\r\n\tstats := lateCutoffStats{}\r\n\tfor _, e := range entries {\r\n\t\tif e.Bucket == \"late\" && e.Cutoff != nil {\r\n\t\t\tif stats.Count == 0 {\r\n\t\t\t\tstats.MinCutoffEpoch = e.Cutoff.EpochSeconds\r\n\t\t\t\tstats.MaxCutoffEpoch = e.Cutoff.EpochSeconds\r\n\t\t\t} else {\r\n\t\t\t\tif e.Cutoff.EpochSeconds < stats.MinCutoffEpoch {\r\n\t\t\t\t\tstats.MinCutoffEpoch = e.Cutoff.EpochSeconds\r\n\t\t\t\t}\r\n\t\t\t\tif e.Cutoff.EpochSeconds > stats.MaxCutoffEpoch {\r\n\t\t\t\t\tstats.MaxCutoffEpoch = e.Cutoff.EpochSeconds\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tstats.Count++\r\n\t\t}\r\n\t}\r\n\treturn stats\r\n}\r\n\r\nfunc mustJSONString(s string) json.RawMessage {\r\n\tb, err := json.Marshal(s)\r\n\tif err != nil {\r\n\t\tpanic(err)\r\n\t}\r\n\treturn b\r\n}\r\n\r\nfunc mustJSONStringArray(ss []string) json.RawMessage {\r\n\tb, err := json.Marshal(ss)\r\n\tif err != nil {\r\n\t\tpanic(err)\r\n\t}\r\n\treturn b\r\n}\r\n\r\ntype rejectRecord struct {\r\n\tbucket      string\r\n\treason      string\r\n\traw         rawJSON\r\n"]
[12916.600048, "o", "\twinner      bool\r\n\twinnerShard string\r\n\twinnerLine  int\r\n}\r\n\r\nfunc arrivalLess(a, b *Event) bool {\r\n\tif a.Shard != b.Shard {\r\n\t\treturn a.Shard < b.Shard\r\n\t}\r\n\treturn a.Line < b.Line\r\n}\r\n\r\nfunc buildRejects(records []rejectRecord, policy string) []byte {\r\n\torder := []string{\"invalid\", \"late\", \"duplicate\", \"unresolved_chargeback\"}\r\n\tvar buf bytes.Buffer\r\n\tfor _, bucket := range order {\r\n\t\tfor _, r := range records {\r\n\t\t\tif r.bucket != bucket {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tbuf.Write(r.raw)\r\n\t\t\tif policy == \"first-arrival\" {\r\n\t\t\t\tbuf.WriteByte('\\t')\r\n\t\t\t\tif r.winner {\r\n\t\t\t\t\tbuf.WriteString(r.winnerShard)\r\n\t\t\t\t\tbuf.WriteByte('\\t')\r\n\t\t\t\t"]
[12916.600112, "o", "\tbuf.WriteString(strconv.Itoa(r.winnerLine))\r\n\t\t\t\t} else {\r\n\t\t\t\t\tbuf.WriteString(\"-\")\r\n\t\t\t\t\tbuf.WriteByte('\\t')\r\n\t\t\t\t\tbuf.WriteString(\"-\")\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tbuf.WriteByte('\\n')\r\n\t\t}\r\n\t}\r\n\treturn buf.Bytes()\r\n}\r\n\r\n"]
