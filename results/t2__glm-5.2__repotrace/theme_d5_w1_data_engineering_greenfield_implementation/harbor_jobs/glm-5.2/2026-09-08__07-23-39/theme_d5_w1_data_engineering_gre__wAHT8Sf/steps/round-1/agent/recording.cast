[18131.191875, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--state-strict] [--audit-log <path>] [--audit-log-digest <path>] [--audit-log-rotate-bytes <int>] [--rates-strict] [--rates-max-staleness <seconds>] [--\u001b[01;31m\u001b[Kingest-id\u001b[m\u001b[K <string>] [--\u001b[01;31m\u001b[Kout-parquet-manifest\u001b[m\u001b[K <path>] [--manifest-signature <path>] [--dedup-policy <first-arrival|lex-largest-ts>] [--strict-late-audit] [--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out <path>] [--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest <path>] [--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-strict] [--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-index <path>] [--\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K <legacy|tagged|tagged-sorted>] [--\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K-header] [--\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K <gap|fixed-window|hybrid>] [--fixe"]
[18131.191936, "o", "d-window-seconds <int>]\\n\"\r\n"]
