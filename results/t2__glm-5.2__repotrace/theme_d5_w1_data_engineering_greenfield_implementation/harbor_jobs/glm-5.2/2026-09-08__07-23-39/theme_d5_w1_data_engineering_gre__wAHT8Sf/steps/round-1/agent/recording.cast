[7349.940315, "o", "   303\t}\r\n   304\t\r\n   305\tfunc newContext(raw rawEvent) *eventContext {\r\n   306\t\tctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n   307\t\tctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n   308\t\tctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n   309\t\tctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n   310\t\treturn ctx\r\n"]
[7349.940346, "o", "   311\t}\r\n   312\t\r\n"]
