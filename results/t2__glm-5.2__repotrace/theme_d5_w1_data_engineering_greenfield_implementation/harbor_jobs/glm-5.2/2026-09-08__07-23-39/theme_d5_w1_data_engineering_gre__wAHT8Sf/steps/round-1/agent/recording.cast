[19908.319498, "o", "package main\r\n\r\nimport (\r\n"]
[19908.319576, "o", "\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t\"time\"\r\n)\r\n\r\ntype rawJSON json.RawMessage\r\n\r\nfunc (r rawJSON) MarshalJSON() ([]byte, error) {\r\n\tif json.Valid(r) {\r\n\t\treturn r, nil\r\n\t}\r\n\treturn json.Marshal(string(r))\r\n}\r\n"]
[19908.319643, "o", "\r\ntype rawEvent struct {\r\n\tShard   string\r\n\tLine    int\r\n\tRaw     rawJSON\r\n\tObj     map[string]json.RawMessage\r\n\tInvalid bool\r\n\tBlank   bool\r\n}\r\n"]
[19908.3197, "o", "\r\ntype eventContext struct {\r\n\tShard string\r\n\tLine  int\r\n\tRaw   rawJSON\r\n\tObj   map[string]json.RawMessage\r\n"]
[19908.319765, "o", "\tID    *string\r\n\tTS    *string\r\n\tType  *string\r\n}\r\n\r\ntype inputShardInfo struct {\r\n"]
[19908.319828, "o", "\tName           string\r\n\tBytes          int64\r\n\tSHA256         string\r\n\tEventsTotal    int\r\n\tEventsAccepted int\r\n}\r\n\r\ntype loadedState struct {\r\n"]
[19908.319889, "o", "\tversion             int\r\n\thasMax              bool\r\n\tmaxTs               time.Time\r\n\tseenIds             map[string]bool\r\n\tpending             []pendingEntry\r\n\topenSessions        map[string]carriedSession\r\n\trunIndex            int\r\n\tcarryInPending      int\r\n\tcarryInOpenSessions int\r\n}\r\n\r\ntype pendingEntry struct {\r\n"]
[19908.319957, "o", "\tid             string\r\n\tts             time.Time\r\n\tfirstSeenEpoch int\r\n\tuser           string\r\n"]
[19908.320016, "o", "\tusd            float64\r\n\toriginRun      int\r\n}\r\n\r\ntype carriedSession struct {\r\n\tuser         string\r\n\tlastTs       time.Time\r\n\tsessionIndex int\r\n\tstartTs      time.Time\r\n}\r\n\r\ntype stateWatermarkOut struct {\r\n\tMaxTS *string `json:\"max_ts\"`\r\n"]
[19908.320074, "o", "}\r\n\r\ntype stateFileOut struct {\r\n\tVersion          int                   `json:\"version\"`\r\n\tWatermark        stateWatermarkOut     `json:\"watermark\"`\r\n\tSeenIDs          []string              `json:\"seen_ids\"`\r\n\tPendingPurchases []statePendingOut     `json:\"pending_purchases\"`\r\n\tOpenSessions     []stateOpenSessionOut `json:\"open_sessions\"`\r\n\tRunIndex         int                   `json:\"run_index\"`\r\n}\r\n\r\n"]
[19908.320154, "o", "type statePendingOut struct {\r\n\tID                string `json:\"id\"`\r\n\tTS                string `json:\"ts\"`\r\n\tFirstSeenEpoch    int    `json:\"first_seen_epoch\"`\r\n\tfirstSeenEpochSet bool\r\n\tUser              string `json:\"user\"`\r\n\tUSD               Money  `json:\"usd\"`\r\n\tOriginRun         int    `json:\"origin_run\"`\r\n}\r\n\r\ntype stateOpenSessionOut struct {\r\n\tUser         string `json:\"user\"`\r\n\t"]
[19908.320235, "o", "LastTS       string `json:\"last_ts\"`\r\n\tSessionIndex int    `json:\"session_index\"`\r\n\tStartTS      string `json:\"start_ts\"`\r\n}\r\n\r\ntype summarySessions struct {\r\n\tTotal  int                  `json:\"total\"`\r\n\tByUser []summarySessionUser `json:\"by_user\"`\r\n}\r\n\r\ntype summarySessionUser struct {\r\n\tUser  string `json:\"user\"`\r\n\tCount int    `json:\"count\"`\r\n}\r\n\r\n"]
[19908.3203, "o", "type summaryOutput struct {\r\n\tTotalEvents    int            `json:\"total_events\"`\r\n\tAcceptedEvents int            `json:\"accepted_events\"`\r\n\tRejectedEvents int            `json:\"rejected_events\"`\r\n\tTotalUSD       Money          `json:\"total_usd\"`\r\n\tAnomalies      map[string]int `json:\"anomalies\"`\r\n\tRunIndex       int            `json:\"run_index\"`\r\n\tWatermark      *string        `json:\"watermark\"`\r\n\tSessions       summarySessions `json:\"sessions\"`\r\n}\r\n\r\n"]
[19908.320366, "o", "type auditLogEntry struct {\r\n\tShard               string         `json:\"shard\"`\r\n\tLine                int            `json:\"line\"`\r\n\tID                  string         `json:\"id\"`\r\n\tTS                  string         `json:\"ts\"`\r\n\tType                string         `json:\"type\"`\r\n\tBucket              string         `json:\"bucket\"`\r\n\tReason              string         `json:\"reason\"`\r\n\tWinnerArrival       *winnerArrival `json:\"winner_arrival,omitempty\"`\r\n\tEvent               rawJSON        `json:\"event\"`\r\n\tCutoff              *cutoffObject  `json:\"cutoff,omitempty\"`\r\n\tWatermarkLagSeconds *int           `json:\"watermark_lag_seconds,omitempty\"`\r\n\t"]
[19908.320435, "o", "LateBySeconds       *int           `json:\"late_by_seconds,omitempty\"`\r\n}\r\n\r\ntype cutoffObject struct {\r\n\tValue        string `json:\"value\"`\r\n\tEpochSeconds int    `json:\"epoch_seconds\"`\r\n}\r\n\r\nfunc (e auditLogEntry) MarshalJSON() ([]byte, error) {\r\n\tif e.Bucket == \"late\" {\r\n\t\tvar buf bytes.Buffer\r\n\t\tbuf.WriteString(`{\"id\":`)\r\n\t\tb, err := json.Marshal(e.ID)\r\n"]
[19908.320504, "o", "\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"ts\":`)\r\n\t\tb, err = json.Marshal(e.TS)\r\n"]
[19908.320565, "o", "\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"type\":`)\r\n\t\tb, err = json.Marshal(e.Type)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"shard\":`)\r\n\t\tb, err = json.Marshal(e.Shard)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n"]
[19908.320626, "o", "\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"line\":`)\r\n\t\tb, err = json.Marshal(e.Line)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"bucket\":`)\r\n\t\tb, err = json.Marshal(e.Bucket)\r\n"]
[19908.320683, "o", "\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"cutoff\":`)\r\n\t\tif e.Cutoff != nil {\r\n\t\t\tb, err = json.Marshal(e.Cutoff)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n"]
[19908.320742, "o", "\t\t\t}\r\n\t\t} else {\r\n\t\t\tb = []byte(\"null\")\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tif e.WatermarkLagSeconds != nil {\r\n\t\t\tbuf.WriteString(`,\"watermark_lag_seconds\":`)\r\n"]
[19908.320798, "o", "\t\t\tb, err = json.Marshal(*e.WatermarkLagSeconds)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tbuf.Write(b)\r\n\t\t}\r\n\t\tif e.LateBySeconds != nil {\r\n\t\t\tbuf.WriteString(`,\"late_by_seconds\":`)\r\n\t\t\tb, err = json.Marshal(*e.LateBySeconds)\r\n"]
[19908.320853, "o", "\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tbuf.Write(b)\r\n\t\t}\r\n\t\tbuf.WriteByte('}')\r\n\t\treturn buf.Bytes(), nil\r\n\t}\r\n"]
[19908.320931, "o", "\ttype alias auditLogEntry\r\n\treturn json.Marshal(alias(e))\r\n}\r\n\r\ntype winnerArrival struct {\r\n\tShard string `json:\"shard\"`\r\n\tLine  int    `json:\"line\"`\r\n}\r\n\r\ntype rejectsCrossCheck struct {\r\n\tRejectsRowCount        int  `json:\"rejects_row_count\"`\r\n\tAuditRejectRecordCount int  `json:\"audit_reject_record_count\"`\r\n\tAgree                  bool `json:\"agree\"`\r\n}\r\n\r\ntype dedupPolicyStats struct {\r\n\tPolicy                       string `json:\"policy\"`\r\n"]
[19908.320994, "o", "\tDuplicateWinnersSameShard    int    `json:\"duplicate_winners_same_shard\"`\r\n\tDuplicateWinnersCrossShard   int    `json:\"duplicate_winners_cross_shard\"`\r\n\tDuplicateWinnersLineTiebreak int    `json:\"duplicate_winners_line_tiebreak\"`\r\n}\r\n\r\ntype auditDigestOutput struct {\r\n"]
[19908.321057, "o", "\tSchemaVersion     string             `json:\"schema_version\"`\r\n\tAuditLog          json.RawMessage    `json:\"audit_log\"`\r\n\tTotalRecords      int                `json:\"total_records\"`\r\n\tBucketCounts      map[string]int     `json:\"bucket_counts\"`\r\n\tInvalidReasons    map[string]int     `json:\"invalid_reasons\"`\r\n\tDuplicateReasons  map[string]int     `json:\"duplicate_reasons\"`\r\n\tLateCutoffStats   lateCutoffStats    `json:\"late_cutoff_stats\"`\r\n\tResolvedAgainst   string             `json:\"resolved_against\"`\r\n\tDedupPolicyStats  *dedupPolicyStats  `json:\"dedup_policy_stats,omitempty\"`\r\n\tFXFallbackStats   map[string]int     `json:\"fx_fallback_stats\"`\r\n\tRatesDigest       string             `json:\"rates_digest\"`\r\n\tRejectsCrossCheck *rejectsCrossCheck `json:\"rejects_cross_check,omitempty\"`\r\n\tSHA256            string             `json:\"sha256,omitempty\"`\r\n\tSHA256Segments    []string           `json:\"sha256_segments,omitempty\"`\r\n}\r\n\r\ntype lateCutoffStats struct {"]
[19908.321124, "o", "\r\n\tCount          int `json:\"count\"`\r\n\tMinCutoffEpoch int `json:\"min_cutoff_epoch\"`\r\n\tMaxCutoffEpoch int `json:\"max_cutoff_epoch\"`\r\n}\r\n\r\ntype manifestOutput struct {\r\n\t"]
[19908.321184, "o", "SchemaVersion string          `json:\"schema_version\"`\r\n\tIngestID      *string         `json:\"ingest_id\"`\r\n\tRunIndex      int             `json:\"run_index\"`\r\n"]
