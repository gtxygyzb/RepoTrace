[19002.396554, "o", "\t\t})\r\n\t}\r\n}\r\n\r\nfunc writeShardingDigest(cfg cliConfig, reportData []byte, reportBase string, shardCount int, sortKey string, reportShards []shardingReportShard) error {\r\n\th, b, err := fileDigest(cfg.shardingReport)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdigest := shardingReportDigest{\r\n\t\tSchemaVersion: shardingReportDigestSchemaVersion,\r\n\t\tReportPath:    reportBase,\r\n\t\tReportSHA256:  h,\r\n\t\tReportBytes:   b,\r\n\t\tShardCount:    shardCount,\r\n"]
[19002.396641, "o", "\t\tToolVersion:   toolVersion,\r\n\t}\r\n\tif cfg.shardingReportStrict {\r\n\t\tinvariant := shardsSortedInvariant(reportShards, sortKey)\r\n\t\tdigest.SortKey = sortKey\r\n\t\tdigest.ShardsSortedInvariant = &invariant\r\n\t}\r\n\tdata, err := json.MarshalIndent(digest, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdata = append(data, '\\n')\r\n\treturn atomicWriteFile(cfg.shardingReportDigest, data)\r\n}\r\n\r\n"]
[19002.396721, "o", "func shardsSortedInvariant(shards []shardingReportShard, sortKey string) bool {\r\n\tclone := append([]shardingReportShard(nil), shards...)\r\n\tsortShardingReportShards(clone, sortKey)\r\n\tif len(clone) != len(shards) {\r\n\t\treturn false\r\n\t}\r\n\tfor i := range clone {\r\n\t\tif clone[i] != shards[i] {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n"]
[19002.396806, "o", "\treturn true\r\n}\r\n\r\nfunc writeShardingIndex(path, reportBase string, reportShards []shardingReportShard) error {\r\n\tentries := make([]shardingReportIndexEntry, 0, len(reportShards)*11)\r\n\tfor i, s := range reportShards {\r\n\t\tentries = appendShardIndexEntries(entries, i, s)\r\n\t}\r\n\tidx := shardingReportIndex{\r\n\t\tEntries:       entries,\r\n\t\tEntryCount:    len(entries),\r\n\t\tShardCount:    len(reportShards),\r\n\t\tGeneratedFrom: reportBase,\r\n\t"]
[19002.396889, "o", "\tToolVersion:   toolVersion,\r\n\t}\r\n\tdata, err := json.MarshalIndent(idx, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tdata = append(data, '\\n')\r\n\treturn atomicWriteFile(path, data)\r\n}\r\n\r\nfunc appendShardIndexEntries(entries []shardingReportIndexEntry, i int, s shardingReportShard) []shardingReportIndexEntry {\r\n\tfields := []struct {\r\n\t\tname string\r\n\t\tval  any\r\n"]
[19002.396976, "o", "\t}{\r\n\t\t{\"shard\", s.Shard},\r\n\t\t{\"bytes\", s.Bytes},\r\n\t\t{\"sha256\", s.SHA256},\r\n\t\t{\"events_total\", s.EventsTotal},\r\n\t\t{\"events_accepted\", s.EventsAccepted},\r\n\t\t{\"events_invalid\", s.EventsInvalid},\r\n\t\t{\"events_late\", s.EventsLate},\r\n\t\t{\"events_duplicate\", s.EventsDuplicate},\r\n\t\t{\"events_unresolved_chargeback\", s.EventsUnresolvedChargeback},\r\n\t\t{\"first_ts\", s.FirstTS},\r\n\t\t{\"last_ts\", s.LastTS},\r\n\t"]
[19002.397058, "o", "}\r\n\tfor _, f := range fields {\r\n\t\tentries = append(entries, shardingReportIndexEntry{\r\n\t\t\tName: f.name,\r\n\t\t\tType: indexType(f.val),\r\n\t\t\tPath: fmt.Sprintf(\"$.shards[%d].%s\", i, f.name),\r\n\t\t})\r\n\t}\r\n\treturn entries\r\n}\r\n\r\nfunc indexType(v any) string {\r\n\tswitch v.(type) {\r\n"]
[19002.397137, "o", "\tcase string:\r\n\t\treturn \"string\"\r\n\tcase int, int64:\r\n\t\treturn \"integer\"\r\n\tcase *string:\r\n\t\tif v.(*string) == nil {\r\n\t\t\treturn \"null\"\r\n\t\t}\r\n\t\treturn \"string\"\r\n\tdefault:\r\n\t\treturn \"null\"\r\n\t}\r\n"]
[19002.397231, "o", "}\r\n\r\nfunc writeShardingHistogram(path, reportBase string, reportShards []shardingReportShard, shardCount int) error {\r\n\tvar buckets shardingReportHistogramBuckets\r\n\tfor _, m := range shardingHistogramMetrics {\r\n\t\tvalues := make([]int, 0, len(reportShards))\r\n\t\tfor _, s := range reportShards {\r\n\t\t\tvalues = append(values, shardingMetricValue(s, m))\r\n\t\t}\r\n\t\tarr := buildHistogram(values, shardCount)\r\n\t\tswitch m {\r\n\t\tcase \"bytes\":\r\n"]
[19002.397313, "o", "\t\t\tbuckets.Bytes = arr\r\n\t\tcase \"events_total\":\r\n\t\t\tbuckets.EventsTotal = arr\r\n\t\tcase \"events_accepted\":\r\n\t\t\tbuckets.EventsAccepted = arr\r\n"]
