[3566.299395, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[3566.299449, "o", "\u001b[?2004h> "]
[3566.299548, "o", "  return t.UTC(), nil\r\n\u001b[?2004l\r"]
[3566.299602, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
