[14552.288028, "o", "   417\t\t\t\t\t} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n   418\t\t\t\t\t\twinner = idx\r\n   419\t\t\t\t\t\ttiebreak = true\r\n   420\t\t\t\t\t}\r\n   421\t\t\t\t}\r\n   422\t\t\t}\r\n"]
