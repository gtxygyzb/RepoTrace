[10901.315036, "o", "    30\t\tauditLogDigest    string\r\n    31\t\tratesStrict       bool\r\n    32\t\tratesMaxStaleness int\r\n    33\t\tingestID          string\r\n    34\t\tingestIDSet       bool\r\n    35\t\toutManifest       string\r\n    36\t\tmanifestSignature string\r\n    37\t\tdedupPolicy       string\r\n    38\t\tdedupPolicySet    bool\r\n    39\t}\r\n    40\t\r\n    41\tfunc main() {\r\n    42\t\tcfg, err := parseArgs(os.Args[1:])\r\n    43\t\tif err != nil {\r\n    44\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    45\t\t\tos.Exit(2)\r\n    46\t\t}\r\n    47\t\tif err := run(cfg); err != nil {\r\n"]
