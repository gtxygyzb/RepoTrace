[17105.325809, "o", "   396\t\t\tcase \"fx_unknown_currency\":\r\n   397\t\t\t\treturn nil, \"fx_unknown_currency\"\r\n   398\t\t\tcase \"missing_rate\":\r\n   399\t\t\t\treturn nil, \"fx_no_rate_for_date\"\r\n   400\t\t\tcase \"bad_rate\":\r\n   401\t\t\t\tif ratesStrict {\r\n   402\t\t\t\t\treturn nil, \"fx_bad_rate\"\r\n   403\t\t\t\t}\r\n   404\t\t\t\treturn nil, \"fx_no_rate_for_date\"\r\n   405\t\t\t}\r\n   406\t\t\tusd := amount * rate\r\n"]
[17105.325885, "o", "   407\t\t\tif typeStr == \"refund\" {\r\n   408\t\t\t\tusd = -usd\r\n   409\t\t\t}\r\n   410\t\t\tev.Amount = amount\r\n   411\t\t\tev.Currency = cur\r\n   412\t\t\tev.FXFallbackDays = fallbackDays\r\n   413\t\t\tev.USD = roundMoney(usd)\r\n   414\t\tcase \"chargeback\":\r\n   415\t\t\tref, refOk, refPresent := getRawString(obj, \"ref_id\")\r\n   416\t\t\tif !refPresent || !refOk || ref == \"\" {\r\n   417\t\t\t\treturn nil, \"missing_ref_id\"\r\n"]
[17105.325956, "o", "   418\t\t\t}\r\n   419\t\t\tev.RefID = ref\r\n   420\t\t\tev.USD = 0\r\n   421\t\tcase \"login\", \"signup\":\r\n   422\t\t\tev.USD = 0\r\n   423\t\t}\r\n   424\t\treturn ev, \"\"\r\n   425\t}\r\n"]
