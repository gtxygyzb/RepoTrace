[14585.687369, "o", "\tratesMaxStaleness   int\r\n    34\t\tingestID            string\r\n    35\t\tingestIDSet         bool\r\n    36\t\toutManifest         string\r\n    37\t\tmanifestSignature   string\r\n    38\t\tdedupPolicy         string\r\n    39\t\tdedupPolicySet      bool\r\n    40\t\tstrictLateAudit     bool\r\n    41\t\tstateStrict         bool\r\n    42\t\tsummarySchemaOut     string\r\n    43\t\tsummarySchemaDigest string\r\n    44\t\tsummarySchemaStrict bool\r\n    45\t\tsummarySchemaIndex  string\r\n    46\t}\r\n    47\t\r\n    48\tfunc main() {\r\n    49\t\tcfg, err := parseArgs(os.Args[1:])\r\n    50\t\tif err != nil {\r\n    51\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    52\t\t\tos.Exit(2)\r\n    53\t\t}\r\n    54\t\tif err := run(cfg); err != nil {\r\n    55\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    56\t\t\tos.Exit(1)\r\n    57\t\t}\r\n    58"]
