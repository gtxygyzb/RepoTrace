[18053.095688, "o", "   124\ttype auditLogEntry struct {\r\n   125\t\tShard               string         `json:\"shard\"`\r\n   126\t\tLine                int            `json:\"line\"`\r\n   127\t\tID                  string         `json:\"id\"`\r\n   128\t\tTS                  string         `json:\"ts\"`\r\n"]
[18053.095809, "o", "   129\t\tType                string         `json:\"type\"`\r\n   130\t\tBucket              string         `json:\"bucket\"`\r\n   131\t\tReason              string         `json:\"reason\"`\r\n   132\t\tWinnerArrival       *winnerArrival `json:\"winner_arrival,omitempty\"`\r\n   133\t\tEvent               rawJSON        `json:\"event\"`\r\n   134\t\tCutoff              *cutoffObject  `json:\"cutoff,omitempty\"`\r\n   135\t\tWatermarkLagSeconds *int           `json:\"watermark_lag_seconds,omitempty\"`\r\n   136\t\tLateBySeconds       *int           `json:\"late_by_seconds,omitempty\"`\r\n   137\t}\r\n   138\t\r\n   139\ttype cutoffObject struct {\r\n   140\t\tValue        string `json:\"value\"`\r\n   141\t\tEpochSeconds int    `json:\"epoch_seconds\"`\r\n   142\t}\r\n"]
[18053.095881, "o", "   143\t\r\n   144\tfunc (e auditLogEntry) MarshalJSON() ([]byte, error) {\r\n   145\t\tif e.Bucket == \"late\" {\r\n   146\t\t\tvar buf bytes.Buffer\r\n   147\t\t\tbuf.WriteString(`{\"id\":`)\r\n   148\t\t\tb, err := json.Marshal(e.ID)\r\n   149\t\t\tif err != nil {\r\n   150\t\t\t\treturn nil, err\r\n   151\t\t\t}\r\n"]
[18053.095951, "o", "   152\t\t\tbuf.Write(b)\r\n   153\t\t\tbuf.WriteString(`,\"ts\":`)\r\n   154\t\t\tb, err = json.Marshal(e.TS)\r\n   155\t\t\tif err != nil {\r\n   156\t\t\t\treturn nil, err\r\n   157\t\t\t}\r\n   158\t\t\tbuf.Write(b)\r\n   159\t\t\tbuf.WriteString(`,\"type\":`)\r\n   160\t\t\tb, err = json.Marshal(e.Type)\r\n"]
[18053.096009, "o", "   161\t\t\tif err != nil {\r\n   162\t\t\t\treturn nil, err\r\n   163\t\t\t}\r\n   164\t\t\tbuf.Write(b)\r\n   165\t\t\tbuf.WriteString(`,\"shard\":`)\r\n   166\t\t\tb, err = json.Marshal(e.Shard)\r\n   167\t\t\tif err != nil {\r\n   168\t\t\t\treturn nil, err\r\n"]
[18053.096073, "o", "   169\t\t\t}\r\n   170\t\t\tbuf.Write(b)\r\n   171\t\t\tbuf.WriteString(`,\"line\":`)\r\n   172\t\t\tb, err = json.Marshal(e.Line)\r\n   173\t\t\tif err != nil {\r\n   174\t\t\t\treturn nil, err\r\n   175\t\t\t}\r\n   176\t\t\tbuf.Write(b)\r\n   177\t\t\tbuf.WriteString(`,\"bucket\":`)\r\n   178\t\t\tb, err = json.Marshal(e.Bucket)\r\n"]
[18053.096135, "o", "   179\t\t\tif err != nil {\r\n   180\t\t\t\treturn nil, err\r\n   181\t\t\t}\r\n   182\t\t\tbuf.Write(b)\r\n   183\t\t\tbuf.WriteString(`,\"cutoff\":`)\r\n   184\t\t\tif e.Cutoff != nil {\r\n   185\t\t\t\tb, err = json.Marshal(e.Cutoff)\r\n   186\t\t\t\tif err != nil {\r\n   187\t\t\t\t\t"]
[18053.096224, "o", "return nil, err\r\n   188\t\t\t\t}\r\n   189\t\t\t} else {\r\n   190\t\t\t\tb = []byte(\"null\")\r\n   191\t\t\t}\r\n   192\t\t\tbuf.Write(b)\r\n   193\t\t\tif e.WatermarkLagSeconds != nil {\r\n   194\t\t\t\tbuf.WriteString(`,\"watermark_lag_seconds\":`)\r\n   195\t\t\t\tb, err = json.Marshal(*e.WatermarkLagSeconds)\r\n"]
[18053.096284, "o", "   196\t\t\t\tif err != nil {\r\n   197\t\t\t\t\treturn nil, err\r\n   198\t\t\t\t}\r\n   199\t\t\t\tbuf.Write(b)\r\n   200\t\t\t}\r\n   201\t\t\tif e.LateBySeconds != nil {"]
[18053.096341, "o", "\r\n   202\t\t\t\tbuf.WriteString(`,\"late_by_seconds\":`)\r\n   203\t\t\t\tb, err = json.Marshal(*e.LateBySeconds)\r\n   204\t\t\t\tif err != nil {\r\n   205\t\t\t\t\treturn nil, err\r\n"]
