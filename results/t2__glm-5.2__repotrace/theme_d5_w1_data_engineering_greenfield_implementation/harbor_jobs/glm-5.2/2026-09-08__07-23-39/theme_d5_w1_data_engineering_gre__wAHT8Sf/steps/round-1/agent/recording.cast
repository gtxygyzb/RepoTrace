[8093.44384, "o", "    69\t\tdays  map[string]map[string]float64\r\n    70\t\tknown map[string]bool\r\n    71\t}\r\n    72\t\r\n    73\tfunc newRateTable() *RateTable {\r\n    74\t\treturn &RateTable{base: \"USD\", days: map[string]map[string]float64{}, known: map[string]bool{}}\r\n    75\t}\r\n    76\t\r\n    77\tfunc isUsableRate(f float64) bool {\r\n    78\t\treturn isFinite(f) && f > 0\r\n    79\t}\r\n    80\t\r\n    81\tfunc parseRateNumber(raw json.RawMessage) (float64, error) {\r\n    82\t\tif bytes.Equal(bytes.TrimSpace(raw), []byte(\"null\")) {\r\n    83\t\t\treturn 0, errors.New(\"non-numeric rate\")\r\n    84\t\t}\r\n    85\t"]
[8093.443931, "o", "\tvar f float64\r\n    86\t\tif err := json.Unmarshal(raw, &f); err != nil {\r\n    87\t\t\treturn 0, errors.New(\"non-numeric rate\")\r\n    88\t\t}\r\n    89\t\treturn f, nil\r\n    90\t}\r\n    91\t\r\n    92\tfunc sortedKeys[T any](m map[string]T) []string {\r\n    93\t\tkeys := make([]string, 0, len(m))\r\n    94\t\tfor k := range m {\r\n    95\t\t\tkeys = append(keys, k)\r\n    96\t\t}\r\n    97\t\tsort.Strings(keys)\r\n"]
[8093.444021, "o", "    98\t\treturn keys\r\n    99\t}\r\n   100\t\r\n   101\tfunc isStrictDate(s string) bool {\r\n   102\t\tif len(s) != 10 {\r\n   103\t\t\treturn false\r\n   104\t\t}\r\n   105\t\tfor i, c := range s {\r\n   106\t\t\tif i == 4 || i == 7 {\r\n   107\t\t\t\tif c != '-' {\r\n   108\t\t\t\t\treturn false\r\n   109\t\t\t\t}\r\n   110"]
[8093.444109, "o", "\t\t\t\tcontinue\r\n   111\t\t\t}\r\n   112\t\t\tif c < '0' || c > '9' {\r\n   113\t\t\t\treturn false\r\n   114\t\t\t}\r\n   115\t\t}\r\n   116\t\treturn true\r\n   117\t}\r\n   118\t\r\n   119\tfunc dayEpoch(date string) time.Time {\r\n   120\t\tt, err := time.Parse(\"2006-01-02\", date)\r\n   121\t\tif err != nil {\r\n"]
[8093.444214, "o", "   122\t\t\treturn time.Time{}\r\n   123\t\t}\r\n   124\t\treturn t.UTC()\r\n   125\t}\r\n   126\t\r\n   127\tfunc calendarDayDiff(rateDate, eventDate string) int {\r\n   128\t\tr := dayEpoch(rateDate)\r\n   129\t\te := dayEpoch(eventDate)\r\n   130\t\tif r.IsZero() || e.IsZero() {\r\n   131\t\t\treturn 0\r\n   132\t\t}\r\n   133\t\treturn int(r.Sub(e) / (24 * time.Hour))\r\n   134\t}\r\n   135\t\r\n   136\tfunc absInt(v int) int {\r\n   137\t\tif v < 0 {\r\n   138\t\t\treturn -v\r\n"]
[8093.4443, "o", "   139\t\t}\r\n   140\t\treturn v\r\n   141\t}\r\n   142\t\r\n   143\tfunc absInt64(v int64) int64 {\r\n   144\t\tif v < 0 {\r\n   145\t\t\treturn -v\r\n   146\t\t}\r\n   147\t\treturn v\r\n   148\t}\r\n   149\t\r\n   150\t"]
[8093.444389, "o", "func (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {\r\n   151\t\tif !rt.known[currency] {\r\n   152\t\t\treturn 0, 0, \"fx_unknown_currency\"\r\n   153\t\t}\r\n   154\t\tif m, ok := rt.days[date]; ok {\r\n   155\t\t\tif r, ok := m[currency]; ok {\r\n   156\t\t\t\tif isUsableRate(r) {\r\n   157\t\t\t\t\treturn r, 0, \"\"\r\n   158\t\t\t\t}\r\n   159\t\t\t\treturn 0, 0, \"bad_rate\"\r\n   160\t\t\t}\r\n   161\t\t}\r\n   162\t\tif maxStaleness > 0 {\r\n   163\t\t\teventDay := dayEpoch(date)\r\n"]
[8093.444475, "o", "   164\t\t\tif !eventDay.IsZero() {\r\n   165\t\t\t\tvar bestDate string\r\n   166\t\t\t\tvar bestDist int64 = -1\r\n   167\t\t\t\tfor _, d := range sortedKeys(rt.days) {\r\n   168\t\t\t\t\tif _, ok := rt.days[d][currency]; !ok {\r\n   169\t\t\t\t\t\tcontinue\r\n   170\t\t\t\t\t}\r\n   171\t\t\t\t\tdayTime := dayEpoch(d)\r\n   172\t\t\t\t\tif dayTime.IsZero() {\r\n   173\t\t\t\t\t\tcontinue\r\n   174\t\t\t\t\t}\r\n"]
[8093.44456, "o", "   175\t\t\t\t\tdist := absInt64(dayTime.Unix() - eventDay.Unix())\r\n   176\t\t\t\t\tif dist > int64(maxStaleness) {\r\n   177\t\t\t\t\t\tcontinue\r\n   178\t\t\t\t\t}\r\n   179\t\t\t\t\tif bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {\r\n   180\t\t\t\t\t\tbestDist = dist\r\n"]
