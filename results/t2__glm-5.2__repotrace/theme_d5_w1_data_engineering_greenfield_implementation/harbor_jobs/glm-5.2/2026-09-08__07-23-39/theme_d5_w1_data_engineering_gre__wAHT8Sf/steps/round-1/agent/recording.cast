[18242.761738, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t"]
[18242.761833, "o", "\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n\r\ntype cliConfig struct {\r\n\tinputDir            string\r\n\tratesPath           string\r\n\toutputPath          string\r\n\trejectsPath         string\r\n\tsessionGap          int\r\n\twatermarkLag        int\r\n"]
[18242.761935, "o", "\tstateIn             string\r\n\tstateOut            string\r\n\tpendingTTL          int\r\n\tmaxOpenSessions     int\r\n\tauditLog            string\r\n\tauditLogDigest      string\r\n\tauditLogRotateBytes int\r\n\tratesStrict         bool\r\n\tratesMaxStaleness   int\r\n\tingestID            string\r\n\tingestIDSet         bool\r\n\toutManifest         string\r\n\tmanifestSignature   string\r\n\tdedupPolicy         string\r\n\tdedupPolicySet      bool\r\n\tstrictLateAudit     bool\r\n\tstateStrict         bool\r\n\tsummarySchemaOut    string\r\n\tsummarySchemaDigest string\r\n\tsummarySchemaStrict bool\r\n"]
[18242.762028, "o", "\tsummarySchemaIndex  string\r\n\trejectsFormat       string\r\n\trejectsFormatHeader bool\r\n\tsessionPolicy       string\r\n\tfixedWindowSeconds  int\r\n\tfixedWindowSet      bool\r\n}\r\n\r\nfunc main() {\r\n\tcfg, err := parseArgs(os.Args[1:])\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(2)\r\n\t}\r\n\tif err := run(cfg); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t"]
[18242.762117, "o", "\tos.Exit(1)\r\n\t}\r\n}\r\n\r\nfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n\tdefer func() {\r\n\t\tif r := recover(); r != nil {\r\n\t\t\tcfg = cliConfig{}\r\n\t\t\terr = fmt.Errorf(\"%v\", r)\r\n\t\t}\r\n\t}()\r\n\tcfg = cliConfig{\r\n\t\tsessionGap:        600,\r\n\t\twatermarkLag:      300,\r\n\t\tpendingTTL:        86400,\r\n"]
[18242.76225, "o", "\t\tmaxOpenSessions:   100000,\r\n\t\tratesMaxStaleness: 0,\r\n\t}\r\n\trequired := map[string]bool{\r\n\t\t\"--input-dir\": false,\r\n\t\t\"--rates\":     false,\r\n\t\t\"--output\":    false,\r\n\t\t\"--rejects\":   false,\r\n\t}\r\n\tif len(args) > 0 && args[0] == \"ingest\" {\r\n\t\targs = args[1:]\r\n\t}\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tif strings.HasPrefix(arg, \"--summary-schema-out=\") {\r\n\t\t\tcfg.summarySchemaOut = strings.TrimPrefix(arg, \"--summary-schema-out=\")\r\n\t\t\tif cfg.summarySchemaOut == \"\" {\r\n\t\t"]
[18242.762341, "o", "\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-out: value must be non-empty\")\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif strings.HasPrefix(arg, \"--summary-schema-digest=\") {\r\n\t\t\tcfg.summarySchemaDigest = strings.TrimPrefix(arg, \"--summary-schema-digest=\")\r\n\t\t\tif cfg.summarySchemaDigest == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest: value must be non-empty\")\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif strings.HasPrefix(arg, \"--summary-schema-index=\") {\r\n\t\t\tcfg.summarySchemaIndex = strings.TrimPrefix(arg, \"--summary-schema-index=\")\r\n\t\t\tif cfg.summarySchemaIndex == \"\" {"]
[18242.762426, "o", "\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index: value must be non-empty\")\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tswitch arg {\r\n\t\tcase \"--input-dir\":\r\n\t\t\tcfg.inputDir = nextArg(args, &i)\r\n\t\tcase \"--rates\":\r\n\t\t\tcfg.ratesPath = nextArg(args, &i)\r\n\t\tcase \"--output\":\r\n\t\t\tcfg.outputPath = nextArg(args, &i)\r\n\t\tcase \"--rejects\":\r\n\t\t\tcfg.rejectsPath = nextArg(args, &i)\r\n"]
[18242.76251, "o", "\t\tcase \"--session-gap\":\r\n"]
