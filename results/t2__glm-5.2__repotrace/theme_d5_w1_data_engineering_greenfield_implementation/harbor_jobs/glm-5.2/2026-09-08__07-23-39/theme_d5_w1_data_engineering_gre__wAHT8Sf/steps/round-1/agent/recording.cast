[14532.666778, "o", "   352\t\t\t\t\t\tauditEntries = append(auditEntries, entry)\r\n   353\t\t\t\t\t\tev = nil\r\n   354\t\t\t\t\t} else {\r\n   355\t\t\t\t\t\tbucket = \"accepted\"\r\n   356\t\t\t\t\t\tif ev.TS.After(watermark) {\r\n   357\t\t\t\t\t\t\twatermark = ev.TS\r\n   358\t\t\t\t\t\t\thasWatermark = true\r\n   359\t\t\t\t\t\t}\r\n"]
