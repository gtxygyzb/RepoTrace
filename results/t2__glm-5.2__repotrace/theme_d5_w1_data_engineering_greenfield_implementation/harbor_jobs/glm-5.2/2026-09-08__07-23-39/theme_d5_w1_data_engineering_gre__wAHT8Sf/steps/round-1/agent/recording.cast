[9235.431593, "o", "\tctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n   308\t\tif raw.Obj != nil {\r\n   309\t\t\tctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n   310\t\t\tctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n   311\t\t\tctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n   312\t\t}\r\n   313\t\treturn ctx\r\n   314\t}\r\n   315\t\r\n   316\tfunc parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {\r\n   317\t\tobj := ctx.Obj\r\n   318\t\tif obj == nil {\r\n   319\t\t\treturn nil, \"invalid_json\"\r\n   320\t\t}\r\n   321\t"]
[9235.43166, "o", "\traw, ok := obj[\"v\"]\r\n   322\t\tif !ok {\r\n   323\t\t\treturn nil, \"schema_version\"\r\n   324\t\t}\r\n   325\t\tvar v int\r\n"]
[9235.431725, "o", "   326\t\tif err := json.Unmarshal(raw, &v); err != nil {\r\n   327\t\t\treturn nil, \"schema_version\"\r\n   328\t\t}\r\n   329\t\tif v != 1 && v != 2 {\r\n   330\t\t\treturn nil, \"schema_version\"\r\n   331\t\t}\r\n   332\t\tid, idOk, _ := getRawString(obj, \"id\")\r\n   333\t\tif !idOk || id == \"\" {\r\n   334\t\t\treturn nil, \"missing_id\"\r\n   335\t\t}\r\n   336\t\ttsStr, tsOk, _ := getRawString(obj, \"ts\")\r\n   337\t\tif !tsOk {\r\n   338\t\t\treturn nil, \"missing_ts\"\r\n   339\t\t}\r\n"]
[9235.431789, "o", "   340\t\tt, err := parseTime(tsStr)\r\n   341\t\tif err != nil {\r\n   342\t\t\treturn nil, \"bad_ts\"\r\n   343\t\t}\r\n   344\t\ttypeStr, typeOk, _ := getRawString(obj, \"type\")\r\n   345\t\tif !typeOk {\r\n   346\t\t\treturn nil, \"missing_type\"\r\n   347\t\t}\r\n   348\t\tswitch typeStr {\r\n"]
[9235.431848, "o", "   349\t\tcase \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\n   350\t\tdefault:\r\n   351\t\t\treturn nil, \"bad_type\"\r\n   352\t\t}\r\n   353\t\tuser, userOk, _ := getRawString(obj, \"user_id\")\r\n   354\t\tif !userOk || user == \"\" {\r\n   355\t\t\treturn nil, \"missing_user\"\r\n   356\t\t}\r\n"]
[9235.431912, "o", "   357\t\tev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n   358\t\tswitch typeStr {\r\n   359\t\tcase \"purchase\", \"refund\":\r\n   360\t\t\tvar amount float64\r\n   361\t\t\tif v == 1 {\r\n   362\t\t\t\traw, present := obj[\"amount\"]\r\n   363\t\t\t\tif !present {\r\n   364\t\t\t\t\treturn nil, \"missing_amount\"\r\n"]
[9235.431971, "o", "   365\t\t\t\t}\r\n   366\t\t\t\tvar f float64\r\n   367\t\t\t\tif err := json.Unmarshal(raw, &f); err != nil {\r\n   368\t\t\t\t\treturn nil, \"bad_amount\"\r\n   369\t\t\t\t}\r\n   370\t\t\t\tif !isFinite(f) || f < 0 {\r\n   371\t\t\t\t\treturn nil, \"bad_amount\"\r\n   372\t\t\t\t}\r\n   373\t\t\t\tamount = f\r\n"]
[9235.432027, "o", "   374\t\t\t} else {\r\n   375\t\t\t\traw, present := obj[\"amount_cents\"]\r\n   376\t\t\t\tif !present {\r\n   377\t\t\t\t\treturn nil, \"missing_amount\"\r\n   378\t\t\t\t}\r\n   379\t\t\t\tn, err := getJSONInt(raw)\r\n"]
[9235.432087, "o", "   380\t\t\t\tif err != nil || n < 0 {\r\n   381\t\t\t\t\treturn nil, \"bad_amount\"\r\n   382\t\t\t\t}\r\n   383\t\t\t\tamount = float64(n) / 100.0\r\n   384\t\t\t}\r\n   385\t\t\tcur, curOk, curPresent := getRawString(obj, \"currency\")\r\n   386\t\t\tif !curPresent {\r\n   387\t\t\t\treturn nil, \"missing_currency\"\r\n"]
[9235.43215, "o", "   388\t\t\t}\r\n   389\t\t\tif !curOk || cur == \"\" {\r\n   390\t\t\t\treturn nil, \"bad_currency\"\r\n   391\t\t\t}\r\n   392\t\t\trate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)\r\n   393\t\t\tswitch status {\r\n   394\t\t\tcase \"fx_unknown_currency\":\r\n   395\t\t\t\treturn nil, \"fx_unknown_currency\"\r\n   396\t\t\tcase \"missing_rate\":\r\n   397\t\t\t\treturn nil, \"fx_no_rate_for_date\"\r\n"]
[9235.432233, "o", "   398\t\t\tcase \"bad_rate\":\r\n   399\t\t\t\tif ratesStrict {\r\n   400\t\t\t\t\treturn nil, \"fx_bad_rate\"\r\n   401\t\t\t\t}\r\n   402\t\t\t\treturn nil, \"fx_no_rate_for_date\"\r\n   403\t\t\t}\r\n   404\t\t\tusd := amount * rate\r\n   405\t\t\tif typeStr == \"refund\" {\r\n   406\t\t\t\tusd = -usd\r\n"]
