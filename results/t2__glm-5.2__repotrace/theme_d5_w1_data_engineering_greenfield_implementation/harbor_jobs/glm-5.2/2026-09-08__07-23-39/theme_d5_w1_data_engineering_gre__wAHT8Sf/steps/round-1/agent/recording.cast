[19950.91683, "o", "   144\tfunc (e auditLogEntry) MarshalJSON() ([]byte, error) {\r\n   145\t\tif e.Bucket == \"late\" {\r\n   146\t\t\tvar buf bytes.Buffer\r\n   147\t\t\tbuf.WriteString(`{\"id\":`)\r\n   148\t\t\tb, err := json.Marshal(e.ID)\r\n   149\t\t\tif err != nil {\r\n   150\t\t\t\treturn nil, err\r\n   151\t\t\t}\r\n   152\t\t\tbuf.Write(b)\r\n   153\t\t\tbuf.WriteString(`,\"ts\":`)\r\n   154"]
[19950.916908, "o", "\t\t\tb, err = json.Marshal(e.TS)\r\n   155\t\t\tif err != nil {\r\n   156\t\t\t\treturn nil, err\r\n   157\t\t\t}\r\n   158\t\t\tbuf.Write(b)\r\n   159\t\t\tbuf.WriteString(`,\"type\":`)\r\n   160\t\t\tb, err = json.Marshal(e.Type)\r\n   161\t\t\tif err != nil {\r\n   162\t\t\t\treturn nil, err\r\n   163\t\t\t}\r\n"]
[19950.916981, "o", "   164\t\t\tbuf.Write(b)\r\n   165\t\t\tbuf.WriteString(`,\"shard\":`)\r\n   166\t\t\tb, err = json.Marshal(e.Shard)\r\n   167\t\t\tif err != nil {\r\n   168\t\t\t\treturn nil, err\r\n   169\t\t\t}\r\n   170\t\t\tbuf.Write(b)\r\n   171\t\t\tbuf.WriteString(`,\"line\":`)\r\n   172\t\t\tb, err = json.Marshal(e.Line)"]
[19950.917049, "o", "\r\n   173\t\t\tif err != nil {\r\n   174\t\t\t\treturn nil, err\r\n   175\t\t\t}\r\n   176\t\t\tbuf.Write(b)\r\n   177\t\t\tbuf.WriteString(`,\"bucket\":`)\r\n   178\t\t\tb, err = json.Marshal(e.Bucket)\r\n   179\t\t\tif err != nil {\r\n"]
[19950.917122, "o", "   180\t\t\t\treturn nil, err\r\n   181\t\t\t}\r\n   182\t\t\tbuf.Write(b)\r\n   183\t\t\tbuf.WriteString(`,\"cutoff\":`)\r\n   184\t\t\tif e.Cutoff != nil {\r\n   185\t\t\t\tb, err = json.Marshal(e.Cutoff)\r\n   186\t\t\t\tif err != nil {\r\n   187\t\t\t\t\treturn nil, err\r\n   188\t\t\t\t}\r\n   189\t\t\t} else {\r\n   190\t\t\t\tb = []byte(\"null\")\r\n   191\t\t\t}\r\n"]
