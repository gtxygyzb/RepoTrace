[12700.865601, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t\"errors\"\r\n\t\"fmt\"\r\n"]
[12700.865699, "o", "\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\n"]
[12700.865757, "o", "var usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--state-strict] [--audit-log <path>] [--audit-log-digest <path>] [--audit-log-rotate-bytes <int>] [--rates-strict] [--rates-max-staleness <seconds>] [--ingest-id <string>] [--out-parquet-manifest <path>] [--manifest-signature <path>] [--dedup-policy <first-arrival|lex-largest-ts>] [--strict-late-audit]\\n\"\r\n\r\ntype Money float64\r\n\r\nfunc (m Money) MarshalJSON() ([]byte, error) {\r\n\treturn []byte(m.String()), nil\r\n}\r\n\r\nfunc (m Money) String() string {\r\n\tf := float64(m)\r\n\tabs := math.Abs(f)\r\n\tcents := int64(math.Floor(abs*100.0 + 0.5))\r\n\tneg := f < 0 && cents != 0\r\n\tdollars := cents / 100\r\n\trem := cents % 100\r\n\ts := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n\tif neg {\r\n\t\ts = \"-\" + s\r\n\t}\r\n\treturn s\r\n}\r\n\r\n"]
[12700.86581, "o", "type Event struct {\r\n\tID                string\r\n\tType              string\r\n\tTS                time.Time\r\n\tUserID            string\r\n\tAmount            float64\r\n\tCurrency          string\r\n\tRefID             string\r\n\tUSD               float64\r\n\tRefUSD            float64\r\n\tFXFallbackDays    int"]
[12700.865829, "o", "\r\n\tResolvedAgainst   *string\r\n\tResolvedOriginRun int\r\n\tSessionIndex      int\r\n"]
[12700.865889, "o", "\tRaw               rawJSON\r\n\tShard             string\r\n\tLine              int\r\n}\r\n\r\ntype Reject struct {\r\n\tBucket int     `json:\"bucket\"`\r\n\tEvent  rawJSON `json:\"event\"`\r\n}\r\n\r\ntype ShardLine struct {\r\n\tShard string\r\n"]
[12700.865928, "o", "\tLine  int\r\n\tData  []byte\r\n}\r\n\r\ntype RateTable struct {\r\n\tbase  string\r\n\tdays  map[string]map[string]float64\r\n\tknown map[string]bool\r\n"]
[12700.865963, "o", "}\r\n\r\nfunc newRateTable() *RateTable {\r\n\treturn &RateTable{base: \"USD\", days: map[string]map[string]float64{}, known: map[string]bool{}}\r\n}\r\n\r\n"]
[12700.866007, "o", "func isUsableRate(f float64) bool {\r\n\treturn isFinite(f) && f > 0\r\n}\r\n\r\nfunc parseRateNumber(raw json.RawMessage) (float64, error) {\r\n\tif bytes.Equal(bytes.TrimSpace(raw), []byte(\"null\")) {\r\n\t\treturn 0, errors.New(\"non-numeric rate\")\r\n"]
[12700.866044, "o", "\t}\r\n\tvar f float64\r\n\tif err := json.Unmarshal(raw, &f); err != nil {\r\n\t\treturn 0, errors.New(\"non-numeric rate\")\r\n\t}\r\n\treturn f, nil\r\n}\r\n\r\nfunc sortedKeys[T any](m map[string]T) []string {\r\n\tkeys := make([]string, 0, len(m))\r\n\tfor k := range m {\r\n"]
[12700.866086, "o", "\t\tkeys = append(keys, k)\r\n\t}\r\n\t"]
[12700.866127, "o", "sort.Strings(keys)\r\n\treturn keys\r\n}\r\n\r\nfunc isStrictDate(s string) bool {\r\n\tif len(s) != 10 {\r\n\t\treturn false\r\n\t}\r\n\tfor i, c := range s {\r\n\t\tif i == 4 || i == 7 {\r\n\t\t\tif c != '-' {\r\n\t\t\t\treturn false\r\n\t"]
[12700.866165, "o", "\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif c < '0' || c > '9' {\r\n\t\t\treturn false\r\n\t\t}\r\n"]
[12700.866242, "o", "\t}\r\n\treturn true\r\n}\r\n\r\nfunc dayEpoch(date string) time.Time {\r\n\tt, err := time.Parse(\"2006-01-02\", date)\r\n\tif err != nil {\r\n\t\treturn time.Time{}\r\n\t}\r\n\treturn t.UTC()\r\n}\r\n"]
[12700.866283, "o", "\r\nfunc calendarDayDiff(rateDate, eventDate string) int {\r\n\tr := dayEpoch(rateDate)\r\n\te := dayEpoch(eventDate)\r\n\tif r.IsZero() || e.IsZero() {\r\n\t\treturn 0\r\n\t}\r\n\treturn int(r.Sub(e) / (24 * time.Hour))\r\n}\r\n"]
[12700.866319, "o", "\r\nfunc absInt(v int) int {\r\n\tif v < 0 {\r\n\t\treturn -v\r\n\t}\r\n"]
[12700.866352, "o", "\treturn v\r\n}\r\n\r\nfunc absInt64(v int64) int64 {\r\n\tif v < 0 {\r\n\t\treturn -v\r\n\t}\r\n"]
[12700.866386, "o", "\treturn v\r\n}\r\n\r\nfunc (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {\r\n\tif !rt.known[currency] {\r\n\t\treturn 0, 0, \"fx_unknown_currency\"\r\n\t}\r\n\tif m, ok := rt.days[date]; ok {\r\n"]
[12700.866422, "o", "\t\tif r, ok := m[currency]; ok {\r\n\t\t\tif isUsableRate(r) {\r\n\t\t\t\treturn r, 0, \"\"\r\n\t\t\t}\r\n\t\t\treturn 0, 0, \"bad_rate\"\r\n\t\t}\r\n"]
[12700.866456, "o", "\t}\r\n\tif maxStaleness > 0 {\r\n\t\teventDay := dayEpoch(date)\r\n\t\tif !eventDay.IsZero() {\r\n\t\t\tvar bestDate string\r\n"]
[12700.866487, "o", "\t\t\tvar bestDist int64 = -1\r\n\t\t\tfor _, d := range sortedKeys(rt.days) {\r\n\t\t\t\tif _, ok := rt.days[d][currency]; !ok {\r\n\t\t\t\t\tcontinue\r\n"]
[12700.866518, "o", "\t\t\t\t}\r\n\t\t\t\tdayTime := dayEpoch(d)\r\n\t\t\t\tif dayTime.IsZero() {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n"]
[12700.866549, "o", "\t\t\t\tdist := absInt64(dayTime.Unix() - eventDay.Unix())\r\n\t\t\t\tif dist > int64(maxStaleness) {\r\n\t\t\t\t\tcontinue\r\n\t\t\t\t}\r\n\t\t\t\tif bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {\r\n"]
[12700.866585, "o", "\t\t\t\t\tbestDist = dist\r\n\t\t\t\t\tbestDate = d\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif bestDate != \"\" {\r\n\t\t\t"]
[12700.866615, "o", "\tr := rt.days[bestDate][currency]\r\n\t\t\t\tif isUsableRate(r) {\r\n"]
[12700.866648, "o", "\t\t\t\t\treturn r, calendarDayDiff(bestDate, date), \"\"\r\n\t\t\t\t}\r\n\t\t\t\treturn 0, 0, \"bad_rate\"\r\n\t\t\t}\r\n\t\t}\r\n\t"]
[12700.866679, "o", "}\r\n\treturn 0, 0, \"missing_rate\"\r\n}\r\n\r\nfunc loadRates(path string) (*RateTable, error) {\r\n\tdata, err := os.ReadFile(path)\r\n\t"]
[12700.86672, "o", "if err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar top map[string]json.RawMessage\r\n"]
[12700.866756, "o", "\tif err := json.Unmarshal(data, &top); err != nil {\r\n\t\treturn nil, fmt.Errorf(\"rates file is not valid json: %w\", err)\r\n\t}\r\n\trt := newRateTable()\r\n\tdaysRaw, ok := top[\"days\"]\r\n\tif !ok {\r\n\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n"]
[12700.866792, "o", "\tvar days map[string]json.RawMessage\r\n\tif err := json.Unmarshal(daysRaw, &days); err != nil {\r\n\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\tif len(days) == 0 {\r\n\t\t"]
[12700.86683, "o", "return nil, errors.New(\"fx days invalid\")\r\n\t}\r\n\tfor _, day := range sortedKeys(days) {\r\n\t\tif !isStrictDate(day) || !isDate(day) {\r\n\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: invalid day key %s\", day)\r\n\t\t}\r\n"]
[12700.866875, "o", "\t\tvar currencies map[string]json.RawMessage\r\n\t\tif err := json.Unmarshal(days[day], &currencies); err != nil {\r\n\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t\t}\r\n\t\tfor _, currency := range sortedKeys(currencies) {\r\n"]
[12700.866915, "o", "\t\t\tf, err := parseRateNumber(currencies[currency])\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: non-numeric rate for %s/%s\", day, currency)\r\n\t\t\t}\r\n\t\t\tif rt.days[day] == nil {\r\n\t\t\t\trt.days[day] = map[string]float64{}\r\n\t\t\t}"]
[12700.866953, "o", "\r\n\t\t\trt.days[day][currency] = f\r\n\t\t\trt.known[currency] = true\r\n\t\t}\r\n\t}\r\n\tbaseRaw, baseOk := top[\"base\"]\r\n\tif !baseOk {\r\n"]
[12700.866991, "o", "\t\treturn nil, errors.New(\"ingest: rates.json: base required\")\r\n\t}\r\n\tvar base string\r\n\tif err := json.Unmarshal(baseRaw, &base); err != nil || base == \"\" {\r\n\t\treturn nil, errors.New(\"ingest: rates.json: base required\")\r\n"]
[12700.867028, "o", "\t}\r\n\trt.base = base\r\n\tif base != \"USD\" {\r\n\t\treturn nil, errors.New(\"fx base must be USD\")\r\n\t}\r\n\t"]
[12700.867064, "o", "for _, day := range sortedKeys(rt.days) {\r\n\t\tr, ok := rt.days[day][base]\r\n\t\tif !ok || r != 1.0 {\r\n\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: base currency %s must have rate 1.0 on day %s\", base, day)\r\n\t\t"]
[12700.867099, "o", "}\r\n\t}\r\n\treturn rt, nil\r\n}\r\n\r\nfunc readInputEvents(inputDir string) ([]rawEvent, []inputShardInfo, error) {\r\n\tinfo, err := os.Stat(inputDir)\r\n"]
[12700.867131, "o", "\tif err != nil {\r\n"]
