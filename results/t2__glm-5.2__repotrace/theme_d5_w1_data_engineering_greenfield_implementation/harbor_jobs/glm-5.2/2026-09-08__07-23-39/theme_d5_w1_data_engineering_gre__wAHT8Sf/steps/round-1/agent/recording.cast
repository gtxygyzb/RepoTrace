[12717.999812, "o", "    27\t\tneg := f < 0 && cents != 0\r\n    28\t\tdollars := cents / 100\r\n    29\t\trem := cents % 100\r\n    30\t\ts := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n    31\t\tif neg {\r\n    32\t\t\ts = \"-\" + s\r\n    33\t\t}\r\n    34\t\treturn s\r\n    35\t}\r\n"]
