[11036.681286, "o", "     7\t\t\"fmt\"\r\n     8\t\t\"math\"\r\n     9\t\t\"os\"\r\n    10\t\t\"path/filepath\"\r\n    11\t\t\"strings\"\r\n    12\t\t\"time\"\r\n    13\t)\r\n    14\t\r\n    15\tfunc rawStringPtr(obj map[string]json.RawMessage, key string) *string {\r\n    16\t\tif obj == nil {\r\n    17\t\t\treturn nil\r\n    18\t\t}\r\n    19\t\traw, ok := obj[key]\r\n    20\t\tif !ok {\r\n    21\t\t"]
[11036.68137, "o", "\treturn nil\r\n    22\t\t}\r\n    23\t\tvar s string\r\n    24\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n    25\t\t\treturn nil\r\n    26\t\t}\r\n    27\t\treturn &s\r\n    28\t}\r\n    29\t\r\n    30\tfunc getRawString(obj map[string]json.RawMessage, key string) (string, bool, bool) {\r\n    31\t\tif obj == nil {\r\n    32\t\t\treturn \"\", false, false\r\n    33\t\t}\r\n    34\t"]
[11036.681443, "o", "\traw, present := obj[key]\r\n    35\t\tif !present {\r\n    36\t\t\treturn \"\", false, false\r\n    37\t\t}\r\n    38\t\tvar s string\r\n    39\t\tif err := json.Unmarshal(raw, &s); err != nil {\r\n    40\t\t\treturn \"\", false, true\r\n    41\t\t}\r\n    42\t\treturn s, true, true\r\n    43\t}\r\n    44"]
[11036.68151, "o", "\t\r\n    45\tfunc getJSONInt(raw json.RawMessage) (int, error) {\r\n    46\t\tvar n int\r\n    47\t\tif err := json.Unmarshal(raw, &n); err != nil {\r\n    48\t\t\treturn 0, err\r\n    49\t\t}\r\n    50\t\treturn n, nil\r\n    51\t}\r\n    52\t\r\n"]
[11036.681572, "o", "    53\tfunc parseTime(s string) (time.Time, error) {\r\n    54\t\ts = strings.TrimSpace(s)\r\n    55\t\tif strings.HasSuffix(s, \"Z\") {\r\n    56\t\t\tif t, err := time.Parse(\"2006-01-02T15:04:05Z\", s); err == nil {\r\n    57\t\t\t\treturn t.UTC(), nil\r\n    58\t\t\t}\r\n    59\t\t\tif t, err := time.Parse(\"2006-01-02T15:04:05.000000000Z\", s); err == nil {\r\n"]
[11036.681646, "o", "    60\t\t\t\treturn t.UTC(), nil\r\n    61\t\t\t}\r\n    62\t\t}\r\n    63\t\tif t, err := time.Parse(time.RFC3339Nano, s); err == nil {\r\n    64\t\t\treturn t.UTC(), nil\r\n    65\t\t}\r\n    66\t\tif t, err := time.Parse(time.RFC3339, s); err == nil {\r\n    67\t\t\treturn t.UTC(), nil\r\n    68\t\t}\r\n    69\t\treturn time.Time{}, fmt.Errorf(\"bad timestamp: %s\", s)\r\n    70\t}\r\n"]
[11036.681705, "o", "    71\t\r\n    72\tfunc formatTS(t time.Time) string {\r\n    73\t\treturn t.UTC().Format(\"2006-01-02T15:04:05Z\")\r\n    74\t}\r\n    75\t\r\n    76\tfunc dateKey(t time.Time) string {\r\n    77\t\treturn t.UTC().Format(\"2006-01-02\")\r\n    78\t}\r\n"]
[11036.681768, "o", "    79\t\r\n    80\tfunc roundMoney(v float64) float64 {\r\n    81\t\tcents := int64(math.Floor(math.Abs(v)*100.0 + 0.5))\r\n    82\t\tif v < 0 && cents != 0 {\r\n    83\t\t\treturn -float64(cents) / 100.0\r\n    84\t\t}\r\n    85\t\treturn float64(cents) / 100.0\r\n    86\t}\r\n    87\t\r\n    88\tfunc isFinite(f float64) bool {"]
[11036.681834, "o", "\r\n    89\t\treturn !math.IsNaN(f) && !math.IsInf(f, 0)\r\n    90\t}\r\n    91\t\r\n    92\tfunc isDate(s string) bool {\r\n    93\t\t"]
[11036.681897, "o", "if _, err := time.Parse(\"2006-01-02\", s); err != nil {\r\n    94\t\t\treturn false\r\n    95\t\t}\r\n    96\t\treturn true\r\n    97\t}\r\n    98\t\r\n    99\tfunc sha256Hex(data []byte) string {\r\n   100\t\tsum := sha256.Sum256(data)\r\n   101\t\treturn hex.EncodeToString(sum[:])\r\n   102\t}\r\n   103\t\r\n   104\tfunc sha256Short(h string) string {\r\n   105\t\tif len(h) < 12 {\r\n   106\t\t"]
[11036.681973, "o", "\treturn h\r\n   107\t\t}\r\n   108\t\treturn h[:12]\r\n   109\t}\r\n   110\t\r\n   111\tfunc fileDigest(path string) (string, int64, error) {\r\n   112\t\tdata, err := os.ReadFile(path)\r\n   113\t\tif err != nil {\r\n   114\t\t\treturn \"\", 0, err\r\n   115\t\t}\r\n   116\t"]
[11036.682174, "o", "\treturn sha256Hex(data), int64(len(data)), nil\r\n   117\t}\r\n   118\t\r\n   119\tfunc atomicWriteFile(path string, data []byte) error {\r\n   120\t\ttmp := path + \".tmp\"\r\n   121\t"]
[11036.682298, "o", "\tif err := os.WriteFile(tmp, data, 0644); err != nil {\r\n   122\t\t\treturn err\r\n   123\t\t}\r\n   124\t\tif err := os.Rename(tmp, path); err != nil {\r\n   125\t\t\t_ = os.Remove(tmp)\r\n   126\t\t\treturn err\r\n   127\t\t}\r\n   128\t\treturn nil\r\n   129\t}\r\n   130\t\r\n   131\tfunc parentDirExists(path string) bool {\r\n   132\t\tdir := filepath.Dir(path)\r\n   133\t\tif dir == \".\" || dir == \"\" {\r\n   134\t\t\treturn true\r\n   135\t\t}\r\n   136\t\tinfo, err := os.Stat(dir)\r\n   137\t\tif err != nil {\r\n   138\t\t\treturn false\r\n   139\t\t}\r\n   140\t\treturn info.IsDir()\r\n   141\t}\r\n   142\t\r\n   143\tfunc manifestFileOutputFor(path string) (*manifestFileOutput, error) {\r\n   144\t\th, b, err := fileDigest(path)\r\n   145\t\tif err != nil {\r\n   146\t\t\treturn nil, err\r\n   147\t\t}\r\n   148\t\treturn &manifestFileOutput{\r\n   149\t\t\tPath:        filepath.Base(path),\r\n   150\t\t\tSHA256:      h,\r\n   151\t\t\tSHA256Short: sha256Short(h),\r\n   152\t\t\tBytes:       b,\r\n   153\t\t}, nil\r\n   154\t}\r\n"]
[11036.682405, "o", "   155\t\r\n   156\tfunc ptrString(s string) *string {\r\n   157\t\treturn &s\r\n   158\t}\r\n   159\t\r\n   160\tfunc (ctx *eventContext) IDStr() string {\r\n   161\t\tif ctx.ID != nil {\r\n   162\t\t\treturn *ctx.ID\r\n"]
[11036.682481, "o", "   163\t\t}\r\n   164\t\treturn \"\"\r\n   165\t}\r\n   166\t\r\n   167\tfunc (ctx *eventContext) TSString() string {\r\n   168\t\tif ctx.TS != nil {\r\n   169\t\t\treturn *ctx.TS\r\n   170\t\t}\r\n   171\t\treturn \"\"\r\n   172\t}\r\n   173\t\r\n   174\tfunc (ctx *eventContext) TypeString() string {\r\n   175\t\tif ctx.Type != nil {\r\n   176\t\t\treturn *ctx.Type\r\n   177\t\t}\r\n   178\t\treturn \"\"\r\n   179\t}\r\n"]
