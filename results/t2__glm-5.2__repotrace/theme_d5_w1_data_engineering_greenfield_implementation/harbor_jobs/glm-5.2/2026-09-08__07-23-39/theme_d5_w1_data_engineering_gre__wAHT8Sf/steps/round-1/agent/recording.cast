[17019.625929, "o", "   587\t\tfor i, c := range candidates {\r\n   588\t\t\tif c.ev != nil && winnerSet[i] {\r\n   589\t\t\t\tsurvivingByUser[c.ev.UserID] = append(survivingByUser[c.ev.UserID], c.ev)\r\n   590\t\t\t}\r\n   591\t\t}\r\n   592\t\tfor u := range survivingByUser {\r\n   593\t\t\tevs := survivingByUser[u]\r\n   594\t\t\tsort.SliceStable(evs, func(i, j int) bool {\r\n   595\t\t\t\treturn evs[i].TS.Before(evs[j].TS)\r\n   596\t\t\t})\r\n   597\t"]
[17019.625991, "o", "\t\tsurvivingByUser[u] = evs\r\n   598\t\t}\r\n   599\t\tsessionTotal := 0\r\n   600\t\tbyUser := make([]summarySessionUser, 0, len(survivingByUser))\r\n   601\t\tfor _, u := range sortedKeys(survivingByUser) {\r\n   602\t\t\tevs := survivingByUser[u]\r\n   603\t\t\tsessionTotal += computeSessionCount(evs, cfg.sessionPolicy, cfg.sessionGap, cfg.fixedWindowSeconds)\r\n   604\t\t\tbyUser = append(byUser, summarySessionUser{User: u, Count: len(evs)})\r\n   605\t\t}\r\n"]
[17019.626056, "o", "   606\t\r\n   607\t\tvar rejectRecords []rejectRecord\r\n   608\t\tfor i, c := range candidates {\r\n   609\t\t\tif c.ev == nil {\r\n   610\t\t\t\tr := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, shard: c.raw.Shard, line: c.raw.Line, raw: c.raw.Raw}\r\n   611\t\t\t\trejectRecords = append(rejectRecords, r)\r\n   612\t\t\t\tcontinue\r\n   613\t\t\t}\r\n   614\t\t\tif winnerSet[i] {\r\n"]
[17019.626115, "o", "   615\t\t\t\tcontinue\r\n   616\t\t\t}\r\n   617\t\t\tr := rejectRecord{bucket: \"duplicate\", reason: \"same_run\", shard: c.raw.Shard, line: c.raw.Line, raw: c.raw.Raw}\r\n   618\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n   619\t\t\t\tr.winner = true\r\n   620\t\t\t\tr.winnerShard = candidates[winners[c.ev.ID]].ev.Shard\r\n   621\t\t\t\tr.winnerLine = candidates[winners[c.ev.ID]].ev.Line\r\n   622\t\t\t}\r\n   623"]
[17019.626175, "o", "\t\t\trejectRecords = append(rejectRecords, r)\r\n   624\t\t}\r\n   625\t\r\n   626\t\tif cfg.rejectsFormat == \"tagged\" || cfg.rejectsFormat == \"tagged-sorted\" {\r\n   627\t\t\tfor _, b := range blanks {\r\n   628\t\t\t\trejectRecords = append(rejectRecords, rejectRecord{\r\n   629\t\t\t\t\tbucket: \"invalid\",\r\n"]
[17019.626252, "o", "   630\t\t\t\t\treason: \"schema_version\",\r\n   631\t\t\t\t\tshard:  b.Shard,\r\n   632\t\t\t\t\tline:   b.Line,\r\n   633\t\t\t\t\traw:    rawJSON(\"-\"),\r\n   634\t\t\t\t})\r\n   635\t\t\t}\r\n   636\t\t}\r\n   637\t\r\n"]
[17019.626323, "o", "   638\t\tsummary := summaryOutput{\r\n   639\t\t\tTotalEvents:    len(events),\r\n   640\t\t\tAcceptedEvents: bucketCounts[\"accepted\"],\r\n   641\t\t\tRejectedEvents: bucketCounts[\"duplicate\"] + bucketCounts[\"invalid\"] + bucketCounts[\"late\"] + bucketCounts[\"unresolved_chargeback\"],\r\n   642\t\t\tAnomalies: map[string]int{\r\n"]
[17019.62642, "o", "   643\t\t\t\t\"duplicate\":             bucketCounts[\"duplicate\"],\r\n   644\t\t\t\t\"invalid\":               bucketCounts[\"invalid\"],\r\n   645\t\t\t\t\"late\":                  bucketCounts[\"late\"],\r\n   646\t\t\t\t\"unresolved_chargeback\": bucketCounts[\"unresolved_chargeback\"],\r\n   647\t\t\t},\r\n   648\t\t\tRunIndex: runIndex,\r\n   649\t\t\tSessions: summarySessions{\r\n   650\t\t\t\tTotal:  sessionTotal,\r\n   651"]
[17019.626476, "o", "\t\t\t\tByUser: byUser,\r\n   652\t\t\t},\r\n   653\t\t}\r\n   654\t\tif hasWatermark {\r\n   655\t\t\twm := formatTS(watermark)\r\n   656\t\t\tsummary.Watermark = &wm\r\n   657\t\t}\r\n   658\t\tsummaryData, err := json.MarshalIndent(summary, \"\", \"  \")\r\n   659\t\tif err != nil {\r\n   660\t\t\treturn err\r\n"]
