[10727.323152, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\n# Patch auditLogEntry field order to match spec shape.\np = Path('types.go')\ns = p.read_text()\nold = '''type auditLogEntry struct {\n\\tShard         string  `json:\"shard\"`\n\\tLine          int     `json:\"line\"`\n\\tID            string  `json:\"id\"`\n\\tTS            string  `json:\"ts\"`\n\\tType          string  `json:\"type\"`\n\\tBucket        string  `json:\"bucket\"`\n\\tReason        string  `json:\"reason\"`\n\\tWinnerArrival *winnerArrival `json:\"winner_arrival,omitempty\"`\n\\tEvent         rawJSON `json:\"event\"`\n}'''\nnew = '''type auditLogEntry struct {\n\\tID            string  `json:\"id\"`\n\\tTS            string  `json:\"ts\"`\n\\tType          string  `json:\"type\"`\n\\tShard         string  `json:\"shard\"`\n\\tLine          int     `json:\"line\"`\n\\tBucket        string  `json:\"bucket\"`\n\\tReason        string  `json:\"reason\"`\n\\tWinnerArrival *winnerArrival `json:\"winner_arrival,omitempty\"`\n\\tEvent         rawJSON `json:\"event\"`\n}'''\ns = s.replace(old, new)\np.write_text(s)\n\n# Patch digest stats"]
[10727.323393, "i", " condition to first-arrival only for back-compat.\np = Path('cli.go')\ns = p.read_text()\ns = s.replace('if cfg.dedupPolicySet && cfg.auditLog != \"\" {', 'if cfg.dedupPolicySet && cfg.auditLog != \"\" && cfg.dedupPolicy == \"first-arrival\" {')\np.write_text(s)\nPY\n"]
