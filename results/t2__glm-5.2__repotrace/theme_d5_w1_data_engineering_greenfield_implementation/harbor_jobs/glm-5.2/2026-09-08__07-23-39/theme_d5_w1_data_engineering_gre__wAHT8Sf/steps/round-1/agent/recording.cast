[9065.096552, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n"]
[9065.096594, "o", "     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"regexp\"\r\n     9\t\t\"sort\"\r\n    10\t\t\"strconv\"\r\n    11\t\t\"strings\"\r\n    12\t\t\"time\"\r\n    13\t)"]
[9065.096727, "o", "\r\n    14\t\r\n    15\tvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n    16\t\r\n    17\ttype cliConfig struct {\r\n    18\t\tinputDir          string\r\n    19\t\tratesPath         string\r\n    20\t\toutputPath        string\r\n    21\t\trejectsPath       string\r\n    22\t\tsessionGap        int\r\n    23\t\twatermarkLag      int\r\n    24\t\tstateIn           string\r\n    25\t\tstateOut          string\r\n    26\t\tpendingTTL        int\r\n    27\t\tmaxOpenSessions   int\r\n    28\t\tauditLog          string\r\n    29\t\tauditLogDigest    string\r\n"]
[9065.09681, "o", "    30\t\tratesStrict       bool\r\n    31\t\tratesMaxStaleness int\r\n    32\t\tingestID          string\r\n    33\t\tingestIDSet       bool\r\n    34\t\toutManifest       string\r\n    35\t\tmanifestSignature string\r\n    36\t}\r\n    37\t\r\n    38\tfunc main() {\r\n    39\t\tcfg, err := parseArgs(os.Args[1:])\r\n    40\t\tif err != nil {\r\n    41\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    42\t\t\tos.Exit(2)\r\n"]
[9065.096882, "o", "    43\t\t}\r\n    44\t\tif err := run(cfg); err != nil {\r\n    45\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    46\t\t\tos.Exit(1)\r\n    47\t\t}\r\n    48\t}\r\n    49\t\r\n    50\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n    51\t\tdefer func() {\r\n    52\t\t\tif r := recover(); r != nil {\r\n"]
[9065.096951, "o", "    53\t\t\t\tcfg = cliConfig{}\r\n    54\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n    55\t\t\t}\r\n    56\t\t}()\r\n    57\t\tcfg = cliConfig{\r\n    58\t\t\tsessionGap:        600,\r\n    59\t\t\twatermarkLag:      300,\r\n    60\t\t\tpendingTTL:        86400,\r\n    61\t\t\tmaxOpenSessions:   100000,\r\n    62\t\t\tratesMaxStaleness: 0,\r\n    63\t"]
[9065.097021, "o", "\t}\r\n    64\t\trequired := map[string]bool{\r\n    65\t\t\t\"--input-dir\": false,\r\n    66\t\t\t\"--rates\":     false,\r\n    67\t\t\t\"--output\":    false,\r\n    68\t\t\t\"--rejects\":   false,\r\n    69\t\t}\r\n    70\t\tif len(args) > 0 && args[0] == \"ingest\" {\r\n    71\t\t\targs = args[1:]\r\n    72\t\t}\r\n"]
[9065.097104, "o", "    73\t\tfor i := 0; i < len(args); i++ {\r\n    74\t\t\targ := args[i]\r\n    75\t\t\tswitch arg {\r\n    76\t\t\tcase \"--input-dir\":\r\n    77\t\t\t\tcfg.inputDir = nextArg(args, &i)\r\n    78\t\t\tcase \"--rates\":\r\n    79\t\t\t\tcfg.ratesPath = nextArg(args, &i)\r\n    80\t\t\tcase \"--output\":\r\n    81\t\t\t\tcfg.outputPath = nextArg(args, &i)\r\n    82\t\t\tcase \"--rejects\":\r\n    83\t\t\t\t"]
[9065.097173, "o", "cfg.rejectsPath = nextArg(args, &i)\r\n    84\t\t\tcase \"--session-gap\":\r\n    85\t\t\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\r\n    86\t\t\tcase \"--watermark-lag\":\r\n    87\t\t\t\tcfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")\r\n    88\t\t\tcase \"--state-in\":\r\n    89\t\t\t\tcfg.stateIn = nextArg(args, &i)\r\n    90\t\t\tcase \"--state-out\":\r\n    91\t\t\t\tcfg.stateOut = nextArg(args, &i)\r\n"]
