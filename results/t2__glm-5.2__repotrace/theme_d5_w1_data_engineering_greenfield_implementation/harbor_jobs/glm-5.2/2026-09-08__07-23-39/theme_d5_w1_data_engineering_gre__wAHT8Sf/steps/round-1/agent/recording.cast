[10891.140829, "o", "   231\t\tvar auditEntries []auditLogEntry\r\n   232\t\r\n   233\t\t// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.\r\n   234\t\tfor _, raw := range events {\r\n   235\t\t\tctx := newContext(raw)\r\n   236\t\t\tbucket := \"invalid\"\r\n   237\t\t\treason := \"\"\r\n   238\t\t\tvar ev *Event\r\n   239\t\t\tif raw.Invalid {\r\n   240\t\t\t\tbucket = \"invalid\"\r\n   241\t\t\t\treason = \"invalid_json\"\r\n   242\t\t\t} else {\r\n   243\t\t\t\tev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)\r\n   244\t\t\t\tif ev != nil {\r\n   245\t\t\t\t\tif seen[ev.ID] {\r\n   246\t\t\t\t\t\tbucket = \"duplicate\"\r\n   247\t\t\t\t\t\treason = \"cross_run\"\r\n   248\t\t\t\t\t\tev = nil\r\n   249\t\t\t\t\t} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {\r\n   250\t\t\t\t\t\tbucket = \"late\"\r\n   251\t\t\t\t\t\treason = \"late\"\r\n   252\t\t\t\t\t\tev = nil\r\n"]
