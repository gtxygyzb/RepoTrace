[16534.017405, "o", "\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksession\u001b[m\u001b[K-gap\":\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.\u001b[01;31m\u001b[Ksession\u001b[m\u001b[KGap = atoiOrError(nextArg(args, &i), \"--\u001b[01;31m\u001b[Ksession\u001b[m\u001b[K-gap\")\r\n\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--max-open-\u001b[01;31m\u001b[Ksession\u001b[m\u001b[Ks\":\r\n\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-\u001b[01;31m\u001b[Ksession\u001b[m\u001b[Ks\")\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out\":\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut = nextArg(args, &i)\r\n\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut == \"\" {\r\n\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out: value must be non-empty\")\r\n"]
[16534.017469, "o", "\u001b[32m\u001b[K162\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-digest\":\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest = nextArg(args, &i)\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest == \"\" {\r\n\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-digest: value must be non-empty\")\r\n\u001b[32m\u001b[K167\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-strict\":\r\n\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaStrict = true\r\n"]
[16534.017529, "o", "\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-index\":\r\n\u001b[32m\u001b[K170\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaIndex = nextArg(args, &i)\r\n\u001b[32m\u001b[K171\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaIndex == \"\" {\r\n\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-index: value must be non-empty\")\r\n"]
[16534.017591, "o", "\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest != \"\" && cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut == \"\" {\r\n\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-digest requires --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out\")\r\n\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaStrict && cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut == \"\" {\r\n\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-strict requires --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out\")\r\n\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaIndex != \"\" && (cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut == \"\" || cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest == \"\") {\r\n"]
[16534.017654, "o", "\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-index requires --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out and --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-digest\")\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut != \"\" && !parentDirExists(cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut) {\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out parent directory does not exist\")\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest != \"\" && !parentDirExists(cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest) {\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-digest parent directory does not exist\")\r\n"]
[16534.017742, "o", "\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaIndex != \"\" && !parentDirExists(cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaIndex) {\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-index parent directory does not exist\")\r\n"]
