[16470.906674, "o", "\u001b[36m\u001b[K:\u001b[m\u001b[K\t// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K404\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tgroups := map[string][]int{}\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K405\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor i, c := range candidates {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif c.ev != nil {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tgroups[c.ev.ID] = append(groups[c.ev.ID], i)\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t}\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t}\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\twinnerSet := map[int]bool{}\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\twinners := map[string]int{}\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar dedupPolicyStats dedupPolicyStats\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K413\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tdedup"]
[16470.906744, "o", "PolicyStats.Policy = cfg.dedupPolicy\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K414\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor id, idxs := range groups {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K415\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif len(idxs) < 2 {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K416\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif len(idxs) == 1 {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K417\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\twinners[id] = idxs[0]\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K418\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\twinnerSet[idxs[0]] = true\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t}\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcontinue\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t}\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\twinner := idxs[0]\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\ttiebreak := false\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K424\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor _, idx := range idxs[1:] {\r\n\u001b[35m\u001b[Kcli."]
