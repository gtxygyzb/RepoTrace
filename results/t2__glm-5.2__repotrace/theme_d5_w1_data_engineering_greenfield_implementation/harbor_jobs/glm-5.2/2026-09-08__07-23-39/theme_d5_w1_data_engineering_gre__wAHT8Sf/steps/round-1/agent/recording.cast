[13895.856112, "o", "\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tf, err := parseRateNumber(currencies[currency])\r\n\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif err != nil {\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn nil, fmt.Errorf(\"ingest: \u001b[01;31m\u001b[Krates\u001b[m\u001b[K.json: non-numeric rate for %s/%s\", day, currency)\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n"]
[13895.856178, "o", "\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif rt.\u001b[01;31m\u001b[Kdays\u001b[m\u001b[K[day] == nil {\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\trt.\u001b[01;31m\u001b[Kdays\u001b[m\u001b[K[day] = map[string]float64{}\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\trt.\u001b[01;31m\u001b[Kdays\u001b[m\u001b[K[day][currency] = f\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\trt.known[currency] = true\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tbaseRaw, baseOk := top[\"base\"]\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif !baseOk {\r\n\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn nil, errors.New(\"ingest: \u001b[01;31m\u001b[Krates\u001b[m\u001b[K.json: base required\")\r\n"]
[13895.856256, "o", "\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tvar base string\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif err := json.Unmarshal(baseRaw, &base); err != nil || base == \"\" {\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn nil, errors.New(\"ingest: \u001b[01;31m\u001b[Krates\u001b[m\u001b[K.json: base required\")\r\n\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\trt.base = base\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif base != \"USD\" {\r\n\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t"]
[13895.856316, "o", "return nil, errors.New(\"\u001b[01;31m\u001b[Kfx\u001b[m\u001b[K base must be USD\")\r\n\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfor _, day := range sortedKeys(rt.\u001b[01;31m\u001b[Kdays\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tr, ok := rt.\u001b[01;31m\u001b[Kdays\u001b[m\u001b[K[day][base]\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif !ok || r != 1.0 {\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn nil, fmt.Errorf(\"ingest: \u001b[01;31m\u001b[Krates\u001b[m\u001b[K.json: base currency %s must have rate 1.0 on day %s\", base, day)\r\n"]
