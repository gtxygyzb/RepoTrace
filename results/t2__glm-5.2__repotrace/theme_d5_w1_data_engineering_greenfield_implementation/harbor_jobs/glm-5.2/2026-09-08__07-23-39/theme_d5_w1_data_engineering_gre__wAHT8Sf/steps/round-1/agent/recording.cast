[18115.748323, "o", "\tif cfg.fixedWindowSet && cfg.sessionPolicy == \"gap\" {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --fixed-window-seconds requires --session-policy fixed-window or hybrid\")\r\n\t}\r\n\tif cfg.sessionPolicy == \"fixed-window\" && !cfg.fixedWindowSet {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --session-policy fixed-window requires --fixed-window-seconds\")\r\n\t}\r\n\tif cfg.sessionPolicy == \"hybrid\" && !cfg.fixedWindowSet {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --session-policy hybrid requires --fixed-window-seconds\")\r\n\t}\r\n\tif cfg.fixedWindowSet && cfg.fixedWindowSeconds < 1 {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --fixed-window-seconds: must be a positive integer\")\r\n\t}\r\n\treturn cfg, nil\r\n}\r\n\r\nfunc nextArg(args []string, i *int) string {\r\n"]
[18115.748468, "o", "\tif *i+1 >= len(args) {\r\n\t\tpanic(fmt.Errorf(\"ingest: missing value for %s\", args[*i]))\r\n\t}\r\n\t*i++\r\n\treturn args[*i]\r\n}\r\n\r\nfunc atoiOrError(s, flag string) int {\r\n\tn, err := strconv.Atoi(s)\r\n\tif err != nil {\r\n\t\tpanic(fmt.Errorf(\"ingest: invalid integer for %s: %s\", flag, s))\r\n\t}\r\n\treturn n\r\n}\r\n\r\nfunc computeSessionCount(evs []*Event, policy string, gap, windowSecs int) int {\r\n\tif len(evs) == 0 {\r\n\t\treturn 0\r\n\t}\r\n\tcount := 1\r\n\tvar anchor int64\r\n\tif policy == \"fixed-window\" || policy == \"hybrid\" {\r\n\t\tanchor = floorEpochToWindow(evs[0].TS.Unix(), int64(windowSecs))\r\n\t}\r\n\tfor i := 1; i < len(evs); i++ {\r\n\t\tsplit := false\r\n\t\tif policy == \"gap\" || policy == \"hybrid\" {\r\n\t\t\tif evs[i].TS.Sub(evs[i-1].TS) > time.Duration(gap)*time.Second {\r\n\t\t\t\tsplit = true\r\n\t\t\t}\r\n\t\t}\r\n\t\tif policy == \"fixed-window\" || policy == \"hybrid\" {\r\n\t\t\tkPrev := floorDiv(evs[i-1].TS.Unix()-anchor, int64(windowSecs))\r\n\t\t\tkCur := floorDiv(evs[i].TS.Unix()-anchor, int64(windowSecs))\r\n\t\t\tif kPrev != kCur {\r\n\t\t\t\tsplit = true\r\n\t\t\t}\r\n\t\t}\r\n\t\tif split {\r\n\t"]
[18115.748546, "o", "\t\tcount++\r\n\t\t}\r\n\t}\r\n\treturn count\r\n}\r\n\r\nfunc floorEpochToWindow(epoch, window int64) int64 {\r\n\tif window <= 0 {\r\n\t\treturn 0\r\n\t}\r\n\treturn floorDiv(epoch, window) * window\r\n}\r\n\r\nfunc floorDiv(a, b int64) int64 {\r\n\tif b == 0 {\r\n\t\treturn 0\r\n\t"]
[18115.748611, "o", "}\r\n\tq := a / b\r\n\tif (a%b != 0) && ((a < 0) != (b < 0)) {\r\n\t\tq--\r\n\t}\r\n\treturn q\r\n}\r\n\r\nfunc ptrCutoff(c cutoffObject) *cutoffObject {\r\n\treturn &c\r\n}\r\n\r\nfunc run(cfg cliConfig) error {\r\n\tratesData, err := os.ReadFile(cfg.ratesPath)\r\n\t"]
[18115.748673, "o", "if err != nil {\r\n\t\treturn fmt.Errorf(\"ingest: rates: %w\", err)\r\n\t}\r\n\tratesDigest := sha256Hex(ratesData)\r\n\trt, err := loadRates(cfg.ratesPath)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tvar st *loadedState\r\n\trunIndex := 1\r\n\tif cfg.stateIn != \"\" {\r\n"]
[18115.74873, "o", "\t\tst, err = loadState(cfg.stateIn, cfg.stateStrict)\r\n\t\tif err != nil && !os.IsNotExist(err) {\r\n\t\t\treturn err\r\n\t\t}\r\n\t\tif st != nil {\r\n\t\t\trunIndex = st.runIndex + 1\r\n\t\t}\r\n\t}\r\n\tevents, blanks, shards, err := readInputEvents(cfg.inputDir)\r\n"]
[18115.748786, "o", "\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tseen := map[string]bool{}\r\n\tif st != nil {\r\n\t\tfor k, v := range st.seenIds {\r\n\t\t\tseen[k] = v\r\n\t\t}"]
[18115.748862, "o", "\r\n\t}\r\n\tvar pending []pendingEntry\r\n\topenSessions := map[string]carriedSession{}\r\n\tif st != nil {\r\n\t\tpending = append([]pendingEntry(nil), st.pending...)\r\n\t\tfor k, v := range st.openSessions {\r\n\t\t\topenSessions[k] = v\r\n\t\t}\r\n\t}\r\n\tbucketCounts := map[string]int{\"accepted\": 0, \"duplicate\": 0, \"invalid\": 0, \"late\": 0, \"unresolved_chargeback\": 0}\r\n\tinvalidReasons := map[string]int{}\r\n"]
[18115.748925, "o", "\tduplicateReasons := map[string]int{\"same_run\": 0, \"cross_run\": 0}\r\n\tfxFallbackStats := map[string]int{\"0\": 0}\r\n\tshardAccepted := map[string]int{}\r\n\tvar minTs, maxTs time.Time\r\n\thasMin, hasMax := false, false\r\n\tvar watermark time.Time\r\n\thasWatermark := false\r\n\tif st != nil {\r\n\t\twatermark = st.maxTs\r\n\t\thasWatermark = st.hasMax\r\n\t}\r\n\r\n\t"]
[18115.748983, "o", "type candidate struct {\r\n\t\traw       rawEvent\r\n\t\tctx       *eventContext\r\n\t\tev        *Event\r\n\t\tduplicate bool\r\n\t}\r\n\tvar candidates []candidate\r\n\tvar auditEntries []auditLogEntry\r\n\r\n"]
[18115.749042, "o", "\t// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.\r\n\tfor _, raw := range events {\r\n\t\tctx := newContext(raw)\r\n\t\tbucket := \"invalid\"\r\n\t\treason := \"\"\r\n\t\tvar ev *Event\r\n\t\tvar lateCutoff *cutoffObject\r\n\t\tvar lateLag, lateBySec *int\r\n\t\tif raw.Invalid {\r\n\t\t\tbucket = \"invalid\"\r\n\t\t\treason = \"invalid_json\"\r\n"]
[18115.749103, "o", "\t\t} else {\r\n\t\t\tev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)\r\n\t\t\tif ev != nil {\r\n\t\t\t\tif seen[ev.ID] {\r\n\t\t\t\t\tbucket = \"duplicate\"\r\n\t\t\t\t\treason = \"cross_run\"\r\n\t\t\t\t\tev = nil\r\n"]
[18115.749161, "o", "\t\t\t\t} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {\r\n\t\t\t\t\tbucket = \"late\"\r\n\t\t\t\t\treason = \"late\"\r\n\t\t\t\t\tcutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)\r\n\t\t\t\t\tlateCutoff = ptrCutoff(formatCutoffObject(cutoff))\r\n\t\t\t\t\tif cfg.strictLateAudit {\r\n\t\t\t\t\t\tlag := cfg.watermarkLag\r\n"]
[18115.749231, "o", "\t\t\t\t\t\tlateBy := int(lateCutoff.EpochSeconds - int(epochSeconds(ev.TS)))\r\n\t\t\t\t\t\tlateLag = &lag\r\n\t\t\t\t\t\tlateBySec = &lateBy\r\n\t\t\t\t\t}\r\n\t\t\t\t\tev = nil\r\n\t\t\t\t} else {\r\n\t\t\t\t\tbucket = \"accepted\"\r\n\t\t\t\t\t"]
[18115.749287, "o", "if ev.TS.After(watermark) {\r\n\t\t\t\t\t\twatermark = ev.TS\r\n\t\t\t\t\t\thasWatermark = true\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tbucket = \"invalid\"\r\n\t\t\t}\r\n"]
[18115.749342, "o", "\t\t}\r\n\t\tif bucket == \"invalid\" {\r\n\t\t\tinvalidReasons[reason]++\r\n\t\t}\r\n\t\tbucketCounts[bucket]++\r\n\t\tif bucket == \"duplicate\" && reason == \"cross_run\" {\r\n\t\t\tduplicateReasons[\"cross_run\"]++\r\n\t\t}\r\n\t"]
[18115.749401, "o", "\tcandidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})\r\n\t\tauditEntries = append(auditEntries, auditLogEntry{\r\n\t\t\tShard:               raw.Shard,\r\n\t\t\tLine:                raw.Line,\r\n\t\t\tID:                  ctx.IDStr(),\r\n\t\t\tTS:                  ctx.TSString(),\r\n\t\t\tType:                ctx.TypeString(),\r\n\t\t\tBucket:              bucket,\r\n\t\t\tReason:              reason,\r\n"]
[18115.74946, "o", "\t\t\tEvent:               raw.Raw,\r\n\t\t\tCutoff:              lateCutoff,\r\n\t\t\tWatermarkLagSeconds: lateLag,\r\n\t\t\tLateBySeconds:       lateBySec,\r\n\t\t})\r\n\t}\r\n\r\n\t// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.\r\n\tgroups := map[string][]int{}\r\n"]
[18115.749519, "o", "\tfor i, c := range candidates {\r\n\t\tif c.ev != nil {\r\n\t\t\tgroups[c.ev.ID] = append(groups[c.ev.ID], i)\r\n\t\t}\r\n\t}\r\n\twinnerSet := map[int]bool{}\r\n\twinners := map[string]int{}\r\n\tvar dedupPolicyStats dedupPolicyStats\r\n\tdedupPolicyStats.Policy = cfg.dedupPolicy\r\n\tfor id, idxs := range groups {\r\n\t\tif len(idxs) < 2 {\r\n\t\t\tif len(idxs) == 1 {\r\n"]
[18115.749574, "o", "\t\t\t\twinners[id] = idxs[0]\r\n\t\t\t\twinnerSet[idxs[0]] = true\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\twinner := idxs[0]\r\n\t\ttiebreak := false\r\n\t\tfor _, idx := range idxs[1:] {\r\n\t\t\t"]
[18115.749637, "o", "if cfg.dedupPolicy == \"first-arrival\" {\r\n\t\t\t\tif arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n\t\t\t\t\twinner = idx\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tcts := candidates[idx].ctx.TSString()\r\n\t\t\t\twts := candidates[winner].ctx.TSString()\r\n\t\t\t\tif cts > wts {\r\n\t\t\t\t\twinner = idx\r\n\t"]
[18115.749693, "o", "\t\t\t\ttiebreak = false\r\n\t\t\t\t} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n\t\t\t\t\twinner = idx\r\n\t\t\t\t\ttiebreak = true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n"]
[18115.74975, "o", "\t\tif cfg.dedupPolicy == \"lex-largest-ts\" {\r\n\t\t\twts := candidates[winner].ctx.TSString()\r\n\t\t\tfor _, idx := range idxs {\r\n\t\t\t\tif idx != winner && candidates[idx].ctx.TSString() == wts {\r\n\t\t\t\t\ttiebreak = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n"]
[18115.749807, "o", "\t\twinners[id] = winner\r\n\t\twinnerSet[winner] = true\r\n\t\tsameShard := true\r\n\t\tfor _, idx := range idxs {\r\n\t\t\tif candidates[idx].ev.Shard != candidates[winner].ev.Shard {\r\n\t\t\t\tsameShard = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n"]
[18115.749864, "o", "\t\t}\r\n\t\tif sameShard {\r\n\t\t\tdedupPolicyStats.DuplicateWinnersSameShard++\r\n\t\t\tif cfg.dedupPolicy == \"first-arrival\" || tiebreak {\r\n\t\t\t\tdedupPolicyStats.DuplicateWinnersLineTiebreak++\r\n\t\t\t}\r\n\t\t} else {\r\n"]
[18115.749919, "o", "\t\t\tdedupPolicyStats.DuplicateWinnersCrossShard++\r\n\t\t}\r\n\t}\r\n\r\n\t// Finalize accepted/duplicate buckets and outputs in arrival order.\r\n\thasMin, hasMax = false, false\r\n\tfor _, c := range candidates {\r\n\t\tif c.ev != nil {\r\n\t\t\tseen[c.ev.ID] = true\r\n\t\t}\r\n"]
[18115.749977, "o", "\t}\r\n\tbucketCounts[\"accepted\"] = 0\r\n\tbucketCounts[\"duplicate\"] = duplicateReasons[\"cross_run\"]\r\n\tfor i, c := range candidates {\r\n\t\t_ = i\r\n\t\tif c.ev == nil {\r\n\t\t\tcontinue\r\n"]
[18115.750033, "o", "\t\t}\r\n\t\tif winnerSet[i] {\r\n\t\t\tbucketCounts[\"accepted\"]++\r\n\t\t\tshardAccepted[c.ev.Shard]++\r\n\t\t\tif !hasMin || c.ev.TS.Before(minTs) {\r\n\t\t\t\tminTs = c.ev.TS\r\n\t\t\t\thasMin = true\r\n\t\t\t}\r\n\t\t\tif !hasMax || c.ev.TS.After(maxTs) {\r\n\t\t\t\tmaxTs = c.ev.TS\r\n"]
[18115.750089, "o", "\t\t\t\thasMax = true\r\n\t\t\t}\r\n\t\t\t_ = pending\r\n\t\t\t_ = openSessions\r\n\t\t} else {\r\n\t\t\tbucketCounts[\"duplicate\"]++\r\n\t\t\tduplicateReasons[\"same_run\"]++\r\n\t\t\tentry := auditEntries[i]\r\n\t"]
[18115.750145, "o", "\t\tentry.Bucket = \"duplicate\"\r\n\t\t\tentry.Reason = \"same_run\"\r\n\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n\t\t\t\tw := winners[entry.ID]\r\n\t\t\t\tentry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}\r\n\t\t\t}\r\n\t\t\tauditEntries[i] = entry\r\n\t\t}\r\n\t}\r\n"]
[18115.750218, "o", "\r\n\t// Collect surviving (accepted winner) events for session summary.\r\n\tsurvivingByUser := map[string][]*Event{}\r\n\tfor i, c := range candidates {\r\n\t\tif c.ev != nil && winnerSet[i] {\r\n\t\t\tsurvivingByUser[c.ev.UserID] = append(survivingByUser[c.ev.UserID], c.ev)\r\n\t\t}\r\n\t}\r\n\tfor u := range survivingByUser {\r\n\t\tevs := survivingByUser[u]\r\n"]
[18115.750276, "o", "\t\tsort.SliceStable(evs, func(i, j int) bool {\r\n\t\t\treturn evs[i].TS.Before(evs[j].TS)\r\n\t\t})\r\n\t\tsurvivingByUser[u] = evs\r\n\t}\r\n\tsessionTotal := 0\r\n\tbyUser := make([]summarySessionUser, 0, len(survivingByUser))\r\n"]
[18115.750339, "o", "\tfor _, u := range sortedKeys(survivingByUser) {\r\n\t\tevs := survivingByUser[u]\r\n\t\tsessionTotal += computeSessionCount(evs, cfg.sessionPolicy, cfg.sessionGap, cfg.fixedWindowSeconds)\r\n\t\tbyUser = append(byUser, summarySessionUser{User: u, Count: len(evs)})\r\n\t}\r\n\r\n\tvar rejectRecords []rejectRecord\r\n\tfor i, c := range candidates {\r\n\t\tif c.ev == nil {\r\n\t\t\tr := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, shard: c.raw.Shard, line: c.raw.Line, raw: c.raw.Raw}\r\n\t\t\trejectRecords = append(rejectRecords, r)\r\n"]
[18115.750401, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tif winnerSet[i] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tr := rejectRecord{bucket: \"duplicate\", reason: \"same_run\", shard: c.raw.Shard, line: c.raw.Line, raw: c.raw.Raw}\r\n\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n\t\t\t"]
[18115.750459, "o", "r.winner = true\r\n\t\t\tr.winnerShard = candidates[winners[c.ev.ID]].ev.Shard\r\n"]
