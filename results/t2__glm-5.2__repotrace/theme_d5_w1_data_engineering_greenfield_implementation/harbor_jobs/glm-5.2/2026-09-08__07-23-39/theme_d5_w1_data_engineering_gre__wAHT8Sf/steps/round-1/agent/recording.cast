[16527.771489, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n"]
[16527.771581, "o", "     6\t\t\"errors\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"math\"\r\n     9\t\t\"os\"\r\n    10\t\t\"path/filepath\"\r\n    11\t\t\"sort\"\r\n    12\t\t\"time\"\r\n    13\t)\r\n    14\t\r\n    15\tvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--state-strict] [--audit-log <path>] [--audit-log-digest <path>] [--audit-log-rotate-bytes <int>] [--rates-strict] [--rates-max-staleness <seconds>] [--ingest-id <string>] [--out-parquet-manifest <path>] [--manifest-signature <path>] [--dedup-policy <first-arrival|lex-largest-ts>] [--strict-late-audit] [--summary-schema-out <path>] [--summary-schema-digest <path>] [--summary-schema-strict] [--summary-schema-index <path>] [--rejects-format <legacy|tagged|tagged-sorted>] [--rejects-format-header]\\n\"\r\n    16\t\r\n    17\ttype Money float64\r\n"]
[16527.771656, "o", "    18\t\r\n    19\tfunc (m Money) MarshalJSON() ([]byte, error) {\r\n    20\t\treturn []byte(m.String()), nil\r\n    21\t}\r\n    22\t\r\n    23\tfunc (m Money) String() string {\r\n    24\t\tf := float64(m)\r\n    25\t\tabs := math.Abs(f)\r\n    26\t\tcents := int64(math.Floor(abs*100.0 + 0.5))\r\n    27\t\tneg := f < 0 && cents != 0\r\n"]
[16527.771718, "o", "    28\t\tdollars := cents / 100\r\n    29\t\trem := cents % 100\r\n    30\t\ts := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n    31\t\tif neg {\r\n    32\t\t\ts = \"-\" + s\r\n    33\t\t}\r\n    34\t\treturn s\r\n    35\t}\r\n    36\t\r\n    37"]
[16527.771777, "o", "\ttype Event struct {\r\n    38\t\tID                string\r\n    39\t\tType              string\r\n    40\t\tTS                time.Time\r\n    41\t\tUserID            string\r\n    42\t\tAmount            float64\r\n    43\t\tCurrency          string\r\n    44\t\tRefID             string\r\n"]
[16527.771835, "o", "    45\t\tUSD               float64\r\n    46\t\tRefUSD            float64\r\n    47\t\tFXFallbackDays    int\r\n    48\t\tResolvedAgainst   *string\r\n    49\t\tResolvedOriginRun int\r\n    50\t\tSessionIndex      int\r\n    51\t\tRaw               rawJSON\r\n    52\t\tShard             string\r\n    53\t"]
[16527.771893, "o", "\tLine              int\r\n    54\t}\r\n    55\t\r\n    56\ttype Reject struct {\r\n    57\t\tBucket int     `json:\"bucket\"`\r\n    58\t\tEvent  rawJSON `json:\"event\"`\r\n    59\t}\r\n    60\t\r\n    61\ttype ShardLine struct {\r\n    62\t\t"]
[16527.771953, "o", "Shard string\r\n    63\t\tLine  int\r\n    64\t\tData  []byte\r\n    65\t}\r\n    66\t\r\n    67\ttype RateTable struct {\r\n    68\t\tbase  string\r\n    69\t\tdays  map[string]map[string]float64\r\n    70\t\tknown map[string]bool\r\n    71\t}\r\n"]
[16527.772009, "o", "    72\t\r\n    73\tfunc newRateTable() *RateTable {\r\n    74\t\treturn &RateTable{base: \"USD\", days: map[string]map[string]float64{}, known: map[string]bool{}}\r\n    75\t}\r\n    76\t\r\n    77\tfunc isUsableRate(f float64) bool {\r\n    78\t\treturn isFinite(f) && f > 0\r\n    79\t}\r\n"]
[16527.772071, "o", "    80\t\r\n    81\tfunc parseRateNumber(raw json.RawMessage) (float64, error) {\r\n    82\t\tif bytes.Equal(bytes.TrimSpace(raw), []byte(\"null\")) {\r\n    83\t\t\treturn 0, errors.New(\"non-numeric rate\")\r\n    84\t\t}\r\n    85\t\tvar f float64\r\n    86\t\tif err := json.Unmarshal(raw, &f); err != nil {\r\n    87\t\t\treturn 0, errors.New(\"non-numeric rate\")\r\n    88"]
[16527.772129, "o", "\t\t}\r\n    89\t\treturn f, nil\r\n    90\t}\r\n    91\t\r\n    92\tfunc sortedKeys[T any](m map[string]T) []string {\r\n    93\t\tkeys := make([]string, 0, len(m))\r\n    94\t\tfor k := range m {\r\n    95\t\t\tkeys = append(keys, k)\r\n    96\t\t}\r\n    97\t\tsort.Strings(keys)\r\n"]
[16527.772186, "o", "    98\t\treturn keys\r\n    99\t}\r\n   100\t\r\n   101\tfunc isStrictDate(s string) bool {\r\n   102\t\tif len(s) != 10 {\r\n   103\t\t\treturn false\r\n   104\t\t}\r\n   105\t\tfor i, c := range s {\r\n"]
[16527.772251, "o", "   106\t\t\tif i == 4 || i == 7 {\r\n   107\t\t\t\tif c != '-' {\r\n   108\t\t\t\t\treturn false\r\n   109\t\t\t\t}\r\n   110\t\t\t\tcontinue\r\n   111\t\t\t}\r\n   112\t\t\tif c < '0' || c > '9' {\r\n"]
[16527.772309, "o", "   113\t\t\t\treturn false\r\n   114\t\t\t}\r\n   115\t\t}\r\n   116\t\treturn true\r\n   117\t}\r\n   118\t\r\n   119\tfunc dayEpoch(date string) time.Time {\r\n   120\t\tt, err := time.Parse(\"2006-01-02\", date)\r\n"]
