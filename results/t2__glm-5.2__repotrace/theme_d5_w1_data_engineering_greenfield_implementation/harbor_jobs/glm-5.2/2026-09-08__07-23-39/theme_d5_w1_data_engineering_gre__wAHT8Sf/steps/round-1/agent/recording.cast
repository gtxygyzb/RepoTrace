[9220.149038, "o", "    98\ttype summaryOutput struct {\r\n    99\t\tTotalEvents    int            `json:\"total_events\"`\r\n   100\t\tAcceptedEvents int            `json:\"accepted_events\"`\r\n   101\t\tRejectedEvents int            `json:\"rejected_events\"`\r\n   102\t\tTotalUSD       Money          `json:\"total_usd\"`\r\n   103\t\tAnomalies      map[string]int `json:\"anomalies\"`\r\n   104\t\tRunIndex       int            `json:\"run_index\"`\r\n"]
[9220.149102, "o", "   105\t\tWatermark      *string        `json:\"watermark\"`\r\n   106\t}\r\n   107\t\r\n   108\ttype auditLogEntry struct {\r\n   109\t\tShard  string  `json:\"shard\"`\r\n   110\t\tLine   int     `json:\"line\"`\r\n   111\t\tID     string  `json:\"id\"`\r\n   112\t\tTS     string  `json:\"ts\"`\r\n   113\t\tType   string  `json:\"type\"`\r\n   114\t\tBucket string  `json:\"bucket\"`\r\n"]
[9220.149173, "o", "   115\t\tReason string  `json:\"reason\"`\r\n   116\t\tEvent  rawJSON `json:\"event\"`\r\n   117\t}\r\n   118\t\r\n   119\ttype auditDigestOutput struct {\r\n   120\t\tSchemaVersion string         `json:\"schema_version\"`\r\n   121\t\tRatesDigest   string         `json:\"rates_digest\"`\r\n   122\t\tBucketCounts  map[string]int `json:\"bucket_counts\"`\r\n   123\t\tEventCount    int            `json:\"event_count\"`\r\n   124\t}\r\n"]
[9220.149246, "o", "   125\t\r\n   126\ttype manifestOutput struct {\r\n   127\t\tSchemaVersion string          `json:\"schema_version\"`\r\n   128\t\tIngestID      *string         `json:\"ingest_id\"`\r\n   129\t\tRunIndex      int             `json:\"run_index\"`\r\n   130\t\tRatesDigest   string          `json:\"rates_digest\"`\r\n   131\t\tInputShards   []manifestShard `json:\"input_shards\"`\r\n   132\t\tOutputs       manifestOutputs `json:\"outputs\"`"]
[9220.149347, "o", "\r\n   133\t\tWindow        manifestWindow  `json:\"window\"`\r\n   134\t}\r\n   135\t\r\n   136\ttype manifestShard struct {\r\n   137\t\tShard          string `json:\"shard\"`\r\n   138\t\tSHA256         string `json:\"sha256\"`\r\n   139\t\tBytes          int64  `json:\"bytes\"`\r\n   140\t\tEventsTotal    int    `json:\"events_total\"`\r\n   141\t\tEventsAccepted int    `json:\"events_accepted\"`\r\n   142\t}\r\n"]
[9220.149413, "o", "   143\t\r\n   144\ttype manifestFileOutput struct {\r\n   145\t\tPath        string `json:\"path\"`\r\n   146\t\tSHA256      string `json:\"sha256\"`\r\n   147\t\tSHA256Short string `json:\"sha256_short\"`\r\n   148\t\tBytes       int64  `json:\"bytes\"`\r\n   149\t}\r\n   150\t\r\n   151\ttype manifestOutputs struct {\r\n   152\t\tSummary     *manifestFileOutput `json:\"summary\"`\r\n   153\t\tRejects     *manifestFileOutput `json:\"rejects\"`\r\n   154\t\tState       *manifestFileOutput `json:\"state\"`\r\n"]
[9220.14948, "o", "   155\t\tAuditLog    *manifestFileOutput `json:\"audit_log\"`\r\n   156\t\tAuditDigest *manifestFileOutput `json:\"audit_digest\"`\r\n   157\t}\r\n   158\t\r\n   159\ttype manifestWindow struct {\r\n   160\t\tMinTs               *string        `json:\"min_ts\"`\r\n"]
[9220.149543, "o", "   161\t\tMaxTs               *string        `json:\"max_ts\"`\r\n   162\t\tEventsAcceptedTotal int            `json:\"events_accepted_total\"`\r\n   163\t\tEventsRejectedTotal int            `json:\"events_rejected_total\"`\r\n   164\t\tBucketCounts        map[string]int `json:\"bucket_counts\"`\r\n   165\t}\r\n   166\t\r\n   167\ttype signatureOutput struct {\r\n   168\t\tManifestPath   string `json:\"manifest_path\"`\r\n   169\t\tManifestSHA256 string `json:\"manifest_sha256\"`\r\n   170\t\tManifestBytes  int64  `json:\"manifest_bytes\"`\r\n   171\t\tSignedAtUTC    string `json:\"signed_at_utc\"`\r\n   172\t\tToolVersion    string `json:\"tool_version\"`\r\n"]
[9220.149604, "o", "   173\t}\r\n   174\t\r\n   175\tconst toolVersion = \"eventq/0.5.0\"\r\n   176\tconst manifestSchemaVersion = \"eventq.manifest/v1\"\r\n"]
