[12506.963424, "o", "\t\t\t\thashByPath := make(map[string]string, len(auditSegmentPaths))\r\n   506\t\t\t\tfor _, path := range auditSegmentPaths {\r\n   507\t\t\t\t\th, _, err := fileDigest(path)\r\n   508\t\t\t\t\tif err != nil {\r\n   509\t\t\t\t\t\treturn err\r\n   510\t\t\t\t\t}\r\n   511\t\t\t\t\thashByPath[path] = h\r\n   512\t\t\t\t}\r\n   513\t\t\t\torderedPaths := append([]string(nil), auditSegmentPaths...)\r\n   514\t\t\t\tfor i, j := 0, len(orderedPaths)-1; i < j; i, j = i+1, j-1 {\r\n   515\t\t\t\t\torderedPaths[i], orderedPaths[j] = orderedPaths[j], orderedPaths[i]\r\n   516\t\t\t\t}\r\n   517\t\t\t\tif len(orderedPaths) > 1 {\r\n   518\t\t\t\t\tnames := make([]string, len(orderedPaths))\r\n   519\t\t\t\t\tfor i, path := range orderedPaths {\r\n   520\t\t\t\t\t\tnames[i] = filepath.Base(path)\r\n   521\t\t\t\t\t}\r\n   522\t\t\t\t\thashes := make([]string, len(orderedPaths))\r\n   523\t\t\t\t\tfor i, path := range orderedPaths {\r\n"]
[12506.963514, "o", "   524\t\t\t\t\t\thashes[i] = hashByPath[path]\r\n   525\t\t\t\t\t}\r\n   526\t\t\t\t\tdigest.AuditLog = mustJSONStringArray(names)\r\n   527\t\t\t\t\tdigest.SHA256Segments = hashes\r\n   528\t\t\t\t} else {\r\n   529\t\t\t\t\tdigest.AuditLog = mustJSONString(filepath.Base(orderedPaths[0]))\r\n   530\t\t\t\t\tdigest.SHA256 = hashByPath[orderedPaths[0]]"]
[12506.963615, "o", "\r\n   531\t\t\t\t}\r\n   532\t\t\t} else {\r\n   533\t\t\t\tdigest.AuditLog = mustJSONString(\"\")\r\n   534\t\t\t}\r\n   535\t\t\tdata, err := json.MarshalIndent(digest, \"\", \"  \")\r\n   536\t\t\tif err != nil {\r\n   537\t\t\t\treturn err\r\n   538\t\t\t}\r\n   539\t\t\tdata = append(data, '\\n')\r\n   540\t\t\tif err := atomicWriteFile(cfg.auditLogDigest, data); err != nil {\r\n"]
