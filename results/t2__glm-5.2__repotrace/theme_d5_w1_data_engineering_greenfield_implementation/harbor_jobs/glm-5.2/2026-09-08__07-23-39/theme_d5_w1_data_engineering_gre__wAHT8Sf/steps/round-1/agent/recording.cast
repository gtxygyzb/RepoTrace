[20177.561876, "o", "   157\t\tbuf.WriteByte('[')\r\n   158\t\tbuf.WriteByte('\\n')\r\n   159\t\tfor i, v := range arr {\r\n   160\t\t\twriteIndent(buf, indent+1)\r\n   161\t\t\twriteOrderedIndentValue(buf, v, indent+1)\r\n   162\t\t\tif i < len(arr)-1 {\r\n   163\t\t\t\tbuf.WriteByte(',')\r\n   164\t\t\t}\r\n   165\t\t\tbuf.WriteByte('\\n')\r\n   166\t\t}\r\n   167\t\twriteIndent(buf, indent)\r\n   168\t\tbuf.WriteByte(']')\r\n   169\t}\r\n   170\t\r\n   171\tfunc writeIndent(buf *bytes.Buffer, indent int) {\r\n   172\t\tfor i := 0; i < indent; i++ {\r\n   173\t\t\tbuf.WriteString(\"  \")\r\n   174\t\t}\r\n   175\t}\r\n"]
[20177.561967, "o", "   176\t\r\n   177\tfunc marshalOrderedIndent(v any) []byte {\r\n   178\t\tvar buf bytes.Buffer\r\n   179\t\twriteOrderedIndent(&buf, v, 0)\r\n   180\t\treturn buf.Bytes()\r\n   181\t}\r\n   182\t\r\n   183\ttype summaryField struct {\r\n   184\t\tkey   string\r\n   185\t\tvalue any\r\n   186\t}\r\n   187\t\r\n   188\tfunc parseSummaryFields(data []byte) ([]summaryField, error) {\r\n   189"]
[20177.562039, "o", "\t\tdec := json.NewDecoder(bytes.NewReader(data))\r\n   190\t\tdec.UseNumber()\r\n   191\t\ttok, err := dec.Token()\r\n   192\t\tif err != nil {\r\n   193\t\t\treturn nil, err\r\n   194\t\t}\r\n   195\t\tdelim, ok := tok.(json.Delim)\r\n   196\t\tif !ok || delim != '{' {\r\n   197\t\t\treturn nil, fmt.Errorf(\"summary output is not a JSON object\")\r\n   198\t"]
[20177.56211, "o", "\t}\r\n   199\t\tvar fields []summaryField\r\n   200\t\tfor dec.More() {\r\n   201\t\t\tkeyTok, err := dec.Token()\r\n   202\t\t\tif err != nil {\r\n   203\t\t\t\treturn nil, err\r\n   204\t\t\t}\r\n   205\t\t\tkey, ok := keyTok.(string)\r\n   206\t\t\tif !ok {\r\n   207\t\t\t\treturn nil, fmt.Errorf(\"summary object key is not a string\")\r\n   208\t\t\t}\r\n"]
[20177.56217, "o", "   209\t\t\tvar val any\r\n   210\t\t\tif err := dec.Decode(&val); err != nil {\r\n   211\t\t\t\treturn nil, err\r\n   212\t\t\t}\r\n   213\t\t\tfields = append(fields, summaryField{key: key, value: val})\r\n   214\t\t}\r\n   215\t\tif _, err := dec.Token(); err != nil {\r\n   216\t\t\treturn nil, err\r\n   217"]
[20177.563648, "o", "\t\t}\r\n   218\t\treturn fields, nil\r\n   219\t}\r\n   220\t\r\n\u001b[?2004hroot@n30009:/app# "]
