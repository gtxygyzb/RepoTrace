[5543.151977, "o", "   502\t  rt := newRateTable()\r\n   503\t  for _, key := range []string{\"by_date\", \"byDate\"} {\r\n   504\t    if raw, ok := top[key]; ok {\r\n   505\t      var dates map[string]json.RawMessage\r\n   506\t      if err := json.Unmarshal(raw, &dates); err != nil {\r\n   507\t        return nil, err\r\n   508\t      }\r\n   509\t      for date, raw2 := range dates {\r\n"]
[5543.152034, "o", "   510\t        var currencies map[string]json.RawMessage\r\n   511\t        if err := json.Unmarshal(raw2, &currencies); err != nil {\r\n   512\t          return nil, err\r\n   513\t        }\r\n   514\t        for currency, raw3 := range currencies {\r\n   515\t          if currency == \"USD\" {\r\n   516\t            continue\r\n   517\t          }\r\n"]
