[8362.977631, "i", "cat > cli.go <<'EOF'\npackage main\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\n\ntype cliConfig struct {\n\tinputDir         string\n\tratesPath        string\n\toutputPath       string\n\trejectsPath      string\n\tsessionGap       int\n\twatermarkLag     int\n\tstateIn          string\n\tstateOut         string\n\tpendingTTL       int\n\tmaxOpenSessions  int\n\tauditLog         string\n\tauditLogDigest   string\n\tratesStrict       bool\n\tratesMaxStaleness int\n\tingestID          string\tingestIDSet       bool\n\toutManifest       string\n\tmanifestSignature string\n}\n\nfunc main() {\n\tcfg, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\tos.Exit(2)\n\t}\n\tif err := run(cfg); err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc parseArgs(args []string) (cliConfig, error) {\n\tcfg := cliConfig{\n\t\tsessionGap:       600,\n\t\twatermarkLag:     300,\n\t\tpendingTTL:       86400,\n\t\tm"]
[8362.977886, "i", "axOpenSessions:  100000,\n\t\tratesMaxStaleness: 0,\n\t}\n\trequired := map[string]bool{\n\t\t\"--input-dir\": false,\n\t\t\"--rates\":     false,\n\t\t\"--output\":    false,\n\t\t\"--rejects\":   false,\n\t}\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tswitch arg {\n\t\tcase \"--input-dir\":\n\t\t\tcfg.inputDir = nextArg(args, &i)\n\t\tcase \"--rates\":\n\t\t\tcfg.ratesPath = nextArg(args, &i)\n\t\tcase \"--output\":\n\t\t\tcfg.outputPath = nextArg(args, &i)\n\t\tcase \"--rejects\":\n\t\t\tcfg.rejectsPath = nextArg(args, &i)\n\t\tcase \"--session-gap\":\n\t\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\n\t\tcase \"--watermark-lag\":\n\t\t\tcfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")\n\t\tcase \"--state-in\":\n\t\t\tcfg.stateIn = nextArg(args, &i)\n\t\tcase \"--state-out\":\n\t\t\tcfg.stateOut = nextArg(args, &i)\n\t\tcase \"--pending-ttl\":\n\t\t\tcfg.pendingTTL = atoiOrError(nextArg(args, &i), \"--pending-ttl\")\n\t\tcase \"--max-open-sessions\":\n\t\t\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-sessions\")\n\t\tcase \"--audit-log\":\n\t\t\tcfg.auditLog = nex"]
