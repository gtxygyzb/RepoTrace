[14757.399973, "o", "   258\tfunc readInputEvents(inputDir string) ([]rawEvent, []inputShardInfo, error) {\r\n   259\t\tinfo, err := os.Stat(inputDir)\r\n   260\t\tif err != nil {\r\n   261\t\t\treturn nil, nil, err\r\n   262\t\t}\r\n   263\t\tif !info.IsDir() {\r\n   264\t\t\treturn nil, nil, errors.New(\"input-dir is not a directory\")\r\n   265\t\t}\r\n"]
[14757.4001, "o", "   266\t\tentries, err := os.ReadDir(inputDir)\r\n   267\t\tif err != nil {\r\n   268\t\t\treturn nil, nil, err\r\n   269\t\t}\r\n   270\t\tvar files []string\r\n   271\t\tfor _, e := range entries {\r\n   272\t\t\tif e.IsDir() || !e.Type().IsRegular() {\r\n   273\t\t\t\tcontinue\r\n   274\t\t\t}\r\n   275\t\t\tfiles = append(files, e.Name())\r\n   276\t\t}\r\n   277\t\tsort.Strings(files)\r\n   278\t\tvar events []rawEvent\r\n   279\t\tvar shards []inputShardInfo\r\n   280\t\tfor _, name := range files {\r\n   281\t\t\tdata, err := os.ReadFile(filepath.Join(inputDir, name))\r\n   282\t\t\tif err != nil {\r\n   283\t\t\t\treturn nil, nil, err\r\n   284\t\t\t}\r\n   285\t\t\tsi := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}\r\n   286\t\t\tlineNo := 0\r\n"]
[14757.400187, "o", "   287\t\t\tfor _, line := range bytes.Split(data, []byte{'\\n'}) {\r\n   288\t\t\t\tlineNo++\r\n   289\t\t\t\ttrimmed := bytes.TrimSpace(line)\r\n   290\t\t\t\tif len(trimmed) == 0 {\r\n   291\t\t\t\t\tcontinue\r\n   292\t\t\t\t}\r\n   293\t\t\t\tsi.EventsTotal++\r\n   294\t\t\t\tvar obj map[string]json.RawMessage\r\n   295\t\t\t\tinvalid := false\r\n   296\t\t\t\tif err := json.Unmarshal(trimmed, &obj); err != nil {\r\n   297\t\t\t\t\tinvalid = true\r\n"]
[14757.400289, "o", "   298\t\t\t\t}\r\n   299\t\t\t\tevents = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})\r\n   300\t\t\t}\r\n   301\t\t\tshards = append(shards, si)\r\n   302\t\t}\r\n   303\t\treturn events, shards, nil\r\n   304\t}\r\n   305\t\r\n   306\tfunc newContext(raw rawEvent) *eventContext {\r\n   307\t\tctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n   308\t\tif raw.Obj != nil {\r\n   309\t\t\tctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n   310"]
[14757.400366, "o", "\t\t\tctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n   311\t\t\tctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n   312\t\t}\r\n   313\t\treturn ctx\r\n   314\t}\r\n   315\t\r\n   316\tfunc parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {\r\n   317\t\tobj := ctx.Obj\r\n   318\t\tif obj == nil {\r\n   319\t\t\treturn nil, \"invalid_json\"\r\n   320\t\t}\r\n"]
[14757.400939, "o", "\u001b[?2004h"]
[14757.400996, "o", "root@n30009:/app# "]
[14847.677709, "i", "python3 - <<'PY'\nimport re\n\n# types.go: add Blank to rawEvent and rejectsCrossCheck type/field\ns = open('types.go').read()\ns = s.replace(\n'''type rawEvent struct {\n\\tShard   string\n\\tLine    int\n\\tRaw     rawJSON\n\\tObj     map[string]json.RawMessage\n\\tInvalid bool\n}''',\n'''type rawEvent struct {\n\\tShard   string\n\\tLine    int\n\\tRaw     rawJSON\n\\tObj     map[string]json.RawMessage\n\\tInvalid bool\n\\tBlank   bool\n}''')\n\ns = s.replace(\n'''type dedupPolicyStats struct {''',\n'''type rejectsCrossCheck struct {\n\\tRejectsRowCount        int  `json:\"rejects_row_count\"`\n\\tAuditRejectRecordCount int  `json:\"audit_reject_record_count\"`\n\\tAgree                  bool `json:\"agree\"`\n}\n\ntype dedupPolicyStats struct {''')\n\ns = s.replace(\n'''\\tRatesDigest      string            `json:\"rates_digest\"`\n\\tSHA256           string            `json:\"sha256,omitempty\"`''',\n'''\\tRatesDigest      string             `json:\"rates_digest\"`\n\\tRejectsCrossCheck *rejectsCrossCheck `json:\"rejects_cross_check,omitempty\"`\n\\tSHA256           string"]
[14847.678013, "i", "             `json:\"sha256,omitempty\"`''')\n\nopen('types.go','w').write(s)\nprint('types.go updated')\nPY\n"]
