[5493.738541, "o", "   312\t  }\r\n   313\t  var s string\r\n   314\t  if err := json.Unmarshal(raw, &s); err == nil {\r\n   315\t    return s, true, true\r\n   316\t  }\r\n   317\t  return \"\", false, true\r\n   318\t}\r\n   319\t\r\n   320\tfunc rawStringPtr(m map[string]json.RawMessage, key string) *string {\r\n   321\t  s, ok, _ := getRawString(m, key)\r\n   322\t  if !ok {\r\n   323\t    return nil\r\n   324\t  }\r\n   325\t  return &s\r\n   326\t}\r\n   327\t\r\n   328\tfunc getString(m map[string]json.RawMessage, keys ...string) (string, bool) {\r\n   329\t  for _, k := range keys {\r\n   330\t    s, ok, _ := getRawString(m, k)\r\n   331\t    if ok {\r\n   332\t      return s, true\r\n   333\t    }\r\n   334\t  }\r\n"]
[5493.738611, "o", "   335\t  return \"\", false\r\n   336\t}\r\n   337\t\r\n   338\tfunc getNumberOrString(raw json.RawMessage) (float64, error) {\r\n   339\t  trimmed := bytes.TrimSpace(raw)\r\n   340\t  if len(trimmed) == 0 {\r\n   341\t    return 0, errors.New(\"empty number\")\r\n   342\t  }\r\n   343\t  if trimmed[0] == '\"' {\r\n   344\t    var s string\r\n   345\t    if err := json.Unmarshal(trimmed, &s); err != nil {\r\n"]
[5493.73867, "o", "   346\t      return 0, err\r\n   347\t    }\r\n   348\t    s = strings.TrimSpace(s)\r\n   349\t    if parts := strings.Fields(s); len(parts) > 0 {\r\n   350\t      s = parts[0]\r\n   351\t    }\r\n   352\t    return strconv.ParseFloat(s, 64)\r\n   353\t  }\r\n   354\t  return strconv.ParseFloat(string(trimmed), 64)\r\n   355\t}\r\n   356\t\r\n   357\tfunc isFinite(f float64) bool {\r\n   358\t"]
[5493.738727, "o", "  return !math.IsInf(f, 0) && !math.IsNaN(f)\r\n   359\t}\r\n   360\t\r\n   361\tfunc getJSONInt(raw json.RawMessage) (int64, error) {\r\n   362\t  var n json.Number\r\n   363\t  if err := json.Unmarshal(raw, &n); err != nil {\r\n   364\t    return 0, err\r\n   365\t  }\r\n   366\t  s := string(n)\r\n   367\t"]
[5493.73879, "o", "  if strings.ContainsAny(s, \".eE\") {\r\n   368\t    return 0, errors.New(\"not an integer\")\r\n   369\t  }\r\n   370\t  return strconv.ParseInt(s, 10, 64)\r\n   371\t}\r\n   372\t\r\n   373\tfunc roundMoney(f float64) float64 {\r\n   374\t  abs := math.Abs(f)\r\n   375\t  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n   376\t  if f < 0 && cents != 0 {\r\n"]
[5493.73885, "o", "   377\t    return -float64(cents) / 100.0\r\n   378\t  }\r\n   379\t  return float64(cents) / 100.0\r\n   380\t}\r\n   381\t\r\n   382\tfunc jsonBytes(s string) []byte {\r\n   383\t  b, err := json.Marshal(s)\r\n   384\t  if err != nil {\r\n   385\t    return []byte(`\"\"`)\r\n   386\t  }\r\n   387\t  return b\r\n   388\t}"]
