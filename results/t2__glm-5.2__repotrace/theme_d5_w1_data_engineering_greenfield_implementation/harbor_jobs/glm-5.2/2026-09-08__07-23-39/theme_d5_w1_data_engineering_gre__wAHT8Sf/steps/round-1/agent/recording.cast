[14533.215382, "o", "   440\t\tif err := json.Unmarshal(data, &sin); err != nil {\r\n   441\t\t\treturn nil, err\r\n   442\t\t}\r\n   443\t\tst := &loadedState{\r\n   444\t\t\tversion:      sin.Version,\r\n   445\t\t\tseenIds:      map[string]bool{},\r\n   446\t\t\trunIndex:     sin.RunIndex,\r\n   447\t\t\topenSessions: map[string]carriedSession{},\r\n   448\t\t}\r\n   449\t\t"]
[14533.215443, "o", "if sin.Watermark.MaxTS != nil {\r\n   450\t\t\tt, err := parseTime(*sin.Watermark.MaxTS)\r\n   451\t\t\tif err != nil {\r\n   452\t\t\t\treturn nil, fmt.Errorf(\"bad state watermark: %w\", err)\r\n   453\t\t\t}\r\n   454\t\t\tst.hasMax = true\r\n   455\t\t\tst.maxTs = t\r\n   456\t\t}\r\n   457\t\tfor _, id := range sin.SeenIDs {\r\n   458"]
[14533.215502, "o", "\t\t\tst.seenIds[id] = true\r\n   459\t\t}\r\n   460\t\tfor _, p := range sin.PendingPurchases {\r\n   461\t\t\tt, err := parseTime(p.TS)\r\n   462\t\t\tif err != nil {\r\n   463\t\t\t\treturn nil, fmt.Errorf(\"bad pending purchase ts: %w\", err)\r\n   464\t\t\t}\r\n   465\t\t\tif stateStrict && !p.firstSeenEpochSet {\r\n   466\t\t\t\treturn nil, fmt.Errorf(\"ingest: --state-strict: state pending entry missing first_seen_epoch\")\r\n   467\t"]
[14533.215558, "o", "\t\t}\r\n   468\t\t\tst.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, firstSeenEpoch: int(epochSeconds(t)), user: p.User, usd: float64(p.USD), originRun: p.OriginRun})\r\n   469\t\t}\r\n   470\t\tfor _, s := range sin.OpenSessions {\r\n   471\t\t\tlast, err := parseTime(s.LastTS)\r\n   472\t\t\tif err != nil {\r\n   473\t\t\t\treturn nil, fmt.Errorf(\"bad open session last_ts: %w\", err)\r\n   474\t\t\t}\r\n   475\t"]
