[8307.709473, "o", "package main\r\n\r\nimport (\r\n\"encoding/json\"\r\n\"path/filepath\"\r\n)\r\n\r\nfunc writeManifest(path string, m manifestOutput) ([]byte, error) {\r\ndata, err := json.MarshalIndent(m, \"\", \"  \")\r\nif err != nil {\r\nreturn nil, err\r\n}\r\ndata = append(data, '\\n')\r\nif err := atomicWriteFile(path, data); err != nil {\r\nreturn nil, err\r\n}\r\nreturn data, nil\r\n}\r\n\r\nfunc writeSignature(path, manifestPath string, manifestData []byte, maxTs *string) error {\r\nsig := signatureOutput{\r\nManifestPath:   filepath.Base(manifestPath),\r\nManifestSHA256: sha256Hex(manifestData),\r\nManifestBytes:  int64(len(manifestData)),\r\nSignedAtUTC:    signedAt(maxTs),\r\nToolVersion:    toolVersion,\r\n}\r\ndata, err := json.MarshalIndent(sig, \"\", \"  \")\r\nif err != nil {\r\nreturn err\r\n}\r\ndata = append(data, '\\n')\r\nreturn atomicWriteFile(path, data)\r\n}\r\n\r\nfunc signedAt(maxTs *string) string {\r\nif maxTs != nil {\r\nreturn *maxTs\r\n}\r\nreturn \"1970-01-01T00:00:00Z\"\r\n}\r\n"]
