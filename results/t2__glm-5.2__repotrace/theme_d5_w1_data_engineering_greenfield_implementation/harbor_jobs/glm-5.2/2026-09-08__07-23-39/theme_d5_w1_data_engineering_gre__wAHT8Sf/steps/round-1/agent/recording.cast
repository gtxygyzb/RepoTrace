[10901.315323, "o", "\r\n    55\t\t\tif r := recover(); r != nil {\r\n    56\t\t\t\tcfg = cliConfig{}\r\n    57\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n    58\t\t\t}\r\n    59\t\t}()\r\n    60\t\tcfg = cliConfig{\r\n    61\t\t\tsessionGap:        600,\r\n    62\t\t\twatermarkLag:      300,\r\n    63\t\t\tpendingTTL:        86400,\r\n    64\t\t\tmaxOpenSessions:   100000,\r\n    65\t\t\tratesMaxStaleness: 0,\r\n    66\t\t}\r\n    67\t\trequired := map[string]bool{\r\n    68\t\t\t\"--input-dir\": false,\r\n    69\t\t\t\"--rates\":     false,\r\n    70\t\t\t\"--output\":    false,\r\n    71\t\t\t\"--rejects\":   false,\r\n    72\t\t}\r\n    73\t\tif len(args) > 0 && args[0] == \"ingest\" {\r\n    74\t\t\targs = args[1:]\r\n    75\t\t}\r\n    76\t\tfor i := 0; i < len(args); i++ {\r\n    77\t\t\targ := args[i]\r\n    78\t\t\tswitch arg {\r\n    79\t\t\tcase \"--input-dir\":\r\n    80\t\t\t\tcfg.inputDir = nextArg(args, &i)\r\n    81\t\t\tcase \"--rates\":\r\n    82\t\t\t\tcfg.ratesPath = nextArg(args, &i)\r\n    83\t\t\tcase \"--output\":\r\n    84\t\t\t\tcfg.outputPath = nextArg(args, &i)\r\n"]
