[14517.33331, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t"]
[14517.33339, "o", "\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n\r\ntype cliConfig struct {\r\n\tinputDir            string\r\n\tratesPath           string\r\n\toutputPath          string\r\n\trejectsPath         string\r\n\tsessionGap          int\r\n"]
[14517.333474, "o", "\twatermarkLag        int\r\n\tstateIn             string\r\n\tstateOut            string\r\n\tpendingTTL          int\r\n\tmaxOpenSessions     int\r\n\tauditLog            string\r\n\tauditLogDigest      string\r\n\tauditLogRotateBytes int\r\n"]
[14517.33354, "o", "\tratesStrict         bool\r\n\tratesMaxStaleness   int\r\n\tingestID            string\r\n\tingestIDSet         bool\r\n\toutManifest         string\r\n\tmanifestSignature   string\r\n\tdedupPolicy         string\r\n\tdedupPolicySet      bool\r\n\tstrictLateAudit     bool\r\n\tstateStrict         bool\r\n\tsummarySchemaOut     string\r\n\tsummarySchemaDigest string\r\n\tsummarySchemaStrict bool\r\n\tsummarySchemaIndex  string\r\n}\r\n\r\nfunc main() {\r\n"]
[14517.333602, "o", "\tcfg, err := parseArgs(os.Args[1:])\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(2)\r\n\t}\r\n\tif err := run(cfg); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n"]
[14517.333661, "o", "\r\nfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n\tdefer func() {\r\n\t\tif r := recover(); r != nil {\r\n\t\t\tcfg = cliConfig{}\r\n\t\t\terr = fmt.Errorf(\"%v\", r)\r\n\t\t}\r\n\t}()\r\n\tcfg = cliConfig{\r\n\t\tsessionGap:        600,\r\n"]
[14517.333719, "o", "\t\twatermarkLag:      300,\r\n\t\tpendingTTL:        86400,\r\n\t\tmaxOpenSessions:   100000,\r\n\t\tratesMaxStaleness: 0,\r\n\t}\r\n\trequired := map[string]bool{\r\n\t\t\"--input-dir\": false,\r\n\t\t\"--rates\":     false,\r\n"]
[14517.333776, "o", "\t\t\"--output\":    false,\r\n\t\t\"--rejects\":   false,\r\n\t}\r\n\tif len(args) > 0 && args[0] == \"ingest\" {\r\n\t\targs = args[1:]\r\n\t}\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tif strings.HasPrefix(arg, \"--summary-schema-out=\") {\r\n\t\t\tcfg.summarySchemaOut = strings.TrimPrefix(arg, \"--summary-schema-out=\")\r\n"]
[14517.333851, "o", "\t\t\tif cfg.summarySchemaOut == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-out: value must be non-empty\")\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif strings.HasPrefix(arg, \"--summary-schema-digest=\") {\r\n\t\t\tcfg.summarySchemaDigest = strings.TrimPrefix(arg, \"--summary-schema-digest=\")\r\n\t\t\tif cfg.summarySchemaDigest == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest: value must be non-empty\")\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t"]
[14517.333915, "o", "\t}\r\n\t\tif strings.HasPrefix(arg, \"--summary-schema-index=\") {\r\n\t\t\tcfg.summarySchemaIndex = strings.TrimPrefix(arg, \"--summary-schema-index=\")\r\n\t\t\tif cfg.summarySchemaIndex == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index: value must be non-empty\")\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tswitch arg {\r\n\t\tcase \"--input-dir\":\r\n"]
[14517.33399, "o", "\t\t\tcfg.inputDir = nextArg(args, &i)\r\n\t\tcase \"--rates\":\r\n\t\t\tcfg.ratesPath = nextArg(args, &i)\r\n\t\tcase \"--output\":\r\n\t\t\tcfg.outputPath = nextArg(args, &i)\r\n\t\tcase \"--rejects\":\r\n\t\t\tcfg.rejectsPath = nextArg(args, &i)\r\n\t\tcase \"--session-gap\":\r\n\t\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\r\n\t\tcase \"--watermark-lag\":\r\n\t"]
[14517.334051, "o", "\t\tcfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")\r\n\t\tcase \"--state-in\":\r\n\t\t\tcfg.stateIn = nextArg(args, &i)\r\n\t\tcase \"--state-out\":\r\n\t\t\tcfg.stateOut = nextArg(args, &i)\r\n\t\tcase \"--pending-ttl\":\r\n\t\t\tcfg.pendingTTL = atoiOrError(nextArg(args, &i), \"--pending-ttl\")\r\n\t\tcase \"--max-open-sessions\":\r\n"]
[14517.334108, "o", "\t\t\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-sessions\")\r\n\t\tcase \"--audit-log\":\r\n\t\t\tcfg.auditLog = nextArg(args, &i)\r\n\t\tcase \"--audit-log-digest\":\r\n\t\t\tcfg.auditLogDigest = nextArg(args, &i)\r\n\t\tcase \"--audit-log-rotate-bytes\":\r\n\t\t\tcfg.auditLogRotateBytes = atoiOrError(nextArg(args, &i), \"--audit-log-rotate-bytes\")\r\n\t\tcase \"--rates-strict\":\r\n\t\t\tcfg.ratesStrict = true\r\n\t"]
[14517.334173, "o", "\tcase \"--rates-max-staleness\":\r\n\t\t\tcfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), \"--rates-max-staleness\")\r\n\t\tcase \"--ingest-id\":\r\n\t\t\tcfg.ingestID = nextArg(args, &i)\r\n\t\t\tcfg.ingestIDSet = true\r\n\t\tcase \"--out-parquet-manifest\":\r\n\t\t\tcfg.outManifest = nextArg(args, &i)\r\n\t\tcase \"--manifest-signature\":\r\n"]
[14517.334242, "o", "\t\t\tcfg.manifestSignature = nextArg(args, &i)\r\n\t\tcase \"--dedup-policy\":\r\n\t\t\tval := nextArg(args, &i)\r\n\t\t\tif val != \"first-arrival\" && val != \"lex-largest-ts\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --dedup-policy: must be one of {first-arrival, lex-largest-ts}\")\r\n\t\t\t}\r\n\t\t\tcfg.dedupPolicy = val\r\n"]
[14517.334299, "o", "\t\t\tcfg.dedupPolicySet = true\r\n\t\tcase \"--strict-late-audit\":\r\n\t\t\tcfg.strictLateAudit = true\r\n\t\tcase \"--state-strict\":\r\n\t\t\tcfg.stateStrict = true\r\n\t\tcase \"--summary-schema-out\":\r\n\t\t\tcfg.summarySchemaOut = nextArg(args, &i)\r\n"]
[14517.334356, "o", "\t\t\tif cfg.summarySchemaOut == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-out: value must be non-empty\")\r\n\t\t\t}\r\n\t\tcase \"--summary-schema-digest\":\r\n\t\t\tcfg.summarySchemaDigest = nextArg(args, &i)\r\n\t\t\tif cfg.summarySchemaDigest == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest: value must be non-empty\")\r\n\t\t\t}\r\n\t\tcase \"--summary-schema-strict\":\r\n\t"]
[14517.334419, "o", "\t\tcfg.summarySchemaStrict = true\r\n\t\tcase \"--summary-schema-index\":\r\n\t\t\tcfg.summarySchemaIndex = nextArg(args, &i)\r\n\t\t\tif cfg.summarySchemaIndex == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index: value must be non-empty\")\r\n\t\t\t}\r\n\t\tdefault:\r\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: unknown flag %s\", arg)\r\n\t\t"]
[14517.334474, "o", "}\r\n\t\tif strings.HasPrefix(arg, \"--\") && arg != \"--rates-strict\" && arg != \"--strict-late-audit\" && arg != \"--state-strict\" {\r\n\t\t\tif _, ok := required[arg]; ok {\r\n\t\t\t\trequired[arg] = true\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n"]
[14517.334531, "o", "\tfor k, ok := range required {\r\n\t\tif !ok {\r\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: %s is required\", k)\r\n\t\t}\r\n\t}\r\n\tif cfg.ingestIDSet {\r\n\t\tif len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {\r\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)\")\r\n\t\t}\r\n"]
[14517.334594, "o", "\t}\r\n\tif cfg.outManifest == \"\" && cfg.manifestSignature != \"\" {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --manifest-signature requires --out-parquet-manifest\")\r\n\t}\r\n\tif cfg.outManifest != \"\" && !parentDirExists(cfg.outManifest) {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest --out-parquet-manifest parent directory does not exist\")\r\n\t}\r\n\tif cfg.manifestSignature != \"\" && !parentDirExists(cfg.manifestSignature) {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest --manifest-signature parent directory does not exist\")\r\n\t}\r\n"]
[14517.334653, "o", "\tif cfg.strictLateAudit && cfg.auditLog == \"\" {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --strict-late-audit requires --audit-log\")\r\n\t}\r\n\tif cfg.auditLogRotateBytes != 0 {\r\n\t\tif cfg.auditLog == \"\" {\r\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --audit-log-rotate-bytes requires --audit-log\")\r\n\t\t}\r\n\t\tif cfg.auditLogRotateBytes < 4096 {\r\n"]
[14517.334717, "o", "\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --audit-log-rotate-bytes: must be a positive integer >= 4096\")\r\n\t\t}\r\n\t}\r\n\tif cfg.summarySchemaDigest != \"\" && cfg.summarySchemaOut == \"\" {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest requires --summary-schema-out\")\r\n\t}\r\n\tif cfg.summarySchemaStrict && cfg.summarySchemaOut == \"\" {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-strict requires --summary-schema-out\")\r\n\t}\r\n\tif cfg.summarySchemaIndex != \"\" && (cfg.summarySchemaOut == \"\" || cfg.summarySchemaDigest == \"\") {\r\n\t\t"]
[14517.334773, "o", "return cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index requires --summary-schema-out and --summary-schema-digest\")\r\n\t}\r\n\tif cfg.summarySchemaOut != \"\" && !parentDirExists(cfg.summarySchemaOut) {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest --summary-schema-out parent directory does not exist\")\r\n\t}\r\n\tif cfg.summarySchemaDigest != \"\" && !parentDirExists(cfg.summarySchemaDigest) {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest --summary-schema-digest parent directory does not exist\")\r\n\t}\r\n"]
[14517.334836, "o", "\tif cfg.summarySchemaIndex != \"\" && !parentDirExists(cfg.summarySchemaIndex) {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest --summary-schema-index parent directory does not exist\")\r\n\t}\r\n\tif cfg.dedupPolicy == \"\" {\r\n\t\tcfg.dedupPolicy = \"lex-largest-ts\"\r\n\t}\r\n\treturn cfg, nil\r\n}\r\n\r\nfunc nextArg(args []string, i *int) string {\r\n"]
[14517.334894, "o", "\tif *i+1 >= len(args) {\r\n\t\tpanic(fmt.Errorf(\"ingest: missing value for %s\", args[*i]))\r\n\t}\r\n\t*i++\r\n\treturn args[*i]\r\n}\r\n\r\nfunc atoiOrError(s, flag string) int {\r\n\tn, err := strconv.Atoi(s)\r\n"]
[14517.33495, "o", "\tif err != nil {\r\n\t\tpanic(fmt.Errorf(\"ingest: invalid integer for %s: %s\", flag, s))\r\n\t}\r\n\treturn n\r\n}\r\n\r\nfunc ptrCutoff(c cutoffObject) *cutoffObject {\r\n\treturn &c\r\n}\r\n\r\nfunc run(cfg cliConfig) error {\r\n\tratesData, err := os.ReadFile(cfg.ratesPath)\r\n"]
[14517.335009, "o", "\tif err != nil {\r\n\t\treturn fmt.Errorf(\"ingest: rates: %w\", err)\r\n\t}\r\n\tratesDigest := sha256Hex(ratesData)\r\n"]
[14517.335618, "o", "\u001b[?2004h"]
[14517.335675, "o", "root@n30009:/app# "]
[14517.614718, "i", "sed -n '260,560p' cli.go\n"]
[14517.61498, "o", "sed -n '260,560p' cli.go\r\n"]
[14517.615056, "o", "\u001b[?2004l\r"]
[14517.618179, "o", "\tratesDigest := sha256Hex(ratesData)\r\n\trt, err := loadRates(cfg.ratesPath)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tvar st *loadedState\r\n"]
[14517.61829, "o", "\trunIndex := 1\r\n\tif cfg.stateIn != \"\" {\r\n\t\tst, err = loadState(cfg.stateIn, cfg.stateStrict)\r\n\t\tif err != nil && !os.IsNotExist(err) {\r\n\t\t\treturn err\r\n\t\t}\r\n\t\tif st != nil {\r\n\t\t\trunIndex = st.runIndex + 1\r\n\t\t}\r\n\t}\r\n\tevents, shards, err := readInputEvents(cfg.inputDir)\r\n\tif err != nil {\r\n\t\t"]
[14517.618351, "o", "return err\r\n\t}\r\n\tseen := map[string]bool{}\r\n\tif st != nil {\r\n\t\tfor k, v := range st.seenIds {\r\n\t\t\tseen[k] = v\r\n\t\t}\r\n"]
[14517.618411, "o", "\t}\r\n\tvar pending []pendingEntry\r\n\topenSessions := map[string]carriedSession{}\r\n\tif st != nil {\r\n\t\tpending = append([]pendingEntry(nil), st.pending...)\r\n\t\tfor k, v := range st.openSessions {\r\n\t\t\topenSessions[k] = v\r\n\t\t}\r\n\t}\r\n"]
[14517.618466, "o", "\tbucketCounts := map[string]int{\"accepted\": 0, \"duplicate\": 0, \"invalid\": 0, \"late\": 0, \"unresolved_chargeback\": 0}\r\n\tinvalidReasons := map[string]int{}\r\n\tduplicateReasons := map[string]int{\"same_run\": 0, \"cross_run\": 0}\r\n\tfxFallbackStats := map[string]int{\"0\": 0}\r\n\tshardAccepted := map[string]int{}\r\n\tvar minTs, maxTs time.Time\r\n\t"]
[14517.618529, "o", "hasMin, hasMax := false, false\r\n\tvar watermark time.Time\r\n\thasWatermark := false\r\n\tif st != nil {\r\n\t\twatermark = st.maxTs\r\n\t\thasWatermark = st.hasMax\r\n\t}\r\n\r\n\ttype candidate struct {"]
[14517.618586, "o", "\r\n\t\traw       rawEvent\r\n\t\tctx       *eventContext\r\n\t\tev        *Event\r\n\t\tduplicate bool\r\n\t}\r\n\tvar candidates []candidate\r\n"]
[14517.61864, "o", "\tvar auditEntries []auditLogEntry\r\n\r\n\t// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.\r\n\tfor _, raw := range events {\r\n\t\tctx := newContext(raw)\r\n\t\tbucket := \"invalid\"\r\n\t\treason := \"\"\r\n"]
[14517.618696, "o", "\t\tvar ev *Event\r\n\t\tif raw.Invalid {\r\n\t\t\tbucket = \"invalid\"\r\n\t\t\treason = \"invalid_json\"\r\n\t\t} else {\r\n\t\t\tev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)\r\n\t\t\tif ev != nil {\r\n"]
[14517.618752, "o", "\t\t\t\tif seen[ev.ID] {\r\n\t\t\t\t\tbucket = \"duplicate\"\r\n\t\t\t\t\treason = \"cross_run\"\r\n\t\t\t\t\tev = nil\r\n\t\t\t\t} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {\r\n\t\t\t\t\tbucket = \"late\"\r\n\t\t\t\t\treason = \"late\"\r\n"]
[14517.618806, "o", "\t\t\t\t\tcutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)\r\n\t\t\t\t\tentry := auditLogEntry{\r\n\t\t\t\t\t\tShard:  raw.Shard,\r\n\t\t\t\t\t\tLine:   raw.Line,\r\n\t\t\t\t\t\tID:     ctx.IDStr(),\r\n"]
[14517.618861, "o", "\t\t\t\t\t\tTS:     ctx.TSString(),\r\n\t\t\t\t\t\tType:   ctx.TypeString(),\r\n\t\t\t\t\t\tBucket: bucket,\r\n\t\t\t\t\t\tCutoff: ptrCutoff(formatCutoffObject(cutoff)),\r\n\t\t\t\t\t}\r\n"]
[14517.618918, "o", "\t\t\t\t\tif cfg.strictLateAudit {\r\n\t\t\t\t\t\tlag := cfg.watermarkLag\r\n\t\t\t\t\t\tlateBy := int(entry.Cutoff.EpochSeconds - int(epochSeconds(ev.TS)))\r\n\t\t\t\t\t\tentry.WatermarkLagSeconds = &lag\r\n\t\t\t\t\t\tentry.LateBySeconds = &lateBy\r\n\t\t\t\t\t}\r\n\t\t\t\t\tauditEntries = append(auditEntries, entry)\r\n"]
[14517.618984, "o", "\t\t\t\t\tev = nil\r\n\t\t\t\t} else {\r\n\t\t\t\t\tbucket = \"accepted\"\r\n\t\t\t\t\tif ev.TS.After(watermark) {\r\n\t\t\t"]
[14517.619039, "o", "\t\t\twatermark = ev.TS\r\n\t\t\t\t\t\thasWatermark = true\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tbucket = \"invalid\"\r\n\t\t\t}\r\n\t\t}\r\n\t\tif bucket == \"invalid\" {\r\n"]
[14517.619095, "o", "\t\t\tinvalidReasons[reason]++\r\n\t\t}\r\n\t\tbucketCounts[bucket]++\r\n\t\tif bucket == \"duplicate\" && reason == \"cross_run\" {\r\n\t\t\tduplicateReasons[\"cross_run\"]++\r\n\t\t}\r\n\t\tcandidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})\r\n"]
[14517.619155, "o", "\t\tauditEntries = append(auditEntries, auditLogEntry{\r\n\t\t\tShard:  raw.Shard,\r\n\t\t\tLine:   raw.Line,\r\n\t\t\tID:     ctx.IDStr(),\r\n\t\t\tTS:     ctx.TSString(),\r\n\t\t\tType:   ctx.TypeString(),\r\n\t\t\tBucket: bucket,\r\n"]
[14517.619225, "o", "\t\t\tReason: reason,\r\n\t\t\tEvent:  raw.Raw,\r\n\t\t})\r\n\t}\r\n\r\n\t// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.\r\n\tgroups := map[string][]int{}\r\n"]
[14517.619304, "o", "\tfor i, c := range candidates {\r\n\t\tif c.ev != nil {\r\n\t\t\tgroups[c.ev.ID] = append(groups[c.ev.ID], i)\r\n\t\t}\r\n\t}\r\n\twinnerSet := map[int]bool{}\r\n\twinners := map[string]int{}\r\n\tvar dedupPolicyStats dedupPolicyStats\r\n\tdedupPolicyStats.Policy = cfg.dedupPolicy\r\n\tfor id, idxs := range groups {\r\n\t"]
[14517.619368, "o", "\tif len(idxs) < 2 {\r\n\t\t\tif len(idxs) == 1 {\r\n\t\t\t\twinners[id] = idxs[0]\r\n\t\t\t\twinnerSet[idxs[0]] = true\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n"]
[14517.619427, "o", "\t\twinner := idxs[0]\r\n\t\ttiebreak := false\r\n\t\tfor _, idx := range idxs[1:] {\r\n\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n\t\t\t\tif arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n"]
[14517.619483, "o", "\t\t\t\t\twinner = idx\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tcts := candidates[idx].ctx.TSString()\r\n\t\t\t\twts := candidates[winner].ctx.TSString()\r\n\t\t\t\tif cts > wts {\r\n"]
[14517.619539, "o", "\t\t\t\t\twinner = idx\r\n\t\t\t\t\ttiebreak = false\r\n\t\t\t\t} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n\t\t\t\t\twinner = idx\r\n"]
[14517.619656, "o", "\t\t\t\t\ttiebreak = true\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif cfg.dedupPolicy == \"lex-largest-ts\" {\r\n\t\t\twts := candidates[winner].ctx.TSString()\r\n\t\t\tfor _, idx := range idxs {\r\n\t\t\t\tif idx != winner && candidates[idx].ctx.TSString() == wts {\r\n\t\t\t\t\ttiebreak = true\r\n\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n"]
[14517.619783, "o", "\t\twinners[id] = winner\r\n\t\twinnerSet[winner] = true\r\n\t\tsameShard := true\r\n\t\tfor _, idx := range idxs {\r\n\t\t\tif candidates[idx].ev.Shard != candidates[winner].ev.Shard {\r\n\t\t\t\tsameShard = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif sameShard {\r\n\t\t\tdedupPolicyStats.DuplicateWinnersSameShard++\r\n\t\t\tif cfg.dedupPolicy == \"first-arrival\" || tiebreak {\r\n\t\t\t\tdedupPolicyStats.DuplicateWinnersLineTiebreak++\r\n\t\t\t}\r\n"]
[14517.619854, "o", "\t\t} else {\r\n\t\t\tdedupPolicyStats.DuplicateWinnersCrossShard++\r\n\t\t}\r\n\t}\r\n\r\n\t// Finalize accepted/duplicate buckets and outputs in arrival order.\r\n\thasMin, hasMax = false, false\r\n\tfor _, c := range candidates {\r\n"]
[14517.619922, "o", "\t\tif c.ev != nil {\r\n\t\t\tseen[c.ev.ID] = true\r\n\t\t}\r\n\t}\r\n"]
[14517.619989, "o", "\tbucketCounts[\"accepted\"] = 0\r\n\tbucketCounts[\"duplicate\"] = duplicateReasons[\"cross_run\"]\r\n\tfor i, c := range candidates {\r\n\t\t_ = i\r\n\t\tif c.ev == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif winnerSet[i] {\r\n\t\t\tbucketCounts[\"accepted\"]++\r\n\t\t\tshardAccepted[c.ev.Shard]++\r\n\t\t\tif !hasMin || c.ev.TS.Before(minTs) {\r\n\t\t\t\tminTs = c.ev.TS\r\n\t\t"]
[14517.620054, "o", "\t\thasMin = true\r\n\t\t\t}\r\n\t\t\tif !hasMax || c.ev.TS.After(maxTs) {\r\n\t\t\t\tmaxTs = c.ev.TS\r\n\t\t\t\thasMax = true\r\n"]
[14517.62011, "o", "\t\t\t}\r\n\t\t\t_ = pending\r\n\t\t\t_ = openSessions\r\n\t\t} else {\r\n\t\t\tbucketCounts[\"duplicate\"]++\r\n\t\t\tduplicateReasons[\"same_run\"]++\r\n\t\t\tentry := auditEntries[i]\r\n"]
[14517.620165, "o", "\t\t\tentry.Bucket = \"duplicate\"\r\n\t\t\tentry.Reason = \"same_run\"\r\n\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n\t\t\t\tw := winners[entry.ID]\r\n\t\t\t\tentry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}\r\n\t\t\t}\r\n\t"]
[14517.620232, "o", "\t\tauditEntries[i] = entry\r\n\t\t}\r\n\t}\r\n\r\n\tvar rejectRecords []rejectRecord\r\n\tfor i, c := range candidates {\r\n\t\tif c.ev == nil {\r\n\t\t\tr := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, raw: c.raw.Raw}\r\n\t\t\trejectRecords = append(rejectRecords, r)"]
[14517.620293, "o", "\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif winnerSet[i] {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tr := rejectRecord{bucket: \"duplicate\", reason: \"same_run\", raw: c.raw.Raw}\r\n"]
[14517.620361, "o", "\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n\t\t\tr.winner = true\r\n\t\t\tr.winnerShard = candidates[winners[c.ev.ID]].ev.Shard\r\n\t\t\tr.winnerLine = candidates[winners[c.ev.ID]].ev.Line\r\n"]
[14517.620418, "o", "\t\t}\r\n\t\trejectRecords = append(rejectRecords, r)\r\n\t}\r\n\r\n\tsummary := summaryOutput{\r\n\t\tTotalEvents:    len(events),\r\n\t\tAcceptedEvents: bucketCounts[\"accepted\"],\r\n\t\tRejectedEvents: bucketCounts[\"duplicate\"] + bucketCounts[\"invalid\"] + bucketCounts[\"late\"] + bucketCounts[\"unresolved_chargeback\"],\r\n\t\tAnomalies: map[string]int{\r\n\t"]
[14517.620474, "o", "\t\t\"duplicate\":             bucketCounts[\"duplicate\"],\r\n\t\t\t\"invalid\":               bucketCounts[\"invalid\"],\r\n\t\t\t\"late\":                  bucketCounts[\"late\"],\r\n\t\t\t\"unresolved_chargeback\": bucketCounts[\"unresolved_chargeback\"],\r\n\t\t},\r\n\t\t"]
[14517.620533, "o", "RunIndex: runIndex,\r\n\t}\r\n\tif hasWatermark {\r\n\t\twm := formatTS(watermark)\r\n\t\tsummary.Watermark = &wm\r\n\t}\r\n\tsummaryData, err := json.MarshalIndent(summary, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}"]
[14517.620589, "o", "\r\n\tsummaryData = append(summaryData, '\\n')\r\n\tif err := atomicWriteFile(cfg.outputPath, summaryData); err != nil {\r\n\t\treturn err\r\n\t}\r\n\trejectsData := buildRejects(rejectRecords, cfg.dedupPolicy)\r\n\t"]
[14517.620645, "o", "if err := atomicWriteFile(cfg.rejectsPath, rejectsData); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif cfg.stateOut != \"\" {\r\n\t\tstateData := buildStateOut(watermark, hasWatermark, st, sortedSeenIDs(seen), sortedPending(pending), sortedOpenSessions(openSessions), runIndex)\r\n\t\tif err := atomicWriteFile(cfg.stateOut, stateData); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n"]
[14517.620708, "o", "\t}\r\n\tvar auditSegmentPaths []string\r\n\tif cfg.auditLog != \"\" {\r\n\t\tauditSegmentPaths = writeAuditLog(cfg.auditLog, auditEntries, cfg.auditLogRotateBytes)\r\n\t}\r\n\tif cfg.auditLogDigest != \"\" {\r\n\t\tdigest := auditDigestOutput{\r\n"]
[14517.620765, "o", "\t\t\tSchemaVersion:    \"eventq.digest/v1\",\r\n\t\t\tTotalRecords:     len(auditEntries),\r\n\t\t\tBucketCounts:     bucketCounts,\r\n\t\t\tInvalidReasons:   invalidReasons,\r\n\t\t\tDuplicateReasons: duplicateReasons,\r\n\t\t\tLateCutoffStats:  computeLateCutoffStats(auditEntries),\r\n"]
[14517.620821, "o", "\t\t\tResolvedAgainst:  \"state\",\r\n\t\t\tFXFallbackStats:  fxFallbackStats,\r\n\t\t\tRatesDigest:      ratesDigest,\r\n\t\t}\r\n"]
