[14650.939028, "o", "\r\n    36\ttype inputShardInfo struct {\r\n    37\t\tName           string\r\n    38\t\tBytes          int64\r\n    39\t\tSHA256         string\r\n    40\t\tEventsTotal    int\r\n    41\t\tEventsAccepted int\r\n    42\t}\r\n    43\t\r\n    44\ttype loadedState struct {\r\n    45\t\tversion             int\r\n    46\t\thasMax              bool\r\n    47\t\tmaxTs               time.Time\r\n    48\t\tseenIds             map[string]bool\r\n    49\t\tpending             []pendingEntry\r\n    50\t\topenSessions        map[string]carriedSession\r\n    51\t\trunIndex            int\r\n    52\t\tcarryInPending      int\r\n    53\t\tcarryInOpenSessions int\r\n    54\t}\r\n    55\t\r\n    56\ttype pendingEntry struct {\r\n    57\t\tid             string\r\n    58\t\tts             time.Time\r\n    59\t\tfirstSeenEpoch int\r\n    60\t\tuser           string\r\n    61\t\tusd            float64\r\n    62\t\toriginRun      int\r\n    63\t}\r\n    64\t\r\n    65\ttype carriedSession struct {\r\n    66\t"]
[14650.939139, "o", "\tuser         string\r\n    67\t\tlastTs       time.Time\r\n    68\t\tsessionIndex int\r\n    69\t\tstartTs      time.Time\r\n    70\t}\r\n    71\t\r\n    72\ttype stateWatermarkOut struct {\r\n    73\t\tMaxTS *string `json:\"max_ts\"`\r\n    74\t}\r\n    75\t\r\n    76\ttype stateFileOut struct {\r\n    77\t\tVersion          int                   `json:\"version\"`\r\n    78\t\tWatermark        stateWatermarkOut     `json:\"watermark\"`\r\n    79\t\tSeenIDs          []string              `json:\"seen_ids\"`\r\n    80\t\tPendingPurchases []statePendingOut     `json:\"pending_purchases\"`\r\n    81\t\tOpenSessions     []stateOpenSessionOut `json:\"open_sessions\"`\r\n    82\t"]
[14650.939291, "o", "\tRunIndex         int                   `json:\"run_index\"`\r\n    83\t}\r\n    84\t\r\n    85\ttype statePendingOut struct {\r\n    86\t\tID                string `json:\"id\"`\r\n    87\t\tTS                string `json:\"ts\"`\r\n    88\t\tFirstSeenEpoch    int    `json:\"first_seen_epoch\"`\r\n    89\t\tfirstSeenEpochSet bool\r\n    90\t\tUser              string `json:\"user\"`\r\n    91\t\tUSD               Money  `json:\"usd\"`\r\n    92\t\tOriginRun         int    `json:\"origin_run\"`\r\n    93\t}\r\n    94\t\r\n    95\ttype stateOpenSessionOut struct {\r\n    96\t\tUser         string `json:\"user\"`\r\n    97\t\tLastTS       string `json:\"last_ts\"`\r\n    98\t\t"]
