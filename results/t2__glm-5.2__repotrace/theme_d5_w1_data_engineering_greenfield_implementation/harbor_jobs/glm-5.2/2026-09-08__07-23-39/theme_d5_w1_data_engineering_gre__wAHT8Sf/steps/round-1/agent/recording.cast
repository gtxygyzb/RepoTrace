[7246.261002, "o", "\tfor _, day := range sortedKeys(days) {\r\n\t\tif !isStrictDate(day) || !isDate(day) {\r\n\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: invalid day key %s\", day)\r\n\t\t}\r\n\t\tvar currencies map[string]json.RawMessage\r\n\t\tif err := json.Unmarshal(days[day], &currencies); err != nil {\r\n\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n\t\t}\r\n\t\tfor _, currency := range sortedKeys(currencies) {\r\n\t\t\tf, err := parseRateNumber(currencies[currency])\r\n\t\t\tif err != nil {\r\n"]
[7246.261159, "o", "\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: non-numeric rate for %s/%s\", day, currency)\r\n\t\t\t}\r\n\t\t\tif rt.days[day] == nil {\r\n\t\t\t\trt.days[day] = map[string]float64{}\r\n\t\t\t}\r\n\t\t\trt.days[day][currency] = f\r\n\t\t\trt.known[currency] = true\r\n\t\t}\r\n\t}\r\n\tbaseRaw, baseOk := top[\"base\"]\r\n\tif !baseOk {\r\n\t\treturn nil, errors.New(\"ingest: rates.json: base required\")\r\n\t}\r\n\tvar base string\r\n\tif err := json.Unmarshal(baseRaw, &base); err != nil || base == \"\" {\r\n\t\treturn nil, errors.New(\"ingest: rates.json: base required\")\r\n\t}\r\n\trt.base = base\r\n\tif base != \"USD\" {\r\n\t\treturn nil, errors.New(\"fx base must be USD\")\r\n\t}\r\n\tfor _, day := range sortedKeys(rt.days) {\r\n\t\tr, ok := rt.days[day][base]\r\n\t\tif !ok || r != 1.0 {\r\n"]
[7246.261327, "o", "\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: base currency %s must have rate 1.0 on day %s\", base, day)\r\n\t\t}\r\n\t}\r\n\treturn rt, nil\r\n}\r\n\r\nfunc readInputEvents(inputDir string) ([]rawEvent, error) {\r\n\tinfo, err := os.Stat(inputDir)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tif !info.IsDir() {\r\n\t\treturn nil, errors.New(\"input-dir is not a directory\")\r\n\t}\r\n\tentries, err := os.ReadDir(inputDir)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar files []string\r\n\tfor _, e := range entries {\r\n\t\tif e.IsDir() || !e.Type().IsRegular() {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfiles = append(files, e.Name())\r\n\t}\r\n\tsort.Strings(files)\r\n\t"]
[7246.261403, "o", "var events []rawEvent\r\n\tfor _, name := range files {\r\n\t\tdata, err := os.ReadFile(filepath.Join(inputDir, name))\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tlineNo := 0\r\n\t\tfor _, line := range bytes.Split(data, []byte{'\\n'}) {\r\n\t\t\tlineNo++\r\n\t\t\ttrimmed := bytes.TrimSpace(line)\r\n\t\t\tif len(trimmed) == 0 {\r\n\t\t\t\tcontinue\r\n\t"]
[7246.261467, "o", "\t\t}\r\n\t\t\tvar obj map[string]json.RawMessage\r\n\t\t\tif err := json.Unmarshal(trimmed, &obj); err != nil {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tevents = append(events, rawEvent{Shard: name, Line: lineNo, Raw: json.RawMessage(trimmed), Obj: obj})\r\n\t\t}\r\n"]
[7246.261528, "o", "\t}\r\n\treturn events, nil\r\n}\r\n\r\nfunc newContext(raw rawEvent) *eventContext {\r\n\tctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n\tctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n\tctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n\tctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n\treturn ctx\r\n}\r\n\r\nfunc parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {\r\n\tobj := ctx.Obj\r\n"]
[7246.261589, "o", "\traw, ok := obj[\"v\"]\r\n\tif !ok {\r\n\t\treturn nil, \"schema_version\"\r\n\t}\r\n\tvar v int\r\n\tif err := json.Unmarshal(raw, &v); err != nil {\r\n\t\treturn nil, \"schema_version\"\r\n\t}\r\n\tif v != 1 && v != 2 {\r\n\t\treturn nil, \"schema_version\"\r\n\t}\r\n"]
[7246.261647, "o", "\tid, idOk, _ := getRawString(obj, \"id\")\r\n\tif !idOk || id == \"\" {\r\n\t\treturn nil, \"missing_id\"\r\n\t}\r\n\ttsStr, tsOk, _ := getRawString(obj, \"ts\")\r\n\tif !tsOk {\r\n\t\treturn nil, \"missing_ts\"\r\n\t}\r\n\tt, err := parseTime(tsStr)\r\n\tif err != nil {\r\n"]
[7246.261703, "o", "\t\treturn nil, \"bad_ts\"\r\n\t}\r\n\ttypeStr, typeOk, _ := getRawString(obj, \"type\")\r\n\tif !typeOk {\r\n\t\treturn nil, \"missing_type\"\r\n\t}\r\n\tswitch typeStr {\r\n\tcase \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\n\tdefault:\r\n\t\treturn nil, \"bad_type\"\r\n\t}\r\n\tuser, userOk, _ := getRawString(obj, \"user_id\")\r\n"]
[7246.261773, "o", "\tif !userOk || user == \"\" {\r\n\t\treturn nil, \"missing_user\"\r\n\t}\r\n\tev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n\tswitch typeStr {\r\n\tcase \"purchase\", \"refund\":\r\n\t"]
[7246.261832, "o", "\tvar amount float64\r\n\t\tif v == 1 {\r\n\t\t\traw, present := obj[\"amount\"]\r\n\t\t\tif !present {\r\n\t\t\t\treturn nil, \"missing_amount\"\r\n\t\t\t}\r\n\t\t\tvar f float64\r\n\t\t\tif err := json.Unmarshal(raw, &f); err != nil {\r\n\t\t\t\treturn nil, \"bad_amount\"\r\n\t\t\t}\r\n\t\t\tif !isFinite(f) || f < 0 {\r\n\t\t\t\treturn nil, \"bad_amount\"\r\n\t\t\t}\r\n\t\t\tamount = f\r\n\t"]
[7246.261889, "o", "\t} else {\r\n\t\t\traw, present := obj[\"amount_cents\"]\r\n\t\t\tif !present {\r\n\t\t\t\treturn nil, \"missing_amount\"\r\n\t\t\t}\r\n\t\t\tn, err := getJSONInt(raw)\r\n\t\t\tif err != nil || n < 0 {\r\n\t\t\t\treturn nil, \"bad_amount\"\r\n"]
[7246.261945, "o", "\t\t\t}\r\n\t\t\tamount = float64(n) / 100.0\r\n\t\t}\r\n\t\tcur, curOk, curPresent := getRawString(obj, \"currency\")\r\n\t\tif !curPresent {\r\n\t\t\treturn nil, \"missing_currency\"\r\n\t\t}\r\n\t\tif !curOk || cur == \"\" {\r\n\t\t\treturn nil, \"bad_currency\"\r\n"]
[7246.262006, "o", "\t\t}\r\n\t\trate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)\r\n\t\tswitch status {\r\n\t\tcase \"fx_unknown_currency\":\r\n\t\t\treturn nil, \"fx_unknown_currency\"\r\n\t\tcase \"missing_rate\":\r\n\t\t\treturn nil, \"fx_no_rate_for_date\"\r\n\t\tcase \"bad_rate\":\r\n\t\t\tif ratesStrict {\r\n\t\t\t\treturn nil, \"fx_bad_rate\"\r\n"]
[7246.262062, "o", "\t\t\t}\r\n\t\t\treturn nil, \"fx_no_rate_for_date\"\r\n\t\t}\r\n\t\tusd := amount * rate\r\n\t\tif typeStr == \"refund\" {\r\n\t\t\tusd = -usd\r\n\t\t}\r\n\t\tev.Amount = amount\r\n\t\tev.Currency = cur\r\n"]
[7246.26212, "o", "\t\tev.FXFallbackDays = fallbackDays\r\n\t\tev.USD = roundMoney(usd)\r\n\tcase \"chargeback\":\r\n\t\tref, refOk, refPresent := getRawString(obj, \"ref_id\")\r\n\t\tif !refPresent || !refOk || ref == \"\" {\r\n\t\t\treturn nil, \"missing_ref_id\"\r\n\t\t}\r\n\t\tev.RefID = ref\r\n\t\tev.USD = 0\r\n\tcase \"login\", \"signup\":\r\n"]
[7246.262203, "o", "\t\tev.USD = 0\r\n\t}\r\n\treturn ev, \"\"\r\n}\r\n\r\ntype stateFileIn struct {\r\n\tVersion          int                   `json:\"version\"`\r\n\tWatermark        stateWatermarkOut     `json:\"watermark\"`\r\n\tSeenIDs          []string              `json:\"seen_ids\"`\r\n\tPendingPurchases []statePendingOut     `json:\"pending_purchases\"`\r\n\tOpenSessions     []stateOpenSessionOut `json:\"open_sessions\"`\r\n\tRunIndex         int                   `json:\"run_index\"`\r\n}\r\n\r\nfunc loadState(path string) (*loadedState, error) {\r\n"]
[7246.262261, "o", "\tdata, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar sin stateFileIn\r\n\tif err := json.Unmarshal(data, &sin); err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tst := &loadedState{\r\n\t\tversion:      sin.Version,\r\n"]
[7246.262315, "o", "\t\tseenIds:      map[string]bool{},\r\n\t\trunIndex:     sin.RunIndex,\r\n"]
[7246.262824, "o", "\u001b[?2004h"]
