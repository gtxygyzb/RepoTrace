[7342.764233, "o", "   424\t\tOpenSessions     []stateOpenSessionOut `json:\"open_sessions\"`\r\n   425\t\tRunIndex         int                   `json:\"run_index\"`\r\n   426\t}\r\n   427\t\r\n   428\tfunc loadState(path string) (*loadedState, error) {\r\n   429\t\tdata, err := os.ReadFile(path)\r\n   430\t\tif err != nil {\r\n   431\t\t\treturn nil, err\r\n   432\t\t}\r\n   433\t\tvar sin stateFileIn\r\n   434\t\tif err := json.Unmarshal(data, &sin); err != nil {\r\n   435\t\t\treturn nil, err\r\n   436\t\t}\r\n   437\t\tst := &loadedState{\r\n   438\t\t\tversion:      sin.Version,\r\n"]
[7342.764316, "o", "   439\t\t\tseenIds:      map[string]bool{},\r\n   440\t\t\trunIndex:     sin.RunIndex,\r\n   441\t\t\topenSessions: map[string]carriedSession{},\r\n   442\t\t}\r\n   443\t\tif sin.Watermark.MaxTS != nil {\r\n   444\t\t\tt, err := parseTime(*sin.Watermark.MaxTS)\r\n   445"]
[7342.764385, "o", "\t\t\tif err != nil {\r\n   446\t\t\t\treturn nil, fmt.Errorf(\"bad state watermark: %w\", err)\r\n   447\t\t\t}\r\n   448\t\t\tst.hasMax = true\r\n   449\t\t\tst.maxTs = t\r\n   450\t\t}\r\n   451\t\tfor _, id := range sin.SeenIDs {\r\n   452\t\t\tst.seenIds[id] = true\r\n   453\t\t}\r\n   454\t\tfor _, p := range sin.PendingPurchases {\r\n   455"]
[7342.764452, "o", "\t\t\tt, err := parseTime(p.TS)\r\n   456\t\t\tif err != nil {\r\n   457\t\t\t\treturn nil, fmt.Errorf(\"bad pending purchase ts: %w\", err)\r\n   458\t\t\t}\r\n   459\t\t\tst.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, user: p.User, usd: float64(p.USD), originRun: p.OriginRun})\r\n   460\t\t}\r\n   461\t\tfor _, s := range sin.OpenSessions {\r\n   462\t\t\tlast, err := parseTime(s.LastTS)\r\n   463\t\t\tif err != nil {\r\n   464\t\t\t\treturn nil, fmt.Errorf(\"bad open session last_ts: %w\", err)\r\n   465\t\t\t}\r\n   466\t\t\tstart, err := parseTime(s.StartTS)\r\n   467\t"]
[7342.764517, "o", "\t\tif err != nil {\r\n   468\t\t\t\treturn nil, fmt.Errorf(\"bad open session start_ts: %w\", err)\r\n   469\t\t\t}\r\n   470\t\t\tst.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}\r\n   471\t\t}\r\n   472\t\tst.carryInPending = len(st.pending)\r\n   473\t\tst.carryInOpenSessions = len(st.openSessions)\r\n   474\t\treturn st, nil\r\n   475\t}\r\n"]
