[19950.91729, "o", "   198\t\t\t\t}\r\n   199\t\t\t\tbuf.Write(b)\r\n   200\t\t\t}\r\n   201\t\t\tif e.LateBySeconds != nil {\r\n   202\t\t\t\tbuf.WriteString(`,\"late_by_seconds\":`)\r\n   203\t\t\t\tb, err = json.Marshal(*e.LateBySeconds)\r\n   204\t\t\t\tif err != nil {\r\n   205\t\t\t\t\treturn nil, err\r\n   206\t\t\t\t}\r\n   207\t\t\t\tbuf.Write(b)\r\n"]
[19950.91736, "o", "   208\t\t\t}\r\n   209\t\t\tbuf.WriteByte('}')\r\n   210\t\t\treturn buf.Bytes(), nil\r\n   211\t\t}\r\n   212\t\ttype alias auditLogEntry\r\n   213\t\treturn json.Marshal(alias(e))\r\n   214\t}\r\n   215\t\r\n   216\ttype winnerArrival struct {\r\n   217\t\tShard string `json:\"shard\"`\r\n   218\t\tLine  int    `json:\"line\"`\r\n   219\t}\r\n   220\t\r\n   221\ttype rejectsCrossCheck struct {\r\n   222\t\tRejectsRowCount        int  `json:\"rejects_row_count\"`\r\n   223\t\tAuditRejectRecordCount int  `json:\"audit_reject_record_count\"`\r\n   224\t\tAgree                  bool `json:\"agree\"`\r\n   225\t}\r\n   226\t\r\n   227\ttype dedupPolicyStats struct {\r\n"]
[19950.917435, "o", "   228\t\tPolicy                       string `json:\"policy\"`\r\n   229\t\tDuplicateWinnersSameShard    int    `json:\"duplicate_winners_same_shard\"`\r\n   230\t\tDuplicateWinnersCrossShard   int    `json:\"duplicate_winners_cross_shard\"`\r\n   231\t\tDuplicateWinnersLineTiebreak int    `json:\"duplicate_winners_line_tiebreak\"`\r\n   232\t}\r\n   233\t\r\n   234\ttype auditDigestOutput struct {\r\n   235\t\tSchemaVersion     string             `json:\"schema_version\"`\r\n   236\t\tAuditLog          json.RawMessage    `json:\"audit_log\"`\r\n   237\t\tTotalRecords      int                `json:\"total_records\"`\r\n   238\t\tBucketCounts      map[string]int     `json:\"bucket_counts\"`\r\n"]
