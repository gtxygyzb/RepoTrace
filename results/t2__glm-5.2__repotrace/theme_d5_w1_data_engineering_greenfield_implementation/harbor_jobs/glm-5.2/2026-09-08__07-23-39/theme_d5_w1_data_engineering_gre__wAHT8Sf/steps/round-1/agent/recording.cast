[9075.452437, "o", "   145\t\t\treturn -v\r\n   146\t\t}\r\n   147\t\treturn v\r\n   148\t}\r\n   149\t\r\n   150\tfunc (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {\r\n   151\t\tif !rt.known[currency] {\r\n   152\t\t\treturn 0, 0, \"fx_unknown_currency\"\r\n   153\t\t}\r\n   154\t\tif m, ok := rt.days[date]; ok {\r\n   155\t\t\tif r, ok := m[currency]; ok {\r\n   156\t\t\t\tif isUsableRate(r) {\r\n"]
[9075.452503, "o", "   157\t\t\t\t\treturn r, 0, \"\"\r\n   158\t\t\t\t}\r\n   159\t\t\t\treturn 0, 0, \"bad_rate\"\r\n   160\t\t\t}\r\n   161\t\t}\r\n   162\t\tif maxStaleness > 0 {\r\n   163\t\t\teventDay := dayEpoch(date)\r\n   164\t\t\tif !eventDay.IsZero() {\r\n   165\t\t\t\tvar bestDate string"]
[9075.452561, "o", "\r\n   166\t\t\t\tvar bestDist int64 = -1\r\n   167\t\t\t\tfor _, d := range sortedKeys(rt.days) {\r\n   168\t\t\t\t\tif _, ok := rt.days[d][currency]; !ok {\r\n   169\t\t\t\t\t\tcontinue\r\n   170\t\t\t\t\t}\r\n   171\t\t\t\t\tdayTime := dayEpoch(d)\r\n   172\t\t\t\t\t"]
[9075.452622, "o", "if dayTime.IsZero() {\r\n   173\t\t\t\t\t\tcontinue\r\n   174\t\t\t\t\t}\r\n   175\t\t\t\t\tdist := absInt64(dayTime.Unix() - eventDay.Unix())\r\n   176\t\t\t\t\tif dist > int64(maxStaleness) {\r\n   177\t\t\t\t\t\tcontinue\r\n   178\t\t\t\t\t}\r\n   179\t\t\t\t\tif bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {\r\n"]
