[8043.225037, "o", "\t}\r\n   512\t\r\n   513\tfunc sortedSeenIDs(seen map[string]bool) []string {\r\n   514\t\tids := make([]string, 0, len(seen))\r\n   515\t\tfor id := range seen {\r\n   516\t\t\tids = append(ids, id)\r\n   517\t\t}\r\n   518\t\tsort.Strings(ids)\r\n   519\t\treturn ids\r\n   520\t}\r\n   521\t\r\n   522\t"]
[8043.225124, "o", "func sortedPending(pending []pendingEntry) []pendingEntry {\r\n   523\t\tout := append([]pendingEntry(nil), pending...)\r\n   524\t\tsort.SliceStable(out, func(i, j int) bool {\r\n   525\t\t\tif out[i].ts.Equal(out[j].ts) {\r\n   526\t\t\t\treturn out[i].id < out[j].id\r\n   527\t\t\t}\r\n   528\t\t\treturn out[i].ts.Before(out[j].ts)\r\n   529\t\t})\r\n   530\t\treturn out\r\n"]
