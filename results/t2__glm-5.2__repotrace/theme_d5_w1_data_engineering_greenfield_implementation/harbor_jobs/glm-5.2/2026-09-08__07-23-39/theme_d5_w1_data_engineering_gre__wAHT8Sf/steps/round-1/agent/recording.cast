[14650.939575, "o", "   124\t\tLateBySeconds       *int           `json:\"late_by_seconds,omitempty\"`\r\n   125\t}\r\n   126\t\r\n   127\ttype cutoffObject struct {\r\n   128\t\tValue        string `json:\"value\"`\r\n   129\t\tEpochSeconds int    `json:\"epoch_seconds\"`\r\n   130\t}\r\n   131\t\r\n   132\tfunc (e auditLogEntry) MarshalJSON() ([]byte, error) {\r\n   133\t\tif e.Bucket == \"late\" {\r\n   134\t\t\tvar buf bytes.Buffer\r\n   135\t\t\tbuf.WriteString(`{\"id\":`)\r\n   136\t\t\tb, err := json.Marshal(e.ID)\r\n   137\t\t\tif err != nil {\r\n   138\t\t\t\treturn nil, err\r\n   139\t\t\t}\r\n   140\t\t\tbuf.Write(b)\r\n"]
