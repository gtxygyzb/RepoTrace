[3566.302329, "o", "func getString(m map[string]json.RawMessage, keys ...string) (string, bool) {\r\n\u001b[?2004l\r"]
[3566.302405, "o", "\u001b[?2004h> "]
[3566.302496, "o", "  for _, k := range keys {\r\n\u001b[?2004l\r"]
[3566.302554, "o", "\u001b[?2004h> "]
[3566.302631, "o", "    raw, ok := m[k]\r\n\u001b[?2004l\r"]
[3566.302686, "o", "\u001b[?2004h> "]
[3566.30275, "o", "    if !ok {\r\n\u001b[?2004l\r"]
[3566.302806, "o", "\u001b[?2004h> "]
[3566.302859, "o", "      continue\r\n\u001b[?2004l\r"]
[3566.302915, "o", "\u001b[?2004h> "]
[3566.302971, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.303054, "o", "    var s string\r\n\u001b[?2004l\r"]
[3566.303109, "o", "\u001b[?2004h> "]
[3566.303337, "o", "    if err := json.Unmarshal(raw, &s); err == nil {\r\n\u001b[?2004l\r"]
[3566.303395, "o", "\u001b[?2004h> "]
[3566.303475, "o", "      return s, true\r\n\u001b[?2004l\r"]
[3566.30353, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[3566.303587, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[3566.303641, "o", "\u001b[?2004h> "]
[3566.303704, "o", "  return \"\", false\r\n\u001b[?2004l\r"]
[3566.303758, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3566.303813, "o", "\u001b[?2004h> "]
[3566.303995, "o", "func getNumberOrString(raw json.RawMessage) (float64, error) {\r\n\u001b[?2004l\r"]
[3566.30405, "o", "\u001b[?2004h> "]
[3566.304137, "o", "  trimmed := bytes.TrimSpace(raw)\r\n\u001b[?2004l\r"]
[3566.304204, "o", "\u001b[?2004h> "]
[3566.304276, "o", "  if len(trimmed) == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.304421, "o", "    return 0, errors.New(\"empty number\")\r\n\u001b[?2004l\r"]
[3566.304477, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3566.304547, "o", "> "]
[3566.304603, "o", "  if trimmed[0] == '\"' {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.304674, "o", "    var s string\r\n\u001b[?2004l\r"]
[3566.304728, "o", "\u001b[?2004h> "]
[3566.304883, "o", "    if err := json.Unmarshal(trimmed, &s); err != nil {\r\n\u001b[?2004l\r"]
[3566.304943, "o", "\u001b[?2004h> "]
[3566.304998, "o", "      return 0, err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.305075, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.305162, "o", "    s = strings.TrimSpace(s)\r\n\u001b[?2004l\r"]
[3566.305227, "o", "\u001b[?2004h> "]
[3566.305367, "o", "    if parts := strings.Fields(s); len(parts) > 0 {\r\n\u001b[?2004l\r"]
[3566.305421, "o", "\u001b[?2004h> "]
[3566.305479, "o", "      s = parts[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.305534, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.305665, "o", "    return strconv.ParseFloat(s, 64)\r\n\u001b[?2004l\r"]
[3566.305722, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3566.305778, "o", "> "]
[3566.305904, "o", "  return strconv.ParseFloat(string(trimmed), 64)\r\n\u001b[?2004l\r"]
[3566.305959, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3566.306017, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.306132, "o", "func roundMoney(f float64) float64 {\r\n\u001b[?2004l\r"]
[3566.306198, "o", "\u001b[?2004h> "]
[3566.306263, "o", "  abs := math.Abs(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.306419, "o", "  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n\u001b[?2004l\r"]
[3566.306475, "o", "\u001b[?2004h> "]
[3566.30654, "o", "  if f < 0 && cents != 0 {\r\n\u001b[?2004l\r"]
[3566.306601, "o", "\u001b[?2004h> "]
[3566.306686, "o", "    return -float64(cents) / 100.0\r\n\u001b[?2004l\r"]
[3566.306743, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3566.306798, "o", "> "]
[3566.306875, "o", "  return float64(cents) / 100.0\r\n\u001b[?2004l\r"]
[3566.30693, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3566.306984, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.3071, "o", "func jsonBytes(s string) []byte {\r\n\u001b[?2004l\r"]
[3566.307159, "o", "\u001b[?2004h> "]
[3566.307232, "o", "  b, err := json.Marshal(s)\r\n\u001b[?2004l\r"]
[3566.307287, "o", "\u001b[?2004h> "]
[3566.307341, "o", "  if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.307437, "o", "    return []byte(`\"\"`)\r\n\u001b[?2004l\r"]
[3566.307491, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[3566.307545, "o", ">   return b\r\n\u001b[?2004l\r"]
[3566.3076, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
