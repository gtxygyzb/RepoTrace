[14532.666119, "o", "   286\t\tvar pending []pendingEntry\r\n   287\t\topenSessions := map[string]carriedSession{}\r\n   288\t\tif st != nil {\r\n   289\t\t\tpending = append([]pendingEntry(nil), st.pending...)\r\n   290\t\t\tfor k, v := range st.openSessions {\r\n   291\t\t\t\topenSessions[k] = v\r\n   292\t\t\t}\r\n   293\t\t}\r\n   294\t\tbucketCounts := map[string]int{\"accepted\": 0, \"duplicate\": 0, \"invalid\": 0, \"late\": 0, \"unresolved_chargeback\": 0}\r\n   295\t\tinvalidReasons := map[string]int{}\r\n   296\t\tduplicateReasons := map[string]int{\"same_run\": 0, \"cross_run\": 0}\r\n   297\t\tfxFallbackStats := map[string]int{\"0\": 0}\r\n   298\t\tshardAccepted := map[string]int{}\r\n   299\t\tvar minTs, maxTs time.Time\r\n   300\t\thasMin, hasMax := false, false\r\n   301\t\tvar watermark time.Time\r\n   302\t\thasWatermark := false\r\n   303\t\tif st != nil {\r\n   304\t"]
[14532.666224, "o", "\t\twatermark = st.maxTs\r\n   305\t\t\thasWatermark = st.hasMax\r\n   306\t\t}\r\n   307\t\r\n   308\t\ttype candidate struct {\r\n   309\t\t\traw       rawEvent\r\n   310\t\t\tctx       *eventContext\r\n   311\t\t\tev        *Event\r\n   312\t\t\tduplicate bool\r\n   313\t\t}\r\n   314"]
[14532.66632, "o", "\t\tvar candidates []candidate\r\n   315\t\tvar auditEntries []auditLogEntry\r\n   316\t\r\n   317\t\t// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.\r\n   318\t\tfor _, raw := range events {\r\n   319\t\t\tctx := newContext(raw)\r\n   320\t\t\tbucket := \"invalid\"\r\n   321\t\t\treason := \"\"\r\n   322\t\t\tvar ev *Event\r\n"]
[14532.666411, "o", "   323\t\t\tif raw.Invalid {\r\n   324\t\t\t\tbucket = \"invalid\"\r\n   325\t\t\t\treason = \"invalid_json\"\r\n   326\t\t\t} else {\r\n   327\t\t\t\tev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)\r\n   328\t\t\t\tif ev != nil {\r\n   329\t\t\t\t\tif seen[ev.ID] {\r\n"]
[14532.666502, "o", "   330\t\t\t\t\t\tbucket = \"duplicate\"\r\n   331\t\t\t\t\t\treason = \"cross_run\"\r\n   332\t\t\t\t\t\tev = nil\r\n   333\t\t\t\t\t} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {\r\n   334\t\t\t\t\t\tbucket = \"late\"\r\n   335\t\t\t\t\t\treason = \"late\"\r\n   336\t\t\t\t\t\tcutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)\r\n   337\t\t\t\t\t\tentry := auditLogEntry{\r\n"]
