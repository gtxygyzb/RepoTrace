[18154.459565, "o", "\t\t\t\tType:                ctx.TypeString(),\r\n   469\t\t\t\tBucket:              bucket,\r\n   470\t\t\t\tReason:              reason,\r\n   471\t\t\t\tEvent:               raw.Raw,\r\n   472\t\t\t\tCutoff:              lateCutoff,\r\n   473\t\t\t\tWatermarkLagSeconds: lateLag,\r\n   474\t\t\t\tLateBySeconds:       lateBySec,\r\n   475\t\t\t})\r\n   476\t\t}\r\n   477\t\r\n   478\t\t// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.\r\n"]
[18154.459626, "o", "   479\t\tgroups := map[string][]int{}\r\n   480\t\tfor i, c := range candidates {\r\n   481\t\t\tif c.ev != nil {\r\n   482\t\t\t\tgroups[c.ev.ID] = append(groups[c.ev.ID], i)\r\n   483\t\t\t}\r\n   484\t\t}\r\n   485\t\twinnerSet := map[int]bool{}\r\n   486\t\twinners := map[string]int{}\r\n   487\t\tvar dedupPolicyStats dedupPolicyStats\r\n   488\t\tdedupPolicyStats.Policy = cfg.dedupPolicy\r\n   489\t"]
[18154.459683, "o", "\tfor id, idxs := range groups {\r\n   490\t\t\tif len(idxs) < 2 {\r\n   491\t\t\t\tif len(idxs) == 1 {\r\n   492\t\t\t\t\twinners[id] = idxs[0]\r\n   493\t\t\t\t\twinnerSet[idxs[0]] = true\r\n   494\t\t\t\t}\r\n   495\t\t\t\tcontinue\r\n"]
[18154.459741, "o", "   496\t\t\t}\r\n   497\t\t\twinner := idxs[0]\r\n   498\t\t\ttiebreak := false\r\n   499\t\t\tfor _, idx := range idxs[1:] {\r\n   500\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n   501\t\t\t\t\tif arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n   502\t\t\t\t\t\twinner = idx\r\n   503\t\t\t\t\t"]
[18154.459797, "o", "}\r\n   504\t\t\t\t} else {\r\n   505\t\t\t\t\tcts := candidates[idx].ctx.TSString()\r\n   506\t\t\t\t\twts := candidates[winner].ctx.TSString()\r\n   507\t\t\t\t\tif cts > wts {\r\n   508\t\t\t\t\t\twinner = idx\r\n   509\t\t\t\t\t\ttiebreak = false\r\n"]
[18154.459872, "o", "   510\t\t\t\t\t} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n   511\t\t\t\t\t\twinner = idx\r\n   512\t\t\t\t\t\ttiebreak = true\r\n   513\t\t\t\t\t}\r\n   514\t\t\t\t}\r\n   515\t\t\t}\r\n   516\t\t\tif cfg.dedupPolicy == \"lex-largest-ts\" {\r\n   517\t\t\t\twts := candidates[winner].ctx.TSString()\r\n   518\t\t\t\tfor _, idx := range idxs {\r\n   519\t\t\t\t\tif idx != winner && candidates[idx].ctx.TSString() == wts {\r\n   520\t\t\t\t\t\ttiebreak = true\r\n"]
