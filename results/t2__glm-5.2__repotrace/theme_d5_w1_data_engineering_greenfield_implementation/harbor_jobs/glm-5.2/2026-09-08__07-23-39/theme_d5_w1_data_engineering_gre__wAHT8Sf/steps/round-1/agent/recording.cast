[7270.510093, "o", "   165\t\t}\r\n   166\t\tif maxStaleness > 0 {\r\n   167\t\t\teventDay := dayEpoch(date)\r\n   168\t\t\tif !eventDay.IsZero() {\r\n   169\t\t\t\tvar bestDate string\r\n   170\t\t\t\tvar bestDist int64 = -1\r\n   171\t\t\t\tfor _, d := range sortedKeys(rt.days) {\r\n   172\t\t\t\t\tif _, ok := rt.days[d][currency]; !ok {\r\n   173\t\t\t\t\t\tcontinue\r\n   174\t\t\t\t\t}\r\n   175\t\t\t\t\tdayTime := dayEpoch(d)\r\n   176\t\t\t\t\tif dayTime.IsZero() {\r\n   177\t\t\t\t\t\tcontinue\r\n   178\t\t\t\t\t}\r\n   179\t\t\t\t\tdist := absInt64(dayTime.Unix() - eventDay.Unix())\r\n   180\t\t\t\t\tif dist > int64(maxStaleness) {\r\n   181\t\t\t\t\t\tcontinue\r\n   182\t\t\t\t\t}\r\n   183\t\t\t\t\tif bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {\r\n   184\t\t\t\t\t\tbestDist = dist\r\n   185\t\t\t\t\t\tbestDate = d\r\n   186\t\t\t\t\t}\r\n   187\t\t\t\t}\r\n"]
[7270.510217, "o", "   188\t\t\t\tif bestDate != \"\" {\r\n   189\t\t\t\t\tr := rt.days[bestDate][currency]\r\n   190\t\t\t\t\tif isUsableRate(r) {\r\n   191\t\t\t\t\t\treturn r, calendarDayDiff(bestDate, date), \"\"\r\n   192\t\t\t\t\t}\r\n   193\t\t\t\t\treturn 0, 0, \"bad_rate\"\r\n   194\t\t\t\t}\r\n   195\t\t\t}\r\n   196\t\t}\r\n   197\t\treturn 0, 0, \"missing_rate\"\r\n   198\t}\r\n   199\t\r\n   200\tfunc loadRates(path string) (*RateTable, error) {\r\n   201\t\tdata, err := os.ReadFile(path)\r\n   202\t\tif err != nil {\r\n   203\t\t\treturn nil, err\r\n   204\t\t}\r\n   205\t\tvar top map[string]json.RawMessage\r\n   206\t\t"]
[7270.510369, "o", "if err := json.Unmarshal(data, &top); err != nil {\r\n   207\t\t\treturn nil, fmt.Errorf(\"rates file is not valid json: %w\", err)\r\n   208\t\t}\r\n   209\t\trt := newRateTable()\r\n   210\t\tdaysRaw, ok := top[\"days\"]\r\n   211\t\tif !ok {\r\n   212\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n   213\t\t}\r\n   214\t\tvar days map[string]json.RawMessage\r\n   215\t\tif err := json.Unmarshal(daysRaw, &days); err != nil {\r\n   216\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n   217\t\t}\r\n   218\t\tif len(days) == 0 {\r\n   219\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n   220\t\t}\r\n   221\t\tfor _, day := range sortedKeys(days) {\r\n   222\t\t\tif !isStrictDate(day) || !isDate(day) {\r\n   223\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: invalid day key %s\", day)\r\n   224\t\t\t}\r\n"]
[7270.510454, "o", "   225\t\t\tvar currencies map[string]json.RawMessage\r\n   226\t\t\tif err := json.Unmarshal(days[day], &currencies); err != nil {\r\n   227\t\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n   228\t\t\t}\r\n   229\t\t\tfor _, currency := range sortedKeys(currencies) {\r\n   230\t\t\t\tf, err := parseRateNumber(currencies[currency])\r\n   231\t\t\t\tif err != nil {\r\n   232\t\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: non-numeric rate for %s/%s\", day, currency)\r\n   233\t\t\t\t}\r\n   234\t\t\t\tif rt.days[day] == nil {\r\n   235\t\t\t\t\trt.days[day] = map[string]float64{}\r\n   236\t\t\t\t}\r\n   237\t\t\t\trt.days[day][currency] = f\r\n"]
