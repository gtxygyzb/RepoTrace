[19950.61415, "o", "   478\t\t\tctx       *eventContext\r\n   479\t\t\tev        *Event\r\n   480\t\t\tduplicate bool\r\n   481\t\t}\r\n   482\t\tvar candidates []candidate\r\n   483\t\tvar auditEntries []auditLogEntry\r\n   484\t\r\n   485\t\t// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.\r\n   486"]
[19950.61426, "o", "\t\tfor _, raw := range events {\r\n   487\t\t\tctx := newContext(raw)\r\n   488\t\t\tbucket := \"invalid\"\r\n   489\t\t\treason := \"\"\r\n   490\t\t\tvar ev *Event\r\n   491\t\t\tvar lateCutoff *cutoffObject\r\n   492\t\t\tvar lateLag, lateBySec *int\r\n   493\t\t\tif raw.Invalid {\r\n   494\t\t\t\tbucket = \"invalid\"\r\n   495\t\t\t\treason = \"invalid_json\"\r\n   496\t\t\t} else {\r\n   497\t\t\t\tev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)\r\n   498\t\t\t\tif ev != nil {\r\n"]
[19950.614327, "o", "   499\t\t\t\t\tif seen[ev.ID] {\r\n   500\t\t\t\t\t\tbucket = \"duplicate\"\r\n   501\t\t\t\t\t\treason = \"cross_run\"\r\n   502\t\t\t\t\t\tev = nil\r\n   503\t\t\t\t\t} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {\r\n   504\t\t\t\t\t\tbucket = \"late\"\r\n   505"]
[19950.614351, "o", "\t\t\t\t\t\treason = \"late\"\r\n   506\t\t\t\t\t\tcutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)\r\n"]
[19950.614372, "o", "   507\t\t\t\t\t\tlateCutoff = ptrCutoff(formatCutoffObject(cutoff))\r\n"]
[19950.614479, "o", "   508\t\t\t\t\t\tif cfg.strictLateAudit {\r\n   509\t\t\t\t\t\t\tlag := cfg.watermarkLag\r\n   510\t\t\t\t\t\t\tlateBy := int(lateCutoff.EpochSeconds - int(epochSeconds(ev.TS)))\r\n   511\t\t\t\t\t\t\tlateLag = &lag\r\n   512\t\t\t\t\t\t\tlateBySec = &lateBy\r\n   513\t\t\t\t\t\t}\r\n   514\t\t\t\t\t\tev = nil\r\n   515\t\t\t\t\t} else {\r\n   516\t\t\t\t\t\tbucket = \"accepted\"\r\n   517\t\t\t\t\t\tif ev.TS.After(watermark) {\r\n   518\t\t\t\t\t\t\twatermark = ev.TS\r\n   519\t\t\t\t"]
[19950.614548, "o", "\t\t\thasWatermark = true\r\n   520\t\t\t\t\t\t}\r\n"]
