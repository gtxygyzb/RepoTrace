[20376.547861, "o", "   196\tfunc loadRates(path string) (*RateTable, error) {\r\n   197\t\tdata, err := os.ReadFile(path)\r\n   198\t\tif err != nil {\r\n   199\t\t\treturn nil, err\r\n   200\t\t}\r\n   201\t\tvar top map[string]json.RawMessage\r\n   202\t\tif err := json.Unmarshal(data, &top); err != nil {\r\n   203\t\t\treturn nil, fmt.Errorf(\"rates file is not valid json: %w\", err)\r\n   204\t\t}\r\n   205\t\trt := newRateTable()\r\n   206\t\tdaysRaw, ok := top[\"days\"]\r\n   207\t\tif !ok {\r\n"]
[20376.547963, "o", "   208\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n   209\t\t}\r\n   210\t\tvar days map[string]json.RawMessage\r\n   211\t\tif err := json.Unmarshal(daysRaw, &days); err != nil {\r\n   212\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n   213\t\t}\r\n   214\t"]
[20376.548034, "o", "\tif len(days) == 0 {\r\n   215\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n   216\t\t}\r\n   217\t\tfor _, day := range sortedKeys(days) {\r\n   218\t\t\tif !isStrictDate(day) || !isDate(day) {\r\n   219\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: invalid day key %s\", day)\r\n   220\t\t\t}\r\n   221\t\t\tvar currencies map[string]json.RawMessage\r\n   222\t\t\tif err := json.Unmarshal(days[day], &currencies); err != nil {\r\n   223\t\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n   224\t\t\t}\r\n   225\t\t\tfor _, currency := range sortedKeys(currencies) {\r\n   226\t\t\t\tf, err := parseRateNumber(currencies[currency])\r\n   227\t\t\t\tif err != nil {\r\n   228\t\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: non-numeric rate for %s/%s\", day, currency)\r\n   229\t\t\t\t}\r\n   230\t\t\t\tif rt.days[day] == nil {\r\n   231\t\t\t\t\trt.days[day] = map[string]float64{}\r\n   232\t"]
[20376.548106, "o", "\t\t\t}\r\n   233\t\t\t\trt.days[day][currency] = f\r\n   234\t\t\t\trt.known[currency] = true\r\n   235\t\t\t}\r\n   236\t\t}\r\n   237\t\tbaseRaw, baseOk := top[\"base\"]\r\n"]
[20376.548177, "o", "   238\t\tif !baseOk {\r\n   239\t\t\treturn nil, errors.New(\"ingest: rates.json: base required\")\r\n   240\t\t}\r\n   241\t\tvar base string\r\n   242\t\tif err := json.Unmarshal(baseRaw, &base); err != nil || base == \"\" {\r\n   243\t\t\treturn nil, errors.New(\"ingest: rates.json: base required\")\r\n   244\t\t}\r\n   245\t\trt.base = base\r\n   246\t\tif base != \"USD\" {\r\n   247\t\t\t"]
[20376.548256, "o", "return nil, errors.New(\"fx base must be USD\")\r\n   248\t\t}\r\n   249\t\tfor _, day := range sortedKeys(rt.days) {\r\n   250\t\t\tr, ok := rt.days[day][base]\r\n   251\t\t\tif !ok || r != 1.0 {\r\n   252\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: base currency %s must have rate 1.0 on day %s\", base, day)\r\n   253\t\t\t}\r\n   254\t\t}\r\n   255\t\treturn rt, nil\r\n   256\t}\r\n"]
