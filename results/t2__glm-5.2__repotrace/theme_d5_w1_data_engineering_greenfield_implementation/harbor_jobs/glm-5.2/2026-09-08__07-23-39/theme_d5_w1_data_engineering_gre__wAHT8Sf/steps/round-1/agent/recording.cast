[20078.491906, "o", "   106\t\tif _, err := time.Parse(\"2006-01-02\", s); err != nil {\r\n   107\t\t\treturn false\r\n   108\t\t}\r\n   109\t\treturn true\r\n   110\t}\r\n   111\t\r\n   112\tfunc sha256Hex(data []byte) string {\r\n   113\t\tsum := sha256.Sum256(data)\r\n   114\t\treturn hex.EncodeToString(sum[:])\r\n   115\t}\r\n   116\t\r\n   117\tfunc sha256Short(h string) string {\r\n   118\t\tif len(h) < 12 {\r\n   119\t\t\treturn h\r\n   120\t\t}\r\n   121\t\treturn h[:12]\r\n   122\t}\r\n   123\t\r\n   124\tfunc fileDigest(path string) (string, int64, error) {\r\n   125\t\tdata, err := os.ReadFile(path)\r\n"]
[20078.492003, "o", "   126\t\tif err != nil {\r\n   127\t\t\treturn \"\", 0, err\r\n   128\t\t}\r\n   129\t\treturn sha256Hex(data), int64(len(data)), nil\r\n   130\t}\r\n"]
[20078.492083, "o", "   131\t\r\n   132\tfunc atomicWriteFile(path string, data []byte) error {\r\n   133\t\ttmp := path + \".tmp\"\r\n   134\t\tif err := os.WriteFile(tmp, data, 0644); err != nil {\r\n   135\t\t\treturn err\r\n   136\t\t}\r\n   137\t\tif err := os.Rename(tmp, path); err != nil {\r\n   138\t\t\t_ = os.Remove(tmp)\r\n   139\t\t\treturn err\r\n   140\t\t}\r\n   141\t\treturn nil\r\n   142\t}\r\n   143\t\r\n   144\tfunc parentDirExists(path string) bool {\r\n   145\t\tdir := filepath.Dir(path)\r\n   146\t\tif dir == \".\" || dir == \"\" {\r\n   147\t\t\treturn true\r\n   148\t\t}\r\n   149\t\tinfo, err := os.Stat(dir)\r\n   150\t\tif err != nil {\r\n   151\t\t\treturn false\r\n   152\t\t}\r\n   153\t\treturn info.IsDir()\r\n"]
[20078.492151, "o", "   154\t}\r\n   155\t\r\n   156\tfunc manifestFileOutputFor(path string) (*manifestFileOutput, error) {\r\n   157\t\th, b, err := fileDigest(path)\r\n   158\t\tif err != nil {\r\n   159\t\t\treturn nil, err\r\n   160\t\t}\r\n"]
