[12708.947868, "o", "\t\t}\r\n   344\t\ttypeStr, typeOk, _ := getRawString(obj, \"type\")\r\n   345\t\tif !typeOk {\r\n   346\t\t\treturn nil, \"missing_type\"\r\n   347\t\t}\r\n   348\t\tswitch typeStr {\r\n   349\t\tcase \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\n   350\t\tdefault:\r\n"]
[12708.947932, "o", "   351\t\t\treturn nil, \"bad_type\"\r\n   352\t\t}\r\n   353\t\tuser, userOk, _ := getRawString(obj, \"user_id\")\r\n   354\t\tif !userOk || user == \"\" {\r\n   355\t\t\treturn nil, \"missing_user\"\r\n   356\t\t}\r\n   357\t\tev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n   358"]
[12708.947994, "o", "\t\tswitch typeStr {\r\n   359\t\tcase \"purchase\", \"refund\":\r\n   360\t\t\tvar amount float64\r\n   361\t\t\tif v == 1 {\r\n   362\t\t\t\traw, present := obj[\"amount\"]\r\n   363\t\t\t\tif !present {\r\n   364\t\t\t\t\treturn nil, \"missing_amount\"\r\n   365\t\t\t\t}\r\n   366\t\t\t\tvar f float64\r\n"]
[12708.948051, "o", "   367\t\t\t\tif err := json.Unmarshal(raw, &f); err != nil {\r\n   368\t\t\t\t\treturn nil, \"bad_amount\"\r\n   369\t\t\t\t}\r\n   370\t\t\t\tif !isFinite(f) || f < 0 {\r\n   371\t\t\t\t\treturn nil, \"bad_amount\"\r\n   372\t\t\t\t}\r\n   373\t\t\t\tamount = f\r\n"]
[12708.948124, "o", "   374\t\t\t} else {\r\n   375\t\t\t\traw, present := obj[\"amount_cents\"]\r\n   376\t\t\t\tif !present {\r\n   377\t\t\t\t\treturn nil, \"missing_amount\"\r\n   378\t\t\t\t}\r\n   379\t\t\t\tn, err := getJSONInt(raw)\r\n   380\t\t\t\tif err != nil || n < 0 {\r\n   381\t\t\t\t\treturn nil, \"bad_amount\"\r\n   382\t\t\t\t}\r\n   383\t\t\t\tamount = float64(n) / 100.0\r\n   384\t\t\t}\r\n   385\t\t\tcur, curOk, curPresent := getRawString(obj, \"currency\")\r\n"]
[12708.948204, "o", "   386\t\t\tif !curPresent {\r\n   387\t\t\t\treturn nil, \"missing_currency\"\r\n   388\t\t\t}\r\n   389\t\t\tif !curOk || cur == \"\" {\r\n   390\t\t\t\treturn nil, \"bad_currency\"\r\n   391\t\t\t}\r\n   392\t\t\trate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)\r\n   393\t\t\tswitch status {\r\n   394\t\t\tcase \"fx_unknown_currency\":\r\n"]
[12708.948268, "o", "   395\t\t\t\treturn nil, \"fx_unknown_currency\"\r\n   396\t\t\tcase \"missing_rate\":\r\n   397\t\t\t\treturn nil, \"fx_no_rate_for_date\"\r\n   398\t\t\tcase \"bad_rate\":\r\n   399\t\t\t\tif ratesStrict {\r\n   400\t\t\t\t\treturn nil, \"fx_bad_rate\"\r\n   401\t\t\t\t}\r\n   402\t\t\t\treturn nil, \"fx_no_rate_for_date\"\r\n   403\t\t\t}\r\n   404\t"]
[12708.948326, "o", "\t\tusd := amount * rate\r\n   405\t\t\tif typeStr == \"refund\" {\r\n   406\t\t\t\tusd = -usd\r\n   407\t\t\t}\r\n   408\t\t\tev.Amount = amount\r\n   409\t\t\tev.Currency = cur\r\n   410\t\t\tev.FXFallbackDays = fallbackDays\r\n"]
[12708.94839, "o", "   411\t\t\tev.USD = roundMoney(usd)\r\n   412\t\tcase \"chargeback\":\r\n   413\t\t\tref, refOk, refPresent := getRawString(obj, \"ref_id\")\r\n   414\t\t\tif !refPresent || !refOk || ref == \"\" {\r\n   415\t\t\t\treturn nil, \"missing_ref_id\"\r\n   416\t\t\t}\r\n   417\t\t\tev.RefID = ref\r\n   418\t\t\tev.USD = 0\r\n   419\t\tcase \"login\", \"signup\":\r\n   420\t\t\tev.USD = 0\r\n   421\t\t}\r\n"]
[12708.948453, "o", "   422\t\treturn ev, \"\"\r\n   423\t}\r\n   424\t\r\n   425\ttype stateFileIn struct {\r\n   426\t\tVersion          int                   `json:\"version\"`\r\n   427\t\tWatermark        stateWatermarkOut     `json:\"watermark\"`\r\n   428\t\tSeenIDs          []string              `json:\"seen_ids\"`\r\n   429\t\tPendingPurchases []statePendingOut     `json:\"pending_purchases\"`\r\n   430\t\tOpenSessions     []stateOpenSessionOut `json:\"open_sessions\"`\r\n"]
[12708.948513, "o", "   431\t\tRunIndex         int                   `json:\"run_index\"`\r\n   432\t}\r\n   433\t\r\n   434\tfunc loadState(path string, stateStrict bool) (*loadedState, error) {\r\n   435\t\tdata, err := os.ReadFile(path)\r\n   436\t\tif err != nil {\r\n   437\t\t\treturn nil, err\r\n   438\t\t}\r\n   439\t"]
[12708.948584, "o", "\tvar sin stateFileIn\r\n   440\t\tif err := json.Unmarshal(data, &sin); err != nil {\r\n   441\t\t\treturn nil, err\r\n   442\t\t}\r\n   443\t\tst := &loadedState{\r\n   444\t\t\tversion:      sin.Version,\r\n   445\t\t\tseenIds:      map[string]bool{},\r\n   446\t\t\trunIndex:     sin.RunIndex,\r\n   447\t\t\topenSessions: map[string]carriedSession{},\r\n   448\t\t}\r\n   449\t\tif sin.Watermark.MaxTS != nil {\r\n"]
[12708.948645, "o", "   450\t\t\tt, err := parseTime(*sin.Watermark.MaxTS)\r\n   451\t\t\tif err != nil {\r\n   452\t\t\t\treturn nil, fmt.Errorf(\"bad state watermark: %w\", err)\r\n   453\t\t\t}\r\n   454\t\t\tst.hasMax = true\r\n   455\t\t\tst.maxTs = t\r\n   456\t\t}\r\n   457\t\tfor _, id := range sin.SeenIDs {\r\n"]
[12708.948708, "o", "   458\t\t\tst.seenIds[id] = true\r\n   459\t\t}\r\n   460\t\tfor _, p := range sin.PendingPurchases {\r\n   461\t\t\tt, err := parseTime(p.TS)\r\n   462\t\t\tif err != nil {\r\n   463\t\t\t\treturn nil, fmt.Errorf(\"bad pending purchase ts: %w\", err)\r\n   464\t\t\t}\r\n   465\t\t\tif stateStrict && !p.firstSeenEpochSet {\r\n   466\t\t\t\treturn nil, fmt.Errorf(\"ingest: --state-strict: state pending entry missing first_seen_epoch\")\r\n   467\t\t\t}\r\n"]
[12708.94878, "o", "   468\t\t\tst.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, firstSeenEpoch: int(epochSeconds(t)), user: p.User, usd: float64(p.USD), originRun: p.OriginRun})\r\n   469\t\t}\r\n   470\t\tfor _, s := range sin.OpenSessions {\r\n   471\t\t\tlast, err := parseTime(s.LastTS)\r\n   472\t\t\tif err != nil {\r\n   473\t\t\t\treturn nil, fmt.Errorf(\"bad open session last_ts: %w\", err)\r\n   474\t\t\t}\r\n   475\t\t\tstart, err := parseTime(s.StartTS)\r\n   476\t\t\tif err != nil {\r\n"]
[12708.948854, "o", "   477\t\t\t\treturn nil, fmt.Errorf(\"bad open session start_ts: %w\", err)\r\n   478\t\t\t}\r\n   479\t\t\tst.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}\r\n   480\t\t}\r\n   481\t\tst.carryInPending = len(st.pending)\r\n   482\t\tst.carryInOpenSessions = len(st.openSessions)\r\n   483\t\treturn st, nil\r\n   484\t}\r\n   485\t\r\n   486\tfunc buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {\r\n   487\t\tout := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}\r\n   488\t\tif hasCurrentMax {\r\n   489"]
[12708.948927, "o", "\t\t\ts := formatTS(currentMax)\r\n   490\t\t\tout.Watermark.MaxTS = &s\r\n   491\t\t} else if st != nil && st.hasMax {\r\n   492\t\t\ts := formatTS(st.maxTs)\r\n   493\t\t\tout.Watermark.MaxTS = &s\r\n   494\t\t}\r\n   495\t\tb, _ := json.MarshalIndent(out, \"\", \"  \")\r\n   496\t\tb = append(b, '\\n')\r\n   497\t\treturn b\r\n   498\t}\r\n   499\t\r\n"]
[12708.949012, "o", "   500\tfunc statePendingOutList(pending []pendingEntry) []statePendingOut {\r\n   501\t\tout := make([]statePendingOut, 0, len(pending))\r\n   502\t\tfor _, p := range pending {\r\n   503\t\t\tout = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), FirstSeenEpoch: p.firstSeenEpoch, User: p.user, USD: Money(p.usd), OriginRun: p.originRun})\r\n   504\t\t}\r\n   505\t\treturn out\r\n   506\t}\r\n   507\t\r\n   508\tfunc stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {\r\n   509\t\tout := make([]stateOpenSessionOut, 0, len(sessions))\r\n   510\t"]
[12708.949074, "o", "\tfor _, s := range sessions {\r\n   511\t\t\tout = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})\r\n   512\t\t}\r\n   513\t\treturn out\r\n   514\t}\r\n   515\t\r\n   516\tfunc sortedSeenIDs(seen map[string]bool) []string {\r\n   517\t\tids := make([]string, 0, len(seen))\r\n   518\t\tfor id := range seen {\r\n"]
[12708.949133, "o", "   519\t\t\tids = append(ids, id)\r\n   520\t\t}\r\n   521\t\tsort.Strings(ids)\r\n   522\t\treturn ids\r\n   523\t}\r\n   524\t\r\n   525\tfunc stateFirstSeenEpochPresent(p statePendingOut) bool {\r\n   526\t\treturn p.firstSeenEpochSet\r\n"]
[12708.949208, "o", "   527\t}\r\n   528\t\r\n   529\tfunc sortedPending(pending []pendingEntry) []pendingEntry {\r\n   530\t\tout := append([]pendingEntry(nil), pending...)\r\n   531\t\tsort.SliceStable(out, func(i, j int) bool {\r\n   532\t\t\tif out[i].ts.Equal(out[j].ts) {\r\n   533\t\t\t\treturn out[i].id < out[j].id\r\n   534\t\t\t}\r\n   535\t"]
[12708.949265, "o", "\t\treturn out[i].ts.Before(out[j].ts)\r\n   536\t\t})\r\n   537\t\treturn out\r\n   538\t}\r\n   539\t\r\n   540\tfunc sortedOpenSessions(m map[string]carriedSession) []carriedSession {\r\n   541\t\tout := make([]carriedSession, 0, len(m))\r\n   542\t\tfor _, s := range m {\r\n"]
[12708.949329, "o", "   543\t\t\tout = append(out, s)\r\n   544\t\t}\r\n   545\t\tsort.SliceStable(out, func(i, j int) bool {\r\n   546\t\t\tif out[i].lastTs.Equal(out[j].lastTs) {\r\n   547\t\t\t\treturn out[i].user < out[j].user\r\n   548\t\t\t}\r\n   549\t\t\treturn out[i].lastTs.Before(out[j].lastTs)\r\n   550\t\t})\r\n   551"]
[12708.949385, "o", "\t\treturn out\r\n   552\t}\r\n   553\t\r\n   554\tfunc sortedCarriedSessions(m map[string]carriedSession) []carriedSession {\r\n   555\t\treturn sortedOpenSessions(m)\r\n   556\t}\r\n"]
