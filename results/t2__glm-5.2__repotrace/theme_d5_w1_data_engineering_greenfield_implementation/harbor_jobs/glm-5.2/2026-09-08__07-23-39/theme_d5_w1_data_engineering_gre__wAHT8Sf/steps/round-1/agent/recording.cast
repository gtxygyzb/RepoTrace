[18131.465095, "o", "     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"regexp\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t\t\"time\"\r\n    14\t)\r\n    15\t\r\n    16\tvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n    17\t\r\n    18\ttype cliConfig struct {\r\n"]
[18131.46517, "o", "    19\t\tinputDir            string\r\n    20\t\tratesPath           string\r\n    21\t\toutputPath          string\r\n    22\t\trejectsPath         string\r\n    23\t\tsessionGap          int\r\n    24\t\twatermarkLag        int\r\n    25\t\tstateIn             string\r\n    26\t\tstateOut            string\r\n    27\t\tpendingTTL          int\r\n    28\t\tmaxOpenSessions     int\r\n    29\t\tauditLog            string\r\n"]
[18131.465259, "o", "    30\t\tauditLogDigest      string\r\n    31\t\tauditLogRotateBytes int\r\n    32\t\tratesStrict         bool\r\n    33\t\tratesMaxStaleness   int\r\n    34\t\tingestID            string\r\n    35\t\tingestIDSet         bool\r\n    36\t\toutManifest         string\r\n"]
[18131.465329, "o", "    37\t\tmanifestSignature   string\r\n    38\t\tdedupPolicy         string\r\n    39\t\tdedupPolicySet      bool\r\n    40\t\tstrictLateAudit     bool\r\n    41\t\tstateStrict         bool\r\n    42\t\tsummarySchemaOut    string\r\n    43\t\tsummarySchemaDigest string\r\n    44\t\tsummarySchemaStrict bool\r\n    45\t\tsummarySchemaIndex  string\r\n    46\t\trejectsFormat       string\r\n    47\t\trejectsFormatHeader bool\r\n    48\t\tsessionPolicy       string\r\n    49\t\tfixedWindowSeconds  int\r\n    50\t\tfixedWindowSet      bool\r\n    51\t}\r\n    52\t\r\n    53\tfunc main() {\r\n"]
[18131.465395, "o", "    54\t\tcfg, err := parseArgs(os.Args[1:])\r\n    55\t\tif err != nil {\r\n    56\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    57\t\t\tos.Exit(2)\r\n    58\t\t}\r\n    59\t\tif err := run(cfg); err != nil {\r\n    60\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    61\t\t\tos.Exit(1)\r\n    62\t\t}\r\n"]
[18131.465458, "o", "    63\t}\r\n    64\t\r\n    65\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n    66\t\tdefer func() {\r\n    67\t\t\tif r := recover(); r != nil {\r\n    68\t\t\t\tcfg = cliConfig{}\r\n    69\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n"]
