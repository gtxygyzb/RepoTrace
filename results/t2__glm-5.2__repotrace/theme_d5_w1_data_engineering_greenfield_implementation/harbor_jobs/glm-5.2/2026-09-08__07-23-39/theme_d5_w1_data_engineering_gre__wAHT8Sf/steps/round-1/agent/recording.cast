[16179.349805, "i", "\n\\t\\t\\t}\n\\t\\t\\tif format == \"tagged-sorted\" && bucketRank(r.bucket) != bucketRank(bucket) {\n\\t\\t\\t\\tcontinue\n\\t\\t\\t}'''\nnew_loop = '''\\tfor _, r := range rows {'''\nassert old_loop in s, \"old loop not found\"\ns = s.replace(old_loop, new_loop, 1)\n\n# Remove now unused order variable if still present\ns = s.replace('''\\torder := []string{\"invalid\", \"late\", \"duplicate\", \"unresolved_chargeback\"}\n\\t// Build audit index for JSON-object rejects by shard/line/bucket.''', '''\\t// Build audit index for JSON-object rejects by shard/line/bucket.''', 1)\n\nPath('cli.go').write_text(s)\nprint('buildRejects sorting simplified')\nPY\n"]
