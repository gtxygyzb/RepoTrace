[14532.379646, "o", "    54\t\tif err := run(cfg); err != nil {\r\n    55\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    56\t\t\tos.Exit(1)\r\n    57\t\t}\r\n    58\t}\r\n    59\t\r\n    60\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n    61\t\tdefer func() {\r\n    62\t\t\tif r := recover(); r != nil {\r\n    63\t\t\t\tcfg = cliConfig{}\r\n    64\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n"]
