[12836.19942, "o", "\t\tif len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {\r\n   146\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)\")\r\n   147\t\t\t}\r\n   148\t\t}\r\n   149\t\tif cfg.outManifest == \"\" && cfg.manifestSignature != \"\" {\r\n   150\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --manifest-signature requires --out-parquet-manifest\")\r\n   151\t\t}\r\n   152\t\tif cfg.outManifest != \"\" && !parentDirExists(cfg.outManifest) {\r\n   153\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest --out-parquet-manifest parent directory does not exist\")\r\n   154\t\t}\r\n   155\t\tif cfg.manifestSignature != \"\" && !parentDirExists(cfg.manifestSignature) {\r\n"]
