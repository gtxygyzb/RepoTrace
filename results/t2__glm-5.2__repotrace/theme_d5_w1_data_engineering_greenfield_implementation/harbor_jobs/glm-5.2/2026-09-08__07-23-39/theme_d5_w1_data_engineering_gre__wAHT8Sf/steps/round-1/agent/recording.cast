[7356.592106, "o", "     6\t\t\"encoding/hex\"\r\n     7\t\t\"encoding/json\"\r\n     8\t\t\"errors\"\r\n     9\t\t\"fmt\"\r\n    10\t\t\"math\"\r\n    11\t\t\"os\"\r\n    12\t\t\"path/filepath\"\r\n    13\t\t\"sort\"\r\n    14\t\t\"strconv\"\r\n    15\t\t\"strings\"\r\n    16\t\t\"time\"\r\n    17"]
[7356.592172, "o", "\t)\r\n    18\t\r\n    19\tvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--audit-log <path>] [--audit-log-digest <path>] [--rates-strict] [--rates-max-staleness <seconds>]\\n\"\r\n    20\t\r\n    21\ttype Money float64\r\n    22\t\r\n    23\tfunc (m Money) MarshalJSON() ([]byte, error) {\r\n    24\t\treturn []byte(m.String()), nil\r\n    25\t}\r\n    26\t\r\n"]
[7356.592263, "o", "    27\tfunc (m Money) String() string {\r\n    28\t\tf := float64(m)\r\n    29\t\tabs := math.Abs(f)\r\n    30\t\tcents := int64(math.Floor(abs*100.0 + 0.5))\r\n    31\t\tneg := f < 0 && cents != 0\r\n"]
[7356.592328, "o", "    32\t\tdollars := cents / 100\r\n    33\t\trem := cents % 100\r\n    34\t\ts := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n    35\t\tif neg {\r\n    36\t\t\ts = \"-\" + s\r\n    37\t\t}\r\n    38\t\treturn s\r\n    39\t}\r\n    40\t\r\n    41\ttype Event struct {\r\n    42\t\tID                string\r\n    43\t\tType              string\r\n    44\t\tTS                time.Time\r\n    45\t\tUserID            string\r\n"]
[7356.592386, "o", "    46\t\tAmount            float64\r\n    47\t\tCurrency          string\r\n    48\t\tRefID             string\r\n    49\t\tUSD               float64\r\n    50\t\tRefUSD            float64\r\n    51\t\tFXFallbackDays    int\r\n    52\t\tResolvedAgainst   *string\r\n    53\t\tResolvedOriginRun int\r\n    54\t\tSessionIndex      int\r\n"]
[7356.592444, "o", "    55\t\tRaw               json.RawMessage\r\n    56\t\tShard             string\r\n    57\t\tLine              int\r\n    58\t}\r\n    59\t\r\n    60\ttype Reject struct {\r\n    61\t\tBucket int             `json:\"bucket\"`\r\n"]
[7356.592502, "o", "    62\t\tEvent  json.RawMessage `json:\"event\"`\r\n    63\t}\r\n    64\t\r\n    65\ttype ShardLine struct {\r\n    66\t\tShard string\r\n    67\t\tLine  int\r\n    68\t\tData  []byte\r\n    69\t}\r\n    70\t\r\n    71\ttype RateTable struct {\r\n"]
[7356.592559, "o", "    72\t\tbase  string\r\n    73\t\tdays  map[string]map[string]float64\r\n    74\t\tknown map[string]bool\r\n    75\t}\r\n    76\t\r\n    77\tfunc newRateTable() *RateTable {\r\n    78\t\treturn &RateTable{base: \"USD\", days: map[string]map[string]float64{}, known: map[string]bool{}}\r\n    79\t}\r\n    80\t\r\n"]
