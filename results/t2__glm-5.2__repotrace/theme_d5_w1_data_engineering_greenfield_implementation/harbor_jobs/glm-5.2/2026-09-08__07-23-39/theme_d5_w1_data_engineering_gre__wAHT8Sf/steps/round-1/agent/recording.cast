[15792.386917, "o", "func readInputEvents(inputDir string) ([]rawEvent, []inputShardInfo, error) {\r\n\tinfo, err := os.Stat(inputDir)\r\n\tif err != nil {\r\n\t\treturn nil, nil, err\r\n\t}\r\n\tif !info.IsDir() {\r\n\t\treturn nil, nil, errors.New(\"input-dir is not a directory\")\r\n\t}\r\n\tentries, err := os.ReadDir(inputDir)\r\n\tif err != nil {\r\n\t\treturn nil, nil, err\r\n"]
[15792.387067, "o", "\t}\r\n\tvar files []string\r\n\tfor _, e := range entries {\r\n\t\tif e.IsDir() || !e.Type().IsRegular() {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tfiles = append(files, e.Name())\r\n\t}\r\n\tsort.Strings(files)\r\n\tvar events []rawEvent\r\n\tvar shards []inputShardInfo\r\n\tfor _, name := range files {\r\n\t\tdata, err := os.ReadFile(filepath.Join(inputDir, name))\r\n\t\tif err != nil {\r\n\t\t\treturn nil, nil, err\r\n\t\t}\r\n\t\tsi := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}\r\n\t\tlineNo := 0\r\n\t\tfor _, line := range bytes.Split(data, []byte{'\\n'}) {\r\n\t\t\tlineNo++\r\n\t\t\ttrimmed := bytes.TrimSpace(line)\r\n\t\t\tif len(trimmed) == 0 {\r\n"]
[15792.387143, "o", "\t\t\t\tevents = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Blank: true})\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tsi.EventsTotal++\r\n\t\t\tvar obj map[string]json.RawMessage\r\n\t\t\tinvalid := false\r\n\t\t\tif err := json.Unmarshal(trimmed, &obj); err != nil {\r\n\t\t\t\tinvalid = true\r\n\t\t\t}\r\n\t\t\tevents = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})\r\n\t\t}\r\n"]
[15792.387248, "o", "\t\tshards = append(shards, si)\r\n\t}\r\n\treturn events, shards, nil\r\n}\r\n"]
[15792.387729, "o", "\u001b[?2004h"]
[15792.387787, "o", "root@n30009:/app# "]
