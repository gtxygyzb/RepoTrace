[3650.034314, "o", "}\r\n\r\nfunc dateKey(t time.Time) string {\r\n  return t.UTC().Format(\"2006-01-02\")\r\n}\r\n\r\nfunc isDate(s string) bool {\r\n  _, err := time.Parse(\"2006-01-02\", s)\r\n  return err == nil\r\n}\r\n\r\nfunc getString(m map[string]json.RawMessage, keys ...string) (string, bool) {\r\n  for _, k := range keys {\r\n    raw, ok := m[k]\r\n    if !ok {\r\n      continue\r\n    }\r\n    var s string\r\n    if err := json.Unmarshal(raw, &s); err == nil {\r\n      return s, true\r\n    }\r\n  }\r\n  return \"\", false\r\n}\r\n\r\nfunc getNumberOrString(raw json.RawMessage) (float64, error) {\r\n  trimmed := bytes.TrimSpace(raw)\r\n  if len(trimmed) == 0 {\r\n    return 0, errors.New(\"empty number\")\r\n  }\r\n  if trimmed[0] == '\"' {"]
[3650.034425, "o", "\r\n    var s string\r\n    if err := json.Unmarshal(trimmed, &s); err != nil {\r\n      return 0, err\r\n    }\r\n    s = strings.TrimSpace(s)\r\n    if parts := strings.Fields(s); len(parts) > 0 {\r\n      s = parts[0]\r\n    }\r\n    return strconv.ParseFloat(s, 64)\r\n  }\r\n  return strconv.ParseFloat(string(trimmed), 64)\r\n}\r\n\r\nfunc roundMoney(f float64) float64 {\r\n  abs := math.Abs(f)\r\n  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n  if f < 0 && cents != 0 {\r\n    return -float64(cents) / 100.0\r\n  }\r\n  return float64(cents) / 100.0\r\n}\r\n\r\nfunc jsonBytes(s string) []byte {\r\n  b, err := json.Marshal(s)\r\n  if err != nil {\r\n    return []byte(`\"\"`)\r\n  }\r\n  return b\r\n}\r\n"]
