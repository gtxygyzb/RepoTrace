[19901.143265, "o", "\t\tif strings.HasPrefix(arg, \"--sharding-report-index=\") {\r\n\t\t\tcfg.shardingReportIndex = strings.TrimPrefix(arg, \"--sharding-report-index=\")\r\n\t\t\tif cfg.shardingReportIndex == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --sharding-report-index: value must be non-empty\")\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\t"]
[19901.143327, "o", "if strings.HasPrefix(arg, \"--sharding-report-histogram=\") {\r\n\t\t\tcfg.shardingReportHistogram = strings.TrimPrefix(arg, \"--sharding-report-histogram=\")\r\n\t\t\tif cfg.shardingReportHistogram == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --sharding-report-histogram: value must be non-empty\")\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\t"]
[19901.143385, "o", "if strings.HasPrefix(arg, \"--sharding-report-sort=\") {\r\n\t\t\tcfg.shardingReportSort = strings.TrimPrefix(arg, \"--sharding-report-sort=\")\r\n\t\t\tif cfg.shardingReportSort == \"\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --sharding-report-sort: value must be non-empty\")\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tswitch arg {\r\n\t\tcase \"--input-dir\":\r\n"]
[19901.143445, "o", "\t\t\tcfg.inputDir = nextArg(args, &i)\r\n\t\tcase \"--rates\":\r\n\t\t\tcfg.ratesPath = nextArg(args, &i)\r\n\t\tcase \"--output\":\r\n\t\t\tcfg.outputPath = nextArg(args, &i)\r\n\t\tcase \"--rejects\":\r\n\t\t\tcfg.rejectsPath = nextArg(args, &i)\r\n\t\tcase \"--session-gap\":\r\n\t"]
[19901.143507, "o", "\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\r\n\t\tcase \"--watermark-lag\":\r\n\t\t\tcfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")\r\n\t\tcase \"--state-in\":\r\n\t\t\tcfg.stateIn = nextArg(args, &i)\r\n\t\tcase \"--state-out\":\r\n\t\t\tcfg.stateOut = nextArg(args, &i)\r\n\t\tcase \"--pending-ttl\":\r\n\t\t\tcfg.pendingTTL = atoiOrError(nextArg(args, &i), \"--pending-ttl\")\r\n\t\tcase \"--max-open-sessions\":\r\n\t\t"]
[19901.143568, "o", "\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-sessions\")\r\n\t\tcase \"--audit-log\":\r\n\t\t\tcfg.auditLog = nextArg(args, &i)\r\n\t\tcase \"--audit-log-digest\":\r\n\t\t\tcfg.auditLogDigest = nextArg(args, &i)\r\n\t\tcase \"--audit-log-rotate-bytes\":\r\n\t\t\tcfg.auditLogRotateBytes = atoiOrError(nextArg(args, &i), \"--audit-log-rotate-bytes\")\r\n\t\tcase \"--rates-strict\":\r\n\t\t\tcfg.ratesStrict = true\r\n"]
[19901.143625, "o", "\t\tcase \"--rates-max-staleness\":\r\n\t\t\tcfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), \"--rates-max-staleness\")\r\n\t\tcase \"--ingest-id\":\r\n\t\t\tcfg.ingestID = nextArg(args, &i)\r\n\t\t\tcfg.ingestIDSet = true\r\n\t\tcase \"--out-parquet-manifest\":\r\n\t\t\tcfg.outManifest = nextArg(args, &i)\r\n\t\tcase \"--manifest-signature\":\r\n"]
[19901.143693, "o", "\t\t\tcfg.manifestSignature = nextArg(args, &i)\r\n\t\tcase \"--dedup-policy\":\r\n\t\t\tval := nextArg(args, &i)\r\n\t\t\tif val != \"first-arrival\" && val != \"lex-largest-ts\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --dedup-policy: must be one of {first-arrival, lex-largest-ts}\")\r\n"]
