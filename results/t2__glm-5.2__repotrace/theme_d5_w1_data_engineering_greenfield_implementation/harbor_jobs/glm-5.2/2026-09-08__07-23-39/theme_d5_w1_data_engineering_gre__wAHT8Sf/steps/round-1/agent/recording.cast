[18944.226295, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('sharding_report.go')\ns = p.read_text()\ns = s.replace('\"os\"\\n', '')\ns = s.replace('\"sort\"\\n', '\"sort\"\\n\\t\"time\"\\n')\nold = '''func isExactRFC3339UTC(s string) bool {\n\tif len(s) != 20 {\n\t\treturn false\n\t}\n\tif s[19] != 'Z' {\n\t\treturn false\n\t}\n\tfor _, p := range [][2]int{{0, 4}, {5, 7}, {8, 10}, {11, 13}, {14, 16}, {17, 19}} {\n\t\tfor i := p[0]; i < p[1]; i++ {\n\t\t\tif s[i] < '0' || s[i] > '9' {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t}\n\treturn s[4] == '-' && s[7] == '-' && s[10] == 'T' && s[13] == ':' && s[16] == ':'\n}'''\nnew = '''func isExactRFC3339UTC(s string) bool {\n\t_, err := time.Parse(\"2006-01-02T15:04:05Z\", s)\n\treturn err == nil\n}'''\ns = s.replace(old, new)\np.write_text(s)\nPY\n"]
