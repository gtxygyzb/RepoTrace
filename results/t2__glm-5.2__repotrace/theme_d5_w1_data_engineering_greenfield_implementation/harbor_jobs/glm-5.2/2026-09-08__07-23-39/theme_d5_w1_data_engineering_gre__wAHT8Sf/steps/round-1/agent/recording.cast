[14712.302305, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"path/filepath\"\r\n     6\t)\r\n     7\t\r\n     8\tfunc writeManifest(path string, m manifestOutput) ([]byte, error) {\r\n     9\t\tdata, err := json.MarshalIndent(m, \"\", \"  \")\r\n    10\t\tif err != nil {\r\n    11\t\t\treturn nil, err\r\n    12\t\t}\r\n    13\t\tdata = append(data, '\\n')\r\n"]
[14712.302401, "o", "    14\t\tif err := atomicWriteFile(path, data); err != nil {\r\n    15\t\t\treturn nil, err\r\n    16\t\t}\r\n    17\t\treturn data, nil\r\n    18\t}\r\n    19\t\r\n    20\tfunc writeSignature(path, manifestPath string, manifestData []byte, maxTs *string) error {\r\n    21\t\tsig := signatureOutput{\r\n    22\t\t\tManifestPath:   filepath.Base(manifestPath),\r\n    23\t\t\tManifestSHA256: sha256Hex(manifestData),\r\n    24\t\t\tManifestBytes:  int64(len(manifestData)),\r\n    25\t\t\tSignedAtUTC:    signedAt(maxTs),\r\n    26\t\t\tToolVersion:    toolVersion,\r\n    27\t\t}\r\n    28\t\tdata, err := json.MarshalIndent(sig, \"\", \"  \")\r\n    29\t\tif err != nil {\r\n    30\t\t\treturn err\r\n    31\t\t}\r\n    32\t\tdata = append(data, '\\n')\r\n    33\t\treturn atomicWriteFile(path, data)\r\n    34\t}\r\n    35\t\r\n    36\tfunc signedAt(maxTs *string) string {\r\n    37\t\tif maxTs != nil {\r\n    38\t\t\treturn *maxTs\r\n    39\t\t}\r\n    40\t\treturn \"1970-01-01T00:00:00Z\"\r\n    41\t}\r\n"]
