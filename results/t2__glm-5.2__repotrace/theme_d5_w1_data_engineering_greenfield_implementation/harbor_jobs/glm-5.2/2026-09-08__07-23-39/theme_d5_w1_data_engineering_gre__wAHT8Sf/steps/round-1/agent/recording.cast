[17158.315509, "o", "   460\t\t\t\tduplicateReasons[\"cross_run\"]++\r\n   461\t\t\t}\r\n   462\t\t\tcandidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})\r\n   463\t\t\tauditEntries = append(auditEntries, auditLogEntry{\r\n   464\t\t\t\tShard:               raw.Shard,\r\n   465\t\t\t\tLine:                raw.Line,\r\n   466\t\t\t\tID:                  ctx.IDStr(),\r\n   467\t\t\t\tTS:                  ctx.TSString(),\r\n"]
[17158.315624, "o", "   468\t\t\t\tType:                ctx.TypeString(),\r\n   469\t\t\t\tBucket:              bucket,\r\n   470\t\t\t\tReason:              reason,\r\n   471\t\t\t\tEvent:               raw.Raw,\r\n   472\t\t\t\tCutoff:              lateCutoff,\r\n   473\t\t\t\tWatermarkLagSeconds: lateLag,\r\n   474\t\t\t\tLateBySeconds:       lateBySec,\r\n   475\t\t\t})\r\n   476\t\t}\r\n   477\t\r\n   478\t\t// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.\r\n   479\t\tgroups := map[string][]int{}\r\n   480\t\tfor i, c := range candidates {\r\n   481\t\t\tif c.ev != nil {\r\n   482\t\t\t\tgroups[c.ev.ID] = append(groups[c.ev.ID], i)\r\n   483\t\t\t}\r\n   484\t\t}\r\n"]
[17158.315699, "o", "   485\t\twinnerSet := map[int]bool{}\r\n   486\t\twinners := map[string]int{}\r\n   487\t\tvar dedupPolicyStats dedupPolicyStats\r\n   488\t\tdedupPolicyStats.Policy = cfg.dedupPolicy\r\n   489\t\tfor id, idxs := range groups {\r\n   490\t\t\tif len(idxs) < 2 {\r\n   491\t\t\t\tif len(idxs) == 1 {\r\n   492\t\t\t\t\twinners[id] = idxs[0]\r\n   493\t\t\t\t\twinnerSet[idxs[0]] = true\r\n   494\t\t\t\t}\r\n   495\t\t\t\tcontinue\r\n"]
[17158.315783, "o", "   496\t\t\t}\r\n   497\t\t\twinner := idxs[0]\r\n   498\t\t\ttiebreak := false\r\n   499\t\t\tfor _, idx := range idxs[1:] {\r\n   500\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n   501\t\t\t\t\tif arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n   502\t\t\t\t\t\twinner = idx\r\n   503\t\t\t\t\t}\r\n   504\t\t\t\t} else {\r\n   505\t\t\t\t\tcts := candidates[idx].ctx.TSString()\r\n"]
[17158.315859, "o", "   506\t\t\t\t\twts := candidates[winner].ctx.TSString()\r\n   507\t\t\t\t\tif cts > wts {\r\n   508\t\t\t\t\t\twinner = idx\r\n   509\t\t\t\t\t\ttiebreak = false\r\n   510\t\t\t\t\t} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n   511\t\t\t\t\t\twinner = idx\r\n   512\t\t\t\t\t\ttiebreak = true\r\n   513\t\t\t\t\t}\r\n   514\t\t\t\t}\r\n   515\t\t\t}\r\n   516\t"]
[17158.315928, "o", "\t\tif cfg.dedupPolicy == \"lex-largest-ts\" {\r\n   517\t\t\t\twts := candidates[winner].ctx.TSString()\r\n   518\t\t\t\tfor _, idx := range idxs {\r\n   519\t\t\t\t\tif idx != winner && candidates[idx].ctx.TSString() == wts {\r\n   520\t\t\t\t\t\ttiebreak = true\r\n   521\t\t\t\t\t\tbreak\r\n   522\t\t\t\t\t}\r\n   523\t\t\t\t}\r\n"]
[17158.315998, "o", "   524\t\t\t}\r\n   525\t\t\twinners[id] = winner\r\n   526\t\t\twinnerSet[winner] = true\r\n   527\t\t\tsameShard := true\r\n   528\t\t\tfor _, idx := range idxs {\r\n   529\t\t\t\tif candidates[idx].ev.Shard != candidates[winner].ev.Shard {\r\n   530\t\t\t\t\tsameShard = false\r\n   531\t\t\t\t\tbreak\r\n   532\t\t\t\t}\r\n   533\t\t\t}\r\n"]
[17158.316073, "o", "   534\t\t\tif sameShard {\r\n   535\t\t\t\tdedupPolicyStats.DuplicateWinnersSameShard++\r\n   536\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" || tiebreak {\r\n   537\t\t\t\t\tdedupPolicyStats.DuplicateWinnersLineTiebreak++\r\n   538\t\t\t\t}\r\n   539\t\t\t} else {\r\n   540\t\t\t\tdedupPolicyStats.DuplicateWinnersCrossShard++\r\n   541\t\t\t}\r\n   542\t\t}\r\n   543\t\r\n   544\t\t// Finalize accepted/duplicate buckets and outputs in arrival order.\r\n   545\t\t"]
[17158.316149, "o", "hasMin, hasMax = false, false\r\n   546\t\tfor _, c := range candidates {\r\n   547\t\t\tif c.ev != nil {\r\n   548\t\t\t\tseen[c.ev.ID] = true\r\n   549\t\t\t}\r\n"]
[17158.316256, "o", "   550\t\t}\r\n   551\t\tbucketCounts[\"accepted\"] = 0\r\n   552\t\tbucketCounts[\"duplicate\"] = duplicateReasons[\"cross_run\"]\r\n   553\t\tfor i, c := range candidates {\r\n   554\t\t\t_ = i\r\n   555\t\t\tif c.ev == nil {\r\n   556\t\t\t\tcontinue\r\n   557\t\t\t}\r\n   558\t\t\tif winnerSet[i] {\r\n   559\t\t\t\tbucketCounts[\"accepted\"]++\r\n   560\t\t\t\tshardAccepted[c.ev.Shard]++\r\n   561\t\t\t\tif !hasMin || c.ev.TS.Before(minTs) {\r\n   562\t\t\t\t\tminTs = c.ev.TS\r\n   563\t\t\t\t\thasMin = true\r\n   564\t\t\t\t}\r\n"]
[17158.316339, "o", "   565\t\t\t\tif !hasMax || c.ev.TS.After(maxTs) {\r\n   566\t\t\t\t\tmaxTs = c.ev.TS\r\n   567\t\t\t\t\thasMax = true\r\n   568\t\t\t\t}\r\n   569\t\t\t\t_ = pending\r\n   570\t\t\t\t_ = openSessions\r\n   571\t\t\t} else {\r\n   572\t\t\t\tbucketCounts[\"duplicate\"]++\r\n   573\t\t\t\tduplicateReasons[\"same_run\"]++\r\n   574\t\t\t\tentry := auditEntries[i]\r\n   575\t\t\t\tentry.Bucket = \"duplicate\"\r\n   576\t\t\t\tentry.Reason = \"same_run\"\r\n"]
[17158.316417, "o", "   577\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n   578\t\t\t\t\tw := winners[entry.ID]\r\n   579\t\t\t\t\tentry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}\r\n   580\t\t\t\t}\r\n"]
