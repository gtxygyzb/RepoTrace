[16949.724227, "o", "cli_go = cli_go.replace(\r\n\u001b[?2004l\r"]
[16949.724282, "o", "\u001b[?2004h> "]
[16949.724418, "o", "    '\\t\\tRunIndex: runIndex,\\n\\t}',\r\n\u001b[?2004l\r"]
[16949.724483, "o", "\u001b[?2004h> "]
[16949.724871, "o", "    '\\t\\tRunIndex: runIndex,\\n\\t\\tSessions: summarySessions{\\n\\t\\t\\tTotal:  sessionTotal,\\n\\t\\t\\tByUser: byUser,\\n\\t\\t},\\n\\t}'\r\n\u001b[?2004l\r"]
[16949.724938, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
