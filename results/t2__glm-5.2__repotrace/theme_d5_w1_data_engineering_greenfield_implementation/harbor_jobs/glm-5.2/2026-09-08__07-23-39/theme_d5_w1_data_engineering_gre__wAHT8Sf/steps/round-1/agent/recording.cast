[12700.277504, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n"]
[12700.277606, "o", "\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n\r\ntype cliConfig struct {\r\n\tinputDir            string\r\n\tratesPath           string\r\n\toutputPath          string\r\n\trejectsPath         string\r\n\t"]
[12700.277675, "o", "sessionGap          int\r\n\twatermarkLag        int\r\n\tstateIn             string\r\n\tstateOut            string\r\n\tpendingTTL          int\r\n\tmaxOpenSessions     int\r\n\tauditLog            string\r\n\tauditLogDigest      string\r\n\tauditLogRotateBytes int\r\n\tratesStrict         bool\r\n\tratesMaxStaleness   int\r\n"]
[12700.277734, "o", "\tingestID            string\r\n\tingestIDSet         bool\r\n\toutManifest         string\r\n\tmanifestSignature   string\r\n\tdedupPolicy         string\r\n\tdedupPolicySet      bool\r\n\tstrictLateAudit     bool\r\n\tstateStrict         bool\r\n}\r\n\r\n"]
[12700.277793, "o", "func main() {\r\n\tcfg, err := parseArgs(os.Args[1:])\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(2)\r\n\t}\r\n\tif err := run(cfg); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n"]
[12700.277847, "o", "\t}\r\n}\r\n\r\nfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n\tdefer func() {\r\n\t\tif r := recover(); r != nil {\r\n\t\t\tcfg = cliConfig{}\r\n\t\t\terr = fmt.Errorf(\"%v\", r)\r\n"]
[12700.277901, "o", "\t\t}\r\n\t}()\r\n\tcfg = cliConfig{\r\n\t\tsessionGap:        600,\r\n\t\twatermarkLag:      300,\r\n\t\tpendingTTL:        86400,\r\n"]
[12700.277956, "o", "\t\tmaxOpenSessions:   100000,\r\n\t\tratesMaxStaleness: 0,\r\n\t}\r\n\trequired := map[string]bool{\r\n\t\t\"--input-dir\": false,\r\n\t\t\"--rates\":     false,\r\n\t\t\"--output\":    false,\r\n\t\t\"--rejects\":   false,\r\n"]
[12700.278024, "o", "\t}\r\n\tif len(args) > 0 && args[0] == \"ingest\" {\r\n\t\targs = args[1:]\r\n\t}\r\n\tfor i := 0; i < len(args); i++ {\r\n\t\targ := args[i]\r\n\t\tswitch arg {\r\n\t\tcase \"--input-dir\":\r\n\t\t\tcfg.inputDir = nextArg(args, &i)\r\n"]
[12700.27808, "o", "\t\tcase \"--rates\":\r\n\t\t\tcfg.ratesPath = nextArg(args, &i)\r\n\t\tcase \"--output\":\r\n\t\t\tcfg.outputPath = nextArg(args, &i)\r\n\t\tcase \"--rejects\":\r\n\t\t\tcfg.rejectsPath = nextArg(args, &i)\r\n\t\tcase \"--session-gap\":\r\n"]
[12700.278131, "o", "\t\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\r\n\t\tcase \"--watermark-lag\":\r\n\t\t\tcfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")\r\n\t\tcase \"--state-in\":\r\n\t\t\tcfg.stateIn = nextArg(args, &i)\r\n"]
[12700.278183, "o", "\t\tcase \"--state-out\":\r\n\t\t\tcfg.stateOut = nextArg(args, &i)\r\n\t\tcase \"--pending-ttl\":\r\n\t\t\tcfg.pendingTTL = atoiOrError(nextArg(args, &i), \"--pending-ttl\")\r\n\t\tcase \"--max-open-sessions\":\r\n"]
[12700.278282, "o", "\t\t\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-sessions\")\r\n\t\tcase \"--audit-log\":\r\n\t\t\tcfg.auditLog = nextArg(args, &i)\r\n\t\tcase \"--audit-log-digest\":\r\n\t\t\tcfg.auditLogDigest = nextArg(args, &i)\r\n\t\tcase \"--audit-log-rotate-bytes\":\r\n\t\t\tcfg.auditLogRotateBytes = atoiOrError(nextArg(args, &i), \"--audit-log-rotate-bytes\")\r\n\t\tcase \"--rates-strict\":\r\n"]
[12700.27834, "o", "\t\t\tcfg.ratesStrict = true\r\n\t\tcase \"--rates-max-staleness\":\r\n\t\t\tcfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), \"--rates-max-staleness\")\r\n\t\tcase \"--ingest-id\":\r\n\t\t\tcfg.ingestID = nextArg(args, &i)\r\n\t\t\tcfg.ingestIDSet = true\r\n"]
[12700.27839, "o", "\t\tcase \"--out-parquet-manifest\":\r\n\t\t\tcfg.outManifest = nextArg(args, &i)\r\n\t\tcase \"--manifest-signature\":\r\n\t\t\tcfg.manifestSignature = nextArg(args, &i)\r\n"]
[12700.278441, "o", "\t\tcase \"--dedup-policy\":\r\n\t\t\tval := nextArg(args, &i)\r\n\t\t\tif val != \"first-arrival\" && val != \"lex-largest-ts\" {\r\n\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --dedup-policy: must be one of {first-arrival, lex-largest-ts}\")\r\n\t\t\t}\r\n\t"]
[12700.278494, "o", "\t\tcfg.dedupPolicy = val\r\n\t\t\tcfg.dedupPolicySet = true\r\n\t\tcase \"--strict-late-audit\":\r\n\t\t\tcfg.strictLateAudit = true\r\n\t\tcase \"--state-strict\":\r\n"]
[12700.278546, "o", "\t\t\tcfg.stateStrict = true\r\n\t\tdefault:\r\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: unknown flag %s\", arg)\r\n\t\t}\r\n\t\tif strings.HasPrefix(arg, \"--\") && arg != \"--rates-strict\" && arg != \"--strict-late-audit\" && arg != \"--state-strict\" {\r\n"]
[12700.278598, "o", "\t\t\tif _, ok := required[arg]; ok {\r\n\t\t\t\trequired[arg] = true\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t"]
[12700.27865, "o", "for k, ok := range required {\r\n\t\tif !ok {\r\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: %s is required\", k)\r\n\t\t}\r\n\t}\r\n\tif cfg.ingestIDSet {\r\n\t\tif len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {\r\n"]
[12700.27871, "o", "\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)\")\r\n\t\t}\r\n\t}\r\n\tif cfg.outManifest == \"\" && cfg.manifestSignature != \"\" {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --manifest-signature requires --out-parquet-manifest\")\r\n\t}\r\n\tif cfg.outManifest != \"\" && !parentDirExists(cfg.outManifest) {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest --out-parquet-manifest parent directory does not exist\")\r\n\t}\r\n\tif cfg.manifestSignature != \"\" && !parentDirExists(cfg.manifestSignature) {\r\n"]
[12700.278779, "o", "\t\treturn cliConfig{}, fmt.Errorf(\"ingest --manifest-signature parent directory does not exist\")\r\n\t}\r\n\tif cfg.strictLateAudit && cfg.auditLog == \"\" {\r\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --strict-late-audit requires --audit-log\")\r\n\t}\r\n\tif cfg.auditLogRotateBytes != 0 {\r\n\t\tif cfg.auditLog == \"\" {\r\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --audit-log-rotate-bytes requires --audit-log\")\r\n\t\t}\r\n"]
[12700.278863, "o", "\t\tif cfg.auditLogRotateBytes < 4096 {\r\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --audit-log-rotate-bytes: must be a positive integer >= 4096\")\r\n\t\t}\r\n\t}\r\n\tif cfg.dedupPolicy == \"\" {\r\n\t\tcfg.dedupPolicy = \"lex-largest-ts\"\r\n\t}\r\n\treturn cfg, nil\r\n}\r\n\r\nfunc nextArg(args []string, i *int) string {\r\n\tif *i+1 >= len(args) {\r\n\t\tpanic(fmt.Errorf(\"ingest: missing value for %s\", args[*i]))\r\n\t}\r\n\t*i++\r\n"]
[12700.278918, "o", "\treturn args[*i]\r\n}\r\n\r\nfunc atoiOrError(s, flag string) int {\r\n\tn, err := strconv.Atoi(s)\r\n\tif err != nil {\r\n\t\tpanic(fmt.Errorf(\"ingest: invalid integer for %s: %s\", flag, s))\r\n\t}\r\n\treturn n\r\n}\r\n\r\nfunc ptrCutoff(c cutoffObject) *cutoffObject {\r\n"]
[12700.278971, "o", "\treturn &c\r\n}\r\n\r\nfunc run(cfg cliConfig) error {\r\n\tratesData, err := os.ReadFile(cfg.ratesPath)\r\n\tif err != nil {\r\n\t\treturn fmt.Errorf(\"ingest: rates: %w\", err)\r\n"]
[12700.279027, "o", "\t}\r\n\tratesDigest := sha256Hex(ratesData)\r\n\trt, err := loadRates(cfg.ratesPath)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tvar st *loadedState\r\n\trunIndex := 1\r\n\tif cfg.stateIn != \"\" {\r\n\t\tst, err = loadState(cfg.stateIn, cfg.stateStrict)\r\n\t\tif err != nil && !os.IsNotExist(err) {\r\n"]
[12700.279083, "o", "\t\t\treturn err\r\n\t\t}\r\n\t\tif st != nil {\r\n\t\t\trunIndex = st.runIndex + 1\r\n\t\t}\r\n\t}\r\n\tevents, shards, err := readInputEvents(cfg.inputDir)\r\n\tif err != nil {\r\n\t\treturn err\r\n"]
[12700.279134, "o", "\t}\r\n\tseen := map[string]bool{}\r\n\tif st != nil {\r\n\t\tfor k, v := range st.seenIds {\r\n\t\t\tseen[k] = v\r\n\t\t}\r\n\t}\r\n\tvar pending []pendingEntry\r\n\topenSessions := map[string]carriedSession{}\r\n"]
[12700.279188, "o", "\tif st != nil {\r\n\t\tpending = append([]pendingEntry(nil), st.pending...)\r\n\t\tfor k, v := range st.openSessions {\r\n\t\t\topenSessions[k] = v\r\n\t\t}\r\n\t}\r\n\tbucketCounts := map[string]int{\"accepted\": 0, \"duplicate\": 0, \"invalid\": 0, \"late\": 0, \"unresolved_chargeback\": 0}\r\n"]
[12700.27926, "o", "\tinvalidReasons := map[string]int{}\r\n\tduplicateReasons := map[string]int{\"same_run\": 0, \"cross_run\": 0}\r\n\tfxFallbackStats := map[string]int{\"0\": 0}\r\n\tshardAccepted := map[string]int{}\r\n\tvar minTs, maxTs time.Time\r\n\thasMin, hasMax := false, false\r\n\tvar watermark time.Time\r\n\thasWatermark := false\r\n\tif st != nil {\r\n\t\twatermark = st.maxTs\r\n\t\thasWatermark = st.hasMax\r\n"]
[12700.279322, "o", "\t}\r\n\r\n\ttype candidate struct {\r\n\t\traw       rawEvent\r\n\t\tctx       *eventContext\r\n\t\tev        *Event\r\n\t\tduplicate bool\r\n\t}\r\n\tvar candidates []candidate\r\n\tvar auditEntries []auditLogEntry"]
[12700.279372, "o", "\r\n\r\n\t// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.\r\n\tfor _, raw := range events {\r\n\t\tctx := newContext(raw)\r\n\t\tbucket := \"invalid\"\r\n"]
