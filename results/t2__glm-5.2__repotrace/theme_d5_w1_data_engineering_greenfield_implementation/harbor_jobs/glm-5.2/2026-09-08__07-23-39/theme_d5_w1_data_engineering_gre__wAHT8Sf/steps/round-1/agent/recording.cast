[13626.880923, "o", "}\r\ncase nil:\r\nbuf.WriteString(\"null\")\r\ncase orderedJSON:\r\nwriteOrderedIndentValue(buf, val.value, indent)\r\ndefault:\r\nb, _ := json.Marshal(val)\r\nbuf.Write(b)\r\n}\r\n"]
[13626.881036, "o", "}\r\n\r\nfunc writeOrderedIndentObject(buf *bytes.Buffer, entries []orderedJSON, indent int) {\r\nif len(entries) == 0 {\r\nbuf.WriteString(\"{}\")\r\nreturn\r\n}\r\nbuf.WriteByte('{')\r\nbuf.WriteByte('\\n')\r\nfor i, e := range entries {\r\nwriteIndent(buf, indent+1)\r\nwriteJSONString(buf, e.key)\r\nbuf.WriteString(\": \")\r\nwriteOrderedIndentValue(buf, e.value, indent+1)\r\nif i < len(entries)-1 {\r\nbuf.WriteByte(',')\r\n}\r\nbuf.WriteByte('\\n')\r\n}\r\n"]
[13626.881109, "o", "writeIndent(buf, indent)\r\nbuf.WriteByte('}')\r\n}\r\n\r\nfunc writeOrderedIndentArrayAny(buf *bytes.Buffer, arr []any, indent int) {\r\nif len(arr) == 0 {\r\nbuf.WriteString(\"[]\")\r\nreturn\r\n}\r\nbuf.WriteByte('[')\r\nbuf.WriteByte('\\n')\r\nfor i, v := range arr {\r\nwriteIndent(buf, indent+1)\r\n"]
[13626.881175, "o", "writeOrderedIndentValue(buf, v, indent+1)\r\nif i < len(arr)-1 {\r\nbuf.WriteByte(',')\r\n}\r\nbuf.WriteByte('\\n')\r\n}\r\nwriteIndent(buf, indent)\r\nbuf.WriteByte(']')\r\n}\r\n\r\nfunc writeIndent(buf *bytes.Buffer, indent int) {\r\nfor i := 0; i < indent; i++ {\r\nbuf.WriteString(\"  \")\r\n}\r\n}\r\n\r\nfunc marshalOrderedIndent(v any) []byte {\r\n"]
[13626.881273, "o", "var buf bytes.Buffer\r\nwriteOrderedIndent(&buf, v, 0)\r\nreturn buf.Bytes()\r\n}\r\n\r\ntype summaryField struct {\r\nkey   string\r\nvalue any\r\n}\r\n\r\nfunc parseSummaryFields(data []byte) ([]summaryField, error) {\r\ndec := json.NewDecoder(bytes.NewReader(data))\r\ndec.UseNumber()\r\ntok, err := dec.Token()\r\n"]
[13626.881341, "o", "if err != nil {\r\nreturn nil, err\r\n}\r\ndelim, ok := tok.(json.Delim)\r\nif !ok || delim != '{' {\r\nreturn nil, fmt.Errorf(\"summary output is not a JSON object\")\r\n}\r\nvar fields []summaryField\r\nfor dec.More() {\r\nkeyTok, err := dec.Token()\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nkey, ok := keyTok.(string)\r\nif !ok {\r\n"]
[13626.881411, "o", "return nil, fmt.Errorf(\"summary object key is not a string\")\r\n}\r\nvar val any\r\nif err := dec.Decode(&val); err != nil {\r\nreturn nil, err\r\n}\r\nfields = append(fields, summaryField{key: key, value: val})\r\n}\r\nif _, err := dec.Token(); err != nil {\r\nreturn nil, err\r\n}\r\nreturn fields, nil\r\n}\r\n\r\nfunc classify(v any) string {\r\nswitch val := v.(type) {\r\ncase nil:\r\nreturn \"null\"\r\ncase bool:\r\nreturn \"boolean\"\r\ncase string:\r\n"]
[13626.881468, "o", "return \"string\"\r\ncase json.Number:\r\ns := val.String()\r\nif !strings.ContainsAny(s, \".eE\") {\r\nreturn \"integer\"\r\n}\r\nreturn \"number\"\r\ncase float64:\r\nif val == float64(int64(val)) {\r\nreturn \"integer\"\r\n"]
[13626.881539, "o", "}\r\nreturn \"number\"\r\ncase []any:\r\nreturn \"array\"\r\ncase map[string]any:\r\nreturn \"object\"\r\ndefault:\r\nreturn \"unknown\"\r\n}\r\n}\r\n\r\nfunc descriptorFor(v any, depth int, strict bool) []orderedJSON {\r\nt := classify(v)\r\nentries := []orderedJSON{{key: \"type\", value: t}}\r\nswitch t {\r\ncase \"array\":\r\narr := v.([]any)\r\n"]
[13626.881597, "o", "var elementType any\r\nif len(arr) == 0 {\r\nif strict {\r\nelementType = []orderedJSON{{key: \"type\", value: \"unknown\"}}\r\n} else {\r\nelementType = nil\r\n"]
