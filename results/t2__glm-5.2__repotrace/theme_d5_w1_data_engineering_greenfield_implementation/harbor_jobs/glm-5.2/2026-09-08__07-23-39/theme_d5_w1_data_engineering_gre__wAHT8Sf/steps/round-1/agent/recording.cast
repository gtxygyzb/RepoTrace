[3566.246983, "o", "\u001b[?2004l\r\u001b[?2004h"]
[3566.247041, "o", "> "]
[3566.247244, "o", "func (m Money) String() string {\r\n\u001b[?2004l\r"]
[3566.2473, "o", "\u001b[?2004h> "]
[3566.247425, "o", "  f := float64(m)\r\n\u001b[?2004l\r"]
[3566.247455, "o", "\u001b[?2004h"]
[3566.247688, "o", ">   abs := math.Abs(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.247988, "o", "  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n\u001b[?2004l\r"]
[3566.248017, "o", "\u001b[?2004h"]
[3566.248098, "o", "> "]
[3566.248245, "o", "  neg := f < 0 && cents != 0\r\n\u001b[?2004l\r"]
[3566.248327, "o", "\u001b[?2004h"]
[3566.248389, "o", "> "]
[3566.248469, "o", "  dollars := cents / 100\r\n\u001b[?2004l\r"]
[3566.248525, "o", "\u001b[?2004h> "]
[3566.248667, "o", "  rem := cents % 100\r\n\u001b[?2004l\r"]
[3566.248727, "o", "\u001b[?2004h> "]
[3566.249027, "o", "  s := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n\u001b[?2004l\r"]
[3566.249085, "o", "\u001b[?2004h> "]
[3566.249166, "o", "  if neg {\r\n\u001b[?2004l\r"]
[3566.249239, "o", "\u001b[?2004h> "]
[3566.249356, "o", "    s = \"-\" + s\r\n\u001b[?2004l\r"]
[3566.249408, "o", "\u001b[?2004h> "]
[3566.249489, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3566.249588, "o", "  return s\r\n\u001b[?2004l\r"]
[3566.249652, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[3566.249727, "o", "\u001b[?2004h> \r\n"]
