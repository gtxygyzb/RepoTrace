[18251.64159, "o", "\tfixedWindowSeconds  int\r\n\tfixedWindowSet      bool\r\n}\r\n\r\nfunc main() {\r\n\tcfg, err := parseArgs(os.Args[1:])\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(2)\r\n\t}\r\n\tif err := run(cfg); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n"]
