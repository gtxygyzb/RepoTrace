[5543.151531, "o", "   434\tfunc newRateTable() *RateTable {\r\n   435\t  return &RateTable{byDate: map[string]map[string]float64{}, global: map[string]float64{\"USD\": 1.0}}\r\n   436\t}\r\n   437\t\r\n   438\tfunc (rt *RateTable) rate(date, currency string) (float64, bool) {\r\n   439\t  if currency == \"USD\" {\r\n   440\t"]
[5543.151666, "o", "    return 1.0, true\r\n   441\t  }\r\n   442\t  if m, ok := rt.byDate[date]; ok {\r\n   443\t    if r, ok := m[currency]; ok && r > 0 {\r\n   444\t      return r, true\r\n   445\t    }\r\n   446\t  }\r\n   447\t  if r, ok := rt.global[currency]; ok && r > 0 {\r\n   448\t    return r, true\r\n   449\t  }\r\n   450\t  return 0, false\r\n"]
[5543.151736, "o", "   451\t}\r\n   452\t\r\n   453\tfunc parseRateRaw(raw json.RawMessage) (float64, error) {\r\n   454\t  var f float64\r\n   455\t  if err := json.Unmarshal(raw, &f); err == nil {\r\n   456\t    if !isFinite(f) {\r\n   457\t      return 0, errors.New(\"bad rate\")\r\n   458\t    }\r\n   459\t    return f, nil\r\n   460\t  }\r\n   461\t  var s string\r\n   462\t  if err := json.Unmarshal(raw, &s); err == nil {\r\n   463\t    return strconv.ParseFloat(s, 64)\r\n   464\t  }\r\n   465\t  return 0, errors.New(\"bad rate\")\r\n   466\t}\r\n   467\t\r\n   468\tfunc loadRateMap(rt *RateTable, raw json.RawMessage, global bool) error {\r\n   469\t  var m map[string]json.RawMessage\r\n   470\t  if err := json.Unmarshal(raw, &m); err != nil {\r\n   471\t    return err\r\n"]
[5543.151799, "o", "   472\t  }\r\n   473\t  for currency, raw2 := range m {\r\n   474\t    if currency == \"USD\" {\r\n   475\t      continue\r\n   476\t    }\r\n   477\t    r, err := parseRateRaw(raw2)\r\n   478\t    if err != nil {\r\n   479\t      return err\r\n   480\t    }\r\n   481\t    if global {\r\n   482\t      rt.global[currency] = r\r\n   483\t    } else {\r\n   484\t"]
[5543.151859, "o", "      if rt.byDate[\"global\"] == nil {\r\n   485\t        rt.byDate[\"global\"] = map[string]float64{}\r\n   486\t      }\r\n   487\t      rt.byDate[\"global\"][currency] = r\r\n   488\t    }\r\n   489\t  }\r\n   490\t  return nil\r\n   491\t}\r\n   492\t\r\n"]
