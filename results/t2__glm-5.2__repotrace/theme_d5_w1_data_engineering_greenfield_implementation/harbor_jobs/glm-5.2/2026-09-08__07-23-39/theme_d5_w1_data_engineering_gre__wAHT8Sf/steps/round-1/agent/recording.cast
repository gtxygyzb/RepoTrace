[19997.947364, "o", "   359\t\t*i++\r\n   360\t\treturn args[*i]\r\n   361\t}\r\n   362\t\r\n   363\tfunc atoiOrError(s, flag string) int {\r\n   364\t\tn, err := strconv.Atoi(s)\r\n   365\t\tif err != nil {\r\n   366\t\t\tpanic(fmt.Errorf(\"ingest: invalid integer for %s: %s\", flag, s))\r\n   367\t\t}\r\n   368\t\treturn n\r\n   369\t}\r\n   370\t\r\n   371\tfunc computeSessionCount(evs []*Event, policy string, gap, windowSecs int) int {\r\n   372\t\tif len(evs) == 0 {\r\n   373\t\t\treturn 0\r\n"]
[19997.947472, "o", "   374\t\t}\r\n   375\t\tcount := 1\r\n   376\t\tvar anchor int64\r\n   377\t\tif policy == \"fixed-window\" || policy == \"hybrid\" {\r\n   378\t\t\tanchor = floorEpochToWindow(evs[0].TS.Unix(), int64(windowSecs))\r\n   379\t\t}\r\n   380\t\tfor i := 1; i < len(evs); i++ {\r\n"]
[19997.947549, "o", "   381\t\t\tsplit := false\r\n   382\t\t\tif policy == \"gap\" || policy == \"hybrid\" {\r\n   383\t\t\t\tif evs[i].TS.Sub(evs[i-1].TS) > time.Duration(gap)*time.Second {\r\n   384\t\t\t\t\tsplit = true\r\n   385\t\t\t\t}\r\n   386\t\t\t}\r\n   387\t\t\tif policy == \"fixed-window\" || policy == \"hybrid\" {\r\n   388\t\t\t\tkPrev := floorDiv(evs[i-1].TS.Unix()-anchor, int64(windowSecs))\r\n   389\t\t\t\tkCur := floorDiv(evs[i].TS.Unix()-anchor, int64(windowSecs))\r\n   390\t\t\t\tif kPrev != kCur {\r\n   391\t\t\t\t\tsplit = true\r\n   392\t\t\t\t}\r\n   393\t\t\t}\r\n   394\t\t\tif split {\r\n   395\t\t\t\tcount++\r\n   396\t\t\t}\r\n   397\t\t}\r\n   398\t"]
[19997.947639, "o", "\treturn count\r\n   399\t}\r\n   400\t\r\n   401\tfunc floorEpochToWindow(epoch, window int64) int64 {\r\n   402\t\tif window <= 0 {\r\n   403\t\t\treturn 0\r\n   404\t\t}\r\n   405\t\treturn floorDiv(epoch, window) * window\r\n   406\t}\r\n"]
[19997.947714, "o", "   407\t\r\n   408\tfunc floorDiv(a, b int64) int64 {\r\n   409\t\tif b == 0 {\r\n   410\t\t\treturn 0\r\n   411\t\t}\r\n   412\t\tq := a / b\r\n   413\t\tif (a%b != 0) && ((a < 0) != (b < 0)) {\r\n   414\t\t\tq--\r\n   415\t\t}\r\n   416\t\treturn q\r\n   417\t}\r\n   418\t\r\n   419\tfunc ptrCutoff(c cutoffObject) *cutoffObject {\r\n"]
