[20173.065222, "o", "   103\t\tcase []orderedJSON:\r\n   104\t\t\twriteOrderedIndentObject(buf, val, indent)\r\n   105\t\tcase orderedArray:\r\n   106\t\t\twriteOrderedIndentArrayAny(buf, val, indent)\r\n   107\t\tcase []any:\r\n   108\t\t\twriteOrderedIndentArrayAny(buf, val, indent)\r\n"]
