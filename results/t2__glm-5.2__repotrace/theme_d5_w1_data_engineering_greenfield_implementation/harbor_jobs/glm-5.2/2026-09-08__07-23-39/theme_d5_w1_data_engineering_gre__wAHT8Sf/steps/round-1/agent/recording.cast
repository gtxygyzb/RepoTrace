[17097.785115, "o", "\t\treturn nil, \"missing_amount\"\r\n   367\t\t\t\t}\r\n   368\t\t\t\tvar f float64\r\n   369\t\t\t\tif err := json.Unmarshal(raw, &f); err != nil {\r\n   370\t\t\t\t\treturn nil, \"bad_amount\"\r\n   371\t\t\t\t}\r\n   372\t\t\t\tif !isFinite(f) || f < 0 {\r\n"]
[17097.78524, "o", "   373\t\t\t\t\treturn nil, \"bad_amount\"\r\n   374\t\t\t\t}\r\n   375\t\t\t\tamount = f\r\n   376\t\t\t} else {\r\n   377\t\t\t\traw, present := obj[\"amount_cents\"]\r\n   378\t\t\t\tif !present {\r\n   379\t\t\t\t\treturn nil, \"missing_amount\"\r\n   380\t\t\t\t}\r\n   381\t\t\t\tn, err := getJSONInt(raw)\r\n   382\t\t\t\tif err != nil || n < 0 {\r\n   383\t\t\t\t\treturn nil, \"bad_amount\"\r\n   384\t\t\t\t}\r\n   385\t\t\t\tamount = float64(n) / 100.0\r\n   386\t\t\t}\r\n   387\t\t\tcur, curOk, curPresent := getRawString(obj, \"currency\")\r\n   388\t\t\tif !curPresent {\r\n   389\t\t\t\treturn nil, \"missing_currency\"\r\n   390\t\t\t}\r\n   391\t\t\tif !curOk || cur == \"\" {\r\n   392\t\t\t\treturn nil, \"bad_currency\"\r\n   393\t\t\t}\r\n   394\t\t\trate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)\r\n   395\t\t\tswitch status {\r\n   396\t\t\tcase \"fx_unknown_currency\":\r\n   397\t"]
[17097.785374, "o", "\t\t\treturn nil, \"fx_unknown_currency\"\r\n   398\t\t\tcase \"missing_rate\":\r\n   399\t\t\t\treturn nil, \"fx_no_rate_for_date\"\r\n   400\t\t\tcase \"bad_rate\":\r\n   401\t\t\t\tif ratesStrict {\r\n   402\t\t\t\t\treturn nil, \"fx_bad_rate\"\r\n   403\t\t\t\t}\r\n   404\t\t\t\treturn nil, \"fx_no_rate_for_date\"\r\n   405\t\t\t}\r\n   406\t\t\tusd := amount * rate\r\n   407\t\t\tif typeStr == \"refund\" {\r\n   408\t\t\t\tusd = -usd\r\n   409\t\t\t}\r\n   410\t\t\tev.Amount = amount\r\n   411\t\t\tev.Currency = cur\r\n   412\t\t\tev.FXFallbackDays = fallbackDays\r\n   413\t\t\tev.USD = roundMoney(usd)\r\n   414\t\tcase \"chargeback\":\r\n   415"]
[17097.785454, "o", "\t\t\tref, refOk, refPresent := getRawString(obj, \"ref_id\")\r\n   416\t\t\tif !refPresent || !refOk || ref == \"\" {\r\n   417\t\t\t\treturn nil, \"missing_ref_id\"\r\n   418\t\t\t}\r\n   419\t\t\tev.RefID = ref\r\n   420\t\t\tev.USD = 0\r\n   421\t\tcase \"login\", \"signup\":\r\n   422\t\t\tev.USD = 0\r\n   423\t\t}\r\n   424\t\treturn ev, \"\"\r\n   425\t}\r\n"]
