[14533.215683, "o", "   484\t}\r\n   485\t\r\n   486\tfunc buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {\r\n   487\t\tout := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}\r\n   488\t\tif hasCurrentMax {\r\n   489\t\t\ts := formatTS(currentMax)\r\n   490\t\t\tout.Watermark.MaxTS = &s\r\n   491\t\t} else if st != nil && st.hasMax {\r\n"]
[14533.215753, "o", "   492\t\t\ts := formatTS(st.maxTs)\r\n   493\t\t\tout.Watermark.MaxTS = &s\r\n   494\t\t}\r\n   495\t\tb, _ := json.MarshalIndent(out, \"\", \"  \")\r\n   496\t\tb = append(b, '\\n')\r\n   497\t\treturn b\r\n   498\t}\r\n   499\t\r\n   500\tfunc statePendingOutList(pending []pendingEntry) []statePendingOut {\r\n   501\t\tout := make([]statePendingOut, 0, len(pending))\r\n   502\t\tfor _, p := range pending {\r\n"]
