[17114.956675, "o", "   258\tfunc readInputEvents(inputDir string) ([]rawEvent, []rawEvent, []inputShardInfo, error) {\r\n   259\t\tinfo, err := os.Stat(inputDir)\r\n   260\t\tif err != nil {\r\n   261\t\t\treturn nil, nil, nil, err\r\n   262\t\t}\r\n"]
[17114.956779, "o", "   263\t\tif !info.IsDir() {\r\n   264\t\t\treturn nil, nil, nil, errors.New(\"input-dir is not a directory\")\r\n   265\t\t}\r\n   266\t\tentries, err := os.ReadDir(inputDir)\r\n   267\t\tif err != nil {\r\n   268\t\t\treturn nil, nil, nil, err\r\n   269\t\t}\r\n   270\t\tvar files []string\r\n   271\t\tfor _, e := range entries {\r\n   272\t\t\tif e.IsDir() || !e.Type().IsRegular() {\r\n   273\t\t\t\tcontinue\r\n   274\t\t\t}\r\n   275\t\t\tfiles = append(files, e.Name())\r\n   276\t\t}\r\n"]
[17114.956853, "o", "   277\t\tsort.Strings(files)\r\n   278\t\tvar events []rawEvent\r\n   279\t\tvar blanks []rawEvent\r\n   280\t\tvar shards []inputShardInfo\r\n   281\t\tfor _, name := range files {\r\n   282\t\t\tdata, err := os.ReadFile(filepath.Join(inputDir, name))\r\n   283\t\t\tif err != nil {\r\n   284\t\t\t\treturn nil, nil, nil, err\r\n   285\t\t\t}\r\n"]
[17114.956917, "o", "   286\t\t\tsi := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}\r\n   287\t\t\tlineNo := 0\r\n   288\t\t\tfor _, line := range bytes.Split(data, []byte{'\\n'}) {\r\n   289\t\t\t\tlineNo++\r\n   290\t\t\t\ttrimmed := bytes.TrimSpace(line)\r\n   291\t\t\t\tif len(trimmed) == 0 {\r\n   292\t\t\t\t\tblanks = append(blanks, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Blank: true})\r\n   293\t\t\t\t\tcontinue\r\n"]
[17114.956979, "o", "   294\t\t\t\t}\r\n   295\t\t\t\tsi.EventsTotal++\r\n   296\t\t\t\tvar obj map[string]json.RawMessage\r\n   297\t\t\t\tinvalid := false\r\n   298\t\t\t\tif err := json.Unmarshal(trimmed, &obj); err != nil {\r\n   299\t\t\t\t\tinvalid = true\r\n   300\t\t\t\t}\r\n   301\t\t\t\tevents = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})\r\n   302\t\t\t}\r\n"]
[17114.957038, "o", "   303\t\t\tshards = append(shards, si)\r\n   304\t\t}\r\n   305\t\treturn events, blanks, shards, nil\r\n   306\t}\r\n   307\t\r\n   308\tfunc newContext(raw rawEvent) *eventContext {\r\n   309\t\tctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n   310\t\t"]
[17114.957111, "o", "if raw.Obj != nil {\r\n   311\t\t\tctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n   312\t\t\tctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n   313\t\t\tctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n   314\t\t}\r\n   315\t\treturn ctx\r\n   316\t}\r\n   317\t\r\n   318\tfunc parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {\r\n   319\t\tobj := ctx.Obj\r\n"]
[17114.957175, "o", "   320\t\tif obj == nil {\r\n   321\t\t\treturn nil, \"invalid_json\"\r\n   322\t\t}\r\n   323\t\traw, ok := obj[\"v\"]\r\n   324\t\tif !ok {\r\n   325\t\t\treturn nil, \"schema_version\"\r\n   326\t\t}\r\n   327\t\tvar v int\r\n   328\t"]
[17114.957255, "o", "\tif err := json.Unmarshal(raw, &v); err != nil {\r\n   329\t\t\treturn nil, \"schema_version\"\r\n   330\t\t}\r\n   331\t\tif v != 1 && v != 2 {\r\n   332\t\t\treturn nil, \"schema_version\"\r\n   333\t\t}\r\n   334\t\tid, idOk, _ := getRawString(obj, \"id\")\r\n   335\t\tif !idOk || id == \"\" {\r\n   336\t\t\treturn nil, \"missing_id\"\r\n"]
[17114.957336, "o", "   337\t\t}\r\n   338\t\ttsStr, tsOk, _ := getRawString(obj, \"ts\")\r\n   339\t\tif !tsOk {\r\n   340\t\t\treturn nil, \"missing_ts\"\r\n   341\t\t}\r\n   342\t\tt, err := parseTime(tsStr)\r\n   343\t\tif err != nil {\r\n   344\t\t\treturn nil, \"bad_ts\"\r\n   345\t\t}\r\n   346\t\ttypeStr, typeOk, _ := getRawString(obj, \"type\")\r\n   347\t\tif !typeOk {\r\n"]
[17114.957405, "o", "   348\t\t\treturn nil, \"missing_type\"\r\n   349\t\t}\r\n   350\t\tswitch typeStr {\r\n   351\t\tcase \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\n   352\t\tdefault:\r\n   353\t\t\treturn nil, \"bad_type\"\r\n   354\t\t}\r\n   355\t\tuser, userOk, _ := getRawString(obj, \"user_id\")\r\n   356"]
[17114.957461, "o", "\t\tif !userOk || user == \"\" {\r\n   357\t\t\treturn nil, \"missing_user\"\r\n   358\t\t}\r\n   359\t\tev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n   360\t\tswitch typeStr {\r\n"]
