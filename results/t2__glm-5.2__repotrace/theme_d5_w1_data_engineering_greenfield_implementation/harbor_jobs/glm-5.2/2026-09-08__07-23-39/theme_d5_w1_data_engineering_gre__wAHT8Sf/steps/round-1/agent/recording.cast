[14552.287847, "o", "   383\t\t}\r\n   384\t\r\n   385\t\t// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.\r\n   386\t\tgroups := map[string][]int{}\r\n   387\t\tfor i, c := range candidates {\r\n   388\t\t\tif c.ev != nil {\r\n   389\t\t\t\tgroups[c.ev.ID] = append(groups[c.ev.ID], i)\r\n   390\t\t\t}\r\n   391\t\t}\r\n   392\t\twinnerSet := map[int]bool{}\r\n   393\t\twinners := map[string]int{}\r\n   394\t\tvar dedupPolicyStats dedupPolicyStats\r\n   395\t\tdedupPolicyStats.Policy = cfg.dedupPolicy\r\n   396\t\tfor id, idxs := range groups {\r\n   397\t\t\tif len(idxs) < 2 {\r\n   398\t\t\t\tif len(idxs) == 1 {\r\n   399\t\t\t\t\twinners[id] = idxs[0]\r\n"]
