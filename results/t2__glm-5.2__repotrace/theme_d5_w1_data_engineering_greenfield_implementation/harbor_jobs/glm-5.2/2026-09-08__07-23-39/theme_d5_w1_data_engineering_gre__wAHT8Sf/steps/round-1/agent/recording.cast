[19917.080558, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t\"time\"\r\n)\r\n\r\n"]
[19917.080651, "o", "type rawJSON json.RawMessage\r\n\r\nfunc (r rawJSON) MarshalJSON() ([]byte, error) {\r\n\tif json.Valid(r) {\r\n\t\treturn r, nil\r\n\t}\r\n\treturn json.Marshal(string(r))\r\n}\r\n\r\ntype rawEvent struct {\r\n\tShard   string\r\n\tLine    int\r\n\tRaw     rawJSON\r\n\tObj     map[string]json.RawMessage\r\n\tInvalid bool\r\n\tBlank   bool\r\n}\r\n\r\ntype eventContext struct {\r\n"]
[19917.080725, "o", "\tShard string\r\n\tLine  int\r\n\tRaw   rawJSON\r\n\tObj   map[string]json.RawMessage\r\n\tID    *string\r\n\tTS    *string\r\n\tType  *string\r\n}\r\n\r\ntype inputShardInfo struct {\r\n\tName           string\r\n\tBytes          int64\r\n"]
[19917.080787, "o", "\tSHA256         string\r\n\tEventsTotal    int\r\n\tEventsAccepted int\r\n}\r\n\r\ntype loadedState struct {\r\n\tversion             int\r\n\thasMax              bool\r\n\tmaxTs               time.Time\r\n\tseenIds             map[string]bool\r\n\tpending             []pendingEntry\r\n\topenSessions        map[string]carriedSession\r\n"]
[19917.080853, "o", "\trunIndex            int\r\n\tcarryInPending      int\r\n\tcarryInOpenSessions int\r\n}\r\n\r\ntype pendingEntry struct {\r\n\tid             string\r\n\tts             time.Time\r\n\tfirstSeenEpoch int\r\n\tuser           string\r\n\tusd            float64\r\n"]
[19917.080913, "o", "\toriginRun      int\r\n}\r\n\r\ntype carriedSession struct {\r\n\tuser         string\r\n\tlastTs       time.Time\r\n\tsessionIndex int\r\n\tstartTs      time.Time\r\n}\r\n\r\ntype stateWatermarkOut struct {\r\n\tMaxTS *string `json:\"max_ts\"`\r\n}\r\n\r\n"]
[19917.081, "o", "type stateFileOut struct {\r\n\tVersion          int                   `json:\"version\"`\r\n\tWatermark        stateWatermarkOut     `json:\"watermark\"`\r\n\tSeenIDs          []string              `json:\"seen_ids\"`\r\n\tPendingPurchases []statePendingOut     `json:\"pending_purchases\"`\r\n\tOpenSessions     []stateOpenSessionOut `json:\"open_sessions\"`\r\n\tRunIndex         int                   `json:\"run_index\"`\r\n}\r\n\r\ntype statePendingOut struct {\r\n\tID                string `json:\"id\"`\r\n\tTS                string `json:\"ts\"`\r\n\tFirstSeenEpoch    int    `json:\"first_seen_epoch\"`\r\n\tfirstSeenEpochSet bool\r\n\tUser              string `json:\"user\"`\r\n"]
[19917.08106, "o", "\tUSD               Money  `json:\"usd\"`\r\n\tOriginRun         int    `json:\"origin_run\"`\r\n}\r\n\r\ntype stateOpenSessionOut struct {\r\n\tUser         string `json:\"user\"`\r\n\tLastTS       string `json:\"last_ts\"`\r\n\tSessionIndex int    `json:\"session_index\"`\r\n\tStartTS      string `json:\"start_ts\"`\r\n}\r\n\r\n"]
[19917.08112, "o", "type summarySessions struct {\r\n\tTotal  int                  `json:\"total\"`\r\n\tByUser []summarySessionUser `json:\"by_user\"`\r\n}\r\n\r\ntype summarySessionUser struct {\r\n\tUser  string `json:\"user\"`\r\n\tCount int    `json:\"count\"`\r\n}\r\n\r\ntype summaryOutput struct {\r\n\tTotalEvents    int            `json:\"total_events\"`\r\n"]
[19917.081177, "o", "\tAcceptedEvents int            `json:\"accepted_events\"`\r\n\tRejectedEvents int            `json:\"rejected_events\"`\r\n\tTotalUSD       Money          `json:\"total_usd\"`\r\n\tAnomalies      map[string]int `json:\"anomalies\"`\r\n\tRunIndex       int            `json:\"run_index\"`\r\n\tWatermark      *string        `json:\"watermark\"`\r\n\tSessions       summarySessions `json:\"sessions\"`\r\n}\r\n"]
[19917.081249, "o", "\r\ntype auditLogEntry struct {\r\n\tShard               string         `json:\"shard\"`\r\n\tLine                int            `json:\"line\"`\r\n\tID                  string         `json:\"id\"`\r\n\tTS                  string         `json:\"ts\"`\r\n\tType                string         `json:\"type\"`\r\n"]
[19917.081311, "o", "\tBucket              string         `json:\"bucket\"`\r\n\tReason              string         `json:\"reason\"`\r\n\tWinnerArrival       *winnerArrival `json:\"winner_arrival,omitempty\"`\r\n\tEvent               rawJSON        `json:\"event\"`\r\n\tCutoff              *cutoffObject  `json:\"cutoff,omitempty\"`\r\n\tWatermarkLagSeconds *int           `json:\"watermark_lag_seconds,omitempty\"`\r\n\tLateBySeconds       *int           `json:\"late_by_seconds,omitempty\"`\r\n}\r\n\r\ntype cutoffObject struct {\r\n\tValue        string `json:\"value\"`\r\n"]
[19917.081368, "o", "\tEpochSeconds int    `json:\"epoch_seconds\"`\r\n}\r\n\r\nfunc (e auditLogEntry) MarshalJSON() ([]byte, error) {\r\n\tif e.Bucket == \"late\" {\r\n\t\tvar buf bytes.Buffer\r\n\t\tbuf.WriteString(`{\"id\":`)\r\n\t\tb, err := json.Marshal(e.ID)\r\n\t\tif err != nil {\r\n\t\t\t"]
[19917.081425, "o", "return nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"ts\":`)\r\n\t\tb, err = json.Marshal(e.TS)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n"]
[19917.081482, "o", "\t\tbuf.WriteString(`,\"type\":`)\r\n\t\tb, err = json.Marshal(e.Type)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"shard\":`)\r\n\t\tb, err = json.Marshal(e.Shard)\r\n\t"]
[19917.08154, "o", "\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"line\":`)\r\n\t\tb, err = json.Marshal(e.Line)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n"]
[19917.081595, "o", "\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"bucket\":`)\r\n\t\tb, err = json.Marshal(e.Bucket)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\tbuf.WriteString(`,\"cutoff\":`)\r\n"]
[19917.081663, "o", "\t\tif e.Cutoff != nil {\r\n\t\t\tb, err = json.Marshal(e.Cutoff)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t\tb = []byte(\"null\")\r\n\t\t}\r\n\t\tbuf.Write(b)\r\n\t\t"]
[19917.081721, "o", "if e.WatermarkLagSeconds != nil {\r\n\t\t\tbuf.WriteString(`,\"watermark_lag_seconds\":`)\r\n\t\t\tb, err = json.Marshal(*e.WatermarkLagSeconds)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tbuf.Write(b)\r\n\t\t}\r\n\t\tif e.LateBySeconds != nil {\r\n"]
[19917.081779, "o", "\t\t\tbuf.WriteString(`,\"late_by_seconds\":`)\r\n\t\t\tb, err = json.Marshal(*e.LateBySeconds)\r\n\t\t\tif err != nil {\r\n\t\t\t\treturn nil, err\r\n\t\t\t}\r\n\t\t\tbuf.Write(b)\r\n\t\t}\r\n\t\tbuf.WriteByte('}')\r\n"]
[19917.08184, "o", "\t\treturn buf.Bytes(), nil\r\n\t}\r\n\ttype alias auditLogEntry\r\n\treturn json.Marshal(alias(e))\r\n}\r\n\r\ntype winnerArrival struct {\r\n\tShard string `json:\"shard\"`\r\n\tLine  int    `json:\"line\"`\r\n}\r\n\r\n"]
[19917.081895, "o", "type rejectsCrossCheck struct {\r\n\tRejectsRowCount        int  `json:\"rejects_row_count\"`\r\n\tAuditRejectRecordCount int  `json:\"audit_reject_record_count\"`\r\n\tAgree                  bool `json:\"agree\"`\r\n}\r\n\r\ntype dedupPolicyStats struct {\r\n\tPolicy                       string `json:\"policy\"`\r\n\tDuplicateWinnersSameShard    int    `json:\"duplicate_winners_same_shard\"`\r\n\t"]
[19917.081957, "o", "DuplicateWinnersCrossShard   int    `json:\"duplicate_winners_cross_shard\"`\r\n\tDuplicateWinnersLineTiebreak int    `json:\"duplicate_winners_line_tiebreak\"`\r\n}\r\n\r\ntype auditDigestOutput struct {\r\n\tSchemaVersion     string             `json:\"schema_version\"`\r\n\tAuditLog          json.RawMessage    `json:\"audit_log\"`\r\n\tTotalRecords      int                `json:\"total_records\"`\r\n\tBucketCounts      map[string]int     `json:\"bucket_counts\"`\r\n\tInvalidReasons    map[string]int     `json:\"invalid_reasons\"`\r\n\tDuplicateReasons  map[string]int     `json:\"duplicate_reasons\"`"]
[19917.08202, "o", "\r\n\tLateCutoffStats   lateCutoffStats    `json:\"late_cutoff_stats\"`\r\n\tResolvedAgainst   string             `json:\"resolved_against\"`\r\n\tDedupPolicyStats  *dedupPolicyStats  `json:\"dedup_policy_stats,omitempty\"`\r\n\tFXFallbackStats   map[string]int     `json:\"fx_fallback_stats\"`\r\n\tRatesDigest       string             `json:\"rates_digest\"`\r\n\tRejectsCrossCheck *rejectsCrossCheck `json:\"rejects_cross_check,omitempty\"`\r\n\tSHA256            string             `json:\"sha256,omitempty\"`\r\n\tSHA256Segments    []string           `json:\"sha256_segments,omitempty\"`\r\n}\r\n\r\n"]
[19917.082079, "o", "type lateCutoffStats struct {\r\n\tCount          int `json:\"count\"`\r\n\tMinCutoffEpoch int `json:\"min_cutoff_epoch\"`\r\n\tMaxCutoffEpoch int `json:\"max_cutoff_epoch\"`\r\n}\r\n\r\ntype manifestOutput struct {\r\n\tSchemaVersion string          `json:\"schema_version\"`\r\n\tIngestID      *string         `json:\"ingest_id\"`\r\n\tRunIndex      int             `json:\"run_index\"`\r\n\tRatesDigest   string          `json:\"rates_digest\"`\r\n"]
[19917.082137, "o", "\tInputShards   []manifestShard `json:\"input_shards\"`\r\n\tOutputs       manifestOutputs `json:\"outputs\"`\r\n\tWindow        manifestWindow  `json:\"window\"`\r\n}\r\n\r\ntype manifestShard struct {\r\n\tShard          string `json:\"shard\"`\r\n\tSHA256         string `json:\"sha256\"`\r\n\tBytes          int64  `json:\"bytes\"`\r\n\tEventsTotal    int    `json:\"events_total\"`\r\n"]
[19917.082211, "o", "\tEventsAccepted int    `json:\"events_accepted\"`\r\n}\r\n\r\ntype manifestFileOutput struct {\r\n\tPath        string `json:\"path\"`\r\n\tSHA256      string `json:\"sha256\"`\r\n\tSHA256Short string `json:\"sha256_short\"`\r\n\tBytes       int64  `json:\"bytes\"`\r\n}\r\n\r\ntype manifestOutputs struct {\r\n"]
[19917.082269, "o", "\tSummary     *manifestFileOutput `json:\"summary\"`\r\n\tRejects     *manifestFileOutput `json:\"rejects\"`\r\n\tState       *manifestFileOutput `json:\"state\"`\r\n\tAuditLog    *manifestFileOutput `json:\"audit_log\"`\r\n\tAuditDigest *manifestFileOutput `json:\"audit_digest\"`\r\n}\r\n\r\ntype manifestWindow struct {\r\n\tMinTs               *string        `json:\"min_ts\"`\r\n\tMaxTs               *string        `json:\"max_ts\"`\r\n"]
[19917.082325, "o", "\tEventsAcceptedTotal int            `json:\"events_accepted_total\"`\r\n\tEventsRejectedTotal int            `json:\"events_rejected_total\"`\r\n\tBucketCounts        map[string]int `json:\"bucket_counts\"`\r\n}\r\n\r\ntype signatureOutput struct {\r\n\tManifestPath   string `json:\"manifest_path\"`\r\n\tManifestSHA256 string `json:\"manifest_sha256\"`\r\n\tManifestBytes  int64  `json:\"manifest_bytes\"`\r\n"]
[19917.082379, "o", "\tSignedAtUTC    string `json:\"signed_at_utc\"`\r\n\tToolVersion    string `json:\"tool_version\"`\r\n}\r\n\r\nconst toolVersion = \"eventq/0.5.0\"\r\nconst manifestSchemaVersion = \"eventq.manifest/v1\"\r\n"]
