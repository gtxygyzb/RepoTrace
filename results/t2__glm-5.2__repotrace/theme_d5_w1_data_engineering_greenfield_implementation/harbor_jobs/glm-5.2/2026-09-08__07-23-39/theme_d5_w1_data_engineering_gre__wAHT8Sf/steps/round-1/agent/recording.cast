[16313.749527, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut    string\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest string\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaStrict bool\r\n"]
[16313.749599, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaIndex  string\r\n"]
[16313.749664, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc main\u001b[m\u001b[K() {\r\n"]
[16313.749749, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc parseArgs\u001b[m\u001b[K(args []string) (cfg cliConfig, err error) {\r\n"]
[16313.74981, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[KsessionGap\u001b[m\u001b[K:        600,\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tmaxOpen\u001b[01;31m\u001b[KSession\u001b[m\u001b[Ks:   100000,\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif strings.HasPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out=\") {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut = strings.TrimPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out=\")\r\n"]
[16313.749883, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut == \"\" {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-out: value must be non-empty\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif strings.HasPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-digest=\") {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest = strings.TrimPrefix(arg, \"--\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K-schema-digest=\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest == \"\" {\r\n"]
