[8093.997142, "o", "\t\t\t}\r\n   417\t\t\tev.RefID = ref\r\n   418\t\t\tev.USD = 0\r\n   419\t\tcase \"login\", \"signup\":\r\n   420\t\t\tev.USD = 0\r\n   421\t\t}\r\n   422\t\treturn ev, \"\"\r\n   423\t}\r\n   424\t\r\n   425\ttype stateFileIn struct {\r\n   426\t\tVersion          int                   `json:\"version\"`\r\n"]
[8093.997273, "o", "   427\t\tWatermark        stateWatermarkOut     `json:\"watermark\"`\r\n   428\t\tSeenIDs          []string              `json:\"seen_ids\"`\r\n   429\t\tPendingPurchases []statePendingOut     `json:\"pending_purchases\"`\r\n   430\t\tOpenSessions     []stateOpenSessionOut `json:\"open_sessions\"`\r\n   431\t\tRunIndex         int                   `json:\"run_index\"`\r\n   432\t}\r\n   433\t\r\n   434\tfunc loadState(path string) (*loadedState, error) {\r\n   435\t\tdata, err := os.ReadFile(path)\r\n   436\t\tif err != nil {\r\n   437\t\t\treturn nil, err\r\n   438\t\t}\r\n   439\t\tvar sin stateFileIn\r\n   440\t\tif err := json.Unmarshal(data, &sin); err != nil {\r\n   441\t\t\treturn nil, err\r\n   442\t\t}\r\n   443\t\t"]
[8093.99735, "o", "st := &loadedState{\r\n   444\t\t\tversion:      sin.Version,\r\n   445\t\t\tseenIds:      map[string]bool{},\r\n   446\t\t\trunIndex:     sin.RunIndex,\r\n   447\t\t\topenSessions: map[string]carriedSession{},\r\n   448\t\t}\r\n   449\t\tif sin.Watermark.MaxTS != nil {\r\n   450\t\t\tt, err := parseTime(*sin.Watermark.MaxTS)\r\n   451\t\t\tif err != nil {\r\n   452\t\t\t\treturn nil, fmt.Errorf(\"bad state watermark: %w\", err)\r\n   453\t\t\t}\r\n   454\t\t\tst.hasMax = true\r\n"]
[8093.997425, "o", "   455\t\t\tst.maxTs = t\r\n   456\t\t}\r\n   457\t\tfor _, id := range sin.SeenIDs {\r\n   458\t\t\tst.seenIds[id] = true\r\n   459\t\t}\r\n   460\t\tfor _, p := range sin.PendingPurchases {\r\n   461\t\t\tt, err := parseTime(p.TS)\r\n   462\t\t\tif err != nil {\r\n   463\t\t\t\treturn nil, fmt.Errorf(\"bad pending purchase ts: %w\", err)\r\n   464\t\t\t}\r\n"]
[8093.997505, "o", "   465\t\t\tst.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, user: p.User, usd: float64(p.USD), originRun: p.OriginRun})\r\n   466\t\t}\r\n   467\t\tfor _, s := range sin.OpenSessions {\r\n   468\t\t\tlast, err := parseTime(s.LastTS)\r\n   469\t\t\tif err != nil {\r\n   470\t\t\t\treturn nil, fmt.Errorf(\"bad open session last_ts: %w\", err)\r\n   471\t\t\t}\r\n   472\t\t\tstart, err := parseTime(s.StartTS)\r\n   473\t\t\tif err != nil {\r\n   474\t\t\t\treturn nil, fmt.Errorf(\"bad open session start_ts: %w\", err)\r\n   475\t\t\t}\r\n"]
[8093.997586, "o", "   476\t\t\tst.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}\r\n   477\t\t}\r\n   478\t\tst.carryInPending = len(st.pending)\r\n   479\t\tst.carryInOpenSessions = len(st.openSessions)\r\n   480\t\treturn st, nil\r\n   481\t}\r\n   482\t\r\n   483\tfunc buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {\r\n   484\t\tout := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}\r\n   485\t\tif hasCurrentMax {\r\n   486\t\t\ts := formatTS(currentMax)\r\n   487\t\t\tout.Watermark.MaxTS = &s\r\n"]
[8093.997664, "o", "   488\t\t} else if st != nil && st.hasMax {\r\n   489\t\t\ts := formatTS(st.maxTs)\r\n   490\t\t\tout.Watermark.MaxTS = &s\r\n   491\t\t}\r\n   492\t\tb, _ := json.MarshalIndent(out, \"\", \"  \")\r\n   493\t\tb = append(b, '\\n')\r\n   494\t\treturn b\r\n   495\t}\r\n   496\t\r\n   497\tfunc statePendingOutList(pending []pendingEntry) []statePendingOut {\r\n   498\t\tout := make([]statePendingOut, 0, len(pending))\r\n"]
[8093.997745, "o", "   499\t\tfor _, p := range pending {\r\n   500\t\t\tout = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), User: p.user, USD: Money(p.usd), OriginRun: p.originRun})\r\n   501\t\t}\r\n   502\t\treturn out\r\n   503\t}\r\n   504\t\r\n   505\tfunc stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {\r\n   506\t\tout := make([]stateOpenSessionOut, 0, len(sessions))\r\n   507\t\tfor _, s := range sessions {\r\n   508\t\t\tout = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})\r\n   509\t\t"]
[8093.997822, "o", "}\r\n   510\t\treturn out\r\n   511\t}\r\n   512\t\r\n   513\tfunc sortedSeenIDs(seen map[string]bool) []string {\r\n   514\t\tids := make([]string, 0, len(seen))\r\n   515\t\tfor id := range seen {\r\n   516\t\t\tids = append(ids, id)\r\n   517\t\t}\r\n   518\t\tsort.Strings(ids)\r\n   519\t\treturn ids\r\n"]
[8093.997931, "o", "   520\t}\r\n   521\t\r\n   522\tfunc sortedPending(pending []pendingEntry) []pendingEntry {\r\n   523\t\tout := append([]pendingEntry(nil), pending...)\r\n   524\t\tsort.SliceStable(out, func(i, j int) bool {\r\n   525\t\t\tif out[i].ts.Equal(out[j].ts) {\r\n   526\t\t\t\treturn out[i].id < out[j].id\r\n   527\t\t\t}\r\n   528\t\t\treturn out[i].ts.Before(out[j].ts)\r\n   529\t\t})\r\n   530\t\treturn out\r\n   531\t}\r\n   532\t\r\n   533\tfunc sortedOpenSessions(m map[string]carriedSession) []carriedSession {\r\n   534\t\tout := make([]carriedSession, 0, len(m))\r\n"]
[8093.99801, "o", "   535\t\tfor _, s := range m {\r\n   536\t\t\tout = append(out, s)\r\n   537\t\t}\r\n   538\t\tsort.SliceStable(out, func(i, j int) bool {\r\n   539\t\t\tif out[i].lastTs.Equal(out[j].lastTs) {\r\n   540\t\t\t\treturn out[i].user < out[j].user\r\n   541\t\t\t}\r\n   542\t\t\treturn out[i].lastTs.Before(out[j].lastTs)\r\n   543\t\t})\r\n   544\t\treturn out\r\n   545\t}\r\n"]
[8093.998083, "o", "   546\t\r\n   547\tfunc sortedCarriedSessions(m map[string]carriedSession) []carriedSession {\r\n   548\t\treturn sortedOpenSessions(m)\r\n   549\t}\r\n"]
