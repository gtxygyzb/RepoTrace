[9328.640407, "o", "For(cfg.auditLogDigest)\r\n   396  \t\tif err != nil {\r\n   397  \t\t\treturn manifestOutput{}, err\r\n   398  \t\t}\r\n   399  \t\toutputs.AuditDigest = digestOut\r\n   400  \t}\r\n   401  \twindow := manifestWindow{\r\n   402  \t\tEventsAcceptedTotal: bucketCounts[\"accepted\"],\r\n   403  \t\tEventsRejectedTotal: bucketCounts[\"duplicate\"] + bucketCounts[\"invalid\"] + bucketCounts[\"late\"] + bucketCounts[\"unresolved_chargeback\"],\r\n   404  \t\tBucketCounts:        bucketCounts,\r\n   405  \t}\r\n   406  \tif hasMin {\r\n   407  \t\tm := formatTS(minTs)\r\n   408  \t\twindow.MinTs = &m\r\n   409  \t}\r\n   410  \tif hasMax {\r\n   411  \t\tm := formatTS(maxTs)\r\n   412  \t\twindow.MaxTs = &m\r\n   413  \t}\r\n   414  \tvar ingestID *string\r\n   415  \tif cfg.ingestIDSet {\r\n   416  \t\tid := cfg.ingestID\r\n   417  \t\tingestID = &id\r\n   418  \t}\r\n   419  \treturn manifestOutput{\r\n   420  \t\tSchemaVersion: manifestSchemaVersion,\r\n   421  \t\tIngestID:      ingestID,\r\n   422  \t\tRunIndex:      runIndex,\r\n   423  \t\tRatesDigest:   ratesDigest,\r\n   424  \t\tInputShards:   manifestShards,\r\n   425  "]
