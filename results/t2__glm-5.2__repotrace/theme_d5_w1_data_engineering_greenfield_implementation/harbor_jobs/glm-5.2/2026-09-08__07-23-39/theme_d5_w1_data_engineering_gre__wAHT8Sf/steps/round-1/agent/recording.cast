[10901.315739, "o", "   116\t\t\t\tif val != \"first-arrival\" && val != \"lex-largest-ts\" {\r\n   117\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --dedup-policy: must be one of {first-arrival, lex-largest-ts}\")\r\n   118\t\t\t\t}\r\n   119\t\t\t\tcfg.dedupPolicy = val\r\n   120\t\t\t\tcfg.dedupPolicySet = true\r\n   121\t\t\tdefault:\r\n   122\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: unknown flag %s\", arg)\r\n   123\t\t\t}\r\n   124\t\t\tif strings.HasPrefix(arg, \"--\") && arg != \"--rates-strict\" {\r\n   125\t\t\t\tif _, ok := required[arg]; ok {\r\n   126\t\t\t\t\trequired[arg] = true\r\n   127\t\t\t\t}\r\n   128\t\t\t}\r\n   129\t\t}\r\n   130\t\tfor k, ok := range required {\r\n   131\t\t\tif !ok {\r\n   132\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: %s is required\", k)\r\n   133\t\t\t}\r\n   134\t\t}\r\n   135\t\tif cfg.ingestIDSet {\r\n   136\t\t\tif len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {\r\n   137\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)\")\r\n   138\t\t\t}\r\n   139\t\t}\r\n"]
