[10874.670381, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t"]
[10874.670474, "o", "\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"regexp\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t\t\"time\"\r\n    14\t)\r\n    15\t\r\n    16\tvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n    17\t\r\n    18\ttype cliConfig struct {\r\n    19\t\tinputDir          string\r\n"]
[10874.67055, "o", "    20\t\tratesPath         string\r\n    21\t\toutputPath        string\r\n    22\t\trejectsPath       string\r\n    23\t\tsessionGap        int\r\n    24\t\twatermarkLag      int\r\n    25\t\tstateIn           string\r\n    26\t\tstateOut          string\r\n    27\t\tpendingTTL        int\r\n    28\t\tmaxOpenSessions   int\r\n    29\t\tauditLog          string\r\n    30\t\tauditLogDigest    string\r\n    31\t\tratesStrict       bool\r\n"]
[10874.670635, "o", "    32\t\tratesMaxStaleness int\r\n    33\t\tingestID          string\r\n    34\t\tingestIDSet       bool\r\n    35\t\toutManifest       string\r\n    36\t\tmanifestSignature string\r\n    37\t\tdedupPolicy       string\r\n    38\t\tdedupPolicySet    bool\r\n    39\t}\r\n    40\t\r\n    41\tfunc main() {\r\n    42\t\tcfg, err := parseArgs(os.Args[1:])\r\n    43\t\tif err != nil {\r\n"]
[10874.670694, "o", "    44\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    45\t\t\tos.Exit(2)\r\n    46\t\t}\r\n    47\t\tif err := run(cfg); err != nil {\r\n    48\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    49\t\t\tos.Exit(1)\r\n    50\t\t}\r\n    51\t}\r\n    52\t\r\n"]
[10874.670753, "o", "    53\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n    54\t\tdefer func() {\r\n    55\t\t\tif r := recover(); r != nil {\r\n    56\t\t\t\tcfg = cliConfig{}\r\n    57\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n    58\t\t\t}\r\n    59\t\t}()\r\n    60\t\tcfg = cliConfig{\r\n    61\t\t\tsessionGap:        600,\r\n"]
[10874.670817, "o", "    62\t\t\twatermarkLag:      300,\r\n    63\t\t\tpendingTTL:        86400,\r\n    64\t\t\tmaxOpenSessions:   100000,\r\n    65\t\t\tratesMaxStaleness: 0,\r\n    66\t\t}\r\n    67\t\trequired := map[string]bool{\r\n    68\t\t\t\"--input-dir\": false,\r\n    69\t\t\t\"--rates\":     false,\r\n    70\t\t\t\"--output\":    false,\r\n    71\t\t\t\"--rejects\":   false,\r\n    72\t\t}\r\n"]
[10874.670882, "o", "    73\t\tif len(args) > 0 && args[0] == \"ingest\" {\r\n    74\t\t\targs = args[1:]\r\n    75\t\t}\r\n    76\t\tfor i := 0; i < len(args); i++ {\r\n    77\t\t\targ := args[i]\r\n    78\t\t\tswitch arg {\r\n    79\t\t\tcase \"--input-dir\":\r\n    80\t\t\t\tcfg.inputDir = nextArg(args, &i)\r\n"]
[10874.67094, "o", "    81\t\t\tcase \"--rates\":\r\n    82\t\t\t\tcfg.ratesPath = nextArg(args, &i)\r\n    83\t\t\tcase \"--output\":\r\n    84\t\t\t\tcfg.outputPath = nextArg(args, &i)\r\n    85\t\t\tcase \"--rejects\":\r\n    86\t\t\t\tcfg.rejectsPath = nextArg(args, &i)\r\n    87\t\t\tcase \"--session-gap\":\r\n    88\t\t\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\r\n    89\t\t\tcase \"--watermark-lag\":\r\n"]
[10874.670999, "o", "    90\t\t\t\tcfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")\r\n    91\t\t\tcase \"--state-in\":\r\n    92\t\t\t\tcfg.stateIn = nextArg(args, &i)\r\n    93\t\t\tcase \"--state-out\":\r\n    94\t\t\t\tcfg.stateOut = nextArg(args, &i)\r\n    95\t\t\tcase \"--pending-ttl\":\r\n    96\t\t\t\tcfg.pendingTTL = atoiOrError(nextArg(args, &i), \"--pending-ttl\")\r\n    97\t\t\tcase \"--max-open-sessions\":\r\n"]
[10874.671056, "o", "    98\t\t\t\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-sessions\")\r\n    99\t\t\tcase \"--audit-log\":\r\n   100\t\t\t\tcfg.auditLog = nextArg(args, &i)\r\n   101\t\t\tcase \"--audit-log-digest\":\r\n   102\t\t\t\tcfg.auditLogDigest = nextArg(args, &i)\r\n   103\t\t\tcase \"--rates-strict\":\r\n   104\t\t\t\t"]
