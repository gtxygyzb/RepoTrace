[13517.242736, "i", "case int64:\n\t\tfmt.Fprintf(buf, \"%d\", val)\n\tcase bool:\n\t\tif val {\n\t\t\tbuf.WriteString(\"true\")\n\t\t} else {\n\t\t\tbuf.WriteString(\"false\")\n\t\t}\n\tcase nil:\n\t\tbuf.WriteString(\"null\")\n\tdefault:\n\t\tb, _ := json.Marshal(val)\n\t\tbuf.Write(b)\n\t}\n}\n\nfunc writeOrderedObject(buf *bytes.Buffer, entries []orderedJSON) {\n\tbuf.WriteByte('{')\n\tfor i, e := range entries {\n\t\tif i > 0 {\n\t\t\tbuf.WriteByte(',')\n\t\t}\n\t\twriteJSONString(buf, e.key)\n\t\tbuf.WriteByte(':')\n\t\twriteOrderedValue(buf, e.value)\n\t}\n\tbuf.WriteByte('}')\n}\n\nfunc writeOrderedArrayAny(buf *bytes.Buffer, arr []any) {\n\tbuf.WriteByte('[')\n\tfor i, v := range arr {\n\t\tif i > 0 {\n\t\t\tbuf.WriteByte(',')\n\t\t}\n\t\twriteOrderedValue(buf, v)\n\t}\n\tbuf.WriteByte(']')\n}\n\nfunc writeJSONString(buf *bytes.Buffer, s string) {\n\tb, _ := json.Marshal(s)\n\tbuf.Write(b)\n}\n\nfunc writeOrderedIndent(buf *bytes.Buffer, v any, indent int) {\n\twriteOrderedIndentValue(buf, v, indent)\n}\n\nfunc writeOrderedIndentValue(buf *bytes.Buffer, v any, indent int) {\n\tswitch val := v.(type) {\n\tcase []orderedJSON:\n\t\twriteOrder"]
