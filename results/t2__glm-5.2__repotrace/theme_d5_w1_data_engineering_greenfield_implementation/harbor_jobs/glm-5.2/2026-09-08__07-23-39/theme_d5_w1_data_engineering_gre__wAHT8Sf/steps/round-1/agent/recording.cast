[19950.916055, "o", "    35\t}\r\n    36\t\r\n    37\ttype inputShardInfo struct {\r\n    38\t\tName           string\r\n    39\t\tBytes          int64\r\n    40\t\tSHA256         string\r\n    41\t\tEventsTotal    int\r\n    42\t\tEventsAccepted int\r\n    43\t}\r\n    44\t\r\n    45\ttype loadedState struct {\r\n    46\t\tversion             int\r\n    47\t\thasMax              bool\r\n"]
[19950.916136, "o", "    48\t\tmaxTs               time.Time\r\n    49\t\tseenIds             map[string]bool\r\n    50\t\tpending             []pendingEntry\r\n    51\t\topenSessions        map[string]carriedSession\r\n"]
