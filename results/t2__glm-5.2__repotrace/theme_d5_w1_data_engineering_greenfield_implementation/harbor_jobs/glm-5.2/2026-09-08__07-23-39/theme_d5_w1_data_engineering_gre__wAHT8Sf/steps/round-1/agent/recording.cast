[10973.583152, "o", "   463\t\t\t\treturn nil, fmt.Errorf(\"bad pending purchase ts: %w\", err)\r\n   464\t\t\t}\r\n   465\t\t\tst.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, user: p.User, usd: float64(p.USD), originRun: p.OriginRun})\r\n   466\t\t}\r\n   467\t\tfor _, s := range sin.OpenSessions {\r\n   468\t\t\tlast, err := parseTime(s.LastTS)\r\n   469\t"]
