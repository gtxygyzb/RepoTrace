[18131.192519, "o", "\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K: must be one of {legacy, tagged, tagged-sorted}\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K\":\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K: must be one of {gap, fixed-window, hybrid}\")\r\n"]
[18131.192586, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K-header\":\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K210\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Kingest-id\u001b[m\u001b[K: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --manifest-signature requires --\u001b[01;31m\u001b[Kout-parquet-manifest\u001b[m\u001b[K\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K217\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest --\u001b[01;31m\u001b[Kout-parquet-manifest\u001b[m\u001b[K parent directory does not exist\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest requires --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out\")\r\n"]
[18131.192651, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-strict requires --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-index requires --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out and --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out parent directory does not exist\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest parent directory does not exist\")\r\n"]
[18131.192712, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest --\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-index parent directory does not exist\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K tagged requires --audit-log\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K tagged-sorted requires --audit-log\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K-header requires --\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K tagged\")\r\n"]
[18131.192797, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --fixed-window-seconds requires --\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K fixed-window or hybrid\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K fixed-window requires --fixed-window-seconds\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K hybrid requires --fixed-window-seconds\")\r\n"]
[18131.193289, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--state-strict] [--audit-log <path>] [--audit-log-digest <path>] [--audit-log-rotate-bytes <int>] [--rates-strict] [--rates-max-staleness <seconds>] [--\u001b[01;31m\u001b[Kingest-id\u001b[m\u001b[K <string>] [--\u001b[01;31m\u001b[Kout-parquet-manifest\u001b[m\u001b[K <path>] [--manifest-signature <path>] [--dedup-policy <first-arrival|lex-largest-ts>] [--strict-late-audit] [--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out <path>] [--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest <path>] [--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-strict] [--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-index <path>] [--\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K <legacy|tagged|tagged-sorted>] [--\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K-header] [--\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K <gap|fixed-window|hybrid>] [--fixe"]
[18131.193355, "o", "d-window-seconds <int>]\\n\"\r\n"]
[18131.193578, "o", "\u001b[35m\u001b[Kschema.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kconst summarySchemaVersion = \"eventq.\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K/v1\"\r\n"]
