[16510.952275, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"regexp\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t"]
[16510.952404, "o", "\"strings\"\r\n    13\t\t\"time\"\r\n    14\t)\r\n    15\t\r\n    16\tvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n    17\t\r\n    18\ttype cliConfig struct {\r\n    19\t\tinputDir            string\r\n    20\t\tratesPath           string\r\n    21\t\toutputPath          string\r\n    22\t\trejectsPath         string\r\n    23\t\tsessionGap          int\r\n    24\t\twatermarkLag        int\r\n    25\t\tstateIn             string\r\n    26\t\tstateOut            string\r\n    27\t\tpendingTTL          int\r\n    28\t\tmaxOpenSessions     int\r\n    29\t\tauditLog            string\r\n    30\t\tauditLogDigest      string\r\n"]
[16510.952512, "o", "    31\t\tauditLogRotateBytes int\r\n    32\t\tratesStrict         bool\r\n    33\t\tratesMaxStaleness   int\r\n    34\t\tingestID            string\r\n    35\t\tingestIDSet         bool\r\n    36\t\toutManifest         string\r\n    37\t\tmanifestSignature   string\r\n    38\t\tdedupPolicy         string\r\n    39\t\t"]
[16510.952608, "o", "dedupPolicySet      bool\r\n    40\t\tstrictLateAudit     bool\r\n    41\t\tstateStrict         bool\r\n    42\t\tsummarySchemaOut    string\r\n    43\t\tsummarySchemaDigest string\r\n    44\t\tsummarySchemaStrict bool\r\n    45\t\tsummarySchemaIndex  string\r\n    46\t\trejectsFormat       string\r\n    47\t\trejectsFormatHeader bool\r\n    48\t}\r\n    49\t\r\n    50\tfunc main() {\r\n    51\t\tcfg, err := parseArgs(os.Args[1:])\r\n    52\t\tif err != nil {\r\n    53\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    54\t\t\tos.Exit(2)\r\n    55\t\t}\r\n    56\t\tif err := run(cfg); err != nil {\r\n    57\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    58\t\t\tos.Exit(1)\r\n    59\t\t}\r\n    60\t}\r\n"]
[16510.952687, "o", "    61\t\r\n    62\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n    63\t\tdefer func() {\r\n    64\t\t\tif r := recover(); r != nil {\r\n    65\t\t\t\tcfg = cliConfig{}\r\n    66\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n    67\t\t\t}\r\n    68\t\t}()\r\n    69\t\tcfg = cliConfig{\r\n    70\t\t\tsessionGap:        600,\r\n    71\t\t\twatermarkLag:      300,\r\n"]
[16510.952765, "o", "    72\t\t\tpendingTTL:        86400,\r\n    73\t\t\tmaxOpenSessions:   100000,\r\n    74\t\t\tratesMaxStaleness: 0,\r\n    75\t\t}\r\n    76\t\trequired := map[string]bool{\r\n    77\t\t\t\"--input-dir\": false,\r\n    78\t\t\t\"--rates\":     false,\r\n    79\t\t\t\"--output\":    false,\r\n    80\t\t\t\"--rejects\":   false,\r\n    81\t\t}\r\n    82\t\tif len(args) > 0 && args[0] == \"ingest\" {\r\n    83\t\t\t"]
[16510.952835, "o", "args = args[1:]\r\n    84\t\t}\r\n    85\t\tfor i := 0; i < len(args); i++ {\r\n    86\t\t\targ := args[i]\r\n    87\t\t\tif strings.HasPrefix(arg, \"--summary-schema-out=\") {\r\n    88\t\t\t\tcfg.summarySchemaOut = strings.TrimPrefix(arg, \"--summary-schema-out=\")\r\n    89\t\t\t\tif cfg.summarySchemaOut == \"\" {\r\n    90\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-out: value must be non-empty\")\r\n    91\t\t\t\t}\r\n"]
[16510.95291, "o", "    92\t\t\t\tcontinue\r\n    93\t\t\t}\r\n    94\t\t\tif strings.HasPrefix(arg, \"--summary-schema-digest=\") {\r\n    95\t\t\t\tcfg.summarySchemaDigest = strings.TrimPrefix(arg, \"--summary-schema-digest=\")\r\n    96\t\t\t\tif cfg.summarySchemaDigest == \"\" {\r\n    97\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest: value must be non-empty\")\r\n    98\t\t\t\t}\r\n    99\t\t\t\tcontinue\r\n   100\t\t\t}\r\n   101\t\t\tif strings.HasPrefix(arg, \"--summary-schema-index=\") {\r\n"]
[16510.952984, "o", "   102\t\t\t\tcfg.summarySchemaIndex = strings.TrimPrefix(arg, \"--summary-schema-index=\")\r\n   103\t\t\t\tif cfg.summarySchemaIndex == \"\" {\r\n   104\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index: value must be non-empty\")\r\n   105\t\t\t\t}\r\n   106\t\t\t\tcontinue\r\n   107\t\t\t}\r\n   108\t\t\tswitch arg {\r\n   109\t\t\tcase \"--input-dir\":\r\n   110\t\t\t\tcfg.inputDir = nextArg(args, &i)\r\n   111\t\t\tcase \"--rates\":\r\n"]
[16510.953026, "o", "   112\t\t\t\tcfg.ratesPath = nextArg(args, &i)\r\n   113\t\t\tcase \"--output\":\r\n   114\t\t\t\tcfg.outputPath = nextArg(args, &i)\r\n   115\t\t\tcase \"--rejects\":\r\n   116\t\t\t\tcfg.rejectsPath = nextArg(args, &i)\r\n   117\t\t\tcase \"--session-gap\":\r\n   118\t\t\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\r\n"]
[16510.953118, "o", "   119\t\t\tcase \"--watermark-lag\":\r\n   120\t\t\t\tcfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")\r\n"]
