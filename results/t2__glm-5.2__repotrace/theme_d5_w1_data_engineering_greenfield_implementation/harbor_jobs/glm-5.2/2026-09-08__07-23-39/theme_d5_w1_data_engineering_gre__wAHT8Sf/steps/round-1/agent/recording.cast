[5507.626163, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t  \"bytes\"\r\n     5\t  \"crypto/sha256\"\r\n     6\t  \"encoding/hex\"\r\n     7\t  \"encoding/json\"\r\n     8\t  \"errors\"\r\n     9\t  \"fmt\"\r\n    10\t  \"math\"\r\n    11\t  \"os\"\r\n"]
[5507.626331, "o", "    12\t  \"path/filepath\"\r\n    13\t  \"sort\"\r\n    14\t  \"strconv\"\r\n    15\t  \"strings\"\r\n    16\t  \"time\"\r\n    17\t)\r\n    18\t\r\n    19\tvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--audit-log <path>] [--audit-log-digest <path>]\\n\"\r\n    20\t\r\n    21\ttype Money float64\r\n    22\t\r\n    23\tfunc (m Money) MarshalJSON() ([]byte, error) {\r\n    24\t  return []byte(m.String()), nil\r\n    25\t}\r\n    26\t\r\n    27\tfunc (m Money) String() string {\r\n    28\t  f := float64(m)\r\n    29\t  abs := math.Abs(f)\r\n    30\t  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n    31\t  neg := f < 0 && cents != 0\r\n    32\t  dollars := cents / 100\r\n    33\t  rem := cents % 100\r\n    34\t  s := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n    35"]
[5507.626428, "o", "\t  if neg {\r\n    36\t    s = \"-\" + s\r\n    37\t  }\r\n    38\t  return s\r\n    39\t}\r\n    40\t\r\n    41\ttype Event struct {\r\n    42\t  ID       string\r\n    43\t  Type     string\r\n    44\t  TS       time.Time\r\n    45\t  UserID   string\r\n    46\t  Amount   float64\r\n    47\t  Currency string\r\n    48\t  RefID    string\r\n    49\t  USD      float64\r\n    50\t  RefUSD   float64\r\n    51\t  Raw      json.RawMessage\r\n"]
[5507.626498, "o", "    52\t  Shard    string\r\n    53\t  Line     int\r\n    54\t}\r\n    55\t\r\n    56\ttype Reject struct {\r\n    57\t  Bucket int             `json:\"bucket\"`\r\n    58\t  Reason string          `json:\"reason\"`\r\n    59\t  Event  json.RawMessage `json:\"event\"`\r\n    60\t}\r\n"]
