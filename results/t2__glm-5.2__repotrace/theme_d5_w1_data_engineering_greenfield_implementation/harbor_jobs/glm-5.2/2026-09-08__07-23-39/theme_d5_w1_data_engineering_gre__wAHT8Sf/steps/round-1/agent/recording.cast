[11059.310153, "o", "    18\t\r\n    19\tfunc (m Money) MarshalJSON() ([]byte, error) {\r\n    20\t\treturn []byte(m.String()), nil\r\n    21\t}\r\n    22\t\r\n    23\tfunc (m Money) String() string {\r\n    24\t\tf := float64(m)\r\n    25\t\tabs := math.Abs(f)\r\n    26\t\tcents := int64(math.Floor(abs*100.0 + 0.5))\r\n    27\t\tneg := f < 0 && cents != 0\r\n    28\t\tdollars := cents / 100\r\n    29\t\trem := cents % 100\r\n    30\t\ts := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n    31\t\tif neg {\r\n    32\t\t\ts = \"-\" + s\r\n    33\t\t}\r\n    34\t\treturn s\r\n    35\t}\r\n    36\t\r\n    37\ttype Event struct {\r\n    38\t\tID                string\r\n    39\t\tType              string\r\n    40\t\tTS                time.Time\r\n    41\t\tUserID            string\r\n    42\t\tAmount            float64\r\n    43\t\tCurrency          string\r\n    44\t\tRefID             string\r\n    45\t\tUSD               float64\r\n    46\t\tRefUSD            float64\r\n"]
