[16542.076048, "o", "   434\t\t\t\t\t\ttiebreak = false\r\n   435\t\t\t\t\t} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n   436\t\t\t\t\t\twinner = idx\r\n   437\t\t\t\t\t\ttiebreak = true"]
