[14741.769421, "o", "   629\tfunc writeAuditLog(path string, entries []auditLogEntry, rotateBytes int) []string {\r\n   630\t\tvar segments []string\r\n   631\t\tif rotateBytes <= 0 {\r\n   632\t\t\tvar buf bytes.Buffer\r\n   633\t\t\tfor _, e := range entries {\r\n   634\t\t\t\tb, err := json.Marshal(e)\r\n   635\t\t\t\tif err != nil {\r\n"]
[14741.769593, "o", "   636\t\t\t\t\tpanic(err)\r\n   637\t\t\t\t}\r\n   638\t\t\t\tbuf.Write(b)\r\n   639\t\t\t\tbuf.WriteByte('\\n')\r\n   640\t\t\t}\r\n   641\t\t\tif err := atomicWriteFile(path, buf.Bytes()); err != nil {\r\n   642\t\t\t\tpanic(err)\r\n   643\t\t\t}\r\n"]
[14741.769691, "o", "   644\t\t\treturn []string{path}\r\n   645\t\t}\r\n   646\t\r\n   647\t\tcurrent := path\r\n   648\t\tvar buf bytes.Buffer\r\n   649\t\tflush := func() {\r\n   650\t\t\tif err := atomicWriteFile(current, buf.Bytes()); err != nil {\r\n   651\t\t\t\tpanic(err)\r\n   652\t\t\t}\r\n   653\t\t\tsegments = append(segments, current)\r\n   654\t\t\tbuf.Reset()\r\n   655\t\t}\r\n   656\t\tfor _, e := range entries {\r\n   657\t\t\tb, err := json.Marshal(e)\r\n   658\t\t\tif err != nil {\r\n   659\t\t\t\tpanic(err)\r\n   660\t\t\t}\r\n   661\t\t\trec := append(b, '\\n')\r\n   662\t\t\tif buf.Len() > 0 && buf.Len()+len(rec) > rotateBytes {\r\n   663\t\t\t\tflush()\r\n   664\t\t\t\tcurrent = fmt.Sprintf(\"%s.%d\", path, len(segments))\r\n   665\t\t\t}\r\n   666\t\t\tbuf.Write(rec)\r\n   667\t\t}\r\n   668\t\tif buf.Len() > 0 || len(segments) == 0 {\r\n   669\t\t\tflush()\r\n   670\t\t}\r\n   671\t\treturn segments\r\n"]
