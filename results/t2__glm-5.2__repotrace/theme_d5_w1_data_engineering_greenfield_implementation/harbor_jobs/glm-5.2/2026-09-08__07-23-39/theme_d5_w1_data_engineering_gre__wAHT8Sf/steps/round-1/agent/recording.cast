[11626.72557, "o", "                                  }'''\r\n\u001b[?2004l\r"]
[11626.783361, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> # Add ptrCutoff helper after nextArg or atoiOrError\r\n\u001b[?2004l\r\u001b[?2004h> if 'func ptrCutoff' not in s:\r\n\u001b[?2004l\r\u001b[?2004h>     s = s.replace(\r\n\u001b[?2004l\r\u001b[?2004h> '''func run(cfg cliConfig) error {''',\r\n\u001b[?2004l\r\u001b[?2004h> '''func ptrCutoff(c cutoffObject) *cutoffObject {\r\n\u001b[?2004l\r\u001b[?2004h>         return &c\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func run(cfg cliConfig) error {'''\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> # Replace audit log writing and digest construction\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace(\r\n\u001b[?2004l\r\u001b[?2004h> '''          if cfg.auditLog != \"\" {\r\n\u001b[?2004l\r  \u001b[?2004h>                   var buf bytes.Buffer\r\n\u001b[?2004l\r\u001b[?2004h>                   for _, e := range auditEntries {\r\n\u001b[?2004l\r\u001b[?2004h>                           b, err := json.Marshal(e)\r\n\u001b[?2004l\r\u001b[?2004h>                           if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>                                   return err\r\n\u001b[?2004l\r\u001b[?2004h>                           }\r\n\u001b[?2004l\r\u001b[?2004"]
[11626.78357, "o", "h>                           buf.Write(b)\r\n\u001b[?2004l\r\u001b[?2004h>                           buf.WriteByte('\\n')\r\n\u001b[?2004l\r\u001b[?2004h>                   }\r\n\u001b[?2004l\r\u001b[?2004h>                   if err := atomicWriteFile(cfg.auditLog, buf.Bytes()); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>                           return err\r\n\u001b[?2004l\r\u001b[?2004h>                   }\r\n\u001b[?2004l\r\u001b[?2004h>           }\r\n\u001b[?2004l\r\u001b[?2004h>           if cfg.auditLogDigest != \"\" {\r\n\u001b[?2004l\r\u001b[?2004h>                   var auditLogPath string\r\n\u001b[?2004l\r\u001b[?2004h>                   if cfg.auditLog != \"\" {\r\n\u001b[?2004l\r\u001b[?2004h>                           auditLogPath = filepath.Base(cfg.auditLog)\r\n\u001b[?2004l\r\u001b[?2004h>                   }\r\n\u001b[?2004l\r\u001b[?2004h>                   var auditSHA string\r\n\u001b[?2004l\r\u001b[?2004h>                   if cfg.auditLog != \"\" {\r\n\u001b[?2004l\r\u001b[?2004h>                           h, _, err := fileDigest(cfg.auditLog)\r\n\u001b[?2004l\r\u001b[?2004h>                           if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>                                   return er"]
[11626.783646, "o", "r\r\n\u001b[?2004l\r\u001b[?2004h>                           }\r\n\u001b[?2004l\r\u001b[?2004h>                           auditSHA = h\r\n\u001b[?2004l\r\u001b[?2004h>                   }\r\n\u001b[?2004l\r\u001b[?2004h>                   digest := auditDigestOutput{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11626.783926, "o", "                          SchemaVersion:    \"eventq.digest/v1\",\r\n\u001b[?2004l\r"]
[11626.783986, "o", "\u001b[?2004h> "]
