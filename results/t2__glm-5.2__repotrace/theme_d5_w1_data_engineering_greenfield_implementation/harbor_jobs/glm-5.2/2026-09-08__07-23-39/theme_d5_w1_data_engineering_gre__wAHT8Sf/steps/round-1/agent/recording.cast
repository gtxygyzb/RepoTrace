[16949.725683, "o", "    'func atoiOrError(s, flag string) int {\\n\\tn, err := strconv.Atoi(s)\\n\\tif err != nil {\\n\\t\\tpanic(fmt.Errorf(\"ingest: invalid integer for %s: %s\", flag, s))\\n\\t}\\n\\treturn n\\n}',\r\n\u001b[?2004l\r"]
[16949.725754, "o", "\u001b[?2004h> "]
[16949.729097, "o", "    'func atoiOrError(s, flag string) int {\\n\\tn, err := strconv.Atoi(s)\\n\\tif err != nil {\\n\\t\\tpanic(fmt.Errorf(\"ingest: invalid integer for %s: %s\", flag, s))\\n\\t}\\n\\treturn n\\n}\\n\\nfunc computeSessionCount(evs []*Event, policy string, gap, windowSecs int) int {\\n\\tif len(evs) == 0 {\\n\\t\\treturn 0\\n\\t}\\n\\tcount := 1\\n\\tvar anchor int64\\n\\tif policy == \"fixed-window\" || policy == \"hybrid\" {\\n\\t\\tanchor = floorEpochToWindow(evs[0].TS.Unix(), int64(windowSecs))\\n\\t}\\n\\tfor i := 1; i < len(evs); i++ {\\n\\t\\tsplit := false\\n\\t\\tif policy == \"gap\" || policy == \"hybrid\" {\\n\\t\\t\\tif evs[i].TS.Sub(evs[i-1].TS) > time.Duration(gap)*time.Second {\\n\\t\\t\\t\\tsplit = true\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif policy == \"fixed-window\" || policy == \"hybrid\" {\\n\\t\\t\\tkPrev := floorDiv(evs[i-1].TS.Unix()-anchor, int64(windowSecs))\\n\\t\\t\\tkCur := floorDiv(evs[i].TS.Unix()-anchor, int64(windowSecs))\\n\\t\\t\\tif kPrev != kCur {\\n\\t\\t\\t\\tsplit = true\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif split {\\n\\t\\t\\tcount++\\n\\t\\t}\\n\\t}\\n\\treturn count\\n}\\n\\nfunc floorEpoch"]
[16949.729199, "o", "ToWindow(epoch, window int64) int64 {\\n\\tif window <= 0 {\\n\\t\\treturn 0\\n\\t}\\n\\treturn floorDiv(epoch, window) * window\\n}\\n\\nfunc floorDiv(a, b int64) int64 {\\n\\tif b == 0 {\\n\\t\\treturn 0\\n\\t}\\n\\tq := a / b\\n\\tif (a%b != 0) && ((a < 0) != (b < 0)) {\\n\\t\\tq--\\n\\t}\\n\\treturn q\\n}'\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[16949.7293, "o", "with open('cli.go', 'w') as f:\r\n\u001b[?2004l\r"]
