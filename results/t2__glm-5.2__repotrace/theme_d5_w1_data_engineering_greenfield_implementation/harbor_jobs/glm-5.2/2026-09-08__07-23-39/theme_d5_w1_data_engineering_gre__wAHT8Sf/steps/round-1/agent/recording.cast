[16542.076302, "o", "   460\t\t\t\tdedupPolicyStats.DuplicateWinnersSameShard++\r\n   461\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" || tiebreak {\r\n   462\t\t\t\t\tdedupPolicyStats.DuplicateWinnersLineTiebreak++\r\n   463\t\t\t\t}\r\n   464\t\t\t} else {\r\n   465\t\t\t\tdedupPolicyStats.DuplicateWinnersCrossShard++\r\n   466\t\t\t}\r\n   467\t\t}\r\n   468\t\r\n   469\t\t// Finalize accepted/duplicate buckets and outputs in arrival order.\r\n   470\t\thasMin, hasMax = false, false\r\n"]
[16542.076365, "o", "   471\t\tfor _, c := range candidates {\r\n   472\t\t\tif c.ev != nil {\r\n   473\t\t\t\tseen[c.ev.ID] = true\r\n   474\t\t\t}\r\n   475\t\t}\r\n   476\t\tbucketCounts[\"accepted\"] = 0\r\n   477\t\tbucketCounts[\"duplicate\"] = duplicateReasons[\"cross_run\"]\r\n   478\t\tfor i, c := range candidates {\r\n   479\t\t\t_ = i\r\n"]
