[12912.124873, "o", "\t\t\t\t\t\tlateBy := int(entry.Cutoff.EpochSeconds - int(epochSeconds(ev.TS)))\r\n\t\t\t\t\t\tentry.WatermarkLagSeconds = &lag\r\n\t\t\t\t\t\tentry.LateBySeconds = &lateBy\r\n\t\t\t\t\t}\r\n\t\t\t\t\tauditEntries = append(auditEntries, entry)\r\n\t\t\t\t\tev = nil\r\n\t\t\t\t} else {\r\n"]
[12912.124928, "o", "\t\t\t\t\tbucket = \"accepted\"\r\n\t\t\t\t\tif ev.TS.After(watermark) {\r\n\t\t\t\t\t\twatermark = ev.TS\r\n\t\t\t\t\t\thasWatermark = true\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tbucket = \"invalid\"\r\n"]
[12912.124989, "o", "\t\t\t}\r\n\t\t}\r\n\t\tif bucket == \"invalid\" {\r\n\t\t\tinvalidReasons[reason]++\r\n\t\t}\r\n\t\tbucketCounts[bucket]++\r\n\t\tif bucket == \"duplicate\" && reason == \"cross_run\" {\r\n\t\t\tduplicateReasons[\"cross_run\"]++\r\n\t\t}\r\n\t\tcandidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})\r\n\t\t"]
