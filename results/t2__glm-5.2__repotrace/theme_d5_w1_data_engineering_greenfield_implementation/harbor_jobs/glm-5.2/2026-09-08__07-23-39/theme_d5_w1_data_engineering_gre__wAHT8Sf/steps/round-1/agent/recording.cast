[18991.522209, "o", "\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksharding-report\u001b[m\u001b[K-histogram: value must be non-empty\")\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksharding-report\u001b[m\u001b[K-sort\":\r\n\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksharding-report\u001b[m\u001b[K-sort: value must be non-empty\")\r\n\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcase \"--\u001b[01;31m\u001b[Ksharding-report\u001b[m\u001b[K-strict\":\r\n"]
