[3566.29881, "o", "func parseTime(s string) (time.Time, error) {\r\n\u001b[?2004l\r"]
[3566.298866, "o", "\u001b[?2004h> "]
[3566.299034, "o", "  t, err := time.Parse(time.RFC3339, s)\r\n\u001b[?2004l\r"]
[3566.299088, "o", "\u001b[?2004h> "]
[3566.299162, "o", "  if err != nil {\r\n\u001b[?2004l\r"]
[3566.299232, "o", "\u001b[?2004h> "]
