[18456.954329, "o", "  1021\t\t\treturn sortedShards[i].Name < sortedShards[j].Name\r\n  1022\t\t})\r\n  1023\t\tmanifestShards := make([]manifestShard, 0, len(sortedShards))\r\n  1024\t\tfor _, s := range sortedShards {\r\n  1025\t\t\tmanifestShards = append(manifestShards, manifestShard{\r\n  1026\t\t\t\tShard:          s.Name,\r\n  1027\t\t\t\tSHA256:         s.SHA256,\r\n"]
[18456.954408, "o", "  1028\t\t\t\tBytes:          s.Bytes,\r\n  1029\t\t\t\tEventsTotal:    s.EventsTotal,\r\n  1030\t\t\t\tEventsAccepted: shardAccepted[s.Name],\r\n  1031\t\t\t})\r\n  1032\t\t}\r\n  1033\t\toutputs := manifestOutputs{}\r\n  1034\t\tsummaryOut, err := manifestFileOutputFor(cfg.outputPath)\r\n  1035\t\tif err != nil {\r\n  1036\t\t\treturn manifestOutput{}, err\r\n  1037\t\t}\r\n  1038\t\trejectsOut, err := manifestFileOutputFor(cfg.rejectsPath)\r\n  1039\t\tif err != nil {\r\n  1040\t\t\treturn manifestOutput{}, err\r\n  1041\t\t}\r\n  1042\t\toutputs.Summary = summaryOut\r\n  1043\t\toutputs.Rejects = rejectsOut\r\n  1044\t\tif cfg.stateOut != \"\" {\r\n  1045\t\t\tstateOut, err := manifestFileOutputFor(cfg.stateOut)\r\n  1046\t\t\tif err != nil {\r\n  1047\t\t\t\treturn manifestOutput{}, err\r\n  1048\t\t\t}\r\n  1049\t\t\toutputs.State = stateOut\r\n  1050\t\t}\r\n  1051\t\tif cfg.auditLog != \"\" {\r\n  1052\t\t\tlogOut, err := manifestFileOutputFor(cfg.auditLog)\r\n"]
[18456.954487, "o", "  1053\t\t\tif err != nil {\r\n  1054\t\t\t\treturn manifestOutput{}, err\r\n  1055\t\t\t}\r\n  1056\t\t\toutputs.AuditLog = logOut\r\n  1057\t\t}\r\n  1058\t\tif cfg.auditLogDigest != \"\" {\r\n  1059\t\t\tdigestOut, err := manifestFileOutputFor(cfg.auditLogDigest)\r\n  1060\t\t\tif err != nil {\r\n  1061\t\t\t\treturn manifestOutput{}, err\r\n  1062\t\t\t}\r\n  1063\t\t\toutputs.AuditDigest = digestOut\r\n  1064"]
[18456.954563, "o", "\t\t}\r\n  1065\t\twindow := manifestWindow{\r\n  1066\t\t\tEventsAcceptedTotal: bucketCounts[\"accepted\"],\r\n  1067\t\t\tEventsRejectedTotal: bucketCounts[\"duplicate\"] + bucketCounts[\"invalid\"] + bucketCounts[\"late\"] + bucketCounts[\"unresolved_chargeback\"],\r\n  1068\t\t\tBucketCounts:        bucketCounts,\r\n  1069\t\t}\r\n  1070\t\tif hasMin {\r\n  1071\t\t\tm := formatTS(minTs)\r\n  1072\t\t\twindow.MinTs = &m\r\n  1073"]
[18456.954642, "o", "\t\t}\r\n  1074\t\tif hasMax {\r\n  1075\t\t\tm := formatTS(maxTs)\r\n  1076\t\t\twindow.MaxTs = &m\r\n  1077\t\t}\r\n  1078\t\tvar ingestID *string\r\n  1079\t\tif cfg.ingestIDSet {\r\n  1080\t\t\tid := cfg.ingestID\r\n  1081\t\t\tingestID = &id\r\n  1082\t\t}\r\n  1083"]
[18456.954709, "o", "\t\treturn manifestOutput{\r\n  1084\t\t\tSchemaVersion: manifestSchemaVersion,\r\n  1085\t\t\tIngestID:      ingestID,\r\n  1086\t\t\tRunIndex:      runIndex,\r\n  1087\t\t\tRatesDigest:   ratesDigest,\r\n  1088\t\t\tInputShards:   manifestShards,\r\n  1089\t\t\tOutputs:       outputs,\r\n  1090\t\t\tWindow:        window,\r\n  1091\t"]
[18456.954781, "o", "\t}, nil\r\n  1092\t}\r\n  1093\t\r\n  1094\tfunc bucketCode(bucket string) int {\r\n  1095\t\tswitch bucket {\r\n  1096\t\tcase \"accepted\":\r\n  1097\t\t\treturn 0\r\n  1098\t\tcase \"duplicate\":\r\n"]
[18456.954849, "o", "  1099\t\t\treturn 1\r\n  1100\t\tcase \"invalid\":\r\n  1101\t\t\treturn 2\r\n  1102\t\tcase \"late\":\r\n  1103\t\t\treturn 3\r\n  1104\t\tcase \"unresolved_chargeback\":\r\n  1105\t\t\treturn 4\r\n  1106\t\t}\r\n  1107\t\treturn 2\r\n  1108\t}\r\n"]
