[14679.018831, "o", "   400\treturn rfc3339UTCZRE.MatchString(s)\r\n   401\t}\r\n   402\t\r\n   403\tfunc buildSchemaSidecar(summaryData []byte, cfg cliConfig, runIndex int) ([]byte, error) {\r\n   404\tfields, err := parseSummaryFields(summaryData)\r\n   405\tif err != nil {\r\n   406\treturn nil, err\r\n   407\t}\r\n   408\tsummarySchema := make([]orderedJSON, 0, len(fields))\r\n   409\tvar arrayFields, objectFields, scalarFields int\r\n   410\tfor _, f := range fields {\r\n"]
[14679.018967, "o", "   411\tt := classify(f.value)\r\n   412\tswitch t {\r\n   413\tcase \"array\":\r\n   414\tarrayFields++\r\n   415\tcase \"object\":\r\n   416\tobjectFields++\r\n   417\tdefault:\r\n   418\tscalarFields++\r\n   419\t}\r\n   420\tsummarySchema = append(summarySchema, orderedJSON{key: f.key, value: descriptorFor(f.value, 0, cfg.summarySchemaStrict)})\r\n   421\t}\r\n   422\tvar ingestID any\r\n   423\tif cfg.ingestIDSet {\r\n   424\tingestID = cfg.ingestID\r\n   425\t} else {\r\n   426\tingestID = nil\r\n   427\t}\r\n   428\ttop := []orderedJSON{\r\n   429\t{key: \"schema_version\", value: summarySchemaVersion},\r\n   430\t{key: \"summary_schema\", value: summarySchema},\r\n   431\t{key: \"ingest_id\", value: ingestID},\r\n   432\t{key: \"run_index\", value: runIndex},\r\n"]
[14679.019043, "o", "   433\t{key: \"field_summary\", value: []orderedJSON{\r\n   434\t{key: \"array_fields\", value: arrayFields},\r\n   435\t{key: \"object_fields\", value: objectFields},\r\n   436\t{key: \"scalar_fields\", value: scalarFields},\r\n   437\t}},\r\n   438\t{key: \"strict_mode\", value: cfg.summarySchemaStrict},\r\n   439\t}\r\n   440\tdata := marshalOrderedIndent(top)\r\n   441\tdata = append(data, '\\n')\r\n   442\treturn data, nil\r\n   443\t}\r\n"]
[14679.019119, "o", "   444\t\r\n   445\tfunc writeSummarySchemaSidecars(cfg cliConfig, summaryData []byte, runIndex int) error {\r\n   446\tif cfg.summarySchemaOut == \"\" {\r\n   447\treturn nil\r\n   448\t}\r\n   449\tschemaData, err := buildSchemaSidecar(summaryData, cfg, runIndex)\r\n   450\tif err != nil {\r\n   451\treturn err\r\n   452\t}\r\n   453\tif err := atomicWriteFile(cfg.summarySchemaOut, schemaData); err != nil {\r\n   454\treturn err\r\n   455\t}"]
[14679.019224, "o", "\r\n   456\tif cfg.summarySchemaDigest != \"\" {\r\n   457\thash, n, err := fileDigest(cfg.summarySchemaOut)\r\n   458\tif err != nil {\r\n   459\treturn err\r\n   460\t}\r\n   461\tdigest := []orderedJSON{\r\n   462\t{key: \"schema_path\", value: filepath.Base(cfg.summarySchemaOut)},\r\n   463\t{key: \"schema_sha256\", value: hash},\r\n   464"]
[14679.019304, "o", "\t{key: \"schema_bytes\", value: n},\r\n   465\t{key: \"field_count\", value: 7},\r\n   466\t{key: \"tool_version\", value: toolVersion},\r\n   467\t}\r\n   468\tdata := marshalOrderedIndent(digest)\r\n   469\tdata = append(data, '\\n')\r\n   470\tif err := atomicWriteFile(cfg.summarySchemaDigest, data); err != nil {\r\n   471\treturn err\r\n   472\t}\r\n   473\tif cfg.summarySchemaIndex != \"\" {\r\n   474\tindex, err := buildIndexSidecar(cfg, summaryData)\r\n"]
[14679.019373, "o", "   475\tif err != nil {\r\n   476\treturn err\r\n   477\t}\r\n   478\tif err := atomicWriteFile(cfg.summarySchemaIndex, index); err != nil {\r\n   479\treturn err\r\n   480\t}\r\n   481\t}\r\n   482\t}\r\n   483\treturn nil\r\n   484\t}\r\n   485\t\r\n   486\tfunc buildIndexSidecar(cfg cliConfig, summaryData []byte) ([]byte, error) {\r\n   487\tfields, err := parseSummaryFields(summaryData)\r\n   488\tif err != nil {\r\n   489\treturn nil, err\r\n   490\t}\r\n   491\tentries := make([]any, 0)\r\n   492\tfor _, f := range fields {\r\n"]
[14679.019445, "o", "   493\tentries = append(entries, []orderedJSON{\r\n   494\t{key: \"name\", value: f.key},\r\n   495\t{key: \"type\", value: classify(f.value)},\r\n   496\t{key: \"path\", value: \"$.\" + f.key},\r\n   497\t})\r\n   498\tif classify(f.value) == \"array\" {\r\n   499\tarr := f.value.([]any)\r\n   500\tif len(arr) > 0 && classify(arr[0]) == \"object\" {\r\n   501\tobj := arr[0].(map[string]any)\r\n   502\tkeys := make([]string, 0, len(obj))\r\n   503\tfor k := range obj {\r\n   504\tkeys = append(keys, k)\r\n"]
[14679.019515, "o", "   505\t}\r\n   506\tsort.Strings(keys)\r\n   507\tfor _, k := range keys {\r\n   508\tentries = append(entries, []orderedJSON{\r\n   509\t{key: \"name\", value: k},\r\n   510\t{key: \"type\", value: classify(obj[k])},\r\n   511\t{key: \"path\", value: fmt.Sprintf(\"$.%s[*].%s\", f.key, k)},\r\n   512\t})\r\n   513\t}\r\n   514\t}\r\n   515\t}\r\n"]
[14679.019588, "o", "   516\t}\r\n   517\ttop := []orderedJSON{\r\n   518\t{key: \"entries\", value: entries},\r\n   519\t{key: \"entry_count\", value: len(entries)},\r\n   520\t{key: \"generated_from\", value: filepath.Base(cfg.summarySchemaOut)},\r\n"]
