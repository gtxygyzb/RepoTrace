[7826.105582, "i", "cat > helpers.go <<'EOF'\npackage main\n\nimport (\n\t\"bytes\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"math\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n)\n\nfunc rawStringPtr(obj map[string]json.RawMessage, key string) *string {\n\tif obj == nil {\n\t\treturn nil\n\t}\n\traw, ok := obj[key]\n\tif !ok {\n\t\treturn nil\n\t}\n\tvar s string\n\tif err := json.Unmarshal(raw, &s); err != nil {\n\t\treturn nil\n\t}\n\treturn &s\n}\n\nfunc getRawString(obj map[string]json.RawMessage, key string) (string, bool, bool) {\n\tif obj == nil {\n\t\treturn \"\", false, false\n\t}\n\traw, present := obj[key]\n\tif !present {\n\t\treturn \"\", false, false\n\t}\n\tvar s string\n\tif err := json.Unmarshal(raw, &s); err != nil {\n\t\treturn \"\", false, true\n\t}\n\treturn s, true, true\n}\n\nfunc getJSONInt(raw json.RawMessage) (int, error) {\n\tvar n int\n\tif err := json.Unmarshal(raw, &n); err != nil {\n\t\treturn 0, err\n\t}\n\treturn n, nil\n}\n\nfunc parseTime(s string) (time.Time, error) {\n\ts = strings.TrimSpace(s)\n\tif strings.HasSuffix(s, \"Z\") {\n\t\tif t, err := time.Parse(\"2006-01-02T15:0"]
