[17097.498307, "o", "   308\tfunc newContext(raw rawEvent) *eventContext {\r\n   309\t\tctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n   310\t\tif raw.Obj != nil {\r\n   311\t\t\tctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n   312\t\t\tctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n"]
[17097.498384, "o", "   313\t\t\tctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n   314\t\t}\r\n   315\t\treturn ctx\r\n   316\t}\r\n   317\t\r\n   318\tfunc parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {\r\n   319\t\tobj := ctx.Obj\r\n   320\t\tif obj == nil {\r\n   321\t\t\treturn nil, \"invalid_json\"\r\n   322\t\t}\r\n"]
[17097.498443, "o", "   323\t\traw, ok := obj[\"v\"]\r\n   324\t\tif !ok {\r\n   325\t\t\treturn nil, \"schema_version\"\r\n   326\t\t}\r\n   327\t\tvar v int\r\n   328\t\tif err := json.Unmarshal(raw, &v); err != nil {\r\n   329\t\t\treturn nil, \"schema_version\"\r\n   330\t\t}\r\n   331\t\tif v != 1 && v != 2 {\r\n   332\t\t"]
[17097.498502, "o", "\treturn nil, \"schema_version\"\r\n   333\t\t}\r\n   334\t\tid, idOk, _ := getRawString(obj, \"id\")\r\n   335\t\tif !idOk || id == \"\" {\r\n   336\t\t\treturn nil, \"missing_id\"\r\n   337\t\t}\r\n   338\t\ttsStr, tsOk, _ := getRawString(obj, \"ts\")\r\n   339\t\t"]
[17097.498562, "o", "if !tsOk {\r\n   340\t\t\treturn nil, \"missing_ts\"\r\n   341\t\t}\r\n   342\t\tt, err := parseTime(tsStr)\r\n   343\t\tif err != nil {\r\n   344\t\t\treturn nil, \"bad_ts\"\r\n   345\t\t}\r\n   346\t\ttypeStr, typeOk, _ := getRawString(obj, \"type\")\r\n   347\t\t"]
[17097.498623, "o", "if !typeOk {\r\n   348\t\t\treturn nil, \"missing_type\"\r\n   349\t\t}\r\n   350\t\tswitch typeStr {\r\n   351\t\tcase \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\n   352\t\tdefault:\r\n   353\t\t\treturn nil, \"bad_type\"\r\n   354\t\t}\r\n"]
[17097.49868, "o", "   355\t\tuser, userOk, _ := getRawString(obj, \"user_id\")\r\n   356\t\tif !userOk || user == \"\" {\r\n   357\t\t\treturn nil, \"missing_user\"\r\n   358\t\t}\r\n   359\t\tev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n   360\t\tswitch typeStr {\r\n"]
