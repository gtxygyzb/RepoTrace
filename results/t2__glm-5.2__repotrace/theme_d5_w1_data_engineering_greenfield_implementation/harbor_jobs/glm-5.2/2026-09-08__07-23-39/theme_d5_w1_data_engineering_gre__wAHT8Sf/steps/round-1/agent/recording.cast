[16542.07617, "o", "\t\t\t}\r\n   449\t\t\t}\r\n   450\t\t\twinners[id] = winner\r\n   451\t\t\twinnerSet[winner] = true\r\n   452\t\t\tsameShard := true\r\n   453\t\t\tfor _, idx := range idxs {\r\n   454\t\t\t\tif candidates[idx].ev.Shard != candidates[winner].ev.Shard {\r\n"]
