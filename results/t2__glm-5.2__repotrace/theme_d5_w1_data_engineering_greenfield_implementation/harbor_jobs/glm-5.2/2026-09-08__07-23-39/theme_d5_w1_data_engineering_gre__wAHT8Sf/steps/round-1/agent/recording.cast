[18116.032151, "o", "\t\treturn nil, fmt.Errorf(\"ingest: rates.json: base currency %s must have rate 1.0 on day %s\", base, day)\r\n\t\t}\r\n\t}\r\n\treturn rt, nil\r\n}\r\n\r\nfunc readInputEvents(inputDir string) ([]rawEvent, []rawEvent, []inputShardInfo, error) {\r\n\tinfo, err := os.Stat(inputDir)\r\n\tif err != nil {\r\n"]
