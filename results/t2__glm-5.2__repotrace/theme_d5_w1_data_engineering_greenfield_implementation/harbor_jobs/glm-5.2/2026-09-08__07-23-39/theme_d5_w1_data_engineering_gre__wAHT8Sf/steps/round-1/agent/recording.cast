[5486.582679, "o", "  seenIds              map[string]bool\r\n    94\t  pending              []pendingEntry\r\n    95\t  openSessions         map[string]carriedSession\r\n    96\t  runIndex             int\r\n    97\t  carryInPending       int\r\n    98\t  carryInOpenSessions  int\r\n    99\t  ttlDropped           int\r\n   100\t}\r\n   101\t\r\n   102\ttype stateStats struct {\r\n   103\t  CarryInPending      int `json:\"carry_in_pending\"`\r\n   104\t  CarryOutPending     int `json:\"carry_out_pending\"`\r\n   105\t  RetiredThisRun      int `json:\"retired_this_run\"`\r\n   106\t  TtlDropped          int `json:\"ttl_dropped\"`\r\n   107\t  CrossRunDuplicates  int `json:\"cross_run_duplicates\"`\r\n   108\t  OpenSessionsCarried int `json:\"open_sessions_carried\"`\r\n   109\t  OpenSessionsExtended int `json:\"open_sessions_extended\"`\r\n   110\t  OpenSessionsEvicted int `json:\"open_sessions_evicted\"`\r\n   111\t  RunIndex            int `json:\"run_index\"`\r\n   112\t}\r\n   113\t\r\n   114\ttype eventTypeStats struct {\r\n"]
[5486.582766, "o", "   115\t  Count    int   `json:\"count\"`\r\n   116\t  TotalUSD Money `json:\"total_usd\"`\r\n   117\t  AvgUSD   Money `json:\"avg_usd\"`\r\n   118\t}\r\n   119\t\r\n   120\ttype hourStats struct {\r\n   121\t  Count    int   `json:\"count\"`\r\n   122\t  TotalUSD Money `json:\"total_usd\"`\r\n   123\t}\r\n   124\t\r\n   125\ttype sessionsOut struct {\r\n   126\t  Total  int            `json:\"total\"`\r\n   127\t  ByUser map[string]int `json:\"by_user\"`\r\n   128\t}\r\n   129"]
