[12781.087066, "o", "   139\t\tfor k, ok := range required {\r\n   140\t\t\tif !ok {\r\n   141\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: %s is required\", k)\r\n   142\t\t\t}\r\n   143\t\t}\r\n   144\t\tif cfg.ingestIDSet {\r\n   145\t\t\tif len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {\r\n   146\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)\")\r\n   147\t\t\t}\r\n"]
