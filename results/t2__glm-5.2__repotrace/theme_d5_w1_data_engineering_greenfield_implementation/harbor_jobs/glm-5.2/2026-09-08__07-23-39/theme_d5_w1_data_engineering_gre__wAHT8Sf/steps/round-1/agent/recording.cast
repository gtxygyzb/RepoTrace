[9235.432357, "o", "if !refPresent || !refOk || ref == \"\" {\r\n   415\t\t\t\treturn nil, \"missing_ref_id\"\r\n   416\t\t\t}\r\n   417\t\t\tev.RefID = ref\r\n   418\t\t\tev.USD = 0\r\n   419\t\tcase \"login\", \"signup\":\r\n   420\t\t\tev.USD = 0\r\n   421\t\t}\r\n   422\t\treturn ev, \"\"\r\n"]
