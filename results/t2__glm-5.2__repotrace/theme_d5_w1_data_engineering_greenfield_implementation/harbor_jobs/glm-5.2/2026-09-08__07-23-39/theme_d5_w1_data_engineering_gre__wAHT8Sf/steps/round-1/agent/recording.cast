[7045.63261, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"errors\"\r\n\t\"fmt\"\r\n"]
[7045.63273, "o", "\t\"math\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--audit-log <path>] [--audit-log-digest <path>] [--rates-strict] [--rates-max-staleness <seconds>]\\n\"\r\n\r\ntype Money float64\r\n\r\nfunc (m Money) MarshalJSON() ([]byte, error) {\r\n\treturn []byte(m.String()), nil\r\n}\r\n\r\nfunc (m Money) String() string {\r\n\tf := float64(m)\r\n\tabs := math.Abs(f)\r\n\tcents := int64(math.Floor(abs*100.0 + 0.5))\r\n\tneg := f < 0 && cents != 0\r\n\tdollars := cents / 100"]
[7045.632816, "o", "\r\n\trem := cents % 100\r\n\ts := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n\tif neg {\r\n\t\ts = \"-\" + s\r\n\t}\r\n\treturn s\r\n}\r\n\r\ntype Event struct {\r\n\tID                string\r\n\tType              string\r\n\tTS                time.Time\r\n\tUserID            string\r\n\tAmount            float64\r\n\tCurrency          string\r\n"]
[7045.632886, "o", "\tRefID             string\r\n\tUSD               float64\r\n\tRefUSD            float64\r\n\tFXFallbackDays    int\r\n\tResolvedAgainst   *string\r\n\tResolvedOriginRun int\r\n\tSessionIndex      int\r\n\tRaw               json.RawMessage\r\n\tShard             string\r\n\tLine              int\r\n}\r\n\r\ntype Reject struct {\r\n\tBucket int             `json:\"bucket\"`\r\n"]
[7045.632945, "o", "\tEvent  json.RawMessage `json:\"event\"`\r\n}\r\n\r\ntype ShardLine struct {\r\n\tShard string\r\n\tLine  int\r\n\tData  []byte\r\n}\r\n\r\ntype RateTable struct {\r\n\tbase  string\r\n\tdays  map[string]map[string]float64\r\n\tknown map[string]bool\r\n"]
[7045.633008, "o", "}\r\n\r\nfunc newRateTable() *RateTable {\r\n\treturn &RateTable{base: \"USD\", days: map[string]map[string]float64{}, known: map[string]bool{}}\r\n}\r\n\r\nfunc isUsableRate(f float64) bool {\r\n\treturn isFinite(f) && f > 0\r\n}\r\n\r\nfunc parseRateNumber(raw json.RawMessage) (float64, error) {\r\n\tif bytes.Equal(bytes.TrimSpace(raw), []byte(\"null\")) {\r\n"]
[7045.633087, "o", "\t\treturn 0, errors.New(\"non-numeric rate\")\r\n\t}\r\n\tvar f float64\r\n\tif err := json.Unmarshal(raw, &f); err != nil {\r\n"]
