[16557.117832, "o", "   304\t\t\tfor k, v := range st.seenIds {\r\n   305\t\t\t\tseen[k] = v\r\n   306\t\t\t}\r\n   307\t\t}\r\n   308\t\tvar pending []pendingEntry\r\n   309\t\topenSessions := map[string]carriedSession{}\r\n   310\t\tif st != nil {\r\n   311\t\t\tpending = append([]pendingEntry(nil), st.pending...)\r\n   312\t\t\tfor k, v := range st.openSessions {\r\n   313\t\t\t\topenSessions[k] = v\r\n   314\t\t\t}\r\n   315\t\t}\r\n   316\t\tbucketCounts := map[string]int{\"accepted\": 0, \"duplicate\": 0, \"invalid\": 0, \"late\": 0, \"unresolved_chargeback\": 0}\r\n   317\t\tinvalidReasons := map[string]int{}\r\n   318\t\tduplicateReasons := map[string]int{\"same_run\": 0, \"cross_run\": 0}\r\n   319\t\tfxFallbackStats := map[string]int{\"0\": 0}\r\n   320\t\tshardAccepted := map[string]int{}\r\n   321\t\tvar minTs, maxTs time.Time\r\n   322\t\thasMin, hasMax := false, false\r\n   323"]
[16557.117921, "o", "\t\tvar watermark time.Time\r\n   324\t\thasWatermark := false\r\n   325\t\tif st != nil {\r\n   326\t\t\twatermark = st.maxTs\r\n   327\t\t\thasWatermark = st.hasMax\r\n   328\t\t}\r\n   329\t\r\n   330\t\ttype candidate struct {\r\n   331\t\t\traw       rawEvent\r\n   332\t\t\tctx       *eventContext\r\n   333\t\t\tev        *Event\r\n   334\t\t"]
[16557.117992, "o", "\tduplicate bool\r\n   335\t\t}\r\n   336\t\tvar candidates []candidate\r\n   337\t\tvar auditEntries []auditLogEntry\r\n   338\t\r\n   339\t\t// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.\r\n   340\t\tfor _, raw := range events {\r\n   341\t\t\tctx := newContext(raw)\r\n   342\t\t\tbucket := \"invalid\"\r\n   343\t\t\treason := \"\"\r\n   344\t\t"]
