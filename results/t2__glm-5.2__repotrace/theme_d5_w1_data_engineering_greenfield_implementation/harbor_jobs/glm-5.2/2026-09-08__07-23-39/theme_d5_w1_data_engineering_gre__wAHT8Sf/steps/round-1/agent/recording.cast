[17019.905147, "o", "\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktype \u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KField struct {\r\n\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc parseSummaryFields(data []byte) ([]\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KField, error) {\r\n\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn nil, fmt.Errorf(\"\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K output is not a JSON object\")\r\n\u001b[32m\u001b[K199\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvar fields []\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KField\r\n\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\treturn nil, fmt.Errorf(\"\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K object key is not a string\")\r\n\u001b[32m\u001b[K213\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfields = append(fields, \u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KField{key: key, value: val})\r\n"]
[17019.90525, "o", "\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc buildSchemaSidecar(\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KData []byte, cfg cliConfig, runIndex int) ([]byte, error) {\r\n\u001b[32m\u001b[K404\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfields, err := parseSummaryFields(\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KData)\r\n\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchema := make([]orderedJSON, 0, len(fields))\r\n\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchema = append(\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchema, orderedJSON{key: f.key, value: descriptorFor(f.value, 0, cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaStrict)})\r\n"]
[17019.905328, "o", "\u001b[32m\u001b[K429\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t{key: \"schema_version\", value: \u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaVersion},\r\n\u001b[32m\u001b[K430\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t{key: \"\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K_schema\", value: \u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchema},\r\n\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t{key: \"field_\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[K\", value: []orderedJSON{\r\n\u001b[32m\u001b[K438\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t{key: \"strict_mode\", value: cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaStrict},\r\n\u001b[32m\u001b[K448\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc writeSummarySchemaSidecars(cfg cliConfig, \u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KData []byte, runIndex int) error {\r\n\u001b[32m\u001b[K449\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K"]
[17019.905393, "o", "\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut == \"\" {\r\n\u001b[32m\u001b[K452\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tschemaData, err := buildSchemaSidecar(\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KData, cfg, runIndex)\r\n\u001b[32m\u001b[K456\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif err := atomicWriteFile(cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut, schemaData); err != nil {\r\n\u001b[32m\u001b[K459\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest != \"\" {\r\n\u001b[32m\u001b[K460\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\thash, n, err := fileDigest(cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut)\r\n\u001b[32m\u001b[K465\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t"]
[17019.905455, "o", "\t\t{key: \"schema_path\", value: filepath.Base(cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut)},\r\n\u001b[32m\u001b[K473\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif err := atomicWriteFile(cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaDigest, data); err != nil {\r\n\u001b[32m\u001b[K476\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tif cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaIndex != \"\" {\r\n\u001b[32m\u001b[K477\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tindex, err := buildIndexSidecar(cfg, \u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KData)\r\n\u001b[32m\u001b[K481\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tif err := atomicWriteFile(cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaIndex, index); err != nil {\r\n\u001b[32m\u001b[K489\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc buildIndexSidecar(cfg cliConfig, \u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KData []byte) ([]byte, error) {\r\n"]
[17019.905524, "o", "\u001b[32m\u001b[K490\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tfields, err := parseSummaryFields(\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KData)\r\n\u001b[32m\u001b[K523\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t{key: \"generated_from\", value: filepath.Base(cfg.\u001b[01;31m\u001b[Ksummary\u001b[m\u001b[KSchemaOut)},\r\n"]
