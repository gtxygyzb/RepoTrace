[5360.905529, "o", "    maxOpenSessions: maxOpenSessions,\r\n    now: time.Now().UTC(),\r\n    seenIds: map[string]bool{},\r\n    sameRunSeen: map[string]bool{},\r\n    pendingByID: map[string]*pendingEntry{},\r\n    openSessions: map[string]carriedSession{},\r\n    runIndex: 0,\r\n    stats: &stateStats{},\r\n    hasAudit: hasAudit,\r\n    auditBuilder: &bytes.Buffer{},\r\n    digestCounts: digest{InvalidReasons: map[string]int{}},\r\n  }\r\n  if st != nil {\r\n    p.seenIds = copyStringBoolMap(st.seenIds)\r\n    p.pending = append([]pendingEntry(nil), st.pending...)\r\n    for i := range p.pending {\r\n      p.pendingByID[p.pending[i].id] = &p.pending[i]\r\n    }\r\n    for u, s := range st.openSessions {\r\n      p.openSessions[u] = s\r\n    }\r\n"]
[5360.905625, "o", "    p.runIndex = st.runIndex\r\n    p.hasMax = st.hasMax\r\n    p.maxTs = st.maxTs\r\n    p.stats.CarryInPending = st.carryInPending\r\n    p.stats.CarryInOpenSessions = st.carryInOpenSessions\r\n  }\r\n  if maxOpenSessions <= 0 {\r\n    p.maxOpenSessions = 0\r\n  }\r\n  return p\r\n}\r\n\r\nfunc copyStringBoolMap(m map[string]bool) map[string]bool {\r\n  out := make(map[string]bool, len(m))\r\n  for k, v := range m {\r\n    out[k] = v\r\n  }\r\n  return out\r\n}\r\n\r\nfunc (p *processor) currentCutoff() string {\r\n  if p.hasMax {\r\n    return formatTS(p.maxTs.Add(-p.watermarkLag))\r\n  }\r\n  return \"\"\r\n}\r\n\r\nfunc (p *processor) updateMax(t time.Time) {\r\n"]
[5360.905694, "o", "  if !p.hasMax || t.After(p.maxTs) {\r\n    p.maxTs = t\r\n    p.hasMax = true\r\n  }\r\n}\r\n\r\nfunc (p *processor) processEvents(raws []rawEvent) ([]*Event, []Reject, []auditRecord) {\r\n  var accepted []*Event\r\n  var rejects []Reject\r\n  var audits []auditRecord\r\n  for _, raw := range raws {\r\n    ctx := newContext(raw)\r\n    ev, invalidReason := parseEvent(ctx, p.rt)\r\n    if ev == nil {\r\n      rec := auditRecord{Bucket: \"invalid\", Reason: invalidReason, Raw: ctx}\r\n      rejects = append(rejects, Reject{Bucket: 1, Reason: invalidReason, Event: ctx.Raw})\r\n      audits = append(audits, rec)\r\n      continue\r\n    }\r\n    if p.seenIds[ev.ID] {\r\n      rec := auditRecord{Bucket: \"duplicate\", Reason: \"cross_run\", Raw: ctx}\r\n"]
[5360.905743, "o", "      rejects = append(rejects, Reject{Bucket: 2, Reason: \"cross_run\", Event: ctx.Raw})\r\n      audits = append(audits, rec)\r\n      continue\r\n    }\r\n    if p.sameRunSeen[ev.ID] {\r\n      rec := auditRecord{Bucket: \"duplicate\", Reason: \"same_run\", Raw: ctx}\r\n      rejects = append(rejects, Reject{Bucket: 2, Reason: \"same_run\", Event: ctx.Raw})\r\n      audits = append(audits, rec)\r\n      continue\r\n    }\r\n    cutoff := p.currentCutoff()\r\n    if p.hasMax && ev.TS.Before(p.maxTs.Add(-p.watermarkLag)) {\r\n      rec := auditRecord{Bucket: \"late\", Cutoff: cutoff, Raw: ctx}\r\n      rejects = append(rejects, Reject{Bucket: 3, Reason: \"late\", Event: ctx.Raw})\r\n      audits = append(audits, rec)\r\n      continue\r\n    }\r\n    p.sameRunSeen[ev.ID] = true\r\n    p.updateMax(ev.TS)\r\n    acceptedEvent, audit := p.acceptEvent(ctx, ev)\r\n    accepted = append(accepted, acceptedEvent)\r\n    audits = append(audits, audit)\r\n  }\r\n  return accepted, rejects, audits\r\n}\r\n\r\nfunc (p *processor) acceptEvent(ctx *eventContext, ev *Event) (*Event, au"]
[5360.905799, "o", "ditRecord) {\r\n  p.handleSession(ev)\r\n  rec := auditRecord{Bucket: \"accepted\", USD: ev.USD, SessionIndex: ev.sessionIndex, ResolvedAgainst: nil, Raw: ctx}\r\n  switch ev.Type {\r\n  case \"purchase\":\r\n    pe := pendingEntry{id: ev.ID, ts: ev.TS, user: ev.UserID, usd: ev.USD, originRun: p.runIndex + 1}\r\n    p.pending = append(p.pending, pe)\r\n    p.pendingByID[ev.ID] = &p.pending[len(p.pending)-1]\r\n  case \"refund\":\r\n    pe := pendingEntry{id: ev.ID, ts: ev.TS, user: ev.UserID, usd: ev.USD, originRun: p.runIndex + 1}\r\n    p.pending = append(p.pending, pe)\r\n    p.pendingByID[ev.ID] = &p.pending[len(p.pending)-1]\r\n  case \"chargeback\":\r\n    resolved := p.resolveChargeback(ev)\r\n    if resolved == \"\" {\r\n      rec.Bucket = \"unresolved_chargeback\"\r\n      rec.RefID = ev.RefID\r\n      p.stats.Anomalies? // placeholder\r\n    } else {\r\n      rec.ResolvedAgainst = &resolved\r\n    }\r\n"]
[5360.905847, "o", "  }\r\n  return ev, rec\r\n}\r\n"]
