[17331.55888, "o", "   543\t\r\n   544\t\t// Finalize accepted/duplicate buckets and outputs in arrival order.\r\n   545\t\thasMin, hasMax = false, false\r\n   546\t\tfor _, c := range candidates {\r\n"]
[17331.558958, "o", "   547\t\t\tif c.ev != nil {\r\n   548\t\t\t\tseen[c.ev.ID] = true\r\n   549\t\t\t}\r\n   550\t\t}\r\n   551\t\tbucketCounts[\"accepted\"] = 0\r\n   552\t\tbucketCounts[\"duplicate\"] = duplicateReasons[\"cross_run\"]\r\n   553\t\tfor i, c := range candidates {\r\n   554\t\t\t_ = i\r\n   555\t\t\tif c.ev == nil {\r\n   556\t\t\t\tcontinue\r\n"]
[17331.559025, "o", "   557\t\t\t}\r\n   558\t\t\tif winnerSet[i] {\r\n   559\t\t\t\tbucketCounts[\"accepted\"]++\r\n   560\t\t\t\tshardAccepted[c.ev.Shard]++\r\n   561\t\t\t\tif !hasMin || c.ev.TS.Before(minTs) {\r\n   562\t\t\t\t\tminTs = c.ev.TS\r\n   563\t\t\t\t\thasMin = true\r\n   564\t\t\t\t}\r\n   565\t\t\t\tif !hasMax || c.ev.TS.After(maxTs) {\r\n"]
[17331.559084, "o", "   566\t\t\t\t\tmaxTs = c.ev.TS\r\n   567\t\t\t\t\thasMax = true\r\n   568\t\t\t\t}\r\n   569\t\t\t\t_ = pending\r\n   570\t\t\t\t_ = openSessions\r\n   571\t\t\t} else {\r\n   572\t\t\t\tbucketCounts[\"duplicate\"]++\r\n"]
[17331.559144, "o", "   573\t\t\t\tduplicateReasons[\"same_run\"]++\r\n   574\t\t\t\tentry := auditEntries[i]\r\n   575\t\t\t\tentry.Bucket = \"duplicate\"\r\n   576\t\t\t\tentry.Reason = \"same_run\"\r\n   577\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n   578\t\t\t\t\tw := winners[entry.ID]\r\n   579\t\t\t\t\tentry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}\r\n"]
[17331.559237, "o", "   580\t\t\t\t}\r\n   581\t\t\t\tauditEntries[i] = entry\r\n   582\t\t\t}\r\n   583\t\t}\r\n   584\t\r\n   585\t\t// Collect surviving (accepted winner) events for session summary.\r\n   586\t"]
[17331.559314, "o", "\tsurvivingByUser := map[string][]*Event{}\r\n   587\t\tfor i, c := range candidates {\r\n   588\t\t\tif c.ev != nil && winnerSet[i] {\r\n   589\t\t\t\tsurvivingByUser[c.ev.UserID] = append(survivingByUser[c.ev.UserID], c.ev)\r\n"]
[17331.559371, "o", "   590\t\t\t}\r\n   591\t\t}\r\n   592\t\tfor u := range survivingByUser {\r\n   593\t\t\tevs := survivingByUser[u]\r\n   594\t\t\tsort.SliceStable(evs, func(i, j int) bool {\r\n   595\t\t\t\treturn evs[i].TS.Before(evs[j].TS)\r\n   596\t\t\t})\r\n   597\t\t\tsurvivingByUser[u] = evs\r\n   598\t\t}\r\n   599\t\tsessionTotal := 0\r\n"]
[17331.559428, "o", "   600\t\tbyUser := make([]summarySessionUser, 0, len(survivingByUser))\r\n   601\t\tfor _, u := range sortedKeys(survivingByUser) {\r\n   602\t\t\tevs := survivingByUser[u]\r\n   603\t\t\tsessionTotal += computeSessionCount(evs, cfg.sessionPolicy, cfg.sessionGap, cfg.fixedWindowSeconds)\r\n   604\t\t\tbyUser = append(byUser, summarySessionUser{User: u, Count: len(evs)})\r\n   605\t\t}\r\n   606\t\r\n"]
[17331.559485, "o", "   607\t\tvar rejectRecords []rejectRecord\r\n   608\t\tfor i, c := range candidates {\r\n   609\t\t\tif c.ev == nil {\r\n   610\t\t\t\tr := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, shard: c.raw.Shard, line: c.raw.Line, raw: c.raw.Raw}\r\n   611\t\t\t\trejectRecords = append(rejectRecords, r)\r\n   612\t\t\t\tcontinue\r\n   613\t\t\t}\r\n   614\t\t\tif winnerSet[i] {\r\n"]
[17331.559543, "o", "   615\t\t\t\tcontinue\r\n   616\t\t\t}\r\n   617\t\t\tr := rejectRecord{bucket: \"duplicate\", reason: \"same_run\", shard: c.raw.Shard, line: c.raw.Line, raw: c.raw.Raw}\r\n   618\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n   619\t\t\t\tr.winner = true\r\n   620\t\t\t\tr.winnerShard = candidates[winners[c.ev.ID]].ev.Shard\r\n   621\t\t\t\tr.winnerLine = candidates[winners[c.ev.ID]].ev.Line\r\n"]
[17331.559603, "o", "   622\t\t\t}\r\n   623\t\t\trejectRecords = append(rejectRecords, r)\r\n   624\t\t}\r\n   625\t\r\n"]
