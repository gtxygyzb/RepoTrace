[12876.648084, "o", "package main\r\n\r\nimport (\r\n\t\"bytes\"\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"regexp\"\r\n"]
[12876.648242, "o", "\t\"sort\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\nvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n\r\ntype cliConfig struct {\r\n\tinputDir            string\r\n\tratesPath           string\r\n\toutputPath          string\r\n\trejectsPath         string\r\n\tsessionGap          int\r\n\twatermarkLag        int\r\n\tstateIn             string\r\n\tstateOut            string\r\n\tpendingTTL          int\r\n\tmaxOpenSessions     int\r\n\tauditLog            string\r\n"]
[12876.648345, "o", "\tauditLogDigest      string\r\n\tauditLogRotateBytes int\r\n\tratesStrict         bool\r\n\tratesMaxStaleness   int\r\n\tingestID            string\r\n\tingestIDSet         bool\r\n\toutManifest         string\r\n\tmanifestSignature   string\r\n\tdedupPolicy         string\r\n\tdedupPolicySet      bool\r\n\tstrictLateAudit     bool\r\n\tstateStrict         bool\r\n}\r\n\r\nfunc main() {\r\n\tcfg, err := parseArgs(os.Args[1:])\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\tos.Exit(2)\r\n\t}\r\n\tif err := run(cfg); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[12876.648425, "o", "\t\tos.Exit(1)\r\n\t}\r\n}\r\n\r\n"]
