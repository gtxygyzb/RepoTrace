[16982.498219, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.\u001b[01;31m\u001b[KfixedWindow\u001b[m\u001b[KSeconds = atoiOrError(nextArg(args, &i), \"--fixed-window-seconds\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K191\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tcfg.\u001b[01;31m\u001b[KfixedWindow\u001b[m\u001b[KSet = true\r\n"]
[16982.498282, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K266\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[KsessionPolicy\u001b[m\u001b[K == \"\" {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tcfg.\u001b[01;31m\u001b[KsessionPolicy\u001b[m\u001b[K = \"gap\"\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[KfixedWindow\u001b[m\u001b[KSet && cfg.\u001b[01;31m\u001b[KsessionPolicy\u001b[m\u001b[K == \"gap\" {\r\n"]
[16982.498342, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[KsessionPolicy\u001b[m\u001b[K == \"fixed-window\" && !cfg.\u001b[01;31m\u001b[KfixedWindow\u001b[m\u001b[KSet {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K275\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[KsessionPolicy\u001b[m\u001b[K == \"hybrid\" && !cfg.\u001b[01;31m\u001b[KfixedWindow\u001b[m\u001b[KSet {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K278\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif cfg.\u001b[01;31m\u001b[KfixedWindow\u001b[m\u001b[KSet && cfg.\u001b[01;31m\u001b[KfixedWindow\u001b[m\u001b[KSeconds < 1 {\r\n"]
[16982.498488, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K300\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KcomputeSessionCount\u001b[m\u001b[K(evs []*Event, policy string, gap, windowSecs int) int {\r\n"]
[16982.498561, "o", "\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K384\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\topen\u001b[01;31m\u001b[KSessions\u001b[m\u001b[K := map[string]carriedSession{}\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K387\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tfor k, v := range st.open\u001b[01;31m\u001b[KSessions\u001b[m\u001b[K {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K388\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\topen\u001b[01;31m\u001b[KSessions\u001b[m\u001b[K[k] = v\r\n"]
