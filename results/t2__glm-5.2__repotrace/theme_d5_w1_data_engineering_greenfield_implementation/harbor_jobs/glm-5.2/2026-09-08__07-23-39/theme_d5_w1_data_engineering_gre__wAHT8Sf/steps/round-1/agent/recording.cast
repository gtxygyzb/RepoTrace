[7252.300847, "o", "\t\t\t\tif !present {\r\n   371\t\t\t\t\treturn nil, \"missing_amount\"\r\n   372\t\t\t\t}\r\n   373\t\t\t\tn, err := getJSONInt(raw)\r\n   374\t\t\t\tif err != nil || n < 0 {\r\n   375\t\t\t\t\treturn nil, \"bad_amount\"\r\n   376\t\t\t\t}\r\n   377\t\t\t\tamount = float64(n) / 100.0\r\n"]
