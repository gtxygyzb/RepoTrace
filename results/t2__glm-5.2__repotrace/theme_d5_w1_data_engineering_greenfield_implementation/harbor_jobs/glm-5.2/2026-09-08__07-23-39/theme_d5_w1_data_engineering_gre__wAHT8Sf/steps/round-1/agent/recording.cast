[9328.640016, "o", "   354  func buildManifest(cfg cliConfig, runIndex int, ratesDigest string, shards []inputShardInfo, shardAccepted map[string]int, bucketCounts map[string]int, hasMin bool, minTs time.Time, hasMax bool, maxTs time.Time) (manifestOutput, error) {\r\n   355  \tsortedShards := append([]inputShardInfo(nil), shards...)\r\n   356  \tsort.SliceStable(sortedShards, func(i, j int) bool {\r\n   357  \t\treturn sortedShards[i].Name < sortedShards[j].Name\r\n   358  \t})\r\n   359  \tmanifestShards := make([]manifestShard, 0, len(sortedShards))\r\n   360  \tfor _, s := range sortedShards {\r\n   361  \t\tmanifestShards = append(manifestShards, manifestShard{\r\n   362  \t\t\tShard:          s.Name,\r\n   363  \t\t\tSHA256:         s.SHA256,\r\n   364  \t\t\tBytes:          s.Bytes,\r\n   365  \t\t\tEventsTotal:    s.EventsTotal,\r\n"]
