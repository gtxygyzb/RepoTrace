[17019.321494, "o", "   272\t\tif cfg.sessionPolicy == \"fixed-window\" && !cfg.fixedWindowSet {\r\n   273\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --session-policy fixed-window requires --fixed-window-seconds\")\r\n   274\t\t}\r\n   275\t\tif cfg.sessionPolicy == \"hybrid\" && !cfg.fixedWindowSet {\r\n   276\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --session-policy hybrid requires --fixed-window-seconds\")\r\n   277\t\t}\r\n   278\t\tif cfg.fixedWindowSet && cfg.fixedWindowSeconds < 1 {\r\n   279\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --fixed-window-seconds: must be a positive integer\")\r\n   280\t\t}\r\n   281\t\treturn cfg, nil\r\n   282\t}\r\n   283\t\r\n"]
[17019.321523, "o", "   284\tfunc nextArg(args []string, i *int) string {\r\n   285\t\tif *i+1 >= len(args) {\r\n   286\t\t\tpanic(fmt.Errorf(\"ingest: missing value for %s\", args[*i]))\r\n"]
[17019.321609, "o", "   287\t\t}\r\n   288\t\t*i++\r\n   289\t\treturn args[*i]\r\n   290\t}\r\n   291\t\r\n   292\tfunc atoiOrError(s, flag string) int {\r\n   293\t\tn, err := strconv.Atoi(s)\r\n   294\t\tif err != nil {\r\n   295\t\t\tpanic(fmt.Errorf(\"ingest: invalid integer for %s: %s\", flag, s))\r\n   296\t\t}\r\n   297\t\treturn n\r\n   298\t}\r\n   299\t\r\n   300\tfunc computeSessionCount(evs []*Event, policy string, gap, windowSecs int) int {\r\n"]
[17019.321675, "o", "   301\t\tif len(evs) == 0 {\r\n   302\t\t\treturn 0\r\n   303\t\t}\r\n   304\t\tcount := 1\r\n   305\t\tvar anchor int64\r\n   306\t\tif policy == \"fixed-window\" || policy == \"hybrid\" {\r\n   307\t\t\tanchor = floorEpochToWindow(evs[0].TS.Unix(), int64(windowSecs))\r\n   308\t\t}\r\n   309\t\tfor i := 1; i < len(evs); i++ {\r\n   310\t\t\tsplit := false"]
[17019.321707, "o", "\r\n   311\t\t\tif policy == \"gap\" || policy == \"hybrid\" {\r\n   312\t\t\t\tif evs[i].TS.Sub(evs[i-1].TS) > time.Duration(gap)*time.Second {\r\n   313\t\t\t\t\tsplit = true\r\n   314\t\t\t\t}\r\n   315"]
[17019.321787, "o", "\t\t\t}\r\n   316\t\t\tif policy == \"fixed-window\" || policy == \"hybrid\" {\r\n   317\t\t\t\tkPrev := floorDiv(evs[i-1].TS.Unix()-anchor, int64(windowSecs))\r\n   318\t\t\t\tkCur := floorDiv(evs[i].TS.Unix()-anchor, int64(windowSecs))\r\n   319\t\t\t\tif kPrev != kCur {\r\n   320\t\t\t\t\tsplit = true\r\n   321\t\t\t\t}\r\n   322\t\t\t}\r\n   323\t\t\tif split {\r\n   324\t\t\t\tcount++\r\n   325\t\t\t}\r\n"]
[17019.321817, "o", "   326\t\t}\r\n   327\t\treturn count\r\n   328\t}\r\n   329\t\r\n   330\tfunc floorEpochToWindow(epoch, window int64) int64 {\r\n   331\t\tif window <= 0 {\r\n"]
[17019.322013, "o", "   332\t\t\treturn 0\r\n   333\t\t}\r\n   334\t\treturn floorDiv(epoch, window) * window\r\n   335\t}\r\n   336\t\r\n   337\tfunc floorDiv(a, b int64) int64 {\r\n   338\t\tif b == 0 {\r\n   339\t\t\treturn 0\r\n   340\t\t}\r\n   341\t\tq := a / b\r\n   342\t\tif (a%b != 0) && ((a < 0) != (b < 0)) {\r\n   343\t\t\tq--\r\n   344\t\t}\r\n   345\t\treturn q\r\n   346\t}\r\n   347\t\r\n   348\tfunc ptrCutoff(c cutoffObject) *cutoffObject {\r\n   349\t\treturn &c\r\n   350\t}\r\n   351\t\r\n   352\tfunc run(cfg cliConfig) error {\r\n   353\t\tratesData, err := os.ReadFile(cfg.ratesPath)\r\n   354\t\tif err != nil {\r\n   355\t\t\treturn fmt.Errorf(\"ingest: rates: %w\", err)\r\n   356\t\t}\r\n   357\t\tratesDigest := sha256Hex(ratesData)\r\n   358\t\trt, err := loadRates(cfg.ratesPath)\r\n   359\t\tif err != nil {\r\n"]
[17019.322141, "o", "   360\t\t\treturn err\r\n"]
