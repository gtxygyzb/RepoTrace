[12717.154428, "o", "\u001b[?2004l\r"]
[12717.158227, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n"]
[12717.1583, "o", "     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"regexp\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t\t\"time\"\r\n    14\t)\r\n    15\t\r\n"]
[12717.158375, "o", "    16\tvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n    17\t\r\n    18\ttype cliConfig struct {\r\n    19\t\tinputDir            string\r\n    20\t\tratesPath           string\r\n"]
[12717.158446, "o", "    21\t\toutputPath          string\r\n    22\t\trejectsPath         string\r\n    23\t\tsessionGap          int\r\n    24\t\twatermarkLag        int\r\n    25\t\tstateIn             string\r\n    26\t\tstateOut            string\r\n    27\t\tpendingTTL          int\r\n    28\t\tmaxOpenSessions     int\r\n    29\t\tauditLog            string\r\n    30\t\tauditLogDigest      string\r\n    31\t\tauditLogRotateBytes int\r\n    32\t\tratesStrict         bool\r\n    33\t\tratesMaxStaleness   int\r\n    34\t\tingestID            string\r\n    35\t\tingestIDSet         bool\r\n    36\t\toutManifest         string\r\n    37\t\tmanifestSignature   string\r\n"]
[12717.158526, "o", "    38\t\tdedupPolicy         string\r\n    39\t\tdedupPolicySet      bool\r\n    40\t\tstrictLateAudit     bool\r\n    41\t\tstateStrict         bool\r\n    42\t}\r\n    43\t\r\n    44\tfunc main() {\r\n    45\t\tcfg, err := parseArgs(os.Args[1:])\r\n    46\t\tif err != nil {\r\n    47\t\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[12717.15863, "o", "    48\t\t\tos.Exit(2)\r\n    49\t\t}\r\n    50\t\tif err := run(cfg); err != nil {\r\n    51\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    52\t\t\tos.Exit(1)\r\n    53\t\t}\r\n    54\t}\r\n    55\t\r\n    56\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n    57\t\tdefer func() {\r\n    58\t\t\tif r := recover(); r != nil {\r\n    59\t\t\t\tcfg = cliConfig{}\r\n    60\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n    61\t\t\t}\r\n    62"]
[12717.15869, "o", "\t\t}()\r\n    63\t\tcfg = cliConfig{\r\n    64\t\t\tsessionGap:        600,\r\n    65\t\t\twatermarkLag:      300,\r\n    66\t\t\tpendingTTL:        86400,\r\n    67\t\t\tmaxOpenSessions:   100000,\r\n    68\t\t\tratesMaxStaleness: 0,\r\n    69\t"]
[12717.158752, "o", "\t}\r\n    70\t\trequired := map[string]bool{\r\n    71\t\t\t\"--input-dir\": false,\r\n    72\t\t\t\"--rates\":     false,\r\n    73\t\t\t\"--output\":    false,\r\n    74\t\t\t\"--rejects\":   false,\r\n    75\t\t}\r\n    76\t\tif len(args) > 0 && args[0] == \"ingest\" {\r\n    77"]
[12717.158816, "o", "\t\t\targs = args[1:]\r\n    78\t\t}\r\n    79\t\tfor i := 0; i < len(args); i++ {\r\n    80\t\t\targ := args[i]\r\n    81\t\t\tswitch arg {\r\n    82\t\t\tcase \"--input-dir\":\r\n    83\t\t\t\tcfg.inputDir = nextArg(args, &i)\r\n    84\t\t\tcase \"--rates\":\r\n    85\t\t\t\tcfg.ratesPath = nextArg(args, &i)\r\n"]
[12717.158891, "o", "    86\t\t\tcase \"--output\":\r\n    87\t\t\t\tcfg.outputPath = nextArg(args, &i)\r\n    88\t\t\tcase \"--rejects\":\r\n    89\t\t\t\tcfg.rejectsPath = nextArg(args, &i)\r\n    90\t\t\tcase \"--session-gap\":\r\n    91\t\t\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\r\n    92\t\t\tcase \"--watermark-lag\":\r\n    93\t\t\t\tcfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")\r\n    94\t\t\tcase \"--state-in\":\r\n    95\t\t\t\tcfg.stateIn = nextArg(args, &i)\r\n    96\t\t\tcase \"--state-out\":\r\n"]
[12717.158953, "o", "    97\t\t\t\tcfg.stateOut = nextArg(args, &i)\r\n    98\t\t\tcase \"--pending-ttl\":\r\n    99\t\t\t\tcfg.pendingTTL = atoiOrError(nextArg(args, &i), \"--pending-ttl\")\r\n   100\t\t\tcase \"--max-open-sessions\":\r\n   101\t\t\t\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-sessions\")\r\n   102\t\t\tcase \"--audit-log\":\r\n   103\t\t\t\tcfg.auditLog = nextArg(args, &i)\r\n"]
[12717.159011, "o", "   104\t\t\tcase \"--audit-log-digest\":\r\n   105\t\t\t\tcfg.auditLogDigest = nextArg(args, &i)\r\n   106\t\t\tcase \"--audit-log-rotate-bytes\":\r\n   107\t\t\t\tcfg.auditLogRotateBytes = atoiOrError(nextArg(args, &i), \"--audit-log-rotate-bytes\")\r\n   108\t\t\tcase \"--rates-strict\":\r\n   109\t\t\t\tcfg.ratesStrict = true\r\n   110\t\t\tcase \"--rates-max-staleness\":\r\n   111\t\t\t\tcfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), \"--rates-max-staleness\")\r\n   112\t\t\tcase \"--ingest-id\":\r\n   113\t\t\t\tcfg.ingestID = nextArg(args, &i)\r\n"]
[12717.159076, "o", "   114\t\t\t\tcfg.ingestIDSet = true\r\n   115\t\t\tcase \"--out-parquet-manifest\":\r\n   116\t\t\t\tcfg.outManifest = nextArg(args, &i)\r\n   117\t\t\tcase \"--manifest-signature\":\r\n   118\t\t\t\tcfg.manifestSignature = nextArg(args, &i)\r\n   119\t\t\tcase \"--dedup-policy\":\r\n   120\t\t\t\tval := nextArg(args, &i)\r\n   121\t\t\t\tif val != \"first-arrival\" && val != \"lex-largest-ts\" {\r\n   122\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --dedup-policy: must be one of {first-arrival, lex-largest-ts}\")\r\n   123\t\t\t\t"]
[12717.159137, "o", "}\r\n   124\t\t\t\tcfg.dedupPolicy = val\r\n   125\t\t\t\tcfg.dedupPolicySet = true\r\n   126\t\t\tcase \"--strict-late-audit\":\r\n   127\t\t\t\tcfg.strictLateAudit = true\r\n   128\t\t\tcase \"--state-strict\":\r\n   129\t\t\t\tcfg.stateStrict = true\r\n   130\t\t\tdefault:\r\n   131\t\t\t"]
[12717.159222, "o", "\treturn cliConfig{}, fmt.Errorf(\"ingest: unknown flag %s\", arg)\r\n   132\t\t\t}\r\n   133\t\t\tif strings.HasPrefix(arg, \"--\") && arg != \"--rates-strict\" && arg != \"--strict-late-audit\" && arg != \"--state-strict\" {\r\n   134\t\t\t\tif _, ok := required[arg]; ok {\r\n   135\t\t\t\t\trequired[arg] = true\r\n   136\t\t\t\t}\r\n   137\t\t\t}\r\n   138\t\t}\r\n   139\t\tfor k, ok := range required {\r\n   140\t\t\tif !ok {\r\n   141"]
