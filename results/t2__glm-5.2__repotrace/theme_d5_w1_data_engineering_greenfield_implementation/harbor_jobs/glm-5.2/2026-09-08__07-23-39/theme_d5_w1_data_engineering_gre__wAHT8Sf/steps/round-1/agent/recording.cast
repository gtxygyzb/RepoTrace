[16949.71467, "o", "    '\\tif cfg.rejectsFormatHeader && cfg.rejectsFormat != \"tagged\" && cfg.rejectsFormat != \"tagged-sorted\" {\\n\\t\\treturn cliConfig{}, fmt.Errorf(\"ingest: --rejects-format-header requires --rejects-format tagged\")\\n\\t}\\n\\treturn cfg, nil',\r\n\u001b[?2004l\r"]
[16949.714755, "o", "\u001b[?2004h> "]
[16949.719105, "o", "    '\\tif cfg.rejectsFormatHeader && cfg.rejectsFormat != \"tagged\" && cfg.rejectsFormat != \"tagged-sorted\" {\\n\\t\\treturn cliConfig{}, fmt.Errorf(\"ingest: --rejects-format-header requires --rejects-format tagged\")\\n\\t}\\n\\tif cfg.sessionPolicy == \"\" {\\n\\t\\tcfg.sessionPolicy = \"gap\"\\n\\t}\\n\\tif cfg.fixedWindowSet && cfg.sessionPolicy == \"gap\" {\\n\\t\\treturn cliConfig{}, fmt.Errorf(\"ingest: --fixed-window-seconds requires --session-policy fixed-window or hybrid\")\\n\\t}\\n\\tif cfg.sessionPolicy == \"fixed-window\" && !cfg.fixedWindowSet {\\n\\t\\treturn cliConfig{}, fmt.Errorf(\"ingest: --session-policy fixed-window requires --fixed-window-seconds\")\\n\\t}\\n\\tif cfg.sessionPolicy == \"hybrid\" && !cfg.fixedWindowSet {\\n\\t\\treturn cliConfig{}, fmt.Errorf(\"ingest: --session-policy hybrid requires --fixed-window-seconds\")\\n\\t}\\n\\tif cfg.fixedWindowSet && cfg.fixedWindowSeconds < 1 {\\n\\t\\treturn cliConfig{}, fmt.Errorf(\"ingest: --fixed-window-seconds: must be a positive integer\")\\n\\t}\\n\\treturn cfg, nil'\r\n\u001b[?2004l\r"]
[16949.719203, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> "]
