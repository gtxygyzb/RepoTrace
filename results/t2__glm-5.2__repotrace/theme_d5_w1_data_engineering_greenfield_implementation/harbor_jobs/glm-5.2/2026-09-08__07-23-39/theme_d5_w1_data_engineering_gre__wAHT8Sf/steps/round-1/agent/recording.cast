[7281.470558, "o", "\t}\r\n   165\t\t}\r\n   166\t\tif maxStaleness > 0 {\r\n   167\t\t\teventDay := dayEpoch(date)\r\n   168\t\t\tif !eventDay.IsZero() {\r\n   169\t\t\t\tvar bestDate string\r\n   170\t\t\t\tvar bestDist int64 = -1\r\n   171\t\t\t\tfor _, d := range sortedKeys(rt.days) {\r\n   172\t\t\t\t\tif _, ok := rt.days[d][currency]; !ok {\r\n   173\t\t\t\t\t\tcontinue\r\n   174\t\t\t\t\t}\r\n   175\t\t\t\t\tdayTime := dayEpoch(d)\r\n   176\t\t\t\t\tif dayTime.IsZero() {\r\n   177\t\t\t\t\t\tcontinue\r\n   178\t\t\t\t\t}\r\n   179\t\t\t\t\tdist := absInt64(dayTime.Unix() - eventDay.Unix())\r\n   180\t\t\t\t\tif dist > int64(maxStaleness) {\r\n"]
[7281.470652, "o", "   181\t\t\t\t\t\tcontinue\r\n   182\t\t\t\t\t}\r\n   183\t\t\t\t\tif bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {\r\n   184\t\t\t\t\t\tbestDist = dist\r\n   185\t\t\t\t\t\tbestDate = d\r\n   186\t\t\t\t\t}\r\n"]
