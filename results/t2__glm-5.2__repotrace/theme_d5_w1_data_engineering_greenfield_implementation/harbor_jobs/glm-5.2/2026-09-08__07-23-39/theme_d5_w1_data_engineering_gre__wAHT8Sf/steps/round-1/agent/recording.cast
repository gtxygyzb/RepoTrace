[14568.48484, "o", "\tcfg, err := parseArgs(os.Args[1:])\r\n    50\t\tif err != nil {\r\n    51\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    52\t\t\tos.Exit(2)\r\n    53\t\t}\r\n    54\t\tif err := run(cfg); err != nil {\r\n    55\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    56\t\t\tos.Exit(1)\r\n    57\t\t}\r\n    58\t}\r\n    59\t\r\n    60"]
[14568.484901, "o", "\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n    61\t\tdefer func() {\r\n    62\t\t\tif r := recover(); r != nil {\r\n    63\t\t\t\tcfg = cliConfig{}\r\n    64\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n    65\t\t\t}\r\n    66\t\t}()\r\n    67\t\tcfg = cliConfig{\r\n    68\t\t\tsessionGap:        600,\r\n    69\t\t\twatermarkLag:      300,\r\n"]
[14568.484959, "o", "    70\t\t\tpendingTTL:        86400,\r\n    71\t\t\tmaxOpenSessions:   100000,\r\n    72\t\t\tratesMaxStaleness: 0,\r\n    73\t\t}\r\n    74\t\trequired := map[string]bool{\r\n    75\t\t\t\"--input-dir\": false,\r\n    76\t\t\t\"--rates\":     false,\r\n    77\t\t\t\"--output\":    false,\r\n"]
[14568.485017, "o", "    78\t\t\t\"--rejects\":   false,\r\n    79\t\t}\r\n    80\t\tif len(args) > 0 && args[0] == \"ingest\" {\r\n    81\t\t\targs = args[1:]\r\n    82\t\t}\r\n    83\t\tfor i := 0; i < len(args); i++ {\r\n    84\t\t\targ := args[i]\r\n    85\t\t\tif strings.HasPrefix(arg, \"--summary-schema-out=\") {\r\n    86\t\t\t\tcfg.summarySchemaOut = strings.TrimPrefix(arg, \"--summary-schema-out=\")\r\n"]
[14568.485074, "o", "    87\t\t\t\tif cfg.summarySchemaOut == \"\" {\r\n    88\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-out: value must be non-empty\")\r\n    89\t\t\t\t}\r\n    90\t\t\t\tcontinue\r\n    91\t\t\t}\r\n    92\t\t\tif strings.HasPrefix(arg, \"--summary-schema-digest=\") {\r\n    93\t\t\t\tcfg.summarySchemaDigest = strings.TrimPrefix(arg, \"--summary-schema-digest=\")\r\n"]
[14568.485133, "o", "    94\t\t\t\tif cfg.summarySchemaDigest == \"\" {\r\n    95\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest: value must be non-empty\")\r\n    96\t\t\t\t}\r\n    97\t\t\t\tcontinue\r\n    98\t\t\t}\r\n    99\t\t\tif strings.HasPrefix(arg, \"--summary-schema-index=\") {\r\n   100\t\t\t\tcfg.summarySchemaIndex = strings.TrimPrefix(arg, \"--summary-schema-index=\")\r\n   101\t\t\t\tif cfg.summarySchemaIndex == \"\" {\r\n"]
