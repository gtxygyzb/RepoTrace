[18189.48594, "o", "    28\t\tmaxOpenSessions     int\r\n    29\t\tauditLog            string\r\n    30\t\tauditLogDigest      string\r\n    31\t\tauditLogRotateBytes int\r\n    32\t\tratesStrict         bool\r\n    33\t\tratesMaxStaleness   int\r\n    34\t\tingestID            string\r\n    35\t\tingestIDSet         bool\r\n    36\t\toutManifest         string\r\n    37\t\tmanifestSignature   string\r\n    38\t\tdedupPolicy         string\r\n    39\t\tdedupPolicySet      bool\r\n    40\t\tstrictLateAudit     bool\r\n    41\t\tstateStrict         bool\r\n    42\t\tsummarySchemaOut    string\r\n    43\t\tsummarySchemaDigest string\r\n    44\t\t"]
[18189.486006, "o", "summarySchemaStrict bool\r\n    45\t\tsummarySchemaIndex  string\r\n    46\t\trejectsFormat       string\r\n    47\t\trejectsFormatHeader bool\r\n    48\t\tsessionPolicy       string\r\n    49\t\tfixedWindowSeconds  int\r\n    50\t\tfixedWindowSet      bool\r\n    51\t}\r\n    52\t\r\n    53\tfunc main() {\r\n    54"]
[18189.486067, "o", "\t\tcfg, err := parseArgs(os.Args[1:])\r\n    55\t\tif err != nil {\r\n    56\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    57\t\t\tos.Exit(2)\r\n    58\t\t}\r\n    59\t\tif err := run(cfg); err != nil {\r\n    60\t\t\tfmt.Fprintln(os.Stderr, err)\r\n"]
[18189.486123, "o", "    61\t\t\tos.Exit(1)\r\n    62\t\t}\r\n    63\t}\r\n    64\t\r\n    65\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n    66\t\tdefer func() {\r\n    67\t\t\tif r := recover(); r != nil {\r\n    68\t\t\t\tcfg = cliConfig{}\r\n"]
[18189.486178, "o", "    69\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n    70\t\t\t}\r\n    71\t\t}()\r\n    72\t\tcfg = cliConfig{\r\n    73\t\t\tsessionGap:        600,\r\n    74\t\t\twatermarkLag:      300,\r\n    75\t\t\tpendingTTL:        86400,\r\n    76\t\t\tmaxOpenSessions:   100000,\r\n    77\t\t\tratesMaxStaleness: 0,\r\n    78\t\t}"]
[18189.486284, "o", "\r\n    79\t\trequired := map[string]bool{\r\n    80\t\t\t\"--input-dir\": false,\r\n    81\t\t\t\"--rates\":     false,\r\n    82\t\t\t\"--output\":    false,\r\n    83\t\t\t\"--rejects\":   false,\r\n    84\t\t}\r\n    85\t\tif len(args) > 0 && args[0] == \"ingest\" {\r\n    86\t\t\targs = args[1:]\r\n    87\t\t}\r\n    88\t\tfor i := 0; i < len(args); i++ {\r\n    89\t\t\targ := args[i]\r\n    90\t\t\tif strings.HasPrefix(arg, \"--summary-schema-out=\") {\r\n"]
[18189.486347, "o", "    91\t\t\t\tcfg.summarySchemaOut = strings.TrimPrefix(arg, \"--summary-schema-out=\")\r\n    92\t\t\t\tif cfg.summarySchemaOut == \"\" {\r\n    93\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-out: value must be non-empty\")\r\n    94\t\t\t\t}\r\n    95\t\t\t\tcontinue\r\n    96\t\t\t}\r\n    97\t\t\tif strings.HasPrefix(arg, \"--summary-schema-digest=\") {\r\n    98\t\t\t\tcfg.summarySchemaDigest = strings.TrimPrefix(arg, \"--summary-schema-digest=\")\r\n"]
[18189.486418, "o", "    99\t\t\t\tif cfg.summarySchemaDigest == \"\" {\r\n   100\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest: value must be non-empty\")\r\n   101\t\t\t\t}\r\n   102\t\t\t\tcontinue\r\n   103\t\t\t}\r\n   104\t\t\tif strings.HasPrefix(arg, \"--summary-schema-index=\") {\r\n   105\t\t\t\tcfg.summarySchemaIndex = strings.TrimPrefix(arg, \"--summary-schema-index=\")\r\n   106\t\t\t\tif cfg.summarySchemaIndex == \"\" {\r\n   107\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index: value must be non-empty\")\r\n   108\t\t\t\t}\r\n   109\t\t\t\tcontinue\r\n"]
[18189.486475, "o", "   110\t\t\t}\r\n   111\t\t\tswitch arg {\r\n   112\t\t\tcase \"--input-dir\":\r\n   113\t\t\t\tcfg.inputDir = nextArg(args, &i)\r\n   114\t\t\tcase \"--rates\":\r\n   115\t\t\t\tcfg.ratesPath = nextArg(args, &i)\r\n   116\t\t\tcase \"--output\":\r\n   117\t\t\t\tcfg.outputPath = nextArg(args, &i)\r\n"]
[18189.486534, "o", "   118\t\t\tcase \"--rejects\":\r\n   119\t\t\t\tcfg.rejectsPath = nextArg(args, &i)\r\n   120\t\t\tcase \"--session-gap\":\r\n   121\t\t\t\tcfg.sessionGap = atoiOrError(nextArg(args, &i), \"--session-gap\")\r\n   122\t\t\tcase \"--watermark-lag\":\r\n   123\t\t\t\tcfg.watermarkLag = atoiOrError(nextArg(args, &i), \"--watermark-lag\")\r\n"]
[18189.486598, "o", "   124\t\t\tcase \"--state-in\":\r\n   125\t\t\t\tcfg.stateIn = nextArg(args, &i)\r\n   126\t\t\tcase \"--state-out\":\r\n   127\t\t\t\tcfg.stateOut = nextArg(args, &i)\r\n   128\t\t\tcase \"--pending-ttl\":\r\n   129\t\t\t\tcfg.pendingTTL = atoiOrError(nextArg(args, &i), \"--pending-ttl\")\r\n   130\t\t\tcase \"--max-open-sessions\":\r\n   131\t\t\t\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-sessions\")\r\n"]
[18189.486662, "o", "   132\t\t\tcase \"--audit-log\":\r\n   133\t\t\t\tcfg.auditLog = nextArg(args, &i)\r\n   134\t\t\tcase \"--audit-log-digest\":\r\n   135\t\t\t\tcfg.auditLogDigest = nextArg(args, &i)\r\n   136\t\t\tcase \"--audit-log-rotate-bytes\":\r\n   137\t\t\t\tcfg.auditLogRotateBytes = atoiOrError(nextArg(args, &i), \"--audit-log-rotate-bytes\")\r\n   138\t\t\tcase \"--rates-strict\":\r\n   139\t\t\t\tcfg.ratesStrict = true\r\n"]
[18189.486725, "o", "   140\t\t\tcase \"--rates-max-staleness\":\r\n   141\t\t\t\tcfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), \"--rates-max-staleness\")\r\n   142\t\t\tcase \"--ingest-id\":\r\n   143\t\t\t\tcfg.ingestID = nextArg(args, &i)\r\n   144\t\t\t\tcfg.ingestIDSet = true\r\n"]
[18189.486789, "o", "   145\t\t\tcase \"--out-parquet-manifest\":\r\n   146\t\t\t\tcfg.outManifest = nextArg(args, &i)\r\n   147\t\t\tcase \"--manifest-signature\":\r\n   148\t\t\t\tcfg.manifestSignature = nextArg(args, &i)\r\n   149\t\t\tcase \"--dedup-policy\":\r\n   150\t\t\t\tval := nextArg(args, &i)\r\n   151\t\t\t\tif val != \"first-arrival\" && val != \"lex-largest-ts\" {\r\n   152\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --dedup-policy: must be one of {first-arrival, lex-largest-ts}\")\r\n   153\t\t\t\t}\r\n   154\t\t\t\tcfg.dedupPolicy = val\r\n   155\t\t\t\tcfg.dedupPolicySet = true\r\n   156\t\t\tcase \"--strict-late-audit\":\r\n   157\t\t\t\tcfg.strictLateAudit = true\r\n   158\t\t\tcase \"--state-strict\":\r\n   159"]
[18189.486854, "o", "\t\t\t\tcfg.stateStrict = true\r\n   160\t\t\tcase \"--summary-schema-out\":\r\n   161\t\t\t\tcfg.summarySchemaOut = nextArg(args, &i)\r\n   162\t\t\t\tif cfg.summarySchemaOut == \"\" {\r\n   163\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-out: value must be non-empty\")\r\n   164\t\t\t\t}\r\n   165\t\t\tcase \"--summary-schema-digest\":\r\n"]
[18189.486915, "o", "   166\t\t\t\tcfg.summarySchemaDigest = nextArg(args, &i)\r\n   167\t\t\t\tif cfg.summarySchemaDigest == \"\" {\r\n   168\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest: value must be non-empty\")\r\n   169\t\t\t\t}\r\n   170\t\t\tcase \"--summary-schema-strict\":\r\n   171\t\t\t\tcfg.summarySchemaStrict = true\r\n   172\t\t\tcase \"--summary-schema-index\":\r\n   173\t\t\t\tcfg.summarySchemaIndex = nextArg(args, &i)\r\n"]
[18189.486977, "o", "   174\t\t\t\tif cfg.summarySchemaIndex == \"\" {\r\n   175\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index: value must be non-empty\")\r\n   176\t\t\t\t}\r\n   177\t\t\tcase \"--rejects-format\":\r\n   178\t\t\t\tval := nextArg(args, &i)\r\n   179\t\t\t\tif val != \"legacy\" && val != \"tagged\" && val != \"tagged-sorted\" {\r\n   180\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --rejects-format: must be one of {legacy, tagged, tagged-sorted}\")\r\n   181\t\t\t\t}\r\n"]
[18189.487039, "o", "   182\t\t\t\tcfg.rejectsFormat = val\r\n   183\t\t\tcase \"--session-policy\":\r\n   184\t\t\t\tval := nextArg(args, &i)\r\n   185\t\t\t\tif val != \"gap\" && val != \"fixed-window\" && val != \"hybrid\" {\r\n   186\t\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --session-policy: must be one of {gap, fixed-window, hybrid}\")\r\n   187\t\t\t\t}\r\n   188\t\t\t\tcfg.sessionPolicy = val\r\n"]
[18189.487095, "o", "   189\t\t\tcase \"--fixed-window-seconds\":\r\n   190\t\t\t\tcfg.fixedWindowSeconds = atoiOrError(nextArg(args, &i), \"--fixed-window-seconds\")\r\n   191\t\t\t\tcfg.fixedWindowSet = true\r\n   192\t\t\tcase \"--rejects-format-header\":\r\n   193\t\t\t\tcfg.rejectsFormatHeader = true\r\n   194\t\t\tdefault:\r\n   195\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: unknown flag %s\", arg)\r\n"]
[18189.487178, "o", "   196\t\t\t}\r\n   197\t\t\tif strings.HasPrefix(arg, \"--\") && arg != \"--rates-strict\" && arg != \"--strict-late-audit\" && arg != \"--state-strict\" {\r\n   198\t\t\t\tif _, ok := required[arg]; ok {\r\n   199\t\t\t\t\trequired[arg] = true\r\n   200\t\t\t\t}\r\n   201\t\t\t}\r\n   202\t\t}\r\n   203\t\tfor k, ok := range required {\r\n   204\t\t\tif !ok {\r\n   205\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: %s is required\", k)\r\n   206\t\t\t}\r\n   207\t\t}\r\n   208\t"]
[18189.487299, "o", "\tif cfg.ingestIDSet {\r\n   209\t\t\tif len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {\r\n   210\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)\")\r\n   211\t\t\t}\r\n   212\t\t}\r\n   213\t\tif cfg.outManifest == \"\" && cfg.manifestSignature != \"\" {\r\n   214\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --manifest-signature requires --out-parquet-manifest\")\r\n   215\t\t}\r\n   216\t\tif cfg.outManifest != \"\" && !parentDirExists(cfg.outManifest) {\r\n   217\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest --out-parquet-manifest parent directory does not exist\")\r\n   218\t\t}\r\n   219\t\tif cfg.manifestSignature != \"\" && !parentDirExists(cfg.manifestSignature) {\r\n   220\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest --manifest-signature parent directory does not exist\")\r\n   221\t\t}\r\n"]
[18189.487388, "o", "   222\t\tif cfg.strictLateAudit && cfg.auditLog == \"\" {\r\n   223\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --strict-late-audit requires --audit-log\")\r\n   224\t\t}\r\n   225\t\tif cfg.auditLogRotateBytes != 0 {\r\n   226\t\t\tif cfg.auditLog == \"\" {\r\n   227\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --audit-log-rotate-bytes requires --audit-log\")\r\n   228\t\t\t}\r\n   229\t\t\tif cfg.auditLogRotateBytes < 4096 {\r\n   230\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --audit-log-rotate-bytes: must be a positive integer >= 4096\")\r\n   231\t\t\t}\r\n   232\t\t}\r\n   233\t\t"]
[18189.487486, "o", "if cfg.summarySchemaDigest != \"\" && cfg.summarySchemaOut == \"\" {\r\n   234\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-digest requires --summary-schema-out\")\r\n   235\t\t}\r\n   236\t\tif cfg.summarySchemaStrict && cfg.summarySchemaOut == \"\" {\r\n   237\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-strict requires --summary-schema-out\")\r\n   238\t\t}\r\n   239\t\tif cfg.summarySchemaIndex != \"\" && (cfg.summarySchemaOut == \"\" || cfg.summarySchemaDigest == \"\") {\r\n   240\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --summary-schema-index requires --summary-schema-out and --summary-schema-digest\")\r\n"]
