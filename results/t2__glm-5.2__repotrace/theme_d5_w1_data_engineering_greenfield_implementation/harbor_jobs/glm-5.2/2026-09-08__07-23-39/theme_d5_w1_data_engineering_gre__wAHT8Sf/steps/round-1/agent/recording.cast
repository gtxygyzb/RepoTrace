[14552.562762, "o", "\r\n   717\t\twinnerLine  int\r\n   718\t}\r\n   719\t\r\n   720\tfunc arrivalLess(a, b *Event) bool {\r\n   721\t\tif a.Shard != b.Shard {\r\n   722\t\t\treturn a.Shard < b.Shard\r\n   723\t\t}\r\n   724\t\treturn a.Line < b.Line\r\n   725"]
[14552.562832, "o", "\t}\r\n   726\t\r\n   727\tfunc buildRejects(records []rejectRecord, policy string) []byte {\r\n   728\t\torder := []string{\"invalid\", \"late\", \"duplicate\", \"unresolved_chargeback\"}\r\n   729\t\tvar buf bytes.Buffer\r\n   730\t\tfor _, bucket := range order {\r\n   731\t\t\tfor _, r := range records {\r\n   732\t\t\t\tif r.bucket != bucket {\r\n   733\t\t\t\t\tcontinue\r\n   734\t\t\t\t}\r\n"]
[14552.562891, "o", "   735\t\t\t\tbuf.Write(r.raw)\r\n   736\t\t\t\tif policy == \"first-arrival\" {\r\n   737\t\t\t\t\tbuf.WriteByte('\\t')\r\n   738\t\t\t\t\tif r.winner {\r\n   739\t\t\t\t\t\tbuf.WriteString(r.winnerShard)\r\n   740\t\t\t\t\t\tbuf.WriteByte('\\t')\r\n   741\t\t\t\t\t\tbuf.WriteString(strconv.Itoa(r.winnerLine))\r\n"]
[14552.562947, "o", "   742\t\t\t\t\t} else {\r\n   743\t\t\t\t\t\tbuf.WriteString(\"-\")\r\n   744\t\t\t\t\t\tbuf.WriteByte('\\t')\r\n   745\t\t\t\t\t\tbuf.WriteString(\"-\")\r\n   746\t\t\t\t\t}\r\n"]
[14552.563007, "o", "   747\t\t\t\t}\r\n   748\t\t\t\tbuf.WriteByte('\\n')\r\n   749\t\t\t}\r\n   750\t\t}\r\n   751\t\treturn buf.Bytes()\r\n   752\t}\r\n   753\t\r\n   754\tfunc buildManifest(cfg cliConfig, runIndex int, ratesDigest string, shards []inputShardInfo, shardAccepted map[string]int, bucketCounts map[string]int, hasMin bool, minTs time.Time, hasMax bool, maxTs time.Time) (manifestOutput, error) {\r\n   755\t\tsortedShards := append([]inputShardInfo(nil), shards...)\r\n   756\t"]
[14552.563065, "o", "\tsort.SliceStable(sortedShards, func(i, j int) bool {\r\n   757\t\t\treturn sortedShards[i].Name < sortedShards[j].Name\r\n   758\t\t})\r\n   759\t\tmanifestShards := make([]manifestShard, 0, len(sortedShards))\r\n   760\t\tfor _, s := range sortedShards {\r\n   761\t\t\tmanifestShards = append(manifestShards, manifestShard{\r\n   762\t\t\t\tShard:          s.Name,\r\n   763\t\t\t\tSHA256:         s.SHA256,\r\n   764\t\t\t\tBytes:          s.Bytes,\r\n"]
[14552.563124, "o", "   765\t\t\t\tEventsTotal:    s.EventsTotal,\r\n   766\t\t\t\tEventsAccepted: shardAccepted[s.Name],\r\n   767\t\t\t})\r\n   768\t\t}\r\n   769\t\toutputs := manifestOutputs{}\r\n   770\t\tsummaryOut, err := manifestFileOutputFor(cfg.outputPath)\r\n   771\t\tif err != nil {\r\n   772\t\t\treturn manifestOutput{}, err\r\n   773\t\t}\r\n   774"]
[14552.563182, "o", "\t\trejectsOut, err := manifestFileOutputFor(cfg.rejectsPath)\r\n   775\t\tif err != nil {\r\n   776\t\t\treturn manifestOutput{}, err\r\n   777\t\t}\r\n   778\t\toutputs.Summary = summaryOut\r\n   779\t\toutputs.Rejects = rejectsOut\r\n   780\t\tif cfg.stateOut != \"\" {\r\n   781\t\t\tstateOut, err := manifestFileOutputFor(cfg.stateOut)\r\n   782"]
[14552.563247, "o", "\t\t\tif err != nil {\r\n   783\t\t\t\treturn manifestOutput{}, err\r\n   784\t\t\t}\r\n   785\t\t\toutputs.State = stateOut\r\n   786\t\t}\r\n   787\t\tif cfg.auditLog != \"\" {\r\n"]
[14552.563306, "o", "   788\t\t\tlogOut, err := manifestFileOutputFor(cfg.auditLog)\r\n   789\t\t\tif err != nil {\r\n   790\t\t\t\treturn manifestOutput{}, err\r\n   791\t\t\t}\r\n   792\t\t\toutputs.AuditLog = logOut\r\n   793\t\t}\r\n   794\t\tif cfg.auditLogDigest != \"\" {\r\n   795\t\t\tdigestOut, err := manifestFileOutputFor(cfg.auditLogDigest)\r\n   796\t\t\tif err != nil {\r\n   797\t\t\t\treturn manifestOutput{}, err\r\n"]
[14552.563381, "o", "   798\t\t\t}\r\n   799\t\t\toutputs.AuditDigest = digestOut\r\n   800\t\t}\r\n   801\t\twindow := manifestWindow{\r\n   802\t\t\tEventsAcceptedTotal: bucketCounts[\"accepted\"],\r\n   803\t\t\tEventsRejectedTotal: bucketCounts[\"duplicate\"] + bucketCounts[\"invalid\"] + bucketCounts[\"late\"] + bucketCounts[\"unresolved_chargeback\"],\r\n   804\t\t\tBucketCounts:        bucketCounts,\r\n   805\t\t}\r\n"]
[14552.563441, "o", "   806\t\tif hasMin {\r\n   807\t\t\tm := formatTS(minTs)\r\n   808\t\t\twindow.MinTs = &m\r\n   809\t\t}\r\n   810\t\tif hasMax {\r\n   811\t\t\tm := formatTS(maxTs)\r\n   812\t\t\twindow.MaxTs = &m\r\n"]
[14552.563497, "o", "   813\t\t}\r\n   814\t\tvar ingestID *string\r\n   815\t\tif cfg.ingestIDSet {\r\n   816\t\t\tid := cfg.ingestID\r\n   817\t\t\tingestID = &id\r\n   818\t\t}\r\n"]
[14552.563552, "o", "   819\t\treturn manifestOutput{\r\n   820\t\t\tSchemaVersion: manifestSchemaVersion,\r\n"]
