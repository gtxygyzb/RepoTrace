[18223.208894, "o", "\t\treturn true\r\n   117\t}\r\n   118\t\r\n   119\tfunc dayEpoch(date string) time.Time {\r\n   120\t\tt, err := time.Parse(\"2006-01-02\", date)\r\n   121\t\tif err != nil {\r\n   122\t\t\treturn time.Time{}\r\n   123\t\t}\r\n   124\t\treturn t.UTC()\r\n   125\t}\r\n   126\t\r\n   127\tfunc calendarDayDiff(rateDate, eventDate string) int {\r\n   128\t\tr := dayEpoch(rateDate)\r\n   129\t\te := dayEpoch(eventDate)\r\n   130\t\tif r.IsZero() || e.IsZero() {\r\n   131\t\t\treturn 0\r\n   132\t\t}\r\n   133\t\treturn int(r.Sub(e) / (24 * time.Hour))\r\n   134\t}\r\n   135\t\r\n   136\tfunc absInt(v int) int {\r\n   137\t\tif v < 0 {\r\n   138\t\t\treturn -v\r\n   139\t\t}\r\n   140\t\treturn v\r\n   141\t}\r\n   142\t\r\n   143\tfunc absInt64(v int64) int64 {\r\n   144\t\tif v < 0 {\r\n   145\t\t\treturn -v\r\n   146\t\t}\r\n   147\t\treturn v\r\n   148\t}\r\n   149\t\r\n"]
[18223.208979, "o", "   150\tfunc (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {\r\n   151\t\tif !rt.known[currency] {\r\n   152\t\t\treturn 0, 0, \"fx_unknown_currency\"\r\n   153\t\t}\r\n   154\t\tif m, ok := rt.days[date]; ok {\r\n   155\t\t\tif r, ok := m[currency]; ok {\r\n   156\t\t\t\tif isUsableRate(r) {\r\n   157\t\t\t\t\treturn r, 0, \"\"\r\n   158\t\t\t\t}\r\n   159\t\t\t\treturn 0, 0, \"bad_rate\"\r\n   160\t\t\t}\r\n   161\t\t"]
[18223.209047, "o", "}\r\n   162\t\tif maxStaleness > 0 {\r\n   163\t\t\teventDay := dayEpoch(date)\r\n   164\t\t\tif !eventDay.IsZero() {\r\n   165\t\t\t\tvar bestDate string\r\n   166\t\t\t\tvar bestDist int64 = -1\r\n   167\t\t\t\tfor _, d := range sortedKeys(rt.days) {\r\n   168\t\t\t\t\tif _, ok := rt.days[d][currency]; !ok {\r\n"]
[18223.209106, "o", "   169\t\t\t\t\t\tcontinue\r\n   170\t\t\t\t\t}\r\n   171\t\t\t\t\tdayTime := dayEpoch(d)\r\n   172\t\t\t\t\tif dayTime.IsZero() {\r\n   173\t\t\t\t\t\tcontinue\r\n   174\t\t\t\t\t}\r\n   175\t\t\t\t\tdist := absInt64(dayTime.Unix() - eventDay.Unix())\r\n   176\t\t\t\t\tif dist > int64(maxStaleness) {\r\n"]
[18223.209136, "o", "   177\t\t\t\t\t\tcontinue\r\n   178\t\t\t\t\t}\r\n   179\t\t\t\t\tif bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {\r\n   180\t\t\t\t\t\tbestDist = dist\r\n   181\t\t\t\t\t\t"]
[18223.209245, "o", "bestDate = d\r\n   182\t\t\t\t\t}\r\n   183\t\t\t\t}\r\n   184\t\t\t\tif bestDate != \"\" {\r\n   185\t\t\t\t\tr := rt.days[bestDate][currency]\r\n   186\t\t\t\t\tif isUsableRate(r) {\r\n   187\t\t\t\t\t\treturn r, calendarDayDiff(bestDate, date), \"\"\r\n   188\t\t\t\t\t}\r\n   189\t\t\t\t\treturn 0, 0, \"bad_rate\"\r\n   190\t\t\t\t}\r\n   191\t\t\t}\r\n"]
