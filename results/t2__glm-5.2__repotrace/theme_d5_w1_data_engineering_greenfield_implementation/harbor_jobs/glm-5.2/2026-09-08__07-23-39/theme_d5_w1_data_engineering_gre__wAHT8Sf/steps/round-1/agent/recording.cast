[18131.747145, "o", "\t\tctx := newContext(raw)\r\n   417\t\t\tbucket := \"invalid\"\r\n   418\t\t\treason := \"\"\r\n   419\t\t\tvar ev *Event\r\n   420\t\t\tvar lateCutoff *cutoffObject\r\n   421\t\t\tvar lateLag, lateBySec *int\r\n   422\t\t\tif raw.Invalid {\r\n   423\t\t\t\tbucket = \"invalid\"\r\n   424\t\t\t\treason = \"invalid_json\"\r\n   425\t\t\t} else {\r\n   426\t\t\t\tev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)\r\n   427\t\t\t\tif ev != nil {\r\n   428\t\t\t\t\tif seen[ev.ID] {\r\n   429\t\t\t\t\t\tbucket = \"duplicate\"\r\n   430\t\t\t\t\t\treason = \"cross_run\"\r\n   431\t\t\t\t\t\tev = nil\r\n   432\t\t\t\t\t} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {\r\n   433\t\t\t\t\t\tbucket = \"late\"\r\n   434\t\t\t\t"]
[18131.747229, "o", "\t\treason = \"late\"\r\n   435\t\t\t\t\t\tcutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)\r\n   436\t\t\t\t\t\tlateCutoff = ptrCutoff(formatCutoffObject(cutoff))\r\n   437\t\t\t\t\t\tif cfg.strictLateAudit {\r\n   438\t\t\t\t\t\t\tlag := cfg.watermarkLag\r\n   439\t\t\t\t\t\t\tlateBy := int(lateCutoff.EpochSeconds - int(epochSeconds(ev.TS)))\r\n   440\t\t\t\t\t\t\tlateLag = &lag\r\n   441\t\t\t\t\t\t\tlateBySec = &lateBy\r\n   442\t\t\t\t\t\t}\r\n   443\t\t\t\t\t\tev = nil\r\n   444\t\t\t\t\t} else {\r\n   445\t\t\t\t\t\tbucket = \"accepted\"\r\n"]
[18131.747293, "o", "   446\t\t\t\t\t\tif ev.TS.After(watermark) {\r\n   447\t\t\t\t\t\t\twatermark = ev.TS\r\n   448\t\t\t\t\t\t\thasWatermark = true\r\n   449\t\t\t\t\t\t}\r\n   450\t\t\t\t\t}\r\n   451\t\t\t\t} else {\r\n   452\t\t\t\t\tbucket = \"invalid\"\r\n   453\t\t\t\t}\r\n   454\t\t\t}\r\n   455\t\t\tif bucket == \"invalid\" {\r\n   456\t\t\t\tinvalidReasons[reason]++\r\n   457\t\t\t}\r\n"]
