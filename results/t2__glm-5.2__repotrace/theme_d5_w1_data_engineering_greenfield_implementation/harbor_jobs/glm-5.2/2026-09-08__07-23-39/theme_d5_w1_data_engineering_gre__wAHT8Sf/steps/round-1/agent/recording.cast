[19957.293571, "o", "     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"regexp\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t\t\"time\"\r\n    14\t)\r\n    15\t\r\n    16\tvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n    17\t\r\n    18\ttype cliConfig struct {\r\n    19\t\tinputDir                string\r\n    20\t\tratesPath               string\r\n    21\t\toutputPath              string\r\n    22\t\trejectsPath             string\r\n    23\t\tsessionGap              int\r\n    24\t\twatermarkLag            int\r\n    25\t\tstateIn                 string\r\n    26\t\tstateOut                string\r\n"]
[19957.293655, "o", "    27\t\tpendingTTL              int\r\n    28\t\tmaxOpenSessions         int\r\n    29\t\tauditLog                string\r\n    30\t\tauditLogDigest          string\r\n    31\t\tauditLogRotateBytes     int\r\n    32\t\tratesStrict             bool\r\n    33\t\tratesMaxStaleness       int\r\n    34\t\tingestID                string\r\n    35\t\tingestIDSet             bool\r\n    36\t\toutManifest             string\r\n    37\t\tmanifestSignature       string\r\n    38\t\tdedupPolicy             string\r\n"]
[19957.293729, "o", "    39\t\tdedupPolicySet          bool\r\n    40\t\tstrictLateAudit         bool\r\n    41\t\tstateStrict             bool\r\n    42\t\tsummarySchemaOut        string\r\n    43\t\tsummarySchemaDigest     string\r\n    44\t\tsummarySchemaStrict     bool\r\n    45\t\tsummarySchemaIndex      string\r\n    46\t\trejectsFormat           string\r\n    47\t\trejectsFormatHeader     bool\r\n    48\t\tsessionPolicy           string\r\n    49"]
[19957.293805, "o", "\t\tfixedWindowSeconds      int\r\n    50\t\tfixedWindowSet          bool\r\n    51\t\tshardingReport          string\r\n    52\t\tshardingReportDigest    string\r\n    53\t\tshardingReportIndex     string\r\n    54\t\tshardingReportHistogram string\r\n    55\t\tshardingReportSort      string\r\n    56\t\tshardingReportStrict    bool\r\n    57\t}\r\n    58\t\r\n    59\tfunc main() {\r\n    60\t\tcfg, err := parseArgs(os.Args[1:])\r\n    61\t\tif err != nil {\r\n"]
[19957.29388, "o", "    62\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    63\t\t\tos.Exit(2)\r\n    64\t\t}\r\n    65\t\tif err := run(cfg); err != nil {\r\n    66\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    67\t\t\tos.Exit(1)\r\n    68\t\t}\r\n    69\t}\r\n    70\t\r\n    71\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n"]
[19957.293948, "o", "    72\t\tdefer func() {\r\n    73\t\t\tif r := recover(); r != nil {\r\n    74\t\t\t\tcfg = cliConfig{}\r\n    75\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n    76\t\t\t}\r\n    77\t\t}()\r\n    78\t\tcfg = cliConfig{\r\n    79\t\t\tsessionGap:        600,\r\n    80\t\t\twatermarkLag:      300,\r\n    81\t\t\tpendingTTL:        86400,\r\n    82\t\t\tmaxOpenSessions:   100000,\r\n    83"]
[19957.294016, "o", "\t\t\tratesMaxStaleness: 0,\r\n    84\t\t}\r\n    85\t\trequired := map[string]bool{\r\n    86\t\t\t\"--input-dir\": false,\r\n    87\t\t\t\"--rates\":     false,\r\n    88\t\t\t\"--output\":    false,\r\n    89\t\t\t\"--rejects\":   false,\r\n    90\t\t}\r\n    91\t\tif len(args) > 0 && args[0] == \"ingest\" {\r\n"]
