[5354.494901, "o", "\u001b[?2004h> "]
[5354.495061, "o", "    pendingByID: map[string]*pendingEntry{},\r\n\u001b[?2004l\r"]
[5354.49514, "o", "\u001b[?2004h> "]
[5354.495338, "o", "    openSessions: map[string]carriedSession{},\r\n\u001b[?2004l\r"]
[5354.495421, "o", "\u001b[?2004h> "]
[5354.495515, "o", "    runIndex: 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.495624, "o", "    stats: &stateStats{},\r\n\u001b[?2004l\r"]
[5354.495657, "o", "\u001b[?2004h> "]
[5354.49577, "o", "    hasAudit: hasAudit,\r\n\u001b[?2004l\r"]
[5354.495865, "o", "\u001b[?2004h"]
[5354.495956, "o", "> "]
[5354.496055, "o", "    auditBuilder: &bytes.Buffer{},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.496301, "o", "    digestCounts: digest{InvalidReasons: map[string]int{}},\r\n\u001b[?2004l\r"]
[5354.496388, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5354.496484, "o", "> "]
[5354.496581, "o", "  if st != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.496742, "o", "    p.seenIds = copyStringBoolMap(st.seenIds)\r\n\u001b[?2004l\r"]
[5354.496818, "o", "\u001b[?2004h> "]
[5354.497047, "o", "    p.pending = append([]pendingEntry(nil), st.pending...)\r\n\u001b[?2004l\r"]
[5354.497128, "o", "\u001b[?2004h> "]
[5354.497241, "o", "    for i := range p.pending {\r\n\u001b[?2004l\r"]
[5354.497333, "o", "\u001b[?2004h"]
[5354.497427, "o", "> "]
[5354.497521, "o", "      p.pendingByID[p.pending[i].id] = &p.pending[i]\r\n\u001b[?2004l\r"]
[5354.497613, "o", "\u001b[?2004h"]
[5354.497705, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.49783, "o", "    for u, s := range st.openSessions {\r\n\u001b[?2004l\r"]
[5354.497917, "o", "\u001b[?2004h"]
[5354.49801, "o", ">       p.openSessions[u] = s\r\n\u001b[?2004l\r"]
[5354.498108, "o", "\u001b[?2004h> "]
[5354.498209, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.49831, "o", "    p.runIndex = st.runIndex\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.498432, "o", "    p.hasMax = st.hasMax\r\n\u001b[?2004l\r"]
[5354.498513, "o", "\u001b[?2004h> "]
[5354.498602, "o", "    p.maxTs = st.maxTs\r\n\u001b[?2004l\r"]
[5354.498696, "o", "\u001b[?2004h> "]
[5354.498833, "o", "    p.stats.CarryInPending = st.carryInPending\r\n\u001b[?2004l\r"]
[5354.498914, "o", "\u001b[?2004h> "]
[5354.49913, "o", "    p.stats.CarryInOpenSessions = st.carryInOpenSessions\r\n\u001b[?2004l\r"]
[5354.499218, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5354.499313, "o", "> "]
[5354.499407, "o", "  if maxOpenSessions <= 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.499533, "o", "    p.maxOpenSessions = 0\r\n\u001b[?2004l\r"]
[5354.499616, "o", "\u001b[?2004h> "]
[5354.499714, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h>   return p\r\n\u001b[?2004l\r\u001b[?2004h"]
[5354.499755, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5354.499866, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.500104, "o", "func copyStringBoolMap(m map[string]bool) map[string]bool {\r\n\u001b[?2004l\r"]
[5354.500186, "o", "\u001b[?2004h> "]
[5354.500332, "o", "  out := make(map[string]bool, len(m))\r\n\u001b[?2004l\r"]
[5354.500413, "o", "\u001b[?2004h> "]
[5354.500503, "o", "  for k, v := range m {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5354.500594, "o", "> "]
[5354.500687, "o", "    out[k] = v\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5354.500783, "o", "> "]
[5354.500877, "o", "  return out\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5354.500971, "o", "\u001b[?2004h> "]
[5354.501112, "o", "func (p *processor) currentCutoff() string {\r\n\u001b[?2004l\r"]
[5354.501198, "o", "\u001b[?2004h> "]
[5354.501293, "o", "  if p.hasMax {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.501515, "o", "    return formatTS(p.maxTs.Add(-p.watermarkLag))\r\n\u001b[?2004l\r"]
[5354.501594, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5354.50169, "o", "> "]
[5354.501788, "o", "  return \"\"\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5354.501883, "o", "\u001b[?2004h> "]
[5354.502028, "o", "func (p *processor) updateMax(t time.Time) {\r\n\u001b[?2004l\r"]
[5354.502102, "o", "\u001b[?2004h> "]
[5354.502249, "o", "  if !p.hasMax || t.After(p.maxTs) {\r\n\u001b[?2004l\r"]
[5354.502275, "o", "\u001b[?2004h> "]
[5354.502392, "o", "    p.maxTs = t\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.502495, "o", "    p.hasMax = true\r\n\u001b[?2004l\r"]
[5354.502577, "o", "\u001b[?2004h> "]
[5354.502661, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.502945, "o", "func (p *processor) processEvents(raws []rawEvent) ([]*Event, []Reject, []auditRecord) {\r\n\u001b[?2004l\r"]
[5354.503019, "o", "\u001b[?2004h> "]
[5354.5031, "o", "  var accepted []*Event\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.503184, "o", "  var rejects []Reject\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.503291, "o", "  var audits []auditRecord\r\n\u001b[?2004l\r"]
[5354.503368, "o", "\u001b[?2004h> "]
[5354.503457, "o", "  for _, raw := range raws {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.503535, "o", "    ctx := newContext(raw)\r\n\u001b[?2004l\r"]
[5354.503619, "o", "\u001b[?2004h> "]
[5354.503718, "o", "    ev, invalidReason := parseEvent(ctx, p.rt)\r\n\u001b[?2004l\r"]
[5354.503749, "o", "\u001b[?2004h> "]
[5354.503847, "o", "    if ev == nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.504101, "o", "      rec := auditRecord{Bucket: \"invalid\", Reason: invalidReason, Raw: ctx}\r\n\u001b[?2004l\r"]
[5354.504173, "o", "\u001b[?2004h> "]
[5354.504448, "o", "      rejects = append(rejects, Reject{Bucket: 1, Reason: invalidReason, Event: ctx.Raw})\r\n\u001b[?2004l\r\u001b[?2004h"]
[5354.504522, "o", "> "]
[5354.504604, "o", "      audits = append(audits, rec)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.504689, "o", "      continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.504775, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.504853, "o", "    if p.seenIds[ev.ID] {\r\n\u001b[?2004l\r"]
[5354.504936, "o", "\u001b[?2004h> "]
[5354.505132, "o", "      rec := auditRecord{Bucket: \"duplicate\", Reason: \"cross_run\", Raw: ctx}\r\n\u001b[?2004l\r"]
[5354.505219, "o", "\u001b[?2004h> "]
[5354.505456, "o", "      rejects = append(rejects, Reject{Bucket: 2, Reason: \"cross_run\", Event: ctx.Raw})\r\n\u001b[?2004l\r"]
[5354.505531, "o", "\u001b[?2004h> "]
[5354.505608, "o", "      audits = append(audits, rec)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5354.505694, "o", ">       continue\r\n\u001b[?2004l\r"]
[5354.505784, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.505864, "o", "    if p.sameRunSeen[ev.ID] {\r\n\u001b[?2004l\r"]
[5354.505948, "o", "\u001b[?2004h> "]
[5354.506142, "o", "      rec := auditRecord{Bucket: \"duplicate\", Reason: \"same_run\", Raw: ctx}\r\n\u001b[?2004l\r"]
[5354.506226, "o", "\u001b[?2004h> "]
[5354.506452, "o", "      rejects = append(rejects, Reject{Bucket: 2, Reason: \"same_run\", Event: ctx.Raw})\r\n\u001b[?2004l\r"]
[5354.506523, "o", "\u001b[?2004h> "]
[5354.506602, "o", "      audits = append(audits, rec)\r\n\u001b[?2004l\r"]
[5354.506686, "o", "\u001b[?2004h>       continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.506773, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.506864, "o", "    cutoff := p.currentCutoff()\r\n\u001b[?2004l\r"]
[5354.506896, "o", "\u001b[?2004h> "]
[5354.507107, "o", "    if p.hasMax && ev.TS.Before(p.maxTs.Add(-p.watermarkLag)) {\r\n\u001b[?2004l\r"]
[5354.507179, "o", "\u001b[?2004h> "]
[5354.507358, "o", "      rec := auditRecord{Bucket: \"late\", Cutoff: cutoff, Raw: ctx}\r\n\u001b[?2004l\r"]
[5354.507436, "o", "\u001b[?2004h> "]
[5354.507655, "o", "      rejects = append(rejects, Reject{Bucket: 3, Reason: \"late\", Event: ctx.Raw})\r\n\u001b[?2004l\r"]
[5354.507734, "o", "\u001b[?2004h> "]
[5354.50781, "o", "      audits = append(audits, rec)\r\n\u001b[?2004l\r"]
[5354.507895, "o", "\u001b[?2004h> "]
[5354.507983, "o", "      continue\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n"]
[5354.50807, "o", "\u001b[?2004l\r\u001b[?2004h>     p.sameRunSeen[ev.ID] = true\r\n\u001b[?2004l\r"]
[5354.508152, "o", "\u001b[?2004h> "]
[5354.508257, "o", "    p.updateMax(ev.TS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.508401, "o", "    acceptedEvent, audit := p.acceptEvent(ctx, ev)\r\n\u001b[?2004l\r"]
[5354.508472, "o", "\u001b[?2004h> "]
[5354.508589, "o", "    accepted = append(accepted, acceptedEvent)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5354.508659, "o", "> "]
[5354.508735, "o", "    audits = append(audits, audit)\r\n\u001b[?2004l\r"]
[5354.508821, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.508922, "o", "  return accepted, rejects, audits\r\n\u001b[?2004l\r"]
[5354.508992, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5354.509075, "o", "\u001b[?2004h> "]
[5354.509317, "o", "func (p *processor) acceptEvent(ctx *eventContext, ev *Event) (*Event, auditRecord) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[5354.509389, "o", "> "]
[5354.509471, "o", "  p.handleSession(ev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.509823, "o", "  rec := auditRecord{Bucket: \"accepted\", USD: ev.USD, SessionIndex: ev.sessionIndex, ResolvedAgainst: nil, Raw: ctx}\r\n\u001b[?2004l\r"]
[5354.509901, "o", "\u001b[?2004h>   switch ev.Type {\r\n\u001b[?2004l\r"]
[5354.509988, "o", "\u001b[?2004h> "]
[5354.510021, "o", "  case \"purchase\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.51037, "o", "    pe := pendingEntry{id: ev.ID, ts: ev.TS, user: ev.UserID, usd: ev.USD, originRun: p.runIndex + 1}\r\n\u001b[?2004l\r"]
[5354.510447, "o", "\u001b[?2004h> "]
[5354.510524, "o", "    p.pending = append(p.pending, pe)\r\n\u001b[?2004l\r"]
[5354.51061, "o", "\u001b[?2004h> "]
[5354.510736, "o", "    p.pendingByID[ev.ID] = &p.pending[len(p.pending)-1]\r\n\u001b[?2004l\r"]
[5354.510809, "o", "\u001b[?2004h>   case \"refund\":\r\n\u001b[?2004l\r"]
[5354.510897, "o", "\u001b[?2004h> "]
[5354.511178, "o", "    pe := pendingEntry{id: ev.ID, ts: ev.TS, user: ev.UserID, usd: ev.USD, originRun: p.runIndex + 1}\r\n\u001b[?2004l\r"]
[5354.511256, "o", "\u001b[?2004h> "]
[5354.511338, "o", "    p.pending = append(p.pending, pe)\r\n\u001b[?2004l\r"]
[5354.511419, "o", "\u001b[?2004h> "]
[5354.511559, "o", "    p.pendingByID[ev.ID] = &p.pending[len(p.pending)-1]\r\n\u001b[?2004l\r"]
[5354.511628, "o", "\u001b[?2004h> "]
[5354.511711, "o", "  case \"chargeback\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.511824, "o", "    resolved := p.resolveChargeback(ev)\r\n\u001b[?2004l\r"]
[5354.511899, "o", "\u001b[?2004h> "]
[5354.51198, "o", "    if resolved == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.512106, "o", "      rec.Bucket = \"unresolved_chargeback\"\r\n\u001b[?2004l\r"]
[5354.512176, "o", "\u001b[?2004h> "]
[5354.512269, "o", "      rec.RefID = ev.RefID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.5124, "o", "      p.stats.Anomalies? // placeholder\r\n\u001b[?2004l\r"]
[5354.512475, "o", "\u001b[?2004h>     } else {\r\n\u001b[?2004l\r"]
[5354.512567, "o", "\u001b[?2004h> "]
[5354.512653, "o", "      rec.ResolvedAgainst = &resolved\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5354.512742, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[5354.512829, "o", ">   return ev, rec\r\n\u001b[?2004l\r"]
[5354.512916, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[5354.515696, "o", "\u001b[?2004hroot@n30009:/app# "]
[5360.61814, "i", "nl -ba main.go | sed -n '1,40p; 600,760p'\n"]
[5360.618525, "o", "nl -ba main.go | sed -n '1,40p; 600,760p'\r\n\u001b[?2004l\r"]
[5360.622431, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t  \"bytes\"\r\n     5\t  \"crypto/sha256\"\r\n     6\t  \"encoding/hex\"\r\n     7\t  \"encoding/json\"\r\n"]
[5360.622591, "o", "     8\t  \"errors\"\r\n     9\t  \"fmt\"\r\n    10\t  \"math\"\r\n    11\t  \"os\"\r\n    12\t  \"path/filepath\"\r\n    13\t  \"sort\"\r\n    14\t  \"strconv\"\r\n    15\t  \"strings\"\r\n    16\t  \"time\"\r\n    17\t)\r\n    18\t\r\n    19\tvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--audit-log <path>] [--audit-log-digest <path>]\\n\"\r\n    20\t\r\n    21\ttype Money float64\r\n    22\t\r\n    23\tfunc (m Money) MarshalJSON() ([]byte, error) {\r\n    24\t  return []byte(m.String()), nil\r\n    25\t}\r\n    26\t\r\n    27"]
[5360.622684, "o", "\tfunc (m Money) String() string {\r\n    28\t  f := float64(m)\r\n    29\t  abs := math.Abs(f)\r\n    30\t  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n    31\t  neg := f < 0 && cents != 0\r\n    32\t  dollars := cents / 100\r\n    33\t  rem := cents % 100\r\n    34\t  s := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n    35\t  if neg {\r\n    36\t    s = \"-\" + s"]
[5360.622771, "o", "\r\n    37\t  }\r\n    38\t  return s\r\n    39\t}\r\n    40\t\r\n"]
[5360.622919, "o", "   600\t      return nil, err\r\n   601\t    }\r\n   602\t    lineNo := 0\r\n   603\t    for _, line := range bytes.Split(data, []byte{'\\n'}) {\r\n"]
[5360.623029, "o", "   604\t      lineNo++\r\n   605\t      trimmed := bytes.TrimSpace(line)\r\n   606\t      if len(trimmed) == 0 {\r\n   607\t        continue\r\n   608\t      }\r\n   609\t      var obj map[string]json.RawMessage\r\n   610\t      if err := json.Unmarshal(trimmed, &obj); err != nil {\r\n   611\t        continue\r\n   612\t      }\r\n   613\t      events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: json.RawMessage(trimmed), Obj: obj})\r\n   614\t    }\r\n   615\t  }\r\n   616\t  return events, nil\r\n"]
[5360.62315, "o", "   617\t}\r\n   618\t\r\n   619\tfunc newContext(raw rawEvent) *eventContext {\r\n   620\t  ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n   621\t  ctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n   622\t  ctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n   623\t  ctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n   624\t  return ctx\r\n   625\t}\r\n   626\t\r\n   627\tfunc parseEvent(ctx *eventContext, rt *RateTable) (*Event, string) {\r\n   628\t  obj := ctx.Obj\r\n   629\t  raw, ok := obj[\"v\"]\r\n   630\t  if !ok {\r\n   631\t    return nil, \"schema_version\"\r\n"]
[5360.623268, "o", "   632\t  }\r\n   633\t  var v int\r\n   634\t  if err := json.Unmarshal(raw, &v); err != nil {\r\n   635\t    return nil, \"schema_version\"\r\n   636\t  }\r\n   637\t  if v != 1 && v != 2 {\r\n   638\t    return nil, \"schema_version\"\r\n   639\t  }\r\n   640\t  id, idOk, _ := getRawString(obj, \"id\")\r\n   641\t  if !idOk || id == \"\" {\r\n"]
[5360.623378, "o", "   642\t    return nil, \"missing_id\"\r\n   643\t  }\r\n   644\t  tsStr, tsOk, _ := getRawString(obj, \"ts\")\r\n   645\t  if !tsOk {\r\n   646\t    return nil, \"missing_ts\"\r\n   647\t  }\r\n   648"]
[5360.623465, "o", "\t  t, err := parseTime(tsStr)\r\n   649\t  if err != nil {\r\n   650\t    return nil, \"bad_ts\"\r\n   651\t  }\r\n   652\t  typeStr, typeOk, _ := getRawString(obj, \"type\")\r\n   653\t  if !typeOk {\r\n   654\t    return nil, \"missing_type\"\r\n   655\t  }\r\n   656\t  switch typeStr {\r\n   657\t  case \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\n   658\t  default:\r\n   659\t    return nil, \"bad_type\"\r\n"]
[5360.623556, "o", "   660\t  }\r\n   661\t  user, userOk, _ := getRawString(obj, \"user_id\")\r\n   662\t  if !userOk || user == \"\" {\r\n   663\t    return nil, \"missing_user\"\r\n   664\t  }\r\n   665\t  ev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n   666\t  switch typeStr {\r\n   667\t  case \"purchase\", \"refund\":\r\n   668\t    var amount float64\r\n   669\t    if v == 1 {\r\n   670\t      raw, present := obj[\"amount\"]\r\n   671\t      if !present {\r\n"]
[5360.623645, "o", "   672\t        return nil, \"missing_amount\"\r\n   673\t      }\r\n   674\t      var f float64\r\n   675\t      if err := json.Unmarshal(raw, &f); err != nil {\r\n   676\t        return nil, \"bad_amount\"\r\n   677\t      }\r\n   678\t      if !isFinite(f) || f < 0 {\r\n   679\t        return nil, \"bad_amount\"\r\n   680\t      }\r\n"]
[5360.623741, "o", "   681\t      amount = f\r\n   682\t    } else {\r\n   683\t      raw, present := obj[\"amount_cents\"]\r\n   684\t      if !present {\r\n   685\t        return nil, \"missing_amount\"\r\n   686\t      }\r\n   687\t      n, err := getJSONInt(raw)\r\n   688\t      if err != nil || n < 0 {\r\n   689\t        return nil, \"bad_amount\"\r\n   690\t      }\r\n   691\t      amount = float64(n) / 100.0\r\n"]
[5360.623826, "o", "   692\t    }\r\n   693\t    cur, curOk, curPresent := getRawString(obj, \"currency\")\r\n   694\t    if !curPresent {\r\n   695\t      return nil, \"missing_currency\"\r\n   696\t    }\r\n   697\t    if !curOk || cur == \"\" {\r\n   698\t      return nil, \"bad_currency\"\r\n   699\t    }\r\n   700\t    r, ok := rt.rate(dateKey(t), cur)\r\n"]
[5360.623914, "o", "   701\t    if !ok {\r\n   702\t      return nil, \"fx_lookup\"\r\n   703\t    }\r\n   704\t    usd := amount * r\r\n   705\t    if typeStr == \"refund\" {\r\n   706\t      usd = -usd\r\n   707\t    }\r\n   708\t    ev.Amount = amount\r\n   709\t    ev.Currency = cur\r\n   710\t    ev.USD = roundMoney(usd)\r\n   711\t  case \"chargeback\":\r\n"]
[5360.624, "o", "   712\t    ref, refOk, refPresent := getRawString(obj, \"ref_id\")\r\n   713\t    if !refPresent || !refOk || ref == \"\" {\r\n   714\t      return nil, \"missing_ref_id\"\r\n   715\t    }\r\n   716\t    ev.RefID = ref\r\n   717\t    ev.USD = 0\r\n   718\t  case \"login\", \"signup\":\r\n   719\t    ev.USD = 0\r\n"]
[5360.624089, "o", "   720\t  }\r\n   721\t  return ev, \"\"\r\n   722\t}\r\n   723\t\r\n   724\ttype stateFileIn struct {\r\n   725\t  Version          int                    `json:\"version\"`\r\n   726\t  Watermark        stateWatermarkOut      `json:\"watermark\"`\r\n   727\t  SeenIDs          []string               `json:\"seen_ids\"`\r\n   728\t  PendingPurchases []statePendingOut     `json:\"pending_purchases\"`\r\n   729\t  OpenSessions     []stateOpenSessionOut  `json:\"open_sessions\"`"]
[5360.624182, "o", "\r\n   730\t  RunIndex         int                    `json:\"run_index\"`\r\n   731\t}\r\n   732\t\r\n   733\tfunc loadState(path string) (*loadedState, error) {\r\n   734\t  data, err := os.ReadFile(path)\r\n   735\t  if err != nil {\r\n   736\t    return nil, err\r\n   737\t  }\r\n   738\t  var sin stateFileIn\r\n"]
[5360.624289, "o", "   739\t  if err := json.Unmarshal(data, &sin); err != nil {\r\n   740\t    return nil, err\r\n   741\t  }\r\n   742\t  st := &loadedState{\r\n   743\t    version:      sin.Version,\r\n   744\t    seenIds:      map[string]bool{},\r\n   745\t    runIndex:     sin.RunIndex,\r\n   746\t    openSessions: map[string]carriedSession{},\r\n   747\t  }\r\n   748\t  if sin.Watermark.MaxTS != nil {\r\n   749\t"]
[5360.624369, "o", "    t, err := parseTime(*sin.Watermark.MaxTS)\r\n   750\t    if err != nil {\r\n   751\t      return nil, fmt.Errorf(\"bad state watermark: %w\", err)\r\n   752\t    }\r\n   753\t    st.hasMax = true\r\n   754\t    st.maxTs = t\r\n   755\t  }\r\n   756\t  for _, id := range sin.SeenIDs {\r\n   757\t    st.seenIds[id] = true"]
[5360.624447, "o", "\r\n   758\t  }\r\n   759\t  for _, p := range sin.PendingPurchases {\r\n   760\t    t, err := parseTime(p.TS)\r\n"]
