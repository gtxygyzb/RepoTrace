[17158.032887, "o", "\ncli.go:1012:\tcase \"unresolved_chargeback\":\r\ncli.go:1067:\t\tEventsRejectedTotal: bucketCounts[\"duplicate\"] + bucketCounts[\"invalid\"] + bucketCounts[\"late\"] + bucketCounts[\"unresolved_chargeback\"],\r\ncli.go:1104:\tcase \"unresolved_chargeback\":\r\nmain.go:15:var usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--state-strict] [--audit-log <path>] [--audit-log-digest <path>] [--audit-log-rotate-bytes <int>] [--rates-strict] [--rates-max-staleness <seconds>] [--ingest-id <string>] [--out-parquet-manifest <path>] [--manifest-signature <path>] [--dedup-policy <first-arrival|lex-largest-ts>] [--strict-late-audit] [--summary-schema-out <path>] [--summary-schema-digest <path>] [--summary-schema-strict] [--summary-schema-index <path>] [--rejects-format <legacy|tagged|tagged-sorted>] [--rejects-format-header] [--session-policy <g"]
[17158.032963, "o", "ap|fixed-window|hybrid>] [--fixed-window-seconds <int>]\\n\"\r\nmain.go:351:\tcase \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\nmain.go:361:\tcase \"purchase\", \"refund\":\r\nmain.go:414:\tcase \"chargeback\":\r\nmain.go:431:\tPendingPurchases []statePendingOut     `json:\"pending_purchases\"`\r\nmain.go:462:\tfor _, p := range sin.PendingPurchases {\r\nmain.go:465:\t\t\treturn nil, fmt.Errorf(\"bad pending purchase ts: %w\", err)\r\nmain.go:468:\t\t\treturn nil, fmt.Errorf(\"ingest: --state-strict: state pending entry missing first_seen_epoch\")\r\nmain.go:470:\t\tst.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, firstSeenEpoch: int(epochSeconds(t)), user: p.User, usd: float64(p.USD), originRun: p.OriginRun})\r\nmain.go:483:\tst.carryInPending = len(st.pending)\r\nmain.go:488:func buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {\r\nmain.go:489:\tout := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: st"]
