[14532.665793, "o", "}\r\n   250\t\r\n   251\tfunc ptrCutoff(c cutoffObject) *cutoffObject {\r\n   252\t\treturn &c\r\n   253\t}\r\n   254\t\r\n   255\tfunc run(cfg cliConfig) error {\r\n   256\t\tratesData, err := os.ReadFile(cfg.ratesPath)\r\n   257\t\tif err != nil {\r\n   258\t\t\treturn fmt.Errorf(\"ingest: rates: %w\", err)\r\n   259\t\t}\r\n   260\t\tratesDigest := sha256Hex(ratesData)\r\n   261\t\trt, err := loadRates(cfg.ratesPath)\r\n   262\t\tif err != nil {\r\n   263\t\t\treturn err\r\n   264\t\t}\r\n   265\t\tvar st *loadedState\r\n   266\t\trunIndex := 1\r\n   267\t\tif cfg.stateIn != \"\" {\r\n   268\t\t\tst, err = loadState(cfg.stateIn, cfg.stateStrict)\r\n   269\t\t\tif err != nil && !os.IsNotExist(err) {\r\n   270\t\t\t\treturn err\r\n   271\t\t\t}\r\n   272"]
