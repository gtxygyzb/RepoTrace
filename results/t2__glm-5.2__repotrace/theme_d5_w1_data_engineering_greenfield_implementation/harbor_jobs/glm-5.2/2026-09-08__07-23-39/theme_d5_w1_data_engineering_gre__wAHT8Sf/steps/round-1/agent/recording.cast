[5460.410229, "o", "\r\nfunc atomicWriteFile(path string, data []byte) error {\r\n  tmp := path + \".tmp\"\r\n  if err := os.WriteFile(tmp, data, 0644); err != nil {\r\n    os.Remove(tmp)\r\n    return err\r\n  }\r\n"]
[5460.410317, "o", "  if err := os.Rename(tmp, path); err != nil {\r\n    os.Remove(tmp)\r\n    return err\r\n  }\r\n  return nil\r\n}\r\n\r\nfunc newRateTable() *RateTable {\r\n  return &RateTable{byDate: map[string]map[string]float64{}, global: map[string]float64{\"USD\": 1.0}}\r\n}\r\n\r\nfunc (rt *RateTable) rate(date, currency string) (float64, bool) {\r\n  if currency == \"USD\" {\r\n    return 1.0, true\r\n  }\r\n  if m, ok := rt.byDate[date]; ok {\r\n"]
[5460.410395, "o", "    if r, ok := m[currency]; ok && r > 0 {\r\n      return r, true\r\n    }\r\n  }\r\n  if r, ok := rt.global[currency]; ok && r > 0 {\r\n    return r, true\r\n  }\r\n  return 0, false\r\n}\r\n\r\nfunc parseRateRaw(raw json.RawMessage) (float64, error) {\r\n  var f float64\r\n  if err := json.Unmarshal(raw, &f); err == nil {\r\n    if !isFinite(f) {\r\n      return 0, errors.New(\"bad rate\")\r\n    }\r\n    return f, nil\r\n"]
[5460.410457, "o", "  }\r\n  var s string\r\n  if err := json.Unmarshal(raw, &s); err == nil {\r\n    return strconv.ParseFloat(s, 64)\r\n  }\r\n  return 0, errors.New(\"bad rate\")\r\n}\r\n\r\nfunc loadRateMap(rt *RateTable, raw json.RawMessage, global bool) error {\r\n  var m map[string]json.RawMessage\r\n  if err := json.Unmarshal(raw, &m); err != nil {\r\n    return err\r\n  }\r\n  for currency, raw2 := range m {\r\n    if currency == \"USD\" {"]
[5460.410513, "o", "\r\n      continue\r\n    }\r\n    r, err := parseRateRaw(raw2)\r\n    if err != nil {\r\n      return err\r\n    }\r\n    if global {\r\n      rt.global[currency] = r\r\n    } else {\r\n"]
[5460.410566, "o", "      if rt.byDate[\"global\"] == nil {\r\n        rt.byDate[\"global\"] = map[string]float64{}\r\n      }\r\n      rt.byDate[\"global\"][currency] = r\r\n    }\r\n  }\r\n  return nil\r\n}\r\n\r\n"]
[5460.41062, "o", "func loadRates(path string) (*RateTable, error) {\r\n  data, err := os.ReadFile(path)\r\n  if err != nil {\r\n    return nil, err\r\n  }\r\n  var top map[string]json.RawMessage\r\n  if err := json.Unmarshal(data, &top); err != nil {\r\n    return nil, err\r\n  }\r\n  rt := newRateTable()\r\n  for _, key := range []string{\"by_date\", \"byDate\"} {\r\n    if raw, ok := top[key]; ok {\r\n      var dates map[string]json.RawMessage\r\n"]
[5460.410674, "o", "      if err := json.Unmarshal(raw, &dates); err != nil {\r\n        return nil, err\r\n      }\r\n      for date, raw2 := range dates {\r\n        var currencies map[string]json.RawMessage\r\n        if err := json.Unmarshal(raw2, &currencies); err != nil {\r\n          return nil, err\r\n        }\r\n        for currency, raw3 := range currencies {\r\n          if currency == \"USD\" {\r\n            continue\r\n"]
[5460.410728, "o", "          }\r\n          r, err := parseRateRaw(raw3)\r\n          if err != nil {\r\n            return nil, err\r\n          }\r\n          if rt.byDate[date] == nil {\r\n            rt.byDate[date] = map[string]float64{}\r\n          }\r\n          rt.byDate[date][currency] = r\r\n        }\r\n"]
[5460.410781, "o", "      }\r\n      delete(top, key)\r\n    }\r\n  }\r\n  for _, key := range []string{\"global\", \"Global\"} {\r\n    if raw, ok := top[key]; ok {\r\n      if err := loadRateMap(rt, raw, true); err != nil {\r\n        return nil, err\r\n      }\r\n      delete(top, key)\r\n    }\r\n  }\r\n"]
[5460.410834, "o", "  if raw, ok := top[\"rates\"]; ok {\r\n    if err := loadRateMap(rt, raw, true); err != nil {\r\n      return nil, err\r\n    }\r\n    delete(top, \"rates\")\r\n  }\r\n  for currency, raw := range top {\r\n    if currency == \"USD\" {\r\n      continue\r\n    }\r\n    var f float64\r\n"]
[5460.410886, "o", "    if err := json.Unmarshal(raw, &f); err == nil {\r\n      if !isFinite(f) {\r\n        return nil, fmt.Errorf(\"bad rate for %s\", currency)\r\n      }\r\n      rt.global[currency] = f\r\n      continue\r\n    }\r\n    var dates map[string]json.RawMessage\r\n    if err := json.Unmarshal(raw, &dates); err == nil {\r\n      for date, raw2 := range dates {\r\n        r, err := parseRateRaw(raw2)\r\n        if err != nil {\r\n          return nil, err\r\n        }\r\n"]
[5460.410938, "o", "        if rt.byDate[date] == nil {\r\n          rt.byDate[date] = map[string]float64{}\r\n        }\r\n        rt.byDate[date][currency] = r\r\n      }\r\n      continue\r\n    }\r\n    return nil, fmt.Errorf(\"bad rate for %s\", currency)\r\n  }\r\n  return rt, nil\r\n}\r\n\r\n"]
[5460.410988, "o", "func readInputEvents(inputDir string) ([]rawEvent, error) {\r\n  info, err := os.Stat(inputDir)\r\n  if err != nil {\r\n    return nil, err\r\n  }\r\n  if !info.IsDir() {\r\n    return nil, errors.New(\"input-dir is not a directory\")\r\n  }\r\n  entries, err := os.ReadDir(inputDir)\r\n  if err != nil {\r\n"]
[5460.411041, "o", "    return nil, err\r\n  }\r\n  var files []string\r\n  for _, e := range entries {\r\n    if e.IsDir() || !e.Type().IsRegular() {\r\n      continue\r\n    }\r\n    files = append(files, e.Name())\r\n  }\r\n  sort.Strings(files)\r\n  var events []rawEvent\r\n  for _, name := range files {\r\n    data, err := os.ReadFile(filepath.Join(inputDir, name))\r\n    if err != nil {\r\n"]
[5460.411098, "o", "      return nil, err\r\n    }\r\n    lineNo := 0\r\n    for _, line := range bytes.Split(data, []byte{'\\n'}) {\r\n      lineNo++\r\n      trimmed := bytes.TrimSpace(line)\r\n      if len(trimmed) == 0 {\r\n        continue\r\n      }\r\n      var obj map[string]json.RawMessage\r\n      if err := json.Unmarshal(trimmed, &obj); err != nil {\r\n        continue\r\n"]
[5460.411151, "o", "      }\r\n      events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: json.RawMessage(trimmed), Obj: obj})\r\n    }\r\n  }\r\n  return events, nil\r\n}\r\n\r\nfunc newContext(raw rawEvent) *eventContext {\r\n  ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n  ctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n"]
[5460.411241, "o", "  ctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n  ctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n  return ctx\r\n}\r\n\r\nfunc parseEvent(ctx *eventContext, rt *RateTable) (*Event, string) {\r\n  obj := ctx.Obj\r\n  raw, ok := obj[\"v\"]\r\n  if !ok {\r\n    return nil, \"schema_version\"\r\n  }\r\n  var v int\r\n  if err := json.Unmarshal(raw, &v); err != nil {\r\n    return nil, \"schema_version\"\r\n  }\r\n  if v != 1 && v != 2 {\r\n    return nil, \"schema_version\""]
[5460.4113, "o", "\r\n  }\r\n  id, idOk, _ := getRawString(obj, \"id\")\r\n  if !idOk || id == \"\" {\r\n    return nil, \"missing_id\"\r\n  }\r\n  tsStr, tsOk, _ := getRawString(obj, \"ts\")\r\n  if !tsOk {\r\n    return nil, \"missing_ts\"\r\n  }\r\n  t, err := parseTime(tsStr)\r\n"]
[5460.411364, "o", "  if err != nil {\r\n    return nil, \"bad_ts\"\r\n  }\r\n  typeStr, typeOk, _ := getRawString(obj, \"type\")\r\n  if !typeOk {\r\n    return nil, \"missing_type\"\r\n  }\r\n  switch typeStr {\r\n  case \"purchase\", \"refund\", \"chargeback\", \"login\", \"signup\":\r\n  default:\r\n    return nil, \"bad_type\"\r\n  }\r\n  user, userOk, _ := getRawString(obj, \"user_id\")\r\n  if !userOk || user == \"\" {\r\n    return nil, \"missing_user\"\r\n  }\r\n"]
[5460.411423, "o", "  ev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n  switch typeStr {\r\n  case \"purchase\", \"refund\":\r\n    var amount float64\r\n    if v == 1 {\r\n      raw, present := obj[\"amount\"]\r\n      if !present {\r\n        return nil, \"missing_amount\"\r\n      }\r\n      var f float64\r\n      if err := json.Unmarshal(raw, &f); err != nil {\r\n"]
[5460.411477, "o", "        return nil, \"bad_amount\"\r\n      }\r\n      if !isFinite(f) || f < 0 {\r\n        return nil, \"bad_amount\"\r\n      }\r\n      amount = f\r\n    } else {\r\n      raw, present := obj[\"amount_cents\"]\r\n      if !present {\r\n        return nil, \"missing_amount\"\r\n      }\r\n      n, err := getJSONInt(raw)\r\n      if err != nil || n < 0 {\r\n"]
[5460.411529, "o", "        return nil, \"bad_amount\"\r\n      }\r\n      amount = float64(n) / 100.0\r\n    }\r\n    cur, curOk, curPresent := getRawString(obj, \"currency\")\r\n    if !curPresent {\r\n      return nil, \"missing_currency\"\r\n    }\r\n    if !curOk || cur == \"\" {\r\n"]
[5460.411582, "o", "      return nil, \"bad_currency\"\r\n    }\r\n    r, ok := rt.rate(dateKey(t), cur)\r\n    if !ok {\r\n      return nil, \"fx_lookup\"\r\n    }\r\n    usd := amount * r\r\n    if typeStr == \"refund\" {\r\n      usd = -usd\r\n    }\r\n    ev.Amount = amount\r\n    ev.Currency = cur\r\n    ev.USD = roundMoney(usd)\r\n"]
[5460.411636, "o", "  case \"chargeback\":\r\n    ref, refOk, refPresent := getRawString(obj, \"ref_id\")\r\n    if !refPresent || !refOk || ref == \"\" {\r\n      return nil, \"missing_ref_id\"\r\n    }\r\n    ev.RefID = ref\r\n    ev.USD = 0\r\n  case \"login\", \"signup\":\r\n    ev.USD = 0\r\n  }\r\n  return ev, \"\"\r\n"]
[5460.411688, "o", "}\r\n\r\ntype stateFileIn struct {\r\n  Version          int                    `json:\"version\"`\r\n  Watermark        stateWatermarkOut      `json:\"watermark\"`\r\n  SeenIDs          []string               `json:\"seen_ids\"`\r\n  PendingPurchases []statePendingOut     `json:\"pending_purchases\"`\r\n  OpenSessions     []stateOpenSessionOut  `json:\"open_sessions\"`\r\n  RunIndex         int                    `json:\"run_index\"`\r\n}\r\n\r\n"]
[5460.411742, "o", "func loadState(path string) (*loadedState, error) {\r\n  data, err := os.ReadFile(path)\r\n  if err != nil {\r\n    return nil, err\r\n  }\r\n  var sin stateFileIn\r\n  if err := json.Unmarshal(data, &sin); err != nil {\r\n    return nil, err\r\n  }\r\n  st := &loadedState{\r\n    version:      sin.Version,\r\n    seenIds:      map[string]bool{},\r\n"]
[5460.411794, "o", "    runIndex:     sin.RunIndex,\r\n    openSessions: map[string]carriedSession{},\r\n  }\r\n  if sin.Watermark.MaxTS != nil {\r\n    t, err := parseTime(*sin.Watermark.MaxTS)\r\n    if err != nil {\r\n      return nil, fmt.Errorf(\"bad state watermark: %w\", err)\r\n    }\r\n    st.hasMax = true\r\n    st.maxTs = t\r\n"]
[5460.411846, "o", "  }\r\n  for _, id := range sin.SeenIDs {\r\n    st.seenIds[id] = true\r\n  }\r\n  for _, p := range sin.PendingPurchases {\r\n    t, err := parseTime(p.TS)\r\n    if err != nil {\r\n      return nil, fmt.Errorf(\"bad pending purchase ts: %w\", err)\r\n    }\r\n    st.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, user: p.User, usd: float64(p.USD), originRun: p.OriginRun})\r\n"]
[5460.411898, "o", "  }\r\n  for _, s := range sin.OpenSessions {\r\n    last, err := parseTime(s.LastTS)\r\n    if err != nil {\r\n      return nil, fmt.Errorf(\"bad open session last_ts: %w\", err)\r\n    }\r\n    start, err := parseTime(s.StartTS)\r\n    if err != nil {\r\n      return nil, fmt.Errorf(\"bad open session start_ts: %w\", err)\r\n    }\r\n    st.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}\r\n  }\r\n"]
[5460.411953, "o", "  st.carryInPending = len(st.pending)\r\n  st.carryInOpenSessions = len(st.openSessions)\r\n  return st, nil\r\n}\r\n\r\nfunc buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {\r\n  out := stateFileOut{Version: 1, SeenIDs: seenIDs, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}\r\n  if hasCurrentMax {\r\n    s := formatTS(currentMax)\r\n    out.Watermark.MaxTS = &s\r\n"]
[5460.412011, "o", "  } else if st != nil && st.hasMax {\r\n    s := formatTS(st.maxTs)\r\n    out.Watermark.MaxTS = &s\r\n  }\r\n  b, _ := json.MarshalIndent(out, \"\", \"  \")\r\n  b = append(b, '\\n')\r\n  return b\r\n}\r\n\r\nfunc statePendingOutList(pending []pendingEntry) []statePendingOut {\r\n  out := make([]statePendingOut, 0, len(pending))\r\n  for _, p := range pending {\r\n"]
[5460.412064, "o", "    out = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), User: p.user, USD: Money(p.usd), OriginRun: p.originRun})\r\n  }\r\n  return out\r\n}\r\n\r\nfunc stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {\r\n  out := make([]stateOpenSessionOut, 0, len(sessions))\r\n  for _, s := range sessions {\r\n"]
[5460.412116, "o", "    out = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})\r\n  }\r\n  return out\r\n}\r\n\r\nfunc sortedSeenIDs(seen map[string]bool) []string {\r\n  ids := make([]string, 0, len(seen))\r\n  for id := range seen {\r\n    ids = append(ids, id)\r\n  }\r\n  sort.Strings(ids)\r\n  return ids\r\n}"]
[5460.412169, "o", "\r\n\r\nfunc sortedPending(pending []pendingEntry) []pendingEntry {\r\n  out := append([]pendingEntry(nil), pending...)\r\n  sort.SliceStable(out, func(i, j int) bool {\r\n    if out[i].ts.Equal(out[j].ts) {\r\n      return out[i].id < out[j].id\r\n    }\r\n    return out[i].ts.Before(out[j].ts)\r\n  })\r\n  return out\r\n}\r\n"]
[5460.412228, "o", "\r\nfunc sortedOpenSessions(m map[string]carriedSession) []carriedSession {\r\n  out := make([]carriedSession, 0, len(m))\r\n  for _, s := range m {\r\n    out = append(out, s)\r\n  }\r\n  sort.SliceStable(out, func(i, j int) bool {\r\n    if out[i].lastTs.Equal(out[j].lastTs) {\r\n      return out[i].user < out[j].user\r\n    }\r\n"]
[5460.412279, "o", "    return out[i].lastTs.Before(out[j].lastTs)\r\n  })\r\n  return out\r\n}\r\n\r\nfunc sortedCarriedSessions(m map[string]carriedSession) []carriedSession {\r\n  return sortedOpenSessions(m)\r\n}\r\n\r\n"]
