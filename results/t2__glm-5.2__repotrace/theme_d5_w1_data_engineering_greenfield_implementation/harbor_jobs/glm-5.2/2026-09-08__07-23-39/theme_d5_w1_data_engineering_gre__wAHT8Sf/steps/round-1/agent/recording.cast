[7318.890555, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"crypto/sha256\"\r\n     6\t\t\"encoding/hex\"\r\n     7\t\t\"encoding/json\"\r\n     8\t\t\"errors\"\r\n"]
[7318.890679, "o", "     9\t\t\"fmt\"\r\n    10\t\t\"math\"\r\n    11\t\t\"os\"\r\n    12\t\t\"path/filepath\"\r\n    13\t\t\"sort\"\r\n    14\t\t\"strconv\"\r\n    15\t\t\"strings\"\r\n    16\t\t\"time\"\r\n    17\t)\r\n    18\t\r\n    19\tvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--audit-log <path>] [--audit-log-digest <path>] [--rates-strict] [--rates-max-staleness <seconds>]\\n\"\r\n    20\t\r\n    21\ttype Money float64\r\n    22\t\r\n    23\tfunc (m Money) MarshalJSON() ([]byte, error) {\r\n    24\t\treturn []byte(m.String()), nil\r\n    25\t}\r\n    26\t\r\n    27\t"]
[7318.890759, "o", "func (m Money) String() string {\r\n    28\t\tf := float64(m)\r\n    29\t\tabs := math.Abs(f)\r\n    30\t\tcents := int64(math.Floor(abs*100.0 + 0.5))\r\n    31\t\tneg := f < 0 && cents != 0\r\n    32\t\tdollars := cents / 100\r\n    33\t\trem := cents % 100\r\n    34\t\ts := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n    35\t\tif neg {\r\n    36\t\t\ts = \"-\" + s\r\n"]
[7318.890823, "o", "    37\t\t}\r\n    38\t\treturn s\r\n    39\t}\r\n    40\t\r\n    41\ttype Event struct {\r\n    42\t\tID                string\r\n    43\t\tType              string\r\n    44\t\tTS                time.Time\r\n    45\t\t"]
[7318.890882, "o", "UserID            string\r\n    46\t\tAmount            float64\r\n    47\t\tCurrency          string\r\n    48\t\tRefID             string\r\n    49\t\tUSD               float64\r\n    50\t\tRefUSD            float64\r\n    51\t\tFXFallbackDays    int\r\n    52\t\tResolvedAgainst   *string\r\n"]
[7318.89094, "o", "    53\t\tResolvedOriginRun int\r\n    54\t\tSessionIndex      int\r\n    55\t\tRaw               json.RawMessage\r\n    56\t\tShard             string\r\n    57\t\tLine              int\r\n    58\t}\r\n    59\t\r\n    60\ttype Reject struct {\r\n"]
