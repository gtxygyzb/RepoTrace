[18481.991183, "o", "   490\t\t\tif len(idxs) < 2 {\r\n   491\t\t\t\tif len(idxs) == 1 {\r\n   492\t\t\t\t\twinners[id] = idxs[0]\r\n   493\t\t\t\t\twinnerSet[idxs[0]] = true\r\n   494\t\t\t\t}\r\n   495\t\t\t\tcontinue\r\n   496\t\t\t}\r\n   497\t\t\twinner := idxs[0]\r\n"]
[18481.991208, "o", "   498\t\t\ttiebreak := false\r\n   499\t\t\tfor _, idx := range idxs[1:] {\r\n   500\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n   501\t\t\t\t\tif arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n   502\t\t\t\t\t\twinner = idx\r\n   503\t\t\t\t\t}\r\n"]
