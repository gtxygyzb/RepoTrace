[7251.992321, "o", "    83\t}\r\n    84\t\r\n    85\tfunc parseRateNumber(raw json.RawMessage) (float64, error) {\r\n    86\t\tif bytes.Equal(bytes.TrimSpace(raw), []byte(\"null\")) {\r\n    87\t\t\treturn 0, errors.New(\"non-numeric rate\")\r\n    88\t\t}\r\n    89\t\tvar f float64\r\n    90\t\tif err := json.Unmarshal(raw, &f); err != nil {\r\n    91\t\t\treturn 0, errors.New(\"non-numeric rate\")\r\n    92\t\t}\r\n    93\t\treturn f, nil\r\n    94\t}\r\n    95\t\r\n    96\tfunc sortedKeys[T any](m map[string]T) []string {\r\n    97\t\tkeys := make([]string, 0, len(m))\r\n    98\t\tfor k := range m {\r\n    99\t\t\tkeys = append(keys, k)\r\n   100\t\t}\r\n   101\t\tsort.Strings(keys)\r\n   102\t"]
