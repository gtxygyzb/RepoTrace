[18232.592862, "o", "\tauditLog            string\r\n\tauditLogDigest      string\r\n\tauditLogRotateBytes int\r\n\tratesStrict         bool\r\n\tratesMaxStaleness   int\r\n\tingestID            string\r\n\tingestIDSet         bool\r\n\toutManifest         string\r\n\tmanifestSignature   string\r\n\tdedupPolicy         string\r\n\tdedupPolicySet      bool\r\n\t"]
