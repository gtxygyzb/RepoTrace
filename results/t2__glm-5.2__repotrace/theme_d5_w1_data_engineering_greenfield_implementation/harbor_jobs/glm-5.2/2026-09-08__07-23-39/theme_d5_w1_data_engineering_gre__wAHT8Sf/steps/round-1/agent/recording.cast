[14568.78069, "o", "\t\tif cfg.auditLogRotateBytes != 0 {\r\n   204\t\t\tif cfg.auditLog == \"\" {\r\n   205\t\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --audit-log-rotate-bytes requires --audit-log\")\r\n   206\t\t\t}\r\n   207\t\t\tif cfg.auditLogRotateBytes < 4096 {\r\n"]
