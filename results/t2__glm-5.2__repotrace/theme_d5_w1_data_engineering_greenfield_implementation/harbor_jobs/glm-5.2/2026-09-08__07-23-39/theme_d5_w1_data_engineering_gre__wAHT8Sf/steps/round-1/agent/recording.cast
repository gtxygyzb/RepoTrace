[12700.567968, "o", "\t\t}\r\n\t\t\tif len(orderedPaths) > 1 {\r\n\t\t\t\tnames := make([]string, len(orderedPaths))\r\n\t\t\t\tfor i, path := range orderedPaths {\r\n\t\t\t\t\tnames[i] = filepath.Base(path)\r\n\t\t\t\t}\r\n\t\t\t\thashes := make([]string, len(orderedPaths))\r\n"]
[12700.568021, "o", "\t\t\t\tfor i, path := range orderedPaths {\r\n\t\t\t\t\thashes[i] = hashByPath[path]\r\n\t\t\t\t}\r\n\t\t\t\tdigest.AuditLog = mustJSONStringArray(names)\r\n\t\t\t\tdigest.SHA256Segments = hashes\r\n\t\t\t} else {\r\n\t\t\t\tdigest.AuditLog = mustJSONString(filepath.Base(orderedPaths[0]))\r\n\t\t\t\t"]
[12700.568074, "o", "digest.SHA256 = hashByPath[orderedPaths[0]]\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t\tdigest.AuditLog = mustJSONString(\"\")\r\n\t\t}\r\n\t\tdata, err := json.MarshalIndent(digest, \"\", \"  \")\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t"]
