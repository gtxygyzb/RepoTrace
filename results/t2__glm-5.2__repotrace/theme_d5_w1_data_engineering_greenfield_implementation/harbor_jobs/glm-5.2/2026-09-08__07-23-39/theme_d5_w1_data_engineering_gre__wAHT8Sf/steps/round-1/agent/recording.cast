[9065.376777, "o", "\t}\r\n   149\t\r\n   150\tfunc (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {\r\n   151\t\tif !rt.known[currency] {\r\n   152\t\t\treturn 0, 0, \"fx_unknown_currency\"\r\n   153\t\t}\r\n   154\t\tif m, ok := rt.days[date]; ok {\r\n   155\t\t\tif r, ok := m[currency]; ok {\r\n   156\t\t\t\tif isUsableRate(r) {\r\n   157\t\t\t\t\treturn r, 0, \"\"\r\n   158\t\t\t\t}\r\n   159\t\t\t\treturn 0, 0, \"bad_rate\"\r\n"]
[9065.376844, "o", "   160\t\t\t}\r\n   161\t\t}\r\n   162\t\tif maxStaleness > 0 {\r\n   163\t\t\teventDay := dayEpoch(date)\r\n   164\t\t\tif !eventDay.IsZero() {\r\n   165\t\t\t\tvar bestDate string\r\n   166\t\t\t\tvar bestDist int64 = -1\r\n   167\t\t\t\tfor _, d := range sortedKeys(rt.days) {\r\n   168\t\t"]
[9065.376912, "o", "\t\t\tif _, ok := rt.days[d][currency]; !ok {\r\n   169\t\t\t\t\t\tcontinue\r\n   170\t\t\t\t\t}\r\n   171\t\t\t\t\tdayTime := dayEpoch(d)\r\n   172\t\t\t\t\tif dayTime.IsZero() {\r\n   173\t\t\t\t\t\tcontinue\r\n   174\t\t\t\t\t}\r\n   175\t\t\t\t\tdist := absInt64(dayTime.Unix() - eventDay.Unix())\r\n"]
[9065.37698, "o", "   176\t\t\t\t\tif dist > int64(maxStaleness) {\r\n   177\t\t\t\t\t\tcontinue\r\n   178\t\t\t\t\t}\r\n   179\t\t\t\t\tif bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {\r\n   180\t\t\t\t\t\tbestDist = dist\r\n   181\t\t\t\t\t\tbestDate = d\r\n   182\t\t\t\t\t}\r\n   183\t\t\t\t}\r\n   184\t\t\t\tif bestDate != \"\" {\r\n   185\t\t\t\t\tr := rt.days[bestDate][currency]\r\n"]
[9065.377052, "o", "   186\t\t\t\t\tif isUsableRate(r) {\r\n   187\t\t\t\t\t\treturn r, calendarDayDiff(bestDate, date), \"\"\r\n   188\t\t\t\t\t}\r\n   189\t\t\t\t\treturn 0, 0, \"bad_rate\"\r\n   190\t\t\t\t}\r\n   191\t\t\t}\r\n   192\t\t}\r\n   193\t\treturn 0, 0, \"missing_rate\"\r\n   194\t}\r\n   195\t\r\n   196\tfunc loadRates(path string) (*RateTable, error) {\r\n   197\t\t"]
[9065.377118, "o", "data, err := os.ReadFile(path)\r\n   198\t\tif err != nil {\r\n   199\t\t\treturn nil, err\r\n   200\t\t}\r\n   201\t\tvar top map[string]json.RawMessage\r\n   202\t\tif err := json.Unmarshal(data, &top); err != nil {\r\n   203\t\t\treturn nil, fmt.Errorf(\"rates file is not valid json: %w\", err)\r\n   204\t\t}\r\n   205\t\trt := newRateTable()\r\n   206\t\tdaysRaw, ok := top[\"days\"]"]
[9065.377214, "o", "\r\n   207\t\tif !ok {\r\n   208\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n   209\t\t}\r\n   210\t\tvar days map[string]json.RawMessage\r\n   211\t\tif err := json.Unmarshal(daysRaw, &days); err != nil {\r\n   212\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n   213\t\t}\r\n   214\t\tif len(days) == 0 {\r\n   215\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n   216\t\t}\r\n   217\t\tfor _, day := range sortedKeys(days) {\r\n   218\t\t\tif !isStrictDate(day) || !isDate(day) {\r\n"]
[9065.377319, "o", "   219\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: invalid day key %s\", day)\r\n   220\t\t\t}\r\n   221\t\t\tvar currencies map[string]json.RawMessage\r\n   222\t\t\tif err := json.Unmarshal(days[day], &currencies); err != nil {\r\n   223\t\t\t\treturn nil, errors.New(\"fx days invalid\")\r\n   224\t\t\t}\r\n   225\t\t\tfor _, currency := range sortedKeys(currencies) {"]
[9065.377402, "o", "\r\n   226\t\t\t\tf, err := parseRateNumber(currencies[currency])\r\n   227\t\t\t\tif err != nil {\r\n   228\t\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: non-numeric rate for %s/%s\", day, currency)\r\n   229\t\t\t\t}\r\n   230\t\t\t\tif rt.days[day] == nil {\r\n   231\t\t\t\t\trt.days[day] = map[string]float64{}\r\n   232\t\t\t\t}\r\n   233\t\t\t\trt.days[day][currency] = f\r\n   234\t\t\t\trt.known[currency] = true\r\n   235\t\t\t}\r\n   236\t\t}\r\n   237\t\tbaseRaw, baseOk := top[\"base\"]\r\n   238\t\tif !baseOk {\r\n   239\t\t\treturn nil, errors.New(\"ingest: rates.json: base required\")\r\n   240\t\t}\r\n   241\t\tvar base string\r\n   242\t\tif err := json.Unmarshal(baseRaw, &base); err != nil || base == \"\" {\r\n   243\t\t\treturn nil, errors.New(\"ingest: rates.json: base required\")\r\n   244\t\t}\r\n   245\t\trt.base = base\r\n   246\t\t"]
[9065.377472, "o", "if base != \"USD\" {\r\n   247\t\t\treturn nil, errors.New(\"fx base must be USD\")\r\n   248\t\t}\r\n   249\t\tfor _, day := range sortedKeys(rt.days) {\r\n   250\t\t\tr, ok := rt.days[day][base]\r\n   251\t\t\tif !ok || r != 1.0 {\r\n   252\t\t\t\treturn nil, fmt.Errorf(\"ingest: rates.json: base currency %s must have rate 1.0 on day %s\", base, day)\r\n   253\t\t\t}\r\n   254\t\t}\r\n   255\t\treturn rt, nil\r\n   256\t}\r\n   257\t"]
[9065.377592, "o", "\r\n   258\tfunc readInputEvents(inputDir string) ([]rawEvent, []inputShardInfo, error) {\r\n   259\t\tinfo, err := os.Stat(inputDir)\r\n   260\t\tif err != nil {\r\n   261\t\t\treturn nil, nil, err\r\n   262\t\t}\r\n   263\t\tif !info.IsDir() {\r\n   264\t\t\treturn nil, nil, errors.New(\"input-dir is not a directory\")\r\n   265\t\t}\r\n   266\t\tentries, err := os.ReadDir(inputDir)\r\n   267\t\tif err != nil {\r\n   268\t\t\treturn nil, nil, err\r\n   269\t\t}\r\n   270\t\tvar files []string\r\n   271\t\tfor _, e := range entries {\r\n   272\t\t\tif e.IsDir() || !e.Type().IsRegular() {\r\n   273\t\t\t\tcontinue\r\n"]
[9065.377661, "o", "   274\t\t\t}\r\n   275\t\t\tfiles = append(files, e.Name())\r\n   276\t\t}\r\n   277\t\tsort.Strings(files)\r\n   278\t\tvar events []rawEvent\r\n   279\t\tvar shards []inputShardInfo\r\n   280\t\tfor _, name := range files {\r\n   281\t\t\tdata, err := os.ReadFile(filepath.Join(inputDir, name))\r\n   282\t\t\tif err != nil {\r\n   283\t\t"]
[9065.377729, "o", "\t\treturn nil, nil, err\r\n   284\t\t\t}\r\n   285\t\t\tsi := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}\r\n   286\t\t\tlineNo := 0\r\n   287\t\t\tfor _, line := range bytes.Split(data, []byte{'\\n'}) {\r\n   288\t\t\t\tlineNo++\r\n   289\t\t\t\ttrimmed := bytes.TrimSpace(line)\r\n   290\t\t\t\tif len(trimmed) == 0 {\r\n   291\t\t\t\t\tcontinue\r\n   292\t\t\t\t}\r\n   293\t"]
[9065.377795, "o", "\t\t\tsi.EventsTotal++\r\n   294\t\t\t\tvar obj map[string]json.RawMessage\r\n   295\t\t\t\tinvalid := false\r\n   296\t\t\t\tif err := json.Unmarshal(trimmed, &obj); err != nil {\r\n   297\t\t\t\t\tinvalid = true\r\n   298\t\t\t\t}\r\n   299\t\t\t\tevents = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})\r\n   300\t\t\t}\r\n   301\t\t\tshards = append(shards, si)\r\n"]
[9065.377863, "o", "   302\t\t}\r\n   303\t\treturn events, shards, nil\r\n   304\t}\r\n   305\t\r\n   306\tfunc newContext(raw rawEvent) *eventContext {\r\n   307\t\tctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}\r\n   308\t\tif raw.Obj != nil {\r\n   309\t\t\tctx.ID = rawStringPtr(raw.Obj, \"id\")\r\n   310\t\t\tctx.TS = rawStringPtr(raw.Obj, \"ts\")\r\n   311\t\t\tctx.Type = rawStringPtr(raw.Obj, \"type\")\r\n"]
