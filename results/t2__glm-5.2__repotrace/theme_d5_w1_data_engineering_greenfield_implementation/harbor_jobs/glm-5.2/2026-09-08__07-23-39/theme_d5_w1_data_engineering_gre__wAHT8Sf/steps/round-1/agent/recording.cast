[14533.216002, "o", "   528\t\r\n   529\tfunc sortedPending(pending []pendingEntry) []pendingEntry {\r\n   530\t\tout := append([]pendingEntry(nil), pending...)\r\n   531\t\tsort.SliceStable(out, func(i, j int) bool {\r\n   532\t\t\tif out[i].ts.Equal(out[j].ts) {\r\n   533\t\t\t\treturn out[i].id < out[j].id\r\n   534\t\t\t}\r\n   535\t\t\treturn out[i].ts.Before(out[j].ts)\r\n   536\t\t})\r\n   537\t"]
[14533.216062, "o", "\treturn out\r\n   538\t}\r\n   539\t\r\n   540\tfunc sortedOpenSessions(m map[string]carriedSession) []carriedSession {\r\n   541\t\tout := make([]carriedSession, 0, len(m))\r\n   542\t\tfor _, s := range m {\r\n   543\t\t\tout = append(out, s)\r\n"]
[14533.216118, "o", "   544\t\t}\r\n   545\t\tsort.SliceStable(out, func(i, j int) bool {\r\n   546\t\t\tif out[i].lastTs.Equal(out[j].lastTs) {\r\n   547\t\t\t\treturn out[i].user < out[j].user\r\n   548\t\t\t}\r\n   549\t\t\treturn out[i].lastTs.Before(out[j].lastTs)\r\n   550\t\t})\r\n   551\t\treturn out\r\n"]
