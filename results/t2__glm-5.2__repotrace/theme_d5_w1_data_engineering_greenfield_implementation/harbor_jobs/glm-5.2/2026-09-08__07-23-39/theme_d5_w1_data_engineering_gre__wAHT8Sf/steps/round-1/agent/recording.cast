[20163.761201, "o", "   113\t\tcase int64:\r\n   114\t\t\tfmt.Fprintf(buf, \"%d\", val)\r\n   115\t\tcase bool:\r\n   116\t\t\tif val {\r\n   117\t\t\t\tbuf.WriteString(\"true\")\r\n   118\t\t\t} else {\r\n   119\t\t\t\tbuf.WriteString(\"false\")\r\n   120\t\t\t}\r\n   121\t\tcase nil:\r\n   122\t\t\tbuf.WriteString(\"null\")\r\n   123\t\tcase orderedJSON:\r\n"]
