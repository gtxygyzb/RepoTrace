[17985.919741, "o", "\t\tdata := marshalOrderedIndent(top)\r\n   444\t\tdata = append(data, '\\n')\r\n   445\t\treturn data, nil\r\n   446\t}\r\n   447\t\r\n   448\tfunc writeSummarySchemaSidecars(cfg cliConfig, summaryData []byte, runIndex int) error {\r\n   449\t\tif cfg.summarySchemaOut == \"\" {\r\n   450\t\t\treturn nil\r\n   451\t\t}\r\n   452\t\tschemaData, err := buildSchemaSidecar(summaryData, cfg, runIndex)\r\n   453\t\tif err != nil {\r\n   454\t\t\treturn err\r\n   455\t\t}\r\n   456\t\tif err := atomicWriteFile(cfg.summarySchemaOut, schemaData); err != nil {\r\n   457\t\t\treturn err\r\n   458\t\t}\r\n   459\t\tif cfg.summarySchemaDigest != \"\" {\r\n   460\t\t\thash, n, err := fileDigest(cfg.summarySchemaOut)\r\n"]
[17985.919828, "o", "   461\t\t\tif err != nil {\r\n   462\t\t\t\treturn err\r\n   463\t\t\t}\r\n   464\t\t\tdigest := []orderedJSON{\r\n   465\t\t\t\t{key: \"schema_path\", value: filepath.Base(cfg.summarySchemaOut)},\r\n   466\t\t\t\t{key: \"schema_sha256\", value: hash},\r\n   467\t\t\t\t{key: \"schema_bytes\", value: n},\r\n   468\t\t\t\t{key: \"field_count\", value: 7},\r\n   469\t\t\t\t{key: \"tool_version\", value: toolVersion},\r\n   470\t\t\t}\r\n"]
[17985.919894, "o", "   471\t\t\tdata := marshalOrderedIndent(digest)\r\n   472\t\t\tdata = append(data, '\\n')\r\n   473\t\t\tif err := atomicWriteFile(cfg.summarySchemaDigest, data); err != nil {\r\n   474\t\t\t\treturn err\r\n   475\t\t\t}\r\n   476\t\t\tif cfg.summarySchemaIndex != \"\" {\r\n   477\t\t\t\tindex, err := buildIndexSidecar(cfg, summaryData)\r\n   478\t\t\t\tif err != nil {\r\n   479\t\t\t\t"]
[17985.919957, "o", "\treturn err\r\n   480\t\t\t\t}\r\n   481\t\t\t\tif err := atomicWriteFile(cfg.summarySchemaIndex, index); err != nil {\r\n   482\t\t\t\t\treturn err\r\n   483\t\t\t\t}\r\n   484\t\t\t}\r\n   485\t\t}\r\n   486\t\treturn nil\r\n   487\t}\r\n   488\t\r\n"]
[17985.920021, "o", "   489\tfunc buildIndexSidecar(cfg cliConfig, summaryData []byte) ([]byte, error) {\r\n   490\t\tfields, err := parseSummaryFields(summaryData)\r\n   491\t\tif err != nil {\r\n   492\t\t\treturn nil, err\r\n   493\t\t}\r\n   494\t\tentries := make([]any, 0)\r\n   495\t\tfor _, f := range fields {\r\n   496\t\t\tentries = append(entries, []orderedJSON{\r\n   497\t\t\t\t{key: \"name\", value: f.key},\r\n   498\t\t\t\t{key: \"type\", value: classify(f.value)},\r\n"]
[17985.920086, "o", "   499\t\t\t\t{key: \"path\", value: \"$.\" + f.key},\r\n   500\t\t\t})\r\n   501\t\t\tif classify(f.value) == \"array\" {\r\n   502\t\t\t\tarr := f.value.([]any)\r\n   503\t\t\t\tif len(arr) > 0 && classify(arr[0]) == \"object\" {\r\n   504\t\t\t\t\tobj := arr[0].(map[string]any)\r\n   505\t\t\t\t\tkeys := make([]string, 0, len(obj))\r\n   506\t\t\t\t\tfor k := range obj {\r\n"]
[17985.920117, "o", "   507\t\t\t\t\t\tkeys = append(keys, k)\r\n   508\t\t\t\t\t}\r\n   509\t\t\t\t\tsort.Strings(keys)\r\n   510\t\t\t\t\tfor _, k := range keys {\r\n"]
[17985.920415, "o", "   511\t\t\t\t\t\tentries = append(entries, []orderedJSON{\r\n   512\t\t\t\t\t\t\t{key: \"name\", value: k},\r\n   513\t\t\t\t\t\t\t{key: \"type\", value: classify(obj[k])},\r\n   514\t\t\t\t\t\t\t{key: \"path\", value: fmt.Sprintf(\"$.%s[*].%s\", f.key, k)},\r\n   515\t\t\t\t\t\t})\r\n   516\t\t\t\t\t}\r\n   517\t\t\t\t}\r\n   518\t\t\t}\r\n   519\t\t}\r\n   520\t\ttop := []orderedJSON{\r\n"]
