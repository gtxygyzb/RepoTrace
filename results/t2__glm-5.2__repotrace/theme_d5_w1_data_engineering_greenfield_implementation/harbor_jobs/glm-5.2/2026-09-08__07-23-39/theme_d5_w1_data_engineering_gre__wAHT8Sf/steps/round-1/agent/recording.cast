[3566.23942, "i", "cat > main.go <<'EOF'\npackage main\n\nimport (\n  \"bytes\"\n  \"encoding/json\"\n  \"errors\"\n  \"fmt\"\n  \"math\"\n  \"os\"\n  \"path/filepath\"\n  \"sort\"\n  \"strconv\"\n  \"strings\"\n  \"time\"\n)\n\nvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>]\\n\"\n\ntype Money float64\n\nfunc (m Money) MarshalJSON() ([]byte, error) {\n  return []byte(m.String()), nil\n}\n\nfunc (m Money) String() string {\n  f := float64(m)\n  abs := math.Abs(f)\n  cents := int64(math.Floor(abs*100.0 + 0.5))\n  neg := f < 0 && cents != 0\n  dollars := cents / 100\n  rem := cents % 100\n  s := fmt.Sprintf(\"%d.%02d\", dollars, rem)\n  if neg {\n    s = \"-\" + s\n  }\n  return s\n}\n\ntype Event struct {\n  ID       string\n  Type     string\n  TS       time.Time\n  UserID   string\n  Amount   float64\n  Currency string\n  RefID    string\n  USD      float64\n  RefUSD   float64\n  Raw      json.RawMessag"]
[3566.239726, "i", "e\n  Shard    string\n  Line     int\n}\n\ntype Reject struct {\n  Bucket int             `json:\"bucket\"`\n  Reason string          `json:\"reason\"`\n  Event  json.RawMessage `json:\"event\"`\n}\n\ntype ShardLine struct {\n  Shard string\n  Line  int\n  Data  []byte\n}\n\ntype RateTable struct {\n  byDate map[string]map[string]float64\n  global map[string]float64\n}\n\nfunc newRateTable() *RateTable {\n  return &RateTable{byDate: map[string]map[string]float64{}, global: map[string]float64{}}\n}\n\nfunc (rt *RateTable) rate(date, currency string) (float64, bool) {\n  if currency == \"USD\" {\n    return 1.0, true\n  }\n  if m, ok := rt.byDate[date]; ok {\n    if r, ok := m[currency]; ok && r > 0 {\n      return r, true\n    }\n  }\n  if r, ok := rt.global[currency]; ok && r > 0 {\n    return r, true\n  }\n  return 0, false\n}\n\ntype pendingEntry struct {\n  id        string\n  ts        time.Time\n  user      string\n  usd       float64\n  originRun int\n}\n\ntype purchaseSurvivor struct {\n  id      string\n  ts      time.Time\n  user    string\n  usd     float64\n "]
[3566.23983, "o", "cat > main.go <<'EOF'\r\n\u001b[?2004l\r"]
