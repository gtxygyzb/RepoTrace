[10874.671181, "o", "cfg.outManifest = nextArg(args, &i)\r\n   112\t\t\tcase \"--manifest-signature\":\r\n   113\t\t\t\tcfg.manifestSignature = nextArg(args, &i)\r\n   114\t\t\tcase \"--dedup-policy\":\r\n   115\t\t\t\tval := nextArg(args, &i)\r\n"]
