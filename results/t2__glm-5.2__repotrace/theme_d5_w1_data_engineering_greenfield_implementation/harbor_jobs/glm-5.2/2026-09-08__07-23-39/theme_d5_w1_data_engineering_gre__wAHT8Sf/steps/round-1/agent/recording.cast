[7252.300677, "o", "   344\t\tdefault:\r\n   345\t\t\treturn nil, \"bad_type\"\r\n   346\t\t}\r\n   347\t\tuser, userOk, _ := getRawString(obj, \"user_id\")\r\n   348\t\tif !userOk || user == \"\" {\r\n   349\t\t\treturn nil, \"missing_user\"\r\n   350\t\t}\r\n   351\t\tev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}\r\n   352\t\tswitch typeStr {\r\n"]
[7252.300735, "o", "   353\t\tcase \"purchase\", \"refund\":\r\n   354\t\t\tvar amount float64\r\n   355\t\t\tif v == 1 {\r\n   356\t\t\t\traw, present := obj[\"amount\"]\r\n   357\t\t\t\tif !present {\r\n   358\t\t\t\t\treturn nil, \"missing_amount\"\r\n   359\t\t\t\t}\r\n   360\t\t\t\tvar f float64\r\n   361\t\t\t\tif err := json.Unmarshal(raw, &f); err != nil {\r\n"]
