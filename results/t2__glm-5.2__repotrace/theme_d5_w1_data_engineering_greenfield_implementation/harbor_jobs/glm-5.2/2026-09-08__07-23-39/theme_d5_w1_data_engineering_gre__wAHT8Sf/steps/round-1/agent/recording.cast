[14732.107373, "o", "func writeSummarySchemaSidecars(cfg cliConfig, summaryData []byte, runIndex int) error {\r\nif cfg.summarySchemaOut == \"\" {\r\nreturn nil\r\n}\r\nschemaData, err := buildSchemaSidecar(summaryData, cfg, runIndex)\r\nif err != nil {\r\n"]
[14732.107466, "o", "return err\r\n}\r\nif err := atomicWriteFile(cfg.summarySchemaOut, schemaData); err != nil {\r\nreturn err\r\n}\r\nif cfg.summarySchemaDigest != \"\" {\r\nhash, n, err := fileDigest(cfg.summarySchemaOut)\r\nif err != nil {\r\nreturn err\r\n}\r\ndigest := []orderedJSON{\r\n{key: \"schema_path\", value: filepath.Base(cfg.summarySchemaOut)},\r\n{key: \"schema_sha256\", value: hash},\r\n{key: \"schema_bytes\", value: n},\r\n{key: \"field_count\", value: 7},\r\n{key: \"tool_version\", value: toolVersion},\r\n}\r\ndata := marshalOrderedIndent(digest)\r\n"]
[14732.10754, "o", "data = append(data, '\\n')\r\nif err := atomicWriteFile(cfg.summarySchemaDigest, data); err != nil {\r\nreturn err\r\n}\r\nif cfg.summarySchemaIndex != \"\" {\r\nindex, err := buildIndexSidecar(cfg, summaryData)\r\nif err != nil {\r\nreturn err\r\n}\r\nif err := atomicWriteFile(cfg.summarySchemaIndex, index); err != nil {\r\nreturn err\r\n}\r\n}\r\n}\r\nreturn nil\r\n}\r\n"]
