[13895.85547, "o", "\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif !rt.known[currency] {\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn 0, 0, \"\u001b[01;31m\u001b[Kfx\u001b[m\u001b[K_unknown_currency\"\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tif m, ok := rt.\u001b[01;31m\u001b[Kdays\u001b[m\u001b[K[date]; ok {\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif r, ok := m[currency]; ok {\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif isUsableRate(r) {\r\n"]
[13895.855531, "o", "\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\treturn r, 0, \"\"\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif !eventDay.IsZero() {\r\n\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tvar bestDate string\r\n\u001b[32m\u001b[K166\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tvar bestDist int64 = -1\r\n\u001b[32m\u001b[K167\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tfor _, d := range sortedKeys(rt.\u001b[01;31m\u001b[Kdays\u001b[m\u001b[K) {\r\n\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tif _, ok := rt.\u001b[01;31m\u001b[Kdays\u001b[m\u001b[K[d][currency]; !ok {\r\n"]
[13895.855595, "o", "\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\tcontinue\r\n\u001b[32m\u001b[K170\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t}\r\n\u001b[32m\u001b[K171\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tdayTime := dayEpoch(d)\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t}\r\n\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t}\r\n"]
[13895.855653, "o", "\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tif bestDate != \"\" {\r\n\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tr := rt.\u001b[01;31m\u001b[Kdays\u001b[m\u001b[K[bestDate][currency]\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\tif isUsableRate(r) {\r\n\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t\treturn r, calendarDayDiff(bestDate, date), \"\"\r\n\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\t\t}\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n"]
