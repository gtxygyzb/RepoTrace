[18201.203842, "o", "Krejects-format\u001b[m\u001b[K-header requires --\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K tagged\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --fixed-window-seconds requires --\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K fixed-window or hybrid\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K fixed-window requires --fixed-window-seconds\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K hybrid requires --fixed-window-seconds\")\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc atoiOrError(s, \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K string) int {\r\n\u001b[35m\u001b[Kcli.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K295\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tpanic(fmt.Errorf(\"ingest: invalid integer for %s: %s\", \u001b[01;31m\u001b[Kflag\u001b[m\u001b[K, s))\r\n"]
[18201.204433, "o", "\u001b[35m\u001b[Kmain.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--state-strict] [--audit-log <path>] [--audit-log-digest <path>] [--audit-log-rotate-bytes <int>] [--rates-strict] [--rates-max-staleness <seconds>] [--\u001b[01;31m\u001b[Kingest-id\u001b[m\u001b[K <string>] [--\u001b[01;31m\u001b[Kout-parquet-manifest\u001b[m\u001b[K <path>] [--manifest-signature <path>] [--dedup-policy <first-arrival|lex-largest-ts>] [--strict-late-audit] [--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-out <path>] [--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-digest <path>] [--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-strict] [--\u001b[01;31m\u001b[Ksummary-schema\u001b[m\u001b[K-index <path>] [--\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K <legacy|tagged|tagged-sorted>] [--\u001b[01;31m\u001b[Krejects-format\u001b[m\u001b[K-header] [--\u001b[01;31m\u001b[Ksession-policy\u001b[m\u001b[K <gap|fixed-window|hybrid>] [--fixe"]
