[12700.566479, "o", "\t\tif bucket == \"invalid\" {\r\n\t\t\tinvalidReasons[reason]++\r\n\t\t}\r\n\t\tbucketCounts[bucket]++\r\n\t\tif bucket == \"duplicate\" && reason == \"cross_run\" {\r\n\t\t\tduplicateReasons[\"cross_run\"]++\r\n\t\t}\r\n\t\tcandidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})\r\n"]
[12700.566532, "o", "\t\tauditEntries = append(auditEntries, auditLogEntry{\r\n\t\t\tShard:  raw.Shard,\r\n\t\t\tLine:   raw.Line,\r\n\t\t\tID:     ctx.IDStr(),\r\n\t\t\tTS:     ctx.TSString(),\r\n\t\t\tType:   ctx.TypeString(),\r\n\t\t\tBucket: bucket,\r\n\t\t\tReason: reason,\r\n"]
[12700.566585, "o", "\t\t\tEvent:  raw.Raw,\r\n\t\t})\r\n\t}\r\n\r\n\t// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.\r\n"]
[12700.566638, "o", "\tgroups := map[string][]int{}\r\n\tfor i, c := range candidates {\r\n\t\tif c.ev != nil {\r\n\t\t\tgroups[c.ev.ID] = append(groups[c.ev.ID], i)\r\n\t\t}\r\n\t}\r\n\twinnerSet := map[int]bool{}\r\n\twinners := map[string]int{}\r\n"]
[12700.566691, "o", "\tvar dedupPolicyStats dedupPolicyStats\r\n\tdedupPolicyStats.Policy = cfg.dedupPolicy\r\n\tfor id, idxs := range groups {\r\n\t\tif len(idxs) < 2 {\r\n\t\t\tif len(idxs) == 1 {\r\n\t\t\t\twinners[id] = idxs[0]\r\n"]
[12700.566744, "o", "\t\t\t\twinnerSet[idxs[0]] = true\r\n\t\t\t}\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\twinner := idxs[0]\r\n\t\ttiebreak := false\r\n\t\tfor _, idx := range idxs[1:] {\r\n\t\t\tif cfg.dedupPolicy == \"first-arrival\" {"]
[12700.566797, "o", "\r\n\t\t\t\tif arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n\t\t\t\t\twinner = idx\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tcts := candidates[idx].ctx.TSString()\r\n"]
[12700.56685, "o", "\t\t\t\twts := candidates[winner].ctx.TSString()\r\n\t\t\t\tif cts > wts {\r\n\t\t\t\t\twinner = idx\r\n\t\t\t\t\ttiebreak = false\r\n\t\t\t\t} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n\t\t\t\t\twinner = idx\r\n\t\t\t\t\ttiebreak = true\r\n"]
[12700.566902, "o", "\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif cfg.dedupPolicy == \"lex-largest-ts\" {\r\n\t\t\twts := candidates[winner].ctx.TSString()\r\n\t\t\tfor _, idx := range idxs {\r\n\t\t\t\tif idx != winner && candidates[idx].ctx.TSString() == wts {\r\n\t\t\t\t\ttiebreak = true\r\n"]
[12700.566952, "o", "\t\t\t\t\tbreak\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\twinners[id] = winner\r\n\t\twinnerSet[winner] = true\r\n\t\tsameShard := true\r\n\t\tfor _, idx := range idxs {\r\n"]
[12700.567003, "o", "\t\t\tif candidates[idx].ev.Shard != candidates[winner].ev.Shard {\r\n\t\t\t\tsameShard = false\r\n\t\t\t\tbreak\r\n\t\t\t}\r\n\t\t}\r\n\t\tif sameShard {\r\n\t\t\tdedupPolicyStats.DuplicateWinnersSameShard++\r\n"]
[12700.567054, "o", "\t\t\tif cfg.dedupPolicy == \"first-arrival\" || tiebreak {\r\n\t\t\t\tdedupPolicyStats.DuplicateWinnersLineTiebreak++\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t\tdedupPolicyStats.DuplicateWinnersCrossShard++\r\n\t\t}\r\n\t}\r\n"]
[12700.567105, "o", "\r\n\t// Finalize accepted/duplicate buckets and outputs in arrival order.\r\n\thasMin, hasMax = false, false\r\n\tfor _, c := range candidates {\r\n\t\tif c.ev != nil {\r\n\t\t\tseen[c.ev.ID] = true\r\n\t\t}\r\n\t}\r\n\t"]
[12700.567155, "o", "bucketCounts[\"accepted\"] = 0\r\n\tbucketCounts[\"duplicate\"] = duplicateReasons[\"cross_run\"]\r\n\tfor i, c := range candidates {\r\n\t\t_ = i\r\n\t\tif c.ev == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif winnerSet[i] {\r\n\t"]
[12700.567216, "o", "\t\tbucketCounts[\"accepted\"]++\r\n\t\t\tshardAccepted[c.ev.Shard]++\r\n\t\t\tif !hasMin || c.ev.TS.Before(minTs) {\r\n\t\t\t\tminTs = c.ev.TS\r\n\t\t\t\thasMin = true\r\n\t\t\t}\r\n\t\t\tif !hasMax || c.ev.TS.After(maxTs) {"]
[12700.56728, "o", "\r\n\t\t\t\tmaxTs = c.ev.TS\r\n\t\t\t\thasMax = true\r\n\t\t\t}\r\n\t\t\t_ = pending\r\n\t\t\t_ = openSessions\r\n\t\t} else {\r\n\t\t\tbucketCounts[\"duplicate\"]++\r\n\t\t\tduplicateReasons[\"same_run\"]++\r\n\t\t\tentry := auditEntries[i]\r\n"]
[12700.567341, "o", "\t\t\tentry.Bucket = \"duplicate\"\r\n\t\t\tentry.Reason = \"same_run\"\r\n\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n\t\t\t\tw := winners[entry.ID]\r\n\t\t\t\tentry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}\r\n\t\t\t}\r\n\t\t\tauditEntries[i] = entry\r\n\t\t}\r\n\t}"]
[12700.567396, "o", "\r\n\r\n\tvar rejectRecords []rejectRecord\r\n\tfor i, c := range candidates {\r\n\t\tif c.ev == nil {\r\n\t\t\tr := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, raw: c.raw.Raw}\r\n\t\t\trejectRecords = append(rejectRecords, r)\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif winnerSet[i] {\r\n"]
[12700.567446, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tr := rejectRecord{bucket: \"duplicate\", reason: \"same_run\", raw: c.raw.Raw}\r\n\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n\t\t\tr.winner = true\r\n\t\t\tr.winnerShard = candidates[winners[c.ev.ID]].ev.Shard\r\n"]
