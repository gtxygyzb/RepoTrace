[16360.338157, "o", "maxOpenSessions     int\r\n    29\t\tauditLog            string\r\n    30\t\tauditLogDigest      string\r\n    31\t\tauditLogRotateBytes int\r\n    32\t\tratesStrict         bool\r\n    33\t\tratesMaxStaleness   int\r\n    34\t\tingestID            string\r\n    35\t\tingestIDSet         bool\r\n    36\t\toutManifest         string\r\n    37\t\tmanifestSignature   string\r\n    38\t\tdedupPolicy         string\r\n"]
[16360.338207, "o", "    39\t\tdedupPolicySet      bool\r\n    40\t\tstrictLateAudit     bool\r\n    41\t\tstateStrict         bool\r\n    42\t\tsummarySchemaOut    string\r\n    43\t\tsummarySchemaDigest string\r\n    44\t\tsummarySchemaStrict bool\r\n    45\t\tsummarySchemaIndex  string\r\n    46\t\trejectsFormat       string\r\n    47\t\trejectsFormatHeader bool\r\n    48\t}\r\n    49\t\r\n"]
[16360.338302, "o", "    50\tfunc main() {\r\n    51\t\tcfg, err := parseArgs(os.Args[1:])\r\n    52\t\tif err != nil {\r\n    53\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    54\t\t\tos.Exit(2)\r\n    55\t\t}\r\n    56\t\tif err := run(cfg); err != nil {\r\n    57\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    58\t\t\tos.Exit(1)\r\n    59\t\t}\r\n    60\t}\r\n    61\t\r\n"]
[16360.338371, "o", "    62\tfunc parseArgs(args []string) (cfg cliConfig, err error) {\r\n    63\t\tdefer func() {\r\n    64\t\t\tif r := recover(); r != nil {\r\n    65\t\t\t\tcfg = cliConfig{}\r\n    66\t\t\t\terr = fmt.Errorf(\"%v\", r)\r\n    67\t\t\t}\r\n    68\t\t}()\r\n    69\t\tcfg = cliConfig{\r\n    70\t\t\tsessionGap:        600,\r\n    71\t\t\twatermarkLag:      300,\r\n    72\t\t\tpendingTTL:        86400,\r\n"]
