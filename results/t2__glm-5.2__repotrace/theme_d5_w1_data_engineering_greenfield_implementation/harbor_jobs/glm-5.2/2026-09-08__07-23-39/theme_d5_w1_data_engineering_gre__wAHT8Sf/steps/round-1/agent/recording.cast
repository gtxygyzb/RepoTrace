[16542.075742, "o", "   400\t\t\t})\r\n   401\t\t}\r\n   402\t\r\n   403\t\t// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.\r\n   404\t\tgroups := map[string][]int{}\r\n   405\t\tfor i, c := range candidates {\r\n"]
[16542.07584, "o", "   406\t\t\tif c.ev != nil {\r\n   407\t\t\t\tgroups[c.ev.ID] = append(groups[c.ev.ID], i)\r\n   408\t\t\t}\r\n   409\t\t}\r\n   410\t\twinnerSet := map[int]bool{}\r\n   411\t\twinners := map[string]int{}\r\n   412\t\tvar dedupPolicyStats dedupPolicyStats\r\n   413\t\tdedupPolicyStats.Policy = cfg.dedupPolicy\r\n   414\t\tfor id, idxs := range groups {\r\n   415\t\t\tif len(idxs) < 2 {\r\n   416\t\t\t\tif len(idxs) == 1 {\r\n   417\t\t\t\t\twinners[id] = idxs[0]\r\n"]
[16542.075917, "o", "   418\t\t\t\t\twinnerSet[idxs[0]] = true\r\n   419\t\t\t\t}\r\n   420\t\t\t\tcontinue\r\n   421\t\t\t}\r\n   422\t\t\twinner := idxs[0]\r\n   423\t\t\ttiebreak := false\r\n   424\t\t\tfor _, idx := range idxs[1:] {\r\n   425\t\t\t\tif cfg.dedupPolicy == \"first-arrival\" {\r\n   426\t\t\t\t\tif arrivalLess(candidates[idx].ev, candidates[winner].ev) {\r\n   427\t\t\t\t\t\twinner = idx\r\n"]
