[16479.775884, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bytes\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"fmt\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"regexp\"\r\n    10\t\t\"sort\"\r\n    11\t\t\"strconv\"\r\n    12\t\t\"strings\"\r\n    13\t\t\"time\"\r\n    14\t)\r\n    15\t\r\n    16\tvar ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)\r\n    17\t\r\n    18\ttype cliConfig struct {\r\n    19\t\tinputDir            string\r\n    20\t\tratesPath           string\r\n    21\t\toutputPath          string\r\n    22\t\trejectsPath         string\r\n    23\t\tsessionGap          int\r\n    24\t\twatermarkLag        int\r\n    25\t\tstateIn             string\r\n    26\t\tstateOut            string\r\n"]
[16479.775999, "o", "    27\t\tpendingTTL          int\r\n    28\t\tmaxOpenSessions     int\r\n    29\t\tauditLog            string\r\n    30\t\tauditLogDigest      string\r\n    31\t\tauditLogRotateBytes int\r\n    32\t\tratesStrict         bool\r\n    33\t\tratesMaxStaleness   int\r\n    34\t\tingestID            string\r\n    35\t\tingestIDSet         bool\r\n    36\t\toutManifest         string\r\n    37\t\tmanifestSignature   string\r\n    38\t\tdedupPolicy         string\r\n    39\t\tdedupPolicySet      bool\r\n    40\t\tstrictLateAudit     bool\r\n    41\t\tstateStrict         bool\r\n    42\t\tsummarySchemaOut    string\r\n    43\t\tsummarySchemaDigest string\r\n    44\t\tsummarySchemaStrict bool\r\n    45\t\tsummarySchemaIndex  string\r\n    46\t\trejectsFormat       string\r\n    47\t\trejectsFormatHeader bool\r\n    48\t}\r\n    49\t\r\n    50\tfunc main() {\r\n    51\t\tcfg, err := parseArgs(os.Args[1:])\r\n    52\t\tif err != nil {\r\n    53\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    54\t\t\tos.Exit(2)\r\n    55\t\t}\r\n    56\t\tif err := run(cfg); err != nil {\r\n    57\t\t\tfmt.Fprintln(os.Stderr, err)\r\n    58\t\t\tos.Exit(1)\r\n    59\t\t}\r\n"]
