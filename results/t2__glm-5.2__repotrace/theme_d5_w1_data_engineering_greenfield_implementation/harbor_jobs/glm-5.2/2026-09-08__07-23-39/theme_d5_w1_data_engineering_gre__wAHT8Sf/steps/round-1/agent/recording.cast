[3575.792136, "i", "sed -n '1,220p' main.go\n"]
[3575.792423, "o", "sed -n '1,220p' main.go\r\n\u001b[?2004l\r"]
[3575.795427, "o", "package main\r\n\r\nimport (\r\n  \"bytes\"\r\n  \"encoding/json\"\r\n  \"errors\"\r\n  \"fmt\"\r\n  \"math\"\r\n  \"os\"\r\n"]
[3575.795545, "o", "  \"path/filepath\"\r\n  \"sort\"\r\n  \"strconv\"\r\n  \"strings\"\r\n  \"time\"\r\n)\r\n\r\nvar usageString = \"usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>]\\n\"\r\n\r\ntype Money float64\r\n\r\nfunc (m Money) MarshalJSON() ([]byte, error) {\r\n  return []byte(m.String()), nil\r\n}\r\n"]
[3575.795639, "o", "\r\nfunc (m Money) String() string {\r\n  f := float64(m)\r\n  abs := math.Abs(f)\r\n  cents := int64(math.Floor(abs*100.0 + 0.5))\r\n  neg := f < 0 && cents != 0\r\n  dollars := cents / 100\r\n  rem := cents % 100\r\n  s := fmt.Sprintf(\"%d.%02d\", dollars, rem)\r\n  if neg {\r\n    s = \"-\" + s\r\n  }\r\n  return s\r\n}\r\n\r\ntype Event struct {\r\n  ID       string\r\n  Type     string\r\n  TS       time.Time\r\n  UserID   string\r\n  Amount   float64\r\n  Currency string\r\n  RefID    string\r\n  USD      float64\r\n  RefUSD   float64\r\n  Raw      json.RawMessage\r\n  Shard    string\r\n  Line     int\r\n}\r\n\r\ntype Reject struct {\r\n  Bucket int             `json:\"bucket\"`\r\n  Reason string          `json:\"reason\"`\r\n"]
[3575.795704, "o", "  Event  json.RawMessage `json:\"event\"`\r\n}\r\n\r\ntype ShardLine struct {\r\n  Shard string\r\n  Line  int\r\n  Data  []byte\r\n}\r\n\r\ntype RateTable struct {\r\n  byDate map[string]map[string]float64\r\n  global map[string]float64\r\n}\r\n"]
[3575.795765, "o", "\r\nfunc newRateTable() *RateTable {\r\n  return &RateTable{byDate: map[string]map[string]float64{}, global: map[string]float64{}}\r\n}\r\n\r\nfunc (rt *RateTable) rate(date, currency string) (float64, bool) {\r\n  if currency == \"USD\" {\r\n    return 1.0, true\r\n  }\r\n  if m, ok := rt.byDate[date]; ok {\r\n    if r, ok := m[currency]; ok && r > 0 {\r\n      return r, true\r\n    }\r\n"]
[3575.795869, "o", "  }\r\n  if r, ok := rt.global[currency]; ok && r > 0 {\r\n    return r, true\r\n  }\r\n  return 0, false\r\n}\r\n\r\ntype pendingEntry struct {\r\n  id        string\r\n  ts        time.Time\r\n  user      string\r\n  usd       float64\r\n  originRun int\r\n}\r\n\r\ntype purchaseSurvivor struct {\r\n  id      string\r\n  ts      time.Time\r\n  user    string\r\n  usd     float64\r\n  retired bool\r\n}\r\n\r\ntype carriedSession struct {"]
[3575.795966, "o", "\r\n  user         string\r\n  lastTs       time.Time\r\n  sessionIndex int\r\n  startTs      time.Time\r\n}\r\n\r\ntype loadedState struct {\r\n  version       int\r\n  hasMax        bool\r\n  maxTs         time.Time\r\n  seenIds       map[string]bool\r\n  pending       []pendingEntry\r\n  openSessions  map[string]carriedSession\r\n  runIndex      int\r\n  carryPending  int\r\n  carriedOpen   int\r\n}\r\n\r\ntype stateStats struct {\r\n  CarryInPending      int `json:\"carry_in_pending\"`\r\n  CarryOutPending     int `json:\"carry_out_pending\"`\r\n"]
[3575.796034, "o", "  RetiredThisRun      int `json:\"retired_this_run\"`\r\n  TtlDropped          int `json:\"ttl_dropped\"`\r\n  CrossRunDuplicates  int `json:\"cross_run_duplicates\"`\r\n  OpenSessionsCarried int `json:\"open_sessions_carried\"`\r\n  OpenSessionsExtended int `json:\"open_sessions_extended\"`\r\n  OpenSessionsEvicted int `json:\"open_sessions_evicted\"`\r\n  RunIndex            int `json:\"run_index\"`\r\n}\r\n\r\ntype eventTypeStats struct {\r\n  Count    int   `json:\"count\"`\r\n  TotalUSD Money `json:\"total_usd\"`\r\n  AvgUSD   Money `json:\"avg_usd\"`\r\n}\r\n\r\ntype hourStats struct {\r\n"]
[3575.796101, "o", "  Count    int   `json:\"count\"`\r\n  TotalUSD Money `json:\"total_usd\"`\r\n}\r\n\r\ntype sessionsOut struct {\r\n  Total  int            `json:\"total\"`\r\n  ByUser map[string]int `json:\"by_user\"`\r\n}\r\n\r\ntype timeRangeOut struct {\r\n  Start *string `json:\"start\"`\r\n  End   *string `json:\"end\"`\r\n}\r\n\r\ntype anomaliesOut struct {\r\n  Duplicate           int `json:\"duplicate\"`\r\n"]
[3575.796167, "o", "  UnresolvedChargeback int `json:\"unresolved_chargeback\"`\r\n}\r\n\r\ntype summary struct {\r\n  TotalEvents int                        `json:\"total_events\"`\r\n  ByType      map[string]eventTypeStats  `json:\"by_type\"`\r\n  ByHour      map[string]hourStats        `json:\"by_hour\"`\r\n  Sessions    sessionsOut                `json:\"sessions\"`\r\n  TimeRange   timeRangeOut               `json:\"time_range\"`\r\n  Anomalies   anomaliesOut               `json:\"anomalies\"`\r\n  StateStats  *stateStats                `json:\"state_stats,omitempty\"`\r\n}\r\n"]
[3575.796249, "o", "\r\nfunc parseTime(s string) (time.Time, error) {\r\n  t, err := time.Parse(time.RFC3339, s)\r\n  if err != nil {\r\n    return time.Time{}, err\r\n  }\r\n  return t.UTC(), nil\r\n}\r\n\r\nfunc formatTS(t time.Time) string {\r\n  return t.UTC().Format(\"2006-01-02T15:04:05Z\")\r\n}\r\n\r\n"]
[3575.796313, "o", "func hourKey(t time.Time) string {\r\n  return t.UTC().Format(\"2006-01-02T15\")\r\n}\r\n\r\nfunc dateKey(t time.Time) string {\r\n  return t.UTC().Format(\"2006-01-02\")\r\n}\r\n\r\nfunc isDate(s string) bool {\r\n  _, err := time.Parse(\"2006-01-02\", s)\r\n  return err == nil\r\n}\r\n\r\nfunc getString(m map[string]json.RawMessage, keys ...string) (string, bool) {\r\n  for _, k := range keys {\r\n"]
[3575.796376, "o", "    raw, ok := m[k]\r\n    if !ok {\r\n      continue\r\n    }\r\n    var s string\r\n    if err := json.Unmarshal(raw, &s); err == nil {\r\n      return s, true\r\n    }\r\n  }\r\n  return \"\", false\r\n}\r\n\r\nfunc getNumberOrString(raw json.RawMessage) (float64, error) {\r\n  trimmed := bytes.TrimSpace(raw)\r\n"]
[3575.796438, "o", "  if len(trimmed) == 0 {\r\n    return 0, errors.New(\"empty number\")\r\n  }\r\n  if trimmed[0] == '\"' {\r\n    var s string\r\n    if err := json.Unmarshal(trimmed, &s); err != nil {\r\n      return 0, err\r\n"]
[3575.796911, "o", "\u001b[?2004h"]
[3575.796969, "o", "root@n30009:/app# "]
