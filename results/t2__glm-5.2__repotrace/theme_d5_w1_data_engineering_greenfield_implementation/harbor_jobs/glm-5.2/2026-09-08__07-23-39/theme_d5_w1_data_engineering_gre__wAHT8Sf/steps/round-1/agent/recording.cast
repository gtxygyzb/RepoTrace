[11626.808436, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11626.808676, "o", "# Add writeAuditLog and digest helper functions before bucketCode or after run\r\n\u001b[?2004l\r"]
[11626.808732, "o", "\u001b[?2004h> "]
[11626.808802, "o", "if 'func writeAuditLog' not in s:\r\n\u001b[?2004l\r"]
[11626.808856, "o", "\u001b[?2004h> "]
[11626.80891, "o", "    s = s.replace(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11626.809015, "o", "'''type rejectRecord struct {''',\r\n\u001b[?2004l\r"]
[11626.809069, "o", "\u001b[?2004h> "]
[11626.809294, "o", "'''func writeAuditLog(path string, entries []auditLogEntry, rotateBytes int) []string {\r\n\u001b[?2004l\r"]
[11626.809352, "o", "\u001b[?2004h> "]
[11626.809411, "o", "        var segments []string\r\n\u001b[?2004l\r"]
[11626.809465, "o", "\u001b[?2004h> "]
[11626.809529, "o", "        if rotateBytes <= 0 {\r\n\u001b[?2004l\r"]
[11626.809582, "o", "\u001b[?2004h> "]
[11626.809664, "o", "                var buf bytes.Buffer\r\n\u001b[?2004l\r"]
[11626.809717, "o", "\u001b[?2004h> "]
[11626.809819, "o", "                for _, e := range entries {\r\n\u001b[?2004l\r"]
[11626.809872, "o", "\u001b[?2004h> "]
[11626.809989, "o", "                        b, err := json.Marshal(e)\r\n\u001b[?2004l\r"]
[11626.810043, "o", "\u001b[?2004h> "]
[11626.810134, "o", "                        if err != nil {\r\n\u001b[?2004l\r"]
[11626.810188, "o", "\u001b[?2004h> "]
[11626.810294, "o", "                                panic(err)\r\n\u001b[?2004l\r"]
[11626.810348, "o", "\u001b[?2004h> "]
[11626.810406, "o", "                        }\r\n\u001b[?2004l\r"]
[11626.810468, "o", "\u001b[?2004h> "]
[11626.81056, "o", "                        buf.Write(b)\r\n\u001b[?2004l\r"]
[11626.810614, "o", "\u001b[?2004h> "]
[11626.810725, "o", "                        buf.WriteByte('\\n')\r\n\u001b[?2004l\r"]
[11626.810779, "o", "\u001b[?2004h> "]
[11626.810834, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11626.811049, "o", "                if err := atomicWriteFile(path, buf.Bytes()); err != nil {\r\n\u001b[?2004l\r"]
[11626.811103, "o", "\u001b[?2004h> "]
[11626.811179, "o", "                        panic(err)\r\n\u001b[?2004l\r"]
[11626.811242, "o", "\u001b[?2004h> "]
[11626.811296, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11626.811404, "o", "                return []string{path}\r\n\u001b[?2004l\r"]
[11626.811458, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[11626.811513, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11626.811598, "o", "        current := path\r\n\u001b[?2004l\r"]
[11626.811653, "o", "\u001b[?2004h> "]
[11626.811713, "o", "        var buf bytes.Buffer\r\n\u001b[?2004l\r"]
[11626.811768, "o", "\u001b[?2004h> "]
[11626.811821, "o", "        flush := func() {\r\n\u001b[?2004l\r"]
[11626.811875, "o", "\u001b[?2004h> "]
[11626.812067, "o", "                if err := atomicWriteFile(current, buf.Bytes()); err != nil {\r\n\u001b[?2004l\r"]
[11626.812123, "o", "\u001b[?2004h> "]
[11626.812204, "o", "                        panic(err)\r\n\u001b[?2004l\r"]
[11626.812259, "o", "\u001b[?2004h> "]
[11626.812314, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11626.812464, "o", "                segments = append(segments, current)\r\n\u001b[?2004l\r"]
[11626.812518, "o", "\u001b[?2004h> "]
[11626.812575, "o", "                buf.Reset()\r\n\u001b[?2004l\r"]
[11626.81263, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[11626.812684, "o", "\u001b[?2004h> "]
[11626.812769, "o", "        for _, e := range entries {\r\n\u001b[?2004l\r"]
[11626.812824, "o", "\u001b[?2004h> "]
[11626.812919, "o", "                b, err := json.Marshal(e)\r\n\u001b[?2004l\r"]
[11626.812975, "o", "\u001b[?2004h> "]
[11626.813044, "o", "                if err != nil {\r\n\u001b[?2004l\r"]
[11626.813103, "o", "\u001b[?2004h> "]
[11626.813175, "o", "                        panic(err)\r\n\u001b[?2004l\r"]
[11626.813242, "o", "\u001b[?2004h> "]
[11626.813296, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11626.813417, "o", "                rec := append(b, '\\n')\r\n\u001b[?2004l\r"]
[11626.813472, "o", "\u001b[?2004h> "]
[11626.813648, "o", "                if buf.Len() > 0 && buf.Len()+len(rec) > rotateBytes {\r\n\u001b[?2004l\r"]
[11626.813705, "o", "\u001b[?2004h> "]
[11626.813768, "o", "                        flush()\r\n\u001b[?2004l\r"]
[11626.813822, "o", "\u001b[?2004h> "]
[11626.814012, "o", "                        current = fmt.Sprintf(\"%s.%d\", path, len(segments))\r\n\u001b[?2004l\r"]
