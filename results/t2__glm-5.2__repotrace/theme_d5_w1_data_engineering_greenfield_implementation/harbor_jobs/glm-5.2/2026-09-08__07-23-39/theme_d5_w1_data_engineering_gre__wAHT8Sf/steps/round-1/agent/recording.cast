[14568.780344, "o", "\t\t\t}\r\n   175\t\t\tif strings.HasPrefix(arg, \"--\") && arg != \"--rates-strict\" && arg != \"--strict-late-audit\" && arg != \"--state-strict\" {\r\n   176\t\t\t\tif _, ok := required[arg]; ok {\r\n   177\t\t\t\t\trequired[arg] = true"]
