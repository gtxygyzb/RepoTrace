[10866.26978, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"time\"\r\n"]
[10866.269861, "o", ")\r\n\r\ntype rawJSON json.RawMessage\r\n\r\nfunc (r rawJSON) MarshalJSON() ([]byte, error) {\r\n\tif json.Valid(r) {\r\n\t\treturn r, nil\r\n\t}\r\n\treturn json.Marshal(string(r))\r\n}\r\n\r\ntype rawEvent struct {\r\n\tShard   string\r\n\tLine    int\r\n\tRaw     rawJSON\r\n\tObj     map[string]json.RawMessage\r\n\tInvalid bool\r\n"]
[10866.269942, "o", "}\r\n\r\ntype eventContext struct {\r\n\tShard string\r\n\tLine  int\r\n\tRaw   rawJSON\r\n\tObj   map[string]json.RawMessage\r\n\tID    *string\r\n\tTS    *string\r\n\tType  *string\r\n}\r\n\r\ntype inputShardInfo struct {\r\n\tName           string\r\n\tBytes          int64\r\n"]
[10866.270015, "o", "\tSHA256         string\r\n\tEventsTotal    int\r\n\tEventsAccepted int\r\n}\r\n\r\ntype loadedState struct {\r\n\tversion             int\r\n"]
[10866.270082, "o", "\thasMax              bool\r\n\tmaxTs               time.Time\r\n\tseenIds             map[string]bool\r\n\tpending             []pendingEntry\r\n\topenSessions        map[string]carriedSession\r\n\trunIndex            int\r\n\tcarryInPending      int\r\n\tcarryInOpenSessions int\r\n}\r\n\r\ntype pendingEntry struct {\r\n\tid        string\r\n\tts        time.Time\r\n\tuser      string\r\n\tusd       float64\r\n\toriginRun int\r\n}\r\n\r\ntype carriedSession struct {\r\n\tuser         string\r\n\tlastTs       time.Time\r\n"]
[10866.270151, "o", "\tsessionIndex int\r\n\tstartTs      time.Time\r\n}\r\n\r\ntype stateWatermarkOut struct {\r\n\tMaxTS *string `json:\"max_ts\"`\r\n}\r\n\r\ntype stateFileOut struct {\r\n\tVersion          int                   `json:\"version\"`\r\n\tWatermark        stateWatermarkOut     `json:\"watermark\"`\r\n\tSeenIDs          []string              `json:\"seen_ids\"`\r\n\tPendingPurchases []statePendingOut     `json:\"pending_purchases\"`\r\n"]
[10866.270248, "o", "\tOpenSessions     []stateOpenSessionOut `json:\"open_sessions\"`\r\n\tRunIndex         int                   `json:\"run_index\"`\r\n}\r\n\r\ntype statePendingOut struct {\r\n\tID        string `json:\"id\"`\r\n\tTS        string `json:\"ts\"`\r\n\tUser      string `json:\"user\"`\r\n\tUSD       Money  `json:\"usd\"`\r\n\tOriginRun int    `json:\"origin_run\"`\r\n}\r\n\r\ntype stateOpenSessionOut struct {\r\n\tUser         string `json:\"user\"`\r\n"]
[10866.27031, "o", "\tLastTS       string `json:\"last_ts\"`\r\n\tSessionIndex int    `json:\"session_index\"`\r\n\tStartTS      string `json:\"start_ts\"`\r\n}\r\n\r\ntype summaryOutput struct {\r\n\tTotalEvents    int            `json:\"total_events\"`\r\n\tAcceptedEvents int            `json:\"accepted_events\"`\r\n\tRejectedEvents int            `json:\"rejected_events\"`\r\n\tTotalUSD       Money          `json:\"total_usd\"`\r\n\tAnomalies      map[string]int `json:\"anomalies\"`\r\n\tRunIndex       int            `json:\"run_index\"`\r\n\tWatermark      *string        `json:\"watermark\"`\r\n"]
[10866.270367, "o", "}\r\n\r\ntype auditLogEntry struct {\r\n\tShard         string         `json:\"shard\"`\r\n\tLine          int            `json:\"line\"`\r\n\tID            string         `json:\"id\"`\r\n\tTS            string         `json:\"ts\"`\r\n\tType          string         `json:\"type\"`\r\n\tBucket        string         `json:\"bucket\"`\r\n"]
[10866.270434, "o", "\tReason        string         `json:\"reason\"`\r\n\tWinnerArrival *winnerArrival `json:\"winner_arrival,omitempty\"`\r\n\tEvent         rawJSON        `json:\"event\"`\r\n}\r\n\r\ntype winnerArrival struct {\r\n\t"]
[10866.270495, "o", "Shard string `json:\"shard\"`\r\n\tLine  int    `json:\"line\"`\r\n}\r\n\r\ntype dedupPolicyStats struct {\r\n\tPolicy                       string `json:\"policy\"`\r\n\tDuplicateWinnersSameShard    int    `json:\"duplicate_winners_same_shard\"`\r\n\tDuplicateWinnersCrossShard   int    `json:\"duplicate_winners_cross_shard\"`\r\n\tDuplicateWinnersLineTiebreak int    `json:\"duplicate_winners_line_tiebreak\"`\r\n}\r\n\r\ntype auditDigestOutput struct {\r\n\tSchemaVersion    string            `json:\"schema_version\"`\r\n\tAuditLog         string            `json:\"audit_log\"`\r\n\tTotalRecords     int               `json:\"total_records\"`\r\n\tBucketCounts     map[string]int    `json:\"bucket_counts\"`\r\n\tInvalidReasons   map[string]int    `json:\"invalid_reasons\"`\r\n"]
[10866.270569, "o", "\tDuplicateReasons map[string]int    `json:\"duplicate_reasons\"`\r\n\tResolvedAgainst  string            `json:\"resolved_against\"`\r\n\tDedupPolicyStats *dedupPolicyStats `json:\"dedup_policy_stats,omitempty\"`\r\n\tFXFallbackStats  map[string]int    `json:\"fx_fallback_stats\"`\r\n\tRatesDigest      string            `json:\"rates_digest\"`\r\n\tSHA256           string            `json:\"sha256\"`\r\n}\r\n\r\ntype manifestOutput struct {\r\n\tSchemaVersion string          `json:\"schema_version\"`\r\n\tIngestID      *string         `json:\"ingest_id\"`\r\n"]
[10866.27063, "o", "\tRunIndex      int             `json:\"run_index\"`\r\n\tRatesDigest   string          `json:\"rates_digest\"`\r\n\tInputShards   []manifestShard `json:\"input_shards\"`\r\n\tOutputs       manifestOutputs `json:\"outputs\"`\r\n\tWindow        manifestWindow  `json:\"window\"`\r\n}\r\n\r\ntype manifestShard struct {\r\n\tShard          string `json:\"shard\"`\r\n\tSHA256         string `json:\"sha256\"`\r\n\t"]
[10866.270694, "o", "Bytes          int64  `json:\"bytes\"`\r\n\tEventsTotal    int    `json:\"events_total\"`\r\n\tEventsAccepted int    `json:\"events_accepted\"`\r\n}\r\n\r\ntype manifestFileOutput struct {\r\n\tPath        string `json:\"path\"`\r\n\tSHA256      string `json:\"sha256\"`\r\n\tSHA256Short string `json:\"sha256_short\"`\r\n\tBytes       int64  `json:\"bytes\"`\r\n}\r\n"]
[10866.270752, "o", "\r\ntype manifestOutputs struct {\r\n\tSummary     *manifestFileOutput `json:\"summary\"`\r\n\tRejects     *manifestFileOutput `json:\"rejects\"`\r\n\tState       *manifestFileOutput `json:\"state\"`\r\n\tAuditLog    *manifestFileOutput `json:\"audit_log\"`\r\n\tAuditDigest *manifestFileOutput `json:\"audit_digest\"`\r\n}\r\n\r\ntype manifestWindow struct {\r\n\tMinTs               *string        `json:\"min_ts\"`\r\n"]
[10866.270812, "o", "\tMaxTs               *string        `json:\"max_ts\"`\r\n\tEventsAcceptedTotal int            `json:\"events_accepted_total\"`\r\n\tEventsRejectedTotal int            `json:\"events_rejected_total\"`\r\n\tBucketCounts        map[string]int `json:\"bucket_counts\"`\r\n}\r\n\r\ntype signatureOutput struct {\r\n\tManifestPath   string `json:\"manifest_path\"`\r\n\tManifestSHA256 string `json:\"manifest_sha256\"`\r\n\tManifestBytes  int64  `json:\"manifest_bytes\"`\r\n"]
[10866.270868, "o", "\tSignedAtUTC    string `json:\"signed_at_utc\"`\r\n\tToolVersion    string `json:\"tool_version\"`\r\n}\r\n\r\nconst toolVersion = \"eventq/0.5.0\"\r\nconst manifestSchemaVersion = \"eventq.manifest/v1\"\r\n"]
