   163				buf.WriteByte(',')
   164			}
   165			buf.WriteByte('\n')
   166		}
   167		writeIndent(buf, indent)
   168		buf.WriteByte(']')
   169	}
   170	
   171	func writeIndent(buf *bytes.Buffer, indent int) {
   172		for i := 0; i < indent; i++ {
   173			buf.WriteString("  ")
   174		}
   175	}
