   401	func parentDirExists(path string) bool {
   402	  dir := filepath.Dir(path)
   403	  if dir == "." {
   404	    return true
   405	  }
   406	  info, err := os.Stat(dir)
   407	  return err == nil && info.IsDir()
   408	}
   409	
   410	func parseNonNegInt(s string) (int, error) {
   411	  n, err := strconv.Atoi(s)
   412	  if err != nil {
   413	    return 0, err
   414	  }
   415	  if n < 0 {
   416	    return 0, errors.New("negative")
   417	  }
   418	  return n, nil
   419	}
   420	
   421	func atomicWriteFile(path string, data []byte) error {
   422	  tmp := path + ".tmp"
   423	  if err := os.WriteFile(tmp, data, 0644); err != nil {
   424	    os.Remove(tmp)
   425	    return err
   426	  }
   427	  if err := os.Rename(tmp, path); err != nil {
   428	    os.Remove(tmp)
   429	    return err
   430	  }
   431	  return nil
   432	}
