   164			}
   165			if cfg.auditLogRotateBytes < 4096 {
   166				return cliConfig{}, fmt.Errorf("ingest: --audit-log-rotate-bytes: must be a positive integer >= 4096")
   167			}
   168		}
   169		if cfg.dedupPolicy == "" {
   170			cfg.dedupPolicy = "lex-largest-ts"
   171		}
   172		return cfg, nil
   173	}
