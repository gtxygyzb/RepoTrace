   144	func (e auditLogEntry) MarshalJSON() ([]byte, error) {
   145		if e.Bucket == "late" {
   146			var buf bytes.Buffer
   147			buf.WriteString(`{"id":`)
   148			b, err := json.Marshal(e.ID)
   149			if err != nil {
   150				return nil, err
   151			}
   152			buf.Write(b)
   153			buf.WriteString(`,"ts":`)
   154			b, err = json.Marshal(e.TS)
   155			if err != nil {
   156				return nil, err
   157			}
   158			buf.Write(b)
   159			buf.WriteString(`,"type":`)
   160			b, err = json.Marshal(e.Type)
   161			if err != nil {
   162				return nil, err
   163			}
   164			buf.Write(b)
   165			buf.WriteString(`,"shard":`)
   166			b, err = json.Marshal(e.Shard)
   167			if err != nil {
   168				return nil, err
   169			}
   170			buf.Write(b)
   171			buf.WriteString(`,"line":`)
   172			b, err = json.Marshal(e.Line)
   173			if err != nil {
   174				return nil, err
   175			}
   176			buf.Write(b)
   177			buf.WriteString(`,"bucket":`)
   178			b, err = json.Marshal(e.Bucket)
   179			if err != nil {
   180				return nil, err
   181			}
   182			buf.Write(b)
   183			buf.WriteString(`,"cutoff":`)
   184			if e.Cutoff != nil {
   185				b, err = json.Marshal(e.Cutoff)
   186				if err != nil {
   187					return nil, err
   188				}
   189			} else {
   190				b = []byte("null")
   191			}
   192			buf.Write(b)
   193			if e.WatermarkLagSeconds != nil {
   194				buf.WriteString(`,"watermark_lag_seconds":`)
   195				b, err = json.Marshal(*e.WatermarkLagSeconds)
   196				if err != nil {
   197					return nil, err
   198				}
   199				buf.Write(b)
   200			}
   201			if e.LateBySeconds != nil {
   202				buf.WriteString(`,"late_by_seconds":`)
   203				b, err = json.Marshal(*e.LateBySeconds)
   204				if err != nil {
   205					return nil, err
   206				}
   207				buf.Write(b)
   208			}
   209			buf.WriteByte('}')
   210			return buf.Bytes(), nil
   211		}
   212		type alias auditLogEntry
   213		return json.Marshal(alias(e))
   214	}
