   338				}
   339			}
   340			if sameShard {
   341				dedupPolicyStats.DuplicateWinnersSameShard++
   342				if cfg.dedupPolicy == "first-arrival" || tiebreak {
   343					dedupPolicyStats.DuplicateWinnersLineTiebreak++
   344				}
   345			} else {
   346				dedupPolicyStats.DuplicateWinnersCrossShard++
   347			}
   348		}
   349	
   350		// Finalize accepted/duplicate buckets and outputs in arrival order.
   351		hasMin, hasMax = false, false
   352		for _, c := range candidates {
   353			if c.ev != nil {
   354				seen[c.ev.ID] = true
   355			}
   356		}
   357		bucketCounts["accepted"] = 0
   358		bucketCounts["duplicate"] = duplicateReasons["cross_run"]
   359		for i, c := range candidates {
   360			_ = i
   361			if c.ev == nil {
   362				continue
   363			}
   364			if winnerSet[i] {
   365				bucketCounts["accepted"]++
   366				shardAccepted[c.ev.Shard]++
   367				if !hasMin || c.ev.TS.Before(minTs) {
   368					minTs = c.ev.TS
   369					hasMin = true
   370				}
   371				if !hasMax || c.ev.TS.After(maxTs) {
   372					maxTs = c.ev.TS
   373					hasMax = true
   374				}
   375				_ = pending
   376				_ = openSessions
   377			} else {
   378				bucketCounts["duplicate"]++
   379				duplicateReasons["same_run"]++
   380				entry := auditEntries[i]
   381				entry.Bucket = "duplicate"
   382				entry.Reason = "same_run"
   383				if cfg.dedupPolicy == "first-arrival" {
   384					w := winners[entry.ID]
   385					entry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}
   386				}
   387				auditEntries[i] = entry
   388			}
   389		}
   390	
   391		var rejectRecords []rejectRecord
   392		for i, c := range candidates {
   393			if c.ev == nil {
   394				r := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, raw: c.raw.Raw}
   395				rejectRecords = append(rejectRecords, r)
   396				continue
   397			}
   398			if winnerSet[i] {
   399				continue
   400			}
   401			r := rejectRecord{bucket: "duplicate", reason: "same_run", raw: c.raw.Raw}
   402			if cfg.dedupPolicy == "first-arrival" {
   403				r.winner = true
   404				r.winnerShard = candidates[winners[c.ev.ID]].ev.Shard
   405				r.winnerLine = candidates[winners[c.ev.ID]].ev.Line
   406			}
   407			rejectRecords = append(rejectRecords, r)
   408		}
   409	
   410		summary := summaryOutput{
   411			TotalEvents:    len(events),
   412			AcceptedEvents: bucketCounts["accepted"],
   413			RejectedEvents: bucketCounts["duplicate"] + bucketCounts["invalid"] + bucketCounts["late"] + bucketCounts["unresolved_chargeback"],
   414			Anomalies: map[string]int{
   415				"duplicate":             bucketCounts["duplicate"],
   416				"invalid":               bucketCounts["invalid"],
   417				"late":                  bucketCounts["late"],
   418				"unresolved_chargeback": bucketCounts["unresolved_chargeback"],
   419			},
   420			RunIndex: runIndex,
   421		}
   422		if hasWatermark {
   423			wm := formatTS(watermark)
   424			summary.Watermark = &wm
   425		}
   426		summaryData, err := json.MarshalIndent(summary, "", "  ")
   427		if err != nil {
   428			return err
   429		}
   430		summaryData = append(summaryData, '\n')
   431		if err := atomicWriteFile(cfg.outputPath, summaryData); err != nil {
   432			return err
   433		}
   434		rejectsData := buildRejects(rejectRecords, cfg.dedupPolicy)
   435		if err := atomicWriteFile(cfg.rejectsPath, rejectsData); err != nil {
   436			return err
   437		}
   438		if cfg.stateOut != "" {
   439			stateData := buildStateOut(watermark, hasWatermark, st, sortedSeenIDs(seen), sortedPending(pending), sortedOpenSessions(openSessions), runIndex)
   440			if err := atomicWriteFile(cfg.stateOut, stateData); err != nil {
   441				return err
   442			}
   443		}
   444		if cfg.auditLog != "" {
   445			var buf bytes.Buffer
   446			for _, e := range auditEntries {
   447				b, err := json.Marshal(e)
   448				if err != nil {
   449					return err
   450				}
   451				buf.Write(b)
   452				buf.WriteByte('\n')
   453			}
   454			if err := atomicWriteFile(cfg.auditLog, buf.Bytes()); err != nil {
   455				return err
   456			}
   457		}
   458		if cfg.auditLogDigest != "" {
   459			var auditLogPath string
   460			if cfg.auditLog != "" {
   461				auditLogPath = filepath.Base(cfg.auditLog)
   462			}
   463			var auditSHA string
   464			if cfg.auditLog != "" {
   465				h, _, err := fileDigest(cfg.auditLog)
   466				if err != nil {
   467					return err
   468				}
   469				auditSHA = h
   470			}
   471			digest := auditDigestOutput{
   472				SchemaVersion:    "eventq.digest/v1",
   473				AuditLog:         auditLogPath,
   474				TotalRecords:     len(auditEntries),
   475				BucketCounts:     bucketCounts,
   476				InvalidReasons:   invalidReasons,
   477				DuplicateReasons: duplicateReasons,
   478				ResolvedAgainst:  "state",
   479				FXFallbackStats:  fxFallbackStats,
   480				RatesDigest:      ratesDigest,
   481				SHA256:           auditSHA,
   482			}
   483			if cfg.dedupPolicySet {
   484				digest.DedupPolicyStats = &dedupPolicyStats
   485			}
   486			data, err := json.MarshalIndent(digest, "", "  ")
   487			if err != nil {
   488				return err
   489			}
   490			data = append(data, '\n')
   491			if err := atomicWriteFile(cfg.auditLogDigest, data); err != nil {
   492				return err
   493			}
   494		}
   495		if cfg.outManifest != "" {
   496			manifest, err := buildManifest(cfg, runIndex, ratesDigest, shards, shardAccepted, bucketCounts, hasMin, minTs, hasMax, maxTs)
   497			if err != nil {
   498				return err
   499			}
   500			manifestData, err := writeManifest(cfg.outManifest, manifest)
   501			if err != nil {
   502				return err
   503			}
   504			if cfg.manifestSignature != "" {
   505				var maxPtr *string
   506				if manifest.Window.MaxTs != nil {
   507					maxPtr = manifest.Window.MaxTs
   508				}
   509				if err := writeSignature(cfg.manifestSignature, cfg.outManifest, manifestData, maxPtr); err != nil {
   510					return err
   511				}
   512			}
   513		}
   514		return nil
   515	}
