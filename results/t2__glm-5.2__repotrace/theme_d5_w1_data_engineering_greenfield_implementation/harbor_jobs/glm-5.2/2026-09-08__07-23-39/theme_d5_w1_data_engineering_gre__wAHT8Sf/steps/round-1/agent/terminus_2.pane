   428	func loadState(path string) (*loadedState, error) {
   429		data, err := os.ReadFile(path)
   430		if err != nil {
   431			return nil, err
   432		}
   433		var sin stateFileIn
   434		if err := json.Unmarshal(data, &sin); err != nil {
   435			return nil, err
   436		}
   437		st := &loadedState{
   438			version:      sin.Version,
   439			seenIds:      map[string]bool{},
   440			runIndex:     sin.RunIndex,
   441			openSessions: map[string]carriedSession{},
   442		}
   443		if sin.Watermark.MaxTS != nil {
   444			t, err := parseTime(*sin.Watermark.MaxTS)
   445			if err != nil {
   446				return nil, fmt.Errorf("bad state watermark: %w", err)
   447			}
   448			st.hasMax = true
   449			st.maxTs = t
   450		}
   451		for _, id := range sin.SeenIDs {
   452			st.seenIds[id] = true
   453		}
   454		for _, p := range sin.PendingPurchases {
   455			t, err := parseTime(p.TS)
   456			if err != nil {
   457				return nil, fmt.Errorf("bad pending purchase ts: %w", err)
   458			}
   459			st.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, user: p.User, usd: float64(p.USD), originRun: p.OriginRun})
   460		}
   461		for _, s := range sin.OpenSessions {
   462			last, err := parseTime(s.LastTS)
   463			if err != nil {
   464				return nil, fmt.Errorf("bad open session last_ts: %w", err)
   465			}
   466			start, err := parseTime(s.StartTS)
   467			if err != nil {
   468				return nil, fmt.Errorf("bad open session start_ts: %w", err)
   469			}
   470			st.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}
   471		}
   472		st.carryInPending = len(st.pending)
   473		st.carryInOpenSessions = len(st.openSessions)
   474		return st, nil
   475	}
