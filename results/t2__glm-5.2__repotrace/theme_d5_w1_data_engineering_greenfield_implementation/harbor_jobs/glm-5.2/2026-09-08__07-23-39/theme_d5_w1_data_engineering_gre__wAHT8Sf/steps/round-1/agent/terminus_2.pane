   465	func computeObservedTimeRange(events []rawEvent) (string, string, bool) {
   466		hasMin := false
   467		hasMax := false
   468		var min, max string
   469		for _, raw := range events {
   470			if raw.Invalid || raw.Blank || raw.Obj == nil {
   471				continue
   472			}
   473			ts, ok, _ := getRawString(raw.Obj, "ts")
   474			if !ok || !isExactRFC3339UTC(ts) {
   475				continue
   476			}
   477			if !hasMin || ts < min {
   478				min = ts
   479				hasMin = true
   480			}
   481			if !hasMax || ts > max {
   482				max = ts
   483				hasMax = true
   484			}
   485		}
   486		return min, max, hasMin && hasMax
   487	}
