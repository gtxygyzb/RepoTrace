   252						ev = nil
   253					} else {
   254						bucket = "accepted"
   255						if ev.TS.After(watermark) {
   256							watermark = ev.TS
   257							hasWatermark = true
   258						}
   259					}
   260				} else {
   261					bucket = "invalid"
   262				}
   263			}
   264			if bucket == "invalid" {
   265				invalidReasons[reason]++
   266			}
   267			bucketCounts[bucket]++
   268			if bucket == "duplicate" && reason == "cross_run" {
   269				duplicateReasons["cross_run"]++
   270			}
   271			candidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})
   272			auditEntries = append(auditEntries, auditLogEntry{
   273				Shard:  raw.Shard,
   274				Line:   raw.Line,
   275				ID:     ctx.IDStr(),
   276				TS:     ctx.TSString(),
   277				Type:   ctx.TypeString(),
   278				Bucket: bucket,
   279				Reason: reason,
   280				Event:  raw.Raw,
   281			})
   282		}
   283	
   284		// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.
   285		groups := map[string][]int{}
