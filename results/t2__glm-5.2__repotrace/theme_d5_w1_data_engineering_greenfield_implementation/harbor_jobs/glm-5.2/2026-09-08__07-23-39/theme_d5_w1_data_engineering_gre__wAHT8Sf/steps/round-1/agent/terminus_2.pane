   247						reason = "cross_run"
   248						ev = nil
   249					} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {
   250						bucket = "late"
   251						reason = "late"
   252						ev = nil
   253					} else {
   254						bucket = "accepted"
   255						if ev.TS.After(watermark) {
   256							watermark = ev.TS
   257							hasWatermark = true
   258						}
   259					}
   260				} else {
   261					bucket = "invalid"
   262				}
   263			}
   264			if bucket == "invalid" {
   265				invalidReasons[reason]++
   266			}
   267			bucketCounts[bucket]++
   268			if bucket == "duplicate" && reason == "cross_run" {
   269				duplicateReasons["cross_run"]++
   270			}
   271			candidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})
   272			auditEntries = append(auditEntries, auditLogEntry{
