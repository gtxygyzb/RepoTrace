func ptrCutoff(c cutoffObject) *cutoffObject {
	return &c
}

func run(cfg cliConfig) error {
	ratesData, err := os.ReadFile(cfg.ratesPath)
	if err != nil {
		return fmt.Errorf("ingest: rates: %w", err)
	}
	ratesDigest := sha256Hex(ratesData)
	rt, err := loadRates(cfg.ratesPath)
	if err != nil {
		return err
	}
	var st *loadedState
	runIndex := 1
	if cfg.stateIn != "" {
		st, err = loadState(cfg.stateIn, cfg.stateStrict)
		if err != nil && !os.IsNotExist(err) {
			return err
		}
		if st != nil {
			runIndex = st.runIndex + 1
		}
	}
	events, shards, err := readInputEvents(cfg.inputDir)
	if err != nil {
		return err
	}
	seen := map[string]bool{}
	if st != nil {
		for k, v := range st.seenIds {
			seen[k] = v
		}
	}
	var pending []pendingEntry
	openSessions := map[string]carriedSession{}
	if st != nil {
		pending = append([]pendingEntry(nil), st.pending...)
		for k, v := range st.openSessions {
			openSessions[k] = v
		}
	}
	bucketCounts := map[string]int{"accepted": 0, "duplicate": 0, "invalid": 0, "late": 0, "unresolved_chargeback": 0}
	invalidReasons := map[string]int{}
	duplicateReasons := map[string]int{"same_run": 0, "cross_run": 0}
	fxFallbackStats := map[string]int{"0": 0}
	shardAccepted := map[string]int{}
	var minTs, maxTs time.Time
	hasMin, hasMax := false, false
	var watermark time.Time
	hasWatermark := false
	if st != nil {
		watermark = st.maxTs
		hasWatermark = st.hasMax
	}

	type candidate struct {
		raw       rawEvent
		ctx       *eventContext
		ev        *Event
		duplicate bool
	}
	var candidates []candidate
	var auditEntries []auditLogEntry

	// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.
	for _, raw := range events {
		ctx := newContext(raw)
		bucket := "invalid"
		reason := ""
		var ev *Event
		if raw.Invalid {
			bucket = "invalid"
			reason = "invalid_json"
		} else {
			ev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)
			if ev != nil {
				if seen[ev.ID] {
					bucket = "duplicate"
					reason = "cross_run"
					ev = nil
				} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {
					bucket = "late"
					reason = "late"
					cutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)
					entry := auditLogEntry{
						Shard:  raw.Shard,
						Line:   raw.Line,
						ID:     ctx.IDStr(),
						TS:     ctx.TSString(),
						Type:   ctx.TypeString(),
						Bucket: bucket,
						Cutoff: ptrCutoff(formatCutoffObject(cutoff)),
					}
					if cfg.strictLateAudit {
						lag := cfg.watermarkLag
						lateBy := int(entry.Cutoff.EpochSeconds - int(epochSeconds(ev.TS)))
						entry.WatermarkLagSeconds = &lag
						entry.LateBySeconds = &lateBy
					}
					auditEntries = append(auditEntries, entry)
					ev = nil
				} else {
					bucket = "accepted"
					if ev.TS.After(watermark) {
						watermark = ev.TS
						hasWatermark = true
					}
				}
			} else {
				bucket = "invalid"
			}
		}
		if bucket == "invalid" {
			invalidReasons[reason]++
		}
		bucketCounts[bucket]++
		if bucket == "duplicate" && reason == "cross_run" {
			duplicateReasons["cross_run"]++
		}
		candidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})
		auditEntries = append(auditEntries, auditLogEntry{
			Shard:  raw.Shard,
			Line:   raw.Line,
			ID:     ctx.IDStr(),
			TS:     ctx.TSString(),
			Type:   ctx.TypeString(),
			Bucket: bucket,
			Reason: reason,
			Event:  raw.Raw,
		})
	}

	// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.
	groups := map[string][]int{}
	for i, c := range candidates {
		if c.ev != nil {
			groups[c.ev.ID] = append(groups[c.ev.ID], i)
		}
	}
	winnerSet := map[int]bool{}
	winners := map[string]int{}
	var dedupPolicyStats dedupPolicyStats
	dedupPolicyStats.Policy = cfg.dedupPolicy
	for id, idxs := range groups {
		if len(idxs) < 2 {
			if len(idxs) == 1 {
				winners[id] = idxs[0]
				winnerSet[idxs[0]] = true
			}
			continue
		}
		winner := idxs[0]
		tiebreak := false
		for _, idx := range idxs[1:] {
			if cfg.dedupPolicy == "first-arrival" {
				if arrivalLess(candidates[idx].ev, candidates[winner].ev) {
					winner = idx
				}
			} else {
				cts := candidates[idx].ctx.TSString()
				wts := candidates[winner].ctx.TSString()
				if cts > wts {
					winner = idx
					tiebreak = false
				} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {
					winner = idx
					tiebreak = true
				}
			}
		}
		if cfg.dedupPolicy == "lex-largest-ts" {
			wts := candidates[winner].ctx.TSString()
			for _, idx := range idxs {
				if idx != winner && candidates[idx].ctx.TSString() == wts {
					tiebreak = true
					break
				}
			}
		}
		winners[id] = winner
		winnerSet[winner] = true
		sameShard := true
		for _, idx := range idxs {
			if candidates[idx].ev.Shard != candidates[winner].ev.Shard {
				sameShard = false
				break
			}
		}
[?2004hroot@n30009:/app# sed -n '380,620p' cli.go
[?2004l		}
		if sameShard {
			dedupPolicyStats.DuplicateWinnersSameShard++
			if cfg.dedupPolicy == "first-arrival" || tiebreak {
				dedupPolicyStats.DuplicateWinnersLineTiebreak++
			}
		} else {
			dedupPolicyStats.DuplicateWinnersCrossShard++
		}
	}

	// Finalize accepted/duplicate buckets and outputs in arrival order.
	hasMin, hasMax = false, false
	for _, c := range candidates {
		if c.ev != nil {
			seen[c.ev.ID] = true
		}
	}
	bucketCounts["accepted"] = 0
	bucketCounts["duplicate"] = duplicateReasons["cross_run"]
	for i, c := range candidates {
		_ = i
		if c.ev == nil {
			continue
		}
		if winnerSet[i] {
			bucketCounts["accepted"]++
			shardAccepted[c.ev.Shard]++
			if !hasMin || c.ev.TS.Before(minTs) {
				minTs = c.ev.TS
				hasMin = true
			}
			if !hasMax || c.ev.TS.After(maxTs) {
				maxTs = c.ev.TS
				hasMax = true
			}
			_ = pending
			_ = openSessions
		} else {
			bucketCounts["duplicate"]++
			duplicateReasons["same_run"]++
			entry := auditEntries[i]
			entry.Bucket = "duplicate"
			entry.Reason = "same_run"
			if cfg.dedupPolicy == "first-arrival" {
				w := winners[entry.ID]
				entry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}
			}
			auditEntries[i] = entry
		}
	}

	var rejectRecords []rejectRecord
	for i, c := range candidates {
		if c.ev == nil {
			r := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, raw: c.raw.Raw}
			rejectRecords = append(rejectRecords, r)
			continue
		}
		if winnerSet[i] {
			continue
		}
		r := rejectRecord{bucket: "duplicate", reason: "same_run", raw: c.raw.Raw}
		if cfg.dedupPolicy == "first-arrival" {
			r.winner = true
			r.winnerShard = candidates[winners[c.ev.ID]].ev.Shard
			r.winnerLine = candidates[winners[c.ev.ID]].ev.Line
		}
		rejectRecords = append(rejectRecords, r)
	}

	summary := summaryOutput{
		TotalEvents:    len(events),
		AcceptedEvents: bucketCounts["accepted"],
		RejectedEvents: bucketCounts["duplicate"] + bucketCounts["invalid"] + bucketCounts["late"] + bucketCounts["unresolved_chargeback"],
		Anomalies: map[string]int{
			"duplicate":             bucketCounts["duplicate"],
			"invalid":               bucketCounts["invalid"],
			"late":                  bucketCounts["late"],
			"unresolved_chargeback": bucketCounts["unresolved_chargeback"],
		},
		RunIndex: runIndex,
	}
	if hasWatermark {
		wm := formatTS(watermark)
		summary.Watermark = &wm
	}
	summaryData, err := json.MarshalIndent(summary, "", "  ")
	if err != nil {
		return err
	}
	summaryData = append(summaryData, '\n')
	if err := atomicWriteFile(cfg.outputPath, summaryData); err != nil {
		return err
	}
	rejectsData := buildRejects(rejectRecords, cfg.dedupPolicy)
	if err := atomicWriteFile(cfg.rejectsPath, rejectsData); err != nil {
		return err
	}
	if cfg.stateOut != "" {
		stateData := buildStateOut(watermark, hasWatermark, st, sortedSeenIDs(seen), sortedPending(pending), sortedOpenSessions(openSessions), runIndex)
		if err := atomicWriteFile(cfg.stateOut, stateData); err != nil {
			return err
		}
	}
	var auditSegmentPaths []string
	if cfg.auditLog != "" {
		auditSegmentPaths = writeAuditLog(cfg.auditLog, auditEntries, cfg.auditLogRotateBytes)
	}
	if cfg.auditLogDigest != "" {
		digest := auditDigestOutput{
			SchemaVersion:    "eventq.digest/v1",
			TotalRecords:     len(auditEntries),
			BucketCounts:     bucketCounts,
			InvalidReasons:   invalidReasons,
			DuplicateReasons: duplicateReasons,
			LateCutoffStats:  computeLateCutoffStats(auditEntries),
			ResolvedAgainst:  "state",
			FXFallbackStats:  fxFallbackStats,
			RatesDigest:      ratesDigest,
		}
		if cfg.dedupPolicySet {
			digest.DedupPolicyStats = &dedupPolicyStats
		}
		if cfg.auditLog != "" {
			hashByPath := make(map[string]string, len(auditSegmentPaths))
			for _, path := range auditSegmentPaths {
				h, _, err := fileDigest(path)
				if err != nil {
					return err
				}
				hashByPath[path] = h
			}
			orderedPaths := append([]string(nil), auditSegmentPaths...)
			for i, j := 0, len(orderedPaths)-1; i < j; i, j = i+1, j-1 {
				orderedPaths[i], orderedPaths[j] = orderedPaths[j], orderedPaths[i]
			}
			if len(orderedPaths) > 1 {
				names := make([]string, len(orderedPaths))
				for i, path := range orderedPaths {
					names[i] = filepath.Base(path)
				}
				hashes := make([]string, len(orderedPaths))
				for i, path := range orderedPaths {
					hashes[i] = hashByPath[path]
				}
				digest.AuditLog = mustJSONStringArray(names)
				digest.SHA256Segments = hashes
			} else {
				digest.AuditLog = mustJSONString(filepath.Base(orderedPaths[0]))
				digest.SHA256 = hashByPath[orderedPaths[0]]
			}
		} else {
			digest.AuditLog = mustJSONString("")
		}
		data, err := json.MarshalIndent(digest, "", "  ")
		if err != nil {
			return err
		}
		data = append(data, '\n')
		if err := atomicWriteFile(cfg.auditLogDigest, data); err != nil {
			return err
		}
	}
	if cfg.outManifest != "" {
		manifest, err := buildManifest(cfg, runIndex, ratesDigest, shards, shardAccepted, bucketCounts, hasMin, minTs, hasMax, maxTs)
		if err != nil {
			return err
		}
		manifestData, err := writeManifest(cfg.outManifest, manifest)
		if err != nil {
			return err
		}
		if cfg.manifestSignature != "" {
			var maxPtr *string
			if manifest.Window.MaxTs != nil {
				maxPtr = manifest.Window.MaxTs
			}
			if err := writeSignature(cfg.manifestSignature, cfg.outManifest, manifestData, maxPtr); err != nil {
				return err
			}
		}
	}
	return nil
}

func writeAuditLog(path string, entries []auditLogEntry, rotateBytes int) []string {
	var segments []string
	if rotateBytes <= 0 {
		var buf bytes.Buffer
		for _, e := range entries {
			b, err := json.Marshal(e)
			if err != nil {
				panic(err)
			}
			buf.Write(b)
			buf.WriteByte('\n')
		}
		if err := atomicWriteFile(path, buf.Bytes()); err != nil {
			panic(err)
		}
		return []string{path}
	}

	current := path
	var buf bytes.Buffer
	flush := func() {
		if err := atomicWriteFile(current, buf.Bytes()); err != nil {
			panic(err)
		}
		segments = append(segments, current)
		buf.Reset()
	}
	for _, e := range entries {
		b, err := json.Marshal(e)
		if err != nil {
			panic(err)
		}
		rec := append(b, '\n')
		if buf.Len() > 0 && buf.Len()+len(rec) > rotateBytes {
			flush()
			current = fmt.Sprintf("%s.%d", path, len(segments))
		}
		buf.Write(rec)
	}
	if buf.Len() > 0 || len(segments) == 0 {
		flush()
	}
	return segments
}

