   196			}
   197			if strings.HasPrefix(arg, "--") && arg != "--rates-strict" && arg != "--strict-late-audit" && arg != "--state-strict" {
   198				if _, ok := required[arg]; ok {
   199					required[arg] = true
   200				}
   201			}
   202		}
   203		for k, ok := range required {
   204			if !ok {
   205				return cliConfig{}, fmt.Errorf("ingest: %s is required", k)
   206			}
   207		}
   208		if cfg.ingestIDSet {
   209			if len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {
   210				return cliConfig{}, fmt.Errorf("ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)")
