   224				if shards[i].Bytes != shards[j].Bytes {
   225					return shards[i].Bytes < shards[j].Bytes
   226				}
   227				return shards[i].Shard < shards[j].Shard
   228			})
   229		case "sha256":
   230			sort.SliceStable(shards, func(i, j int) bool {
