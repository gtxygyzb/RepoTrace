   551	      if !isFinite(f) {
   552	        return nil, fmt.Errorf("bad rate for %s", currency)
   553	      }
   554	      rt.global[currency] = f
   555	      continue
   556	    }
   557	    var dates map[string]json.RawMessage
   558	    if err := json.Unmarshal(raw, &dates); err == nil {
   559	      for date, raw2 := range dates {
   560	        r, err := parseRateRaw(raw2)
