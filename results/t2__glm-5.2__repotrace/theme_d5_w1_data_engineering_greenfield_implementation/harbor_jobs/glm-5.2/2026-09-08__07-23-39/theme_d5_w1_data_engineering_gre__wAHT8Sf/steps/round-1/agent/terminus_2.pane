	RunIndex       int            `json:"run_index"`
	Watermark      *string        `json:"watermark"`
	Sessions       summarySessions `json:"sessions"`
}

type auditLogEntry struct {
	Shard               string         `json:"shard"`
	Line                int            `json:"line"`
	ID                  string         `json:"id"`
	TS                  string         `json:"ts"`
	Type                string         `json:"type"`
	Bucket              string         `json:"bucket"`
	Reason              string         `json:"reason"`
	WinnerArrival       *winnerArrival `json:"winner_arrival,omitempty"`
	Event               rawJSON        `json:"event"`
	Cutoff              *cutoffObject  `json:"cutoff,omitempty"`
	WatermarkLagSeconds *int           `json:"watermark_lag_seconds,omitempty"`
	LateBySeconds       *int           `json:"late_by_seconds,omitempty"`
}

type cutoffObject struct {
	Value        string `json:"value"`
	EpochSeconds int    `json:"epoch_seconds"`
}

func (e auditLogEntry) MarshalJSON() ([]byte, error) {
	if e.Bucket == "late" {
		var buf bytes.Buffer
		buf.WriteString(`{"id":`)
		b, err := json.Marshal(e.ID)
		if err != nil {
			return nil, err
		}
		buf.Write(b)
		buf.WriteString(`,"ts":`)
		b, err = json.Marshal(e.TS)
		if err != nil {
			return nil, err
		}
		buf.Write(b)
		buf.WriteString(`,"type":`)
		b, err = json.Marshal(e.Type)
		if err != nil {
			return nil, err
		}
		buf.Write(b)
		buf.WriteString(`,"shard":`)
		b, err = json.Marshal(e.Shard)
		if err != nil {
			return nil, err
		}
		buf.Write(b)
		buf.WriteString(`,"line":`)
		b, err = json.Marshal(e.Line)
		if err != nil {
			return nil, err
		}
		buf.Write(b)
		buf.WriteString(`,"bucket":`)
		b, err = json.Marshal(e.Bucket)
		if err != nil {
			return nil, err
		}
		buf.Write(b)
		buf.WriteString(`,"cutoff":`)
		if e.Cutoff != nil {
			b, err = json.Marshal(e.Cutoff)
			if err != nil {
				return nil, err
			}
		} else {
			b = []byte("null")
		}
		buf.Write(b)
		if e.WatermarkLagSeconds != nil {
			buf.WriteString(`,"watermark_lag_seconds":`)
			b, err = json.Marshal(*e.WatermarkLagSeconds)
			if err != nil {
				return nil, err
			}
			buf.Write(b)
		}
		if e.LateBySeconds != nil {
			buf.WriteString(`,"late_by_seconds":`)
			b, err = json.Marshal(*e.LateBySeconds)
			if err != nil {
				return nil, err
			}
			buf.Write(b)
		}
		buf.WriteByte('}')
		return buf.Bytes(), nil
	}
	type alias auditLogEntry
	return json.Marshal(alias(e))
}

type winnerArrival struct {
	Shard string `json:"shard"`
	Line  int    `json:"line"`
}

type rejectsCrossCheck struct {
	RejectsRowCount        int  `json:"rejects_row_count"`
	AuditRejectRecordCount int  `json:"audit_reject_record_count"`
	Agree                  bool `json:"agree"`
}

type dedupPolicyStats struct {
	Policy                       string `json:"policy"`
	DuplicateWinnersSameShard    int    `json:"duplicate_winners_same_shard"`
	DuplicateWinnersCrossShard   int    `json:"duplicate_winners_cross_shard"`
	DuplicateWinnersLineTiebreak int    `json:"duplicate_winners_line_tiebreak"`
}

type auditDigestOutput struct {
	SchemaVersion     string             `json:"schema_version"`
	AuditLog          json.RawMessage    `json:"audit_log"`
	TotalRecords      int                `json:"total_records"`
	BucketCounts      map[string]int     `json:"bucket_counts"`
	InvalidReasons    map[string]int     `json:"invalid_reasons"`
	DuplicateReasons  map[string]int     `json:"duplicate_reasons"`
	LateCutoffStats   lateCutoffStats    `json:"late_cutoff_stats"`
	ResolvedAgainst   string             `json:"resolved_against"`
	DedupPolicyStats  *dedupPolicyStats  `json:"dedup_policy_stats,omitempty"`
	FXFallbackStats   map[string]int     `json:"fx_fallback_stats"`
	RatesDigest       string             `json:"rates_digest"`
	RejectsCrossCheck *rejectsCrossCheck `json:"rejects_cross_check,omitempty"`
	SHA256            string             `json:"sha256,omitempty"`
	SHA256Segments    []string           `json:"sha256_segments,omitempty"`
}

type lateCutoffStats struct {
	Count          int `json:"count"`
	MinCutoffEpoch int `json:"min_cutoff_epoch"`
	MaxCutoffEpoch int `json:"max_cutoff_epoch"`
}

type manifestOutput struct {
	SchemaVersion string          `json:"schema_version"`
	IngestID      *string         `json:"ingest_id"`
	RunIndex      int             `json:"run_index"`
