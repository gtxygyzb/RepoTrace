[?2004l   240			return cliConfig{}, fmt.Errorf("ingest: --summary-schema-index requires --summary-schema-out and --summary-schema-digest")
   241		}
   242		if cfg.summarySchemaOut != "" && !parentDirExists(cfg.summarySchemaOut) {
   243			return cliConfig{}, fmt.Errorf("ingest --summary-schema-out parent directory does not exist")
   244		}
   245		if cfg.summarySchemaDigest != "" && !parentDirExists(cfg.summarySchemaDigest) {
   246			return cliConfig{}, fmt.Errorf("ingest --summary-schema-digest parent directory does not exist")
   247		}
   248		if cfg.summarySchemaIndex != "" && !parentDirExists(cfg.summarySchemaIndex) {
   249			return cliConfig{}, fmt.Errorf("ingest --summary-schema-index parent directory does not exist")
   250		}
   251		if cfg.dedupPolicy == "" {
   252			cfg.dedupPolicy = "lex-largest-ts"
   253		}
   254		if cfg.rejectsFormat == "" {
   255			cfg.rejectsFormat = "legacy"
   256		}
   257		if cfg.rejectsFormat == "tagged" && cfg.auditLog == "" {
   258			return cliConfig{}, fmt.Errorf("ingest: --rejects-format tagged requires --audit-log")
   259		}
   260		if cfg.rejectsFormat == "tagged-sorted" && cfg.auditLog == "" {
   261			return cliConfig{}, fmt.Errorf("ingest: --rejects-format tagged-sorted requires --audit-log")
   262		}
   263		if cfg.rejectsFormatHeader && cfg.rejectsFormat != "tagged" && cfg.rejectsFormat != "tagged-sorted" {
   264			return cliConfig{}, fmt.Errorf("ingest: --rejects-format-header requires --rejects-format tagged")
   265		}
   266		if cfg.sessionPolicy == "" {
   267			cfg.sessionPolicy = "gap"
   268		}
   269		if cfg.fixedWindowSet && cfg.sessionPolicy == "gap" {
   270			return cliConfig{}, fmt.Errorf("ingest: --fixed-window-seconds requires --session-policy fixed-window or hybrid")
   271		}
   272		if cfg.sessionPolicy == "fixed-window" && !cfg.fixedWindowSet {
   273			return cliConfig{}, fmt.Errorf("ingest: --session-policy fixed-window requires --fixed-window-seconds")
   274		}
   275		if cfg.sessionPolicy == "hybrid" && !cfg.fixedWindowSet {
   276			return cliConfig{}, fmt.Errorf("ingest: --session-policy hybrid requires --fixed-window-seconds")
   277		}
