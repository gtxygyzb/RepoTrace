[?2004hroot@n30009:/app# sed -n '258,305p' main.go
[?2004lfunc readInputEvents(inputDir string) ([]rawEvent, []inputShardInfo, error) {
	info, err := os.Stat(inputDir)
	if err != nil {
		return nil, nil, err
	}
	if !info.IsDir() {
		return nil, nil, errors.New("input-dir is not a directory")
	}
	entries, err := os.ReadDir(inputDir)
	if err != nil {
		return nil, nil, err
	}
	var files []string
	for _, e := range entries {
		if e.IsDir() || !e.Type().IsRegular() {
			continue
		}
		files = append(files, e.Name())
	}
	sort.Strings(files)
	var events []rawEvent
	var shards []inputShardInfo
	for _, name := range files {
		data, err := os.ReadFile(filepath.Join(inputDir, name))
		if err != nil {
			return nil, nil, err
		}
		si := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}
		lineNo := 0
		for _, line := range bytes.Split(data, []byte{'\n'}) {
			lineNo++
			trimmed := bytes.TrimSpace(line)
			if len(trimmed) == 0 {
				events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Blank: true})
				continue
			}
			si.EventsTotal++
			var obj map[string]json.RawMessage
			invalid := false
			if err := json.Unmarshal(trimmed, &obj); err != nil {
				invalid = true
			}
			events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})
		}
		shards = append(shards, si)
	}
	return events, shards, nil
}
