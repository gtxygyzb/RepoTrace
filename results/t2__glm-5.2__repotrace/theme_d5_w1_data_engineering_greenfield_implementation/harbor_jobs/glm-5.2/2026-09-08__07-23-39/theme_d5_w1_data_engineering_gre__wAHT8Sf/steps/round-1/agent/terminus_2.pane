   671	
   672	func writeAuditLog(path string, entries []auditLogEntry, rotateBytes int) []string {
   673		var segments []string
   674		if rotateBytes <= 0 {
   675			var buf bytes.Buffer
   676			for _, e := range entries {
   677				b, err := json.Marshal(e)
   678				if err != nil {
   679					panic(err)
   680				}
   681				buf.Write(b)
   682				buf.WriteByte('\n')
   683			}
   684			if err := atomicWriteFile(path, buf.Bytes()); err != nil {
   685				panic(err)
   686			}
   687			return []string{path}
   688		}
   689	
   690		current := path
   691		var buf bytes.Buffer
   692		flush := func() {
   693			if err := atomicWriteFile(current, buf.Bytes()); err != nil {
   694				panic(err)
   695			}
   696			segments = append(segments, current)
   697			buf.Reset()
   698		}
   699		for _, e := range entries {
   700			b, err := json.Marshal(e)
   701			if err != nil {
   702				panic(err)
   703			}
   704			rec := append(b, '\n')
   705			if buf.Len() > 0 && buf.Len()+len(rec) > rotateBytes {
   706				flush()
   707				current = fmt.Sprintf("%s.%d", path, len(segments))
   708			}
   709			buf.Write(rec)
   710		}
   711		if buf.Len() > 0 || len(segments) == 0 {
   712			flush()
   713		}
   714		return segments
   715	}
   716	
   717	func computeLateCutoffStats(entries []auditLogEntry) lateCutoffStats {
   718		stats := lateCutoffStats{}
