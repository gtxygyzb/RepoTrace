[?2004lpackage main

import (
	"bytes"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"regexp"
	"sort"
	"strconv"
	"strings"
	"time"
)

var ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)

type cliConfig struct {
	inputDir            string
	ratesPath           string
	outputPath          string
	rejectsPath         string
	sessionGap          int
	watermarkLag        int
	stateIn             string
	stateOut            string
	pendingTTL          int
	maxOpenSessions     int
	auditLog            string
	auditLogDigest      string
	auditLogRotateBytes int
	ratesStrict         bool
	ratesMaxStaleness   int
	ingestID            string
	ingestIDSet         bool
	outManifest         string
	manifestSignature   string
	dedupPolicy         string
	dedupPolicySet      bool
	strictLateAudit     bool
	stateStrict         bool
	summarySchemaOut    string
	summarySchemaDigest string
	summarySchemaStrict bool
	summarySchemaIndex  string
	rejectsFormat       string
	rejectsFormatHeader bool
	sessionPolicy       string
	fixedWindowSeconds  int
	fixedWindowSet      bool
}

func main() {
	cfg, err := parseArgs(os.Args[1:])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(2)
	}
	if err := run(cfg); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func parseArgs(args []string) (cfg cliConfig, err error) {
	defer func() {
		if r := recover(); r != nil {
			cfg = cliConfig{}
			err = fmt.Errorf("%v", r)
		}
	}()
	cfg = cliConfig{
		sessionGap:        600,
		watermarkLag:      300,
		pendingTTL:        86400,
		maxOpenSessions:   100000,
		ratesMaxStaleness: 0,
	}
	required := map[string]bool{
		"--input-dir": false,
		"--rates":     false,
		"--output":    false,
		"--rejects":   false,
	}
	if len(args) > 0 && args[0] == "ingest" {
		args = args[1:]
	}
	for i := 0; i < len(args); i++ {
		arg := args[i]
