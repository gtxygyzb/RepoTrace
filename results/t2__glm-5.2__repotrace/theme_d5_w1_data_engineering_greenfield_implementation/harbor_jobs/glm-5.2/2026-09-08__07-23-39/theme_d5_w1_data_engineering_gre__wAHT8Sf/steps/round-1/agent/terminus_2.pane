   338	func getNumberOrString(raw json.RawMessage) (float64, error) {
   339	  trimmed := bytes.TrimSpace(raw)
   340	  if len(trimmed) == 0 {
   341	    return 0, errors.New("empty number")
   342	  }
   343	  if trimmed[0] == '"' {
   344	    var s string
   345	    if err := json.Unmarshal(trimmed, &s); err != nil {
   346	      return 0, err
   347	    }
   348	    s = strings.TrimSpace(s)
   349	    if parts := strings.Fields(s); len(parts) > 0 {
   350	      s = parts[0]
   351	    }
   352	    return strconv.ParseFloat(s, 64)
   353	  }
   354	  return strconv.ParseFloat(string(trimmed), 64)
   355	}
   356	
   357	func isFinite(f float64) bool {
   358	  return !math.IsInf(f, 0) && !math.IsNaN(f)
   359	}
   360	
   361	func getJSONInt(raw json.RawMessage) (int64, error) {
   362	  var n json.Number
   363	  if err := json.Unmarshal(raw, &n); err != nil {
   364	    return 0, err
   365	  }
   366	  s := string(n)
   367	  if strings.ContainsAny(s, ".eE") {
   368	    return 0, errors.New("not an integer")
   369	  }
   370	  return strconv.ParseInt(s, 10, 64)
   371	}
   372	
   373	func roundMoney(f float64) float64 {
   374	  abs := math.Abs(f)
   375	  cents := int64(math.Floor(abs*100.0 + 0.5))
   376	  if f < 0 && cents != 0 {
   377	    return -float64(cents) / 100.0
   378	  }
   379	  return float64(cents) / 100.0
   380	}
