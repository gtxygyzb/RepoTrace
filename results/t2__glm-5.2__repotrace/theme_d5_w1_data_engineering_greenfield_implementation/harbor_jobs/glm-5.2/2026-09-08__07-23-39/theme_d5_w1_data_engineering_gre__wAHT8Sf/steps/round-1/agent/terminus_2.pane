    53	func parseTime(s string) (time.Time, error) {
    54		s = strings.TrimSpace(s)
    55		if strings.HasSuffix(s, "Z") {
    56			if t, err := time.Parse("2006-01-02T15:04:05Z", s); err == nil {
    57				return t.UTC(), nil
    58			}
    59			if t, err := time.Parse("2006-01-02T15:04:05.000000000Z", s); err == nil {
    60				return t.UTC(), nil
    61			}
    62		}
    63		if t, err := time.Parse(time.RFC3339Nano, s); err == nil {
    64			return t.UTC(), nil
    65		}
    66		if t, err := time.Parse(time.RFC3339, s); err == nil {
    67			return t.UTC(), nil
    68		}
    69		return time.Time{}, fmt.Errorf("bad timestamp: %s", s)
    70	}
    71	
    72	func formatTS(t time.Time) string {
    73		return t.UTC().Format("2006-01-02T15:04:05Z")
    74	}
    75	
    76	func dateKey(t time.Time) string {
    77		return t.UTC().Format("2006-01-02")
    78	}
