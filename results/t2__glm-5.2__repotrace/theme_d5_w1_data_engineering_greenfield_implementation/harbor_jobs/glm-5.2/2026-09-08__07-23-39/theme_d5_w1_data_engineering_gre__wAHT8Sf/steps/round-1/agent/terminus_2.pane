   629	func writeAuditLog(path string, entries []auditLogEntry, rotateBytes int) []string {
   630		var segments []string
   631		if rotateBytes <= 0 {
   632			var buf bytes.Buffer
   633			for _, e := range entries {
   634				b, err := json.Marshal(e)
   635				if err != nil {
   636					panic(err)
   637				}
   638				buf.Write(b)
   639				buf.WriteByte('\n')
   640			}
   641			if err := atomicWriteFile(path, buf.Bytes()); err != nil {
   642				panic(err)
   643			}
   644			return []string{path}
   645		}
   646	
   647		current := path
   648		var buf bytes.Buffer
   649		flush := func() {
   650			if err := atomicWriteFile(current, buf.Bytes()); err != nil {
   651				panic(err)
   652			}
   653			segments = append(segments, current)
   654			buf.Reset()
   655		}
   656		for _, e := range entries {
   657			b, err := json.Marshal(e)
   658			if err != nil {
   659				panic(err)
   660			}
   661			rec := append(b, '\n')
   662			if buf.Len() > 0 && buf.Len()+len(rec) > rotateBytes {
   663				flush()
   664				current = fmt.Sprintf("%s.%d", path, len(segments))
   665			}
   666			buf.Write(rec)
   667		}
   668		if buf.Len() > 0 || len(segments) == 0 {
   669			flush()
   670		}
   671		return segments
   672	}
   673	
   674	func computeLateCutoffStats(entries []auditLogEntry) lateCutoffStats {
   675		stats := lateCutoffStats{}
   676		for _, e := range entries {
   677			if e.Bucket == "late" && e.Cutoff != nil {
   678				if stats.Count == 0 {
   679					stats.MinCutoffEpoch = e.Cutoff.EpochSeconds
   680					stats.MaxCutoffEpoch = e.Cutoff.EpochSeconds
   681				} else {
   682					if e.Cutoff.EpochSeconds < stats.MinCutoffEpoch {
   683						stats.MinCutoffEpoch = e.Cutoff.EpochSeconds
   684					}
   685					if e.Cutoff.EpochSeconds > stats.MaxCutoffEpoch {
   686						stats.MaxCutoffEpoch = e.Cutoff.EpochSeconds
   687					}
   688				}
   689				stats.Count++
   690			}
   691		}
   692		return stats
   693	}
   694	
   695	func mustJSONString(s string) json.RawMessage {
   696		b, err := json.Marshal(s)
   697		if err != nil {
   698			panic(err)
   699		}
   700		return b
   701	}
   702	
   703	func mustJSONStringArray(ss []string) json.RawMessage {
   704		b, err := json.Marshal(ss)
   705		if err != nil {
   706			panic(err)
   707		}
   708		return b
   709	}
   710	
   711	type rejectRecord struct {
   712		bucket      string
   713		reason      string
   714		raw         rawJSON
   715		winner      bool
   716		winnerShard string
   717		winnerLine  int
   718	}
   719	
   720	func arrivalLess(a, b *Event) bool {
   721		if a.Shard != b.Shard {
   722			return a.Shard < b.Shard
   723		}
   724		return a.Line < b.Line
   725	}
   726	
   727	func buildRejects(records []rejectRecord, policy string) []byte {
   728		order := []string{"invalid", "late", "duplicate", "unresolved_chargeback"}
   729		var buf bytes.Buffer
   730		for _, bucket := range order {
   731			for _, r := range records {
   732				if r.bucket != bucket {
   733					continue
   734				}
   735				buf.Write(r.raw)
   736				if policy == "first-arrival" {
   737					buf.WriteByte('\t')
   738					if r.winner {
   739						buf.WriteString(r.winnerShard)
   740						buf.WriteByte('\t')
   741						buf.WriteString(strconv.Itoa(r.winnerLine))
   742					} else {
   743						buf.WriteString("-")
   744						buf.WriteByte('\t')
   745						buf.WriteString("-")
   746					}
   747				}
   748				buf.WriteByte('\n')
   749			}
   750		}
   751		return buf.Bytes()
   752	}
