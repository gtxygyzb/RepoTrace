   308	func getRawString(m map[string]json.RawMessage, key string) (string, bool, bool) {
   309	  raw, present := m[key]
   310	  if !present {
   311	    return "", false, false
   312	  }
   313	  var s string
   314	  if err := json.Unmarshal(raw, &s); err == nil {
   315	    return s, true, true
   316	  }
   317	  return "", false, true
   318	}
   319	
   320	func rawStringPtr(m map[string]json.RawMessage, key string) *string {
   321	  s, ok, _ := getRawString(m, key)
   322	  if !ok {
   323	    return nil
   324	  }
   325	  return &s
   326	}
   327	
   328	func getString(m map[string]json.RawMessage, keys ...string) (string, bool) {
   329	  for _, k := range keys {
   330	    s, ok, _ := getRawString(m, k)
   331	    if ok {
   332	      return s, true
   333	    }
   334	  }
   335	  return "", false
   336	}
   337	
   338	func getNumberOrString(raw json.RawMessage) (float64, error) {
   339	  trimmed := bytes.TrimSpace(raw)
   340	  if len(trimmed) == 0 {
   341	    return 0, errors.New("empty number")
   342	  }
   343	  if trimmed[0] == '"' {
   344	    var s string
   345	    if err := json.Unmarshal(trimmed, &s); err != nil {
   346	      return 0, err
   347	    }
   348	    s = strings.TrimSpace(s)
   349	    if parts := strings.Fields(s); len(parts) > 0 {
   350	      s = parts[0]
   351	    }
   352	    return strconv.ParseFloat(s, 64)
   353	  }
   354	  return strconv.ParseFloat(string(trimmed), 64)
   355	}
   356	
   357	func isFinite(f float64) bool {
   358	  return !math.IsInf(f, 0) && !math.IsNaN(f)
   359	}
   360	
   361	func getJSONInt(raw json.RawMessage) (int64, error) {
   362	  var n json.Number
   363	  if err := json.Unmarshal(raw, &n); err != nil {
   364	    return 0, err
   365	  }
   366	  s := string(n)
   367	  if strings.ContainsAny(s, ".eE") {
   368	    return 0, errors.New("not an integer")
   369	  }
   370	  return strconv.ParseInt(s, 10, 64)
   371	}
   372	
   373	func roundMoney(f float64) float64 {
   374	  abs := math.Abs(f)
   375	  cents := int64(math.Floor(abs*100.0 + 0.5))
   376	  if f < 0 && cents != 0 {
   377	    return -float64(cents) / 100.0
   378	  }
   379	  return float64(cents) / 100.0
   380	}
   381	
   382	func jsonBytes(s string) []byte {
   383	  b, err := json.Marshal(s)
   384	  if err != nil {
   385	    return []byte(`""`)
   386	  }
   387	  return b
   388	}
