   281		if err != nil {
   282			return err
   283		}
   284		summaryData = append(summaryData, '\n')
   285		if err := atomicWriteFile(cfg.outputPath, summaryData); err != nil {
   286			return err
   287		}
   288		rejectsData, err := json.MarshalIndent(rejects, "", "  ")
   289		if err != nil {
   290			return err
   291		}
   292		rejectsData = append(rejectsData, '\n')
   293		if err := atomicWriteFile(cfg.rejectsPath, rejectsData); err != nil {
   294			return err
   295		}
   296		if cfg.stateOut != "" {
   297			stateData := buildStateOut(watermark, hasWatermark, st, sortedSeenIDs(seen), sortedPending(pending), sortedOpenSessions(openSessions), runIndex)
   298			if err := atomicWriteFile(cfg.stateOut, stateData); err != nil {
   299				return err
   300			}
   301		}
