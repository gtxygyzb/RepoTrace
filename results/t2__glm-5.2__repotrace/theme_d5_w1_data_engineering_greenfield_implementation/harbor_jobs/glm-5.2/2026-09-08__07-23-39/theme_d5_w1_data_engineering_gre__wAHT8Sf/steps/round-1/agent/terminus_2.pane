   470					hasMin = true
   471				}
   472				if !hasMax || c.ev.TS.After(maxTs) {
   473					maxTs = c.ev.TS
   474					hasMax = true
   475				}
   476				_ = pending
   477				_ = openSessions
   478			} else {
   479				bucketCounts["duplicate"]++
   480				duplicateReasons["same_run"]++
   481				entry := auditEntries[i]
   482				entry.Bucket = "duplicate"
   483				entry.Reason = "same_run"
   484				if cfg.dedupPolicy == "first-arrival" {
   485					w := winners[entry.ID]
   486					entry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}
   487				}
   488				auditEntries[i] = entry
   489			}
   490		}
   491	
   492		var rejectRecords []rejectRecord
   493		for i, c := range candidates {
   494			if c.ev == nil {
   495				r := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, raw: c.raw.Raw}
   496				rejectRecords = append(rejectRecords, r)
   497				continue
   498			}
   499			if winnerSet[i] {
   500				continue
   501			}
   502			r := rejectRecord{bucket: "duplicate", reason: "same_run", raw: c.raw.Raw}
   503			if cfg.dedupPolicy == "first-arrival" {
   504				r.winner = true
   505				r.winnerShard = candidates[winners[c.ev.ID]].ev.Shard
   506				r.winnerLine = candidates[winners[c.ev.ID]].ev.Line
   507			}
   508			rejectRecords = append(rejectRecords, r)
   509		}
   510	
   511		summary := summaryOutput{
   512			TotalEvents:    len(events),
   513			AcceptedEvents: bucketCounts["accepted"],
   514			RejectedEvents: bucketCounts["duplicate"] + bucketCounts["invalid"] + bucketCounts["late"] + bucketCounts["unresolved_chargeback"],
   515			Anomalies: map[string]int{
   516				"duplicate":             bucketCounts["duplicate"],
   517				"invalid":               bucketCounts["invalid"],
   518				"late":                  bucketCounts["late"],
   519				"unresolved_chargeback": bucketCounts["unresolved_chargeback"],
   520			},
   521			RunIndex: runIndex,
   522		}
   523		if hasWatermark {
   524			wm := formatTS(watermark)
   525			summary.Watermark = &wm
   526		}
   527		summaryData, err := json.MarshalIndent(summary, "", "  ")
   528		if err != nil {
   529			return err
   530		}
   531		summaryData = append(summaryData, '\n')
   532		if err := atomicWriteFile(cfg.outputPath, summaryData); err != nil {
   533			return err
   534		}
   535		rejectsData := buildRejects(rejectRecords, cfg.dedupPolicy)
   536		if err := atomicWriteFile(cfg.rejectsPath, rejectsData); err != nil {
   537			return err
   538		}
   539		if cfg.stateOut != "" {
   540			stateData := buildStateOut(watermark, hasWatermark, st, sortedSeenIDs(seen), sortedPending(pending), sortedOpenSessions(openSessions), runIndex)
   541			if err := atomicWriteFile(cfg.stateOut, stateData); err != nil {
   542				return err
   543			}
   544		}
   545		var auditSegmentPaths []string
   546		if cfg.auditLog != "" {
   547			auditSegmentPaths = writeAuditLog(cfg.auditLog, auditEntries, cfg.auditLogRotateBytes)
   548		}
   549		if cfg.auditLogDigest != "" {
   550			digest := auditDigestOutput{
   551				SchemaVersion:    "eventq.digest/v1",
   552				TotalRecords:     len(auditEntries),
   553				BucketCounts:     bucketCounts,
   554				InvalidReasons:   invalidReasons,
   555				DuplicateReasons: duplicateReasons,
   556				LateCutoffStats:  computeLateCutoffStats(auditEntries),
   557				ResolvedAgainst:  "state",
   558				FXFallbackStats:  fxFallbackStats,
   559				RatesDigest:      ratesDigest,
   560			}
   561			if cfg.dedupPolicySet {
   562				digest.DedupPolicyStats = &dedupPolicyStats
   563			}
   564			if cfg.auditLog != "" {
   565				hashByPath := make(map[string]string, len(auditSegmentPaths))
   566				for _, path := range auditSegmentPaths {
   567					h, _, err := fileDigest(path)
   568					if err != nil {
   569						return err
   570					}
   571					hashByPath[path] = h
   572				}
   573				orderedPaths := append([]string(nil), auditSegmentPaths...)
   574				for i, j := 0, len(orderedPaths)-1; i < j; i, j = i+1, j-1 {
   575					orderedPaths[i], orderedPaths[j] = orderedPaths[j], orderedPaths[i]
   576				}
   577				if len(orderedPaths) > 1 {
   578					names := make([]string, len(orderedPaths))
   579					for i, path := range orderedPaths {
   580						names[i] = filepath.Base(path)
   581					}
   582					hashes := make([]string, len(orderedPaths))
   583					for i, path := range orderedPaths {
   584						hashes[i] = hashByPath[path]
   585					}
   586					digest.AuditLog = mustJSONStringArray(names)
   587					digest.SHA256Segments = hashes
   588				} else {
   589					digest.AuditLog = mustJSONString(filepath.Base(orderedPaths[0]))
   590					digest.SHA256 = hashByPath[orderedPaths[0]]
   591				}
   592			} else {
   593				digest.AuditLog = mustJSONString("")
   594			}
   595			data, err := json.MarshalIndent(digest, "", "  ")
   596			if err != nil {
   597				return err
   598			}
   599			data = append(data, '\n')
   600			if err := atomicWriteFile(cfg.auditLogDigest, data); err != nil {
   601				return err
   602			}
   603		}
   604		if cfg.outManifest != "" {
   605			manifest, err := buildManifest(cfg, runIndex, ratesDigest, shards, shardAccepted, bucketCounts, hasMin, minTs, hasMax, maxTs)
   606			if err != nil {
   607				return err
   608			}
   609			manifestData, err := writeManifest(cfg.outManifest, manifest)
   610			if err != nil {
   611				return err
   612			}
   613			if cfg.manifestSignature != "" {
   614				var maxPtr *string
   615				if manifest.Window.MaxTs != nil {
   616					maxPtr = manifest.Window.MaxTs
   617				}
   618				if err := writeSignature(cfg.manifestSignature, cfg.outManifest, manifestData, maxPtr); err != nil {
   619					return err
   620				}
   621			}
   622		}
   623		if err := writeSummarySchemaSidecars(cfg, summaryData, runIndex); err != nil {
   624			return err
   625		}
   626		return nil
   627	}
