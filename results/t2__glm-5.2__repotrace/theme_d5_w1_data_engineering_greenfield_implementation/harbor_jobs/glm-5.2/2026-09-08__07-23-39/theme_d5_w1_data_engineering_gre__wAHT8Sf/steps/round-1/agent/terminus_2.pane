   306	func newContext(raw rawEvent) *eventContext {
   307		ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}
   308		if raw.Obj != nil {
   309			ctx.ID = rawStringPtr(raw.Obj, "id")
   310			ctx.TS = rawStringPtr(raw.Obj, "ts")
   311			ctx.Type = rawStringPtr(raw.Obj, "type")
   312		}
   313		return ctx
   314	}
