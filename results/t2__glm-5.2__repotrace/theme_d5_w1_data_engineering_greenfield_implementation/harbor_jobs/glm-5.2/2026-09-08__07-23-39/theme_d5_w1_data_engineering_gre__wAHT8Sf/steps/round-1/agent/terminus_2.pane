    27	func (m Money) String() string {
    28	  f := float64(m)
    29	  abs := math.Abs(f)
    30	  cents := int64(math.Floor(abs*100.0 + 0.5))
    31	  neg := f < 0 && cents != 0
    32	  dollars := cents / 100
    33	  rem := cents % 100
    34	  s := fmt.Sprintf("%d.%02d", dollars, rem)
    35	  if neg {
    36	    s = "-" + s
    37	  }
    38	  return s
    39	}
