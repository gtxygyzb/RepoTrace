  1085			IngestID:      ingestID,
  1086			RunIndex:      runIndex,
  1087			RatesDigest:   ratesDigest,
  1088			InputShards:   manifestShards,
  1089			Outputs:       outputs,
  1090			Window:        window,
  1091		}, nil
  1092	}
  1093	
  1094	func bucketCode(bucket string) int {
  1095		switch bucket {
  1096		case "accepted":
  1097			return 0
  1098		case "duplicate":
  1099			return 1
  1100		case "invalid":
  1101			return 2
  1102		case "late":
  1103			return 3
  1104		case "unresolved_chargeback":
  1105			return 4
  1106		}
  1107		return 2
  1108	}
