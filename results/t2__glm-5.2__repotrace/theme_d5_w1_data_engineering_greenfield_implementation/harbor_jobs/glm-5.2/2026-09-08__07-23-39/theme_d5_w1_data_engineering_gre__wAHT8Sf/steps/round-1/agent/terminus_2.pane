var ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)

type cliConfig struct {
	inputDir            string
	ratesPath           string
	outputPath          string
	rejectsPath         string
	sessionGap          int
	watermarkLag        int
	stateIn             string
	stateOut            string
	pendingTTL          int
	maxOpenSessions     int
	auditLog            string
	auditLogDigest      string
	auditLogRotateBytes int
	ratesStrict         bool
	ratesMaxStaleness   int
	ingestID            string
	ingestIDSet         bool
	outManifest         string
	manifestSignature   string
	dedupPolicy         string
	dedupPolicySet      bool
	strictLateAudit     bool
	stateStrict         bool
}

func main() {
	cfg, err := parseArgs(os.Args[1:])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(2)
	}
	if err := run(cfg); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

