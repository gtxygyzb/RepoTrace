func nextArg(args []string, i *int) string {
	if *i+1 >= len(args) {
		panic(fmt.Errorf("ingest: missing value for %s", args[*i]))
	}
	*i++
	return args[*i]
}

func atoiOrError(s, flag string) int {
	n, err := strconv.Atoi(s)
	if err != nil {
		panic(fmt.Errorf("ingest: invalid integer for %s: %s", flag, s))
	}
	return n
}

func computeSessionCount(evs []*Event, policy string, gap, windowSecs int) int {
	if len(evs) == 0 {
		return 0
	}
	count := 1
	var anchor int64
	if policy == "fixed-window" || policy == "hybrid" {
		anchor = floorEpochToWindow(evs[0].TS.Unix(), int64(windowSecs))
	}
	for i := 1; i < len(evs); i++ {
		split := false
		if policy == "gap" || policy == "hybrid" {
			if evs[i].TS.Sub(evs[i-1].TS) > time.Duration(gap)*time.Second {
				split = true
			}
		}
		if policy == "fixed-window" || policy == "hybrid" {
			kPrev := floorDiv(evs[i-1].TS.Unix()-anchor, int64(windowSecs))
			kCur := floorDiv(evs[i].TS.Unix()-anchor, int64(windowSecs))
			if kPrev != kCur {
				split = true
			}
		}
		if split {
			count++
		}
	}
	return count
}

func floorEpochToWindow(epoch, window int64) int64 {
	if window <= 0 {
		return 0
	}
	return floorDiv(epoch, window) * window
}

func floorDiv(a, b int64) int64 {
	if b == 0 {
		return 0
	}
	q := a / b
	if (a%b != 0) && ((a < 0) != (b < 0)) {
		q--
	}
	return q
}

func ptrCutoff(c cutoffObject) *cutoffObject {
	return &c
}

func run(cfg cliConfig) error {
	ratesData, err := os.ReadFile(cfg.ratesPath)
	if err != nil {
		return fmt.Errorf("ingest: rates: %w", err)
	}
	ratesDigest := sha256Hex(ratesData)
	rt, err := loadRates(cfg.ratesPath)
	if err != nil {
		return err
	}
	var st *loadedState
	runIndex := 1
	if cfg.stateIn != "" {
		st, err = loadState(cfg.stateIn, cfg.stateStrict)
		if err != nil && !os.IsNotExist(err) {
			return err
		}
		if st != nil {
			runIndex = st.runIndex + 1
		}
	}
	events, blanks, shards, err := readInputEvents(cfg.inputDir)
	if err != nil {
		return err
	}
	seen := map[string]bool{}
	if st != nil {
		for k, v := range st.seenIds {
			seen[k] = v
		}
	}
	var pending []pendingEntry
	openSessions := map[string]carriedSession{}
	if st != nil {
		pending = append([]pendingEntry(nil), st.pending...)
		for k, v := range st.openSessions {
			openSessions[k] = v
		}
	}
	bucketCounts := map[string]int{"accepted": 0, "duplicate": 0, "invalid": 0, "late": 0, "unresolved_chargeback": 0}
	invalidReasons := map[string]int{}
	duplicateReasons := map[string]int{"same_run": 0, "cross_run": 0}
	fxFallbackStats := map[string]int{"0": 0}
	shardAccepted := map[string]int{}
	var minTs, maxTs time.Time
	hasMin, hasMax := false, false
	var watermark time.Time
	hasWatermark := false
	if st != nil {
		watermark = st.maxTs
		hasWatermark = st.hasMax
	}

	type candidate struct {
		raw       rawEvent
		ctx       *eventContext
		ev        *Event
		duplicate bool
	}
	var candidates []candidate
	var auditEntries []auditLogEntry

	// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.
	for _, raw := range events {
		ctx := newContext(raw)
		bucket := "invalid"
		reason := ""
		var ev *Event
		var lateCutoff *cutoffObject
		var lateLag, lateBySec *int
[?2004hroot@n30009:/app# sed -n '560,900p' cli.go
[?2004l		var lateLag, lateBySec *int
		if raw.Invalid {
			bucket = "invalid"
			reason = "invalid_json"
		} else {
			ev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)
			if ev != nil {
				if seen[ev.ID] {
					bucket = "duplicate"
					reason = "cross_run"
					ev = nil
				} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {
					bucket = "late"
					reason = "late"
					cutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)
					lateCutoff = ptrCutoff(formatCutoffObject(cutoff))
					if cfg.strictLateAudit {
						lag := cfg.watermarkLag
						lateBy := int(lateCutoff.EpochSeconds - int(epochSeconds(ev.TS)))
						lateLag = &lag
						lateBySec = &lateBy
					}
					ev = nil
				} else {
					bucket = "accepted"
					if ev.TS.After(watermark) {
						watermark = ev.TS
						hasWatermark = true
					}
				}
			} else {
				bucket = "invalid"
			}
		}
		if bucket == "invalid" {
			invalidReasons[reason]++
		}
