[?2004lpackage main

import (
  "bytes"
  "encoding/json"
  "errors"
  "fmt"
  "math"
  "os"
  "path/filepath"
  "sort"
  "strconv"
  "strings"
  "time"
)

var usageString = "usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>]\n"

type Money float64

func (m Money) MarshalJSON() ([]byte, error) {
  return []byte(m.String()), nil
}

func (m Money) String() string {
  f := float64(m)
  abs := math.Abs(f)
  cents := int64(math.Floor(abs*100.0 + 0.5))
  neg := f < 0 && cents != 0
  dollars := cents / 100
  rem := cents % 100
  s := fmt.Sprintf("%d.%02d", dollars, rem)
  if neg {
    s = "-" + s
  }
  return s
}

type Event struct {
  ID       string
  Type     string
  TS       time.Time
  UserID   string
  Amount   float64
  Currency string
  RefID    string
  USD      float64
  RefUSD   float64
  Raw      json.RawMessage
  Shard    string
  Line     int
}

type Reject struct {
  Bucket int             `json:"bucket"`
  Reason string          `json:"reason"`
  Event  json.RawMessage `json:"event"`
}

type ShardLine struct {
  Shard string
  Line  int
  Data  []byte
}

type RateTable struct {
  byDate map[string]map[string]float64
  global map[string]float64
}

func newRateTable() *RateTable {
  return &RateTable{byDate: map[string]map[string]float64{}, global: map[string]float64{}}
}

func (rt *RateTable) rate(date, currency string) (float64, bool) {
  if currency == "USD" {
    return 1.0, true
  }
  if m, ok := rt.byDate[date]; ok {
    if r, ok := m[currency]; ok && r > 0 {
      return r, true
    }
  }
  if r, ok := rt.global[currency]; ok && r > 0 {
    return r, true
  }
  return 0, false
}

type pendingEntry struct {
  id        string
  ts        time.Time
  user      string
  usd       float64
  originRun int
}

type purchaseSurvivor struct {
  id      string
  ts      time.Time
  user    string
  usd     float64
  retired bool
}

type carriedSession struct {
  user         string
  lastTs       time.Time
  sessionIndex int
  startTs      time.Time
}

type loadedState struct {
  version       int
  hasMax        bool
  maxTs         time.Time
  seenIds       map[string]bool
  pending       []pendingEntry
  openSessions  map[string]carriedSession
  runIndex      int
  carryPending  int
  carriedOpen   int
}

type stateStats struct {
  CarryInPending      int `json:"carry_in_pending"`
  CarryOutPending     int `json:"carry_out_pending"`
  RetiredThisRun      int `json:"retired_this_run"`
  TtlDropped          int `json:"ttl_dropped"`
  CrossRunDuplicates  int `json:"cross_run_duplicates"`
  OpenSessionsCarried int `json:"open_sessions_carried"`
  OpenSessionsExtended int `json:"open_sessions_extended"`
  OpenSessionsEvicted int `json:"open_sessions_evicted"`
  RunIndex            int `json:"run_index"`
}

type eventTypeStats struct {
  Count    int   `json:"count"`
  TotalUSD Money `json:"total_usd"`
  AvgUSD   Money `json:"avg_usd"`
}

type hourStats struct {
  Count    int   `json:"count"`
  TotalUSD Money `json:"total_usd"`
}

type sessionsOut struct {
  Total  int            `json:"total"`
  ByUser map[string]int `json:"by_user"`
}

type timeRangeOut struct {
  Start *string `json:"start"`
  End   *string `json:"end"`
}

type anomaliesOut struct {
  Duplicate           int `json:"duplicate"`
  UnresolvedChargeback int `json:"unresolved_chargeback"`
}

type summary struct {
  TotalEvents int                        `json:"total_events"`
  ByType      map[string]eventTypeStats  `json:"by_type"`
  ByHour      map[string]hourStats        `json:"by_hour"`
  Sessions    sessionsOut                `json:"sessions"`
  TimeRange   timeRangeOut               `json:"time_range"`
  Anomalies   anomaliesOut               `json:"anomalies"`
  StateStats  *stateStats                `json:"state_stats,omitempty"`
}

func parseTime(s string) (time.Time, error) {
  t, err := time.Parse(time.RFC3339, s)
  if err != nil {
    return time.Time{}, err
  }
  return t.UTC(), nil
}

func formatTS(t time.Time) string {
  return t.UTC().Format("2006-01-02T15:04:05Z")
}

func hourKey(t time.Time) string {
  return t.UTC().Format("2006-01-02T15")
}

func dateKey(t time.Time) string {
  return t.UTC().Format("2006-01-02")
}

func isDate(s string) bool {
  _, err := time.Parse("2006-01-02", s)
  return err == nil
}

func getString(m map[string]json.RawMessage, keys ...string) (string, bool) {
  for _, k := range keys {
    raw, ok := m[k]
    if !ok {
      continue
    }
    var s string
    if err := json.Unmarshal(raw, &s); err == nil {
      return s, true
    }
  }
  return "", false
}

func getNumberOrString(raw json.RawMessage) (float64, error) {
  trimmed := bytes.TrimSpace(raw)
  if len(trimmed) == 0 {
    return 0, errors.New("empty number")
  }
  if trimmed[0] == '"' {
    var s string
    if err := json.Unmarshal(trimmed, &s); err != nil {
      return 0, err
