 782 func buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {
 783   out := stateFileOut{Version: 1, SeenIDs: seenIDs, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}
 784   if hasCurrentMax {
 785     s := formatTS(currentMax)
 786     out.Watermark.MaxTS = &s
 787   } else if st != nil && st.hasMax {
 788     s := formatTS(st.maxTs)
 789     out.Watermark.MaxTS = &s
 790   }
 791   b, _ := json.MarshalIndent(out, "", "  ")
 792   b = append(b, '\n')
 793   return b
 794 }
