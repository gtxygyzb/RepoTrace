 cfg.outManifest, manifestData, maxPtr); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc buildManifest(cfg cliConfig, runIndex int, ratesDigest string, shards []inputShardInfo, shardAccepted map[string]int, bucketCounts map[string]int, hasMin bool, minTs time.Time, hasMax bool, maxTs time.Time) (manifestOutput, error) {\n\tsortedShards := append([]inputShardInfo(nil), shards...)\n\tsort.SliceStable(sortedShards, func(i, j int) bool {\n\t\treturn sortedShards[i].Name < sortedShards[j].Name\n\t})\n\tmanifestShards := make([]manifestShard, 0, len(sortedShards))\n\tfor _, s := range sortedShards {\n\t\tmanifestShards = append(manifestShards, manifestShard{\n\t\t\tShard:          s.Name,\n\t\t\tSHA256:         s.SHA256,\n\t\t\tBytes:          s.Bytes,\n\t\t\tEventsTotal:    s.EventsTotal,\n\t\t\tEventsAccepted: shardAccepted[s.Name],\n\t\t})\n\t}\n\toutputs := manifestOutputs{}\n\tsummaryOut, err := manifestFileOutputFor(cfg.outputPath)\n\tif err != nil {\n\t\treturn manifestOutput{}, err\n\t}\n\trejectsOut, err := manifestFileOutputFor(cfg.rejectsPath)\n\tif err != nil {\n\t\treturn manifestOutput{}, err\n\t}\n\toutputs.Summary = summaryOut\n\toutputs.Rejects = rejectsOut\n\tif cfg.stateOut != \"\" {\n\t\tstateOut, err := manifestFileOutputFor(cfg.stateOut)\n\t\tif err != nil {\n\t\t\treturn manifestOutput{}, err\n\t\t}\n\t\toutputs.State = stateOut\n\t}\n\tif cfg.auditLog != \"\" {\n\t\tlogOut, err := manifestFileOutputFor(cfg.auditLog)\n\t\tif err != nil {\n\t\t\treturn manifestOutput{}, err\n\t\t}\n\t\toutputs.AuditLog = logOut\n\t}\n\tif cfg.auditLogDigest != \"\" {\n\t\tdigestOut, err := manifestFileOutputFor(cfg.auditLogDigest)\n\t\tif err != nil {\n\t\t\treturn manifestOutput{}, err\n\t\t}\n\t\toutputs.AuditDigest = digestOut\n\t}\n\twindow := manifestWindow{\n\t\tEventsAcceptedTotal: bucketCounts[\"accepted\"],\n\t\tEventsRejectedTotal: bucketCounts[\"duplicate\"] + bucketCounts[\"invalid\"] + bucketCounts[\"late\"] + bucketCounts[\"unresolved_chargeback\"],\n\t\tBucketCounts:        bucketCounts,\n\t}\n\tif hasMin {\n\t\tm := formatTS(minTs)\n\t\twindow.MinTs = &m\n\t}\n\tif hasMax {\n\t\tm := formatTS(maxTs)\n\t\twindow.MaxTs = &m\n\t}\n\tvar ingestID *string\n\tif cfg.ingestIDSet {\n\t\tid := cfg.ingestID\n\t\tingestID = &id\n\t}\n\treturn manifestOutput{\n\t\tSchemaVersion: manifestSchemaVersion,\n\t\tIngestID:      ingestID,\n\t\tRunIndex:      runIndex,\n\t\tRatesDigest:   ratesDigest,\n\t\tInputShards:   manifestShards,\n\t\tOutputs:       outputs,\n\t\tWindow:        window,\n\t}, nil\n}\n\nfunc bucketCode(bucket string) int {\n\tswitch bucket {\n\tcase \"accepted\":\n\t\treturn 0\n\tcase \"duplicate\":\n\t\treturn 1\n\tcase \"invalid\":\n\t\treturn 2\n\tcase \"late\":\n\t\treturn 3\n\tcase \"unresolved_chargeback\":\n\t\treturn 4\n\t}\n\treturn 2\n}\n"
