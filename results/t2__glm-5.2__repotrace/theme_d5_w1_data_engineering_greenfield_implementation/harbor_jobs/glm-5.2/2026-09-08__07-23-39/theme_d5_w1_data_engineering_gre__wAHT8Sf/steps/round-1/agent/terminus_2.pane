type rawJSON json.RawMessage

func (r rawJSON) MarshalJSON() ([]byte, error) {
	if json.Valid(r) {
		return r, nil
	}
	return json.Marshal(string(r))
}

type rawEvent struct {
	Shard   string
	Line    int
	Raw     rawJSON
	Obj     map[string]json.RawMessage
	Invalid bool
}

type eventContext struct {
