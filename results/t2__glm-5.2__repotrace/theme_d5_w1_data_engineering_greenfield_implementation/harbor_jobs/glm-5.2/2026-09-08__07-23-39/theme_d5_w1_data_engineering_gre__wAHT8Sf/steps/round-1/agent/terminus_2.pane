   505	      var dates map[string]json.RawMessage
   506	      if err := json.Unmarshal(raw, &dates); err != nil {
   507	        return nil, err
   508	      }
   509	      for date, raw2 := range dates {
   510	        var currencies map[string]json.RawMessage
   511	        if err := json.Unmarshal(raw2, &currencies); err != nil {
   512	          return nil, err
   513	        }
   514	        for currency, raw3 := range currencies {
   515	          if currency == "USD" {
   516	            continue
   517	          }
   518	          r, err := parseRateRaw(raw3)
   519	          if err != nil {
   520	            return nil, err
   521	          }
   522	          if rt.byDate[date] == nil {
   523	            rt.byDate[date] = map[string]float64{}
   524	          }
   525	          rt.byDate[date][currency] = r
   526	        }
   527	      }
   528	      delete(top, key)
   529	    }
   530	  }
