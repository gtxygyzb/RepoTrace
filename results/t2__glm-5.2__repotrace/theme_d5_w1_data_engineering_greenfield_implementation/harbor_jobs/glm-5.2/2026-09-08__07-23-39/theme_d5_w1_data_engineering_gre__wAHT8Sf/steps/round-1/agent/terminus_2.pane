   274				Line:   raw.Line,
   275				ID:     ctx.IDStr(),
   276				TS:     ctx.TSString(),
   277				Type:   ctx.TypeString(),
   278				Bucket: bucket,
   279				Reason: reason,
   280				Event:  raw.Raw,
   281			})
   282		}
   283	
   284		// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.
   285		groups := map[string][]int{}
   286		for i, c := range candidates {
