func writeAuditLog(path string, entries []auditLogEntry, rotateBytes int) []string {
	var segments []string
	if rotateBytes <= 0 {
		var buf bytes.Buffer
		for _, e := range entries {
			b, err := json.Marshal(e)
			if err != nil {
				panic(err)
			}
			buf.Write(b)
			buf.WriteByte('\n')
		}
		if err := atomicWriteFile(path, buf.Bytes()); err != nil {
			panic(err)
		}
		return []string{path}
	}

	current := path
	var buf bytes.Buffer
	flush := func() {
		if err := atomicWriteFile(current, buf.Bytes()); err != nil {
			panic(err)
		}
		segments = append(segments, current)
		buf.Reset()
	}
	for _, e := range entries {
		b, err := json.Marshal(e)
		if err != nil {
			panic(err)
		}
		rec := append(b, '\n')
		if buf.Len() > 0 && buf.Len()+len(rec) > rotateBytes {
			flush()
			current = fmt.Sprintf("%s.%d", path, len(segments))
		}
		buf.Write(rec)
	}
	if buf.Len() > 0 || len(segments) == 0 {
		flush()
	}
	return segments
}

func computeLateCutoffStats(entries []auditLogEntry) lateCutoffStats {
	stats := lateCutoffStats{}
	for _, e := range entries {
		if e.Bucket == "late" && e.Cutoff != nil {
			if stats.Count == 0 {
				stats.MinCutoffEpoch = e.Cutoff.EpochSeconds
				stats.MaxCutoffEpoch = e.Cutoff.EpochSeconds
			} else {
				if e.Cutoff.EpochSeconds < stats.MinCutoffEpoch {
					stats.MinCutoffEpoch = e.Cutoff.EpochSeconds
				}
				if e.Cutoff.EpochSeconds > stats.MaxCutoffEpoch {
					stats.MaxCutoffEpoch = e.Cutoff.EpochSeconds
				}
			}
			stats.Count++
		}
	}
	return stats
}

func mustJSONString(s string) json.RawMessage {
	b, err := json.Marshal(s)
	if err != nil {
		panic(err)
	}
	return b
}

func mustJSONStringArray(ss []string) json.RawMessage {
	b, err := json.Marshal(ss)
	if err != nil {
		panic(err)
	}
	return b
}

type rejectRecord struct {
	bucket      string
	reason      string
	raw         rawJSON
	winner      bool
	winnerShard string
	winnerLine  int
}

func arrivalLess(a, b *Event) bool {
	if a.Shard != b.Shard {
		return a.Shard < b.Shard
	}
	return a.Line < b.Line
}

func buildRejects(records []rejectRecord, policy string) []byte {
	order := []string{"invalid", "late", "duplicate", "unresolved_chargeback"}
	var buf bytes.Buffer
	for _, bucket := range order {
		for _, r := range records {
			if r.bucket != bucket {
				continue
			}
			buf.Write(r.raw)
			if policy == "first-arrival" {
				buf.WriteByte('\t')
				if r.winner {
					buf.WriteString(r.winnerShard)
					buf.WriteByte('\t')
					buf.WriteString(strconv.Itoa(r.winnerLine))
				} else {
					buf.WriteString("-")
					buf.WriteByte('\t')
					buf.WriteString("-")
				}
			}
			buf.WriteByte('\n')
		}
	}
	return buf.Bytes()
}

