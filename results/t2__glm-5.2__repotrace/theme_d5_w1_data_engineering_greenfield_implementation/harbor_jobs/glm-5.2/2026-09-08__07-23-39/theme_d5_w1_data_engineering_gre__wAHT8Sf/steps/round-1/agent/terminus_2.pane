   183	type summaryField struct {
   184		key   string
   185		value any
   186	}
   187	
   188	func parseSummaryFields(data []byte) ([]summaryField, error) {
   189		dec := json.NewDecoder(bytes.NewReader(data))
   190		dec.UseNumber()
   191		tok, err := dec.Token()
   192		if err != nil {
   193			return nil, err
   194		}
   195		delim, ok := tok.(json.Delim)
   196		if !ok || delim != '{' {
   197			return nil, fmt.Errorf("summary output is not a JSON object")
   198		}
   199		var fields []summaryField
   200		for dec.More() {
   201			keyTok, err := dec.Token()
   202			if err != nil {
   203				return nil, err
   204			}
   205			key, ok := keyTok.(string)
   206			if !ok {
   207				return nil, fmt.Errorf("summary object key is not a string")
   208			}
   209			var val any
   210			if err := dec.Decode(&val); err != nil {
   211				return nil, err
   212			}
   213			fields = append(fields, summaryField{key: key, value: val})
   214		}
   215		if _, err := dec.Token(); err != nil {
   216			return nil, err
   217		}
   218		return fields, nil
   219	}
   220	
   221	func classify(v any) string {
   222		switch val := v.(type) {
   223		case nil:
   224			return "null"
   225		case bool:
   226			return "boolean"
   227		case string:
   228			return "string"
   229		case json.Number:
   230			s := val.String()
   231			if !strings.ContainsAny(s, ".eE") {
   232				return "integer"
   233			}
   234			return "number"
   235		case float64:
   236			if val == float64(int64(val)) {
   237				return "integer"
   238			}
   239			return "number"
   240		case []any:
   241			return "array"
   242		case map[string]any:
   243			return "object"
   244		default:
   245			return "unknown"
   246		}
   247	}
   248	
   249	func descriptorFor(v any, depth int, strict bool) []orderedJSON {
   250		t := classify(v)
   251		entries := []orderedJSON{{key: "type", value: t}}
   252		switch t {
   253		case "array":
   254			arr := v.([]any)
   255			var elementType any
   256			if len(arr) == 0 {
   257				if strict {
   258					elementType = []orderedJSON{{key: "type", value: "unknown"}}
   259				} else {
   260					elementType = nil
   261				}
   262			} else {
   263				elementType = classify(arr[0])
   264			}
   265			entries = append(entries, orderedJSON{key: "element_type", value: elementType})
   266			entries = append(entries, orderedJSON{key: "constraints", value: arrayConstraints(arr, depth, strict)})
   267		case "object":
   268			obj := v.(map[string]any)
   269			entries = append(entries, orderedJSON{key: "fields", value: schemaSortedKeys(obj)})
   270			entries = append(entries, orderedJSON{key: "constraints", value: objectConstraints(obj, depth, strict)})
   271		default:
   272			entries = append(entries, orderedJSON{key: "constraints", value: scalarConstraints(v, t, depth, strict)})
   273		}
   274		return entries
   275	}
   276	
   277	func schemaSortedKeys(obj map[string]any) []any {
   278		keys := make([]string, 0, len(obj))
   279		for k := range obj {
   280			keys = append(keys, k)
   281		}
   282		sort.Strings(keys)
   283		arr := make([]any, len(keys))
   284		for i, k := range keys {
   285			arr[i] = k
   286		}
   287		return arr
   288	}
