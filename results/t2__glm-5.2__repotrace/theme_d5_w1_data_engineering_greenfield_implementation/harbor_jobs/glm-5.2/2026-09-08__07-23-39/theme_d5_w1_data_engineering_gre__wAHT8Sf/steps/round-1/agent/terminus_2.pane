   516	            continue
   517	          }
   518	          r, err := parseRateRaw(raw3)
   519	          if err != nil {
   520	            return nil, err
   521	          }
   522	          if rt.byDate[date] == nil {
   523	            rt.byDate[date] = map[string]float64{}
   524	          }
   525	          rt.byDate[date][currency] = r
   526	        }
   527	      }
   528	      delete(top, key)
   529	    }
   530	  }
   531	  for _, key := range []string{"global", "Global"} {
   532	    if raw, ok := top[key]; ok {
   533	      if err := loadRateMap(rt, raw, true); err != nil {
   534	        return nil, err
   535	      }
   536	      delete(top, key)
   537	    }
   538	  }
   539	  if raw, ok := top["rates"]; ok {
   540	    if err := loadRateMap(rt, raw, true); err != nil {
   541	      return nil, err
   542	    }
   543	    delete(top, "rates")
   544	  }
   545	  for currency, raw := range top {
   546	    if currency == "USD" {
   547	      continue
   548	    }
