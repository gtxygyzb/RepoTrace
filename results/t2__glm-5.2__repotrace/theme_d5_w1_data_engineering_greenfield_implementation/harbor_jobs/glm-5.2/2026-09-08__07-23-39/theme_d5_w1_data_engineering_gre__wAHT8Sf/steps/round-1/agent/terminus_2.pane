   544		type candidate struct {
   545			raw       rawEvent
   546			ctx       *eventContext
   547			ev        *Event
   548			duplicate bool
   549		}
   550		var candidates []candidate
   551		var auditEntries []auditLogEntry
   552	
   553		// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.
   554		for _, raw := range events {
   555			ctx := newContext(raw)
   556			bucket := "invalid"
   557			reason := ""
   558			var ev *Event
   559			var lateCutoff *cutoffObject
   560			var lateLag, lateBySec *int
   561			if raw.Invalid {
   562				bucket = "invalid"
   563				reason = "invalid_json"
   564			} else {
   565				ev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)
   566				if ev != nil {
   567					if seen[ev.ID] {
   568						bucket = "duplicate"
   569						reason = "cross_run"
   570						ev = nil
   571					} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {
   572						bucket = "late"
   573						reason = "late"
   574						cutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)
   575						lateCutoff = ptrCutoff(formatCutoffObject(cutoff))
   576						if cfg.strictLateAudit {
   577							lag := cfg.watermarkLag
   578							lateBy := int(lateCutoff.EpochSeconds - int(epochSeconds(ev.TS)))
   579							lateLag = &lag
   580							lateBySec = &lateBy
   581						}
   582						ev = nil
   583					} else {
   584						bucket = "accepted"
   585						if ev.TS.After(watermark) {
   586							watermark = ev.TS
   587							hasWatermark = true
   588						}
   589					}
   590				} else {
   591					bucket = "invalid"
   592				}
   593			}
   594			if bucket == "invalid" {
   595				invalidReasons[reason]++
   596			}
   597			bucketCounts[bucket]++
   598			if bucket == "duplicate" && reason == "cross_run" {
   599				duplicateReasons["cross_run"]++
   600			}
   601			candidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})
   602			auditEntries = append(auditEntries, auditLogEntry{
   603				Shard:               raw.Shard,
   604				Line:                raw.Line,
