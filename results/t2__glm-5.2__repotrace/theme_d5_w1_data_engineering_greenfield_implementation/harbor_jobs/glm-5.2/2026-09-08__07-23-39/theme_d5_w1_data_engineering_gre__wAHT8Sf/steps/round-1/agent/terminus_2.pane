   283	func parseTime(s string) (time.Time, error) {
   284	  t, err := time.Parse("2006-01-02T15:04:05Z", s)
   285	  if err != nil {
   286	    return time.Time{}, err
   287	  }
   288	  return t.UTC(), nil
   289	}
   290	
   291	func formatTS(t time.Time) string {
   292	  return t.UTC().Format("2006-01-02T15:04:05Z")
   293	}
   294	
   295	func hourKey(t time.Time) string {
   296	  return t.UTC().Format("2006-01-02T15")
   297	}
   298	
   299	func dateKey(t time.Time) string {
   300	  return t.UTC().Format("2006-01-02")
   301	}
   302	
   303	func isDate(s string) bool {
   304	  _, err := time.Parse("2006-01-02", s)
   305	  return err == nil
   306	}
