func dateKey(t time.Time) string {
  return t.UTC().Format("2006-01-02")
}

func isDate(s string) bool {
  _, err := time.Parse("2006-01-02", s)
  return err == nil
}

func getString(m map[string]json.RawMessage, keys ...string) (string, bool) {
  for _, k := range keys {
    raw, ok := m[k]
    if !ok {
      continue
    }
    var s string
    if err := json.Unmarshal(raw, &s); err == nil {
      return s, true
    }
  }
  return "", false
}

func getNumberOrString(raw json.RawMessage) (float64, error) {
  trimmed := bytes.TrimSpace(raw)
  if len(trimmed) == 0 {
    return 0, errors.New("empty number")
  }
  if trimmed[0] == '"' {
    var s string
    if err := json.Unmarshal(trimmed, &s); err != nil {
      return 0, err
    }
    s = strings.TrimSpace(s)
    if parts := strings.Fields(s); len(parts) > 0 {
      s = parts[0]
    }
    return strconv.ParseFloat(s, 64)
  }
  return strconv.ParseFloat(string(trimmed), 64)
}

func roundMoney(f float64) float64 {
  abs := math.Abs(f)
  cents := int64(math.Floor(abs*100.0 + 0.5))
  if f < 0 && cents != 0 {
    return -float64(cents) / 100.0
  }
  return float64(cents) / 100.0
}

func jsonBytes(s string) []byte {
  b, err := json.Marshal(s)
  if err != nil {
    return []byte(`""`)
  }
  return b
}
