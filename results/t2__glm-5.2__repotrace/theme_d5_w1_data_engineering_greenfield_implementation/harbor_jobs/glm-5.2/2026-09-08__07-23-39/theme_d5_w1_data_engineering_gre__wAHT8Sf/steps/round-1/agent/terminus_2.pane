	order := []string{"invalid", "late", "duplicate", "unresolved_chargeback"}
	var buf bytes.Buffer
	for _, bucket := range order {
		for _, r := range records {
			if r.bucket != bucket {
				continue
			}
			buf.Write(r.raw)
			if policy == "first-arrival" {
				buf.WriteByte('\t')
				if r.winner {
					buf.WriteString(r.winnerShard)
					buf.WriteByte('\t')
					buf.WriteString(strconv.Itoa(r.winnerLine))
