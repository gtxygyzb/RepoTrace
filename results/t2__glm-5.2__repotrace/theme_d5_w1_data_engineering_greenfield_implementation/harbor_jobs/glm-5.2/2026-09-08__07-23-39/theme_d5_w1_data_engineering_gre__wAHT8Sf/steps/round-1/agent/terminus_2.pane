   294		dedupPolicyStats.Policy = cfg.dedupPolicy
   295		for id, idxs := range groups {
   296			if len(idxs) < 2 {
   297				if len(idxs) == 1 {
   298					winners[id] = idxs[0]
   299					winnerSet[idxs[0]] = true
   300				}
   301				continue
   302			}
   303			winner := idxs[0]
   304			tiebreak := false
   305			for _, idx := range idxs[1:] {
   306				if cfg.dedupPolicy == "first-arrival" {
   307					if arrivalLess(candidates[idx].ev, candidates[winner].ev) {
   308						winner = idx
   309					}
   310				} else {
   311					cts := candidates[idx].ctx.TSString()
   312					wts := candidates[winner].ctx.TSString()
   313					if cts > wts {
   314						winner = idx
   315						tiebreak = false
   316					} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {
   317						winner = idx
   318						tiebreak = true
   319					}
   320				}
   321			}
   322			if cfg.dedupPolicy == "lex-largest-ts" {
   323				wts := candidates[winner].ctx.TSString()
   324				for _, idx := range idxs {
   325					if idx != winner && candidates[idx].ctx.TSString() == wts {
   326						tiebreak = true
   327						break
   328					}
   329				}
   330			}
   331			winners[id] = winner
   332			winnerSet[winner] = true
   333			sameShard := true
   334			for _, idx := range idxs {
   335				if candidates[idx].ev.Shard != candidates[winner].ev.Shard {
   336					sameShard = false
   337					break
   338				}
   339			}
   340			if sameShard {
   341				dedupPolicyStats.DuplicateWinnersSameShard++
