   195	func run(cfg cliConfig) error {
   196		ratesData, err := os.ReadFile(cfg.ratesPath)
   197		if err != nil {
   198			return fmt.Errorf("ingest: rates: %w", err)
   199		}
   200		ratesDigest := sha256Hex(ratesData)
   201		rt, err := loadRates(cfg.ratesPath)
   202		if err != nil {
   203			return err
   204		}
   205		var st *loadedState
   206		runIndex := 1
   207		if cfg.stateIn != "" {
   208			st, err = loadState(cfg.stateIn, cfg.stateStrict)
   209			if err != nil && !os.IsNotExist(err) {
   210				return err
   211			}
   212			if st != nil {
   213				runIndex = st.runIndex + 1
   214			}
   215		}
   216		events, shards, err := readInputEvents(cfg.inputDir)
   217		if err != nil {
   218			return err
   219		}
   220		seen := map[string]bool{}
   221		if st != nil {
   222			for k, v := range st.seenIds {
   223				seen[k] = v
   224			}
   225		}
   226		var pending []pendingEntry
   227		openSessions := map[string]carriedSession{}
   228		if st != nil {
   229			pending = append([]pendingEntry(nil), st.pending...)
   230			for k, v := range st.openSessions {
   231				openSessions[k] = v
   232			}
   233		}
   234		bucketCounts := map[string]int{"accepted": 0, "duplicate": 0, "invalid": 0, "late": 0, "unresolved_chargeback": 0}
   235		invalidReasons := map[string]int{}
   236		duplicateReasons := map[string]int{"same_run": 0, "cross_run": 0}
   237		fxFallbackStats := map[string]int{"0": 0}
   238		shardAccepted := map[string]int{}
   239		var minTs, maxTs time.Time
   240		hasMin, hasMax := false, false
   241		var watermark time.Time
   242		hasWatermark := false
   243		if st != nil {
   244			watermark = st.maxTs
   245			hasWatermark = st.hasMax
   246		}
   247	
   248		type candidate struct {
   249			raw       rawEvent
   250			ctx       *eventContext
   251			ev        *Event
   252			duplicate bool
   253		}
   254		var candidates []candidate
   255		var auditEntries []auditLogEntry
   256	
   257		// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.
   258		for _, raw := range events {
   259			ctx := newContext(raw)
   260			bucket := "invalid"
   261			reason := ""
   262			var ev *Event
   263			if raw.Invalid {
   264				bucket = "invalid"
   265				reason = "invalid_json"
   266			} else {
   267				ev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)
   268				if ev != nil {
   269					if seen[ev.ID] {
   270						bucket = "duplicate"
   271						reason = "cross_run"
   272						ev = nil
   273					} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {
   274						bucket = "late"
   275						reason = "late"
   276						cutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)
   277						entry := auditLogEntry{
   278							Shard:  raw.Shard,
   279							Line:   raw.Line,
   280							ID:     ctx.IDStr(),
   281							TS:     ctx.TSString(),
   282							Type:   ctx.TypeString(),
   283							Bucket: bucket,
   284							Cutoff: ptrCutoff(formatCutoffObject(cutoff)),
   285						}
   286						if cfg.strictLateAudit {
   287							lag := cfg.watermarkLag
   288							lateBy := int(entry.Cutoff.EpochSeconds - int(epochSeconds(ev.TS)))
   289							entry.WatermarkLagSeconds = &lag
   290							entry.LateBySeconds = &lateBy
   291						}
   292						auditEntries = append(auditEntries, entry)
   293						ev = nil
   294					} else {
   295						bucket = "accepted"
   296						if ev.TS.After(watermark) {
   297							watermark = ev.TS
   298							hasWatermark = true
   299						}
   300					}
   301				} else {
   302					bucket = "invalid"
   303				}
   304			}
   305			if bucket == "invalid" {
   306				invalidReasons[reason]++
   307			}
   308			bucketCounts[bucket]++
   309			if bucket == "duplicate" && reason == "cross_run" {
   310				duplicateReasons["cross_run"]++
   311			}
   312			candidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})
   313			auditEntries = append(auditEntries, auditLogEntry{
   314				Shard:  raw.Shard,
   315				Line:   raw.Line,
   316				ID:     ctx.IDStr(),
   317				TS:     ctx.TSString(),
   318				Type:   ctx.TypeString(),
   319				Bucket: bucket,
   320				Reason: reason,
   321				Event:  raw.Raw,
   322			})
   323		}
   324	
   325		// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.
   326		groups := map[string][]int{}
   327		for i, c := range candidates {
   328			if c.ev != nil {
   329				groups[c.ev.ID] = append(groups[c.ev.ID], i)
   330			}
   331		}
   332		winnerSet := map[int]bool{}
   333		winners := map[string]int{}
   334		var dedupPolicyStats dedupPolicyStats
   335		dedupPolicyStats.Policy = cfg.dedupPolicy
   336		for id, idxs := range groups {
   337			if len(idxs) < 2 {
   338				if len(idxs) == 1 {
   339					winners[id] = idxs[0]
   340					winnerSet[idxs[0]] = true
   341				}
   342				continue
   343			}
   344			winner := idxs[0]
   345			tiebreak := false
   346			for _, idx := range idxs[1:] {
   347				if cfg.dedupPolicy == "first-arrival" {
   348					if arrivalLess(candidates[idx].ev, candidates[winner].ev) {
   349						winner = idx
   350					}
   351				} else {
   352					cts := candidates[idx].ctx.TSString()
   353					wts := candidates[winner].ctx.TSString()
   354					if cts > wts {
   355						winner = idx
   356						tiebreak = false
   357					} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {
   358						winner = idx
   359						tiebreak = true
   360					}
[?2004hroot@n30009:/app# nl -ba cli.go | sed -n '361,620p'
[?2004l   361				}
   362			}
   363			if cfg.dedupPolicy == "lex-largest-ts" {
   364				wts := candidates[winner].ctx.TSString()
   365				for _, idx := range idxs {
   366					if idx != winner && candidates[idx].ctx.TSString() == wts {
   367						tiebreak = true
   368						break
   369					}
   370				}
   371			}
   372			winners[id] = winner
   373			winnerSet[winner] = true
   374			sameShard := true
   375			for _, idx := range idxs {
   376				if candidates[idx].ev.Shard != candidates[winner].ev.Shard {
   377					sameShard = false
   378					break
   379				}
   380			}
   381			if sameShard {
   382				dedupPolicyStats.DuplicateWinnersSameShard++
   383				if cfg.dedupPolicy == "first-arrival" || tiebreak {
   384					dedupPolicyStats.DuplicateWinnersLineTiebreak++
   385				}
   386			} else {
   387				dedupPolicyStats.DuplicateWinnersCrossShard++
   388			}
   389		}
   390	
   391		// Finalize accepted/duplicate buckets and outputs in arrival order.
   392		hasMin, hasMax = false, false
   393		for _, c := range candidates {
   394			if c.ev != nil {
   395				seen[c.ev.ID] = true
   396			}
   397		}
   398		bucketCounts["accepted"] = 0
   399		bucketCounts["duplicate"] = duplicateReasons["cross_run"]
   400		for i, c := range candidates {
   401			_ = i
   402			if c.ev == nil {
   403				continue
   404			}
   405			if winnerSet[i] {
   406				bucketCounts["accepted"]++
   407				shardAccepted[c.ev.Shard]++
   408				if !hasMin || c.ev.TS.Before(minTs) {
   409					minTs = c.ev.TS
   410					hasMin = true
   411				}
   412				if !hasMax || c.ev.TS.After(maxTs) {
   413					maxTs = c.ev.TS
   414					hasMax = true
   415				}
   416				_ = pending
   417				_ = openSessions
   418			} else {
   419				bucketCounts["duplicate"]++
   420				duplicateReasons["same_run"]++
   421				entry := auditEntries[i]
   422				entry.Bucket = "duplicate"
   423				entry.Reason = "same_run"
   424				if cfg.dedupPolicy == "first-arrival" {
   425					w := winners[entry.ID]
   426					entry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}
   427				}
   428				auditEntries[i] = entry
   429			}
   430		}
   431	
   432		var rejectRecords []rejectRecord
   433		for i, c := range candidates {
