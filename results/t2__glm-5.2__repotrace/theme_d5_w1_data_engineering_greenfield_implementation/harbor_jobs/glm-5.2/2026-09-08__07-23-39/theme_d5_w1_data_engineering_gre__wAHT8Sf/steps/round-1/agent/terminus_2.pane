   772	
   773	func writeAuditLog(path string, entries []auditLogEntry, rotateBytes int) []string {
   774		var segments []string
   775		if rotateBytes <= 0 {
   776			var buf bytes.Buffer
   777			for _, e := range entries {
   778				b, err := json.Marshal(e)
   779				if err != nil {
   780					panic(err)
   781				}
   782				buf.Write(b)
   783				buf.WriteByte('\n')
   784			}
   785			if err := atomicWriteFile(path, buf.Bytes()); err != nil {
   786				panic(err)
   787			}
   788			return []string{path}
   789		}
   790	
   791		current := path
   792		var buf bytes.Buffer
   793		flush := func() {
   794			if err := atomicWriteFile(current, buf.Bytes()); err != nil {
   795				panic(err)
   796			}
   797			segments = append(segments, current)
   798			buf.Reset()
   799		}
   800		for _, e := range entries {
   801			b, err := json.Marshal(e)
   802			if err != nil {
   803				panic(err)
   804			}
   805			rec := append(b, '\n')
   806			if buf.Len() > 0 && buf.Len()+len(rec) > rotateBytes {
   807				flush()
   808				current = fmt.Sprintf("%s.%d", path, len(segments))
   809			}
   810			buf.Write(rec)
   811		}
   812		if buf.Len() > 0 || len(segments) == 0 {
   813			flush()
   814		}
   815		return segments
   816	}
