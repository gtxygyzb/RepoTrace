type Event struct {
	ID       string
	Type     string
	TS       time.Time
	UserID   string
	Amount   float64
	Currency string
	RefID    string
	USD      float64
	RefUSD   float64
	Raw      json.RawMessage
	Shard    string
	Line     int
}

type Reject struct {
	Bucket int             `json:"bucket"`
	Reason string          `json:"reason"`
	Event  json.RawMessage `json:"event,omitempty"`
	Line   string          `json:"line,omitempty"`
}

type ShardLine struct {
	Shard string
	Line  int
	Data  []byte
}

type RateTable struct {
	byDate map[string]map[string]float64
	global map[string]float64
}

func newRateTable() *RateTable {
	return &RateTable{byDate: map[string]map[string]float64{}, global: map[string]float64{}}
}

func (rt *RateTable) rate(date, currency string) (float64, bool) {
	if currency == "USD" {
		return 1.0, true
	}
	if m, ok := rt.byDate[date]; ok {
		if r, ok := m[currency]; ok && r > 0 {
			return r, true
		}
	}
	if r, ok := rt.global[currency]; ok && r > 0 {
		return r, true
	}
	return 0, false
}

type pendingEntry struct {
	id        string
	ts        time.Time
	user      string
	usd       float64
	originRun int
}

type purchaseSurvivor struct {
	event   *Event
	id      string
	ts      time.Time
	user    string
	usd     float64
	retired bool
}

type carriedSession struct {
	user         string
	lastTs       time.Time
	sessionIndex int
	startTs      time.Time
}

func parseTime(s string) (time.Time, error) {
	t, err := time.Parse(time.RFC3339, s)
	if err != nil {
		return time.Time{}, err
	}
	return t.UTC(), nil
}

func formatTS(t time.Time) string {
	return t.UTC().Format("2006-01-02T15:04:05Z")
}

func hourKey(t time.Time) string {
	return t.UTC().Format("2006-01-02T15")
}

func dateKey(t time.Time) string {
	return t.UTC().Format("2006-01-02")
}

func isDate(s string) bool {
	_, err := time.Parse("2006-01-02", s)
	return err == nil
}

func getString(m map[string]json.RawMessage, keys ...string) (string, bool) {
	for _, k := range keys {
		raw, ok := m[k]
		if !ok {
			continue
		}
		var s string
		if err := json.Unmarshal(raw, &s); err == nil {
			return s, true
		}
	}
	return "", false
}

func getNumberOrString(raw json.RawMessage) (float64, error) {
	trimmed := bytes.TrimSpace(raw)
	if len(trimmed) == 0 {
		return 0, errors.New("empty number")
	}
	if trimmed[0] == '"' {
		var s string
		if err := json.Unmarshal(trimmed, &s); err != nil {
			return 0, err
		}
		s = strings.TrimSpace(s)
		if parts := strings.Fields(s); len(parts) > 0 {
			s = parts[0]
		}
		return strconv.ParseFloat(s, 64)
	}
	return strconv.ParseFloat(string(trimmed), 64)
}
