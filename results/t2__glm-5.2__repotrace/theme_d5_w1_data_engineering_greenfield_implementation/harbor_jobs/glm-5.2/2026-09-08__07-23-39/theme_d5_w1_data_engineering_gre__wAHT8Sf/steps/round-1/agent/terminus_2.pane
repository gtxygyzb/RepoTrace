   304			watermark = st.maxTs
   305			hasWatermark = st.hasMax
   306		}
   307	
   308		type candidate struct {
   309			raw       rawEvent
   310			ctx       *eventContext
   311			ev        *Event
   312			duplicate bool
   313		}
   314		var candidates []candidate
   315		var auditEntries []auditLogEntry
   316	
   317		// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.
   318		for _, raw := range events {
   319			ctx := newContext(raw)
   320			bucket := "invalid"
   321			reason := ""
   322			var ev *Event
   323			if raw.Invalid {
   324				bucket = "invalid"
   325				reason = "invalid_json"
   326			} else {
   327				ev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)
   328				if ev != nil {
