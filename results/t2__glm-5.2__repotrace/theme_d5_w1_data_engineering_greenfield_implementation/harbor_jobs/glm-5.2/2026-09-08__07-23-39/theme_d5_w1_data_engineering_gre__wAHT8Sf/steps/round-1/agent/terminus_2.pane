   306	func newContext(raw rawEvent) *eventContext {
   307		ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}
   308		if raw.Obj != nil {
   309			ctx.ID = rawStringPtr(raw.Obj, "id")
   310			ctx.TS = rawStringPtr(raw.Obj, "ts")
   311			ctx.Type = rawStringPtr(raw.Obj, "type")
   312		}
   313		return ctx
   314	}
   315	
   316	func parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {
   317		obj := ctx.Obj
   318		if obj == nil {
   319			return nil, "invalid_json"
   320		}
   321		raw, ok := obj["v"]
   322		if !ok {
   323			return nil, "schema_version"
   324		}
   325		var v int
   326		if err := json.Unmarshal(raw, &v); err != nil {
   327			return nil, "schema_version"
   328		}
   329		if v != 1 && v != 2 {
   330			return nil, "schema_version"
   331		}
   332		id, idOk, _ := getRawString(obj, "id")
   333		if !idOk || id == "" {
   334			return nil, "missing_id"
   335		}
   336		tsStr, tsOk, _ := getRawString(obj, "ts")
   337		if !tsOk {
   338			return nil, "missing_ts"
   339		}
   340		t, err := parseTime(tsStr)
   341		if err != nil {
   342			return nil, "bad_ts"
   343		}
   344		typeStr, typeOk, _ := getRawString(obj, "type")
   345		if !typeOk {
   346			return nil, "missing_type"
   347		}
   348		switch typeStr {
   349		case "purchase", "refund", "chargeback", "login", "signup":
   350		default:
   351			return nil, "bad_type"
   352		}
   353		user, userOk, _ := getRawString(obj, "user_id")
   354		if !userOk || user == "" {
   355			return nil, "missing_user"
   356		}
   357		ev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}
   358		switch typeStr {
   359		case "purchase", "refund":
   360			var amount float64
   361			if v == 1 {
   362				raw, present := obj["amount"]
   363				if !present {
   364					return nil, "missing_amount"
   365				}
   366				var f float64
   367				if err := json.Unmarshal(raw, &f); err != nil {
   368					return nil, "bad_amount"
   369				}
   370				if !isFinite(f) || f < 0 {
   371					return nil, "bad_amount"
   372				}
   373				amount = f
   374			} else {
   375				raw, present := obj["amount_cents"]
   376				if !present {
   377					return nil, "missing_amount"
   378				}
   379				n, err := getJSONInt(raw)
   380				if err != nil || n < 0 {
   381					return nil, "bad_amount"
   382				}
   383				amount = float64(n) / 100.0
   384			}
   385			cur, curOk, curPresent := getRawString(obj, "currency")
   386			if !curPresent {
   387				return nil, "missing_currency"
   388			}
   389			if !curOk || cur == "" {
   390				return nil, "bad_currency"
   391			}
   392			rate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)
   393			switch status {
   394			case "fx_unknown_currency":
   395				return nil, "fx_unknown_currency"
   396			case "missing_rate":
   397				return nil, "fx_no_rate_for_date"
   398			case "bad_rate":
   399				if ratesStrict {
   400					return nil, "fx_bad_rate"
   401				}
   402				return nil, "fx_no_rate_for_date"
   403			}
   404			usd := amount * rate
   405			if typeStr == "refund" {
   406				usd = -usd
   407			}
   408			ev.Amount = amount
   409			ev.Currency = cur
   410			ev.FXFallbackDays = fallbackDays
   411			ev.USD = roundMoney(usd)
   412		case "chargeback":
   413			ref, refOk, refPresent := getRawString(obj, "ref_id")
   414			if !refPresent || !refOk || ref == "" {
   415				return nil, "missing_ref_id"
   416			}
   417			ev.RefID = ref
   418			ev.USD = 0
   419		case "login", "signup":
   420			ev.USD = 0
   421		}
   422		return ev, ""
   423	}
