   214		}
   215		if _, err := dec.Token(); err != nil {
   216			return nil, err
   217		}
   218		return fields, nil
   219	}
   220	
   221	func classify(v any) string {
   222		switch val := v.(type) {
   223		case nil:
   224			return "null"
   225		case bool:
   226			return "boolean"
   227		case string:
   228			return "string"
   229		case json.Number:
   230			s := val.String()
   231			if !strings.ContainsAny(s, ".eE") {
   232				return "integer"
   233			}
   234			return "number"
   235		case float64:
   236			if val == float64(int64(val)) {
   237				return "integer"
   238			}
   239			return "number"
   240		case []any:
   241			return "array"
   242		case map[string]any:
   243			return "object"
   244		default:
   245			return "unknown"
   246		}
   247	}
   248	
   249	func descriptorFor(v any, depth int, strict bool) []orderedJSON {
   250		t := classify(v)
   251		entries := []orderedJSON{{key: "type", value: t}}
   252		switch t {
   253		case "array":
   254			arr := v.([]any)
   255			var elementType any
   256			if len(arr) == 0 {
   257				if strict {
   258					elementType = []orderedJSON{{key: "type", value: "unknown"}}
   259				} else {
   260					elementType = nil
   261				}
   262			} else {
   263				elementType = classify(arr[0])
   264			}
   265			entries = append(entries, orderedJSON{key: "element_type", value: elementType})
   266			entries = append(entries, orderedJSON{key: "constraints", value: arrayConstraints(arr, depth, strict)})
   267		case "object":
   268			obj := v.(map[string]any)
   269			entries = append(entries, orderedJSON{key: "fields", value: schemaSortedKeys(obj)})
   270			entries = append(entries, orderedJSON{key: "constraints", value: objectConstraints(obj, depth, strict)})
   271		default:
   272			entries = append(entries, orderedJSON{key: "constraints", value: scalarConstraints(v, t, depth, strict)})
   273		}
   274		return entries
   275	}
   276	
   277	func schemaSortedKeys(obj map[string]any) []any {
   278		keys := make([]string, 0, len(obj))
   279		for k := range obj {
   280			keys = append(keys, k)
   281		}
   282		sort.Strings(keys)
   283		arr := make([]any, len(keys))
   284		for i, k := range keys {
   285			arr[i] = k
   286		}
   287		return arr
   288	}
   289	
   290	func scalarConstraints(v any, t string, depth int, strict bool) []orderedJSON {
   291		var entries []orderedJSON
   292		switch t {
   293		case "integer":
   294			if isNonNegativeInteger(v) {
   295				entries = append(entries, orderedJSON{key: "non_negative", value: true})
   296			}
   297			if strict && depth == 0 && isZeroInteger(v) {
   298				entries = append(entries, orderedJSON{key: "zero_observed", value: true})
   299			}
   300		case "string":
   301			if isRFC3339UTCZ(v.(string)) {
   302				entries = append(entries, orderedJSON{key: "format", value: "rfc3339-utc-z"})
   303			}
   304		}
   305		return entries
   306	}
   307	
   308	func arrayConstraints(arr []any, depth int, strict bool) []orderedJSON {
   309		var entries []orderedJSON
   310		if len(arr) > 0 && classify(arr[0]) == "object" {
   311			if depth < 2 {
   312				entries = append(entries, orderedJSON{key: "element_subfields", value: elementSubfields(arr[0].(map[string]any), depth+1, strict)})
   313			}
   314		}
   315		homogeneous := true
   316		if len(arr) == 0 {
   317			homogeneous = !strict
   318		} else {
   319			first := classify(arr[0])
   320			for _, e := range arr[1:] {
   321				if classify(e) != first {
   322					homogeneous = false
   323					break
   324				}
   325			}
   326		}
   327		entries = append(entries, orderedJSON{key: "homogeneous", value: homogeneous})
   328		entries = append(entries, orderedJSON{key: "length", value: len(arr)})
   329		return entries
   330	}
   331	
   332	func objectConstraints(obj map[string]any, depth int, strict bool) []orderedJSON {
   333		entries := []orderedJSON{{key: "field_count", value: len(obj)}}
   334		if len(obj) > 0 && depth < 1 {
   335			entries = append(entries, orderedJSON{key: "subfields", value: subfields(obj, depth+1, strict)})
   336		}
   337		return entries
   338	}
   339	
   340	func subfields(obj map[string]any, depth int, strict bool) []orderedJSON {
   341		keys := make([]string, 0, len(obj))
   342		for k := range obj {
   343			keys = append(keys, k)
   344		}
   345		sort.Strings(keys)
   346		entries := make([]orderedJSON, 0, len(keys))
   347		for _, k := range keys {
   348			entries = append(entries, orderedJSON{key: k, value: descriptorFor(obj[k], depth, strict)})
   349		}
   350		return entries
   351	}
   352	
   353	func elementSubfields(obj map[string]any, depth int, strict bool) []orderedJSON {
   354		return subfields(obj, depth, strict)
   355	}
