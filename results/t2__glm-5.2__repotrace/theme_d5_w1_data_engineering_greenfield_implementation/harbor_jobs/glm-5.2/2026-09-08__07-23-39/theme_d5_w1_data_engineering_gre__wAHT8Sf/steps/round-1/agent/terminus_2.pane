   566	func writeAuditLog(path string, entries []auditLogEntry, rotateBytes int) []string {
   567		var segments []string
   568		if rotateBytes <= 0 {
   569			var buf bytes.Buffer
   570			for _, e := range entries {
   571				b, err := json.Marshal(e)
   572				if err != nil {
   573					panic(err)
   574				}
   575				buf.Write(b)
   576				buf.WriteByte('\n')
   577			}
   578			if err := atomicWriteFile(path, buf.Bytes()); err != nil {
   579				panic(err)
   580			}
   581			return []string{path}
   582		}
   583	
   584		current := path
   585		var buf bytes.Buffer
   586		flush := func() {
   587			if err := atomicWriteFile(current, buf.Bytes()); err != nil {
   588				panic(err)
   589			}
   590			segments = append(segments, current)
   591			buf.Reset()
   592		}
   593		for _, e := range entries {
   594			b, err := json.Marshal(e)
   595			if err != nil {
   596				panic(err)
   597			}
   598			rec := append(b, '\n')
   599			if buf.Len() > 0 && buf.Len()+len(rec) > rotateBytes {
   600				flush()
   601				current = fmt.Sprintf("%s.%d", path, len(segments))
   602			}
   603			buf.Write(rec)
   604		}
   605		if buf.Len() > 0 || len(segments) == 0 {
   606			flush()
   607		}
   608		return segments
   609	}
