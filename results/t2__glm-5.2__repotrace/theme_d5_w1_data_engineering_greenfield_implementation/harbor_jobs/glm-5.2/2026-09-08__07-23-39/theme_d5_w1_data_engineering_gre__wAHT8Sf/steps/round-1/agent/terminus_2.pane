[?2004lpackage main

import (
"bytes"
"crypto/sha256"
"encoding/hex"
"encoding/json"
"fmt"
"math"
"os"
"path/filepath"
"strings"
"time"
)

func rawStringPtr(obj map[string]json.RawMessage, key string) *string {
if obj == nil {
return nil
}
raw, ok := obj[key]
if !ok {
return nil
}
var s string
if err := json.Unmarshal(raw, &s); err != nil {
