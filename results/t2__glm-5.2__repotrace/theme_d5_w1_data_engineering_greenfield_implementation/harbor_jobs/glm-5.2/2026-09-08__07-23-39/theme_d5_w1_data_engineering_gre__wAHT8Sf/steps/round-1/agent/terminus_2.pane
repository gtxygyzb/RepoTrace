   260		if err != nil {
   261			return nil, nil, err
   262		}
   263		if !info.IsDir() {
   264			return nil, nil, errors.New("input-dir is not a directory")
   265		}
   266		entries, err := os.ReadDir(inputDir)
   267		if err != nil {
   268			return nil, nil, err
   269		}
   270		var files []string
   271		for _, e := range entries {
   272			if e.IsDir() || !e.Type().IsRegular() {
   273				continue
   274			}
   275			files = append(files, e.Name())
   276		}
   277		sort.Strings(files)
   278		var events []rawEvent
   279		var shards []inputShardInfo
   280		for _, name := range files {
   281			data, err := os.ReadFile(filepath.Join(inputDir, name))
   282			if err != nil {
   283				return nil, nil, err
   284			}
   285			si := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}
   286			lineNo := 0
   287			for _, line := range bytes.Split(data, []byte{'\n'}) {
   288				lineNo++
   289				trimmed := bytes.TrimSpace(line)
   290				if len(trimmed) == 0 {
   291					continue
   292				}
   293				si.EventsTotal++
   294				var obj map[string]json.RawMessage
   295				invalid := false
   296				if err := json.Unmarshal(trimmed, &obj); err != nil {
   297					invalid = true
   298				}
   299				events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})
   300			}
   301			shards = append(shards, si)
   302		}
   303		return events, shards, nil
