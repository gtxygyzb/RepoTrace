[?2004lfunc parseEvent(ctx *eventContext, rt *RateTable) (*Event, string) {
  obj := ctx.Obj
  raw, ok := obj["v"]
  if !ok {
    return nil, "schema_version"
  }
  var v int
  if err := json.Unmarshal(raw, &v); err != nil {
    return nil, "schema_version"
  }
  if v != 1 && v != 2 {
    return nil, "schema_version"
  }
  id, idOk, _ := getRawString(obj, "id")
  if !idOk || id == "" {
    return nil, "missing_id"
  }
  tsStr, tsOk, _ := getRawString(obj, "ts")
  if !tsOk {
    return nil, "missing_ts"
  }
  t, err := parseTime(tsStr)
  if err != nil {
    return nil, "bad_ts"
  }
  typeStr, typeOk, _ := getRawString(obj, "type")
  if !typeOk {
    return nil, "missing_type"
  }
  switch typeStr {
  case "purchase", "refund", "chargeback", "login", "signup":
  default:
    return nil, "bad_type"
  }
  user, userOk, _ := getRawString(obj, "user_id")
  if !userOk || user == "" {
    return nil, "missing_user"
