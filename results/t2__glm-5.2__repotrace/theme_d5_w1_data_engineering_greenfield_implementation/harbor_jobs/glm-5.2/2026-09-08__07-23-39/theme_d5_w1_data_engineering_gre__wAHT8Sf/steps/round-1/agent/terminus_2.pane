   175	func nextArg(args []string, i *int) string {
   176		if *i+1 >= len(args) {
   177			panic(fmt.Errorf("ingest: missing value for %s", args[*i]))
   178		}
   179		*i++
   180		return args[*i]
   181	}
   182	
   183	func atoiOrError(s, flag string) int {
   184		n, err := strconv.Atoi(s)
   185		if err != nil {
   186			panic(fmt.Errorf("ingest: invalid integer for %s: %s", flag, s))
   187		}
   188		return n
   189	}
