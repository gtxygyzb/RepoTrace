   420				continue
   421			}
   422			winner := idxs[0]
   423			tiebreak := false
   424			for _, idx := range idxs[1:] {
   425				if cfg.dedupPolicy == "first-arrival" {
   426					if arrivalLess(candidates[idx].ev, candidates[winner].ev) {
   427						winner = idx
   428					}
   429				} else {
   430					cts := candidates[idx].ctx.TSString()
   431					wts := candidates[winner].ctx.TSString()
   432					if cts > wts {
   433						winner = idx
   434						tiebreak = false
   435					} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {
   436						winner = idx
   437						tiebreak = true
   438					}
   439				}
   440			}
   441			if cfg.dedupPolicy == "lex-largest-ts" {
   442				wts := candidates[winner].ctx.TSString()
   443				for _, idx := range idxs {
   444					if idx != winner && candidates[idx].ctx.TSString() == wts {
   445						tiebreak = true
   446						break
   447					}
   448				}
   449			}
   450			winners[id] = winner
   451			winnerSet[winner] = true
   452			sameShard := true
   453			for _, idx := range idxs {
   454				if candidates[idx].ev.Shard != candidates[winner].ev.Shard {
   455					sameShard = false
   456					break
   457				}
   458			}
   459			if sameShard {
   460				dedupPolicyStats.DuplicateWinnersSameShard++
   461				if cfg.dedupPolicy == "first-arrival" || tiebreak {
   462					dedupPolicyStats.DuplicateWinnersLineTiebreak++
   463				}
   464			} else {
   465				dedupPolicyStats.DuplicateWinnersCrossShard++
   466			}
   467		}
   468	
