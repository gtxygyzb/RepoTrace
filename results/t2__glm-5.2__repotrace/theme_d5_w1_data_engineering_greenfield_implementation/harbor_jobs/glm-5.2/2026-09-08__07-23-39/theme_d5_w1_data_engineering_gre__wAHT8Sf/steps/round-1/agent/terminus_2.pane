   258	func readInputEvents(inputDir string) ([]rawEvent, []inputShardInfo, error) {
   259		info, err := os.Stat(inputDir)
   260		if err != nil {
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '261,560p'
[?2004l   261			return nil, nil, err
   262		}
   263		if !info.IsDir() {
   264			return nil, nil, errors.New("input-dir is not a directory")
   265		}
   266		entries, err := os.ReadDir(inputDir)
   267		if err != nil {
   268			return nil, nil, err
   269		}
   270		var files []string
   271		for _, e := range entries {
   272			if e.IsDir() || !e.Type().IsRegular() {
   273				continue
   274			}
   275			files = append(files, e.Name())
   276		}
   277		sort.Strings(files)
   278		var events []rawEvent
   279		var shards []inputShardInfo
   280		for _, name := range files {
   281			data, err := os.ReadFile(filepath.Join(inputDir, name))
   282			if err != nil {
   283				return nil, nil, err
   284			}
   285			si := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}
   286			lineNo := 0
   287			for _, line := range bytes.Split(data, []byte{'\n'}) {
   288				lineNo++
   289				trimmed := bytes.TrimSpace(line)
   290				if len(trimmed) == 0 {
   291					continue
   292				}
   293				si.EventsTotal++
   294				var obj map[string]json.RawMessage
   295				invalid := false
   296				if err := json.Unmarshal(trimmed, &obj); err != nil {
   297					invalid = true
   298				}
   299				events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})
   300			}
   301			shards = append(shards, si)
   302		}
   303		return events, shards, nil
   304	}
   305	
   306	func newContext(raw rawEvent) *eventContext {
   307		ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}
   308		if raw.Obj != nil {
   309			ctx.ID = rawStringPtr(raw.Obj, "id")
   310			ctx.TS = rawStringPtr(raw.Obj, "ts")
   311			ctx.Type = rawStringPtr(raw.Obj, "type")
   312		}
   313		return ctx
   314	}
   315	
   316	func parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {
   317		obj := ctx.Obj
   318		if obj == nil {
   319			return nil, "invalid_json"
   320		}
   321		raw, ok := obj["v"]
   322		if !ok {
   323			return nil, "schema_version"
   324		}
   325		var v int
   326		if err := json.Unmarshal(raw, &v); err != nil {
   327			return nil, "schema_version"
   328		}
   329		if v != 1 && v != 2 {
   330			return nil, "schema_version"
   331		}
   332		id, idOk, _ := getRawString(obj, "id")
   333		if !idOk || id == "" {
   334			return nil, "missing_id"
   335		}
   336		tsStr, tsOk, _ := getRawString(obj, "ts")
   337		if !tsOk {
   338			return nil, "missing_ts"
   339		}
   340		t, err := parseTime(tsStr)
   341		if err != nil {
   342			return nil, "bad_ts"
   343		}
   344		typeStr, typeOk, _ := getRawString(obj, "type")
   345		if !typeOk {
   346			return nil, "missing_type"
   347		}
   348		switch typeStr {
   349		case "purchase", "refund", "chargeback", "login", "signup":
   350		default:
   351			return nil, "bad_type"
   352		}
   353		user, userOk, _ := getRawString(obj, "user_id")
   354		if !userOk || user == "" {
   355			return nil, "missing_user"
   356		}
   357		ev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}
   358		switch typeStr {
   359		case "purchase", "refund":
   360			var amount float64
   361			if v == 1 {
   362				raw, present := obj["amount"]
   363				if !present {
   364					return nil, "missing_amount"
   365				}
   366				var f float64
   367				if err := json.Unmarshal(raw, &f); err != nil {
   368					return nil, "bad_amount"
   369				}
   370				if !isFinite(f) || f < 0 {
   371					return nil, "bad_amount"
   372				}
   373				amount = f
   374			} else {
   375				raw, present := obj["amount_cents"]
   376				if !present {
   377					return nil, "missing_amount"
   378				}
   379				n, err := getJSONInt(raw)
   380				if err != nil || n < 0 {
   381					return nil, "bad_amount"
   382				}
   383				amount = float64(n) / 100.0
   384			}
   385			cur, curOk, curPresent := getRawString(obj, "currency")
   386			if !curPresent {
   387				return nil, "missing_currency"
   388			}
   389			if !curOk || cur == "" {
   390				return nil, "bad_currency"
   391			}
   392			rate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)
   393			switch status {
   394			case "fx_unknown_currency":
   395				return nil, "fx_unknown_currency"
   396			case "missing_rate":
   397				return nil, "fx_no_rate_for_date"
   398			case "bad_rate":
   399				if ratesStrict {
   400					return nil, "fx_bad_rate"
   401				}
   402				return nil, "fx_no_rate_for_date"
   403			}
   404			usd := amount * rate
   405			if typeStr == "refund" {
   406				usd = -usd
   407			}
   408			ev.Amount = amount
   409			ev.Currency = cur
   410			ev.FXFallbackDays = fallbackDays
   411			ev.USD = roundMoney(usd)
   412		case "chargeback":
   413			ref, refOk, refPresent := getRawString(obj, "ref_id")
   414			if !refPresent || !refOk || ref == "" {
   415				return nil, "missing_ref_id"
   416			}
   417			ev.RefID = ref
   418			ev.USD = 0
   419		case "login", "signup":
   420			ev.USD = 0
   421		}
   422		return ev, ""
   423	}
   424	
   425	type stateFileIn struct {
   426		Version          int                   `json:"version"`
   427		Watermark        stateWatermarkOut     `json:"watermark"`
   428		SeenIDs          []string              `json:"seen_ids"`
   429		PendingPurchases []statePendingOut     `json:"pending_purchases"`
   430		OpenSessions     []stateOpenSessionOut `json:"open_sessions"`
   431		RunIndex         int                   `json:"run_index"`
   432	}
   433	
   434	func loadState(path string, stateStrict bool) (*loadedState, error) {
   435		data, err := os.ReadFile(path)
   436		if err != nil {
   437			return nil, err
   438		}
   439		var sin stateFileIn
   440		if err := json.Unmarshal(data, &sin); err != nil {
   441			return nil, err
   442		}
   443		st := &loadedState{
   444			version:      sin.Version,
   445			seenIds:      map[string]bool{},
   446			runIndex:     sin.RunIndex,
   447			openSessions: map[string]carriedSession{},
   448		}
   449		if sin.Watermark.MaxTS != nil {
   450			t, err := parseTime(*sin.Watermark.MaxTS)
   451			if err != nil {
   452				return nil, fmt.Errorf("bad state watermark: %w", err)
   453			}
   454			st.hasMax = true
   455			st.maxTs = t
   456		}
   457		for _, id := range sin.SeenIDs {
   458			st.seenIds[id] = true
   459		}
   460		for _, p := range sin.PendingPurchases {
   461			t, err := parseTime(p.TS)
   462			if err != nil {
   463				return nil, fmt.Errorf("bad pending purchase ts: %w", err)
   464			}
   465			if stateStrict && !p.firstSeenEpochSet {
   466				return nil, fmt.Errorf("ingest: --state-strict: state pending entry missing first_seen_epoch")
   467			}
   468			st.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, firstSeenEpoch: int(epochSeconds(t)), user: p.User, usd: float64(p.USD), originRun: p.OriginRun})
   469		}
   470		for _, s := range sin.OpenSessions {
   471			last, err := parseTime(s.LastTS)
   472			if err != nil {
   473				return nil, fmt.Errorf("bad open session last_ts: %w", err)
   474			}
   475			start, err := parseTime(s.StartTS)
   476			if err != nil {
   477				return nil, fmt.Errorf("bad open session start_ts: %w", err)
   478			}
   479			st.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}
   480		}
   481		st.carryInPending = len(st.pending)
   482		st.carryInOpenSessions = len(st.openSessions)
   483		return st, nil
   484	}
   485	
   486	func buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {
   487		out := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}
   488		if hasCurrentMax {
   489			s := formatTS(currentMax)
   490			out.Watermark.MaxTS = &s
   491		} else if st != nil && st.hasMax {
   492			s := formatTS(st.maxTs)
   493			out.Watermark.MaxTS = &s
   494		}
   495		b, _ := json.MarshalIndent(out, "", "  ")
   496		b = append(b, '\n')
   497		return b
   498	}
   499	
   500	func statePendingOutList(pending []pendingEntry) []statePendingOut {
   501		out := make([]statePendingOut, 0, len(pending))
   502		for _, p := range pending {
   503			out = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), FirstSeenEpoch: p.firstSeenEpoch, User: p.user, USD: Money(p.usd), OriginRun: p.originRun})
   504		}
   505		return out
   506	}
   507	
   508	func stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {
   509		out := make([]stateOpenSessionOut, 0, len(sessions))
   510		for _, s := range sessions {
   511			out = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})
   512		}
   513		return out
   514	}
   515	
   516	func sortedSeenIDs(seen map[string]bool) []string {
   517		ids := make([]string, 0, len(seen))
   518		for id := range seen {
   519			ids = append(ids, id)
   520		}
   521		sort.Strings(ids)
   522		return ids
   523	}
   524	
   525	func stateFirstSeenEpochPresent(p statePendingOut) bool {
   526		return p.firstSeenEpochSet
   527	}
   528	
   529	func sortedPending(pending []pendingEntry) []pendingEntry {
   530		out := append([]pendingEntry(nil), pending...)
   531		sort.SliceStable(out, func(i, j int) bool {
   532			if out[i].ts.Equal(out[j].ts) {
   533				return out[i].id < out[j].id
   534			}
   535			return out[i].ts.Before(out[j].ts)
   536		})
   537		return out
   538	}
   539	
   540	func sortedOpenSessions(m map[string]carriedSession) []carriedSession {
   541		out := make([]carriedSession, 0, len(m))
   542		for _, s := range m {
   543			out = append(out, s)
   544		}
   545		sort.SliceStable(out, func(i, j int) bool {
   546			if out[i].lastTs.Equal(out[j].lastTs) {
   547				return out[i].user < out[j].user
   548			}
   549			return out[i].lastTs.Before(out[j].lastTs)
   550		})
   551		return out
   552	}
   553	
   554	func sortedCarriedSessions(m map[string]carriedSession) []carriedSession {
   555		return sortedOpenSessions(m)
   556	}
