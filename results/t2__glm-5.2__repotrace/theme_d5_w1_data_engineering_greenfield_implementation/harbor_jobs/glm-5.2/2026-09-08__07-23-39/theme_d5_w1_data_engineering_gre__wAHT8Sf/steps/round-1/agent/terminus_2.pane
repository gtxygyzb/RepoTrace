   516				}
   517				if len(orderedPaths) > 1 {
   518					names := make([]string, len(orderedPaths))
   519					for i, path := range orderedPaths {
   520						names[i] = filepath.Base(path)
   521					}
   522					hashes := make([]string, len(orderedPaths))
   523					for i, path := range orderedPaths {
   524						hashes[i] = hashByPath[path]
   525					}
