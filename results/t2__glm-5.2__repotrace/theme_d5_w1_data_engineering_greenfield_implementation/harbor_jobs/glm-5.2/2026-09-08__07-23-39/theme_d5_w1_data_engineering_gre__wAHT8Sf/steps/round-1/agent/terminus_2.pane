go.mod if err != nil {
go.mod go.mod return err
go.mod }
go.mod *m = Money(f)
go.mod return nil
}

func (m Money) String() string {
go.mod f := float64(m)
go.mod abs := math.Abs(f)
go.mod cents := int64(math.Floor(abs*100.0 + 0.5))
go.mod neg := f < 0 && cents != 0
go.mod dollars := cents / 100
go.mod rem := cents % 100
go.mod s := fmt.Sprintf("%d.%02d", dollars, rem)
go.mod if neg {
go.mod go.mod s = "-" + s
go.mod }
go.mod return s
}

