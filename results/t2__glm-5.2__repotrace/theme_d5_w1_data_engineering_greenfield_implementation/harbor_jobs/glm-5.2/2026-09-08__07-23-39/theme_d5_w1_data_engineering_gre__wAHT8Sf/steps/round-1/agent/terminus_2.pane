   516	func sortedPending(pending []pendingEntry) []pendingEntry {
   517		out := append([]pendingEntry(nil), pending...)
   518		sort.SliceStable(out, func(i, j int) bool {
   519			if out[i].ts.Equal(out[j].ts) {
   520				return out[i].id < out[j].id
   521			}
   522			return out[i].ts.Before(out[j].ts)
   523		})
   524		return out
   525	}
   526	
   527	func sortedOpenSessions(m map[string]carriedSession) []carriedSession {
   528		out := make([]carriedSession, 0, len(m))
   529		for _, s := range m {
   530			out = append(out, s)
   531		}
   532		sort.SliceStable(out, func(i, j int) bool {
   533			if out[i].lastTs.Equal(out[j].lastTs) {
   534				return out[i].user < out[j].user
   535			}
   536			return out[i].lastTs.Before(out[j].lastTs)
   537		})
   538		return out
   539	}
   540	
   541	func sortedCarriedSessions(m map[string]carriedSession) []carriedSession {
   542		return sortedOpenSessions(m)
   543	}
