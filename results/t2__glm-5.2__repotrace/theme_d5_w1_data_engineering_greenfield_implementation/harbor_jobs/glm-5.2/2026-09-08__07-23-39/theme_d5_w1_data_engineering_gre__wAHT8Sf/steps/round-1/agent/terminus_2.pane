   401	func parentDirExists(path string) bool {
   402	  dir := filepath.Dir(path)
   403	  if dir == "." {
   404	    return true
   405	  }
   406	  info, err := os.Stat(dir)
   407	  return err == nil && info.IsDir()
   408	}
