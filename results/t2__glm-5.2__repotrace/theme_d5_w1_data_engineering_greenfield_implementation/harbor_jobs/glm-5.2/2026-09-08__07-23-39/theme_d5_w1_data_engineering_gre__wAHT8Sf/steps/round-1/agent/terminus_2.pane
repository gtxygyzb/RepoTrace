   435	func loadState(path string) (*loadedState, error) {
   436		data, err := os.ReadFile(path)
   437		if err != nil {
   438			return nil, err
   439		}
   440		var sin stateFileIn
   441		if err := json.Unmarshal(data, &sin); err != nil {
   442			return nil, err
   443		}
   444		st := &loadedState{
   445			version:      sin.Version,
   446			seenIds:      map[string]bool{},
   447			runIndex:     sin.RunIndex,
   448			openSessions: map[string]carriedSession{},
   449		}
   450		if sin.Watermark.MaxTS != nil {
   451			t, err := parseTime(*sin.Watermark.MaxTS)
   452			if err != nil {
   453				return nil, fmt.Errorf("bad state watermark: %w", err)
   454			}
   455			st.hasMax = true
   456			st.maxTs = t
   457		}
   458		for _, id := range sin.SeenIDs {
   459			st.seenIds[id] = true
   460		}
   461		for _, p := range sin.PendingPurchases {
   462			t, err := parseTime(p.TS)
   463			if err != nil {
   464				return nil, fmt.Errorf("bad pending purchase ts: %w", err)
   465			}
   466			st.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, user: p.User, usd: float64(p.USD), originRun: p.OriginRun})
   467		}
   468		for _, s := range sin.OpenSessions {
   469			last, err := parseTime(s.LastTS)
   470			if err != nil {
   471				return nil, fmt.Errorf("bad open session last_ts: %w", err)
   472			}
   473			start, err := parseTime(s.StartTS)
   474			if err != nil {
   475				return nil, fmt.Errorf("bad open session start_ts: %w", err)
   476			}
   477			st.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}
   478		}
   479		st.carryInPending = len(st.pending)
   480		st.carryInOpenSessions = len(st.openSessions)
   481		return st, nil
   482	}
