   200	func loadRates(path string) (*RateTable, error) {
   201		data, err := os.ReadFile(path)
   202		if err != nil {
   203			return nil, err
   204		}
   205		var top map[string]json.RawMessage
   206		if err := json.Unmarshal(data, &top); err != nil {
   207			return nil, fmt.Errorf("rates file is not valid json: %w", err)
   208		}
   209		rt := newRateTable()
   210		daysRaw, ok := top["days"]
   211		if !ok {
   212			return nil, errors.New("fx days invalid")
   213		}
   214		var days map[string]json.RawMessage
   215		if err := json.Unmarshal(daysRaw, &days); err != nil {
   216			return nil, errors.New("fx days invalid")
   217		}
   218		if len(days) == 0 {
   219			return nil, errors.New("fx days invalid")
   220		}
   221		for _, day := range sortedKeys(days) {
   222			if !isStrictDate(day) || !isDate(day) {
   223				return nil, fmt.Errorf("ingest: rates.json: invalid day key %s", day)
   224			}
   225			var currencies map[string]json.RawMessage
   226			if err := json.Unmarshal(days[day], &currencies); err != nil {
   227				return nil, errors.New("fx days invalid")
   228			}
   229			for _, currency := range sortedKeys(currencies) {
   230				f, err := parseRateNumber(currencies[currency])
   231				if err != nil {
   232					return nil, fmt.Errorf("ingest: rates.json: non-numeric rate for %s/%s", day, currency)
   233				}
   234				if rt.days[day] == nil {
   235					rt.days[day] = map[string]float64{}
   236				}
   237				rt.days[day][currency] = f
   238				rt.known[currency] = true
   239			}
   240		}
   241		baseRaw, baseOk := top["base"]
   242		if !baseOk {
   243			return nil, errors.New("ingest: rates.json: base required")
   244		}
   245		var base string
   246		if err := json.Unmarshal(baseRaw, &base); err != nil || base == "" {
   247			return nil, errors.New("ingest: rates.json: base required")
   248		}
   249		rt.base = base
   250		if base != "USD" {
   251			return nil, errors.New("fx base must be USD")
   252		}
   253		for _, day := range sortedKeys(rt.days) {
   254			r, ok := rt.days[day][base]
   255			if !ok || r != 1.0 {
   256				return nil, fmt.Errorf("ingest: rates.json: base currency %s must have rate 1.0 on day %s", base, day)
   257			}
   258		}
   259		return rt, nil
   260	}
