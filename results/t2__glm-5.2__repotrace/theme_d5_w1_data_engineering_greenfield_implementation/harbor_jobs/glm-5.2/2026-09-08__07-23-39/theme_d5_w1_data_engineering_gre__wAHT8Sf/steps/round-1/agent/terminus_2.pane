var usageString = "usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--audit-log <path>] [--audit-log-digest <path>] [--rates-strict] [--rates-max-staleness <seconds>]\n"

type Money float64

func (m Money) MarshalJSON() ([]byte, error) {
	return []byte(m.String()), nil
}

func (m Money) String() string {
	f := float64(m)
	abs := math.Abs(f)
	cents := int64(math.Floor(abs*100.0 + 0.5))
	neg := f < 0 && cents != 0
	dollars := cents / 100
	rem := cents % 100
	s := fmt.Sprintf("%d.%02d", dollars, rem)
	if neg {
		s = "-" + s
	}
	return s
}

type Event struct {
	ID                string
	Type              string
	TS                time.Time
	UserID            string
	Amount            float64
	Currency          string
	RefID             string
	USD               float64
	RefUSD            float64
	FXFallbackDays    int
	ResolvedAgainst   *string
	ResolvedOriginRun int
	SessionIndex      int
	Raw               json.RawMessage
	Shard             string
	Line              int
}

type Reject struct {
	Bucket int             `json:"bucket"`
	Event  json.RawMessage `json:"event"`
}

type ShardLine struct {
	Shard string
	Line  int
	Data  []byte
}

type RateTable struct {
	base  string
	days  map[string]map[string]float64
	known map[string]bool
}

func newRateTable() *RateTable {
	return &RateTable{base: "USD", days: map[string]map[string]float64{}, known: map[string]bool{}}
}

func isUsableRate(f float64) bool {
	return isFinite(f) && f > 0
}

func parseRateNumber(raw json.RawMessage) (float64, error) {
	if bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
		return 0, errors.New("non-numeric rate")
	}
	var f float64
	if err := json.Unmarshal(raw, &f); err != nil {
		return 0, errors.New("non-numeric rate")
	}
	return f, nil
}

func sortedKeys[T any](m map[string]T) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

func isStrictDate(s string) bool {
	if len(s) != 10 {
		return false
	}
	for i, c := range s {
		if i == 4 || i == 7 {
			if c != '-' {
				return false
			}
			continue
		}
		if c < '0' || c > '9' {
			return false
		}
	}
	return true
}

func dayEpoch(date string) time.Time {
	t, err := time.Parse("2006-01-02", date)
	if err != nil {
		return time.Time{}
	}
	return t.UTC()
}

func calendarDayDiff(rateDate, eventDate string) int {
	r := dayEpoch(rateDate)
	e := dayEpoch(eventDate)
	if r.IsZero() || e.IsZero() {
		return 0
	}
	return int(r.Sub(e) / (24 * time.Hour))
}

func absInt(v int) int {
	if v < 0 {
		return -v
	}
	return v
}

func absInt64(v int64) int64 {
	if v < 0 {
		return -v
	}
	return v
}

func (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {
	if !rt.known[currency] {
		return 0, 0, "fx_unknown_currency"
	}
	if m, ok := rt.days[date]; ok {
		if r, ok := m[currency]; ok {
			if isUsableRate(r) {
				return r, 0, ""
			}
			return 0, 0, "bad_rate"
		}
	}
	if maxStaleness > 0 {
		eventDay := dayEpoch(date)
		if !eventDay.IsZero() {
			var bestDate string
			var bestDist int64 = -1
			for _, d := range sortedKeys(rt.days) {
				if _, ok := rt.days[d][currency]; !ok {
					continue
				}
				dayTime := dayEpoch(d)
				if dayTime.IsZero() {
					continue
				}
				dist := absInt64(dayTime.Unix() - eventDay.Unix())
				if dist > int64(maxStaleness) {
					continue
				}
				if bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {
					bestDist = dist
					bestDate = d
				}
			}
			if bestDate != "" {
				r := rt.days[bestDate][currency]
				if isUsableRate(r) {
					return r, calendarDayDiff(bestDate, date), ""
				}
				return 0, 0, "bad_rate"
			}
		}
	}
	return 0, 0, "missing_rate"
}

func loadRates(path string) (*RateTable, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	var top map[string]json.RawMessage
	if err := json.Unmarshal(data, &top); err != nil {
		return nil, fmt.Errorf("rates file is not valid json: %w", err)
	}
	rt := newRateTable()
	daysRaw, ok := top["days"]
	if !ok {
		return nil, errors.New("fx days invalid")
	}
	var days map[string]json.RawMessage
	if err := json.Unmarshal(daysRaw, &days); err != nil {
		return nil, errors.New("fx days invalid")
	}
	if len(days) == 0 {
		return nil, errors.New("fx days invalid")
	}
[?2004hroot@n30009:/app# sed -n '221,440p' main.go
[?2004l	for _, day := range sortedKeys(days) {
		if !isStrictDate(day) || !isDate(day) {
			return nil, fmt.Errorf("ingest: rates.json: invalid day key %s", day)
		}
		var currencies map[string]json.RawMessage
		if err := json.Unmarshal(days[day], &currencies); err != nil {
			return nil, errors.New("fx days invalid")
		}
		for _, currency := range sortedKeys(currencies) {
			f, err := parseRateNumber(currencies[currency])
			if err != nil {
				return nil, fmt.Errorf("ingest: rates.json: non-numeric rate for %s/%s", day, currency)
			}
			if rt.days[day] == nil {
				rt.days[day] = map[string]float64{}
			}
			rt.days[day][currency] = f
			rt.known[currency] = true
		}
	}
	baseRaw, baseOk := top["base"]
	if !baseOk {
		return nil, errors.New("ingest: rates.json: base required")
	}
	var base string
	if err := json.Unmarshal(baseRaw, &base); err != nil || base == "" {
		return nil, errors.New("ingest: rates.json: base required")
	}
	rt.base = base
	if base != "USD" {
		return nil, errors.New("fx base must be USD")
	}
	for _, day := range sortedKeys(rt.days) {
		r, ok := rt.days[day][base]
		if !ok || r != 1.0 {
			return nil, fmt.Errorf("ingest: rates.json: base currency %s must have rate 1.0 on day %s", base, day)
		}
	}
	return rt, nil
}

func readInputEvents(inputDir string) ([]rawEvent, error) {
	info, err := os.Stat(inputDir)
	if err != nil {
		return nil, err
	}
	if !info.IsDir() {
		return nil, errors.New("input-dir is not a directory")
	}
	entries, err := os.ReadDir(inputDir)
	if err != nil {
		return nil, err
	}
	var files []string
	for _, e := range entries {
		if e.IsDir() || !e.Type().IsRegular() {
			continue
		}
		files = append(files, e.Name())
	}
	sort.Strings(files)
	var events []rawEvent
	for _, name := range files {
		data, err := os.ReadFile(filepath.Join(inputDir, name))
		if err != nil {
			return nil, err
		}
		lineNo := 0
		for _, line := range bytes.Split(data, []byte{'\n'}) {
			lineNo++
			trimmed := bytes.TrimSpace(line)
			if len(trimmed) == 0 {
				continue
			}
			var obj map[string]json.RawMessage
			if err := json.Unmarshal(trimmed, &obj); err != nil {
				continue
			}
			events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: json.RawMessage(trimmed), Obj: obj})
		}
	}
	return events, nil
}

func newContext(raw rawEvent) *eventContext {
	ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}
	ctx.ID = rawStringPtr(raw.Obj, "id")
	ctx.TS = rawStringPtr(raw.Obj, "ts")
	ctx.Type = rawStringPtr(raw.Obj, "type")
	return ctx
}

func parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {
	obj := ctx.Obj
	raw, ok := obj["v"]
	if !ok {
		return nil, "schema_version"
	}
	var v int
	if err := json.Unmarshal(raw, &v); err != nil {
		return nil, "schema_version"
	}
	if v != 1 && v != 2 {
		return nil, "schema_version"
	}
	id, idOk, _ := getRawString(obj, "id")
	if !idOk || id == "" {
		return nil, "missing_id"
	}
	tsStr, tsOk, _ := getRawString(obj, "ts")
	if !tsOk {
		return nil, "missing_ts"
	}
	t, err := parseTime(tsStr)
	if err != nil {
		return nil, "bad_ts"
	}
	typeStr, typeOk, _ := getRawString(obj, "type")
	if !typeOk {
		return nil, "missing_type"
	}
	switch typeStr {
	case "purchase", "refund", "chargeback", "login", "signup":
	default:
		return nil, "bad_type"
	}
	user, userOk, _ := getRawString(obj, "user_id")
	if !userOk || user == "" {
		return nil, "missing_user"
	}
	ev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}
	switch typeStr {
	case "purchase", "refund":
		var amount float64
		if v == 1 {
			raw, present := obj["amount"]
			if !present {
				return nil, "missing_amount"
			}
			var f float64
			if err := json.Unmarshal(raw, &f); err != nil {
				return nil, "bad_amount"
			}
			if !isFinite(f) || f < 0 {
				return nil, "bad_amount"
			}
			amount = f
		} else {
			raw, present := obj["amount_cents"]
			if !present {
				return nil, "missing_amount"
			}
			n, err := getJSONInt(raw)
			if err != nil || n < 0 {
				return nil, "bad_amount"
			}
			amount = float64(n) / 100.0
		}
		cur, curOk, curPresent := getRawString(obj, "currency")
		if !curPresent {
			return nil, "missing_currency"
		}
		if !curOk || cur == "" {
			return nil, "bad_currency"
		}
		rate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)
		switch status {
		case "fx_unknown_currency":
			return nil, "fx_unknown_currency"
		case "missing_rate":
			return nil, "fx_no_rate_for_date"
		case "bad_rate":
			if ratesStrict {
				return nil, "fx_bad_rate"
			}
			return nil, "fx_no_rate_for_date"
		}
		usd := amount * rate
		if typeStr == "refund" {
			usd = -usd
		}
		ev.Amount = amount
		ev.Currency = cur
		ev.FXFallbackDays = fallbackDays
		ev.USD = roundMoney(usd)
	case "chargeback":
		ref, refOk, refPresent := getRawString(obj, "ref_id")
		if !refPresent || !refOk || ref == "" {
			return nil, "missing_ref_id"
		}
		ev.RefID = ref
		ev.USD = 0
	case "login", "signup":
		ev.USD = 0
	}
	return ev, ""
}

type stateFileIn struct {
	Version          int                   `json:"version"`
	Watermark        stateWatermarkOut     `json:"watermark"`
	SeenIDs          []string              `json:"seen_ids"`
	PendingPurchases []statePendingOut     `json:"pending_purchases"`
	OpenSessions     []stateOpenSessionOut `json:"open_sessions"`
	RunIndex         int                   `json:"run_index"`
}

func loadState(path string) (*loadedState, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	var sin stateFileIn
	if err := json.Unmarshal(data, &sin); err != nil {
		return nil, err
	}
	st := &loadedState{
		version:      sin.Version,
		seenIds:      map[string]bool{},
		runIndex:     sin.RunIndex,
[?2004hroot@n30009:/app# sed -n '441,660p' main.go
[?2004l		openSessions: map[string]carriedSession{},
	}
	if sin.Watermark.MaxTS != nil {
		t, err := parseTime(*sin.Watermark.MaxTS)
		if err != nil {
			return nil, fmt.Errorf("bad state watermark: %w", err)
		}
		st.hasMax = true
		st.maxTs = t
	}
	for _, id := range sin.SeenIDs {
		st.seenIds[id] = true
	}
	for _, p := range sin.PendingPurchases {
		t, err := parseTime(p.TS)
		if err != nil {
			return nil, fmt.Errorf("bad pending purchase ts: %w", err)
		}
		st.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, user: p.User, usd: float64(p.USD), originRun: p.OriginRun})
	}
	for _, s := range sin.OpenSessions {
		last, err := parseTime(s.LastTS)
		if err != nil {
			return nil, fmt.Errorf("bad open session last_ts: %w", err)
		}
		start, err := parseTime(s.StartTS)
		if err != nil {
			return nil, fmt.Errorf("bad open session start_ts: %w", err)
		}
		st.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}
	}
	st.carryInPending = len(st.pending)
	st.carryInOpenSessions = len(st.openSessions)
	return st, nil
}

func buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {
	out := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}
	if hasCurrentMax {
		s := formatTS(currentMax)
		out.Watermark.MaxTS = &s
	} else if st != nil && st.hasMax {
		s := formatTS(st.maxTs)
		out.Watermark.MaxTS = &s
	}
	b, _ := json.MarshalIndent(out, "", "  ")
	b = append(b, '\n')
	return b
}

func statePendingOutList(pending []pendingEntry) []statePendingOut {
	out := make([]statePendingOut, 0, len(pending))
	for _, p := range pending {
		out = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), User: p.user, USD: Money(p.usd), OriginRun: p.originRun})
	}
	return out
}

func stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {
	out := make([]stateOpenSessionOut, 0, len(sessions))
	for _, s := range sessions {
		out = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})
	}
	return out
}

func sortedSeenIDs(seen map[string]bool) []string {
	ids := make([]string, 0, len(seen))
	for id := range seen {
		ids = append(ids, id)
	}
	sort.Strings(ids)
	return ids
}

func sortedPending(pending []pendingEntry) []pendingEntry {
	out := append([]pendingEntry(nil), pending...)
	sort.SliceStable(out, func(i, j int) bool {
		if out[i].ts.Equal(out[j].ts) {
			return out[i].id < out[j].id
		}
		return out[i].ts.Before(out[j].ts)
	})
	return out
}

func sortedOpenSessions(m map[string]carriedSession) []carriedSession {
	out := make([]carriedSession, 0, len(m))
	for _, s := range m {
		out = append(out, s)
	}
	sort.SliceStable(out, func(i, j int) bool {
		if out[i].lastTs.Equal(out[j].lastTs) {
			return out[i].user < out[j].user
		}
		return out[i].lastTs.Before(out[j].lastTs)
	})
	return out
}

func sortedCarriedSessions(m map[string]carriedSession) []carriedSession {
	return sortedOpenSessions(m)
}
