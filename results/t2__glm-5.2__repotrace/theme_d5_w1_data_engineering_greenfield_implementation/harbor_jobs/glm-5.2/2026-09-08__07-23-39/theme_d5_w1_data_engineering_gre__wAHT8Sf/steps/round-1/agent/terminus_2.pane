   410	func parseNonNegInt(s string) (int, error) {
   411	  n, err := strconv.Atoi(s)
   412	  if err != nil {
   413	    return 0, err
   414	  }
   415	  if n < 0 {
   416	    return 0, errors.New("negative")
   417	  }
   418	  return n, nil
   419	}
