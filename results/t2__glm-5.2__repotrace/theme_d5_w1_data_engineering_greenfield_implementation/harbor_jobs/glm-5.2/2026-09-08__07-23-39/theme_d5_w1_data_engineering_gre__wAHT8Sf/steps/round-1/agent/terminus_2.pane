   402	
   403	func buildSchemaSidecar(summaryData []byte, cfg cliConfig, runIndex int) ([]byte, error) {
   404	fields, err := parseSummaryFields(summaryData)
   405	if err != nil {
   406	return nil, err
   407	}
   408	summarySchema := make([]orderedJSON, 0, len(fields))
   409	var arrayFields, objectFields, scalarFields int
   410	for _, f := range fields {
   411	t := classify(f.value)
   412	switch t {
   413	case "array":
   414	arrayFields++
   415	case "object":
   416	objectFields++
   417	default:
   418	scalarFields++
   419	}
   420	summarySchema = append(summarySchema, orderedJSON{key: f.key, value: descriptorFor(f.value, 0, cfg.summarySchemaStrict)})
   421	}
   422	var ingestID any
   423	if cfg.ingestIDSet {
   424	ingestID = cfg.ingestID
   425	} else {
   426	ingestID = nil
   427	}
   428	top := []orderedJSON{
   429	{key: "schema_version", value: summarySchemaVersion},
   430	{key: "summary_schema", value: summarySchema},
   431	{key: "ingest_id", value: ingestID},
   432	{key: "run_index", value: runIndex},
   433	{key: "field_summary", value: []orderedJSON{
   434	{key: "array_fields", value: arrayFields},
   435	{key: "object_fields", value: objectFields},
   436	{key: "scalar_fields", value: scalarFields},
   437	}},
   438	{key: "strict_mode", value: cfg.summarySchemaStrict},
   439	}
   440	data := marshalOrderedIndent(top)
   441	data = append(data, '\n')
   442	return data, nil
   443	}
   444	
   445	func writeSummarySchemaSidecars(cfg cliConfig, summaryData []byte, runIndex int) error {
   446	if cfg.summarySchemaOut == "" {
   447	return nil
   448	}
   449	schemaData, err := buildSchemaSidecar(summaryData, cfg, runIndex)
   450	if err != nil {
   451	return err
   452	}
   453	if err := atomicWriteFile(cfg.summarySchemaOut, schemaData); err != nil {
   454	return err
   455	}
   456	if cfg.summarySchemaDigest != "" {
   457	hash, n, err := fileDigest(cfg.summarySchemaOut)
   458	if err != nil {
   459	return err
   460	}
   461	digest := []orderedJSON{
   462	{key: "schema_path", value: filepath.Base(cfg.summarySchemaOut)},
   463	{key: "schema_sha256", value: hash},
   464	{key: "schema_bytes", value: n},
   465	{key: "field_count", value: 7},
   466	{key: "tool_version", value: toolVersion},
   467	}
   468	data := marshalOrderedIndent(digest)
   469	data = append(data, '\n')
   470	if err := atomicWriteFile(cfg.summarySchemaDigest, data); err != nil {
   471	return err
   472	}
   473	if cfg.summarySchemaIndex != "" {
   474	index, err := buildIndexSidecar(cfg, summaryData)
   475	if err != nil {
   476	return err
   477	}
   478	if err := atomicWriteFile(cfg.summarySchemaIndex, index); err != nil {
   479	return err
   480	}
   481	}
   482	}
   483	return nil
   484	}
   485	
   486	func buildIndexSidecar(cfg cliConfig, summaryData []byte) ([]byte, error) {
   487	fields, err := parseSummaryFields(summaryData)
   488	if err != nil {
   489	return nil, err
   490	}
   491	entries := make([]any, 0)
   492	for _, f := range fields {
   493	entries = append(entries, []orderedJSON{
   494	{key: "name", value: f.key},
   495	{key: "type", value: classify(f.value)},
   496	{key: "path", value: "$." + f.key},
   497	})
   498	if classify(f.value) == "array" {
   499	arr := f.value.([]any)
   500	if len(arr) > 0 && classify(arr[0]) == "object" {
   501	obj := arr[0].(map[string]any)
   502	keys := make([]string, 0, len(obj))
   503	for k := range obj {
   504	keys = append(keys, k)
   505	}
   506	sort.Strings(keys)
   507	for _, k := range keys {
   508	entries = append(entries, []orderedJSON{
   509	{key: "name", value: k},
   510	{key: "type", value: classify(obj[k])},
   511	{key: "path", value: fmt.Sprintf("$.%s[*].%s", f.key, k)},
   512	})
   513	}
   514	}
   515	}
   516	}
   517	top := []orderedJSON{
   518	{key: "entries", value: entries},
   519	{key: "entry_count", value: len(entries)},
   520	{key: "generated_from", value: filepath.Base(cfg.summarySchemaOut)},
