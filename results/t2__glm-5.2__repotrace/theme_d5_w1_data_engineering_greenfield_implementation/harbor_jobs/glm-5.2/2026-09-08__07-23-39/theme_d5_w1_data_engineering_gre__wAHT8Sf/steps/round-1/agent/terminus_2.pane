type Reject struct {
  Bucket int             `json:"bucket"`
  Reason string          `json:"reason"`
  Event  json.RawMessage `json:"event"`
}

type ShardLine struct {
  Shard string
  Line  int
  Data  []byte
}

type RateTable struct {
  byDate map[string]map[string]float64
  global map[string]float64
}

type pendingEntry struct {
  id        string
  ts        time.Time
  user      string
  usd       float64
  originRun int
  retired   bool
}

type carriedSession struct {
  user         string
  lastTs       time.Time
  sessionIndex int
  startTs      time.Time
}

type loadedState struct {
  version              int
  hasMax               bool
  maxTs                time.Time
  seenIds              map[string]bool
  pending              []pendingEntry
  openSessions         map[string]carriedSession
  runIndex             int
  carryInPending       int
  carryInOpenSessions  int
  ttlDropped           int
}

type stateStats struct {
  CarryInPending      int `json:"carry_in_pending"`
  CarryOutPending     int `json:"carry_out_pending"`
  RetiredThisRun      int `json:"retired_this_run"`
  TtlDropped          int `json:"ttl_dropped"`
  CrossRunDuplicates  int `json:"cross_run_duplicates"`
  OpenSessionsCarried int `json:"open_sessions_carried"`
  OpenSessionsExtended int `json:"open_sessions_extended"`
  OpenSessionsEvicted int `json:"open_sessions_evicted"`
  RunIndex            int `json:"run_index"`
}

type eventTypeStats struct {
  Count    int   `json:"count"`
  TotalUSD Money `json:"total_usd"`
  AvgUSD   Money `json:"avg_usd"`
}

type hourStats struct {
  Count    int   `json:"count"`
  TotalUSD Money `json:"total_usd"`
}

type sessionsOut struct {
  Total  int            `json:"total"`
  ByUser map[string]int `json:"by_user"`
}

type timeRangeOut struct {
  Start *string `json:"start"`
  End   *string `json:"end"`
}

type anomaliesOut struct {
  Duplicate           int `json:"duplicate"`
  UnresolvedChargeback int `json:"unresolved_chargeback"`
}

type summary struct {
  TotalEvents int                        `json:"total_events"`
  ByType      map[string]eventTypeStats  `json:"by_type"`
  ByHour      map[string]hourStats        `json:"by_hour"`
  Sessions    sessionsOut                `json:"sessions"`
  TimeRange   timeRangeOut               `json:"time_range"`
  Anomalies   anomaliesOut               `json:"anomalies"`
  StateStats  *stateStats                `json:"state_stats,omitempty"`
}

type rawEvent struct {
  Shard string
  Line  int
  Raw   json.RawMessage
  Obj   map[string]json.RawMessage
}

type statePendingOut struct {
  ID        string `json:"id"`
  TS        string `json:"ts"`
  User      string `json:"user"`
  USD       Money  `json:"usd"`
  OriginRun int    `json:"origin_run"`
}

type stateOpenSessionOut struct {
  User         string `json:"user"`
  LastTS       string `json:"last_ts"`
  SessionIndex int    `json:"session_index"`
  StartTS      string `json:"start_ts"`
}

