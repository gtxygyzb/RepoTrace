    56	func parseArgs(args []string) (cfg cliConfig, err error) {
    57		defer func() {
    58			if r := recover(); r != nil {
    59				cfg = cliConfig{}
    60				err = fmt.Errorf("%v", r)
    61			}
    62		}()
    63		cfg = cliConfig{
