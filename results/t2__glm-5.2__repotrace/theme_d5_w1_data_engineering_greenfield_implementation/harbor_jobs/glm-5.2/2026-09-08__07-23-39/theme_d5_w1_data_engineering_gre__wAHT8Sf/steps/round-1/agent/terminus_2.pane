type Money float64

func (m Money) MarshalJSON() ([]byte, error) {
	return []byte(m.String()), nil
}

func (m Money) String() string {
	f := float64(m)
	abs := math.Abs(f)
	cents := int64(math.Floor(abs*100.0 + 0.5))
	neg := f < 0 && cents != 0
	dollars := cents / 100
	rem := cents % 100
	s := fmt.Sprintf("%d.%02d", dollars, rem)
	if neg {
		s = "-" + s
	}
	return s
}

type Event struct {
	ID                string
	Type              string
	TS                time.Time
	UserID            string
	Amount            float64
	Currency          string
	RefID             string
	USD               float64
	RefUSD            float64
	FXFallbackDays    int
	ResolvedAgainst   *string
	ResolvedOriginRun int
	SessionIndex      int
