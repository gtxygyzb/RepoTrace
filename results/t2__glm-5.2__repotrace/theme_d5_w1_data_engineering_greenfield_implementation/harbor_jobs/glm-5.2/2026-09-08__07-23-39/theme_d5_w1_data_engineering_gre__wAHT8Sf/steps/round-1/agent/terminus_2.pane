func rawStringPtr(m map[string]json.RawMessage, key string) *string {
  s, ok, _ := getRawString(m, key)
  if !ok {
    return nil
  }
  return &s
}

func getString(m map[string]json.RawMessage, keys ...string) (string, bool) {
  for _, k := range keys {
    s, ok, _ := getRawString(m, k)
    if ok {
      return s, true
    }
  }
  return "", false
}

func getNumberOrString(raw json.RawMessage) (float64, error) {
  trimmed := bytes.TrimSpace(raw)
  if len(trimmed) == 0 {
    return 0, errors.New("empty number")
  }
  if trimmed[0] == '"' {
    var s string
    if err := json.Unmarshal(trimmed, &s); err != nil {
      return 0, err
    }
    s = strings.TrimSpace(s)
    if parts := strings.Fields(s); len(parts) > 0 {
      s = parts[0]
    }
    return strconv.ParseFloat(s, 64)
  }
  return strconv.ParseFloat(string(trimmed), 64)
}

func isFinite(f float64) bool {
  return !math.IsInf(f, 0) && !math.IsNaN(f)
}

func getJSONInt(raw json.RawMessage) (int64, error) {
  var n json.Number
  if err := json.Unmarshal(raw, &n); err != nil {
    return 0, err
  }
  s := string(n)
  if strings.ContainsAny(s, ".eE") {
    return 0, errors.New("not an integer")
  }
  return strconv.ParseInt(s, 10, 64)
}

func roundMoney(f float64) float64 {
  abs := math.Abs(f)
  cents := int64(math.Floor(abs*100.0 + 0.5))
  if f < 0 && cents != 0 {
    return -float64(cents) / 100.0
  }
  return float64(cents) / 100.0
}

func jsonBytes(s string) []byte {
  b, err := json.Marshal(s)
  if err != nil {
    return []byte(`""`)
  }
  return b
}

func strPtr(s string) *string {
  return &s
}

func absDur(d time.Duration) time.Duration {
  if d < 0 {
    return -d
  }
  return d
}

func parentDirExists(path string) bool {
  dir := filepath.Dir(path)
  if dir == "." {
    return true
  }
  info, err := os.Stat(dir)
  return err == nil && info.IsDir()
}

func parseNonNegInt(s string) (int, error) {
  n, err := strconv.Atoi(s)
  if err != nil {
    return 0, err
  }
  if n < 0 {
    return 0, errors.New("negative")
  }
  return n, nil
}

func atomicWriteFile(path string, data []byte) error {
  tmp := path + ".tmp"
  if err := os.WriteFile(tmp, data, 0644); err != nil {
    os.Remove(tmp)
    return err
  }
  if err := os.Rename(tmp, path); err != nil {
    os.Remove(tmp)
    return err
  }
  return nil
}

func newRateTable() *RateTable {
  return &RateTable{byDate: map[string]map[string]float64{}, global: map[string]float64{"USD": 1.0}}
}

func (rt *RateTable) rate(date, currency string) (float64, bool) {
  if currency == "USD" {
    return 1.0, true
  }
  if m, ok := rt.byDate[date]; ok {
    if r, ok := m[currency]; ok && r > 0 {
      return r, true
    }
  }
  if r, ok := rt.global[currency]; ok && r > 0 {
    return r, true
  }
  return 0, false
}

