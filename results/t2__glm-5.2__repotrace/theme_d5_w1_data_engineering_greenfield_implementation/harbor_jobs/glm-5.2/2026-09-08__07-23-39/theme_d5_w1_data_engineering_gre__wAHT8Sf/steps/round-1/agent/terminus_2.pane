tate-out\":\n\t\t\tcfg.stateOut = nextArg(args, &i)\n\t\tcase \"--pending-ttl\":\n\t\t\tcfg.pendingTTL = atoiOrError(nextArg(args, &i), \"--pending-ttl\")\n\t\tcase \"--max-open-sessions\":\n\t\t\tcfg.maxOpenSessions = atoiOrError(nextArg(args, &i), \"--max-open-sessions\")\n\t\tcase \"--audit-log\":\n\t\t\tcfg.auditLog = nextArg(args, &i)\n\t\tcase \"--audit-log-digest\":\n\t\t\tcfg.auditLogDigest = nextArg(args, &i)\n\t\tcase \"--rates-strict\":\n\t\t\tcfg.ratesStrict = true\n\t\tcase \"--rates-max-staleness\":\n\t\t\tcfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), \"--rates-max-staleness\")\n\t\tcase \"--ingest-id\":\n\t\t\tcfg.ingestID = nextArg(args, &i)\n\t\t\tcfg.ingestIDSet = true\n\t\tcase \"--out-parquet-manifest\":\n\t\t\tcfg.outManifest = nextArg(args, &i)\n\t\tcase \"--manifest-signature\":\n\t\t\tcfg.manifestSignature = nextArg(args, &i)\n\t\tdefault:\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: unknown flag %s\", arg)\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") && arg != \"--rates-strict\" {\n\t\t\tif v, ok := required[arg]; ok {\n\t\t\t\trequired[arg] = true\n\t\t\t}\n\t\t}\n\t}\n\tfor k, ok := range required {\n\t\tif !ok {\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: %s is required\", k)\n\t\t}\n\t}\n\tif cfg.ingestIDSet {\n\t\tif len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {\n\t\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)\")\n\t\t}\n\t}\n\tif cfg.outManifest == \"\" && cfg.manifestSignature != \"\" {\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest: --manifest-signature requires --out-parquet-manifest\")\n\t}\n\tif cfg.outManifest != \"\" && !parentDirExists(cfg.outManifest) {\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest --out-parquet-manifest parent directory does not exist\")\n\t}\n\tif cfg.manifestSignature != \"\" && !parentDirExists(cfg.manifestSignature) {\n\t\treturn cliConfig{}, fmt.Errorf(\"ingest --manifest-signature parent directory does not exist\")\n\t}\n\treturn cfg, nil\n}\n\nfunc nextArg(args []string, i *int) string {\n\tif *i+1 >= len(args) {\n\t\tpanic(fmt.Errorf(\"ingest: missing value for %s\", args[*i]))\n\t}\n\t*i++\n\treturn args[*i]\n}\n\nfunc atoiOrError(s, flag string) int {\n\tn, err := strconv.Atoi(s)\n\tif err != nil {\n\t\tpanic(fmt.Errorf(\"ingest: invalid integer for %s: %s\", flag, s))\n\t}\n\treturn n\n}\n\nfunc run(cfg cliConfig) error {\n\tratesData, err := os.ReadFile(cfg.ratesPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ingest: rates: %w\", err)\n\t}\n\tratesDigest := sha256Hex(ratesData)\n\trt, err := loadRates(cfg.ratesPath)\n\tif err != nil {\n\t\treturn err\n\t}\n\tvar st *loadedState\n\trunIndex := 1\n\tif cfg.stateIn != \"\" {\n\t\tst, err = loadState(cfg.stateIn)\n\t\tif err != nil && !os.IsNotExist(err) {\n\t\t\treturn err\n\t\t}\n\t\tif st != nil {\n\t\t\trunIndex = st.runIndex + 1\n\t\t}\n\t}\n\tevents, shards, err := readInputEvents(cfg.inputDir)\n\tif err != nil {\n\t\treturn err\n\t}\n\tseen := map[string]bool{}\n\tif st != nil {\n\t\tfor k, v := range st.seenIds {\n\t\t\tseen[k] = v\n\t\t}\n\t}\n\tpending := append([]pendingEntry(nil), st.pending...)\n\topenSessions := map[string]carriedSession{}\n\tfor k, v := range st.openSessions {\n\t\topenSessions[k] = v\n\t}\n\tvar rejects []Reject\n\tvar auditEntries []auditLogEntry\n\tbucketCounts := map[string]int{\"accepted\": 0, \"duplicate\": 0, \"invalid\": 0, \"late\": 0, \"unresolved_chargeback\": 0}\n\tshardAccepted := map[string]int{}\n\tvar minTs, maxTs time.Time\n\thasMin, hasMax := false, false\n\twatermark := st.maxTs\n\thasWatermark := st.hasMax\n\tfor _, raw := range events {\n\t\tctx := newContext(raw)\n\t\tbucket := \"invalid\"\n\t\treason := \"\"\n\t\tvar ev *Event\n\t\tif raw.Invalid {\n\t\t\tbucket = \"invalid\"\n\t\t\treason = \"invalid_json\"\n\t\t} else {\n\t\t\tev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)\n\t\t\tif ev != nil {\n\t\t\t\tif seen[ev.ID] {\n\t\t\t\t\tbucket = \"duplicate\"\n\t\t\t\t\treason = \"duplicate\"\n\t\t\t\t\tev = nil\n\t\t\t\t} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {\n\t\t\t\t\tbucket = \"late\"\n\t\t\t\t\treason = \"late\"\n\t\t\t\t\tev = nil\n\t\t\t\t} else {\n\t\t\t\t\tbucket = \"accepted\"\n\t\t\t\t\tseen[ev.ID] = true\n\t\t\t\t\tshardAccepted[ev.Shard]++\n\t\t\t\t\tif !hasMin || ev.TS.Before(minTs) {\n\t\t\t\t\t\tminTs = ev.TS\n\t\t\t\t\t\thasMin = true\n\t\t\t\t\t}\n\t\t\t\t\tif !hasMax || ev.TS.After(maxTs) {\n\t\t\t\t\t\tmaxTs = ev.TS\n\t\t\t\t\t\thasMax = true\n\t\t\t\t\t}\n\t\t\t\t\tif ev.TS.After(watermark) {\n\t\t\t\t\t\twatermark = ev.TS\n\t\t\t\t\t\thasWatermark = true\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tbucket = \"invalid\"\n\t\t\t}\n\t\t}\n\t\tbucketCounts[bucket]++\n\t\tif bucket != \"accepted\" {\n\t\t\trejects = append(rejects, Reject{Bucket: bucketCode(bucket), Event: raw.Raw})\n\t\t}\n\t\tauditEntries = append(auditEntries, auditLogEntry{\n\t\t\tShard:  raw.Shard,\n\t\t\tLine:   raw.Line,\n\t\t\tID:     ctx.IDStr(),\n\t\t\tTS:     ctx.TSString(),\n\t\t\tType:   ctx.TypeString(),\n\t\t\tBucket: bucket,\n\t\t\tReason: reason,\n\t\t\tEvent:  raw.Raw,\n\t\t})\n\t}\n\tsummary := summaryOutput{\n\t\tTotalEvents:    len(events),\n\t\tAcceptedEvents: bucketCounts[\"accepted\"],\n\t\tRejectedEvents: bucketCounts[\"duplicate\"] + bucketCounts[\"invalid\"] + bucketCounts[\"late\"] + bucketCounts[\"unresolved_chargeback\"],\n\t\tAnomalies: map[string]int{\n\t\t\t\"duplicate\":              bucketCounts[\"duplicate\"],\n\t\t\t\"invalid\":               bucketCounts[\"invalid\"],\n\t\t\t\"late\":                  bucketCounts[\"late\"],\n\t\t\t\"unresolved_chargeback\": bucketCounts[\"unresolved_chargeback\"],\n\t\t},\n\t\tRunIndex:  runIndex,\n\t}\n\tif hasWatermark {\n\t\twm := formatTS(watermark)\n\t\tsummary.Watermark = &wm\n\t}\n\tsummaryData, err := json.MarshalIndent(summary, \"\", \"  \")\n\tif err != nil {\n\t\treturn