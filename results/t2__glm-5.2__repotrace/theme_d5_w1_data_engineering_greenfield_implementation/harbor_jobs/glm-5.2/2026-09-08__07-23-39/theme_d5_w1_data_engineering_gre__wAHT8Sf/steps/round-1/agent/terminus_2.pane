     7  
     8  func writeManifest(path string, m manifestOutput) ([]byte, error) {
     9  	data, err := json.MarshalIndent(m, "", "  ")
    10  	if err != nil {
    11  		return nil, err
    12  	}
    13  	data = append(data, '\n')
    14  	if err := atomicWriteFile(path, data); err != nil {
    15  		return nil, err
    16  	}
    17  	return data, nil
    18  }
    19  
    20  func writeSignature(path, manifestPath string, manifestData []byte, maxTs *string) error {
    21  	sig := signatureOutput{
    22  		ManifestPath:   filepath.Base(manifestPath),
    23  		ManifestSHA256: sha256Hex(manifestData),
    24  		ManifestBytes:  int64(len(manifestData)),
    25  		SignedAtUTC:    signedAt(maxTs),
    26  		ToolVersion:    toolVersion,
    27  	}
    28  	data, err := json.MarshalIndent(sig, "", "  ")
    29  	if err != nil {
    30  		return err
    31  	}
    32  	data = append(data, '\n')
    33  	return atomicWriteFile(path, data)
    34  }
    35  
    36  func signedAt(maxTs *string) string {
    37  	if maxTs != nil {
    38  		return *maxTs
    39  	}
    40  	return "1970-01-01T00:00:00Z"
    41  }
