    65			watermarkLag:      300,
    66			pendingTTL:        86400,
    67			maxOpenSessions:   100000,
    68			ratesMaxStaleness: 0,
    69		}
    70		required := map[string]bool{
    71			"--input-dir": false,
    72			"--rates":     false,
    73			"--output":    false,
    74			"--rejects":   false,
    75		}
    76		if len(args) > 0 && args[0] == "ingest" {
    77			args = args[1:]
    78		}
    79		for i := 0; i < len(args); i++ {
    80			arg := args[i]
    81			switch arg {
    82			case "--input-dir":
    83				cfg.inputDir = nextArg(args, &i)
    84			case "--rates":
    85				cfg.ratesPath = nextArg(args, &i)
    86			case "--output":
    87				cfg.outputPath = nextArg(args, &i)
    88			case "--rejects":
    89				cfg.rejectsPath = nextArg(args, &i)
    90			case "--session-gap":
    91				cfg.sessionGap = atoiOrError(nextArg(args, &i), "--session-gap")
    92			case "--watermark-lag":
    93				cfg.watermarkLag = atoiOrError(nextArg(args, &i), "--watermark-lag")
    94			case "--state-in":
    95				cfg.stateIn = nextArg(args, &i)
    96			case "--state-out":
    97				cfg.stateOut = nextArg(args, &i)
    98			case "--pending-ttl":
    99				cfg.pendingTTL = atoiOrError(nextArg(args, &i), "--pending-ttl")
   100			case "--max-open-sessions":
   101				cfg.maxOpenSessions = atoiOrError(nextArg(args, &i), "--max-open-sessions")
   102			case "--audit-log":
   103				cfg.auditLog = nextArg(args, &i)
   104			case "--audit-log-digest":
   105				cfg.auditLogDigest = nextArg(args, &i)
   106			case "--audit-log-rotate-bytes":
   107				cfg.auditLogRotateBytes = atoiOrError(nextArg(args, &i), "--audit-log-rotate-bytes")
   108			case "--rates-strict":
   109				cfg.ratesStrict = true
   110			case "--rates-max-staleness":
   111				cfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), "--rates-max-staleness")
   112			case "--ingest-id":
   113				cfg.ingestID = nextArg(args, &i)
   114				cfg.ingestIDSet = true
   115			case "--out-parquet-manifest":
   116				cfg.outManifest = nextArg(args, &i)
   117			case "--manifest-signature":
   118				cfg.manifestSignature = nextArg(args, &i)
   119			case "--dedup-policy":
   120				val := nextArg(args, &i)
   121				if val != "first-arrival" && val != "lex-largest-ts" {
   122					return cliConfig{}, fmt.Errorf("ingest: --dedup-policy: must be one of {first-arrival, lex-largest-ts}")
   123				}
   124				cfg.dedupPolicy = val
   125				cfg.dedupPolicySet = true
   126			case "--strict-late-audit":
   127				cfg.strictLateAudit = true
   128			case "--state-strict":
   129				cfg.stateStrict = true
   130			default:
   131				return cliConfig{}, fmt.Errorf("ingest: unknown flag %s", arg)
   132			}
   133			if strings.HasPrefix(arg, "--") && arg != "--rates-strict" && arg != "--strict-late-audit" && arg != "--state-strict" {
   134				if _, ok := required[arg]; ok {
   135					required[arg] = true
   136				}
   137			}
   138		}
   139		for k, ok := range required {
   140			if !ok {
   141				return cliConfig{}, fmt.Errorf("ingest: %s is required", k)
   142			}
   143		}
   144		if cfg.ingestIDSet {
