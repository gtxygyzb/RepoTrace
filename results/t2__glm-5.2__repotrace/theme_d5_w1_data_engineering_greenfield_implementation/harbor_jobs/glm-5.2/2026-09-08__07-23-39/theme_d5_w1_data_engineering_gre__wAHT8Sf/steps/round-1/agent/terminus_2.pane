   200	func inputsFingerprint(shards []inputShardInfo) string {
   201		if len(shards) == 0 {
   202			return emptySHA256
   203		}
   204		var concat []byte
   205		for _, s := range shards {
   206			concat = append(concat, []byte(s.SHA256)...)
   207		}
   208		return sha256Hex(concat)
   209	}
   210	
   211	func argvSHA256(argv []string) string {
   212		var parts []string
   213		for _, tok := range argv {
   214			if !strings.Contains(tok, "/") {
   215				parts = append(parts, tok)
   216			}
   217		}
   218		joined := strings.Join(parts, " ")
   219		return sha256Hex([]byte(joined))
   220	}
   221	
   222	func envFingerprint() string {
   223		var names []string
   224		for _, kv := range os.Environ() {
   225			if strings.HasPrefix(kv, "EVENTQ_") {
   226				name := kv
   227				if idx := strings.IndexByte(kv, '='); idx >= 0 {
   228					name = kv[:idx]
   229				}
   230				if strings.HasPrefix(name, "EVENTQ_") {
   231					names = append(names, name)
   232				}
   233			}
   234		}
   235		sort.Strings(names)
   236		var buf bytes.Buffer
   237		for _, name := range names {
   238			buf.WriteString(name)
   239			buf.WriteByte('\n')
   240		}
