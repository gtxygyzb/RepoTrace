   478				ResolvedAgainst:  "state",
   479				FXFallbackStats:  fxFallbackStats,
   480				RatesDigest:      ratesDigest,
   481				SHA256:           auditSHA,
   482			}
   483			if cfg.dedupPolicySet {
   484				digest.DedupPolicyStats = &dedupPolicyStats
   485			}
   486			data, err := json.MarshalIndent(digest, "", "  ")
   487			if err != nil {
   488				return err
   489			}
   490			data = append(data, '\n')
   491			if err := atomicWriteFile(cfg.auditLogDigest, data); err != nil {
   492				return err
   493			}
   494		}
   495		if cfg.outManifest != "" {
   496			manifest, err := buildManifest(cfg, runIndex, ratesDigest, shards, shardAccepted, bucketCounts, hasMin, minTs, hasMax, maxTs)
   497			if err != nil {
   498				return err
   499			}
   500			manifestData, err := writeManifest(cfg.outManifest, manifest)
   501			if err != nil {
   502				return err
   503			}
   504			if cfg.manifestSignature != "" {
   505				var maxPtr *string
   506				if manifest.Window.MaxTs != nil {
   507					maxPtr = manifest.Window.MaxTs
   508				}
   509				if err := writeSignature(cfg.manifestSignature, cfg.outManifest, manifestData, maxPtr); err != nil {
   510					return err
   511				}
   512			}
   513		}
   514		return nil
   515	}
   516	
   517	type rejectRecord struct {
   518		bucket      string
   519		reason      string
   520		raw         rawJSON
   521		winner      bool
   522		winnerShard string
   523		winnerLine  int
   524	}
   525	
   526	func arrivalLess(a, b *Event) bool {
   527		if a.Shard != b.Shard {
   528			return a.Shard < b.Shard
   529		}
   530		return a.Line < b.Line
   531	}
   532	
   533	func buildRejects(records []rejectRecord, policy string) []byte {
   534		order := []string{"invalid", "late", "duplicate", "unresolved_chargeback"}
   535		var buf bytes.Buffer
   536		for _, bucket := range order {
   537			for _, r := range records {
   538				if r.bucket != bucket {
   539					continue
   540				}
   541				buf.Write(r.raw)
   542				if policy == "first-arrival" {
   543					buf.WriteByte('\t')
   544					if r.winner {
   545						buf.WriteString(r.winnerShard)
   546						buf.WriteByte('\t')
   547						buf.WriteString(strconv.Itoa(r.winnerLine))
   548					} else {
   549						buf.WriteString("-")
   550						buf.WriteByte('\t')
   551						buf.WriteString("-")
   552					}
   553				}
   554				buf.WriteByte('\n')
   555			}
   556		}
   557		return buf.Bytes()
   558	}
   559	
   560	func buildManifest(cfg cliConfig, runIndex int, ratesDigest string, shards []inputShardInfo, shardAccepted map[string]int, bucketCounts map[string]int, hasMin bool, minTs time.Time, hasMax bool, maxTs time.Time) (manifestOutput, error) {
   561		sortedShards := append([]inputShardInfo(nil), shards...)
   562		sort.SliceStable(sortedShards, func(i, j int) bool {
   563			return sortedShards[i].Name < sortedShards[j].Name
   564		})
   565		manifestShards := make([]manifestShard, 0, len(sortedShards))
   566		for _, s := range sortedShards {
   567			manifestShards = append(manifestShards, manifestShard{
   568				Shard:          s.Name,
   569				SHA256:         s.SHA256,
   570				Bytes:          s.Bytes,
   571				EventsTotal:    s.EventsTotal,
   572				EventsAccepted: shardAccepted[s.Name],
   573			})
   574		}
   575		outputs := manifestOutputs{}
   576		summaryOut, err := manifestFileOutputFor(cfg.outputPath)
   577		if err != nil {
   578			return manifestOutput{}, err
   579		}
   580		rejectsOut, err := manifestFileOutputFor(cfg.rejectsPath)
   581		if err != nil {
   582			return manifestOutput{}, err
   583		}
   584		outputs.Summary = summaryOut
   585		outputs.Rejects = rejectsOut
   586		if cfg.stateOut != "" {
   587			stateOut, err := manifestFileOutputFor(cfg.stateOut)
   588			if err != nil {
   589				return manifestOutput{}, err
   590			}
   591			outputs.State = stateOut
   592		}
   593		if cfg.auditLog != "" {
   594			logOut, err := manifestFileOutputFor(cfg.auditLog)
   595			if err != nil {
   596				return manifestOutput{}, err
   597			}
   598			outputs.AuditLog = logOut
   599		}
   600		if cfg.auditLogDigest != "" {
   601			digestOut, err := manifestFileOutputFor(cfg.auditLogDigest)
   602			if err != nil {
   603				return manifestOutput{}, err
   604			}
   605			outputs.AuditDigest = digestOut
   606		}
   607		window := manifestWindow{
   608			EventsAcceptedTotal: bucketCounts["accepted"],
   609			EventsRejectedTotal: bucketCounts["duplicate"] + bucketCounts["invalid"] + bucketCounts["late"] + bucketCounts["unresolved_chargeback"],
   610			BucketCounts:        bucketCounts,
   611		}
   612		if hasMin {
   613			m := formatTS(minTs)
   614			window.MinTs = &m
   615		}
   616		if hasMax {
   617			m := formatTS(maxTs)
   618			window.MaxTs = &m
   619		}
   620		var ingestID *string
   621		if cfg.ingestIDSet {
   622			id := cfg.ingestID
   623			ingestID = &id
   624		}
   625		return manifestOutput{
   626			SchemaVersion: manifestSchemaVersion,
   627			IngestID:      ingestID,
   628			RunIndex:      runIndex,
   629			RatesDigest:   ratesDigest,
   630			InputShards:   manifestShards,
   631			Outputs:       outputs,
   632			Window:        window,
   633		}, nil
   634	}
   635	
   636	func bucketCode(bucket string) int {
   637		switch bucket {
   638		case "accepted":
   639			return 0
   640		case "duplicate":
   641			return 1
   642		case "invalid":
   643			return 2
   644		case "late":
   645			return 3
   646		case "unresolved_chargeback":
   647			return 4
   648		}
   649		return 2
   650	}
