1098: 	case "duplicate":
1099: 		return 1
1100: 	case "invalid":
1101: 		return 2
1102: 	case "late":
1103: 		return 3
1104: 	case "unresolved_chargeback":
1105: 		return 4
1106: 	}
1107: 	return 2
1108: }
