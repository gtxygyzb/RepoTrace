    14	
    15	var usageString = "usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--audit-log <path>] [--audit-log-digest <path>] [--rates-strict] [--rates-max-staleness <seconds>] [--ingest-id <string>] [--out-parquet-manifest <path>] [--manifest-signature <path>]\n"
    16	
    17	type Money float64
    18	
    19	func (m Money) MarshalJSON() ([]byte, error) {
    20		return []byte(m.String()), nil
    21	}
    22	
    23	func (m Money) String() string {
    24		f := float64(m)
    25		abs := math.Abs(f)
    26		cents := int64(math.Floor(abs*100.0 + 0.5))
    27		neg := f < 0 && cents != 0
    28		dollars := cents / 100
    29		rem := cents % 100
    30		s := fmt.Sprintf("%d.%02d", dollars, rem)
    31		if neg {
    32			s = "-" + s
    33		}
    34		return s
    35	}
    36	
    37	type Event struct {
    38		ID                string
    39		Type              string
    40		TS                time.Time
    41		UserID            string
    42		Amount            float64
    43		Currency          string
    44		RefID             string
    45		USD               float64
    46		RefUSD            float64
    47		FXFallbackDays    int
    48		ResolvedAgainst   *string
    49		ResolvedOriginRun int
