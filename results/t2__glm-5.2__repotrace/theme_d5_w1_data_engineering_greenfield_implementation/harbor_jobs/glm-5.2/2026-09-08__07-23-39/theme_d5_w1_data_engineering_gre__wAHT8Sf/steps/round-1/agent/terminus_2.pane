    98				cfg.summarySchemaDigest = strings.TrimPrefix(arg, "--summary-schema-digest=")
    99				if cfg.summarySchemaDigest == "" {
   100					return cliConfig{}, fmt.Errorf("ingest: --summary-schema-digest: value must be non-empty")
   101				}
   102				continue
   103			}
   104			if strings.HasPrefix(arg, "--summary-schema-index=") {
   105				cfg.summarySchemaIndex = strings.TrimPrefix(arg, "--summary-schema-index=")
   106				if cfg.summarySchemaIndex == "" {
   107					return cliConfig{}, fmt.Errorf("ingest: --summary-schema-index: value must be non-empty")
   108				}
   109				continue
   110			}
   111			switch arg {
   112			case "--input-dir":
   113				cfg.inputDir = nextArg(args, &i)
   114			case "--rates":
