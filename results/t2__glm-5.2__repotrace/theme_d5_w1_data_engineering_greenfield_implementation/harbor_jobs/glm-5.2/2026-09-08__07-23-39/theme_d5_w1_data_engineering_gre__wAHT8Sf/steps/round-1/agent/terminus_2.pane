   918	func writeAuditLog(path string, entries []auditLogEntry, rotateBytes int) []string {
   919		var segments []string
   920		if rotateBytes <= 0 {
   921			var buf bytes.Buffer
   922			for _, e := range entries {
   923				b, err := json.Marshal(e)
   924				if err != nil {
   925					panic(err)
   926				}
   927				buf.Write(b)
   928				buf.WriteByte('\n')
   929			}
   930			if err := atomicWriteFile(path, buf.Bytes()); err != nil {
   931				panic(err)
   932			}
   933			return []string{path}
   934		}
   935	
   936		current := path
   937		var buf bytes.Buffer
   938		flush := func() {
   939			if err := atomicWriteFile(current, buf.Bytes()); err != nil {
   940				panic(err)
   941			}
   942			segments = append(segments, current)
   943			buf.Reset()
   944		}
   945		for _, e := range entries {
   946			b, err := json.Marshal(e)
   947			if err != nil {
   948				panic(err)
   949			}
   950			rec := append(b, '\n')
   951			if buf.Len() > 0 && buf.Len()+len(rec) > rotateBytes {
   952				flush()
   953				current = fmt.Sprintf("%s.%d", path, len(segments))
   954			}
   955			buf.Write(rec)
   956		}
   957		if buf.Len() > 0 || len(segments) == 0 {
   958			flush()
   959		}
   960		return segments
