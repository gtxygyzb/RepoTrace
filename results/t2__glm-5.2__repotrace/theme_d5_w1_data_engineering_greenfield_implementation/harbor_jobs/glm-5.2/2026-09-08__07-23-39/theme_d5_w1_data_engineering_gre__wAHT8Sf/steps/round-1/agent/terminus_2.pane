const manifestSchemaVersion = "eventq.manifest/v1"
[?2004hroot@n30009:/app# sed -n '1,220p' helpers.go
[?2004lpackage main

import (
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"math"
	"os"
	"path/filepath"
	"strings"
	"time"
)

func rawStringPtr(obj map[string]json.RawMessage, key string) *string {
	if obj == nil {
		return nil
	}
	raw, ok := obj[key]
	if !ok {
		return nil
	}
	var s string
	if err := json.Unmarshal(raw, &s); err != nil {
		return nil
	}
	return &s
}

func getRawString(obj map[string]json.RawMessage, key string) (string, bool, bool) {
	if obj == nil {
		return "", false, false
	}
	raw, present := obj[key]
	if !present {
		return "", false, false
	}
	var s string
	if err := json.Unmarshal(raw, &s); err != nil {
		return "", false, true
	}
	return s, true, true
}

func getJSONInt(raw json.RawMessage) (int, error) {
	var n int
	if err := json.Unmarshal(raw, &n); err != nil {
		return 0, err
	}
	return n, nil
}

func parseTime(s string) (time.Time, error) {
	s = strings.TrimSpace(s)
	if strings.HasSuffix(s, "Z") {
		if t, err := time.Parse("2006-01-02T15:04:05Z", s); err == nil {
			return t.UTC(), nil
		}
		if t, err := time.Parse("2006-01-02T15:04:05.000000000Z", s); err == nil {
			return t.UTC(), nil
		}
	}
	if t, err := time.Parse(time.RFC3339Nano, s); err == nil {
		return t.UTC(), nil
	}
	if t, err := time.Parse(time.RFC3339, s); err == nil {
		return t.UTC(), nil
	}
	return time.Time{}, fmt.Errorf("bad timestamp: %s", s)
}

func formatTS(t time.Time) string {
	return t.UTC().Format("2006-01-02T15:04:05Z")
}

func dateKey(t time.Time) string {
	return t.UTC().Format("2006-01-02")
}

func roundMoney(v float64) float64 {
	cents := int64(math.Floor(math.Abs(v)*100.0 + 0.5))
	if v < 0 && cents != 0 {
		return -float64(cents) / 100.0
	}
	return float64(cents) / 100.0
}

func isFinite(f float64) bool {
	return !math.IsNaN(f) && !math.IsInf(f, 0)
}

func isDate(s string) bool {
	if _, err := time.Parse("2006-01-02", s); err != nil {
		return false
	}
	return true
}

func sha256Hex(data []byte) string {
	sum := sha256.Sum256(data)
	return hex.EncodeToString(sum[:])
}

func sha256Short(h string) string {
	if len(h) < 12 {
		return h
	}
	return h[:12]
}

func fileDigest(path string) (string, int64, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return "", 0, err
	}
	return sha256Hex(data), int64(len(data)), nil
}

func atomicWriteFile(path string, data []byte) error {
	tmp := path + ".tmp"
	if err := os.WriteFile(tmp, data, 0644); err != nil {
		return err
	}
	if err := os.Rename(tmp, path); err != nil {
		_ = os.Remove(tmp)
		return err
	}
	return nil
}

func parentDirExists(path string) bool {
	dir := filepath.Dir(path)
	if dir == "." || dir == "" {
		return true
	}
	info, err := os.Stat(dir)
	if err != nil {
		return false
	}
	return info.IsDir()
}

func manifestFileOutputFor(path string) (*manifestFileOutput, error) {
	h, b, err := fileDigest(path)
	if err != nil {
		return nil, err
	}
	return &manifestFileOutput{
		Path:        filepath.Base(path),
		SHA256:      h,
		SHA256Short: sha256Short(h),
		Bytes:       b,
	}, nil
}

func ptrString(s string) *string {
	return &s
}

func (ctx *eventContext) IDStr() string {
	if ctx.ID != nil {
		return *ctx.ID
	}
	return ""
}

func (ctx *eventContext) TSString() string {
	if ctx.TS != nil {
		return *ctx.TS
	}
	return ""
}

func (ctx *eventContext) TypeString() string {
	if ctx.Type != nil {
		return *ctx.Type
	}
	return ""
}
[?2004hroot@n30009:/app# sed -n '1,180p' manifest.go
[?2004lpackage main

import (
	"encoding/json"
	"path/filepath"
)

func writeManifest(path string, m manifestOutput) ([]byte, error) {
	data, err := json.MarshalIndent(m, "", "  ")
	if err != nil {
		return nil, err
	}
	data = append(data, '\n')
	if err := atomicWriteFile(path, data); err != nil {
		return nil, err
	}
	return data, nil
}

func writeSignature(path, manifestPath string, manifestData []byte, maxTs *string) error {
	sig := signatureOutput{
		ManifestPath:   filepath.Base(manifestPath),
		ManifestSHA256: sha256Hex(manifestData),
		ManifestBytes:  int64(len(manifestData)),
		SignedAtUTC:    signedAt(maxTs),
		ToolVersion:    toolVersion,
	}
	data, err := json.MarshalIndent(sig, "", "  ")
	if err != nil {
		return err
	}
	data = append(data, '\n')
	return atomicWriteFile(path, data)
}

func signedAt(maxTs *string) string {
	if maxTs != nil {
		return *maxTs
	}
	return "1970-01-01T00:00:00Z"
}
