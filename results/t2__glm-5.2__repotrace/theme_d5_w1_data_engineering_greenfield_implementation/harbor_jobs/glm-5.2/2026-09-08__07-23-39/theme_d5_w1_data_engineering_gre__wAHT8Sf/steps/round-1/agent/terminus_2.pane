	} if cfg.outManifest != "" {
		manifest, err := buildManifest(cfg, runIndex, ratesDigest,
		shards, shardAccepted, bucketCounts, hasMin, minTs,
		hasMax, maxTs) if err != nil {
			return err
		} manifestData, err := writeManifest(cfg.outManifest,
		manifest) if err != nil {
			return err
		} if cfg.manifestSignature != "" {
			var maxPtr *string if manifest.Window.MaxTs !=
			nil {
				maxPtr = manifest.Window.MaxTs
			} if err := writeSignature(cfg.manifestSignature,
			cfg.outManifest, manifestData, maxPtr); err !=
			nil {
				return err
			}
		}
	} return nil
}

func buildManifest(cfg cliConfig, runIndex int, ratesDigest string,
shards []inputShardInfo, shardAccepted map[string]int, bucketCounts
map[string]int, hasMin bool, minTs time.Time, hasMax bool, maxTs
time.Time) (manifestOutput, error) {
	sortedShards := append([]inputShardInfo(nil), shards...)
	sort.SliceStable(sortedShards, func(i, j int) bool {
		return sortedShards[i].Name < sortedShards[j].Name
	}) manifestShards := make([]manifestShard, 0, len(sortedShards))
	for _, s := range sortedShards {
		manifestShards = append(manifestShards, manifestShard{
			Shard:		s.Name, SHA256:		s.SHA256,
			Bytes:		s.Bytes, EventsTotal:
			s.EventsTotal, EventsAccepted:
			shardAccepted[s.Name],
		})
	} outputs := manifestOutputs{} summaryOut, err :=
	manifestFileOutputFor(cfg.outputPath) if err != nil {
		return manifestOutput{}, err
	} rejectsOut, err := manifestFileOutputFor(cfg.rejectsPath)
	if err != nil {
		return manifestOutput{}, err
	} outputs.Summary = summaryOut outputs.Rejects = rejectsOut if
	cfg.stateOut != "" {
		stateOut, err := manifestFileOutputFor(cfg.stateOut)
		if err != nil {
			return manifestOutput{}, err
		} outputs.State = stateOut
	} if cfg.auditLog != "" {
		logOut, err := manifestFileOutputFor(cfg.auditLog)
		if err != nil {
			return manifestOutput{}, err
		} outputs.AuditLog = logOut
	} if cfg.auditLogDigest != "" {
		digestOut, err :=
		manifestFileOutputFor(cfg.auditLogDigest) if err != nil {
			return manifestOutput{}, err
		} outputs.AuditDigest = digestOut
	} window := manifestWindow{
		EventsAcceptedTotal: bucketCounts["accepted"],
		EventsRejectedTotal: bucketCounts["duplicate"] +
		bucketCounts["invalid"] + bucketCounts["late"] +
		bucketCounts["unresolved_chargeback"], BucketCounts:
		bucketCounts,
	} if hasMin {
		m := formatTS(minTs) window.MinTs = &m
	} if hasMax {
		m := formatTS(maxTs) window.MaxTs = &m
	} var ingestID *string if cfg.ingestIDSet {
		id := cfg.ingestID ingestID = &id
	} return manifestOutput{
		SchemaVersion: manifestSchemaVersion, IngestID:
		ingestID, RunIndex:	 runIndex, RatesDigest:
		ratesDigest, InputShards:   manifestShards, Outputs:
		outputs, Window:	window,
	}, nil
}

func bucketCode(bucket string) int {
	switch bucket { case "accepted":
		return 0
	case "duplicate":
		return 1
	case "invalid":
		return 2
	case "late":
		return 3
	case "unresolved_chargeback":
		return 4
	} return 2
