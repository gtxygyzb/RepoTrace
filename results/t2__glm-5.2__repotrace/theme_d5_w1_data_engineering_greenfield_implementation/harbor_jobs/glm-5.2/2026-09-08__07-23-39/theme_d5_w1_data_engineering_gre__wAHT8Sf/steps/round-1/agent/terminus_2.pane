    91	
    92	func sortedKeys[T any](m map[string]T) []string {
    93		keys := make([]string, 0, len(m))
    94		for k := range m {
    95			keys = append(keys, k)
    96		}
    97		sort.Strings(keys)
    98		return keys
    99	}
   100	
   101	func isStrictDate(s string) bool {
   102		if len(s) != 10 {
   103			return false
   104		}
   105		for i, c := range s {
   106			if i == 4 || i == 7 {
   107				if c != '-' {
   108					return false
   109				}
   110				continue
   111			}
   112			if c < '0' || c > '9' {
   113				return false
   114			}
   115		}
   116		return true
   117	}
   118	
   119	func dayEpoch(date string) time.Time {
   120		t, err := time.Parse("2006-01-02", date)
   121		if err != nil {
   122			return time.Time{}
   123		}
   124		return t.UTC()
   125	}
   126	
   127	func calendarDayDiff(rateDate, eventDate string) int {
   128		r := dayEpoch(rateDate)
   129		e := dayEpoch(eventDate)
   130		if r.IsZero() || e.IsZero() {
   131			return 0
   132		}
   133		return int(r.Sub(e) / (24 * time.Hour))
   134	}
   135	
   136	func absInt(v int) int {
   137		if v < 0 {
   138			return -v
   139		}
   140		return v
