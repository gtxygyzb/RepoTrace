   100	
   101	func isStrictDate(s string) bool {
   102		if len(s) != 10 {
   103			return false
   104		}
   105		for i, c := range s {
   106			if i == 4 || i == 7 {
   107				if c != '-' {
   108					return false
   109				}
   110				continue
   111			}
   112			if c < '0' || c > '9' {
   113				return false
   114			}
   115		}
   116		return true
   117	}
   118	
   119	func dayEpoch(date string) time.Time {
   120		t, err := time.Parse("2006-01-02", date)
   121		if err != nil {
   122			return time.Time{}
   123		}
   124		return t.UTC()
   125	}
   126	
   127	func calendarDayDiff(rateDate, eventDate string) int {
   128		r := dayEpoch(rateDate)
   129		e := dayEpoch(eventDate)
   130		if r.IsZero() || e.IsZero() {
   131			return 0
   132		}
   133		return int(r.Sub(e) / (24 * time.Hour))
   134	}
   135	
   136	func absInt(v int) int {
   137		if v < 0 {
   138			return -v
   139		}
   140		return v
   141	}
   142	
   143	func absInt64(v int64) int64 {
   144		if v < 0 {
   145			return -v
   146		}
   147		return v
   148	}
   149	
   150	func (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {
   151		if !rt.known[currency] {
   152			return 0, 0, "fx_unknown_currency"
   153		}
   154		if m, ok := rt.days[date]; ok {
   155			if r, ok := m[currency]; ok {
   156				if isUsableRate(r) {
   157					return r, 0, ""
   158				}
   159				return 0, 0, "bad_rate"
   160			}
   161		}
   162		if maxStaleness > 0 {
   163			eventDay := dayEpoch(date)
   164			if !eventDay.IsZero() {
   165				var bestDate string
   166				var bestDist int64 = -1
   167				for _, d := range sortedKeys(rt.days) {
   168					if _, ok := rt.days[d][currency]; !ok {
   169						continue
   170					}
   171					dayTime := dayEpoch(d)
   172					if dayTime.IsZero() {
   173						continue
   174					}
   175					dist := absInt64(dayTime.Unix() - eventDay.Unix())
   176					if dist > int64(maxStaleness) {
   177						continue
   178					}
   179					if bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {
   180						bestDist = dist
   181						bestDate = d
   182					}
   183				}
   184				if bestDate != "" {
   185					r := rt.days[bestDate][currency]
   186					if isUsableRate(r) {
   187						return r, calendarDayDiff(bestDate, date), ""
   188					}
   189					return 0, 0, "bad_rate"
   190				}
   191			}
   192		}
   193		return 0, 0, "missing_rate"
   194	}
   195	
   196	func loadRates(path string) (*RateTable, error) {
   197		data, err := os.ReadFile(path)
   198		if err != nil {
   199			return nil, err
   200		}
   201		var top map[string]json.RawMessage
   202		if err := json.Unmarshal(data, &top); err != nil {
   203			return nil, fmt.Errorf("rates file is not valid json: %w", err)
   204		}
   205		rt := newRateTable()
   206		daysRaw, ok := top["days"]
   207		if !ok {
   208			return nil, errors.New("fx days invalid")
   209		}
   210		var days map[string]json.RawMessage
   211		if err := json.Unmarshal(daysRaw, &days); err != nil {
   212			return nil, errors.New("fx days invalid")
   213		}
   214		if len(days) == 0 {
   215			return nil, errors.New("fx days invalid")
   216		}
   217		for _, day := range sortedKeys(days) {
   218			if !isStrictDate(day) || !isDate(day) {
   219				return nil, fmt.Errorf("ingest: rates.json: invalid day key %s", day)
   220			}
   221			var currencies map[string]json.RawMessage
   222			if err := json.Unmarshal(days[day], &currencies); err != nil {
   223				return nil, errors.New("fx days invalid")
   224			}
   225			for _, currency := range sortedKeys(currencies) {
   226				f, err := parseRateNumber(currencies[currency])
   227				if err != nil {
   228					return nil, fmt.Errorf("ingest: rates.json: non-numeric rate for %s/%s", day, currency)
   229				}
   230				if rt.days[day] == nil {
   231					rt.days[day] = map[string]float64{}
   232				}
   233				rt.days[day][currency] = f
   234				rt.known[currency] = true
   235			}
   236		}
   237		baseRaw, baseOk := top["base"]
   238		if !baseOk {
   239			return nil, errors.New("ingest: rates.json: base required")
   240		}
   241		var base string
   242		if err := json.Unmarshal(baseRaw, &base); err != nil || base == "" {
   243			return nil, errors.New("ingest: rates.json: base required")
   244		}
   245		rt.base = base
   246		if base != "USD" {
   247			return nil, errors.New("fx base must be USD")
   248		}
   249		for _, day := range sortedKeys(rt.days) {
   250			r, ok := rt.days[day][base]
   251			if !ok || r != 1.0 {
   252				return nil, fmt.Errorf("ingest: rates.json: base currency %s must have rate 1.0 on day %s", base, day)
   253			}
   254		}
   255		return rt, nil
   256	}
