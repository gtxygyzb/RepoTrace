   106	func buildRunProvenanceFlags(cfg cliConfig) []orderedJSON {
   107		var entries []orderedJSON
   108		for _, name := range runProvenanceFlagOrder {
   109			if !cfg.observedFlags[name] {
   110				continue
   111			}
   112			entries = append(entries, orderedJSON{key: name, value: runProvenanceFlagValue(cfg, name)})
   113		}
   114		return entries
   115	}
