   382	func jsonBytes(s string) []byte {
   383	  b, err := json.Marshal(s)
   384	  if err != nil {
   385	    return []byte(`""`)
   386	  }
   387	  return b
   388	}
   389	
   390	func strPtr(s string) *string {
   391	  return &s
   392	}
   393	
   394	func absDur(d time.Duration) time.Duration {
   395	  if d < 0 {
   396	    return -d
   397	  }
   398	  return d
   399	}
