   454	func (e strictObservedDivergenceError) Error() string {
   455		return fmt.Sprintf("ingest: --summary-time-range-policy: strict-observed divergence: accepted=[%s,%s] observed=[%s,%s]", nullOrValue(e.acceptedMin), nullOrValue(e.acceptedMax), nullOrValue(e.observedMin), nullOrValue(e.observedMax))
