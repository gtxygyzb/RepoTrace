[?2004l   181  	var st *loadedState
   182  	runIndex := 1
   183  	if cfg.stateIn != "" {
   184  		st, err = loadState(cfg.stateIn)
   185  		if err != nil && !os.IsNotExist(err) {
   186  			return err
   187  		}
   188  		if st != nil {
   189  			runIndex = st.runIndex + 1
   190  		}
   191  	}
   192  	events, shards, err := readInputEvents(cfg.inputDir)
   193  	if err != nil {
   194  		return err
   195  	}
   196  	seen := map[string]bool{}
   197  	if st != nil {
   198  		for k, v := range st.seenIds {
   199  			seen[k] = v
   200  		}
   201  	}
   202  	var pending []pendingEntry
   203  	openSessions := map[string]carriedSession{}
   204  	if st != nil {
   205  		pending = append([]pendingEntry(nil), st.pending...)
   206  		for k, v := range st.openSessions {
   207  			openSessions[k] = v
   208  		}
   209  	}
   210  	bucketCounts := map[string]int{"accepted": 0, "duplicate": 0, "invalid": 0, "late": 0, "unresolved_chargeback": 0}
   211  	invalidReasons := map[string]int{}
   212  	duplicateReasons := map[string]int{"same_run": 0, "cross_run": 0}
   213  	fxFallbackStats := map[string]int{"0": 0}
   214  	shardAccepted := map[string]int{}
   215  	var minTs, maxTs time.Time
   216  	hasMin, hasMax := false, false
   217  	var watermark time.Time
   218  	hasWatermark := false
   219  	if st != nil {
   220  		watermark = st.maxTs
   221  		hasWatermark = st.hasMax
   222  	}
   223  
   224  	type candidate struct {
   225  		raw       rawEvent
   226  		ctx       *eventContext
   227  		ev        *Event
   228  		duplicate bool
   229  	}
   230  	var candidates []candidate
   231  	var auditEntries []auditLogEntry
   232  	var rejectRecords []rejectRecord
   233  
   234  	// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.
   235  	for _, raw := range events {
   236  		ctx := newContext(raw)
   237  		bucket := "invalid"
   238  		reason := ""
   239  		var ev *Event
   240  		if raw.Invalid {
   241  			bucket = "invalid"
   242  			reason = "invalid_json"
   243  		} else {
   244  			ev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)
   245  			if ev != nil {
   246  				if seen[ev.ID] {
   247  					bucket = "duplicate"
   248  					reason = "cross_run"
   249  					bucketCounts[bucket]++
   250  					duplicateReasons["cross_run"]++
   251  					auditEntries = append(auditEntries, auditLogEntry{
   252  						Shard:  raw.Shard,
   253  						Line:   raw.Line,
   254  						ID:     ctx.IDStr(),
   255  						TS:     ctx.TSString(),
   256  						Type:   ctx.TypeString(),
   257  						Bucket: bucket,
   258  						Reason: reason,
   259  						Event:  raw.Raw,
   260  					})
   261  					rejectRecords = append(rejectRecords, rejectRecord{bucket: bucket, reason: reason, raw: raw.Raw})
   262  					continue
   263  				} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {
   264  					bucket = "late"
   265  					reason = "late"
   266  					ev = nil
   267  				} else {
   268  					bucket = "accepted"
   269  					if !hasMin || ev.TS.Before(minTs) {
   270  						minTs = ev.TS
   271  						hasMin = true
   272  					}
   273  					if !hasMax || ev.TS.After(maxTs) {
   274  						maxTs = ev.TS
   275  						hasMax = true
   276  					}
   277  					if ev.TS.After(watermark) {
   278  						watermark = ev.TS
   279  						hasWatermark = true
   280  					}
   281  				}
   282  			} else {
   283  				bucket = "invalid"
   284  			}
   285  		}
   286  		if bucket == "invalid" {
   287  			invalidReasons[reason]++
   288  		}
   289  		bucketCounts[bucket]++
   290  		if bucket != "accepted" {
   291  			rejectRecords = append(rejectRecords, rejectRecord{bucket: bucket, reason: reason, raw: raw.Raw})
   292  		}
   293  		candidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})
   294  		auditEntries = append(auditEntries, auditLogEntry{
   295  			Shard:  raw.Shard,
   296  			Line:   raw.Line,
   297  			ID:     ctx.IDStr(),
   298  			TS:     ctx.TSString(),
   299  			Type:   ctx.TypeString(),
   300  			Bucket: bucket,
   301  			Reason: reason,
   302  			Event:  raw.Raw,
   303  		})
   304  	}
   305  
   306  	// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.
   307  	groups := map[string][]int{}
   308  	for i, c := range candidates {
   309  		if c.ev != nil {
   310  			groups[c.ev.ID] = append(groups[c.ev.ID], i)
   311  		}
   312  	}
   313  	winnerSet := map[int]bool{}
   314  	winners := map[string]int{}
   315  	var dedupPolicyStats dedupPolicyStats
   316  	dedupPolicyStats.Policy = cfg.dedupPolicy
   317  	for _, id := range sortedKeys(map[string]bool{}) {
   318  		_ = id
   319  	}
   320  	for id, idxs := range groups {
   321  		if len(idxs) < 2 {
   322  			if len(idxs) == 1 {
   323  				winners[id] = idxs[0]
   324  				winnerSet[idxs[0]] = true
   325  			}
   326  			continue
   327  		}
   328  		winner := idxs[0]
   329  		for _, idx := range idxs[1:] {
   330  			if cfg.dedupPolicy == "first-arrival" {
   331  				if arrivalLess(candidates[idx].ev, candidates[winner].ev) {
   332  					winner = idx
   333  				}
   334  			} else {
   335  				if candidates[idx].ev.TS.After(candidates[winner].ev.TS) {
   336  					winner = idx
   337  				}
   338  			}
   339  		}
   340  		winners[id] = winner
   341  		winnerSet[winner] = true
   342  		sameShard := true
   343  		for _, idx := range idxs {
   344  			if candidates[idx].ev.Shard != candidates[winner].ev.Shard {
   345  				sameShard = false
   346  				break
   347  			}
   348  		}
   349  		if sameShard {
   350  			dedupPolicyStats.DuplicateWinnersSameShard++
   351  			dedupPolicyStats.DuplicateWinnersLineTiebreak++
   352  		} else {
   353  			dedupPolicyStats.DuplicateWinnersCrossShard++
   354  		}
   355  	}
   356  
   357  	// Finalize accepted/duplicate buckets and outputs in arrival order.
   358  	bucketCounts["accepted"] = 0
   359  	for i, c := range candidates {
   360  		if c.ev == nil {
   361  			continue
   362  		}
   363  		if winnerSet[i] {
   364  			bucketCounts["accepted"]++
   365  			shardAccepted[c.ev.Shard]++
   366  			seen[c.ev.ID] = true
   367  			_ = pending
   368  			_ = openSessions
   369  		} else {
   370  			bucketCounts["duplicate"]++
   371  			duplicateReasons["same_run"]++
   372  			entry := auditEntries[i]
   373  			entry.Bucket = "duplicate"
   374  			entry.Reason = "same_run"
   375  			if cfg.dedupPolicy == "first-arrival" {
   376  				w := winners[entry.ID]
   377  				entry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}
   378  			}
   379  			auditEntries[i] = entry
   380  			rejectRecords = append(rejectRecords, rejectRecord{bucket: "duplicate", reason: "same_run", raw: c.raw.Raw, winner: true, winnerShard: candidates[winners[c.ev.ID]].ev.Shard, winnerLine: candidates[winners[c.ev.ID]].ev.Line})
   381  		}
   382  	}
   383  
   384  	summary := summaryOutput{
   385  		TotalEvents:    len(events),
   386  		AcceptedEvents: bucketCounts["accepted"],
   387  		RejectedEvents: bucketCounts["duplicate"] + bucketCounts["invalid"] + bucketCounts["late"] + bucketCounts["unresolved_chargeback"],
   388  		Anomalies: map[string]int{
   389  			"duplicate":             bucketCounts["duplicate"],
   390  			"invalid":               bucketCounts["invalid"],
   391  			"late":                  bucketCounts["late"],
   392  			"unresolved_chargeback": bucketCounts["unresolved_chargeback"],
   393  		},
   394  		RunIndex: runIndex,
   395  	}
   396  	if hasWatermark {
   397  		wm := formatTS(watermark)
   398  		summary.Watermark = &wm
   399  	}
   400  	summaryData, err := json.MarshalIndent(summary, "", "  ")
   401  	if err != nil {
   402  		return err
   403  	}
   404  	summaryData = append(summaryData, '\n')
   405  	if err := atomicWriteFile(cfg.outputPath, summaryData); err != nil {
   406  		return err
   407  	}
   408  	rejectsData := buildRejects(rejectRecords, cfg.dedupPolicy)
   409  	if err := atomicWriteFile(cfg.rejectsPath, rejectsData); err != nil {
   410  		return err
   411  	}
   412  	if cfg.stateOut != "" {
   413  		stateData := buildStateOut(watermark, hasWatermark, st, sortedSeenIDs(seen), sortedPending(pending), sortedOpenSessions(openSessions), runIndex)
   414  		if err := atomicWriteFile(cfg.stateOut, stateData); err != nil {
   415  			return err
   416  		}
   417  	}
   418  	if cfg.auditLog != "" {
   419  		var buf bytes.Buffer
   420  		for _, e := range auditEntries {
   421  			b, err := json.Marshal(e)
   422  			if err != nil {
   423  				return err
   424  			}
   425  			buf.Write(b)
   426  			buf.WriteByte('\n')
   427  		}
   428  		if err := atomicWriteFile(cfg.auditLog, buf.Bytes()); err != nil {
   429  			return err
   430  		}
