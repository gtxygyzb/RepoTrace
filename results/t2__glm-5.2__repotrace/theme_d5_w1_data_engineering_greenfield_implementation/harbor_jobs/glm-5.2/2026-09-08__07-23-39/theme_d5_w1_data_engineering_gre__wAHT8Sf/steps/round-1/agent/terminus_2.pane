   392		hasMin, hasMax = false, false
   393		for _, c := range candidates {
   394			if c.ev != nil {
   395				seen[c.ev.ID] = true
   396			}
   397		}
   398		bucketCounts["accepted"] = 0
   399		bucketCounts["duplicate"] = duplicateReasons["cross_run"]
   400		for i, c := range candidates {
   401			_ = i
   402			if c.ev == nil {
   403				continue
   404			}
   405			if winnerSet[i] {
   406				bucketCounts["accepted"]++
   407				shardAccepted[c.ev.Shard]++
   408				if !hasMin || c.ev.TS.Before(minTs) {
   409					minTs = c.ev.TS
   410					hasMin = true
   411				}
   412				if !hasMax || c.ev.TS.After(maxTs) {
   413					maxTs = c.ev.TS
   414					hasMax = true
   415				}
   416				_ = pending
   417				_ = openSessions
   418			} else {
   419				bucketCounts["duplicate"]++
   420				duplicateReasons["same_run"]++
   421				entry := auditEntries[i]
   422				entry.Bucket = "duplicate"
   423				entry.Reason = "same_run"
   424				if cfg.dedupPolicy == "first-arrival" {
   425					w := winners[entry.ID]
   426					entry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}
   427				}
   428				auditEntries[i] = entry
   429			}
   430		}
   431	
   432		var rejectRecords []rejectRecord
   433		for i, c := range candidates {
   434			if c.ev == nil {
   435				r := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, raw: c.raw.Raw}
   436				rejectRecords = append(rejectRecords, r)
   437				continue
   438			}
   439			if winnerSet[i] {
   440				continue
   441			}
   442			r := rejectRecord{bucket: "duplicate", reason: "same_run", raw: c.raw.Raw}
   443			if cfg.dedupPolicy == "first-arrival" {
   444				r.winner = true
   445				r.winnerShard = candidates[winners[c.ev.ID]].ev.Shard
   446				r.winnerLine = candidates[winners[c.ev.ID]].ev.Line
   447			}
   448			rejectRecords = append(rejectRecords, r)
   449		}
   450	
   451		summary := summaryOutput{
   452			TotalEvents:    len(events),
   453			AcceptedEvents: bucketCounts["accepted"],
   454			RejectedEvents: bucketCounts["duplicate"] + bucketCounts["invalid"] + bucketCounts["late"] + bucketCounts["unresolved_chargeback"],
   455			Anomalies: map[string]int{
   456				"duplicate":             bucketCounts["duplicate"],
   457				"invalid":               bucketCounts["invalid"],
   458				"late":                  bucketCounts["late"],
   459				"unresolved_chargeback": bucketCounts["unresolved_chargeback"],
   460			},
   461			RunIndex: runIndex,
   462		}
   463		if hasWatermark {
   464			wm := formatTS(watermark)
   465			summary.Watermark = &wm
   466		}
   467		summaryData, err := json.MarshalIndent(summary, "", "  ")
   468		if err != nil {
   469			return err
   470		}
   471		summaryData = append(summaryData, '\n')
   472		if err := atomicWriteFile(cfg.outputPath, summaryData); err != nil {
   473			return err
   474		}
   475		rejectsData := buildRejects(rejectRecords, cfg.dedupPolicy)
   476		if err := atomicWriteFile(cfg.rejectsPath, rejectsData); err != nil {
   477			return err
   478		}
   479		if cfg.stateOut != "" {
   480			stateData := buildStateOut(watermark, hasWatermark, st, sortedSeenIDs(seen), sortedPending(pending), sortedOpenSessions(openSessions), runIndex)
   481			if err := atomicWriteFile(cfg.stateOut, stateData); err != nil {
   482				return err
   483			}
   484		}
   485		var auditSegmentPaths []string
   486		if cfg.auditLog != "" {
   487			auditSegmentPaths = writeAuditLog(cfg.auditLog, auditEntries, cfg.auditLogRotateBytes)
   488		}
   489		if cfg.auditLogDigest != "" {
   490			digest := auditDigestOutput{
   491				SchemaVersion:    "eventq.digest/v1",
   492				TotalRecords:     len(auditEntries),
   493				BucketCounts:     bucketCounts,
   494				InvalidReasons:   invalidReasons,
   495				DuplicateReasons: duplicateReasons,
   496				LateCutoffStats:  computeLateCutoffStats(auditEntries),
   497				ResolvedAgainst:  "state",
   498				FXFallbackStats:  fxFallbackStats,
   499				RatesDigest:      ratesDigest,
   500			}
   501			if cfg.dedupPolicySet {
   502				digest.DedupPolicyStats = &dedupPolicyStats
