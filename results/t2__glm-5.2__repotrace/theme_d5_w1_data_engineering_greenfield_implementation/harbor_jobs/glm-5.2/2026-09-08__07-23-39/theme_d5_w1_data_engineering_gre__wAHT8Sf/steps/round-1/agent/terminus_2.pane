func writeOrderedObject(buf *bytes.Buffer, entries []orderedJSON) {
	buf.WriteByte('{')
	for i, e := range entries {
		if i > 0 {
			buf.WriteByte(',')
		}
		writeJSONString(buf, e.key)
		buf.WriteByte(':')
		writeOrderedValue(buf, e.value)
	}
	buf.WriteByte('}')
}

func writeOrderedArrayAny(buf *bytes.Buffer, arr []any) {
	buf.WriteByte('[')
	for i, v := range arr {
		if i > 0 {
			buf.WriteByte(',')
		}
		writeOrderedValue(buf, v)
	}
	buf.WriteByte(']')
}

func writeJSONString(buf *bytes.Buffer, s string) {
	b, _ := json.Marshal(s)
	buf.Write(b)
}

func writeOrderedIndent(buf *bytes.Buffer, v any, indent int) {
	writeOrderedIndentValue(buf, v, indent)
}

func writeOrderedIndentValue(buf *bytes.Buffer, v any, indent int) {
	switch val := v.(type) {
	case []orderedJSON:
		writeOrderedIndentObject(buf, val, indent)
	case orderedArray:
		writeOrderedIndentArrayAny(buf, val, indent)
	case []any:
		writeOrderedIndentArrayAny(buf, val, indent)
	case string:
		writeJSONString(buf, val)
	case int:
		fmt.Fprintf(buf, "%d", val)
	case int64:
		fmt.Fprintf(buf, "%d", val)
	case bool:
		if val {
			buf.WriteString("true")
		} else {
			buf.WriteString("false")
		}
	case nil:
		buf.WriteString("null")
	case orderedJSON:
		writeOrderedIndentValue(buf, val.value, indent)
	default:
		b, _ := json.Marshal(val)
		buf.Write(b)
	}
}

func writeOrderedIndentObject(buf *bytes.Buffer, entries []orderedJSON, indent int) {
	if len(entries) == 0 {
		buf.WriteString("{}")
		return
	}
	buf.WriteByte('{')
	buf.WriteByte('\n')
	for i, e := range entries {
		writeIndent(buf, indent+1)
		writeJSONString(buf, e.key)
		buf.WriteString(": ")
		writeOrderedIndentValue(buf, e.value, indent+1)
		if i < len(entries)-1 {
			buf.WriteByte(',')
		}
		buf.WriteByte('\n')
	}
	writeIndent(buf, indent)
	buf.WriteByte('}')
}

func writeOrderedIndentArrayAny(buf *bytes.Buffer, arr []any, indent int) {
	if len(arr) == 0 {
		buf.WriteString("[]")
		return
	}
	buf.WriteByte('[')
	buf.WriteByte('\n')
	for i, v := range arr {
		writeIndent(buf, indent+1)
		writeOrderedIndentValue(buf, v, indent+1)
		if i < len(arr)-1 {
			buf.WriteByte(',')
		}
		buf.WriteByte('\n')
	}
	writeIndent(buf, indent)
	buf.WriteByte(']')
}

func writeIndent(buf *bytes.Buffer, indent int) {
	for i := 0; i < indent; i++ {
		buf.WriteString("  ")
	}
}

func marshalOrderedIndent(v any) []byte {
	var buf bytes.Buffer
	writeOrderedIndent(&buf, v, 0)
	return buf.Bytes()
}

