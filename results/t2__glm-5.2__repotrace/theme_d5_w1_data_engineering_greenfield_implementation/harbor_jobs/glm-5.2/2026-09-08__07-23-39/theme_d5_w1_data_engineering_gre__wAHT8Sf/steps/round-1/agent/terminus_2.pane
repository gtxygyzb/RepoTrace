   217			return cliConfig{}, fmt.Errorf("ingest --out-parquet-manifest parent directory does not exist")
   218		}
   219		if cfg.manifestSignature != "" && !parentDirExists(cfg.manifestSignature) {
   220			return cliConfig{}, fmt.Errorf("ingest --manifest-signature parent directory does not exist")
