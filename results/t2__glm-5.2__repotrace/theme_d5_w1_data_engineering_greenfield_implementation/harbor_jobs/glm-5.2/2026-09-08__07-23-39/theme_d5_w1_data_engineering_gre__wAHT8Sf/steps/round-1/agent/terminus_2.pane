    53	func main() {
    54		cfg, err := parseArgs(os.Args[1:])
    55		if err != nil {
    56			fmt.Fprintln(os.Stderr, err)
    57			os.Exit(2)
    58		}
    59		if err := run(cfg); err != nil {
    60			fmt.Fprintln(os.Stderr, err)
    61			os.Exit(1)
    62		}
    63	}
