 328 func getString(m map[string]json.RawMessage, keys ...string) (string, bool) {
 329   for _, k := range keys {
 330     s, ok, _ := getRawString(m, k)
 331     if ok {
 332       return s, true
 333     }
 334   }
 335   return "", false
