   228			}
   229			if cfg.auditLogRotateBytes < 4096 {
   230				return cliConfig{}, fmt.Errorf("ingest: --audit-log-rotate-bytes: must be a positive integer >= 4096")
   231			}
   232		}
   233		if cfg.summarySchemaDigest != "" && cfg.summarySchemaOut == "" {
   234			return cliConfig{}, fmt.Errorf("ingest: --summary-schema-digest requires --summary-schema-out")
   235		}
   236		if cfg.summarySchemaStrict && cfg.summarySchemaOut == "" {
   237			return cliConfig{}, fmt.Errorf("ingest: --summary-schema-strict requires --summary-schema-out")
   238		}
   239		if cfg.summarySchemaIndex != "" && (cfg.summarySchemaOut == "" || cfg.summarySchemaDigest == "") {
   240			return cliConfig{}, fmt.Errorf("ingest: --summary-schema-index requires --summary-schema-out and --summary-schema-digest")
