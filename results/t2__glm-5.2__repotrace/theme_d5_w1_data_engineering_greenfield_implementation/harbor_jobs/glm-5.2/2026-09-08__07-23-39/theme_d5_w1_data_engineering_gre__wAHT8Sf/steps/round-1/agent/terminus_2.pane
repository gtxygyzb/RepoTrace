   310	func newContext(raw rawEvent) *eventContext {
   311		ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}
   312		if raw.Obj != nil {
   313			ctx.ID = rawStringPtr(raw.Obj, "id")
   314			ctx.TS = rawStringPtr(raw.Obj, "ts")
   315			ctx.Type = rawStringPtr(raw.Obj, "type")
   316		}
   317		return ctx
   318	}
