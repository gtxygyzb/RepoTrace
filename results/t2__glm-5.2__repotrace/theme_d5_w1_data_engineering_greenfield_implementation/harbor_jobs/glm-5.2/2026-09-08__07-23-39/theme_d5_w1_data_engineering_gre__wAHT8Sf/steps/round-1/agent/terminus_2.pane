[?2004l   354	func buildManifest(cfg cliConfig, runIndex int, ratesDigest string, shards []inputShardInfo, shardAccepted map[string]int, bucketCounts map[string]int, hasMin bool, minTs time.Time, hasMax bool, maxTs time.Time) (manifestOutput, error) {
   355		sortedShards := append([]inputShardInfo(nil), shards...)
   356		sort.SliceStable(sortedShards, func(i, j int) bool {
   357			return sortedShards[i].Name < sortedShards[j].Name
   358		})
   359		manifestShards := make([]manifestShard, 0, len(sortedShards))
   360		for _, s := range sortedShards {
   361			manifestShards = append(manifestShards, manifestShard{
   362				Shard:          s.Name,
   363				SHA256:         s.SHA256,
   364				Bytes:          s.Bytes,
   365				EventsTotal:    s.EventsTotal,
   366				EventsAccepted: shardAccepted[s.Name],
   367			})
   368		}
   369		outputs := manifestOutputs{}
   370		summaryOut, err := manifestFileOutputFor(cfg.outputPath)
   371		if err != nil {
   372			return manifestOutput{}, err
   373		}
   374		rejectsOut, err := manifestFileOutputFor(cfg.rejectsPath)
   375		if err != nil {
   376			return manifestOutput{}, err
   377		}
   378		outputs.Summary = summaryOut
   379		outputs.Rejects = rejectsOut
   380		if cfg.stateOut != "" {
   381			stateOut, err := manifestFileOutputFor(cfg.stateOut)
   382			if err != nil {
   383				return manifestOutput{}, err
   384			}
   385			outputs.State = stateOut
   386		}
   387		if cfg.auditLog != "" {
   388			logOut, err := manifestFileOutputFor(cfg.auditLog)
   389			if err != nil {
   390				return manifestOutput{}, err
   391			}
   392			outputs.AuditLog = logOut
   393		}
   394		if cfg.auditLogDigest != "" {
   395			digestOut, err := manifestFileOutputFor(cfg.auditLogDigest)
   396			if err != nil {
   397				return manifestOutput{}, err
   398			}
   399			outputs.AuditDigest = digestOut
   400		}
   401		window := manifestWindow{
   402			EventsAcceptedTotal: bucketCounts["accepted"],
   403			EventsRejectedTotal: bucketCounts["duplicate"] + bucketCounts["invalid"] + bucketCounts["late"] + bucketCounts["unresolved_chargeback"],
   404			BucketCounts:        bucketCounts,
   405		}
   406		if hasMin {
   407			m := formatTS(minTs)
   408			window.MinTs = &m
   409		}
   410		if hasMax {
   411			m := formatTS(maxTs)
   412			window.MaxTs = &m
   413		}
   414		var ingestID *string
   415		if cfg.ingestIDSet {
   416			id := cfg.ingestID
   417			ingestID = &id
   418		}
   419		return manifestOutput{
   420			SchemaVersion: manifestSchemaVersion,
   421			IngestID:      ingestID,
   422			RunIndex:      runIndex,
   423			RatesDigest:   ratesDigest,
   424			InputShards:   manifestShards,
   425			Outputs:       outputs,
   426			Window:        window,
   427		}, nil
   428	}
   429	
   430	func bucketCode(bucket string) int {
   431		switch bucket {
   432		case "accepted":
   433			return 0
   434		case "duplicate":
   435			return 1
   436		case "invalid":
   437			return 2
   438		case "late":
   439			return 3
   440		case "unresolved_chargeback":
   441			return 4
   442		}
   443		return 2
   444	}
