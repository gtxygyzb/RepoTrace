   258	func readInputEvents(inputDir string) ([]rawEvent, []rawEvent, []inputShardInfo, error) {
   259		info, err := os.Stat(inputDir)
   260		if err != nil {
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '260,560p'
[?2004l   260		if err != nil {
   261			return nil, nil, nil, err
   262		}
   263		if !info.IsDir() {
   264			return nil, nil, nil, errors.New("input-dir is not a directory")
   265		}
   266		entries, err := os.ReadDir(inputDir)
   267		if err != nil {
   268			return nil, nil, nil, err
   269		}
   270		var files []string
   271		for _, e := range entries {
   272			if e.IsDir() || !e.Type().IsRegular() {
   273				continue
   274			}
   275			files = append(files, e.Name())
   276		}
   277		sort.Strings(files)
   278		var events []rawEvent
   279		var blanks []rawEvent
   280		var shards []inputShardInfo
   281		for _, name := range files {
   282			data, err := os.ReadFile(filepath.Join(inputDir, name))
   283			if err != nil {
   284				return nil, nil, nil, err
   285			}
   286			si := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}
   287			lineNo := 0
   288			for _, line := range bytes.Split(data, []byte{'\n'}) {
   289				lineNo++
   290				trimmed := bytes.TrimSpace(line)
   291				if len(trimmed) == 0 {
   292					blanks = append(blanks, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Blank: true})
   293					continue
   294				}
   295				si.EventsTotal++
   296				var obj map[string]json.RawMessage
   297				invalid := false
   298				if err := json.Unmarshal(trimmed, &obj); err != nil {
   299					invalid = true
   300				}
   301				events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})
   302			}
   303			shards = append(shards, si)
   304		}
   305		return events, blanks, shards, nil
   306	}
   307	
   308	func newContext(raw rawEvent) *eventContext {
   309		ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}
   310		if raw.Obj != nil {
   311			ctx.ID = rawStringPtr(raw.Obj, "id")
   312			ctx.TS = rawStringPtr(raw.Obj, "ts")
   313			ctx.Type = rawStringPtr(raw.Obj, "type")
   314		}
   315		return ctx
   316	}
   317	
   318	func parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {
   319		obj := ctx.Obj
   320		if obj == nil {
   321			return nil, "invalid_json"
   322		}
   323		raw, ok := obj["v"]
   324		if !ok {
   325			return nil, "schema_version"
   326		}
   327		var v int
   328		if err := json.Unmarshal(raw, &v); err != nil {
   329			return nil, "schema_version"
   330		}
   331		if v != 1 && v != 2 {
   332			return nil, "schema_version"
   333		}
   334		id, idOk, _ := getRawString(obj, "id")
   335		if !idOk || id == "" {
   336			return nil, "missing_id"
   337		}
   338		tsStr, tsOk, _ := getRawString(obj, "ts")
   339		if !tsOk {
   340			return nil, "missing_ts"
   341		}
   342		t, err := parseTime(tsStr)
   343		if err != nil {
   344			return nil, "bad_ts"
   345		}
   346		typeStr, typeOk, _ := getRawString(obj, "type")
   347		if !typeOk {
   348			return nil, "missing_type"
   349		}
   350		switch typeStr {
   351		case "purchase", "refund", "chargeback", "login", "signup":
   352		default:
   353			return nil, "bad_type"
   354		}
   355		user, userOk, _ := getRawString(obj, "user_id")
   356		if !userOk || user == "" {
   357			return nil, "missing_user"
   358		}
   359		ev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}
   360		switch typeStr {
   361		case "purchase", "refund":
   362			var amount float64
   363			if v == 1 {
   364				raw, present := obj["amount"]
   365				if !present {
   366					return nil, "missing_amount"
   367				}
   368				var f float64
   369				if err := json.Unmarshal(raw, &f); err != nil {
   370					return nil, "bad_amount"
   371				}
   372				if !isFinite(f) || f < 0 {
   373					return nil, "bad_amount"
   374				}
   375				amount = f
   376			} else {
   377				raw, present := obj["amount_cents"]
   378				if !present {
   379					return nil, "missing_amount"
   380				}
   381				n, err := getJSONInt(raw)
   382				if err != nil || n < 0 {
   383					return nil, "bad_amount"
   384				}
   385				amount = float64(n) / 100.0
   386			}
   387			cur, curOk, curPresent := getRawString(obj, "currency")
   388			if !curPresent {
   389				return nil, "missing_currency"
   390			}
   391			if !curOk || cur == "" {
   392				return nil, "bad_currency"
   393			}
   394			rate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)
   395			switch status {
   396			case "fx_unknown_currency":
   397				return nil, "fx_unknown_currency"
   398			case "missing_rate":
   399				return nil, "fx_no_rate_for_date"
   400			case "bad_rate":
   401				if ratesStrict {
   402					return nil, "fx_bad_rate"
   403				}
   404				return nil, "fx_no_rate_for_date"
   405			}
   406			usd := amount * rate
   407			if typeStr == "refund" {
   408				usd = -usd
   409			}
   410			ev.Amount = amount
   411			ev.Currency = cur
   412			ev.FXFallbackDays = fallbackDays
   413			ev.USD = roundMoney(usd)
   414		case "chargeback":
   415			ref, refOk, refPresent := getRawString(obj, "ref_id")
   416			if !refPresent || !refOk || ref == "" {
   417				return nil, "missing_ref_id"
   418			}
   419			ev.RefID = ref
   420			ev.USD = 0
   421		case "login", "signup":
   422			ev.USD = 0
   423		}
   424		return ev, ""
   425	}
   426	
   427	type stateFileIn struct {
   428		Version          int                   `json:"version"`
   429		Watermark        stateWatermarkOut     `json:"watermark"`
   430		SeenIDs          []string              `json:"seen_ids"`
   431		PendingPurchases []statePendingOut     `json:"pending_purchases"`
   432		OpenSessions     []stateOpenSessionOut `json:"open_sessions"`
   433		RunIndex         int                   `json:"run_index"`
   434	}
   435	
   436	func loadState(path string, stateStrict bool) (*loadedState, error) {
   437		data, err := os.ReadFile(path)
   438		if err != nil {
   439			return nil, err
   440		}
   441		var sin stateFileIn
   442		if err := json.Unmarshal(data, &sin); err != nil {
   443			return nil, err
   444		}
   445		st := &loadedState{
   446			version:      sin.Version,
   447			seenIds:      map[string]bool{},
   448			runIndex:     sin.RunIndex,
   449			openSessions: map[string]carriedSession{},
   450		}
   451		if sin.Watermark.MaxTS != nil {
   452			t, err := parseTime(*sin.Watermark.MaxTS)
   453			if err != nil {
   454				return nil, fmt.Errorf("bad state watermark: %w", err)
   455			}
   456			st.hasMax = true
   457			st.maxTs = t
   458		}
   459		for _, id := range sin.SeenIDs {
   460			st.seenIds[id] = true
   461		}
   462		for _, p := range sin.PendingPurchases {
   463			t, err := parseTime(p.TS)
   464			if err != nil {
   465				return nil, fmt.Errorf("bad pending purchase ts: %w", err)
   466			}
   467			if stateStrict && !p.firstSeenEpochSet {
   468				return nil, fmt.Errorf("ingest: --state-strict: state pending entry missing first_seen_epoch")
   469			}
   470			st.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, firstSeenEpoch: int(epochSeconds(t)), user: p.User, usd: float64(p.USD), originRun: p.OriginRun})
   471		}
   472		for _, s := range sin.OpenSessions {
   473			last, err := parseTime(s.LastTS)
   474			if err != nil {
   475				return nil, fmt.Errorf("bad open session last_ts: %w", err)
   476			}
   477			start, err := parseTime(s.StartTS)
   478			if err != nil {
   479				return nil, fmt.Errorf("bad open session start_ts: %w", err)
   480			}
   481			st.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}
   482		}
   483		st.carryInPending = len(st.pending)
   484		st.carryInOpenSessions = len(st.openSessions)
   485		return st, nil
   486	}
   487	
   488	func buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {
   489		out := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}
   490		if hasCurrentMax {
   491			s := formatTS(currentMax)
   492			out.Watermark.MaxTS = &s
   493		} else if st != nil && st.hasMax {
   494			s := formatTS(st.maxTs)
   495			out.Watermark.MaxTS = &s
   496		}
   497		b, _ := json.MarshalIndent(out, "", "  ")
   498		b = append(b, '\n')
   499		return b
   500	}
   501	
   502	func statePendingOutList(pending []pendingEntry) []statePendingOut {
   503		out := make([]statePendingOut, 0, len(pending))
   504		for _, p := range pending {
   505			out = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), FirstSeenEpoch: p.firstSeenEpoch, User: p.user, USD: Money(p.usd), OriginRun: p.originRun})
   506		}
   507		return out
   508	}
   509	
   510	func stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {
   511		out := make([]stateOpenSessionOut, 0, len(sessions))
   512		for _, s := range sessions {
   513			out = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})
   514		}
   515		return out
   516	}
   517	
   518	func sortedSeenIDs(seen map[string]bool) []string {
   519		ids := make([]string, 0, len(seen))
   520		for id := range seen {
   521			ids = append(ids, id)
   522		}
   523		sort.Strings(ids)
   524		return ids
   525	}
   526	
   527	func stateFirstSeenEpochPresent(p statePendingOut) bool {
   528		return p.firstSeenEpochSet
   529	}
   530	
   531	func sortedPending(pending []pendingEntry) []pendingEntry {
   532		out := append([]pendingEntry(nil), pending...)
   533		sort.SliceStable(out, func(i, j int) bool {
   534			if out[i].ts.Equal(out[j].ts) {
   535				return out[i].id < out[j].id
   536			}
   537			return out[i].ts.Before(out[j].ts)
   538		})
   539		return out
   540	}
   541	
   542	func sortedOpenSessions(m map[string]carriedSession) []carriedSession {
   543		out := make([]carriedSession, 0, len(m))
   544		for _, s := range m {
   545			out = append(out, s)
   546		}
   547		sort.SliceStable(out, func(i, j int) bool {
   548			if out[i].lastTs.Equal(out[j].lastTs) {
   549				return out[i].user < out[j].user
   550			}
   551			return out[i].lastTs.Before(out[j].lastTs)
   552		})
   553		return out
   554	}
   555	
   556	func sortedCarriedSessions(m map[string]carriedSession) []carriedSession {
   557		return sortedOpenSessions(m)
   558	}
