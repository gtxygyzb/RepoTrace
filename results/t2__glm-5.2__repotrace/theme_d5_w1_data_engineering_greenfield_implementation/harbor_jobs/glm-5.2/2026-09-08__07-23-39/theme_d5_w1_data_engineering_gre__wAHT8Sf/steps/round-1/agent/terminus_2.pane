   557	
   558	func writeAuditLog(path string, entries []auditLogEntry, rotateBytes int) []string {
   559		var segments []string
   560		if rotateBytes <= 0 {
   561			var buf bytes.Buffer
   562			for _, e := range entries {
   563				b, err := json.Marshal(e)
   564				if err != nil {
   565					panic(err)
   566				}
   567				buf.Write(b)
   568				buf.WriteByte('\n')
   569			}
   570			if err := atomicWriteFile(path, buf.Bytes()); err != nil {
   571				panic(err)
   572			}
   573			return []string{path}
   574		}
   575	
   576		current := path
   577		var buf bytes.Buffer
   578		flush := func() {
   579			if err := atomicWriteFile(current, buf.Bytes()); err != nil {
   580				panic(err)
   581			}
   582			segments = append(segments, current)
   583			buf.Reset()
   584		}
   585		for _, e := range entries {
   586			b, err := json.Marshal(e)
   587			if err != nil {
   588				panic(err)
   589			}
   590			rec := append(b, '\n')
   591			if buf.Len() > 0 && buf.Len()+len(rec) > rotateBytes {
   592				flush()
   593				current = fmt.Sprintf("%s.%d", path, len(segments))
   594			}
   595			buf.Write(rec)
   596		}
   597		if buf.Len() > 0 || len(segments) == 0 {
   598			flush()
   599		}
   600		return segments
   601	}
   602	
   603	func computeLateCutoffStats(entries []auditLogEntry) lateCutoffStats {
   604		stats := lateCutoffStats{}
   605		for _, e := range entries {
   606			if e.Bucket == "late" && e.Cutoff != nil {
   607				if stats.Count == 0 {
   608					stats.MinCutoffEpoch = e.Cutoff.EpochSeconds
   609					stats.MaxCutoffEpoch = e.Cutoff.EpochSeconds
   610				} else {
   611					if e.Cutoff.EpochSeconds < stats.MinCutoffEpoch {
   612						stats.MinCutoffEpoch = e.Cutoff.EpochSeconds
   613					}
   614					if e.Cutoff.EpochSeconds > stats.MaxCutoffEpoch {
   615						stats.MaxCutoffEpoch = e.Cutoff.EpochSeconds
   616					}
   617				}
   618				stats.Count++
   619			}
   620		}
