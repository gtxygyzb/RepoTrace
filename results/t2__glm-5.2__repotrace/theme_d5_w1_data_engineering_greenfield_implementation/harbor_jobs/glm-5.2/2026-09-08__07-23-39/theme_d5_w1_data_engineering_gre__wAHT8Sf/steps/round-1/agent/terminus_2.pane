   277		if err != nil {
   278			return err
   279		}
   280		seen := map[string]bool{}
   281		if st != nil {
   282			for k, v := range st.seenIds {
   283				seen[k] = v
   284			}
   285		}
   286		var pending []pendingEntry
   287		openSessions := map[string]carriedSession{}
   288		if st != nil {
   289			pending = append([]pendingEntry(nil), st.pending...)
   290			for k, v := range st.openSessions {
   291				openSessions[k] = v
   292			}
   293		}
   294		bucketCounts := map[string]int{"accepted": 0, "duplicate": 0, "invalid": 0, "late": 0, "unresolved_chargeback": 0}
   295		invalidReasons := map[string]int{}
   296		duplicateReasons := map[string]int{"same_run": 0, "cross_run": 0}
   297		fxFallbackStats := map[string]int{"0": 0}
   298		shardAccepted := map[string]int{}
   299		var minTs, maxTs time.Time
   300		hasMin, hasMax := false, false
   301		var watermark time.Time
   302		hasWatermark := false
