    58	func writeRunProvenanceSidecars(cfg cliConfig, shards []inputShardInfo) error {
    59		if cfg.runProvenance == "" {
    60			return nil
    61		}
    62		provenance := buildRunProvenance(cfg, shards)
    63		data := marshalOrderedIndent(provenance)
    64		data = append(data, '\n')
    65		if err := atomicWriteFile(cfg.runProvenance, data); err != nil {
    66			return err
    67		}
    68		if cfg.runProvenanceDigest != "" {
    69			h, b, err := fileDigest(cfg.runProvenance)
    70			if err != nil {
    71				return err
    72			}
    73			digest := []orderedJSON{
    74				{key: "schema_version", value: runProvenanceDigestSchemaVersion},
    75				{key: "provenance_path", value: filepath.Base(cfg.runProvenance)},
    76				{key: "provenance_sha256", value: h},
    77				{key: "provenance_bytes", value: b},
    78				{key: "tool_version", value: toolVersion},
    79			}
    80			digestData := marshalOrderedIndent(digest)
    81			digestData = append(digestData, '\n')
    82			if err := atomicWriteFile(cfg.runProvenanceDigest, digestData); err != nil {
    83				return err
    84			}
    85		}
    86		return nil
    87	}
