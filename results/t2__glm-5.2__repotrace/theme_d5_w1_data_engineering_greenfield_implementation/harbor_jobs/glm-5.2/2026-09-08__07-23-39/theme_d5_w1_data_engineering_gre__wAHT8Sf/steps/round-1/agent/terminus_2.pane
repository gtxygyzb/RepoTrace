   491	func run(cfg cliConfig) error {
   492		ratesData, err := os.ReadFile(cfg.ratesPath)
   493		if err != nil {
   494			return fmt.Errorf("ingest: rates: %w", err)
   495		}
   496		ratesDigest := sha256Hex(ratesData)
   497		rt, err := loadRates(cfg.ratesPath)
   498		if err != nil {
   499			return err
   500		}
   501		var st *loadedState
   502		runIndex := 1
   503		if cfg.stateIn != "" {
   504			st, err = loadState(cfg.stateIn, cfg.stateStrict)
   505			if err != nil && !os.IsNotExist(err) {
   506				return err
   507			}
   508			if st != nil {
   509				runIndex = st.runIndex + 1
   510			}
   511		}
   512		events, blanks, shards, err := readInputEvents(cfg.inputDir)
   513		if err != nil {
   514			return err
   515		}
   516		seen := map[string]bool{}
   517		if st != nil {
   518			for k, v := range st.seenIds {
   519				seen[k] = v
   520			}
   521		}
   522		var pending []pendingEntry
   523		openSessions := map[string]carriedSession{}
   524		if st != nil {
   525			pending = append([]pendingEntry(nil), st.pending...)
   526			for k, v := range st.openSessions {
   527				openSessions[k] = v
   528			}
   529		}
   530		bucketCounts := map[string]int{"accepted": 0, "duplicate": 0, "invalid": 0, "late": 0, "unresolved_chargeback": 0}
   531		invalidReasons := map[string]int{}
   532		duplicateReasons := map[string]int{"same_run": 0, "cross_run": 0}
   533		fxFallbackStats := map[string]int{"0": 0}
   534		shardAccepted := map[string]int{}
   535		var minTs, maxTs time.Time
   536		hasMin, hasMax := false, false
   537		var watermark time.Time
   538		hasWatermark := false
   539		if st != nil {
   540			watermark = st.maxTs
