   467			if err != nil {
   468				return nil, fmt.Errorf("bad open session start_ts: %w", err)
   469			}
   470			st.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}
