   477	func buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {
   478		out := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}
   479		if hasCurrentMax {
   480			s := formatTS(currentMax)
   481			out.Watermark.MaxTS = &s
   482		} else if st != nil && st.hasMax {
   483			s := formatTS(st.maxTs)
   484			out.Watermark.MaxTS = &s
   485		}
   486		b, _ := json.MarshalIndent(out, "", "  ")
   487		b = append(b, '\n')
   488		return b
   489	}
   490	
   491	func statePendingOutList(pending []pendingEntry) []statePendingOut {
   492		out := make([]statePendingOut, 0, len(pending))
   493		for _, p := range pending {
   494			out = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), User: p.user, USD: Money(p.usd), OriginRun: p.originRun})
   495		}
   496		return out
   497	}
   498	
   499	func stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {
   500		out := make([]stateOpenSessionOut, 0, len(sessions))
   501		for _, s := range sessions {
   502			out = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})
   503		}
   504		return out
   505	}
   506	
   507	func sortedSeenIDs(seen map[string]bool) []string {
   508		ids := make([]string, 0, len(seen))
   509		for id := range seen {
   510			ids = append(ids, id)
   511		}
   512		sort.Strings(ids)
   513		return ids
   514	}
   515	
   516	func sortedPending(pending []pendingEntry) []pendingEntry {
   517		out := append([]pendingEntry(nil), pending...)
   518		sort.SliceStable(out, func(i, j int) bool {
   519			if out[i].ts.Equal(out[j].ts) {
   520				return out[i].id < out[j].id
   521			}
   522			return out[i].ts.Before(out[j].ts)
   523		})
   524		return out
   525	}
   526	
   527	func sortedOpenSessions(m map[string]carriedSession) []carriedSession {
   528		out := make([]carriedSession, 0, len(m))
   529		for _, s := range m {
   530			out = append(out, s)
   531		}
   532		sort.SliceStable(out, func(i, j int) bool {
   533			if out[i].lastTs.Equal(out[j].lastTs) {
   534				return out[i].user < out[j].user
   535			}
   536			return out[i].lastTs.Before(out[j].lastTs)
   537		})
   538		return out
   539	}
   540	
   541	func sortedCarriedSessions(m map[string]carriedSession) []carriedSession {
   542		return sortedOpenSessions(m)
   543	}
