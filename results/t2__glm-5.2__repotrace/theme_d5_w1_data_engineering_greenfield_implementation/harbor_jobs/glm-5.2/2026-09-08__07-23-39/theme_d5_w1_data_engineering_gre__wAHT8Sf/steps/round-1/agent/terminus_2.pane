    53	func parseTime(s string) (time.Time, error) {
    54		s = strings.TrimSpace(s)
    55		if strings.HasSuffix(s, "Z") {
    56			if t, err := time.Parse("2006-01-02T15:04:05Z", s); err == nil {
    57				return t.UTC(), nil
    58			}
    59			if t, err := time.Parse("2006-01-02T15:04:05.000000000Z", s); err == nil {
    60				return t.UTC(), nil
    61			}
    62		}
    63		if t, err := time.Parse(time.RFC3339Nano, s); err == nil {
    64			return t.UTC(), nil
    65		}
    66		if t, err := time.Parse(time.RFC3339, s); err == nil {
    67			return t.UTC(), nil
    68		}
    69		return time.Time{}, fmt.Errorf("bad timestamp: %s", s)
    70	}
    71	
    72	func formatTS(t time.Time) string {
    73		return t.UTC().Format("2006-01-02T15:04:05Z")
    74	}
    75	
    76	func dateKey(t time.Time) string {
    77		return t.UTC().Format("2006-01-02")
    78	}
    79	
    80	func roundMoney(v float64) float64 {
    81		cents := int64(math.Floor(math.Abs(v)*100.0 + 0.5))
    82		if v < 0 && cents != 0 {
    83			return -float64(cents) / 100.0
    84		}
    85		return float64(cents) / 100.0
    86	}
    87	
    88	func isFinite(f float64) bool {
    89		return !math.IsNaN(f) && !math.IsInf(f, 0)
    90	}
    91	
    92	func isDate(s string) bool {
    93		if _, err := time.Parse("2006-01-02", s); err != nil {
    94			return false
    95		}
    96		return true
    97	}
    98	
    99	func sha256Hex(data []byte) string {
   100		sum := sha256.Sum256(data)
   101		return hex.EncodeToString(sum[:])
   102	}
   103	
   104	func sha256Short(h string) string {
   105		if len(h) < 12 {
   106			return h
   107		}
   108		return h[:12]
   109	}
   110	
   111	func fileDigest(path string) (string, int64, error) {
   112		data, err := os.ReadFile(path)
   113		if err != nil {
   114			return "", 0, err
   115		}
   116		return sha256Hex(data), int64(len(data)), nil
   117	}
   118	
   119	func atomicWriteFile(path string, data []byte) error {
   120		tmp := path + ".tmp"
   121		if err := os.WriteFile(tmp, data, 0644); err != nil {
   122			return err
   123		}
   124		if err := os.Rename(tmp, path); err != nil {
   125			_ = os.Remove(tmp)
   126			return err
   127		}
   128		return nil
   129	}
   130	
   131	func parentDirExists(path string) bool {
   132		dir := filepath.Dir(path)
   133		if dir == "." || dir == "" {
   134			return true
   135		}
   136		info, err := os.Stat(dir)
   137		if err != nil {
   138			return false
   139		}
   140		return info.IsDir()
   141	}
   142	
   143	func manifestFileOutputFor(path string) (*manifestFileOutput, error) {
   144		h, b, err := fileDigest(path)
   145		if err != nil {
   146			return nil, err
   147		}
   148		return &manifestFileOutput{
   149			Path:        filepath.Base(path),
   150			SHA256:      h,
   151			SHA256Short: sha256Short(h),
   152			Bytes:       b,
   153		}, nil
   154	}
