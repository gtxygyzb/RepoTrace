   178					}
   179					dist := absInt64(dayTime.Unix() - eventDay.Unix())
   180					if dist > int64(maxStaleness) {
   181						continue
   182					}
   183					if bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {
   184						bestDist = dist
   185						bestDate = d
   186					}
   187				}
   188				if bestDate != "" {
   189					r := rt.days[bestDate][currency]
   190					if isUsableRate(r) {
   191						return r, calendarDayDiff(bestDate, date), ""
   192					}
   193					return 0, 0, "bad_rate"
   194				}
   195			}
   196		}
   197		return 0, 0, "missing_rate"
   198	}
