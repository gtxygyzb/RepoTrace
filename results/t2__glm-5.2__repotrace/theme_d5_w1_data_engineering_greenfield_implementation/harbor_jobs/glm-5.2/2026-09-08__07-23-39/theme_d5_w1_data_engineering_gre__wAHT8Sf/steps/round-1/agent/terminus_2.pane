   105	func isStrictDate(s string) bool {
   106		if len(s) != 10 {
   107			return false
   108		}
   109		for i, c := range s {
   110			if i == 4 || i == 7 {
   111				if c != '-' {
   112					return false
   113				}
   114				continue
   115			}
   116			if c < '0' || c > '9' {
   117				return false
   118			}
   119		}
   120		return true
   121	}
   122	
   123	func dayEpoch(date string) time.Time {
   124		t, err := time.Parse("2006-01-02", date)
   125		if err != nil {
   126			return time.Time{}
   127		}
   128		return t.UTC()
   129	}
   130	
   131	func calendarDayDiff(rateDate, eventDate string) int {
   132		r := dayEpoch(rateDate)
   133		e := dayEpoch(eventDate)
   134		if r.IsZero() || e.IsZero() {
   135			return 0
   136		}
   137		return int(r.Sub(e) / (24 * time.Hour))
   138	}
