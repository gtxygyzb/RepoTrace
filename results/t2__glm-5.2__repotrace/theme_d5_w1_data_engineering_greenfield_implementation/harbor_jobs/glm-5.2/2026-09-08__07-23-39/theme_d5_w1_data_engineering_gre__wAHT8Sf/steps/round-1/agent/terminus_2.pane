   477	func buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {
   478		out := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}
   479		if hasCurrentMax {
   480			s := formatTS(currentMax)
   481			out.Watermark.MaxTS = &s
   482		} else if st != nil && st.hasMax {
   483			s := formatTS(st.maxTs)
   484			out.Watermark.MaxTS = &s
   485		}
   486		b, _ := json.MarshalIndent(out, "", "  ")
   487		b = append(b, '\n')
   488		return b
   489	}
