   183	type summaryField struct {
   184		key   string
   185		value any
   186	}
   187	
   188	func parseSummaryFields(data []byte) ([]summaryField, error) {
   189		dec := json.NewDecoder(bytes.NewReader(data))
   190		dec.UseNumber()
   191		tok, err := dec.Token()
   192		if err != nil {
   193			return nil, err
   194		}
   195		delim, ok := tok.(json.Delim)
   196		if !ok || delim != '{' {
   197			return nil, fmt.Errorf("summary output is not a JSON object")
   198		}
   199		var fields []summaryField
   200		for dec.More() {
   201			keyTok, err := dec.Token()
   202			if err != nil {
   203				return nil, err
   204			}
   205			key, ok := keyTok.(string)
   206			if !ok {
   207				return nil, fmt.Errorf("summary object key is not a string")
   208			}
   209			var val any
   210			if err := dec.Decode(&val); err != nil {
   211				return nil, err
   212			}
   213			fields = append(fields, summaryField{key: key, value: val})
   214		}
   215		if _, err := dec.Token(); err != nil {
   216			return nil, err
   217		}
   218		return fields, nil
   219	}
   220	
   221	func classify(v any) string {
   222		switch val := v.(type) {
   223		case nil:
   224			return "null"
   225		case bool:
   226			return "boolean"
   227		case string:
   228			return "string"
   229		case json.Number:
   230			s := val.String()
   231			if !strings.ContainsAny(s, ".eE") {
   232				return "integer"
   233			}
   234			return "number"
   235		case float64:
   236			if val == float64(int64(val)) {
   237				return "integer"
   238			}
   239			return "number"
   240		case []any:
   241			return "array"
   242		case map[string]any:
   243			return "object"
   244		default:
   245			return "unknown"
   246		}
   247	}
   248	
   249	func descriptorFor(v any, depth int, strict bool) []orderedJSON {
   250		t := classify(v)
   251		entries := []orderedJSON{{key: "type", value: t}}
   252		switch t {
   253		case "array":
   254			arr := v.([]any)
   255			var elementType any
   256			if len(arr) == 0 {
   257				if strict {
   258					elementType = []orderedJSON{{key: "type", value: "unknown"}}
   259				} else {
   260					elementType = nil
   261				}
   262			} else {
   263				elementType = classify(arr[0])
   264			}
   265			entries = append(entries, orderedJSON{key: "element_type", value: elementType})
   266			entries = append(entries, orderedJSON{key: "constraints", value: arrayConstraints(arr, depth, strict)})
   267		case "object":
   268			obj := v.(map[string]any)
   269			entries = append(entries, orderedJSON{key: "fields", value: schemaSortedKeys(obj)})
   270			entries = append(entries, orderedJSON{key: "constraints", value: objectConstraints(obj, depth, strict)})
   271		default:
   272			entries = append(entries, orderedJSON{key: "constraints", value: scalarConstraints(v, t, depth, strict)})
   273		}
   274		return entries
   275	}
   276	
   277	func schemaSortedKeys(obj map[string]any) []any {
   278		keys := make([]string, 0, len(obj))
   279		for k := range obj {
   280			keys = append(keys, k)
   281		}
   282		sort.Strings(keys)
   283		arr := make([]any, len(keys))
   284		for i, k := range keys {
   285			arr[i] = k
   286		}
   287		return arr
   288	}
   289	
   290	func scalarConstraints(v any, t string, depth int, strict bool) []orderedJSON {
   291		var entries []orderedJSON
   292		switch t {
   293		case "integer":
   294			if isNonNegativeInteger(v) {
   295				entries = append(entries, orderedJSON{key: "non_negative", value: true})
   296			}
   297			if strict && depth == 0 && isZeroInteger(v) {
   298				entries = append(entries, orderedJSON{key: "zero_observed", value: true})
   299			}
   300		case "string":
   301			if isRFC3339UTCZ(v.(string)) {
   302				entries = append(entries, orderedJSON{key: "format", value: "rfc3339-utc-z"})
   303			}
   304		}
   305		return entries
   306	}
   307	
   308	func arrayConstraints(arr []any, depth int, strict bool) []orderedJSON {
   309		var entries []orderedJSON
   310		if len(arr) > 0 && classify(arr[0]) == "object" {
   311			if depth < 2 {
   312				entries = append(entries, orderedJSON{key: "element_subfields", value: elementSubfields(arr[0].(map[string]any), depth+1, strict)})
   313			}
   314		}
   315		homogeneous := true
   316		if len(arr) == 0 {
   317			homogeneous = !strict
   318		} else {
   319			first := classify(arr[0])
   320			for _, e := range arr[1:] {
   321				if classify(e) != first {
   322					homogeneous = false
   323					break
   324				}
   325			}
   326		}
   327		entries = append(entries, orderedJSON{key: "homogeneous", value: homogeneous})
   328		entries = append(entries, orderedJSON{key: "length", value: len(arr)})
   329		return entries
   330	}
   331	
   332	func objectConstraints(obj map[string]any, depth int, strict bool) []orderedJSON {
   333		entries := []orderedJSON{{key: "field_count", value: len(obj)}}
   334		if len(obj) > 0 && depth < 1 {
   335			entries = append(entries, orderedJSON{key: "subfields", value: subfields(obj, depth+1, strict)})
   336		}
   337		return entries
   338	}
   339	
   340	func subfields(obj map[string]any, depth int, strict bool) []orderedJSON {
   341		keys := make([]string, 0, len(obj))
   342		for k := range obj {
   343			keys = append(keys, k)
   344		}
   345		sort.Strings(keys)
   346		entries := make([]orderedJSON, 0, len(keys))
   347		for _, k := range keys {
   348			entries = append(entries, orderedJSON{key: k, value: descriptorFor(obj[k], depth, strict)})
   349		}
   350		return entries
   351	}
   352	
   353	func elementSubfields(obj map[string]any, depth int, strict bool) []orderedJSON {
   354		return subfields(obj, depth, strict)
   355	}
   356	
   357	func isNonNegativeInteger(v any) bool {
   358		switch val := v.(type) {
   359		case json.Number:
   360			s := val.String()
   361			if strings.ContainsAny(s, ".eE") {
   362				return false
   363			}
   364			n, err := val.Int64()
   365			if err != nil {
   366				return false
   367			}
   368			return n >= 0
   369		case float64:
   370			if val != float64(int64(val)) {
   371				return false
   372			}
   373			return val >= 0
   374		}
   375		return false
   376	}
   377	
   378	func isZeroInteger(v any) bool {
   379		switch val := v.(type) {
   380		case json.Number:
   381			s := val.String()
   382			if strings.ContainsAny(s, ".eE") {
   383				return false
   384			}
   385			n, err := val.Int64()
   386			if err != nil {
   387				return false
   388			}
   389			return n == 0
   390		case float64:
   391			if val != float64(int64(val)) {
   392				return false
   393			}
   394			return val == 0
   395		}
   396		return false
   397	}
   398	
   399	func isRFC3339UTCZ(s string) bool {
   400		return rfc3339UTCZRE.MatchString(s)
   401	}
   402	
   403	func buildSchemaSidecar(summaryData []byte, cfg cliConfig, runIndex int) ([]byte, error) {
   404		fields, err := parseSummaryFields(summaryData)
   405		if err != nil {
   406			return nil, err
   407		}
   408		summarySchema := make([]orderedJSON, 0, len(fields))
   409		var arrayFields, objectFields, scalarFields int
   410		for _, f := range fields {
   411			t := classify(f.value)
   412			switch t {
   413			case "array":
   414				arrayFields++
   415			case "object":
   416				objectFields++
   417			default:
   418				scalarFields++
   419			}
   420			summarySchema = append(summarySchema, orderedJSON{key: f.key, value: descriptorFor(f.value, 0, cfg.summarySchemaStrict)})
   421		}
   422		var ingestID any
   423		if cfg.ingestIDSet {
   424			ingestID = cfg.ingestID
   425		} else {
   426			ingestID = nil
   427		}
   428		top := []orderedJSON{
   429			{key: "schema_version", value: summarySchemaVersion},
   430			{key: "summary_schema", value: summarySchema},
   431			{key: "ingest_id", value: ingestID},
   432			{key: "run_index", value: runIndex},
   433			{key: "field_summary", value: []orderedJSON{
   434				{key: "array_fields", value: arrayFields},
   435				{key: "object_fields", value: objectFields},
   436				{key: "scalar_fields", value: scalarFields},
   437			}},
   438			{key: "strict_mode", value: cfg.summarySchemaStrict},
   439		}
   440		if cfg.rejectsFormat == "tagged" || cfg.rejectsFormat == "tagged-sorted" {
   441			top = append(top, orderedJSON{key: "rejects_format", value: cfg.rejectsFormat})
   442		}
   443		data := marshalOrderedIndent(top)
   444		data = append(data, '\n')
   445		return data, nil
   446	}
   447	
   448	func writeSummarySchemaSidecars(cfg cliConfig, summaryData []byte, runIndex int) error {
   449		if cfg.summarySchemaOut == "" {
   450			return nil
   451		}
   452		schemaData, err := buildSchemaSidecar(summaryData, cfg, runIndex)
   453		if err != nil {
   454			return err
   455		}
   456		if err := atomicWriteFile(cfg.summarySchemaOut, schemaData); err != nil {
   457			return err
   458		}
   459		if cfg.summarySchemaDigest != "" {
   460			hash, n, err := fileDigest(cfg.summarySchemaOut)
   461			if err != nil {
   462				return err
   463			}
   464			digest := []orderedJSON{
   465				{key: "schema_path", value: filepath.Base(cfg.summarySchemaOut)},
   466				{key: "schema_sha256", value: hash},
   467				{key: "schema_bytes", value: n},
   468				{key: "field_count", value: 7},
   469				{key: "tool_version", value: toolVersion},
   470			}
   471			data := marshalOrderedIndent(digest)
   472			data = append(data, '\n')
   473			if err := atomicWriteFile(cfg.summarySchemaDigest, data); err != nil {
   474				return err
   475			}
   476			if cfg.summarySchemaIndex != "" {
   477				index, err := buildIndexSidecar(cfg, summaryData)
   478				if err != nil {
   479					return err
   480				}
   481				if err := atomicWriteFile(cfg.summarySchemaIndex, index); err != nil {
   482					return err
   483				}
   484			}
   485		}
   486		return nil
   487	}
   488	
   489	func buildIndexSidecar(cfg cliConfig, summaryData []byte) ([]byte, error) {
   490		fields, err := parseSummaryFields(summaryData)
   491		if err != nil {
   492			return nil, err
   493		}
   494		entries := make([]any, 0)
   495		for _, f := range fields {
   496			entries = append(entries, []orderedJSON{
   497				{key: "name", value: f.key},
   498				{key: "type", value: classify(f.value)},
   499				{key: "path", value: "$." + f.key},
   500			})
   501			if classify(f.value) == "array" {
   502				arr := f.value.([]any)
   503				if len(arr) > 0 && classify(arr[0]) == "object" {
   504					obj := arr[0].(map[string]any)
   505					keys := make([]string, 0, len(obj))
   506					for k := range obj {
   507						keys = append(keys, k)
   508					}
   509					sort.Strings(keys)
   510					for _, k := range keys {
   511						entries = append(entries, []orderedJSON{
   512							{key: "name", value: k},
   513							{key: "type", value: classify(obj[k])},
   514							{key: "path", value: fmt.Sprintf("$.%s[*].%s", f.key, k)},
   515						})
   516					}
   517				}
   518			}
   519		}
   520		top := []orderedJSON{
   521			{key: "entries", value: entries},
   522			{key: "entry_count", value: len(entries)},
   523			{key: "generated_from", value: filepath.Base(cfg.summarySchemaOut)},
   524			{key: "tool_version", value: toolVersion},
   525		}
   526		data := marshalOrderedIndent(top)
   527		data = append(data, '\n')
   528		return data, nil
   529	}
