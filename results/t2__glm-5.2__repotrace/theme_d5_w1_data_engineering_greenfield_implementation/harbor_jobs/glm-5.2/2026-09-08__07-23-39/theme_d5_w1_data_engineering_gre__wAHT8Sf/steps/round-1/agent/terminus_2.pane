   434	func newRateTable() *RateTable {
   435	  return &RateTable{byDate: map[string]map[string]float64{}, global: map[string]float64{"USD": 1.0}}
   436	}
   437	
   438	func (rt *RateTable) rate(date, currency string) (float64, bool) {
   439	  if currency == "USD" {
   440	    return 1.0, true
   441	  }
   442	  if m, ok := rt.byDate[date]; ok {
   443	    if r, ok := m[currency]; ok && r > 0 {
   444	      return r, true
   445	    }
   446	  }
   447	  if r, ok := rt.global[currency]; ok && r > 0 {
   448	    return r, true
   449	  }
   450	  return 0, false
   451	}
   452	
   453	func parseRateRaw(raw json.RawMessage) (float64, error) {
   454	  var f float64
   455	  if err := json.Unmarshal(raw, &f); err == nil {
   456	    if !isFinite(f) {
   457	      return 0, errors.New("bad rate")
   458	    }
   459	    return f, nil
   460	  }
   461	  var s string
   462	  if err := json.Unmarshal(raw, &s); err == nil {
   463	    return strconv.ParseFloat(s, 64)
   464	  }
   465	  return 0, errors.New("bad rate")
   466	}
   467	
   468	func loadRateMap(rt *RateTable, raw json.RawMessage, global bool) error {
   469	  var m map[string]json.RawMessage
   470	  if err := json.Unmarshal(raw, &m); err != nil {
   471	    return err
   472	  }
   473	  for currency, raw2 := range m {
   474	    if currency == "USD" {
   475	      continue
   476	    }
   477	    r, err := parseRateRaw(raw2)
   478	    if err != nil {
   479	      return err
   480	    }
   481	    if global {
   482	      rt.global[currency] = r
   483	    } else {
   484	      if rt.byDate["global"] == nil {
   485	        rt.byDate["global"] = map[string]float64{}
   486	      }
   487	      rt.byDate["global"][currency] = r
   488	    }
   489	  }
   490	  return nil
   491	}
   492	
   493	func loadRates(path string) (*RateTable, error) {
   494	  data, err := os.ReadFile(path)
