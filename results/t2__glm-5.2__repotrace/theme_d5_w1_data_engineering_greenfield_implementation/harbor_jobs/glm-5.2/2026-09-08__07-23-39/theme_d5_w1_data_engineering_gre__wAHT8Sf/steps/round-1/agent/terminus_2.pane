   258	func readInputEvents(inputDir string) ([]rawEvent, []inputShardInfo, error) {
   259		info, err := os.Stat(inputDir)
   260		if err != nil {
[?2004hroot@n30009:/app# nl -ba main.go | sed -n '261,560p'
[?2004l   261			return nil, nil, err
   262		}
   263		if !info.IsDir() {
   264			return nil, nil, errors.New("input-dir is not a directory")
   265		}
   266		entries, err := os.ReadDir(inputDir)
   267		if err != nil {
   268			return nil, nil, err
   269		}
   270		var files []string
   271		for _, e := range entries {
   272			if e.IsDir() || !e.Type().IsRegular() {
   273				continue
   274			}
   275			files = append(files, e.Name())
   276		}
   277		sort.Strings(files)
   278		var events []rawEvent
   279		var shards []inputShardInfo
   280		for _, name := range files {
   281			data, err := os.ReadFile(filepath.Join(inputDir, name))
   282			if err != nil {
   283				return nil, nil, err
   284			}
   285			si := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}
   286			lineNo := 0
   287			for _, line := range bytes.Split(data, []byte{'\n'}) {
   288				lineNo++
   289				trimmed := bytes.TrimSpace(line)
   290				if len(trimmed) == 0 {
   291					continue
   292				}
   293				si.EventsTotal++
   294				var obj map[string]json.RawMessage
   295				invalid := false
   296				if err := json.Unmarshal(trimmed, &obj); err != nil {
   297					invalid = true
   298				}
   299				events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})
   300			}
   301			shards = append(shards, si)
   302		}
   303		return events, shards, nil
   304	}
   305	
   306	func newContext(raw rawEvent) *eventContext {
   307		ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}
   308		if raw.Obj != nil {
   309			ctx.ID = rawStringPtr(raw.Obj, "id")
   310			ctx.TS = rawStringPtr(raw.Obj, "ts")
   311			ctx.Type = rawStringPtr(raw.Obj, "type")
   312		}
   313		return ctx
   314	}
   315	
   316	func parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {
   317		obj := ctx.Obj
   318		if obj == nil {
   319			return nil, "invalid_json"
   320		}
   321		raw, ok := obj["v"]
   322		if !ok {
   323			return nil, "schema_version"
   324		}
   325		var v int
   326		if err := json.Unmarshal(raw, &v); err != nil {
   327			return nil, "schema_version"
   328		}
   329		if v != 1 && v != 2 {
   330			return nil, "schema_version"
   331		}
   332		id, idOk, _ := getRawString(obj, "id")
   333		if !idOk || id == "" {
   334			return nil, "missing_id"
   335		}
   336		tsStr, tsOk, _ := getRawString(obj, "ts")
   337		if !tsOk {
   338			return nil, "missing_ts"
   339		}
   340		t, err := parseTime(tsStr)
   341		if err != nil {
   342			return nil, "bad_ts"
   343		}
   344		typeStr, typeOk, _ := getRawString(obj, "type")
   345		if !typeOk {
   346			return nil, "missing_type"
   347		}
   348		switch typeStr {
   349		case "purchase", "refund", "chargeback", "login", "signup":
   350		default:
   351			return nil, "bad_type"
   352		}
   353		user, userOk, _ := getRawString(obj, "user_id")
   354		if !userOk || user == "" {
   355			return nil, "missing_user"
   356		}
   357		ev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}
   358		switch typeStr {
   359		case "purchase", "refund":
   360			var amount float64
   361			if v == 1 {
   362				raw, present := obj["amount"]
   363				if !present {
   364					return nil, "missing_amount"
   365				}
   366				var f float64
   367				if err := json.Unmarshal(raw, &f); err != nil {
   368					return nil, "bad_amount"
   369				}
   370				if !isFinite(f) || f < 0 {
   371					return nil, "bad_amount"
   372				}
   373				amount = f
   374			} else {
   375				raw, present := obj["amount_cents"]
   376				if !present {
   377					return nil, "missing_amount"
   378				}
   379				n, err := getJSONInt(raw)
   380				if err != nil || n < 0 {
   381					return nil, "bad_amount"
   382				}
   383				amount = float64(n) / 100.0
   384			}
   385			cur, curOk, curPresent := getRawString(obj, "currency")
   386			if !curPresent {
   387				return nil, "missing_currency"
   388			}
   389			if !curOk || cur == "" {
   390				return nil, "bad_currency"
   391			}
   392			rate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)
   393			switch status {
   394			case "fx_unknown_currency":
   395				return nil, "fx_unknown_currency"
   396			case "missing_rate":
   397				return nil, "fx_no_rate_for_date"
   398			case "bad_rate":
   399				if ratesStrict {
   400					return nil, "fx_bad_rate"
   401				}
   402				return nil, "fx_no_rate_for_date"
   403			}
   404			usd := amount * rate
   405			if typeStr == "refund" {
   406				usd = -usd
   407			}
   408			ev.Amount = amount
   409			ev.Currency = cur
   410			ev.FXFallbackDays = fallbackDays
   411			ev.USD = roundMoney(usd)
   412		case "chargeback":
   413			ref, refOk, refPresent := getRawString(obj, "ref_id")
   414			if !refPresent || !refOk || ref == "" {
   415				return nil, "missing_ref_id"
   416			}
   417			ev.RefID = ref
   418			ev.USD = 0
   419		case "login", "signup":
   420			ev.USD = 0
   421		}
   422		return ev, ""
   423	}
   424	
   425	type stateFileIn struct {
   426		Version          int                   `json:"version"`
   427		Watermark        stateWatermarkOut     `json:"watermark"`
   428		SeenIDs          []string              `json:"seen_ids"`
   429		PendingPurchases []statePendingOut     `json:"pending_purchases"`
   430		OpenSessions     []stateOpenSessionOut `json:"open_sessions"`
   431		RunIndex         int                   `json:"run_index"`
   432	}
   433	
   434	func loadState(path string) (*loadedState, error) {
   435		data, err := os.ReadFile(path)
   436		if err != nil {
   437			return nil, err
   438		}
   439		var sin stateFileIn
   440		if err := json.Unmarshal(data, &sin); err != nil {
   441			return nil, err
   442		}
   443		st := &loadedState{
   444			version:      sin.Version,
   445			seenIds:      map[string]bool{},
   446			runIndex:     sin.RunIndex,
   447			openSessions: map[string]carriedSession{},
   448		}
   449		if sin.Watermark.MaxTS != nil {
   450			t, err := parseTime(*sin.Watermark.MaxTS)
   451			if err != nil {
   452				return nil, fmt.Errorf("bad state watermark: %w", err)
   453			}
   454			st.hasMax = true
   455			st.maxTs = t
   456		}
   457		for _, id := range sin.SeenIDs {
   458			st.seenIds[id] = true
   459		}
   460		for _, p := range sin.PendingPurchases {
   461			t, err := parseTime(p.TS)
   462			if err != nil {
   463				return nil, fmt.Errorf("bad pending purchase ts: %w", err)
   464			}
   465			st.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, user: p.User, usd: float64(p.USD), originRun: p.OriginRun})
   466		}
   467		for _, s := range sin.OpenSessions {
   468			last, err := parseTime(s.LastTS)
   469			if err != nil {
   470				return nil, fmt.Errorf("bad open session last_ts: %w", err)
   471			}
   472			start, err := parseTime(s.StartTS)
   473			if err != nil {
   474				return nil, fmt.Errorf("bad open session start_ts: %w", err)
   475			}
   476			st.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}
   477		}
   478		st.carryInPending = len(st.pending)
   479		st.carryInOpenSessions = len(st.openSessions)
   480		return st, nil
   481	}
   482	
   483	func buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {
   484		out := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}
   485		if hasCurrentMax {
   486			s := formatTS(currentMax)
   487			out.Watermark.MaxTS = &s
   488		} else if st != nil && st.hasMax {
   489			s := formatTS(st.maxTs)
   490			out.Watermark.MaxTS = &s
   491		}
   492		b, _ := json.MarshalIndent(out, "", "  ")
   493		b = append(b, '\n')
   494		return b
   495	}
   496	
   497	func statePendingOutList(pending []pendingEntry) []statePendingOut {
   498		out := make([]statePendingOut, 0, len(pending))
   499		for _, p := range pending {
   500			out = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), User: p.user, USD: Money(p.usd), OriginRun: p.originRun})
   501		}
   502		return out
   503	}
   504	
   505	func stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {
   506		out := make([]stateOpenSessionOut, 0, len(sessions))
   507		for _, s := range sessions {
   508			out = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})
   509		}
   510		return out
   511	}
   512	
   513	func sortedSeenIDs(seen map[string]bool) []string {
   514		ids := make([]string, 0, len(seen))
   515		for id := range seen {
   516			ids = append(ids, id)
   517		}
   518		sort.Strings(ids)
   519		return ids
   520	}
   521	
   522	func sortedPending(pending []pendingEntry) []pendingEntry {
   523		out := append([]pendingEntry(nil), pending...)
   524		sort.SliceStable(out, func(i, j int) bool {
   525			if out[i].ts.Equal(out[j].ts) {
