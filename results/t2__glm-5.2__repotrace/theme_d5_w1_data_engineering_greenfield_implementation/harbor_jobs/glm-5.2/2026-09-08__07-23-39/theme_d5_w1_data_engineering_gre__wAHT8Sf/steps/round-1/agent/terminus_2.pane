   363	func atoiOrError(s, flag string) int {
   364		n, err := strconv.Atoi(s)
   365		if err != nil {
   366			panic(fmt.Errorf("ingest: invalid integer for %s: %s", flag, s))
   367		}
   368		return n
   369	}
   370	
   371	func computeSessionCount(evs []*Event, policy string, gap, windowSecs int) int {
   372		if len(evs) == 0 {
   373			return 0
   374		}
   375		count := 1
   376		var anchor int64
   377		if policy == "fixed-window" || policy == "hybrid" {
   378			anchor = floorEpochToWindow(evs[0].TS.Unix(), int64(windowSecs))
   379		}
   380		for i := 1; i < len(evs); i++ {
   381			split := false
   382			if policy == "gap" || policy == "hybrid" {
   383				if evs[i].TS.Sub(evs[i-1].TS) > time.Duration(gap)*time.Second {
   384					split = true
   385				}
   386			}
   387			if policy == "fixed-window" || policy == "hybrid" {
   388				kPrev := floorDiv(evs[i-1].TS.Unix()-anchor, int64(windowSecs))
   389				kCur := floorDiv(evs[i].TS.Unix()-anchor, int64(windowSecs))
   390				if kPrev != kCur {
   391					split = true
   392				}
   393			}
   394			if split {
   395				count++
   396			}
   397		}
   398		return count
   399	}
   400	
   401	func floorEpochToWindow(epoch, window int64) int64 {
   402		if window <= 0 {
   403			return 0
   404		}
   405		return floorDiv(epoch, window) * window
   406	}
   407	
   408	func floorDiv(a, b int64) int64 {
   409		if b == 0 {
   410			return 0
   411		}
   412		q := a / b
   413		if (a%b != 0) && ((a < 0) != (b < 0)) {
   414			q--
   415		}
   416		return q
   417	}
   418	
   419	func ptrCutoff(c cutoffObject) *cutoffObject {
   420		return &c
   421	}
   422	
   423	func run(cfg cliConfig) error {
   424		ratesData, err := os.ReadFile(cfg.ratesPath)
   425		if err != nil {
   426			return fmt.Errorf("ingest: rates: %w", err)
   427		}
   428		ratesDigest := sha256Hex(ratesData)
   429		rt, err := loadRates(cfg.ratesPath)
   430		if err != nil {
   431			return err
   432		}
   433		var st *loadedState
   434		runIndex := 1
   435		if cfg.stateIn != "" {
   436			st, err = loadState(cfg.stateIn, cfg.stateStrict)
   437			if err != nil && !os.IsNotExist(err) {
   438				return err
   439			}
   440			if st != nil {
   441				runIndex = st.runIndex + 1
   442			}
   443		}
   444		events, blanks, shards, err := readInputEvents(cfg.inputDir)
   445		if err != nil {
   446			return err
   447		}
   448		seen := map[string]bool{}
   449		if st != nil {
   450			for k, v := range st.seenIds {
   451				seen[k] = v
   452			}
   453		}
   454		var pending []pendingEntry
   455		openSessions := map[string]carriedSession{}
   456		if st != nil {
   457			pending = append([]pendingEntry(nil), st.pending...)
   458			for k, v := range st.openSessions {
   459				openSessions[k] = v
   460			}
   461		}
   462		bucketCounts := map[string]int{"accepted": 0, "duplicate": 0, "invalid": 0, "late": 0, "unresolved_chargeback": 0}
   463		invalidReasons := map[string]int{}
   464		duplicateReasons := map[string]int{"same_run": 0, "cross_run": 0}
   465		fxFallbackStats := map[string]int{"0": 0}
   466		shardAccepted := map[string]int{}
   467		var minTs, maxTs time.Time
   468		hasMin, hasMax := false, false
   469		var watermark time.Time
   470		hasWatermark := false
   471		if st != nil {
   472			watermark = st.maxTs
   473			hasWatermark = st.hasMax
   474		}
   475	
   476		type candidate struct {
   477			raw       rawEvent
   478			ctx       *eventContext
   479			ev        *Event
   480			duplicate bool
   481		}
   482		var candidates []candidate
   483		var auditEntries []auditLogEntry
   484	
   485		// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.
   486		for _, raw := range events {
   487			ctx := newContext(raw)
   488			bucket := "invalid"
   489			reason := ""
   490			var ev *Event
   491			var lateCutoff *cutoffObject
   492			var lateLag, lateBySec *int
   493			if raw.Invalid {
   494				bucket = "invalid"
   495				reason = "invalid_json"
   496			} else {
   497				ev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)
   498				if ev != nil {
   499					if seen[ev.ID] {
   500						bucket = "duplicate"
   501						reason = "cross_run"
   502						ev = nil
   503					} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {
   504						bucket = "late"
   505						reason = "late"
   506						cutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)
   507						lateCutoff = ptrCutoff(formatCutoffObject(cutoff))
   508						if cfg.strictLateAudit {
   509							lag := cfg.watermarkLag
   510							lateBy := int(lateCutoff.EpochSeconds - int(epochSeconds(ev.TS)))
   511							lateLag = &lag
   512							lateBySec = &lateBy
   513						}
   514						ev = nil
   515					} else {
   516						bucket = "accepted"
   517						if ev.TS.After(watermark) {
   518							watermark = ev.TS
   519							hasWatermark = true
   520						}
