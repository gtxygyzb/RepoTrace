    94	
    95	func writeShardingReportSidecars(cfg cliConfig, shards []inputShardInfo, auditEntries []auditLogEntry, events []rawEvent) error {
    96		if cfg.shardingReport == "" {
    97			return nil
    98		}
    99		reportShards := buildShardingReportShards(cfg, shards, auditEntries, events)
   100		sortKey := cfg.shardingReportSort
   101		if sortKey == "" {
   102			sortKey = "basename"
   103		}
   104		sortShardingReportShards(reportShards, sortKey)
   105	
   106		var ingestID *string
   107		if cfg.ingestIDSet {
   108			id := cfg.ingestID
   109			ingestID = &id
   110		}
   111		totals := shardingReportTotals{Shards: len(reportShards)}
   112		for _, s := range reportShards {
   113			totals.BytesTotal += s.Bytes
   114			totals.EventsTotal += s.EventsTotal
   115			totals.EventsAccepted += s.EventsAccepted
   116			totals.EventsInvalid += s.EventsInvalid
   117			totals.EventsLate += s.EventsLate
   118			totals.EventsDuplicate += s.EventsDuplicate
   119			totals.EventsUnresolvedChargeback += s.EventsUnresolvedChargeback
   120		}
   121		report := shardingReport{
   122			SchemaVersion: shardingReportSchemaVersion,
   123			IngestID:      ingestID,
   124			Shards:        reportShards,
   125			Totals:        totals,
   126		}
   127		data, err := json.MarshalIndent(report, "", "  ")
   128		if err != nil {
   129			return err
   130		}
   131		data = append(data, '\n')
   132		if err := atomicWriteFile(cfg.shardingReport, data); err != nil {
   133			return err
   134		}
   135	
   136		reportBase := filepath.Base(cfg.shardingReport)
   137		if cfg.shardingReportHistogram != "" {
   138			if err := writeShardingHistogram(cfg.shardingReportHistogram, reportBase, reportShards, totals.Shards); err != nil {
   139				return err
   140			}
   141		}
   142		if cfg.shardingReportDigest != "" {
   143			if err := writeShardingDigest(cfg, data, reportBase, totals.Shards, sortKey, reportShards); err != nil {
   144				return err
   145			}
   146		}
   147		if cfg.shardingReportIndex != "" {
   148			if err := writeShardingIndex(cfg.shardingReportIndex, reportBase, reportShards); err != nil {
   149				return err
   150			}
   151		}
   152		return nil
   153	}
   154	
   155	func buildShardingReportShards(cfg cliConfig, shards []inputShardInfo, auditEntries []auditLogEntry, events []rawEvent) []shardingReportShard {
   156		counts := map[string]map[string]int{}
   157		for _, e := range auditEntries {
   158			if counts[e.Shard] == nil {
   159				counts[e.Shard] = map[string]int{}
   160			}
   161			counts[e.Shard][e.Bucket]++
   162		}
   163		tsRanges := map[string]*shardTSRange{}
   164		for _, raw := range events {
   165			if raw.Invalid || raw.Blank || raw.Obj == nil {
   166				continue
   167			}
   168			ts, ok, _ := getRawString(raw.Obj, "ts")
   169			if !ok || !isExactRFC3339UTC(ts) {
   170				continue
   171			}
   172			r := tsRanges[raw.Shard]
   173			if r == nil {
   174				r = &shardTSRange{}
   175				tsRanges[raw.Shard] = r
   176			}
   177			if r.first == "" || ts < r.first {
   178				r.first = ts
   179			}
   180			if r.last == "" || ts > r.last {
   181				r.last = ts
   182			}
   183		}
   184		out := make([]shardingReportShard, 0, len(shards))
   185		for _, s := range shards {
   186			c := counts[s.Name]
   187			r := tsRanges[s.Name]
   188			rec := shardingReportShard{
   189				Shard:                      s.Name,
   190				Bytes:                      s.Bytes,
   191				SHA256:                     s.SHA256,
   192				EventsTotal:                s.EventsTotal,
   193				EventsAccepted:             c["accepted"],
   194				EventsInvalid:              c["invalid"],
   195				EventsLate:                 c["late"],
   196				EventsDuplicate:            c["duplicate"],
   197				EventsUnresolvedChargeback: c["unresolved_chargeback"],
   198			}
   199			if r != nil && r.first != "" {
   200				first := r.first
   201				last := r.last
   202				rec.FirstTS = &first
   203				rec.LastTS = &last
   204			}
   205			out = append(out, rec)
   206		}
   207		return out
   208	}
   209	
   210	type shardTSRange struct {
   211		first string
   212		last  string
   213	}
   214	
   215	func isExactRFC3339UTC(s string) bool {
   216		_, err := time.Parse("2006-01-02T15:04:05Z", s)
   217		return err == nil
   218	}
