   155	func nextArg(args []string, i *int) string {
   156		if *i+1 >= len(args) {
   157			panic(fmt.Errorf("ingest: missing value for %s", args[*i]))
   158		}
   159		*i++
   160		return args[*i]
   161	}
   162	
   163	func atoiOrError(s, flag string) int {
   164		n, err := strconv.Atoi(s)
   165		if err != nil {
   166			panic(fmt.Errorf("ingest: invalid integer for %s: %s", flag, s))
   167		}
   168		return n
   169	}
