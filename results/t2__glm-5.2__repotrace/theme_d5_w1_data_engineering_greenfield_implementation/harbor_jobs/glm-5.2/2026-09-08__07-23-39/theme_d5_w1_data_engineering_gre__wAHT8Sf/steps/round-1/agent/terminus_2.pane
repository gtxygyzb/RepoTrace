   283	
   284	func nextArg(args []string, i *int) string {
   285		if *i+1 >= len(args) {
   286			panic(fmt.Errorf("ingest: missing value for %s", args[*i]))
   287		}
   288		*i++
   289		return args[*i]
   290	}
   291	
   292	func atoiOrError(s, flag string) int {
   293		n, err := strconv.Atoi(s)
   294		if err != nil {
   295			panic(fmt.Errorf("ingest: invalid integer for %s: %s", flag, s))
   296		}
   297		return n
   298	}
   299	
   300	func computeSessionCount(evs []*Event, policy string, gap, windowSecs int) int {
   301		if len(evs) == 0 {
   302			return 0
   303		}
   304		count := 1
   305		var anchor int64
   306		if policy == "fixed-window" || policy == "hybrid" {
   307			anchor = floorEpochToWindow(evs[0].TS.Unix(), int64(windowSecs))
   308		}
   309		for i := 1; i < len(evs); i++ {
   310			split := false
   311			if policy == "gap" || policy == "hybrid" {
   312				if evs[i].TS.Sub(evs[i-1].TS) > time.Duration(gap)*time.Second {
   313					split = true
   314				}
   315			}
   316			if policy == "fixed-window" || policy == "hybrid" {
   317				kPrev := floorDiv(evs[i-1].TS.Unix()-anchor, int64(windowSecs))
   318				kCur := floorDiv(evs[i].TS.Unix()-anchor, int64(windowSecs))
   319				if kPrev != kCur {
   320					split = true
   321				}
   322			}
   323			if split {
   324				count++
   325			}
   326		}
   327		return count
   328	}
   329	
   330	func floorEpochToWindow(epoch, window int64) int64 {
   331		if window <= 0 {
   332			return 0
   333		}
   334		return floorDiv(epoch, window) * window
   335	}
   336	
   337	func floorDiv(a, b int64) int64 {
   338		if b == 0 {
   339			return 0
   340		}
   341		q := a / b
   342		if (a%b != 0) && ((a < 0) != (b < 0)) {
   343			q--
   344		}
   345		return q
   346	}
   347	
   348	func ptrCutoff(c cutoffObject) *cutoffObject {
   349		return &c
   350	}
   351	
   352	func run(cfg cliConfig) error {
   353		ratesData, err := os.ReadFile(cfg.ratesPath)
   354		if err != nil {
   355			return fmt.Errorf("ingest: rates: %w", err)
   356		}
   357		ratesDigest := sha256Hex(ratesData)
   358		rt, err := loadRates(cfg.ratesPath)
   359		if err != nil {
   360			return err
   361		}
   362		var st *loadedState
   363		runIndex := 1
   364		if cfg.stateIn != "" {
   365			st, err = loadState(cfg.stateIn, cfg.stateStrict)
   366			if err != nil && !os.IsNotExist(err) {
   367				return err
   368			}
   369			if st != nil {
   370				runIndex = st.runIndex + 1
   371			}
   372		}
   373		events, blanks, shards, err := readInputEvents(cfg.inputDir)
   374		if err != nil {
   375			return err
   376		}
   377		seen := map[string]bool{}
   378		if st != nil {
   379			for k, v := range st.seenIds {
   380				seen[k] = v
   381			}
   382		}
   383		var pending []pendingEntry
   384		openSessions := map[string]carriedSession{}
   385		if st != nil {
   386			pending = append([]pendingEntry(nil), st.pending...)
   387			for k, v := range st.openSessions {
   388				openSessions[k] = v
   389			}
   390		}
   391		bucketCounts := map[string]int{"accepted": 0, "duplicate": 0, "invalid": 0, "late": 0, "unresolved_chargeback": 0}
   392		invalidReasons := map[string]int{}
   393		duplicateReasons := map[string]int{"same_run": 0, "cross_run": 0}
   394		fxFallbackStats := map[string]int{"0": 0}
   395		shardAccepted := map[string]int{}
   396		var minTs, maxTs time.Time
   397		hasMin, hasMax := false, false
   398		var watermark time.Time
   399		hasWatermark := false
   400		if st != nil {
   401			watermark = st.maxTs
   402			hasWatermark = st.hasMax
   403		}
   404	
   405		type candidate struct {
   406			raw       rawEvent
   407			ctx       *eventContext
   408			ev        *Event
   409			duplicate bool
   410		}
   411		var candidates []candidate
   412		var auditEntries []auditLogEntry
   413	
   414		// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.
   415		for _, raw := range events {
   416			ctx := newContext(raw)
   417			bucket := "invalid"
   418			reason := ""
   419			var ev *Event
   420			var lateCutoff *cutoffObject
   421			var lateLag, lateBySec *int
   422			if raw.Invalid {
   423				bucket = "invalid"
   424				reason = "invalid_json"
   425			} else {
   426				ev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)
   427				if ev != nil {
   428					if seen[ev.ID] {
   429						bucket = "duplicate"
   430						reason = "cross_run"
   431						ev = nil
   432					} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {
   433						bucket = "late"
   434						reason = "late"
   435						cutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)
   436						lateCutoff = ptrCutoff(formatCutoffObject(cutoff))
   437						if cfg.strictLateAudit {
   438							lag := cfg.watermarkLag
   439							lateBy := int(lateCutoff.EpochSeconds - int(epochSeconds(ev.TS)))
   440							lateLag = &lag
   441							lateBySec = &lateBy
   442						}
   443						ev = nil
   444					} else {
   445						bucket = "accepted"
   446						if ev.TS.After(watermark) {
   447							watermark = ev.TS
   448							hasWatermark = true
   449						}
   450					}
   451				} else {
   452					bucket = "invalid"
   453				}
   454			}
   455			if bucket == "invalid" {
   456				invalidReasons[reason]++
   457			}
   458			bucketCounts[bucket]++
   459			if bucket == "duplicate" && reason == "cross_run" {
   460				duplicateReasons["cross_run"]++
   461			}
   462			candidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})
   463			auditEntries = append(auditEntries, auditLogEntry{
   464				Shard:               raw.Shard,
