   368					minTs = c.ev.TS
   369					hasMin = true
   370				}
   371				if !hasMax || c.ev.TS.After(maxTs) {
   372					maxTs = c.ev.TS
   373					hasMax = true
   374				}
   375				_ = pending
   376				_ = openSessions
   377			} else {
   378				bucketCounts["duplicate"]++
