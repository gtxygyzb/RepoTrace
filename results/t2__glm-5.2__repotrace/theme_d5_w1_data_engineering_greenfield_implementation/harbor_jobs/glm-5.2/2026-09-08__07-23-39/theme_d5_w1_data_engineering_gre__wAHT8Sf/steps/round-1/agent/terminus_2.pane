   431	func atoiOrError(s, flag string) int {
   432		n, err := strconv.Atoi(s)
   433		if err != nil {
   434			panic(fmt.Errorf("ingest: invalid integer for %s: %s", flag, s))
   435		}
   436		return n
   437	}
   438	
   439	func computeSessionCount(evs []*Event, policy string, gap, windowSecs int) int {
   440		if len(evs) == 0 {
   441			return 0
   442		}
   443		count := 1
   444		var anchor int64
   445		if policy == "fixed-window" || policy == "hybrid" {
   446			anchor = floorEpochToWindow(evs[0].TS.Unix(), int64(windowSecs))
   447		}
   448		for i := 1; i < len(evs); i++ {
   449			split := false
   450			if policy == "gap" || policy == "hybrid" {
   451				if evs[i].TS.Sub(evs[i-1].TS) > time.Duration(gap)*time.Second {
   452					split = true
   453				}
   454			}
   455			if policy == "fixed-window" || policy == "hybrid" {
   456				kPrev := floorDiv(evs[i-1].TS.Unix()-anchor, int64(windowSecs))
   457				kCur := floorDiv(evs[i].TS.Unix()-anchor, int64(windowSecs))
   458				if kPrev != kCur {
   459					split = true
   460				}
   461			}
   462			if split {
   463				count++
   464			}
   465		}
   466		return count
   467	}
   468	
   469	func floorEpochToWindow(epoch, window int64) int64 {
   470		if window <= 0 {
   471			return 0
   472		}
   473		return floorDiv(epoch, window) * window
   474	}
   475	
   476	func floorDiv(a, b int64) int64 {
   477		if b == 0 {
   478			return 0
   479		}
   480		q := a / b
   481		if (a%b != 0) && ((a < 0) != (b < 0)) {
   482			q--
   483		}
   484		return q
   485	}
   486	
   487	func ptrCutoff(c cutoffObject) *cutoffObject {
   488		return &c
   489	}
