   431	func atoiOrError(s, flag string) int {
   432		n, err := strconv.Atoi(s)
   433		if err != nil {
   434			panic(fmt.Errorf("ingest: invalid integer for %s: %s", flag, s))
   435		}
   436		return n
   437	}
   438	
   439	func computeSessionCount(evs []*Event, policy string, gap, windowSecs int) int {
   440		if len(evs) == 0 {
   441			return 0
   442		}
   443		count := 1
   444		var anchor int64
   445		if policy == "fixed-window" || policy == "hybrid" {
   446			anchor = floorEpochToWindow(evs[0].TS.Unix(), int64(windowSecs))
   447		}
   448		for i := 1; i < len(evs); i++ {
   449			split := false
   450			if policy == "gap" || policy == "hybrid" {
   451				if evs[i].TS.Sub(evs[i-1].TS) > time.Duration(gap)*time.Second {
   452					split = true
   453				}
   454			}
   455			if policy == "fixed-window" || policy == "hybrid" {
   456				kPrev := floorDiv(evs[i-1].TS.Unix()-anchor, int64(windowSecs))
   457				kCur := floorDiv(evs[i].TS.Unix()-anchor, int64(windowSecs))
   458				if kPrev != kCur {
   459					split = true
   460				}
   461			}
   462			if split {
   463				count++
   464			}
   465		}
   466		return count
   467	}
   468	
   469	func floorEpochToWindow(epoch, window int64) int64 {
   470		if window <= 0 {
   471			return 0
   472		}
   473		return floorDiv(epoch, window) * window
   474	}
   475	
   476	func floorDiv(a, b int64) int64 {
   477		if b == 0 {
   478			return 0
   479		}
   480		q := a / b
   481		if (a%b != 0) && ((a < 0) != (b < 0)) {
   482			q--
   483		}
   484		return q
   485	}
   486	
   487	func ptrCutoff(c cutoffObject) *cutoffObject {
   488		return &c
   489	}
   490	
   491	func run(cfg cliConfig) error {
   492		ratesData, err := os.ReadFile(cfg.ratesPath)
   493		if err != nil {
   494			return fmt.Errorf("ingest: rates: %w", err)
   495		}
   496		ratesDigest := sha256Hex(ratesData)
   497		rt, err := loadRates(cfg.ratesPath)
   498		if err != nil {
   499			return err
   500		}
   501		var st *loadedState
   502		runIndex := 1
   503		if cfg.stateIn != "" {
   504			st, err = loadState(cfg.stateIn, cfg.stateStrict)
   505			if err != nil && !os.IsNotExist(err) {
   506				return err
   507			}
   508			if st != nil {
   509				runIndex = st.runIndex + 1
   510			}
   511		}
   512		events, blanks, shards, err := readInputEvents(cfg.inputDir)
   513		if err != nil {
   514			return err
   515		}
   516		seen := map[string]bool{}
   517		if st != nil {
   518			for k, v := range st.seenIds {
   519				seen[k] = v
   520			}
   521		}
   522		var pending []pendingEntry
   523		openSessions := map[string]carriedSession{}
   524		if st != nil {
   525			pending = append([]pendingEntry(nil), st.pending...)
   526			for k, v := range st.openSessions {
   527				openSessions[k] = v
   528			}
   529		}
   530		bucketCounts := map[string]int{"accepted": 0, "duplicate": 0, "invalid": 0, "late": 0, "unresolved_chargeback": 0}
   531		invalidReasons := map[string]int{}
   532		duplicateReasons := map[string]int{"same_run": 0, "cross_run": 0}
   533		fxFallbackStats := map[string]int{"0": 0}
   534		shardAccepted := map[string]int{}
   535		var minTs, maxTs time.Time
   536		hasMin, hasMax := false, false
   537		var watermark time.Time
   538		hasWatermark := false
   539		if st != nil {
   540			watermark = st.maxTs
   541			hasWatermark = st.hasMax
   542		}
   543	
   544		type candidate struct {
   545			raw       rawEvent
   546			ctx       *eventContext
   547			ev        *Event
   548			duplicate bool
   549		}
   550		var candidates []candidate
   551		var auditEntries []auditLogEntry
   552	
   553		// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.
   554		for _, raw := range events {
   555			ctx := newContext(raw)
   556			bucket := "invalid"
   557			reason := ""
   558			var ev *Event
   559			var lateCutoff *cutoffObject
   560			var lateLag, lateBySec *int
   561			if raw.Invalid {
   562				bucket = "invalid"
   563				reason = "invalid_json"
   564			} else {
   565				ev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)
   566				if ev != nil {
   567					if seen[ev.ID] {
   568						bucket = "duplicate"
   569						reason = "cross_run"
   570						ev = nil
   571					} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {
   572						bucket = "late"
   573						reason = "late"
   574						cutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)
   575						lateCutoff = ptrCutoff(formatCutoffObject(cutoff))
   576						if cfg.strictLateAudit {
   577							lag := cfg.watermarkLag
   578							lateBy := int(lateCutoff.EpochSeconds - int(epochSeconds(ev.TS)))
