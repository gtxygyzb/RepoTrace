   252		switch t {
   253		case "array":
   254			arr := v.([]any)
   255			var elementType any
   256			if len(arr) == 0 {
   257				if strict {
   258					elementType = []orderedJSON{{key: "type", value: "unknown"}}
   259				} else {
   260					elementType = nil
