   255	func run(cfg cliConfig) error {
   256		ratesData, err := os.ReadFile(cfg.ratesPath)
   257		if err != nil {
   258			return fmt.Errorf("ingest: rates: %w", err)
   259		}
   260		ratesDigest := sha256Hex(ratesData)
   261		rt, err := loadRates(cfg.ratesPath)
   262		if err != nil {
   263			return err
   264		}
   265		var st *loadedState
   266		runIndex := 1
   267		if cfg.stateIn != "" {
   268			st, err = loadState(cfg.stateIn, cfg.stateStrict)
   269			if err != nil && !os.IsNotExist(err) {
   270				return err
   271			}
   272			if st != nil {
   273				runIndex = st.runIndex + 1
   274			}
   275		}
   276		events, shards, err := readInputEvents(cfg.inputDir)
   277		if err != nil {
   278			return err
   279		}
   280		seen := map[string]bool{}
   281		if st != nil {
   282			for k, v := range st.seenIds {
   283				seen[k] = v
   284			}
   285		}
   286		var pending []pendingEntry
   287		openSessions := map[string]carriedSession{}
   288		if st != nil {
   289			pending = append([]pendingEntry(nil), st.pending...)
   290			for k, v := range st.openSessions {
   291				openSessions[k] = v
   292			}
   293		}
   294		bucketCounts := map[string]int{"accepted": 0, "duplicate": 0, "invalid": 0, "late": 0, "unresolved_chargeback": 0}
   295		invalidReasons := map[string]int{}
   296		duplicateReasons := map[string]int{"same_run": 0, "cross_run": 0}
   297		fxFallbackStats := map[string]int{"0": 0}
   298		shardAccepted := map[string]int{}
   299		var minTs, maxTs time.Time
   300		hasMin, hasMax := false, false
   301		var watermark time.Time
   302		hasWatermark := false
   303		if st != nil {
   304			watermark = st.maxTs
   305			hasWatermark = st.hasMax
   306		}
   307	
   308		type candidate struct {
   309			raw       rawEvent
   310			ctx       *eventContext
   311			ev        *Event
   312			duplicate bool
   313		}
   314		var candidates []candidate
   315		var auditEntries []auditLogEntry
   316	
   317		// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.
   318		for _, raw := range events {
   319			ctx := newContext(raw)
   320			bucket := "invalid"
   321			reason := ""
   322			var ev *Event
   323			if raw.Invalid {
   324				bucket = "invalid"
   325				reason = "invalid_json"
   326			} else {
   327				ev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)
   328				if ev != nil {
   329					if seen[ev.ID] {
   330						bucket = "duplicate"
   331						reason = "cross_run"
   332						ev = nil
   333					} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {
   334						bucket = "late"
   335						reason = "late"
   336						cutoff := watermark.Add(time.Duration(-cfg.watermarkLag) * time.Second)
   337						entry := auditLogEntry{
   338							Shard:  raw.Shard,
   339							Line:   raw.Line,
   340							ID:     ctx.IDStr(),
   341							TS:     ctx.TSString(),
   342							Type:   ctx.TypeString(),
   343							Bucket: bucket,
   344							Cutoff: ptrCutoff(formatCutoffObject(cutoff)),
   345						}
   346						if cfg.strictLateAudit {
   347							lag := cfg.watermarkLag
   348							lateBy := int(entry.Cutoff.EpochSeconds - int(epochSeconds(ev.TS)))
   349							entry.WatermarkLagSeconds = &lag
   350							entry.LateBySeconds = &lateBy
   351						}
   352						auditEntries = append(auditEntries, entry)
   353						ev = nil
   354					} else {
   355						bucket = "accepted"
   356						if ev.TS.After(watermark) {
   357							watermark = ev.TS
   358							hasWatermark = true
   359						}
   360					}
   361				} else {
   362					bucket = "invalid"
   363				}
   364			}
   365			if bucket == "invalid" {
   366				invalidReasons[reason]++
   367			}
   368			bucketCounts[bucket]++
   369			if bucket == "duplicate" && reason == "cross_run" {
   370				duplicateReasons["cross_run"]++
   371			}
   372			candidates = append(candidates, candidate{raw: raw, ctx: ctx, ev: ev, duplicate: false})
   373			auditEntries = append(auditEntries, auditLogEntry{
   374				Shard:  raw.Shard,
   375				Line:   raw.Line,
   376				ID:     ctx.IDStr(),
   377				TS:     ctx.TSString(),
   378				Type:   ctx.TypeString(),
   379				Bucket: bucket,
   380				Reason: reason,
   381				Event:  raw.Raw,
   382			})
   383		}
   384	
   385		// Group same-run duplicate candidates by id. Cross-run duplicates are already rejected.
   386		groups := map[string][]int{}
   387		for i, c := range candidates {
   388			if c.ev != nil {
   389				groups[c.ev.ID] = append(groups[c.ev.ID], i)
   390			}
   391		}
   392		winnerSet := map[int]bool{}
   393		winners := map[string]int{}
   394		var dedupPolicyStats dedupPolicyStats
   395		dedupPolicyStats.Policy = cfg.dedupPolicy
   396		for id, idxs := range groups {
   397			if len(idxs) < 2 {
   398				if len(idxs) == 1 {
   399					winners[id] = idxs[0]
   400					winnerSet[idxs[0]] = true
   401				}
   402				continue
   403			}
   404			winner := idxs[0]
   405			tiebreak := false
   406			for _, idx := range idxs[1:] {
   407				if cfg.dedupPolicy == "first-arrival" {
   408					if arrivalLess(candidates[idx].ev, candidates[winner].ev) {
   409						winner = idx
   410					}
   411				} else {
   412					cts := candidates[idx].ctx.TSString()
   413					wts := candidates[winner].ctx.TSString()
   414					if cts > wts {
   415						winner = idx
   416						tiebreak = false
   417					} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {
   418						winner = idx
   419						tiebreak = true
   420					}
   421				}
   422			}
   423			if cfg.dedupPolicy == "lex-largest-ts" {
   424				wts := candidates[winner].ctx.TSString()
   425				for _, idx := range idxs {
   426					if idx != winner && candidates[idx].ctx.TSString() == wts {
   427						tiebreak = true
   428						break
   429					}
   430				}
   431			}
   432			winners[id] = winner
   433			winnerSet[winner] = true
   434			sameShard := true
   435			for _, idx := range idxs {
   436				if candidates[idx].ev.Shard != candidates[winner].ev.Shard {
   437					sameShard = false
   438					break
   439				}
   440			}
   441			if sameShard {
   442				dedupPolicyStats.DuplicateWinnersSameShard++
   443				if cfg.dedupPolicy == "first-arrival" || tiebreak {
   444					dedupPolicyStats.DuplicateWinnersLineTiebreak++
   445				}
   446			} else {
   447				dedupPolicyStats.DuplicateWinnersCrossShard++
   448			}
   449		}
   450	
   451		// Finalize accepted/duplicate buckets and outputs in arrival order.
   452		hasMin, hasMax = false, false
   453		for _, c := range candidates {
   454			if c.ev != nil {
   455				seen[c.ev.ID] = true
   456			}
   457		}
   458		bucketCounts["accepted"] = 0
   459		bucketCounts["duplicate"] = duplicateReasons["cross_run"]
   460		for i, c := range candidates {
   461			_ = i
   462			if c.ev == nil {
   463				continue
   464			}
   465			if winnerSet[i] {
   466				bucketCounts["accepted"]++
   467				shardAccepted[c.ev.Shard]++
   468				if !hasMin || c.ev.TS.Before(minTs) {
   469					minTs = c.ev.TS
   470					hasMin = true
   471				}
   472				if !hasMax || c.ev.TS.After(maxTs) {
   473					maxTs = c.ev.TS
   474					hasMax = true
   475				}
   476				_ = pending
   477				_ = openSessions
   478			} else {
   479				bucketCounts["duplicate"]++
   480				duplicateReasons["same_run"]++
   481				entry := auditEntries[i]
   482				entry.Bucket = "duplicate"
   483				entry.Reason = "same_run"
   484				if cfg.dedupPolicy == "first-arrival" {
   485					w := winners[entry.ID]
   486					entry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}
   487				}
   488				auditEntries[i] = entry
   489			}
   490		}
   491	
   492		var rejectRecords []rejectRecord
   493		for i, c := range candidates {
   494			if c.ev == nil {
   495				r := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, raw: c.raw.Raw}
   496				rejectRecords = append(rejectRecords, r)
   497				continue
   498			}
   499			if winnerSet[i] {
   500				continue
   501			}
   502			r := rejectRecord{bucket: "duplicate", reason: "same_run", raw: c.raw.Raw}
   503			if cfg.dedupPolicy == "first-arrival" {
   504				r.winner = true
   505				r.winnerShard = candidates[winners[c.ev.ID]].ev.Shard
   506				r.winnerLine = candidates[winners[c.ev.ID]].ev.Line
   507			}
   508			rejectRecords = append(rejectRecords, r)
   509		}
   510	
   511		summary := summaryOutput{
   512			TotalEvents:    len(events),
   513			AcceptedEvents: bucketCounts["accepted"],
   514			RejectedEvents: bucketCounts["duplicate"] + bucketCounts["invalid"] + bucketCounts["late"] + bucketCounts["unresolved_chargeback"],
   515			Anomalies: map[string]int{
   516				"duplicate":             bucketCounts["duplicate"],
   517				"invalid":               bucketCounts["invalid"],
   518				"late":                  bucketCounts["late"],
   519				"unresolved_chargeback": bucketCounts["unresolved_chargeback"],
   520			},
