   505				hashByPath := make(map[string]string, len(auditSegmentPaths))
   506				for _, path := range auditSegmentPaths {
   507					h, _, err := fileDigest(path)
   508					if err != nil {
   509						return err
   510					}
   511					hashByPath[path] = h
   512				}
   513				orderedPaths := append([]string(nil), auditSegmentPaths...)
