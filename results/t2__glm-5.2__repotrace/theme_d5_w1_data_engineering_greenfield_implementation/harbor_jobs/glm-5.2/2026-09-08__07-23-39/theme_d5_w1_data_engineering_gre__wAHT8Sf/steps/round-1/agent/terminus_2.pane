   357	func isNonNegativeInteger(v any) bool {
   358		switch val := v.(type) {
   359		case json.Number:
   360			s := val.String()
   361			if strings.ContainsAny(s, ".eE") {
   362				return false
   363			}
   364			n, err := val.Int64()
   365			if err != nil {
   366				return false
   367			}
   368			return n >= 0
   369		case float64:
   370			if val != float64(int64(val)) {
   371				return false
   372			}
   373			return val >= 0
   374		}
   375		return false
   376	}
   377	
   378	func isZeroInteger(v any) bool {
   379		switch val := v.(type) {
   380		case json.Number:
   381			s := val.String()
   382			if strings.ContainsAny(s, ".eE") {
   383				return false
   384			}
   385			n, err := val.Int64()
   386			if err != nil {
   387				return false
   388			}
   389			return n == 0
   390		case float64:
   391			if val != float64(int64(val)) {
   392				return false
   393			}
   394			return val == 0
   395		}
   396		return false
   397	}
   398	
   399	func isRFC3339UTCZ(s string) bool {
   400		return rfc3339UTCZRE.MatchString(s)
   401	}
