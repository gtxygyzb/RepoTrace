    80	func formatCutoffObject(cutoff time.Time) cutoffObject {
    81		epoch := epochSeconds(cutoff)
    82		if epoch < 0 {
    83			epoch = 0
    84			cutoff = time.Unix(0, 0).UTC()
    85		}
    86		return cutoffObject{Value: formatTS(cutoff), EpochSeconds: int(epoch)}
    87	}
