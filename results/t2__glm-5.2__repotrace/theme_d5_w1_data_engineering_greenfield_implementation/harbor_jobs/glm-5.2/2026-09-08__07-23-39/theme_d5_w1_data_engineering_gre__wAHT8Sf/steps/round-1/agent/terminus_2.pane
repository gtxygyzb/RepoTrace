\tinfo, err := os.Stat(inputDir)
\tif err != nil {
\t\treturn nil, nil, err
\t}
\tif !info.IsDir() {
\t\treturn nil, nil, errors.New("input-dir is not a directory")
\t}
\tentries, err := os.ReadDir(inputDir)
\tif err != nil {
\t\treturn nil, nil, err
\t}
\tvar files []string
\tfor _, e := range entries {
\t\tif e.IsDir() || !e.Type().IsRegular() {
\t\t\tcontinue
\t\t}
\t\tfiles = append(files, e.Name())
\t}
\tsort.Strings(files)
\tvar events []rawEvent
\tvar shards []inputShardInfo
\tfor _, name := range files {
\t\tdata, err := os.ReadFile(filepath.Join(inputDir, name))
\t\tif err != nil {
\t\t\treturn nil, nil, err
\t\t}
\t\tsi := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}
\t\tlineNo := 0
\t\tfor _, line := range bytes.Split(data, []byte{'\\n'}) {
\t\t\tlineNo++
\t\t\ttrimmed := bytes.TrimSpace(line)
\t\t\tif len(trimmed) == 0 {
\t\t\t\tcontinue
\t\t\t}
\t\t\tsi.EventsTotal++
\t\t\tvar obj map[string]json.RawMessage
\t\t\tinvalid := false
\t\t\tif err := json.Unmarshal(trimmed, &obj); err != nil {
\t\t\t\tinvalid = true
\t\t\t}
\t\t\tevents = append(events, rawEvent{Shard: name, Line: lineNo, Raw: json.RawMessage(trimmed), Obj: obj, Invalid: invalid})
\t\t}
\t\tshards = append(shards, si)
\t}
\treturn events, shards, nil
}

'''
