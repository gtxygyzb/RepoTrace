   305	func newContext(raw rawEvent) *eventContext {
   306		ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}
   307		ctx.ID = rawStringPtr(raw.Obj, "id")
   308		ctx.TS = rawStringPtr(raw.Obj, "ts")
   309		ctx.Type = rawStringPtr(raw.Obj, "type")
   310		return ctx
   311	}
   312	
   313	func parseEvent(ctx *eventContext, rt *RateTable, ratesStrict bool, maxStaleness int) (*Event, string) {
   314		obj := ctx.Obj
   315		raw, ok := obj["v"]
   316		if !ok {
   317			return nil, "schema_version"
   318		}
   319		var v int
   320		if err := json.Unmarshal(raw, &v); err != nil {
   321			return nil, "schema_version"
   322		}
   323		if v != 1 && v != 2 {
   324			return nil, "schema_version"
   325		}
   326		id, idOk, _ := getRawString(obj, "id")
   327		if !idOk || id == "" {
   328			return nil, "missing_id"
   329		}
   330		tsStr, tsOk, _ := getRawString(obj, "ts")
   331		if !tsOk {
   332			return nil, "missing_ts"
   333		}
   334		t, err := parseTime(tsStr)
   335		if err != nil {
   336			return nil, "bad_ts"
   337		}
   338		typeStr, typeOk, _ := getRawString(obj, "type")
   339		if !typeOk {
   340			return nil, "missing_type"
   341		}
   342		switch typeStr {
   343		case "purchase", "refund", "chargeback", "login", "signup":
   344		default:
   345			return nil, "bad_type"
   346		}
   347		user, userOk, _ := getRawString(obj, "user_id")
   348		if !userOk || user == "" {
   349			return nil, "missing_user"
   350		}
   351		ev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}
   352		switch typeStr {
   353		case "purchase", "refund":
   354			var amount float64
   355			if v == 1 {
   356				raw, present := obj["amount"]
   357				if !present {
   358					return nil, "missing_amount"
   359				}
   360				var f float64
   361				if err := json.Unmarshal(raw, &f); err != nil {
   362					return nil, "bad_amount"
   363				}
   364				if !isFinite(f) || f < 0 {
   365					return nil, "bad_amount"
   366				}
   367				amount = f
   368			} else {
   369				raw, present := obj["amount_cents"]
   370				if !present {
   371					return nil, "missing_amount"
   372				}
   373				n, err := getJSONInt(raw)
   374				if err != nil || n < 0 {
   375					return nil, "bad_amount"
   376				}
   377				amount = float64(n) / 100.0
   378			}
   379			cur, curOk, curPresent := getRawString(obj, "currency")
   380			if !curPresent {
   381				return nil, "missing_currency"
   382			}
   383			if !curOk || cur == "" {
   384				return nil, "bad_currency"
   385			}
   386			rate, fallbackDays, status := rt.resolveRate(dateKey(t), cur, maxStaleness)
   387			switch status {
   388			case "fx_unknown_currency":
   389				return nil, "fx_unknown_currency"
   390			case "missing_rate":
   391				return nil, "fx_no_rate_for_date"
   392			case "bad_rate":
   393				if ratesStrict {
   394					return nil, "fx_bad_rate"
   395				}
   396				return nil, "fx_no_rate_for_date"
   397			}
   398			usd := amount * rate
   399			if typeStr == "refund" {
   400				usd = -usd
   401			}
   402			ev.Amount = amount
   403			ev.Currency = cur
   404			ev.FXFallbackDays = fallbackDays
   405			ev.USD = roundMoney(usd)
   406		case "chargeback":
   407			ref, refOk, refPresent := getRawString(obj, "ref_id")
   408			if !refPresent || !refOk || ref == "" {
   409				return nil, "missing_ref_id"
   410			}
   411			ev.RefID = ref
   412			ev.USD = 0
   413		case "login", "signup":
   414			ev.USD = 0
   415		}
   416		return ev, ""
   417	}
   418	
