    73	func newRateTable() *RateTable {
    74		return &RateTable{base: "USD", days: map[string]map[string]float64{}, known: map[string]bool{}}
    75	}
    76	
    77	func isUsableRate(f float64) bool {
    78		return isFinite(f) && f > 0
    79	}
    80	
    81	func parseRateNumber(raw json.RawMessage) (float64, error) {
    82		if bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
    83			return 0, errors.New("non-numeric rate")
    84		}
    85		var f float64
    86		if err := json.Unmarshal(raw, &f); err != nil {
    87			return 0, errors.New("non-numeric rate")
    88		}
    89		return f, nil
    90	}
    91	
    92	func sortedKeys[T any](m map[string]T) []string {
    93		keys := make([]string, 0, len(m))
    94		for k := range m {
    95			keys = append(keys, k)
    96		}
    97		sort.Strings(keys)
    98		return keys
    99	}
