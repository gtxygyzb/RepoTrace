[?2004lpackage main

import (
	"bytes"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"regexp"
	"sort"
	"strconv"
	"strings"
	"time"
)

var ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)

type cliConfig struct {
	inputDir            string
	ratesPath           string
	outputPath          string
	rejectsPath         string
	sessionGap          int
	watermarkLag        int
	stateIn             string
	stateOut            string
	pendingTTL          int
	maxOpenSessions     int
	auditLog            string
	auditLogDigest      string
	auditLogRotateBytes int
	ratesStrict         bool
	ratesMaxStaleness   int
	ingestID            string
	ingestIDSet         bool
	outManifest         string
	manifestSignature   string
	dedupPolicy         string
	dedupPolicySet      bool
	strictLateAudit     bool
	stateStrict         bool
	summarySchemaOut    string
	summarySchemaDigest string
	summarySchemaStrict bool
	summarySchemaIndex  string
	rejectsFormat       string
	rejectsFormatHeader bool
	sessionPolicy       string
	fixedWindowSeconds  int
	fixedWindowSet      bool
}

func main() {
	cfg, err := parseArgs(os.Args[1:])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(2)
	}
	if err := run(cfg); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func parseArgs(args []string) (cfg cliConfig, err error) {
	defer func() {
		if r := recover(); r != nil {
			cfg = cliConfig{}
			err = fmt.Errorf("%v", r)
		}
	}()
	cfg = cliConfig{
		sessionGap:        600,
		watermarkLag:      300,
		pendingTTL:        86400,
		maxOpenSessions:   100000,
		ratesMaxStaleness: 0,
	}
	required := map[string]bool{
		"--input-dir": false,
		"--rates":     false,
		"--output":    false,
		"--rejects":   false,
	}
	if len(args) > 0 && args[0] == "ingest" {
		args = args[1:]
	}
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if strings.HasPrefix(arg, "--summary-schema-out=") {
			cfg.summarySchemaOut = strings.TrimPrefix(arg, "--summary-schema-out=")
			if cfg.summarySchemaOut == "" {
				return cliConfig{}, fmt.Errorf("ingest: --summary-schema-out: value must be non-empty")
			}
			continue
		}
		if strings.HasPrefix(arg, "--summary-schema-digest=") {
			cfg.summarySchemaDigest = strings.TrimPrefix(arg, "--summary-schema-digest=")
			if cfg.summarySchemaDigest == "" {
				return cliConfig{}, fmt.Errorf("ingest: --summary-schema-digest: value must be non-empty")
			}
			continue
		}
		if strings.HasPrefix(arg, "--summary-schema-index=") {
			cfg.summarySchemaIndex = strings.TrimPrefix(arg, "--summary-schema-index=")
			if cfg.summarySchemaIndex == "" {
				return cliConfig{}, fmt.Errorf("ingest: --summary-schema-index: value must be non-empty")
			}
			continue
		}
		switch arg {
		case "--input-dir":
			cfg.inputDir = nextArg(args, &i)
		case "--rates":
			cfg.ratesPath = nextArg(args, &i)
		case "--output":
			cfg.outputPath = nextArg(args, &i)
		case "--rejects":
			cfg.rejectsPath = nextArg(args, &i)
		case "--session-gap":
			cfg.sessionGap = atoiOrError(nextArg(args, &i), "--session-gap")
		case "--watermark-lag":
			cfg.watermarkLag = atoiOrError(nextArg(args, &i), "--watermark-lag")
		case "--state-in":
			cfg.stateIn = nextArg(args, &i)
		case "--state-out":
			cfg.stateOut = nextArg(args, &i)
		case "--pending-ttl":
			cfg.pendingTTL = atoiOrError(nextArg(args, &i), "--pending-ttl")
		case "--max-open-sessions":
			cfg.maxOpenSessions = atoiOrError(nextArg(args, &i), "--max-open-sessions")
		case "--audit-log":
			cfg.auditLog = nextArg(args, &i)
		case "--audit-log-digest":
			cfg.auditLogDigest = nextArg(args, &i)
		case "--audit-log-rotate-bytes":
			cfg.auditLogRotateBytes = atoiOrError(nextArg(args, &i), "--audit-log-rotate-bytes")
		case "--rates-strict":
			cfg.ratesStrict = true
		case "--rates-max-staleness":
			cfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), "--rates-max-staleness")
		case "--ingest-id":
			cfg.ingestID = nextArg(args, &i)
