    19	func (m Money) MarshalJSON() ([]byte, error) {
    20		return []byte(m.String()), nil
    21	}
    22	
    23	func (m Money) String() string {
    24		f := float64(m)
    25		abs := math.Abs(f)
    26		cents := int64(math.Floor(abs*100.0 + 0.5))
    27		neg := f < 0 && cents != 0
    28		dollars := cents / 100
    29		rem := cents % 100
    30		s := fmt.Sprintf("%d.%02d", dollars, rem)
    31		if neg {
    32			s = "-" + s
    33		}
    34		return s
    35	}
