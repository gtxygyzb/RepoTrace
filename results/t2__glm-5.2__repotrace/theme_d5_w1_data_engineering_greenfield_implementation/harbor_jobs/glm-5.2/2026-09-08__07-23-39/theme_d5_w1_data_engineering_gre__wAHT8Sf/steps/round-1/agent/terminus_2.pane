   355						winner = idx
   356						tiebreak = false
   357					} else if cts == wts && arrivalLess(candidates[idx].ev, candidates[winner].ev) {
   358						winner = idx
   359						tiebreak = true
   360					}
   361				}
   362			}
   363			if cfg.dedupPolicy == "lex-largest-ts" {
   364				wts := candidates[winner].ctx.TSString()
   365				for _, idx := range idxs {
   366					if idx != winner && candidates[idx].ctx.TSString() == wts {
   367						tiebreak = true
   368						break
   369					}
   370				}
   371			}
   372			winners[id] = winner
   373			winnerSet[winner] = true
   374			sameShard := true
   375			for _, idx := range idxs {
   376				if candidates[idx].ev.Shard != candidates[winner].ev.Shard {
   377					sameShard = false
   378					break
