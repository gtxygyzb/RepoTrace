   124	func fileDigest(path string) (string, int64, error) {
   125		data, err := os.ReadFile(path)
   126		if err != nil {
   127			return "", 0, err
   128		}
   129		return sha256Hex(data), int64(len(data)), nil
   130	}
   131	
   132	func atomicWriteFile(path string, data []byte) error {
   133		tmp := path + ".tmp"
   134		if err := os.WriteFile(tmp, data, 0644); err != nil {
   135			return err
   136		}
   137		if err := os.Rename(tmp, path); err != nil {
   138			_ = os.Remove(tmp)
   139			return err
   140		}
   141		return nil
   142	}
   143	
   144	func parentDirExists(path string) bool {
   145		dir := filepath.Dir(path)
   146		if dir == "." || dir == "" {
   147			return true
   148		}
   149		info, err := os.Stat(dir)
   150		if err != nil {
   151			return false
   152		}
   153		return info.IsDir()
   154	}
   155	
   156	func manifestFileOutputFor(path string) (*manifestFileOutput, error) {
   157		h, b, err := fileDigest(path)
   158		if err != nil {
   159			return nil, err
   160		}
