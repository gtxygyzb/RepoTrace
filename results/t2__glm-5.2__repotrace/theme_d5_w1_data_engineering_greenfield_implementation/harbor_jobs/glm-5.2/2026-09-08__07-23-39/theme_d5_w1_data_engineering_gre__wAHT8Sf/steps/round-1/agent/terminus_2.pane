    49	
    50	func parseArgs(args []string) (cfg cliConfig, err error) {
    51		defer func() {
    52			if r := recover(); r != nil {
    53				cfg = cliConfig{}
    54				err = fmt.Errorf("%v", r)
    55			}
    56		}()
    57		cfg = cliConfig{
    58			sessionGap:        600,
    59			watermarkLag:      300,
    60			pendingTTL:        86400,
    61			maxOpenSessions:   100000,
    62			ratesMaxStaleness: 0,
    63		}
    64		required := map[string]bool{
    65			"--input-dir": false,
    66			"--rates":     false,
    67			"--output":    false,
    68			"--rejects":   false,
    69		}
    70		if len(args) > 0 && args[0] == "ingest" {
    71			args = args[1:]
    72		}
    73		for i := 0; i < len(args); i++ {
    74			arg := args[i]
    75			switch arg {
    76			case "--input-dir":
    77				cfg.inputDir = nextArg(args, &i)
    78			case "--rates":
    79				cfg.ratesPath = nextArg(args, &i)
    80			case "--output":
    81				cfg.outputPath = nextArg(args, &i)
    82			case "--rejects":
    83				cfg.rejectsPath = nextArg(args, &i)
    84			case "--session-gap":
    85				cfg.sessionGap = atoiOrError(nextArg(args, &i), "--session-gap")
    86			case "--watermark-lag":
    87				cfg.watermarkLag = atoiOrError(nextArg(args, &i), "--watermark-lag")
    88			case "--state-in":
    89				cfg.stateIn = nextArg(args, &i)
    90			case "--state-out":
    91				cfg.stateOut = nextArg(args, &i)
    92			case "--pending-ttl":
    93				cfg.pendingTTL = atoiOrError(nextArg(args, &i), "--pending-ttl")
    94			case "--max-open-sessions":
    95				cfg.maxOpenSessions = atoiOrError(nextArg(args, &i), "--max-open-sessions")
    96			case "--audit-log":
    97				cfg.auditLog = nextArg(args, &i)
    98			case "--audit-log-digest":
    99				cfg.auditLogDigest = nextArg(args, &i)
   100			case "--rates-strict":
   101				cfg.ratesStrict = true
   102			case "--rates-max-staleness":
   103				cfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), "--rates-max-staleness")
   104			case "--ingest-id":
   105				cfg.ingestID = nextArg(args, &i)
   106				cfg.ingestIDSet = true
   107			case "--out-parquet-manifest":
   108				cfg.outManifest = nextArg(args, &i)
   109			case "--manifest-signature":
   110				cfg.manifestSignature = nextArg(args, &i)
   111			default:
   112				return cliConfig{}, fmt.Errorf("ingest: unknown flag %s", arg)
   113			}
   114			if strings.HasPrefix(arg, "--") && arg != "--rates-strict" {
   115				if _, ok := required[arg]; ok {
   116					required[arg] = true
   117				}
   118			}
   119		}
   120		for k, ok := range required {
   121			if !ok {
   122				return cliConfig{}, fmt.Errorf("ingest: %s is required", k)
   123			}
   124		}
   125		if cfg.ingestIDSet {
   126			if len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {
   127				return cliConfig{}, fmt.Errorf("ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)")
   128			}
   129		}
   130		if cfg.outManifest == "" && cfg.manifestSignature != "" {
   131			return cliConfig{}, fmt.Errorf("ingest: --manifest-signature requires --out-parquet-manifest")
   132		}
   133		if cfg.outManifest != "" && !parentDirExists(cfg.outManifest) {
   134			return cliConfig{}, fmt.Errorf("ingest --out-parquet-manifest parent directory does not exist")
   135		}
   136		if cfg.manifestSignature != "" && !parentDirExists(cfg.manifestSignature) {
   137			return cliConfig{}, fmt.Errorf("ingest --manifest-signature parent directory does not exist")
   138		}
   139		return cfg, nil
   140	}
   141	
   142	func nextArg(args []string, i *int) string {
   143		if *i+1 >= len(args) {
   144			panic(fmt.Errorf("ingest: missing value for %s", args[*i]))
   145		}
   146		*i++
   147		return args[*i]
   148	}
   149	
   150	func atoiOrError(s, flag string) int {
   151		n, err := strconv.Atoi(s)
   152		if err != nil {
   153			panic(fmt.Errorf("ingest: invalid integer for %s: %s", flag, s))
   154		}
   155		return n
   156	}
