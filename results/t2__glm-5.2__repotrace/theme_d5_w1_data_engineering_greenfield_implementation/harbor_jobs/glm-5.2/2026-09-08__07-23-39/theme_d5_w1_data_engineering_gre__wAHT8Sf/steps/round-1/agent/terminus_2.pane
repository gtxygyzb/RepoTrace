[?2004lpackage main

import (
	"bytes"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"regexp"
	"sort"
	"strconv"
	"strings"
	"time"
)

var ingestIDRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]*$`)

type cliConfig struct {
	inputDir            string
	ratesPath           string
	outputPath          string
	rejectsPath         string
	sessionGap          int
	watermarkLag        int
	stateIn             string
	stateOut            string
	pendingTTL          int
	maxOpenSessions     int
	auditLog            string
	auditLogDigest      string
	auditLogRotateBytes int
	ratesStrict         bool
	ratesMaxStaleness   int
	ingestID            string
	ingestIDSet         bool
	outManifest         string
	manifestSignature   string
	dedupPolicy         string
	dedupPolicySet      bool
	strictLateAudit     bool
