   195	
   196	func loadRates(path string) (*RateTable, error) {
   197		data, err := os.ReadFile(path)
   198		if err != nil {
   199			return nil, err
   200		}
   201		var top map[string]json.RawMessage
   202		if err := json.Unmarshal(data, &top); err != nil {
   203			return nil, fmt.Errorf("rates file is not valid json: %w", err)
   204		}
   205		rt := newRateTable()
   206		daysRaw, ok := top["days"]
   207		if !ok {
   208			return nil, errors.New("fx days invalid")
   209		}
   210		var days map[string]json.RawMessage
   211		if err := json.Unmarshal(daysRaw, &days); err != nil {
   212			return nil, errors.New("fx days invalid")
   213		}
   214		if len(days) == 0 {
   215			return nil, errors.New("fx days invalid")
   216		}
   217		for _, day := range sortedKeys(days) {
   218			if !isStrictDate(day) || !isDate(day) {
   219				return nil, fmt.Errorf("ingest: rates.json: invalid day key %s", day)
   220			}
   221			var currencies map[string]json.RawMessage
   222			if err := json.Unmarshal(days[day], &currencies); err != nil {
   223				return nil, errors.New("fx days invalid")
   224			}
   225			for _, currency := range sortedKeys(currencies) {
   226				f, err := parseRateNumber(currencies[currency])
   227				if err != nil {
   228					return nil, fmt.Errorf("ingest: rates.json: non-numeric rate for %s/%s", day, currency)
   229				}
   230				if rt.days[day] == nil {
   231					rt.days[day] = map[string]float64{}
   232				}
   233				rt.days[day][currency] = f
   234				rt.known[currency] = true
   235			}
   236		}
   237		baseRaw, baseOk := top["base"]
   238		if !baseOk {
   239			return nil, errors.New("ingest: rates.json: base required")
   240		}
   241		var base string
   242		if err := json.Unmarshal(baseRaw, &base); err != nil || base == "" {
   243			return nil, errors.New("ingest: rates.json: base required")
   244		}
   245		rt.base = base
   246		if base != "USD" {
   247			return nil, errors.New("fx base must be USD")
   248		}
   249		for _, day := range sortedKeys(rt.days) {
   250			r, ok := rt.days[day][base]
   251			if !ok || r != 1.0 {
   252				return nil, fmt.Errorf("ingest: rates.json: base currency %s must have rate 1.0 on day %s", base, day)
   253			}
   254		}
   255		return rt, nil
   256	}
