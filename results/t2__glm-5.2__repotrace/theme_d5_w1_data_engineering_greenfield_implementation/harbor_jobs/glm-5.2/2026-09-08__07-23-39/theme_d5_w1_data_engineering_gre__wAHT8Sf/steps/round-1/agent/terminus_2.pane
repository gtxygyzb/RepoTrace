   361						lateCutoff = ptrCutoff(formatCutoffObject(cutoff))
   362						if cfg.strictLateAudit {
   363							lag := cfg.watermarkLag
   364							lateBy := int(lateCutoff.EpochSeconds - int(epochSeconds(ev.TS)))
