	invalidReasons := map[string]int{}
	duplicateReasons := map[string]int{"same_run": 0, "cross_run": 0}
	fxFallbackStats := map[string]int{"0": 0}
	shardAccepted := map[string]int{}
	var minTs, maxTs time.Time
	hasMin, hasMax := false, false
	var watermark time.Time
	hasWatermark := false
	if st != nil {
		watermark = st.maxTs
		hasWatermark = st.hasMax
	}

	type candidate struct {
		raw       rawEvent
		ctx       *eventContext
		ev        *Event
		duplicate bool
	}
	var candidates []candidate
	var auditEntries []auditLogEntry

	// First pass: validation, watermark admission, cross-run dedup, and watermark advancement.
