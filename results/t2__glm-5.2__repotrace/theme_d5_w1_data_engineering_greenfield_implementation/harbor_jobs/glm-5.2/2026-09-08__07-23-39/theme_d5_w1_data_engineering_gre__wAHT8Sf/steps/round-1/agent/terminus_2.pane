   576	func readInputEvents(inputDir string) ([]rawEvent, error) {
   577	  info, err := os.Stat(inputDir)
   578	  if err != nil {
   579	    return nil, err
   580	  }
   581	  if !info.IsDir() {
   582	    return nil, errors.New("input-dir is not a directory")
   583	  }
   584	  entries, err := os.ReadDir(inputDir)
   585	  if err != nil {
   586	    return nil, err
   587	  }
   588	  var files []string
   589	  for _, e := range entries {
   590	    if e.IsDir() || !e.Type().IsRegular() {
   591	      continue
   592	    }
   593	    files = append(files, e.Name())
   594	  }
   595	  sort.Strings(files)
   596	  var events []rawEvent
   597	  for _, name := range files {
   598	    data, err := os.ReadFile(filepath.Join(inputDir, name))
   599	    if err != nil {
   600	      return nil, err
   601	    }
   602	    lineNo := 0
   603	    for _, line := range bytes.Split(data, []byte{'\n'}) {
   604	      lineNo++
   605	      trimmed := bytes.TrimSpace(line)
   606	      if len(trimmed) == 0 {
   607	        continue
   608	      }
   609	      var obj map[string]json.RawMessage
   610	      if err := json.Unmarshal(trimmed, &obj); err != nil {
   611	        continue
   612	      }
   613	      events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: json.RawMessage(trimmed), Obj: obj})
   614	    }
   615	  }
   616	  return events, nil
   617	}
   618	
   619	func newContext(raw rawEvent) *eventContext {
   620	  ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}
   621	  ctx.ID = rawStringPtr(raw.Obj, "id")
   622	  ctx.TS = rawStringPtr(raw.Obj, "ts")
   623	  ctx.Type = rawStringPtr(raw.Obj, "type")
   624	  return ctx
   625	}
   626	
   627	func parseEvent(ctx *eventContext, rt *RateTable) (*Event, string) {
   628	  obj := ctx.Obj
   629	  raw, ok := obj["v"]
   630	  if !ok {
   631	    return nil, "schema_version"
   632	  }
   633	  var v int
   634	  if err := json.Unmarshal(raw, &v); err != nil {
   635	    return nil, "schema_version"
   636	  }
   637	  if v != 1 && v != 2 {
   638	    return nil, "schema_version"
   639	  }
   640	  id, idOk, _ := getRawString(obj, "id")
   641	  if !idOk || id == "" {
   642	    return nil, "missing_id"
   643	  }
   644	  tsStr, tsOk, _ := getRawString(obj, "ts")
   645	  if !tsOk {
   646	    return nil, "missing_ts"
   647	  }
   648	  t, err := parseTime(tsStr)
   649	  if err != nil {
   650	    return nil, "bad_ts"
   651	  }
   652	  typeStr, typeOk, _ := getRawString(obj, "type")
   653	  if !typeOk {
   654	    return nil, "missing_type"
   655	  }
   656	  switch typeStr {
   657	  case "purchase", "refund", "chargeback", "login", "signup":
   658	  default:
   659	    return nil, "bad_type"
   660	  }
   661	  user, userOk, _ := getRawString(obj, "user_id")
   662	  if !userOk || user == "" {
   663	    return nil, "missing_user"
   664	  }
   665	  ev := &Event{ID: id, Type: typeStr, TS: t, UserID: user, Raw: ctx.Raw, Shard: ctx.Shard, Line: ctx.Line}
   666	  switch typeStr {
   667	  case "purchase", "refund":
   668	    var amount float64
   669	    if v == 1 {
   670	      raw, present := obj["amount"]
   671	      if !present {
   672	        return nil, "missing_amount"
   673	      }
   674	      var f float64
   675	      if err := json.Unmarshal(raw, &f); err != nil {
   676	        return nil, "bad_amount"
   677	      }
   678	      if !isFinite(f) || f < 0 {
   679	        return nil, "bad_amount"
   680	      }
   681	      amount = f
   682	    } else {
   683	      raw, present := obj["amount_cents"]
   684	      if !present {
   685	        return nil, "missing_amount"
   686	      }
   687	      n, err := getJSONInt(raw)
   688	      if err != nil || n < 0 {
   689	        return nil, "bad_amount"
   690	      }
   691	      amount = float64(n) / 100.0
   692	    }
   693	    cur, curOk, curPresent := getRawString(obj, "currency")
   694	    if !curPresent {
   695	      return nil, "missing_currency"
   696	    }
   697	    if !curOk || cur == "" {
   698	      return nil, "bad_currency"
   699	    }
   700	    r, ok := rt.rate(dateKey(t), cur)
   701	    if !ok {
   702	      return nil, "fx_lookup"
   703	    }
   704	    usd := amount * r
   705	    if typeStr == "refund" {
   706	      usd = -usd
   707	    }
   708	    ev.Amount = amount
   709	    ev.Currency = cur
   710	    ev.USD = roundMoney(usd)
   711	  case "chargeback":
   712	    ref, refOk, refPresent := getRawString(obj, "ref_id")
   713	    if !refPresent || !refOk || ref == "" {
   714	      return nil, "missing_ref_id"
   715	    }
   716	    ev.RefID = ref
   717	    ev.USD = 0
   718	  case "login", "signup":
   719	    ev.USD = 0
   720	  }
   721	  return ev, ""
   722	}
   723	
   724	type stateFileIn struct {
   725	  Version          int                    `json:"version"`
   726	  Watermark        stateWatermarkOut      `json:"watermark"`
   727	  SeenIDs          []string               `json:"seen_ids"`
   728	  PendingPurchases []statePendingOut     `json:"pending_purchases"`
   729	  OpenSessions     []stateOpenSessionOut  `json:"open_sessions"`
   730	  RunIndex         int                    `json:"run_index"`
   731	}
   732	
   733	func loadState(path string) (*loadedState, error) {
   734	  data, err := os.ReadFile(path)
   735	  if err != nil {
   736	    return nil, err
   737	  }
   738	  var sin stateFileIn
   739	  if err := json.Unmarshal(data, &sin); err != nil {
   740	    return nil, err
   741	  }
   742	  st := &loadedState{
   743	    version:      sin.Version,
   744	    seenIds:      map[string]bool{},
   745	    runIndex:     sin.RunIndex,
   746	    openSessions: map[string]carriedSession{},
   747	  }
   748	  if sin.Watermark.MaxTS != nil {
   749	    t, err := parseTime(*sin.Watermark.MaxTS)
   750	    if err != nil {
   751	      return nil, fmt.Errorf("bad state watermark: %w", err)
   752	    }
   753	    st.hasMax = true
   754	    st.maxTs = t
   755	  }
   756	  for _, id := range sin.SeenIDs {
   757	    st.seenIds[id] = true
   758	  }
   759	  for _, p := range sin.PendingPurchases {
   760	    t, err := parseTime(p.TS)
   761	    if err != nil {
   762	      return nil, fmt.Errorf("bad pending purchase ts: %w", err)
   763	    }
   764	    st.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, user: p.User, usd: float64(p.USD), originRun: p.OriginRun})
   765	  }
   766	  for _, s := range sin.OpenSessions {
   767	    last, err := parseTime(s.LastTS)
   768	    if err != nil {
   769	      return nil, fmt.Errorf("bad open session last_ts: %w", err)
   770	    }
   771	    start, err := parseTime(s.StartTS)
   772	    if err != nil {
   773	      return nil, fmt.Errorf("bad open session start_ts: %w", err)
   774	    }
   775	    st.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}
   776	  }
   777	  st.carryInPending = len(st.pending)
   778	  st.carryInOpenSessions = len(st.openSessions)
   779	  return st, nil
   780	}
