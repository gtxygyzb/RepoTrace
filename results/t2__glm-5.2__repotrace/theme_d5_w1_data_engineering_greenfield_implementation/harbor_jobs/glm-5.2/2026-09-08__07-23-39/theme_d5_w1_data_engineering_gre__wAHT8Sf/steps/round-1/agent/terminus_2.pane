    53	func parseTime(s string) (time.Time, error) {
    54		s = strings.TrimSpace(s)
    55		if strings.HasSuffix(s, "Z") {
    56			if t, err := time.Parse("2006-01-02T15:04:05Z", s); err == nil {
    57				return t.UTC(), nil
    58			}
    59			if t, err := time.Parse("2006-01-02T15:04:05.000000000Z", s); err == nil {
    60				return t.UTC(), nil
    61			}
    62		}
    63		if t, err := time.Parse(time.RFC3339Nano, s); err == nil {
    64			return t.UTC(), nil
    65		}
    66		if t, err := time.Parse(time.RFC3339, s); err == nil {
    67			return t.UTC(), nil
    68		}
    69		return time.Time{}, fmt.Errorf("bad timestamp: %s", s)
    70	}
    71	
    72	func formatTS(t time.Time) string {
    73		return t.UTC().Format("2006-01-02T15:04:05Z")
    74	}
    75	
    76	func epochSeconds(t time.Time) int64 {
    77		return t.UTC().Unix()
    78	}
    79	
    80	func formatCutoffObject(cutoff time.Time) cutoffObject {
    81		epoch := epochSeconds(cutoff)
    82		if epoch < 0 {
    83			epoch = 0
    84			cutoff = time.Unix(0, 0).UTC()
    85		}
    86		return cutoffObject{Value: formatTS(cutoff), EpochSeconds: int(epoch)}
    87	}
    88	
    89	func dateKey(t time.Time) string {
    90		return t.UTC().Format("2006-01-02")
    91	}
    92	
    93	func roundMoney(v float64) float64 {
    94		cents := int64(math.Floor(math.Abs(v)*100.0 + 0.5))
    95		if v < 0 && cents != 0 {
    96			return -float64(cents) / 100.0
    97		}
    98		return float64(cents) / 100.0
    99	}
   100	
   101	func isFinite(f float64) bool {
   102		return !math.IsNaN(f) && !math.IsInf(f, 0)
   103	}
   104	
   105	func isDate(s string) bool {
   106		if _, err := time.Parse("2006-01-02", s); err != nil {
   107			return false
   108		}
   109		return true
   110	}
   111	
   112	func sha256Hex(data []byte) string {
   113		sum := sha256.Sum256(data)
   114		return hex.EncodeToString(sum[:])
   115	}
   116	
   117	func sha256Short(h string) string {
   118		if len(h) < 12 {
   119			return h
   120		}
   121		return h[:12]
   122	}
   123	
   124	func fileDigest(path string) (string, int64, error) {
   125		data, err := os.ReadFile(path)
   126		if err != nil {
   127			return "", 0, err
   128		}
   129		return sha256Hex(data), int64(len(data)), nil
   130	}
   131	
   132	func atomicWriteFile(path string, data []byte) error {
   133		tmp := path + ".tmp"
   134		if err := os.WriteFile(tmp, data, 0644); err != nil {
   135			return err
   136		}
   137		if err := os.Rename(tmp, path); err != nil {
   138			_ = os.Remove(tmp)
   139			return err
   140		}
   141		return nil
   142	}
   143	
   144	func parentDirExists(path string) bool {
   145		dir := filepath.Dir(path)
   146		if dir == "." || dir == "" {
   147			return true
   148		}
   149		info, err := os.Stat(dir)
   150		if err != nil {
   151			return false
   152		}
   153		return info.IsDir()
   154	}
   155	
   156	func manifestFileOutputFor(path string) (*manifestFileOutput, error) {
   157		h, b, err := fileDigest(path)
   158		if err != nil {
   159			return nil, err
   160		}
   161		return &manifestFileOutput{
   162			Path:        filepath.Base(path),
   163			SHA256:      h,
   164			SHA256Short: sha256Short(h),
   165			Bytes:       b,
   166		}, nil
   167	}
