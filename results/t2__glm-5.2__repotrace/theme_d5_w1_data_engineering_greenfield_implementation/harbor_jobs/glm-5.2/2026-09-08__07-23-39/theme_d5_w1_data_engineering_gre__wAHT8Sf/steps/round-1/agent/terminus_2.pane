   158	func run(cfg cliConfig) error {
   159		ratesData, err := os.ReadFile(cfg.ratesPath)
   160		if err != nil {
   161			return fmt.Errorf("ingest: rates: %w", err)
   162		}
   163		ratesDigest := sha256Hex(ratesData)
   164		rt, err := loadRates(cfg.ratesPath)
   165		if err != nil {
   166			return err
   167		}
   168		var st *loadedState
   169		runIndex := 1
   170		if cfg.stateIn != "" {
   171			st, err = loadState(cfg.stateIn)
   172			if err != nil && !os.IsNotExist(err) {
   173				return err
   174			}
   175			if st != nil {
   176				runIndex = st.runIndex + 1
   177			}
   178		}
   179		events, shards, err := readInputEvents(cfg.inputDir)
   180		if err != nil {
   181			return err
   182		}
   183		seen := map[string]bool{}
   184		if st != nil {
   185			for k, v := range st.seenIds {
   186				seen[k] = v
   187			}
   188		}
   189		var pending []pendingEntry
   190		openSessions := map[string]carriedSession{}
   191		if st != nil {
   192			pending = append([]pendingEntry(nil), st.pending...)
   193			for k, v := range st.openSessions {
   194				openSessions[k] = v
   195			}
   196		}
   197		var rejects []Reject
   198		var auditEntries []auditLogEntry
   199		bucketCounts := map[string]int{"accepted": 0, "duplicate": 0, "invalid": 0, "late": 0, "unresolved_chargeback": 0}
   200		shardAccepted := map[string]int{}
   201		var minTs, maxTs time.Time
   202		hasMin, hasMax := false, false
   203		var watermark time.Time
   204		hasWatermark := false
   205		if st != nil {
   206			watermark = st.maxTs
   207			hasWatermark = st.hasMax
   208		}
   209		for _, raw := range events {
   210			ctx := newContext(raw)
   211			bucket := "invalid"
   212			reason := ""
   213			var ev *Event
   214			if raw.Invalid {
   215				bucket = "invalid"
   216				reason = "invalid_json"
   217			} else {
   218				ev, reason = parseEvent(ctx, rt, cfg.ratesStrict, cfg.ratesMaxStaleness)
   219				if ev != nil {
   220					if seen[ev.ID] {
   221						bucket = "duplicate"
   222						reason = "duplicate"
   223						ev = nil
   224					} else if ev.TS.Before(watermark) || ev.TS.Equal(watermark) {
   225						bucket = "late"
   226						reason = "late"
   227						ev = nil
   228					} else {
   229						bucket = "accepted"
   230						seen[ev.ID] = true
   231						shardAccepted[ev.Shard]++
   232						if !hasMin || ev.TS.Before(minTs) {
   233							minTs = ev.TS
   234							hasMin = true
   235						}
   236						if !hasMax || ev.TS.After(maxTs) {
   237							maxTs = ev.TS
   238							hasMax = true
   239						}
   240						if ev.TS.After(watermark) {
   241							watermark = ev.TS
   242							hasWatermark = true
   243						}
   244					}
   245				} else {
   246					bucket = "invalid"
   247				}
   248			}
   249			bucketCounts[bucket]++
   250			if bucket != "accepted" {
   251				rejects = append(rejects, Reject{Bucket: bucketCode(bucket), Event: raw.Raw})
   252			}
   253			auditEntries = append(auditEntries, auditLogEntry{
   254				Shard:  raw.Shard,
   255				Line:   raw.Line,
   256				ID:     ctx.IDStr(),
   257				TS:     ctx.TSString(),
   258				Type:   ctx.TypeString(),
   259				Bucket: bucket,
   260				Reason: reason,
