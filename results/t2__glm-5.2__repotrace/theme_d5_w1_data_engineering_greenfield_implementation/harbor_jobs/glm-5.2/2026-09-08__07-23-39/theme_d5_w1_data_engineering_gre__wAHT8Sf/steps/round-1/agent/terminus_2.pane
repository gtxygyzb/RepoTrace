   713		reason      string
   714		raw         rawJSON
   715		winner      bool
   716		winnerShard string
   717		winnerLine  int
   718	}
   719	
   720	func arrivalLess(a, b *Event) bool {
   721		if a.Shard != b.Shard {
   722			return a.Shard < b.Shard
   723		}
   724		return a.Line < b.Line
   725	}
   726	
   727	func buildRejects(records []rejectRecord, policy string) []byte {
   728		order := []string{"invalid", "late", "duplicate", "unresolved_chargeback"}
   729		var buf bytes.Buffer
   730		for _, bucket := range order {
   731			for _, r := range records {
   732				if r.bucket != bucket {
   733					continue
   734				}
   735				buf.Write(r.raw)
   736				if policy == "first-arrival" {
   737					buf.WriteByte('\t')
   738					if r.winner {
   739						buf.WriteString(r.winnerShard)
   740						buf.WriteByte('\t')
   741						buf.WriteString(strconv.Itoa(r.winnerLine))
   742					} else {
   743						buf.WriteString("-")
   744						buf.WriteByte('\t')
   745						buf.WriteString("-")
   746					}
   747				}
   748				buf.WriteByte('\n')
   749			}
   750		}
   751		return buf.Bytes()
   752	}
