 796 func statePendingOutList(pending []pendingEntry) []statePendingOut {
 797   out := make([]statePendingOut, 0, len(pending))
 798   for _, p := range pending {
 799     out = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), User: p.user, USD: Money(p.usd), OriginRun: p.originRun})
 800   }
 801   return out
 802 }
 803 
 804 func stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {
 805   out := make([]stateOpenSessionOut, 0, len(sessions))
 806   for _, s := range sessions {
 807     out = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})
 808   }
 809   return out
 810 }
 811 
 812 func sortedSeenIDs(seen map[string]bool) []string {
 813   ids := make([]string, 0, len(seen))
 814   for id := range seen {
 815     ids = append(ids, id)
 816   }
 817   sort.Strings(ids)
 818   return ids
 819 }
 820 
 821 func sortedPending(pending []pendingEntry) []pendingEntry {
 822   out := append([]pendingEntry(nil), pending...)
 823   sort.SliceStable(out, func(i, j int) bool {
 824     if out[i].ts.Equal(out[j].ts) {
 825       return out[i].id < out[j].id
 826     }
 827     return out[i].ts.Before(out[j].ts)
 828   })
 829   return out
 830 }
 831 
 832 func sortedOpenSessions(m map[string]carriedSession) []carriedSession {
 833   out := make([]carriedSession, 0, len(m))
 834   for _, s := range m {
 835     out = append(out, s)
 836   }
 837   sort.SliceStable(out, func(i, j int) bool {
 838     if out[i].lastTs.Equal(out[j].lastTs) {
 839       return out[i].user < out[j].user
 840     }
 841     return out[i].lastTs.Before(out[j].lastTs)
 842   })
 843   return out
 844 }
 845 
 846 func sortedCarriedSessions(m map[string]carriedSession) []carriedSession {
 847   return sortedOpenSessions(m)
 848 }
