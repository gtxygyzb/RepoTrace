   391		var rejectRecords []rejectRecord
   392		for i, c := range candidates {
   393			if c.ev == nil {
   394				r := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, raw: c.raw.Raw}
   395				rejectRecords = append(rejectRecords, r)
   396				continue
   397			}
   398			if winnerSet[i] {
   399				continue
   400			}
   401			r := rejectRecord{bucket: "duplicate", reason: "same_run", raw: c.raw.Raw}
   402			if cfg.dedupPolicy == "first-arrival" {
   403				r.winner = true
   404				r.winnerShard = candidates[winners[c.ev.ID]].ev.Shard
   405				r.winnerLine = candidates[winners[c.ev.ID]].ev.Line
   406			}
   407			rejectRecords = append(rejectRecords, r)
   408		}
