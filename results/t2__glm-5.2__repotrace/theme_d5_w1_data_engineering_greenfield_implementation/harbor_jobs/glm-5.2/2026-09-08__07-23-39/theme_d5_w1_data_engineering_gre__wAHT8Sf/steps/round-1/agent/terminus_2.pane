   235	func nextArg(args []string, i *int) string {
   236		if *i+1 >= len(args) {
   237			panic(fmt.Errorf("ingest: missing value for %s", args[*i]))
   238		}
   239		*i++
   240		return args[*i]
   241	}
   242	
   243	func atoiOrError(s, flag string) int {
   244		n, err := strconv.Atoi(s)
   245		if err != nil {
   246			panic(fmt.Errorf("ingest: invalid integer for %s: %s", flag, s))
   247		}
   248		return n
   249	}
   250	
   251	func ptrCutoff(c cutoffObject) *cutoffObject {
   252		return &c
   253	}
