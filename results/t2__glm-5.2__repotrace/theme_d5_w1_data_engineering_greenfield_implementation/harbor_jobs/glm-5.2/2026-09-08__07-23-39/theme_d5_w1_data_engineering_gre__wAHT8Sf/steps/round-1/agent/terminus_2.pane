    53	func parseArgs(args []string) (cfg cliConfig, err error) {
    54		defer func() {
    55			if r := recover(); r != nil {
    56				cfg = cliConfig{}
    57				err = fmt.Errorf("%v", r)
    58			}
    59		}()
    60		cfg = cliConfig{
    61			sessionGap:        600,
    62			watermarkLag:      300,
    63			pendingTTL:        86400,
    64			maxOpenSessions:   100000,
    65			ratesMaxStaleness: 0,
    66		}
    67		required := map[string]bool{
    68			"--input-dir": false,
    69			"--rates":     false,
    70			"--output":    false,
    71			"--rejects":   false,
    72		}
    73		if len(args) > 0 && args[0] == "ingest" {
    74			args = args[1:]
    75		}
    76		for i := 0; i < len(args); i++ {
    77			arg := args[i]
    78			switch arg {
    79			case "--input-dir":
    80				cfg.inputDir = nextArg(args, &i)
    81			case "--rates":
    82				cfg.ratesPath = nextArg(args, &i)
    83			case "--output":
    84				cfg.outputPath = nextArg(args, &i)
    85			case "--rejects":
    86				cfg.rejectsPath = nextArg(args, &i)
    87			case "--session-gap":
    88				cfg.sessionGap = atoiOrError(nextArg(args, &i), "--session-gap")
    89			case "--watermark-lag":
    90				cfg.watermarkLag = atoiOrError(nextArg(args, &i), "--watermark-lag")
    91			case "--state-in":
    92				cfg.stateIn = nextArg(args, &i)
    93			case "--state-out":
    94				cfg.stateOut = nextArg(args, &i)
    95			case "--pending-ttl":
    96				cfg.pendingTTL = atoiOrError(nextArg(args, &i), "--pending-ttl")
    97			case "--max-open-sessions":
    98				cfg.maxOpenSessions = atoiOrError(nextArg(args, &i), "--max-open-sessions")
    99			case "--audit-log":
   100				cfg.auditLog = nextArg(args, &i)
   101			case "--audit-log-digest":
   102				cfg.auditLogDigest = nextArg(args, &i)
   103			case "--rates-strict":
   104				cfg.ratesStrict = true
   105			case "--rates-max-staleness":
   106				cfg.ratesMaxStaleness = atoiOrError(nextArg(args, &i), "--rates-max-staleness")
   107			case "--ingest-id":
   108				cfg.ingestID = nextArg(args, &i)
   109				cfg.ingestIDSet = true
   110			case "--out-parquet-manifest":
   111				cfg.outManifest = nextArg(args, &i)
   112			case "--manifest-signature":
   113				cfg.manifestSignature = nextArg(args, &i)
   114			case "--dedup-policy":
   115				val := nextArg(args, &i)
   116				if val != "first-arrival" && val != "lex-largest-ts" {
   117					return cliConfig{}, fmt.Errorf("ingest: --dedup-policy: must be one of {first-arrival, lex-largest-ts}")
   118				}
   119				cfg.dedupPolicy = val
   120				cfg.dedupPolicySet = true
   121			default:
   122				return cliConfig{}, fmt.Errorf("ingest: unknown flag %s", arg)
   123			}
   124			if strings.HasPrefix(arg, "--") && arg != "--rates-strict" {
   125				if _, ok := required[arg]; ok {
   126					required[arg] = true
   127				}
   128			}
   129		}
   130		for k, ok := range required {
   131			if !ok {
   132				return cliConfig{}, fmt.Errorf("ingest: %s is required", k)
   133			}
   134		}
   135		if cfg.ingestIDSet {
   136			if len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {
   137				return cliConfig{}, fmt.Errorf("ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)")
   138			}
   139		}
   140		if cfg.outManifest == "" && cfg.manifestSignature != "" {
   141			return cliConfig{}, fmt.Errorf("ingest: --manifest-signature requires --out-parquet-manifest")
   142		}
   143		if cfg.outManifest != "" && !parentDirExists(cfg.outManifest) {
   144			return cliConfig{}, fmt.Errorf("ingest --out-parquet-manifest parent directory does not exist")
   145		}
   146		if cfg.manifestSignature != "" && !parentDirExists(cfg.manifestSignature) {
   147			return cliConfig{}, fmt.Errorf("ingest --manifest-signature parent directory does not exist")
   148		}
   149		if cfg.dedupPolicy == "" {
   150			cfg.dedupPolicy = "lex-largest-ts"
   151		}
   152		return cfg, nil
   153	}
