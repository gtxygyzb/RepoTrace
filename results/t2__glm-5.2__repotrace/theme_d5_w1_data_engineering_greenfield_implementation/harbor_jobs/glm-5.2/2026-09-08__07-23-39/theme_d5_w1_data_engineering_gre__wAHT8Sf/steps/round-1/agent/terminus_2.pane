    38	func writeOrderedValue(buf *bytes.Buffer, v any) {
    39		switch val := v.(type) {
    40		case orderedJSON:
    41			buf.WriteString(val.value.(string))
    42		case []orderedJSON:
    43			writeOrderedObject(buf, val)
    44		case orderedArray:
    45			writeOrderedArrayAny(buf, val)
    46		case []any:
    47			writeOrderedArrayAny(buf, val)
    48		case string:
    49			writeJSONString(buf, val)
    50		case int:
    51			fmt.Fprintf(buf, "%d", val)
    52		case int64:
    53			fmt.Fprintf(buf, "%d", val)
    54		case bool:
    55			if val {
    56				buf.WriteString("true")
    57			} else {
    58				buf.WriteString("false")
    59			}
    60		case nil:
    61			buf.WriteString("null")
    62		default:
    63			b, _ := json.Marshal(val)
    64			buf.Write(b)
    65		}
    66	}
    67	
    68	func writeOrderedObject(buf *bytes.Buffer, entries []orderedJSON) {
    69		buf.WriteByte('{')
    70		for i, e := range entries {
    71			if i > 0 {
    72				buf.WriteByte(',')
    73			}
    74			writeJSONString(buf, e.key)
    75			buf.WriteByte(':')
    76			writeOrderedValue(buf, e.value)
    77		}
    78		buf.WriteByte('}')
    79	}
    80	
    81	func writeOrderedArrayAny(buf *bytes.Buffer, arr []any) {
    82		buf.WriteByte('[')
    83		for i, v := range arr {
    84			if i > 0 {
    85				buf.WriteByte(',')
    86			}
    87			writeOrderedValue(buf, v)
    88		}
    89		buf.WriteByte(']')
    90	}
    91	
    92	func writeJSONString(buf *bytes.Buffer, s string) {
    93		b, _ := json.Marshal(s)
    94		buf.Write(b)
    95	}
    96	
    97	func writeOrderedIndent(buf *bytes.Buffer, v any, indent int) {
    98		writeOrderedIndentValue(buf, v, indent)
    99	}
   100	
   101	func writeOrderedIndentValue(buf *bytes.Buffer, v any, indent int) {
   102		switch val := v.(type) {
   103		case []orderedJSON:
   104			writeOrderedIndentObject(buf, val, indent)
   105		case orderedArray:
   106			writeOrderedIndentArrayAny(buf, val, indent)
   107		case []any:
   108			writeOrderedIndentArrayAny(buf, val, indent)
   109		case string:
   110			writeJSONString(buf, val)
   111		case int:
   112			fmt.Fprintf(buf, "%d", val)
   113		case int64:
   114			fmt.Fprintf(buf, "%d", val)
   115		case bool:
   116			if val {
   117				buf.WriteString("true")
   118			} else {
   119				buf.WriteString("false")
   120			}
   121		case nil:
   122			buf.WriteString("null")
   123		case orderedJSON:
   124			writeOrderedIndentValue(buf, val.value, indent)
   125		default:
   126			b, _ := json.Marshal(val)
   127			buf.Write(b)
   128		}
   129	}
   130	
   131	func writeOrderedIndentObject(buf *bytes.Buffer, entries []orderedJSON, indent int) {
   132		if len(entries) == 0 {
   133			buf.WriteString("{}")
   134			return
   135		}
   136		buf.WriteByte('{')
   137		buf.WriteByte('\n')
   138		for i, e := range entries {
   139			writeIndent(buf, indent+1)
   140			writeJSONString(buf, e.key)
   141			buf.WriteString(": ")
   142			writeOrderedIndentValue(buf, e.value, indent+1)
   143			if i < len(entries)-1 {
   144				buf.WriteByte(',')
   145			}
   146			buf.WriteByte('\n')
   147		}
   148		writeIndent(buf, indent)
   149		buf.WriteByte('}')
   150	}
   151	
   152	func writeOrderedIndentArrayAny(buf *bytes.Buffer, arr []any, indent int) {
   153		if len(arr) == 0 {
   154			buf.WriteString("[]")
   155			return
   156		}
   157		buf.WriteByte('[')
   158		buf.WriteByte('\n')
   159		for i, v := range arr {
   160			writeIndent(buf, indent+1)
   161			writeOrderedIndentValue(buf, v, indent+1)
   162			if i < len(arr)-1 {
   163				buf.WriteByte(',')
   164			}
   165			buf.WriteByte('\n')
   166		}
   167		writeIndent(buf, indent)
   168		buf.WriteByte(']')
   169	}
