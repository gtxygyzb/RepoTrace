    85	func parseRateNumber(raw json.RawMessage) (float64, error) {
    86		if bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
    87			return 0, errors.New("non-numeric rate")
    88		}
    89		var f float64
    90		if err := json.Unmarshal(raw, &f); err != nil {
    91			return 0, errors.New("non-numeric rate")
    92		}
    93		return f, nil
    94	}
    95	
    96	func sortedKeys[T any](m map[string]T) []string {
    97		keys := make([]string, 0, len(m))
    98		for k := range m {
    99			keys = append(keys, k)
   100		}
   101		sort.Strings(keys)
   102		return keys
   103	}
   104	
   105	func isStrictDate(s string) bool {
   106		if len(s) != 10 {
   107			return false
   108		}
   109		for i, c := range s {
   110			if i == 4 || i == 7 {
   111				if c != '-' {
