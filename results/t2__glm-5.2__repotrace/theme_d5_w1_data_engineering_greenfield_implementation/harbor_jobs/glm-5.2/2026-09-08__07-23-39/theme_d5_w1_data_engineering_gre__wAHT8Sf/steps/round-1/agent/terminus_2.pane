   427	type stateFileIn struct {
   428		Version          int                   `json:"version"`
   429		Watermark        stateWatermarkOut     `json:"watermark"`
   430		SeenIDs          []string              `json:"seen_ids"`
   431		PendingPurchases []statePendingOut     `json:"pending_purchases"`
   432		OpenSessions     []stateOpenSessionOut `json:"open_sessions"`
   433		RunIndex         int                   `json:"run_index"`
   434	}
   435	
   436	func loadState(path string, stateStrict bool) (*loadedState, error) {
   437		data, err := os.ReadFile(path)
   438		if err != nil {
   439			return nil, err
   440		}
   441		var sin stateFileIn
   442		if err := json.Unmarshal(data, &sin); err != nil {
   443			return nil, err
   444		}
   445		st := &loadedState{
   446			version:      sin.Version,
   447			seenIds:      map[string]bool{},
   448			runIndex:     sin.RunIndex,
   449			openSessions: map[string]carriedSession{},
   450		}
   451		if sin.Watermark.MaxTS != nil {
   452			t, err := parseTime(*sin.Watermark.MaxTS)
   453			if err != nil {
   454				return nil, fmt.Errorf("bad state watermark: %w", err)
   455			}
   456			st.hasMax = true
   457			st.maxTs = t
   458		}
   459		for _, id := range sin.SeenIDs {
   460			st.seenIds[id] = true
   461		}
   462		for _, p := range sin.PendingPurchases {
   463			t, err := parseTime(p.TS)
   464			if err != nil {
   465				return nil, fmt.Errorf("bad pending purchase ts: %w", err)
   466			}
   467			if stateStrict && !p.firstSeenEpochSet {
   468				return nil, fmt.Errorf("ingest: --state-strict: state pending entry missing first_seen_epoch")
   469			}
   470			st.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, firstSeenEpoch: int(epochSeconds(t)), user: p.User, usd: float64(p.USD), originRun: p.OriginRun})
   471		}
   472		for _, s := range sin.OpenSessions {
   473			last, err := parseTime(s.LastTS)
   474			if err != nil {
   475				return nil, fmt.Errorf("bad open session last_ts: %w", err)
   476			}
   477			start, err := parseTime(s.StartTS)
   478			if err != nil {
   479				return nil, fmt.Errorf("bad open session start_ts: %w", err)
   480			}
   481			st.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}
   482		}
   483		st.carryInPending = len(st.pending)
   484		st.carryInOpenSessions = len(st.openSessions)
   485		return st, nil
   486	}
   487	
   488	func buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {
   489		out := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}
   490		if hasCurrentMax {
   491			s := formatTS(currentMax)
   492			out.Watermark.MaxTS = &s
   493		} else if st != nil && st.hasMax {
   494			s := formatTS(st.maxTs)
   495			out.Watermark.MaxTS = &s
   496		}
   497		b, _ := json.MarshalIndent(out, "", "  ")
   498		b = append(b, '\n')
   499		return b
   500	}
   501	
   502	func statePendingOutList(pending []pendingEntry) []statePendingOut {
   503		out := make([]statePendingOut, 0, len(pending))
   504		for _, p := range pending {
   505			out = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), FirstSeenEpoch: p.firstSeenEpoch, User: p.user, USD: Money(p.usd), OriginRun: p.originRun})
   506		}
   507		return out
   508	}
