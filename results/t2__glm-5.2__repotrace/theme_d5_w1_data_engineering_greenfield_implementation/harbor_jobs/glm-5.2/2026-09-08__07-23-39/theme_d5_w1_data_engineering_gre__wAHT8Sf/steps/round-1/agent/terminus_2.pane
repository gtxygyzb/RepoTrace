   263		info, err := os.Stat(inputDir)
   264		if err != nil {
   265			return nil, err
   266		}
   267		if !info.IsDir() {
   268			return nil, errors.New("input-dir is not a directory")
   269		}
   270		entries, err := os.ReadDir(inputDir)
   271		if err != nil {
   272			return nil, err
   273		}
   274		var files []string
   275		for _, e := range entries {
   276			if e.IsDir() || !e.Type().IsRegular() {
   277				continue
   278			}
   279			files = append(files, e.Name())
   280		}
   281		sort.Strings(files)
   282		var events []rawEvent
   283		for _, name := range files {
   284			data, err := os.ReadFile(filepath.Join(inputDir, name))
   285			if err != nil {
   286				return nil, err
   287			}
   288			lineNo := 0
   289			for _, line := range bytes.Split(data, []byte{'\n'}) {
   290				lineNo++
   291				trimmed := bytes.TrimSpace(line)
   292				if len(trimmed) == 0 {
   293					continue
   294				}
   295				var obj map[string]json.RawMessage
   296				if err := json.Unmarshal(trimmed, &obj); err != nil {
   297					continue
   298				}
   299				events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: json.RawMessage(trimmed), Obj: obj})
   300			}
   301		}
   302		return events, nil
   303	}
