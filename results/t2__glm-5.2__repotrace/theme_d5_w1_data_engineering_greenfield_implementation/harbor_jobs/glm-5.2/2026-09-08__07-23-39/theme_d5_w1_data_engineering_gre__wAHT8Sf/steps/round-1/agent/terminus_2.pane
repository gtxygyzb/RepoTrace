    89	func buildRunProvenance(cfg cliConfig, shards []inputShardInfo) []orderedJSON {
    90		entries := []orderedJSON{
    91			{key: "schema_version", value: runProvenanceSchemaVersion},
    92			{key: "tool_version", value: toolVersion},
    93			{key: "flags", value: buildRunProvenanceFlags(cfg)},
    94			{key: "inputs_fingerprint", value: inputsFingerprint(shards)},
    95			{key: "shard_count", value: len(shards)},
    96		}
    97		if cfg.runProvenanceStrict {
    98			entries = append(entries,
    99				orderedJSON{key: "argv_sha256", value: argvSHA256(os.Args[1:])},
   100				orderedJSON{key: "env_fingerprint", value: envFingerprint()},
   101			)
   102		}
   103		return entries
   104	}
