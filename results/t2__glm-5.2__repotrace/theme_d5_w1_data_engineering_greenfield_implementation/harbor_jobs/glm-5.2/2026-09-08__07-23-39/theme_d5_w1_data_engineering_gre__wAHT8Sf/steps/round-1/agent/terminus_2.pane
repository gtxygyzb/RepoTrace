[?2004lfunc readInputEvents(inputDir string) ([]rawEvent, error) {
  info, err := os.Stat(inputDir)
  if err != nil {
    return nil, err
  }
  if !info.IsDir() {
    return nil, errors.New("input-dir is not a directory")
  }
  entries, err := os.ReadDir(inputDir)
  if err != nil {
    return nil, err
  }
  var files []string
  for _, e := range entries {
    if e.IsDir() || !e.Type().IsRegular() {
      continue
    }
    files = append(files, e.Name())
  }
  sort.Strings(files)
  var events []rawEvent
  for _, name := range files {
    data, err := os.ReadFile(filepath.Join(inputDir, name))
    if err != nil {
      return nil, err
    }
    lineNo := 0
    for _, line := range bytes.Split(data, []byte{'\n'}) {
      lineNo++
      trimmed := bytes.TrimSpace(line)
      if len(trimmed) == 0 {
        continue
      }
      var obj map[string]json.RawMessage
      if err := json.Unmarshal(trimmed, &obj); err != nil {
        continue
      }
      events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: json.RawMessage(trimmed), Obj: obj})
    }
  }
  return events, nil
}

func newContext(raw rawEvent) *eventContext {
  ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}
  ctx.ID = rawStringPtr(raw.Obj, "id")
  ctx.TS = rawStringPtr(raw.Obj, "ts")
  ctx.Type = rawStringPtr(raw.Obj, "type")
  return ctx
}

