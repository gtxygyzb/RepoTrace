   183				return cliConfig{}, fmt.Errorf("ingest: %s is required", k)
   184			}
   185		}
   186		if cfg.ingestIDSet {
   187			if len(cfg.ingestID) < 1 || len(cfg.ingestID) > 128 || !ingestIDRE.MatchString(cfg.ingestID) {
   188				return cliConfig{}, fmt.Errorf("ingest: --ingest-id: invalid (must match ^[A-Za-z0-9][A-Za-z0-9_.:-]*$, 1..128 chars)")
   189			}
   190		}
   191		if cfg.outManifest == "" && cfg.manifestSignature != "" {
   192			return cliConfig{}, fmt.Errorf("ingest: --manifest-signature requires --out-parquet-manifest")
   193		}
   194		if cfg.outManifest != "" && !parentDirExists(cfg.outManifest) {
   195			return cliConfig{}, fmt.Errorf("ingest --out-parquet-manifest parent directory does not exist")
   196		}
   197		if cfg.manifestSignature != "" && !parentDirExists(cfg.manifestSignature) {
   198			return cliConfig{}, fmt.Errorf("ingest --manifest-signature parent directory does not exist")
   199		}
   200		if cfg.strictLateAudit && cfg.auditLog == "" {
   201			return cliConfig{}, fmt.Errorf("ingest: --strict-late-audit requires --audit-log")
   202		}
   203		if cfg.auditLogRotateBytes != 0 {
   204			if cfg.auditLog == "" {
   205				return cliConfig{}, fmt.Errorf("ingest: --audit-log-rotate-bytes requires --audit-log")
   206			}
   207			if cfg.auditLogRotateBytes < 4096 {
   208				return cliConfig{}, fmt.Errorf("ingest: --audit-log-rotate-bytes: must be a positive integer >= 4096")
   209			}
   210		}
   211		if cfg.summarySchemaDigest != "" && cfg.summarySchemaOut == "" {
   212			return cliConfig{}, fmt.Errorf("ingest: --summary-schema-digest requires --summary-schema-out")
   213		}
   214		if cfg.summarySchemaStrict && cfg.summarySchemaOut == "" {
   215			return cliConfig{}, fmt.Errorf("ingest: --summary-schema-strict requires --summary-schema-out")
   216		}
   217		if cfg.summarySchemaIndex != "" && (cfg.summarySchemaOut == "" || cfg.summarySchemaDigest == "") {
   218			return cliConfig{}, fmt.Errorf("ingest: --summary-schema-index requires --summary-schema-out and --summary-schema-digest")
   219		}
   220		if cfg.summarySchemaOut != "" && !parentDirExists(cfg.summarySchemaOut) {
   221			return cliConfig{}, fmt.Errorf("ingest --summary-schema-out parent directory does not exist")
   222		}
   223		if cfg.summarySchemaDigest != "" && !parentDirExists(cfg.summarySchemaDigest) {
   224			return cliConfig{}, fmt.Errorf("ingest --summary-schema-digest parent directory does not exist")
   225		}
   226		if cfg.summarySchemaIndex != "" && !parentDirExists(cfg.summarySchemaIndex) {
   227			return cliConfig{}, fmt.Errorf("ingest --summary-schema-index parent directory does not exist")
   228		}
   229		if cfg.dedupPolicy == "" {
   230			cfg.dedupPolicy = "lex-largest-ts"
   231		}
   232		return cfg, nil
   233	}
