func writeRunProvenanceSidecars(cfg cliConfig, shards []inputShardInfo) error {
	if cfg.runProvenance == "" {
		return nil
	}
	provenance := buildRunProvenance(cfg, shards)
	data := marshalOrderedIndent(provenance)
	data = append(data, '\n')
	if err := atomicWriteFile(cfg.runProvenance, data); err != nil {
		return err
	}
	if cfg.runProvenanceDigest != "" {
		h, b, err := fileDigest(cfg.runProvenance)
		if err != nil {
			return err
		}
		digest := []orderedJSON{
			{key: "schema_version", value: runProvenanceDigestSchemaVersion},
			{key: "provenance_path", value: filepath.Base(cfg.runProvenance)},
			{key: "provenance_sha256", value: h},
			{key: "provenance_bytes", value: b},
			{key: "tool_version", value: toolVersion},
		}
		digestData := marshalOrderedIndent(digest)
		digestData = append(digestData, '\n')
		if err := atomicWriteFile(cfg.runProvenanceDigest, digestData); err != nil {
			return err
		}
	}
	return nil
}

func buildRunProvenance(cfg cliConfig, shards []inputShardInfo) []orderedJSON {
	entries := []orderedJSON{
		{key: "schema_version", value: runProvenanceSchemaVersion},
		{key: "tool_version", value: toolVersion},
		{key: "flags", value: buildRunProvenanceFlags(cfg)},
		{key: "inputs_fingerprint", value: inputsFingerprint(shards)},
		{key: "shard_count", value: len(shards)},
	}
	if cfg.runProvenanceStrict {
		entries = append(entries,
			orderedJSON{key: "argv_sha256", value: argvSHA256(os.Args[1:])},
			orderedJSON{key: "env_fingerprint", value: envFingerprint()},
		)
	}
	return entries
}

func buildRunProvenanceFlags(cfg cliConfig) []orderedJSON {
	var entries []orderedJSON
	for _, name := range runProvenanceFlagOrder {
		if !cfg.observedFlags[name] {
			continue
		}
		entries = append(entries, orderedJSON{key: name, value: runProvenanceFlagValue(cfg, name)})
	}
	return entries
}

func runProvenanceFlagValue(cfg cliConfig, name string) any {
	switch name {
	case "input-dir":
		return cfg.inputDir
	case "rates":
		return cfg.ratesPath
	case "output":
		return cfg.outputPath
	case "rejects":
		return cfg.rejectsPath
	case "session-gap":
		return cfg.sessionGap
	case "watermark-lag":
		return cfg.watermarkLag
	case "state-in":
		return cfg.stateIn
	case "state-out":
		return cfg.stateOut
	case "pending-ttl":
		return cfg.pendingTTL
	case "max-open-sessions":
		return cfg.maxOpenSessions
	case "state-strict":
		return cfg.stateStrict
	case "audit-log":
		return cfg.auditLog
	case "audit-log-digest":
		return cfg.auditLogDigest
	case "audit-log-rotate-bytes":
		return cfg.auditLogRotateBytes
	case "rates-strict":
		return cfg.ratesStrict
	case "rates-max-staleness":
		return cfg.ratesMaxStaleness
	case "ingest-id":
		return cfg.ingestID
	case "out-parquet-manifest":
		return cfg.outManifest
	case "manifest-signature":
		return cfg.manifestSignature
	case "dedup-policy":
		return cfg.dedupPolicy
	case "strict-late-audit":
		return cfg.strictLateAudit
	case "summary-schema-out":
		return cfg.summarySchemaOut
	case "summary-schema-digest":
		return cfg.summarySchemaDigest
	case "summary-schema-strict":
		return cfg.summarySchemaStrict
	case "summary-schema-index":
		return cfg.summarySchemaIndex
	case "rejects-format":
		return cfg.rejectsFormat
	case "rejects-format-header":
		return cfg.rejectsFormatHeader
	case "session-policy":
		return cfg.sessionPolicy
	case "fixed-window-seconds":
		return cfg.fixedWindowSeconds
	case "sharding-report":
		return cfg.shardingReport
	case "sharding-report-digest":
		return cfg.shardingReportDigest
	case "sharding-report-index":
		return cfg.shardingReportIndex
	case "sharding-report-histogram":
		return cfg.shardingReportHistogram
	case "sharding-report-sort":
		return cfg.shardingReportSort
	case "sharding-report-strict":
		return cfg.shardingReportStrict
	case "run-provenance":
		return cfg.runProvenance
	case "run-provenance-digest":
		return cfg.runProvenanceDigest
	case "run-provenance-strict":
		return cfg.runProvenanceStrict
	default:
		return nil
	}
}

func inputsFingerprint(shards []inputShardInfo) string {
	if len(shards) == 0 {
		return emptySHA256
	}
	var concat []byte
	for _, s := range shards {
		concat = append(concat, []byte(s.SHA256)...)
	}
	return sha256Hex(concat)
}

func argvSHA256(argv []string) string {
	var parts []string
	for _, tok := range argv {
		if !strings.Contains(tok, "/") {
			parts = append(parts, tok)
		}
	}
	joined := strings.Join(parts, " ")
	return sha256Hex([]byte(joined))
}
