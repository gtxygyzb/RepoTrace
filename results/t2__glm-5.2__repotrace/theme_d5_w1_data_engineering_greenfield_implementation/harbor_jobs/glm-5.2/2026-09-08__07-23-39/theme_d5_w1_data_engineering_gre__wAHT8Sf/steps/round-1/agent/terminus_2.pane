   104		}
   105		for i, c := range s {
   106			if i == 4 || i == 7 {
   107				if c != '-' {
   108					return false
   109				}
   110				continue
   111			}
   112			if c < '0' || c > '9' {
   113				return false
   114			}
   115		}
   116		return true
   117	}
