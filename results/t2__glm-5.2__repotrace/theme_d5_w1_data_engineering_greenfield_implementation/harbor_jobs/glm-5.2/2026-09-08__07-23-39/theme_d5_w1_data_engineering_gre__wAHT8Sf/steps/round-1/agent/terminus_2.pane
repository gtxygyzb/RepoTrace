[?2004l   434  func loadState(path string) (*loadedState, error) {
   435  	data, err := os.ReadFile(path)
   436  	if err != nil {
   437  		return nil, err
   438  	}
   439  	var sin stateFileIn
   440  	if err := json.Unmarshal(data, &sin); err != nil {
   441  		return nil, err
   442  	}
   443  	st := &loadedState{
   444  		version:      sin.Version,
   445  		seenIds:      map[string]bool{},
   446  		runIndex:     sin.RunIndex,
   447  		openSessions: map[string]carriedSession{},
   448  	}
   449  	if sin.Watermark.MaxTS != nil {
   450  		t, err := parseTime(*sin.Watermark.MaxTS)
   451  		if err != nil {
   452  			return nil, fmt.Errorf("bad state watermark: %w", err)
   453  		}
   454  		st.hasMax = true
   455  		st.maxTs = t
   456  	}
   457  	for _, id := range sin.SeenIDs {
   458  		st.seenIds[id] = true
   459  	}
   460  	for _, p := range sin.PendingPurchases {
   461  		t, err := parseTime(p.TS)
   462  		if err != nil {
   463  			return nil, fmt.Errorf("bad pending purchase ts: %w", err)
   464  		}
   465  		st.pending = append(st.pending, pendingEntry{id: p.ID, ts: t, user: p.User, usd: float64(p.USD), originRun: p.OriginRun})
   466  	}
   467  	for _, s := range sin.OpenSessions {
   468  		last, err := parseTime(s.LastTS)
   469  		if err != nil {
   470  			return nil, fmt.Errorf("bad open session last_ts: %w", err)
   471  		}
   472  		start, err := parseTime(s.StartTS)
   473  		if err != nil {
   474  			return nil, fmt.Errorf("bad open session start_ts: %w", err)
   475  		}
   476  		st.openSessions[s.User] = carriedSession{user: s.User, lastTs: last, sessionIndex: s.SessionIndex, startTs: start}
   477  	}
   478  	st.carryInPending = len(st.pending)
   479  	st.carryInOpenSessions = len(st.openSessions)
   480  	return st, nil
   481  }
   482  
   483  func buildStateOut(currentMax time.Time, hasCurrentMax bool, st *loadedState, seenIds []string, pending []pendingEntry, openSessions []carriedSession, runIndex int) []byte {
   484  	out := stateFileOut{Version: 1, SeenIDs: seenIds, PendingPurchases: statePendingOutList(pending), OpenSessions: stateOpenSessionOutList(openSessions), RunIndex: runIndex}
   485  	if hasCurrentMax {
   486  		s := formatTS(currentMax)
   487  		out.Watermark.MaxTS = &s
   488  	} else if st != nil && st.hasMax {
   489  		s := formatTS(st.maxTs)
   490  		out.Watermark.MaxTS = &s
   491  	}
   492  	b, _ := json.MarshalIndent(out, "", "  ")
   493  	b = append(b, '\n')
   494  	return b
   495  }
   496  
   497  func statePendingOutList(pending []pendingEntry) []statePendingOut {
   498  	out := make([]statePendingOut, 0, len(pending))
   499  	for _, p := range pending {
   500  		out = append(out, statePendingOut{ID: p.id, TS: formatTS(p.ts), User: p.user, USD: Money(p.usd), OriginRun: p.originRun})
   501  	}
   502  	return out
   503  }
   504  
   505  func stateOpenSessionOutList(sessions []carriedSession) []stateOpenSessionOut {
   506  	out := make([]stateOpenSessionOut, 0, len(sessions))
   507  	for _, s := range sessions {
   508  		out = append(out, stateOpenSessionOut{User: s.user, LastTS: formatTS(s.lastTs), SessionIndex: s.sessionIndex, StartTS: formatTS(s.startTs)})
   509  	}
   510  	return out
   511  }
   512  
   513  func sortedSeenIDs(seen map[string]bool) []string {
   514  	ids := make([]string, 0, len(seen))
   515  	for id := range seen {
   516  		ids = append(ids, id)
   517  	}
   518  	sort.Strings(ids)
   519  	return ids
   520  }
   521  
   522  func sortedPending(pending []pendingEntry) []pendingEntry {
   523  	out := append([]pendingEntry(nil), pending...)
   524  	sort.SliceStable(out, func(i, j int) bool {
   525  		if out[i].ts.Equal(out[j].ts) {
   526  			return out[i].id < out[j].id
   527  		}
   528  		return out[i].ts.Before(out[j].ts)
   529  	})
   530  	return out
   531  }
   532  
   533  func sortedOpenSessions(m map[string]carriedSession) []carriedSession {
   534  	out := make([]carriedSession, 0, len(m))
   535  	for _, s := range m {
   536  		out = append(out, s)
   537  	}
   538  	sort.SliceStable(out, func(i, j int) bool {
   539  		if out[i].lastTs.Equal(out[j].lastTs) {
   540  			return out[i].user < out[j].user
   541  		}
   542  		return out[i].lastTs.Before(out[j].lastTs)
   543  	})
   544  	return out
   545  }
   546  
   547  func sortedCarriedSessions(m map[string]carriedSession) []carriedSession {
   548  	return sortedOpenSessions(m)
   549  }
