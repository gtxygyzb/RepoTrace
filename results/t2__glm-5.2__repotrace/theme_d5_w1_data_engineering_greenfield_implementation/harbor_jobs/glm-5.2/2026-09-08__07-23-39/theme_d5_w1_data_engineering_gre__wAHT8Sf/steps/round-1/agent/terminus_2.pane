func newProcessor(rt *RateTable, st *loadedState, sessionGap, watermarkLag, pendingTTL time.Duration, maxOpenSessions int, hasAudit bool) *processor {
  p := &processor{
    rt: rt,
    st: st,
    sessionGap: sessionGap,
    watermarkLag: watermarkLag,
    pendingTTL: pendingTTL,
    maxOpenSessions: maxOpenSessions,
    now: time.Now().UTC(),
    seenIds: map[string]bool{},
    sameRunSeen: map[string]bool{},
    pendingByID: map[string]*pendingEntry{},
    openSessions: map[string]carriedSession{},
    runIndex: 0,
    stats: &stateStats{},
    hasAudit: hasAudit,
    auditBuilder: &bytes.Buffer{},
    digestCounts: digest{InvalidReasons: map[string]int{}},
  }
  if st != nil {
    p.seenIds = copyStringBoolMap(st.seenIds)
    p.pending = append([]pendingEntry(nil), st.pending...)
    for i := range p.pending {
      p.pendingByID[p.pending[i].id] = &p.pending[i]
    }
    for u, s := range st.openSessions {
      p.openSessions[u] = s
    }
    p.runIndex = st.runIndex
    p.hasMax = st.hasMax
    p.maxTs = st.maxTs
    p.stats.CarryInPending = st.carryInPending
    p.stats.CarryInOpenSessions = st.carryInOpenSessions
  }
  if maxOpenSessions <= 0 {
    p.maxOpenSessions = 0
  }
  return p
}

func copyStringBoolMap(m map[string]bool) map[string]bool {
  out := make(map[string]bool, len(m))
  for k, v := range m {
    out[k] = v
  }
  return out
}

func (p *processor) currentCutoff() string {
  if p.hasMax {
    return formatTS(p.maxTs.Add(-p.watermarkLag))
  }
  return ""
}

func (p *processor) updateMax(t time.Time) {
  if !p.hasMax || t.After(p.maxTs) {
    p.maxTs = t
    p.hasMax = true
  }
}

func (p *processor) processEvents(raws []rawEvent) ([]*Event, []Reject, []auditRecord) {
  var accepted []*Event
  var rejects []Reject
  var audits []auditRecord
  for _, raw := range raws {
    ctx := newContext(raw)
    ev, invalidReason := parseEvent(ctx, p.rt)
    if ev == nil {
      rec := auditRecord{Bucket: "invalid", Reason: invalidReason, Raw: ctx}
      rejects = append(rejects, Reject{Bucket: 1, Reason: invalidReason, Event: ctx.Raw})
      audits = append(audits, rec)
      continue
    }
    if p.seenIds[ev.ID] {
      rec := auditRecord{Bucket: "duplicate", Reason: "cross_run", Raw: ctx}
      rejects = append(rejects, Reject{Bucket: 2, Reason: "cross_run", Event: ctx.Raw})
      audits = append(audits, rec)
      continue
    }
    if p.sameRunSeen[ev.ID] {
      rec := auditRecord{Bucket: "duplicate", Reason: "same_run", Raw: ctx}
