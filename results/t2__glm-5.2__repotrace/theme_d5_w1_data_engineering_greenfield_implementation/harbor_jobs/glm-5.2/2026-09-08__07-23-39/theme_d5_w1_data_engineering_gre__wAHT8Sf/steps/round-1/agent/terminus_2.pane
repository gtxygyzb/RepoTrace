var usageString = "usage: eventq ingest --input-dir <dir> --rates <path> --output <path> --rejects <path> --session-gap <seconds> --watermark-lag <seconds> [--state-in <path>] [--state-out <path>] [--pending-ttl <seconds>] [--max-open-sessions <int>] [--audit-log <path>] [--audit-log-digest <path>] [--rates-strict] [--rates-max-staleness <seconds>] [--ingest-id <string>] [--out-parquet-manifest <path>] [--manifest-signature <path>]\n"

type Money float64

func (m Money) MarshalJSON() ([]byte, error) {
	return []byte(m.String()), nil
}

func (m Money) String() string {
	f := float64(m)
	abs := math.Abs(f)
	cents := int64(math.Floor(abs*100.0 + 0.5))
	neg := f < 0 && cents != 0
	dollars := cents / 100
	rem := cents % 100
	s := fmt.Sprintf("%d.%02d", dollars, rem)
	if neg {
		s = "-" + s
	}
	return s
}

type Event struct {
	ID                string
	Type              string
	TS                time.Time
	UserID            string
	Amount            float64
	Currency          string
	RefID             string
	USD               float64
	RefUSD            float64
	FXFallbackDays    int
	ResolvedAgainst   *string
	ResolvedOriginRun int
	SessionIndex      int
	Raw               rawJSON
	Shard             string
	Line              int
}

type Reject struct {
	Bucket int     `json:"bucket"`
	Event  rawJSON `json:"event"`
}

type ShardLine struct {
	Shard string
	Line  int
	Data  []byte
}

type RateTable struct {
	base  string
	days  map[string]map[string]float64
	known map[string]bool
}

func newRateTable() *RateTable {
	return &RateTable{base: "USD", days: map[string]map[string]float64{}, known: map[string]bool{}}
}

func isUsableRate(f float64) bool {
	return isFinite(f) && f > 0
}

func parseRateNumber(raw json.RawMessage) (float64, error) {
	if bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
		return 0, errors.New("non-numeric rate")
	}
	var f float64
	if err := json.Unmarshal(raw, &f); err != nil {
		return 0, errors.New("non-numeric rate")
	}
	return f, nil
}

func sortedKeys[T any](m map[string]T) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

func isStrictDate(s string) bool {
	if len(s) != 10 {
		return false
	}
	for i, c := range s {
		if i == 4 || i == 7 {
			if c != '-' {
				return false
			}
			continue
		}
		if c < '0' || c > '9' {
			return false
		}
	}
	return true
}

func dayEpoch(date string) time.Time {
	t, err := time.Parse("2006-01-02", date)
	if err != nil {
		return time.Time{}
	}
	return t.UTC()
}

func calendarDayDiff(rateDate, eventDate string) int {
	r := dayEpoch(rateDate)
	e := dayEpoch(eventDate)
	if r.IsZero() || e.IsZero() {
		return 0
	}
	return int(r.Sub(e) / (24 * time.Hour))
}

func absInt(v int) int {
	if v < 0 {
		return -v
	}
	return v
}

func absInt64(v int64) int64 {
	if v < 0 {
		return -v
	}
	return v
}

func (rt *RateTable) resolveRate(date, currency string, maxStaleness int) (float64, int, string) {
	if !rt.known[currency] {
		return 0, 0, "fx_unknown_currency"
	}
	if m, ok := rt.days[date]; ok {
		if r, ok := m[currency]; ok {
			if isUsableRate(r) {
				return r, 0, ""
			}
			return 0, 0, "bad_rate"
		}
	}
	if maxStaleness > 0 {
		eventDay := dayEpoch(date)
		if !eventDay.IsZero() {
			var bestDate string
			var bestDist int64 = -1
			for _, d := range sortedKeys(rt.days) {
				if _, ok := rt.days[d][currency]; !ok {
					continue
				}
				dayTime := dayEpoch(d)
				if dayTime.IsZero() {
					continue
				}
				dist := absInt64(dayTime.Unix() - eventDay.Unix())
				if dist > int64(maxStaleness) {
					continue
				}
				if bestDist < 0 || dist < bestDist || (dist == bestDist && d < bestDate) {
					bestDist = dist
					bestDate = d
				}
			}
			if bestDate != "" {
				r := rt.days[bestDate][currency]
				if isUsableRate(r) {
					return r, calendarDayDiff(bestDate, date), ""
				}
				return 0, 0, "bad_rate"
			}
		}
	}
	return 0, 0, "missing_rate"
}

func loadRates(path string) (*RateTable, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	var top map[string]json.RawMessage
	if err := json.Unmarshal(data, &top); err != nil {
		return nil, fmt.Errorf("rates file is not valid json: %w", err)
	}
	rt := newRateTable()
	daysRaw, ok := top["days"]
	if !ok {
		return nil, errors.New("fx days invalid")
	}
	var days map[string]json.RawMessage
	if err := json.Unmarshal(daysRaw, &days); err != nil {
		return nil, errors.New("fx days invalid")
	}
	if len(days) == 0 {
		return nil, errors.New("fx days invalid")
	}
	for _, day := range sortedKeys(days) {
		if !isStrictDate(day) || !isDate(day) {
			return nil, fmt.Errorf("ingest: rates.json: invalid day key %s", day)
		}
		var currencies map[string]json.RawMessage
		if err := json.Unmarshal(days[day], &currencies); err != nil {
			return nil, errors.New("fx days invalid")
		}
		for _, currency := range sortedKeys(currencies) {
			f, err := parseRateNumber(currencies[currency])
			if err != nil {
				return nil, fmt.Errorf("ingest: rates.json: non-numeric rate for %s/%s", day, currency)
			}
			if rt.days[day] == nil {
				rt.days[day] = map[string]float64{}
			}
			rt.days[day][currency] = f
			rt.known[currency] = true
		}
	}
	baseRaw, baseOk := top["base"]
	if !baseOk {
		return nil, errors.New("ingest: rates.json: base required")
	}
	var base string
	if err := json.Unmarshal(baseRaw, &base); err != nil || base == "" {
		return nil, errors.New("ingest: rates.json: base required")
	}
	rt.base = base
	if base != "USD" {
		return nil, errors.New("fx base must be USD")
	}
	for _, day := range sortedKeys(rt.days) {
		r, ok := rt.days[day][base]
		if !ok || r != 1.0 {
			return nil, fmt.Errorf("ingest: rates.json: base currency %s must have rate 1.0 on day %s", base, day)
		}
	}
	return rt, nil
}

func readInputEvents(inputDir string) ([]rawEvent, []inputShardInfo, error) {
	info, err := os.Stat(inputDir)
	if err != nil {
		return nil, nil, err
	}
	if !info.IsDir() {
		return nil, nil, errors.New("input-dir is not a directory")
	}
	entries, err := os.ReadDir(inputDir)
	if err != nil {
		return nil, nil, err
	}
	var files []string
	for _, e := range entries {
		if e.IsDir() || !e.Type().IsRegular() {
			continue
		}
		files = append(files, e.Name())
	}
	sort.Strings(files)
	var events []rawEvent
	var shards []inputShardInfo
	for _, name := range files {
		data, err := os.ReadFile(filepath.Join(inputDir, name))
		if err != nil {
			return nil, nil, err
		}
		si := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}
		lineNo := 0
		for _, line := range bytes.Split(data, []byte{'\n'}) {
			lineNo++
			trimmed := bytes.TrimSpace(line)
			if len(trimmed) == 0 {
				continue
			}
			si.EventsTotal++
			var obj map[string]json.RawMessage
			invalid := false
			if err := json.Unmarshal(trimmed, &obj); err != nil {
				invalid = true
			}
			events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: rawJSON(trimmed), Obj: obj, Invalid: invalid})
		}
		shards = append(shards, si)
	}
	return events, shards, nil
}

func newContext(raw rawEvent) *eventContext {
	ctx := &eventContext{Shard: raw.Shard, Line: raw.Line, Raw: raw.Raw, Obj: raw.Obj}
	if raw.Obj != nil {
		ctx.ID = rawStringPtr(raw.Obj, "id")
		ctx.TS = rawStringPtr(raw.Obj, "ts")
		ctx.Type = rawStringPtr(raw.Obj, "type")
	}
	return ctx
}

