  1060			if err != nil {
  1061				return manifestOutput{}, err
  1062			}
  1063			outputs.AuditDigest = digestOut
  1064		}
  1065		window := manifestWindow{
  1066			EventsAcceptedTotal: bucketCounts["accepted"],
  1067			EventsRejectedTotal: bucketCounts["duplicate"] + bucketCounts["invalid"] + bucketCounts["late"] + bucketCounts["unresolved_chargeback"],
  1068			BucketCounts:        bucketCounts,
  1069		}
  1070		if hasMin {
  1071			m := formatTS(minTs)
  1072			window.MinTs = &m
  1073		}
  1074		if hasMax {
  1075			m := formatTS(maxTs)
  1076			window.MaxTs = &m
  1077		}
  1078		var ingestID *string
  1079		if cfg.ingestIDSet {
