   452		schemaData, err := buildSchemaSidecar(summaryData, cfg, runIndex)
   453		if err != nil {
   454			return err
   455		}
   456		if err := atomicWriteFile(cfg.summarySchemaOut, schemaData); err != nil {
   457			return err
   458		}
   459		if cfg.summarySchemaDigest != "" {
   460			hash, n, err := fileDigest(cfg.summarySchemaOut)
   461			if err != nil {
   462				return err
   463			}
   464			digest := []orderedJSON{
   465				{key: "schema_path", value: filepath.Base(cfg.summarySchemaOut)},
   466				{key: "schema_sha256", value: hash},
   467				{key: "schema_bytes", value: n},
   468				{key: "field_count", value: 7},
   469				{key: "tool_version", value: toolVersion},
   470			}
   471			data := marshalOrderedIndent(digest)
   472			data = append(data, '\n')
   473			if err := atomicWriteFile(cfg.summarySchemaDigest, data); err != nil {
   474				return err
   475			}
   476			if cfg.summarySchemaIndex != "" {
   477				index, err := buildIndexSidecar(cfg, summaryData)
   478				if err != nil {
   479					return err
   480				}
   481				if err := atomicWriteFile(cfg.summarySchemaIndex, index); err != nil {
   482					return err
   483				}
   484			}
   485		}
   486		return nil
   487	}
   488	
   489	func buildIndexSidecar(cfg cliConfig, summaryData []byte) ([]byte, error) {
   490		fields, err := parseSummaryFields(summaryData)
   491		if err != nil {
   492			return nil, err
   493		}
   494		entries := make([]any, 0)
   495		for _, f := range fields {
   496			entries = append(entries, []orderedJSON{
   497				{key: "name", value: f.key},
   498				{key: "type", value: classify(f.value)},
   499				{key: "path", value: "$." + f.key},
   500			})
   501			if classify(f.value) == "array" {
   502				arr := f.value.([]any)
   503				if len(arr) > 0 && classify(arr[0]) == "object" {
   504					obj := arr[0].(map[string]any)
   505					keys := make([]string, 0, len(obj))
   506					for k := range obj {
   507						keys = append(keys, k)
   508					}
   509					sort.Strings(keys)
   510					for _, k := range keys {
   511						entries = append(entries, []orderedJSON{
   512							{key: "name", value: k},
   513							{key: "type", value: classify(obj[k])},
   514							{key: "path", value: fmt.Sprintf("$.%s[*].%s", f.key, k)},
   515						})
   516					}
   517				}
   518			}
   519		}
   520		top := []orderedJSON{
   521			{key: "entries", value: entries},
   522			{key: "entry_count", value: len(entries)},
   523			{key: "generated_from", value: filepath.Base(cfg.summarySchemaOut)},
   524			{key: "tool_version", value: toolVersion},
   525		}
   526		data := marshalOrderedIndent(top)
   527		data = append(data, '\n')
   528		return data, nil
   529	}
