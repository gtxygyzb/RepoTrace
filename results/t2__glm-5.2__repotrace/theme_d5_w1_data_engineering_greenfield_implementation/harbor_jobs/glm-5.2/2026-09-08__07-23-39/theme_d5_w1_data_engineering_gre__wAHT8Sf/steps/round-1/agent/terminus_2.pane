   262	func readInputEvents(inputDir string) ([]rawEvent, []inputShardInfo, error) {
   263		info, err := os.Stat(inputDir)
   264		if err != nil {
   265			return nil, nil, err
   266		}
   267		if !info.IsDir() {
   268			return nil, nil, errors.New("input-dir is not a directory")
   269		}
   270		entries, err := os.ReadDir(inputDir)
   271		if err != nil {
   272			return nil, nil, err
   273		}
   274		var files []string
   275		for _, e := range entries {
   276			if e.IsDir() || !e.Type().IsRegular() {
   277				continue
   278			}
   279			files = append(files, e.Name())
   280		}
   281		sort.Strings(files)
   282		var events []rawEvent
   283		var shards []inputShardInfo
   284		for _, name := range files {
   285			data, err := os.ReadFile(filepath.Join(inputDir, name))
   286			if err != nil {
   287				return nil, nil, err
   288			}
   289			si := inputShardInfo{Name: name, Bytes: int64(len(data)), SHA256: sha256Hex(data)}
   290			lineNo := 0
   291			for _, line := range bytes.Split(data, []byte{'\n'}) {
   292				lineNo++
   293				trimmed := bytes.TrimSpace(line)
   294				if len(trimmed) == 0 {
   295					continue
   296				}
   297				si.EventsTotal++
   298				var obj map[string]json.RawMessage
   299				invalid := false
   300				if err := json.Unmarshal(trimmed, &obj); err != nil {
   301					invalid = true
   302				}
   303				events = append(events, rawEvent{Shard: name, Line: lineNo, Raw: json.RawMessage(trimmed), Obj: obj, Invalid: invalid})
   304			}
   305			shards = append(shards, si)
   306		}
   307		return events, shards, nil
   308	}
