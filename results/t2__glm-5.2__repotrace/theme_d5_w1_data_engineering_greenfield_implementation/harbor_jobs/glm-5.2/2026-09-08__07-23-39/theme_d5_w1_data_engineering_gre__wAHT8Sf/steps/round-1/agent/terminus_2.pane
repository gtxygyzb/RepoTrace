   475		}
   476		bucketCounts["accepted"] = 0
   477		bucketCounts["duplicate"] = duplicateReasons["cross_run"]
   478		for i, c := range candidates {
   479			_ = i
   480			if c.ev == nil {
   481				continue
   482			}
   483			if winnerSet[i] {
   484				bucketCounts["accepted"]++
   485				shardAccepted[c.ev.Shard]++
   486				if !hasMin || c.ev.TS.Before(minTs) {
   487					minTs = c.ev.TS
   488					hasMin = true
   489				}
   490				if !hasMax || c.ev.TS.After(maxTs) {
   491					maxTs = c.ev.TS
   492					hasMax = true
   493				}
   494				_ = pending
   495				_ = openSessions
   496			} else {
   497				bucketCounts["duplicate"]++
   498				duplicateReasons["same_run"]++
   499				entry := auditEntries[i]
   500				entry.Bucket = "duplicate"
   501				entry.Reason = "same_run"
   502				if cfg.dedupPolicy == "first-arrival" {
   503					w := winners[entry.ID]
   504					entry.WinnerArrival = &winnerArrival{Shard: candidates[w].ev.Shard, Line: candidates[w].ev.Line}
   505				}
   506				auditEntries[i] = entry
   507			}
   508		}
   509	
   510		var rejectRecords []rejectRecord
   511		for i, c := range candidates {
   512			if c.ev == nil {
   513				r := rejectRecord{bucket: auditEntries[i].Bucket, reason: auditEntries[i].Reason, shard: c.raw.Shard, line: c.raw.Line, raw: c.raw.Raw}
   514				rejectRecords = append(rejectRecords, r)
   515				continue
   516			}
   517			if winnerSet[i] {
   518				continue
   519			}
   520			r := rejectRecord{bucket: "duplicate", reason: "same_run", shard: c.raw.Shard, line: c.raw.Line, raw: c.raw.Raw}
   521			if cfg.dedupPolicy == "first-arrival" {
