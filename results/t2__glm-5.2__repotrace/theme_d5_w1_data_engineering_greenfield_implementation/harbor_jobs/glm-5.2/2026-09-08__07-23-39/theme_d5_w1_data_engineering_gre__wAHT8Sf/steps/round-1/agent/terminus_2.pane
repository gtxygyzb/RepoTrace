   180					return cliConfig{}, fmt.Errorf("ingest: --rejects-format: must be one of {legacy, tagged, tagged-sorted}")
   181				}
   182				cfg.rejectsFormat = val
   183			case "--session-policy":
   184				val := nextArg(args, &i)
   185				if val != "gap" && val != "fixed-window" && val != "hybrid" {
   186					return cliConfig{}, fmt.Errorf("ingest: --session-policy: must be one of {gap, fixed-window, hybrid}")
